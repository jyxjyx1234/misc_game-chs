;■■■「月光に濡れる教室で、僕は。」台本：■明海Ｈ：CH01
;━━━━━━━━━━━━━━
;■明海Ｈ
;18～20KB
;除くＣＴＳ
;●１日目
;2003/01/31
;○１：全体

	;--BGM;----------------------------------
	mov $_music,"10": gosub *out
	;-- イベントCG;----------------------------------
	mov $_cg,"C04A"
	mov $debugstr,"ＣＧ：C04A"
	gosub *cgout	;イベントＣＧ
;BGM:Ｈ１

	制服のボタンを一つずつはずしていく。
	はらり…と床にスカートの裾が広がる。\
	;-音声;----------------------------------
	mov $_voice,"CCH0100"
	mov $debugstr,"音声：CCH0100 "
	gosub *vo

	【明海】
	あ…。\
	dwavestop CH_VOICE	;CCH0100 

	先輩の体は真っ白だった。
	床に転がされた真珠みたいに光っている。\

	日焼けしたあともない…シミ一つない綺麗な体。
	大きな胸、ふんわりした腹、やわらかそうな太股。\

	肌は、つやつやしてすべすべして…。
	まるで人形みたいに奇麗だった。\

	白い下着のホックをはずす。\

	下着のカップにきちんと納められていた
	先輩の真っ白な胸がこぼれ落ちた。\

	蛍光灯の青白い光の下で、先輩の裸の体がふる…
	と震えた。\

