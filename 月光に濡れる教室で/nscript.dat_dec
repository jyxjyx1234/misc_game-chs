	dwavestop CH_VOICE	;COP1500 
	;--立ちキャラ;----------------------------------
	mov $_char,"TCC"
	mov $debugstr,"立ち：TCC "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"COP1501"
	mov $debugstr,"音声：COP1501 "
	gosub *vo

	【明海】
	矢崎君がそんな高いもの、
	備品で置いとけませんって言うから。\
	dwavestop CH_VOICE	;COP1501 

	矢崎っていうのは、現学生会会長だ。
	今はいないみたいだけど…。\

	いなくて大正解だよな。
	あんまり好きじゃない…というか苦手だ。\

	【$g_hero】
	そうなんだ…。
	きれいなティーカップなのにな。\

	確かに高そうなティーカップなんだ。
	高いっていうか…上等そうなんだ。\

	きっと有名な名前とかついてるんだろうけど、
	僕にはわからないな。\

	【$g_hero】
	なんか有名なお店のものだったりするの？\

	そう尋ねると、
	明海ちゃんは軽く首を傾げた。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCD"
	mov $debugstr,"立ち：TCD "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"COP1502"
	mov $debugstr,"音声：COP1502 "
	gosub *vo

	【明海】
	さあ…よくわからないわ。ロンドンに行った時に
	気に入って買ったものだから。\
	dwavestop CH_VOICE	;COP1502 

	うーん…ロンドンか。\

	そうなんだ。
	明海ちゃんは、いいお家のお嬢さんなんだ。\

	お父さんは、社長さんだし。
	お母さんは、どっかの学園長をしてる。\

	二人とも忙しいのに、すごく仲の良い家族だって
	近所でも評判だった。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCA"
	mov $debugstr,"立ち：TCA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"COP1503"
	mov $debugstr,"音声：COP1503 "
	gosub *vo

	【明海】
	このティーカップ、気に入ってたの？\
	dwavestop CH_VOICE	;COP1503 

	【$g_hero】
	うん。物の価値とか、僕はよくわからないけど…
	好きなティーカップだったよ。\

	高価そうだとか思わなかったけど、
	真っ白な器は、持つと手にしっくり馴染んだ。\

	そのティーカップで紅茶を入れると、
	紅茶の色が映えて、すごくきれいだった。\

	ティーバッグで入れた紅茶でも、
	おいしく感じられたっけ…。\

	それは、きっと明海ちゃんの紅茶の煎れ方が
	うまかったせいもあるんだろうけど。\

	ああ…そうだ半年前くらいまでは
	こんなに気まずくもなかったっけ…。\

	今はこうして話も出来るけど、
	二人きりになるともう全然ダメなんだよな。\

	どうしてなんだろう。
	どうしてなのかな…。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCB"
	mov $debugstr,"立ち：TCB "
	gosub	*out	;画面に出力
