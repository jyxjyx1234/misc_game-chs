	すっかり体が冷えてしまっていた。\

	３月とはいえ、まだまだ寒い。\

	【$g_hero】
	ふ～、さむさむ。
	寝酒でもやりたくなるよな～。\
	;-音声;----------------------------------
	mov $_voice,"YE4800"
	mov $debugstr,"音声：YE4800"
	gosub *vo

	【$g_heroの兄】
	おーい、入るよ～。\
	dwavestop CH_VOICE	;YE4800
	;-効果音;----------------------------------
	mov $_se,"ZDOORO"
	mov $debugstr,"ＳＥ：ZDOORO"
	gosub *se

	【$g_hero】
	なんだよ。\
