	mov $debugstr,"音声：COP1703B"
	gosub *vo

	【明海】
	…………………。
	…明海ちゃんは、もうやめて欲しいの。\
	dwavestop CH_VOICE	;COP1703B

	明海ちゃんが、やんわりと言ってきた。\

	【$g_hero】
	どうして？
	明海ちゃんじゃ、どうしてダメなの？\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCF"
	mov $debugstr,"立ち：TCF "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"COP1704"
	mov $debugstr,"音声：COP1704 "
	gosub *vo

	【明海】
	どうしてって……。もうこどもじゃないんだし。
	私は先輩だし。…年上だし。\
	dwavestop CH_VOICE	;COP1704 

	わからないな…ちっともはっきりしないよ。
	でも…明海ちゃんが言うなら、仕方がないな。\

	【$g_hero】
	わかったよ。皆月先輩でいい？\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCC"
	mov $debugstr,"立ち：TCC "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"COP1705"
	mov $debugstr,"音声：COP1705 "
	gosub *vo

	【明海】
	ええ…ごめんなさいね。\
	dwavestop CH_VOICE	;COP1705 

	【$g_hero】
	……うん。\

	あやまるくらいならば、
	言わなければいいのに。\

	自分が言ったのに、どうして言った本人が
	そんなに傷ついた顔してるんだろう。\

	僕は、段々…淋しくなってきた。
	仕方がない…仕方がないんだろうけど。\

	もう…昔みたいに話をするのは
	無理なのかな？\
;●菜摘先生
	gosub *blackout

	;--BGM;----------------------------------
	mov $_music,"02": gosub *out
;BGM:喜
;菜摘センセシナリオで

	return	;----------------------------------
;---OP17 END -----
