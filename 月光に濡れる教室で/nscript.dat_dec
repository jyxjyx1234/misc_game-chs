	mov $debugstr,"音声：CC5905"
	gosub *vo

	【明海】
	ただ……。
	ひとりで待つなんて…イヤよ…イヤなの。\
	dwavestop CH_VOICE	;CC5905

	【$g_hero】
	でも……………僕だって…。
	心配だから…………。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCI"
	mov $debugstr,"立ち：TCI "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
