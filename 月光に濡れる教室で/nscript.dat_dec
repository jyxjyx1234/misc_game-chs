*C101	; ■ファイル開始のラベル
	mov $debugstr,"■C101" : gosub *debugout
;■■■「月光に濡れる教室で、僕は。」台本：●片山の死：B101
;━━━━━━━━━━━━━━
;●片山の死
;2003/01/17
;暗転
;音楽変更
	gosub *blackout

	;--BGM;----------------------------------
	mov $_music,"04": gosub *out
	;--背景;----------------------------------
	mov $_bg,"BLACK"
	mov $debugstr,"ＢＧ：BLACK "
	mov %effect,6	;エフェクトを指定
	gosub *out	;画面に出力
;;体育館

	…すぐには信じられなかった。\

	でも現実に、僕たちの目の前で。
	片山は死んだ。死んでしまったんだ。\

	スポットライトに潰されて、死んでしまった。\

	体育館はパニック状態に陥った。
	我先に校庭へと、なだれ出ていった。\
	;--背景;----------------------------------
	mov $_bg,"BG024G"
	mov $debugstr,"ＢＧ：BG024G"
	mov %effect,6	;エフェクトを指定
	gosub *out	;画面に出力
;;校庭

	みんな必死だった。
	必死で…今みた事から逃げ出そうとしていた。\

	まるで逃げてしまえば、なかったことに
	なるみたいに。\

	悲鳴と怒号が響き渡って…。
	何人か怪我人も出たそうだ。\

	先生たちもすぐには何もできなかった。
	まるで悪夢のような光景だった。\

	イヤな臭いが漂っていた。
	血の臭いと……髪が焦げる臭いだった。\

	スポットライトのコードが火花を散らしてた。
	倒れた片山の頭部には、スポットライトがあった。\

	丸ごと頭を潰されていたんだ。
	即死だと、誰が見ても思うだろう。\

	菜摘先生が、その場に座り込んでいた。
	一番近くで見たんだもんな…当たり前だよな…。\

	……………………。
	……………………。\
	;-効果音;----------------------------------
	mov $_se,"Z119"
	mov $debugstr,"ＳＥ：Z119"
	gosub *se

	何度目かのサイレンの音。
	救急車と…パトカーのサイレン。\

	そんなもの聞き慣れたくもないのに。
	すっかり珍しくもなくなっている僕がいた。\

	それから僕たちは、警察と先生たちの指導で
	教室に移動させられた。\

	みんなうなだれて…無口だった。\
	gosub *blackout
	;--背景;----------------------------------
	mov $_bg,"BG009G"
	mov $debugstr,"ＢＧ：BG009G"
	mov %effect,5	;エフェクトを指定
	gosub *out	;画面に出力
	gosub *sestop
	;-音声;----------------------------------
	mov $_voice,"YC10100"
	mov $debugstr,"音声：YC10100 "
	gosub *vo

	【学生Ａ】
	なあ…あれ事故だよな…事故なんだよな？\
	dwavestop CH_VOICE	;YC10100 
	;-音声;----------------------------------
	mov $_voice,"YC10101"
	mov $debugstr,"音声：YC10101 "
	gosub *vo

	【学生Ｂ】
	事故に…決まってるじゃないか。
	他になんだっていうんだよ…。\
	dwavestop CH_VOICE	;YC10101 
;吐きそう
	;-音声;----------------------------------
	mov $_voice,"YC10102"
	mov $debugstr,"音声：YC10102 "
	gosub *vo

	【学生Ａ】
	う…うえ…。
	俺、当分…肉とか無理…。\
	dwavestop CH_VOICE	;YC10102 
;泣きそう
	;-音声;----------------------------------
	mov $_voice,"YC10103"
	mov $debugstr,"音声：YC10103 "
	gosub *vo

	【学生Ｂ】
	うるさいな！
	お前、もうしゃべるなよ！！\
	dwavestop CH_VOICE	;YC10103 

	僕は…しばらくしてコッソリと屋上にいった。\
	gosub *blackout
	;-効果音;----------------------------------
	mov $_se,"ZDOORO"
	mov $debugstr,"ＳＥ：ZDOORO"
	gosub *se
;暗転
	;--背景;----------------------------------
	mov $_bg,"BG025G"
	mov $debugstr,"ＢＧ：BG025G"
	gosub *out	;画面に出力
;ＢＧ：BG025A;屋上

	【$g_hero】
	…………死んでしまったんだ。\

	目の前で見たっていうのに、
	実感がちっとも沸いてこなかった。\

	きっと…認めたくないんだ。
	片山が死んだことを、
	…幕が突然降りてしまったことを。\

	死んだんだ…死んだのか。
	明海を苦しめて、僕を苦しめて。\

	片山は、何も言わず、何も認めず。
	何の決着もつけずに…。\

	これで…きっと
	嫌がらせのメールや、悪意のある噂は
	消えるだろうけど。\

	明海への疑いや、そういうの…、
	全部残ったままじゃないか。\

	明海の心の傷だって、そのままじゃないか…。\

	あやまりもしないで…後悔もしないで…
	片山は、逝ってしまったんだ。\

	何だか悔しいとか…そういうのじゃなくて
	心にぽっかりと、穴があいたみたいだった。\

	幕が降りるはずのないシーンで、
	突然幕がおろされたみたいに。\

	そうだ。
	オペラ座の怪人。\

	シャンデリアが落ちて…誰かが死んで、
	舞台はめちゃくちゃになって…。\

	何も終わってないけど、
	舞台をつづけることはできなくなってしまった。\

	シャンデリアの代わりにスポットライトが落ちて
	片山が潰された。\

	幕を下ろしたのは、誰なんだ？
	本当の怪人は、誰なんだ？\

	あれは…本当に事故なのか？\

	もう…どこまでが虚構で
	どこまでが現実なのか…。\

	【$g_hero】
	わからない…わかんないんだ。\

	僕は、手すりにつかまって呻いた。\

	【$g_hero】
	事故…なんだろう。\

	真犯人なんて、出てこないんだ。
	こんな幕切れであってさえも。\

	現実なんてそんなもので。
	すべてのつじつまが合わないことの方が多くて。\

	理不尽で、暴力的で
	なのに明日も明後日も同じ顔をしてやってくる。\

	平気な顔をしてやってくるんだ。\
	gosub *blackout

	return	;----------------------------------
;---C101 END -----
