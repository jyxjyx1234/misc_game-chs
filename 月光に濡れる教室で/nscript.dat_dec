	mov $debugstr,"音声：YOP2000 "
	gosub *vo

	【治見先生】
	今日は、昭和の歴代総理大臣についてだったかね。
	教科書の２０５ページを開いてくれたまえ。\
	dwavestop CH_VOICE	;YOP2000 

	この前も同じことやらなかったか？
	治見先生もうっかりしてるからなぁ…。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TYA"
	mov $debugstr,"立ち：TYA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"YOP2001"
	mov $debugstr,"音声：YOP2001 "
	gosub *vo

	【治見先生】
	…であるからして…の総理大臣は…
	国鉄を民営化することに踏み切り……。\
	dwavestop CH_VOICE	;YOP2001 
	gosub *clear_char
	;-効果音;----------------------------------
	mov $_se,"ZCHORK"
	mov $debugstr,"ＳＥ：ZCHORK"
	gosub *se

	チミチミのお経のような声と
	チョークの音だけが響く。\

	【$g_hero】
	（みんなも何も言わないからな）\

	治見先生の授業は、
	聞いているやつの方が少ない。\

	他の参考書を開いたり、塾のテキストを
	解いていたり…。\

	【$g_hero】
	（確かに退屈だよな…）\

	僕はあくびをかみ殺した。\

	僕はぼんやりと窓の外を眺める。
	窓の外から見える景色。\

	校庭を見下ろしていたら
	今朝のことを思い出した。\

	【$g_hero】
	（あいつ…何だったんだろう。
	　片山　昌俊…）\

	先輩にいちゃもんつけて、
	僕にもワケ分からないこと言ってたな…。\

	権力を傘に着てって、学生会のことだろうか…。
	そんなこと考えたことなかったけど。\

	そう思う人間もいるんだな。
	考えたこともなかったから驚いた。\

	【$g_hero】
	（というか、どうかと思うぞ）\

	育巳も呆れてたけど、
	人の話全然聞いてなかったし。\

	一方的に話すだけ話して、勝手に呆れて
	どっかに行っちゃったしな。\

	何だったんだろう…。\

	【$g_hero】
	（卒業式の代表があんなやつなんて腹立つよな）\

	先輩はあまり気にしてなかったけれど。
	でもなぁ…先生たちも見る目がないよ。\

	卒業式なんて退屈で死にそうになるのに、
	そのうえ、男の答辞なんてさ。\

	というか、成績優秀者が卒業生代表に
	なるんだから、人格なんて関係ないんだけどさ。\

	そういえば、去年は兄さんがやってたっけ…。
	ホントに成績さえ良ければなんでもいいんだな。\
	gosub *musicstop
	;-効果音;----------------------------------
	mov $_se,"ZTYAIM"
	mov $debugstr,"ＳＥ：ZTYAIM"
	gosub *se

	キーンコーン…キーンコーン…。\

	考え事をしている間に、いつの間にか
	授業がおわってしまった。\

	あわただしく、僕はカバンに教科書を放り込む。\

	【$g_hero】
	さてと。どうしようかな…。\
	gosub *blackout

	;--BGM;----------------------------------
	mov $_music,"05": gosub *out

	return	;----------------------------------
;---C36B END -----
