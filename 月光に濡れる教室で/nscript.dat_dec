	【小夜子】
	先輩と同じのがいいんです。\
	dwavestop CH_VOICE	;DD4400

	ニコニコしながら、小夜子が答える。
	僕はおもわず赤面した。\

	【$g_hero】
	小夜子はたまにものすごくストレートだよな。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TDA"
	mov $debugstr,"立ち：TDA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"DD4401"
	mov $debugstr,"音声：DD4401"
	gosub *vo

	【小夜子】
	嘘つくのは嫌いなんです。\
	dwavestop CH_VOICE	;DD4401

	【$g_hero】
	嘘も方便って言葉があるだろ。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TDC"
	mov $debugstr,"立ち：TDC "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"DD4402"
	mov $debugstr,"音声：DD4402"
	gosub *vo

	【小夜子】
	それだったら黙ってる方がいいです。
	自分の気持ちに、嘘つくのは嫌いです。\
	dwavestop CH_VOICE	;DD4402

	【$g_hero】
	うん…。\

	そうストレートに言えるのは、小夜子に
	自信があるからなんだろう。\

	そういう小夜子の凛としたところが、
	僕は好きだ。自分はだらしないし。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TDB"
	mov $debugstr,"立ち：TDB "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"DD4403"
	mov $debugstr,"音声：DD4403"
	gosub *vo

	【小夜子】
	だから、私、先輩が好きです。\
	dwavestop CH_VOICE	;DD4403

	【$g_hero】
	小夜子って、どうしてそういうこと言うかな。\

	でも、僕のどこが、小夜子は好きなんだろ。
	好きだと思ってくれるのはうれしいけど。
	正直、そこまで好かれる自信がちょっとない。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TDJ"
	mov $debugstr,"立ち：TDJ "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"DD4404"
	mov $debugstr,"音声：DD4404"
	gosub *vo

	【小夜子】
	でも、好きになってもらうのって
	難しいですね。\
	dwavestop CH_VOICE	;DD4404

	【$g_hero】
	どうして？\

	僕は小夜子のこと好きだけど。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TDG"
	mov $debugstr,"立ち：TDG "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"DD4405"
	mov $debugstr,"音声：DD4405"
	gosub *vo

	【小夜子】
	そのひとには、いいところだけを見せたいんです。
	それでも、全部を見せたいと思うし。\
	dwavestop CH_VOICE	;DD4405

	【$g_hero】
	…うん。そだな。
	僕だって小夜子の前ではかっこつけたいもんな。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TDF"
	mov $debugstr,"立ち：TDF "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
