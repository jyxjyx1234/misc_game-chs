;============================================
*OP43	; ■ファイル開始のラベル
	mov $debugstr,"■OP43" : gosub *debugout
;■■■「月光に濡れる教室で、僕は。」台本：●明海とコピーをとりに：OP43
;━━━━━━━━━━━━━━
;●明海とコピーをとりに

	;--BGM;----------------------------------
	mov $_music,"13": gosub *out
;BGM:皆月　明海
	gosub *blackout
	;--背景;----------------------------------
	mov $_bg,"BG013A"
	mov $debugstr,"ＢＧ：BG013A"
	gosub *out	;画面に出力
;ＢＧ：BG013A;廊下

	僕は、さっさと部屋の外に出た。
	コピー機があるのは職員室だ。
	後ろもふりむかずに、すたすたと歩く。\
;↓これは声優さんへの指示です＞なしこさん。
;名前は変えられるので、音声には含めません。
;
;$g_fname君はヌキで
	;--立ちキャラ;----------------------------------
	mov $_char,"TCC"
	mov $debugstr,"立ち：TCC "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"COP4300"
	mov $debugstr,"音声：COP4300 "
	gosub *vo

	【明海】
	待って、$g_fname君。\
	dwavestop CH_VOICE	;COP4300 

	【$g_hero】
	…なんですか？\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCC"
	mov $debugstr,"立ち：TCC "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"COP4301"
	mov $debugstr,"音声：COP4301 "
	gosub *vo

	【明海】
	私と…一緒に行くのが、そんなにイヤなの？\
	dwavestop CH_VOICE	;COP4301 

	【$g_hero】
	別にいやじゃありませんよ。\

	イヤなのは、そっちじゃないのか。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCC"
	mov $debugstr,"立ち：TCC "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"COP4302"
	mov $debugstr,"音声：COP4302 "
	gosub *vo

	【明海】
	だったら…。いえ…いいわ。\
	dwavestop CH_VOICE	;COP4302 
	gosub *clear_char

	…なんだよ、何がいいんだよ。
	はっきり言ってくれよ。\

	友人の育巳が相手だったら、冗談交じりにでも
	本気ででも、すぐに口をついてくる言葉が
	先輩相手だと…どうしても、でてこない。\
	gosub *blackout
	;--背景;----------------------------------
	mov $_bg,"BG023A"
	mov $debugstr,"ＢＧ：BG023A"
	gosub *out	;画面に出力
;職員室
	;-効果音;----------------------------------
	mov $_se,"ZCOPY"
	mov $debugstr,"ＳＥ：ZCOPY "
	gosub *se

	僕らは無言のまま職員室に行き
	そして、コピーを取った。\

	コピーの間も、僕たちは無言で。
	なんだか、すごい切ない気持ちになる。\

	…何で、こんなことになるんだろ。
	別に普通に会話すればいいだけなのに。\

	でも、何を言って良いのかわからない。
	ずっと話してないから、先輩の趣味も
	日常も、何にも知らない。\

	まさか今日は良い天気ですねって
	言うわけにもいかないもんな。
	学年も、ちがうしさ。\

	昔だったら、昨日のテレビ面白かったよねって
	そんなくだらないことで盛り上がれたのに。\

	昔、好きだったアニメのプラモを作って
	プレゼントしてあげたこともあったのに。\

	でも、そんなこと、きっと忘れてるな。\
;----------------------------------
*hint03
	gosub *hintsave	;ヒント用セーブ
	if %g_hint==OFF goto *hintOP4324off
	csel
	"■それでも話してみる", *OP4310,
	"■やめておく", *OP4320,
	"■★ヒント", *OP4330
*hintOP4324off	;ヒントがOFFのとき
	csel
	"■それでも話してみる", *OP4310,
	"■やめておく", *OP4320
;----------------------------------
*OP4310
;◆それでも話してみる

	でも、ずっと無言で居るのもいやだよな。
	なんか…聞いてみようかな。進学のこととか。\

	【$g_hero】
	先輩…、大学って、どこでしたっけ。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCC"
	mov $debugstr,"立ち：TCC "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"COP4303"
	mov $debugstr,"音声：COP4303 "
	gosub *vo

	【明海】
	…全然、私に興味ないのね。\
	dwavestop CH_VOICE	;COP4303 

	【$g_hero】
	…すいません。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCA"
	mov $debugstr,"立ち：TCA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"COP4304"
	mov $debugstr,"音声：COP4304 "
	gosub *vo

	【明海】
	いえ、いいの。こちらこそ、ごめんなさい。
	キミのお兄さんと同じところよ。\
	dwavestop CH_VOICE	;COP4304 

	【$g_hero】
	ああ…。\

	うちのニコニコ兄貴ほどじゃないけど、
	先輩もものすごく頭良かったんだ。\

	うちの学生会会長は、成績で
	決まるなんて言われてるぐらいだもんな。\

	ニコニコ兄貴ってのは、いつもニコニコ笑ってる
	から子供の頃、明海ちゃんと一緒につけたんだ。
	兄には感情がないんじゃないかと、たまに思う。\

	でも、そんなことも覚えてないだろうな。
	「明海ちゃん」じゃない「皆月先輩」は。\

	【$g_hero】
	先輩なら、当然か。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCD"
	mov $debugstr,"立ち：TCD "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"COP4305"
	mov $debugstr,"音声：COP4305 "
	gosub *vo

	【明海】
	…ほめてるの？\
	dwavestop CH_VOICE	;COP4305 

	【$g_hero】
	そう聞こえない？\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCC"
	mov $debugstr,"立ち：TCC "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"COP4306"
	mov $debugstr,"音声：COP4306 "
	gosub *vo

	【明海】
	…それなら…いいんだけど。
	…ありがとう。\
	dwavestop CH_VOICE	;COP4306 

	【$g_hero】
	いえ。\

	…ああ、なんて不毛な会話だろ。
	しなければ、よかったかな…。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCC"
	mov $debugstr,"立ち：TCC "
	gosub	*out	;画面に出力

	【明海】
	………………………。\

	皆月先輩は、うつむいてなにか
	考え込んでいるみたいだった。\

	何かんがえてんだろ。
	こんなに近くにいるのにわかんないな。\

	わかっても、困るのかもしれないけど。\

	【$g_hero】
	………………………………。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCA"
	mov $debugstr,"立ち：TCA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"COP4307"
	mov $debugstr,"音声：COP4307 "
	gosub *vo

	【明海】
	キミは、どこに進学する予定？\
	dwavestop CH_VOICE	;COP4307 

	びっくりした。まさか、そっちから
	振ってくるとは思わなかった。\

	【$g_hero】
	…行けるところで、やりたい学部が
	あるところに…適当に。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCA"
	mov $debugstr,"立ち：TCA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"COP4308"
	mov $debugstr,"音声：COP4308 "
	gosub *vo

	【明海】
	…そう。それじゃ、今度は同じじゃないのね。\
	dwavestop CH_VOICE	;COP4308 

	【$g_hero】
	たぶんね。\

	僕の学力で、兄貴や先輩と同じ大学は無理だ。
	そんなこと、わかってるだろうに。\

	自慢…じゃないよな。別に、今さら
	僕に自慢をする必要なんてないし。\

	先輩は頭もいいけど、性格もいい。
	成績を鼻にかけたりしないし、面倒見がいい。\

	じゃなきゃ、学生会の仕事手伝ったりしない。
	とっくに会長はバトンタッチしてるのに。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCC"
	mov $debugstr,"立ち：TCC "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"COP4309"
	mov $debugstr,"音声：COP4309 "
	gosub *vo

	【明海】
	そう…。\
	dwavestop CH_VOICE	;COP4309 

	先輩はうつむいて、形のいい唇を
	さびしげに白い歯でかるく噛んだ。\

	なんで、そんな顔するんだろう。
	まるで僕がいじめてるみたいじゃないか。\

	会えなくなったら、清々するんじゃないのか。
	そんな言葉でつい責め立ててしまいたくなる。\

	先輩は頭がいいから、話おもしろいし。
	ほかのひとが相手だったら、ちゃんと会話する。\

	でも、僕と居るときは無口だ。
	こうやって、いつでも口を閉ざす。\

	昔は、いくらでも話ができた。
	なんだって、くだらないことだって楽しかった。\

	それが無くなってしまうのは、
	仕方がないのかもしれないけれど、
	だけど、どこかやるせない。\

	こういうときは兄さんみたいな、
	安全靴みたいに分厚い神経がほしかったな。\
	goto *nextOP43	;nextOP43へ移動
;----------------------------------
*OP4320
;◆やめておく

	mov %akemi_bad,ON
	いや…。
	いいや。やめておこう。\
	goto *nextOP43	;nextOP43へ移動
;----------------------------------
*OP4330
;◆★ヒント

	「それでも話してみる」
	先輩と付き合いたいのなら、ぜひ話をして
	みましょう。\

	「やめておく」
	気まずいです。バッドエンドコースです。\
	goto *hint03	;hint03へ移動
;----------------------------------
*nextOP43
	;-効果音;----------------------------------
	mov $_se,"ZCOPY"
	mov $debugstr,"ＳＥ：ZCOPY "
	gosub *se

	僕らは、だまってコピー機がたくさんの
	紙を吐きだしてるのを見つめていた。\

	ふたりの間に、コピー機の音だけがする。\

	放課後の職員室、先生たちの今日も寒いですな。
	お茶を入れましょうかなんて会話が
	遠くとびかってる。\

	なんで、こんなところで。
	こんな風に二人でいるんだろ。\
	gosub *sestop

	コピー機の動きがとまった。
	僕は、大量に刷り上がったコピーを腕に抱えた。\

	【$g_hero】
	もどろっか、先輩。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCA"
	mov $debugstr,"立ち：TCA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"COP4310"
	mov $debugstr,"音声：COP4310 "
	gosub *vo

	【明海】
	ええ。\
	dwavestop CH_VOICE	;COP4310 
	gosub *blackout
	;--背景;----------------------------------
	mov $_bg,"BG019A"
	mov $debugstr,"ＢＧ：BG019A"
	gosub *out	;画面に出力
	;-効果音;----------------------------------
	mov $_se,"ZDOORSLIDE"
	mov $debugstr,"ＳＥ：ZDOORSLIDE"
	gosub *se
;ＢＧ：BG019A;学生会室

	【$g_hero】
	終わったよ。\
	;--立ちキャラ;----------------------------------
	mov $_char,"THB"
	mov $debugstr,"立ち：THB "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XOP4311"
	mov $debugstr,"音声：XOP4311 "
	gosub *vo

	【矢崎】
	やあ、ご苦労様。
	皆月先輩もお疲れ様でした。\
	dwavestop CH_VOICE	;XOP4311 
	;--立ちキャラ;----------------------------------
	mov $_char,"THI"
	mov $debugstr,"立ち：THI "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XOP4312"
	mov $debugstr,"音声：XOP4312 "
	gosub *vo

	【矢崎】
	君の仕事はこれで終わりだよ。
	帰るなりなんなり好きにしたまえ。\
	dwavestop CH_VOICE	;XOP4312 

	【$g_hero】
	じゃあ…僕はこれで。
	皆月先輩、お疲れ様でした。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCA"
	mov $debugstr,"立ち：TCA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"COP4313"
	mov $debugstr,"音声：COP4313 "
	gosub *vo

	【明海】
	ええ…さようなら。\
	dwavestop CH_VOICE	;COP4313 
	;--立ちキャラ;----------------------------------
	mov $_char,"THB"
	mov $debugstr,"立ち：THB "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XOP4314"
	mov $debugstr,"音声：XOP4314 "
	gosub *vo

	【矢崎】
	今度は仕事が溜まる前に来るといいよ。\
	dwavestop CH_VOICE	;XOP4314 

	【$g_hero】
	わかってるよ！失礼しましたっ。\

	僕は学生室を出て行った。\
	gosub *blackout

	;--BGM;----------------------------------
	mov $_music,"05": gosub *out

	return	;----------------------------------
