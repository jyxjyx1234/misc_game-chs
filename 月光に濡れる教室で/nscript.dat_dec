	mov $debugstr,"音声：CC3819B "
	gosub *vo

	【明海】
	……………………。
	あのね…$g_fname君。\
	dwavestop CH_VOICE	;CC3819B 

	【$g_hero】
	う、うん…何？\
	;--立ちキャラ;----------------------------------
