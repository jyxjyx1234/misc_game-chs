	歩きつづけた。\

	ペンライトを片手に、先輩の手を握りしめて。\
	;--背景;----------------------------------
	mov $_bg,"BG016B"
	mov $debugstr,"ＢＧ：BG016B"
	gosub *out	;画面に出力

	そのときの僕たちは、あまりに心細すぎた。
	手を握っていることも、時々忘れる位に。\
	;--背景;----------------------------------
	mov $_bg,"BG018B"
	mov $debugstr,"ＢＧ：BG018B"
	gosub *out	;画面に出力

	もしこの手を無くしたら……。
	どうしようもなく、独りを感じてしまうのに。\
	;--背景;----------------------------------
	mov $_bg,"BG026B"
	mov $debugstr,"ＢＧ：BG026B"
	gosub *out	;画面に出力

	夜の暗がりが、僕たちの輪郭を曖昧にさせる。\

	…夜の校舎を、一人のような二人のような
	僕たちは、ただ歩きつづけた。\

	;--BGM;----------------------------------
	mov $_music,"06": gosub *out
	;--背景;----------------------------------
	mov $_bg,"BG024B"
	mov $debugstr,"ＢＧ：BG024B"
	gosub *out	;画面に出力
;ＢＧ：BG024B;校庭（夜）

	【$g_hero】
	結局、誰もいなかったね…。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCH"
	mov $debugstr,"立ち：TCH "
	gosub	*out	;画面に出力

	【明海】
	……………………。\

	【$g_hero】
	…疲れた？\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCA"
	mov $debugstr,"立ち：TCA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC5424"
	mov $debugstr,"音声：CC5424"
	gosub *vo

	【明海】
	すこしだけ……でもキミだって…。\
	dwavestop CH_VOICE	;CC5424

	【$g_hero】
	うん…僕も…少しだけ疲れたよ。\

	風が強かった。
	夜の校庭は、月光だけが頼りだった。\

	手元のペンライトだけじゃ、端まで見通すこと
	はできなかった。\

	途中から、ペンライトはまたポケットに仕舞った。
	校庭は…昼間とは、全然別の場所に見えた。\

	先輩と僕の後ろを、長い影がついてきていた。
	それを僕たちは、なるべく見ないふりをした。\

	……多分、怖かったんだ。
	自分たちの影でさえも。\

	僕たちは、抜け道へとむかった。\
	goto *nextC54	;nextC54へ移動
;----------------------------------
*C5420
;◆まっすぐ帰る

	【$g_hero】
	いや…もう帰ろう。\

	ペンライトを、ポケットに押し込む。
	僕たちは、美術室を出ていった。\
	goto *nextC54	;nextC54へ移動
;----------------------------------
*C5430
;◆★ヒント

	「校舎を回る」
	明海先輩と二人きりで校舎を探索します。\

	「まっすぐ帰る」
	校舎を探索せずに、校舎を出ます。\

	ＥＤには関係のない選択肢です。
	お好きな方をどうぞ。\
	goto *hintC54	;hintC54へ移動
;----------------------------------
*nextC54

	return	;----------------------------------
;---C54  END -----
