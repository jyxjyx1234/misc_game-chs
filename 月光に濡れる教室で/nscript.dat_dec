	mov $debugstr,"音声：YE4805"
	gosub *vo

	【$g_heroの兄】
	そういやさ、友だちと話したんだけど
	津島先輩、菜摘先生のこと好きだったみたいね。\
	dwavestop CH_VOICE	;YE4805

	【$g_hero】
	え、そうなの？
	でも、厳しいとか言ってなかった？\
	;--立ちキャラ;----------------------------------
	mov $_char,"TLB"
	mov $debugstr,"立ち：TLB "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
