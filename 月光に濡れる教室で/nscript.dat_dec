*E01	; ■ファイル開始のラベル
	mov $debugstr,"■E01 " : gosub *debugout
;■■■「月光に濡れる教室で、僕は。」台本：■菜摘ルート開始前：E01
;━━━━━━━━━━━━━━
;■菜摘ルート開始前
;●主人公から

	;--BGM;----------------------------------
	mov $_music,"04": gosub *out
	;--背景;----------------------------------
	mov $_bg,"BLACK"
	mov $debugstr,"ＢＧ：BLACK "
	mov %effect,5	;エフェクトを指定
	gosub *out	;画面に出力
;BGM:愛
	;--背景;----------------------------------
	mov $_bg,"MOONA01"
	mov $debugstr,"ＢＧ：MOONA01 "
	mov %effect,4	;エフェクトを指定
	gosub *out	;画面に出力

	どうしても解けない謎がひとつだけある。
	どうしても教えて欲しいことがひとつある。\

	「天使」\

	だれだったんだろう。どうしてなんだろう。
	どうして殺したんだろう。
	どうして僕を見ていたんだろう。\

	「会いたいと思う？」\

	それは憎しみなのか、怒りなのか。
	わからないまま。\

	「でも、知りたい」\

	それなら。\
;●天使から

	たぶん私にはなにもなく
	たぶん君にもなにもない。\

	何かがあると言えるほど
	君には何かがあるのだろうか。\

	親？　友だち？　恋人？
	何がある。君の中には何がある？\

	「答えてほしい」\

	すべてうつろに消えていくだけ。
	世界はさらさらと砂のように消えていく。\

	それまでの苦痛を
	ああ、できるのなら。\

	和らげてあげたい。
	そう願うのだ。そう思うのだ。\

	それが間違いでも。
	そのひとときが救いならば。\

	だって欲しかったんだ。
	それが、どうしても欲しかったんだ。\
	gosub *blackout
;■ＯＰ

	return	;----------------------------------
;---E01  END -----
