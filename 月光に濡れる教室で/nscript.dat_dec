;●朝：自分の部屋
	gosub *musicstop

	;--BGM;----------------------------------
	mov $_music,"01": gosub *out
;BGM:さりげない日常
	;--背景;----------------------------------
	mov $_bg,"BG001A"
	mov $debugstr,"ＢＧ：BG001A"
	mov %effect,4	;エフェクトを指定
	gosub *out	;画面に出力
;ＢＧ：BG001A;主人公の部屋
	;-効果音;----------------------------------
	mov $_se,"ZSUZUME"
	mov $debugstr,"ＳＥ：ZSUZUME "
	gosub *se
;ＳＥ：ZSUZUME;スズメ

	早朝の空気はしんと冷えている。
	毛布から顔を出す。吐く息は白い。\

	【$g_hero】
	ふぁ…寒い…。\
	;-効果音;----------------------------------
	mov $_se,"ZSWITCH"
	mov $debugstr,"ＳＥ：ZSWITCH "
	gosub *se

	手探りでリモコンに手を伸ばし、
	部屋の暖房のスイッチを入れる。\

	【$g_hero】
	いつもと、変わんないな…。\

	天井をぼんやり見つめて、つぶやく。
	いつもと同じ自分の部屋。いつもと同じ時間。\

	【$g_hero】
	でも、昨日とはちがうんだ。\

	そう。田口はいなくて。小林先輩もいない。
	毎日は同じように続いていながら、
	少しずつ違う。\

	望んでいようが、望んでいまいが。
	時間は過ぎていくのだ。\

	だけど。いや、だから。\

	【$g_hero】
	真実に会いたいな。\

	会って話がしたかった。\

	初めてしている恋は、予想したのとちがってて
	たのしいトキメキとか、甘い語らいとかなくて。\

	【$g_hero】
	でも会いたい。\

	会いたいと思う。会って話がしたいと思う。\

	声が聞きたい。細い首のライン。白い肌。
	黒い髪のやわらかさを僕は知っている。\

	真実と一緒にいるのは、楽しいけど。
	それだけじゃなくて、嬉しいだけじゃなくて。\

	やるせない気持ちが甘くて切なくて
	どうにかなってしまいそうになる。\

	【$g_hero】
	だから、僕…あんなことするのかな…。\

	夜の欲望を思い出して、体が反応しそうになる。
	ゴォオ…と暖房が温風を吐き出す音がした。\

	自分の手が、下半身に伸びていく。
	まだそこは大して変化もしていない。\

	【$g_hero】
	ん…。\

	これを真実に突き立てたのかと思うと
	妙に興奮した。そっと指を這わせる。\

	【$g_hero】
	真実…。\
	;-効果音;----------------------------------
	mov $_se,"ZKNOCK2"
	mov $debugstr,"ＳＥ：ZKNOCK2 "
	gosub *se
;ＳＥ：ZKNOCK;ノック
	;-音声;----------------------------------
	mov $_voice,"YB6900"
	mov $debugstr,"音声：YB6900"
	gosub *vo

	【$g_heroの兄】
	おーい、朝だよー。\
	dwavestop CH_VOICE	;YB6900

	【$g_hero】
	………………………………………。\

	;--BGM;----------------------------------
	mov $_music,"05": gosub *out
;BGM:楽
	;-音声;----------------------------------
	mov $_voice,"YB6901"
	mov $debugstr,"音声：YB6901"
	gosub *vo

	【$g_heroの兄】
	寝てるのー？　入るよー。\
	dwavestop CH_VOICE	;YB6901

	【$g_hero】
	入らなくていい！！\
	;-音声;----------------------------------
	mov $_voice,"YB6902"
	mov $debugstr,"音声：YB6902"
	gosub *vo

	【$g_heroの兄】
	なんだよー。せっかく、やさしいお兄様が
	起こしに来てあげたのにー。\
	dwavestop CH_VOICE	;YB6902

	【$g_hero】
	いらん！\
	;-音声;----------------------------------
	mov $_voice,"YB6903"
	mov $debugstr,"音声：YB6903"
	gosub *vo

	【$g_heroの兄】
	やっぱりガッコ行くのイヤ？　怖いの？
	おにいちゃんと一緒に行く？\
	dwavestop CH_VOICE	;YB6903

	【$g_hero】
	いかないに決まってんだろ！！\
	;-音声;----------------------------------
	mov $_voice,"YB6904"
	mov $debugstr,"音声：YB6904"
	gosub *vo

	【$g_heroの兄】
	じゃあすぐに来てね。おにいちゃんの特製
	朝ごはん、おいしいよー。\
	dwavestop CH_VOICE	;YB6904

	トントントンと階段を下りていく音が聞こえた。\

	【$g_hero】
	……なにが、特製朝ごはんだ！
	どうせ玉子かけごはんじゃないか！\

	なんで、こういうときばっか来るんだよ！！
	ぜったいアイツわかってる！　くそっ！\

	僕は頭をわしわしとかき回した。
	ああ、もうそんな気持ちなんて飛んでったよ。\

	【$g_hero】
	起きるか。\

	僕は体を起こした。カーテンを開ける。\

	窓から見える薄い色した冬の空は、淫らな
	欲望になんて、ちっともそぐわなかった。\
	gosub *blackout

	return	;----------------------------------
