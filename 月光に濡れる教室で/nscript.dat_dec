	mov $debugstr,"■C55 " : gosub *debugout
;■■■「月光に濡れる教室で、僕は。」台本：●裏庭で：B55
;━━━━━━━━━━━━━━
;●裏庭で
	gosub *blackout

	;--BGM;----------------------------------
	mov $_music,"13": gosub *out
	;--背景;----------------------------------
	mov $_bg,"BG015B"
	mov $debugstr,"ＢＧ：BG015B"
	gosub *out	;画面に出力
;ＢＧ：BG015B;裏庭（夜）
	;--立ちキャラ;----------------------------------
	mov $_char,"TCC"
	mov $debugstr,"立ち：TCC "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC5500"
	mov $debugstr,"音声：CC5500"
	gosub *vo

	【明海】
	ペンライトの持ち主って、結局誰だったのかしら。
	「天使」？　それとも他の誰か？\
	dwavestop CH_VOICE	;CC5500

	【$g_hero】
	わからないな…誰も見つけられなかったし。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCC"
	mov $debugstr,"立ち：TCC "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC5501"
	mov $debugstr,"音声：CC5501"
	gosub *vo

	【明海】
	そうね…誰かどこかで見ているような
	そんな気分にはなったけど。\
	dwavestop CH_VOICE	;CC5501

	【$g_hero】
	…………………。
	きっと気のせいだよ。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCA"
	mov $debugstr,"立ち：TCA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC5502"
	mov $debugstr,"音声：CC5502"
	gosub *vo

	【明海】
	ええ、きっと…気のせいだわ。
	怖かったのね。\
	dwavestop CH_VOICE	;CC5502

	【$g_hero】
	明日さ、また美術室に行ってみようよ。
	持ち主が、探しに来るかも知れないし。\
	;-効果音;----------------------------------
	mov $_se,"ZFOOT3"
	mov $debugstr,"ＳＥ：ZFOOT3"
	gosub *se

	抜け道を通るために、僕は草をかきわける。
	そのとき。\

	風の吹く方向が、変わった。
	そして聞こえてきた…かすかな音…いや…声？\
	gosub *sestop

	【$g_hero】
	あれ…？今何か聞こえなかった？\

	先輩が、耳を澄ます。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCD"
	mov $debugstr,"立ち：TCD "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC5503"
	mov $debugstr,"音声：CC5503"
	gosub *vo

	【明海】
	……きこえないけど、どうしたの？\
	dwavestop CH_VOICE	;CC5503

	僕ももう一度耳を澄ました。
	けれど、それはもう聞こえなくなっていた。\

	【$g_hero】
	もう…きこえない。
	気のせいだったのかな？\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCC"
	mov $debugstr,"立ち：TCC "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC5504"
	mov $debugstr,"音声：CC5504"
	gosub *vo

	【明海】
	わからないわ…もう一度、回ってみる？\
	dwavestop CH_VOICE	;CC5504

	【$g_hero】
	……………。
	ううん…帰ろうよ。\

	【$g_hero】
	あんまり遅くなりすぎると、先輩だって塾とか
	言い訳できなくなるし。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCA"
	mov $debugstr,"立ち：TCA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC5505"
	mov $debugstr,"音声：CC5505"
	gosub *vo

	【明海】
	そうね……きっと風が、何かを揺らしたのよ。\
	dwavestop CH_VOICE	;CC5505

	【$g_hero】
	そうだね……きっと…。\
	gosub *blackout

	return	;----------------------------------
;---C55  END -----
