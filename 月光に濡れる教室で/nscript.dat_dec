; －－－－－－－－－－－－－－－－－－－－－－－－－－－－－－－－－－
;	タイトル画面
;-------------------------------------------------------------------
*title	;■タイトル画面
	gosub *anten_system

	lookbackflush	;回想クリア
	textclear	;表示されているテキストを消す
	dwavestop CH_SE : mov $_se,"" 
	dwavestop CH_VOICE : mov $_voice,""

	if %g_initial=0 gosub *global_initial:mov %g_initial,1
				;初回プレイ時のみグローバル変数クリア
	gosub *local_initial	;ローカル変数クリア

	;--BGM;----------------------------------
	csp -1 ;スプライトすべてクリア
	if %moving_title==OFF 	gosub *edtitle : mov %moving_title,ON
	mov $_music,"10": gosub *music
	bg "sys/title.jpg",BG_EFFECT	;背景を表示
	lsph 0,":l/2,0,3;sys/ttl_start.jpg",	30,50	;はじめから
	lsph 1,":l/2,0,3;sys/ttl_cont.jpg",	30,110	;つづきから
	lsph 2,":l/2,0,3;sys/ttl_exit.jpg",	30,170	;終了
	lsph 3,":l/2,0,3;sys/ttl_cg.jpg",	30,230	;ＣＧ
	lsph 4,":l/2,0,3;sys/ttl_kaisou.jpg",	30,290	;回想
	lsph 5,":l/2,0,3;sys/ttl_config.jpg",	30,350	;設定
	lsph 6,":l/2,0,3;sys/ttl_music.jpg",	30,410	;音楽
	lsph 7,":l/2,0,3;sys/ttl_mabo.jpg",	30,470	;まぼ
	lsph 8,":l/2,0,3;sys/ttl_char.jpg",	30,530	;キャラ紹介
if %debug==ON lsp  9,":s/24,24,0;#000080#0000FFゲームの再開", 360,50
if %debug==ON lsp 10,":s/24,24,0;#000080#0000FF直接呼び出し", 360,80
if %debug==ON lsp 11,":s/24,24,0;#000080#0000FFデバッグ情報", 360,110

	btndef ""
	spbtn 0,1
	spbtn 1,2
	spbtn 2,3
	spbtn 3,4
	spbtn 4,5
	spbtn 5,6
	spbtn 6,7
	spbtn 7,8
	spbtn 8,9
if %debug==ON spbtn 9,10
if %debug==ON spbtn 10,11
if %debug==ON spbtn 11,12
	print 1

*title_lp
	btnwait %work
	if %work==0 goto *title_lp
	if %work==1 gosub *click: csp -1 : goto *start_game
	if %work==2 gosub *click: csp -1 : goto *continue
	if %work==3 gosub *click: csp -1 : goto *dlg_end
	if %work==4 gosub *click: csp -1 : goto *cgmode
	if %work==5 gosub *click: csp -1 : goto *playback_mode
	if %work==6 gosub *click: csp -1 : goto *config
	if %work==7 gosub *click: csp -1 : goto *music_mode
	if %work==8 gosub *click: csp -1 : goto *mabo_room
	if %work==9 gosub *click: csp -1 : goto *char_introduce
if %debug==ON if %work==10 gosub *click: csp -1 : goto *debug_load
if %debug==ON if %work==11 gosub *click: csp -1 : goto *debug_goto
if %debug==ON if %work==12 gosub *click: csp -1 : goto *debug_info
	goto *title_lp

;-------------------------------------------------------------------
*title_out
;310,510
	mov $_se,"ZLOGO" : gosub *se
	lsp SP_MOVE,":l;sys/logos.jpg",50,50,20
	mov %_y,510	;終了アドレス
	mov %work,50	;開始アドレス
	gosub *moving_y
	wait 100
	mov %_x,310	;終了アドレス
	mov %work,50	;開始アドレス
	gosub *moving_x
	csp -1
	bg "sys/title.jpg",BG_EFFECT
	wait 100
	return

;-------------------------------------------------------------------
*continue	;■つづきから
	bg black,SYSTEM_EFFECT
	if %g_text_speed==0 textspeed 80
	if %g_text_speed==1 textspeed 40
	if %g_text_speed==2 textspeed 20
	if %g_text_speed==3 textspeed 10
	if %g_text_speed==4 textspeed 5 
	if %g_text_speed==5 textspeed 0 
	gosub *set_message_window
	goto *load
;-------------------------------------------------------------------
;*endinglist	;■エンディングリスト
;-------------------------------------------------------------------
*music_mode	;■音楽モード
	bg "SYS/MUSIC.jpg",0	;背景設定
;●曲名変更リスト
	mov %_x,270	;Ｘ座標初期値
	mov %_y,80	;Ｙ座標初期値	

	lsp 0,	":s/22,20,0;#8C7853#FFE28E０１：ｉｎ　ｔｈｅ　ｕｓｕａｌ　ｗａｙ．",%_x,%_y : add %_y,30
	lsp 1,	":s/22,20,0;#8C7853#FFE28E０２：ｊｏｙ　ｗｉｔｈ　ｙｏｕ．",%_x,%_y : add %_y,30
	lsp 2,	":s/22,20,0;#8C7853#FFE28E０３：ｔｈｅ　ｆｕｒｙ．",%_x,%_y : add %_y,30
	lsp 3,	":s/22,20,0;#8C7853#FFE28E０４：ｔｈｅ　ｒｅａｓｏｎ　ｏｆ　ｌｏｖｅ．",%_x,%_y : add %_y,30
	lsp 4,	":s/22,20,0;#8C7853#FFE28E０５：ｔｈｅ　ｈａｐｐｙ　ｌｉｆｅ．",%_x,%_y : add %_y,30
	lsp 5,	":s/22,20,0;#8C7853#FFE28E０６：ｔｈｅ　ｔｅｎｄｅｒ　ａｆｆｅｃｔｉｏｎ",%_x,%_y : add %_y,30
	lsp 6,	":s/22,20,0;#8C7853#FFE28E０７：ｗｈａｔ　ｉｓ　ｌｏｖｅ．",%_x,%_y : add %_y,30
	lsp 7,	":s/22,20,0;#8C7853#FFE28E０８：ｔｈｅ　ｉｎｎｏｃｅｎｔ　ｓｏｒｒｏｗ．",%_x,%_y : add %_y,30
	lsp 8,	":s/22,20,0;#8C7853#FFE28E０９：ｆｅｅｌｉｎｇ　ｕｎｅａｓｙ．",%_x,%_y : add %_y,30
	lsp 9,	":s/22,20,0;#8C7853#FFE28E１０：ｔｈｅ　ｌｕｓｔ．",%_x,%_y : add %_y,30
	lsp 10,	":s/22,20,0;#8C7853#FFE28E１１：ｔｈｅ　ｄｅｓｉｒｅ．",%_x,%_y : add %_y,30
	lsp 11,	":s/22,20,0;#8C7853#FFE28E１２：ｉ　ｏｆｔｅｎ　ｗｏｎｄｅｒ．",%_x,%_y : add %_y,30
	lsp 12,	":s/22,20,0;#8C7853#FFE28E１３：ｂｅｇｉｎｎｉｎｇ　ｏｆ　ｌｏｖｅ．",%_x,%_y : add %_y,30
	lsp 13,	":s/22,20,0;#8C7853#FFE28E１４：ｉ　ｂｅｌｉｅｖｅ　ｍｙ　ｌｏｖｅ．",%_x,%_y : add %_y,30
	lsp 14,	":s/22,20,0;#8C7853#FFE28E１５：Ｔｈｅ　ｇｕａｒｄｉａｎ　ａｎｇｅｌ．",%_x,%_y : add %_y,30
	lsp 15, ":a/2,0,3;sys/modoru.jpg"    ,360, 550

	print BG_EFFECT
	btndef ""
	spbtn	0,1
	spbtn	1,2
	spbtn	2,3
	spbtn	3,4
	spbtn	4,5
	spbtn	5,6
	spbtn	6,7
	spbtn	7,8
	spbtn	8,9
	spbtn	9,10
	spbtn	10,11
	spbtn	11,12
	spbtn	12,13
	spbtn	13,14
	spbtn	14,15
	spbtn	15,16

*music_loop
	btnwait %work
	if %work==0 goto *music_loop
	if %work==16 gosub *click : gosub *musicstop : csp -1 : goto *title
	if %work==MOUSE_RBUTTON gosub *click : gosub *musicstop : csp -1 : goto *title
	if %work==KEY_ESCAPE    gosub *click : gosub *musicstop : csp -1 : goto *title
	if %work>=1 && %work<=15 goto *music_play
	goto *music_loop

*music_play
	;それ以外
	gosub *click
	mov  $tmp,"BGM\"		;BGM\
	itoa $tmp2,%work		;文字列に変換
	if %work<=9 add $tmp,"0"	;1-9なら、0を頭に追加
	add  $tmp, $tmp2		;BGM\0x
	add  $tmp,".mp3"		;BGM\0x.mp3
	bgm $tmp
	goto *music_mode
;-------------------------------------------------------------------
*char_introduce	;■キャラクター紹介
	bg "sys/char_intro.jpg",0	;背景設定

	mov %_x,90
	mov %_y,120
	mov $tmp,"■" : add $tmp,$g_fname: add $tmp,"　": add $tmp,$g_hero
	lsp  0,":s/24,24,0;#000000#0000B0$20",		%_x,%_y : add %_y,50
	lsp  1,":s/24,24,0;#000000#0000B0■桜井　真実", 	%_x,%_y : add %_y,50
	lsp  2,":s/24,24,0;#000000#0000B0■芹沢　小夜子",	%_x,%_y : add %_y,50
	lsp  3,":s/24,24,0;#000000#0000B0■皆月　明海",		%_x,%_y : add %_y,50
	lsp  4,":s/24,24,0;#000000#0000B0■藍田　菜摘",		%_x,%_y : add %_y,50
	lsp  5,":s/24,24,0;#000000#0000B0■矢崎　良",		%_x,%_y : add %_y,50
	lsp  6,":s/24,24,0;#000000#0000B0■野島　まゆ子",	%_x,%_y : add %_y,50
	lsp  7,":s/24,24,0;#000000#0000B0■羽根田　玖美子",	%_x,%_y : add %_y,50
	add %_x,210 : mov %_y,120
	lsp  8,":s/24,24,0;#000000#0000B0■東野　百合恵",	%_x,%_y : add %_y,50
	lsp  9,":s/24,24,0;#000000#0000B0■福崎　育巳",		%_x,%_y : add %_y,50
	lsp 10,":s/24,24,0;#000000#0000B0■片山　昌俊",		%_x,%_y : add %_y,50
	lsp 11,":s/24,24,0;#000000#0000B0■丹羽　望夫",		%_x,%_y : add %_y,50
	lsp 12,":s/24,24,0;#000000#0000B0■田口　義和",		%_x,%_y : add %_y,50

	add %_x,210 : mov %_y,120
	lsp 13,":s/24,24,0;#000000#0000B0■香津実＆篤子",	%_x,%_y : add %_y,50
	lsp 14,":s/24,24,0;#000000#0000B0■イズミ＆スダ",	%_x,%_y : add %_y,50
	lsp 15,":s/24,24,0;#000000#0000B0■守男＆渡辺",		%_x,%_y : add %_y,50
	lsp 16,":s/24,24,0;#000000#0000B0■二階堂＆根津",	%_x,%_y : add %_y,50
	mov $tmp,"■": add $tmp,$g_hero : add $tmp,"の兄"
	lsp 17,":s/24,24,0;#000000#0000B0$20",		%_x,%_y : add %_y,50
	lsp 18,":a/2,0,3;sys/modoru.jpg",360, 550

	print BG_EFFECT
	btndef ""
	spbtn 0,1
	spbtn 1,2
	spbtn 2,3
	spbtn 3,4
	spbtn 4,5
	spbtn 5,6
	spbtn 6,7
	spbtn 7,8
	spbtn 8,9
	spbtn 9,10
	spbtn 10,11
	spbtn 11,12
	spbtn 12,13
	spbtn 13,14
	spbtn 14,15
	spbtn 15,16
	spbtn 16,17
	spbtn 17,18
	spbtn 18,19

*char_introdude_wait
	btnwait %work
	if %work==0 goto *char_introduce
	if %work==MOUSE_RBUTTON  gosub *click : csp -1 : goto *title
	if %work==KEY_ESCAPE     gosub *click : csp -1 : goto *title

	if %work== 1 mov $tmp,"MABO/CH_JUN.JPG":gosub *char_out:goto *char_introduce
	if %work== 2 mov $tmp,"MABO/CH_MAKOTO.JPG":gosub *char_out:goto *char_introduce
	if %work== 3 mov $tmp,"MABO/CH_SAYOKO.JPG":gosub *char_out:goto *char_introduce
	if %work== 4 mov $tmp,"MABO/CH_AKEMI.JPG":gosub *char_out:goto *char_introduce
	if %work== 5 mov $tmp,"MABO/CH_NATUMI.JPG":gosub *char_out:goto *char_introduce
	if %work== 6 mov $tmp,"MABO/CH_YAZAKI.JPG":gosub *char_out:goto *char_introduce
	if %work== 7 mov $tmp,"MABO/CH_MAYUKO.JPG":gosub *char_out:goto *char_introduce
	if %work== 8 mov $tmp,"MABO/CH_KUMIKO.JPG":gosub *char_out:goto *char_introduce
	if %work== 9 mov $tmp,"MABO/CH_YURIE.JPG":gosub *char_out:goto *char_introduce
	if %work==10 mov $tmp,"MABO/CH_IKUMI.JPG":gosub *char_out:goto *char_introduce
	if %work==11 mov $tmp,"MABO/CH_KATA.JPG":gosub *char_out:goto *char_introduce
	if %work==12 mov $tmp,"MABO/CH_NIWA.JPG":gosub *char_out:goto *char_introduce
	if %work==13 mov $tmp,"MABO/CH_TAGUTI.JPG":gosub *char_out:goto *char_introduce
	if %work==14 mov $tmp,"MABO/CH_KATATU.JPG":gosub *char_out:goto *char_introduce
	if %work==15 mov $tmp,"MABO/CH_IZUSUD.JPG":gosub *char_out:goto *char_introduce
	if %work==16 mov $tmp,"MABO/CH_MORHON.JPG":gosub *char_out:goto *char_introduce
	if %work==17 mov $tmp,"MABO/CH_NIKNED.JPG":gosub *char_out:goto *char_introduce
	if %work==18 mov $tmp,"MABO/CH_HAL.JPG":gosub *char_out:goto *char_introduce
	if %work==19 gosub *click:csp -1: goto *title

	goto *char_introdude_wait

*char_out
	gosub *click
	csp -1
;	if %work==19 gosub *click:csp -1: goto *title
	bg $20,CG_EFFECT	;numalias tmp		,20
;	spbtn 18,19
;	btnwait %work
;	if %work==19 gosub *click : return
	gosub *waitkey
	return

;-------------------------------------------------------------------
;■CONFIG画面の処理
;	Copyright (C) 2002 ちぇりーそふと. All rights reserved.
;-------------------------------------------------------------------
*config	;■CONFIG画面
	gosub *config_out

*config_btndef
	btndef ""
	spbtn SP_CFG_EXIT,		BTN_CFG_EXIT
if %g_window_mode==n_WINDOWMODE spbtn SP_CFG_FULLSCREEN,BTN_CFG_FULLSCREEN
if %g_window_mode==n_FULLSCREEN spbtn SP_CFG_WINDOW,BTN_CFG_WINDOW
	spbtn SP_CFG_BGMVOL_UP,		BTN_CFG_BGMVOL_UP
	spbtn SP_CFG_BGMVOL_DOWN,	BTN_CFG_BGMVOL_DOWN
	spbtn SP_CFG_SEVOL_UP,		BTN_CFG_SEVOL_UP
	spbtn SP_CFG_SEVOL_DOWN,	BTN_CFG_SEVOL_DOWN
	spbtn SP_CFG_VOICEVOL_UP,	BTN_CFG_VOICEVOL_UP
	spbtn SP_CFG_VOICEVOL_DOWN,	BTN_CFG_VOICEVOL_DOWN
	spbtn SP_CFG_CHARB,		BTN_CFG_CHARB
	spbtn SP_CFG_CHARC,		BTN_CFG_CHARC
	spbtn SP_CFG_CHARD,		BTN_CFG_CHARD
	spbtn SP_CFG_OTHER,		BTN_CFG_OTHER
	spbtn SP_CFG_HSE,		BTN_CFG_HSE
	spbtn SP_CFG_TOUKA_UP,		BTN_CFG_TOUKA_UP
	spbtn SP_CFG_TOUKA_DOWN,	BTN_CFG_TOUKA_DOWN
	spbtn SP_CFG_TEXTSPEED_UP,	BTN_CFG_TEXTSPEED_UP
	spbtn SP_CFG_TEXTSPEED_DOWN,	BTN_CFG_TEXTSPEED_DOWN
	spbtn SP_CFG_SKIPMODE,		BTN_CFG_SKIPMODE
;	spbtn SP_CFG_SKIPSTOP,		BTN_CFG_SKIPSTOP
	spbtn SP_CFG_HINT,		BTN_CFG_HINT

*config_btnwait	;■ボタン待ち
	btnwait %work
	if %work==MOUSE_RBUTTON goto *config_end
	if %work==KEY_ESCAPE goto *config_end
	if %work==BTN_CFG_EXIT		gosub *click : goto *config_end
	if %work==BTN_CFG_WINDOW	gosub *config_window : goto *config_btndef
	if %work==BTN_CFG_FULLSCREEN	gosub *config_fullscreen  : goto *config_btndef
	if %work==BTN_CFG_BGMVOL_UP	inc %g_vol_bgm : gosub *config_out : goto *config_btndef
	if %work==BTN_CFG_BGMVOL_DOWN	dec %g_vol_bgm : gosub *config_out : goto *config_btndef
	if %work==BTN_CFG_SEVOL_UP	inc %g_vol_SE : gosub *config_out : gosub *click : goto *config_btndef
	if %work==BTN_CFG_SEVOL_DOWN	dec %g_vol_SE : gosub *config_out : gosub *click : goto *config_btndef
	if %work==BTN_CFG_VOICEVOL_UP	inc %g_vol_VOICE : gosub *config_out : gosub *voice_test : goto *config_btndef
	if %work==BTN_CFG_VOICEVOL_DOWN	dec %g_vol_VOICE : gosub *config_out : gosub *voice_test : goto *config_btndef
	if %work==BTN_CFG_CHARB		gosub *config_charb: gosub *config_out : goto *config_btndef
	if %work==BTN_CFG_CHARC		gosub *config_charc: gosub *config_out : goto *config_btndef
	if %work==BTN_CFG_CHARD		gosub *config_chard: gosub *config_out : goto *config_btndef
	if %work==BTN_CFG_OTHER		gosub *config_other: gosub *config_out : goto *config_btndef
	if %work==BTN_CFG_HSE		gosub *config_hse: gosub *config_out : goto *config_btndef
	if %work==BTN_CFG_TOUKA_UP	inc %g_touka : gosub *toukado :gosub *config_out : goto *config_btndef
	if %work==BTN_CFG_TOUKA_DOWN	dec %g_touka : gosub *toukado :gosub *config_out : goto *config_btndef
	if %work==BTN_CFG_TEXTSPEED_UP	inc %g_text_speed : gosub *config_out : goto *config_btndef
	if %work==BTN_CFG_TEXTSPEED_DOWN dec %g_text_speed : gosub *config_out : goto *config_btndef
	if %work==BTN_CFG_SKIPMODE	gosub *config_skipmode : gosub *config_out : goto *config_btndef
;	if %work==BTN_CFG_SKIPSTOP	gosub *config_skipstop : gosub *config_out : goto *config_btndef
	if %work==BTN_CFG_HINT		gosub *config_hint : gosub *config_out : goto *config_btndef
;--------------------------------------------

	goto *config_btnwait

*config_out	;■CONFIG画面の描画
	;使用するスプライトをクリア
	for %work=SP_CFG_EXIT to SP_CFG_BG:csp %work:next

;◆下地を読み込み
	lsp SP_CFG_BG,":a;SYS/CFG_BG.jpg",0,0

;◆ウィンドウモード
;現在フルスクリーンかどうかを取得する命令isfullを作りました。
;isfull %変数番号
;Alt+Returnでもスクリーンモードを変えられるので、この命令以外では
;現在のスクリーンモードは取得できません。

	isfull %g_window_mode
	lsp SP_CFG_FULLSCREEN, ":a/2,0,3;SYS/CFG_FULL.JPG",200,40
	lsp SP_CFG_WINDOW,     ":a/2,0,3;SYS/CFG_WIN.JPG", 280,40
	if %g_window_mode==n_WINDOWMODE cell SP_CFG_FULLSCREEN,0 : cell SP_CFG_WINDOW,1
	if %g_window_mode==n_FULLSCREEN cell SP_CFG_FULLSCREEN,1 : cell SP_CFG_WINDOW,0

;◆ＢＧＭ
	lsp SP_CFG_BGMVOL_DOWN,	":l/2,0,3;SYS/CFG_DN.JPG", 74,123
	lsp SP_CFG_BGMVOL_UP,	":l/2,0,3;SYS/CFG_UP.JPG",309,123
;	bar バー番号,現在値,x,y,幅,高さ,バーの最大値,色
	bar SP_CFG_BGMVOL,%g_vol_bgm,99,125,200,10,5,#AB4330

	if %g_vol_bgm=0 mp3vol  0  
	if %g_vol_bgm=1 mp3vol  20 
	if %g_vol_bgm=2 mp3vol  40 
	if %g_vol_bgm=3 mp3vol  60 
	if %g_vol_bgm=4 mp3vol  80 
	if %g_vol_bgm=5 mp3vol 100 

;◆ＳＥ
	lsp SP_CFG_SEVOL_DOWN,	":l/2,0,3;SYS/CFG_DN.JPG", 74,173
	lsp SP_CFG_SEVOL_UP,	":l/2,0,3;SYS/CFG_UP.JPG",309,173
;	bar バー番号,現在値,x,y,幅,高さ,バーの最大値,色
	bar SP_CFG_SEVOL,%g_vol_se,99,175,200,10,5,#AB4330

	if %g_vol_SE=0 sevol  0  
	if %g_vol_SE=1 sevol  20 
	if %g_vol_SE=2 sevol  40 
	if %g_vol_SE=3 sevol  60 
	if %g_vol_SE=4 sevol  80 
	if %g_vol_SE=5 sevol 100 

;◆音声
	lsp SP_CFG_VOICEVOL_DOWN,":l/2,0,3;SYS/CFG_DN.JPG",74,223
	lsp SP_CFG_VOICEVOL_UP,	":l/2,0,3;SYS/CFG_UP.JPG",309,223
;	bar バー番号,現在値,x,y,幅,高さ,バーの最大値,色
	bar SP_CFG_VOICEVOL,%g_vol_voice,99,225,200,10,5,#AB4330

	if %g_vol_VOICE=0 voicevol   0
	if %g_vol_VOICE=1 voicevol  20 
	if %g_vol_VOICE=2 voicevol  40 
	if %g_vol_VOICE=3 voicevol  60 
	if %g_vol_VOICE=4 voicevol  80 
	if %g_vol_VOICE=5 voicevol 100 

;◆キャラ別
	if %g_charb==1 lsp SP_CFG_CHARB,":l/2,0,3;SYS/CFG_VOICEB.JPG",  60,260
	if %g_charb==0 lsp SP_CFG_CHARB,":l/2,0,3;SYS/CFG_VOICEB2.JPG", 60,260

	if %g_charc==1 lsp SP_CFG_CHARC,":l/2,0,3;SYS/CFG_VOICEC.JPG", 120,260
	if %g_charc==0 lsp SP_CFG_CHARC,":l/2,0,3;SYS/CFG_VOICEC2.JPG",120,260

	if %g_chard==1 lsp SP_CFG_CHARD,":l/2,0,3;SYS/CFG_VOICED.JPG", 180,260
	if %g_chard==0 lsp SP_CFG_CHARD,":l/2,0,3;SYS/CFG_VOICED2.JPG",180,260

	if %g_other==1 lsp SP_CFG_OTHER,":l/2,0,3;SYS/CFG_VOICEX.JPG", 240,260
	if %g_other==0 lsp SP_CFG_OTHER,":l/2,0,3;SYS/CFG_VOICEX2.JPG",240,260

 ;◆Ｈ効果音
	if %g_hse==1 lsp SP_CFG_HSE,":l/2,0,3;SYS/CFG_VOICEH.JPG", 300,260
	if %g_hse==0 lsp SP_CFG_HSE,":l/2,0,3;SYS/CFG_VOICEH2.JPG",300,260

;◆透過
	lsp SP_CFG_TOUKA_DOWN,":l/2,0,3;SYS/CFG_DN.JPG", 74,333
	lsp SP_CFG_TOUKA_UP,  ":l/2,0,3;SYS/CFG_UP.JPG",309,333
	bar SP_CFG_TOUKA,%g_touka,99,335,200,10,4,#AB4330
	gosub *touka_val	;透過再設定

;◆メッセージスピード
	lsp SP_CFG_TEXTSPEED_DOWN,":l/2,0,3;SYS/CFG_DN.JPG", 74,383
	lsp SP_CFG_TEXTSPEED_UP,  ":l/2,0,3;SYS/CFG_UP.JPG",309,383
	bar SP_CFG_TEXTSPEED,%g_text_speed,99,385,200,10,5,#AB4330
	gosub *speed_val	;メッセージスピード再設定

;◆ヒント
	if %g_hint==OFF lsp SP_CFG_HINT,":a/2,0,3;SYS/CFG_HINT.JPG", 67,440
	if %g_hint==ON  lsp SP_CFG_HINT,":a/2,0,3;SYS/CFG_HINT2.JPG",67,440

;◆スキップ
;	numalias g_skipmode	,217	;スキップモード ０：全て、１：既読

	if %g_skipmode==ON  lsp SP_CFG_SKIPMODE,":a/2,0,3;SYS/CFG_SKIP2.JPG",80,490
	if %g_skipmode==OFF lsp SP_CFG_SKIPMODE,":a/2,0,3;SYS/CFG_SKIP.JPG", 80,490

;	if %g_skipstop==ON  lsp SP_CFG_SKIPSTOP,":a/2,0,3;SYS/CFG_STOP2.JPG",80,520 ;継続
;	if %g_skipstop==OFF lsp SP_CFG_SKIPSTOP,":a/2,0,3;SYS/CFG_STOP.JPG", 80,520 ;スキップ止める

;◆ゲームへ戻る
	lsp SP_CFG_EXIT, ":l/2,0,3;SYS/CFG_EXIT.JPG",240,570

;再描画
	print 1
	return

*voice_test	;●音声のテスト
	;fileexist %work,$tmp	;ここでファイルの存在をチェック
	;if %work==0 return	;ファイルが存在しなければ戻る
	mov $_voice,"VCCHK" : gosub *vo
	return

*config_window	;●ウィンドウモードに変更
	if %g_window_mode==n_WINDOWMODE return	;すでにウィンドウモードなので何もしない
	gosub *click		;クリック音を鳴らす
	mov %g_window_mode,n_WINDOWMODE
	menu_window		;ウィンドウ画面モードにします。
	cell SP_CFG_FULLSCREEN,0 : cell SP_CFG_WINDOW,1
	print 1
	return

*config_fullscreen	;●フルスクリーンに変更
	if %g_window_mode==n_FULLSCREEN return	;すでにフルスクリーンなので何もしない
	gosub *click		;クリック音を鳴らす
	mov %g_window_mode,n_FULLSCREEN
	menu_full		;フル画面モードにします。
	cell SP_CFG_FULLSCREEN,1 : cell SP_CFG_WINDOW,0
	print 1
	return

*config_charb	;●真実の音声をＯＮ／ＯＦＦ
	;OFFでクリックされたらONにする
	movemousecursor 150,255
	if %g_charb==OFF : mov %g_charb,ON  :  mov $_voice,"VCHARB" : gosub *vo : return
	if %g_charb==ON  : mov %g_charb,OFF :  gosub *click : return

*config_charc	;●明海の音声のＯＮ／ＯＦＦ
	;OFFでクリックされたらONにする
	movemousecursor 205,255
	if %g_charc==OFF : mov %g_charc,ON  : mov $_voice,"VCHARC" : gosub *vo : return
	if %g_charc==ON  : mov %g_charc,OFF : gosub *click : return

*config_chard	;●小夜子の音声のＯＮ／ＯＦＦ
	;OFFでクリックされたらONにする
	movemousecursor 270,255
	if %g_chard==OFF : mov %g_chard,ON  : mov $_voice,"VCHARD" : gosub *vo : return
	if %g_chard==ON  : mov %g_chard,OFF : gosub *click : return

*config_other	;●その他の音声のＯＮ／ＯＦＦ
	;OFFでクリックされたらONにする
	movemousecursor 312,260
	if %g_other==OFF : mov %g_other,ON  : mov $_voice,"VOTHER" :  gosub *vo :return
	if %g_other==ON  : mov %g_other,OFF : gosub *click : return
	
*config_hse	;●Ｈな効果音のＯＮ／ＯＦＦ
	movemousecursor 300,318
	if %g_hse==OFF : mov %g_hse,ON  : mov $_se,"WSECHK":  gosub *se : return
	if %g_hse==ON  : mov %g_hse,OFF : gosub *click : return

*toukado	;●ウィンドウの透過度を変える
	;一回の変化分はとりあえず50
;	amsp SP_WIN,sitaji_x,sitaji_y,%touka
	if %g_touka<0 mov %g_touka,0
	if %g_touka>4 mov %g_touka,4

	gosub *touka_val
	;最後の透過度をグローバル変数に入れて、状態を記憶させる
	return

*config_skipmode	;●スキップモードのＯＮ／ＯＦＦ
	movemousecursor 370,530
	if %g_skipmode==OFF : mov %g_skipmode,ON  : kidokumode 0 : gosub *click : return
	if %g_skipmode==ON  : mov %g_skipmode,OFF : kidokumode 1 : gosub *click : return

*config_hint	;●ヒントのＯＮ／ＯＦＦ
	movemousecursor 370,480
	if %g_hint==OFF : mov %g_hint,ON  : gosub *click : return
	if %g_hint==ON  : mov %g_hint,OFF : gosub *click : return

*config_skipstop	;●スキップ継続か否か
;	numalias g_skipstop	,218	;選択肢でスキップ停止 0:しない 1:する
	if %g_skipstop==OFF : mov %g_skipstop,ON  : gosub *click : return
	if %g_skipstop==ON  : mov %g_skipstop,OFF : gosub *click : return

;●isskip %数字変数
;例）isskip %0
;現在がスキップモードなら１、オートモードなら２、通常モードなら０を返します。
;	isskip %g_window_mode
;	if %g_window_mode==SKIP_SKIP	
;	if %g_window_mode==SKIP_AUTO
;	if %g_window_mode==SKIP_NONE

;---------------------------------------------------------------------------
*config_end	;●CONFIGの終了
	for %work=SP_CFG_EXIT to SP_CFG_BG:csp %work:next
	barclear
	if %is_adv=0 goto *title ;タイトルから来ているときはタイトルに戻る
	return	 ;それ以外の時はシステムに戻る

;---------------------------------------------------------------------------
*speed_val	;■スピードの調整
	if %g_text_speed==0 textspeed 80
	if %g_text_speed==1 textspeed 40
	if %g_text_speed==2 textspeed 20
	if %g_text_speed==3 textspeed 10
	if %g_text_speed==4 textspeed 5 
	if %g_text_speed==5 textspeed 0 
	return
;---------------------------------------------------------------------------
*touka_val	;■透過の値設定
	if %g_touka=0 mov %touka,  50
	if %g_touka=1 mov %touka, 100 
	if %g_touka=2 mov %touka, 150 
	if %g_touka=3 mov %touka, 200 
	if %g_touka=4 mov %touka, 250 
	if %g_touka=5 mov %touka, 300 
	return
;---------------------------------------------------------------------------

;-------------------------------------------------------------------
;■セーブ＆ロード画面
;-------------------------------------------------------------------
*save	;■セーブ画面
	gosub *save_reset

*save_btndef
	btndef ""
	spbtn SP_SAVEPAGE1,BTN_PAGE1
	spbtn SP_SAVEPAGE2,BTN_PAGE2
	spbtn SP_SAVEPAGE3,BTN_PAGE3
	spbtn SP_SAVEPAGE4,BTN_PAGE4
	spbtn SP_SAVEPAGE5,BTN_PAGE5
	spbtn SP_SAVESLOT01,1
	spbtn SP_SAVESLOT02,2
	spbtn SP_SAVESLOT03,3
	spbtn SP_SAVESLOT04,4
	spbtn SP_SAVESLOT05,5
	spbtn SP_SAVESLOT06,6
	spbtn SP_SAVESLOT07,7
	spbtn SP_SAVESLOT08,8
	spbtn SP_SAVESLOT09,9
	spbtn SP_SAVESLOT10,10
	spbtn SP_SAVEEXIT,BTN_SAVEEXIT

*save_btnloop
	btnwait %work
	if %work >=  1 && %work <= 10 :mov %slot,%work	:dec %slot :goto *save_do
	if %work==BTN_PAGE1 gosub *click : mov %g_savepage,0: gosub *save_reset:goto *save_btndef
	if %work==BTN_PAGE2 gosub *click : mov %g_savepage,1: gosub *save_reset:goto *save_btndef
	if %work==BTN_PAGE3 gosub *click : mov %g_savepage,2: gosub *save_reset:goto *save_btndef
	if %work==BTN_PAGE4 gosub *click : mov %g_savepage,3: gosub *save_reset:goto *save_btndef
	if %work==BTN_PAGE5 gosub *click : mov %g_savepage,4: gosub *save_reset:goto *save_btndef
	if %work==BTN_SAVEEXIT : gosub *click : goto *save_end
	if %work==MOUSE_RBUTTON : goto *save_end
	if %work==KEY_ESCAPE : goto *save_end
	goto *save_btnloop
;-----------------------------------------------------------
*save_do
	lsp SP_DLG,":a;sys/dlg.jpg",0,0:print 1
	lsp SP_DLG_MES,":s/24,24,0;#FFFFFFセーブしますか？",300,280
	lsp SP_DLG_YES,":a/2,0,3;sys/dlg_yes.jpg",DLG_YES_X,DLG_YES_Y
	lsp SP_DLG_NO, ":a/2,0,3;sys/dlg_no.jpg", DLG_NO_X, DLG_NO_Y
	print 1

	btndef ""
	spbtn SP_DLG_YES,BTN_YES
	spbtn SP_DLG_NO, BTN_NO

*save_confirm_wait
	btnwait %work
	if %work = MOUSE_RBUTTON goto *save_do_end
	if %work = KEY_ESCAPE goto *save_do_end
	if %work = BTN_YES gosub *se_ok     : goto *save_do_ok
	if %work = BTN_NO  gosub *se_cancel : goto *save_do_end
	goto *save_confirm_wait

*save_do_ok
	if %g_savepage==0 mov %saveno,00
	if %g_savepage==1 mov %saveno,10
	if %g_savepage==2 mov %saveno,20
	if %g_savepage==3 mov %saveno,30
	if %g_savepage==4 mov %saveno,40
	add %saveno,%slot			;１の位足し込み
	savegame %saveno			;データをセーブ
	savetime %saveno,%month,%day,%hour,%min	;セーブファイルの日付を取得
;	ページ%g_savepageセーブ%saveno番は%month月%day日%hour時%min分@

	mov $savestr,""
	itoa $tmp,%saveno:gosub *to2keta: add $savestr,$tmp: add $savestr,"）"
	itoa $tmp,%month :gosub *to2keta: add $savestr,$tmp: add $savestr,"月"
	itoa $tmp,%day   :gosub *to2keta: add $savestr,$tmp: add $savestr,"日　"
	itoa $tmp,%hour  :gosub *to2keta: add $savestr,$tmp: add $savestr,"時"
	itoa $tmp,%min   :gosub *to2keta: add $savestr,$tmp: add $savestr,"分"

;----
;セーブにコメント入れたかったんだが…。いまいち…。cselテキスト抜けないし。
;シナリオごとにタイトルをどっかに保存しとくようにしとけば、次はできるな…。
;	add $savestr,"　"
;	mid $tmp,$textstr,0,14
;	add $savestr,$tmp
;---
	mov %work,g_save_slot :	add %work,%saveno ; %work＝グローバル変数のindex
	mov $%work,$savestr	;セーブ文字列保存
;	%work ： $%work\
	goto *save_do_end

*save_do_end
	csp SP_DLG
	csp SP_DLG_MES
	csp SP_DLG_YES
	csp SP_DLG_NO
	print 1
	goto *save
;-----------------------------------------------------------
*save_end
	btndef ""
	for %work=SP_SAVEPAGE1 to SP_SAVEBG:csp %work:next
;	repaint
	return
;-----------------------------------------------------------
*save_reset
	;使用するスプライトをクリア
	for %work=SP_SAVEPAGE1 to SP_SAVEBG:csp %work:next

	;ページ番号を表示
	lsp SP_SAVEPAGE1,":c/2,0,3;SYS\S1.bmp",590,93
	lsp SP_SAVEPAGE2,":c/2,0,3;SYS\S2.bmp",620,93
	lsp SP_SAVEPAGE3,":c/2,0,3;SYS\S3.bmp",650,93
	lsp SP_SAVEPAGE4,":c/2,0,3;SYS\S4.bmp",680,93
	lsp SP_SAVEPAGE5,":c/2,0,3;SYS\S5.bmp",710,93

	if %g_savepage==0 lsp SP_SAVEPAGE1,":c/2,0,3;SYS\S1_.bmp",590,93
	if %g_savepage==1 lsp SP_SAVEPAGE2,":c/2,0,3;SYS\S2_.bmp",620,93
	if %g_savepage==2 lsp SP_SAVEPAGE3,":c/2,0,3;SYS\S3_.bmp",650,93
	if %g_savepage==3 lsp SP_SAVEPAGE4,":c/2,0,3;SYS\S4_.bmp",680,93
	if %g_savepage==4 lsp SP_SAVEPAGE5,":c/2,0,3;SYS\S5_.bmp",710,93

	;下地を読み込み
	lsp SP_SAVEBG,":c;SYS\SAVEBG.jpg",0,0 


	if %g_savepage==0 mov %work,300
	if %g_savepage==1 mov %work,310
	if %g_savepage==2 mov %work,320
	if %g_savepage==3 mov %work,330
	if %g_savepage==4 mov %work,340

	mov %_x,140	;Ｘ座標初期値
	mov %_y,120	;Ｙ座標初期値

	;$20は$tmp

	mov $20,$%work:lsp SP_SAVESLOT01,":s/24,24,2;#FFFFFF#ff9999$20",%_x,%_y :add %_y,30 :inc %work
	mov $20,$%work:lsp SP_SAVESLOT02,":s/24,24,2;#FFFFFF#ff9999$20",%_x,%_y :add %_y,30 :inc %work
	mov $20,$%work:lsp SP_SAVESLOT03,":s/24,24,2;#FFFFFF#ff9999$20",%_x,%_y :add %_y,30 :inc %work
	mov $20,$%work:lsp SP_SAVESLOT04,":s/24,24,2;#FFFFFF#ff9999$20",%_x,%_y :add %_y,30 :inc %work
	mov $20,$%work:lsp SP_SAVESLOT05,":s/24,24,2;#FFFFFF#ff9999$20",%_x,%_y :add %_y,30 :inc %work
	mov $20,$%work:lsp SP_SAVESLOT06,":s/24,24,2;#FFFFFF#ff9999$20",%_x,%_y :add %_y,30 :inc %work
	mov $20,$%work:lsp SP_SAVESLOT07,":s/24,24,2;#FFFFFF#ff9999$20",%_x,%_y :add %_y,30 :inc %work
	mov $20,$%work:lsp SP_SAVESLOT08,":s/24,24,2;#FFFFFF#ff9999$20",%_x,%_y :add %_y,30 :inc %work
	mov $20,$%work:lsp SP_SAVESLOT09,":s/24,24,2;#FFFFFF#ff9999$20",%_x,%_y :add %_y,30 :inc %work
	mov $20,$%work:lsp SP_SAVESLOT10,":s/24,24,2;#FFFFFF#ff9999$20",%_x,%_y

	lsp SP_SAVEEXIT,":a/2,0,3;sys/modoru.jpg",360,440
	print 1
	return

;----------------------------------------------------------------------------
*load	;■ロード画面
	gosub *load_reset

*load_btndef
	btndef ""
	spbtn SP_SAVEPAGE1,BTN_PAGE1
	spbtn SP_SAVEPAGE2,BTN_PAGE2
	spbtn SP_SAVEPAGE3,BTN_PAGE3
	spbtn SP_SAVEPAGE4,BTN_PAGE4
	spbtn SP_SAVEPAGE5,BTN_PAGE5
	spbtn SP_SAVESLOT01,1
	spbtn SP_SAVESLOT02,2
	spbtn SP_SAVESLOT03,3
	spbtn SP_SAVESLOT04,4
	spbtn SP_SAVESLOT05,5
	spbtn SP_SAVESLOT06,6
	spbtn SP_SAVESLOT07,7
	spbtn SP_SAVESLOT08,8
	spbtn SP_SAVESLOT09,9
	spbtn SP_SAVESLOT10,10
	spbtn SP_SAVEEXIT,BTN_SAVEEXIT

*load_btnloop
	btnwait %work
	if %work>=1 && %work<=10 :mov %slot,%work :dec %slot :goto *load_do
	if %work==BTN_PAGE1 gosub *click : mov %g_savepage,0: gosub *load_reset:goto *load_btndef
	if %work==BTN_PAGE2 gosub *click : mov %g_savepage,1: gosub *load_reset:goto *load_btndef
	if %work==BTN_PAGE3 gosub *click : mov %g_savepage,2: gosub *load_reset:goto *load_btndef
	if %work==BTN_PAGE4 gosub *click : mov %g_savepage,3: gosub *load_reset:goto *load_btndef
	if %work==BTN_PAGE5 gosub *click : mov %g_savepage,4: gosub *load_reset:goto *load_btndef
	if %work==BTN_SAVEEXIT : gosub *click : goto *load_end
	if %work==MOUSE_RBUTTON : goto *load_end
	if %work==KEY_ESCAPE : goto *load_end
	goto *load_btnloop

;-----------------------------------------------------------
*load_do
	;saveno生成
	if %g_savepage==0 mov %saveno,00
	if %g_savepage==1 mov %saveno,10
	if %g_savepage==2 mov %saveno,20
	if %g_savepage==3 mov %saveno,30
	if %g_savepage==4 mov %saveno,40
	add %saveno,%slot			;１の位足し込み

	;セーブファイルが存在しないなら、何もしないでロード画面に戻る
	savefileexist %work,%saveno : if %work==0 goto *load

	lsp SP_DLG,":a;sys/dlg.jpg",0,0:print 1
	lsp SP_DLG_MES,":s/24,24,0;#FFFFFFロードしますか？",300,280
	lsp SP_DLG_YES,":a/2,0,3;sys/dlg_yes.jpg",DLG_YES_X,DLG_YES_Y
	lsp SP_DLG_NO, ":a/2,0,3;sys/dlg_no.jpg", DLG_NO_X, DLG_NO_Y

	print 1

	btndef ""
	spbtn SP_DLG_YES,BTN_YES
	spbtn SP_DLG_NO, BTN_NO

*load_confirm_wait
	btnwait %work
	if %work = MOUSE_RBUTTON goto *load_do_end
	if %work = KEY_ESCAPE goto *load_do_end
	if %work = BTN_YES gosub *se_ok     : goto *load_do_ok
	if %work = BTN_NO  gosub *se_cancel : goto *load_do_end
	goto *load_confirm_wait

*load_do_ok
	gosub *touka_val
	loadgame %saveno			;データをセーブ

*load_do_end
	csp SP_DLG
	csp SP_DLG_MES
	csp SP_DLG_YES
	csp SP_DLG_NO
	print 1
	goto *load

;-----------------------------------------------------------
*load_end
	for %work=SP_SAVEPAGE1 to SP_SAVEBG:csp %work:next
	btndef ""
	if %is_adv=0 goto *title ;タイトルから来ているときはタイトルに戻る
	;goto *system		 ;それ以外の時はシステムに戻る

	return
;-----------------------------------------------------------
*load_reset
	;使用するスプライトをクリア
	for %work=SP_SAVEPAGE1 to SP_SAVEBG:csp %work:next

	;ページ番号を表示
	lsp SP_SAVEPAGE1,":c/2,0,3;SYS\L1.bmp",590,93
	lsp SP_SAVEPAGE2,":c/2,0,3;SYS\L2.bmp",620,93
	lsp SP_SAVEPAGE3,":c/2,0,3;SYS\L3.bmp",650,93
	lsp SP_SAVEPAGE4,":c/2,0,3;SYS\L4.bmp",680,93
	lsp SP_SAVEPAGE5,":c/2,0,3;SYS\L5.bmp",710,93

	if %g_savepage==0 lsp SP_SAVEPAGE1,":c/2,0,3;SYS\L1_.bmp",590,93
	if %g_savepage==1 lsp SP_SAVEPAGE2,":c/2,0,3;SYS\L2_.bmp",620,93
	if %g_savepage==2 lsp SP_SAVEPAGE3,":c/2,0,3;SYS\L3_.bmp",650,93
	if %g_savepage==3 lsp SP_SAVEPAGE4,":c/2,0,3;SYS\L4_.bmp",680,93
	if %g_savepage==4 lsp SP_SAVEPAGE5,":c/2,0,3;SYS\L5_.bmp",710,93

	;下地を読み込み
	lsp SP_SAVEBG,":c;SYS\LOADBG.jpg",0,0 

	if %g_savepage==0 mov %work,300
	if %g_savepage==1 mov %work,310
	if %g_savepage==2 mov %work,320
	if %g_savepage==3 mov %work,330
	if %g_savepage==4 mov %work,340

	mov %_x,140	;Ｘ座標初期値
	mov %_y,120	;Ｙ座標初期値

	;$20は$tmp
	mov $20,$%work:lsp SP_SAVESLOT01,":s/24,24,2;#FFFFFF#ff9999$20",%_x,%_y :add %_y,30 :inc %work
	mov $20,$%work:lsp SP_SAVESLOT02,":s/24,24,2;#FFFFFF#ff9999$20",%_x,%_y :add %_y,30 :inc %work
	mov $20,$%work:lsp SP_SAVESLOT03,":s/24,24,2;#FFFFFF#ff9999$20",%_x,%_y :add %_y,30 :inc %work
	mov $20,$%work:lsp SP_SAVESLOT04,":s/24,24,2;#FFFFFF#ff9999$20",%_x,%_y :add %_y,30 :inc %work
	mov $20,$%work:lsp SP_SAVESLOT05,":s/24,24,2;#FFFFFF#ff9999$20",%_x,%_y :add %_y,30 :inc %work
	mov $20,$%work:lsp SP_SAVESLOT06,":s/24,24,2;#FFFFFF#ff9999$20",%_x,%_y :add %_y,30 :inc %work
	mov $20,$%work:lsp SP_SAVESLOT07,":s/24,24,2;#FFFFFF#ff9999$20",%_x,%_y :add %_y,30 :inc %work
	mov $20,$%work:lsp SP_SAVESLOT08,":s/24,24,2;#FFFFFF#ff9999$20",%_x,%_y :add %_y,30 :inc %work
	mov $20,$%work:lsp SP_SAVESLOT09,":s/24,24,2;#FFFFFF#ff9999$20",%_x,%_y :add %_y,30 :inc %work
	mov $20,$%work:lsp SP_SAVESLOT10,":s/24,24,2;#FFFFFF#ff9999$20",%_x,%_y
	
	lsp SP_SAVEEXIT,":a/2,0,3;sys/modoru.jpg",360,440
	print 1
	return


;6.TXT
;-------------------------------------------------------------------
;■ゲームの処理
;	Copyright (C) 2002 ちぇりーそふと. All rights reserved.
;-------------------------------------------------------------------
*se	;■ＳＥ再生ルーチン 
;このルーチンは$tmp,$tmp2を破壊する
;指定が無ければ何もしない
	if $_se=="" return

;Ｈな効果音のON/OFF
	mov $tmp2,$_se
	mid $tmp,$tmp2,0,1	;$_voiceから1文字目を$tmpに切り出す
	if %g_hse==OFF && $tmp=="W" :  return

;ファイル名生成
	mov $tmp, "SE/"
	add $tmp, $_se
	add $tmp, ".WAV"

;fileexist %変数番号,"ファイル名"
;ファイルがあれば１、なければ０が返ります。
	fileexist %work,$tmp	;ここでファイルの存在をチェック
	gosub *debugout_se
	if %work==0 return	;ファイルが存在しなければ戻る
;再生
	dwave CH_SE,$tmp
	return
;-------------------------------------------------------------------
*sestop	;■ＳＥ停止ルーチン
	dwavestop CH_SE
	mov $_se,""
	return
;-------------------------------------------------------------------
*vo	;■音声再生ルーチン
;このルーチンは$tmp,$tmp2を破壊する
;指定が無ければ何もしない
	if $_voice=="" : return

;音声ON/OFFチェック
	mov $tmp2,$_voice
	mid $tmp,$tmp2,0,1	;$_voiceから1文字目を$tmpに切り出す
	if %g_charb==OFF && $tmp=="B" return
	if %g_charc==OFF && $tmp=="C" return
	if %g_chard==OFF && $tmp=="D" return
	if %g_other==OFF && $tmp=="X" return
	if %g_other==OFF && $tmp=="Y" return

	if %g_charb==OFF && $tmp=="b" return
	if %g_charc==OFF && $tmp=="c" return
	if %g_chard==OFF && $tmp=="d" return
	if %g_other==OFF && $tmp=="x" return
	if %g_other==OFF && $tmp=="y" return

;ファイル名生成
	mov $tmp, "VOICE/"
	add $tmp, $_voice
	add $tmp, ".WAV"

;ファイル存在チェック
	fileexist %work,$tmp	;ここでファイルの存在をチェック
	gosub *debugout_vo
	if %work==0 return	;ファイルが存在しなければ戻る

;再生
	dwave CH_VOICE,$tmp
	return
;-------------------------------------------------------------------
*bg	;■背景表示ルーチン
	if $_bg=="" return
	if $old_bg==$_bg return	;前回と同じなら何も表示しない
	mov $old_bg,$_bg	;背景ファイル名をold_bgに保存

	mov $tmp,"BG/"		;tmp = BG\
	add $tmp,$_bg		;tmp = BG\xxx
	add $tmp,".JPG"		;tmp = BG\xxx.BMP

	fileexist %work,$tmp	;ここでファイルの存在をチェック
	gosub *debugout_bg
	if %work==0 return	;ファイルが存在しなければ戻る

	if $_bg == "BLACK" gosub *clear_cg_var 
	if $_bg == "WHITE" gosub *clear_cg_var 

;	bg black,CG_EFFECT : wait 200
	;エフェクトの指定がなければ、デフォルトの指定で出力
	if %effect==0 	bg $tmp,BG_EFFECT : return	;背景を表示

	;エフェクトの指定があれば、その指定で出力
	;エフェクトの効力は１回のみ
	bg $tmp,%effect : mov %effect,0  : return
;-------------------------------------------------------------------
*char	;■立ちグラ表示ルーチン
	if $_char=="" return
	if $old_char==$_char return	;立ちグラが前回と同じなら何も表示しない
	mov $old_char,$_char		;立ちグラファイル名をold_charに保存

;真実の眼鏡処理 --- 眼鏡なしだと末尾に"_"を追加
;	numalias g_nomegane	,222	;ONで眼鏡なし。デフォルトOFF
;mid $0,$1,%0,%1
;文字列$1の%0文字目から%1文字分の部分文字列を$0に切り出します。
;ただし、最初の文字を０文字目と数えてください。
	mov $tmp2,$_char
	mid $tmp,$tmp2,0,2	;$_charから２文字を$tmpに切り出す
	if %g_nomegane==ON && $tmp=="TB"  add $_char,"_" ; 末尾に_を追加

	mov $tmp,"CHAR/"             ;tmp = :a;CHAR/
	add $tmp,$_char                 ;tmp = CHAR/xxx
	add $tmp,".JPG"                 ;tmp = CHAR/xxx.JPG

	fileexist %work,$tmp	;ここでファイルの存在をチェック
	gosub *debugout_char
	if %work==0 return	;ファイルが存在しなければ戻る

	;エフェクトの指定がなければ、デフォルトの指定で出力
	mov $tmp2,":a;"
	add $tmp2,$tmp
	if %effect==0 	ld c,$tmp2,CHAR_EFFECT : return	;立ちグラを表示

	;エフェクトの指定があれば、その指定で出力
	;エフェクトの効力は１回のみ
	ld c,$tmp2,%effect : mov %effect,0  : return
           
;-------------------------------------------------------------------
*music	;■音楽再生ルーチン
	if $_music=="" return
	if $old_music==$_music return ;前回と同じなら何も再生しない
	mov $old_music,$_music
	mov $tmp,"BGM/"
	add $tmp,$_music
	add $tmp,".mp3"
	fileexist %work,$tmp	;ここでファイルの存在をチェック
	if %work==0 return	;ファイルが存在しなければ戻る
	bgm $tmp
	return
;-------------------------------------------------------------------
*musicstop	;■音楽停止ルーチン
	stop
	mov $old_music,""
	mov $_music,""
	return
;-------------------------------------------------------------------
*click	;■クリック音再生
	dwave CH_SE,"SE\ZCLICK.WAV"
	return
;-------------------------------------------------------------------
*se_ok	;■OK音再生
	dwave CH_SE,"SE\ZOK.WAV"
	return
;-------------------------------------------------------------------
*se_cancel	;■CANCEL音再生
	dwave CH_SE,"SE\ZCANCEL.WAV"
	return
;-------------------------------------------------------------------
*mes	;■メッセージ表示
;	gettext $tmp
;	for %0=buf to bufend
;		if buf
;	next
;	if $tmp==$mes
	return
;-------------------------------------------------------------------
;画面の構成要素をすべて書き換え（絵のみ）
;前回との差がなければ実行されないので、無条件に呼び出してよい
*out	;■画面書き換え
	gosub	*music
	gosub	*bg
	gosub	*char
	return
;-------------------------------------------------------------------
*cgout	;■イベントＣＧで画面書き換え
	if $_cg=="" return

;真実の眼鏡処理 --- 眼鏡なしだと末尾に"_"を追加
;	numalias g_nomegane	,222	;ONで眼鏡なし。デフォルトOFF
	mov $tmp2,$_cg
	mid $tmp,$tmp2,0,1	;$_cgから1文字目を$tmpに切り出す
	if %g_nomegane==ON && $tmp=="B"  add $_cg,"_" ; 末尾に_を追加

	if $old_cg==$_cg return	;前回と同じなら何も表示しない
	mov $old_cg,$_cg	;イベントＣＧ名をold_cgに保存
	mov $_bg,"": mov $old_bg,""
	mov $_char,"": mov $old_char,""
	mov $tmp,"CG/"		;tmp = CG\
	add $tmp,$_cg		;tmp = CG\xxx
	add $tmp,".BMP"		;tmp = CG\xxx.BMP

	fileexist %work,$tmp	;ここでファイルの存在をチェック
	gosub *debugout_cg
	if %work==0 return	;ファイルが存在しなければ戻る

	;エフェクトの指定がなければ、デフォルトの指定で出力
	if %effect==0 	bg $tmp,CG_EFFECT : return	;イベントＣＧを表示

	;エフェクトの指定があれば、その指定で出力
	;エフェクトの効力は１回のみ
	bg $tmp,%effect : mov %effect,0  : return
	
	return
;-------------------------------------------------------------------
*clear_char	;■立ちキャラ画像のみ消す
	cl a,clear_char
	mov $_char,""		;立ちキャラ文字列クリア
	mov $old_char,""	;保存しているのもクリア
	return
;-------------------------------------------------------------------
*whiteout	;■白でアウト
	bg white,CG_EFFECT
	wait 500
	gosub *clear_cg_var
	return
;-------------------------------------------------------------------
*blackout	;■黒でアウト
	bg black,CG_EFFECT
	wait 500
	gosub *clear_cg_var
	return
;-------------------------------------------------------------------
*redout	;■赤でアウト
	bg #FF0000,CG_EFFECT
	wait 500
	gosub *clear_cg_var
	return
;-------------------------------------------------------------------
*mono_on	;■モノクロ開始
	monocro #AFAFAF
	return
;-------------------------------------------------------------------
*mono_off	;■モノクロ終了
	monocro off
;	print CG_EFFECT
	return
;-------------------------------------------------------------------
*nega_on	;■ネガ表示開始
	nega	1
	return
;-------------------------------------------------------------------
*nega_off	;■ネガ表示終了
	nega	0
;	print CG_EFFECT
	return
;-------------------------------------------------------------------
*guragura	;■画面グラグラ
	quake 10,200
	return
;-------------------------------------------------------------------
*gura	;■画面単発グラグラ
	quake 5,200
	return
;-------------------------------------------------------------------
*anten	;■カーテンスダレ
	bg black,SYSTEM_EFFECT
	wait 500
	mov $_char,""	: mov $old_char,""
	mov $_cg,""	: mov $old_cg,""
	mov $_bg,""	: mov $old_bg,""
	return
;-------------------------------------------------------------------
*anten_system	;■暗転…システム画面用
	bg black,0
	print SYSTEM_EFFECT
	mov $_bg,""
	mov $old_bg,""
	return
;---------------------------------------------------------------------------
*to2keta	;■$tmpに入っている値が１桁なら２桁にする
	mov $tmp2,$tmp
	len %work,$tmp2	
	if %work>=2 return ; ２桁以上なら戻る
	mov $tmp,"0"
	add $tmp,$tmp2
	return
;-------------------------------------------------------------------
*clear_cg_var 	;画像表示用のローカル変数クリア
	mov $_char,"" : mov $old_char,""
	mov $_cg,""   : mov $old_cg,""
	mov $_bg,""   : mov $old_bg,""
	if %debug==ON csp SP_DBG_CHAR : csp SP_DBG_CG : csp SP_DBG_BG 
	return
;-------------------------------------------------------------------
;debugではworkは絶対に破壊しないこと
;-------------------------------------------------------------------
*debugout	;■デバッグ用ファイル名表示
	if %debug==OFF return
	if $debugstr=="" return
	csp SP_DBG_FNAME
	;numalias debugstr	,23
	lsp SP_DBG_FNAME,":s/20,22,0;#FFFFFF$23",10,10
	mov $debugstr,""
	return
;-------------------------------------------------------------------
*debugout_se
	if %debug==OFF return
	if $debugstr=="" return
	if %work==0 add $debugstr,"無"	;ファイルが存在しない
	csp SP_DBG_SE
	lsp SP_DBG_SE,":s/20,22,0;#FFFFFF$23",10,130 ;デバッグ用
	mov $debugstr,""
	return
;-------------------------------------------------------------------
*debugout_vo
	if %debug==OFF return
	if $debugstr=="" return
	if %work==0 add $debugstr,"無"	;ファイルが存在しない
	csp SP_DBG_VOICE
	lsp SP_DBG_VOICE,":s/20,22,0;#FFFFFF$23",10,160
	mov $debugstr,""
	return
;-------------------------------------------------------------------
*debugout_bg
	if %debug==OFF return
	if $debugstr=="" return
	if %work==0 add $debugstr,"無"	;ファイルが存在しない
	csp SP_DBG_BG
	lsp SP_DBG_BG,":s/20,22,0;#FFFFFF$23",10,100
	mov $debugstr,""
	return
;-------------------------------------------------------------------
*debugout_cg
	if %debug==OFF return
	if $debugstr=="" return
	if %work==0 add $debugstr,"無"	;ファイルが存在しない
	csp SP_DBG_CG
	lsp SP_DBG_CG,":s/20,22,0;#FFFFFF$23",10,40
	mov $debugstr,""
	return
;-------------------------------------------------------------------
*debugout_char
	if %debug==OFF return
	if $debugstr=="" return
	if %work==0 add $debugstr,"無"	;ファイルが存在しない
	csp SP_DBG_CHAR
	lsp SP_DBG_CHAR,":s/20,22,0;#FFFFFF$23",10,70
	mov $debugstr,""
	return
;-------------------------------------------------------------------

;7.TXT
;-------------------------------------------------------------------
;	まぼちゃんの部屋
;-------------------------------------------------------------------
*mabo_room	;■まぼちゃんの部屋
	bg "MABO/MABO.jpg",bg_effect	;背景設定
;	lsp  1,":l/4,300,0;A_MABO1.jpg",200,80
	print 1
	lsp 0,":c/2,0,3;MABO\MABO_UPDATE.jpg" ,445,150
	lsp 1,":c/2,0,3;MABO\MABO_STAFF.jpg"  ,445,230
	lsp 2,":c/2,0,3;MABO\MABO_PRODUCT.jpg",445,310
	lsp 3,":c/2,0,3;MABO\MABO_MODORU.jpg" ,445,385
	print 1

	btndef ""
	spbtn	0,1
	spbtn	1,2
	spbtn	2,3
	spbtn	3,4

;	btn  1, 100, 200, 700,  40,   0,   0	;UPDATE;
;	btn  2, 100, 280, 700,  40,   0,  40	;STAFF;
;	btn  3, 100, 360, 700,  40,   0,  80	;SYOHIN;
;	btn  4, 100, 440, 700,  40,   0, 120	;EXITGAME;

*mabo_loop
	btnwait %work
	if %work==MOUSE_RBUTTON gosub *click : csp -1 : goto *title
	if %work==KEY_ESCAPE    gosub *click : csp -1 : goto *title
	if %work==1 gosub *click: csp -1 :goto *update
	if %work==2 gosub *click: csp -1 :goto *staff_room
	if %work==3 gosub *click: csp -1 :goto *syohin_annai
	if %work==4 gosub *click: csp -1 :goto *title
	goto *mabo_loop

;----------------------------------------------------------------------
*update	;■アップデートを実行する
	bg "MABO/UPDATE.jpg",0	;背景設定
	lsp 0,":c/2,0,3;MABO/update_br.jpg", 250,  50
	lsp 1,":c/2,0,3;MABO/update_oni.jpg",550,  50
	lsp 2,":a/2,0,3;MABO/modoru.jpg"    ,360, 550
	print	BG_EFFECT

	btndef ""
	spbtn	0,1
	spbtn	1,2
	spbtn	2,3

*update_loop
	btnwait %work
	if %work==MOUSE_RBUTTON gosub *click :  goto *exit_update
	if %work==KEY_ESCAPE    gosub *click :  goto *exit_update
	if %work==1 gosub *click: goto *brupdate
	if %work==2 gosub *click: goto *kiupdate
	if %work==3 gosub *click: goto *exit_update
	goto *update_loop

*exit_update
	btndef ""	;使ったボタン定義をクリア
	csp 0 : csp 1 : csp 2 : csp 3
	goto *mabo_room	;まぼちゃんの部屋に戻る

*brupdate	;●BLOOD ROYALのアップデート
	gosub *click
	csp 0 : csp 1 : csp 2
	lsp SP_DLG,":a;sys/dlg.jpg",0,0
	lsp SP_DLG_MES,":s/20,18,0;#FFFFFFアップデートしますか？",285,280
	lsp SP_DLG_YES,":a/2,0,3;sys/dlg_yes.jpg",DLG_YES_X,DLG_YES_Y
	lsp SP_DLG_NO, ":a/2,0,3;sys/dlg_no.jpg", DLG_NO_X, DLG_NO_Y
	print 1
	btndef ""
	spbtn SP_DLG_YES,BTN_YES
	spbtn SP_DLG_NO,BTN_NO

*brupdate_loop
	btnwait %work
	if %work = MOUSE_RBUTTON goto *update_cancel
	if %work = KEY_ESCAPE    goto *update_cancel
	if %work = BTN_YES goto *brupdate_execute
	if %work = BTN_NO goto *update_cancel
	goto *brupdate_loop

*update_cancel
	gosub *se_cancel
	csp SP_DLG
	csp SP_DLG_MES
	csp SP_DLG_YES
	csp SP_DLG_NO
	repaint
	goto *update	;アップデートに戻る

*brupdate_execute	;●BRのアップデートを実行
	gosub *se_ok
	shell "UPDATE\\BRFIX101.EXE"
	end
;	csp SP_DLG
;	csp SP_DLG_MES
;	csp SP_DLG_YES
;	csp SP_DLG_NO
;	repaint
;	goto *update

*kiupdate	;●鬼門妖異譚のアップデート
	gosub *click
	csp 0 : csp 1 : csp 2
	lsp SP_DLG,":a;sys/dlg.jpg",0,0
	lsp SP_DLG_MES,":s/20,18,0;#FFFFFFアップデートしますか？",285,280
	lsp SP_DLG_YES,":a/2,0,3;sys/dlg_yes.jpg",DLG_YES_X,DLG_YES_Y
	lsp SP_DLG_NO, ":a/2,0,3;sys/dlg_no.jpg", DLG_NO_X, DLG_NO_Y
	print 1
	btndef ""
	spbtn SP_DLG_YES,BTN_YES
	spbtn SP_DLG_NO,BTN_NO

*kiupdate_loop
	btnwait %work
	if %work = MOUSE_RBUTTON goto *update_cancel
	if %work = KEY_ESCAPE    goto *update_cancel
	if %work = BTN_YES goto *kiupdate_execute
	if %work = BTN_NO goto *update_cancel
	goto *brupdate_loop

*kiupdate_execute	;●鬼門のアップデートを実行
	gosub *se_ok
	shell "UPDATE\\KIMON1003.EXE"
	end

*staff_room	;■スタッフルーム
	csp -1
	mov %is_adv,2

	bg "MABO/STAFFROOM.jpg",0	;背景設定
	lsp 0,":l/2,0,3;MABO/chip_akira.jpg",280,140	;あきら
	lsp 1,":l/2,0,3;MABO/chip_chunku.jpg",420,140	;ちゅんく

	lsp 2,":l/2,0,3;MABO/chip_izumi.jpg",140,280	;泉秀雄
	lsp 3,":l/2,0,3;MABO/chip_haiji.jpg",280,280	;島田灰二
	lsp 4,":l/2,0,3;MABO/chip_kst.jpg",420,280	;KST
	lsp 5,":l/2,0,3;MABO/chip_kuri.jpg",560,280	;KURI

	lsp 6,":l/2,0,3;MABO/chip_shuri.jpg",72,420	;朱理
	lsp 7,":l/2,0,3;MABO/chip_makoto.jpg",210,420	;高木誠
	lsp 8,":l/2,0,3;MABO/chip_aogiri.jpg",350,420	;SATORU
	lsp 9,":l/2,0,3;MABO/chip_nuu.jpg",490,420	;ぬ～	
;	lsp 10,":l/2,0,3;MABO/.jpg",630,420
	lsp 11,":a/2,0,3;MABO/modoru.jpg"    ,360, 550
	print	bg_effect
	btndef ""
	spbtn 0,1
	spbtn 1,2
	spbtn 2,3
	spbtn 3,4
	spbtn 4,5
	spbtn 5,6
	spbtn 6,7
	spbtn 7,8
	spbtn 8,9
	spbtn 9,10
	spbtn 10,11
	spbtn 11,12

*staff_loop
	btnwait %work
	if %work==MOUSE_RBUTTON gosub *click : goto *staff_end
	if %work==KEY_ESCAPE    gosub *click : goto *staff_end
	if %work==1 gosub *click: goto *staff_akira
	if %work==2 gosub *click: goto *staff_chunku

	if %work==3 gosub *click: goto *staff_izumi
	if %work==4 gosub *click: goto *staff_haiji
	if %work==5 gosub *click: goto *staff_kst
	if %work==6 gosub *click: goto *staff_kuri

	if %work==7 gosub *click: goto *staff_shuri
	if %work==8 gosub *click: goto *staff_makoto
	if %work==9 gosub *click: goto *staff_aogiri
	if %work==10 gosub *click: goto *staff_nuu
	if %work==11 gosub *click: goto *staff_wanted	;スタッフ募集で
	if %work==12 gosub *click: goto *staff_end
	goto *staff_loop

*staff_end
	btndef "" 
	csp -1
	mov %is_adv,0
	goto *mabo_room

*staff_akira	;●あきら
	csp -1
	bg "MABO/staff_akira.jpg",BG_EFFECT	;背景を表示
	gosub *set_message_window
	gosub *show_window

	こんにちは、あきらです。
	『月光に濡れる教室で、僕は。』
	お買い上げありがとうございます！\

	今回はいろいろ絵とか塗りとか
	変えてみたんですけど、いかがだった
	でしょうか？\

	しかし…マスターまで後一週間
	なんですが…
	ホントに終わるのかな…？　あう。\
;----------------------------------
*nextAKIRA
	csel
	"■わたくしごと", *AKIRA10,
	"■月光について：ネタバレ", *AKIRA20,
	"■次回作についてとか", *AKIRA30,
	"■バイバイ", *AKIRA40

*AKIRA10
;◆わたくしごと

	毎日この壁紙のうさぎと一緒に
	遊んでます。\

	うっさりもう一歳になりました！
	すっかり慣れて良いウサギです。
	なんとか自宅で爪も切りました。\

	でも、芸はできません。
	もちろん、名前もわかってない
	ですね。\

	でも、私が行くと大喜びで可愛い子
	ちゃんです。\

	ウサギに興味のある方は、
	コンプ○ィークにペットコラム？を
	連載してるので見てみてね！\

	あとは…年末に免許とったので
	車を購入しました！\

	でも最近あまり乗ってません。
	時間がなくて…。\

	マスターアップしたらドライブ
	行こうっと。\
	goto *nextAKIRA	;nextAKIRAへ移動
;----------------------------------
*AKIRA20
;◆月光について～ネタバレ～

	とりあえず、今回の絵はどうだった
	でしょうか？
	自分では頑張ってみたつもりです。\

	今回好きなキャラは…
	まゆ子と矢崎ですニャ。
	あ、あと百合恵先生も。\

	でもみんな攻略できなくて残念
	です～…。とほほ。\

	ルックスだと真実が好きなんですが
	性格が…。\

	今回はヒロイン三人の性格が
	暗くて？ね～。どうも苦手です。\

	あと、育巳が苦手です。
	この人怖いし…。ぶー！\

	それにしても今回登場人物
	多いなあ。\

	個人的には大貫と篤子のカップルが
	萌えかも…？篤子のエッチシーン
	かきたかったな～。\
	goto *nextAKIRA	;nextAKIRAへ移動
;----------------------------------
*AKIRA30
;◆次回作についてとか

	次回作は７月を予定してます。
	病院モノです。タイトルは
	《愛して　ナイチンゲール》です。\

	エロくてコミカル、愛あり
	えっち満載のＳＬＧです。\

	最近ＡＶＧが続いていたので
	そろそろＳＬＧです。今度は珍しく
	複数攻略も可能かも？\

	今回登場した矢崎の双子の兄が
	主人公です。\

	当然矢崎もでてきます。
	そして医者といえば
	やっぱり百合恵先生も…。\

	百合恵先生はややレギュラー化
	しつつありますね。\

	二人の看護婦さんと女医さんの
	三人がメインヒロインです。\

	それと、準ヒロインとして主人公の
	助手の看護婦さんが攻略可能です。\

	あとはサブキャラもろもろですね。
	患者さんとか。\

	もちろん今度は
	まぼちゃんも登場しますよ。\

	今度もまたちょっと絵…というか
	色調とかいろいろ変えてみようかな
	っと思っています。\

	お楽しみに～！！\
	goto *nextAKIRA	;nextAKIRAへ移動
;----------------------------------
*AKIRA40
;◆バイバイ

	それではまた
	次回作でお会いしましょう！
	まんぼ！\

	gosub *hide_window
	goto *staff_room

*staff_chunku	;●ちゅんく
	csp -1
	bg "MABO/staff_chunku.jpg",BG_EFFECT	;背景を表示
	gosub *set_message_window
	gosub *show_window

ども、ちゅんくです。「月光…」
お買いあげいただき誠にありがとうございます。\

読みたいメッセージを選んでください。
相変わらず今回も長めで、すいません。\

*staff_chunku_sel
csel
"今回のこと",*staff_chunku_game,
"趣味のこと",*staff_chunku_hobby,
"次のゲームのこと",*staff_chunku_next,
"おしまい",*staff_chunku_exit

*staff_chunku_game
今回のテーマは「青春」でした。\

…………………………………………………。\

うっっわーーーーーーーーーーーー！！！
恥ずかしい！恥ずかしい！恥ずかしい～～！！\

おかげで筆が進まない（笑）
いや、ホント激スランプでしたわ。\

主人公が「僕」ってのも初めてで、こういう
性格のやつも初めてで、手間取る手間取る。\

正月、だれもいない部屋でのたうち回ったり
してな。毎年してるような…これ…。涙…。\

あ、うちは一応土日はお休みですー。国民の
祝日も休みですー。わたしがトロイだけなので
ひとりで出てきてるだけですー。\

今回はシナリオに勧誘してきた（←マジで）
ぬ～さんが活躍してくれましたー。ありがとー！\

なもんで、わたしの担当は、明海以外ッス。
今回暗い話ですまんです～。いや、もっと
暗くしたかったんだけどさぁ（笑）\

あきらが言うには、今回はアンバランスっぽい
そうです。今回の主人公は、はるぼんに比べれば
ぜんぜんイイヤツなんですけど…。真面目だし。\

goto *staff_chunku_sel

*staff_chunku_hobby
クロボン、Ｓロボ参戦万歳～ッ！！！
あとはアニメ化！アニメでみたいッ！！
ドゥガチ！動くドゥガチを！＜それもどうかと。\

もっとクロボン、メジャーになってほしいです
よねー。Ｘ１大好き。トビアかっこいいし！\

あ、でも最近コミックスが手に入れやすく
なってうれしいですー。\

えと今回は岐阜県のＨ様より、
「漢のＭＡ」についてたずねられました～。
お手紙ありがとー！！\

Ｈ様はノイエとかヴァルヴァロと！
うーむ、８３スキーですね。Ｈ様は。\

でも８３のＭＡって、綺麗子ちゃんのような…。
ノイエとかラインがきれいなんだけど～。\

わたしはＭＡは「ゴツゴツ」して「デカイ！」
のが好きなんですヨ。やっぱデカさで！
８３ＭＡはその点デンドロに負けてるしなぁ。\

エ○メスもでっかいですよねー。つかまってる
シャアザクが人形のようでカワイイの。\

一番好きなのはアプサラスちゃんなんですが。
あのザク頭が。ちょこんとして、たまらぬ～！
でも漢のＭＡじゃないよな…。うーんうーん。\

「ディビニ○ド」は爺のＭＡだし。
あ、あれだ！　これですよ。間違いない！\

漢のＭＡといったら「ビグ◆ム」！！
これ！　これで決定！！\

種もみてますよ。サイが好きなんです…ええ…。
キンゲは泣いたり笑ったり踊ったりしながら
楽しんでみてます。\

いけない、いけない。ガン話で終わるところ
だった。んじゃ音楽の話でも。\

たいてい音楽を聴きながら仕事してます。
うちの会社、割とみんなそうしてますね。
あきらなんかＤＶＤ聞きながらやってるし。\

うちでは、シナリオもＣＧも原画も全部おなじ
部屋で一緒に作業してます。\

喫茶店とかで書くとかいうひといるけど、
わたしはダメです。
人の目がないとさぼっちゃう（笑）\

エロシーンも他人がいるところで書きますよ！
自分の目の前で声優さんに読まれることに
くらべりゃ、そんなの軽い軽い。\

最初録音のとき、死ぬほど恥ずかしかった…。
今はさすがに慣れましたが。\

あーでも、うちの会社ではシナリオを音読して
くれるという羞恥プレイをかましてくれます。\

もー、いつまでも「魔王を燃やせ～！」とか
言ってないでよ。あなたたち！　どうしてそう、
妙なところばかり。キャプテンとか…。ひどい！\

で、聞いてる曲は前は声のないもの、インスト
とかクラシック、せいぜいがところ意味のわか
んないように外国の曲とかだったんですが、\

最近は邦楽も聞くようになりました。
オススメあったら教えてもらえると
うれしいなー。葉書とかでよろしくー。\

今回のヘビーローテーションは
キリンジ、天野月子、くるり、中村一義。
なんか傾向が…（笑）　つっこちゃんは別だね。\

あと別枠でＳｙｒｕｐ １６ｇ。聞いてると
仕事になんねぇ（笑）。これ褒め言葉ね。もち。
最高。万人には勧めないけど。最低で最高。\

Ｓｙｒｕｐ１６ｇは、ライヴマジで行きたくて
たまんないッス。生音聞いてみたい！激しく！
どうしようもなく好きだ。好きだ。たまんない。\

あと気分が超絶どマイナーなときにはいつも
ニルヴァーナ…。私の心の定番…。一生聞く。
ベスト出ましたねぇ。聴いてたら泣いた…。\

カートの詩って嘘がないと思いませんか？　
なんかもう…居なくなっちゃったなって。
カートも、あのときの私も。泣けた…。\

今回やけにセンチメンタルだな…。
どうしたんだ、本当に。
ベストにＢＲＥＥＤ入ってないのが残念でした。\

あ、若い子は知らんのかしら。Ｎｉｒｖａｎａ。
今だとＲＡＤＩＯ　ＨＥＡＤなんかなぁ。でも
いっぺん聞いてみてくださいなー。\

それから、冬コミで御本をプレゼントして
くれた方ありがとうございました。むちゃ
うれしかったです。\

相変わらずアルがかわいい今日この頃です。
嫁にしたい…。衣食住の金かからんし…。
（←おい）\

goto *staff_chunku_sel

*staff_chunku_next
次の作品はタイトルは決まっております。
「愛して★ナイチンゲール」です。★は、
ほんとは「はぁと」です。\

タイトルで解ると思いますが、ナースさんもの
ですー。エロコメディでＧＯ。\

女子だけの病院に、女装した主人公（医師）が
潜入しては巻き起こす騒ぎの数々！っていうか、
そんなノリで。\

Ｄａｒｌｉｎｇみたいな感じのアホっぽさ
全開で行くかとおもわれます。シナリオは
私とぬ～さんです。\

エロはエロエロでがんばるので～。
よろしくです～。\

あ、そうそうＤａｒｌｉｎｇのアニメも
チェックしてくださいねー。絵かわいくて
お話もおもしろいです。\

レンタルもありますよん。セルには特典のミニ
画集がついてます～。これも、けっこういい
出来かと。\

ＢＲ３は冬に向けてコツコツと…進んで…
いないんですが（笑）。タイトルがボツに
なったんで、どうしようか考え中です。\

次回もがんばって書きますので、
よろしくお願いします。\

goto *staff_chunku_sel

*staff_chunku_exit
また、次のちぇりーそふとのゲームで
お会いできればうれしいです！　では！\

gosub *hide_window
goto *staff_room

*staff_izumi	;●イズミ
	csp -1
	bg "MABO/staff_izumi.jpg",BG_EFFECT	;背景を表示
	gosub *set_message_window
	gosub *show_window

こんにちは。
ＣＧ担当の泉秀雄です。\

『月光に濡れる教室で、僕は。』
お買い上げ下さいまして
誠にありがとうございます。\

今回はＣＧの雰囲気もすこし
変わった思うのですが、
いかがでしょうか？\

新しいシナリオライターさんも加わっての
今年第一作。
楽しんでいただけると嬉しいです。\

しかし、シナリオ担当人員が増えても
ちゅんくさんは今回も
ぎりぎり崖っぷちをゆくのでした…。\

最近では、無意識のうちに
瀬戸際に立つスリルを
求めているのではないかという説も…。\

でも、ギリギリは
健康にもよくないですよね…。\

次はカレンダーどおりとはいかなくとも
週末くらいは休めるスケジュールに
なるといいですね。\

シナリオ二人でガン○ム話でもしながら
ガンガン執筆して下さい～。
（シナリオは人が増えてもガンオタ率１００％）\

一方、ＣＧも
余裕とは程遠い感じでして…\

シナリオの事を言えた義理では
なかったり…。\

しかも、あと一週間でマスターなのに
まだ立ちグラとか塗ってるし。\

ち、違うんです！
決してＣＧの怠慢ではなくて…
だってとっくに出来てるつもりだったんです！\

そう、昨日までは…。
（↑主人公の台詞？）\

この期に及んで一人、作り忘れが…。\

シナリオ担当にもＣＧ担当にも
原画担当にも忘れ去られた男、津○。\

彼の名前が入るはずだった
立ちグラリストの空欄は
いつの間にかマンボウが占拠しておりました。\

ともかく、次回こそは！
もっと全てに余裕を！\

………………。\

皆さんは、幼少の頃、
夏休みにこんな計画を
立てませんでしたか？\

７月に宿題を全部終わらせて、
８月は１ヶ月、ずっと遊ぼう！\

………………今年こそは！\

これを実行できた人は立派です。
…もちろん自分は
立派な人にはなれませんでした。\

宿題と仕事では事情が違うとはいえ、
（もちろん仕事は、早い時期だって毎日
全員ちゃんと働いてますよー）\

でも余裕のスケジュールなんて
そんなものかなあ…とか。\

夏休みの宿題は、同僚上司に聞いても、
８月どころか９月まで
やってる人ばっかりでした。\

若干一名、ちゃんと宿題を終わらせてる
偉人もいましたが。
（尊敬に値します、本気で）\

さて次回作ですが、他の人も書いていますが
看護婦ものの予定です。
制服ものは初めてなので楽しみです。\

あきらさんの中では、キャラデザもかなり
出来てそうな感じ…？\

次回作もどうぞよろしくお願いいたしますね。\

それでは。
またお目にかかれれば嬉しいです。\

gosub *hide_window
goto *staff_room

