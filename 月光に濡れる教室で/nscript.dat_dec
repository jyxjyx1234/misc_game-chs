	mov $_voice,"XB0926"
	mov $debugstr,"音声：XB0926"
	gosub *vo

	【矢崎】
	だって、そうじゃないか。もしかしたら
	小林先輩は殺されたかもしれないんだよ？\
	dwavestop CH_VOICE	;XB0926

	【$g_hero】
	…………………。\

	その言葉に、ずんと
