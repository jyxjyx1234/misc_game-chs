	mov $debugstr,"音声：YC7349"
	gosub *vo

	【丹羽】
	あっ、先輩じゃ～ん！？\
	dwavestop CH_VOICE	;YC7349

	【$g_hero】
	うえ。…ヤな奴に会った。\

	僕はくるりと後ろをむいた。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TVE"
	mov $debugstr,"立ち：TVE "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"YC7350"
	mov $debugstr,"音声：YC7350"
	gosub *vo

	【丹羽】
	おっと。\
	dwavestop CH_VOICE	;YC7350

	【$g_hero】
	………………。\

	去ろうとしたところを回り込まれた。
	妙に素早いよな…。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TVA"
	mov $debugstr,"立ち：TVA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"YC7351"
	mov $debugstr,"音声：YC7351"
	gosub *vo

	【丹羽】
	せっかく来たのに、早速のお帰りじゃ
	もったいなさすぎるぜ？\
	dwavestop CH_VOICE	;YC7351

	この丹羽という人間は、苦手だ。\

	気が良さそうに見えなくもないけど…
	とにかく危ない。そんな感じがする。\

	小夜子がいるときは、ただの愉快なヤツなのに。
	なんだろう…おかしな感じだ。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TVD"
	mov $debugstr,"立ち：TVD "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"YC7352"
	mov $debugstr,"音声：YC7352"
	gosub *vo

	【丹羽】
	今朝の噂聞いたぜ？
	ちょっとすごいよな。ドラマチックでさ。\
	dwavestop CH_VOICE	;YC7352
	;--立ちキャラ;----------------------------------
	mov $_char,"TVA"
	mov $debugstr,"立ち：TVA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
