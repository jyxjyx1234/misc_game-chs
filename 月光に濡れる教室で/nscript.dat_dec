	mov $_voice,"YC3819"
	mov $debugstr,"音声：YC3819"
	gosub *vo

	【育巳】
	そいじゃオレは、先に行ってるから。
	間に合うように来いよ！！\
	dwavestop CH_VOICE	;YC3819
	gosub *clear_char

	【$g_hero】
	お、おい！間に合うようにって…
	同じ教室なのに…。\
	;--立ちキャラ;----------------------------------
