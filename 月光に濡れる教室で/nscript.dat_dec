	困ったことだよ、根津君！！\
	dwavestop CH_VOICE	;YD0900
	;--立ちキャラ;----------------------------------
	mov $_char,"TQD"
	mov $debugstr,"立ち：TQD "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
