*B29	; ■ファイル開始のラベル
	mov $debugstr,"■B29 " : gosub *debugout
;■■■「月光に濡れる教室で、僕は。」台本：●朝：登校：B29
;━━━━━━━━━━━━━━
;●朝：登校
	gosub *blackout

	;--BGM;----------------------------------
	mov $_music,"05": gosub *out
;BGM:さりげない日常
	;--背景;----------------------------------
	mov $_bg,"BG014A"
	mov $debugstr,"ＢＧ：BG014A"
	gosub *out	;画面に出力
;ＢＧ：BG014A;校門

	昨日と同じ時間。昨日と同じ場所。
	僕はあたりをきょろきょろ見回した。\

	【$g_hero】
	…いないな…。\

	真実の姿は見あたらない。
	僕はふうっとため息をついて、肩を落とした。\

	【$g_hero】
	別に待ち合わせをしたわけでもないもんな。\

	それなのに、さびしいと感じる方が
	おかしいよな。…いや…なんでだろ。\

	期待をしていたから？　どうして？
	どうして、僕は真実に会いたいんだろう。\

	それはきっと…あんなことしたから
	だから気になってるわけであって…。\

	それと…きっと…。\

	【$g_hero】
	（昨日のことが、
	　夢じゃないかって思ってるんだ、僕は）\

	どっちのことだろう。
	セックスをしたことだろうか、
	それとも月光の下で話をしたことだろうか。\

	【$g_hero】
	（夢だったら…イヤなのかな）\

	そうなのかもしれない。うん…たぶん
	それをはっきりさせたいんだなと思う。\

	真実の顔をみたら、落ち着くのに。\

	【$g_hero】
	ちぇっ…。
	教室、行くかな。\

	そうやって、歩き始めた途端、
	背後から声がした。\

	;--BGM;----------------------------------
	mov $_music,"12": gosub *out
;BGM:桜井　真実
	;--立ちキャラ;----------------------------------
	mov $_char,"TBA"
	mov $debugstr,"立ち：TBA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"BB2900"
	mov $debugstr,"音声：BB2900"
	gosub *vo

	【真実】
	おはよう。\
	dwavestop CH_VOICE	;BB2900

	【$g_hero】
	うわっ！\

	真実は、僕の態度に
	困ったように眉をひそめた。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TBC"
	mov $debugstr,"立ち：TBC "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"BB2901"
	mov $debugstr,"音声：BB2901"
	gosub *vo

	【真実】
	あ…。め、迷惑だった？\
	dwavestop CH_VOICE	;BB2901

	僕はぶんぶんと首を振った。\

	【$g_hero】
	ち、ちがう！ちがう！　ちがうって！\

	首から上が熱いのはなんでだろう。
	顔がほてっているような気がする。\

	【$g_hero】
	その…よければ、教室まで一緒に行こう。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TBB"
	mov $debugstr,"立ち：TBB "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"BB2902"
	mov $debugstr,"音声：BB2902"
	gosub *vo

	【真実】
	…うん！\
	dwavestop CH_VOICE	;BB2902
	gosub *blackout
	return
	;----------------------------------
;---B29  END -----
