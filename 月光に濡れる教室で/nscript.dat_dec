	mov $debugstr,"立ち：TLC "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"YE2301"
	mov $debugstr,"音声：YE2301"
	gosub *vo

	【$g_heroの兄】
	つれないなぁ。
	せっかく愛しのお兄様が来てあげたのに。\
	dwavestop CH_VOICE	;YE2301

	【$g_hero】
	来なくていいよ！\
	;--立ちキャラ;----------------------------------
	mov $_char,"TLD"
	mov $debugstr,"立ち：TLD "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"YE2302"
	mov $debugstr,"音声：YE2302"
	gosub *vo

	【$g_heroの兄】
	あ、あれ。なにコレ？\
	dwavestop CH_VOICE	;YE2302

	【$g_hero】
	勝手に人の携帯見ないでくれっ！！\
	;--立ちキャラ;----------------------------------
	mov $_char,"TLB"
	mov $debugstr,"立ち：TLB "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"YE2303"
	mov $debugstr,"音声：YE2303"
	gosub *vo

	【$g_heroの兄】
	うわ！この写真。懐かしい～！！
	教育実習のときの菜摘先生だ～。\
	dwavestop CH_VOICE	;YE2303

	【$g_hero】
	あ、やっぱり覚えあるんだ。\
