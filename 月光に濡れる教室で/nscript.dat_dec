	そうそう、あれは自殺だからね！
	自殺なんだよ、自殺！！！\
	dwavestop CH_VOICE	;YD0902
	;--立ちキャラ;----------------------------------
	mov $_char,"TQA"
	mov $debugstr,"立ち：TQA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"YD0903"
	mov $debugstr,"音声：YD0903"
	gosub *vo

	【根津先生】
	そうですよね！　警察の方も、第一発見者が
	かなり、あやしいのではないかと…。\
	dwavestop CH_VOICE	;YD0903

	【$g_hero】
	（な、何だって！？）\

	僕の背中が、後ろにいた小夜子にぎゅっと
	ひっぱられる。\

	振り向くと小夜子が真っ青な顔で
	僕を見つめていた。\
