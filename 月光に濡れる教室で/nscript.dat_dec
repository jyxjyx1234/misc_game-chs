	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"YMP0669"
	mov $debugstr,"音声：YMP0669 "
	gosub *vo

	【イズミ】
	いいや、顔だね。\
	dwavestop CH_VOICE	;YMP0669 

	【$g_hero】
	…………………………。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TND"
	mov $debugstr,"立ち：TND "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
