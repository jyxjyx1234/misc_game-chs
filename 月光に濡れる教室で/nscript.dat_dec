	mov $debugstr,"立ち：TBF "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"BB1900"
	mov $debugstr,"音声：BB1900"
	gosub *vo

	【真実】
	あ…$g_fname君…。\
	dwavestop CH_VOICE	;BB1900

	【$g_hero】
	真実。\

	外からの明かりだけが真実を照らしている。\

	どこかで、甘い花のような香りがした。
	まるで百合の花のような、濃厚な香り。\

	真実が何かつけてるのか？
	いや、ちがう。前にも、これは。\

	くらりとする。酩酊感が自分を襲う。
	月の光で、僕は狂う。\
	gosub *blackout

	return	;----------------------------------
;---B19  END -----
