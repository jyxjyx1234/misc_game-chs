*B42	; ■ファイル開始のラベル
	mov $debugstr,"■B42 " : gosub *debugout
;■■■「月光に濡れる教室で、僕は。」台本：●主人公家を出る：B42
;━━━━━━━━━━━━━━
;●主人公家を出る

	;--BGM;----------------------------------
	mov $_music,"07": gosub *out
	;--背景;----------------------------------
	mov $_bg,"BG001B"
	mov $debugstr,"ＢＧ：BG001B"
	gosub *out	;画面に出力
;BGM:恋

	【$g_hero】
	そろそろ…時間かな…。\

	僕は身支度を整えた。寒いのでマフラーもまく。
	家の人間に気づかれないように、そっと外に出る。\
	;--背景;----------------------------------
	mov $_bg,"BG002B"
	mov $debugstr,"ＢＧ：BG002B"
	gosub *out	;画面に出力
;ＢＧ：BG002B;主人公の家
	;-効果音;----------------------------------
	mov $_se,"ZKAZE"
	mov $debugstr,"ＳＥ：ZKAZE "
	gosub *se

	【$g_hero】
	うわ、さむっ…！\

	吐く息は白かった。歩き始めると寒さで耳が痛い。
	ポケットに手を突っ込んで早足で歩く。\

	【$g_hero】
	真実…来るかな…。\

	来てるだろうとは思う。予感はあった。
	期待…かもしれないけど。\

	真実が、イヤだって言わないのはなんでだろう。
	来なければ、それで終わりなのに。\

	【$g_hero】
	一緒だとうれしいって言ってたな。\

	妙な気持ちになる。
	なんで、うれしいんだろ。\

	僕は、真実と一緒でうれしいのかな。
	あんなことして…それでも、うれしいのかな。\

	…そうかもしれない。
	なんでだろ。\

	【$g_hero】
	そもそも「天使」の目的が僕なのか
	真実なのか…。\

	たぶん…でも、僕なんだろうな。
	真実は…巻き込まれただけでさ。\

	なのに真実が来てなかったら、
	僕は…イヤなんだろうな。\

	信号待ち。僕はふーっと息を吐きながら
	顔を上に向けた。空の月が見える。\

	【$g_hero】
	つくづく自分勝手だな…。僕って。\
	gosub *blackout

	return	;----------------------------------
;---B42  END -----
