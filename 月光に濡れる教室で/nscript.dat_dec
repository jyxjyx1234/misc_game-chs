*CTS_B	; ■ＣＴＳ
	gosub *cts	;CTS呼び出し
	if %cts_pos==nCTS_SEIKI && %cts_play==nCTS_IJIMERU gosub *BHIS: goto *CTS_Bend
	if %cts_pos==nCTS_OSIRI && %cts_play==nCTS_IJIMERU gosub *BHIO: goto *CTS_Bend
	if %cts_pos==nCTS_GANGU && %cts_play==nCTS_IJIMERU gosub *BHIG: goto *CTS_Bend
	if %cts_pos==nCTS_SEIKI && %cts_play==nCTS_HOUSHI gosub *BHHS: goto *CTS_Bend
	if %cts_pos==nCTS_OSIRI && %cts_play==nCTS_HOUSHI gosub *BHHO: goto *CTS_Bend
	if %cts_pos==nCTS_GANGU && %cts_play==nCTS_HOUSHI gosub *BHHG: goto *CTS_Bend
	if %cts_pos==nCTS_SEIKI && %cts_play==nCTS_LOVE gosub *BHLS: goto *CTS_Bend
	if %cts_pos==nCTS_OSIRI && %cts_play==nCTS_LOVE gosub *BHLO: goto *CTS_Bend
	if %cts_pos==nCTS_GANGU && %cts_play==nCTS_LOVE gosub *BHLG: goto *CTS_Bend
*CTS_Bend	;マップ終了
	return
