	gosub *out	;画面に出力
;ＢＧ：BG025A;屋上

	【$g_hero】
	ここなら誰も来ないだろう……。\

	普通あんな事件があったら、鍵とかかけそうな
	ものなのに。\

	おかげで、助かったけど。
	でも、杜撰な管理だよな…うちのガッコ。\

	【$g_hero】
	…………何て書いてある？\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCC"
	mov $debugstr,"立ち：TCC "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC4402"
	mov $debugstr,"音声：CC4402"
	gosub *vo

	【明海】
	……昨日と同じよ。\
	dwavestop CH_VOICE	;CC4402

	僕は、携帯メールをのぞきこんだ。\

	件名は「$g_fname　$g_heroに」。
	昨日と同じだ。\

	「皆月　明海を、今日も犯せ
	　犯さなければ、今までのネガを警察に送る」\

	「犯す手順は　お前が決めて
	　このメールに返信すること」\

	…内容も、ほとんど同じだった。
	僕は、隣の先輩をうかがった。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCE"
	mov $debugstr,"立ち：TCE "
	gosub	*out	;画面に出力
;【明海】［怒］

	先輩は、しっかりとうなずいた。
	毅然とした目をしてた。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCE"
	mov $debugstr,"立ち：TCE "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
