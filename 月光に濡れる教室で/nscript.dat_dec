*B16	; ■ファイル開始のラベル
	mov $debugstr,"■B16 " : gosub *debugout
;■■■「月光に濡れる教室で、僕は。」台本：●調教選択：B16
;━━━━━━━━━━━━━━
;●調教選択
;画面表示して、ここでプレイ決定。

	;--BGM;----------------------------------
	mov $_music,"09": gosub *out
;BGM:迷
	;--背景;----------------------------------
	mov $_bg,"BG009G"
	mov $debugstr,"ＢＧ：BG009G"
	gosub *out	;画面に出力
;２年教室

	真実の目の前で、真実を犯す話を書くのは
	とても背徳的な感覚を僕に与えた。\

	…いいのかな僕らは。最初から
	こんなヤバイ感じを覚えてさ。\

	まっとうなセックスができなくなったら
	どうするんだろうと、ぼんやり考えた。\

	露出とか、調教とか、ＳＭとか、
	そういうのってフィクションだと思ってたけど\

	ちょっとしたきっかけが元で、始まっちゃう
	のかも知れないな。そういうのってさ。\

	書き上げた僕の短い話を
	真実は読んで頬を染めた。\

	【$g_hero】
	なんだよ。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TBF"
	mov $debugstr,"立ち：TBF "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"BB1600"
	mov $debugstr,"音声：BB1600"
	gosub *vo

	【真実】
	$g_fname君って、すごいなって。\
	dwavestop CH_VOICE	;BB1600

	【$g_hero】
	どうしてさ。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TBG"
	mov $debugstr,"立ち：TBG "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"BB1601"
	mov $debugstr,"音声：BB1601"
	gosub *vo

	【真実】
	わたし、こんなこと思いつかないもの。\
	dwavestop CH_VOICE	;BB1601

	【$g_hero】
	…ごめん…スケベで。
	どうせ、僕はえっちだよ。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TBF"
	mov $debugstr,"立ち：TBF "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"BB1602"
	mov $debugstr,"音声：BB1602"
	gosub *vo

	【真実】
	そ、そうじゃなくて、言葉に…できないもん。
	不思議だなって、思って。\
	dwavestop CH_VOICE	;BB1602

	【$g_hero】
	そうかな。別に日本語だもん
	誰でも書けると思うけど。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TBF"
	mov $debugstr,"立ち：TBF "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"BB1603"
	mov $debugstr,"音声：BB1603"
	gosub *vo

	【真実】
	ちがうよ。
	すくなくとも、わたしにはムリだよ。\
	dwavestop CH_VOICE	;BB1603

	【$g_hero】
	…褒められてるのかな、それ？\
	;--立ちキャラ;----------------------------------
	mov $_char,"TBG"
	mov $debugstr,"立ち：TBG "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"BB1604"
	mov $debugstr,"音声：BB1604"
	gosub *vo

	【真実】
	褒めてるよ。\
	dwavestop CH_VOICE	;BB1604

	【$g_hero】
	ありがとうって言えばいいの？\
	;--立ちキャラ;----------------------------------
	mov $_char,"TBF"
	mov $debugstr,"立ち：TBF "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"BB1605"
	mov $debugstr,"音声：BB1605"
	gosub *vo

	【真実】
	褒めてるんだから、素直に受け取ってよ。\
	dwavestop CH_VOICE	;BB1605

	【$g_hero】
	う～～～。わかったよ～。\

	return	;----------------------------------
;---B16  END -----
