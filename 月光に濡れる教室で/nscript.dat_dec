	…でも、もう少しだから頑張りたいの。\
	dwavestop CH_VOICE	;CC6406

	【$g_hero】
	じゃあ…無理はしないように……。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCB"
	mov $debugstr,"立ち：TCB "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC6407"
	mov $debugstr,"音声：CC6407"
