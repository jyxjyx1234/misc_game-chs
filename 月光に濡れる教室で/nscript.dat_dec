	mov $debugstr,"音声：YMP1232 "
	gosub *vo

	【購買のおじさん】
	「春一番、紺のサージのスカートひらり」
	どうですかね。\
	dwavestop CH_VOICE	;YMP1232 

	【$g_hero】
	どうって…俳句が趣味だったんですか？\
	;--立ちキャラ;----------------------------------
	mov $_char,"TME"
	mov $debugstr,"立ち：TME "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"YMP1233"
	mov $debugstr,"音声：YMP1233 "
	gosub *vo

	【購買のおじさん】
	いえ、別に。ふと、新俳句大賞にでも出して
	みようかと思っただけで。\
	dwavestop CH_VOICE	;YMP1233 

	【$g_hero】
	ああ、あのお茶の。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TMB"
	mov $debugstr,"立ち：TMB "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"YMP1234"
	mov $debugstr,"音声：YMP1234 "
	gosub *vo

	【購買のおじさん】
	インターネットでも応募できるんですよ。\
	dwavestop CH_VOICE	;YMP1234 

	【$g_hero】
	それは知らなかったなぁ…。\
	gosub *blackout

	;--BGM;----------------------------------
	mov $_music,"05": gosub *out

	return	;----------------------------------
