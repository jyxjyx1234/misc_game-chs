	背面の板は、思ったよりも簡単に
	はずれてしまった。\

	僕は、箱の中をのぞき込んだ。
	箱の中身には……ちいさな鉢植えが
	入っていた。\
	gosub *blackout
	;--背景;----------------------------------
	mov $_bg,"RAN"
	mov $debugstr,"ＢＧ：RAN "
	mov %effect,CG_EFFECT	;エフェクトを指定
	gosub *out	;画面に出力

	【$g_hero】
	…………………………。\

	【$g_hero】
	………………まさか…本当に
	あるなんて……。\
	;-音声;----------------------------------
	mov $_voice,"CC4109"
	mov $debugstr,"音声：CC4109"
	gosub *vo

	【明海】
	温室の花と…同じね…。\
	dwavestop CH_VOICE	;CC4109

	【$g_hero】
	うん……でも……匂いがしないよ。\
	;-音声;----------------------------------
	mov $_voice,"CC4110"
	mov $debugstr,"音声：CC4110"
	gosub *vo

	【明海】
	夜になると香る花かもしれないわ。
	月下美人とか…そういう花があるの。\
	dwavestop CH_VOICE	;CC4110

	【$g_hero】
	夜になると香る花か……。\
	;-音声;----------------------------------
	mov $_voice,"CC4111"
	mov $debugstr,"音声：CC4111"
	gosub *vo

	【明海】
	綺麗な花なのに…怖いわね……。\
	dwavestop CH_VOICE	;CC4111

	【$g_hero】
	…………………うん。\

	綺麗か…確かに綺麗だけど
	僕は好きじゃないな。\

	妙に赤くて、妙に艶めいていて。\

	そして…夜になるとヒトを狂わす花なんだ。
	情欲を、呼び覚ます花なんだ。\

	きっと誰の心にもある…抗えないような…
	嗜虐とか被虐とか…そういう心までも。\

	蠱惑の花。
	僕たちを…知らない夜に誘う花。\
	gosub *blackout
	;--背景;----------------------------------
	mov $_bg,"BG020G"
	mov $debugstr,"ＢＧ：BG020G"
	gosub *out	;画面に出力

	【$g_hero】
	………どうしよう、これ。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCE"
	mov $debugstr,"立ち：TCE "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC4112"
	mov $debugstr,"音声：CC4112"
	gosub *vo

	【明海】
	そうね…見つかったとばれるのは
	よくない気がするの。\
	dwavestop CH_VOICE	;CC4112

	【$g_hero】
	うん…そうだね。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCA"
	mov $debugstr,"立ち：TCA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC4113"
	mov $debugstr,"音声：CC4113"
	gosub *vo

	【明海】
	だから…そうだわ。
	裏面にアルミホイルとか張っておきましょう。\
	dwavestop CH_VOICE	;CC4113

	【$g_hero】
	そうか！！
	目張りしておけば、匂いも漏れないよな。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCC"
	mov $debugstr,"立ち：TCC "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC4114"
	mov $debugstr,"音声：CC4114"
	gosub *vo

	【明海】
	これとよく似た花と、すり替えておくのが
	一番いいとは思うんだけど…。\
	dwavestop CH_VOICE	;CC4114

	【$g_hero】
	うん…でもすぐには用意できないし。
	出来ることからやっておこうよ。\

	【$g_hero】
	……………。
	今日も来るのかな、あのメール。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCE"
	mov $debugstr,"立ち：TCE "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC4115"
	mov $debugstr,"音声：CC4115"
	gosub *vo

	【明海】
	メールが来なくても…私はこの教室に来るわ。
	「天使」に会えるかもしれないもの。\
	dwavestop CH_VOICE	;CC4115

	【$g_hero】
	………なら、僕も来るよ。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCC"
	mov $debugstr,"立ち：TCC "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC4116"
	mov $debugstr,"音声：CC4116"
	gosub *vo

	【明海】
	気持ちは嬉しいけど…でも…。
	キミがつきあう事はないわ。\
	dwavestop CH_VOICE	;CC4116

	【$g_hero】
	そんな風に言わないでよ…力になんて
	なれないかもしれないけどさ…。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCC"
	mov $debugstr,"立ち：TCC "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC4117"
	mov $debugstr,"音声：CC4117"
	gosub *vo

	【明海】
	キミがいてくれるのは、うれしいの…でも…
	私のことでキミに迷惑をかけたくないのよ…。\
	dwavestop CH_VOICE	;CC4117

	【$g_hero】
	迷惑じゃないよ。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCD"
	mov $debugstr,"立ち：TCD "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC4118"
	mov $debugstr,"音声：CC4118"
	gosub *vo

	【明海】
	え…？\
	dwavestop CH_VOICE	;CC4118

	僕は、先輩の目を見つめた。\

	【$g_hero】
	迷惑じゃない…だから。
	僕も教室に来るよ…「天使」を捕まえるんだ。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCG"
	mov $debugstr,"立ち：TCG "
	gosub	*out	;画面に出力
;【明海】［ポ２］

	先輩が目を伏せた。
	長い睫毛がかすかに震えていた。\

	僕は、すぐ側にいる先輩を抱きしめたかった。
	けれど、昨日の夜のように動けなかった。\

	…どうしてだろう。僕は、ためらってしまって、
	うまく動くことができない。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCF"
	mov $debugstr,"立ち：TCF "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC4119"
	mov $debugstr,"音声：CC4119"
	gosub *vo

	【明海】
	じゃあ…日が落ちる前にここに来ましょ？\
	dwavestop CH_VOICE	;CC4119

	【$g_hero】
	う、うん…そうだね。\

	【$g_hero】
	夜になる前だったら、花に惑わされることも
	ないだろうし。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCA"
	mov $debugstr,"立ち：TCA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC4120"
	mov $debugstr,"音声：CC4120"
	gosub *vo

	【明海】
	ええ。
	なら……そろそろ、帰りましょ？\
	dwavestop CH_VOICE	;CC4120

	【$g_hero】
	あ？う、うん。
	スピーカーを元に戻さなくちゃな…。\

	僕は、ぎこちなく立ちあがった。
	先輩と僕は、スピーカーを元の位置に戻す。\

	それから僕たちは、空き教室を出た。\
	gosub *blackout

	return	;----------------------------------
;---C41  END -----
