	mov $_voice,"DOP4508"
	mov $debugstr,"音声：DOP4508 "
	gosub *vo

	【小夜子】
	はい！！\
	dwavestop CH_VOICE	;DOP4508 
	gosub *clear_char

	小夜子がぱたぱたとピアノの前に駆けていく。\

	小夜子のピアノは、目立つタイプじゃないけど
	すごく歌いやすい。
	伴奏向きのピアノなんだろうな。\

	小夜子は派手で目立つ外見をしてるけど、
	こういうサポート向きの、細やかな部分がある。\
