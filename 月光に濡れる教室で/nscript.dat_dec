	mov $debugstr,"音声：YB10401 "
	gosub *vo

	【$g_heroの兄】
	あ、お前の友だちの方さ、腕利きの弁護士さん
	つけてもらえることになったよ。\
	dwavestop CH_VOICE	;YB10401 

	【$g_hero】
	え？　ほんと？\

	兄は、自慢げにわらった。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TLB"
	mov $debugstr,"立ち：TLB "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"YB10402"
	mov $debugstr,"音声：YB10402 "
	gosub *vo

	【$g_heroの兄】
	うん、ほんとほんと。
	感謝しなさい、この顔の広いお兄様に。\
	dwavestop CH_VOICE	;YB10402 

	【$g_hero】
	…まあ、一応感謝しとく。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TLD"
	mov $debugstr,"立ち：TLD "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"YB10403"
	mov $debugstr,"音声：YB10403 "
	gosub *vo

	【$g_heroの兄】
	あれ？　めずらしい。
	どうしたの、僕に反抗しないなんて？\
	dwavestop CH_VOICE	;YB10403 

	【$g_hero】
	なんだよ、褒めたのに文句つけるなよな。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TLB"
	mov $debugstr,"立ち：TLB "
