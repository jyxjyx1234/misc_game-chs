	;============================================
*CGE_wait
	btnwait %work
	if %work==MOUSE_RBUTTON  gosub *click : csp -1 : goto *cg_select
	if %work==KEY_ESCAPE     gosub *click : csp -1 : goto *cg_select
	if %work==33 gosub *click : csp -1:goto *cg_select ; 戻る
	dec %0
	if %work<0   goto *CGE_wait
	tablegoto %0,*CG_E01A,*CG_E01B,*CG_E02A,*CG_E02B,*CG_E03A,*CG_E04A,*CG_E04B,*CG_E05A,*CG_E06A,*CG_E06B,*CG_E07A,*CG_E08A,*CG_E08B,*CG_E09A,*CG_E10A,*CG_E10B,*CG_E11A,*CG_E12A,*CG_E12B,*CG_E12C,*CG_E12D,*CG_E13A,*CG_E13B,*CG_E14A,*CG_E14B,*CG_E15A,*CG_E15B
