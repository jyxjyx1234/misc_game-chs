*E05	; ■ファイル開始のラベル
	mov $debugstr,"■E05 " : gosub *debugout
;■■■「月光に濡れる教室で、僕は。」台本：■１日目：E05
;━━━━━━━━━━━━━━
;■１日目
;●過去：菜摘先生と最初に会ったときのこと

	;--BGM;----------------------------------
	mov $_music,"06": gosub *out
	;--背景;----------------------------------
	mov $_bg,"BG014C"
	mov $debugstr,"ＢＧ：BG014C"
	mov %effect,6	;エフェクトを指定
	gosub *out	;画面に出力
;BGM:愛

	僕は真新しい制服を着ていた。入学式だった。\

	すごいな…。この桜…。\

	うちは面白いものあんまりないけど、
	桜はすごいよ。ちょっとしか楽しめないけど。\

	出がけにの兄さんの言葉を思い出す。
	学生会の仕事はいいんだけど、僕まで
	連れてこなくていいと思うんだけどな。\

	１年の教室だってまだ誰もいない。
	だからカバンを置いて誰もいない校庭を
	ぷらぷらと、ほっつき歩く。\

	ざぁあ…っと風が巻いて、花びらが踊る。\

	【$g_hero】
	うわっ…花吹雪…。\
;できればイベントＣＧが１枚あるといいなぁ
;じゃなきゃアニメーションっぽいのが。
	;--立ちキャラ;----------------------------------
	mov $_char,"TEC"
	mov $debugstr,"立ち：TEC "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XE0500"
	mov $debugstr,"音声：XE0500"
	gosub *vo

	【菜摘先生】
	この桜も見ないままだったね。\
	dwavestop CH_VOICE	;XE0500

	そんな声が聞こえてきて
	僕は振り向いた。\

	桜の木の下。スーツを着た女のひと。
	先生…なんだろうか。まだ若くて。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TEH"
	mov $debugstr,"立ち：TEH "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XE0501"
	mov $debugstr,"音声：XE0501"
	gosub *vo

	【菜摘先生】
	春になったらって…。
	約束は…やぶってばっかりだったね…。\
	dwavestop CH_VOICE	;XE0501
	gosub *clear_char

	その人は、僕が居るのには
	気が付いていないみたいで。\

	何で泣いているんだろう。
	いや…泣いてないのかな。\

	なんて綺麗なんだろう。
	すごく綺麗だ。
	桜の花の精みたい…。\

	そんなことを連想して自分で恥ずかしくなる。
	そっと通り過ぎればいいのに
	魂を奪われたみたいに僕はぼうっと見ていた。\

	視線に気が付いたのか、
	その人が僕の方を見た。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TEB"
	mov $debugstr,"立ち：TEB "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XE0502"
	mov $debugstr,"音声：XE0502"
	gosub *vo

	【菜摘先生】
	…君は？\
	dwavestop CH_VOICE	;XE0502

	やわらかく笑う。
	さっきまでの哀しみも何もかも
	すべて秘めた顔で優しげに笑う。\

	その声が綺麗で、それだけで、一瞬で。
	好きになってしまうのはどうしてだろう。\
	gosub *blackout

	return	;----------------------------------
;---E05  END -----
