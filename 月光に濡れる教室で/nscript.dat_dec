	mov $debugstr,"音声：XC9878"
	gosub *vo

	【矢崎】
	あと１年…ここにいるんだ。
	ならば、風通しのいい場所にしたいじゃないか。\
	dwavestop CH_VOICE	;XC9878

	【$g_hero】
	そうか…そうだな…。\

	明海が卒業しても、片山が卒業してしまっても
	僕たちはあと１年ここにいるんだ。\

	【$g_hero】
	僕も…僕のために…それから明海のために…
	ぶつかってくるよ。\
	;--立ちキャラ;----------------------------------
	mov $_char,"THB"
	mov $debugstr,"立ち：THB "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
