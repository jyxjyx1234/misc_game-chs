	mov $debugstr,"音声：XB0405"
	gosub *vo

	【百合恵先生】
	いえ。型どおりのものだって。
	たぶん自殺でまちがいないけれど…。\
	dwavestop CH_VOICE	;XB0405

	【$g_hero】
	やっぱり…夢じゃなかったんだ。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TIC"
	mov $debugstr,"立ち：TIC "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XB0406"
	mov $debugstr,"音声：XB0406"
	gosub *vo

	【百合恵先生】
