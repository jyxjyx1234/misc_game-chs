	ガンッ！\

	【$g_hero】
	なんで…僕を…。
	くっ…！！\

	身体がよろけて、僕はフェンスにしがみついた。
	その途端、フェンスが妙な音をたてた。\

	【$g_hero】
	え…！？\
	gosub *GURA	;GURAを呼び出し

	ぐらり。\

	【$g_hero】
	あ…！？\

	フェンスは何もない空中に倒れ込み、
	そして、僕の身体は空に放り出された。\
	;-効果音;----------------------------------
	mov $_se,"ZRAKKA"
	mov $debugstr,"ＳＥ：ZRAKKA"
	gosub *se
	gosub *blackout

	【$g_hero】
	あぁあああぁあああああああぁぁああああ
	あぁあああぁああああぁぁぁあああ！！！！\
	;-効果音;----------------------------------
	mov $_se,"ZDOSA"
	mov $debugstr,"ＳＥ：ZDOSA "
	gosub *se

	ドサッ！\
	gosub *anime_bloodB	;anime_bloodBを呼び出し
;地面の血がにじむ＜ここもアニメにしてほしいなぁ…。
	gosub *blackout

	誰が、どうして、僕を、こんな目に。\

	僕には何も解らなかった。\
	gosub *blackout
	;--背景;----------------------------------
	mov $_bg,"MOONA01"
	mov $debugstr,"ＢＧ：MOONA01 "
	mov %effect,4	;エフェクトを指定
	gosub *out	;画面に出力

	僕が最後に見たのは、
	夜空に映る大きな月だけだった。\
	gosub *blackout
