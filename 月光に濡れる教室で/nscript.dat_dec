	mov $_char,"TBD"
	mov $debugstr,"立ち：TBD "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"BOP0307"
	mov $debugstr,"音声：BOP0307 "
	gosub *vo

	【真実】
	え？あ…うん。ちょっと。\
	dwavestop CH_VOICE	;BOP0307 

	【$g_hero】
	始業時間まで暖房入んないからな。
	そうだ、あったかいものでも買って来ようか？\
	;--立ちキャラ;----------------------------------
	mov $_char,"TBC"
	mov $debugstr,"立ち：TBC "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"BOP0308"
	mov $debugstr,"音声：BOP0308 "
	gosub *vo

	【真実】
	え！？
	い…いいよっ、そんな…気にしないで…。\
	dwavestop CH_VOICE	;BOP0308 

	【$g_hero】
	そう？でも手あっためたりするのにもいいよ。
	何欲しい？　ココアとかがいい？\

	桜井はきゅっと手を握りしめて
	ふるふると首をふった。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TBG"
	mov $debugstr,"立ち：TBG "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"BOP0309"
	mov $debugstr,"音声：BOP0309 "
	gosub *vo

	【真実】
	いいの。そう言ってもらってうれしかった。
	それだけでいいの。\
	dwavestop CH_VOICE	;BOP0309 

	【$g_hero】
	そうなの？でも桜井が掃除してくれたおかげで
	すごく気持ちいいよ。花も綺麗だし。\

	return	;----------------------------------
