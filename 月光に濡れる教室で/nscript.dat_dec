;mode800
*define
nsa
;-------------------------------------------------------------------
;月光に濡れる教室で、僕は。用スクリプト
;■定義　および　初期化
;	Copyright (C) 2003 ちぇりーそふと. All rights reserved.
;-------------------------------------------------------------------
;●全体の仕組み
;	「月光に濡れる教室で、僕は。」版
;	0.txt - 9.txt	システム関連
;		0.txt	define/ゲーム開始前
;		1.txt	システムカスタマイズ関連
;		2.txt	ＯＰムービー/ユーティリティ/CTS/MAP/ED
;		3.txt	タイトル画面・音楽・キャラ紹介
;		4.txt	CONFIG画面の処理
;		5.txt	セーブ＆ロード画面
;		6.txt	ゲームの処理：基本ルーチン
;		7.txt	マボ部屋
;		8.txt	回想モード／Ｈシーン呼び出し
;		9.txt	ＣＧモード
;	10.txt - 	シナリオ関連
;		10.txt	シナリオコントロールはここ
;		11.TXT	テスト用にアキ
;		12.txt	OP
;		13.TXT	真実B
;		14.TXT	明海C
;		15.TXT	小夜子D
;		16.TXT	菜摘E
;		17.TXT	サブキャラＨとか
;		18.TXT	ＣＴＳ呼び出し用
;-------------------------------------------------------------------
;サブディレクトリ説明
;---画像関連---
;	CG	BMP	「mov $_cg,"XXXX" : gosub *cgout」で出力
;	BG	JPG	「mov $_bg,"XXXX" : gosub *out」で出力
;	CHAR	JPG	「mov $_char,"XXXX" : gosub *out」で出力
;	SYS	JPG	画面関連チップ。
;	MABO	JPG	マボ部屋関連
;---音声関連---
;	BGM	WAV	曲。ADPCM 44bit/stero。容量によってはmp3にしてもいいかも
;	VOICE	WAV	音声。ADPCM 44bit/mono もしくは 22bit/mono
;	SE	WAV	効果音。
;-------------------------------------------------------------------
;パック時の構成
;	arc.nsa		SYS/MABO/THUM
;	arc1.nsa	BG
;	arc2.nsa	CHAR
;	arc3.nsa	SE
;	arc4.nsa	CG
;	arc5.nsa	VOICE/B,C,D
;	arc6.nsa	VOICE/X,Y
;	arc7.nsa	BGM
;	BGMとムービーはそのまま。
;-------------------------------------------------------------------
;今回の目標
;	バックログは全画面で
;	効果のスピードは変更可能に＜できたら。
;-------------------------------------------------------------------
;::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
;■システム設定
;::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
	caption		"月光に濡れる教室で、僕は。"
	versionstr	"月光に濡れる教室で、僕は。","Copyright(C) 2003 ちぇりーそふと"
	defaultfont	"ＭＳ ゴシック"
	automode		;メニューに「オートモード」を出現させる
	usewheel		;ホイールマウスを使えるようにする
	useescspc		;ボタン命令でescボタンとspcボタンを使う
	effectblank 	50	;エフェクトからの復帰時間を設定(50ミリ秒)
	mp3fadeout	1000	;CDフェードアウトの時間(ミリ秒)
	defaultspeed	50,25,10
	menusetwindow	18,18,2,2,0,1,#cccccc	;セーブロードメニュー
	selectcolor #FF791E,#FCF3F1
	kidokuskip
	mode_saya
	windoweffect 1	;ウィンドウの出現時のエフェクトは即時
	globalon	;グローバル変数を使用する
	filelog		;ファイルのログを取る
	labellog	;ラベルのログを取る
	lookbackbutton ":a;sys/cur_up.jpg",":a;sys/cur_up_off.jpg",":a;sys/cur_down.jpg",":a;sys/cur_down_off.jpg"
	textgosub *text_lb
	effectcut
;	windowback
;	humanz 250

	;選択肢が開くとき、選択肢のどれかの上に動いたとき、どれかの選択をクリックしたとき
	selectvoice "","se\zover.wav","se\zclick.wav"
	;メニューが開くとき、メニューをキャンセルしたとき、 メニュー選択肢のどれかの上に動いたとき、どれかをクリック したとき、 できない操作をしたときの警告、「はい」を選んだとき、「いいえ」をえらんだとき、です。
	menuselectvoice "","","","","se\zok.wav","se\zcancel.wav",""

;::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
;■メニューの設定
;::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
	resetmenu	;resetmenuでメニューをカスタマイズすることを宣言

;insertmenu "テキスト",機能コード(,サブメニュー階層数)
;最後に,数字がある場合、それはその数だけ掘ったサブメニューへの挿入を意味する。
;ヘルプ(&H)
	insertmenu "バージョン情報(&V)",VERSION
;オートモード(&A)
	insertmenu "オートモード(&A)",AUTO

;選択肢までスキップ(&K)
	insertmenu "選択肢までスキップ(&K)",SKIP

;フォント選択
	insertmenu "フォント選択(&S)",FONT

;systemcall resetdlgだと、Nscripterの機能でリセット
;最初から読み込み直しになるんで、開発時には便利なんだが
;ゲームだとちとなぁ…。
	insertmenu "ファイル(&F)",SUB
	insertmenu "終了(&X)",END,1
	insertmenu "タイトルへ(&T)",RESET,1	;デバッグ時のみ

;insertmenu "環境設定",SUB
;;SUBはサブメニューが開くことをあらわします。
;insertmenu "ウェーブ",SUB,1
;insertmenu "ＯＮ",WAVEON,2
;insertmenu "ＯＦＦ",WAVEOFF,2
;insertmenu "ボリューム",DWAVEVOLUME,2
;insertmenu "テキスト",SUB,1
;insertmenu "遅い",TEXTSLOW,2
;insertmenu "普通",TEXTMIDDLE,2
;insertmenu "速い",TEXTFAST,2
;insertmenu "ＣＤ－ＤＡ",SUB,1
;insertmenu "ＯＮ",CDON,2
;insertmenu "ＯＦＦ",CDOFF,2
;insertmenu "クリック設定",SUB,1
;insertmenu "普通",CLICKDEF,2
;insertmenu "ページごと",CLICKPAGE,2


;::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
;■エイリアス
;	銘々規則
