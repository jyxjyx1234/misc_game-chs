*pd_ng_loop
	btnwait %work
	if %work==MOUSE_RBUTTON gosub *click : csp -1 : goto *syohin_annai
	if %work==KEY_ESCAPE    gosub *click : csp -1 : goto *syohin_annai
	if %work<=0 goto *pd_ng_loop
	if %work==1 gosub *click : csp -1 : bg "MABO/K_ngCHAR.jpg",0 : gosub *pd_modoru : goto *pd_ng
	if %work==2 gosub *click : csp -1 : bg "MABO/K_ngSTRY.jpg",0 : gosub *pd_modoru : goto *pd_ng
	if %work==3 gosub *click : csp -1 : goto *pd_ng_sample
	if %work==4 gosub *click : csp -1 : goto *syohin_annai
	return

