	mov $debugstr,"音声：CC5906"
	gosub *vo

	【明海】
	私たち……お互いに心配するだけで…
	ちっとも気持ち…わからないのね…。\
	dwavestop CH_VOICE	;CC5906

	そのとき。
	僕の背中のまゆ子が、身じろいだ。\
	;-音声;----------------------------------
	mov $_voice,"XC5907"
	mov $debugstr,"音声：XC5907"
	gosub *vo

	【まゆ子】
	……う…ぁ……ンパイ…。\
	dwavestop CH_VOICE	;XC5907

	【$g_hero】
	まゆ子…？気づいたのか！？\
	;-音声;----------------------------------
	mov $_voice,"XC5908"
	mov $debugstr,"音声：XC5908"
	gosub *vo

	【まゆ子】
	…石膏……天使が……。\
	dwavestop CH_VOICE	;XC5908

	【$g_hero】
	何？何て言ったんだまゆ子？\

	先輩が、まゆ子の口許に耳を寄せている。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCC"
	mov $debugstr,"立ち：TCC "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC5909"
	mov $debugstr,"音声：CC5909"
	gosub *vo

	【明海】
	もう…意識はないわ…。\
	dwavestop CH_VOICE	;CC5909

	【$g_hero】
	…まゆ子……。\

	哀しいとか…やりきれないとか…。
	そんな言葉だけじゃ…とても言い表せなかった。\

	僕はこうして、ただ悔しくて…哀しくて…。
	無力なだけで…。\

	大切な後輩が、傷つけられたのに。
	何も…何もできなくて。\

	泣いたってしかたないのに。
	僕が泣いたってどうしようもないのに。\

	こんな安っぽい同情なんて…したって
	仕方がないのに。\

	どうして、どうしてなんだ…。
	僕はうつむいて、今度こそまゆ子をオンブした。\

	先輩が、まゆ子を背負うのを手伝ってくれた。
	僕たちは、まゆ子を保健室に連れて行った。\
	gosub *blackout

	return	;----------------------------------
