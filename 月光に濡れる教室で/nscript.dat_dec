*B87	; ■ファイル開始のラベル
	mov $debugstr,"■B87 " : gosub *debugout
;■■■「月光に濡れる教室で、僕は。」台本：●夜：育巳：B87
;━━━━━━━━━━━━━━
;●夜：育巳

	;--BGM;----------------------------------
	mov $_music,"07": gosub *out
;BGM:愛
	;--背景;----------------------------------
	mov $_bg,"BG033B"
	mov $debugstr,"ＢＧ：BG033B"
	gosub *out	;画面に出力
;ＢＧ：BG033B;主人公の家の玄関

	【$g_hero】
	ただいま。\

	家に帰ると、今日は誰もいなかった。
	兄さんの、朝には帰りますというメモが
	食堂の冷蔵庫に、マグネットで止めてあった。\

	僕はそれを見たあと、冷蔵庫から
	ミネラルウォーターを取り出して飲んだ。\

	それから風呂に入った。
	真実とセックスした跡が全部消えてしまうのが
	切ないような気がした。\

	キスマークとか、つかないかな。
	とか、くだらないことを考えた。\
	;--背景;----------------------------------
	mov $_bg,"BG001B"
	mov $debugstr,"ＢＧ：BG001B"
	gosub *out	;画面に出力
;ＢＧ：BG001B;主人公の部屋

	【$g_hero】
	さてと…
	明日…明後日が、卒業式か…。\

	僕は壁に掛かっているカレンダーを
	見ながらつぶやいた。\

	【$g_hero】
	明日早く行って、講堂の用意しとかないと
	いけないんだっけ。\

	学生会の仕事もあるし、コーラス部の方も
	やらないといけないし。\

	【$g_hero】
	ふう…でも、そんなこと考えられないな。\

	小林先輩のこと。田口のこと。真実のこと。
	羽根田先輩のこと、それと「天使」。\

	【$g_hero】
	今日も…居たのかな。「天使」のヤツ。
	ひとがやってんとこ見てるなんて変態だよな…。\

	変態…っていうか、それが目的なら
	別にいいんだけどな。\

	【$g_hero】
	でも羽根田先輩のこと考えると…。\

	なんとか、しなくちゃいけないのは解る。
	でも、何ができるんだろ。\

	【$g_hero】
	最初から警察に
	話をしておけばよかったのかな。\

	今更…という気にもなるけど。
	だからといって、僕に何ができる？\

	【$g_hero】
	わかってんのは…。\

	「天使」が僕に悪意を持ってること。\

	田口の死も、たぶん
	その天使のせいだってこと。\

	それぐらい。
	それぐらいしか、わからなくて。\
	;-効果音;----------------------------------
	mov $_se,"ZTEL"
	mov $debugstr,"ＳＥ：ZTEL"
	gosub *se
;ＳＥ：ZTEL;電話の音。

	トルルル…トルルル…。\
	;-効果音;----------------------------------
	mov $_se,"ZTELUP"
	mov $debugstr,"ＳＥ：ZTELUP"
	gosub *se

	【$g_hero】
	もしもし？\
	;-音声;----------------------------------
	mov $_voice,"YB8700"
	mov $debugstr,"音声：YB8700"
	gosub *vo

	【育巳】
	オレだよ。\
	dwavestop CH_VOICE	;YB8700

	【$g_hero】
	どしたの？\
	;-音声;----------------------------------
	mov $_voice,"YB8701"
	mov $debugstr,"音声：YB8701"
	gosub *vo

	【育巳】
	いや、ちょっと。
	そういえばさ、桜井との仲、どうなの？\
	dwavestop CH_VOICE	;YB8701

	【$g_hero】
	な、なんだよ、いきなり！\
	;-音声;----------------------------------
	mov $_voice,"YB8702"
	mov $debugstr,"音声：YB8702"
	gosub *vo

	【育巳】
	だって、桜井、きれいになったなってさ。
	なんか、やわらかくなったみたいだ。\
	dwavestop CH_VOICE	;YB8702

	【$g_hero】
	そ、そうかな。\
	;-音声;----------------------------------
	mov $_voice,"YB8703"
	mov $debugstr,"音声：YB8703"
	gosub *vo

	【育巳】
	そうですよ。いいねぇ、お前たち。\
	dwavestop CH_VOICE	;YB8703

	【$g_hero】
	そんな褒められるほどのことは。\
	;-音声;----------------------------------
	mov $_voice,"YB8704"
	mov $debugstr,"音声：YB8704"
	gosub *vo

	【育巳】
	オレも…そうできてれば…違ったのかな。\
	dwavestop CH_VOICE	;YB8704

	【$g_hero】
	育巳？\
	;-音声;----------------------------------
	mov $_voice,"YB8705"
	mov $debugstr,"音声：YB8705"
	gosub *vo

	【育巳】
	いや。なんでもない。
	なんにしろ、明日で、全部終わりだ。\
	dwavestop CH_VOICE	;YB8705

	【$g_hero】
	え？　何が？\
	;-音声;----------------------------------
	mov $_voice,"YB8706"
	mov $debugstr,"音声：YB8706"
	gosub *vo

	【育巳】
	こっちの話。じゃあ、もう切るな。\
	dwavestop CH_VOICE	;YB8706

	【$g_hero】
	おやすみ。\
	;-音声;----------------------------------
	mov $_voice,"YB8707"
	mov $debugstr,"音声：YB8707"
	gosub *vo

	【育巳】
	おやすみ。\
	dwavestop CH_VOICE	;YB8707

	電話が切れたあと、僕はしばらく考え込んだ。
	それから、携帯で別の場所に電話した。\
	gosub *blackout

	return	;----------------------------------
