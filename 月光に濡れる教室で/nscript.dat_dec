	mov $debugstr,"立ち：TPB "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"YD0904"
	mov $debugstr,"音声：YD0904"
	gosub *vo

	【二階堂校長】
	いや、そうだな！　怪しいのは第一発見者だな！
	そうは思わないかね、根津君！\
	dwavestop CH_VOICE	;YD0904
	;--立ちキャラ;----------------------------------
	mov $_char,"TQA"
	mov $debugstr,"立ち：TQA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"YD0905"
	mov $debugstr,"音声：YD0905"
	gosub *vo

