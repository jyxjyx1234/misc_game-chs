	dwavestop CH_VOICE	;YC7355

	【$g_hero】
	なんだって！？\
	;--立ちキャラ;----------------------------------
	mov $_char,"TVD"
	mov $debugstr,"立ち：TVD "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"YC7356"
	mov $debugstr,"音声：YC7356"
	gosub *vo

	【丹羽】
	うわっ、いきなりデカイ声だすなよ。
	そうだよ。そういう噂なんだ。\
	dwavestop CH_VOICE	;YC7356

	【$g_hero】
	ウワサなんて、全部ウソに決まってるだろ。
	だれだよ、尾ひればかりつけて流してる奴は！\
	;--立ちキャラ;----------------------------------
	mov $_char,"TVA"
	mov $debugstr,"立ち：TVA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"YC7357"
	mov $debugstr,"音声：YC7357"
	gosub *vo

	【丹羽】
	でもさ、きっとゼッタイに正解だぜ。\
	dwavestop CH_VOICE	;YC7357

	【$g_hero】
