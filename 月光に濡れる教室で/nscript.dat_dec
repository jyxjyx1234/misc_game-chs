	dwavestop CH_VOICE	;DD1004
	;--立ちキャラ;----------------------------------
	mov $_char,"THJ"
	mov $debugstr,"立ち：THJ "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XD1005"
	mov $debugstr,"音声：XD1005"
	gosub *vo

	【矢崎】
	…うらやましいことで。\
	dwavestop CH_VOICE	;XD1005

	return	;----------------------------------
;---D10  END -----
