*D03	; ■ファイル開始のラベル
	mov $debugstr,"■D03 " : gosub *debugout
;■■■「月光に濡れる教室で、僕は。」台本：●小夜子に会う：D03
;━━━━━━━━━━━━━━
;●小夜子に会う

	;--BGM;----------------------------------
	mov $_music,"04": gosub *out
;BGM:さりげない日常
	;--背景;----------------------------------
	mov $_bg,"BG014A"
	mov $debugstr,"ＢＧ：BG014A"
	gosub *out	;画面に出力
;ＢＧ：BG014A;校門

	【$g_hero】
	今日も寒いな…。\

	春は名のみのって、ほんとにそうだ。
	吐く息が白くて、身体の筋肉がぎゅっと固まる。\

	今日も早く来たから、誰とも会わないですんだ。
	顔を合わせたくなかったから、よかったけど。\

	【$g_hero】
	どうすればいいのかな…。\

	ああ、やっぱり逃げたい。
	そんなことを考える僕が情けない。\

	自分でやったことだろ。責任とれよ。
	責任って、どうやって。
	頭がぐるぐるくだらない考えで回っている。\

	【$g_hero】
	どうしようかな…。\

	自分の教室に行けば、たぶん小夜子には
	会わないですむ。音楽室に行けば、きっと。\

	【$g_hero】
	………………………。\

	どっちに行けばいいのかなんて決まってる。
	このまま、何もなかったままに
	なんてできないんだから。\

	【$g_hero】
	行かないと…。\
	gosub *musicstop

	;--BGM;----------------------------------
	mov $_music,"14": gosub *out
	;--立ちキャラ;----------------------------------
	mov $_char,"TDA"
	mov $debugstr,"立ち：TDA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"DD0300"
	mov $debugstr,"音声：DD0300"
	gosub *vo

	【小夜子】
	先輩。\
	dwavestop CH_VOICE	;DD0300

	【$g_hero】
	小夜子…。\
;BGM:迷

	僕は何を言えばいいんだろう。\
;＠＠＠ここから書き直し＠＠＠
	;--立ちキャラ;----------------------------------
	mov $_char,"TDG"
	mov $debugstr,"立ち：TDG "
	gosub	*out	;画面に出力

	【小夜子】
	………………………………。\

	まるで昨日のことは月にとけた夢のようで。
	でも、もちろん夢ではなくて。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TDF"
	mov $debugstr,"立ち：TDF "
	gosub	*out	;画面に出力

	【小夜子】
	……………。\

	この小夜子に、昨日僕は触れたんだ。
	何も付けていない体に触って、つながったんだ。\

	僕の顔が、朱に染まる。体が熱い。
	心臓がどくどく鳴る。
	小夜子に、なんて言えばいいんだろう？\

	僕と小夜子は何も言わずに、
	ただお互いを見つめていた。\

	こんなに真剣に、誰かを見たことはなかった。\

	小夜子の明るい瞳に、僕が映っている。
	長い睫がふるふると震えている。\

	きっと外から見たら、
	恋に落ちた二人みたいに見えるのかも知れない。\

	ふと、そんな考えが自分に落ちてきて
	笑いたいような泣きたいような気持ちになる。\

	どうしよう。どうすればいいんだろう。
	わからない。わからないけれど。\

	何か、言わなくちゃ。
	何か。\

	【$g_hero】
	さ…小夜子…。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TDG"
	mov $debugstr,"立ち：TDG "
	gosub	*out	;画面に出力

	【小夜子】
	…………。\

	【$g_hero】
	…話…いいか？\
	;--立ちキャラ;----------------------------------
	mov $_char,"TDF"
	mov $debugstr,"立ち：TDF "
	gosub	*out	;画面に出力

	【小夜子】
	……………。\

	小夜子は何も言わずに、ただ肯いた。\

	どこに行こうか？
	音楽室に行くのはイヤだった。\

	この時間なら…どこも、あまりひとは
	居ないだろうけど…。\

	そっか。逆に、ひとが来たら
	すぐにわかるところに行けばいいのか。\

	【$g_hero】
	ついて来てよ。\

	小夜子は、ちいさな声で肯いた。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TDG"
	mov $debugstr,"立ち：TDG "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"DD0301"
	mov $debugstr,"音声：DD0301"
	gosub *vo

	【小夜子】
	うん。\
	dwavestop CH_VOICE	;DD0301

	その声があんまり心細そうで
	そんな声をさせる僕は、どうしようもないなと
	気分が暗く沈んだ。\
;＠＠＠ここまで＠＠＠

	僕たちは、校舎の裏庭の方へ向かった。\
	gosub *blackout

	return	;----------------------------------
;---D03  END -----
