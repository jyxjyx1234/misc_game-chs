	mov $debugstr,"音声：YC7353"
	gosub *vo

	【丹羽】
	俺、ちょっとドキドキしちゃった。\
	dwavestop CH_VOICE	;YC7353

	【$g_hero】
	別に…。
	ドラマチックでも何でもなかったよ。\

	ただ不快で…不愉快で…哀しくて…恐ろしかった。
	もうあんなもの…二度と見たくない。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TVD"
	mov $debugstr,"立ち：TVD "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"YC7354"
	mov $debugstr,"音声：YC7354"
	gosub *vo

	【丹羽】
	ていうかさ、あの元会長？
	あの女すごいよな。殺人犯なんだろ？\
	dwavestop CH_VOICE	;YC7354

	【$g_hero】
	違うよ。先輩は犯人じゃない。\

	丹羽は、僕の言ったことを完全に無視した。
	楽しげに喋りつづけてる。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TVA"
	mov $debugstr,"立ち：TVA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"YC7355"
	mov $debugstr,"音声：YC7355"
	gosub *vo

	【丹羽】
