;BGM:喜
	;--背景;----------------------------------
	mov $_bg,"BG019G"
	mov $debugstr,"ＢＧ：BG019G"
	gosub *out	;画面に出力
;ＢＧ：BG019A;学生会室

	【$g_hero】
	失礼しま～～す。
	矢崎、来たぞ～。\

	【$g_hero】
	……誰もいない。っかしいなぁ…。\

	矢崎のヤツは約束には几帳面な人間なのだ。
	呼びつけておいて忘れるってことはないだろう。\

	【$g_hero】
	あいつのクラス、ＨＲが長引いてんのかなぁ…。\

	しかたない。しばらく待つか…。
	ついでに、机の上に置いてあった雑用仕事を
	片づけておいてやろう。\

	しばらくプリントをまとめたり、ノートを
	つけ直していたが、いっこうに来る様子がない。\

	【$g_hero】
	…いくらなんでも、もう終わってるよなぁ…。
	教室行ってみるか。\
	gosub *blackout
	;--背景;----------------------------------
	mov $_bg,"BG013G"
	mov $debugstr,"ＢＧ：BG013G"
	gosub *out	;画面に出力
;ＢＧ：BG013A;廊下

	【$g_hero】
	矢崎は、２Ｃなんだけど…。
	おっかしいな、もう教室には誰もいないぞ。\

	行き違いになっちゃったのかな…？\

	僕はそこらへんにいるヤツを捕まえて
	矢崎の行き先を聞いてみた。\

	;--BGM;----------------------------------
	mov $_music,"03": gosub *out
;BGM:怒
	;-音声;----------------------------------
	mov $_voice,"XD8400"
	mov $debugstr,"音声：XD8400"
	gosub *vo

	【女子学生Ａ】
	矢崎くん？　あれ、君に呼び出されたって
	あわてて出かけていったけど…。\
	dwavestop CH_VOICE	;XD8400

	【$g_hero】
	僕に？　って、呼びに来たのだれ？　育巳？\
	;-音声;----------------------------------
	mov $_voice,"XD8401"
	mov $debugstr,"音声：XD8401"
	gosub *vo

	【女子学生Ａ】
	ううん。１年の、なんかチャラチャラした
	２人組。男の子。\
	dwavestop CH_VOICE	;XD8401

	【$g_hero】
	……ちゃらちゃら…って。
	もしかして、イズミとスダ！？\
	;-音声;----------------------------------
	mov $_voice,"XD8402"
	mov $debugstr,"音声：XD8402"
	gosub *vo

	【女子学生Ａ】
	あ、うん。なんか、そんなこと言ってたような。\
	dwavestop CH_VOICE	;XD8402

	マズイ！　何かわかんないけど、とにかく
	すごくまずいような気がする！！\

	っていうか、人の名前を騙るなよ！！！\

	【$g_hero】
	えっと、それで、
	どこに行ったかわからないかな？\
	;-音声;----------------------------------
	mov $_voice,"XD8403"
	mov $debugstr,"音声：XD8403"
	gosub *vo

	【女子学生Ａ】
	ううん…そこまでは。
	外の方に行ったみたいだけど…。\
	dwavestop CH_VOICE	;XD8403

	【$g_hero】
	ありがとう！\
	gosub *blackout

	return	;----------------------------------
;---D84  END -----
