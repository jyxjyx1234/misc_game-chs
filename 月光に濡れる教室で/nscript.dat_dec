	mov $debugstr,"音声：BB8206"
	gosub *vo

	【真実】
	どこに？\
	dwavestop CH_VOICE	;BB8206

	【$g_hero】
	屋上！\
	;--立ちキャラ;----------------------------------
	mov $_char,"TBD"
	mov $debugstr,"立ち：TBD "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"BB8207"
	mov $debugstr,"音声：BB8207"
	gosub *vo

	【真実】
