*C51	; ■ファイル開始のラベル
	mov $debugstr,"■C51 " : gosub *debugout
;■■■「月光に濡れる教室で、僕は。」台本：●間に合わなかった：B51
;━━━━━━━━━━━━━━
;●間に合わなかった
	gosub *blackout

	;--BGM;----------------------------------
	mov $_music,"04": gosub *out
	;--背景;----------------------------------
	mov $_bg,"BG020B"
	mov $debugstr,"ＢＧ：BG020B"
	gosub *out	;画面に出力
;ＢＧ：BG020B;使われてない教室（調教用）（夜）

	夜の教室には、窓いっぱいの月と先輩の姿。
	月の光に満たされた教室。\
	;-音声;----------------------------------
	mov $_voice,"CC5100"
	mov $debugstr,"音声：CC5100"
	gosub *vo

	【明海】
	待ってたわ……キミを…あなたを…。\
	dwavestop CH_VOICE	;CC5100

	先輩は笑っていた。
	やさしく、綺麗な顔をして笑っていた。\

	それは、いつもの先輩の笑顔でなくて。
	だけど、見たことのある笑顔で。\

	夜の…微笑みで。\

	先輩は。
	腕に、鉢植えの花をかかえていた。\

	間に合わなかったんだ…。
	僕は、よろめいた。\

	濃厚な花の香りが、教室を満たす。
	そして…月の光が……。\

	眩暈がした。
	くらりと…いつもの花の匂いが鼻腔をつく。\

	月が回り、世界が回る。\

	何もかもを忘れて、欲に溺れる夜。\

	昨日と…同じ夜がはじまる。\
	gosub *whiteout

	return	;----------------------------------
;---C51  END -----
