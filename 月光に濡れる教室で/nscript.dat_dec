	mov $_char,"TLA"
	mov $debugstr,"立ち：TLA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"YE2304"
	mov $debugstr,"音声：YE2304"
	gosub *vo

	【$g_heroの兄】
	そりゃあね。すごい人気だったもんなぁ…。
	かわいくて、ちょっとドジでさ。\
	dwavestop CH_VOICE	;YE2304

	【$g_hero】
	え、ドジって？\
