; MPX312
; Copyright (C) Cherrysoft. All rights reserved
; 2003/03/02
;============================================
*MPX312	; ■ファイル開始のラベル
	mov $debugstr,"■MPX312" : gosub *debugout
;■マップ（無人）
	;--背景;----------------------------------
	mov $_bg,"BG031A"
	mov $debugstr,"ＢＧ：BG031A"
	gosub *out	;画面に出力

	ここは購買だけど…。\

	【$g_hero】
	せっかく来たんだし、何か買って行こうかな。\

	購買はあやしい販売物だけじゃなくて、
	ここでしか買えないグッズも扱っている。\

	その中でもまぼグッズはかなりの人気商品だ。\

	まぼってのは、まぼちゃんという愛称で
	親しまれているうちのガッコの校章の図柄だ。\

	＜まぼ＞の名前の通り、マンボウなんだけど…。\

	どうして校章にあのフグ目マンボウ科の
	マンボウが使われたのかは、わからない。\

	【$g_hero】
	（当時の校長の趣味かな…？）\

	ちなみにこの購買でしか手に入らない
	まぼちゃんグッズは、\

	まぼちゃんバンダナ
	まぼちゃんキーホルダー\

	まぼちゃんストラップ
	まぼちゃん目覚まし時計\

	まぼちゃんノート
	まぼちゃんシャープペン\

	まぼちゃんパン
	まぼちゃん牛乳\

	などなど…非常に充実している。
	だれがこんなに増やしたんだ。\

	【$g_hero】
	そういえば、丹羽がしてたっけ…。
	まぼちゃんバンダナ。\

	【$g_hero】
	（丹羽とおそろいはイヤだな…）\
	gosub *blackout

	return	;----------------------------------
;---MPX312 END -----
