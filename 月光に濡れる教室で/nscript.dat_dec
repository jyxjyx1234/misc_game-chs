; 2003/03/02
;============================================
*OP52	; ■ファイル開始のラベル
	mov $debugstr,"■OP52" : gosub *debugout
;■■■「月光に濡れる教室で、僕は。」台本：●教室で：OP52
;━━━━━━━━━━━━━━
;●教室で

	;--BGM;----------------------------------
	mov $_music,"03": gosub *out
;BGM:迷
	;--背景;----------------------------------
	mov $_bg,"BG013B"
	mov $debugstr,"ＢＧ：BG013B"
	gosub *out	;画面に出力
;ＢＧ：BG013B;廊下

	正直に言って、誰もいない校舎は
	ものすごく、薄気味悪かった。\

	非常灯の明かりやら、窓からの明かりで
	案外、真っ暗ではないところが
	さらに不気味度をたかめる。\

	夏だったら肝試しに最適じゃないかな。\

	開いた窓のせいか、ゆらゆら揺れる影に
	思わず声をあげそうになっってしまったり、
	カタカタ鳴る窓にびびってしまったり。\

	【$g_hero】
	度胸ないなぁ…。\

	正直、ちょっと情けない。
	もう少し自分は度胸があるのかと思ってたな…。\

	【$g_hero】
	でも自分って、過大評価しやすいしな…。\

	人間誰しも自分には甘くなりがちだから
	粗末にするぐらいがちょうどいいとか。\

	ま、いいや。それは。\
	;--背景;----------------------------------
	mov $_bg,"BG009C"
	mov $debugstr,"ＢＧ：BG009C"
	gosub *out	;画面に出力
;ＢＧ：BG009B;２年教室

	なんとか教室にたどりついた。
	窓から入る明かりで、動くのには苦労しない。\

	そういや、今日は満月かな。
	やけに外があかるいや。\
;2003/3/17は月例１６．４ほぼ満月。

	【$g_hero】
	えっと、僕の机…机…。
	あった！\
	;--背景;----------------------------------
	mov $_bg,"NOTECLOSE"
	mov $debugstr,"ＢＧ：NOTECLOSE "
	mov %effect,CG_EFFECT	;エフェクトを指定
	gosub *out	;画面に出力

	机の上には僕のノートが載っている。\

	【$g_hero】
	はあ…。あの恥ずかしい小説モドキも
	見られたのかな…。ん…？\
	;--背景;----------------------------------
	mov $_bg,"NOTEOPEN"
	mov $debugstr,"ＢＧ：NOTEOPEN"
	mov %effect,4	;エフェクトを指定
	gosub *out	;画面に出力

	中に何かが挟まっている。
	メモ…かな？\

	僕は窓のそばに寄った。
	月明かりで見てみる。\
	;--背景;----------------------------------
	mov $_bg,"ANGEL"
	mov $debugstr,"ＢＧ：ANGEL "
	mov %effect,4	;エフェクトを指定
	gosub *out	;画面に出力

	【$g_hero】
	天使…か。
	中にも絵が描いてあるな…。\

	僕はカードを開けてみた。\

	【$g_hero】
	聖母子像か。ラファエロだな…。\

	聖母子像ってのは、聖母マリアと幼子イエスの
	絵のことだ。宗教絵画じゃ有名すぎるほど有名な
	モチーフだ。\

	絵にはあまり興味ないけど、これぐらい有名な
	ものならわかる。\

	【$g_hero】
	ポストカード…だな。\

	展示会か何かで買ったやつかな。
	それとも、海外のお土産かもしれない。
	英語じゃないような単語の羅列。\

	【$g_hero】
	イタリア語なのかな…？
	ん？\

	よく見るとカードには文字らしきものが
	書いてある。僕は目を細めて、それを読んだ。\
	gosub *blackout
	;--背景;----------------------------------
	mov $_bg,"BG009C"
	mov $debugstr,"ＢＧ：BG009C"
	gosub *out	;画面に出力
;これはキャラ別にちがうよー

	if %g_root==MAKOTO goto *MAKOTOBG
	if %g_root==AKEMI goto *AKEMIBG
	if %g_root==SAYOKO goto *SAYOKOBG;----------------------------------
*MAKOTOBG

	【$g_hero】
	「１Ｆの教室へ行け」？
	１Ｆって、あの使われてないヤツか？\
	goto *nextOP52	;nextOP52へ移動
;----------------------------------
*AKEMIBG

	【$g_hero】
	「校庭へ行け」？
	校庭…？\
	goto *nextOP52	;nextOP52へ移動
;----------------------------------
*SAYOKOBG

	【$g_hero】
	「体育館へ行け」？
	体育館？　なんでまた、そんなところに？\
;----------------------------------
*nextOP52
;;-------------------ここまで

	どういうことだろう？
	なんで、こんなメモを残したんだろう。\

	これを残した相手がそこに居るんだろうか。
	なんで、わざわざ呼び出したんだろうか。\

	好奇心がうずく。\

	【$g_hero】
	どうしよう…行ってみようかな。\

	なんて口に出してみたけど、
	心のほうは決まってる。\

	どうせこのノートを見られてるんだ。
	それなのに、こんなカードを残すなんて
	そうとう茶目っ気のあるヤツにちがいない。\

	【$g_hero】
	育巳じゃないよな…。
	この葉書、あいつの趣味じゃないしな…。\

	誰なんだろ。とにかく、面白そうだ。\

	【$g_hero】
	よし、行ってみるか！\
	gosub *blackout

	return	;----------------------------------
;---OP52 END -----
