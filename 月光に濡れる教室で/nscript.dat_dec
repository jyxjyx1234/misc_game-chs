;★★★ここも話にあわせて変えること★★★
;ここでは先生とはわからないようにしなければ。
;でも声出しちゃうとわかるか…変えてもらえれば
;ムー。しかしそれでも女だと解ってしまう。
;★★★天使からのメールに変えること！！！★★
	gosub *blackout

	;--BGM;----------------------------------
	mov $_music,"06": gosub *out
	;--背景;----------------------------------
	mov $_bg,"MOON01"
	mov $debugstr,"ＢＧ：MOON01"
	mov %effect,4	;エフェクトを指定
	gosub *out	;画面に出力
	gosub *anime_moonA	;anime_moonAを呼び出し

	【天使】
	誰からも望まれないのなら、
	生きていても意味がないのだと思う。\

	【天使】
	だから望まれるようにしたいと思った。
	いや、思っていたのかどうかわからない。\

	【天使】
	ただ、何もなく。誰からも見捨てられて
	そんな風に生きていくのはつらすぎるから。\

	【天使】
	そうは思わない？\
	;-効果音;----------------------------------
	mov $_se,"ZLOGO"
	mov $debugstr,"ＳＥ：ZLOGO "
	gosub *se
;月が動いてるのをアニメっぽく出したいなーと
;ここはエフェクトかなにかで、見せたいが
;インのときに、もやっぽく？
;Ｃ１０みたいな感じ？　
	gosub *blackout

	return	;----------------------------------
;---D25  END -----
