*OP47	; ■ファイル開始のラベル
	mov $debugstr,"■OP47" : gosub *debugout
;■■■「月光に濡れる教室で、僕は。」台本：●香津実：OP47
;━━━━━━━━━━━━━━
;●香津実
;その途中で香津実（丹羽と会っていた）
;小夜子を見下げる発言。
;家が近所だから。

	;--BGM;----------------------------------
	mov $_music,"03": gosub *out
;BGM:怒
	;--背景;----------------------------------
	mov $_bg,"BG013A"
	mov $debugstr,"ＢＧ：BG013A"
	gosub *out	;画面に出力
;廊下

	その時、いきなり小夜子の背後から
	割って入った女の子がいた。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TTA"
	mov $debugstr,"立ち：TTA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XOP4700"
	mov $debugstr,"音声：XOP4700 "
	gosub *vo

	【香津実】
	あいかわらず、お盛んね。芹沢さん。
	また彼をたらし込んでるわけ？\
