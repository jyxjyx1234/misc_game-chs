;■■■「月光に濡れる教室で、僕は。」台本：●マップ移動：B13
;○裏庭
;━━━━━━━━━━━━━━
;●マップ移動
;ここでマップ移動
;【$g_hero】
;さてと、どうするかな…。
;○職員室

	;--BGM;----------------------------------
	mov $_music,"03": gosub *out
;別の場所でも適当に
	;--背景;----------------------------------
	mov $_bg,"BG023A"
	mov $debugstr,"ＢＧ：BG023A"
	gosub *out	;画面に出力
;ＢＧ：BG023A;職員室
	;--立ちキャラ;----------------------------------
	mov $_char,"TPE"
	mov $debugstr,"立ち：TPE "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"YB0700"
	mov $debugstr,"音声：YB0700"
	gosub *vo

	【二階堂校長】
	いや、まったく困ったことになった
	そうは思わないかね、根津君。\
	dwavestop CH_VOICE	;YB0700
	;--立ちキャラ;----------------------------------
	mov $_char,"TQA"
	mov $debugstr,"立ち：TQA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"YB0701"
	mov $debugstr,"音声：YB0701"
	gosub *vo

	【根津先生】
	いや、もうまったく、二階堂校長の
	おっしゃる通りで。\
	dwavestop CH_VOICE	;YB0701
	;--立ちキャラ;----------------------------------
	mov $_char,"TPA"
	mov $debugstr,"立ち：TPA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"YB0702"
	mov $debugstr,"音声：YB0702"
	gosub *vo

	【二階堂校長】
	自殺、自殺なんて、家ででもやればいいんだよ。
	これで虐めだの、こちらの不注意だの…。\
	dwavestop CH_VOICE	;YB0702
	;--立ちキャラ;----------------------------------
	mov $_char,"TQA"
	mov $debugstr,"立ち：TQA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"YB0703"
	mov $debugstr,"音声：YB0703"
	gosub *vo

	【根津先生】
	ええ、もう、まったく。
	二階堂校長のおっしゃる通りで。\
	dwavestop CH_VOICE	;YB0703
	;--立ちキャラ;----------------------------------
	mov $_char,"TPE"
	mov $debugstr,"立ち：TPE "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"YB0704"
	mov $debugstr,"音声：YB0704"
	gosub *vo

	【二階堂校長】
