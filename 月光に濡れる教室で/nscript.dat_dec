	【菜摘先生】
	みなさん、お早うございます。今日の伝達事項
	ですが…。あら、田口君は？　お休み？\
	dwavestop CH_VOICE	;XB3200
	;--立ちキャラ;----------------------------------
	mov $_char,"TJC"
	mov $debugstr,"立ち：TJC "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
