	mov $_char,"TNE"
	mov $debugstr,"立ち：TNE "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"YMP0665"
	mov $debugstr,"音声：YMP0665 "
	gosub *vo

	【イズミ】
	ああ、そうそう、そんな名前の。
	あいつムチャクチャムカつくよな！\
	dwavestop CH_VOICE	;YMP0665 

	【$g_hero】
	なんで？\
	;--立ちキャラ;----------------------------------
	mov $_char,"TOE"
	mov $debugstr,"立ち：TOE "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"YMP0666"
	mov $debugstr,"音声：YMP0666 "
	gosub *vo

	【スダ】
	今日なんかさ、オレが買えなかった靴履いてた。
	セールでようやく４万まで落ちたヤツ。\
	dwavestop CH_VOICE	;YMP0666 

	【$g_hero】
	そんな値段の高い靴、よく買うよな…。\
	;--立ちキャラ;----------------------------------
