*D69	; ■ファイル開始のラベル
	mov $debugstr,"■D69 " : gosub *debugout
;■■■「月光に濡れる教室で、僕は。」台本：●小夜子の家：D69
;━━━━━━━━━━━━━━
;●小夜子の家

	;--BGM;----------------------------------
	mov $_music,"14": gosub *out
;BGM:迷
	;--背景;----------------------------------
	mov $_bg,"BG008B"
	mov $debugstr,"ＢＧ：BG008B"
	gosub *out	;画面に出力
;;小夜子の部屋
	;--立ちキャラ;----------------------------------
	mov $_char,"TDG"
	mov $debugstr,"立ち：TDG "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"DD6900"
	mov $debugstr,"音声：DD6900"
	gosub *vo

	【小夜子】
	時間だわ、行かないと…。\
	dwavestop CH_VOICE	;DD6900
;gosub *clear_char
	;-音声;----------------------------------
	mov $_voice,"XD6901"
	mov $debugstr,"音声：XD6901"
	gosub *vo

	【使用人のおばさん】
	お嬢様、私はもうこれで帰りますけど。
	戸締まりちゃんとしてくださいね。\
	dwavestop CH_VOICE	;XD6901
	;--立ちキャラ;----------------------------------
	mov $_char,"TDA"
	mov $debugstr,"立ち：TDA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"DD6902"
	mov $debugstr,"音声：DD6902"
	gosub *vo

	【小夜子】
	はい、わかってます。\
	dwavestop CH_VOICE	;DD6902
;gosub *clear_char
	;-音声;----------------------------------
	mov $_voice,"XD6903"
	mov $debugstr,"音声：XD6903"
	gosub *vo

	【使用人のおばさん】
	今日は奥様もご実家なんですから。
	どうしてお嬢様もいらっしゃらないんですか？\
	dwavestop CH_VOICE	;XD6903
	;--立ちキャラ;----------------------------------
	mov $_char,"TDC"
	mov $debugstr,"立ち：TDC "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"DD6904"
	mov $debugstr,"音声：DD6904"
	gosub *vo

	【小夜子】
	ちょっと…熱っぽいから。\
	dwavestop CH_VOICE	;DD6904
;gosub *clear_char
	;-音声;----------------------------------
	mov $_voice,"XD6905"
	mov $debugstr,"音声：XD6905"
	gosub *vo

	【使用人のおばさん】
	あら、そうなんですか。
	私はてっきり彼氏と長電話でもするのかと…。\
	dwavestop CH_VOICE	;XD6905
	;--立ちキャラ;----------------------------------
	mov $_char,"TDL"
	mov $debugstr,"立ち：TDL "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"DD6906"
	mov $debugstr,"音声：DD6906"
	gosub *vo

	【小夜子】
	し、しないわよ！　そんなこと！！\
	dwavestop CH_VOICE	;DD6906
;gosub *clear_char
	;-音声;----------------------------------
	mov $_voice,"XD6907"
	mov $debugstr,"音声：XD6907"
	gosub *vo

	【使用人のおばさん】
	おほほほ。いいですねぇ、若いって。
	ちゃんと避妊してくださいよ。\
	dwavestop CH_VOICE	;XD6907
	;--立ちキャラ;----------------------------------
	mov $_char,"TDF"
	mov $debugstr,"立ち：TDF "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"DD6908"
	mov $debugstr,"音声：DD6908"
	gosub *vo

	【小夜子】
	もう！　\
	dwavestop CH_VOICE	;DD6908
	gosub *blackout

	return	;----------------------------------
;---D69  END -----
