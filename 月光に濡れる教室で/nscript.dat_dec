;ＢＧ：BG011A;３年教室

	３年の教室は、閑散としていた。
	鞄の数もかなり少ない。\

	【$g_hero】
	人がすくないなぁ…。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCA"
	mov $debugstr,"立ち：TCA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
