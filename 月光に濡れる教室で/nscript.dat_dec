	gosub	*B31	;●教室で田口と
	gosub	*B32	;●菜摘先生のＨＲ
	gosub	*B33	;●真実と「天使」と田口の関係
	gosub	*B34	;●マップ移動前置き
	gosub	*BMAP02	;●マップ移動：２日目
	gosub	*B35	;●通知
;	gosub	*B36	;●プレイ選択
	gosub	*B37	;●真実と帰宅
	gosub	*B38	;●帰宅
	gosub	*B39	;●二人で帰宅
	gosub	*B40	;●夜自宅で：田口の母
	gosub	*B41	;●田口君どこかでうろつく
	gosub	*B42	;●主人公家を出る
	gosub	*B43	;●夜：調教前
*makoto_h2
	gosub	*BH_2ND	;*BH01	;●Ｈシーン
	gosub	*CTS_B
	gosub	*B45	;●Ｈシーン後
	gosub	*B46	;●帰宅：夜：真実と
	gosub	*B47	;●夜：学園：田口
	gosub	*B48	;●夜：育巳から電話
	gosub	*B49	;●真実と夜の電話
	gosub	*B50	;●田口の死


;□真実３日目
*makoto3
	if %makoto_bad==ON goto *BAD_ASA
	gosub	*B51	;●朝：自分の部屋
;	gosub	*ASA03	;３日目の兄	これは共通にできないかも～。
	gosub	*B52	;●朝：登校
	gosub	*B53	;●田口の死
	gosub	*B54	;●再び保健室で
	gosub	*B55	;●保健室で菜摘先生と
	gosub	*B56	;●マップ移動
