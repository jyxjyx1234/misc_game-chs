	gosub *out	;画面に出力
;ＢＧ：BG001A;主人公の部屋
;朝は、雀ちゅんちゅん入れる
	;-効果音;----------------------------------
	mov $_se,"ZSUZUME"
	mov $debugstr,"ＳＥ：ZSUZUME "
	gosub *se
;ＳＥ：ZSUZUME;スズメ

	早朝の空気はしんと冷えている。
	毛布から顔を出すと吐く息が白かった。\

	【$g_hero】
	ふぁ…寒い…。\

	手探りでリモコンに手を伸ばし、
	部屋の暖房のスイッチを入れる。\

	【$g_hero】
	小夜子…どうしてるかな。\

	寒そうな横顔や細い首をぎゅっと抱きしめて
	キスしたいと思う。\

	【$g_hero】
	それには…もうちょっと、
	僕がしっかりしないとな。\

	頼りがいないもんなぁ…。
	どうしようもないよなぁ。\

	「天使」を捕まえるどころか、すぐ流されて
	エッチしちゃうし。真っ当な対策とってないし。\

	そういえば、昨日の小夜子は…すごい
	激しかったなぁ…。\

	思い返すと…つい下半身が反応してしまう。
	ゴォオ…と暖房が温風を吐き出す音がした。\

	【$g_hero】
	朝だしなぁ…。\

	自分の手が、下半身に伸びていく。\

	【$g_hero】
	小夜子…。\

	これを小夜子に突き立てたのかと思うと
	妙に興奮した。そっと指を這わせる。\

	【$g_hero】
	………。\

	return	;----------------------------------
;---D79  END -----
