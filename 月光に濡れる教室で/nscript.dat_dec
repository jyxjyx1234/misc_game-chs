	mov $debugstr,"音声：XB0403"
	gosub *vo

	【百合恵先生】
	ふたりともものすごく興奮してたから、
	鎮静剤をね。\
	dwavestop CH_VOICE	;XB0403

	【$g_hero】
	そうだったんだ。\

	そういや、パニック状態っていうんだろうか。
	もう何がなんだか、わからない状況
	だったような気がする。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TIE"
	mov $debugstr,"立ち：TIE "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
