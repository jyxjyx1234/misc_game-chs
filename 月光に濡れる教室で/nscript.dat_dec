	【明海】
	……そうね。夜が来るわね。\
	dwavestop CH_VOICE	;CC10500 

	明海が、窓に近づいた。
	カーテンを少しだけ開いて、外を見る。\

	窓から見える月は、
	信じられないくらい大きかった。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCA"
	mov $debugstr,"立ち：TCA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC10501"
	mov $debugstr,"音声：CC10501 "
	gosub *vo

	【明海】
	ねぇ…知ってる？
	地上に近い月は、大きく見えるの。\
	dwavestop CH_VOICE	;CC10501 

	【$g_hero】
	そうなんだ。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCB"
	mov $debugstr,"立ち：TCB "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC10502"
	mov $debugstr,"音声：CC10502 "
	gosub *vo

	【明海】
	目の錯覚なのよ。
	ほら、周りに山や…建物があるでしょ？\
	dwavestop CH_VOICE	;CC10502 

	【$g_hero】
	錯覚なのか。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCA"
	mov $debugstr,"立ち：TCA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC10503"
	mov $debugstr,"音声：CC10503 "
	gosub *vo

	【明海】
	そう…錯覚なの。
	でも…私の目には確かに月は大きく見える。\
	dwavestop CH_VOICE	;CC10503 
	;--立ちキャラ;----------------------------------
	mov $_char,"TCF"
	mov $debugstr,"立ち：TCF "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC10504"
	mov $debugstr,"音声：CC10504 "
	gosub *vo

	【明海】
