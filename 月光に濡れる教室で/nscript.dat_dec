	mov $debugstr,"音声：XSH0274 "
	gosub *vo

	【女の子】
	あ…ひんっ…う…うごいてる…まだ…。\
	dwavestop CH_VOICE	;XSH0274 
	;-音声;----------------------------------
	mov $_voice,"YSH0275"
	mov $debugstr,"音声：YSH0275 "
	gosub *vo

	【スダ】
	しょうがねぇ淫乱だな。それじゃ今度はオレが
	オマ○コに突っ込んでやるよ。うれしいだろ？\
	dwavestop CH_VOICE	;YSH0275 
	;-音声;----------------------------------
	mov $_voice,"XSH0276"
	mov $debugstr,"音声：XSH0276 "
	gosub *vo

	【女の子】
	あ…う…うれしい…です…
	ありがとう…ございます…。は…ん…。\
	dwavestop CH_VOICE	;XSH0276 
	gosub *blackout

	;--BGM;----------------------------------
	mov $_music,"05": gosub *out
	;--背景;----------------------------------
	mov $_bg,"BG013A"
	mov $debugstr,"ＢＧ：BG013A"
	gosub *out	;画面に出力
;ＢＧ：BG013A;廊下
	;--立ちキャラ;----------------------------------
	mov $_char,"TCD"
	mov $debugstr,"立ち：TCD "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC6004"
	mov $debugstr,"音声：CC6004"
	gosub *vo

	【明海】
	どうしたの？\
	dwavestop CH_VOICE	;CC6004

	【$g_hero】
	う、うわ！！べつになんでもないよ！
	い、行こうか。\

	そうだ、明海ちゃんと一緒だったんだっけ。
	ショックで忘れてたよ…。\
	gosub *clear_char

	【$g_hero】
	それにしても…すごかったな…今の…。
	びっくりしちゃった…。\

	でも、けっこうみんなエッチしてんだな…。
	ちょっとだけ安心したりして…。\

	いや、安心してる場合じゃないか。
	僕は他の場所に行くことにした。\
	gosub *blackout
	return
	;----------------------------------
;---SH02 END -----
