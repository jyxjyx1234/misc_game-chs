*D115	; ■ファイル開始のラベル
	mov $debugstr,"■D115" : gosub *debugout
;■■■「月光に濡れる教室で、僕は。」台本：■５日目：D115
;━━━━━━━━━━━━━━
;■５日目

	;--BGM;----------------------------------
	mov $_music,"01": gosub *out
	;--背景;----------------------------------
	mov $_bg,"BG001A"
	mov $debugstr,"ＢＧ：BG001A"
	mov %effect,4	;エフェクトを指定
	gosub *out	;画面に出力
	;-効果音;----------------------------------
	mov $_se,"ZSUZUME"
	mov $debugstr,"ＳＥ：ZSUZUME "
	gosub *se
;;主人公の部屋
;てきとーに語る
;さてと、丹羽との約束が

	【$g_hero】
	朝か…。ふぁああ…起きないと。\

	【$g_hero】
	えっと…ああそうだ。
	今日は、丹羽を迎えに行くんだっけ…。\

	僕は昨日の電話の内容を思い出していた。\

	【$g_hero】
	確か…体育館の裏手にいるって言ってたな。\
;きっと、体育倉庫あたりだ。

	【$g_hero】
	もう朝だし、丹羽も来てる頃かもな。\

	【$g_hero】
	警察に連絡して…兄さんにもお願いしないとな。\

	丹羽は来ているだろうか。
	きっと不安な一夜を過ごしたんだろう。\

	【$g_hero】
	なるべく早く行った方がいいな。うん。\

	朝早く行くと小夜子とも
	長く話ができるしな。\

	【$g_hero】
	なんて不謹慎だよな。
	丹羽の相談に乗らなくちゃならないのに。\
;●朝：自分の部屋：兄と
;真実と同じ

	僕はベッドから飛び起きて、寒さに
	バタバタと足踏みをしながら、制服に着替えた。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TLD"
	mov $debugstr,"立ち：TLD "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"YB9100"
	mov $debugstr,"音声：YB9100"
	gosub *vo

	【$g_heroの兄】
	おはよう…って、あ、もう起きてる。
	早いね。\
	dwavestop CH_VOICE	;YB9100

	【$g_hero】
	急がないといけないんだ。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TLA"
	mov $debugstr,"立ち：TLA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"YB9101"
	mov $debugstr,"音声：YB9101"
	gosub *vo

	【$g_heroの兄】
	もうじき卒業式だから？\
	dwavestop CH_VOICE	;YB9101

	【$g_hero】
	それもあるけど。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TLD"
	mov $debugstr,"立ち：TLD "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"YB9102"
	mov $debugstr,"音声：YB9102"
	gosub *vo

	【$g_heroの兄】
	他にも理由が？\
	dwavestop CH_VOICE	;YB9102

	【$g_hero】
	別に。気になるだけだよ。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TLC"
	mov $debugstr,"立ち：TLC "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"YB9103"
	mov $debugstr,"音声：YB9103"
	gosub *vo

	【$g_heroの兄】
	いいけどさ。
	もう死体見つけて来ちゃだめだよ。\
	dwavestop CH_VOICE	;YB9103

	【$g_hero】
	そうしないために行くんだよ。\
	gosub *blackout
;●朝：小夜子
;主人公（を装った香津実）に呼び出されて
;コーラス部の部室へ
	;--背景;----------------------------------
	mov $_bg,"BG008A"
	mov $debugstr,"ＢＧ：BG008A"
	gosub *out	;画面に出力
;ＢＧ：BG008A;小夜子の部屋
	;--立ちキャラ;----------------------------------
	mov $_char,"TDB"
	mov $debugstr,"立ち：TDB "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"DD11500"
	mov $debugstr,"音声：DD11500 "
	gosub *vo

	【小夜子】
	さてと行かなくちゃ。
	今日も先輩に会えると思うと元気でるな、うん。\
	dwavestop CH_VOICE	;DD11500 
	;-効果音;----------------------------------
	mov $_se,"ZTEL"
	mov $debugstr,"ＳＥ：ZTEL"
	gosub *se
	;--立ちキャラ;----------------------------------
	mov $_char,"TDD"
	mov $debugstr,"立ち：TDD "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"DD11501"
	mov $debugstr,"音声：DD11501 "
	gosub *vo

	【小夜子】
	あれ？　メール？　…誰からだろう？\
	dwavestop CH_VOICE	;DD11501 

	それは、登録してないアドレスだった。
	題名は「$g_fnameです」となっている。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TDC"
	mov $debugstr,"立ち：TDC "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"DD11502"
	mov $debugstr,"音声：DD11502 "
	gosub *vo

	【小夜子】
	先輩？　どうしたんだろ？
	携帯使えばいいのに…。\
	dwavestop CH_VOICE	;DD11502 
	;--立ちキャラ;----------------------------------
	mov $_char,"TDD"
	mov $debugstr,"立ち：TDD "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"DD11503"
	mov $debugstr,"音声：DD11503 "
	gosub *vo

	【小夜子】
	え？　丹羽君と話すのに私にも来て欲しい？
	体育倉庫に居るから？\
	dwavestop CH_VOICE	;DD11503 
	;--立ちキャラ;----------------------------------
	mov $_char,"TDL"
	mov $debugstr,"立ち：TDL "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"DD11504"
	mov $debugstr,"音声：DD11504 "
	gosub *vo

	【小夜子】
	大変！　急がなくっちゃ！！\
	dwavestop CH_VOICE	;DD11504 
	gosub *blackout

	return	;----------------------------------
