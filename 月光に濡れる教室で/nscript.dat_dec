	既に死んだ人を幸いだと言おう。
	更に生きていかなければならない人よりは幸いだ。\
	dwavestop CH_VOICE	;XE0000

	【$g_hero】
	菜摘先生？\

	なんだろ？　どこかで聞いたような。
	芝居めいたような、そんな言葉。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TEC"
	mov $debugstr,"立ち：TEC "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
