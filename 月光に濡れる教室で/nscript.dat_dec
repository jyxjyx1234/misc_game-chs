	mov $debugstr,"音声：XB0800"
	gosub *vo

	【矢崎】
	だが実際、警察の方はそう見ているようだよ。\
	dwavestop CH_VOICE	;XB0800
;BGM:喜

	【$g_hero】
	や、矢崎！！\

	;--BGM;----------------------------------
	mov $_music,"02": gosub *out
	;--立ちキャラ;----------------------------------
	mov $_char,"THB"
	mov $debugstr,"立ち：THB "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XB0801"
	mov $debugstr,"音声：XB0801"
	gosub *vo

	【矢崎】
	やあ。\
	dwavestop CH_VOICE	;XB0801

	【$g_hero】
	やあ、じゃないよ！いつの間に！\
	;--立ちキャラ;----------------------------------
	mov $_char,"THD"
	mov $debugstr,"立ち：THD "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XB0802"
	mov $debugstr,"音声：XB0802"
	gosub *vo

	【矢崎】
	ここは学生会室だろ？
	オレが居るのは当然のことだと思うが。\
	dwavestop CH_VOICE	;XB0802

	【$g_hero】
	今日は、みんな帰宅じゃなかったのか？\
	;--立ちキャラ;----------------------------------
	mov $_char,"THJ"
	mov $debugstr,"立ち：THJ "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XB0803"
	mov $debugstr,"音声：XB0803"
	gosub *vo

	【矢崎】
	トラブルがあった日こそ、上は苦労するものだよ。\
	dwavestop CH_VOICE	;XB0803

	【$g_hero】
	上ってさ…。\
	;--立ちキャラ;----------------------------------
	mov $_char,"THA"
	mov $debugstr,"立ち：THA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XD1000"
	mov $debugstr,"音声：XD1000"
	gosub *vo

	【矢崎】
	そちらは？　１年の…。\
	dwavestop CH_VOICE	;XD1000
	;--立ちキャラ;----------------------------------
	mov $_char,"TDA"
	mov $debugstr,"立ち：TDA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"DD1001"
	mov $debugstr,"音声：DD1001"
	gosub *vo

	【小夜子】
	１Ｃの芹沢小夜子です。\
	dwavestop CH_VOICE	;DD1001

	【$g_hero】
	コーラス部の後輩なんだ。\
	;--立ちキャラ;----------------------------------
	mov $_char,"THD"
	mov $debugstr,"立ち：THD "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XD1002"
	mov $debugstr,"音声：XD1002"
	gosub *vo

	【矢崎】
	なんだ、付き合ってるんじゃないんだ。\
	dwavestop CH_VOICE	;XD1002

	【$g_hero】
	ど、どうして、そういう話に！\
	;--立ちキャラ;----------------------------------
	mov $_char,"THI"
	mov $debugstr,"立ち：THI "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XD1003"
	mov $debugstr,"音声：XD1003"
	gosub *vo

	【矢崎】
	告白されたのかと思ったよ。
	あんな朝早くに誰もいない裏庭に居るなんて。\
	dwavestop CH_VOICE	;XD1003

	【$g_hero】
	そ、それは……。\

	事情なんて説明できるか。\
	;--立ちキャラ;----------------------------------
	mov $_char,"THI"
	mov $debugstr,"立ち：THI "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XB0811"
	mov $debugstr,"音声：XB0811"
	gosub *vo

	【矢崎】
	断った方が良いよ。この男、鈍感だし
	女の子の気持ちには気が付かないし。\
	dwavestop CH_VOICE	;XB0811

	【$g_hero】
	女の子の気持ちなんてわかるもんか。
	男なんだから。お前は解るわけ？\
	;--立ちキャラ;----------------------------------
	mov $_char,"THJ"
	mov $debugstr,"立ち：THJ "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XB0812"
	mov $debugstr,"音声：XB0812"
	gosub *vo

	【矢崎】
	これだよ。\
	dwavestop CH_VOICE	;XB0812
;;なぜなら、矢崎は女だからである。
	;--立ちキャラ;----------------------------------
