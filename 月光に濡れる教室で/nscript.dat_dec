	dwavestop CH_VOICE	;BOP0302 

	教室には、桜井　真実がいた。
	かっちりした三つ編みに眼鏡。\

	【$g_hero】
	掃除、よくしてるよね。
	好きなの？　掃除。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TBG"
	mov $debugstr,"立ち：TBG "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
