	gosub *out	;画面に出力
;ＢＧ：BG014A;校門

	【$g_hero】
	さてと…帰ろうかな。\
	;-効果音;----------------------------------
	mov $_se,"ZPIKO"
	mov $debugstr,"ＳＥ：ZPIKO "
	gosub *se
;ＳＥ：ZMYMAIL;自分携帯メールの音

	【$g_hero】
	ん？　メールか、誰だろう……。\

	僕は携帯をポケットから取り出した。\

	【$g_hero】
	先輩だ……。\

	【$g_hero】
	『申し訳ないけど、家に来てください』
	…か。あれ？　もう１行あるな……。\

	【$g_hero】
	『外で、待ってます』
	……別に待ってなくてもいいのに。\

	帰り道なんだし…ちゃんと行く気でいたのに。
	信用ないんだな、僕。\

	信用も何も…僕たち知り合いはじめた
	ばかりなんだけどね。\

	今の僕と、今の君を。\

	そりゃ、昔から知っている…名前も声も姿も。
	でも、ただそれだけだ。\

	今の僕だったら、
	きっと育巳の方がよく知ってるし…。\

	先輩は…矢崎の方が知ってるかもしれない。\

	僕は…先輩のことが知りたいな。
	もっともっと知りたいよ。\

	それってさ…好きってことじゃないのかな。
	きっと…そういう事だよな。\
;もうちょい書き足し。
;それからもう少し、伏線っぽいのを。

	【$g_hero】
	早く行こう。うん…行こう！\
	;-効果音;----------------------------------
	mov $_se,"ZRUN"
	mov $debugstr,"ＳＥ：ZRUN"
	gosub *se

	僕は、校門から走り出した。\
	gosub *sestop
	gosub *blackout

	;--BGM;----------------------------------
