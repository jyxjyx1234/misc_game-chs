	どうかしましたか、先輩？\
	dwavestop CH_VOICE	;DOP4507 

	【$g_hero】
	いや、なんでもない。
	すこし歌おうかな、伴奏してくれる？\
	;--立ちキャラ;----------------------------------
	mov $_char,"TDB"
	mov $debugstr,"立ち：TDB "
	gosub	*out	;画面に出力
