	mov $_se,"ZDOORSLIDE"
	mov $debugstr,"ＳＥ：ZDOORSLIDE"
	gosub *se

	ガラリと、保健室のドアが開く音がして
	背広を着た見慣れない中年の男と
	菜摘先生が現れた。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TEC"
	mov $debugstr,"立ち：TEC "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XB0500"
	mov $debugstr,"音声：XB0500"
	gosub *vo

	【菜摘先生】
	$g_fname君、
	警察の方がお話を聞きたいそうなんだけど…。\
	dwavestop CH_VOICE	;XB0500

	【$g_hero】
	あ、はい…。\
	gosub *clear_char

	僕は頷いて、保健室の隅のテーブルで
	警察のひとと話をした。\

	保健室には、僕と真実と、先生たち二人。
	それと警察の人しか居ない。\

	警察のひとは、思ったより普通のサラリーマン
	みたいな、話しやすい人だった。\

	事務的に、ちゃんと話をしてくれたので
	自分でもこんがらがりそうな事を説明できた。\

	事件が起きる前には何も気が付かなかった。
	死んだひとは、まったく知らない。\

	真実と一緒に裏庭に行った理由はと
	聞かれたときには、思わず顔を赤らめてしまった。
	そんな、素直に言えるわけがない。\

	そうしたら、刑事さんは何か勘違いしたのか
	いいね、若いひとはと、にこやかに笑った。\

	なんだか、人を騙しているみたいで
	気が引けた。つくづく小心者だ。僕は。\

	じきに真実も起きてきて
	僕と同じようなことを聞かれ、
	僕と同じように返事をした。\

	僕の方も、気になって、すこし話を聞いてみた。\

	警察のひとは、すんなり教えてくれた。
	亡くなったのは小林　郁美。３Ｂの学生。\

	やっぱり、彼女が自殺ということは間違いない
	そうで、遺書もちゃんとあったそうだ。\

	【$g_hero】
	そっか、やっぱり自殺だったんだ…。\
	gosub *blackout

	;--BGM;----------------------------------
	mov $_music,"04": gosub *out
	;--背景;----------------------------------
	mov $_bg,"BG012A"
	mov $debugstr,"ＢＧ：BG012A"
	gosub *out	;画面に出力

