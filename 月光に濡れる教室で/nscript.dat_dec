;■■■「月光に濡れる教室で、僕は。」台本：●警察の事情聴取後：D06
;━━━━━━━━━━━━━━
;●警察の事情聴取後

	;--BGM;----------------------------------
	mov $_music,"06": gosub *out
;BGM:迷
	;--背景;----------------------------------
	mov $_bg,"BG012A"
	mov $debugstr,"ＢＧ：BG012A"
	gosub *out	;画面に出力
;ＢＧ：BG012A;保健室
	;-効果音;----------------------------------
	mov $_se,"ZDOORSLIDE"
	mov $debugstr,"ＳＥ：ZDOORSLIDE"
	gosub *se

	ガラリと、保健室のドアが開く音がして
	背広を着た見慣れない中年の男と
	菜摘先生が現れた。\
;BGM:迷
	;--立ちキャラ;----------------------------------
	mov $_char,"TEC"
	mov $debugstr,"立ち：TEC "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XB0500"
	mov $debugstr,"音声：XB0500"
	gosub *vo

	【菜摘先生】
	$g_fname君、
	警察の方がお話を聞きたいそうなんだけど…。\
	dwavestop CH_VOICE	;XB0500

	【$g_hero】
	あ、はい…。\
	gosub *clear_char

	僕は頷いて、保健室の隅のテーブルで
	警察のひとと話をした。\

	保健室には、僕と小夜子と、先生たち二人。
	それと警察の人しか居ない。\

	警察のひとは、思ったより普通のサラリーマン
	みたいな、話しやすい人だった。\

	事務的に、ちゃんと話をしてくれたので
	自分でもこんがらがりそうな事を説明できた。\

	事件が起きる前には何も気が付かなかった。
	死んだひとは、まったく知らない。\

	小夜子と一緒に裏庭に行った理由はと
	聞かれたときには、思わず顔を赤らめてしまった。
	そんな、素直に言えるわけがない。\

	そうしたら、刑事さんは何か勘違いしたのか
	いいね、若いひとはと、にこやかに笑った。\

	なんだか、人を騙しているみたいで
	気が引けた。つくづく小心者だ。僕は。\

	じきに小夜子も起きてきて
	僕と同じようなことを聞かれ、
	僕と同じように返事をした。\

	僕の方も、気になって、すこし話を聞いてみた。\

	【$g_hero】
	あの、亡くなったひとは…。\

	警察のひとは、すんなり教えてくれた。
	亡くなったのは１Ｃの男子学生。
	大貫 大輔（おおぬき　だいすけ）。\

	【$g_hero】
	小夜子と同じクラスなんだ。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TDC"
	mov $debugstr,"立ち：TDC "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"DD0600"
	mov $debugstr,"音声：DD0600"
	gosub *vo

	【小夜子】
	大貫君…。\
	dwavestop CH_VOICE	;DD0600
	gosub *clear_char

	屋上に靴がきちんと揃えてあったことから
