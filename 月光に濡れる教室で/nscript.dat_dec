	mov $debugstr,"立ち：TCJ "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC0312"
	mov $debugstr,"音声：CC0312"
	gosub *vo

	【明海】
	キミと、これ以上気まずくなりたくなかったのよ。
	だから…それに…。\
	dwavestop CH_VOICE	;CC0312
	;--立ちキャラ;----------------------------------
	mov $_char,"TCG"
	mov $debugstr,"立ち：TCG "
	gosub	*out	;画面に出力

	先輩が、ほんのりと頬を染めた。\

	【$g_hero】
	………………。\

	昨日あんな事があったばかりなのに。
	どうしてそんな顔ができるんだろう。\

	僕は、不思議な生き物を見ている気分だった。
	女の人ってよくわからないな…ホントに。\

	ホントはそんな言葉で片づけちゃいけない
	んだろうけどさ。\
	gosub *clear_char

	結局そのあとに会話はなくなってしまった。
	いつも通りのぎこちない…だけどどことなく違う。
	そんな雰囲気で。\

	そうして僕たちは、何となく何もかもを
	うやむやにしながら、学園へと向かった。\
	gosub *blackout

