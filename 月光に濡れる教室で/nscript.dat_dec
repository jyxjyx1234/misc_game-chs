	【$g_hero】
	服。着ないと、寒いよ。\
	;-音声;----------------------------------
	mov $_voice,"CC8001"
	mov $debugstr,"音声：CC8001"
	gosub *vo

	【明海】
	あ…あ、ええ…そ…そうね。\
	dwavestop CH_VOICE	;CC8001

	僕らは体をぬぐって、身支度を整えた。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCG"
	mov $debugstr,"立ち：TCG "
	gosub	*out	;画面に出力

	【明海】
	…………………。\

	【$g_hero】
