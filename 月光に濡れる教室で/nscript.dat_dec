	mov $debugstr,"音声：YE2305"
	gosub *vo

	【$g_heroの兄】
	菜摘先生、
	実習期間中はすごいドジばっかりしてたよ。\
	dwavestop CH_VOICE	;YE2305

	【$g_hero】
