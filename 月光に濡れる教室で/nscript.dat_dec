*B01	; ■ファイル開始のラベル
	mov $debugstr,"■B01 " : gosub *debugout
;■■■「月光に濡れる教室で、僕は。」台本：■１日目：B01
;━━━━━━━━━━━━━━
;■１日目
;●朝
	gosub *musicstop
;ＢＧ：BG001A;主人公の部屋
;フラッシュバック。モノクロで。
	;--背景;----------------------------------
	mov $_bg,"WHITE"
	mov $debugstr,"ＢＧ：WHITE "
	mov %effect,2	;エフェクトを指定
	gosub *out	;画面に出力
	gosub *mono_on
	;-- イベントCG;----------------------------------
	mov $_cg,"B01A"
	mov $debugstr,"ＣＧ：B01A"
	mov	%effect,2	;エフェクトを指定
	gosub *cgout	;イベントＣＧ
;眼鏡面倒だからB01Aだけ。

	【$g_hero】
	真実！！\

	そうだ、僕は…。僕は真実を…。\

	【$g_hero】
	そうだ。真実を犯したんだ…。\
	gosub *mono_off
	gosub *blackout

	;--BGM;----------------------------------
	mov $_music,"04": gosub *out
;BGM:哀
	;--背景;----------------------------------
	mov $_bg,"BG001A"
	mov $debugstr,"ＢＧ：BG001A"
	gosub *out	;画面に出力

	僕はすとんとベッドに座り込んだ。
	体中の力が抜けてるみたいだった。\

	真実を犯した。
	言葉にすると、やけにリアリティがあって
	僕の身体の中で何かがぞくりと喚いた。\

	絶対に後悔するってわかっているのに
	僕は快楽に流された。溺れた。\

	【$g_hero】
	……本当かよ…。\

	そんな言葉を言う自分が情けなかった。
	頭を抱えて、ベッドの上につっぷした。\

	悪意も覚悟もなにもなしに、
	僕は真実を犯したんだ。\

	【$g_hero】
	…どうすりゃいいんだよ…。\

	被害者は、まちがいようもなく真実だ。
	そして、僕が加害者だ。\

	どうすればいいかなんて、わからないし。
	どうしようもないけれど。\

	少なくとも授業を休んでも
	意味がないことぐらいはわかる。\

	【$g_hero】
	くそっ！ああ、もう僕ってヤツは！\

	とりあえず風呂に入ってメシを食べよう。
	それで、真実に会わなくちゃ。\

	僕はそう考えて、バスタオルを持って
	部屋を出た。\
	gosub *blackout

	return	;----------------------------------
;---B01  END -----
