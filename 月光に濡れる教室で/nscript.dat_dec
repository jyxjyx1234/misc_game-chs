;━━━━━━━━━━━━━━
;●小夜子：レイプ未遂「いや、思い出したくない！」
;上のシーンを思い出したとこ
	gosub *musicstop
	gosub *whiteout

	;--BGM;----------------------------------
	mov $_music,"03": gosub *out
	;--背景;----------------------------------
