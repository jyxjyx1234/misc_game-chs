*BAD_B13	; ■ファイル開始のラベル
	mov $debugstr,"■BAD_B13 " : gosub *debugout
;汎用バッドＥＤ。
;呼び出されてプシュッと死ぬ。

	;--BGM;----------------------------------
	mov $_music,"01": gosub *out
	;-効果音;----------------------------------
	mov $_se,"ZDOORC"
	mov $debugstr,"ＳＥ：ZDOORC"
	gosub *se
;BGM:さりげない日常
	;--背景;----------------------------------
	mov $_bg,"BG033B"
	mov $debugstr,"ＢＧ：BG033B"
	gosub *out	;画面に出力
;ＢＧ：BG033A;主人公の家の玄関

	【$g_hero】
	ただいま…って、あれ？
	なんだ、兄さんいないのか。\

	玄関にメモが置いてある。
	僕はそれを手にとって読んだ、\

	【$g_hero】
	「今晩は、おたのしみです。
	　帰ってこないからね。兄上様より」\

	【$g_hero】
	………なんだよ、兄上様ってのは。
	いい気なもんだよな。\

	弟があんな目にあったってのにさ。
	まあ、いいか。根掘り葉掘り聞かれるよりも。\

	僕は、メモを元に戻すと
	自分の部屋に向かった。\
;場所：自分の部屋
;●携帯で呼び出し。
	;--背景;----------------------------------
	mov $_bg,"BG001B"
	mov $debugstr,"ＢＧ：BG001B"
	gosub *out	;画面に出力
;;主人公の部屋

	【$g_hero】
	ふう…。\

	ベッドにばたんと倒れ込む。\

	【$g_hero】
	今日は…なんだかな…。
	いろいろなことがあったな…。\

	朝の事件…。
	それと「天使」のこと。\

	【$g_hero】
	…なんか…やだな…。
	いやなことばっかり起きるな。\
	;-効果音;----------------------------------
	mov $_se,"ZKEITEL"
	mov $debugstr,"ＳＥ：ZKEITEL "
	gosub *se

	【$g_hero】
	あれ？　電話？\
	gosub *sestop

	携帯のディスプレイを見ると
	知らない相手からだった。\

	【$g_hero】
	なんだよ、広告メールか…
	えっ！？\

	;--BGM;----------------------------------
	mov $_music,"09": gosub *out
;BGM:迷

	メールには
	「君の罪を知る者より」
	と書かれていた。\

	まさか、これって！？\

	僕はあわててメールを読んだ。\

	「月光に濡れる教室で犯した罪を知っている」\

	【$g_hero】
	…これって…真実と…僕がしたことか…？\

	昨晩の真実とのセックス。
	あれを知っている…？　何故！？\

	「懺悔をしたいのなら、学園の屋上にて待つ」\

	【$g_hero】
	どういうことなんだ…？\

	僕はメールを見ながら首を傾げた。\

	【$g_hero】
	脅し…ってことなのかな…。\

	わざわざ相手から連絡をとってきたんだ。
	何かしら、僕に含みがあるにちがいない。\

	真実に電話したほうがいいだろうか？
	その考えも頭をよぎったが、
	やっぱり止めることにした。\

	もう夜だし、それに何かあったら大変だ。\

	【$g_hero】
	真実…怯えるだろうしな…。\

	あの夜の出来事を他人が知ってるなんて
	真実が知ったら、きっと傷つくだろうし。\

	【$g_hero】
	うん、とにかく行ってみよう。\

	僕は身支度をして学園に向かった。\
;●殺されるシーン
	;--背景;----------------------------------
	mov $_bg,"BG025B"
	mov $debugstr,"ＢＧ：BG025B"
	gosub *out	;画面に出力
;;屋上
	;-効果音;----------------------------------
	mov $_se,"ZKAZE2"
	mov $debugstr,"ＳＥ：ZKAZE2"
	gosub *se

	しばらくして、僕は校舎の屋上に来た。
	風が強くて、ひどく寒かった。\

	【$g_hero】
	すごい風だな…。\

	僕は用心深くあたりを伺った。
	だが、人影はどこにも見えない。\

	【$g_hero】
	隠れてる…のかな…？\

	僕は、屋上をうろうろ回ってみた。
	けれども、誰も見あたらない。\

	【$g_hero】
	くそっ、いたずらだったのかな…。
	ん！？　なんだ、あれ？\

	何か、ちいさくて白いものが、
	フェンスの手前に何か置いてある。\

	僕は、フェンスの間近に寄って
	その白いものを手に取った。\
	;--背景;----------------------------------
	mov $_bg,"ANGEL"
	mov $debugstr,"ＢＧ：ANGEL "
	gosub *out	;画面に出力

	【$g_hero】
	天使のカード！？
	これって、昨日のと同じだ。\

	僕は、月明かりの下でそれを見つめた。
	まちがいなく、昨日のカードと同じものだった。\

	僕はカードを開いた。\

	【$g_hero】
	…何か書いてあるな…。\

	「すべての罪が浄化される場所へ
	　安らかに旅立ちたまえ」\
	;--背景;----------------------------------
	mov $_bg,"BG025B"
	mov $debugstr,"ＢＧ：BG025B"
	gosub *out	;画面に出力

	【$g_hero】
	妙な文章だな…。\
	gosub *musicstop

	その時だった。\
	;-効果音;----------------------------------
	mov $_se,"ZHIT2"
	mov $debugstr,"ＳＥ：ZHIT2 "
	gosub *se
	;--背景;----------------------------------
	mov $_bg,"WHITE"
	mov $debugstr,"ＢＧ：WHITE "
	mov %effect,1	;エフェクトを指定
	gosub *out	;画面に出力
	;--背景;----------------------------------
	mov $_bg,"BG025B"
	mov $debugstr,"ＢＧ：BG025B"
	gosub *out	;画面に出力
	gosub *GURAGURA	;GURAGURAを呼び出し

	ガンッ！\
	;-効果音;----------------------------------
	mov $_se,"ZKAZE"
	mov $debugstr,"ＳＥ：ZKAZE "
	gosub *se

	【$g_hero】
	うっ…！\

	頭がぐらぐらして、ずきずきと傷む。
	僕の後頭部を誰かが殴ったのだ。\

	【$g_hero】
	くそっ…！　誰だ！\

	何度も瞬きをする。目がかすむ。
	足に力が入らない。\
	;-効果音;----------------------------------
	mov $_se,"ZHIT2"
	mov $debugstr,"ＳＥ：ZHIT2 "
	gosub *se
	;--背景;----------------------------------
	mov $_bg,"WHITE"
	mov $debugstr,"ＢＧ：WHITE "
	mov %effect,1	;エフェクトを指定
	gosub *out	;画面に出力
	;--背景;----------------------------------
	mov $_bg,"BG025B"
	mov $debugstr,"ＢＧ：BG025B"
	gosub *out	;画面に出力
	gosub *GURAGURA	;GURAGURAを呼び出し

	ガンッ！\

	【$g_hero】
	なんで…僕を…。
	くっ…！！\

	身体がよろけて、僕はフェンスにしがみついた。
	その途端、フェンスが妙な音をたてた。\

	【$g_hero】
	え…！？\
	gosub *GURA	;GURAを呼び出し

	ぐらり。\

	【$g_hero】
	あ…！？\

	フェンスは何もない空中に倒れ込み、
	そして、僕の身体は空に放り出された。\
	;-効果音;----------------------------------
	mov $_se,"ZRAKKA"
	mov $debugstr,"ＳＥ：ZRAKKA"
	gosub *se
	gosub *blackout

	【$g_hero】
	あぁあああぁあああああああぁぁああああ
	あぁあああぁああああぁぁぁあああ！！！！\
	;-効果音;----------------------------------
	mov $_se,"ZDOSA"
	mov $debugstr,"ＳＥ：ZDOSA "
	gosub *se

	ドサッ！\
	gosub *anime_bloodB	;anime_bloodBを呼び出し
;地面の血がにじむ＜ここもアニメにしてほしいなぁ…。
	gosub *blackout

	誰が、どうして、僕を、こんな目に。\

	僕には何も解らなかった。\
	gosub *blackout
	;--背景;----------------------------------
	mov $_bg,"MOONA01"
	mov $debugstr,"ＢＧ：MOONA01 "
	mov %effect,4	;エフェクトを指定
	gosub *out	;画面に出力

	僕が最後に見たのは、
	夜空に映る大きな月だけだった。\
	gosub *blackout
;暗転

	mov %ending,BAD_END
	return	;----------------------------------
