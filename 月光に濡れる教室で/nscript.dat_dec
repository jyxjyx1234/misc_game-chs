	gosub *out	;画面に出力
;主人公の部屋
	;--立ちキャラ;----------------------------------
	mov $_char,"TLB"
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"YB2800" : gosub *vo

	【$g_heroの兄】
	おーい、ガッコ行かないと
	遅刻するよー。\
	dwavestop CH_VOICE	;YB2800

	【$g_hero】
	わかってるって！うるさいな！！\
	;--立ちキャラ;----------------------------------
	mov $_char,"TLC"
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"YB2801" : gosub *vo

	【$g_heroの兄】
	何だよ、せっかく起こしに来てあげたのに。
	やさしいお兄様に感謝してよ。\
	dwavestop CH_VOICE	;YB2801

	【$g_hero】
	…ったく。いつもはしないくせに
	どうして、こういうときばっかり…。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TLB"
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"YB2802" : gosub *vo

	【$g_heroの兄】
	だって大学もう春休みでヒマなんだもん。
	そうだ、さぼってお兄ちゃんと遊ばない？\
	dwavestop CH_VOICE	;YB2802

	【$g_hero】
	…弟で遊ぶなよ。
	彼女のとこにでも行けばいいだろ？\
	;--立ちキャラ;----------------------------------
	mov $_char,"TLC"
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"YB2803" : gosub *vo

	【$g_heroの兄】
	えー。\
	dwavestop CH_VOICE	;YB2803

	【$g_hero】
	なんで、えー！なんだよ。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TLC"
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"YB2804" : gosub *vo

	【$g_heroの兄】
	自分で決めるとさー。どこの子のとこに
	行こうかで悩むんだよねー。\
	dwavestop CH_VOICE	;YB2804

	女が居すぎて、相手決められないって！
	これが本気だから、たちが悪いよな！\

	頭が良くて、礼儀正しいからって
	品行方正なわけじゃないっての！\

	【$g_hero】
	つっくづくイヤなヤツ！
	一日交替で全部回ってろ！！\
	;--立ちキャラ;----------------------------------
	mov $_char,"TLD"
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"YB2805" : gosub *vo

	【$g_heroの兄】
	そうすると春休み終わっちゃうよー。\
	dwavestop CH_VOICE	;YB2805

	【$g_hero】
	………………………。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TLB"
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"YB2806" : gosub *vo

	【$g_heroの兄】
	どうしたの？なんかしゃべってよー
	さみしいよー。\
	dwavestop CH_VOICE	;YB2806

	【$g_hero】
	ああ、もう！どうでもいいから
	部屋からでてけ！\

	return	;----------------------------------
;---B28 END -----
