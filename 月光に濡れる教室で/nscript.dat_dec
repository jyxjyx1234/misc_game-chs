;ＢＧ：BG032A;公園

	公園に向かうと、
	真実はいつものようにベンチに座っていた。
	小作りな顔を上に向けて、空を見ている。\

	【$g_hero】
	真実！\

	名前を呼んで手をふると、気が付いたらしく
	僕の方を見て、そっと笑った。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TBA"
	mov $debugstr,"立ち：TBA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"BB8200"
	mov $debugstr,"音声：BB8200"
	gosub *vo

	【真実】
	おはよう。\
	dwavestop CH_VOICE	;BB8200

	【$g_hero】
	田口の手紙って？\
	;--立ちキャラ;----------------------------------
	mov $_char,"TBC"
	mov $debugstr,"立ち：TBC "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"BB8201"
	mov $debugstr,"音声：BB8201"
	gosub *vo

	【真実】
	これ。\
	dwavestop CH_VOICE	;BB8201

	真実はコートのポケットから封筒を出した。
	そっけない長４の茶封筒だった。\
	gosub *clear_char

	中に入っているのはルーズリーフが１枚。
	鉛筆書きの読みづらい字で
	何か、びっちりと書かれている。\

	それから、写真が一枚。\

	【$g_hero】
	これは……！！\
	;-- イベントCG;----------------------------------
	mov $_cg,"E09A"
	mov $debugstr,"ＣＧ：E09A"
	gosub *cgout	;イベントＣＧ

	その写真を見た僕は息を飲んだ。
	そして大急ぎで田口の手紙を読んだ。\

	手紙は読みづらかった。
	田口の主観が入り交じっている妙な文章だし
	そもそも字が汚くて読みづらい。\

	【$g_hero】
	うちのクラスの福崎と…。\

	どうも育巳とセックスしているところを
	写真に撮った。公開されたくなければ
	オレのいうことを聞けという内容だった。\

	【$g_hero】
	なんか話がつながらないな…
	真実、育巳と付き合ってたわけじゃないし。\
	;-音声;----------------------------------
	mov $_voice,"BB8202"
	mov $debugstr,"音声：BB8202"
	gosub *vo

	【真実】
	ここ。\
	dwavestop CH_VOICE	;BB8202

	真実は白いほそい指で、
	ルーズリーフの上の方を指さした。\

	【$g_hero】
	ん…？　小林　郁美様…。
	これって…。\
	;-音声;----------------------------------
	mov $_voice,"BB8203"
	mov $debugstr,"音声：BB8203"
	gosub *vo

	【真実】
	どうもね、わたしへの手紙と
	間違えて入れたみたい。\
	dwavestop CH_VOICE	;BB8203

	田口……。
	なんだか僕は馬鹿馬鹿しくなった。\

	あれだけ、僕と真実が探し回って悩みまくってた
	手がかりが、こんな風に偶然みたいに手に入る。\

	けど。\

	【$g_hero】
	ちょ、ちょ、ちょっと待ってくれよ！
	それじゃ、小林先輩と付き合ってたのって！\
	;-音声;----------------------------------
	mov $_voice,"BB8204"
	mov $debugstr,"音声：BB8204"
	gosub *vo

	【真実】
	福崎君なんだと思う。\
	dwavestop CH_VOICE	;BB8204
	gosub *blackout

	僕の頭の中をいろんなものが
	いっぺんに駆けめぐった。\

	自殺してしまった小林先輩。
	付き合ってたのは育巳。
	殺されたかもしれない、田口。\

	【$g_hero】
	……………………………。\
	gosub *mono_on
	;--背景;----------------------------------
	mov $_bg,"BG001B"
	mov $debugstr,"ＢＧ：BG001B"
	gosub *out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"YB2302"
	mov $debugstr,"音声：YB2302"
	gosub *vo

	【育巳】
	自分が信じたことのために
	全てを賭けるのは正しいと思うか？\
	dwavestop CH_VOICE	;YB2302

	【$g_hero】
	あれって、まさか。\

	田口のこと……。
	……育巳がやったのか？\
	;-音声;----------------------------------
	mov $_voice,"YB8704"
	mov $debugstr,"音声：YB8704"
	gosub *vo

	【育巳】
	オレも…そうできてれば…違ったのかな。\
	dwavestop CH_VOICE	;YB8704

	【$g_hero】
	…昨日の電話…。\

	なんで、昨日、わざわざ僕に電話してきた？\
	;-音声;----------------------------------
	mov $_voice,"YB8705"
	mov $debugstr,"音声：YB8705"
	gosub *vo

	【育巳】
	いや。なんでもない。
	なんにしろ、明日で、全部終わりだ。\
	dwavestop CH_VOICE	;YB8705

	【$g_hero】
	終わりって、終わりって、まさか…！\
	gosub *mono_off
	;--背景;----------------------------------
	mov $_bg,"BG032A"
	mov $debugstr,"ＢＧ：BG032A"
	gosub *out	;画面に出力
;;公園

	僕はあわてて立ち上がった。冗談じゃない。
	いや、本当に、十中八九育巳のヤツは…。\
