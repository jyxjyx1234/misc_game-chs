	mov $_voice,"CC1702"
	mov $debugstr,"音声：CC1702"
	gosub *vo

	【明海】
	ごめんなさい…。\
	dwavestop CH_VOICE	;CC1702

	…だからさ。あやまらないでよ。
	どうして先輩がそんなに申し訳なさそうに
	するんだよ。\

	【$g_hero】
	…謝らなくて、いいからさ。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCI"
	mov $debugstr,"立ち：TCI "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC1703"
	mov $debugstr,"音声：CC1703"
	gosub *vo

	【明海】
	でも…私から言い出したことなのに。\
	dwavestop CH_VOICE	;CC1703

	【$g_hero】
	どちらが先に言い出したかなんて、問題じゃない
	よ。…多分。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCD"
	mov $debugstr,"立ち：TCD "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC1704"
	mov $debugstr,"音声：CC1704"
	gosub *vo

	【明海】
	そうかしら？\
	dwavestop CH_VOICE	;CC1704

	【$g_hero】
	そうだよ。\

	【$g_hero】
	僕がトロトロしていたから、先輩が先に言って
	くれた。それだけだよ。\

	…ていうか、どうしてこんな話になってるんだ？\

	先輩があやまると、僕は自分があやまらなくちゃ
	ならないことを思い出す。\

	…昨日の夜のことを思い出す。
	先輩は、構わないって言っていたけど。\

	僕はちゃんとあやまらなくちゃいけないと
	思うんだ。\

	このままじゃ、ずるずると日常を
	つづけてしまいたくなる。\

	だって先輩はやさしいし。
	構わないって言ってくれたし。\

	でも…。
	多分それじゃいけないんだ。\

	けれど僕は、また違う話題を振ってしまう。\

	【$g_hero】
	先輩、カードは？\
