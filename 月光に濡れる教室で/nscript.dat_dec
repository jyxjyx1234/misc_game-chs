*OP51	; ■ファイル開始のラベル
	mov $debugstr,"■OP51" : gosub *debugout
;■■■「月光に濡れる教室で、僕は。」台本：●ノートをとりにいく。：OP51
;━━━━━━━━━━━━━━
;●ノートをとりにいく。

	;--BGM;----------------------------------
	mov $_music,"01": gosub *out
;BGM:迷
	;--背景;----------------------------------
	mov $_bg,"BG014B"
	mov $debugstr,"ＢＧ：BG014B"
	gosub *out	;画面に出力
;ＢＧ：BG014A;校門

	【$g_hero】
	うわ、もう真っ暗だな…。\

	にしても…あのノート…。見られたのかなぁ…。
	ああ…どうしよう。はずかしい…。\

	【$g_hero】
	誰なんだろ…。
	電話してきたひと…。\

	【$g_hero】
	…ところで、校門閉まってるんだけど…。
	まいったな…。\

	ワケ説明していれてもらうのもな…。\

	職員室の電気はもう全部消えていた。
	帰るの、はやいなぁ。まあこの時期は
	部活もないしな…。\

	とすると、どうしようか。\

	【$g_hero】
	あ、今日あいつらに教えてもらったとこ！\

	僕は学園の裏手にある公園にまわり、
	校内にもぐりこんだ。\
	gosub *blackout

	return	;----------------------------------
;---OP51 END -----
