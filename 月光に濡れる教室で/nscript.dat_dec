	mov $debugstr,"音声：CC4403"
	gosub *vo

	【明海】
	平気よ、だって…今日は対処法があるもの。\
	dwavestop CH_VOICE	;CC4403

	【$g_hero】
	そ…そうだね…早めに来て準備すれば
	きっと平気だ。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCA"
	mov $debugstr,"立ち：TCA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC4404"
	mov $debugstr,"音声：CC4404"
	gosub *vo

	【明海】
	ええ…だから…。\
	dwavestop CH_VOICE	;CC4404

	【$g_hero】
	うん…じゃあ…返事するよ？\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCG"
	mov $debugstr,"立ち：TCG "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC4405"
	mov $debugstr,"音声：CC4405"
	gosub *vo

	【明海】
	………………ええ。\
	dwavestop CH_VOICE	;CC4405

	先輩がうつむいて頬を染める。
	…そんな風にされると、僕も照れるじゃないか。\

	ああ、もう！！
	しっかりしろって！！\

	これは、「天使」に怪しまれないための
	カモフラージュなんだから！\

	もう…先輩と、あんなスゴイことしたり
	しないんだから…。\

	スゴイことか……。
	…………。なんて考えてる場合じゃなくて！\

	僕は、焦る指をごまかすために、なるべく
	ゆっくりとボタンを押した。\

	【$g_hero】
	………………終わったよ。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCA"
	mov $debugstr,"立ち：TCA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC4406"
	mov $debugstr,"音声：CC4406"
	gosub *vo

	【明海】
	そう…じゃあ帰りましょうか。\
	dwavestop CH_VOICE	;CC4406

	【$g_hero】
	そうだね。\

	ここはイヤなことを思い出す。
	決して、長居したい場所じゃない。\

	僕たちは屋上から出て行った。\
	gosub *blackout

	return	;----------------------------------
