	mov $debugstr,"■B11 " : gosub *debugout
;■■■「月光に濡れる教室で、僕は。」台本：●教室で育巳と：B11
;━━━━━━━━━━━━━━
;●教室で育巳と

	;--BGM;----------------------------------
	mov $_music,"02": gosub *out
	;--背景;----------------------------------
	mov $_bg,"BG009A"
	mov $debugstr,"ＢＧ：BG009A"
	gosub *out	;画面に出力
;BGM:喜

	教室に戻ると、まだぽつりぽつりと
	何人か学生が残っていた。\

	みんな集まって話をしている。
	きっと今朝の自殺のことなんだろう。\

	もしかして、僕らのことを知っているのか。
	ひそひそと話し声が高くなる。
	指を指すやつもいる。\

	【$g_hero】
	……………。\

	なんだか、すごく不快だった。
	言いたいことがあるならハッキリ言えよ。くそ。\

	僕の知らないところで、僕の予想しないところで
	僕が意図しないところで、勝手に進んでる。\

	世の中なんてそんなものかもしれないけど
	すごく、すごく、そんなのがイヤだった。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TJA"
	mov $debugstr,"立ち：TJA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"YB1100"
	mov $debugstr,"音声：YB1100"
	gosub *vo

	【育巳】
	よう、おかえり。お二人さん。\
	dwavestop CH_VOICE	;YB1100

	【$g_hero】
	育巳。\

	明るい声でわらって片手をあげた育巳が、
	いつもと同じで、ものすごくほっとした。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TJB"
	mov $debugstr,"立ち：TJB "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"YB1101"
	mov $debugstr,"音声：YB1101"
	gosub *vo

	【育巳】
	メシ食った？パンあるけど食う？
	桜井さんも。\
	dwavestop CH_VOICE	;YB1101

	といって取り出したのは、小栗屋の紙袋だった。
	しかもレアで有名な「黄金の栗」だ。\

	ちなみに栗の形をしていて、中に自家製
	カスタードクリームが入っているパンだ。\

	もしかして、わざわざ待っててくれたのかな。
	しかも、これ買ってきてくれてさ。\

	【$g_hero】
	んじゃ、ちょっと食べようかな。\

	目頭がちょっと熱い。
	くそっ、育巳のヤツ、泣かせるじゃんかよ。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TJA"
	mov $debugstr,"立ち：TJA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"YB1102"
	mov $debugstr,"音声：YB1102"
	gosub *vo

	【育巳】
	よかった。桜井さんも。ほら。
	飲み物もあるぜ。\
	dwavestop CH_VOICE	;YB1102
	;--立ちキャラ;----------------------------------
	mov $_char,"TBC"
	mov $debugstr,"立ち：TBC "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"BB1103"
	mov $debugstr,"音声：BB1103"
	gosub *vo

	【真実】
	あ、ありがとうございます。\
	dwavestop CH_VOICE	;BB1103
	gosub *clear_char

	さすがに昼間何もたべてないから
	ぺこぺこで、小栗屋のパンが美味かった。\

	あんなことがあっても、人間
	お腹は空くし、飯は食うんだな。\

	そんなことをぼんやり思いながら
	僕は、パンを食べた。
	真実はもそもそと口に運んでいる。\

	育巳は明日からの時間割について
	僕たちに説明してくれた。\

	そのときも事件のことは極力
	言わないようにしてくれてるのがわかる。\

	育巳、おまえ、こんないいヤツだったのかよ。
	ああ…人間、窮地に立ったときにわかるよな。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TJD"
	mov $debugstr,"立ち：TJD "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"YB1104"
	mov $debugstr,"音声：YB1104"
	gosub *vo

	【育巳】
	ところでお前さ。いつのまに桜井と？
	告白でもしたのか？\
	dwavestop CH_VOICE	;YB1104

	笑いながら、そっと僕に尋ねてくる。\

	【$g_hero】
	ち、ちがうよ。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TJB"
	mov $debugstr,"立ち：TJB "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"YB1105"
	mov $debugstr,"音声：YB1105"
	gosub *vo

	【育巳】
	あはは、照れるなよ。\
	dwavestop CH_VOICE	;YB1105

	return	;----------------------------------
