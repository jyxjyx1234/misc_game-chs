; MPX362
; Copyright (C) Cherrysoft. All rights reserved
; 2003/03/04
;============================================
*MPX362	; ■ファイル開始のラベル
	mov $debugstr,"■MPX362" : gosub *debugout
;■マップ（無人）
	;--背景;----------------------------------
	mov $_bg,"BG036A"
	mov $debugstr,"ＢＧ：BG036A"
	gosub *out	;画面に出力
;☆２☆

	ここは美術室だけど…。\

	あんまり人は来ないよな。
	こないと怖い噂を思い出すな…。\

	【$g_hero】
	怖いかどうかは人次第だろうけど…。\

	いわゆる校舎にまつわる
	七不思議ってやつなんだけど…。\

	この美術室の七不思議はといえば…
	『１０１匹まぼちゃん』だ。\

	夕方過ぎにひとりで美術室に来ると
	どこからともなく石膏まぼちゃんが現れて…。\

	その石膏まぼちゃんたちに攻撃されるという…。
	それが１０１匹いるという噂なんだ。\

	これには別バージョンもある。\

	それは「放課後一人で美術室に行くと、
	たくさんの石膏の手が服などをひっぱってくる」\

	…という内容のものだ。\

	まぼちゃんの方は、石膏の手の七不思議から
	誰かが面白がって作ったんじゃないかな？\

	噂は、時代に進むにつれてバリエーションが
	広がってくるからなぁ…。\

	【$g_hero】
	もちろん僕は怖くなんてないけどさ。
	まぼちゃんくらいだったら…。\

	【$g_hero】
	…強がりなんかじゃないぞ。\

	【$g_hero】
	さあ帰ろう！\
	gosub *blackout
	return
	;----------------------------------
;---MPX362 END -----
