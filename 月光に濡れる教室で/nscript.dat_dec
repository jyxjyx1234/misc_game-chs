	mov $debugstr,"ＳＥ：ZDOORSLIDE"
	gosub *se
;ＢＧ：BG019A;学生会室

	ここならいくらかマシだろう。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TFB"
	mov $debugstr,"立ち：TFB "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XC0900"
	mov $debugstr,"音声：XC0900"
	gosub *vo

	【まゆ子】
	聞かせて欲しいニャ！！
	教えて欲しいニャ！！\
	dwavestop CH_VOICE	;XC0900

	【$g_hero】
	な、何をだよ。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TFI"
	mov $debugstr,"立ち：TFI "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XC0901"
	mov $debugstr,"音声：XC0901"
	gosub *vo

	【まゆ子】
	事件の事ニャ！！！\
	dwavestop CH_VOICE	;XC0901
	;--立ちキャラ;----------------------------------
	mov $_char,"TFA"
	mov $debugstr,"立ち：TFA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XC0902"
	mov $debugstr,"音声：XC0902"
	gosub *vo

	【まゆ子】
	あそこで張っていれば絶対に来ると
	思ってたニャ！！\
	dwavestop CH_VOICE	;XC0902
	;--立ちキャラ;----------------------------------
	mov $_char,"TFB"
	mov $debugstr,"立ち：TFB "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XC0903"
	mov $debugstr,"音声：XC0903"
	gosub *vo

	【まゆ子】
	まゆ子の記者のカンに間違いはなかった
	のニャ！！\
	dwavestop CH_VOICE	;XC0903

	【$g_hero】
	ちょ、ちょっと待て…待てって…まゆ子。\

	元気だなぁ…。\

	その元気さに、僕はすっかり
	毒気を抜かれてしまった。\

	あの…事件は、ほんの数時間前に起きた
	ばかりだ。\

	けっして興味本位に扱っていいような事じゃない。\

	それに僕たちだって、すごくショックだった。\

	あんなもの一生に一度だって遭遇したくない。\

	だからこんな風に迫られたら、
	もっと辛いだろうし腹が立つはずなのに。\

	なんだか結局ニクめない人間っているよな…。
	人徳ってヤツかな。\

	妙にしみじみしてしまった僕に、まゆ子が
	ジリジリと迫って来る。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TFI"
	mov $debugstr,"立ち：TFI "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XC0904"
	mov $debugstr,"音声：XC0904"
	gosub *vo

	【まゆ子】
	さあ！！センパイ！！！
	取材を受けてもらうニャよ！\
	dwavestop CH_VOICE	;XC0904

	【$g_hero】
	だからちょっと待てってば、まゆ子…。\

	ニクめないからといって、そうホイホイと
	答えられるはずもない。\

