*OP45	; ■ファイル開始のラベル
	mov $debugstr,"■OP45" : gosub *debugout
;■■■「月光に濡れる教室で、僕は。」台本：●音楽室で：OP45
;━━━━━━━━━━━━━━
;●音楽室で

	;--BGM;----------------------------------
