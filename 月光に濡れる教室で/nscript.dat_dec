	mov $debugstr,"音声：CC3819C "
	gosub *vo

	【明海】
	………………。
	見つけてくれて…ありがとう。\
	dwavestop CH_VOICE	;CC3819C 

	見つけてくれたって、校庭にいた先輩を
	だろうか…。\

	【$g_hero】
	…そんな僕なんてただそこに居ただけで。\
