*D02	; ■ファイル開始のラベル
	mov $debugstr,"■D02 " : gosub *debugout
;■■■「月光に濡れる教室で、僕は。」台本：■１日目：D02
;━━━━━━━━━━━━━━
;■１日目
;●朝
;ほぼ小夜子と共通。
;兄貴は共通で使う。めんどいし。
	;--背景;----------------------------------
	mov $_bg,"BG001A"
	mov $debugstr,"ＢＧ：BG001A"
	gosub *out	;画面に出力
;;主人公の部屋
	gosub *musicstop
	;--背景;----------------------------------
	mov $_bg,"WHITE"
	mov $debugstr,"ＢＧ：WHITE "
	mov %effect,2	;エフェクトを指定
	gosub *out	;画面に出力
	gosub *mono_on
	;-- イベントCG;----------------------------------
	mov $_cg,"D01A"
	mov $debugstr,"ＣＧ：D01A"
	mov	%effect,2	;エフェクトを指定
	gosub *cgout	;イベントＣＧ
;フラッシュバック。モノクロで。
	;-- イベントCG;----------------------------------
	mov $_cg,"D02A"
	mov $debugstr,"ＣＧ：D02A"
	mov	%effect,2	;エフェクトを指定
	gosub *cgout	;イベントＣＧ
	;-- イベントCG;----------------------------------
	mov $_cg,"D03A"
	mov $debugstr,"ＣＧ：D03A"
	mov	%effect,2	;エフェクトを指定
	gosub *cgout	;イベントＣＧ
	gosub *mono_off
;D01A-D03A
	;--背景;----------------------------------
	mov $_bg,"BG001A"
	mov $debugstr,"ＢＧ：BG001A"
	gosub *out	;画面に出力

	【$g_hero】
	小夜子！！\

	そうだ、僕は…。僕は小夜子に…。\

	;--BGM;----------------------------------
	mov $_music,"04": gosub *out
;BGM:迷

	【$g_hero】
	そうだ。小夜子を犯したんだ…。\

	僕はすとんとベッドに座り込んだ。
	体中の力が抜けてるみたいだった。\

	【$g_hero】
	小夜子を犯したんだ。僕は。\

	もう一度言葉にすると、やけにリアリティが
	あって僕の身体の中で何かがぞくりと喚いた。\

	絶対に後悔するってわかっているのに
	僕は快楽に流された。溺れた。\

	【$g_hero】
	……本当かよ…。\

	そんな言葉を言う自分が情けなかった。
	頭を抱えて、ベッドの上につっぷした。\

	【$g_hero】
	…どうすりゃいいんだよ…。
	ガッコ休もうかな…。\

	僕は頭を振った。どうすればいいかなんて、
	わからないし、どうしようもないけれど。\

	だからって、ここで家に居ても何の解決に
	ならないことぐらいは、明白だった。\

	【$g_hero】
	くそっ！　ああ、もう僕ってヤツは！\

	とりあえず風呂に入ってメシを食べよう。
	それで、小夜子に会わないと。\

	【$g_hero】
	会いたくないなぁ…。\

	最低だ、僕は。\

	僕はため息を何度もつきながら
	バスタオルを持って部屋を出た。\
	gosub *blackout

	return	;----------------------------------
;---D02  END -----
