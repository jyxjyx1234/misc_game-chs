*B26	; ■ファイル開始のラベル
	mov $debugstr,"■B26 " : gosub *debugout
;■■■「月光に濡れる教室で、僕は。」台本：●謎の人物：B26
;━━━━━━━━━━━━━━
;●謎の人物
;ここでは先生とはわからないようにしなければ。
;でも声出しちゃうとわかるか…変えてもらえれば
;ムー。しかしそれでも女だと解ってしまう。

	;--BGM;----------------------------------
	mov $_music,"06": gosub *out
;gosub *musicstop
	;--背景;----------------------------------
	mov $_bg,"MOONA01"
	mov $debugstr,"ＢＧ：MOONA01 "
	gosub *out	;画面に出力
;は菜摘先生なのですが、声を入れると一発でわかるのが問題で…
;ボイス変えるか…それとも無音か。
;声ださないほうがいいかな…。
;女ってわかるもんな…
;これ地の文で説明しないとわからないかなぁ…。

	【天使】
	誰からも望まれないのなら、
	生きていても意味がないのだと思う。\

	【天使】
	だから望まれるようにしたいと思った。
	いや、思っていたのかどうかわからない。\

	【天使】
	ただ、何もなく。誰からも見捨てられて
	そんな風に生きていくのはつらすぎるから。\

	【天使】
	そうは思わない？\

	【天使】
	…………………………………。\

	【天使】
	かわいそうな、この子。\

	【天使】
	そして、かわいそうな、あの子。\
;月が動いてるのをアニメっぽく出したいなーと
;ここはエフェクトかなにかで、見せたいが
;インのときに、もやっぽく？
;Ｃ１０みたいな感じ？　
	gosub *blackout

	return	;----------------------------------
;---B26  END -----
