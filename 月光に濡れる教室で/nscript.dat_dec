	ここは屋上だ。
	誰もいない。\

	風もつめたい。
	寒いな…。\

	そういえばここにある七不思議って…。\
;gosub *musicstop
	;--立ちキャラ;----------------------------------
	mov $_char,"TXA"
	mov $debugstr,"立ち：TXA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"K001"
	mov $debugstr,"音声：K001"
	gosub *vo

	【まぼちゃん】
	まんぼ！！！\
	dwavestop CH_VOICE	;K001
	;--立ちキャラ;----------------------------------
	mov $_char,"TXB"
	mov $debugstr,"立ち：TXB "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"K020"
	mov $debugstr,"音声：K020"
	gosub *vo

	【まぼちゃん】
	まんぼっまんぼ！！\
	dwavestop CH_VOICE	;K020
	gosub *clear_char
;gosub *sestop

	【$g_hero】
	……………………。\

	;--BGM;----------------------------------
	mov $_music,"05": gosub *out

	この屋上の七不思議は…
	『マンボ！　踊るまぼちゃん』だ。\

	まぼちゃんというのは、うちのガッコの
	シンボル…というかマスコットなんだけど。\

	なんでも、誰もいない夕方の屋上で、
	幽霊のまぼちゃんが一匹でクルクルとマンボを
	踊るという…。\

	【$g_hero】
	今のがそうだったんだろうか…。\

	【$g_hero】
	………ずいぶん楽しそうだったな。\

	【$g_hero】
	…………………………。\

	【$g_hero】
	いやだなぁ…幻覚まで見るなんて。
	疲れてるのかな？\

	【$g_hero】
	…………………………。
	クスリなんて使ってないぞ。\

	【$g_hero】
	悪い夢でも見たと思うことにしよう。
	帰ろ…。\
	;-効果音;----------------------------------
	mov $_se,"ZDOORC"
	mov $debugstr,"ＳＥ：ZDOORC"
	gosub *se

	バタン。\
;哀しそう
	;--立ちキャラ;----------------------------------
	mov $_char,"TXG"
	mov $debugstr,"立ち：TXG "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"K017"
	mov $debugstr,"音声：K017"
	gosub *vo

	【まぼちゃん】
	まぼ…。\
	dwavestop CH_VOICE	;K017
	gosub *blackout

	return	;----------------------------------
;---MPX252 END -----
