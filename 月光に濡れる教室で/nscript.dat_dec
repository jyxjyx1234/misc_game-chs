	真実が柔らかな唇をきゅっと噛む。\

	真実が髪をかき上げると、かたちのいい耳が
	ちらりと見えた。耳たぶが真っ赤だった。\

	そこに唇をつけたいと思ったけれど
	僕は言葉もなく、ただ真実のそばに座っていた。
	ふたりで、ただ一緒に座って月をながめた。\

	空気は夜気にどんどん凍り付くように
	澄んでいく。月が明るくて、明るくて。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TBA"
	mov $debugstr,"立ち：TBA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"BB2143"
	mov $debugstr,"音声：BB2143"
	gosub *vo

	【真実】
	すごく奇麗だね。月が。\
	dwavestop CH_VOICE	;BB2143

	【$g_hero】
	…うん。\

	こんな風に夜空を見たことなんてなかった。
	だれかと一緒に夜空を見たことなんてなかった。\

	冷たくて、寒くて、外でふきっさらしで
	さっきの二人で絡み合ってたときの熱なんて
	とっくに消えてしまって。\

	コーヒーとココアの熱も消えて。
	普段だったら、一刻も早く家に帰って、
	風呂入って寝たいってそう思うのに。\

	僕は、真実と一緒に居たかった。
	寒くても、冷たくても構わないから
	一緒に居たいと、そう思った。\

	もう少し。もう少しだけでいいから。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TBC"
	mov $debugstr,"立ち：TBC "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"BB2144"
	mov $debugstr,"音声：BB2144"
	gosub *vo

	【真実】
	くしゅんっ！！\
	dwavestop CH_VOICE	;BB2144

	【$g_hero】
	だ、大丈夫？風邪ひくよな。\

	僕はベンチから立ち上がってコートを脱ぎ
	真実にかけてやった。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TBF"
	mov $debugstr,"立ち：TBF "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"BB2145"
	mov $debugstr,"音声：BB2145"
	gosub *vo

	【真実】
	い、いいよ。寒いよ。えと…$g_hero君が。\
	dwavestop CH_VOICE	;BB2145

	【$g_hero】
	いいよ。これぐらい。\

	そりゃ寒いけどさ。
	これぐらいは見栄を張っても良いだろ。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TBG"
	mov $debugstr,"立ち：TBG "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"BB2146"
	mov $debugstr,"音声：BB2146"
	gosub *vo

	【真実】
	そろそろ…帰らないと。\
	dwavestop CH_VOICE	;BB2146

	真実が、とうとうその言葉を口にだした。
	いや…真実がいわなければ僕が言ってたけど。\

	僕は、ベンチに座る真実に手を差し出した。\

	【$g_hero】
	…送ってく。\

	真実は、僕を見上げて、こくりと頷いた。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TBA"
	mov $debugstr,"立ち：TBA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"BB2147"
	mov $debugstr,"音声：BB2147"
	gosub *vo

	【真実】
	…うん。\
	dwavestop CH_VOICE	;BB2147

	真実の細い手は雪の中に
	置き忘れられたみたいにとても冷たかった。
	僕は、その小さな手をきゅっと握りしめた。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TBB"
	mov $debugstr,"立ち：TBB "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"BB2148"
	mov $debugstr,"音声：BB2148"
	gosub *vo

	【真実】
	温かいね。\
	dwavestop CH_VOICE	;BB2148

	そう言って、笑ってくれるのが
	僕はうれしかった。\

	【$g_hero】
	行こっか。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TBA"
	mov $debugstr,"立ち：TBA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"BB2149"
	mov $debugstr,"音声：BB2149"
	gosub *vo

	【真実】
	うん。\
	dwavestop CH_VOICE	;BB2149

	【$g_hero】
	あのさ。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TBD"
	mov $debugstr,"立ち：TBD "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"BB2150"
	mov $debugstr,"音声：BB2150"
	gosub *vo

	【真実】
	何？\
	dwavestop CH_VOICE	;BB2150

	【$g_hero】
	…キスしていい？\

	どうして、そんな言葉を口にしたんだか
	わからない。考えてもなかったのに口に出た。\

	きっと月がきれいで。月のせいで。
	たぶん、きっとそう。\

	そのせいだ。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TBG"
	mov $debugstr,"立ち：TBG "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"BB2151"
	mov $debugstr,"音声：BB2151"
	gosub *vo

	【真実】
	…うん、いいよ。\
	dwavestop CH_VOICE	;BB2151
	gosub *clear_char
	;-- イベントCG;----------------------------------
	mov $_cg,"B19A"
	mov $debugstr,"ＣＧ：B19A"
	gosub *cgout	;イベントＣＧ

	僕は、真実の唇にキスをした。
	それは、やわらかくて
	さらりと乾いていて、温かかった。\

	触れるだけのキスだった。\

	どうして、それだけなのに、
	こんなにドキドキするんだろう。\

	舌を絡ませる熱いキスを、
	僕らは、たくさんしたのに。\

	僕は真実の背中に手を回した。
	彼女の身体はさざ波のように震えていた。\

	さっきみたいな、快楽でもなく、寒さでもなく、
	僕の腕の中に居るということに彼女は震えていた。\

	全部、全部ほしいなと僕は思った。
	真実の全部がほしくて、ぎゅっと抱きしめた。\

	何が全部なんてわからないけれども。\

	こうやって抱きしめると、すっぽりと真実の
	身体が自分の腕に入ってしまう。\

	これがずっと続けばいいのに。
	ずっとこうだといいのに。\

	どれぐらい、そのまま時間が過ぎたんだろう。
	ものすごく長いような、短いような気もした。\
	;--背景;----------------------------------
	mov $_bg,"BG032B"
	mov $debugstr,"ＢＧ：BG032B"
	gosub *out	;画面に出力

	【$g_hero】
	帰ろう。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TBB"
	mov $debugstr,"立ち：TBB "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"BB2152"
	mov $debugstr,"音声：BB2152"
	gosub *vo

	【真実】
	うん。\
	dwavestop CH_VOICE	;BB2152

	僕たちは、月明かりに静まる町を
	ゆっくりと歩いていった。\
	gosub *blackout

	return	;----------------------------------
;---B21  END -----
