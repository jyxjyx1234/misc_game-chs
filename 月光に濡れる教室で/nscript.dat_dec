*MPJC1	; ■ファイル開始のラベル
	mov $debugstr,"■MPJC1 " : gosub *debugout
;■■■「月光に濡れる教室で、僕は。」台本：●マップ移動：MPJC1
;○２年教室

	;--BGM;----------------------------------
	mov $_music,"01": gosub *out
	;--背景;----------------------------------
	mov $_bg,"BG009A"
	mov $debugstr,"ＢＧ：BG009A"
	gosub *out	;画面に出力
;ＢＧ：BG009A;２年教室

	みんな集まって話をしている。
	きっと今朝の自殺のことなんだろう。\

	もしかして、僕らのことを知っているのか。
	ひそひそと話し声が高くなる。
	指を指すやつもいる。\

	【$g_hero】
	……………。\

	なんだか、すごく不快だった。
	言いたいことがあるならハッキリ言えよ。くそ。\

	僕の知らないところで、僕の予想しないところで
	僕が意図しないところで、勝手に進んでる。\

	世の中なんてそんなものかもしれないけど
	すごく、すごく、そんなのがイヤだった。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TJA"
	mov $debugstr,"立ち：TJA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"YB1100"
	mov $debugstr,"音声：YB1100"
	gosub *vo

	【育巳】
	よう、おかえり。お二人さん。\
	dwavestop CH_VOICE	;YB1100

	【$g_hero】
	育巳。\

	明るい声でわらって片手をあげた育巳が、
	いつもと同じで、ものすごくほっとした。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TJB"
	mov $debugstr,"立ち：TJB "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"YC1315"
	mov $debugstr,"音声：YC1315"
	gosub *vo

	【育巳】
	メシ食った？パンあるけど食う？
	皆月会長もどうですか？\
	dwavestop CH_VOICE	;YC1315
;育巳は、皆月先輩が好きじゃなさそうだ。
;育巳には先輩が何もわかってない人間にみえるのでしょう。
	;--立ちキャラ;----------------------------------
	mov $_char,"TCA"
	mov $debugstr,"立ち：TCA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC1316"
	mov $debugstr,"音声：CC1316"
	gosub *vo

	【明海】
	元、会長よ。
	今はみんなと同じ、ただの学生だわ。\
	dwavestop CH_VOICE	;CC1316
	;--立ちキャラ;----------------------------------
	mov $_char,"TJA"
	mov $debugstr,"立ち：TJA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"YC1317"
	mov $debugstr,"音声：YC1317"
	gosub *vo

	【育巳】
	そうでした。
	じゃ、皆月先輩と、ほらお前の分。\
	dwavestop CH_VOICE	;YC1317

	といって取り出したのは、小栗屋の紙袋だった。
	しかもレアで有名な「黄金の栗」だ。\

	ちなみに栗の形をしていて、中に自家製
	カスタードクリームが入っているパンだ。\

	もしかして、わざわざ待っててくれたのかな。
	しかも、これ買ってきてくれてさ。\

	【$g_hero】
	んじゃ、ちょっと食べようかな。\

	目頭がちょっと熱い。
	くそっ、育巳のヤツ、泣かせるじゃんかよ。\

	さすがに昼間何もたべてないから
	ぺこぺこで、小栗屋のパンが美味かった。\

	あんなことがあっても、人間
	お腹は空くし、飯は食うんだな。\

	そんなことをぼんやり思いながら
	僕は、パンを食べた。\

	育巳は明日からの時間割について
	僕たちに説明してくれた。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TJC"
	mov $debugstr,"立ち：TJC "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"YC1318"
	mov $debugstr,"音声：YC1318"
	gosub *vo

	【育巳】
	あのさ、あとでちょっと話したいことがあるから
	もう一度来てくれないか？\
	dwavestop CH_VOICE	;YC1318

	【$g_hero】
	いいけど、今じゃだめなのか？\
	;--立ちキャラ;----------------------------------
	mov $_char,"TJA"
	mov $debugstr,"立ち：TJA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"YC1319"
	mov $debugstr,"音声：YC1319"
	gosub *vo

	【育巳】
	ああ…ちょっとな。\
	dwavestop CH_VOICE	;YC1319

	【$g_hero】
	うん。じゃあ後でくる。\

	僕たちは、２年の教室を出て行った。\
	gosub *blackout

	;--BGM;----------------------------------
	mov $_music,"05": gosub *out

	return	;----------------------------------
;---MPJC1  END -----
