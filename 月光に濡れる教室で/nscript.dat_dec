*E00	; ■ファイル開始のラベル
	mov $debugstr,"■E00 " : gosub *debugout
;■■■「月光に濡れる教室で、僕は。」台本：■菜摘先生とＯＰで出会い：E00
;━━━━━━━━━━━━━━
;■菜摘先生とＯＰで出会い

	;--BGM;----------------------------------
	mov $_music,"02": gosub *out
	;--背景;----------------------------------
	mov $_bg,"BG023A"
	mov $debugstr,"ＢＧ：BG023A"
	gosub *out	;画面に出力

	【$g_hero】
	そういえば、今日の部活はどうするのかな。
	菜摘先生に聞いてみようかな。\

	コーラス部の顧問は、僕のクラスの担任でもある
	藍田　菜摘先生だ。若くて美人で授業も面白い。\

	たぶんうちの学校で、一番人気は菜摘先生だろう。
	２番目は保健室在中の百合恵先生かな。\

	清純派とお色気派みたいな感じで、どっちが
	好みかは、ひとによると思うけど。\

	;--BGM;----------------------------------
	mov $_music,"15": gosub *out
;BGM:藍田　菜摘

	【$g_hero】
	あ、いたいた。菜摘先生！\
;4:2 Wherefore I praised the dead which are already dead more than the
;living which are yet alive.
;モノローグで、呟くように
	;--立ちキャラ;----------------------------------
	mov $_char,"TEC"
	mov $debugstr,"立ち：TEC "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XE0000"
	mov $debugstr,"音声：XE0000"
	gosub *vo

