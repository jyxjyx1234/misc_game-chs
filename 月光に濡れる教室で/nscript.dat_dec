	goto *OPMAP02_map

*OPMAP02_end	;マップ終了
	mov %op02_looked,1
	return

*OPMAP02_makoto
	mov %map_exit,%op02_looked	;op02_lookedが１なら「やめる」有効に
	gosub *OP38	;#■話を聞いてみる#■やめておく
	if %makoto_bad==ON mov $_music,"05":gosub *out: goto *OPMAP02_map ; バッドならOP39は見ない
	gosub *OP39	;#■真実を助ける#■放っておく
	if %makoto_bad==ON mov $_music,"05":gosub *out: goto *OPMAP02_map ; バッドならOP39は見ない
