*D118	; ■ファイル開始のラベル
	mov $debugstr,"■D118" : gosub *debugout
;■■■「月光に濡れる教室で、僕は。」台本：●丹羽が死んでいる！：D118
;━━━━━━━━━━━━━━
;●丹羽が死んでいる！

	;--BGM;----------------------------------
	mov $_music,"03": gosub *out
;BGM:迷
	;--背景;----------------------------------
	mov $_bg,"BG015A"
	mov $debugstr,"ＢＧ：BG015A"
	gosub *out	;画面に出力
;ＢＧ：BG015A;裏庭

	【$g_hero】
	体育館の裏って…言ってたけど
	見あたらないなぁ…。\

	【$g_hero】
	あ、そっか。体育倉庫にいるかもな。
	寒いし。\

	もしかしたら、張り切ってる部活の子が
	いて、朝練用に開けてるかもしれない。\

	【$g_hero】
	…って、望み薄いかな…。
	ま、とりあえず行ってみよう。\
	gosub *blackout
	;--背景;----------------------------------
	mov $_bg,"BG017A"
	mov $debugstr,"ＢＧ：BG017A"
	gosub *out	;画面に出力
;ＢＧ：BG017A;体育倉庫
;ぎゃー！

	【$g_hero】
	お、開いてた。やっぱりこっちだったのか。
	よく鍵開けられたな。\

	【$g_hero】
	ん？　なんだ…この匂い？\

	ぬるり。
	足下が妙にすべる。\

	【$g_hero】
	…え……？\
	gosub *musicstop

	生臭いような…いや、ちがう。
	妙に鉄くさいような…でも知ってる…。\

	僕はそれをつい最近嗅いだことがある。
	それは、こんな風に赤黒いものがあって…。\

	床に倒れているのは…丹羽だった。
	丹羽は冷たい床にうつぶせになったまま
	ぴくりとも動かない。\

	そして、丹羽の背中からは
	銀色にひかるナイフが生えていた。\

	【$g_hero】
	う、うそ…。嘘だろ…？\

	冗談みたいに丹羽の背中から生えている
	ナイフを見て僕はそんな言葉しか出てこなかった。\

	return	;----------------------------------
;---D118 END -----
