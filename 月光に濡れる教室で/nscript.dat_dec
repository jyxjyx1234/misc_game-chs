	mov $debugstr,"■OP17" : gosub *debugout
;■■■「月光に濡れる教室で、僕は。」台本：○卒業生代表の話：OP17
;━━━━━━━━━━━━━━
;○卒業生代表の話

	;--BGM;----------------------------------
	mov $_music,"07": gosub *out
;BGM:皆月　明海
	;--背景;----------------------------------
	mov $_bg,"BG019A"
	mov $debugstr,"ＢＧ：BG019A"
	gosub *out	;画面に出力
;学生会室

	【$g_hero】
	でも、卒業旅行かぁ。
	…もうすぐ卒業式だね。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCA"
	mov $debugstr,"立ち：TCA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"COP1700"
	mov $debugstr,"音声：COP1700 "
	gosub *vo

	【明海】
	そうね。あと…六日かしら。\
	dwavestop CH_VOICE	;COP1700 

	明海ちゃんが、カレンダーを見ながら答えた。\

	そういえばあのカレンダーも、
	明海ちゃんが張ってくれたんだっけ…。\

	【$g_hero】
	そういえばさ。卒業生代表、
	明海ちゃんじゃないんだよね？\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCJ"
	mov $debugstr,"立ち：TCJ "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"COP1701"
	mov $debugstr,"音声：COP1701 "
	gosub *vo

	【明海】
	……………そうね。\
	dwavestop CH_VOICE	;COP1701 

	明海ちゃんが、目を伏せる。
	僕の方を見ようともしない。\

	…マズイこと言っちゃったかな…。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCJ"
	mov $debugstr,"立ち：TCJ "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"COP1702"
	mov $debugstr,"音声：COP1702 "
	gosub *vo

	【明海】
	…後半の調子が悪かったから。
	休みがちだったし…。\
	dwavestop CH_VOICE	;COP1702 

	【$g_hero】
	そっか…大変だったんだ。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCC"
	mov $debugstr,"立ち：TCC "
	gosub	*out	;画面に出力

	【明海】
	………………。\

	話は聞いているんだ。今度の卒業生代表。
	男なんだよね。つまんないよな。\

	せっかくだったら女の子の方がいいよ。
	明海ちゃんの声は、良く通るキレイな声をしてる。\

	卒業式なんて、ホント退屈なんだからさ。
	その位の楽しみがなければ、やってられないよ。\

	【$g_hero】
	明海ちゃんがやるのかと、思ってたよ。
	調子悪かったって…そういえば休み多かったよね。\

	秋頃だから…半年くらい前になるだろうか。
	明海ちゃんの姿を、学園で見かけなくなったのは。\

	うちの３年生は、二学期の後半辺りから
	けっこう休みがちにはなるけどね。\

	クラスの人数も、半分くらいに減ってしまう。
	授業よりも、塾での集中講義を選ぶからだって。\

	要するに、出席日数さえ足りればいいんだ。
	皆勤を気にするのは、推薦ねらいの人間くらいだ。\

	だから、明海ちゃんが来てなくても、
	あんまり気にならなかったんだ。\

	明海ちゃんは成績も優秀だし、
	学生会会長なんてものをやっていたせいもあって。\

	秋頃には、指定校推薦で進学先は決まってたと
	思ったけど…。\

	行き先さえ決まっちゃえばさ、
	好きなことしても別にいいもんな。\

	さっさと進学先を決めちゃった３年の中には、
	自動車学校に通うような人だっている。\

	でも、明海ちゃんはそういうタイプじゃないし。
	ずっと皆勤だったし。\

	休みがちだって、今の会長から聞いたとき、
	ちょっと違和感だったのを覚えてる。\

	体の具合が悪かったからなんだろうか？
	そういえば、少し痩せたようにも見える。\

	そう思ってあらためて見ると、
	久しぶりに会った明海ちゃんの印象は、
	以前と随分違ってみえた。\

	髪を切ったせいもあるだろうけど。
	明海ちゃんは、子供の頃からずっと長い髪だった。\

	だから、半年前くらいにばっさりと
	髪を切ったのを見たとき、ものすごく驚いたっけ。\

	そういえば、学園を休みがちになったのも
	その頃だよな…。\

	髪を切って、学園を休みがちになって…
	半年前に何があったんだろう。\

	失恋でもしたんだろうか…。
	ああ、いかんいかん。下世話だぞ、僕。\

	;--BGM;----------------------------------
	mov $_music,"04": gosub *out
;BGM:迷
	;--立ちキャラ;----------------------------------
	mov $_char,"TCC"
	mov $debugstr,"立ち：TCC "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"COP1702B"
	mov $debugstr,"音声：COP1702B"
	gosub *vo

	【明海】
	………。
	今更どうして…そんなこと訊くの？\
	dwavestop CH_VOICE	;COP1702B

	【$g_hero】
	え…？\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCC"
	mov $debugstr,"立ち：TCC "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"COP1703A"
	mov $debugstr,"音声：COP1703A"
	gosub *vo

	【明海】
	ずっと…何も訊かなかったのに。\
	dwavestop CH_VOICE	;COP1703A

	翳りのある表情。伏せたままの大きな瞳。
	…どうしたんだろう。\

	何か機嫌を損ねるようなことを
	僕は言ったんだろうか？\

	……でもさ。
	何も訊かなかった…って言われてもさ。\

	明海ちゃんはいつも忙しそうだったし
	話しかけても、よそよそしかったし。\

	三学期に入ってからは、全然顔も見なかったし。\

	お隣さんだからって、お見舞いするほど
	親密でもなかったし。\

	大体…制服を着てからの僕と明海ちゃんは、
	すごく微妙な距離だったじゃないか。\

	【$g_hero】
	…………………。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCC"
	mov $debugstr,"立ち：TCC "
	gosub	*out	;画面に出力

	【明海】
	…………………。\

	ふっつりと会話が途切れてしまった。\
	;--立ちキャラ;----------------------------------
