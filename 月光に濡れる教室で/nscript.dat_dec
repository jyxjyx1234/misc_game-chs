	dwavestop CH_VOICE	;CC7011

	【$g_hero】
	そんなの罪でもなんでもないよ。先輩。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCD"
	mov $debugstr,"立ち：TCD "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC7012"
	mov $debugstr,"音声：CC7012"
	gosub *vo

	【明海】
	…え？\
	dwavestop CH_VOICE	;CC7012

	僕は、わざと何でもないことのように言った。
	先輩は目を丸くしてる。\

	【$g_hero】
	だってしてないんだろ？\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCC"
	mov $debugstr,"立ち：TCC "
	gosub	*out	;画面に出力

	【明海】
	…………………。\

	いいんだ、先輩は考えすぎだよ。
	考えすぎだって…周りの人間が言えば
	よかったんだよ。\

	【$g_hero】
	大丈夫、大丈夫だから。
	だって先輩には、心当たり、ないんだろ？\

	僕は、先輩の手をとった。
	ごく…自然に、僕はその手を取ることができた。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCH"
	mov $debugstr,"立ち：TCH "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC7013"
	mov $debugstr,"音声：CC7013"
	gosub *vo

	【明海】
	うん…でも…でも、私…怖くて…
	何もわからなくて…！\
	dwavestop CH_VOICE	;CC7013
	;--立ちキャラ;----------------------------------
	mov $_char,"TCH"
	mov $debugstr,"立ち：TCH "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC7014"
	mov $debugstr,"音声：CC7014"
	gosub *vo

	【明海】
	助けも呼べなくて…たった独りで苦しくて…！\
	dwavestop CH_VOICE	;CC7014

	僕は、先輩の手を両手で包み込んだ。
	ぎゅっとその手を握りしめた。\

	【$g_hero】
	…………犯人は別にいる。
	だから…犯人を捜そう。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCC"
	mov $debugstr,"立ち：TCC "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC7015"
	mov $debugstr,"音声：CC7015"
	gosub *vo

	【明海】
	どうしてそんなに優しいの？
	私…私…人を殺しているかもしれないのに。\
	dwavestop CH_VOICE	;CC7015

	【$g_hero】
	違うよ、先輩は殺してない。\

	【$g_hero】
	大丈夫。大丈夫だから。
	二人ならきっと…きっと見つけられるから。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCH"
	mov $debugstr,"立ち：TCH "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC7016"
	mov $debugstr,"音声：CC7016"
	gosub *vo

	【明海】
	ありがとう…。\
	dwavestop CH_VOICE	;CC7016

	僕の手の甲に、ぽつんと雫が落ちた。
	それは、先輩の涙だった。\

	先輩が顔をあげる。
	涙をぬぐいながら、先輩は僕に笑った。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCB"
	mov $debugstr,"立ち：TCB "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC7017"
	mov $debugstr,"音声：CC7017"
	gosub *vo

	【明海】
	私…頑張るから。\
	dwavestop CH_VOICE	;CC7017

	【$g_hero】
	うん…二人で頑張ろう。\

	そう言ったら、また先輩は笑った。\

	光の揺れる海のように。
	すべてが満ちる直前の月のように。\

	笑ったんだ。\
;揺れなくても海は海
;満ちなくても月は月
;いつか凪いで、いつか満ちる

