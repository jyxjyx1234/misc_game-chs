*D121	; ■ファイル開始のラベル
	mov $debugstr,"■D121" : gosub *debugout
;■■■「月光に濡れる教室で、僕は。」台本：■エンディング：D121
;━━━━━━━━━━━━━━
;■エンディング
	gosub *musicstop
	;--背景;----------------------------------
	mov $_bg,"angel"
	mov $debugstr,"ＢＧ：angel "
	mov %effect,5	;エフェクトを指定
	gosub *out	;画面に出力

	物事はすべて終わるのだ。
	どうしても止めておけずに、流れていくのだ。\

	だから、いいのかもしれないし、
	だから、切ないのかも知れない。\

	【天使】
	だから、あなたが幸せでありますように。\

	【天使】
	だから、すべてが許されますように。\

	【天使】
	わたしのすべてが。君のすべてが。\
	gosub *blackout

	;--BGM;----------------------------------
	mov $_music,"10": gosub *out
;BGM:Ｈ１
	;--背景;----------------------------------
	mov $_bg,"BG001A"
	mov $debugstr,"ＢＧ：BG001A"
	gosub *out	;画面に出力
;ＢＧ：BG001A;主人公の部屋
	;--立ちキャラ;----------------------------------
	mov $_char,"TLA"
	mov $debugstr,"立ち：TLA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"YD12100"
	mov $debugstr,"音声：YD12100 "
	gosub *vo

	【$g_heroの兄】
	ようやく始業式か。
	無事に３年生になれてよかったねぇ。\
	dwavestop CH_VOICE	;YD12100 

	【$g_hero】
	うん。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TLC"
	mov $debugstr,"立ち：TLC "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"YD12101"
	mov $debugstr,"音声：YD12101 "
	gosub *vo

	【$g_heroの兄】
	でもまだ休んでいてもいいのに。
	怪我が治ったわけじゃないんだよ。\
	dwavestop CH_VOICE	;YD12101 

	ナイフの傷は、見た目よりはわりと軽くて
	病院で縫ってもらってもらうと、
	案外すぐに退院できた。\

	【$g_hero】
	たいした怪我じゃないんだし
	そうそう簡単に休めないよ。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TLB"
	mov $debugstr,"立ち：TLB "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"YD12102"
	mov $debugstr,"音声：YD12102 "
	gosub *vo

	【$g_heroの兄】
	そんなこと言って、彼女に会いたいだけじゃ
	ないのかな～～？　毎日見舞いに来てたし。\
	dwavestop CH_VOICE	;YD12102 

	【$g_hero】
	いいだろ別に。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TLB"
	mov $debugstr,"立ち：TLB "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"YB10404"
	mov $debugstr,"音声：YB10404 "
	gosub *vo

	【$g_heroの兄】
	はいはい。それじゃ彼女によろしくね。
	捨てられないようにね。\
	dwavestop CH_VOICE	;YB10404 

	【$g_hero】
	うるさいな！！\
	gosub *clear_char

