*E15	; ■ファイル開始のラベル
	mov $debugstr,"■E15 " : gosub *debugout
;■■■「月光に濡れる教室で、僕は。」台本：●授業中：E15
;━━━━━━━━━━━━━━
;●授業中

	;--BGM;----------------------------------
	mov $_music,"01": gosub *out
	;--背景;----------------------------------
	mov $_bg,"BG009A"
	mov $debugstr,"ＢＧ：BG009A"
	gosub *out	;画面に出力
;ＢＧ：BG009A;２年教室

	５時間目の授業は自習だった。
	またか。暇でヒマで眠くてしかたない。
	なんでゴハンを食べると眠くなるんだろう。\

	宿題になってた数学の問題を解こうと思ったけど
	頭の中に数式が入っていかない。
	まあいいや。あとでやればいいだろ。\

	僕はノートを取り出して、
	シャーペンを指先でくるくる回した。\

	エロ小説書くのもいいけど、
	なんか今日はそういう気分じゃないしなぁ。\

	菜摘先生のことを考えてみようか。
	…菜摘先生…さっきの写真かわいかったなぁ…。\

	…あ、ダメだ。やめとこう。
	顔がニヤニヤしてんの自覚あるや。
	人に見つかったら恥ずかしい。\

	それじゃ何を書こうかな…。
	そういや今日はコーラス部の練習あるな…。
	小夜子来るだろうな。\

	小夜子のヤツ、僕が先生と
	付き合ったって知ったら、どう思うかな…。\

	後輩の小夜子は僕が好きだ。
	別に恋愛関係じゃないのはお互い知ってる。\

	けれど、男女関係のことについては
	あいつ、むちゃくちゃ潔癖だからなぁ…。\

	う…ううん…言うのは。もう少ししてからで
	いいかな。育巳にもちゃんと言ってないしさ。\

	春休み中に、先生との間の仲を
	進展できるといいんだけどな…。\
	;-効果音;----------------------------------
	mov $_se,"ZTYAIM"
	mov $debugstr,"ＳＥ：ZTYAIM"
	gosub *se

	キーンコーンカーンコーン…。\

	考え事をしている間に、いつの間にか
	授業がおわってしまった。\

	【$g_hero】
	さてと。どうしようかな…。\
	gosub *blackout

	return	;----------------------------------
;---E15  END -----
