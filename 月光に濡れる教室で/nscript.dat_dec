	;--背景;----------------------------------
	mov $_bg,"BG013A"
	mov $debugstr,"ＢＧ：BG013A"
	gosub *out	;画面に出力
;
	;--立ちキャラ;----------------------------------
	mov $_char,"TFB"
	mov $debugstr,"立ち：TFB "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XC0800"
	mov $debugstr,"音声：XC0800"
	gosub *vo

	【まゆ子】
	センパーーーーーイーーーーー！！！\
	dwavestop CH_VOICE	;XC0800
	;-効果音;----------------------------------
	mov $_se,"ZDOSA"
	mov $debugstr,"ＳＥ：ZDOSA "
	gosub *se
	gosub *GURA	;GURAを呼び出し

	【$g_hero】
	うわああ！？\

	僕は、正面から突進してきたまゆ子と
	まともにぶつかった。\

	【$g_hero】
	あっ…ぶないなぁ…もう。
	ヘタしたら一緒に転がっていたぞ。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TFI"
	mov $debugstr,"立ち：TFI "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XC0801"
	mov $debugstr,"音声：XC0801"
	gosub *vo

	【まゆ子】
	待ってたニャ！
	待ってたニャ！！\
	dwavestop CH_VOICE	;XC0801

	まゆ子は、僕を捕まえた気でいるらしい。
	声を低くして、フッフッフッと笑っている。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TFB"
	mov $debugstr,"立ち：TFB "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XC0802"
	mov $debugstr,"音声：XC0802"
	gosub *vo

	【まゆ子】
	ニャニャニャ！！
	やぁっと、捕まえたニャよぉ……！\
	dwavestop CH_VOICE	;XC0802

	…確かにな。このダッコおばけみたいな状態でも、
	捕まえたと言えなくはない。\

	まゆ子は、ピョンと廊下に着地すると、
	ビシィッ！　と僕に指を突きつけた。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TFE"
	mov $debugstr,"立ち：TFE "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XC0803"
	mov $debugstr,"音声：XC0803"
	gosub *vo

	【まゆ子】
	ここで会ったが百年目！！
	…洗いざらい話してもらうニャよぉぉぉぉぉっ！\
	dwavestop CH_VOICE	;XC0803

	…いったい何ゴッコをしてるんだ。まゆ子。\

	そのまゆ子の様子を見ていた僕は、かえって
	冷静になってきた。\

	【$g_hero】
	まぁ…まゆ子。待て待て。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TFD"
	mov $debugstr,"立ち：TFD "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XC0804"
	mov $debugstr,"音声：XC0804"
	gosub *vo

	【まゆ子】
	ニャ？\
	dwavestop CH_VOICE	;XC0804

	僕は、まゆ子の襟首を掴むと廊下を歩き出した。\

	いくらなんでもここじゃマズイ。
	まだ廊下を歩いている人間だって結構いるんだ。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TFK"
	mov $debugstr,"立ち：TFK "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XC0805"
	mov $debugstr,"音声：XC0805"
	gosub *vo

	【まゆ子】
	ニャニャ！？どこへ行くニャ？\
	dwavestop CH_VOICE	;XC0805

	まゆ子は、まんま首根っこを捕まれたネコだ。
	手足をジタバタしながら引きずられていく。\

	軽いんだな。まゆ子は。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCC"
	mov $debugstr,"立ち：TCC "
	gosub	*out	;画面に出力

	【明海】
	…………………………。\

	皆月先輩が心配そうに後をついて来る。\

	そんな心配そうな顔しなくてもダイジョウブだよ。
	ひどいことしないよ、先輩。\

	なんて…先輩にあんな事しておいて、
	こんな事いっても、信用されないよな。\
	gosub *clear_char

	僕は人気のすくない場所を探した。
	廊下じゃだめだ。階段もひとが来る。\

	【$g_hero】
	よし、ここならいいだろう。\
	;-効果音;----------------------------------
	mov $_se,"ZKEY"
	mov $debugstr,"ＳＥ：ZKEY"
	gosub *se

	僕はガチャガチャと鍵をあけて
	まゆ子を学生会室にひっぱりこんだ。\

	ここの鍵はいつも持ってる。
	これぐらいの職権乱用はいいだろう。
	いつもこき使われているんだから。\

	return	;----------------------------------
;---C08  END -----
