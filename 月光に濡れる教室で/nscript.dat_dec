*C02	; ■ファイル開始のラベル
	mov $debugstr,"■C02 " : gosub *debugout
;■■■「月光に濡れる教室で、僕は。」台本：■１日目：B02
;━━━━━━━━━━━━━━
;■１日目
;●朝
	gosub *musicstop
;ＢＧ：BG001A;主人公の部屋
;フラッシュバック。モノクロで。
	;--背景;----------------------------------
	mov $_bg,"WHITE"
	mov $debugstr,"ＢＧ：WHITE "
	mov %effect,2	;エフェクトを指定
	gosub *out	;画面に出力
	gosub *mono_on
	;-- イベントCG;----------------------------------
	mov $_cg,"C03A"
	mov $debugstr,"ＣＧ：C03A"
	mov	%effect,2	;エフェクトを指定
	gosub *cgout	;イベントＣＧ

	【$g_hero】
	………！！
	そうだ…僕…明海ちゃんを…先輩を…。\

	【$g_hero】
	……犯したんだ。\
	gosub *mono_off
	gosub *blackout

	;--BGM;----------------------------------
	mov $_music,"04": gosub *out
;BGM:哀
	;--背景;----------------------------------
	mov $_bg,"BG001A"
	mov $debugstr,"ＢＧ：BG001A"
	gosub *out	;画面に出力

	そう言った途端、心臓がバクバクした。
	無いことにはできない。できないけど。\

	【$g_hero】
	どうすれば…いいんだ……！\

	どんな顔して会えばいいんだ。
	いや、会えるはずがない。\

	あんな事をしといて。
	今更どんな顔をして会えばいいんだよ！！\

	学園内の…しかも校庭で。
	先輩の体を、地面に押し倒して。\

	ちっとも優しくしなかった。
	むしろヒドイ事ばかりした。\

	最低の…最悪のことをしたんだ。
	確かに僕はおかしかった。
	本当に、どうかしてた。\

	だけど、あの時はどうかしてた、なんて。
	言い訳にさえならないじゃないか。\

	【$g_hero】
	だったら…行くしかないじゃないか。\

	家から出て、そして先輩に会って。
	話をしよう。話をしなくちゃ…いけないんだ。\

	【$g_hero】
	もしかしたら…もう会ってもくれないかも
	しれないな。\

	つぶやいたら、胸が痛んだ。
	皆月先輩。…明海ちゃん。\

	ちいさい頃から良く知っていた。
	今は何だか気まずくなってしまったけど。\

	でも、今でも良く覚えているんだ。
	ちいさな頃の、明海ちゃんの笑顔を。\

	その明海ちゃんを。先輩を。
	僕はこの手で犯してしまったんだ。\

	【$g_hero】
	本当に…何でなんだよ…。\

	窓からの朝の光が、呪わしかった。
	この部屋から一歩も出たくなかった。\

	このまま回れ右をして、
	布団にもぐりこんでしまいたかった。\

	だけど、そんなことをしたら。
	僕は、本当に最悪の人間になってしまう。\

	【$g_hero】
	とにかくシャワーでも浴びよう…それからだ。\

	熱いシャワーを浴びて、覚悟を決めて。
	出かけよう。先輩に会おう。\

	…覚悟なんてそう簡単に決められないけど。\

	【$g_hero】
	くそっ！ああ、もう！！　僕ってヤツは！！\

	僕は、バスタオルを掴んで部屋を出た。\
	gosub *blackout

	return	;----------------------------------
;---C02  END -----
