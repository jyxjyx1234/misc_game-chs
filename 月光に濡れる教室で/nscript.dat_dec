	もしかして…私から？　\
	dwavestop CH_VOICE	;CC2704
	;--立ちキャラ;----------------------------------
	mov $_char,"TCC"
	mov $debugstr,"立ち：TCC "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC2705"
	mov $debugstr,"音声：CC2705"
	gosub *vo

	【明海】
	花になんて…どこかで触れたかしら？公園で？
	………でも…この匂い…どこかで……。\
	dwavestop CH_VOICE	;CC2705
	;--立ちキャラ;----------------------------------
	mov $_char,"TCD"
	mov $debugstr,"立ち：TCD "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
