	mov $debugstr,"音声：CC0304"
	gosub *vo

	【明海】
	でも、朝ご飯はちゃんと食べないといけないわ。\
	dwavestop CH_VOICE	;CC0304

	【$g_hero】
	……………………………。\

	そうでした。
	僕は、うまくもない朝ご飯を律儀に食べて
	いたのだ。\

	先輩は、腕の時計をちらりと見た。
	華奢な皮バンドのちいさな時計だった。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCB"
	mov $debugstr,"立ち：TCB "
	gosub	*out	;画面に出力
