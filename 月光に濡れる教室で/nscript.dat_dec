	mov $debugstr,"■MPHB1 " : gosub *debugout
;■■■「月光に濡れる教室で、僕は。」台本：■矢崎：MP01
;━━━━━━━━━━━━━━
;■矢崎
;●真実
;○真実：１日目：学生会室

	;--BGM;----------------------------------
	mov $_music,"02": gosub *out
	;--背景;----------------------------------
	mov $_bg,"BG019A"
	mov $debugstr,"ＢＧ：BG019A"
	gosub *out	;画面に出力
;ＢＧ：BG019A;学生会室
;この台詞汎用。
	;--立ちキャラ;----------------------------------
	mov $_char,"THI"
	mov $debugstr,"立ち：THI "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"YMP0102"
	mov $debugstr,"音声：YMP0102 "
	gosub *vo

	【矢崎】
	やあ。何か聞きたいことでも？\
	dwavestop CH_VOICE	;YMP0102 

	【$g_hero】
	うん。なにか、矢崎の方で
	つかんだ情報ない？\
	;--立ちキャラ;----------------------------------
	mov $_char,"THC"
	mov $debugstr,"立ち：THC "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"YMP0103"
	mov $debugstr,"音声：YMP0103 "
	gosub *vo

	【矢崎】
	さっきまで、小林先輩の
	親御さんがきてたらしいよ。\
	dwavestop CH_VOICE	;YMP0103 

	【$g_hero】
	今頃？\
	;--立ちキャラ;----------------------------------
	mov $_char,"THA"
	mov $debugstr,"立ち：THA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"YMP0104"
	mov $debugstr,"音声：YMP0104 "
	gosub *vo

	【矢崎】
	忙しい家らしくて、
	なかなか捕まらなかったらしい。\
	dwavestop CH_VOICE	;YMP0104 

	【$g_hero】
	そっか…。\

	きっと、小林先輩の両親も考えもしなかったんだ
	ろうな。自分の娘が、今朝死にました、なんて。\

	…言葉にすると、ひどく妙な感じがした。\
	;--立ちキャラ;----------------------------------
	mov $_char,"THE"
	mov $debugstr,"立ち：THE "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"YMP0105"
	mov $debugstr,"音声：YMP0105 "
	gosub *vo

	【矢崎】
	にしても…自殺か…。\
	dwavestop CH_VOICE	;YMP0105 

	【$g_hero】
	矢崎は、否定的っぽいな。\
	;--立ちキャラ;----------------------------------
	mov $_char,"THC"
	mov $debugstr,"立ち：THC "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"YMP0106"
	mov $debugstr,"音声：YMP0106 "
	gosub *vo

	【矢崎】
	医者の子供なんでね。
	苦しんでるひとはいっぱい見てるから。\
	dwavestop CH_VOICE	;YMP0106 

	【$g_hero】
	ふうん…。\
	;--立ちキャラ;----------------------------------
	mov $_char,"THC"
	mov $debugstr,"立ち：THC "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"YMP0107"
	mov $debugstr,"音声：YMP0107 "
	gosub *vo

	【矢崎】
	だから、自分から死を選ぶひとの
	気持ちはわからないな。どうしてなんだろうね。\
	dwavestop CH_VOICE	;YMP0107 

	【$g_hero】
	……さあ…。\

	僕も、死んだらどうかなと
	考えたことぐらいはあるけれど、
	実際に、死にたいとまで思ったことはない。\

	そんなにまで苦しんだことがない…って
	もしかして、おめでたいのかな、僕は。\

