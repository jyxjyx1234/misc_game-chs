	mov $debugstr,"音声：BB1506"
	gosub *vo

	【真実】
	あの…ち、ちがうの…。
	もし…するふりをすれば…。\
	dwavestop CH_VOICE	;BB1506

	【$g_hero】
	あ！きっと犯人が来てるよな！
	だって居なきゃ、したかどうかわからないし。\
	;--立ちキャラ;----------------------------------
