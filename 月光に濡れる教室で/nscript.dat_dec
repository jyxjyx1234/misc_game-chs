	gosub *out	;画面に出力

	物事はすべて終わるのだ。
	どうしても止めておけずに、流れていくのだ。\

	だから、いいのかもしれないし、
	だから、切ないのかも知れない。\
	;--背景;----------------------------------
	mov $_bg,"BG001A"
	mov $debugstr,"ＢＧ：BG001A"
	mov %effect,4	;エフェクトを指定
	gosub *out	;画面に出力
