	mov $debugstr,"立ち：TEC "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XMP0805"
	mov $debugstr,"音声：XMP0805 "
	gosub *vo

	【菜摘先生】
	ああ、これ？　大貫君にと思って。\
	dwavestop CH_VOICE	;XMP0805 

	菜摘先生は、昨日の事件の起きた場所の近くに
	そっと花束を置いた。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TEC"
	mov $debugstr,"立ち：TEC "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XMP0806"
	mov $debugstr,"音声：XMP0806 "
	gosub *vo

	【菜摘先生】
	大丈夫、ここに来て？\
	dwavestop CH_VOICE	;XMP0806 

	【$g_hero】
	うん。もう…なんだか、あまりわからないね。\

	地面の黒い染みがそうなんだろうかと
	思わせるぐらいで、昨日の僕と
	小夜子が見た光景はもう遠かった。\

	【$g_hero】
	菜摘先生は、大貫君のこと知ってたの？\
	;--立ちキャラ;----------------------------------
	mov $_char,"TEI"
	mov $debugstr,"立ち：TEI "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XMP0807"
	mov $debugstr,"音声：XMP0807 "
	gosub *vo

	【菜摘先生】
	すこし、お話したことがあるから。
	守男先生に、アマレス部の見学に連れて行かれて。\
	dwavestop CH_VOICE	;XMP0807 

	【$g_hero】
	ふうん…。\

	守男先生、菜摘先生に気があるみたいだもんな。
	だからって、アマレス部の練習見せても
	女心はつかめないと思うけど。\

	【$g_hero】
	先生って、優しいな。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TEC"
	mov $debugstr,"立ち：TEC "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XMP0808"
	mov $debugstr,"音声：XMP0808 "
	gosub *vo

	【菜摘先生】
	…そうかしら…。わからないわ。
	ただ、こうしてあげたかったの。\
	dwavestop CH_VOICE	;XMP0808 

	【$g_hero】
	うん。\

	花っていいなと、僕は思った。\

	【$g_hero】
	僕も死んだときはこうやって花をもらいたいな。
	一度だけでもいいから。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TEA"
	mov $debugstr,"立ち：TEA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XMP0809"
	mov $debugstr,"音声：XMP0809 "
	gosub *vo

