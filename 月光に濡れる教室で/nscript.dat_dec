*OP20	; ■ファイル開始のラベル
	mov $debugstr,"■OP20" : gosub *debugout
;■■■「月光に濡れる教室で、僕は。」台本：●授業：執筆：OP20
;━━━━━━━━━━━━━━
;●授業：執筆

	;--BGM;----------------------------------
	mov $_music,"01": gosub *out
;BGM:さりげない日常
	gosub *blackout
	;--背景;----------------------------------
	mov $_bg,"BG009A"
	mov $debugstr,"ＢＧ：BG009A"
	gosub *out	;画面に出力
;ＢＧ：BG009A;２年教室

	１時間目は日本史だった。
	チミチミの授業だ。\

	チミチミは、治見先生という。
	だけど誰もその名前では呼ばない。\

	悪い先生じゃないけど、教科書を読むだけの
	退屈な授業だ。\

	つまらない授業に対してうちの学生は容赦ない。
	それぞれに適当な参考書を広げていたりする。\

	チミチミ…じゃなくて治見先生は全然構わないで
	授業してるんだけどね。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TYA"
	mov $debugstr,"立ち：TYA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"YOP2000"
	mov $debugstr,"音声：YOP2000 "
	gosub *vo

	【治見先生】
	今日は、昭和の歴代総理大臣についてだったかね。
	教科書の２０５ページを開いてくれたまえ。\
	dwavestop CH_VOICE	;YOP2000 

	うーん…現代史このまんまじゃ終わらないな。
	受験に現代史はほとんど出ないからな…。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TYA"
	mov $debugstr,"立ち：TYA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"YOP2001"
	mov $debugstr,"音声：YOP2001 "
	gosub *vo

	【治見先生】
	…であるからして…の総理大臣は…
	国鉄を民営化することに踏み切り……。\
	dwavestop CH_VOICE	;YOP2001 
	;-効果音;----------------------------------
	mov $_se,"ZCHORK"
	mov $debugstr,"ＳＥ：ZCHORK"
	gosub *se

	チミチミのお経のような声と
	チョークの音だけが響く。\
	gosub *clear_char

	退屈だな…。
	僕はため息をついて外を眺めた。\

	窓側の席でよかったな。４階建ての校舎。
	上から１年、２年、３年の順番で入る。\

	この教室は３階。二年の冬。
	窓の外はしらけた色の青空だった。\

	僕は、そっと一冊のノートを開いた。
	昨日購買で買ったばかりの大学ノートだ。\

	「お前の秘密を知っている。バラされたく
	　ないのなら、以下の指示に従うこと」\

	ここまで書いて、僕はペンを置いた。
	どうしようかな。\

	金を持ってこさせようか。誰かを殺させようか。
	職員室から答案を盗み出す…。\

	ああ、だめだだめだだめだ。陳腐すぎる。
	まったく、いいアイデアが思い浮かばない。\

	僕はシャーペンを机の上に放り出した。\

	退屈だな。ほんと。
	おもしろいことなんて、ろくにありゃしない。\

	そりゃ平凡な僕に、波瀾万丈の人生なんて
	起きるわけないけどさ。\

	期末試験も終わって、他のガッコなら試験休み
	だってのに、うちはフルに授業がある。\

	今は、授業中。先生はただ本を読むだけ。\

	みんなは好き勝手に塾の予習をしたり、ほかの
	参考書を解いたり。\

	ああ…。
	漫画の回し読みもないんだぜ？\

	そんなわけで僕は小説…モドキを書いていた。
	書いていたっていうよりは、
	書き始めたってとこだな。\

	学園ミステリーで、クラスメイトに脅迫状を
	出すところまで来たんだけど。\

	…思いつかないよなぁ…。\

	僕だったら、誰に、どんなことをしたいか。\

	クラスメイトと仲がいいってわけじゃないが、
	恨みに思うほどのつきあいもないしな。\

	徹底した個人主義だもんな。うちのガッコ。\

	男はやめとくか。男が男を恨みに思っても、
	つまんないよな。モンテ＝クリスト伯みたいに、
	ものすごい復習劇があるんだったら別だけど。\

	じゃあ女の子。…やっぱ、ちょっとはエロ
	ティックなことを入れたほうがいいよな。\

	うわぁ……。
	自分で考えながら照れてしまう。\

	そりゃ年相応に興味はあるけど、ネタに
	するのってアイドルとかその手の雑誌とか
	そういうんだし。\

	クラスメイトで考えたことは無かったんだよな。
	なんだか、生々しいじゃないか。そういうの。\

	…いやいや、ネタといっても、
	そっちのネタじゃなかったっけ。\

	僕はさりげなくクラス中を見回した。
	元が女子校だったということもあって、
	女子が２／３ぐらいを占めている。\

	けっこう美人も多い。そういや、それもこの
	ガッコの受験理由だっけ。\

	女子が多ければ僕だって、だれかと
	仲良くなれるのかも…って思ってたんだけど…。
	当てはずれたなぁ…。思いっきり。\

	えっと、ちがうって。
	話の相手だろ。\
;キャラクターの選択は10.TXTに記述してあります。<CR>

	return	;----------------------------------
;---OP20 END -----
