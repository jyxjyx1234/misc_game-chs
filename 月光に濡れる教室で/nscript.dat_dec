	mov $_se,"ZDOOROPEN"
	mov $debugstr,"ＳＥ：ZDOOROPEN "
	gosub *se
;ＢＧ：BG012B;保健室（夜）

	僕たちは、真夜中の保健室にやってきた。\

	【$g_hero】
	……少し寒いな。\

	さっきまでいた教室よりも、ずっと暗い。
	月が、あまり見えないんだ。\

	僕たちは、音を立てないようにして
	物陰に隠れた。\

	ドアから見えないように…
	戸棚へ行く途中で相手に見つからないように…。\

	【$g_hero】
	そういえば…先輩の携帯ってカメラついて
	なかった？\

	僕たちは、小声でぼそぼそと話す。
	いつ…誰が来るかもわからない。\

	僕も、先輩も緊張していた。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCD"
	mov $debugstr,"立ち：TCD "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC8200"
	mov $debugstr,"音声：CC8200"
	gosub *vo

	【明海】
	え…ええ……フラッシュは焚けないけど。\
	dwavestop CH_VOICE	;CC8200

	【$g_hero】
	ちょっと待ってて…きっと…どっかに
	懐中電灯が……。\

	僕は、机やロッカーを調べた。
	百合恵先生が、防災袋をどこかに置いていた
	はずなんだ。\

	百合恵先生って、豪快にみえるけど、
	結構シンパイ性だよな…。\

	【$g_hero】
	あったよ、ほら。
	これをフラッシュ代わりにすればいいよ。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCC"
	mov $debugstr,"立ち：TCC "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC8201"
	mov $debugstr,"音声：CC8201"
	gosub *vo

	【明海】
	ええ、そうね。
	………………来るかしら。\
	dwavestop CH_VOICE	;CC8201

	【$g_hero】
	わからないよ…。
	いや……きっと来るよ……。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCA"
	mov $debugstr,"立ち：TCA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC8202"
	mov $debugstr,"音声：CC8202"
	gosub *vo

	【明海】
	そうね……。\
	dwavestop CH_VOICE	;CC8202

	【$g_hero】
	少し……静かにしていた方がいいよね。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCC"
	mov $debugstr,"立ち：TCC "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC8203"
	mov $debugstr,"音声：CC8203"
	gosub *vo

	【明海】
	ええ……。\
	dwavestop CH_VOICE	;CC8203
	gosub *clear_char

	僕たちは机の影に、身を寄せた。
	ふたりで寄り添うようにして、座りこむ。\

	…隣の先輩の震えが伝わってきた。
	僕は、先輩を見た。\

	先輩は…携帯のカメラを両手でもったまま
	じっと一点を見つめてる。\

	僕は、その先輩の肩に自分の肩で触れた。
	触れた肩から、先輩の震えと…それから体温が
	伝わってきた。\

	きっと先輩にも、僕の温かさが届いてる。
	きっと…そのはずだ…。\

	次第に…先輩の呼吸は静かになっていった。
	段々と…震えも消えていった。\

	僕たちは無言で…互いのぬくもりを感じていた。
	先輩は僕の…僕は先輩のあたたかさを。\

	…………………………。
	…………………………。\
	;-効果音;----------------------------------
	mov $_se,"ZFOOT"
	mov $debugstr,"ＳＥ：ZFOOT "
	gosub *se
;ＳＥ：ZSCHOOLWALK;学校を歩く音

	コツ、コツ、コツ、コツ。\

	【$g_hero】
	………………。\

	誰かが、近づいてくる。
	僕は、時計を見た。\

	その行為で、
	自分が思ったより落ち着いているのがわかった。\

	時計は、午後零時を指そうとしていた。\
	;-効果音;----------------------------------
	mov $_se,"ZDOORSLIDE"
	mov $debugstr,"ＳＥ：ZDOORSLIDE"
	gosub *se
;ＳＥ：ZDOORSLIDE;教室ドアスライド音

	カタン…スーーーーー。\

	静かにドアが開く。
	僕たちは息を殺して、体を一層低くかがめる。\
	;-効果音;----------------------------------
	mov $_se,"ZFOOT"
	mov $debugstr,"ＳＥ：ZFOOT "
	gosub *se
;ＳＥ：ZSCHOOLWALK;学校を歩く音

	コツ、コツ、コツ、コツ。\

	もうすこし…もうすこしだ……。
	僕は、息をとめて…そのときを待った。\
	;-効果音;----------------------------------
	mov $_se,"ZFOOT"
	mov $debugstr,"ＳＥ：ZFOOT "
	gosub *se
;ＳＥ：ZSCHOOLWALK;学校を歩く音

	コツ、コツ、コツ、コツ……カツン。\
	gosub *sestop

	足音がとまった。
	僕たちは、互いを見合った。\

	静かにうなずきあう。
	もうすこし…あとすこしで………！\
	;-効果音;----------------------------------
	mov $_se,"ZKEY"
	mov $debugstr,"ＳＥ：ZKEY"
	gosub *se
;ＳＥ：ZKEY;鍵を回す（ガチャ）

	ガチャ、ガチャガチャ。\

	鍵が回って。\
	;-効果音;----------------------------------
	mov $_se,"ZNAWA"
	mov $debugstr,"ＳＥ：ZNAWA "
	gosub *se
;ＳＥ：ZTODANA;戸棚が開く音

	キィィィーーーー…。\

	戸棚が開いた。\

	【$g_hero】
	今だ！！！\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCE"
	mov $debugstr,"立ち：TCE "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC8204"
	mov $debugstr,"音声：CC8204"
	gosub *vo

	【明海】
	とまって！！！！
	あなたは、誰なの！？\
	dwavestop CH_VOICE	;CC8204

	return	;----------------------------------
