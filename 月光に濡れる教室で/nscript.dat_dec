;夜の教室

	【$g_hero】
	あれ？　誰もいないな…。
	もしもし～誰かいませんかー？\

	【？？？】
	……………………………。\

	【$g_hero】
	あれー…。
	いたずらだったのかな？\

	【？？？】
	……………………………。\

	【$g_hero】
	ちぇー…なんだ。せっかくここまで来たのに。
	来て損しちゃったな。\

	【$g_hero】
	…うう寒い。
	早く家に帰ろ…。\

	【？？？】
	……………………………さよなら。\

	【$g_hero】
	え？\

	背後からの突然のささやき。\

	ふり返った僕が見たものは、
	ギラギラ光る大振りのナイフの刃だった。\
	;-効果音;----------------------------------
	mov $_se,"ZBLOOD"
	mov $debugstr,"ＳＥ：ZBLOOD"
	gosub *se

	ブシュッ！！！\
	;--背景;----------------------------------
	mov $_bg,"BLOOD1B"
	mov $debugstr,"ＢＧ：BLOOD1B "
	mov %effect,1	;エフェクトを指定
	gosub *out	;画面に出力

	僕の背中をナイフが切り裂いた。
	焼けるような熱さに、僕は悲鳴をあげた。\

	【$g_hero】
	イタッ！！　痛い！痛い！！！
	やめ…っ…やめてくれ！！！！\
	;-効果音;----------------------------------
	mov $_se,"ZBLOOD"
	mov $debugstr,"ＳＥ：ZBLOOD"
	gosub *se
	;--背景;----------------------------------
	mov $_bg,"WHITE"
	mov $debugstr,"ＢＧ：WHITE "
	mov %effect,1	;エフェクトを指定
	gosub *out	;画面に出力
	;--背景;----------------------------------
	mov $_bg,"BLOOD1B"
	mov $debugstr,"ＢＧ：BLOOD1B "
	gosub *out	;画面に出力

	ブシュッ！！　ブシュ！！！！\
	;-効果音;----------------------------------
	mov $_se,"ZBLOOD"
	mov $debugstr,"ＳＥ：ZBLOOD"
	gosub *se

	ナイフの手は止まらない。\

	赤いナイフ。
	僕の中からドクドクと流れる血。\

	目の前が段々と暗くなっていく。\

	【$g_hero】
	やめて…やめ……や…。\

	弱々しい懇願に耳を貸さず、
	血まみれのナイフが僕の背中を深く突き刺した。\
	;-効果音;----------------------------------
	mov $_se,"ZBLOOD3"
	mov $debugstr,"ＳＥ：ZBLOOD3 "
	gosub *se
	;--背景;----------------------------------
	mov $_bg,"WHITE"
	mov $debugstr,"ＢＧ：WHITE "
	mov %effect,1	;エフェクトを指定
	gosub *out	;画面に出力

	ドシュッ！！！！\
	gosub *redout

	【$g_hero】
	ぐふっ！\
;倒れた音。
	;-効果音;----------------------------------
	mov $_se,"ZDOSA"
	mov $debugstr,"ＳＥ：ZDOSA "
	gosub *se

	ドサッ\
	gosub *blackout
;暗転

	【$g_hero】
	………………………。\

	【？？？】
	………………………。\

	;--BGM;----------------------------------
	mov $_music,"04": gosub *out
;BGM:哀
	;--背景;----------------------------------
	mov $_bg,"BG025B"
	mov $debugstr,"ＢＧ：BG025B"
	gosub *out	;画面に出力
;;屋上

	【？？？】
	………………………ごめんね。\

	【天使】
	だけど君の死には、意味があるから。\

	【天使】
	だから…君は死んでね。\

	だけどその声は、既に死んでしまった
	僕の耳には届かなかった。\

	mov %ending,BAD_END
	return	;----------------------------------
;---BAD  END -----
