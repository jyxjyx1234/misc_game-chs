	goto *pb_other
	

*pb_o9
	gosub *blackout
	gosub *set_message_window
	gosub *show_window

	gosub *OH_9TH

	gosub *hide_window
	gosub *blackout
	goto *pb_other
	
;--------------------------------------------------------------------------------------
	return


;9.TXT
;-------------------------------------------------------------------
*cgmode	;■ＣＧモード

*cg_select	;●キャラクタ選択
	;--BGM;----------------------------------
	mov $_music,"06": gosub *music
	csp -1 ;スプライトすべてクリア
	bg "sys/cg_select.jpg",0	;背景を表示
	lsp 0,":l/2,0,3;sys/cg_makoto.jpg",	 45,130	;真実
	lsp 1,":l/2,0,3;sys/cg_akemi.jpg",	225,130	;明海
	lsp 2,":l/2,0,3;sys/cg_sayoko.jpg",	405,130	;小夜子
	lsp 3,":l/2,0,3;sys/cg_others.jpg",	585,130	;その他
	lsp 4,":a/2,0,3;sys/modoru.jpg",	360, 550

	btndef ""
	spbtn 0,1
	spbtn 1,2
	spbtn 2,3
	spbtn 3,4
	spbtn 4,5
	print BG_EFFECT	

*cg_select_lp
	btnwait %work
	if %work==MOUSE_RBUTTON  gosub *click : csp -1 : goto *title
	if %work==KEY_ESCAPE     gosub *click : csp -1 : goto *title
	if %work==0 goto *cg_select_lp
	if %work==1 gosub *click: csp -1 : goto *cg_makoto
	if %work==2 gosub *click: csp -1 : goto *cg_akemi
	if %work==3 gosub *click: csp -1 : goto *cg_sayoko
	if %work==4 gosub *click: csp -1 : goto *cg_other
	if %work==5 gosub *click: csp -1 : goto *title	;戻る
	goto *cg_select_lp

