;■プロローグ
;●プロローグ

	;--BGM;----------------------------------
	mov $_music,"06": gosub *out
;BGM:愛
	;--背景;----------------------------------
	mov $_bg,"BG014C"
	mov $debugstr,"ＢＧ：BG014C"
	mov %effect,6	;エフェクトを指定
	gosub *out	;画面に出力
;;校門

	憧れとか、ただの好きとか。
	そういうものは、これまでにも、あったけど。\

	恋をしたことなんて、なくて。
	本気で好きになったことなんて、なくて。\

	だから気が付かなかった。\

	恋をして。
	君を知った。
	僕を知った。\
	gosub *whiteout

	;--BGM;----------------------------------
	mov $_music,"01": gosub *out
;●朝
	;--背景;----------------------------------
	mov $_bg,"BG001A"
	mov $debugstr,"ＢＧ：BG001A"
	mov %effect,5	;エフェクトを指定
	gosub *out	;画面に出力
	;-効果音;----------------------------------
	mov $_se,"ZSUZUME"
	mov $debugstr,"ＳＥ：ZSUZUME "
	gosub *se
;ＢＧ：BG001A;主人公の部屋

	３月。
	季節は、まだ春の手前だった。\

	暦の上では、すっかり春だし、駅前のデパートの
	ショウウィンドウには、ピンクの春物が
	ディスプレイされてるけど、まだ風は冷たい。\

	だから、僕はまだ春じゃないって思ってる。
	朝の空は、まだ冬の青。
	春がくる前の、どこか冷たい色。\
	;-効果音;----------------------------------
	mov $_se,"ZDOORC"
	mov $debugstr,"ＳＥ：ZDOORC"
	gosub *se
	;--背景;----------------------------------
	mov $_bg,"BG002A"
	mov $debugstr,"ＢＧ：BG002A"
	gosub *out	;画面に出力
;ＢＧ：BG002A;主人公の家

	【$g_hero】
	行ってきます。\

	僕は白い息を吐きながら、家を出る。
	いつもと変わらない毎日だった。\

	いつもと同じに家を出て、
	いつもと同じ道を通って。\

	いつもと同じに授業に出て、
	いつもと変わらずに家に帰って。\

	三学期も終わりに近い。
	もうすぐ卒業式があって
	終業式があって、春休みを迎える。\

	そしてまた新学期。
	季節が変わっただけの変わらない日常。
	そんな何一つ変わらない日々をくり返す筈だった。\

	あまりにそれは当たり前すぎて…。
	空が決して落ちてこない位に
	信じて疑わないことだった。\

	そう、その日までは。\
;■キャラ選択
;どうやって選択しようか？
;マップ移動で、まず出会って。
;そのあと小説を書くときに、相手を選択。
	gosub *blackout

	return	;----------------------------------
;---OP01 END -----
