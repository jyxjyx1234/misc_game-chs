*B00	; ■ファイル開始のラベル
	mov $debugstr,"■B00 " : gosub *debugout
;■■■「月光に濡れる教室で、僕は。」台本：■真実：B00
;━━━━━━━━━━━━━━
;■真実
;■ＯＰＨ

	;--BGM;----------------------------------
	mov $_music,"04": gosub *out
;BGM:迷
	;--背景;----------------------------------
	mov $_bg,"BG020B"
	mov $debugstr,"ＢＧ：BG020B"
	gosub *out	;画面に出力
;ＢＧ：BG020B;使われてない教室（調教用）

	だれもいないはずの教室なのに、窓から差し込む
	月光に照らされて浮かび上がるシルエットがある。\
;１２３４５６７８９０１２３４５６７８９０１２
	;--立ちキャラ;----------------------------------
	mov $_char,"TBC"
	mov $debugstr,"立ち：TBC "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"BB0000"
	mov $debugstr,"音声：BB0000"
	gosub *vo

	【真実】
	やっぱり…本当だったんだ…。\
	dwavestop CH_VOICE	;BB0000
	if %g_nomegane==OFF goto *MEGANE_B00

	眼鏡を外して、髪をほどいている
	その姿は、いつもと違っていたけれど。\

	すこし怯えたようなその声。
	白い花みたいな小さな顔。\

	それを僕はよく知っていた。\
	goto *nextB00	;nextB00へ移動
;----------------------------------
*MEGANE_B00

	三つ編みに眼鏡。
	それから、すこし怯えたようなその声。\

	それを僕はよく知っていた。\
;----------------------------------
*nextB00

	【$g_hero】
	な、なんで、真実がここに？\

	僕の疑問には、真実は答えなかった。
	その代わりに真実は目を伏せた。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TBG"
	mov $debugstr,"立ち：TBG "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"BB0001"
	mov $debugstr,"音声：BB0001"
	gosub *vo

	【真実】
	…言われたとおりに、してきたから。\
	dwavestop CH_VOICE	;BB0001

	ぽつりと言う。まるでだれかに
	命じられたみたいに。誰に？\

	けれども、真実の声音にはどこか僕の知らない
	匂いがした。なにか、じくじくとしたような熱。\

	【$g_hero】
	言われたとおり…って？\

	真実は、スカートに手を添えた。\
	;-- イベントCG;----------------------------------
	mov $_cg,"B01A"
	mov $debugstr,"ＣＧ：B01A"
	gosub *cgout	;イベントＣＧ

	【$g_hero】
	えっ…？\
	;-音声;----------------------------------
	mov $_voice,"BB0002"
	mov $debugstr,"音声：BB0002"
	gosub *vo

	【真実】
	…くっ……。\
	dwavestop CH_VOICE	;BB0002

	真実は口にスカートを銜えて、
	自分の下半身をあらわにしている。\

	ちいさな下着から、妙に脳天気な色のコードが
	生えている。真実には似合わない色だった。\

	僕の目は、その部分に吸い寄せられた。\
	;-音声;----------------------------------
	mov $_voice,"BB0003"
	mov $debugstr,"音声：BB0003"
	gosub *vo

	【真実】
	こう…だよね…。\
	dwavestop CH_VOICE	;BB0003

	真実のビヴラートのかかった声に欲望の温度は
	なかった。少なくとも僕はそう思った。\

	その表情と、この状況で、怯えているはずなのに
	どうして、そんなに冷静なように見えるのだろう。\

	今にも泣きそうな顔をしているのに。\

	【$g_hero】
	なんで…僕の書いたとおりにしてるの…？\

	真実は答えなかった。\

	;--BGM;----------------------------------
	mov $_music,"09": gosub *out
	;-音声;----------------------------------
	mov $_voice,"BB0004"
	mov $debugstr,"音声：BB0004"
	gosub *vo

	【真実】
	…犯してください。\
	dwavestop CH_VOICE	;BB0004

	それは、僕が書いた台詞と同じだった。\

	僕はごくんと唾を飲んだ。\

	どうして、こんな状況なのに興奮してるんだろう。
	こんな、何もわからないのに。\

	誰が、僕を呼び出したのか。
	誰が、真実にこんなことをさせたのか。\

	何もわからないのに。
	それなのに真実から目を離せなかった。\

	寒さのせいか真っ白く血の気のない
	やわらかそうな太股。なだらかな曲線の腹部。\
	;-Ｈ効果音;----------------------------------
	mov $_se,"WB010"
	mov $debugstr,"Ｈ音：WB010 "
	gosub *se

	月の冷たい明かりに照らされて、下着の中で
	緩やかに動くローター。羽音みたいな機械の音。\

	【$g_hero】
	その道具…どうしたの？\

	真実は、いぶかしげな目で僕をみた。
	知っているくせに、どうしてたずねるの？
	そんな表情だった。\
	;-音声;----------------------------------
	mov $_voice,"BB0005"
	mov $debugstr,"音声：BB0005"
	gosub *vo

	【真実】
	言われたとおりに…。手紙に入っていたから…。\
	dwavestop CH_VOICE	;BB0005

	僕の名前を騙ったヤツがそうしたのか。
	じゃあ、今どこかで僕らを見ているのか？\
	;-音声;----------------------------------
	mov $_voice,"BB0006"
	mov $debugstr,"音声：BB0006"
	gosub *vo

	【真実】
	ん……。\
	dwavestop CH_VOICE	;BB0006
	;-Ｈ効果音;----------------------------------
	mov $_se,"WB010"
	mov $debugstr,"Ｈ音：WB010 "
	gosub *se

	真実の下着が、股間からだんだんと変色していく。
	僕が見ているせいなんだろうか。
	おもちゃのせいなんだろうか。\

	【$g_hero】
	濡れてる…。感じてるの？\

	下種な質問だ。
	その言葉が口から出てから、僕はそう思った。\

	真実が、顔を真っ赤に染めた。
	スカートをくわえた口がきゅっとすぼまる。\

	その表情に、僕は興奮した。
	どうしようもなく、興奮した。\

	真実を犯したいと思った。\

	こんなところで。
	こんな月の明かりだけの中で。\

	自分のペ○スが、服の中で痛い。
	息をすると、身動きをすると、布で擦れて、
	それでさえ、自分への刺激になってしまう。\

	真実はきっと僕を恐れていて。
	真実はきっと僕を憎んでいるんだろうに。\

	それなのに、僕は欲情した。
	真実の下着をはぎ取って、その中が見たかった。\

	ああ。僕は、こんな人間だったのか。
	でも、でも、でも。\

	ああ、もういい。\

	僕は真実が欲しい。真実を犯したい。
	僕の真実は、今はそれだけだ。\

	僕は変だ。おかしいんだ。ダメなんだ。
	きっと狂ってる。あとで絶対後悔する。\

	それがわかってるのに、僕は言うんだ。\

	【$g_hero】
	見せてよ。\
	;-音声;----------------------------------
	mov $_voice,"BB0007"
	mov $debugstr,"音声：BB0007"
	gosub *vo

	【真実】
	…何…？\
	dwavestop CH_VOICE	;BB0007

	もごもごと不鮮明な声で真実が答える。
	真実の声には相変わらず色がなくて
	つめたい、水の中に居るみたいな声だった。\

	【$g_hero】
	真実、見せてよ。
	全部、僕に見せてよ。\

	真実は、僕を見つめた。
	怯えているのに、どこか静かな瞳だった。\

	細い白い指が、下着にかかる。
	ゆっくりと足から、下着が脱ぎとられるのを
	僕は夢の中の出来事のように見つめていた。\
	;-- イベントCG;----------------------------------
	mov $_cg,"B01B"
	mov $debugstr,"ＣＧ：B01B"
	gosub *cgout	;イベントＣＧ

	ふぁさっ…と音がして、真実から小さな布きれが
	落ちる。僕の目は、真実のそこから離れない。\
	;-音声;----------------------------------
	mov $_voice,"BB0008"
	mov $debugstr,"音声：BB0008"
	gosub *vo

	【真実】
	ん……。\
	dwavestop CH_VOICE	;BB0008
	;-効果音;----------------------------------
	mov $_se,"ZSWITCH"
	mov $debugstr,"ＳＥ：ZSWITCH "
	gosub *se

	真実は、居場所を失ったローターのスイッチを
	カチリと切る。彼女の白い手の中の
	プラスチックは、じっとりと濡れていた。\

	【$g_hero】
	もっと、見せて。\

	僕はねだった。
	真実は抵抗しなかった。\
	;-音声;----------------------------------
	mov $_voice,"BB0009"
	mov $debugstr,"音声：BB0009"
	gosub *vo

	【真実】
	どうすれば、いいの？\
	dwavestop CH_VOICE	;BB0009

	【$g_hero】
	こっちに来て。触らせて。\
	;-音声;----------------------------------
	mov $_voice,"BB0010"
	mov $debugstr,"音声：BB0010"
	gosub *vo

	【真実】
	…うん。\
	dwavestop CH_VOICE	;BB0010

	僕は真実に、そっと触れた。
	直接「そこ」に触れることは、なぜか怖くて
	ゆっくりと、丸い尻から触っていく。\

	【$g_hero】
	すべすべしてる。\

	【真実】
	………。\

	冬の外気にさらされているせいか、
	ひんやりとしている。\

	その、冷たい真実の肌に比べて、
	僕の手は信じられないぐらい熱かった。
	手の動きにそって、真実の体がひくひくと震える。\

	【$g_hero】
	寒いの、真実？\
	;-音声;----------------------------------
	mov $_voice,"BB0011"
	mov $debugstr,"音声：BB0011"
	gosub *vo

	【真実】
	…うん。\
	dwavestop CH_VOICE	;BB0011

	真実に熱をあげるように、
	僕は彼女の体をゆっくりと触った。\

	【$g_hero】
	真実の体って、絹みたいだな。\
	;-音声;----------------------------------
	mov $_voice,"BB0012"
	mov $debugstr,"音声：BB0012"
	gosub *vo

	【真実】
	…そうかな…。\
	dwavestop CH_VOICE	;BB0012

	幼い頃にふれた、母の大事な着物を思い出す。
	ひんやりとして、すべすべしたその感触が
	たのしくて、ずっと頬を押しつけていた。\

	僕って…変なのかな。
	真実にふれて、そんな事を思うなんて。\

	真実の滑らかな腹を撫でて、太股をなでた。
	それでも、真実の体はちっとも熱くならない。
	ただ、冷たいままで、震えていた。\

	【$g_hero】
	感じないの、真実？\

	震えているのは、僕が触っているせいなのか。
	この教室の凍るような寒さのせいか。\

	【真実】
	……………………………。\

	その変化のなさが、僕をいらだたせる。
	苛立つ？　どうして？\

	【$g_hero】
	なんで何も言わないの？\

	いやなら、やめろって言えばいいのに。
	真実の目は嫌悪でも憎悪でもなかった。\

	臆病な子犬みたいに、僕を見ている。
	わめいたら、怒られてしまうみたいに。\

	【真実】
	……………………。\

	【$g_hero】
	止めないなら、するよ。\

	僕は、すごく「いけないこと」をしている。
	それが、僕の嗜虐心を刺激する。\

	嗜虐心。そうだ。そんなものがあるなんて、
	今まで考えたこともなかったのに。\

	でも、そうしたい。
	今、僕は、真実を犯したい。\

	そう考えるたびに自分の心が熱く燃える。
	だけど。ひとりで、僕ひとりで、
	そんな風に熱くなっているのが許せなくて。\

	【$g_hero】
	真実も、感じてよ。\
	;-音声;----------------------------------
	mov $_voice,"BB0013"
	mov $debugstr,"音声：BB0013"
	gosub *vo

	【真実】
	で…でも…。\
	dwavestop CH_VOICE	;BB0013

	【$g_hero】
	足、広げてよ。\

	僕は真実の足の間に、指を差し入れた。\
	;-Ｈ効果音;----------------------------------
	mov $_se,"WA004"
	mov $debugstr,"Ｈ音：WA004 "
	gosub *se
;指を入れる（ちょっと）ぬちゃ……

	くちゅっ…。\

	【$g_hero】
	熱い…。\

	真実のそこは、そこだけは嘘のように熱かった。\
	;-音声;----------------------------------
	mov $_voice,"BB0014"
	mov $debugstr,"音声：BB0014"
	gosub *vo

	【真実】
	く…んっ…！\
	dwavestop CH_VOICE	;BB0014
	;-Ｈ効果音;----------------------------------
	mov $_se,"WA001"
	mov $debugstr,"Ｈ音：WA001 "
	gosub *se
;指先で広げる（くぱぁ…）

	【$g_hero】
	濡れてる。びしょびしょだ…。\

	やわらかな恥毛の上の方はまだ、やわらかく
	ふわふわしているのに、指を差し入れた部分は
	じっとりと潤んで濡れている。\
	;-音声;----------------------------------
	mov $_voice,"BB0015"
	mov $debugstr,"音声：BB0015"
	gosub *vo

	【真実】
	ご…ごめんなさい…。\
	dwavestop CH_VOICE	;BB0015
	;-Ｈ効果音;----------------------------------
	mov $_se,"WA003"
	mov $debugstr,"Ｈ音：WA003 "
	gosub *se
;たくさんの指でいじる（ぬちゅっ！ぬちゅっ！）

	【$g_hero】
	どうして謝るの？\
	;-音声;----------------------------------
	mov $_voice,"BB0016"
	mov $debugstr,"音声：BB0016"
	gosub *vo

	【真実】
	だ…だって…汚いから…。\
	dwavestop CH_VOICE	;BB0016
	;-Ｈ効果音;----------------------------------
	mov $_se,"WC001"
	mov $debugstr,"Ｈ音：WC001 "
	gosub *se

	【$g_hero】
	汚いのは、僕の方だと思うけれど。\

	こんな場所で。教室で。クラスメイトを
	犯そうとしている僕のほうがよっぽど汚い。\
	;-音声;----------------------------------
	mov $_voice,"BB0017"
	mov $debugstr,"音声：BB0017"
	gosub *vo

	【真実】
	どうして？\
	dwavestop CH_VOICE	;BB0017
	;-Ｈ効果音;----------------------------------
	mov $_se,"WA005"
	mov $debugstr,"Ｈ音：WA005 "
	gosub *se
;指で中をかきまわす

	だけど、もう止められない。
	真実の濡れた花弁を触って、
	指で探って、中をさぐって。もっと。\

	【$g_hero】
	真実に、したいから。\
	;-音声;----------------------------------
	mov $_voice,"BB0018"
	mov $debugstr,"音声：BB0018"
	gosub *vo

	【真実】
	…いいよ。\
	dwavestop CH_VOICE	;BB0018

	真実は小さく肯いた。\
	;-Ｈ効果音;----------------------------------
	mov $_se,"WB005"
	mov $debugstr,"Ｈ音：WB005 "
	gosub *se

	【$g_hero】
	どうして？\

	嫌がらないの？\
;きみなら
	;-音声;----------------------------------
	mov $_voice,"BB0019"
	mov $debugstr,"音声：BB0019"
	gosub *vo

	【真実】
	$g_fname君なら、いいよ。\
	dwavestop CH_VOICE	;BB0019
	;-Ｈ効果音;----------------------------------
	mov $_se,"WA009"
	mov $debugstr,"Ｈ音：WA009 "
	gosub *se
;ぬちょぬちょ長め

	そういう言い方はずるいよ、真実。
	まるで僕たち、恋人同士みたいじゃないか。\

	今の僕に、そんなことを言うなんて。
	僕は、セックスしたいだけなのに。
	何をするか、わからないのに。\
	;-Ｈ効果音;----------------------------------
	mov $_se,"WA002"
	mov $debugstr,"Ｈ音：WA002 "
	gosub *se

	【$g_hero】
	どうして、そんなこと言えるの？\
	;-音声;----------------------------------
	mov $_voice,"BB0020"
	mov $debugstr,"音声：BB0020"
	gosub *vo

	【真実】
	わからない…。でも。\
	dwavestop CH_VOICE	;BB0020
	;-Ｈ効果音;----------------------------------
	mov $_se,"WA008"
	mov $debugstr,"Ｈ音：WA008 "
	gosub *se

	真実は、じっと僕を見た。
	下半身をさらけ出して、濡れた花弁を僕に
	触られて、こんな淫らなことをして。\

	それでも、月に照らされた真実はとても奇麗で。
	僕は、その真実に欲情した。\

	【$g_hero】
	もっとこっちに、来てよ。\
	;-音声;----------------------------------
	mov $_voice,"BB0021"
	mov $debugstr,"音声：BB0021"
	gosub *vo

	【真実】
	うん…。\
	dwavestop CH_VOICE	;BB0021

	真実は、すこしだけ躊躇したあと
	僕に身をまかせた。\

	僕は、真実のブラウスのボタンをはずした。\
	;-- イベントCG;----------------------------------
	mov $_cg,"B02A"
	mov $debugstr,"ＣＧ：B02A"
	gosub *cgout	;イベントＣＧ

	【$g_hero】
	すご…。おおきい…。\

	僕は生唾をのみこみながら、
	真実の胸に目を奪われた。\

	きれいな形だった。まるくて、張りがあって
	つんと上の方を向いているのに、
	重みですこしたわんでいて。\

	先端の赤く色づいた乳首が、月明かりで
	いやらしく光ってる。\

	なんで赤いんだろう。唇みたいだよな。\
	;-Ｈ効果音;----------------------------------
	mov $_se,"WD002"
	mov $debugstr,"Ｈ音：WD002 "
	gosub *se

	僕は思わず、真実の胸をすくい上げるようにして
	自分の唇で、赤い乳首をくわえてしまった。\
	;-音声;----------------------------------
	mov $_voice,"BB0022"
	mov $debugstr,"音声：BB0022"
	gosub *vo

	【真実】
	んっ！！\
	dwavestop CH_VOICE	;BB0022
	;-Ｈ効果音;----------------------------------
	mov $_se,"WM02"
	mov $debugstr,"Ｈ音：WM02"
	gosub *se

	唇の中で、真実の乳首は硬度を増していく。
	顔をずらして、柔らかな白い肌も舐める。\

	ぜんぜん…ちがう…。\

	乳輪と乳首のところの感触と、
	真実の白桃みたいなおっぱいの感触は
	まったくちがっていた。\

	たまらなくなって、僕は、真実の胸を
	きゅっとつかんだ。\
	;-音声;----------------------------------
	mov $_voice,"BB0023"
	mov $debugstr,"音声：BB0023"
	gosub *vo

	【真実】
	んくっ…！\
	dwavestop CH_VOICE	;BB0023

	信じられないぐらい、柔らかい。
	とろけそうなほど柔らかいのに、弾力があって。\

	指にかるく力を込める。指が白い肌にめり込む。
	力を抜くと、指が真実の肌に押し返される。\
	;-Ｈ効果音;----------------------------------
	mov $_se,"WM03A"
	mov $debugstr,"Ｈ音：WM03A "
	gosub *se

	【$g_hero】
	真実…。\

	僕は舌と唇と指先で、真実の胸を味わっていた。
	女の子の肌って、なんてやわらかいんだろう。\

	やわらかくて、気持ちよくて、
	食べてしまいたいと思った。\

	乳首に歯をたてると、
	コリッ…とした感触がつたわってくる。\
	;-音声;----------------------------------
	mov $_voice,"BB0024"
	mov $debugstr,"音声：BB0024"
	gosub *vo

	【真実】
	んあっ！！\
	dwavestop CH_VOICE	;BB0024
	;-Ｈ効果音;----------------------------------
	mov $_se,"WD002"
	mov $debugstr,"Ｈ音：WD002 "
	gosub *se

	それが楽しくて、何度も繰り返す。
	歯で噛んで、舌先でなぶる。\
	;-音声;----------------------------------
	mov $_voice,"BB0025"
	mov $debugstr,"音声：BB0025"
	gosub *vo

	【真実】
	んっ…だ…だめっ…！\
	dwavestop CH_VOICE	;BB0025
	;-Ｈ効果音;----------------------------------
	mov $_se,"WM04"
	mov $debugstr,"Ｈ音：WM04"
	gosub *se

	【$g_hero】
	すご…。どんどん固くなる…。
	まるで男のアレみたいだな。\

	サイズがぜんぜん違うけど。そう言うと
	真実はイヤイヤをするように首を振った。\

	【$g_hero】
