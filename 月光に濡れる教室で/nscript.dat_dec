	;-音声;----------------------------------
	mov $_voice,"CC1706"
	mov $debugstr,"音声：CC1706"
	gosub *vo

	【明海】
	…きっと裏庭だわ。
	探してこなくちゃ……！！\
	dwavestop CH_VOICE	;CC1706

	先輩が、そのまま走り出そうとした。
	僕は、先輩をあわてて押しとどめた。\

	【$g_hero】
	ちょっ、先輩待ってよ！
	今から裏庭に行くの？\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCA"
	mov $debugstr,"立ち：TCA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC1707"
	mov $debugstr,"音声：CC1707"
	gosub *vo

	【明海】
	そうよ。誰かに見つからない内に
	探さないと…困るでしょ？\
	dwavestop CH_VOICE	;CC1707

	【$g_hero】
	落ち着いてよ、先輩。
	今、僕たちが裏庭に行ったらどうなると思う？\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCC"
	mov $debugstr,"立ち：TCC "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC1708"
	mov $debugstr,"音声：CC1708"
	gosub *vo

	【明海】
	どうなるって…。\
	dwavestop CH_VOICE	;CC1708

	先輩…。
	いつもはあんなに頭の回転が速いのに。\

	【$g_hero】
	だからさ、あんなことがあった場所に
	犯人だって疑われている僕たちが行ったらさ…。\

	【$g_hero】
	それこそ疑ってくれって、言っているような
	ものじゃないか。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCD"
	mov $debugstr,"立ち：TCD "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC1709"
	mov $debugstr,"音声：CC1709"
	gosub *vo

	【明海】
	あ…。そ、そ…うよね…。\
	dwavestop CH_VOICE	;CC1709

	先輩はようやくその事に気づいたようだった。
	…意外にそそっかしいよな。先輩。\

	いや、意外じゃないぞ。
	そんな所は、昔と何も変わってないんだ。\

	【$g_hero】
	あのさ、そういうトコ変わってないよね。
	そういう、おっちょこちょいな所。\

	;--BGM;----------------------------------
	mov $_music,"06": gosub *out
	;--立ちキャラ;----------------------------------
	mov $_char,"TCC"
	mov $debugstr,"立ち：TCC "
	gosub	*out	;画面に出力

	【明海】
	……………。\

	先輩が、表情を曇らせた。
	僕から視線をはずして、うつむいてしまう。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCJ"
	mov $debugstr,"立ち：TCJ "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC1710"
	mov $debugstr,"音声：CC1710"
	gosub *vo

	【明海】
	……。キミにとって私は…今でも幼なじみの
	“明海ちゃん”なのね。\
	dwavestop CH_VOICE	;CC1710

	【$g_hero】
	……………………。\

	そんなこと、言われても困るよ。
	だって明海ちゃんは、明海ちゃんじゃないか。\

	それに、わからない「皆月先輩」よりも
	知っている「明海ちゃん」の方が安心するんだ。\

	それってずるいのかな。
	だけど、「皆月先輩」は何も教えてくれないから。\

	いつも黙ってしまうから。
	肝心な所で、何も話してくれないから。\

	教えてくれないと、不安だよ。
	話してくれないと、わからないよ。\

	…だからもっと話をしてよ、先輩。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCI"
	mov $debugstr,"立ち：TCI "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC1711"
	mov $debugstr,"音声：CC1711"
	gosub *vo

	【明海】
	…あんなことがあっても。\
	dwavestop CH_VOICE	;CC1711

	【$g_hero】
	だって…あれは…その…。\

	僕は、狼狽えた。
	だってあれは…「天使」に呼ばれて。\

	僕も、先輩も…騙されて。誤解して。\

	…だからと言って、僕のした事がチャラになる
	ワケじゃないけど。\

	いや？　騙されて？
	先輩は騙されて来たんだろうか？\

	先輩はどうして、カードの命令を聞いたんだろう。
	…僕が来ると思っていたみたいだったけど。\

	僕のメッセージは“夜の校庭に行け”だった。\

	あの位の指示ならば、人並みの好奇心があって、
	よっぽどの恐がりでなければ出来るだろう。\

	だけど先輩は？\

	あんな…モノを入れて、夜の校庭で一人で
	待っていた。\

	先輩はどうして、そんな命令を聞いたんだろう？
	何か…事情があったんだろうか。\

	【$g_hero】
	あ…あのさ…。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCC"
	mov $debugstr,"立ち：TCC "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC1712"
	mov $debugstr,"音声：CC1712"
	gosub *vo

	【明海】
	私は違うの。\
	dwavestop CH_VOICE	;CC1712

	【$g_hero】
	え？\

	僕が、目をパチクリさせる。
	何が？　何が違うんだ？\

	先輩は、いつの間にか僕を見あげていた。\

	真剣な目をして。
	あの真っ直ぐな目に、不思議な決意をたたえて。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCI"
	mov $debugstr,"立ち：TCI "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC1713"
	mov $debugstr,"音声：CC1713"
	gosub *vo

	【明海】
	私は、違うの。もう、違うのよ。\
	dwavestop CH_VOICE	;CC1713

	【$g_hero】
	だからその…何が…。\

	先輩の目が、揺らいだ。
	残念とか…哀しい…とかじゃなくて。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCA"
	mov $debugstr,"立ち：TCA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC1714"
	mov $debugstr,"音声：CC1714"
	gosub *vo

	【明海】
	………いいの。
	行きましょう、$g_fname君。\
	dwavestop CH_VOICE	;CC1714

	いやよくない。よくないけど。
	先輩は、そこで会話をとめてしまった。\

	止められてしまったら、会話を再開させる方法も、
	強引に会話を戻す度胸も、僕にはない。\

	…………。
	やっぱり先輩はよくわからない。\

	僕たちは、踊り場を離れた。\
	gosub *blackout

