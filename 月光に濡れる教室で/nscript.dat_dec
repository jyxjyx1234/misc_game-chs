	mov	%map01,0	;-01:１年教室
	mov	%map02,18	;18:桜井　真実-02:２年教室
	mov	%map03,0	;-03:３年教室
	mov	%map04,0	;-04:保健室
	mov	%map05,0	;-05:裏庭
	mov	%map06,20	;20:芹沢　小夜子-06:コーラス部室（音楽室）
	mov	%map07,19	;19:皆月　明海-07:学生会室
	mov	%map08,0	;-08:体育館
if %g_trueroot==OFF	mov	%map09,0	;-09:職員室
if %g_trueroot==ON	mov	%map09,01	;01:藍田　菜摘-09:職員室
	mov	%map10,0	;-10:屋上
	mov	%map11,0	;-11:購買
	mov	%map12,0	;-12:美術部部室
