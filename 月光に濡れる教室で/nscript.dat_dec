	mov $debugstr,"音声：BOP0303 "
	gosub *vo

	【真実】
	その…気になったから、やっただけ。\
	dwavestop CH_VOICE	;BOP0303 

	よく見ると黒板だけでなく、教卓のまわりも
	綺麗になっている。新しい花がロッカーの上に
	飾ってあった。赤い、梅の花だ。\

	【$g_hero】
	もしかして、その梅も
	桜井が生けたの？\

	僕は、カバンを自分の席に置くと
	梅の花の前に向かった。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TBD"
	mov $debugstr,"立ち：TBD "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"BOP0304"
	mov $debugstr,"音声：BOP0304 "
	gosub *vo

	【真実】
	え？う…うん…。
	もしかして、梅の花…きらい？\
	dwavestop CH_VOICE	;BOP0304 

	僕は梅の花に顔を近づけて、
	くんと匂いをかいだ。\

	【$g_hero】
	嫌いじゃないよ。いい匂いがする。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TBA"
	mov $debugstr,"立ち：TBA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"BOP0305"
	mov $debugstr,"音声：BOP0305 "
	gosub *vo

	【真実】
	よかった…。\
	dwavestop CH_VOICE	;BOP0305 

	【$g_hero】
	前から、たまに生けてあったけど
	もしかして、桜井がやってんの？\
	;--立ちキャラ;----------------------------------
	mov $_char,"TBD"
	mov $debugstr,"立ち：TBD "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"BOP0306"
	mov $debugstr,"音声：BOP0306 "
	gosub *vo

	【真実】
	え？う…うん…。あ、でも菜摘先生が
	お花もってきてくれるときもあるよ。\
	dwavestop CH_VOICE	;BOP0306 

	菜摘先生というのは、僕たちの担任の先生だ。\

	【$g_hero】
	へぇ。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TBA"
	mov $debugstr,"立ち：TBA "
	gosub	*out	;画面に出力

	桜井は、僕の隣にやってきて、赤い梅の花を
	撫でるように、そっと白い手をかざした。\

	ほっそりした綺麗な手だな、と僕は思った。
	黒板の掃除をしたせいか、指先は寒そうに
	赤くなっている。\

	僕が朝早く教室に来るようになったのは
	実は３学期になってからだ。\

	朝練もあるから、ガッコに来るのは早かったけど、
	それまでは音楽室に直行していた。\

	だけど何かの折りに、
	桜井が掃除してるのを見かけて。\

	それから僕は、
	朝の教室にむかう回数が増えた。\

	だってよく見ると…いや実はよく見なくても
	桜井はかわいい。\

	やぼったい感じで人気はないけど
	間違いなく、うちのクラスで…
	いや、学年でも１，２を争う美人だと思う。\

	何もしてない肌は透き通るように白いし、
	まつげもすごく長い。
	唇はほんとにピンク色で、つやつやしているし。\

	でも、残念ながら桜井は思いっきり目立たない。
	クラスの男子仲間での女子の人気をとったとき
	（そういうの、やるだろ？）\

	ぜんぜん桜井の名前があがらないので
	僕はびっくりしたことがある。\

	派手な子の方が、結構目を惹くんだよな。
	私を見て！ってタイプのほうが、目立つし。\

	だけど僕は桜井みたいなタイプ…嫌いじゃないな。
	だから…こうして話すようになったんだけど。\

	桜井は人と会話するのが苦手みたいだから
	すぐに打ち解けることはできなかった。\

	だから三学期も終わりになってようやく
	普通に会話ができるようになった程度だ。\

	これじゃ普通のクラスメイトとあんまり
	変わらないかも…。\

	なかなかうまくいかないものだ。\

	それでも、かわいい子と話ができるのは
	嬉しいし、楽しい。\

	桜井も僕にはポツポツとだけど、
	話をしてくれるようになったしね。\

	【$g_hero】
	手、冷たくない？\
