*staff_nuu	; ●ぬ～
	csp -1
	bg "mabo/staff_nuu.jpg",BG_EFFECT	;背景を表示
	gosub *set_message_window
	gosub *show_window

	はじめまして。
	ぬ～と申します。\

	『月光に濡れる教室で、僕は。』
	お買いあげいただきありがとうございました。
	いかがでしたでしょうか？\

	ちゅんくさんからお声をかけていただきまして。
	今回からシナリオ諸々を
	頑張らせていただくことになりました。\

	よろしくおねがいします。\

	今回は、明海シナリオを
	書かせていただきました。\

	それからスクリプトを少々…かな？\

	ちぇりーでは、レギュラー化している
	サブキャラが多いので、\

	以前から知っているイズミとかスダとか（笑）、
	百合恵先生とか書くことができて
	緊張しつつもとても楽しかったです。\

	ですが、とにかく何もかもはじめてづくしで、
	色々いたらないところも多く…。
	反省点も多く…。\

	入社してからわき目もふらずにひたすら
	書いていたら終わったという…。\

	…。それじゃいかんのです！\

	次回は、もっと対話中心で、人に親切で
	笑いにあふれた物を目指したいです。\

	次回はナースもので、メインヒロインを一人、
	担当させていただく予定です。\

	がんばります。\

	その次か、次の次あたりに
	メインでやらせていただく予定です。\

	タイトルは未定なのですが、
	北部アイルランドで…ケルトっぽいものを…。
	館もので…。\
;館で、妖精で、マジカルなものを。
;マジカルといっても…魔女の呪いみたいな。
;三つの願いごとみたいなものを。

	やれたらいいな～と思ってます。
	エロくがんばりたいです。\

	それから、
	もっと手が早くなりたいです。
	それからもっと説明が上手な人になりたいです。\

	とにかく頑張ります。\

	次回作もどうぞヨロシクお願いします！！
	ぬ～でした。\
	;----------------------------------
;---STAFF_NUU END -----

	gosub *hide_window
	goto *staff_room

*syohin_annai	;■商品案内
	bg "MABO/product.jpg",0	;背景設定
	lsp 0,	":a/2,0,3;MABO/pd_hr.jpg",130,110
	lsp 1,	":a/2,0,3;MABO/pd_pr.jpg",270,110
	lsp 2,	":a/2,0,3;MABO/pd_br.jpg",410,110
	lsp 3,	":a/2,0,3;MABO/pd_ki.jpg",550,110
	lsp 4,	":a/2,0,3;MABO/pd_ub.jpg",190,250
	lsp 5,	":a/2,0,3;MABO/pd_ex.jpg",335,250
	lsp 6,	":a/2,0,3;MABO/pd_db.jpg",470,250
	lsp 7,	":a/2,0,3;MABO/pd_da.jpg",135,390
	lsp 8,	":a/2,0,3;MABO/pd_sk.jpg",270,390
	lsp 9,	":a/2,0,3;MABO/pd_cr.jpg",410,390
	lsp 10, ":a/2,0,3;MABO/pd_ng.jpg",550,390
	lsp 11, ":a/2,0,3;MABO/modoru.jpg",320,550
	print BG_EFFECT
	btndef ""
	spbtn	0,1
	spbtn	1,2
	spbtn	2,3
	spbtn	3,4
	spbtn	4,5
	spbtn	5,6
	spbtn	6,7
	spbtn	7,8
	spbtn	8,9
	spbtn	9,10
	spbtn	10,11
	spbtn	11,12

*syohin_loop
	btnwait %work
	if %work==MOUSE_RBUTTON gosub *click : csp -1 : goto *mabo_room
	if %work==KEY_ESCAPE    gosub *click : csp -1 : goto *mabo_room
	if %work<=0 goto *syohin_loop
	if %work==12 gosub *click : csp -1 : goto *mabo_room
	if %work==1 gosub *click : csp -1 : goto *pd_hr
	if %work==2 gosub *click : csp -1 : goto *pd_pr
	if %work==3 gosub *click : csp -1 : goto *pd_br
