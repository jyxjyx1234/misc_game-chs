	mov $debugstr,"ＢＧ：BG009A"
	gosub *out	;画面に出力
;ＢＧ：BG009A;２年教室
	;--立ちキャラ;----------------------------------
	mov $_char,"TJA"
	mov $debugstr,"立ち：TJA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XMP0201"
	mov $debugstr,"音声：XMP0201 "
	gosub *vo

	【育巳】
	お、どうした？\
	dwavestop CH_VOICE	;XMP0201 

	【$g_hero】
	なあ、育巳。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TJD"
	mov $debugstr,"立ち：TJD "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XMP0203"
	mov $debugstr,"音声：XMP0203 "
	gosub *vo

	【育巳】
	ん？\
	dwavestop CH_VOICE	;XMP0203 

	【$g_hero】
	さっきのさ…真実のさ…。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TJB"
	mov $debugstr,"立ち：TJB "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XMP0204"
	mov $debugstr,"音声：XMP0204 "
	gosub *vo

	【育巳】
	あと、ちょっとで卒業式、んで、終業式だろ？
	そしたら３年になってクラス替えだ。\
	dwavestop CH_VOICE	;XMP0204 

	【$g_hero】
	うん。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TJA"
	mov $debugstr,"立ち：TJA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XMP0205"
	mov $debugstr,"音声：XMP0205 "
	gosub *vo

	【育巳】
	春休み中に忘れちゃうよ。変な噂も。
	この間の事件も。\
	dwavestop CH_VOICE	;XMP0205 

	【$g_hero】
	…そうかな。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TJB"
	mov $debugstr,"立ち：TJB "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
