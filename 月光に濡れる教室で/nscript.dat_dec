;-------------------------------------------------------------------
;-------------------------------------------------------------------
;■画像の移動
;	呼び出し側：
;		SP_MOVEに移動用画像を設定
;		_xに目的地 x座標。_yに目的地y座標を入れる
;		workに開始座標
;-------------------------------------------------------------------
*moving_y
	resettimer
	mov %_i,MOVETIME	;待ち時間
	mov %_j,MOVETOUKA	;透過度
*moveing_y_loop
	if %work >= %_y goto *moveing_y_exit
	msp SP_MOVE,0,MOVEVAL,%_j	;x座標方向には移動しない
	waittimer %_i
	print 1
	add %work,MOVEVAL
	add %_i,MOVETIME
	add %_j,MOVETOUKA
	goto *moveing_y_loop
*moveing_y_exit
	return
;-------------------------------------------------------------------
*moving_x
	resettimer
	mov %_i,MOVETIME	;待ち時間
	mov %_j,MOVETOUKA	;透過度
*moveing_x_loop
	if %work >= %_x goto *moveing_x_exit
	msp SP_MOVE,MOVEVAL,0,%_j	;x座標方向には移動しない
	waittimer %_i
	print 1
	add %work,MOVEVAL
	add %_i,MOVETIME
	add %_j,MOVETOUKA
	goto *moveing_x_loop
*moveing_x_exit
	return

;-------------------------------------------------------------------
*waitkey	;●ＣＧモード用、クリック音付きキー待ち。
	click
	gosub *click
	mov $old_cg,""
	mov $_cg,""
	return
;-------------------------------------------------------------------
;■マップ移動
;	呼び出す前に必要な情報
;		場所 map_place01～map_place12に対応するキャラを設定
;
;-------------------------------------------------------------------
*map	;■マップ画面
	gosub *hide_window	;is_adv	,8	;0でタイトル画面／1でADV／2で回想
	csp -1
	saveoff
	bg black,CG_EFFECT
	mov $_char,"":mov $old_char,"":mov $_cg,"":mov $old_cg,"":mov $_bg,"":mov $old_bg,""

;マップ行けるところがなくなったら戻る
	if %map01!=0 goto *map_btnread 
	if %map02!=0 goto *map_btnread 
	if %map03!=0 goto *map_btnread 
	if %map04!=0 goto *map_btnread 
	if %map05!=0 goto *map_btnread 
	if %map06!=0 goto *map_btnread 
	if %map07!=0 goto *map_btnread 
	if %map08!=0 goto *map_btnread 
	if %map09!=0 goto *map_btnread 
	if %map10!=0 goto *map_btnread 
	if %map11!=0 goto *map_btnread 
	if %map12!=0 goto *map_btnread 
	mov %map_pos,13	;マップ終了のインジケーターが１３
	goto *map_end	;全部ゼロってことは、移動し終わっているので、戻る。

*map_btnread
	gosub *map_out	;マップ画面表示

*map_btndef
