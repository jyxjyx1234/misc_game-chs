	mov $_voice,"CC6200A"
	mov $debugstr,"音声：CC6200A "
	gosub *vo

	【明海】
	…………………。
	ホントに…何から考えればいいのかしら。\
	dwavestop CH_VOICE	;CC6200A 

	頭の中で事件を整理して、
	ひとつずつ…問題を片づけていく。\

	今までだってやってきたわ。
	半年前から…一人で…たった一人で…。\

	辛くても…苦しくても…。
	一人でやってこれたわ。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCF"
	mov $debugstr,"立ち：TCF "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC6200B"
	mov $debugstr,"音声：CC6200B "
	gosub *vo

	【明海】
	私…どうしてキスして…なんて
	言ってしまったのかしら。\
	dwavestop CH_VOICE	;CC6200B 

	ああ…まただわ。\

	大変なことが、沢山おきてるのに。
	怖くて…仕方がないのに。\

	こんなことばかり…私考えてる。
	しっかりしなくちゃ…ダメなのに…。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCG"
	mov $debugstr,"立ち：TCG "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC6201"
	mov $debugstr,"音声：CC6201"
	gosub *vo

	【明海】
	でも…私…。\
	dwavestop CH_VOICE	;CC6201

	キミがいれば…。
	キミがいれば…大丈夫だって…。\

	そんな風に思ってしまうの。
	どうしてかしら、どうしてそう思えるのかしらね。\

	あの人は、私の気持ちを知らないのに。
	ただ…私が好きなだけなのに。\

	…どうしてわからないのかしら。
	だから…私はあんな事をするキミを憎まないのに。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCF"
	mov $debugstr,"立ち：TCF "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC6202"
	mov $debugstr,"音声：CC6202"
	gosub *vo

	【明海】
	私…卑怯だわ…。\
	dwavestop CH_VOICE	;CC6202

	何も言わないで、
	わかってもらいたいって、思ってる。\

	でも…今言ったらどうなるの？
	体を繋げたから好きだって思われるのかしら。\

	それはイヤなの。
	はじめから好きだったのって……思って欲しいの。\

	だって…それが本当でしょ？
	キミが好きってことだけは…本当でしょう？\
	gosub *blackout

	return	;----------------------------------
;---C62  END -----
