	mov $debugstr,"音声：CC0306"
	gosub *vo

	【明海】
	え…？\
	dwavestop CH_VOICE	;CC0306

	先輩の顔がはっきりと強張った。
	ほら…やっぱりそうじゃないか。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCD"
	mov $debugstr,"立ち：TCD "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC0307"
	mov $debugstr,"音声：CC0307"
	gosub *vo

	【明海】
	そんな…私……無理なんて…。\
	dwavestop CH_VOICE	;CC0307

	【$g_hero】
	いいんだよ。
	…そんな風に、わざと明るくしなくても。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCH"
	mov $debugstr,"立ち：TCH "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC0308"
	mov $debugstr,"音声：CC0308"
	gosub *vo

	【明海】
	……わざとだなんて…私…そんなつもりはなくて。
	ゴ…ゴメンナサイ……。\
	dwavestop CH_VOICE	;CC0308

	先輩は、うつむいてしまった。
	消え入りそうな声は、涙まじりだった。\

	そんな風に先輩があやまることなんて
	何もないのに。\

	謝らなくちゃならないのは、僕の方なのに。
	僕はのろのろと口をひらいた。\

	【$g_hero】
	ゴメンとか…そうじゃなくてさ。\

	【$g_hero】
	僕だって…色々…だったしさ…その…昨日のこと
	とか…謝らなくちゃいけないのは僕の方だし。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCG"
	mov $debugstr,"立ち：TCG "
	gosub	*out	;画面に出力

	【明海】
	……………。\

	先輩が、首まで赤くなった。やっぱり昨日の事、
	覚えていない訳じゃないんだ。\

	【$g_hero】
	だ、だからさ…。\

	【$g_hero】
	別に明るくするような事じゃないし……そういう
	時はそのまんまでいいじゃないか……。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCD"
	mov $debugstr,"立ち：TCD "
	gosub	*out	;画面に出力

	先輩が、大きく目を見開いた。
	すごく驚いているみたいだった。\
	;-音声;----------------------------------
	mov $_voice,"CC0309"
	mov $debugstr,"音声：CC0309"
	gosub *vo

	【明海】
	そう…ね…。
	そうなのかもしれないわ……。\
	dwavestop CH_VOICE	;CC0309
	;--立ちキャラ;----------------------------------
	mov $_char,"TCA"
	mov $debugstr,"立ち：TCA "
	gosub	*out	;画面に出力

	【明海】
	先輩が、僕を窺うように見あげた。
	先輩の視線は、矢のように真っ直ぐだった。\

	僕は、まるで真昼の太陽を見ているような
	気分になった。\

	明るすぎて、強すぎて。
	まともに見ていられないんだ。\

	;--BGM;----------------------------------
	mov $_music,"07": gosub *out
;$g_fname君はナシ
	;--立ちキャラ;----------------------------------
	mov $_char,"TCF"
	mov $debugstr,"立ち：TCF "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC0310"
	mov $debugstr,"音声：CC0310"
	gosub *vo

	【明海】
	ねぇ、$g_fname君…その…ままって？\
	dwavestop CH_VOICE	;CC0310

	【$g_hero】
	え…そのままって…。\

	僕は、困ってしまった。
	先輩が、大きな目で僕を見ている。\

	それを僕に訊くの？
	先輩はときどき、本当によくわからない。\

	【$g_hero】
	た、たとえばさ。
	戸惑ってるとか…気まずい…とかさ……。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCA"
	mov $debugstr,"立ち：TCA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
