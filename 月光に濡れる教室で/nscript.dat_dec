*C71	; ■ファイル開始のラベル
	mov $debugstr,"■C71 " : gosub *debugout
;■■■「月光に濡れる教室で、僕は。」台本：●リストの事を聞く：B71
;━━━━━━━━━━━━━━
;●リストの事を聞く
;2003/01/15
	gosub *blackout

	;--BGM;----------------------------------
	mov $_music,"13": gosub *out
	;--背景;----------------------------------
	mov $_bg,"BG012A"
	mov $debugstr,"ＢＧ：BG012A"
	gosub *out	;画面に出力
;ＢＧ：BG012A;保健室

	しばらくして先輩の両親がやって来た。\

	僕に挨拶をして、菜摘先生に挨拶をして、
	それから先輩を連れて帰った。\

	おじさんも、おばさんも、
	すごく柔和で温厚なひとなんだ。\

	おじさんやおばさんが理不尽な理由で
	こどもを叱ったのなんて、見たことがない。\

	それは自分のこども…つまり明海ちゃんだけ
	なんじゃなくて、僕たち兄弟にも同じだった。\

	知性の人たちなんだって、兄さんが言ってたな…。
	僕にそれは、よくわからないけど。\

	それにしてもさ。\

	【$g_hero】
	まさか、おじさんまで来るとは思わなかったな…。\

	まあ…大事件だろうけど…普通は仕事とかさ…。\

	社長さんだから、その辺は融通が効くのかな？
	かえって効かなさそうな気もするんだけど…。\

	;--BGM;----------------------------------
	mov $_music,"01": gosub *out
	;--立ちキャラ;----------------------------------
	mov $_char,"TIA"
	mov $debugstr,"立ち：TIA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XC7100A"
	mov $debugstr,"音声：XC7100A "
	gosub *vo

	【百合恵先生】
	さて、と。ようやく一段落ついたわね。
	で、君はどうするの？\
	dwavestop CH_VOICE	;XC7100A 

	【$g_hero】
	僕？僕は……。\

	またあの噂にまみれた教室に行くのは、
	すごくイヤだった。\

	今度は、何を言われるか想像もつかない。
	考えるだけで…かなり気が滅入ってくる。\

	【$g_hero】
	ガッコ、明日からどうなるんですか？\
	;--立ちキャラ;----------------------------------
	mov $_char,"TIC"
	mov $debugstr,"立ち：TIC "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XC7100B"
	mov $debugstr,"音声：XC7100B "
	gosub *vo

	【百合恵】
	教室を移動して授業するわ。\
	dwavestop CH_VOICE	;XC7100B 

	【$g_hero】
	休校じゃないんだ。\
