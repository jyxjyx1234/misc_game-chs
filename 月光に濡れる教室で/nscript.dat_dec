	【明海】
	あ………。\
	dwavestop CH_VOICE	;CC1202

	【$g_hero】
	聖母子像ってのもなんだし、マリアって
	のもいやだから。天使なんだけど。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCE"
	mov $debugstr,"立ち：TCE "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
