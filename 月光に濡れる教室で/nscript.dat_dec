	【$g_hero】
	でも…何か…花みたいな匂いが…。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCC"
	mov $debugstr,"立ち：TCC "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC2504"
	mov $debugstr,"音声：CC2504"
	gosub *vo

	【明海】
	…そういわれてみれば…。\
	dwavestop CH_VOICE	;CC2504

	……何だかくらっとしてきたぞ。
	どうしたんだろう。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCD"
	mov $debugstr,"立ち：TCD "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC2505"
	mov $debugstr,"音声：CC2505"
	gosub *vo

	【明海】
	$g_fname君？どうしたの…？\
	dwavestop CH_VOICE	;CC2505

	【$g_hero】
	いや…何だか…。\

	おかしな気分なんだ。
	そう…まるであの夜の教室にいるみたいに。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCF"
	mov $debugstr,"立ち：TCF "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC2506"
	mov $debugstr,"音声：CC2506"
	gosub *vo

	【明海】
	……………何だか…私…。\
	dwavestop CH_VOICE	;CC2506

	先輩の目も…心なしか潤んでいるように見える。\

	ああ！　もう！！　しっかりしろって！！
	こんな所でさかってどうするんだ！？\

	【$g_hero】
	じゃ、じゃあ…本当に僕帰るから。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCA"
	mov $debugstr,"立ち：TCA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC2507"
	mov $debugstr,"音声：CC2507"
	gosub *vo

	【明海】
	ええ、それじゃあ…また明日。\
	dwavestop CH_VOICE	;CC2507
	gosub *clear_char

	【$g_hero】
	……………………。\

	僕はさっきの先輩の告白を思い出していた。
	なんだか…おかしい…。\

	そうだ。あのメッセージ！！\

	“お前は、淫乱な顔をして”
	“チ○ポに嬉しそうにむしゃぶりついていたぞ”\

	“男に貫かれて、ヒィヒィよがってた”
	“はじめてだったのにな”\

	そんなはずはない。
	だって、先輩は…処女だった。
	あんなにいっぱい、血が出てた。\

	だったらあのメッセージはウソ？
	「彼」はどうしてウソなんてついたんだろう…。\

	return	;----------------------------------
;---C25  END -----
