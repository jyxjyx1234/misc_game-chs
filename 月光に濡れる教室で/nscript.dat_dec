;■CTS
;-------------------------------------------------------------------
*cts
	saveoff
if %is_adv==1	gosub *hide_window	;is_adv	,8	;0でタイトル画面／1でADV／2で回想
	csp -1
	gosub *blackout
	dwave CH_SE,"SE/ZLOGO.WAV"
	bg "BG/BG020B.JPG",BG_EFFECT
	gosub *cts_out1
	gosub *cts_btndef

*cts1_btnwait
	btnwait %work
	mov %cts_pos,%work
	if %work==MOUSE_RBUTTON goto *cts_cancel_end
	if %work==KEY_ESCAPE    goto *cts_cancel_end
	if %work==nCTS_CANCEL	 goto *cts_cancel_end	;キャンセル
	if %work<1   goto *cts1_btnwait
	if %work>4   goto *cts1_btnwait
	dwave CH_SE,"SE/ZCTSOK.WAV"
	goto *cts2

;-------------------------------------------------------------------
*cts2
	gosub *cts_out2
	gosub *cts_btndef

*cts2_btnwait
	btnwait %work
	mov %cts_play,%work
	if %work==MOUSE_RBUTTON goto *cts_cancel_end
	if %work==KEY_ESCAPE    goto *cts_cancel_end
	if %work==nCTS_CANCEL	goto *cts_cancel_end	;キャンセル
	if %work<1   goto *cts2_btnwait
	if %work>4   goto *cts2_btnwait
	dwave CH_SE,"SE/ZCTSOK.WAV"
	goto *cts_end

;-------------------------------------------------------------------
*cts_btndef
	btndef ""
	exbtn_d "P20C21C22C23C24P25P26P27P28"
	exbtn SP_CTS01, 1,"C20P21C22C23C24P25,1P26P27P28S1,(se\zctsov.wav)"
	exbtn SP_CTS02, 2,"C20C21P22C23C24P25P26,1P27P28S1,(se\zctsov.wav)"
	exbtn SP_CTS03, 3,"C20C21C22P23C24P25P26P27,1P28S1,(se\zctsov.wav)"
	exbtn SP_CTS04, 4,"C20C21C22C23P24P25P26P27P28,1S1,(se\zctsov.wav)"
	return

*cts_out1	;●CTS画面その１＞場所
	;使用するスプライトをクリア
	for %work=SP_CTS_MESDEF to SP_CTS_BG:csp %work:next
	lsp SP_CTS_BG, ":a;SYS/CTS_BG.JPG",0,0  
	lsp SP_CTS01, ":a/2,0,3;SYS/CTS_SEIKI.JPG",  300,227,255	;性器
	lsp SP_CTS02, ":a/2,0,3;SYS/CTS_HIP.JPG",    385,136,255	;お尻
	lsp SP_CTS03, ":a/2,0,3;SYS/CTS_GANGU.JPG",  216,136,255	;玩具
	lsp SP_CTS04, ":a/2,0,3;SYS/CTS_CAN1.JPG",   300, 46,255	;キャンセル
	gosub *cts_moving
;	lsph SP_CTS01, ":a/2,0,3;SYS/CTS_SEIKI.JPG",  300, 27,255	;性器
;	lsph SP_CTS02, ":a/2,0,3;SYS/CTS_HIP.JPG",    185,136,255	;お尻
;	lsph SP_CTS03, ":a/2,0,3;SYS/CTS_GANGU.JPG",  416,136,255	;玩具
;	lsph SP_CTS04, ":a/2,0,3;SYS/CTS_CAN1.JPG",   300,246,255	;キャンセル
	lsph SP_CTS_MES01,":s/24,24,0;#FFFFFF性器を中心に責めます",	290,520
	lsph SP_CTS_MES02,":s/24,24,0;#FFFFFFお尻に挿入します",		300,520
	lsph SP_CTS_MES03,":s/24,24,0;#FFFFFF大人のオモチャを使います",	260,520
	lsph SP_CTS_MES04,":s/24,24,0;#FFFFFFもうＨは止めます",		300,520
	lsph SP_CTS_MESDEF,":s/24,24,0;#FFFFFF責める場所を指定してください",220,520
	print 1
	return

*cts_out2	;●CTS画面その２
	;使用するスプライトをクリア
	for %work=SP_CTS_MESDEF to SP_CTS_BG:csp %work:next
	lsp SP_CTS_BG, ":a;SYS/CTS_BG.JPG",0,0  
	lsp SP_CTS01, ":a/2,0,3;SYS/CTS_IJIMERU.JPG",  	300,227,255	;虐める
	lsp SP_CTS02, ":a/2,0,3;SYS/CTS_HOUSHI.JPG",    385,136,255	;奉仕
	lsp SP_CTS03, ":a/2,0,3;SYS/CTS_LOVE.JPG",  	216,136,255	;LOVE
	lsp SP_CTS04, ":a/2,0,3;SYS/CTS_CAN2.JPG",  	300, 46,255	;キャンセル
	gosub *cts_moving
	lsph SP_CTS_MES01,":s/24,24,0;#FFFFFF相手を虐めます",310,520
	lsph SP_CTS_MES02,":s/24,24,0;#FFFFFF奉仕プレイを要求します",280,520
	lsph SP_CTS_MES03,":s/24,24,0;#FFFFFF愛情たっぷりにえっちします",250,520
	lsph SP_CTS_MES04,":s/24,24,0;#FFFFFFもうＨは止めます",320,520
	lsph SP_CTS_MESDEF,":s/24,24,0;#FFFFFFプレイスタイルを指定してください",200,520
	print 1
	return

*cts_moving
	for %0 = 0 to 25
		resettimer
		msp SP_CTS01, 0,-8,0
		msp SP_CTS02,-8, 0,0
		msp SP_CTS03, 8, 0,0
		msp SP_CTS04, 0, 8,0
		print 1
		waittimer 5
	next
	return

*cts_cancel_end
	for %work=SP_CTS_MESDEF to SP_CTS_BG:csp %work:next
	gosub *se_cancel
	gosub *blackout
if %is_adv==1	gosub *speed_val
if %is_adv==1	gosub *touka_val
if %is_adv==1	gosub *set_message_window
if %is_adv==1	gosub *show_window
if %is_adv==1	saveon
	return

*cts_end
	for %work=SP_CTS_MESDEF to SP_CTS_BG:csp %work:next
	gosub *blackout
	;is_adv	,8	;0でタイトル画面／1でADV／2で回想
if %is_adv!=0	gosub *speed_val
if %is_adv!=0	gosub *touka_val
if %is_adv!=0	gosub *set_message_window
if %is_adv!=0	gosub *show_window
if %is_adv==1	saveon
	return

