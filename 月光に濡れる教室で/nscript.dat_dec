*MPX192	; ■ファイル開始のラベル
	mov $debugstr,"■MPX192" : gosub *debugout
;■マップ（無人）
	;--背景;----------------------------------
	mov $_bg,"BG019A"
	mov $debugstr,"ＢＧ：BG019A"
	gosub *out	;画面に出力
;☆２☆

	ここは学生会室だ。
	矢崎は…いないみたいだな。\

	【$g_hero】
	あいつもいそがしいやつだし。
	学園中を飛び回ってるんだろう。\

	しかし無人の学生会室か…。\

	いつも人がいるからな…誰もいないと
	静かすぎて不気味でさえある。\

	校舎ってのはどこを見回しても
	誰もいない場所は不気味だし…怖いくらいだ。\

	しかもここには七不思議まである。\

	この学生会室の七不思議は、
	『助けを呼ぶまぼちゃんの声』だ。\

	この学生室には壊れて使えなくなった
	パソコンが放置されている。\

	そのパソコンは、真夜中になると
	勝手に電源がはいって…。\

	画面に「たすけて！！　たすけて！！」
	と助けを求める文章が現れるそうだ。\

	そしてそれと同時に壁紙がまぼちゃんに
	変わるという…。\

	【$g_hero】
	…………………………。\

	怖いんだか、かわいいんだか
	わからない七不思議だな…。\

	【$g_hero】
	矢崎が壊れて役に立たないパソコンを放置して
	いるのも、おもしろいからなんだろうな…。\

	【$g_hero】
	きっと何度も試しているに違いない…。
	忙しいはずなのに…あいつも変なヤツだ。\

	【$g_hero】
	僕も決してヒマじゃないぞ。
	そうだ、さっさと帰ろう。\
	gosub *blackout

	return	;----------------------------------
;---MPX192 END -----
