	mov $debugstr,"立ち：TOA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"YMP0601"
	mov $debugstr,"音声：YMP0601 "
	gosub *vo

	【スダ】
	スダだぜ。\
	dwavestop CH_VOICE	;YMP0601 

	【$g_hero】
	よう。何か、いい話ないかな？\
