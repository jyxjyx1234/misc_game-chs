	僕が家に帰った頃には、すっかり
	日が暮れていた。\
	;-効果音;----------------------------------
	mov $_se,"ZPIKO"
	mov $debugstr,"ＳＥ：ZPIKO "
	gosub *se
;携帯の音

	【$g_hero】
	ん？だれかメールかな。あ、まゆ子だ。
	そっか。菜摘先生の写真か。\

	遅くなってゴメンニャ！というメッセージと
	一緒に菜摘先生の写真が届いていた。\

	【$g_hero】
	おお、やっぱりカワイイ！！
	先生だけ切り抜いて待ち受けにしようかな…。\

	いや、そこまでしないでもいいか。
	どうせ写真使うなら、他の男と一緒のより
	僕と一緒にとった写真を使いたいしな。\

	【$g_hero】
	ふう…。それにしても
	今日…すごいことしちゃったなぁ…。\

	ばふっとベッドに仰向けになって
	菜摘先生と屋上でしたことを反芻する。\

	菜摘先生の柔らかな胸とか、唇の感触とか
	どろどろで熱くて気持ちのいいとことか…。\

	【$g_hero】
	やば…。思い出してたら勃っちゃう…。
	どうしよ、それとも抜こうかな…。\

	それもいいかな…と思った瞬間。\
	;-音声;----------------------------------
	mov $_voice,"YE2300"
	mov $debugstr,"音声：YE2300"
	gosub *vo

	【$g_heroの兄】
	おーい、入るよ～。\
	dwavestop CH_VOICE	;YE2300
	;-効果音;----------------------------------
	mov $_se,"ZDOORO"
	mov $debugstr,"ＳＥ：ZDOORO"
	gosub *se

	【$g_hero】
	うわわわっ！！！な、なんだよ！
	何か用事でもあんの！？\
	;--立ちキャラ;----------------------------------
