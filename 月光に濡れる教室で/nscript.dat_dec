*C59	; ■ファイル開始のラベル
	mov $debugstr,"■C59 " : gosub *debugout
;■■■「月光に濡れる教室で、僕は。」台本：●保健室へ：B59
;━━━━━━━━━━━━━━
;●保健室へ
;2003/01/13

	;--BGM;----------------------------------
	mov $_music,"04": gosub *out
	;--背景;----------------------------------
	mov $_bg,"BG015B"
	mov $debugstr,"ＢＧ：BG015B"
	gosub *out	;画面に出力
;//裏庭

	【$g_hero】
	………………まゆ子。\

	【まゆ子】
	……………………。\

	まゆ子は、今は静かに寝息を立てていた。
	さっきまでの…苦しそうな声は、もう聞こえない。\

	僕は、そっとまゆ子に制服をかぶせた。
	見ていられなかった。\

	どうしていいかわからなくて……。\

	見えないように隠してしまったっていう方が、
	正しいのかも知れない。\

	僕は、まゆ子を背負おうとした。
	だけど…なかなかうまくいかなかった。\

	意識を失った人間の体は、ものすごく重いんだ。
	それはちっちゃな女の子でも、変わらない。\

	まゆ子の体は、ぐったりとしていてた。
	歯を食いしばって、僕はまゆ子を支えた。\

	【$g_hero】
	保健室に…連れて行かなくちゃ……。\

	そのとき、後ろから誰かがまゆ子を支えた。
	僕は振り返って…息をのんだ。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCI"
	mov $debugstr,"立ち：TCI "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC5900"
	mov $debugstr,"音声：CC5900"
	gosub *vo

	【明海】
	…私にも、手伝わせて。\
	dwavestop CH_VOICE	;CC5900

	【$g_hero】
	…セ…ンパイ……。\

	僕の声は、うわずっていた。
	…どうして。\

	どうして…どうして…どうして先輩が
	ここにいるんだよ！？\

	【$g_hero】
	どうして、先輩がここに居るんだよ…。
	……何でだよ！？\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCD"
	mov $debugstr,"立ち：TCD "
	gosub	*out	;画面に出力
;【明海】［驚］

	【$g_hero】
