	あの…じ…事故…じゃなくて自殺…。\
	dwavestop CH_VOICE	;YD0901
	;--立ちキャラ;----------------------------------
	mov $_char,"TPE"
	mov $debugstr,"立ち：TPE "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"YD0902"
	mov $debugstr,"音声：YD0902"
	gosub *vo

