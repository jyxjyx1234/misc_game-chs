*D31	; ■ファイル開始のラベル
	mov $debugstr,"■D31 " : gosub *debugout
;●菜摘先生のＨＲ

	;--BGM;----------------------------------
	mov $_music,"02": gosub *out
;BGM:迷
	;--背景;----------------------------------
	mov $_bg,"BG009A"
	mov $debugstr,"ＢＧ：BG009A"
	gosub *out	;画面に出力
;ＢＧ：BG009A;２年教室
	;--立ちキャラ;----------------------------------
	mov $_char,"TEA"
	mov $debugstr,"立ち：TEA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XD3100"
	mov $debugstr,"音声：XD3100"
	gosub *vo

	【菜摘先生】
	みなさん、お早うございます。
	今日の伝達事項ですが…。\
	dwavestop CH_VOICE	;XD3100
;★★★考えのまとめとか小夜子のこととか★★★

	【菜摘先生】
	………………。\

	【菜摘先生】
	………………………………。\
	gosub *clear_char

	菜摘先生の声が全然入ってこない。
	完全に上の空だった。\

	自分でもよく分かる。
	だけど、どうしてもボウッとしてしまう。\

	【$g_hero】
	小夜子……。\

	口の中でつぶやいてみる。\

	早く放課後になればいいのに。
	そうしたら小夜子にまた会える。\

	もちろん小夜子に会うだけが目的じゃない。\

	大貫君の「事件」について
	話し合わなくちゃならないんだ。\

	気になることは沢山ある。\

	【$g_hero】
	（まずは…大貫君の彼女を見つけなくちゃな）\

	僕は、顔をひきしめる。\

	【$g_hero】
	（そうだ。やることはいっぱいあるんだ）\

	だけど。\

	…小夜子。\

	【$g_hero】
	（不思議だな…）\

	僕は頬杖をついた。
	小夜子のことばかりが頭に浮かぶ。\

	出会ったときのこととか。
	コーラス部に入部したときのこととか。\

	夏休みの練習とか。
	秋の合唱コンクールの大会のこととか。\

	それから…、
	…夜のこと…。\

	僕と小夜子がしてしまったこと。\

	こんな風に小夜子と体を重ねる
	なんてちっとも考えてなかったのに。\

	小夜子が…ああいう男女の関係について
	嫌悪感があるってのもあったけど。\

	一番かわいくて、一番気のおけない
	後輩だったから。\

	僕以外の友だちをあまり作らない事もあって
	なんだか心配だったし…。\

	僕自身、小夜子とは男女の関係ってよりは
	友達ってカンジだったと思う。\

	だけど僕たちは、
	あの夜の学園でセックスをして。\

	だけど恋人同士なのかと訊かれると
	困ってしまう。\

	……僕は小夜子が好きだ。
	小夜子も僕が好きだろう。\

	恋人同士…なのかな。
	わからない。でも。\

	小夜子は、呼び出した相手が僕でないって
	知って泣いていた。\

	僕以外に見られたのが
	恥ずかしくて泣いていた。\

	あんな風に真っすぐに僕を信頼している
	小夜子を見ていると。\

	力になりたいって、思う。
	守ってあげたいって、思う。\

	そうして、あげたいんだ。\

	僕ができることのすべてを、小夜子にあげたい。\

	そう、思うんだ。\

	なにもできない僕だけど。
	なにもない僕だけど。\

	小夜子が、好きだから。\

	【$g_hero】
	（そっか…。
	　好きなんだな、僕は。小夜子のことが）\

	愛とか恋とか何が正しいとか
	そういうことは僕にはわからないけれど。\

	だけど、僕は小夜子が好きで
	その気持ちは本当なんだって、\

	今更ながらに気がついた。\

	…ちょっとニブイかな、僕は。
	しょうがないな、僕ってヤツは。\
	;-効果音;----------------------------------
	mov $_se,"ZTYAIM"
	mov $debugstr,"ＳＥ：ZTYAIM"
	gosub *se

	キーンコーン…キーンコーン…\

	【$g_hero】
	あれ？　授業のチャイム？\

	いつのまにかＨＲが終わっていた。\

	【$g_hero】
	しまった。
	次の授業はなんだったっけ…。\

	あわてる僕に、隣の育巳がにやにや笑ってた。\

	このやろっ。
	わかってて放っておいたな。\

	僕は軽く育巳を睨むと、
	あわただしく教科書を取り出しはじめた。\
	gosub *blackout
	gosub *musicstop
	;-効果音;----------------------------------
	mov $_se,"ZTYAIM"
	mov $debugstr,"ＳＥ：ZTYAIM"
	gosub *se

	キーンコーン…キーンコーン…\

	【$g_hero】
	さーて授業が終わったぞ！！\
;マップ移動へ
	gosub *blackout

	;--BGM;----------------------------------
	mov $_music,"05": gosub *out

	return	;----------------------------------
;---D31  END -----
