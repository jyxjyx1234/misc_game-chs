	【明海】
	ええ。そうよ？\
	dwavestop CH_VOICE	;CC0303

	だとすれば、先輩は三十分以上ここで
	待っていたことになる。\

	【$g_hero】
	あっ…んの……バカアニキ！\

	僕は憤慨した。\

	【$g_hero】
	明海ちゃんが、来てるならば来てるって、
	どうして言ってくれなかったんだよ！\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCC"
	mov $debugstr,"立ち：TCC "
	gosub	*out	;画面に出力

	【明海】
	……………………………。\

	「明海ちゃん」という名前を聞いた途端、
	先輩は表情を曇らせた。\
;表情いつもの通り
	;--立ちキャラ;----------------------------------
	mov $_char,"TCA"
	mov $debugstr,"立ち：TCA "
	gosub	*out	;画面に出力
