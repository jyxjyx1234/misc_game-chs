*E37	; ■ファイル開始のラベル
	mov $debugstr,"■E37 " : gosub *debugout
;■■■「月光に濡れる教室で、僕は。」台本：●授業中：E37
;━━━━━━━━━━━━━━
;●授業中
;これはてきとうに。主人公のモノローグで。

	;--BGM;----------------------------------
	mov $_music,"01": gosub *out
	;--背景;----------------------------------
	mov $_bg,"BG009A"
	mov $debugstr,"ＢＧ：BG009A"
	gosub *out	;画面に出力
;つじつまをあわせたり…。

	授業が始まった。\
;;２年教室
	;--立ちキャラ;----------------------------------
	mov $_char,"TYA"
	mov $debugstr,"立ち：TYA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"YOP2000"
	mov $debugstr,"音声：YOP2000 "
	gosub *vo

	【治見先生】
	今日は、昭和の歴代総理大臣についてだったかね。
	教科書の２０５ページを開いてくれたまえ。\
	dwavestop CH_VOICE	;YOP2000 

	この前も同じことやらなかったか？
	治見先生もうっかりしてるからなぁ…。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TYA"
	mov $debugstr,"立ち：TYA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"YOP2001"
	mov $debugstr,"音声：YOP2001 "
	gosub *vo

	【治見先生】
	…であるからして…の総理大臣は…
	国鉄を民営化することに踏み切り……。\
	dwavestop CH_VOICE	;YOP2001 
	gosub *clear_char
	;-効果音;----------------------------------
	mov $_se,"ZCHORK"
	mov $debugstr,"ＳＥ：ZCHORK"
	gosub *se

	チミチミのお経のような声と
	チョークの音だけが響く。\

	【$g_hero】
	（みんなも何も言わないからな）\

	治見先生の授業は、
	聞いているやつの方が少ない。\

	他の参考書を開いたり、塾のテキストを
	解いていたり…。\

	【$g_hero】
	（確かに退屈だよな…）\

	僕はあくびをかみ殺した。\

	僕はぼんやりと窓の外を眺める。
	窓の外から見える景色。\

	校門を見下ろしていたら
	不意に思い出した。\

	【$g_hero】
	（そういえば昨日みた夢…）\

	桜の夢。
	一年生のときにみた菜摘先生の姿。\

	【$g_hero】
	（きれいだったな…菜摘先生）\

	あのときの先生の独り言。
	ほとんど思い出せないけれど。\

	泣き出しそうな顔をしてた。
	もしかして…彼氏のことを思い出していたのかな。\

	津島。
	自殺したって言っていた。\

	自殺なんて。
	おいて行かれた人の気持ちも考えないで。\

	【$g_hero】
	（そんなの間違ってるよ）\

	僕は津島のことは知らないけれど。
	菜摘先生のことを思うと、腹が立ってくる。\

	【$g_hero】
	（哀しんでくれる人がいるならば、
	　死ぬのはダメだ。ゼッタイにダメだ）\

	そりゃ、もし津島が生きていたら
	菜摘先生とはつき合えなかったかもしれないけど。\

	【$g_hero】
	（でも…あんな悲しそうな菜摘先生の顔は
	　見たくないよ）\

	菜摘先生。
	慰めたいなんて…思い上がり過ぎかな。\

	でも力になりたいよ。
	僕は携帯の中の写真を思い出す。\

	【$g_hero】
	（そうだ。写真だったら
	　僕だって撮ってやる…！！）\

	今年の桜が咲いたら、
	菜摘先生と一緒に写真を撮ろう。\

	卒業式のドサクサとかで
	撮れば誰もあやしまないだろう。\

	【$g_hero】
	（うん。そうだ、そうしよう！）\

	はりきってうなずいたそのとき
	授業のベルが鳴った。\
	gosub *musicstop
	;-効果音;----------------------------------
	mov $_se,"ZTYAIM"
	mov $debugstr,"ＳＥ：ZTYAIM"
	gosub *se

	キーンコーン…キーンコーン…。\

	return	;----------------------------------
;---E37  END -----
