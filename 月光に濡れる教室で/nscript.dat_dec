*C109B	; ■ファイル開始のラベル
	mov $debugstr,"■C109B " : gosub *debugout
;■■■「月光に濡れる教室で、僕は。」台本：●帰宅後：主人公：B109
;━━━━━━━━━━━━━━
;●帰宅後：主人公

	;--BGM;----------------------------------
	mov $_music,"01": gosub *out
	;--背景;----------------------------------
	mov $_bg,"BG033B"
	mov $debugstr,"ＢＧ：BG033B"
	gosub *out	;画面に出力
	;-効果音;----------------------------------
	mov $_se,"ZDOORC"
	mov $debugstr,"ＳＥ：ZDOORC"
	gosub *se
;ＢＧ：BG033B;主人公の家の玄関

	【$g_hero】
	ただいま。\

	家に帰ると、今日は誰もいなかった。
	兄さんの朝には帰りますというメモが
	食堂の冷蔵庫に、マグネットで止めてあった。\

	僕はそれを見たあと、冷蔵庫から
	ミネラルウォーターを取り出して飲んだ。\

	それから風呂に入った。\
	gosub *blackout
	;--背景;----------------------------------
	mov $_bg,"BG001B"
	mov $debugstr,"ＢＧ：BG001B"
	gosub *out	;画面に出力
;ＢＧ：BG001B;主人公の部屋

	【$g_hero】
	さてと…
	明日…明後日が、卒業式か…。\

	僕は壁に掛かっているカレンダーを
	見ながらつぶやいた。\

	【$g_hero】
	明日早く行って、講堂の用意しとかないと
	いけないんだっけ。\

	学生会の仕事もあるし、コーラス部の方も
	やらないといけないし。\

	【$g_hero】
	いろんなことがあったな…。\

	たくさんの事件。
	僕を追いつめ、先輩を苦しめた事件。\

	でもその事件はすべて解決したはずだった。
	片山の死によって…理不尽なくらいに唐突に。\

	それでも…まだ一つ残ってるんだ。\

	ノドの奥の小骨のようにひっかかってる。
	───「天使」。\

	【$g_hero】
	「天使」は…これからも僕たちに教室での行為を
	つづけさせるんだろうか？\

	口に出してみると不思議だった。
	僕たちのセックスは、
	最初の頃とはまるで意味が違っている。\

	なのに変わらず「天使」は、僕たちに命令する。
	夜の教室に行け、花に酔え、月に狂えと。\

	どうしてだろう。\

	「天使」はどうして僕たちに
	あんな事を強要するんだろう。\

	悪意？　趣味…？　どれも違う気がした。
	でも正解を言い当てても
	素通りしてしまう気がした。\

	ただひとつわかっていることは、
	でも僕には「天使」のことはわからない。
	それだけだった。\
	gosub *blackout

	return	;----------------------------------
;---C109B  END -----
