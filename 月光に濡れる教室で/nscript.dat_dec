	そうか？育巳の方がいい声してないか？\

	育巳のヤツは、きれいなテノールで唄う。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TDI"
	mov $debugstr,"立ち：TDI "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"DOP4505"
	mov $debugstr,"音声：DOP4505 "
	gosub *vo

