*D40	; ■ファイル開始のラベル
	mov $debugstr,"■D40 " : gosub *debugout
;■■■「月光に濡れる教室で、僕は。」台本：●主人公家を出る：D40
;━━━━━━━━━━━━━━
;●主人公家を出る

	;--BGM;----------------------------------
	mov $_music,"07": gosub *out
;BGM:迷
	;--背景;----------------------------------
	mov $_bg,"BG001B"
	mov $debugstr,"ＢＧ：BG001B"
	gosub *out	;画面に出力
;;主人公の部屋

	【$g_hero】
	そろそろ…時間かな…。\

	僕は身支度を整えた。寒いのでマフラーもまく。
	家の人間に気づかれないように、そっと外に出る。\
	;--背景;----------------------------------
	mov $_bg,"BG002B"
	mov $debugstr,"ＢＧ：BG002B"
	gosub *out	;画面に出力
;;主人公の家
	;-効果音;----------------------------------
	mov $_se,"ZKAZE"
	mov $debugstr,"ＳＥ：ZKAZE "
	gosub *se

	【$g_hero】
	うわ、さむっ…！\

	吐く息は白かった。歩き始めると寒さで耳が痛い。
	ポケットに手を突っ込んで早足で歩く。\

	【$g_hero】
	小夜子…来てるんだろうな…。
	…ったく…。\

	うれしいけど、情けない。
	自分を好きだって言ってくれる子に
	僕はろくに何もできやしない。\

	【$g_hero】
	なんとかしないとな。\

	自分のことだけだったら最悪、諦めればいい。
	諦めちゃえば楽になる。けど。\

	【$g_hero】
	そういうわけには、いかないよな。\

	かっこつけたいんだ。小夜子の前で。\

	信号待ち。僕はふーっと息を吐きながら
	顔を上に向けた。空の月が見える。\
	gosub *blackout

	return	;----------------------------------
;---D40  END -----
