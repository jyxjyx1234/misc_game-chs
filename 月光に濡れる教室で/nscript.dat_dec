*D17	; ■ファイル開始のラベル
	mov $debugstr,"■D17 " : gosub *debugout
;■■■「月光に濡れる教室で、僕は。」台本：●夜：Ｈ前：D17
;━━━━━━━━━━━━━━
;●夜：Ｈ前
	gosub *clear_char

	;--BGM;----------------------------------
	mov $_music,"09": gosub *out
;BGM:迷
	;--背景;----------------------------------
	mov $_bg,"BG001B"
	mov $debugstr,"ＢＧ：BG001B"
	gosub *out	;画面に出力
;ＢＧ：BG001B;主人公の部屋

	【$g_hero】
	さてと…行かないと。\

	僕は兄に借りたデジカメを持って家を出た。
	もし犯人のヤツが居たら、
	こっちも、これで写真をとってやる。\

	少しは考えないとな。
	あとはもう、運を天に任せるか。\

	誰にも気づかれないように、
	そっと家を出る。\
	;--背景;----------------------------------
	mov $_bg,"BG032B"
	mov $debugstr,"ＢＧ：BG032B"
	gosub *out	;画面に出力
;;公園

	学園の裏手の公園には、当然だれも居なかった。\

	【$g_hero】
	ちょっと早かったな…。
	時間ツブしていこうかな…。\

	僕はベンチに座って空を見上げた。
	空には銀色の真円に近い月が輝いている。\

	風はほとんどないのに、空の上の方は違うのか
	雲がとんでもないはやさで動いていく。\

	【$g_hero】
	小夜子…来てるかな…。\

	できれば来て欲しくないなと思った。
	僕ひとりで「天使」のヤツを捕まえて
	全部吐かせてやりたいと思った。\

	【$g_hero】
	むかつくんだよな。影でこそこそさ。\

	僕たちのことをのぞき見ていることも
	大貫君のことも。\

	出歯亀してるぐらいならいいよ。
	だけど大貫君のことは、レベルが違うだろ。\

	【$g_hero】
	犯人を知ってるなら、
	さっさと警察に通報すればいいんだよ…。\

	【$g_hero】
	さてと…そろそろだな。\

	僕は、昨日と同じところを通って
	こっそりと校内に忍び込んだ。\
	gosub *blackout

	return	;----------------------------------
;---D17  END -----
