*C77	; ■ファイル開始のラベル
	mov $debugstr,"■C77 " : gosub *debugout
;■■■「月光に濡れる教室で、僕は。」台本：●発見：B77
;━━━━━━━━━━━━━━
;●発見
;2003/01/16
	gosub *blackout
	gosub *blackout

	;--BGM;----------------------------------
	mov $_music,"02": gosub *out
	;--背景;----------------------------------
	mov $_bg,"BG001B"
	mov $debugstr,"ＢＧ：BG001B"
	gosub *out	;画面に出力
;ＢＧ：BG001A;主人公の部屋

	さっきから先輩の言葉を、思い出してばかりいる。\
	;-音声;----------------------------------
	mov $_voice,"CC7700"
	mov $debugstr,"音声：CC7700"
	gosub *vo

	【明海】
	『また…後でね？』\
	dwavestop CH_VOICE	;CC7700

	あんな事いって、あんな風に行っちゃって。
	どういう事なんだろうって、流石に言えないよ。\

	…もしかしなくても……先輩は…。
	あの教室での事は、けっしてイヤじゃなくって。\

	ああ、ダメだダメだって。
	そんな都合の良いように、とっちゃダメだって。\

	【$g_hero】
	ああ…もうなぁ……。\

	それでも、思い出す。
	…こっちまで、赤くなりそうだよ。\
;暗転。フェードよりもカーテンかな。時間経過。
	gosub *blackout

	;--BGM;----------------------------------
	mov $_music,"07": gosub *out
	;--背景;----------------------------------
	mov $_bg,"BG001B"
	mov $debugstr,"ＢＧ：BG001B"
	gosub *out	;画面に出力
;場所：主人公の部屋

	【$g_hero】
	…………………。
	そろそろ出かけなくちゃな。\

	【$g_hero】
	百合恵先生の事とか、話せるといいんだけど…。
	さっき話しそこねちゃったからなぁ…。……あ！\

	【$g_hero】
	そうだ利用者ノート！
	先輩に渡した方がわかるかな。\

	【$g_hero】
	ノート…持っていこう。\
	;-効果音;----------------------------------
	mov $_se,"ZPAPER"
	mov $debugstr,"ＳＥ：ZPAPER"
	gosub *se

	僕は、鞄から利用者ノートを取り出した。
	ぱらぱらと、めくっていく。\

	【$g_hero】
	…いつから名前が載ってるんだろう。\

	僕は、最初のページを開いた。\

	【$g_hero】
	これは、３学期分のノートか…。
	名前は…最初からあるや……。\

	【$g_hero】
	…書き写してみようか。\

	どうせ明日には、返さなくちゃいけないんだし。
	コピーを取ってもいいんだけど…。\

	ま、ダメ元でいいか。\

	僕は、自由帳を取り出して、
	先輩の分だけを、抜き書きしはじめた。\

	【$g_hero】
	ええと…日付と曜日と…備考欄…っと。
	………………。\

	黙々と書き写していく。
	時間は…まだあるな…大丈夫だろう。\

	【$g_hero】
	あれ？\

	僕は、利用者ノートと書き写したノートを
	見比べた。\

	間違いがないか、もう一度確かめる。\

	【$g_hero】
	……うん…間違いない……。
	菜摘先生も、定期的にって言ったしな…。\

	僕は、残りをすべて書き写した。
	それから、もう一度確かめておおきくうなずいた。\

	【$g_hero】
	これでよし。\

	先輩の名前は、二週間に一度載っていた。
	それは、全部同じ曜日だった。\

	【$g_hero】
	この日に、きっと誰かがその薬を取りに
	来るんだ。\

	その曜日。
	それは、しかも今日だった。\

	【$g_hero】
	保健室で張っていれば、
	ソイツを捕まえられるかもしれないぞ！\

	【$g_hero】
	よし！\

	僕はノートを持って、部屋を飛び出した。\
	gosub *blackout

	return	;----------------------------------
;---C77  END -----
