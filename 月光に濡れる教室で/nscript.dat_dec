	mov $_bg,"BG013A"
	mov $debugstr,"ＢＧ：BG013A"
	gosub *out	;画面に出力
;BGM:さりげない日常

	学生会の仕事をするために
	僕は学生会室に向かっていった。\

	【$g_hero】
	しまったなぁ…結構遅くなっちゃったぞ。\
	gosub *blackout
	;--背景;----------------------------------
	mov $_bg,"BG019A"
	mov $debugstr,"ＢＧ：BG019A"
	gosub *out	;画面に出力
;ＢＧ：BG019A;学生会室
	;-効果音;----------------------------------
	mov $_se,"ZDOORSLIDE"
	mov $debugstr,"ＳＥ：ZDOORSLIDE"
	gosub *se

	ガラッ。\

	【$g_hero】
	遅くなりました。\

	あわてて飛び込んだ学生会室では、
	学生会長の矢崎　良が、
	表面だけは、にこやかな笑顔で迎えてくれた。\
	;--立ちキャラ;----------------------------------
	mov $_char,"THB"
	mov $debugstr,"立ち：THB "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XOP4100"
	mov $debugstr,"音声：XOP4100 "
	gosub *vo

	【矢崎】
	やあ、遅かったね。\
	dwavestop CH_VOICE	;XOP4100 

	うわ…すげぇ、トゲだらけ…。\

	【$g_hero】
	…ご、ごめん。会長…。\

	なんで、こんなのが会長なんだろう。\

	矢崎　良は、僕とおなじ２年生。\

	とんでもない美形面してて、女子からの人気は
	絶大なモノがあるけど、僕はかなり苦手だ。\

	なぜかって言うと…。\
	;--立ちキャラ;----------------------------------
	mov $_char,"THI"
	mov $debugstr,"立ち：THI "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XOP4101"
	mov $debugstr,"音声：XOP4101 "
	gosub *vo

	【矢崎】
	いや、構わないよ。君の仕事は
	ちゃんとわけておいてあげたから。\
	dwavestop CH_VOICE	;XOP4101 

	形の良いあごをしゃくってみせる先には
	各クラスの委員から集められたプリントが
	山と積まれていた。\

	【$g_hero】
	あの……全然、手つけてないわけ？\
	;--立ちキャラ;----------------------------------
	mov $_char,"THB"
	mov $debugstr,"立ち：THB "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XOP4102"
	mov $debugstr,"音声：XOP4102 "
	gosub *vo

	【矢崎】
	オレはオレで忙しいからね。
	送別の言葉もあるし、来賓への招待状もあるし。\
	dwavestop CH_VOICE	;XOP4102 

	意地悪さ剥き出しで、にっこりと笑う。
	僕は大きくため息をついた。\

	こいつは、もうどうにも僕を虐げるのが
	好きみたいなのだ。絶対サドだ。\

	学生会の他の女の子には、朝は悪いからとか
	言って、来させないくせに…。\

	【$g_hero】
	ほんとかよ。\
	;--立ちキャラ;----------------------------------
	mov $_char,"THI"
	mov $debugstr,"立ち：THI "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XOP4103"
	mov $debugstr,"音声：XOP4103 "
	gosub *vo

	【矢崎】
	君の分の仕事を取り上げるなんて
	そんな非道なことはできないよ。\
	dwavestop CH_VOICE	;XOP4103 

	【$g_hero】
	…これ、今日中？\
	;--立ちキャラ;----------------------------------
	mov $_char,"THB"
	mov $debugstr,"立ち：THB "
	gosub	*out	;画面に出力

	矢崎は、にっこりと笑った。
	顔だけきれいでもだまされないぞ。\

	そもそも男だし。
	可愛い女の子ならともかくさ。\
	;--立ちキャラ;----------------------------------
	mov $_char,"THB"
	mov $debugstr,"立ち：THB "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XOP4104"
	mov $debugstr,"音声：XOP4104 "
	gosub *vo

	【矢崎】
	明日までの猶予にしてあげよう。\
	dwavestop CH_VOICE	;XOP4104 

	コイツ…いいのは顔だけだよな。ホント。\

	【$g_hero】
	は～。やっぱ、昨日家に持って帰って
	作業してくればよかった。\
	;--立ちキャラ;----------------------------------
	mov $_char,"THI"
	mov $debugstr,"立ち：THI "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XOP4105"
	mov $debugstr,"音声：XOP4105 "
	gosub *vo

	【矢崎】
	ふふっ。そう、ぼやくなよ。
	皆月先輩も手伝ってくれているんだし。\
