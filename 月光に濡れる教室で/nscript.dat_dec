	mov $debugstr,"■B40 " : gosub *debugout
;■■■「月光に濡れる教室で、僕は。」台本：●夜自宅で：田口の母：B40
;━━━━━━━━━━━━━━
;●夜自宅で：田口の母

	;--BGM;----------------------------------
	mov $_music,"01": gosub *out
;BGM:恋
	gosub *blackout
	;--背景;----------------------------------
	mov $_bg,"BG001B"
	mov $debugstr,"ＢＧ：BG001B"
	gosub *out	;画面に出力
;ＢＧ：BG001B;主人公の部屋

	真実と別れて自宅に戻った僕は
	何度目かの携帯のリダイヤルを押した。\
	;-効果音;----------------------------------
	mov $_se,"ZTEL2"
	mov $debugstr,"ＳＥ：ZTEL2 "
	gosub *se
;ＳＥ：ZTEL2;電話中

	トルルルル…。トルルルル…。\

	【$g_hero】
	……出ないな…田口…。\

	緊急連絡網に書いてある番号に
	かけたのだが、いっこうに誰もでやしない。
	何回かけても呼び出し音ばかりだった。\

	【$g_hero】
	家のひとぐらい、いないのかな…。
	留守電ぐらいにしとけよな…。\
	;-効果音;----------------------------------
	mov $_se,"ZTELUP"
	mov $debugstr,"ＳＥ：ZTELUP"
	gosub *se
;カチャッて音・・
	;-音声;----------------------------------
	mov $_voice,"XB4000"
	mov $debugstr,"音声：XB4000"
	gosub *vo

	【田口の母】
	はい、田口でございます。\
	dwavestop CH_VOICE	;XB4000

	わ、出た。\

	【$g_hero】
	あ、あの…僕は田口君と同じクラスの
	$g_fnameといいますが…。\
	gosub *musicstop
	;-音声;----------------------------------
	mov $_voice,"XB4001"
	mov $debugstr,"音声：XB4001"
	gosub *vo

	【田口の母】
	なによ、いないわよ。あんなバカ。
	いい加減にしてちょうだいよ！\
	dwavestop CH_VOICE	;XB4001

	【$g_hero】
	は、はぁ？\

	;--BGM;----------------------------------
	mov $_music,"03": gosub *out
;BGM:迷

	ば…バカって…。あの自分の息子じゃないのか？\
	;-音声;----------------------------------
	mov $_voice,"XB4002"
	mov $debugstr,"音声：XB4002"
	gosub *vo

	【田口の母】
	あんな、気持ち悪くてうっとうしい子
	顔も見たくないわよ。\
	dwavestop CH_VOICE	;XB4002

	【$g_hero】
	あ、あの…。\
	;-音声;----------------------------------
	mov $_voice,"XB4003"
	mov $debugstr,"音声：XB4003"
	gosub *vo

	【田口の母】
	まったくあたしの子供じゃないからって毎日
	恨みがましい目でみられて、うんざりよ。\
	dwavestop CH_VOICE	;XB4003

	【$g_hero】
	は…はぁ…。\
	;-音声;----------------------------------
	mov $_voice,"XB4004"
	mov $debugstr,"音声：XB4004"
	gosub *vo

	【田口の母】
	連れ子同士の再婚だからって、あたしの子供は
	ちゃんとしてるわよ。いい大学も行ったし。\
	dwavestop CH_VOICE	;XB4004

	【$g_hero】
	そ、そうですか…。\
	;-音声;----------------------------------
	mov $_voice,"XB4005"
	mov $debugstr,"音声：XB4005"
	gosub *vo

	【田口の母】
	なのにあの子ったら、頭は悪いしヘンな雑誌とか
	カメラとかそんなのばっかりで気持ち悪い…。\
	dwavestop CH_VOICE	;XB4005

	【$g_hero】
	…はあ…。\
	;-音声;----------------------------------
	mov $_voice,"XB4006"
	mov $debugstr,"音声：XB4006"
	gosub *vo

	【田口の母】
	あの子の母親がいけないのよね。
	甘やかし放題で、ちゃんと教育しないから。\
	dwavestop CH_VOICE	;XB4006

	【$g_hero】
	そ…そうですか…。\
	;-音声;----------------------------------
	mov $_voice,"XB4007"
	mov $debugstr,"音声：XB4007"
	gosub *vo

	【田口の母】
	バカで愚図でどうしようもないクズのくせに
	「お、お前にはわからないんだ」とか。\
	dwavestop CH_VOICE	;XB4007

	【$g_hero】
	はぁ…。\
	;-音声;----------------------------------
	mov $_voice,"XB4008"
	mov $debugstr,"音声：XB4008"
	gosub *vo

	【田口の母】
	バカよね！あの顔を見るとうっとうしいのよ！
	だから知らないから。いいわね！\
	dwavestop CH_VOICE	;XB4008

	【$g_hero】
	いいって、あの！\
	;-効果音;----------------------------------
	mov $_se,"ZTELUP"
	mov $debugstr,"ＳＥ：ZTELUP"
	gosub *se

	ガシャンッ！！\

	【$g_hero】
	うわっ！！
	な、なんなんだよ！　もう！！\

	田口んとこって再婚だったのか…。\

	【$g_hero】
	苦労してんのかな…。\

	いや…世の中、苦労してるひとはたくさん
	居るよな…。それでどうなるかは自分の責任だ。\

	でも、ちょっと同情…。嫌われるのはしかたない
	けど、理不尽すぎるよな。あのおばさん。\

	【$g_hero】
	うちみたいに、適当に放任なのが一番かなぁ…。\

	たまに、少しは息子のことを構えよとか思うけど。
	進学どうするのとか、聞いてきたこともないぞ
	うちの両親は。\

	でも、小遣いもらってメシ食わせてもらって
	衣食住に不自由無いんだから、満足すべきか。\

	;--BGM;----------------------------------
	mov $_music,"12": gosub *out
;BGM:桜井　真実

	【$g_hero】
	さて、どうしようかな…。\

	夜中に電話するわけにもいかないしな。
	携帯の番号聞いておけばよかった。\

	【$g_hero】
	真実…知ってるかな？\

	どちらにしても仲も良くない相手に
	電話するのはおっくうだった。\

	【$g_hero】
	やっぱ、明日でいいか。
	ガッコで田口と話そう。\
	gosub *blackout

	return	;----------------------------------
;---B40  END -----
