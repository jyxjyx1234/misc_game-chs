	mov $debugstr,"ＢＧ：BG031A"
	gosub *out	;画面に出力
;;購買
;☆１☆

	ここは購買だ。
	購買のおじさんがいないな…。\

	職務怠慢だ。
	誰もいないと勝手に商品を持ってかれちゃうぞ。\

	……。
	どうしてここに来たんだ？\

	欲しいものもないし…。
	帰ろう。\
	gosub *blackout

	return	;----------------------------------
