;BGM:さりげない日常
	;--背景;----------------------------------
	mov $_bg,"BG001A"
	mov $debugstr,"ＢＧ：BG001A"
	mov %effect,4	;エフェクトを指定
	gosub *out	;画面に出力
;;主人公の部屋
	;-効果音;----------------------------------
	mov $_se,"ZSUZUME"
	mov $debugstr,"ＳＥ：ZSUZUME "
	gosub *se

	あけっぱなしのカーテンから
	冬の太陽の光が差し込む。\

	冷気で霜だらけになった世界は
	とてもきらきらとしていた。\

	窓にも白い霜がびっちりとついている。
	ジャックフロスト。\

	僕は寒さのあまり、ブランケットにまるまり
	ながら、それをしばらく見つめていた。\

	細い細い指をもった女の子が
	そっと描いた絵みたいに見える。\

	夜中にそっと。だれもいない夜にそっと
	細い指と長い髪をゆらして絵を描くのだ。\

	もしかしたら、小林先輩はそんなひとだったの
	かもしれないと、なんとなく僕は思った。\

	一度も会ったこともなく、話をしたこともなく、
	消えてしまったひとが、そんな絵を
	描いていたと思っても、悪いことはないだろう。\

	そう、きっと。\

	窓ガラスに顔を近づけて、そっと息を
	吹きかけると。霜はやわらかく消えた。\

	return	;----------------------------------
;---B89  END -----
