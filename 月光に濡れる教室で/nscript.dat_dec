*BAD_IKUMI	; ■ファイル開始のラベル
	mov $debugstr,"■BAD_IKUMI " : gosub *debugout

	;--BGM;----------------------------------
	mov $_music,"08": gosub *out
;BGM:涙
	gosub *clear_char
	;--背景;----------------------------------
	mov $_bg,"BG025A"
	mov $debugstr,"ＢＧ：BG025A"
	gosub *out	;画面に出力

	【$g_hero】
	………………………。\

	僕は呆然としていた。
	声もでない。手も動かない。\

	育巳を止めなくちゃと思うのに、
	身体が凍り付いたように動かない。\
	gosub *musicstop

	その時だった。\
	;-効果音;----------------------------------
	mov $_se,"ZRUN"
	mov $debugstr,"ＳＥ：ZRUN"
	gosub *se

	タタタタッ…！\

	後ろから足音が聞こえたかと思うと…。\
	gosub *guragura
	;-効果音;----------------------------------
	mov $_se,"ZHIT2"
	mov $debugstr,"ＳＥ：ZHIT2 "
	gosub *se

	ガンッ！\

	【$g_hero】
	うっ…！\
;フラッシュとか点滅とか・・・

	頭がぐらぐらして、ずきずきと傷む。
	僕の後頭部を誰かが殴ったのだ。\

	【$g_hero】
	うっ…。くそっ…！\

	何度も瞬きをする。目がかすむ。
	足に力が入らない。\

	【$g_hero】
	だ…誰だ…。真実…？
	育巳…！？\
	;-効果音;----------------------------------
	mov $_se,"ZDOKUN2"
	mov $debugstr,"ＳＥ：ZDOKUN2 "
	gosub *se

	僕の意識が遠くなる。
	だめだ。だめだ。だめだ。\

	【$g_hero】
	もしかして……「天使」か…？\

	ここで意識を失ったら。
	きっと。
	きっと。\

	【$g_hero】
	くっ…！！\
	gosub *blackout
	;-効果音;----------------------------------
	mov $_se,"ZDOSA"
	mov $debugstr,"ＳＥ：ZDOSA "
	gosub *se
	gosub *GURA	;GURAを呼び出し

	ドサッ！\
	gosub *anime_bloodB	;anime_bloodBを呼び出し
;地面の血がにじむ＜ここもアニメにしてほしいなぁ…。
	gosub *blackout
;●バッドエンド
;バッドエンドは、殺されて、犯人扱い（笑）
;もちろん殺すのは先生なんだけど
;この話の場合は、育巳。
;先生は殺人教唆。

	mov %ending,BAD_END
	return	;----------------------------------
;---BAD_IKUMI  END -----

