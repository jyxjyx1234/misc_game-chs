*D122	; ■ファイル開始のラベル
	mov $debugstr,"■D122" : gosub *debugout
;■■■「月光に濡れる教室で、僕は。」台本：●エンディング１：ハッピー：D122
;━━━━━━━━━━━━━━
;●エンディング１：ハッピー

	;--BGM;----------------------------------
	mov $_music,"10": gosub *out
;BGM:Ｈ２
	;--背景;----------------------------------
	mov $_bg,"BG014D"
	mov $debugstr,"ＢＧ：BG014D"
	gosub *out	;画面に出力
;;校門

	私は、あなたが好き。
	先輩が好き。\

	どうして好きとか、なんで好きとか
	理由ならばいくらでもあげられる。\

	でも、本当はわからない。
	ただ、ひとつ言えるのは貴方が貴方だから好き。\

	きっと世の中の人間は
	みんな悪人でもなくて、みんな善人でもなくて。\

	いいひとだから、好きになるわけでもなく
	わるいひとだから、好きになるわけでもなく\

	ただ、どうしようもなく惹かれてしまう。
	それが、わかったから。\

	【$g_hero】
	おはよ、小夜子。\
	;-- イベントCG;----------------------------------
	mov $_cg,"D20A"
	mov $debugstr,"ＣＧ：D20A"
	gosub *cgout	;イベントＣＧ
	;-音声;----------------------------------
	mov $_voice,"DD12200"
	mov $debugstr,"音声：DD12200 "
	gosub *vo

	【小夜子】
	おはようございます、先輩。
	怪我の具合はどうですか？\
	dwavestop CH_VOICE	;DD12200 

	【$g_hero】
	うん、もう大丈夫。
	藤原さんは、まだしばらく入院だってね。\
	;-音声;----------------------------------
	mov $_voice,"DD12201"
	mov $debugstr,"音声：DD12201 "
	gosub *vo

	【小夜子】
	でも、命に別状なくて、本当によかった。\
	dwavestop CH_VOICE	;DD12201 

	【$g_hero】
	そうだな。\
	gosub *clear_char

	先輩は、うんと伸びをして
	それから痛ててと顔をしかめた。\

	いろんなことがあった。
	大貫君。二階堂先生。丹羽君。香津実さん。\

	それから、先輩と私。
	夜の教室での出来事。\

	【$g_hero】
	警察じゃ、まだ「天使」のことは
	つかめてないんだって？\
	;-音声;----------------------------------
	mov $_voice,"DD12202"
	mov $debugstr,"音声：DD12202 "
	gosub *vo

	【小夜子】
	そうみたいです。\
	dwavestop CH_VOICE	;DD12202 
	gosub *clear_char

	あの後は、もちろん大変な騒ぎになって
	警察は香津実さんをつれていった。\

	事件の大体のところは、私たちが
	知っていたのと同じだったけれど
	「天使」についてだけは皆目わからないようだ。\

	私と先輩のことも尋ねられたけれど
	先輩はまだ入院中であまり話せなかったから
	先輩のお兄さんがうまくごまかしてしまった。\

	【$g_hero】
	ああ、でもさ。なんていうのか…
	自分ってやっぱ、ちっぽけだよな。\

	きっと、それは今回の事件であった
	いろんなことを思っているのに違いなくて。\
	;-音声;----------------------------------
	mov $_voice,"DD12203"
	mov $debugstr,"音声：DD12203 "
	gosub *vo

	【小夜子】
	本当にそう思ってます、先輩？\
	dwavestop CH_VOICE	;DD12203 

	【$g_hero】
	思ってるよ。だからさ。
	いや、だけど…それが悪いとは思わないな。\
	gosub *clear_char

	そう。何も出来ないのは私もおなじ。
	けれども、わたしにも出来ることがある。\

	好きになること。好きでいること。
	貴方が好きだと思うこと。\

	気の早い桜の花びらが、ひらひらと飛んでいた。
	どこで咲いているのだろう。
	知らない間に春が来ているのだ。\
	;-音声;----------------------------------
	mov $_voice,"DD12204"
	mov $debugstr,"音声：DD12204 "
	gosub *vo

	【小夜子】
	先輩、ちょっと屈んでもらえますか？
	頭に花びらついてる。\
	dwavestop CH_VOICE	;DD12204 

	【$g_hero】
	え？　うん。\

	私はかがみ込んだ先輩の髪の
	花びらをそっと取り去った。\
	;-音声;----------------------------------
	mov $_voice,"DD12205"
	mov $debugstr,"音声：DD12205 "
	gosub *vo

	【小夜子】
	んと…はい、とれましたよ。\
	dwavestop CH_VOICE	;DD12205 

	先輩の顔が至近距離にあるのにどきりとする。\

	【$g_hero】
	小夜子。\

	甘いささやきに目を閉じる。\
	;-音声;----------------------------------
	mov $_voice,"DD12206"
	mov $debugstr,"音声：DD12206 "
	gosub *vo

	【小夜子】
	…はい。\
	dwavestop CH_VOICE	;DD12206 

	柔らかな唇が落ちてきて
	私は、私が知らなかった自分を知った。\

	貴方に出会って恋を知った。
	貴方に触れて恋を知った。\

	どうしようもなく、貴方に恋してる。\

	return	;----------------------------------
;---D122 END -----
