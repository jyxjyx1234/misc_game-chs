	mov $debugstr,"■C113" : gosub *debugout
;■■■「月光に濡れる教室で、僕は。」台本：●朝：最後の天使のメール：B113
;━━━━━━━━━━━━━━
;●朝：最後の天使のメール

	;--BGM;----------------------------------
