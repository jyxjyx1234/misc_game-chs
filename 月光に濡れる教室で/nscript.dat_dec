	if %map_pos==03 mov %map03,0: gosub *OP28:	goto *OPMAP02_map
	if %map_pos==04 mov %map04,0: gosub *OP29:	goto *OPMAP02_map
	if %map_pos==05 mov %map05,0: gosub *nomap05:	goto *OPMAP02_map
