*D106	; ■ファイル開始のラベル
	mov $debugstr,"■D106" : gosub *debugout
;■■■「月光に濡れる教室で、僕は。」台本：●小夜子と話：D106
;━━━━━━━━━━━━━━
;●小夜子と話

	;--BGM;----------------------------------
	mov $_music,"14": gosub *out
;BGM:芹沢　小夜子
	;--背景;----------------------------------
	mov $_bg,"BG008B"
	mov $debugstr,"ＢＧ：BG008B"
	mov %effect,4	;エフェクトを指定
	gosub *out	;画面に出力
;;小夜子の部屋
	;--立ちキャラ;----------------------------------
	mov $_char,"TDC"
	mov $debugstr,"立ち：TDC "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"DD10600"
	mov $debugstr,"音声：DD10600 "
	gosub *vo

	【小夜子】
	丹羽君…本当に怯えてましたね。\
	dwavestop CH_VOICE	;DD10600 

	【$g_hero】
	藤原さんも、そうだったけど
	自分がしてたこと…わかんなかったんだな。\

	って、それは僕もそうか。
	僕と小夜子がしてること…。これからすること。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TDA"
	mov $debugstr,"立ち：TDA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"DD10601"
	mov $debugstr,"音声：DD10601 "
	gosub *vo

	【小夜子】
	先輩、そろそろ時間ですよ。\
	dwavestop CH_VOICE	;DD10601 

	【$g_hero】
	行かなくてもいいよ。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TDF"
	mov $debugstr,"立ち：TDF "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"DD10602"
	mov $debugstr,"音声：DD10602 "
	gosub *vo

	【小夜子】
	…行きます。言ったでしょう？
	先輩の役に立ちたいんだって。\
	dwavestop CH_VOICE	;DD10602 

	【$g_hero】
	小夜子。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TDI"
	mov $debugstr,"立ち：TDI "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"DD10603"
	mov $debugstr,"音声：DD10603 "
	gosub *vo

	【小夜子】
	それに、今日こそは「天使」の手がかりが
	つかめるかも知れません。いえ、掴みましょう！\
	dwavestop CH_VOICE	;DD10603 

	【$g_hero】
	…うん。えっちしないようにがんばる。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TDG"
	mov $debugstr,"立ち：TDG "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"DD10604"
	mov $debugstr,"音声：DD10604 "
	gosub *vo

	【小夜子】
	先輩なら…その…
	い、いつでもいいですから、私。\
	dwavestop CH_VOICE	;DD10604 

	【$g_hero】
	なんだよ、すごいこと言うようになったな。
	えっちな話しただけで怒ってたのに。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TDF"
	mov $debugstr,"立ち：TDF "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"DD10605"
	mov $debugstr,"音声：DD10605 "
	gosub *vo

	【小夜子】
	そ、それはその…先輩のせいですからね！\
	dwavestop CH_VOICE	;DD10605 
	gosub *blackout

	return	;----------------------------------
;---D106 END -----
