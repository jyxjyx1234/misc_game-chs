	【明海】
	$g_fname君。…来てくれたのね。\
	dwavestop CH_VOICE	;CC7400

	【$g_hero】
	うん…来たよ。先輩。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCC"
	mov $debugstr,"立ち：TCC "
