	mov $debugstr,"ＳＥ：ZTELUP"
	gosub *se

	【$g_hero】
	なんだ育巳か。\
	;-音声;----------------------------------
	mov $_voice,"YB2300"
	mov $debugstr,"音声：YB2300"
	gosub *vo

	【育巳】
	なんだって、なんだよ。\
	dwavestop CH_VOICE	;YB2300

	【$g_hero】
	いや、ちょっと…。こっちの話。\
	;-音声;----------------------------------
	mov $_voice,"YB2301"
	mov $debugstr,"音声：YB2301"
	gosub *vo

	【育巳】
	ふーん。あ、もしかして今、時間ない？
	聞きたいことがあるんだけどさ。\
	dwavestop CH_VOICE	;YB2301

	【$g_hero】
	いや？いいけど。\
	;-音声;----------------------------------
	mov $_voice,"YB2302"
	mov $debugstr,"音声：YB2302"
	gosub *vo

	【育巳】
	自分が信じたことのために
	全てを賭けるのは正しいと思うか？\
	dwavestop CH_VOICE	;YB2302

	【$g_hero】
	なんだよ、いきなりマジだな。\
	;-音声;----------------------------------
	mov $_voice,"YB2303"
	mov $debugstr,"音声：YB2303"
	gosub *vo

	【育巳】
	ああ、マジだ。\
	dwavestop CH_VOICE	;YB2303

	僕はしばらく考えてから、返答した。\

	【$g_hero】
	トラブルだったら、相談乗るぞ。
	金だったら…正月のお年玉貯金があるし…。\

	小さい頃からずっと貯金だって言って使わせて
	もらってないのがある。頼めば、なんとか。\

	【$g_hero】
	最悪の場合、うちの兄に頼むとか…。
	あれでも法学部だし…。\

	兄さんに頼むのは、ものすごくイヤだが、
	背に腹は代えられない。\
	;-音声;----------------------------------
	mov $_voice,"YB2304"
	mov $debugstr,"音声：YB2304"
	gosub *vo

	【育巳】
	いや。オレの問題なんだ。\
	dwavestop CH_VOICE	;YB2304

	育巳の声はきっぱりとしていた。すごく大事な
	ことなんだろうなって、それぐらいはわかる。\

	【$g_hero】
	…ならいいけどさ。
	で、全てって何を？\
	;-音声;----------------------------------
	mov $_voice,"YB2305"
	mov $debugstr,"音声：YB2305"
	gosub *vo

	【育巳】
	全部。オレも。何もかも。\
	dwavestop CH_VOICE	;YB2305

	そんなに、全部？\

	…なんのトラブルなんだろう。少なくとも金とか
	そういうモノじゃない…だろうけど。\

	となると、たぶんそれは「誰か」への気持ちで。
	それってつまり…。\

	【$g_hero】
	誰かを…信じるってこと？\

	育巳は確認するように返事をした。\
	;-音声;----------------------------------
	mov $_voice,"YB2306"
	mov $debugstr,"音声：YB2306"
	gosub *vo

	【育巳】
	…そうかな。…そうかもな。\
	dwavestop CH_VOICE	;YB2306

	【$g_hero】
	それは、ものすごい難問だな。\
	;-音声;----------------------------------
	mov $_voice,"YB2307"
	mov $debugstr,"音声：YB2307"
	gosub *vo

	【育巳】
	まあな。\
	dwavestop CH_VOICE	;YB2307

	信じるか…。その言葉で
	なぜか僕は、真実のことが頭に浮かんだ。\

	僕が…彼女を信じる？　彼女の何を？
	何も知らないのに。\

	知ってるということなら、育巳の方が知っている。
	１年のときから一緒だったし、話もしてる。\

	だけど、育巳の全部は知らない。
	こんな風に訊ねてくる育巳の気持ちや
	状況は全部わからない。\

	わからないけれど、でも。\

	【$g_hero】
	でも…信じるってことは、つまりは…その…
	大事だと思えるのなら…って、ことだよな。\
	;-音声;----------------------------------
	mov $_voice,"YB2308"
	mov $debugstr,"音声：YB2308"
	gosub *vo

	【育巳】
	回りくどい言い方だな。\
	dwavestop CH_VOICE	;YB2308

	【$g_hero】
	ごめん。でもさ…信じるとか信じないとかって
	単純に「信じたい」って、それだけじゃないのか。\

	僕と育巳は、友だちやってて。
	友だちやってんのは、好きだからで。\

	だったら、信じたい。
	信じたいよな。\

	いや、本人に向かっては言わないけどさ。
	そんなこと言えるわけが。\
	;-音声;----------------------------------
	mov $_voice,"YB2309"
	mov $debugstr,"音声：YB2309"
	gosub *vo

	【育巳】
	うん…そうだな。だけど…何を信じたいかだな。\
	dwavestop CH_VOICE	;YB2309

	【$g_hero】
	…お前のためじゃないんだろ？\
	;-音声;----------------------------------
	mov $_voice,"YB2310"
	mov $debugstr,"音声：YB2310"
	gosub *vo

	【育巳】
	お前さ、大事な人っているか？\
	dwavestop CH_VOICE	;YB2310

	【$g_hero】
	大事なひと？\

	僕は、真実のことを思い出した。\
	;-音声;----------------------------------
	mov $_voice,"YB2311"
	mov $debugstr,"音声：YB2311"
	gosub *vo

	【育巳】
	自分の大事なひとが…痛めつけられて…
	苦しんでるなら？\
	dwavestop CH_VOICE	;YB2311

	【$g_hero】
	…それは…。\

	真実が…困っていたら、苦しんでいたら。\

	なぜだろう。
	なぜ真実のことを思い出したんだろう。\

	彼女と僕は恋人同士でもなんでもなくて。
	でも友達っていう関係でもなくて。\

	じゃあ何だ？　僕にとって何なんだ？
	好きなのか？　共犯者意識か？
	体だけの関係？　なんなんだろう。\

	わからない。わからないけど。
	けれど、真実は。\
;ここでモノトーンの笑顔とか入れたいな…。

	あんな泣きそうな顔で笑われるのは…
	僕は…いやだな。\

	【$g_hero】
	見過ごせないな。
	なにが出来るってわけでもないだろうけど。\

	そうだな。
	うん、きっと僕はそうだ。\

	何が出来るってわけでもないし、
	力になれるかどうかもわからないけど。\

	自分でも情けないけど
	何もないんだよな、僕は。\

	兄さんみたいに頭も良くないし、金もないし。
	腕っ節が強いわけでもないし。\

	【$g_hero】
	でも、なにか…できることする…だな。
	何ができるかわからないけど…。\
	;-音声;----------------------------------
	mov $_voice,"YB2312"
	mov $debugstr,"音声：YB2312"
	gosub *vo

	【育巳】
	…そっか。うん。そうだよな。
	できることを…するしかないよな。\
	dwavestop CH_VOICE	;YB2312

	【$g_hero】
	うん。\
	;-音声;----------------------------------
	mov $_voice,"YB2313"
	mov $debugstr,"音声：YB2313"
	gosub *vo

	【育巳】
	サンキュ。\
	dwavestop CH_VOICE	;YB2313

	【$g_hero】
	…本気でトラブルだったら、相談しろよ。
	兄さん法学部だし。いろいろ知り合い多いし。\

	兄さんに頭下げるのイヤだけど、育巳の為なら
	そのくらいは…構わない。使えるものは使えだ。\
	;-音声;----------------------------------
	mov $_voice,"YB2314"
	mov $debugstr,"音声：YB2314"
	gosub *vo

	【育巳】
	うん、ありがとな。\
	dwavestop CH_VOICE	;YB2314
	gosub *blackout

	return	;----------------------------------
;---B23  END -----
