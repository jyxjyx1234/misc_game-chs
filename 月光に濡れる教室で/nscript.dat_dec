;つじつまをあわせたり…。

	授業が始まった。\

	ギリギリ教室に飛び込んだ僕を、
	先生は大して気にしてないようだった。\
;;２年教室
	;--立ちキャラ;----------------------------------
	mov $_char,"TYA"
	mov $debugstr,"立ち：TYA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
