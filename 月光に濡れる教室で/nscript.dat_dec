	if %map_pos==07 mov %map07,0: goto *OPMAP02_akemi
	if %map_pos==08 mov %map08,0: gosub *OP33:	goto *OPMAP02_map
	if %map_pos==09 mov %map09,0: gosub *OP34:	goto *OPMAP02_map
	if %map_pos==10 mov %map10,0: gosub *OP35:	goto *OPMAP02_map
