	mov $debugstr,"■E20 " : gosub *debugout
;■■■「月光に濡れる教室で、僕は。」台本：●屋上へＧＯ：E20
;━━━━━━━━━━━━━━
;●屋上へＧＯ

	;--BGM;----------------------------------
	mov $_music,"15": gosub *out
	;--背景;----------------------------------
	mov $_bg,"BG025A"
	mov $debugstr,"ＢＧ：BG025A"
	gosub *out	;画面に出力
	;--立ちキャラ;----------------------------------
	mov $_char,"TEC"
	mov $debugstr,"立ち：TEC "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XE2000"
	mov $debugstr,"音声：XE2000"
	gosub *vo

	【菜摘先生】
	ごめんなさい、また、こんな風に呼び出して。\
	dwavestop CH_VOICE	;XE2000

	屋上は、やっぱり誰もいなくて。
	３月の空気が冷たかった。\

	でも、どこかでいい匂いがする。梅かな。
	春が、知らないところで近づいてきてる。\

	【$g_hero】
	いいえ…その…僕もうれしいから…。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TEA"
	mov $debugstr,"立ち：TEA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XE2001"
	mov $debugstr,"音声：XE2001"
	gosub *vo

	【菜摘先生】
	いつも同じ場所にいるのに、こうやって
	二人っきりになれる時間は少ないよね。\
	dwavestop CH_VOICE	;XE2001

	【$g_hero】
	そうですね。\

	会話が、会話が、会話がつづかない。
	菜摘先生とは、もっとざっくばらんに
	話をしていたはずだったのに。なんでだ。\

	【$g_hero】
	そ、そういえば、菜摘先生って、家は？\
	;--立ちキャラ;----------------------------------
	mov $_char,"TEB"
	mov $debugstr,"立ち：TEB "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XE2002"
	mov $debugstr,"音声：XE2002"
	gosub *vo

	【菜摘先生】
	両親と同居中です。\
	dwavestop CH_VOICE	;XE2002

	【$g_hero】
	それじゃあ…遊びに行けないな。\

	って、それは下心が見え見えすぎて。
	あまりにも自分が浅ましいので恥ずかしくなる。\

	【$g_hero】
	え、えっと…菜摘先生は…その…最近
	読んで面白かった本って…。\

	くだらないことを言い始める僕のそばに
	菜摘先生が寄ってくる。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TEA"
	mov $debugstr,"立ち：TEA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XE2003"
	mov $debugstr,"音声：XE2003"
	gosub *vo

	【菜摘先生】
	ねえ。\
	dwavestop CH_VOICE	;XE2003

	菜摘先生の手が、僕の腕を撫でる。
	服の上からなのに、その重さと暖かさに
	僕はゾクゾクした。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TEA"
	mov $debugstr,"立ち：TEA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XE2004"
	mov $debugstr,"音声：XE2004"
	gosub *vo

	【菜摘先生】
	二人っきりになって
	するのはお話…だけ？\
	dwavestop CH_VOICE	;XE2004

	きれいな声と、あまい香り。\

	【$g_hero】
	え？あ、あの…。\

	それは、それは、それは、その！！
	もしかしなくても、昨日の続きというか！\

	そういうことを期待してもいいって事
	なんでしょうか！　菜摘先生！！\
	;--立ちキャラ;----------------------------------
	mov $_char,"TEF"
	mov $debugstr,"立ち：TEF "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XE2005"
	mov $debugstr,"音声：XE2005"
	gosub *vo

	【菜摘先生】
	いやかな。私がこういうこと言うの。\
	dwavestop CH_VOICE	;XE2005

	信じられない。信じられないけど据え膳だ。
	いや、昨日もそうだったんだ。\

	【$g_hero】
	ううん。ううん。ぜんぜん、ぜんぜん！\

	この状態でイヤとかいう男がいるわけないと思う。
	いたら、きっと変態だ。\

	return	;----------------------------------
;---E20  END -----
