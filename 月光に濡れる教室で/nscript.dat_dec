	【$g_heroの兄】
	おはよう…って、あ、もう起きてる。
	早いね。\
	dwavestop CH_VOICE	;YB9100

	【$g_hero】
	うん。もう行くよ。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TLA"
	mov $debugstr,"立ち：TLA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"YC11200"
	mov $debugstr,"音声：YC11200 "
	gosub *vo

	【$g_heroの兄】
	もうじき卒業式だから？\
	dwavestop CH_VOICE	;YC11200 

	【$g_hero】
	それもあるけど。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TLD"
	mov $debugstr,"立ち：TLD "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"YB9102"
	mov $debugstr,"音声：YB9102"
	gosub *vo

	【$g_heroの兄】
	他にも理由が？\
	dwavestop CH_VOICE	;YB9102

	【$g_hero】
	うん、色々あるんだよ。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TLA"
	mov $debugstr,"立ち：TLA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"YC11201"
	mov $debugstr,"音声：YC11201 "
	gosub *vo

	【$g_heroの兄】
	ねえ。\
	dwavestop CH_VOICE	;YC11201 

	【$g_hero】
	何？\
	;--立ちキャラ;----------------------------------
	mov $_char,"TLA"
	mov $debugstr,"立ち：TLA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"YC11202"
	mov $debugstr,"音声：YC11202 "
	gosub *vo

	【$g_heroの兄】
	大丈夫？\
	dwavestop CH_VOICE	;YC11202 

	【$g_hero】
	…大丈夫だよ。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TLB"
	mov $debugstr,"立ち：TLB "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"YC11203"
	mov $debugstr,"音声：YC11203 "
	gosub *vo

	【$g_heroの兄】
	そうか。早く帰っておいで。
	ごちそう作って待ってるから。\
	dwavestop CH_VOICE	;YC11203 

	【$g_hero】
	じゃあ、期待してる。\
	gosub *blackout
	;--背景;----------------------------------
	mov $_bg,"BG005A"
	mov $debugstr,"ＢＧ：BG005A"
	gosub *out	;画面に出力
;ＢＧ：BG005A;明海の家

	【$g_hero】
	おかしいな…この時間になっても来ないなんて。\

	僕は時計を見る。
	まだ時間は十分にあるけど…珍しいな。\

	;--BGM;----------------------------------
	mov $_music,"13": gosub *out
	;--立ちキャラ;----------------------------------
	mov $_char,"TCD"
	mov $debugstr,"立ち：TCD "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC11204"
	mov $debugstr,"音声：CC11204 "
	gosub *vo

	【明海】
	ごめんなさい！\
	dwavestop CH_VOICE	;CC11204 

	【$g_hero】
	あ、おはよう。
	まだ時間もあるし大丈夫だよ。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCI"
	mov $debugstr,"立ち：TCI "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC11205"
	mov $debugstr,"音声：CC11205 "
	gosub *vo

	【明海】
	そう…でも遅くなってごめんなさいね。\
	dwavestop CH_VOICE	;CC11205 

	【$g_hero】
	いいってば。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCB"
	mov $debugstr,"立ち：TCB "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC11206"
	mov $debugstr,"音声：CC11206 "
	gosub *vo

	【明海】
	じゃあ…。
	おはようございます。\
	dwavestop CH_VOICE	;CC11206 

	【$g_hero】
	うん…おはよう。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCA"
	mov $debugstr,"立ち：TCA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC11207"
	mov $debugstr,"音声：CC11207 "
	gosub *vo

	【明海】
	どうしたの？\
	dwavestop CH_VOICE	;CC11207 

	【$g_hero】
	ううん…何でもない。\
	gosub *blackout
	;--背景;----------------------------------
	mov $_bg,"BG042A"
	mov $debugstr,"ＢＧ：BG042A"
	gosub *out	;画面に出力
;;住宅地
	gosub *clear_char

	こうして一緒に登校できるのも、
	あと数えるほどしかないんだ。\

	一緒に行けたはずの２年間が何だか
	ひどく惜しく感じられた。\

	ありえたかもしれないもう一つの日常を、
	僕は思い描いた。\

	こうして…明海と毎日並んで学園に通って、
	育巳や矢崎たちにからかわれて。\

	明海は、僕の隣で恥ずかしそうにうつむいて。
	でもほんのり…幸せそうに頬を染めるんだ。\

	後悔とは違うけど…。
	急に僕は切なくなった。\

	もうすぐ卒業式で。
	もうすぐ明海はあの学園から永久に去っていく。\

	僕より先に去っていくんだ。
	隣を歩く先輩を、僕は見た。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCA"
	mov $debugstr,"立ち：TCA "
	gosub	*out	;画面に出力
;【明海】［普］

	明海の顔は、晴れ晴れとしていた。
	真っ直ぐに前を向いて。\

	未来を憂うことのないまなざしだった。
	僕の切なさとはまるで違う場所にいる瞳だった。\

	明海は変わらない。
	僕は、すこしだけ淋しくなる。\

	真っ直ぐに世界を見つめる明海の視線を、
	僕は、愛しく、だけど少しだけ淋しく思った。\
	gosub *blackout

	return	;----------------------------------
;---C112 END -----
