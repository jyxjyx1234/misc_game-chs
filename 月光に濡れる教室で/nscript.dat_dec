*OP14	; ■ファイル開始のラベル
	mov $debugstr,"■OP14" : gosub *debugout
;■■■「月光に濡れる教室で、僕は。」台本：●明海と会話：OP14
;━━━━━━━━━━━━━━
;●明海と会話
	gosub *blackout

	;--BGM;----------------------------------
	mov $_music,"02": gosub *out
;BGM:喜
	;--背景;----------------------------------
	mov $_bg,"BG013A"
	mov $debugstr,"ＢＧ：BG013A"
	gosub *out	;画面に出力
;;廊下

	僕は冷え込んだ廊下をほてほてと歩いていた。\
;授業が始まるまでは、まだ間がある。
;朝練もやったし、あとは…。

	【$g_hero】
	うーん…学生会室に行くのか。\

	僕は、学生会の一員になっている。
	役職は書記なんだけど…。\

	何も好きで書記になったんじゃない。
	ガッコを休んでいたとき、勝手に
	ともだちに推薦されてしまったんだ。\

	そりゃね、学生会は確かに面倒くさいけどさ。
	行事にも率先して参加しなくちゃいけないし。\

	部活をやってるわけでもないし、
	勉強以外にすることもないのに。\

	みんな目の色変えて、勉強ベンキョウだよな。\

	もうちょっと他の事に目を向けてもいいと
	思うんだけどさ。\

	それこそ余計なお世話かな。\
;BGM:皆月　明海
	gosub *blackout
	;--背景;----------------------------------
	mov $_bg,"BG019A"
	mov $debugstr,"ＢＧ：BG019A"
	gosub *out	;画面に出力
;ＢＧ：BG019A;学生会室
;誰かがいると、普通に会話。
;二人きりになるとあからさまに気まずい
;明海ちゃんと言われるのは困る

	学生会室は、雑然としていた。\

	朝から人が、バタバタと走り回ってる。
	卒業式の準備で忙しいんだ。\

	;--BGM;----------------------------------
	mov $_music,"13": gosub *out
	;--立ちキャラ;----------------------------------
	mov $_char,"TCD"
	mov $debugstr,"立ち：TCD "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"COP1400"
	mov $debugstr,"音声：COP1400 "
	gosub *vo

	【明海】
	あら？　$g_fname君ね。\
	dwavestop CH_VOICE	;COP1400 

	書類を抱えた明海ちゃんが、こっちを見てた。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCA"
	mov $debugstr,"立ち：TCA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"COP1401"
	mov $debugstr,"音声：COP1401 "
	gosub *vo

	【明海】
	おはよう、朝からご苦労様。\
	dwavestop CH_VOICE	;COP1401 

	そう言って、明海ちゃんは微笑んだ。\

	明海ちゃんの目はすごく理知的だけど、
	そうして笑うととても優しい。\

	これはもしかすると…
	もしかするかもしれないぞ…。\

	【$g_hero】
	おはよう。
	明海ちゃんこそ、お疲れさま。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCC"
	mov $debugstr,"立ち：TCC "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"COP1402"
	mov $debugstr,"音声：COP1402 "
	gosub *vo

	【明海】
	え…ええ…。\
	dwavestop CH_VOICE	;COP1402 

	明海ちゃんが、ぎこちなく微笑んだ。
	…うーん、やっぱりダメか。\

	明海ちゃん、と呼んでしまったのは昔のクセだ。
	「明海ちゃん」の家は、僕の家の隣で
	つまりは、幼なじみなのだ。\

	親同士もそれなりに仲が良かったし。
	だから、僕や兄さんも、明海ちゃん家に
	よく遊びに行った。\

	明海ちゃん家には、ニシキゴイがおよぐ池が
	あったり、庭におおきな岩があったりして
	うちより、だんぜん面白かったのだ。\

	僕の家の近くには、同い年ぐらいの男の子が
	居なかったせいもあって、僕はすっかり
	明海ちゃんと仲良しになっていた。\

	でも…。背が伸びて、進学して、制服を
	着るようになると、明海ちゃんの方から
	僕を避けるようになった。\

	なんでか、わからないけど。
	そう言うものかもしんないけど。\

	なんだか、ちょっと寂しいものだよな。
	そういうことっていうのはさ。\

	だからこの学園に入学したとき、在校生の
	挨拶で、明海ちゃんが居たのには驚いた。\

	当時…つまりは、去年、明海ちゃんは
	学生会の会長だったのだ。\
;つまりは、矢崎の前の代の会長ってわけだ。

	だから、こうやって卒業式のこと、
	いろいろ手伝ってくれてるんだけどね。\

	明海ちゃんは、僕と二人っきりになることを
	避けている。\

	だけど、こうして誰かがいる場所だと
	普通に話すこともできる。\

	そりゃ昔みたいに、心から打ち解けての
	話はできないけれどね。\

	return	;----------------------------------
;---OP14 END -----
