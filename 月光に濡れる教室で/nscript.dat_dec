	私には、先輩のほうがいい声なんです。\
	dwavestop CH_VOICE	;DOP4505 

	まっすぐに言い放たれる言葉に
	僕はすこしだけ赤面する。\

	【$g_hero】
	ありがとう。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TDB"
	mov $debugstr,"立ち：TDB "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"DOP4506"
	mov $debugstr,"音声：DOP4506 "
	gosub *vo

	【小夜子】
	いえ。\
	dwavestop CH_VOICE	;DOP4506 

	小夜子は僕のことが好きだ。僕も小夜子はかわいい。
	だけど、僕たちは付き合ってるわけじゃない。\

	小夜子は、いわゆる「男女のおつきあい」と
	いうヤツをものすごく嫌悪している。\

	それは、僕と小夜子の出会いが元なんだけど。\

	そして、小夜子が僕を好きなのも、
	その出会いが理由なんだけど。\
