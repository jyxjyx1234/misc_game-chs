; MPX232
; Copyright (C) Cherrysoft. All rights reserved
; 2003/03/04
;============================================
*MPX232	; ■ファイル開始のラベル
	mov $debugstr,"■MPX232" : gosub *debugout
;■マップ（無人）
	;--背景;----------------------------------
	mov $_bg,"BG023A"
	mov $debugstr,"ＢＧ：BG023A"
	gosub *out	;画面に出力
;;職員室

	ここは職員室だ。\

	【$g_hero】
	誰もいないな…学園がバタバタしてるから
	なぁ…。\

	流石にのんびりしてられないんだろう。\

	【$g_hero】
	無人の職員室か…。\

	そういえば、職員室の七不思議ってのが
	あったっけ…。\

	その名も『コンバンワ、私　まぼちゃん！』\

	……大分苦しいような気がするけど…。\

	何でも真夜中に、職員室で幽霊姿のまぼちゃんが
	イタ電をしてくるらしい。\

	しかもそのまぼちゃんとおぼしき人物（？）は
	「まぼ」しか言わないらしい。\
	gosub *blackout
	;--背景;----------------------------------
	mov $_bg,"BG023B"
	mov $debugstr,"ＢＧ：BG023B"
	gosub *out	;画面に出力
;場所：夜中の職員室
	;-効果音;----------------------------------
	mov $_se,"ZMYTEL"
	mov $debugstr,"ＳＥ：ZMYTEL"
	gosub *se

	トゥルルルル…トゥルルルル…\
	gosub *sestop
	;--立ちキャラ;----------------------------------
	mov $_char,"TXB"
	mov $debugstr,"立ち：TXB "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"K029"
	mov $debugstr,"音声：K029"
	gosub *vo

	【まぼちゃん】
	まーんぼ？ ま～んぼ！まーんぼ？\
	dwavestop CH_VOICE	;K029
	gosub *clear_char
	gosub *blackout
	;--背景;----------------------------------
	mov $_bg,"BG023A"
	mov $debugstr,"ＢＧ：BG023A"
	gosub *out	;画面に出力

	【$g_hero】
	………………………。
	はっ！！　想像して和んでしまった。\

	話してる内容がわからないと、
	微笑ましいだけではないだろうか…。\

	【$g_hero】
	いやいや。こんなことしてる場合じゃないぞ…。
	戻ろう。\
	gosub *blackout
	return
	;----------------------------------
;---MPX232 END -----

