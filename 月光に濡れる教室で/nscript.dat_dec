	;--背景;----------------------------------
	mov $_bg,"BG025A"
	mov $debugstr,"ＢＧ：BG025A"
	gosub *out	;画面に出力
;;屋上
;屋上で明るい青空の下

	【$g_hero】
	せ…先生…。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TEF"
	mov $debugstr,"立ち：TEF "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XEH0000"
	mov $debugstr,"音声：XEH0000 "
	gosub *vo

	【菜摘先生】
	ん…んふうっ…んっ…ちゅぅ…。\
	dwavestop CH_VOICE	;XEH0000 

	僕と先生はキスをした。\
	;-Ｈ効果音;----------------------------------
	mov $_se,"WA002"
	mov $debugstr,"Ｈ音：WA002 "
	gosub *se
;指先でいじる（くちゅゅ）

	菜摘先生の舌が、僕の口腔に
	そっと入りこんできた。僕も舌を絡める。\

	腕の中に居る菜摘先生の暖かさと
	華奢な身体にどきどきする。\
