*C07	; ■ファイル開始のラベル
	mov $debugstr,"■C07 " : gosub *debugout
;■■■「月光に濡れる教室で、僕は。」台本：●警察の事情聴取：B07
;━━━━━━━━━━━━━━
;●警察の事情聴取
;2003/01/07
	gosub *blackout

	;--BGM;----------------------------------
	mov $_music,"06": gosub *out
	;--背景;----------------------------------
	mov $_bg,"BG012A"
	mov $debugstr,"ＢＧ：BG012A"
	gosub *out	;画面に出力
;ＢＧ：BG012A;保健室
	;-効果音;----------------------------------
	mov $_se,"ZDOORSLIDE"
	mov $debugstr,"ＳＥ：ZDOORSLIDE"
	gosub *se

	ガラリと、保健室のドアが開く音がして
	背広を着た見慣れない中年の男と
	菜摘先生が現れた。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TEC"
	mov $debugstr,"立ち：TEC "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XB0500"
	mov $debugstr,"音声：XB0500"
	gosub *vo

	【菜摘先生】
	$g_fname君、
	警察の方がお話を聞きたいそうなんだけど…。\
	dwavestop CH_VOICE	;XB0500
	gosub *clear_char

	【$g_hero】
	あ、はい…。\

	僕は頷いて、保健室の隅のテーブルで
	警察のひとと話をした。\

	保健室には、僕と先輩と、先生たち二人。
	それと警察の人しか居ない。\

	警察のひとは、思ったより普通のサラリーマン
	みたいな、話しやすい人だった。\

	事務的に、ちゃんと話をしてくれたので
	自分でもこんがらがりそうな事を説明できた。\

	事件が起きる前には何も気が付かなかった。
	死んだひとは、まったく知らない。\

	先輩と一緒に裏庭に行った理由はと
	聞かれたときには、思わず顔を赤らめてしまった。
	そんな、素直に言えるわけがない。\

	そうしたら、刑事さんは何か勘違いしたのか
	いいね、若いひとはと、にこやかに笑った。\

	なんだか、人を騙しているみたいで
	気が引けた。つくづく小心者だ。僕は。\

	次に皆月先輩が、僕と同じようなことを聞かれ、
	僕と同じように返事をした。\

	一通り話を聞き終わると、刑事さんたちは
	あまり気にしないようにね、と言って
	帰っていった。\
	gosub *blackout

	;--BGM;----------------------------------
	mov $_music,"04": gosub *out
;BGM:哀
	;--背景;----------------------------------
	mov $_bg,"BG012A"
	mov $debugstr,"ＢＧ：BG012A"
	gosub *out	;画面に出力

	【$g_hero】
	ふう…。なんか疲れた…。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TIA"
	mov $debugstr,"立ち：TIA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XB0501"
	mov $debugstr,"音声：XB0501"
	gosub *vo

	【百合恵先生】
	だらしないわね、若いのに。\
	dwavestop CH_VOICE	;XB0501

	【$g_hero】
	んなこと言われても…。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TEC"
	mov $debugstr,"立ち：TEC "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XB0502"
	mov $debugstr,"音声：XB0502"
	gosub *vo

	【菜摘先生】
	でも、ふたりともショックだったでしょう？
	今日は、もう帰った方がいいわね。\
	dwavestop CH_VOICE	;XB0502
	;--立ちキャラ;----------------------------------
	mov $_char,"TIC"
	mov $debugstr,"立ち：TIC "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XB0503"
	mov $debugstr,"音声：XB0503"
	gosub *vo

	【百合恵先生】
	そうね。\
	dwavestop CH_VOICE	;XB0503
	;--立ちキャラ;----------------------------------
	mov $_char,"TCA"
	mov $debugstr,"立ち：TCA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC0700"
	mov $debugstr,"音声：CC0700"
	gosub *vo

	【明海】
	もう…授業も終わるもの。
	帰りましょう？　$g_fname君。\
	dwavestop CH_VOICE	;CC0700

	【$g_hero】
	もう、そんな時間なのか。\

	僕はびっくりした。
	思ったよりも寝てたんだ。\

	僕は先輩を見た。
	先輩は、黙って僕にうなずいた。\

	僕は、立ち上がった。\

	【$g_hero】
	菜摘先生、
	いっぺん教室もどってから帰ります。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TEA"
	mov $debugstr,"立ち：TEA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XB0514"
	mov $debugstr,"音声：XB0514"
	gosub *vo

	【菜摘先生】
	わかったわ。\
	dwavestop CH_VOICE	;XB0514
	;--立ちキャラ;----------------------------------
	mov $_char,"TIC"
	mov $debugstr,"立ち：TIC "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XB0515"
	mov $debugstr,"音声：XB0515"
	gosub *vo

	【百合恵先生】
	今日は早く帰るのよ。寄り道しないで。\
	dwavestop CH_VOICE	;XB0515

	【$g_hero】
	はい。失礼します。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCA"
	mov $debugstr,"立ち：TCA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC0701"
	mov $debugstr,"音声：CC0701"
	gosub *vo

	【明海】
	失礼します。\
	dwavestop CH_VOICE	;CC0701
	gosub *clear_char
	;-効果音;----------------------------------
	mov $_se,"ZDOORSLIDE"
	mov $debugstr,"ＳＥ：ZDOORSLIDE"
	gosub *se
;ドアしまる。
	gosub *blackout

	;--BGM;----------------------------------
	mov $_music,"13": gosub *out
;BGM:皆月　明海
	;--背景;----------------------------------
	mov $_bg,"BG013A"
	mov $debugstr,"ＢＧ：BG013A"
	gosub *out	;画面に出力
;ＢＧ：BG013A;廊下

	【$g_hero】
	…………………………。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCC"
	mov $debugstr,"立ち：TCC "
	gosub	*out	;画面に出力

	【明海】
	…………………………。\

	【$g_hero】
	…大変なことになったね。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCJ"
	mov $debugstr,"立ち：TCJ "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC0702"
	mov $debugstr,"音声：CC0702"
	gosub *vo

	【明海】
	そうね…。\
	dwavestop CH_VOICE	;CC0702

	【$g_hero】
	テレビとか新聞記者とかも来るのかな。
	取材とか…。\
	;-音声;----------------------------------
	mov $_voice,"CC0703"
	mov $debugstr,"音声：CC0703"
	gosub *vo

	【明海】
	……そうかもね。\
	dwavestop CH_VOICE	;CC0703

	【$g_hero】
	…………………………。\

	【明海】
	…………………………。\

	何だか…すごくもどかしかった。\

	話したいことは別にあるのに、ちっとも
	そこに行き着けない。\

	こんな…こんな…どうでも良くて
	どうしようもない話が、したいんじゃないだ。\

	けれど糸口が見つからない。
	色々なことがありすぎて、ぐちゃぐちゃで。\

	人ひとりがこの世から消えてなくなったって
	言うのに。\

	悼む間もなく、昨日の事とか…自分の事とか、
	やっぱり考えてしまう。\

	何から考えていいのか、何を考えるべきなのか
	わからないんだ。\

	だから考えがまとまらなくて、全部を、
	僕にふりかかったすべての問題を、考えてしまう。\

	そのとき。\

	return	;----------------------------------
;---C07  END -----
