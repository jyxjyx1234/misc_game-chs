	mov $debugstr,"音声：YC1400"
	gosub *vo

	【育巳】
	よう、おつかれさん。\
	dwavestop CH_VOICE	;YC1400

	【$g_hero】
	育巳。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TJC"
	mov $debugstr,"立ち：TJC "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"YC1401"
	mov $debugstr,"音声：YC1401"
	gosub *vo

	【育巳】
	あのさ……ちょっと…。\
	dwavestop CH_VOICE	;YC1401

	育巳が、さりげなく顔を寄せてきた。
	何だろう…。\

	僕も耳を近づけた。
	けれど、育巳はつづきを言わなかった。\

	ちらりと周囲を見渡して、それから顔を離した。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TJB"
	mov $debugstr,"立ち：TJB "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"YC1402"
	mov $debugstr,"音声：YC1402"
	gosub *vo

	【育巳】
	っていうかさ、キミたちつきあってるの？
	ボク、全然知らなかったですよ。\
	dwavestop CH_VOICE	;YC1402

	【$g_hero】
	あ、いや…それは…。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCF"
	mov $debugstr,"立ち：TCF "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC1403"
	mov $debugstr,"音声：CC1403"
	gosub *vo

	【明海】
	そ、そんなことありません！\
	dwavestop CH_VOICE	;CC1403

	先輩が、真っ赤になって叫んだ。
	その声に、周りの視線が一気に集まった。\

	これで堂々と見られる。
	…そんなあからさまな視線だった。\

	;--BGM;----------------------------------
	mov $_music,"03": gosub *out

	【$g_hero】
	………………。\

	今まで。教室にいて辛いと思ったことは、一度も
	なかった。でも今は違う。\

	居心地が悪い。ここに長くいたくない。
	こんな風に…異物あつかいされるのはイヤだ。\

	だってずっと…みんなと同じように、いたんだ。
	注目もされなかったけど、排斥もされなかった。\

	それは、当たり前のものだった。当たり前すぎて、
	その快適さに気づけない位に。\

	なんだよ。僕たちが何したっていうんだよ。
	何もしてないじゃないか。\

	ただ……事件が起きた場所にいた。
	それだけじゃないか。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TJB"
	mov $debugstr,"立ち：TJB "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"YC1404"
	mov $debugstr,"音声：YC1404"
	gosub *vo

	【育巳】
	まぁまぁ、興奮する気持ちはわかるけど、
	落ち着いて。\
	dwavestop CH_VOICE	;YC1404

	【$g_hero】
	育巳！！どういうつもりでっ…っ！？\
	;--立ちキャラ;----------------------------------
	mov $_char,"TJA"
	mov $debugstr,"立ち：TJA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"YC1405"
	mov $debugstr,"音声：YC1405"
	gosub *vo

	【育巳】
	もうすこし、ゆっくりお話できる場所で
	お話しましょ？\
	dwavestop CH_VOICE	;YC1405

	そう言って育巳は、僕と皆月先輩の腰を取った。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCD"
	mov $debugstr,"立ち：TCD "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC1406"
	mov $debugstr,"音声：CC1406"
	gosub *vo

	【明海】
	キャっ！？\
	dwavestop CH_VOICE	;CC1406

	【$g_hero】
	おっおい！？\
	;--立ちキャラ;----------------------------------
	mov $_char,"TJB"
	mov $debugstr,"立ち：TJB "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"YC1407"
	mov $debugstr,"音声：YC1407"
	gosub *vo

	【育巳】
	さあさあ、行きましょうね～～～～。\
	dwavestop CH_VOICE	;YC1407

	【$g_hero】
	おいっ、育巳！？\

	僕はあわてた。
	自分の机に戻って、ノートを探さないと。\

	けど育巳は、強引だった。
	ぐいぐいと、僕たちを引っ張り出していく。\

	それから育巳は、
	低いけど良く通る声でいった。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TJL"
	mov $debugstr,"立ち：TJL "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"YC1408"
	mov $debugstr,"音声：YC1408"
	gosub *vo

	【育巳】
	…行こうぜ。
	こんな気分の悪い場所にいても仕方がないだろ？\
	dwavestop CH_VOICE	;YC1408

	ザワっと。
	あたりがざわめいた。\

	僕もギョッと育巳を見た。
	だけど、育巳は平気な顔をしている。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TJA"
	mov $debugstr,"立ち：TJA "
	gosub	*out	;画面に出力
;【育巳】［普］

	育巳が、軽く目配せする。
	その目は、笑っていた。\

	大丈夫だから、と言っていた。
	…わかっていて、育巳は言ったんだ。\

	なんだよ…泣けるじゃないか…。
	別に…お前まで指さされる必要はないのにさ。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TJB"
	mov $debugstr,"立ち：TJB "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"YC1409"
	mov $debugstr,"音声：YC1409"
	gosub *vo

	【育巳】
	はいは～い。それではお二人様ごあんな～いっ。\
	dwavestop CH_VOICE	;YC1409

	僕たちは、並んで２年の教室を出た。\
