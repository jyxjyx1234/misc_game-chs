	mov $debugstr,"音声：XEH0001 "
	gosub *vo

	【菜摘先生】
	ん…ちゅっ…んちゅぅ…。\
	dwavestop CH_VOICE	;XEH0001 

	舌は生暖かかった。ぬらぬらしてる。
	味蕾のところをざりっと擦り合わせると
	腰から背骨にそってゾクゾクと快感が走った。\
	;-Ｈ効果音;----------------------------------
