	mov $debugstr,"■OP22" : gosub *debugout
;■■■「月光に濡れる教室で、僕は。」台本：●菜摘先生：OP22
;━━━━━━━━━━━━━━
;●菜摘先生

	;--BGM;----------------------------------
	mov $_music,"05": gosub *out
;BGM:藍田　菜摘
	;--背景;----------------------------------
	mov $_bg,"BG013A"
	mov $debugstr,"ＢＧ：BG013A"
	gosub *out	;画面に出力
;ＢＧ：BG013A;廊下

	【$g_hero】
	ええと…今日は…コーラス部に行って…
	学生会にも行かなくちゃならないし…。\

	【$g_hero】
	ああ！！こんがらがるぞ！！
	どれからやれば良いんだ…。\

	つぶやきながら持ってきた書類を広げる。
	歩きながらだと、ますます混乱しそうだけど…。\

	【$g_hero】
	えーと式次第の調整と…在校生からの挨拶と…
	来賓の時間の調整は…。\

	;--BGM;----------------------------------
	mov $_music,"15": gosub *out
	;--立ちキャラ;----------------------------------
	mov $_char,"TEA"
	mov $debugstr,"立ち：TEA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XOP2200"
	mov $debugstr,"音声：XOP2200 "
	gosub *vo

	【菜摘先生】
	こら。読みながら歩くなんて目を悪くするよ。\
	dwavestop CH_VOICE	;XOP2200 

	僕のもっていた書類がひょいと取り上げられる。
	あわてて前を向くと、にっこりと笑う姿。\

	【$g_hero】
	あ、菜摘先生。こんにちわ。\

	僕はあわてて挨拶した。先生はにっこりと
	綺麗な頬笑みと一緒に書類を返してくれた。\

	こんな綺麗な人が担任でしかも
	僕が所属してるコーラス部の顧問だなんて。\

	今年１年、本当にいい年だったよな…。
	ガッコに来る張り合いが違うよな。うんうん。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TED"
	mov $debugstr,"立ち：TED "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XOP2201"
	mov $debugstr,"音声：XOP2201 "
	gosub *vo

	【菜摘先生】
	どうしたの？
	部室なら、方向逆だけど？\
	dwavestop CH_VOICE	;XOP2201 

	【$g_hero】
	すいません。今日はちょっとわからなくて…。
	学生会もあるので。\

	僕は自分のもっていた書類を軽くあげて
	先生に見せた。先生がうなづく。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TED"
	mov $debugstr,"立ち：TED "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XOP2202"
	mov $debugstr,"音声：XOP2202 "
	gosub *vo

	【菜摘先生】
	ああ、そうだね。大変だね、君は。\
	dwavestop CH_VOICE	;XOP2202 

	【$g_hero】
	しょうがないです。けど、毎年おなじことを
	やってるはずなのに、なんで苦労をするんだか。\

	そういうと先生はおかしそうに笑った。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TEA"
	mov $debugstr,"立ち：TEA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XOP2203"
	mov $debugstr,"音声：XOP2203 "
	gosub *vo

	【菜摘先生】
	それは卒業するひとが違うからでしょう。
	在校生もちがうんだし。\
	dwavestop CH_VOICE	;XOP2203 

	【$g_hero】
	違わないと困りますけどね。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TEB"
	mov $debugstr,"立ち：TEB "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XOP2204"
	mov $debugstr,"音声：XOP2204 "
	gosub *vo

	【菜摘先生】
	ふふっ、そうね。でも、卒業式まで
	あと１週間もないのね。\
	dwavestop CH_VOICE	;XOP2204 

	【$g_hero】
	今日入れて…５日間ですね。
	合唱大丈夫かな…。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TEA"
	mov $debugstr,"立ち：TEA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XOP2205"
	mov $debugstr,"音声：XOP2205 "
	gosub *vo

	【菜摘先生】
	みんながちゃんとやれば大丈夫よ。\
	dwavestop CH_VOICE	;XOP2205 

