	dwavestop CH_VOICE	;YD0905
	;--立ちキャラ;----------------------------------
	mov $_char,"TPB"
	mov $debugstr,"立ち：TPB "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"YD0906"
	mov $debugstr,"音声：YD0906"
	gosub *vo

	【二階堂校長】
	うむ。そうそう！推理モノのセオリーだからな！
	第一発見者が犯人！！　はっはっはっ！！\
	dwavestop CH_VOICE	;YD0906
	gosub *blackout
	;--背景;----------------------------------
	mov $_bg,"BG019A"
	mov $debugstr,"ＢＧ：BG019A"
	gosub *out	;画面に出力

	ふたりの声は遠くなっていった。
	僕は、小夜子と二人で声もなかった。\
