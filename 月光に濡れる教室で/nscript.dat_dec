	ああ、僕はきっと狂ってしまったんだ。
	この白い体をずっと犯していたい。\
	;-Ｈ効果音;----------------------------------
	mov $_se,"WC005"
	mov $debugstr,"Ｈ音：WC005 "
	gosub *se
;ナニを出し入れ/（パンパン）

	ダラダラといつまでも蜜をこぼしつづける
	先輩の中をかき回していたいんだ。\
	;-Ｈ効果音;----------------------------------
	mov $_se,"WC007"
	mov $debugstr,"Ｈ音：WC007 "
	gosub *se
