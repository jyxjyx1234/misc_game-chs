*C06	; ■ファイル開始のラベル
	mov $debugstr,"■C06 " : gosub *debugout
;■■■「月光に濡れる教室で、僕は。」台本：●保健室：B06
;━━━━━━━━━━━━━━
;●保健室
;2003/01/07

	;--BGM;----------------------------------
	mov $_music,"06": gosub *out
	;--背景;----------------------------------
	mov $_bg,"BG012A"
	mov $debugstr,"ＢＧ：BG012A"
	gosub *out	;画面に出力
;ＢＧ：BG012A;保健室

	【$g_hero】
	あれ…？　ここ…。\

	保健室だ。僕がいるのは、ベッドの上。
	二三度、頭を振って、あたりを見回す。\

	机の近くに、先輩と百合恵先生が座っていた。
	先に先輩が僕に気づいたようだった。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCI"
	mov $debugstr,"立ち：TCI "
	gosub	*out	;画面に出力

	先輩の顔色は、蒼白だった。
	遠目にもそれはよくわかった。\

	けれどその背筋は、いつものように奇麗に
	のばされていた。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCA"
	mov $debugstr,"立ち：TCA "
	gosub	*out	;画面に出力

	僕に気づいた先輩が笑いかけてくれた。
	その姿に僕は気丈、という言葉を思い出した。\

	百合恵先生が近づいてきた。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TIA"
	mov $debugstr,"立ち：TIA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XB0400"
	mov $debugstr,"音声：XB0400"
	gosub *vo

	【百合恵先生】
	あら、気が付いたのね。\
	dwavestop CH_VOICE	;XB0400

	【$g_hero】
	百合恵センセ…。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TIB"
	mov $debugstr,"立ち：TIB "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XB0401"
	mov $debugstr,"音声：XB0401"
	gosub *vo

	【百合恵先生】
	もうお昼過ぎたわよ。お腹空いたでしょう。
	サンドイッチならあるけど。\
	dwavestop CH_VOICE	;XB0401

	【$g_hero】
	あ…。うん…。\

	その途端、僕は思い出した。
	落ちてきた人影と、それから血と。\

	【$g_hero】
	…いや、やっぱいいです。\

	胸に何かがこみ上げてきた。
	とうてい食べられそうもない。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TIC"
	mov $debugstr,"立ち：TIC "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XB0402"
	mov $debugstr,"音声：XB0402"
	gosub *vo

	【百合恵先生】
	食欲ない？じゃあ飲み物だけでも。
	ココアでいい？\
	dwavestop CH_VOICE	;XB0402

	【$g_hero】
	…はい。\

	あたたかい湯気のたつマグカップを渡される。
	チョコレートのいい匂いがした。\

	【$g_hero】
	あちっ。\

	熱いそれを、ちびちび啜りながら、
	僕は百合恵先生に話を聞いてみた。\

	【$g_hero】
	あの…僕は…。\

	なんで眠ってたんだろう。もしかして、僕は
	気絶してたのかな。…ちょっと恥ずかしい。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TIB"
	mov $debugstr,"立ち：TIB "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XC0600"
	mov $debugstr,"音声：XC0600"
	gosub *vo

	【百合恵先生】
	ちょっと、鎮静剤をね。
	まともに話せるような状態じゃなかったから。\
	dwavestop CH_VOICE	;XC0600

	【$g_hero】
	そうだったんだ。\

	そういや、パニック状態っていうんだろうか。
	もう何がなんだか、わからない状況
	だったような気がする。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TIE"
	mov $debugstr,"立ち：TIE "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XB0404"
	mov $debugstr,"音声：XB0404"
	gosub *vo

	【百合恵先生】
	あとで警察のひとが事情聴取に来るから。\
	dwavestop CH_VOICE	;XB0404

	【$g_hero】
	事情聴取？じ、事件だったんですか？\
	;--立ちキャラ;----------------------------------
	mov $_char,"TIC"
	mov $debugstr,"立ち：TIC "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XB0405"
	mov $debugstr,"音声：XB0405"
	gosub *vo

	【百合恵先生】
	いえ。型どおりのものだって。
	たぶん自殺でまちがいないけれど…。\
	dwavestop CH_VOICE	;XB0405

	【$g_hero】
	やっぱり…夢じゃなかったんだ。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TIC"
	mov $debugstr,"立ち：TIC "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XB0406"
	mov $debugstr,"音声：XB0406"
	gosub *vo

	【百合恵先生】
	…そうね。\
	dwavestop CH_VOICE	;XB0406

	【$g_hero】
	……………………………。\

	なんだか、まだ信じられなかった。
	この目で見たはずなのに。
	僕の目の前で、誰かが死んだのだ。\

	【$g_hero】
	夢だったらよかったのに。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TIE"
	mov $debugstr,"立ち：TIE "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XB0407"
	mov $debugstr,"音声：XB0407"
	gosub *vo

	【百合恵先生】
	校長や教頭でしょうね。
	夢であってほしいと思っているのは。\
	dwavestop CH_VOICE	;XB0407

	ああ…そっか。
	学園で自殺なんてあったら、
	そりゃ叩かれるのは先生たちだよな…。\

	…結構大変だよなと、僕はぼんやり思った。\

	学園で…ってだけで、責任を取らされるのかな。
	これが別のビルでだったら、違うんだろうな。\

	…死んじゃうのは同じなのにな。\

	それなのに、迷惑だとか大変だとか
	そんなもののほうが先に来ちゃうんだ。\

	死んじゃったのに。そのひと。\

	僕は、突然、その名前も知らない居なくなった
	人のことが無性に悲しくなった。涙がでそうだ。\

	先生の前で泣けるわけがないから
	パチパチと瞬いて、ごまかしながら僕は聞いた。\

	【$g_hero】
	あの…警察の人は、いつ？\
	;--立ちキャラ;----------------------------------
	mov $_char,"TIA"
	mov $debugstr,"立ち：TIA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XC0601"
	mov $debugstr,"音声：XC0601"
	gosub *vo

	【百合恵先生】
	もう少しで来るんじゃないかしら。\
	dwavestop CH_VOICE	;XC0601

	【$g_hero】
	そうですか…。\

	return	;----------------------------------
;---C06  END -----
