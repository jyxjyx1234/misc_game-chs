	mov $debugstr,"音声：BB1507"
	gosub *vo

	【真実】
	うん、そう。\
	dwavestop CH_VOICE	;BB1507

	真実は、僕がわかったことに
	うれしそうに頷いた。\

	【$g_hero】
	でも…。真実さ、なんで…？\
	;--立ちキャラ;----------------------------------
	mov $_char,"TBD"
	mov $debugstr,"立ち：TBD "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
