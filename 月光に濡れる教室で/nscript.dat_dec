	mov $_char,"TDC"
	mov $debugstr,"立ち：TDC "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"DD0907"
	mov $debugstr,"音声：DD0907"
	gosub *vo

	【小夜子】
	先輩…。\
	dwavestop CH_VOICE	;DD0907

	【$g_hero】
	僕が…犯人って…どうしてなんだろう。\

	return	;----------------------------------
