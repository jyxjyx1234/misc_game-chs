	きっと……すごく良いことだわ。\
	dwavestop CH_VOICE	;CC6404

	【$g_hero】
	そうかな？\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCA"
	mov $debugstr,"立ち：TCA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
