;-------------------------------------------------------------------------
;$tmpにファイル名入ってる
;%work（%0)に 真偽を入れて返す。
*CGBCHK
	mov %0,0
;眼鏡あり
	mov $tmp2, "cg/"
	add $tmp2, $tmp
	add $tmp2, ".bmp"
	if fchk $tmp2 mov %0,1 : return
;コンタクト
	mov $tmp2, "cg/"
	add $tmp2, $tmp
	add $tmp2, "_.bmp"
	if fchk $tmp2 mov %0,1 : return
	return
 
;-------------------------------------------------------------------
;GO_10.TXT
;ゲームコントロール
;-------------------------------------------------------------------
*start	;■ゲームの開始
	saveoff
	mov	%g_qr_ok,OFF		;QuickReturnを不可能に
	mov	%moving_title,OFF
	gosub	*debug_ini		;iniファイルから読み込み
	goto	*title			;タイトルへ
;-------------------------------------------------------------------
*start_game	;■ゲームのメインコントロールルーチン
	gosub	*local_initial
	gosub	*get_hero_name
	mov	%is_adv,1	;ADVスタート
	mov	%g_qr_ok,ON	;QuickReturnを可能に
	goto	*moonlit_start
;-------------------------------------------------------------------
*moonlit_start
	resettimer 
	gosub	*blackout
	waittimer 200
	gosub *speed_val	;メッセージスピード再設定
	gosub *set_message_window
	gosub *show_window
	saveon
;-------------------------------------------------------------------
;ゲーム全体の構成
;	ＯＰ実行
;	攻略キャラ決定 - g_root MAKOTO/AKEMI/SAYOKO/NATSUMI
;	選んだキャラごとに進む
;-------------------------------------------------------------------
*opening	;■オープニング
	gosub *true_check
	if %g_trueroot==ON gosub *E01	;●主人公から	;●天使から
	gosub *OP01
	gosub *OP02

	gosub *OPMAP01	;ヒロインで移動ッス

	gosub *OP19
	gosub *OP20	
;--------------------------------------------------------------------
;●攻略キャラ決定 %g_root
*root_select
	gosub *hintsave	;ヒント用セーブ
	gosub *true_check
	if %g_trueroot==ON goto	*trueroot_select ;何もする必要なんてない
	if %g_hint==OFF goto *hintOP201off

;全ルート見てない
 	csel
	"■桜井　真実", *OP2010a,
	"■皆月　明海 ", *OP2020a,
	"■芹沢　小夜子", *OP2030a,
	"★ヒント", *OP2050
*hintOP201off	;ヒントがOFFのとき
	csel
	"■桜井　真実", *OP2010a,
	"■皆月　明海 ", *OP2020a,
	"■芹沢　小夜子", *OP2030a
;----------------------------------
*trueroot_select
	if %g_hint==OFF goto *trueroot_select_hintoff
	csel
	"■桜井　真実", *OP2010a,
	"■皆月　明海 ", *OP2020a,
	"■芹沢　小夜子", *OP2030a,
	"■藍田　菜摘", *OP2040a,
	"★ヒント", *OP2050
*trueroot_select_hintoff	;ヒントがOFFのとき
	csel
	"■桜井　真実", *OP2010a,
	"■皆月　明海 ", *OP2020a,
	"■芹沢　小夜子", *OP2030a,
	"■藍田　菜摘", *OP2040a
;----------------------------------
*OP2010a
	mov %g_root,MAKOTO
	gosub *OP20B
	goto *root_select_end
*OP2020a
	mov %g_root,AKEMI
	gosub *OP20C
	goto *root_select_end
*OP2030a
	mov %g_root,SAYOKO
	gosub *OP20D
	goto *root_select_end
*OP2040a
	mov %g_root,NATSUMI
	gosub *OP20E
	goto *root_select_end
*OP2050
;◆★ヒント
Ｈをしてみたいキャラを選んでください。
よく考えて選びましょう\

if %g_trueroot==ON 新しいキャラが選択出来るようになっています。\
	goto *root_select
;--------------------------------------------------------------------
*root_select_end
	gosub *OP20F
	;トイレから戻ってきてすぐに菜摘先生ルートへ
	if %g_root == NATSUMI goto *natumi
	gosub *OP21
	gosub *OP22
	gosub *OP23
	gosub *OP24
	gosub *OP25
	gosub *OPMAP02	;マップ移動
	gosub *OP49	;イズミとスダ
	gosub *OP50
	gosub *OP51

;バッドエンドに行くときは、ここで初日死亡
	if %makoto_bad==ON	goto *BAD_1ST
	if %akemi_bad==ON	goto *BAD_1ST
	if %sayoko_bad==ON	goto *BAD_1ST
	if %natsumi_bad==ON	goto *BAD_ASA_NATSUMI

	gosub *OP52

	if %g_root == MAKOTO  goto *makoto
	if %g_root == AKEMI   goto *akemi
	if %g_root == SAYOKO  goto *sayoko

;--------------------------------------------------------------------
*makoto	;■真実
	if %g_gomegane==ON mov %g_nomegane,ON	;眼鏡ここで外れる
	gosub *B00	;ＯＰのえっち
	gosub *B00B	;ＯＰのえっち後の余韻（笑）
	gosub *OPMOVIE	;オープニングムービー

;□真実１日目
*makoto1
	gosub	*ASA01	;１日目の兄
	gosub	*B01	;●朝
	gosub	*B02	;●真実に会う#■ごめんと謝る#■お前のせいだと言う#■何も言えない
	gosub	*B03	;●自殺
	gosub	*B04	;●保健室。
	gosub	*B05	;●警察の事情聴取後
	gosub	*B06	;●真実と
	gosub	*B07	;●犯人？
	gosub	*B08	;●矢崎が入ってくる
	gosub	*B09	;●で、どうする？
	gosub	*B10	;●廊下で真実と
	gosub	*B11	;●教室で育巳と
	gosub	*B12	;●田口参上
	gosub	*B13	;●真実とふたりで#■自分の容疑を晴らす#■とりあえず家に帰る
	;B02で「お前のせいだ」を選択していると自動的に「家に帰る」になる。
	if %makoto_bad==ON gosub *BAD_B13 : goto *ENDROLL
*makoto_map1
	gosub	*B14	;●マップ移動前置き
	gosub	*BMAP01	;●マップ移動：１日目
	gosub	*B15	;●通知
	gosub	*B16	;●調教選択
	gosub	*B17	;●帰宅：菜摘先生
	gosub	*B18	;●夜：調教前
	gosub	*B19	;●廃教室
*makoto_h1
	gosub	*BH_1ST	;●Ｈシーン
	gosub	*CTS_B
	gosub	*B21	;●帰宅：真実
	gosub	*B22	;●家で兄と
	gosub	*B23	;●育巳と電話で会話
	gosub	*B24	;●真実：帰宅後
	gosub	*B25	;●遺書（郁美の）
	gosub	*B26	;●謎の人物


;□真実２日目
*makoto2
	if %makoto_bad==ON goto *BAD_ASA 
