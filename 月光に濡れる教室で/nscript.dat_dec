	mov $debugstr,"音声：YE4806"
	gosub *vo

	【$g_heroの兄】
	うん。好きだから、裏返しなんだってさ。
	子供っぽくって、かわいいよね。そういうの。\
	dwavestop CH_VOICE	;YE4806

	【$g_hero】
	ふうん…。なんだ、これ？
	兄さんじゃないよな…？\
	;--立ちキャラ;----------------------------------
	mov $_char,"TLB"
	mov $debugstr,"立ち：TLB "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
