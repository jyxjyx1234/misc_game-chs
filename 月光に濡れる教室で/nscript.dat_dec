*C33	; ■ファイル開始のラベル
	mov $debugstr,"■C33 " : gosub *debugout
;■■■「月光に濡れる教室で、僕は。」台本：●≪サ選≫朝：登校／まゆ子と：B33
;━━━━━━━━━━━━━━
;●≪サ選≫朝：登校／まゆ子と
;2003/01/10
	gosub *blackout

	;--BGM;----------------------------------
	mov $_music,"02": gosub *out
	;--背景;----------------------------------
	mov $_bg,"BG002A"
	mov $debugstr,"ＢＧ：BG002A"
	gosub *out	;画面に出力
;ＢＧ：BG002A;主人公の家

	昨日と同じ時間。昨日と同じ場所。
	僕はあたりをきょろきょろ見回した。\

	【$g_hero】
	今日は…先輩いないみたいだな…。\

	そりゃそうだ。
	先輩が、毎日むかえに来る理由はないもんな。\

	でもちょっとだけ寂しいかな…。
	…なんて考えるなよ、僕。\

	僕はふうっとため息をついて、肩を落とした。\

	【$g_hero】
	別に待ち合わせをしたわけでもないもんな。\

	それなのに、さびしいと感じる方が
	おかしいよな。…いや…なんでだろ。\

	期待をしていたから？　どうして？
	どうして、僕は先輩に会いたいんだろう。\

	それはきっと…あんなことしたから
	だから気になってるわけであって…。\

	それと…きっと…。\

	【$g_hero】
	（昨日のことが、
	　夢じゃないかって思ってるんだ、僕は）\

	セックスをしたことだろうか、
	それとも月光の下で話をしたことだろうか。\

	どっちのことだろう。
	時間が経てば経つほど、あやふやになっていく。\

	【$g_hero】
	（夢だったら…イヤなのかな）\

	そうなのかもしれない。うん…たぶん
	それをはっきりさせたいんだなと思う。\

	先輩の顔をみたら、落ち着くのに。
	でも先輩は、いない。\

	【$g_hero】
	……行こう。\
	gosub *blackout
	;--背景;----------------------------------
	mov $_bg,"BG032A"
	mov $debugstr,"ＢＧ：BG032A"
	gosub *out	;画面に出力
	;-効果音;----------------------------------
	mov $_se,"ZTORI2"
	mov $debugstr,"ＳＥ：ZTORI2"
	gosub *se
;ＢＧ：BG032A;公園

	【$g_hero】
	いい天気だなぁ……。\

	近道だからって公園なんて通ってしまった
	せいだろうか。\

	心が妙にソワソワする。\

	こんな日にガッコに閉じこめられて
	勉強するなんてもったいなさすぎるよ。\

	さぼりたいと思ったことはあまり無いし、
