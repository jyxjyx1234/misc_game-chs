	;--背景;----------------------------------
	mov $_bg,"BG014A"
	mov $debugstr,"ＢＧ：BG014A"
	gosub *out	;画面に出力
	;-効果音;----------------------------------
	mov $_se,"ZKAZE"
	mov $debugstr,"ＳＥ：ZKAZE "
	gosub *se
;;校門
	;--立ちキャラ;----------------------------------
	mov $_char,"TCD"
	mov $debugstr,"立ち：TCD "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC11309"
	mov $debugstr,"音声：CC11309 "
	gosub *vo

	【明海】
	見て…桜の木が…。\
	dwavestop CH_VOICE	;CC11309 

	僕は、明海が指さしている樹木を見あげた。
	梢はまだ冬の色をして、固く冷え切っていた。\

	けれど、枝のあちこちに
	ちいさな蕾と、ほころんだ桜の花びらを
	見つけられた。\

	【$g_hero】
	…桜が、咲きはじめてたんだ。\

	咲きはじめた桜。
	春一番が吹いて、枝をしならせる。\

	せっかく咲きはじめた桜は、
	一枚一枚その花弁を散らしている。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCA"
	mov $debugstr,"立ち：TCA "
	gosub	*out	;画面に出力
;【明海】［普］

	飛んでいく桜を見つめながら、
	先輩は、ふとてのひらを空にさしのべた。\

	先輩のてのひらに白くてちいさな欠片が
	乗っていた。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCJ"
	mov $debugstr,"立ち：TCJ "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC11310"
	mov $debugstr,"音声：CC11310 "
	gosub *vo

	【明海】
	桜じゃないわ…風花（かざはな）なのね…。\
	dwavestop CH_VOICE	;CC11310 

	【$g_hero】
	風花？\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCA"
	mov $debugstr,"立ち：TCA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC11311"
	mov $debugstr,"音声：CC11311 "
	gosub *vo

	【明海】
	ほら…風が強いでしょう？\
	dwavestop CH_VOICE	;CC11311 
	;--立ちキャラ;----------------------------------
	mov $_char,"TCB"
	mov $debugstr,"立ち：TCB "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC11312"
	mov $debugstr,"音声：CC11312 "
	gosub *vo

	【明海】
	だから…雪のある山の方から雪の欠片が
	飛んでくるの。\
	dwavestop CH_VOICE	;CC11312 
	;--立ちキャラ;----------------------------------
	mov $_char,"TCA"
	mov $debugstr,"立ち：TCA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC11313"
	mov $debugstr,"音声：CC11313 "
	gosub *vo

	【明海】
	きれいね…。\
	dwavestop CH_VOICE	;CC11313 

	【$g_hero】
	うん…きれいだ。\

	先輩が、遠くを見つめる。
	僕も空を見る。\

	風の強い青い空に白い欠片がちらちらと
	待っている。\

	あれは、雪なんだ。
	ここでないどこかから飛んできた雪の欠片なんだ。\

	;--BGM;----------------------------------
	mov $_music,"10": gosub *out
	;--立ちキャラ;----------------------------------
	mov $_char,"TCJ"
	mov $debugstr,"立ち：TCJ "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC11314"
	mov $debugstr,"音声：CC11314 "
	gosub *vo

	【明海】
