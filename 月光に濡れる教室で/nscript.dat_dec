;BGM:芹沢　小夜子
	;--背景;----------------------------------
	mov $_bg,"BG014G"
	mov $debugstr,"ＢＧ：BG014G"
	gosub *out	;画面に出力
;ＢＧ：BG014A;校門

	【$g_hero】
	さて帰るか。まず駅までだな。\

	僕は徒歩通学なので、
	普段は駅まで行かないんだ。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TDI"
	mov $debugstr,"立ち：TDI "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"DD1600"
	mov $debugstr,"音声：DD1600"
	gosub *vo

	【小夜子】
	はい。\
	dwavestop CH_VOICE	;DD1600

	てくてくと、いつもは通わない駅までの道を
	歩いていくと妙に新鮮な気分だった。\

	【$g_hero】
	にしても…大貫君って
	小夜子から見ると、どんなタイプだった？\
	;--立ちキャラ;----------------------------------
	mov $_char,"TDA"
	mov $debugstr,"立ち：TDA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"DD1601"
	mov $debugstr,"音声：DD1601"
	gosub *vo

	【小夜子】
	あんまり仲が良いわけでもなかったんですけど
	がっちりして、いかにも体育会系なかんじで。\
	dwavestop CH_VOICE	;DD1601

	【$g_hero】
	うん。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TDI"
	mov $debugstr,"立ち：TDI "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"DD1602"
	mov $debugstr,"音声：DD1602"
	gosub *vo

	【小夜子】
	女子にすごい人気のあるタイプってカンジじゃ
	ないけど、男の友だちとかは多そうでしたよ。\
	dwavestop CH_VOICE	;DD1602

	【$g_hero】
	そだろうなぁ…。やっぱ、守男先生に似てる？\
	;--立ちキャラ;----------------------------------
	mov $_char,"TDB"
	mov $debugstr,"立ち：TDB "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"DD1603"
	mov $debugstr,"音声：DD1603"
	gosub *vo

	【小夜子】
	そうですね…。雰囲気が似てました。\
	dwavestop CH_VOICE	;DD1603

	【$g_hero】
	やっぱり自殺ってカンジじゃないよなぁ…。\

	だから警察のひとも疑っているんだろう。\

	【$g_hero】
	だけど、ひとに恨まれるタイプでもないんだろ？\

	たとえば、守男先生は、そりゃ汗くさいだの
	すぐに筋肉だのいやがるヤツもいるけど、\

	あの先生を殺したいほど嫌うってひとは
	いないと思うのだ。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TDE"
	mov $debugstr,"立ち：TDE "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"DD1604"
	mov $debugstr,"音声：DD1604"
	gosub *vo

	【小夜子】
	ええ。それはないと思います。\
	dwavestop CH_VOICE	;DD1604

	【$g_hero】
	だよな。\

	じゃあ、どうしてなんだろ。
	事故なのか他殺なのかわかんないけどさ。\

	【$g_hero】
	せっかく彼女が出来たって言うのにな。
	死にたくなかっただろうなぁ…。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TDC"
	mov $debugstr,"立ち：TDC "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"DD1605"
	mov $debugstr,"音声：DD1605"
	gosub *vo

	【小夜子】
	そうですね…。\
	dwavestop CH_VOICE	;DD1605
	gosub *blackout
	;--背景;----------------------------------
	mov $_bg,"BG035B"
	mov $debugstr,"ＢＧ：BG035B"
	gosub *out	;画面に出力
;;繁華街

	【$g_hero】
	あ、もうそろそろ駅だ。切符買わないと。
	小夜子の家って、３つ先だっけ？\
	;--立ちキャラ;----------------------------------
	mov $_char,"TDD"
	mov $debugstr,"立ち：TDD "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"DD1606"
	mov $debugstr,"音声：DD1606"
	gosub *vo

	【小夜子】
	いえ、大丈夫です。ご迷惑ですし。\
	dwavestop CH_VOICE	;DD1606

	【$g_hero】
	ここまで来ちゃったんだし、面倒じゃないよ。
	気にするなって。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TDF"
	mov $debugstr,"立ち：TDF "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"DD1607"
	mov $debugstr,"音声：DD1607"
	gosub *vo

	【小夜子】
	大丈夫ですよ。私に何かがあったわけじゃない
	ですし。ご迷惑かける方が心苦しいです。\
	dwavestop CH_VOICE	;DD1607

	なんだか、僕に家まで来て欲しくないみたい
	だな…。別に家に上げろなんて言わないんだけど。\

	まあ…でも、あんまりプライバシーに
	突っ込むのはよくないのかも。\

	【$g_hero】
	ホントに平気か？\
	;--立ちキャラ;----------------------------------
	mov $_char,"TDA"
	mov $debugstr,"立ち：TDA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"DD1608"
	mov $debugstr,"音声：DD1608"
	gosub *vo

	【小夜子】
	大丈夫です。\
	dwavestop CH_VOICE	;DD1608

	【$g_hero】
	じゃあ…なんかあったら、電話してくれよ。
	すぐに行くから。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TDB"
	mov $debugstr,"立ち：TDB "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"DD1609"
	mov $debugstr,"音声：DD1609"
	gosub *vo

	【小夜子】
	はい！\
	dwavestop CH_VOICE	;DD1609
	gosub *clear_char

	そう言って小夜子と別れた僕は
	自分の家へむかった。\
	gosub *blackout

	return	;----------------------------------
;---D16  END -----
