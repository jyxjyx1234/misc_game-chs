	;--BGM;----------------------------------
	mov $_music,"01": gosub *out
;BGM:さりげない日常
	;--背景;----------------------------------
	mov $_bg,"BG014A"
	mov $debugstr,"ＢＧ：BG014A"
	gosub *out	;画面に出力
;ＢＧ：BG014A;校門

	【$g_hero】
	うー…まだ朝は少し寒いな…。\

	僕はマフラーを置いてきたことを後悔した。
	校門の前ですこし足踏みする。\

	【$g_hero】
	ガッコについたけど、今日は
	どうするかな。\

	時計を見る。
	ＨＲまでまだまだ時間は充分にある。\

	今頃の時間にガッコに来る人間なんて、
	朝練の連中くらいだけど。
	朝練に励むようなクラブは少ない。\

	僕の通っている学園は、南沢学園と言う。
	勉強一本槍の進学校だ。\

	文武両道の名門でないところがミソで、
	要するに勉強三昧の日々を送ってる。\

	もううんざりするほど、勉強のことだけ。
	それ以外の行事は組まれることなんてない。\

	うちのガッコは文化祭だってない。
	体育祭もない。修学旅行もなくて、
	全部、合宿して勉強だけ。\

	そりゃそんなイベントがあっても、僕みたいに
	平凡な人間に、誰かが告白してくれるとか、忘れ
	られないファーストキスがあるなんて思ってない。\

	チューガクにいたときも、卒業式に男同士で
	飲み会したのが最後の思い出だしさ。\

	一番仲良しだったやつが急性アル中になりかけて
	みんなであわててゲロを吐かせたってのが
	そのときの最大の思い出なんだけど。\

	チャンポンで酒飲むのはよくないよな。
	まあいいよ。ともかく、
	今ならそういうのだって笑って話せるし。\

	だけど、いいにしろ、悪いにしろ、
	存在しなければ思い出さえ作れない。\

	うちのガッコときたら、みんなすぐに
	校風にそまって、勉強勉強で目の色変えてる。\

	勉強も遊びもそこそこにっていう、
	しごく一般的な僕のようなタイプが、珍しい
	やつだ。のんきものと言われるのは問題ないか？\

	;--BGM;----------------------------------
	mov $_music,"02": gosub *out
;BGM:喜
	;--立ちキャラ;----------------------------------
	mov $_char,"TJB"
	mov $debugstr,"立ち：TJB "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"YOP0200"
	mov $debugstr,"音声：YOP0200 "
	gosub *vo

	【育巳】
	よ、おはよ。\
	dwavestop CH_VOICE	;YOP0200 

	【$g_hero】
	ああ、おはよう。今日は早いんだな。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TJA"
	mov $debugstr,"立ち：TJA "
	gosub	*out	;画面に出力

	コイツは、育巳。
	福崎　育巳（ふくざき　いくみ）。\

	育巳とは、１年のときから同じクラスで、
	部活も同じコーラス部。\

	席も僕の隣だ。これは偶然なんだけど。
	視力が悪いって子がいて、育巳と替わったのだ。\

	家にも遊びに行ったり来たりするような仲だ。\
;＞それが真実
