*OPMAP02	; ■マップ呼び出し
;マップは全部見るまでOFF
if %op02_looked==0 mov	%map_exit,0 : jumpf
if %g_root==NATSUMI mov %map_exit,1
~
	mov	%map01,02	;02:野島　まゆ子-01:１年教室
	mov	%map02,0
if %g_root==MAKOTO mov %map02,18	;18:桜井　真実-02:２年教室
	mov	%map03,10	;10:根津教頭-03:３年教室
	mov	%map04,05	;05:東野　百合恵-04:保健室
	mov	%map05,0
	mov	%map06,0
if %g_root==SAYOKO  mov %map06,20	;20:芹沢　小夜子-06:コーラス部室（音楽室）
	mov	%map07,0
if %g_root==AKEMI  mov	%map07,19	;19:皆月　明海-07:学生会室
	mov	%map08,11	;11:守男先生-08:体育館
	mov	%map09,17	;17:治見先生-09:職員室
	mov	%map10,03	;03:羽根田　玖美子-10:屋上
