	【真実】
	……………。\

	この真実に、昨日僕は触れたんだ。
	何も付けていない体に触って、つながったんだ。\

	僕の顔が、朱に染まる。体が熱い。
	心臓がどくどく鳴る。
	真実に、なんて言えばいいんだろう？\
;----------------------------------
*hint08
	gosub *hintsave	;ヒント用セーブ
	if %g_hint==OFF goto *hintB021off
	csel
	"■ごめんと謝る", *B0210,
	"■お前のせいだと言う", *B0220,
	"■何も言えない", *B0230,
	"■★ヒント", *B0240
*hintB021off	;ヒントがOFFのとき
	csel
	"■ごめんと謝る", *B0210,
	"■お前のせいだと言う", *B0220,
	"■何も言えない", *B0230
;----------------------------------
*B0210
;◆ごめんと謝る

	【$g_hero】
	あの…。\

	（ごめん、真実…）\

	そう言おうとして、言葉が出てこなかった。
	口が、動かない。\

	だって、ひどく自分が情けないからだ。
	謝ったところで、したことが消えるわけじゃない。\

	ただ、自分を慰めたいだけだろう。
	謝って気が済むようにしたいだけだろう。\

	情けないな、僕は。
	でも、それじゃ、なんて言えばいいんだ？
	ごめん、なんていう謝罪の言葉の代わりに。\
	goto *nextB02	;nextB02へ移動
;----------------------------------
*B0220
;◆お前のせいだと言う
;★真実攻略不可

	mov %makoto_bad,ON
	【$g_hero】
	昨日のこと…真実のせいだからな。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TBC"
	mov $debugstr,"立ち：TBC "
	gosub	*out	;画面に出力

	【真実】
	……………………………。\

	真実は何も言わずに、僕を見つめた。
	卑怯とも、ひどいとも、何も言わなかった。\

	【$g_hero】
	…な、なんで何も言わないんだよ。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TBC"
	mov $debugstr,"立ち：TBC "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"BB0201"
	mov $debugstr,"音声：BB0201"
	gosub *vo

	【真実】
	…だって…。\
	dwavestop CH_VOICE	;BB0201

	【$g_hero】
	だって、これじゃ僕が最低じゃないか。
	馬鹿みたいじゃないか！\

	自分でも何を言ってるんだろうと思った。
	本当に情けない。どうしようもない、僕がいる。\
	goto *nextB02	;nextB02へ移動
;----------------------------------
*B0230
;◆何も言えない

	ごめん。悪かった。
	お前のせいだ。僕は悪くない。
	気にするな。\

	どれもこれも、選びたくない言葉だった。\
	goto *nextB02	;nextB02へ移動
;----------------------------------
*B0240
;◆★ヒント

	「ごめんと謝る」
	「何も言えない」\

	問題なく真実ルートに進みます。
	お好きな選択肢をお選びください。\

	「お前のせいだと言う」
	バッドエンドに直行します。
	選ばないほうが良いでしょう。\
	goto *hint08	;hint08へ移動
;----------------------------------
*nextB02

	【$g_hero】
	真実。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TBF"
	mov $debugstr,"立ち：TBF "
	gosub	*out	;画面に出力

	【真実】
	……………。\

	僕と真実は何も言わずに、
	ただお互いを見つめていた。\

	こんなに真剣に、誰かを見たことはなかった。\

	真実の黒い瞳に、僕が映っている。
	長い睫がふるふると震えている。\

	きっと外から見たら、
	恋に落ちた二人みたいに見えるのかも知れない。\

	ふと、そんな考えが自分に落ちてきて
	笑いたいような泣きたいような気持ちになる。\

	どうしよう。どうすればいいんだろう。
	わからない。わからないけれど。\

	何か、言わなくちゃ。
	何か。\

	【$g_hero】
	ま…真実…。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TBF"
	mov $debugstr,"立ち：TBF "
	gosub	*out	;画面に出力

	【真実】
	…………。\

	【$g_hero】
	…話…いいか？\
	;--立ちキャラ;----------------------------------
	mov $_char,"TBG"
	mov $debugstr,"立ち：TBG "
	gosub	*out	;画面に出力

	【真実】
	……………。\

	真実は何も言わずに、ただ肯いた。\

	どこに行こうか？
	教室に行くのはイヤだった。\

	この時間なら…どこも、あまりひとは
	居ないだろうけど…。\

	そっか。逆に、ひとが来たら
	すぐにわかるところに行けばいいのか。\

	【$g_hero】
	ついてきてよ。\

	真実は、ちいさなか細い声で肯いた。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TBF"
	mov $debugstr,"立ち：TBF "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"BB0202"
	mov $debugstr,"音声：BB0202"
	gosub *vo

	【真実】
	うん。\
	dwavestop CH_VOICE	;BB0202

	その声があんまり細くて綺麗なので
	そんな声をさせる僕は、どうしようもないなと
	気分が暗く沈んだ。\

	僕たちは、校舎の裏庭の方へ向かった。\
	gosub *blackout

	return	;----------------------------------
;---B02  END -----
