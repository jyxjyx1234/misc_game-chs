	【育巳】
	来てたけど、どっか行っちゃったよ、
	先生。\
	dwavestop CH_VOICE	;YB3201
	;--立ちキャラ;----------------------------------
	mov $_char,"TED"
	mov $debugstr,"立ち：TED "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XB3202"
	mov $debugstr,"音声：XB3202"
	gosub *vo

	【菜摘先生】
	まあ…困ったわね。もどってきたら、あとで
	職員室に来るように、言っておいてください。\
	dwavestop CH_VOICE	;XB3202
	gosub *clear_char

