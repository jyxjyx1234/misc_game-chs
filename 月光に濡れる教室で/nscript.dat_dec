	mov $debugstr,"立ち：TII "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XB0400"
	mov $debugstr,"音声：XB0400"
	gosub *vo

	【百合恵先生】
	あら、気が付いたのね。\
	dwavestop CH_VOICE	;XB0400

	【$g_hero】
	百合恵センセ…。なんで…？\
	;--立ちキャラ;----------------------------------
	mov $_char,"TIB"
	mov $debugstr,"立ち：TIB "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XB0401"
	mov $debugstr,"音声：XB0401"
	gosub *vo

	【百合恵先生】
	もうお昼過ぎたわよ。お腹空いたでしょう。
	サンドイッチならあるけど。\
	dwavestop CH_VOICE	;XB0401

	【$g_hero】
	あ…。うん…。\

	その途端、僕は思い出した。
	落ちてきた人影と、それから血と。\

	【$g_hero】
	…いや、やっぱいいです。\

	胸に何かがこみ上げてきた。
	とうてい食べられそうもない。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TIC"
	mov $debugstr,"立ち：TIC "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XB0402"
	mov $debugstr,"音声：XB0402"
	gosub *vo

	【百合恵先生】
	食欲ない？じゃあ飲み物だけでも。
	ココアでいい？\
	dwavestop CH_VOICE	;XB0402

	【$g_hero】
	…はい。\

	あたたかい湯気のたつマグカップを渡される。
	チョコレートのいい匂いがした。\

	【$g_hero】
	あちっ。\

	熱いそれを、ちびちび啜りながら、
	僕は百合恵先生に話を聞いてみた。\

	【$g_hero】
	あの…僕と…真実は…。\

	なんで眠ってたんだろう。もしかして、僕は
	気絶してたのかな。…ちょっと恥ずかしい。\
