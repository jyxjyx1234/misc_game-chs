	mov $debugstr,"音声：DOP4509 "
	gosub *vo

	【小夜子】
	じゃあ、メトロノームに合わせて。
	先輩の準備が出来たら言ってくださいね。\
	dwavestop CH_VOICE	;DOP4509 

	【$g_hero】
	うん。\

	僕は腹に手を当てて大きく息を吸い込んだ。\

	……………………。
	……………………。\
