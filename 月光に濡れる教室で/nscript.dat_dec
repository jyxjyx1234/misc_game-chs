	dwavestop CH_VOICE	;CC8002

	【$g_hero】
	え？呆れる？\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCG"
	mov $debugstr,"立ち：TCG "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC8003"
	mov $debugstr,"音声：CC8003"
	gosub *vo

	【明海】
	私…いやらしいわ…。
	恥ずかしい……。\
	dwavestop CH_VOICE	;CC8003

	うつむいた先輩のうなじと耳が赤かった。\

	【$g_hero】
	そんなことないよ。\

	僕は先輩を引き寄せた。
	先輩の体が僕の腕の中で小鳥みたいに震えていた。\
	;--立ちキャラ;----------------------------------
