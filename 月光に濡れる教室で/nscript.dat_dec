*C32	; ■ファイル開始のラベル
	mov $debugstr,"■C32 " : gosub *debugout
;■■■「月光に濡れる教室で、僕は。」台本：●朝：自分の部屋：B32
;━━━━━━━━━━━━━━
;●朝：自分の部屋
;2003/01/10

	;--BGM;----------------------------------
	mov $_music,"07": gosub *out
	;--背景;----------------------------------
	mov $_bg,"BG001A"
	mov $debugstr,"ＢＧ：BG001A"
	gosub *out	;画面に出力
;ＢＧ：BG001A;主人公の部屋
	;-効果音;----------------------------------
	mov $_se,"ZSUZUME"
	mov $debugstr,"ＳＥ：ZSUZUME "
	gosub *se

	【$g_hero】
	朝…か……。
	どんなことがあっても、朝は来るんだな…。\

	僕は、じっと自分の腕をみた。
	昨日…この腕に先輩を抱きしめたんだ。\

	【$g_hero】
	……先輩の罪…か…。\

	たとえそれがどんなものであっても…
	僕は先輩の味方でいよう。\

	味方で…いたいんだ。
	だって先輩は苦しんでいる。\

	【$g_hero】
	先輩を…支えたいのかな。
	どうだろう…そんな事が僕にできるだろうか。\

	【$g_hero】
	そりゃ…その時になってみないと
	わからないけどさ…。\

	でも、できたら…僕は先輩の目を見て。
	“大丈夫。僕は、先輩の味方だから”\

	って…言いたいんだ。
	それが僕にできる精一杯のことだから。\

	【$g_hero】
	さて…と、着替えて出かけなくちゃな。\
;ASA02.CSVへ

	return	;----------------------------------
;---C32  END -----
