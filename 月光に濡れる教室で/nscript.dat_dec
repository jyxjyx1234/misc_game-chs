	mov $debugstr,"音声：YMP1231 "
	gosub *vo

	【購買のおじさん】
	ふう…もうじき春休みですねぇ。
	そこで一句。\
	dwavestop CH_VOICE	;YMP1231 

	【$g_hero】
	一句？\
	;--立ちキャラ;----------------------------------
	mov $_char,"TMI"
	mov $debugstr,"立ち：TMI "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
