	;-効果音;----------------------------------
	mov $_se,"ZKNOCK2"
	mov $debugstr,"ＳＥ：ZKNOCK2 "
	gosub *se
;ＳＥ：ZKNOCK;ノック。
;間や台詞が欲しいですかも…かも

	;--BGM;----------------------------------
	mov $_music,"05": gosub *out
;BGM:楽
	;--立ちキャラ;----------------------------------
	mov $_char,"TLA"
	mov $debugstr,"立ち：TLA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"YB0100"
	mov $debugstr,"音声：YB0100"
	gosub *vo

	【$g_heroの兄】
	お・は・よ・う。お目覚めのキスだよ。
	ん～～～。\
	dwavestop CH_VOICE	;YB0100

	【$g_hero】
	ぎゃーーーーっ！な、なんばしよっと！\
	;--立ちキャラ;----------------------------------
	mov $_char,"TLB"
	mov $debugstr,"立ち：TLB "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"YB0101"
	mov $debugstr,"音声：YB0101"
	gosub *vo

	【$g_heroの兄】
	あははは、目が覚めるだろ～？
	友だちに教えてもらったんだ。\
	dwavestop CH_VOICE	;YB0101

	【$g_hero】
	…変な友人と付き合わないでくれよ…。\

	くそ…。もう、紹介しちまおうかな…。
	あのイズミとかいうの…。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TLA"
	mov $debugstr,"立ち：TLA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"YB0102"
	mov $debugstr,"音声：YB0102"
	gosub *vo

	【$g_heroの兄】
	朝ごはんたべなよ。昨日食べてないんだろ？\
	dwavestop CH_VOICE	;YB0102

	【$g_hero】
	そういや…お腹空いてるな…。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TLB"
	mov $debugstr,"立ち：TLB "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"YB0103"
	mov $debugstr,"音声：YB0103"
	gosub *vo

	【$g_heroの兄】
	お兄ちゃん特製の愛情たっぷりの朝ごはんだよ。\
	dwavestop CH_VOICE	;YB0103

	【$g_hero】
	…たまごかけごはんか、納豆か、
	ふりかけか…。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TLB"
	mov $debugstr,"立ち：TLB "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"YB0104"
	mov $debugstr,"音声：YB0104"
	gosub *vo

	【$g_heroの兄】
	残念！今日はお茶漬けでしたー♪\
	dwavestop CH_VOICE	;YB0104

	【$g_hero】
	……いいけどさ。
	どこに愛情があるんだよ、それの。\

	兄はうふふと笑って見せた。
	いくら美形でも、男のくせに気持ち悪い。\

	が、僕への嫌がらせが目的なので
	それは達しているから、そういうのを止めない。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TLA"
	mov $debugstr,"立ち：TLA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"YB0105"
	mov $debugstr,"音声：YB0105"
	gosub *vo

	【$g_heroの兄】
	風呂も入らないで寝ちゃって。
	ちゃんとガッコ行きなよ。\
	dwavestop CH_VOICE	;YB0105
	gosub *clear_char
;足音ナシ？

	僕がうーという、うんざりした声を出したのを
	聞いて兄は満足したらしく、足音がして、
	ドアの前から兄の気配が去っていった。\

	僕はため息をついて、ベッドから立ち上がった。\

	【$g_hero】
	風呂か…。
	えっと…昨日………昨日は…。\

	return	;----------------------------------
;---ASA01  END -----
