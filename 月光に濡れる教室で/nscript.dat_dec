	mov $_char,"TIA"
	mov $debugstr,"立ち：TIA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XB0403"
	mov $debugstr,"音声：XB0403"
	gosub *vo

	【百合恵先生】
	ふたりともものすごく興奮してたから、
	鎮静剤をね。\
	dwavestop CH_VOICE	;XB0403

	【$g_hero】
	そうだったんだ。\

	そういや、パニック状態っていうんだろうか。
	もう何がなんだか、わからない状況
	だったような気がする。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TIE"
	mov $debugstr,"立ち：TIE "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XB0404"
	mov $debugstr,"音声：XB0404"
	gosub *vo

	【百合恵先生】
	あとで警察のひとが事情聴取に来るから。\
	dwavestop CH_VOICE	;XB0404

	【$g_hero】
	事情聴取？じ、事件だったんですか？\
	;--立ちキャラ;----------------------------------
	mov $_char,"TIC"
	mov $debugstr,"立ち：TIC "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XB0405"
	mov $debugstr,"音声：XB0405"
	gosub *vo

	【百合恵先生】
	いえ。型どおりのものだって。
	たぶん自殺でまちがいないけれど…。\
	dwavestop CH_VOICE	;XB0405

	【$g_hero】
	やっぱり…夢じゃなかったんだ。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TIC"
	mov $debugstr,"立ち：TIC "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XB0406"
	mov $debugstr,"音声：XB0406"
	gosub *vo

	【百合恵先生】
	…そうね。\
	dwavestop CH_VOICE	;XB0406

	【$g_hero】
	……………………………。\

	なんだか、まだ信じられなかった。
	この目で見たはずなのに。
	僕の目の前で、誰かが死んだのだ。\

	【$g_hero】
	夢だったらよかったのに。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TIE"
	mov $debugstr,"立ち：TIE "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XB0407"
	mov $debugstr,"音声：XB0407"
	gosub *vo

	【百合恵先生】
	校長や教頭でしょうね。
	夢であってほしいと思っているのは。\
	dwavestop CH_VOICE	;XB0407

	ああ…そっか。
	学園で自殺なんてあったら、
	そりゃ叩かれるのは先生たちだよな…。\

	…結構大変だよなと、僕はぼんやり思った。\

	学園で…ってだけで、責任を取らされるのかな。
	これが別のビルでだったら、違うんだろうな。\

	…死んじゃうのは同じなのにな。\

	それなのに、迷惑だとか大変だとか
	そんなもののほうが先に来ちゃうんだ。\

	死んじゃったのに。そのひと。\

	僕は、突然、その名前も知らない居なくなった
	人のことが無性に悲しくなった。涙がでそうだ。\

	先生の前で泣けるわけがないから
	パチパチと瞬いて、ごまかしながら僕は聞いた。\

	【$g_hero】
	真実は…？大丈夫なんですか？\

	真実は、僕の隣のベッドで横たわったままだ。
	ものすごく青白い顔をしていた。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TIA"
	mov $debugstr,"立ち：TIA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XB0408"
	mov $debugstr,"音声：XB0408"
	gosub *vo

	【百合恵先生】
	もともと、貧血気味だから、彼女。
	まだ寝かせてあげなさいな。\
	dwavestop CH_VOICE	;XB0408

	【$g_hero】
	もともと？\
	;--立ちキャラ;----------------------------------
	mov $_char,"TIB"
	mov $debugstr,"立ち：TIB "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XB0409"
	mov $debugstr,"音声：XB0409"
	gosub *vo

	【百合恵先生】
	うちの常連よ。\
	dwavestop CH_VOICE	;XB0409

	【$g_hero】
	はい…。\

	return	;----------------------------------
