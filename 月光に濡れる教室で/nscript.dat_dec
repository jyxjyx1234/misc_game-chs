*E58	; ■ファイル開始のラベル
	mov $debugstr,"■E58 " : gosub *debugout
;■■■「月光に濡れる教室で、僕は。」台本：●授業中：E58
;━━━━━━━━━━━━━━
;●授業中
;これはてきとうに。主人公のモノローグで。
;;２年教室

	;--BGM;----------------------------------
	mov $_music,"02": gosub *out
	;--背景;----------------------------------
	mov $_bg,"BG009A"
	mov $debugstr,"ＢＧ：BG009A"
	gosub *out	;画面に出力

	【$g_hero】
	ふああ…もう自習なんてしないで帰らせてよ…。\

	あとは卒業式と終業式だけなのに…。
	どうして自習なんてしなくちゃいけないんだ。\

	理不尽だ。理不尽すぎる。
	ああ…早くかえりたい…。\

	いやそうじゃなくて。
	家に帰っても仕方がないんだ。\

	早く菜摘先生に会いたいんだ。\

	僕は、ノートを閉じてしまった。
	やっぱり何も書く気が起きない。\

	小説とか書く気分じゃないんだよな。\

	【$g_hero】
	（考えることも色々あるし…）\

	色々って言っても、菜摘先生のことだけど。\

	【$g_hero】
	（春が好きって言ってたっけ…）\

	夏も冬も好きじゃないのかな。
	…水着は見れないのかな。\

	それは残念だ。
	夏までになんとか説得しよう。\

	受験生にだって息抜きは必要だ。
	明日への活力になるんだから。\

	【$g_hero】
	………………………。\

	【$g_hero】
	（夏までつきあっているかもわからないのに…
	　いや、待て待て。弱気は禁物だ）\

	先生だってもう大人なんだし。
	遊びのつもりだったら、学生との恋なんて
	危険なだけだからしないはずだし。\

	【$g_hero】
	でも…。\

	夏になったら海に行こう。
	そう言ったら、悲しい顔してたな…。\

	何だろう。
	どうしてだろう。\

	【$g_hero】
	（やっぱり…津島のせいかな）\

	レクイエム弾いてたな。
	津島のため…なんだろうな。\

	【$g_hero】
	………………………。\

	死者に鞭打つような真似をしたくはないけど、
	でも腹が立つものは腹が立つ。\

	嫉妬だよ…どうせこどもだよ。\

	死んじゃった人間に嫉妬したって
	仕方ないのに。\

	【$g_hero】
	（……いいんだ。もう過去のことさ。
	　そうだ！　気持ちを切り替えよう）\

	楽しいこといっぱいすればいいよ。\

	そうだそうだ。育巳の彼女も一緒でさ。\

	来年は無理でも、大学に行ってからなら
	先生もいいって言うよ。\

	育巳おどろくだろうな～。
	ふふふふふ。\

	【$g_hero】
	………………………。\

	いいんだよ。
	そのくらい夢みたって。\
	gosub *musicstop
	;-効果音;----------------------------------
	mov $_se,"ZTYAIM"
	mov $debugstr,"ＳＥ：ZTYAIM"
	gosub *se

	キーンコーン…キーンコーン…。\

	;--BGM;----------------------------------
	mov $_music,"02": gosub *out

	【$g_hero】
	は！！！\

	【$g_hero】
	妄想してたら、
	自習時間が終わってしまった。\

	return	;----------------------------------
;---E58  END -----
