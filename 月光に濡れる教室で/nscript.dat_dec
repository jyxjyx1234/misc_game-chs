;BGM:芹沢　小夜子
	;--背景;----------------------------------
	mov $_bg,"BG016A"
	mov $debugstr,"ＢＧ：BG016A"
	gosub *out	;画面に出力
;ＢＧ：BG016A;コーラス部室（音楽室）

	部室に入っていくと、既に人はまばらだった。
	僕を見つけた小夜子が近寄ってくる。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TDI"
	mov $debugstr,"立ち：TDI "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"DOP4500"
	mov $debugstr,"音声：DOP4500 "
	gosub *vo

	【小夜子】
	先輩、これ新しいプリントです。
	預かってましたから。\
	dwavestop CH_VOICE	;DOP4500 

	【$g_hero】
	ありがとう。今日なんか新しいことあった？\

	コーラスの変更点のとこの説明だった。
	うわー。男子ばっかじゃないか、面倒なの。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TDD"
	mov $debugstr,"立ち：TDD "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"DOP4501"
	mov $debugstr,"音声：DOP4501 "
	gosub *vo

	【小夜子】
	いえ。特には。
	大変そうですね…男子パートの変更。\
	dwavestop CH_VOICE	;DOP4501 

	【$g_hero】
	そうだなぁ…今頃になっての変更はきついね。
	でも頑張らないと。\

	【$g_hero】
	全体練習は…もう終わったみたいだね。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TDC"
	mov $debugstr,"立ち：TDC "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"DOP4502"
	mov $debugstr,"音声：DOP4502 "
	gosub *vo

	【小夜子】
	はい。ついさっきでしたけど…。\
	dwavestop CH_VOICE	;DOP4502 

	申し訳なさそうな顔をして、小夜子が答える。
	小夜子がそんな顔する事じゃないのにな。\

	【$g_hero】
	そっか。
	ちょっと練習したい気分だったんだけどな…。\

	僕は唄うのは好きだ。頭がからっぽになって、
	自分から歌が響いているのを感じるのは
	すごく気持ちがいい。\

	まあ、僕のレベルじゃカラオケと変わらないの
	かもしれないけど。腹式呼吸で、体全体で
	唄うのは気持ちがいいしさ。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TDA"
	mov $debugstr,"立ち：TDA "
