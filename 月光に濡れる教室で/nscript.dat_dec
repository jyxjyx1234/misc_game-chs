	mov $debugstr,"■OP20E " : gosub *debugout
;■■■「月光に濡れる教室で、僕は。」台本：●授業：執筆：OP20
;━━━━━━━━━━━━━━
;●授業：執筆
;----------------------------------
*OP2040
;◆藍田　菜摘
	;--背景;----------------------------------
	mov $_bg,"BG009A"
	mov $debugstr,"ＢＧ：BG009A"
	gosub *out	;画面に出力
;ＢＧ：BG009A;２年教室

	;--BGM;----------------------------------
	mov $_music,"15": gosub *out
;BGM:藍田　菜摘

	じゃあ手紙を出す相手は、菜摘先生にしよう。
	年上の先生なんて、ちょっと背徳的かなー。\

	さっきの文面の上に
	「藍田　菜摘様」と書きいれてみる。\

	本当に出すわけでもないのに、
	なぜかどきどきした。\

	それから…指示だな。どうしようか。\

	……………………………………。\

	ううん…。どうせ先生が相手だったら
	脅迫…なんて止めたほうがいいかな。\

	それより、菜摘先生が実は
	僕のことが好きだったりして。\

	学生と教師のいけない関係でさ。
	屋上でえっちしちゃうとか。\

	あははは、ありがち、ありがち。
	でも、実在の人物使うと、ドキドキするなぁ。\

	ちょっと書いてみようかな。\

	「菜摘先生へ。昼休み、屋上に来てください。
	　僕に先生のすべてを教えてください」\

	うわ～。こてこてだなぁ、この文章。
	もう少し何かつけくわえておくか。\

	「僕は前から先生のことが好きでした。
	　僕は菜摘先生と愛し合いたい」\

	…ちょっと自分の文才のなさに泣けてくるな。
	もう少し…こう…品格高く…。\

	いや、でもあんまりもって回った文章でも
	はずかしいしなぁ…。ラブレターってのは頭
	使うなぁ…。これ見せても絶対ＯＫしないよな。\

	まあ、いいや。
	どうせ、本当に出すわけじゃないんだし。\

	return	;----------------------------------
;---OP20E  END -----
