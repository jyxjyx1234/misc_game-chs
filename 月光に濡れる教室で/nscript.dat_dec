	mov $debugstr,"■D16 " : gosub *debugout
;■■■「月光に濡れる教室で、僕は。」台本：●帰宅：小夜子と：D16
;━━━━━━━━━━━━━━
;●帰宅：小夜子と
;小夜子と大貫くんの話。

	;--BGM;----------------------------------
