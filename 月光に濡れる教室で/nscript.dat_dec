	【？？？】
	いいじゃないか、桜井。別にさぁ、
	脅してるわけじゃさぁないだろ？　ちがう？\
	dwavestop CH_VOICE	;YOP3801 

	【真実】
	………………………。\

	【$g_hero】
	真実…？　相手は…田口か？\

	ふたりとも僕のクラスメートだ。\

	真実は、眼鏡に三つ編みという古典的な
	スタイルのクラスでも目立たない感じの女子だ。\

	僕にとっては、すごく気になるクラスメイトだ。
	友達以上恋人未満ってとこなんだろうか。\

	田口とは、僕は口をきいたことがない。
	育巳のヤツが嫌ってたな。\

	ひょいっと、階段のぐるぐる回ってる隙間から
	上を見上げてみると、たしかに居たのは真実と
	田口の二人だった。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TBC"
	mov $debugstr,"立ち：TBC "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"BOP3802"
	mov $debugstr,"音声：BOP3802 "
	gosub *vo

	【真実】
	…でも……。\
	dwavestop CH_VOICE	;BOP3802 
	;--立ちキャラ;----------------------------------
	mov $_char,"TUA"
	mov $debugstr,"立ち：TUA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"YOP3803"
	mov $debugstr,"音声：YOP3803 "
	gosub *vo

	【田口】
	言ってくれないとさぁ、わかんないじゃん～。
	ちがう～？\
	dwavestop CH_VOICE	;YOP3803 

	顔中を真っ赤にしたニキビ面で
	分厚い唇をべろりと舐めながら、田口が言った。\

	【$g_hero】
	穏やかな話じゃなさそうだな…。
	どうしようかな…。\
;ここで聞くとフラグが立つ。
;----------------------------------
*hint00
	gosub *hintsave	;ヒント用セーブ
	if %g_hint==OFF goto *hintOP381off
	csel
	"■話を聞いてみる", *OP3810,
	"■やめておく", *OP3820,
	"★ヒント", *OP3830
*hintOP381off	;ヒントがOFFのとき
	csel
	"■話を聞いてみる", *OP3810,
	"■やめておく", *OP3820
;----------------------------------
*OP3810
;◆話を聞いてみる

	【$g_hero】
	このまま…話を聞いてみようかな。\

	まずいかな…。でも本気で知られたくないのなら
	もっと聞こえないところでやるよな。\

	…ちょっと責任転嫁かな？
	でも、とにかく好奇心を刺激されたしさ。\

	【$g_hero】
	それに真実が心配だしな。\

	おどおどとした小動物みたいな目をした
	真実の目を思い出す。\
	goto *nextOP38	;nextOP38へ移動
;----------------------------------
*OP3820
;◆やめておく

	mov %makoto_bad,ON
	【$g_hero】
	やめとこう。
	立ち聞きなんて趣味わるいもんな。\

	僕は、踊り場を離れた。\
	gosub *blackout

	;--BGM;----------------------------------
	mov $_music,"05": gosub *out
	goto *nextOP38	;nextOP38へ移動
;----------------------------------
*OP3830
;◆★ヒント

	「話を聞いてみる」
	真実ルートにはいります。\

	「やめておく」
	バッドエンド行きです。
	選ばないほうが良いでしょう。\
	goto *hint00	;hint00へ移動
;----------------------------------
*nextOP38

	return	;----------------------------------
;---OP38 END -----
