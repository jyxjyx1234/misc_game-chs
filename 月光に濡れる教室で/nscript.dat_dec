*C42	; ■ファイル開始のラベル
	mov $debugstr,"■C42 " : gosub *debugout
;■■■「月光に濡れる教室で、僕は。」台本：●矢崎とファックスのこと：B42
;━━━━━━━━━━━━━━
;●矢崎とファックスのこと

	;--BGM;----------------------------------
	mov $_music,"01": gosub *out
	;--背景;----------------------------------
	mov $_bg,"BG013G"
	mov $debugstr,"ＢＧ：BG013G"
	gosub *out	;画面に出力
;ＢＧ：BG013A;廊下
	;--立ちキャラ;----------------------------------
	mov $_char,"THA"
	mov $debugstr,"立ち：THA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XC4200"
	mov $debugstr,"音声：XC4200"
	gosub *vo

	【矢崎】
	やあ。
	皆月先輩も、こんにちは。\
	dwavestop CH_VOICE	;XC4200

	【$g_hero】
	矢崎？
	なんでこんな所にいるんだ？\
	;--立ちキャラ;----------------------------------
	mov $_char,"THJ"
	mov $debugstr,"立ち：THJ "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XC4201"
	mov $debugstr,"音声：XC4201"
	gosub *vo

	【矢崎】
	こんなところで奇遇何もないだろう。
	目的は、君たちも一緒だろ？\
	dwavestop CH_VOICE	;XC4201

	そう言われて、思い出した。
	こいつもドラッグについての調査を
	しているんだっけ。\
	;--立ちキャラ;----------------------------------
	mov $_char,"THC"
	mov $debugstr,"立ち：THC "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XC4202"
	mov $debugstr,"音声：XC4202"
	gosub *vo

	【矢崎】
	それにしても大変だね。
	君は、色々と。\
	dwavestop CH_VOICE	;XC4202

	【$g_hero】
	ああ、お前の言った通りだったな。\
	;--立ちキャラ;----------------------------------
	mov $_char,"THE"
	mov $debugstr,"立ち：THE "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XC4203"
	mov $debugstr,"音声：XC4203"
	gosub *vo

	【矢崎】
	そうだね。噂の筆頭だからね。
	よりによって君たちが犯人扱いだなんてね。\
	dwavestop CH_VOICE	;XC4203

	【$g_hero】
	……噂だよ。\
	;--立ちキャラ;----------------------------------
	mov $_char,"THC"
	mov $debugstr,"立ち：THC "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XC4204"
	mov $debugstr,"音声：XC4204"
	gosub *vo

	【矢崎】
	ところが、それだけで片づかない問題がある。\
	dwavestop CH_VOICE	;XC4204

	【$g_hero】
	何だって？\

	;--BGM;----------------------------------
	mov $_music,"03": gosub *out
	;--立ちキャラ;----------------------------------
	mov $_char,"THE"
	mov $debugstr,"立ち：THE "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XB0905"
	mov $debugstr,"音声：XB0905"
	gosub *vo

	【矢崎】
	こんなものがある。\
	dwavestop CH_VOICE	;XB0905

	矢崎は上着のポケットから
	一枚の紙を取り出した。\

	【$g_hero】
	何？\

	僕は奪うようにして、それを覗きこんだ。\

	【$g_hero】
	…今回の自殺には、裏がある…って
	どういうことだよ、これ！\
	;--立ちキャラ;----------------------------------
	mov $_char,"THA"
	mov $debugstr,"立ち：THA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XB0906"
	mov $debugstr,"音声：XB0906"
	gosub *vo

	【矢崎】
	ご覧の通り。職員室のファックスに来てたのさ。
	あと警察にも来たみたいだよ。\
	dwavestop CH_VOICE	;XB0906

	【$g_hero】
	ファックスだったら発信元わかるだろ？\
	;--立ちキャラ;----------------------------------
	mov $_char,"THC"
	mov $debugstr,"立ち：THC "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XB0907"
	mov $debugstr,"音声：XB0907"
	gosub *vo

	【矢崎】
	それが茶目っ気があってね。
	うちの職員室からだった。２台あるだろう？\
	dwavestop CH_VOICE	;XB0907

	【$g_hero】
	教員以外がファックス送ってれば
	目立つじゃないか。\
	;--立ちキャラ;----------------------------------
	mov $_char,"THA"
	mov $debugstr,"立ち：THA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XB0908"
	mov $debugstr,"音声：XB0908"
	gosub *vo

	【矢崎】
	職員室のファックスは、送信時刻が設定できる
	ようになってるんだよ。\
	dwavestop CH_VOICE	;XB0908

	深夜や早朝の、料金の安い時間に
	送れるようにね、と矢崎は後を続けた。\

	【$g_hero】
	つまり、ひとの居ない時間に、だれかが
	その…ファックスを送るようにしたと。\
	;--立ちキャラ;----------------------------------
	mov $_char,"THA"
	mov $debugstr,"立ち：THA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XB0909"
	mov $debugstr,"音声：XB0909"
	gosub *vo

	【矢崎】
	そう言うこと。\
	dwavestop CH_VOICE	;XB0909

	【$g_hero】
	じゃあ…誰が送ったか…
	わかんないってことだよな…。\

	僕はぞっとした。\

	もしかして、そのファックスを送ったヤツは
	一昨日、僕のノートにあの天使のカードを
	入れたヤツじゃないのか？\

	【$g_hero】
	な…なんなんだよ！どうして！！\

	さっぱりわからなかった。
	僕はごく普通の平凡な学生で、別にヤバイ遊びも
	なにもしてないし、特に秀でたところもない。\

	【$g_hero】
	どうして僕がこんな目に…！\

	ああ、くそっ！！　自分で言ってて、
	その平凡な台詞に目眩がしそうだ！！　\

	それっぐらい僕は平凡で、
	ありきたりの人間でしかないのに。\

	【$g_hero】
	お前は、どうしてこのことを…？\
	;--立ちキャラ;----------------------------------
	mov $_char,"THD"
	mov $debugstr,"立ち：THD "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XC4205"
	mov $debugstr,"音声：XC4205"
	gosub *vo

	【矢崎】
	そりゃ、君はそういうことをできるような
	器用なタイプに見えないからさ。\
	dwavestop CH_VOICE	;XC4205

	【$g_hero】
	…ほめてんの、けなしてんの？\
	;--立ちキャラ;----------------------------------
	mov $_char,"THB"
	mov $debugstr,"立ち：THB "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XB0917"
	mov $debugstr,"音声：XB0917"
	gosub *vo

	【矢崎】
	事実を言ってるまでだよ。\
	dwavestop CH_VOICE	;XB0917

	【$g_hero】
	…何はともあれ、ありがとう。でも警察が
	調べればそれぐらいすぐに判明するよな？\
	;--立ちキャラ;----------------------------------
	mov $_char,"THC"
	mov $debugstr,"立ち：THC "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XB0918"
	mov $debugstr,"音声：XB0918"
	gosub *vo

	【矢崎】
	普通だったらね。\
	dwavestop CH_VOICE	;XB0918

	【$g_hero】
	な、なんだよ。\
	;--立ちキャラ;----------------------------------
	mov $_char,"THE"
	mov $debugstr,"立ち：THE "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XB0919"
	mov $debugstr,"音声：XB0919"
	gosub *vo

	【矢崎】
	忘れるなよ。君は誰かに
	罪を着せられそうになっているんだよ。\
	dwavestop CH_VOICE	;XB0919

	【$g_hero】
	……………！！\

	一瞬、言葉につまった。\

	【$g_hero】
	どうして僕が！？
	誰にも、恨まれるようなことしてないぞ！\
	;--立ちキャラ;----------------------------------
	mov $_char,"THA"
	mov $debugstr,"立ち：THA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XB0920"
	mov $debugstr,"音声：XB0920"
	gosub *vo

	【矢崎】
	知らないところで恨みを買ってたりね。
	わからないものだよ、人の心なんて。\
	dwavestop CH_VOICE	;XB0920
	;--立ちキャラ;----------------------------------
	mov $_char,"TCC"
	mov $debugstr,"立ち：TCC "
	gosub	*out	;画面に出力

	【明海】
	…………………。\

	【$g_hero】
	……なんで僕たちが…。\

	;--BGM;----------------------------------
	mov $_music,"02": gosub *out
	;--立ちキャラ;----------------------------------
	mov $_char,"THB"
	mov $debugstr,"立ち：THB "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XC4206"
	mov $debugstr,"音声：XC4206"
	gosub *vo

	【矢崎】
	さて、オレの手持ちの情報はこれで終わり。
	で？　君たちは、何かみつけたの？\
	dwavestop CH_VOICE	;XC4206
	;--立ちキャラ;----------------------------------
	mov $_char,"TCC"
	mov $debugstr,"立ち：TCC "
	gosub	*out	;画面に出力

	【明海】
	………………………。\

	【$g_hero】
	見つけたような…見つけなかったような…。\

	僕は、言葉を濁した。\

	さっき見つけたもの。スピーカーの中の花。
	それは、矢崎にとっても大きな収穫だろう。\

	でも、それを教えるということは、
	何か色々マズイ気がした。\

	それに花のことを教えるのは、
	僕たちの夜の秘密を明かすような気にもなって
	恥ずかしかった。\

	矢崎を疑うわけじゃないけど
	僕は黙っておくことにした。\
	;--立ちキャラ;----------------------------------
	mov $_char,"THA"
	mov $debugstr,"立ち：THA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XC4207"
	mov $debugstr,"音声：XC4207"
	gosub *vo

	【矢崎】
	ふぅん…まあいいさ。
	君たちは君たちで思うところがあるんだろうし。\
	dwavestop CH_VOICE	;XC4207
	;--立ちキャラ;----------------------------------
	mov $_char,"THB"
	mov $debugstr,"立ち：THB "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XC4208"
	mov $debugstr,"音声：XC4208"
	gosub *vo

	【矢崎】
	何か渡せる情報があったら教えてくれ。
	じゃあな。\
	dwavestop CH_VOICE	;XC4208
	gosub *clear_char

	そう言って、矢崎は空き教室の方に
	歩いていった。\

	return	;----------------------------------
;---C42  END -----
