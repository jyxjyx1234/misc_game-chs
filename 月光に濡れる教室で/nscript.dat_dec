	mov $debugstr,"音声：YE4811"
	gosub *vo

	【$g_heroの兄】
	うちの両親は、そういうの
	うるさくなくって、いいよね。\
	dwavestop CH_VOICE	;YE4811

	【$g_hero】
	兄さんに言われたくないと思うけどね。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TLD"
	mov $debugstr,"立ち：TLD "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"YE4812"
	mov $debugstr,"音声：YE4812"
	gosub *vo

	【$g_heroの兄】
	どういう意味？\
	dwavestop CH_VOICE	;YE4812

	【$g_hero】
	だってホントに、そのひとと仲良かったの？
	家に、連れてきたことあったの？\
	;--立ちキャラ;----------------------------------
	mov $_char,"TLC"
	mov $debugstr,"立ち：TLC "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"YE4813"
	mov $debugstr,"音声：YE4813"
	gosub *vo

	【$g_heroの兄】
	何言うんだよ～。じゃあ、明日津島先輩
	知ってるヤツつれてきてやるよ。\
	dwavestop CH_VOICE	;YE4813

	【$g_hero】
	いや、そこまでしないでも…。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TLB"
	mov $debugstr,"立ち：TLB "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"YE4814"
	mov $debugstr,"音声：YE4814"
	gosub *vo

	【$g_heroの兄】
	そうと決めたら連絡しとかなきゃ。電話電話。
	あ、じゃあ、明日ちゃんと帰ってこいよ。\
	dwavestop CH_VOICE	;YE4814

	【$g_hero】
