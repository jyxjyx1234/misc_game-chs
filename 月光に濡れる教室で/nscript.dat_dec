*CH05	; ■ファイル開始のラベル
	mov $debugstr,"■CH05" : gosub *debugout
;■■■「月光に濡れる教室で、僕は。」台本：○１：尻穴いじりながらフェ○：CH05
;━━━━━━━━━━━━━━
;○１：尻穴いじりながらフェ○

	;--BGM;----------------------------------
	mov $_music,"10": gosub *out
	;--背景;----------------------------------
	mov $_bg,"BG020B"
	mov $debugstr,"ＢＧ：BG020B"
	gosub *out	;画面に出力
;;使われてない教室（調教用）

	僕は、ズボンからペ○スを取り出した。
	ぶるん、と音を立てて僕のものが飛び出してくる。\

	【$g_hero】
	ねぇ、くわえてよ。\

	僕は先輩の頭を掴むと、先輩の唇を
	屹立する下半身に押しつけた。\

	【$g_hero】
	手でしごいて、舌で舐めてよ。\

	先輩は、目の前に突き出された僕のモノに
	硬直した。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCF"
	mov $debugstr,"立ち：TCF "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CCH0500"
	mov $debugstr,"音声：CCH0500 "
	gosub *vo

	【明海】
	あ…あ…。\
	dwavestop CH_VOICE	;CCH0500 

	先輩の目が涙を浮かべる。\

	【$g_hero】
	なんでそんな顔するの？
	昨日も一昨日も、下の口で悦んでくわえてたのに。\

	【$g_hero】
	くわえてよ、上の口だって同じことでしょ？\

	【$g_hero】
	そうじゃないと、
	勝手に先輩の口、ずぼずぼ犯すよ。\

	【$g_hero】
	ノドの奥突いて、食道まで使って、
	胃の中に精液を流し込んじゃうよ。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCH"
	mov $debugstr,"立ち：TCH "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CCH0501"
	mov $debugstr,"音声：CCH0501 "
	gosub *vo

	【明海】
	あああ…いや…いやぁ…っそんなこと
	言わないで…。\
	dwavestop CH_VOICE	;CCH0501 

	先輩がぽろぽろと涙をこぼす。\

	【$g_hero】
	泣いたってダメだよ。
	早くしないと本当に奥まで突っ込むよ？\

	【$g_hero】
	先輩の口の中は、やわらかくて唾液があふれて
	あったかくて気持ちいいだろうね。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCH"
	mov $debugstr,"立ち：TCH "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CCH0502"
	mov $debugstr,"音声：CCH0502 "
	gosub *vo

	【明海】
	う…ううっ…ひっく…ひぃっく…。
	わかったわ…やるわ…やります…ううっ。\
	dwavestop CH_VOICE	;CCH0502 

	先輩の手が、おずおずと僕のペ○スにのびる。
	口をちいさくあけると、頭の部分を舐めはじめた。\
	;-- イベントCG;----------------------------------
	mov $_cg,"C08A"
	mov $debugstr,"ＣＧ：C08A"
	gosub *cgout	;イベントＣＧ
	;-音声;----------------------------------
	mov $_voice,"CCH0503"
	mov $debugstr,"音声：CCH0503 "
	gosub *vo

	【明海】
	あ…んむっ…ん…ぺろ…ぴちゅ…っ。
	れろ…ぺろ……ぴちゃ…あっ…！\
	dwavestop CH_VOICE	;CCH0503 
	;-Ｈ効果音;----------------------------------
	mov $_se,"WM13"
	mov $debugstr,"Ｈ音：WM13"
	gosub *se
;

	【$g_hero】
	唾液をためて、僕のモノに伝わせるようにして。
	先輩の愛液まみれにするみたいにするんだよ。\
	;-Ｈ効果音;----------------------------------
	mov $_se,"WM11"
	mov $debugstr,"Ｈ音：WM11"
	gosub *se
;

	先輩の目にまたじわりと涙が浮かぶ。\
	;-Ｈ効果音;----------------------------------
	mov $_se,"WM13"
	mov $debugstr,"Ｈ音：WM13"
	gosub *se
;

