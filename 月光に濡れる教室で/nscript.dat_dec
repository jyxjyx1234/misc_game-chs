	mov $debugstr,"音声：CC1300"
	gosub *vo

	【明海】
	１月の下旬くらいからずっとこんな感じよ。\
	dwavestop CH_VOICE	;CC1300

	【$g_hero】
	そうなんだ。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCC"
	mov $debugstr,"立ち：TCC "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC1301"
	mov $debugstr,"音声：CC1301"
	gosub *vo

	【明海】
	試験シーズンに入ってからは、
	授業に出ない子たちも結構いるわ。\
	dwavestop CH_VOICE	;CC1301
	;--立ちキャラ;----------------------------------
	mov $_char,"TCA"
	mov $debugstr,"立ち：TCA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC1302"
	mov $debugstr,"音声：CC1302"
	gosub *vo

	【明海】
	出席日数が間に合えば、卒業はできるでしょ？\
	dwavestop CH_VOICE	;CC1302

	【$g_hero】
	そりゃそうだけど…。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCI"
	mov $debugstr,"立ち：TCI "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC1303"
	mov $debugstr,"音声：CC1303"
	gosub *vo

	【明海】
	漫然と授業を受けているよりも、塾で勉強した
	方が無駄がなくていいんですって。\
	dwavestop CH_VOICE	;CC1303

	【$g_hero】
	トモダチが言ったの？\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCA"
	mov $debugstr,"立ち：TCA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC1304"
	mov $debugstr,"音声：CC1304"
	gosub *vo

	【明海】
	ええ…そうよ。\
	dwavestop CH_VOICE	;CC1304

	【$g_hero】
	でも先輩は、ちゃんと今でも来てるし、
	学生会の手伝いもしているし。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCA"
	mov $debugstr,"立ち：TCA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC1305"
	mov $debugstr,"音声：CC1305"
	gosub *vo

	【明海】
	私は…もう行く大学が決まってるから。\
	dwavestop CH_VOICE	;CC1305

	【$g_hero】
	そうか、兄さんと一緒だっけ。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCJ"
	mov $debugstr,"立ち：TCJ "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC1306"
	mov $debugstr,"音声：CC1306"
	gosub *vo

	【明海】
	…そうよ。\
	dwavestop CH_VOICE	;CC1306

	【$g_hero】
	………………。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCJ"
	mov $debugstr,"立ち：TCJ "
	gosub	*out	;画面に出力

	【明海】
	………………。\

	先輩が、浮かない表情をしている。
	こうなると、先輩はどんどん無口になっていく。\

	なんだよ。どうして黙っちゃうんだよ。
	そう問いつめたかった。\

	けれど。
	気詰まりなままでいる方がもっとイヤだった。\

	だから僕は、話題を変えることにした。\

	【$g_hero】
	…みんな、あんな事件があった後なのに。
	全然普通っぽいな。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCJ"
	mov $debugstr,"立ち：TCJ "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC1307"
	mov $debugstr,"音声：CC1307"
	gosub *vo

	【明海】
	………………そうね。\
	dwavestop CH_VOICE	;CC1307

	…。会話の流れを変えたかったからって、
	いくらなんでもマズかったか。\

	先輩にとっては、クラスメイトなんだし。\

	ああ、もう！　まったくうまくいかない。
	あっけなくフリダシに戻ってしまった気分だ。\

	無口な先輩は、苦手なんだ。
	さっきみたいに、話したいんだ。\

	でも…こんな話題を振ったのは、
	この教室の人たちがすこしも変わらないのに
	驚いていたからだ。\

	;--BGM;----------------------------------
	mov $_music,"04": gosub *out

	廊下や階段でたむろしている奴らは、誰も彼も、
	ヒソヒソ話をしていて。\

	だけど、一人でいる人間なんてどこに行っても
	見つからなくて。\

	浮ついているような、怖がっているような。
	…そんな奇妙な高揚感が漂っていた。\

	なのに、受験生って言ったってさ。
	こんなにも無関心でいられるんだろうか？\

	かといって目の色変えて勉強してるって感じ
	はしなくて。\

	ただ無関心。周りのことには目もくれないで。
	自分の予定だけをこなしていく。\

	そんな風に見えたんだ。
	…ちょっと怖い、と思った。\

	僕も来年の今頃は、こんな風になってるんだろう
	か。想像もつかないけどさ。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCH"
	mov $debugstr,"立ち：TCH "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC1308"
	mov $debugstr,"音声：CC1308"
	gosub *vo

	【明海】
	一度は、廊下ですれ違っているかもしれない…
	そんな人が亡くなったのに…哀しいわね……。\
	dwavestop CH_VOICE	;CC1308

	先輩が、軽く目を伏せた。\

	【$g_hero】
	先輩は、優しいんだよ。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCD"
	mov $debugstr,"立ち：TCD "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC1309"
	mov $debugstr,"音声：CC1309"
	gosub *vo

	【明海】
	優しい…そうかしら。\
	dwavestop CH_VOICE	;CC1309

	【$g_hero】
	名前も知らない…他人に、そうやって哀しいって
	言えるのはさ、やさしさじゃないかな。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCJ"
	mov $debugstr,"立ち：TCJ "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC1310"
	mov $debugstr,"音声：CC1310"
	gosub *vo

	【明海】
	そう…ね…。\
	dwavestop CH_VOICE	;CC1310

	【$g_hero】
	でも僕は、そうして口に出すことができる先輩は、
	すごいと思うんだ。\

	僕は、自分のことが一番かわいいから。
	ただ哀しむだけじゃなくて。\

	それだけじゃなくて…どうしてあのタイミングで
	落ちて来たんだ…とか。\

	どうしても、どうしても、恨めしく思ったりする。
	情けないけど。でもそう思ってしまうんだ。\

	そんな風に思ってしまうから…。
	だから、先輩はすごいと思う。\

	先輩は、疑いなく死んだ人を悼んでいる。
	それがわかるから、本当にすごいと思うんだ。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCC"
	mov $debugstr,"立ち：TCC "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC1311"
	mov $debugstr,"音声：CC1311"
	gosub *vo

	【明海】
	……。わからないわ。\
	dwavestop CH_VOICE	;CC1311

	【$g_hero】
	そっか…。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCA"
	mov $debugstr,"立ち：TCA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC1312"
	mov $debugstr,"音声：CC1312"
	gosub *vo

	【明海】
	でも、ありがとう。
	キミにそう言ってもらえるのは、嬉しいわ…。\
	dwavestop CH_VOICE	;CC1312

	【$g_hero】
	………うん。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCA"
	mov $debugstr,"立ち：TCA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC1313"
	mov $debugstr,"音声：CC1313"
	gosub *vo

	【明海】
	…カバンとって来るから。\
	dwavestop CH_VOICE	;CC1313

	【$g_hero】
	う、うん…いってらっしゃい。\
	gosub *clear_char

	先輩が、自分の机に近づいていった。
	荷物を鞄に詰めている。\

	机に置きっぱなしとか、しないんだな。
	先輩だもんな。そんなことしないか。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCA"
	mov $debugstr,"立ち：TCA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC1314"
	mov $debugstr,"音声：CC1314"
	gosub *vo

	【明海】
	おまたせ。行きましょ？\
	dwavestop CH_VOICE	;CC1314

	【$g_hero】
	うん。\

	僕たちは、３年の教室を出て行った。\
	gosub *blackout

	;--BGM;----------------------------------
	mov $_music,"05": gosub *out

	return	;----------------------------------
