	mov $debugstr,"音声：XC9875"
	gosub *vo

	【矢崎】
	………別にそんなの、どうだっていいんだよ。
	君は君のやり方でぶつかってくればいい。\
	dwavestop CH_VOICE	;XC9875
	;--立ちキャラ;----------------------------------
	mov $_char,"THB"
	mov $debugstr,"立ち：THB "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XC9876"
	mov $debugstr,"音声：XC9876"
	gosub *vo

	【矢崎】
	それを見せればいいんだ。
	あとは、オレたちが何とかするから。\
	dwavestop CH_VOICE	;XC9876

	【$g_hero】
	え…？\

	;--BGM;----------------------------------
	mov $_music,"07": gosub *out
	;--立ちキャラ;----------------------------------
	mov $_char,"THA"
	mov $debugstr,"立ち：THA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XC9877"
	mov $debugstr,"音声：XC9877"
	gosub *vo

	【矢崎】
	協力するよ。君のためだけじゃない。
	皆月先輩と…それから学園のためにね。\
	dwavestop CH_VOICE	;XC9877

	【$g_hero】
	何故…？\

	そう言ったら、矢崎は笑った。
	いつものイヤミたっぷりの笑顔じゃない。\

	もっと清々しくて…やさしい笑顔だった。
	こんな顔もできるんだな…矢崎。\
	;--立ちキャラ;----------------------------------
	mov $_char,"THA"
	mov $debugstr,"立ち：THA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
