	【$g_hero】
	あ、ご両親との話し合いは終わったの？\
	;-音声;----------------------------------
	mov $_voice,"CC11108"
	mov $debugstr,"音声：CC11108 "
	gosub *vo

	【明海】
	ええもう平気よ。\
	dwavestop CH_VOICE	;CC11108 

	【$g_hero】
	そっか…ごめんね…電話するっていっていて
	そっちからかけさせちゃって。\
	;-音声;----------------------------------
	mov $_voice,"CC11109"
	mov $debugstr,"音声：CC11109 "
	gosub *vo

	【明海】
	ううん。
	さっきワザワザ来てくれたのにゴメンなさいね。\
	dwavestop CH_VOICE	;CC11109 

	【$g_hero】
	ううん、僕こそゴメン。
	…校門で待ってたのに…時間かかっちゃって。\
	;-音声;----------------------------------
	mov $_voice,"CC11110"
	mov $debugstr,"音声：CC11110 "
	gosub *vo

	【明海】
	いいの。気にしないで。
	私も突然だったし。\
	dwavestop CH_VOICE	;CC11110 
	;-音声;----------------------------------
	mov $_voice,"CC11111"
	mov $debugstr,"音声：CC11111 "
	gosub *vo

	【明海】
	じゃあ…また明日ね。\
	dwavestop CH_VOICE	;CC11111 

	【$g_hero】
	うん、また明日。\

	僕は、電話を切った。\

	【$g_hero】
	さてと…
	明日…明後日が、卒業式か…。\

	僕は壁に掛かっているカレンダーを
	見ながらつぶやいた。\

	【$g_hero】
	明日早く行って、講堂の用意しとかないと
	いけないんだっけ。\

	学生会の仕事もあるし、コーラス部の方も
	やらないといけないし。\

	【$g_hero】
	忙しくなりそうだな…早く寝た方がいいな。\

	【$g_hero】
	おやすみなさい…。\
	;-効果音;----------------------------------
	mov $_se,"ZSWITCH"
	mov $debugstr,"ＳＥ：ZSWITCH "
	gosub *se
	gosub *blackout
;ＳＥ：SWITCH;電気を消す音
;すばやい暗転
	gosub *musicstop
;☆→→→バッド：丹羽と「天使」

	return	;----------------------------------
;---C111 END -----
