	mov $debugstr,"音声：CC1205"
	gosub *vo

	【明海】
	ただ、たくさん目のある翼はとても原始的で
	正しいと思ったことがあるけど。\
	dwavestop CH_VOICE	;CC1205

	天使には、羽根の一枚一枚に目をつけている
	モノもいる。\

	コーラス部でグロリアとか唄ったから
	ちょっと調べたんだ。\

	それほど詳しいってわけじゃないけど…。\

	【$g_hero】
	正しい？\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCA"
	mov $debugstr,"立ち：TCA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC1206"
	mov $debugstr,"音声：CC1206"
	gosub *vo

	【明海】
	数が多いってことは、力があるってことなの。\
	dwavestop CH_VOICE	;CC1206

	【$g_hero】
	へぇ…そうなんだ。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCA"
	mov $debugstr,"立ち：TCA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC1207"
	mov $debugstr,"音声：CC1207"
	gosub *vo

	【明海】
	地母神であるイシュタルの像は、沢山の乳房を
	もっているけど、あれは多産と豊饒の象徴なの。\
	dwavestop CH_VOICE	;CC1207

	【$g_hero】
	へぇ…すごいなあ、先輩は。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCC"
	mov $debugstr,"立ち：TCC "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC1208"
	mov $debugstr,"音声：CC1208"
	gosub *vo

	【明海】
	別に…ただ知っているだけよ。\
	dwavestop CH_VOICE	;CC1208

	先輩は、そっと目を伏せた。\

	先輩は、僕が勉強についてほめたりしても
	嬉しがらない。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCA"
	mov $debugstr,"立ち：TCA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC1209"
	mov $debugstr,"音声：CC1209"
	gosub *vo

	【明海】
	そう…「天使」…ね……。\
	dwavestop CH_VOICE	;CC1209

	【$g_hero】
	…天使って誰なんだろうな。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCC"
	mov $debugstr,"立ち：TCC "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC1210"
	mov $debugstr,"音声：CC1210"
	gosub *vo

	【明海】
	…わからないわ。
	でも、キミじゃないんでしょう？\
	dwavestop CH_VOICE	;CC1210

	【$g_hero】
	もちろんだよ！
	僕も…同じように呼び出されたんだ。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCA"
	mov $debugstr,"立ち：TCA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC1211"
	mov $debugstr,"音声：CC1211"
	gosub *vo

	【明海】
	ええ。
	私も…キミの言うこと、信じるわ。\
	dwavestop CH_VOICE	;CC1211

	そう言って、先輩は綺麗に笑った。
	僕は…胸が熱くなった。\

	あんな事したのに。あんなヒドイことしたのに。
	先輩は、僕を信じるんだ。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCD"
	mov $debugstr,"立ち：TCD "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC1212"
	mov $debugstr,"音声：CC1212"
	gosub *vo

	【明海】
	そういえば、キミのカード。\
	dwavestop CH_VOICE	;CC1212

	【$g_hero】
	あ！！そうだ！
	カードを取りにいくはずだったんだ…。\

	すっかり忘れていた。
	僕はあわてて、ドアにむかった。\

	【$g_hero】
	帰るにしたって、教室に寄ってからだ。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCA"
	mov $debugstr,"立ち：TCA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC1213"
	mov $debugstr,"音声：CC1213"
	gosub *vo

	【明海】
	そうね。私も教室に寄りたいわ。
	それから帰りましょう？\
	dwavestop CH_VOICE	;CC1213

	【$g_hero】
	う…うん。\

	いつのまにか一緒に帰ることになっているのが
	おかしかった。\

	そりゃ、今の状況で校門からバラバラになって
	帰るのもおかしいんだけどさ。\

	家は隣同士なんだし。かえって不自然だ。
	だけど、僕はすこし残念だった。\

	…こんなきっかけでなくても。\

	昔みたいに自然に一緒に話したり、
	帰ることができていれば、一番よかったのにな。\

	ついこの間までの気まずさに比べたら、
	それはとても贅沢な話なんだけど。\

	【$g_hero】
	じゃあ…行こうか。同じ方向に帰るんだから、
	一緒に行動した方がいいよな。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCA"
	mov $debugstr,"立ち：TCA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC1214"
	mov $debugstr,"音声：CC1214"
	gosub *vo

	【明海】
	…そうね。私もそう思うわ。
	行きましょう？\
	dwavestop CH_VOICE	;CC1214

	僕たちは、学生会室を出た。\
	gosub *blackout

