	ねぇ。先輩知ってる？\
	;-Ｈ効果音;----------------------------------
	mov $_se,"WC001"
	mov $debugstr,"Ｈ音：WC001 "
	gosub *se
;ナニを前から出し入れ

	そんな声、聞くとさ。
	もっともっとヒドイ事、したくなるんだよ。\
	;-Ｈ効果音;----------------------------------
	mov $_se,"WC005"
	mov $debugstr,"Ｈ音：WC005 "
	gosub *se
;ナニを出し入れ/（パンパン）

	もっともっと。
	どれだけでも泣かせてみたくなる。\
	;-Ｈ効果音;----------------------------------
	mov $_se,"WC007"
	mov $debugstr,"Ｈ音：WC007 "
	gosub *se
