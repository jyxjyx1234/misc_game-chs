*D81	; ■ファイル開始のラベル
	mov $debugstr,"■D81 " : gosub *debugout
;■■■「月光に濡れる教室で、僕は。」台本：●朝：登校：D81
;━━━━━━━━━━━━━━
;●朝：登校

	;--BGM;----------------------------------
	mov $_music,"04": gosub *out
;BGM:哀
	;--背景;----------------------------------
	mov $_bg,"BG014A"
	mov $debugstr,"ＢＧ：BG014A"
	gosub *out	;画面に出力
;ＢＧ：BG014A;校門

	校舎に入る前に、一瞬、ためらった。
	丸２年ちかく通ってる場所なのにな。\

	つい昨日校長先生が亡くなって、
	そのちょっと前に大貫君が亡くなって。\

	【$g_hero】
	卒業式まで、あとちょっとなのにな。\

	それが悲しいのか苦しいのか、
	僕には、よく解らなかった。\

	亡くなった２人は、どちらも僕と親しい人では
	なかったし、第一発見者にならなければ、
	ただ、ふうん…で終わってしまうことだろう。\

	だからこそ、なんだか少しさびしかった。
	そうだな。寂しいのかな。\

	終わってしまうことは、どこか寂しいんだ。
	たとえて言えば、卒業式みたいに。\

	たとえば、小夜子と手を繋いで歩く道が
	ずうっと続けばいいのにと思うみたいに。\

	【$g_hero】
	…感傷的になってるなぁ…僕も。
	そんな場合じゃないって、朝も思っただろ。\

	そうだ。なんとかして大貫君のことと
	それから天使のことを調べ上げなくちゃ。\

