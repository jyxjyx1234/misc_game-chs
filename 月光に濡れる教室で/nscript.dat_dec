	gosub *map	;マップ選択
	;if %map_pos==01	;移動先なし
	if %map_pos==02 mov %map02,0: gosub *OP03: gosub *OP04: gosub *OP05: gosub *OP06: gosub *OP07: goto *OPMAP01_map
	;if %map_pos==03	;移動先なし
	;if %map_pos==04	;移動先なし
	;if %map_pos==05	;移動先なし
	if %map_pos==06 mov %map06,0: gosub *OP08: gosub *OP09: gosub *OP10: gosub *OP11: gosub *OP12: gosub *OP13: goto *OPMAP01_map
	if %map_pos==07 mov %map07,0: gosub *OP14: gosub *OP15: gosub *OP16: gosub *OP17: goto *OPMAP01_map
	;if %map_pos==08	;移動先なし
if %g_trueroot==ON	if %map_pos==09 mov %map09,0: gosub *E00: goto *OPMAP01_map
	;if %map_pos==10	;移動先なし
	;if %map_pos==11	;移動先なし
	;if %map_pos==12	;移動先なし
	if  %map_pos==13	goto *OPMAP01_end
	goto *OPMAP01_map
*OPMAP01_end	;マップ終了
	return
