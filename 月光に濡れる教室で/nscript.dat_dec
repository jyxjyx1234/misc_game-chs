	numalias _l	,7	;
	numalias is_adv	,8	;0でタイトル画面／1でADV／2で回想
	numalias touka	,409	;メッセージウィンドウの透過度
				;これは定数ではなく変数として使う

	numalias page	,10	;SAVE/LOADで使用
	numalias slot	,11	
	numalias saveno	,12

	numalias _save_x,13
	numalias _save_y,14

	numalias month	,20
	numalias day	,21
	numalias hour	,22
	numalias min	,23

;ゲーム用ローカル変数
	numalias moving_title	,24	;タイトル画面のアニメするか否か

	numalias map_pos,25	;マップの行き先
	numalias map01	,26 ;１年教室
	numalias map02	,27 ;２年教室
	numalias map03	,28 ;３年教室
	numalias map04	,29 ;保健室
	numalias map05	,30 ;裏庭
	numalias map06	,31 ;コーラス部室（音楽室）
	numalias map07	,32 ;学生会室
	numalias map08	,33 ;体育館
	numalias map09	,34 ;職員室
	numalias map10	,35 ;屋上
	numalias map11	,36 ;購買
	numalias map12	,37 ;美術部部室

	numalias skip_status	,38	;スキップ継続のヤツ	
	numalias debug		,39	;ONでデバッグ用表示する

	numalias cts_play	,40	;シチュ：虐める、奉仕、ラブ
	numalias cts_pos	,41	;場所：性器、お尻、玩具
		numalias nCTS_IJIMERU	,1
		numalias nCTS_HOUSHI	,2
		numalias nCTS_LOVE	,3
		numalias nCTS_SEIKI	,1
		numalias nCTS_OSIRI	,2
		numalias nCTS_GANGU	,3
		numalias nCTS_CANCEL	,4

	numalias nomap01_count,42
	numalias nomap02_count,43
	numalias nomap03_count,44
	numalias nomap04_count,45
	numalias nomap05_count,46
	numalias nomap06_count,47
	numalias nomap07_count,48
	numalias nomap08_count,49
	numalias nomap09_count,50
	numalias nomap10_count,51
	numalias nomap11_count,52
	numalias nomap12_count,53

	numalias moving_map	,54	;マップ画面のアニメするか否か
	numalias check_skip	,55	;ONでスキップ継続かどうかのチェック
	numalias is_meswin	,56	;0で通常/1でフル
;---------------------------------------------------------------------------
;○シナリオ関連	100-199 --- これはlocal_initialでクリアする
	numalias makoto_bad,	100	;真実バッドエンディングへ
	numalias akemi_bad,	101	;明海バッドエンディングへ
	numalias sayoko_bad,	102	;小夜子バッドエンディングへ
	numalias natsumi_bad,	103	;先生バッドエンディングへ
	numalias ending,	104	;今回のエンディングは誰やねん？
		numalias MAKOTO_END_MEGANE,	1;真実眼鏡エンド
		numalias MAKOTO_END_CONTACT,	2;真実コンタクトエンド
		numalias AKEMI_NORMAL_END,	3;
		numalias AKEMI_HAPPY_END,	4;
		numalias SAYOKO_END,		5;
		numalias NATSUMI_END,		6;
		numalias BAD_END,		7;

	numalias tousatu,	110	;★フラグ：盗撮写真　真実シナリオで
	numalias drug,		111	;★フラグ：ドラッグ


;眼鏡はホントはグローバルじゃないけど、今更なんでg_つけっぱなし。
;間違えたヨ…とほほ…。
	numalias g_nomegane,	122	;ONで眼鏡なし。デフォルトOFF
	numalias g_gomegane,	128	;ONで眼鏡なしがONになる。
	numalias g_root,	123	;シナリオのルート
					;MAKOTO/AKEMI/SAYOKO/NATSUMI
	;OPのやめるボタンを有効にするか否か
	numalias map_exit,	130	;1になるまで止めるは有効にならない
	numalias m01,	131
	numalias m02,	132
	numalias m03,	133
	numalias m04,	134
	numalias m05,	135
	numalias m06,	136
	numalias m07,	137
	numalias m08,	138
	numalias m09,	139
	numalias m10,	140
	numalias m11,	141
	numalias m12,	142
;---------------------------------------------------------------------------
;●文字列変数用エイリアス
;0-199までが普通の変数/200-999までがグローバル変数
;locals
	numalias _bg		,10
	numalias _music		,11
	numalias _char		,12
	numalias _se		,13
	numalias _cg		,14
	numalias _voice		,15
	numalias effect		,16	;効果

	numalias tmp		,20
	numalias tmp2		,21
	numalias savestr	,22
	numalias debugstr	,23	;デバッグ用文字列が入る。
					;こいつの文字列設定はエディタが自動で行う。
	numalias textstr	,24	;セーブ用のデフォルトコメント

	numalias old_bg		,30
	numalias old_music	,31
	numalias old_char	,32
	numalias old_se		,33
	numalias old_cg		,34

	numalias mapchar,	50	;文字列生成用ワーク

;100-199までがバッファ何でも使う適当に
	numalias buf		,100
	numalias bufend		,199
;---------------------------------------------------------------------------
;●globals数値型変数エイリアス
;	global変数の場合は先頭にg_をつけること！
	numalias g_hero		,200	;主人公の名前
	numalias g_fname	,219	;主人公の名字

;○コンフィグ関連
	numalias g_touka	,201	;透過の値を保存
	numalias g_initial	,202	;最初の起動か否か
	numalias g_savepage	,203	;セーブ／ロードページ。（１～１０）
	numalias g_vol_voice	,204
	numalias g_vol_bgm	,205	;0でOFF
	numalias g_vol_se	,206
	numalias g_confirm	,207	;1=確認ダイアログを出す、0=出さない
	numalias g_hint		,208	;選択肢ヒントのON/OFF

	numalias g_text_speed	,209
	numalias g_auto_speed	,210

	numalias g_window_mode	,211	;0＝ウィンドウ,1=フルスクリーン
	
	numalias g_charb	,212	;真実の音声ON/OFF
	numalias g_charc	,213	;明海の音声ON/OFF
	numalias g_chard	,214	;小夜子の音声ON/OFF
	numalias g_other	,215	;その他の音声ON/OFF
	numalias g_hse		,216	;Ｈな効果音ON/OFF

	numalias g_skipmode	,217	;スキップモード ０：全て、１：既読
	numalias g_skipstop	,218	;選択肢でスキップ停止 0:しない 1:する
	;219は名字で使う
	numalias g_qr_ok	,220	;クイックリターンが可能かどうか
	numalias g_return_data	,221	;リターンはどこから
	numalias g_return_choice,222	;リターン用

;○シナリオ関連
	numalias g_trueroot	,223	;菜摘シナリオOKならON
	numalias g_makoto_end	,224	;真実エンディングを見た
	numalias g_akemi_end	,225	;明海エンディングを見た
	numalias g_sayoko_end	,226	;小夜子エンディングを見た
	numalias g_natumi_end	,227	;菜摘エンディングを見た
	numalias op02_looked	,228	;OP02のマップを１度見た
	numalias opmovie_looked	,229	;ムービー見たらスキップ可能
;---------------------------------------------------------------------------

;文字列変数301-380はセーブエリアとして使用する
	numalias g_save_slot		,300
	numalias g_save_slot_end	,349

;デバッグ用
	numalias debug_fname	,400
;---------------------------------------------------------------------------
;●リミットの設定
	intlimit g_savepage	,0,4	;0,1,2,3,4ページのみ
	intlimit g_vol_bgm	,0,5
	intlimit g_vol_se	,0,5
	intlimit g_vol_voice	,0,5
	intlimit g_text_speed	,0,5
	intlimit g_auto_speed	,0,5

;:::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
game
	goto	*start
;デバッグ用にスタートは debug_10.txtと go_10.txtに移動してます。
;-------------------------------------------------------------------
*global_initial	;■グローバル変数イニシャライズ（初回のみ）
	for %0=g_save_slot to g_save_slot_end: mov $%0,"－－－未使用－－－": next
	mov $g_hero,"純"
	mov $g_fname,"保科"
	mov %g_touka,3	;ウィンドウの透過度の初期値
	mov %touka,200	;ウィンドウの透過度の初期値
	mov %g_nomegane,0	;眼鏡最初はかけている
	mov %g_gomegane,0	
	mov %g_savepage,0	;セーブページ
	mov %g_vol_bgm,1
	mov %g_vol_SE,2
	mov %g_vol_VOICE,3
	mov %g_text_speed,2
	mov %g_charb,ON
	mov %g_charc,ON
	mov %g_chard,ON
	mov %g_other,ON
	mov %g_hse,ON

	mov %g_trueroot	,OFF
	mov %g_makoto_end,OFF
	mov %g_akemi_end,OFF
	mov %g_sayoko_end,OFF
	mov %g_natumi_end,OFF
	mov %op02_looked,OFF
	mov %opmovie_looked,OFF

	mov %g_hint,ON
	return
;---------------------------------------------------------------------------
*local_initial	;■ローカル変数イニシャライズ
;変数の初期化
	for %0=100 to 199: mov %%0,0:next
	mov $_cg,""
	mov $_bg,""
	mov $_music,""
	mov $_char,""
	mov $_se,""
	mov $_voice,""
	mov %is_adv,0	;タイトル画面なら0/ADV画面なら1/回想だと2
	
;環境周りの変数	
	if %g_vol_bgm=0 mp3vol  0  
	if %g_vol_bgm=1 mp3vol  20 
	if %g_vol_bgm=2 mp3vol  40 
	if %g_vol_bgm=3 mp3vol  60 
	if %g_vol_bgm=4 mp3vol  80 
	if %g_vol_bgm=5 mp3vol 100 

	if %g_vol_SE=0 sevol  0  
	if %g_vol_SE=1 sevol  20 
	if %g_vol_SE=2 sevol  40 
	if %g_vol_SE=3 sevol  60 
	if %g_vol_SE=4 sevol  80 
	if %g_vol_SE=5 sevol 100 

	if %g_vol_VOICE=0 voicevol   0
	if %g_vol_VOICE=1 voicevol  20 
	if %g_vol_VOICE=2 voicevol  40 
	if %g_vol_VOICE=3 voicevol  60 
	if %g_vol_VOICE=4 voicevol  80 
	if %g_vol_VOICE=5 voicevol 100 

	if %g_touka=0 mov %touka,  50
	if %g_touka=1 mov %touka, 100 
	if %g_touka=2 mov %touka, 150 
	if %g_touka=3 mov %touka, 200 
	if %g_touka=4 mov %touka, 250 
	if %g_touka=5 mov %touka, 300 

	if %g_text_speed=0 :textspeed 80
	if %g_text_speed=1 :textspeed 40
	if %g_text_speed=2 :textspeed 20
	if %g_text_speed=3 :textspeed 10
	if %g_text_speed=4 :textspeed 5
	if %g_text_speed=5 :textspeed 0

	if %g_skipmode==ON  : kidokumode 0
	if %g_skipmode==OFF : kidokumode 1

	return

;---------------------------------------------------------------------------
*get_hero_name	;■主人公の名前を取得
	gosub *blackout

	mov $20,"現在の主人公の名前は【"
	add $20,$g_fname
	add $20,"　"
	add $20,$g_hero
	add $20,"】です。"
	len %work2,$tmp : div %work2,2 : mul %work2,22
	mov %work,800 : sub %work,%work2 : div %work,2
	lsp SP_DLG_MES, ":s/22,22,0;#FFFFFF$20",%work,220

	mov $20,"名前を変更しますか？"
	len %work2,$tmp : div %work2,2 : mul %work2,22
	mov %work,800 : sub %work,%work2 : div %work,2
	lsp SP_DLG_MES2,":s/22,22,0;#FFFFFF$20",%work,250

	lsp SP_DLG_YES,":a/2,0,3;sys/dlg_yes.jpg",DLG_YES_X,DLG_YES_Y
	lsp SP_DLG_NO, ":a/2,0,3;sys/dlg_no.jpg", DLG_NO_X, DLG_NO_Y
	print 1
	btndef ""
	spbtn SP_DLG_YES,BTN_YES
	spbtn SP_DLG_NO,BTN_NO


*dlg_get_heron_name_wait
	btnwait %work
	if %work = MOUSE_RBUTTON goto *name_nochange
	if %work = KEY_ESCAPE    goto *name_nochange
	if %work = BTN_YES goto *name_change
	if %work = BTN_NO goto *name_nochange
	goto *dlg_get_heron_name_wait


*name_change
	csp SP_DLG_YES
	csp SP_DLG_NO
	csp SP_DLG_MES
	csp SP_DLG_MES2

	inputstr $g_fname,"主人公の名字を入力してください（全角２文字まで）",4,1
	inputstr $g_hero,"主人公の名前を入力してください（全角４文字まで）",8,1
	repaint

	mov $20,"主人公の名前は【"
	add $20,$g_fname
	add $20,"　"
	add $20,$g_hero
	add $20,"】になりました。"
	len %work2,$tmp : div %work2,2 : mul %work2,22
	mov %work,800 : sub %work,%work2 : div %work,2
	lsp SP_DLG_MES,":s/22,22,0;#FFFFFF$20",%work,250
	print 1
	click
	csp SP_DLG_MES
	repaint
	return
	
*name_nochange
	btndef ""
	csp SP_DLG_YES
	csp SP_DLG_NO
	csp SP_DLG_MES
	csp SP_DLG_MES2
	repaint

	mov $20,"主人公の名前は【"
	add $20,$g_fname
	add $20,"　"
	add $20,$g_hero
	add $20,"】のままです。"
	len %work2,$tmp : div %work2,2 : mul %work2,22
	mov %work,800 : sub %work,%work2 : div %work,2

	lsp SP_DLG_MES,":s/22,22,0;#FFFFFF$20",%work,250
	print 1
	click
	csp SP_DLG_MES
	repaint
	return

;-------------------------------------------------------------------
;■ゲームの終了
;-------------------------------------------------------------------
*dlg_end
 	gosub *click
	lsp SP_DLG,":a;sys/dlg.jpg",0,0:print 1
	lsp SP_DLG_MES,":s/22,20,0;#FFFFFF終了しますか？",320,280
	lsp SP_DLG_YES,":a/2,0,3;sys/dlg_yes.jpg",DLG_YES_X,DLG_YES_Y
	lsp SP_DLG_NO, ":a/2,0,3;sys/dlg_no.jpg", DLG_NO_X, DLG_NO_Y
	print 1
	btndef ""
	spbtn SP_DLG_YES,BTN_YES
	spbtn SP_DLG_NO,BTN_NO

*dlg_end_wait
	btnwait %work
	if %work = MOUSE_RBUTTON goto *go_end
	if %work = KEY_ESCAPE    goto *go_end
	if %work = BTN_YES end
	if %work = BTN_NO goto *go_end
	goto *dlg_end_wait

*go_end
	gosub *se_cancel
	csp SP_DLG
	csp SP_DLG_MES
	csp SP_DLG_YES
	csp SP_DLG_NO
	repaint
	if %is_adv==1 return	;アドベンチャー部分からの呼び出しなら戻る
	goto *title		;そうでなければタイトル画面

;-------------------------------------------------------------------
;■ダイアログ関連の処理
;	Copyright (C) 2002 ちぇりーそふと. All rights reserved.
;-------------------------------------------------------------------
*dlg_title	;■タイトル画面に戻るか？
	lsp SP_DLG,":a;sys/dlg.jpg",0,0:print 1
	lsp SP_DLG_MES,":s/20,22,0;#FFFFFFタイトルに戻りますか？",285,280
	lsp SP_DLG_YES,":a/2,0,3;sys/dlg_yes.jpg",DLG_YES_X,DLG_YES_Y
	lsp SP_DLG_NO, ":a/2,0,3;sys/dlg_no.jpg", DLG_NO_X, DLG_NO_Y
	print 1
	btndef ""
	spbtn SP_DLG_YES,BTN_YES
	spbtn SP_DLG_NO,BTN_NO

*dlg_title_wait	;タイトル画面に戻りますかの入力待ち
	btnwait %work
	if %work = MOUSE_RBUTTON 
	if %work = KEY_ESCAPE    goto *back_game
	if %work = BTN_YES goto *go_title
	if %work = BTN_NO goto *back_game
	goto *dlg_title_wait

*back_game	;キャンセルしてゲームに戻る
	gosub *se_cancel
	csp SP_DLG
	csp SP_DLG_MES
	csp SP_DLG_YES
	csp SP_DLG_NO
	repaint
	return

*go_title	;ＯＫしてタイトル画面へ
	gosub *se_ok
	savegame EXITSAVE		;直前データセーブ
	csp -1
	textoff
	goto *title			;タイトル画面へ
;-------------------------------------------------------------------
*debug_ini	;●moonlit.iniからデータ読み込み、デバッグ情報設定
;デバッグするやいなや
	getini	$tmp,".\moonlit.ini","DEBUG","debug"
	if $tmp=="ON" mov %debug,ON

;ＯＰのムービースキップするか否か
;ムービー再生が出来ない時はこれで。
	getini	$tmp,".\moonlit.ini","MOVIE","skip"
	if $tmp=="ON" mov %skip_movie,ON
	return
;-------------------------------------------------------------------
*debug_load	;EXITSAVEから読み込み
	savefileexist %work,EXITSAVE
	if %work==0 goto *title	;セーブファイルが無ければ何もしない
	gosub *click
	textoff
	gosub *hide_window
	bg black,SYSTEM_EFFECT
	loadgame EXITSAVE
	goto *title	;ここに来るはずはないが、保険
;-------------------------------------------------------------------
*debug_info
	if %debug==OFF return
	bg #008080,BG_EFFECT
	
	wait 50
	gosub *set_message_window
	gosub *set_full_window
	gosub *show_window
	主人公の名前は、$g_fname　$g_hero。
	if %opmovie_looked==ON オープニングムービーはスキップ可能。
	if %opmovie_looked==OFF オープニングムービーはスキップできません。
	if %op02_looked==ON ＯＰ２回目のマップはやめる有効。
	if %op02_looked==OFF ＯＰ２回目のマップは全部みる必要があります。
	\
	if %g_root==MAKOTO && if %g_nomegane==ON 現在は真実ルート。眼鏡無し。
	if %g_root==MAKOTO && if %g_nomegane==OFF 現在は真実ルート。眼鏡あり。
	if %g_root==AKEMI 現在は明海ルート。
	if %g_root==SAYOKO 現在は小夜子ルート。
	if %g_root==NATSUMI 現在は菜摘ルート。
	if %g_trueroot==ON 菜摘ルートへ行けます。
	if %g_trueroot==OFF 菜摘ルートへ行けません。
	\
	真実ルートを見たのは、%g_makoto_end回。
	明海ルートを見たのは、%g_akemi_end回。
	小夜子ルートを見たのは、%g_sayoko_end回。
	菜摘ルートを見たのは、%g_natumi_end回。
	\
	リターン用データは%g_return_choice
	%g_return_dataから読み込みます。\
	\
	タイトルに戻ります\
	gosub *hide_window
	goto *title

;-------------------------------------------------------------------
*debug_goto
	if %debug==OFF return
	inputstr $debugstr,"飛び先のを入力してください。半角で！",20,0

	gosub	*local_initial
	mov	%is_adv,1	;ADVスタート
	mov	%g_qr_ok,ON	;QuickReturnを可能に
	resettimer 
	gosub	*blackout
	waittimer 100
	gosub *speed_val	;メッセージスピード再設定
	gosub *set_message_window
	gosub *show_window
	saveon
	mov $tmp,"*"
	add $tmp,$debugstr
	gosub $tmp

	gosub *hide_window
	goto *title
;-------------------------------------------------------------------

;----------------------------------------------------------------------
;■システムカスタマイズ関連
;	基本的にメッセージウィンドウ周りの処理。
;		
;	※記述時の注意
;		なるべく単文で書く。
;		そのために条件に合わなければ、さっさとreturnすること！
;	Copyright (C) 2002 ちぇりーそふと. All rights reserved.
;----------------------------------------------------------------------
*set_message_window	;■メッセージウィンドウの設定
	setwindow moji_x,moji_y,colum,line,fontsize_x,fontsize_y,margin_x,margin_y,default_speed,1,1,":a;SYS/SYS_MESWIN.JPG",meswindow_x,meswindow_y

	lsph SP_MESWIN,":a;SYS/SYS_MESWIN.jpg",meswindow_x,meswindow_y
	;メッセージウィンドウの枠と文字領域の設定
	erasetextwindow 0
	;エフェクトのときも、ウィンドウは出っぱなし。
	gosub *speed_val
	gosub *touka_val

	;偽ウィンドウ用画像
	lsph SP_WIN,":l;SYS/SYS_WIN.BMP",SITAJI_X,SITAJI_Y,%touka

	;カーソル画像
	lsph SP_CURSOR,	":l/15,100,2;SYS/SYS_CURSOR.BMP",0,0

	;ボタン
if %is_adv==1	lsph SP_QUICKSAVE,  ":a/2,0,3;SYS/SYS_QSAVE.BMP"  ,600,460;
if %is_adv==1	lsph SP_QUICKLOAD,  ":a/2,0,3;SYS/SYS_QLOAD.BMP"  ,680,460;
if %is_adv==1	lsph SP_SAVE,       ":a/2,0,3;SYS/SYS_SAVE.BMP"   ,080,580;save
if %is_adv==1	lsph SP_LOAD,       ":a/2,0,3;SYS/SYS_LOAD.BMP"   ,160,580;load
		lsph SP_GOTITLE,    ":a/2,0,3;SYS/SYS_TITLE.BMP"  ,240,580;TITlEへ
		lsph SP_CONFIG,     ":a/2,0,3;SYS/SYS_CONFIG.BMP" ,320,580;config
if %is_adv==1	lsph SP_RETUREN,    ":a/2,0,3;SYS/SYS_RETURN.BMP" ,400,580;return
		lsph SP_SKIP,	    ":a/2,0,3;SYS/SYS_SKIP.BMP"   ,480,580;skip
		lsph SP_AUTO,       ":a/2,0,3;SYS/SYS_AUTO.BMP"   ,560,580;auto
		return
;---------------------------------------------------------------------------
*set_full_window	;全画面表示でテキスト表示
	setwindow 110,100,COLUM,12,FONTSIZE_X,FONTSIZE_Y,MARGIN_X,8,default_speed,1,1,#FFFFFF,100,60,700,450
	gosub *speed_val
	erasetextwindow 0
	return
;---------------------------------------------------------------------------
*mesbtn	;■メッセージウィンドウのボタンの定義
if %is_adv==1	spbtn	SP_QUICKSAVE,	BTN_QUICKSAVE
if %is_adv==1	spbtn	SP_QUICKLOAD,	BTN_QUICKLOAD
if %is_adv==1	spbtn	SP_SAVE,	BTN_SAVE
if %is_adv==1	spbtn	SP_LOAD,	BTN_LOAD
		spbtn	SP_GOTITLE,	BTN_GOTITLE
		spbtn	SP_CONFIG,	BTN_CONFIG
if %is_adv==1	spbtn	SP_RETUREN,	BTN_RETUREN
		spbtn	SP_SKIP,	BTN_SKIP
		spbtn	SP_AUTO,	BTN_AUTO
		return
;---------------------------------------------------------------------------
*text_lb	;■テキストクリック待ち処理
	btndef ""	;ボタン定義はクリアして
	gosub *mesbtn	;メッセージウィンドウのボタン定義
	gosub *show_cursor

*textbtn_wait	;■クリック待ち
	transbtn	;ボタン画像の透過部分をボタンとして無効にします。
	spclclk		;スペースバーを左クリックと同じ動作にします。
	getpageup	;PAGEUP/DOWNを取得＞ログ
	gettab		;TABを取得
	getcursor	;矢印キーを取得
	getfunction	;F1-F12を取得
	getenter	;Enterを取得
	textbtnwait %work	;テキストボタン待ち命令。何か押されるまで待つ、
	repaint			;押されたままのボタンなどを正しく描き直す
;---------------------------------------------------------------------
if %work==MOUSE_LBUTTON   goto *textbtn_end	;左クリック時、普通のテキスト送り処理
if %work==MOUSE_WHEELDOWN goto *textbtn_end	;ホイールマウス下、普通のテキスト送り処理
;---------------------------------------------------------------------
if %work==MOUSE_RBUTTON goto *_meswin_erase	;右クリック時、ウィンドウ消去処理
if %work==KEY_ESCAPE   goto *_meswin_erase	;ESC時、ウィンドウ消去処理（右クリックと同じ）
;---------------------------------------------------------------------
if %work=MOUSE_WHEELUP goto *_meswin_kaisou	;ホイールマウス上、回想モードへ
if %work==KEY_PAGEUP   goto *_meswin_kaisou	;PAGEアップで回想モード
if %work==KEY_UP       goto *_meswin_kaisou	;;矢印キーの上で回想モード
;---------------------------------------------------------------------
if %work==BTN_QUICKSAVE goto *_meswin_quicksave	;QuickSaveボタンを押したとき
if %work==KEY_F4 	goto *_meswin_quicksave	;F4キーを押したとき
;---------------------------------------------------------------------
if %work==BTN_QUICKLOAD goto *_meswin_quickload	;loadボタンを押したとき
;---------------------------------------------------------------------
if %work==BTN_SKIP	goto *_meswin_skip	;SKIPボタンを押したとき
if %work==KEY_F1	goto *_meswin_skip	;F1を押したとき
;---------------------------------------------------------------------
if %work==BTN_SAVE 	goto *_meswin_save	;SAVEボタンを押したとき
if %work==KEY_F5   	goto *_meswin_save	;F5を押したとき
;---------------------------------------------------------------------
if %work==BTN_LOAD	goto *_meswin_load	;LOADボタンを押したとき
if %work==KEY_F6	goto *_meswin_load	;F6キーを押したとき
;---------------------------------------------------------------------
if %work==BTN_RETUREN	goto *_meswin_qreturn	;returnボタンを押したとき
if %work==KEY_F3	goto *_meswin_qreturn	;F3キーを押した時
;---------------------------------------------------------------------
if %work==BTN_AUTO	goto *_meswin_auto	;autoボタンを押したとき
if %work==KEY_F2	goto *_meswin_auto	;F2キーを押したとき
;---------------------------------------------------------------------
if %work==BTN_CONFIG	goto *_meswin_config	;configボタン
if %work==KEY_F11    	goto *_meswin_config	;F11キーを押したとき
;---------------------------------------------------------------------
if %work==BTN_GOTITLE	goto *_meswin_gotitle	;TITLEボタン
if %work==KEY_F12	goto *_meswin_gotitle	;F12キーを押したとき
;---------------------------------------------------------------------
;いずれのボタンやキーにも当てはまらないのならば
goto *text_lb
;---------------------------------------------------------------------
*textbtn_end	;■クリック処理後の共通ルーチン
	gosub *hide_cursor
	texec
	saveon	;セーブポイントを更新可能にします。
	return
;-----------------------------------------------------------------------------------
;■メッセージウィンドウ周りのボタンの処理
;-----------------------------------------------------------------------------------
*_meswin_erase	;●ウィンドウを消す
	gosub *hide_window
	systemcall windowerase
	gosub *show_window
;	goto *text_lb
	goto *textbtn_end
;-----------------------------------------------------------------------------------
*_meswin_kaisou	;●回想（ログ）
	gosub *hide_cursor
	systemcall lookback
	goto *textbtn_wait
;-----------------------------------------------------------------------------------
*_meswin_quicksave	;●クイックセーブ
	if %is_adv!=1 goto *textbtn_wait
	gosub *quicksave
	goto *textbtn_wait
;-----------------------------------------------------------------------------------
*_meswin_quickload	;●クイックロード
	if %is_adv!=1 goto *textbtn_wait
	gosub *quickload
	goto *textbtn_wait	
;-----------------------------------------------------------------------------------
*_meswin_skip		;●スキップ
	gosub *click
	systemcall skip
	goto *textbtn_end
;-----------------------------------------------------------------------------------
*_meswin_save		;●セーブ
	if %is_adv!=1 goto *text_lb 
	gosub *click
	gettext $textstr	;saveルーチンで使う
	gosub *hide_window
	gosub *save
	gosub *show_window
	goto *text_lb 
;-----------------------------------------------------------------------------------
*_meswin_load	;●ロード
	if %is_adv!=1 goto *text_lb
	gosub *click
	gosub *hide_window
	gosub *load
	;ロードをキャンセルしたときに戻ってくる。
	gosub *show_window
	goto *text_lb
;-----------------------------------------------------------------------------------
*_meswin_qreturn	;●クイックリターン
	if %is_adv!=1 goto *text_lb
	gosub *quickreturn
	;失敗した場合のみ（一度も選択肢が出てない）戻ってくる
	goto *text_lb
;-----------------------------------------------------------------------------------
*_meswin_auto		;●オートモード
	gosub *click
	menu_automode
	goto *textbtn_end
;-----------------------------------------------------------------------------------
*_meswin_config	;●ＣＯＮＦＩＧ画面
	gosub *click
	gosub *hide_window
	gosub *config		;ボタン定義破壊
	gosub *show_window
	goto *text_lb 
;-----------------------------------------------------------------------------------
*_meswin_gotitle	;●タイトル画面へ
	gosub *click
	gosub *dlg_title
	;ダイアログでNOを選択して、結局タイトル画面に戻らなかった
	goto *textbtn_wait
;-----------------------------------------------------------------------------------
;■メッセージウィンドウ用サブルーチン
;-----------------------------------------------------------------------------------
*save_cursor	;○カーソル位置を保存
;	if %_save_x != 0 return
	getcursorpos %_save_x,%_save_y	;現在の文字表示位置を取得(%_xにx座標,%_yにy座標)
	return
;--------------------------------------------
*load_cursor	;○カーソル位置を読み込み
	amsp SP_CURSOR,%_save_x,%_save_y
	vsp SP_CURSOR,1 ;カーソル表示
	return
;--------------------------------------------
*hide_cursor	;○カーソルを消す
	vsp SP_CURSOR,0
	print 1
	return
;--------------------------------------------
*show_cursor	;○カーソルを表示
	if %_save_x!=0  mov %_save_x,0 : mov %_save_y,0 : return
	getcursorpos %_x,%_y	;現在の文字表示位置を取得(%_xにx座標,%_yにy座標)
	add %_x,2	;ちょっとXの位置を微調整
	add %_y,4	;ちょっとYの位置を微調整
	amsp SP_CURSOR,%_x,%_y
	vsp SP_CURSOR,1 ;カーソル表示
	return
;--------------------------------------------
*hide_window	;○メッセージウィンドウを消す
;		gettext $textstr
;		textclear
		gosub *save_cursor
		vsp SP_WIN	,0
		vsp SP_CURSOR	,0
if %is_adv==1	vsp SP_QUICKSAVE,0
if %is_adv==1	vsp SP_QUICKLOAD,0
if %is_adv==1	vsp SP_SAVE	,0
if %is_adv==1	vsp SP_LOAD	,0
		vsp SP_SKIP	,0
if %is_adv==1	vsp SP_RETUREN	,0
		vsp SP_AUTO	,0
		vsp SP_CONFIG	,0
		vsp SP_GOTITLE	,0
		vsp SP_MESWIN	,0
		textoff
		repaint
		return
;--------------------------------------------
*show_window	;○メッセージウィンドウを表示
		amsp SP_WIN,sitaji_x,sitaji_y,%touka
		vsp SP_WIN	,1
if %is_adv==1	vsp SP_QUICKSAVE,1
if %is_adv==1	vsp SP_QUICKLOAD,1
if %is_adv==1	vsp SP_SAVE	,1
if %is_adv==1	vsp SP_LOAD	,1
		vsp SP_SKIP	,1
if %is_adv==1	vsp SP_RETUREN	,1
		vsp SP_AUTO	,1
		vsp SP_CONFIG	,1
		vsp SP_GOTITLE	,1
		vsp SP_MESWIN	,1
		texton
		repaint
;		$text_log
		return
;--------------------------------------------
;--------------------------------------------
*log_mode	;○回想モード
	gosub *hide_cursor	;カーソルを消す
	systemcall lookback 
	return
;--------------------------------------------
*quicksave	;○クイックセーブ
	savegame QUICKSAVE
	gosub *click
	return
;--------------------------------------------
*quickload	;○クイックロード
	savefileexist %work,QUICKSAVE
	if %work==0 return	;クイックセーブファイルが無ければ何もしない
	gosub *click
	textoff
	gosub *hide_window
	bg black,SYSTEM_EFFECT
	loadgame QUICKSAVE
	return
;--------------------------------------------
*quickreturn	;○リターン機能の実現
	savefileexist %work,RETURNSAVE
	if %work==0 return
	gosub *click		;クリック音を鳴らして
	stop
;	dwavestop CH_SE
;	dwavestop CH_VOICE
	gosub *hide_window
	bg black,SYSTEM_EFFECT
	loadgame RETURNSAVE	;リターン用のセーブからロードしなおし
;	loadgame %g_return_data	;リターン用のセーブからロードしなおし
	return

;---------------------------------------
*hintsave	;○リターン用のセーブ
	if %g_qr_ok==OFF return
	savegame RETURNSAVE
	return	

	if %work==0 mov %g_return_choice,0
	if %g_return_choice==0 goto *hintsave_return
	if %g_return_choice==1 goto *hintsave_pre

;preの後
	savegame RETURNSAVE
	mov %g_return_choice,1	;次はpre
	return

*hintsave_pre	;一度でもリターンが有効になったとき
	savegame PRESAVE
	mov %g_return_choice,2
	return

*hintsave_return	;一度もリターンが来てないとき
	savegame RETURNSAVE
	mov %g_return_choice,1	;次はpre
	return
;----------------------------------------------------------------------------
;■選択肢の処理
;----------------------------------------------------------------------------
*customsel	;■選択肢カスタマイズ
;この辺りは今後の課題 textbtnwaitあたりで実現すりゃいいんだが…
	skipoff			:;スキップ解除
;---------------------------------------
*csel_lb	;■選択肢クリック待ち
	btndef ""
	gosub *mesbtn		;共通のシステムボタン定義ルーチンを呼びます。
	getcselnum %work	;いくつの選択肢があったかを取得します
	getcursorpos %_x,%_y	;カーソル位置を_xと_yに取得
	cselbtn 0,BTN_CSEL0,%_x,%_y	;cselbtnで選択肢ボタンを作る
	;セレクト番号（0からインデックス）、ボタン番号、x座標,y座標
		   add %_y,26            :cselbtn 1,BTN_CSEL1,%_x,%_y
	if %work>2 sub %_y,26:add %_x,300:cselbtn 2,BTN_CSEL2,%_x,%_y
	if %work>3 add %_y,26            :cselbtn 3,BTN_CSEL3,%_x,%_y
;	if %work>4 add %_y,30:cselbtn 4,BTN_CSEL4,%_x,%_y

*csel_loop
	spclclk	;スペースバーを左クリックと同じ動作にします。
	getpageup
	gettab
	getcursor
	getfunction
	getenter
	selectbtnwait %work		;csel時のボタン命令です。
	repaint

;---------------------------------------------------------------------
if %work=MOUSE_RBUTTON goto *_csel_erase	;右クリック時、ウィンドウ消去処理
if %work==KEY_ESCAPE   goto *_csel_erase	;ESC時、ウィンドウ消去処理
;---------------------------------------------------------------------
if %work=MOUSE_WHEELUP goto *_csel_kaisou	;ホイールマウス上、回想モードへ
if %work==KEY_PAGEUP   goto *_csel_kaisou	;PAGEアップで回想モード
if %work==KEY_UP       goto *_csel_kaisou	;;矢印キーの上で回想モード
;---------------------------------------------------------------------
if %work==BTN_QUICKSAVE goto *_csel_quicksave	;saveボタンを押したとき
if %work==KEY_F4 	goto *_csel_quicksave	;F4キーを押したとき
;---------------------------------------------------------------------
if %work==BTN_QUICKLOAD goto *_csel_quickload	;QuickLoadボタンを押したとき
;---------------------------------------------------------------------
if %work==BTN_SAVE 	goto *_csel_save	;SAVEボタンを押したとき
if %work==KEY_F5   	goto *_csel_save	;F5を押したとき
;---------------------------------------------------------------------
if %work==BTN_LOAD	goto *_csel_load	;LOADボタンを押したとき
if %work==KEY_F6	goto *_csel_load	;F6を押したとき
;---------------------------------------------------------------------
if %work==BTN_RETUREN	goto *_csel_qreturn 	;returnボタンを押したとき
if %work==KEY_F3	goto *_csel_qreturn 	;F3を押したとき
;---------------------------------------------------------------------
;skipとautoボタンは選択肢では無効
;---------------------------------------------------------------------
if %work==BTN_CONFIG	goto *_csel_config	;configボタン
if %work==KEY_F11    	goto *_csel_config	;F11を押したとき
;---------------------------------------------------------------------
if %work==BTN_GOTITLE	goto *_csel_gotitle	;TITLEボタン
if %work==KEY_F12	goto *_csel_gotitle	;F12でタイトル画面に戻るか訪ねる
;---------------------------------------------------------------------
if %work>=BTN_CSEL0 & %work<=BTN_CSEL4 goto *csel_goto	;実際の選択肢を実行
;---------------------------------------------------------------------
goto *csel_loop	;ここにくるのはボタン・選択肢以外をクリックしたとき
;---------------------------------------------------------------------
*csel_goto	;選択肢の飛び先へ
	sub %work,BTN_CSEL0
;リターンデータ更新
;0のときはRETRUNSAVEから読むから何もしない（初回のみ）
;if %g_return_choice==1	mov %g_return_data,RETURNSAVE
;if %g_return_choice==2	mov %g_return_data,PRESAVE
	saveon
	cselgoto %work	;cselgotoは、選択した番号の通りにジャンプします。インデックスは0からです。
;-----------------------------------------------------------------------------------
;■選択肢のときのボタンの処理
;-----------------------------------------------------------------------------------
*_csel_erase	;●ウィンドウを消す
	gosub *hide_window
	systemcall windowerase
	gosub *show_window
	goto *csel_lb
;-----------------------------------------------------------------------------------
*_csel_kaisou	;●回想（ログ）
	gosub *hide_cursor
	systemcall lookback
	goto *csel_loop
;-----------------------------------------------------------------------------------
*_csel_quicksave	;●クイックセーブ
	if %is_adv!=1 goto *csel_loop
	gosub *quicksave
	goto *csel_loop
;-----------------------------------------------------------------------------------
*_csel_quickload	;●クイックロード
	if %is_adv!=1 goto *csel_loop	
	gosub *quickload
	goto *csel_loop	
;-----------------------------------------------------------------------------------
*_csel_save		;●セーブ
	if %is_adv!=1 goto *csel_lb
	gosub *click
	gettext $textstr	;saveルーチンで使う
	gosub *hide_window
	gosub *save
	gosub *show_window
	goto *csel_lb 
;-----------------------------------------------------------------------------------
*_csel_load	;●ロード
	if %is_adv!=1 goto *csel_lb
	gosub *click
	gosub *hide_window
	gosub *load
	;ロードをキャンセルしたときに戻ってくる。
	gosub *show_window
	goto *csel_lb
;-----------------------------------------------------------------------------------
*_csel_qreturn	;●クイックリターン
	if %is_adv!=1 goto *csel_loop
	gosub *quickreturn
	;失敗した場合のみ（一度も選択肢が出てない）戻ってくる
	goto *csel_loop
;-----------------------------------------------------------------------------------
*_csel_config	;●ＣＯＮＦＩＧ画面
	gosub *click
	gosub *hide_window
	gosub *config		;ボタン定義破壊
	gosub *show_window
	goto *csel_lb 
;-----------------------------------------------------------------------------------
*_csel_gotitle	;●タイトル画面へ
	gosub *click
	gosub *dlg_title
	;ダイアログでNOを選択して、結局タイトル画面に戻らなかった
	goto *csel_lb


; －－－－－－－－－－－－－－－－－－－－－－－－－－－－－－－－－－
;	ユーティリティ
; －－－－－－－－－－－－－－－－－－－－－－－－－－－－－－－－－－
;-------------------------------------------------------------------
;■オープニングムービーの再生
;-------------------------------------------------------------------
*OPMOVIE
	skipoff
	gosub *sestop
	gosub *musicstop
	savegame MOVIESAVE	;念のためにオープニングムービー直前でセーブ
	saveoff
	gosub *hide_window
	gosub *blackout
	wait 200
	
;	avi "OP.AVI",1
;	mpegplay "OP.AVI",1
	gosub	*optitle
	gosub	*whiteout
if %opmovie_looked==0 mpegplay "OP.AVI",0 : mov %opmovie_looked,1 : jumpf
if %opmovie_looked==1 mpegplay "OP.AVI",1
~
	gosub	*blackout
	wait	200
	gosub *set_message_window
	gosub *show_window
	saveon
	return
	
*optitle
	dwave CH_SE,"SE/ZLOGO.WAV"
	lsp SP_MOVE,":c/6,0,3;sys/ed_ani.jpg",0,0
	wait 100
	cell SP_MOVE,8 : print 1 : wait 100
	cell SP_MOVE,7 : print 1 : wait 100
	cell SP_MOVE,6 : print 1 : wait 100
	cell SP_MOVE,5 : print 1 : wait 100
	cell SP_MOVE,4 : print 1 : wait 100
	cell SP_MOVE,3 : print 1 : wait 100
	cell SP_MOVE,2 : print 1 : wait 100
	cell SP_MOVE,1 : print 1 : wait 100
	cell SP_MOVE,0 : print 1 : wait 100
	wait 500
	cell SP_MOVE,0 : print 1 : wait 100
	cell SP_MOVE,1 : print 1 : wait 100
	cell SP_MOVE,2 : print 1 : wait 100
	cell SP_MOVE,3 : print 1 : wait 100
	cell SP_MOVE,4 : print 1 : wait 100
	cell SP_MOVE,5 : print 1 : wait 100
	cell SP_MOVE,6 : print 1 : wait 100
	cell SP_MOVE,7 : print 1 : wait 100
	cell SP_MOVE,8 : print 1 : wait 100
	wait 200
	csp SP_MOVE
	return

;-------------------------------------------------------------------
;■エンディング
;-------------------------------------------------------------------
*ENDROLL	;■エンディングのスタッフロール
;	numalias ending,	104	;今回のエンディングは誰やねん？

	gosub *hide_window
	lookbackflush	;回想クリア
	textclear	;表示されているテキストを消す
	gosub *sestop
	gosub *musicstop
	csp -1
	saveoff
	if %ending==MAKOTO_END_MEGANE goto *ed_makoto_megane
	if %ending==MAKOTO_END_CONTACT goto *ed_makoto_contact
	if %ending==AKEMI_HAPPY_END goto *ed_AKEMI
	if %ending==AKEMI_NORMAL_END goto *ed_BAD
	if %ending==SAYOKO_END goto *ed_SAYOKO
	if %ending==NATSUMI_END goto *ed_NATSUMI
	if %ending==BAD_END goto *ed_BAD

*ed_BAD	;バッドエンド
	gosub *edtitle
	mov $_music,"04": gosub *music
	bg "sys/BADEND.jpg",ENDCG_EFFECT
	goto	*ending_end

*ed_makoto_megane	;真実：眼鏡
if %g_makoto_end>1 trap *ending_end
	mov $_music,"11": gosub *music
	bg "sys/ED_MAKOTO4.jpg",ENDCG_EFFECT
	bg "sys/ED_MAKOTO3.jpg",ENDCG_EFFECT
	bg "sys/ED_MAKOTO2.jpg",ENDCG_EFFECT
	bg "sys/ED_MAKOTO1.jpg",ENDCG_EFFECT
	goto *ed_kyotyu

*ed_makoto_contact
;真実：コンタクト
	mov $_music,"11": gosub *music
	bg "sys/ED_MAKOTO4_.jpg",ENDCG_EFFECT
	bg "sys/ED_MAKOTO3_.jpg",ENDCG_EFFECT
	bg "sys/ED_MAKOTO2_.jpg",ENDCG_EFFECT
	bg "sys/ED_MAKOTO1_.jpg",ENDCG_EFFECT
	goto *ed_kyotyu

*ed_akemi
;あけみたん
	mov $_music,"11": gosub *music
	bg "sys/ED_AKEMI4.jpg",ENDCG_EFFECT
	bg "sys/ED_AKEMI3.jpg",ENDCG_EFFECT
	bg "sys/ED_AKEMI2.jpg",ENDCG_EFFECT
	bg "sys/ED_AKEMI1.jpg",ENDCG_EFFECT
	goto *ed_kyotyu

*ed_sayoko
;小夜子
	mov $_music,"11": gosub *music
	bg "sys/ED_SAYOKO4.jpg",ENDCG_EFFECT
	bg "sys/ED_SAYOKO3.jpg",ENDCG_EFFECT
	bg "sys/ED_SAYOKO2.jpg",ENDCG_EFFECT
	bg "sys/ED_SAYOKO1.jpg",ENDCG_EFFECT
	goto *ed_kyotyu

*ed_natsumi
;菜摘先生
	mov $_music,"11": gosub *music
	bg "sys/ED_NATSUMI4.jpg",ENDCG_EFFECT
	bg "sys/ED_NATSUMI3.jpg",ENDCG_EFFECT
	bg "sys/ED_NATSUMI2.jpg",ENDCG_EFFECT
	bg "sys/ED_NATSUMI1.jpg",ENDCG_EFFECT
	goto *ed_kyotyu

*ed_kyotyu
	mov %work,2000
	bg white,END_EFFECT 
	bg "sys/ED_STF01.jpg",END_EFFECT : delay %work
	bg "sys/ED_STF02.jpg",END_EFFECT : delay %work
	bg "sys/ED_STF03.jpg",END_EFFECT : delay %work
	bg "sys/ED_STF04.jpg",END_EFFECT : delay %work
	bg "sys/ED_STF05.jpg",END_EFFECT : delay %work
	bg "sys/ED_STF06.jpg",END_EFFECT : delay %work
	bg "sys/ED_STF07.jpg",END_EFFECT : delay %work
	bg "sys/ED_STF08.jpg",END_EFFECT : delay %work
	bg "sys/ED_STF09.jpg",END_EFFECT : delay %work
	bg "sys/ED_STF10.jpg",END_EFFECT : delay %work
	bg "sys/ED_STF11.jpg",END_EFFECT : delay %work
	bg "sys/ED_STF12.jpg",END_EFFECT : delay %work
