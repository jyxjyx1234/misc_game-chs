*D71	; ■ファイル開始のラベル
	mov $debugstr,"■D71 " : gosub *debugout
;■■■「月光に濡れる教室で、僕は。」台本：●帰宅：小夜子と会話：D71
;━━━━━━━━━━━━━━
;●帰宅：小夜子と会話
	gosub *blackout

	;--BGM;----------------------------------
	mov $_music,"14": gosub *out
;BGM:愛
	;--背景;----------------------------------
	mov $_bg,"BG032B"
	mov $debugstr,"ＢＧ：BG032B"
	gosub *out	;画面に出力
;ＢＧ：BG032B;公園

	僕は小夜子と一緒に公園に来ていた。
	どうも帰りのコースはいつもここだな。\

	寒いんだけど。なんでこんなクソ寒いのに
	カップルって外で２人で話してんだろうって
	そう思ってたけど。\

	でも、あれだよな。帰りたくないんだ。
	一緒に居たいんだ。それだけなんだ。\

	【$g_hero】
	飲み物買ってくるな。
	ホットウーロンでいいんだっけ。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TDB"
	mov $debugstr,"立ち：TDB "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"DD7100"
	mov $debugstr,"音声：DD7100"
	gosub *vo

	【小夜子】
	はい。\
	dwavestop CH_VOICE	;DD7100

	缶コーヒーとウーロン茶を持って
	ベンチに行くと
	小夜子が、空をぼんやり見つめていた。\
	;--背景;----------------------------------
	mov $_bg,"MOONA01"
	mov $debugstr,"ＢＧ：MOONA01 "
	gosub *out	;画面に出力

	３月の夜空の、月。\

	【$g_hero】
	また、しちゃったな。\

	ごめんと、謝ることももうできない。
	僕はたしかに小夜子が欲しいのだし
	小夜子も僕がほしいのだと思う。けれど…。\

	【$g_hero】
	もう少し理性はたらかないのかな。僕は。
	なんで、しちまうのかな。\
	;-音声;----------------------------------
	mov $_voice,"DD7101"
	mov $debugstr,"音声：DD7101"
	gosub *vo

	【小夜子】
	先輩だけが悪い訳じゃないです。\
	dwavestop CH_VOICE	;DD7101

	【$g_hero】
	でもさ「天使」なんて名前のピーピングトムが
	いるだろうにさ。探るどころじゃないもんな。\

	【$g_hero】
	見られてる…から余計に興奮するのかな。
	って、これはマズイ性癖になっちゃいそうだな。\
	;--背景;----------------------------------
	mov $_bg,"BG032B"
	mov $debugstr,"ＢＧ：BG032B"
	gosub *out	;画面に出力
;;公園

	そう言うと、小夜子はじっと僕を見た。\

	【$g_hero】
	何？\

	僕はコーヒーを口に運びながら答えた。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TDF"
	mov $debugstr,"立ち：TDF "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"DD7102"
	mov $debugstr,"音声：DD7102"
	gosub *vo

	【小夜子】
	…先輩は、私だけだったら
	欲しいと思いませんか？\
	dwavestop CH_VOICE	;DD7102

	【$g_hero】
	ぶっ！！\

	思わず吹き出した。
	何をいきなり言いだすんだ小夜子のヤツは。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TDG"
	mov $debugstr,"立ち：TDG "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"DD7103"
	mov $debugstr,"音声：DD7103"
	gosub *vo

	【小夜子】
	「天使」に言われてるから、
	してるだけですか？\
	dwavestop CH_VOICE	;DD7103

	【$g_hero】
	ち、ち、ちがうって！！\

	いくらなんでも好きでもないのと、
	何回もするか。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TDF"
	mov $debugstr,"立ち：TDF "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"DD7104"
	mov $debugstr,"音声：DD7104"
	gosub *vo

	【小夜子】
	どういう風に？\
	dwavestop CH_VOICE	;DD7104

	【$g_hero】
	僕は…その…小夜子のことが…。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TDF"
	mov $debugstr,"立ち：TDF "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"DD7105"
	mov $debugstr,"音声：DD7105"
	gosub *vo

	【小夜子】
	私のことが？\
	dwavestop CH_VOICE	;DD7105

	【$g_hero】
	その………あの………。\

	言葉が出てこない。
	いや、言えるんだけど。シラフでは厳しい。\

	僕はもう何を言っていいのか
	わからなくて、小夜子の肩をぐいっと
	抱き寄せると、キスをした。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TDD"
	mov $debugstr,"立ち：TDD "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"DD7106"
	mov $debugstr,"音声：DD7106"
	gosub *vo

	【小夜子】
	先輩。\
	dwavestop CH_VOICE	;DD7106
	gosub *clear_char

	さっきまでしてた、貪るようなキスではなくて。
	唇を重ねるだけのキスだった。\

	【$g_hero】
	好きだよ。好きに決まってるだろ。好きじゃ
	なくても、セックスはするかもしんないけど。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TDG"
	mov $debugstr,"立ち：TDG "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"DD7107"
	mov $debugstr,"音声：DD7107"
	gosub *vo

	【小夜子】
	はい…。\
	dwavestop CH_VOICE	;DD7107

	【$g_hero】
	好きじゃなければ話しないだろ。
	手、繋がないだろ。キスしないだろ。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TDF"
	mov $debugstr,"立ち：TDF "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"DD7108"
	mov $debugstr,"音声：DD7108"
	gosub *vo

	【小夜子】
	…うれしい。\
	dwavestop CH_VOICE	;DD7108

	僕は、缶コーヒーを持っているのと反対側の手を
	そっと小夜子の手に絡めた。\
	gosub *clear_char

	手袋をしない小夜子の手はあいかわらず冷たい。
	温まらないかなと思って、指を絡める。\

	小さい小夜子の手は、僕の手の中にすっぽり
	収まってしまうようで。僕はそういう風に
	小夜子を守れたらいいのにな、とか思うのだ。\

	その割に、自分のことさえ
	ろくにできやしないんだけど。本当に。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TDA"
	mov $debugstr,"立ち：TDA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"DD7109"
	mov $debugstr,"音声：DD7109"
	gosub *vo

	【小夜子】
	私、先輩に利用されてるだけでもいいって
	思うんです。だって、それでうれしいから。\
	dwavestop CH_VOICE	;DD7109

	小夜子は顔をあげて、僕を見つめて
	透き通るような声で、ただ、そう言った。\

	そこには悪意も悲しみも、そう言った含みは
	何もなくて、事実をきちんと述べている
	小夜子の姿があった。\

	だから僕は、小夜子の言葉をわかりたいと
	思った。全部は無理でも、出来る限り。\

	【$g_hero】
	うれしい？\
	;--立ちキャラ;----------------------------------
	mov $_char,"TDJ"
	mov $debugstr,"立ち：TDJ "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"DD7110"
	mov $debugstr,"音声：DD7110"
	gosub *vo

	【小夜子】
	「人生においてもっとも不幸なことは、誰からも
	何からも利用されないことである」って。\
	dwavestop CH_VOICE	;DD7110

	【$g_hero】
	それ覚えがあるな。
	…えっとヴォネガットだっけ。\

	アメリカのＳＦ作家だ。僕は彼の話が好きだ。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TDC"
	mov $debugstr,"立ち：TDC "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"DD7111"
	mov $debugstr,"音声：DD7111"
	gosub *vo

	【小夜子】
	前に先輩が読んでたから、読んでみたんです。
	私、それを読んで、そんなのイヤだって思った。\
	dwavestop CH_VOICE	;DD7111
	;--立ちキャラ;----------------------------------
	mov $_char,"TDE"
	mov $debugstr,"立ち：TDE "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"DD7112"
	mov $debugstr,"音声：DD7112"
	gosub *vo

	【小夜子】
	だれからも利用されたくないし、
	利用したくなんかないって思ってました。\
	dwavestop CH_VOICE	;DD7112

	【$g_hero】
	今は？\

	小夜子は、ちょっとだけ笑った。胸のどこかが
	くすぐったくなるような優しい笑みだった。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TDG"
	mov $debugstr,"立ち：TDG "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"DD7113"
	mov $debugstr,"音声：DD7113"
	gosub *vo

	【小夜子】
	先輩になら、利用してほしい。\
	dwavestop CH_VOICE	;DD7113

	僕は小夜子を見つめた。
	絡めた指をぎゅっとにぎった。\

	【$g_hero】
	あのさ、それって
	よく似てることを言ってる人がいてさ。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TDA"
	mov $debugstr,"立ち：TDA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"DD7114"
	mov $debugstr,"音声：DD7114"
	gosub *vo

	【小夜子】
	はい。\
	dwavestop CH_VOICE	;DD7114

	【$g_hero】
	もっとも不幸なことは、
	貧しいことそれ自体ではなく、\

	【$g_hero】
	だれからも必要にされていないと感じる孤独に
	あるのです…って。マザー・テレサが言ってた。\

	【$g_hero】
	前に、新聞のコラムで読んだんだけどさ。\

	マザー・テレサっていうのは、ノーベル平和賞も
	もらったひとで。インドでずっと貧しい人々への
	奉仕をし続けてた、えらいひとだ。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TDA"
	mov $debugstr,"立ち：TDA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"DD7115"
	mov $debugstr,"音声：DD7115"
	gosub *vo

	【小夜子】
	似てますね。\
	dwavestop CH_VOICE	;DD7115

	【$g_hero】
	同じじゃないかな。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TDB"
	mov $debugstr,"立ち：TDB "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"DD7116"
	mov $debugstr,"音声：DD7116"
	gosub *vo

	【小夜子】
	そうですね。\
	dwavestop CH_VOICE	;DD7116

	伝えたい。そう思う。
	僕がここに居ることを、小夜子に伝えたい。\

	僕に、小夜子が居てくれて、
	うれしいと思う気持ちを伝えたい。\

	ひとりぼっちじゃなくて。僕がいる。
	ひとりだけじゃなくて。君が居る。\

	さっきしたみたいな、セックスは気持ちいい。
	僕は快楽に弱い人間で、そういうのも好きだ。\

	だけど、それだけじゃ伝わらないから。
	君に、伝えたいから。いろんなことを。\
	gosub *clear_char

	【$g_hero】
	そっか。\

	だから、みんな話をしたり、歌を唄ったり
	絵を描いたり、キスをしたりするのか。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TDD"
	mov $debugstr,"立ち：TDD "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"DD7117"
	mov $debugstr,"音声：DD7117"
	gosub *vo

	【小夜子】
	先輩？\
	dwavestop CH_VOICE	;DD7117

	【$g_hero】
	いや…えっと…その…。僕、くだらない話
	書くの好きなんだけどさ。\

	そもそも今回の出来事のきっかけはそれだ。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TDA"
	mov $debugstr,"立ち：TDA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"DD7118"
	mov $debugstr,"音声：DD7118"
	gosub *vo

	【小夜子】
	ええ、知ってます。\
	dwavestop CH_VOICE	;DD7118

	【$g_hero】
	なんで書いてるのかわかんなかったし
	趣味にもならないような、低レベルのもんだけど。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TDC"
	mov $debugstr,"立ち：TDC "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"DD7119"
	mov $debugstr,"音声：DD7119"
	gosub *vo

	【小夜子】
	そんなこと、ないです。\
	dwavestop CH_VOICE	;DD7119

	【$g_hero】
	ん…。でも、ヘタでもいいから、
	なんだか書きたいな。\

	うまく言えない気持ちを伝えたい。
	何か書くことで表せるのなら、そうしてみたい。
	君への気持ちを伝えたい。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TDA"
	mov $debugstr,"立ち：TDA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"DD7120"
	mov $debugstr,"音声：DD7120"
	gosub *vo

	【小夜子】
	書いてください。見てみたいです。\
	dwavestop CH_VOICE	;DD7120

	【$g_hero】
	うん。小夜子に見せたい。\

	きっとすごく恥ずかしいけど
	たぶんそれがラブレターってやつなんだと思う。\

	【$g_hero】
	そろそろ行こうか。
	コーヒー飲み終わっちゃった。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TDB"
	mov $debugstr,"立ち：TDB "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"DD7121"
	mov $debugstr,"音声：DD7121"
	gosub *vo

	【小夜子】
	はい。\
	dwavestop CH_VOICE	;DD7121

	僕は自分のコートのポケットに、
	握りしめている小夜子の手をつっこませた。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TDF"
	mov $debugstr,"立ち：TDF "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"DD7122"
	mov $debugstr,"音声：DD7122"
	gosub *vo

	【小夜子】
	先輩？\
	dwavestop CH_VOICE	;DD7122

	【$g_hero】
	少しは温かいだろ。駅まで送るから。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TDB"
	mov $debugstr,"立ち：TDB "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"DD7123"
	mov $debugstr,"音声：DD7123"
	gosub *vo

	【小夜子】
	…はい。\
	dwavestop CH_VOICE	;DD7123
	gosub *blackout

	return	;----------------------------------
;---D71  END -----
