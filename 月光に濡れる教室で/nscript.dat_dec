	mov $debugstr,"音声：DD4406"
	gosub *vo

	【小夜子】
	それでも確かめたくなるんです。
	私の全部を見ても、平気なのかどうか。でも。\
	dwavestop CH_VOICE	;DD4406

	【$g_hero】
	でも？\
	;--立ちキャラ;----------------------------------
	mov $_char,"TDG"
	mov $debugstr,"立ち：TDG "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"DD4407"
	mov $debugstr,"音声：DD4407"
	gosub *vo

	【小夜子】
	誰だってみんな、自分の都合のいいものが
	好きだから、思ってるものと違うと怒るんです。\
	dwavestop CH_VOICE	;DD4407

	【$g_hero】
	それって…さっきのさ、丹羽ってヤツとか
	あの子たちのこと？\
	;--立ちキャラ;----------------------------------
	mov $_char,"TDJ"
	mov $debugstr,"立ち：TDJ "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"DD4408"
	mov $debugstr,"音声：DD4408"
	gosub *vo

	【小夜子】
	…そうですね…。それもあるし…。
	みんな、そういうものじゃないかって。\
	dwavestop CH_VOICE	;DD4408

	それは僕にはよく判る言葉だった。
	僕は、いつだって兄さんと比べられるから。\

	多分、小夜子もそういう経験があるんだろうな。
	「自分ではない何か」で、そうやって
	勝手にラベルを貼られた経験が。\

	【$g_hero】
	小さい頃さ、僕、絵描くの好きでさ。
	っていっても、ラクガキみたいなもんだけど。\
