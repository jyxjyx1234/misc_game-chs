	mov $debugstr,"音声：XB0404"
	gosub *vo

	【百合恵先生】
	あとで警察のひとが事情聴取に来るから。\
	dwavestop CH_VOICE	;XB0404

	【$g_hero】
	事情聴取？　じ、事件だったんですか？\
	;--立ちキャラ;----------------------------------
	mov $_char,"TIA"
	mov $debugstr,"立ち：TIA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
