	mov $debugstr,"立ち：TPA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"YOP2300"
	mov $debugstr,"音声：YOP2300 "
	gosub *vo

	【二階堂校長】
	おや、藍田先生。\
	dwavestop CH_VOICE	;YOP2300 

	【$g_hero】
	（うわ！やなの来たなぁ…）\
	;--立ちキャラ;----------------------------------
	mov $_char,"TED"
	mov $debugstr,"立ち：TED "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XOP2301"
	mov $debugstr,"音声：XOP2301 "
	gosub *vo

	【菜摘先生】
	二階堂校長。\
	dwavestop CH_VOICE	;XOP2301 

	【$g_hero】
	校長先生、こんにちは。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TPE"
	mov $debugstr,"立ち：TPE "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"YOP2302"
	mov $debugstr,"音声：YOP2302 "
	gosub *vo

	【二階堂校長】
	ふぅむ、特定の学生とあまり親しくするのは
	好ましいことじゃありませんなぁ。\
	dwavestop CH_VOICE	;YOP2302 

	あ～、やっぱりイヤなこと言う。
	親しいも何も廊下で話してるだけじゃないか。\

	それを言うなら、菜摘先生を視姦するみたいに
	ねっとりした視線でじろじろ見るのよせって。\

	うちの学園のハゲ校長（そう呼ばれてる）は、
	見事なぐらいにステロタイプのエロ親父で
	なんでセクハラで訴えられないのか疑問だ。\

	お年頃の僕より、飢えた目つきして
	どうすんだよ。まったく。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TEC"
	mov $debugstr,"立ち：TEC "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XOP2303"
	mov $debugstr,"音声：XOP2303 "
	gosub *vo

	【菜摘先生】
	…すみません。\
	dwavestop CH_VOICE	;XOP2303 

	別に菜摘先生が謝る事じゃないのに。
	何かっていうと菜摘先生に絡んでるんだよな。\

	まあ、そういう先生も学生も多いけど。
	美人でかわいくて優しいなんて大変だ。\
;台詞では「彼」にしてください。
;おお、君は、あの「彼」の弟さんだったね。
	;--立ちキャラ;----------------------------------
	mov $_char,"TPB"
	mov $debugstr,"立ち：TPB "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"YOP2304"
	mov $debugstr,"音声：YOP2304 "
	gosub *vo

	【二階堂校長】
	わかってくれればいいんですよ。
	おお、君は、あの$g_fname君の弟さんだったね。\
	dwavestop CH_VOICE	;YOP2304 

	【$g_hero】
	$g_fname義晴でしたら、僕の兄ですけど。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TPA"
	mov $debugstr,"立ち：TPA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"YOP2305"
	mov $debugstr,"音声：YOP2305 "
	gosub *vo

	【二階堂校長】
	君が入学したときには期待したんだがねぇ～。
	兄さんほどとは言わないが…。\
	dwavestop CH_VOICE	;YOP2305 

	…ああ、うんざりするな。兄さんはどうでも
	いいんだけど、こういうことを言われるのが
	一番腹が立つ。\

	うちの両親がそういうこと言わないだけでも
	マシなんだ。そうは思うけど…。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TPB"
	mov $debugstr,"立ち：TPB "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"YOP2306"
	mov $debugstr,"音声：YOP2306 "
	gosub *vo

	【二階堂校長】
	まあ大学ぐらいは、兄さんと同じところに
	進んでもらいたいものだな。\
	dwavestop CH_VOICE	;YOP2306 

	くそっ！　僕は僕で、兄さんは兄さんだろ。
	じゃああんたはノーベル賞を取れるのか。\

	だいたい、日本人なんてみんなどっかで
	血縁関係があるっていうじゃないか。\

	僕が兄さんと同じじゃなきゃいけないなら
	あんただって頭に髪の毛生やしてみろ！\

	…とは言えないよな。あ～、年齢と立場って
	だけで、どうしてそんなに威張れるんだろ。\

	ハゲ校長のヤツはぺちゃぺちゃと意味のない音を
	立て続けている。いい加減腹がたって来たぞ。
	もう、キレた若者のひとりでも生産したいのか。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TEC"
	mov $debugstr,"立ち：TEC "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XOP2307"
	mov $debugstr,"音声：XOP2307 "
	gosub *vo

	【菜摘先生】
	あの、コーラス部の練習がありますので。
	よろしいでしょうか？\
	dwavestop CH_VOICE	;XOP2307 
	;--立ちキャラ;----------------------------------
	mov $_char,"TPA"
	mov $debugstr,"立ち：TPA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"YOP2308"
	mov $debugstr,"音声：YOP2308 "
	gosub *vo

	【二階堂校長】
	おお、卒業式の歌ですな。
	楽しみにしておりますよ。\
	dwavestop CH_VOICE	;YOP2308 
	;--立ちキャラ;----------------------------------
	mov $_char,"TEA"
	mov $debugstr,"立ち：TEA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XOP2309"
	mov $debugstr,"音声：XOP2309 "
	gosub *vo

	【菜摘先生】
	それじゃ行きましょう。\
	dwavestop CH_VOICE	;XOP2309 

	そういって菜摘先生は、
	僕の制服の袖を軽くひっぱった。\

	【$g_hero】
	（あ…）\

	そっか。
	先生、僕のために言ってくれたんだ。\

	【$g_hero】
	はい。失礼します。\

	僕も４５度にお辞儀をして、
	菜摘先生と一緒に音楽室の方へ向かった。\
	gosub *blackout

	return	;----------------------------------
