*C100	; ■ファイル開始のラベル
	mov $debugstr,"■C100" : gosub *debugout
;■■■「月光に濡れる教室で、僕は。」台本：●卒業式の予行練習：B100
;━━━━━━━━━━━━━━
;●卒業式の予行練習
;2003/01/19

	;--BGM;----------------------------------
	mov $_music,"02": gosub *out
	;--背景;----------------------------------
	mov $_bg,"BG021G"
	mov $debugstr,"ＢＧ：BG021G"
	gosub *out	;画面に出力
;ＢＧ：BG021A;体育館
	;-効果音;----------------------------------
	mov $_se,"ZTYAIM"
	mov $debugstr,"ＳＥ：ZTYAIM"
	gosub *se
;ＳＥ：ZTYAIM;ピーンポーンパーンポーン

	卒業式の予行練習が、はじまった。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TEA"
	mov $debugstr,"立ち：TEA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XC10000"
	mov $debugstr,"音声：XC10000 "
	gosub *vo

	【菜摘先生】
	ただいまから…卒業式の予行練習をはじめます。
	卒業生は入場してください。\
	dwavestop CH_VOICE	;XC10000 
	;--立ちキャラ;----------------------------------
	mov $_char,"TEA"
	mov $debugstr,"立ち：TEA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XC10001"
	mov $debugstr,"音声：XC10001 "
	gosub *vo

	【菜摘先生】
	在校生は、内側をむいて拍手をしてください。\
	dwavestop CH_VOICE	;XC10001 
	;-効果音;----------------------------------
	mov $_se,"ZFANFARE"
	mov $debugstr,"ＳＥ：ZFANFARE"
	gosub *se
;ＳＥ：Z;拍手

	３年の列の中に、片山の姿を見つけてしまった。
	妙に晴れがましい顔をしている。\

	先輩の姿は、もちろんない。
	僕は……胸がジリジリした。\
	gosub *clear_char

	菜摘先生の司会で、予行練習は進んでいく。\

	ああ…アイツの代表の言葉を
	聞かなくちゃならないなんて…。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TEA"
	mov $debugstr,"立ち：TEA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XC10002"
	mov $debugstr,"音声：XC10002 "
	gosub *vo

	【菜摘先生】
	卒業生代表…片山　昌俊君。\
	dwavestop CH_VOICE	;XC10002 

	;--BGM;----------------------------------
	mov $_music,"09": gosub *out
	;--立ちキャラ;----------------------------------
	mov $_char,"TWB"
	mov $debugstr,"立ち：TWB "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"YC10003"
	mov $debugstr,"音声：YC10003 "
	gosub *vo

	【片山】
	はい！\
	dwavestop CH_VOICE	;YC10003 

	片山が、いそいそと壇上にあがっていった。
	マイクの位置を、確認している。\

	それから片山は、一度僕たちを見渡して、
	…満足げに笑った。\

	それは、勝利の笑みだった。
	ものすごく醜悪で…空虚な笑いだった。\

	何かが、間違っていた。
	僕はただ…それを見るのが辛かった。\

	本当なら、あそこに立っているのは
	アイツじゃなくて…。\

	あの人は、卒業生代表とかそんなもの
	欲しがりはしないだろうけど。\

	でもすごく悔しかった。\

	あんなヤツをあんな風に嬉しがらせるために、
	ただそれだけのために……。\

	明海が、あんなに苦しんだなんて。
	それに僕は、何もしてやれないなんて。\

	ただこうして、聞いているだけなんて。
	僕は、うつむいて唇を噛んだ。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TWA"
	mov $debugstr,"立ち：TWA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"YC10004"
	mov $debugstr,"音声：YC10004 "
	gosub *vo

	【片山】
	私たちには輝かしい未来が、待っています。
	無限の可能性があるのです！\
	dwavestop CH_VOICE	;YC10004 
	;--立ちキャラ;----------------------------------
	mov $_char,"TWA"
	mov $debugstr,"立ち：TWA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"YC10005"
	mov $debugstr,"音声：YC10005 "
	gosub *vo

	【片山】
	この学園での思い出を胸に、私たちは
	未来へと羽ばたきます。\
	dwavestop CH_VOICE	;YC10005 
	;--立ちキャラ;----------------------------------
	mov $_char,"TWA"
	mov $debugstr,"立ち：TWA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"YC10006"
	mov $debugstr,"音声：YC10006 "
	gosub *vo

	【片山】
	先生には、本当にお世話になりました。
	感謝の言葉もありません。\
	dwavestop CH_VOICE	;YC10006 
	;--立ちキャラ;----------------------------------
	mov $_char,"TWA"
	mov $debugstr,"立ち：TWA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"YC10007"
	mov $debugstr,"音声：YC10007 "
	gosub *vo

	【片山】
	私たちはこれからも、誠実さと真摯さをもって
	一歩一歩前進していきます。\
	dwavestop CH_VOICE	;YC10007 
	;--立ちキャラ;----------------------------------
	mov $_char,"TWA"
	mov $debugstr,"立ち：TWA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"YC10008"
	mov $debugstr,"音声：YC10008 "
	gosub *vo

	【片山】
	以上、これをもちまして、
	卒業の言葉にかえさせていただきます。\
	dwavestop CH_VOICE	;YC10008 
	;--立ちキャラ;----------------------------------
	mov $_char,"TWA"
	mov $debugstr,"立ち：TWA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"YC10009"
	mov $debugstr,"音声：YC10009 "
	gosub *vo

	【片山】
	卒業生代表、片山　昌俊！\
	dwavestop CH_VOICE	;YC10009 

	片山の声が、いっそう高くなった。
	そうなると、母親の声とそっくりだった。\

	マイクなのに…大きすぎるんだよ。声が。
	なんて…こんな文句しか言えないんだよな僕は。\

	ああ…どんどん卑屈な気分になる。
	決着って…どうやってつければいいんだろう？\

	矢崎が何とかしてくれるって言ったけど、
	百合恵先生も協力してくれるって言ったけど。\

	僕は…僕は…。
	無力なのが…悔しい…。\

	目の前が、じわりとにじんだ。\

	あ…ヤバい…涙まで出てきた…。
	女々しいじゃないか、しっかりしろ。\

	僕は、顔をあげたまま目をしばたたかせた。
	そのとき。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TED"
	mov $debugstr,"立ち：TED "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XC10010"
	mov $debugstr,"音声：XC10010 "
	gosub *vo

	【菜摘先生】
	あっ…？\
	dwavestop CH_VOICE	;XC10010 
	gosub *clear_char

	最初に異変に気づいたのは、菜摘先生だった。
	その声に気づいて…僕は壇上を見た。\

	涙で曇ってよく見えなかった。\
	gosub *musicstop

	僕は、何度も瞬いた。
	その瞬きと、瞬きの間に。\
	;-効果音;----------------------------------
	mov $_se,"ZDOKUN"
	mov $debugstr,"ＳＥ：ZDOKUN"
	gosub *se

	ポツンと黒い塊が、一瞬だけ
	空中にとまっているように見えた───。\
	;-効果音;----------------------------------
	mov $_se,"ZBARIN"
	mov $debugstr,"ＳＥ：ZBARIN"
	gosub *se
	;--背景;----------------------------------
	mov $_bg,"WHITE"
	mov $debugstr,"ＢＧ：WHITE "
	mov %effect,1	;エフェクトを指定
	gosub *out	;画面に出力
;ＳＥ：ZLIGHT;スポットライトが落ちる音
	gosub *GURAGURA	;GURAGURAを呼び出し

	ガシャーーーン！！！\
	gosub *whiteout
;なんかエフェクトと一緒に
;ぐるぐる回るといいけど

	return	;----------------------------------
;---C100 END -----
