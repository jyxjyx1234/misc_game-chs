	;--背景;----------------------------------
	mov $_bg,"BG010G"
	mov $debugstr,"ＢＧ：BG010G"
	gosub *out	;画面に出力
;;１年教室

	僕はそっと小夜子の教室を覗いた。
	放課後の教室には小夜子と丹羽しかいなかった。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TVA"
	mov $debugstr,"立ち：TVA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"YD6002"
	mov $debugstr,"音声：YD6002"
	gosub *vo

	【丹羽】
	お前の本当の母ちゃんさ、今でもたまに
	男連れで来て、金せびってるって本当か？\
	dwavestop CH_VOICE	;YD6002

	小夜子の周りにはしんと張りつめた空気がただ
	よっていた。僕は中に入ることもできなかった。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TDE"
	mov $debugstr,"立ち：TDE "
	gosub	*out	;画面に出力

	【小夜子】
	………………………。\

	小夜子はきっと口元をひき結んだかと思うと
	すっくと立って、丹羽の目の前に立った。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TVA"
	mov $debugstr,"立ち：TVA "
