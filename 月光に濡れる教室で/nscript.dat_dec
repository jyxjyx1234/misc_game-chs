	mov $debugstr,"音声：YE4801"
	gosub *vo

	【$g_heroの兄】
	たのまれた写真もってきたんだよ。\
	dwavestop CH_VOICE	;YE4801

	【$g_hero】
	え！？本当！　みせてみせて！！\
	;--立ちキャラ;----------------------------------
