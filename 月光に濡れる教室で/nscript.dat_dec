*D18	; ■ファイル開始のラベル
	mov $debugstr,"■D18 " : gosub *debugout
;■■■「月光に濡れる教室で、僕は。」台本：●廃教室：D18
;━━━━━━━━━━━━━━

	;--BGM;----------------------------------
	mov $_music,"09": gosub *out
	;--背景;----------------------------------
	mov $_bg,"BG013B"
	mov $debugstr,"ＢＧ：BG013B"
	gosub *out	;画面に出力
;;廊下（夜）

	そとからの月明かりと非常灯だけが照らす
	廊下を、音を立てないようにそっと歩く。\

	外では、風が強くなったのか
	ガタガタと廊下の窓が揺れていた。\
;BGM:迷
	;--背景;----------------------------------
	mov $_bg,"BG020B"
	mov $debugstr,"ＢＧ：BG020B"
	gosub *out	;画面に出力
;ＢＧ：BG020B;使われてない教室（Ｈ用）

	教室には、小夜子が居た。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TDF"
	mov $debugstr,"立ち：TDF "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"DD1800"
	mov $debugstr,"音声：DD1800"
	gosub *vo

	【小夜子】
	先輩…。\
	dwavestop CH_VOICE	;DD1800

	【$g_hero】
	小夜子。\

	外からの明かりだけが小夜子を照らしている。\

	どこかで、甘い花のような香りがした。
	まるで百合の花のような、濃厚な香り。\

	小夜子…ってコロンかなにかつけてたっけ？
	いや、ちがう。前にも、これは嗅いだ覚えが…。\

	くらりとする。酩酊感が自分を襲う。
	月の光で、僕は狂う。\
	gosub *blackout

	return	;----------------------------------
;---D18  END -----
