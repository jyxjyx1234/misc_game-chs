;-------------------------------------------------------------------
*playback_mode	;■回想モード

*pb_select	;●キャラクタ選択
	;--BGM;----------------------------------
	mov $_music,"06": gosub *music
	csp -1 ;スプライトすべてクリア
	bg "sys/pb_select.jpg",0	;背景を表示
	lsp 0,":l/2,0,3;sys/pb_makoto.jpg",	 45,130	;真実
	lsp 1,":l/2,0,3;sys/pb_akemi.jpg",	225,130	;明海
	lsp 2,":l/2,0,3;sys/pb_sayoko.jpg",	405,130	;小夜子
	lsp 3,":l/2,0,3;sys/pb_others.jpg",	585,130	;その他
	lsp 4,":a/2,0,3;sys/modoru.jpg",	360, 550

	btndef ""
	spbtn 0,1
	spbtn 1,2
	spbtn 2,3
	spbtn 3,4
	spbtn 4,5
	print BG_EFFECT

*pb_select_lp
	btnwait %work
	if %work==0 goto *pb_select_lp
	if %work==MOUSE_RBUTTON gosub *click : csp -1 : goto *title
	if %work==KEY_ESCAPE    gosub *click : csp -1 : goto *title
	if %work==1 gosub *click: csp -1 : goto *pb_makoto
	if %work==2 gosub *click: csp -1 : goto *pb_akemi
	if %work==3 gosub *click: csp -1 : goto *pb_sayoko
	if %work==4 gosub *click: csp -1 : goto *pb_other
	if %work==5 gosub *click: csp -1 : goto *title	;戻る
	goto *pb_select_lp

;------------------------------------------
*pb_makoto
	mov %_x,400
	mov %_y,130
	mov %is_adv,2
	csp -1
if %g_nomegane==OFF 	bg "SYS/PBBG_makotoA.JPG",0	;背景を表示
if %g_nomegane==ON  	bg "SYS/PBBG_makoto.JPG",0	;背景を表示
if lchk *B00		lsp 1,":s/24,24,2;#400000#ff9999■Ｈ　ＯＰ",	%_x,%_y : add %_y,50
if lchk *BH_1ST		lsp 2,":s/24,24,2;#400000#ff9999■Ｈ　１回目",	%_x,%_y : add %_y,50
if lchk *BH_2ND		lsp 3,":s/24,24,2;#400000#ff9999■Ｈ　２回目",	%_x,%_y : add %_y,50
if lchk *BH_3RD		lsp 4,":s/24,24,2;#400000#ff9999■Ｈ　３回目",	%_x,%_y : add %_y,50
if lchk *BH_4TH		lsp 5,":s/24,24,2;#400000#ff9999■Ｈ　４回目",	%_x,%_y : add %_y,50
if %g_makoto_end!=0	lsp 6,":s/24,24,2;#400000#ff9999■コンボ呼び出し",	%_x,%_y : add %_y,50
if lchk *B105		lsp 7,":s/24,24,2;#400000#ff9999■エンディング",	%_x,%_y : add %_y,50
			lsp 8,":a/2,0,3;sys/modoru.jpg"    ,360, 550
if %g_nomegane==ON	lsp 9,":a/2,0,3;sys/PB_MEGANEB.jpg",   400, 10 ;コンタクト
if %g_nomegane==OFF	lsp 9,":a/2,0,3;sys/PB_MEGANEA.jpg",   400, 10 ;眼鏡

	print BG_EFFECT
	btndef ""
	spbtn	1,1
	spbtn	2,2
	spbtn	3,3
	spbtn	4,4
	spbtn	5,5
	spbtn	6,6
	spbtn	7,7
	spbtn	8,8
	spbtn	9,9

*pb_bloop
	btnwait %work
	if %work==MOUSE_RBUTTON gosub *click : csp -1 : goto *pb_select
	if %work==KEY_ESCAPE    gosub *click : csp -1 : goto *pb_select
	if %work==1 gosub *click : csp -1 :goto *pb_bop
	if %work==2 gosub *click : csp -1 :goto *pb_b1
	if %work==3 gosub *click : csp -1 :goto *pb_b2
	if %work==4 gosub *click : csp -1 :goto *pb_b3
	if %work==5 gosub *click : csp -1 :goto *pb_b4
	if %work==6 gosub *click : csp -1 :goto *pb_bcombo
	if %work==7 gosub *click : csp -1 :goto *pb_bend
	if %work==8 gosub *click : csp -1 : goto *pb_select
	if %work==9 gosub *cg_megane : goto *pb_makoto
	goto *pb_bloop

