;BGM:迷
;ＢＧ：BG012A;保健室

	………………。\

	………………。\

	………………。\
	;--背景;----------------------------------
	mov $_bg,"BG012A"
	mov $debugstr,"ＢＧ：BG012A"
	gosub *out	;画面に出力

	【$g_hero】
	あれ…？ここ…。\

	保健室だ。僕がいるのは、ベッドの上。
	二三度、頭を振って、あたりを見回すと
	隣では真実が青ざめた顔で眠っている。\
	;--立ちキャラ;----------------------------------
