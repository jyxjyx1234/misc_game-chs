*BAD_NATUMI	; ■ファイル開始のラベル
	mov $debugstr,"■BAD_NATUMI" : gosub *debugout
;菜摘先生バッドＥＤ。
;呼び出されてプシュッと死ぬ。

	;--BGM;----------------------------------
	mov $_music,"01": gosub *out
;BGM:さりげない日常
	gosub *blackout
	;--背景;----------------------------------
	mov $_bg,"BG014A"
	mov $debugstr,"ＢＧ：BG014A"
	gosub *out	;画面に出力
;;校門

	翌日。僕は、いつものように登校した。\

	【$g_hero】
	そういえば昨日、菜摘先生に告られたんだよなぁ…。\

	なんだか、まだ信じられない。
	断ってもったいなかったような、よかったような。
	妙な気分だった。\

	【$g_hero】
	…屋上…行ってみるかな。\
	;--背景;----------------------------------
	mov $_bg,"BG025A"
	mov $debugstr,"ＢＧ：BG025A"
	gosub *out	;画面に出力
;ＢＧ：BG025A;屋上

	【$g_hero】
	まだ、やっぱり寒いな…。\

	風は冷たく、空は青く澄んでいる。
	僕はあたりを見回して妙なものに気付いた。\

	【$g_hero】
	あれ？\

	フェンスの手前に何か置いてある。\
	;--背景;----------------------------------
	mov $_bg,"ANGEL"
	mov $debugstr,"ＢＧ：ANGEL "
	gosub *out	;画面に出力

	【$g_hero】
	天使のカード？
	なんだろ、これ。\

	【$g_hero】
	…何か書いてあるな…。\

	僕は何気なくそれに目を通した。\

	「すべての罪が浄化される場所へ
	　安らかに旅立ちたまえ」\
	;--背景;----------------------------------
	mov $_bg,"BG025A"
	mov $debugstr,"ＢＧ：BG025A"
	gosub *out	;画面に出力

	【$g_hero】
	だれのだろ…？
	妙な文章だな…。\
	gosub *musicstop

	その時だった。\
	;-効果音;----------------------------------
	mov $_se,"ZHIT2"
	mov $debugstr,"ＳＥ：ZHIT2 "
	gosub *se
	;--背景;----------------------------------
	mov $_bg,"WHITE"
	mov $debugstr,"ＢＧ：WHITE "
	mov %effect,1	;エフェクトを指定
	gosub *out	;画面に出力
	;--背景;----------------------------------
	mov $_bg,"BG025A"
	mov $debugstr,"ＢＧ：BG025A"
	gosub *out	;画面に出力
	gosub *GURAGURA	;GURAGURAを呼び出し

	ガンッ！\

	【$g_hero】
	うっ…！\
;フラッシュとか点滅とか・・・

	いきなり目の前が暗くなる。
	頭がぐらぐらして、ずきずきと傷む。
	僕の後頭部を誰かが殴ったのだ。\

	【$g_hero】
	ぐ……。\

	何度も瞬きをする。目がかすむ。
	足に力が入らない。\

	【$g_hero】
	だ…誰だ…。どうして僕を…。\

	僕の意識が遠くなる。\
	gosub *blackout
	;-効果音;----------------------------------
	mov $_se,"ZDOSA"
	mov $debugstr,"ＳＥ：ZDOSA "
	gosub *se

	ドサッ！\
	gosub *anime_bloodB	;anime_bloodBを呼び出し
;地面の血がにじむ＜ここもアニメにしてほしいなぁ…。

	;--BGM;----------------------------------
	mov $_music,"04": gosub *out
;BGM:哀
	;--背景;----------------------------------
	mov $_bg,"AOZORA"
	mov $debugstr,"ＢＧ：AOZORA"
	gosub *out	;画面に出力
;;屋上

	【？？？】
	………………ごめんよ。\

	【天使】
	だけど君の死には、意味があるから。\

	【天使】
	だから…君は死んでね。\

	だけどその声は、既に死んでしまった
	僕の耳には届かなかった。\
	gosub *blackout

	mov %ending,BAD_END
	return	;----------------------------------
;---BAD_NATUMI END -----
