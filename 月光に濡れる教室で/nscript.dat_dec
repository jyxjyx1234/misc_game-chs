	mov $debugstr,"音声：XC9879"
	gosub *vo

	【矢崎】
	ああ、行ってこい。
	骨は拾ってやるから。感謝しろよ。\
	dwavestop CH_VOICE	;XC9879

	【$g_hero】
	わかった。
	じゃあな…準備手伝えなくてごめんな。\
	;--立ちキャラ;----------------------------------
	mov $_char,"THA"
	mov $debugstr,"立ち：THA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XC9880"
	mov $debugstr,"音声：XC9880"
	gosub *vo

	【矢崎】
	予行練習には出ろよ。
	片山との決着は、それからでもいいだろう。\
	dwavestop CH_VOICE	;XC9880

	そう言って、矢崎はヒラヒラと手を振った。\

	トゲをなくした矢崎の声は、何だかとても
	やわらかだった。\
	gosub *blackout

	return	;----------------------------------
