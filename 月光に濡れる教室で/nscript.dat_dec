*B00B	; ■ファイル開始のラベル
	mov $debugstr,"■B00B" : gosub *debugout
	gosub *blackout
;BGM:愛
	;-効果音;----------------------------------
	mov $_se,"ZLOGO"
	mov $debugstr,"ＳＥ：ZLOGO "
	gosub *se
	gosub *anime_moonA	;anime_moonAを呼び出し

	;--BGM;----------------------------------
	mov $_music,"06": gosub *out
	;--背景;----------------------------------
	mov $_bg,"MOON26"
	mov $debugstr,"ＢＧ：MOON26"
	mov %effect,4	;エフェクトを指定
	gosub *out	;画面に出力

	月光のさしこむ教室で、僕は見た。\

	月明かりにさらされて光る白い背中のライン。
	ゆれる胸が、緩やかなカーヴを描く。\

	真実の熱い吐息と。僕の熱。
	精液の匂いと愛液の匂いと血液の匂い。\

	どうして体の一部を接触させて
	こうやって動いてるだけで\

	おかしいぐらい、気持ちがよくて
	笑ってしまうぐらい、心が騒ぐんだろう。\

	汗に濡れている肌がぬらりと光る。
	まるで月に濡れてるみたいだと思いながら。\

	僕は。\
	gosub *blackout
	return
	;----------------------------------
;---B00B END -----
