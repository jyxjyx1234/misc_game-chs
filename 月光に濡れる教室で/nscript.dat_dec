	;--立ちキャラ;----------------------------------
	mov $_char,"TCJ"
	mov $debugstr,"立ち：TCJ "
	gosub	*out	;画面に出力
;【明海】［ポ］

	先輩の体が、ギクリとこわばった。
	視線がさまよう。\

	【$g_hero】
	言えないならばいいけど…。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCC"
	mov $debugstr,"立ち：TCC "
	gosub	*out	;画面に出力
