;============================================
*B105	; ■ファイル開始のラベル
	mov $debugstr,"■B105" : gosub *debugout
;■■■「月光に濡れる教室で、僕は。」台本：●エンディング１：ハッピー：B105
;━━━━━━━━━━━━━━
;●エンディング１：ハッピー

	;--BGM;----------------------------------
	mov $_music,"10": gosub *out
	;--背景;----------------------------------
	mov $_bg,"BG014D"
	mov $debugstr,"ＢＧ：BG014D"
	gosub *out	;画面に出力
;;校門

	わたしが子供だったころ。よく虐められていた。
	理由なんて知らない。\

	といっても、新聞やテレビのニュースで
	取り上げられるほどのものではなくて\

	たんに、ちょっと仲間はずれにされるとか
	たんに、真実ちゃんにはわからないよねと
	言われるとか、そんなことでしかなかった。\

	兄からの行為も別にいじめと
	いうほどではないのだと思う。\

	単に、罵倒したり、モノを投げつけたり
	するのに、ちょうどいいから。するだけで。\

	だから、それは取り立てて問題に
	するほどのことでも、何でもないのだと思う。\

	けれども、わたしは、だからひとりで。
	世界からいつも遠いと思った。\

	でも、どこかで、わたしは昔から、
	誰かに必要とされる人間に
	なりたいと思っていた。\

	そのことは、とても
	おこがましい考えだとも思っていたけれど。\

	だって、自分には何もないのだ。
	頭も、それほどよくない。\

	家事もできるけれど、どこか苦手だ。
	会話も上手くない。面白味のない人間なのだ。\

	だから、利用してほしかった。
	君に利用してほしかったんだよ。$g_fname君。\

	今度のことは嬉しかった。
	ただ、単純にうれしいことだった。\

	だって、君のそばに居られる。
	君のそばに居られる。
	これで君と繋がっていられるなら。\

	別に君が欲しくてしたんじゃない。
	別に君に愛してほしいなんて思わない。\

	恋か愛か、わたしには、よくわからないけれど
	ただ君と繋がっていたかった。\

	欲望というものは、君にもあって。
	私にもあって。誰にでもたいていはあって。\

	そういうものを名目にできるのなら
	こうやって繋がることも許されると思った。\

	それなら、恥ずかしくないと思った。
	わたしみたいなものが、君を好きでも。\

	それでも。\

	わたしは、君が必要になっていた。
	いつの間にか君が必要になっていた。\

	君に触れたかった。キスがしたかった。\

	わたしは君という存在があることで助けられた。
	君が望もうと、望むまいとかかわらず。\

	わたしは君に必要とされたい。
	そう、願っている。\

	【$g_hero】
	おはよ、真実。\
	;-- イベントCG;----------------------------------
	mov $_cg,"B20A"
	mov $debugstr,"ＣＧ：B20A"
	gosub *cgout	;イベントＣＧ
	;-音声;----------------------------------
	mov $_voice,"BB10500"
	mov $debugstr,"音声：BB10500 "
	gosub *vo

	【真実】
	おはよう。\
	dwavestop CH_VOICE	;BB10500 

	わたしたちは、たわいのない
	おしゃべりをしながら通学路を歩いた。\

	風はいつのまにか、すこしずつ温んでいる。\

	【$g_hero】
	今日はあったかいよな。\
	;-音声;----------------------------------
	mov $_voice,"BB10501"
	mov $debugstr,"音声：BB10501 "
	gosub *vo

	【真実】
	もうすぐ春だから。\
	dwavestop CH_VOICE	;BB10501 

	【$g_hero】
	そうだな、もうすぐ春だよな。\

	どうしてなのかな。どうしてなんだろう。
	わたしは、君を好きになった。\

	わたしは、恋を知ってしまった。
	わたしは、君に恋してしまった。\

	こんなわたしを好きになってくれるなんて
	わからなかったから。\

	だって、わたしは醜いモノでいっぱいで。
	とてもずるくて、どうしようもなくて。\

	でも。
	それでも。\

	ただ、君を見ていたい。
	そう思っていた。君に触れるまで。\
	;-音声;----------------------------------
	mov $_voice,"BB10502"
	mov $debugstr,"音声：BB10502 "
	gosub *vo

	【真実】
	わたしは、君のことを好きになってよかったな。\
	dwavestop CH_VOICE	;BB10502 

	【$g_hero】
	なんだよ、いきなり。\
	;-音声;----------------------------------
	mov $_voice,"BB10503"
	mov $debugstr,"音声：BB10503 "
	gosub *vo

	【真実】
	ずっと、死んでるように生きてたんだと思う。
	なんでもよくて、どうでもよくて。\
	dwavestop CH_VOICE	;BB10503 

	【$g_hero】
	…今は？\
	;-音声;----------------------------------
	mov $_voice,"BB10504"
	mov $debugstr,"音声：BB10504 "
	gosub *vo

	【真実】
	…君がいるから。\
	dwavestop CH_VOICE	;BB10504 

	なにもない絶望にもなれない絶望の果てに
	わたしは、希望を見つけた。\

	苦しくてもいい。つらくてもいい。
	何もない空虚な寂しさよりも、その方がいい。\

	どんなに、つらいことがあっても
	哀しいことがあっても、涙があっても。
	君がいるほうが、わたしはうれしい。\

	春の始まりとともに恋を知った
	君の訪れとともに恋を知った。\

	そんな、春がやってくる。\

	この先の未来なんてわからないけど。
	きっと明日もやってくる。\

	だから。\

	【$g_hero】
	行こうか。\

	$g_fname君はわたしに手を差し出した。
	わたしは、その手を握りしめた。\
	;-音声;----------------------------------
	mov $_voice,"BB10505"
	mov $debugstr,"音声：BB10505 "
	gosub *vo

	【真実】
	うん。\
	dwavestop CH_VOICE	;BB10505 

	この手のぬくもりがあるように。
	ただ、君を好きでいる。\

	return	;----------------------------------
;---B105 END -----
