	dwavestop CH_VOICE	;XE0037

	【$g_hero】
	あ、はい。失礼しました。\
;菜摘先生退場
	gosub *blackout
;廊下辺りに出てもいい
	;--背景;----------------------------------
	mov $_bg,"BG013A"
	mov $debugstr,"ＢＧ：BG013A"
	gosub *out	;画面に出力
;;廊下

	ふう…。
	なんだか、今日の先生はヘンだったな…。\

	好きなのに嫌いで。嫌いなのに好き、か。
	そういや愛憎なんて言葉もあったなぁ…。\

	菜摘先生みたいな人でも思うんだな。
	誰かが好きで、誰かが憎いって。\

	さっきの台詞が、僕を頼って
	言ってくれるんだったらいいのにな。\

	【$g_hero】
	…つっても、そんなに頼りがい…ない…かな。
	ふう…。\

	僕は妙にやりきれないためいきをついた。\

	return	;----------------------------------
