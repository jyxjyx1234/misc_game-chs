;BGM:迷
	;--背景;----------------------------------
	mov $_bg,"BG034G"
	mov $debugstr,"ＢＧ：BG034G"
	gosub *out	;画面に出力
;;２年教室新

	僕は自分の教室に戻った。ひとのいない教室は
	しんと冷気が忍び寄っている。\

	自分の机の中を探ってみると、やっぱり
	「天使」からのカードが入っていた。\

	内容も、また、同じ。\

	【$g_hero】
	今日も…かよ。\

	僕は諦めとやるせない怒りの混じった
	ため息をついた。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TBJ"
	mov $debugstr,"立ち：TBJ "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"BB7900"
	mov $debugstr,"音声：BB7900"
	gosub *vo

	【真実】
	誰なんだろうね。
	どうしてなんだろうね。\
	dwavestop CH_VOICE	;BB7900

	真実は、天使のカードを手にとって
	それを見たあと、唄うように言った。\

	「天使」は、何が目的なのか。
	何を望んでいるのか。\
	gosub *clear_char

	僕は昔読んだ話を思い出した。
	罪人への刑罰の話だ。\

	まず地面に穴を掘り続ける。そして穴が
	十分に大きくなったら、それを埋める。\

	それの繰り返し。まったく無目的な行為。
	何の意味も持たないことは苦しい。\

	もしかしたら「天使」が意図していることは
	それなのかもしれないな、と僕は思った。\

	それとも、混乱して言いなりになるしかない
	僕らを見て、どこかで暗い愉悦を覚えている
	のだろうか。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TBC"
	mov $debugstr,"立ち：TBC "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"BB7901"
	mov $debugstr,"音声：BB7901"
	gosub *vo

	【真実】
	夜のこと…誰かに見られたのかな。
	だから、噂になんかなったのかな。\
	dwavestop CH_VOICE	;BB7901

	【$g_hero】
	だったら、僕のことだって言われるだろ？\
	;--立ちキャラ;----------------------------------
	mov $_char,"TBJ"
	mov $debugstr,"立ち：TBJ "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"BB7902"
	mov $debugstr,"音声：BB7902"
	gosub *vo

	【真実】
	メール送ったの、「天使」なのかな。\
	dwavestop CH_VOICE	;BB7902

	【$g_hero】
	…もう…止める？\

	真実は首を横に振った。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TBF"
	mov $debugstr,"立ち：TBF "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"BB7903"
	mov $debugstr,"音声：BB7903"
	gosub *vo

	【真実】
	いいよ、するの。\
	dwavestop CH_VOICE	;BB7903

	【$g_hero】
	真実。\

	真実はうつむいて、カードの縁を
	しょざいなげに、指先で触れている。\

	首から肩にかけての白いラインが
	滑らかで綺麗だった。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TBG"
	mov $debugstr,"立ち：TBG "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"BB7904"
	mov $debugstr,"音声：BB7904"
	gosub *vo

	【真実】
	だって、わたし、君と一緒にいたいもの。
	それだったら、なんでもいいんだ。\
	dwavestop CH_VOICE	;BB7904

	その言葉が僕の胸を熱くした。
	「天使」なんてクソくらえ。\

	僕たちの夜の行為は、
	僕たちの間には意味があるんだ。\

	「天使」には、遊戯でしかなくても
	浅ましい行為でも、誰からも認められなくても。\

	【$g_hero】
	僕はもっと真実が欲しい。\

	僕は真実の手に、自分の手を重ねた。
	白いその手は冷たくてせつなかった。\

	真実はカードをそっと机に置いて
	僕の手の上にもう片方の手を重ねた。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TBF"
	mov $debugstr,"立ち：TBF "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"BB7905"
	mov $debugstr,"音声：BB7905"
	gosub *vo

	【真実】
	わたしも、君がほしいよ。\
	dwavestop CH_VOICE	;BB7905
	gosub *blackout

	return	;----------------------------------
