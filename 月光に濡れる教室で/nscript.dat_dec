*BAD_1ST_YORU	; ■ファイル開始のラベル
	mov $debugstr,"■BAD_1ST_YORU" : gosub *debugout
;■■■「月光に濡れる教室で、僕は。」台本：●教室で：OP52
;━━━━━━━━━━━━━━
;●教室で

	;--BGM;----------------------------------
	mov $_music,"03": gosub *out
;BGM:迷
	;--背景;----------------------------------
	mov $_bg,"BG013B"
	mov $debugstr,"ＢＧ：BG013B"
	gosub *out	;画面に出力
;ＢＧ：BG013B;廊下

	正直に言って、誰もいない校舎は
	ものすごく、薄気味悪かった。\

	非常灯の明かりやら、窓からの明かりで
	案外、真っ暗ではないところが
	さらに不気味度をたかめる。\

	夏だったら肝試しに最適じゃないかな。\

	開いた窓のせいか、ゆらゆら揺れる影に
	思わず声をあげそうになっってしまったり、
	カタカタ鳴る窓にびびってしまったり。\

	【$g_hero】
	度胸ないなぁ…。\

	正直、ちょっと情けない。
	もう少し自分は度胸があるのかと思ってたな…。\

	【$g_hero】
	でも自分って、過大評価しやすいしな…。\

	人間誰しも自分には甘くなりがちだから
	粗末にするぐらいがちょうどいいとか。\

	ま、いいや。それは。\
	;--背景;----------------------------------
	mov $_bg,"BG009C"
	mov $debugstr,"ＢＧ：BG009C"
	gosub *out	;画面に出力
;ＢＧ：BG009B;２年教室

	なんとか教室にたどりついた。
	窓から入る明かりで、動くのには苦労しない。\

	そういや、今日は満月かな。
	やけに外があかるいや。\
;2003/3/17は月例１６．４ほぼ満月。

	【$g_hero】
	えっと、僕の机…机…。
	あった！\
	gosub *blackout
	;--背景;----------------------------------
	mov $_bg,"NOTECLOSE"
	mov $debugstr,"ＢＧ：NOTECLOSE "
	mov %effect,CG_EFFECT	;エフェクトを指定
	gosub *out	;画面に出力

	机の上には僕のノートが載っている。\

	【$g_hero】
	はあ…。あの恥ずかしい小説モドキも
	見られたのかな…。ん…？\
	;--背景;----------------------------------
	mov $_bg,"BG009C"
	mov $debugstr,"ＢＧ：BG009C"
	gosub *out	;画面に出力

	中に何かが挟まっている。
	メモ…かな？\

	僕は窓のそばに寄った。
	月明かりで見てみる。\
	gosub *blackout
	;--背景;----------------------------------
	mov $_bg,"ANGEL"
	mov $debugstr,"ＢＧ：ANGEL "
	gosub *out	;画面に出力

	【$g_hero】
	天使…か。
	中にも絵が描いてあるな…。\

	僕はカードを開けてみた。\

	【$g_hero】
	聖母子像か。ラファエロだな…。\

	聖母子像ってのは、聖母マリアと幼子イエスの
	絵のことだ。宗教絵画じゃ有名すぎるほど有名な
	モチーフだ。\

	絵にはあまり興味ないけど、これぐらい有名な
	ものならわかる。\

	【$g_hero】
	ポストカード…だな。\

	展示会か何かで買ったやつかな。
	それとも、海外のお土産かもしれない。
	英語じゃないような単語の羅列。\

	【$g_hero】
	イタリア語なのかな…？
	ん？\

	よく見るとカードには文字らしきものが
	書いてある。僕は目を細めて、それを読んだ。\
	gosub *blackout
	;--背景;----------------------------------
	mov $_bg,"BG009C"
	mov $debugstr,"ＢＧ：BG009C"
	gosub *out	;画面に出力

	【$g_hero】
	「屋上へ行け」？
	屋上？　なんでまた、そんなところに？\

	どういうことだろう？
	なんで、こんなメモを残したんだろう。\

	これを残した相手がそこに居るんだろうか。
	なんで、わざわざ呼び出したんだろうか。\

	好奇心がうずく。\

	【$g_hero】
	どうしよう…行ってみようかな。\

	なんて口に出してみたけど、
	心のほうは決まってる。\

	どうせこのノートを見られてるんだ。
	それなのに、こんなカードを残すなんて
	そうとう茶目っ気のあるヤツにちがいない。\

	【$g_hero】
	育巳じゃないよな…。
	この葉書、あいつの趣味じゃないしな…。\

	誰なんだろ。とにかく、面白そうだ。\

	【$g_hero】
	よし、行ってみるか！\
	gosub *blackout
	;--背景;----------------------------------
	mov $_bg,"BG025B"
	mov $debugstr,"ＢＧ：BG025B"
	gosub *out	;画面に出力
;;屋上
;夜の教室

	という訳で、屋上にやってきたけれど…。\

	【$g_hero】
	誰もいないな…。\

	てっきり誰かが待ってると思ったのに。
	隠れてるのかな……？\
	;-効果音;----------------------------------
	mov $_se,"ZKAZE"
	mov $debugstr,"ＳＥ：ZKAZE "
	gosub *se

	【$g_hero】
	…うう寒い。
	もしもし～誰かいませんかー？\

	僕は、屋上をうろうろ回ってみた。
	けれども、誰も見あたらない。\

	【$g_hero】
	冗談か、いたずらだったのかな…。
	ん！？　なんだ、あれ？\

	何か、ちいさくて白いものが、
	フェンスの手前に何か置いてある。\

	僕は、フェンス間近に寄って
	その白いものを手に取った。\
	;--背景;----------------------------------
	mov $_bg,"ANGEL"
	mov $debugstr,"ＢＧ：ANGEL "
	gosub *out	;画面に出力

	【$g_hero】
	天使のカード？
	さっきのと、同じだ。\

	【$g_hero】
	…何か書いてあるな…。\

	僕は何気なくそれに目を通した。\

	「すべての罪が浄化される場所へ
	　安らかに旅立ちたまえ」\
	;--背景;----------------------------------
	mov $_bg,"BG025B"
	mov $debugstr,"ＢＧ：BG025B"
	gosub *out	;画面に出力

	【$g_hero】
	妙な文章だな…。\
	gosub *musicstop

	その時だった。\
	;-効果音;----------------------------------
	mov $_se,"ZHIT2"
	mov $debugstr,"ＳＥ：ZHIT2 "
	gosub *se
	;--背景;----------------------------------
	mov $_bg,"WHITE"
	mov $debugstr,"ＢＧ：WHITE "
	mov %effect,1	;エフェクトを指定
	gosub *out	;画面に出力
	;--背景;----------------------------------
	mov $_bg,"BG025B"
	mov $debugstr,"ＢＧ：BG025B"
	gosub *out	;画面に出力
	gosub *GURAGURA	;GURAGURAを呼び出し

	ガンッ！\
	;-効果音;----------------------------------
	mov $_se,"ZKAZE"
	mov $debugstr,"ＳＥ：ZKAZE "
	gosub *se

	【$g_hero】
	うっ…！\

	頭がぐらぐらして、ずきずきと傷む。
	僕の後頭部を誰かが殴ったのだ。\

	【$g_hero】
	くそっ…！　誰だ！\

	何度も瞬きをする。目がかすむ。
	足に力が入らない。\
	;-効果音;----------------------------------
	mov $_se,"ZHIT2"
	mov $debugstr,"ＳＥ：ZHIT2 "
	gosub *se
	;--背景;----------------------------------
	mov $_bg,"WHITE"
	mov $debugstr,"ＢＧ：WHITE "
	mov %effect,1	;エフェクトを指定
	gosub *out	;画面に出力
	;--背景;----------------------------------
	mov $_bg,"BG025B"
	mov $debugstr,"ＢＧ：BG025B"
	gosub *out	;画面に出力
	gosub *GURAGURA	;GURAGURAを呼び出し

	ガンッ！\

	【$g_hero】
	なんで…僕を…。
	くっ…！！\

	身体がよろけて、僕はフェンスにしがみついた。
	その途端、フェンスが妙な音をたてた。\

	【$g_hero】
	え…！？\
	gosub *GURA	;GURAを呼び出し

	ぐらり。\

	【$g_hero】
	あ…！？\

	フェンスは何もない空中に倒れ込み、
	そして、僕の身体は空に放り出された。\
	;-効果音;----------------------------------
	mov $_se,"ZRAKKA"
	mov $debugstr,"ＳＥ：ZRAKKA"
	gosub *se
	gosub *blackout

	【$g_hero】
	あぁあああぁあああああああぁぁああああ
	あぁあああぁああああぁぁぁあああ！！！！\

	ドサッ！\
	;-効果音;----------------------------------
	mov $_se,"ZDOSA"
	mov $debugstr,"ＳＥ：ZDOSA "
	gosub *se
	gosub *anime_bloodB	;anime_bloodBを呼び出し
;地面の血がにじむ＜ここもアニメにしてほしいなぁ…。
	gosub *blackout

	誰が、どうして、僕を、こんな目に。\

	僕には何も解らなかった。\
	gosub *blackout
	;--背景;----------------------------------
	mov $_bg,"MOONA01"
	mov $debugstr,"ＢＧ：MOONA01 "
	mov %effect,4	;エフェクトを指定
