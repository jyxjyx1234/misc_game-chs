;BGM:Ｈ２
	;--背景;----------------------------------
	mov $_bg,"BG014D"
	mov $debugstr,"ＢＧ：BG014D"
	mov %effect,4	;エフェクトを指定
	gosub *out	;画面に出力
;;校門

	桜の花が散っている。
	まるで夢みたいに散っていく。\

	わたしがどんなに悩んでも苦しんでも
	こうやって花は咲いて散っていく。\

	だから、笑って唄って楽しんで
	そうやって生きてもいいじゃないと彼は言う。\
	;-- イベントCG;----------------------------------
	mov $_cg,"E07A"
	mov $debugstr,"ＣＧ：E07A"
	gosub *cgout	;イベントＣＧ
	;-音声;----------------------------------
	mov $_voice,"XE7300"
	mov $debugstr,"音声：XE7300"
	gosub *vo

	【菜摘先生】
	きれいだね。\
	dwavestop CH_VOICE	;XE7300

	【$g_hero】
	うん。
	…１年のときのこと、思い出すな…。\
	;-音声;----------------------------------
	mov $_voice,"XE7301"
	mov $debugstr,"音声：XE7301"
	gosub *vo

	【菜摘先生】
	入学したときのこと？\
	dwavestop CH_VOICE	;XE7301

	【$g_hero】
	菜摘先生を初めて見たとき。
	桜吹雪がすごくてさ、本当にきれいでさ。\
	;-音声;----------------------------------
	mov $_voice,"XE7302"
	mov $debugstr,"音声：XE7302"
	gosub *vo

	【菜摘先生】
	うん。\
	dwavestop CH_VOICE	;XE7302

	【$g_hero】
	菜摘先生が、桜の精みたいに見えた。
	消えちゃいそうだなって。\
	;-音声;----------------------------------
	mov $_voice,"XE7303"
	mov $debugstr,"音声：XE7303"
	gosub *vo

	【菜摘先生】
	すごいこと言うね。\
	dwavestop CH_VOICE	;XE7303

	【$g_hero】
	そうかな…？\
	;-音声;----------------------------------
	mov $_voice,"XE7304"
	mov $debugstr,"音声：XE7304"
	gosub *vo

	【菜摘先生】
	そんなに綺麗なものじゃないと思うけど。\
	dwavestop CH_VOICE	;XE7304

	【$g_hero】
	綺麗だよ。すごく。\

	恥ずかしいのか、そっぽをむいて
	そんなことを言う。\

	【菜摘先生】
	………………………。\

	こっちだって、恥ずかしいんだけれど。
	でも…妙にくすぐったい気持ちになる。\

	【$g_hero】
	まあ…でも桜の精はこまるな。
	すぐに散って消えちゃいそうだから。\

	【$g_hero】
	でも、消えちゃいそうになったら
	僕が、がしって掴んで引き戻すから。\
	;-音声;----------------------------------
	mov $_voice,"XE7305"
	mov $debugstr,"音声：XE7305"
	gosub *vo

	【菜摘先生】
	……うん。\
	dwavestop CH_VOICE	;XE7305

	【$g_hero】
	音楽室行こうよ。
	僕、菜摘にピアノ弾いてもらいたいな。\
	;-音声;----------------------------------
	mov $_voice,"XE7306"
	mov $debugstr,"音声：XE7306"
	gosub *vo

	【菜摘先生】
	いいよ。何を弾いて欲しい？\
	dwavestop CH_VOICE	;XE7306

	【$g_hero】
	そうだな…。それじゃね…。\

	彼は私の耳元に唇を寄せてささやいた。
	そんなことが嬉しくてたまらなかった。\

	愛か恋か、確かな単語になんてできないけれど。
	永遠につづく何かはないけれど。\

	君が居るね。ここに居るね。
	わたしは居るよ。ここに居るよ。\

	それだけは、ずっと変わらないから。
	それを伝えたいと思うから。\
	;-音声;----------------------------------
	mov $_voice,"XE7307"
	mov $debugstr,"音声：XE7307"
	gosub *vo

	【菜摘先生】
	音楽室に行くまで、
	手…にぎっていいかな。\
	dwavestop CH_VOICE	;XE7307

	【$g_hero】
	もちろん。\

	だから、わたしはあなたの手を取り
	微笑みながら歩いていくわ。\

	return	;----------------------------------
;---E73  END -----
