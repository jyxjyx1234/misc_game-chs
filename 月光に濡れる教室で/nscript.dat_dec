;ＢＧ：BG015A;裏庭

	裏庭には当然ながら、誰もいなかった。\

	小夜子は黙って、僕を見ている。
	僕は空を向いて深呼吸をした。\

	きんと冷えた空気を胸一杯に吸い込むと、自分の
	血液に冷たい水銀を流し込んだような気分になる。\

	【$g_hero】
	…昨日のことなんだけどさ。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TDG"
	mov $debugstr,"立ち：TDG "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"DD0400"
	mov $debugstr,"音声：DD0400"
	gosub *vo

	【小夜子】
	はい。\
	dwavestop CH_VOICE	;DD0400
	gosub *clear_char

	【$g_hero】
	あれは…。\
	gosub *musicstop

	その瞬間だった。\
	;--背景;----------------------------------
	mov $_bg,"WHITE"
	mov $debugstr,"ＢＧ：WHITE "
	mov %effect,1	;エフェクトを指定
	gosub *out	;画面に出力
	;-効果音;----------------------------------
	mov $_se,"ZDOSA"
	mov $debugstr,"ＳＥ：ZDOSA "
	gosub *se
	gosub *GURA	;GURAを呼び出し

	ドサッ…！\
	;--背景;----------------------------------
	mov $_bg,"BG015A"
	mov $debugstr,"ＢＧ：BG015A"
	gosub *out	;画面に出力

	妙に重い音がした。\

	【$g_hero】
	え…？\

	何があったのか、ふたりともわからなかった。
	ほんの２、３ｍほど先。校舎のすぐそば。\

	地面に誰かが倒れ込んでいるようだった。
	僕とおなじ制服。男子だけれど。\

	けれど、何か赤いものが。\
	;--背景;----------------------------------
	mov $_bg,"BG015A"
	mov $debugstr,"ＢＧ：BG015A"
	gosub *out	;画面に出力
	;--立ちキャラ;----------------------------------
	mov $_char,"TDD"
	mov $debugstr,"立ち：TDD "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"DD0401"
	mov $debugstr,"音声：DD0401"
	gosub *vo

	【小夜子】
	あ……。\
	dwavestop CH_VOICE	;DD0401
	gosub *anime_bloodB	;anime_bloodBを呼び出し

	赤い液体はどんどんどんどん広がって
	乾燥して白っぽかった地面を赤黒く染めていく。\

	【$g_hero】
	……あ………。\
	;-効果音;----------------------------------
	mov $_se,"ZDOKUN"
	mov $debugstr,"ＳＥ：ZDOKUN"
	gosub *se

	声がでない。\

	赤いもの…ちがう。赤い液体がどんどんどんどん
	僕の方に流れて伝わってくる。\
	;-効果音;----------------------------------
	mov $_se,"ZDOKUN2"
	mov $debugstr,"ＳＥ：ZDOKUN2 "
	gosub *se

	僕は凍り付いたようにそれを見ていた。
	男の子はぴくりとも動かない。\

	気が付くと、彼の首はできるわけのない方向に
	ぎゅっとねじれていた。\
	gosub *clear_char
	;-音声;----------------------------------
	mov $_voice,"DD0402"
	mov $debugstr,"音声：DD0402"
	gosub *vo

	【小夜子】
	いやぁあぁああああああああぁあっ！！！！\
	dwavestop CH_VOICE	;DD0402

	【$g_hero】
	小夜子！！！\

	ようやく止まっていた僕の時間が動いた。
	僕は荒く息をして、小夜子を抱きしめた。\
	;-音声;----------------------------------
	mov $_voice,"DD0403"
	mov $debugstr,"音声：DD0403"
	gosub *vo

	【小夜子】
	先輩ッ！先輩ッ！先輩ッ！
	いやっ！いやっ！いやっ！！！\
	dwavestop CH_VOICE	;DD0403

	僕はただただ必死で小夜子を抱きしめた。
	腕の中の小夜子のぬくもりに僕はすがった。\

	校舎の職員室のある方から声が聞こえる。
	窓から誰かが叫んでいるみたいだ。\
	;-効果音;----------------------------------
	mov $_se,"Z119"
	mov $debugstr,"ＳＥ：Z119"
	gosub *se

	どこか遠くでサイレンが聞こえる。\
