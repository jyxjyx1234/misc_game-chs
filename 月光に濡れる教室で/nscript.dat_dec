*B24	; ■ファイル開始のラベル
	mov $debugstr,"■B24 " : gosub *debugout
;■■■「月光に濡れる教室で、僕は。」台本：●真実：帰宅後：B24
;━━━━━━━━━━━━━━
;●真実：帰宅後

	;--BGM;----------------------------------
	mov $_music,"12": gosub *out
;BGM:桜井　真実
	;--背景;----------------------------------
	mov $_bg,"BG004B"
	mov $debugstr,"ＢＧ：BG004B"
	gosub *out	;画面に出力
;真実の部屋
	;--立ちキャラ;----------------------------------
	mov $_char,"TBJ"
	mov $debugstr,"立ち：TBJ "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"BB2400"
	mov $debugstr,"音声：BB2400"
	gosub *vo

	【真実】
	ただいま。\
	dwavestop CH_VOICE	;BB2400

	家には誰もいない。
	…よかった。今日も兄さんがいない。\

	春休みの旅行とかで、大学の友人のところに
	泊まりに行ってるから、今月は
	帰ってこないはずだけれど。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TBA"
	mov $debugstr,"立ち：TBA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"BB2401"
	mov $debugstr,"音声：BB2401"
	gosub *vo

	【真実】
	でもよかった。\
	dwavestop CH_VOICE	;BB2401

	兄さんに何も言われないですむもの。\

	コートをハンガーに掛けて、ベッドに
	座り込んだ。さっき見た月が出てる。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TBG"
	mov $debugstr,"立ち：TBG "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"BB2402"
	mov $debugstr,"音声：BB2402"
	gosub *vo

	【真実】
	今頃、どうしてるかな…。\
	dwavestop CH_VOICE	;BB2402

	$g_fname君のことを思う。\

	変なの。
	へんなことしてるよね。わたしたち。\

	前から気にはなっていたんだ。
	あのひと、知らないだろうけど。\

	観察していた。見てた。
	だって気になるんだもの。\

	$g_fname君のお兄さん。
	去年の卒業生だから、わたしも知ってる。\

	兄さんも気にしてたし、してるし。すごく。\

	だけど、あの有名なひとと比べたら、
	うちの兄さんなんて、ちいさな星くず。\

	世の中に、何でも与えられた人がいるんだって
	もう、うらやむ事もできないぐらいのレベルで。\

	カサッ…。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TBD"
	mov $debugstr,"立ち：TBD "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"BB2403"
	mov $debugstr,"音声：BB2403"
	gosub *vo

	【真実】
	あ、チョコレート…。\
	dwavestop CH_VOICE	;BB2403

	机の上。２月からずっと置きっぱなしだった。
	彼のことを思って買って。でも渡せなくって。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TBA"
	mov $debugstr,"立ち：TBA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"BB2404"
	mov $debugstr,"音声：BB2404"
	gosub *vo

	【真実】
	そういえば、バレンタインデーに
	たくさん渡されてたな。お兄さんにって。\
	dwavestop CH_VOICE	;BB2404

	去年も、今年も。\

	うちの学園で、そういう行事って
	あんまり目立たないから、すごかったな。\

	でも、彼、おもしろかったな。
	わかったって言って、てきとうな紙袋に
	どさどさ入れて。\

	すごく高そうなゴ○ィバとか、
	手作りのチョコとかも、気にせずに。\

	福崎君が「イヤになんねぇの」って聞いたら、
	なるよって、平然と言うんだもの。
	おかしかったな。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TBB"
	mov $debugstr,"立ち：TBB "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"BB2405"
	mov $debugstr,"音声：BB2405"
	gosub *vo

	【真実】
	やっぱり今日もヘンなひとだったな。\
	dwavestop CH_VOICE	;BB2405

	もっと兄さんみたいに田口君みたいに
	モノみたいにあつかったりするのかと思ってた。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TBG"
	mov $debugstr,"立ち：TBG "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"BB2406"
	mov $debugstr,"音声：BB2406"
	gosub *vo

	【真実】
	ヘンなひと。
	あんなこと、したのに。\
	dwavestop CH_VOICE	;BB2406

	…でも、あんな風に話をして。\

	…すごく…照れた。
	すごく…どきどきした。\

	やっぱり、わたし、
	あのひとのこと…。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TBG"
	mov $debugstr,"立ち：TBG "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"BB2407"
	mov $debugstr,"音声：BB2407"
	gosub *vo

	【真実】
	…好きなのかな。\
	dwavestop CH_VOICE	;BB2407

	あんなことされたのに、好きなのかな。
	それでも…好きみたい。\

	どうしてだろう。\

	明日。また、するのかな。\

	いやだなと思う。でも、いいと思う。
	両方、ううん。たくさんの気持ちが
	削れない自分がいる。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TBJ"
	mov $debugstr,"立ち：TBJ "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"BB2408"
	mov $debugstr,"音声：BB2408"
	gosub *vo

	【真実】
	チョコ…渡せばよかったな。\
	dwavestop CH_VOICE	;BB2408

	思ってるだけじゃ、足りない。
	君のことがもっと欲しい。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TBG"
	mov $debugstr,"立ち：TBG "
	gosub	*out	;画面に出力

	$g_hero君。
	わたしヘンだよ。\

	君のことばかり、考えている。\
	gosub *blackout

	return	;----------------------------------
;---B24  END -----
