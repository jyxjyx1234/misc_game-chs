	mov $_voice,"CC10407"
	mov $debugstr,"音声：CC10407 "
	gosub *vo

	【明海】
	私…警察に届けない。\
	dwavestop CH_VOICE	;CC10407 

	僕は、明海がそんな風に言うことを
	予想していたのかもしれない。\

	だからだろうか…。
	僕は、それほど驚かなかった。\
