*D72	; ■ファイル開始のラベル
	mov $debugstr,"■D72 " : gosub *debugout
;■■■「月光に濡れる教室で、僕は。」台本：●篤子ちゃんが丹羽のところへ。：D72
;━━━━━━━━━━━━━━
;●篤子ちゃんが丹羽のところへ。
;☆☆☆★★★ここで、香津実の悪口を言って、心変わりを…★★★
;丹羽と。

	;--BGM;----------------------------------
	mov $_music,"05": gosub *out
;BGM:楽
	;--背景;----------------------------------
	mov $_bg,"BG035B"
	mov $debugstr,"ＢＧ：BG035B"
	gosub *out	;画面に出力
;ＢＧ：BG035B;繁華街
	;--立ちキャラ;----------------------------------
	mov $_char,"TTC"
	mov $debugstr,"立ち：TTC "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"XD7200"
	mov $debugstr,"音声：XD7200"
	gosub *vo

