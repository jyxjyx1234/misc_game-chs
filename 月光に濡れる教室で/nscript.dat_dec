	mov $debugstr,"■C05 " : gosub *debugout
;■■■「月光に濡れる教室で、僕は。」台本：●聖母子像のカード：B05
;━━━━━━━━━━━━━━
;●聖母子像のカード

	;--BGM;----------------------------------
	mov $_music,"13": gosub *out
	gosub *blackout
	;--背景;----------------------------------
	mov $_bg,"BG015A"
	mov $debugstr,"ＢＧ：BG015A"
	gosub *out	;画面に出力
;ＢＧ：BG015A;裏庭
;キミ
	;--立ちキャラ;----------------------------------
	mov $_char,"TCA"
	mov $debugstr,"立ち：TCA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC0500"
	mov $debugstr,"音声：CC0500"
	gosub *vo

	【明海】
	ねえ、$g_fname君。\
	dwavestop CH_VOICE	;CC0500

	【$g_hero】
	は、はい。\

	先輩の…迷いのない真っ直ぐな目。
	僕はその目に晒されて、情けない位に狼狽えた。\

	大体。
	先輩から言い出させるなんて卑怯じゃないか？\

	……そりゃ僕だって、逃げ回っていてこうなった
	わけじゃないけどさ……。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCI"
	mov $debugstr,"立ち：TCI "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC0501"
	mov $debugstr,"音声：CC0501"
	gosub *vo

	【明海】
	昨日の事なんだけど……。\
	dwavestop CH_VOICE	;CC0501

	【$g_hero】
	あ…あのさ…………………。
	その…昨日は……。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCA"
	mov $debugstr,"立ち：TCA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC0502"
	mov $debugstr,"音声：CC0502"
	gosub *vo

	【明海】
	あ、いいの。あの事で、キミを責めたくて待って
	たわけじゃないから。\
	dwavestop CH_VOICE	;CC0502

	僕はポカンとした。\

	【$g_hero】
	へ？　じゃ、じゃあ……。\

	;--BGM;----------------------------------
	mov $_music,"09": gosub *out
	;--立ちキャラ;----------------------------------
	mov $_char,"TCE"
	mov $debugstr,"立ち：TCE "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC0503"
	mov $debugstr,"音声：CC0503"
	gosub *vo

	【明海】
	これを見て欲しいの。\
	dwavestop CH_VOICE	;CC0503

	先輩は、制服の内ポケットから１枚のカードを
	取り出した。\
	;--背景;----------------------------------
	mov $_bg,"ANGEL"
	mov $debugstr,"ＢＧ：ANGEL "
	gosub *out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC0504"
	mov $debugstr,"音声：CC0504"
	gosub *vo

	【明海】
	これ、キミが送ったんじゃなかったんだよね？\
	dwavestop CH_VOICE	;CC0504

	それは、質問じゃなかった。
	先輩は、僕に何かの確認をしていた。\

	確認って、多分それは
	先輩の推理のようなモノをだ。\

	【$g_hero】
	それは…！！\

	僕は、先輩の手の中のカードを食い入るように
	見つめた。\

	微笑む聖母マリアと幼子イエス。
	羅列された知らない言葉。
	夜の教室で見たものと同じもの。\

	僕は、うわずった声をあげた。\

	【$g_hero】
	僕も……。
	これと同じカードが、挟んであったんだ…。\

	【$g_hero】
	ノートを教室に忘れて行って…その間に…。\

	先輩は、真剣な面持ちで僕を見た。\
	;--背景;----------------------------------
	mov $_bg,"BG015A"
	mov $debugstr,"ＢＧ：BG015A"
	gosub *out	;画面に出力
	gosub *clear_char
	;--立ちキャラ;----------------------------------
	mov $_char,"TCE"
	mov $debugstr,"立ち：TCE "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC0505"
	mov $debugstr,"音声：CC0505"
	gosub *vo

	【明海】
	同じものだったのね？\
	dwavestop CH_VOICE	;CC0505

	【$g_hero】
	うん。これと、同じものだったと思う。\

	先輩は、僕を見つめている。
	あの真っ直ぐな瞳で。\

	ずっと…その目を見返すことが難しかったけど、
	今度はちゃんと受けとめることができた。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCI"
	mov $debugstr,"立ち：TCI "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC0506"
	mov $debugstr,"音声：CC0506"
	gosub *vo

	【明海】
	そう……私も同じだわ。\
	dwavestop CH_VOICE	;CC0506
	;--立ちキャラ;----------------------------------
	mov $_char,"TCA"
	mov $debugstr,"立ち：TCA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC0507"
	mov $debugstr,"音声：CC0507"
	gosub *vo

	【明海】
	この前ね、急な用事で学生会室に行くのに
	鞄を教室に置いていったの。\
	dwavestop CH_VOICE	;CC0507
	gosub *clear_char
	gosub *blackout
	gosub *mono_on
	;--背景;----------------------------------
	mov $_bg,"BG011A"
	mov $debugstr,"ＢＧ：BG011A"
	gosub *out	;画面に出力
;;３年教室
	;-音声;----------------------------------
	mov $_voice,"CC0508"
	mov $debugstr,"音声：CC0508"
	gosub *vo

	【明海】
	用事自体はすぐに終わったわ。
	遅くなっていたし、早く帰ろうと思ってた。\
	dwavestop CH_VOICE	;CC0508
	;-音声;----------------------------------
	mov $_voice,"CC0509"
	mov $debugstr,"音声：CC0509"
	gosub *vo

	【明海】
	教室に戻ったら…鞄がすこしだけ開いていて…
	おかしいと思ったわ。\
	dwavestop CH_VOICE	;CC0509
	;--背景;----------------------------------
	mov $_bg,"ANGEL"
	mov $debugstr,"ＢＧ：ANGEL "
	gosub *out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC0510"
	mov $debugstr,"音声：CC0510"
	gosub *vo

	【明海】
	そうしたら…鞄の前ポケットに
	このカードが挟まってたの。\
	dwavestop CH_VOICE	;CC0510
	gosub *blackout
	gosub *mono_off
	;--背景;----------------------------------
	mov $_bg,"BG015A"
	mov $debugstr,"ＢＧ：BG015A"
	gosub *out	;画面に出力

	【$g_hero】
	そんな事が……。\

	ならば、先輩のカードの裏にも僕と同じように
	指示が書かれていたのだろうか。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCA"
	mov $debugstr,"立ち：TCA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC0511"
	mov $debugstr,"音声：CC0511"
	gosub *vo

	【明海】
	ねぇ、キミのカードは？\
	dwavestop CH_VOICE	;CC0511

	【$g_hero】
	そういえば……どうしたっけ……？\

	しまった！　僕は慌てた。
	鞄を引っかき回すまでもない。\

	昨日のゴタゴタのせいで、すっかり頭から
	消え去っていた。マズイ…。\

	また教室に置きっぱなしにしてしまったかも
	しれない。\

	【$g_hero】
	机に置きっぱなしだとマズイ…マズイぞ…
	……ちょっと取りに行ってくる。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCE"
	mov $debugstr,"立ち：TCE "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC0512"
	mov $debugstr,"音声：CC0512"
	gosub *vo

	【明海】
	私も行くわ。授業開始までまだ時間もあるし。\
	dwavestop CH_VOICE	;CC0512

	先輩もついて来てくれるのか。
	それは嬉しかったけど、何だか不思議だった。\

	学園で一緒に歩いたり、声をかけられたりするの
	あんなにイヤがっていたのに。\

	【$g_hero】
	じゃあ……行こうか。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCA"
	mov $debugstr,"立ち：TCA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC0513"
	mov $debugstr,"音声：CC0513"
	gosub *vo

	【明海】
	ええ。行きましょう。\
	dwavestop CH_VOICE	;CC0513
	gosub *clear_char

	僕たちは教室に向かおうとした。
	その瞬間。\
	;-効果音;----------------------------------
	mov $_se,"ZOTOSU"
	mov $debugstr,"ＳＥ：ZOTOSU"
	gosub *se
;

	ヒュッ。
	黒い影が、空から落ちて来た。\

	【$g_hero】
	え…？\
	gosub *musicstop
	;--背景;----------------------------------
	mov $_bg,"WHITE"
	mov $debugstr,"ＢＧ：WHITE "
	mov %effect,1	;エフェクトを指定
	gosub *out	;画面に出力
	;-効果音;----------------------------------
	mov $_se,"ZDOSA"
	mov $debugstr,"ＳＥ：ZDOSA "
	gosub *se
	gosub *GURA	;GURAを呼び出し

	ドサッ…！\
	;--背景;----------------------------------
	mov $_bg,"BG015A"
	mov $debugstr,"ＢＧ：BG015A"
	gosub *out	;画面に出力

	妙に重い音が、僕たちの背後で聞こえた。\

	黒い影は、翼のようなものを翻したように見えた。\

	鳥？
	でも、こんな地上に近い場所で？\

	僕は、無防備にふり返る。
	ほんの２、３ｍほど先。校舎のすぐそば。\

	最初は何かわからなかった。
	わからない恐ろしさと不安が、僕の体の動きを
	縛っていた。\
	;--背景;----------------------------------
	mov $_bg,"BG015A"
	mov $debugstr,"ＢＧ：BG015A"
	gosub *out	;画面に出力
	;--立ちキャラ;----------------------------------
	mov $_char,"TCA"
	mov $debugstr,"立ち：TCA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC0514"
	mov $debugstr,"音声：CC0514"
	gosub *vo

	【明海】
	どうしたの？\
	dwavestop CH_VOICE	;CC0514
	;--立ちキャラ;----------------------------------
	mov $_char,"TCD"
	mov $debugstr,"立ち：TCD "
	gosub	*out	;画面に出力

	【明海】
	………………………！！！\

	僕が立ち止まったのに気づいた先輩が、僕を見て、
	それから僕のむこうの何かを見た。\

	ヒュッと。
	今度は、先輩のノドが鳴った。\

	地面にふわりと広がった制服のスカートと
	黒く長い髪と、赤い、何か。\
	gosub *anime_bloodB	;anime_bloodBを呼び出し

	赤いものはどんどんどんどん広がって
	白っぽかった地面を赤黒く染めていく。\
	;-音声;----------------------------------
	mov $_voice,"CC0515"
	mov $debugstr,"音声：CC0515"
	gosub *vo

	【明海】
	あ……。\
	dwavestop CH_VOICE	;CC0515

	【$g_hero】
	……あ………。\
	;-効果音;----------------------------------
	mov $_se,"ZDOKUN"
	mov $debugstr,"ＳＥ：ZDOKUN"
	gosub *se

	声がでない。\

	これは何だ？
	地面に横たわっているのは何だ？\
	;-効果音;----------------------------------
	mov $_se,"ZDOKUN2"
	mov $debugstr,"ＳＥ：ZDOKUN2 "
	gosub *se

	赤いものが、どんどんどんどん
	僕の方にのびてくる。\

	思考回路がちっとも働かない。
	時間が止まったみたいだ。\

	指先も動かせないようなのに、なぜか体全体が
	熱で浮かされたようにぶるぶると震えた。\
	gosub *sestop

	;--BGM;----------------------------------
	mov $_music,"03": gosub *out
;BGM:怒
	;--背景;----------------------------------
	mov $_bg,"BG015A"
	mov $debugstr,"ＢＧ：BG015A"
	gosub *out	;画面に出力
	;--立ちキャラ;----------------------------------
	mov $_char,"TCH"
	mov $debugstr,"立ち：TCH "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC0516"
	mov $debugstr,"音声：CC0516"
	gosub *vo

	【明海】
	…うそ……イヤ………。\
	dwavestop CH_VOICE	;CC0516
	gosub *clear_char

	先輩がぺたりと尻餅をつくようにして
	座り込んでしまった。\

	イヤイヤと、力なく首を左右に振っている。
	なのに、先輩はその赤黒い塊から目がそらせない。\

	それは僕も同じことだった。
	膝から力が抜けてまともに動くこともできない。\

	【$g_hero】
	あけみ…ちゃん……。\

	僕は這いずるようにして、先輩に近づいた。
	まるで全てが、夢のなかの出来事みたいだった。\

	重たい水の中にいるみたいに、僕は
	うまく体が動かせない。\

	ようやく先輩が手に届くところまで近づく。
	僕は、先輩の頭を抱え込むようにして抱きしめた。\

	校舎の職員室のある方から声が聞こえる。
	窓から誰かが叫んでいるみたいだ。\
	;-効果音;----------------------------------
	mov $_se,"Z119"
	mov $debugstr,"ＳＥ：Z119"
	gosub *se

	どこか遠くでサイレンが聞こえる。
	それを僕は、惚けた頭で聞いていた。\
	gosub *blackout
	gosub *sestop

	return	;----------------------------------
;---C05  END -----
