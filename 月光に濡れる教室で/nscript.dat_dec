	;============================================
*CGB1_wait
	btnwait %work
	if %work==MOUSE_RBUTTON  gosub *click : csp -1 : goto *cg_select
	if %work==KEY_ESCAPE     gosub *click : csp -1 : goto *cg_select
	if %work==31 gosub *cg_megane : goto *CGB1
	if %work==32 gosub *click : csp -1:goto *CGB1 ; Page1
	if %work==33 gosub *click : csp -1:goto *CGB2 ; Page2
	if %work==34 gosub *click : csp -1:goto *cg_select ; 戻る
	dec %0
	if %work<0   goto *CGB1_wait
	tablegoto %0,*CG_B01A,*CG_B01B,*CG_B02A,*CG_B03A,*CG_B03B,*CG_B04A,*CG_B05A,*CG_B06A,*CG_B06B,*CG_B07A,*CG_B08A,*CG_B09A,*CG_B09B,*CG_B10A,*CG_B11A,*CG_B12A,*CG_B12B,*CG_B13A,*CG_B14A,*CG_B15A,*CG_B15B,*CG_B16A,*CG_B16B,*CG_B16C,*CG_B16D,*CG_B16E,*CG_B16F,*CG_B17A,*CG_B17B,*CG_B17C
	goto *CGB1_wait
	;============================================
*cg_megane
	gosub *click
	csp -1
	if %g_nomegane==ON  mov %g_nomegane,OFF return
	if %g_nomegane==OFF mov %g_nomegane,ON  return
	return ; safety 1st.

