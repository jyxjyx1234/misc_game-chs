;ＢＧ：BG014A;校門
	;-効果音;----------------------------------
	mov $_se,"ZZAWA"
	mov $debugstr,"ＳＥ：ZZAWA "
	gosub *se

	校舎に入る前に、一瞬、ためらった。\

	【$g_hero】
	まさか、今日も
	なんかあるんじゃないだろうな…。\

	ため息をついて、校舎を見あげる。\

	【$g_hero】
	二度あることは三度あるというもんな…。\

	あんなものどっちだって一生に
	１回みれば十分だと思うけど。\

	立ち止まっている間に、
	色々な人間がすれ違っていく。\

	みんな、いつもよりも声をひそめて、
	だけど妙に興奮していた。\

	怯えと…どこか浮かれたような雰囲気。\

	実感が、ないんだろうな…。
	きっと僕だってそうだ。あんな物を見なければ。\

	たとえ同じ街で殺人が起きたって、
	実際に見なければ、
	ふ～んで終わってしまうんだ。\
	;-音声;----------------------------------
	mov $_voice,"XC9000"
	mov $debugstr,"音声：XC9000"
	gosub *vo

	【女子学生１】
	残念、今日はさすがになかったねー。\
	dwavestop CH_VOICE	;XC9000
