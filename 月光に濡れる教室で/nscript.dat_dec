*C86	; ■ファイル開始のラベル
	mov $debugstr,"■C86 " : gosub *debugout
;■■■「月光に濡れる教室で、僕は。」台本：●明海の懊悩：B86
;━━━━━━━━━━━━━━
;●明海の懊悩

	;--BGM;----------------------------------
	mov $_music,"06": gosub *out
	;--背景;----------------------------------
	mov $_bg,"BG006B"
	mov $debugstr,"ＢＧ：BG006B"
	gosub *out	;画面に出力
;ＢＧ：BG006A;明海の部屋
;辛くて苦しいのは本当ですが
;どこか現実から浮遊した苦しみ
	;--立ちキャラ;----------------------------------
	mov $_char,"TCC"
	mov $debugstr,"立ち：TCC "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC8600"
	mov $debugstr,"音声：CC8600"
	gosub *vo

	【明海】
	……………私。
	…言ってよかったのかしら？\
	dwavestop CH_VOICE	;CC8600

	あなたを…巻き込みたくなかったの。
	だからずっと黙っていた。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCF"
	mov $debugstr,"立ち：TCF "
	gosub	*out	;画面に出力
;【明海】［ポ］

	でも私…うれしいと思ってる。\

	キミが、私を抱きしめてくれて…
	大丈夫だよって言ってくれて…。\

	それを信じられるって思ったの。
	ずっと…苦しかったの。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCJ"
	mov $debugstr,"立ち：TCJ "
	gosub	*out	;画面に出力
;【明海】［困］

	あのとき…。
	……………………。\

	コーヒーを飲んだ赤いシャツのあの人が、
	倒れて…動かなくなって……。\

	人を殺したって思ったとき。
	私…怖かった…恐ろしかった…。\

	目の前が真っ暗になって。
	周りの音がどんどん遠くなって。\

	なのに…目が覚めたら
	殺したはずの…死体がなくなっていて。\

	悪い夢だと思いたかった。
	でも、そんなことは許されなくて。\

	携帯があって、メールが来て。\

	“───おまえの罪を知っている”\

	…………………。
	私の罪。\

	誰かを殺してしまったかもしれない。
	その───罪。\

	怖くて…恐ろしくて…。
	だから、メールの通りに…言うことを聞いて。\

	そうしたら…………。
	…………………………。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCH"
	mov $debugstr,"立ち：TCH "
	gosub	*out	;画面に出力
;【明海】［泣］

	…汚れて……しまったのかもしれない。
	いいえ…汚れてしまったの。\

	汚されてしまったと……。
	そう思ったわ。\

	辛かった…苦しかった…。
	どうして、私が…って…思って。\

	誰にも言えなくて…一人で…ただ苦しくて…。\

	忘れられなくて…でも忘れたくて…。
	髪を切ったの。\

	背中までのばしてた。
	短くしたことなんてなかった。\

	長い…長かった髪を。
	夜明け前に、自分で…切ったの。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCC"
	mov $debugstr,"立ち：TCC "
	gosub	*out	;画面に出力
;【明海】［困］

	でもメールはやってきて。
	私は、罰を受けつづけて。\

	誰にも言えなかった。
	だけど…助けて欲しかった。\

	いつでも心で叫んでた。
	本当は呼んではいけないのに。\

	私は、汚れてしまったから。
	私は、罪を犯したから。\

	だけど、だけど……！！
	私…私は……。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCH"
	mov $debugstr,"立ち：TCH "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC8601"
	mov $debugstr,"音声：CC8601"
	gosub *vo

	【明海】
	私は…あなたに……。
	助けて………欲しかったの。\
	dwavestop CH_VOICE	;CC8601
	gosub *blackout

	return	;----------------------------------
;---C86  END -----
