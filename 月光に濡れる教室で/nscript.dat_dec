*C04	; ■ファイル開始のラベル
	mov $debugstr,"■C04 " : gosub *debugout
;■■■「月光に濡れる教室で、僕は。」台本：●裏庭へ：B04
;━━━━━━━━━━━━━━
;●裏庭へ

	;--BGM;----------------------------------
	mov $_music,"02": gosub *out
	;--背景;----------------------------------
	mov $_bg,"BG014A"
	mov $debugstr,"ＢＧ：BG014A"
	gosub *out	;画面に出力
;ＢＧ：BG014A;校門

	僕たちは、並んで校門の前までやってきた。
	傍から見れば、仲のよいカップルのように
	見えたかもしれない。\

	歩きながら、僕は先輩に尋ねた。\

	【$g_hero】
	ところでさ、どうして僕を待ってたの？\

	起きた時、あれだけ悩んでいたのが嘘みたいに、
	言葉がするすると出てきた。\

	並んで歩いてきたのは、たったの１０分。
	その間で何が変わったというわけでもないのに。\

	ただ並んで歩いただけなのに。
	こうして話せる気分になるのが、不思議だった。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCJ"
	mov $debugstr,"立ち：TCJ "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC0400"
	mov $debugstr,"音声：CC0400"
	gosub *vo

	【明海】
	話したいことがあったから…。
	その…昨日の事で……。\
	dwavestop CH_VOICE	;CC0400

	【$g_hero】
	…そっか…ここじゃまずい…よな。\

	登校中の学生が、結構な数歩いている。
	校門の前だから当然か。\

	昨日の事もあって、二人きりでいるところを
	からかわれるのは、居心地が悪そうだった。\
;それに僕も…多分先輩も、あまり嘘を吐くのは
;上手じゃない。
;<CR>
;何かを訊かれて、狼狽えるのも良くないだろう。
;煙のない所にだって、噂は立つんだから。
;<CR>

	僕は、すばやく辺りを見渡した。\

	【$g_hero】
	じゃあ、なるべく人目のつかない場所で。
	裏庭とかがいいかな。\

	そう言った途端、僕は後悔した。\

	昨日の今日なのに、デリカシーに欠けるにも
	程がある。\

