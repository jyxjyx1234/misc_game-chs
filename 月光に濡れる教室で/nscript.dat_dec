	;-効果音;----------------------------------
	mov $_se,"ZSUZUME"
	mov $debugstr,"ＳＥ：ZSUZUME "
	gosub *se
;ＳＥ：ZSUZUME;スズメ

	【$g_hero】
	朝か…。ふぁああ…起きないと。
	あ～、はやく春休みにならないかなぁ～。\

	【$g_hero】
	春休み…どっか行きたいな…。菜摘先生と
	デート…って金ないから泊まりは無理か。\

	【$g_hero】
	安いとこなら泊まれるだろうけど
	女のひと連れてくんだからなぁ…。\

	【$g_hero】
	バイト…は…無理かなぁ…。親は反対しない
	だろうけど、菜摘先生の方が反対しそう。\

	【$g_hero】
	うーん、近場にピクニックとか…。
	それもいいかも…\

	【$g_hero】
	菜摘先生が手作りお弁当作ってくれたら
	うれしいな～\

	そりゃガッコで会ってるし、Ｈもしてもらって
	すごいイイとは思うんだけど。\

	いちゃいちゃするの…まだしてないもんな。
	そういうのしてみたいな。\

	手繋いでデートしたり。映画でもいいし。
	遊園地とか。とにかく一緒にいろんなもの見たい。\

	return	;----------------------------------
;---E30  END -----
