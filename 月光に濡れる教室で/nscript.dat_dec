*C50	; ■ファイル開始のラベル
	mov $debugstr,"■C50 " : gosub *debugout
;■■■「月光に濡れる教室で、僕は。」台本：●夜：出かける：B50
;━━━━━━━━━━━━━━
;●夜：出かける

	;--BGM;----------------------------------
	mov $_music,"07": gosub *out
	;--背景;----------------------------------
	mov $_bg,"BG001B"
	mov $debugstr,"ＢＧ：BG001B"
	gosub *out	;画面に出力
;ＢＧ：BG001B;主人公の部屋（夜）

	【$g_hero】
	さてと…出かけるかな。\
	;--背景;----------------------------------
	mov $_bg,"BG002B"
	mov $debugstr,"ＢＧ：BG002B"
	gosub *out	;画面に出力
	;-効果音;----------------------------------
	mov $_se,"ZDOORC"
	mov $debugstr,"ＳＥ：ZDOORC"
	gosub *se
;ＢＧ：BG002B;主人公の家（夜）

	【$g_hero】
	うわ、さむっ…！\

	吐く息は白かった。歩き始めると寒さで耳が痛い。
	ポケットに手を突っ込んで早足で歩く。\

	【$g_hero】
	やっぱり、この時間になると冷えるな…。
	…すっかり遅くなっちゃったぞ。…急がなくちゃ。\

	【$g_hero】
	………先輩は間に合ったんだろうか。\

	街灯が、ぽつりぽつりと夜の道を照らしてる。
	その輪の中を選ぶようにして歩く。\
	;--背景;----------------------------------
	mov $_bg,"BLACK"
	mov $debugstr,"ＢＧ：BLACK "
	gosub *out	;画面に出力
	gosub *musicstop
	;--背景;----------------------------------
	mov $_bg,"MOONA01"
	mov $debugstr,"ＢＧ：MOONA01 "
	gosub *out	;画面に出力

	月は明るかった。星はすくなかった。\

	月のひかりよりも、街灯のあかりの方が、
	ずっとやさしく見えた。\

	だって見あげれば、すぐそこに街灯はある。
	月は…僕からも、あまりにも遠い。\

	そして…どこか怖かった。
	月は、走っても、走っても、どこまでも
	僕を追いかける。\

	ああ、早く行かなくちゃ。
	昨日と同じように、昨日と同じ場所へ。
	そうして…また先輩と会って…。\

	【$g_hero】
	今日は違う…違うんだからな…。\

	先輩は、大丈夫。
	先輩は、きっと間に合っている。\

	僕たちは「天使」を待って。
	「天使」を捕まえて。\

	それから…先輩の知りたいことを、
	僕たちが「天使」から奪うんだ。\

	僕たちだけが、脅えているのはイヤだ。
	どうにかして、どうしてでも、何かしなくちゃ。\

	ああ、だから。
	早く、早く、行かないと。\

	間に合う内に。
	間に合わなくなる前に。\

	僕は、夜の校舎へとむかって走った。
	息が切れるまで走っていった。\

	───ひとりの道は、どこまでもどこまでも
	つづいているような気がした。\

	ほんの少しの道のりなのに。
	目指す場所へ、たどり着けない気がした。\
	gosub *blackout

	return	;----------------------------------
;---C50  END -----
