	熱い。体も、僕のペ○スも、真実の中も。\
	;-音声;----------------------------------
	mov $_voice,"BB0057"
	mov $debugstr,"音声：BB0057"
	gosub *vo

	【真実】
	あううっ！！！！\
	dwavestop CH_VOICE	;BB0057
	;-Ｈ効果音;----------------------------------
	mov $_se,"WC003"
	mov $debugstr,"Ｈ音：WC003 "
	gosub *se

	【$g_hero】
	！！！！！！！！！\

	目がくらむ。\
	;--背景;----------------------------------
	mov $_bg,"WHITE"
	mov $debugstr,"ＢＧ：WHITE "
	mov %effect,1	;エフェクトを指定
	gosub *out	;画面に出力
	;-Ｈ効果音;----------------------------------
	mov $_se,"WE002"
	mov $debugstr,"Ｈ音：WE002 "
	gosub *se
;ドピドピッ！
	;-- イベントCG;----------------------------------
	mov $_cg,"B03B"
	mov $debugstr,"ＣＧ：B03B"
	gosub *cgout	;イベントＣＧ

	ビュクッ！ビュクッ！ビュクンッ！！\
	;-音声;----------------------------------
	mov $_voice,"BB0058"
	mov $debugstr,"音声：BB0058"
	gosub *vo

	【真実】
	あ…あぁああっ…！！\
	dwavestop CH_VOICE	;BB0058

	真実の体がはねて、僕のペ○スがずるりと抜ける。
	白い精液が、真実の体の上に舞い散る。\
	;-Ｈ効果音;----------------------------------
	mov $_se,"WE001"
	mov $debugstr,"Ｈ音：WE001 "
	gosub *se
;大量にドピュッと出す（ひっかける）

	ビュブュ！ビュブブブッ！グビュッ！！\

	どこに入ってたんだろうと思うぐらい
	大量の精液が僕から放出される。\

	【$g_hero】
	はぁ…あ………。\

	荒い息をあげながら、虚脱感にも似た
	その快楽に僕は酔った。\

	真実は、ぐったりと倒れ込んだまま
	月あかりに濡れて光っている。\

	こんなにいやらしいことをしたのに、
	すごく奇麗だと、僕は思った。\

	【$g_hero】
	真実…もう一度…。\
	;-音声;----------------------------------
	mov $_voice,"BB0059"
	mov $debugstr,"音声：BB0059"
	gosub *vo

	【真実】
	あ…。\
	dwavestop CH_VOICE	;BB0059

	僕は真実を抱きかかえて、もう一度
	ゆっくりと貫いた。\
	gosub *blackout
	return
;●ＯＰ　ＥＮＤ

	月光のさしこむ教室で、僕は見た。\

	月明かりにさらされて光る白い背中のライン。
	ゆれる胸が、緩やかなカーヴを描く。\

	真実の熱い吐息と。僕の熱。
	精液の匂いと愛液の匂いと血液の匂い。\

	どうして体の一部を接触させて
	こうやって動いてるだけで\

	おかしいぐらい、気持ちがよくて
	笑ってしまうぐらい、心が騒ぐんだろう。\

	汗に濡れている肌がぬらりと光る。
	まるで月に濡れてるみたいだと思いながら。\

	僕は。\
	;----------------------------------
;---B00  END -----
