	mov $debugstr,"立ち：TCA "
	gosub	*out	;画面に出力
;【明海】［普］

	いや、そんな事はない。
	あれは紛れもない現実だった。\

	確かに、僕は目の前のこの人を抱いたんだ。
	いや、犯したんだ。\

	それが事実だ。
	誤魔化しようのない事実だ。\

	なのに先輩は、何事もなかったようにしている。\

	何事もなかったように振る舞いすぎて、
	普段よりもずっと軽やかに、僕に話しかける先輩。\

	優しい笑顔の先輩。
	僕の家までやって来た先輩。でも。\

	家は隣同士だけど、こんな風に呼びに来てたのは、
	もっと昔の頃だけじゃないか。\

	今は、こんな風に気軽に話すことさえ
	すごく難しかったじゃないか。\

	だったら……これは嘘じゃないか。\

	昨晩あった事は、やっぱり夢じゃなくて。
	現実に起きた事じゃないか……。\

	こんな…こんな誤魔化し方はズルイよ先輩。
	僕は、段々悲しくなって来た。\

	【$g_hero】
	いいんだよ、無理しなくてもさ……皆月先輩。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCC"
	mov $debugstr,"立ち：TCC "
	gosub	*out	;画面に出力
