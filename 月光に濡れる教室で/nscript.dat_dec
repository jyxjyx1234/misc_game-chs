	mov $debugstr,"■C116" : gosub *debugout
;■■■「月光に濡れる教室で、僕は。」台本：■５日目：バッドＥＤ：B116
;━━━━━━━━━━━━━━
;■５日目：バッドＥＤ
;殺されます。
;直接的な犯人は、丹羽。
;片山を殺したのも、丹羽。
;殺人教唆です。黒幕は先生。
;バッドエンドは、真実と同じでもいいかなぁ…。
;あるとしたら最後に
;暗転して、真っ暗画面で一行。
;「バイバイ、センパイ」
;●バッド：丹羽と「天使」
	gosub *blackout

	;--BGM;----------------------------------
	mov $_music,"06": gosub *out
	;--背景;----------------------------------
	mov $_bg,"BG021B"
	mov $debugstr,"ＢＧ：BG021B"
	gosub *out	;画面に出力
;BGM:愛
;天使の理屈（感覚？）がよくわかってない私…
;主人公が間違えると天使は、他の人の気持ちを優先させる。と、仮定する。

	誰もいない体育館。
	ぽつんと一つ影が生まれる。\

	影は、壇上を見ている。
	壇上には焼け焦げの跡が、生々しく残っている。\

	影は、そっとその跡に指で触れる。\

	【天使】
	よかったね。\

	その声は慈愛に満ちて優しかった。\

	【天使】
	…これで、君はもう何も悩まないですむ。
	君が、君自身でいることにも。\

	;--BGM;----------------------------------
