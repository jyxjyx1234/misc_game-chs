;============================================
*C00	; ■ファイル開始のラベル
	mov $debugstr,"■C00 " : gosub *debugout
;■■■「月光に濡れる教室で、僕は。」台本：■ＯＰ：B00
;━━━━━━━━━━━━━━
;■ＯＰＨ

	;--BGM;----------------------------------
	mov $_music,"04": gosub *out
	gosub *blackout
	;--背景;----------------------------------
	mov $_bg,"BG024B"
	mov $debugstr,"ＢＧ：BG024B"
	gosub *out	;画面に出力
;BGM:哀

	無人の筈の校庭に、ぽつんと佇む人影。
	月が、地面に長い影を作る。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCH"
	mov $debugstr,"立ち：TCH "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC0000"
	mov $debugstr,"音声：CC0000"
	gosub *vo

	【明海】
	本当に……キミが来るなんて…。\
	dwavestop CH_VOICE	;CC0000

	【$g_hero】
	え？先輩…？？\

	僕の声は、随分と間が抜けたものだった。
	どうして明海ちゃ…いや皆月先輩が？\

	両手と両足をきちんと揃えた先輩の姿。
	真っ直ぐに僕を見つめるその瞳。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCF"
	mov $debugstr,"立ち：TCF "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC0001"
	mov $debugstr,"音声：CC0001"
	gosub *vo

	【明海】
	待っていたわ…ずっと…ここで…。\
	dwavestop CH_VOICE	;CC0001

	先輩の声は、震えていた。\

	【$g_hero】
	ぼ、僕を？どうして？\

	先輩は、僕の問いかけには答えなかった。
	かわりに、黙って後ろを向いた。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCH"
	mov $debugstr,"立ち：TCH "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC0002"
	mov $debugstr,"音声：CC0002"
	gosub *vo

	【明海】
	ちゃんと…。ちゃんと、してきたから。\
	dwavestop CH_VOICE	;CC0002

	涙まじりの声だった。
	だけど、どこか甘い声だった。\

	どうしてだろう。
	どうして、そう思ってしまったんだろう。\
	gosub *clear_char

	先輩が、スカートを高くかかげた。
	スカートが大きく翻って、僕は言葉を失った。\
;gosub *blackout
;gosub *musicstop
	;-- イベントCG;----------------------------------
	mov $_cg,"C01A"
	mov $debugstr,"ＣＧ：C01A"
	gosub *cgout	;イベントＣＧ

	かすかに花の匂いがした。
	その香りにくらりとする。\

	ちいさな下着に包まれた先輩の下半身。
	そこから目をそらせなかった。\
	;-Ｈ効果音;----------------------------------
	mov $_se,"WB010"
	mov $debugstr,"Ｈ音：WB010 "
	gosub *se
;ローター音（ながいＢＧＭ用）

	ブゥン…と。
	ちいさな振動音が、聞こえた。\

	それは、先輩の下着の中にもぐりこんでいる
	ピンクのコードのせいだ。\

	見たことはなかったけど、知っている。
	それはローターだ。大人のオモチャだ。\

	それが先輩の中に入ってる？
	先輩の…アソコに？\

	そう思った途端、僕の下半身に
	一気に血が集まった。\

	先輩が、僕を見つめてる。
	どうしてこんな異常な状況なのに。\

	どうして先輩はこんな奇麗な目で
	僕を見てるんだろう。\

	どうしてその声は、甘いんだろう？
	甘く、聞こえてしまうんだろう？\

	;--BGM;----------------------------------
	mov $_music,"09": gosub *out
	;-音声;----------------------------------
	mov $_voice,"CC0003"
	mov $debugstr,"音声：CC0003"
	gosub *vo

	【明海】
	…犯してください。\
	dwavestop CH_VOICE	;CC0003

	それは、僕が書いた台詞と同じだった。\

	【$g_hero】
	ど…うして…僕の書いた通りにしてるの？\

	先輩は答えなかった。\

	【$g_hero】
	あ…けみちゃん…何で…？\
	;-音声;----------------------------------
	mov $_voice,"CC0004"
	mov $debugstr,"音声：CC0004"
	gosub *vo

	【明海】
	いや…そんな風に呼ばないで…。\
	dwavestop CH_VOICE	;CC0004

	先輩が、ふるふると首を横にふった。
	スカートが小刻みに揺れる。\

	けれど、先輩はその手をおろさなかった。
	まるで、僕にずっと見ていて欲しいみたいに。\

