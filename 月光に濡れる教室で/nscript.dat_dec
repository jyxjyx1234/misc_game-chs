	;--立ちキャラ;----------------------------------
	mov $_char,"TCA"
	mov $debugstr,"立ち：TCA "
	gosub	*out	;画面に出力

	しどろもどろの僕に、先輩は小首を傾げた。
	それはいつもの先輩だった。\

	いや。いつもよりもずっと柔らかな先輩だった。
	他の人と話している時のような先輩だった。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCB"
	mov $debugstr,"立ち：TCB "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
