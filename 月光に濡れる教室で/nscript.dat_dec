	mov $debugstr,"音声：YE4802"
	gosub *vo

	【$g_heroの兄】
	現金だなぁ～。もう。\
	dwavestop CH_VOICE	;YE4802

	【$g_hero】
	わ～～、かわいいなぁ、菜摘先生…。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TLB"
	mov $debugstr,"立ち：TLB "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"YE4803"
	mov $debugstr,"音声：YE4803"
	gosub *vo

	【$g_heroの兄】
	これは、先生が赴任してきたばっかりのときね。
	僕が２年で、津島先輩が３年のとき。\
	dwavestop CH_VOICE	;YE4803

	【$g_hero】
	大学出たてか…。初々しいなぁ～～。
	あ、こっちにも、またコイツが居る。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TLD"
	mov $debugstr,"立ち：TLD "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"YE4804"
	mov $debugstr,"音声：YE4804"
	gosub *vo

	【$g_heroの兄】
	津島先輩？亡くなった人なんだから
	悪く言うのは止めなよ。\
	dwavestop CH_VOICE	;YE4804

	【$g_hero】
	む～～、そうだけどさ。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TLA"
	mov $debugstr,"立ち：TLA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
