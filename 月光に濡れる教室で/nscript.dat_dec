	mov $debugstr,"音声：CC0302"
	gosub *vo

	【明海】
	シャワー浴びてるって、お兄さんから聞いたわ。\
	dwavestop CH_VOICE	;CC0302

	【$g_hero】
	兄さんから？
	じゃあ…ずっと…もしかして待ってたとか？\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCA"
	mov $debugstr,"立ち：TCA "
	gosub	*out	;画面に出力
