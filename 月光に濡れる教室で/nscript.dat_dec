	dwavestop CH_VOICE	;YC9015
	;-音声;----------------------------------
	mov $_voice,"YC9016"
	mov $debugstr,"音声：YC9016"
	gosub *vo

	【学生Ｅ】
	同じ学年なんだよな、かわいそーに。
	もう人生棒に振ったも同然だな。\
	dwavestop CH_VOICE	;YC9016

	【$g_hero】
	（…来るなって言って、正解だったな）\

	先輩は、会長職をやっていたせいで
	顔をよく知られている。\

	【$g_hero】
	こんな状況で来てたら、
	どんな目に遭わされるか、想像つかないよ。\

	それに…共犯者か…。\

	もう、してるとかしてないとか、関係ないんだ。
	バレたら、よってたかって吊しあげだ…。\

	……みんな矛先が欲しいんだ。
	自分たちの興奮の行く先が。\

	僕は、うつむきながら校舎に入った。\
	gosub *blackout

	return	;----------------------------------
