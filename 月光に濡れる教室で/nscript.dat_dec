	mov $debugstr,"音声：CC2700A "
	gosub *vo

	【明海】
	ああ…もう…。
	何であんなこと言っちゃったのかしら。\
	dwavestop CH_VOICE	;CC2700A 
	;--立ちキャラ;----------------------------------
	mov $_char,"TCG"
	mov $debugstr,"立ち：TCG "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC2700B"
	mov $debugstr,"音声：CC2700B "
	gosub *vo

	【明海】
	……………………。
	あの人、不思議そうな顔してた。\
	dwavestop CH_VOICE	;CC2700B 
	;--立ちキャラ;----------------------------------
	mov $_char,"TCA"
	mov $debugstr,"立ち：TCA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC2701"
	mov $debugstr,"音声：CC2701"
	gosub *vo

	【明海】
	…別の呼び方にしてほしいの。
	なんて…おかしいわよね。\
	dwavestop CH_VOICE	;CC2701
	;--立ちキャラ;----------------------------------
	mov $_char,"TCG"
	mov $debugstr,"立ち：TCG "
	gosub	*out	;画面に出力

	【明海】
	……………………。\

	昔…まだ…私とあの人の背があんまり
	変わらなかった頃。\

	私たち、もっとずっと近くて。
	ただ楽しくて。\

	なのに…卒業して進学して
	はじめての…制服を着て。\

	それから１年経って
	夏休みに入って、秋になってみたら\

	いきなり背が高くなっていて。
	「明海ちゃん」って呼ぶ声も…全然違ってて。\

	私…あんまりビックリして
	だから…恋をしてしまったの。\

	そんなたわいもない理由だって
	キミは、驚くかしら？\

	でも…私には大事件だったのよ？\

	【明海】
	……………………。\

	恋をしたの。
	幼なじみのキミに。\

	なのに、キミはなんにも変わらなくて。
	相変わらず「明海ちゃん」だから。\

	私、ショックだったわ。
	私だって…変わってたでしょ？\

	綺麗に…なってたでしょ？
	ふふ…バカみたいね。\

	だから、すこーし距離を置いたの。
	そうしたら…今度はどんどん遠くなってしまって。\

	気まずくなってしまって。
	前みたいに、話すこともできなくなってしまって。\

	…幼なじみなんて、ならなければよかった。
	もし、今度キミに会う時間を選ぶことができたら。\

	私、今度はもう幼なじみになんてならない。
	年上でもなくて。クラスメイトがいいの。\

	背も高くなって…低い声になったキミから
	はじめたいの。\

	そうしたら、あなたも…私を好きになってくれる
	かしら。\

	ねぇ…「明海ちゃん」じゃイヤなの。
	だって、それは幼なじみってことでしょ？\

	今の私とあなたの関係じゃないでしょ？
	でも。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCC"
	mov $debugstr,"立ち：TCC "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC2702A"
	mov $debugstr,"音声：CC2702A "
	gosub *vo

	【明海】
