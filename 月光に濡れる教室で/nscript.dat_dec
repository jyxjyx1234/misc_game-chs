	;--背景;----------------------------------
	mov $_bg,"BG032A"
	mov $debugstr,"ＢＧ：BG032A"
	gosub *out	;画面に出力
;;公園
	;-効果音;----------------------------------
	mov $_se,"ZTEL"
	mov $debugstr,"ＳＥ：ZTEL"
	gosub *se
;ＳＥ：ZAKEMIMAIL;明海携帯メールの音

	聞き慣れた着信音が、
	明海の鞄の中で鳴った。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCA"
	mov $debugstr,"立ち：TCA "
	gosub	*out	;画面に出力
;【明海】［普］

	明海は、静かに僕を見つめた。
	僕も明海を見つめ返した。\

	明海の目に恐れはなかった。
	僕も恐れなかった。\

	恐れを感じるには、
	空は青すぎて、風は強すぎて───。\

	何もかもがはじまっていくんだ。
	何もかもが終わってしまうように。\

	もう「天使」のメールは過去のものだった。\

	何を命じられても、何を強要されても
	僕たちにとって、それは通りすぎてしまった
	ものでしかなかった。\

	明海の側に、僕は寄りそう。
	明海はうなずいて、それから携帯を開いた。\
	gosub *clear_char

	明海がメールを読みはじめる。
	やわらかなトーンの声が、僕の耳を響かせる。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCA"
	mov $debugstr,"立ち：TCA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC11300"
	mov $debugstr,"音声：CC11300 "
	gosub *vo

	【明海】
	「皆月明海さんへ」\
	dwavestop CH_VOICE	;CC11300 
	;--立ちキャラ;----------------------------------
	mov $_char,"TCA"
	mov $debugstr,"立ち：TCA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC11301"
	mov $debugstr,"音声：CC11301 "
	gosub *vo

	【明海】
	「卒業おめでとう。
	　ネガは送るよ。好きに処分してくれ。」\
	dwavestop CH_VOICE	;CC11301 
	;--立ちキャラ;----------------------------------
	mov $_char,"TCD"
	mov $debugstr,"立ち：TCD "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC11302"
	mov $debugstr,"音声：CC11302 "
	gosub *vo

	【明海】
	「この先、彼との行為を強要するメールが
	　このメールアドレスで届くことはない。」\
	dwavestop CH_VOICE	;CC11302 
	;--立ちキャラ;----------------------------------
	mov $_char,"TCJ"
	mov $debugstr,"立ち：TCJ "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC11303"
	mov $debugstr,"音声：CC11303 "
	gosub *vo

	【明海】
	「君の未来に幸（さいわい）あれ。」\
	dwavestop CH_VOICE	;CC11303 

	【$g_hero】
	………………………。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCJ"
	mov $debugstr,"立ち：TCJ "
	gosub	*out	;画面に出力

	【明海】
	………………………。\

	【$g_hero】
	最後の「天使」のメールか…。\

	ぽつりと言った僕の台詞に、
	明海は静かに目を伏せた。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCC"
	mov $debugstr,"立ち：TCC "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC11304"
	mov $debugstr,"音声：CC11304 "
	gosub *vo

	【明海】
	なんだったのかしら…。\
	dwavestop CH_VOICE	;CC11304 

	【$g_hero】
	わからない…けれど。
	いいんだ。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCD"
	mov $debugstr,"立ち：TCD "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC11305"
	mov $debugstr,"音声：CC11305 "
	gosub *vo

	【明海】
	え？\
	dwavestop CH_VOICE	;CC11305 

	【$g_hero】
	…いいんだよ。
	終わったんだよ……終わらせていいんだよ。\

	僕は明海の手から、携帯を抜き取る。
	そしてその携帯を、近くの川に投げ込んだ。\

	携帯は、朝の太陽を反射する川面に沈んで
	すぐに見えなくなった。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCI"
	mov $debugstr,"立ち：TCI "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC11306"
	mov $debugstr,"音声：CC11306 "
	gosub *vo

	【明海】
	…もう見えないわ。\
	dwavestop CH_VOICE	;CC11306 

	【$g_hero】
	うん。もう…二度と見ないんだ。
	見なくていいんだよ。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCA"
	mov $debugstr,"立ち：TCA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC11307"
	mov $debugstr,"音声：CC11307 "
	gosub *vo

	【明海】
	そうね…。きっと…そうなんだわ。\
	dwavestop CH_VOICE	;CC11307 

	【$g_hero】
	行こう。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TCA"
	mov $debugstr,"立ち：TCA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"CC11308"
	mov $debugstr,"音声：CC11308 "
	gosub *vo

	【明海】
	ええ…行きましょう。\
	dwavestop CH_VOICE	;CC11308 
	gosub *blackout

	return	;----------------------------------
