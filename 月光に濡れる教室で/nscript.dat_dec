	dwavestop CH_VOICE	;DD4409

	【$g_hero】
	うん。クレヨンとかで。子供のらくがき。
	自動車とか電車とかそういうの描くの。でね。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TDA"
	mov $debugstr,"立ち：TDA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"DD4410"
	mov $debugstr,"音声：DD4410"
	gosub *vo

	【小夜子】
	はい。\
	dwavestop CH_VOICE	;DD4410

	【$g_hero】
	夏休みの宿題で絵描いたんだ。僕すごい
	はりきって大きい紙買ってもらって、描いた。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TDD"
	mov $debugstr,"立ち：TDD "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"DD4411"
	mov $debugstr,"音声：DD4411"
	gosub *vo

	【小夜子】
	何を書いたんですか？\
	dwavestop CH_VOICE	;DD4411

	【$g_hero】
	電車。毎日、駅行って。すごい細かく描いた。
	子供のだから、たかが知れてるんだけどさ。\

	それでも、夏休みの半月ぐらいつぶして
	毎日毎日一生懸命かいたんだ。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TDI"
	mov $debugstr,"立ち：TDI "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"DD4412"
	mov $debugstr,"音声：DD4412"
	gosub *vo

	【小夜子】
	それで？\
	dwavestop CH_VOICE	;DD4412

	【$g_hero】
	すごい自信作でさ。休み明けてガッコ
	持ってって、先生に見せた。\

	【$g_hero】
	そしたら、ちらっと見て、お兄さんの方が
	上手だったわねって。そう言われたんだよな。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TDC"
	mov $debugstr,"立ち：TDC "
	gosub	*out	;画面に出力

	【小夜子】
	……………。\

	【$g_hero】
	兄さんの絵ってさぁ、デッサンちゃんとしてて
	写真みたいに綺麗でさ。たしかに上手なんだよ。\

	褒めやすい絵だからと兄さんは言ってた。
	本人は絵心なんてないと言うし、判るひとから
	見ればそうなのかもしれないけど。\

	【$g_hero】
	いやな先生じゃなかったよ。好きな先生で、
	悪気もなかったんだと思うんだ。でも、だから。\

	【$g_hero】
	だから、ちょっとやりきれなかったなぁ。\

	そんなもんだ。誰も僕を気にしてない。\

	悪意なんて受けるほど、僕は
	みんなに認められてなんてなくて。\

	だからといって、すべてを笑って
	受け流せるほど大人でもなくて。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TDJ"
	mov $debugstr,"立ち：TDJ "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"DD4413"
	mov $debugstr,"音声：DD4413"
	gosub *vo

	【小夜子】
	先輩。\
	dwavestop CH_VOICE	;DD4413

	【$g_hero】
	僕はさ、兄さんみたいに勉強ができない。
	兄さんみたいにスポーツもできない。\

	【$g_hero】
	どうして出来ないの。兄さんはできるのに。
	みんな、そうやって勝手に僕を決める。\

	【$g_hero】
	僕が「勝手に決めた僕」じゃないと怒る。
	呆れる。失望する。そんなもんだよな。\

	そっちこそ、勝手にしろ。そう言いきれるように
	なるまで、どれだけかかったか。\

	【$g_hero】
	だからって、それでヒネてたら切りないし。
	それとも３６０度ぐらいヒネまくったのかな。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TDC"
	mov $debugstr,"立ち：TDC "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"DD4414"
	mov $debugstr,"音声：DD4414"
	gosub *vo

	【小夜子】
	それじゃ戻っちゃうじゃないですか。\
	dwavestop CH_VOICE	;DD4414

	【$g_hero】
	そだよ。でも、まあ。それぐらいかな。
	神経図太いだけだな、僕の取り柄ってヤツは。\

	兄さんがピカピカのサラブレッドなら
	もう雑草みたいに、たくましくなるしか。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TDA"
	mov $debugstr,"立ち：TDA "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"DD4415"
	mov $debugstr,"音声：DD4415"
	gosub *vo

	【小夜子】
	先輩は、強いんですよ。\
	dwavestop CH_VOICE	;DD4415

	【$g_hero】
	そうかなぁ。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TDB"
	mov $debugstr,"立ち：TDB "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"DD4416"
	mov $debugstr,"音声：DD4416"
	gosub *vo

	【小夜子】
	だから、私は先輩が好きなんです。\
	dwavestop CH_VOICE	;DD4416

	【$g_hero】
	…あ…ありがと。\
	;--立ちキャラ;----------------------------------
	mov $_char,"TDD"
	mov $debugstr,"立ち：TDD "
	gosub	*out	;画面に出力
	;-音声;----------------------------------
	mov $_voice,"DD4417"
	mov $debugstr,"音声：DD4417"
	gosub *vo

	【小夜子】
	先輩…！\
	dwavestop CH_VOICE	;DD4417
;ここでチューをする。

	僕は小夜子を抱き寄せた。
	重ねた唇はやわらかくて、冷たくて。\

	もっと温かくしてあげたくなって、
	僕はぎゅっと小夜子の背中を抱きしめた。\
	gosub *blackout

