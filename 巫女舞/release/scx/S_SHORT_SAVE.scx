;-----------------------------------------------
; ショートカット、実行部
;-----------------------------------------------
; 起動 (起動時に自動的にmemoryBuff[0]に状態がセーブされる)

/MesSkip		[0]
/SysSet	'auto'	[0]
/calc	[$mode=1]	; システムモードに移行

/SePlay	[902]	;決定

/Black	<BASE>
/BgLock		<BG>
/InitAll	<BG>

/call	"scx\S_DATASAVE.scx"

/Restore	[0]			; 実行時の画面イメージを復元
/calc	[$mode=0]		; メニューモード終了
/SystemMode	[0]			; 主制御にプロセスを戻す

