/jump	[$scene]	@scene

#normal
/AliasInit	<2>
/AliasSet	<2>	[112]	'VK_F1'		"scx\S_SHORT_SAVE.scx"
/AliasSet	<2>	[113]	'VK_F2'		"scx\S_SHORT_LOAD.scx"
/AliasSet	<2>	[114]	'VK_F3'		"scx\S_SHORT_CONFIG.scx"
/AliasSet	<2>	[115]	'VK_F4'		"scx\S_SHORT_QSAVE.scx"
/AliasSet	<2>	[116]	'VK_F5'		"scx\S_SHORT_QLOAD.scx"
/AliasSet	<2>	[117]	'VK_F6'		"scx\S_SHORT_LOG.scx"
/AliasSet	<2>	[118]	'VK_F7'		"scx\S_SHORT_AUTO.scx"
/AliasSet	<2>	[119]	'VK_F8'		"scx\S_SHORT_SKIP.scx"
/AliasSet	<2>	[120]	'VK_F9'		"scx\S_SHORT_HIDE.scx"

#scene
/AliasInit	<2>
/AliasSet	<2>	[117]	'VK_F6'		"scx\S_SHORT_LOG.scx"
/AliasSet	<2>	[118]	'VK_F7'		"scx\S_SHORT_AUTO.scx"
/AliasSet	<2>	[119]	'VK_F8'		"scx\S_SHORT_SKIP.scx"
/AliasSet	<2>	[120]	'VK_F9'		"scx\S_SCX_END.scx"

/end
