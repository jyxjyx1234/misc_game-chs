;-----------------------------------------------
; ショートカット、実行部
;-----------------------------------------------
; 起動 (起動時に自動的にmemoryBuff[0]に状態がセーブされる)

/MesCls
/MesSkip		[0]
/SysSet	'auto'	[0]
/SePlay	[902]	;決定

/DispOff	<SEL_1>
/DispOff	<SEL_2>
/DispOff	<SEL_3>
/DispOff	<SEL_4>

/Black		<BASE>
/BgLock		<BG>
/DispOff	<CHR_1>
/DispOff	<CHR_2>
/Fadeout	<BG>	(255,80)	[83]
/fadewait

/calc	[$mode=0]
/call	"scx\S_CONFIG.scx"

/Fadein	<BG>	(80,255)	[32]

/Restore	[0]			; 実行時の画面イメージを復元
/calc	[$mode=0]		; メニューモード終了
/SystemMode	[0]			; 主制御にプロセスを戻す
