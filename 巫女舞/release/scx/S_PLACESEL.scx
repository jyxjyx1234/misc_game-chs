/jump	[$menu==1]	@1
/jump	[$menu==2]	@2
/jump	[$menu==3]	@3
/jump	[$menu==4]	@4
/end

;-----------------------------------------------
#large
/calc	[$mode=1]
/Calc	[$answer=0]
/calc	[$menu=1]
/SePlay	[902]

/Default	<SEL_1>
/CreateButton	"obj\place_l_room_off.tga"
/SetButton	[1]	"obj\place_l_room_on.tga"
/ChangeButton	[0]
/DispOff
/SetPos		(180,220)

/Default	<SEL_2>
/CreateButton	"obj\place_l_farm_off.tga"
/SetButton	[1]	"obj\place_l_farm_on.tga"
/ChangeButton	[0]
/DispOff
/SetPos		(420,220)

/Init	<SEL_3>
/Init	<SEL_4>

/Default	<-1>

/FadeIn	<SEL_1>
/FadeIn	<SEL_2>
/FadeWait

/ChangeButton	<SEL_1>
/ChangeButton	<SEL_2>

/jump	@loop

;-----------------------------------------------
