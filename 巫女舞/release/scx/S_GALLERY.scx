;-----------------------------------------------
; ギャラリー総合
;
; 起動時<BG>を背景とする。
; 呼び出し元で輝度を調整し、それ以外の部分は
; 消去しておいてください。
;-----------------------------------------------
; 起動


/calc	[$mode=6]	; おまけモード
/Calc	[$ret=0]
/Calc	[$chr=-1]
/Calc	[$page=0]

/call	@open
/Read	<DATA16>	"obj\fake.tga"
/SetPos	<DATA16>	(0,130)
/DispOn	<DATA16>

;--------------------------
#loop
/KeyWait
/jump	<CMD_CANCEL>	@omake
/Jump	<SEL_1>			@cancel
/Jump	<SEL_2>			@gameend
/Jump	<SEL_3>			@omake

/jump	<PAGE1>		@chr
/jump	<PAGE2>		@chr
/jump	<PAGE3>		@chr
/jump	<PAGE4>		@chr
/jump	<PAGE5>		@chr
/jump	<PAGE6>		@chr

/jump	<DATA1>		@view1
/jump	<DATA2>		@view2
/jump	<DATA3>		@view3
/jump	<DATA4>		@view4
/jump	<DATA5>		@view5
/jump	<DATA6>		@view6
/jump	<DATA7>		@view7
/jump	<DATA8>		@view8
/jump	<DATA9>		@view9
/jump	<DATA10>	@view10
/jump	<DATA11>	@view11
/jump	<DATA12>	@view12


/jump	<SAVE>		@back
/jump	<CMD_UP>	@back
/jump	<LOAD>		@next
/jump	<CMD_DOWN>	@next
/jump				@loop

#chr
/Calc	[$page=0]
/jump	<PAGE1>		@nk0
/jump	<PAGE2>		@hn0
/jump	<PAGE3>		@kh0
/jump	<PAGE4>		@ak0
/jump	<PAGE5>		@ah0
/jump	<PAGE6>		@etc0


;-------------------
#next
/jump	[$chr==-1]	@loop
/calc	[$page=1]
/jump	[$chr==0]	@nk0
/jump	[$chr==1]	@hn0
/jump	[$chr==2]	@kh0
/jump	[$chr==3]	@ak0
/jump	[$chr==4]	@ah0
/jump				@etc0

;-------------------
#back
/jump	[$chr==-1]	@loop
/calc	[$page=0]
/jump	[$chr==0]	@nk0
/jump	[$chr==1]	@hn0
/jump	[$chr==2]	@kh0
/jump	[$chr==3]	@ak0
/jump	[$chr==4]	@ah0
/jump				@etc0

;-------------------
; 終了
#cancel
/SePlay	[900]	;決定

/Calc	[$ret=0]
/end

;-------------------
; 戻る
#omake
/SePlay	[900]	;決定

/Calc	[$ret=1]
/end


;-----------------------------------------------
; ゲームの終了
#gameend
/call	"scx\S_DIALOG.scx"	@exitdlg
/jump	@loop

#readbtn
/Default	<PAGE1>
/CreateButton	"obj\OMK_BTN0_NK.bmp"
/SetButton	[1]	"obj\OMK_BTN2_NK.bmp"
/SetButton	[2]	"obj\OMK_BTN1_NK.bmp"
/SetPos		(260,104)

/Default	<PAGE2>
/CreateButton	"obj\OMK_BTN0_HN.bmp"
/SetButton	[1]	"obj\OMK_BTN2_HN.bmp"
/SetButton	[2]	"obj\OMK_BTN1_HN.bmp"
/SetPos		(340,104)

/Default	<PAGE3>
/CreateButton	"obj\OMK_BTN0_KH.bmp"
/SetButton	[1]	"obj\OMK_BTN2_KH.bmp"
/SetButton	[2]	"obj\OMK_BTN1_KH.bmp"
/SetPos		(420,104)

/Default	<PAGE4>
/CreateButton	"obj\OMK_BTN0_AK.bmp"
/SetButton	[1]	"obj\OMK_BTN2_AK.bmp"
/SetButton	[2]	"obj\OMK_BTN1_AK.bmp"
/SetPos		(500,104)

/Default	<PAGE5>
/CreateButton	"obj\OMK_BTN0_AH.bmp"
/SetButton	[1]	"obj\OMK_BTN2_AH.bmp"
/SetButton	[2]	"obj\OMK_BTN1_AH.bmp"
/SetPos		(580,104)

/Default	<PAGE6>
/CreateButton	"obj\OMK_BTN0_ETC.bmp"
/SetButton	[1]	"obj\OMK_BTN2_ETC.bmp"
/SetButton	[2]	"obj\OMK_BTN1_ETC.bmp"
/SetPos		(660,104)

/ChangeButton	<PAGE1>	[0]
/ChangeButton	<PAGE2>	[0]
/ChangeButton	<PAGE3>	[0]
/ChangeButton	<PAGE4>	[0]
/ChangeButton	<PAGE5>	[0]
/ChangeButton	<PAGE6>	[0]

/DispOff	<PAGE1>
/DispOff	<PAGE2>
/DispOff	<PAGE3>
/DispOff	<PAGE4>
/DispOff	<PAGE5>
/DispOff	<PAGE6>
/return

;-----------------------------------------------
; UIオープン・サブルーチン
#open

/Default	<SAVE>
/CreateButton	"obj\やじるし_うえ_0.tga"
/Read	[1]		"obj\やじるし_うえ_1.tga"
/SetPos			(480,147)
/ChangeButton	[0]

/Default	<LOAD>
/CreateButton	"obj\やじるし_した_0.tga"
/Read	[1]		"obj\やじるし_した_1.tga"
/SetPos			(480,475)
/ChangeButton	[0]
/DispOff


/call	@readbtn
/ChangeButton	<PAGE1>		[0]
/ChangeButton	<PAGE2>		[0]
/ChangeButton	<PAGE3>		[0]
/ChangeButton	<PAGE4>		[0]
/ChangeButton	<PAGE5>		[0]
/ChangeButton	<PAGE6>		[0]

/FadeIn	<PAGE1>		[32]	/wait
/FadeIn	<PAGE2>		[32]	/wait
/FadeIn	<PAGE3>		[32]	/wait
/FadeIn	<PAGE4>		[32]	/wait
/FadeIn	<PAGE5>		[32]	/wait
/FadeIn	<PAGE6>		[32]	/FadeWait

/ChangeButton	<PAGE1>
/ChangeButton	<PAGE2>
/ChangeButton	<PAGE3>
/ChangeButton	<PAGE4>
/ChangeButton	<PAGE5>
/ChangeButton	<PAGE6>

/FadeWait

/default	<-1>

/return

