;----開く準備----
#viewer
/SaveData	[6]
/BgLock		<BG>
/InitAll	<BG>
/SaveScreen	<BG>	[0]

/AliasGet	'cg00'
/jump	[$ret==0]	@p1
/SysGet	[$ret]
/jump	[$ret==0]	@p1
/Disolve	<BG>	"cg\%cg00%"
/keywait
/jump	<CMD_CANCEL>	@vend

#p1
/AliasGet	'cg01'
/jump	[$ret==999]	@vend
/jump	[$ret==0]	@p2
/SysGet	[$ret]
/jump	[$ret==0]	@p2
/Disolve	<BG>	"cg\%cg01%"
/keywait
/jump	<CMD_CANCEL>	@vend

#p2
/AliasGet	'cg02'
/jump	[$ret==999]	@vend
/jump	[$ret==0]	@p3
/SysGet	[$ret]
/jump	[$ret==0]	@p3
/Disolve	<BG>	"cg\%cg02%"
/keywait
/jump	<CMD_CANCEL>	@vend

#p3
/AliasGet	'cg03'
/jump	[$ret==999]	@vend
/jump	[$ret==0]	@p4
/SysGet	[$ret]
/jump	[$ret==0]	@p4
/Disolve	<BG>	"cg\%cg03%"
/keywait
/jump	<CMD_CANCEL>	@vend

#p4
/AliasGet	'cg04'
/jump	[$ret==999]	@vend
/jump	[$ret==0]	@p5
/SysGet	[$ret]
/jump	[$ret==0]	@p5
/Disolve	<BG>	"cg\%cg04%"
/keywait
/jump	<CMD_CANCEL>	@vend

#p5
/AliasGet	'cg05'
/jump	[$ret==999]	@vend
/jump	[$ret==0]	@vend
/SysGet	[$ret]
/jump	[$ret==0]	@vend
/Disolve	<BG>	"cg\%cg05%"
/keywait


;----閉じる準備----
#vend
/BgLock		<BG>
/InitAll	<BG>

/LoadScreen	<CHR_1>	[0]
/DispOff	<CHR_1>
/FadeIn		<CHR_1>
/FadeWait

/Restore	[6]
/jump	@loop
/jump	[$chr==0]	@nk0
/jump	[$chr==1]	@hn0
/jump	[$chr==2]	@kh0
/jump	[$chr==3]	@ak0
/jump	[$chr==4]	@ah0
/jump				@etc0
