;/jump	<QSAVE>		@spddown
;/jump	<QLOAD>		@spdup

/default	<PAGE4>
/CreateBar	{0,0,180,31}
/Read	[1]	"obj\slider_1.tga"
/Read	[2]	"obj\slider_0.tga"
/SetPos		(504,132)
/SysGet	'speed'
/SetBar	[$ret]

/default	<QSAVE>
/CreateButton	"obj\slider_left0.tga"
/Read	[1]		"obj\slider_left1.tga"
/SetPos			(474,132)
/ChangeButton	[0]
/DispOff

/default	<QLOAD>
/CreateButton	"obj\slider_right0.tga"
/Read	[1]		"obj\slider_right1.tga"
/SetPos			(686,132)
/ChangeButton	[0]
/DispOff

;-------------------------
;/jump	<SKIP>		@autodown
;/jump	<AUTOREAD>	@autoup

/default	<PAGE5>
/CreateBar	{0,0,180,31}
/Read	[1]	"obj\slider_1.tga"
/Read	[2]	"obj\slider_0.tga"
/SetPos		(504,170)
/SysGet	'timeout'
/SetBar	[$ret]

/default	<SKIP>
/CreateButton	"obj\slider_left0.tga"
/Read	[1]		"obj\slider_left1.tga"
/SetPos			(474,168)
/ChangeButton	[0]
/DispOff

/default	<AUTOREAD>
/CreateButton	"obj\slider_right0.tga"
/Read	[1]		"obj\slider_right1.tga"
