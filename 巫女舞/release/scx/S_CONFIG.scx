/if	[$menu==0]
	/Default		<SEL_1>
	/CreateButton	"obj\BTN_ゲーム戻る_0.tga"
	/Read	[1]		"obj\BTN_ゲーム戻る_1.tga"
	/SetPos			(210,530)
	/ChangeButton	[0]
	/DispOff
/endif

/Default		<SEL_2>
/CreateButton	"obj\BTN_タイトル戻る_0.tga"
/Read	[1]		"obj\BTN_タイトル戻る_1.tga"
/SetPos			(400,530)
