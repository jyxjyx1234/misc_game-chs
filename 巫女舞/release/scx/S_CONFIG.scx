/DispOff

/Default		<SEL_3>
/CreateButton	"obj\BTN_ゲーム終了_0.tga"
/Read	[1]		"obj\BTN_ゲーム終了_1.tga"
/SetPos			(590,530)
/ChangeButton	[0]
/DispOff

;-------------------------

/Default	<DATA5>
/CreateButton	"obj\CFG_full0.tga"
/SetButton	[1]	"obj\CFG_full2.tga"
/SetButton	[2]	"obj\CFG_full1.tga"
/SetPos		(448,96)

/Default	<DATA6>
/CreateButton	"obj\CFG_win0.tga"
/SetButton	[1]	"obj\CFG_win2.tga"
/SetButton	[2]	"obj\CFG_win1.tga"
/SetPos		(540,96)
/call	@tglwin

/Default	<DATA7>
/CreateButton	"obj\CFG_on0.tga"
/SetButton	[1]	"obj\CFG_on2.tga"
/SetButton	[2]	"obj\CFG_on1.tga"
/SetPos		(448,478)

/Default	<DATA8>
/CreateButton	"obj\CFG_off0.tga"
/SetButton	[1]	"obj\CFG_off2.tga"
/SetButton	[2]	"obj\CFG_off1.tga"
/SetPos		(540,478)

/call	@tgleff

/Default	<DATA9>
/CreateButton	"obj\CFG_on0.tga"
/SetButton	[1]	"obj\CFG_on2.tga"
/SetButton	[2]	"obj\CFG_on1.tga"
/SetPos		(448,402)

/Default	<DATA10>
/CreateButton	"obj\CFG_off0.tga"
/SetButton	[1]	"obj\CFG_off2.tga"
/SetButton	[2]	"obj\CFG_off1.tga"
/SetPos		(540,402)

/call	@tglmvoice

/Default	<DATA11>
/CreateButton	"obj\CFG_on0.tga"
/SetButton	[1]	"obj\CFG_on2.tga"
/SetButton	[2]	"obj\CFG_on1.tga"
/SetPos		(448,440)

/Default	<DATA12>
/CreateButton	"obj\CFG_off0.tga"
/SetButton	[1]	"obj\CFG_off2.tga"
/SetButton	[2]	"obj\CFG_off1.tga"
/SetPos		(540,440)

/call	@tglfvoice

/Default	<DATA13>
/CreateButton	"obj\CFG_all0.tga"
/SetButton	[1]	"obj\CFG_all2.tga"
/SetButton	[2]	"obj\CFG_all1.tga"
/SetPos		(448,248)

/Default	<DATA14>
/CreateButton	"obj\CFG_kidoku0.tga"
/SetButton	[1]	"obj\CFG_kidoku2.tga"
/SetButton	[2]	"obj\CFG_kidoku1.tga"
/SetPos		(540,248)

/call	@tglkdq

/default	<-1>

/FadeIn	<CHR_1>		[64]
/FadeIn	<QSAVE>		[64]
/FadeIn	<QLOAD>		[64]
/FadeIn	<SKIP>		[64]
/FadeIn	<AUTOREAD>	[64]
/FadeIn	<VIEW>		[64]
/FadeIn	<BACKLOG>	[64]
/FadeIn	<PAGE1>		[64]
/FadeIn	<PAGE2>		[64]
/FadeIn	<PAGE3>		[64]
/FadeIn	<PAGE4>		[64]
/FadeIn	<PAGE5>		[64]
/FadeIn	<PAGE6>		[64]
/FadeIn	<PAGE7>		[64]
/FadeIn	<PAGE8>		[64]
/FadeIn	<DATA1>		[64]
/FadeIn	<DATA2>		[64]
/FadeIn	<DATA3>		[64]
/FadeIn	<DATA4>		[64]
/FadeIn	<DATA5>		[64]
/FadeIn	<DATA6>		[64]
/FadeIn	<DATA7>		[64]
/FadeIn	<DATA8>		[64]
/FadeIn	<DATA9>		[64]
/FadeIn	<DATA10>	[64]
/FadeIn	<DATA11>	[64]
/FadeIn	<DATA12>	[64]
/FadeIn	<DATA13>	[64]
/FadeIn	<DATA14>	[64]

/if	[$menu==0]
	/FadeIn	<SEL_1>	[64]
/endif

/FadeIn	<SEL_2>	[64]
/FadeIn	<SEL_3>	[64]

/FadeWait

/if	[$menu==0]
	/ChangeButton	<SEL_1>
/Endif
/ChangeButton	<SEL_2>
/ChangeButton	<SEL_3>


/ChangeButton	<PAGE7>
/ChangeButton	<PAGE8>
/ChangeButton	<DATA1>
/ChangeButton	<DATA2>
/ChangeButton	<DATA3>
/ChangeButton	<DATA4>

/ChangeButton	<QSAVE>
/ChangeButton	<QLOAD>
/ChangeButton	<SKIP>
/ChangeButton	<AUTOREAD>
/ChangeButton	<VIEW>
/ChangeButton	<BACKLOG>


/default	<-1>

/return

;--------------------------------------
#tglwin
/SysGet	'full'
/if	[$ret]
	/ChangeButton	[1]	<DATA5>
	/ChangeButton		<DATA6>
/Else
	/ChangeButton		<DATA5>
	/ChangeButton	[1]	<DATA6>
/Endif
/return

;--------------------------------------
#tgleff
/SysGet	'effect'
/if	[$ret]
	/ChangeButton	[1]	<DATA7>
	/ChangeButton		<DATA8>
/Else
	/ChangeButton		<DATA7>
	/ChangeButton	[1]	<DATA8>
/Endif
/return

;--------------------------------------
#tglmvoice
/SysGet	'mvoice'
/if	[$ret]
	/ChangeButton	[1]	<DATA9>
	/ChangeButton		<DATA10>
/Else
	/ChangeButton		<DATA9>
	/ChangeButton	[1]	<DATA10>
/Endif
/return

;--------------------------------------
#tglfvoice
/SysGet	'fvoice'
/if	[$ret]
	/ChangeButton	[1]	<DATA11>
	/ChangeButton		<DATA12>
/Else
	/ChangeButton		<DATA11>
	/ChangeButton	[1]	<DATA12>
/Endif
/return

;--------------------------------------
#tglkdq
/SysGet	'kidoku'
/if	[$ret]
	/ChangeButton		<DATA13>
	/ChangeButton	[1]	<DATA14>
/Else
	/ChangeButton	[1]	<DATA13>
	/ChangeButton		<DATA14>
/Endif
/return


;-----------------------------------------------
; UIクローズ・サブルーチン
#close
/BgLock		<CHR_1>
/InitAll	<BG>	<CHR_1>
/FadeOut	<CHR_1>	[64]
/FadeWait

/return


;-----------------------------------------------
; 終了
#exit
/Default	<-1>

;後片付け
/InitAll	<BG>

/end
