;-----------------------------------------------
; コンフィグ総合
;
; 起動時<BG>を背景とする。
; 呼び出し元で輝度を調整し、それ以外の部分は
; 消去しておいてください。
;-----------------------------------------------
; 起動

/calc	[$menu=$mode]
/calc	[$mode=4]	; コンフィグモード

/call	@open

/Calc	[$ret=0]

#loop
/KeyWait
/jump	<CMD_CANCEL>	@cancel
/jump	<SEL_1>		@cancel
/jump	<SEL_2>		@title
/jump	<SEL_3>		@gameend

/jump	<QSAVE>		@spddown
/jump	<QLOAD>		@spdup
/jump	<SKIP>		@autodown
/jump	<AUTOREAD>	@autoup
/jump	<VIEW>		@alpdown
/jump	<BACKLOG>	@alpup

/jump	<PAGE1>		@bgmvol
/jump	<PAGE2>		@sevol
/jump	<PAGE3>		@voicevol
/jump	<PAGE4>		@speed
/jump	<PAGE5>		@autotime
/jump	<PAGE6>		@alpha

/jump	<PAGE7>		@bvoldown
/jump	<PAGE8>		@bvolup
/jump	<DATA1>		@svoldown
/jump	<DATA2>		@svolup
/jump	<DATA3>		@vvoldown
/jump	<DATA4>		@vvolup

/jump	<DATA5>		@full
/jump	<DATA6>		@window
/jump	<DATA7>		@effon
/jump	<DATA8>		@effoff
/jump	<DATA9>		@mvoiceon
/jump	<DATA10>	@mvoiceoff
/jump	<DATA11>	@fvoiceon
/jump	<DATA12>	@fvoiceoff
/jump	<DATA13>	@kidokuon
/jump	<DATA14>	@kidokuoff

/jump	@loop

;-------------------
; 終了
#cancel
/SePlay	[900]	;決定

/call	@close
/Calc	[$ret=0]
/jump	@exit

;-----------------------------------------------
; ゲームの終了
#gameend
/SePlay	[902]	;決定
/call	"scx\S_DIALOG.scx"	@exitdlg
/jump	@loop
;-----------------------------------------------
; タイトルへ
#title
/SePlay	[902]	;決定
/if	[$menu==0]
	/call	"scx\S_DIALOG.scx"	@titledlg
	/jump	@loop
/Else
	/jump	@cancel
/Endif



;-----------------------------------------------
#svoldown
/SysGet	'mvs'
/if	[$ret<11]	/calc	[$ret=1]
/else			/add	'ret'	[-10]
/endif
/SetBar	<PAGE2>	[$ret]
/MasterVolume	<SE>	[$ret]
/SePlay	[902]
/jump	@loop

#svolup
/SysGet	'mvs'
/add	'ret'	[+10]
/if	[$ret>100]	/calc	[$ret=100]	/endif
/SetBar	<PAGE2>	[$ret]
/MasterVolume	<SE>	[$ret]
/SePlay	[902]
/jump	@loop

#sevol
/MasterVolume	<SE>	[$value]
/SePlay	[902]
/jump	@loop

;-----------------------------------------------
#bvoldown
/SysGet	'mvb'
/if	[$ret<11]	/calc	[$ret=1]
/else			/add	'ret'	[-10]
/endif
/SetBar	<PAGE1>	[$ret]
/MasterVolume	<BGM>	[$ret]
/jump	@loop

#bvolup
/SysGet	'mvb'
/add	'ret'	[+10]
/if	[$ret>100]	/calc	[$ret=100]	/endif
/SetBar	<PAGE1>	[$ret]
/MasterVolume	<BGM>	[$ret]
/jump	@loop

#bgmvol
/MasterVolume	<BGM>	[$value]
/jump	@loop

;-----------------------------------------------
#vvoldown
/SysGet	'mvv'
/if	[$ret<11]	/calc	[$ret=1]
/else			/add	'ret'	[-10]
/endif
/SetBar	<PAGE3>	[$ret]
/MasterVolume	<VOICE>	[$ret]
/jump	@loop

#vvolup
/SysGet	'mvv'
/add	'ret'	[+10]
/if	[$ret>100]	/calc	[$ret=100]	/endif
/SetBar	<PAGE3>	[$ret]
/MasterVolume	<VOICE>	[$ret]
/jump	@loop

#voicevol
/MasterVolume	<VOICE>	[$value]
/jump	@loop

;-----------------------------------------------
#spddown
/SysGet	'speed'
/if	[$ret<11]	/calc	[$ret=1]
/else			/add	'ret'	[-10]
/endif
/SetBar	<PAGE4>	[$ret]
/SysSet	'speed'	[$ret]
/jump	@loop

#spdup
/SysGet	'speed'
/add	'ret'	[+10]
/if	[$ret>100]	/calc	[$ret=100]	/endif
/SetBar	<PAGE4>	[$ret]
/SysSet	'speed'	[$ret]
/jump	@loop

#speed
/SysSet	'speed'	[$value]
/jump	@loop

;-----------------------------------------------
#autodown
/SysGet	'timeout'
/if	[$ret<11]	/calc	[$ret=1]
/else			/add	'ret'	[-10]
/endif
/SetBar	<PAGE5>	[$ret]
/SysSet	'timeout'	[$ret]
/jump	@loop

#autoup
/SysGet	'timeout'
/add	'ret'	[+10]
/if	[$ret>100]	/calc	[$ret=100]	/endif
/SetBar	<PAGE5>	[$ret]
/SysSet	'timeout'	[$ret]
/jump	@loop

;-----------------------------------------------
#alpdown
/SysGet	'alpha'
/if	[$ret<11]	/calc	[$ret=1]
/else			/add	'ret'	[-10]
/endif
/SetBar	<PAGE6>	[$ret]
/SysSet	'alpha'	[$ret]
/jump	@loop

#alpup
/SysGet	'alpha'
/add	'ret'	[+10]
/if	[$ret>100]	/calc	[$ret=100]	/endif
/SetBar	<PAGE6>	[$ret]
/SysSet	'alpha'	[$ret]
/jump	@loop

#effon
/SePlay	[902]	;
/SysSet	'effect'	[1]
/call	@tgleff
/jump	@loop

#effoff
/SePlay	[902]	;
/SysSet	'effect'	[0]
/call	@tgleff
/jump	@loop


#full
/SePlay	[902]	;
/ScreenMode	[1]
/call	@tglwin
/jump	@loop

#window
/SePlay	[902]	;
/ScreenMode	[0]
/call	@tglwin
/jump	@loop

#autotime
/SysSet	'timeout'	[$value]
/jump	@loop

#alpha
/SysSet	'alpha'	[$value]
/jump	@loop

#mvoiceon
/SePlay	[902]	;
/SysSet	'mvoice'	[1]
/call	@tglmvoice
/jump	@loop

#mvoiceoff
/SePlay	[902]	;
/SysSet	'mvoice'	[0]
/call	@tglmvoice
/jump	@loop

#fvoiceon
/SePlay	[902]	;
/SysSet	'fvoice'	[1]
/call	@tglfvoice
/jump	@loop

#fvoiceoff
/SePlay	[902]	;
/SysSet	'fvoice'	[0]
/call	@tglfvoice
/jump	@loop

#kidokuon
/SePlay	[902]	;
/SysSet	'kidoku'	[0]
/call	@tglkdq
/jump	@loop

#kidokuoff
/SePlay	[902]	;
/SysSet	'kidoku'	[1]
/call	@tglkdq
/jump	@loop

;-----------------------------------------------
; UIオープン・サブルーチン
#open
/Default	<CHR_1>
/Read		"obj\mode_config.tga"
/SetPos		(0,0)

;-------------------------
/default	<PAGE1>
/CreateBar	{0,0,180,31}
/Read	[1]	"obj\slider_1.tga"
/Read	[2]	"obj\slider_0.tga"
/SetPos		(504,284)
/SysGet	'mvb'
/SetBar	[$ret]

/default	<PAGE7>
/CreateButton	"obj\slider_left0.tga"
/Read	[1]		"obj\slider_left1.tga"
/SetPos			(474,282)
/ChangeButton	[0]
/DispOff

/default	<PAGE8>
/CreateButton	"obj\slider_right0.tga"
/Read	[1]		"obj\slider_right1.tga"
/SetPos			(686,282)
/ChangeButton	[0]
/DispOff

;-------------------------

/default	<PAGE2>
/CreateBar	{0,0,180,31}
/Read	[1]	"obj\slider_1.tga"
/Read	[2]	"obj\slider_0.tga"
/SetPos		(504,322)
/SysGet	'mvs'
/SetBar	[$ret]

/default	<DATA1>
/CreateButton	"obj\slider_left0.tga"
/Read	[1]		"obj\slider_left1.tga"
/SetPos			(474,320)
/ChangeButton	[0]
/DispOff

/default	<DATA2>
/CreateButton	"obj\slider_right0.tga"
/Read	[1]		"obj\slider_right1.tga"
/SetPos			(686,320)
/ChangeButton	[0]
/DispOff

;-------------------------

/default	<PAGE3>
/CreateBar	{0,0,180,31}
/Read	[1]	"obj\slider_1.tga"
/Read	[2]	"obj\slider_0.tga"
/SetPos		(504,360)
/SysGet	'mvv'
/SetBar	[$ret]

/default	<DATA3>
/CreateButton	"obj\slider_left0.tga"
/Read	[1]		"obj\slider_left1.tga"
/SetPos			(474,358)
/ChangeButton	[0]
/DispOff

/default	<DATA4>
/CreateButton	"obj\slider_right0.tga"
/Read	[1]		"obj\slider_right1.tga"
/SetPos			(686,358)
/ChangeButton	[0]
/DispOff

