;-----------------------
; 本編、最初からスタート
;-----------------------
/calc	[$mode=3]
/Default	<BG>
/Read	"bg\black.bmp"
/DispOn
/black	<BASE>
/Default	<-1>

/Call	"scx\S_NAMEENTRY.scx"	; 基礎サーフェイス作成

/Call	"scx\S_SURFACE.scx"	; 基礎サーフェイス作成
/calc	[$mode=1]
/MesCls
/wait

;------------------ 各種フラグを初期化 -------------------
#nor
/calc	[$month=7]		;
/calc	[$day=30]		;
/calc	[$mode=0]		;
/MesSkip	[0]
/Calc	[$claer=0]
/SysGet	[19]	/Calc	[$clear=$ret]
/SysGet	[29]	/Add	'clear'	[$ret]
/SysGet	[39]	/Add	'clear'	[$ret]
/SysGet	[49]	/Add	'clear'	[$ret]
/SysGet	[59]	/Add	'clear'	[$ret]

/ResetFlag	(0,999)		; 全てのフラグをリセット
/calc	[$nkpts=0]		;好感度
/calc	[$hnpts=0]		;
/calc	[$khpts=0]		;
/calc	[$akpts=0]		;

/calc	[$nkfree=0]		;自由時間進行度
/calc	[$hnfree=0]		;
/calc	[$khfree=0]		;
/calc	[$akfree=0]		;

/calc	[$nkjob=0]		;ご奉仕進行度
/calc	[$hnjob=0]		;
/calc	[$khjob=0]		;
/calc	[$akjob=0]		;

/calc	[$nkcls=0]		;掃除進行度
/calc	[$hncls=0]		;
/calc	[$khcls=0]		;
/calc	[$akcls=0]		;

;============== 現代編 ============================================================

;-------------- 共通 ------------------------------------------------------------
#start

/call	"scx\M_0730COM00.scx"
/call	"scx\M_0731COM00.scx"
/call	"scx\M_0801COM00.scx"
/call	"scx\M_0802COM00.scx"
