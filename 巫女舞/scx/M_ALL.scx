/call	"scx\M_0803COM00.scx"
/call	"scx\M_0804COM00.scx"
/call	"scx\M_0805COM00.scx"
/call	"scx\M_0806COM00.scx"

/call	"scx\M_0807COM00.scx"	;以後は各キャラ一本道
/jump	[$answer==0]	@NK
/jump	[$answer==1]	@HN
/jump	[$answer==2]	@KH
/jump	[$answer==3]	@AK

;-------------- 祭りで終わりのバッドエンド ---------------------------------------
/calc	[$day=8]
/calc	[$month=8]
/call	"scx\S_CALENDAR.scx"
/call	"scx\E_BAD01.scx"

/bgmfade
/allfadeout
/wait	[1000]

/calc	[$ret=0]
/end				; タイトルへ

