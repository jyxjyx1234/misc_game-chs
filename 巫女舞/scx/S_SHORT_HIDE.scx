/SysSet	'auto'	[0]

/Calc	[$mode=1]
/MesCls
/SePlay	[902]	;決定

/KeyWait

/SePlay	[902]	;決定
/Restore	[0]
/SystemMode	[0]			; 主制御にプロセスを戻す
