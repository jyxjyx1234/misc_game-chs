;===========================================
;■日付変更スクリプト
;===========================================
;-----------------------------------------------
; 日付ウインドウ作成
;-----------------------------------------------
; 起動
;-----------------------------------------------

/InitAll
/calc	[$mode=1]

/Fadein	<BG>	"obj\日付BG.bmp"	[16]
/fadewait

/jump	[$day==30]	@d30
/jump	[$day==31]	@d31
/jump	[$day==1]	@d1
/jump	[$day==2]	@d2
/jump	[$day==3]	@d3
/jump	[$day==4]	@d4
/jump	[$day==5]	@d5
/jump	[$day==6]	@d6
/jump	[$day==7]	@d7
/jump	[$day==8]	@d8
/jump	[$day==9]	@d9
/jump	[$day==10]	@d10
/jump	[$day==11]	@d11
/jump	[$day==12]	@d12
/jump	[$day==13]	@d13
/jump	[$day==14]	@d14

#loop
/wait	[1000]

/SetPos	<CHR_1>	(500,500)
/FadeIn	<CHR_1>	[16]
/FadeWait

/wait	[2000]

/BgLock	<BG>
/InitAll	<BG>
/FadeOut	<BG>	[16]
/FadeWait

/calc	[$mode=0]

/call	"scx\S_SURFACE.scx"
/end

;-----------------------------------------------
#d30
/Read	<CHR_1>	"obj\0730.bmp"
/jump	@loop
