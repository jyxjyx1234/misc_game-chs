#loop
/calc	[$mode=0]
/MesSkip		[0]
/SysSet	'auto'	[0]

#loop2
/KeyWait
/Jump	<SEL_1>		@a1
/Jump	<SEL_2>		@a2
/Jump	<SEL_3>		@a3
/Jump	<SEL_4>		@a4
/jump				@loop2

#a1
/Calc	[$answer=0]
/jump	@close

#a2
/Calc	[$answer=1]
/jump	@close

#a3
/Calc	[$answer=2]
/jump	@close

#a4
/Calc	[$answer=3]
/jump	@close

#close
/SePlay	[902]
/calc	[$mode=1]

/if	[$menu==1]
	/Fadeout	<SEL_1>	[83]
/Endif

/if	[$menu==2]
	/Fadeout	<SEL_1>	[83]
	/Fadeout	<SEL_2>	[83]
/Endif

/if	[$menu==3]
	/Fadeout	<SEL_1>	[83]
	/Fadeout	<SEL_2>	[83]
	/Fadeout	<SEL_3>	[83]
/Endif

/if	[$menu==4]
	/Fadeout	<SEL_1>	[83]
	/Fadeout	<SEL_2>	[83]
	/Fadeout	<SEL_3>	[83]
	/Fadeout	<SEL_4>	[83]
/Endif

/if	[$answer==0]	/Default	<SEL_1>	/endif
/if	[$answer==1]	/Default	<SEL_2>	/endif
/if	[$answer==2]	/Default	<SEL_3>	/endif
/if	[$answer==3]	/Default	<SEL_4>	/endif
/FadeOut	[16]
/fadeWait

/Default	<-1>

/Init	<SEL_1>
/Init	<SEL_2>
/Init	<SEL_3>
/Init	<SEL_4>


/calc	[$mode=0]
/End

