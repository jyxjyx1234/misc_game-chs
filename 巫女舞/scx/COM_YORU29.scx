/soundfadeout	<ENV>	(50,100)
/MesCls
/wait	[4000]

;好感度最高の人を計算してanswerへ
/if	[$nkpts<$hnpts]
	/calc	[$ret=1]
	/calc	[$answer=$hnpts]
/else
	/calc	[$ret=0]
	/calc	[$answer=$nkpts]
/endif

/if	[$answer<$khpts]
	/calc	[$ret=2]
	/calc	[$answer=$khpts]
/endif

/if	[$answer<$akpts]
	/calc	[$ret=3]
	/calc	[$answer=$akpts]
/endif

/End
/end
