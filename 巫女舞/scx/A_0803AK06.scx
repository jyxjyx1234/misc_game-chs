;ＢＧ　主人公の部屋　夜

/SOundfadein	<ENV>	[040]	(80,80)	; 豪雨の音。「ドザーっ！」
/FadeIn	<BG>	"bg\BG004R.bmp"
/Wait	[1500]

/SOundfadein	<ENV>	(50,30)	; 豪雨の音。「ドザーっ！」
