;-------------------
#next
/jump	[$page==2]	@loop
/add	'page'	[+1]
/SePlay	[902]	;決定
/Call	[$page==0]	@pg0
/Call	[$page==1]	@pg1
/Call	[$page==2]	@pg2
/jump	@loop
;-------------------
#back
/jump	[$page==0]	@loop
/SePlay	[902]	;決定
/add	'page'	[-1]
/Call	[$page==0]	@pg0
/Call	[$page==1]	@pg1
/Call	[$page==2]	@pg2
/jump	@loop
;-------------------
; 終了
#cancel
/SePlay	[900]	;決定
/Calc	[$ret=0]
/end

;-----------------------------------------------
; UIオープン・サブルーチン
#open

/Default	<SAVE>
