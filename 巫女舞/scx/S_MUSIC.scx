;-----------------------------------------------
; 音楽鑑賞モード
;
;-----------------------------------------------
; 起動

/Calc	[$menu=0]
/Calc	[$page=0]
/Calc	[$save=0]
/Calc	[$num=-1]
/call	@open
/Default	<DATA1>

#loop
/KeyWait
/jump	<CMD_CANCEL>	@omake
/jump	<CMD_UP>	@back
/jump	<SAVE>		@back
/jump	<CMD_DOWN>	@next
/jump	<LOAD>		@next
/Jump	<DATA1>		@play0
/Jump	<DATA2>		@play1
/Jump	<DATA3>		@play2
/Jump	<DATA4>		@play3
/Jump	<DATA5>		@play4
/Jump	<DATA6>		@play5
/Jump	<DATA7>		@play6
/Jump	<DATA8>		@play7
/Jump	<DATA9>		@play8
/Jump	<DATA10>	@play9

/Jump	<SEL_1>	@cancel
/Jump	<SEL_2>	@gameend
/Jump	<SEL_3>	@omake

/jump	<AUTOREAD>	@stop
/jump	<VIEW>		@play
/jump	<BACKLOG>	@pause

/jump	@loop


;-------------------
; 戻る
#omake
/SePlay	[900]	;決定

/Calc	[$ret=1]
/end

;-----------------------------------------------
#playing
/ChangeButton		<AUTOREAD>	;停止
/ChangeButton	[1]	<VIEW>		;再生
/ChangeButton		<BACKLOG>	;ポ－ズ
/calc	[$menu=1]
/return

;-----------------------------------------------
#pauseon
/ChangeButton		<AUTOREAD>	;停止
/ChangeButton		<VIEW>		;再生
/ChangeButton	[1]	<BACKLOG>	;ポ－ズ
/calc	[$menu=2]
/return

;-----------------------------------------------
#normal
/ChangeButton	[0]	<AUTOREAD>	;停止
/ChangeButton		<VIEW>		;再生
/ChangeButton	[0]	<BACKLOG>	;ポ－ズ
/calc	[$menu=0]
/return

;-----------------------------------------------
#play
/if	[$num==-1]
	/call	@pg0
	/calc	[$num=0]
	/ChangeButton	[1]	<DATA1>
/Endif

/if	[$menu==2]
	/jump	@replay
/endif

/BgmStop
/call	@playing
/Wait	[500]

/BgmPlay	[$num+1]
/jump	@loop

;-----------------------------------------------
#replay
/SoundPause	<BGM>	[0]
/call	@playing
/jump	@loop

;-----------------------------------------------
#pause
/SoundPause	<BGM>	[1]
/call	@pauseon
/jump	@loop

;-----------------------------------------------
#stop
/BgmStop
/calc	[$num=-1]
/call	@normal
/ChangeButton	<DATA1>
/ChangeButton	<DATA2>
/ChangeButton	<DATA3>
/ChangeButton	<DATA4>
/ChangeButton	<DATA5>
/ChangeButton	<DATA6>
/ChangeButton	<DATA7>
/ChangeButton	<DATA8>
/ChangeButton	<DATA9>
/ChangeButton	<DATA10>

/jump	@loop

;-----------------------------------------------
; ゲームの終了
#gameend
/call	"scx\S_DIALOG.scx"	@exitdlg
/jump	@loop

;-------------------
#play0
/ChangeButton	[1]	<DATA1>
