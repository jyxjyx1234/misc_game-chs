	mov %206,52					;行間

	;タイトル画面からロードの場合、セーブは使えなくする
	if %w0=1 && %START_FLAG=1 && %jumpout = 0 lsp 9,":a/2,0,3;SYS\saveload\save.bmp",SavePlatePosX,SavePlatePosY:spbtn 9,10;[セーブ]
	add %205,%203
	if %w0=0 lsp 11,":a/2,0,3;SYS\saveload\load.bmp",LoadPlatePosX,LoadPlatePosY:spbtn 11,11;[ロード]
	add %205,%203
	lsp 12,":a/2,0,3;SYS\saveload\config.bmp",605,170:spbtn 12,12		;[コンフィグ]
	add %205,%203
	lsp 13,":a/2,0,3;SYS\saveload\title.bmp",605,237:spbtn 13,13	;[タイトルへ戻る]

	;スプライト処理
;	if %w0=0 lsp 98,":c;SYS\saveload\save.bmp",SavePlatePosX,SavePlatePosY				;[セーブ]
;	if %w0=1 lsp 98,":c;SYS\saveload\load.bmp",LoadPlatePosX,LoadPlatePosY				;[ロード]

	lsph 10,":a;SYS\saveload\frame2.bmp",-1000,-1000,50      ;セーブ＆ロード枠
	exbtn_d "C10"
	exbtn 21,21,"P10M10,23,70"
	exbtn 22,22,"P10M10,216,70"
	exbtn 23,23,"P10M10,408,70"
	exbtn 24,24,"P10M10,23,247"
	exbtn 25,25,"P10M10,216,247"
	exbtn 26,26,"P10M10,408,247"
	exbtn 27,27,"P10M10,23,423"
	exbtn 28,28,"P10M10,216,423"
	exbtn 29,29,"P10M10,408,423"
return

*saveload_end
	for %w1=0 to 100
        if %w1 == 49 :next
        csp %w1:next
	btndef ""
    if %START_FLAG = 1 texton
return

;セーブロード
*saveload

    textoff
;	btndef "SYS\saveload\btn.bmp"

	;初期化
	for %w1=0 to 100
        if %w1 == 49 : next
        csp %w1:next

	if %lastpage = 0 mov %lastpage,1
	mov %w1,%lastpage;ページNo 1～9
;	mov %w1,1;ページNo 1～9
	mov %w2,-1;どれも選んでいない
	if %ResetFlag= 1 lsp 100,":a;SYS\saveload\saveload_save.bmp",0,0
	if %ResetFlag= 2 lsp 100,":a;SYS\saveload\saveload_load.bmp",0,0

*saveload_pagest
	gosub *saveload_loadpage
	print 1
	*saveload_btnst
	gosub *saveload_btndef
	print 1

	*saveload_btnloop
	btnwait2 %w3
	if %w3=-1 goto *saveload_end
	if %w3<0  goto *saveload_btnloop
	if %w3=10 PLAY_SE "SE\SYS\SYS_OK.wav":goto *saveload_save
	if %w3=11 PLAY_SE "SE\SYS\SYS_OK.wav":goto *saveload_load
	if %w3=12 PLAY_SE "SE\SYS\SYS_OK.wav":goto *config
	if %w3=13 PLAY_SE "SE\SYS\SYS_OK.wav":goto *config_title
	if %w3>=1 && %w3<=9 PLAY_SE "SE\SYS\SYS_OK.wav":mov %w1,%w3:goto *saveload_pagest
	if %w3=0  goto *saveload_btnloop
	;コンフィグボタン追加
	;if %w3=300 gosub *config:goto *loadgame

	;上書き処理
	mov %w3,%w3-21+%w1*9-9
	if %w0=0 goto *saveload_saveexec
	if %w0=1 goto *saveload_loadexec
goto *saveload_btnloop

*saveload_save
mov %w0,0
mov %ResetFlag,1
lsp 100,":a;SYS\saveload\saveload_save.bmp",0,0
goto *saveload_btnst

*saveload_load
mov %w0,1
mov %ResetFlag,2
lsp 100,":a;SYS\saveload\saveload_load.bmp",0,0
goto *saveload_btnst

*saveload_saveexec
savefileexist %w4,%w3
if %w4=0 goto *saveload_save_nofile
mov $w0,":a;SYS\dlg\over.bmp"
gosub *dialog
;btndef "SYS\saveload\btn.bmp"
if %w10=0 goto *saveload_btnst
*saveload_save_nofile
savegame %w3
mov %lastpage,%w1
mov $w0,"savesum\"
itoa $w1,%w3
add $w0,$w1
add $w0,".bmp"
savescreenshot2 $w0
gosub *saveload_setdata
goto *saveload_pagest

*saveload_loadexec
savefileexist %w4,%w3
if %w4=0 goto *saveload_btnloop
mov $w0,":a;SYS\dlg\load.bmp"
gosub *dialog
;btndef "SYS\saveload\btn.bmp"
if %w10=0 goto *saveload_btnst
;ゲームをロードする
loadgame %w3




;-------------------------------------------------
;オーバーライドした関数
;テキストオン
*texton
	vsp WindowButton,1
	vsp TextWindow2,1
	vsp TextCursor,1
	vsp FACE,1
        vsp NAMETAG,1
	PLACE_ON
	;DAY_ON
	print 1
	_texton
return

;テキストオフ
*textoff
	vsp WindowButton,0
	vsp TextWindow2,0
	vsp TextCursor,0
	vsp FACE,0
        vsp NAMETAG,0
	PLACE_OFF
	;DAY_OFF
	print 1
	_textoff
return

