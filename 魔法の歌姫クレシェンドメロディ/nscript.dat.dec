*CL_LD

	;コンフィグでエフェクトがオフの場合表示は簡素に	
        mov %244,2
	if %c_effect = 1 mov %244,1
	cl a,%244

return
;-----------------------------
;立ちキャラを消す
*CL_LDR

	;コンフィグでエフェクトがオフの場合表示は簡素に	
        mov %244,2
	if %c_effect = 1 mov %244,1
	cl r,%244

return
;-----------------------------
;立ちキャラを消す
*CL_LDL

	;コンフィグでエフェクトがオフの場合表示は簡素に	
        mov %244,2
	if %c_effect = 1 mov %244,1
	cl l,%244

return
;-----------------------------
;立ちキャラを消す
*CL_LDC

	;コンフィグでエフェクトがオフの場合表示は簡素に	
        mov %244,2
	if %c_effect = 1 mov %244,1
	cl c,%244

return
;-----------------------------
;フェードアウト
*FADE_OUT
getparam %245

    ;コンフィグでエフェクトがオフの場合表示は簡素に	
    if %c_effect = 1 mov %245,1

    BG BLACK,%245
    dwavestop 0

return

;-----------------------------
;効果音を止める
*STOP_SE
    dwavestop 10
return

;-----------------------------
;効果音を鳴らす
*PLAY_SE
getparam $23

    dwaveload 10,$23
    dwaveplay 10

return

;-----------------------------
;音声を鳴らす
*CHA_V
getparam %33,$38

;   鳴っている音声は、一旦止める
    dwavestop 0

    if %c_v0=1 && %33=1 goto *dwave_voice
    if %c_v1=1 && %33=2 goto *dwave_voice
    if %c_v2=1 && %33=3 goto *dwave_voice
    if %c_v3=1 && %33=4 goto *dwave_voice
    if %c_v4=1 && %33=5 goto *dwave_voice
    goto *dwave_skip

*dwave_voice
    chvol 0,%c_voicevol*100/10:dwaveload 0,$38:dwaveplay 0

*dwave_skip

return
