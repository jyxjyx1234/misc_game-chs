;   スタッフロール

*staffroll

BG BLACK,3
skipoff                         ;自動スキップＯＦＦ
textoff

bgmonce "BGM\03.wav"            ;音楽開始

delay 5000                      ;２秒ウェイト

BG "SYS\ending\ed01.bmp",3              ;ＣＧ表示

delay 7000                      ;２秒ウェイト

BG "SYS\ending\ed02.bmp",3              ;ＣＧ表示

delay 7000                      ;２秒ウェイト

BG "SYS\ending\ed03.bmp",3              ;ＣＧ表示

delay 7000                      ;２秒ウェイト

BG "SYS\ending\ed04.bmp",3              ;ＣＧ表示

delay 7000                      ;２秒ウェイト

BG "SYS\ending\ed05.bmp",3              ;ＣＧ表示

delay 7000                      ;２秒ウェイト

BG "SYS\ending\ed06.bmp",3              ;ＣＧ表示

delay 7000                      ;２秒ウェイト

BG "SYS\ending\ed07.bmp",3              ;ＣＧ表示

;delay 7000                      ;２秒ウェイト

;BG "SYS\ending\ed08.bmp",3              ;ＣＧ表示

delay 10000                      ;２秒ウェイト

mov %titleflag,1
mov %spmode,1

BG BLACK,4
bgmstop
goto *reset
