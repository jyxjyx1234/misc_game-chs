;sevol %c_sevol*25
bgmvol %c_bgmvol
voicevol %c_voicevol
sevol %c_sevol
chvol 1,%c_voicevol
chvol 2,%c_voicevol
chvol 3,%c_voicevol
chvol 4,%c_voicevol
chvol 5,%c_voicevol
chvol 6,%c_voicevol
chvol 7,%c_voicevol
chvol 8,%c_voicevol
