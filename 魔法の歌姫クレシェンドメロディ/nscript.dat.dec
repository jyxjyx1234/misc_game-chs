	;日付テーブル
	mov ?1[1][41],0501;
	mov ?1[1][40],0502;
	mov ?1[1][39],0503;
	mov ?1[1][38],0504;
	mov ?1[1][37],0505;
	mov ?1[1][36],0506;
	mov ?1[1][35],0507;
	mov ?1[1][34],0508;
	mov ?1[1][33],0509;
	mov ?1[1][32],0510;
	mov ?1[1][31],0511;
	mov ?1[1][30],0512;
	mov ?1[1][29],0513;
	mov ?1[1][28],0514;
	mov ?1[1][27],0515;
	mov ?1[1][26],0516;
	mov ?1[1][25],0517;
	mov ?1[1][24],0518;
	mov ?1[1][23],0519;
	mov ?1[1][22],0520;
	mov ?1[1][21],0521;
	mov ?1[1][20],0522;
	mov ?1[1][19],0523;
	mov ?1[1][18],0524;
	mov ?1[1][17],0525;
	mov ?1[1][16],0526;
	mov ?1[1][15],0527;
	mov ?1[1][14],0528;
	mov ?1[1][13],0529;
	mov ?1[1][12],0530;
	mov ?1[1][11],0531;
	mov ?1[1][10],0601;
	mov ?1[1][9],0602;
	mov ?1[1][8],0603;
	mov ?1[1][7],0604;
	mov ?1[1][6],0605;
	mov ?1[1][5],0606;
	mov ?1[1][4],0607;
	mov ?1[1][3],0608;
	mov ?1[1][2],0609;
	mov ?1[1][1],0610;
	mov ?1[1][0],0611;

	;文字列に変換
	itoa $62,?1[1][%58]

	mov $63,"0"
	RENKETU $63,$62
	
	;日付数を格納
	mov $%57,$63

return

;-----------------------------
;フェイス差し替え
;-----------------------------
*FACE_INSERT
getparam $74

	;フェイスの保持
	mov $FaceBuf,$74

	;ファイル名を取得
	mov $75,":a;LD\"
	RENKETU $75,$74
	RENKETU $75,".bmp"

	;スプライト設定
	lsp FACE,$75,0,FaceSetPosY	
	print 1

return


;-----------------------------
;フェイス表示
;-----------------------------
*FACE_SET
getparam $74

	;フェイス表示フラグ
	mov %132,1

	;無条件で音声を止める
	dwavestop 2:dwavestop 3:dwavestop 4:dwavestop 5:dwavestop 6:dwavestop 7:dwavestop 8

;   まいぱぺ用全裸立ちキャラ処理

    if %182=0 goto *FACE_nude_skip
    mid $75,$74,1,1
    if $75="A" goto *FACE_nude_skip
    if $75>"F" goto *FACE_nude_skip
    mid $75,$74,5,1
    if $75="B" goto *FACE_nude_skip
    if $75="C" goto *FACE_nude_skip

    mid $75,$74,0,5
    len %85,$74

    mov $74,$75
    if %182=1 goto *FACE_inner_skip1
    add $74,"C"
    goto *FACE_inner_skip2
*FACE_inner_skip1
    add $74,"B"
*FACE_inner_skip2

    notif %85=7 goto *FACE_SET_kaoru
    add $74,"S"
*FACE_SET_kaoru

*FACE_nude_skip

;   まいぱぺ用全裸立ちキャラ処理・終了

	;同一フェイスの場合は処理をスキップ
	if $FaceBuf=$74 goto *FACE_NON_SET

	;フェイスの保持
	mov $FaceBuf,$74

	;ファイル名を取得
	mov $75,":a;LD\"
	RENKETU $75,$74
	RENKETU $75,".bmp"
	
	;スプライト設定
	lsp FACE,$75,FaceSetPosX,FaceSetPosY
	
	;コンフィグでエフェクトがオフの場合アニメーションをしない	
	if %c_effect = 1 lsp FACE,$75,FacePosX,FaceSetPosY:goto *FACE_EF_EVADE

	;スキップモードを利用する
	isskip %38
	if %38=0 mov %39,FaceSpeedT1
	if %38=1 mov %39,FaceSpeedT2
	if %38=2 mov %39,FaceSpeedT3

	;フェイス表示アニメーション
	for %5=FaceSetPosX to FacePosX step %39
		amsp FACE,%5,FaceSetPosY,255
		print 1
	next
	
	*FACE_EF_EVADE
	
	;ト書き用ウィンドウに入れ替え
	setwindow2 ":a;SYS\window\MAIN_WINDOW.bmp"

	*FACE_NON_SET

return

;-----------------------------
;フェイスＯＦＦ
;-----------------------------
*FACE_OFF

	;無条件で音声を止める
	dwavestop 2:dwavestop 3:dwavestop 4:dwavestop 5:dwavestop 6:dwavestop 7:dwavestop 8

	;オープニングの場合もすっ飛ばす
	if %DEMO=0 goto *FACE_NON_OFF
	
	;コンフィグでエフェクトがオフの場合アニメーションをしない	
	if %c_effect = 1 goto *F_OF_EF_EVADE

	;フェイスが無い場合は処理をスキップ
	if $26="" goto *FACE_NON_OFF

	;スキップモードを利用する
	isskip %38
	if %38=0 mov %39,FaceSpeedT1
	if %38=1 mov %39,FaceSpeedT2
	if %38=2 mov %39,FaceSpeedT3

	;フェイス表示アニメーション
	for %5=FacePosX to FaceSetPosX step -%39
		amsp FACE,%5,FaceSetPosY,255
		print 1
	next

	*F_OF_EF_EVADE
	
	;スプライトの消去
	csp FACE

	;ウィンドウデザインの変更
	;オープニング開始
	setwindow2 ":a;SYS\window\MAIN_WINDOW.bmp"

	;フェイスバッファを空にする
	mov $26,""

	*FACE_NON_OFF

return

;-----------------------------
;立ち絵セット
*LD_SET
getparam $86,%84

	mov $87,":a;LD\"
	RENKETU $87,$86
	RENKETU $87,".bmp"

	;コンフィグ設定の反映
	if %c_effect = 1 mov %84,1

	;立ち絵表示
	ld C,$87,%84

return

;-----------------------------
;立ち絵セット右
*LD_SETR
getparam $86,%84

	mov $87,":a;LD\"
	RENKETU $87,$86
	RENKETU $87,".bmp"

	;コンフィグ設定の反映
	if %c_effect = 1 mov %84,1

	;立ち絵表示
	ld R,$87,%84

return

;-----------------------------
;立ち絵セット左
*LD_SETL
getparam $86,%84

	mov $87,":a;LD\"
	RENKETU $87,$86
	RENKETU $87,".bmp"

	;コンフィグ設定の反映
	if %c_effect = 1 mov %84,1

	;立ち絵表示
	ld L,$87,%84

return
;-----------------------------
;背景セット
;-----------------------------
*SET_BG
getparam $80

    mov $83,""                          ;ファイル名の初期化

    mid $56,$80,0,1                     ;ファイル名からＥＶからＢＧを判断する

    if $56="B" goto *OUTPUT_BG          ;ＥＶとＢＧを判別
;   if $56="E" goto *OUTPUT_EV

*OUTPUT_EV                              ;ＥＶを表示する

        mov $75,"EV\"                   ;ファイル名の作成
        RENKETU $75,$80
        RENKETU $75,".bmp"

        goto *OUTPUT

*OUTPUT_BG                              ;ＢＧを表示する

        mov $75,"BG\"                   ;ファイル名の作成
        RENKETU $75,$80
        RENKETU $75,".bmp"

        mid $81,$80,3,1                 ;ファイル名の４、５文字目
        mid $82,$80,4,1                 ;切り出してファイル名化
        RENKETU $83,$81
        RENKETU $83,$82

;        PLACE_SET $83                   ;場所表示
;        DATE_SET %date,%time            ;日付、時間帯表示

        goto *OUTPUT

*OUTPUT                                 ;表示部分

    mov %40,5                           ;基本エフェクト
    if %c_effect = 1 mov %40,1          ;コンフィグ設定の反映
;    PLACE_ON                            ;場所枠表示制御
    bg $75,%40                          ;背景表示

return

;-----------------------------
;イベントＣＧセット
;-----------------------------
*SET_EV
getparam $39,%47

    mov %EVENT,1                        ;イベント表示中は場所＆日付表示を消す

    PLACE_OFF                           ;日付＆場所表示を消す

    mov $46,"EV\"                       ;ファイル名の作成
    RENKETU $46,$39
    RENKETU $46,".bmp"

    mov %40,%47                         ;基本エフェクト

    if %c_effect = 1 mov %40,1          ;コンフィグ設定の反映

    erasetextwindow 1                   ;エフェクトはウィンドウを消す

    bg $46,%40                          ;背景として表示

;-----------------------------------
;   デバック表示\

    if %DEBUG_SWITCH = 0 goto *NON_DB_SET_EV 
    csp 399

;   Ｈシーンの場合

    mid $298,$39,2,2
    if $298 = "_H" add $39,"H"
    mov $299,":s/30,30,0;#ffffff"
    add $299,$39
    lsp 399,$299,0,200:print 1

*NON_DB_SET_EV

;-----------------------------------

    erasetextwindow 0                   ;ウィンドウ復帰

return

;-----------------------------
;背景セット（フェードアウト）
;-----------------------------
*SET_BG_FADE
getparam %85

    textoff                             ;テキストウィンドウ消去

    mov %41,7                           ;基本フェードエフェクト番号

    if %c_effect = 1 mov %41,1          ;コンフィグ設定の反映

    if %85=1 bg black,%41               ;黒フェード
    if %85=2 bg white,%41               ;白フェード

    DATE_SET %date,%time                ;日付をセットする

    texton                              ;テキストウィンドウをＯＮにする

;    PLACE_ON                            ;日付枠表示制御

;   コンフィグでエフェクトがオフの場合表示は簡素に	

    if %c_effect = 1 mov %321,1
    if %c_effect = 0 mov %321,3

    print %321

return


;-----------------------------
;場所名のセット
;-----------------------------
*PLACE_SET
getparam $71

    mov %EVENT,0                        ;イベントＣＧ表示フラグＯＦＦ

    if $71 = "" goto *PLACE_erase_sprite

    mov $72,":a;SYS\window\PLACE\"
    RENKETU $72,$71
    RENKETU $72,".bmp"

    lsph PlaceName,$72,PlaceNamePosX,PlaceNamePosY
    goto *PLACE_SET_ret

*PLACE_erase_sprite                     ;該当ファイルがない場合、スプライト消去
    csp PlaceName

*PLACE_SET_ret

return

;-----------------------------
;日付、時間帯のセット
;-----------------------------
*DATE_SET
getparam %84,%85

    if %84 = 0 goto *DATE_erase_sprite
    if %85 = 0 goto *DATE_erase_sprite

    mov $72,":a;SYS\window\DATE\"       ;日付スプライト
    itoa $71,%84
    RENKETU $72,$71
    RENKETU $72,"day.bmp"
    lsph DATE_sprite,$72,DateNamePosX,DateNamePosY

    mov $72,":a;SYS\window\DATE\time"   ;時間帯スプライト
    itoa $71,%85
    RENKETU $72,$71
    RENKETU $72,".bmp"
    lsph TIME_sprite,$72,TimeNamePosX,TimeNamePosY

    goto *DATE_SET_ret

*DATE_erase_sprite                      ;該当ファイルがない場合、スプライト消去
    csp DATE_sprite
    csp TIME_sprite

*DATE_SET_ret

return

;-----------------------------
;場所表示＆日付表示をＯＦＦにする
;-----------------------------
*PLACE_OFF

    vsp PlaceName,0
    vsp PlacePlate,0
    vsp DATE_sprite,0
    vsp TIME_sprite,0
    print 1

return

;-----------------------------
;場所表示＆日付表示をＯＮにする
;-----------------------------
*PLACE_ON

    if %PLACE = 1 && %EVENT = 0:vsp FACE,1
    if %PLACE = 1 && %EVENT = 0:vsp PlaceName,1
    if %PLACE = 1 && %EVENT = 0:vsp PlacePlate,1
    if %PLACE = 1 && %EVENT = 0:vsp DATE_sprite,1
    if %PLACE = 1 && %EVENT = 0:vsp TIME_sprite,1
    print 1

return

;-----------------------------
;フラッシュ
;-----------------------------
*EF_FLASH
getparam %78

;%78 ...エフェクト番号

	lsp 169,":c;SYS\WHITE.bmp",0,0
	print 1
	msp 169,0,0,-255
	print %78
	csp 169
	print 1

return
;-----------------------------
;赤フラッシュ
;-----------------------------
*ER_FLASH
getparam %78

;%78 ...エフェクト番号

	lsp 169,":c;SYS\RED.bmp",0,0
	print 1
	msp 169,0,0,-255
	print %78
	csp 169
	print 1

return
