;-----------------------------
;ランダム音声再生（システム用）
*RND_WAVE
getparam %83

	if %83=1 goto *TITLE_WAVE
	if %83=2 goto *CG_MODE_WAVE
	if %83=3 goto *SOUND_MODE_WAVE

	*TITLE_WAVE
		;ランダムにタイトルコールをする
		rnd %67,5
		if %67=0 PLAY_SE "voice\VB_2201.wav"
		if %67=1 PLAY_SE "voice\VC_1877.wav"
		if %67=2 PLAY_SE "voice\VD_1450.wav"
		if %67=3 PLAY_SE "voice\VE_0802.wav"
		if %67=4 PLAY_SE "voice\VF_1280.wav"
		if %67=5 PLAY_SE "voice\VG_1229.wav"
		goto *RND_WAVE_END


	*CG_MODE_WAVE
		;ランダムにタイトルコールをする
		rnd %67,5
		if %67=0 PLAY_SE "voice\VB_2207.wav"
		if %67=1 PLAY_SE "voice\VC_1878.wav"
		if %67=2 PLAY_SE "voice\VD_1451.wav"
		if %67=3 PLAY_SE "voice\VE_0803.wav"
		if %67=4 PLAY_SE "voice\VF_1281.wav"
		if %67=5 PLAY_SE "voice\VG_1230.wav"
		goto *RND_WAVE_END

	*SOUND_MODE_WAVE
		;ランダムにタイトルコールをする
		rnd %67,5
		if %67=0 PLAY_SE "voice\VB_2208.wav"
		if %67=1 PLAY_SE "voice\VC_1879.wav"
		if %67=2 PLAY_SE "voice\VD_1452.wav"
		if %67=3 PLAY_SE "voice\VE_0804.wav"
		if %67=4 PLAY_SE "voice\VF_1282.wav"
		if %67=5 PLAY_SE "voice\VG_1231.wav"
		goto *RND_WAVE_END


	*RND_WAVE_END
return


;-----------------------------
;エンディング
*ENDING
getparam %82


	;無条件で音声を止める
	dwavestop 2:dwavestop 3:dwavestop 4:dwavestop 5:dwavestop 6:dwavestop 7:dwavestop 8

	;音楽の全てを呈し
	STOP

	;フェードアウト
	bg black,3
	
	;テキストウィンドウ消去
	textoff

	;バットエンドの場合
	if %82 = 2 bg black,3:goto *ENDING_END

	;エクストラモード解放フラグ
	mov %815,1
	
	GO_LABEL *start_staff_roll

	;フェードアウト
	bg black,99

	*ENDING_END

	;BGM 停止
	BGM_STOP 900
	
	;リセット（タイトルに戻る）
	reset

return

;-----------------------------
;日付表示（デバック）
*DEBUG_DAY

	mov $28,"日付："
	RENKETU $28,$30

	;スプライト設定
	csp 127
	if %DEBUG_SWITCH = 1 lsp 127,":s/25,25,0;#ffffff$28",0,50
	print 1

return

;-------------------------------------------------
;シナリオへジャンプする
*GO_LABEL
getparam $27

	csp 124
	print 1
	mov $28,"ラベル名："
	RENKETU $28,$27
	if %DEBUG_SWITCH = 1 lsp 124,":s/25,25,0;#ffffff$28",0,75
	print 1

	;デバックモード
	;if %SKIP_TEXT_DEBUG = 1 goto *DEBUG_LABEL

	;指定されたラベルへ飛ぶ
	gosub $27

	*DEBUG_LABEL

return

;-------------------------------------------------
*CHANGE_STRING_MONEY
getparam s%125,%121

	;表示変数の初期化
	mov $%125,""

	;金額を文字列に変換する
	mov $125,"『 "
	itoa $124,%121
	RENKETU $125,$124
	RENKETU $125," 円』"
	add $%125,$125

	;表示変数の初期化
	mov $125,""
	mov $124,""


return

