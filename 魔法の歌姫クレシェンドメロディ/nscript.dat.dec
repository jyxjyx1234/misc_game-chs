;-----------------------------------------------------------

;-------------------------------------------------
;スタートファイル
;-------------------------------------------------
;-----------------------------------------------------------
;実行フェイズ
*start

;----------------------
;以下の２行は正式スクリプトにも必要です。
;コンフィグ初期設定
if %c_first=0 gosub *set_default_config_setting

;コンフィグ設定の反映
gosub *config_refrect
;また、ゲームテキストが表示される通常画面モードに移行する前に、
;gosub  *load_windowchipを実行してください。
;このスクリプトでは*GAME_MAINのすぐ下で呼んであります。
;また、texton textoffは同名サブルーチンで書き換えてあります。
;----------------------

setcursor 0,":l/4,160,0;SYS\cursor0.bmp",0,8
setcursor 1,":l/4,160,0;SYS\cursor1.bmp",0,0

;デバック 1ならデバック　0なら通常
mov %DEBUG_SWITCH,0
mov %SKIP_TEXT_DEBUG,0
mov %SKIP_MAP_DEBUG,0

;デバックモードのＯＮ／ＯＦＦ
if %DEBUG_SWITCH = 0 goto *LOGO
if %DEBUG_SWITCH = 1 goto *DEBUG

;デバックモード
*DEBUG
　　　　　　　　　　　
*reset

mov %START_FLAG,0

;オープニング終了
mov %246,1

;右クリック制限
mov %43,0


;goto *TITLE
;goto *config
;goto *SOUND_MODE
;goto *DEBUG_DATA
;goto *EXTRA
;goto *MAIN_GAME


;ブランドロゴ
*LOGO
bg WHITE,2
bg "SYS\LOGO.bmp",3
PLAY_SE "SE\SYS\brandcall.wav"
delay 4500
bg WHITE,3


;タイトル画面
*TITLE


;タイトル画面ＢＧＭ
bgm "BGM\02.wav"

;タイトル画面移行後の戻り箇所
*TITLE_RE

;if %titleflag == 1 goto *title2

;タイトル画面表示
bg "SYS\TITLE\title.bmp",3

;タイトルコール再生
;RND_WAVE 1

btndef "SYS\TITLE\title_r.bmp"

goto *titleset

*title2

;タイトル画面表示
bg "SYS\TITLE\title.bmp",3

;タイトルコール再生
;RND_WAVE 1

btndef "SYS\TITLE\title_rb.bmp"

*titleset

btn 1,398,394,145,52,0,0
btn 2,605,394,135,52,207,0
btn 3,398,457,188,50,0,63
btn 4,605,455,165,51,207,61
btn 5,398,516,250,50,0,122

*MAIN_MENU
btnwait2 %11
if %11=-1 goto *MAIN_MENU
if %11=-2 goto *MAIN_MENU
if %11=-3 goto *MAIN_MENU
if %11=0 goto *MAIN_MENU
if %11=1 goto *MAIN_GAME
if %11=2 gosub *loadgame:goto *TITLE_RE ;コンフィグモードから戻り処理
if %11=3 gosub *config:goto *TITLE_RE ;コンフィグモードから戻り処理
if %11=4 gosub *EXTRA
if %11=5 delay 1800: end

;-----------------------------------------------------------
;ゲームスタート－
*MAIN_GAME

;ＢＧＭストップ
bgmstop

;黒背景
FADE_OUT 3

;-----------------------------
;変数の初期化

;数字が０の時は、テキストウィンドウが、エフェクトのときにも出っ放しになります。
;１がデフォルトで、エフェクトのたびに、ウィンドウを消去します。 
erasetextwindow 0

;ウィンドウ設定
SetWindowOrg

;ゲームスタートフラグ
mov %START_FLAG,1

;オープニング終了
mov %DEMO,1

mov %EXFlag,0

;初期値
mov %210,490

;ウィンドウパーツの読み込み
gosub *load_windowchip


;右クリック制限
mov %43,0

;場所表示を開始する
;mov %PLACE,1
PLACE_OFF
;-------------------------------------------------
;一日の調査
goto *GAME_START

;-------------------------------------------------
;ここで終端\
end


;魔法の歌姫クレッシェンド・メロディ
;me001

*GAME_START
goto *dummystart

*dummystart

humanorder "crl",1

*me001

mov %22,21

bgm "BGM\08.wav"

BG BLACK,3
;背景　黒画面

