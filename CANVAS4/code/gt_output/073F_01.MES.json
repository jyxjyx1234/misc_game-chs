[
    {
        "ori": "第二美術室だったら、遠慮なく寝られるかな……",
        "message": "要是在第二美术室的话，应该就能毫无顾忌地睡一觉了吧……",
        "text_idx": [
            99
        ]
    },
    {
        "ori": "鷺ノ宮先輩にもいつ来てもいいって言われてるし……",
        "message": "鹭之宫前辈也说过，我什么时候来都可以……",
        "text_idx": [
            122
        ]
    },
    {
        "ori": "空腹もあるけど、それ以上に今はゆっくり寝たい……",
        "message": "虽然肚子也饿，但比起那个，现在我更想好好睡一觉……",
        "text_idx": [
            138
        ]
    },
    {
        "name": "亮",
        "name_idx": 144,
        "ori": "それじゃ……行くか。",
        "message": "那么……走吧。",
        "text_idx": [
            153
        ]
    },
    {
        "ori": "我ながら、ゾンビのような足取りで、旧校舎に向かう。",
        "message": "我迈着自己都觉得像丧尸一样的步伐，走向旧校舍。",
        "text_idx": [
            213
        ]
    },
    {
        "name": "亮",
        "name_idx": 264,
        "ori": "「お、鷺ノ宮先輩はいないみたいだな……」",
        "message": "「哦，鹭之宫前辈好像不在啊……」",
        "text_idx": [
            273
        ]
    },
    {
        "ori": "ラッキーなような、少し残念なような。",
        "message": "也不知是幸运，还是有点遗憾。",
        "text_idx": [
            288
        ]
    },
    {
        "name": "亮",
        "name_idx": 294,
        "ori": "「とにかく……ここでなら……」",
        "message": "「总之……在这里的话……」",
        "text_idx": [
            303
        ]
    },
    {
        "ori": "そこまで独り言を言ったのは覚えてる。",
        "message": "我只记得自己自言自语到了这里。",
        "text_idx": [
            318
        ]
    },
    {
        "ori": "あ……もう、限界……",
        "message": "啊……已经，到极限了……",
        "text_idx": [
            333
        ]
    },
    {
        "ori": "そこで、俺の意識は完全に闇に落ちた。",
        "message": "就在那里，我的意识完全陷入了黑暗。",
        "text_idx": [
            348
        ]
    },
    {
        "ori": "……",
        "message": "……",
        "text_idx": [
            450
        ]
    },
    {
        "ori": "…………",
        "message": "…………",
        "text_idx": [
            465
        ]
    },
    {
        "ori": "………………",
        "message": "………………",
        "text_idx": [
            480
        ]
    },
    {
        "ori": "ん……",
        "message": "唔……",
        "text_idx": [
            495
        ]
    },
    {
        "ori": "なんだか、妙に寝心地がいいような……",
        "message": "总觉得，睡得意外地舒服……",
        "text_idx": [
            510
        ]
    },
    {
        "ori": "それに、なんだか、懐かしい……",
        "message": "而且，总觉得，有种怀念的感觉……",
        "text_idx": [
            525
        ]
    },
    {
        "name": "亮",
        "name_idx": 531,
        "ori": "「ん……」",
        "message": "「嗯……」",
        "text_idx": [
            540
        ]
    },
    {
        "ori": "ゆっくりと意識が覚醒していくのに任せて、寝返り一つ。",
        "message": "任由意识慢慢清醒，我翻了个身。",
        "text_idx": [
            555,
            556
        ]
    },
    {
        "ori": "枕を抱き寄せるように、頭に感じるやわらかい感触に手を伸ばして……",
        "message": "像是要抱住枕头一样，我伸手去摸头上那柔软的触感……",
        "text_idx": [
            571,
            572
        ]
    },
    {
        "name": "？",
        "name_idx": 592,
        "ori": "「きゃっ！？」",
        "message": "「呀！？」",
        "text_idx": [
            601
        ]
    },
    {
        "name": "亮",
        "name_idx": 607,
        "ori": "「ほへ……？」",
        "message": "「哦嘿……？」",
        "text_idx": [
            616
        ]
    },
    {
        "name": "亮",
        "name_idx": 778,
        "ori": "「あ、あれ……ここは……」",
        "message": "「啊，咦……这里是……」",
        "text_idx": [
            787
        ]
    },
    {
        "ori": "……第二美術室……だよな？",
        "message": "……这里是第二美术室……吧？",
        "text_idx": [
            1041
        ]
    },
    {
        "ori": "なんでこんなところに……",
        "message": "我为什么会在这种地方……",
        "text_idx": [
            1295
        ]
    },
    {
        "name": "亮",
        "name_idx": 1301,
        "ori": "「そっか、ここで寝させてもらおうと……」",
        "message": "「对了，我是想在这里睡一会的……」",
        "text_idx": [
            1310
        ]
    },
    {
        "ori": "……寝ぼけた頭が少しだけはっきりしてきた。",
        "message": "……我还有些迷糊的脑袋稍微清醒了一点。",
        "text_idx": [
            1325
        ]
    },
    {
        "name": "亮",
        "name_idx": 1331,
        "ori": "「えっと、さっきの声……」",
        "message": "「那个，刚才的声音是……」",
        "text_idx": [
            1340
        ]
    },
    {
        "name": "？",
        "name_idx": 1360,
        "ori": "「おはようございます。小松原くん」",
        "message": "「早上好。小松原同学」",
        "text_idx": [
            1369
        ]
    },
    {
        "name": "亮",
        "name_idx": 1375,
        "ori": "「え、ええっと……」",
        "message": "「那、那个……」",
        "text_idx": [
            1384
        ]
    },
    {
        "name": "亮",
        "name_idx": 1404,
        "ori": "「鷺ノ宮先輩……？」",
        "message": "「鹭之宫前辈……？」",
        "text_idx": [
            1413
        ]
    },
    {
        "name": "紬",
        "name_idx": 1433,
        "ori": "「はい」",
        "message": "「嗯」",
        "text_idx": [
            1442
        ]
    },
    {
        "ori": "はて、声はすれども姿は見えず……",
        "message": "奇怪，只听得到声音，却看不到人……",
        "text_idx": [
            1457
        ]
    },
    {
        "ori": "というか、少し暗いような……",
        "message": "话说回来，感觉有点暗……",
        "text_idx": [
            1472
        ]
    },
    {
        "name": "亮",
        "name_idx": 1478,
        "ori": "「え、ええっと、鷺ノ宮先輩……どこですか？」",
        "message": "「呃、那个，鹭之宫前辈……你在哪里？」",
        "text_idx": [
            1487
        ]
    },
    {
        "name": "紬",
        "name_idx": 1746,
        "ori": "「はい？　ここですけど……」",
        "message": "「嗯？　我就在这里啊……」",
        "text_idx": [
            1755
        ]
    },
    {
        "ori": "はて？",
        "message": "奇怪？",
        "text_idx": [
            1770
        ]
    },
    {
        "ori": "ここ、と鷺ノ宮先輩は言うけれど、声がする方向にはえんじ色の二つの山が……",
        "message": "虽然鹭之宫前辈说是这里，但在声音传来的方向上有两座暗红色的山峰……",
        "text_idx": [
            1785,
            1786
        ]
    },
    {
        "name": "亮",
        "name_idx": 1792,
        "ori": "「ん……」",
        "message": "「嗯……」",
        "text_idx": [
            1801
        ]
    },
    {
        "ori": "まだ寝ぼけてるんだな、もしくは夢。",
        "message": "我果然是还没睡醒，或者是在做梦。",
        "text_idx": [
            1816
        ]
    },
    {
        "ori": "もうちょっとすれば、きっと意識もはっきりと……",
        "message": "再过一会儿，意识一定会变得清晰……",
        "text_idx": [
            1831
        ]
    },
    {
        "name": "紬",
        "name_idx": 1851,
        "ori": "「あ、あの……」",
        "message": "「啊，那个……」",
        "text_idx": [
            1860
        ]
    },
    {
        "name": "亮",
        "name_idx": 1866,
        "ori": "「……ふぁ？」",
        "message": "「……哈？」",
        "text_idx": [
            1875
        ]
    },
    {
        "name": "紬",
        "name_idx": 1895,
        "ori": "「あまり動かれますと、少しくすぐったいです……」",
        "message": "「你动作太大的话，会有点痒的……」",
        "text_idx": [
            1904
        ]
    },
    {
        "name": "亮",
        "name_idx": 1910,
        "ori": "「はい……？」",
        "message": "「啊……？」",
        "text_idx": [
            1919
        ]
    },
    {
        "ori": "えっと……",
        "message": "那个……",
        "text_idx": [
            1934
        ]
    },
    {
        "ori": "……なんだろ。この枕……",
        "message": "……是什么呢。这个枕头……",
        "text_idx": [
            1949
        ]
    },
    {
        "ori": "みょうにスベスベで……",
        "message": "感觉异常地光滑……",
        "text_idx": [
            1964
        ]
    },
    {
        "name": "紬",
        "name_idx": 2092,
        "ori": "「ひゃんっ！」",
        "message": "「呀嗯！」",
        "text_idx": [
            2101
        ]
    },
    {
        "name": "亮",
        "name_idx": 2107,
        "ori": "「……え？」",
        "message": "「……诶？」",
        "text_idx": [
            2116
        ]
    },
    {
        "ori": "あ、あれ？",
        "message": "啊、奇怪？",
        "text_idx": [
            2131
        ]
    },
    {
        "ori": "肌色で、温かくて……スベスベで……って……",
        "message": "肤色的，暖暖的……还滑溜溜的……这么说来……",
        "text_idx": [
            2737
        ]
    },
    {
        "ori": "これって……もしかして……",
        "message": "这个……莫非是……",
        "text_idx": [
            2752
        ]
    },
    {
        "name": "亮",
        "name_idx": 2758,
        "ori": "「わ、わぁっ！？」",
        "message": "「哇、哇啊！？」",
        "text_idx": [
            2767
        ]
    },
    {
        "name": "紬",
        "name_idx": 2992,
        "ori": "「おはようございます。小松原くん」",
        "message": "「早上好。小松原同学」",
        "text_idx": [
            3001
        ]
    },
    {
        "name": "亮",
        "name_idx": 3051,
        "ori": "「お、おはようございます……じゃなくて」",
        "message": "「早、早上好……不对」",
        "text_idx": [
            3060
        ]
    },
    {
        "ori": "あ、あれ、これっと、もしかして、もしかしなくても……",
        "message": "啊、奇怪，这个，难道说，已经不是难道说了……",
        "text_idx": [
            3075
        ]
    },
    {
        "name": "亮",
        "name_idx": 3081,
        "ori": "「え、えっと、その、膝枕……」",
        "message": "「那、那个，是……膝枕……」",
        "text_idx": [
            3090
        ]
    },
    {
        "name": "紬",
        "name_idx": 3154,
        "ori": "「小松原くんの寝顔、とってもかわいかったですよ」",
        "message": "「小松原同学的睡脸，非常可爱哦」",
        "text_idx": [
            3163
        ]
    },
    {
        "name": "亮",
        "name_idx": 3169,
        "ori": "「う、か、からかわないでくださいよ……」",
        "message": "「呜、别、别取笑我了……」",
        "text_idx": [
            3178
        ]
    },
    {
        "name": "紬",
        "name_idx": 3198,
        "ori": "「あら、本当ですのに」",
        "message": "「哎呀，我说的是实话呀」",
        "text_idx": [
            3207
        ]
    },
    {
        "name": "亮",
        "name_idx": 3213,
        "ori": "「え、ええっと、その……ど、どうして……」",
        "message": "「那、那个……为、为什么……」",
        "text_idx": [
            3222
        ]
    },
    {
        "name": "紬",
        "name_idx": 3286,
        "ori": "「ここにきたら、小松原くんが倒れてたんですもの。びっくりしてしまいました」",
        "message": "「我来到这里的时候，发现小松原同学倒在这里了嘛。吓了我一跳」",
        "text_idx": [
            3295,
            3296
        ]
    },
    {
        "name": "亮",
        "name_idx": 3302,
        "ori": "「それは、その……お騒がせしました」",
        "message": "「那、那个……给你添麻烦了」",
        "text_idx": [
            3311
        ]
    },
    {
        "name": "紬",
        "name_idx": 3375,
        "ori": "「いえいえ、眠っているだけだとわかりましたから、気にしなくていいですよ」",
        "message": "「不不，我知道你只是睡着了，所以不用在意的哦」",
        "text_idx": [
            3384,
            3385
        ]
    },
    {
        "name": "亮",
        "name_idx": 3391,
        "ori": "「は、はあ……」",
        "message": "「是、是……」",
        "text_idx": [
            3400
        ]
    },
    {
        "ori": "その時、ようやく把握できた。",
        "message": "这时，我才总算弄明白状况了。",
        "text_idx": [
            3634
        ]
    },
    {
        "ori": "紬先輩の胸に隠れて顔が見えなかったんだな……",
        "message": "原来是因为被紬学姐的胸口挡住了，所以才没看到她的脸啊……",
        "text_idx": [
            3649
        ]
    },
    {
        "name": "紬",
        "name_idx": 3732,
        "ori": "「どうかされましたか？　お顔が真っ赤ですよ？」",
        "message": "「怎么了吗？　你的脸很红哦？」",
        "text_idx": [
            3741
        ]
    },
    {
        "name": "亮",
        "name_idx": 3859,
        "ori": "「い、いえっ！？　なんでもないですっ！」",
        "message": "「不、不是！？　什么事都没有！」",
        "text_idx": [
            3868
        ]
    },
    {
        "ori": "い、いかんいかん、ぼーっとすると、ついつい視線が下がってしまう。",
        "message": "不、不行不行，一发呆，视线就不自觉地往下移了。",
        "text_idx": [
            3883,
            3884
        ]
    },
    {
        "name": "紬",
        "name_idx": 3962,
        "ori": "「あら……もう、お昼休みも終わりのようですね」",
        "message": "「哎呀……午休时间好像已经要结束了呢」",
        "text_idx": [
            3971
        ]
    },
    {
        "name": "亮",
        "name_idx": 3977,
        "ori": "「そ、そうですね？」",
        "message": "「是、是呢？」",
        "text_idx": [
            3986
        ]
    },
    {
        "name": "紬",
        "name_idx": 4050,
        "ori": "「一年生の教室は三年生の教室よりも遠いでしょう？どうぞお先にいってくださいな」",
        "message": "「一年级的教室比三年级的教室要远吧？请你先回去吧」",
        "text_idx": [
            4059,
            4060
        ]
    },
    {
        "name": "亮",
        "name_idx": 4066,
        "ori": "「は、はいっ！」",
        "message": "「是、是！」",
        "text_idx": [
            4075
        ]
    },
    {
        "name": "亮",
        "name_idx": 4170,
        "ori": "「きょ、教室に戻らないとな」",
        "message": "「我、我得回教室了」",
        "text_idx": [
            4179
        ]
    },
    {
        "ori": "誰かに言い訳するみたいにそう言うと、俺は第二美術室を後にした。",
        "message": "我像是对谁辩解似的说完，便离开了第二美术室。",
        "text_idx": [
            4194,
            4195
        ]
    }
]