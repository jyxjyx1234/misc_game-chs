[
    {
        "ori": "午前の授業の終わりを告げるチャイムと共に、俺は席を立ち上がった。",
        "message": "伴随着宣告上午课程结束的铃声，我从座位上站了起来。",
        "text_idx": [
            60,
            61
        ]
    },
    {
        "ori": "昼休みの解放感に沸き立つ教室の雰囲気が俺には耐えられなかったから。",
        "message": "因为我无法忍受教室里因午休的解放感而沸腾的气氛。",
        "text_idx": [
            76,
            77
        ]
    },
    {
        "name": "円",
        "name_idx": 141,
        "ori": "「小松原くーん！　一緒にご飯しよー！」",
        "message": "「小松原同学—！　我们一起吃饭吧—！」",
        "text_idx": [
            150
        ]
    },
    {
        "name": "ことの",
        "name_idx": 214,
        "ori": "「亮ちゃん、お母さんからお弁当預かってきたから……」",
        "message": "「小亮，我从阿姨那儿帮你把便当带来了……」",
        "text_idx": [
            223
        ]
    },
    {
        "name": "亮",
        "name_idx": 229,
        "ori": "「ごめん、俺、今日パンにするから」",
        "message": "「抱歉，我今天就吃面包了」",
        "text_idx": [
            238
        ]
    },
    {
        "name": "ことの",
        "name_idx": 346,
        "ori": "「あ……」",
        "message": "「啊……」",
        "text_idx": [
            355
        ]
    },
    {
        "ori": "恐らくは気を遣ってくれたのだろう二人からも、俺は逃げ出した。",
        "message": "恐怕她们两人是出于关心，但我还是从她们身边逃开了。",
        "text_idx": [
            370,
            371
        ]
    },
    {
        "ori": "誰かといると、エゴイスティックな自分を見せつけられるような気がした。",
        "message": "只要和别人待在一起，我就会感觉自己那自私自利的一面仿佛被展现在眼前。",
        "text_idx": [
            445,
            446
        ]
    },
    {
        "ori": "今は誰とも会いたくない。",
        "message": "我现在谁也不想见。",
        "text_idx": [
            461
        ]
    },
    {
        "ori": "購買でパンを買うと、俺の足は自然と人気のない方へと向かった。",
        "message": "在小卖部买了面包后，我的脚步自然而然地朝着人少的地方走去。",
        "text_idx": [
            476,
            477
        ]
    },
    {
        "ori": "「屋上へ」",
        "message": "「去屋顶」",
        "text_idx": [
            535
        ]
    },
    {
        "ori": "「旧校舎へ」",
        "message": "「去旧校舍」",
        "text_idx": [
            555
        ]
    }
]