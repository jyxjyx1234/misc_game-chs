[
    {
        "ori": "朝日が目に眩しい。",
        "message": "朝阳十分刺眼。",
        "text_idx": [
            657
        ]
    },
    {
        "name": "亮",
        "name_idx": 663,
        "ori": "「はぁあ……」",
        "message": "「哈啊……」",
        "text_idx": [
            672
        ]
    },
    {
        "ori": "大あくびをしながら、鮮やかなスカイブルーの空を見上げた。",
        "message": "我打着大哈欠，抬头仰望那鲜艳的天蓝色天空。",
        "text_idx": [
            687,
            688
        ]
    },
    {
        "name": "ことの",
        "name_idx": 865,
        "ori": "「亮ちゃん、眠そうだね」",
        "message": "「小亮，你看起来很困呢」",
        "text_idx": [
            874
        ]
    },
    {
        "name": "亮",
        "name_idx": 880,
        "ori": "「まあね」",
        "message": "「算是吧」",
        "text_idx": [
            889
        ]
    },
    {
        "name": "ことの",
        "name_idx": 909,
        "ori": "「昨日、夜遅くまで絵描いてたの？」",
        "message": "「昨天画画画到很晚吗？」",
        "text_idx": [
            918
        ]
    },
    {
        "name": "亮",
        "name_idx": 924,
        "ori": "「う、うん、まぁ」",
        "message": "「呃、嗯，算是吧」",
        "text_idx": [
            933
        ]
    },
    {
        "ori": "純粋な顔をして聞いてくるので、昨夜のことを少し後ろめたく感じてしまう。",
        "message": "她一脸纯真地问我，让我不禁对昨晚的事感到有些心虚。",
        "text_idx": [
            948,
            949
        ]
    },
    {
        "ori": "いやまぁ、堂々と言えるわけないよなぁ。",
        "message": "哎呀，这种事怎么可能堂堂正正地说出口啊。",
        "text_idx": [
            964
        ]
    },
    {
        "ori": "蘭は学校の教科書やらを準備しないといけないので、早朝に帰っていった。",
        "message": "兰因为要准备学校的教科书之类的东西，一大早就回去了。",
        "text_idx": [
            979,
            980
        ]
    },
    {
        "name": "亮",
        "name_idx": 986,
        "ori": "「いい天気だよな」",
        "message": "「天气真好啊」",
        "text_idx": [
            995
        ]
    },
    {
        "name": "ことの",
        "name_idx": 1059,
        "ori": "「そうだねぇ」",
        "message": "「是呢」",
        "text_idx": [
            1068
        ]
    },
    {
        "ori": "爽やかな陽の下で、いつものようにことのと二人で歩いていると、昨夜のことが夢か幻だったような気がした。",
        "message": "在清爽的阳光下，和琴乃像往常一样并肩走着，让我感觉昨晚发生的事就像一场梦幻。",
        "text_idx": [
            1083,
            1084
        ]
    },
    {
        "ori": "バスに乗り込み、景色をぼんやり眺めながら学校へ向かう。",
        "message": "我坐上公交车，一边茫然地望着窗外的景色，一边向学校驶去。",
        "text_idx": [
            1143,
            1144
        ]
    },
    {
        "ori": "蘭、もう来てるのかな……？",
        "message": "兰，已经到了吗……？",
        "text_idx": [
            1159
        ]
    },
    {
        "ori": "蘭の事を考えると自然と胸がはずんで、同時に少し恥ずかしい気がした。",
        "message": "一想到兰，我的心就不由得雀跃起来，同时又感到有些害羞。",
        "text_idx": [
            1174,
            1175
        ]
    },
    {
        "ori": "どういう挨拶をしたらいいんだろう？",
        "message": "该怎么和她打招呼才好呢？",
        "text_idx": [
            1190
        ]
    },
    {
        "ori": "というか、どういう顔をして……？",
        "message": "或者说，该用什么样的表情……？",
        "text_idx": [
            1205
        ]
    },
    {
        "name": "亮",
        "name_idx": 1232,
        "ori": "「うーむ」",
        "message": "「唔」",
        "text_idx": [
            1241
        ]
    },
    {
        "name": "ことの",
        "name_idx": 1305,
        "ori": "「亮ちゃん？」",
        "message": "「小亮？」",
        "text_idx": [
            1314
        ]
    },
    {
        "name": "亮",
        "name_idx": 1320,
        "ori": "「あ、ごめんごめん」",
        "message": "「啊，抱歉抱歉」",
        "text_idx": [
            1329
        ]
    },
    {
        "name": "ことの",
        "name_idx": 1764,
        "ori": "「亮ちゃんってさ」",
        "message": "「我说小亮啊」",
        "text_idx": [
            1773
        ]
    },
    {
        "name": "亮",
        "name_idx": 1779,
        "ori": "「ん？」",
        "message": "「嗯？」",
        "text_idx": [
            1788
        ]
    },
    {
        "name": "ことの",
        "name_idx": 1906,
        "ori": "「蘭ちゃんと付き合ってるの？」",
        "message": "「你和小兰在交往吗？」",
        "text_idx": [
            1915
        ]
    },
    {
        "name": "亮",
        "name_idx": 1921,
        "ori": "「っぶ！」",
        "message": "「噗！」",
        "text_idx": [
            1930
        ]
    },
    {
        "ori": "ギャグ漫画みたいに吹き出してしまった。",
        "message": "我像搞笑漫画里一样喷了出来。",
        "text_idx": [
            1945
        ]
    },
    {
        "name": "ことの",
        "name_idx": 2063,
        "ori": "「図星？」",
        "message": "「猜中了？」",
        "text_idx": [
            2072
        ]
    },
    {
        "name": "亮",
        "name_idx": 2078,
        "ori": "「あぁ、まあ……」",
        "message": "「啊，算是吧……」",
        "text_idx": [
            2087
        ]
    },
    {
        "ori": "別に隠す事ではないし、素直に頷いた。",
        "message": "反正也不是什么需要隐瞒的事，我便坦率地点了点头。",
        "text_idx": [
            2102
        ]
    },
    {
        "name": "ことの",
        "name_idx": 2122,
        "ori": "「ふふ、やっぱり」",
        "message": "「呵呵，果然」",
        "text_idx": [
            2131
        ]
    },
    {
        "name": "亮",
        "name_idx": 2137,
        "ori": "「よくわかったな」",
        "message": "「这你都看得出来啊」",
        "text_idx": [
            2146
        ]
    },
    {
        "name": "ことの",
        "name_idx": 2264,
        "ori": "「そりゃわかるよー」",
        "message": "「那当然看得出来啦—」",
        "text_idx": [
            2273
        ]
    },
    {
        "ori": "横を歩いていたことのは、少し足を速めて俺の前を歩く。",
        "message": "走在我身旁的琴乃，稍微加快了脚步，走到了我的面前。",
        "text_idx": [
            2532
        ]
    },
    {
        "ori": "そして、振り返って二コリと笑ってきた。",
        "message": "然后，她回过头来，对我嫣然一笑。",
        "text_idx": [
            2659
        ]
    },
    {
        "name": "ことの",
        "name_idx": 2777,
        "ori": "「だって、昔から見てるもん」",
        "message": "「因为，我从以前就一直在看着你嘛」",
        "text_idx": [
            2786
        ]
    },
    {
        "name": "亮",
        "name_idx": 2792,
        "ori": "「そうだな……」",
        "message": "「是啊……」",
        "text_idx": [
            2801
        ]
    },
    {
        "name": "ことの",
        "name_idx": 2919,
        "ori": "「亮ちゃん、おめでとう」",
        "message": "「小亮，恭喜你」",
        "text_idx": [
            2928
        ]
    },
    {
        "name": "亮",
        "name_idx": 2934,
        "ori": "「ありがとう」",
        "message": "「谢谢你」",
        "text_idx": [
            2943
        ]
    },
    {
        "name": "ことの",
        "name_idx": 2963,
        "ori": "「でも、ちょっとだけさびしいかな」",
        "message": "「不过，还是会有点寂寞呢」",
        "text_idx": [
            2972
        ]
    },
    {
        "name": "亮",
        "name_idx": 2978,
        "ori": "「俺は変わらないよ。いつも通りだ」",
        "message": "「我不会变的。和往常一样」",
        "text_idx": [
            2987
        ]
    },
    {
        "name": "ことの",
        "name_idx": 3105,
        "ori": "「そう、だね」",
        "message": "「嗯，是呢」",
        "text_idx": [
            3114
        ]
    },
    {
        "ori": "ことのは少しだけ複雑そうな表情をする。",
        "message": "琴乃露出了有些复杂的表情。",
        "text_idx": [
            3129
        ]
    },
    {
        "name": "ことの",
        "name_idx": 3194,
        "ori": "「それでも、いつか変わっちゃうんだろうね」",
        "message": "「不过，总有一天还是会变的吧」",
        "text_idx": [
            3203
        ]
    },
    {
        "name": "ことの",
        "name_idx": 3223,
        "ori": "「少しずつ少しずつ……」",
        "message": "「一点一点地……」",
        "text_idx": [
            3232
        ]
    },
    {
        "name": "亮",
        "name_idx": 3238,
        "ori": "「……」",
        "message": "「……」",
        "text_idx": [
            3247
        ]
    },
    {
        "name": "ことの",
        "name_idx": 3267,
        "ori": "「亮ちゃん、人の絵が描けるようになったし」",
        "message": "「小亮也已经会画人物了」",
        "text_idx": [
            3276
        ]
    },
    {
        "name": "ことの",
        "name_idx": 3296,
        "ori": "「いつか……」",
        "message": "「总有一天……」",
        "text_idx": [
            3305
        ]
    },
    {
        "ori": "寂しげな顔をすることのは、頭を振って笑みを浮かべた。",
        "message": "露出寂寞表情的琴乃，摇了摇头，脸上浮现出笑容。",
        "text_idx": [
            3320
        ]
    },
    {
        "name": "ことの",
        "name_idx": 3472,
        "ori": "「ごめん、変なこと言っちゃったね」",
        "message": "「抱歉，我说了些奇怪的话呢」",
        "text_idx": [
            3481
        ]
    },
    {
        "name": "亮",
        "name_idx": 3487,
        "ori": "「いや、ことのの言う通りだよ」",
        "message": "「不，琴乃你说得没错」",
        "text_idx": [
            3496
        ]
    },
    {
        "ori": "俺もことのも蘭も此ノ花さんも学校のみんなも……",
        "message": "我、琴乃、兰、此之花同学，还有学校里的大家……",
        "text_idx": [
            3511
        ]
    },
    {
        "name": "亮",
        "name_idx": 3517,
        "ori": "「変わっていくんだろうな」",
        "message": "「都会渐渐改变的吧」",
        "text_idx": [
            3526
        ]
    },
    {
        "ori": "それは喜ばしいことではあるけど……",
        "message": "这虽然是件值得高兴的事……",
        "text_idx": [
            3541
        ]
    },
    {
        "ori": "どこか……寂しくもあった。",
        "message": "但又……总觉得有些寂寞。",
        "text_idx": [
            3556
        ]
    },
    {
        "name": "ことの",
        "name_idx": 3644,
        "ori": "「亮ちゃんもう一度言うけど、おめでとう」",
        "message": "「小亮，我再说一次，恭喜你」",
        "text_idx": [
            3653
        ]
    },
    {
        "name": "亮",
        "name_idx": 3659,
        "ori": "「ありがとう」",
        "message": "「谢谢你」",
        "text_idx": [
            3668
        ]
    },
    {
        "name": "ことの",
        "name_idx": 3786,
        "ori": "「教室に行こ～」",
        "message": "「我们去教室吧～」",
        "text_idx": [
            3795
        ]
    },
    {
        "name": "亮",
        "name_idx": 3965,
        "ori": "「ああ」",
        "message": "「嗯」",
        "text_idx": [
            3974
        ]
    },
    {
        "name": "蘭",
        "name_idx": 4397,
        "ori": "「あ……」",
        "message": "「啊……」",
        "text_idx": [
            4406
        ]
    },
    {
        "ori": "教室に入ると目が合って、蘭は恥ずかしそうに俯いた。",
        "message": "一进教室，我和兰就对上了视线，她害羞地低下了头。",
        "text_idx": [
            4435
        ]
    },
    {
        "ori": "その反応が昨夜のことが夢や幻ではないということを教えてくれる。",
        "message": "她的这个反应告诉我，昨天晚上的事并不是梦境或幻觉。",
        "text_idx": [
            4450,
            4451
        ]
    },
    {
        "ori": "その現実感からか、こちらも恥ずかしくなって顔が熱くなるのが分かった。",
        "message": "或许是这股现实感，我也害羞起来，能感觉到自己的脸在发烫。",
        "text_idx": [
            4466,
            4467
        ]
    },
    {
        "name": "亮",
        "name_idx": 4517,
        "ori": "「お、おはよう」",
        "message": "「早、早上好」",
        "text_idx": [
            4526
        ]
    },
    {
        "name": "蘭",
        "name_idx": 4546,
        "ori": "「う、うん。おはよう」",
        "message": "「啊、嗯。早上好」",
        "text_idx": [
            4555
        ]
    },
    {
        "name": "亮",
        "name_idx": 4561,
        "ori": "「無事に帰れたようで良かったよ」",
        "message": "「看你平安到家了，我就放心了」",
        "text_idx": [
            4570
        ]
    },
    {
        "name": "蘭",
        "name_idx": 4590,
        "ori": "「うん……」",
        "message": "「嗯……」",
        "text_idx": [
            4599
        ]
    },
    {
        "ori": "もじもじしている蘭との間に流れる空気は、温かくて甘く感じる。",
        "message": "我和坐立不安的兰之间弥漫的空气，感觉又温暖又甜蜜。",
        "text_idx": [
            4682,
            4683
        ]
    },
    {
        "ori": "この空気が心地よく、むずがゆくて、その感覚を楽しんでいる時だった。",
        "message": "这股气氛让我感觉很舒服，又有些心痒难耐，正当我享受着这种感觉的时候。",
        "text_idx": [
            4698,
            4699
        ]
    },
    {
        "name": "智継",
        "name_idx": 4952,
        "ori": "「うぉおお！」",
        "message": "「喔喔喔！」",
        "text_idx": [
            4961
        ]
    },
    {
        "name": "亮",
        "name_idx": 5093,
        "ori": "「…………」",
        "message": "「…………」",
        "text_idx": [
            5102
        ]
    },
    {
        "ori": "空気が霧散した気がした。",
        "message": "我感觉这股气氛烟消云散了。",
        "text_idx": [
            5117
        ]
    },
    {
        "name": "智継",
        "name_idx": 5205,
        "ori": "「なんだ、この甘ったるい空気は！　どこから流れてやがる！」",
        "message": "「这甜得发腻的空气是怎么回事！　是从哪里飘过来的！」",
        "text_idx": [
            5214,
            5215
        ]
    },
    {
        "ori": "登校してきて早々、智継がキョロキョロ見渡して、こちらにガンくれてきた。",
        "message": "刚到学校，智继就东张西望，然后狠狠地瞪向了我们这边。",
        "text_idx": [
            5274,
            5275
        ]
    },
    {
        "name": "智継",
        "name_idx": 5349,
        "ori": "「お前らか！」",
        "message": "「原来是你们两个啊！」",
        "text_idx": [
            5358
        ]
    },
    {
        "name": "亮",
        "name_idx": 5496,
        "ori": "「なんだよ？」",
        "message": "「干嘛？」",
        "text_idx": [
            5505
        ]
    },
    {
        "name": "智継",
        "name_idx": 5686,
        "ori": "「朝から、のろけやがって！　全国の男に謝れ！　特に俺には入念に謝れ！」",
        "message": "「一大早就秀恩爱！　给全国的男人道歉！　特别是要给我郑重地道歉！」",
        "text_idx": [
            5695,
            5696
        ]
    },
    {
        "ori": "ガシガシと歩み寄って来る智継は鼻息が荒かった。",
        "message": "大步向我们走来的智继鼻息很重。",
        "text_idx": [
            6018
        ]
    },
    {
        "name": "蘭",
        "name_idx": 6082,
        "ori": "「椎名君、猪みたい」",
        "message": "「椎名君，好像野猪」",
        "text_idx": [
            6091
        ]
    },
    {
        "name": "智継",
        "name_idx": 6165,
        "ori": "「ああ、俺はどうせ猪だよ。可哀想な猪さ」",
        "message": "「啊啊，反正我就是头野猪。一头可怜的野猪」",
        "text_idx": [
            6174
        ]
    },
    {
        "name": "亮",
        "name_idx": 6224,
        "ori": "「朝から元気だなぁ」",
        "message": "「你一大早就这么有精神啊」",
        "text_idx": [
            6233
        ]
    },
    {
        "name": "智継",
        "name_idx": 6307,
        "ori": "「お前ら、可哀想な猪をバカにするなよ！　必殺技持ってるんだからな！」",
        "message": "「你们两个，别小看可怜的野猪啊！　我可是有必杀技的！」",
        "text_idx": [
            6316,
            6317
        ]
    },
    {
        "name": "蘭",
        "name_idx": 6381,
        "ori": "「必殺技？」",
        "message": "「必杀技？」",
        "text_idx": [
            6390
        ]
    },
    {
        "name": "智継",
        "name_idx": 6508,
        "ori": "「そう、『卑猥なこと言いまくって空気ブレイク』という必殺技だ」",
        "message": "「对，我的必杀技就叫『狂说下流话破坏气氛』」",
        "text_idx": [
            6517,
            6518
        ]
    },
    {
        "name": "智継",
        "name_idx": 6582,
        "ori": "「これで、この甘ったるい空気をぶち壊してやる……」",
        "message": "「就用这招，把这甜得发腻的空气给彻底破坏掉……」",
        "text_idx": [
            6591
        ]
    },
    {
        "name": "亮",
        "name_idx": 6597,
        "ori": "「内容に負けないぐらい、ネーミングセンスも最悪だな」",
        "message": "「这起名品味和内容本身一样糟糕啊」",
        "text_idx": [
            6606
        ]
    },
    {
        "name": "智継",
        "name_idx": 6680,
        "ori": "「ふふふ……」",
        "message": "「呵呵呵……」",
        "text_idx": [
            6689
        ]
    },
    {
        "ori": "不気味な笑いを洩らしだした智継は、息を大きく吸い込んだ。",
        "message": "智继发出诡异的笑声，然后深吸了一口气。",
        "text_idx": [
            6748,
            6749
        ]
    },
    {
        "name": "智継",
        "name_idx": 6911,
        "ori": "「いいかお前ら、よく聞け！　俺は昨日――」",
        "message": "「听好了你们，都给我听仔细了！　我昨天——」",
        "text_idx": [
            6920
        ]
    },
    {
        "name": "智継",
        "name_idx": 7421,
        "ori": "「ぐふッ……」",
        "message": "「唔呃……」",
        "text_idx": [
            7430
        ]
    },
    {
        "ori": "いつ来たのか、此ノ花さんの手刀が智継の後ろ首を襲う。",
        "message": "不知何时出现的此之花同学，一记手刀劈在了智继的后颈上。",
        "text_idx": [
            7445
        ]
    },
    {
        "name": "円",
        "name_idx": 7465,
        "ori": "「コラ」",
        "message": "「不许！」",
        "text_idx": [
            7474
        ]
    },
    {
        "name": "智継",
        "name_idx": 7571,
        "ori": "「…………」",
        "message": "「…………」",
        "text_idx": [
            7580
        ]
    },
    {
        "ori": "膝を突いた智継は、無言で倒れた。",
        "message": "跪倒在地的智继，一言不发地倒下了。",
        "text_idx": [
            7609
        ]
    },
    {
        "name": "円",
        "name_idx": 7673,
        "ori": "「二人の恋路を邪魔する者は、わっちが許さないでありんす」",
        "message": "「妨碍这二人恋情的人，奴家可不会原谅哦」",
        "text_idx": [
            7682,
            7683
        ]
    },
    {
        "name": "円",
        "name_idx": 7824,
        "ori": "「おはよう、二人とも」",
        "message": "「早上好，你们两个」",
        "text_idx": [
            7833
        ]
    },
    {
        "name": "蘭",
        "name_idx": 7853,
        "ori": "「お、おはよう、円」",
        "message": "「早、早上好，圆」",
        "text_idx": [
            7862
        ]
    },
    {
        "name": "亮",
        "name_idx": 7868,
        "ori": "「おはよう……」",
        "message": "「早上好……」",
        "text_idx": [
            7877
        ]
    },
    {
        "ori": "少し気まずさを感じるものの、此ノ花さんはいつも通りの此ノ花さんだった。",
        "message": "虽然我感觉有些尴尬，但此之花同学还是一如既往。",
        "text_idx": [
            7892,
            7893
        ]
    },
    {
        "name": "円",
        "name_idx": 7957,
        "ori": "「邪魔する奴は片付けたから安心して」",
        "message": "「碍事的家伙我已经处理掉了，你们放心吧」",
        "text_idx": [
            7966
        ]
    },
    {
        "name": "亮",
        "name_idx": 7972,
        "ori": "「凄い音がしたけど……」",
        "message": "「可是刚才的声音好响……」",
        "text_idx": [
            7981
        ]
    },
    {
        "name": "蘭",
        "name_idx": 8001,
        "ori": "「椎名君、大丈夫かな」",
        "message": "「椎名同学，不要紧吧？」",
        "text_idx": [
            8010
        ]
    },
    {
        "name": "円",
        "name_idx": 8074,
        "ori": "「つば付けとけば直るよ。たぶん」",
        "message": "「涂点口水就能好哦。大概吧」",
        "text_idx": [
            8083
        ]
    },
    {
        "ori": "倒れた智継はまるで屍のようだった。",
        "message": "倒下的智继简直就像一具尸体。",
        "text_idx": [
            8098
        ]
    },
    {
        "ori": "大丈夫か？",
        "message": "他没事吧？",
        "text_idx": [
            8113
        ]
    },
    {
        "name": "円",
        "name_idx": 8177,
        "ori": "「それより、二人とも一気に仲良くなったね」",
        "message": "「比起那个，你们两个一下子就变得这么要好了呢」",
        "text_idx": [
            8186
        ]
    },
    {
        "name": "亮",
        "name_idx": 8192,
        "ori": "「そう？」",
        "message": "「是吗？」",
        "text_idx": [
            8201
        ]
    },
    {
        "name": "蘭",
        "name_idx": 8221,
        "ori": "「そ、そうかな？」",
        "message": "「是、是吗？」",
        "text_idx": [
            8230
        ]
    },
    {
        "name": "円",
        "name_idx": 8294,
        "ori": "「何かあったのかい？」",
        "message": "「发生什么事了吗？」",
        "text_idx": [
            8303
        ]
    },
    {
        "ori": "下世話な笑みを浮かべる此ノ花さんに、少しドキリする。",
        "message": "此之花同学脸上露出八卦的笑容，让我心里一惊。",
        "text_idx": [
            8318
        ]
    },
    {
        "name": "円",
        "name_idx": 8382,
        "ori": "「まあ、何はともあれ、二人が仲良くしてくれると、ボクは嬉しいよ」",
        "message": "「嘛，不管怎样，你们俩能好好相处，我就很高兴了」",
        "text_idx": [
            8391,
            8392
        ]
    },
    {
        "ori": "笑う此ノ花さんの顔に少しだけ切なさが垣間見えた。",
        "message": "从此之花同学的笑容中，我瞥见了一丝伤感。",
        "text_idx": [
            8407
        ]
    },
    {
        "ori": "それは俺だけじゃなくて、蘭も気付いたと思う。",
        "message": "我想不光是我，兰应该也注意到了。",
        "text_idx": [
            8422
        ]
    },
    {
        "ori": "なんて言えばいいのか。",
        "message": "我该说什么好呢。",
        "text_idx": [
            8437
        ]
    },
    {
        "ori": "思考をめぐらしていると蘭が何かに気づいたように声を上げた。",
        "message": "我正思索着，兰好像注意到了什么，叫出声来。",
        "text_idx": [
            8452,
            8453
        ]
    },
    {
        "name": "蘭",
        "name_idx": 8473,
        "ori": "「あ……椎名君の口から泡が出てる」",
        "message": "「啊……椎名同学口吐白沫了」",
        "text_idx": [
            8482
        ]
    },
    {
        "ori": "倒れた智継の口からカニのように白い泡がぷくぷくと出ていた。",
        "message": "倒下的智继嘴里像螃蟹一样咕嘟咕嘟地冒着白沫。",
        "text_idx": [
            8497,
            8498
        ]
    },
    {
        "name": "亮",
        "name_idx": 8504,
        "ori": "「ホントだ……」",
        "message": "「真的耶……」",
        "text_idx": [
            8513
        ]
    },
    {
        "ori": "不謹慎かもしれないけど、ホッとしてしまう。",
        "message": "虽然可能有些不厚道，但我还是松了口气。",
        "text_idx": [
            8528
        ]
    },
    {
        "ori": "泡を吹く智継のお陰で言葉を考えずに済んだ。",
        "message": "多亏了口吐白沫的智继，我不用再思考该说什么了。",
        "text_idx": [
            8543
        ]
    },
    {
        "ori": "しかし……これ大丈夫だよな？",
        "message": "不过……他这样没事吧？",
        "text_idx": [
            8558
        ]
    },
    {
        "name": "円",
        "name_idx": 8622,
        "ori": "「間違って秘孔を突いちゃったかな？」",
        "message": "「难道我不小心点到他的死穴了？」",
        "text_idx": [
            8631
        ]
    },
    {
        "name": "亮",
        "name_idx": 8637,
        "ori": "「おそろしい間違いだな」",
        "message": "「这可真是个可怕的失误啊」",
        "text_idx": [
            8646
        ]
    },
    {
        "name": "円",
        "name_idx": 8710,
        "ori": "「ちょっと保健室につれていくよ」",
        "message": "「我带他去一趟保健室」",
        "text_idx": [
            8719
        ]
    },
    {
        "ori": "仕方ないといった表情で、智継を引きずっていく此ノ花さん。",
        "message": "此之花同学露出无可奈何的表情，拖着智继走了。",
        "text_idx": [
            9256,
            9257
        ]
    },
    {
        "name": "円",
        "name_idx": 9472,
        "ori": "「ああ、そうそう」",
        "message": "「啊，对了对了」",
        "text_idx": [
            9481
        ]
    },
    {
        "ori": "何か思い出したように振り返る。",
        "message": "她像是想起了什么似的，回过头来。",
        "text_idx": [
            9496
        ]
    },
    {
        "name": "円",
        "name_idx": 9516,
        "ori": "「昼休み、話したい事があるから屋上に来てくれるかな」",
        "message": "「午休我有话想说，可以来一趟天台吗」",
        "text_idx": [
            9525
        ]
    },
    {
        "name": "亮",
        "name_idx": 9531,
        "ori": "「俺？」",
        "message": "「我？」",
        "text_idx": [
            9540
        ]
    },
    {
        "name": "円",
        "name_idx": 9560,
        "ori": "「うん」",
        "message": "「嗯」",
        "text_idx": [
            9569
        ]
    },
    {
        "ori": "智継を引きずっているが、此ノ花さんの顔は真面目だった。",
        "message": "虽然正拖着智继，但此之花同学的表情十分认真。",
        "text_idx": [
            9584,
            9585
        ]
    },
    {
        "name": "蘭",
        "name_idx": 9605,
        "ori": "「……」",
        "message": "「……」",
        "text_idx": [
            9614
        ]
    },
    {
        "name": "亮",
        "name_idx": 9620,
        "ori": "「わかった」",
        "message": "「我知道了」",
        "text_idx": [
            9629
        ]
    },
    {
        "name": "円",
        "name_idx": 9649,
        "ori": "「それじゃ」",
        "message": "「那就这样」",
        "text_idx": [
            9658
        ]
    },
    {
        "ori": "ずるずると智継を引きずって、此ノ花さんは教室を出ていく。",
        "message": "此之花同学拖着智继，稀里哗啦地走出了教室。",
        "text_idx": [
            9761,
            9762
        ]
    },
    {
        "name": "蘭",
        "name_idx": 9843,
        "ori": "「……」",
        "message": "「……」",
        "text_idx": [
            9852
        ]
    },
    {
        "ori": "蘭は少し浮かない顔をしていた。",
        "message": "兰的脸上露出了有些不开心的表情。",
        "text_idx": [
            9867
        ]
    },
    {
        "ori": "その蘭の頭に手をぽんと置く。",
        "message": "我将手轻轻放在兰的头上。",
        "text_idx": [
            9882
        ]
    },
    {
        "name": "亮",
        "name_idx": 9888,
        "ori": "「智継の心配をしてあげてるの？」",
        "message": "「你在担心智继吗？」",
        "text_idx": [
            9897
        ]
    },
    {
        "name": "蘭",
        "name_idx": 10005,
        "ori": "「それもあるけど、円が……」",
        "message": "「那也是一方面，但圆她……」",
        "text_idx": [
            10014
        ]
    },
    {
        "name": "亮",
        "name_idx": 10020,
        "ori": "「そうだね」",
        "message": "「是啊」",
        "text_idx": [
            10029
        ]
    },
    {
        "ori": "此ノ花さんはなんだか、無理して元気を見せている。",
        "message": "我总觉得此之花同学是在强颜欢笑。",
        "text_idx": [
            10044
        ]
    },
    {
        "ori": "さっきの切なそうな笑顔……",
        "message": "刚才那看起来很伤感的笑容……",
        "text_idx": [
            10059
        ]
    },
    {
        "name": "蘭",
        "name_idx": 10123,
        "ori": "「亮、昼休み大丈夫？」",
        "message": "「亮，午休时没问题吧？」",
        "text_idx": [
            10132
        ]
    },
    {
        "name": "亮",
        "name_idx": 10138,
        "ori": "「うん……」",
        "message": "「嗯……」",
        "text_idx": [
            10147
        ]
    },
    {
        "ori": "昼休みどんな話をされるのだろうか。",
        "message": "午休时她会和我说些什么呢。",
        "text_idx": [
            10162
        ]
    },
    {
        "ori": "考えると少し緊張するが、此ノ花さんと話せる良いチャンスだと思った。",
        "message": "一想到这个我就有些紧张，但我也觉得这是个和此之花同学说话的好机会。",
        "text_idx": [
            10177,
            10178
        ]
    },
    {
        "ori": "昨日は結局、此ノ花さんの悩みを聞き出すことができなかったから。",
        "message": "因为昨天我终究还是没能问出此之花同学的烦恼。",
        "text_idx": [
            10193,
            10194
        ]
    },
    {
        "ori": "俺の事ではない、もう一つの悩み。",
        "message": "不是关于我的那个烦恼，而是另一个。",
        "text_idx": [
            10209
        ]
    },
    {
        "ori": "此ノ花さんは、俺と別れることが唯一の悩みだと言っていたけど……違う。",
        "message": "此之花同学说过，她唯一的烦恼就是和我分手……但不是的。",
        "text_idx": [
            10224,
            10225
        ]
    },
    {
        "ori": "違うと思う。なんとなくだけど。",
        "message": "我觉得不对。虽然只是种感觉。",
        "text_idx": [
            10240
        ]
    },
    {
        "ori": "今度こそ聞き出したい。",
        "message": "这次我一定要问出来。",
        "text_idx": [
            10255
        ]
    },
    {
        "name": "亮",
        "name_idx": 10261,
        "ori": "「俺、頑張るよ」",
        "message": "「我会加油的」",
        "text_idx": [
            10270
        ]
    },
    {
        "ori": "力になれるか分からないけど、このまま何も分からず別れるのは嫌だった。",
        "message": "我不知道自己能不能帮上忙，但我不想就这样什么都不知道地和她分手。",
        "text_idx": [
            10285,
            10286
        ]
    },
    {
        "name": "蘭",
        "name_idx": 10364,
        "ori": "「うん……」",
        "message": "「嗯……」",
        "text_idx": [
            10373
        ]
    },
    {
        "ori": "蘭は、何か考えるような顔で頷いていた。",
        "message": "兰露出一副若有所思的表情，点了点头。",
        "text_idx": [
            10388
        ]
    },
    {
        "ori": "少しして、智継を保健室に連れていった此ノ花さんが教室に帰ってくるが、それからは一言も喋る事はなかった。",
        "message": "过了一会儿，带智继去保健室的此之花同学回到了教室，但她之后就再也没说过一句话。",
        "text_idx": [
            10424,
            10425
        ]
    },
    {
        "ori": "ちなみに、智継もすぐに復活して帰ってきたが、朝の事を思い出せないらしく、",
        "message": "顺带一提，智继也很快就恢复过来并回了教室，但他好像想不起来早上的事了，",
        "text_idx": [
            10440,
            10441
        ]
    },
    {
        "name": "智継",
        "name_idx": 10461,
        "ori": "「俺が可哀想な猪だったことは覚えているんだ……」",
        "message": "「我还记得自己是那头可怜的野猪……」",
        "text_idx": [
            10470
        ]
    },
    {
        "ori": "ずっと頭を傾げていた。",
        "message": "他一直歪着头。",
        "text_idx": [
            10485
        ]
    },
    {
        "ori": "昼休みがやってくる。",
        "message": "午休时间到了。",
        "text_idx": [
            10692
        ]
    },
    {
        "ori": "少し緊張しながら此ノ花さんの姿を探すが、もうすでに教室には居なかった。",
        "message": "我有些紧张地寻找着此之花同学的身影，但她已经不在教室里了。",
        "text_idx": [
            10707,
            10708
        ]
    },
    {
        "name": "蘭",
        "name_idx": 10772,
        "ori": "「亮」",
        "message": "「亮」",
        "text_idx": [
            10781
        ]
    },
    {
        "name": "亮",
        "name_idx": 10787,
        "ori": "「行ってくるよ」",
        "message": "「我去了」",
        "text_idx": [
            10796
        ]
    },
    {
        "name": "蘭",
        "name_idx": 10816,
        "ori": "「うん……」",
        "message": "「嗯……」",
        "text_idx": [
            10825
        ]
    },
    {
        "name": "蘭",
        "name_idx": 10889,
        "ori": "「あの、亮……」",
        "message": "「那个，亮……」",
        "text_idx": [
            10898
        ]
    },
    {
        "name": "亮",
        "name_idx": 10904,
        "ori": "「なに？」",
        "message": "「什么？」",
        "text_idx": [
            10913
        ]
    },
    {
        "name": "蘭",
        "name_idx": 10977,
        "ori": "「ボクも行っていいかな？」",
        "message": "「我也可以一起去吗？」",
        "text_idx": [
            10986
        ]
    },
    {
        "name": "亮",
        "name_idx": 10992,
        "ori": "「蘭も？」",
        "message": "「兰也想去？」",
        "text_idx": [
            11001
        ]
    },
    {
        "ori": "蘭の雰囲気は昨日とは少し違っていた。",
        "message": "兰的气质和昨天有些不一样。",
        "text_idx": [
            11016
        ]
    },
    {
        "ori": "なんというか……真っ直ぐで真剣で、何か一つに集中できているような。",
        "message": "怎么说呢……感觉她很坦率、很认真，像是在专注于某件事情一样。",
        "text_idx": [
            11031,
            11032
        ]
    },
    {
        "ori": "迷う。",
        "message": "我很犹豫。",
        "text_idx": [
            11047
        ]
    },
    {
        "ori": "蘭も交えて此ノ花さんと話せればいいと思うが……",
        "message": "我觉得如果兰也能一起和此之花同学谈谈就好了，但是……",
        "text_idx": [
            11062
        ]
    },
    {
        "name": "亮",
        "name_idx": 11068,
        "ori": "「呼ばれたの俺だけだからな……」",
        "message": "「可她只叫了我一个人啊……」",
        "text_idx": [
            11077
        ]
    },
    {
        "ori": "連れて行っていいのかどうなのか。",
        "message": "到底该不该带她去呢。",
        "text_idx": [
            11092
        ]
    },
    {
        "ori": "此ノ花さんが怒って何も話してくれない場合を考えて、さらに迷っていると、蘭は首を振った。",
        "message": "我考虑到此之花同学可能会生气，什么都不肯说，正当我更加犹豫的时候，兰摇了摇头。",
        "text_idx": [
            11107,
            11108
        ]
    },
    {
        "name": "蘭",
        "name_idx": 11172,
        "ori": "「ごめん。ボクは教室で待ってるよ」",
        "message": "「抱歉。我就在教室里等你吧」",
        "text_idx": [
            11181
        ]
    },
    {
        "name": "亮",
        "name_idx": 11187,
        "ori": "「いいのか？」",
        "message": "「这样好吗？」",
        "text_idx": [
            11196
        ]
    },
    {
        "name": "蘭",
        "name_idx": 11216,
        "ori": "「うん。後で聞かせてね」",
        "message": "「嗯。之后要告诉我哦」",
        "text_idx": [
            11225
        ]
    },
    {
        "name": "亮",
        "name_idx": 11231,
        "ori": "「う、うん……じゃあ」",
        "message": "「嗯、嗯……那我去了」",
        "text_idx": [
            11240
        ]
    },
    {
        "name": "蘭",
        "name_idx": 11260,
        "ori": "「いってらっしゃい。円に負けちゃダメだよ！」",
        "message": "「路上小心。可不能输给圆哦！」",
        "text_idx": [
            11269
        ]
    },
    {
        "name": "亮",
        "name_idx": 11275,
        "ori": "「お、おう！」",
        "message": "「哦、好！」",
        "text_idx": [
            11284
        ]
    },
    {
        "ori": "蘭に元気をもらって、此ノ花さんの居る屋上へ向かった。",
        "message": "我从兰那里获得了勇气，向此之花同学所在的天台走去。",
        "text_idx": [
            11344
        ]
    },
    {
        "ori": "ドアを開け、屋上に出ると冷たい空気が吹き込んだ。",
        "message": "我打开门，一走到天台上，冰冷的空气便扑面而来。",
        "text_idx": [
            11479
        ]
    },
    {
        "ori": "晴れ渡った空を見上げてから、此ノ花さんの姿を探した。",
        "message": "我抬头望了望万里无云的天空，然后开始寻找此之花同学的身影。",
        "text_idx": [
            11678
        ]
    },
    {
        "ori": "此ノ花さんは、遠くの景色を眺めていた。",
        "message": "此之花同学正在眺望着远方的景色。",
        "text_idx": [
            11849
        ]
    },
    {
        "name": "亮",
        "name_idx": 11855,
        "ori": "「此ノ花さん」",
        "message": "「此之花同学」",
        "text_idx": [
            11864
        ]
    },
    {
        "name": "円",
        "name_idx": 11884,
        "ori": "「……」",
        "message": "「……」",
        "text_idx": [
            11893
        ]
    },
    {
        "name": "亮",
        "name_idx": 11899,
        "ori": "「此ノ花さん……？」",
        "message": "「此之花同学……？」",
        "text_idx": [
            11908
        ]
    },
    {
        "ori": "此ノ花さんは、こちらに視線を向けずに、ずっと遠くを見つめていた。",
        "message": "此之花同学没有看我，而是一直凝视着远方。",
        "text_idx": [
            11923,
            11924
        ]
    },
    {
        "name": "円",
        "name_idx": 11944,
        "ori": "「蘭、とても幸せそうな顔をしてるんだ」",
        "message": "「兰她，露出了非常幸福的表情呢」",
        "text_idx": [
            11953
        ]
    },
    {
        "ori": "景色を眺めたまま。",
        "message": "她一边眺望着景色，一边说道。",
        "text_idx": [
            11968
        ]
    },
    {
        "ori": "その横顔からはどんな表情なのか読み取れなかった。",
        "message": "我从她的侧脸上无法读出任何表情。",
        "text_idx": [
            11983
        ]
    },
    {
        "name": "円",
        "name_idx": 12003,
        "ori": "「蘭が朝、寮に帰って来ているのを見たんだけど、あれって小松原くんの家に泊まったのかな？」",
        "message": "「我早上看到兰回到宿舍了，她是在小松原同学家过夜了吗？」",
        "text_idx": [
            12012,
            12013
        ]
    },
    {
        "name": "亮",
        "name_idx": 12019,
        "ori": "「うん……」",
        "message": "「嗯……」",
        "text_idx": [
            12028
        ]
    },
    {
        "name": "円",
        "name_idx": 12092,
        "ori": "「小松原くんは、蘭のこと本気なの？」",
        "message": "「小松原同学，你对兰是真心的吗？」",
        "text_idx": [
            12101
        ]
    },
    {
        "ori": "ようやく振り向いてくる円の目は怖かった。",
        "message": "圆终于转过头来，她的眼神很可怕。",
        "text_idx": [
            12116
        ]
    },
    {
        "name": "亮",
        "name_idx": 12122,
        "ori": "「本気だよ」",
        "message": "「是真心的」",
        "text_idx": [
            12131
        ]
    },
    {
        "name": "円",
        "name_idx": 12151,
        "ori": "「本当に？」",
        "message": "「真的？」",
        "text_idx": [
            12160
        ]
    },
    {
        "name": "亮",
        "name_idx": 12166,
        "ori": "「本気だよ」",
        "message": "「是真心的」",
        "text_idx": [
            12175
        ]
    },
    {
        "name": "円",
        "name_idx": 12195,
        "ori": "「本当の本当に？」",
        "message": "「千真万确？」",
        "text_idx": [
            12204
        ]
    },
    {
        "name": "亮",
        "name_idx": 12210,
        "ori": "「本気の本気」",
        "message": "「千真万确」",
        "text_idx": [
            12219
        ]
    },
    {
        "ori": "強く言う俺に、此ノ花さんの目元が緩む。",
        "message": "听我斩钉截铁地回答后，此之花同学的眼神柔和了下来。",
        "text_idx": [
            12278
        ]
    },
    {
        "ori": "そして笑顔を見せた。",
        "message": "接着，她露出了笑容。",
        "text_idx": [
            12337
        ]
    },
    {
        "name": "円",
        "name_idx": 12357,
        "ori": "「それならいいんだ」",
        "message": "「那就好」",
        "text_idx": [
            12366
        ]
    },
    {
        "ori": "でもその笑顔は少し寂しげで、悲しげだった。",
        "message": "但她的笑容却有些寂寞，有些悲伤。",
        "text_idx": [
            12381
        ]
    },
    {
        "name": "円",
        "name_idx": 12445,
        "ori": "「蘭はボクにとって大切な存在だからさ、絶対に幸せになって欲しいんだよ」",
        "message": "「兰对我来说是非常重要的人，所以我绝对希望她能够幸福」",
        "text_idx": [
            12454,
            12455
        ]
    },
    {
        "name": "円",
        "name_idx": 12475,
        "ori": "「だから……蘭を幸せにしてあげて」",
        "message": "「所以……请你一定要让兰幸福」",
        "text_idx": [
            12484
        ]
    },
    {
        "ori": "大きく頷く。",
        "message": "我用力地点了点头。",
        "text_idx": [
            12499
        ]
    },
    {
        "name": "亮",
        "name_idx": 12505,
        "ori": "「約束するよ」",
        "message": "「我答应你」",
        "text_idx": [
            12514
        ]
    },
    {
        "name": "円",
        "name_idx": 12578,
        "ori": "「うん……」",
        "message": "「嗯……」",
        "text_idx": [
            12587
        ]
    },
    {
        "ori": "此ノ花さんは嬉しそうに笑うが、その笑顔に潜む影は一向に消えなかった。",
        "message": "此之花同学虽然开心地笑着，但她笑容里潜藏的阴影却丝毫没有消失。",
        "text_idx": [
            12602,
            12603
        ]
    },
    {
        "ori": "その笑顔を見ると、胸が痛んだ。",
        "message": "看到她那样的笑容，我的心隐隐作痛。",
        "text_idx": [
            12618
        ]
    },
    {
        "name": "亮",
        "name_idx": 12624,
        "ori": "「此ノ花さん……どうしてそんなに悲しそうな顔をするの？」",
        "message": "「此之花同学……你为什么露出那么悲伤的表情？」",
        "text_idx": [
            12633,
            12634
        ]
    },
    {
        "name": "円",
        "name_idx": 12698,
        "ori": "「え、ボク、そんな顔してる？」",
        "message": "「欸，我有露出那种表情吗？」",
        "text_idx": [
            12707
        ]
    },
    {
        "ori": "おどけたように言って、顔を揉む此ノ花さん。",
        "message": "此之花同学开玩笑似的说着，揉了揉自己的脸。",
        "text_idx": [
            12722
        ]
    },
    {
        "name": "円",
        "name_idx": 12786,
        "ori": "「どう？　百万ドルの笑顔でしょ？」",
        "message": "「怎么样？　是百万美元的笑容吧？」",
        "text_idx": [
            12795
        ]
    },
    {
        "ori": "此ノ花さんはさっきよりも笑みを強めて見せてくるが、それが張り付けた偽物の笑顔だというのは俺にもすぐに分かった。",
        "message": "虽然此之花同学向我展露了比刚才更灿烂的笑容，但我立刻就明白，那是个硬挤出来的假笑。",
        "text_idx": [
            12810,
            12811,
            12812
        ]
    },
    {
        "name": "亮",
        "name_idx": 12818,
        "ori": "「……寂しそうで悲しく見える」",
        "message": "「……看起来既寂寞又悲伤」",
        "text_idx": [
            12827
        ]
    },
    {
        "name": "円",
        "name_idx": 12891,
        "ori": "「まぁ……」",
        "message": "「这个嘛……」",
        "text_idx": [
            12900
        ]
    },
    {
        "ori": "風が此ノ花さんの髪をさらっていく。",
        "message": "风吹拂着此之花同学的头发。",
        "text_idx": [
            12915
        ]
    },
    {
        "name": "円",
        "name_idx": 12979,
        "ori": "「そりゃ、好きな人がボクじゃない人のことを幸せにするって約束してくれるんだもん」",
        "message": "「那当然啦，毕竟我喜欢的人答应了要让我以外的人幸福嘛。」",
        "text_idx": [
            12988,
            12989
        ]
    },
    {
        "name": "円",
        "name_idx": 13009,
        "ori": "「ちょっとだけ悔しいよ」",
        "message": "「是会有点不甘心啦」",
        "text_idx": [
            13018
        ]
    },
    {
        "ori": "そう言って此ノ花さんは満面の笑顔で笑ってくる。",
        "message": "此之花同学一边说着，一边对我露出了满面的笑容。",
        "text_idx": [
            13077
        ]
    },
    {
        "ori": "その笑顔に押されて、言葉が詰まった。",
        "message": "被她的笑容所折服，我一时语塞。",
        "text_idx": [
            13092
        ]
    },
    {
        "name": "円",
        "name_idx": 13157,
        "ori": "「でも、小松原くんの相手が蘭で良かったよ」",
        "message": "「不过，小松原同学的对象是兰，真是太好了」",
        "text_idx": [
            13166
        ]
    },
    {
        "ori": "此ノ花さんは青い空に吸い込まれるように大きく伸びをした。",
        "message": "此之花同学伸了个大大的懒腰，仿佛要被吸入那片蓝天之中。",
        "text_idx": [
            13181,
            13182
        ]
    },
    {
        "name": "円",
        "name_idx": 13202,
        "ori": "「もし小松原くんの相手が蘭じゃなかったら……」",
        "message": "「要是小松原同学的对象不是兰的话……」",
        "text_idx": [
            13211
        ]
    },
    {
        "name": "円",
        "name_idx": 13296,
        "ori": "「ボク、悔しくて押し倒してたかもよー」",
        "message": "「我啊，说不定会因为不甘心就把你给推倒了哦～」",
        "text_idx": [
            13305
        ]
    },
    {
        "name": "亮",
        "name_idx": 13311,
        "ori": "「此ノ花さん……」",
        "message": "「此之花小姐……」",
        "text_idx": [
            13320
        ]
    },
    {
        "ori": "此ノ花さんとこのままお別れしてもいいのだろうか。",
        "message": "就这样和此之花同学分别，真的好吗？",
        "text_idx": [
            13335
        ]
    },
    {
        "ori": "こんな悲しくて寂しい笑みを浮かべる此ノ花さんと。",
        "message": "和露出如此悲伤又寂寞笑容的此之花同学。",
        "text_idx": [
            13350
        ]
    },
    {
        "ori": "……いけない気がした。",
        "message": "……总觉得不行。",
        "text_idx": [
            13365
        ]
    },
    {
        "ori": "このまま此ノ花さんと繚乱に帰したら、一生後悔する気がした。",
        "message": "要是就这么让此之花同学回到缭乱，我感觉会后悔一辈子。",
        "text_idx": [
            13380,
            13381
        ]
    },
    {
        "name": "亮",
        "name_idx": 13387,
        "ori": "「もう一つを教えてくれないかな」",
        "message": "「能告诉我另一个吗？」",
        "text_idx": [
            13396
        ]
    },
    {
        "name": "円",
        "name_idx": 13460,
        "ori": "「え、なんの事？」",
        "message": "「诶，什么事？」",
        "text_idx": [
            13469
        ]
    },
    {
        "name": "亮",
        "name_idx": 13475,
        "ori": "「悩みだよ。俺の事じゃないもう一つの悩み」",
        "message": "「是烦恼啊。不是关于我的另一个烦恼」",
        "text_idx": [
            13484
        ]
    },
    {
        "name": "円",
        "name_idx": 13548,
        "ori": "「そんなのないよ」",
        "message": "「没有那种东西啦」",
        "text_idx": [
            13557
        ]
    },
    {
        "name": "亮",
        "name_idx": 13563,
        "ori": "「あるよ」",
        "message": "「有的」",
        "text_idx": [
            13572
        ]
    },
    {
        "name": "円",
        "name_idx": 13636,
        "ori": "「ないよ」",
        "message": "「没有啦」",
        "text_idx": [
            13645
        ]
    },
    {
        "name": "亮",
        "name_idx": 13651,
        "ori": "「あるよ」",
        "message": "「有的」",
        "text_idx": [
            13660
        ]
    },
    {
        "name": "円",
        "name_idx": 13724,
        "ori": "「ないよ」",
        "message": "「没有啦」",
        "text_idx": [
            13733
        ]
    },
    {
        "name": "亮",
        "name_idx": 13739,
        "ori": "「ないよ」",
        "message": "「没有啦」",
        "text_idx": [
            13748
        ]
    },
    {
        "name": "円",
        "name_idx": 13812,
        "ori": "「あるよ……って」",
        "message": "「有的……不对」",
        "text_idx": [
            13821
        ]
    },
    {
        "name": "亮",
        "name_idx": 13827,
        "ori": "「ほら、あるじゃん」",
        "message": "「你看，这不就有了吗」",
        "text_idx": [
            13836
        ]
    },
    {
        "name": "円",
        "name_idx": 13900,
        "ori": "「こんなの、引っ掛けじゃないか……」",
        "message": "「这不就是个圈套吗……」",
        "text_idx": [
            13909
        ]
    },
    {
        "name": "亮",
        "name_idx": 13915,
        "ori": "「まあ、冗談はさておき、此ノ花さん言ったよね。ボクはキミを写す鏡だって」",
        "message": "「嘛，玩笑先放一边，此之花同学你说过的吧。我是映照出你的镜子」",
        "text_idx": [
            13924,
            13925
        ]
    },
    {
        "name": "亮",
        "name_idx": 13931,
        "ori": "「ということは、逆に俺も此ノ花さんを写す鏡でもあるんだ」",
        "message": "「也就是说，反过来说我也是映照出此之花同学的镜子啊」",
        "text_idx": [
            13940,
            13941
        ]
    },
    {
        "ori": "つまり似た者同士。",
        "message": "也就是说我们是同类人。",
        "text_idx": [
            13956
        ]
    },
    {
        "ori": "だから……",
        "message": "所以……",
        "text_idx": [
            13971
        ]
    },
    {
        "name": "亮",
        "name_idx": 13977,
        "ori": "「俺、鈍感かもしれないけど、なんとなく分かる。此ノ花さん、別の事でも悩んでるって」",
        "message": "「我可能有些迟钝，但我隐约能感觉到。此之花同学，你还在为别的事情烦恼吧」",
        "text_idx": [
            13986,
            13987
        ]
    },
    {
        "name": "円",
        "name_idx": 14051,
        "ori": "「…………」",
        "message": "「…………」",
        "text_idx": [
            14060
        ]
    },
    {
        "name": "亮",
        "name_idx": 14066,
        "ori": "「俺の気持ちは変えられないし、俺に関する悩みはダメかもしれないけど」",
        "message": "「我的心意是不会改变的，所以如果是关于我的烦恼我可能也无能为力」",
        "text_idx": [
            14075,
            14076
        ]
    },
    {
        "name": "亮",
        "name_idx": 14082,
        "ori": "「もう一つの悩みを聞かせてくれないかな？」",
        "message": "「能和我说说你的另一个烦恼吗？」",
        "text_idx": [
            14091
        ]
    },
    {
        "name": "亮",
        "name_idx": 14097,
        "ori": "「俺じゃ解決できないかもしれない。でも、少しでも力になれたら……」",
        "message": "「或许我无法帮你解决。但是，如果能帮上一点忙也好……」",
        "text_idx": [
            14106,
            14107
        ]
    },
    {
        "name": "円",
        "name_idx": 14171,
        "ori": "「ホント、小松原くんは優しいよね」",
        "message": "「小松原同学，你真的很温柔呢」",
        "text_idx": [
            14180
        ]
    },
    {
        "ori": "此ノ花さんは偽物の笑みを消して、隠していた寂しさと悲しさを顔に出していた。",
        "message": "此之花同学收起了虚假的笑容，脸上露出了她一直隐藏的寂寞与悲伤。",
        "text_idx": [
            14195,
            14196
        ]
    },
    {
        "ori": "それでも、どこか強がるような顔をして遠くの景色に目を向けた。",
        "message": "即使如此，她还是做出一副故作坚强的表情，将目光投向了远方的景色。",
        "text_idx": [
            14323,
            14324
        ]
    },
    {
        "name": "円",
        "name_idx": 14344,
        "ori": "「ボクは大丈夫」",
        "message": "「我没事的」",
        "text_idx": [
            14353
        ]
    },
    {
        "name": "円",
        "name_idx": 14373,
        "ori": "「蘭が幸せになってくれれば、ボクはもう思い残すことはないから」",
        "message": "「只要兰能够幸福，我就再也没有什么遗憾了」",
        "text_idx": [
            14382,
            14383
        ]
    },
    {
        "name": "円",
        "name_idx": 14403,
        "ori": "「だから……ボクにこれ以上関わらないで」",
        "message": "「所以……请不要再和我扯上关系了」",
        "text_idx": [
            14412
        ]
    },
    {
        "name": "亮",
        "name_idx": 14418,
        "ori": "「……」",
        "message": "「……」",
        "text_idx": [
            14427
        ]
    },
    {
        "ori": "拒絶。",
        "message": "拒绝。",
        "text_idx": [
            14442
        ]
    },
    {
        "ori": "此ノ花さんとの距離が音を立てて開いていく。",
        "message": "我与此之花同学的距离，仿佛发出声响般被拉开了。",
        "text_idx": [
            14457
        ]
    },
    {
        "ori": "俺は必死に此ノ花さんに掛ける言葉を探した。",
        "message": "我拼命地思索着该对此时之花同学说些什么。",
        "text_idx": [
            14472
        ]
    },
    {
        "ori": "「みんなで幸せになれない？」",
        "message": "「大家能一起幸福吗？」",
        "text_idx": [
            14516
        ]
    },
    {
        "ori": "「それで円がいいなら……」",
