[
    {
        "ori": "呼び鈴に出ると、ドアの前にはみつばちゃんがいた。",
        "message": "我应了门铃，门前站着的是三叶酱。",
        "text_idx": [
            113
        ]
    },
    {
        "name": "亮",
        "name_idx": 119,
        "ori": "「みつばちゃん！？　どうしたの？」",
        "message": "「三叶酱！？　你怎么了？」",
        "text_idx": [
            128
        ]
    },
    {
        "name": "みつば",
        "name_idx": 148,
        "ori": "「あの……おねえちゃん、風邪だったみたいデス」",
        "message": "「那个……姐姐，好像感冒了的说」",
        "text_idx": [
            157
        ]
    },
    {
        "name": "亮",
        "name_idx": 163,
        "ori": "「それを知らせるためにわざわざ、寄ってくれたの？」",
        "message": "「你是特地过来告诉我这件事的吗？」",
        "text_idx": [
            172
        ]
    },
    {
        "name": "みつば",
        "name_idx": 236,
        "ori": "「……ハイ」",
        "message": "「……是」",
        "text_idx": [
            245
        ]
    },
    {
        "ori": "さつきが風邪をひいたことを伝えるだけなら、学園でも良かったはずだ。みつばちゃんがわざわざ寄ってくれたと言うことは……",
        "message": "如果只是为了告诉我纱月感冒了，在学校说也可以。三叶酱特地跑来一趟，也就是说……",
        "text_idx": [
            260,
            261,
            262
        ]
    },
    {
        "name": "亮",
        "name_idx": 268,
        "ori": "「わかった、俺、見舞いに行ってくる」",
        "message": "「我明白了，我去探望她一下」",
        "text_idx": [
            277
        ]
    },
    {
        "name": "みつば",
        "name_idx": 341,
        "ori": "「……みつば、どうしたらいいのかわからない」",
        "message": "「……三叶，不知道该怎么办才好」",
        "text_idx": [
            350
        ]
    },
    {
        "ori": "みつばちゃんの目から、涙がこぼれる。",
        "message": "泪水从三叶酱的眼眶中滑落。",
        "text_idx": [
            365
        ]
    },
    {
        "name": "亮",
        "name_idx": 371,
        "ori": "「みつばちゃん……！？」",
        "message": "「三叶酱……！？」",
        "text_idx": [
            380
        ]
    },
    {
        "name": "みつば",
        "name_idx": 444,
        "ori": "「みつばが、足手まといになっている気がする……」",
        "message": "「我感觉自己，好像成了累赘……」",
        "text_idx": [
            453
        ]
    },
    {
        "name": "亮",
        "name_idx": 459,
        "ori": "「そんな事無いさ……俺にはみつばちゃんが、さつきの力になっていることを知ってるよ」",
        "message": "「没这回事……我知道的，三叶酱是纱月的力量源泉啊」",
        "text_idx": [
            468,
            469
        ]
    },
    {
        "name": "みつば",
        "name_idx": 489,
        "ori": "「違うの、おにいちゃん……」",
        "message": "「不是的，大哥哥……」",
        "text_idx": [
            498
        ]
    },
    {
        "name": "亮",
        "name_idx": 504,
        "ori": "「えっ？　……何が違うの？」",
        "message": "「诶？　……有什么不对吗？」",
        "text_idx": [
            513
        ]
    },
    {
        "name": "みつば",
        "name_idx": 533,
        "ori": "「……みつばが、みつばが『選べない』って言っちゃったから、おねえちゃん……」",
        "message": "「……因为三叶，因为三叶说了『我没法选』所以，姐姐她……」",
        "text_idx": [
            542,
            543
        ]
    },
    {
        "name": "亮",
        "name_idx": 549,
        "ori": "「……何を選べないの」",
        "message": "「……没法选什么？」",
        "text_idx": [
            558
        ]
    },
    {
        "ori": "泣いて黙りこくる、みつばちゃん。そのか細い肩が、震えている。",
        "message": "三叶酱哭着陷入了沉默。她纤细的肩膀，颤抖着。",
        "text_idx": [
            573,
            574
        ]
    },
    {
        "name": "亮",
        "name_idx": 580,
        "ori": "「……大丈夫だよ、みつばちゃん。俺、おねえちゃんの見舞いに行ってくるよ。そして……話を聞いてくるから」",
        "message": "「……没事的，三叶酱。我会去探望你姐姐的。然后……我会去听听她怎么说的」",
        "text_idx": [
            589,
            590,
            591
        ]
    },
    {
        "name": "みつば",
        "name_idx": 655,
        "ori": "「……ありがとう……おにいちゃん」",
        "message": "「……谢谢你……大哥哥」",
        "text_idx": [
            664
        ]
    },
    {
        "name": "亮",
        "name_idx": 670,
        "ori": "「だから、心配しないで学園に行っておいで」",
        "message": "「所以，别担心了，快去学园吧」",
        "text_idx": [
            679
        ]
    },
    {
        "name": "みつば",
        "name_idx": 699,
        "ori": "「……うん」",
        "message": "「……嗯」",
        "text_idx": [
            708
        ]
    },
    {
        "ori": "悩んでいる俺の、背中を押してくれたさつき。そして、いつも明るくあたたかく気遣ってくれた、みつばちゃん。俺にとってかけがえのない、大切な二人だ。",
        "message": "在我烦恼时，推了我一把的纱月。还有，总是开朗温暖地关心着我的三叶酱。对我来说，她们是无可替代的，最重要的人。",
        "text_idx": [
            767,
            768,
            769
        ]
    },
    {
        "ori": "俺は急いでさつきの家へ向かった。",
        "message": "我急忙朝纱月的家赶去。",
        "text_idx": [
            784
        ]
    }
]