[
    {
        "ori": "一人アトリエで考えていた。",
        "message": "我一个人在画室里思考着。",
        "text_idx": [
            457
        ]
    },
    {
        "ori": "今日の事。",
        "message": "今天的事。",
        "text_idx": [
            472
        ]
    },
    {
        "ori": "昨日の事。",
        "message": "昨天的事。",
        "text_idx": [
            487
        ]
    },
    {
        "ori": "考えれば考える程、頭の中は、昨日よりもごちゃごちゃとして。",
        "message": "越是思考，脑子里就越是一团乱麻，比昨天还要混乱。",
        "text_idx": [
            502,
            503
        ]
    },
    {
        "name": "亮",
        "name_idx": 509,
        "ori": "「わからない……」",
        "message": "「我不知道……」",
        "text_idx": [
            518
        ]
    },
    {
        "ori": "もう何を考えるべきかも分からなくなってくる。",
        "message": "我已经不知道该思考些什么了。",
        "text_idx": [
            533
        ]
    },
    {
        "name": "亮",
        "name_idx": 539,
        "ori": "「んー少し頭を冷やそう」",
        "message": "「唔——稍微冷静一下吧」",
        "text_idx": [
            548
        ]
    },
    {
        "ori": "ほとんど自分自身の気持ちを整理するためにキャンバスに向かい合った。",
        "message": "我面向画布，几乎就是为了整理我自己的心情。",
        "text_idx": [
            680,
            681
        ]
    },
    {
        "ori": "真っ白なキャンバス。",
        "message": "纯白的画布。",
        "text_idx": [
            696
        ]
    },
    {
        "ori": "この白い世界に何を描こう……",
        "message": "该在这片白色的世界里画些什么呢……",
        "text_idx": [
            711
        ]
    },
    {
        "ori": "…………",
        "message": "…………",
        "text_idx": [
            726
        ]
    },
    {
        "ori": "……",
        "message": "……",
        "text_idx": [
            741
        ]
    },
    {
        "ori": "ガサガサ……",
        "message": "窸窸窣窣……",
        "text_idx": [
            784
        ]
    },
    {
        "name": "亮",
        "name_idx": 855,
        "ori": "「ん？」",
        "message": "「嗯？」",
        "text_idx": [
            864
        ]
    },
    {
        "ori": "外から音が。",
        "message": "外面传来声音。",
        "text_idx": [
            879
        ]
    },
    {
        "ori": "ガサガサ……",
        "message": "窸窸窣窣……",
        "text_idx": [
            908
        ]
    },
    {
        "ori": "ことのか？",
        "message": "是琴乃吗？",
        "text_idx": [
            937
        ]
    },
    {
        "ori": "あれ、なんかデジャビュ……",
        "message": "啊咧，总感觉有种既视感……",
        "text_idx": [
            952
        ]
    },
    {
        "name": "亮",
        "name_idx": 958,
        "ori": "「まさか」",
        "message": "「怎么会」",
        "text_idx": [
            967
        ]
    },
    {
        "ori": "昨日と似たシチュエーションに、苦笑いを浮かべて外へ向かった。",
        "message": "这和昨天相似的场景，让我不禁苦笑着朝门外走去。",
        "text_idx": [
            1055,
            1056
        ]
    },
    {
        "name": "蘭",
        "name_idx": 1367,
        "ori": "「はぁ～、ボクの意気地なし……」",
        "message": "「唉～，我这个胆小鬼……」",
        "text_idx": [
            1376
        ]
    },
    {
        "name": "蘭",
        "name_idx": 1396,
        "ori": "「昨日と変わらないじゃないか」",
        "message": "「我跟昨天根本就没什么两样嘛」",
        "text_idx": [
            1405
        ]
    },
    {
        "name": "亮",
        "name_idx": 1411,
        "ori": "「……」",
        "message": "「……」",
        "text_idx": [
            1420
        ]
    },
    {
        "ori": "外に出てみると、まさに今、穂高が庭に侵入してくるところだった。",
        "message": "我走到外面一看，发现穗高正在闯入庭院。",
        "text_idx": [
            1435,
            1436
        ]
    },
    {
        "ori": "昨日と同じく、穂高は俺が居ることに全く気付いていないらしく、ぶつぶつ独り言を呟いては溜息を吐いていた。",
        "message": "和昨天一样，穗高似乎完全没有注意到我，正小声地自言自语，不时地叹着气。",
        "text_idx": [
            1451,
            1452
        ]
    },
    {
        "ori": "どう声をかけたらいいんだ？",
        "message": "我该怎么和她搭话呢？",
        "text_idx": [
            1467
        ]
    },
    {
        "ori": "しばらく考えた末に、あの名高い怪盗紳士の名前を叫んだ。",
        "message": "我思考片刻后，喊出了那位著名的怪盗绅士的名字。",
        "text_idx": [
            1482,
            1483
        ]
    },
    {
        "name": "亮",
        "name_idx": 1489,
        "ori": "「あ、ルパンっ！」",
        "message": "「啊，鲁邦！」",
        "text_idx": [
            1498
        ]
    },
    {
        "name": "蘭",
        "name_idx": 1990,
        "ori": "「と、とっちゃ～ん！」",
        "message": "「老、老爹～！」",
        "text_idx": [
            1999
        ]
    },
    {
        "ori": "飛び上がる穂高だが、そのセリフはすらりと出てきた。",
        "message": "穗高虽然吓了一跳，但这句台词却脱口而出。",
        "text_idx": [
            2014
        ]
    },
    {
        "ori": "どうやら穂高のルパンの認識は完全にそっちの方らしい。",
        "message": "看来穗高认知里的鲁邦，完全是那一位啊。",
        "text_idx": [
            2029
        ]
    },
    {
        "name": "蘭",
        "name_idx": 2049,
        "ori": "「こ、小松原くん！？」",
        "message": "「小、小松原同学！？」",
        "text_idx": [
            2058
        ]
    },
    {
        "name": "亮",
        "name_idx": 2064,
        "ori": "「よう」",
        "message": "「哟」",
        "text_idx": [
            2073
        ]
    },
    {
        "ori": "穂高は俺を見て、さらに目を見開いて顔を赤くしていた。",
        "message": "穗高看到我，更是瞪大了双眼，脸也红了。",
        "text_idx": [
            2088
        ]
    },
    {
        "name": "蘭",
        "name_idx": 2224,
        "ori": "「ビックリしたよぉ」",
        "message": "「吓我一跳啦」",
        "text_idx": [
            2233
        ]
    },
    {
        "name": "亮",
        "name_idx": 2239,
        "ori": "「俺は、その柔軟な対応にビックリしたよ」",
        "message": "「我倒是对你那灵活的反应吓了一跳」",
        "text_idx": [
            2248
        ]
    },
    {
        "ori": "穂高の驚きっぷりを思い出して、笑ってしまう。",
        "message": "回想起穗高那副惊讶的样子，我不禁笑了出来。",
        "text_idx": [
            2263
        ]
    },
    {
        "name": "蘭",
        "name_idx": 2327,
        "ori": "「ひどいなぁ」",
        "message": "「太过分了啦」",
        "text_idx": [
            2336
        ]
    },
    {
        "ori": "顔を赤らめて、少し睨んでくる穂高。",
        "message": "穗高红着脸，稍微瞪了我一眼。",
        "text_idx": [
            2351
        ]
    },
    {
        "ori": "そんな穂高を見ていると、さっきまでのアンニュイな気持ちが嘘のように晴れていくのを感じた。",
        "message": "看着这样的穗高，我感觉刚才那份忧郁的心情就好像骗人似的烟消云散了。",
        "text_idx": [
            2366,
            2367
        ]
    },
    {
        "name": "亮",
        "name_idx": 2373,
        "ori": "「それで、今日は何してるの？　またルパンの練習？」",
        "message": "「所以，你今天在干嘛呢？　又在练习鲁邦吗？」",
        "text_idx": [
            2382
        ]
    },
    {
        "name": "蘭",
        "name_idx": 2446,
        "ori": "「え、えっと……」",
        "message": "「啊、那个……」",
        "text_idx": [
            2455
        ]
    },
    {
        "ori": "穂高は少しもじもじして、首を横に振った。",
        "message": "穗高有些扭捏地摇了摇头。",
        "text_idx": [
            2524
        ]
    },
    {
        "name": "蘭",
        "name_idx": 2588,
        "ori": "「……小松原くんに会いたくなって」",
        "message": "「……因为想见小松原同学了」",
        "text_idx": [
            2597
        ]
    },
    {
        "ori": "その穂高の言葉に、心臓が跳ね上がる。",
        "message": "穗高的话，让我的心脏猛地一跳。",
        "text_idx": [
            2612
        ]
    },
    {
        "ori": "少しだけ体が熱くなった。",
        "message": "身体稍微有些发热。",
        "text_idx": [
            2627
        ]
    },
    {
        "name": "亮",
        "name_idx": 2633,
        "ori": "「それなら、正面から来てくれてよかったのに」",
        "message": "「那你直接从正门来不就好了」",
        "text_idx": [
            2642
        ]
    },
    {
        "name": "蘭",
        "name_idx": 2662,
        "ori": "「インターホン鳴らそうと思ったんだけど、恥ずかしくなっちゃって……」",
        "message": "「我本来想按门铃的，但又觉得有点丢人……」",
        "text_idx": [
            2671,
            2672
        ]
    },
    {
        "name": "蘭",
        "name_idx": 2692,
        "ori": "「窓からこっそり覗いて、帰ろうと思ったんだ」",
        "message": "「所以就想着从窗户偷偷看一眼，然后就回去」",
        "text_idx": [
            2701
        ]
    },
    {
        "name": "亮",
        "name_idx": 2707,
        "ori": "「それ、普通に怖いな」",
        "message": "「你这样，说实话还挺吓人的」",
        "text_idx": [
            2716
        ]
    },
    {
        "ori": "それでも頭の中で想像すると、面白くて笑ってしまう。",
        "message": "但我一在脑中想象那个画面，就觉得很好笑，忍不住笑了出来。",
        "text_idx": [
            2731
        ]
    },
    {
        "ori": "もちろん想像の中の穂高はルパンの格好。",
        "message": "当然，我想象中的穗高是鲁邦的打扮。",
        "text_idx": [
            2746
        ]
    },
    {
        "name": "蘭",
        "name_idx": 2810,
        "ori": "「やっぱ、そうだよね……ごめん」",
        "message": "「果然是这样啊……对不起」",
        "text_idx": [
            2819
        ]
    },
    {
        "name": "亮",
        "name_idx": 2825,
        "ori": "「別に遠慮しなくていいんだよ。俺たち付き合ってるんだから」",
        "message": "「你不用这么见外的。我们毕竟在交往啊」",
        "text_idx": [
            2834,
            2835
        ]
    },
    {
        "ori": "その言葉に穂高はハッとした表情を見せる。",
        "message": "听到这句话，穗高猛地一怔。",
        "text_idx": [
            2948
        ]
    },
    {
        "ori": "そして、真っ赤になって顔を伏せた。",
        "message": "然后，她满脸通红地低下了头。",
        "text_idx": [
            3007
        ]
    },
    {
        "name": "蘭",
        "name_idx": 3027,
        "ori": "「ありがとう」",
        "message": "「谢谢你」",
        "text_idx": [
            3036
        ]
    },
    {
        "name": "亮",
        "name_idx": 3042,
        "ori": "「どう？　せっかくだから、俺が使ってるアトリエ見てみる？」",
        "message": "「怎么样？　机会难得，要不要看看我用的画室？」",
        "text_idx": [
            3051,
            3052
        ]
    },
    {
        "name": "蘭",
        "name_idx": 3116,
        "ori": "「い、いいの！？」",
        "message": "「可、可以吗！？」",
        "text_idx": [
            3125
        ]
    },
    {
        "name": "亮",
        "name_idx": 3131,
        "ori": "「いいよ。それに外はちょっと寒いしね」",
        "message": "「可以啊。而且外面也有点冷嘛」",
        "text_idx": [
            3140
        ]
    },
    {
        "ori": "まだ息は白くならないが、乾燥した空気に星空がよく見えた。",
        "message": "虽然呼出的气还没变成白雾，但在干燥的空气中，星空看得格外清楚。",
        "text_idx": [
            3155,
            3156
        ]
    },
    {
        "name": "蘭",
        "name_idx": 3220,
        "ori": "「そ、それじゃあ、見せてもらおうかな」",
        "message": "「那、那么，就麻烦你带我看看吧」",
        "text_idx": [
            3229
        ]
    },
    {
        "name": "亮",
        "name_idx": 3235,
        "ori": "「うん、じゃあこっち」",
        "message": "「嗯，那这边走」",
        "text_idx": [
            3244
        ]
    },
    {
        "name": "亮",
        "name_idx": 3309,
        "ori": "「どうぞ」",
        "message": "「请进」",
        "text_idx": [
            3318
        ]
    },
    {
        "name": "蘭",
        "name_idx": 3426,
        "ori": "「おじゃましま～す」",
        "message": "「打扰啦～」",
        "text_idx": [
            3435
        ]
    },
    {
        "name": "蘭",
        "name_idx": 3499,
        "ori": "「ここが、小松原くんが使ってるアトリエか……」",
        "message": "「这里就是小松原同学用的画室啊……」",
        "text_idx": [
            3508
        ]
    },
    {
        "ori": "穂高は少しそわそわしていた。",
        "message": "穗高有些坐立不安。",
        "text_idx": [
            3523
        ]
    },
    {
        "ori": "それでも嬉しそうな顔で、アトリエを物珍しそうに見て回っている。",
        "message": "即便如此，她还是一脸开心地，好奇地打量着画室的四周。",
        "text_idx": [
            3538,
            3539
        ]
    },
    {
        "ori": "そんな穂高を見てると、なんだかこちらまでくすぐったくなってきた。",
        "message": "看着那样的穗高，不知为何连我也觉得有些难为情起来。",
        "text_idx": [
            3554,
            3555
        ]
    },
    {
        "name": "亮",
        "name_idx": 3561,
        "ori": "「なんか恥ずかしいな」",
        "message": "「总觉得有点不好意思啊」",
        "text_idx": [
            3570
        ]
    },
    {
        "name": "蘭",
        "name_idx": 3634,
        "ori": "「ボクはちょっと緊張するよ」",
        "message": "「我倒是有点紧张呢」",
        "text_idx": [
            3643
        ]
    },
    {
        "ori": "それからしばらく、穂高はキラキラとした目で部屋を見て回り、アトリエにふわふわとした静かな空気が流れる。",
        "message": "在那之后的一小段时间里，穗高用闪闪发亮的眼睛环顾着房间，画室中弥漫着一股轻柔而安静的氛围。",
        "text_idx": [
            3819,
            3820
        ]
    },
    {
        "ori": "そうしていると、あちらこちらに動いていた穂高の目が、一つの物に釘付けになっていた。",
        "message": "就在这时，穗高那四处转动的视线，被一样东西给牢牢吸引住了。",
        "text_idx": [
            3961,
            3962
        ]
    },
    {
        "name": "蘭",
        "name_idx": 3982,
        "ori": "「何か描こうとしていたの？」",
        "message": "「你正准备画什么吗？」",
        "text_idx": [
            3991
        ]
    },
    {
        "name": "亮",
        "name_idx": 3997,
        "ori": "「う、うん」",
        "message": "「嗯、嗯」",
        "text_idx": [
            4006
        ]
    },
    {
        "ori": "穂高はキャンバスを覗いていた。",
        "message": "穗高正探头看着画布。",
        "text_idx": [
            4021
        ]
    },
    {
        "ori": "何も描かれていない真っ白なキャンバス。",
        "message": "那是一块什么都没画的纯白画布。",
        "text_idx": [
            4036
        ]
    },
    {
        "ori": "穂高に問われて、その白い世界に何を描こうか思考が動き出した。",
        "message": "被穗高这么一问，我的思绪开始运转起来，思考着该在那片白色的世界里画些什么。",
        "text_idx": [
            4051,
            4052
        ]
    },
    {
        "name": "蘭",
        "name_idx": 4072,
        "ori": "「不思議だよね。こんな何もないところに世界が出来るんだから」",
        "message": "「真不可思议呢。明明是这样空无一物的地方，却能创造出一个世界来」",
        "text_idx": [
            4081,
            4082
        ]
    },
    {
        "name": "亮",
        "name_idx": 4088,
        "ori": "「うん」",
        "message": "「嗯」",
        "text_idx": [
            4097
        ]
    },
    {
        "name": "蘭",
        "name_idx": 4161,
        "ori": "「演劇もね、紙に書かれた文字を読み取って、それを体で、立体で表現するんだよ」",
        "message": "「演剧也是哦，读取写在纸上的文字，然后用身体，用立体的方式把它表现出来」",
        "text_idx": [
            4170,
            4171
        ]
    },
    {
        "name": "蘭",
        "name_idx": 4191,
        "ori": "「それを考えるたびに、不思議だなって思っちゃう」",
        "message": "「每当想到这些，我都会觉得好不可思议」",
        "text_idx": [
            4200
        ]
    },
    {
        "name": "亮",
        "name_idx": 4206,
        "ori": "「そうだな……」",
        "message": "「是啊……」",
        "text_idx": [
            4215
        ]
    },
    {
        "ori": "穂高は真剣な顔で真っ白な世界を見つめていた。",
        "message": "穗高一脸认真地凝视着那片纯白的世界。",
        "text_idx": [
            4274
        ]
    },
    {
        "ori": "たったそれだけ。",
        "message": "只是这样而已。",
        "text_idx": [
            4289
        ]
    },
    {
        "ori": "それだけなのに、どうしてか何もなかった白い世界が華やいだ気がした。",
        "message": "仅仅是这样，却不知为何，让我感觉这片空无一物的白色世界也变得绚烂了起来。",
        "text_idx": [
            4304,
            4305
        ]
    },
    {
        "name": "亮",
        "name_idx": 4311,
        "ori": "「よし、決めた」",
        "message": "「好了，我决定了」",
        "text_idx": [
            4320
        ]
    },
    {
        "name": "蘭",
        "name_idx": 4384,
        "ori": "「え？」",
        "message": "「诶？」",
        "text_idx": [
            4393
        ]
    },
    {
        "name": "亮",
        "name_idx": 4399,
        "ori": "「何描くか決めたよ」",
        "message": "「我决定好要画什么了」",
        "text_idx": [
            4408
        ]
    },
    {
        "name": "蘭",
        "name_idx": 4472,
        "ori": "「まだ決めてなかったの？」",
        "message": "「你还没决定好吗？」",
        "text_idx": [
            4481
        ]
    },
    {
        "name": "亮",
        "name_idx": 4487,
        "ori": "「今決めたら大丈夫」",
        "message": "「只要现在决定了就没问题」",
        "text_idx": [
            4496
        ]
    },
    {
        "ori": "ニコッと穂高に笑い掛ける。",
        "message": "我对着穗高展颜一笑。",
        "text_idx": [
            4511
        ]
    },
    {
        "ori": "真っ白で何もない世界。",
        "message": "一片纯白，空无一物的世界。",
        "text_idx": [
            4526
        ]
    },
    {
        "ori": "その白い世界には穂高を描こうと思った。",
        "message": "我决定要在这片白色的世界里画下穗高。",
        "text_idx": [
            4541
        ]
    },
    {
        "name": "蘭",
        "name_idx": 4643,
        "ori": "「何描くの？」",
        "message": "「你要画什么？」",
        "text_idx": [
            4652
        ]
    },
    {
        "name": "亮",
        "name_idx": 4658,
        "ori": "「まあ、人物画かな」",
        "message": "「嗯，应该是人物画吧」",
        "text_idx": [
            4667
        ]
    },
    {
        "name": "蘭",
        "name_idx": 4731,
        "ori": "「人を描くんだぁ」",
        "message": "「是要画人啊」",
        "text_idx": [
            4740
        ]
    },
    {
        "name": "亮",
        "name_idx": 4746,
        "ori": "「うん。まぁ、人体って難しんだけどね」",
        "message": "「嗯。不过，画人体还挺难的呢」",
        "text_idx": [
            4755
        ]
    },
    {
        "name": "蘭",
        "name_idx": 4819,
        "ori": "「ふぅ～ん……」",
        "message": "「唔嗯……」",
        "text_idx": [
            4828
        ]
    },
    {
        "ori": "何か考えるような顔をする穂高。",
        "message": "穗高露出了像是在思考着什么的表情。",
        "text_idx": [
            4843
        ]
    },
    {
        "ori": "しばらく黙りこくって、何かを決めたような顔で俺を見てきた。",
        "message": "她沉默了一会儿，然后带着像是下定了什么决心的表情看着我。",
        "text_idx": [
            4858,
            4859
        ]
    },
    {
        "name": "蘭",
        "name_idx": 4923,
        "ori": "「小松原くん」",
        "message": "「小松原同学」",
        "text_idx": [
            4932
        ]
    },
    {
        "name": "亮",
        "name_idx": 4938,
        "ori": "「なに？」",
        "message": "「什么？」",
        "text_idx": [
            4947
        ]
    },
    {
        "name": "蘭",
        "name_idx": 4981,
        "ori": "「ボクを、人体のモデルに使って」",
        "message": "「就用我来当人体模特吧」",
        "text_idx": [
            4990
        ]
    },
    {
        "ori": "言うが早いか、穂高は真剣な顔でするすると服を脱ぎ始めた。",
        "message": "话音刚落，穗高就一脸认真地开始流畅地脱起了衣服。",
        "text_idx": [
            5019,
            5020
        ]
    },
    {
        "name": "亮",
        "name_idx": 5026,
        "ori": "「ちょ、ちょっ！？　何やってるんだよ！？」",
        "message": "「等、等等！？　你在干什么啊！？」",
        "text_idx": [
            5035
        ]
    },
    {
        "ori": "慌てて、穂高の服を脱いでいく手を掴む。",
        "message": "我慌忙抓住穗高正在脱衣服的手。",
        "text_idx": [
            5050
        ]
    },
    {
        "name": "亮",
        "name_idx": 5114,
        "ori": "「いきなりどうしたんだよ」",
        "message": "「你突然这是怎么了」",
        "text_idx": [
            5123
        ]
    },
    {
        "name": "蘭",
        "name_idx": 5187,
        "ori": "「ボク、小松原くんの役に立ちたいんだ」",
        "message": "「我就是想帮上小松原同学的忙」",
        "text_idx": [
            5196
        ]
    },
    {
        "ori": "火照ったように赤くなっていく穂高の顔。",
        "message": "穗高的脸像是发烫一样，渐渐变红了。",
        "text_idx": [
            5211
        ]
    },
    {
        "name": "蘭",
        "name_idx": 5275,
        "ori": "「でも、ボクに出来ることって、モデルになることぐらいかなって……」",
        "message": "「但是，我能做到的事，大概也就只有当模特了吧……」",
        "text_idx": [
            5284,
            5285
        ]
    },
    {
        "ori": "穂高の顔は近くで見ると、影が差して見えた。",
        "message": "凑近看去，穗高的脸上蒙着一层阴影。",
        "text_idx": [
            5300
        ]
    },
    {
        "ori": "明るいのに暗い。",
        "message": "明明很明亮，却又很阴暗。",
        "text_idx": [
            5315
        ]
    },
    {
        "ori": "嬉しいのに悲しい。",
        "message": "明明很高兴，却又很悲伤。",
        "text_idx": [
            5330
        ]
    },
    {
        "ori": "そんな矛盾したものがあった。",
        "message": "那是一种矛盾的结合。",
        "text_idx": [
            5345
        ]
    },
    {
        "ori": "どうしてこんな顔しているんだろう。",
        "message": "她为什么会露出这种表情呢。",
        "text_idx": [
            5360
        ]
    },
    {
        "name": "蘭",
        "name_idx": 5424,
        "ori": "「ボク、どんなポーズでもするから、好きに描いて」",
        "message": "「我什么姿势都可以摆，你就按你喜欢的画吧」",
        "text_idx": [
            5433
        ]
    },
    {
        "name": "亮",
        "name_idx": 5439,
        "ori": "「穂高……」",
        "message": "「穗高……」",
        "text_idx": [
            5448
        ]
    },
    {
        "name": "蘭",
        "name_idx": 5512,
        "ori": "「ボク、小松原くんの役に立ちたいんだ」",
        "message": "「我就是想帮上小松原同学的忙」",
        "text_idx": [
            5521
        ]
    },
    {
        "name": "亮",
        "name_idx": 5527,
        "ori": "「……どうしたの？　何かあった？」",
        "message": "「……你怎么了？　发生什么事了？」",
        "text_idx": [
            5536
        ]
    },
    {
        "ori": "尋ねる俺に、穂高はほんの少しだけ目を伏せた。",
        "message": "面对我的询问，穗高只是稍微垂下了目光。",
        "text_idx": [
            5551
        ]
    },
    {
        "name": "蘭",
        "name_idx": 5615,
        "ori": "「円から昼の事聞いたんだ……」",
        "message": "「我听圆说了白天发生的事……」",
        "text_idx": [
            5624
        ]
    },
    {
        "name": "亮",
        "name_idx": 5630,
        "ori": "「…………」",
        "message": "「…………」",
        "text_idx": [
            5639
        ]
    },
    {
        "ori": "昼の事……",
        "message": "白天的事……",
        "text_idx": [
            5654
        ]
    },
    {
        "ori": "頭の中に屋上での出来事が蘇る。",
        "message": "屋顶上发生的事在我脑海中复苏。",
        "text_idx": [
            5881
        ]
    },
    {
        "ori": "円に告白されて、俺は穂高を選んだ。",
        "message": "圆向我告白，而我选择了穗高。",
        "text_idx": [
            5896
        ]
    },
    {
        "ori": "考えると、穂高がそんな顔をする理由がない気がした。",
        "message": "仔细一想，我感觉穗高没有理由会是那副表情。",
        "text_idx": [
            6098
        ]
    },
    {
        "name": "蘭",
        "name_idx": 6162,
        "ori": "「ありがとう」",
        "message": "「谢谢你」",
        "text_idx": [
            6171
        ]
    },
    {
        "ori": "小さく頭を下げて、微笑んでくる。",
        "message": "她微微低下头，对我报以微笑。",
        "text_idx": [
            6186
        ]
    },
    {
        "name": "蘭",
        "name_idx": 6206,
        "ori": "「……ボクを選んでくれて」",
        "message": "「……能选择我」",
        "text_idx": [
            6215
        ]
    },
    {
        "ori": "その微笑み、言葉の内容の割には、声は暗かった。",
        "message": "那份微笑，与她话语的内容相比，声音却很阴沉。",
        "text_idx": [
            6230
        ]
    },
    {
        "name": "亮",
        "name_idx": 6236,
        "ori": "「あんまり嬉しそうじゃないけど、どうしたの？」",
        "message": "「你看起来不怎么高兴，怎么了？」",
        "text_idx": [
            6245
        ]
    },
    {
        "ori": "穂高は少し申し訳なさそうな顔をする。",
        "message": "穗高露出了有些抱歉的表情。",
        "text_idx": [
            6304
        ]
    },
    {
        "ori": "その瞳は怯えていた。",
        "message": "那双眼瞳中满是怯意。",
        "text_idx": [
            6319
        ]
    },
    {
        "name": "蘭",
        "name_idx": 6339,
        "ori": "「小松原くんは、ボクを選んで後悔してないかなって」",
        "message": "「我在想小松原同学是不是后悔选择我了……」",
        "text_idx": [
            6348
        ]
    },
    {
        "name": "亮",
        "name_idx": 6354,
        "ori": "「どうして？」",
        "message": "「为什么？」",
        "text_idx": [
            6363
        ]
    },
    {
        "ori": "掴んだ穂高の手から震えが伝わってくる。",
        "message": "从我抓住的穗高的手上传来了颤抖。",
        "text_idx": [
            6378
        ]
    },
    {
        "name": "蘭",
        "name_idx": 6398,
        "ori": "「だって、円は美人だし、人気あるし、お料理できるし」",
        "message": "「因为，小圆她又漂亮，又有人气，还会做饭……」",
        "text_idx": [
            6407
        ]
    },
    {
        "ori": "自分を卑下する穂高は、みるみる自信の無い顔になっていく。",
        "message": "妄自菲薄的穗高，脸上的自信以肉眼可见的速度消失不见。",
        "text_idx": [
            6422,
            6423
        ]
    },
    {
        "ori": "それを見ていると、胸が痛んだ。",
        "message": "看着她这副模样，我的心隐隐作痛。",
        "text_idx": [
            6438
        ]
    },
    {
        "name": "蘭",
        "name_idx": 6458,
        "ori": "「でも、ボクはおと――」",
        "message": "「可是，我是男——」",
        "text_idx": [
            6467
        ]
    },
    {
        "name": "亮",
        "name_idx": 6473,
        "ori": "「穂高」",
        "message": "「穗高」",
        "text_idx": [
            6482
        ]
    },
    {
        "ori": "口を塞ぐように穂高の顔を胸に押し付けた。",
        "message": "我像是要堵住她的嘴一般，将穗高的脸按在了我的胸口。",
        "text_idx": [
            6614
        ]
    },
    {
        "ori": "そして、ギュッと抱きしめる。",
        "message": "然后，我用力抱紧了她。",
        "text_idx": [
            6629
        ]
    },
    {
        "ori": "俺が選んだのはお前なんだ。",
        "message": "我所选择的，是你啊。",
        "text_idx": [
            6644
        ]
    },
    {
        "ori": "誰でもなく、穂高蘭という魅力的な女の子。",
        "message": "不是别人，正是穗高兰这个充满魅力的女孩子。",
        "text_idx": [
            6659
        ]
    },
    {
        "ori": "その想いが伝わるように強く強く、抱きしめた。",
        "message": "为了将这份心意传达给她，我紧紧地、紧紧地抱住了她。",
        "text_idx": [
            6674
        ]
    },
    {
        "name": "亮",
        "name_idx": 6680,
        "ori": "「蘭……」",
        "message": "「兰……」",
        "text_idx": [
            6689
        ]
    },
    {
        "ori": "胸に息遣いを感じる。",
        "message": "我能感受到她在我胸口的呼吸。",
        "text_idx": [
            6704
        ]
    },
    {
        "ori": "ほらやっぱり。",
        "message": "你看，果然没错。",
        "text_idx": [
            6719
        ]
    },
    {
        "ori": "腕に感じる柔らかさは女の子のものだった。",
        "message": "手臂上传来的柔软触感，是属于女孩子的。",
        "text_idx": [
            6734
        ]
    },
    {
        "name": "亮",
        "name_idx": 6740,
        "ori": "「俺が選んだのは、此ノ花さんじゃなくて、穂高蘭っていう女の子なんだよ」",
        "message": "「我选择的不是此之花，而是穗高兰这个女孩子啊」",
        "text_idx": [
            6749,
            6750
        ]
    },
    {
        "ori": "耳元でささやく。",
        "message": "我在她耳边轻声说道。",
        "text_idx": [
            6765
        ]
    },
    {
        "ori": "そして、抱きしめた蘭を離し、真っ直ぐ顔を見て言った。",
        "message": "然后，我松开怀里的兰，直视着她的脸说道。",
        "text_idx": [
            6922
        ]
    },
    {
        "name": "亮",
        "name_idx": 6928,
        "ori": "「もっと、自信を持っていいんだ」",
        "message": "「你可以再自信一点的」",
        "text_idx": [
            6937
        ]
    },
    {
        "name": "蘭",
        "name_idx": 7505,
        "ori": "「ありがとう」",
        "message": "「谢谢你」",
        "text_idx": [
            7514
        ]
    },
    {
        "ori": "上目遣いに見上げてくる蘭の瞳は潤んでいて今にも泣きそうだった。",
        "message": "兰向上仰望着我，双眼湿润，仿佛随时都要哭出来似的。",
        "text_idx": [
            7529,
            7530
        ]
    },
    {
        "ori": "そして嬉しそうに笑っている。",
        "message": "但同时她又开心地笑了起来。",
        "text_idx": [
            7545
        ]
    },
    {
        "ori": "瞳から、光がころころと零れた。",
        "message": "泪光从她的眼瞳中滚落。",
        "text_idx": [
            7736
        ]
    },
    {
        "name": "蘭",
        "name_idx": 7932,
        "ori": "「ありがとう……。小松原く――ううん、亮」",
        "message": "「谢谢你……。小松原同——不对，亮」",
        "text_idx": [
            7941
        ]
    },
    {
        "name": "亮",
        "name_idx": 8123,
        "ori": "「なんか、蘭に下の名前で呼ばれると、変な感じだなぁ」",
        "message": "「怎么说呢，被兰直呼名字，感觉有点不好意思啊」",
        "text_idx": [
            8132
        ]
    },
    {
        "name": "蘭",
        "name_idx": 8152,
        "ori": "「ボクも、同じだよ」",
        "message": "「我也是，一样的哦」",
        "text_idx": [
            8161
        ]
    },
    {
        "name": "亮",
        "name_idx": 8167,
        "ori": "「蘭……」",
        "message": "「兰……」",
        "text_idx": [
            8176
        ]
    },
    {
        "name": "蘭",
        "name_idx": 8196,
        "ori": "「……亮」",
        "message": "「……亮」",
        "text_idx": [
            8205
        ]
    },
    {
        "name": "蘭",
        "name_idx": 8225,
        "ori": "「なんか恥ずかしいよ」",
        "message": "「总感觉好丢人啊」",
        "text_idx": [
            8234
        ]
    },
    {
        "name": "亮",
        "name_idx": 8240,
        "ori": "「俺もだよ」",
        "message": "「我也是啊」",
        "text_idx": [
            8249
        ]
    },
    {
        "name": "蘭",
        "name_idx": 8269,
        "ori": "「……亮」",
        "message": "「……亮」",
        "text_idx": [
            8278
        ]
    },
    {
        "name": "亮",
        "name_idx": 8284,
        "ori": "「蘭……」",
        "message": "「兰……」",
        "text_idx": [
            8293
        ]
    },
    {
        "ori": "お互いに下の名前を呼び合うのが、むずがゆく、恥ずかしくて、二人一緒に吹き出した。",
        "message": "互相用名字称呼对方，让我感觉心里痒痒的，又很丢人，我们两人便一起笑了出来。",
        "text_idx": [
            8308,
            8309
        ]
    },
    {
        "name": "蘭",
        "name_idx": 8387,
        "ori": "「ふふ」",
        "message": "「呵呵」",
        "text_idx": [
            8396
        ]
    },
    {
        "ori": "蘭が、ふと恥ずかしがるような顔をしたと思ったら、今度は蘭の方から抱き付いてきた。",
        "message": "我刚觉得兰忽然露出了害羞的表情，没想到这次她主动抱了上来。",
        "text_idx": [
            8660,
            8661
        ]
    },
    {
        "name": "亮",
        "name_idx": 8667,
        "ori": "「ら、蘭？」",
        "message": "「兰、兰？」",
        "text_idx": [
            8676
        ]
    },
    {
        "name": "蘭",
        "name_idx": 8740,
        "ori": "「ねぇ、亮……」",
        "message": "「那个，亮……」",
        "text_idx": [
            8749
        ]
    },
    {
        "name": "亮",
        "name_idx": 8755,
        "ori": "「な、なに？」",
        "message": "「什、什么？」",
        "text_idx": [
            8764
        ]
    },
    {
        "name": "蘭",
        "name_idx": 8784,
        "ori": "「ボクを、亮の好きにしていいよ……」",
        "message": "「我……亮想对我做什么都可以哦……」",
        "text_idx": [
            8793
        ]
    },
    {
        "ori": "耳元で甘く囁いてくる。",
        "message": "她在我耳边甜蜜地低语。",
        "text_idx": [
            8808
        ]
    },
    {
        "ori": "そして、腕を背中に這わせて息を吹きかけてきた。",
        "message": "然后，她的手臂滑到我的背上，朝我吹着热气。",
        "text_idx": [
            8823
        ]
    },
    {
        "name": "蘭",
        "name_idx": 8843,
        "ori": "「亮が抱いてくれるなら……ボク、安心できる……」",
        "message": "「如果亮愿意抱我……我，就能安心了……」",
        "text_idx": [
            8852
        ]
    },
    {
        "name": "亮",
        "name_idx": 8858,
        "ori": "「蘭……」",
        "message": "「兰……」",
        "text_idx": [
            8867
        ]
    },
    {
        "name": "蘭",
        "name_idx": 8887,
        "ori": "「亮の手で、ボクを女にして」",
        "message": "「用亮的手，让我成为女人」",
        "text_idx": [
            8896
        ]
    },
    {
        "name": "亮",
        "name_idx": 8902,
        "ori": "「十分、女らしいけど？」",
        "message": "「你已经够有女人味了，不是吗？」",
        "text_idx": [
            8911
        ]
    },
    {
        "name": "蘭",
        "name_idx": 8931,
        "ori": "「もっともっと……女になりたいんだ。亮の望むような」",
        "message": "「我想变得……更加更加有女人味。成为亮所期望的样子」",
        "text_idx": [
            8940
        ]
    },
    {
