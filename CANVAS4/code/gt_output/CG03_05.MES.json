[
    {
        "ori": "蘭の髪の匂いが鼻をくすぐる。",
        "message": "兰的发香搔弄着我的鼻尖。",
        "text_idx": [
            155
        ]
    },
    {
        "name": "蘭",
        "name_idx": 175,
        "ori": "「亮、目をつぶって」",
        "message": "「亮，闭上眼睛」",
        "text_idx": [
            184
        ]
    },
    {
        "name": "亮",
        "name_idx": 190,
        "ori": "「……うん」",
        "message": "「……嗯」",
        "text_idx": [
            199
        ]
    },
    {
        "ori": "上目遣いに見てくる蘭に、身を任せるように目を閉じていく。",
        "message": "看着向上望着我的兰，我仿佛将自己托付给她一般，闭上了眼睛。",
        "text_idx": [
            214,
            215
        ]
    },
    {
        "ori": "っふ。",
        "message": "唔。",
        "text_idx": [
            303
        ]
    },
    {
        "ori": "そんな口からこぼれ落ちる音を耳で感じ、ふわっとした感触を唇に感じた。",
        "message": "我听到了从她口中传来的轻吟，嘴唇也感受到了柔软的触感。",
        "text_idx": [
            318,
            319
        ]
    },
    {
        "name": "蘭",
        "name_idx": 427,
        "ori": "「恥ずかしいな」",
        "message": "「真丢人啊」",
        "text_idx": [
            436
        ]
    },
    {
        "ori": "目を開けると、蘭は顔を真っ赤にして照れくさそうにしていた。",
        "message": "我睁开眼睛，只见兰满脸通红，一副害羞的样子。",
        "text_idx": [
            451,
            452
        ]
    },
    {
        "name": "蘭",
        "name_idx": 472,
        "ori": "「ファーストキスなんだ」",
        "message": "「这是我的初吻」",
        "text_idx": [
            481
        ]
    },
    {
        "name": "亮",
        "name_idx": 487,
        "ori": "「俺もだよ」",
        "message": "「我也是啊」",
        "text_idx": [
            496
        ]
    },
    {
        "name": "蘭",
        "name_idx": 516,
        "ori": "「そうなんだ。嬉しい……」",
        "message": "「是这样啊。我好开心……」",
        "text_idx": [
            525
        ]
    },
    {
        "ori": "本当に嬉しそうに微笑む蘭が愛おしくて、もう一度胸の中に仕舞い込む。",
        "message": "真心展露笑颜的兰是那么惹人怜爱，我再次将她拥入怀中。",
        "text_idx": [
            540,
            541
        ]
    },
    {
        "name": "亮",
        "name_idx": 547,
        "ori": "「蘭、俺も嬉しいよ」",
        "message": "「兰，我也很开心哦」",
        "text_idx": [
            556
        ]
    },
    {
        "ori": "しばらく抱きしめ合って、お互いの存在を確かめ合う。",
        "message": "我们相拥片刻，确认着彼此的存在。",
        "text_idx": [
            571
        ]
    },
    {
        "name": "亮",
        "name_idx": 577,
        "ori": "「蘭、目を閉じて」",
        "message": "「兰，闭上眼睛」",
        "text_idx": [
            586
        ]
    },
    {
        "ori": "今度は、こちらから。",
        "message": "这次，该由我来了。",
        "text_idx": [
            601
        ]
    },
    {
        "name": "蘭",
        "name_idx": 621,
        "ori": "「うん……」",
        "message": "「嗯……」",
        "text_idx": [
            630
        ]
    },
    {
        "ori": "蘭は、そっと目を閉じて、俺に身を任せてきた。",
        "message": "兰轻轻地闭上眼睛，将身体交给了我。",
        "text_idx": [
            689
        ]
    },
    {
        "ori": "静かな息遣い。",
        "message": "能听到她安静的呼吸声。",
        "text_idx": [
            704
        ]
    },
    {
        "ori": "蘭の唇。",
        "message": "眼前是兰的嘴唇。",
        "text_idx": [
            719
        ]
    },
    {
        "ori": "その唇はふっくら柔らかそうで、普段意識していなかった分、とても魅力的に見えた。",
        "message": "那双嘴唇看起来丰满而柔软，正因我平时未曾留意，此刻才显得格外有魅力。",
        "text_idx": [
            734,
            735
        ]
    },
    {
        "ori": "吸い込まれるように近づいていく。",
        "message": "我仿佛被吸进去一般，向她靠近。",
        "text_idx": [
            794
        ]
    },
    {
        "ori": "蘭の息遣いが間近で感じ取れ、身体が燃えるように熱くなっていく。",
        "message": "我能近距离地感受到兰的呼吸，身体也仿佛燃烧起来一般，逐渐变得滚烫。",
        "text_idx": [
            809,
            810
        ]
    },
    {
        "ori": "そして――",
        "message": "接着——",
        "text_idx": [
            825
        ]
    },
    {
        "name": "蘭",
        "name_idx": 918,
        "ori": "「んふ……」",
        "message": "「嗯呼……」",
        "text_idx": [
            927
        ]
    },
    {
        "name": "亮",
        "name_idx": 933,
        "ori": "「んっ……」",
        "message": "「唔……」",
        "text_idx": [
            942
        ]
    },
    {
        "ori": "さきほどよりも、少し強めに唇と唇が触れ合う。",
        "message": "我们的双唇相接，比刚才的触碰更用力了一些。",
        "text_idx": [
            957
        ]
    },
    {
        "ori": "そんな永遠のような一瞬。",
        "message": "这仿佛永恒的一瞬间。",
        "text_idx": [
            972
        ]
    },
    {
        "name": "亮",
        "name_idx": 1192,
        "ori": "「蘭の唇柔らかい」",
        "message": "「兰的嘴唇好软」",
        "text_idx": [
            1201
        ]
    },
    {
        "name": "蘭",
        "name_idx": 1221,
        "ori": "「そ、そうかな」",
        "message": "「是、是吗」",
        "text_idx": [
            1230
        ]
    },
    {
        "ori": "蘭は恥ずかしそうに笑ってくる。",
        "message": "兰害羞地对我笑了笑。",
        "text_idx": [
            1245
        ]
    },
    {
        "name": "蘭",
        "name_idx": 1265,
        "ori": "「でも、亮の唇も柔らかいよ」",
        "message": "「不过，亮的嘴唇也很软哦」",
        "text_idx": [
            1274
        ]
    },
    {
        "name": "亮",
        "name_idx": 1280,
        "ori": "「ほんと？」",
        "message": "「真的吗？」",
        "text_idx": [
            1289
        ]
    },
    {
        "name": "蘭",
        "name_idx": 1309,
        "ori": "「うん、それに……あたたかい」",
        "message": "「嗯，而且……很温暖」",
        "text_idx": [
            1318
        ]
    },
    {
        "ori": "ゆっくりと瞬きを繰り返す蘭は、夢を見ているような表情だった。",
        "message": "兰缓缓眨着眼，脸上是如梦似幻的表情。",
        "text_idx": [
            1333,
            1334
        ]
    },
    {
        "name": "蘭",
        "name_idx": 1354,
        "ori": "「亮に、ボクの初めて全部あげる」",
        "message": "「亮，我的全部第一次都给你」",
        "text_idx": [
            1363
        ]
    },
    {
        "name": "亮",
        "name_idx": 1369,
        "ori": "「蘭……」",
        "message": "「兰……」",
        "text_idx": [
            1378
        ]
    },
    {
        "ori": "そんな蘭にときめく。",
        "message": "这样的兰让我心动不已。",
        "text_idx": [
            1393
        ]
    },
    {
        "ori": "愛らしく思い、蘭の髪を撫でた。",
        "message": "我心生爱怜，抚摸着兰的头发。",
        "text_idx": [
            1408
        ]
    },
    {
        "name": "亮",
        "name_idx": 1414,
        "ori": "「俺の初めても、蘭にあげるよ」",
        "message": "「我的第一次，也全都给你哦」",
        "text_idx": [
            1423
        ]
    },
    {
        "name": "蘭",
        "name_idx": 1443,
        "ori": "「嬉しい……」",
        "message": "「我好开心……」",
        "text_idx": [
            1452
        ]
    },
    {
        "ori": "微笑む蘭は、全てを俺に預けるように目を閉じてきた。",
        "message": "面带微笑的兰，像是要将自己的一切都托付给我一般，闭上了眼睛。",
        "text_idx": [
            1467
        ]
    },
    {
        "name": "亮",
        "name_idx": 1517,
        "ori": "「蘭……」",
        "message": "「兰……」",
        "text_idx": [
            1526
        ]
    },
    {
        "ori": "引き寄せていく蘭の顔を胸に刻み込む。",
        "message": "我将缓缓拉近的兰的脸庞，铭刻于心。",
        "text_idx": [
            1541
        ]
    },
    {
        "ori": "そして、そのふっくらとした唇に囚われるように目を閉じた。",
        "message": "我仿佛被她那丰润的嘴唇所俘获，闭上了眼睛。",
        "text_idx": [
            1629,
            1630
        ]
    },
    {
        "name": "亮",
        "name_idx": 1710,
        "ori": "「ん……」",
        "message": "「嗯……」",
        "text_idx": [
            1719
        ]
    },
    {
        "name": "蘭",
        "name_idx": 1739,
        "ori": "「ん……ん」",
        "message": "「嗯……嗯」",
        "text_idx": [
            1748
        ]
    },
    {
        "ori": "唇が触れ合い、押し付け、今度は離さない。",
        "message": "我们的双唇相互触碰、紧紧相贴，这一次没有分开。",
        "text_idx": [
            1763
        ]
    },
    {
        "ori": "唇の感触を楽しむように、しばらく唇に力を入れたり抜いたりを繰り返す。",
        "message": "我仿佛在享受着唇瓣的触感，时而用力、时而放松，反复如此。",
        "text_idx": [
            1778,
            1779
        ]
    },
    {
        "name": "亮",
        "name_idx": 1785,
        "ori": "「んっ」",
        "message": "「嗯」",
        "text_idx": [
            1794
        ]
    },
    {
        "name": "蘭",
        "name_idx": 1814,
        "ori": "「んんっ……」",
        "message": "「唔嗯……」",
        "text_idx": [
            1823
        ]
    },
    {
        "ori": "ふと、どこからか衝迫が湧き上がり、グッと強く唇を押し付けた。",
        "message": "忽然，一股冲动不知从何而起，我用力地将嘴唇紧紧压了上去。",
        "text_idx": [
            1838,
            1839
        ]
    },
    {
        "name": "蘭",
        "name_idx": 1859,
        "ori": "「はぁ……んふっ」",
        "message": "「哈……嗯唔」",
        "text_idx": [
            1868
        ]
    },
    {
        "ori": "そうすると自然と口が開き合って、俺の舌が蘭の舌と触れ合った。",
        "message": "这么一来，我们自然而然地张开了嘴，我的舌头触碰到了兰的舌头。",
        "text_idx": [
            1883,
            1884
        ]
    },
    {
        "name": "蘭",
        "name_idx": 1904,
        "ori": "「んん……ぁ、ん」",
        "message": "「嗯嗯……啊、嗯」",
        "text_idx": [
            1913
        ]
    },
    {
        "ori": "最初はおっかなびっくり触れ合っていたが、次第に絡め合っていく。",
        "message": "起初还只是小心翼翼地触碰，但渐渐地，我们的舌头交缠在了一起。",
        "text_idx": [
            1928,
            1929
        ]
    },
    {
        "name": "蘭",
        "name_idx": 1949,
        "ori": "「んっん、ふっぅ……」",
        "message": "「嗯嗯，呼……」",
        "text_idx": [
            1958
        ]
    },
    {
        "ori": "段々と激しさが増してきて、呼吸を共有し、お互いの口を何度も唇で塞ぎ合った。",
        "message": "我们的吻渐渐激烈起来，我们分享着彼此的呼吸，用双唇无数次地堵上对方的嘴。",
        "text_idx": [
            1973,
            1974
        ]
    },
    {
        "name": "亮",
        "name_idx": 1980,
        "ori": "「んんっん……」",
        "message": "「嗯嗯……」",
        "text_idx": [
            1989
        ]
    },
    {
        "name": "蘭",
        "name_idx": 2009,
        "ori": "「んぅふっはぁ……ん」",
        "message": "「嗯呼哈啊……嗯」",
        "text_idx": [
            2018
        ]
    },
    {
        "ori": "唾液が溢れて来る。",
        "message": "唾液从嘴角溢了出来。",
        "text_idx": [
            2033
        ]
    },
    {
        "ori": "蘭の唾液も混じり合いぐちゃぐちゃと音を奏で始めた。",
        "message": "兰的唾液也混了进来，我们交缠的唇舌间奏起了啧啧的水声。",
        "text_idx": [
            2048
        ]
    },
    {
        "name": "蘭",
        "name_idx": 2068,
        "ori": "「ん、んはぁ……んん」",
        "message": "「嗯、嗯哈……嗯嗯」",
        "text_idx": [
            2077
        ]
    },
    {
        "ori": "蘭の髪、肩、背中を撫でるが熱い。",
        "message": "我抚摸着兰的头发、肩膀、后背，好烫。",
        "text_idx": [
            2092
        ]
    },
    {
        "ori": "俺の背中を這う蘭の手も激しさを増してきた。",
        "message": "兰在我背上游走的手也变得激烈起来。",
        "text_idx": [
            2107
        ]
    },
    {
        "name": "亮",
        "name_idx": 2113,
        "ori": "「んっふ、はぁ……」",
        "message": "「嗯呼，哈……」",
        "text_idx": [
            2122
        ]
    },
    {
        "name": "蘭",
        "name_idx": 2142,
        "ori": "「んんっぁふ……はぁん」",
        "message": "「嗯啊呼……哈嗯」",
        "text_idx": [
            2151
        ]
    },
    {
        "ori": "このまま壊してしまいたい。",
        "message": "真想就这样把她玩坏。",
        "text_idx": [
            2166
        ]
    },
    {
        "ori": "そんな衝動が湧き上がり、蘭を近くのテーブルに押し倒した。",
        "message": "一股这样的冲动涌了上来，我把兰推倒在附近的桌子上。",
        "text_idx": [
            2181,
            2182
        ]
    },
    {
        "name": "蘭",
        "name_idx": 2447,
        "ori": "「あぁぅ……亮……」",
        "message": "「啊呜……亮……」",
        "text_idx": [
            2456
        ]
    },
    {
        "name": "亮",
        "name_idx": 2462,
        "ori": "「蘭」",
        "message": "「兰」",
        "text_idx": [
            2471
        ]
    },
    {
        "ori": "媚びた目で見つめてくる蘭の唇を奪う。",
        "message": "我夺走了用媚眼凝视着我的兰的双唇。",
        "text_idx": [
            2486
        ]
    },
    {
        "name": "蘭",
        "name_idx": 2506,
        "ori": "「んんっはぁ、ん……」",
        "message": "「嗯嗯哈，嗯……」",
        "text_idx": [
            2515
        ]
    },
    {
        "ori": "お互いの口腔を掻き乱していく。",
        "message": "我们搅乱着彼此的口腔。",
        "text_idx": [
            2530
        ]
    },
    {
        "ori": "口を塞がれ、塞ぎ返しての繰り返し。",
        "message": "我们反复封堵着彼此的嘴唇。",
        "text_idx": [
            2545
        ]
    },
    {
        "name": "蘭",
        "name_idx": 2565,
        "ori": "「んっはぁはぁ……」",
        "message": "「嗯哈啊哈啊……」",
        "text_idx": [
            2574
        ]
    },
    {
        "ori": "長い口づけを終えて、唇を離す。",
        "message": "结束了漫长的亲吻后，我分开了双唇。",
        "text_idx": [
            2589
        ]
    },
    {
        "ori": "頭がゆで上がったように興奮して、そのまま蘭の胸元に唇を持っていった。",
        "message": "我兴奋得脑袋快要炸开，就这样将嘴唇凑向了兰的胸前。",
        "text_idx": [
            2604,
            2605
        ]
    },
    {
        "name": "蘭",
        "name_idx": 2625,
        "ori": "「亮、明かり消してくれるかな……。恥ずかしい」",
        "message": "「亮，能把灯关掉吗……。好丢人」",
        "text_idx": [
            2634
        ]
    },
    {
        "name": "亮",
        "name_idx": 2640,
        "ori": "「う、うん……わかった」",
        "message": "「呜、嗯……好的」",
        "text_idx": [
            2649
        ]
    },
    {
        "ori": "蘭の頭を撫でて、興奮を抱えたまま離れ電気を消しに行く。",
        "message": "我抚摸着兰的头，怀着激动的心情起身去关灯。",
        "text_idx": [
            2664,
            2665
        ]
    },
    {
        "ori": "少し落ち着きを取り戻して、蘭の元へ戻る。",
        "message": "我稍微冷静下来，回到了兰的身边。",
        "text_idx": [
            2785
        ]
    },
    {
        "name": "蘭",
        "name_idx": 3119,
        "ori": "「少しだけ怖いな……」",
        "message": "「我还是有点害怕呢……」",
        "text_idx": [
            3128
        ]
    },
    {
        "ori": "蘭は少し不安そうな顔をしていた。",
        "message": "兰的脸上露出了些许不安的神情。",
        "text_idx": [
            3143
        ]
    },
    {
        "name": "亮",
        "name_idx": 3149,
        "ori": "「大丈夫？」",
        "message": "「没事吧？」",
        "text_idx": [
            3158
        ]
    },
    {
        "name": "蘭",
        "name_idx": 3222,
        "ori": "「うん……。亮が相手だから」",
        "message": "「嗯……。因为是亮你」",
        "text_idx": [
            3231
        ]
    },
    {
        "ori": "ギュッと手を握っていじらしく微笑んできた。",
        "message": "兰紧紧地握住我的手，惹人怜爱地微笑着。",
        "text_idx": [
            3246
        ]
    },
    {
        "ori": "月明かりでも蘭の顔が赤いことが分かる。",
        "message": "即使在月光下，我也能看出兰的脸红了。",
        "text_idx": [
            3334
        ]
    },
    {
        "ori": "芸術的に見えた。",
        "message": "看起来就像艺术品一样。",
        "text_idx": [
            3349
        ]
    },
    {
        "ori": "蘭の全てが。",
        "message": "兰的一切都是。",
        "text_idx": [
            3364
        ]
    },
    {
        "ori": "恥じらう顔も、細い腕も、しなやかな足も、全てが全て。",
        "message": "她害羞的脸庞、纤细的手臂、柔美的双腿，她的一切的一切。",
        "text_idx": [
            3379
        ]
    },
    {
        "ori": "そっと手を伸ばす。",
        "message": "我轻轻地伸出手。",
        "text_idx": [
            3394
        ]
    },
    {
        "name": "蘭",
        "name_idx": 3414,
        "ori": "「……優しく、してね」",
        "message": "「……要温柔、一点哦」",
        "text_idx": [
            3423
        ]
    },
    {
        "name": "亮",
        "name_idx": 3429,
        "ori": "「うん」",
        "message": "「嗯」",
        "text_idx": [
            3438
        ]
    },
    {
        "name": "蘭",
        "name_idx": 3540,
        "ori": "「んふ……」",
        "message": "「嗯呼……」",
        "text_idx": [
            3549
        ]
    },
    {
        "ori": "手を握り、太ももを撫でる。",
        "message": "我握着她的手，抚摸着她的大腿。",
        "text_idx": [
            3564
        ]
    },
    {
        "ori": "芸術品に触れるように、優しく、優しく。",
        "message": "就像在触摸艺术品一样，温柔地，温柔地。",
        "text_idx": [
            3579
        ]
    },
    {
        "name": "蘭",
        "name_idx": 3643,
        "ori": "「んっ……亮の手、あたたかいよ」",
        "message": "「嗯……亮的手，好温暖啊」",
        "text_idx": [
            3652
        ]
    },
    {
        "name": "亮",
        "name_idx": 3658,
        "ori": "「蘭の身体も段々熱くなってるよ」",
        "message": "「兰的身体也渐渐变热了哦」",
        "text_idx": [
            3667
        ]
    },
    {
        "ori": "握った手を離し、そのまま露わになったおなかに持っていく。",
        "message": "我松开握着的手，顺势移到她裸露的小腹上。",
        "text_idx": [
            3682,
            3683
        ]
    },
    {
        "name": "蘭",
        "name_idx": 3747,
        "ori": "「うふ……くすぐったい」",
        "message": "「唔呼……好痒啊」",
        "text_idx": [
            3756
        ]
    },
    {
        "name": "亮",
        "name_idx": 3762,
        "ori": "「引き締まってるよね」",
        "message": "「很紧致呢」",
        "text_idx": [
            3771
        ]
    },
    {
        "name": "蘭",
        "name_idx": 3791,
        "ori": "「そう？　発声練習とかしてるからかな……？」",
        "message": "「是吗？　可能是因为我常做发声练习吧……？」",
        "text_idx": [
            3800
        ]
    },
    {
        "ori": "お腹を優しく撫でて、もう一度蘭の唇を奪う。",
        "message": "我温柔地抚摸着她的小腹，再一次夺走了兰的唇瓣。",
        "text_idx": [
            3815
        ]
    },
    {
        "name": "蘭",
        "name_idx": 3879,
        "ori": "「はぅんっ……」",
        "message": "「哈嗯……」",
        "text_idx": [
            3888
        ]
    },
    {
        "ori": "唇を塞いだまま、滑らすようにブラの中に手を入れる。",
        "message": "我维持着堵住她双唇的姿势，将手滑入了她的胸罩里。",
        "text_idx": [
            3903
        ]
    },
    {
        "ori": "驚いたのか、蘭の身体がピクッと強ばったが、一つ深呼吸をして身体の力を抜いてくれた。",
        "message": "或许是吓到了，兰的身体抽搐着僵硬了一下，但她做了一次深呼吸，随即放松了身体。",
        "text_idx": [
            3962,
            3963
        ]
    },
    {
        "ori": "それが俺を信用して委ねてくれてるようで嬉しかった。",
        "message": "她仿佛在信任我、将自己托付给我一般，这让我感到很高兴。",
        "text_idx": [
            4022
        ]
    },
    {
        "ori": "弾力のある柔らかさが、手の平の神経を伝って脳に痺れを運んでくる。",
        "message": "那富有弹性的柔软，通过我手掌的神经将一阵麻痹感传到了我的大脑。",
        "text_idx": [
            4037,
            4038
        ]
    },
    {
        "ori": "柔らかい。",
        "message": "好柔软。",
        "text_idx": [
            4053
        ]
    },
    {
        "ori": "こんなものがこの世にあるのか。",
        "message": "世上竟有如此之物。",
        "text_idx": [
            4068
        ]
    },
    {
        "name": "蘭",
        "name_idx": 4132,
        "ori": "「ぅんんっ……はぁはぁ」",
        "message": "「唔嗯嗯……哈啊哈啊」",
        "text_idx": [
            4141
        ]
    },
    {
        "ori": "唇を放すと、蘭の息遣いは荒くなっていた。",
        "message": "放开双唇后，兰的呼吸变得急促起来。",
        "text_idx": [
            4156
        ]
    },
    {
        "ori": "その喘ぎにも似た息遣いが、さらに身体を熱くさせた。",
        "message": "那如同娇喘般的呼吸声，更是让我的身体燥热起来。",
        "text_idx": [
            4171
        ]
    },
    {
        "name": "亮",
        "name_idx": 4177,
        "ori": "「ごめん、外すよ」",
        "message": "「抱歉，我要解开了哦」",
        "text_idx": [
            4186
        ]
    },
    {
        "name": "蘭",
        "name_idx": 4250,
        "ori": "「あぅ……あ……ああ」",
        "message": "「啊……啊……啊啊」",
        "text_idx": [
            4259
        ]
    },
    {
        "ori": "熱に浮かされたように、ブラを外し、両の手で揉み始める。",
        "message": "我仿佛被情热冲昏了头脑，解开她的胸罩，用双手揉捏起来。",
        "text_idx": [
            4669,
            4670
        ]
    },
    {
        "name": "蘭",
        "name_idx": 4734,
        "ori": "「あぁ……うぅ、ああ」",
        "message": "「啊……唔，啊啊」",
        "text_idx": [
            4743
        ]
    },
    {
        "ori": "最初は優しく、でも枷が外れていくように段々と手に力が入った。",
        "message": "起初我还很温柔，但手上的力道却仿佛挣脱了枷锁一般渐渐加重了起来。",
        "text_idx": [
            4758,
            4759
        ]
    },
    {
        "ori": "自分の心臓の鼓動が鼓膜にうるさい。",
        "message": "我心脏的鼓动声，吵得我耳膜生疼。",
        "text_idx": [
            4774
        ]
    },
    {
        "name": "蘭",
        "name_idx": 4838,
        "ori": "「ボクの、胸どうかな……んふぁ……」",
        "message": "「我的胸部，怎么样……嗯哈……」",
        "text_idx": [
            4847
        ]
    },
    {
        "name": "亮",
        "name_idx": 4853,
        "ori": "「柔らかくて、弾力があって、いいよ」",
        "message": "「很柔软，又很有弹性，非常棒哦」",
        "text_idx": [
            4862
        ]
    },
    {
        "name": "蘭",
        "name_idx": 4926,
        "ori": "「んふ……よかった……」",
        "message": "「嗯呼……太好了……」",
        "text_idx": [
            4935
        ]
    },
    {
        "ori": "蘭は目を細めて笑う。",
        "message": "兰眯起眼睛笑了。",
        "text_idx": [
            4950
        ]
    },
    {
        "name": "蘭",
        "name_idx": 4970,
        "ori": "「んっ、ボク……女っぽくないから、ぁあ、心配だったんだ……」",
        "message": "「嗯，我……因为没什么女人味，啊啊，所以很担心……」",
        "text_idx": [
            4979,
            4980
        ]
    },
    {
        "name": "亮",
        "name_idx": 4986,
        "ori": "「何言ってるんだよ、蘭はとても、女らしいよ」",
        "message": "「你在说什么呢，兰你非常、有女人味哦」",
        "text_idx": [
            4995
        ]
    },
    {
        "name": "蘭",
        "name_idx": 5015,
        "ori": "「そ、そうかな……」",
        "message": "「是、是吗……」",
        "text_idx": [
            5024
        ]
    },
    {
        "ori": "枷の外れた手は自然に蘭のお腹を這って下半身に触れた。",
        "message": "我那挣脱了枷锁的手自然地划过兰的小腹，触碰到了她的下半身。",
        "text_idx": [
            5039
        ]
    },
    {
        "name": "蘭",
        "name_idx": 5103,
        "ori": "「はぅぁ……」",
        "message": "「哈啊……」",
        "text_idx": [
            5112
        ]
    },
    {
        "ori": "ズボンを下ろしていく。",
        "message": "我脱下她的裤子。",
        "text_idx": [
            5127
        ]
    },
    {
        "ori": "指先の感触で気付く。",
        "message": "我从指尖的触感中察觉到了。",
        "text_idx": [
            5392
        ]
    },
    {
        "ori": "蘭のショーツはすでに濡れていた。",
        "message": "兰的短裤已经湿了。",
        "text_idx": [
            5407
        ]
    },
    {
        "name": "亮",
        "name_idx": 5413,
        "ori": "「濡れてるね」",
        "message": "「湿了呢」",
        "text_idx": [
            5422
        ]
    },
    {
        "ori": "少しだけ驚く。",
        "message": "我稍微有些吃惊。",
        "text_idx": [
            5437
        ]
    },
    {
        "ori": "どうなっているのかショーツに目をやると、蘭のしなやかな足が恥ずかしがるように閉じた。",
        "message": "我将目光投向她的短裤，想看看究竟怎么回事，但兰修长的双腿却像是害羞般地合拢了。",
        "text_idx": [
            5452,
            5453
        ]
    },
    {
        "name": "蘭",
        "name_idx": 5677,
        "ori": "「恥ずかしいよ……。見ないで……」",
        "message": "「太丢人了……。别看……」",
        "text_idx": [
            5686
        ]
    },
    {
        "ori": "その恥じらいがいじらしくて、愛おしく感じる。",
        "message": "她的这份羞涩让我感到怜爱，心生爱意。",
        "text_idx": [
            5701
        ]
    },
    {
        "ori": "だからもう一度唇を奪う。",
        "message": "所以我再次夺走了她的双唇。",
        "text_idx": [
            5716
        ]
    },
    {
        "name": "蘭",
        "name_idx": 5736,
        "ori": "「んん……ふっ」",
        "message": "「嗯嗯……哼」",
        "text_idx": [
            5745
        ]
    },
    {
        "ori": "そのまま下へ下へと。",
        "message": "我就这样一路向下。",
        "text_idx": [
            5760
        ]
    },
    {
        "ori": "首筋に息を吹きかけキスをする。",
        "message": "我朝她的脖颈吹气，亲吻着她。",
        "text_idx": [
            5775
        ]
    },
    {
        "ori": "そして、唇を乳房へ。",
        "message": "然后，将双唇移向她的乳房。",
        "text_idx": [
            5790
        ]
    },
    {
        "name": "蘭",
        "name_idx": 5854,
        "ori": "「うぁん……ぅ」",
        "message": "「呜啊……呜」",
        "text_idx": [
            5863
        ]
    },
    {
        "ori": "息を吹きかけてから押しつけるようにキスをし、舐め回るようにぐるぐると唇を当てていく。",
        "message": "我先是吹了口气，然后像是要按压上去一般亲吻着，并用嘴唇画着圈舔舐起来。",
        "text_idx": [
            5878,
            5879
        ]
    },
    {
        "ori": "そして、綺麗な乳輪を舌でなぞって、一番上に吸いついた。",
        "message": "然后，我用舌头描摹着她漂亮的乳晕，并含住了最顶端。",
        "text_idx": [
            5894,
            5895
        ]
    },
    {
        "name": "蘭",
        "name_idx": 5915,
        "ori": "「うぅ……あぅ……あふぅ」",
        "message": "「呜……啊……啊哈」",
        "text_idx": [
            5924
        ]
    },
    {
        "ori": "吸っては出して舌で弄ぶのを繰り返しながら、片手でもう一方の乳房を揉みしだく。",
        "message": "我一边反复地吸吮、吐出、用舌头玩弄着，一边用另一只手揉搓着她另一边的乳房。",
        "text_idx": [
            5939,
            5940
        ]
    },
    {
        "ori": "それは次第に激しくなって、蘭の身体が震え始めた。",
        "message": "我的动作逐渐变得激烈起来，兰的身体也开始颤抖。",
        "text_idx": [
            5955
        ]
    },
    {
        "name": "蘭",
        "name_idx": 6019,
        "ori": "「き、気持ちイイよ。こんなに気持ちイイなんて……」",
        "message": "「好、好舒服啊。没想到会这么舒服……」",
        "text_idx": [
            6028
        ]
    },
    {
        "ori": "唾液で濡れた乳房をさらに舐めながら、手を蘭のショーツに持っていき優しく撫でる。",
        "message": "我一边继续舔舐着被唾液濡湿的乳房，一边将手伸向兰的短裤，温柔地抚摸着。",
        "text_idx": [
            6043,
            6044
        ]
    },
    {
        "name": "蘭",
        "name_idx": 6108,
        "ori": "「そ、そこは……うぅ」",
        "message": "「那、那里……呜」",
        "text_idx": [
            6117
        ]
    },
    {
        "ori": "さっきよりも濡れているそこを、優しく優しく何度も撫でる。",
        "message": "我温柔地、温柔地，在那比刚才更加湿润的地方，反复抚摸着。",
        "text_idx": [
            6132,
            6133
        ]
    },
    {
        "name": "蘭",
        "name_idx": 6197,
        "ori": "「んふぅ……あぁ……」",
        "message": "「嗯呼……啊啊……」",
        "text_idx": [
            6206
        ]
    },
    {
        "ori": "そして舌で蘭の身体に線を引きながら、濡れているそこへ持っていった。",
        "message": "然后，我用舌头在兰的身体上画着线，一路向下，来到了那片湿润之处。",
        "text_idx": [
            6221,
            6222
        ]
    },
    {
        "name": "蘭",
        "name_idx": 6286,
        "ori": "「は、恥ずかしい……」",
        "message": "「好、好丢人……」",
        "text_idx": [
            6295
        ]
    },
    {
        "ori": "男性を酔わす女性の匂い。",
        "message": "这是令男性沉醉的女性香气。",
        "text_idx": [
            6310
        ]
    },
    {
        "ori": "頭がジンジンし始めた。",
        "message": "我的脑袋开始发昏了。",
        "text_idx": [
            6325
        ]
    },
    {
        "name": "蘭",
        "name_idx": 6389,
        "ori": "「……ああぅ！」",
        "message": "「……啊啊！」",
        "text_idx": [
            6398
        ]
    },
    {
        "ori": "舌をぐっと押しつける。",
        "message": "我用力地将舌头压了上去。",
        "text_idx": [
            6413
        ]
    },
    {
        "name": "蘭",
        "name_idx": 6477,
        "ori": "「はあう……あぁ……」",
        "message": "「哈啊……啊……」",
        "text_idx": [
            6486
        ]
    },
    {
        "ori": "そして何度も何度も押しつけながら、ズボンを完全に下ろし、ショーツを脱がした。",
        "message": "我一边反复按压，一边彻底褪下自己的裤子，并脱掉了她的短裤。",
        "text_idx": [
            6501,
            6502
        ]
    },
    {
        "name": "蘭",
        "name_idx": 6932,
        "ori": "「そ、そんなに見ないで……恥ずかしい」",
        "message": "「别、别那样看着我……好丢人」",
        "text_idx": [
            6941
        ]
    },
    {
        "name": "亮",
        "name_idx": 7063,
        "ori": "「ごめん、とても綺麗だったから……」",
        "message": "「抱歉，因为你太美了……」",
        "text_idx": [
            7072
        ]
    },
    {
        "ori": "つい見惚れてしまう。",
        "message": "我不由得看入迷了。",
        "text_idx": [
            7087
        ]
    },
    {
        "ori": "絵画などで女性の裸体は見たことはあったが、実際に生で見るのは初めてだった。",
        "message": "我虽然在绘画等作品中见过女性的裸体，但亲眼见到还是第一次。",
        "text_idx": [
            7102,
            7103
        ]
    },
    {
        "name": "亮",
        "name_idx": 7109,
        "ori": "「とても、女らしいよ」",
        "message": "「你很有女人味」",
        "text_idx": [
            7118
        ]
    },
    {
        "ori": "恐る恐る手を伸ばして触れる。",
        "message": "我小心翼翼地伸出手触碰她。",
        "text_idx": [
            7133
        ]
    },
    {
        "name": "蘭",
        "name_idx": 7153,
        "ori": "「うぅっ」",
        "message": "「唔」",
        "text_idx": [
            7162
        ]
    },
    {
        "ori": "ビクッと蘭の身体が震えて、驚いて手を離した。",
        "message": "兰的身体猛地一颤，我吓得松开了手。",
        "text_idx": [
            7177
        ]
    },
    {
        "ori": "そしてもう一度指で触れる。",
        "message": "然后，我又一次用手指触碰她。",
        "text_idx": [
            7192
        ]
    },
    {
        "name": "蘭",
        "name_idx": 7256,
        "ori": "「うぁぅ……」",
        "message": "「呜啊……」",
        "text_idx": [
            7265
        ]
    },
    {
        "ori": "蘭の身体がビクッと反応する。",
        "message": "兰的身体猛地一颤。",
        "text_idx": [
            7280
        ]
    },
    {
        "ori": "でも今度は離すことはなく、ゆっくりと優しく撫でた。",
        "message": "但这次我没有松开手，而是缓慢而温柔地抚摸着她。",
        "text_idx": [
            7295
        ]
    },
    {
        "name": "蘭",
        "name_idx": 7315,
        "ori": "「あぁ……んぁっ……」",
        "message": "「啊啊……嗯啊……」",
        "text_idx": [
            7324
        ]
    },
    {
        "name": "蘭",
        "name_idx": 7344,
        "ori": "「あぁっ……ボク、どうしちゃったんだろう。うぅふっ……身体が熱いよ」",
        "message": "「啊啊……我，这是怎么了。唔呼……身体好烫啊」",
        "text_idx": [
            7353,
            7354
        ]
    },
    {
        "ori": "撫でれば撫でるほど、あたたかくて、ぬるりとした液が指に絡み付く。",
        "message": "我越是抚摸，温暖而滑腻的液体就越是缠绕在我的手指上。",
        "text_idx": [
            7369,
            7370
        ]
    },
    {
        "name": "亮",
        "name_idx": 7376,
        "ori": "「蘭のここ、ぬるぬるだよ」",
        "message": "「兰的这里，好湿滑啊」",
        "text_idx": [
            7385
        ]
    },
    {
        "name": "蘭",
        "name_idx": 7449,
        "ori": "「うぅ……」",
        "message": "「呜……」",
        "text_idx": [
            7458
        ]
    },
    {
        "ori": "恥じらった顔をする蘭に笑い掛けて、撫でる指に少し力を入れてみた。",
        "message": "我笑着看向一脸羞涩的兰，抚摸她的手指稍微加了点力道。",
        "text_idx": [
            7473,
            7474
        ]
    },
    {
        "name": "蘭",
        "name_idx": 7538,
        "ori": "「ぁあ……、あぁっ身体が変に、なりそうだよ……」",
        "message": "「啊啊……，啊啊，身体好像要、变得奇怪了……」",
        "text_idx": [
            7547
        ]
    },
    {
        "ori": "撫でる指を押し入れてみる。",
        "message": "我试着将抚摸的手指探了进去。",
        "text_idx": [
            7562
        ]
    },
    {
        "name": "蘭",
        "name_idx": 7626,
        "ori": "「ああっ……」",
        "message": "「啊啊……」",
        "text_idx": [
            7635
        ]
    },
    {
        "ori": "蘭の身体はさっきよりも強く反応する。",
        "message": "兰的身体比刚才的反应更强烈了。",
        "text_idx": [
            7650
        ]
    },
    {
        "ori": "びくびくとひくつくのを指が感じ取った。",
        "message": "我的手指感觉到了她不住地颤抖抽搐。",
        "text_idx": [
            7665
        ]
    },
    {
        "name": "亮",
        "name_idx": 7671,
        "ori": "「どう？」",
        "message": "「怎么样？」",
        "text_idx": [
            7680
        ]
    },
    {
        "name": "蘭",
        "name_idx": 7744,
        "ori": "「うぅ……で、電気が走ったみたいだったよ」",
        "message": "「唔……就、就像有电流穿过身体一样」",
        "text_idx": [
            7753
        ]
    },
    {
        "ori": "もう一度、指を押し入れる。",
        "message": "我再次将手指插了进去。",
        "text_idx": [
            7768
        ]
    },
    {
        "name": "蘭",
        "name_idx": 7832,
        "ori": "「んああっ……」",
        "message": "「唔啊……」",
        "text_idx": [
            7841
        ]
    },
    {
        "ori": "蘭の身体がびくりと反応して、愛液が少し溢れた。",
        "message": "兰的身体猛地一颤，爱液稍微溢出了一些。",
        "text_idx": [
            7856
        ]
    },
    {
        "name": "蘭",
        "name_idx": 7920,
        "ori": "「うぅ……」",
        "message": "「呜……」",
        "text_idx": [
            7929
        ]
    },
    {
        "name": "亮",
        "name_idx": 7935,
        "ori": "「もう一度行くよ」",
        "message": "「我再来一次哦」",
        "text_idx": [
            7944
        ]
    },
    {
        "name": "蘭",
        "name_idx": 8008,
        "ori": "「ぅあぁっ、あ……」",
        "message": "「呜啊、啊……」",
        "text_idx": [
            8017
        ]
    },
    {
        "name": "亮",
        "name_idx": 8023,
        "ori": "「蘭」",
        "message": "「兰」",
        "text_idx": [
            8032
        ]
    },
    {
        "name": "蘭",
        "name_idx": 8052,
        "ori": "「ぁああ……ぁ、ああ……」",
        "message": "「啊啊……啊、啊啊……」",
        "text_idx": [
            8061
        ]
    },
    {
        "ori": "最初はゆっくりだったそれが、蘭の反応と愛液の絡み付きでリミッターが外れるようにどんどんとスピードを上げていく。",
        "message": "起初我的动作还很缓慢，但随着兰的反应和爱液的交缠，我仿佛解除了限制器一般，速度越来越快。",
        "text_idx": [
            8076,
            8077,
            8078
        ]
    },
    {
        "ori": "蘭がビクッと反応するたびに、何も考えられなくなる。",
        "message": "每当兰的身体一颤，我的大脑就一片空白。",
        "text_idx": [
            8093
        ]
    },
    {
        "name": "蘭",
        "name_idx": 8113,
        "ori": "「ううっ……あうぅっ」",
        "message": "「呜呜……啊呜……」",
        "text_idx": [
            8122
        ]
    },
    {
        "ori": "もう一度、もう一度と、昂る気持ちを指に乗せて、撫でては押し入れるを繰り返した。",
        "message": "再一次，再一次，我将高涨的情绪倾注于指尖，不断重复着抚摸与插入的动作。",
        "text_idx": [
            8137,
            8138
        ]
    },
    {
        "ori": "聞こえるのは、蘭の声と、自分の鼓動。",
        "message": "耳边能听到的，只有兰的声音，和自己的心跳声。",
        "text_idx": [
            8153
        ]
    },
    {
        "name": "蘭",
        "name_idx": 8217,
        "ori": "「んあぁ……あぁぅ……」",
        "message": "「嗯啊……啊呜……」",
        "text_idx": [
            8226
        ]
    },
    {
        "name": "亮",
        "name_idx": 8232,
        "ori": "「蘭！」",
        "message": "「兰！」",
        "text_idx": [
            8241
        ]
    },
    {
        "ori": "昂る気持ちが溢れだし、蘭のそこから指を離す。",
        "message": "高涨的情绪满溢而出，我将手指从兰的私处抽离。",
        "text_idx": [
            8256
        ]
    },
    {
        "ori": "愛液が糸を引き、それをたどるように顔を持っていった。",
        "message": "爱液拉出了一条丝线，我仿佛被其牵引一般，将脸凑了过去。",
        "text_idx": [
            8271
        ]
    },
    {
        "name": "蘭",
        "name_idx": 8335,
        "ori": "「うぅ……亮？」",
        "message": "「呜……亮？」",
        "text_idx": [
            8344
        ]
    },
    {
        "name": "亮",
        "name_idx": 8350,
        "ori": "「ごめん」",
        "message": "「抱歉」",
        "text_idx": [
            8359
        ]
    },
    {
        "ori": "濡れたそこに優しくキスをする。",
        "message": "我温柔地吻上了那片湿润之处。",
        "text_idx": [
            8374
        ]
    },
    {
        "ori": "そして舌でゆっくりと撫で上げた。",
        "message": "接着，我用舌头缓缓地向上舔舐。",
        "text_idx": [
            8389
        ]
    }
]