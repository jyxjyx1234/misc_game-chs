[
    {
        "ori": "午前中の授業が終わり、学園に昼の活気が戻った。",
        "message": "上午的课结束了，校园里恢复了午间的活力。",
        "text_idx": [
            70
        ]
    },
    {
        "ori": "俺は昼もそこそこに、さつきのクラスまで足を運ぶが、そこにはひとり自分の席に座ったまま、ボーッとしている姿があった。",
        "message": "我午饭也草草了事，便赶到纱月的教室，但在那里，我看到她独自一人坐在座位上，茫然发呆的样子。",
        "text_idx": [
            197,
            198,
            199
        ]
    },
    {
        "ori": "何かを……思い詰めたような表情をしている。",
        "message": "脸上是一副……为某事而烦恼不已的表情。",
        "text_idx": [
            214
        ]
    },
    {
        "ori": "俺はさつきに声をかけた。",
        "message": "我叫了纱月一声。",
        "text_idx": [
            229
        ]
    },
    {
        "name": "亮",
        "name_idx": 323,
        "ori": "「さつき……」",
        "message": "「纱月……」",
        "text_idx": [
            332
        ]
    },
    {
        "ori": "さつきは、憔悴したような表情で俺を見上げた。",
        "message": "纱月一脸憔悴地抬头看着我。",
        "text_idx": [
            400
        ]
    },
    {
        "name": "亮",
        "name_idx": 406,
        "ori": "「さつき、『絵』描きにいこう……」",
        "message": "「纱月，我们去画『画』吧……」",
        "text_idx": [
            415
        ]
    },
    {
        "name": "さつき",
        "name_idx": 479,
        "ori": "「……すこし……休憩してるの」",
        "message": "「……我只是……在休息而已」",
        "text_idx": [
            488
        ]
    },
    {
        "name": "亮",
        "name_idx": 494,
        "ori": "「いいから、行こう！」",
        "message": "「别管那么多了，我们走吧！」",
        "text_idx": [
            503
        ]
    },
    {
        "ori": "俺はさつきの腕を掴んだ。",
        "message": "我抓住了纱月的手臂。",
        "text_idx": [
            518
        ]
    },
    {
        "name": "さつき",
        "name_idx": 582,
        "ori": "「いや……っ！」",
        "message": "「不要……！」",
        "text_idx": [
            591
        ]
    },
    {
        "name": "亮",
        "name_idx": 597,
        "ori": "「俺が描きたいんだ、少しつきあってくれ」",
        "message": "「是我想画，你就陪我一下吧」",
        "text_idx": [
            606
        ]
    },
    {
        "name": "さつき",
        "name_idx": 670,
        "ori": "「そんなことしている暇は、わたしには……」",
        "message": "「我没有闲工夫做那种事……」",
        "text_idx": [
            679
        ]
    },
    {
        "name": "亮",
        "name_idx": 685,
        "ori": "「ここで、ボーッとしている暇があるなら、つきあえ！」",
        "message": "「你要是有空在这里发呆，就陪我来！」",
        "text_idx": [
            694
        ]
    },
    {
        "ori": "俺はさつきの腕を掴んで、立ち上がらせた。",
        "message": "我抓住纱月的手臂，让她站了起来。",
        "text_idx": [
            797
        ]
    },
    {
        "name": "亮",
        "name_idx": 803,
        "ori": "「約束しただろう？」",
        "message": "「我们不是约好了吗？」",
        "text_idx": [
            812
        ]
    },
    {
        "name": "さつき",
        "name_idx": 818,
        "ori": "「…………」",
        "message": "「…………」",
        "text_idx": [
            827
        ]
    },
    {
        "name": "亮",
        "name_idx": 833,
        "ori": "「世界中の美術館を回るって……」",
        "message": "「你说要去逛遍全世界的美术馆……」",
        "text_idx": [
            842
        ]
    },
    {
        "name": "さつき",
        "name_idx": 848,
        "ori": "「…………」",
        "message": "「…………」",
        "text_idx": [
            857
        ]
    },
    {
        "name": "亮",
        "name_idx": 863,
        "ori": "「……まずは最初の美術館だ！」",
        "message": "「……首先是第一座美术馆！」",
        "text_idx": [
            872
        ]
    },
    {
        "ori": "俺はさつきを引き連れて、教室を後にした。",
        "message": "我拉着纱月，离开了教室。",
        "text_idx": [
            887
        ]
    }
]