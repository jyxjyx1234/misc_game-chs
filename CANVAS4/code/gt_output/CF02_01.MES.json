[
    {
        "name": "亮",
        "name_idx": 37,
        "ori": "「んん……」",
        "message": "「唔嗯……」",
        "text_idx": [
            46
        ]
    },
    {
        "ori": "懐かしい天井。",
        "message": "令人怀念的天花板。",
        "text_idx": [
            61
        ]
    },
    {
        "ori": "朝日が差し込む窓も、それに照らされる家具も、懐かしく感じる。",
        "message": "阳光照进来的窗户，以及被阳光照亮的家具，都让我感到怀念。",
        "text_idx": [
            76,
            77
        ]
    },
    {
        "ori": "というか、懐かしいを通り越して、それはもう違和感だった。",
        "message": "与其说是怀念，不如说已经是一种违和感了。",
        "text_idx": [
            92,
            93
        ]
    },
    {
        "ori": "本来の自分の部屋なのにこの有様である。",
        "message": "明明是我的房间，却让我感觉如此陌生。",
        "text_idx": [
            108
        ]
    },
    {
        "name": "亮",
        "name_idx": 114,
        "ori": "「ことのの家に慣れ過ぎたな……」",
        "message": "「在琴乃家住得太习惯了啊……」",
        "text_idx": [
            123
        ]
    },
    {
        "ori": "大きく伸びをして、ベッドから降りた。",
        "message": "我伸了个大大的懒腰，从床上下来。",
        "text_idx": [
            138
        ]
    },
    {
        "name": "亮",
        "name_idx": 144,
        "ori": "「ん？」",
        "message": "「嗯？」",
        "text_idx": [
            153
        ]
    },
    {
        "ori": "体が軽い。",
        "message": "身体感觉很轻。",
        "text_idx": [
            168
        ]
    },
    {
        "ori": "しかも心がワクワクする。",
        "message": "而且心情也很雀跃。",
        "text_idx": [
            183
        ]
    },
    {
        "ori": "なぜだろう？",
        "message": "这是为什么呢？",
        "text_idx": [
            198
        ]
    },
    {
        "name": "亮",
        "name_idx": 204,
        "ori": "「ああ……」",
        "message": "「啊啊……」",
        "text_idx": [
            213
        ]
    },
    {
        "ori": "寝起きで少し鈍い頭を数回小突くと、ハッと思い出した。",
        "message": "我轻轻敲了几下刚睡醒还有些迟钝的脑袋，然后猛然想了起来。",
        "text_idx": [
            228
        ]
    },
    {
        "ori": "そういや、昨日、先輩と付き合うことになったんだっけ。",
        "message": "对了，我昨天和学姐开始交往了啊。",
        "text_idx": [
            243
        ]
    },
    {
        "ori": "それに……キスまで……",
        "message": "而且……还接吻了……",
        "text_idx": [
            258
        ]
    },
    {
        "ori": "ついつい顔がにやけてしまう。",
        "message": "我不禁傻笑起来。",
        "text_idx": [
            273
        ]
    },
    {
        "ori": "窓ガラスにぼんやり映るそのだらしない顔に、気を引きしめた。",
        "message": "看到窗玻璃上模糊映出的那张傻笑的脸，我赶紧收敛了表情。",
        "text_idx": [
            288,
            289
        ]
    },
    {
        "name": "亮",
        "name_idx": 295,
        "ori": "「てか、夢だったとかじゃないだろうな」",
        "message": "「话说，这该不会是场梦吧」",
        "text_idx": [
            304
        ]
    },
    {
        "ori": "先輩との映像はしっかり頭に焼き付いてはいるが、現実感がないというか、未だにどこか信じられない自分がいる。",
        "message": "和学姐在一起的画面虽然还清晰地烙印在脑海中，但总感觉没什么真实感，或者说，我至今仍有些不敢相信。",
        "text_idx": [
            319,
            320
        ]
    },
    {
        "ori": "先輩の恋人……",
        "message": "学姐的恋人……",
        "text_idx": [
            335
        ]
    },
    {
        "ori": "夢だろうと現実だろうと、その言葉にまたも顔がだらしなくにやけてしまった。",
        "message": "不管是梦还是现实，一想到这句话，我的脸就又一次不争气地傻笑起来。",
        "text_idx": [
            350,
            351
        ]
    },
    {
        "name": "亮",
        "name_idx": 357,
        "ori": "「いかんいかん」",
        "message": "「不行不行」",
        "text_idx": [
            366
        ]
    },
    {
        "ori": "学校の準備だ。",
        "message": "得准备去学校了。",
        "text_idx": [
            381
        ]
    },
    {
        "name": "ゆう子",
        "name_idx": 717,
        "ori": "「あら、おはよう」",
        "message": "「啊啦，早上好」",
        "text_idx": [
            726
        ]
    },
    {
        "name": "亮",
        "name_idx": 732,
        "ori": "「あ、おはよう」",
        "message": "「啊，早上好」",
        "text_idx": [
            741
        ]
    },
    {
        "name": "ゆう子",
        "name_idx": 805,
        "ori": "「朝食出来てるわよ」",
        "message": "「早饭做好了哦」",
        "text_idx": [
            814
        ]
    },
    {
        "name": "亮",
        "name_idx": 820,
        "ori": "「サンキュー」",
        "message": "「谢啦」",
        "text_idx": [
            829
        ]
    },
    {
        "ori": "食卓に着いて、部屋をぐるりと見渡す。",
        "message": "我坐到餐桌前，环顾了一下房间。",
        "text_idx": [
            1005
        ]
    },
    {
        "ori": "朝食は和食らしく、味噌汁のいい匂いがした。",
        "message": "早餐似乎是和式的，飘来味噌汤的香味。",
        "text_idx": [
            1020
        ]
    },
    {
        "ori": "朝食を持ってくる母さんを眺める。",
        "message": "我注视着端来早餐的妈妈。",
        "text_idx": [
            1035
        ]
    },
    {
        "ori": "この光景がなんかちょっと新鮮で部屋と同じく違和感があった。",
        "message": "这幅光景总觉得有些新鲜，和我的房间一样，有种违和感。",
        "text_idx": [
            1050,
            1051
        ]
    },
    {
        "name": "ゆう子",
        "name_idx": 1231,
        "ori": "「どうしたの？」",
        "message": "「怎么了？」",
        "text_idx": [
            1240
        ]
    },
    {
        "name": "亮",
        "name_idx": 1246,
        "ori": "「いや、なんでも」",
        "message": "「不，没什么」",
        "text_idx": [
            1255
        ]
    },
    {
        "name": "ゆう子",
        "name_idx": 1275,
        "ori": "「そう？」",
        "message": "「是吗？」",
        "text_idx": [
            1284
        ]
    },
    {
        "name": "亮",
        "name_idx": 1290,
        "ori": "「うん」",
        "message": "「嗯」",
        "text_idx": [
            1299
        ]
    },
    {
        "name": "ゆう子",
        "name_idx": 1363,
        "ori": "「でも、なんか顔がにやけてるわよ？」",
        "message": "「不过，你脸上怎么一直在傻笑啊？」",
        "text_idx": [
            1372
        ]
    },
    {
        "name": "亮",
        "name_idx": 1378,
        "ori": "「マジで」",
        "message": "「真的」",
        "text_idx": [
            1387
        ]
    },
    {
        "ori": "さっき引き締めたはずなのにな。",
        "message": "我刚才明明已经收敛表情了啊。",
        "text_idx": [
            1402
        ]
    },
    {
        "ori": "ビンタを入れて、強制的に引き締めた。",
        "message": "我拍打了一下脸颊，强行收敛了表情。",
        "text_idx": [
            1471
        ]
    },
    {
        "name": "ゆう子",
        "name_idx": 1491,
        "ori": "「昨日も帰ってきた時、なんかニヤニヤしてたし学校で何かあったの？」",
        "message": "「你昨天回来的时候，也是一直在傻笑，在学校发生什么事了吗？」",
        "text_idx": [
            1500,
            1501
        ]
    },
    {
        "name": "亮",
        "name_idx": 1507,
        "ori": "「い、いや別に」",
        "message": "「没、没什么」",
        "text_idx": [
            1516
        ]
    },
    {
        "name": "ゆう子",
        "name_idx": 1580,
        "ori": "「はっ！」",
        "message": "「啊！」",
        "text_idx": [
            1589
        ]
    },
    {
        "ori": "目を見開く母さんに、ドキリとした。",
        "message": "看到老妈睁大眼睛的样子，我心里咯噔了一下。",
        "text_idx": [
            1604
        ]
    },
    {
        "name": "亮",
        "name_idx": 1610,
        "ori": "「な、なんだよ！」",
        "message": "「干、干嘛啊！」",
        "text_idx": [
            1619
        ]
    },
    {
        "name": "ゆう子",
        "name_idx": 1683,
        "ori": "「もしかして、いじめ……」",
        "message": "「难道说，是霸凌……」",
        "text_idx": [
            1692
        ]
    },
    {
        "name": "亮",
        "name_idx": 1703,
        "ori": "「なんでだよっ！」",
        "message": "「怎么可能啊！」",
        "text_idx": [
            1712
        ]
    },
    {
        "ori": "青ざめる母さんに、全身でツッコミを入れた。",
        "message": "我用尽全身力气吐槽了脸色发白的老妈。",
        "text_idx": [
            1727
        ]
    },
    {
        "name": "亮",
        "name_idx": 1733,
        "ori": "「てか、いじめられてニヤニヤするとか、どんだけ変態なんだよ」",
        "message": "「再说了，被人霸凌还会傻笑的，那得是多大的变态啊」",
        "text_idx": [
            1742,
            1743
        ]
    },
    {
        "name": "ゆう子",
        "name_idx": 1763,
        "ori": "「亮……」",
        "message": "「亮……」",
        "text_idx": [
            1772
        ]
    },
    {
        "name": "亮",
        "name_idx": 1778,
        "ori": "「その憐れんだ目で見るのはやめていただけませんか」",
        "message": "「能别用那种怜悯的眼神看我吗？」",
        "text_idx": [
            1787
        ]
    },
    {
        "name": "ゆう子",
        "name_idx": 1851,
        "ori": "「それじゃ大丈夫なのね？」",
        "message": "「这么说，你是真的没事了？」",
        "text_idx": [
            1860
        ]
    },
    {
        "name": "亮",
        "name_idx": 1866,
        "ori": "「普通に大丈夫だから」",
        "message": "「我当然没事啊」",
        "text_idx": [
            1875
        ]
    },
    {
        "ori": "やれやれとばかりに、ご飯に箸を運び、味噌汁をすする。",
        "message": "我一副真是的的样子，拿起筷子吃饭，喝起了味噌汤。",
        "text_idx": [
            1890
        ]
    },
    {
        "name": "ゆう子",
        "name_idx": 1954,
        "ori": "「あ、もしかして彼女――」",
        "message": "「啊，难道说是女朋友——」",
        "text_idx": [
            1963
        ]
    },
    {
        "name": "亮",
        "name_idx": 2009,
        "ori": "「ぶっ！」",
        "message": "「噗！」",
        "text_idx": [
            2018
        ]
    },
    {
        "name": "ゆう子",
        "name_idx": 2082,
        "ori": "「きたなーい」",
        "message": "「好脏啊——」",
        "text_idx": [
            2091
        ]
    },
    {
        "name": "亮",
        "name_idx": 2097,
        "ori": "「ごめん、咳とクシャミが同時に出た」",
        "message": "「抱歉，刚才咳嗽跟喷嚏一起来了」",
        "text_idx": [
            2106
        ]
    },
    {
        "name": "ゆう子",
        "name_idx": 2170,
        "ori": "「ふ～ん」",
        "message": "「哦——」",
        "text_idx": [
            2179
        ]
    },
    {
        "name": "亮",
        "name_idx": 2185,
        "ori": "「ああ、そういえば、父さんは？」",
        "message": "「啊，对了，老爸呢？」",
        "text_idx": [
            2194
        ]
    },
    {
        "name": "ゆう子",
        "name_idx": 2214,
        "ori": "「朝早く出かけたわよ」",
        "message": "「他一大早就出门了哦」",
        "text_idx": [
            2223
        ]
    },
    {
        "name": "亮",
        "name_idx": 2229,
        "ori": "「へ、へぇ」",
        "message": "「是、是吗」",
        "text_idx": [
            2238
        ]
    },
    {
        "name": "ゆう子",
        "name_idx": 2302,
        "ori": "「……」",
        "message": "「……」",
        "text_idx": [
            2311
        ]
    },
    {
        "ori": "疑惑の目が痛い。",
        "message": "她怀疑的眼神好刺人。",
        "text_idx": [
            2326
        ]
    },
    {
        "ori": "いやまぁ、先輩とのことは別に隠すことではないけど、なんか、ねぇ？",
        "message": "也不是说我和学姐的事有什么好隐瞒的，但总觉得，有点……对吧？",
        "text_idx": [
            2341,
            2342
        ]
    },
    {
        "name": "ゆう子",
        "name_idx": 2406,
        "ori": "「ことちゃんじゃないの？」",
        "message": "「难道不是小琴吗？」",
        "text_idx": [
            2415
        ]
    },
    {
        "name": "亮",
        "name_idx": 2421,
        "ori": "「はぁ？」",
        "message": "「哈？」",
        "text_idx": [
            2430
        ]
    },
    {
        "name": "ゆう子",
        "name_idx": 2494,
        "ori": "「んー」",
        "message": "「唔—」",
        "text_idx": [
            2503
        ]
    },
    {
        "ori": "考え込んでいる間に、一気にご飯を掻き込む。",
        "message": "我趁着她陷入沉思的空当，一口气扒完了饭。",
        "text_idx": [
            2518
        ]
    },
    {
        "ori": "むせながらも、お茶で無理矢理飲み下し席を立った。",
        "message": "虽然呛到了，但我还是就着茶水硬咽了下去，然后站起了身。",
        "text_idx": [
            2709
        ]
    },
    {
        "name": "亮",
        "name_idx": 2743,
        "ori": "「じゃ、俺、行くわ！」",
        "message": "「那我先走了！」",
        "text_idx": [
            2752
        ]
    },
    {
        "name": "ゆう子",
        "name_idx": 2860,
        "ori": "「あ、ちょっと！」",
        "message": "「啊，等一下！」",
        "text_idx": [
            2869
        ]
    },
    {
        "name": "亮",
        "name_idx": 2875,
        "ori": "「今日もちょっと遅くなるからー！」",
        "message": "「我今天也会晚点回来的——！」",
        "text_idx": [
            2884
        ]
    },
    {
        "name": "ゆう子",
        "name_idx": 2904,
        "ori": "「今度紹介してよー」",
        "message": "「下次介绍给我认识啊——」",
        "text_idx": [
            2913
        ]
    },
    {
        "name": "亮",
        "name_idx": 2919,
        "ori": "「行ってきます」",
        "message": "「我出门了」",
        "text_idx": [
            2928
        ]
    },
    {
        "name": "亮",
        "name_idx": 3114,
        "ori": "「ふぅ……」",
        "message": "「呼……」",
        "text_idx": [
            3123
        ]
    },
    {
        "ori": "朝から体力を消費し過ぎたな。",
        "message": "我一大早就消耗了太多体力啊。",
        "text_idx": [
            3138
        ]
    },
    {
        "ori": "母さんと顔を合わせるたびに、毎回こんなことにならない事を祈るよ。本気で。",
        "message": "我真心祈祷，以后每次和老妈见面时都不会变成这样。",
        "text_idx": [
            3153,
            3154
        ]
    },
    {
        "ori": "まあでも……",
        "message": "不过嘛……",
        "text_idx": [
            3169
        ]
    },
    {
        "ori": "こういうふうに母さんと接することができるようになって良かったと思う。",
        "message": "能够像这样和老妈相处，我觉得也挺好的。",
        "text_idx": [
            3229,
            3230
        ]
    },
    {
        "ori": "そのうちウザくなるかもしれないけど。",
        "message": "虽然之后或许会觉得烦就是了。",
        "text_idx": [
            3245
        ]
    },
    {
        "ori": "本当に……良かったと思う。",
        "message": "我真的……觉得这样很好。",
        "text_idx": [
            3260
        ]
    },
    {
        "name": "亮",
        "name_idx": 3364,
        "ori": "「ことの、もう準備できてるかな？」",
        "message": "「琴乃，你已经准备好了吗？」",
        "text_idx": [
            3373
        ]
    },
    {
        "ori": "インターフォンを押すと、それに反応するように中からドタドタと慌ただしい音が響いてくる。",
        "message": "我按下门铃后，里面仿佛有所回应似的，传来一阵噔噔噔的慌乱声响。",
        "text_idx": [
            3446,
            3447
        ]
    },
    {
        "ori": "そして待つこと数秒。",
        "message": "就这样等了数秒。",
        "text_idx": [
            3462
        ]
    },
    {
        "name": "ことの",
        "name_idx": 3568,
        "ori": "「まっふぁ」",
        "message": "「嗯唔啊」",
        "text_idx": [
            3577
        ]
    },
    {
        "ori": "パンをくわえたことのが飛び出してきた。",
        "message": "叼着面包的琴乃冲了出来。",
        "text_idx": [
            3592
        ]
    },
    {
        "name": "亮",
        "name_idx": 3598,
        "ori": "「ああ俺、パンくわえて飛び出てくる人初めて見たわ」",
        "message": "「啊啊，我还是第一次见到叼着面包冲出来的人啊」",
        "text_idx": [
            3607
        ]
    },
    {
        "name": "ことの",
        "name_idx": 3627,
        "ori": "「ひょっとまっへ」",
        "message": "「等唔一下」",
        "text_idx": [
            3636
        ]
    },
    {
        "ori": "もぐもぐとパンを口の中へ押し込んでいくことの。",
        "message": "琴乃狼吞虎咽地把面包往嘴里塞。",
        "text_idx": [
            3651
        ]
    },
    {
        "ori": "頬袋のようにほっぺを膨らませて、最後にはゴクンと一気に飲み込んでいた。",
        "message": "琴乃的脸颊鼓得像仓鼠的颊囊一样，最后咕咚一声全都咽了下去。",
        "text_idx": [
            3666,
            3667
        ]
    },
    {
        "name": "ことの",
        "name_idx": 3833,
        "ori": "「さっぱりさっぱり」",
        "message": "「搞定搞定」",
        "text_idx": [
            3842
        ]
    },
    {
        "name": "亮",
        "name_idx": 3848,
        "ori": "「……」",
        "message": "「……」",
        "text_idx": [
            3857
        ]
    },
    {
        "ori": "ただただ唖然。",
        "message": "我看得目瞪口呆。",
        "text_idx": [
            3872
        ]
    },
    {
        "name": "ことの",
        "name_idx": 3964,
        "ori": "「りょうちゃん？」",
        "message": "「小亮？」",
        "text_idx": [
            3973
        ]
    },
    {
        "name": "亮",
        "name_idx": 3979,
        "ori": "「いろいろ突っ込みたいけど、取り敢えず、朝はもう少し余裕を持とうな」",
        "message": "「虽然我有很多地方想吐槽，但总之，早上还是多留点时间吧」",
        "text_idx": [
            3988,
            3989
        ]
    },
    {
        "name": "ことの",
        "name_idx": 4053,
        "ori": "「今日は頑張って起きた方なんだけどなぁ」",
        "message": "「我今天已经算是很努力早起的了呢」",
        "text_idx": [
            4062
        ]
    },
    {
        "name": "亮",
        "name_idx": 4068,
        "ori": "「まあ……確かに、ことのにしては早かったな」",
        "message": "「哎……说得也是，对琴乃你来说已经算早的了」",
        "text_idx": [
            4077
        ]
    },
    {
        "name": "ことの",
        "name_idx": 4141,
        "ori": "「でしょ？」",
        "message": "「对吧？」",
        "text_idx": [
            4150
        ]
    },
    {
        "name": "亮",
        "name_idx": 4156,
        "ori": "「そしてあの人を超越したようなパン食いの速さ……」",
        "message": "「还有那超越常人般的吃面包速度……」",
        "text_idx": [
            4165
        ]
    },
    {
        "name": "亮",
        "name_idx": 4171,
        "ori": "「はっ、お前、ことのじゃないな！　地球を侵略しに来た宇宙人だろ！」",
        "message": "「哈！你不是琴乃！　你是来侵略地球的外星人吧！」",
        "text_idx": [
            4180,
            4181
        ]
    },
    {
        "name": "ことの",
        "name_idx": 4245,
        "ori": "「なんのこっちゃ」",
        "message": "「你在说什么啊」",
        "text_idx": [
            4254
        ]
    },
    {
        "name": "ことの",
        "name_idx": 4577,
        "ori": "「お母さんとは、どう？」",
        "message": "「和妈妈的关系怎么样了？」",
        "text_idx": [
            4586
        ]
    },
    {
        "name": "亮",
        "name_idx": 4592,
        "ori": "「まあまあかな」",
        "message": "「还行吧」",
        "text_idx": [
            4601
        ]
    },
    {
        "name": "ことの",
        "name_idx": 4621,
        "ori": "「よかったね」",
        "message": "「太好了呢」",
        "text_idx": [
            4630
        ]
    },
    {
        "name": "亮",
        "name_idx": 4636,
        "ori": "「ありがと」",
        "message": "「谢谢」",
        "text_idx": [
            4645
        ]
    },
    {
        "ori": "隣を歩いていることのが、柄にもなく感慨深げな顔をした。",
        "message": "走在我身旁的琴乃，一反常态地露出了感慨万千的表情。",
        "text_idx": [
            4660,
            4661
        ]
    },
    {
        "name": "ことの",
        "name_idx": 4749,
        "ori": "「こうやってどんどん、変わっていくんだろうねぇ」",
        "message": "「就这样，一切都在不断地改变呢」",
        "text_idx": [
            4758
        ]
    },
    {
        "name": "亮",
        "name_idx": 4764,
        "ori": "「ことの？」",
        "message": "「琴乃？」",
        "text_idx": [
            4773
        ]
    },
    {
        "name": "ことの",
        "name_idx": 4793,
        "ori": "「芸術祭、文化祭も終わっちゃったし、もうすっかり寒くなっちゃったし」",
        "message": "「艺术节、文化节也都结束了，天气也已经完全变冷了」",
        "text_idx": [
            4802,
            4803
        ]
    },
    {
        "name": "亮",
        "name_idx": 4809,
        "ori": "「そうだなぁ」",
        "message": "「是啊」",
        "text_idx": [
            4818
        ]
    },
    {
        "name": "ことの",
        "name_idx": 4838,
        "ori": "「中間試験の結果も返ってくるし……はぁ」",
        "message": "「期中考试的成绩也要发下来了……唉」",
        "text_idx": [
            4847
        ]
    },
    {
        "ori": "憂鬱そうに言うことのの溜息は、微かに白く残った。",
        "message": "琴乃忧郁地叹出的气，在空中留下了一抹淡淡的白雾。",
        "text_idx": [
            4862
        ]
    },
    {
        "name": "亮",
        "name_idx": 4868,
        "ori": "「あれ、今日返ってくるの？」",
        "message": "「啊咧，今天要发下来吗？」",
        "text_idx": [
            4877
        ]
    },
    {
        "name": "ことの",
        "name_idx": 4897,
        "ori": "「そうだよ。全部じゃないけど」",
        "message": "「是啊。虽然不是全部啦」",
        "text_idx": [
            4906
        ]
    },
    {
        "name": "亮",
        "name_idx": 4912,
        "ori": "「うわぁ」",
        "message": "「呜哇」",
        "text_idx": [
            4921
        ]
    },
    {
        "name": "ことの",
        "name_idx": 4941,
        "ori": "「今回自信ないんだよね……」",
        "message": "「这次我没什么自信呢……」",
        "text_idx": [
            4950
        ]
    },
    {
        "name": "亮",
        "name_idx": 4956,
        "ori": "「右に同じ……」",
        "message": "「我也是……」",
        "text_idx": [
            4965
        ]
    },
    {
        "ori": "同時につく溜息は、白く空気を刻んですぐに消えた。",
        "message": "我们同时发出的叹息化作白气，在空中一闪而逝。",
        "text_idx": [
            4980
        ]
    },
    {
        "name": "智継",
        "name_idx": 5156,
        "ori": "「よう！」",
        "message": "「哟！」",
        "text_idx": [
            5165
        ]
    },
    {
        "name": "亮",
        "name_idx": 5171,
        "ori": "「おう、智継、おはよう」",
        "message": "「噢，智继，早上好」",
        "text_idx": [
            5180
        ]
    },
    {
        "name": "智継",
        "name_idx": 5200,
        "ori": "「おはよ」",
        "message": "「早啊」",
        "text_idx": [
            5209
        ]
    },
    {
        "name": "ことの",
        "name_idx": 5273,
        "ori": "「おはよう」",
        "message": "「早上好」",
        "text_idx": [
            5282
        ]
    },
    {
        "name": "智継",
        "name_idx": 5346,
        "ori": "「くっ……」",
        "message": "「唔……」",
        "text_idx": [
            5355
        ]
    },
    {
        "ori": "智継は俺とことのを交互に見やって歯ぎしりした。",
        "message": "智继交替地看着我和琴乃，咬牙切齿。",
        "text_idx": [
            5370
        ]
    },
    {
        "name": "智継",
        "name_idx": 5390,
        "ori": "「朝から女をはべらせやがって……」",
        "message": "「大清早就让女人陪着……」",
        "text_idx": [
            5399
        ]
    },
    {
        "name": "亮",
        "name_idx": 5405,
        "ori": "「なんだよいきなり」",
        "message": "「你突然说什么呢」",
        "text_idx": [
            5414
        ]
    },
    {
        "name": "智継",
        "name_idx": 5434,
        "ori": "「俺にもちっとは分けろよなぁ」",
        "message": "「也分我一点啊」",
        "text_idx": [
            5443
        ]
    },
    {
        "name": "亮",
        "name_idx": 5449,
        "ori": "「なにを？」",
        "message": "「分什么？」",
        "text_idx": [
            5458
        ]
    },
    {
        "name": "智継",
        "name_idx": 5522,
        "ori": "「あ～あ、なんでお前はモテて俺はモテないんだろうな。顔は別に悪くないだろ？」",
        "message": "「唉，为什么你就那么受欢迎，我却一点都不受欢迎呢。我的脸长得也不算差吧？」",
        "text_idx": [
            5531,
            5532
        ]
    },
    {
        "name": "亮",
        "name_idx": 5538,
        "ori": "「俺に聞かれても」",
        "message": "「你问我我也不知道啊」",
        "text_idx": [
            5547
        ]
    },
    {
        "name": "智継",
        "name_idx": 5611,
        "ori": "「ことのちゃん、俺、顔悪くないだろ？　むしろ格好いいだろ？　二枚目だろ？」",
        "message": "「小琴乃，我的脸不差吧？　应该说很帅对吧？　是个帅哥吧？」",
        "text_idx": [
            5620,
            5621
        ]
    },
    {
        "ori": "智継は真剣だった。",
        "message": "智继一脸认真。",
        "text_idx": [
            5636
        ]
    },
    {
        "name": "ことの",
        "name_idx": 5656,
        "ori": "「ん～」",
        "message": "「嗯～」",
        "text_idx": [
            5665
        ]
    },
    {
        "name": "智継",
        "name_idx": 5729,
        "ori": "「ゴクリ」",
        "message": "「咕嘟」",
        "text_idx": [
            5738
        ]
    },
    {
        "name": "ことの",
        "name_idx": 5802,
        "ori": "「ウーパールーパーみたい」",
        "message": "「像六角恐龙一样」",
        "text_idx": [
            5811
        ]
    },
    {
        "name": "智継",
        "name_idx": 5831,
        "ori": "「……ワンモアプリーズ」",
        "message": "「……请再说一遍」",
        "text_idx": [
            5840
        ]
    },
    {
        "name": "ことの",
        "name_idx": 5860,
        "ori": "「ウーパールーパ―みたい」",
        "message": "「像六角恐龙一样」",
        "text_idx": [
            5869
        ]
    },
    {
        "name": "智継",
        "name_idx": 5933,
        "ori": "「待ってくれ……」",
        "message": "「等一下……」",
        "text_idx": [
            5942
        ]
    },
    {
        "ori": "智継は少し混乱した様子で頭を押さえた。",
        "message": "智继有些混乱地按住了头。",
        "text_idx": [
            5957
        ]
    },
    {
        "name": "智継",
        "name_idx": 6021,
        "ori": "「……それはどういう意味なんだ？」",
        "message": "「……这是什么意思？」",
        "text_idx": [
            6030
        ]
    },
    {
        "name": "亮",
        "name_idx": 6036,
        "ori": "「褒めてるんだよ」",
        "message": "「她是在夸你呢」",
        "text_idx": [
            6045
        ]
    },
    {
        "name": "智継",
        "name_idx": 6109,
        "ori": "「いやいやいや！　どこをどう解釈したら、ウーパールーパ―が褒め言葉になるんだよ！」",
        "message": "「不不不！　再怎么解释，六角恐龙也算不上是夸人的话吧！」",
        "text_idx": [
            6118,
            6119
        ]
    },
    {
        "name": "亮",
        "name_idx": 6125,
        "ori": "「ウーパールーパーみたいに可愛いってことだよな、ことの？」",
        "message": "「意思是说你像六角恐龙一样可爱，对吧，琴乃？」",
        "text_idx": [
            6134,
            6135
        ]
    },
    {
        "name": "ことの",
        "name_idx": 6199,
        "ori": "「うん」",
        "message": "「嗯」",
        "text_idx": [
            6208
        ]
    },
    {
        "name": "智継",
        "name_idx": 6388,
        "ori": "「わかりにくッ！」",
        "message": "「也太难懂了吧！」",
        "text_idx": [
            6397
        ]
    },
    {
        "name": "智継",
        "name_idx": 6461,
        "ori": "「てか、ウーパールーパ―みたいに可愛いって言われても嬉しくないんだけど！」",
        "message": "「再说了，就算被夸像六角恐龙一样可爱我也一点都高兴不起来啊！」",
        "text_idx": [
            6470,
            6471
        ]
    },
    {
        "name": "ことの",
        "name_idx": 6535,
        "ori": "「じゃあ、カモノハシみたいに可愛い」",
        "message": "「那你就像鸭嘴兽一样可爱」",
        "text_idx": [
            6544
        ]
    },
    {
        "name": "亮",
        "name_idx": 6550,
        "ori": "「やったな、智継」",
        "message": "「太好了呢，智继」",
        "text_idx": [
            6559
        ]
    },
    {
        "name": "智継",
        "name_idx": 6623,
        "ori": "「わーいわーい。嬉しいなー」",
        "message": "「好耶好耶。我真开心啊—」",
        "text_idx": [
            6632
        ]
    },
    {
        "ori": "目が死んでいた。",
        "message": "他的眼神死了。",
        "text_idx": [
            6647
        ]
    },
    {
        "name": "亮",
        "name_idx": 6653,
        "ori": "「そうそう智継、今日テスト返ってくるらしいよ」",
        "message": "「对了对了智继，听说今天发考试卷哦」",
        "text_idx": [
            6662
        ]
    },
    {
        "name": "智継",
        "name_idx": 6736,
        "ori": "「わーいわーい。嬉しいなー」",
        "message": "「好耶好耶。我真开心啊—」",
        "text_idx": [
            6745
        ]
    },
    {
        "ori": "足がガクガク震えていた。",
        "message": "他的双腿在不停地发抖。",
        "text_idx": [
            6760
        ]
    },
    {
        "name": "ことの",
        "name_idx": 6824,
        "ori": "「智継くん、自信あるみたいだね」",
        "message": "「智继君，你好像很有自信呢」",
        "text_idx": [
            6833
        ]
    },
    {
        "name": "亮",
        "name_idx": 6839,
        "ori": "「さすがカモノハシ」",
        "message": "「真不愧是鸭嘴兽」",
        "text_idx": [
            6848
        ]
    },
    {
        "name": "智継",
        "name_idx": 7072,
        "ori": "「誰がカモノハシだぁあッ！」",
        "message": "「谁是鸭嘴兽啊！」",
        "text_idx": [
            7081
        ]
    },
    {
        "ori": "叫ぶ智継に登校中の生徒たちの視線が集まる。",
        "message": "正在上学路上的学生们的视线都集中到了大喊大叫的智继身上。",
        "text_idx": [
            7096
        ]
    },
    {
        "ori": "それで我に返った智継は咳払いをして、すがすがしい顔をした。",
        "message": "回过神来的智继清了清嗓子，露出一副神清气爽的表情。",
        "text_idx": [
            7111,
            7112
        ]
    },
    {
        "name": "智継",
        "name_idx": 7176,
        "ori": "「ま、イケメンの俺は勉学もできて当たり前だからね！」",
        "message": "「嘛，像我这种帅哥，学习好也是理所当然的啦！」",
        "text_idx": [
            7185
        ]
    },
    {
        "name": "ことの",
        "name_idx": 7205,
        "ori": "「へぇ」",
        "message": "「哦」",
        "text_idx": [
            7214
        ]
    },
    {
        "name": "智継",
        "name_idx": 7278,
        "ori": "「取り敢えず、名前しっかり書いたから大丈夫さ！」",
        "message": "「总之，我把名字好好写上去了，所以没问题！」",
        "text_idx": [
            7287
        ]
    },
    {
        "name": "亮",
        "name_idx": 7293,
        "ori": "「仲間だな」",
        "message": "「是同伴呢」",
        "text_idx": [
            7302
        ]
    },
    {
        "name": "智継",
        "name_idx": 7366,
        "ori": "「ふふ、だろ。イケメン同士仲良くしようぜ」",
        "message": "「呵呵，对吧。我们帅哥之间就好好相处吧」",
        "text_idx": [
            7375
        ]
    },
    {
        "name": "亮",
        "name_idx": 7381,
        "ori": "「言うんじゃなかった」",
        "message": "「真不该说出口的」",
        "text_idx": [
            7390
        ]
    },
    {
        "name": "智継",
        "name_idx": 7454,
        "ori": "「なんでだよ」",
        "message": "「为什么啊？」",
        "text_idx": [
            7463
        ]
    },
    {
        "name": "紬",
        "name_idx": 7483,
        "ori": "「みなさん、おはようございます」",
        "message": "「各位，早上好」",
        "text_idx": [
            7492
        ]
    },
    {
        "ori": "振り向くと、先輩がニコニコと微笑んで立っていた。",
        "message": "我一回头，便看见学姐正笑盈盈地站在那里。",
        "text_idx": [
            8107
        ]
    },
    {
        "ori": "心拍が跳ね上がる。",
        "message": "我的心跳猛地加速。",
        "text_idx": [
            8122
        ]
    },
    {
        "name": "紬",
        "name_idx": 8186,
        "ori": "「朝から楽しそうですね」",
        "message": "「大家一大早就聊得很开心呢」",
        "text_idx": [
            8195
        ]
    },
    {
        "name": "智継",
        "name_idx": 8466,
        "ori": "「鷺ノ宮先輩！？　お、おはようございます！」",
        "message": "「鹭之宫前辈！？　早、早上好！」",
        "text_idx": [
            8475
        ]
    },
    {
        "name": "ことの",
        "name_idx": 8637,
        "ori": "「おはようございます！」",
        "message": "「早上好！」",
        "text_idx": [
            8646
        ]
    },
    {
        "name": "紬",
        "name_idx": 8787,
        "ori": "「はい、おはようございます」",
        "message": "「嗯，早上好」",
        "text_idx": [
            8796
        ]
    },
    {
        "name": "亮",
        "name_idx": 8802,
        "ori": "「先輩……」",
        "message": "「学姐……」",
        "text_idx": [
            8811
        ]
    },
    {
        "ori": "昨日の事が夢じゃなければ、俺と鷺ノ宮先輩は、その……恋人というわけで。",
        "message": "如果昨天的事不是梦的话，我和鹭之宫前辈，那个……就算得上是情侣了。",
        "text_idx": [
            8826,
            8827
        ]
    },
    {
        "ori": "挨拶するのも恥ずかしくて、あたふたしてしていると、鷺ノ宮先輩は俺に微笑みかけてきた。",
        "message": "我害羞得连招呼都打不出口，正手足无措时，鹭之宫前辈对我露出了微笑。",
        "text_idx": [
            8842,
            8843
        ]
    },
    {
        "name": "紬",
        "name_idx": 8931,
        "ori": "「せっかくお付き合いすることになりましたのに、先輩と呼ばれるのも何だかさびしいですわね」",
        "message": "「我们好不容易才开始交往，还被称呼为前辈，总觉得有些生分呢」",
        "text_idx": [
            8940,
            8941
        ]
    },
    {
        "name": "智継",
        "name_idx": 9005,
        "ori": "「そうだぞ、亮。せっかくお付き合いするんだから………って、えぇ？？」",
        "message": "「就是啊，亮。好不容易才开始交往……啊，诶？？」",
        "text_idx": [
            9014,
            9015
        ]
    },
    {
        "name": "ことの",
        "name_idx": 9093,
        "ori": "「おつきあい？？」",
        "message": "「交往？？」",
        "text_idx": [
            9102
        ]
    },
    {
        "ori": "ことのと智継の表情が固まる。",
        "message": "琴乃和智继的表情僵住了。",
        "text_idx": [
            9117
        ]
    },
    {
        "name": "紬",
        "name_idx": 9249,
        "ori": "「はい。私、小松原君とお付き合いすることになりましたの」",
        "message": "「是的。我，和小松原同学开始交往了哦」",
        "text_idx": [
            9258,
            9259
        ]
    },
    {
        "ori": "ああ、さすが先輩。堂々としていらっしゃる……",
        "message": "啊啊，真不愧是学姐。如此镇定自若……",
        "text_idx": [
            9274
        ]
    },
    {
        "name": "智継",
        "name_idx": 9294,
        "ori": "「ま、マジでぇえ！？？」",
        "message": "「真、真的假的啊！？？」",
        "text_idx": [
            9303
        ]
    },
    {
        "name": "ことの",
        "name_idx": 9323,
        "ori": "「亮ちゃん、それホント！？」",
        "message": "「小亮，那是真的吗！？」",
        "text_idx": [
            9332
        ]
    },
    {
        "name": "亮",
        "name_idx": 9338,
        "ori": "「あー……ホントです」",
        "message": "「啊—……是真的」",
        "text_idx": [
            9347
        ]
    },
    {
        "name": "ことの",
        "name_idx": 9367,
        "ori": "「ほへぇ」",
        "message": "「嚯诶」",
        "text_idx": [
            9376
        ]
    },
    {
        "ori": "口にして頷くと妙に現実感が湧いて恥ずかしくなった。",
        "message": "亲口承认这件事后，我突然有了实感，不禁害羞起来。",
        "text_idx": [
            9391
        ]
    },
    {
        "ori": "俺は鷺ノ宮先輩と付き合うことになったんだなぁ。",
        "message": "我真的和鹭之宫前辈开始交往了啊。",
        "text_idx": [
            9406
        ]
    },
    {
        "name": "智継",
        "name_idx": 9426,
        "ori": "「と、とうとうやりやがったな……」",
        "message": "「你、你终究还是得手了啊……」",
        "text_idx": [
            9435
        ]
    },
    {
        "name": "亮",
        "name_idx": 9441,
        "ori": "「なにをだよ」",
        "message": "「你说什么呢」",
        "text_idx": [
            9450
        ]
    },
    {
        "name": "智継",
        "name_idx": 9470,
        "ori": "「俺というものがありながら……えぐえぐ」",
        "message": "「明明还有我呢……呜呜」",
        "text_idx": [
            9479
        ]
    },
    {
        "name": "亮",
        "name_idx": 9485,
        "ori": "「ハンカチ噛みながら泣くなよ」",
        "message": "「别一边咬着手帕一边哭啊」",
        "text_idx": [
            9494
        ]
    },
    {
        "name": "紬",
        "name_idx": 9514,
        "ori": "「小松原くん」",
        "message": "「小松原同学」",
        "text_idx": [
            9523
        ]
    },
    {
        "name": "亮",
        "name_idx": 9529,
        "ori": "「は、はい」",
        "message": "「啊、好的」",
        "text_idx": [
            9538
        ]
    },
    {
        "name": "紬",
        "name_idx": 9558,
        "ori": "「これからは私のこと、先輩ではなく、紬と呼んでいただけませんか？」",
        "message": "「从今以后，可以请你不要叫我学姐，而是叫我紬吗？」",
        "text_idx": [
            9567,
            9568
        ]
    },
    {
        "name": "亮",
        "name_idx": 9574,
        "ori": "「つ、紬……ですか！？」",
        "message": "「紬、紬……吗！？」",
        "text_idx": [
            9583
        ]
    },
    {
        "name": "紬",
        "name_idx": 9603,
        "ori": "「はい。私も小松原くんのことを亮くんと呼びますので」",
        "message": "「是的。我也会称呼小松原同学为亮的」",
        "text_idx": [
            9612
        ]
    },
    {
        "name": "智継",
        "name_idx": 9632,
        "ori": "「キィイイイ！！」",
        "message": "「呀啊啊啊！！」",
        "text_idx": [
            9641
        ]
    },
    {
        "name": "亮",
        "name_idx": 9647,
        "ori": "「うるさい」",
        "message": "「吵死了」",
        "text_idx": [
            9656
        ]
    },
    {
        "name": "紬",
        "name_idx": 9676,
        "ori": "「かまいませんか？」",
        "message": "「可以吗？」",
        "text_idx": [
            9685
        ]
    },
    {
        "ori": "名前で呼び合うなんて、本格的に恋人同士だなぁ。",
        "message": "互相直呼其名，感觉真的就像情侣一样了啊。",
        "text_idx": [
            9700
        ]
    },
    {
        "ori": "しかし、いきなり呼び捨てで呼べるかな……",
        "message": "不过，突然要我直呼其名，我能做到吗……",
        "text_idx": [
            9715
        ]
    },
    {
        "name": "亮",
        "name_idx": 9721,
        "ori": "「せ、せめて、さん、付けていいですか？」",
        "message": "「至、至少，我能叫你紬同学吗？」",
        "text_idx": [
            9730
        ]
    },
    {
        "name": "紬",
        "name_idx": 9750,
        "ori": "「んー……仕方ないですわね」",
        "message": "「嗯……真是拿你没办法呢」",
        "text_idx": [
            9759
        ]
    },
    {
        "name": "紬",
        "name_idx": 9779,
        "ori": "「じゃあ、練習してみましょう」",
        "message": "「那么，我们来练习一下吧」",
        "text_idx": [
            9788
        ]
    },
    {
        "name": "亮",
        "name_idx": 9794,
        "ori": "「ここでですか？」",
        "message": "「在这里吗？」",
        "text_idx": [
            9803
        ]
    },
    {
        "name": "紬",
        "name_idx": 9823,
        "ori": "「はい、ぜひ！」",
        "message": "「是的，务必！」",
        "text_idx": [
            9832
        ]
    },
    {
        "ori": "先輩……じゃなくて、紬さんはキラキラした瞳で待ち構えている。",
        "message": "学姐……不对，紬同学正用闪闪发光的眼睛等着我。",
        "text_idx": [
            9847,
            9848
        ]
    },
    {
        "ori": "周囲を見渡す。",
        "message": "我环顾四周。",
        "text_idx": [
            9863
        ]
    },
    {
        "ori": "智継はハンカチを噛んでキーキー言っていて、ことのは、ほへぇと呆然としている。",
        "message": "智继咬着手帕叽叽叫，而琴乃，则是一脸茫然。",
        "text_idx": [
            9878,
            9879
        ]
    },
    {
        "ori": "その他にも、登校中の生徒がなんだなんだとこちらを覗いてきていた。",
        "message": "此外，其他正在上学的学生也好奇地朝我们这边张望。",
        "text_idx": [
            9894,
            9895
        ]
    },
    {
        "ori": "先――ではなく、紬さんは目立つもんなぁ。",
        "message": "学——不对，紬同学真的很引人注目啊。",
        "text_idx": [
            9910
        ]
    },
    {
        "ori": "恥ずかしさを散らすように咳払い。",
        "message": "我为了驱散这份丢人感，清了清嗓子。",
        "text_idx": [
            9925
        ]
    },
    {
        "name": "亮",
        "name_idx": 9931,
        "ori": "「あーゴホン」",
        "message": "「啊—咳哼」",
        "text_idx": [
            9940
        ]
    },
    {
        "name": "紬",
        "name_idx": 9960,
        "ori": "「わくわく」",
        "message": "「期待期待」",
        "text_idx": [
            9969
        ]
    },
    {
        "name": "亮",
        "name_idx": 9975,
        "ori": "「つ……紬さん！」",
        "message": "「紬……紬同学！」",
        "text_idx": [
            9984
        ]
    },
    {
        "name": "紬",
        "name_idx": 10004,
        "ori": "「はい。亮くん」",
        "message": "「嗯。亮君」",
        "text_idx": [
            10013
        ]
    },
    {
        "name": "智継",
        "name_idx": 10033,
        "ori": "「キィイイイイイイイイッ！」",
        "message": "「呀——！」",
        "text_idx": [
            10042
        ]
    },
    {
        "name": "ことの",
        "name_idx": 10062,
        "ori": "「ほへぇ」",
        "message": "「嚯诶」",
        "text_idx": [
            10071
        ]
    },
    {
        "name": "紬",
        "name_idx": 10091,
        "ori": "「ふふ、亮くん」",
        "message": "「呵呵，亮君」",
        "text_idx": [
            10100
        ]
    },
    {
        "ori": "紬さんはくすぐったそうに笑って、俺の手を握ってきた。",
        "message": "紬同学害羞地笑着，握住了我的手。",
        "text_idx": [
            10115
        ]
    },
    {
        "name": "亮",
        "name_idx": 10121,
        "ori": "「先輩！？」",
        "message": "「学姐！？」",
        "text_idx": [
            10130
        ]
    },
    {
        "name": "紬",
        "name_idx": 10150,
        "ori": "「あ、ちがうでしょう」",
        "message": "「啊，不对哦」",
        "text_idx": [
            10159
        ]
    },
    {
        "name": "亮",
        "name_idx": 10165,
        "ori": "「つ、紬さん……」",
        "message": "「紬、紬小姐……」",
        "text_idx": [
            10174
        ]
    },
    {
        "name": "紬",
        "name_idx": 10194,
        "ori": "「うふふ」",
        "message": "「呜呼呼」",
        "text_idx": [
            10203
        ]
    },
    {
        "ori": "ヤバい周りの視線が集まってくる。",
        "message": "糟了，周围的视线都聚集过来了。",
        "text_idx": [
            10218
        ]
    },
    {
        "ori": "智継からの視線はもはや殺意がこもっていた。",
        "message": "智继的视线里，已经充满了杀意。",
        "text_idx": [
            10233
        ]
    },
    {
        "name": "亮",
        "name_idx": 10239,
        "ori": "「それで、どうして俺の手を握られてるんでしょうか？」",
        "message": "「所以说，你为什么要握着我的手呢？」",
        "text_idx": [
            10248
        ]
    },
    {
        "name": "紬",
        "name_idx": 10268,
        "ori": "「決まっているでしょう？　学園での恋愛と言えば、手を繋いでの登校です」",
        "message": "「这还用问吗？　说到校园恋爱，当然就是手牵手一起上学了」",
        "text_idx": [
            10277,
            10278
        ]
    },
    {
        "name": "亮",
        "name_idx": 10284,
        "ori": "「はぁ……」",
        "message": "「唉……」",
        "text_idx": [
            10293
        ]
    },
    {
        "ori": "紬さんはどこか夢見るような顔をしていた。",
        "message": "紬同学脸上带着几分陶醉的神情。",
        "text_idx": [
            10308
        ]
    },
    {
        "name": "紬",
        "name_idx": 10328,
        "ori": "「それでは行きましょう！」",
        "message": "「那我们走吧！」",
        "text_idx": [
            10337
        ]
    },
    {
        "name": "亮",
        "name_idx": 10343,
        "ori": "「おとととっ！」",
        "message": "「喔喔喔！」",
        "text_idx": [
            10352
        ]
    },
    {
        "ori": "軽快に走りだした紬さんに引っ張られるようにして付いていく。",
        "message": "我被轻快地跑起来的紬同学拉着，跟了上去。",
        "text_idx": [
            10455,
            10456
        ]
    },
    {
        "name": "智継",
        "name_idx": 10476,
        "ori": "「キィイイイ！」",
        "message": "「哇——！」",
        "text_idx": [
            10485
        ]
    },
    {
        "name": "ことの",
        "name_idx": 10505,
        "ori": "「ほへぇ」",
        "message": "「嚯诶」",
        "text_idx": [
            10514
        ]
    },
    {
        "ori": "二人に見送られ、登校中の生徒たちの視線を集めながら俺と紬さんは校舎へ向かう。",
        "message": "在他们两人的目送下，我和紬同学一边吸引着上学途中的学生们的视线，一边走向校舍。",
        "text_idx": [
            10529,
            10530
        ]
    },
    {
        "ori": "羞恥心で一杯になるが、俺の手を握る紬さんを見るととても楽しそうで、まあいいかと思う。",
        "message": "我内心充满了羞耻感，但看到握着我手的紬同学那副非常开心的样子，又觉得这样也挺好的。",
        "text_idx": [
            10545,
            10546
        ]
    },
    {
        "name": "亮",
        "name_idx": 10729,
        "ori": "「もうそろそろ手、離しませんか？」",
        "message": "「我们差不多该松手了吧？」",
        "text_idx": [
            10738
        ]
    },
    {
        "name": "紬",
        "name_idx": 10846,
        "ori": "「そうですね」",
        "message": "「是啊」",
        "text_idx": [
            10855
        ]
    },
    {
        "ori": "紬さんは少し名残惜しそうに手を離して、ニコニコと笑った。",
        "message": "紬同学有些恋恋不舍地松开了手，然后笑眯眯地笑了起来。",
        "text_idx": [
            10952,
            10953
        ]
    },
    {
        "name": "紬",
        "name_idx": 10973,
        "ori": "「朝からとても楽しかったですわ」",
        "message": "「从早上开始就非常开心呢」",
        "text_idx": [
            10982
        ]
    },
    {
        "name": "亮",
        "name_idx": 10988,
        "ori": "「それならよかったです。俺には死亡フラグ的なものがびんびん立ってしまいましたが」",
        "message": "「那就好。不过我这边死亡flag倒是疯狂立起来了」",
        "text_idx": [
            10997,
            10998
        ]
    },
    {
        "ori": "周りの奴らに問い詰められること必至。",
        "message": "肯定会被周围的家伙们盘问的。",
        "text_idx": [
            11013
        ]
    },
    {
        "ori": "まあ、別にいいんだけどね。",
        "message": "嘛，不过倒也无所谓就是了。",
        "text_idx": [
            11028
        ]
    },
    {
        "name": "紬",
        "name_idx": 11048,
        "ori": "「それでは、私、自分の教室へ行きますが、体には気を付けてくださいね」",
        "message": "「那么，我就先回自己的教室了，你也要多注意身体哦」",
        "text_idx": [
            11057,
            11058
        ]
    },
    {
        "name": "亮",
        "name_idx": 11064,
        "ori": "「はい」",
        "message": "「嗯」",
        "text_idx": [
            11073
        ]
    },
    {
        "name": "紬",
        "name_idx": 11093,
        "ori": "「お昼休みに伺いますわ」",
        "message": "「我午休时会过去找您的」",
        "text_idx": [
            11102
        ]
    },
    {
        "name": "亮",
        "name_idx": 11108,
        "ori": "「俺が教室に行きますよ」",
        "message": "「我到你教室去就行了」",
        "text_idx": [
            11117
        ]
    },
    {
        "name": "紬",
        "name_idx": 11181,
        "ori": "「いえ、こういうものは女性の方から伺うものだと相場が決まっているのです」",
        "message": "「不，这种事情按惯例都是由女方主动拜访的」",
        "text_idx": [
            11190,
            11191
        ]
    },
    {
        "name": "亮",
        "name_idx": 11197,
        "ori": "「それは誰情報？」",
        "message": "「你听谁说的？」",
        "text_idx": [
            11206
        ]
    },
    {
        "name": "紬",
        "name_idx": 11270,
        "ori": "「姉さまです」",
        "message": "「是我姐姐」",
        "text_idx": [
            11279
        ]
    },
    {
        "name": "亮",
        "name_idx": 11285,
        "ori": "「はぁ……」",
        "message": "「唉……」",
        "text_idx": [
            11294
        ]
    },
    {
        "name": "紬",
        "name_idx": 11368,
        "ori": "「それでは、失礼します」",
        "message": "「那么，我先告辞了」",
        "text_idx": [
            11377
        ]
    },
    {
        "ori": "頭をぺこりと下げて、紬さんは教室へ向かっていった。",
        "message": "紬同学轻轻低下头，然后朝教室走去。",
        "text_idx": [
            11444
        ]
    },
    {
        "ori": "途中、何度も振り返り手を振ってくる紬さんに、苦笑いしながら手を振り返した。",
        "message": "途中，紬同学好几次转过身来挥手，我也苦笑着挥手回应她。",
        "text_idx": [
            11459,
            11460
        ]
    },
    {
        "ori": "教室に向かうと、まあ良い感じに噂になっており、あっちこっちから質問攻めに遭う羽目になった。",
        "message": "等我走向教室时，谣言果然已经传得沸沸扬扬，结果我遭到了四面八方的盘问。",
        "text_idx": [
            11496,
            11497
        ]
    },
    {
        "ori": "そして……智継はずっとキーキー言っていた。",
        "message": "而且……智继一直在那儿怪叫个不停。",
        "text_idx": [
            11512
        ]
    }
]