[
    {
        "name": "みつば",
        "name_idx": 118,
        "ori": "「期待しててくださいね、先輩！」",
        "message": "「还请您好好期待哦，前辈！」",
        "text_idx": [
            127
        ]
    },
    {
        "ori": "みつばちゃんは、うれしそうに答えた。どんなメニューになるのだろうか……？　",
        "message": "三叶酱很开心地回答道。会是怎样的新菜品呢……？　",
        "text_idx": [
            142,
            143
        ]
    },
    {
        "ori": "あまりチャレンジなメニューで無いことを、俺は内心祈った。",
        "message": "我内心暗暗祈祷，希望不要是什么太猎奇的菜品。",
        "text_idx": [
            246,
            247
        ]
    },
    {
        "ori": "仁瀬さんが、スタッフルームから着替えて出てきた。",
        "message": "仁濑小姐从员工休息室里换好衣服出来了。",
        "text_idx": [
            262
        ]
    },
    {
        "name": "さつき",
        "name_idx": 403,
        "ori": "「なにを期待されたの？」",
        "message": "「是让你期待什么呀？」",
        "text_idx": [
            412
        ]
    },
    {
        "name": "亮",
        "name_idx": 418,
        "ori": "「いや、期待するのはこっちの方だよ。みつばちゃんの新メニューにね」",
        "message": "「不，期待的人是我。期待的是三叶酱的新菜品啊」",
        "text_idx": [
            427,
            428
        ]
    },
    {
        "name": "さつき",
        "name_idx": 501,
        "ori": "「そうなんだ？　てっきり小松原君が期待されたのかと思ったわ。部長の期待のように……」",
        "message": "「是这样吗？ 我还以为是小松原君被期待了呢。就像被部长期待那样……」",
        "text_idx": [
            510,
            511
        ]
    },
    {
        "name": "亮",
        "name_idx": 517,
        "ori": "「や、やめてくれないかな……今はオフの時間なので……そのあたりの話題は……」",
        "message": "「能、能不能别提了……现在是休息时间……所以那个话题还是……」",
        "text_idx": [
            526,
            527
        ]
    },
    {
        "name": "さつき",
        "name_idx": 591,
        "ori": "「ウフフフフ……ごめんごめん」",
        "message": "「唔呵呵呵……抱歉抱歉」",
        "text_idx": [
            600
        ]
    },
    {
        "ori": "仁瀬さんは、悪戯っぽく笑った。",
        "message": "仁濑小姐恶作剧般地笑了笑。",
        "text_idx": [
            615
        ]
    },
    {
        "ori": "さて、仁瀬さんも戻ってきたことだし、俺は何をしてこのオフの時間を充実させようか……？",
        "message": "好了，仁濑小姐也回来了，我该做些什么来充实这段休息时间呢……？",
        "text_idx": [
            630,
            631
        ]
    },
    {
