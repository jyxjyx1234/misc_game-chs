[
    {
        "name": "亮",
        "name_idx": 2,
        "ori": "「うん、多分ね」",
        "message": "「嗯，大概吧」",
        "text_idx": [
            11
        ]
    },
    {
        "ori": "みつばちゃん、真っ赤になって硬直する。",
        "message": "三叶满脸通红地僵住了。",
        "text_idx": [
            70
        ]
    },
    {
        "name": "みつば",
        "name_idx": 144,
        "ori": "「だ、だ、だめデス、お、お、大人を……か、からかっちゃ……」",
        "message": "「不、不、不行啦，捉、捉、捉弄……大、大人……」",
        "text_idx": [
            153,
            154
        ]
    },
    {
        "name": "亮",
        "name_idx": 160,
        "ori": "「いや、みつばちゃん、俺より若いし……」",
        "message": "「不是，三叶，你比我还年轻啊……」",
        "text_idx": [
            169
        ]
    },
    {
        "name": "亮",
        "name_idx": 175,
        "ori": "「でもね、みつばちゃん、俺、あの時思ったよ……」",
        "message": "「不过啊，三叶，我那时候就在想……」",
        "text_idx": [
            184
        ]
    },
    {
        "name": "みつば",
        "name_idx": 302,
        "ori": "「ナ、ナニをデスか？」",
        "message": "「是、是什么呢？」",
        "text_idx": [
            311
        ]
    },
    {
        "name": "亮",
        "name_idx": 317,
        "ori": "「いつも弁当とか分けてもらって、いつも明るく接してくれて、いつもみつばちゃんは、俺に気をつかっててくれたんだって……」",
        "message": "「你总是分便当给我，总是开朗地对待我，三叶你，一直以来都在为我着想……」",
        "text_idx": [
            326,
            327,
            328
        ]
    },
    {
        "name": "みつば",
        "name_idx": 392,
        "ori": "「そ、そんなぁ……ふ、ふつうデスョ……」",
        "message": "「才、才没有……这、这很普通啦……」",
        "text_idx": [
            401
        ]
    },
    {
        "name": "亮",
        "name_idx": 407,
        "ori": "「みつばちゃん、ありがとう」",
        "message": "「三叶妹妹，谢谢你」",
        "text_idx": [
            416
        ]
    },
    {
        "ori": "みつばちゃんは、真っ赤になってうつむいてる。",
        "message": "三叶满脸通红地低着头。",
        "text_idx": [
            475
        ]
    },
    {
        "name": "みつば",
        "name_idx": 495,
        "ori": "「ド、ド、ド……ドウいたしまシマ……」",
        "message": "「不、不、不……不客气西马……」",
        "text_idx": [
            504
        ]
    },
    {
        "name": "亮",
        "name_idx": 510,
        "ori": "「シマシマ……」",
        "message": "「西马西马……」",
        "text_idx": [
            519
        ]
    },
    {
        "name": "みつば",
        "name_idx": 637,
        "ori": "「か、か、噛んだだけデスョー！」",
        "message": "「我、我、我只是咬到舌头了啦—！」",
        "text_idx": [
            646
        ]
    },
    {
        "name": "亮",
        "name_idx": 652,
        "ori": "「なんか、怪しい外人さんみたいだね」",
        "message": "「总觉得，你好像个可疑的外国人呢」",
        "text_idx": [
            661
        ]
    },
    {
        "name": "みつば",
        "name_idx": 725,
        "ori": "「ン……もぉぉぉぉぉぉうっ！」",
        "message": "「嗯……真是的————！」",
        "text_idx": [
            734
        ]
    },
    {
        "ori": "みつばちゃんが、俺の頭をポカポカと叩く。",
        "message": "三叶酱轻轻地敲着我的头。",
        "text_idx": [
            749
        ]
    },
    {
        "ori": "恥ずかしそうに、そして、楽しそうに笑いながら。",
        "message": "她害羞地，同时又很开心地笑着。",
        "text_idx": [
            764
        ]
    }
]