[
    {
        "name": "みつば",
        "name_idx": 118,
        "ori": "「それじゃ、次は小松原センパイの番デス」",
        "message": "「那么，接下来就轮到小松原前辈了的说」",
        "text_idx": [
            127
        ]
    },
    {
        "name": "亮",
        "name_idx": 133,
        "ori": "「お……っ、俺っ！？」",
        "message": "「欸……我、我！？」",
        "text_idx": [
            142
        ]
    },
    {
        "ori": "コクコクと頷くみつばちゃん。",
        "message": "小三叶连连点头。",
        "text_idx": [
            255
        ]
    },
    {
        "name": "みつば",
        "name_idx": 319,
        "ori": "「それじゃ、おねえちゃん『お題』ください」",
        "message": "「那么，姐姐，请给个『题目』」",
        "text_idx": [
            328
        ]
    },
    {
        "name": "さつき",
        "name_idx": 392,
        "ori": "「……『おかめそば』」",
        "message": "「……『冈目荞麦面』」",
        "text_idx": [
            401
        ]
    },
    {
        "name": "亮",
        "name_idx": 407,
        "ori": "「おかめそば！？　そんなメニュー学食にもないぞ……」",
        "message": "「冈目荞麦面！？　学生食堂里可没有这道菜啊……」",
        "text_idx": [
            416
        ]
    },
    {
        "name": "亮",
        "name_idx": 422,
        "ori": "「でも……確か『岡目八目』って言うのが由来だったような……？」",
        "message": "「不过……我记得它的名字好像是源自『冈目八目』这个说法来着……？」",
        "text_idx": [
            431,
            432
        ]
    },
    {
        "ori": "俺はスケッチブックに『ドンブリ』を描く。",
        "message": "我在速写本上画了个『大碗』。",
        "text_idx": [
            447
        ]
    },
    {
        "name": "亮",
        "name_idx": 507,
        "ori": "「『五目』より３つ多い『八目』だから……」",
        "message": "「因为『八目』比『五目』还多三种……」",
        "text_idx": [
            516
        ]
    },
    {
        "ori": "具を思いつくまま『ドンブリ』の中に描いていく。",
        "message": "我把能想到的配料一个个画进了『大碗』里。",
        "text_idx": [
            531
        ]
    },
    {
        "name": "亮",
        "name_idx": 537,
        "ori": "「キツネ……と」",
        "message": "「油豆腐……和」",
        "text_idx": [
            546
        ]
    },
    {
        "name": "亮",
        "name_idx": 552,
        "ori": "「あけだま……」",
        "message": "「天妇罗碎……」",
        "text_idx": [
            561
        ]
    },
    {
        "name": "亮",
        "name_idx": 567,
        "ori": "「かまぼこ……」",
        "message": "「鱼板……」",
        "text_idx": [
            576
        ]
    },
    {
        "name": "亮",
        "name_idx": 582,
        "ori": "「……う～ん、しいたけ、と」",
        "message": "「……嗯—，香菇，还有」",
        "text_idx": [
            591
        ]
    },
    {
        "name": "亮",
        "name_idx": 651,
        "ori": "「あとは……なんだ！？　セリって入ってたかな？」",
        "message": "「还有……是什么来着！？　里面有水芹吗？」",
        "text_idx": [
            660
        ]
    },
    {
        "name": "亮",
        "name_idx": 666,
        "ori": "「……ほかには何が乗ってたっけ？」",
        "message": "「……上面还放了些什么来着？」",
        "text_idx": [
            675
        ]
    },
    {
        "name": "亮",
        "name_idx": 681,
        "ori": "「…………」",
        "message": "「…………」",
        "text_idx": [
            690
        ]
    },
    {
        "name": "亮",
        "name_idx": 696,
        "ori": "「……………………」",
        "message": "「……………………」",
        "text_idx": [
            705
        ]
    },
    {
        "name": "さつき",
        "name_idx": 769,
        "ori": "「………………………………」",
        "message": "「………………………………」",
        "text_idx": [
            778
        ]
    },
    {
        "name": "みつば",
        "name_idx": 896,
        "ori": "「ブーッ！　時間切れデス！　先輩負け～っ！」",
        "message": "「哔—！　时间到DEATH！　学姐你输啦—！」",
        "text_idx": [
            905
        ]
    },
    {
        "name": "さつき",
        "name_idx": 1023,
        "ori": "「……クスクスッ！」",
        "message": "「……噗嗤！」",
        "text_idx": [
            1032
        ]
    },
    {
        "name": "みつば",
        "name_idx": 1096,
        "ori": "「…………それでは、次の問題デス」",
        "message": "「…………那么，下一道题DEATH」",
        "text_idx": [
            1105
        ]
    },
    {
        "name": "亮",
        "name_idx": 1111,
        "ori": "「……ぉぃぉぃ」",
        "message": "「……喂喂」",
        "text_idx": [
            1120
        ]
    },
    {
        "name": "さつき",
        "name_idx": 1184,
        "ori": "「……『松花堂弁当』」",
        "message": "「……『松花堂便当』」",
        "text_idx": [
            1193
        ]
    },
    {
        "ori": "仁瀬さん、ワザと難解な料理を出題しているな……",
        "message": "仁濑同学，你这是故意出些难懂的菜名啊……",
        "text_idx": [
            1208
        ]
    },
    {
        "name": "亮",
        "name_idx": 1214,
        "ori": "「松花……っ！？　ていうか中身知っているの？」",
        "message": "「松花……！？　话说你知道里面都装了些什么吗？」",
        "text_idx": [
            1223
        ]
    },
    {
        "name": "さつき",
        "name_idx": 1341,
        "ori": "「……………………」",
        "message": "「……………………」",
        "text_idx": [
            1350
        ]
    },
    {
        "name": "みつば",
        "name_idx": 1414,
        "ori": "「……………………」",
        "message": "「……………………」",
        "text_idx": [
            1423
        ]
    },
    {
        "name": "みつば",
        "name_idx": 1487,
        "ori": "「…………それでは、次の問題デス」",
        "message": "「…………那么，下一道题DEATH」",
        "text_idx": [
            1496
        ]
    },
    {
        "name": "亮",
        "name_idx": 1502,
        "ori": "「な、中身のわかる問題をお願いします……」",
        "message": "「拜、拜托来个我知道是什么的题目吧……」",
        "text_idx": [
            1511
        ]
    },
    {
        "name": "さつき",
        "name_idx": 1575,
        "ori": "「……『春野菜のキッシュのグリビッシュソースがけ』」",
        "message": "「……『浇上格里比什酱的春季蔬菜咸派』」",
        "text_idx": [
            1584
        ]
    },
    {
        "name": "亮",
        "name_idx": 1590,
        "ori": "「……そっ、そんな料理しらん！」",
        "message": "「……我、我才不知道有这种菜！」",
        "text_idx": [
            1599
        ]
    },
    {
        "name": "みつば",
        "name_idx": 1717,
        "ori": "「先輩……っ、負け～っ！」",
        "message": "「学长……你，输了～！」",
        "text_idx": [
            1726
        ]
    },
    {
        "ori": "いつしか、部員もみんな帰ってしまった美術室で、仁瀬さん、みつばちゃんと俺は笑いあった。",
        "message": "不知不觉间，部员们都已回家，在美术室里，仁濑同学、三叶和我相视而笑。",
        "text_idx": [
            1741,
            1742
        ]
    },
    {
        "ori": "ほのぼのとして、なんだか忘れていたものを思い出した気分だった。",
        "message": "这温馨祥和的气氛，让我感觉好像回想起了什么遗忘已久的东西。",
        "text_idx": [
            1757,
            1758
        ]
    },
    {
        "ori": "そんな楽しいひとときだった。",
        "message": "那是一段快乐的时光。",
        "text_idx": [
            1773
        ]
    }
]