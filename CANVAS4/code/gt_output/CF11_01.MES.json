[
    {
        "name": "亮",
        "name_idx": 67,
        "ori": "「ふぁ……」",
        "message": "「哈……」",
        "text_idx": [
            76
        ]
    },
    {
        "ori": "大あくびを一発。",
        "message": "我打了一发大哈欠。",
        "text_idx": [
            91
        ]
    },
    {
        "ori": "冷たい乾燥した空気に、大きく開けた口から湯気のように白い息が上がっていく。",
        "message": "冰冷干燥的空气里，从我大张的嘴巴中升起了蒸汽般的白色气息。",
        "text_idx": [
            106,
            107
        ]
    },
    {
        "ori": "正月ボケと、遅寝遅起きが身に付いてしまった体に、久しぶりの学校はなかなかにハード。",
        "message": "对于犯了新年假期后遗症，又养成了晚睡晚起习惯的身体而言，久违的学校生活实在有些够呛。",
        "text_idx": [
            122,
            123
        ]
    },
    {
        "ori": "さらに、普通の学校の日よりもかなり早く起きて、ずっとここに居るので体のだるさと眠さが半端ではない。",
        "message": "再加上，我比平时上学的日子起得早得多，又一直待在这里，所以身体的疲惫和困意非同一般。",
        "text_idx": [
            138,
            139
        ]
    },
    {
        "ori": "なぜそんなことしているのかというと、そりゃもう決まっている。",
        "message": "要问我为什么要这么做，原因当然是明摆着的。",
        "text_idx": [
            154,
            155
        ]
    },
    {
        "ori": "紬さんと一刻でも早く会うためだ。",
        "message": "就是为了能早一刻见到紬小姐。",
        "text_idx": [
            170
        ]
    },
    {
        "ori": "あの初詣以来、紬さんとは会うことができなかった。",
        "message": "自从那次新年参拜以来，我就没能再见到紬小姐了。",
        "text_idx": [
            185
        ]
    },
    {
        "ori": "電話は迷惑をかけてしまうかもしれないのでメールだけ。",
        "message": "因为怕打电话会打扰到她，所以就只发邮件。",
        "text_idx": [
            200
        ]
    },
    {
        "ori": "メールも迷惑にならないように、１日１回、交換日記をするようなようなやりとり……",
        "message": "邮件也是，为了不造成困扰，我们每天只联系一次，就像在交换日记一样……",
        "text_idx": [
            215,
            216
        ]
    },
    {
        "ori": "紬さんは、毎日一杯の文字でその日の出来事や、俺への思いを綴ってくれる。",
        "message": "紬小姐每天都会用满满的文字，为我写下当天发生的事，以及她对我的思念与情愫。",
        "text_idx": [
            231,
            232
        ]
    },
    {
        "ori": "でも……やっぱり、実際に会って顔を見たい、その声を聞きたいという欲求はどんどん大きくなっていった。",
        "message": "但是……我还是越来越想实际见到她，看看她的脸，听听她的声音。",
        "text_idx": [
            247,
            248
        ]
    },
    {
        "ori": "だから、会わない間に、恋しくなって、こんな他人が見たらちょっと引くような行動をしてしまうのも無理はない。",
        "message": "所以，在没能见面的这段时间里，我对她的思念与日俱增，会做出这种在旁人看来有些难以理解的行为，也并非无法理解。",
        "text_idx": [
            263,
            264
        ]
    },
    {
        "ori": "うん、無理はない。",
        "message": "嗯，这很正常。",
        "text_idx": [
            279
        ]
    },
    {
        "name": "亮",
        "name_idx": 285,
        "ori": "「しかし、誰もこないなぁ」",
        "message": "「但是，怎么一个人都没有啊」",
        "text_idx": [
            294
        ]
    },
    {
        "ori": "未だに通学してきた生徒はゼロ。",
        "message": "到现在为止，来上学的学生一个都没有。",
        "text_idx": [
            309
        ]
    },
    {
        "ori": "あまりに生徒が来ないので、始業式の日を間違えてしまったのではないかと不安になって、二度ほどプリントを確認してしまった。",
        "message": "因为实在没什么学生来，我甚至开始担心是不是自己记错了开学典礼的日子，为此还确认了两遍通知单。",
        "text_idx": [
            324,
            325,
            326
        ]
    },
    {
        "ori": "まあ、それぐらい早く来ていたということ。",
        "message": "嘛，这也说明我来得有多早了。",
        "text_idx": [
            341
        ]
    },
    {
        "name": "亮",
        "name_idx": 347,
        "ori": "「こりゃ、もう少し待つことになりそうだな」",
        "message": "「看来，我得再多等一会儿了啊」",
        "text_idx": [
            356
        ]
    },
    {
        "ori": "空を仰ぐ。",
        "message": "我仰望天空。",
        "text_idx": [
            392
        ]
    },
    {
        "ori": "澄んだ青空だった。",
        "message": "天空澄澈蔚蓝。",
        "text_idx": [
            407
        ]
    },
    {
        "ori": "コツコツと。",
        "message": "嗒、嗒。",
        "text_idx": [
            422
        ]
    },
    {
        "ori": "ふと、そんな音がして振り向けば、少し白い靄が掛かった道の向こうから待っていた人が現れて、疲れと眠気が一気に吹き飛んだ。",
        "message": "我忽然听到一阵脚步声，回头一看，只见我等待的人从笼罩着一层薄薄白雾的道路对面出现，我的疲惫和困意瞬间一扫而空。",
        "text_idx": [
            704,
            705,
            706
        ]
    },
    {
        "name": "亮",
        "name_idx": 712,
        "ori": "「紬さーん！」",
        "message": "「紬同学——！」",
        "text_idx": [
            721
        ]
    },
    {
        "name": "紬",
        "name_idx": 785,
        "ori": "「亮くん？」",
        "message": "「亮君？」",
        "text_idx": [
            794
        ]
    },
    {
        "ori": "大きく手を振ると、紬さんは嬉しそうな顔で駆け寄ってきた。",
        "message": "我大幅度地挥了挥手，紬同学便一脸欣喜地跑了过来。",
        "text_idx": [
            854,
            855
        ]
    },
    {
        "name": "紬",
        "name_idx": 1031,
        "ori": "「お久しぶりです、亮くん」",
        "message": "「好久不见了，亮君」",
        "text_idx": [
            1040
        ]
    },
    {
        "name": "亮",
        "name_idx": 1046,
        "ori": "「久しぶりですね」",
        "message": "「是啊，好久不见」",
        "text_idx": [
            1055
        ]
    },
    {
        "name": "紬",
        "name_idx": 1119,
        "ori": "「私を待っていてくださったんですか？」",
        "message": "「你是在特地等我吗？」",
        "text_idx": [
            1128
        ]
    },
    {
        "name": "亮",
        "name_idx": 1134,
        "ori": "「まぁ」",
        "message": "「算是吧」",
        "text_idx": [
            1143
        ]
    },
    {
        "name": "紬",
        "name_idx": 1207,
        "ori": "「こんなに早くから……ありがとうございます」",
        "message": "「这么早就……谢谢你」",
        "text_idx": [
            1216
        ]
    },
    {
        "name": "亮",
        "name_idx": 1222,
        "ori": "「たまたま早く目が覚めただけですよ」",
        "message": "「我只是碰巧醒得早罢了」",
        "text_idx": [
            1231
        ]
    },
    {
        "ori": "目覚まし何個もセットしました。",
        "message": "我可是设了好几个闹钟。",
        "text_idx": [
            1246
        ]
    },
    {
        "name": "紬",
        "name_idx": 1266,
        "ori": "「私も亮くんを待とうと思って早起きしたのですが……」",
        "message": "「我也想着要等亮君，所以早起了，不过……」",
        "text_idx": [
            1275
        ]
    },
    {
        "ori": "ちょっぴり残念そうな顔をする紬さんだが、すぐに微笑みに変えて俺の手を握ってきた。",
        "message": "紬同学露出了些许遗憾的表情，但马上又换上了微笑并握住了我的手。",
        "text_idx": [
            1290,
            1291
        ]
    },
    {
        "name": "紬",
        "name_idx": 1393,
        "ori": "「会いたかったです」",
        "message": "「我好想你」",
        "text_idx": [
            1402
        ]
    },
    {
        "name": "亮",
        "name_idx": 1408,
        "ori": "「俺もですよ」",
        "message": "「我也是啊」",
        "text_idx": [
            1417
        ]
    },
    {
        "name": "紬",
        "name_idx": 1481,
        "ori": "「お変わりありませんでしたか？」",
        "message": "「你一切都还好吗？」",
        "text_idx": [
            1490
        ]
    },
    {
        "name": "亮",
        "name_idx": 1496,
        "ori": "「特にないですよ」",
        "message": "「没什么特别的啊」",
        "text_idx": [
            1505
        ]
    },
    {
        "name": "亮",
        "name_idx": 1511,
        "ori": "「紬さんこそ、進学の準備とかどうですか？」",
        "message": "「紬同学你呢，升学的准备之类的做得怎么样了？」",
        "text_idx": [
            1520
        ]
    },
    {
        "name": "紬",
        "name_idx": 1584,
        "ori": "「お陰さまで順調です」",
        "message": "「托你的福，一切都很顺利」",
        "text_idx": [
            1593
        ]
    },
    {
        "name": "亮",
        "name_idx": 1599,
        "ori": "「それはよかったです」",
        "message": "「那就好」",
        "text_idx": [
            1608
        ]
    },
    {
        "ori": "紬さんの笑顔。",
        "message": "紬同学的笑容。",
        "text_idx": [
            1623
        ]
    },
    {
        "ori": "その笑顔と共に会話できるだけで、幸せな気分になって、早起きしてよかったと心の底から思った。",
        "message": "光是能和面带笑容的她聊天，就让我感到很幸福，我发自内心地觉得，早起真是太好了。",
        "text_idx": [
            1638,
            1639
        ]
    },
    {
        "name": "亮",
        "name_idx": 1645,
        "ori": "「寒いですから、校舎へ入りましょう」",
        "message": "「天冷，我们进教学楼吧」",
        "text_idx": [
            1654
        ]
    },
    {
        "name": "紬",
        "name_idx": 1718,
        "ori": "「はい……あ、その前に、亮くん」",
        "message": "「嗯……啊，在那之前，亮君」",
        "text_idx": [
            1727
        ]
    },
    {
        "name": "亮",
        "name_idx": 1733,
        "ori": "「なんですか？」",
        "message": "「怎么了？」",
        "text_idx": [
            1742
        ]
    },
    {
        "name": "紬",
        "name_idx": 1806,
        "ori": "「お預けにしていたものです」",
        "message": "「这是之前欠你的」",
        "text_idx": [
            1815
        ]
    },
    {
        "name": "亮",
        "name_idx": 1821,
        "ori": "「え？」",
        "message": "「诶？」",
        "text_idx": [
            1830
        ]
    },
    {
        "ori": "ふいに紬さんが抱き、目をつむり顔を近づけてくる。",
        "message": "紬同学突然抱住了我，闭上眼睛，将脸凑了过来。",
        "text_idx": [
            1889
        ]
    },
    {
        "ori": "そっか初詣の時お預けにしてたっけ。",
        "message": "我想起来了，是初诣那次说好先欠着的。",
        "text_idx": [
            1904
        ]
    },
    {
        "ori": "少し恥ずかしさが湧くが、まだ誰も周りに居ない事だし。",
        "message": "我虽然感到有点害羞，不过反正周围也没有其他人。",
        "text_idx": [
            1919
        ]
    },
    {
        "ori": "俺は紬さんの肩を抱えるようにして唇を重ねた。",
        "message": "我环抱住紬同学的肩膀，与她双唇相接。",
        "text_idx": [
            1934
        ]
    },
    {
        "name": "紬",
        "name_idx": 1998,
        "ori": "「初キスですね」",
        "message": "「这是我们的初吻呢」",
        "text_idx": [
            2007
        ]
    },
    {
        "name": "亮",
        "name_idx": 2013,
        "ori": "「そうですね」",
        "message": "「是啊」",
        "text_idx": [
            2022
        ]
    },
    {
        "name": "紬",
        "name_idx": 2086,
        "ori": "「ん……」",
        "message": "「嗯……」",
        "text_idx": [
            2095
        ]
    },
    {
        "ori": "もう一度、唇を重ね合う。",
        "message": "我们再一次双唇相接。",
        "text_idx": [
            2110
        ]
    },
    {
        "ori": "静けさだけが漂う早朝。邪魔する者はどこにも居ない。",
        "message": "寂静弥漫的清晨。没有任何人会来打扰。",
        "text_idx": [
            2170
        ]
    },
    {
        "ori": "長い間、紬さんと唇を重ね続けた。",
        "message": "我与紬同学就这样，吻了很久。",
        "text_idx": [
            2185
        ]
    },
    {
        "name": "杏子",
        "name_idx": 2420,
        "ori": "「みんな、明けましておめでと～」",
        "message": "「大家，新年快乐～」",
        "text_idx": [
            2429
        ]
    },
    {
        "name": "亮＆ことの＆さつき＆智継＆紬",
        "name_idx": 2669,
        "ori": "「おめでとうございます」",
        "message": "「新年快乐」",
        "text_idx": [
            2678
        ]
    },
    {
        "ori": "今日は終業式と、ホームルームしかなかったので、昼前には終了。",
        "message": "今天只有结业式和班会，所以不到中午就结束了。",
        "text_idx": [
            2693,
            2694
        ]
    },
    {
        "ori": "新年のあいさつを兼ねた、今年初の部活だった。",
        "message": "这是兼带新年问候的，今年第一次的社团活动。",
        "text_idx": [
            2709
        ]
    },
    {
        "ori": "紬さんは自分は部員ではないのでと遠慮していたが、俺は気にしないでと連れてきた。",
        "message": "紬同学因为自己不是部员而有所顾虑，不过我让她别在意，把她带来了。",
        "text_idx": [
            2724,
            2725
        ]
    },
    {
        "name": "杏子",
        "name_idx": 2745,
        "ori": "「今年もみんなでわいわいやっていこうねっ！」",
        "message": "「今年大家也要热热闹闹地一起玩哦！」",
        "text_idx": [
            2754
        ]
    },
    {
        "name": "ことの＆さつき",
        "name_idx": 2774,
        "ori": "「はーい」",
        "message": "「好——」",
        "text_idx": [
            2783
        ]
    },
    {
        "name": "智継",
        "name_idx": 2803,
        "ori": "「今年こそ彼女を作ってやる……」",
        "message": "「今年我一定要交到女朋友……」",
        "text_idx": [
            2812
        ]
    },
    {
        "ori": "みんな相変わらずだな。",
        "message": "大家还是老样子啊。",
        "text_idx": [
            2827
        ]
    },
    {
        "name": "杏子",
        "name_idx": 2891,
        "ori": "「紬先輩は、今年卒業ですね」",
        "message": "「紬学姐，今年就要毕业了呢」",
        "text_idx": [
            2900
        ]
    },
    {
        "name": "紬",
        "name_idx": 2920,
        "ori": "「はい。寂しくなりますわ」",
        "message": "「是的。会很寂寞呢」",
        "text_idx": [
            2929
        ]
    },
    {
        "name": "智継",
        "name_idx": 2993,
        "ori": "「あー学園から癒しがなくなっちまうよ」",
        "message": "「啊—学校里治愈人心的存在要消失了啊」",
        "text_idx": [
            3002
        ]
    },
    {
        "name": "杏子",
        "name_idx": 3022,
        "ori": "「留学されるんですよねぇ。準備とか大変じゃないですか？」",
        "message": "「您是要去留学的吧。准备工作之类的不是很辛苦吗？」",
        "text_idx": [
            3031,
            3032
        ]
    },
    {
        "name": "紬",
        "name_idx": 3052,
        "ori": "「いえ、留学はやめましたの」",
        "message": "「不，我决定不留学了」",
        "text_idx": [
            3061
        ]
    },
    {
        "ori": "その言葉に部室の中が騒然となる。",
        "message": "她的话让社团活动室里一片哗然。",
        "text_idx": [
            3384
        ]
    },
    {
        "ori": "まあ、そりゃそうだろうな。",
        "message": "嘛，那也是理所当然的吧。",
        "text_idx": [
            3399
        ]
    },
    {
        "ori": "紬さんの目には迷いはなかった。",
        "message": "紬同学的眼中没有任何迷惘。",
        "text_idx": [
            3414
        ]
    },
    {
        "name": "杏子",
        "name_idx": 3478,
        "ori": "「ぁ……そうなんですか。えっと、じゃあこのまま大学ですか？」",
        "message": "「啊……是这样吗。那个，那您是打算直接上大学吗？」",
        "text_idx": [
            3487,
            3488
        ]
    },
    {
        "name": "紬",
        "name_idx": 3508,
        "ori": "「はい」",
        "message": "「嗯」",
        "text_idx": [
            3517
        ]
    },
    {
        "ori": "部長は留学については深く聞かず、大学の話を興味深々と聞き始める。",
        "message": "部长没有深入追问留学的事，而是兴致勃勃地问起了大学的话题。",
        "text_idx": [
            3532,
            3533
        ]
    },
    {
        "ori": "部長も今年で三年になるので、いろいろ聞いておきたいんだろう。",
        "message": "部长今年也要升上三年级了，所以有很多事想提前打听一下吧。",
        "text_idx": [
            3548,
            3549
        ]
    },
    {
        "ori": "二人が話し込み始めたので、美術部員たちは自由に行動し始めた。",
        "message": "因为她们两人开始聊了起来，美术部的部员们便各自行动起来了。",
        "text_idx": [
            3585,
            3586
        ]
    },
    {
        "name": "智継",
        "name_idx": 3884,
        "ori": "「おい、亮、鷺ノ宮先輩が留学やめたのって、お前と一緒にいたいからとかか？」",
        "message": "「喂，亮，鹭之宫前辈放弃留学，该不会是想和你在一起吧？」",
        "text_idx": [
            3893,
            3894
        ]
    },
    {
        "name": "亮",
        "name_idx": 3900,
        "ori": "「……まあ」",
        "message": "「……算是吧」",
        "text_idx": [
            3909
        ]
    },
    {
        "name": "智継",
        "name_idx": 4027,
        "ori": "「くゥううッ！　てあんでーばろーちくちょー！　羨ましすぎるぜ！」",
        "message": "「呜呜呜！岂有此理啊混蛋！也太让人羡慕了吧！」",
        "text_idx": [
            4036,
            4037
        ]
    },
    {
        "ori": "智継はわざわざハンカチを取り出して、噛んで悔しさをアピールしていた。",
        "message": "智继还特地拿出一条手帕，咬在嘴里以表达他的不甘。",
        "text_idx": [
            4052,
            4053
        ]
    },
    {
        "name": "亮",
        "name_idx": 4059,
        "ori": "「ハンカチ、ちゃんと持ってきてるんだな」",
        "message": "「你还真带着手帕啊」",
        "text_idx": [
            4068
        ]
    },
    {
        "name": "智継",
        "name_idx": 4141,
        "ori": "「紳士のたしなみだろ」",
        "message": "「这可是绅士的素养啊」",
        "text_idx": [
            4150
        ]
    },
    {
        "name": "亮",
        "name_idx": 4156,
        "ori": "「紳士はハンカチ噛まないだろ」",
        "message": "「绅士可不会咬手帕吧」",
        "text_idx": [
            4165
        ]
    },
    {
        "ori": "苦笑しているとさらに悔しそうにハンカチを噛んでいた。",
        "message": "我正苦笑着，他就更加不甘心地咬起了手帕。",
        "text_idx": [
            4180
        ]
    },
    {
        "name": "智継",
        "name_idx": 4244,
        "ori": "「まあ、でもあれだな」",
        "message": "「嘛，不过话说回来」",
        "text_idx": [
            4253
        ]
    },
    {
        "name": "亮",
        "name_idx": 4259,
        "ori": "「ん？」",
        "message": "「嗯？」",
        "text_idx": [
            4268
        ]
    },
    {
        "name": "智継",
        "name_idx": 4332,
        "ori": "「よかったな」",
        "message": "「太好了」",
        "text_idx": [
            4341
        ]
    },
    {
        "name": "亮",
        "name_idx": 4347,
        "ori": "「ああ……ありがと」",
        "message": "「嗯……谢谢」",
        "text_idx": [
            4356
        ]
    },
    {
        "ori": "男の友情的なものを感じるが、次の瞬間には、智継はハンカチを破れん限りに噛んで引っ張っていた。",
        "message": "我感受到了男人间的友情，但在下一瞬间，智继便使劲地又咬又拽，仿佛要把手帕扯破一般。",
        "text_idx": [
            4469,
            4470
        ]
    },
    {
        "name": "智継",
        "name_idx": 4490,
        "ori": "「きぃいいい！　羨ましい！　超羨ましい！　めっちゃ羨ましい！」",
        "message": "「呀啊啊啊！ 好羡慕！ 超级羡慕！ 羡慕死我了！」",
        "text_idx": [
            4499,
            4500
        ]
    },
    {
        "name": "亮",
        "name_idx": 4506,
        "ori": "「智継……」",
        "message": "「智继……」",
        "text_idx": [
            4515
        ]
    },
    {
        "name": "ことの",
        "name_idx": 4579,
        "ori": "「亮ちゃん、よかったね！」",
        "message": "「小亮，太好了呢！」",
        "text_idx": [
            4588
        ]
    },
    {
        "name": "亮",
        "name_idx": 4623,
        "ori": "「おう、ありがと」",
        "message": "「哦，谢谢你」",
        "text_idx": [
            4632
        ]
    },
    {
        "ori": "にこにこ顔のことの。",
        "message": "琴乃笑眯眯的。",
        "text_idx": [
            4647
        ]
    },
    {
        "ori": "お隣なのに正月は会わなかったし、今日の教室でも喋らなかったので、なんだか新鮮だ。",
        "message": "明明是邻居，但过年的时候没见到，今天在教室里也没说过话，所以总觉得有种新鲜感。",
        "text_idx": [
            4662,
            4663
        ]
    },
    {
        "name": "ことの",
        "name_idx": 4741,
        "ori": "「それでねぇ、亮ちゃん、ちょっと話聞いてくれない？」",
        "message": "「我说，小亮，能听我说件事吗？」",
        "text_idx": [
            4750
        ]
    },
    {
        "name": "亮",
        "name_idx": 4756,
        "ori": "「話？」",
        "message": "「什么事？」",
        "text_idx": [
            4765
        ]
    },
    {
        "name": "ことの",
        "name_idx": 4829,
        "ori": "「私が見た初夢の話なんだけど、すごく壮大な夢だったのー」",
        "message": "「是我新年做的第一个梦的事，那可是个非常宏大的梦哦——」",
        "text_idx": [
            4838,
            4839
        ]
    },
    {
        "name": "亮",
        "name_idx": 4845,
        "ori": "「へぇ」",
        "message": "「哦」",
        "text_idx": [
            4854
        ]
    },
    {
        "name": "ことの",
        "name_idx": 4918,
        "ori": "「亮ちゃんに聞かせたかったけど、会う機会なかったし」",
        "message": "「我很想说给小亮听的，但一直没机会见面」",
        "text_idx": [
            4927
        ]
    },
    {
        "name": "亮",
        "name_idx": 4933,
        "ori": "「うん、いいよ聞かせて」",
        "message": "「嗯，好啊，说来听听」",
        "text_idx": [
            4942
        ]
    },
    {
        "name": "ことの",
        "name_idx": 5006,
        "ori": "「えっとね」",
        "message": "「嗯，就是呢」",
        "text_idx": [
            5015
        ]
    },
    {
        "name": "さつき",
        "name_idx": 5079,
        "ori": "「小松原くん」",
        "message": "「小松原同学」",
        "text_idx": [
            5088
        ]
    },
    {
        "ori": "ことのが話し始めるベストタイミングで、仁瀬さんが腕を引っ張ってきた。",
        "message": "就在琴乃准备开口的绝佳时机，仁濑同学拉住了我的胳膊。",
        "text_idx": [
            5103,
            5104
        ]
    },
    {
        "name": "亮",
        "name_idx": 5110,
        "ori": "「な、なに、仁瀬さん？」",
        "message": "「怎、怎么了，仁濑同学？」",
        "text_idx": [
            5119
        ]
    },
    {
        "name": "さつき",
        "name_idx": 5139,
        "ori": "「ちょっと絵を見て欲しいんだけど」",
        "message": "「我想让你看一下画」",
        "text_idx": [
            5148
        ]
    },
    {
        "name": "ことの",
        "name_idx": 5256,
        "ori": "「さっちゃん、今私が亮ちゃんと話してるんだよ」",
        "message": "「小咲，现在是我在和小亮说话哦」",
        "text_idx": [
            5265
        ]
    },
    {
        "name": "さつき",
        "name_idx": 5329,
        "ori": "「ごめん、でも、今すぐ小松原くんに見て欲しいの」",
        "message": "「抱歉，但我现在就想让小松原同学看」",
        "text_idx": [
            5338
        ]
    },
    {
        "name": "亮",
        "name_idx": 5384,
        "ori": "「ええ、ちょっと仁瀬さん！？」",
        "message": "「诶诶，等一下仁濑同学！？」",
        "text_idx": [
            5393
        ]
    },
    {
        "ori": "仁瀬さんが俺を腕を取ってぐいっと引っ張ってくる。",
        "message": "仁濑同学抓住我的胳膊，猛地一拉。",
        "text_idx": [
            5408
        ]
    },
    {
        "name": "ことの",
        "name_idx": 5560,
        "ori": "「私も、今すぐに亮ちゃんに聞いて欲しいのー」",
        "message": "「我也想现在就让小亮听我说嘛—」",
        "text_idx": [
            5569
        ]
    },
    {
        "name": "亮",
        "name_idx": 5615,
        "ori": "「ええ、こ、ことの！？」",
        "message": "「诶诶，琴、琴乃！？」",
        "text_idx": [
            5624
        ]
    },
    {
        "ori": "ことのも、俺のもう片方の腕を取って引っ張ってきた。",
        "message": "琴乃也抓住了我另一只胳膊拉了过来。",
        "text_idx": [
            5639
        ]
    },
    {
        "ori": "ええ、ちょっと、これはどうしたらいいんだ！？",
        "message": "诶诶，等一下，这该怎么办才好啊！？",
        "text_idx": [
            5654
        ]
    },
    {
        "name": "ことの",
        "name_idx": 5772,
        "ori": "「さっちゃん、亮ちゃんを渡してぇ！」",
        "message": "「小咲，把小亮交给我！」",
        "text_idx": [
            5781
        ]
    },
    {
        "name": "亮",
        "name_idx": 5868,
        "ori": "「イテテテ」",
        "message": "「好疼疼疼」",
        "text_idx": [
            5877
        ]
    },
    {
        "name": "さつき",
        "name_idx": 5995,
        "ori": "「青桐さんこそ、小松原くんを渡して！」",
        "message": "「青桐同学才是，把小松原同学交给我！」",
        "text_idx": [
            6004
        ]
    },
    {
        "name": "亮",
        "name_idx": 6091,
        "ori": "「アタタタ」",
        "message": "「好疼好疼」",
        "text_idx": [
            6100
        ]
    },
    {
        "ori": "う、嬉し――じゃなくて、痛い！",
        "message": "唔，好高—不对，好疼！",
        "text_idx": [
            6115
        ]
    },
    {
        "name": "ことの",
        "name_idx": 6233,
        "ori": "「手放してぇ！」",
        "message": "「快放手！」",
        "text_idx": [
            6242
        ]
    },
    {
        "name": "さつき",
        "name_idx": 6441,
        "ori": "「そっちこそ」",
        "message": "「你才是」",
        "text_idx": [
            6450
        ]
    },
    {
        "name": "亮",
        "name_idx": 6537,
        "ori": "「ちょっ、痛いから、イタいから！」",
        "message": "「等下，很疼的，我说很疼啊！」",
        "text_idx": [
            6546
        ]
    },
    {
        "name": "杏子",
        "name_idx": 6712,
        "ori": "「亮くん、ちょっと話が――」",
        "message": "「亮同学，我有点事想和你说——」",
        "text_idx": [
            6721
        ]
    },
    {
        "name": "杏子",
        "name_idx": 6785,
        "ori": "「って、なにやってんの？」",
        "message": "「我说，你们在干什么呢？」",
        "text_idx": [
            6794
        ]
    },
    {
        "name": "亮",
        "name_idx": 6800,
        "ori": "「ぶ、部長、ヘルプ！」",
        "message": "「部、部长，救命啊！」",
        "text_idx": [
            6809
        ]
    },
    {
        "name": "杏子",
        "name_idx": 6925,
        "ori": "「にゃっはっは！　面白そうねぇ、あたしも混ぜろぉ～」",
        "message": "「呀哈哈哈！　看起来真有意思，也让我加入吧～」",
        "text_idx": [
            6934
        ]
    },
    {
        "name": "亮",
        "name_idx": 6980,
        "ori": "「ちょ、ちょっと、部長まで！？」",
        "message": "「等、等等，连部长也！？」",
        "text_idx": [
            6989
        ]
    },
    {
        "ori": "意気揚々と飛び込んできた部長は、俺の胴体を引っ張りだした。",
        "message": "兴高采烈地冲进来的部长，也开始拉扯起我的身体。",
        "text_idx": [
            7076,
            7077
        ]
    },
    {
        "name": "ことの",
        "name_idx": 7195,
        "ori": "「亮ちゃんは、私のぉ！」",
        "message": "「小亮是我的！」",
        "text_idx": [
            7204
        ]
    },
    {
        "name": "さつき",
        "name_idx": 7403,
        "ori": "「違うよ、私の！」",
        "message": "「不对，是我的！」",
        "text_idx": [
            7412
        ]
    },
    {
        "name": "杏子",
        "name_idx": 7567,
        "ori": "「わーい！」",
        "message": "「哇—咿！」",
        "text_idx": [
            7576
        ]
    },
    {
        "name": "亮",
        "name_idx": 7591,
        "ori": "「イテて、ちょっと三人とも、やめ……！」",
        "message": "「好疼，我说你们三个，快住手……！」",
        "text_idx": [
            7600
        ]
    },
    {
        "ori": "助けを求めようと智継に視線を送るが……",
        "message": "我向智继投去求助的视线，然而……",
        "text_idx": [
            7742
        ]
    },
    {
        "name": "智継",
        "name_idx": 7860,
        "ori": "「なんでお前、そんなモテモテなんだよ、ギィイイ！！」",
        "message": "「为什么你这家伙，会这么受欢迎啊，可恶！！」",
        "text_idx": [
            7869
        ]
    },
    {
        "ori": "ハンカチを噛み締める奴は、本格的に使い物にならなかった。",
        "message": "这个咬着手帕的家伙，看来是完全派不上用场了。",
        "text_idx": [
            7884,
            7885
        ]
    },
    {
        "name": "紬",
        "name_idx": 7949,
        "ori": "「亮くん……」",
        "message": "「亮君……」",
        "text_idx": [
            7958
        ]
    },
    {
        "name": "亮",
        "name_idx": 7964,
        "ori": "「ッハ！？」",
        "message": "「哈！？」",
        "text_idx": [
            7973
        ]
    },
    {
        "ori": "三人がうるさい中、その声はしっかり耳に届いた。",
        "message": "尽管三个人吵吵闹闹的，那个声音还是清晰地传进了我的耳朵里。",
        "text_idx": [
            7988
        ]
    },
    {
        "ori": "目がすわっている。怖い。怖いよ。",
        "message": "她的眼神不对劲。好可怕。好可怕啊。",
        "text_idx": [
            8047
        ]
    },
    {
        "name": "亮",
        "name_idx": 8053,
        "ori": "「紬さん、違う！　これは違うんだよ！」",
        "message": "「紬小姐，不是的！　这不是你想的那样！」",
        "text_idx": [
            8062
        ]
    },
    {
        "name": "紬",
        "name_idx": 8170,
        "ori": "「ふんっ！」",
        "message": "「哼！」",
        "text_idx": [
            8179
        ]
    },
    {
        "ori": "そっぽを向かれた。",
        "message": "她把脸撇向了一边。",
        "text_idx": [
            8194
        ]
    },
    {
        "ori": "ああ、そんな仕草も可愛らしい……じゃなくて！！",
        "message": "啊啊，连那样的动作都那么可爱……不对！！",
        "text_idx": [
            8209
        ]
    },
    {
        "name": "亮",
        "name_idx": 8215,
        "ori": "「紬さん……イテテ、やめろ三人とも！」",
        "message": "「紬小姐……好疼疼，你们三个快住手！」",
        "text_idx": [
            8224
        ]
    },
    {
        "name": "ことの",
        "name_idx": 8342,
        "ori": "「いやぁーだー」",
        "message": "「我不要嘛—」",
        "text_idx": [
            8351
        ]
    },
    {
        "name": "さつき",
        "name_idx": 8658,
        "ori": "「二人とも小松原くんを渡してよ！」",
        "message": "「你们两个快把小松原同学交给我！」",
        "text_idx": [
            8667
        ]
    },
    {
        "name": "杏子",
        "name_idx": 8930,
        "ori": "「わーい！」",
        "message": "「哇—咿！」",
        "text_idx": [
            8939
        ]
    },
    {
        "name": "智継",
        "name_idx": 9022,
        "ori": "「なんであいつだけなんであいつだけなんであいつだけなんで……」",
        "message": "「为什么只有那家伙为什么只有那家伙为什么只有那家伙为什么……」",
        "text_idx": [
            9031,
            9032
        ]
    },
    {
        "ori": "最悪だ。最悪過ぎる。",
        "message": "糟透了。简直是糟透了。",
        "text_idx": [
            9047
        ]
    },
    {
        "name": "亮",
        "name_idx": 9196,
        "ori": "「やめろぉおおおお……！！」",
        "message": "「住手啊啊啊啊啊……！！」",
        "text_idx": [
            9205
        ]
    },
    {
        "ori": "叫びもむなしく、それから暫く、俺の引っ張り合いは終わらなかった。",
        "message": "我的喊叫也是徒劳，在那之后的好一阵子，这场对我的争夺战都没有结束。",
        "text_idx": [
            9220,
            9221
        ]
    },
    {
        "name": "杏子",
        "name_idx": 9500,
        "ori": "「えー、ごほん。みんな落ち着いた所で、大事な話を」",
        "message": "「那个，咳哼。既然大家都冷静下来了，我就说件重要的事」",
        "text_idx": [
            9509
        ]
    },
    {
        "ori": "俺は満身創痍だった。心身ともに。",
        "message": "我已是满身疮痍。身心俱是。",
        "text_idx": [
            9524
        ]
    },
    {
        "name": "亮",
        "name_idx": 9530,
        "ori": "「紬さ――」",
        "message": "「紬——」",
        "text_idx": [
            9539
        ]
    },
    {
        "name": "紬",
        "name_idx": 9671,
        "ori": "「ぷいっ！」",
        "message": "「哼！」",
        "text_idx": [
            9680
        ]
    },
    {
        "ori": "紬さんが完全にむくれてる。",
        "message": "紬她彻底闹别扭了。",
        "text_idx": [
            9695
        ]
    },
    {
        "ori": "ショックだ。",
        "message": "我大受打击。",
        "text_idx": [
            9710
        ]
    },
    {
        "ori": "紬さんにそっぽを向かれる度に、精神力がごっそり削られた。",
        "message": "每当紬不理我的时候，我的精神力就会被大幅削减。",
        "text_idx": [
            9725,
            9726
        ]
    },
    {
        "name": "杏子",
        "name_idx": 9746,
        "ori": "「桜花展の締め切りが近いんだけど」",
        "message": "「樱华展的截止日期快到了」",
        "text_idx": [
            9755
        ]
    },
    {
        "name": "亮",
        "name_idx": 9761,
        "ori": "「紬さ――」",
        "message": "「紬——」",
        "text_idx": [
            9770
        ]
    },
    {
        "name": "紬",
        "name_idx": 9872,
        "ori": "「ぷいっ！！」",
        "message": "「哼！！」",
        "text_idx": [
            9881
        ]
    },
    {
        "name": "亮",
        "name_idx": 9887,
        "ori": "「ガーン」",
        "message": "「呃啊」",
        "text_idx": [
            9896
        ]
    },
    {
        "name": "杏子",
        "name_idx": 9960,
        "ori": "「亮くん聞いてる？」",
        "message": "「亮君，你在听吗？」",
        "text_idx": [
            9969
        ]
    },
    {
        "name": "亮",
        "name_idx": 9975,
        "ori": "「ええ、ああ、桜花展の締め切りですよね」",
        "message": "「嗯，啊啊，是樱华展的截止日期对吧」",
        "text_idx": [
            9984
        ]
    },
    {
        "name": "杏子",
        "name_idx": 10048,
        "ori": "「出せる？」",
        "message": "「能交吗？」",
        "text_idx": [
            10057
        ]
    },
    {
        "name": "亮",
        "name_idx": 10063,
        "ori": "「んー……」",
        "message": "「嗯……」",
        "text_idx": [
            10072
        ]
    },
    {
        "ori": "締め切りまでの期間を考える。",
        "message": "我思考着距离截止日期还剩多少时间。",
        "text_idx": [
            10087
        ]
    },
    {
        "ori": "描き上げられるかもしれないが、納得できるものにするには時間が足りなすぎる。",
        "message": "虽然可能画得完，但要想画出能让自己满意的作品，时间实在太少了。",
        "text_idx": [
            10102,
            10103
        ]
    },
    {
        "name": "亮",
        "name_idx": 10109,
        "ori": "「今年は、出品できないです……」",
        "message": "「今年，我没办法参展了……」",
        "text_idx": [
            10118
        ]
    },
    {
        "ori": "桜花展の存在を忘れていたわけじゃない。",
        "message": "我并不是忘了樱华展的存在。",
        "text_idx": [
            10133
        ]
    },
    {
        "ori": "これを言い訳にはしたくないのだが……",
        "message": "虽然我不想拿这个当借口……",
        "text_idx": [
            10148
        ]
    },
    {
        "ori": "紬さんとの事でどたばたしてしまって、結局作品に取り掛かれなかった。",
        "message": "因为和紬的事情弄得一团乱，结果我到最后都没能开始动笔。",
        "text_idx": [
            10163,
            10164
        ]
    },
    {
        "ori": "部長は残念そうな顔をして頷いた。",
        "message": "部长一脸遗憾地点了点头。",
        "text_idx": [
            10179
        ]
    },
    {
        "name": "杏子",
        "name_idx": 10243,
        "ori": "「そう、わかっ――」",
        "message": "「这样啊，我明——」",
        "text_idx": [
            10252
        ]
    },
    {
        "name": "紬",
        "name_idx": 10398,
        "ori": "「待ってください！」",
        "message": "「请等一下！」",
        "text_idx": [
            10407
        ]
    },
    {
        "name": "亮",
        "name_idx": 10413,
        "ori": "「紬さん！？」",
        "message": "「紬同学！？」",
        "text_idx": [
            10422
        ]
    },
    {
        "ori": "声を張り上げた紬さんに、一同きょとんとする。",
        "message": "紬同学突然大声说话，我们所有人都愣住了。",
        "text_idx": [
            10437
        ]
    },
    {
        "name": "紬",
        "name_idx": 10559,
        "ori": "「亮くん、出品する絵ならありますわ」",
        "message": "「亮同学，有可以参展的画呀」",
        "text_idx": [
            10568
        ]
    },
    {
        "name": "亮",
        "name_idx": 10574,
        "ori": "「え？」",
        "message": "「诶？」",
        "text_idx": [
            10583
        ]
    },
    {
        "name": "紬",
        "name_idx": 10647,
        "ori": "「私に描いてくださった絵です」",
        "message": "「就是你为我画的那幅画」",
        "text_idx": [
            10656
        ]
    },
    {
        "name": "亮",
        "name_idx": 10662,
        "ori": "「でも、あれは紬さんにプレゼントしたやつだし」",
        "message": "「可是，那是我送给紬同学的礼物啊……」",
        "text_idx": [
            10671
        ]
    },
    {
        "name": "紬",
        "name_idx": 10735,
        "ori": "「私はかまいませんわ」",
        "message": "「我没关系的呀」",
        "text_idx": [
            10744
        ]
    },
    {
        "name": "亮",
        "name_idx": 10750,
        "ori": "「でも……」",
        "message": "「可是……」",
        "text_idx": [
            10759
        ]
    },
    {
        "name": "紬",
        "name_idx": 10823,
        "ori": "「それとも、私を描いた絵では、自信がないと？」",
        "message": "「难道说，你对自己画了我的那幅画没有自信？」",
        "text_idx": [
            10832
        ]
    },
    {
        "ori": "鋭く睨まれる。",
        "message": "我被她狠狠地瞪着。",
        "text_idx": [
            10847
        ]
    },
    {
        "name": "亮",
        "name_idx": 10853,
        "ori": "「い、いや、そういうわけじゃ」",
        "message": "「不、不是，我不是那个意思」",
        "text_idx": [
            10862
        ]
    },
    {
        "name": "紬",
        "name_idx": 10926,
        "ori": "「では、決まりですわね」",
        "message": "「那么，就这么决定了呢」",
        "text_idx": [
            10935
        ]
    },
    {
        "name": "亮",
        "name_idx": 10941,
        "ori": "「……」",
        "message": "「……」",
        "text_idx": [
            10950
        ]
    },
    {
        "ori": "なんて鮮やかで軽やかな強引技だ……",
        "message": "多么漂亮又轻巧的强硬手段啊……",
        "text_idx": [
            10965
        ]
    },
    {
        "ori": "何も言い返せない。",
        "message": "我什么都反驳不了。",
        "text_idx": [
            10980
        ]
    },
    {
        "name": "杏子",
        "name_idx": 11044,
        "ori": "「亮くんは、それで決定ね。後はみんなだけど……」",
        "message": "「亮同学就这么决定了呢。剩下的就是大家了……」",
        "text_idx": [
            11053
        ]
    },
    {
        "ori": "その後、部活は変わらず、わいわいがやがやと賑やかに続いて、夕方に解散した。",
        "message": "之后，社团活动一如既往地吵吵闹闹、热热闹闹地进行着，到了傍晚才解散。",
        "text_idx": [
            11297,
            11298
        ]
    },
    {
        "name": "紬",
        "name_idx": 11896,
        "ori": "「……」",
        "message": "「……」",
        "text_idx": [
            11905
        ]
    },
    {
        "name": "亮",
        "name_idx": 11911,
        "ori": "「紬さん、どこへ行くんですか」",
        "message": "「紬同学，你要去哪里啊」",
        "text_idx": [
            11920
        ]
    },
    {
        "ori": "紬さんは俺の手を引っ張って歩き続ける。",
        "message": "紬同学拉着我的手，继续往前走。",
        "text_idx": [
            11935
        ]
    },
    {
        "name": "紬",
        "name_idx": 11955,
        "ori": "「黙って付いて来てください」",
        "message": "「请你别说话，跟我来」",
        "text_idx": [
            11964
        ]
    },
    {
        "name": "亮",
        "name_idx": 11970,
        "ori": "「まだ怒ってるんですか？」",
        "message": "「你还在生气吗？」",
        "text_idx": [
            11979
        ]
    },
    {
        "name": "紬",
        "name_idx": 11999,
        "ori": "「怒っていませんわ！」",
        "message": "「我才没有生气呢！」",
        "text_idx": [
            12008
        ]
    },
    {
        "ori": "怒ってる。絶対、怒ってるよ。",
        "message": "她生气了。绝对是生气了啊。",
        "text_idx": [
            12023
        ]
    },
    {
        "ori": "機嫌直ったと思ったのにな……",
        "message": "我还以为她气消了呢……",
        "text_idx": [
            12038
        ]
    },
    {
        "ori": "行き慣れた廊下を進む。",
        "message": "我们走在熟悉的走廊里。",
        "text_idx": [
            12142
        ]
    },
    {
        "ori": "どこに連れていかれているのか理解した。",
        "message": "我明白她要带我去哪儿了。",
        "text_idx": [
            12157
        ]
    },
    {
        "ori": "飛び込むように入る。",
        "message": "我们几乎是冲了进去。",
        "text_idx": [
            12328
        ]
    },
    {
        "name": "紬",
        "name_idx": 12348,
        "ori": "「亮くん……！」",
        "message": "「亮同学……！」",
        "text_idx": [
            12357
        ]
    },
    {
        "name": "亮",
        "name_idx": 12436,
        "ori": "「ごめんなさい！！」",
        "message": "「对不起！！」",
        "text_idx": [
            12445
        ]
    },
    {
        "ori": "どんな説教、体罰をされるのかと身構えたが、そんなものなかった。",
        "message": "我本已做好了被说教或体罚的准备，结果什么都没有发生。",
        "text_idx": [
            12474,
            12475
        ]
    },
    {
        "ori": "いや、それどころか、体が柔らかいものに包まれて、心地良ささえ感じた。",
        "message": "不，岂止如此，我的身体被柔软的东西包裹着，甚至还感到一丝惬意。",
        "text_idx": [
            12490,
            12491
        ]
    },
    {
        "name": "亮",
        "name_idx": 12609,
        "ori": "「紬さん？」",
        "message": "「紬小姐？」",
        "text_idx": [
            12618
        ]
    },
    {
        "name": "紬",
        "name_idx": 12682,
        "ori": "「私は、亮くんのものです……」",
        "message": "「我是属于亮同学的……」",
        "text_idx": [
            12691
        ]
    },
    {
        "ori": "紬さんは俺に抱きついて顔をうずめていた。",
        "message": "紬同学紧紧抱着我，把脸埋在我的怀里。",
        "text_idx": [
            12706
        ]
    },
    {
        "name": "紬",
        "name_idx": 12770,
        "ori": "「ですから……亮くんの私を……大事にしてください」",
        "message": "「所以……请好好珍惜……属于亮同学的我」",
        "text_idx": [
            12779
        ]
    },
    {
        "name": "亮",
        "name_idx": 12785,
        "ori": "「紬さん」",
        "message": "「紬小姐」",
        "text_idx": [
            12794
        ]
    },
    {
        "ori": "ピリピリとしていてほんのりと甘酸っぱい嫉妬。",
        "message": "这嫉妒带有些许刺痛，又有些微的酸甜。",
        "text_idx": [
            12809
        ]
    },
    {
        "ori": "その嫉妬に嬉しさを感じる。そして申し訳なさも。",
        "message": "我为她的嫉妒而感到高兴，但同时也心怀歉意。",
        "text_idx": [
            12824
        ]
    },
    {
        "ori": "謝罪の意味を込めて頭を撫でる。",
        "message": "我带着歉意，抚摸着她的头。",
        "text_idx": [
            12839
        ]
    },
    {
        "name": "紬",
        "name_idx": 12903,
        "ori": "「ふふ、やはり、留学しなくて良かったですわ」",
        "message": "「呵呵，果然，没有去留学真是太好了呢」",
        "text_idx": [
            12912
        ]
    },
    {
        "ori": "機嫌が直ったのか、紬さんは顔を上げて微笑む。",
        "message": "或许是气消了吧，紬同学抬起头，对我微笑着。",
        "text_idx": [
            12927
        ]
    },
    {
        "name": "紬",
        "name_idx": 12947,
        "ori": "「あちらこちらにフラフラと行ってしまう亮くんを放っておいたら、どうなってしまうことやら」",
        "message": "「要是对到处游移不定的亮同学放任不管的话，真不知道会怎么样呢」",
        "text_idx": [
            12956,
            12957
        ]
    },
    {
        "name": "亮",
        "name_idx": 12963,
        "ori": "「信用ないですねぇ」",
        "message": "「你也太不信任我了吧」",
        "text_idx": [
            12972
        ]
    },
    {
        "name": "紬",
        "name_idx": 13036,
        "ori": "「あら、よく言えますわね？」",
        "message": "「哎呀，亏你还说得出口呢？」",
        "text_idx": [
            13045
        ]
    },
    {
        "name": "亮",
        "name_idx": 13051,
        "ori": "「ごめんなさい……」",
        "message": "「对不起……」",
        "text_idx": [
            13060
        ]
    },
    {
        "ori": "紬さんはもう一度、俺の胸に顔を預けてくる。",
        "message": "紬同学再一次，将脸埋入我的怀中。",
        "text_idx": [
            13075
        ]
    },
    {
        "ori": "紬さんの腰に腕を回して、そっと抱きしめた。",
        "message": "我伸手环住紬同学的腰，轻轻地抱紧了她。",
        "text_idx": [
            13090
        ]
    },
    {
        "name": "紬",
        "name_idx": 13154,
        "ori": "「身体が熱いです……」",
        "message": "「身体好烫……」",
        "text_idx": [
            13163
        ]
    },
    {
        "name": "紬",
        "name_idx": 13183,
        "ori": "「亮くん、よろしいですか？」",
        "message": "「亮同学，可以吗？」",
        "text_idx": [
            13192
        ]
    },
    {
        "name": "亮",
        "name_idx": 13198,
        "ori": "「え？」",
        "message": "「诶？」",
        "text_idx": [
            13207
        ]
    }
]