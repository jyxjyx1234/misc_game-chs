[
    {
        "name": "亮",
        "name_idx": 104,
        "ori": "「し、しちゃったな……」",
        "message": "「做、做完了啊……」",
        "text_idx": [
            113
        ]
    },
    {
        "name": "ことの",
        "name_idx": 133,
        "ori": "「えへ、ちょっとだけ、痛かったな……」",
        "message": "「诶嘿，有那么一点点，疼呢……」",
        "text_idx": [
            142
        ]
    },
    {
        "name": "亮",
        "name_idx": 148,
        "ori": "「ごめん、無理させちゃったかもしれない……」",
        "message": "「抱歉，可能是我太勉强你了……」",
        "text_idx": [
            157
        ]
    },
    {
        "name": "ことの",
        "name_idx": 231,
        "ori": "「ううん、大丈夫。亮ちゃん優しくしてくれたもん……私幸せだよ」",
        "message": "「没有，没关系。小亮你很温柔的嘛……我很幸福哦」",
        "text_idx": [
            240,
            241
        ]
    },
    {
        "name": "亮",
        "name_idx": 256,
        "ori": "「こ、ことの……」",
        "message": "「琴、琴乃……」",
        "text_idx": [
            265
        ]
    },
    {
        "ori": "ついキスしてしまう。",
        "message": "我不禁吻了上去。",
        "text_idx": [
            324
        ]
    },
    {
        "name": "ことの",
        "name_idx": 388,
        "ori": "「……ん、もう、亮ちゃんったら子供みたい」",
        "message": "「……嗯，真是的，小亮你真像个小孩子」",
        "text_idx": [
            397
        ]
    },
    {
        "name": "亮",
        "name_idx": 403,
        "ori": "「う……」",
        "message": "「唔……」",
        "text_idx": [
            412
        ]
    },
    {
        "ori": "なんか俺、とても恥ずかしいことをしてるかも……",
        "message": "总感觉，我可能正在做什么很丢人的事……",
        "text_idx": [
            427
        ]
    },
    {
        "name": "ことの",
        "name_idx": 491,
        "ori": "「絵の続き、描く？」",
        "message": "「要继续画画吗？」",
        "text_idx": [
            500
        ]
    },
    {
        "name": "亮",
        "name_idx": 506,
        "ori": "「それは……いや、今日はやめておこう」",
        "message": "「那个……不，今天就算了吧」",
        "text_idx": [
            515
        ]
    },
    {
        "ori": "気持ちがふわふわして、さっきまでとは別の意味で落ち着かない。",
        "message": "我的心情轻飘飘的，和刚才又是另一种意义上的静不下心来。",
        "text_idx": [
            530,
            531
        ]
    },
    {
        "name": "亮",
        "name_idx": 537,
        "ori": "「ことのも疲れてるだろ？　俺もちょっと疲れたし」",
        "message": "「琴乃你也累了吧？　我也有些累了」",
        "text_idx": [
            546
        ]
    },
    {
        "name": "ことの",
        "name_idx": 711,
        "ori": "「そっかぁ、じゃあ今日はここまでだね……じゃあ……今日は、泊まってく？」",
        "message": "「是吗，那今天就到这里吧……那……今天，要住下来吗？」",
        "text_idx": [
            720,
            721
        ]
    },
    {
        "name": "亮",
        "name_idx": 794,
        "ori": "「えっ……それって……」",
        "message": "「诶……你的意思是……」",
        "text_idx": [
            803
        ]
    },
    {
        "ori": "思わず、淫猥な想像をしてしまった。",
        "message": "我不禁产生了猥琐的想象。",
        "text_idx": [
            818
        ]
    },
    {
        "name": "亮",
        "name_idx": 824,
        "ori": "「きょ、今日は帰るよ。また明日、起こしにくるからな」",
        "message": "「今、今天我就回去了。明天我再来叫你起床」",
        "text_idx": [
            833
        ]
    },
    {
        "name": "ことの",
        "name_idx": 970,
        "ori": "「うん、じゃあね、おやすみ、亮ちゃん」",
        "message": "「嗯，那么再见，晚安，小亮」",
        "text_idx": [
            979
        ]
    },
    {
        "name": "亮",
        "name_idx": 994,
        "ori": "「あ、ああ、おやすみ、ことの」",
        "message": "「啊，嗯，晚安，琴乃」",
        "text_idx": [
            1003
        ]
    },
    {
        "ori": "そして俺は、晴乃さんたちへの挨拶もそこそこに、青桐家を飛び出したのだった。",
        "message": "就这样，我匆匆和晴乃她们打了声招呼，便飞奔出了青桐家。",
        "text_idx": [
            1126,
            1127
        ]
    },
    {
        "ori": "大声を出して、頭をかきむしりたくなる衝動を必死に抑えながら。",
        "message": "我拼命抑制住想要大吼大叫、抓挠头发的冲动。",
        "text_idx": [
            1142,
            1143
        ]
    }
]