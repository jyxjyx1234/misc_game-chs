[
    {
        "ori": "……………………………………………………………………",
        "message": "……………………………………………………………………",
        "text_idx": [
            241
        ]
    },
    {
        "ori": "カツカツカツ、と白墨が黒板を叩く一定したリズムが、子守歌のように眠気を誘う。",
        "message": "粉笔敲击黑板的哒哒哒声，固定的节奏宛如摇篮曲一般，诱人入睡。",
        "text_idx": [
            256,
            257
        ]
    },
    {
        "ori": "…………………………………………",
        "message": "…………………………………………",
        "text_idx": [
            272
        ]
    },
    {
        "ori": "今日の授業は、夢とこっちとを行ったり来たりだったが、午前最後のこの授業にいたっては、もうほとんど夢の世界の住人だ。",
        "message": "今天的课，我一直在梦境与现实之间来回穿梭，而到了上午这最后一节课，我更是几乎成了梦中世界的居民。",
        "text_idx": [
            287,
            288,
            289
        ]
    },
    {
        "ori": "………………",
        "message": "………………",
        "text_idx": [
            367
        ]
    },
    {
        "ori": "無理に起きたりしないで、いっそどれかの授業で目一杯居眠りしておけば良かったかも……",
        "message": "或许当初不该硬撑着不睡，干脆挑一节课好好打个盹就好了……",
        "text_idx": [
            382,
            383
        ]
    },
    {
        "ori": "先生が何か言ってるけれど、何を言ってるのか全然聞き取れない。",
        "message": "老师像是在说着什么，可我完全听不清内容。",
        "text_idx": [
            466,
            467
        ]
    },
    {
        "ori": "そもそも今は、なんの授業なんだっけ？",
        "message": "话说回来，现在上的是什么课来着？",
        "text_idx": [
            482
        ]
    },
    {
        "ori": "まあ、いいや……眠いし……",
        "message": "嘛，算了……好困啊……",
        "text_idx": [
            497
        ]
    },
    {
        "ori": "………………",
        "message": "………………",
        "text_idx": [
            580
        ]
    },
    {
        "ori": "…………………………………………",
        "message": "…………………………………………",
        "text_idx": [
            663
        ]
    },
    {
        "ori": "……………………………………………………………………",
        "message": "……………………………………………………………………",
        "text_idx": [
            746
        ]
    },
    {
        "ori": "…………………………………………",
        "message": "…………………………………………",
        "text_idx": [
            843
        ]
    },
    {
        "ori": "……んんん？",
        "message": "……嗯嗯嗯？",
        "text_idx": [
            954
        ]
    },
    {
        "ori": "かすかに聞こえた、喉を絞められている鳩の鳴き声みたいな音に（鳩がそんな声を出すかは知らないけど）、意識が再覚醒した。",
        "message": "隐约听到的、如同被掐住喉咙的鸽子般的叫声（虽然我也不知道鸽子会不会发出那种声音），让我的意识再度清醒了过来。",
        "text_idx": [
            1057,
            1058,
            1059
        ]
    },
    {
        "ori": "朝食が、晴乃さんから貰ったおにぎりをことのと１個ずつ分け合っただけだったから……",
        "message": "因为早饭，只是和琴乃一人一个地分吃了晴乃给的饭团而已……",
        "text_idx": [
            1074,
            1075
        ]
    },
    {
        "ori": "そういえば腹減ったな……",
        "message": "说起来，我肚子饿了啊……",
        "text_idx": [
            1090
        ]
    },
    {
        "ori": "そんなに何度も空腹を主張するなよ、と自分のお腹を押さえて……音の源が自分ではないと気付いた。",
        "message": "我按住自己的肚子，心想你也别老是叫饿啊……随即才发现，声音的源头并不是自己。",
        "text_idx": [
            1119,
            1120
        ]
    },
    {
        "ori": "「まさかことのじゃないだろうな……？」",
        "message": "「不会是琴乃吧……？」",
        "text_idx": [
            1164
        ]
    },
    {
        "ori": "「誰でもいいか……」",
        "message": "「谁都行吧……」",
        "text_idx": [
            1184
        ]
    },
    {
        "ori": "誰でもいいや……俺じゃないなら……おやすみ……",
        "message": "是谁都无所谓了……只要不是我就行……晚安……",
        "text_idx": [
            1250
        ]
    },
    {
        "ori": "ぐぅ。",
        "message": "咕。",
        "text_idx": [
            1345
        ]
    },
    {
        "ori": "………………",
        "message": "………………",
        "text_idx": [
            1360
        ]
    },
    {
        "ori": "…………………………………………",
        "message": "…………………………………………",
        "text_idx": [
            1375
        ]
    },
    {
        "ori": "……………………………………………………………………",
        "message": "……………………………………………………………………",
        "text_idx": [
            1390
        ]
    },
    {
        "ori": "次に意識を取り戻したのは授業が終わって先生もいなくなり、教室がすっかり昼休みモードになってからだった。",
        "message": "我再次恢复意识时，已经是课上完老师离开，教室里完全进入午休模式之后了。",
        "text_idx": [
            1501,
            1502
        ]
    },
    {
        "ori": "クゥ～",
        "message": "咕～",
        "text_idx": [
            1531
        ]
    },
    {
        "ori": "今の音は、間違いなく俺の腹だったな……",
        "message": "刚才的声音，毫无疑问是我的肚子发出来的……",
        "text_idx": [
            1546
        ]
    },
    {
        "ori": "腹は減ったけど、今日は弁当がないし……それに、まだ眠い……",
        "message": "虽然肚子饿了，但今天没带便当……而且，还很困……",
        "text_idx": [
            1561,
            1562
        ]
    },
    {
        "ori": "うーん、どうしようか？",
        "message": "唔，该怎么办呢？",
        "text_idx": [
            1577
        ]
    },
    {
        "ori": "「パンを買って静かな場所で食べるか……」",
        "message": "「买面包去安静的地方吃吧……」",
        "text_idx": [
            1623
        ]
    },
    {
        "ori": "「このまま寝直そう……」",
        "message": "「就这样继续睡吧……」",
        "text_idx": [
            1643
        ]
    },
    {
        "ori": "「第二美術室なら邪魔されずに寝られるかな……」",
        "message": "「在第二美术室的话能安心睡觉吧……」",
        "text_idx": [
            1663
        ]
    },
    {
        "ori": "「先に立花先輩にイラストを届けよう」",
        "message": "「先把插画送给立花前辈吧」",
        "text_idx": [
            1683
        ]
    }
]