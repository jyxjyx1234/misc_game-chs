[
    {
        "ori": "美術室でさつきが『瑞穂展』の製作を続けている間、俺は自分の制作を自宅のアトリエで続けていた。",
        "message": "在纱月于美术室继续进行『瑞穗展』的创作期间，我则在自家的画室里继续着我自己的创作。",
        "text_idx": [
            853,
            854
        ]
    },
    {
        "ori": "さつきも真剣だし、俺も真剣だ……特にハードルが尋常じゃないだけに、キャンバスを前に苦悩し続ける姿を、さつきに見せたくないのも事実だった。",
        "message": "纱月很认真，我也很认真……正因为挑战的难度非同寻常，我不想让纱月看到我在画布前不断苦恼的样子，这也是事实。",
        "text_idx": [
            869,
            870,
            871
        ]
    },
    {
        "ori": "会う回数は極端に減ったが、昼の休憩時間や放課後の美術室でお互いに見交わす。",
        "message": "我们见面的次数急剧减少，但会在午休时间或放学后的美术室里与彼此对视。",
        "text_idx": [
            886,
            887
        ]
    },
    {
        "ori": "さつきの笑顔を見れば、俺とさつきの絆が確たるものであることを思い出させてくれた。",
        "message": "只要看到纱月的笑容，就能让我回想起我和纱月之间的羁绊是多么牢固。",
        "text_idx": [
            902,
            903
        ]
    },
    {
        "ori": "昨晩も俺はアトリエで遅くまで制作に勤しんでいた。そして、玄関のチャイムで目を覚ました時には、既に昼を回っていた。",
        "message": "昨晚我也在画室里埋头创作到很晚。然后，当我被门铃声吵醒时，时间已经过了中午。",
        "text_idx": [
            918,
            919,
            920
        ]
    },
    {
        "name": "さつき",
        "name_idx": 1096,
        "ori": "「……亮くん、おはよう？」",
        "message": "「……亮君，早上好？」",
        "text_idx": [
            1105
        ]
    },
    {
        "name": "亮",
        "name_idx": 1111,
        "ori": "「……あぁ、今、起きたところ……あれ……？　さつき……制作は？」",
        "message": "「……啊，我刚醒……咦……？　纱月……你的创作呢？」",
        "text_idx": [
            1120,
            1121
        ]
    },
    {
        "ori": "さつきは黙って、笑顔で俺を見ている。",
        "message": "纱月沉默着，微笑着看着我。",
        "text_idx": [
            1136
        ]
    },
    {
        "name": "亮",
        "name_idx": 1142,
        "ori": "「もしかして……完成したの？」",
        "message": "「难道说……你画完了？」",
        "text_idx": [
            1151
        ]
    },
    {
        "name": "さつき",
        "name_idx": 1225,
        "ori": "「うん……」",
        "message": "「嗯……」",
        "text_idx": [
            1234
        ]
    },
    {
        "name": "亮",
        "name_idx": 1240,
        "ori": "「……おつかれさまっ！」",
        "message": "「……辛苦了！」",
        "text_idx": [
            1249
        ]
    },
    {
        "name": "さつき",
        "name_idx": 1313,
        "ori": "「ありがとう……って、問題はこれから……」",
        "message": "「谢谢……不过，问题才刚刚开始……」",
        "text_idx": [
            1322
        ]
    },
    {
        "name": "亮",
        "name_idx": 1328,
        "ori": "「……そうだな、人事を尽くしたんだから、ね」",
        "message": "「……是啊，毕竟已经尽力了嘛」",
        "text_idx": [
            1337
        ]
    },
    {
        "name": "さつき",
        "name_idx": 1688,
        "ori": "「亮くん……今日はひま……？」",
        "message": "「亮君……今天有空……吗？」",
        "text_idx": [
            1697
        ]
    },
    {
        "name": "亮",
        "name_idx": 1703,
        "ori": "「あぁ、俺の締め切りはもっと先だからね」",
        "message": "「啊，我的截稿日还早着呢」",
        "text_idx": [
            1712
        ]
    },
    {
        "name": "さつき",
        "name_idx": 1785,
        "ori": "「あの、デ、デートしない……？」",
        "message": "「那个，要、要不要去约会……？」",
        "text_idx": [
            1794
        ]
    },
    {
        "name": "亮",
        "name_idx": 1800,
        "ori": "「デートか……久々だね！そっか！　行こう！　行こう！」",
        "message": "「约会啊……好久没去了呢！这样啊！　走吧！　我们走！」",
        "text_idx": [
            1809,
            1810
        ]
    },
    {
        "ori": "俺はさつきに行き先を考えておいてもらっている間に、シャワーを浴びて玄関にとって返した。",
        "message": "我让纱月先考虑着要去哪里，自己则去冲了个澡，然后回到了玄关。",
        "text_idx": [
            1825,
            1826
        ]
    },
    {
        "name": "亮",
        "name_idx": 1921,
        "ori": "「ごめん、遅くなって……」",
        "message": "「抱歉，让你久等了……」",
        "text_idx": [
            1930
        ]
    },
    {
        "name": "さつき",
        "name_idx": 1994,
        "ori": "「……早くない？」",
        "message": "「……这也太快了吧？」",
        "text_idx": [
            2003
        ]
    },
    {
        "name": "亮",
        "name_idx": 2009,
        "ori": "「いや、普通にシャワー浴びてきただけだよ」",
        "message": "「没有啊，我只是普通地冲了个澡而已」",
        "text_idx": [
            2018
        ]
    },
    {
        "name": "さつき",
        "name_idx": 2082,
        "ori": "「うっそーっ、早いよ早い……私なんかシャワーから支度終わるのに、一時間ぐらいはかかるよ……」",
        "message": "「骗人——，太快了太快了……我从冲澡到准备好出门，大概要花一个小时呢……」",
        "text_idx": [
            2091,
            2092,
            2093
        ]
    },
    {
        "name": "亮",
        "name_idx": 2099,
        "ori": "「それは、女の子だからじゃない？　男は支度らしい支度はないし……ところで、行き先決まった？」",
        "message": "「那是因为你是女孩子吧？　男生没什么好准备的……话说回来，决定好去哪儿了吗？」",
        "text_idx": [
            2108,
            2109
        ]
    },
    {
        "name": "さつき",
        "name_idx": 2173,
        "ori": "「あっ……が、学園行きたいかな？」",
        "message": "「啊……我、我想去学园，可以吗？」",
        "text_idx": [
            2182
        ]
    },
    {
        "name": "亮",
        "name_idx": 2188,
        "ori": "「えっ……！？　でも、もしかして……昨日の深夜ぐらいまで、学園にいたんじゃないの？」",
        "message": "「欸……！？　可是，你不是……直到昨天半夜，都待在学园里吗？」",
        "text_idx": [
            2197,
            2198
        ]
    },
    {
        "ori": "さつきはコクリと頷いた。",
        "message": "纱月轻轻点了点头。",
        "text_idx": [
            2267
        ]
    },
    {
        "name": "さつき",
        "name_idx": 2331,
        "ori": "「……そうだけど……なんとなく」",
        "message": "「……是这样没错……但就是想去」",
        "text_idx": [
            2340
        ]
    },
    {
        "name": "亮",
        "name_idx": 2346,
        "ori": "「公園とかさ……他にどこか無い？　行きたい場所？」",
        "message": "「去公园什么的……就没有其他想去的地方了吗？」",
        "text_idx": [
            2355
        ]
    },
    {
        "name": "さつき",
        "name_idx": 2419,
        "ori": "「……………………ないかも」",
        "message": "「……………………好像没有呢」",
        "text_idx": [
            2428
        ]
    },
    {
        "name": "亮",
        "name_idx": 2434,
        "ori": "「……わかった、学園に行こう」",
        "message": "「……我知道了，就去学园吧」",
        "text_idx": [
            2443
        ]
    },
    {
        "ori": "俺たちは、さつきの希望で、学園に『デート』しに行くことになった……",
        "message": "就这样，我们应纱月的要求，决定去学园『约会』了……",
        "text_idx": [
            2502,
            2503
        ]
    },
    {
        "name": "亮",
        "name_idx": 2577,
        "ori": "「しかし……学園でデートってさ、なんか……ロマンチックさに欠けてないかな？」",
        "message": "「不过……在学园约会，总觉得……是不是有点缺少浪漫气息啊？」",
        "text_idx": [
            2586,
            2587
        ]
    },
    {
        "name": "さつき",
        "name_idx": 2651,
        "ori": "「……そう？」",
        "message": "「……是吗？」",
        "text_idx": [
            2660
        ]
    },
    {
        "name": "亮",
        "name_idx": 2666,
        "ori": "「……そうでもない？」",
        "message": "「……不是吗？」",
        "text_idx": [
            2675
        ]
    },
    {
        "name": "さつき",
        "name_idx": 2739,
        "ori": "「……本当は思いつかなかったの」",
        "message": "「……其实是我没想出来要去哪」",
        "text_idx": [
            2748
        ]
    },
    {
        "ori": "さつきは苦笑いしながら、俺に謝った。",
        "message": "纱月苦笑着向我道歉。",
        "text_idx": [
            2763
        ]
    },
    {
        "name": "さつき",
        "name_idx": 2783,
        "ori": "「本当は公園でも、美術館でも、どこでも良かったんだけど……亮くんと出会って、楽しかったことが多いから……つい」",
        "message": "「其实去公园也好，去美术馆也好，去哪里都行……但是和你相遇后，在这里有很多开心的回忆……所以就不由自主地……」",
        "text_idx": [
            2792,
            2793,
            2794
        ]
    },
    {
        "name": "亮",
        "name_idx": 2800,
        "ori": "「そう言われると……確かに、俺もそうかもしれないな。お互い美術室に遅くまで残って、屋上で息抜きして……なんだかデートでスケッチしたよりもしっくり来るかな？」",
        "message": "「经你这么一说……确实，我可能也是这么想的。我们一起在美术室待到很晚，在天台上放松……总感觉比起约会时去写生，这样反而更像我们呢？」",
        "text_idx": [
            2809,
            2810,
            2811
        ]
    },
    {
        "name": "さつき",
        "name_idx": 2875,
        "ori": "「やっぱり？」",
        "message": "「果然？」",
        "text_idx": [
            2884
        ]
    },
    {
        "name": "亮",
        "name_idx": 2890,
        "ori": "「うん、二人の……思い出の場所としては、ある意味、丁度いいのかもしれないね」",
        "message": "「嗯，作为我们两人的……充满回忆的地方，从某种意义上来说，或许正好呢」",
        "text_idx": [
            2899,
            2900
        ]
    },
    {
        "name": "さつき",
        "name_idx": 3242,
        "ori": "「うん！」",
        "message": "「嗯！」",
        "text_idx": [
            3251
        ]
    },
    {
        "name": "亮",
        "name_idx": 3257,
        "ori": "「それじゃ、行こうか？」",
        "message": "「那么，我们走吧？」",
        "text_idx": [
            3266
        ]
    },
    {
        "ori": "俺はさつきの手を取ると、学校に向かうべく玄関を出た。",
        "message": "我牵起纱月的手，为了前往学校，走出了玄关。",
        "text_idx": [
            3281
        ]
    }
]