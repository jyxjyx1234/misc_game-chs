[
    {
        "ori": "美術部ミスコンも終わり、ようやく解放された俺は、暇そうにしていた此ノ花さんの手を取って、他の部やクラスが実施している模擬店巡りを開始した。",
        "message": "美术部选美比赛也结束了，终于获得解放的我，牵起看起来很闲的此之花同学的手，开始逛起了其他社团和班级开的模拟店。",
        "text_idx": [
            76,
            77,
            78
        ]
    },
    {
        "name": "円",
        "name_idx": 371,
        "ori": "「そう言えば……、小松原くんはクラスの手伝いをしないでいいの？」",
        "message": "「说起来……，小松原同学不用去班上帮忙也可以吗？」",
        "text_idx": [
            380,
            381
        ]
    },
    {
        "name": "亮",
        "name_idx": 387,
        "ori": "「しないでいいというか……部活に入っている人間は、そっち優先になるしね」",
        "message": "「也不是说可以不去……参加了社团活动的人，都是社团优先啦」",
        "text_idx": [
            396,
            397
        ]
    },
    {
        "name": "円",
        "name_idx": 515,
        "ori": "「そっか……」",
        "message": "「这样啊……」",
        "text_idx": [
            524
        ]
    },
    {
        "name": "亮",
        "name_idx": 530,
        "ori": "「それに、撫子芸術祭があるから、芸術関係の部活に入っていると、自動的にもうクラスの方には関われなくなる」",
        "message": "「而且，因为有抚子艺术节，所以参加了艺术相关社团的话，就自动没法再参与班级那边的事情了」",
        "text_idx": [
            539,
            540
        ]
    },
    {
        "name": "円",
        "name_idx": 658,
        "ori": "「そうなんだ……なんだか、ちょっとつまんないね」",
        "message": "「是这样啊……总觉得，有点没意思呢」",
        "text_idx": [
            667
        ]
    },
    {
        "name": "亮",
        "name_idx": 673,
        "ori": "「そう？」",
        "message": "「是吗？」",
        "text_idx": [
            682
        ]
    },
    {
        "name": "円",
        "name_idx": 800,
        "ori": "「だって、せっかくの学園祭なのに、ほとんどお客としてしか参加出来ないじゃない？」",
        "message": "「因为，明明是难得的学园祭，却几乎只能作为客人来参加，不是吗？」",
        "text_idx": [
            809,
            810
        ]
    },
    {
        "name": "亮",
        "name_idx": 816,
        "ori": "「んー……でも、美術部の方があるから、関係ないかな」",
        "message": "「嗯……不过，因为有美术部这边的事情，所以也没什么关系吧」",
        "text_idx": [
            825
        ]
    },
    {
        "name": "円",
        "name_idx": 943,
        "ori": "「そっか……そうだね」",
        "message": "「这样啊……说得也是呢」",
        "text_idx": [
            952
        ]
    },
    {
        "name": "亮",
        "name_idx": 958,
        "ori": "「なんにしても、今は色々と楽しんじゃお！」",
        "message": "「不管怎样，我们现在就尽情享受吧！」",
        "text_idx": [
            967
        ]
    },
    {
        "name": "円",
        "name_idx": 1085,
        "ori": "「そうだねー！」",
        "message": "「是啊—！」",
        "text_idx": [
            1094
        ]
    },
    {
        "ori": "そして、俺たちは模擬店を色々と回った。",
        "message": "于是，我们逛了各种各样的模拟店。",
        "text_idx": [
            1182
        ]
    },
    {
        "ori": "金魚すくい、射的、輪投げ。",
        "message": "捞金鱼、射击、套圈。",
        "text_idx": [
            1197
        ]
    },
    {
        "ori": "どれをやっても、此ノ花さんは楽しそうで、俺たち二人は子供のようにハシャぎまくった。",
        "message": "无论玩哪个项目，此之花同学都看起来很开心，我们两个人像孩子一样玩疯了。",
        "text_idx": [
            1212,
            1213
        ]
    },
    {
        "ori": "一緒にいるだけで、時間を忘れてしまうくらいだった。",
        "message": "光是待在一起，就足以让我们忘记时间的流逝。",
        "text_idx": [
            1228
        ]
    },
    {
        "ori": "そう。彼女は、なんでも楽しんでいるように見えた。",
        "message": "没错。她看起来，无论什么事都很享受的样子。",
        "text_idx": [
            1243
        ]
    },
    {
        "name": "円",
        "name_idx": 1395,
        "ori": "「もう、お祭りはおしまいかぁ……」",
        "message": "「祭典这就结束了啊……」",
        "text_idx": [
            1404
        ]
    },
    {
        "ori": "屋上に上がり、やや傾きかけた日差しに染まる校庭を見下ろしながら、此ノ花さんはちょっと残念そうな声を出した。",
        "message": "登上天台，俯瞰着被西斜的阳光染色的校园，此之花同学用略带遗憾的声音说道。",
        "text_idx": [
            1419,
            1420,
            1421
        ]
    },
    {
        "name": "亮",
        "name_idx": 1427,
        "ori": "「そうだね……」",
        "message": "「是啊……」",
        "text_idx": [
            1436
        ]
    },
    {
        "name": "亮",
        "name_idx": 1442,
        "ori": "「これだけ楽しかった学祭は、初めて……かな」",
        "message": "「这么开心的学园祭，还是第一次……吧」",
        "text_idx": [
            1451
        ]
    },
    {
        "name": "円",
        "name_idx": 1515,
        "ori": "「そうなんだ」",
        "message": "「是这样啊」",
        "text_idx": [
            1524
        ]
    },
    {
        "name": "円",
        "name_idx": 1588,
        "ori": "「それってさぁ……」",
        "message": "「那个啊……」",
        "text_idx": [
            1597
        ]
    },
    {
        "name": "亮",
        "name_idx": 1603,
        "ori": "「なに？」",
        "message": "「什么？」",
        "text_idx": [
            1612
        ]
    },
    {
        "name": "円",
        "name_idx": 1676,
        "ori": "「ボクがいたから？」",
        "message": "「是因为有我在吗？」",
        "text_idx": [
            1685
        ]
    },
    {
        "ori": "そう来ると思った……",
        "message": "我就知道你会这么说……",
        "text_idx": [
            1700
        ]
    },
    {
        "name": "亮",
        "name_idx": 1706,
        "ori": "「まぁ……ね」",
        "message": "「算是……吧」",
        "text_idx": [
            1715
        ]
    },
    {
        "name": "円",
        "name_idx": 1779,
        "ori": "「あやや。認めちゃうんだぁ……」",
        "message": "「哎呀呀。居然承认了啊……」",
        "text_idx": [
            1788
        ]
    },
    {
        "name": "亮",
        "name_idx": 1794,
        "ori": "「なんて言うか、色んなわだかまりを解いてくれたのは、此ノ花さんだった気がするから……」",
        "message": "「该怎么说呢，因为我感觉，是此之花同学帮我解开了各种各样的心结……」",
        "text_idx": [
            1803,
            1804
        ]
    },
    {
        "name": "円",
        "name_idx": 1868,
        "ori": "「ホレた！？」",
        "message": "「你爱上我了！？」",
        "text_idx": [
            1877
        ]
    },
    {
        "name": "亮",
        "name_idx": 1883,
        "ori": "「それとは別」",
        "message": "「和那个是两码事」",
        "text_idx": [
            1892
        ]
    },
    {
        "name": "円",
        "name_idx": 1956,
        "ori": "「なんだぁ……つまんないのぉ……」",
        "message": "「什么嘛……真无聊啊……」",
        "text_idx": [
            1965
        ]
    },
    {
        "name": "亮",
        "name_idx": 1971,
        "ori": "「でも、ホント……感謝している」",
        "message": "「不过，我真的……很感谢你」",
        "text_idx": [
            1980
        ]
    },
    {
        "ori": "俺の言葉に彼女は驚いたような顔をして、次いでニッコリと笑ってくれた。",
        "message": "听到我的话，她先是一脸惊讶，接着又对我灿烂地笑了。",
        "text_idx": [
            1995,
            1996
        ]
    },
    {
        "name": "円",
        "name_idx": 2060,
        "ori": "「そっかぁ……でも、そう言ってもらえるのなら、ここまで来た甲斐があったってものね」",
        "message": "「是嘛……不过，你能这么说的话，我来到这里也算是值了呢」",
        "text_idx": [
            2069,
            2070
        ]
    },
    {
        "name": "円",
        "name_idx": 2134,
        "ori": "「お祭り騒ぎをしに来ただけにならなくて……よかった」",
        "message": "「结果不只是来凑一场热闹……真是太好了」",
        "text_idx": [
            2143
        ]
    },
    {
        "ori": "一瞬よぎる、寂しさの色合い。",
        "message": "一瞬间，寂寞的情绪涌上心头。",
        "text_idx": [
            2158
        ]
    },
    {
        "ori": "そう……だ。",
        "message": "是……啊。",
        "text_idx": [
            2173
        ]
    },
    {
        "ori": "此ノ花さんはここの学生じゃない。",
        "message": "此之花同学不是这里的学生。",
        "text_idx": [
            2188
        ]
    },
    {
        "ori": "芸術祭が終わってしまえば……後は……",
        "message": "艺术节一结束……之后……",
        "text_idx": [
            2203
        ]
    },
    {
        "name": "亮",
        "name_idx": 2209,
        "ori": "「そう言えば……帰っちゃうのかな？」",
        "message": "「说起来……你要回去了吗？」",
        "text_idx": [
            2218
        ]
    },
    {
        "name": "円",
        "name_idx": 2238,
        "ori": "「まぁねぇ……」",
        "message": "「算是吧……」",
        "text_idx": [
            2247
        ]
    },
    {
        "name": "亮",
        "name_idx": 2253,
        "ori": "「もう、帰っちゃうの？」",
        "message": "「这么快就要回去了吗？」",
        "text_idx": [
            2262
        ]
    },
    {
        "name": "円",
        "name_idx": 2326,
        "ori": "「んー。学園の交換留学生みたいなもんだし、今日のお祭りの後片付けが終わってから、キリのいい所までは、もうちょっといると思うけど……」",
        "message": "「嗯—。我毕竟也算是学园的交换留学生，等今天艺术节的善后工作结束，到告一段落为止，我觉得我还会再待上一段时间吧……」",
        "text_idx": [
            2335,
            2336,
            2337
        ]
    },
    {
        "name": "亮",
        "name_idx": 2343,
        "ori": "「そう……なのか……」",
        "message": "「是……这样啊……」",
        "text_idx": [
            2352
        ]
    },
    {
        "ori": "この芸術祭準備の間中、四六時中バカ騒ぎをして顔を合わせていたから……",
        "message": "因为在准备艺术节的这段时间里，我们一天到晚都在一起打打闹闹，所以……",
        "text_idx": [
            2367,
            2368
        ]
    },
    {
        "ori": "なんか……このまま撫子にいるのが当然って思っていた。",
        "message": "总觉得……我已经理所当然地认为，你会一直待在抚子了。",
        "text_idx": [
            2383
        ]
    },
    {
        "name": "円",
        "name_idx": 2447,
        "ori": "「寂しく……なっちゃうね」",
        "message": "「会变得很寂寞……呢」",
        "text_idx": [
            2456
        ]
    },
    {
        "name": "亮",
        "name_idx": 2462,
        "ori": "「そうだね……」",
        "message": "「是啊……」",
        "text_idx": [
            2471
        ]
    },
    {
        "name": "円",
        "name_idx": 2535,
        "ori": "「せっかく……友達になれたのに……ね」",
        "message": "「我们好不容易……才成为朋友……呢」",
        "text_idx": [
            2544
        ]
    },
    {
        "name": "亮",
        "name_idx": 2550,
        "ori": "「そうだね……」",
        "message": "「是啊……」",
        "text_idx": [
            2559
        ]
    },
    {
        "name": "円",
        "name_idx": 2623,
        "ori": "「もうちょっと、気が利く返事はないの？」",
        "message": "「你就不能给个更机灵点的回复吗？」",
        "text_idx": [
            2632
        ]
    },
    {
        "name": "亮",
        "name_idx": 2638,
        "ori": "「あ……ゴメン。ちょっと、ショック受けてた」",
        "message": "「啊……抱歉。我有点受打击了」",
        "text_idx": [
            2647
        ]
    },
    {
        "name": "円",
        "name_idx": 2711,
        "ori": "「ボクと離ればなれになっちゃうことに？」",
        "message": "「是因为要和我分开了？」",
        "text_idx": [
            2720
        ]
    },
    {
        "name": "亮",
        "name_idx": 2726,
        "ori": "「まぁ……ね」",
        "message": "「算是……吧」",
        "text_idx": [
            2735
        ]
    },
    {
        "name": "円",
        "name_idx": 2799,
        "ori": "「愛しちゃってた？」",
        "message": "「你爱上我了？」",
        "text_idx": [
            2808
        ]
    },
    {
        "name": "亮",
        "name_idx": 2814,
        "ori": "「それはない」",
        "message": "「那倒没有」",
        "text_idx": [
            2823
        ]
    },
    {
        "name": "円",
        "name_idx": 2887,
        "ori": "「もう、恥ずかしがらなくてもいいのにぃ……」",
        "message": "「真是的，又没什么好丢人的……」",
        "text_idx": [
            2896
        ]
    },
    {
        "ori": "ふざける声にも、どこかいつもの明るさはなかった。",
        "message": "她开玩笑的声音里，也缺少了往日的那份开朗。",
        "text_idx": [
            2911
        ]
    },
    {
        "ori": "やっぱり、此ノ花さんも俺と同じく寂しさを感じているんだろう……",
        "message": "果然，此之花同学也和我一样感到寂寞吧……",
        "text_idx": [
            2926,
            2927
        ]
    },
    {
        "name": "円",
        "name_idx": 2991,
        "ori": "「ボクは、役に立った？」",
        "message": "「我，帮上忙了吗？」",
        "text_idx": [
            3000
        ]
    },
    {
        "name": "亮",
        "name_idx": 3020,
        "ori": "「え……？」",
        "message": "「诶……？」",
        "text_idx": [
            3029
        ]
    },
    {
        "name": "円",
        "name_idx": 3093,
        "ori": "「ボクは、キミの役に立った？」",
        "message": "「我，帮上你的忙了吗？」",
        "text_idx": [
            3102
        ]
    },
    {
        "name": "亮",
        "name_idx": 3108,
        "ori": "「も、もちろん……」",
        "message": "「当、当然了……」",
        "text_idx": [
            3117
        ]
    },
    {
        "name": "円",
        "name_idx": 3181,
        "ori": "「なら……それで満足かな」",
        "message": "「那……我也就满足了吧」",
        "text_idx": [
            3190
        ]
    },
    {
        "name": "亮",
        "name_idx": 3196,
        "ori": "「なにが？」",
        "message": "「什么不对？」",
        "text_idx": [
            3205
        ]
    },
    {
        "name": "円",
        "name_idx": 3269,
        "ori": "「ボクがここに来た意味。半分は意味があったみたいだからよかった……」",
        "message": "「我来这里的意义。看来有一半是有意义的，那真是太好了……」",
        "text_idx": [
            3278,
            3279
        ]
    },
    {
        "name": "亮",
        "name_idx": 3285,
        "ori": "「半分はって……？」",
        "message": "「你说一半……？」",
        "text_idx": [
            3294
        ]
    },
    {
        "name": "円",
        "name_idx": 3358,
        "ori": "「あとの半分は……」",
        "message": "「剩下的一半……」",
        "text_idx": [
            3367
        ]
    },
    {
        "name": "円",
        "name_idx": 3431,
        "ori": "「ないしょ……かな？」",
        "message": "「是秘密……吧？」",
        "text_idx": [
            3440
        ]
    },
    {
        "name": "亮",
        "name_idx": 3446,
        "ori": "「なんだよ、そこまで引っ張っておいて。話せるなら話せばいいじゃん」",
        "message": "「什么啊，都吊我胃口到这份上了。能说的话就说不就好了」",
        "text_idx": [
            3455,
            3456
        ]
    },
    {
        "name": "円",
        "name_idx": 3520,
        "ori": "「そうはいかないのだ。女の子の秘密なのだ！」",
        "message": "「那可不行。这可是女孩子的秘密！」",
        "text_idx": [
            3529
        ]
    },
    {
        "ori": "なんだろう……",
        "message": "怎么回事呢……",
        "text_idx": [
            3544
        ]
    },
    {
        "ori": "急に此ノ花さんはガードを固めてしまったような、そんな気がしてならなかった。",
        "message": "我总觉得，此之花同学好像突然竖起了防备。",
        "text_idx": [
            3559,
            3560
        ]
    },
    {
        "ori": "色々な寂しさが混ざり合った複雑な表情。",
        "message": "那是混杂了各种寂寞的复杂表情。",
        "text_idx": [
            3575
        ]
    },
    {
        "ori": "その寂しさが浮かんだ此ノ花さんの顔から、彼女に心の壁があることに、俺はようやく気づいた。",
        "message": "从浮现出那份寂寞的此之花同学的脸上，我才终于意识到，她的内心是有一道壁垒的。",
        "text_idx": [
            3590,
            3591
        ]
    },
    {
        "ori": "それは、今まで此ノ花さんから感じたことがなかった心の壁……",
        "message": "那是我至今为止，从未在此之花同学身上感受过的心之壁垒……",
        "text_idx": [
            3606,
            3607
        ]
    },
    {
        "name": "亮",
        "name_idx": 3613,
        "ori": "「あの…さ……」",
        "message": "「那个……我说……」",
        "text_idx": [
            3622
        ]
    },
    {
        "name": "円",
        "name_idx": 3686,
        "ori": "「ん……？」",
        "message": "「嗯……？」",
        "text_idx": [
            3695
        ]
    },
    {
        "name": "亮",
        "name_idx": 3701,
        "ori": "「本気で、悩んでい……」",
        "message": "「你是不是，真的在烦恼……」",
        "text_idx": [
            3710
        ]
    },
    {
        "ori": "そこまで言いかけた時屋上のドアが開いて穂高が顔を出した。",
        "message": "我话说到一半，屋顶的门突然打开，穗高探出了头来。",
        "text_idx": [
            3725,
            3726
        ]
    },
    {
        "name": "蘭",
        "name_idx": 3760,
        "ori": "「あー、やっぱりココにいたーっ！」",
        "message": "「啊—，果然在这里—！」",
        "text_idx": [
            3769
        ]
    },
    {
        "name": "亮",
        "name_idx": 4160,
        "ori": "「なんだよ……」",
        "message": "「干嘛啦……」",
        "text_idx": [
            4169
        ]
    },
    {
        "name": "蘭",
        "name_idx": 4189,
        "ori": "「そんな所で二人してなにやってんの？　小松原くん、東雲先輩が探してるよ」",
        "message": "「你们俩在这种地方做什么呢？　小松原同学，东云学姐在找你哦」",
        "text_idx": [
            4198,
            4199
        ]
    },
    {
        "name": "亮",
        "name_idx": 4205,
        "ori": "「え……」",
        "message": "「诶……」",
        "text_idx": [
            4214
        ]
    },
    {
        "name": "円",
        "name_idx": 4332,
        "ori": "「あははは。美術部のホープをボクが取っちゃったから、怒られちゃうかな？」",
        "message": "「啊哈哈哈。我把美术部的希望之星给拐跑了，会不会被骂呀？」",
        "text_idx": [
            4341,
            4342
        ]
    },
    {
        "name": "円",
        "name_idx": 4406,
        "ori": "「じゃあ、さっさと帰ろうか」",
        "message": "「那，我们快回去吧」",
        "text_idx": [
            4415
        ]
    },
    {
        "ori": "此ノ花さんはコレ幸いとばかりに穂高の元に小走りに走って行った。",
        "message": "此之花同学像是如获大赦一般，小跑着奔向了穗高。",
        "text_idx": [
            4474,
            4475
        ]
    },
    {
        "ori": "たぶん、俺が質問しようとしたことをはぐらかすために。",
        "message": "大概，是为了岔开我正要问的问题。",
        "text_idx": [
            4732
        ]
    },
    {
        "name": "円",
        "name_idx": 6055,
        "ori": "「小松原くん、早く早く！」",
        "message": "「小松原同学，快点快点！」",
        "text_idx": [
            6064
        ]
    },
    {
        "name": "亮",
        "name_idx": 6070,
        "ori": "「え、ああ……」",
        "message": "「欸，啊……」",
        "text_idx": [
            6079
        ]
    },
    {
        "ori": "笑いながら俺を呼ぶ此ノ花さん。",
        "message": "此之花同学笑着呼唤我。",
        "text_idx": [
            6094
        ]
    },
    {
        "ori": "俺と彼女との間に屋上に立つポールの影が伸びていた。その影が、なぜか俺と此ノ花さんを分け距てているような気がしてならなかった……",
        "message": "屋顶上立杆的影子延伸在我与她之间。而那道影子，不知为何，让我总感觉仿佛将我和此之花同学分隔了开来……",
        "text_idx": [
            6109,
            6110,
            6111
        ]
    },
    {
        "name": "蘭",
        "name_idx": 6131,
        "ori": "「どうかしたの？」",
        "message": "「怎么了？」",
        "text_idx": [
            6140
        ]
    },
    {
        "name": "円",
        "name_idx": 6204,
        "ori": "「ボクが猛烈にアタックをかけたんだけど、ホレてないって言われちゃったの」",
        "message": "「我对他发动了猛烈攻势，结果人家说对我没感觉啦」",
        "text_idx": [
            6213,
            6214
        ]
    },
    {
        "name": "蘭",
        "name_idx": 6234,
        "ori": "「はぁ……そりゃ……」",
        "message": "「哈啊……那当然了……」",
        "text_idx": [
            6243
        ]
    },
    {
        "name": "蘭",
        "name_idx": 6361,
        "ori": "「……って、小松原くんにアタックかけられたんじゃなくて、円がかけてたの？」",
        "message": "「……也就是说，不是小松原同学向你发起的攻势，而是圆你向他发起的？」",
        "text_idx": [
            6370,
            6371
        ]
    },
    {
        "name": "円",
        "name_idx": 6435,
        "ori": "「そうなの。一緒に北海道に逃げてって誘ったんだけど……」",
        "message": "「是啊。我还邀请他和我一起逃到北海道去呢……」",
        "text_idx": [
            6444,
            6445
        ]
    },
    {
        "name": "蘭",
        "name_idx": 6509,
        "ori": "「そりゃ……まぁ、そう言われても……ねぇ……」",
        "message": "「那当然……毕竟，突然被这么说……是吧……」",
        "text_idx": [
            6518
        ]
    },
    {
        "ori": "なんだかかわいそうなモノを見るような目で、穂高が俺のことを見ているのは気のせいだろうか？",
        "message": "穗高用仿佛在看什么可怜东西似的眼神看着我，是我的错觉吗？",
        "text_idx": [
            6533,
            6534
        ]
    },
    {
        "ori": "それにしても、俺が母さんに会いに行ったことで得たものがあったのと同時に、失ってしまったものがあるのかもしれない……",
        "message": "话虽如此，我去见母亲这件事虽然让我有所收获，但或许也同时失去了某些东西……",
        "text_idx": [
            6549,
            6550,
            6551
        ]
    },
    {
        "ori": "此ノ花さんの言葉を借りるなら、俺の中にあった心の闇というもの……",
        "message": "借用此之花同学的话来说，就是我心中那所谓的黑暗……",
        "text_idx": [
            6566,
            6567
        ]
    },
    {
        "ori": "でも、そんな得体の知れないもの以外にも、俺の中にある大切なものを、今、新たに失おうとしているんじゃないだろうか？",
        "message": "但是，除了那种难以名状的东西以外，我是不是现在，正要失去我心中另一个重要的东西呢？",
        "text_idx": [
            6582,
            6583,
            6584
        ]
    },
    {
        "ori": "今、この手を差し出さなければ、目の前にいる此ノ花さんが壊れてしまい、永遠に失ってしまうような……そんな気がしてならない……",
        "message": "如果我现在不伸出这只手，眼前的此之花同学就会崩溃，而我将会永远地失去她……我总有这种挥之不去的感觉……",
        "text_idx": [
            6599,
            6600,
            6601
        ]
    },
    {
        "ori": "そんなの気のせいに決まっている……",
        "message": "那肯定只是我的错觉……",
        "text_idx": [
            6616
        ]
    },
    {
        "ori": "そう自分に言い聞かせながら、せき立てる此ノ花さんと穂高と一緒に、屋上を後にした……",
        "message": "我一边这样告诫自己，一边和催促着我的此之花同学与穗高一起，离开了屋顶……",
        "text_idx": [
            6711,
            6712
        ]
    }
]