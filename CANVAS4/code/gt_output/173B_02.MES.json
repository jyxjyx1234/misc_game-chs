[
    {
        "name": "亮",
        "name_idx": 2,
        "ori": "「どうかな……わからないな」",
        "message": "「这个嘛……我也不知道」",
        "text_idx": [
            11
        ]
    },
    {
        "ori": "この数週間が、フラッシュバックの様に俺の脳裏を横切る。",
        "message": "这几周的经历，如闪回般在我的脑海中掠过。",
        "text_idx": [
            26,
            27
        ]
    },
    {
        "name": "亮",
        "name_idx": 33,
        "ori": "「……正直言うと、あの時、仁瀬さんを思いついたのも不思議なんだ……」",
        "message": "「……说实话，那个时候，会想到仁濑同学也很不可思议……」",
        "text_idx": [
            42,
            43
        ]
    },
    {
        "name": "亮",
        "name_idx": 49,
        "ori": "「絵を描き終えた達成感と、幸福感でまるで現実じゃ無いみたいだった」",
        "message": "「画作完成后的成就感和幸福感，让一切都感觉那么不真实」",
        "text_idx": [
            58,
            59
        ]
    },
    {
        "name": "みつば",
        "name_idx": 109,
        "ori": "「…………」",
        "message": "「…………」",
        "text_idx": [
            118
        ]
    },
    {
        "ori": "みつばちゃんは、黙って聞いている。",
        "message": "三叶默默地听着。",
        "text_idx": [
            133
        ]
    },
    {
        "name": "亮",
        "name_idx": 139,
        "ori": "「……でもね、あの幸福感も、達成感も、仁瀬さんとみつばちゃんがいなければ、俺は得ることが出来なかったんだって、気付いたんだ」",
        "message": "「……但是啊，我发觉了，那份幸福感和成就感，如果没有仁濑同学和三叶，我是不可能得到的」",
        "text_idx": [
            148,
            149,
            150
        ]
    },
    {
        "name": "亮",
        "name_idx": 156,
        "ori": "「今なら、わかる……」",
        "message": "「我现在，明白了……」",
        "text_idx": [
            165
        ]
    },
    {
        "name": "みつば",
        "name_idx": 171,
        "ori": "「…………」",
        "message": "「…………」",
        "text_idx": [
            180
        ]
    },
    {
        "name": "亮",
        "name_idx": 186,
        "ori": "「仁瀬さんも、みつばちゃんも俺にとって大切な人だと、今だから……わかるんだ」",
        "message": "「仁濑同学和三叶，对我来说都是很重要的人，直到现在……我才明白」",
        "text_idx": [
            195,
            196
        ]
    },
    {
        "name": "みつば",
        "name_idx": 260,
        "ori": "「がんばりましたね……先輩」",
        "message": "「你很努力了呢……学长」",
        "text_idx": [
            269
        ]
    },
    {
        "ori": "みつばちゃんは、そう言って微笑みながら俺の頭を撫でてくれる。",
        "message": "三叶一边这么说着，一边微笑着抚摸我的头。",
        "text_idx": [
            284,
            285
        ]
    },
    {
        "ori": "そう……俺はこうやって母親に撫でられたかったのかも知れない……",
        "message": "是啊……或许我一直都想让母亲像这样抚摸我吧……",
        "text_idx": [
            300,
            301
        ]
    },
    {
        "name": "みつば",
        "name_idx": 365,
        "ori": "「ふふふっ……先輩、みつば……うれしいデス」",
        "message": "「呵呵呵……学长，三叶……我好开心哦」",
        "text_idx": [
            374
        ]
    },
    {
        "name": "亮",
        "name_idx": 380,
        "ori": "「ありがとう、みつばちゃん」",
        "message": "「谢谢你，三叶」",
        "text_idx": [
            389
        ]
    }
]