        "text_idx": [
            411
        ]
    },
    {
        "name": "蘭",
        "name_idx": 431,
        "ori": "「りょ、りょう、あぁ……ぼ、ボクを、もっと愛して、ああ、あっ……」",
        "message": "「亮、亮、啊啊……再、再多疼爱我一些，啊啊、啊……」",
        "text_idx": [
            440,
            441
        ]
    },
    {
        "ori": "腰を操る下半身に生き物の昂りに任せて、もっと、速く激しく突いて蘭をむさぼっていく。",
        "message": "我任由野兽般的冲动支配着下半身，更加快速、猛烈地贯穿，贪婪地索求着兰。",
        "text_idx": [
            456,
            457
        ]
    },
