        "name": "蘭",
        "name_idx": 2469,
        "ori": "「はぁ、はぁ……りょう……」",
        "message": "「哈啊，哈啊……亮……」",
        "text_idx": [
            2478
        ]
    },
    {
        "ori": "甘えるように蘭が抱き付いてくる。",
        "message": "兰撒娇似的抱了上来。",
        "text_idx": [
            2493
        ]
    },
    {
        "ori": "蘭の頭を撫でて、背中に手を回す。",
        "message": "我抚摸着兰的头，并将手环到她的背上。",
        "text_idx": [
            2508
        ]
    },
    {
        "ori": "いまだに蘭の身体は熱を持っていた。",
        "message": "兰的身体依然很烫。",
        "text_idx": [
            2523
        ]
    },
    {
        "name": "亮",
        "name_idx": 2529,
        "ori": "「蘭の中、とても気持ちよかったよ……」",
        "message": "「在兰的里面，感觉非常舒服哦……」",
        "text_idx": [
            2538
        ]
    },
    {
        "ori": "耳元で囁くと、蘭はくすぐったそうに笑った。",
        "message": "我在她耳边低语后，兰像是觉得很痒似的笑了起来。",
        "text_idx": [
            2553
        ]
    },
    {
        "name": "蘭",
        "name_idx": 2573,
        "ori": "「嬉しい……。ボクで気持ちよくなってくれて」",
        "message": "「我好开心……。你能因为我而感到舒服」",
        "text_idx": [
            2582
        ]
    },
    {
        "ori": "ぎゅっとお互いに抱きしめ合う。",
        "message": "我们紧紧地拥抱彼此。",
        "text_idx": [
            2597
        ]
    },
    {
        "ori": "触れ合った肌から蘭の一杯の愛情が伝わってきた。",
        "message": "从相互接触的肌肤上，我感受到了兰满满的爱意。",
        "text_idx": [
            2612
        ]
    },
    {
        "name": "亮",
        "name_idx": 2618,
        "ori": "「蘭は、とても女らしいよ」",
        "message": "「兰，你非常有女人味哦」",
        "text_idx": [
            2627
        ]
    },
    {
        "name": "蘭",
        "name_idx": 2647,
        "ori": "「あ、ありがとう……」",
        "message": "「啊，谢谢你……」",
        "text_idx": [
            2656
        ]
    },
    {
        "name": "蘭",
        "name_idx": 2676,
        "ori": "「りょうのも、大きくて熱くて、男らしくて……」",
        "message": "「亮的那个也，又大又烫，很有男人味……」",
        "text_idx": [
            2685
        ]
    },
    {
        "name": "蘭",
        "name_idx": 2705,
        "ori": "「気持ちよかった……」",
        "message": "「很舒服……」",
        "text_idx": [
            2714
        ]
    },
    {
        "name": "亮",
        "name_idx": 2720,
        "ori": "「それはよかった……」",
        "message": "「那真是太好了……」",
        "text_idx": [
            2729
        ]
    },
    {
        "ori": "笑い合う。",
        "message": "我们相视而笑。",
        "text_idx": [
            2744
        ]
    },
    {
        "ori": "甘いハチミツのような時間。",
        "message": "这段时光甜如蜂蜜。",
        "text_idx": [
            2759
        ]
    },
    {
        "ori": "二人で共有する幸せの時間。",
        "message": "这是我们两人共享的幸福时光。",
        "text_idx": [
            2774
        ]
    },
    {
        "ori": "しかし、どうしてだろう。",
        "message": "但是，为什么呢。",
        "text_idx": [
            2789
        ]
    },
    {
        "ori": "ふと――此ノ花さんの顔が頭に浮かんだ。",
        "message": "忽然——此之花小姐的脸庞浮现在我的脑海中。",
        "text_idx": [
            2872
        ]
    },
    {
        "ori": "泣いている此ノ花さん。",
        "message": "哭泣着的此之花小姐。",
        "text_idx": [
            2887
        ]
    },
    {
        "name": "亮",
        "name_idx": 2893,
        "ori": "「…………」",
        "message": "「…………」",
        "text_idx": [
            2902
        ]
    },
    {
        "ori": "……いけない、いけない。",
        "message": "……不行，不行。",
        "text_idx": [
            2917
        ]
    },
    {
        "ori": "此ノ花さんのことを考えてしまった事を蘭に気付かれないように、頭から振り払う。",
        "message": "为了不让兰察觉到我在想此之花小姐的事，我努力将这个念头从脑中甩开。",
        "text_idx": [
            3006,
            3007
        ]
    },
    {
        "ori": "しかし、どうしても此ノ花さんの姿がチラついた。",
        "message": "但是，此之花小姐的身影无论如何都在我脑海中挥之不去。",
        "text_idx": [
            3022
        ]
    },
    {
        "name": "蘭",
        "name_idx": 3042,
        "ori": "「……いいのかな」",
        "message": "「……这样好吗」",
        "text_idx": [
            3051
        ]
    },
    {
        "ori": "蘭が胸の中でボソッと呟く。",
        "message": "兰在我怀里小声呢喃。",
        "text_idx": [
            3066
        ]
    },
    {
        "ori": "蘭の顔は少し浮かなかった。",
        "message": "兰的脸上没什么喜色。",
        "text_idx": [
            3081
        ]
    },
    {
        "name": "蘭",
        "name_idx": 3101,
        "ori": "「ボクだけ幸せになっちゃって……」",
        "message": "「只有我一个人变得幸福……」",
        "text_idx": [
            3110
        ]
    },
    {
        "name": "亮",
        "name_idx": 3116,
        "ori": "「蘭……」",
        "message": "「兰……」",
        "text_idx": [
            3125
        ]
    },
    {
        "ori": "どうやら、蘭も同じことを考えていたらしい。",
        "message": "看来，兰也在想同样的事情。",
        "text_idx": [
            3140
        ]
    },
    {
        "ori": "此ノ花さんの事。",
        "message": "是此之花的事。",
        "text_idx": [
            3155
        ]
    },
    {
        "name": "蘭",
        "name_idx": 3175,
        "ori": "「みんなで……幸せになれないのかな」",
        "message": "「大家……就不能一起变得幸福吗」",
        "text_idx": [
            3184
        ]
    },
    {
        "ori": "蘭の腕に力が入る。",
        "message": "兰的双臂加大了力道。",
        "text_idx": [
            3199
        ]
    },
    {
        "ori": "ぎゅっと顔を俺の胸に埋めてきた。",
        "message": "她把脸紧紧地埋进我的胸膛。",
        "text_idx": [
            3214
        ]
    },
    {
        "name": "亮",
        "name_idx": 3220,
        "ori": "「俺もそれを願うよ」",
        "message": "「我也希望如此」",
        "text_idx": [
            3229
        ]
    },
    {
        "name": "蘭",
        "name_idx": 3249,
        "ori": "「……うん」",
        "message": "「……嗯」",
        "text_idx": [
            3258
        ]
    },
    {
        "ori": "蘭の髪を撫でつけて、強く抱きしめる。",
        "message": "我抚摸着兰的头发，紧紧抱住她。",
        "text_idx": [
            3273
        ]
    },
    {
        "ori": "蘭がとても小さく感じた。",
        "message": "我感觉兰是那么地娇小。",
        "text_idx": [
            3288
        ]
    },
    {
        "name": "亮",
        "name_idx": 3308,
        "ori": "「少し寒くなってきたね。お風呂入ろうか」",
        "message": "「天有点冷了呢。要不要去洗个澡？」",
        "text_idx": [
            3317
        ]
    },
    {
        "name": "蘭",
        "name_idx": 3337,
        "ori": "「うん……」",
        "message": "「嗯……」",
        "text_idx": [
            3346
        ]
    },
    {
        "ori": "胸の中で頷いた蘭は、身体を起こして周りをきょろきょろと見だした。",
        "message": "在我怀里点头的兰撑起身子，东张西望地打量起四周。",
        "text_idx": [
            3493,
            3494
        ]
    },
    {
        "name": "蘭",
        "name_idx": 3514,
        "ori": "「今何時かな？　遅くなると寮が閉まっちゃう」",
        "message": "「现在几点了？　太晚的话宿舍就要关门了」",
        "text_idx": [
            3523
        ]
    },
    {
        "name": "亮",
        "name_idx": 3529,
        "ori": "「もう暗いし、泊まっていけば？」",
        "message": "「天都黑了，要不就在这住下吧？」",
        "text_idx": [
            3538
        ]
    },
    {
        "name": "蘭",
        "name_idx": 3602,
        "ori": "「え、いいの？」",
        "message": "「欸，可以吗？」",
        "text_idx": [
            3611
        ]
    },
    {
        "name": "亮",
        "name_idx": 3617,
        "ori": "「もっち」",
        "message": "「当然啦」",
        "text_idx": [
            3626
        ]
    },
    {
        "ori": "蘭は嬉しそうな顔をする。",
        "message": "兰露出了开心的表情。",
        "text_idx": [
            3685
        ]
    },
    {
        "ori": "そして、立ち上がり頭を下げてきた。",
        "message": "然后，她站起身来，向我鞠了一躬。",
        "text_idx": [
            3700
        ]
    },
    {
        "name": "蘭",
        "name_idx": 4126,
        "ori": "「今晩よろしくお願いします」",
        "message": "「今晚就拜托你了」",
        "text_idx": [
            4135
        ]
    },
    {
        "name": "亮",
        "name_idx": 4141,
        "ori": "「うん」",
        "message": "「嗯」",
        "text_idx": [
            4150
        ]
    },
    {
        "name": "亮",
        "name_idx": 4156,
        "ori": "「裸もエロいけど、体液でテカテカになってると、もっとエロいよね」",
        "message": "「虽然光着身子也很工口，但身上沾满体液亮晶晶的样子，更工口呢」",
        "text_idx": [
            4165,
            4166
        ]
    },
    {
        "ori": "笑って言うと、蘭は顔を赤くしてシーツで身体を隠した。",
        "message": "听我笑着这么一说，兰红着脸用床单遮住了身体。",
        "text_idx": [
            4306
        ]
    },
    {
        "name": "蘭",
        "name_idx": 4370,
        "ori": "「もう、亮のエッチ！」",
        "message": "「真是的，亮你个H！」",
        "text_idx": [
            4379
        ]
    },
    {
        "name": "亮",
        "name_idx": 4385,
        "ori": "「ごめんごめん」",
        "message": "「抱歉抱歉」",
        "text_idx": [
            4394
        ]
    },
    {
        "ori": "恥ずかしそうに笑う蘭だが、少し表情を落としていた。",
        "message": "兰不好意思地笑了，但表情却有些失落。",
        "text_idx": [
            4409
        ]
    },
    {
        "name": "蘭",
        "name_idx": 4429,
        "ori": "「亮……一緒に頑張ろうね」",
        "message": "「亮……我们一起加油吧」",
        "text_idx": [
            4438
        ]
    },
    {
        "ori": "何がと聞かなくても分かる。",
        "message": "不用问我也知道。",
        "text_idx": [
            4453
        ]
    },
    {
        "ori": "此ノ花さんの事。",
        "message": "是此之花的事。",
        "text_idx": [
            4468
        ]
    },
    {
        "name": "亮",
        "name_idx": 4474,
        "ori": "「もちろんだよ」",
        "message": "「当然了」",
        "text_idx": [
            4483
        ]
    },
    {
        "name": "蘭",
        "name_idx": 4547,
        "ori": "「ふふ……」",
        "message": "「呵呵……」",
        "text_idx": [
            4556
        ]
    },
    {
        "ori": "はにかむように微笑む蘭は、とても絵になった。",
        "message": "兰害羞地微笑着，那样子美得就像一幅画。",
        "text_idx": [
            4571
        ]
    },
    {
        "ori": "幸せそうで……でも、親友の事で悩み少し影のある微笑み。",
        "message": "她看起来很幸福……但是，那份微笑中，又因挚友的事而烦恼，带上了一丝阴霾。",
        "text_idx": [
            4586,
            4587
        ]
    },
    {
        "name": "亮",
        "name_idx": 4593,
        "ori": "「……」",
        "message": "「……」",
        "text_idx": [
            4602
        ]
    },
    {
        "ori": "それはとても魅力的で、目が離せなかった。",
        "message": "那样的她非常有魅力，让我无法移开视线。",
        "text_idx": [
            4617
        ]
    },
    {
        "ori": "そうだ。",
        "message": "对了。",
        "text_idx": [
            4632
        ]
    },
    {
        "ori": "この瞬間、この蘭を白い世界に描こう。",
        "message": "就在这一瞬间，将此刻的兰画在纯白的世界里吧。",
        "text_idx": [
            4647
        ]
    },
    {
        "ori": "そう心に決めて、蘭の微笑みを目に焼き付けるように見つめた。",
        "message": "我下定决心，凝视着兰的微笑，仿佛要将它烙印在我的眼底。",
        "text_idx": [
            4662,
            4663
        ]
    },
    {
        "name": "蘭",
        "name_idx": 4683,
        "ori": "「そんなに見られると恥ずかしいよ」",
        "message": "「你这么看着我，我会害羞的」",
        "text_idx": [
            4692
        ]
    },
    {
        "name": "亮",
        "name_idx": 4698,
        "ori": "「……綺麗だったからさ」",
        "message": "「……因为你太美了啊」",
        "text_idx": [
            4707
        ]
    },
    {
        "name": "蘭",
        "name_idx": 4727,
        "ori": "「も、もう！」",
        "message": "「你、你真是的！」",
        "text_idx": [
            4736
        ]
    },
    {
        "ori": "照れたように顔を隠す蘭に、笑ってしまう。",
        "message": "看着害羞地捂住脸的兰，我忍不住笑了出来。",
        "text_idx": [
            4751
        ]
    },
    {
        "name": "亮",
        "name_idx": 4757,
        "ori": "「じゃ、お風呂入ろうか」",
        "message": "「那，我们去洗澡吧」",
        "text_idx": [
            4766
        ]
    },
    {
        "name": "蘭",
        "name_idx": 4786,
        "ori": "「う、うん」",
        "message": "「嗯、嗯」",
        "text_idx": [
            4795
        ]
    },
    {
        "name": "亮",
        "name_idx": 4801,
        "ori": "「身体流しっこし合うの夢だったんだよね」",
        "message": "「我一直梦想着能互相帮对方搓背呢」",
        "text_idx": [
            4810
        ]
    },
    {
        "name": "蘭",
        "name_idx": 4874,
        "ori": "「そ、そうなの？」",
        "message": "「是、是吗？」",
        "text_idx": [
            4883
        ]
    },
    {
        "name": "亮",
        "name_idx": 4889,
        "ori": "「いや、ホントは今さっき考えた」",
        "message": "「不，其实是我刚才才想到的」",
        "text_idx": [
            4898
        ]
    },
    {
        "name": "蘭",
        "name_idx": 4918,
        "ori": "「もう！」",
        "message": "「真是的！」",
        "text_idx": [
            4927
        ]
    },
    {
        "name": "亮",
        "name_idx": 4933,
        "ori": "「牛？」",
        "message": "「哞？」",
        "text_idx": [
            4942
        ]
    },
    {
        "name": "蘭",
        "name_idx": 4962,
        "ori": "「うう……」",
        "message": "「呜……」",
        "text_idx": [
            4971
        ]
    },
    {
        "ori": "いつもより女っぽい蘭をからかいつつ、一緒にお風呂へ向かった。",
        "message": "我一边调侃着比平时更有女人味的兰，一边和她一起走向浴室。",
        "text_idx": [
            4986,
            4987
        ]
    },
    {
        "ori": "蘭のあの影のあるあの微笑みを、何度も頭に思い浮かべながら思う。",
        "message": "兰那抹带着一丝忧伤的微笑，在我的脑海里反复浮现，我心想。",
        "text_idx": [
            5047,
            5048
        ]
    },
    {
        "ori": "蘭と此ノ花さんと俺の三人で、心から笑い合いたい。",
        "message": "我想和兰、此之花小姐我们三个人，一起由衷地欢笑。",
        "text_idx": [
            5063
        ]
    },
    {
        "ori": "此ノ花さんのため。",
        "message": "为了此之花小姐。",
        "text_idx": [
            5078
        ]
    },
    {
        "ori": "俺のため。",
        "message": "为了我。",
        "text_idx": [
            5093
        ]
    },
    {
        "ori": "そして、蘭のために何とかしようと思った……",
        "message": "并且，为了兰，我决心要设法做点什么……",
        "text_idx": [
            5108
        ]
    }
]