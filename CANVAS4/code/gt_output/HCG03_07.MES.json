        "name_idx": 387,
        "ori": "「あぁ、ああ、あ、ぁ、ああっ……ぁあぅ」",
        "message": "「啊啊、啊啊、啊、啊、啊啊……啊啊」",
        "text_idx": [
            396
        ]
    },
    {
        "name": "亮",
        "name_idx": 402,
        "ori": "「ら、らんぁっん……」",
