[
    {
        "name": "亮",
        "name_idx": 90,
        "ori": "「さて、此ノ花さんは……と。あれ？」",
        "message": "「那么，此之花同学呢……咦？」",
        "text_idx": [
            99
        ]
    },
    {
        "ori": "さっきまでみんなとワイワイやってた此ノ花さんが見あたらない。",
        "message": "刚才还和大家热闹地玩在一起的此之花同学不见了。",
        "text_idx": [
            114,
            115
        ]
    },
    {
        "ori": "……っと思ったら、泳いでいた。",
        "message": "……我正这么想着，就看到她正在游泳。",
        "text_idx": [
            174
        ]
    },
    {
        "ori": "そういえば、俺がプールに来たときに激しく泳いでたのは此ノ花さんだったよな。",
        "message": "说起来，我刚来泳池的时候，那个游得很激烈的人就是此之花同学啊。",
        "text_idx": [
            189,
            190
        ]
    },
    {
        "name": "亮",
        "name_idx": 196,
        "ori": "「うーん……」",
        "message": "「嗯……」",
        "text_idx": [
            205
        ]
    },
    {
        "ori": "なんていうか……泳ぎまくりだ。",
        "message": "该怎么说呢……她真是一刻不停地在游啊。",
        "text_idx": [
            220
        ]
    },
    {
        "ori": "…………",
        "message": "…………",
        "text_idx": [
            235
        ]
    },
    {
        "ori": "……またターンして……４周目に入った。",
        "message": "……她又转身折返……开始游第四圈了。",
        "text_idx": [
            250
        ]
    },
    {
        "name": "亮",
        "name_idx": 256,
        "ori": "「凄い体力だな……」",
        "message": "「体力真惊人啊……」",
        "text_idx": [
            265
        ]
    },
    {
        "ori": "……泳ぐのが好きなのかな？",
        "message": "……她是喜欢游泳吗？",
        "text_idx": [
            280
        ]
    },
    {
        "name": "亮",
        "name_idx": 286,
        "ori": "「………いや」",
        "message": "「………不」",
        "text_idx": [
            295
        ]
    },
    {
        "ori": "好き、というよりは、なんか泳ぎ方が荒くて、楽しんで泳いでいるようには……ちょっと見えない。",
        "message": "与其说是喜欢，不如说她的泳姿有些粗暴，看起来……不太像是乐在其中的样子。",
        "text_idx": [
            310,
            311
        ]
    },
    {
        "ori": "なんだろう……痛々しい、という表現があってるかな。",
        "message": "该怎么说呢……用令人心痛这个词来形容，是不是比较贴切呢。",
        "text_idx": [
            326
        ]
    },
    {
        "name": "円",
        "name_idx": 816,
        "ori": "「ふぅ……」",
        "message": "「呼……」",
        "text_idx": [
            825
        ]
    },
    {
        "ori": "一心不乱に泳いでいた此ノ花さんは、やがてプールサイドに上がった。",
        "message": "专心致志游泳的此之花同学，不一会儿就爬上了泳池边。",
        "text_idx": [
            840,
            841
        ]
    },
    {
        "name": "円",
        "name_idx": 1029,
        "ori": "「……」",
        "message": "「……」",
        "text_idx": [
            1038
        ]
    },
    {
        "ori": "俺がその様子をすっかり凝視してるのにも気付かずに、プールサイドに腰を下ろし水面を見つめている。",
        "message": "她完全没有注意到我正凝视着她，在池边坐下，注视着水面。",
        "text_idx": [
            1053,
            1054
        ]
    },
    {
        "ori": "そのまま、思い詰めたような顔をして、足を動かして水をパチャパチャと波打たせていた。",
        "message": "她就这样，露出一副心事重重的表情，摆动着双脚啪嗒啪嗒地拍打着水面。",
        "text_idx": [
            1132,
            1133
        ]
    },
    {
        "ori": "物憂げな表情というのだろうか？",
        "message": "那该说是忧郁的神情吗？",
        "text_idx": [
            1312
        ]
    },
    {
        "ori": "絵にしたら、凄く映えそうな表情をしたまま、彼女は波打つ水面から目を離さずに見つめていた。",
        "message": "她保持着那副若能入画定会十分上镜的表情，目不转睛地凝视着泛着波澜的水面。",
        "text_idx": [
            1327,
            1328
        ]
    },
    {
        "name": "亮",
        "name_idx": 1334,
        "ori": "「どうかした？」",
        "message": "「怎么了？」",
        "text_idx": [
            1343
        ]
    },
    {
        "name": "円",
        "name_idx": 1421,
        "ori": "「ん……別に……」",
        "message": "「嗯……没什么……」",
        "text_idx": [
            1430
        ]
    },
    {
        "name": "亮",
        "name_idx": 1436,
        "ori": "「………………」",
        "message": "「………………」",
        "text_idx": [
            1445
        ]
    },
    {
        "name": "円",
        "name_idx": 1495,
        "ori": "「………………」",
        "message": "「………………」",
        "text_idx": [
            1504
        ]
    },
    {
        "ori": "なんか……おかしい……",
        "message": "总觉得……有些奇怪……",
        "text_idx": [
            1519
        ]
    },
    {
        "ori": "いつもの暴風警報並みの元気がないというか……",
        "message": "该说她没有了往常那股台风警报级的活力吗……",
        "text_idx": [
            1534
        ]
    },
    {
        "ori": "……いや、なんかおかしく感じたのは……",
        "message": "……不，我之所以会觉得奇怪……",
        "text_idx": [
            1557
        ]
    },
    {
        "ori": "むしろ昨日からか？",
        "message": "倒不如说是从昨天开始的？",
        "text_idx": [
            1572
        ]
    },
    {
        "ori": "昨日からのハシャぎっぷりが激しすぎた感じもするから、そのギャップで余計に元気のなさが際だつ。",
        "message": "毕竟感觉她从昨天开始就闹腾得有点过头了，这种反差之下，她没精神的样子就显得格外突出。",
        "text_idx": [
            1587,
            1588
        ]
    },
    {
        "name": "蘭",
        "name_idx": 1609,
        "ori": "「小松原くん？」",
        "message": "「小松原同学？」",
        "text_idx": [
            1618
        ]
    },
    {
        "name": "亮",
        "name_idx": 1750,
        "ori": "「穂高……」",
        "message": "「穗高……」",
        "text_idx": [
            1759
        ]
    },
    {
        "ori": "穂高がやってきて俺の視線を追う。",
        "message": "穗高走了过来，顺着我的视线望去。",
        "text_idx": [
            1818
        ]
    },
    {
        "name": "蘭",
        "name_idx": 1838,
        "ori": "「どうしたんだろう、円……なんか元気ないね……」",
        "message": "「圆她怎么了呢……感觉没什么精神啊……」",
        "text_idx": [
            1847
        ]
    },
    {
        "name": "亮",
        "name_idx": 1853,
        "ori": "「ああ、さっきまで普通にハシャいでたよな？」",
        "message": "「是啊，她刚才不还玩得挺欢的吗？」",
        "text_idx": [
            1862
        ]
    },
    {
        "name": "蘭",
        "name_idx": 1882,
        "ori": "「うん、さっきまで元気だった」",
        "message": "「嗯，刚才还很有活力的」",
        "text_idx": [
            1891
        ]
    },
    {
        "name": "亮",
        "name_idx": 1897,
        "ori": "「どうしたんだろうな……此ノ花さん」",
        "message": "「她是怎么了呢……此之花同学」",
        "text_idx": [
            1906
        ]
    },
    {
        "name": "蘭",
        "name_idx": 1970,
        "ori": "「円、昨日の午後からたまに……ああなるんだよね」",
        "message": "「圆从昨天下午开始，偶尔会……变成那样呢」",
        "text_idx": [
            1979
        ]
    },
    {
        "name": "蘭",
        "name_idx": 2043,
        "ori": "「目も虚ろで、なんか本当に地に足がついてないって言うか……」",
        "message": "「眼神也很空洞，该说是感觉她整个人都心不在焉的一样……」",
        "text_idx": [
            2052,
            2053
        ]
    },
    {
        "name": "蘭",
        "name_idx": 2117,
        "ori": "「原因もわかんなくて……教えてくれないし、というか、しつこくも聞けないし……」",
        "message": "「我也不知道原因……她又不告诉我，再说，我也不好追问得太紧……」",
        "text_idx": [
            2126,
            2127
        ]
    },
    {
        "name": "亮",
        "name_idx": 2133,
        "ori": "「………………」",
        "message": "「………………」",
        "text_idx": [
            2142
        ]
    },
    {
        "name": "蘭",
        "name_idx": 2206,
        "ori": "「気に……なる？」",
        "message": "「你在……意吗？」",
        "text_idx": [
            2215
        ]
    },
    {
        "name": "亮",
        "name_idx": 2221,
        "ori": "「なにが？」",
        "message": "「什么不对？」",
        "text_idx": [
            2230
        ]
    },
    {
        "name": "蘭",
        "name_idx": 2294,
        "ori": "「円のことよ！」",
        "message": "「是圆的事啊！」",
        "text_idx": [
            2303
        ]
    },
    {
        "name": "亮",
        "name_idx": 2309,
        "ori": "「そりゃ、まぁ、あんな顔をされていたら……ねぇ」",
        "message": "「那当然，毕竟她露出那种表情……是吧」",
        "text_idx": [
            2318
        ]
    },
    {
        "name": "蘭",
        "name_idx": 2382,
        "ori": "「そう……だよね……」",
        "message": "「也……是呢……」",
        "text_idx": [
            2391
        ]
    },
    {
        "name": "亮",
        "name_idx": 2397,
        "ori": "「ん……」",
        "message": "「嗯……」",
        "text_idx": [
            2406
        ]
    },
    {
        "ori": "確かに、言われてみれば気だるげというよりも、目も虚ろにという方が相応しかった。",
        "message": "的确，经她这么一说，与其说是慵懒，不如说眼神空洞才更贴切。",
        "text_idx": [
            2421,
            2422
        ]
    },
    {
        "ori": "悩み事があるんだろうか……？",
        "message": "她有什么烦心事吗……？",
        "text_idx": [
            2437
        ]
    },
    {
        "ori": "本来なら穂高たちがこういう聞き役になるべきなんだろうけど……",
        "message": "按理说，本该由穗高她们来当这个倾听者才对……",
        "text_idx": [
            2452,
            2453
        ]
    },
    {
        "ori": "もう一度、此ノ花さんのそばに行くと、彼女はちょっとだけ顔を上げて俺を見て、また水面に目を落とした。",
        "message": "我再次走到此之花同学身边，她只是稍微抬起头看了我一眼，又将视线落回了水面。",
        "text_idx": [
            2566,
            2567
        ]
    },
    {
        "name": "亮",
        "name_idx": 2573,
        "ori": "「どうかしたわけ？」",
        "message": "「你怎么了？」",
        "text_idx": [
            2582
        ]
    },
    {
        "name": "円",
        "name_idx": 2602,
        "ori": "「別に……」",
        "message": "「没什么……」",
        "text_idx": [
            2611
        ]
    },
    {
        "name": "亮",
        "name_idx": 2617,
        "ori": "「別にって言う割には……なんか落ち込んでない？」",
        "message": "「嘴上说着没什么……可你不是有点消沉吗？」",
        "text_idx": [
            2626
        ]
    },
    {
        "name": "円",
        "name_idx": 2646,
        "ori": "「落ち込んでないよ……ただ……」",
        "message": "「我没有消沉……只是……」",
        "text_idx": [
            2655
        ]
    },
    {
        "name": "亮",
        "name_idx": 2661,
        "ori": "「ただ……？」",
        "message": "「只是……？」",
        "text_idx": [
            2670
        ]
    },
    {
        "name": "円",
        "name_idx": 2734,
        "ori": "「ちょっと……疲れちゃっただけよ」",
        "message": "「只是……有点累了而已」",
        "text_idx": [
            2743
        ]
    },
    {
        "name": "亮",
        "name_idx": 2749,
        "ori": "「疲れちゃったか……」",
        "message": "「累了啊……」",
        "text_idx": [
            2758
        ]
    },
    {
        "name": "円",
        "name_idx": 2778,
        "ori": "「なぁに？　なんか、含んだ言い方」",
        "message": "「干嘛？　总感觉你话里有话」",
        "text_idx": [
            2787
        ]
    },
    {
        "name": "亮",
        "name_idx": 2793,
        "ori": "「元気印ばかりだと思っていた此ノ花さんが、そんなことを言うとは思わなかったからねぇ」",
        "message": "「我一直以为此之花同学总是活力满满的，没想到你会说这种话呢」",
        "text_idx": [
            2802,
            2803
        ]
    },
    {
        "name": "円",
        "name_idx": 2867,
        "ori": "「ボクだって……人並みに疲れるし……電池だって、切れちゃうこともあるよ……」",
        "message": "「我也会……像普通人一样感到疲惫……电池也会有耗尽的时候啊……」",
        "text_idx": [
            2876,
            2877
        ]
    },
    {
        "name": "亮",
        "name_idx": 2883,
        "ori": "「電池切れか……」",
        "message": "「电池耗尽了吗……」",
        "text_idx": [
            2892
        ]
    },
    {
        "name": "円",
        "name_idx": 2956,
        "ori": "「そ……。電池切れ。充電しないといけないんだけどね。中々、充電器が見つからないの」",
        "message": "「嗯……。电池耗尽了。虽然必须要充电才行，但一直找不到充电器」",
        "text_idx": [
            2965,
            2966
        ]
    },
    {
        "name": "亮",
        "name_idx": 2972,
        "ori": "「充電器か……」",
        "message": "「充电器啊……」",
        "text_idx": [
            2981
        ]
    },
    {
        "name": "円",
        "name_idx": 3001,
        "ori": "「なによ」",
        "message": "「干嘛」",
        "text_idx": [
            3010
        ]
    },
    {
        "name": "亮",
        "name_idx": 3016,
        "ori": "「いや、悩み事なら相談に乗るよって言おうと思ってた」",
        "message": "「没什么，我只是想说，如果你有什么烦恼的话可以和我说说」",
        "text_idx": [
            3025
        ]
    },
    {
        "name": "円",
        "name_idx": 3045,
        "ori": "「なんで……？」",
        "message": "「为什么……？」",
        "text_idx": [
            3054
        ]
    },
    {
        "name": "亮",
        "name_idx": 3060,
        "ori": "「なんでって……」",
        "message": "「你问我为什么……」",
        "text_idx": [
            3069
        ]
    },
    {
        "name": "円",
        "name_idx": 3089,
        "ori": "「なんで？　どうして？」",
        "message": "「为什么？ 到底为什么？」",
        "text_idx": [
            3098
        ]
    },
    {
        "name": "亮",
        "name_idx": 3104,
        "ori": "「いや、どうしてって言われても……」",
        "message": "「这个，就算你问我为什么……」",
        "text_idx": [
            3113
        ]
    },
    {
        "name": "亮",
        "name_idx": 3119,
        "ori": "「せっかく、こうして知り合えたのもなにかの縁だしねぇ……それに、似た者なんでしょ？」",
        "message": "「好不容易能像这样相识也是一种缘分嘛……而且，我们不是很像吗？」",
        "text_idx": [
            3128,
            3129
        ]
    },
    {
        "name": "円",
        "name_idx": 3149,
        "ori": "「え……？」",
        "message": "「诶……？」",
        "text_idx": [
            3158
        ]
    },
    {
        "name": "亮",
        "name_idx": 3164,
        "ori": "「俺のこと、そう言ってなかった？」",
        "message": "「你不是这么说我的吗？」",
        "text_idx": [
            3173
        ]
    },
    {
        "name": "円",
        "name_idx": 3193,
        "ori": "「………………」",
        "message": "「………………」",
        "text_idx": [
            3202
        ]
    },
    {
        "name": "亮",
        "name_idx": 3208,
        "ori": "「え……」",
        "message": "「诶……」",
        "text_idx": [
            3217
        ]
    },
    {
        "ori": "此ノ花さんは、うっすらと瞳を涙で潤ませて、真剣な顔をして俺の事を見上げてきた。",
        "message": "此之花同学的眼眸中泛起浅浅的泪光，她一脸认真地抬头看着我。",
        "text_idx": [
            3232,
            3233
        ]
    },
    {
        "ori": "そんな顔で見つめられると……。鼓動が激しくなってきてドギマギしてきちゃうじゃないか。",
        "message": "被她用这种表情注视着……我的心跳开始加速，搞得我都心慌意乱了啊。",
        "text_idx": [
            3248,
            3249
        ]
    },
    {
        "name": "亮",
        "name_idx": 3255,
        "ori": "「知り合ったばかりの相手に相談もなにもないよな……」",
        "message": "「对刚认识的人，也没什么好商量的吧……」",
        "text_idx": [
            3264
        ]
    },
    {
        "name": "円",
        "name_idx": 3284,
        "ori": "「そんなことない！」",
        "message": "「才不是！」",
        "text_idx": [
            3293
        ]
    },
    {
        "name": "亮",
        "name_idx": 3299,
        "ori": "「そ、そう……」",
        "message": "「是、是吗……」",
        "text_idx": [
            3308
        ]
    },
    {
        "name": "円",
        "name_idx": 3328,
        "ori": "「うん……」",
        "message": "「嗯……」",
        "text_idx": [
            3337
        ]
    },
    {
        "name": "亮",
        "name_idx": 3343,
        "ori": "「で、相談って……なにかあるかな？」",
        "message": "「那，要商量的事情……是什么呢？」",
        "text_idx": [
            3352
        ]
    },
    {
        "name": "円",
        "name_idx": 3372,
        "ori": "「うん……」",
        "message": "「嗯……」",
        "text_idx": [
            3381
        ]
    },
    {
        "name": "亮",
        "name_idx": 3387,
        "ori": "「別に俺がなにか出来るとは限らないけど……話して楽になるんなら……協力するから……」",
        "message": "「我也不是说一定能帮上什么忙……但要是说出来能让你轻松些的话……我会帮忙的……」",
        "text_idx": [
            3396,
            3397
        ]
    },
    {
        "name": "円",
        "name_idx": 3403,
        "ori": "「………………」",
        "message": "「………………」",
        "text_idx": [
            3412
        ]
    },
    {
        "name": "亮",
        "name_idx": 3418,
        "ori": "「で、でも、ムリに話さないでもいいんだからね」",
        "message": "「但、但是，不想说的话也不用勉强自己哦」",
        "text_idx": [
            3427
        ]
    },
    {
        "name": "円",
        "name_idx": 3491,
        "ori": "「うん……えと……」",
        "message": "「嗯……那个……」",
        "text_idx": [
            3500
        ]
    },
    {
        "name": "亮",
        "name_idx": 3506,
        "ori": "「な、なにかな……？」",
        "message": "「是、是什么呢……？」",
        "text_idx": [
            3515
        ]
    },
    {
        "ori": "自分の声がうわずっているのが分かる。",
        "message": "我能感觉到自己的声音都在发颤。",
        "text_idx": [
            3530
        ]
    },
    {
        "ori": "こんな瞳に見つめられたままなんだから、仕方ないだろ。",
        "message": "一直被她用这样的眼神注视着，会紧张也是没办法的吧。",
        "text_idx": [
            3633
        ]
    },
    {
        "name": "円",
        "name_idx": 3730,
        "ori": "「あの……」",
        "message": "「那个……」",
        "text_idx": [
            3739
        ]
    },
    {
        "name": "亮",
        "name_idx": 3745,
        "ori": "「ん……？」",
        "message": "「嗯……？」",
        "text_idx": [
            3754
        ]
    },
    {
        "name": "円",
        "name_idx": 3774,
        "ori": "「ソフトクリームが食べたいの」",
        "message": "「我想吃软冰淇淋」",
        "text_idx": [
            3783
        ]
    },
    {
        "name": "亮",
        "name_idx": 3789,
        "ori": "「は？」",
        "message": "「哈？」",
        "text_idx": [
            3798
        ]
    },
    {
        "name": "円",
        "name_idx": 3862,
        "ori": "「だから、ソフトクリームが食べたいの」",
        "message": "「所以，我想吃软冰淇淋」",
        "text_idx": [
            3871
        ]
    },
    {
        "name": "亮",
        "name_idx": 3877,
        "ori": "「そこのコンビニで売ってるけど……」",
        "message": "「那边的便利店就有卖的啊……」",
        "text_idx": [
            3886
        ]
    },
    {
        "name": "円",
        "name_idx": 3906,
        "ori": "「そんなんじゃなくて、臨海公園のスタンドで売っているソフトクリームが食べたいの」",
        "message": "「我不是想吃那种，我想吃的是临海公园小卖部卖的软冰淇淋」",
        "text_idx": [
            3915,
            3916
        ]
    },
    {
        "name": "亮",
        "name_idx": 3922,
        "ori": "「なんで……そんな極地的な情報を……」",
        "message": "「你怎么……会知道这么具体的情报……」",
        "text_idx": [
            3931
        ]
    },
    {
        "name": "円",
        "name_idx": 3959,
        "ori": "「前に、小松原くんが教えてくれたよ……」",
        "message": "「是之前，小松原同学告诉我的……」",
        "text_idx": [
            3968
        ]
    },
    {
        "name": "亮",
        "name_idx": 3974,
        "ori": "「そ、そうだっけ……？」",
        "message": "「是、是吗……？」",
        "text_idx": [
            3983
        ]
    },
    {
        "name": "円",
        "name_idx": 4004,
        "ori": "「撫子学園周辺のタウン情報にも、お勧めって載ってた」",
        "message": "「抚子学园周边的本地指南上，也有推荐过」",
        "text_idx": [
            4013
        ]
    },
    {
        "name": "亮",
        "name_idx": 4019,
        "ori": "「そう……」",
        "message": "「嗯……」",
        "text_idx": [
            4028
        ]
    },
    {
        "name": "円",
        "name_idx": 4048,
        "ori": "「だから、ソフトクリームが食べたいの」",
        "message": "「所以，我想吃软冰淇淋」",
        "text_idx": [
            4057
        ]
    },
    {
        "name": "亮",
        "name_idx": 4063,
        "ori": "「わかった。今度連れて行くから……」",
        "message": "「知道了。下次我带你去……」",
        "text_idx": [
            4072
        ]
    },
    {
        "name": "円",
        "name_idx": 4092,
        "ori": "「今度って、いつ？　明日？」",
        "message": "「下次是、什么时候？　明天？」",
        "text_idx": [
            4101
        ]
    },
    {
        "name": "亮",
        "name_idx": 4107,
        "ori": "「子どもかよ！」",
        "message": "「你是小孩子吗！」",
        "text_idx": [
            4116
        ]
    },
    {
        "name": "円",
        "name_idx": 4136,
        "ori": "「じゃあ、いつ？　明日？」",
        "message": "「那，是什么时候？　明天？」",
        "text_idx": [
            4145
        ]
    },
    {
        "ori": "いつって聞いておきながら、選択肢は明日しかないのか？",
        "message": "嘴上问我是什么时候，结果选项就只有明天吗？",
        "text_idx": [
            4160
        ]
    },
    {
        "name": "亮",
        "name_idx": 4166,
        "ori": "「明日は……」",
        "message": "「明天的话……」",
        "text_idx": [
            4175
        ]
    },
    {
        "name": "円",
        "name_idx": 4195,
        "ori": "「じゃあ、今日？　今から？」",
        "message": "「那，今天？　现在就去？」",
        "text_idx": [
            4204
        ]
    },
    {
        "name": "亮",
        "name_idx": 4210,
        "ori": "「今からはチョット……」",
        "message": "「现在的话有点……」",
        "text_idx": [
            4219
        ]
    },
    {
        "name": "円",
        "name_idx": 4239,
        "ori": "「じゃあ、明日？」",
        "message": "「那，明天？」",
        "text_idx": [
            4248
        ]
    },
    {
        "name": "亮",
        "name_idx": 4254,
        "ori": "「まぁ、明日でも……」",
        "message": "「嗯，明天也行……」",
        "text_idx": [
            4263
        ]
    },
    {
        "name": "円",
        "name_idx": 4341,
        "ori": "「じゃあ、デートね！」",
        "message": "「那就是约会啦！」",
        "text_idx": [
            4350
        ]
    },
    {
        "name": "亮",
        "name_idx": 4356,
        "ori": "「デート！？」",
        "message": "「约会！？」",
        "text_idx": [
            4365
        ]
    },
    {
        "name": "円",
        "name_idx": 4399,
        "ori": "「臨海公園でデート！　なんて素敵な響き！　約束しちゃったからね？」",
        "message": "「在临海公园约会！　听起来多棒啊！　我们已经说好咯？」",
        "text_idx": [
            4408,
            4409
        ]
    },
    {
        "name": "亮",
        "name_idx": 4415,
        "ori": "「は、はぁ……」",
        "message": "「是、是吗……」",
        "text_idx": [
            4424
        ]
    },
    {
        "name": "円",
        "name_idx": 4444,
        "ori": "「約束！」",
        "message": "「说好了！」",
        "text_idx": [
            4453
        ]
    },
    {
        "name": "亮",
        "name_idx": 4459,
        "ori": "「や、約束する……」",
        "message": "「我、我答应……」",
        "text_idx": [
            4468
        ]
    },
    {
        "name": "円",
        "name_idx": 4556,
        "ori": "「指切り！」",
        "message": "「拉钩！」",
        "text_idx": [
            4565
        ]
    },
    {
        "name": "亮",
        "name_idx": 4571,
        "ori": "「はい。指切り」",
        "message": "「好的。拉钩」",
        "text_idx": [
            4580
        ]
    },
    {
        "name": "円",
        "name_idx": 4600,
        "ori": "「ゆ～びき～りげんまん、ウソついたらハリセンボンの～ます！　ゆ～びきった！」",
        "message": "「拉～钩～上吊～，说谎的话要吞下一千根针哦～！　拉钩盖章！」",
        "text_idx": [
            4609,
            4610
        ]
    },
    {
        "name": "円",
        "name_idx": 4749,
        "ori": "「やった～！　指切りしちゃったんだからね！　しちゃったんだから、もう、責任とってよね！」",
        "message": "「太棒啦～！　我们已经拉过钩了哦！　既然都做过了，你可要负责哦！」",
        "text_idx": [
            4758,
            4759
        ]
    },
    {
        "name": "亮",
        "name_idx": 4765,
        "ori": "「ちょっ！　ご、誤解を招きそうな言い方するなよ！」",
        "message": "「喂！　别、别说这种容易让人误会的话啊！」",
        "text_idx": [
            4774
        ]
    },
    {
        "name": "円",
        "name_idx": 4892,
        "ori": "「誤解ってなぁに？」",
        "message": "「误会是什么呀？」",
        "text_idx": [
            4901
        ]
    },
    {
        "name": "円",
        "name_idx": 5019,
        "ori": "「しちゃったんだから、責任を取るのは男として当然でしょ！？」",
        "message": "「既然都做过了，身为男人理所当然要负责吧！？」",
        "text_idx": [
            5028,
            5029
        ]
    },
    {
        "name": "亮",
        "name_idx": 5035,
        "ori": "「だ、だからその言い方は！」",
        "message": "「所、所以说你这种说法！」",
        "text_idx": [
            5044
        ]
    },
    {
        "name": "蘭",
        "name_idx": 5215,
        "ori": "「こまつばらくん……」",
        "message": "「小松原君……」",
        "text_idx": [
            5224
        ]
    },
    {
        "name": "亮",
        "name_idx": 5230,
        "ori": "「は……」",
        "message": "「啊……」",
        "text_idx": [
            5239
        ]
    },
    {
        "name": "蘭",
        "name_idx": 5259,
        "ori": "「さっき……なんだか妙に気になる言葉を聞かされたんだけど……気のせいかなぁ？」",
        "message": "「刚才……我好像听到了些很在意的话……是我的错觉吗？」",
        "text_idx": [
            5268,
            5269
        ]
    },
    {
        "name": "亮",
        "name_idx": 5275,
        "ori": "「気になる言葉って……ナニかなぁ？　アハハハ」",
        "message": "「很在意的话……是指什么呢？　啊哈哈哈哈」",
        "text_idx": [
            5284
        ]
    },
    {
        "name": "蘭",
        "name_idx": 5348,
        "ori": "「しちゃった……とか、責任……とか……」",
        "message": "「比如什么「做了」……啦，什么「责任」……啦……」",
        "text_idx": [
            5357
        ]
    },
    {
        "name": "亮",
        "name_idx": 5363,
        "ori": "「ちょ、ちょっと待て！　ご、誤解だ！」",
        "message": "「等、等一下！　是、是误会！」",
        "text_idx": [
            5372
        ]
    },
    {
        "name": "蘭",
        "name_idx": 5436,
        "ori": "「円が元気がないと思ったんだけど……よもや……」",
        "message": "「我还以为圆没什么精神呢……莫非……」",
        "text_idx": [
            5445
        ]
    },
    {
        "name": "円",
        "name_idx": 5509,
        "ori": "「ゴメンなさい、蘭！　ボク、どうしても言えなかったのよ！　こんな仕打ちを受けても……」",
        "message": "「对不起，兰！　我……我实在说不出口啊！　即使受到了这种对待……」",
        "text_idx": [
            5518,
            5519
        ]
    },
    {
        "name": "円",
        "name_idx": 5583,
        "ori": "「愛しているから！」",
        "message": "「因为我爱你啊！」",
        "text_idx": [
            5592
        ]
    },
    {
        "name": "蘭",
        "name_idx": 5656,
        "ori": "「こーまーつーばーらーくーん……」",
        "message": "「小—松—原—同—学—……」",
        "text_idx": [
            5665
        ]
    },
    {
        "name": "亮",
        "name_idx": 5762,
        "ori": "「ぎゃー！　濡れ衣だ！　えん罪！　というか、いつもの悪ふざけだよ！」",
        "message": "「呀啊—！ 我是被冤枉的！是诬陷！倒不如说，这只是平时开的玩笑啦！」",
        "text_idx": [
            5771,
            5772
        ]
    },
    {
        "name": "円",
        "name_idx": 5792,
        "ori": "「あははははははっ！　じゃ、明日約束だよ！」",
        "message": "「啊哈哈哈哈哈！　那么，明天约好了哦！」",
        "text_idx": [
            5801
        ]
    },
    {
        "name": "蘭",
        "name_idx": 5861,
        "ori": "「待ちなさい！　釈明しなさい！」",
        "message": "「给我站住！　给我解释清楚！」",
        "text_idx": [
            5870
        ]
    },
    {
        "name": "亮",
        "name_idx": 5916,
        "ori": "「釈明もなにも、きちんと本当のこと言ってんだろ！」",
        "message": "「解释什么啊，我说的就是实话吧！」",
        "text_idx": [
            5925
        ]
    },
    {
        "ori": "その後、俺がプールを３周するくらいまで此ノ花さんは笑い転げ、ようやく穂高を止めてくれたのだった。",
        "message": "在那之后，此之花同学一直在笑得前仰后合，直到我在泳池里游了快三圈，她才终于拦住了穗高。",
        "text_idx": [
            5940,
            5941
        ]
    },
    {
        "ori": "こんな仕打ちを受けるって……それはこっちのセリフだろうに……",
        "message": "说什么要受到这种对待……那句话该我来说才对吧……",
        "text_idx": [
            5956,
            5957
        ]
    }
]