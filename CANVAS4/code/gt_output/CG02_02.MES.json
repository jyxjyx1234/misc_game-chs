[
    {
        "ori": "夜の静寂に包まれたアトリエは、一人で考えるのには丁度良かった。",
        "message": "笼罩在夜之静寂中的画室，正好适合我一个人思考。",
        "text_idx": [
            451,
            452
        ]
    },
    {
        "ori": "ずっと考えていた。",
        "message": "我一直在思考。",
        "text_idx": [
            467
        ]
    },
    {
        "ori": "此ノ花さんの悩み……",
        "message": "此之花同学的烦恼……",
        "text_idx": [
            482
        ]
    },
    {
        "ori": "心の闇……",
        "message": "心中的黑暗……",
        "text_idx": [
            497
        ]
    },
    {
        "ori": "たぶん、それはきっと俺に関わり合いのある事で、そして同時に、俺以外の何かも関わっている事で……",
        "message": "恐怕，那件事一定和我有关，而且同时，也和除我以外的什么有关……",
        "text_idx": [
            512,
            513
        ]
    },
    {
        "ori": "幸せになれるチケット。",
        "message": "能够获得幸福的门票。",
        "text_idx": [
            528
        ]
    },
    {
        "ori": "涙。",
        "message": "泪水。",
        "text_idx": [
            543
        ]
    },
    {
        "ori": "そして放課後に穂高から聞いた事……",
        "message": "还有放学后从穗高那里听来的事……",
        "text_idx": [
            558
        ]
    },
    {
        "ori": "全部が全部、頭の中でぐるぐる回る。",
        "message": "所有的一切，都在我脑海里打转。",
        "text_idx": [
            573
        ]
    },
    {
        "name": "亮",
        "name_idx": 579,
        "ori": "「わからないな」",
        "message": "「搞不懂啊」",
        "text_idx": [
            588
        ]
    },
    {
        "ori": "頭を抱えながら、ふと思う。",
        "message": "我抱着头，不禁想道。",
        "text_idx": [
            603
        ]
    },
    {
        "ori": "どうして、俺は此ノ花さんのためにここまで頭を悩ませているのだろうか。",
        "message": "为什么，我要为了此之花同学如此烦恼呢。",
        "text_idx": [
            618,
            619
        ]
    },
    {
        "ori": "これも分からない。",
        "message": "这一点我也搞不懂。",
        "text_idx": [
            634
        ]
    },
    {
        "ori": "自分自身の事なのに、少し不思議だった。",
        "message": "明明是我自己的事，却感觉有些不可思议。",
        "text_idx": [
            649
        ]
    },
    {
        "ori": "ガサガサ……",
        "message": "窸窸窣窣……",
        "text_idx": [
            692
        ]
    },
    {
        "name": "亮",
        "name_idx": 712,
        "ori": "「ん……？」",
        "message": "「嗯……？」",
        "text_idx": [
            721
        ]
    },
    {
        "ori": "外から物音が。",
        "message": "我听到外面传来了声响。",
        "text_idx": [
            736
        ]
    },
    {
        "ori": "ガサガサ……",
        "message": "窸窸窣窣……",
        "text_idx": [
            765
        ]
    },
    {
        "ori": "ことのか？",
        "message": "是琴乃吗？",
        "text_idx": [
            794
        ]
    },
    {
        "ori": "何やってるんだろう？",
        "message": "她在干什么呢？",
        "text_idx": [
            809
        ]
    },
    {
        "ori": "気になって外へ出てみる。",
        "message": "我有些在意，便走到外面看看。",
        "text_idx": [
            897
        ]
    },
    {
        "name": "蘭",
        "name_idx": 1208,
        "ori": "「ここが小松原くんの家かぁ……」",
        "message": "「这里就是小松原同学的家啊……」",
        "text_idx": [
            1217
        ]
    },
    {
        "name": "蘭",
        "name_idx": 1237,
        "ori": "「なんかドキドキしちゃうなぁ……」",
        "message": "「总感觉心跳得好快啊……」",
        "text_idx": [
            1246
        ]
    },
    {
        "name": "亮",
        "name_idx": 1252,
        "ori": "「…………」",
        "message": "「…………」",
        "text_idx": [
            1261
        ]
    },
    {
        "ori": "見知った人間が庭に侵入しようとしているところだった。",
        "message": "我看到一个认识的人正打算溜进院子里。",
        "text_idx": [
            1276
        ]
    },
    {
        "ori": "立ちつくす俺にはまだ気付いてないらしく、家を眺めてはムフフと笑っている。",
        "message": "她好像还没发现呆站着的我，正一边望着房子一边嘿嘿地笑着。",
        "text_idx": [
            1291,
            1292
        ]
    },
    {
        "name": "亮",
        "name_idx": 1298,
        "ori": "「……あのぉ？」",
        "message": "「……那个？」",
        "text_idx": [
            1307
        ]
    },
    {
        "name": "蘭",
        "name_idx": 1799,
        "ori": "「うわぁっ！？」",
        "message": "「哇啊！？」",
        "text_idx": [
            1808
        ]
    },
    {
        "ori": "文字通り飛び上がった。",
        "message": "她真的被吓得跳了起来。",
        "text_idx": [
            1823
        ]
    },
    {
        "ori": "その驚きっぷりに、逆にこちらが驚いてしまう。",
        "message": "看她惊讶成那样，反倒是我被吓了一跳。",
        "text_idx": [
            1838
        ]
    },
    {
        "name": "蘭",
        "name_idx": 1858,
        "ori": "「こ、小松原くん！？」",
        "message": "「小、小松原同学！？」",
        "text_idx": [
            1867
        ]
    },
    {
        "name": "亮",
        "name_idx": 1873,
        "ori": "「よう」",
        "message": "「哟」",
        "text_idx": [
            1882
        ]
    },
    {
        "name": "蘭",
        "name_idx": 2004,
        "ori": "「あーびっくりした。いきなり驚かさないでよ」",
        "message": "「啊—吓我一跳。不要突然吓人啦」",
        "text_idx": [
            2013
        ]
    },
    {
        "name": "亮",
        "name_idx": 2019,
        "ori": "「いや、俺が驚いたから！」",
        "message": "「不，明明是我被吓到了好吗！」",
        "text_idx": [
            2028
        ]
    },
    {
        "name": "亮",
        "name_idx": 2034,
        "ori": "「一体何してるんだよ？」",
        "message": "「你究竟在干嘛啊？」",
        "text_idx": [
            2043
        ]
    },
    {
        "name": "蘭",
        "name_idx": 2335,
        "ori": "「え……」",
        "message": "「诶……」",
        "text_idx": [
            2344
        ]
    },
    {
        "ori": "フリーズする穂高。",
        "message": "穗高僵住了。",
        "text_idx": [
            2359
        ]
    },
    {
        "name": "亮",
        "name_idx": 2365,
        "ori": "「穂高？」",
        "message": "「穗高？」",
        "text_idx": [
            2374
        ]
    },
    {
        "name": "蘭",
        "name_idx": 2642,
        "ori": "「えっと！」",
        "message": "「那个！」",
        "text_idx": [
            2651
        ]
    },
    {
        "ori": "それから数秒後に解凍された穂高は、しどろもどろし始めた。",
        "message": "几秒后解冻了的穗高，开始语无伦次起来。",
        "text_idx": [
            2666,
            2667
        ]
    },
    {
        "name": "蘭",
        "name_idx": 2785,
        "ori": "「え、えっとね！えーと……しどろもどろしどろもどろ」",
        "message": "「那、那个！呃—……语无伦次语无伦次」",
        "text_idx": [
            2794,
            2795
        ]
    },
    {
        "name": "亮",
        "name_idx": 2801,
        "ori": "「……」",
        "message": "「……」",
        "text_idx": [
            2810
        ]
    },
    {
        "ori": "自分でしどろもどろ言っちゃってるよ。",
        "message": "她自己都把语无伦次说出口了啊。",
        "text_idx": [
            2825
        ]
    },
    {
        "ori": "よっぽど慌ててるんだろうな……",
        "message": "看来她是相当慌张啊……",
        "text_idx": [
            2840
        ]
    },
    {
        "name": "蘭",
        "name_idx": 2958,
        "ori": "「ああ、そうだ、思い出したっ！　ルパン！　ルパンの練習をしてたんだよ！」",
        "message": "「啊啊，对了，我想起来了！　鲁邦！　我是在练习鲁邦啊！」",
        "text_idx": [
            2967,
            2968
        ]
    },
    {
        "name": "亮",
        "name_idx": 3018,
        "ori": "「へぇ……」",
        "message": "「哦～……」",
        "text_idx": [
            3027
        ]
    },
    {
        "ori": "本当かよ。",
        "message": "真的假的啊。",
        "text_idx": [
            3042
        ]
    },
    {
        "name": "蘭",
        "name_idx": 3116,
        "ori": "「こ、今度、演劇でアルセーヌ・ルパンをやるんだ！」",
        "message": "「这、这次，我会在话剧里扮演亚森·罗宾！」",
        "text_idx": [
            3125
        ]
    },
    {
        "name": "亮",
        "name_idx": 3131,
        "ori": "「ほお。ちょっとやってみてよ」",
        "message": "「哦？那你来表演一下看看」",
        "text_idx": [
            3140
        ]
    },
    {
        "name": "蘭",
        "name_idx": 3214,
        "ori": "「え！？　う、うん！　不～二乃ちゃん！」",
        "message": "「欸！？　嗯、嗯！　不～二乃酱！」",
        "text_idx": [
            3223
        ]
    },
    {
        "name": "亮",
        "name_idx": 3229,
        "ori": "「あー……。うまいうまい」",
        "message": "「啊—……。不错不错」",
        "text_idx": [
            3238
        ]
    },
    {
        "ori": "いろいろ間違ってるけど……",
        "message": "虽然她错得离谱……",
        "text_idx": [
            3253
        ]
    },
    {
        "ori": "てか、それモーリス・ルブランのルパンじゃないから。",
        "message": "再说了，那也不是莫里斯·勒布朗笔下的亚森·罗宾啊。",
        "text_idx": [
            3268
        ]
    },
    {
        "ori": "そんな穂高を見ていて少し悪戯心が湧いてきた。",
        "message": "看着那样的穗高，我心里稍微涌起了一点恶作剧的念头。",
        "text_idx": [
            3283
        ]
    },
    {
        "name": "亮",
        "name_idx": 3289,
        "ori": "「しかし……今度の演目は椿姫って風の便りに聞いたんだけどな？」",
        "message": "「不过……我好像听传闻说，这次的剧目是《茶花女》来着？」",
        "text_idx": [
            3298,
            3299
        ]
    },
    {
        "ori": "もちろん嘘だけど。",
        "message": "当然，这是我胡说的。",
        "text_idx": [
            3314
        ]
    },
    {
        "name": "蘭",
        "name_idx": 3548,
        "ori": "「えっ！？」",
        "message": "「诶！？」",
        "text_idx": [
            3557
        ]
    },
    {
        "name": "亮",
        "name_idx": 3607,
        "ori": "「でも、ルパンの練習やってるんだろ？おかしいなぁ」",
        "message": "「可是，你不是在练习罗宾吗？真奇怪啊」",
        "text_idx": [
            3616,
            3617
        ]
    },
    {
        "ori": "心底不思議そうな顔をして言うと、穂高はわたわたと慌て始めた。",
        "message": "我装出一副真心感到奇怪的表情后，穗高便开始手忙脚乱起来。",
        "text_idx": [
            3686,
            3687
        ]
    },
    {
        "name": "蘭",
        "name_idx": 3805,
        "ori": "「そ、それはだね！つ、椿姫ＶＳアルセーヌ・ルパンというオリジナルシナリオをね……！」",
        "message": "「那、那是因为！是、是叫《茶花女VS亚森·罗宾》的原创剧本……！」",
        "text_idx": [
            3814,
            3815,
            3816
        ]
    },
    {
        "name": "亮",
        "name_idx": 3822,
        "ori": "「へぇ、面白そうだね。どんなストーリーなの？」",
        "message": "「哦，听起来很有趣啊。是个什么样的故事呢？」",
        "text_idx": [
            3831
        ]
    },
    {
        "name": "蘭",
        "name_idx": 3895,
        "ori": "「えーと、椿姫が付ける赤い椿を巡って……ルパンが……」",
        "message": "「呃……故事是围绕着茶花女佩戴的红色山茶花……罗宾他……」",
        "text_idx": [
            3904,
            3905
        ]
    },
    {
        "ori": "穂高の即興が始まる。",
        "message": "穗高的即兴表演开始了。",
        "text_idx": [
            3920
        ]
    },
    {
        "ori": "ロボットが登場したり、謎の超能力者が現れたり、最後には椿姫とルパンが魔王を協力して倒すという、それはそれはもう涙なしでは見られない感動超大作だった。",
        "message": "先是有机器人登场，然后又出现了神秘的超能力者，最后茶花女和罗宾还联手打倒了魔王，这剧本简直是一部不流泪就看不下去的催泪大作。",
        "text_idx": [
            4043,
            4044,
            4045
        ]
    },
    {
        "name": "亮",
        "name_idx": 4280,
        "ori": "「……良い話だった」",
        "message": "「……真是个好故事」",
        "text_idx": [
            4289
        ]
    },
    {
        "ori": "拍手を送る。",
        "message": "我鼓起了掌。",
        "text_idx": [
            4304
        ]
    },
    {
        "name": "蘭",
        "name_idx": 4368,
        "ori": "「ボクがルパンの練習をしてたのわかってくれた？」",
        "message": "「你看出来我是在练习罗宾了吗？」",
        "text_idx": [
            4377
        ]
    },
    {
        "name": "亮",
        "name_idx": 4397,
        "ori": "「とりあえず、穂高が即興でお話を作るのが上手いことがわかったよ」",
        "message": "「总之，我算是看出来了，穗高你很擅长即兴编故事啊」",
        "text_idx": [
            4406,
            4407
        ]
    },
    {
        "name": "蘭",
        "name_idx": 4471,
        "ori": "「あ……」",
        "message": "「啊……」",
        "text_idx": [
            4480
        ]
    },
    {
        "ori": "穂高が気不味そうな顔をする。",
        "message": "穗高露出一脸尴尬的表情。",
        "text_idx": [
            4495
        ]
    },
    {
        "name": "蘭",
        "name_idx": 4559,
        "ori": "「バレてたの？」",
        "message": "「被你发现了？」",
        "text_idx": [
            4568
        ]
    },
    {
        "name": "亮",
        "name_idx": 4574,
        "ori": "「とっくの昔に」",
        "message": "「早就发现了」",
        "text_idx": [
            4583
        ]
    },
    {
        "ori": "ニッと笑うと、穂高がキーキー言い始めた。",
        "message": "我咧嘴一笑，穗高便气得哇哇叫起来。",
        "text_idx": [
            4598
        ]
    },
    {
        "name": "蘭",
        "name_idx": 4716,
        "ori": "「うぅー意地悪だなー！」",
        "message": "「呜—你真坏心眼！」",
        "text_idx": [
            4725
        ]
    },
    {
        "name": "亮",
        "name_idx": 4731,
        "ori": "「ごめんごめん。悪気はあったんだ」",
        "message": "「抱歉抱歉。我是故意的」",
        "text_idx": [
            4740
        ]
    },
    {
        "name": "蘭",
        "name_idx": 4906,
        "ori": "「あったの！？」",
        "message": "「你居然是故意的！？」",
        "text_idx": [
            4915
        ]
    },
    {
        "name": "亮",
        "name_idx": 5063,
        "ori": "「まぁまぁ」",
        "message": "「好啦好啦」",
        "text_idx": [
            5072
        ]
    },
    {
        "ori": "恨めしそうに睨んでくる穂高をどうどうとなだめる。",
        "message": "我安抚着怨恨地瞪着我的穗高。",
        "text_idx": [
            5175
        ]
    },
    {
        "name": "亮",
        "name_idx": 5181,
        "ori": "「それで？どうして、俺の家にやって来たの？」",
        "message": "「那么？你为什么会来我家？」",
        "text_idx": [
            5190,
            5191
        ]
    },
    {
        "name": "蘭",
        "name_idx": 5313,
        "ori": "「あ、う、うん……」",
        "message": "「啊、唔、嗯……」",
        "text_idx": [
            5322
        ]
    },
    {
        "ori": "穂高は少し言い難そうな顔をする。",
        "message": "穗高露出有些难以启齿的表情。",
        "text_idx": [
            5395
        ]
    },
    {
        "name": "亮",
        "name_idx": 5401,
        "ori": "「何か言い難いこと？」",
        "message": "「有什么不好说的事吗？」",
        "text_idx": [
            5410
        ]
    },
    {
        "name": "蘭",
        "name_idx": 5650,
        "ori": "「いや、そんなんじゃないんだけど……」",
        "message": "「不，倒也不是那样……」",
        "text_idx": [
            5659
        ]
    },
    {
        "ori": "穂高は顔を赤くしてうつむいてしまった。",
        "message": "穗高红着脸低下了头。",
        "text_idx": [
            5674
        ]
    },
    {
        "name": "亮",
        "name_idx": 5680,
        "ori": "「穂高？」",
        "message": "「穗高？」",
        "text_idx": [
            5689
        ]
    },
    {
        "name": "蘭",
        "name_idx": 5753,
        "ori": "「小松原くんが……心配だったんだ……」",
        "message": "「我……有点担心小松原同学……」",
        "text_idx": [
            5762
        ]
    },
    {
        "ori": "ぽつりと。",
        "message": "她小声地说道。",
        "text_idx": [
            5777
        ]
    },
    {
        "ori": "そう呟いて顔を上げた穂高の顔は真っ赤だった。",
        "message": "这么嘟囔着抬起头的穗高，脸蛋涨得通红。",
        "text_idx": [
            5792
        ]
    },
    {
        "name": "亮",
        "name_idx": 5798,
        "ori": "「俺？」",
        "message": "「我？」",
        "text_idx": [
            5807
        ]
    },
    {
        "name": "蘭",
        "name_idx": 5827,
        "ori": "「うん。円のことで悩む小松原くんが心配で。だから、来ちゃったんだ」",
        "message": "「嗯。我很担心为圆的事而烦恼的小松原同学。所以，就跑过来了」",
        "text_idx": [
            5836,
            5837
        ]
    },
    {
        "name": "蘭",
        "name_idx": 5901,
        "ori": "「あ、もちろん円も心配だけど……」",
        "message": "「啊，当然我也很担心圆啦……」",
        "text_idx": [
            5910
        ]
    },
    {
        "name": "亮",
        "name_idx": 5945,
        "ori": "「……なるほど」",
        "message": "「……原来如此」",
        "text_idx": [
            5954
        ]
    },
    {
        "ori": "つまり、穂高は俺と此ノ花さんが心配で相談しに来てくれたのか。",
        "message": "也就是说，穗高是担心我和此之花同学，所以才来找我商量的吗。",
        "text_idx": [
            5969,
            5970
        ]
    },
    {
        "ori": "やっぱ、穂高と此ノ花さんは親友なんだなと思う。",
        "message": "我想，穗高和此之花同学果然是挚友啊。",
        "text_idx": [
            5985
        ]
    },
    {
        "name": "蘭",
        "name_idx": 6005,
        "ori": "「なんか違う解釈をされた気が……まあいいけどさ……」",
        "message": "「总感觉你好像有什么误解……不过算了……」",
        "text_idx": [
            6014
        ]
    },
    {
        "name": "亮",
        "name_idx": 6020,
        "ori": "「ん？」",
        "message": "「嗯？」",
        "text_idx": [
            6029
        ]
    },
    {
        "name": "蘭",
        "name_idx": 6107,
        "ori": "「ううん。なんでもない」",
        "message": "「唔唔。没什么」",
        "text_idx": [
            6116
        ]
    },
    {
        "name": "亮",
        "name_idx": 6122,
        "ori": "「取り敢えず、散歩でもしながら話そうか」",
        "message": "「总之，我们边散步边聊吧」",
        "text_idx": [
            6131
        ]
    },
    {
        "ori": "気分転換を兼ねて提案してみる。",
        "message": "我这么提议，也算是为了转换一下心情。",
        "text_idx": [
            6146
        ]
    },
    {
        "name": "蘭",
        "name_idx": 6166,
        "ori": "「う、うん！」",
        "message": "「嗯、嗯！」",
        "text_idx": [
            6175
        ]
    },
    {
        "ori": "穂高は少し嬉しそうな顔をしていた。",
        "message": "穗高看起来有些高兴。",
        "text_idx": [
            6263
        ]
    },
    {
        "name": "亮",
        "name_idx": 6641,
        "ori": "「結構、寒くなったよね」",
        "message": "「天气变得很冷了呢」",
        "text_idx": [
            6650
        ]
    },
    {
        "name": "蘭",
        "name_idx": 6670,
        "ori": "「そうだね」",
        "message": "「是啊」",
        "text_idx": [
            6679
        ]
    },
    {
        "ori": "夜の空気は少し肌寒い。",
        "message": "夜晚的空气有些微凉。",
        "text_idx": [
            6694
        ]
    },
    {
        "ori": "冬が近づいているんだなと感じる。",
        "message": "我能感觉到冬天正在临近。",
        "text_idx": [
            6709
        ]
    },
    {
        "ori": "俺と並んで歩く穂高に、さっきまで考えていたことを話した。",
        "message": "我向走在我身旁的穗高，说起了刚才一直在想的事情。",
        "text_idx": [
            6724,
            6725
        ]
    },
    {
        "ori": "此ノ花さんの心の闇……",
        "message": "此之花同学内心的黑暗……",
        "text_idx": [
            6740
        ]
    },
    {
        "ori": "俺にも関わり合いがあって、同時に俺以外の何かも関わっているかもしれないこと……",
        "message": "这件事与我有关，同时，也可能与我之外的什么人有关……",
        "text_idx": [
            6755,
            6756
        ]
    },
    {
        "ori": "此ノ花さんの涙が脳裏に浮かぶ。",
        "message": "此之花同学的眼泪浮现在我的脑海里。",
        "text_idx": [
            6771
        ]
    },
    {
        "name": "亮",
        "name_idx": 6777,
        "ori": "「此ノ花さんの悩みは、予想以上に深いのかもしれないな……」",
        "message": "「此之花同学的烦恼，或许比我想象的还要深沉啊……」",
        "text_idx": [
            6786,
            6787
        ]
    },
    {
        "ori": "この言葉は、最後にため息と一緒にこぼれ出た。",
        "message": "这句话，最后伴随着一声叹息脱口而出。",
        "text_idx": [
            6802
        ]
    },
    {
        "ori": "隣を歩く穂高の顔も、どこか悲しそうだった。",
        "message": "走在我身旁的穗高，脸上也带着些许悲伤。",
        "text_idx": [
            6817
        ]
    },
    {
        "name": "蘭",
        "name_idx": 6925,
        "ori": "「小松原くん……」",
        "message": "「小松原同学……」",
        "text_idx": [
            6934
        ]
    },
    {
        "ori": "不意に穂高の足が止まる。",
        "message": "穗高突然停下了脚步。",
        "text_idx": [
            6949
        ]
    },
    {
        "name": "亮",
        "name_idx": 6955,
        "ori": "「ん？」",
        "message": "「嗯？」",
        "text_idx": [
            6964
        ]
    },
    {
        "ori": "振り返って穂高の顔を見ると、少し緊張した面持ちだった。",
        "message": "我回头看向穗高的脸，发现她带着些许紧张的神情。",
        "text_idx": [
            7609,
            7610
        ]
    },
    {
        "name": "蘭",
        "name_idx": 7630,
        "ori": "「どうして、円のためにそんなに真剣に悩んでるの？」",
        "message": "「为什么，你要为了圆那么认真地烦恼呢？」",
        "text_idx": [
            7639
        ]
    },
    {
        "ori": "その言葉にはほんの少しだけ、とげがあった。",
        "message": "她的话语里，带着一丝尖刺。",
        "text_idx": [
            7654
        ]
    },
    {
        "name": "亮",
        "name_idx": 7660,
        "ori": "「……どういうこと？」",
        "message": "「……什么意思？」",
        "text_idx": [
            7669
        ]
    },
    {
        "name": "蘭",
        "name_idx": 7689,
        "ori": "「円と出会ってまだ浅いのに、どうしてそんなに真剣に円を心配するのかなって気になって……」",
        "message": "「你和圆才认识不久，为什么会这么认真地为圆担心呢，我有点在意……」",
        "text_idx": [
            7698,
            7699
        ]
    },
    {
        "name": "亮",
        "name_idx": 7705,
        "ori": "「…………」",
        "message": "「…………」",
        "text_idx": [
            7714
        ]
    },
    {
        "ori": "穂高の疑問は、俺が先ほど抱いた疑問と同じだった。",
        "message": "穗高的疑问，和我刚才抱有的疑问一样。",
        "text_idx": [
            7729
        ]
    },
    {
        "ori": "どうして、俺は此ノ花さんのために……？",
        "message": "为什么，我要为了此之花同学……？",
        "text_idx": [
            7744
        ]
    },
    {
        "ori": "しばらく考える。",
        "message": "我思考了片刻。",
        "text_idx": [
            7759
        ]
    },
    {
        "name": "亮",
        "name_idx": 7765,
        "ori": "「ん～」",
        "message": "「嗯～」",
        "text_idx": [
            7774
        ]
    },
    {
        "ori": "夜風が頬を撫でていく。",
        "message": "夜风拂过我的脸颊。",
        "text_idx": [
            7789
        ]
    },
    {
        "ori": "夜空を見上げる。",
        "message": "我抬头仰望夜空。",
        "text_idx": [
            8043
        ]
    },
    {
        "ori": "そうしていると、ふっと一つ、答えが心に浮いてきた。",
        "message": "就在这时，一个答案悄然浮现在我的心头。",
        "text_idx": [
            8058
        ]
    },
    {
        "name": "亮",
        "name_idx": 8064,
        "ori": "「此ノ花さんは……俺を救い出してくれた恩人だから」",
        "message": "「此之花同学她……是拯救了我的恩人」",
        "text_idx": [
            8073
        ]
    },
    {
        "name": "蘭",
        "name_idx": 8093,
        "ori": "「恩人……？」",
        "message": "「恩人……？」",
        "text_idx": [
            8102
        ]
    },
    {
        "name": "亮",
        "name_idx": 8108,
        "ori": "「そう、恩人」",
        "message": "「没错，恩人」",
        "text_idx": [
            8117
        ]
    },
    {
        "name": "蘭",
        "name_idx": 8137,
        "ori": "「……今朝言っていた、背中を押してくれて、吹っ切らせてくれた……っていうアレ？」",
        "message": "「……就是你今早说的，推了你一把，让你下定决心的那件事……？」",
        "text_idx": [
            8146,
            8147
        ]
    },
    {
        "name": "亮",
        "name_idx": 8153,
        "ori": "「ああ」",
        "message": "「嗯」",
        "text_idx": [
            8162
        ]
    },
    {
        "name": "蘭",
        "name_idx": 8182,
        "ori": "「詳しく聞きたい……。いい？」",
        "message": "「我想听听具体情况……。可以吗？」",
        "text_idx": [
            8191
        ]
    },
    {
        "name": "亮",
        "name_idx": 8197,
        "ori": "「いいよ」",
        "message": "「可以啊」",
        "text_idx": [
            8206
        ]
    },
    {
        "ori": "母さんと会う踏ん切りが付けられなかったところを、此ノ花さんに助けられた。",
        "message": "在我迟迟下不了决心去见母亲的时候，是此之花同学帮助了我。",
        "text_idx": [
            8221,
            8222
        ]
    },
    {
        "ori": "その事を穂高に軽く説明する。",
        "message": "我把这件事简单地对穗高说明了一下。",
        "text_idx": [
            8237
        ]
    },
    {
        "name": "蘭",
        "name_idx": 8487,
        "ori": "「そんなことがあったんだ」",
        "message": "「原来发生过这种事啊」",
        "text_idx": [
            8496
        ]
    },
    {
        "ori": "穂高は少し驚きつつも真剣な顔で聞いていた。",
        "message": "穗高虽然有些惊讶，但还是表情认真地听着我说的话。",
        "text_idx": [
            8511
        ]
    },
    {
        "name": "亮",
        "name_idx": 8517,
        "ori": "「……だから、此ノ花さんが帰ってしまう前に俺も同じように救ってあげたいと思っている」",
        "message": "「……所以，在此之花同学回去之前，我也想用同样的方式去拯救她」",
        "text_idx": [
            8526,
            8527
        ]
    },
    {
        "ori": "こうして言葉にしてみると、しっくりきた。",
        "message": "当我把这些话说出口后，感觉非常贴切。",
        "text_idx": [
            8542
        ]
    },
    {
        "ori": "その気持ちには嘘偽りはない。",
        "message": "这份心情绝无半点虚假。",
        "text_idx": [
            8557
        ]
    },
    {
        "ori": "だから、穂高に俺の気持ちが伝わるように、真っ直ぐ目を見て言った。",
        "message": "所以，为了让穗高明白我的心情，我直视着她的眼睛说道。",
        "text_idx": [
            8572,
            8573
        ]
    },
    {
        "name": "亮",
        "name_idx": 8579,
        "ori": "「これは、恩返しでもあるんだ」",
        "message": "「这也是一种报恩」",
        "text_idx": [
            8588
        ]
    },
    {
        "name": "蘭",
        "name_idx": 8652,
        "ori": "「そう……だったんだ」",
        "message": "「原来……是这样啊」",
        "text_idx": [
            8661
        ]
    },
    {
        "ori": "穂高が目を伏せて呟く。",
        "message": "穗高垂下眼帘低语道。",
        "text_idx": [
            8676
        ]
    },
    {
        "ori": "俺の気持ちに嘘偽りがないと伝わってくれたのか、さっきまで緊張していた穂高の顔が安心したように緩んでいた。",
        "message": "或许是我的真情实意传达给了她吧，穗高那直到刚才还很紧张的表情，此刻像是安心了一般缓和了下来。",
        "text_idx": [
            8691,
            8692
        ]
    },
    {
        "name": "蘭",
        "name_idx": 8756,
        "ori": "「はうあ……」",
        "message": "「啊呜啊……」",
        "text_idx": [
            8765
        ]
    },
    {
        "ori": "穂高が唐突に表情を崩して悶え始めた。",
        "message": "穗高突然表情一垮，开始扭捏不安起来。",
        "text_idx": [
            8780
        ]
    },
    {
        "name": "蘭",
        "name_idx": 8844,
        "ori": "「ボクは、早とちりが激しくてダメだなぁ……」",
        "message": "「我这个人，总是急着下结论，真是不行啊……」",
        "text_idx": [
            8853
        ]
    },
    {
        "name": "亮",
        "name_idx": 8859,
        "ori": "「え？」",
        "message": "「诶？」",
        "text_idx": [
            8868
        ]
    },
    {
        "name": "蘭",
        "name_idx": 8932,
        "ori": "「ボクはてっきり……小松原くんが円のことを好きで、それで真剣に悩んでいるんだと……」",
        "message": "「我还以为……小松原同学你是喜欢圆，所以才那么认真地烦恼着……」",
        "text_idx": [
            8941,
            8942
        ]
    },
    {
        "name": "亮",
        "name_idx": 8948,
        "ori": "「なんでそんなことを……？」",
        "message": "「为什么会那么想……？」",
        "text_idx": [
            8957
        ]
    },
    {
        "name": "蘭",
        "name_idx": 9197,
        "ori": "「そ、それは……その、なんて言ったらいいのか……」",
        "message": "「那、那个是……那个，该怎么说好呢……」",
        "text_idx": [
            9206
        ]
    },
    {
        "ori": "穂高は月明かりでも分かるぐらいに、顔を赤くしてうつむいた。",
        "message": "穗高满脸通红地垂下了头，在月光下也能看得一清二楚。",
        "text_idx": [
            9221,
            9222
        ]
    },
    {
        "ori": "「俺の事が好きなの？」",
        "message": "「你喜欢我吗？」",
        "text_idx": [
            9266
        ]
    },
    {
        "ori": "「言いたい事ハッキリ言えよ」",
        "message": "「想说的话就直说吧」",
        "text_idx": [
            9286
        ]
    }
]