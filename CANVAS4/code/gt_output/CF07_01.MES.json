[
    {
        "ori": "放課後が訪れ、俺はいそいそと講堂へ向かっていた。",
        "message": "放学后，我兴冲冲地向礼堂走去。",
        "text_idx": [
            99
        ]
    },
    {
        "ori": "今日、理事長がヴィオラの練習を見てくれるらしく、お昼休みに紬さんに誘われたのだ。",
        "message": "听说今天理事长要来看中提琴的练习，午休时紬同学邀请了我。",
        "text_idx": [
            114,
            115
        ]
    },
    {
        "ori": "なんだか嬉しかった。",
        "message": "我总觉得很开心。",
        "text_idx": [
            130
        ]
    },
    {
        "ori": "ヴィオラの練習に誘われたのはもちろん、お昼の紬さんが心の底から笑っていたことが嬉しかった。",
        "message": "能被邀请参加中提琴练习固然很开心，但更让我开心的，是午休时紬同学那发自内心的笑容。",
        "text_idx": [
            145,
            146
        ]
    },
    {
        "ori": "それに一層仲良くなれた気がするし。",
        "message": "而且我感觉我们之间的关系也更近了一步。",
        "text_idx": [
            161
        ]
    },
    {
        "ori": "ヴィオラの音色が聴こえてくる。",
        "message": "我听到了中提琴的音色。",
        "text_idx": [
            258
        ]
    },
    {
        "name": "亮",
        "name_idx": 264,
        "ori": "「……」",
        "message": "「……」",
        "text_idx": [
            273
        ]
    },
    {
        "ori": "足を止めて、耳を澄ました。",
        "message": "我停下脚步，侧耳倾听。",
        "text_idx": [
            288
        ]
    },
    {
        "ori": "光沢があって生気溢れるその音色は、強く優しく胸に染みわたってくる。",
        "message": "那充满光泽与生机的音色，强烈而又温柔地沁入我的心脾。",
        "text_idx": [
            303,
            304
        ]
    },
    {
        "name": "亮",
        "name_idx": 310,
        "ori": "「これが不調？」",
        "message": "「这就是状态不好？」",
        "text_idx": [
            319
        ]
    },
    {
        "ori": "なんか前より良い響きなっている気がするんだけど？",
        "message": "我总觉得这声音比之前还要动听了？",
        "text_idx": [
            334
        ]
    },
    {
        "ori": "首を傾げながら、音の世界を奏でているそこへ向かった。",
        "message": "我一边感到不解，一边走向那个正奏响着音乐世界的地方。",
        "text_idx": [
            349
        ]
    },
    {
        "name": "紬",
        "name_idx": 633,
        "ori": "「あ、亮くん！」",
        "message": "「啊，亮君！」",
        "text_idx": [
            642
        ]
    },
    {
        "ori": "目が合った瞬間、奏でるのをやめて大きく手を振る。",
        "message": "在视线对上的瞬间，她便停下演奏，用力地朝我挥手。",
        "text_idx": [
            671
        ]
    },
    {
        "ori": "側に居た理事長もそれで振り返ってきて、にっこりと微笑んでくる。",
        "message": "待在她身边的理事长也因此回过头来，微笑着看向我。",
        "text_idx": [
            686,
            687
        ]
    },
    {
        "name": "藍",
        "name_idx": 707,
        "ori": "「こんにちは」",
        "message": "「你好」",
        "text_idx": [
            716
        ]
    },
    {
        "name": "亮",
        "name_idx": 722,
        "ori": "「こんにちは」",
        "message": "「你好」",
        "text_idx": [
            731
        ]
    },
    {
        "name": "藍",
        "name_idx": 751,
        "ori": "「紬さん続けて下さい」",
        "message": "「紬小姐，请继续吧」",
        "text_idx": [
            760
        ]
    },
    {
        "name": "紬",
        "name_idx": 868,
        "ori": "「はい」",
        "message": "「嗯」",
        "text_idx": [
            877
        ]
    },
    {
        "ori": "にこにことしていた顔を引き締めて、紬さんはヴィオラを構える。",
        "message": "紬小姐收起笑眯眯的表情，将中提琴架好。",
        "text_idx": [
            892,
            893
        ]
    },
    {
        "name": "紬",
        "name_idx": 1015,
        "ori": "「ふぅ」",
        "message": "「呼」",
        "text_idx": [
            1024
        ]
    },
    {
        "ori": "小さい呼吸の後に、聴こえてくるのは先ほどの力強い生気溢れる音色。",
        "message": "一次短促的呼吸后，传来的是刚才那强劲有力、生机盎然的音色。",
        "text_idx": [
            1135,
            1136
        ]
    },
    {
        "ori": "圧倒され魅了される。",
        "message": "我被其震撼，为之着迷。",
        "text_idx": [
            1151
        ]
    },
    {
        "ori": "一つ一つの音に響きに命が宿っていて、それが互いに影響し合い色が生まれ世界が構築されていく。",
        "message": "每一个音符与回响都寄宿着生命，它们相互影响，诞生出色彩，构筑起一个世界。",
        "text_idx": [
            1166,
            1167
        ]
    },
    {
        "ori": "それは、目を開けたまま見る夢のようだった。",
        "message": "那就像一场睁着眼睛做的梦。",
        "text_idx": [
            1182
        ]
    },
    {
        "ori": "時間を忘れて、ただただその夢の中に浸り続ける。",
        "message": "我忘却了时间，只是一心沉浸在那梦中。",
        "text_idx": [
            1197
        ]
    },
    {
        "name": "藍",
        "name_idx": 1311,
        "ori": "「どうでしょうか？」",
        "message": "「怎么样？」",
        "text_idx": [
            1320
        ]
    },
    {
        "name": "亮",
        "name_idx": 1326,
        "ori": "「え？」",
        "message": "「诶？」",
        "text_idx": [
            1335
        ]
    },
    {
        "ori": "気付けば音はやんでいた。",
        "message": "回过神来，音乐声已经停了。",
        "text_idx": [
            1526
        ]
    },
    {
        "ori": "呆けていたらしい。",
        "message": "我好像听得出神了。",
        "text_idx": [
            1541
        ]
    },
    {
        "ori": "意識が現実に返ってくるが、余韻がまだ耳に残っていて、まだ少し夢心地だった。",
        "message": "意识虽然回到了现实，但余音仍在耳边回响，让我还有些如梦似幻。",
        "text_idx": [
            1556,
            1557
        ]
    },
    {
        "name": "亮",
        "name_idx": 1563,
        "ori": "「前より、良くなってません？」",
        "message": "「是不是比之前更好了？」",
        "text_idx": [
            1572
        ]
    },
    {
        "ori": "素直な意見だった。",
        "message": "这是我坦率的感想。",
        "text_idx": [
            1587
        ]
    },
    {
        "name": "藍",
        "name_idx": 1607,
        "ori": "「そうですね。前よりも良くなっています」",
        "message": "「说的是呢。确实比之前更好了」",
        "text_idx": [
            1616
        ]
    },
    {
        "name": "紬",
        "name_idx": 1734,
        "ori": "「本当ですか！？」",
        "message": "「真的吗！？」",
        "text_idx": [
            1743
        ]
    },
    {
        "name": "藍",
        "name_idx": 1807,
        "ori": "「はい。久しぶり良い音を聴きました」",
        "message": "「是的。好久没听到这么好的声音了」",
        "text_idx": [
            1816
        ]
    },
    {
        "name": "紬",
        "name_idx": 1934,
        "ori": "「やったー！」",
        "message": "「太棒啦！」",
        "text_idx": [
            1943
        ]
    },
    {
        "ori": "子供のようにはしゃぐ紬さんは、そのまま俺に抱きついてきた。",
        "message": "紬小姐像个孩子一样欢呼雀跃，就这样直接抱住了我。",
        "text_idx": [
            1958,
            1959
        ]
    },
    {
        "name": "紬",
        "name_idx": 2067,
        "ori": "「亮くん、やったですわ！」",
        "message": "「亮君，我成功了！」",
        "text_idx": [
            2076
        ]
    },
    {
        "name": "亮",
        "name_idx": 2082,
        "ori": "「ちょ、ちょっと、気を付けないと、ヴィオラ落としますよ」",
        "message": "「喂、喂，小心点，不然中提琴会掉下去的哦」",
        "text_idx": [
            2091,
            2092
        ]
    },
    {
        "ori": "俺の注意を聞かず、紬さんはずっとはしゃいでいた。",
        "message": "紬小姐没有听我的提醒，一直在欢呼雀跃。",
        "text_idx": [
            2107
        ]
    },
    {
        "ori": "まあ仕方ないよなぁ。",
        "message": "嘛，这也是没办法的事呢。",
        "text_idx": [
            2122
        ]
    },
    {
        "name": "藍",
        "name_idx": 2200,
        "ori": "「んー」",
        "message": "「唔—」",
        "text_idx": [
            2209
        ]
    },
    {
        "name": "亮",
        "name_idx": 2215,
        "ori": "「理事長？」",
        "message": "「理事长？」",
        "text_idx": [
            2224
        ]
    },
    {
        "name": "藍",
        "name_idx": 2302,
        "ori": "「この短い間に何があったんでしょうね？」",
        "message": "「在这短短的时间里，是发生了什么呢？」",
        "text_idx": [
            2311
        ]
    },
    {
        "ori": "俺を見てニヤニヤと笑ってくる。",
        "message": "她看着我坏笑起来。",
        "text_idx": [
            2326
        ]
    },
    {
        "ori": "全部知ってますよというようなその顔にヒヤヒヤした。",
        "message": "她那副仿佛在说我什么都知道了的表情，让我心惊胆战。",
        "text_idx": [
            2341
        ]
    },
    {
        "name": "亮",
        "name_idx": 2347,
        "ori": "「さ、さぁ、何があったんでしょうね？」",
        "message": "「那、那个，是发生了什么事呢？」",
        "text_idx": [
            2356
        ]
    },
    {
        "name": "紬",
        "name_idx": 2473,
        "ori": "「藍姉さま、知りたいですか？」",
        "message": "「蓝姐姐，您想知道吗？」",
        "text_idx": [
            2482
        ]
    },
    {
        "name": "亮",
        "name_idx": 2528,
        "ori": "「紬さん！？」",
        "message": "「紬同学！？」",
        "text_idx": [
            2537
        ]
    },
    {
        "ori": "少し勝ち誇った顔で、理事長を見る紬さん。",
        "message": "紬小姐带着一丝得意的表情看着理事长。",
        "text_idx": [
            2552
        ]
    },
    {
        "ori": "理事長は興味深そうに頷いた。",
        "message": "理事长饶有兴致地点了点头。",
        "text_idx": [
            2567
        ]
    },
    {
        "name": "藍",
        "name_idx": 2587,
        "ori": "「ぜひ、聞かせてください、紬さん」",
        "message": "「请务必说来听听，紬小姐」",
        "text_idx": [
            2596
        ]
    },
    {
        "name": "紬",
        "name_idx": 2704,
        "ori": "「私、亮くんと――」",
        "message": "「我，和亮君——」",
        "text_idx": [
            2713
        ]
    },
    {
        "name": "亮",
        "name_idx": 2759,
        "ori": "「ああああ！　紬さん、ＵＦＯが飛んでる！」",
        "message": "「啊啊啊啊！　紬小姐，有UFO在飞！」",
        "text_idx": [
            2768
        ]
    },
    {
        "ori": "邪魔するが、押し退けられた。",
        "message": "我虽然想去阻止，但还是被她推开了。",
        "text_idx": [
            2783
        ]
    },
    {
        "name": "紬",
        "name_idx": 2891,
        "ori": "「亮くんと、繋がりあったんです！」",
        "message": "「我和亮君，我们连在一起了！」",
        "text_idx": [
            2900
        ]
    },
    {
        "name": "藍",
        "name_idx": 2920,
        "ori": "「もっと詳しく詳しく。一体何が繋がりあったんですか？」",
        "message": "「再详细点，再详细点。到底是什么连在一起了呢？」",
        "text_idx": [
            2929,
            2930
        ]
    },
    {
        "name": "亮",
        "name_idx": 2981,
        "ori": "「理事長！？」",
        "message": "「理事长！？」",
        "text_idx": [
            2990
        ]
    },
    {
        "ori": "興味津々といった顔の理事長となぜか誇らしげな紬さん。",
        "message": "理事长一脸兴致勃勃，而紬小姐则不知为何一脸得意。",
        "text_idx": [
            3005
        ]
    },
    {
        "ori": "なんだこの二人！",
        "message": "这两人搞什么啊！",
        "text_idx": [
            3181
        ]
    },
    {
        "ori": "これが鷺ノ宮の血というのか……！？",
        "message": "这就是所谓的鹭之宫之血吗……！？",
        "text_idx": [
            3196
        ]
    },
    {
        "name": "紬",
        "name_idx": 3254,
        "ori": "「えっとですね、か――」",
        "message": "「那个呢，是身——」",
        "text_idx": [
            3263
        ]
    },
    {
        "name": "亮",
        "name_idx": 3314,
        "ori": "「心ですッ！！！」",
        "message": "「是心啊！！！」",
        "text_idx": [
            3323
        ]
    },
    {
        "name": "亮",
        "name_idx": 3329,
        "ori": "「心が繋がりあったんです！」",
        "message": "「是心连在了一起！」",
        "text_idx": [
            3338
        ]
    },
    {
        "ori": "力強く叫んだ。",
        "message": "我用尽全力地大喊道。",
        "text_idx": [
            3353
        ]
    },
    {
        "name": "藍",
        "name_idx": 3417,
        "ori": "「ちょっと亮さん、邪魔しないでください」",
        "message": "「亮先生，请不要妨碍我」",
        "text_idx": [
            3426
        ]
    },
    {
        "name": "紬",
        "name_idx": 3534,
        "ori": "「そうですよ、亮くん」",
        "message": "「是啊，亮君」",
        "text_idx": [
            3543
        ]
    },
    {
        "name": "亮",
        "name_idx": 3549,
        "ori": "「……」",
        "message": "「……」",
        "text_idx": [
            3558
        ]
    },
    {
        "name": "藍",
        "name_idx": 3622,
        "ori": "「それで、一体何が繋がりあったんですか？」",
        "message": "「所以，到底是什么连在了一起呢？」",
        "text_idx": [
            3631
        ]
    },
    {
        "name": "紬",
        "name_idx": 3739,
        "ori": "「か――」",
        "message": "「身——」",
        "text_idx": [
            3748
        ]
    },
    {
        "name": "亮",
        "name_idx": 3799,
        "ori": "「魂ですッ！！！」",
        "message": "「是灵魂啊！！！」",
        "text_idx": [
            3808
        ]
    },
    {
        "name": "亮",
        "name_idx": 3814,
        "ori": "「魂から繋がりあったんです！」",
        "message": "「我们是从灵魂连在一起的！」",
        "text_idx": [
            3823
        ]
    },
    {
        "name": "紬",
        "name_idx": 3931,
        "ori": "「ちょっと、亮くん、うるさいですわ」",
        "message": "「我说，亮君，你好吵呀」",
        "text_idx": [
            3940
        ]
    },
    {
        "name": "藍",
        "name_idx": 4004,
        "ori": "「そうですよ、ちょっと黙っていてください」",
        "message": "「是啊，请你安静一点」",
        "text_idx": [
            4013
        ]
    },
    {
        "name": "亮",
        "name_idx": 4019,
        "ori": "「いや、俺はなんと言われようとも、阻止続けます！」",
        "message": "「不，不管你们怎么说，我都会继续阻止下去！」",
        "text_idx": [
            4028
        ]
    },
    {
        "ori": "………………",
        "message": "………………",
        "text_idx": [
            4118
        ]
    },
    {
        "ori": "…………",
        "message": "…………",
        "text_idx": [
            4178
        ]
    },
    {
        "ori": "……",
        "message": "……",
        "text_idx": [
            4238
        ]
    },
    {
        "ori": "その日、講堂には俺の絶叫が木霊しまくった。",
        "message": "那天，我的惨叫声在讲堂里不断回响。",
        "text_idx": [
            4253
        ]
    }
]