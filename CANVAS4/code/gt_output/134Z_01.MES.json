[
    {
        "ori": "放課後の部活動。",
        "message": "放学后的社团活动。",
        "text_idx": [
            46
        ]
    },
    {
        "ori": "文化祭、そして芸術祭を目前に迎えた美術室は、しん……と静かな空気に包まれていた。",
        "message": "文化节和艺术节近在眼前，美术室里笼罩着一片……寂静的空气。",
        "text_idx": [
            61,
            62
        ]
    },
    {
        "ori": "外から聞こえてくる喧噪、文化祭の準備に沸き立つ声が別世界かと思うほどに。",
        "message": "外面传来的喧嚣，为文化节做准备而热闹起来的声音，让人觉得仿佛是另一个世界。",
        "text_idx": [
            77,
            78
        ]
    },
    {
        "ori": "いつもは騒がしいことのも今日は大人しく、部長にいたってはいもしない。",
        "message": "平时很吵闹的琴乃今天也很安分，而部长则根本不在。",
        "text_idx": [
            93,
            94
        ]
    },
    {
        "ori": "おかげで今日は制作もはかどる。",
        "message": "多亏了这样，今天的创作也能进展顺利。",
        "text_idx": [
            109
        ]
    },
    {
        "ori": "はずだった。",
        "message": "本应如此的。",
        "text_idx": [
            124
        ]
    },
    {
        "ori": "迷いも吹っ切って、さっさと絵の仕上げをしてしまう。",
        "message": "甩开迷茫，赶快把画完成。",
        "text_idx": [
            139
        ]
    },
    {
        "ori": "美術室に来て、キャンバスの前に立つまではそう考えていた。",
        "message": "在来到美术室，站到画布前为止，我都是这么想的。",
        "text_idx": [
            154,
            155
        ]
    },
    {
        "ori": "なのに今、俺の手はこれまでと同じようにちっとも動かない。",
        "message": "然而现在，我的手却和之前一样，丝毫动弹不得。",
        "text_idx": [
            170,
            171
        ]
    },
    {
        "ori": "俺を縛るものは、もう何もないはずなのに。",
        "message": "明明已经没有什么东西能束缚我了才对。",
        "text_idx": [
            186
        ]
    },
    {
        "ori": "………………………………",
        "message": "………………………………",
        "text_idx": [
            201
        ]
    },
    {
        "ori": "少し気分転換しに行こうかな。",
        "message": "去稍微转换一下心情吧。",
        "text_idx": [
            216
        ]
    },
    {
        "ori": "「ことのをからかう」",
        "message": "「捉弄琴乃」",
        "text_idx": [
            260
        ]
    },
    {
        "ori": "「喫茶店に行く」",
        "message": "「去咖啡店」",
        "text_idx": [
