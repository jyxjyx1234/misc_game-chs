        "ori": "もくもくもくもく……",
        "message": "默默默默……",
        "text_idx": [
            212
        ]
    },
    {
        "name": "杏子",
        "name_idx": 290,
        "ori": "「なあ、ことの……亮くんってば急にどうしちゃったんだ？」",
        "message": "「我说，琴乃……亮他突然是怎么了？」",
        "text_idx": [
            299,
            300
        ]
    },
    {
        "name": "ことの",
        "name_idx": 364,
        "ori": "「それはね、ぶちょ――」",
        "message": "「那是因为，部长——」",
        "text_idx": [
            373
        ]
    },
    {
        "name": "亮",
        "name_idx": 379,
        "ori": "「ことの。話すのはかまわないけど、動くのは無しな」",
        "message": "「琴乃。聊天可以，但不许动」",
        "text_idx": [
            388
        ]
    },
    {
        "name": "ことの",
        "name_idx": 452,
        "ori": "「う、うん。ごめんなさい、亮ちゃん」",
        "message": "「唔、嗯。对不起，小亮」",
        "text_idx": [
            461
        ]
    },
    {
        "ori": "カリカリカリカリ……",
        "message": "沙沙沙沙……",
        "text_idx": [
            476
        ]
    },
    {
        "ori": "もくもくもくもく……",
        "message": "默默默默……",
        "text_idx": [
            491
        ]
    },
    {
        "name": "杏子",
        "name_idx": 555,
        "ori": "「先週までは美術室に来すらしなかったのに、なんで今になって脇目もふらずに絵を描いてるんだ？」",
        "message": "「他明明直到上周都还不见人来美术室，怎么现在就这么心无旁骛地画起画来了？」",
        "text_idx": [
            564,
            565
        ]
    },
    {
        "name": "さつき",
        "name_idx": 629,
        "ori": "「絵を辞めたって噂も出たくらいよ？」",
        "message": "「都有传闻说他已经不画了呢？」",
        "text_idx": [
            638
        ]
    },
    {
        "name": "ことの",
        "name_idx": 702,
        "ori": "「それはね、色々とあったんだけど、答えは亮ちゃんが描く絵にあると思うの」",
        "message": "「这个嘛，虽然发生了很多事，但我想答案就在小亮画的画里」",
        "text_idx": [
            711,
            712
        ]
    },
    {
        "name": "ことの",
        "name_idx": 732,
        "ori": "「だからもうちょっと待ってくれないかな？」",
        "message": "「所以能再稍微等一下吗？」",
        "text_idx": [
            741
        ]
    },
    {
        "name": "杏子",
        "name_idx": 805,
        "ori": "「よくわからないけど、期待はできそうだね」",
        "message": "「虽然搞不太懂，不过看来值得期待呢」",
        "text_idx": [
            814
        ]
    },
    {
        "name": "さつき",
        "name_idx": 878,
        "ori": "「小松原くんからひと皮剥けたって感じがするわ。何かはわからないけど、あったんだね」",
        "message": "「感觉小松原同学像是脱胎换骨了一样。虽然不知道具体是什么，但肯定发生了什么事吧」",
        "text_idx": [
            887,
            888
        ]
    },
    {
        "name": "ことの",
        "name_idx": 952,
        "ori": "「うん。亮ちゃんのことは信じていいよ。私が保証する」",
        "message": "「嗯。你们可以相信小亮的。我保证」",
        "text_idx": [
            961
        ]
    },
    {
        "ori": "みんなが話していることに耳も傾けず、俺は真っ直ぐにことのを見つめ、感じたものすべてを画面にぶつけていた。",
        "message": "我没有理会大家的谈话，只是径直地凝视着琴乃，将感受到的一切都倾泻在画布上。",
        "text_idx": [
            976,
            977,
            978
        ]
    }
]