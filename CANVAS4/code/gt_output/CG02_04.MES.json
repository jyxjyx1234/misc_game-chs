[
    {
        "name": "亮",
        "name_idx": 564,
        "ori": "「バカだな……」",
        "message": "「真是个傻瓜啊……」",
        "text_idx": [
            573
        ]
    },
    {
        "ori": "それは自然に口からこぼれ出た言葉だった。",
        "message": "这句话是自然而然脱口而出的。",
        "text_idx": [
            588
        ]
    },
    {
        "name": "蘭",
        "name_idx": 608,
        "ori": "「そんなことわかってるよ……」",
        "message": "「这种事我当然知道啊……」",
        "text_idx": [
            617
        ]
    },
    {
        "name": "亮",
        "name_idx": 623,
        "ori": "「どうして、そんなに自分を卑下するの？」",
        "message": "「为什么，要这么贬低自己呢？」",
        "text_idx": [
            632
        ]
    },
    {
        "name": "蘭",
        "name_idx": 652,
        "ori": "「う、うん……」",
        "message": "「唔、嗯……」",
        "text_idx": [
            661
        ]
    },
    {
        "ori": "穂高はシュンとして、うつむいた。",
        "message": "穗高垂头丧气地低下了头。",
        "text_idx": [
            676
        ]
    },
    {
        "ori": "その穂高に笑いかける。",
        "message": "我对着那样的穗高笑了笑。",
        "text_idx": [
            691
        ]
    },
    {
        "name": "亮",
        "name_idx": 697,
        "ori": "「俺は、今まで穂高のこと男とか女とか意識して見たことがなかったんだ」",
        "message": "「我，至今为止从来没有把穗高当成男生或女生来看待过」",
        "text_idx": [
            706,
            707
        ]
    },
    {
        "name": "蘭",
        "name_idx": 727,
        "ori": "「うん……」",
        "message": "「嗯……」",
        "text_idx": [
            736
        ]
    },
    {
        "name": "亮",
        "name_idx": 742,
        "ori": "「でも今は、とても意識しちゃう。女の子に見えるよ」",
        "message": "「但是现在，我却非常在意。你看起来就是一个女孩子哦」",
        "text_idx": [
            751
        ]
    },
    {
        "name": "蘭",
        "name_idx": 771,
        "ori": "「ほ、本当？」",
        "message": "「真、真的？」",
        "text_idx": [
            780
        ]
    },
    {
        "name": "亮",
        "name_idx": 786,
        "ori": "「うん」",
        "message": "「嗯」",
        "text_idx": [
            795
        ]
    },
    {
        "ori": "確かに、ちょっと前までは、穂高に対して特別な感情を抱いたことはなかった。",
        "message": "的确，直到不久前，我对穗高都未曾抱有什么特别的感情。",
        "text_idx": [
            810,
            811
        ]
    },
    {
        "ori": "男とか女とか意識して見ていなかった。",
        "message": "我并没有在意过她是男生还是女生。",
        "text_idx": [
            826
        ]
    },
    {
        "ori": "けれど、此ノ花さんを交え関わって行くにつれて……",
        "message": "但是，随着和此之花同学的接触加深……",
        "text_idx": [
            841
        ]
    },
    {
        "ori": "穂高蘭という一人の人間の魅力、女の子としての魅力に気付くことが出来た。",
        "message": "我才得以注意到，穗高兰这个人的魅力，以及她作为女孩子的魅力。",
        "text_idx": [
            856,
            857
        ]
    },
    {
        "ori": "それは、たぶん穂高の力なんだと思う。",
        "message": "我想，那大概是穗高自身的力量吧。",
        "text_idx": [
            872
        ]
    },
    {
        "ori": "穂高が本来持っている魅力。",
        "message": "是穗高与生俱来的魅力。",
        "text_idx": [
            887
        ]
    },
    {
        "ori": "此ノ花さんにも負けない魅力。",
        "message": "是不输给此之花同学的魅力。",
        "text_idx": [
            902
        ]
    },
    {
        "name": "亮",
        "name_idx": 908,
        "ori": "「でもまさか、こんな風に告白されるなんて思わなかったよ」",
        "message": "「不过我真没想到，会被你这样告白啊」",
        "text_idx": [
            917,
            918
        ]
    },
    {
        "name": "蘭",
        "name_idx": 938,
        "ori": "「そ、そうだよね……」",
        "message": "「说、说得也是呢……」",
        "text_idx": [
            947
        ]
    },
    {
        "ori": "どうしよう。",
        "message": "我该怎么办。",
        "text_idx": [
            962
        ]
    },
    {
        "ori": "穂高の想い……",
        "message": "穗高的心意……",
        "text_idx": [
            977
        ]
    },
    {
        "ori": "ここで、ＯＫを出すの容易い事だ。",
        "message": "在这里答应她，是件很容易的事。",
        "text_idx": [
            992
        ]
    },
    {
        "ori": "けれど……此ノ花さんの事もあるし、ここでＯＫを出してしまっていいのだろうか。",
        "message": "可是……还有此之花同学的事，我在这里答应下来真的好吗。",
        "text_idx": [
            1007,
            1008
        ]
    },
    {
        "ori": "暗闇の中の此ノ花さんを放って……",
        "message": "抛下黑暗中的此之花同学……",
        "text_idx": [
            1023
        ]
    },
    {
        "name": "亮",
        "name_idx": 1029,
        "ori": "「……」",
        "message": "「……」",
        "text_idx": [
            1038
        ]
    },
    {
        "ori": "頬を撫でる冷たい風が、思考の中に埋まっていた俺を呼び戻した。",
        "message": "拂过脸颊的冷风，将沉浸在思绪中的我拉了回来。",
        "text_idx": [
            1053,
            1054
        ]
    },
    {
        "ori": "どれぐらい考えたのだろう。",
        "message": "我究竟思考了多久呢。",
        "text_idx": [
            1069
        ]
    },
    {
        "ori": "長く考えていた気がする。",
        "message": "感觉自己想了很久。",
        "text_idx": [
            1084
        ]
    },
    {
        "name": "蘭",
        "name_idx": 1104,
        "ori": "「小松原くん……」",
        "message": "「小松原同学……」",
        "text_idx": [
            1113
        ]
    },
    {
        "ori": "穂高が泣き出しそうな顔で答えを問うてきた。",
        "message": "穗高一脸泫然欲泣地向我询问答案。",
        "text_idx": [
            1128
        ]
    },
    {
        "ori": "どうしよう。",
        "message": "我该怎么办。",
        "text_idx": [
            1143
        ]
    },
    {
        "ori": "この気持ちに応えてあげたい。",
        "message": "我想回应她的这份心意。",
        "text_idx": [
            1158
        ]
    },
    {
        "ori": "脳裏にどうしても此ノ花さんがチラついた。",
        "message": "但脑海中无论如何都会浮现出此之花同学的身影。",
        "text_idx": [
            1173
        ]
    },
    {
        "name": "亮",
        "name_idx": 1179,
        "ori": "「ハッキリとＯＫ出来るわけじゃないんだけど……」",
        "message": "「我也没法给你一个明确的答复……」",
        "text_idx": [
            1188
        ]
    },
    {
        "ori": "迷った末に口から出たのは、そんな曖昧な言葉だった。",
        "message": "犹豫再三，我最终说出口的，是如此暧昧不清的话语。",
        "text_idx": [
            1203
        ]
    },
    {
        "name": "亮",
        "name_idx": 1209,
        "ori": "「真剣にそれを考えるために付き合うっていう、試験期間を作らせてくれないかな？」",
        "message": "「为了能认真地考虑这件事，我们先试着交往……能不能给我一个这样的试验期呢？」",
        "text_idx": [
            1218,
            1219
        ]
    },
    {
        "ori": "自分に嫌悪してしまう。",
        "message": "我对自己产生了嫌恶之情。",
        "text_idx": [
            1234
        ]
    },
    {
        "ori": "決断できない情けない自分に。",
        "message": "对这个无法下定决心的、没用的自己。",
        "text_idx": [
            1249
        ]
    },
    {
        "ori": "けれども、そんな中途半端で曖昧な言葉に、穂高はぽとりぽとりと涙を流していた。",
        "message": "然而，听到我这半吊子又暧昧不清的话，穗高却扑簌扑簌地掉下了眼泪。",
        "text_idx": [
            1988,
            1989
        ]
    },
    {
        "name": "亮",
        "name_idx": 1995,
        "ori": "「穂高」",
        "message": "「穗高」",
        "text_idx": [
            2004
        ]
    },
    {
        "name": "蘭",
        "name_idx": 2024,
        "ori": "「頑張るよ……！」",
        "message": "「我会努力的……！」",
        "text_idx": [
            2033
        ]
    },
    {
        "ori": "潤んだ瞳からさらにしずくが零れ落ちた。",
        "message": "泪珠从她湿润的眼眸中再次滑落。",
        "text_idx": [
            2224
        ]
    },
    {
        "name": "蘭",
        "name_idx": 2244,
        "ori": "「ボク、頑張るよ！」",
        "message": "「我，会努力的！」",
        "text_idx": [
            2253
        ]
    },
    {
        "name": "蘭",
        "name_idx": 2449,
        "ori": "「ボク、小松原くんに本気で好きって言ってもらえるように努力するから！」",
        "message": "「我，会努力让小松原同学能真心实意地对我说喜欢！」",
        "text_idx": [
            2458,
            2459
        ]
    },
    {
        "name": "亮",
        "name_idx": 2641,
        "ori": "「ごめんな……」",
        "message": "「对不起啊……」",
        "text_idx": [
            2650
        ]
    },
    {
        "name": "蘭",
        "name_idx": 2670,
        "ori": "「どうして謝るの？」",
        "message": "「为什么要道歉？」",
        "text_idx": [
            2679
        ]
    },
    {
        "name": "亮",
        "name_idx": 2861,
        "ori": "「こんな中途半端な答えしか出せなくて」",
        "message": "「因为我只能给出这么半吊子的答复」",
        "text_idx": [
            2870
        ]
    },
    {
        "name": "蘭",
        "name_idx": 2890,
        "ori": "「ううん。ボクにとったら嬉しい答えだよ」",
        "message": "「不是的。对我来说，这可是个令人开心的答复哦」",
        "text_idx": [
            2899
        ]
    },
    {
        "name": "亮",
        "name_idx": 3021,
        "ori": "「穂高……」",
        "message": "「穗高……」",
        "text_idx": [
            3030
        ]
    },
    {
        "ori": "冷たい夜風が撫でていく。",
        "message": "冰冷的夜风拂过。",
        "text_idx": [
            3045
        ]
    },
    {
        "ori": "けれど、心は温かくて寒くは感じなかった。",
        "message": "然而，我的内心却很温暖，感觉不到寒冷。",
        "text_idx": [
            3060
        ]
    },
    {
        "name": "蘭",
        "name_idx": 3180,
        "ori": "「ボク頑張るから」",
        "message": "「我会加油的」",
        "text_idx": [
            3189
        ]
    },
    {
        "ori": "穂高がお願いしますとお辞儀してくる。",
        "message": "穗高说着今后请多指教，向我鞠了一躬。",
        "text_idx": [
            3258
        ]
    },
    {
        "ori": "こちらも慌てて、よろしくお願いしますとお辞儀し返した。",
        "message": "我也连忙，说着请多指教回敬了一躬。",
        "text_idx": [
            3317,
            3318
        ]
    },
    {
        "name": "蘭",
        "name_idx": 3436,
        "ori": "「ふふ……」",
        "message": "「呵呵……」",
        "text_idx": [
            3445
        ]
    },
    {
        "name": "亮",
        "name_idx": 3495,
        "ori": "「はは」",
        "message": "「哈哈」",
        "text_idx": [
            3504
        ]
    },
    {
        "ori": "そして、おかしくなって、お互いに笑い合った。",
        "message": "然后，我们都觉得有些好笑，便相视而笑。",
        "text_idx": [
            3519
        ]
    },
    {
        "ori": "それからしばらく、のんびりと夜の散歩をしながら、穂高のことをいろいろと質問した。",
        "message": "在那之后的一段时间里，我们悠闲地在夜里散步，我向穗高问了许多关于她的事情。",
        "text_idx": [
            4535,
            4536
        ]
    },
    {
        "name": "亮",
        "name_idx": 4542,
        "ori": "「好きな食べ物とかってある？」",
        "message": "「你有什么喜欢吃的吗？」",
        "text_idx": [
            4551
        ]
    },
    {
        "name": "蘭",
        "name_idx": 4571,
        "ori": "「ギョウザとかシューマイとかかな」",
        "message": "「饺子和烧卖之类的吧」",
        "text_idx": [
            4580
        ]
    },
    {
        "ori": "言って穂高はカリカリのギョウザを食べるパントマイムをし始める。",
        "message": "穗高说着，开始表演起吃脆皮饺子的默剧。",
        "text_idx": [
            4693,
            4694
        ]
    },
    {
        "name": "亮",
        "name_idx": 4700,
        "ori": "「いいね。ちょっと食べたくなってきた」",
        "message": "「不错啊。搞得我都有点想吃了」",
        "text_idx": [
            4709
        ]
    },
    {
        "name": "蘭",
        "name_idx": 4827,
        "ori": "「今度一緒に食べに行こうよ。安くて美味しい中華屋さん知ってるんだ」",
        "message": "「下次我们一起去吃吧。我知道一家又便宜又好吃的中餐馆哦」",
        "text_idx": [
            4836,
            4837
        ]
    },
    {
        "name": "亮",
        "name_idx": 4843,
        "ori": "「へぇ、そんな店あるんだ」",
        "message": "「哦，还有那种店啊」",
        "text_idx": [
            4852
        ]
    },
    {
        "name": "蘭",
        "name_idx": 4872,
        "ori": "「結構学校から近いよ。部活終わった後とかにたまに行ったりするんだ」",
        "message": "「离学校还挺近的哦。社团活动结束后我偶尔会去一下」",
        "text_idx": [
            4881,
            4882
        ]
    },
    {
        "name": "亮",
        "name_idx": 4888,
        "ori": "「それじゃあさ、嫌いな食べ物とかってある？」",
        "message": "「那，你有什么讨厌吃的吗？」",
        "text_idx": [
            4897
        ]
    },
    {
        "name": "蘭",
        "name_idx": 5015,
        "ori": "「まんじゅうかな」",
        "message": "「馒头吧」",
        "text_idx": [
            5024
        ]
    },
    {
        "ori": "即答だった。",
        "message": "她秒答了。",
        "text_idx": [
            5039
        ]
    },
    {
        "name": "亮",
        "name_idx": 5045,
        "ori": "「そんなにまんじゅう嫌いなの？」",
        "message": "「你就那么讨厌馒头吗？」",
        "text_idx": [
            5054
        ]
    },
    {
        "name": "蘭",
        "name_idx": 5172,
        "ori": "「あの乾き気味の餡がさ、ダメなんだ……まんじゅうこわい」",
        "message": "「那个干巴巴的馅儿啊，我实在受不了……馒头好可怕」",
        "text_idx": [
            5181,
            5182
        ]
    },
    {
        "name": "亮",
        "name_idx": 5188,
        "ori": "「なんか、有名な落語が頭に……嫌がらせでまんじゅうプレゼントするよ」",
        "message": "「不知怎的，我想起了一段有名的落语……我要故意送你馒头当礼物哦」",
        "text_idx": [
            5197,
            5198
        ]
    },
    {
        "name": "蘭",
        "name_idx": 5316,
        "ori": "「ボク本気で逃げるよ」",
        "message": "「我真的会逃跑的哦」",
        "text_idx": [
            5325
        ]
    },
    {
        "ori": "目が本気で怯えていた。",
        "message": "她的眼神是真的在害怕。",
        "text_idx": [
            5340
        ]
    },
    {
        "ori": "それが面白くて、笑ってしまう。",
        "message": "我觉得她的反应很有趣，不禁笑了出来。",
        "text_idx": [
            5355
        ]
    },
    {
        "name": "亮",
        "name_idx": 5781,
        "ori": "「んーじゃあ趣味とかってある？　演劇以外で」",
        "message": "「嗯—那，你有什么爱好吗？　演戏之外的」",
        "text_idx": [
            5790
        ]
    },
    {
        "name": "蘭",
        "name_idx": 5810,
        "ori": "「んー体鍛えることかなぁ」",
        "message": "「嗯—应该是锻炼身体吧」",
        "text_idx": [
            5819
        ]
    },
    {
        "name": "亮",
        "name_idx": 5825,
        "ori": "「男の子っぽいキャラの常套句きた」",
        "message": "「男孩子气角色的经典台词来了」",
        "text_idx": [
            5834
        ]
    },
    {
        "name": "蘭",
        "name_idx": 5952,
        "ori": "「ううー……何か女の子っぽい趣味見つけようかな……」",
        "message": "「呜呜—……我是不是该找个有点女孩子气的爱好呢……」",
        "text_idx": [
            5961
        ]
    },
    {
        "name": "亮",
        "name_idx": 5967,
        "ori": "「まあ無理に見つけなくていいんじゃない。穂高らしくていいよ」",
        "message": "「嘛，没必要硬去找吧。很有穗高你的风格，我觉得挺好的哦」",
        "text_idx": [
            5976,
            5977
        ]
    },
    {
        "name": "蘭",
        "name_idx": 6095,
        "ori": "「そうかな？」",
        "message": "「是吗？」",
        "text_idx": [
            6104
        ]
    },
    {
        "name": "亮",
        "name_idx": 6110,
        "ori": "「うん」",
        "message": "「嗯」",
        "text_idx": [
            6119
        ]
    },
    {
        "name": "蘭",
        "name_idx": 6237,
        "ori": "「じゃあ、ボク、頑張って体鍛えるね！」",
        "message": "「那，我，会努力锻炼身体的！」",
        "text_idx": [
            6246
        ]
    },
    {
        "name": "亮",
        "name_idx": 6252,
        "ori": "「ただアマゾネスみたいになるのは勘弁な」",
        "message": "「不过可千万别练成亚马逊女战士啊」",
        "text_idx": [
            6261
        ]
    },
    {
        "name": "蘭",
        "name_idx": 6379,
        "ori": "「はは、さすがにそこまでは……」",
        "message": "「哈哈，还不至于到那种地步……」",
        "text_idx": [
            6388
        ]
    },
    {
        "ori": "笑い合いながら、今度は蘭の方から質問してきたりして歩いていると、ふと、一番聞きたかった事を思い出した。",
        "message": "我们相视而笑，这次换兰向我提问，就这么边走边聊，我忽然想起了最想问的一件事。",
        "text_idx": [
            6403,
            6404
        ]
    },
    {
        "name": "亮",
        "name_idx": 6410,
        "ori": "「そういえばさ」",
        "message": "「说起来啊」",
        "text_idx": [
            6419
        ]
    },
    {
        "name": "蘭",
        "name_idx": 6537,
        "ori": "「なに？」",
        "message": "「什么？」",
        "text_idx": [
            6546
        ]
    },
    {
        "name": "亮",
        "name_idx": 6552,
        "ori": "「穂高って、自分のことボクって呼んでるじゃない？」",
        "message": "「穗高不是一直管自己叫‘我’吗？」",
        "text_idx": [
            6561
        ]
    },
    {
        "name": "蘭",
        "name_idx": 6581,
        "ori": "「うん」",
        "message": "「嗯」",
        "text_idx": [
            6590
        ]
    },
    {
        "name": "亮",
        "name_idx": 6596,
        "ori": "「どうしてかなって疑問に思ってたんだ。此ノ花さんもボクって使ってるけど、珍しいよね」",
        "message": "「我一直觉得挺奇怪的。此之花小姐也用‘我’，可真少见啊」",
        "text_idx": [
            6605,
            6606
        ]
    },
    {
        "name": "蘭",
        "name_idx": 6724,
        "ori": "「あー、えっとね……」",
        "message": "「啊—，那个嘛……」",
        "text_idx": [
            6733
        ]
    },
    {
        "ori": "穂高は恥ずかしそうに頭を掻きながら言ってきた。",
        "message": "穗高不好意思地挠着头说道。",
        "text_idx": [
            6748
        ]
    },
    {
        "name": "蘭",
        "name_idx": 6866,
        "ori": "「ボク、昔から円に憧れててね……やることなすこと全部円を真似していた時期があったんだ」",
        "message": "「我啊，从以前开始就很崇拜圆……曾经有一段时间，无论做什么事我都会模仿圆」",
        "text_idx": [
            6875,
            6876
        ]
    },
    {
        "name": "蘭",
        "name_idx": 6896,
        "ori": "「その名残りなんだ。というか、結局真似できたのがボクしかなかったんだよね」",
        "message": "「那是残留的习惯吧。说到底，最后能学会的，也就只有‘我’了」",
        "text_idx": [
            6905,
            6906
        ]
    },
    {
        "ori": "穂高の横顔は、どこか懐かしそうに微笑んでいた。",
        "message": "穗高的侧脸，正带着一丝怀念的微笑。",
        "text_idx": [
            6921
        ]
    },
    {
        "name": "亮",
        "name_idx": 7347,
        "ori": "「他の呼び方使ってみない？」",
        "message": "「要不要试试别的自称？」",
        "text_idx": [
            7356
        ]
    },
    {
        "name": "蘭",
        "name_idx": 7518,
        "ori": "「今さら直せないよ」",
        "message": "「事到如今改不掉了啦」",
        "text_idx": [
            7527
        ]
    },
    {
        "name": "亮",
        "name_idx": 7533,
        "ori": "「まあ、試しに使ってみてよ」",
        "message": "「好啦，你就试着用用看嘛」",
        "text_idx": [
            7542
        ]
    },
    {
        "name": "蘭",
        "name_idx": 7562,
        "ori": "「たっ、試しに？」",
        "message": "「试、试着用用？」",
        "text_idx": [
            7571
        ]
    },
    {
        "name": "亮",
        "name_idx": 7577,
        "ori": "「そうだな……最初は、あたし。セリフは――あたしギョウザが好きなの！」",
        "message": "「没错……一开始是‘我’。台词是——我最喜欢饺子了！」",
        "text_idx": [
            7586,
            7587
        ]
    },
    {
        "name": "蘭",
        "name_idx": 7749,
        "ori": "「えぇ、まぁ、うん」",
        "message": "「呃，嘛，嗯」",
        "text_idx": [
            7758
        ]
    },
    {
        "name": "蘭",
        "name_idx": 7920,
        "ori": "「……あたしギョウザが好きなの！」",
        "message": "「……我喜欢吃饺子！」",
        "text_idx": [
            7929
        ]
    },
    {
        "name": "亮",
        "name_idx": 7935,
        "ori": "「んー５０点かな」",
        "message": "「嗯—50分吧」",
        "text_idx": [
            7944
        ]
    },
    {
        "name": "蘭",
        "name_idx": 8106,
        "ori": "「なに基準！？」",
        "message": "「标准是什么啊！？」",
        "text_idx": [
            8115
        ]
    },
    {
        "name": "亮",
        "name_idx": 8121,
        "ori": "「まぁ、次は、あたい。はいどうぞ」",
        "message": "「嘛，接下来是‘我’。来，轮到你了」",
        "text_idx": [
            8130
        ]
    },
    {
        "name": "蘭",
        "name_idx": 8292,
        "ori": "「う、うん」",
        "message": "「嗯、嗯」",
        "text_idx": [
            8301
        ]
    },
    {
        "name": "蘭",
        "name_idx": 8463,
        "ori": "「……あたいギョウザが好きなの！」",
        "message": "「……我喜欢吃饺子！」",
        "text_idx": [
            8472
        ]
    },
    {
        "name": "亮",
        "name_idx": 8478,
        "ori": "「まあ、５５点ぐらいかな」",
        "message": "「嘛，大概55分吧」",
        "text_idx": [
            8487
        ]
    },
    {
        "name": "蘭",
        "name_idx": 8649,
        "ori": "「シビアだね」",
        "message": "「真严格啊」",
        "text_idx": [
            8658
        ]
    },
    {
        "name": "亮",
        "name_idx": 8664,
        "ori": "「んじゃ、次、わたくし。はいどうぞ」",
        "message": "「那接下来是‘我’。来，轮到你了」",
        "text_idx": [
            8673
        ]
    },
    {
        "name": "蘭",
        "name_idx": 8835,
        "ori": "「……わたくしギョウザが好きなの！」",
        "message": "「……人家喜欢吃饺子啦！」",
        "text_idx": [
            8844
        ]
    },
    {
        "name": "亮",
        "name_idx": 8850,
        "ori": "「あぁ、ギョウザが足を引っ張った……４０点」",
        "message": "「啊，是饺子拖了后腿……40分」",
        "text_idx": [
            8859
        ]
    },
    {
        "name": "蘭",
        "name_idx": 9021,
        "ori": "「もう呼び方関係ないよね！」",
        "message": "「这已经和自称没关系了吧！」",
        "text_idx": [
            9030
        ]
    },
    {
        "name": "亮",
        "name_idx": 9036,
        "ori": "「それじゃ、次、おいどん」",
        "message": "「那么，下一个，洒家」",
        "text_idx": [
            9045
        ]
    },
    {
        "name": "蘭",
        "name_idx": 9207,
        "ori": "「それはあまり聞かないなぁ。どんな人が使うの？」",
        "message": "「这个不怎么常听到啊。是什么样的人用的？」",
        "text_idx": [
            9216
        ]
    },
    {
        "name": "亮",
        "name_idx": 9222,
        "ori": "「まあいいから」",
        "message": "「好啦，别管了」",
        "text_idx": [
            9231
        ]
    },
    {
        "name": "蘭",
        "name_idx": 9393,
        "ori": "「……おいどんギョウザが好きなの！」",
        "message": "「……洒家喜欢吃饺子啦！」",
        "text_idx": [
            9402
        ]
    },
    {
        "name": "亮",
        "name_idx": 9408,
        "ori": "「意外に普通だったな。４７点」",
        "message": "「意外地还挺普通的嘛。47分」",
        "text_idx": [
            9417
        ]
    },
    {
        "name": "蘭",
        "name_idx": 9857,
        "ori": "「もう、ボクでいいよ」",
        "message": "「真是的，用「仆」就可以了啦」",
        "text_idx": [
            9866
        ]
    },
    {
        "name": "亮",
        "name_idx": 9872,
        "ori": "「じゃあ、最後に、私。言ってみて」",
        "message": "「那么，最后一个，「我」。你说说看」",
        "text_idx": [
            9881
        ]
    },
    {
        "name": "蘭",
        "name_idx": 10043,
        "ori": "「うん……」",
        "message": "「嗯……」",
        "text_idx": [
            10052
        ]
    },
    {
        "name": "蘭",
        "name_idx": 10072,
        "ori": "「私ギョウザが好きなの！」",
        "message": "「我喜欢吃饺子！」",
        "text_idx": [
            10081
        ]
    },
    {
        "name": "亮",
        "name_idx": 10087,
        "ori": "「おっとまさかの、８９点」",
        "message": "「哦，没想到啊，89分」",
        "text_idx": [
            10096
        ]
    },
    {
        "name": "蘭",
        "name_idx": 10258,
        "ori": "「激しく基準が知りたいよ」",
        "message": "「我超想知道评分标准的」",
        "text_idx": [
            10267
        ]
    },
    {
        "name": "亮",
        "name_idx": 10273,
        "ori": "「でも、似合うよ」",
        "message": "「不过，很适合你哦」",
        "text_idx": [
            10282
        ]
    },
    {
        "name": "蘭",
        "name_idx": 10444,
        "ori": "「そ、そうかな……」",
        "message": "「是、是吗……」",
        "text_idx": [
            10453
        ]
    },
    {
        "name": "亮",
        "name_idx": 10459,
        "ori": "「使えばいいのに」",
        "message": "「明明用这个就好了」",
        "text_idx": [
            10468
        ]
    },
    {
        "name": "蘭",
        "name_idx": 10488,
        "ori": "「う、うん……でも、使い慣れちゃったし、それに円との友情の証みたいなものだから」",
        "message": "「唔、嗯……但是，我已经用习惯了，而且那也算是我和圆友情的证明」",
        "text_idx": [
            10497,
            10498
        ]
    },
    {
        "ori": "穂高は申し訳なさそうな顔をした。",
        "message": "穗高露出了歉疚的表情。",
        "text_idx": [
            10513
        ]
    },
    {
        "name": "亮",
        "name_idx": 10519,
        "ori": "「まあ、それじゃ仕方ないよね」",
        "message": "「嘛，那也没办法呢」",
        "text_idx": [
            10528
        ]
    },
    {
        "name": "蘭",
        "name_idx": 10548,
        "ori": "「ごめん……」",
        "message": "「对不起……」",
        "text_idx": [
            10557
        ]
    },
    {
        "name": "亮",
        "name_idx": 10563,
        "ori": "「謝らなくていいのに。俺もイメチェンで呼び方変えようかな」",
        "message": "「不用道歉啦。我也为了改变形象，换个自称吧」",
        "text_idx": [
            10572,
            10573
        ]
    },
    {
        "name": "蘭",
        "name_idx": 10735,
        "ori": "「何にするの？」",
        "message": "「换成什么？」",
        "text_idx": [
            10744
        ]
    },
    {
        "name": "亮",
        "name_idx": 10750,
        "ori": "「おいどん、とか」",
        "message": "「比如，咱家」",
        "text_idx": [
            10759
        ]
    },
    {
        "name": "蘭",
        "name_idx": 10921,
        "ori": "「……うん。小松原くんなら似合うと思うよ」",
        "message": "「……嗯。我觉得很适合小松原同学哦」",
        "text_idx": [
            10930
        ]
    },
    {
        "name": "亮",
        "name_idx": 10936,
        "ori": "「そんな笑顔で言われたら、逆にショックだわ」",
        "message": "「你这么笑着说，我反而觉得很受打击啊」",
        "text_idx": [
            10945
        ]
    },
    {
        "ori": "ぐるっと一周して戻ってくる。",
        "message": "我转了一圈又回来了。",
        "text_idx": [
            11054
        ]
    },
    {
        "ori": "笑い合い雑談してたら、あっという間だった。",
        "message": "我们有说有笑地闲聊着，时间一转眼就过去了。",
        "text_idx": [
            11069
        ]
    },
    {
        "name": "蘭",
        "name_idx": 11177,
        "ori": "「それじゃ、ボクはもうそろそろ、帰るよ」",
        "message": "「那么，我差不多该回去了哦」",
        "text_idx": [
            11186
        ]
    },
    {
        "name": "亮",
        "name_idx": 11192,
        "ori": "「そう？」",
        "message": "「是吗？」",
        "text_idx": [
            11201
        ]
    },
    {
        "name": "蘭",
        "name_idx": 11265,
        "ori": "「遅くなると寮に入れなくなっちゃうから」",
        "message": "「因为太晚的话就进不去宿舍了」",
        "text_idx": [
            11274
        ]
    },
    {
        "name": "亮",
        "name_idx": 11280,
        "ori": "「うん。気を付けてね」",
        "message": "「嗯。路上小心」",
        "text_idx": [
            11289
        ]
    },
    {
        "name": "蘭",
        "name_idx": 11353,
        "ori": "「ありがとう」",
        "message": "「谢谢你」",
        "text_idx": [
            11362
        ]
    },
    {
        "ori": "穂高は、頬を染めてニッコリ笑ってきた。",
        "message": "穗高红着脸，对我嫣然一笑。",
        "text_idx": [
            11377
        ]
    },
    {
        "name": "蘭",
        "name_idx": 11441,
        "ori": "「小松原くん、また明日」",
        "message": "「小松原同学，明天见」",
        "text_idx": [
            11450
        ]
    },
    {
        "name": "亮",
        "name_idx": 11456,
        "ori": "「お、おう」",
        "message": "「哦、哦」",
        "text_idx": [
            11465
        ]
    },
    {
        "ori": "少しだけ胸が高鳴った。",
        "message": "我的胸口，传来一丝悸动。",
        "text_idx": [
            11480
        ]
    },
    {
        "name": "亮",
        "name_idx": 11486,
        "ori": "「また明日」",
        "message": "「明天见」",
        "text_idx": [
            11495
        ]
    },
    {
        "name": "蘭",
        "name_idx": 11559,
        "ori": "「じゃあね」",
        "message": "「再见啦」",
        "text_idx": [
            11568
        ]
    },
    {
        "ori": "帰って行く穂高の後ろ姿を見送る。",
        "message": "我目送着穗高离去的背影。",
        "text_idx": [
            11821
        ]
    },
    {
        "ori": "穂高は何度も振り返って手を振ってくるので、苦笑いしながら手を振り返した。",
        "message": "穗高频频回头朝我挥手，我也苦笑着挥手回应。",
        "text_idx": [
            11890,
            11891
        ]
    },
    {
        "ori": "それは穂高の姿が見えなくなるまで続いた。",
        "message": "这一幕一直持续到穗高的身影消失不见为止。",
        "text_idx": [
            11944
        ]
    },
    {
        "ori": "後に残るのは、温かい余韻で……",
        "message": "留下的，是温暖的余韵……",
        "text_idx": [
            11959
        ]
    },
    {
        "ori": "なぜだろう。",
        "message": "这是为什么呢。",
        "text_idx": [
            11974
        ]
    },
    {
        "ori": "穂高と一緒なら此ノ花さんを救える気がした。",
        "message": "我有一种感觉，只要和穗高在一起，就能够救下此之花小姐。",
        "text_idx": [
            11989
        ]
    }
]