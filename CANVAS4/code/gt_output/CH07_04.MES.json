[
    {
        "ori": "夜になって冷えてきた……。が……夜空には多くの星が輝いていた。",
        "message": "到了晚上，天变冷了……。但是……夜空中却闪耀着许多星星。",
        "text_idx": [
            46,
            47
        ]
    },
    {
        "ori": "俺たちは手を繋いで、帰り道を歩いていた。",
        "message": "我们手牵着手，走在回家的路上。",
        "text_idx": [
            62
        ]
    },
    {
        "ori": "空を見上げる、みつばからは、先ほどの落ち込みは、感じられなかった。",
        "message": "从抬头仰望天空的三叶身上，已经感觉不到刚才的失落了。",
        "text_idx": [
            77,
            78
        ]
    },
    {
        "name": "みつば",
        "name_idx": 295,
        "ori": "「あれ、アンドロメダ座……」",
        "message": "「那个是，仙女座……」",
        "text_idx": [
            304
        ]
    },
    {
        "ori": "その声に俺と仁瀬さんは、同時に、みつばちゃんの指さしている、天頂を見上げた。",
        "message": "听到她的声音，我和仁濑同学同时抬头望向了三叶所指的天顶。",
        "text_idx": [
            319,
            320
        ]
    },
    {
        "name": "亮",
        "name_idx": 326,
        "ori": "「さすが……くわしいね、みつばちゃん」",
        "message": "「真厉害啊……懂的真多呢，三叶」",
        "text_idx": [
            335
        ]
    },
    {
        "name": "みつば",
        "name_idx": 399,
        "ori": "「……あれは、木星」",
        "message": "「……那个是，木星」",
        "text_idx": [
            408
        ]
    },
    {
        "ori": "今度は南の方の空を指さした。",
        "message": "这次她指向了南方的天空。",
        "text_idx": [
            423
        ]
    },
    {
        "name": "みつば",
        "name_idx": 487,
        "ori": "「あの近くに、見えないけれど、天王星もあるはずデス」",
        "message": "「在那附近，虽然看不见，但应该也有天王星」",
        "text_idx": [
            496
        ]
    },
    {
        "name": "亮",
        "name_idx": 502,
        "ori": "「へぇ、天王星……」",
        "message": "「哦，天王星啊……」",
        "text_idx": [
            511
        ]
    },
    {
        "name": "みつば",
        "name_idx": 575,
        "ori": "「本で読んだだけデス……」",
        "message": "「我只是在书上读到过而已……」",
        "text_idx": [
            584
        ]
    },
    {
        "name": "さつき",
        "name_idx": 648,
        "ori": "「みつばは、読書家だものね」",
        "message": "「三叶很喜欢读书呢」",
        "text_idx": [
            657
        ]
    },
    {
        "ori": "みつば、首をコクコクと振っている。",
        "message": "三叶连连点头。",
        "text_idx": [
            770
        ]
    },
    {
        "ori": "プラネタリウムよろしく、みつばの解説はつづく。",
        "message": "就像在天文馆里一样，三叶的解说还在继续。",
        "text_idx": [
            873
        ]
    },
    {
        "name": "さつき",
        "name_idx": 937,
        "ori": "「小松原君……ありがとう……」",
        "message": "「小松原君……谢谢你……」",
        "text_idx": [
            946
        ]
    },
    {
        "ori": "不意に、つぶやくように仁瀬さんが言った。",
        "message": "仁濑同学突然低声说道。",
        "text_idx": [
            961
        ]
    },
    {
        "name": "亮",
        "name_idx": 967,
        "ori": "「ん……？　なにがさ？」",
        "message": "「嗯……？　谢什么？」",
        "text_idx": [
            976
        ]
    },
    {
        "name": "さつき",
        "name_idx": 1040,
        "ori": "「みつばのこと……」",
        "message": "「三叶的事……」",
        "text_idx": [
            1049
        ]
    },
    {
        "name": "亮",
        "name_idx": 1055,
        "ori": "「俺は、俺に出来ることしかしてないさ、それに……俺はお返しがしたいだけなんだ……」",
        "message": "「我只是做了我力所能及的事而已，而且……我只是想报答你们罢了……」",
        "text_idx": [
            1064,
            1065
        ]
    },
    {
        "name": "さつき",
        "name_idx": 1129,
        "ori": "「おかえし……？」",
        "message": "「报答……？」",
        "text_idx": [
            1138
        ]
    },
    {
        "name": "亮",
        "name_idx": 1144,
        "ori": "「うん、……あの時……母親に会うことをためらっていた俺に、勇気をくれたのは、みつばちゃんと、仁瀬さんだからね」",
        "message": "「嗯，……因为那个时候……在我犹豫着要不要去见母亲时，是三叶和仁濑同学给了我勇气」",
        "text_idx": [
            1153,
            1154,
            1155
        ]
    },
    {
        "ori": "仁瀬さんは、微笑んだ。",
        "message": "仁濑同学微笑了。",
        "text_idx": [
            1214
        ]
    },
    {
        "name": "さつき",
        "name_idx": 1278,
        "ori": "「……わたしも、頑張らなければ、ね」",
        "message": "「……我也得努力了呢」",
        "text_idx": [
            1287
        ]
    },
    {
        "name": "亮",
        "name_idx": 1293,
        "ori": "「あぁ、仁瀬さんなら、大丈夫……素直に絵に向かい合えば、たどり着けるよ……」",
        "message": "「啊，仁濑同学的话，没问题的……只要坦诚地面对绘画，就一定能达到目标的……」",
        "text_idx": [
            1302,
            1303
        ]
    },
    {
        "name": "さつき",
        "name_idx": 1421,
        "ori": "「うん……」",
        "message": "「嗯……」",
        "text_idx": [
            1430
        ]
    },
    {
        "name": "みつば",
        "name_idx": 1503,
        "ori": "「みつばの解説……聞いてましたか！？」",
        "message": "「三叶的解说……你们有在听吗！？」",
        "text_idx": [
            1512
        ]
    },
    {
        "name": "亮",
        "name_idx": 1518,
        "ori": "「え……っ！？　ごめん……ちょっと……」",
        "message": "「诶……！？　抱歉……我刚才有点……」",
        "text_idx": [
            1527
        ]
    },
    {
        "ori": "俺が仁瀬さんと話していたのが、みつばは、少し気にくわなかったのだろうか？",
        "message": "我和仁濑同学说话这件事，是不是让三叶有点不高兴了呢？",
        "text_idx": [
            1542,
            1543
        ]
    },
    {
        "name": "さつき",
        "name_idx": 1763,
        "ori": "「みつば……小松原君……」",
        "message": "「三叶……小松原君……」",
        "text_idx": [
            1772
        ]
    },
    {
        "ori": "仁瀬さんは、俺の手を離して、俺たちの後ろ側に回ると、俺とみつばの腕をとり、くっつかせる様に歩かせた。",
        "message": "仁濑同学松开了我的手，绕到我们身后，然后抓住我和三叶的手臂，让我们紧挨着走在一起。",
        "text_idx": [
            2031,
            2032
        ]
    },
    {
        "name": "さつき",
        "name_idx": 2173,
        "ori": "「喧嘩するなら、仲良く二人でやってね！うふふふふ……っ！」",
        "message": "「要吵架的话，就你们俩好好地吵吧！唔呵呵呵呵……！」",
        "text_idx": [
            2182,
            2183
        ]
    },
    {
        "name": "みつば",
        "name_idx": 2247,
        "ori": "「お、おねえちゃん……！」",
        "message": "「姐、姐姐……！」",
        "text_idx": [
            2256
        ]
    },
    {
        "ori": "みつばは真っ赤になって……でも、俺の腕に寄り添って歩いていた。",
        "message": "三叶满脸通红……但还是紧紧挨着我的手臂一起走着。",
        "text_idx": [
            2315,
            2316
        ]
    }
]