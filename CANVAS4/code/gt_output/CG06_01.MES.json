[
    {
        "name": "円",
        "name_idx": 149,
        "ori": "「やっほー、おひさー！」",
        "message": "「呀吼—，好久不见—！」",
        "text_idx": [
            158
        ]
    },
    {
        "name": "亮",
        "name_idx": 173,
        "ori": "「よう！」",
        "message": "「哟！」",
        "text_idx": [
            182
        ]
    },
    {
        "name": "蘭",
        "name_idx": 290,
        "ori": "「円、ひさしぶり！」",
        "message": "「圆，好久不见！」",
        "text_idx": [
            299
        ]
    },
    {
        "name": "円",
        "name_idx": 319,
        "ori": "「久しぶりー！　蘭の誕生日以来だね」",
        "message": "「好久不见—！　自从兰的生日以来就没见过了呢」",
        "text_idx": [
            328
        ]
    },
    {
        "name": "亮",
        "name_idx": 334,
        "ori": "「ああ、そうなるか。あの日は、サイコーだったな」",
        "message": "「啊，这么说也是。那天可真是太棒了」",
        "text_idx": [
            343
        ]
    },
    {
        "name": "蘭",
        "name_idx": 407,
        "ori": "「鷺ノ宮先輩のプレゼントがまだまだ使い切れないよ」",
        "message": "「鹭之宫前辈送的礼物我到现在都还没用完呢」",
        "text_idx": [
            416
        ]
    },
    {
        "name": "円",
        "name_idx": 480,
        "ori": "「ヘリで運んできたくらいだからねー」",
        "message": "「毕竟人家可是用直升机运过来的呢—」",
        "text_idx": [
            489
        ]
    },
    {
        "name": "亮",
        "name_idx": 495,
        "ori": "「智継なんて、モノよりも心だって言って、あそこまで体張ってたしな」",
        "message": "「智继那家伙，说什么心意比礼物更重要，自己还不是拼命到那种程度嘛」",
        "text_idx": [
            504,
            505
        ]
    },
    {
        "name": "円",
        "name_idx": 569,
        "ori": "「笑ったよねー。あれはやり過ぎだって」",
        "message": "「真是笑死人了。那也太夸张了」",
        "text_idx": [
            578
        ]
    },
    {
        "name": "蘭",
        "name_idx": 642,
        "ori": "「椎名くん、あれから新学期始まっても、しばらく死んでたんだよ」",
        "message": "「椎名同学，那之后就算新学期开始了，也有段时间跟死了一样哦」",
        "text_idx": [
            651,
            652
        ]
    },
    {
        "name": "円",
        "name_idx": 716,
        "ori": "「ホントに！？　智継くんらしいねー」",
        "message": "「真的假的！？　真有智继同学的风格呢—」",
        "text_idx": [
            725
        ]
    },
    {
        "name": "蘭",
        "name_idx": 789,
        "ori": "「円からのプレゼントも大事に持ってるよ」",
        "message": "「圆送的礼物我也有好好珍藏着哦」",
        "text_idx": [
            798
        ]
    },
    {
        "name": "円",
        "name_idx": 862,
        "ori": "「蘭……」",
        "message": "「兰……」",
        "text_idx": [
            871
        ]
    },
    {
        "name": "円",
        "name_idx": 935,
        "ori": "「ふふふっ、大事にしてくれて有り難う」",
        "message": "「呵呵呵，谢谢你这么珍惜它」",
        "text_idx": [
            944
        ]
    },
    {
        "name": "亮",
        "name_idx": 950,
        "ori": "「さてっ。ここでダベッてるのも楽しいけど、そろそろ行こうぜ、目的地」",
        "message": "「好了。在这里闲聊虽然也挺开心的，不过也差不多该去目的地了」",
        "text_idx": [
            959,
            960
        ]
    },
    {
        "name": "亮",
        "name_idx": 966,
        "ori": "「早く、二人に見せたいんだ」",
        "message": "「我想快点让你们俩看看」",
        "text_idx": [
            975
        ]
    },
    {
        "name": "円＆蘭",
        "name_idx": 1191,
        "ori": "「うんっ！！」",
        "message": "「嗯！！」",
        "text_idx": [
            1200
        ]
    },
    {
        "name": "円",
        "name_idx": 1719,
        "ori": "「あれ、亮少し背伸びた？」",
        "message": "「咦，亮是不是长高了点？」",
        "text_idx": [
            1728
        ]
    },
    {
        "name": "亮",
        "name_idx": 1734,
        "ori": "「んー、蘭、俺伸びたか？」",
        "message": "「嗯—，兰，我长高了吗？」",
        "text_idx": [
            1743
        ]
    },
    {
        "name": "蘭",
        "name_idx": 1905,
        "ori": "「伸びたのかなぁ」",
        "message": "「是不是长高了呢」",
        "text_idx": [
            1914
        ]
    },
    {
        "ori": "顔を見合わせて首を傾げ合う。",
        "message": "我和兰面面相觑，都歪着头。",
        "text_idx": [
            1929
        ]
    },
    {
        "name": "円",
        "name_idx": 1949,
        "ori": "「ボク的には、亮がマッチョになってる事を期待していたんだけどな」",
        "message": "「我倒是还期待着亮变成肌肉男呢」",
        "text_idx": [
            1958,
            1959
        ]
    },
    {
        "name": "亮",
        "name_idx": 1965,
        "ori": "「この数カ月でマッチョになったら、俺が怖いよ」",
        "message": "「要是在这几个月里就变成肌肉男，我自己都觉得可怕」",
        "text_idx": [
            1974
        ]
    },
    {
        "name": "円",
        "name_idx": 2092,
        "ori": "「まあ、二人とも仲が良くて安心したよ」",
        "message": "「嘛，看到你们俩关系还是这么好，我就放心了」",
        "text_idx": [
            2101
        ]
    },
    {
        "name": "亮",
        "name_idx": 2107,
        "ori": "「円も、変わりないようでなにより」",
        "message": "「圆你好像也没什么变化，真是太好了」",
        "text_idx": [
            2116
        ]
    },
    {
        "name": "蘭",
        "name_idx": 2278,
        "ori": "「お母さんとは、どう？」",
        "message": "「和妈妈的关系怎么样了？」",
        "text_idx": [
            2287
        ]
    },
    {
        "name": "円",
        "name_idx": 2405,
        "ori": "「明日一緒に買い物に行くんだ」",
        "message": "「我们明天要一起去购物哦」",
        "text_idx": [
            2414
        ]
    },
    {
        "ori": "嬉しそうに言う円に、俺と蘭は笑い合った。",
        "message": "看着开心地这么说的圆，我和兰相视一笑。",
        "text_idx": [
            2571
        ]
    },
    {
        "name": "亮",
        "name_idx": 2577,
        "ori": "「よかったな」",
        "message": "「太好了」",
        "text_idx": [
            2586
        ]
    },
    {
        "name": "蘭",
        "name_idx": 2606,
        "ori": "「よかったね」",
        "message": "「太好了呢」",
        "text_idx": [
            2615
        ]
    },
    {
        "name": "円",
        "name_idx": 2733,
        "ori": "「春休みの間はここに居る予定だから、遊び回ろうよ」",
        "message": "「春假期间我都会在这里，我们到处去玩吧」",
        "text_idx": [
            2742
        ]
    },
    {
        "name": "亮",
        "name_idx": 2748,
        "ori": "「お、いいね」",
        "message": "「哦，好啊」",
        "text_idx": [
            2757
        ]
    },
    {
        "name": "蘭",
        "name_idx": 2777,
        "ori": "「小松原ファミリーだね」",
        "message": "「是小松原家族了呢」",
        "text_idx": [
            2786
        ]
    },
    {
        "name": "円",
        "name_idx": 2904,
        "ori": "「小松原ファミリーと言ったら、臨海公園のソフトクリームだよね」",
        "message": "「说到小松原家族，那当然就是临海公园的软冰淇淋了嘛」",
        "text_idx": [
            2913,
            2914
        ]
    },
    {
        "name": "亮",
        "name_idx": 2920,
        "ori": "「また行くのか！？」",
        "message": "「你们又要去吗！？」",
        "text_idx": [
            2929
        ]
    },
    {
        "name": "円＆蘭",
        "name_idx": 3189,
        "ori": "「行く！」",
        "message": "「要去！」",
        "text_idx": [
            3198
        ]
    },
    {
        "name": "亮",
        "name_idx": 3204,
        "ori": "「まあいいけど……冬も行ったよなぁ」",
        "message": "「嘛，倒也行……不过冬天不是才去过嘛」",
        "text_idx": [
            3213
        ]
    },
    {
        "name": "亮",
        "name_idx": 3219,
        "ori": "「あの時は、ブルブル震えて大変だった……」",
        "message": "「那时候，你们冻得瑟瑟发抖，可真是够呛……」",
        "text_idx": [
            3228
        ]
    },
    {
        "name": "円",
        "name_idx": 3346,
        "ori": "「あ、そうそう。すっかり言うのが遅くなったけど……」",
        "message": "「啊，对对。差点忘了跟你说了……」",
        "text_idx": [
            3355
        ]
    },
    {
        "name": "円",
        "name_idx": 3473,
        "ori": "「亮、おめでとう」",
        "message": "「亮，恭喜你」",
        "text_idx": [
            3482
        ]
    },
    {
        "name": "亮",
        "name_idx": 3488,
        "ori": "「お、おう。ありがとう」",
        "message": "「哦、噢。谢谢」",
        "text_idx": [
            3497
        ]
    },
    {
        "name": "円",
        "name_idx": 3615,
        "ori": "「桜花展入賞でしょ。やっぱすごいよ」",
        "message": "「是在樱华展上获奖了吧。你果然很厉害」",
        "text_idx": [
            3624
        ]
    },
    {
        "ori": "真顔で感心されると、照れてしまう。",
        "message": "被她这么一本正经地佩服，我反倒有些不好意思了。",
        "text_idx": [
            3639
        ]
    },
    {
        "ori": "円が帰った後に描き始めた絵が、桜花展のコンクールで入選したのだ。",
        "message": "圆回去之后我才开始画的那幅画，在樱华展的竞赛中入选了。",
        "text_idx": [
            3654,
            3655
        ]
    },
    {
        "ori": "今日は、入賞作品の展示会で、円はそれに合わせて来てくれたわけだった。",
        "message": "今天是获奖作品的展览会，圆也是为此而来的。",
        "text_idx": [
            3670,
            3671
        ]
    },
    {
        "name": "円",
        "name_idx": 3789,
        "ori": "「どんな絵描いたの？」",
        "message": "「你画了什么样的画？」",
        "text_idx": [
            3798
        ]
    },
    {
        "name": "蘭",
        "name_idx": 3960,
        "ori": "「ボクも知らないんだ。内緒って教えてくれなくて」",
        "message": "「我也不知道。他说是秘密，不肯告诉我」",
        "text_idx": [
            3969
        ]
    },
    {
        "name": "円",
        "name_idx": 4087,
        "ori": "「ああ、はっは～ん」",
        "message": "「啊啊，啊哈～」",
        "text_idx": [
            4096
        ]
    },
    {
        "ori": "円がニヤニヤ笑った。",
        "message": "圆坏笑了起来。",
        "text_idx": [
            4111
        ]
    },
    {
        "name": "円",
        "name_idx": 4229,
        "ori": "「なるほど」",
        "message": "「原来如此」",
        "text_idx": [
            4238
        ]
    },
    {
        "name": "亮",
        "name_idx": 4244,
        "ori": "「な、なんだよ」",
        "message": "「干、干嘛啊」",
        "text_idx": [
            4253
        ]
    },
    {
        "name": "円",
        "name_idx": 4273,
        "ori": "「なんの絵を描いたかわかったよ」",
        "message": "「我知道你画了什么了」",
        "text_idx": [
            4282
        ]
    },
    {
        "name": "蘭",
        "name_idx": 4302,
        "ori": "「え、なんの絵なの？」",
        "message": "「欸，是什么画啊？」",
        "text_idx": [
            4311
        ]
    },
    {
        "name": "円",
        "name_idx": 4659,
        "ori": "「見てのお楽しみだよね。この幸せ者！」",
        "message": "「看了就知道了嘛。你这个幸福的家伙！」",
        "text_idx": [
            4668
        ]
    },
    {
        "name": "蘭",
        "name_idx": 4786,
        "ori": "「な、なんなの？」",
        "message": "「什、什么啊？」",
        "text_idx": [
            4795
        ]
    },
    {
        "ori": "円がうりうりと蘭を小突くが、蘭はさっぱり分からないといった顔をしていた。",
        "message": "圆一个劲地戳着兰，但兰还是一副完全搞不懂的表情。",
        "text_idx": [
            4810,
            4811
        ]
    },
    {
        "name": "蘭",
        "name_idx": 4973,
        "ori": "「うー気になるな。早く見に行こう！」",
        "message": "「唔—好在意啊。我们快去看吧！」",
        "text_idx": [
            4982
        ]
    },
    {
        "name": "円",
        "name_idx": 5002,
        "ori": "「そうだね。行こうか」",
        "message": "「是啊。我们走吧」",
        "text_idx": [
            5011
        ]
    },
    {
        "name": "亮",
        "name_idx": 5017,
        "ori": "「ああ」",
        "message": "「嗯」",
        "text_idx": [
            5026
        ]
    },
    {
        "name": "円",
        "name_idx": 5237,
        "ori": "「やっぱ人多いね」",
        "message": "「人果然很多呢」",
        "text_idx": [
            5246
        ]
    },
    {
        "ori": "展示会場はちょっとしたお祭り騒ぎだった。",
        "message": "展会会场热闹得就像一个小祭典。",
        "text_idx": [
            5261
        ]
    },
    {
        "name": "蘭",
        "name_idx": 5369,
        "ori": "「小松原亮の絵は、どこかな」",
        "message": "「小松原亮的画，在哪里呢？」",
        "text_idx": [
            5378
        ]
    },
    {
        "name": "亮",
        "name_idx": 5384,
        "ori": "「ああ、ちょっと緊張するな」",
        "message": "「啊，稍微有点紧张啊」",
        "text_idx": [
            5393
        ]
    },
    {
        "name": "円",
        "name_idx": 5457,
        "ori": "「へぇ、緊張するんだ」",
        "message": "「哦，你也会紧张啊」",
        "text_idx": [
            5466
        ]
    },
    {
        "name": "亮",
        "name_idx": 5472,
        "ori": "「そりゃあね」",
        "message": "「那当然了」",
        "text_idx": [
            5481
        ]
    },
    {
        "name": "蘭",
        "name_idx": 5589,
        "ori": "「あ、小松原亮って名前があるよ。あれじゃない？」",
        "message": "「啊，那里有小松原亮这个名字哦。是不是那幅？」",
        "text_idx": [
            5598
        ]
    },
    {
        "ori": "蘭が指差すそこは、ちょっとした人だかりが出来ていた。",
        "message": "兰指着的地方，围了一小群人。",
        "text_idx": [
            5954
        ]
    },
    {
        "name": "蘭",
        "name_idx": 5974,
        "ori": "「んー人が多くて、よく見れないな」",
        "message": "「唔—人好多，看不太清楚啊」",
        "text_idx": [
            5983
        ]
    },
    {
        "name": "円",
        "name_idx": 6242,
        "ori": "「もっと近づこうよ」",
        "message": "「我们再靠近点吧」",
        "text_idx": [
            6251
        ]
    },
    {
        "ori": "人を掻き分けて進んでいく二人の後ろに付いて行く。",
        "message": "我跟在拨开人群前进的两人身后。",
        "text_idx": [
            6383
        ]
    },
    {
        "name": "蘭",
        "name_idx": 6417,
        "ori": "「あ……」",
        "message": "「啊……」",
        "text_idx": [
            6426
        ]
    },
    {
        "ori": "一番前まで辿り付いた蘭は驚いた顔をして、円は感心した顔をしている。",
        "message": "走到最前面的兰露出了惊讶的表情，圆则是一脸佩服的神情。",
        "text_idx": [
            6529,
            6530
        ]
    },
    {
        "ori": "幸せそうで……でも親友の事で悩み、少し影のある微笑みを浮かべた蘭。",
        "message": "看似幸福……但又为挚友之事而烦恼，脸上浮现着一抹略带忧愁的微笑的兰。",
        "text_idx": [
            6726,
            6727
        ]
    },
    {
        "ori": "その蘭が切り取られ、飾られていた。",
        "message": "就是那样的兰，被截取下来，陈列在这里。",
        "text_idx": [
            6742
        ]
    },
    {
        "name": "亮",
        "name_idx": 6748,
        "ori": "「綺麗だったからさ」",
        "message": "「因为你很美啊」",
        "text_idx": [
            6757
        ]
    },
    {
        "name": "蘭",
        "name_idx": 6777,
        "ori": "「……」",
        "message": "「……」",
        "text_idx": [
            6786
        ]
    },
    {
        "name": "亮",
        "name_idx": 6792,
        "ori": "「どうかな？」",
        "message": "「怎么样？」",
        "text_idx": [
            6801
        ]
    },
    {
        "name": "蘭",
        "name_idx": 6821,
        "ori": "「……」",
        "message": "「……」",
        "text_idx": [
            6830
        ]
    },
    {
        "name": "亮",
        "name_idx": 6836,
        "ori": "「蘭……？」",
        "message": "「兰……？」",
        "text_idx": [
            6845
        ]
    },
    {
        "name": "蘭",
        "name_idx": 6865,
        "ori": "「……うれしい」",
        "message": "「……好开心」",
        "text_idx": [
            6874
        ]
    },
    {
        "ori": "蘭の頬をつと涙が伝った。",
        "message": "泪水顺着兰的脸颊滑落。",
        "text_idx": [
            6889
        ]
    },
    {
        "name": "蘭",
        "name_idx": 6909,
        "ori": "「ボク、うれしいよ」",
        "message": "「我，真的好高兴啊」",
        "text_idx": [
            6918
        ]
    },
    {
        "ori": "蘭は涙を流しながらも、絵から目を離さなかった。",
        "message": "兰流着泪，目光却始终没有离开那幅画。",
        "text_idx": [
            6933
        ]
    },
    {
        "name": "亮",
        "name_idx": 6939,
        "ori": "「喜んでくれて良かったよ」",
        "message": "「你能喜欢真是太好了」",
        "text_idx": [
            6948
        ]
    },
    {
        "ori": "胸を撫でおろす。",
        "message": "我松了口气。",
        "text_idx": [
            6963
        ]
    },
    {
        "ori": "それがずっと心配で仕方なかったのだ。",
        "message": "我一直都在为这件事担心不已。",
        "text_idx": [
            6978
        ]
    },
    {
        "name": "円",
        "name_idx": 6998,
        "ori": "「こんなに美しい人物画は初めて見たよ」",
        "message": "「我还是第一次见到这么美的人物画」",
        "text_idx": [
            7007
        ]
    },
    {
        "name": "亮",
        "name_idx": 7013,
        "ori": "「褒めすぎだよ」",
        "message": "「你过奖了」",
        "text_idx": [
            7022
        ]
    },
    {
        "name": "円",
        "name_idx": 7042,
        "ori": "「いや、本当のことだよ」",
        "message": "「不，我说的是实话」",
        "text_idx": [
            7051
        ]
    },
    {
        "ori": "円は蘭の肩をぽんと叩いた。",
        "message": "圆轻轻拍了拍兰的肩膀。",
        "text_idx": [
            7066
        ]
    },
    {
        "name": "円",
        "name_idx": 7086,
        "ori": "「よかったね」",
        "message": "「太好了呢」",
        "text_idx": [
            7095
        ]
    },
    {
        "name": "蘭",
        "name_idx": 7115,
        "ori": "「うん……」",
        "message": "「嗯……」",
        "text_idx": [
            7124
        ]
    },
    {
        "name": "円",
        "name_idx": 7144,
        "ori": "「気が済むまで見てていいから」",
        "message": "「你就看到心满意足为止吧」",
        "text_idx": [
            7153
        ]
    },
    {
        "name": "蘭",
        "name_idx": 7173,
        "ori": "「うん」",
        "message": "「嗯」",
        "text_idx": [
            7182
        ]
    },
    {
        "ori": "時折周りの観覧客が、絵の正面で幸せそうに絵を見つめ続ける、絵のモデル本人の存在に気づき……",
        "message": "偶尔，周围的参观者会注意到，正站在画前幸福地凝视着画作的人，正是画里的模特本人……",
        "text_idx": [
            7197,
            7198
        ]
    },
    {
        "ori": "いぶかしげに……或いはにこやかに、絵の蘭と、蘭本人の顔をこっそり見比べていたりもしたが……",
        "message": "他们或是一脸讶异……或是一脸微笑，偷偷对比着画里的兰和兰本人的脸……",
        "text_idx": [
            7213,
            7214
        ]
    },
    {
        "ori": "当人がそれに気付く気配はなく、絵から目を離すことはなかった。",
        "message": "而兰本人似乎丝毫没有察觉到，她的视线从未从画上移开过。",
        "text_idx": [
            7229,
            7230
        ]
    },
    {
        "ori": "少し照れくさいけど、俺と円も気にしないことにした。",
        "message": "虽然感觉有点不好意思，但我和圆也决定不去在意。",
        "text_idx": [
            7245
        ]
    },
    {
        "ori": "俺と蘭と円。",
        "message": "我、兰和圆。",
        "text_idx": [
            7260
        ]
    },
    {
        "ori": "三人の小松原ファミリーは、飽きるまでその絵を見続けた。",
        "message": "我们小松原家三人，就这样一直看着那幅画，直到心满意足为止。",
        "text_idx": [
            7275,
            7276
        ]
    },
    {
        "ori": "幸せそうで……でも親友の事で悩み、少し影のある微笑みを。",
        "message": "那看似幸福……却又因挚友而烦恼，带着一丝忧愁的微笑。",
        "text_idx": [
            7291,
            7292
        ]
    },
    {
        "ori": "俺たちの友情と愛情と――青春の証を。",
        "message": "我们的友情与爱情——以及青春的证明。",
        "text_idx": [
            7307
        ]
    }
]