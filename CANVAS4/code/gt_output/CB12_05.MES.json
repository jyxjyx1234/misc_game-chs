[
    {
        "ori": "頭の中が、まだジンジンしている……。エッチの後のほてった肌が、冷たい風に心地よい。",
        "message": "脑子里还嗡嗡作响……。H过后火热的肌肤，被冷风吹拂着，感觉很舒服。",
        "text_idx": [
            181,
            182
        ]
    },
    {
        "ori": "帰るというさつきを送って、俺たちは暗い夜道を手を繋いで歩いていた。",
        "message": "我送说要回去的纱月，我们手牵着手走在漆黑的夜路上。",
        "text_idx": [
            197,
            198
        ]
    },
    {
        "name": "亮",
        "name_idx": 204,
        "ori": "「昼間じゃなくて……よかったね」",
        "message": "「幸好……不是在白天呢」",
        "text_idx": [
            213
        ]
    },
    {
        "name": "さつき",
        "name_idx": 277,
        "ori": "「…………うん、そうね、昼だったら……恥ずかしくって……『送る』って言われても、断ってたかも……」",
        "message": "「…………嗯，是啊，要是白天的话……太丢人了……就算你说『我送你』，我也可能会拒绝的吧……」",
        "text_idx": [
            286,
            287
        ]
    },
    {
        "ori": "多分、さつきは……赤面しているだろう……",
        "message": "大概，纱月……正在脸红吧……",
        "text_idx": [
            302
        ]
    },
    {
        "name": "さつき",
        "name_idx": 366,
        "ori": "「私たちは……つながってるね……」",
        "message": "「我们……是紧紧相连的呢……」",
        "text_idx": [
            375
        ]
    },
    {
        "name": "亮",
        "name_idx": 381,
        "ori": "「……さっきみたいに？」",
        "message": "「……像刚才那样？」",
        "text_idx": [
            390
        ]
    },
    {
        "name": "さつき",
        "name_idx": 454,
        "ori": "「馬鹿……っ！」",
        "message": "「笨蛋……！」",
        "text_idx": [
            463
        ]
    },
    {
        "ori": "さつきが俺の肩を叩く。",
        "message": "纱月捶了下我的肩膀。",
        "text_idx": [
            532
        ]
    },
    {
        "name": "さつき",
        "name_idx": 596,
        "ori": "「……こころが、よ」",
        "message": "「……我说的是心啊」",
        "text_idx": [
            605
        ]
    },
    {
        "ori": "街灯のあかりで見えたさつきは、俺の思った通り赤面していた。",
        "message": "在路灯的灯光下，我看到纱月果然如我所料地红着脸。",
        "text_idx": [
            620,
            621
        ]
    },
    {
        "ori": "突然、繋いでいた手をさつきは離した。",
        "message": "突然，纱月松开了我们牵着的手。",
        "text_idx": [
            1016
        ]
    },
    {
        "name": "さつき",
        "name_idx": 1036,
        "ori": "「もう……ここでいいわ」",
        "message": "「就……送到这里吧」",
        "text_idx": [
            1045
        ]
    },
    {
        "name": "亮",
        "name_idx": 1051,
        "ori": "「なんで……？　家まで送るよ」",
        "message": "「为什么……？　我送你到家啊」",
        "text_idx": [
            1060
        ]
    },
    {
        "name": "さつき",
        "name_idx": 1133,
        "ori": "「……だめ、離れづらくなるから……」",
        "message": "「……不行，因为那样会更舍不得分开的……」",
        "text_idx": [
            1142
        ]
    },
    {
        "ori": "恥ずかしそうに、さつきは言う。",
        "message": "纱月害羞地说道。",
        "text_idx": [
            1157
        ]
    },
    {
        "ori": "俺の瞼に、先ほどまでの、さつきの姿態が浮かぶ……確かに……さつきの部屋にでも入ったら、ブリ返して再戦は必至だろう……",
        "message": "我的脑海中浮现出刚才纱月的身姿……确实……要是进了纱月的房间，热情复燃，再战一场是免不了的吧……",
        "text_idx": [
            1172,
            1173,
            1174
        ]
    },
    {
        "name": "亮",
        "name_idx": 1180,
        "ori": "「わかった、じゃ、また来週だね」",
        "message": "「我知道了，那下周再见吧」",
        "text_idx": [
            1189
        ]
    },
    {
        "name": "さつき",
        "name_idx": 1253,
        "ori": "「……うん、わたしもまた……前に進まないと」",
        "message": "「……嗯，我也……必须向前迈进才行」",
        "text_idx": [
            1262
        ]
    },
    {
        "name": "亮",
        "name_idx": 1268,
        "ori": "「そうだね……俺も進まなきゃ……」",
        "message": "「是啊……我也必须向前进……」",
        "text_idx": [
            1277
        ]
    },
    {
        "name": "さつき",
        "name_idx": 1341,
        "ori": "「ふふふふ……っ、亮くんなら大丈夫……」",
        "message": "「呵呵呵……是亮的话，一定没问题的……」",
        "text_idx": [
            1350
        ]
    },
    {
        "name": "亮",
        "name_idx": 1356,
        "ori": "「でもなぁ、ハードルが……」",
        "message": "「可是啊，那个门槛……」",
        "text_idx": [
            1365
        ]
    },
    {
        "name": "さつき",
        "name_idx": 1429,
        "ori": "「前に進む……っ！」",
        "message": "「要向前迈进……！」",
        "text_idx": [
            1438
        ]
    },
    {
        "name": "亮",
        "name_idx": 1444,
        "ori": "「……はい、それじゃ、来週も気合い入れてやるか！」",
        "message": "「……好，那么，下周也要鼓起干劲上！」",
        "text_idx": [
            1453
        ]
    },
    {
        "ori": "さつきは、笑って頷いた。",
        "message": "纱月笑着点了点头。",
        "text_idx": [
            1522
        ]
    },
    {
        "name": "亮",
        "name_idx": 1528,
        "ori": "「じゃぁ、またね」",
        "message": "「那么，再见啦」",
        "text_idx": [
            1537
        ]
    },
    {
        "name": "さつき",
        "name_idx": 1815,
        "ori": "「うん……いってきます」",
        "message": "「嗯……我走了」",
        "text_idx": [
            1824
        ]
    },
    {
        "ori": "そう言って、俺に手を振るさつきの目は……迷いが無い『あの』さつきの目だった。",
        "message": "纱月这么说着，对我挥了挥手，她的眼神……是毫无迷惘的、『那个』纱月的眼神。",
        "text_idx": [
            1839,
            1840
        ]
    }
]