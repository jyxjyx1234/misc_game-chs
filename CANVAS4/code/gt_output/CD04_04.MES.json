[
    {
        "name": "円",
        "name_idx": 246,
        "ori": "「放してよ！」",
        "message": "「放开我！」",
        "text_idx": [
            255
        ]
    },
    {
        "ori": "円は嫌悪感のこもった声で、乱暴に俺の手をふりほどこうとした。",
        "message": "圆用充满厌恶的声音，粗暴地想要甩开我的手。",
        "text_idx": [
            314,
            315
        ]
    },
    {
        "ori": "でも、これは円のいつもの手だ。",
        "message": "但是，这是圆的老一套了。",
        "text_idx": [
            330
        ]
    },
    {
        "ori": "俺を怒らせて、冷静さを欠かせる寸法だ。",
        "message": "想惹我生气，让我失去冷静，这就是她的伎俩。",
        "text_idx": [
            345
        ]
    },
    {
        "name": "亮",
        "name_idx": 351,
        "ori": "「話してくれたら、放すよ」",
        "message": "「只要你肯说，我就会放手的」",
        "text_idx": [
            360
        ]
    },
    {
        "ori": "こっちが怒ったら元も子もない。",
        "message": "我要是生起气来，就得不偿失了。",
        "text_idx": [
            375
        ]
    },
    {
        "ori": "落ち着いて、冷静に話さないと円は逃げてしまう。",
        "message": "我必须冷静下来好好谈，不然圆就会逃走的。",
        "text_idx": [
            390
        ]
    },
    {
        "name": "円",
        "name_idx": 508,
        "ori": "「放して！　ほうっておいてよ！」",
        "message": "「放开我！　别管我！」",
        "text_idx": [
            517
        ]
    },
    {
        "name": "亮",
        "name_idx": 567,
        "ori": "「怒ったフリをしても、もう誤魔化されない」",
        "message": "「就算你假装生气，也已经骗不了我了」",
        "text_idx": [
            576
        ]
    },
    {
        "ori": "そっぽを向いたまま暴れようとする円に、俺は話しかけ続けた。",
        "message": "我继续对别过脸去想要挣扎的圆说道。",
        "text_idx": [
            591,
            592
        ]
    },
    {
        "name": "亮",
        "name_idx": 598,
        "ori": "「俺は、好奇心で聞いているわけじゃない。本当に、キミのためになにかをしたいんだ……」",
        "message": "「我不是因为好奇才问的。我是真的，想要为你做些什么……」",
        "text_idx": [
            607,
            608
        ]
    },
    {
        "name": "円",
        "name_idx": 628,
        "ori": "「………………」",
        "message": "「………………」",
        "text_idx": [
            637
        ]
    },
    {
        "name": "亮",
        "name_idx": 643,
        "ori": "「だから……誤魔化したりしないで、もう教えて欲しい」",
        "message": "「所以……别再敷衍我了，告诉我吧」",
        "text_idx": [
            652
        ]
    },
    {
        "name": "円",
        "name_idx": 672,
        "ori": "「………………」",
        "message": "「………………」",
        "text_idx": [
            681
        ]
    },
    {
        "name": "亮",
        "name_idx": 687,
        "ori": "「友達から彼氏になったんだから……そろそろ信用して、頼ってよ……」",
        "message": "「我们已经从朋友变成恋人了……也该信任我、依赖我了吧……」",
        "text_idx": [
            696,
            697
        ]
    },
    {
        "name": "亮",
        "name_idx": 703,
        "ori": "「俺は、円のためになることをしたいんだ」",
        "message": "「我是真的想为圆做些什么啊」",
        "text_idx": [
            712
        ]
    },
    {
        "name": "円",
        "name_idx": 732,
        "ori": "「…………かない……」",
        "message": "「…………没有……」",
        "text_idx": [
            741
        ]
    },
    {
        "name": "亮",
        "name_idx": 747,
        "ori": "「え……？」",
        "message": "「诶……？」",
        "text_idx": [
            756
        ]
    },
    {
        "name": "円",
        "name_idx": 776,
        "ori": "「誤魔化してなんか……ない」",
        "message": "「我没有……在敷衍你」",
        "text_idx": [
            785
        ]
    },
    {
        "ori": "俺に向き直った円の目は見る間に涙で潤み、それは抑えきれなくなり、ほほを伝い落ちた。",
        "message": "转过身来面向我的圆，眼中瞬间就噙满了泪水，再也抑制不住，顺着脸颊滑落下来。",
        "text_idx": [
            1568,
            1569
        ]
    },
    {
        "name": "円",
        "name_idx": 1589,
        "ori": "「どうして……」",
        "message": "「为什么……」",
        "text_idx": [
            1598
        ]
    },
    {
        "ori": "俺は、そのままなにも言わずに、泣きじゃくる円を抱きしめた。",
        "message": "我什么也没说，只是将抽泣不止的圆紧紧拥入怀中。",
        "text_idx": [
            1693,
            1694
        ]
    },
    {
        "name": "円",
        "name_idx": 1758,
        "ori": "「なんで……なんで、ボクの心の中に、そんなにも簡単に入って来るの……」",
        "message": "「为什么……为什么，你要这么轻易地闯进我的心里……」",
        "text_idx": [
            1767,
            1768
        ]
    },
    {
        "name": "円",
        "name_idx": 1788,
        "ori": "「どうして……キミはそんなにも、強くなれたの……？」",
        "message": "「为什么……你能变得如此坚强……？」",
        "text_idx": [
            1797
        ]
    },
    {
        "name": "亮",
        "name_idx": 1803,
        "ori": "「………………」",
        "message": "「………………」",
        "text_idx": [
            1812
        ]
    },
    {
        "name": "円",
        "name_idx": 1832,
        "ori": "「ボクは……怖い……」",
        "message": "「我……好害怕……」",
        "text_idx": [
            1841
        ]
    },
    {
        "name": "円",
        "name_idx": 1861,
        "ori": "「亮を彼氏に出来たのは、すごく嬉しい」",
        "message": "「亮能当我的男朋友，我真的很高兴」",
        "text_idx": [
            1870
        ]
    },
    {
        "name": "円",
        "name_idx": 1890,
        "ori": "「でも……怖いの……」",
        "message": "「但是……我好害怕……」",
        "text_idx": [
            1899
        ]
    },
    {
        "name": "円",
        "name_idx": 1919,
        "ori": "「キミに会うたびに、ボクの色々な……目に見えないものが壊されていく気がして……」",
        "message": "「每当见到你，我就感觉我心中各种……看不见的东西正在被破坏……」",
        "text_idx": [
            1928,
            1929
        ]
    },
    {
        "name": "亮",
        "name_idx": 1935,
        "ori": "「壊す……？」",
        "message": "「破坏……？」",
        "text_idx": [
            1944
        ]
    },
    {
        "name": "円",
        "name_idx": 1964,
        "ori": "「ボクの中のなにかが……変わっていきそうで……怖い」",
        "message": "「我内心的什么东西……好像就要改变了……好可怕」",
        "text_idx": [
            1973
        ]
    },
    {
        "name": "亮",
        "name_idx": 1979,
        "ori": "「俺たちは鏡なんだろ？　片方が変われば、もう片方も変わらなきゃならなくなる」",
        "message": "「我们是镜子，对吧？　如果一面改变了，另一面也必须跟着改变」",
        "text_idx": [
            1988,
            1989
        ]
    },
    {
        "name": "亮",
        "name_idx": 1995,
        "ori": "「鏡なんだから当然だと思うけど……」",
        "message": "「因为我们是镜子，所以我觉得这是理所当然的……」",
        "text_idx": [
            2004
        ]
    },
    {
        "name": "円",
        "name_idx": 2024,
        "ori": "「そんな理屈、わかんないよ……」",
        "message": "「那种大道理，我不懂啊……」",
        "text_idx": [
            2033
        ]
    },
    {
        "name": "亮",
        "name_idx": 2039,
        "ori": "「俺も……怖かったよ。母さんに向き合うのが……」",
        "message": "「我也……很害怕啊。害怕去面对妈妈……」",
        "text_idx": [
            2048
        ]
    },
    {
        "name": "円",
        "name_idx": 2068,
        "ori": "「…ッ！？」",
        "message": "「……！？」",
        "text_idx": [
            2077
        ]
    },
    {
        "name": "亮",
        "name_idx": 2083,
        "ori": "「もしもまた……差し出した手を拒絶されたら、どうしようかって思って……」",
        "message": "「我当时在想……万一伸出的手再次被拒绝了，该怎么办……」",
        "text_idx": [
            2092,
            2093
        ]
    },
    {
        "name": "亮",
        "name_idx": 2099,
        "ori": "「でもさ……。俺は、キミの言葉に押されるままに動いて結果的には良かったと思うよ」",
        "message": "「但是啊……。我受你的话所鼓舞而行动起来从结果上来看，我觉得是件好事哦」",
        "text_idx": [
            2108,
            2109
        ]
    },
    {
        "name": "円",
        "name_idx": 2129,
        "ori": "「………………」",
        "message": "「………………」",
        "text_idx": [
            2138
        ]
    },
    {
        "name": "亮",
        "name_idx": 2144,
        "ori": "「動かなきゃ……、なにも始まらない」",
        "message": "「如果不行动……，就什么都不会开始」",
        "text_idx": [
            2153
        ]
    },
    {
        "name": "亮",
        "name_idx": 2159,
        "ori": "「もしも……最悪な結果が待っていたとしても、その時は俺も一緒につきあうから……」",
        "message": "「就算……等待着的是最坏的结果，到时候我也会陪你一起面对……」",
        "text_idx": [
            2168,
            2169
        ]
    },
    {
        "name": "円",
        "name_idx": 2189,
        "ori": "「………………」",
        "message": "「………………」",
        "text_idx": [
            2198
        ]
    },
    {
        "name": "亮",
        "name_idx": 2204,
        "ori": "「だから、悩みを教えてよ……」",
        "message": "「所以，把你的烦恼告诉我吧……」",
        "text_idx": [
            2213
        ]
    },
    {
        "name": "亮",
        "name_idx": 2219,
        "ori": "「せめて、キミの苦しみを半分わけてよ……」",
        "message": "「至少，让我分担你一半的痛苦吧……」",
        "text_idx": [
            2228
        ]
    },
    {
        "name": "円",
        "name_idx": 2248,
        "ori": "「…………うん」",
        "message": "「…………嗯」",
        "text_idx": [
            2257
        ]
    }
]