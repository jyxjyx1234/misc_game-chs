[
    {
        "ori": "この睡魔には抗えないな。やっぱりこのまま寝直そう……",
        "message": "这股睡意实在没法抵抗啊。果然还是就这样继续睡吧……",
        "text_idx": [
            85
        ]
    },
    {
        "ori": "おやすみ……",
        "message": "晚安……",
        "text_idx": [
            180
        ]
    },
    {
        "ori": "ユサユサ……",
        "message": "晃啊晃……",
        "text_idx": [
            289
        ]
    },
    {
        "ori": "ん？　じ、地震？　地震か？",
        "message": "嗯？　地、地震？　是地震吗？",
        "text_idx": [
            304
        ]
    },
    {
        "ori": "まるで金縛りにあったかのように身体が動かない。",
        "message": "我的身体简直就像被鬼压床一样动弹不得。",
        "text_idx": [
            319
        ]
    },
    {
        "ori": "なにか、背中を押さえつけられているようなそんな感じが……",
        "message": "感觉好像有什么东西，正压着我的后背似的……",
        "text_idx": [
            334,
            335
        ]
    },
    {
        "ori": "いったい……",
        "message": "究竟……",
        "text_idx": [
            350
        ]
    },
    {
        "name": "亮",
        "name_idx": 356,
        "ori": "「って……ん？　ええ？」",
        "message": "「我说……嗯？　欸欸？」",
        "text_idx": [
            365
        ]
    },
    {
        "name": "円",
        "name_idx": 511,
        "ori": "「オハヨ」",
        "message": "「早上好」",
        "text_idx": [
            520
        ]
    },
    {
        "ori": "目を開けると、そこには俺の身体を揺すっていた此ノ花さんの顔があった。",
        "message": "我一睁开眼，便看到正在摇晃我身体的此之花学姐的脸。",
        "text_idx": [
            535,
            536
        ]
    },
    {
        "name": "亮",
        "name_idx": 542,
        "ori": "「寝て……た……？」",
        "message": "「我睡……着了……？」",
        "text_idx": [
            551
        ]
    },
    {
        "name": "円",
        "name_idx": 625,
        "ori": "「うん。しっかり、すっかり寝てた」",
        "message": "「嗯。睡得很沉，彻底睡过去了」",
        "text_idx": [
            634
        ]
    },
    {
        "name": "亮",
        "name_idx": 684,
        "ori": "「すっかり寝てたって……おかしい日本語……」",
        "message": "「彻底睡过去了啊……这日语真奇怪……」",
        "text_idx": [
            693
        ]
    },
    {
        "ori": "おまけに中途半端に寝たせいか、全然スッキリしてない。",
        "message": "而且，可能因为睡得不踏实，我完全没觉得清醒。",
        "text_idx": [
            708
        ]
    },
    {
        "name": "円",
        "name_idx": 772,
        "ori": "「午前中の授業内容、憶えてる？」",
        "message": "「上午课的内容，你还记得吗？」",
        "text_idx": [
            781
        ]
    },
    {
        "name": "亮",
        "name_idx": 787,
        "ori": "「んー……」",
        "message": "「嗯……」",
        "text_idx": [
            796
        ]
    },
    {
        "name": "亮",
        "name_idx": 802,
        "ori": "「起立して……礼して……起立して……礼して……」",
        "message": "「起立……敬礼……起立……敬礼……」",
        "text_idx": [
            811
        ]
    },
    {
        "ori": "それで昼休みになって、また突っ伏して……",
        "message": "然后就到了午休时间，我又趴下了……",
        "text_idx": [
            826
        ]
    },
    {
        "name": "円",
        "name_idx": 890,
        "ori": "「一応、号令の時だけは起きてたんだ」",
        "message": "「原来你至少在喊口令的时候还醒着啊」",
        "text_idx": [
            899
        ]
    },
    {
        "name": "亮",
        "name_idx": 905,
        "ori": "「うん……たぶん……」",
        "message": "「嗯……大概吧……」",
        "text_idx": [
            914
        ]
    },
    {
        "name": "亮",
        "name_idx": 920,
        "ori": "「まだ、ねむぅ……」",
        "message": "「还是，好困啊……」",
        "text_idx": [
            929
        ]
    },
    {
        "name": "円",
        "name_idx": 993,
        "ori": "「なんでそんなに眠いの？」",
        "message": "「你为什么这么困啊？」",
        "text_idx": [
            1002
        ]
    },
    {
        "name": "亮",
        "name_idx": 1008,
        "ori": "「ん……。昨日は遅くまで絵を描いていたから……」",
        "message": "「嗯……。因为昨天画画画到很晚……」",
        "text_idx": [
            1017
        ]
    },
    {
        "name": "円",
        "name_idx": 1081,
        "ori": "「徹夜したの？」",
        "message": "「你通宵了吗？」",
        "text_idx": [
            1090
        ]
    },
    {
        "name": "亮",
        "name_idx": 1096,
        "ori": "「んー……ちょっとは……寝たかな」",
        "message": "「唔……算是……睡了一会儿吧」",
        "text_idx": [
            1105
        ]
    },
    {
        "ori": "眠くて眠くてたまらない……",
        "message": "我困得不行……",
        "text_idx": [
            1120
        ]
    },
    {
        "ori": "授業中ずっと寝ていたはずなんだけど……",
        "message": "明明上课的时候我一直都在睡……",
        "text_idx": [
            1135
        ]
    },
    {
        "ori": "高々あれくらい寝た程度じゃ、全然眠りが足りない。",
        "message": "光睡那么一会儿，根本就不够。",
        "text_idx": [
            1150
        ]
    },
    {
        "name": "亮",
        "name_idx": 1156,
        "ori": "「で、なんか用？」",
        "message": "「所以，你有什么事吗？」",
        "text_idx": [
            1165
        ]
    },
    {
        "name": "円",
        "name_idx": 1229,
        "ori": "「もう、お昼なんだけど……」",
        "message": "「已经是中午了哦……」",
        "text_idx": [
            1238
        ]
    },
    {
        "name": "亮",
        "name_idx": 1244,
        "ori": "「ああ……もう昼休みになってたんだっけ……」",
        "message": "「啊啊……已经到午休时间了吗……」",
        "text_idx": [
            1253
        ]
    },
    {
        "ori": "そう考えると４時間分は寝ていたはずなんだけど、まったくそれだけ寝た気分じゃない。",
        "message": "这么一想我应该睡了四个小时了，但完全没有睡了那么久的感觉。",
        "text_idx": [
            1268,
            1269
        ]
    },
    {
        "ori": "途中、無意識に起きて、立ち上がって号令に合わせて礼をしていたせいかな……",
        "message": "难道是因为我在中途无意识地起来，跟着号令起立敬礼了吗……",
        "text_idx": [
            1284,
            1285
        ]
    },
    {
        "ori": "昼休み中、グダーっと寝ていたいんだけど……それをやったら、朝・昼の２食抜きになる。",
        "message": "我本想在午休时间里好好睡一觉的……但要是这么干的话，早饭和午饭就都等于没吃了。",
        "text_idx": [
            1300,
            1301
        ]
    },
    {
        "name": "亮",
        "name_idx": 1307,
        "ori": "「さすがに、昼は食べないとなぁ……」",
        "message": "「再怎么说，午饭还是得吃的啊……」",
        "text_idx": [
            1316
        ]
    },
    {
        "name": "円",
        "name_idx": 1380,
        "ori": "「じゃあ、一緒に食べない？」",
        "message": "「那，要不要一起吃？」",
        "text_idx": [
            1389
        ]
    },
    {
        "name": "亮",
        "name_idx": 1395,
        "ori": "「ドコ……で？」",
        "message": "「在哪……吃？」",
        "text_idx": [
            1404
        ]
    },
    {
        "name": "円",
        "name_idx": 1468,
        "ori": "「天気いいから屋上でどうかな？　面倒なら、学食でもいいけど？」",
        "message": "「天气这么好，去天台怎么样？　要是嫌麻烦的话，在食堂也可以哦？」",
        "text_idx": [
            1477,
            1478
        ]
    },
    {
        "name": "亮",
        "name_idx": 1484,
        "ori": "「あー……」",
        "message": "「啊——……」",
        "text_idx": [
            1493
        ]
    },
    {
        "ori": "なんか……もう、どっちでもよかったんだけど……",
        "message": "其实……去哪都无所谓了……",
        "text_idx": [
            1508
        ]
    },
    {
        "ori": "学食に立ち込めているであろう大量の様々な食べ物の臭気を、今、嗅いだら……",
        "message": "食堂里现在肯定弥漫着各种食物混杂在一起的味道要是我现在闻到的话……",
        "text_idx": [
            1523,
            1524
        ]
    },
    {
        "name": "亮",
        "name_idx": 1530,
        "ori": "「ヤバそうな予感がするな……」",
        "message": "「总有种不妙的预感啊……」",
        "text_idx": [
            1539
        ]
    },
    {
        "name": "円",
        "name_idx": 1603,
        "ori": "「ん？　なにがヤバイの？」",
        "message": "「嗯？　什么不妙？」",
        "text_idx": [
            1612
        ]
    },
    {
        "name": "亮",
        "name_idx": 1618,
        "ori": "「い、いや……こっちの事だから……」",
        "message": "「不、不……是我自己的事……」",
        "text_idx": [
            1627
        ]
    },
    {
        "ori": "絶対に……吐きそうだ。",
        "message": "我绝对……要吐了。",
        "text_idx": [
            1642
        ]
    },
    {
        "name": "亮",
        "name_idx": 1648,
        "ori": "「じゃあ、パンでも買って、屋上に行こうか……」",
        "message": "「那么，就买点面包，去天台吧……」",
        "text_idx": [
            1657
        ]
    },
    {
        "name": "円",
        "name_idx": 1721,
        "ori": "「大量に食べる気？」",
        "message": "「你打算吃很多吗？」",
        "text_idx": [
            1730
        ]
    },
    {
        "name": "亮",
        "name_idx": 1736,
        "ori": "「いや、ちょっとだけあればいいや……」",
        "message": "「不，只要一点点就好……」",
        "text_idx": [
            1745
        ]
    },
    {
        "ori": "徹夜に近い状態で、さらに授業中の断続的睡眠による体調不良の状態だ、無茶食いはしない。",
        "message": "我现在跟通宵差不多，再加上上课时断断续续地睡觉导致身体不适，是不会胡吃海塞的。",
        "text_idx": [
            1760,
            1761
        ]
    },
    {
        "ori": "どっちかっていうと、とにかくナニかを胃に入れて、落ち着きたい感じかな……",
        "message": "硬要说的话，我只是想随便往胃里塞点什么，好让自己安稳下来的感觉吧……",
        "text_idx": [
            1776,
            1777
        ]
    },
    {
        "name": "円",
        "name_idx": 1841,
        "ori": "「なら、ボクのパンをあげるよ」",
        "message": "「那，我的面包给你吧」",
        "text_idx": [
            1850
        ]
    },
    {
        "name": "亮",
        "name_idx": 1856,
        "ori": "「え……？　いいの？」",
        "message": "「哎……？　可以吗？」",
        "text_idx": [
            1865
        ]
    },
    {
        "name": "円",
        "name_idx": 1939,
        "ori": "「うん。その状態で購買に行って、モミクチャにされたら生きては帰ってこられないでしょ？」",
        "message": "「嗯。你这状态要是跑去小卖部，被人潮挤来挤去的话可就回不来了吧？」",
        "text_idx": [
            1948,
            1949
        ]
    },
    {
        "name": "亮",
        "name_idx": 1999,
        "ori": "「あー……」",
        "message": "「啊——……」",
        "text_idx": [
            2008
        ]
    },
    {
        "ori": "確かに……",
        "message": "确实……",
        "text_idx": [
            2023
        ]
    },
    {
        "name": "亮",
        "name_idx": 2029,
        "ori": "「でも、此ノ花さんのお昼は足りるの？」",
        "message": "「可是，此之花同学的午饭够吃吗？」",
        "text_idx": [
            2038
        ]
    },
    {
        "name": "円",
        "name_idx": 2102,
        "ori": "「うん！　大丈夫」",
        "message": "「嗯！　没问题」",
        "text_idx": [
            2111
        ]
    },
    {
        "name": "円",
        "name_idx": 2175,
        "ori": "「近所のコンビニで、オヤツに食べる分まで買っておいたから問題ナシ！」",
        "message": "「我在附近的便利店，连当零食吃的份都买好了所以没问题！」",
        "text_idx": [
            2184,
            2185
        ]
    },
    {
        "name": "亮",
        "name_idx": 2191,
        "ori": "「そっか……じゃあ、お言葉に甘えさせて頂きましょうかね」",
        "message": "「是吗……那么，我就恭敬不如从命了吧」",
        "text_idx": [
            2200,
            2201
        ]
    },
    {
        "name": "円",
        "name_idx": 2319,
        "ori": "「くっくっくっくっくっく……これで貸しひとつネ」",
        "message": "「库库库库库库……这样你就欠我一个人情了哦」",
        "text_idx": [
            2328
        ]
    },
    {
        "name": "亮",
        "name_idx": 2334,
        "ori": "「へ……？」",
        "message": "「诶……？」",
        "text_idx": [
            2343
        ]
    },
    {
        "name": "円",
        "name_idx": 2407,
        "ori": "「うぅん！　なんでもないよ！」",
        "message": "「不不！　没什么啦！」",
        "text_idx": [
            2416
        ]
    },
    {
        "name": "亮",
        "name_idx": 2422,
        "ori": "「え……いや、今、貸しひとつって言わなかった？」",
        "message": "「欸……不对，你刚才是不是说我欠你一个人情？」",
        "text_idx": [
            2431
        ]
    },
    {
        "name": "円",
        "name_idx": 2495,
        "ori": "「えー！？　そんなこと言ってないよぉ。キミの空耳じゃないのぉ？？」",
        "message": "「欸—！？　我可没说那种话哦。是你听错了吧？？」",
        "text_idx": [
            2504,
            2505
        ]
    },
    {
        "name": "亮",
        "name_idx": 2511,
        "ori": "「いや……空耳って……」",
        "message": "「不对……你说听错了……」",
        "text_idx": [
            2520
        ]
    },
    {
        "name": "円",
        "name_idx": 2638,
        "ori": "「ささ、いこいこ！」",
        "message": "「好了好了，走吧走吧！」",
        "text_idx": [
            2647
        ]
    },
    {
        "name": "亮",
        "name_idx": 2697,
        "ori": "「い、いや……ちょっと待って」",
        "message": "「不、不对……你等一下」",
        "text_idx": [
            2706
        ]
    },
    {
        "name": "円",
        "name_idx": 2770,
        "ori": "「ん？　なにかなぁ？」",
        "message": "「嗯？　什么事呀？」",
        "text_idx": [
            2779
        ]
    },
    {
        "ori": "よからぬ事を言っただろうと突っ込もうとしたけど、目の前でニコニコと天真爛漫な笑顔で振り返られたら、なんだかもう突っ込む気も失せた。",
        "message": "我本想吐槽她刚才是不是说了什么不怀好意的话，但当她在我面前回过头来，脸上挂着天真烂漫的笑容时，不知为何，我吐槽的念头也烟消云散了。",
        "text_idx": [
            2794,
            2795,
            2796
        ]
    },
    {
        "name": "円",
        "name_idx": 2860,
        "ori": "「ん？　ん？　なに？　なに？　なぁに？」",
        "message": "「嗯？　嗯？　什么？　什么？　什么事呀？」",
        "text_idx": [
            2869
        ]
    },
    {
        "name": "亮",
        "name_idx": 2875,
        "ori": "「いや……その……」",
        "message": "「不……那个……」",
        "text_idx": [
            2884
        ]
    },
    {
        "name": "円",
        "name_idx": 2948,
        "ori": "「どしたの？」",
        "message": "「怎么了？」",
        "text_idx": [
            2957
        ]
    },
    {
        "name": "亮",
        "name_idx": 2963,
        "ori": "「いや……飲み物……買わないとさ」",
        "message": "「不……饮料……得先买啊」",
        "text_idx": [
            2972
        ]
    },
    {
        "name": "円",
        "name_idx": 3036,
        "ori": "「睡眠不足明けなら、乳製品がお勧めよ。特にヨーグルト系かな？」",
        "message": "「刚熬完夜的话，推荐你喝乳制品哦。特别是酸奶之类的？」",
        "text_idx": [
            3045,
            3046
        ]
    },
    {
        "name": "亮",
        "name_idx": 3052,
        "ori": "「はあ……」",
        "message": "「唉……」",
        "text_idx": [
            3061
        ]
    },
    {
        "name": "円",
        "name_idx": 3125,
        "ori": "「荒れた胃の粘膜を修復してくれる感じ？」",
        "message": "「有种能修复受损胃黏膜的感觉？」",
        "text_idx": [
            3134
        ]
    },
    {
        "ori": "感じ……なんだ……",
        "message": "只是感觉……啊……",
        "text_idx": [
            3149
        ]
    },
    {
        "ori": "まぁ……いいけどさ……",
        "message": "嘛……不过也行吧……",
        "text_idx": [
            3164
        ]
    },
    {
        "name": "亮",
        "name_idx": 3170,
        "ori": "「じゃあ、それを買ってからでいいかな？」",
        "message": "「那，我先买完那个行吗？」",
        "text_idx": [
            3179
        ]
    },
    {
        "name": "円",
        "name_idx": 3287,
        "ori": "「はーい。じゃあ、行こうか」",
        "message": "「好—。那我们走吧」",
        "text_idx": [
            3296
        ]
    },
    {
        "name": "蘭",
        "name_idx": 3374,
        "ori": "「あ、ちょ……ちょっと待って」",
        "message": "「啊，等……等一下」",
        "text_idx": [
            3383
        ]
    },
    {
        "name": "円",
        "name_idx": 3505,
        "ori": "「うにゃ？　どうしたの？」",
        "message": "「唔？　怎么了？」",
        "text_idx": [
            3514
        ]
    },
    {
        "name": "蘭",
        "name_idx": 3578,
        "ori": "「ボクも……一緒に食べていいかな？」",
        "message": "「我也……可以一起吃吗？」",
        "text_idx": [
            3587
        ]
    },
    {
        "name": "円",
        "name_idx": 3705,
        "ori": "「もちろん！　あてくしが蘭のお願いを断ると思って？」",
        "message": "「当然了！　你觉得我会拒绝兰的请求吗？」",
        "text_idx": [
            3714
        ]
    },
    {
        "name": "蘭",
        "name_idx": 3778,
        "ori": "「い、いや……そうだけど……」",
        "message": "「不、不是……话是这么说……」",
        "text_idx": [
            3787
        ]
    },
    {
        "name": "蘭",
        "name_idx": 3851,
        "ori": "「ついでに、ボクが飲み物買ってくるから、小松原くんは円と先に屋上に行ってて」",
        "message": "「顺便，我去买饮料，小松原同学你和圆先上天台吧」",
        "text_idx": [
            3860,
            3861
        ]
    },
    {
        "name": "亮",
        "name_idx": 3867,
        "ori": "「え、あ……ああ、いいの？」",
        "message": "「诶，啊……啊啊，可以吗？」",
        "text_idx": [
            3876
        ]
    },
    {
        "name": "蘭",
        "name_idx": 3940,
        "ori": "「うん。なにが飲みたい？」",
        "message": "「嗯。你想喝什么？」",
        "text_idx": [
            3949
        ]
    },
    {
        "name": "亮",
        "name_idx": 3955,
        "ori": "「あー……じゃあ……」",
        "message": "「啊—……那……」",
        "text_idx": [
            3964
        ]
    },
    {
        "name": "円",
        "name_idx": 4082,
        "ori": "「天ぷらソーダ鷹の爪３倍増し」",
        "message": "「天妇罗苏打水，鹰爪辣椒三倍量」",
        "text_idx": [
            4091
        ]
    },
    {
        "name": "亮",
        "name_idx": 4141,
        "ori": "「ちょっ、ちょーっ！！」",
        "message": "「等、等一下！！」",
        "text_idx": [
            4150
        ]
    },
    {
        "ori": "なんてモノを頼もうとしてんだよ！",
        "message": "你到底要点什么鬼东西啊！",
        "text_idx": [
            4165
        ]
    },
    {
        "name": "蘭",
        "name_idx": 4229,
        "ori": "「円……それ、本気で飲む気？」",
        "message": "「圆……那个，你真打算喝吗？」",
        "text_idx": [
            4238
        ]
    },
    {
        "name": "円",
        "name_idx": 4312,
        "ori": "「うん。小松原くんが」",
        "message": "「嗯。小松原同学喝」",
        "text_idx": [
            4321
        ]
    },
    {
        "name": "蘭",
        "name_idx": 4429,
        "ori": "「円が飲むんじゃないんだ」",
        "message": "「不是圆你喝啊」",
        "text_idx": [
            4438
        ]
    },
    {
        "name": "円",
        "name_idx": 4556,
        "ori": "「うん。小松原くんの好みよ」",
        "message": "「嗯。是小松原同学的口味哦」",
        "text_idx": [
            4565
        ]
    },
    {
        "name": "蘭",
        "name_idx": 4673,
        "ori": "「そっか。なら、仕方ないね。そんなゲティなモノでも」",
        "message": "「是吗。那也没办法了呢。就算是那种怪东西」",
        "text_idx": [
            4682
        ]
    },
    {
        "name": "円",
        "name_idx": 4746,
        "ori": "「そう。仕方ないの。小松原くんの大好物ですもの」",
        "message": "「对。没办法的。因为是小松原同学最喜欢的东西嘛」",
        "text_idx": [
            4755
        ]
    },
    {
        "name": "亮",
        "name_idx": 4761,
        "ori": "「ちょ、ちょっと待て！　勝手に話し進めんな！」",
        "message": "「等、等一下！　别自顾自地说下去啊！」",
        "text_idx": [
            4770
        ]
    },
    {
        "name": "蘭",
        "name_idx": 4834,
        "ori": "「あれ？　大好物じゃないの？」",
        "message": "「啊咧？　不是你最喜欢的吗？」",
        "text_idx": [
            4843
        ]
    },
    {
        "name": "亮",
        "name_idx": 4849,
        "ori": "「智継ならともかく、俺がそんなゲテモノ大好きゲティな味覚をしてるように見えるのかよ！」",
        "message": "「要是智继也就算了，我看起来像是有着超爱怪东西的猎奇味觉吗！」",
        "text_idx": [
            4858,
            4859
        ]
    },
    {
        "name": "蘭",
        "name_idx": 4923,
        "ori": "「だって……椎名君の友達だしねぇ……」",
        "message": "「因为……你是椎名同学的朋友嘛……」",
        "text_idx": [
            4932
        ]
    },
    {
        "name": "亮",
        "name_idx": 4938,
        "ori": "「と、智継の友達なら全員ゲティなのか！？」",
        "message": "「难道、只要是智继的朋友就都喜欢怪东西吗！？」",
        "text_idx": [
            4947
        ]
    },
    {
        "name": "蘭",
        "name_idx": 5011,
        "ori": "「あり得そうかなぁ……なんて……ねぇ」",
        "message": "「感觉很有可能呢……什么的……对吧」",
        "text_idx": [
            5020
        ]
    },
    {
        "name": "円",
        "name_idx": 5138,
        "ori": "「うんうん」",
        "message": "「嗯嗯」",
        "text_idx": [
            5147
        ]
    },
    {
        "name": "亮",
        "name_idx": 5197,
        "ori": "「納得しないでくれよ！」",
        "message": "「你们别给我信啊！」",
        "text_idx": [
            5206
        ]
    },
    {
        "name": "蘭",
        "name_idx": 5324,
        "ori": "「ウソウソ、ジョークジョーク。小松原くんはヨーグルトドリンクなんでしょ。イチゴ？　オレンジ？」",
        "message": "「骗你的骗你的，开玩笑啦。小松原同学要的是酸奶饮料对吧。草莓？　还是橙子？」",
        "text_idx": [
            5333,
            5334
        ]
    },
    {
        "name": "亮",
        "name_idx": 5384,
        "ori": "「え……あー……じゃあ、イチゴで……」",
        "message": "「呃……啊……那就，草莓的吧……」",
        "text_idx": [
            5393
        ]
    },
    {
        "name": "蘭",
        "name_idx": 5501,
        "ori": "「了解。じゃあ、先に行ってて」",
        "message": "「了解。那你先过去吧」",
        "text_idx": [
            5510
        ]
    },
    {
        "ori": "なんだか……土壇場で切り替えされて、正直、ホッとする以外のなにも出来なかった。",
        "message": "总感觉……在最后关头被她岔开了话题，老实说，我除了松一口气之外什么也做不了。",
        "text_idx": [
            5616,
            5617
        ]
    },
    {
        "name": "円",
        "name_idx": 5695,
        "ori": "「なんだぁ。つまんないでありんす」",
        "message": "「什么嘛。真无聊呀」",
        "text_idx": [
            5704
        ]
    },
    {
        "name": "亮",
        "name_idx": 5710,
        "ori": "「へ？」",
        "message": "「欸？」",
        "text_idx": [
            5719
        ]
    },
    {
        "name": "円",
        "name_idx": 5783,
        "ori": "「小松原くんなら、ボクの為ならばゲティ専用ドリンクを飲める！　って言ってくれるかと思ったのに」",
        "message": "「我本以为小松原同学会说「为了我的话，就算是盖提专用饮料我也能喝！」呢」",
        "text_idx": [
            5792,
            5793
        ]
    },
    {
        "name": "亮",
        "name_idx": 5799,
        "ori": "「いや……此ノ花さんの為ならって……」",
        "message": "「不……说什么为了此之花同学的话……」",
        "text_idx": [
            5808
        ]
    },
    {
        "name": "円",
        "name_idx": 5916,
        "ori": "「さ、行くでがんす～」",
        "message": "「好，出发咯～」",
        "text_idx": [
            5925
        ]
    },
    {
        "ori": "重い頭を抱え込んだ俺の手を引っ張って、今、口にしていた冗談の事などまるで忘れた様子の此ノ花さんは、廊下を駆け出した。",
        "message": "此之花同学拉起正抱着头的我的手，仿佛完全忘了刚才的玩笑似的，在走廊上跑了起来。",
        "text_idx": [
            6034,
            6035,
            6036
        ]
    },
    {
        "name": "円",
        "name_idx": 6854,
        "ori": "「いい気持ち……教室の空気もこもってるよね」",
        "message": "「真舒服啊……教室里的空气也很闷呢」",
        "text_idx": [
            6863
        ]
    },
    {
        "name": "亮",
        "name_idx": 6869,
        "ori": "「まぁ、屋内だし……」",
        "message": "「嘛，毕竟是在室内嘛……」",
        "text_idx": [
            6878
        ]
    },
    {
        "name": "円",
        "name_idx": 7238,
        "ori": "「ここここ、座って座って！」",
        "message": "「这里这里，快坐快坐！」",
        "text_idx": [
            7247
        ]
    },
    {
        "ori": "さっさと、屋上の植え込みそばのベンチに腰掛けた此ノ花さんは、ベンチの真ん中を指さして激しく手を動かした。",
        "message": "此之花同学迅速在屋顶花坛边的长椅上坐下，然后指着长椅中间，使劲地挥着手。",
        "text_idx": [
            7262,
            7263
        ]
    },
    {
        "ori": "なんか……。早くそこに座らないと、後５秒で爆弾が爆発するみたいな様子で。",
        "message": "总觉得……。她那样子，简直就像如果再不快点坐过去，炸弹就会在5秒后爆炸似的。",
        "text_idx": [
            7278,
            7279
        ]
    },
    {
        "name": "円",
        "name_idx": 7547,
        "ori": "「ハムタマゴ・サンドと、ツナサラダ・サンド。どっちがいい？」",
        "message": "「火腿鸡蛋·三明治和金枪鱼沙拉·三明治。你想要哪个？」",
        "text_idx": [
            7556,
            7557
        ]
    },
    {
        "name": "亮",
        "name_idx": 7563,
        "ori": "「どっちでもいいよ。此ノ花さんの好きな方で」",
        "message": "「哪个都行。就选此之花同学喜欢的那个吧」",
        "text_idx": [
            7572
        ]
    },
    {
        "name": "円",
        "name_idx": 7636,
        "ori": "「あいにく『此ノ花さんの好きな方で』は、本日品切れとなっております」",
        "message": "「不好意思，『此之花同学喜欢的那个』今天已经卖完了哦」",
        "text_idx": [
            7645,
            7646
        ]
    },
    {
        "name": "亮",
        "name_idx": 7652,
        "ori": "「え……」",
        "message": "「诶……」",
        "text_idx": [
            7661
        ]
    },
    {
        "name": "円",
        "name_idx": 7725,
        "ori": "「どっちでもいいはなし！　女の子に失礼よ！」",
        "message": "「不许说哪个都行！　这对女孩子很失礼的！」",
        "text_idx": [
            7734
        ]
    },
    {
        "name": "亮",
        "name_idx": 7740,
        "ori": "「そ、そうなの？」",
        "message": "「是、是吗？」",
        "text_idx": [
            7749
        ]
    },
    {
        "name": "円",
        "name_idx": 7813,
        "ori": "「うん。こういうのは、男の人がリードして選ばないと」",
        "message": "「嗯。这种时候，男生必须要主动来选才行」",
        "text_idx": [
            7822
        ]
    },
    {
        "ori": "こういう所でも、男のリードって必要なのか？",
        "message": "连这种时候，也需要男生来主动吗？",
        "text_idx": [
            7837
        ]
    },
    {
        "name": "亮",
        "name_idx": 7843,
        "ori": "「じゃあ、ツナサラダ・サンドを……」",
        "message": "「那，金枪鱼沙拉·三明治……」",
        "text_idx": [
            7852
        ]
    },
    {
        "name": "円",
        "name_idx": 7916,
        "ori": "「はい。ツナサラ…」",
        "message": "「好的。金枪鱼沙……」",
        "text_idx": [
            7925
        ]
    },
    {
        "name": "亮",
        "name_idx": 7931,
        "ori": "「此ノ花さんに食べてもらって、俺はハムタマゴ・サンドでお願いします」",
        "message": "「……给此之花同学吃，我吃火腿鸡蛋·三明治就好了」",
        "text_idx": [
            7940,
            7941
        ]
    },
    {
        "name": "円",
        "name_idx": 8102,
        "ori": "「おのれ……」",
        "message": "「可恶……」",
        "text_idx": [
            8111
        ]
    },
    {
        "name": "亮",
        "name_idx": 8117,
        "ori": "「なにか？」",
        "message": "「怎么了？」",
        "text_idx": [
            8126
        ]
    },
    {
        "name": "円",
        "name_idx": 8244,
        "ori": "「わらわをたばかったな！」",
        "message": "「你竟敢蒙骗本小姐！」",
        "text_idx": [
            8253
        ]
    },
    {
        "name": "亮",
        "name_idx": 8303,
        "ori": "「いえいえ。リードして見せただけでございます。姫様」",
        "message": "「不不。我只是示范了一下如何主导罢了。公主殿下」",
        "text_idx": [
            8312
        ]
    },
    {
        "name": "円",
        "name_idx": 8386,
        "ori": "「リードするなら、わらわがパンを差し出す前にすべきであろうに！　このたわけ者！」",
        "message": "「要主导的话，也该在本小姐拿出面包之前啊！你这个笨蛋！」",
        "text_idx": [
            8395,
            8396
        ]
    },
    {
        "name": "亮",
        "name_idx": 8486,
        "ori": "「ご要望に応えたのに、たわけ者はひどいな」",
        "message": "「我明明回应了你的要求，还说我是笨蛋也太过分了吧」",
        "text_idx": [
            8495
        ]
    },
    {
        "name": "円",
        "name_idx": 8602,
        "ori": "「おにょれ、こしゃくな……こうしてやる！」",
        "message": "「可恶，你个嚣张的家伙……看我这样！」",
        "text_idx": [
            8611
        ]
    },
    {
        "name": "亮",
        "name_idx": 8617,
        "ori": "「え？　ちょ、ちょっと俺がハムタマゴ・サンドだろ！」",
        "message": "「诶？　等、等等，火腿鸡蛋三明治是我的吧！」",
        "text_idx": [
            8626
        ]
    },
    {
        "ori": "俺が止める間もなく、ハムタマゴ・サンドの包みを開いた此ノ花さんは、コッペパンを半分に割り、さらにツナサラダ・サンドのパンも半分に割った。",
        "message": "我还没来得及阻止，此之花同学就打开了火腿鸡蛋三明治的包装，把面包掰成两半，接着又把金枪鱼沙拉三明治的面包也掰成了两半。",
        "text_idx": [
            8641,
            8642,
            8643
        ]
    },
    {
        "name": "円",
        "name_idx": 8707,
        "ori": "「はい。これで半分ずつ味わえるよ」",
        "message": "「来。这样就能各尝一半了哦」",
        "text_idx": [
            8716
        ]
    },
    {
        "name": "亮",
        "name_idx": 8722,
        "ori": "「え……」",
        "message": "「诶……」",
        "text_idx": [
            8731
        ]
    },
    {
        "name": "円",
        "name_idx": 8795,
        "ori": "「わっちと半分コにするのは嫌でありんすか？」",
        "message": "「怎么，不愿意和奴家一人一半吗？」",
        "text_idx": [
            8804
        ]
    },
    {
        "name": "亮",
        "name_idx": 8810,
        "ori": "「い、いや……全然」",
        "message": "「不、不是……完全没有」",
        "text_idx": [
            8819
        ]
    },
    {
        "name": "円",
        "name_idx": 8883,
        "ori": "「じゃあ、これで問題ナシね！」",
        "message": "「那么，这样就没问题啦！」",
        "text_idx": [
            8892
        ]
    },
    {
        "ori": "さっきまでのリード云々はなんだったんだよ……と、言いたくなるけど……",
        "message": "刚才还说什么主导权，到底算什么啊……我很想这么吐槽，但是……",
        "text_idx": [
            8907,
            8908
        ]
    },
    {
        "ori": "ニッコリと笑って分けたパンを差し出してくれる顔を見ていたら、どうでもよくなった。",
        "message": "看着她笑盈盈地把分好的面包递过来时的那张脸，我顿时觉得怎样都无所谓了。",
        "text_idx": [
            8923,
            8924
        ]
    },
    {
        "name": "蘭",
        "name_idx": 9032,
        "ori": "「お待たせー！」",
        "message": "「久等啦——！」",
        "text_idx": [
            9041
        ]
    },
    {
        "name": "蘭",
        "name_idx": 9105,
        "ori": "「……って、どしたの？」",
        "message": "「……咦，你们怎么了？」",
        "text_idx": [
            9114
        ]
    },
    {
        "name": "亮",
        "name_idx": 9120,
        "ori": "「あ？　いや、別に……」",
        "message": "「啊？　不，没什么……」",
        "text_idx": [
            9129
        ]
    },
    {
        "name": "蘭",
        "name_idx": 9193,
        "ori": "「そお？」",
        "message": "「是吗～？」",
        "text_idx": [
            9202
        ]
    },
    {
        "name": "蘭",
        "name_idx": 9630,
        "ori": "「はい、イチゴのヨーグルトドリンク」",
        "message": "「来，草莓酸奶饮料」",
        "text_idx": [
            9639
        ]
    },
    {
        "name": "亮",
        "name_idx": 9645,
        "ori": "「あ、ありがと」",
        "message": "「啊，谢谢」",
        "text_idx": [
            9654
        ]
    },
    {
        "name": "蘭",
        "name_idx": 9718,
        "ori": "「いえいえ～」",
        "message": "「不客气～」",
        "text_idx": [
            9727
        ]
    },
    {
        "name": "円",
        "name_idx": 9791,
        "ori": "「うらやましいねぇ……小松原くんは」",
        "message": "「真让人羡慕啊……小松原同学」",
        "text_idx": [
            9800
        ]
    },
    {
        "name": "亮",
        "name_idx": 9806,
        "ori": "「はぁ？」",
        "message": "「哈？」",
        "text_idx": [
            9815
        ]
    },
    {
        "ori": "また、何を言い出すのやら……",
        "message": "她又在说些什么啊……",
        "text_idx": [
            9830
        ]
    },
    {
        "name": "円",
        "name_idx": 9894,
        "ori": "「両手に華だぜ？」",
        "message": "「左拥右抱哦？」",
        "text_idx": [
            9903
        ]
    },
    {
        "name": "亮",
        "name_idx": 9909,
        "ori": "「は？」",
        "message": "「哈？」",
        "text_idx": [
            9918
        ]
    },
    {
        "ori": "言われて初めて気がついた。",
        "message": "被她这么一说我才发现。",
        "text_idx": [
            9933
        ]
    },
    {
        "ori": "ベンチの真ん中に俺が座らせられたせいで、此ノ花さんと穂高を左右に座らせることになっちまった。",
        "message": "都怪我被安排坐在长椅中间，结果就让此之花同学和穗高坐在了我的左右两边。",
        "text_idx": [
            9948,
            9949
        ]
    },
    {
        "name": "亮",
        "name_idx": 9955,
        "ori": "「これこそはかったな！　だろ！」",
        "message": "「你这是故意的吧！　对吧！」",
        "text_idx": [
            9964
        ]
    },
    {
        "name": "円",
        "name_idx": 10028,
        "ori": "「わっちはたばかってはおりませんぜ～」",
        "message": "「人家可没有算计你哦～」",
        "text_idx": [
            10037
        ]
    },
    {
        "name": "円",
        "name_idx": 10101,
        "ori": "「そもそも、美女二人と屋上で青春チックにご飯を食べる事を了承したのは他でもない小松原くんよ」",
        "message": "「再说了，答应和两位美少女在天台共享青春午餐的人，不就是小松原同学你本人吗」",
        "text_idx": [
            10110,
            10111
        ]
    },
    {
        "name": "蘭",
        "name_idx": 10175,
        "ori": "「そ、そうだねー」",
        "message": "「是、是啊—」",
        "text_idx": [
            10184
        ]
    },
    {
        "name": "亮",
        "name_idx": 10190,
        "ori": "「くっ……」",
        "message": "「唔……」",
        "text_idx": [
            10199
        ]
    },
    {
        "ori": "穂高までノッて来たか……",
        "message": "连穗高也跟着起哄了吗……",
        "text_idx": [
            10214
        ]
    },
    {
        "name": "円",
        "name_idx": 10278,
        "ori": "「まぁ、ここでごゆるりと、人もうらやむ青春を謳歌してくださいましぃ～っ！」",
        "message": "「好啦，就请在这里悠闲地，讴歌这令人艳羡的青春吧～！」",
        "text_idx": [
            10287,
            10288
        ]
    },
    {
        "ori": "逃がさないとでも言うかのように、此ノ花さんはガシッと俺の腕をつかんで、何事もないような様子でパンを食べていた。",
        "message": "此之花同学仿佛在说不会让我逃跑一样，紧紧地抓住了我的手臂，然后若无其事地吃起了面包。",
        "text_idx": [
            10357,
            10358,
            10359
        ]
    },
    {
        "ori": "それを見た穂高も、倣えとばかりに俺の腕をガシッとつかんで、ニンマリと笑って見せる。",
        "message": "看到这一幕的穗高，也像是要模仿她一样紧紧抓住了我的手臂，并朝我露出了得意的笑容。",
        "text_idx": [
            10472,
            10473
        ]
    },
    {
        "name": "亮",
        "name_idx": 10523,
        "ori": "「あの……さ……」",
        "message": "「那个……我说……」",
        "text_idx": [
            10532
        ]
    },
    {
        "name": "円＆蘭",
        "name_idx": 10640,
        "ori": "「なにかなぁ～？」",
        "message": "「什么事呀～？」",
        "text_idx": [
            10649
        ]
    },
    {
        "name": "亮",
        "name_idx": 10655,
        "ori": "「両手をつかまれたら、昼飯食べられないから……」",
        "message": "「两只手都被抓着，我没法吃午饭了啊……」",
        "text_idx": [
            10664
        ]
    },
    {
        "name": "円",
        "name_idx": 10728,
        "ori": "「もぅ。嬉しいくせに～」",
        "message": "「真是的。明明心里很高兴～」",
        "text_idx": [
            10737
        ]
    },
    {
        "name": "円",
        "name_idx": 10801,
        "ori": "「あ、分かった。食べさせて欲しいの？　あ～んって？」",
        "message": "「啊，我知道了。你是想让我喂你吗？　啊～嗯？」",
        "text_idx": [
            10810
        ]
    },
    {
        "name": "亮",
        "name_idx": 10816,
        "ori": "「い、いや！　そんなことはない！　おとなしく俺に昼飯を食べさせてくれ！！」",
        "message": "「不、不是！　才没那回事！　就让我老老实实地吃午饭吧！！」",
        "text_idx": [
            10825,
            10826
        ]
    },
    {
        "name": "円",
        "name_idx": 10890,
        "ori": "「ちぇっ、つまんないのぉ～」",
        "message": "「切，真没劲～」",
        "text_idx": [
            10899
        ]
    },
    {
        "name": "蘭",
        "name_idx": 10963,
        "ori": "「あんまりイジメちゃかわいそうだから、これくらいでリリースしてあげようよ」",
        "message": "「再欺负下去就太可怜了，就先到这里放了他吧」",
        "text_idx": [
            10972,
            10973
        ]
    },
    {
        "name": "円",
        "name_idx": 11037,
        "ori": "「そだね。あんまりいじると、死んじゃうし……」",
        "message": "「说得也是。再捉弄下去，他就要死了……」",
        "text_idx": [
            11046
        ]
    },
    {
        "ori": "俺は鑑賞用の魚とか虫なのかよ……",
        "message": "我成观赏用的鱼或者虫子了吗……",
        "text_idx": [
            11061
        ]
    },
    {
        "ori": "すぐに穂高と此ノ花さんは俺の手を放してくれたので、とりあえずきちんと昼飯を食べる事は出来るようになった。",
        "message": "穗高和此之花同学立刻放开了我的手，这下总算可以好好吃午饭了。",
        "text_idx": [
            11076,
            11077
        ]
    },
    {
        "name": "円",
        "name_idx": 11141,
        "ori": "「ところで小松原くんの絵ってさ、どういう時に、その絵のインスピレーションとかが浮かんでくるの？」",
        "message": "「对了，小松原同学。你画画的灵感，都是在什么时候冒出来的？」",
        "text_idx": [
            11150,
            11151
        ]
    },
    {
        "name": "亮",
        "name_idx": 11157,
        "ori": "「どういう時にって……」",
        "message": "「在什么时候啊……」",
        "text_idx": [
            11166
        ]
    },
    {
        "ori": "いきなり話の方向が切り替わり、俺は空を仰ぎ見ながら、改めて考えてみた。",
        "message": "话题突然转变，我仰望着天空，重新思索起来。",
        "text_idx": [
            11181,
            11182
        ]
    },
    {
        "ori": "考えてみると、今までキャンバスの前に立つだけで、描くべきものが浮かんできた気がする。",
        "message": "仔细想来，我感觉至今为止只要一站到画布前，该画的东西就会自然浮现在脑海里。",
        "text_idx": [
            11197,
            11198
        ]
    },
    {
        "name": "亮",
        "name_idx": 11204,
        "ori": "「あんまり……考えたこと……ないかな……」",
        "message": "「我没怎么……考虑过……吧……」",
        "text_idx": [
            11213
        ]
    },
    {
        "name": "円",
        "name_idx": 11233,
        "ori": "「なにも考えずに、あんな絵を描いてきたの？」",
        "message": "「你什么都不想，就画出了那样的画？」",
        "text_idx": [
            11242
        ]
    },
    {
        "name": "亮",
        "name_idx": 11248,
        "ori": "「なにも考えずにっていうのは……語弊があるかなぁ」",
        "message": "「说「什么都没想」……可能会引起误会吧」",
        "text_idx": [
            11257
        ]
    },
    {
        "ori": "考えていないわけじゃない。",
        "message": "我并不是没有在思考。",
        "text_idx": [
            11272
        ]
    },
    {
        "ori": "描くべきものが……すぐに見えただけだ。",
        "message": "只是该画的东西……马上就浮现在脑海里了。",
        "text_idx": [
            11287
        ]
    },
    {
        "name": "円",
        "name_idx": 11307,
        "ori": "「キャンバスに向かうと、頭にパパッてその情景が浮かび上がってきちゃう感じ？」",
        "message": "「一到画布前，脑海里就会啪地一下浮现出那个场景，是这种感觉？」",
        "text_idx": [
            11316,
            11317
        ]
    },
    {
        "name": "亮",
        "name_idx": 11323,
        "ori": "「そんな……感じかなぁ……」",
        "message": "「差不多……就是那种感觉吧……」",
        "text_idx": [
            11332
        ]
    },
    {
        "ori": "だけど、今の俺の絵は……そんな感じじゃない。",
        "message": "但是，我现在画的画……就不是那种感觉了。",
        "text_idx": [
            11347
        ]
    },
    {
        "ori": "此ノ花さんに言われて気づいたけど、今描いているものはそんな風に閃いて描いたものじゃない。",
        "message": "被此之花小姐提醒我才发现，我现在画的东西并不是靠那种灵感一闪画出来的。",
        "text_idx": [
            11362,
            11363
        ]
    },
    {
        "ori": "だから……ちょっとつまり気味なのか？",
        "message": "所以……我才有点陷入瓶颈了吗？",
        "text_idx": [
            11378
        ]
    },
    {
        "name": "円",
        "name_idx": 11442,
        "ori": "「人物とかって描かないよね？」",
        "message": "「你不画人物之类的吗？」",
        "text_idx": [
            11451
        ]
    },
    {
        "name": "亮",
        "name_idx": 11457,
        "ori": "「あんまり……得意じゃない」",
        "message": "「不怎么……擅长」",
        "text_idx": [
            11466
        ]
    },
    {
        "name": "円",
        "name_idx": 11530,
        "ori": "「描いたら、おもしろそうなんだけどなぁ……」",
        "message": "「我觉得你要是画的话，应该会很有趣呢……」",
        "text_idx": [
            11539
        ]
    },
    {
        "name": "亮",
        "name_idx": 11545,
        "ori": "「なんで？」",
        "message": "「为什么？」",
        "text_idx": [
            11554
        ]
    },
    {
        "name": "円",
        "name_idx": 11618,
        "ori": "「小松原くんの内面が表われそうで……なんてね」",
        "message": "「因为感觉能展现出小松原同学的内心……开玩笑的啦」",
        "text_idx": [
            11627
        ]
    },
    {
        "name": "亮",
        "name_idx": 11677,
        "ori": "「………………」",
        "message": "「………………」",
        "text_idx": [
            11686
        ]
    },
    {
        "name": "蘭",
        "name_idx": 11750,
        "ori": "「小松原くんは、風景専門の絵描きさんになりたいの？」",
        "message": "「小松原同学，你是想成为专画风景的画家吗？」",
        "text_idx": [
            11759
        ]
    },
    {
        "name": "亮",
        "name_idx": 11765,
        "ori": "「いや……まだ、そこまでは……」",
        "message": "「不……还没考虑到那一步……」",
        "text_idx": [
            11774
        ]
    },
    {
        "name": "蘭",
        "name_idx": 11794,
        "ori": "「そうなんだ」",
        "message": "「是这样啊」",
        "text_idx": [
            11803
        ]
    },
    {
        "name": "亮",
        "name_idx": 11809,
        "ori": "「此ノ花さんは、演技する時にどんなことを気遣う？」",
        "message": "「此之花同学，你演戏的时候会注意些什么？」",
        "text_idx": [
            11818
        ]
    },
    {
        "name": "円",
        "name_idx": 11882,
        "ori": "「ボク？」",
        "message": "「我？」",
        "text_idx": [
            11891
        ]
    },
    {
        "name": "円",
        "name_idx": 11911,
        "ori": "「その人の内面をどこまで表現出来るかかな？」",
        "message": "「能将那个人的内心表现到何种程度吧？」",
        "text_idx": [
            11920
        ]
    },
    {
        "name": "円",
        "name_idx": 11984,
        "ori": "「なんてことを言っちゃったりするけど、ボクも直感で演技する方かなぁ」",
        "message": "「虽然嘴上这么说，但我也是凭直觉演戏的类型吧」",
        "text_idx": [
            11993,
            11994
        ]
    },
    {
        "name": "亮",
        "name_idx": 12000,
        "ori": "「直感で……演技？」",
        "message": "「凭直觉……演戏？」",
        "text_idx": [
            12009
        ]
    },
    {
        "name": "円",
        "name_idx": 12073,
        "ori": "「その役になりきろうって考えて台本を読むと、その役の気持ちとかが分かっちゃうの」",
        "message": "「只要想着要完全代入那个角色去读剧本，自然就能明白那个角色的心情了」",
        "text_idx": [
            12082,
            12083
        ]
    },
    {
        "name": "蘭",
        "name_idx": 12147,
        "ori": "「円は……大女優だからなぁ……」",
        "message": "「圆……毕竟是大牌女演员嘛……」",
        "text_idx": [
            12156
        ]
    },
    {
        "name": "円",
        "name_idx": 12220,
        "ori": "「あらあら、そんなことはありませんでしてよ？　オホホホホホ」",
        "message": "「哎呀哎呀，哪有这回事呀？　哦呵呵呵呵呵呵」",
        "text_idx": [
            12229,
            12230
        ]
    },
    {
        "name": "亮",
        "name_idx": 12236,
        "ori": "「そっか……此ノ花さんは演技得意なんだ」",
        "message": "「这样啊……此之花同学很擅长演戏呢」",
        "text_idx": [
            12245
        ]
    },
    {
        "ori": "そう言った瞬間、一瞬、此ノ花さんの顔色が翳った。",
        "message": "就在我这么说的瞬间，此之花同学的脸色一下子黯淡了下来。",
        "text_idx": [
            12347
        ]
    },
    {
        "ori": "なにかドキッとしたかのように……まっすぐに真顔で俺を見て……",
        "message": "她仿佛受了什么惊吓一般……板着脸直直地看着我……",
        "text_idx": [
            12362,
            12363
        ]
    },
    {
        "ori": "すぐに、また笑顔に戻ったけど……",
        "message": "虽然她马上又变回了笑容……",
        "text_idx": [
            12465
        ]
    },
    {
        "name": "円",
        "name_idx": 12529,
        "ori": "「そう。演技派なの！　あははははは」",
        "message": "「没错。我可是实力派哦！　啊哈哈哈哈哈」",
        "text_idx": [
            12538
        ]
    },
    {
        "ori": "なにかマズイことを言ったんだろうか？",
        "message": "我是说了什么不该说的话吗？",
        "text_idx": [
            12553
        ]
    },
    {
        "ori": "ドコかぎこちないような違和感が、此ノ花さんの表情から感じ取れた。",
        "message": "我从此之花同学的表情里感受到了一丝不自然的僵硬。",
        "text_idx": [
            12568,
            12569
        ]
    },
    {
        "name": "円",
        "name_idx": 12633,
        "ori": "「将来は大女優でハリウッドに行っちゃうんだから！」",
        "message": "「将来我可是要成为大明星去好莱坞的！」",
        "text_idx": [
            12642
        ]
    },
    {
        "name": "蘭",
        "name_idx": 12706,
        "ori": "「まぁ、円ならそれも出来るかも……ボクはなぁ……」",
        "message": "「嘛，如果是圆的话，说不定真能做到……我嘛……」",
        "text_idx": [
            12715
        ]
    },
    {
        "name": "円",
        "name_idx": 12735,
        "ori": "「大丈夫！　あきらめなければ道は開く！」",
        "message": "「没问题的！　只要不放弃，道路就会敞开！」",
        "text_idx": [
            12744
        ]
    },
    {
        "name": "円",
        "name_idx": 12808,
        "ori": "「ホラホラ、あきらめたらそこで終わりですよ……って名言を思い出してよ」",
        "message": "「喂喂，快想起那句名言啊‘放弃的话就到此为止了哦’」",
        "text_idx": [
            12817,
            12818
        ]
    },
    {
        "name": "蘭",
        "name_idx": 12882,
        "ori": "「そ、そうだよね」",
        "message": "「说、说的也是呢」",
        "text_idx": [
            12891
        ]
    },
    {
        "name": "円",
        "name_idx": 12955,
        "ori": "「でも、芸術祭の賞はボクらがもらっちゃうんだからね」",
        "message": "「但是，艺术节的奖我们可要拿下了哦」",
        "text_idx": [
            12964
        ]
    },
    {
        "name": "蘭",
        "name_idx": 13028,
        "ori": "「負けないもん！」",
        "message": "「我才不会输呢！」",
        "text_idx": [
            13037
        ]
    },
    {
        "ori": "なんだか……",
        "message": "总觉得……",
        "text_idx": [
            13052
        ]
    },
    {
        "ori": "なにかを誤魔化されたような気がするのは気のせいだろうか？",
        "message": "总感觉有什么被搪塞过去了，是我的错觉吗？",
        "text_idx": [
            13067,
            13068
        ]
    },
    {
        "ori": "なにか触れてはいけない部分に触れてしまった……",
        "message": "我好像触碰到了什么不该触碰的部分……",
        "text_idx": [
            13083
        ]
    },
    {
        "ori": "それがなんなのか分からないまま、俺は芸術祭の演劇賞の行方について話し合う二人の会話をずっと聞き続けていた。",
        "message": "我就这么不明所以地，一直听着那两人讨论艺术节戏剧奖的归属问题。",
        "text_idx": [
            13098,
            13099,
            13100
        ]
    }
]