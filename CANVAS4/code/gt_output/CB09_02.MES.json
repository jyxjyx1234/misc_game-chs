[
    {
        "ori": "相変わらず、遅い時間までさつきはキャンバスの前にいた。",
        "message": "和往常一样，纱月直到很晚都待在画布前。",
        "text_idx": [
            93,
            94
        ]
    },
    {
        "ori": "２つのキャンバスを並べて、同時進行で絵を描いている。",
        "message": "她并排摆着两块画布，同时进行着绘画。",
        "text_idx": [
            109
        ]
    },
    {
        "ori": "ひとつは農村風景、ひとつは現代美術というのだろうか？昔、課題で描いた『色立体』みたいな原色の抽象物が描かれている。",
        "message": "一幅是农村风景，另一幅该说是现代美术吗？上面画着像是以前我为了课题画过的『色立体』那样的原色抽象物体。",
        "text_idx": [
            124,
            125,
            126
        ]
    },
    {
        "ori": "無言でひたすらに描いているさつき、でも筆先は鈍い。",
        "message": "纱月沉默地专心作画，但她的笔尖却很迟钝。",
        "text_idx": [
            141
        ]
    },
    {
        "ori": "声をかけようにも、その必死な表情に声をかけられない。",
        "message": "就算我想和她搭话，看到她那拼命的表情也开不了口。",
        "text_idx": [
            156
        ]
    },
    {
        "ori": "今にも崩れ落ちそうな、そんな脆ささえさつきに感じる。",
        "message": "我甚至从纱月身上感受到了一种仿佛随时都会崩溃的脆弱。",
        "text_idx": [
            171
        ]
    },
    {
        "name": "みつば",
        "name_idx": 411,
        "ori": "「おねえちゃんを……助けて」",
        "message": "「救救……姐姐」",
        "text_idx": [
            420
        ]
    },
    {
        "ori": "みつばちゃんの願いは……切実だった。俺に出来ることは……",
        "message": "三叶的愿望……是那么恳切。我能做的事情是……",
        "text_idx": [
            435,
            436
        ]
    },
    {
        "ori": "完全下校のチャイムが鳴る。窓の外は、もう暗かった……",
        "message": "清校铃声响了起来。窗外，已经一片漆黑了……",
        "text_idx": [
            493,
            494
        ]
    },
    {
        "name": "亮",
        "name_idx": 500,
        "ori": "「……今日は、バイトは？」",
        "message": "「……今天，不去打工吗？」",
        "text_idx": [
            509
        ]
    },
    {
        "name": "さつき",
        "name_idx": 573,
        "ori": "「うん……」",
        "message": "「嗯……」",
        "text_idx": [
            582
        ]
    },
    {
        "ori": "言葉少なに、さつきはあっさりと筆を置き、帰り支度をはじめた。",
        "message": "纱月没说几句话，便干脆地放下了画笔，开始准备回家。",
        "text_idx": [
            783,
            784
        ]
    },
    {
        "name": "亮",
        "name_idx": 790,
        "ori": "「送ってくよ……」",
        "message": "「我送你吧……」",
        "text_idx": [
            799
        ]
    },
    {
        "name": "さつき",
        "name_idx": 863,
        "ori": "「うん……ありがとう」",
        "message": "「嗯……谢谢你」",
        "text_idx": [
            872
        ]
    },
    {
        "ori": "さつきは無理をして微笑んだのだろう……でも俺には、その微笑みでさえも、まるで泣いているかのように感じた。",
        "message": "纱月是在强颜欢笑吧……但在我看来，就连那笑容，都仿佛像是在哭泣。",
        "text_idx": [
            887,
            888
        ]
    },
    {
        "ori": "あの、迷いの無かったさつきが……",
        "message": "那个曾经毫无迷茫的纱月……",
        "text_idx": [
            903
        ]
    }
]