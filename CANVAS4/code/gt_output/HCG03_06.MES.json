        ]
    },
    {
        "name": "蘭",
        "name_idx": 2282,
        "ori": "「ああっ、だめッ……壊れちゃうよ……！」",
        "message": "「啊啊、不行……要坏掉了……！」",
        "text_idx": [
            2291
        ]
    },
    {
        "ori": "何も考えられなくなっていく。",
        "message": "我渐渐什么都无法思考了。",
        "text_idx": [
            2306
        ]
    },
    {
        "name": "蘭",
        "name_idx": 2326,
        "ori": "「うぅっあ……あ、ああっ……あぁあっ！」",
        "message": "「呜啊……啊、啊啊……啊啊啊！」",
        "text_idx": [
            2335
        ]
    },
    {
        "ori": "蘭が身体をよじり始める。",
        "message": "兰开始扭动起身体。",
        "text_idx": [
            2350
        ]
    },
    {
        "ori": "足も強く閉じようとしてくるので、力一杯に押さえ付けて力を入れて刺激し続けた。　",
        "message": "她的双腿也想用力合拢，所以我用尽全力按住它们，并继续用力刺激着。　",
        "text_idx": [
            2365,
            2366
        ]
    },
    {
        "name": "蘭",
        "name_idx": 2386,
        "ori": "「あ、ああッ……だ、だめっ、やめ……あぅあぁッ……」",
        "message": "「啊、啊啊……不、不行、住手……啊啊啊……」",
        "text_idx": [
            2395
        ]
    },
    {
        "name": "亮",
        "name_idx": 2401,
        "ori": "「んんッ！」",
        "message": "「唔唔！」",
        "text_idx": [
            2410
        ]
    },
    {
        "name": "蘭",
        "name_idx": 2430,
        "ori": "「ぁあ……こ、壊れたうぁ、あ、あっ……」",
        "message": "「啊啊……要、要坏掉了啊、啊、啊……」",
        "text_idx": [
            2439
        ]
    },
    {
        "name": "蘭",
        "name_idx": 2459,
        "ori": "「ひぅッ……りりょうや、やめへっ……ああぁあっ……」",
        "message": "「呜……亮、亮，住手……啊啊啊……」",
        "text_idx": [
            2468
        ]
    },
    {
        "ori": "蘭の身体が震え始めて、さらに強く身をよじり始めた。",
        "message": "兰的身体开始颤抖，并更加猛烈地扭动起来。",
        "text_idx": [
            2483
        ]
    },
    {
        "name": "蘭",
        "name_idx": 2503,
        "ori": "「て、てをとめっ、とめて……あっああッ……！」",
        "message": "「手、手停下、停下来……啊啊啊……！」",
        "text_idx": [
            2512
        ]
    },
    {
        "name": "亮",
        "name_idx": 2518,
        "ori": "「らんッ！」",
        "message": "「兰！」",
        "text_idx": [
            2527
        ]
    },
    {
        "name": "蘭",
        "name_idx": 2547,
        "ori": "「ここわれちゃう、コワれたう……ああ、あぁッ……ああッ」",
        "message": "「这里要坏掉了、要坏掉了……啊啊、啊啊……啊啊」",
        "text_idx": [
            2556,
            2557
        ]
    },
    {
        "name": "蘭",
        "name_idx": 2577,
        "ori": "「あッあ……だ、だめ、ああも、もう……あぅぁあッ……！！」",
        "message": "「啊啊……不、不行，啊啊已经……啊啊啊……！！」",
        "text_idx": [
            2586,
            2587
        ]
    },
    {
        "name": "蘭",
        "name_idx": 2607,
        "ori": "「……ぃやぁあっ、ああああああああああ～！！」",
        "message": "「……呀啊啊、啊啊啊啊啊啊啊啊啊～！！」",
        "text_idx": [
            2616
        ]
    },
    {
        "ori": "大きく捻った蘭の身体がビクンと跳ね上がった。",
        "message": "兰大幅度扭动的身体，猛地向上弹起。",
        "text_idx": [
            2850
        ]
    },
    {
        "name": "蘭",
        "name_idx": 2914,
        "ori": "「ぁあ……ぁあ……あ、ああ……」",
        "message": "「啊啊……啊啊……啊、啊啊……」",
        "text_idx": [
            2923
        ]
    },
    {
        "ori": "放心したような顔で、蘭の身体はビクンビクンと痙攣する。",
        "message": "兰脸上露出了失神的表情，身体一阵阵地痉挛着。",
        "text_idx": [
            2938,
            2939
        ]
    },
    {
        "ori": "指を抜くととろりと濃厚な液が纏わりついてきた。",
        "message": "我抽出手指，上面缠绕着粘稠的液体。",
        "text_idx": [
            2954
        ]
    },
    {
        "name": "蘭",
        "name_idx": 2974,
        "ori": "「……はぁはぁ……ぁあ……はぁはぁ……」",
        "message": "「……哈啊哈啊……啊啊……哈啊哈啊……」",
        "text_idx": [
            2983
        ]
    },
    {
        "ori": "蘭は何も考えられないといった表情で遠くを見ている。",
        "message": "兰带着一副什么都无法思考的表情，凝视着远方。",
        "text_idx": [
            2998
        ]
    },
    {
        "name": "亮",
        "name_idx": 3004,
        "ori": "「蘭……」",
        "message": "「兰……」",
        "text_idx": [
            3013
        ]
    },
    {
        "name": "蘭",
        "name_idx": 3033,
        "ori": "「はぁ、はぁ……あ、ぁ」",
        "message": "「哈啊，哈啊……啊、啊」",
        "text_idx": [
            3042
        ]
    },
    {
        "ori": "蘭の震える身体を優しく撫でる。",
        "message": "我温柔地抚摸着兰颤抖的身体。",
        "text_idx": [
            3057
        ]
    },
    {
        "name": "蘭",
        "name_idx": 3121,
        "ori": "「はぁはぁ……りょう……」",
        "message": "「哈啊哈啊……亮……」",
        "text_idx": [
            3130
        ]
    },
    {
        "ori": "蘭はトロンとした顔で微笑んでくる。",
        "message": "兰带着迷离的表情朝我微笑。",
        "text_idx": [
            3145
        ]
    },
    {
        "name": "亮",
        "name_idx": 3151,
        "ori": "「気持ち良かった？」",
        "message": "「舒服吗？」",
        "text_idx": [
            3160
        ]
    },
    {
        "name": "蘭",
        "name_idx": 3180,
        "ori": "「う、うん……」",
        "message": "「唔、嗯……」",
        "text_idx": [
            3189
        ]
    },
    {
        "name": "亮",
        "name_idx": 3195,
        "ori": "「それはよかった」",
        "message": "「那就好」",
        "text_idx": [
            3204
        ]
    },
    {
        "name": "蘭",
        "name_idx": 3224,
        "ori": "「……ねぇ、りょう」",
        "message": "「……那个，亮」",
        "text_idx": [
            3233
        ]
    },
    {
        "name": "亮",
        "name_idx": 3239,
        "ori": "「ん？」",
        "message": "「嗯？」",
        "text_idx": [
            3248
        ]
    },
    {
        "ori": "蘭は俺のズボンに目を向けて、物欲しげな顔をしてくる。",
        "message": "兰将目光投向我的裤子，露出一副欲求不满的表情。",
        "text_idx": [
            3263
        ]
    },
    {
        "ori": "ズボンは今、盛大に盛り上がって、少し染みを作っていた。",
        "message": "我的裤子现在正高高地鼓起，还弄出了一点湿痕。",
        "text_idx": [
            3278,
            3279
        ]
    },
    {
        "name": "蘭",
        "name_idx": 3299,
        "ori": "「りょうの、欲しい……」",
        "message": "「我想要，亮的……」",
        "text_idx": [
            3308
        ]
    },
    {
        "name": "亮",
        "name_idx": 3314,
        "ori": "「蘭……」",
        "message": "「兰……」",
        "text_idx": [
            3323
        ]
    },
    {
        "ori": "恍惚とした蘭に、さらにズボンの中が反応する。",
        "message": "看着神情恍惚的兰，我裤裆里的东西反应更加剧烈了。",
        "text_idx": [
            3338
        ]
    },
    {
        "name": "蘭",
        "name_idx": 3358,
        "ori": "「はぁはぁ……ボクの中に入れて」",
        "message": "「哈啊哈啊……把它放进我的身体里」",
        "text_idx": [
            3367
        ]
    },
    {
        "ori": "蘭は自分のぐじゅぐじゅになったそこに手を触れて、潤んだ目で見てきた。",
        "message": "兰触摸着自己变得湿漉漉的私处，用湿润的眼睛看着我。",
        "text_idx": [
            3382,
            3383
        ]
    },
    {
        "name": "蘭",
        "name_idx": 3403,
        "ori": "「ボクを、女にして……」",
        "message": "「把我，变成女人吧……」",
        "text_idx": [
            3412
        ]
    },
    {
        "ori": "その誘惑の瞳に魅了されるように服を一気に脱ぎ捨てる。",
        "message": "我仿佛被她那诱惑的眼神所吸引，一口气脱光了衣服。",
        "text_idx": [
            3427
        ]
    },
    {
        "ori": "押さえをなくしたそれは心臓の鼓動に合わせるようにびくんびくんと脈打つ。",
        "message": "失去了束缚的那话儿，仿佛在配合着我的心跳般，一跳一跳地搏动着。",
        "text_idx": [
            3442,
            3443
        ]
    },
    {
        "ori": "そして、納める所を求めさ迷う妖刀のように熱を纏う。",
        "message": "然后，它就像一把寻求刀鞘的妖刀一般，散发着灼人的热量。",
        "text_idx": [
            3458
        ]
    },
    {
        "name": "蘭",
        "name_idx": 3478,
        "ori": "「りょうの……大きい」",
        "message": "「亮的……好大」",
        "text_idx": [
            3487
        ]
    },
    {
        "name": "亮",
        "name_idx": 3493,
        "ori": "「蘭のせいだよ」",
        "message": "「这都是兰你的错哦」",
        "text_idx": [
            3502
        ]
    },
    {
        "name": "蘭",
        "name_idx": 3522,
        "ori": "「……嬉しいよ」",
        "message": "「……我好高兴哦」",
        "text_idx": [
            3531
        ]
    },
    {
        "ori": "蘭が嬉しそうに笑う。",
        "message": "兰开心地笑了起来。",
        "text_idx": [
            3546
        ]
    },
    {
        "name": "蘭",
        "name_idx": 3566,
        "ori": "「ボクの身体でそんなになってくれて……」",
        "message": "「你能因为我的身体变成这样……」",
        "text_idx": [
            3575
        ]
    },
    {
        "ori": "幸せそうに微笑む蘭に身体が熱くなって、下はさらに熱がこもった。",
        "message": "看着幸福地微笑着的兰，我的身体也热了起来，下身更是热得发烫。",
        "text_idx": [
            3590,
            3591
        ]
    },
    {
        "ori": "蘭にゆっくり近づく。",
        "message": "我缓缓地向兰靠近。",
        "text_idx": [
            3797
        ]
    },
    {
        "ori": "そして、蘭のしなやかな足に触れ、持ち上げた。",
        "message": "然后，我触摸着兰那柔软的双腿，将它们抬了起来。",
        "text_idx": [
            3812
        ]
    },
    {
        "ori": "蘭の入り口があられもなく晒され、そこに早く入れたいと身体全体がうずいた。",
        "message": "兰的入口毫无遮拦地暴露了出来，想要快点进去的欲望让我全身都骚动了起来。",
        "text_idx": [
            4244,
            4245
        ]
    },
    {
        "name": "蘭",
        "name_idx": 4265,
        "ori": "「……」",
        "message": "「……」",
        "text_idx": [
            4274
        ]
    },
    {
        "ori": "蘭の顔を見ると、少し不安げな表情がチラついていた。",
        "message": "我看向兰的脸，发现她的表情中闪过一丝不安。",
        "text_idx": [
            4289
        ]
    },
    {
        "name": "亮",
        "name_idx": 4295,
        "ori": "「蘭、大丈夫？」",
        "message": "「兰，你没事吧？」",
        "text_idx": [
            4304
        ]
    },
    {
        "name": "蘭",
        "name_idx": 4324,
        "ori": "「ほんのちょっとだけ、怖いな……」",
        "message": "「只是有点害怕……」",
        "text_idx": [
            4333
        ]
    },
    {
        "name": "亮",
        "name_idx": 4339,
        "ori": "「俺もちょっと怖いよ」",
        "message": "「我也有些害怕」",
        "text_idx": [
            4348
        ]
    },
    {
        "ori": "不安そうな顔をする蘭の頭を撫でて、キスをする。",
        "message": "我抚摸着表情不安的兰的头，然后吻了她。",
        "text_idx": [
            4363
        ]
    },
    {
        "name": "亮",
        "name_idx": 4369,
        "ori": "「俺頑張るから、一緒に気持ち良くなろう？」",
        "message": "「我会努力的，我们一起变得舒服吧？」",
        "text_idx": [
            4378
        ]
    },
    {
        "name": "蘭",
        "name_idx": 4398,
        "ori": "「……うん」",
        "message": "「……嗯」",
        "text_idx": [
            4407
        ]
    },
    {
        "name": "亮",
        "name_idx": 4413,
        "ori": "「入れるよ……」",
        "message": "「我要进去了哦……」",
        "text_idx": [
            4422
        ]
    },
    {
        "name": "蘭",
        "name_idx": 4442,
        "ori": "「うん……」",
        "message": "「嗯……」",
        "text_idx": [
            4451
        ]
    },
    {
        "ori": "熱いそれを蘭の入り口へ持っていく。",
        "message": "我将滚烫的它带到兰的入口处。",
        "text_idx": [
            4466
        ]
    },
    {
        "ori": "ドキドキと緊張する。",
        "message": "我紧张得心脏怦怦直跳。",
        "text_idx": [
            4481
        ]
    },
    {
        "name": "蘭",
        "name_idx": 4501,
        "ori": "「は、入るかな……」",
        "message": "「啊，能进去吗……」",
        "text_idx": [
            4510
        ]
    },
    {
        "name": "亮",
        "name_idx": 4516,
        "ori": "「たぶん」",
        "message": "「大概吧」",
        "text_idx": [
            4525
        ]
    },
    {
        "ori": "蘭のそこに先端が触れる。",
        "message": "我的前端触碰到了兰的那里。",
        "text_idx": [
            4540
        ]
    },
    {
        "name": "蘭",
        "name_idx": 4560,
        "ori": "「ああぅ……」",
        "message": "「啊呜……」",
        "text_idx": [
            4569
        ]
    },
    {
        "name": "亮",
        "name_idx": 4575,
        "ori": "「ん……」",
        "message": "「嗯……」",
        "text_idx": [
            4584
        ]
    },
    {
        "ori": "先端がぐぐっと入っていくが、途中で、愛液に滑って外に出てしまった。",
        "message": "我的前端用力地挤了进去，但在途中，因为爱液滑了出来。",
        "text_idx": [
            4599,
            4600
        ]
    },
    {
        "name": "蘭",
        "name_idx": 4620,
        "ori": "「あぁっ……」",
        "message": "「啊啊……」",
        "text_idx": [
            4629
        ]
    },
    {
        "name": "亮",
        "name_idx": 4635,
        "ori": "「ごめん、もう一度」",
        "message": "「抱歉，再来一次」",
        "text_idx": [
            4644
        ]
    },
    {
        "ori": "しっかり手で握って入り口へ持っていく。",
        "message": "我用手紧紧握住它，对准入口处。",
        "text_idx": [
            4659
        ]
    },
    {
        "name": "蘭",
        "name_idx": 4679,
        "ori": "「ああぁ、あ……」",
        "message": "「啊啊、啊……」",
        "text_idx": [
            4688
        ]
    },
    {
        "ori": "先端が触れ、少し入る。",
        "message": "前端触碰到后，稍微进去了一点。",
        "text_idx": [
            4703
        ]
    },
    {
        "name": "亮",
        "name_idx": 4709,
        "ori": "「んん……」",
        "message": "「唔嗯……」",
        "text_idx": [
            4718
        ]
    },
    {
        "name": "蘭",
        "name_idx": 4738,
        "ori": "「ぁあ、あっ……」",
        "message": "「啊啊、啊……」",
        "text_idx": [
            4747
        ]
    },
    {
        "ori": "今度はちゃんと入るように上下左右に動かす。",
        "message": "为了这次能顺利进去，我上下左右地动了动。",
        "text_idx": [
            4762
        ]
    },
    {
        "ori": "滑り出ない事の確認ができ、手に握るものに力を込めた。",
        "message": "在确认不会滑出来后，我加大了手上的力道。",
        "text_idx": [
            4777
        ]
    },
    {
        "name": "亮",
        "name_idx": 4783,
        "ori": "「いくよ……」",
        "message": "「我要进去了……」",
        "text_idx": [
            4792
        ]
    },
    {
        "name": "蘭",
        "name_idx": 5016,
        "ori": "「りょう……んっ」",
        "message": "「亮……嗯」",
        "text_idx": [
            5025
        ]
    },
    {
        "ori": "ぐぐっと蘭の中に入れていく。",
        "message": "我用力地将它挤进了兰的体内。",
        "text_idx": [
            5040
        ]
    },
    {
        "name": "蘭",
        "name_idx": 5060,
        "ori": "「んぁあっ……あ、ああ……あっ……」",
        "message": "「嗯啊……啊、啊啊……啊……」",
        "text_idx": [
            5069
        ]
    },
    {
        "name": "蘭",
        "name_idx": 5089,
        "ori": "「はぅ、あ……あぁ……」",
        "message": "「哈呜，啊……啊啊……」",
        "text_idx": [
            5098
        ]
    },
    {
        "ori": "少しずつ中へ中へ。",
        "message": "我一点一点地向里、向里深入。",
        "text_idx": [
            5113
        ]
    },
    {
        "name": "亮",
        "name_idx": 5119,
        "ori": "「んんッ……」",
        "message": "「唔嗯……」",
        "text_idx": [
            5128
        ]
    },
    {
        "name": "蘭",
        "name_idx": 5148,
        "ori": "「ぁあ……は、はいってくる……」",
        "message": "「啊啊……进、进来了……」",
        "text_idx": [
            5157
        ]
    },
    {
        "ori": "蘭の中は締め付けがよくて、手を添えてないと押し出されてしまいそうな排出感があった。",
        "message": "兰的体内很紧，要是不扶着手，就有一种快要被挤出来的感觉。",
        "text_idx": [
            5172,
            5173
        ]
    },
    {
        "name": "亮",
        "name_idx": 5179,
        "ori": "「も、もっと奥に入れるよ」",
        "message": "「我、我要进到更深处了」",
        "text_idx": [
            5188
        ]
    },
    {
        "name": "蘭",
        "name_idx": 5208,
        "ori": "「う、うん……」",
        "message": "「唔、嗯……」",
        "text_idx": [
            5217
        ]
    },
    {
        "ori": "蘭は不安げに頷く。",
        "message": "兰一脸不安地点了点头。",
        "text_idx": [
            5232
        ]
    },
    {
        "ori": "抜けないのを確認して、添えていた手を離した。",
        "message": "在确认不会滑出来后，我松开了扶着的手。",
        "text_idx": [
            5247
        ]
    },
    {
        "ori": "緊張する。",
        "message": "我好紧张。",
        "text_idx": [
            5262
        ]
    },
    {
        "ori": "蘭も緊張した顔でその時を待っている。",
        "message": "兰也一脸紧张地等待着那一刻。",
        "text_idx": [
            5277
        ]
    },
    {
        "name": "亮",
        "name_idx": 5283,
        "ori": "「いくよ」",
        "message": "「我要动了哦」",
        "text_idx": [
            5292
        ]
    },
    {
        "ori": "体重と勢いに任せて、一気に腰を突き出した。",
        "message": "我借着体重和惯性，一口气将腰向前挺出。",
        "text_idx": [
            5307
        ]
    },
    {
        "name": "蘭",
        "name_idx": 5371,
        "ori": "「ぅあぁああッ……！」",
        "message": "「呜啊啊啊……！」",
        "text_idx": [
            5380
        ]
    },
    {
        "name": "亮",
        "name_idx": 5386,
        "ori": "「んんんっ……！」",
        "message": "「嗯嗯嗯……！」",
        "text_idx": [
            5395
        ]
    },
    {
        "ori": "ぐぐぐっと押し込められたそれは、蘭の奥に奥に入っていく。",
        "message": "被我用力顶进去的那东西，不断深入到兰的体内深处。",
        "text_idx": [
            5410,
            5411
        ]
    },
    {
        "name": "蘭",
        "name_idx": 5431,
        "ori": "「ぅぁあ、ああぁ……あぁッ！」",
        "message": "「呜啊、啊啊……啊！」",
        "text_idx": [
            5440
        ]
    },
    {
        "ori": "そして永遠とも思える短い時間の末、根元まで蘭の中へ入った。",
        "message": "在经历了仿佛永恒般的短暂时间后，我终于尽根没入了兰的体内。",
        "text_idx": [
            5746,
            5747
        ]
    },
    {
        "ori": "ぴりぴりと頭の芯が痺れる。",
        "message": "我感到大脑深处一阵发麻。",
        "text_idx": [
            5762
        ]
    },
    {
        "ori": "膜を破った感覚は特に感じなかったが、蘭は顔を歪めていて、挿したところを見てみると赤い血が少し出ていた。",
        "message": "虽然我没怎么感觉到突破那层膜的触感，但兰的表情却因痛苦而扭曲，我低头看向结合处，发现有少许鲜血渗了出来。",
        "text_idx": [
            5777,
            5778
        ]
    },
    {
        "name": "亮",
        "name_idx": 5784,
        "ori": "「大丈夫？」",
        "message": "「没事吧？」",
        "text_idx": [
            5793
        ]
    },
    {
        "name": "蘭",
        "name_idx": 5929,
        "ori": "「う、うん……」",
        "message": "「唔、嗯……」",
        "text_idx": [
            5938
        ]
    },
    {
        "ori": "強がって微笑んでくる蘭は、それでもどこか幸せそうな顔をしていた。",
        "message": "强撑着对我微笑的兰，脸上却不知为何带着幸福的神色。",
        "text_idx": [
            5953,
            5954
        ]
    },
    {
        "name": "蘭",
        "name_idx": 5974,
        "ori": "「こ、これで……ひとつになれた」",
        "message": "「这、这样……我们就合为一体了」",
        "text_idx": [
            5983
        ]
    },
    {
        "name": "亮",
        "name_idx": 5989,
        "ori": "「ら、蘭……」",
        "message": "「兰、兰……」",
        "text_idx": [
            5998
        ]
    },
    {
        "name": "蘭",
        "name_idx": 6018,
        "ori": "「りょうと、ひとつになれて、嬉しい……」",
        "message": "「能和亮，合为一体，我好开心……」",
        "text_idx": [
            6027
        ]
    },
    {
        "name": "亮",
        "name_idx": 6033,
        "ori": "「俺も嬉しいよ」",
        "message": "「我也很开心哦」",
        "text_idx": [
            6042
        ]
    },
    {
        "ori": "そんな蘭を愛おしく感じて、ひとつになったまま口づけを交わす。",
        "message": "我感到这样的兰无比惹人怜爱，便在合为一体的状态下与她接吻。",
        "text_idx": [
            6057,
            6058
        ]
    },
    {
        "name": "蘭",
        "name_idx": 6229,
        "ori": "「ぼ、ボクの中……どうかな？」",
        "message": "「我、我的里面……感觉怎么样？」",
        "text_idx": [
            6238
        ]
    },
    {
        "name": "亮",
        "name_idx": 6244,
        "ori": "「温かくて、柔らかくて……とても気持ちいいよ」",
        "message": "「很温暖，很柔软……非常舒服哦」",
        "text_idx": [
            6253
        ]
    },
    {
        "name": "蘭",
        "name_idx": 6273,
        "ori": "「よ、よかった……」",
        "message": "「太、太好了……」",
        "text_idx": [
            6282
        ]
    },
    {
        "ori": "蘭は安心した顔をする。",
        "message": "兰露出了安心的表情。",
        "text_idx": [
            6297
        ]
    },
    {
        "name": "蘭",
        "name_idx": 6317,
        "ori": "「りょう……も、もっとボクの中で気持ちよくなって」",
        "message": "「亮……也、也要……在我的身体里……变得更舒服一点……」",
        "text_idx": [
            6326
        ]
    },
    {
        "name": "亮",
        "name_idx": 6332,
        "ori": "「ありがとう」",
        "message": "「谢谢你」",
        "text_idx": [
            6341
        ]
    },
    {
        "ori": "蘭の頭を優しく撫でる。",
        "message": "我温柔地抚摸着兰的头。",
        "text_idx": [
            6356
        ]
    },
    {
        "ori": "そんな蘭をとてもとても愛おしく感じて、耳元で囁いた。",
        "message": "我觉得这样的兰是如此、如此地惹人怜爱，便在她耳边低语道。",
        "text_idx": [
            6371
        ]
    },
    {
        "name": "亮",
        "name_idx": 6377,
        "ori": "「蘭、好きだよ」",
        "message": "「兰，我喜欢你」",
        "text_idx": [
            6386
        ]
    },
    {
        "name": "蘭",
        "name_idx": 6406,
        "ori": "「……う、嬉しい……嬉しいよ、りょう」",
        "message": "「……呜、我好高兴……我真的好高兴啊，亮」",
        "text_idx": [
            6415
        ]
    },
    {
        "ori": "蘭は本当に嬉しそうな顔をする。",
        "message": "兰露出了发自内心喜悦的表情。",
        "text_idx": [
            6430
        ]
    },
    {
        "ori": "そして、微笑んだまま涙ぐみ始めた。",
        "message": "接着，她脸上还带着微笑，眼眶却开始湿润了。",
        "text_idx": [
            6445
        ]
    },
    {
        "name": "亮",
        "name_idx": 6451,
        "ori": "「蘭？」",
        "message": "「兰？」",
        "text_idx": [
            6460
        ]
    },
    {
        "name": "蘭",
        "name_idx": 6480,
        "ori": "「りょう、ボクのこと、は、初めて好きって、言ってくれた……！」",
        "message": "「亮，你是第一次、说喜欢我……！」",
        "text_idx": [
            6489,
            6490
        ]
    },
    {
        "name": "亮",
        "name_idx": 6496,
        "ori": "「あれ、そうだったっけ？」",
        "message": "「啊咧，是这样吗？」",
        "text_idx": [
            6505
        ]
    },
    {
        "name": "蘭",
        "name_idx": 6525,
        "ori": "「そうだよ」",
        "message": "「是啊」",
        "text_idx": [
            6534
        ]
    },
    {
        "ori": "少しすねた顔をしてくる蘭。",
        "message": "兰露出了有些闹别扭的表情。",
        "text_idx": [
            6549
        ]
    },
    {
        "ori": "それでも、すぐにその表情を崩して、艶っぽい笑みを浮かべてきた。",
        "message": "但她很快就收起了那副表情，转而对我露出了妩媚的微笑。",
        "text_idx": [
            6564,
            6565
        ]
    },
    {
        "name": "蘭",
        "name_idx": 6585,
        "ori": "「ボクも、亮のこと好きだよ。大好き」",
        "message": "「我也，喜欢亮哦。最喜欢你了」",
        "text_idx": [
            6594
        ]
    },
    {
        "name": "亮",
        "name_idx": 6600,
        "ori": "「蘭……」",
        "message": "「兰……」",
        "text_idx": [
            6609
        ]
    },
    {
        "ori": "蘭の髪を撫でて、頬を撫でる。",
        "message": "我抚摸着兰的头发，又抚摸着她的脸颊。",
        "text_idx": [
            6624
        ]
    },
    {
        "name": "蘭",
        "name_idx": 6644,
        "ori": "「だから、りょう、ボクの中で気持ち良くなって……」",
        "message": "「所以，亮，在我的身体里舒服起来吧……」",
        "text_idx": [
            6653
        ]
    },
    {
        "name": "亮",
        "name_idx": 6659,
        "ori": "「……うん」",
        "message": "「……嗯」",
        "text_idx": [
            6668
        ]
    },
    {
        "ori": "口づけをもう一度交わして、ゆっくりと腰を動かした。",
        "message": "我与她再次接吻，缓缓地动起了腰。",
        "text_idx": [
            6683
        ]
    },
    {
        "name": "蘭",
        "name_idx": 6747,
        "ori": "「ぅあ、ああッ……」",
        "message": "「唔啊、啊啊……」",
        "text_idx": [
            6756
        ]
    },
    {
        "ori": "柔らかい蘭の中は、少し動かしただけでも痺れるような快感があった。",
        "message": "兰柔软的体内，哪怕只是稍微动一下，就传来一阵酥麻的快感。",
        "text_idx": [
            6771,
            6772
        ]
    },
    {
        "name": "蘭",
        "name_idx": 6792,
        "ori": "「うぅ……あ、ああ……ぁああ……」",
        "message": "「呜……啊、啊啊……啊啊……」",
        "text_idx": [
            6801
        ]
    },
    {
        "ori": "しかし、蘭が痛そうな顔をするのでその快感に身を委ねるわけにはいかなかった。",
        "message": "但是，看到兰露出痛苦的表情，我便无法将自己沉浸在那份快感之中。",
        "text_idx": [
            6816,
            6817
        ]
    },
    {
        "name": "亮",
        "name_idx": 6823,
        "ori": "「蘭……」",
        "message": "「兰……」",
        "text_idx": [
            6832
        ]
    },
    {
        "name": "蘭",
        "name_idx": 6852,
        "ori": "「ぼ、ボクは、大丈夫だから……りょう、気持ち良くなって……んぅ」",
        "message": "「我、我没事的，所以……亮，你要舒服起来……嗯唔」",
        "text_idx": [
            6861,
            6862
        ]
    },
    {
        "name": "亮",
        "name_idx": 6868,
        "ori": "「んん……」",
        "message": "「唔嗯……」",
        "text_idx": [
            6877
        ]
    },
    {
        "ori": "蘭の方が動いてきて、腰が引けそうなほどの刺激が襲ってくる。",
        "message": "反倒是兰主动动了起来，一股几乎让我向后退缩的刺激袭来。",
        "text_idx": [
            6892,
            6893
        ]
    },
    {
        "name": "亮",
        "name_idx": 6899,
        "ori": "「蘭の中……ん、とても気持ちいいよ」",
        "message": "「兰的体内……嗯，非常舒服哦」",
        "text_idx": [
            6908
        ]
    },
    {
        "ori": "ゆっくりゆっくり。",
        "message": "慢慢地，慢慢地。",
        "text_idx": [
            6923
        ]
    },
    {
        "ori": "刺激と快感に押されるように腰が勝手に動いていく。",
        "message": "仿佛被刺激与快感推着一般，我的腰不受控制地动了起来。",
        "text_idx": [
            6938
        ]
    },
    {
        "name": "蘭",
        "name_idx": 6958,
        "ori": "「あぁッはぁあ……うぅぁ……」",
        "message": "「啊哈啊……呜啊……」",
        "text_idx": [
            6967
        ]
    },
    {
        "name": "亮",
        "name_idx": 6973,
        "ori": "「らん……」",
        "message": "「兰……」",
        "text_idx": [
            6982
        ]
    },
    {
        "ori": "上下する腰は別の生き物のよう。",
        "message": "上下耸动的腰仿佛是另一个生物。",
        "text_idx": [
            6997
        ]
    },
    {
        "ori": "刺激と快感に頭の中が白くぼやけていく。",
        "message": "在刺激与快感之中，我的脑海逐渐变得一片空白。",
        "text_idx": [
            7012
        ]
    },
    {
        "ori": "それはまるで、自分の中で目覚めた生き物に乗っ取られていくような感覚だった。",
        "message": "那感觉就仿佛是，我正在被自己体内觉醒的生物所占据一般。",
        "text_idx": [
            7027,
            7028
        ]
    },
    {
        "name": "蘭",
        "name_idx": 7048,
        "ori": "「ぅうッ……あふぁ……あぁっ、ああぁ」",
        "message": "「呜……啊哈……啊、啊啊」",
        "text_idx": [
            7057
        ]
    },
    {
        "name": "亮",
        "name_idx": 7063,
        "ori": "「んっん……」",
        "message": "「嗯嗯……」",
        "text_idx": [
            7072
        ]
    },
    {
        "ori": "どうしても、快感を求めて腰の動きを速めていってしまう。",
        "message": "为了追求快感，我的腰还是不由自主地加快了动作。",
        "text_idx": [
            7087,
            7088
        ]
    },
    {
        "name": "蘭",
        "name_idx": 7108,
        "ori": "「ぁあっ、あ……ぁあ……あぁ、ああ……」",
        "message": "「啊、啊……啊……啊、啊啊……」",
        "text_idx": [
            7117
        ]
    },
    {
        "ori": "それに合わせるように、蘭の中も徐々に熱を持ち始めて、先ほどよりも柔らかく、ぬるぬるになり始めた。",
        "message": "仿佛是为了迎合我的动作一般，兰的体内也渐渐开始发热，变得比刚才更加柔软、湿滑。",
        "text_idx": [
            7132,
            7133
        ]
    },
    {
        "name": "亮",
        "name_idx": 7139,
        "ori": "「ら、らん……」",
        "message": "「兰、兰……」",
        "text_idx": [
            7148
        ]
    },
    {
        "name": "蘭",
        "name_idx": 7168,
        "ori": "「あ、あ、ぁあ……はぁあっ……あぁ、あ」",
        "message": "「啊、啊、啊……哈啊……啊、啊」",
        "text_idx": [
            7177
        ]
    },
    {
        "name": "亮",
        "name_idx": 7183,
        "ori": "「ら、らんの中、とても気持ちイイ」",
        "message": "「兰、兰的里面，好舒服」",
        "text_idx": [
            7192
        ]
    },
    {
        "name": "蘭",
        "name_idx": 7212,
        "ori": "「あぁ、り、りょうああ、あ……あぁ……あああぁ」",
        "message": "「啊、亮、亮啊、啊……啊……啊啊」",
        "text_idx": [
            7221
        ]
    },
    {
        "ori": "蘭の中を上下していく度に快感が身体を支配する。",
        "message": "每一次在兰的体内上下抽送，快感便支配着我的身体。",
        "text_idx": [
            7236
        ]
    },
    {
        "name": "亮",
        "name_idx": 7242,
        "ori": "「んん、ん……」",
        "message": "「嗯嗯、嗯……」",
        "text_idx": [
            7251
        ]
    },
    {
        "name": "蘭",
        "name_idx": 7271,
        "ori": "「あぁ、ああぁは……んぁあ、あぁ」",
        "message": "「啊、啊啊哈……嗯啊、啊」",
        "text_idx": [
            7280
        ]
    },
    {
        "ori": "支配されていく身体はさらなる快感を求め、蘭をむさぼっていく。",
        "message": "我逐渐被快感支配的身体为了寻求更强烈的快感，贪婪地索求着兰。",
        "text_idx": [
            7295,
            7296
        ]
    },
    {
        "name": "蘭",
        "name_idx": 7316,
        "ori": "「あっぁあ、はぁあ……あぁ、あぁあ」",
        "message": "「啊啊、哈啊……啊、啊啊」",
        "text_idx": [
            7325
        ]
    },
    {
        "name": "亮",
        "name_idx": 7331,
        "ori": "「らん、ん……」",
        "message": "「兰、嗯……」",
        "text_idx": [
            7340
        ]
    },
    {
        "ori": "そしてさらに腰の動きは速さを増して、蘭を突き続けた。",
        "message": "我的腰部动作也随之加快，不断地贯穿着兰。",
        "text_idx": [
            7355
        ]
    },
    {
        "ori": "蘭の中が熱くなって、トロトロになっていくのを感じる。",
        "message": "我感觉到兰的体内变得滚烫，里面也变得湿滑泥泞。",
        "text_idx": [
            7370
        ]
    },
    {
        "name": "蘭",
        "name_idx": 7390,
        "ori": "「ぅあぁあ、っあはぁ……」",
        "message": "「呜啊啊、啊哈……」",
        "text_idx": [
            7399
        ]
    },
    {
        "name": "亮",
        "name_idx": 7405,
        "ori": "「らんのなか、いいよ」",
        "message": "「兰的里面，好舒服啊」",
        "text_idx": [
            7414
        ]
    },
    {
        "ori": "突けば突くほど濃厚な快感と刺激が溢れだしてきた。",
        "message": "每一次撞击，都涌出愈发浓厚的快感与刺激。",
        "text_idx": [
            7429
        ]
    }
]