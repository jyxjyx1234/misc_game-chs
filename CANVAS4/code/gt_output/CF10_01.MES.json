[
    {
        "ori": "新年早々、着る服を選別し、身だしなみを整えていた。",
        "message": "新年伊始，我挑选着要穿的衣服，整理着自己的仪容。",
        "text_idx": [
            90
        ]
    },
    {
        "ori": "まだかまだかと待ちわびて、何度も髪の毛をいじくる。",
        "message": "我焦急地等待着，心想怎么还没好，不停地拨弄着头发。",
        "text_idx": [
            105
        ]
    },
    {
        "ori": "ピーンポーン",
        "message": "叮咚",
        "text_idx": [
            134
        ]
    },
    {
        "name": "亮",
        "name_idx": 140,
        "ori": "「きた」",
        "message": "「来了」",
        "text_idx": [
            149
        ]
    },
    {
        "ori": "階段を駆け降りる。",
        "message": "我跑下楼梯。",
        "text_idx": [
            237
        ]
    },
    {
        "name": "ゆう子",
        "name_idx": 257,
        "ori": "「はーい」",
        "message": "「好——」",
        "text_idx": [
            266
        ]
    },
    {
        "ori": "俺が玄関にたどり着くよりも先に、母さんがドアを開けていた。",
        "message": "在我到达玄关前，妈妈已经打开了门。",
        "text_idx": [
            349,
            350
        ]
    },
    {
        "name": "紬",
        "name_idx": 570,
        "ori": "「あ、お母様、明けましておめでとうございます」",
        "message": "「啊，伯母，新年快乐」",
        "text_idx": [
            579
        ]
    },
    {
        "name": "ゆう子",
        "name_idx": 599,
        "ori": "「あら～、紬ちゃん！　明けましておめでとう」",
        "message": "「哎呀～，是小紬啊！新年快乐」",
        "text_idx": [
            608
        ]
    },
    {
        "name": "紬",
        "name_idx": 628,
        "ori": "「今年もよろしくお願いいたします」",
        "message": "「今年也请多多关照」",
        "text_idx": [
            637
        ]
    },
    {
        "name": "ゆう子",
        "name_idx": 657,
        "ori": "「こちらこそ。亮をよろしくしてあげてね」",
        "message": "「彼此彼此。我家亮就拜托你多关照啦」",
        "text_idx": [
            666
        ]
    },
    {
        "name": "紬",
        "name_idx": 686,
        "ori": "「はい、よろこんで」",
        "message": "「好的，我很乐意」",
        "text_idx": [
            695
        ]
    },
    {
        "name": "紬",
        "name_idx": 715,
        "ori": "「あ、亮くん」",
        "message": "「啊，亮君」",
        "text_idx": [
            724
        ]
    },
    {
        "ori": "ニコニコ笑う紬さんの目が、俺を見つけた。",
        "message": "笑眯眯的紬同学的目光，捕捉到了我。",
        "text_idx": [
            739
        ]
    },
    {
        "name": "亮",
        "name_idx": 745,
        "ori": "「あけおめです」",
        "message": "「新年快乐」",
        "text_idx": [
            754
        ]
    },
    {
        "name": "紬",
        "name_idx": 774,
        "ori": "「はい、あけおめです」",
        "message": "「嗯，新年快乐」",
        "text_idx": [
            783
        ]
    },
    {
        "ori": "靴を履いて、紬さんと並ぶ。",
        "message": "我穿上鞋，和紬同学并排站在一起。",
        "text_idx": [
            873
        ]
    },
    {
        "ori": "母さんは、俺と紬さんを交互に見て嬉しそうに笑った。",
        "message": "妈妈交替地看着我和紬同学，开心地笑了起来。",
        "text_idx": [
            1050
        ]
    },
    {
        "name": "ゆう子",
        "name_idx": 1114,
        "ori": "「うふふ、やっぱりいいわ～」",
        "message": "「唔呵呵，果然真好啊～」",
        "text_idx": [
            1123
        ]
    },
    {
        "name": "亮",
        "name_idx": 1129,
        "ori": "「何が？」",
        "message": "「什么？」",
        "text_idx": [
            1138
        ]
    },
    {
        "name": "ゆう子",
        "name_idx": 1202,
        "ori": "「亮、紬ちゃんとさっさと結婚しなさい！」",
        "message": "「亮，你赶紧和小紬结婚！」",
        "text_idx": [
            1211
        ]
    },
    {
        "name": "亮",
        "name_idx": 1217,
        "ori": "「なんだよ急に！」",
        "message": "「干嘛啊突然说这个！」",
        "text_idx": [
            1226
        ]
    },
    {
        "name": "紬",
        "name_idx": 1290,
        "ori": "「結婚……」",
        "message": "「结婚……」",
        "text_idx": [
            1299
        ]
    },
    {
        "ori": "紬さんが顔を赤くしてうつむいてしまう。",
        "message": "紬同学红着脸低下了头。",
        "text_idx": [
            1358
        ]
    },
    {
        "name": "亮",
        "name_idx": 1364,
        "ori": "「ほら、紬さんが恥ずかしがって――」",
        "message": "「你看，紬同学都害羞了——」",
        "text_idx": [
            1373
        ]
    },
    {
        "name": "紬",
        "name_idx": 1437,
        "ori": "「いいですね、結婚」",
        "message": "「结婚，挺好的呢」",
        "text_idx": [
            1446
        ]
    },
    {
        "name": "亮",
        "name_idx": 1452,
        "ori": "「えぇー」",
        "message": "「诶——」",
        "text_idx": [
            1461
        ]
    },
    {
        "name": "ゆう子",
        "name_idx": 1525,
        "ori": "「私、紬ちゃんみたいな子が欲しかったのよぉ」",
        "message": "「我呀，就是想要个像小紬这样的孩子呢～」",
        "text_idx": [
            1534
        ]
    },
    {
        "name": "紬",
        "name_idx": 1598,
        "ori": "「私も、お母様を毎日お母様と呼びたいですわ」",
        "message": "「我也想每天都称呼您为母亲大人呀」",
        "text_idx": [
            1607
        ]
    },
    {
        "name": "ゆう子",
        "name_idx": 1671,
        "ori": "「あらー」",
        "message": "「哎呀——」",
        "text_idx": [
            1680
        ]
    },
    {
        "name": "紬",
        "name_idx": 1744,
        "ori": "「ふふ」",
        "message": "「呵呵」",
        "text_idx": [
            1753
        ]
    },
    {
        "ori": "どうやら紬さんは母さんにだいぶ気に入られているみたいだ。",
        "message": "看来妈妈是相当中意紬同学啊。",
        "text_idx": [
            1768,
            1769
        ]
    },
    {
        "ori": "まあいいんだけど……いいんだけどね。",
        "message": "嘛，倒也挺好的……是挺好的啦。",
        "text_idx": [
            1784
        ]
    },
    {
        "name": "亮",
        "name_idx": 1790,
        "ori": "「俺そっちのけで、大事な話が盛り上がっていくという……」",
        "message": "「把我晾在一边，重要的话题倒是越聊越起劲了……真是的……」",
        "text_idx": [
            1799,
            1800
        ]
    },
    {
        "name": "ゆう子",
        "name_idx": 1864,
        "ori": "「亮は、紬ちゃんと結婚するの嫌なの？」",
        "message": "「亮，你讨厌和紬结婚吗？」",
        "text_idx": [
            1873
        ]
    },
    {
        "name": "紬",
        "name_idx": 1937,
        "ori": "「私とはお嫌なんですか？」",
        "message": "「您是讨厌我吗？」",
        "text_idx": [
            1946
        ]
    },
    {
        "name": "亮",
        "name_idx": 1952,
        "ori": "「い、いや、嫌じゃないけど、まだ早いと言うか……てか、二人ともそんな顔で俺を見るなよ」",
        "message": "「不、不是，我不讨厌，只是觉得还太早了……话说，你们两个别用那种表情看我啊」",
        "text_idx": [
            1961,
            1962
        ]
    },
    {
        "ori": "二人ともショボンとした顔で見てくるので、俺が悪い事している気が。",
        "message": "她们两个都一脸沮丧地看着我，搞得我好像做了什么坏事似的。",
        "text_idx": [
            1977,
            1978
        ]
    },
    {
        "name": "ゆう子",
        "name_idx": 2056,
        "ori": "「紬ちゃん」",
        "message": "「小紬」",
        "text_idx": [
            2065
        ]
    },
    {
        "ori": "気を取り直したように、母さんが手を叩いた。",
        "message": "妈妈像是重新打起精神似的，拍了拍手。",
        "text_idx": [
            2080
        ]
    },
    {
        "name": "ゆう子",
        "name_idx": 2144,
        "ori": "「子供は何人欲しいの？」",
        "message": "「你想要几个孩子？」",
        "text_idx": [
            2153
        ]
    },
    {
        "name": "紬",
        "name_idx": 2217,
        "ori": "「子供……！？」",
        "message": "「孩子……！？」",
        "text_idx": [
            2226
        ]
    },
    {
        "name": "亮",
        "name_idx": 2232,
        "ori": "「子供って！」",
        "message": "「还孩子呢！」",
        "text_idx": [
            2241
        ]
    },
    {
        "ori": "紬さんの顔が真っ赤になる。俺もさすがに恥ずかしくなった。",
        "message": "紬小姐的脸变得通红。我也实在是觉得丢人了。",
        "text_idx": [
            2256,
            2257
        ]
    },
    {
        "name": "亮",
        "name_idx": 2263,
        "ori": "「母さん、あんまりそういうことは――」",
        "message": "「妈，你别老说这种话——」",
        "text_idx": [
            2272
        ]
    },
    {
        "name": "紬",
        "name_idx": 2336,
        "ori": "「子供かぁ」",
        "message": "「孩子啊」",
        "text_idx": [
            2345
        ]
    },
    {
        "name": "亮",
        "name_idx": 2351,
        "ori": "「真剣に考えてるし」",
        "message": "「居然还认真思考起来了」",
        "text_idx": [
            2360
        ]
    },
    {
        "name": "ゆう子",
        "name_idx": 2380,
        "ori": "「早く孫の顔が見たいわぁ」",
        "message": "「好想早点抱孙子啊～」",
        "text_idx": [
            2389
        ]
    },
    {
        "name": "亮",
        "name_idx": 2395,
        "ori": "「まだ俺ぐらいの年のヤツに言うセリフじゃないよ！」",
        "message": "「这不是该对我这个年纪的人说的话吧！」",
        "text_idx": [
            2404
        ]
    },
    {
        "ori": "お節介おばさん化してしまっている母さんにこれ以上構っていられない。",
        "message": "我不能再搭理已经化身为多管闲事大妈的老妈了。",
        "text_idx": [
            2440,
            2441
        ]
    },
    {
        "ori": "紬さんの背中をぽんと押して、歩き出した。",
        "message": "我轻轻推了一下紬小姐的后背，迈步走了起来。",
        "text_idx": [
            2456
        ]
    },
    {
        "name": "亮",
        "name_idx": 2462,
        "ori": "「紬さん、もうさっさと行きましょう」",
        "message": "「紬小姐，我们还是赶紧走吧」",
        "text_idx": [
            2471
        ]
    },
    {
        "name": "紬",
        "name_idx": 2491,
        "ori": "「は、はい」",
        "message": "「啊、好的」",
        "text_idx": [
            2500
        ]
    },
    {
        "name": "ゆう子",
        "name_idx": 2696,
        "ori": "「がんばってねー」",
        "message": "「要加油哦～」",
        "text_idx": [
            2705
        ]
    },
    {
        "name": "亮",
        "name_idx": 2711,
        "ori": "「初詣で何を頑張れっていうんだよ……」",
        "message": "「新年参拜有什么好加油的啊……」",
        "text_idx": [
            2720
        ]
    },
    {
        "name": "紬",
        "name_idx": 2784,
        "ori": "「こ、子作り？」",
        "message": "「是、是生孩子吗？」",
        "text_idx": [
            2793
        ]
    },
    {
        "name": "亮",
        "name_idx": 2799,
        "ori": "「うわー！！」",
        "message": "「哇啊——！！」",
        "text_idx": [
            2808
        ]
    },
    {
        "name": "紬",
        "name_idx": 2896,
        "ori": "「私とじゃ、お嫌なんですか？」",
        "message": "「和我……就不行吗？」",
        "text_idx": [
            2905
        ]
    },
    {
        "name": "亮",
        "name_idx": 2911,
        "ori": "「ち、違います。そう言う意味じゃなくて……あああ」",
        "message": "「不、不是的。我不是那个意思……啊啊啊」",
        "text_idx": [
            2920
        ]
    },
    {
        "name": "紬",
        "name_idx": 2984,
        "ori": "「うふふ」",
        "message": "「呜呼呼」",
        "text_idx": [
            2993
        ]
    },
    {
        "ori": "悪戯な笑みを浮かべる紬さん。",
        "message": "紬小姐露出了恶作剧般的笑容。",
        "text_idx": [
            3008
        ]
    },
    {
        "ori": "新年早々、母親と彼女にからかわれてどっと疲れた。",
        "message": "新年伊始，我就被老妈和女朋友联手捉弄，感觉心好累。",
        "text_idx": [
            3023
        ]
    },
    {
        "ori": "陽が出てるとはいえ、外はやっぱり寒い。",
        "message": "虽说太阳已经出来了，但外面果然还是很冷。",
        "text_idx": [
            3414
        ]
    },
    {
        "ori": "紬さんと寄り添って歩いていた。",
        "message": "我和紬小姐依偎着走着。",
        "text_idx": [
            3429
        ]
    },
    {
        "name": "紬",
        "name_idx": 3449,
        "ori": "「そういえば、亮くん」",
        "message": "「对了，亮君」",
        "text_idx": [
            3458
        ]
    },
    {
        "name": "亮",
        "name_idx": 3464,
        "ori": "「はい？」",
        "message": "「欸？」",
        "text_idx": [
            3473
        ]
    },
    {
        "name": "紬",
        "name_idx": 3493,
        "ori": "「初夢見ました？」",
        "message": "「你做初梦了吗？」",
        "text_idx": [
            3502
        ]
    },
    {
        "name": "亮",
        "name_idx": 3508,
        "ori": "「あー……見てないかな？　見たけど覚えてないかも」",
        "message": "「啊……应该没做吧？　也可能做了但不记得了」",
        "text_idx": [
            3517
        ]
    },
    {
        "name": "紬",
        "name_idx": 3537,
        "ori": "「私は見ましたよ」",
        "message": "「我做了哦」",
        "text_idx": [
            3546
        ]
    },
    {
        "name": "亮",
        "name_idx": 3552,
        "ori": "「え、どんな夢ですか？」",
        "message": "「诶，是什么样的梦？」",
        "text_idx": [
            3561
        ]
    },
    {
        "name": "紬",
        "name_idx": 3581,
        "ori": "「えっと、富士山の上を鷹にまたがってナスを食べている亮くんです」",
        "message": "「那个，是骑着老鹰在富士山顶上吃茄子的亮君哦」",
        "text_idx": [
            3590,
            3591
        ]
    },
    {
        "name": "亮",
        "name_idx": 3597,
        "ori": "「豪華ですね、俺」",
        "message": "「我还真是豪华啊」",
        "text_idx": [
            3606
        ]
    },
    {
        "name": "紬",
        "name_idx": 3626,
        "ori": "「最後には、亮くんがナスになって、私が美味しく頂いておりました」",
        "message": "「最后，亮君变成了茄子，被我美味地享用了哦」",
        "text_idx": [
            3635,
            3636
        ]
    },
    {
        "name": "亮",
        "name_idx": 3642,
        "ori": "「シュールですね」",
        "message": "「真是超现实呢」",
        "text_idx": [
            3651
        ]
    },
    {
        "name": "紬",
        "name_idx": 3823,
        "ori": "「わぁ、人で一杯ですね」",
        "message": "「哇，好多人呢」",
        "text_idx": [
            3832
        ]
    },
    {
        "name": "亮",
        "name_idx": 3838,
        "ori": "「そうですねぇ」",
        "message": "「是啊」",
        "text_idx": [
            3847
        ]
    },
    {
        "ori": "神社の境内は、参拝する人や、屋台を見て回る人で一杯だった。",
        "message": "神社的院子里，挤满了前来参拜和逛摊位的人。",
        "text_idx": [
            3862,
            3863
        ]
    },
    {
        "name": "亮",
        "name_idx": 3869,
        "ori": "「初詣は初めてでしたっけ？」",
        "message": "「你是第一次来新年参拜吗？」",
        "text_idx": [
            3878
        ]
    },
    {
        "name": "紬",
        "name_idx": 3942,
        "ori": "「お正月は、家族と過ごすので……」",
        "message": "「因为正月都是和家人一起过的……」",
        "text_idx": [
            3951
        ]
    },
    {
        "name": "亮",
        "name_idx": 3957,
        "ori": "「俺の所に来てよかったんですか？」",
        "message": "「你来我这里没关系吗？」",
        "text_idx": [
            3966
        ]
    },
    {
        "name": "紬",
        "name_idx": 3986,
        "ori": "「もちろんです。亮くんの側に居たいですから」",
        "message": "「当然了。因为我想待在亮君的身边」",
        "text_idx": [
            3995
        ]
    },
    {
        "name": "亮",
        "name_idx": 4001,
        "ori": "「紬さん……」",
        "message": "「紬小姐……」",
        "text_idx": [
            4010
        ]
    },
    {
        "ori": "照れてしまう。",
        "message": "我不禁害羞起来。",
        "text_idx": [
            4025
        ]
    },
    {
        "ori": "バカップル再来だよ。",
        "message": "我们又成了笨蛋情侣了。",
        "text_idx": [
            4040
        ]
    },
    {
        "name": "亮",
        "name_idx": 4046,
        "ori": "「ま、まあ、とりあえず、お参り済ませてから屋台で何か食べましょう」",
        "message": "「那、那个，总之我们先参拜完，再去摊位找点什么吃吧」",
        "text_idx": [
            4055,
            4056
        ]
    },
    {
        "name": "紬",
        "name_idx": 4120,
        "ori": "「はい。私、屋台とか初めてなんですの」",
        "message": "「好的。我还是第一次逛摊位呢」",
        "text_idx": [
            4129
        ]
    },
    {
        "name": "亮",
        "name_idx": 4135,
        "ori": "「ふふ。屋台のフライドポテトのあの脂っこさに貴女はついてこられるか……」",
        "message": "「呵呵。你能不能受得了摊位上炸薯条的那种油腻感呢……」",
        "text_idx": [
            4144,
            4145
        ]
    },
    {
        "name": "紬",
        "name_idx": 4165,
        "ori": "「楽しみです」",
        "message": "「我很期待」",
        "text_idx": [
            4174
        ]
    },
    {
        "name": "亮",
        "name_idx": 4180,
        "ori": "「じゃ、はぐれないように手を繋ぎましょう」",
        "message": "「那，为了不走散，我们牵手吧」",
        "text_idx": [
            4189
        ]
    },
    {
        "name": "紬",
        "name_idx": 4253,
        "ori": "「初握りですね」",
        "message": "「我们是第一次牵手呢」",
        "text_idx": [
            4262
        ]
    },
    {
        "ori": "差し出してくる紬さんの手を握る。",
        "message": "我握住紬伸过来的手。",
        "text_idx": [
            4277
        ]
    },
    {
        "ori": "ひんやりとして、柔らかく、意外に小さいそれは、俺にとっては宝物。",
        "message": "这只冰凉、柔软而又意外小巧的手，对我来说就是宝物。",
        "text_idx": [
            4292,
            4293
        ]
    },
    {
        "ori": "優しく手を引いて境内の中を進んでいく。",
        "message": "我温柔地牵着她的手，在神社的院子里向前走去。",
        "text_idx": [
            4367
        ]
    },
    {
        "ori": "御守りや破魔矢を買い求める行列をアグレッシブにかいくぐりながら、漸くして、参拝殿にたどり着く。",
        "message": "我们奋力地挤开购买御守和破魔矢的队伍，终于抵达了参拜殿。",
        "text_idx": [
            4382,
            4383
        ]
    },
    {
        "name": "亮",
        "name_idx": 4501,
        "ori": "「やっと着きましたね」",
        "message": "「总算到了呢」",
        "text_idx": [
            4510
        ]
    },
    {
        "name": "紬",
        "name_idx": 4530,
        "ori": "「なかなかエキサイティングでしたね」",
        "message": "「还真是刺激呢」",
        "text_idx": [
            4539
        ]
    },
    {
        "name": "亮",
        "name_idx": 4545,
        "ori": "「何お願いするか決めました？」",
        "message": "「你想好要许什么愿了吗？」",
        "text_idx": [
            4554
        ]
    },
    {
        "name": "紬",
        "name_idx": 4618,
        "ori": "「んー少し待ってください」",
        "message": "「嗯—请稍等一下」",
        "text_idx": [
            4627
        ]
    },
    {
        "ori": "少しの間考え込んで、コクリと頷いて来る。",
        "message": "她思索了片刻，然后朝我轻轻点了点头。",
        "text_idx": [
            4642
        ]
    },
    {
        "name": "紬",
        "name_idx": 4706,
        "ori": "「決めましたわ」",
        "message": "「我决定好了哦」",
        "text_idx": [
            4715
        ]
    },
    {
        "name": "紬",
        "name_idx": 4779,
        "ori": "「亮くんは、決めましたの？」",
        "message": "「亮君呢，你决定好了吗？」",
        "text_idx": [
            4788
        ]
    },
    {
        "name": "亮",
        "name_idx": 4794,
        "ori": "「ああー」",
        "message": "「啊—」",
        "text_idx": [
            4803
        ]
    },
    {
        "ori": "問われて自分も考えていなかったことに気付く。",
        "message": "被她这么一问，我才发现自己也还没想好。",
        "text_idx": [
            4818
        ]
    },
    {
        "ori": "何願おうか。",
        "message": "该许什么愿好呢。",
        "text_idx": [
            4833
        ]
    },
    {
        "ori": "願い事がいくつかぽんぽん浮かんでくる……",
        "message": "脑海里一下子冒出了好几个愿望……",
        "text_idx": [
            4848
        ]
    },
    {
        "ori": "だけど、俺が今一番願いたい事は……",
        "message": "但是，我现在最想许的愿望是……",
        "text_idx": [
            4863
        ]
    },
    {
        "name": "亮",
        "name_idx": 4869,
        "ori": "「オーケーです」",
        "message": "「我想好了」",
        "text_idx": [
            4878
        ]
    },
    {
        "name": "紬",
        "name_idx": 4942,
        "ori": "「では早速……あ、亮くん。こちらにお参りの仕方が書いてありますよ」",
        "message": "「那么我们这就开始吧……啊，亮君。这里写着参拜的方法哦」",
        "text_idx": [
            4951,
            4952
        ]
    },
    {
        "name": "亮",
        "name_idx": 4958,
        "ori": "「あ、本当だ……へぇ、結構複雑なんですね」",
        "message": "「啊，真的耶……欸，还挺复杂的呢」",
        "text_idx": [
            4967
        ]
    },
    {
        "name": "紬",
        "name_idx": 4987,
        "ori": "「お願いする立場ですから、きちんとやらないとダメですよね」",
        "message": "「毕竟是我们有求于人，不好好做可不行呢」",
        "text_idx": [
            4996,
            4997
        ]
    },
    {
        "name": "亮",
        "name_idx": 5003,
        "ori": "「ですね。じゃあ、この通りやってみましょう」",
        "message": "「说的是呢。那么，就照着这个来做吧」",
        "text_idx": [
            5012
        ]
    },
    {
        "ori": "俺と紬さんは参拝殿の前に並ぶように立つ。",
        "message": "我和紬小姐并排站在参拜殿前。",
        "text_idx": [
            5027
        ]
    },
    {
        "ori": "えっと……まず一礼をしてから、鈴を鳴らす。",
        "message": "我想想……首先鞠一躬，然后摇响铃铛。",
        "text_idx": [
            5042
        ]
    },
    {
        "ori": "ガランガラン",
        "message": "咣啷咣啷",
        "text_idx": [
            5071
        ]
    },
    {
        "ori": "賽銭は……奮発したいけど……したいけど！！……１０円で。",
        "message": "香油钱……虽然很想大方一点……很想！！……就投10日元吧。",
        "text_idx": [
            5086,
            5087
        ]
    },
    {
        "ori": "賽銭箱に賽銭を入れ、深く二回礼をする。",
        "message": "我把香油钱投进香油钱箱，深深地鞠了两个躬。",
        "text_idx": [
            5102
        ]
    },
    {
        "ori": "そして、二回パンパンと大きく手を打ち目をつむる。",
        "message": "然后，我响亮地拍了两次手，闭上了眼睛。",
        "text_idx": [
            5117
        ]
    },
    {
        "name": "亮",
        "name_idx": 5196,
        "ori": "「……」",
        "message": "「……」",
        "text_idx": [
            5205
        ]
    },
    {
        "ori": "……神様とか居るか分からないけど、でも、もし居るなのなら、紬さんが音楽で成功しますように。",
        "message": "……虽然我不知道神明到底存不存在，但是，如果真的有的话，希望您能保佑紬小姐在音乐上取得成功。",
        "text_idx": [
            5220,
            5221
        ]
    },
    {
        "ori": "俺のために、留学を諦めてくれたのだから……",
        "message": "毕竟她是为了我，才放弃了留学的……",
        "text_idx": [
            5236
        ]
    },
    {
        "name": "亮",
        "name_idx": 5242,
        "ori": "「……」",
        "message": "「……」",
        "text_idx": [
            5251
        ]
    },
    {
        "ori": "最後に深く一礼をして紬さんを見る。",
        "message": "最后我深深地鞠了一躬，看向紬小姐。",
        "text_idx": [
            5378
        ]
    },
    {
        "name": "紬",
        "name_idx": 5398,
        "ori": "「ふふ……」",
        "message": "「呵呵……」",
        "text_idx": [
            5407
        ]
    },
    {
        "ori": "紬さんも丁度終わったらしく、目が合ってにっこりと笑う。",
        "message": "紬小姐似乎也正好参拜完了，我们四目相对，她莞尔一笑。",
        "text_idx": [
            5422,
            5423
        ]
    },
    {
        "name": "紬",
        "name_idx": 5443,
        "ori": "「真摯にお願いすれば、神様も願いを聞いてくれるかもしれませんわね」",
        "message": "「只要诚心祈祷，说不定神明大人也会聆听我们的愿望呢」",
        "text_idx": [
            5452,
            5453
        ]
    },
    {
        "name": "亮",
        "name_idx": 5459,
        "ori": "「……そうですね」",
        "message": "「……是啊」",
        "text_idx": [
            5468
        ]
    },
    {
        "ori": "…………",
        "message": "…………",
        "text_idx": [
            5617
        ]
    },
    {
        "ori": "……",
        "message": "……",
        "text_idx": [
            5632
        ]
    },
    {
        "name": "紬",
        "name_idx": 5808,
        "ori": "「ところで亮くんは、何をお願いしましたの？」",
        "message": "「话说回来，亮君，你许了什么愿呢？」",
        "text_idx": [
            5817
        ]
    },
    {
        "name": "亮",
        "name_idx": 5823,
        "ori": "「えっと、世界征服かな」",
        "message": "「那个，征服世界吧」",
        "text_idx": [
            5832
        ]
    },
    {
        "name": "紬",
        "name_idx": 5896,
        "ori": "「へぇー」",
        "message": "「欸—」",
        "text_idx": [
            5905
        ]
    },
    {
        "ori": "目を丸くして感心してくる紬さん。",
        "message": "紬小姐瞪圆了眼睛，一脸佩服地看着我。",
        "text_idx": [
            5920
        ]
    },
    {
        "name": "亮",
        "name_idx": 5926,
        "ori": "「いや、冗談ですよ」",
        "message": "「不，是开玩笑的啦」",
        "text_idx": [
            5935
        ]
    },
    {
        "name": "紬",
        "name_idx": 5999,
        "ori": "「海賊王になる……とかですか？」",
        "message": "「是要成为海贼王……之类的吗？」",
        "text_idx": [
            6008
        ]
    },
    {
        "name": "亮",
        "name_idx": 6014,
        "ori": "「一度は願ってみたくはありますが、そんなこと願ったりはしませんよ」",
        "message": "「虽然我也想许一次这样的愿望，但可不会真的许啦」",
        "text_idx": [
            6023,
            6024
        ]
    },
    {
        "name": "紬",
        "name_idx": 6088,
        "ori": "「では、なんですの？」",
        "message": "「那么，是什么呢？」",
        "text_idx": [
            6097
        ]
    },
    {
        "name": "亮",
        "name_idx": 6103,
        "ori": "「聞くんですか？」",
        "message": "「你要问吗？」",
        "text_idx": [
            6112
        ]
    },
    {
        "ori": "恥ずかしいな。",
        "message": "真丢人啊。",
        "text_idx": [
            6127
        ]
    },
    {
        "name": "紬",
        "name_idx": 6191,
        "ori": "「恋人の願いは知りたくなるものです」",
        "message": "「当然会想知道恋人的愿望了」",
        "text_idx": [
            6200
        ]
    },
    {
        "name": "亮",
        "name_idx": 6206,
        "ori": "「ま、まぁ、紬さんが音楽で成功できるようにと……」",
        "message": "「那、那个，我是希望紬小姐能在音乐方面获得成功……」",
        "text_idx": [
            6215
        ]
    },
    {
        "name": "紬",
        "name_idx": 6279,
        "ori": "「亮くん……」",
        "message": "「亮君……」",
        "text_idx": [
            6288
        ]
    },
    {
        "ori": "紬さんは少しきょとんとしてそれから大きく頷いてきた。",
        "message": "紬小姐先是愣了一下，然后用力地点了点头。",
        "text_idx": [
            6303
        ]
    },
    {
        "name": "紬",
        "name_idx": 6367,
        "ori": "「わかりました。必ずその願い、叶えてみせます！」",
        "message": "「我明白了。这个愿望，我一定会让它实现！」",
        "text_idx": [
            6376
        ]
    },
    {
        "name": "亮",
        "name_idx": 6382,
        "ori": "「神様みたいですね」",
        "message": "「你真像个神明一样呢」",
        "text_idx": [
            6391
        ]
    },
    {
        "name": "紬",
        "name_idx": 6455,
        "ori": "「お主の願い、叶えてしんぜよう！！」",
        "message": "「汝之愿望，就由吾来实现吧！！」",
        "text_idx": [
            6464
        ]
    },
    {
        "ori": "ふざけてみせる紬さん。それでも、本当に俺の願いを叶えてしまいそうな雰囲気がある。",
        "message": "开着玩笑的紬小姐。但即便如此，她身上却散发着一股真的能实现我愿望的气场。",
        "text_idx": [
            6479,
            6480
        ]
    },
    {
        "ori": "その有り難い紬さんに聞いた。",
        "message": "我向这位值得感激的紬小姐问道。",
        "text_idx": [
            6495
        ]
    },
    {
        "name": "亮",
        "name_idx": 6501,
        "ori": "「紬さんは何を願ったんですか？」",
        "message": "「紬小姐许了什么愿望呢？」",
        "text_idx": [
            6510
        ]
    },
    {
        "name": "紬",
        "name_idx": 6574,
        "ori": "「私ですか」",
        "message": "「我吗」",
        "text_idx": [
            6583
        ]
    },
    {
        "name": "亮",
        "name_idx": 6589,
        "ori": "「はい」",
        "message": "「嗯」",
        "text_idx": [
            6598
        ]
    },
    {
        "name": "紬",
        "name_idx": 6618,
        "ori": "「私は……」",
        "message": "「我……」",
        "text_idx": [
            6627
        ]
    },
    {
        "ori": "紬さんは、言おうとして口を開きかけるが、結局何も言わずに閉じてニコニコと笑うだけだった。",
        "message": "紬小姐张了张嘴想要说些什么，但最后还是什么都没说，只是闭上嘴笑眯眯的。",
        "text_idx": [
            6642,
            6643
        ]
    },
    {
        "name": "紬",
        "name_idx": 6707,
        "ori": "「内緒……ですわ」",
        "message": "「这是秘密……哦」",
        "text_idx": [
            6716
        ]
    },
    {
        "name": "亮",
        "name_idx": 6722,
        "ori": "「うわ、自分だけ聞いといてズルイ！」",
        "message": "「哇，光问我的却不说，太狡猾了！」",
        "text_idx": [
            6731
        ]
    },
    {
        "name": "紬",
        "name_idx": 6751,
        "ori": "「ふふっ」",
        "message": "「呵呵」",
        "text_idx": [
            6760
        ]
    },
    {
        "ori": "にっこりと上品な微笑みを湛えながら俺の言葉をさらっとかわす。その姿が妙に似合ってるからなぁ……",
        "message": "她脸上挂着优雅的微笑，轻描淡写地回避了我的话。不过这副样子和她真是意外地相配啊……",
        "text_idx": [
            6775,
            6776
        ]
    },
    {
        "name": "紬",
        "name_idx": 6796,
        "ori": "「そのうちわかりますわ」",
        "message": "「到时候你就会明白了哦」",
        "text_idx": [
            6805
        ]
    },
    {
        "name": "亮",
        "name_idx": 6811,
        "ori": "「わかるって？」",
        "message": "「会明白？」",
        "text_idx": [
            6820
        ]
    },
    {
        "name": "紬",
        "name_idx": 6884,
        "ori": "「私は、必ず夢を願いを叶えますから」",
        "message": "「因为我，一定会实现我的梦想和愿望的」",
        "text_idx": [
            6893
        ]
    },
    {
        "name": "亮",
        "name_idx": 6899,
        "ori": "「はぁ……」",
        "message": "「唉……」",
        "text_idx": [
            6908
        ]
    },
    {
        "name": "紬",
        "name_idx": 6972,
        "ori": "「ふふ！」",
        "message": "「呵呵！」",
        "text_idx": [
            6981
        ]
    },
    {
        "ori": "腰に手をあて胸を張る紬さん。",
        "message": "紬小姐双手叉腰，挺起了胸膛。",
        "text_idx": [
            7094
        ]
    },
    {
        "ori": "このままはぐらかされ続けるのもアレだよな……",
        "message": "再这样一直被她糊弄下去也不是个办法啊……",
        "text_idx": [
            7109
        ]
    },
    {
        "name": "亮",
        "name_idx": 7115,
        "ori": "「その……胸触っていいですか？」",
        "message": "「那个……我可以摸摸你的胸吗？」",
        "text_idx": [
            7124
        ]
    },
    {
        "name": "紬",
        "name_idx": 7188,
        "ori": "「い、いきなりなんですの！？」",
        "message": "「你、你突然说些什么呢！？」",
        "text_idx": [
            7197
        ]
    },
    {
        "name": "亮",
        "name_idx": 7203,
        "ori": "「いや、何となく……」",
        "message": "「没什么，就是感觉……」",
        "text_idx": [
            7212
        ]
    },
    {
        "ori": "つん。",
        "message": "戳。",
        "text_idx": [
            7227
        ]
    },
    {
        "name": "紬",
        "name_idx": 7291,
        "ori": "「あぅ……ほ、本当に触りましたね！？」",
        "message": "「啊……你、你真的摸了啊！？」",
        "text_idx": [
            7300
        ]
    },
    {
        "ori": "つんつん。",
        "message": "戳戳。",
        "text_idx": [
            7315
        ]
    },
    {
        "name": "紬",
        "name_idx": 7379,
        "ori": "「あぁ、ぅ……ダメですわ！　こんなところで！」",
        "message": "「啊啊、呜……不行啦！　在这种地方！」",
        "text_idx": [
            7388
        ]
    },
    {
        "ori": "つんつんつん。",
        "message": "戳戳戳。",
        "text_idx": [
            7403
        ]
    },
    {
        "name": "紬",
        "name_idx": 7467,
        "ori": "「うぅぁ……」",
        "message": "「唔啊……」",
        "text_idx": [
            7476
        ]
    },
    {
        "name": "子供",
        "name_idx": 7496,
        "ori": "「お母さん、あれ何してるのー？」",
        "message": "「妈妈，他们在干什么呀—？」",
        "text_idx": [
            7505
        ]
    },
    {
        "name": "母親",
        "name_idx": 7525,
        "ori": "「だめ！　見てはいけません！」",
        "message": "「不行！　不许看！」",
        "text_idx": [
            7534
        ]
    },
    {
        "name": "亮",
        "name_idx": 7540,
        "ori": "「まさか、あれはクリスマスの時の親子！？」",
        "message": "「难道说，那是圣诞节时的那对母子！？」",
        "text_idx": [
            7549
        ]
    },
    {
        "ori": "ご近所さんか？　それとも俺のことをチェイスしているのか！？",
        "message": "是我的邻居吗？　还是说在跟踪我！？",
        "text_idx": [
            7564,
            7565
        ]
    },
    {
        "ori": "視線が集まり始めていたので、紬さんの手を引っ張ってそそくさとその場から退散した。",
        "message": "因为周围的视线开始聚集过来，我拉着紬小姐的手，急匆匆地逃离了现场。",
        "text_idx": [
            7580,
            7581
        ]
    },
    {
        "name": "紬",
        "name_idx": 7713,
        "ori": "「ひどいですわ、あんな所で！」",
        "message": "「太过分了，居然在那种地方！」",
        "text_idx": [
            7722
        ]
    },
    {
        "name": "亮",
        "name_idx": 7728,
        "ori": "「すみません、つい」",
        "message": "「对不起，我不是故意的」",
        "text_idx": [
            7737
        ]
    },
    {
        "name": "紬",
        "name_idx": 7801,
        "ori": "「やるのでしたら場所を選んで欲しいですわ！」",
        "message": "「要做的话也请选个地方呀！」",
        "text_idx": [
            7810
        ]
    },
    {
        "ori": "俺から顔をプイっと背けるように紬さんは呟く。",
        "message": "紬小姐气呼呼地扭过头，嘟囔着。",
        "text_idx": [
            7825
        ]
    },
    {
        "ori": "さすがにちょっと怒っている……かも。",
        "message": "她果然还是有点生气了……吧。",
        "text_idx": [
            7840
        ]
    },
    {
        "name": "亮",
        "name_idx": 7846,
        "ori": "「……すみません」",
        "message": "「……对不起」",
        "text_idx": [
            7855
        ]
    },
    {
        "ori": "しかし、怒られてるはずなのに、何となく嬉しいっていうか……別の場所ならいいんだ。",
        "message": "不过，我明明正被她责备，却不知为何有些开心……也就是说……只要换个地方就行了啊。",
        "text_idx": [
            7870,
            7871
        ]
    },
    {
        "name": "亮",
        "name_idx": 7877,
        "ori": "「あ、紬さん、綿あめ食べませんか？」",
        "message": "「啊，紬小姐，要不要吃棉花糖？」",
        "text_idx": [
            7886
        ]
    },
    {
        "ori": "丁度通りかかったので、お詫びの意味を込めて提案した。",
        "message": "我们正好路过，我便带着赔罪的意思向她提议。",
        "text_idx": [
            7901
        ]
    },
    {
        "name": "紬",
        "name_idx": 7965,
        "ori": "「綿……あめ？」",
        "message": "「棉……花糖？」",
        "text_idx": [
            7974
        ]
    },
    {
        "name": "亮",
        "name_idx": 7980,
        "ori": "「綿あめ知ってますよね？」",
        "message": "「你知道棉花糖吧？」",
        "text_idx": [
            7989
        ]
    },
    {
        "name": "紬",
        "name_idx": 8053,
        "ori": "「そ、それぐらい知ってますわ」",
        "message": "「我、我当然知道了」",
        "text_idx": [
            8062
        ]
    },
    {
        "name": "亮",
        "name_idx": 8068,
        "ori": "「おじさん、二つください」",
        "message": "「大叔，请给我两个」",
        "text_idx": [
            8077
        ]
    },
    {
        "name": "おじさん",
        "name_idx": 8097,
        "ori": "「あいよ、二つで６００円だ」",
        "message": "「好嘞，两个600圆」",
        "text_idx": [
            8106
        ]
    },
    {
        "ori": "げっ……やっぱ屋台物は高いよなぁ。",
        "message": "唔……路边摊的东西果然很贵啊。",
        "text_idx": [
            8121
        ]
    },
    {
        "ori": "おじさんは手際よく機械の中にザラメをいれ、回転する機械から次々と空中に舞いあがる砂糖の綿を割り箸で絡め取っていく。",
        "message": "大叔熟练地往机器里倒入砂糖，用一次性筷子将从旋转的机器中不断飞舞到空中的砂糖棉絮缠绕起来。",
        "text_idx": [
            8136,
            8137,
            8138
        ]
    },
    {
        "ori": "それは１分もしないうちに顔が隠れてしまうぐらいの綿になった。",
        "message": "不到一分钟，它就变成了一团大到能遮住脸的棉花糖。",
        "text_idx": [
            8153,
            8154
        ]
    },
    {
        "name": "おじさん",
        "name_idx": 8174,
        "ori": "「あいよ」",
        "message": "「好嘞」",
        "text_idx": [
            8183
        ]
    },
    {
        "name": "亮",
        "name_idx": 8189,
        "ori": "「ありがとうございます」",
        "message": "「谢谢」",
        "text_idx": [
            8198
        ]
    },
    {
        "ori": "綿あめを二つ受け取り、一つを紬さんに差し出す。",
        "message": "我接过两个棉花糖，把其中一个递给紬小姐。",
        "text_idx": [
            8213
        ]
    },
    {
        "name": "亮",
        "name_idx": 8219,
        "ori": "「はい、紬さん」",
        "message": "「来，紬小姐」",
        "text_idx": [
            8228
        ]
    },
    {
        "name": "紬",
        "name_idx": 8292,
        "ori": "「このような物で私の機嫌が――」",
        "message": "「我才不会因为这种东西就——」",
        "text_idx": [
            8301
        ]
    },
    {
        "name": "紬",
        "name_idx": 8365,
        "ori": "「あ……、美味しいですわ」",
        "message": "「啊……好好吃呀」",
        "text_idx": [
            8374
        ]
    },
    {
        "ori": "機嫌が直った。",
        "message": "她的心情变好了。",
        "text_idx": [
            8433
        ]
    },
    {
        "ori": "よし、このまま屋台盛りで行ってみよう。",
        "message": "好，就这么用路边摊攻势继续下去吧。",
        "text_idx": [
            8448
        ]
    },
    {
        "name": "亮",
        "name_idx": 8454,
        "ori": "「次、ベビーカステラ食べます？」",
        "message": "「接下来，要吃蜂蜜小蛋糕吗？」",
        "text_idx": [
            8463
        ]
    },
    {
        "name": "紬",
        "name_idx": 8527,
        "ori": "「少し待ってください。まだ全部……はむはむ」",
        "message": "「请稍等一下。我还没吃完……嚼嚼」",
        "text_idx": [
            8536
        ]
    },
    {
        "name": "亮",
        "name_idx": 8542,
        "ori": "「その場で食べなくても、歩きながら食べればいいですよ」",
        "message": "「不用当场吃完，可以边走边吃的哦」",
        "text_idx": [
            8551,
            8552
        ]
    },
    {
        "name": "紬",
        "name_idx": 8616,
        "ori": "「お行儀悪くないですか？」",
        "message": "「那样不会很没规矩吗？」",
        "text_idx": [
            8625
        ]
    },
    {
        "name": "亮",
        "name_idx": 8631,
        "ori": "「げへへ、お嬢ちゃん、箱入りだねぇ」",
        "message": "「嘿嘿嘿，大小姐，你还真是个温室里的花朵呢」",
        "text_idx": [
            8640
        ]
    },
    {
        "name": "紬",
        "name_idx": 8704,
        "ori": "「なぜ口調を変えるのですか？」",
        "message": "「为什么要改变说话的语气呢？」",
        "text_idx": [
            8713
        ]
    },
    {
        "name": "亮",
        "name_idx": 8719,
        "ori": "「いや、なんとなく……」",
        "message": "「没什么，就是一时兴起……」",
        "text_idx": [
            8728
        ]
    },
    {
        "name": "亮",
        "name_idx": 8734,
        "ori": "「さ、次行きましょ、紬さん」",
        "message": "「来，我们去下一个吧，紬同学」",
        "text_idx": [
            8743
        ]
    },
    {
        "name": "紬",
        "name_idx": 8807,
        "ori": "「もう少し……もう少し待ってください、ああっ！！」",
        "message": "「再等一下……请再等我一下，啊啊！！」",
        "text_idx": [
            8816
        ]
    },
    {
        "ori": "食べている途中の紬さんの手を引いて歩き出す。",
        "message": "我拉着还在吃东西的紬同学的手，向前走去。",
        "text_idx": [
            8876
        ]
    },
    {
        "ori": "ご機嫌取りのつもりが、いろいろな屋台を巡るたびに、紬さんが喜んだり、驚いたり、ちょっと困ったりと。",
        "message": "我本想让她开心起来，结果每逛一个路边摊，紬同学都会时而开心，时而惊讶，时而又有点为难。",
        "text_idx": [
            8891,
            8892
        ]
    },
    {
        "ori": "結局俺自身が紬さんの反応を楽しんでいた。",
        "message": "结果到头来，是我自己在享受紬小姐的反应。",
        "text_idx": [
            8907
        ]
    },
    {
        "ori": "金は恐ろしい早さで減っていったけど。",
        "message": "虽然钱也以惊人的速度在减少就是了。",
        "text_idx": [
            8922
        ]
    },
    {
        "name": "紬",
        "name_idx": 9171,
        "ori": "「うぅ、口の中がぎとぎとします」",
        "message": "「呜，嘴里油腻腻的」",
        "text_idx": [
            9180
        ]
    },
    {
        "name": "亮",
        "name_idx": 9186,
        "ori": "「最後のイカ焼きですね」",
        "message": "「是最后吃的烤鱿鱼吧」",
        "text_idx": [
            9195
        ]
    },
    {
        "name": "紬",
        "name_idx": 9215,
        "ori": "「服も臭いです」",
        "message": "「衣服也一股味儿」",
        "text_idx": [
            9224
        ]
    },
    {
        "name": "亮",
        "name_idx": 9230,
        "ori": "「お好み焼きの屋台の前にずっと居たのが、いけなかったですね」",
        "message": "「都怪我们在御好烧的摊位前待了那么久呢」",
        "text_idx": [
            9239,
            9240
        ]
    },
    {
        "name": "紬",
        "name_idx": 9304,
        "ori": "「でも……楽しかったです」",
        "message": "「不过……我很开心」",
        "text_idx": [
            9313
        ]
    },
    {
        "ori": "嬉しそうに笑う紬さん。",
        "message": "紬小姐开心地笑了。",
        "text_idx": [
            9328
        ]
    },
    {
        "name": "亮",
        "name_idx": 9334,
        "ori": "「それはよかったです」",
        "message": "「那就好」",
        "text_idx": [
            9343
        ]
    },
    {
        "ori": "その一言で、今日紬さんと一緒にいて良かったと思う。",
        "message": "就因为她这一句话，我觉得今天能和紬小姐在一起真是太好了。",
        "text_idx": [
            9358
        ]
    },
    {
        "name": "紬",
        "name_idx": 9422,
        "ori": "「でも、せっかく今年最初のキスしようと思ったのに、これではすることができませんわ」",
        "message": "「可是，我本来还想和你来个新年第一吻呢，这下可亲不成了呀」",
        "text_idx": [
            9431,
            9432
        ]
    },
    {
        "name": "亮",
        "name_idx": 9438,
        "ori": "「ちっミスったな」",
        "message": "「啧，失策了啊」",
        "text_idx": [
            9447
        ]
    },
    {
        "ori": "これは完璧な誤算だ。",
        "message": "这可真是个完美的失算。",
        "text_idx": [
            9462
        ]
    },
    {
        "name": "紬",
        "name_idx": 9526,
        "ori": "「ふふ、したかったですか？」",
        "message": "「呵呵，很想吗？」",
        "text_idx": [
            9535
        ]
    },
    {
        "name": "亮",
        "name_idx": 9541,
        "ori": "「とっても」",
        "message": "「非常想」",
        "text_idx": [
            9550
        ]
    },
    {
        "name": "紬",
        "name_idx": 9570,
        "ori": "「お預けですね」",
        "message": "「那就只能先等等咯」",
        "text_idx": [
            9579
        ]
    },
    {
        "name": "亮",
        "name_idx": 9585,
        "ori": "「まあ、仕方ないですね」",
        "message": "「嘛，那也没办法呢」",
        "text_idx": [
            9594
        ]
    },
    {
        "ori": "その代わり、普段見られないような紬さんがたくさん見られたし。",
        "message": "不过作为交换，我也看到了许多平时见不到的紬小姐的一面。",
        "text_idx": [
            9609,
            9610
        ]
    },
    {
        "name": "亮",
        "name_idx": 9616,
        "ori": "「次はいつ会えますか？」",
        "message": "「我们下次什么时候能见面？」",
        "text_idx": [
            9625
        ]
    },
    {
        "name": "紬",
        "name_idx": 9703,
        "ori": "「それなのですが……」",
        "message": "「关于这个嘛……」",
        "text_idx": [
            9712
        ]
    },
    {
        "ori": "紬さんが申し訳なさそうな顔をする。",
        "message": "紬小姐露出了抱歉的表情。",
        "text_idx": [
            9727
        ]
    },
    {
        "name": "亮",
        "name_idx": 9733,
        "ori": "「紬さん？」",
        "message": "「紬小姐？」",
        "text_idx": [
            9742
        ]
    },
    {
        "name": "紬",
        "name_idx": 9776,
        "ori": "「三学期が始まるまで会えないかもしれません」",
        "message": "「我们可能要等到第三学期开学才能见面了」",
        "text_idx": [
            9785
        ]
    },
    {
        "ori": "落ち込む自分が居た。",
        "message": "我感到有些失落。",
        "text_idx": [
            9800
        ]
    },
    {
        "name": "紬",
        "name_idx": 9820,
        "ori": "「留学から国内の大学へと進路を変えたので、受験の準備など、いろいろやらないといけない事ができまして……」",
        "message": "「因为我把升学目标从留学改成了国内的大学，所以多出来很多必须要做的事情，比如准备考试之类的……」",
        "text_idx": [
            9829,
            9830
        ]
    },
    {
        "name": "紬",
        "name_idx": 9850,
        "ori": "「ごめんなさい」",
        "message": "「对不起」",
        "text_idx": [
            9859
        ]
    },
    {
        "name": "亮",
        "name_idx": 9865,
        "ori": "「いや、仕方ないですよ」",
        "message": "「不，这也是没办法的事」",
        "text_idx": [
            9874
        ]
    },
    {
        "ori": "留学をやめたとはいえ、紬さんと会える機会が減ることには変わりない。",
        "message": "虽说她放弃了留学，但能和紬小姐见面的机会减少了这一点，还是没有改变。",
        "text_idx": [
            9889,
            9890
        ]
    },
    {
        "ori": "分かってはいたが、それなりにショックだった。",
        "message": "虽然我心里明白，但还是挺受打击的。",
        "text_idx": [
            9905
        ]
    },
    {
        "ori": "まあ、留学してほとんど会えなくなるよりかはマシと思うしかない。",
        "message": "嘛，我也只能想着这总比她去留学后几乎见不到面要好得多了。",
        "text_idx": [
            9920,
            9921
        ]
    },
    {
        "ori": "それに、俺の願いが叶う為の一歩でもあるんだし。",
        "message": "而且，这也是为了实现我愿望的一步。",
        "text_idx": [
            9936
        ]
    },
    {
        "name": "紬",
        "name_idx": 10000,
        "ori": "「それでこれを……」",
        "message": "「所以，这个给您……」",
        "text_idx": [
            10009
        ]
    },
    {
        "ori": "先輩は１枚の紙切れを差し出す。",
        "message": "学姐递出了一张小纸条。",
        "text_idx": [
            10024
        ]
    },
    {
        "name": "亮",
        "name_idx": 10030,
        "ori": "「これは？」",
        "message": "「这是？」",
        "text_idx": [
            10039
        ]
    },
    {
        "name": "紬",
        "name_idx": 10059,
        "ori": "「私の携帯の番号と、メールアドレスです」",
        "message": "「这是我的手机号码和邮箱地址」",
        "text_idx": [
            10068
        ]
    },
    {
        "ori": "そこには、いかにも紬さんらしい綺麗な文字で１０桁の番号と、メールアドレスが書かれていた。",
        "message": "纸上用颇有紬小姐风格的漂亮字迹，写着10位数的号码和邮箱地址。",
        "text_idx": [
            10083,
            10084
        ]
    },
    {
        "name": "紬",
        "name_idx": 10148,
        "ori": "「電話はもしかしたら出られないかもしれませんが、メールはいただいたら必ずお返事しますので……」",
        "message": "「电话我可能接不到，但是邮件只要收到了我一定会回复的……」",
        "text_idx": [
            10157,
            10158
        ]
    },
    {
        "name": "亮",
        "name_idx": 10164,
        "ori": "「ありがとうございます。あ、ちょっと待ってください」",
        "message": "「谢谢您。啊，请稍等一下」",
        "text_idx": [
            10173
        ]
    },
    {
        "ori": "俺は携帯を取り出すと、手早く紬さんの電話番号とメールアドレスを登録する。",
        "message": "我拿出手机，迅速地将紬小姐的电话号码和邮箱地址存了起来。",
        "text_idx": [
            10188,
            10189
        ]
    },
    {
        "ori": "そしてポケットからペンを取り出して、先ほど紬さんから貰った紙の余白に自分の携帯の番号とメールアドレスを書いた。",
        "message": "然后我从口袋里拿出笔，在刚才从紬小姐那里收到的纸的空白处写上了自己的手机号码和邮箱地址。",
        "text_idx": [
            10204,
            10205,
            10206
        ]
    },
    {
        "ori": "紬さんの整った字とは違って、書き殴った感じの不揃いな文字がちょっと恥ずかしい。",
        "message": "和紬小姐工整的字迹不同，我这潦草不齐的字让我觉得有点丢人。",
        "text_idx": [
            10221,
            10222
        ]
    },
    {
        "name": "亮",
        "name_idx": 10228,
        "ori": "「これ、俺の番号と……メアドです」",
        "message": "「这个，是我的号码和……邮箱地址」",
        "text_idx": [
            10237
        ]
    },
    {
        "ori": "すっと紬さんにその紙を手渡す。",
        "message": "我将纸条递给了紬小姐。",
        "text_idx": [
            10252
        ]
    },
    {
        "name": "紬",
        "name_idx": 10316,
        "ori": "「ありがとうございます……ふふっ」",
        "message": "「谢谢您……呵呵」",
        "text_idx": [
            10325
        ]
    },
    {
        "ori": "紙を見た紬さんが、小さく笑う。",
        "message": "看到纸条的紬小姐，轻笑起来。",
        "text_idx": [
            10340
        ]
    },
    {
        "name": "亮",
        "name_idx": 10346,
        "ori": "「あ、もしかして、字へたっぴで読めませんか？」",
        "message": "「啊，难道说，是我的字太烂了看不清吗？」",
        "text_idx": [
            10355
        ]
    },
    {
        "ori": "実際、自分でも読めるかどうか微妙なラインだし……",
        "message": "说实话，连我自己都觉得能不能认出来都很难说……",
        "text_idx": [
            10370
        ]
    },
    {
        "name": "紬",
        "name_idx": 10434,
        "ori": "「あ、いえ……そうではなく……１枚の紙に亮くんの字と私の字が並んでいるのが……なんかいいなぁって」",
        "message": "「啊，不是……不是那样的……在一张纸上，亮的字和我的字并排写在一起……总觉得……感觉真好啊」",
        "text_idx": [
            10443,
            10444
        ]
    },
    {
        "ori": "紬さんは嬉しそうに紙を両手で胸の前で包むようにする。",
        "message": "紬小姐开心地用双手将纸条捧在胸前。",
        "text_idx": [
            10459
        ]
    },
    {
        "ori": "こんな些細ないことでも、俺との事を大切に思ってくれているんだと感じ、先ほどのショックが少しだけ和らいだ気がした。",
        "message": "我感到她连这样一件小事都如此珍视，刚才受到的打击也因此缓和了些许。",
        "text_idx": [
            10474,
            10475,
            10476
        ]
    },
    {
        "name": "亮",
        "name_idx": 10482,
        "ori": "「それじゃあ、次会うのは、三学期の始業式になるかもしれないんですね」",
        "message": "「那么，下次见面，可能就要等到第三学期的开学典礼了呢」",
        "text_idx": [
            10491,
            10492
        ]
    },
    {
        "name": "紬",
        "name_idx": 10556,
        "ori": "「はい……」",
        "message": "「是的……」",
        "text_idx": [
            10565
        ]
    },
    {
        "name": "亮",
        "name_idx": 10571,
        "ori": "「それまで我慢できるように、抱きしめさせてください」",
        "message": "「为了能忍到那个时候，请让我抱一下吧」",
        "text_idx": [
            10580
        ]
    },
    {
        "ori": "変な事言ってるなぁ、甘えん坊だなぁと思うが、したいのだからしょうがない。",
        "message": "我心想自己真是说了些奇怪的话，真会撒娇啊，但既然想这么做那也没办法。",
        "text_idx": [
            10595,
            10596
        ]
    },
    {
        "ori": "紬さんに歩み寄る。",
        "message": "我走向紬小姐。",
        "text_idx": [
            10850
        ]
    },
    {
        "name": "紬",
        "name_idx": 10870,
        "ori": "「服臭いますよ？」",
        "message": "「衣服上有味道哦？」",
        "text_idx": [
            10879
        ]
    },
    {
        "name": "亮",
        "name_idx": 10885,
        "ori": "「別にいいですよ」",
        "message": "「我不在意」",
        "text_idx": [
            10894
        ]
    },
    {
        "name": "紬",
        "name_idx": 10935,
        "ori": "「亮くっ！？」",
        "message": "「亮唔！？」",
        "text_idx": [
            10944
        ]
    },
    {
        "ori": "半ば無理矢理に紬さんの体を抱きしめた。",
        "message": "我近乎强硬地抱住了紬小姐的身体。",
        "text_idx": [
            10959
        ]
    },
    {
        "name": "亮",
        "name_idx": 10965,
        "ori": "「良い匂いじゃないですか」",
        "message": "「不是很香吗」",
        "text_idx": [
            10974
        ]
    },
    {
        "name": "紬",
        "name_idx": 10994,
        "ori": "「そ、そうですか？」",
        "message": "「是、是吗？」",
        "text_idx": [
            11003
        ]
    },
    {
        "name": "亮",
        "name_idx": 11009,
        "ori": "「頑張ってくださいね……」",
        "message": "「请加油哦……」",
        "text_idx": [
            11018
        ]
    },
    {
        "name": "紬",
        "name_idx": 11038,
        "ori": "「はい……」",
        "message": "「是的……」",
        "text_idx": [
            11047
        ]
    },
    {
        "name": "亮",
        "name_idx": 11053,
        "ori": "「メール……出しますから」",
        "message": "「我会……发邮件的」",
        "text_idx": [
            11062
        ]
    },
    {
        "name": "紬",
        "name_idx": 11082,
        "ori": "「はい…………待ってますわ」",
        "message": "「嗯…………我会等着的」",
        "text_idx": [
            11091
        ]
    },
    {
        "ori": "紬さんも俺の背中に腕を回してくる。",
        "message": "紬小姐也把手臂环绕到我的背上。",
        "text_idx": [
            11106
        ]
    },
    {
        "ori": "お互いに強く抱きしめ合った。",
        "message": "我们互相紧紧地拥抱在一起。",
        "text_idx": [
            11121
        ]
    },
    {
        "name": "紬",
        "name_idx": 11141,
        "ori": "「これ……初抱きしめですね」",
        "message": "「这……是第一次拥抱呢」",
        "text_idx": [
            11150
        ]
    },
    {
        "name": "亮",
        "name_idx": 11156,
        "ori": "「はは、確かに」",
        "message": "「哈哈，确实」",
        "text_idx": [
            11165
        ]
    },
    {
        "ori": "長い間、温かさを共有し、お互いの存在を確かめ合った。",
        "message": "我们在很长一段时间里，共享着温暖，确认着彼此的存在。",
        "text_idx": [
            11180
        ]
    }
]