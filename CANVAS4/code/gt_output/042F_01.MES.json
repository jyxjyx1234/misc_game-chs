[
    {
        "name": "亮",
        "name_idx": 37,
        "ori": "「ふう、到着と」",
        "message": "「呼，到了」",
        "text_idx": [
            46
        ]
    },
    {
        "name": "ことの",
        "name_idx": 110,
        "ori": "「うう、まだ眠いよぉ……」",
        "message": "「呜呜，还很困啊……」",
        "text_idx": [
            119
        ]
    },
    {
        "name": "亮",
        "name_idx": 125,
        "ori": "「しゃっきりしろ。歩きながら寝るんじゃないぞ」",
        "message": "「打起精神来。别边走边睡啊」",
        "text_idx": [
            134
        ]
    },
    {
        "name": "ことの",
        "name_idx": 208,
        "ori": "「うう、亮ちゃんおんぶしてぇ……」",
        "message": "「呜呜，小亮背我……」",
        "text_idx": [
            217
        ]
    },
    {
        "name": "亮",
        "name_idx": 223,
        "ori": "「馬鹿言ってないで歩いた歩いた」",
        "message": "「别说傻话了，快走快走」",
        "text_idx": [
            232
        ]
    },
    {
        "name": "ことの",
        "name_idx": 296,
        "ori": "「亮ちゃんの鬼ぃ……」",
        "message": "「小亮是魔鬼……」",
        "text_idx": [
            305
        ]
    },
    {
        "name": "亮",
        "name_idx": 311,
        "ori": "「鬼でも悪魔でもいいからちゃっちゃと歩け。ここまで来て遅刻するつもりか、お前は」",
        "message": "「魔鬼也好恶魔也罢，赶紧给我走。都到这儿了你还想迟到吗？」",
        "text_idx": [
            320,
            321
        ]
    },
    {
        "name": "？",
        "name_idx": 341,
        "ori": "「よーっす、今日も二人仲良く登校か？」",
        "message": "「哟，今天也是两人这么要好地一起来上学啊？」",
        "text_idx": [
            350
        ]
    },
    {
        "name": "亮",
        "name_idx": 356,
        "ori": "「ん……？」",
        "message": "「嗯……？」",
        "text_idx": [
            365
        ]
    },
    {
        "name": "ことの",
        "name_idx": 473,
        "ori": "「あ、智継くん。おはよー」",
        "message": "「啊，智继。早上好——」",
        "text_idx": [
            482
        ]
    },
    {
        "name": "亮",
        "name_idx": 488,
        "ori": "「おう。おはよう」",
        "message": "「哦。早上好」",
        "text_idx": [
            497
        ]
    },
    {
        "name": "智継",
        "name_idx": 561,
        "ori": "「ういっす。ことのちゃんは相変わらず眠そうだな」",
        "message": "「哟。琴乃还是一如既往地困啊」",
        "text_idx": [
            570
        ]
    },
    {
        "name": "ことの",
        "name_idx": 634,
        "ori": "「んー、今日はちょっと暖かいしね」",
        "message": "「嗯——，因为今天有点暖和嘛」",
        "text_idx": [
            643
        ]
    },
    {
        "name": "亮",
        "name_idx": 649,
        "ori": "「いつものことだろ」",
        "message": "「你不是一直都这样吗」",
        "text_idx": [
            658
        ]
    },
    {
        "name": "智継",
        "name_idx": 722,
        "ori": "「ま、ことのちゃんの気持ちもわかるけどな。バス停の学校前って言ったら、バスから降りたら５分で教室ってなもんだろ？」",
        "message": "「嘛，不过我也能理解琴乃的心情。毕竟校前这个公交站，下车后5分钟就能到教室了，对吧？」",
        "text_idx": [
            731,
            732,
            733
        ]
    },
    {
        "name": "ことの",
        "name_idx": 851,
        "ori": "「うんうん。そーだよね？」",
        "message": "「嗯嗯。就是说啊，对吧？」",
        "text_idx": [
            860
        ]
    },
    {
        "name": "亮",
        "name_idx": 866,
        "ori": "「仕方ないだろ。とんでもなく敷地が広いんだから」",
        "message": "「那也没办法吧。毕竟学校的占地面积大得离谱」",
        "text_idx": [
            875
        ]
    },
    {
        "name": "亮",
        "name_idx": 895,
        "ori": "「ん……？」",
        "message": "「嗯……？」",
        "text_idx": [
            904
        ]
    },
    {
        "name": "ことの",
        "name_idx": 968,
        "ori": "「どうしたの、亮ちゃん？」",
        "message": "「怎么了，小亮？」",
        "text_idx": [
            977
        ]
    },
    {
        "name": "亮",
        "name_idx": 983,
        "ori": "「いや、なんか、ちょっと騒がしいような……」",
        "message": "「不，总觉得，有点吵闹……」",
        "text_idx": [
            992
        ]
    },
    {
        "name": "智継",
        "name_idx": 1066,
        "ori": "「お、おい、あれ」",
        "message": "「喂、喂，你看那个」",
        "text_idx": [
            1075
        ]
    },
    {
        "name": "亮",
        "name_idx": 1081,
        "ori": "「ん……？」",
        "message": "「嗯……？」",
        "text_idx": [
            1090
        ]
    },
    {
        "ori": "なにをあわてて指差して……",
        "message": "他这么慌张地指着什么啊……",
        "text_idx": [
            1105
        ]
    },
    {
        "name": "亮",
        "name_idx": 1297,
        "ori": "「………………」",
        "message": "「………………」",
        "text_idx": [
            1306
        ]
    },
    {
        "ori": "一瞬、息を呑んだ。",
        "message": "我瞬间倒吸了一口气。",
        "text_idx": [
            1321
        ]
    },
    {
        "name": "女生徒１",
        "name_idx": 1341,
        "ori": "「おはようございます！　紬さん！」",
        "message": "「早上好！　紬学姐！」",
        "text_idx": [
            1350
        ]
    },
    {
        "name": "？",
        "name_idx": 1424,
        "ori": "「ええ、おはようございます」",
        "message": "「嗯，早上好」",
        "text_idx": [
            1433
        ]
    },
    {
        "name": "女生徒２",
        "name_idx": 1453,
        "ori": "「おはようございます。鷺ノ宮先輩」",
        "message": "「早上好。鹭之宫前辈」",
        "text_idx": [
            1462
        ]
    },
    {
        "name": "？",
        "name_idx": 1536,
        "ori": "「はい。おはようございます。気持ちのいい天気ですわね」",
        "message": "「是的。早上好。天气真不错是吧」",
        "text_idx": [
            1545,
            1546
        ]
    },
    {
        "ori": "そこだけ空気が違うようで。",
        "message": "只有那里的空气似乎与众不同。",
        "text_idx": [
            1889
        ]
    },
    {
        "name": "ことの",
        "name_idx": 2065,
        "ori": "「うわ……」",
        "message": "「哇……」",
        "text_idx": [
            2074
        ]
    },
    {
        "name": "智継",
        "name_idx": 2094,
        "ori": "「三年の鷺ノ宮紬先輩だ……こんな間近で見たの、初めてだよ」",
        "message": "「是三年级的鹭之宫紬学姐啊……我还是第一次这么近距离地看到她」",
        "text_idx": [
            2103,
            2104
        ]
    },
    {
        "name": "亮",
        "name_idx": 2110,
        "ori": "「ああ、あれが……」",
        "message": "「啊啊，那位就是……」",
        "text_idx": [
            2119
        ]
    },
    {
        "ori": "そういえば、見覚えがあるような……",
        "message": "说起来，我好像有点印象……",
        "text_idx": [
            2134
        ]
    },
    {
        "ori": "この学園をはじめ、いくつもの事業を立ち上げ、成功させている鷺ノ宮財閥の令嬢。",
        "message": "她是创办了以本校为首的众多事业并大获成功的鹭之宫财阀的千金。",
        "text_idx": [
            2149,
            2150
        ]
    },
    {
        "ori": "現当主の一人娘で事実上の後継者……にとどまらず、本人も撫子生でありながら、撫子学園の姉妹校である繚乱学園の理事長でもあるらしい。",
        "message": "她不仅是现任家主的独生女和事实上的继承人……据说她本人虽是抚子学园的学生，却同时担任着姐妹校缭乱学园的理事长。",
        "text_idx": [
            2165,
            2166,
            2167
        ]
    },
    {
        "ori": "さらに、ヴィオリストとして世界的にも有名で、小学生のころから大きな音楽コンサートで入賞の常連。",
        "message": "此外，她作为一名中提琴家闻名世界，从小学时起就是各大音乐会的获奖常客。",
        "text_idx": [
            2236,
            2237
        ]
    },
    {
        "ori": "そのヴィオラの腕を買われて、国内外関わらず演奏会に出ている為、休みがちなこともあって、なかなか目にする機会がなかったこともあるけど……",
        "message": "因为她的中提琴技艺备受肯定，经常要到国内外参加演奏会，所以她常常缺席，我也因此一直没什么机会见到她……",
        "text_idx": [
            2252,
            2253,
            2254
        ]
    },
    {
        "ori": "たびたび遠くから見かけることはあったけど、どこか雲の上の人って感じで、近寄りがたいものがあった。",
        "message": "虽然我常常从远处看到她，但总有种她是云端之上的人的感觉，让人难以接近。",
        "text_idx": [
            2269,
            2270
        ]
    },
    {
        "ori": "こうして間近に見てると、派手なわけじゃない。",
        "message": "像这样近距离地看着，发现她并不是那种很华丽的人。",
        "text_idx": [
            2339
        ]
    },
    {
        "ori": "どっちかっていうと、清楚、とか儚げ、とかそういう言葉が似合う女の人だった。",
        "message": "非要说的话，她是个更适合用清纯、缥缈这类词语来形容的女性。",
        "text_idx": [
            2354,
            2355
        ]
    },
    {
        "ori": "それはそれで、大財閥のご令嬢って言葉にはあってるけど。",
        "message": "不过，这倒也确实符合大财阀千金的身份就是了。",
        "text_idx": [
            2370,
            2371
        ]
    },
    {
        "name": "智継",
        "name_idx": 2391,
        "ori": "「……すげぇな」",
        "message": "「……真厉害啊」",
        "text_idx": [
            2400
        ]
    },
    {
        "name": "ことの",
        "name_idx": 2420,
        "ori": "「間近で見たのは初めてだけど……綺麗な人だよね……」",
        "message": "「虽然我是第一次这么近距离地看到她……但真是个美人呢……」",
        "text_idx": [
            2429
        ]
    },
    {
        "name": "亮",
        "name_idx": 2435,
        "ori": "「うん……そうだな」",
        "message": "「嗯……是啊」",
        "text_idx": [
            2444
        ]
    },
    {
        "ori": "目を奪われるっていうのは、こういうことなんだなぁ、なんて思ってしまう。",
        "message": "我不禁心想，所谓的令人目不转睛，大概就是这么一回事吧。",
        "text_idx": [
            2459,
            2460
        ]
    },
    {
        "ori": "ファンクラブまであるっていうのも納得だよなぁ……",
        "message": "也难怪她会有粉丝俱乐部了啊……",
        "text_idx": [
            2475
        ]
    },
    {
        "name": "紬",
        "name_idx": 2553,
        "ori": "「……あら？」",
        "message": "「……咦？」",
        "text_idx": [
            2562
        ]
    },
    {
        "ori": "ん……？",
        "message": "嗯……？",
        "text_idx": [
            2577
        ]
    },
    {
        "ori": "今、一瞬目が……",
        "message": "刚才，一瞬间，视线……",
        "text_idx": [
            2592
        ]
    },
    {
        "name": "智継",
        "name_idx": 2777,
        "ori": "「おおっ！？今、今、俺と目が会ったよな！？　な！？」",
        "message": "「哦哦！？刚、刚才，她跟我对上眼了吧！？　对吧！？」",
        "text_idx": [
            2786,
            2787
        ]
    },
    {
        "ori": "……う、い、いや、気のせいだよな。うん",
        "message": "……唔、不、不对，是我的错觉吧。嗯",
        "text_idx": [
            2802
        ]
    },
    {
        "ori": "智継みたいな自意識過剰をしてしまった。",
        "message": "我变得和智继一样自作多情了。",
        "text_idx": [
            2817
        ]
    },
    {
        "name": "紬",
        "name_idx": 2925,
        "ori": "「…………」",
        "message": "「…………」",
        "text_idx": [
            2934
        ]
    },
    {
        "ori": "え……？",
        "message": "咦……？",
        "text_idx": [
            3168
        ]
    },
    {
        "ori": "なんだか、まっすぐこっちを見て、歩いているような……",
        "message": "总觉得，她好像正笔直地望着这边走过来……",
        "text_idx": [
            3183
        ]
    },
    {
        "name": "ことの",
        "name_idx": 3291,
        "ori": "「あ、あれ……？」",
        "message": "「啊、咦……？」",
        "text_idx": [
            3300
        ]
    },
    {
        "ori": "ことのも、所在なげに周りを見回している。",
        "message": "琴乃也局促不安地环顾着四周。",
        "text_idx": [
            3466
        ]
    },
    {
        "ori": "こっちの方をまっすぐに見つめて、歩いてきて…………ええっ！？",
        "message": "她笔直地盯着这边，走了过来…………欸欸！？",
        "text_idx": [
            3481,
            3482
        ]
    },
    {
        "name": "紬",
        "name_idx": 3502,
        "ori": "「おはようございます」",
        "message": "「早上好」",
        "text_idx": [
            3511
        ]
    },
    {
        "name": "亮",
        "name_idx": 3517,
        "ori": "「は、はいっ！？　あ、え、えっと、おはようございますっ！」",
        "message": "「是、是的！？　啊、呃、那个，早上好！」",
        "text_idx": [
            3526,
            3527
        ]
    },
    {
        "ori": "ち、近いっ！？　なんで学園の有名人がこんな間近に！？",
        "message": "好、好近！？　为什么学校的名人会离我这么近！？",
        "text_idx": [
            3542
        ]
    },
    {
        "name": "紬",
        "name_idx": 3615,
        "ori": "「小松原亮君……でしたわよね」",
        "message": "「你是小松原亮同学……对吧」",
        "text_idx": [
            3624
        ]
    },
    {
        "name": "亮",
        "name_idx": 3630,
        "ori": "「え……？　あ、は、はいっ」",
        "message": "「欸……？　啊、是、是的」",
        "text_idx": [
            3639
        ]
    },
    {
        "name": "ことの",
        "name_idx": 3703,
        "ori": "「え？　亮ちゃん、鷺ノ宮先輩と知り合いだったの？」",
        "message": "「欸？　小亮，你和鹭之宫前辈认识吗？」",
        "text_idx": [
            3712
        ]
    },
    {
        "name": "亮",
        "name_idx": 3718,
        "ori": "「い、いや、そんな訳ないって！」",
        "message": "「不、不是，怎么可能啊！」",
        "text_idx": [
            3727
        ]
    },
    {
        "ori": "そ、それにしても、やっぱり間近で見ても、キレイな人だな……",
        "message": "话、话说回来，就算在这么近的距离看，她也真是个美人啊……",
        "text_idx": [
            3742,
            3743
        ]
    },
    {
        "ori": "それに、所作も優雅で……",
        "message": "而且，她的举止也很优雅……",
        "text_idx": [
            3758
        ]
    },
    {
        "ori": "……そ、それに、スタイルも……",
        "message": "……而、而且，身材也……",
        "text_idx": [
            3773
        ]
    },
    {
        "ori": "って、いかん！　視線がなぜか下がりそうになったぞ！　落ち着け、落ち着け俺っ！！",
        "message": "不，不行！　我的视线不知不觉就要往下移了！　冷静，快冷静下来啊我！！",
        "text_idx": [
            3959,
            3960
        ]
    },
    {
        "name": "ことの",
        "name_idx": 4024,
        "ori": "「亮ちゃん？」",
        "message": "「小亮？」",
        "text_idx": [
            4033
        ]
    },
    {
        "name": "智継",
        "name_idx": 4209,
        "ori": "「ずりィぞ亮！　お前ばっかり！」",
        "message": "「太狡猾了，亮！就你一个人！」",
        "text_idx": [
            4218
        ]
    },
    {
        "name": "亮",
        "name_idx": 4224,
        "ori": "「はっ！？　い、いや、ええっと、そのっ、ど、どうして、鷺ノ宮先輩が……」",
        "message": "「哈！？　不、不是，那个，那个，为、为什么，鹭之宫前辈会……」",
        "text_idx": [
            4233,
            4234
        ]
    },
    {
        "name": "紬",
        "name_idx": 4361,
        "ori": "「そちらは青桐ことのさんに、椎名智継君、ですよね。美術部の方の名前は、全員存じ上げていますわ」",
        "message": "「那两位是青桐琴乃同学和椎名智继同学，对吧。美术部各位的名字，我全都记着呢」",
        "text_idx": [
            4370,
            4371
        ]
    },
    {
        "ori": "にっこりと微笑まれながら、そんなことを言われてしまう。",
        "message": "她一边灿烂地微笑着，一边对我们说了这样的话。",
        "text_idx": [
            4386,
            4387
        ]
    },
    {
        "name": "亮",
        "name_idx": 4393,
        "ori": "「へ？　美術部……？」",
        "message": "「欸？　美术部……？」",
        "text_idx": [
            4402
        ]
    },
    {
        "name": "紬",
        "name_idx": 4510,
        "ori": "「それでは、皆さんごきげんよう」",
        "message": "「那么，各位再会了」",
        "text_idx": [
            4519
        ]
    },
    {
        "ori": "にっこりと、優雅に微笑んでから鷺ノ宮先輩は靴箱へと歩いていった。",
        "message": "鹭之宫前辈优雅地嫣然一笑，随后走向了鞋柜。",
        "text_idx": [
            4548,
            4549
        ]
    },
    {
        "ori": "呆然とする、俺たち三人と周りの学生をおいて。",
        "message": "留下了目瞪口呆的我们三人，以及周围的学生。",
        "text_idx": [
            4564
        ]
    }
]