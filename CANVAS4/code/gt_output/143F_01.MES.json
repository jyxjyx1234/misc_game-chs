[
    {
        "name": "亮",
        "name_idx": 60,
        "ori": "「はぁ……」",
        "message": "「唉……」",
        "text_idx": [
            69
        ]
    },
    {
        "ori": "あれから、自己嫌悪で落ち込みまくった。",
        "message": "从那之后，我陷入了深深的自我厌恶与沮丧之中。",
        "text_idx": [
            84
        ]
    },
    {
        "name": "亮",
        "name_idx": 90,
        "ori": "「なにやってんだろ。俺……」",
        "message": "「我到底在干什么啊……」",
        "text_idx": [
            99
        ]
    },
    {
        "ori": "当たり前だけど、絵も全然進んでないし……",
        "message": "理所当然地，画也完全没有进展……",
        "text_idx": [
            114
        ]
    },
    {
        "ori": "なにより、先輩にあんな態度を取ってしまったことを後悔してしまう。",
        "message": "更重要的是，我对自己向学姐采取了那样的态度后悔不已。",
        "text_idx": [
            129,
            130
        ]
    },
    {
        "ori": "謝るのが正しいって、頭ではわかってる。",
        "message": "我脑子里明白，道歉才是正确的。",
        "text_idx": [
            145
        ]
    },
    {
        "ori": "だけど、今、改めて先輩の前に出る勇気なんて俺にはない。",
        "message": "但是，我现在根本没有勇气重新出现在学姐面前。",
        "text_idx": [
            160,
            161
        ]
    },
    {
        "name": "亮",
        "name_idx": 167,
        "ori": "「はあ……」",
        "message": "「唉……」",
        "text_idx": [
            176
        ]
    },
    {
        "ori": "イジイジと、自分が情けないことを考えてるってのもわかってる。",
        "message": "我也知道自己正畏畏缩缩地想着些丢人的事。",
        "text_idx": [
            191,
            192
        ]
    },
    {
        "ori": "わかっててどうにかできるんだったら苦労しないよな……",
        "message": "如果光是明白就能解决问题，那就不用这么辛苦了啊……",
        "text_idx": [
            207
        ]
    },
    {
        "name": "亮",
        "name_idx": 213,
        "ori": "「はぁ……」",
        "message": "「唉……」",
        "text_idx": [
            222
        ]
    },
    {
        "ori": "今日何度目かわからないため息をついていると……",
        "message": "正当我今天不知第几次叹气时……",
        "text_idx": [
            237
        ]
    },
    {
        "name": "亮",
        "name_idx": 257,
        "ori": "「あ……」",
        "message": "「啊……」",
        "text_idx": [
            266
        ]
    },
    {
        "name": "紬",
        "name_idx": 894,
        "ori": "「あ……」",
        "message": "「啊……」",
        "text_idx": [
            903
        ]
    },
    {
        "ori": "……今、一番会いたくない人が俺の視界に入ってきた。",
        "message": "……现在我最不想见到的人，出现在了我的视野里。",
        "text_idx": [
            918
        ]
    },
    {
        "name": "亮",
        "name_idx": 1100,
        "ori": "「……っ！？」",
        "message": "「……！？」",
        "text_idx": [
            1109
        ]
    },
    {
        "ori": "一瞬、あった視線を引き剥がすみたいにして顔を背ける。",
        "message": "我仿佛要撕开我们瞬间交汇的视线一般，别开了脸。",
        "text_idx": [
            1386
        ]
    },
    {
        "name": "亮",
        "name_idx": 1392,
        "ori": "「………………」",
        "message": "「………………」",
        "text_idx": [
            1401
        ]
    },
    {
        "ori": "これで、いいはずだ。",
        "message": "这样，应该就好了。",
        "text_idx": [
            1416
        ]
    },
    {
        "ori": "先輩だって、俺みたいな情けないヤツに、もうかかわりたいとは思わないだろう。",
        "message": "学姐她，应该也不想再和我这种没出息的家伙扯上关系了吧。",
        "text_idx": [
            1431,
            1432
        ]
    },
    {
        "ori": "俺は、先輩の期待を裏切ったんだから。",
        "message": "毕竟，我辜负了学姐的期待。",
        "text_idx": [
            1447
        ]
    },
    {
        "ori": "そうさ。",
        "message": "没错。",
        "text_idx": [
            1462
        ]
    },
    {
        "ori": "先輩に見る目がなかったってだけさ。",
        "message": "只是学姐看走眼了罢了。",
        "text_idx": [
            1477
        ]
    },
    {
        "ori": "そんな自虐と一緒に、先輩が俺に話しかけてくれたことまで、汚して。",
        "message": "就这样自暴自弃地，连学姐主动和我搭话这件事都被我玷污了。",
        "text_idx": [
            1492,
            1493
        ]
    },
    {
        "ori": "それさえ自分で自分がダメなヤツなんだって、言い聞かせるための道具にして。",
        "message": "甚至把那件事，当成了说服自己是个无可救药的废物的道具。",
        "text_idx": [
            1508,
            1509
        ]
    },
    {
        "ori": "そのくせ……もう一度だけ、未練たらしく先輩を目で追って……",
        "message": "可我……还是不死心地，又用目光追寻着学姐的身影……",
        "text_idx": [
            1524,
            1525
        ]
    },
    {
        "ori": "きっと、先輩もあきれて、もう俺となんて……",
        "message": "学姐肯定也对我感到厌烦，再也不想和我扯上关系了吧……",
        "text_idx": [
            1540
        ]
    },
    {
        "ori": "……って。",
        "message": "……我当时是这么想的。",
        "text_idx": [
            1831
        ]
    },
    {
        "name": "紬",
        "name_idx": 1851,
        "ori": "「……………」",
        "message": "「……………」",
        "text_idx": [
            1860
        ]
    },
    {
        "ori": "な、なんだか、こっちを見られているような……",
        "message": "怎、怎么感觉，好像有人在看我这边……",
        "text_idx": [
            1875
        ]
    },
    {
        "ori": "というか、睨まれているような……",
        "message": "不如说，感觉像是在瞪我……",
        "text_idx": [
            1890
        ]
    },
    {
        "ori": "しかも、こっちに歩いてきているような……",
        "message": "而且，好像还朝我这边走过来了……",
        "text_idx": [
            1973
        ]
    },
    {
        "ori": "た、多分こっちの方に用事があるんだろうな。",
        "message": "大、大概只是碰巧要到这边来办事吧。",
        "text_idx": [
            1988
        ]
    },
    {
        "ori": "でも、俺がいるから不機嫌な顔で仕方なくこっちに……とか。",
        "message": "不过，也有可能是因为我在这里，所以才一脸不爽地、不得已朝这边走过来……之类的。",
        "text_idx": [
            2071,
            2072
        ]
    },
    {
        "ori": "うん。俺もさっさと教室に帰ろう。",
        "message": "嗯。我也赶紧回教室吧。",
        "text_idx": [
            2087
        ]
    },
    {
        "ori": "先輩から逃げるように、その場から離れる。",
        "message": "我像是在躲着学姐一样，离开了那里。",
        "text_idx": [
            2175
        ]
    },
    {
        "name": "亮",
        "name_idx": 2202,
        "ori": "「………………」",
        "message": "「………………」",
        "text_idx": [
            2211
        ]
    },
    {
        "ori": "別に学食に用があったわけじゃないけど。",
        "message": "我倒也不是在食堂有什么事。",
        "text_idx": [
            2226
        ]
    },
    {
        "ori": "ここだったら万が一にも先輩と会うことはない……よな？",
        "message": "在这里的话，应该万万不会再碰见学姐了……吧？",
        "text_idx": [
            2241
        ]
    },
    {
        "name": "亮",
        "name_idx": 2247,
        "ori": "「……ふぅ」",
        "message": "「……呼」",
        "text_idx": [
            2256
        ]
    },
    {
        "ori": "またため息。",
        "message": "我又叹了口气。",
        "text_idx": [
            2271
        ]
    },
    {
        "ori": "安堵のため息なのか、自分に呆れてのため息なのか、それ以外のなにかなのか……",
        "message": "这声叹息，是因为安心呢，还是因为对自己感到无语呢，又或是因为其他什么呢……",
        "text_idx": [
            2286,
            2287
        ]
    },
    {
        "ori": "自分でもわからない。",
        "message": "连我自己也不知道。",
        "text_idx": [
            2302
        ]
    },
    {
        "ori": "それでも、やっぱり少しだけほっとしてしまってる。",
        "message": "即便如此，我果然还是稍微松了口气。",
        "text_idx": [
            2317
        ]
    },
    {
        "ori": "ホント逃げてるだけってのはわかってるんだけど……",
        "message": "我明明知道自己这纯粹是在逃避……",
        "text_idx": [
            2332
        ]
    },
    {
        "ori": "でも……少なくとも、しばらく先輩の顔は見られない。",
        "message": "但是……至少，暂时不用见到学姐了。",
        "text_idx": [
            2347
        ]
    },
    {
        "name": "紬",
        "name_idx": 2416,
        "ori": "「小松原くん！」",
        "message": "「小松原同学！」",
        "text_idx": [
            2425
        ]
    },
    {
        "name": "亮",
        "name_idx": 2471,
        "ori": "「……っ！」",
        "message": "「……！」",
        "text_idx": [
            2480
        ]
    },
    {
        "name": "亮",
        "name_idx": 2486,
        "ori": "「せ、先輩……？」",
        "message": "「学、学姐……？」",
        "text_idx": [
            2495
        ]
    },
    {
        "name": "紬",
        "name_idx": 2515,
        "ori": "「お話があるのですけれど、よろしいですわよね？」",
        "message": "「我有些话想说，可以的吧？」",
        "text_idx": [
            2524
        ]
    },
    {
        "name": "亮",
        "name_idx": 2530,
        "ori": "「俺は先輩に話すことなんて……」",
        "message": "「我没什么话要和学姐说……」",
        "text_idx": [
            2539
        ]
    },
    {
        "name": "紬",
        "name_idx": 2559,
        "ori": "「いいから、いらしてください」",
        "message": "「别说了，请过来吧」",
        "text_idx": [
            2568
        ]
    },
    {
        "name": "亮",
        "name_idx": 2619,
        "ori": "「お、俺のことはほっといてください！」",
        "message": "「请、请别管我了！」",
        "text_idx": [
            2628
        ]
    },
    {
        "ori": "周りの気づかれないよう、声量には気をつけたけど、どこまで意味があったかわからない。",
        "message": "我为了不让周围人注意到，特意压低了声音，但不知道这到底有没有用。",
        "text_idx": [
            2643,
            2644
        ]
    },
    {
        "name": "紬",
        "name_idx": 2708,
        "ori": "「あ……！？」",
        "message": "「啊……！？」",
        "text_idx": [
            2717
        ]
    },
    {
        "ori": "とにかく先輩から離れると、一目散に食堂を後にした。",
        "message": "总之，我为了和学姐拉开距离，便头也不回地离开了食堂。",
        "text_idx": [
            2805
        ]
    },
    {
        "ori": "なんなんだ、いったい。",
        "message": "这到底是怎么回事啊。",
        "text_idx": [
            2841
        ]
    },
    {
        "ori": "どうして、先輩はわざわざ俺なんかに……っ！",
        "message": "为什么，学姐要特意来找我这种人……！",
        "text_idx": [
            2856
        ]
    },
    {
        "ori": "わけのわからない苛立ちと……認めたくない安心感。",
        "message": "莫名其妙的烦躁……以及不想承认的安心感。",
        "text_idx": [
            2871
        ]
    },
    {
        "ori": "先輩にかまってもらえてる事が、嬉しいって感じてしまうような……",
        "message": "仿佛会因为学姐来搭理我而感到高兴一般……",
        "text_idx": [
            2886,
            2887
        ]
    },
    {
        "name": "亮",
        "name_idx": 2933,
        "ori": "「……っ！」",
        "message": "「……！」",
        "text_idx": [
            2942
        ]
    },
    {
        "ori": "速歩で廊下を歩きながら、自分の馬鹿な考えを振り払おうと頭を振る。",
        "message": "我一边快步走在走廊上，一边摇着头，试图甩掉自己愚蠢的想法。",
        "text_idx": [
            2957,
            2958
        ]
    },
    {
        "ori": "なにうぬぼれてるんだ俺は。",
        "message": "我到底是在自作多情些什么啊。",
        "text_idx": [
            2973
        ]
    },
    {
        "name": "紬",
        "name_idx": 3037,
        "ori": "「ちょっと……待ちなさい！　小松原くん！」",
        "message": "「等……等一下！　小松原同学！」",
        "text_idx": [
            3046
        ]
    },
    {
        "name": "亮",
        "name_idx": 3052,
        "ori": "「！？」",
        "message": "「！？」",
        "text_idx": [
            3061
        ]
    },
    {
        "ori": "先輩の声に周りの生徒の視線が集まる。",
        "message": "学姐的声音，让周围同学的视线都聚集了过来。",
        "text_idx": [
            3076
        ]
    },
    {
        "ori": "その声を無視して、俺は廊下を走って逃げ出していた。",
        "message": "我无视了那个声音，在走廊上拔腿就跑。",
        "text_idx": [
            3164
        ]
    },
    {
        "name": "亮",
        "name_idx": 3214,
        "ori": "「こ、ここまでくれば……」",
        "message": "「跑、跑到这里的话……」",
        "text_idx": [
            3223
        ]
    },
    {
        "ori": "先輩も諦めるだろ……",
        "message": "学姐应该也会放弃了吧……",
        "text_idx": [
            3238
        ]
    },
    {
        "ori": "それでなくても、もうじき昼休みも終わりだ。",
        "message": "再说，午休时间也快结束了。",
        "text_idx": [
            3253
        ]
    },
    {
        "ori": "授業時間の教室にまで先輩が押しかけてくることもないだろうし……",
        "message": "学姐应该也不至于会在上课时间冲进教室来吧……",
        "text_idx": [
            3268,
            3269
        ]
    },
    {
        "ori": "でも、休み時間になったら今度は教室までくるかも……",
        "message": "不过，等到了休息时间，她可能就会来教室找我了……",
        "text_idx": [
            3284
        ]
    },
    {
        "ori": "……授業が終わったら、男子トイレにでも逃げ込むか？",
        "message": "……等课上完了，要不要逃进男厕所里去？",
        "text_idx": [
            3299
        ]
    },
    {
        "name": "亮",
        "name_idx": 3305,
        "ori": "「ああ……よく考えてみれば、最初から男子トイレに逃げ込んでおけばよかったよな」",
        "message": "「啊啊……仔细想想，我一开始就该直接逃进男厕所的啊」",
        "text_idx": [
            3314,
            3315
        ]
    },
    {
        "ori": "……さすがにそれだったら先輩は追ってこないだろうし。",
        "message": "……那样的话，学姐再怎么说也不会追进来了吧。",
        "text_idx": [
            3330
        ]
    },
    {
        "ori": "追い詰められて、入り口で待つ……くらいはあるかもしれないけど、だったら一階の男子トイレに入って、窓から逃げるって手もあるし。",
        "message": "虽然她可能会把我堵在里面，守在门口……但真要那样的话，我还可以躲进一楼的男厕所，然后从窗户逃走。",
        "text_idx": [
            3345,
            3346,
            3347
        ]
    },
    {
        "ori": "なんて、馬鹿なことを考えてると……",
        "message": "就在我思考着这种蠢事的时候……",
        "text_idx": [
            3362
        ]
    },
    {
        "name": "紬",
        "name_idx": 3440,
        "ori": "「ようやく見つけましたわ……」",
        "message": "「可算找到你了……」",
        "text_idx": [
            3449
        ]
    },
    {
        "name": "亮",
        "name_idx": 3699,
        "ori": "「……！？」",
        "message": "「……！？」",
        "text_idx": [
            3708
        ]
    },
    {
        "ori": "一瞬ホラーな感覚に陥ってしまった。",
        "message": "我一瞬间有种恐怖片的感觉。",
        "text_idx": [
            3723
        ]
    },
    {
        "ori": "いや、失礼この上ないんだけど。",
        "message": "不对，我这么想实在是太失礼了。",
        "text_idx": [
            3738
        ]
    },
    {
        "name": "亮",
        "name_idx": 3744,
        "ori": "「あ、あの」",
        "message": "「那、那个」",
        "text_idx": [
            3753
        ]
    },
    {
        "name": "紬",
        "name_idx": 3861,
        "ori": "「ずいぶん逃げ回ってくれましたわね」",
        "message": "「你还真是跑了好一阵子呢」",
        "text_idx": [
            3870
        ]
    },
    {
        "name": "亮",
        "name_idx": 3948,
        "ori": "「ご、ごめんなさい。で、でも……」",
        "message": "「对、对不起。但、但是……」",
        "text_idx": [
            3957
        ]
    },
    {
        "name": "紬",
        "name_idx": 3977,
        "ori": "「でも、ではありません」",
        "message": "「没什么但是」",
        "text_idx": [
            3986
        ]
    },
    {
        "ori": "……だ、だけど……",
        "message": "……可、可是……",
        "text_idx": [
            4001
        ]
    },
    {
        "name": "男子生徒",
        "name_idx": 4021,
        "ori": "「………………」",
        "message": "「………………」",
        "text_idx": [
            4030
        ]
    },
    {
        "name": "女子生徒",
        "name_idx": 4050,
        "ori": "「………………」",
        "message": "「………………」",
        "text_idx": [
            4059
        ]
    },
    {
        "ori": "僕と先輩を遠巻きに見て、呆然としている人たち。",
        "message": "远远地围观着我和学姐，目瞪口呆的人们。",
        "text_idx": [
            4074
        ]
    },
    {
        "name": "紬",
        "name_idx": 4192,
        "ori": "「んっ……こ、コホン……」",
        "message": "「唔……咳、咳咳……」",
        "text_idx": [
            4201
        ]
    },
    {
        "ori": "ようやくそれに気づいたのか、先輩がわざとらしく咳払い。",
        "message": "或许是终于注意到了周围，学姐故意地清了清嗓子。",
        "text_idx": [
            4225,
            4226
        ]
    },
    {
        "name": "紬",
        "name_idx": 4290,
        "ori": "「小松原くん、少々付き合っていただきますわ」",
        "message": "「小松原同学，要请你陪我一下了」",
        "text_idx": [
            4299
        ]
    },
    {
        "name": "亮",
        "name_idx": 4345,
        "ori": "「え、ええっ！？」",
        "message": "「诶、诶诶！？」",
        "text_idx": [
            4354
        ]
    },
    {
        "ori": "先輩から言われるとは思わなかった。",
        "message": "我没想到学姐会这么说。",
        "text_idx": [
            4481
        ]
    },
    {
        "ori": "校舎裏に連れて行かれるような感覚を味わいながらそのまま引き摺られて行く。",
        "message": "我一边体验着仿佛要被带到教学楼后的感觉，一边就这么被她拖走了。",
        "text_idx": [
            4784,
            4785
        ]
    },
    {
        "name": "亮",
        "name_idx": 4791,
        "ori": "「あの、すごく目立ってます。せめて、手を放して」",
        "message": "「那个，我们这样太显眼了。至少，把手放开吧」",
        "text_idx": [
            4800
        ]
    },
    {
        "name": "紬",
        "name_idx": 4918,
        "ori": "「ダメですわ。手を放したらまた小松原くんは逃げてしまうでしょう？」",
        "message": "「那可不行。要是我放开手，小松原同学你又会逃跑的吧？」",
        "text_idx": [
            4927,
            4928
        ]
    },
    {
        "name": "亮",
        "name_idx": 4934,
        "ori": "「そ、それは……」",
        "message": "「这、这个……」",
        "text_idx": [
            4943
        ]
    },
    {
        "ori": "お、思ったより力が強い……じゃなくて",
        "message": "啊，她的力气比我想象的要大……不对，重点不是这个",
        "text_idx": [
            5056
        ]
    },
    {
        "name": "亮",
        "name_idx": 5076,
        "ori": "「あ……先輩！　チャ、チャイムなってますよ！　午後の授業が……」",
        "message": "「啊……学姐！　上、上课铃响了！　下午的课要……」",
        "text_idx": [
            5085,
            5086
        ]
    },
    {
        "name": "紬",
        "name_idx": 5106,
        "ori": "「いいから、来なさい」",
        "message": "「别管了，跟我来」",
        "text_idx": [
            5115
        ]
    },
    {
        "name": "亮",
        "name_idx": 5161,
        "ori": "「え、ええっ！？」",
        "message": "「诶、诶诶！？」",
        "text_idx": [
            5170
        ]
    },
    {
        "ori": "結局……",
        "message": "结果……",
        "text_idx": [
            5283
        ]
    },
    {
        "ori": "チャイムの音に、少しずつ散っていく他の生徒に注目されながら、俺は先輩に引き摺られていった……",
        "message": "在钟声中，我被渐渐散去的其他学生们行注目礼，同时被学姐拖走了……",
        "text_idx": [
            5298,
            5299
        ]
    },
    {
        "name": "亮",
        "name_idx": 5497,
        "ori": "「あ、あの……」",
        "message": "「啊，那个……」",
        "text_idx": [
            5506
        ]
    },
    {
        "ori": "引き摺られてきたのは第二美術室だった。",
        "message": "我被拖来的地方是第二美术室。",
        "text_idx": [
            5521
        ]
    },
    {
        "name": "紬",
        "name_idx": 5541,
        "ori": "「まず、一つ聞きたいことがあります」",
        "message": "「首先，我有一件事想问你」",
        "text_idx": [
            5550
        ]
    },
    {
        "name": "亮",
        "name_idx": 5556,
        "ori": "「は、はい……」",
        "message": "「是、是的……」",
        "text_idx": [
            5565
        ]
    },
    {
        "name": "紬",
        "name_idx": 5585,
        "ori": "「どうして、私から逃げ回っていたんですの？」",
        "message": "「你为什么要一直躲着我呢？」",
        "text_idx": [
            5594
        ]
    },
    {
        "name": "亮",
        "name_idx": 5600,
        "ori": "「それは、えっと、だから……」",
        "message": "「那是因为，那个，所以……」",
        "text_idx": [
            5609
        ]
    },
    {
        "name": "亮",
        "name_idx": 5615,
        "ori": "「き、昨日、先輩に失礼なことを……」",
        "message": "「昨、昨天，我对学姐做了失礼的事……」",
        "text_idx": [
            5624
        ]
    },
    {
        "name": "紬",
        "name_idx": 5644,
        "ori": "「小松原くんは悩みを抱えて、少し感情的になってしまっただけですわ」",
        "message": "「小松原同学只是因为心怀烦恼，稍微有些情绪化了而已」",
        "text_idx": [
            5653,
            5654
        ]
    },
    {
        "name": "紬",
        "name_idx": 5718,
        "ori": "「私は気になどしておりませんのに……」",
        "message": "「我根本就不在意的……」",
        "text_idx": [
            5727
        ]
    },
    {
        "name": "亮",
        "name_idx": 5733,
        "ori": "「……っ！」",
        "message": "「……！」",
        "text_idx": [
            5742
        ]
    },
    {
        "ori": "それは、鷺ノ宮先輩の優しさでは、あったんだろう。",
        "message": "这大概，是鹭之宫学姐的温柔吧。",
        "text_idx": [
            5757
        ]
    },
    {
        "ori": "それでも、自分が本気で悩んでいる事を、ただの癇癪と言われて、腹がたってしまう。",
        "message": "然而，自己真心烦恼的事情，却被说成只是一时发脾气，这让我感到很火大。",
        "text_idx": [
            5772,
            5773
        ]
    },
    {
        "ori": "たとえ、それが事実だとしても。",
        "message": "哪怕那是事实也一样。",
        "text_idx": [
            5788
        ]
    },
    {
        "ori": "それもやっぱり、自分の小ささを露わにされるだけなんだろうけど。",
        "message": "不过，那终究也只是暴露了我的器量狭小罢了。",
        "text_idx": [
            5803,
            5804
        ]
    },
    {
        "ori": "……結局、自分は母さんのことを乗り越えていないのと、同じように。",
        "message": "……说到底，就像我没能跨过母亲那道坎，是一样的。",
        "text_idx": [
            5819,
            5820
        ]
    },
    {
        "name": "紬",
        "name_idx": 5884,
        "ori": "「………………」",
        "message": "「………………」",
        "text_idx": [
            5893
        ]
    },
    {
        "ori": "そんな思考に沈んでいる俺を先輩はじっと見つめていた。",
        "message": "学姐一直静静地注视着沉浸在这种思绪中的我。",
        "text_idx": [
            5908
        ]
    },
    {
        "name": "紬",
        "name_idx": 5972,
        "ori": "「ふう……ごめんなさい。私もそのようなことを聞きたかったわけではないのですけれど……」",
        "message": "「呼……对不起。我也不是想询问那种事情……」",
        "text_idx": [
            5981,
            5982
        ]
    },
    {
        "ori": "ため息と一緒に、やれやれという風に頭を振りながら、言葉を続ける。",
        "message": "她叹了口气，无可奈何地摇着头，继续说了下去。",
        "text_idx": [
            5997,
            5998
        ]
    },
    {
        "name": "紬",
        "name_idx": 6062,
        "ori": "「小松原くん」",
        "message": "「小松原同学」",
        "text_idx": [
            6071
        ]
    },
    {
        "name": "亮",
        "name_idx": 6077,
        "ori": "「は、はい」",
        "message": "「啊、好的」",
        "text_idx": [
            6086
        ]
    },
    {
        "name": "紬",
        "name_idx": 6150,
        "ori": "「私、他人を見る眼には自信があります」",
        "message": "「我，对自己看人的眼光很有自信」",
        "text_idx": [
            6159
        ]
    },
    {
        "name": "亮",
        "name_idx": 6165,
        "ori": "「は、はあ？」",
        "message": "「啊、啊？」",
        "text_idx": [
            6174
        ]
    },
    {
        "ori": "なんだか、さっきっから、話題がぽんぽん飛ぶような……",
        "message": "总感觉，从刚才开始，话题就跳来跳去的……",
        "text_idx": [
            6189
        ]
    },
    {
        "name": "紬",
        "name_idx": 6253,
        "ori": "「だから、私が期待している人が、いつまでも悩んでいるのは、我慢ならないんですの」",
        "message": "「所以，我所期待的人，一直这样烦恼下去，我可是无法忍受的」",
        "text_idx": [
            6262,
            6263
        ]
    },
    {
        "name": "亮",
        "name_idx": 6269,
        "ori": "「え……？」",
        "message": "「诶……？」",
        "text_idx": [
            6278
        ]
    },
    {
        "name": "紬",
        "name_idx": 6342,
        "ori": "「ただ能力がなくて描けないのでしたら、誰がなにを言っても、仕方がないのでしょうけれど……」",
        "message": "「如果只是因为没有能力而画不出来的话，那不管谁说什么，想必也是无可奈何的吧……」",
        "text_idx": [
            6351,
            6352
        ]
    },
    {
        "name": "紬",
        "name_idx": 6416,
        "ori": "「そうじゃないんでしょう？」",
        "message": "「但事实并非如此，对吧？」",
        "text_idx": [
            6425
        ]
    },
    {
        "name": "亮",
        "name_idx": 6431,
        "ori": "「買いかぶり……ですよ」",
        "message": "「您太高看我了……」",
        "text_idx": [
            6440
        ]
    },
    {
        "ori": "……そうだ。そんなのは、鷺ノ宮先輩の勝手な言い分だ。",
        "message": "……没错。那种说法，不过是鹭之宫前辈一厢情愿罢了。",
        "text_idx": [
            6455
        ]
    },
    {
        "ori": "ただ、自分に能力がないだけの……",
        "message": "我只是，单纯地没有能力而已……",
        "text_idx": [
            6470
        ]
    },
    {
        "name": "紬",
        "name_idx": 6490,
        "ori": "「本当に？」",
        "message": "「真的？」",
        "text_idx": [
            6499
        ]
    },
    {
        "name": "亮",
        "name_idx": 6505,
        "ori": "「は、はい……」",
        "message": "「是、是的……」",
        "text_idx": [
            6514
        ]
    },
    {
        "name": "紬",
        "name_idx": 6578,
        "ori": "「………………」",
        "message": "「………………」",
        "text_idx": [
            6587
        ]
    },
    {
        "name": "亮",
        "name_idx": 6593,
        "ori": "「………………」",
        "message": "「………………」",
        "text_idx": [
            6602
        ]
    },
    {
        "ori": "鷺ノ宮先輩の優しい声が余計に胸にささる。",
        "message": "鹭之宫前辈温柔的声音，反而更加刺痛了我的心。",
        "text_idx": [
            6617
        ]
    },
    {
        "ori": "鷺ノ宮先輩は……俺なんかよりもっと厳しい芸術の世界に生きていて……",
        "message": "鹭之宫前辈……生活在比我这种人所处的更加严酷的艺术世界里……",
        "text_idx": [
            6632,
            6633
        ]
    },
    {
        "ori": "俺なんかよりずっと大人で……",
        "message": "比我这种人要成熟得多……",
        "text_idx": [
            6648
        ]
    },
    {
        "ori": "子供が泣きわめいているだけみたいな、俺の悩みを全部見透かされているような気がしてしまって……",
        "message": "我的烦恼就像小孩子在哭闹一样，感觉自己的一切都被她看穿了……",
        "text_idx": [
            6663,
            6664
        ]
    },
    {
        "name": "亮",
        "name_idx": 6670,
        "ori": "「大体、もし仮になにか理由があったとしてもそんなの、言った途端にただの言い訳じゃないですか」",
        "message": "「再说，就算真的有什么理由，一旦说出口，不就成了单纯的借口了吗」",
        "text_idx": [
            6679,
            6680
        ]
    },
    {
        "ori": "だから……つい、言葉を重ねてしまった。",
        "message": "所以……我不由得多说了几句。",
        "text_idx": [
            6695
        ]
    },
    {
        "ori": "そうだ。母さんのことにしたって……結局俺がそれを乗り越えられないことにしたって。",
        "message": "没错。就连我母亲的事……说到底也只是我没能跨过那道坎而已。",
        "text_idx": [
            6710,
            6711
        ]
    },
    {
        "ori": "そんなのは、言い訳にすぎない。",
        "message": "那些，都不过是借口而已。",
        "text_idx": [
            6726
        ]
    },
    {
        "ori": "ただ俺に能力がないだけで。",
        "message": "只是因为我没有能力而已。",
        "text_idx": [
            6741
        ]
    },
    {
        "name": "紬",
        "name_idx": 6805,
        "ori": "「そうかしら？」",
        "message": "「是这样吗？」",
        "text_idx": [
            6814
        ]
    },
    {
        "name": "亮",
        "name_idx": 6820,
        "ori": "「そ、そうですよ……」",
        "message": "「是、是啊……」",
        "text_idx": [
            6829
        ]
    },
    {
        "ori": "鷺ノ宮先輩の顔がまっすぐに見られない。",
        "message": "我无法直视鹭之宫前辈的脸。",
        "text_idx": [
            6844
        ]
    },
    {
        "name": "紬",
        "name_idx": 6864,
        "ori": "「私には小松原くんが言い訳しないという言い訳をして、話してくれないみたいに見えるのですけれど」",
        "message": "「在我看来，小松原同学似乎是在用「我不想找借口」为借口，不愿意和我说呢」",
        "text_idx": [
            6873,
            6874
        ]
    },
    {
        "name": "亮",
        "name_idx": 6880,
        "ori": "「え……？」",
        "message": "「诶……？」",
        "text_idx": [
            6889
        ]
    },
    {
        "name": "紬",
        "name_idx": 6953,
        "ori": "「ホントはとっても悩んでいるのに、その答えも見つけているのに、言い訳になるからって言い訳して、それに向き合ってない」",
        "message": "「你明明非常烦恼，明明也已经找到了答案，却用「这会成为借口」当借口，而不去正视它」",
        "text_idx": [
            6962,
            6963,
            6964
        ]
    },
    {
        "name": "紬",
        "name_idx": 6984,
        "ori": "「そんなふうに見えるのですけれど」",
        "message": "「在我看来就是这样呢」",
        "text_idx": [
            6993
        ]
    },
    {
        "name": "亮",
        "name_idx": 6999,
        "ori": "「そんなこと……」",
        "message": "「那种事……」",
        "text_idx": [
            7008
        ]
    },
    {
        "name": "紬",
        "name_idx": 7072,
        "ori": "「ないですか？」",
        "message": "「没有吗？」",
        "text_idx": [
            7081
        ]
    },
    {
        "name": "亮",
        "name_idx": 7087,
        "ori": "「………………」",
        "message": "「………………」",
        "text_idx": [
            7096
        ]
    },
    {
        "name": "紬",
        "name_idx": 7160,
        "ori": "「そんな簡単に諦めるのは私が許しませんわ」",
        "message": "「我可不会允许你就这么轻易地放弃」",
        "text_idx": [
            7169
        ]
    },
    {
        "name": "紬",
        "name_idx": 7233,
        "ori": "「小松原くんには、いっぱいいっぱい悩んで、それを乗り越えて、やっぱり私の目は確かだったって証明していただかなくてはいけませんもの」",
        "message": "「小松原同学你必须尽情地烦恼，然后跨越它，以此向我证明我的眼光果然没有错才行啊」",
        "text_idx": [
            7242,
            7243,
            7244
        ]
    },
    {
        "ori": "冗談めかした、鷺ノ宮先輩の口調。",
        "message": "鹭之宫前辈半开玩笑的语气。",
        "text_idx": [
            7259
        ]
    },
    {
        "ori": "その口調に誘われるように……",
        "message": "我仿佛被她那样的语气所带动……",
        "text_idx": [
            7274
        ]
    },
    {
        "name": "亮",
        "name_idx": 7294,
        "ori": "「乗り越えた……つもりだったんですけどね」",
        "message": "「我本以为……自己已经跨过去了呢」",
        "text_idx": [
            7303
        ]
    },
    {
        "ori": "俺は話し出してしまっていた。",
        "message": "我还是开口了。",
        "text_idx": [
            7363
        ]
    },
    {
        "ori": "……",
        "message": "……",
        "text_idx": [
            7378
        ]
    },
    {
        "ori": "…………",
        "message": "…………",
        "text_idx": [
            7393
        ]
    },
    {
        "ori": "………………",
        "message": "………………",
        "text_idx": [
            7408
        ]
    },
    {
        "ori": "一度口から出たらとまらなかった。",
        "message": "话一说出口，就再也停不下来了。",
        "text_idx": [
            7526
        ]
    },
    {
        "ori": "ただの愚痴だって、自分でもわかっていた……いや思っている。",
        "message": "连我自己都明白，这不过是在发牢骚……不，我现在也这么认为。",
        "text_idx": [
            7541,
            7542
        ]
    },
    {
        "ori": "母さんのこと、自分が描けない理由。描きだした理由。",
        "message": "关于母亲的事，关于我画不出来的理由。关于我开始画画的理由。",
        "text_idx": [
            7557
        ]
    },
    {
        "ori": "乗り越えたつもりで、乗り越えていないこと。",
        "message": "关于我自以为已经跨越、却尚未跨越的事。",
        "text_idx": [
            7572
        ]
    },
    {
        "ori": "言い訳しないことを言い訳にしていると、鷺ノ宮先輩は言ったけど……",
        "message": "虽然鹭之宫前辈说我是在拿不找借口当借口……",
        "text_idx": [
            7587,
            7588
        ]
    },
    {
        "ori": "今、こうして口から出ている言葉は、どうしても自分では言い訳にしか感じられない。",
        "message": "而现在，从我口中说出的这些话，无论如何都让我感觉像是在找借口。",
        "text_idx": [
            7603,
            7604
        ]
    },
    {
        "ori": "そんなことを含めて、一切合切。",
        "message": "包括这些事在内，所有的一切。",
        "text_idx": [
            7619
        ]
    },
    {
        "ori": "自分の心の奥で溜まっている全部をさらすみたいに。",
        "message": "我仿佛要将积压在内心深处的一切，全都摊开来一般。",
        "text_idx": [
            7634
        ]
    },
    {
        "ori": "鷺ノ宮先輩に、吐露してしまっていた。",
        "message": "我向鹭之宫前辈，全都倾诉了出来。",
        "text_idx": [
            7649
        ]
    },
    {
        "name": "紬",
        "name_idx": 7713,
        "ori": "「………………」",
        "message": "「………………」",
        "text_idx": [
            7722
        ]
    },
    {
        "ori": "その間、鷺ノ宮先輩はなにも言わない。",
        "message": "在此期间，鹭之宫前辈一言不发。",
        "text_idx": [
            7737
        ]
    },
    {
        "ori": "相槌もはさまず、ただ黙って聞いていた。",
        "message": "她没有附和，只是默默地听着。",
        "text_idx": [
            7752
        ]
    },
    {
        "ori": "そして、もうなにも話すことがなくなったところで……",
        "message": "然后，在我已经无话可说的时候……",
        "text_idx": [
            7767
        ]
    },
    {
        "name": "紬",
        "name_idx": 7831,
        "ori": "「そこまでわかってるなら、もうなにをすればいいか、小松原くんはわかってるじゃないですか」",
        "message": "「既然你都明白到这个地步了，那么接下来该做什么，小松原同学不是已经很清楚了吗」",
        "text_idx": [
            7840,
            7841
        ]
    },
    {
        "ori": "何でもないことのようにそう言った。",
        "message": "她若无其事地说道。",
        "text_idx": [
            7856
        ]
    },
    {
        "name": "亮",
        "name_idx": 7862,
        "ori": "「え……？」",
        "message": "「诶……？」",
        "text_idx": [
            7871
        ]
    },
    {
        "name": "紬",
        "name_idx": 7891,
        "ori": "「小松原くん」",
        "message": "「小松原同学」",
        "text_idx": [
            7900
        ]
    },
    {
        "name": "亮",
        "name_idx": 7906,
        "ori": "「え……ふがっ！？」",
        "message": "「诶……唔！？」",
        "text_idx": [
            7915
        ]
    },
    {
        "name": "亮",
        "name_idx": 8003,
        "ori": "「ふぁ、ふぁぎのみやせんはい？」",
        "message": "「鹭、鹭之宫前辈？」",
        "text_idx": [
            8012
        ]
    },
    {
        "name": "紬",
        "name_idx": 8032,
        "ori": "「お母様に会いに行きなさい」",
        "message": "「去见你的母亲吧」",
        "text_idx": [
            8041
        ]
    },
    {
        "name": "亮",
        "name_idx": 8047,
        "ori": "「ふぇ、ふぇも……」",
        "message": "「可、可是……」",
        "text_idx": [
            8056
        ]
    },
    {
        "name": "紬",
        "name_idx": 8076,
        "ori": "「でも、なんて言って、俯いていてはいけませんわ」",
        "message": "「可不能说着‘可是’，然后就低着头哦」",
        "text_idx": [
            8085
        ]
    },
    {
        "name": "亮",
        "name_idx": 8091,
        "ori": "「………………」",
        "message": "「………………」",
        "text_idx": [
            8100
        ]
    },
    {
        "ori": "やさしく笑いながら、鷺ノ宮先輩が言う。",
        "message": "鹭之宫前辈温柔地笑着说。",
        "text_idx": [
            8115
        ]
    },
    {
        "name": "紬",
        "name_idx": 8135,
        "ori": "「原因がわかっていて、それに立ち向かわないなんて、そんな回り道、許しませんわよ？」",
        "message": "「既然已经知道了原因，却不去面对，我可不会允许你走这种弯路哦？」",
        "text_idx": [
            8144,
            8145
        ]
    },
    {
        "name": "紬",
        "name_idx": 8165,
        "ori": "「たちの悪い先輩に捕まって、無理やり背中を押されていると諦めて、ちゃんと自分と向き合いなさい」",
        "message": "「你就当自己是被坏心眼的学姐缠上了，被人强行在背后推着走，就认命吧，好好地面对自己」",
        "text_idx": [
            8174,
            8175
        ]
    },
    {
        "name": "亮",
        "name_idx": 8181,
        "ori": "「………………」",
        "message": "「………………」",
        "text_idx": [
            8190
        ]
    },
    {
        "ori": "厳しいけれどやさしい言葉。",
        "message": "严厉而又温柔的话语。",
        "text_idx": [
            8205
        ]
    },
    {
        "name": "紬",
        "name_idx": 8225,
        "ori": "「お母様に、会いに行きますね？」",
        "message": "「去见你的母亲，好吗？」",
        "text_idx": [
            8234
        ]
    },
    {
        "name": "亮",
        "name_idx": 8240,
        "ori": "「……はい」",
        "message": "「……是」",
        "text_idx": [
            8249
        ]
    },
    {
        "name": "紬",
        "name_idx": 8269,
        "ori": "「よろしい♪」",
        "message": "「很好♪」",
        "text_idx": [
            8278
        ]
    },
    {
        "ori": "ちょっとおどけた声で、鷺ノ宮先輩が言う。",
        "message": "鹭之宫前辈用略带调侃的语气说道。",
        "text_idx": [
            8293
        ]
    },
    {
        "ori": "それだけで、涙がでそうになってしまった。",
        "message": "光是这样，我就感觉眼泪快要掉下来了。",
        "text_idx": [
            8343
        ]
    },
    {
        "name": "紬",
        "name_idx": 8466,
        "ori": "「小松原くんの作品。楽しみにしてますわ」",
        "message": "「小松原同学的作品。我很期待哦」",
        "text_idx": [
            8475
        ]
    },
    {
        "name": "亮",
        "name_idx": 8481,
        "ori": "「……はい」",
        "message": "「……是」",
        "text_idx": [
            8490
        ]
    },
    {
        "name": "紬",
        "name_idx": 8554,
        "ori": "「さあ、そうと決まったらぐずぐすしてられませんわよ？絵を描くにしろ、お母様に会うにしろ、一分一秒も無駄にしてはいけませんわ」",
        "message": "「好了，既然决定了，可就不能再磨蹭了哦？无论是画画，还是去见你的母亲，一分一秒都不能浪费」",
        "text_idx": [
            8563,
            8564,
            8565
        ]
    },
    {
        "name": "亮",
        "name_idx": 8571,
        "ori": "「……え？」",
        "message": "「……诶？」",
        "text_idx": [
            8580
        ]
    },
    {
        "name": "紬",
        "name_idx": 8600,
        "ori": "「私も小松原くんに恥ずかしくないよう、今までで一番の演奏をしますから……楽しみにしていてくださいね」",
        "message": "「我也会为了不让小松原同学见笑，拿出至今为止最棒的演奏……所以请你期待哦」",
        "text_idx": [
            8609,
            8610
        ]
    },
    {
        "name": "亮",
        "name_idx": 8616,
        "ori": "「は、はい！」",
        "message": "「是、是！」",
        "text_idx": [
            8625
        ]
    },
    {
        "ori": "俺の返事に、にっこりと笑った答えてくれた鷺ノ宮先輩を後にして……",
        "message": "我告别了听到我的答复后对我嫣然一笑的鹭之宫前辈……",
        "text_idx": [
            8640,
            8641
        ]
    },
    {
        "ori": "俺は第二美術室から出て行った。",
        "message": "我走出了第二美术室。",
        "text_idx": [
            8701
        ]
    }
]