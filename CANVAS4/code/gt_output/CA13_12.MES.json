[
    {
        "name": "亮",
        "name_idx": 37,
        "ori": "「母さん！」",
        "message": "「妈！」",
        "text_idx": [
            46
        ]
    },
    {
        "name": "ゆう子",
        "name_idx": 231,
        "ori": "「お帰りなさい、亮……って、どうしたの？　すごい汗かいてるわよ？」",
        "message": "「你回来啦，亮……哎呀，你怎么了？　你出了好多汗啊？」",
        "text_idx": [
            240,
            241
        ]
    },
    {
        "name": "亮",
        "name_idx": 314,
        "ori": "「ちょっと走って帰ってきたから……それより話があるんだよ、母さん」",
        "message": "「因为我是跑着回来的……不说这个了，我有话要跟你说，妈」",
        "text_idx": [
            323,
            324
        ]
    },
    {
        "name": "ゆう子",
        "name_idx": 344,
        "ori": "「え、ええ、いいけど、何かしら？」",
        "message": "「呃、嗯，可以是可以，不过是什么事呢？」",
        "text_idx": [
            353
        ]
    },
    {
        "name": "亮",
        "name_idx": 359,
        "ori": "「母さんの絵を描かせて欲しいんだ」",
        "message": "「我想给你画张画」",
        "text_idx": [
            368
        ]
    },
    {
        "name": "ゆう子",
        "name_idx": 388,
        "ori": "「それはいいけれど……どうしたの？」",
        "message": "「那倒是可以……不过，你怎么了？」",
        "text_idx": [
            397
        ]
    },
    {
        "name": "亮",
        "name_idx": 403,
        "ori": "「じゃあ、アトリエに来てもらえる？」",
        "message": "「那么，你能来画室一趟吗？」",
        "text_idx": [
            412
        ]
    },
    {
        "name": "ゆう子",
        "name_idx": 476,
        "ori": "「アトリエ……って、でもあそこは亮の……」",
        "message": "「画室……可是，那里不是你的……」",
        "text_idx": [
            485
        ]
    },
    {
        "name": "亮",
        "name_idx": 491,
        "ori": "「アトリエで描きたいんだ。母さんも、ことのも」",
        "message": "「我想在画室里画。画妈，也画琴乃」",
        "text_idx": [
            500
        ]
    },
    {
        "name": "ゆう子",
        "name_idx": 665,
        "ori": "「……わかったわ。亮のお願いだものね。でも今はお夕飯の支度中だから、あとでいい？」",
        "message": "「……我明白了。毕竟是亮的请求嘛。不过我现在正在准备晚饭，等会儿可以吗？」",
        "text_idx": [
            674,
            675
        ]
    },
    {
        "name": "亮",
        "name_idx": 748,
        "ori": "「もちろん、いいよ。今はスケッチだけしとくから、母さんは好きにしてて」",
        "message": "「当然可以。我现在只画草稿，妈你随意就好」",
        "text_idx": [
            757,
            758
        ]
    },
    {
        "name": "ゆう子",
        "name_idx": 895,
        "ori": "「はいはい……亮は本当に絵が好きよねぇ」",
        "message": "「是是是……亮还真是喜欢画画呢」",
        "text_idx": [
            904
        ]
    },
    {
        "ori": "そうして俺は、アトリエから画材を取ってくるのだった。",
        "message": "就这样，我从画室拿来了画材。",
        "text_idx": [
            928
        ]
    }
]