["#INIT","_BGMLOAD",["BGM06"],"_GL2",[["RSBBG_f32","s_aki_f05","s_aki_f26"],["EF01","0.8"]],"手錠をかけられた亜紀は、自分が何をされたか把握できなかったのか、一瞬目を白黒させた。","だが、すぐに現状を理解し、激昂して美佐子さんを睨みつける。","_GL2",[["RSBBG_f32","s_aki_f05","s_aki_f30"],["EF01","0.4"]],"_VL",["sp_6080"],"亜紀「ちょっとっ、コレ、どういうことですかっ？」","_GL2",[["RSBBG_f32","s_misako_f06","s_misako_f12"],["EF01","0.4"]],"美佐子「……」","亜紀の問いかけに美佐子さんは何も応えず、ただ微笑むだけだ。","_GL2",[["RSBBG_f28","s_rika_f04","s_rika_f06"],["EF01","0.4"]],"_VL",["sp_6081"],"里香「先生、そろそろ……」","修司「ああ、わかってる……よし、いくぞっ」","里香に頷き返して、俺たちは一気に診察室へなだれ込んだ。","_GL2",[["RSBBG_f32","s_akiUP_f05","s_akiUP_f26","s_akiUP_f39"],["EF01","0.4"]],"_VL",["sp_6082"],"亜紀「えっ……？　和琴さん？　それに茅沼さんに……山田先生っ？」","一瞬、亜紀は棒立ちになるが、すぐに我を取り直した。","この異様な雰囲気を察したのか、警戒するように半歩後ろに下がる。","_GL2",[["RSBBG_f32","s_aki_f05","s_aki_f09","s_aki_f39"],["EF01","0.4"]],"_VL",["sp_6083"],"亜紀「あなたたち……何なの……？」","修司「いえ、勝山先生がセックスで気持ちよくなれるように、お手伝いしてあげようと」","_GL2",[["RSBBG_f32","s_rika_f04","s_rika_f08"],["EF01","0.4"]],"_VL",["sp_6084"],"里香「わざわざ先生がしてくれるんですから、感謝してくだいよ？」","俺と里香が揃って小馬鹿にしたように言うと、亜紀の眉がキッと吊り上がった。","_GL2",[["RSBBG_f32","s_aki_f05","s_aki_f30","s_aki_f39"],["EF01","0.4"]],"_VL",["sp_6085"],"亜紀「な、何をふざけたこと言ってるのっ？　そう……私を馬鹿にしてるのねっ？」","修司「いえいえ、馬鹿にするなんてとんでもない」","修司「勝山先生、セックスの気持ちよさを、知らないそうじゃないですか。それなら、俺が教えてあげようと思いまして」","_GL2",[["RSBBG_f32","s_aki_f05","s_aki_f29","s_aki_f39"],["EF01","0.4"]],"_VL",["sp_6086"],"亜紀「わけがわからないことをっ……！」","怒りのあまり、亜紀の肩はプルプルと震えた。","そして、俺など相手にしていられないといった様子で、亜紀は春菜を見る。","_GL2",[["RSBBG_f32","s_aki_f05","s_aki_f09","s_aki_f39"],["EF01","0.4"]],"_VL",["sp_6087"],"亜紀「和琴さん、これは一体どういうことかしら？」","亜紀は俺を顎で指し、続けて自分の手首にかかる手錠を二人の前にかざした。","その説明をするように迫るが……春菜は表情を和らげたまま、あらかじめしておいた、俺の指示に従って行動する。","_GL2",[["RSBBG_f32","s_haruna_f05","s_haruna_f11"],["EF01","0.4"]],"_VL",["sp_6088"],"春菜「勝山先生、それはですね……」","チラッと、春菜は美佐子さんに目で合図を送った。","_VL",["sp_6089"],"春菜「こういうことなんです」","_GL2",[["RSBBG_f32"],["EF01","0.4"]],"美佐子さんが頷き返すのを待ってから、春菜は自分の制服に手を伸ばした。","_GL2",[["RSBBG_f32","s_haruna_f03","s_haruna_f11","s_haruna_f64"],["EF01","0.4"]],"上着とスカートを脱ぎ、下着姿を亜紀の前に晒す。","_GL2",[["RSBBG_f32","s_misako_f04","s_misako_f12","s_misako_f56"],["EF01","0.4"]],"春菜と同じように、美佐子さんも服を脱いで、下着姿になった。","_GL2",[["RSBBG_f32","s_aki_f05","s_aki_f27","s_aki_f39"],["EF01","0.4"]],"_VL",["sp_6090"],"亜紀「なっ……なんでいきなり脱いでるのっ？」","_GL2",[["RSBBG_f32","s_haruna_f03","s_haruna_f11","s_haruna_f64"],["EF01","0.4"]],"_VL",["sp_6091"],"春菜「さあ、勝山先生も脱ぎましょうね……」","スウッと歩み寄り、春菜は亜紀の衣服に手を伸ばした。","_GL2",[["RSBBG_f32","s_akiUP_f05","s_akiUP_f36","s_akiUP_f39"],["EF01","0.4"]],"_VL",["sp_6092"],"亜紀「な、何するのっ！　手を離しっ……あ、あんたっ！？」","修司「おとなしくしててください」","ガシッと亜紀の身体を押さえつけた。","亜紀はじたばたと暴れるが、男の力にはかなわない。","その間に、春菜が亜紀の服を脱がせていく。","_GL2",[["RSBBG_f32","s_haruna_f03","s_haruna_f11","s_haruna_f64"],["EF01","0.4"]],"_VL",["sp_6093"],"春菜「勝山先生、じっとしていてくださいね。でないと、脱がしにくいです」","_GL2",[["RSBBG_f32","s_aki_f04","s_aki_f36","s_aki_f39"],["EF01","0.4"]],"_VL",["sp_6094"],"亜紀「わ、和琴さん……あなた、なんで……」","_GL2",[["RSBBG_f32","s_aki_f04","s_aki_f36","s_aki_f39"],["EF01","0.4"]],"春菜に服を脱がされて、亜紀は愕然とした顔になった。","信頼していた看護師に裏切られたことで、亜紀の身体から力が抜ける。","_GL2",[["black"],["EF01","0.8"]],"_GL2",[["RSBBG_f32","s_aki_f01","s_aki_f28","s_aki_f39"],["EF01","0.4"]],"そのまま抵抗することもできず、亜紀は全裸に剥かれた。","_GL2",[["RSBBG_f32"],["EF01","0.4"]],"修司「さて……美佐子さん、次はあなたの出番ですよ」","_GL2",[["RSBBG_f32","s_misako_f04","s_misako_f33","s_misako_f56"],["EF01","0.4"]],"_VL",["sp_6095"],"美佐子「……ええ、わかってるわ」","一瞬、美佐子さんは目を伏せたが、すぐに頷いた。","ここまで来たら、もう後戻りなんてできない。","そのことを理解した美佐子さんは、俺の共犯者の道を歩んでいく。","_GL2",[["RSBBG_f32","s_aki_f01","s_aki_f26","s_aki_f39"],["EF01","0.4"]],"_VL",["sp_6096"],"亜紀「み、美佐子さんっ……何をするつもりなのっ？」","ゴムチューブを手にして歩み寄ってくる美佐子さんに、亜紀は怯えて身体を揺らした。","_GL2",[["RSBBG_f32","s_akiUP_f01","s_akiUP_f36","s_akiUP_f39"],["EF01","0.4"]],"_VL",["sp_6097"],"亜紀「ちょ、ちょっと何か言いなさいよっ……えっ？　あっ、きゃああああっ！？」","_GL2",[["black"],["EF01","0.4"]],"グイッと、美佐子さんが亜紀を円イスの上に引き倒した。","そして、亜紀の上にのしかかるようにしながら、美佐子さんは素早く亜紀を円イスに縛り付けてしまった。","_BGMLOAD",["BGM11"],"_GL2",[["RSB_CG09_f01","RSB_CG09_f11","RSB_CG09_f13"],["EF01","0.8"]],"_VL",["sp_6098"],"亜紀「い、いやああああっ……！」","身体の自由を奪われ、裸に剥かれ、亜紀は叫びながら逃げ出そうとした。","だが、四肢を円イスにしっかりと縛り付けられているので、身体が揺れるだけだ。","_VL",["sp_6099"],"美佐子「ふふっ……亜紀さんのここ、全部見えるわ」","美佐子さんは亜紀のお尻を両手で掴むと、クッと左右に割り開いた。","尻肉の間に隠された肛門が、俺たちの目の前で露わになる。","_GL2",[["RSB_CG09_f01","RSB_CG09_f11","RSB_CG09_f15"],["EF01","0.4"]],"_VL",["sp_6100"],"亜紀「いやああああっ！　何するのっ、離してっ……！！」","羞恥心を思い出したように、亜紀は悲鳴を上げた。","_GL2",[["RSB_CG09_f01","RSB_CG09_f11","RSB_CG09_f14"],["EF01","0.4"]],"_VL",["sp_6101"],"亜紀「美佐子さんっ、何するのっ！？　早くこれを解いてちょうだいっ！」","_GL2",[["RSB_CG09_f01","RSB_CG09_f12","RSB_CG09_f14"],["EF01","0.4"]],"_VL",["sp_6102"],"美佐子「ごめんなさい、修くんが許可してくれないとだめなの」","_VL",["sp_6103"],"亜紀「修くん……？　それって、山田先生のことよね……？」","_GL2",[["RSB_CG09_f01","RSB_CG09_f12","RSB_CG09_f13"],["EF01","0.4"]],"_VL",["sp_6104"],"亜紀「……あっ、ま、まさか……これ、全部あんたの仕業なのねっ！？」","怒りの炎を瞳に宿して、亜紀が憤怒の表情で俺を睨みつけてきた。","修司「まあまあ、勝山先生、少しは落ち着いてください」","_VL",["sp_6105"],"亜紀「こんな格好をさせられて、落ち着いていられると思うのっ！？」","亜紀の中では、怒りが完全に羞恥心を凌駕しているようだ。","あられもない格好に恥じらうよりも、俺への怒りを燃やしている。","俺を殴りつけようと、拘束された身体を、必死になって動かそうとしている。","修司「そんな大きな声出さないで……リラックスして話し合いましょうよ」","_VL",["sp_6106"],"亜紀「ふざけないでっ！！」","亜紀の一喝が診察室に響き渡った。","あまりの声量に、つい眉をたわめてしまう。","修司「……ちょっと待ってくださいね。今、飲み物用意させますから。春菜」","_GL2",[["RSBBG_f32","s_haruna_f03","s_haruna_f12","s_haruna_f64"],["EF01","0.4"]],"_VL",["sp_6107"],"春菜「はい、わかりました」","_GL2",[["RSBBG_f32"],["EF01","0.4"]],"頷いて、春菜はとある物を用意しはじめる。","道具は一緒に持ってきたので、後は簡単な準備をするだけだ。","_GL2",[["RSB_CG09_f01","RSB_CG09_f12","RSB_CG09_f13"],["EF01","0.4"]],"_VL",["sp_6108"],"亜紀「……こんなことをして、私をどうするつもりっ？　何が目的なのっ！？」","_GL2",[["RSBBG_f32","s_rika_f04","s_rika_f08"],["EF01","0.4"]],"_VL",["sp_6109"],"里香「ふんっ、目的なんて……」","何か言おうとした里香を手で制して、俺は亜紀を見下ろす。","修司「おまえも、俺のものになってもらうことにしたんだ」","俺は人当たりのいい仮面を脱ぎ捨てて、冷たい声で言い放った。","_GL2",[["RSB_CG09_f01","RSB_CG09_f12","RSB_CG09_f14"],["EF01","0.4"]],"俺の本性を目の当たりにして、一瞬、亜紀は息を呑む。","だがすぐに勢いを取り戻し、俺に噛み付かんばかりの形相でがなりたててくる。","_GL2",[["RSB_CG09_f01","RSB_CG09_f12","RSB_CG09_f13"],["EF01","0.4"]],"_VL",["sp_6110"],"亜紀「なっ……なにを、わけのわからないことを言ってるのよっ！」","修司「春菜、用意はできたか？」","_VL",["sp_6111"],"春菜「あっ、はい。ちょうどできました」","_GL2",[["RSB_CG09_f02","RSB_CG09_f11","RSB_CG09_f20","RSB_CG09_f25"],["EF01","0.8"]],"カラカラカラッと、春菜がイルリガートルを吊り下げた点滴台を引っぱってきた。","イルリガートルには、黒い液体がなみなみと入っている。","_VL",["sp_6112"],"亜紀「そ、その道具は……まさかっ……」","ハッと、亜紀が大きく息を呑んだ。","イルリガートルを知っているらしく、これから辿る自分の運命に気づいたのだろう。","絶望する亜紀に、俺はにっこり微笑んでやる。","修司「そう、そのまさかだよ……春菜」","やれ、と目で合図を促した。","_VL",["sp_6113"],"春菜「わかりました。さあ、勝山先生、ちょっと我慢してくださいね」","_VL",["sp_6114"],"亜紀「わ、和琴さん……なに、その黒いのは……？」","_GL2",[["RSB_CG09_f02","RSB_CG09_f11","RSB_CG09_f20","RSB_CG09_f26"],["EF01","0.4"]],"_VL",["sp_6115"],"春菜「ただのコーヒーですよ。勝山先生、ブルマンがお好きだって聞いたので、それにしましたから」","_GL2",[["RSB_CG09_f02","RSB_CG09_f11","RSB_CG09_f19","RSB_CG09_f26"],["EF01","0.4"]],"_VL",["sp_6116"],"亜紀「や、やめてえっ……！　わ、和琴さん、あなた自分が何をしようとしてるか、わかってるのっ！？」","_VL",["sp_6117"],"春菜「そんなに怖がらなくても、大丈夫ですよ。コーヒーを使った浣腸は、立派な民間療法なんですから」","何かのスイッチが入ったのか、春菜はピンッと人差し指を立てて説明しはじめる。","_VL",["sp_6118"],"春菜「コーヒー浣腸は肝機能を高めて、ダイエットやガン予防に効果があるんですよ」","_VL",["sp_6119"],"春菜「腸から直接吸収することで、血液中の毒素なんかを、うまく排出できるんです」","_VL",["sp_6120"],"春菜「これは、ドイツのお医者さまだって推奨しているんですから」","俺に教えられたわけでもないのに、春菜は丁寧に解説した。","さすが健康オタ。","民間療法には詳しいようだ。","_VL",["sp_6121"],"亜紀「いやっ！　そんなことするなんて、私はいやよっ！！」","_GL2",[["RSB_CG09_f02","RSB_CG09_f11","RSB_CG09_f19","RSB_CG09_f25"],["EF01","0.4"]],"_VL",["sp_6122"],"春菜「別に痛くなんてないから、大丈夫ですよ？」","_GL2",[["RSB_CG09_f02","RSB_CG09_f11","RSB_CG09_f21","RSB_CG09_f25"],["EF01","0.4"]],"_VL",["sp_6123"],"亜紀「和琴さん、やめてっ！　お願いだから、こんなことはやめてええええっ！！」","亜紀の悲鳴が響く中、俺は春菜に合図を送る。","修司「やれ」","_VL",["sp_6124"],"春菜「まずはチューブの先端を、勝山先生のお尻に入れて……」","_BGMLOAD",["BGM06"],"_GL2",[["RSB_CG09_f03","RSB_CG09_f11","RSB_CG09_f20","RSB_CG09_f25"],["EF01","0.8"]],"_VL",["sp_6125"],"亜紀「はううううっ！？」","美佐子さんが押し広げる亜紀のお尻に、チューブの先端が差し入れられた。","_GL2",[["RSB_CG09_f03","RSB_CG09_f11","RSB_CG09_f20","RSB_CG09_f26"],["EF01","0.4"]],"_VL",["sp_6126"],"春菜「あと、コーヒーを少しずつ入れて……これでよしっ」","キュッと、春菜はイルリガートルの詮を捻った。","チューブの中をコーヒーが移動し……やがて、亜紀の肛門に到達する。","_GL2",[["RSB_CG09_f04","RSB_CG09_f11","RSB_CG09_f21","RSB_CG09_f26"],["EF01","0.8"]],"_VL",["sp_6127"],"亜紀「はううううっ……！？」","ビクンッと、亜紀のお尻が跳ね上がった。","その間にも、亜紀の直腸に、コーヒーが少しずつ流し込まれていく。","_VL",["sp_6128"],"亜紀「いや、いやっ、いやああああっ……！」","ブンブンッと頭を振りながら、亜紀はなんとかチューブを引き抜こうと、お尻を上下左右に振り乱す。","しかし、拘束された身体をそう大きく動かすことはできず、しっかりとはまったチューブが抜けることはない。","少しずつではあるが、着実に、亜紀の肛内はコーヒーで満たされていく。","_VL",["sp_6129"],"亜紀「あっ、あっ、ああああっ……！　な、中に……入ってくるううううっ……！！」","_GL2",[["RSB_CG09_f04","RSB_CG09_f11","RSB_CG09_f21","RSB_CG09_f25"],["EF01","0.4"]],"_VL",["sp_6130"],"春菜「どうですか、勝山先生……大丈夫でしょう？」","この異様な雰囲気に呑まれたのか、春菜の目は妖しく光っていた。","小刻みに詮を捻り、適量のコーヒーを亜紀のアナルに注いでいく。","その行為を、春菜は楽しんでいるようにも見える。","_VL",["sp_6131"],"美佐子「あぁっ……すごい、亜紀さんの中に、ホントに入ってる……」","美佐子さんもまた、目の前の光景に釘付けになっていた。","我を忘れた様子で、うっとりと亜紀の痴態を眺めている。","_VL",["sp_6132"],"亜紀「いやああああっ、見ないでっ、こんな姿見ないでええええっ……！」","_GL2",[["RSBBG_f32","s_rika_f04","s_rika_f10"],["EF01","0.4"]],"_VL",["sp_6133"],"里香「うふふっ、なかなか似合ってますよ、勝山先生」","心底楽しそうな笑みを浮かべて、里香は亜紀を見下ろした。","_VL",["sp_6134"],"里香「勝山先生、どんな感じですかぁ？　感想、教えてもらえません？」","_VL",["sp_6135"],"亜紀「ああああっ、だめ、だめえっ！　熱いのっ、お腹が熱いのっ……！」","_VL",["sp_6136"],"春菜「大丈夫ですよ。温めてますけど、火傷するような温度じゃないですから」","_GL2",[["RSBBG_f32","s_rika_f04","s_rika_f05"],["EF01","0.4"]],"_VL",["sp_6137"],"里香「だ、そうよ？　まったく、大げさな人ですねぇ」","里香は小馬鹿にした様子で、フンッと鼻を鳴らした。","と、何か思いついたのか、ふふっと笑う。","_GL2",[["RSBBG_f32","s_rika_f04","s_rika_f10"],["EF01","0.4"]],"_VL",["sp_6138"],"里香「あっ、春菜、ちょっとそれ止めてくんない？」","_GL2",[["RSB_CG09_f04","RSB_CG09_f11","RSB_CG09_f21","RSB_CG09_f25"],["EF01","0.4"]],"_VL",["sp_6139"],"春菜「え……？　あっ、はい、わかりました」","不思議そうな顔をしながらも、春菜は言われた通り詮を捻って、コーヒーの注入を止めた。","里香のヤツ、何勝手なことしてるんだ……？","……まあ、あの愉悦に満ちた顔は何か企んでいそうだし……ここは里香に任せてみよう。","_GL2",[["RSBBG_f32","s_rika_f04","s_rika_f09"],["EF01","0.4"]],"_VL",["sp_6140"],"里香「勝山先生の大好きなコーヒー、おいしいですかぁ？」","くすくすと笑いながら、里香が問いかけた。","コーヒーの注入が止まったことで、少しは落ち着きを取り戻したのか、亜紀は射抜くように鋭い視線を里香にぶつける。","_GL2",[["RSB_CG09_f04","RSB_CG09_f11","RSB_CG09_f19","RSB_CG09_f25"],["EF01","0.4"]],"_VL",["sp_6141"],"亜紀「くうっ……こんなことをして、タダで済むと思ってるのっ……？」","_GL2",[["RSBBG_f32","s_rika_f04","s_rika_f53"],["EF01","0.4"]],"_VL",["sp_6142"],"里香「春菜、入れて」","里香がパチッと指を鳴らして、春菜は再び詮を捻った。","_GL2",[["RSB_CG09_f04","RSB_CG09_f11","RSB_CG09_f23","RSB_CG09_f25"],["EF01","0.4"]],"_VL",["sp_6143"],"亜紀「はううううっ……！　あ、ああっ、またっ、入ってぇぇ……！？」","_GL2",[["RSBBG_f32","s_rika_f04","s_rika_f09"],["EF01","0.4"]],"_VL",["sp_6144"],"里香「ねえ、勝山先生。コーヒー、おいしいでしょう？」","里香は笑みを浮かべているが、声はまったく笑っていなかった。","瞳に氷のような冷気を宿して、苦しむ亜紀を見下ろす。","_GL2",[["RSBBG_f32","s_rika_f04","s_rika_f56"],["EF01","0.4"]],"_VL",["sp_6145"],"里香「ちゃんと、おいしいって言ってくれる？　あたし、勝山先生のそんな感想が聞きたいの」","_GL2",[["RSB_CG09_f04","RSB_CG09_f11","RSB_CG09_f23","RSB_CG09_f25"],["EF01","0.4"]],"_VL",["sp_6146"],"亜紀「そ、そんなこと……うっ、くううううっ……！？」","_GL2",[["RSBBG_f32","s_rika_f04","s_rika_f56"],["EF01","0.4"]],"_VL",["sp_6147"],"里香「もしも言ってくれるなら、また止めてあげてもいいんだけどなあ……？」","_GL2",[["RSB_CG09_f05","RSB_CG09_f11","RSB_CG09_f20","RSB_CG09_f25"],["EF01","0.8"]],"里香がもったいぶるように言うと、亜紀は迷うように瞳を揺らした。","すでに、イルリガートル内のコーヒーは、半分以下に減っている。","これ以上注入された時のことを考えたのか、亜紀はゆっくり口を開く。","_VL",["sp_6148"],"亜紀「ううっ……お……おい……しい……す……」","_GL2",[["RSBBG_f32","s_rika_f04","s_rika_f13"],["EF01","0.4"]],"_VL",["sp_6149"],"里香「んん？　なにか言った、ぜんぜん聞こえないわよ？」","里香は耳元に手を当てて、催促を促した。","その間も春菜に指示を出すことを忘れずに、コーヒーの注入量を的確に操作している。","里香なら、レイと気が合いそうだよなぁ……","亜紀をいじめることにサディスティックな悦びを覚えている里香を見ていると、そう思える。","_GL2",[["RSBBG_f32","s_rika_f04","s_rika_f54"],["EF01","0.4"]],"_VL",["sp_6150"],"里香「ほぅら、早く言わないと、もうすぐ全部入っちゃうわよー」","_GL2",[["RSB_CG09_f05","RSB_CG09_f11","RSB_CG09_f23","RSB_CG09_f25"],["EF01","0.4"]],"_VL",["sp_6151"],"亜紀「あ、ああっ……くっ！」","亜紀は悔しそうに唇を噛んで、里香を睨みつけながら口を開く。","_VL",["sp_6152"],"亜紀「お……おいしいです……こ、これでいいのっ？」","_GL2",[["RSBBG_f32","s_rika_f04","s_rika_f31"],["EF01","0.4"]],"_VL",["sp_6153"],"里香「だーめ」","_GL2",[["RSBBG_f32","s_rika_f04","s_rika_f09"],["EF01","0.4"]],"_VL",["sp_6154"],"里香「うーん、そうね……お尻で味わうコーヒーは、最高においしいです。はいっ、繰り返して」","_GL2",[["RSB_CG09_f05","RSB_CG09_f11","RSB_CG09_f19","RSB_CG09_f25"],["EF01","0.4"]],"_VL",["sp_6155"],"亜紀「お、お尻で……くぅっ……お尻で味わうコーヒーは最高においしいですぅっ！！」","半ばヤケ気味に、亜紀はあられもない言葉を言い放った。","強烈な屈辱と羞恥心で、こめかみが震えている。","_VL",["sp_6156"],"亜紀「さあ、言ったわよっ……早く止めてっ！」","_GL2",[["RSBBG_f32","s_rika_f04","s_rika_f54"],["EF01","0.4"]],"_VL",["sp_6157"],"里香「いいわよ……あーら？　ごめんなさいね、ちょっと遅かったみたい」","里香の視線の先は、空っぽになったイルリガートルに向いていた。","_GL2",[["RSB_CG09_f08","RSB_CG09_f11","RSB_CG09_f20","RSB_CG09_f25"],["EF01","0.8"]],"_VL",["sp_6158"],"亜紀「そ、そんなっ……だ、騙したのねっ……！？」","_GL2",[["RSBBG_f32","s_rika_f04","s_rika_f45"],["EF01","0.4"]],"_VL",["sp_6159"],"里香「人聞き悪いなあ。あんたが言うのが遅いのが悪いんでしょっ？」","里香は苛立ちを露わにして、亜紀のお腹の辺りを小突いた。","_GL2",[["RSB_CG09_f08","RSB_CG09_f11","RSB_CG09_f21","RSB_CG09_f25"],["EF01","0.4"]],"_VL",["sp_6160"],"亜紀「はぐううううっ！？　や、やめてっ……今、お腹は……」","唸るような声を上げて、亜紀はクッとお尻に力を込めた。","あれだけあったコーヒーが、全部直腸の中に吸い込まれたのだ。","身体の奥底から、ふつふつと便意がこみ上げてきているのだろう。","_GL2",[["RSB_CG09_f09","RSB_CG09_f11","RSB_CG09_f21","RSB_CG09_f26"],["EF01","0.8"]],"_VL",["sp_6161"],"春菜「ふふっ……勝山先生、すぐに出しちゃだめですよ。２～３分は我慢してください」","チューブを引き抜きながら、春菜は笑いながら言った。","_GL2",[["RSB_CG09_f09","RSB_CG09_f11","RSB_CG09_f22","RSB_CG09_f26"],["EF01","0.4"]],"_VL",["sp_6162"],"亜紀「はううううっ……うっ、うっ……ううっ……」","はあはあっ、と亜紀が呼吸が乱れてきた。","額からうなじにかけて汗がびっしりと滲んでいる。","修司「美佐子さん、亜紀のお尻はどんな感じになってます？」","_VL",["sp_6163"],"美佐子「すごい……ぴくぴく震えてるわ……それに、キュッて、力が入ってる……」","亜紀のお尻の感触を確かめるように、美佐子さんは両手をさわさわと動かす。","_GL2",[["RSB_CG09_f09","RSB_CG09_f11","RSB_CG09_f23","RSB_CG09_f26"],["EF01","0.4"]],"_VL",["sp_6164"],"亜紀「ひううううっ、だ、だめっ、そこはっ……！」","_GL2",[["RSB_CG09_f09","RSB_CG09_f11","RSB_CG09_f21","RSB_CG09_f25"],["EF01","0.4"]],"_VL",["sp_6165"],"春菜「勝山先生、すごい顔してます……」","_VL",["sp_6166"],"亜紀「だめなのおおおおっ、今はだめええええっ……！」","喉を振り絞るような悲鳴が、亜紀の口から飛び出た。","コーヒー浣腸が終わってから、すでに５分は経っている。","身体の内で暴れまわっている便意を押さえ込むのも、そろそろ限界だろう。","_VL",["sp_6167"],"亜紀「はっ、はっ、はっ、はっ……！」","肩を大きく上下させて、亜紀は荒く短い呼吸を繰り返す。","もう一刻の猶予もないのか、焦燥感を顔に貼り付けている。","_GL2",[["RSB_CG09_f09","RSB_CG09_f11","RSB_CG09_f20","RSB_CG09_f25"],["EF01","0.4"]],"_VL",["sp_6168"],"亜紀「あうっ、うっ、くううううっ……お、お願いっ……」","せっぱ詰まった声をあげながら、亜紀は俺を見上げた。","_VL",["sp_6169"],"亜紀「ト、トイレに……行かせ、てっ……！」","修司「なんだ、もう出そうなのか？」","コクコクコクッと、亜紀は何度も頷いた。","修司「そんなにトイレに行きたいのか？」","_VL",["sp_6170"],"亜紀「ええっ……行きたい、のっ……もう、限界……！」","修司「なんだよ、それが人に物を頼む時の態度か？　誠意、ってもんを見せてくれないとなあ」","亜紀が迷ったのは一瞬だった。","_GL2",[["RSB_CG09_f09","RSB_CG09_f11","RSB_CG09_f21","RSB_CG09_f25"],["EF01","0.4"]],"_VL",["sp_6171"],"亜紀「お、お願い、ですっ……私を、トイレに……行かせてくださいっっ……！」","切迫した状況に耐えかねた亜紀は、とことん下手に出てきた。","あれだけ高飛車だった女が、泣きそうな顔をして俺に懇願している。","やばい……今すぐ襲っちまいそうなほど、興奮してきた。","……よし、もっともっと追いつめてやろう。","修司「そうだなあ……ようし、いいだろう。トイレに行かせてやるよ」","_GL2",[["RSBBG_f32","s_rika_f04","s_rika_f38"],["EF01","0.4"]],"_VL",["sp_6172"],"里香「先生っ？　えっ、なんでですか……？」","まあ見てろ、と言うように里香に笑いかけた。","俺は軽くしゃがんで、亜紀を円イスに拘束するゴムチューブに手を伸ばす。","_GL2",[["RSBBG_f32"],["EF01","0.4"]],"修司「よいしょっと……」","_GL2",[["RSB_CG09_f09","RSB_CG09_f11","RSB_CG09_f21","RSB_CG09_f25"],["EF01","0.4"]],"_VL",["sp_6173"],"亜紀「ああっ……お願いします、早くっ、早くぅぅっ……！」","俺はのろのろとゴムチューブを解きにかかる。","でも、本気で亜紀を解放するつもりなんて、これっぽっちもない。","あれこれと手を動かして、わざと解けないフリをしてやる。","修司「んー、だめだなこりゃ。硬く結びすぎてて、とれやしない」","_GL2",[["RSB_CG09_f09","RSB_CG09_f11","RSB_CG09_f23","RSB_CG09_f25"],["EF01","0.4"]],"_VL",["sp_6174"],"亜紀「そ、そんなっ……！」","修司「悪い、やっぱ諦めてくれ」","今にも倒れそうなほど、亜紀の顔が真っ青になった。","その絶望感溢れた表情が、俺の心を昂ぶらせる。","修司「あははははっ、残念だったなあ亜紀。ははははははっ」","_GL2",[["RSBBG_f32","s_rika_f04","s_rika_f10"],["EF01","0.4"]],"_VL",["sp_6175"],"里香「ちょっとぉ、先生、笑ったら勝山先生がかわいそうですよ、うふふふっ」","俺と里香が揃って大笑いすると、亜紀の顔が屈辱に歪んだ。","_GL2",[["RSB_CG09_f09","RSB_CG09_f11","RSB_CG09_f19","RSB_CG09_f25"],["EF01","0.4"]],"_VL",["sp_6176"],"亜紀「くうっ……あ、あなたたちって人はっ……！」","俺たちを睨みつけようとした亜紀だったが。","_GL2",[["RSB_CG09_f09","RSB_CG09_f11","RSB_CG09_f21","RSB_CG09_f25"],["EF01","0.4"]],"_VL",["sp_6177"],"亜紀「あううううっ……うっ、ううっ……！」","一際強烈な便意に襲われて、すくみ上がる。","クッと顔をしかめ、歯を食いしばるようにして便意に耐えている。","だが……この様子からすると、もういくらも保たないだろう。","修司「どうだ？　まだ我慢できそうか？」","_GL2",[["RSB_CG09_f09","RSB_CG09_f11","RSB_CG09_f23","RSB_CG09_f25"],["EF01","0.4"]],"_VL",["sp_6178"],"亜紀「はううっ……こ、こんなっ……あっ、うっ、くううううっ……！」","いよいよ限界が近づいてきたのか、亜紀の太腿がブルブルと激しく震えだした。","サァーッと、全身に鳥肌が立っているのがわかる。","修司「どうやら、もう無理っぽいな」","_GL2",[["RSB_CG09_f09","RSB_CG09_f11","RSB_CG09_f21","RSB_CG09_f25"],["EF01","0.4"]],"_VL",["sp_6179"],"亜紀「お願、いいいいっ……トイレにっ……トイレに、行かせてぇっ……！」","修司「トイレだな？　わかった、今持ってこさせるよ……里香っ、アレ頼む」","_GL2",[["RSBBG_f32","s_rika_f04","s_rika_f07"],["EF01","0.4"]],"_VL",["sp_6180"],"里香「はーい、了解でえっす」","ビシッと敬礼のまねごとをすると、里香は幼児が使うようなオマルを持ってきた。","かわいいかわいい、アヒル型のオマルだ。","_GL2",[["RSBBG_f32"],["EF01","0.4"]],"修司「お待ちかねのトイレだ。さ、いつでもクソしていいぞ」","俺はコトッと、亜紀の後ろにオマルを置いてやった。","_GL2",[["RSB_CG09_f09","RSB_CG09_f11","RSB_CG09_f23","RSB_CG09_f25"],["EF01","0.4"]],"_VL",["sp_6181"],"亜紀「そ、そんなものにっ……あううううっ……！？」","修司「イヤなのか？　だったら、床の上にぶちまければいい。ただし、掃除は自分でやれよ」","冷たく言い放ったところで、亜紀に限界が訪れる。","_GL2",[["RSB_CG09_f09","RSB_CG09_f11","RSB_CG09_f21","RSB_CG09_f25"],["EF01","0.4"]],"_VL",["sp_6182"],"亜紀「あっ！　あっ！　ああっ！　もうだめっ、だめええええええええっ……！！」","甲高い悲鳴と共に、下品で卑猥な音が診察室に響いた。","強烈な臭気をまとって、コーヒー混じりの便が、亜紀の肛門から吐き出される。","_GL2",[["RSB_CG09_f10","RSB_CG09_f11","RSB_CG09_f21","RSB_CG09_f25"],["EF01","0.4"]],"_VL",["sp_6183"],"亜紀「いやああああああああっ！　見ないでっ、見ないでええええええええっっ！！」","亜紀は半狂乱に陥って、大声で喚き散らした。","お尻に力を入れて、必死になってとめようとしているようだが、一度堰を切ってしまったものはそうそう止まらない。","結局亜紀は、俺たちの目の前で、腸内に満ちていたコーヒーと便をすべて排泄してしまった。","_GL2",[["RSB_CG09_f09","RSB_CG09_f11","RSB_CG09_f22","RSB_CG09_f25"],["EF01","0.8"]],"_VL",["sp_6184"],"春菜「すごい……」","オマルにたっぷりと溜まった亜紀の排泄物を見て、春菜が声を上げた。","_VL",["sp_6185"],"美佐子「亜紀さん、こんなに……」","美佐子さんは、目の前の光景に意識を奪われたのか、ぼうっと亜紀の痴態を眺めていた。","皆の視線が自分と自分の排泄物に突き刺さっているのを感じたのか、亜紀はイヤイヤと身体を震わせる。","_GL2",[["RSBBG_f32","s_rika_f04","s_rika_f31"],["EF01","0.4"]],"_VL",["sp_6186"],"里香「うっわ、たくさん出たのねえ……勝山先生、ひょっとして便秘だったの？」","追い打ちをかけるように、里香が呆れたような声で訊ねた。","_GL2",[["RSB_CG09_f09","RSB_CG09_f11","RSB_CG09_f21","RSB_CG09_f25"],["EF01","0.4"]],"_VL",["sp_6187"],"亜紀「いやあぁぁ……そんなこと、言わないでぇ……」","大便と一緒に抵抗する気力も排泄してしまったかのように、亜紀は力なく首を横に振った。","_GL2",[["RSB_CG09_f09","RSB_CG09_f11","RSB_CG09_f24","RSB_CG09_f25"],["EF01","0.4"]],"_VL",["sp_6188"],"亜紀「うっ、うっ、ううぅっ……なんで、私がこんな目に……うっ、ひっくっ、ううっ……」","我が身に降りかかった不幸に、頬を涙で濡らす亜紀。","……だが、まだ終わりではない。","本番はこれからなのだ。","_GL2",[["black"],["EF01","0.8"]],"_BGMLOAD",["0"],"_gend",["A24_006"],"_js2",["chart.sl2","EV2406"]]