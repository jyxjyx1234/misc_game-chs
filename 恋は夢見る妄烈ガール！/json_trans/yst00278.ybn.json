[
    {
        "name": "清露",
        "message": "「你知道我为什么生气吗？」"
    },
    {
        "name": "莲",
        "message": "「知道……」"
    },
    {
        "message": "按照昨天约定的上学时间准时到校后，夕凪同学却一脸不高兴的表情。"
    },
    {
        "name": "清露",
        "message": "「是吧。要是你说不知道，我都不知道你的脸会变成什么样呢」"
    },
    {
        "name": "清露",
        "message": "「呵呵呵……」"
    },
    {
        "message": "夕凪同学露出了狡黠的笑容。"
    },
    {
        "name": "莲",
        "message": "「好可怕好可怕」"
    },
    {
        "name": "清露",
        "message": "「什么？」"
    },
    {
        "name": "莲",
        "message": "「没什么，没什么……」"
    },
    {
        "name": "莲",
        "message": "「不过，我为什么要被骂成这样啊」"
    },
    {
        "name": "莲",
        "message": "「话说回来，什么啊……你这么针对我……该不会是对我有意思吧？」"
    },
    {
        "message": "清露「！！」"
    },
    {
        "message": "清露脸红了……。"
    },
    {
        "name": "清露",
        "message": "「啪！」"
    },
    {
        "name": "莲",
        "message": "「呃啊！！」"
    },
    {
        "message": "美少女修长的美腿狠狠地踢在了我的腹部。"
    },
    {
        "name": "清露",
        "message": "「别跟我顶嘴！！」"
    },
    {
        "name": "莲",
        "message": "「对不起啊啊」"
    },
    {
        "name": "莲",
        "message": "「哈啊哈啊……」"
    },
    {
        "name": "清露",
        "message": "「听好了，以后绝对不允许你再违背约定了，知道吗？」"
    },
    {
        "name": "莲",
        "message": "「是，对不起……」"
    },
    {
        "message": "确实，违背约定是不对的。"
    },
    {
        "name": "清露",
        "message": "「约定是绝对的……不是用来打破的……」"
    },
    {
        "name": "莲",
        "message": "「是的……」"
    },
    {
        "name": "清露",
        "message": "「你明白就好。幸好你的脸没事，不然就麻烦了」"
    },
    {
        "message": "不，我的肚子倒是遭殃了……"
    },
    {
        "name": "清露",
        "message": "「总之，这周日我们要出去玩」"
    },
    {
        "name": "莲",
        "message": "「那太好了」"
    },
    {
        "name": "清露",
        "message": "「早知道就该从一开始就找千惠，而不是你」"
    },
    {
        "name": "莲",
        "message": "「是啊……」"
    },
    {
        "name": "清露",
        "message": "「嗯，这次就原谅你了」"
    },
    {
        "name": "莲",
        "message": "「真的很抱歉……」"
    },
    {
        "name": "清露",
        "message": "「下次可不会再有了……」"
    },
    {
        "name": "清露",
        "message": "「你明白吗？」"
    },
    {
        "name": "莲",
        "message": "「是、是的……」"
    },
    {
        "message": "荒川老师拿着讲义和班级名单走进了教室。"
    },
    {
        "name": "清露",
        "message": "「啊，老师来了。那么，剩下的待会再说」"
    },
    {
        "message": "夕凪转过身去面向前方。"
    },
    {
        "name": "莲",
        "message": "「剩下的……？」"
    },
    {
        "message": "第四节英语课结束了。"
    },
    {
        "message": "尽管昨天睡得比平时多，但我还是感到强烈的困意袭来，半梦半醒地听着课。"
    },
    {
        "name": "莲",
        "message": "「哈啊，不行啊……太困了」"
    },
    {
        "name": "清露",
        "message": "「你啊，睡太多了」"
    },
    {
        "name": "莲",
        "message": "「哇！？」"
    },
    {
        "name": "清露",
        "message": "「哈……你在发什么呆啊」"
    },
    {
        "name": "莲",
        "message": "「我现在特别困啊……」"
    },
    {
        "name": "清露",
        "message": "「哦，嗯，随便你吧」"
    },
    {
        "message": "正说着，两个女生走到了清露的桌前。"
    },
    {
        "name": "葵",
        "message": "「清露酱，我听雪酱说了哦♪」"
    },
    {
        "name": "雪",
        "message": "「后天周日，我也邀请葵一起去了哦」"
    },
    {
        "message": "是美丘和汐崎。"
    },
    {
        "name": "雪",
        "message": "「……啊，是你！！」"
    },
    {
        "name": "莲",
        "message": "「啊，那时候的」"
    },
    {
        "message": "汐崎一发现我就迅速躲到了美丘身后。"
    },
    {
        "name": "葵",
        "message": "「怎么了……雪酱？」"
    },
    {
        "name": "雪",
        "message": "「这、这家伙啊……我的、内、内、内裤……」"
    },
    {
        "name": "清露",
        "message": "「诶，雪，这家伙对你做了什么吗？内裤？」"
    },
    {
        "name": "清露",
        "message": "「你这家伙……」"
    },
    {
        "name": "莲",
        "message": "「等、等等，误、误会啊！不，那是意外吧！」"
    },
    {
        "message": "而且，又不是我的错。"
    },
    {
        "name": "雪",
        "message": "「呜，现在一想起来，还是觉得浑身发冷……」"
    },
    {
        "name": "清露",
        "message": "「你这家伙，对雪做了什么啊。雪可是很怕男生的哦」"
    },
    {
        "name": "莲",
        "message": "「不、不是的，我说……」"
    },
    {
        "message": "原来如此，汐崎同学是因为怕男生才会有那种态度啊。这样就说得通了。"
    },
    {
        "name": "葵",
        "message": "「那、那个，清露酱！」"
    },
    {
        "name": "清露",
        "message": "「怎么了？」"
    },
    {
        "name": "葵",
        "message": "「九条君不是那种会做那种事的人……」"
    },
    {
        "name": "清露",
        "message": "「诶？葵，你认识这家伙吗？」"
    },
    {
        "name": "葵",
        "message": "「嗯，嗯，算是吧……」"
    },
    {
        "name": "雪",
        "message": "「啊，说起来……前几天他是来教室找葵的对吧」"
    },
    {
        "name": "莲",
        "message": "「呃，那个是……嗯」"
    },
    {
        "name": "雪",
        "message": "「难道葵也被他做了什么？」"
    },
    {
        "name": "清露",
        "message": "「你、你这家伙……绝对不会原谅你的！」"
    },
    {
        "name": "葵",
        "message": "「清露酱！那个啊，九条君是成为了我的午餐伙伴哦」"
    },
    {
        "name": "清露",
        "message": "「诶诶？！」"
    },
    {
        "name": "雪",
        "message": "「诶诶？！」"
    },
    {
        "name": "葵",
        "message": "「就是不知不觉就……嘿嘿」"
    },
    {
        "name": "清露",
        "message": "「哈……所以我一直跟你说要和我们一起在外面吃饭啊」"
    },
    {
        "name": "雪",
        "message": "「就是啊～」"
    },
    {
        "message": "看来夕凪同学一直一起吃午饭的朋友就是汐崎同学啊。"
    },
    {
        "name": "葵",
        "message": "「因为我喜欢学生食堂嘛」"
    },
    {
        "name": "清露",
        "message": "「你还真是固执呢……那种人多的地方不是很麻烦吗」"
    },
    {
        "name": "莲",
        "message": "「那、那个……你们三个关系很好吗？」"
    },
    {
        "name": "清露",
        "message": "「是啊。有什么问题吗？」"
    },
    {
        "name": "莲",
        "message": "「不，也不是说有什么问题……」"
    },
    {
        "name": "清露",
        "message": "「哦，这样」"
    },
    {
        "message": "真是糟糕的态度啊……"
    },
    {
        "message": "听说这世上存在所谓的傲娇类型，但我只见过像夕凪清露这样一直傲傲的人。"
    },
    {
        "message": "真的会有一直傲傲的偶尔娇一下的人吗？"
    },
    {
        "name": "清露",
        "message": "「雪，你的事待会儿我来处理」"
    },
    {
        "message": "处理？你打算对我做什么？"
    },
    {
        "name": "清露",
        "message": "「葵，那件事你最好再考虑一下」"
    },
    {
        "name": "葵",
        "message": "「诶～是吗……？」"
    },
    {
        "name": "莲",
        "message": "「喂，你们把我当成什么人了」"
    },
    {
        "name": "清露",
        "message": "「那么，关于后天的事……」"
    },
    {
        "name": "雪",
        "message": "「嗯，后天要玩什么呀？」"
    },
    {
        "name": "葵",
        "message": "「千惠酱的朋友也会来对吧？好期待啊♪」"
    },
    {
        "name": "清露",
        "message": "「是啊！是个新转学来的孩子，叫爱嘉。她可爱得不得了哦」"
    },
    {
        "message": "她们无视我继续聊着天。"
    },
    {
        "name": "清露",
        "message": "「前几天在上学路上遇到她，可爱得我忍不住蹭了蹭她的脸」"
    },
    {
        "name": "雪",
        "message": "「清露真的很喜欢可爱的女孩子呢～」"
    },
    {
        "name": "清露",
        "message": "「那可是生活的动力啊，可爱的女孩子就是正义！」"
    },
    {
        "name": "葵",
        "message": "「哈哈哈，真让人期待♪」"
    },
    {
        "name": "葵",
        "message": "「嗯～那个孩子该不会是九条君的妹妹吧？」"
    },
    {
        "name": "清露",
        "message": "「诶，葵你知道吗？」"
    },
    {
        "name": "葵",
        "message": "「嗯。九条君跟我说过」"
    },
    {
        "name": "莲",
        "message": "「嗯，我确实说过」"
    },
    {
        "name": "清露",
        "message": "「哦～」"
    },
    {
        "name": "雪",
        "message": "「诶，他的妹妹？」"
    },
    {
        "name": "清露",
        "message": "「好像是这样。不过一点都不像呢」"
    },
    {
        "name": "雪",
        "message": "「这样啊……嗯，也行吧……」"
    },
    {
        "message": "汐崎同学露出了有点不满的表情。她该不会是那么讨厌男生吧……"
    },
    {
        "name": "清露",
        "message": "「那么，我们玩什么呢？」"
    },
    {
        "name": "雪",
        "message": "「嗯～让我想想」"
    },
    {
        "name": "葵",
        "message": "「嗯～」"
    },
    {
        "message": "三个女生沉默着开始思考要玩什么。"
    },
    {
        "message": "沉默了一会儿后，葵瞥了眼时钟，突然意识到了什么。"
    },
    {
        "name": "葵",
        "message": "「啊，休息时间快结束了！」"
    },
    {
        "name": "雪",
        "message": "「啊，真的诶。我们下节课是在化学教室对吧」"
    },
    {
        "name": "葵",
        "message": "「对哦！」"
    },
    {
        "name": "雪",
        "message": "「快走吧」"
    },
    {
        "name": "葵",
        "message": "「那再见啦，清露酱和九条君！」"
    },
    {
        "name": "雪",
        "message": "「拜拜，清露。待会儿见！」"
    },
    {
        "name": "清露",
        "message": "「嗯。待会儿再聊啊！」"
    },
    {
        "name": "莲",
        "message": "「再见」"
    },
    {
        "message": "汐崎同学从头到尾都在无视我"
    },
    {
        "name": "清露",
        "message": "「那么，我们下节课是什么来着？」"
    },
    {
        "name": "莲",
        "message": "「社会」"
    },
    {
        "name": "清露",
        "message": "「对哦，是洼冢老师」"
    },
    {
        "name": "莲",
        "message": "「嗯」"
    },
    {
        "name": "清露",
        "message": "「话说，你……也对那两个人下手了吗？」"
    },
    {
        "name": "莲",
        "message": "「不，不是的。美丘同学是如她所说的，至于汐崎同学……啊」"
    },
    {
        "name": "清露",
        "message": "「雪怎么了？」"
    },
    {
        "name": "莲",
        "message": "「忘了说寄明信片的事……」"
    },
    {
        "name": "清露",
        "message": "「明信片？」"
    },
    {
        "name": "莲",
        "message": "「今天一定要去模型店……绝对要去」"
    },
    {
        "message": "放学前的班会结束后，我把刚刚发的讲义塞进书包。"
    },
    {
        "message": "昨天最后因为一直待到放学时间的最后一刻，模型店已经关门了。"
    },
    {
        "name": "莲",
        "message": "「今天要在模型店买很多东西，好好享受周末」"
    },
    {
        "message": "这一周发生了太多密集的事情，以至于一直无法集中精力做模型。"
    },
    {
        "name": "莲",
        "message": "「希望别再出什么事了……」"
    },
    {
        "message": "我一边这么想着，一边把自己的桌子搬到后面，刚拿起书包的时候……"
    },
    {
        "name": "？？？",
        "message": "「九条君！」"
    },
    {
        "name": "莲",
        "message": "「……？」"
    },
    {
        "message": "朝声音传来的方向看去，那里站着猫城前辈。"
    },
    {
        "name": "莲",
        "message": "「猫城前辈！」"
    },
    {
        "name": "艾莉卡",
        "message": "「哟」"
    },
    {
        "name": "莲",
        "message": "「你、你来这里做什么……？」"
    },
    {
        "name": "清露",
        "message": "「啊，艾莉卡酱！」"
    },
    {
        "name": "艾莉卡",
        "message": "「哦，清露酱♪ 还是一如既往的可爱呢」"
    },
    {
        "message": "猫城前辈逼近夕凪同学，想要蹭蹭她的脸颊。"
    },
    {
        "name": "清露",
        "message": "「喂，别这样啦，快住手！」"
    },
    {
        "message": "原来千惠酱说的『艾莉卡前辈的影响』就是指这个啊……"
    },
    {
        "name": "艾莉卡",
        "message": "「诶～，可是清露酱那么可爱嘛」"
    },
    {
        "name": "清露",
        "message": "「真是的……」"
    },
    {
        "name": "清露",
        "message": "「话说回来，艾莉卡酱也认识这家伙吗？」"
    },
    {
        "name": "艾莉卡",
        "message": "「「也」？」"
    },
    {
        "name": "清露",
        "message": "「啊，那个，就是今天不知怎么的，这家伙好像还勾搭上了葵和雪」"
    },
    {
        "message": "话题怎么突然跳到这儿来了。大概，这家伙就是这种人吧。"
    },
    {
        "message": "女人这种生物真是可怕至极啊……"
    },
    {
        "name": "艾莉卡",
        "message": "「诶～！这是真的吗，九条君？」"
    },
    {
        "name": "莲",
        "message": "「不不不！我怎么可能会做那种事啊！」"
    },
    {
        "name": "艾莉卡",
        "message": "「嗯～，也是呢」"
    },
    {
        "name": "艾莉卡",
        "message": "「毕竟，九条君喜欢的类型是纯爱模……唔！」"
    },
    {
        "name": "莲",
        "message": "「等、等一下，前辈！」"
    },
    {
        "message": "我慌忙捂住了猫城前辈的嘴。"
    },
    {
        "name": "清露",
        "message": "「纯爱？什么意思？」"
    },
    {
        "name": "莲",
        "message": "「说的是小说啦」"
    },
    {
        "name": "清露",
        "message": "「啊？你写恋爱小说？」"
    },
    {
        "name": "莲",
        "message": "「（猫城前辈，那件事是秘密哦）」"
    },
    {
        "message": "我小声地说道，以免被清露听到。"
    },
    {
        "name": "艾莉卡",
        "message": "「啊，对不起」"
    },
    {
        "name": "清露",
        "message": "「我完全听不懂你们在说什么」"
    },
    {
        "name": "女子学生",
        "message": "「清露——！该去打扫卫生了哦——」"
    },
    {
        "message": "在对面门口附近，夕凪同学的清洁小组成员们在呼唤她。"
    },
    {
        "name": "清露",
        "message": "「啊，好的！这就来！」"
    },
    {
        "name": "清露",
        "message": "「那我走啦」"
    },
    {
        "name": "艾莉卡",
        "message": "「嗯。路上小心，清露酱」"
    },
    {
        "message": "猫城前辈向夕凪同学挥手道别。"
    },
    {
        "name": "莲",
        "message": "「路上小心」"
    },
    {
        "name": "莲",
        "message": "「……那么，猫城前辈，为什么在这里？」"
    },
    {
        "name": "艾莉卡",
        "message": "「我来接你啊」"
    },
    {
        "name": "莲",
        "message": "「啊，昨天的事……我完全忘记了」"
    },
    {
        "message": "我脑子里只有去模型店和休息日的事……"
    },
    {
        "name": "艾莉卡",
        "message": "「唔！我就知道会这样……你这个健忘鬼」"
    },
    {
        "name": "莲",
        "message": "「对不起」"
    },
    {
        "name": "艾莉卡",
        "message": "「咦，难道你今天有什么安排吗？」"
    },
    {
        "name": "莲",
        "message": "「不，完全没有」"
    },
    {
        "name": "艾莉卡",
        "message": "「呵呵，那就好。我们去学生会室吧」"
    },
    {
        "message": "猫城前辈用她拿手的笑容让我心跳加速。"
    },
    {
        "message": "这不是要让我陷进去了吗……"
    },
    {
        "name": "艾莉卡",
        "message": "「呼……终于结束了♪」"
    },
    {
        "name": "莲",
        "message": "「是啊……学生会的工作也挺辛苦的呢」"
    },
    {
        "name": "艾莉卡",
        "message": "「就是啊……人手也不够呢」"
    },
    {
        "name": "莲",
        "message": "「人手不够吗……不对，大家都不见了才是问题吧！」"
    },
    {
        "name": "艾莉卡",
        "message": "「嗯，虽然是这样没错……但大家好像都有安排，也没办法啊」"
    },
    {
        "message": "某种意义上这是个了不起的学生会。猫城前辈太能干了，太温柔了，这也是原因之一吧。"
    },
    {
        "message": "所以，大家都依赖猫城前辈了吧。"
    },
    {
        "name": "艾莉卡",
        "message": "「不过运动会啊文化祭之类的活动还是会分配角色的」"
    },
    {
        "name": "莲",
        "message": "「是、是这样啊……」"
    },
    {
        "message": "不过，这种繁琐的工作还是很多，艾莉卡前辈的负担还是很重啊……"
    },
    {
        "name": "莲",
        "message": "「啊，如果可以的话，这种事务性工作我可以帮忙！随时叫我就行」"
    },
    {
        "name": "艾莉卡",
        "message": "「真的吗！？」"
    },
    {
        "name": "艾莉卡",
        "message": "「谢谢你，九条君♪」"
    },
    {
        "name": "莲",
        "message": "「嗯！」"
    },
    {
        "message": "看到前辈这样的笑容，我感到胸口一阵紧缩。这就是恋爱吗。"
    },
    {
        "name": "艾莉卡",
        "message": "「那么，下周就有想请你帮忙的事，从周一开始放学后能来这里吗？」"
    },
    {
        "name": "莲",
        "message": "「啊？」"
    },
    {
        "message": "我再次意识到，尽管前辈有着令人心动的笑容和看似认真的氛围，但实际上是个相当任性的人。"
    },
    {
        "name": "艾莉卡",
        "message": "「从下周开始也要准备文化祭了，所以有很多想请你帮忙的事哦」"
    },
    {
        "name": "莲",
        "message": "「好、好的……」"
    },
    {
        "message": "我不由自主地就答应了。"
    },
    {
        "message": "虽然这么说自己有点奇怪，但我真的是个不懂得拒绝的性格啊，我这样想着。"
    },
    {
        "name": "莲",
        "message": "「嘛，反正明天休息有的是时间，模型店明天再来也行吧」"
    },
    {
        "message": "因为和猫城前辈家的方向相反，所以我们在校门口道别了。"
    },
    {
        "message": "模型店18点就关门了，所以我决定就这样直接回家。"
    },
    {
        "name": "莲",
        "message": "「话说回来，明明没有参加社团活动，转学第五天就有两次放学时间才回家，这种事还是头一回啊……」"
    },
    {
        "name": "莲",
        "message": "「猫城前辈不是坏人，被人依赖我也不讨厌，但那个人在各种意义上都很厉害啊……」"
    },
    {
        "name": "莲",
        "message": "「……咦？」"
    },
    {
        "message": "一边回想着这一周的事一边走着，前面走着一个看起来眼熟的女生身影。"
    },
    {
        "name": "莲",
        "message": "「那个……汐崎同学？」"
    },
    {
        "name": "？？？",
        "message": "「啊，是」"
    },
    {
        "message": "汐崎同学回过头来，在与我四目相对的瞬间……"
    },
    {
        "name": "雪",
        "message": "「呀！！别过来！」"
    },
    {
        "name": "莲",
        "message": "「等、等一下！是我啊，我！」"
    },
    {
        "message": "汐崎同学一边尖叫一边躲到了附近电线杆的阴影处。"
    },
    {
        "message": "幸好这条路上现在没有其他行人，不会造成误会。"
    },
    {
        "message": "话说回来，如果附近住户听到刚才的声音报警的话，我的处境就危险了……"
    },
    {
        "name": "雪",
        "message": "「啊，啊啊……是你啊……」"
    },
    {
        "message": "她的表情稍微放松了一些。"
    },
    {
        "name": "莲",
        "message": "「汐崎同学真的很讨厌男生啊……」"
    },
    {
        "name": "雪",
        "message": "「是、是这样的……所、所所所以不要再靠近我了！」"
    },
    {
        "name": "雪",
        "message": "「话说，为、为为为什么这个时间你会在这里？你不是还没有参加社团活动吗？」"
    },
    {
        "name": "莲",
        "message": "「哎呀，被拉去帮了一下学生会的忙……」"
    },
    {
        "name": "雪",
        "message": "「诶、诶……被、被艾莉卡前辈看中了呢……」"
    },
    {
        "name": "莲",
        "message": "「是啊，哈哈」"
    },
    {
        "message": "汐崎同学在电线杆的阴影处战战兢兢地露出了一个勉强的笑容。"
    },
    {
        "name": "莲",
        "message": "「汐崎同学呢？是社团活动吗？」"
    },
    {
        "name": "雪",
        "message": "「是、是是是这样的。我加入了田径部」"
    },
    {
        "name": "雪",
        "message": "「……啊，对、对对对不起。今天我、我必须早点回家！回、回回回头见！」"
    },
    {
        "name": "莲",
        "message": "「啊？」"
    },
    {
        "message": "汐崎同学飞快地从电线杆的阴影处跑开了。"
    },
    {
        "message": "我还在发愣的时候，汐崎同学的背影就已经看不见了。"
    },
    {
        "name": "莲",
        "message": "「啊，是不是哪里发生什么事了？」"
    },
    {
        "name": "爱嘉",
        "message": "「今天也回来得很晚呢？发生什么事了吗？」"
    },
    {
        "message": "刚一坐到准备好晚餐的餐桌前，爱嘉就一脸担心地观察着我的脸色问道。"
    },
    {
        "name": "莲",
        "message": "「啊，嗯……今天真是够呛啊……」"
    },
    {
        "message": "看了眼时钟，已经"
    },
    {
        "message": "快晚上8点了。"
    },
    {
        "message": "那警车的声音原来是来抓我的。"
    },
    {
        "message": "看来是附近的居民听到汐崎同学的尖叫声报了警。"
    },
    {
        "message": "我在警车里接受了警察的询问，好不容易解释清楚让他们相信了。"
    },
    {
        "name": "爱嘉",
        "message": "「够呛……该不会是被警察抓了吧？」"
    },
    {
        "message": "是因为和我在一起很久所以才知道吗，真厉害。"
    },
    {
        "name": "莲",
        "message": "「中奖了。我第一次坐上了警车」"
    },
    {
        "name": "爱嘉",
        "message": "「诶诶！哥哥，你终于犯罪了……」"
    },
    {
        "name": "莲",
        "message": "「什么叫终于啊！我什么都没做好吗！」"
    },
    {
        "name": "爱嘉",
        "message": "「可是房间里有可爱女孩子的色情手办……」"
    },
    {
        "message": "爱嘉说到这里就闭上了嘴，没有继续说下去。"
    },
    {
        "name": "莲",
        "message": "「那不是只有一个嘛……那个是因为身体线条太美了才买的」"
    },
    {
        "name": "莲",
        "message": "「看来是被误报了」"
    },
    {
        "message": "于是，我向爱嘉解释了全部经过。"
    },
    {
        "name": "爱嘉",
        "message": "「原来如此，那可真是够呛的呢……」"
    },
    {
        "name": "莲",
        "message": "「是吧？不过，这附近能这么快报警也挺让人安心的。哈哈」"
    },
    {
        "name": "爱嘉",
        "message": "「呵呵，是啊」"
    },
    {
        "name": "爱嘉",
        "message": "「啊，对了哥哥，关于后天的事」"
    },
    {
        "name": "莲",
        "message": "「后天？后天不是要和夕凪她们一起玩吗？」"
    },
    {
        "name": "爱嘉",
        "message": "「嗯。所以呢，想问问哥哥要不要一起来？」"
    },
    {
        "name": "莲",
        "message": "「我，我也去？」"
    },
    {
        "message": "明明夕凪和汐崎那么讨厌我……为什么要叫上我？"
    },
    {
        "name": "爱嘉",
        "message": "「因为她们刚来这个城市，好像想让人带她们四处看看。哥哥你觉得怎么样？」"
    },
    {
        "name": "莲",
        "message": "「嗯……我就算了吧。只有我一个男生会很尴尬的吧」"
    },
    {
        "name": "爱嘉",
        "message": "「诶诶，是这样吗？」"
    },
    {
        "name": "莲",
        "message": "「嗯。会很尴尬的，爱嘉你一个人去吧」"
    },
    {
        "message": "我周末要花时间做模型，而且说实话，只要夕凪在场我就总觉得会出什么问题，我还是……"
    },
    {
        "name": "爱嘉",
        "message": "「这样啊……」"
    },
    {
        "name": "爱嘉",
        "message": "「但是，哥哥，反正你休息的时候不就是一直在做模型吗！」"
    },
    {
        "name": "莲",
        "message": "「呃……」"
    },
    {
        "message": "被她看穿了。"
    },
    {
        "name": "爱嘉",
        "message": "「哼」"
    },
    {
        "message": "爱嘉撅起嘴，露出不满的表情。"
    },
    {
        "name": "爱嘉",
        "message": "「说起来，我的钥匙扣怎么样了？」"
    },
    {
        "name": "莲",
        "message": "「啊，对哦」"
    },
    {
        "name": "爱嘉",
        "message": "「真是的，你总是这么健忘！」"
    },
    {
        "name": "莲",
        "message": "「已经修好了，稍等一下」"
    },
    {
        "message": "我放下筷子，起身去房间取钥匙扣。"
    },
    {
        "name": "莲",
        "message": "「给」"
    },
    {
        "name": "爱嘉",
        "message": "「啊，完美！」"
    },
    {
        "name": "爱嘉",
        "message": "「谢谢哥哥♪」"
    },
    {
        "name": "莲",
        "message": "「这种程度小菜一碟」"
    },
    {
        "message": "我心想，现在说小菜一碟这种话是不是有点老土了。"
    },
    {
        "name": "爱嘉",
        "message": "「不愧是哥哥！」"
    },
    {
        "name": "莲",
        "message": "「啊，不过环氧腻子还没完全硬化，最好再等一会儿」"
    },
    {
        "name": "爱嘉",
        "message": "「环氧腻子？那是什么？」"
    },
    {
        "name": "莲",
        "message": "「环氧腻子就是环氧树脂做的腻子，这个嘛，说起来还挺复杂的……」"
    },
    {
        "name": "爱嘉",
        "message": "「停！」"
    },
    {
        "message": "她双手向前一伸，打断了我即将开始的环氧腻子长篇大论。"
    },
    {
        "name": "莲",
        "message": "「诶？」"
    },
    {
        "name": "爱嘉",
        "message": "「哥哥一说起来就没完没了，所以停！」"
    },
    {
        "name": "莲",
        "message": "「好、好吧……」"
    },
    {
        "message": "感觉有点受打击……"
    },
    {
        "name": "爱嘉",
        "message": "「总之只要等一会儿就行了吧？」"
    },
    {
        "name": "莲",
        "message": "「嗯……是的」"
    },
    {
        "name": "爱嘉",
        "message": "「别那么沮丧嘛」"
    },
    {
        "name": "莲",
        "message": "「好的……」"
    },
    {
        "name": "爱嘉",
        "message": "「唉……真是的……」"
    },
    {
        "name": "爱嘉",
        "message": "「那么，环氧腻子到底是什么啊？」"
    },
    {
        "name": "莲",
        "message": "「哦，果然你还是感兴趣啊！」"
    },
    {
        "name": "莲",
        "message": "「所谓环氧腻子呢……」"
    },
    {
        "message": "于是，我开始滔滔不绝地讲解起环氧腻子来。"
    },
    {
        "message": "之后，在爱嘉不时打哈欠的间隙中，这场讲解"
    },
    {
        "message": "一直持续到晚上9点，之后我们一起看了爱嘉喜欢的悬疑剧。"
    },
    {
        "message": "可能是因为这一周太过密集，现在的日常生活感觉格外平和。"
    },
    {
        "message": "舒适的周五夜晚。假期前夕。"
    },
    {
        "message": "嗯，这真是个美好的假期开端。"
    }
]