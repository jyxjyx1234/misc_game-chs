[
    {
        "name": "葵",
        "message": "「今天我们吃点什么呢～」"
    },
    {
        "name": "莲",
        "message": "「这周的套餐好像没有鱼类呢」"
    },
    {
        "message": "我依然和美丘保持着午餐伙伴的关系。"
    },
    {
        "message": "与其说是『保持』，不如说是『被允许保持』。"
    },
    {
        "message": "希望能继续『保持』下去。"
    },
    {
        "name": "葵",
        "message": "「是啊～呜呜」"
    },
    {
        "name": "莲",
        "message": "「美丘真的很喜欢鱼呢」"
    },
    {
        "name": "葵",
        "message": "「当然啦！比起肉我更喜欢鱼！」"
    },
    {
        "name": "莲",
        "message": "「但是，学生给人的印象更倾向于吃肉吧」"
    },
    {
        "message": "实际上，鱼类套餐似乎不太受欢迎，只在每周更换的套餐中才会出现。"
    },
    {
        "message": "而且一个月只有两次。"
    },
    {
        "name": "葵",
        "message": "「我讨厌肉食系男生！应该多一些鱼食系男生才对～！」"
    },
    {
        "name": "莲",
        "message": "「鱼食系男生……？」"
    },
    {
        "name": "葵",
        "message": "「那样的话每天都能吃到鱼了……哈」"
    },
    {
        "message": "美丘似乎正眼冒金星地沉浸在自己的妄想中。"
    },
    {
        "name": "葵",
        "message": "「九条君更喜欢哪一个呢？」"
    },
    {
        "name": "莲",
        "message": "「嗯～到底是哪个呢……」"
    },
    {
        "name": "葵",
        "message": "「哼，难以抉择吗」"
    },
    {
        "name": "莲",
        "message": "「因为两个都很好吃啊」"
    },
    {
        "name": "葵",
        "message": "「呜呜，九条君是个花心大萝卜」"
    },
    {
        "name": "莲",
        "message": "「我可是纯情男孩！」"
    },
    {
        "name": "葵",
        "message": "「那么，请做出选择吧！」"
    },
    {
        "name": "莲",
        "message": "「嗯……肉，吧？」"
    },
    {
        "name": "葵",
        "message": "「哼，九条君果然是肉食系呢……」"
    },
    {
        "name": "莲",
        "message": "「性格倒是离肉食系差远了」"
    },
    {
        "name": "葵",
        "message": "「哈哈，确实如此！」"
    },
    {
        "name": "葵",
        "message": "「不过，在恋爱方面，葵比起肉食系更喜欢九条君这样的类型哦？」"
    },
    {
        "name": "莲",
        "message": "「诶」"
    },
    {
        "message": "面对突如其来的告白，我毫无心理准备，一瞬间脑子变得一片空白。"
    },
    {
        "name": "葵",
        "message": "「啊！」"
    },
    {
        "name": "葵",
        "message": "「呜，骗，骗人的！对对对对不起！」"
    },
    {
        "name": "莲",
        "message": "「啊，不不，我很高兴哦」"
    },
    {
        "message": "我努力装出笑脸，不让她看出我的慌乱。"
    },
    {
        "name": "葵",
        "message": "「哈啊，吓死我了……」"
    },
    {
        "message": "被吓到的明明是我啊……第一次被人这么说……"
    },
    {
        "name": "葵",
        "message": "「那，那我们到食堂了。今天看起来也很拥挤呢，啊哈哈哈～」"
    },
    {
        "name": "莲",
        "message": "「嗯……鱼，吧？」"
    },
    {
        "name": "葵",
        "message": "「唔唔唔……九条君，你这种温柔是……」"
    },
    {
        "name": "葵",
        "message": "「花心大萝卜！」"
    },
    {
        "name": "莲",
        "message": "「诶诶～」"
    },
    {
        "message": "没想到为了迎合美丘而表现出的温柔反倒成了罪过……"
    },
    {
        "name": "莲",
        "message": "「我还是无法决定啊」"
    },
    {
        "name": "莲",
        "message": "「果然，两个都很好吃嘛～」"
    },
    {
        "message": "汉堡排是我的最爱，盐烤秋刀鱼我也很喜欢……"
    },
    {
        "name": "葵",
        "message": "「呵呵，九条君真是优柔寡断呢～」"
    },
    {
        "name": "葵",
        "message": "「嗯，这倒是很像九条君的作风呢」"
    },
    {
        "name": "莲",
        "message": "「哎，要说的话，鱼的骨头和内脏什么的太麻烦了！」"
    },
    {
        "name": "葵",
        "message": "「嗯，确实……不过，听说新鲜鱼的内脏很好吃呢！」"
    },
    {
        "name": "莲",
        "message": "「虽说好吃，但那苦味啊」"
    },
    {
        "name": "葵",
        "message": "「九条君还是个小孩子呢！」"
    },
    {
        "name": "莲",
        "message": "「唔，无法反驳……」"
    },
    {
        "name": "葵",
        "message": "「呵呵」"
    },
    {
        "message": "就这样聊着天，食堂越来越近了。"
    },
    {
        "name": "葵",
        "message": "「啊，今天食堂也很挤呢」"
    },
    {
        "name": "莲",
        "message": "「是啊……那我先去占座位」"
    },
    {
        "name": "葵",
        "message": "「谢谢你！」"
    },
    {
        "name": "葵",
        "message": "「多谢款待！」"
    },
    {
        "message": "最后，美丘点了炸鸡盖饭，看起来吃得很香。"
    },
    {
        "name": "莲",
        "message": "「我也偶尔在学校食堂吃吃看吧」"
    },
    {
        "name": "葵",
        "message": "「我想吃爱嘉做的料理，吃个饱！」"
    },
    {
        "name": "莲",
        "message": "「哈哈，下次来我家吃吧」"
    },
    {
        "name": "葵",
        "message": "「诶！真的可以吗！」"
    },
    {
        "name": "莲",
        "message": "「嗯。爱嘉看到美丘的吃相也会很高兴的吧」"
    },
    {
        "name": "葵",
        "message": "「太开心了。下次一定要去」"
    },
    {
        "name": "莲",
        "message": "「嗯。我也会跟爱嘉说的」"
    },
    {
        "name": "葵",
        "message": "「嘿嘿，太棒了！」"
    },
    {
        "message": "美丘露出了灿烂的笑容。"
    },
    {
        "name": "莲",
        "message": "「好嘞，下午的课也要加油啊」"
    },
    {
        "name": "葵",
        "message": "「是啊，还有文化祭的准备工作呢」"
    },
    {
        "name": "莲",
        "message": "「嗯。确实如此」"
    },
    {
        "name": "莲",
        "message": "「还有很多需要大家一起决定的事情」"
    },
    {
        "name": "葵",
        "message": "「是啊。真正开始准备后，想着要办什么样的活动，也挺有意思的」"
    },
    {
        "name": "莲",
        "message": "「这样啊，那太好了。我很期待哦！」"
    },
    {
        "name": "葵",
        "message": "「我也非常期待九条君你们的活动！」"
    },
    {
        "name": "莲",
        "message": "「我们会办一个让你笑到腹肌酸痛的活动，你就好好期待吧」"
    },
    {
        "name": "葵",
        "message": "「诶诶，腹肌酸痛吗！那我得提前锻炼腹肌才行呢」"
    },
    {
        "message": "不知为何，美丘握紧拳头，看起来斗志昂扬的样子。"
    },
    {
        "message": "看起来很有意思，于是我添了一句。"
    },
    {
        "name": "莲",
        "message": "「一天得做个一百次左右才行啊」"
    },
    {
        "name": "葵",
        "message": "「那也太严格了吧」"
    },
    {
        "name": "莲",
        "message": "「话说，虽然说要开始准备了……」"
    },
    {
        "name": "莲",
        "message": "「我从来没做过这种事，不知道该怎么做，该怎么办呢？」"
    },
    {
        "name": "清露",
        "message": "「啊？思考这个不就是你的工作吗」"
    },
    {
        "message": "放学后，我和夕凪在打扫完的教室里讨论着今后的安排。"
    },
    {
        "message": "教室里除了我之外还有几个人在愉快地闲聊。"
    },
    {
        "name": "莲",
        "message": "「那夕凪你要做什么啊」"
    },
    {
        "name": "清露",
        "message": "「我负责管理初中部，你看起来不太会使唤人的样子」"
    },
    {
        "name": "莲",
        "message": "「呜呜……你还真了解我啊……」"
    },
    {
        "name": "清露",
        "message": "「你倒是挺坦率的」"
    },
    {
        "name": "莲",
        "message": "「我一直都很坦率」"
    },
    {
        "name": "清露",
        "message": "「啊，这样啊……那么，这方面的事情问问艾莉卡酱的话，她应该会告诉你很多吧？」"
    },
    {
        "name": "清露",
        "message": "「要温柔地哦」"
    },
    {
        "name": "莲",
        "message": "「啊啊，温柔地，是吧」"
    },
    {
        "name": "清露",
        "message": "「嗯！」"
    },
    {
        "message": "夕凪用连狼都会被吓到的眼神瞪着我。"
    },
    {
        "name": "清露",
        "message": "「你喜欢年上的姐姐吧，变态」"
    },
    {
        "name": "莲",
        "message": "「年上姐姐和变态没什么关系吧？」"
    },
    {
        "name": "清露",
        "message": "「唔唔……我是说你在想色色的事情才是变态！」"
    },
    {
        "name": "莲",
        "message": "「呃，确实会幻想那种事情但是……」"
    },
    {
        "message": "感觉被巧妙地转移了话题。"
    },
    {
        "message": "而且，我很想说你不也在想色色的事情吗，但还是忍住了。"
    },
    {
        "name": "莲",
        "message": "「嘛，总之去问问猫城前辈吧」"
    },
    {
        "name": "清露",
        "message": "「要赶紧决定，不然时间就不够了哦」"
    },
    {
        "name": "莲",
        "message": "「交给我吧」"
    },
    {
        "name": "清露",
        "message": "「唉……不过，我也不抱太大期望就是了……」"
    },
    {
        "name": "清露",
        "message": "「我很期待哦」"
    },
    {
        "message": "到底是哪边啊……"
    },
    {
        "name": "莲",
        "message": "「谢谢，那我去找猫城前辈商量一下」"
    },
    {
        "name": "清露",
        "message": "「一路顺风」"
    },
    {
        "name": "莲",
        "message": "「虽然出来到走廊了……但猫城前辈在哪呢？」"
    },
    {
        "message": "说起来，我至今还没和猫城前辈交换联系方式。"
    },
    {
        "name": "莲",
        "message": "「总之先去学生会室看看吧」"
    },
    {
        "name": "莲",
        "message": "「咦……没人在啊」"
    },
    {
        "message": "学生会室空荡荡的，只是比平时桌上更乱而已。"
    },
    {
        "name": "莲",
        "message": "「今天学生会有什么活动吗……？」"
    },
    {
        "message": "我姑且看了看挂在学生会室墙上的日程表。"
    },
    {
        "name": "莲",
        "message": "「果然什么都没有啊」"
    },
    {
        "message": "日程表上详细记录了文化祭实行委员会的集会日程，甚至连各部门的日程都写得很细，但今天的栏目是空白的。"
    },
    {
        "name": "？？？",
        "message": "「打扰了！」"
    },
    {
        "name": "莲",
        "message": "「啊，千惠酱」"
    },
    {
        "name": "千惠",
        "message": "「啊，九条前辈」"
    },
    {
        "name": "莲",
        "message": "「你在干什么呢？」"
    },
    {
        "name": "千惠",
        "message": "「我来取点文件」"
    },
    {
        "name": "千惠",
        "message": "「话说，九条前辈你才是在做什么呢？」"
    },
    {
        "name": "莲",
        "message": "「我是来看日程表的……」"
    },
    {
        "name": "莲",
        "message": "「不对，是来找猫城前辈的」"
    },
    {
        "name": "千惠",
        "message": "「啊，艾莉卡前辈的话现在在三年"
    },
    {
        "message": "C班的教室哦」"
    },
    {
        "name": "莲",
        "message": "「为什么在C班」"
    },
    {
        "message": "猫城前辈应该是A班的才对。"
    },
    {
        "name": "千惠",
        "message": "「啊，是实行委员会的会计部在开会。所以叫艾莉卡前辈来帮忙了」"
    },
    {
        "name": "莲",
        "message": "「啊，原来是拿会计的文件啊」"
    },
    {
        "name": "千惠",
        "message": "「是的，就是这样！」"
    },
    {
        "name": "莲",
        "message": "「看起来挺忙的啊……」"
    },
    {
        "name": "千惠",
        "message": "「您有什么事吗？我可以帮您传话哦」"
    },
    {
        "name": "莲",
        "message": "「啊，那能不能帮我转告猫城前辈，说我有关企划的事想跟她商量一下？」"
    },
    {
        "name": "千惠",
        "message": "「明白啦！」"
    },
    {
        "message": "说着，千惠就要离开学生会室。"
    },
    {
        "name": "莲",
        "message": "「千惠，会计文件呢？」"
    },
    {
        "name": "千惠",
        "message": "「啊！差点忘了！」"
    },
    {
        "name": "莲",
        "message": "「诶，难道千惠是个冒失鬼？」"
    },
    {
        "name": "千惠",
        "message": "「呜呜呜！我才不是冒失鬼呢！这话我可不能当作没听见」"
    },
    {
        "message": "我鼓着腮帮子，抱起桌上几摞会计文件。"
    },
    {
        "name": "莲",
        "message": "「嘛，忘东西是常有的事啦」"
    },
    {
        "name": "千惠",
        "message": "「这是在安慰我吗？」"
    },
    {
        "name": "莲",
        "message": "「嗯，算是自己的经验之谈吧？」"
    },
    {
        "name": "千惠",
        "message": "「总觉得很有九条前辈的风格呢，嘻嘻」"
    },
    {
        "name": "莲",
        "message": "「这是什么意思啊？」"
    },
    {
        "name": "千惠",
        "message": "「没什么啦～」"
    },
    {
        "name": "千惠",
        "message": "「那我去转告艾莉卡前辈啦，回头见！」"
    },
    {
        "name": "莲",
        "message": "「好嘞～」"
    },
    {
        "message": "千惠刚才说的那句话到底是什么意思呢。算了，无所谓了。"
    },
    {
        "message": "总之，猫城前辈看起来很忙的样子。"
    },
    {
        "message": "嗯，我还是自己好好想想吧。"
    }
]