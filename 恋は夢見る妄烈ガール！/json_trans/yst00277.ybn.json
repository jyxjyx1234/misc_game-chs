    {
        "name": "艾莉卡",
        "message": "「那么，是什么样的梦呢？」"
    },
    {
        "message": "她兴致勃勃地盯着我的眼睛。"
    },
    {
        "name": "莲",
        "message": "「诶，什么样的……」"
    },
    {
        "name": "艾莉卡",
        "message": "「呵呵，是不是看了色色的梦啊？」"
    },
    {
        "name": "莲",
        "message": "「嗯，算是吧……」"
    },
    {
        "name": "艾莉卡",
        "message": "「告诉我内容嘛♪ 比如说，是不是被口交了之类的？」"
    },
    {
        "name": "莲",
        "message": "「诶？」"
    },
    {
        "name": "艾莉卡",
        "message": "「就是说，被口交了什么的！」"
    },
    {
        "name": "莲",
        "message": "「诶，不，不不不……那个……」"
    },
    {
        "name": "艾莉卡",
        "message": "「啊，说中了吧！」"
    },
    {
        "name": "莲",
        "message": "「呃……」"
    },
    {
        "name": "艾莉卡",
        "message": "「呵呵，原来是做了被口交的梦啊」"
    },
    {
        "name": "莲",
        "message": "「为、为什么你知道的？」"
    },
    {
        "name": "艾莉卡",
        "message": "「因为如果是我的话，也会想做这种事呢～」"
    },
    {
        "name": "莲",
        "message": "「诶，猫城前辈……？」"
    },
    {
        "name": "莲",
        "message": "「说起来昨天前辈也说过想要足交之类的话呢」"
    },
    {
        "name": "艾莉卡",
        "message": "「是啊，因为新搬来的年下男生很可爱嘛♪」"
    },
    {
        "message": "不，我不是想说这个……"
    },
    {
        "name": "莲",
        "message": "「我昨天做的梦也是足交呢」"
    },
    {
        "name": "艾莉卡",
        "message": "「诶？」"
    },
    {
        "name": "莲",
        "message": "「真的……」"
    },
    {
        "name": "艾莉卡",
        "message": "「难道说我和九条君的相性超级合拍？」"
    },
    {
        "name": "莲",
        "message": "「不不……」"
    },
    {
        "name": "艾莉卡",
        "message": "「呵呵，真可爱♪」"
    },
    {
        "name": "莲",
        "message": "「前辈，请认真考虑一下啊！」"
    },
    {
        "message": "话说，认识第二天就在讨论这种事的我也有问题吧……"
    },
    {
        "name": "艾莉卡",
        "message": "「嗯……呐，该不会你能看到我的妄想吧？」"
    },
    {
        "name": "莲",
        "message": "「前辈的妄想？」"
    },
    {
        "name": "艾莉卡",
        "message": "「嗯。因为九条君看起来更像是喜欢纯爱那种类型的吧？」"
    },
    {
        "name": "莲",
        "message": "「呃……」"
    },
    {
        "name": "艾莉卡",
        "message": "「果然没错♪」"
    },
    {
        "name": "莲",
        "message": "「是、是的……您猜对了」"
    },
    {
        "name": "艾莉卡",
        "message": "「那就是说，你不会有被宠爱的妄想吧？」"
    },
    {
        "name": "莲",
        "message": "「嗯，这个……」"
    },
    {
        "name": "艾莉卡",
        "message": "「顺便问一下，和清露酱呢？」"
    },
    {
        "name": "莲",
        "message": "「是我突然袭击她的那种场景……」"
    },
    {
        "message": "连我自己都在想，为什么要认真地聊这种话题。"
    },
    {
        "name": "艾莉卡",
        "message": "「哦～清露酱居然有这种癖好……」"
    },
    {
        "name": "莲",
        "message": "「诶，真的会有这种事吗？」"
    },
    {
        "name": "艾莉卡",
        "message": "「嘛，人们常说不能以貌取人嘛」"
    },
    {
        "message": "确实按照这个理论，和外表相反的话……"
    },
    {
        "name": "艾莉卡",
        "message": "「嗯～那么，如果这个梦不是九条君的理想，是不是就意味着很可能是来自九条君以外的外部因素呢？」"
    },
    {
        "name": "莲",
        "message": "「嗯，被你这么一说确实有这种感觉……不过，为什么突然……」"
    },
    {
        "name": "艾莉卡",
        "message": "「会不会是雷呢？」"
    },
    {
        "name": "莲",
        "message": "「雷？」"
    },
    {
        "name": "艾莉卡",
        "message": "「因为，被雷劈中却毫发无损这种事怎么可能嘛？」"
    },
    {
        "name": "莲",
        "message": "「确、确实……因为夕凪的事，我都没怎么考虑过这个……」"
    },
    {
        "name": "艾莉卡",
        "message": "「然后就嗞嗞嗞地变成这种体质了，不是吗？」"
    },
    {
        "name": "莲",
        "message": "「呃……这也太玄幻了吧……？」"
    },
    {
        "name": "艾莉卡",
        "message": "「验证时假说很重要哦」"
    },
    {
        "name": "莲",
        "message": "「确实……」"
    },
    {
        "message": "做机器人模型的时候，也经常会『根据这样的假说』来制作我的原创设计。还会不必要地在机械驱动部分的设定上下功夫。"
    },
    {
        "name": "艾莉卡",
        "message": "「所以，今天就到此为止吧」"
    },
    {
        "name": "莲",
        "message": "「要证实这个假说看来很困难啊……」"
    },
    {
        "name": "艾莉卡",
        "message": "「时间一定会给我们答案的」"
    },
    {
        "name": "莲",
        "message": "「希望如此吧」"
    },
    {
        "name": "艾莉卡",
        "message": "「那么，我们回去吧。这个就这样放着不管也没关系」"
    },
    {
        "name": "莲",
        "message": "「嗯，辛苦了」"
    },
    {
        "name": "艾莉卡",
        "message": "「明天也请多关照哦♪」"
    },
    {
        "name": "莲",
        "message": "「当然」"
    },
    {
        "name": "爱嘉",
        "message": "「今天看起来特别疲惫呢」"
    },
    {
        "name": "莲",
        "message": "「嗯，嗯，发生了不少事……」"
    },
    {
        "name": "爱嘉",
        "message": "「这、这样啊……给，今天是汉堡肉」"
    },
    {
        "message": "一盘浇着浓稠红酒酱汁的汉堡肉被端上了餐桌。"
    },
    {
        "name": "莲",
        "message": "「哦，汉堡肉真不错！」"
    },
    {
        "name": "爱嘉",
        "message": "「呵呵，哥哥喜欢的东西，大多都挺孩子气的呢」"
    },
    {
        "message": "一边说着，她一边麻利地把白米饭和沙拉摆上餐桌。"
    },
    {
        "name": "莲",
        "message": "「没关系啦，我还是个孩子嘛」"
    },
    {
        "name": "爱嘉",
        "message": "「但是，坐电车可是要付成人票价哦？」"
    },
    {
        "message": "今天的晚餐准备齐全后，爱嘉也坐到了座位上。"
    },
    {
        "name": "莲",
        "message": "「算了算了」"
    },
    {
        "name": "莲",
        "message": "「我开动啦！」"
    },
    {
        "name": "爱嘉",
        "message": "「我开动了」"
    },
    {
        "message": "先把汉堡肉送入口中。"
    },
    {
        "name": "爱嘉",
        "message": "「呐，哥哥。今天清露学姐有对你说什么吗？」"
    },
    {
        "name": "莲",
        "message": "「诶？夕凪同学？」"
    },
    {
        "name": "爱嘉",
        "message": "「嗯。刚才千惠酱联系我说，清露学姐想和我一起玩呢」"
    },
    {
        "name": "莲",
        "message": "「啊……」"
    },
    {
        "name": "爱嘉",
        "message": "「果然是这样啊」"
    },
    {
        "message": "我完全忘记了。是昨天被拜托的事。"
    },
    {
        "name": "莲",
        "message": "「原来是为这个在找我啊……」"
    },
    {
        "name": "爱嘉",
        "message": "「真是的，哥哥总是一下子就忘记自己以外的事情！」"
    },
    {
        "name": "莲",
        "message": "「哈哈，抱歉抱歉」"
    },
    {
        "message": "虽然脸上挂着笑容，但一想到明天会遭遇什么样的对待就感到恐惧。"
    },
    {
        "name": "莲",
        "message": "「那么，你们约好一起玩了吗？」"
    },
    {
        "name": "爱嘉",
        "message": "「嗯♪ 定在这周日一起玩了哦」"
    },
    {
        "name": "莲",
        "message": "「这、这样啊，那太好了。啊哈哈」"
    },
    {
        "name": "爱嘉",
        "message": "「我们还交换了联系方式哦♪」"
    },
    {
        "name": "莲",
        "message": "「是吗。和前辈建立人脉总是好事啊，哈哈哈」"
    },
    {
        "message": "连我自己都不知道在说些什么。"
    },
    {
        "name": "莲",
        "message": "「你们打算玩什么呢？」"
    },
    {
        "name": "爱嘉",
        "message": "「嗯，不知道要玩什么呢？」"
    },
    {
        "name": "莲",
        "message": "「不知道呢，看起来很有意思啊」"
    },
    {
        "message": "我继续对爱嘉露出虚假的笑容。"
    },
    {
        "name": "爱嘉",
        "message": "「……诶，哥哥，你的筷子都没动汉堡肉，是不好吃吗？」"
    },
    {
        "name": "莲",
        "message": "「啊，不，非常好吃啊！」"
    },
    {
        "message": "看来是因为想得太多明天的事，筷子都没动。"
    },
    {
        "message": "明天，不知道会受到夕凪同学什么样的责备……"
    },
    {
        "message": "最喜欢的汉堡肉都被毁了……"
    },
    {
        "message": "我决定洗完澡就立即上床睡觉。"
    },
    {
        "message": "像那第一天那样，再怎么想也无济于事。"
    },
    {
        "message": "与其为明天的事感到不安，不如早点睡觉。"
    }
]