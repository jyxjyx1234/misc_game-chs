        "name": "莲",
        "message": "「啊，嗯……」"
    },
    {
        "message": "…………。"
    },
    {
        "message": "……嗯？碍事？"
    },
    {
        "name": "雪",
        "message": "「拜拜，清露」"
    },
    {
        "name": "莲",
        "message": "「明天见」"
