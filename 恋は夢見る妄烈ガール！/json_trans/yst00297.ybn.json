[
    {
        "name": "艾莉卡",
        "message": "「那么，文化祭前的最后一次例会就到此结束。大家，从接下来的前夜祭开始尽情享受吧！」"
    },
    {
        "name": "艾莉卡",
        "message": "「嘿嘿哦！」"
    },
    {
        "message": "猫城前辈说着举起了拳头。"
    },
    {
        "message": "响应她的动作，聚集在礼堂里的文化祭执行委员们也纷纷举起了拳头。"
    },
    {
        "message": "今天是文化祭前一天。上午完成了所有布置等准备工作后才召开的例会。"
    },
    {
        "message": "接下来就是企划部的前夜祭负责人主持前夜祭，然后从明天开始就是正式活动了。我们的活动在第二天，所以第一天要做的事情就是"
    },
    {
        "message": "招募有趣的人而已。"
    },
    {
        "message": "顺便说一下，我们的企划已经准备就绪，两个项目都是昨天刚刚完成彩排。"
    },
    {
        "message": "国王的椅子和王冠都打磨得闪闪发亮，简直完美无缺。"
    },
    {
        "name": "清露",
        "message": "「呼，终于到正式演出了……我开始紧张了」"
    },
    {
        "name": "葵",
        "message": "「呜呜……不知道会不会有人来参加呢？」"
    },
    {
        "name": "雪",
        "message": "「没、没问题的……美男美女选拔每次都在举办，应该和往常一样，有趣的人决定战也一定会成功的！」"
    },
    {
        "name": "清露",
        "message": "「喂，雪……这样反而给人压力……」"
    },
    {
        "name": "莲",
        "message": "「哈哈……嘛，尽力而为就好了」"
    },
    {
        "name": "清露",
        "message": "「是、是啊……」"
    },
    {
        "name": "葵",
        "message": "「加、加油哦！」"
    },
    {
        "name": "雪",
        "message": "「我们会和美男美女选拔那边同时进行人员招募的，交给我们吧！」"
    },
    {
        "name": "清露",
        "message": "「嗯、嗯……哈」"
    },
    {
        "message": "夕凪居然会这么紧张，我能感受到她对这个企划的热情。"
    },
    {
        "name": "莲",
        "message": "「没事没事，我们不是做了那么好的传单和海报嘛。学校里看起来有意思的人我们也已经打过招呼了……彩排不是也很顺利吗？」"
    },
    {
        "name": "清露",
        "message": "「除了你摔倒的那部分以外呢」"
    },
    {
        "message": "没错，我在彩排时中途踩到了服装的下摆摔倒了。"
    },
    {
        "name": "莲",
        "message": "「啊，那个是……啊哈哈」"
    },
    {
        "name": "雪",
        "message": "「不过，我觉得那反而很有意思呢～」"
    },
    {
        "name": "葵",
        "message": "「我也觉得那里很有趣哦！」"
    },
    {
        "name": "清露",
        "message": "「诶诶，是这样吗？我觉得那里不摔倒节奏会更好呢？」"
    },
    {
        "name": "葵",
        "message": "「是这样的吗～？」"
    },
    {
        "name": "清露",
        "message": "「我觉得应该是这样的吧？」"
    },
    {
        "name": "莲",
        "message": "「好啦好啦……每个人的笑点都不一样嘛」"
    },
    {
        "name": "莲",
        "message": "「那么，我去帮忙准备前夜祭了」"
    },
    {
        "name": "清露",
        "message": "「嗯，一路顺风」"
    },
    {
        "name": "雪",
        "message": "「一路顺风！」"
    },
    {
        "name": "葵",
        "message": "「加油哦，九条君♪」"
    },
    {
        "name": "莲",
        "message": "「啊，夕凪，结束后要做最后检查哦！」"
    },
    {
        "name": "清露",
        "message": "「知道啦」"
    },
    {
        "message": "就这样，我离开了讲堂，前往体育馆帮忙准备前夜祭。"
    },
    {
        "name": "千惠",
        "message": "「啊，九条前辈」"
    },
    {
        "name": "莲",
        "message": "「嗯……啊，千惠酱」"
    },
    {
        "message": "在前往体育馆的路上，我遇到了抱着文件的千惠酱。"
    },
    {
        "name": "莲",
        "message": "「咦，你没去参加会议吗？」"
    },
    {
        "name": "千惠",
        "message": "「是的，我有些事情要做到最后一刻……」"
    },
    {
        "name": "莲",
        "message": "「千惠酱也很辛苦啊……」"
    },
    {
        "name": "千惠",
        "message": "「看起来很辛苦吗？」"
    },
    {
        "name": "莲",
        "message": "「嗯，看起来很辛苦啊？」"
    },
    {
        "name": "千惠",
        "message": "「嘿嘿♪ 我感觉自己也稍微长大了一点呢」"
    },
    {
        "name": "莲",
        "message": "「什么意思？」"
    },
    {
        "name": "千惠",
        "message": "「总感觉大人都很忙碌的样子不是吗！」"
    },
    {
        "name": "莲",
        "message": "「那是所谓的偏见吧……」"
    },
    {
        "name": "千惠",
        "message": "「诶，是这样吗？」"
    },
    {
        "name": "莲",
        "message": "「嗯，我觉得是偏见……」"
    },
    {
        "name": "千惠",
        "message": "「前辈真是个较真的人呢～」"
    },
    {
        "message": "千惠鼓起脸颊，装出一副生气的样子。"
    },
    {
        "name": "千惠",
        "message": "「……那么，前辈是去帮忙准备前夜祭吗？」"
    },
    {
        "name": "莲",
        "message": "「嗯，是啊」"
    },
    {
        "name": "千惠",
        "message": "「听说好像挺辛苦的，我会为你加油的哦」"
    },
    {
        "name": "莲",
        "message": "「诶，很辛苦吗？我听说不辛苦啊」"
    },
    {
        "name": "千惠",
        "message": "「谁知道呢，去了不就知道了吗？」"
    },
    {
        "name": "千惠",
        "message": "「我只负责会计，所以不太清楚」"
    },
    {
        "name": "莲",
        "message": "「啊……！」"
    },
    {
        "name": "千惠",
        "message": "「那么，再见！」"
    },
    {
        "name": "莲",
        "message": "「嗯、嗯。回头见」"
    },
    {
        "message": "虽然不想在前夜祭上耗尽体力……"
    },
    {
        "name": "莲",
        "message": "「呼～累死我了……千惠说得没错啊」"
    },
    {
        "name": "莲",
        "message": "「谁也没说前夜祭要搞音乐剧啊……」"
    },
    {
        "name": "莲",
        "message": "「那个社团到底是怎么回事……」"
    },
    {
        "message": "我重重地坐在体育馆里排列的椅子上。"
    },
    {
        "message": "前夜祭上，自愿参加的文化部进行了表演，还有管乐部和轻音部的演奏会等活动。"
    },
    {
        "message": "原本说好我是负责照明的，结果却变成了台上的黑衣人，搬来搬去各种道具可把我累坏了。"
    },
    {
        "name": "莲",
        "message": "「这下前夜祭总算结束了吧……」"
    },
    {
        "name": "莲",
        "message": "「呼，不知怎的我也开始紧张起来了」"
    },
    {
        "name": "清露",
        "message": "「在这儿偷什么懒呢？」"
    },
    {
        "name": "莲",
        "message": "「哦，夕凪啊」"
    },
    {
        "name": "莲",
        "message": "「前夜祭的工作有点重体力劳动」"
    },
    {
        "name": "清露",
        "message": "「哈？明天才是正戏呢。给我打起精神来！」"
    },
    {
        "name": "莲",
        "message": "「我也想打起精神啊……好吧，去做最后的道具检查吧」"
    },
    {
        "name": "清露",
        "message": "「嗯」"
    },
    {
        "message": "我拿着准备物品的清单，首先检查了放在体育馆后面的东西。"
    },
    {
        "message": "放在体育馆后面的是背景、大型道具，还有我制作的椅子等。"
    },
    {
        "name": "莲",
        "message": "「嗯，好。没有特别异常，也没有遗漏的东西」"
    },
    {
        "name": "清露",
        "message": "「嗯。我们去下一个地方吧」"
    },
    {
        "name": "莲",
        "message": "「好」"
    },
    {
        "message": "在走廊上走着的时候，太阳已经落山，周围变得昏暗了。"
    },
    {
        "message": "明天要用的小道具都放在我们班二年"
    },
    {
        "message": "C班的教室里。"
    },
    {
        "message": "二年"
    },
    {
        "message": "C班作为班级活动要在外面摆摊，所以这里成了储物间兼更衣室。我们还用隔板简单地隔出了一个临时更衣室。"
    },
    {
        "name": "莲",
        "message": "「嗯，这边也都齐全。看起来也没什么异常」"
    },
    {
        "name": "清露",
        "message": "「是啊。还有什么要做的吗？」"
    },
    {
        "name": "莲",
        "message": "「传单应该也"
    },
    {
        "message": "没问题了吧？」"
    },
    {
        "name": "清露",
        "message": "「当然。而且我把它们贴在了显眼的地方」"
    },
    {
        "message": "确实，走在走廊上时，我感觉经常能看到有趣的人决定战的传单。"
    },
    {
        "name": "莲",
        "message": "「不愧是你」"
    },
    {
        "name": "清露",
        "message": "「话说回来，这个王冠做得真是太棒了」"
    },
    {
        "name": "莲",
        "message": "「是吧」"
    },
    {
        "name": "清露",
        "message": "「真的感觉像是路易几世戴过的一样。特别是这里的装饰」"
    },
    {
        "message": "夕凪指着放在我桌上的王冠正面的装饰。"
    },
    {
        "message": "……她居然注意到了！"
    },
    {
        "name": "莲",
        "message": "「你真有眼光！那个其实是……」"
    },
    {
        "name": "清露",
        "message": "「等、等一下！」"
    },
    {
        "name": "莲",
        "message": "「啊？」"
    },
    {
        "name": "清露",
        "message": "「这话题会说很长吗？」"
    },
    {
        "name": "莲",
        "message": "「不，我觉得不会太长」"
    },
    {
        "name": "清露",
        "message": "「可疑……」"
    },
    {
        "message": "就在我们这样交谈时，一直和我们一起工作的初中部的孩子们走进了教室。"
    },
    {
        "name": "中学男生A",
        "message": "「啊，清露前辈和莲前辈！」",
        "fenhang": 2
    },
    {
        "name": "中学男生B",
        "message": "「你们好！」",
        "fenhang": 2
    },
    {
        "name": "莲",
        "message": "「你们好」"
    },
    {
        "name": "清露",
        "message": "「嗯，怎么了？忘带东西了吗？」"
    },
    {
        "name": "中学男生A",
        "message": "「其实是有东西想让清露前辈看看……」",
        "fenhang": 2
    },
    {
        "name": "清露",
        "message": "「诶！？」"
    },
    {
        "name": "中学男生B",
        "message": "「是的……」",
        "fenhang": 2
    },
    {
        "message": "哦，什么啊。情书吗？"
    },
    {
        "name": "中学男生A",
        "message": "「就是这个！」",
        "fenhang": 2
    },
    {
        "message": "他迅速从背后拿出藏着的东西，展示给夕凪看。"
    },
    {
        "name": "清露",
        "message": "「啊！！！！」"
    },
    {
        "message": "中学男生拿出来的是一个蛇形玩具。"
    },
    {
        "message": "夕凪看到后踉跄着后退，手扶在我的桌子上。"
    },
    {
        "name": "中学男生A",
        "message": "「哇，真的诶！吓到了！」",
        "fenhang": 2
    },
    {
        "name": "中学男生B",
        "message": "「清露前辈，你真的很怕蛇啊！」",
        "fenhang": 2
    },
    {
        "message": "看来他们是来开玩笑的。这种情况也让人觉得挺温馨的。"
    },
    {
        "message": "大概是通过文化祭的准备工作，感受到了夕凪的温柔吧。"
    },
    {
        "name": "清露",
        "message": "「哼，你们这些家伙！！我可不会原谅你们的！！」"
    },
    {
        "name": "中学男生A",
        "message": "「哇，她真的生气了！快跑！」",
        "fenhang": 2
    },
    {
        "name": "中学男生B",
        "message": "「啊啊啊！！！」",
        "fenhang": 2
    },
    {
        "name": "清露",
        "message": "「喂，给我站住！！」"
    },
    {
        "message": "说着，夕凪追着中学部的学生跑出了教室。"
    },
    {
        "name": "莲",
        "message": "「哈哈哈，真受欢迎啊」"
    },
    {
        "name": "莲",
        "message": "「不过可能也是被小看了」"
    },
    {
        "message": "我一边自言自语，一边注视着夕凪离开的方向。"
    },
    {
        "name": "莲",
        "message": "「好了，准备的东西看来也没问题……」"
    },
    {
        "name": "莲",
        "message": "「咦，啊……」"
    },
    {
        "message": "我看向自己的桌子，那里有一顶王冠，角已经折断，装饰也零零散散地掉了下来。"
    },
    {
        "name": "莲",
        "message": "「啊……坏掉了……」"
    },
    {
        "name": "莲",
        "message": "「是刚才夕凪撞到的时候吗……」"
    },
    {
        "message": "我一瞬间受到了打击。"
    },
    {
        "message": "但很快就判断出，这种程度的损坏，修理起来应该不会花太多时间。"
    },
    {
        "name": "莲",
        "message": "「唉……算了，修一修吧」"
    },
    {
        "message": "我拿起放在桌旁的工具箱，坐了下来。"
    },
    {
        "name": "莲",
        "message": "「嗯……这折断的地方该怎么修呢……」"
    },
    {
        "name": "莲",
        "message": "「唔……」"
    },
    {
        "message": "因为只是在现成的玩具王冠上华丽地装饰了一下，所以强度不够。"
    },
    {
        "message": "即使把折断的地方粘起来，接缝处也会很明显……只能把装饰拆掉再消除接缝了吧。"
    },
    {
        "message": "正在考虑修复方法时，夕凪回到了教室。"
    },
    {
        "name": "清露",
        "message": "「真是的，那些家伙到底怎么回事」"
    },
    {
        "name": "清露",
        "message": "「他们把前辈当成什么了？」"
    },
    {
        "message": "她鼓着脸颊，看起来很生气的样子。"
    },
    {
        "name": "清露",
        "message": "「喂，你不也这么觉……得……」"
    },
    {
        "name": "清露",
        "message": "「咦，这个是……」"
    },
    {
        "name": "莲",
        "message": "「啊，因为坏了所以正在修理」"
    },
    {
        "name": "清露",
        "message": "「啊……」"
    },
    {
        "name": "清露",
        "message": "「该不会是刚才我撞到的时候……？」"
    },
    {
        "message": "夕凪一脸担心地注视着我的眼睛。"
    },
    {
        "name": "清露",
        "message": "「对不起……」"
    },
    {
        "name": "莲",
        "message": "「嗯？啊，不，没事没事，真的没事」"
    },
    {
        "name": "清露",
        "message": "「……真的吗？」"
    },
    {
        "message": "她似乎对自己感到内疚，看起来随时都要哭出来了。"
    },
    {
        "name": "莲",
        "message": "「嗯，真的没事啦」"
    },
    {
        "message": "这是夕凪第一次对我露出这种表情，我也慌了，只能一个劲地说『没事』。"
    },
    {
        "name": "清露",
        "message": "「可是……」"
    },
    {
        "name": "莲",
        "message": "「很快就能修好，别太在意了」"
    },
    {
        "name": "清露",
        "message": "「可是……那、那我也来帮忙……不，让我来修吧」"
    },
    {
        "name": "莲",
        "message": "「不用，我来修就行」"
    },
    {
        "name": "清露",
        "message": "「不行，毕竟是我弄坏的……」"
    },
    {
        "message": "听到这话，我站起身来，轻轻地把手放在夕凪的肩上，凝视着她的眼睛。"
    },
    {
        "name": "莲",
        "message": "「你没有错。那种情况是不可抗力的」"
    },
    {
        "name": "莲",
        "message": "「嗯，虽然我确实有点震惊……」"
    },
    {
        "name": "莲",
        "message": "「但多亏你帮我争取了时间，才能完成这个作品……」"
    },
    {
        "name": "莲",
        "message": "「而且我自己也很满意现在的成果……所以在它离开我手之前，我希望你能把它交托给我」"
    },
    {
        "name": "清露",
        "message": "「啊……诶……」"
    },
    {
        "name": "清露",
        "message": "「嗯、嗯……既然你这么说的话……」"
    },
    {
        "name": "清露",
        "message": "「真的非常抱歉……」"
    },
    {
        "message": "夕凪会露出这样的表情……在刚认识她的时候，我根本想象不到啊……"
    },
    {
        "name": "莲",
        "message": "「好啦好啦……」"
    },
    {
        "name": "莲",
        "message": "「我明天之前一定会完美修复的，今天你就回家好好休息吧」"
    },
    {
        "name": "清露",
        "message": "「…………」"
    },
    {
        "name": "清露",
        "message": "「嗯……谢谢你……」"
    },
    {
        "message": "就在我让夕凪勉强接受的时候，教室的门打开了，有人走了进来。"
    },
    {
        "name": "雪",
        "message": "「九条君，艾莉卡前辈让我把这个……」"
