[
    {
        "message": "早晨，虽然醒了但还是恍惚如梦。"
    },
    {
        "name": "莲",
        "message": "「昨天的事不是梦吧」"
    },
    {
        "message": "脑海中确实有送艾莉卡回家的记忆。"
    },
    {
        "message": "但还是感觉飘飘然。好像随时都能飞上天空。"
    },
    {
        "name": "莲",
        "message": "「哈……要不再睡一会儿」"
    },
    {
        "name": "爱嘉",
        "message": "「哥哥，你在干什么呀？」"
    },
    {
        "name": "莲",
        "message": "「这就来」"
    },
    {
        "name": "爱嘉",
        "message": "「啊，在播放猫咪新闻」"
    },
    {
        "name": "莲",
        "message": "「真的呢……」"
    },
    {
        "name": "爱嘉",
        "message": "「说是在叫伊普尔的地方举办猫咪节。伊普尔是哪里啊」"
    },
    {
        "name": "莲",
        "message": "「谁知道呢……」"
    },
    {
        "name": "爱嘉",
        "message": "「好可爱啊」"
    },
    {
        "name": "莲",
        "message": "「嗯……」"
    },
    {
        "name": "爱嘉",
        "message": "「哥哥真的在听吗？感觉你心不在焉的」"
    },
    {
        "name": "莲",
        "message": "「嗯……」"
    },
    {
        "name": "爱嘉",
        "message": "「怎么回事呢？难道是因为昨天艾莉卡来过的缘故……」"
    },
    {
        "name": "莲",
        "message": "「唔……」"
    },
    {
        "name": "爱嘉",
        "message": "「哇，突然睁大眼睛了……」"
    },
    {
        "message": "我知道是艾莉卡来了，所以我去玄关迎接她。"
    },
    {
        "name": "艾莉卡",
        "message": "「早、早上好」"
    },
    {
        "name": "莲",
        "message": "「早上好……」"
    },
    {
        "message": "感觉有点难为情。我已经无法直视艾莉卡的眼睛了。"
    },
    {
        "name": "艾莉卡",
        "message": "「总觉得有点害羞呢」"
    },
    {
        "name": "莲",
        "message": "「啊哈哈……是啊」"
    },
    {
        "name": "爱嘉",
        "message": "「哥哥们，你们的样子很奇怪哦？」"
    },
    {
        "name": "艾莉卡",
        "message": "「……」"
    },
    {
        "message": "气氛瞬间凝固了。这妹妹怎么会说出这种话啊。"
    },
    {
        "name": "莲",
        "message": "「不，你在说什么啊」"
    },
    {
        "name": "艾莉卡",
        "message": "「……是的，因为昨天被抱了」"
    },
    {
        "message": "为什么要说出来啊！"
    },
    {
        "name": "爱嘉",
        "message": "「等等等等……」"
    },
    {
        "message": "爱嘉脸红了。"
    },
    {
        "name": "莲",
        "message": "「别说了真的」"
    },
    {
        "name": "艾莉卡",
        "message": "「对爱嘉来说还太早了吗？」"
    },
    {
        "name": "爱嘉",
        "message": "「哇哇哇……」"
    },
    {
        "message": "爱嘉只是一直脸红着。"
    },
    {
        "name": "莲",
        "message": "「艾莉卡前辈！」"
    },
    {
        "name": "艾莉卡",
        "message": "「一大早就对不起了，爱嘉」"
    },
    {
        "name": "清露",
        "message": "「嗯？」"
    },
    {
        "message": "夕凪突然瞪了我一眼。"
    },
    {
        "name": "莲",
        "message": "「怎、怎么了……」"
    },
    {
        "name": "清露",
        "message": "「该不会你……」"
    },
    {
        "name": "莲",
        "message": "「该、该不会……」"
    },
    {
        "message": "难道我失去童贞的事情被发现了！"
    },
    {
        "message": "为什么……。"
    },
    {
        "name": "莲",
        "message": "「为什么昨天我和艾莉卡做爱的事情被发现了」"
    },
    {
        "name": "清露",
        "message": "「哈……」"
    },
    {
        "message": "原来是误会一场！"
    },
    {
        "name": "清露",
        "message": "「不，就算是宽容如我也要起诉你了」"
    },
    {
        "name": "莲",
        "message": "「对不起。我只能想到那件事」"
    },
    {
        "name": "清露",
        "message": "「如果你不是艾莉卡的男朋友，肯定会被判无期徒刑，而且没有假释」"
    },
    {
        "name": "莲",
        "message": "「日本可没有这种制度……」"
    },
    {
        "message": "就因为一个误会就说出这么可怕的话。"
    },
    {
        "name": "莲",
        "message": "「那你到底有什么事」"
    },
    {
        "name": "清露",
        "message": "「没什么，就是觉得你身上的处男味消失了」"
    },
    {
        "name": "莲",
        "message": "「那不就是对的吗！」"
    },
    {
        "name": "清露",
        "message": "「吵死了，变态破处男」"
    },
    {
        "name": "莲",
        "message": "「这外号也太过分了吧」"
    },
    {
        "name": "清露",
        "message": "「啊—吵死了吵死了」"
    },
    {
        "name": "清露",
        "message": "「不过看你们相处得不错真是太好了」"
    },
    {
        "name": "莲",
        "message": "「嗯，嗯……」"
    },
    {
        "message": "她说完想说的话就回自己座位去了。"
    },
    {
        "message": "不过我也说出了那么过分的告白。"
    },
    {
        "name": "男学生A",
        "message": "「喂，九条」",
        "fenhang": 2
    },
    {
        "name": "莲",
        "message": "「嗯，这次又怎么了？」"
    },
    {
        "name": "男学生B",
        "message": "「毕业证书授予，九条莲！」",
        "fenhang": 2
    },
    {
        "name": "莲",
        "message": "「诶，什么什么！？」"
    },
    {
        "name": "男学生B",
        "message": "「兹证明你已完成处男联盟的全部课程」",
        "fenhang": 2
    },
    {
        "name": "莲",
        "message": "「不是，我都说了没加入过。我们不就是普通的宅男朋友吗」"
    },
    {
        "name": "男学生A",
        "message": "「恭喜」",
        "fenhang": 2
    },
    {
        "message": "这种事被祝贺一点都不高兴。"
    },
    {
        "name": "男学生A",
        "message": "「没想到九条居然」",
        "fenhang": 2
    },
    {
        "name": "男学生B",
        "message": "「老实说我一直以为你是我们的同伴」",
        "fenhang": 2
    },
    {
        "name": "莲",
        "message": "「不是，现在也还是同伴啊」"
    },
    {
        "message": "两个人完全不接受。"
    },
    {
        "name": "莲",
        "message": "「嗯，嗯……你们两个也加油的话很快就行了」"
    },
    {
        "name": "男学生A",
        "message": "「这是在居高临下地给我们建议吗」",
        "fenhang": 2
    },
    {
        "name": "莲",
        "message": "「下次一起去吃饭吧……」"
    },
    {
        "message": "今天放学后，当然还是和艾莉卡两个人在学生会室。"
    },
    {
        "message": "因为能轻易地单独相处，现在这个时期的学生会室真是太棒了。"
    },
    {
        "message": "虽然本来不该这样使用就是了。"
    },
    {
        "name": "莲",
        "message": "「说起来，从现在开始我们得拼命学习了呢」"
    },
    {
        "name": "艾莉卡",
        "message": "「是这样吗？」"
    },
    {
        "name": "莲",
        "message": "「是啊，明年的对手们现在肯定都在努力学习」"
    },
    {
        "name": "艾莉卡",
        "message": "「我倒是没有那么拼命呢」"
    },
    {
        "name": "莲",
        "message": "「艾莉卡是特别的」"
    },
    {
        "message": "果然她比我想象的还要聪明啊……"
    },
    {
        "message": "更要拼命学习才行了。"
    },
    {
        "name": "莲",
        "message": "「我要认真努力」"
    },
    {
        "name": "艾莉卡",
        "message": "「我也会支持你的哦。加油加油，莲·君♪」"
    },
    {
        "name": "莲",
        "message": "「啊哈哈……」"
    },
    {
        "message": "不知道是这种松懈的加油让我更有干劲了，还是反而让我失去了动力。"
    },
    {
        "name": "艾莉卡",
        "message": "「就像我之前说的，我也会帮忙辅导学习的。虽然我不怎么买参考书，所以不知道能帮上多大忙就是了」"
    },
    {
        "name": "莲",
        "message": "「诶，你不买参考书之类的吗？」"
    },
    {
        "name": "艾莉卡",
        "message": "「是啊，站着翻翻红宝书就够了♪」"
    },
    {
        "name": "莲",
        "message": "「骗人的吧……」"
    },
    {
        "message": "关于学习方面，艾莉卡说的话可能还是不要太当真比较好。"
    },
    {
        "name": "艾莉卡",
        "message": "「顺便说一下，我最擅长的是保健体育」"
    },
    {
        "name": "莲",
        "message": "「那个又不会出现在高考中」"
    },
    {
        "name": "艾莉卡",
        "message": "「是这样吗，我还以为能学到戴套的技巧之类的呢」"
    },
    {
        "name": "莲",
        "message": "「……」"
    },
    {
        "name": "艾莉卡",
        "message": "「啊，男生都会在意这种事吧。不过我觉得很可爱哦」"
    },
    {
        "message": "不需要这种安慰……"
    },
    {
        "name": "莲",
        "message": "「无论如何那种东西都不会在保健体育课上出现的」"
    },
    {
        "name": "莲",
        "message": "「不对，这种事怎样都无所谓」"
    },
    {
        "name": "艾莉卡",
        "message": "「这可不太好哦」"
    },
    {
        "name": "莲",
        "message": "「那我们现在就开始学习辅导吧？」"
    },
    {
        "message": "这个安静的二人独处的房间简直是绝佳机会。"
    },
    {
        "message": "这样应该能进展顺利。"
    },
    {
        "name": "艾莉卡",
        "message": "「诶——」"
    },
    {
        "name": "莲",
        "message": "「你不愿意吗」"
    },
    {
        "name": "艾莉卡",
        "message": "「我还想再腻歪一会儿呢」"
    },
    {
        "name": "莲",
        "message": "「我也是这么想的，不过是你说要教我的啊」"
    },
    {
        "name": "艾莉卡",
        "message": "「我以为那是以后的事呢」"
    },
    {
        "name": "莲",
        "message": "「高考战争已经开始了！」"
    },
    {
        "name": "艾莉卡",
        "message": "「好热血啊。随便考个什么高中不就行了吗」"
    },
    {
        "name": "莲",
        "message": "「那我就去上艾莉卡高中吧」"
    },
    {
        "name": "艾莉卡",
        "message": "「那么第一节课就是如何巧妙地邀请对方上床」"
    },
    {
        "name": "莲",
        "message": "「老师，请教些有用的东西吧」"
    },
    {
        "name": "艾莉卡",
        "message": "「数学公式也好古文也罢，归根结底都是恋爱啊」"
    },
    {
        "name": "莲",
        "message": "「她突然说起了一些听起来很有道理的话！」"
    },
    {
        "message": "不过，现在不是开玩笑的时候。"
    },
    {
        "name": "艾莉卡",
        "message": "「不用那么着急，我会好好辅导你学习的。不过今天就到此为止吧」"
    },
    {
        "name": "莲",
        "message": "「这就结束了吗」"
    },
    {
        "message": "比平时提前了一个多小时。"
    },
    {
        "name": "莲",
        "message": "「你有什么安排吗？」"
    },
    {
        "name": "艾莉卡",
        "message": "「不，并没有什么特别的安排」"
    },
    {
        "name": "艾莉卡",
        "message": "「呵呵，我知道你想和我多待一会儿，但不要过分探究女孩子的秘密哦」"
    },
    {
        "name": "莲",
        "message": "「呃，嗯……」"
    },
    {
        "name": "艾莉卡",
        "message": "「那么，我们走吧」"
    },
    {
        "message": "艾莉卡收拾好东西离开了学生会室。"
    },
    {
        "message": "总觉得她今天和平常有些不一样……"
    },
    {
        "name": "莲",
        "message": "「喂，爱嘉……」"
    },
    {
        "message": "我一边看着电视一边跟爱嘉说话。"
    },
    {
        "name": "爱嘉",
        "message": "「怎么了？」"
    },
    {
        "name": "莲",
        "message": "「其实啊……」"
    },
    {
        "message": "我向她咨询了与艾莉卡分别时的事。"
    },
    {
        "message": "虽然我不认为自己做了什么不妥的事，但因为是喜欢的人，所以怎么也放心不下。"
    },
    {
        "message": "因此我想听听爱嘉作为女性的意见。"
    },
    {
        "name": "爱嘉",
        "message": "「嗯……是不是已经懈怠了？」"
    },
    {
        "name": "莲",
        "message": "「怎么可能啊！我们午餐时还互相喂食，只要有机会就随时亲热呢」"
    },
    {
        "name": "爱嘉",
        "message": "「哇哇……」"
    },
    {
        "message": "糟了。又像早上一样让她脸红了。"
    },
    {
        "name": "爱嘉",
        "message": "「嗯，嗯，按你们平常的相处方式来看应该没问题吧？」"
    },
    {
        "name": "莲",
        "message": "「是、是啊……」"
    },
    {
        "name": "爱嘉",
        "message": "「那就别问啦」"
    },
    {
        "message": "不知为何爱嘉用略带强硬的语气说道。"
    },
    {
        "name": "莲",
        "message": "「我只是想听听第三方的意见」"
    },
    {
        "name": "爱嘉",
        "message": "哎……哥哥。作为男朋友就应该相信艾莉卡小姐啊"
    },
    {
        "name": "莲",
        "message": "「嗯，我明白的」"
    },
    {
        "message": "被爱嘉训斥了一顿。不过她说得确实没错。"
    },
    {
        "message": "我对艾莉卡的感情一点都没有动摇。"
    }
]