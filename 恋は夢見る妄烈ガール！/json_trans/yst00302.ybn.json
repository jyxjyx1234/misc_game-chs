[
    {
        "name": "莲",
        "message": "「啊，是夕凪……」"
    },
    {
        "name": "清露",
        "message": "「啊」"
    },
    {
        "message": "夕凪手里拿着烟花，一边东张西望一边走着。"
    },
    {
        "name": "莲",
        "message": "「你在这种地方干什么呢？」"
    },
    {
        "name": "清露",
        "message": "「刚才和葵在一起，但是走散了……正在找她」"
    },
    {
        "name": "莲",
        "message": "「啊，这样啊……」"
    },
    {
        "name": "清露",
        "message": "「话说回来，你自己在这儿干嘛呢」"
    },
    {
        "name": "莲",
        "message": "「我？」"
    },
    {
        "name": "清露",
        "message": "「这里除了你还有谁啊」"
    },
    {
        "name": "莲",
        "message": "「我刚刚学生会的活动结束……准确地说，是前辈命令我来这里」"
    },
    {
        "name": "清露",
        "message": "「哦～……」"
    },
    {
        "name": "莲",
        "message": "「啊，对了。一起放烟花吧」"
    },
    {
        "name": "清露",
        "message": "「啊！？为什么要和你……」"
    },
    {
        "name": "清露",
        "message": "「你不是有地方要去吗……那边田径部正热闹着呢」"
    },
    {
        "name": "莲",
        "message": "「……嗯？」"
    },
    {
        "name": "清露",
        "message": "「所以说，你不是有地方要去吗……」"
    },
    {
        "name": "莲",
        "message": "「你在说什么啊？」"
    },
    {
        "name": "清露",
        "message": "「哎呀，你们不是在交往吗？既然如此就去陪她啊」"
    },
    {
        "name": "莲",
        "message": "「等等。你到底在说什么啊？我到现在为止一次恋爱都没谈过。坠入爱河也就初恋那一次是第一次也是最后一次」"
    },
    {
        "name": "清露",
        "message": "「诶……等等等等等等……你和雪不是在交往吗？」"
    },
    {
        "name": "莲",
        "message": "「不是，这下我更搞不懂你在说什么了」"
    },
    {
        "message": "汐崎同学的脸庞掠过脑海。一被提起就不由得意识到，脸颊变得滚烫起来。"
    },
    {
        "name": "清露",
        "message": "「因为，你们前几天不是一起回家了吗」"
    },
    {
        "name": "莲",
        "message": "「嘛，嘛，毕竟回家方向一样嘛」"
    },
    {
        "name": "清露",
        "message": "「那，最近雪明明应该不擅长和男生说话的，却能和你正常交谈是怎么回事？」"
    },
    {
        "name": "莲",
        "message": "「嗯，因为我们喜欢的搞笑艺人口味相同，而且因为同一个小组经常见面」"
    },
    {
        "name": "莲",
        "message": "「……话说回来，如果我真的在和汐崎同学交往的话，就不会说要送你回家这种话了吧」"
    },
    {
        "name": "清露",
        "message": "「诶，这么说……我我我只是误会了而已？」"
    },
    {
        "name": "莲",
        "message": "「就是这么回事」"
    },
    {
        "name": "清露",
        "message": "「啊，原来如此……太好了……」"
    },
    {
        "name": "莲",
        "message": "「太好了？」"
    },
    {
        "name": "清露",
        "message": "「不不不，没什么」"
    },
    {
        "name": "莲",
        "message": "「啊，这样啊……」"
    },
    {
        "message": "虽然没有表现在脸上，但刚才我的心跳真的加速了。"
    },
    {
        "name": "清露",
        "message": "「那、那个，要不要玩烟花？」"
    },
    {
        "name": "莲",
        "message": "「嗯，好啊」"
    },
    {
        "name": "清露",
        "message": "「那我去拿烟花」"
    },
    {
        "name": "莲",
        "message": "「好」"
    },
    {
        "message": "于是，我们两个人一起去接待处拿了烟花，然后找了个空地蹲了下来。"
    },
    {
        "name": "清露",
        "message": "「好久没玩线香烟花了啊」"
    },
    {
        "name": "莲",
        "message": "「我也是好久没玩了。小时候我可坐不住了」"
    },
    {
        "name": "莲",
        "message": "「总是不小心把火星弄掉」"
    },
    {
        "name": "清露",
        "message": "「嗯～没想到你小时候是个坐不住的孩子啊」"
    },
    {
        "name": "莲",
        "message": "「什么叫没想到啊」"
    },
    {
        "name": "清露",
        "message": "「没啥，就觉得你现在挺悠哉的」"
    },
    {
        "name": "莲",
        "message": "「是这样吗？」"
    },
    {
        "name": "清露",
        "message": "「就是这样，没错」"
    },
    {
        "message": "说完，她又把视线转回到线香烟花上。"
    },
    {
        "name": "清露",
        "message": "「…………」"
    },
    {
        "name": "莲",
        "message": "「…………」"
    },
    {
        "message": "我看着夕凪那恍惚的侧脸，不禁看呆了。"
    },
    {
        "message": "想到她还会有这样的表情，我的心里不由得一阵悸动。"
    },
    {
        "name": "清露",
        "message": "「………」"
    },
    {
        "name": "清露",
        "message": "「喂、喂，别、别这样盯着我看啊……」"
    },
    {
        "name": "莲",
        "message": "「我、我没有看啊！」"
    },
    {
        "name": "清露",
        "message": "「啊，难道说……」"
    },
    {
        "message": "说着，清露整理了一下微微歪斜的裙摆。"
    },
    {
        "name": "清露",
        "message": "「嗯！」"
    },
    {
        "name": "莲",
        "message": "「不不，我只是觉得线香烟花很漂亮」"
    },
    {
        "name": "清露",
        "message": "「啊，原来如此……真是的……太容易让人误会了……」"
    },
    {
        "name": "清露",
        "message": "「啊！」"
    },
    {
        "name": "清露",
        "message": "「真是的……都怪你，掉下来了吧」"
    },
    {
        "name": "莲",
        "message": "「那是因为你总是误会」"
    },
    {
        "name": "清露",
        "message": "「你、你是说这是我的错？」"
    },
    {
        "name": "莲",
        "message": "「不，呃，我不是说全都是你的错，但是……」"
    },
    {
        "name": "清露",
        "message": "「那就是说，八成是你的责任咯」"
    },
    {
        "name": "莲",
        "message": "「那也太重了吧，虽然我确实稍微看了一下大腿……」"
    },
    {
        "name": "清露",
        "message": "「果、果、果然你是在看啊」"
    },
    {
        "name": "莲",
        "message": "「哇哇哇哇」"
    },
    {
        "message": "之后，我们一边被骂一边吐槽，像平常一样享受着烟花。"
    },
    {
        "message": "这场不合时节的烟花，我们在寒冷中瑟瑟发抖却又开怀大笑……成为了一段美好的回忆。"
    }
]