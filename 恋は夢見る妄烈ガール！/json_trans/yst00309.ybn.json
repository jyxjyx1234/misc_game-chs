[
    {
        "name": "莲",
        "message": "「早上好！」"
    },
    {
        "name": "清露",
        "message": "「啊，你感冒好了吗？」"
    },
    {
        "name": "莲",
        "message": "「已经完全好了哦。简称完治」"
    },
    {
        "name": "清露",
        "message": "「简称的意义……」"
    },
    {
        "name": "莲",
        "message": "「呵呵呵呵」"
    },
    {
        "message": "感冒痊愈花了3天时间。"
    },
    {
        "message": "我感冒的第二天爱嘉就回来了，她非常担心我，在家的时候一直照顾我。"
    },
    {
        "message": "大概是因为这个原因吧。我对爱嘉一直都只有感激之情……"
    },
    {
        "name": "清露",
        "message": "「刚恢复就这样……感冒是不是把脑子烧坏了？」"
    },
    {
        "name": "莲",
        "message": "「也不是那么回事……」"
    },
    {
        "name": "莲",
        "message": "「只是好久没来学校，感到很高兴……」"
    },
    {
        "name": "清露",
        "message": "「哼……」"
    },
    {
        "name": "莲",
        "message": "「喂，说起来，我决定了」"
    },
    {
        "name": "清露",
        "message": "「决定什么？」"
    },
    {
        "name": "莲",
        "message": "「我从今天开始认真寻找初恋对象！」"
    },
    {
        "name": "莲",
        "message": "「文化祭也结束了，学生会的事务也告一段落了」"
    },
    {
        "name": "清露",
        "message": "「啊！？」"
    },
    {
        "name": "莲",
        "message": "「你、你干嘛那么惊讶啊。不是你自己说的吗」"
    },
    {
        "name": "清露",
        "message": "「啊，是这样吗……」"
    },
    {
        "name": "莲",
        "message": "「啊，对了，这个……周一的事谢谢你啊」"
    },
    {
        "message": "我从口袋里掏出一个茶色信封递给夕凪。"
    },
    {
        "message": "是粥的材料费。"
    },
    {
        "name": "清露",
        "message": "「啊，谢谢……」"
    },
    {
        "name": "莲",
        "message": "「不客气，对吧？」"
    },
    {
        "name": "清露",
        "message": "「吵、吵死了」"
    },
    {
        "message": "可能是因为犯错的尴尬，她露出了害羞的表情。"
    },
    {
        "name": "莲",
        "message": "「哦」"
    },
    {
        "message": "真是什么都要咬一口啊……"
    },
    {
        "message": "不过，这种地方也很可爱就是了。"
    },
    {
        "message": "上午，日本史课后的休息时间。"
    },
    {
        "message": "我戳了戳前面的背。"
    },
    {
        "name": "清露",
        "message": "「干嘛？」"
    },
    {
        "name": "莲",
        "message": "「喂喂，打听消息具体该怎么做啊？」"
    },
    {
        "name": "清露",
        "message": "「啊？这种事自己想办法啊！」"
    },
    {
        "name": "莲",
        "message": "「诶——，帮我一下下嘛」"
    },
    {
        "name": "清露",
        "message": "「哈……知道了……」"
    },
    {
        "name": "莲",
        "message": "「太好了，谢谢」"
    },
    {
        "name": "清露",
        "message": "「那，我会联系几个当时在那个公园玩的女生」"
    },
    {
        "name": "莲",
        "message": "「真是帮大忙了！」"
    },
    {
        "name": "清露",
        "message": "「哼……没我什么都做不成啊」"
    },
    {
        "name": "莲",
        "message": "「您说得对……」"
    },
    {
        "message": "我现在对夕凪真是服气。"
    },
    {
        "message": "刚转学来的时候也是一样服气。"
    },
    {
        "message": "我和夕凪利用课间和放学后的时间，在美丘学园内向夕凪能想到的人打听消息"
    },
    {
        "message": "但还没有找到任何人。还没问完所有人，就寄希望于此吧。"
    },
    {
        "name": "清露",
        "message": "「说起来，童年的记忆意外地容易模糊呢」"
    },
    {
        "name": "莲",
        "message": "「啊，是啊」"
    },
    {
        "name": "清露",
        "message": "「不过，还有些人可能记得，明天我们再继续吧」"
    },
    {
        "name": "莲",
        "message": "「嗯」"
    },
    {
        "message": "第二天，我们询问了美丘学园最后一个人。"
    },
    {
        "message": "我也问了猫城前辈，但她似乎什么都不知道。"
    },
    {
        "name": "莲",
        "message": "「唉，不行吗」"
    },
    {
        "name": "清露",
        "message": "「是啊……」"
    },
    {
        "name": "莲",
        "message": "「连猫城前辈都不知道的话，感觉真是无计可施了……」"
    },
    {
        "name": "清露",
        "message": "「不过，也不是说一定只在美丘学园里啊」"
    },
    {
        "name": "莲",
        "message": "「这样啊……那就去问问那个人吧」"
    },
    {
        "name": "清露",
        "message": "「知道了，我去联系」"
    },
    {
        "name": "莲",
        "message": "「真是太谢谢你了……」"
    },
    {
        "name": "清露",
        "message": "「毕竟，这是约定不是吗……？」"
    },
    {
        "message": "夕凪用忧伤的眼神看着我。"
    },
    {
        "name": "莲",
        "message": "「嗯、嗯……」"
    },
    {
        "name": "莲",
        "message": "「说起来，夕凪一遇到约定的事就变得特别热血啊。有什么特别的原因吗？」"
    },
    {
        "name": "清露",
        "message": "「啊……？」"
    },
    {
        "name": "莲",
        "message": "「不，我是说，你那么热血，肯定有什么理由吧」"
    },
    {
        "name": "清露",
        "message": "「没、没没没有什么特别的理由啦」"
    },
    {
        "name": "清露",
        "message": "「约定就是约定！从古到今都不能违背，这不是常识吗？」"
    },
    {
        "name": "清露",
        "message": "「又不是在战国时代……」"
    },
    {
        "name": "莲",
        "message": "「嗯，是这样没错……不过你这边说着就又热血起来了呢」"
    },
    {
        "name": "清露",
        "message": "「能不能别说那些多余的话？」"
    },
    {
        "name": "莲",
        "message": "「呃」"
    },
    {
        "name": "清露",
        "message": "「算了，无所谓了……」"
    },
    {
        "name": "莲",
        "message": "「呼……」"
    },
    {
        "name": "清露",
        "message": "「呼……」"
    },
    {
        "message": "之后经过几天休息，我们花了几天时间去询问校外的人，但完全没有找到任何线索。"
    },
    {
        "message": "想要把这个钥匙扣还给那个人的愿望越来越强烈了。"
    },
    {
        "name": "清露",
        "message": "「唉，还有谁可以问问呢……」"
    },
    {
        "name": "清露",
        "message": "「感觉差不多都问遍了……」"
    },
    {
        "message": "今天也是出去询问校外的人，正准备回家。"
    },
    {
        "name": "莲",
        "message": "「是吗……」"
    },
    {
        "name": "清露",
        "message": "「是不是只能放弃了？」"
    },
    {
        "name": "莲",
        "message": "「嗯……但是……」"
    },
    {
        "name": "清露",
        "message": "「那个孩子肯定也已经忘记了吧……」"
    },
    {
        "message": "又来了。"
    },
    {
        "name": "莲",
        "message": "「是这样吗……」"
    },
    {
        "name": "清露",
        "message": "「嗯，肯定是这样……毕竟，都是多久以前的事了……」"
    },
    {
        "message": "夕凪又露出了悲伤的表情。"
    },
    {
        "name": "莲",
        "message": "「喂，你最近老是一副伤心的样子啊？」"
    },
    {
        "name": "清露",
        "message": "「啊？」"
    },
    {
        "name": "莲",
        "message": "「不，如果是我的错觉就当我没说……」"
    },
    {
        "name": "莲",
        "message": "「虽然不知道能不能帮上忙，但如果你有什么困难的话可以依靠我啊」"
    },
    {
        "name": "清露",
        "message": "「笨、笨蛋！我才不需要依靠你呢」"
    },
    {
        "name": "莲",
        "message": "「又在逞强啊……」"
    },
    {
        "message": "我直直地盯着夕凪的脸。"
    },
    {
        "name": "清露",
        "message": "「烦死了」"
    },
    {
        "name": "莲",
        "message": "「哈哈，就是这样」"
    },
    {
        "name": "清露",
        "message": "「嗯——……」"
    },
    {
        "message": "夕凪露出了有点困扰的表情。"
    },
    {
        "name": "莲",
        "message": "「…………」"
    },
    {
        "name": "清露",
        "message": "「…………」"
    },
    {
        "message": "在沉默中，两人走在夕阳染红的路上。"
    },
    {
        "message": "但是这种沉默的时光并不讨厌。"
    },
    {
        "message": "明明不久前还被当成奴隶，被用奇怪的眼光看待，各种被讨厌……"
    },
    {
        "message": "现在和夕凪在一起的时间变得很愉快。反而是不在一起的时候，一想到夕凪就会感到胸口发闷。"
    },
    {
        "message": "就是这样我才意识到。我对夕凪……"
    },
    {
        "name": "清露",
        "message": "「干、干嘛」"
    },
    {
        "name": "莲",
        "message": "「啊，那个……」"
    },
    {
        "message": "被夕凪的侧脸迷住了，接下来要说的话卡在了喉咙里"
    },
    {
        "name": "莲",
        "message": "「嗯——……那个……」"
    },
    {
        "message": "现在的话……。"
    },
    {
        "name": "清露",
        "message": "「什、什么？」"
    },
    {
        "name": "莲",
        "message": "「…………」"
    },
    {
        "message": "要说出来……。"
    },
    {
        "name": "清露",
        "message": "「…………」"
    },
    {
        "name": "莲",
        "message": "「砂……砂……」"
    },
    {
        "name": "清露",
        "message": "「……？」"
    },
    {
        "name": "莲",
        "message": "「你知道《沙之星球》这部电影吗？」"
    },
    {
        "name": "清露",
        "message": "「啊？」"
    },
    {
        "message": "没能说出口……。"
    },
    {
        "name": "莲",
        "message": "「不，有一部叫《沙之星球》的电影。里面有关于约定什么的情节」"
    },
    {
        "name": "清露",
        "message": "「啊、啊……」"
    },
    {
        "name": "莲",
        "message": "「说的是一定会回来的，虽然要去宇宙，但回到地球时地球文明已经灭亡了的故事」"
    },
    {
        "name": "清露",
        "message": "「……然后呢？」"
    },
    {
        "name": "莲",
        "message": "「呃，那个，所以在那种情况发生之前我要履行约定！」"
    },
    {
        "name": "清露",
        "message": "「噗」"
    },
    {
        "name": "清露",
        "message": "「一脸严肃地说出这种话是怎么回事啊！哈哈哈」"
    },
    {
        "message": "夕凪笑了。她的笑容充满了光彩。"
    },
    {
        "name": "清露",
        "message": "「那么，我就在这里了。明天见」"
    },
    {
        "name": "莲",
        "message": "「哦，哦……」"
    },
    {
        "name": "清露",
        "message": "「嗯，再见」"
    },
    {
        "message": "结果，还是没能说出口。"
    },
    {
        "message": "明明以为现在能说出来的……"
    },
    {
        "message": "…………"
    },
    {
        "message": "今晚的晚饭会是什么呢。"
    },
    {
        "message": "今天一天过得真快啊。"
    },
    {
        "message": "班会也结束了，之后只要去学生会露个面就可以回家了。"
    },
    {
        "name": "莲",
        "message": "「课程已经结束了啊——」"
    },
    {
        "name": "清露",
        "message": "「你这么喜欢上课吗？」"
    },
    {
        "name": "莲",
        "message": "「嗯，也不是说很无聊啦……」"
    },
    {
        "name": "清露",
        "message": "「啊，是吗……明明中途睡着了」"
    },
    {
        "name": "莲",
        "message": "「呃」"
    },
    {
        "message": "原来被发现了……"
    },
    {
        "name": "清露",
        "message": "「那个，那个……」"
    },
    {
        "name": "莲",
        "message": "「嗯？」"
    },
    {
        "name": "清露",
        "message": "「今天放学后，能来公园吗？」"
    },
    {
        "name": "莲",
        "message": "「嗯，可以啊……学生会结束后行吗？」"
    },
    {
        "name": "清露",
        "message": "「嗯、嗯……」"
    },
    {
        "name": "莲",
        "message": "「学生会应该很快就结束，结束后我会联系你的」"
    },
    {
        "name": "清露",
        "message": "「知道了……那我等你哦」"
    },
    {
        "name": "莲",
        "message": "「嗯」"
    },
    {
        "message": "然后，夕凪拿起书包离开了教室。"
    },
    {
        "message": "让我在公园等她……仔细想想，为什么呢。"
    },
    {
        "message": "不禁想了很多……"
    },
    {
        "message": "越想，心跳似乎就越快。"
    },
    {
        "name": "艾莉卡",
        "message": "「九条君……」"
    },
    {
        "name": "莲",
        "message": "「…………」"
    },
    {
        "name": "莲",
        "message": "「啊、在！」"
    },
    {
        "message": "回过神来，发现自己正呆呆地望着窗外的夕阳景色。"
    },
    {
        "name": "艾莉卡",
        "message": "「怎么了？」"
    },
    {
        "name": "莲",
        "message": "「没、没什么」"
    },
    {
        "name": "莲",
        "message": "「今天的学生会内容，完全没听进去啊……待会得向猫城前辈道歉，再听一遍」"
    },
    {
        "message": "猫城前辈……"
    },
    {
        "message": "想起前辈的脸，就联想到了以前的约定。"
    },
    {
        "message": "夕凪从小的朋友……已经问过千惠酱了，好像还少了一个人……"
    },
    {
        "name": "莲",
        "message": "「啊，说起来，还没问过汐崎同学呢」"
    },
    {
        "message": "因为夕凪一开始就否认她是初恋对象，所以自然而然地把她排除在调查对象之外了……"
    },
    {
        "message": "听说她在为了县大会而努力训练田径部，所以我第一时间就来到了校园。"
    },
    {
        "name": "莲",
        "message": "「汐崎同学，能耽误你一下吗……」"
    },
    {
        "name": "雪",
        "message": "「诶，什么事……？」"
    },
    {
        "message": "握着最后一块拼图的人是汐崎同学。"
    },
    {
        "message": "早知道一开始就该问问她的……"
    },
    {
        "message": "听完汐崎同学的话，缺失的记忆拼图终于完整了。"
    },
    {
        "message": "终于可以实现一直以来背负的约定了。但是……"
    },
    {
        "name": "莲",
        "message": "「对不起……」"
    },
    {
        "name": "莲",
        "message": "「夕凪……」"
    },
    {
        "message": "夕凪坐在秋千上，轻轻摇晃着。"
    },
    {
        "name": "清露",
        "message": "「啊……」"
    },
    {
        "name": "莲",
        "message": "「嘿」"
    },
    {
        "message": "我坐在她旁边的秋千上。"
    },
    {
        "name": "清露",
        "message": "「嗯……那个……」"
    },
    {
        "name": "莲",
        "message": "「这个公园以前滑梯下面是沙坑吧」"
    },
    {
        "name": "清露",
        "message": "「诶？」"
    },
    {
        "message": "我打断夕凪的话，开始说起来。"
    },
    {
        "name": "清露",
        "message": "「嗯、嗯，是啊」"
    },
    {
        "name": "莲",
        "message": "「我以前经常在这里的沙坑里玩」"
    },
    {
        "name": "莲",
        "message": "「和一个头发长到这里的女孩子一起……」"
    },
    {
        "name": "清露",
        "message": "「嗯、嗯……」"
    },
    {
        "name": "莲",
        "message": "「然后，我和那个女孩约定好了。下次见面时要把这个还给她」"
    },
    {
        "message": "我向夕凪展示了『呆萌猫』的钥匙扣。"
    },
    {
        "name": "莲",
        "message": "「给，这个……」"
    },
    {
        "name": "清露",
        "message": "「诶？」"
    },
    {
        "name": "莲",
        "message": "「这是约定吧？」"
    },
    {
        "name": "莲",
        "message": "「说好要还给你的」"
    },
    {
        "name": "清露",
        "message": "「等、等等等等……！」"
    },
    {
        "name": "莲",
        "message": "「你慌什么啊……抱歉让你等这么久……」"
    },
    {
        "name": "清露",
        "message": "「…………」"
    },
    {
        "name": "清露",
        "message": "「啊、谢谢……」"
    },
    {
        "message": "夕凪接过了钥匙扣。"
    },
    {
        "name": "莲",
        "message": "「哈哈，这样就OK了……」"
    },
    {
        "name": "莲",
        "message": "「还有啊……」"
    },
    {
        "name": "清露",
        "message": "「……什么？」"
    },
    {
        "message": "即使我的心意传达不到也没关系。我现在就想告诉夕凪这个……"
    },
    {
        "name": "莲",
        "message": "「…………」"
    },
    {
        "name": "莲",
        "message": "「我啊……喜欢夕凪」"
    },
    {
        "name": "清露",
        "message": "「诶……？」"
    },
    {
        "name": "莲",
        "message": "「我喜欢夕凪……」"
    },
    {
        "name": "莲",
        "message": "「我喜欢夕凪清露」"
    },
    {
        "name": "清露",
        "message": "「等等等等，你在说什么啊我听不懂」"
    },
    {
        "name": "莲",
        "message": "「就只是这样而已……啊，约定……真的很抱歉这么晚才兑现」"
    },
    {
        "name": "清露",
        "message": "「诶，不……」"
    },
    {
        "name": "莲",
        "message": "「那么……我先回去了！明天见！」"
    },
    {
        "message": "虽然这么说，但在回家的路上我一直在想着从明天开始该如何与她相处。"
    },
    {
        "message": "不过，我终于能够传达出重要的心意了。"
    },
    {
        "message": "向喜欢的人说出了喜欢。"
    },
    {
        "message": "不行，不能回头看……"
    },
    {
        "name": "清露",
        "message": "「我也……喜欢你……」"
    },
    {
        "name": "莲",
        "message": "「……！！」"
    },
    {
        "name": "清露",
        "message": "「我也喜欢九条！」"
    },
    {
        "name": "莲",
        "message": "「诶……」"
    },
    {
        "name": "清露",
        "message": "「哈……哈……」"
    },
    {
        "message": "我的心跳达到了顶点。"
    },
    {
        "name": "莲",
        "message": "「嗯……」"
    },
    {
        "name": "莲",
        "message": "「我知道了……谢谢你，夕凪」"
    },
    {
        "name": "清露",
        "message": "「呵呵……我也……谢谢你」"
    },
    {
        "name": "莲",
        "message": "「话说，刚才你难得地叫了我的名字呢」"
    },
    {
        "name": "清露",
        "message": "「啊？我说过这种话吗？」"
    },
    {
        "name": "莲",
        "message": "「嗯，你说了。你说了九条」"
    },
    {
        "name": "清露",
        "message": "「是、是吗……」"
    },
    {
        "name": "莲",
        "message": "「以后也多叫叫我的名字吧。不要用'你啊'之类的称呼」"
    },
    {
        "name": "莲",
        "message": "「叫我莲就行了……」"
    },
    {
        "name": "清露",
        "message": "「诶……我知道了……」"
    },
    {
        "name": "清露",
        "message": "「莲、莲……」"
    },
    {
        "name": "莲",
        "message": "「嗯嗯」"
    },
    {
        "name": "清露",
        "message": "「有、有点……害羞呢……」"
    },
    {
        "name": "莲",
        "message": "「哈哈，很快就会习惯的」"
    },
    {
        "name": "清露",
        "message": "「那、那么，我也有个请求……你也用我的名字叫我吧」"
    },
    {
        "name": "莲",
        "message": "「嗯、嗯。好啊」"
    },
    {
        "name": "莲",
        "message": "「清露……」"
    },
    {
        "name": "清露",
        "message": "「呜呜，有点害羞呢……」"
    },
    {
        "name": "莲",
        "message": "「哈哈哈」"
    },
    {
        "name": "清露",
        "message": "「不过，很开心……」"
    },
    {
        "name": "莲",
        "message": "「说起来，优奈……清露，你之前说的是什么事？」"
    },
    {
        "name": "清露",
        "message": "「没、没什么大不了的啦！」"
    },
    {
        "name": "莲",
        "message": "「什、什么啊……说好不许有秘密的」"
    },
    {
        "name": "清露",
        "message": "「啊、啊、跟你一样啦！」"
    },
    {
        "name": "莲",
        "message": "「诶……？」"
    },
    {
        "name": "清露",
        "message": "「跟你一样啦！」"
    },
    {
        "name": "莲",
        "message": "「啊、啊哈哈哈，原来是这样啊」"
    },
    {
        "message": "真是绝妙的时机啊。"
    },
    {
        "name": "清露",
        "message": "「话说，你怎么发现的？」"
    },
    {
        "name": "莲",
        "message": "「我问了汐崎同学。关于以前优奈……清露的事」"
    },
    {
        "message": "果然还是不太习惯用名字称呼。清露到最后也还是叫我你。"
    },
    {
        "message": "从汐崎那里听说，清露从很久以前就喜欢布偶猫，汐崎是在进入初中前不久才被告知的。"
    },
    {
        "message": "所以，汐崎同学的猜测完全被排除了，再加上清露来我房间时的反应，还有猫城前辈在妄想中喃喃自语的内容。"
    },
    {
        "message": "另外，从汐崎同学那里听到了清露初恋的故事，我也想起了所有零碎记忆的片段。"
    },
    {
        "name": "莲",
        "message": "「这里这样……那样的话……」"
    },
    {
        "name": "莲",
        "message": "「哒哒！」"
    },
    {
        "name": "清露",
        "message": "「哇！」"
    },
    {
        "message": "年幼的男孩在滑梯下的沙坑里，用沙子堆出了一座高度约为自己身高一半、形状奇特的塔。"
    },
    {
        "message": "站在旁边的女孩对此感到惊叹不已。"
    },
    {
        "name": "莲",
        "message": "「嘿嘿，厉害吧！」"
    },
    {
        "name": "清露",
        "message": "「嗯，太厉害了！」"
    },
    {
        "message": "男孩站起身来，一脸得意。"
    },
    {
        "message": "然而，就在他炫耀的下一刻，男孩在马路上发现了什么。"
    },
    {
        "name": "莲",
        "message": "「啊」"
    },
    {
        "name": "清露",
        "message": "「嗯？」"
    },
    {
        "name": "莲",
        "message": "「是猫！」"
    },
    {
        "name": "清露",
        "message": "「猫？」"
    },
    {
        "name": "莲",
        "message": "「你看，它想过马路呢」"
    },
    {
        "name": "清露",
        "message": "「啊，真的耶」"
    },
    {
        "message": "女孩也站了起来，望向马路。"
    },
    {
        "message": "幼猫正等待对面道路上没有车的瞬间，准备横穿马路。"
    },
    {
        "name": "莲",
        "message": "「嘿，我们去摸摸它吧」"
    },
    {
        "name": "清露",
        "message": "「诶，可是爸爸说马路很危险，不能到马路上去……」"
    },
    {
        "name": "莲",
        "message": "「一小会儿没事的啦！」"
    },
    {
        "name": "莲",
        "message": "「你也想摸摸猫咪吧？」"
    },
    {
        "name": "清露",
        "message": "「嗯、嗯……我是喜欢小猫咪啦……」"
    },
    {
        "name": "莲",
        "message": "「来嘛来嘛！」"
    },
    {
        "message": "说着，男孩拉着女孩的手走出了公园。"
    },
    {
        "message": "男孩和女孩正观察着幼猫是否会过来这边。"
    },
    {
        "name": "清露",
        "message": "「猫咪嘴里叼着什么」"
    },
    {
        "name": "莲",
        "message": "「咦，它叼着什么呢……？」"
    },
    {
        "message": "幼猫小心翼翼地叼着一个金属制的东西。"
    },
    {
        "name": "清露",
        "message": "「是要送给谁的礼物吗？」"
    },
    {
        "name": "莲",
        "message": "「嗯——可能是吧」"
    },
    {
        "name": "清露",
        "message": "「好可爱啊」"
    },
    {
        "message": "终于，幼猫抓住了没有车辆经过的空档，走上了马路。"
    },
    {
        "message": "可能是性格比较悠闲，幼猫慢悠悠地走在马路上。"
    },
    {
        "name": "莲",
        "message": "「啊，来了来了！」"
    },
    {
        "name": "清露",
        "message": "「呵呵呵」"
    },
    {
        "message": "当幼猫走到马路中间时，附近的信号灯从红变绿，一辆卡车开始行驶。"
    },
    {
        "message": "话虽如此，这只幼猫有足够的距离安全通过。"
    },
    {
        "name": "清露",
        "message": "「啊，信号灯变绿了」"
    },
    {
        "name": "莲",
        "message": "「没事的，这个距离足够了」"
    },
    {
        "name": "清露",
        "message": "「真的没问题吗……」"
    },
    {
        "message": "少女将手放在胸前，露出了忐忑不安的表情。"
    },
    {
        "name": "幼猫",
        "message": "「喵」"
    },
    {
        "message": "幼猫不小心把嘴里叼着的东西掉了下来。"
    },
    {
        "name": "清露",
        "message": "「啊」"
    },
    {
        "name": "莲",
        "message": "「哎呀」"
    },
    {
        "message": "幼猫又想把那个东西叼回嘴里。"
    },
    {
        "name": "幼猫",
        "message": "「喵呜」"
    },
    {
        "message": "但是，没能成功叼起来。"
    },
    {
        "message": "第二次也想捡起来，但还是没能成功叼住。"
    },
    {
        "message": "卡车司机似乎没有注意到幼猫，车速越来越快地逼近。"
    },
    {
        "name": "莲",
        "message": "「危险！！！」"
    },
    {
        "message": "少年从人行道上冲了出去。"
    },
    {
        "message": "卡车没有减速，继续逼近。"
    },
    {
        "name": "清露",
        "message": "「呀啊啊啊！！」"
    },
    {
        "message": "卡车司机注意到冲出来的少年，一边大声鸣笛一边踩刹车。"
    },
    {
        "message": "然而，高速行驶的车辆无法立即停下，继续朝着幼猫和少年的方向驶去。"
    },
    {
        "name": "幼猫",
        "message": "「喵！！！」"
    },
    {
        "name": "清露",
        "message": "「啊，啊……」"
    },
    {
        "message": "少女瘫坐在人行道上。"
    },
    {
        "message": "少女的目光所及之处是倒在地上的少年的身影。"
    },
    {
        "message": "卡车司机将卡车停在路边，跑向倒在对面车道的少年身边。"
    },
    {
        "name": "司机",
        "message": "「你、你没事吧！？」"
    },
    {
        "name": "莲",
        "message": "「呼呼……我没事」"
    },
    {
        "name": "司机",
        "message": "「太、太好了……有没有受伤？」"
    },
    {
        "name": "莲",
        "message": "「没有」"
    },
    {
        "name": "司机",
        "message": "「这样啊……小子，突然冲出来太危险了，别再这么干了」"
    },
    {
        "name": "莲",
        "message": "「是，对不起」"
    },
    {
        "message": "少年站起身来，深深地鞠了一躬。"
    },
    {
        "message": "司机说了句『那就好』，又回去工作了。"
    },
    {
        "message": "少女露出了如释重负的表情。"
    },
    {
        "message": "少年站在对面车道，向少女展示了手中的猫……"
    },
    {
        "name": "莲",
        "message": "「猫，救到了！」"
    },
    {
        "message": "然后，咧嘴一笑。"
    },
    {
        "message": "据说，这一刻我让她心跳加速了。"
    },
    {
        "message": "顺便说一下，猫城前辈似乎也在那时看到了我们……"
    },
    {
        "name": "莲",
        "message": "「不知道那时候的小猫现在还活着吗？」"
    },
    {
        "name": "清露",
        "message": "「谁知道呢……毕竟当时冲到马路上去了……」"
    },
    {
        "name": "莲",
        "message": "「别说这么悲伤的话啊……」"
    },
    {
        "name": "清露",
        "message": "「希望它现在还活着，在某个地方过得好好的」"
    },
    {
        "name": "莲",
        "message": "「是啊」"
    },
    {
        "name": "清露",
        "message": "「呵呵，话说回来，当我知道你就是我的初恋对象时，真是吓了一跳呢……」"
    },
    {
        "name": "莲",
        "message": "「我也是，真没想到……话说既然是这样，你早该告诉我啊」"
    },
    {
        "name": "清露",
        "message": "「可、可是……」"
    },
    {
        "message": "我们就这样一直聊着往事，直到日落西山，度过了二人世界的时光。"
    },
    {
        "message": "清露的笑容，害羞的表情，一切都显得那么耀眼。"
    },
    {
        "message": "想到以后能在身边更多地看到这样的笑容，我也不禁露出了笑容。"
    },
    {
        "message": "缺失的拼图碎片以最完美的形式填补上，完成了整幅图画。"
    }
]