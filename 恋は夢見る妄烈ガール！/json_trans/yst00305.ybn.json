[
    {
        "name": "莲",
        "message": "「哈～，终于结束了结束了」"
    },
    {
        "name": "清露",
        "message": "「啊啊，终于结束了……」"
    },
    {
        "message": "夕凪一副世界末日般的表情。"
    },
    {
        "name": "莲",
        "message": "「小测试只是小测试而已……只要在期中考试前能够解出来就没问题吧」"
    },
    {
        "name": "清露",
        "message": "「嗯，话是这么说没错……」"
    },
    {
        "message": "今天最后一节课是数学，我们刚刚参加了那场小测试。"
    },
    {
        "message": "看来夕凪几乎一道题都没做出来。"
    },
    {
        "name": "清露",
        "message": "「我已经没有动力了……」"
    },
    {
        "name": "莲",
        "message": "「喂喂，不是说好接下来要去图书馆学习吗」"
    },
    {
        "name": "清露",
        "message": "「虽然是这么说，但我已经没有动力了……」"
    },
    {
        "name": "莲",
        "message": "「唔嗯……」"
    },
    {
        "message": "啊，对了……"
    },
    {
        "message": "从以前开始，想要激发学习动力就得用糖果来钓鱼。"
    },
    {
        "name": "莲",
        "message": "「如果期中考试努力的话，就给你一个月爱嘉的便当和一天玩耍的权利……」"
    },
    {
        "name": "清露",
        "message": "「来，学习吧，学习！」"
    },
    {
        "message": "爱嘉，对不起……"
    },
    {
        "name": "清露",
        "message": "「好久没来图书馆了呢」"
    },
    {
        "name": "莲",
        "message": "「我是第一次来，挺气派的嘛」"
    },
    {
        "message": "镇上的图书馆离学校步行大约20分钟。"
    },
    {
        "message": "我本以为会是座古旧的建筑，没想到比预想中还要气派。"
    },
    {
        "message": "不过，这样也有这样的好处。"
    },
    {
        "name": "清露",
        "message": "「那，我们去学习座位吧」"
    },
    {
        "name": "莲",
        "message": "「嗯」"
    },
    {
        "message": "这里的图书馆有专门的学习座位，和阅览座位是分开的。"
    },
    {
        "name": "清露",
        "message": "「这里可以吗？」"
    },
    {
        "message": "为了不打扰别人，我们找了个尽量没人的地方坐下。"
    },
    {
        "name": "莲",
        "message": "「喂，你看，果然有咱们学校的学生啊！」"
    },
    {
        "name": "莲",
        "message": "「我觉得还是在教室里学习更不容易被怀疑」"
    },
    {
        "message": "学习区里有四个看起来是美丘学园三年级的学生。他们看上去挺认真的……"
    },
    {
        "name": "清露",
        "message": "「吵，吵死了！」"
    },
    {
        "name": "清露",
        "message": "「我还以为没人会在这种地方学习呢……」"
    },
    {
        "name": "莲",
        "message": "「看来我们想得太简单了」"
    },
    {
        "name": "清露",
        "message": "「吵死了吵死了！」"
    },
    {
        "name": "莲",
        "message": "「嘛，我倒是无所谓」"
    },
    {
        "name": "清露",
        "message": "「那不就行了吗」"
    },
    {
        "name": "莲",
        "message": "「不，可是你不是不想被误会成情侣吗……」"
    },
    {
        "name": "清露",
        "message": "「谁、谁说情侣了啊」"
    },
    {
        "name": "莲",
        "message": "「不是，你刚才不就是这个意思吗？」"
    },
    {
        "name": "清露",
        "message": "「哼……」"
    },
    {
        "message": "她今天的状态似乎不太对劲啊……和文化祭前不一样的意义上。"
    },
    {
        "message": "平时的她应该会更直截了当地回应才对。"
    },
    {
        "name": "清露",
        "message": "「够了，快点开始学习吧」"
    },
    {
        "name": "莲",
        "message": "「哦」"
    },
    {
        "message": "一坐下，我就打开了教科书。"
    },
    {
        "message": "我们每人轮流教对方一个小时。"
    },
    {
        "message": "我们先把不懂的地方挑出来，然后互相教对方。"
    },
    {
        "message": "就在我正教清露的时候，果不其然，几个面熟的美丘学园学生走进了图书馆。"
    },
    {
        "name": "清露",
        "message": "「啊，那是……初中部的……」"
    },
    {
        "message": "是文化祭时帮忙的那三个初中部女生。"
    },
    {
        "name": "莲",
        "message": "「真的诶」"
    },
    {
        "name": "清露",
        "message": "「喂，别让她们发现啊……要是在这里被用奇怪的眼光看待的话……」"
    },
    {
        "name": "莲",
        "message": "「我、我知道啦……」"
    },
    {
        "message": "不过，看到清露的背影，还能想到除了清露以外的谁呢？"
    },
    {
        "name": "清露",
        "message": "「…………」"
    },
    {
        "name": "清露",
        "message": "「总觉得被盯着看了……」"
    },
    {
        "message": "我用余光瞥了一眼初中部的学生，她们明显在偷偷看这边，还窃窃私语。"
    },
    {
        "message": "而且，看起来异常开心。"
    },
    {
        "name": "清露",
        "message": "「呣呣呣呣——」"
    },
    {
        "name": "莲",
        "message": "「喏，所以我才说不行吧」"
    },
    {
        "name": "清露",
        "message": "「呣呣呣——………」"
    },
    {
        "message": "恐怕明天，初中部的一些人就会传播我们被目击的消息，肯定会在某处演变成我们在交往的谣言。"
    },
    {
        "message": "谣言大多都是这样的。"
    },
    {
        "name": "清露",
        "message": "「啊——已经晚上了呢」"
    },
    {
        "name": "莲",
        "message": "「毕竟我们学习了两个小时啊……」"
    },
    {
        "name": "清露",
        "message": "「好累啊——」"
    },
    {
        "name": "莲",
        "message": "「确实……」"
    },
    {
        "name": "莲",
        "message": "「不过，你的讲解比我想象的更容易理解」"
    },
    {
        "name": "清露",
        "message": "「什么意思啊那是」"
    },
    {
        "name": "莲",
        "message": "「字面意思」"
    },
    {
        "name": "清露",
        "message": "「你今天怎么这么坦率……？」"
    },
    {
        "message": "她带着狡黠的笑容用力合上了笔袋。"
    },
    {
        "name": "莲",
        "message": "「啊哈哈……」"
    },
    {
        "message": "看来刚才那句话说得有点过头了。"
    },
    {
        "name": "清露",
        "message": "「话说回来，你要是再不提高一下国语水平，英语也学不好哦」"
    },
    {
        "name": "莲",
        "message": "「确实……我不太擅长现代文」"
    },
    {
        "message": "现代文与数学不同，存在一些非绝对性的问题，答案会因人而异。"
    },
    {
        "message": "虽然有人说答案只有一个，但我并不这么认为。"
    },
    {
        "name": "清露",
        "message": "「嗯，我也不是很擅长呢……」"
    },
    {
        "name": "莲",
        "message": "「至少想在国语数学英语这三科上拿到高分啊」"
    },
    {
        "name": "清露",
        "message": "「是啊」"
    },
    {
        "name": "莲",
        "message": "「我觉得国语也是有技巧可言的」"
    },
    {
        "name": "清露",
        "message": "「嗯……技巧吗……」"
    },
    {
        "message": "我在脑海中回想着擅长国语的人。"
    },
    {
        "message": "…………。"
    },
    {
        "message": "正当我几乎要放弃，觉得没什么人能教我的时候，突然想到了一个人。"
    },
    {
        "message": "不，应该说是我一开始就排除在考虑范围之外的那个人。"
    },
    {
        "name": "莲",
        "message": "「啊……不如让猫城前辈教我们吧」"
    },
    {
        "name": "清露",
        "message": "「啊？」"
    },
    {
        "name": "清露",
        "message": "「所以说，那个人不行啊……绝——对不行，有你在的话反而会更加跑题的」"
    },
    {
        "name": "莲",
        "message": "「是这样吗？」"
    },
    {
        "name": "莲",
        "message": "「可是，也没有其他人能教我们了」"
    },
    {
        "name": "清露",
        "message": "「嗯，是这样没错……」"
    },
    {
        "name": "莲",
        "message": "「那就这么定了」"
    },
    {
        "name": "清露",
        "message": "「凭什么啊！」"
    },
    {
        "name": "清露",
        "message": "「啊，该不会你其实是想和艾莉卡在一起吧？」"
    },
    {
        "name": "莲",
        "message": "「喂，才不是那样呢！」"
    },
    {
        "name": "清露",
        "message": "「怎么感觉你慌张的样子很可疑啊？」"
    },
    {
        "name": "莲",
        "message": "「你你你在说什么啊」"
    },
    {
        "name": "清露",
        "message": "「嗯——……」"
    },
    {
        "message": "夕凪用怀疑的眼神看着我。"
    },
    {
        "message": "算了，总之明天去找本人商量一下吧。"
    },
    {
        "name": "清露",
        "message": "「啊，妈妈打电话来了」"
    },
    {
        "name": "莲",
        "message": "「嗯」"
    },
    {
        "message": "夕凪从口袋里掏出一部带着愤怒熊手机壳的智能手机，接起了电话。"
    },
    {
        "name": "清露",
        "message": "「什么事？……嗯……嗯……」"
    },
    {
        "name": "清露",
        "message": "「诶诶！？弄坏了！？真是的！」"
    },
    {
        "name": "清露",
        "message": "「为什么要弄坏啊……」"
    },
    {
        "name": "清露",
        "message": "「哼」"
    },
    {
        "message": "她无力地挂断了电话。"
    },
    {
        "name": "莲",
        "message": "「怎、怎么了吗？」"
    },
    {
        "name": "清露",
        "message": "「好像是妈妈在我房间里不小心碰到愤怒熊的摆件，把它弄坏了……唉」"
    },
    {
        "name": "清露",
        "message": "「那个对我来说还挺重要的……」"
    },
    {
        "name": "莲",
        "message": "「摆件是塑料的吗？」"
    },
    {
        "name": "清露",
        "message": "「嗯，不太清楚，但是是硬的」"
    },
    {
        "name": "莲",
        "message": "「那应该能修好」"
    },
    {
        "name": "清露",
        "message": "「诶……？」"
    },
    {
        "name": "莲",
        "message": "「你忘了吗，那个王冠可是我做的哦？」"
    },
    {
        "name": "清露",
        "message": "「啊，对哦……不过，真的可以吗？」"
    },
    {
        "name": "莲",
        "message": "「现在就能帮你修」"
    },
    {
        "name": "清露",
        "message": "「真的真的？」"
    },
    {
        "name": "莲",
        "message": "「嗯，真的真的」"
    },
    {
        "message": "夕凪的表情肉眼可见地变成了笑脸。"
    },
    {
        "name": "清露",
        "message": "「太好啦♪」"
    },
    {
        "name": "清露",
        "message": "「那就拜托你啦！」"
    },
    {
        "name": "莲",
        "message": "「嗯，今天正好带着工具呢」"
    },
    {
        "message": "我昨天忘记把文化祭准备用的工具带回家了，所以今天打算带回去。"
    },
    {
        "message": "没想到在这种时候忘记竟然这么巧。"
    },
    {
        "name": "清露",
        "message": "「我家在这边！」"
    },
    {
        "name": "莲",
        "message": "「好嘞」"
    },
    {
        "message": "嘛，大致路线我还是知道的……"
    },
    {
        "message": "文化祭前我送夕凪回过家，所以这是第二次去夕凪家，不过还是第一次进去。"
    },
    {
        "message": "或者说，这可能是我第一次进女生的房间。"
    },
    {
        "name": "莲",
        "message": "「女生的房间啊……」"
    },
    {
        "message": "不小心说出了口。"
    },
    {
        "name": "清露",
        "message": "「别、别说什么女生的房间啦」"
    },
    {
        "message": "她脸红了，似乎是从『女生的房间』这个词联想到了什么。"
    },
    {
        "name": "莲",
        "message": "「啊，抱歉……」"
    },
    {
        "name": "清露",
        "message": "「话说，你没进过爱嘉酱的房间吗？」"
    },
    {
        "name": "莲",
        "message": "「进过是进过……但爱嘉的房间应该不算是女生的房间吧」"
    },
    {
        "name": "清露",
        "message": "「那个爱嘉酱如果不是女生的话那是什么啊」"
    },
    {
        "name": "莲",
        "message": "「妹妹？」"
    },
    {
        "name": "清露",
        "message": "「嗯——……」"
    },
    {
        "message": "夕凪看起来还是不太理解的样子。"
    },
    {
        "message": "然后，她从一个腰高的架子上拿出一个坏掉的熊型角色手办给我看。"
    },
    {
        "name": "清露",
        "message": "「就是这个……」"
    },
    {
        "message": "右臂和右腿都掉了。"
    },
    {
        "name": "莲",
        "message": "「材质是树脂石啊……因为挺大的，不用黄铜丝固定的话很快又会坏掉吧」"
    },
    {
        "name": "清露",
        "message": "「那、那就是说能修好吗？」"
    },
    {
        "name": "莲",
        "message": "「嗯，应该能修好」"
    },
    {
        "name": "清露",
        "message": "「太好啦」"
    },
    {
        "name": "莲",
        "message": "「不会花太多时间，我在这里修好可以吗？」"
    },
    {
        "name": "清露",
        "message": "「诶，嗯、嗯……可以是可以啦？」"
    },
    {
        "name": "莲",
        "message": "「好嘞，30分钟搞定」"
    },
    {
        "message": "我打开工具箱，拿出了钻头、黄铜丝和瞬间胶。"
    },
    {
        "message": "我工作的时候，夕凪一直在看着我的手，显得很感兴趣。"
    },
    {
        "message": "虽然是第一次进女生的房间，但感觉很舒服。"
    },
    {
        "name": "莲",
        "message": "「搞定了！」"
    },
    {
        "name": "清露",
        "message": "「哇哦！！！」"
    },
    {
        "message": "那只目光锐利的棕色熊死里逃生了。"
    },
    {
        "name": "清露",
        "message": "「谢谢你！！」"
    },
    {
        "name": "莲",
        "message": "「唔」"
    },
    {
        "message": "夕凪用闪闪发光的眼睛看着我。"
    },
    {
        "message": "老实说，被这样的眼神注视着，我不知该如何反应，该怎么说呢……不，其实我很高兴。"
    },
    {
        "name": "莲",
        "message": "「那么，我差不多该回去了！时间已经不早了，爱嘉也会担心的」"
    },
    {
        "message": "我收拾好工具箱，掩饰自己的害羞。"
    },
    {
        "name": "清露",
        "message": "「诶，啊」"
    },
    {
        "name": "清露",
        "message": "「嗯……」"
    },
    {
        "message": "夕凪和我一样，脸颊染上了红晕。"
    },
    {
        "name": "莲",
        "message": "「那、那么明天见」"
    },
    {
        "name": "清露",
        "message": "「明天，见……」"
    },
    {
        "name": "莲",
        "message": "「还有，那个最好放置一晚上再用哦！」"
    },
    {
        "name": "莲",
        "message": "「拜拜！」"
    },
    {
        "name": "爱嘉",
        "message": "「哥哥，你看起来特别高兴呢？」"
    },
    {
        "message": "从清露家回来后，我正懒洋洋地躺在客厅里，爱嘉坐到我旁边开始搭话。"
    },
    {
        "name": "莲",
        "message": "「啊？是这样吗」"
    },
    {
        "name": "爱嘉",
        "message": "「嗯……是不是发生了什么开心的事？」"
    },
    {
        "name": "莲",
        "message": "「差不多吧」"
    },
    {
        "message": "为什么我会这么高兴呢……"
    },
    {
        "message": "而且，我还在想着快点到明天啊……"
    },
    {
        "message": "难道这就是……"
    }
]