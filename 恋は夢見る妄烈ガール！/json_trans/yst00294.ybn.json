[
    {
        "name": "葵",
        "message": "「果然九条君太忙了吧？」"
    },
    {
        "name": "莲",
        "message": "「我？」"
    },
    {
        "message": "我和美丘在学生食堂吃完美味的午餐，正准备回教室。"
    },
    {
        "name": "葵",
        "message": "「嗯……」"
    },
    {
        "name": "莲",
        "message": "「嘛，没办法啊。不过，我觉得能组成一个不错的组合。」"
    },
    {
        "name": "葵",
        "message": "「唔唔唔，虽然可能没办法」"
    },
    {
        "name": "葵",
        "message": "「你是打算搞音乐剧吗？」"
    },
    {
        "name": "莲",
        "message": "「呃」"
    },
    {
        "message": "确、确实有那种气势呢……就像是凡○赛宫的玫○一样。"
    },
    {
        "message": "不过，看了从汐崎那借来的DVD后，我觉得小品的世界观很重要，所以我认为我们做的事并不是徒劳的。"
    },
    {
        "name": "葵",
        "message": "「总——之！我不能和大家一起玩很寂寞啦！」"
    },
    {
        "name": "莲",
        "message": "「啊，你是在担心这个啊」"
    },
    {
        "name": "莲",
        "message": "「但是确实最近没什么时间玩呢……你那边的企划进展顺利吗？」"
    },
    {
        "name": "葵",
        "message": "「嗯。基本上只是在继承前人的工作而已啦」"
    },
    {
        "name": "莲",
        "message": "「啊，确实是这样呢……」"
    },
    {
        "name": "葵",
        "message": "「雪酱还有社团活动，练习也很忙」"
    },
    {
        "name": "莲",
        "message": "「是这样啊」"
    },
    {
        "name": "葵",
        "message": "「唯一的慰藉就只有和九条君一起吃午饭了！」"
    },
    {
        "message": "只有和我一起吃午饭是寂寞还是幸福呢……"
    },
    {
        "name": "莲",
        "message": "「这话该怎么理解呢？」"
    },
    {
        "name": "葵",
        "message": "「当然是好意思啦？」"
    },
    {
        "message": "她一脸理所当然地说道。"
    },
    {
        "name": "莲",
        "message": "「哦、哦……」"
    },
    {
        "message": "被这么直白地说出来，心里不禁一阵悸动。"
    },
    {
        "name": "葵",
        "message": "「唉……所以九条君，午休时间别总是因为讨论什么的就不见人影哦？」"
    },
    {
        "name": "莲",
        "message": "「嗯，我也尽量想和美丘同学安安静静地吃饭」"
    },
    {
        "name": "莲",
        "message": "「本来我就是个喜欢平和的人嘛」"
    },
    {
        "name": "葵",
        "message": "「『也』是什么意思，好像我也是个喜欢平和的人似的？」"
    },
    {
        "name": "莲",
        "message": "「诶，不是吗？」"
    },
    {
        "name": "葵",
        "message": "「呜呜呜，我可是认认真真地生活着呢」"
    },
    {
        "name": "莲",
        "message": "「诶诶」"
    },
    {
        "message": "看来美丘同学并没有这种自觉。"
    },
    {
        "message": "就这样边聊边走，不知不觉就到了教室前。"
    },
    {
        "name": "葵",
        "message": "「那么，为了认真生活，下午的学习也要加油啊！」"
    },
    {
        "name": "莲",
        "message": "「喔！我也得加油才行」"
    },
    {
        "name": "葵",
        "message": "「可别睡觉啊！」"
    },
    {
        "name": "莲",
        "message": "「呃」"
    },
    {
        "message": "咯噔……我本来完全打算睡觉的……"
    },
    {
        "message": "昨天刚开始制作王冠的底座，一不小心太投入了，结果一直忙到天亮。"
    },
    {
        "name": "葵",
        "message": "「呵呵呵」"
    },
    {
        "name": "葵",
        "message": "「那，回头见啦」"
    },
    {
        "name": "莲",
        "message": "「嗯，回头见」"
    },
    {
        "message": "好吧，下午的课……就坚持到极限为止吧！"
    },
    {
        "message": "虽然我没说不会睡觉……"
    },
    {
        "name": "清露",
        "message": "「嗯……」"
    },
    {
        "name": "莲",
        "message": "「啊，别、别那么盯着看啊……」"
    },
    {
        "message": "在打扫完的教室里，我默默地给椅子添加着豪华绚烂的装饰。"
    },
    {
        "message": "尽管已经过了17点，教室里还留有几个人在为文化祭制作必需品。"
    },
    {
        "name": "清露",
        "message": "「为什么？」"
    },
    {
        "name": "莲",
        "message": "「有点害羞，或者说是不好意思」"
    },
    {
        "name": "清露",
        "message": "「哦，是吗？」"
    },
    {
        "name": "清露",
        "message": "「我在想，你果然不愧是模型狂，做得真不错啊」"
    },
    {
        "name": "莲",
        "message": "「是、是吗？谢谢……」"
    },
    {
        "name": "清露",
        "message": "「难得夸你一下，你看起来却不怎么高兴嘛」"
    },
    {
        "name": "莲",
        "message": "「不是，我超级高兴的！」"
    },
    {
        "name": "莲",
        "message": "「所以说，就是有点不好意思……」"
    },
    {
        "name": "清露",
        "message": "「哦，这样啊……那就好」"
    },
    {
        "message": "这样真的好吗？"
    },
    {
        "name": "莲",
        "message": "「说起来，你那边的背景插画看起来快完成了，进展如何？」"
    },
    {
        "message": "不知不觉中，我在没有集会的日子里都会在教室里专注于制作椅子，而体育馆里的大型制作物则完全交给了夕凪。"
    },
    {
        "name": "清露",
        "message": "「已经完美无缺了。就算挂在卢浮宫里也不为过呢」"
    },
    {
        "name": "莲",
        "message": "「是吗！那我待会儿也去看看吧」"
    },
    {
        "name": "清露",
        "message": "「嗯，来吧来吧！」"
    },
    {
        "name": "莲",
        "message": "「等我做到一个段落就去」"
    },
    {
        "name": "清露",
        "message": "「嗯，我等你哦！」"
    },
    {
        "name": "清露",
        "message": "「那么，我先回体育馆了」"
    },
    {
        "name": "莲",
        "message": "「哦」"
    },
    {
        "message": "不知不觉间已经过了18点。"
    },
    {
        "name": "莲",
        "message": "「啊，18点了啊……」"
    },
    {
        "message": "正当我望着时钟的时候，突然来了一位访客。"
    },
    {
        "name": "艾莉卡",
        "message": "「九条君～♪」"
    },
    {
        "name": "莲",
        "message": "「啊，猫城前辈」"
    },
    {
        "name": "莲",
        "message": "「……您来这里是有什么事吗？」"
    },
    {
        "message": "一般这样突然出现的时候，总感觉会带来什么紧急的事情。"
    },
    {
        "message": "不过，我知道猫城前辈很忙，而且我也告诉过她随时可以给我分配工作。"
    },
    {
        "name": "艾莉卡",
        "message": "「没什么，就是想来看看你有没有在努力工作」"
    },
    {
        "name": "莲",
        "message": "「诶……不是来给我安排什么紧急任务的吗？」"
    },
    {
        "name": "莲",
        "message": "「如果有的话请直说」"
    },
    {
        "name": "艾莉卡",
        "message": "「诶～都说了不是啦～」"
    },
    {
        "name": "莲",
        "message": "「真的吗？话说，如果有我能做的工作请尽管告诉我」"
    },
    {
        "name": "莲",
        "message": "「前辈你要是累坏了就麻烦了」"
    },
    {
        "name": "艾莉卡",
        "message": "「真是的……九条君你也太多疑了」"
    },
    {
        "name": "莲",
        "message": "「因为前辈你总是什么工作都接下来嘛……而且你不是还要准备升学考试吗」"
    },
    {
        "name": "艾莉卡",
        "message": "「嗯，是这样没错……」"
    },
    {
        "name": "艾莉卡",
        "message": "「九条君真是个温柔的人呢。不过真的没什么事，别担心啦！」"
    },
    {
        "name": "艾莉卡",
        "message": "「我只是想着能不能和九条君单独相处才来的」"
    },
    {
        "name": "莲",
        "message": "「前辈，别开这种玩笑啦」"
    },
    {
        "message": "顺便说一下，前辈的愿望并没有实现，教室里还有几个学生在专心制作东西。"
    },
    {
        "name": "艾莉卡",
        "message": "「我是认真的！」"
    },
    {
        "name": "艾莉卡",
        "message": "「……啊」"
    },
    {
        "name": "艾莉卡",
        "message": "「这就是清露说的那把椅子吧！」"
    },
    {
        "message": "前辈移动身体仔细查看椅子的每个角落。"
    },
    {
        "name": "莲",
        "message": "「夕凪说的？」"
    },
    {
        "name": "艾莉卡",
        "message": "「嗯。她说你给她做了一把超棒的椅子，高兴得不得了」"
    },
    {
        "name": "莲",
        "message": "「啊，是这样啊。夕凪她……」"
    },
    {
        "name": "艾莉卡",
        "message": "「不过，这椅子真的很厉害呢」"
    },
    {
        "name": "莲",
        "message": "「要听听我的独特设计吗？」"
    },
    {
        "name": "艾莉卡",
        "message": "「嗯，要听要听！」"
    },
    {
        "name": "莲",
        "message": "「嗯，首先请看这个扶手……这里的设计是……」"
    },
    {
        "name": "艾莉卡",
        "message": "「嗯嗯」"
    },
    {
        "message": "就这样，我滔滔不绝地讲了大约10分钟，而前辈一直兴致勃勃地倾听到最后。"
    },
    {
        "name": "艾莉卡",
        "message": "「原来如此～我深深感受到了九条君的热情！」"
    },
    {
        "name": "莲",
        "message": "「嘿嘿，说到造型我可是谁都不服的」"
    },
    {
        "name": "艾莉卡",
        "message": "「不愧是你呢！」"
    },
    {
        "name": "艾莉卡",
        "message": "「我很期待完成品哦」"
    },
    {
        "name": "莲",
        "message": "「嗯，请期待着吧」"
    },
    {
        "message": "然后，她把脸凑近我的耳边低语道。"
    },
    {
        "name": "艾莉卡",
        "message": "「完成后记得告诉我哦。我会给你奖励的，嘻嘻」"
    },
    {
        "name": "莲",
        "message": "「奖、奖励是……前辈！」"
    },
    {
        "message": "『给你』这种说法，肯定是那个意思吧。"
    },
    {
        "name": "艾莉卡",
        "message": "「不过，这种话我只对九条君说哦？」"
    },
    {
        "name": "莲",
        "message": "「即便如此我也不会高兴的」"
    },
    {
        "message": "我满脸通红地回答道。"
    },
    {
        "name": "艾莉卡",
        "message": "「嘴硬的样子，真可爱」"
    },
    {
        "name": "艾莉卡",
        "message": "「那，再见啦」"
    },
    {
        "name": "莲",
        "message": "「嗯，再见」"
    },
    {
        "name": "莲",
        "message": "「呼，要是没人在的话，又要出大事了……」"
    },
    {
        "name": "莲",
        "message": "「我也该回去了吧……话说已经到放学时间了……」"
    },
    {
        "message": "我确认了一下时间，然后看了看外面的情况。"
    },
    {
        "name": "莲",
        "message": "「啊，下雨了……」"
    },
    {
        "message": "突然，下起了让人想起转校第一天的雨。"
    },
    {
        "name": "莲",
        "message": "「咦，那是……」"
    },
    {
        "message": "往外看去，昏暗的校园里有一个人影在奔跑。"
    },
    {
        "message": "那个人影摇晃着长长的双马尾。"
    },
    {
        "name": "莲",
        "message": "「啊，是汐崎同学……原来一直在参加社团活动啊……」"
    },
    {
        "name": "莲",
        "message": "「雨下得挺大的啊……那样子肯定会被淋透的」"
    },
    {
        "name": "莲",
        "message": "「我记得我带毛巾来着……」"
    },
    {
        "message": "我在储物柜里翻找着平时为了以防万一而放在那里的毛巾。"
    },
    {
        "name": "莲",
        "message": "「找到了找到了」"
    },
    {
        "message": "我拿着毛巾朝校门口走去。"
    },
    {
        "name": "雪",
        "message": "「啊—，全湿透了……」"
    },
    {
        "name": "雪",
        "message": "「突然下雨什么的完全没听说过……唉……」"
    },
    {
        "message": "我刚到校门口，汐崎同学正好进来。"
    },
    {
        "name": "莲",
        "message": "「汐崎同学！」"
    },
    {
        "name": "雪",
        "message": "「嗯？」"
    },
    {
        "name": "雪",
        "message": "「啊，九条同学……怎么了？」"
    },
    {
        "name": "莲",
        "message": "「刚才往外看，看到汐崎同学在校园里跑步。想着你肯定全身湿透了，给，拿着这个」"
    },
    {
        "message": "我把毛巾递给汐崎同学。"
    },
    {
        "name": "雪",
        "message": "「诶，这是……」"
    },
    {
        "name": "莲",
        "message": "「用吧。就这样的话会感冒的哦」"
    },
    {
        "name": "雪",
        "message": "「诶……」"
    },
    {
        "name": "雪",
        "message": "「谢谢！」"
    },
    {
        "name": "莲",
        "message": "「不用客气」"
    },
    {
        "message": "看到汐崎同学的笑容，我的心又被紧紧揪住了。"
    },
    {
        "name": "莲",
        "message": "「呼……」"
    },
    {
        "message": "因为急急忙忙跑来，我稍微喘了口气。"
    },
    {
        "message": "这时冷静下来仔细看汐崎同学，发现她全身湿透，体操短裤变得透明了。"
    },
    {
        "message": "丰满的胸部处隐约可以看到内衣的轮廓。"
    },
    {
        "name": "莲",
        "message": "「……」"
    },
    {
        "name": "雪",
        "message": "「九条同学……怎么了？」"
    },
    {
        "message": "看到我沉默了一会儿，汐崎同学担心地开口问道。"
    },
    {
        "name": "莲",
        "message": "「没、没什么……咳咳」"
    },
    {
        "message": "汐崎同学似乎注意到了我的视线，低头看了看自己的身体。"
    },
    {
        "message": "然后……"
    },
    {
        "name": "雪",
        "message": "「哼！九条同学是笨蛋！色狼！！」"
    },
    {
        "message": "我的脸颊受到了巨大的伤害。5000点伤害。"
    },
    {
        "message": "（各种意义上的）"
    },
    {
        "message": "汐崎同学因为害羞，换上室内鞋后就飞奔回教室了。"
    },
    {
        "message": "我带着脸上的伤害回到教室，稍微装饰了一下椅子，然后开始收拾东西。"
    },
    {
        "message": "教室里的其他人也都已经回家了。"
    },
    {
        "name": "莲",
        "message": "「好了，该回家了……」"
    },
    {
        "name": "雪",
        "message": "「那个，九条同学……那个……」"
    },
    {
        "name": "莲",
        "message": "「啊，汐崎同学。刚才真是对不起……」"
    },
    {
        "name": "雪",
        "message": "「不，我才是，对不起。我慌了手脚，打了你……」"
    },
    {
        "name": "莲",
        "message": "「没事没事。被女孩子打也算是男人的工作之一嘛」"
    },
    {
        "message": "我在说什么啊。"
    },
    {
        "name": "雪",
        "message": "「你说什么呢，呵呵」"
    },
    {
        "name": "莲",
        "message": "「我、我在说什么呢……哈哈哈」"
    },
    {
        "name": "莲",
        "message": "「啊……汐崎同学，现在要回家吗？」"
    },
    {
        "name": "雪",
        "message": "「嗯？嗯，是要回家了……」"
    },
    {
        "name": "莲",
        "message": "「要、要一起回家吗？我也正准备回去呢」"
    },
    {
        "name": "雪",
        "message": "「啊，嗯……好啊」"
    },
    {
        "name": "莲",
        "message": "「太好了，那稍等一下」"
    },
    {
        "message": "我飞速收拾椅子。虽然收拾得有点粗糙，但我觉得没办法。"
    },
    {
        "name": "雪",
        "message": "「诶～，这是九条同学做的啊。就是清露说的那个吧」"
    },
    {
        "name": "莲",
        "message": "「啊，对对。不错吧？」"
    },
    {
        "name": "莲",
        "message": "「话说，是夕凪说的吗？」"
    },
    {
        "name": "雪",
        "message": "「嗯，她好像很高兴，还夸奖了呢！」"
    },
    {
        "name": "雪",
        "message": "「不过，确实很厉害啊～！」"
    },
    {
        "message": "夕凪……对我……。"
    },
    {
        "name": "莲",
        "message": "「啊」"
    },
    {
        "name": "雪",
        "message": "「诶？怎么了？」"
    },
    {
        "name": "莲",
        "message": "「没，没什么」"
    },
    {
        "message": "虽然不是没什么……但夕凪应该已经回去了吧……"
    },
    {
        "message": "说起来，我答应过她做到一个段落就去看看的。"
    },
    {
        "name": "莲",
        "message": "「好，回家吧」"
    },
    {
        "name": "雪",
        "message": "「嗯」"
    },
    {
        "name": "雪",
        "message": "「然后啊，那个松酱对矶崎说了这样的话」"
    },
    {
        "name": "雪",
        "message": "「那种事无所谓啦！」"
    },
    {
        "name": "莲",
        "message": "「哈哈哈，那是什么啊。我下周也去看看」"
    },
    {
        "message": "一出教室就立刻聊起了搞笑话题，她兴高采烈地谈论着昨天综艺节目的内容。"
    },
    {
        "message": "虽然她兴高采烈地聊着，但我却有点心不在焉。"
    },
    {
        "name": "莲",
        "message": "「汐崎同学，能稍等我一下吗？」"
    },
    {
        "name": "雪",
        "message": "「诶，怎么了？」"
    },
    {
        "name": "莲",
        "message": "「我去体育馆看一眼就回来，你在这等我一下！」"
    },
    {
        "name": "雪",
        "message": "「嗯、嗯……知道了」"
    },
    {
        "name": "莲",
        "message": "「抱歉！」"
    },
    {
        "message": "我沿着走廊朝体育馆走去。"
    },
    {
        "message": "漆黑一片的体育馆里只回荡着我的脚步声。"
    },
    {
        "name": "莲",
        "message": "「果然已经回去了啊」"
    },
    {
        "name": "莲",
        "message": "「唉，做了件挺过意不去的事啊……」"
    },
    {
        "name": "莲",
        "message": "「明天道个歉吧」"
    },
    {
        "message": "说完，我离开了体育馆。"
    },
    {
        "message": "回到校门口时，不知何时雨已经停了。看来只是场阵雨。"
    },
    {
        "name": "莲",
        "message": "「让你久等了！」"
    },
    {
        "name": "雪",
        "message": "「清露呢？」"
    },
    {
        "name": "莲",
        "message": "「嗯，我刚才有点事……」"
    },
    {
        "name": "雪",
        "message": "「看你这表情，应该是没见到人吧」"
    },
    {
        "name": "莲",
        "message": "「嗯……」"
    },
    {
        "name": "雪",
        "message": "「……」"
    },
    {
        "name": "雪",
        "message": "「嗯，一定要看哦！」"
    },
    {
        "name": "莲",
        "message": "「我会看的……好像今天也有什么有趣的节目在播呢」"
    },
    {
        "message": "离开玄关后，我们又重新开始了关于搞笑节目的话题。"
    },
    {
        "name": "雪",
        "message": "「是亨利亨利那个吧？有小豆糕出场的那个」"
    },
    {
        "name": "莲",
        "message": "「可能是吧。我平时不怎么看电视……」"
    },
    {
        "message": "汐崎不断地提到各种名词，但其中很多都是我不认识的搞笑艺人的名字。"
    },
    {
        "message": "下次我得好好查查看。"
    },
    {
        "name": "雪",
        "message": "「那个也很有趣，你看看就知道了！」"
    },
    {
        "name": "莲",
        "message": "「嗯，我会的！」"
    },
    {
        "name": "莲",
        "message": "「不过，那个时间段如果爱嘉在看连续剧的话，可能会变成争夺战……虽然肯定是我输」"
    },
    {
        "name": "雪",
        "message": "「啊哈哈，有兄弟姐妹真是不容易啊……」"
    },
    {
        "name": "莲",
        "message": "「就是啊……说不定我不看电视也是因为这个原因」"
    },
    {
        "name": "雪",
        "message": "「那么，下次得教教爱嘉酱搞笑节目有多有趣才行！」"
    },
    {
        "name": "莲",
        "message": "「拜托你了」"
    },
    {
        "message": "于是，我们相视而笑，就这样愉快地聊着天走在回家的路上。"
    },
    {
        "name": "清露",
        "message": "「真是的……太晚了我要回去了……明明等了你这么久」"
    },
    {
        "name": "清露",
        "message": "「刚下完雨又停了……搞不懂」"
    },
    {
        "message": "在体育馆工作时，我们会做好回家的准备，这样就可以直接从体育馆回家了"
    },
    {
        "message": "体育馆的工作结束后，我在屋檐下等雨停了才动身回家。"
    },
    {
        "name": "清露",
        "message": "「到底有多沉迷那把椅子啊」"
    },
    {
        "name": "清露",
        "message": "「不过，这倒是很像那家伙的作风……」"
    },
    {
        "message": "我在想什么啊！"
    },
    {
        "message": "那家伙唯一的优点就是善良而已。"
    },
    {
        "message": "我的恋爱生涯在初恋就结束了……与其再经历那样痛苦的感觉，还不如干脆不去喜欢谁……"
    },
    {
        "message": "唉……"
    },
    {
        "message": "不由自主地叹了口气。"
    },
    {
        "name": "清露",
        "message": "「算了，明天再让他看吧……明天我绝对不会让他爽约的」"
    },
    {
        "message": "当我走近校门时，看到一对情侣正要从校门出去。"
    },
    {
        "name": "清露",
        "message": "「这么晚了还腻腻歪歪的……」"
    },
    {
        "name": "清露",
        "message": "「咦，那不是……」"
    },
    {
        "message": "那是一个熟悉的双马尾女生和一个熟悉的男生的背影。"
    },
    {
        "name": "清露",
        "message": "「诶……」"
    },
    {
        "name": "莲",
        "message": "「我回来啦——」"
    },
    {
        "name": "爱嘉",
        "message": "「哥哥，欢迎回来！」"
    },
    {
        "message": "回到家换上便服去客厅，爱嘉像往常一样在等着吃晚饭。"
    },
    {
        "name": "爱嘉",
        "message": "「呐，我听千惠酱说了哦！」"
    },
    {
        "name": "莲",
        "message": "「听、听说什么了？」"
    },
    {
        "name": "爱嘉",
        "message": "「你在做一把超豪华的椅子对吧！」"
    },
    {
        "name": "莲",
        "message": "「啊，对对」"
    },
    {
        "message": "怎么今天所有人都在跟我说这事……"
    },
    {
        "name": "爱嘉",
        "message": "「好像是千惠酱从清露学姐那里听说的」"
    },
    {
        "message": "果然是夕凪啊……"
    },
    {
        "name": "爱嘉",
        "message": "「哥哥在学校做东西，是不是从小学之后就没有过了？」"
    },
    {
        "name": "莲",
        "message": "「啊，说起来可能是这样」"
    },
    {
        "name": "爱嘉",
        "message": "「好期待啊♪」"
    },
    {
        "name": "莲",
        "message": "「是吗……感觉更有动力去努力了」"
    },
    {
        "name": "爱嘉",
        "message": "「呵呵，加油哦，哥哥」"
    }
]