[
    {
        "message": "文化祭结束后，经过短暂的休息，学校又恢复了往常的样子。"
    },
    {
        "message": "教室角落里杂乱地堆放着文化祭用过的物品，放学后必须要收拾这些东西。"
    },
    {
        "name": "莲",
        "message": "「早上好」"
    },
    {
        "message": "我一边坐到座位上，一边向前排的夕凪打招呼。"
    },
    {
        "name": "清露",
        "message": "「早上好……阿嚏」"
    },
    {
        "name": "莲",
        "message": "「感冒了？昨天确实挺冷的」"
    },
    {
        "name": "清露",
        "message": "「嗯，可能是感冒了……」"
    },
    {
        "name": "清露",
        "message": "「话说回来，为什么要在这种不合季节的时候放烟花啊」"
    },
    {
        "name": "莲",
        "message": "「别这样嘛，不是挺开心的吗？」"
    },
    {
        "name": "清露",
        "message": "「嗯，嗯……好吧，有那么一点」"
    },
    {
        "message": "她带着些许羞涩回答道。"
    },
    {
        "name": "莲",
        "message": "「升空的烟花也特别漂亮」"
    },
    {
        "name": "清露",
        "message": "「是挺漂亮的……阿嚏」"
    },
    {
        "name": "莲",
        "message": "「没事吧？」"
    },
    {
        "name": "清露",
        "message": "「嗯……好像没什么发烧」"
    },
    {
        "name": "莲",
        "message": "「这样啊……保重身体」"
    },
    {
        "name": "清露",
        "message": "「啊，谢谢你……」"
    },
    {
        "name": "莲",
        "message": "「如果觉得勉强的话，今天的收拾工作可以不用参加哦」"
    },
    {
        "name": "清露",
        "message": "「这、这种程度我还行啦」"
    },
    {
        "name": "莲",
        "message": "「如果没问题就好……别太勉强自己啊」"
    },
    {
        "name": "清露",
        "message": "「……！」"
    },
    {
        "name": "清露",
        "message": "「我、我才没有……勉强自己呢……」"
    },
    {
        "name": "莲",
        "message": "「通常就是这样轻视的人反而会越来越发烧的」"
    },
    {
        "name": "清露",
        "message": "「喂，你这是在小看我吗？」"
    },
    {
        "message": "夕凪猛地凑近脸生气地说道，女孩子的香味轻轻飘来。"
    },
    {
        "name": "清露",
        "message": "「唔唔」"
    },
    {
        "name": "莲",
        "message": "「哦哦！」"
    },
    {
        "name": "清露",
        "message": "「啊，那个……等下……！」"
    },
    {
        "message": "夕凪似乎觉得自己靠得比想象中还要近，稍微瞪了我一眼就立刻离开了。"
    },
    {
        "name": "清露",
        "message": "「喂……都怪你又说些多余的话」"
    },
    {
        "name": "莲",
        "message": "「嘛，不过……这样也挺好的」"
    },
    {
        "name": "清露",
        "message": "「哪里好了，完全搞不懂你！」"
    },
    {
        "message": "就在我们这样你来我往的时候，熟悉的预备铃声又在学园内响起了。"
    },
    {
        "message": "然后，放学后……"
    },
    {
        "message": "作为实行委员会企划活动组的我们四个人正和初中部一起在体育馆收拾东西。"
    },
    {
        "name": "莲",
        "message": "「啊，那个给我！我去扔」"
    },
    {
        "message": "我朝正抱着叠好的纸箱的夕凪喊道。"
    },
    {
        "name": "清露",
        "message": "「啊，嗯。知道了」"
    },
    {
        "message": "我自己两边胳膊下也夹着好几个纸箱……"
    },
    {
        "name": "莲",
        "message": "「呼，这些要搬到垃圾场去吗……？」"
    },
    {
        "name": "清露",
        "message": "「真没用啊，要我帮你拿吗？」"
    },
    {
        "message": "夕凪这么说着，从我左边胳膊下夹着的纸箱中接过了一个大的。"
    },
    {
        "name": "莲",
        "message": "「哦，谢谢」"
    },
    {
        "name": "清露",
        "message": "「不用谢」"
    },
    {
        "message": "太好了，负重轻了一些。"
    },
    {
        "message": "垃圾场位于校舍后面，操场的一角。"
    },
    {
        "name": "莲",
        "message": "「呼，这样就搞定了」"
    },
    {
        "message": "我把纸箱扔进垃圾场的可回收区域，然后拍了拍手。"
    },
    {
        "name": "莲",
        "message": "「话说回来，这么多纸箱……感觉有点浪费啊」"
    },
    {
        "name": "莲",
        "message": "「要不我自己做个纸箱机器人吧」"
    },
    {
        "name": "清露",
        "message": "「随你便咯？」"
    },
    {
        "name": "莲",
        "message": "「诶，好冷淡啊。跟秋夜的凉风一样冷，你刚才那话」"
    },
    {
        "name": "清露",
        "message": "「你这比喻一点都不高明」"
    },
    {
        "name": "清露",
        "message": "「不过，给你加油打气我还是可以的」"
    },
    {
        "name": "莲",
        "message": "「就只是加油打气吗……」"
    },
    {
        "name": "清露",
        "message": "「还有，搬纸箱的话我也能帮忙……体育馆里应该还剩下一些吧」"
    },
    {
        "name": "莲",
        "message": "「那不就是单纯的收拾嘛」"
    },
    {
        "name": "清露",
        "message": "「不快点收拾的话天就要黑了」"
    },
    {
        "name": "莲",
        "message": "「嗯，话是这么说……」"
    },
    {
        "message": "然后，一小时后……"
    },
    {
        "message": "结果，因为搭建了一个大型舞台，我和夕凪不得不留到最后收拾。"
    },
    {
        "name": "清露",
        "message": "「早知道就不该弄那么大场面的舞台啊」"
    },
    {
        "name": "莲",
        "message": "「哎，别这么说嘛。不管怎样还是挺开心的吧？」"
    },
    {
        "name": "清露",
        "message": "「嗯，是这样没错……」"
    },
    {
        "message": "正当我们准备回家时，猫城前辈来了。"
    },
    {
        "name": "艾莉卡",
        "message": "「啊，九条君和清露酱辛苦啦♪」"
    },
    {
        "name": "莲",
        "message": "「哪里哪里。话说，您有什么事吗？」"
    },
    {
        "name": "艾莉卡",
        "message": "「看到体育馆还亮着灯，就想看看是谁在这儿」"
    },
    {
        "name": "清露",
        "message": "「哦，原来如此」"
    },
    {
        "message": "说着，猫城前辈东张西望地环视体育馆。"
    },
    {
        "name": "艾莉卡",
        "message": "「咦，就你们两个人吗？」"
    },
    {
        "name": "莲",
        "message": "「是啊，就我们俩最后留下来。不过马上就要回去了」"
    },
    {
        "name": "艾莉卡",
        "message": "「嗯嗯嗯，清露酱真狡猾呢」"
    },
    {
        "name": "清露",
        "message": "「你你你在说什么啊，艾莉卡酱！」"
    },
    {
        "name": "艾莉卡",
        "message": "「咦，为什么这么慌张呢？」"
    },
    {
        "name": "莲",
        "message": "「您在说什么啊，猫城前辈！」"
    },
    {
        "message": "确实，意识到只有两个人的状况时，不知为何脸上就变得热乎乎的。"
    },
    {
        "name": "艾莉卡",
        "message": "「总是清露清露的……哼！」"
    },
    {
        "message": "猫城前辈撇过脸去。"
    },
    {
        "name": "莲",
        "message": "「您为什么这么生气啊」"
    },
    {
        "name": "艾莉卡",
        "message": "「这个你自己想去吧！」"
    },
    {
        "name": "莲",
        "message": "「诶诶」"
    },
    {
        "name": "艾莉卡",
        "message": "「因为，我也想和九条君在一起啊！」"
    },
    {
        "name": "莲",
        "message": "「前辈，您这说法……」"
    },
    {
        "message": "被这么直白地说出来，我也不禁感到有些害羞了……"
    },
    {
        "name": "清露",
        "message": "「喂，艾莉卡！」"
    },
    {
        "name": "艾莉卡",
        "message": "「咦，你怎么那么激动啊？」"
    },
    {
        "name": "清露",
        "message": "「啊……！？没、没什么」"
    },
    {
        "name": "艾莉卡",
        "message": "「哼嗯……」"
    },
    {
        "message": "前辈露出了狡黠的笑容。"
    },
    {
        "name": "莲",
        "message": "「前辈，别开人家玩笑啊……」"
    },
    {
        "name": "莲",
        "message": "「这可不像猫城前辈啊……」"
    },
    {
        "name": "艾莉卡",
        "message": "「是、是这样吗？」"
    },
    {
        "message": "她被我这么一说，露出了恍然大悟的表情。"
    },
    {
        "name": "莲",
        "message": "「是啊，总觉得不太'像'您呢」"
    },
    {
        "name": "艾莉卡",
        "message": "「唔唔——居然被九条君这么说了……」"
    },
    {
        "name": "艾莉卡",
        "message": "「不过，能看到清露酱慌张可爱的样子，就算是值得了吧」"
    },
    {
        "name": "清露",
        "message": "「你、你来干什么啊！」"
    },
    {
        "name": "艾莉卡",
        "message": "「呵呵，那么，再见啦」"
    },
    {
        "message": "她到底是来干什么的……是来巡视的还是来捉弄人的……"
    },
    {
        "name": "清露",
        "message": "「啧，真是的，从小到大都没变过那副德行……」"
    },
    {
        "message": "关掉体育馆的灯后，一边听着猫城前辈讲述往事，一边回到教室准备回家。"
    },
    {
        "name": "莲",
        "message": "「啊哈哈……你们从小就认识啊」"
    },
    {
        "name": "清露",
        "message": "「嗯」"
    },
    {
        "name": "莲",
        "message": "「原来从以前就是那种感觉啊」"
    },
    {
        "name": "清露",
        "message": "「她一点都没变」"
    },
    {
        "name": "莲",
        "message": "「哈哈哈，我记得你和汐崎还有千惠从小就是好朋友吧」"
    },
    {
        "name": "清露",
        "message": "「嗯，是啊。我们父母也都认识」"
    },
    {
        "name": "莲",
        "message": "「原来如此，难怪你们关系这么好」"
    },
    {
        "message": "从小就认识的话，她们关系那么好也就说得通了。"
    },
    {
        "name": "清露",
        "message": "「是啊。以前我们经常在神社下面的公园玩」"
    },
    {
        "name": "莲",
        "message": "「嗯……」"
    },
    {
        "name": "清露",
        "message": "「什么啊，'嗯'是什么意思」"
    },
    {
        "name": "莲",
        "message": "「啊，没什么，我只是在想说不定我也和你们一起玩过呢」"
    },
    {
        "name": "清露",
        "message": "「诶，真的吗？」"
    },
    {
        "name": "清露",
        "message": "「不过，我倒是听说过你在这个城市的事」"
    },
    {
        "name": "莲",
        "message": "「啊，我也经常在那个公园玩」"
    },
    {
        "name": "清露",
        "message": "「哦～意外……不过，大家确实都在那里聚集玩耍」"
    },
    {
        "name": "清露",
        "message": "「谁是谁啊……」"
    },
    {
        "name": "莲",
        "message": "「嗯，也是。我对小时候的记忆也几乎不记得了」"
    },
    {
        "name": "莲",
        "message": "「不过，我对这个城市还有一件事记得很清楚……」"
    },
    {
        "name": "清露",
        "message": "「哦～是什么呀？」"
    },
    {
        "name": "莲",
        "message": "「唔……没什么」"
    },
    {
        "message": "本想说说初恋的事，但太害羞了说不出口……"
    },
    {
        "name": "清露",
        "message": "「诶～都说到这份上了就说出来嘛。这不是让人很在意嘛」"
    },
    {
        "name": "莲",
        "message": "「不不不，没什么大不了的事」"
    },
    {
        "name": "清露",
        "message": "「既然没什么大不了那说出来也无所谓吧」"
    },
    {
        "name": "莲",
        "message": "「唔……」"
    },
    {
        "message": "我那种初恋故事，算了吧……"
    },
    {
        "name": "清露",
        "message": "「如果那么难以启齿的话就算了……」"
    },
    {
        "message": "夕凪有点不高兴地拿起了书包。"
    },
    {
        "message": "吊到这个份上反而更难说出口了，还好。"
    },
    {
        "name": "清露",
        "message": "「啊，说起来……」"
    },
    {
        "message": "她看了看黑板，似乎想起了什么，脸色稍微有些发白。"
    },
    {
        "name": "莲",
        "message": "「啊？」"
    },
    {
        "name": "清露",
        "message": "「明天有数学小测验……」"
    },
    {
        "name": "莲",
        "message": "「啊，是啊」"
    },
    {
        "name": "清露",
        "message": "「文化祭刚结束就马上来小测验，什么鬼啊？是为了发泄压力吗？」"
    },
    {
        "name": "莲",
        "message": "「哈哈哈」"
    },
    {
        "message": "要是有自掏腰包放烟花的传统就好了……"
    },
    {
        "name": "清露",
        "message": "「微分什么的完全不懂啊……」"
    },
    {
        "name": "莲",
        "message": "「嗯，确实可能有点难懂」"
    },
    {
        "name": "清露",
        "message": "「什么极限啊、德尔塔啊，还有一堆符号……能不能弄得更容易理解点啊」"
    },
    {
        "name": "莲",
        "message": "「但是，极大值和微分系数这些不都是中文吗」"
    },
    {
        "name": "清露",
        "message": "「啊～啊～听不见～」"
    },
    {
        "name": "莲",
        "message": "「你之前的数学都是怎么过来的啊」"
    },
    {
        "name": "清露",
        "message": "「嗯……勉强过关吧……」"
    },
    {
        "message": "勉强过关……肯定一直都不怎么样吧。"
    },
    {
        "name": "清露",
        "message": "「喂，说起来你自己又怎么样啊」"
    },
    {
        "name": "莲",
        "message": "「我数学可是很擅长的」"
    },
    {
        "name": "清露",
        "message": "「不愧是模型狂」"
    },
    {
        "name": "莲",
        "message": "「模型狂和数学有什么关系啊」"
    },
    {
        "name": "清露",
        "message": "「感觉挺相近的不是吗？」"
    },
    {
        "name": "莲",
        "message": "「哪里相近了……」"
    },
    {
        "name": "清露",
        "message": "「谁知道呢？」"
    },
    {
        "name": "莲",
        "message": "「喂，什么叫谁知道呢！」"
    },
    {
        "name": "清露",
        "message": "「说起来，你就没有不擅长的科目吗？」"
    },
    {
        "name": "莲",
        "message": "「嗯，这样啊。可能英语不太行」"
    },
    {
        "name": "清露",
        "message": "「啊，确实，你说英语的时候我完全听不懂你在说什么」"
    },
    {
        "name": "莲",
        "message": "「呃……」"
    },
    {
        "name": "清露",
        "message": "「嘻嘻」"
    },
    {
        "name": "清露",
        "message": "「不过，真的得好好学习了……最近数学完全跟不上了……」"
    },
    {
        "name": "莲",
        "message": "「我也得好好学英语啊……」"
    },
    {
        "name": "清露",
        "message": "「英语不就是掌握了句型之后，剩下的就是记单词吗」"
    },
    {
        "name": "莲",
        "message": "「这就是难点啊……」"
    },
    {
        "name": "清露",
        "message": "「是这样吗……？」"
    },
    {
        "name": "清露",
        "message": "「嗯……」"
    },
    {
        "name": "莲",
        "message": "「嗯？」"
    },
    {
        "name": "清露",
        "message": "「啊，你能不能教我数学啊？」"
    },
    {
        "name": "莲",
        "message": "「诶？」"
    },
    {
        "message": "果然来这一套啊。"
    },
    {
        "name": "清露",
        "message": "「你看，期中考试也快到了吧？」"
    },
    {
        "name": "清露",
        "message": "「我教你英语作为交换」"
    },
    {
        "name": "莲",
        "message": "「嗯，那倒是挺感谢的」"
    },
    {
        "name": "清露",
        "message": "「找艾莉卡教也行啦……但总觉得跟她聊着聊着就跑题了，学不进去。本来她就不爱学习」"
    },
    {
        "name": "清露",
        "message": "「她自己说是利用零碎时间学习的」"
    },
    {
        "name": "莲",
        "message": "「啊，不愧是学生会长……」"
    },
    {
        "name": "清露",
        "message": "「那就这么定了哦」"
    },
    {
        "name": "莲",
        "message": "「什么时候定下来的啊……不过，确实帮大忙了」"
    },
    {
        "name": "清露",
        "message": "「对吧？」"
    },
    {
        "name": "清露",
        "message": "「那么，明天放学后在城里的图书馆见！」"
    },
    {
        "name": "莲",
        "message": "「在教室不就行了吗，再说学校不是也有很好的图书馆吗」"
    },
    {
