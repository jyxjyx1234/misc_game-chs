[
    {
        "name": "清露",
        "message": "「虽然赶在明天的最后期限……」"
    },
    {
        "name": "雪",
        "message": "「锵锵！！」"
    },
    {
        "message": "清露和雪合作为猫神cosplay制作的服装，现在正向葵炫耀展示。"
    },
    {
        "message": "我虽然没做什么特别的事，但还是跟在后面。"
    },
    {
        "name": "莲",
        "message": "「清露，没想到你手这么巧啊……」"
    },
    {
        "name": "清露",
        "message": "「哼！莲！」"
    },
    {
        "name": "莲",
        "message": "「抱歉抱歉。不过话说回来，这衣服做得真漂亮啊」"
    },
    {
        "name": "雪",
        "message": "「哇，被有造型美感的九条君夸奖真高兴呢！」"
    },
    {
        "name": "清露",
        "message": "「呵呵呵……果然，这个主意真不错呢」"
    },
    {
        "name": "清露",
        "message": "「穿上这个外表就完美了。旅行券到手啦！」"
    },
    {
        "name": "雪",
        "message": "「啊哈哈，我和清露不太适合这种打扮呢」"
    },
    {
        "name": "清露",
        "message": "「是啊……我们在文化祭上穿的cosplay就够了」"
    },
    {
        "name": "清露",
        "message": "「来，葵，最后试穿一次吧」"
    },
    {
        "message": "清露把猫神的白色服装递给了今天看起来有些不同的美丘。"
    },
    {
        "message": "但是……。"
    },
    {
        "name": "葵",
        "message": "「那个，大家！」"
    },
    {
        "name": "清露",
        "message": "「怎么了？」"
    },
    {
        "name": "葵",
        "message": "「大家，对不起。我……决定明天不参加了……」"
    },
    {
        "name": "雪",
        "message": "「诶？」"
    },
    {
        "name": "莲",
        "message": "「不参加？」"
    },
    {
        "name": "清露",
        "message": "「你在说什么啊。都到这个地步了。明年还要忙着准备升学考试……」"
    },
    {
        "name": "清露",
        "message": "「不是葵你自己说现在是唯一能尽情享受的时候吗」"
    },
    {
        "name": "葵",
        "message": "「但是，对不起……」"
    },
    {
        "message": "就在美丘从座位上站起来的瞬间，她的手正好碰到了站在她身后的我的手。"
    },
    {
        "name": "莲",
        "message": "「！？」"
    },
    {
        "name": "葵",
        "message": "「抱歉……」"
    },
    {
        "message": "美丘说完这句话就离开了教室。"
    },
    {
        "name": "清露",
        "message": "「葵！」"
    },
    {
        "name": "莲",
        "message": "「美丘同学，突然怎么了」"
    },
    {
        "name": "清露",
        "message": "「葵那么善变，昨天是不是发生什么不愉快的事了？」"
    },
    {
        "message": "我和清露与汐崎分开后，坐在外面的长椅上一起度过了二人时光。"
    },
    {
        "name": "清露",
        "message": "「有时真搞不懂她在想什么呢～」"
    },
    {
        "message": "确实，她散发着一种神秘的气场，总是让人猜不透她在想什么。"
    },
    {
        "name": "清露",
        "message": "「但是，很奇怪呢」"
    },
    {
        "name": "莲",
        "message": "「嗯，感觉和平常消沉的样子不太一样」"
    },
    {
        "name": "清露",
        "message": "「嗯……」"
    },
    {
        "name": "莲",
        "message": "「嗯……」"
    },
    {
        "name": "清露",
        "message": "「你真的在认真思考吗？」"
    },
    {
        "name": "莲",
        "message": "「我当然在思考啊！」"
    },
    {
        "name": "清露",
        "message": "「啊，这样啊。那就好」"
    },
    {
        "name": "莲",
        "message": "「这不是理所当然的吗！」"
    },
    {
        "name": "清露",
        "message": "「嗯……」"
    },
    {
        "message": "之后，我们两个人一边发出嗯的声音一边思考了大约10分钟，但什么也没想出来。"
    },
    {
        "name": "莲",
        "message": "「嗯……」"
    },
    {
        "name": "？？？",
        "message": "「呀」"
    },
    {
        "name": "莲",
        "message": "「嗯？」"
    },
    {
        "name": "清露",
        "message": "「啊」"
    },
    {
        "message": "突然出现了一位访客。救世主登场了。"
    },
    {
        "name": "艾莉卡",
        "message": "「九条君，在这里上厕所可不好哦」"
    },
    {
        "name": "莲",
        "message": "「我才没在憋尿呢！」"
    },
    {
        "message": "放学回家的猫城学姐看到我们在烦恼，便主动过来搭话。"
    },
    {
        "name": "清露",
        "message": "「艾莉卡酱……」"
    },
    {
        "name": "艾莉卡",
        "message": "「所以，你们在烦恼什么呢？」"
    },
    {
        "name": "清露",
        "message": "「是啊，我们在为葵的事情烦恼」"
    },
    {
        "name": "艾莉卡",
        "message": "「葵酱？」"
    },
    {
        "name": "清露",
        "message": "「今天，她突然说不参加猫娘大赛了……」"
    },
    {
        "name": "艾莉卡",
        "message": "「诶！我还期待着她的猫神cosplay呢」"
    },
    {
        "name": "艾莉卡",
        "message": "「而且，葵酱不是最期待这个吗」"
    },
    {
        "name": "莲",
        "message": "「就是啊。更麻烦的是我们不知道原因，所以很担心」"
    },
    {
        "name": "艾莉卡",
        "message": "「所以你们两个人在这里烦恼啊」"
    },
    {
        "name": "莲",
        "message": "「是啊」"
    },
    {
        "name": "清露",
        "message": "「艾莉卡有什么想法吗？」"
    },
    {
        "name": "艾莉卡",
        "message": "「嗯，让我想想」"
    },
    {
        "message": "然后，短暂的沉默后。"
    },
    {
        "name": "艾莉卡",
        "message": "「啊，对了！」"
    },
    {
        "name": "艾莉卡",
        "message": "「不过，这个和葵退出比赛的原因有没有关系就不知道了……」"
    },
    {
        "name": "清露",
        "message": "「什么都行！」"
    },
    {
        "name": "莲",
        "message": "「是什么啊！？」"
    },
    {
        "name": "艾莉卡",
        "message": "「前几天她来神社的时候，我看她从境内穿过去进了森林」"
    },
    {
        "name": "莲",
        "message": "「森林？」"
    },
    {
        "name": "艾莉卡",
        "message": "「对了，九条君你们前几天不是也两个人一起进去了吗？」"
    },
    {
        "name": "莲",
        "message": "「前辈，你看到了？」"
    },
    {
        "name": "艾莉卡",
        "message": "「呵呵，那就不知道啦？不过，我可没看到你们之后怎么样了哦」"
    },
    {
        "name": "清露",
        "message": "「唔！」"
    },
    {
        "message": "清露脸红了。"
    },
    {
        "name": "莲",
        "message": "「啊，那么，她进入那片森林后做了什么呢？」"
    },
    {
        "message": "差点就跑题了，和猫城前辈聊天总是容易跑偏。"
    },
    {
        "name": "艾莉卡",
        "message": "「之后的事我就不清楚了，不过很奇怪呢。一个人进入森林什么的」"
    },
    {
        "name": "莲",
        "message": "「为什么呢……」"
    },
    {
        "name": "艾莉卡",
        "message": "「应该不会像九条君你们那样去看星星吧」"
    },
    {
        "name": "清露",
        "message": "「唔！艾莉卡！」"
    },
    {
        "name": "莲",
        "message": "「猫城前辈！」"
    },
    {
        "name": "莲",
        "message": "「……就是这么回事」"
    },
    {
        "name": "爱嘉",
        "message": "「原来如此，确实不太清楚呢」"
    },
    {
        "name": "莲",
        "message": "「对吧？」"
    },
    {
        "message": "我回家后，一边吃着晚饭一边和爱嘉商量着美丘的事。"
    },
    {
        "name": "爱嘉",
        "message": "「那个葵前辈竟然会突然露出那么阴郁的表情……」"
    },
    {
        "name": "爱嘉",
        "message": "难道是要从这个镇上搬走了，或者变成不能吃鱼的体质了？"
    },
    {
        "name": "莲",
        "message": "「原来如此啊」"
    },
    {
        "name": "爱嘉",
        "message": "「如果不是那种程度的悲伤事，我实在无法想象那么开朗的葵前辈会变得阴郁呢」"
    },
    {
        "name": "莲",
        "message": "「嗯……等等」"
    },
    {
        "name": "莲",
        "message": "「爱嘉，你刚才说什么？」"
    },
    {
        "name": "爱嘉",
        "message": "「变成不能吃鱼的体质什么的」"
    },
    {
        "name": "莲",
        "message": "「不是，再前面一点」"
    },
    {
        "name": "爱嘉",
        "message": "「要从这个镇上搬走什么的」"
    },
    {
        "name": "莲",
        "message": "「难道说……」"
    },
    {
        "name": "爱嘉",
        "message": "「诶，葵前辈要搬走了吗？」"
    },
    {
        "name": "莲",
        "message": "「不是……」"
    },
    {
        "message": "今天撞见她的时候……那个是……"
    },
    {
        "message": "今天是美丘镇的秋季祭典，也就是『猫娘大赛』的举办日。"
    },
    {
        "message": "比赛是在午后开始，所以我和清露决定先两个人逛逛祭典，然后再和汐崎和美丘会合。"
    },
    {
        "name": "莲",
        "message": "「美丘真的不打算来吗……」"
    },
    {
        "message": "因为是祭典，所以来来往往的人很多。"
    },
    {
        "name": "清露",
        "message": "「啊，莲！早上好」"
    },
    {
        "name": "莲",
        "message": "「早上好！」"
    },
    {
        "name": "莲",
        "message": "「第一次来这个祭典，人真是多啊……」"
    },
    {
        "name": "清露",
        "message": "「嘛，毕竟是有传统的祭典嘛。今天艾莉卡肯定忙得不可开交」"
    },
    {
        "name": "莲",
        "message": "「确实……神社的女儿也挺辛苦的」"
    },
    {
        "name": "清露",
        "message": "「那么，我们走吧♪」"
    },
    {
        "name": "莲",
        "message": "「嗯」"
    },
    {
        "message": "随着人流，我们来到了作为祭典会场的公园。"
    },
    {
        "message": "公园前面变成了步行街，神社的停车场也开放了，那里搭建了舞台。"
    },
    {
        "message": "摊位也摆了很多，人群相当拥挤。"
    },
    {
        "name": "清露",
        "message": "「棉花糖好好吃～」"
    },
    {
        "message": "清露一边塞着刚才在路上摊位买的棉花糖，一边说道。"
    },
    {
        "name": "莲",
        "message": "「棉花糖啊，要不是这种场合还真不会吃呢」"
    },
    {
        "name": "莲",
        "message": "「给我也尝一口呗」"
    },
    {
        "name": "清露",
        "message": "「诶～不要」"
    },
    {
        "name": "莲",
        "message": "「真小气」"
    },
    {
        "name": "清露",
        "message": "「骗你的啦！来……啊～」"
    },
    {
        "message": "清露有点害羞地撕下一小块棉花糖，送进了我的嘴里。"
    },
    {
        "name": "莲",
        "message": "「嗯…………好甜」"
    },
    {
        "name": "清露",
        "message": "「噗……什么啊，这种感想」"
    },
    {
        "name": "莲",
        "message": "「骗你的啦，很好吃哦」"
    },
    {
        "name": "清露",
        "message": "「嘿嘿，对吧！」"
    },
    {
        "message": "就这样在人群中卿卿我我地走着，不知不觉来到了舞台附近。"
    },
    {
        "message": "突然看到舞台，我想起了美丘。"
    },
    {
        "name": "莲",
        "message": "「说起来，美丘真的不来吗？」"
    },
    {
        "name": "清露",
        "message": "「她肯定会改变主意来的啦」"
    },
    {
        "name": "清露",
        "message": "「我相信葵，会一直等她的。毕竟我们约好了要一起拿冠军的」"
    },
    {
        "name": "莲",
        "message": "「是、是啊……」"
    },
    {
        "name": "清露",
        "message": "「嗯，嚼嚼……」"
    },
    {
        "message": "清露一边吃着棉花糖一边说道。"
    },
    {
        "message": "就在这时，人群中有人轻轻撞了下我的肩膀，在我耳边低语。"
    },
    {
        "name": "？？？",
        "message": "「再见……」"
    },
    {
        "name": "莲",
        "message": "「！？」"
    },
    {
        "message": "美丘？"
    },
    {
        "message": "我这么想着回头看去，却没有看到任何人。是我的错觉吗……"
    },
    {
        "name": "清露",
        "message": "「哇，果然神社里也挤满了人呢」"
    },
    {
        "name": "莲",
        "message": "「嘛，毕竟是祭典嘛，没办法」"
    },
    {
        "name": "清露",
        "message": "「现在神轿在哪里呢」"
    },
    {
        "name": "莲",
        "message": "「在哪呢。学校附近？」"
    },
    {
        "name": "清露",
        "message": "「听起来很有可能呢」"
    },
    {
        "name": "清露",
        "message": "「好像等我们的比赛结束时神轿就会回来，所以现在应该刚刚过了折返点吧」"
    },
    {
        "name": "莲",
        "message": "「是啊」"
    },
    {
        "name": "清露",
        "message": "「神轿爬上这303级台阶的场面，真的超震撼的哦～」"
    },
    {
        "name": "莲",
        "message": "「确实啊～那个超级帅气的神轿……」"
    },
    {
        "name": "清露",
        "message": "「该不会你现在就因为神轿兴奋起来了吧？」"
    },
    {
        "name": "莲",
        "message": "「怎、怎么可能啊」"
    },
    {
        "name": "清露",
        "message": "「真的吗～……」"
    },
    {
        "name": "莲",
        "message": "「啊，说、说起来，猫城前辈在哪里呢～」"
    },
    {
        "message": "为了掩饰自己兴奋的样子被发现后会很麻烦，我赶紧转移话题。"
    },
    {
        "name": "清露",
        "message": "「说起来，确实没看到她呢。护身符那边好像也不在，不知道去哪里了？」"
    },
    {
        "message": "正说着这些的时候……"
    },
    {
        "name": "艾莉卡的父亲",
        "message": "「哦，清露酱」"
    },
    {
        "name": "清露",
        "message": "「啊，叔叔」"
    },
    {
        "name": "艾莉卡的父亲",
        "message": "「哦，这是男朋友吗？」"
    },
    {
        "name": "清露",
        "message": "「啊，那个……嗯，算是男朋友吧……」"
    },
    {
        "name": "莲",
        "message": "「什么叫算是男朋友啊……」"
    },
    {
        "name": "莲",
        "message": "「我是九条莲。一直受到猫城前辈的照顾」"
    },
    {
        "name": "艾莉卡的父亲",
        "message": "「哦，你就是九条君啊。我听说过你，好像能看到色色的妄想是吧？」"
    },
    {
        "message": "然后，艾莉卡的父亲凑近我的脸，在我耳边低语。"
    },
    {
        "name": "艾莉卡的父亲",
        "message": "「记得要好好注意避孕啊」"
    },
    {
        "message": "我有点不明白他在说什么……"
    },
    {
        "name": "清露",
        "message": "「喂，你们在偷偷说什么呢」"
    },
    {
        "name": "艾莉卡的父亲",
        "message": "「哈哈哈，这是男人之间的话题」"
    },
    {
        "name": "清露",
        "message": "「肯定又在说些无聊的黄段子吧」"
    },
    {
        "name": "艾莉卡的父亲",
        "message": "「呃」"
    },
    {
        "message": "不愧是清露，真敏锐。话说回来，她对猫城前辈的父亲也是这种态度吗！"
    },
    {
        "name": "清露",
        "message": "「说起来，艾莉卡去哪儿了？」"
    },
    {
        "name": "艾莉卡的父亲",
        "message": "「啊，艾莉卡的话正跟着神轿转悠呢。今年氏子青年会好像有点人手不足」"
    },
    {
        "name": "清露",
        "message": "「原来如此……待会儿联系她一下吧」"
    },
    {
        "name": "莲",
        "message": "「看起来挺辛苦的呢」"
    },
    {
        "name": "艾莉卡的父亲",
        "message": "「艾莉卡真是帮了大忙了。嘛，你们两个好好享受祭典吧」"
    },
    {
        "name": "莲",
        "message": "「好的！」"
    },
    {
        "name": "清露",
        "message": "「再见啦，叔叔！」"
    },
    {
        "message": "然后，猫城前辈的父亲消失在人群中。"
    },
    {
        "name": "莲",
        "message": "「时间还早，再在下面逛逛吧」"
    },
    {
        "name": "清露",
        "message": "「嗯♪」"
    },
    {
        "name": "清露",
        "message": "「啊～累死了」"
    },
    {
        "name": "莲",
        "message": "「人真多啊……」"
    },
    {
        "message": "我们在舞台前设置的长椅上休息，一边观看着不太熟悉的搞笑艺人的舞台表演。"
    },
    {
        "message": "而且再过一会儿就到约定的时间了。"
    },
    {
        "name": "搞笑艺人A",
        "message": "「前几天我去理发店了」",
        "fenhang": 2
    },
    {
        "name": "搞笑艺人B",
        "message": "「诶，理发店……糟糕了！」",
        "fenhang": 2
    },
    {
        "name": "搞笑艺人A",
        "message": "「诶，怎么了！？」",
        "fenhang": 2
    },
    {
        "name": "？？？",
        "message": "「啊哈哈哈哈」"
    },
    {
        "message": "从某处传来了熟悉的笑声。"
    },
    {
        "name": "清露",
        "message": "「是不是从刚才开始就有人一直在对完全不好笑的段子爆笑啊？」"
    },
    {
        "name": "莲",
        "message": "「嗯，正如你所想的那样呢」"
    },
    {
        "name": "清露",
        "message": "「唉……这有什么好笑的啊……」"
    },
    {
        "name": "莲",
        "message": "「我倒是挺喜欢的」"
    },
    {
        "name": "清露",
        "message": "「你这是什么品味啊……」"
    },
    {
        "name": "雪",
        "message": "「诶——，刚才那段有那么不好吗？」"
    },
    {
        "name": "清露",
        "message": "「那种东西哪里好笑了」"
    },
    {
        "message": "到了约定的时间，我们还在讨论刚才那个搞笑艺人的事。"
    },
    {
        "name": "雪",
        "message": "「嗯嗯嗯——看来清露和我在搞笑方面的品味不太一致呢」"
    },
    {
        "name": "清露",
        "message": "「不过，好像和莲挺合得来的嘛」"
    },
    {
        "name": "雪",
        "message": "「是啊——没想到你们俩在搞笑艺人的品味上这么一致……」"
    },
    {
        "name": "清露",
        "message": "「搞笑艺人明明是我啊！」"
    },
    {
        "message": "话说回来，小时候一起去看搞笑艺人的也只有清露而已。"
    },
    {
        "name": "莲",
        "message": "「好了好了，那么……」"
    },
    {
        "name": "莲",
        "message": "「美丘还没来吗？」"
    },
    {
        "name": "清露",
        "message": "「是啊……该不会真的不来了吧？」"
    },
    {
        "name": "雪",
        "message": "「不过，毕竟是昨天的事，还是挺让人担心的呢」"
    },
    {
        "name": "清露",
        "message": "「就是啊……」"
    },
    {
        "name": "莲",
        "message": "「嗯……要不我们先去跟工作人员说一声？」"
    },
    {
        "name": "清露",
        "message": "「不，等等……我相信葵」"
    },
    {
        "name": "莲",
        "message": "「话是这么说……但是再过30分钟就要开始了啊」"
    },
    {
        "name": "雪",
        "message": "「嗯……还要换衣服准备什么的……」"
    },
    {
        "message": "……就在这时，清露的手机响起了来电铃声。"
    },
    {
        "name": "清露",
        "message": "「啊，是艾莉卡打来的」"
    },
    {
        "message": "看来是回复刚才发的邮件。"
    },
    {
        "name": "莲",
        "message": "「怎么了？」"
    },
    {
        "name": "雪",
        "message": "「艾莉卡前辈？她在做什么？」"
    },
    {
        "name": "莲",
        "message": "「好像是在陪着神轿呢」"
    },
    {
        "name": "雪",
        "message": "「诶！是这样啊……艾莉卡前辈也真辛苦。明明还要准备升学考试」"
    },
    {
        "name": "清露",
        "message": "「她说再过一个多小时就能到这边了。现在正在休息」"
    },
    {
        "name": "莲",
        "message": "「哦……」"
    },
    {
        "name": "清露",
        "message": "「啊，还有……诶诶！？」"
    },
    {
        "name": "雪",
        "message": "「你怎么这么吃惊？」"
    },
    {
        "name": "莲",
        "message": "「啊，怎么了？」"
    },
    {
        "name": "清露",
        "message": "「葵她……」"
    },
    {
        "name": "雪",
        "message": "「葵她……？」"
    },
    {
        "name": "莲",
        "message": "「美丘怎么了？」"
    },
    {
        "name": "莲",
        "message": "「哈……哈……」"
    },
    {
        "message": "早知道该每天来回爬303级台阶练练体力的。"
    },
    {
        "message": "宅男突然没热身就跑步，果然很吃力啊。"
    },
    {
        "name": "莲",
        "message": "「果然……美丘她……！！」"
    },
    {
        "message": "刚才发给清露的邮件里是这么写的。"
    },
    {
        "name": "艾莉卡",
        "message": "「对了，刚才看到葵穿着制服往学校去了。她不是应该去参加比赛吗？」"
    },
    {
        "message": "听到这个消息后，我坐立不安，把清露和雪都抛在脑后，立刻冲了出去。"
    },
    {
        "message": "美丘神社……猫神……妄想……还有，美丘。"
    },
    {
        "message": "就像脑海中散落的拼图碎片突然拼合在一起，我恍然大悟。"
    },
    {
        "name": "莲",
        "message": "「为什么啊……！！」"
    },
    {
        "message": "平常走的上学路今天感觉格外漫长。"
    },
    {
        "name": "莲",
        "message": "「哈……哈……」"
    },
    {
        "name": "葵",
        "message": "「九条同学……」"
    },
    {
        "message": "美丘穿着校服，沐浴在西斜的阳光中，坐在2年B班靠窗的座位上。"
    },
    {
        "message": "夕阳把美丘那美丽的金发照得更加耀眼。"
    },
    {
        "name": "莲",
        "message": "「呼……呼……」"
    },
    {
        "message": "我勉强调整着呼吸。"
    },
    {
        "name": "莲",
        "message": "「那个，美丘同学……」"
    },
    {
        "name": "葵",
        "message": "「九条同学，你已经察觉到了啊。不愧是九条同学……」"
    },
    {
        "message": "美丘同学似乎一直在等我开口，立刻就回应了我的话。"
    },
    {
        "name": "葵",
        "message": "「对不起……给你添麻烦了……」"
    },
    {
        "name": "莲",
        "message": "「美丘同学……」"
    },
    {
        "name": "葵",
        "message": "「没关系的，九条同学已经失去了看到妄想的能力……」"
    },
    {
        "name": "莲",
        "message": "「那种事无所谓啦！美丘同学，你不会从我们面前消失吧……？」"
    },
    {
        "name": "葵",
        "message": "「诶……！？」"
    },
    {
        "name": "莲",
        "message": "「虽然不知道为什么，但是前几天碰到美丘同学的时候，我看到了」"
    },
    {
        "name": "莲",
        "message": "「美丘同学在守护着我们的样子……」"
    },
    {
        "message": "对，那时看到的画面是美丘同学从天空中俯视着我们的景象。"
    },
    {
        "name": "葵",
        "message": "「为、为什么！？」"
    },
    {
        "name": "葵",
        "message": "「明明我的神通力已经消失了，而且九条同学的能力本来就只能看到色色的画面啊」"
    },
    {
        "name": "莲",
        "message": "「虽然不知道为什么……」"
    },
    {
        "name": "莲",
        "message": "「而且，最近美丘同学的状态也很奇怪……」"
    },
    {
        "name": "葵",
        "message": "「呜呜……」"
    },
    {
        "name": "莲",
        "message": "「果然……你要消失了吗？」"
    },
    {
        "name": "葵",
        "message": "「九条同学，我啊……」"
    },
    {
        "message": "美丘同学如实地讲述了一切。"
    },
    {
        "message": "她是美丘神社猫神的后裔，以及神明的规矩。"
    },
    {
        "message": "然后……"
    },
    {
        "name": "葵",
        "message": "「九条同学可能不记得了……但是，我曾经被九条同学救过一次……」"
    },
    {
        "name": "莲",
        "message": "「我救过美丘同学？」"
    },
    {
        "name": "葵",
        "message": "「嗯。九条同学小时候经常在那个公园玩，对吧？」"
    },
    {
        "name": "莲",
        "message": "「嗯，是这样。我就是在那里遇到清露的」"
    },
    {
        "name": "葵",
        "message": "「当我以猫的形态在镇上散步的时候……」"
    },
    {
        "name": "莲",
        "message": "「啊，我救的那只幼猫……」"
    },
    {
        "name": "葵",
        "message": "「诶？」"
    },
    {
        "name": "莲",
        "message": "「啊，原来那只幼猫就是美丘同学啊」"
    },
    {
        "name": "葵",
        "message": "「诶，不会吧……」"
    },
    {
        "message": "美丘同学露出惊讶的表情，因为自己本想说的话被说中了。"
    },
    {
        "message": "她看起来有点高兴，但同时也有点悲伤。"
    },
    {
        "name": "莲",
        "message": "「在学生食堂第一次见面的时候，我就觉得好像不是第一次见面」"
    },
    {
        "name": "莲",
        "message": "「原来……是这么回事啊……」"
    },
    {
        "name": "葵",
        "message": "「现在说这个虽然有点不好意思，但是呢……」"
    },
    {
        "name": "葵",
        "message": "「……」"
    },
    {
        "name": "葵",
        "message": "「我啊，从那次被救起之后，一直一直都喜欢着九条同学」"
    },
    {
        "name": "莲",
        "message": "「！！」"
    },
    {
        "message": "这是一个突如其来的告白。"
    },
    {
        "message": "面对这突如其来的事情，我的心脏砰砰直跳。跳得如此剧烈，我甚至担心美丘同学会听到。"
    },
    {
        "name": "葵",
        "message": "「然后呢，我预知到九条同学会来这个镇上，就高兴得不得了……」"
    },
    {
        "name": "葵",
        "message": "「因为太喜欢九条同学了……所以在一年级的时候以人类的样子进入了美丘学园」"
    },
    {
        "name": "莲",
        "message": "「嗯……」"
    },
    {
        "message": "我感到懊恼，因为无法说出任何回应的话。"
    },
    {
        "message": "尽管如此，美丘同学还是继续说道。"
    },
    {
        "name": "葵",
        "message": "「然后呢，九条同学转学过来的时候，我本该亲口告诉你的，但是……」"
    },
    {
        "name": "葵",
        "message": "「我是个软弱的孩子……呜呜……」"
    },
    {
        "message": "美丘同学眼中泛起了泪水。"
    },
    {
        "message": "即使美丘同学不说，我大致也能猜到是怎么回事。"
    },
    {
        "message": "大概是想要使用促成恋爱的神通力，但以美丘同学的性格，因为喜欢的心情而着急，结果发挥了她拿手的笨拙。"
    },
    {
        "message": "不知为何，我反而获得了能看到色情妄想的能力。"
    },
    {
        "name": "葵",
        "message": "「对不起，对不起……」"
    },
    {
        "name": "莲",
        "message": "「……」"
    },
    {
        "message": "美丘同学为了不让我看到她哭泣的样子，遮住了脸。"
    },
    {
        "message": "于是，我对美丘同学说了些拙劣的安慰话。"
    },
    {
        "name": "莲",
        "message": "「没关系的，美丘同学。不用道歉……」"
    },
    {
        "name": "莲",
        "message": "「美丘同学喜欢我的心意，我已经感受到了」"
    },
    {
        "message": "然后，停顿了一下……"
    },
    {
        "name": "莲",
        "message": "「但是，对不起。我现在最在乎的是清露」"
    },
    {
        "name": "莲",
        "message": "「真的……非常抱歉……」"
    },
    {
        "message": "我深深地低下了头。"
    },
    {
        "name": "葵",
        "message": "「错的是我……给你添了那么多麻烦……」"
    },
    {
        "name": "葵",
        "message": "「对不起……对不起呜……」"
    },
    {
        "message": "美丘同学也低下了头。一次又一次地低头。"
    },
    {
        "name": "莲",
        "message": "「美丘同学……」"
    },
    {
        "name": "葵",
        "message": "「对不起……」"
    },
    {
        "name": "莲",
        "message": "「美丘同学！」"
    },
    {
        "name": "葵",
        "message": "「呜呜……！」"
    },
    {
        "name": "莲",
        "message": "「正是因为有美丘同学，我才能获得这么多经历，才有了现在的我」"
    },
    {
        "name": "莲",
        "message": "「所以……」"
    },
    {
        "name": "葵",
        "message": "「九条同学，那个……」"
    },
    {
        "message": "美丘同学打断我话语的声音被黄昏时分的下课铃声淹没了。"
    },
    {
        "name": "葵",
        "message": "「啊，已经到时间了……我得走了……」"
    },
    {
        "name": "莲",
        "message": "「诶，去哪儿啊」"
    },
    {
        "message": "美丘同学对我露出了笑容。"
    },
    {
        "message": "然后……"
    },
    {
        "name": "葵",
        "message": "「拜拜」"
    },
    {
        "message": "美丘同学转身冲出了教室。"
    },
    {
        "name": "莲",
        "message": "「美丘同学！！！」"
    },
    {
        "name": "清露",
        "message": "「莲，你跑哪儿去了……真是的」"
    },
    {
        "name": "雪",
        "message": "「突然就跑掉了……是去接葵了吗？」"
    },
    {
        "name": "清露",
        "message": "「比赛马上就要结束了……电话也打不通……」"
    },
    {
        "name": "雪",
        "message": "「从这里到学校要花20到30分钟吧」"
    },
    {
        "name": "清露",
        "message": "「来回一趟比赛就差不多结束了！」"
    },
    {
        "message": "由于葵最终没有来，清露和雪只好退出比赛，等待莲和葵。"
    },
    {
        "name": "清露",
        "message": "「神轿马上就要来了」"
    },
    {
        "name": "清露",
        "message": "「莲不是很想看这个吗……」"
    },
    {
        "name": "雪",
        "message": "「唔唔唔……葵真的没事吗……」"
    },
    {
        "name": "清露",
        "message": "「既然你破坏了约定，待会儿可得请我吃点什么」"
    },
    {
        "name": "雪",
        "message": "「啊哈哈哈……」"
    },
    {
        "message": "正当雪无奈地笑着的时候……"
    },
    {
        "name": "雪",
        "message": "「咦，那是」"
    },
    {
        "name": "莲",
        "message": "「喂！清露！」"
    },
    {
        "name": "清露",
        "message": "「啊，笨蛋莲！你在干什么啊！」"
    },
    {
        "name": "清露",
        "message": "突然跑掉让人很担心的好吗！"
    },
    {
        "name": "莲",
        "message": "「对不起对不起……」"
    },
    {
        "name": "清露",
        "message": "「那，葵呢？」"
    },
    {
        "name": "莲",
        "message": "「咦，她没来这边吗？」"
    },
    {
        "name": "清露",
        "message": "「我没看到啊。雪，你看到了吗？」"
    },
    {
        "name": "雪",
        "message": "「不，我也没看到」"
    },
    {
        "name": "莲",
        "message": "「该死……」"
    },
    {
        "message": "都怪我跑得太慢了……"
    },
    {
        "name": "清露",
        "message": "「葵应该来这边了吗！？」"
    },
    {
        "name": "莲",
        "message": "「大概」"
    },
    {
        "name": "清露",
        "message": "「什么叫大概啊！我可是要让葵请我吃章鱼烧的！」"
    },
    {
        "name": "莲",
        "message": "「啊，那是什么情况」"
    },
    {
        "name": "雪",
        "message": "「可能是在人群中走散了，找不到了吧……」"
    },
    {
        "name": "莲",
        "message": "「应该是这样吧……」"
    },
    {
        "name": "雪",
        "message": "「神轿快到了，人也会越来越多的哦」"
    },
    {
        "name": "莲",
        "message": "「啊，真的吗……」"
    },
    {
        "name": "莲",
        "message": "「啊」"
    },
    {
        "name": "莲",
        "message": "「是森林……神社后面的森林」"
    },
    {
        "name": "莲",
        "message": "「美丘小姐——！」"
    },
    {
        "name": "清露",
        "message": "「葵！你既然违约了，就得请我吃章鱼烧！」"
    },
    {
        "name": "雪",
        "message": "「葵——！」"
    },
    {
        "message": "进入神社后面的森林，这样喊了大约10分钟，但既没有回应也看不到人影。"
    },
    {
        "message": "能听到的只有神轿靠近时的太鼓声。"
    },
    {
        "name": "莲",
        "message": "「不行了……天快黑了，再待在这里就太危险了……」"
    },
    {
        "name": "清露",
        "message": "「话说回来，这里真的是那个地方吗？」"
    },
    {
        "name": "莲",
        "message": "「呃，我也不知道，就是直觉……」"
    },
    {
        "name": "清露",
        "message": "「直觉……嘛，要说是莲的直觉的话，倒也不是不能相信……」"
    },
    {
        "name": "雪",
        "message": "「直觉是没问题啦，但是看起来完全找不到的样子呢」"
    },
    {
        "name": "莲",
        "message": "「唔……」"
    },
    {
        "name": "莲",
        "message": "「说起来……这片森林里是不是有个只有石头搭建的小祠堂来着？」"
    },
    {
        "message": "我好像记得在调查美丘神社的时候看到过这样的描述。"
    },
    {
        "name": "雪",
        "message": "「啊，那个地方的话……在这边！」"
    },
    {
        "message": "于是，在汐崎的带领下，我们来到了那个小祠堂所在的地方。"
    },
    {
        "message": "距离刚才的地方并不是很远，不知为何之前却没能发现。"
    },
    {
        "message": "我觉得可能是有什么东西在阻碍我们到达这里。"
    },
    {
        "message": "到达那个地方后，我们确实看到了美丘的身影。"
    },
    {
        "message": "然而，那既是美丘，又不是美丘。"
    },
    {
        "message": "那里站着这样一个她。"
    },
    {
        "name": "清露",
        "message": "「葵！」"
    },
    {
        "name": "雪",
        "message": "「怎、怎么了！？」"
    },
    {
        "name": "莲",
        "message": "「原来如此……」"
    },
    {
        "name": "葵",
        "message": "「对不起，清露酱，雪酱。九条君已经知道了，其实我是猫神的后裔」"
    },
    {
        "name": "清露",
        "message": "「神明的后裔？」"
    },
    {
        "name": "雪",
        "message": "「诶，等、等等……诶诶！？」"
    },
    {
        "message": "清露显得很惊讶，汐崎则陷入了常见的混乱状态。"
    },
    {
        "name": "清露",
        "message": "「这、这是怎么回事？」"
    },
    {
        "name": "葵",
        "message": "「我是猫神的后裔，一直以人类的样子和大家在一起……」"
    },
    {
        "name": "清露",
        "message": "「等等等等……我完全搞不懂啊……」"
    },
    {
        "name": "莲",
        "message": "「清露，这个我待会儿再解释。美丘现在必须要回到神明的世界去了……」"
    },
    {
        "name": "莲",
        "message": "「我想把美丘留在这个世界」"
    },
    {
        "name": "清露",
        "message": "「是、是说要消失到某个地方去吗？就是说再也见不到了吗？」"
    },
    {
        "name": "莲",
        "message": "「嗯，就是这么回事」"
    },
    {
        "name": "葵",
        "message": "「嗯……就像九条君说的那样。我啊，已经必须要回到神明的世界去了……」"
    },
    {
        "name": "清露",
        "message": "「真的非回去不可吗？」"
    },
    {
        "name": "葵",
        "message": "「嗯。因为我背负了罪过……为了自己的欲望使用这种力量是违反规则的……」"
    },
    {
        "name": "清露",
        "message": "「我不知道葵为了什么欲望用了什么力量，但你给我留在这儿！」"
    },
    {
        "name": "清露",
        "message": "「实现人们愿望不就是神明的工作吗！」"
    },
    {
        "name": "葵",
        "message": "「是、是这样没错……」"
    },
    {
        "name": "清露",
        "message": "「那么……！」"
    },
    {
        "name": "葵",
        "message": "「清露酱……虽然经常被你骂，但你总是教我很多东西，陪我玩耍……」"
    },
    {
        "name": "葵",
        "message": "「能和清露酱在一起，每天都很开心」"
    },
    {
        "name": "清露",
        "message": "「葵……」"
    },
    {
        "name": "葵",
        "message": "「雪酱……真的很高兴你成为我的第一个朋友。你最常陪在我身边，我真的非常开心」"
    },
    {
        "name": "雪",
        "message": "「我、我也很高兴葵是我的第一个朋友……」"
    },
    {
        "name": "葵",
        "message": "「还有，九条君，我呢，一开始是为了九条君，但渐渐地和大家在一起的时间变得很快乐……所以一直留到了现在」"
    },
    {
        "name": "葵",
        "message": "「所以，九条君不用在意任何事哦」"
    },
    {
        "name": "葵",
        "message": "「因为九条君是个温柔的人，如果你消沉的话，就没法让清露酱振作起来了……」"
    },
    {
        "name": "莲",
        "message": "「那么，我们继续一直在一起不就好了吗！那种规则什么的无所谓吧！？」"
    },
    {
        "name": "雪",
        "message": "「没错！我还有好多想和葵一起做的事呢！」"
    },
    {
        "name": "葵",
        "message": "「不行！别再说了！」"
    },
    {
        "name": "葵",
        "message": "「明明该走了的……可是你们这么说的话……」"
    },
    {
        "name": "葵",
        "message": "「我、我会更想和大家在一起的啊」"
    },
    {
        "name": "莲",
        "message": "「美丘！」"
    },
    {
        "name": "葵",
        "message": "「大家……」"
    },
    {
        "name": "雪",
        "message": "「葵……不要啊，不要啊」"
    },
    {
        "name": "葵",
        "message": "「我、我还想和大家在一起啊！」"
    },
    {
        "name": "清露",
        "message": "「葵……我们永远是朋友对吧……」"
    },
    {
        "name": "葵",
        "message": "「嗯！嗯！」"
    },
    {
        "name": "清露",
        "message": "「永远都是朋友哦！！」"
    },
    {
        "name": "雪",
        "message": "「我也是！！永远永远都是朋友啊！」"
    },
    {
        "name": "葵",
        "message": "「再见，清露酱，雪酱！」"
    },
    {
        "name": "莲",
        "message": "「美丘……」"
    },
    {
        "name": "莲",
        "message": "「再见」"
    },
    {
        "name": "莲",
        "message": "「不是再见，是再会」"
    },
    {
        "name": "雪",
        "message": "「嗯，是再会哦」"
    },
    {
        "name": "清露",
        "message": "「嗯，再会了，葵」"
    },
    {
        "name": "葵",
        "message": "「嗯……大家……」"
    },
    {
        "name": "葵",
        "message": "「呼——」"
    },
    {
        "name": "葵",
        "message": "「大家，再会！」"
    },
    {
        "name": "清露",
        "message": "「哈——，最后的文化祭也结束了呢」"
    },
    {
        "name": "清露",
        "message": "「节日过后总有种寂寞的感觉……」"
    },
    {
        "name": "莲",
        "message": "「嗯。不知道为什么会有这种寂寞感呢。就像胸口突然被掏空了一样，该怎么说呢」"
    },
    {
        "message": "我们升到了三年级，我从猫城前辈那里接任了学生会长的职务，成功举办了学园生活最后的文化祭。"
    },
    {
        "name": "清露",
        "message": "「感觉比去年更寂寞一些呢……是因为这是最后的文化祭吗」"
    },
    {
        "name": "莲",
        "message": "「可能是吧。去年的文化祭是我、清露和汐崎三个人负责策划，真是辛苦啊」"
    },
    {
        "name": "清露",
        "message": "「是啊——，结果我们几乎没怎么依靠艾莉卡呢……」"
    },
    {
        "name": "莲",
        "message": "「确实。猫城前辈，最后只是想和我们在一起而已啊」"
    },
    {
        "name": "清露",
        "message": "「呵呵，是啊」"
    },
    {
        "name": "莲",
        "message": "「不过，说到这个。文化祭结束的话就意味着……」"
    },
    {
        "name": "清露",
        "message": "「结束了的话……？」"
    },
    {
        "name": "莲",
        "message": "「就意味着我们交往一周年了啊」"
    },
    {
        "name": "清露",
        "message": "「！！」"
    },
    {
        "name": "清露",
        "message": "「你还记得啊」"
    },
    {
        "name": "莲",
        "message": "「这不是理所当然的吗！！」"
    },
    {
        "name": "清露",
        "message": "「明明平时那么健忘的莲……」"
    },
    {
        "name": "莲",
        "message": "「什么啊那是……话说，我可是一直没忘记小时候那个约定啊！」"
    },
    {
        "name": "清露",
        "message": "「呵呵，是啊。对不起对不起」"
    },
    {
        "name": "莲",
        "message": "「算了……那么，我们两个来庆祝一下一周年纪念吧」"
    },
    {
        "name": "清露",
        "message": "「诶，庆祝！？」"
    },
    {
        "name": "莲",
        "message": "「这不是理所当然的吗。毕竟是纪念日啊」"
    },
    {
        "name": "清露",
        "message": "「呵呵，好开心」"
    },
    {
        "message": "清露说着，牵着手的同时紧紧地贴近了身体。"
    },
    {
        "message": "就这样走在去学校的路上时……"
    },
    {
        "name": "清露",
        "message": "「啊，猫咪」"
    },
    {
        "message": "那里有一只从未见过的漂亮白猫，长相十分精致。"
    },
    {
        "name": "清露",
        "message": "「喵咪好可爱！！」"
    },
    {
        "message": "说起来，清露对可爱的东西没有抵抗力。"
    },
    {
        "name": "莲",
        "message": "「好像在看着这边啊……是怎么回事呢」"
    },
    {
        "message": "白猫在我们面前坐下，一动不动地盯着这边。"
    },
    {
        "name": "清露",
        "message": "「是迷路的猫咪吗？」"
    },
    {
        "name": "莲",
        "message": "「嗯，不太清楚……」"
    },
    {
        "message": "我一边说着，一边抱起了白猫。"
    },
    {
        "name": "莲",
        "message": "「话说回来真是只漂亮的猫啊」"
    },
    {
        "name": "清露",
        "message": "「好可爱的喵咪！是住在这附近吗？」"
    },
    {
        "name": "莲",
        "message": "「但是，我从来没见过它啊」"
    },
    {
        "name": "清露",
        "message": "「是啊……呐，莲，给这孩子起个名字怎么样？」"
    },
    {
        "name": "莲",
        "message": "「也是啊……嗯……」"
    },
    {
        "message": "蓝天刺痛了我的眼睛……真是美丽的天空。"
    },
    {
        "message": "映入眼帘的那片天空，让我感觉唤起了某种怀念的心情。"
    },
    {
        "name": "莲",
        "message": "「啊……好，决定了！」"
    },
    {
        "name": "莲",
        "message": "「你的名字就叫「葵」！因为是在美丘町的葵，所以就叫「美丘葵」吧！」"
    },
    {
        "name": "白猫",
        "message": "「喵～♪」"
    }
]