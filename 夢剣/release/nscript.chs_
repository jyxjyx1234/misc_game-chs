	btnwait %10

	if %10 == 0 goto *loop001
	if %10 == -1 csp -1:bg black,12:csp -1:goto *menu
	if %10 == 1 csp -1:goto *staff_mes
	if %10 == 2 csp -1:gosub *cg_mode:goto *extra
	if %10 == 3 csp -1:gosub *bgm_mode:goto *extra
