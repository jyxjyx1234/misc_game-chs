	if %10 == 0 goto *loop9001
	if %10 == -1 goto *loop9001
	if %10 == -2 goto *loop9001
	if %10 == -3 goto *loop9001

	if %10 == 1 wave wav201:goto *ty_01
	if %10 == 2 wave wav202:mov %199,1:goto *load_title:mov %199,0:csp -1:goto *loop9001
	if %10 == 3 goto *end
goto *loop9001


*menu_complete
