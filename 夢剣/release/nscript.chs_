if %201=1&%202=1&%203=1&%204=1 goto *menu_ty
*menu_def
bgm bgm038
bg "image\system\title.bmp",34
btndef ":a;image\system\title_btn.bmp"

	btn 1,217,321,70,30,0,0
	btn 2,351,321,70,30,134,0
	btn 3,217,374,70,40,0,53
	btn 4,351,374,70,40,134,53
	
*loop1001

	btnwait %10

	if %10 == 0 goto *loop1001
	if %10 == -1 goto *loop1001
	if %10 == -2 goto *loop1001
	if %10 == -3 goto *loop1001

	if %10 == 1 wave wav201:goto *start01
	if %10 == 2 wave wav202:mov %199,1:goto *load_title:mov %199,0:csp -1:goto *loop1001
	if %10 == 3 goto *end
goto *loop1001

*menu_ty
bgm bgm038
bg "image\system\title.bmp",34
btndef ":a;image\system\title_btn.bmp"

	btn 1,217,321,70,30,0,0
	btn 2,351,321,70,30,134,0
