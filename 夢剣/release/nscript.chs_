bg "image\system\title1.bmp",34
btndef ":a;image\system\title1_btn.bmp"

	btn 1,217,321,70,30,0,0
	btn 2,351,321,70,30,134,0
	btn 3,217,374,70,40,0,53
	btn 4,351,374,70,40,134,53
	
*loop1000

	btnwait %10

	if %10 == 0 goto *loop1000
	if %10 == -1 goto *loop1000

	if %10 == 1 wave wav201:goto *start01_after
	if %10 == 2 wave wav202:mov %199,1:goto *load_title:mov %199,0:csp -1:goto *loop1000
	if %10 == 3 wave wav202:goto *extra:csp -1:goto *menu
	if %10 == 4 goto *end
goto *loop1000

