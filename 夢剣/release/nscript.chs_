







*define
nsa
caption "夢剣-Sword of the Dimacreation- Claude-3.7-sonnet机翻 by jyxjyx1234@ai2.moe"
versionstr "夢剣-Sword of the Dimacreation-","2003 因果堂Type-I.G."
mode_wave_demo
globalon
errorsave
shadedistance 2,2
kidokuskip
lookbackcolor #50c4cd
lookbackbutton "image\system\uoncur.bmp","image\system\uoffcur.bmp","image\system\doncur.bmp","image\system\doffcur.bmp"
lookbackvoice "wav\wav_200.wav"
mp3fadeout 200
usewheel
noteraseman
automode
automode_time 1000
defaultspeed 80,40,1
textgosub *text_wait

resetmenu
insertmenu "退出",END
insertmenu "版本信息",VERSION
insertmenu "环境设置",SUB
insertmenu "字体",FONT,1
insertmenu "音量调整",SUB,1
insertmenu "音效开",WAVEON,2
insertmenu "音效关",WAVEOFF,2
insertmenu "任意(BGM仅可更改)",DWAVEVOLUME,2
insertmenu "文字速度",SUB,1
insertmenu "慢",TEXTSLOW,2
insertmenu "普通",TEXTMIDDLE,2
insertmenu "快",TEXTFAST,2
insertmenu "显示大小",SUB,1
insertmenu "全屏",FULL,2
insertmenu "窗口",WINDOW,2
insertmenu "点击设置",SUB,1
insertmenu "普通",CLICKDEF,2
insertmenu "每页",CLICKPAGE,2
insertmenu "跳过到选项",skip
insertmenu "跳过模式",sub
insertmenu "跳过所有消息",kidokuoff,1
insertmenu "仅跳过已读文本",kidokuon,1
insertmenu "自动模式",AUTO
insertmenu "画面",SUB
insertmenu "全屏",FULL,1
insertmenu "窗口",WINDOW,1



