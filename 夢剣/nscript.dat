spbtn 7,3
spbtn 8,4
spbtn 9,5
*loop10

	btnwait %10

	if %10 == 0 goto *loop10
	if %10 == -1 csp -1:return
	if %10 == 1 csp -1:goto *cg_mode_asu1
	if %10 == 2 csp -1:goto *cg_mode_ken1
	if %10 == 3 csp -1:goto *cg_mode_mo1
	if %10 == 4 csp -1:goto *cg_mode_fu1
	if %10 == 5 csp -1:goto *cg_mode_ty1
	
	if %10 == -2 goto *loop10
	if %10 == -3 goto *loop10


