;--select待ち--
;csel ○ custom な select 命令。*customsel に処理を飛ばす。 
;cselbtn ○ *customsel 内で使用。 csel の選択肢をボタンとして設定。 
;cselgoto ○ *customsel 内で使用。 指定番号選択肢のラベルへ goto。 
;getcselnum ○ *customsel 内で使用。 csel で指定された選択肢数を取得。 
;getcursorpos ○ 文字カーソルの位置を指定した2つの変数に取得。 


*customsel
skipoff
btndef clear	
*csel_st
getcselnum %0
getcursorpos %1,%2
cselbtn 0,500,%1,%2
if %0>1 add %2,21:cselbtn 1,501,%1,%2
if %0>2 add %2,21:cselbtn 2,502,%1,%2
if %0>3 add %2,21:cselbtn 3,503,%1,%2
if %0>4 add %2,21:cselbtn 4,504,%1,%2
if %0>5 add %2,21:cselbtn 5,505,%1,%2
if %0>6 add %2,21:cselbtn 6,506,%1,%2
;if %0>7 add %2,21:cselbtn 7,507,%1,%2

*csel_loop
selectbtnwait %10
if %10=-2 systemcall lookback:goto *csel_loop
if %10=-1 btndef clear:mov %900,1:getscreenshot 80,60:gosub *rmenu:mov %900,0:erasetextwindow 1:texton:goto *customsel
if %10>=500 & %0<=507 sub %10,500:cselgoto %10
goto *csel_loop






