bg black,1
csp -1
setwindow 36,309,27,8,21,22,0,1,1,1,1,":a;image\window\aw_0216_2.bmp",20,285
!sd
csel "実験",*z,"はじめる",*start01,"ＣＧモード",*cg_mode,"ＢＧＭモード",*bgm_mode,"テンポラリ",*extra,"ＯＰ飛ばし",*as_01,"次",*select1
*select1
csel "ティリクシナリオ",*ty_01,"明日エンド",*as_after,"賢堂エンド",*ke_after,"基エンド",*mo_after,"風美エンド",*fu_after,"テンポ",*ty_end_1,"次へ",*select2
*select2
csel "３日目",*as_03,"四日目",*as_04,"五日目",*as_05,"六日目",*as_06,"七日目",*as_07,"八日目",*as_08,"次へ",*select3
*select3
csel "九日目",*as_09,"十日目",*as_10,"十一日目",*as_11,"十二日目",*as_12,"次へ",*select4
*select4
