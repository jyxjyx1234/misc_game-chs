;一文字だったら、
if %901 == 1 goto *savetime_month2

*savetime_month2
if %901 == 1 mov








文字列の長さを返します。
itoa $102,%102
itoa $104,%103
itoa $105,%104
lsp 90,":s#FFFFFF$101月$102日$103時$104分",50,100
