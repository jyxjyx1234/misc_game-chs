btndef clear
textoff
csp -1
lsp 19,":c;image\system\cg_back.bmp",0,0
lsp 5,":c/2,0,3;image\system\cg_btn_asu.bmp",82,93
lsp 6,":c/2,0,3;image\system\cg_btn_ken.bmp",82,179
