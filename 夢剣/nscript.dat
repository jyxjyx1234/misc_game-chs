bgmstop
textoff
csp -1
lsp 19,":c;image\system\staff_mes_back.bmp",0,0
lsp 5,":c/2,0,3;image\system\mes_inga.bmp",87,184
lsp 6,":c/2,0,3;image\system\mes_tanaka.bmp",87,237
lsp 7,":c/2,0,3;image\system\mes_bel.bmp",74,287
lsp 8,":c/2,0,3;image\system\mes_modo.bmp",115,343
spbtn 5,1
spbtn 6,2
spbtn 7,3
spbtn 8,4
print 6
