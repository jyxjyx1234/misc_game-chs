[
    {
        "name": "アズライト",
        "name_start": 126,
        "name_end": 131,
        "start": 144,
        "end": 172,
        "line": 1,
        "ori": "「――プログラム・アズライトは、人々の為に作られました」",
        "message": "「——程序·石青，是为了人们而被创造出来的」"
    },
    {
        "name": "アズライト",
        "name_start": 677,
        "name_end": 682,
        "start": 695,
        "end": 732,
        "line": 1,
        "ori": "「最初は、ボクの為。けれどラピス主任は世界の為になると思って作ったんです」",
        "message": "「最初是为了我。但青金石主任认为这能造福世界，所以才制作了它」"
    },
    {
        "name": "アズライト",
        "name_start": 797,
        "name_end": 802,
        "start": 815,
        "end": 886,
        "line": 1,
        "ori": "「電脳を人の意思で制御する為のシステム。例えば、機械の何処が故障しているか、データの何処がおかしいのか。そういった物が一目で分かるようになる」",
        "message": "「用人的意志控制电脑的系统。比如，机械的哪里出现了故障，数据的哪里出现了异常。这些都能一目了然」"
    },
    {
        "name": "アズライト",
        "name_start": 951,
        "name_end": 956,
        "start": 969,
        "end": 1019,
        "line": 1,
        "ori": "「例えば道具の使い方が分からない事は無く、形式の違いに困る事は無い共通言語としての意味合いも込めて」",
        "message": "「比如不会出现不知道工具使用方法的情况，也不会因形式差异而困扰，还包含了作为通用语言的意义」"
    },
    {
        "name": "アズライト",
        "name_start": 1084,
        "name_end": 1089,
        "start": 1102,
        "end": 1173,
        "line": 1,
        "ori": "「そう、ボクやソージさんのようにリンクを繋げばその人とも電脳を介して意識を伝えあう事すら出来る――これは最初は想定していなかったみたいだけど」",
        "message": "「是的，像我和苍司先生那样连接链接的话，甚至可以通过电脑与那个人传递意识——这似乎是最初没有预想到的」"
    },
    {
        "name": "アズライト",
        "name_start": 1238,
        "name_end": 1243,
        "start": 1256,
        "end": 1312,
        "line": 1,
        "ori": "「言葉の異なる人、使う道具の違う人、そして新しい世界に向かう人の為、その手助けになる為に作られたシステムでした」",
        "message": "「为了语言不同的人、使用工具不同的人，以及前往新世界的人，这是为了帮助他们而创造出的系统」"
    },
    {
        "name": "アズライト",
        "name_start": 1642,
        "name_end": 1647,
        "start": 1660,
        "end": 1729,
        "line": 1,
        "ori": "「主任はいつも心配していました。これが軍事転用されれば、とんでもない事になる。その前に、そんな事は出来ないようにしておかなければならない」",
        "message": "「主任总是很担心。如果这被军事化利用的话，会酿成大祸。在那之前，必须让它无法被这样利用」"
    },
    {
        "name": "アズライト",
        "name_start": 1794,
        "name_end": 1799,
        "start": 1812,
        "end": 1828,
        "line": 1,
        "ori": "「――結果は、今までの通りです」",
        "message": "「——结果，就如至今所见」"
    },
    {
        "name": "アズライト",
        "name_start": 1893,
        "name_end": 1898,
        "start": 1911,
        "end": 1954,
        "line": 1,
        "ori": "「主任の心配したような事にはならず、けれどコレは完成する事無く封印されてしまいました」",
        "message": "「并没有发生主任担心的那种事，但这个却在未完成的状态下被封印了」"
    },
    {
        "name": "アズライト",
        "name_start": 2352,
        "name_end": 2357,
        "start": 2370,
        "end": 2415,
        "line": 1,
        "ori": "「そして未完成のそれは、ボクという例を参考に独自の適応を始めた。ううん、ボクだけじゃない」",
        "message": "「然后未完成的它，参考我这个例子开始了独自的适应。不，不仅是我」"
    },
    {
        "name": "アズライト",
        "name_start": 2630,
        "name_end": 2635,
        "start": 2648,
        "end": 2698,
        "line": 1,
        "ori": "「時折見た、アクアリウスの中。そこに居たラピス主任の姿。彼女が変わってしまったラピスラズリ・タイプ」",
        "message": "「偶尔看到的，阿奎利亚斯之中。在那里的青金石主任的身影。她变化后的青金石型」"
    },
    {
        "name": "アズライト",
        "name_start": 2895,
        "name_end": 2900,
        "start": 2913,
        "end": 2976,
        "line": 1,
        "ori": "「主任の目指した物、それを不完全な形で叶えようとしたプログラム・アズライトが、彼女を真似たのは自然な流れだったのかもしれない」",
        "message": "「主任追求的东西，试图以不完全的形式实现它的程序·石青，模仿她或许是自然而然的」"
    },
    {
        "name": "アズライト",
        "name_start": 3111,
        "name_end": 3116,
        "start": 3129,
        "end": 3187,
        "line": 1,
        "ori": "「ただ、主任も誤算だったのは――未完成なプログラム・アズライトに、自分を完成させようという意思が生まれてしまった事」",
        "message": "「只是，主任也没料到的是——未完成的程序·石青，产生了想要完成自己的意志」"
    },
    {
        "name": "アズライト",
        "name_start": 3253,
        "name_end": 3258,
        "start": 3271,
        "end": 3293,
        "line": 1,
        "ori": "「それは多分……ボクの意思だったんだと思う」",
        "message": "「那大概……我想是我的意志」"
    },
    {
        "name": "アズライト",
        "name_start": 3359,
        "name_end": 3364,
        "start": 3377,
        "end": 3415,
        "line": 1,
        "ori": "「それをくみ取ったプログラム・アズライトがきっとあんな形になったんだと思う」",
        "message": "「我想正是领会了这一点的程序·石青才变成了那种样子」"
    },
    {
        "name": "アズライト",
        "name_start": 3514,
        "name_end": 3519,
        "start": 3532,
        "end": 3548,
        "line": 1,
        "ori": "「――ボクは、幸せでいいのかな」",
        "message": "「——我，可以幸福吗」"
    },
    {
        "name": "アズライト",
        "name_start": 3657,
        "name_end": 3662,
        "start": 3675,
        "end": 3697,
        "line": 1,
        "ori": "「もしもソージさんが居なかったら……ボクは」",
        "message": "「如果没有苍司先生的话……我」"
    },
    {
        "name": "蒼司",
        "name_start": 3849,
        "name_end": 3851,
        "start": 3853,
        "end": 3858,
        "line": 1,
        "ori": "「阿呆が」",
        "message": "「笨蛋」"
    },
    {
        "name": "アズライト",
        "name_start": 3924,
        "name_end": 3929,
        "start": 3942,
        "end": 3956,
        "line": 1,
        "ori": "「っ！？　そ、ソージさん？」",
        "message": "「！？苍、苍司先生？」"
    },
    {
        "name": "蒼司",
        "name_start": 4004,
        "name_end": 4006,
        "start": 4008,
        "end": 4057,
        "line": 1,
        "ori": "「何をバカな『たられば』の話をしてるのやら、というかどうせそんな事気にしてるんだろうと思ったけど」",
        "message": "「说什么愚蠢的假设啊，不过我就知道你肯定在想这种事」"
    },
    {
        "name": "アズライト",
        "name_start": 4123,
        "name_end": 4128,
        "start": 4141,
        "end": 4148,
        "line": 1,
        "ori": "「だって――」",
        "message": "「可是——」"
    },
    {
        "name": "蒼司",
        "name_start": 4175,
        "name_end": 4177,
        "start": 4179,
        "end": 4210,
        "line": 1,
        "ori": "「そんなお前と主任２人で滅ぶような世界ならとっくに滅んでるわ」",
        "message": "「要是这世界会因为你和主任两个人就灭亡的话早就灭亡了」"
    },
    {
        "name": "蒼司",
        "name_start": 4276,
        "name_end": 4278,
        "start": 4280,
        "end": 4304,
        "line": 1,
        "ori": "「……あー、くそ。これから苦労しそうだな、おい」",
        "message": "「……啊，可恶。看来今后会很辛苦啊，喂」"
    },
    {
        "name": "アズライト",
        "name_start": 4331,
        "name_end": 4336,
        "start": 4349,
        "end": 4356,
        "line": 1,
        "ori": "「ごめん……」",
        "message": "「对不起……」"
    },
    {
        "name": "蒼司",
        "name_start": 4547,
        "name_end": 4549,
        "start": 4551,
        "end": 4571,
        "line": 1,
        "ori": "「お前が、そういう、態度だからだろ！？」",
        "message": "「就是因为你，这种，态度！？」"
    },
    {
        "name": "アズライト",
        "name_start": 4686,
        "name_end": 4691,
        "start": 4704,
        "end": 4721,
        "line": 1,
        "ori": "「い、いひゃ……いひゃいよ……？」",
        "message": "「不、不要……不要这样……？」"
    },
    {
        "name": "蒼司",
        "name_start": 4855,
        "name_end": 4857,
        "start": 4859,
        "end": 4917,
        "line": 1,
        "ori": "「お前が、ボクのせいだとか、なんだかんだと後悔をやめるまで、俺が大変なんだからな。気にするならとっとと前向きになれ」",
        "message": "「你要是不停止什么都怪我、各种后悔的话，我会很辛苦的。要在意的话就赶紧振作起来」"
    },
    {
        "name": "アズライト",
        "name_start": 4983,
        "name_end": 4988,
        "start": 5001,
        "end": 5023,
        "line": 1,
        "ori": "「え、ええ？　そ、それで前向きになったら？」",
        "message": "「诶、诶？那、那振作起来之后呢？」"
    },
    {
        "name": "蒼司",
        "name_start": 5089,
        "name_end": 5091,
        "start": 5093,
        "end": 5141,
        "line": 1,
        "ori": "「そこからは楽しい世界旅行の始まりだろ。まあ行き先は自分達で決められるかどうかは分からないけど」",
        "message": "「那之后就是快乐的世界旅行开始了吧。虽然不知道能不能自己决定去哪」"
    },
    {
        "name": "アズライト",
        "name_start": 5207,
        "name_end": 5212,
        "start": 5225,
        "end": 5233,
        "line": 1,
        "ori": "「……いいの？」",
        "message": "「……可以吗？」"
    },
    {
        "name": "蒼司",
        "name_start": 5260,
        "name_end": 5262,
        "start": 5264,
        "end": 5268,
        "line": 1,
        "ori": "「何が」",
        "message": "「什么」"
    },
    {
        "name": "アズライト",
        "name_start": 5334,
        "name_end": 5339,
        "start": 5352,
        "end": 5365,
        "line": 1,
        "ori": "「ボクが、幸せになっても」",
        "message": "「我，变得幸福也可以吗」"
    },
    {
        "name": "蒼司",
        "name_start": 5392,
        "name_end": 5394,
        "start": 5396,
        "end": 5412,
        "line": 1,
        "ori": "「――自分で決めろ。ただし、だ」",
        "message": "「——自己决定。不过，听好了」"
    },
    {
        "name": "蒼司",
        "name_start": 5478,
        "name_end": 5480,
        "start": 5482,
        "end": 5505,
        "line": 1,
        "ori": "「俺は、お前を幸せにするのを生き甲斐にするぞ」",
        "message": "「我要把让你幸福当成人生目标」"
    },
    {
        "start": 5559,
        "end": 5578,
        "line": 1,
        "ori": "　――ほら、と彼はボクに手を伸ばして。",
        "message": "　——来吧，他向我伸出了手。"
    },
    {
        "name": "蒼司",
        "name_start": 5605,
        "name_end": 5607,
        "start": 5609,
        "end": 5614,
        "line": 1,
        "ori": "「行くぞ」",
        "message": "「走吧」"
    },
    {
        "start": 5629,
        "end": 5640,
        "line": 1,
        "ori": "　無理矢理手をとって。",
        "message": "　强行握住了我的手。"
    },
    {
        "name": "アズライト",
        "name_start": 5706,
        "name_end": 5711,
        "start": 5724,
        "end": 5732,
        "line": 1,
        "ori": "「う、うん――」",
        "message": "「嗯、嗯——」"
    },
    {
        "start": 5781,
        "end": 5811,
        "line": 1,
        "ori": "　まだ後悔ばかりで戸惑うボクを、無理矢理に引っ張っていった。",
        "message": "　还满是后悔和困惑的我，被他强行拉着走了。"
    },
    {
        "start": 5902,
        "end": 5913,
        "line": 1,
        "ori": "　ロスト・アズライト。",
        "message": "　失落石青。"
    },
    {
        "start": 5928,
        "end": 5964,
        "line": 1,
        "ori": "　事件の名前だけじゃなくて、アズライトの名前は失われてここに置いて行く。",
        "message": "　不仅是事件的名字，石青这个名字也失落了，留在了这里。"
    },
    {
        "start": 6321,
        "end": 6329,
        "line": 1,
        "ori": "　そしてぼくは。",
        "message": "　然后我。"
    },
    {
        "name": "蒼司",
        "name_start": 6356,
        "name_end": 6358,
        "start": 6360,
        "end": 6365,
        "line": 1,
        "ori": "「――葵」",
        "message": "「——葵」"
    },
    {
        "name": "葵",
        "name_start": 6404,
        "name_end": 6405,
        "start": 6429,
        "end": 6433,
        "line": 1,
        "ori": "「うん」",
        "message": "「嗯」"
    },
    {
        "start": 6448,
        "end": 6468,
        "line": 1,
        "ori": "　新しい名前で、新しい世界を歩いて行く。",
        "message": "　用新的名字，走向新的世界。"
    },
    {
        "start": 6483,
        "end": 6498,
        "line": 1,
        "ori": "　この人に、手を引っ張られて。",
        "message": "　被这个人，牵着手。"
    }
]