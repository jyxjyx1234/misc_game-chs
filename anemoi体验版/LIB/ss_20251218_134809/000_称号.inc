//===========================================================================
// 称号一覧
//===========================================================================
#replace	@称号_幼女ハンター		"幼女ハンター"
#replace	@称号_制服ハンター		"制服ハンター"
#replace	@称号_ドＭ				"ドＭ"
#replace	@称号_人妻キラー		"人妻キラー"
#replace	@称号_人妻ハンター		"人妻ハンター"





//===========================================================================
// 命令
//===========================================================================
//-----------------------------------------------------------------
// 現在の称号を変更する
// ※アニメーションタイプを1にすると派手な演出になる
//-----------------------------------------------------------------
#macro	@称号を獲得(@称号名, @アニメーションタイプ(0))
	$$set_title(@称号名)
	if( @アニメーションタイプ >= 0 ) {
		close
		$$play_title_get_animation(front.object[<OBJ_APP_EFFECT02>], @称号名, @アニメーションタイプ)
	}

/***********************     サンプル     ************************
【島の少女Ｂ】「なかなか従順なルシファーだから、いいわ」R
	
// 現在の称号を"テスト_従順なルシファー"にする
@称号を獲得(@称号_テスト_従順なルシファー)

【羽依里】「それは……まぁ、いいけど」R
******************************************************************/


//-----------------------------------------------------------------
// 現在の称号を判定する
//-----------------------------------------------------------------
#macro	@現在の称号
	$$get_title

/***********************     サンプル     ************************
// 現在の称号が"テスト_従順なルシファー"か判定する
if( @現在の称号 == @称号_テスト_従順なルシファー )
{
	// 称号が"テスト_従順なルシファー"の場合
	【島の少女Ｂ】「さすが従順なルシファーだわ」R
}
else
{
	// 称号が"テスト_従順なルシファー"以外の場合
	【島の少女Ｂ】「あなた誰？」R
}
******************************************************************/


//-----------------------------------------------------------------
// 過去に一度でも取得したことがある称号か判定する
//-----------------------------------------------------------------
#macro	@称号を獲得したことがある(@称号名)
	$$has_title(@称号名)

/***********************     サンプル     ************************
// 過去に"テスト_従順なルシファー"を獲得したことがあるか判定する
if( @称号を獲得したことがある(@称号_テスト_従順なルシファー) )
{
	// 過去に一度でも"テスト_従順なルシファー"を取得している場合(※現在の称号が"テスト_従順なルシファー"でなくても)
	【島の少女Ｂ】「さすが従順なルシファーだわ」R
}
else
{
	// "テスト_従順なルシファー"を一度も取得したことがない場合
	【島の少女Ｂ】「あなた誰？」R
}
******************************************************************/
