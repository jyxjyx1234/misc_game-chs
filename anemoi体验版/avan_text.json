[
    {
        "file": "010_プロローグ0701.ss",
        "idx": 0,
        "ori": "不意に、強い風が吹いた。",
        "message": "突然，刮起了一阵强风。"
    },
    {
        "file": "010_プロローグ0701.ss",
        "idx": 1,
        "ori": "風は俺を追い越して、草を波打たせながら走る。",
        "message": "风从我身边掠过，吹得草浪起伏着奔向远方。"
    },
    {
        "file": "010_プロローグ0701.ss",
        "idx": 2,
        "ori": "そして空と地平の隙間へ消えていく。",
        "message": "然后消失在天空与地平线的缝隙之间。"
    },
    {
        "file": "010_プロローグ0701.ss",
        "idx": 3,
        "ori": "まるで、見えない力に吸い込まれていくように。",
        "message": "就像是被某种看不见的力量吸了进去一样。"
    },
    {
        "file": "010_プロローグ0701.ss",
        "idx": 4,
        "ori": "……ふと、俺は足をとめた。",
        "message": "……突然，我停下了脚步。"
    },
    {
        "file": "010_プロローグ0701.ss",
        "idx": 5,
        "ori": "どこまでも続く草原とかなたの地平線。",
        "message": "无边无际的草原和远方的地平线。"
    },
    {
        "file": "010_プロローグ0701.ss",
        "idx": 6,
        "ori": "奇妙な不安を感じた。",
        "message": "我感到一种奇妙的不安。"
    },
    {
        "file": "010_プロローグ0701.ss",
        "idx": 7,
        "ori": "自分もまた、いちじんの風になってどこかへ消えてしまうような……",
        "message": "自己也会化作一缕风消失在某处……"
    },
    {
        "file": "010_プロローグ0701.ss",
        "idx": 8,
        "ori": "どうしようもなく、吸い込まれていくような。",
        "message": "无可奈何地，被吸进去一般。"
    },
    {
        "file": "010_プロローグ0701.ss",
        "idx": 9,
        "ori": "再び強い風が吹く。",
        "message": "强风再次吹起。"
    },
    {
        "file": "010_プロローグ0701.ss",
        "idx": 10,
        "ori": "俺の背中を押していく。",
        "message": "推着我的背。"
    },
    {
        "file": "010_プロローグ0701.ss",
        "idx": 11,
        "ori": "地平線のかなたに俺を連れて行こうとするように。",
        "message": "仿佛要将我带往地平线的彼方。"
    },
    {
        "file": "010_プロローグ0701.ss",
        "idx": 12,
        "ori": "俺は大地に立った二つの足の感触を、しっかりと噛みしめる。",
        "message": "我牢牢感受着双脚踏在大地上的触感。"
    },
    {
        "file": "010_プロローグ0701.ss",
        "idx": 13,
        "ori": "大丈夫。",
        "message": "没事的。"
    },
    {
        "file": "010_プロローグ0701.ss",
        "idx": 14,
        "ori": "俺はここにいる。",
        "message": "我就在这里。"
    },
    {
        "file": "010_プロローグ0701.ss",
        "idx": 15,
        "ori": "まだ旅の途中にいる。",
        "message": "还在旅途之中。"
    }
]