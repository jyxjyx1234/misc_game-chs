<?xml version="1.0" encoding="utf-8"?><xscript><debug editor="&quot;C:\Program&#32;Files&#32;(x86)\sakura\sakura.exe&quot;&#32;&quot;%src%&quot;&#32;-Y=%line%"   src="D:\シロップ\町ぐるみの罠＋汚された夏セット版\汚された夏\完成データ\汚された夏\script\text\common_root02.txt"/><code><label @l="17" id="EventLabel_23"/><description @l="21" text="日常生活"/><eval @l="23" expr="f.numDay=2&#13;&#10;"/><msgshow @l="25" show="false"/><wait_chgmv/><bg @l="27" src="day02" time="2000"/><wait @l="29" time="500"/><wait_chgmv/><bg @l="31" src="black" time="2000"/><msgshow @l="33" show="true"/><wait_chgmv/><bg @l="37" src="bg21m1"/><bgm @l="41" src="bgm02" volume="1."/><char @l="45" id="miho" pos="auto" src="miho110"/><msg @l="47" char_id="-1" frame_id="-1" name="" text="―――早晨。" voices=""/><msg @l="48" char_id="-1" frame_id="-1" name=""   text="我在车站准备搭乘比昨天晚一班的电车。" voices=""/><msg @l="49" char_id="-1" frame_id="-1" name="" text="当然，这是为了避免遭遇痴汉。"   voices=""/><msg @l="51" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="53" char_id="-1" frame_id="-1" name=""   text="车站因乘坐去往大学的电车的学生们而排起了长龙。" voices=""/><msg @l="54" char_id="-1" frame_id="-1" name=""   text="我在长队的中间位置，一直在等待上车的顺序。" voices=""/><msg @l="56" char_id="0" frame_id="-1" name="美帆" text="(果然……人，好多啊)"   voices=""/><msg @l="58" char_id="-1" frame_id="-1" name="" text="这是能赶上第一节课的最后一班电车。"   voices=""/><msg @l="59" char_id="-1" frame_id="-1" name=""   text="今天排队的人数比平时乘坐的电车多了约1。5倍。" voices=""/><msg @l="60" char_id="-1" frame_id="-1" name=""   text="平时的话我绝对不会乘坐这班车，但如果能避免遭遇痴汉，这样还算好受些。" voices=""/><clear @l="66" class="all"/><label @l="69" id="event_scene05_2"/><msg @l="71" char_id="-1" frame_id="-1" name="广播"   text="『呃，车厢非常拥挤……。』" voices=""/><msg @l="73" char_id="-1" frame_id="-1" name="广播"   text="『请不要在途中停留，一直前进到车厢中部。』" voices=""/><msg @l="75" char_id="-1" frame_id="-1" name=""   text="终于队伍开始流动，我也被挤着进入了车厢。" voices=""/><msg @l="76" char_id="-1" frame_id="-1" name=""   text="车内广播不断重复着同样的内容。" voices=""/><msg @l="78" char_id="0" frame_id="-1" name="美帆"   text="(总、总之得找个不碍事的地方站着……)" voices="miho00490"/><msg @l="80" char_id="-1" frame_id="-1" name=""   text="虽然不至于说是人海……但确实很拥挤。" voices=""/><msg @l="81" char_id="-1" frame_id="-1" name=""   text="为了不阻碍人流，我将身体滑向车厢深处，中途发现一个扶手后拼命抓住了它……。" voices=""/><se @l="85" buf="3" loop="true" src="電車走行中" volume="1."/><eval @l="88" expr="s.event5flag=1&#13;&#10;"/><wait_chgmv/><ev @l="92" src="ev-005"/><bgm @l="94" src="bgm07" volume="1."/><msg @l="96" char_id="0" frame_id="-1" name="美帆" text="『……哈。』"   voices="miho00500"/><msg @l="98" char_id="-1" frame_id="-1" name=""   text="电车刚开始行驶，我就深深地叹了口气。" voices=""/><msg @l="99" char_id="-1" frame_id="-1" name=""   text="虽然有一定心理准备，但这种拥挤还是很难受。" voices=""/><msg @l="101" char_id="0" frame_id="-1" name="美帆"   text="(想到每次有第一节课的日子都必须坐这班电车，就觉得好沉重啊……)" voices="miho00510"/><msg @l="103" char_id="0" frame_id="-1" name="美帆"   text="(不过，如果这样能保护自己不被痴汉骚扰，也算是值得的吧)" voices="miho00520"/><msg @l="105" char_id="-1" frame_id="-1" name=""   text="我像是要甩开沉重压在身上的忧郁一样，不断地对自己说道。" voices=""/><msg @l="106" char_id="-1" frame_id="-1" name=""   text="不这么做的话，我没有信心在这种拥挤中安然无恙地坚持下去。" voices=""/><msg @l="107" char_id="-1" frame_id="-1" name=""   text="不……仅仅为了一趟满员电车就谈论生死未免太夸张了吧？虽然这么想，但对我而言，这种拥挤程度确实让人感觉性命攸关。"   voices=""/><msg @l="108" char_id="-1" frame_id="-1" name=""   text="……搞不好会因此休克而死之类的。" voices=""/><msg @l="110" char_id="0" frame_id="-1" name="美帆"   text="(虽然……实际上可能没那么夸张)" voices="miho00530"/><msg @l="112" char_id="0" frame_id="-1" name="美帆"   text="(但是，我就是这么不擅长应对——————啊！)" voices="miho00540"/><se @l="119" buf="1" src="電車の車輪が激しくこすれる音" volume="1."/><msg @l="121" char_id="-1" frame_id="-1" name="" text="可能是遇到了急转弯吧。"   voices=""/><msg @l="122" char_id="-1" frame_id="-1" name=""   text="车厢猛烈晃动，车内一瞬间骚动起来。" voices=""/><msg @l="127" char_id="0" frame_id="-1" name="美帆"   text="(呜啊……这里，每次都会晃动呢……)" voices="miho00550"/><msg @l="129" char_id="-1" frame_id="-1" name=""   text="每当车厢倾斜时，我都拼命抓住扶手支撑着。" voices=""/><msg @l="130" char_id="-1" frame_id="-1" name=""   text="每摇晃一次，前后左右……因为我面前是门，准确地说是后面和左右的人的肩膀或行李毫不客气地撞过来。" voices=""/><msg @l="135" char_id="0" frame_id="-1" name="美帆"   text="(痛……好痛……喂，能不能稍微抵抗一下晃动啊～)" voices="miho00560"/><msg @l="140" char_id="-1" frame_id="-1" name=""   text="在心中发出悲痛的呼喊，我拼命地维持着身体平衡。" voices=""/><stopbgm @l="144" fadeout="1000"/><msg @l="146" char_id="0" frame_id="-1" name="美帆" text="(……嗯？)"   voices="miho00570"/><msg @l="148" char_id="-1" frame_id="-1" name=""   text="我因腰部附近感到的异样皱起了眉头。" voices=""/><msg @l="149" char_id="-1" frame_id="-1" name=""   text="隔着裙子感受到的，仿佛在爬行的手的触感。" voices=""/><bgm @l="153" src="bgm15" volume="1."/><wait_chgmv/><ev @l="157" src="ev-005ax1"/><description @l="160" text="第二次痴汉"/><msg @l="162" char_id="0" frame_id="-1" name="美帆" text="(不会吧……为什么！？)"   voices="miho00580"/><msg @l="164" char_id="-1" frame_id="-1" name="" text="因为太恶心了，我的身体不由得僵硬起来。"   voices=""/><msg @l="165" char_id="-1" frame_id="-1" name="" text="明明坐的是和昨天不同的电车……"   voices=""/><msg @l="166" char_id="-1" frame_id="-1" name=""   text="虽然男性乘客依然较多，但跟昨天不同，女性乘客也有同等数量……" voices=""/><msg @l="168" char_id="0" frame_id="-1" name="美帆"   text="(为什么我又遇到痴汉了啊……)" voices="miho00590"/><msg @l="170" char_id="-1" frame_id="-1" name=""   text="难道真像白石学姐所说的那样，我格外容易被盯上吗……？" voices=""/><msg @l="174" async="true" char_id="-1" frame_id="-1" name=""   text="面对第二次痴汉，我……？" voices=""/><select @l="175"><menu @l="179" label="EventLabel_24" text="进行抵抗"/><menu @l="182" label="EventLabel_25" text="忍耐忍受"/></select><label @l="191" id="EventLabel_24"/><msg @l="194" char_id="-1" frame_id="-1" name=""   text="即使是像我这样畏缩不前的人，也不打算就这样默默忍受痴汉行为。" voices=""/><msg @l="195" char_id="-1" frame_id="-1" name=""   text="毕竟，为了避免痴汉，我才选择了本不想乘坐的拥挤的第二班电车。" voices=""/><msg @l="196" char_id="-1" frame_id="-1" name=""   text="如果现在任由痴汉摆布，那我换电车的意义何在。" voices=""/><msg @l="198" char_id="0" frame_id="-1" name="美帆"   text="(总之得先想办法摆脱放在腰上的手……)" voices="miho00600"/><msg @l="200" char_id="-1" frame_id="-1" name=""   text="我扭动着身体，试图摆脱那爬在腰间的痴汉之手。" voices=""/><msg @l="201" char_id="-1" frame_id="-1" name=""   text="但这种程度的反抗对痴汉来说似乎不算什么，刚觉得甩开了，他的手又立刻缠了上来。"   voices=""/><msg @l="203" char_id="0" frame_id="-1" name="美帆" text="(真是的……快点放弃吧……)"   voices="miho00610"/><msg @l="205" char_id="-1" frame_id="-1" name=""   text="我拼命抵抗，但痴汉完全没有放弃的意思。" voices=""/><msg @l="206" char_id="-1" frame_id="-1" name=""   text="不仅如此……我甚至感觉越是抵抗，他就越是变本加厉。" voices=""/><msg @l="208" char_id="0" frame_id="-1" name="美帆"   text="(呜，为什么会对这种事这么热衷啊……)" voices="miho00620"/><msg @l="210" char_id="-1" frame_id="-1" name=""   text="扭动身体的同时，我的双眼已微微泛起了泪光。" voices=""/><msg @l="211" char_id="-1" frame_id="-1" name=""   text="痴汉的手依然在我的腰间来回抚摸，似乎在寻找机会将手指伸向臀部。" voices=""/><msg @l="212" char_id="-1" frame_id="-1" name=""   text="但除了扭动身体外，我无法做出更多的反抗，" voices=""/><msg @l="213" char_id="-1" frame_id="-1" name=""   text="更何况在这么拥挤的情况下，根本无法逃脱。" voices=""/><msg @l="215" char_id="0" frame_id="-1" name="美帆" text="(这个……适可而止吧)"   voices="miho00630"/><msg @l="217" char_id="-1" frame_id="-1" name=""   text="在极度拥挤和痴汉的纠缠下，我的烦躁感越来越强，终于到了忍无可忍的地步，我几乎是强行扭转身体，试图甩开痴汉的手。"   voices=""/><msg @l="218" char_id="-1" frame_id="-1" name="" text="就在那一瞬间——。" voices=""/><stopbgm @l="222" fadeout="1000"/><msg @l="224" char_id="-1" frame_id="-1" name="痴汉" text="『呃啊。』" voices=""/><msg @l="226" char_id="-1" frame_id="-1" name="" text="可能是甩开时的角度不对。"   voices=""/><msg @l="227" char_id="-1" frame_id="-1" name=""   text="那个痴汉男的手被我的腰部推开，却钩到了旁边乘客肩上挂着的包的钥匙扣。" voices=""/><msg @l="228" char_id="-1" frame_id="-1" name="" text="那个……应该相当疼吧。"   voices=""/><msg @l="230" char_id="0" frame_id="-1" name="美帆" text="(……对、对不起……)"   voices="miho00640"/><msg @l="232" char_id="-1" frame_id="-1" name=""   text="我在心中默默道歉，为了躲避周围的目光而缩小自己的存在感。" voices=""/><msg @l="233" char_id="-1" frame_id="-1" name=""   text="就这样一直到达大学的期间……最终，那个痴汉的手没有再伸过来。" voices=""/><stopse @l="237" buf="3"/><clear @l="242" class="all"/><msgshow @l="244" show="true"/><goto @l="247" label="EventLabel_26"/><label @l="251" id="EventLabel_25"/><msg @l="254" char_id="0" frame_id="-1" name="美帆"   text="(即使想反抗……这样……嗯，根本动弹不得……)" voices="miho00650"/><msg @l="256" char_id="0" frame_id="-1" name="美帆"   text="(果然……只能……忍耐吗………)" voices="miho00660"/><msg @l="258" char_id="-1" frame_id="-1" name="" text="今天车厢内比昨天更加拥挤。"   voices=""/><msg @l="259" char_id="-1" frame_id="-1" name=""   text="在这种环境下想要反抗，最多也只能扭动身体，别无他法。" voices=""/><msg @l="260" char_id="-1" frame_id="-1" name="" text="而且……。" voices=""/><msg @l="262" char_id="0" frame_id="-1" name="美帆"   text="(在这种满员的车厢里闹起来，反而会引起奇怪的传闻……)" voices="miho00670"/><msg @l="264" char_id="-1" frame_id="-1" name=""   text="我紧紧闭上眼睛，拼命忍受着那只在腰间爬行的令人恶心的感觉。" voices=""/><msg @l="266" char_id="-1" frame_id="-1" name="" text="咕啾。" voices=""/><msg @l="268" char_id="-1" frame_id="-1" name=""   text="痴汉仿佛在享受臀部的丰满感，上下抬动着，充分地品味着年轻所拥有的弹性。" voices=""/><msg @l="270" char_id="0" frame_id="-1" name="美帆" text="『……。』"   voices="miho00420"/><wait_chgmv/><ev @l="275" src="ev-005ax2y1"/><msg @l="277" char_id="-1" frame_id="-1" name=""   text="就这样忍受着那只在腰间蠕动如同蜈蚣般的手时，它爬到了胸部，突然隔着胸罩抓住了我的胸部。"   voices=""/><msg @l="279" char_id="0" frame_id="-1" name="美帆" text="『…………。』"   voices="miho09930"/><msg @l="281" char_id="-1" frame_id="-1" name=""   text="不谙男人的处女的胸部，因为被粗暴抓住的疼痛，以及那蠕动着的生物般的恶心感，微微渗出了汗水。" voices=""/><msg @l="282" char_id="-1" frame_id="-1" name=""   text="面对这种羞辱的行为，我只能屏住呼吸忍耐着。" voices=""/><msg @l="283" char_id="-1" frame_id="-1" name=""   text="电车才刚刚离开车站……。" voices=""/><msg @l="284" char_id="-1" frame_id="-1" name=""   text="想到还要忍受这种恶心感近30分钟，我感到头晕目眩。" voices=""/><msg @l="285" char_id="-1" frame_id="-1" name="" text="摸、摸、摸。" voices=""/><msg @l="287" char_id="0" frame_id="-1" name="美帆" text="『……啊……。』"   voices="miho00680"/><msg @l="289" char_id="-1" frame_id="-1" name=""   text="痴汉把另一只手移向了由鲜明双球形成的臀部。" voices=""/><msg @l="290" char_id="-1" frame_id="-1" name=""   text="那一瞬间，我不小心发出了微弱的羞耻声音，脸颊到耳朵变得通红，慌忙紧紧闭上了嘴。" voices=""/><goto @l="293" cond="!(f.痴漢flag&#32;==&#32;1)&#13;&#10;"   label="TempLabel_158"/><msg @l="295" char_id="-1" frame_id="-1" name="痴汉"   text="『今天也打算不反抗就这样忍耐吗？真是难得啊。』" voices=""/><msg @l="300" char_id="0" frame_id="-1" name="美帆" text="『……！？』"   voices="miho00690"/><msg @l="302" char_id="-1" frame_id="-1" name="" text="耳边传来的挑衅低语。"   voices=""/><msg @l="303" char_id="-1" frame_id="-1" name=""   text="那声音和昨天那个痴汉的声音一模一样，让人无法忘记。" voices=""/><msg @l="305" char_id="0" frame_id="-1" name="美帆" text="『为…什么……？』"   voices="miho00700"/><msg @l="307" char_id="-1" frame_id="-1" name="痴汉"   text="『我不是说过期待后续吗……？』" voices=""/><msg @l="309" char_id="-1" frame_id="-1" name=""   text="痴汉一边说着下流的话，一边用抚摸着成熟桃形臀部的手指勒紧内裤的布料，猛地往上拉。"   voices=""/><msg @l="311" char_id="0" frame_id="-1" name="美帆" text="『嗯……。』"   voices="miho10450"/><msg @l="313" char_id="-1" frame_id="-1" name=""   text="内裤被勒成了一根像兜裆布一样的绳子，嵌入臀缝，压迫着秘处。" voices=""/><msg @l="314" char_id="-1" frame_id="-1" name="" text="在这股力量下，女性的花唇完全张开了。"   voices=""/><msg @l="316" char_id="0" frame_id="-1" name="美帆" text="『……。』"   voices="miho00420"/><msg @l="318" char_id="-1" frame_id="-1" name="痴汉"   text="『呵呵呵……。内裤似乎已经充分嵌入阴部了呢。』" voices=""/><msg @l="320" char_id="0" frame_id="-1" name="美帆" text="『……！？』"   voices="miho00690"/><wait_chgmv/><ev @l="324" src="ev-005ax3y2"/><msg @l="326" char_id="-1" frame_id="-1" name="" text="滑溜。" voices=""/><msg @l="327" char_id="-1" frame_id="-1" name=""   text="痴汉边说着，边将原本拉扯内裤的手伸进了裙子里。" voices=""/><msg @l="329" char_id="0" frame_id="-1" name="美帆" text="『唔……。』"   voices="miho00400"/><msg @l="331" char_id="-1" frame_id="-1" name=""   text="他就像是在给自己奖励一般，将手移向了她白皙的大腿。" voices=""/><msg @l="333" char_id="0" frame_id="-1" name="美帆" text="『……。』"   voices="miho00420"/><msg @l="335" char_id="-1" frame_id="-1" name="" text="我因为这触感而身体猛地颤抖了一下。"   voices=""/><msg @l="336" char_id="-1" frame_id="-1" name="" text="摸、摸、摸。" voices=""/><msg @l="338" char_id="-1" frame_id="-1" name="痴汉" text="『呵呵，你的大腿真是滑溜溜的呢。』"   voices=""/><msg @l="341" char_id="-1" frame_id="-1" name=""   text="痴汉高兴地上下轻轻抚摸着因恐惧而颤抖的我的大腿。" voices=""/><msg @l="342" char_id="0" frame_id="-1" name="美帆" text="『……唔……。』"   voices="miho00430"/><msg @l="344" char_id="-1" frame_id="-1" name="痴汉"   text="『啊啊……，简直像是吸附在手上一样。太美妙了……。』" voices=""/><msg @l="346" char_id="-1" frame_id="-1" name=""   text="痴汉发出的甜美叹息喷在我的后颈上，让我的额头上冒出了更多的大颗汗珠。" voices=""/><msg @l="348" char_id="0" frame_id="-1" name="美帆" text="『不……请停下来……。』"   voices="miho00710"/><msg @l="350" char_id="-1" frame_id="-1" name="痴汉"   text="你真的想让我停下来吗？如果讨厌的话，不妨大声喊出来试试？" voices=""/><msg @l="352" char_id="-1" frame_id="-1" name="" text="痴汉仿佛看穿了我的心思，这样说着笑了。"   voices=""/><msg @l="354" char_id="0" frame_id="-1" name="美帆" text="『……。』"   voices="miho09880"/><msg @l="356" char_id="-1" frame_id="-1" name=""   text="大声呼喊的确可以中断痴汉的行为。" voices=""/><msg @l="357" char_id="-1" frame_id="-1" name=""   text="但那样的话，就等于向其他乘客宣告自己正在被痴汉骚扰。而且还会在陌生人面前暴露自己被痴汉骚扰的羞耻模样。"   voices=""/><msg @l="359" char_id="0" frame_id="-1" name="美帆" text="『大声什么的……』"   voices="miho00720"/><msg @l="361" char_id="-1" frame_id="-1" name="痴汉"   text="『哦，也就是说你愿意任我摆布咯？』" voices=""/><msg @l="363" char_id="0" frame_id="-1" name="美帆" text="『那、那是……』"   voices="miho00730"/><msg @l="365" char_id="-1" frame_id="-1" name=""   text="当然我并不打算任由痴汉摆布。" voices=""/><msg @l="366" char_id="-1" frame_id="-1" name=""   text="我只是不想被传出被痴汉骚扰的谣言，不想在众人面前露出羞耻的样子罢了。" voices=""/><msg @l="367" char_id="-1" frame_id="-1" name="" text="可是……却无法明确地否认。"   voices=""/><msg @l="368" char_id="-1" frame_id="-1" name=""   text="事到如今，无论说什么，都无法改变我为了不被周围的人知道而选择不反抗痴汉行为这一事实……。"   voices=""/><msg @l="370" char_id="-1" frame_id="-1" name="痴汉"   text="『呵呵……果然，你有受虐的潜质。』" voices=""/><msg @l="372" char_id="-1" frame_id="-1" name=""   text="痴汉仿佛自言自语般地满意地嘀咕着，随后更加紧密地贴近我的身体，将原本在大腿上抚摸的手伸进了我的内侧大腿。"   voices=""/><msg @l="373" char_id="-1" frame_id="-1" name="" text="动，动，动。" voices=""/><msg @l="375" char_id="0" frame_id="-1" name="美帆" text="『……唔……。』"   voices="miho09930"/><msg @l="377" char_id="-1" frame_id="-1" name=""   text="痴汉的食指和中指开始在大腿内侧上下摩擦。" voices=""/><msg @l="378" char_id="-1" frame_id="-1" name=""   text="他的手沿着白皙湿润的内侧大腿柔软的肌肤，逐渐向上移动。" voices=""/><msg @l="379" char_id="-1" frame_id="-1" name="" text="不要把手往上移……。"   voices=""/><msg @l="380" char_id="-1" frame_id="-1" name=""   text="……但我的愿望落空了，他的食指和中指已经到达了内裤的边缘。" voices=""/><msg @l="381" char_id="-1" frame_id="-1" name="" text="紧。" voices=""/><msg @l="382" char_id="-1" frame_id="-1" name=""   text="我因为恶心感，一下子加大了抓住扶手的力度。" voices=""/><msg @l="383" char_id="-1" frame_id="-1" name="" text="即便如此，痴汉的行为仍在继续。"   voices=""/><msg @l="384" char_id="-1" frame_id="-1" name="" text="摸，摸，摸。" voices=""/><msg @l="386" char_id="0" frame_id="-1" name="美帆" text="『……嗯……。』"   voices="miho00430"/><msg @l="388" char_id="-1" frame_id="-1" name=""   text="两根手指开始用指尖沿着内裤边缘轻划。然后，逐渐将目标转向私处。" voices=""/><msg @l="389" char_id="-1" frame_id="-1" name=""   text="痴汉一下子触碰到内裤的中心，隔着布料沿着那里的缝隙游走着手指。" voices=""/><msg @l="391" char_id="0" frame_id="-1" name="美帆" text="『……呀……。』"   voices="miho00740"/><msg @l="393" char_id="-1" frame_id="-1" name=""   text="我条件反射地紧紧并拢双腿，试图拒绝他的侵入。" voices=""/><msg @l="394" char_id="-1" frame_id="-1" name=""   text="但痴汉并没有停止手上的动作，反而像是抓住了“机会”一样，将另一只手也伸进了我的裙子里。"   voices=""/><msg @l="395" char_id="-1" frame_id="-1" name="" text="揉。" voices=""/><msg @l="397" char_id="0" frame_id="-1" name="美帆" text="『唔啊！』"   voices="miho00450"/><msg @l="399" char_id="-1" frame_id="-1" name=""   text="伸进裙子的手，从臀部的缝隙处一路爬行，向后面的那个洞口移动。" voices=""/><msg @l="401" char_id="0" frame_id="-1" name="美帆" text="『呃！』"   voices="miho00750"/><msg @l="403" char_id="-1" frame_id="-1" name=""   text="我不禁屏住呼吸，紧闭臀部试图拒绝入侵者。" voices=""/><msg @l="404" char_id="-1" frame_id="-1" name=""   text="然而痴汉的指尖却像是强行分开柔软的臀肉一般继续前进，开始抚弄玩弄后面的菊花。瞬间，一股寒意窜上我的脊背。"   voices=""/><msg @l="406" char_id="0" frame_id="-1" name="美帆" text="『……唔……。』"   voices="miho09930"/><msg @l="408" char_id="-1" frame_id="-1" name="痴汉"   text="『哎呀哎呀，一阵阵地抽动……看来这里也相当敏感嘛。』" voices=""/><msg @l="410" char_id="0" frame_id="-1" name="美帆" text="『不，不是的！』"   voices="miho00760"/><msg @l="412" char_id="-1" frame_id="-1" name="痴汉"   text="『那么……两边一起疼爱一下如何？』" voices=""/><msg @l="414" char_id="0" frame_id="-1" name="美帆" text="『诶……？』"   voices="miho00770"/><msg @l="416" char_id="-1" frame_id="-1" name=""   text="左手分开柔软的臀肉，像按摩一般抚摸着后方那个仿佛被细线紧紧系住的菊穴。" voices=""/><msg @l="417" char_id="-1" frame_id="-1" name=""   text="右手则隔着内裤弹拨那个私处的凸起，给予强烈的刺激。" voices=""/><msg @l="418" char_id="-1" frame_id="-1" name="" text="啵啵。" voices=""/><msg @l="420" char_id="0" frame_id="-1" name="美帆" text="『嘶！！』"   voices="miho00780"/><msg @l="422" char_id="-1" frame_id="-1" name=""   text="我再次——倒吸一口气。前后两边同时被侵入，被抬起般的姿势下不断地接受着刺激。" voices=""/><msg @l="423" char_id="-1" frame_id="-1" name=""   text="不知是寒意还是不快感亦或是快感，一种连我自己都不太明白的“什么”麻酥酥地迅速贯穿了我的全身。" voices=""/><msg @l="425" char_id="-1" frame_id="-1" name="痴汉"   text="『呵呵，舒服得连腰都跳起来了吗。』" voices=""/><msg @l="427" char_id="0" frame_id="-1" name="美帆" text="『不……才没有那种事……。』"   voices="miho00790"/><msg @l="429" char_id="-1" frame_id="-1" name=""   text="我知道此刻应该说“不是这样”。" voices=""/><msg @l="430" char_id="-1" frame_id="-1" name="" text="但是，却说不出话来。"   voices=""/><msg @l="431" char_id="-1" frame_id="-1" name="" text="呼吸变得急促起来。" voices=""/><msg @l="432" char_id="-1" frame_id="-1" name=""   text="明明是自己的身体……却感到头脑昏沉，不知所措。" voices=""/><msg @l="434" char_id="-1" frame_id="-1" name="痴汉"   text="『那么，什么是“那种事”呢？』" voices=""/><msg @l="436" char_id="-1" frame_id="-1" name="" text="他是看穿了吗？"   voices=""/><msg @l="437" char_id="-1" frame_id="-1" name=""   text="仿佛看透了我模糊不清的内心，他向我投来追问的话语。" voices=""/><msg @l="438" char_id="-1" frame_id="-1" name="" text="不想被触碰。" voices=""/><msg @l="439" char_id="-1" frame_id="-1" name="" text="那里……明明不想被触碰的。"   voices=""/><msg @l="441" char_id="0" frame_id="-1" name="美帆" text="『那、那是……』"   voices="miho00800"/><msg @l="443" char_id="-1" frame_id="-1" name="痴汉" text="『……呵呵。』" voices=""/><msg @l="445" char_id="-1" frame_id="-1" name=""   text="当我语塞困惑之际，痴汉将脸凑近我的耳边，喷出他那中年人特有的难闻气息。" voices=""/><msg @l="446" char_id="-1" frame_id="-1" name=""   text="我本能地想要逃跑，但被禁锢在墙壁和痴汉之间的狭小空间里，几乎无法动弹。" voices=""/><msg @l="447" char_id="-1" frame_id="-1" name=""   text="痴汉露出一丝意味深长的笑容，灵巧地移动手指，捏住阴唇并左右拨弄着打开。" voices=""/><msg @l="448" char_id="-1" frame_id="-1" name="" text="咕啾，咕啾。" voices=""/><msg @l="450" char_id="0" frame_id="-1" name="美帆" text="『嗯……』"   voices="miho10450"/><msg @l="452" char_id="-1" frame_id="-1" name=""   text="他的其余手指蠕动着，在缝隙上方那颗小珍珠上画圈揉搓。" voices=""/><msg @l="454" char_id="0" frame_id="-1" name="美帆" text="『嗯……』"   voices="miho00810"/><msg @l="456" char_id="-1" frame_id="-1" name=""   text="我含着泪水，拼命忍住即将脱口而出的声音，腰部颤抖着承受着这一切。" voices=""/><msg @l="458" char_id="-1" frame_id="-1" name="痴汉" text="『你这里真是太柔软啊——』"   voices=""/><msg @l="460" char_id="-1" frame_id="-1" name="" text="咕叽，咕啾，咕叽。"   voices=""/><msg @l="462" char_id="0" frame_id="-1" name="美帆" text="『不要……那里是……』"   voices="miho00410"/><msg @l="464" char_id="-1" frame_id="-1" name=""   text="我拼命收紧臀部以忍耐，但当痴汉的指尖分开柔媚的花瓣，潜入狭窄的甬道时，一种难以言喻的感觉在腰间闷烧又消散。"   voices=""/><msg @l="465" char_id="-1" frame_id="-1" name=""   text="美帆的大腿内侧已经冒出汗水，浸湿了内裤。" voices=""/><msg @l="467" char_id="-1" frame_id="-1" name="痴汉"   text="『看，你这里已经变得这么硬了呢。』" voices=""/><msg @l="469" char_id="-1" frame_id="-1" name="" text="咕里，咕里，咕里。" voices=""/><msg @l="471" char_id="0" frame_id="-1" name="美帆" text="『……呀……。』"   voices="miho00740"/><msg @l="473" char_id="-1" frame_id="-1" name=""   text="痴汉故意隔着内裤揉搓包裹在包皮中的肉芽，同时在耳边低语。" voices=""/><msg @l="474" char_id="-1" frame_id="-1" name=""   text="确实，我的那里……连我自己都吃惊，竟然变得如此硬挺敏感。" voices=""/><msg @l="475" char_id="0" frame_id="-1" name="美帆"   text="(为什么……明明很恶心……为什么会变成这样……)" voices="miho00820"/><msg @l="477" char_id="0" frame_id="-1" name="美帆"   text="(……不行……这种……快要站不住了……)" voices="miho00830"/><msg @l="479" char_id="-1" frame_id="-1" name="" text="腰部麻痹，双腿使不上力气。"   voices=""/><msg @l="480" char_id="-1" frame_id="-1" name=""   text="腰已经抖得无法自己站立，不知不觉中反而像是把身体托付给了痴汉的姿势。" voices=""/><msg @l="482" char_id="-1" frame_id="-1" name="痴汉"   text="『怎么了……就这样去也没关系哦？』" voices=""/><msg @l="484" char_id="-1" frame_id="-1" name=""   text="说起来，我并不明白“高潮”是怎样的一种感觉。" voices=""/><msg @l="485" char_id="-1" frame_id="-1" name="" text="自慰的经验……是有的。"   voices=""/><msg @l="486" char_id="-1" frame_id="-1" name=""   text="一周一次……不，频率可能更低些。" voices=""/><msg @l="487" char_id="-1" frame_id="-1" name=""   text="只是，每次都在达到“高潮”之前就停下了。" voices=""/><msg @l="488" char_id="-1" frame_id="-1" name="" text="总觉得有些害怕。" voices=""/><msg @l="489" char_id="-1" frame_id="-1" name=""   text="或许可以说是对未知的自己的一种恐惧吧。" voices=""/><msg @l="490" char_id="-1" frame_id="-1" name="" text="但是……。" voices=""/><msg @l="491" char_id="-1" frame_id="-1" name=""   text="但在这种情况下，那些“恐惧”和“抵抗”完全没有任何作用。" voices=""/><msg @l="492" char_id="-1" frame_id="-1" name=""   text="我只是被痴汉任意凌辱着。" voices=""/><msg @l="494" char_id="0" frame_id="-1" name="美帆" text="『……唔……。』"   voices="miho00840"/><msg @l="496" char_id="-1" frame_id="-1" name="" text="我轻轻地漏出一声喘息。"   voices=""/><msg @l="497" char_id="-1" frame_id="-1" name=""   text="痴汉猛烈摩擦着阴道内的敏感点，扭曲了裙子，把腰贴了过来。" voices=""/><msg @l="498" char_id="-1" frame_id="-1" name="" text="咚，咚，咚。" voices=""/><msg @l="499" char_id="-1" frame_id="-1" name=""   text="臀部感受到了一种像是带着脉动热量的棒状物的触感。" voices=""/><msg @l="501" char_id="0" frame_id="-1" name="美帆" text="『嗯！』"   voices="miho00450"/><msg @l="503" char_id="-1" frame_id="-1" name=""   text="我也有一定的性知识。我脑子里也明白抵在腰上的东西是充血完全勃起的阴茎。" voices=""/><msg @l="504" char_id="-1" frame_id="-1" name=""   text="但这种想法也被痴汉玩弄女阴的手指动作抹消了。" voices=""/><msg @l="505" char_id="-1" frame_id="-1" name="" text="咕啾，咕啾，姆啾。"   voices=""/><msg @l="507" char_id="0" frame_id="-1" name="美帆" text="『…唔……。』"   voices="miho09930"/><msg @l="509" char_id="-1" frame_id="-1" name=""   text="由于阴蒂被玩弄而变得发热的下半身麻痹感，正在一点点增强。" voices=""/><msg @l="511" char_id="0" frame_id="-1" name="美帆"   text="(……我……被痴汉弄得快要高潮了……)" voices="miho00850"/><msg @l="513" char_id="0" frame_id="-1" name="美帆"   text="(自己做的时候……都从来没有高潮过……)" voices="miho00860"/><msg @l="515" char_id="0" frame_id="-1" name="美帆"   text="(………好像……就这样………)" voices="miho00870"/><msg @l="517" char_id="-1" frame_id="-1" name=""   text="我在呼气的瞬间，不由自主地稍微放松了身体。" voices=""/><msg @l="518" char_id="-1" frame_id="-1" name=""   text="那一刻，“无所谓了”……这样的想法闪过脑海。" voices=""/><msg @l="519" char_id="-1" frame_id="-1" name="" text="感觉和自暴自弃有些不同。"   voices=""/><msg @l="520" char_id="-1" frame_id="-1" name=""   text="只是那种缓缓扩散的向某处攀升的感觉。" voices=""/><msg @l="521" char_id="-1" frame_id="-1" name=""   text="被那种如果就这样攀上顶峰就会轻松了……的想法所俘虏。" voices=""/><msg @l="522" char_id="-1" frame_id="-1" name=""   text="痴汉没有放过我放松的那一瞬间，试图将手指伸入秘裂之中……就在那一刻———。" voices=""/><stopbgm @l="526" fadeout="1000"/><clear @l="532" class="all"/><msg @l="534" char_id="-1" frame_id="-1" name="广播"   text="『下一站是终点站……大学前，大学前站。』" voices=""/><msg @l="536" char_id="-1" frame_id="-1" name="广播"   text="『请注意不要遗忘您的随身物品。』" voices=""/><msg @l="538" char_id="0" frame_id="-1" name="美帆" text="『啊……。』"   voices="miho00880"/><msg @l="540" char_id="-1" frame_id="-1" name="" text="广播响起，车厢内开始变得嘈杂起来。"   voices=""/><msg @l="541" char_id="-1" frame_id="-1" name=""   text="回过神来，窗外已经能看到大学校舍，不到一分钟就要到站了。" voices=""/><msg @l="542" char_id="-1" frame_id="-1" name="" text="某种感觉……一下子冷却下来。"   voices=""/><msg @l="543" char_id="-1" frame_id="-1" name=""   text="就像正沉浸在电影中途突然播放熟悉广告时那样，猛地被拉回现实的感觉。" voices=""/><msg @l="545" char_id="-1" frame_id="-1" name="痴汉" text="『……啧。』" voices=""/><msg @l="547" char_id="-1" frame_id="-1" name="" text="听到了痴汉明显的咂舌声。"   voices=""/><msg @l="548" char_id="-1" frame_id="-1" name=""   text="就这样，痴汉的手从裙子里缓缓抽出。" voices=""/><msg @l="550" char_id="-1" frame_id="-1" name="痴汉"   text="『……下次一定会让你好好去的，仲根美帆君。』" voices=""/><msg @l="552" char_id="0" frame_id="-1" name="美帆" text="『诶————！？』"   voices="miho00890"/><msg @l="554" char_id="-1" frame_id="-1" name=""   text="痴汉在近得能感受到呼吸的距离低语着，随后背后传来了人移动的气息。" voices=""/><msg @l="555" char_id="-1" frame_id="-1" name="" text="恐怕……是逃走了吧。"   voices=""/><eval @l="558" expr="f.名前を知られてるflag&#32;+=&#32;1&#13;&#10;"/><clear @l="565" class="all"/><msg @l="567" char_id="0" frame_id="-1" name="美帆" text="(……为什么会知道我的名字……)"   voices="miho00900"/><msg @l="569" char_id="0" frame_id="-1" name="美帆"   text="(……不要……好可怕………)" voices="miho00910"/><stopse @l="573" buf="3"/><se @l="577" buf="1" src="電車停車" volume="1."/><msg @l="579" char_id="-1" frame_id="-1" name=""   text="电车停了下来，人们陆续下车中……。" voices=""/><msg @l="580" char_id="-1" frame_id="-1" name=""   text="我因为脊背都冻僵的恐惧……而不停颤抖着。" voices=""/><eval @l="583" expr="f.痴漢flag&#32;+=&#32;1&#13;&#10;"/><goto @l="586" label="TempLabel_159"/><label @l="587" id="TempLabel_158"/><msg @l="590" char_id="-1" frame_id="-1" name="痴汉" text="『哎呀，今天不反抗了吗。』"   voices=""/><msg @l="592" char_id="0" frame_id="-1" name="美帆" text="『……！？』"   voices="miho00920"/><msg @l="594" char_id="-1" frame_id="-1" name=""   text="突然，身后疑似痴汉的男人凑到我耳边低语。" voices=""/><msg @l="595" char_id="-1" frame_id="-1" name=""   text="我因过度惊讶想要转身，但在这样拥挤的环境中，连这个动作都很困难。" voices=""/><msg @l="596" char_id="-1" frame_id="-1" name=""   text="无奈之下，我只能转动脖子想看看身后，但以我的身高，最多只能勉强看到身后男人的胸口到下巴。"   voices=""/><msg @l="598" char_id="-1" frame_id="-1" name="痴汉"   text="『这么拥挤。我觉得你最好不要太激动。』" voices=""/><msg @l="600" char_id="-1" frame_id="-1" name="" text="男人俯下身子，在我耳边低语。"   voices=""/><msg @l="601" char_id="-1" frame_id="-1" name=""   text="那一刻，后颈感受到中年人特有的臭气，为了躲避那气味，我的身体不由自主地向前倾。" voices=""/><msg @l="602" char_id="-1" frame_id="-1" name="" text="碰触。" voices=""/><msg @l="604" char_id="0" frame_id="-1" name="美帆" text="『……啊……。』"   voices="miho00840"/><msg @l="606" char_id="-1" frame_id="-1" name=""   text="就在那一瞬间，我不小心做出了翘起臀部的姿势，痴汉用手掌抚摸着我翘起的臀部。" voices=""/><msg @l="607" char_id="-1" frame_id="-1" name=""   text="他像是在享受臀部的丰满感一般，上下抬动着，充分地享受着青春所具有的弹性。" voices=""/><msg @l="609" char_id="0" frame_id="-1" name="美帆"   text="『你……为什么要做这种事……。』" voices="miho00930"/><msg @l="611" char_id="-1" frame_id="-1" name="痴汉"   text="『因为你的身体在诱惑我啊。』" voices=""/><msg @l="613" char_id="0" frame_id="-1" name="美帆" text="『请不要取笑我！』"   voices="miho00940"/><msg @l="615" char_id="-1" frame_id="-1" name=""   text="不经意间语气变得强硬，周围的人们都朝这边投来目光。" voices=""/><msg @l="616" char_id="-1" frame_id="-1" name=""   text="我慌忙闭上嘴低下头……但那些目光依然让我感到刺痛。" voices=""/><msg @l="617" char_id="-1" frame_id="-1" name=""   text="我感到极度羞耻，与意愿相反，脸变得通红。" voices=""/><msg @l="619" char_id="-1" frame_id="-1" name="痴汉"   text="『还是不要太激动为好吧。你不想让别人知道你正在被痴汉骚扰吧？』" voices=""/><msg @l="621" char_id="0" frame_id="-1" name="美帆" text="『……。』"   voices="miho00950"/><msg @l="623" char_id="-1" frame_id="-1" name=""   text="痴汉让我沉默后，用那只抚摸着如成熟蜜桃般臀部的手指拉紧内裤的布料，猛地向上提。" voices=""/><msg @l="625" char_id="0" frame_id="-1" name="美帆" text="『……呀……。』"   voices="miho00740"/><msg @l="627" char_id="-1" frame_id="-1" name=""   text="内裤变成了一根像兜裆布一样的绳子，深深陷入臀缝，压迫着私密部位。" voices=""/><msg @l="628" char_id="-1" frame_id="-1" name="" text="在这股力量下，女性的唇瓣完全被打开了。"   voices=""/><msg @l="630" char_id="0" frame_id="-1" name="美帆" text="『……唔……。』"   voices="miho01620"/><msg @l="632" char_id="-1" frame_id="-1" name="痴汉"   text="『对，如果不想引人注目的话就应该这样保持沉默。特别是像你这样在意外表的孩子。』" voices=""/><msg @l="634" char_id="-1" frame_id="-1" name=""   text="他一边说着，一边淫笑着将原本抚摸臀部的手滑进了裙子里。" voices=""/><wait_chgmv/><ev @l="638" src="ev-005ax3y2"/><msg @l="640" char_id="0" frame_id="-1" name="美帆" text="『……唔……。』"   voices="miho00960"/><msg @l="642" char_id="-1" frame_id="-1" name=""   text="我差点不自觉地发出声音，慌忙间把话语咽了回去。" voices=""/><msg @l="643" char_id="-1" frame_id="-1" name=""   text="刚才的失误已经引起了周围人的注意，如果这时再发出声音的话就更会成为关注的焦点。" voices=""/><msg @l="644" char_id="-1" frame_id="-1" name=""   text="被人知道正在遭受痴汉骚扰，是我无论如何都想避免的。" voices=""/><msg @l="645" char_id="-1" frame_id="-1" name=""   text="更别说那种羞耻的情况被许多不相识的人目睹，这是我无法忍受的。" voices=""/><msg @l="646" char_id="-1" frame_id="-1" name=""   text="这么想着，我完全发不出声音，身体也动弹不得了。" voices=""/><msg @l="648" char_id="-1" frame_id="-1" name="痴汉" text="『呵呵……明智的判断。』"   voices=""/><msg @l="650" char_id="-1" frame_id="-1" name="痴汉"   text="『安分一会儿的话，我会让你「舒服」的。』" voices=""/><msg @l="652" char_id="-1" frame_id="-1" name="" text="摸，摸，摸。" voices=""/><msg @l="654" char_id="0" frame_id="-1" name="美帆" text="『……呃……。』"   voices="miho00430"/><msg @l="656" char_id="-1" frame_id="-1" name=""   text="痴汉说着笑了起来，食指和中指开始上下摩擦着大腿内侧。" voices=""/><msg @l="657" char_id="-1" frame_id="-1" name=""   text="他的手像是沿着白皙湿润的大腿内侧柔软肌肤游走，逐渐向上移动。" voices=""/><msg @l="658" char_id="-1" frame_id="-1" name="" text="不要把手往上移……。"   voices=""/><msg @l="659" char_id="-1" frame_id="-1" name=""   text="……那愿望也是徒劳，食指和中指已经到达了内裤的边缘。" voices=""/><msg @l="660" char_id="-1" frame_id="-1" name="" text="咕啾。" voices=""/><msg @l="662" char_id="0" frame_id="-1" name="美帆" text="『唔！！』"   voices="miho00450"/><msg @l="664" char_id="-1" frame_id="-1" name=""   text="手指接触内裤的瞬间，我试图抬起腰部逃离，但痴汉灵巧的指尖不想放过我，一下子就伸了进来，隔着内裤直接揉弄起我的私处。"   voices=""/><msg @l="665" char_id="-1" frame_id="-1" name="" text="咕啾，唔啾。" voices=""/><msg @l="667" char_id="0" frame_id="-1" name="美帆" text="『呃……』"   voices="miho00400"/><msg @l="669" char_id="-1" frame_id="-1" name=""   text="我被前后夹击成三明治状态，两只手黏腻地触摸着我的私处。" voices=""/><msg @l="671" char_id="0" frame_id="-1" name="美帆"   text="(……为什么会变成这样……)" voices="miho00970"/><msg @l="673" char_id="0" frame_id="-1" name="美帆"   text="(明明为了避免遇到痴汉连电车都换了……)" voices="miho00980"/><msg @l="675" char_id="-1" frame_id="-1" name=""   text="想想看，为什么总是我被痴汉盯上呢。" voices=""/><msg @l="676" char_id="-1" frame_id="-1" name=""   text="就算再怎么是容易被痴汉利用的极度害羞性格，难道真的会这么频繁地被盯上吗？" voices=""/><msg @l="677" char_id="-1" frame_id="-1" name=""   text="我的身体是不是天生就招男人喜欢呢……这种事我可不愿意……。" voices=""/><msg @l="679" char_id="0" frame_id="-1" name="美帆"   text="(说起来刚才他是不是说了“今天不反抗吗”之类的话？)" voices="miho00990"/><msg @l="681" char_id="0" frame_id="-1" name="美帆"   text="(那就是说……他知道我昨天遭遇了痴汉，而且还反抗了？)" voices="miho01000"/><msg @l="683" char_id="0" frame_id="-1" name="美帆" text="(……难道说……？)"   voices="miho01010"/><msg @l="685" char_id="-1" frame_id="-1" name=""   text="突然浮现的想法与奇妙的巧合相符，让我的背脊更加发凉。" voices=""/><msg @l="687" char_id="0" frame_id="-1" name="美帆" text="『……你是……昨天的痴汉……吗？』"   voices="miho01020"/><msg @l="689" char_id="-1" frame_id="-1" name="痴汉" text="『呵呵，终于明白了吗。』"   voices=""/><msg @l="691" char_id="-1" frame_id="-1" name=""   text="痴汉满意地回答我的低语，笑了起来。" voices=""/><msg @l="692" char_id="-1" frame_id="-1" name=""   text="也就是说，车厢里女性比例从一开始就无关紧要。" voices=""/><msg @l="693" char_id="-1" frame_id="-1" name=""   text="痴汉……从一开始就盯上了我。" voices=""/><msg @l="695" char_id="0" frame_id="-1" name="美帆"   text="『为什么……你怎么知道我今天会坐这趟电车？』" voices="miho01030"/><msg @l="697" char_id="-1" frame_id="-1" name="痴汉"   text="『考虑到你的性格，我想你不会坐昨天同一班电车吧。呵呵呵，真是完全按照我的预想行动呢。』" voices=""/><msg @l="699" char_id="0" frame_id="-1" name="美帆" text="『……。』"   voices="miho01040"/><msg @l="701" char_id="-1" frame_id="-1" name=""   text="确实，因为遭遇了痴汉而换乘电车，这或许是再正常不过的事情了。" voices=""/><msg @l="702" char_id="-1" frame_id="-1" name=""   text="而且能赶上第一节课的电车只有两趟，所以即使随便乘坐，也有二分之一的几率会遇到。" voices=""/><msg @l="704" char_id="0" frame_id="-1" name="美帆"   text="『那么……你怎么知道我会坐这趟电车？』" voices="miho01050"/><msg @l="706" char_id="-1" frame_id="-1" name="痴汉"   text="『如果坐下一班电车的话，你会迟到第一节课吧，仲根美帆同学。』" voices=""/><msg @l="707" char_id="0" frame_id="-1" name="美帆" text="『——————！？』"   voices="miho01060"/><msg @l="709" char_id="0" frame_id="-1" name="美帆" text="『关于我……为什么……？』"   voices="miho01070"/><msg @l="711" char_id="-1" frame_id="-1" name="痴汉"   text="『哦，你想知道对你实施痴汉行为的人是谁吗？这是不是意味着你想被更多地骚扰，想被玩弄身体呢。』"   voices=""/><msg @l="713" char_id="-1" frame_id="-1" name=""   text="色狼这样说着再次隔着内裤抓住她的臀部，将手指强行挤入臀缝，试图从后面玩弄她的私处。"   voices=""/><msg @l="714" char_id="-1" frame_id="-1" name=""   text="她拼命收紧臀部试图抵抗，但当色狼的手指拨开柔嫩的花瓣，潜入狭窄的甬道时，一种难以言喻的感觉在腰间燃起又消失。"   voices=""/><msg @l="715" char_id="-1" frame_id="-1" name=""   text="美帆的大腿内侧冒出汗水，浸湿了内裤。" voices=""/><msg @l="717" char_id="0" frame_id="-1" name="美帆" text="『嗯嗯！』"   voices="miho10930"/><msg @l="719" char_id="-1" frame_id="-1" name=""   text="色狼猛烈摩擦着她阴道的敏感点，扭曲了裙子，将腰紧紧压了上来。" voices=""/><msg @l="720" char_id="-1" frame_id="-1" name="" text="咚，咚，咚。" voices=""/><msg @l="722" char_id="0" frame_id="-1" name="美帆" text="『……呃啊……。』"   voices="miho00430"/><msg @l="724" char_id="-1" frame_id="-1" name=""   text="她的臀部感受到一种跳动着的灼热棒状物。" voices=""/><msg @l="725" char_id="-1" frame_id="-1" name=""   text="我也有一定的性知识。我脑子里明白抵在腰上的东西是充血完全勃起的阴茎。" voices=""/><msg @l="726" char_id="-1" frame_id="-1" name="" text="咕啾，咕啾，姆啾。"   voices=""/><msg @l="728" char_id="0" frame_id="-1" name="美帆" text="『嗯、嗯、嗯、嗯嗯！』"   voices="miho10980"/><msg @l="730" char_id="-1" frame_id="-1" name=""   text="但是这样的想法也被玩弄着私处的色狼的手指动作所抹去。" voices=""/><msg @l="731" char_id="-1" frame_id="-1" name=""   text="因被玩弄阴蒂而变得发热的下半身麻痹感，正在一点点增强。" voices=""/><msg @l="732" char_id="-1" frame_id="-1" name=""   text="对于玩弄私处的手指动作，我比起不适感更强烈地感受到了恐惧。" voices=""/><msg @l="733" char_id="-1" frame_id="-1" name=""   text="……泪眼朦胧，强忍着牙齿都咬不住的颤抖。" voices=""/><msg @l="735" char_id="-1" frame_id="-1" name="广播"   text="『下一站是终点……大学前，大学前站。』" voices=""/><msg @l="737" char_id="-1" frame_id="-1" name="广播"   text="『请注意不要遗忘随身物品。』" voices=""/><msg @l="739" char_id="-1" frame_id="-1" name="" text="熟悉的广播声在车厢内响起。"   voices=""/><msg @l="740" char_id="-1" frame_id="-1" name=""   text="然而，这熟悉的广播声只是让我更加意识到自己正被色狼骚扰的恐惧。" voices=""/><msg @l="742" char_id="-1" frame_id="-1" name="痴汉"   text="『哎呀……再过一会儿我就能用手指好好玩弄你的那里了。』" voices=""/><msg @l="744" char_id="-1" frame_id="-1" name="痴汉"   text="『算了。享受的乐趣，就留到下次吧。』" voices=""/><msg @l="746" char_id="-1" frame_id="-1" name=""   text="色狼像是嘲笑着因恐惧而颤抖的我，说着这话，从私处悄然抽回了他那爬行般的手。" voices=""/><msg @l="747" char_id="-1" frame_id="-1" name=""   text="然后……色狼仿佛将身体交付给人流一般，离开了。" voices=""/><stopbgm @l="751" fadeout="1000"/><clear @l="757" class="all"/><msg @l="759" char_id="0" frame_id="-1" name="美帆" text="(………怎么办………)"   voices="miho01080"/><msg @l="761" char_id="0" frame_id="-1" name="美帆"   text="(……我……止不住发抖……)" voices="miho01090"/><msg @l="763" char_id="-1" frame_id="-1" name=""   text="仍然抓着扶手……我一个人，肩膀在颤抖着。" voices=""/><stopse @l="767" buf="3"/><eval @l="770" expr="f.名前を知られてるflag&#32;+=&#32;1&#13;&#10;"/><eval @l="772" expr="f.痴漢flag&#32;+=&#32;1&#13;&#10;"/><label @l="776" id="TempLabel_159"/><clear @l="783" class="all"/><msgshow @l="785" show="true"/><goto @l="788" label="EventLabel_26"/><label @l="792" id="EventLabel_26"/><end_scene @l="796"/><wait_chgmv/><bg @l="800" src="bg08m1"/><description @l="803" text="日常へ差す影"/><bgm @l="807" src="bgm03" volume="1."/><msg @l="809" char_id="0" frame_id="-1" name="美帆" text="『………。』" voices=""/><msg @l="811" char_id="-1" frame_id="-1" name="" text="心不在焉地听着讲座。"   voices=""/><msg @l="812" char_id="-1" frame_id="-1" name="" text="一直在想着早上的那件事。"   voices=""/><msg @l="813" char_id="-1" frame_id="-1" name=""   text="不知为何色狼好像在执着地针对我个人这件事。" voices=""/><goto @l="816" cond="!(f.名前を知られてるflag&#32;==&#32;1)&#13;&#10;"   label="TempLabel_160"/><msg @l="818" char_id="-1" frame_id="-1" name=""   text="被那个色狼……知道了我的名字这件事。" voices=""/><label @l="821" id="TempLabel_160"/><msg @l="824" char_id="-1" frame_id="-1" name=""   text="虽然无法接受他执着地针对我个人的行为，但也能理解。" voices=""/><msg @l="825" char_id="-1" frame_id="-1" name=""   text="正如白石学姐所说，我可能是那种容易被盯上的性格，而且如果他在第一次猥亵时得到了回应再想来第二次……比起偶然遇到更容易理解。"   voices=""/><msg @l="827" char_id="0" frame_id="-1" name="美帆"   text="(当然……就算知道了这种事也一点都不开心……)" voices=""/><goto @l="830" cond="!(f.名前を知られてるflag&#32;==&#32;1)&#13;&#10;"   label="TempLabel_161"/><msg @l="832" char_id="-1" frame_id="-1" name=""   text="至于他知道我名字的原因，如果色狼是大学的相关人员的话也能说得通。" voices=""/><label @l="836" id="TempLabel_161"/><msg @l="839" char_id="-1" frame_id="-1" name="" text="比起这个，更大的问题是——。"   voices=""/><msg @l="841" char_id="3" frame_id="-1" name="声音" text="『……表情好严肃啊。』"   voices=""/><stopbgm @l="845" fadeout="1000"/><msg @l="847" char_id="0" frame_id="-1" name="美帆" text="『诶……？』" voices=""/><msg @l="849" char_id="-1" frame_id="-1" name=""   text="突然被搭话，之前的思绪一瞬间烟消云散。" voices=""/><msg @l="850" char_id="-1" frame_id="-1" name=""   text="我慌忙环顾四周寻找声音的主人，这时一个女孩子从稍远的地方毫不掩饰地移到了我旁边的座位上。"   voices=""/><char @l="853" id="nanak" pos="center" src="nanako010"/><msg @l="855" char_id="-1" frame_id="-1" name=""   text="这是位长发在头两侧扎成双马尾的皮肤略显白皙的女孩子。" voices=""/><msg @l="857" char_id="0" frame_id="-1" name="美帆" text="『啊……你是……。』"   voices=""/><msg @l="859" char_id="-1" frame_id="-1" name=""   text="那个皮肤白皙、扎着双马尾的女孩我有印象。" voices=""/><msg @l="860" char_id="-1" frame_id="-1" name=""   text="大约一个月前，在我来到南总町的那天遇见的那个神秘女孩。" voices=""/><msg @l="861" char_id="-1" frame_id="-1" name=""   text="精准说中我内心想法的……那个女孩子。" voices=""/><clear @l="864" class="char"/><bgm @l="868" src="bgm11" volume="1."/><msg @l="870" char_id="3" frame_id="-1" name="女孩" text="『看起来……精神不太好啊。』"   voices=""/><msg @l="872" char_id="0" frame_id="-1" name="美帆" text="『……嗯。』" voices=""/><msg @l="874" char_id="-1" frame_id="-1" name="" text="我无法掩饰自己的动摇和困惑。"   voices=""/><msg @l="875" char_id="-1" frame_id="-1" name=""   text="她太轻易地就闯入了我的内心世界。" voices=""/><msg @l="876" char_id="-1" frame_id="-1" name="" text="这个少女到底是什么人呢。"   voices=""/><msg @l="877" char_id="-1" frame_id="-1" name="" text="我不由自主地警惕起来。"   voices=""/><msg @l="879" char_id="3" frame_id="-1" name="女孩" text="『太烦恼的话会很累的哦。』"   voices=""/><msg @l="881" char_id="3" frame_id="-1" name="女孩" text="『我觉得……不该苛责自己。』"   voices=""/><msg @l="883" char_id="0" frame_id="-1" name="美帆" text="『……嗯……。』" voices=""/><msg @l="885" char_id="-1" frame_id="-1" name=""   text="虽然她这么说，但我心里想着“可是遇到痴汉的话谁都会烦恼的吧”。" voices=""/><msg @l="887" char_id="3" frame_id="-1" name="女孩" text="『痴汉？』" voices=""/><msg @l="889" char_id="0" frame_id="-1" name="美帆" text="『诶！？』" voices=""/><msg @l="891" char_id="-1" frame_id="-1" name="" text="浑身一颤。" voices=""/><msg @l="893" char_id="-1" frame_id="-1" name=""   text="啊，回过神来时发现周围的人都一齐看向这边。" voices=""/><msg @l="894" char_id="-1" frame_id="-1" name="" text="看来我不经意间提高了声音。"   voices=""/><msg @l="896" char_id="0" frame_id="-1" name="美帆" text="『对、对不起……。』"   voices=""/><msg @l="898" char_id="-1" frame_id="-1" name="" text="我一边道歉一边低下了头。"   voices=""/><msg @l="899" char_id="-1" frame_id="-1" name="" text="好难为情啊……唔……。"   voices=""/><msg @l="901" char_id="3" frame_id="-1" name="女孩" text="『没事吧？』" voices=""/><msg @l="903" char_id="0" frame_id="-1" name="美帆" text="『啊……，嗯……。』"   voices=""/><msg @l="905" char_id="-1" frame_id="-1" name=""   text="……这孩子仿佛看透了我的内心。" voices=""/><msg @l="906" char_id="-1" frame_id="-1" name=""   text="虽然，从她身上感受不到一丝恶意……但背脊发凉的违和感依然存在。" voices=""/><msg @l="908" char_id="0" frame_id="-1" name="美帆"   text="『……就这样，什么都能说中呢。』" voices=""/><msg @l="910" char_id="3" frame_id="-1" name="女孩"   text="『不是……我只是能感觉到，大概。』" voices=""/><msg @l="912" char_id="0" frame_id="-1" name="美帆" text="『感觉……？』" voices=""/><msg @l="914" char_id="3" frame_id="-1" name="女孩" text="『对。』" voices=""/><msg @l="916" char_id="3" frame_id="-1" name="女孩"   text="『痛苦啊悲伤啊辛酸啊煎熬啊……诸如此类的。』" voices=""/><msg @l="918" char_id="0" frame_id="-1" name="美帆" text="『………。』" voices=""/><msg @l="920" char_id="0" frame_id="-1" name="美帆"   text="(其实，我的心思并没有…被读取)" voices=""/><msg @l="922" char_id="-1" frame_id="-1" name=""   text="当我意识到自己正试图接受她这种不可思议的一面时，感到惊讶。" voices=""/><msg @l="924" char_id="0" frame_id="-1" name="美帆"   text="(因为感觉不真实…不，或许是因为她没有恶意吧)" voices=""/><msg @l="926" char_id="3" frame_id="-1" name="女孩" text="『我是奈那子……浅间奈那子。』"   voices=""/><msg @l="928" char_id="0" frame_id="-1" name="美帆"   text="『啊，呃……我是仲根美帆……』" voices=""/><msg @l="930" char_id="3" frame_id="-1" name="奈那子" text="『请多关照，美帆。』"   voices=""/><msg @l="932" char_id="0" frame_id="-1" name="美帆" text="『请……请多关照。』"   voices=""/><clear @l="938" class="all"/><msgshow @l="940" show="true"/><wait_chgmv/><bg @l="944" src="bg09"/><char @l="948" id="miho" pos="left" src="miho116"/><char @l="952" id="nanak" pos="right" src="nanako010"/><msg @l="954" char_id="0" frame_id="-1" name="美帆" text="『………。』" voices=""/><msg @l="956" char_id="3" frame_id="-1" name="奈那子" text="『………。』" voices=""/><msg @l="958" char_id="-1" frame_id="-1" name=""   text="课后……我们并肩走在走廊上。" voices=""/><msg @l="959" char_id="-1" frame_id="-1" name=""   text="今天平时一起上课的朋友没来。" voices=""/><msg @l="960" char_id="-1" frame_id="-1" name=""   text="碰巧，我和她下一节课在同一栋教学楼。" voices=""/><msg @l="961" char_id="-1" frame_id="-1" name=""   text="所以，这一切也许……是命运的安排……吧？" voices=""/><msg @l="963" char_id="0" frame_id="-1" name="美帆" text="(有点…尴尬啊……)"   voices=""/><msg @l="965" char_id="-1" frame_id="-1" name=""   text="即使认为这是命运的安排，要坦率地接受她……总觉得有些抵触。" voices=""/><msg @l="966" char_id="-1" frame_id="-1" name=""   text="如果说浅间同学的态度让我感到太过亲昵，那也仅此而已。" voices=""/><msg @l="967" char_id="-1" frame_id="-1" name=""   text="不过，交朋友的契机往往就是这样的吧。" voices=""/><msg @l="968" char_id="-1" frame_id="-1" name=""   text="最近经常一起聊天的朋友，刚开始时也感觉很不自然，很唐突。" voices=""/><msg @l="969" char_id="-1" frame_id="-1" name=""   text="但是，通过长时间的相处，关系也变得更加“自然”了。" voices=""/><msg @l="971" char_id="0" frame_id="-1" name="美帆"   text="(我知道这只是因为我太怕生了)" voices=""/><msg @l="973" char_id="0" frame_id="-1" name="美帆" text="(……但是…现在……)"   voices=""/><msg @l="975" char_id="3" frame_id="-1" name="奈那子" text="『……。』" voices=""/><msg @l="977" char_id="3" frame_id="-1" name="奈那子"   text="『美帆……总是看起来很悲伤呢。』" voices=""/><char @l="981" id="miho" pos="left" src="miho114"/><msg @l="983" char_id="0" frame_id="-1" name="美帆" text="『啊……？』" voices=""/><char @l="987" id="nanak" pos="right" src="nanako019"/><msg @l="989" char_id="3" frame_id="-1" name="奈那子"   text="『在校园里或走廊上……每次我看到美帆，你总是一副悲伤的表情。』" voices=""/><msg @l="991" char_id="3" frame_id="-1" name="奈那子" text="『为什么……？』"   voices=""/><char @l="995" id="miho" pos="left" src="miho016"/><msg @l="997" char_id="0" frame_id="-1" name="美帆"   text="『为什么……被这么问也……。』" voices=""/><msg @l="999" char_id="-1" frame_id="-1" name="" text="这种事，我自己也不太明白。"   voices=""/><msg @l="1000" char_id="-1" frame_id="-1" name=""   text="我真的看起来一直都是一副悲伤的表情吗……？" voices=""/><msg @l="1001" char_id="-1" frame_id="-1" name="" text="……。" voices=""/><char @l="1005" id="nanak" pos="right" src="nanako010"/><msg @l="1007" char_id="3" frame_id="-1" name="奈那子"   text="『哥哥说过，笑的话就能变得幸福。』" voices=""/><msg @l="1009" char_id="3" frame_id="-1" name="奈那子"   text="『反过来说，如果一直悲伤的话……真的会变得不幸的哦。』" voices=""/><char @l="1013" id="miho" pos="left" src="miho010"/><msg @l="1015" char_id="0" frame_id="-1" name="美帆" text="『……哥哥……？』"   voices=""/><msg @l="1017" char_id="-1" frame_id="-1" name="" text="突然回想起一个月前的事情。"   voices=""/><msg @l="1018" char_id="-1" frame_id="-1" name=""   text="和她一起的那个冷漠寡言的男性……恐怕就是她所说的“哥哥”吧。" voices=""/><msg @l="1020" char_id="3" frame_id="-1" name="奈那子" text="『美帆笑起来会更可爱哦。』"   voices=""/><char @l="1024" id="miho" pos="left" src="miho014"/><msg @l="1026" char_id="0" frame_id="-1" name="美帆" text="『诶……。』" voices=""/><char @l="1030" id="miho" pos="left" src="miho016"/><msg @l="1032" char_id="0" frame_id="-1" name="美帆" text="『那、那种事……。』"   voices=""/><char @l="1036" id="nanak" pos="right" src="nanako011"/><msg @l="1038" char_id="3" frame_id="-1" name="奈那子" text="『嗯，笑起来会更好看。绝对的。』"   voices=""/><msg @l="1040" char_id="-1" frame_id="-1" name=""   text="浅间又重复了一遍这句话，然后灿烂一笑。" voices=""/><char @l="1052" id="miho" pos="left" src="miho010"/><char @l="1056" id="nanak" pos="right" src="nanako011"/><msg @l="1058" char_id="3" frame_id="-1" name="奈那子" text="『我走这边。』"   voices=""/><msg @l="1060" char_id="-1" frame_id="-1" name=""   text="到达目标校舍后的第二个拐角处，浅间停了下来。" voices=""/><msg @l="1061" char_id="-1" frame_id="-1" name=""   text="到现在为止我们之间也没有太多对话，只是肩并肩地走着而已。" voices=""/><msg @l="1062" char_id="-1" frame_id="-1" name=""   text="但不知为何浅间同学看起来很开心，脸上一直挂着笑容……" voices=""/><msg @l="1063" char_id="-1" frame_id="-1" name=""   text="这也是因为她的“哥哥大人”说笑起来会更好看吗？" voices=""/><char @l="1067" id="miho" pos="left" src="miho016"/><msg @l="1069" char_id="0" frame_id="-1" name="美帆" text="『啊，好的……那么。』"   voices=""/><msg @l="1071" char_id="-1" frame_id="-1" name=""   text="我稍微语塞了一下，然后选择了一个比较中规中矩的回答。" voices=""/><msg @l="1072" char_id="-1" frame_id="-1" name=""   text="说“再见”感觉有些奇怪，但是微笑着挥手又觉得不太像我的风格。" voices=""/><char @l="1076" id="nanak" pos="right" src="nanako010"/><msg @l="1078" char_id="3" frame_id="-1" name="奈那子" text="『……』" voices=""/><msg @l="1080" char_id="0" frame_id="-1" name="美帆" text="『怎、怎么了？』"   voices=""/><msg @l="1082" char_id="-1" frame_id="-1" name=""   text="在走廊的拐角处停下脚步，浅间同学一直盯着我看。" voices=""/><msg @l="1083" char_id="-1" frame_id="-1" name=""   text="是不是我太过普通的道别方式反而让她不高兴了。" voices=""/><msg @l="1084" char_id="-1" frame_id="-1" name="" text="或许是……" voices=""/><msg @l="1086" char_id="3" frame_id="-1" name="奈那子" text="『美帆是个好孩子呢。』"   voices=""/><char @l="1090" id="miho" pos="left" src="miho014"/><msg @l="1092" char_id="0" frame_id="-1" name="美帆"   text="『诶，那是什么意思……？』" voices=""/><char @l="1096" id="nanak" pos="right" src="nanako011"/><msg @l="1098" char_id="3" frame_id="-1" name="奈那子" text="『字面意思，美帆是个好孩子哦。』"   voices=""/><char @l="1102" id="miho" pos="left" src="miho016"/><msg @l="1104" char_id="0" frame_id="-1" name="美帆"   text="『好孩子……这种话……』" voices=""/><char @l="1108" id="nanak" pos="right" src="nanako018"/><msg @l="1110" char_id="3" frame_id="-1" name="奈那子" text="『没人这么说过你吗？』"   voices=""/><msg @l="1112" char_id="0" frame_id="-1" name="美帆"   text="『不，没人会说……这种，我又不是小孩子了。』" voices=""/><msg @l="1114" char_id="3" frame_id="-1" name="奈那子"   text="『不是小孩子就不能这么说了吗？』" voices=""/><msg @l="1116" char_id="0" frame_id="-1" name="美帆"   text="『那是……当然啊，什么好孩子的……』" voices=""/><msg @l="1118" char_id="-1" frame_id="-1" name=""   text="这个年纪被人这么说，只会让我觉得是在取笑我。" voices=""/><char @l="1122" id="nanak" pos="right" src="nanako011"/><msg @l="1124" char_id="3" frame_id="-1" name="奈那子"   text="『哥哥会对我说，奈那子是个好孩子。』" voices=""/><char @l="1128" id="nanak" pos="right" src="nanako012"/><msg @l="1130" char_id="3" frame_id="-1" name="奈那子"   text="『对我来说，哥哥这么说是最让我开心的。』" voices=""/><char @l="1134" id="nanak" pos="right" src="nanako018"/><msg @l="1136" char_id="3" frame_id="-1" name="奈那子" text="『美帆……不觉得开心吗？』"   voices=""/><char @l="1140" id="miho" pos="left" src="miho110"/><msg @l="1142" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="1144" char_id="-1" frame_id="-1" name=""   text="想必，她的哥哥是真心实意地说她是“好孩子”吧。" voices=""/><msg @l="1145" char_id="-1" frame_id="-1" name=""   text="所以她才能这么坦率地感到高兴，也能坦率地接受。" voices=""/><msg @l="1146" char_id="-1" frame_id="-1" name="" text="我又如何呢……？"   voices=""/><msg @l="1147" char_id="-1" frame_id="-1" name=""   text="被称作“好孩子”的话，我能坦率地感到高兴吗？" voices=""/><msg @l="1149" char_id="0" frame_id="-1" name="美帆" text="『……我……。』"   voices=""/><se @l="1153" buf="1" src="予鈴" volume="1."/><char @l="1157" id="miho" pos="left" src="miho114"/><msg @l="1159" char_id="0" frame_id="-1" name="美帆" text="『啊……。』" voices=""/><msg @l="1161" char_id="-1" frame_id="-1" name=""   text="不巧的是……宣告离讲座开始还有5分钟的预备铃响了。" voices=""/><msg @l="1162" char_id="-1" frame_id="-1" name=""   text="不，对于回答困难的我来说，这或许反而是一根救命稻草……。" voices=""/><char @l="1166" id="nanak" pos="right" src="nanako010"/><msg @l="1168" char_id="3" frame_id="-1" name="奈那子" text="『该走了。』"   voices=""/><msg @l="1170" char_id="0" frame_id="-1" name="美帆" text="『浅间同学，我……。』"   voices=""/><char @l="1174" id="nanak" pos="right" src="nanako011"/><msg @l="1176" char_id="3" frame_id="-1" name="奈那子"   text="『我觉得美帆就做美帆自己就好了。』" voices=""/><char @l="1180" id="miho" pos="left" src="miho014"/><msg @l="1182" char_id="0" frame_id="-1" name="美帆" text="『啊……？』" voices=""/><msg @l="1184" char_id="3" frame_id="-1" name="奈那子" text="『没关系……我不会感到寂寞的。』"   voices=""/><char @l="1188" id="nanak" pos="right" src="nanako010"/><msg @l="1190" char_id="3" frame_id="-1" name="奈那子"   text="『什么才是重要的，每个人的答案都不一样，美帆。』" voices=""/><char @l="1194" id="nanak" pos="right" src="nanako011"/><msg @l="1196" char_id="3" frame_id="-1" name="奈那子" text="『这也是我哥哥说的话啦。』"   voices=""/><clear @l="1200" layer="nanak"/><msg @l="1202" char_id="-1" frame_id="-1" name=""   text="她说完这句话笑了笑，然后朝讲堂走去，步伐轻快。" voices=""/><msg @l="1204" char_id="0" frame_id="-1" name="美帆" text="『啊……浅间同学！』"   voices=""/><msg @l="1206" char_id="-1" frame_id="-1" name=""   text="我不由自主地说出挽留的话，伸出了手。" voices=""/><msg @l="1207" char_id="-1" frame_id="-1" name=""   text="和一个月前一样……就算挽留了也什么都做不到。" voices=""/><char @l="1211" id="nanak" pos="right" src="nanako010"/><msg @l="1213" char_id="3" frame_id="-1" name="奈那子" text="『叫我奈那子，比较好。』"   voices=""/><msg @l="1215" char_id="0" frame_id="-1" name="美帆" text="『诶……』" voices=""/><char @l="1219" id="nanak" pos="right" src="nanako011"/><msg @l="1221" char_id="3" frame_id="-1" name="奈那子"   text="『如果你能叫我奈那子，我会更开心。』" voices=""/><msg @l="1223" char_id="-1" frame_id="-1" name=""   text="浅间……奈那子说完这句话转过身来，笑得灿烂。" voices=""/><clear @l="1227" layer="nanak"/><msg @l="1229" char_id="-1" frame_id="-1" name="" text="然后，她走进了讲堂。"   voices=""/><stopbgm @l="1233" fadeout="1000"/><clear @l="1239" class="all"/><msgshow @l="1241" show="true"/><se @l="1245" buf="1" src="ノック2" volume="1."/><msg @l="1247" char_id="0" frame_id="-1" name="美帆" text="『学姐，我们进去吧。』"   voices=""/><msg @l="1249" char_id="1" frame_id="-1" name="玲" text="『请吧。』" voices=""/><se @l="1253" buf="1" src="扉を開ける音_木製" volume="1."/><wait_chgmv/><bg @l="1257" src="bg02b"/><bgm @l="1261" src="bgm05" volume="1."/><char @l="1265" id="miho" pos="auto" src="miho030"/><msg @l="1267" char_id="0" frame_id="-1" name="美帆" text="『我洗完澡了。』"   voices=""/><msg @l="1269" char_id="1" frame_id="-1" name="玲" text="『谢谢，我马上也去洗。』"   voices=""/><msg @l="1271" char_id="-1" frame_id="-1" name=""   text="白石学姐仍然面对着桌子，只是把视线转向这边回答。" voices=""/><msg @l="1272" char_id="-1" frame_id="-1" name=""   text="桌子上摆放着各种文件，大概是在做报告之类的事情吧。" voices=""/><char @l="1276" id="miho" pos="auto" src="miho034"/><msg @l="1278" char_id="0" frame_id="-1" name="美帆" text="『……看起来很辛苦呢？』"   voices=""/><msg @l="1280" char_id="1" frame_id="-1" name="玲"   text="『与其说辛苦，不如说麻烦……只是很耗时间，而且单调。』" voices=""/><char @l="1284" id="miho" pos="auto" src="miho030"/><msg @l="1286" char_id="0" frame_id="-1" name="美帆" text="『是报告吗？』"   voices=""/><msg @l="1288" char_id="1" frame_id="-1" name="玲" text="『嗯……不是啦。』"   voices=""/><clear @l="1291" class="char"/><char @l="1295" id="miho" pos="left" src="miho030"/><char @l="1299" id="rei" pos="right" src="rei030"/><msg @l="1301" char_id="1" frame_id="-1" name="玲"   text="『我不是说过这周在大黑建设有考试吗？是在准备那个。』" voices=""/><msg @l="1303" char_id="-1" frame_id="-1" name=""   text="说着，学姐拿起一张文件朝这边晃了晃。" voices=""/><msg @l="1304" char_id="-1" frame_id="-1" name=""   text="文件上布满了密密麻麻的小字。" voices=""/><msg @l="1306" char_id="0" frame_id="-1" name="美帆" text="『考试是什么时候？』"   voices=""/><msg @l="1308" char_id="1" frame_id="-1" name="玲"   text="『后天。明天我还有其他考试准备要做，所以得一早就去办公室。』" voices=""/><char @l="1312" id="miho" pos="left" src="miho034"/><msg @l="1314" char_id="0" frame_id="-1" name="美帆"   text="『啊……那明天我们一起坐电车去好吗？』" voices=""/><char @l="1318" id="rei" pos="right" src="rei034"/><msg @l="1320" char_id="1" frame_id="-1" name="玲"   text="『诶，你……明天不是从第三节课开始吗？』" voices=""/><msg @l="1322" char_id="1" frame_id="-1" name="玲"   text="『我想在午饭前回来，所以会很早哦？』" voices=""/><char @l="1326" id="miho" pos="left" src="miho036"/><msg @l="1328" char_id="0" frame_id="-1" name="美帆"   text="『那个……如果可以的话，我不太想一个人坐电车。』" voices=""/><char @l="1332" id="rei" pos="right" src="rei030"/><msg @l="1334" char_id="1" frame_id="-1" name="玲" text="『什么意思？』" voices=""/><char @l="1337" id="miho" pos="left" src="miho136"/><msg @l="1339" char_id="0" frame_id="-1" name="美帆" text="『那个是……』" voices=""/><msg @l="1341" char_id="-1" frame_id="-1" name=""   text="面对这个随意的疑问，我不由得低下了头。" voices=""/><msg @l="1342" char_id="-1" frame_id="-1" name=""   text="虽然我信任学姐，也觉得她是个好人，但是不想一个人坐电车的原因是害怕遭遇痴汉这种事……有点难以启齿。"   voices=""/><char @l="1346" id="miho" pos="left" src="miho136"/><msg @l="1348" char_id="0" frame_id="-1" name="美帆" text="『……对不起。』"   voices=""/><char @l="1352" id="rei" pos="right" src="rei031"/><msg @l="1354" char_id="1" frame_id="-1" name="玲"   text="『嗯，如果难以开口的话，也没必要勉强自己说出来。』" voices=""/><char @l="1358" id="rei" pos="right" src="rei030"/><msg @l="1360" char_id="1" frame_id="-1" name="玲"   text="『只是……当你一个人无法解决问题的时候，请不要客气，尽管来找我商量。』" voices=""/><msg @l="1361" char_id="1" frame_id="-1" name="玲"   text="『虽然我可能帮不上太多忙，但总比你一个人烦恼到崩溃要好吧。』" voices=""/><char @l="1365" id="miho" pos="left" src="miho130"/><msg @l="1367" char_id="0" frame_id="-1" name="美帆" text="『谢谢您……』"   voices=""/><msg @l="1369" char_id="0" frame_id="-1" name="美帆"   text="『不过……那个，只要能一起坐电车就足够了。』" voices=""/><msg @l="1371" char_id="1" frame_id="-1" name="玲" text="『……』" voices=""/><msg @l="1373" char_id="1" frame_id="-1" name="玲"   text="『原来如此，看来不只是单纯的想家啊。』" voices=""/><char @l="1377" id="miho" pos="left" src="miho136"/><msg @l="1379" char_id="0" frame_id="-1" name="美帆"   text="『对不起……我总是不说原因就任性地提要求。』" voices=""/><msg @l="1381" char_id="1" frame_id="-1" name="玲"   text="『没关系的，我不在意。明天我们一起出门吧。』" voices=""/><char @l="1385" id="rei" pos="right" src="rei031"/><msg @l="1387" char_id="1" frame_id="-1" name="玲"   text="『作为交换……早餐，拜托做点好吃的哦。』" voices=""/><msg @l="1389" char_id="-1" frame_id="-1" name=""   text="说着，白石学姐露出了俏皮的笑容。" voices=""/><char @l="1392" id="miho" pos="left" src="miho131"/><msg @l="1394" char_id="0" frame_id="-1" name="美帆" text="『好、好的。』" voices=""/><stopbgm @l="1398" fadeout="1000"/><clear @l="1404" class="all"/><call @l="1408" target="EventLabel_27@common_root03"/><return @l="1409" value="0&#13;&#10;"/></code></xscript>																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																											