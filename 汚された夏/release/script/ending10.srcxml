<?xml version="1.0" encoding="utf-8"?><xscript><debug editor="&quot;C:\Program&#32;Files&#32;(x86)\sakura\sakura.exe&quot;&#32;&quot;%src%&quot;&#32;-Y=%line%"   src="D:\シロップ\町ぐるみの罠＋汚された夏セット版\汚された夏\完成データ\汚された夏\script\text\ending10.txt"/><code><label @l="12" id="EventLabel_48"/><description @l="16" text="研究室的宠物"/><eval @l="18" expr="f.numDay=0&#13;&#10;"/><msgshow @l="20" show="true"/><bgm @l="26" src="bgm03" volume="1."/><msg @l="28" char_id="-1" frame_id="-1" name=""   text="在教授室里被轮奸到浑身沾满白浊之后——" voices=""/><msg @l="29" char_id="-1" frame_id="-1" name=""   text="美帆从那时起，就因为被拍下的照片而被那些学生们每天叫出去索取身体。" voices=""/><wait_chgmv/><bg @l="32" src="bg15a"/><char @l="34" id="miho" pos="center" src="miho105f" y="-80"/><msg @l="35" char_id="-1" frame_id="-1" name="" text="被叫到厕所里侵犯——"   voices=""/><wait_chgmv/><bg @l="38" src="bg09b"/><msg @l="39" char_id="-1" frame_id="-1" name="" text="在图书室的书库里被迫口交——"   voices=""/><wait_chgmv/><bg @l="42" src="bg08a"/><msg @l="43" char_id="-1" frame_id="-1" name=""   text="被迫插入震动棒上课——" voices=""/><wait_chgmv/><bg @l="45" src="bg07b"/><msg @l="46" char_id="-1" frame_id="-1" name="" text="美帆在大学内的各个角落都被玩弄。"   voices=""/><wait_chgmv/><bg @l="48" src="bg09c"/><msg @l="49" char_id="-1" frame_id="-1" name=""   text="不仅如此，学生们还命令美帆不准穿内衣且必须穿极短的裙子，甚至开始强迫她穿透明的衣服等暴露的服装。"   voices=""/><wait_chgmv/><bg @l="52" src="black"/><clear @l="54" class="char"/><char @l="56" id="miho" pos="auto" src="miho105"/><msg @l="58" char_id="-1" frame_id="-1" name=""   text="渐渐地，原本不太引人注目的美帆在男学生之间成了“可以侵犯”的话题，用威胁手段强行侵犯她的男学生日益增多。"   voices=""/><msg @l="59" char_id="-1" frame_id="-1" name=""   text="因为她本来脸蛋就很可爱，身材也相当不错，一旦开始受到关注，就在整个大学里无人不知无人不晓了——" voices=""/><clear @l="67" class="all"/><wait_chgmv/><bg @l="70" src="bg12b"/><msg @l="72" char_id="-1" frame_id="-1" name=""   text="然后，那个一直默默看着美帆被凌辱的朽木教授，突然把美帆调配到自己的研究室担任研究助手。" voices=""/><msg @l="73" char_id="-1" frame_id="-1" name=""   text="实际上，这是为了让美帆成为朽木研究室专用的慰藉宠物。" voices=""/><msg @l="74" char_id="-1" frame_id="-1" name=""   text="事实上，各研究室都有一项制度，每个研究室都配置一名专用宠物，当研究室里的学生取得良好成绩时，就可以随意使用这个宠物。"   voices=""/><msg @l="75" char_id="-1" frame_id="-1" name=""   text="也就是说，如果这个宠物很受欢迎，优秀的学生就会聚集到那个研究室，从而提高评价，这是一种为学生和研究室都带来协同效应而创建的制度。"   voices=""/><msg @l="76" char_id="-1" frame_id="-1" name=""   text="这样各个研究室相互竞争增加优秀学生，也能提高整个大学的评价。" voices=""/><wait_chgmv/><bg @l="79" src="bg23a"/><stopbgm @l="81" fadeout="1000"/><msg @l="83" char_id="-1" frame_id="-1" name=""   text="这是南总町正在推进的计划……将整个城镇变成一个巨大的性欲处理场，以此为诱饵使城镇繁荣发展。" voices=""/><msg @l="84" char_id="-1" frame_id="-1" name=""   text="企业员工以及支付大额金钱搬来此地的人可以免费接受性服务，但这项政策并不适用于在大学就读的学生。"   voices=""/><msg @l="85" char_id="-1" frame_id="-1" name=""   text="但从城镇的角度来看，提高大学知名度能带动经济发展，所以他们有效地利用了性欲处理场这一制度，创造了培养优秀学生的机制——那就是“宠物”系统。"   voices=""/><msg @l="88" char_id="-1" frame_id="-1" name=""   text="……就这样，美帆也被纳入了城镇的体系之中……" voices=""/><msg @l="92" char_id="-1" frame_id="-1" name="" text="———几周后。" voices=""/><clear @l="99" class="all"/><msgshow @l="102" show="true"/><bgm @l="105" src="bgm14" volume="1."/><wait_chgmv/><bg @l="109" src="bg09a"/><se @l="113" buf="1" src="ノック" volume="1."/><msg @l="115" char_id="-1" frame_id="-1" name="学生A" text="『…………。』" voices=""/><msg @l="117" char_id="-1" frame_id="-1" name="学生B" text="『…………。』" voices=""/><msg @l="119" char_id="-1" frame_id="-1" name=""   text="两名男学生敲响了朽木教授房间的门。" voices=""/><msg @l="121" char_id="-1" frame_id="-1" name="声音" text="『请进。』" voices=""/><msg @l="123" char_id="-1" frame_id="-1" name="学生们" text="『打扰了。』"   voices=""/><clear @l="129" class="all"/><label @l="132" id="event_scene25"/><msg @l="135" char_id="-1" frame_id="-1" name="学生" text="『哦，在这儿啊……』"   voices=""/><msg @l="137" char_id="-1" frame_id="-1" name=""   text="一进入教授室，男学生们就发现了散发着刺激鼻腔的甜美“女人气味”的“宠物”。" voices=""/><msg @l="139" char_id="-1" frame_id="-1" name="学生"   text="『乖乖的吧，小母狗。为了见你我可是努力学习了呢。』" voices=""/><msg @l="141" char_id="-1" frame_id="-1" name="朽木" text="『呵呵，今天是你们啊。』"   voices=""/><msg @l="143" char_id="-1" frame_id="-1" name="学生"   text="『是的，因为昨天的考试拿到了“A”，所以可以玩“宠物”对吧。』" voices=""/><msg @l="145" char_id="-1" frame_id="-1" name="朽木"   text="『啊，尽情地玩弄她吧。刚好我正在调教她，已经给她灌肠了。』" voices=""/><msg @l="147" char_id="-1" frame_id="-1" name="学生"   text="『真的吗！我超喜欢玩弄后庭的。』" voices=""/><msg @l="149" char_id="-1" frame_id="-1" name=""   text="说着，两名学生看向了房间角落里蜷缩着、扭动臀部、痛苦挣扎的“宠物”。" voices=""/><label @l="153" id="chart_line52"/><wait_chgmv/><ev @l="157" src="ev-025"/><bgm @l="161" src="bgm14" volume="1."/><msg @l="163" char_id="0" frame_id="-1" name="美帆"   text="『嗯呜……嗯，嗯嗯……嗯，嗯呜。』" voices="miho12070"/><msg @l="165" char_id="-1" frame_id="-1" name=""   text="房间角落里拴着的那只母犬——她就是被分配到朽木研究室担任研究助手的仲根美帆。" voices=""/><msg @l="166" char_id="-1" frame_id="-1" name=""   text="美帆被穿上了用皮带束缚全身的拘束衣，挤压着她娇嫩的肌肤，使她的乳房被挤出来。双手被束缚在背后，使她完全无法反抗，增加了被虐待的感觉。"   voices=""/><msg @l="168" char_id="0" frame_id="-1" name="美帆"   text="『嗯，嗯嗯……嗯呜……。』" voices="miho12080"/><msg @l="170" char_id="-1" frame_id="-1" name=""   text="美帆因灌肠而感到便意，扭动着臀部，似乎想说些什么，发出了痛苦的呻吟声。" voices=""/><msg @l="171" char_id="-1" frame_id="-1" name=""   text="但她的嘴被口塞（带束带的口枷）堵住，连说话都不被允许，只能任由口水流下。" voices=""/><msg @l="173" char_id="-1" frame_id="-1" name="学生"   text="『嘿嘿，真下流地摇着屁股。如果那么想让人玩弄你的后庭，我就好好疼爱你吧。』" voices=""/><msg @l="175" char_id="-1" frame_id="-1" name=""   text="学生说完，抓住用来堵住灌肠后肛门的尾巴，开始折磨般地晃动它。" voices=""/><msg @l="177" char_id="0" frame_id="-1" name="美帆"   text="『嗯呜……嗯，嗯啊啊……。』" voices="miho12090"/><msg @l="179" char_id="-1" frame_id="-1" name="学生"   text="『这里很舒服吧，母狗！』" voices=""/><msg @l="181" char_id="-1" frame_id="-1" name=""   text="学生高兴地折磨着美帆的肛门，美帆便意越来越强烈，痛苦地呻吟起来。" voices=""/><msg @l="183" char_id="0" frame_id="-1" name="美帆"   text="『嗯呜……嗯，嗯嗯……嗯，嗯呜。』" voices="miho12070"/><msg @l="185" char_id="-1" frame_id="-1" name=""   text="然而，因为尾巴塞住了后面，她既不能排泄也不能漏出来，只能忍受着，美帆痛苦地扭动着身体。" voices=""/><msg @l="187" char_id="-1" frame_id="-1" name="朽木"   text="『呵呵，你还是这么淫荡的身体啊，美帆君。仅仅是被玩弄后面就让乳头变得这么硬。』" voices=""/><msg @l="189" char_id="-1" frame_id="-1" name=""   text="朽木捏起那挺立变得敏感的乳头，高兴地说道。" voices=""/><msg @l="191" char_id="0" frame_id="-1" name="美帆"   text="『嗯呜……嗯，嗯嗯……嗯，嗯呜。』" voices="miho12070"/><msg @l="193" char_id="-1" frame_id="-1" name="学生"   text="『朽木教授，现在可以开始了吧？』" voices=""/><msg @l="195" char_id="-1" frame_id="-1" name="朽木"   text="『当然可以。今天一整天你可以随心所欲地戏弄她。为了喜欢灌肠的你，我已经准备了充足的甘油溶液。』"   voices=""/><msg @l="197" char_id="-1" frame_id="-1" name=""   text="学生听了朽木的话，露出了兴高采烈的表情。" voices=""/><msg @l="199" char_id="-1" frame_id="-1" name="学生"   text="『真的吗！那我先插进她小穴爽一发，然后再插进她肛门里。』" voices=""/><msg @l="201" char_id="-1" frame_id="-1" name=""   text="学生一边高兴地说着，一边拉下裤子拉链，露出了坚硬勃起的肉棒。" voices=""/><msg @l="203" char_id="0" frame_id="-1" name="美帆"   text="『嗯呜……嗯，嗯嗯……。』" voices="miho12100"/><msg @l="205" char_id="-1" frame_id="-1" name=""   text="看到他们怒张的男根，这只母狗无力地颤抖着身体。" voices=""/><msg @l="207" char_id="-1" frame_id="-1" name="学生"   text="『来，好好品尝我的肉棒吧。』" voices=""/><msg @l="209" char_id="0" frame_id="-1" name="美帆" text="『嗯，嗯嗯……。』"   voices="miho12110"/><msg @l="211" char_id="-1" frame_id="-1" name=""   text="学生抓住美帆纤细的腰，将肉刃对准肉缝，慢慢地插了进去。" voices=""/><msg @l="212" char_id="-1" frame_id="-1" name=""   text="感受到被插入的感觉，美帆的臀部猛地一颤。现在无论被做什么，那振动都会传递到下腹部的排泄欲望中。"   voices=""/><msg @l="214" char_id="0" frame_id="-1" name="美帆"   text="『嗯呼……嗯，嗯嗯……嗯，嗯呜。』" voices="miho12070"/><msg @l="216" char_id="-1" frame_id="-1" name="学生"   text="『哦，还是一如既往的紧啊……你的这里。』" voices=""/><msg @l="218" char_id="0" frame_id="-1" name="美帆"   text="『嗯嗯……嗯，呼，嗯呜……。』" voices="miho12120"/><msg @l="220" char_id="-1" frame_id="-1" name=""   text="美帆从性器被插入的瞬间开始，发出格外高昂的声音，身体像是僵硬般绷直。然而，学生却像是在享受美帆的反应一般，将肉棒刺入充血的秘部深处。"   voices=""/><msg @l="222" char_id="0" frame_id="-1" name="美帆"   text="『嗯呜……嗯，嗯啊……。』" voices="miho12090"/><msg @l="224" char_id="-1" frame_id="-1" name="学生A"   text="『来，再多扭动屁股，紧紧夹住小穴，否则我就让你一直憋着大便不让排。』" voices=""/><msg @l="226" char_id="-1" frame_id="-1" name=""   text="学生一边粗暴地用手拨弄着插在肛门里的尾巴状肛塞，一边继续抽插运动。美帆同时被激烈地玩弄着肛门和秘缝，涌上来的便意让她眼前发花，几乎失去理智。"   voices=""/><msg @l="228" char_id="0" frame_id="-1" name="美帆"   text="『嗯，嗯啊……嗯……嗯呼……呜……。』" voices="miho12130"/><msg @l="229" char_id="-1" frame_id="-1" name="学生"   text="『哦，夹得真紧。马上，马上就要射了！』" voices=""/><msg @l="231" char_id="0" frame_id="-1" name="美帆" text="『嗯，嗯嗯……。』"   voices="miho12110"/><msg @l="233" char_id="-1" frame_id="-1" name=""   text="学生再次抓住腰部加速冲刺。插入秘缝中的肉棒与吸附般的阴道肉壁摩擦，龟头边缘将蜜汁刮向秘口，发出咕叽咕叽的声音回荡在室内。"   voices=""/><msg @l="234" char_id="-1" frame_id="-1" name=""   text="美帆在猛烈的抽送下感到冲击直达头顶，被束缚的乳房剧烈晃动，赤裸的身体猛烈颤抖。" voices=""/><msg @l="236" char_id="0" frame_id="-1" name="美帆"   text="『嗯，嗯嗯……嗯……嗯呼……。』" voices="miho12140"/><msg @l="238" char_id="-1" frame_id="-1" name=""   text="学生一直忍耐着射精，但在美帆缠绕的肉壁和紧致的挤压下，感受到超越极限的快感，终于射出了白浊液体。"   voices=""/><msg @l="240" char_id="-1" frame_id="-1" name="学生"   text="『啊，要射满你全身！啊，啊啊！』" voices=""/><msg @l="242" char_id="0" frame_id="-1" name="美帆"   text="『嗯，嗯啊……嗯……嗯呼……呜……。』" voices="miho12130"/><flash @l="245" count="4" fade="100" image="white"/><msg @l="247" char_id="0" frame_id="-1" name="美帆" text="『嗯，嗯嗯……。』"   voices="miho12110"/><wait_chgmv/><ev @l="251" src="ev-025z1"/><msg @l="253" char_id="-1" frame_id="-1" name="" text="咚啾啾啾啾啾啾啾啾！"   voices=""/><msg @l="255" char_id="-1" frame_id="-1" name=""   text="不知何时才会停止的大量精液注入美帆泛着粉色的全身，将其重新染成白浊色。" voices=""/><msg @l="256" char_id="-1" frame_id="-1" name=""   text="美帆两眼翻白，感受着前所未有的高潮。" voices=""/><msg @l="257" char_id="0" frame_id="-1" name="美帆"   text="『嗯呜……嗯，嗯啊啊……。』" voices="miho12090"/><msg @l="258" char_id="0" frame_id="-1" name="美帆" text="『嗯……。』"   voices="miho12150"/><msg @l="260" char_id="-1" frame_id="-1" name=""   text="学生走近目光呆滞、处于恍惚状态的美帆，随即缓缓拔出了尾巴状的肛门塞。" voices=""/><clear @l="266" class="all"/><msg @l="268" char_id="0" frame_id="-1" name="美帆" text="『嗯，嗯嗯……。』"   voices="miho12110"/><msg @l="270" char_id="-1" frame_id="-1" name="学生"   text="『嘿嘿，来吧，尽情地撒你的粪便吧。』" voices=""/><msg @l="272" char_id="0" frame_id="-1" name="美帆"   text="『嗯，嗯嗯……嗯……嗯呼……。』" voices="miho12140"/><msg @l="274" char_id="-1" frame_id="-1" name=""   text="听到学生的话，美帆因羞耻而扭曲脸庞，露出哀求的表情。然而学生无视这一切，用闪闪发光的眼睛视奸着她的肛门。" voices=""/><msg @l="275" char_id="-1" frame_id="-1" name=""   text="美帆拼命忍住不让排泄物被看见，但学生邪笑着给她的下腹部施加了强烈冲击。" voices=""/><msg @l="276" char_id="-1" frame_id="-1" name=""   text="随即，粉色菊花的皱褶被完全撑开，肛门隆起，伴随着恶臭开始喷射。" voices=""/><msg @l="278" char_id="0" frame_id="-1" name="美帆"   text="『嗯，嗯啊……嗯……嗯呼……呜……。』" voices="miho12130"/><msg @l="279" char_id="0" frame_id="-1" name="美帆"   text="『嗯呜……嗯，嗯啊啊……。』" voices="miho12090"/><msg @l="280" char_id="0" frame_id="-1" name="美帆" text="『嗯嗯！』"   voices="miho10930"/><msg @l="281" char_id="0" frame_id="-1" name="美帆" text="『嗯嗯——！！』"   voices="miho11030"/><msg @l="283" char_id="-1" frame_id="-1" name="" text="噗滋噜噜噜噜噜噜噜噜噜噜噜！"   voices=""/><msg @l="285" char_id="-1" frame_id="-1" name=""   text="那一瞬间，美帆仿佛精神错乱般发出呜咽声，排出散发恶臭的污物。" voices=""/><msg @l="286" char_id="-1" frame_id="-1" name=""   text="排泄结束后，她感到意识模糊，身体力气完全被抽空。" voices=""/><msg @l="288" char_id="-1" frame_id="-1" name=""   text="然而，学生因她的排泄行为而兴奋，虐待欲望高涨，拿来一桶水清洗美帆的肛门，同时愉悦地说道。"   voices=""/><msg @l="290" char_id="-1" frame_id="-1" name="学生"   text="『来，再把它塞进你的肛门里，让你再次呻吟不止。』" voices=""/><msg @l="292" char_id="-1" frame_id="-1" name=""   text="朽木教授正愉快地欣赏着“研究室的宝物美帆”被调教的这一景象——。" voices=""/><stopbgm @l="296" fadeout="1000"/><clear @l="302" class="all"/><end_scene @l="305"/><eval @l="309" expr="s.flagGallery=1&#13;&#10;"/><eval @l="311" expr="s.event25flag=1&#13;&#10;"/><eval @l="315"   expr="f.bEx&#32;=&#32;s.event20flag&#32;&amp;&amp;&#32;s.event23flag&#32;&amp;&amp;&#32;s.event25flag&#32;&amp;&amp;&#32;s.event30flag&#32;&amp;&amp;&#32;s.event31flag&#32;&amp;&amp;&#32;s.event32flag&#32;&amp;&amp;&#32;s.event33flag&#32;&amp;&amp;&#32;s.event35flag&#32;&amp;&amp;&#32;s.event37flag&#32;&amp;&amp;&#32;s.event38flag&#32;&amp;&amp;&#32;s.event60flag&#13;&#10;"/><goto @l="317" cond="!(f.bEx)&#13;&#10;" label="TempLabel_196"/><eval @l="319" expr="s.exRootFlag=1&#13;&#10;"/><label @l="320" id="TempLabel_196"/><ending @l="322"/><goto @l="324" cond="!(f.bEx)&#13;&#10;" label="TempLabel_197"/><wait_chgmv/><bg @l="328" src="newroot"/><wait @l="330" time="5000"/><wait_chgmv/><bg @l="332" src="black"/><label @l="335" id="TempLabel_197"/><return @l="339" value=""/></code></xscript>																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																	