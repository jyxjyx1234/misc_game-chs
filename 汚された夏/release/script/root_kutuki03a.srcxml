<?xml version="1.0" encoding="utf-8"?><xscript><debug editor="&quot;C:\Program&#32;Files&#32;(x86)\sakura\sakura.exe&quot;&#32;&quot;%src%&quot;&#32;-Y=%line%"   src="D:\シロップ\町ぐるみの罠＋汚された夏セット版\汚された夏\完成データ\汚された夏\script\text\root_kutuki03a.txt"/><code><label @l="10" id="EventLabel_114"/><description @l="13" text="朽木的奴隶·第2天"/><eval @l="15" expr="f.numDay=8&#13;&#10;"/><msgshow @l="17" show="false"/><wait_chgmv/><bg @l="19" src="day08" time="2000"/><wait @l="21" time="500"/><wait_chgmv/><bg @l="23" src="black" time="2000"/><msgshow @l="25" show="true"/><wait_chgmv/><bg @l="28" src="bg07"/><bgm @l="31" src="bgm02" volume="1."/><char @l="34" id="miho" pos="auto" src="miho010"/><msg @l="36" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="38" char_id="-1" frame_id="-1" name="" text="周一早晨。" voices=""/><msg @l="39" char_id="-1" frame_id="-1" name=""   text="我难得以清爽的心情走在校园里。" voices=""/><msg @l="40" char_id="-1" frame_id="-1" name=""   text="这是因为周六、周日都没有收到朽木教授的召唤。" voices=""/><msg @l="42" char_id="0" frame_id="-1" name="美帆"   text="(我并不是…放弃了)" voices=""/><char @l="45" id="miho" pos="auto" src="miho110"/><msg @l="47" char_id="0" frame_id="-1" name="美帆"   text="(但是，如果能稍微回归正常生活的话……)" voices=""/><stopbgm @l="50" fadeout="1000"/><se @l="53" buf="1" src="携帯電話呼び出し音02（ループ）" volume="1."/><char @l="56" id="miho" pos="auto" src="miho014"/><msg @l="58" char_id="0" frame_id="-1" name="美帆" text="『……！』" voices=""/><msg @l="60" char_id="-1" frame_id="-1" name=""   text="包里响起的手机铃声，一扫我内心充满的那份清爽感。" voices=""/><msg @l="61" char_id="-1" frame_id="-1" name=""   text="不用确认也知道……是朽木教授发来的邮件。" voices=""/><bgm @l="64" src="bgm03" volume="1."/><char @l="67" id="miho" pos="auto" src="miho116"/><msg @l="69" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="71" char_id="0" frame_id="-1" name="美帆" text="(没什么好沮丧的……)"   voices=""/><msg @l="73" char_id="0" frame_id="-1" name="美帆"   text="(从我选择成为教授的情人的那天起，像这样被邮件召唤已经成为我的“日常”了……)" voices=""/><msg @l="75" char_id="-1" frame_id="-1" name=""   text="一边这样告诉自己……我开始朝着教授室所在的校舍走去。" voices=""/><stopbgm @l="77" fadeout="1000"/><clear @l="80" class="all"/><label @l="83" id="event_scene74"/><msgshow @l="86" show="true"/><se @l="90" buf="1" src="ノック" volume="1."/><msg @l="92" char_id="0" frame_id="-1" name="美帆" text="『……打扰了。』" voices=""/><bgm @l="95" src="bgm03" volume="1."/><wait_chgmv/><bg @l="98" src="bg12"/><char @l="101" id="miho" pos="auto" src="miho116"/><msg @l="103" char_id="-1" frame_id="-1" name=""   text="不等教授回应，我急忙走进房间。" voices=""/><msg @l="104" char_id="-1" frame_id="-1" name="" text="我不想被人看见。"   voices=""/><msg @l="105" char_id="-1" frame_id="-1" name=""   text="表面上我是来向系里的教授请教问题的。" voices=""/><msg @l="106" char_id="-1" frame_id="-1" name=""   text="问题在于，看到我频繁出入教授室的身影，周围的人会怎么想。" voices=""/><msg @l="108" char_id="0" frame_id="-1" name="美帆" text="『那个……让您久等了。』"   voices=""/><clear @l="111" class="char"/><char @l="113" id="miho" pos="right" src="miho116"/><char @l="115" id="kutsu" pos="left" src="kutsu010"/><msg @l="117" char_id="-1" frame_id="-1" name="朽木"   text="『来得好。没有我的召唤，周末很寂寞吧？』" voices=""/><msg @l="119" char_id="-1" frame_id="-1" name=""   text="教授慢慢从座椅上站起来，看向我。" voices=""/><msg @l="120" char_id="-1" frame_id="-1" name=""   text="他的眼神似乎在考验我的“忠诚”。" voices=""/><char @l="123" id="miho" pos="right" src="miho016"/><msg @l="125" char_id="0" frame_id="-1" name="美帆" text="『嗯、寂、寂寞……了。』"   voices=""/><msg @l="127" char_id="-1" frame_id="-1" name="" text="我立刻撒了个谎。"   voices=""/><msg @l="128" char_id="-1" frame_id="-1" name=""   text="这个周末……没有他的召唤，我过得相当愉快。" voices=""/><msg @l="129" char_id="-1" frame_id="-1" name=""   text="与其整天提心吊胆等着被召唤，我从早上开始就在车站前面逛来逛去，购物、吃喝，尽情地放松自己。"   voices=""/><char @l="132" id="kutsu" pos="left" src="kutsu018"/><msg @l="134" char_id="-1" frame_id="-1" name="朽木"   text="『那太好了……既然这么寂寞，那就让我好好疼爱你吧。』" voices=""/><msg @l="136" char_id="-1" frame_id="-1" name=""   text="朽木教授说着，嘴角扭曲成夸张的笑容，看着我。" voices=""/><msg @l="138" char_id="-1" frame_id="-1" name="朽木"   text="『今天就让你来选择吧。』" voices=""/><char @l="141" id="miho" pos="right" src="miho115"/><msg @l="143" char_id="0" frame_id="-1" name="美帆" text="『……选择吗？』"   voices=""/><char @l="146" id="kutsu" pos="left" src="kutsu010"/><msg @l="148" char_id="-1" frame_id="-1" name="朽木" text="『有异议吗？』" voices=""/><msg @l="150" char_id="0" frame_id="-1" name="美帆" text="『不……没有什么异议。』"   voices=""/><msg @l="152" char_id="-1" frame_id="-1" name=""   text="即使有异议，我也没有权利说出口。" voices=""/><msg @l="154" char_id="-1" frame_id="-1" name="朽木" text="『很好。那就请选吧。』"   voices=""/><msg @l="156" char_id="-1" frame_id="-1" name=""   text="说着，他从抽屉里拿出两个塑料袋……里面装着衣服，并排放在桌子上给我看。" voices=""/><char @l="159" id="miho" pos="right" src="miho116"/><msg @l="161" char_id="0" frame_id="-1" name="美帆"   text="『这是……学校泳衣和网球服？』" voices=""/><msg @l="163" char_id="-1" frame_id="-1" name=""   text="两个塑料袋里分别装着学校泳衣和网球服。" voices=""/><msg @l="164" char_id="-1" frame_id="-1" name="" text="两件看起来都是新的。"   voices=""/><msg @l="166" char_id="-1" frame_id="-1" name="朽木"   text="『我想让你穿，所以准备了这些。』" voices=""/><msg @l="168" char_id="-1" frame_id="-1" name="朽木"   text="『怎么样？这是特意为你准备的哦？请选择一个吧。』" voices=""/><stopbgm @l="171" fadeout="1000"/><msg @l="173" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="176" async="true" char_id="-1" frame_id="-1" name=""   text="穿哪一个呢……？" voices=""/><select @l="177"><menu @l="180" label="EventLabel_115" text="学校泳衣"/><menu @l="183" label="EventLabel_118" text="网球服"/></select><label @l="189" id="EventLabel_115"/><bgm @l="192" src="bgm09" volume="1."/><msg @l="194" char_id="0" frame_id="-1" name="美帆" text="『那么，泳衣吧……。』"   voices=""/><msg @l="196" char_id="-1" frame_id="-1" name=""   text="无奈之下……我拿起了装有学校泳衣的袋子。" voices=""/><msg @l="198" char_id="-1" frame_id="-1" name="朽木"   text="『呵呵，很好……那么请穿上这个然后躺在桌子上。』" voices=""/><msg @l="200" char_id="0" frame_id="-1" name="美帆" text="『……是。』" voices=""/><msg @l="202" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="204" char_id="-1" frame_id="-1" name=""   text="在感受到朽木教授的目光的同时，我从袋子里取出了学校泳衣。" voices=""/><msg @l="205" char_id="-1" frame_id="-1" name=""   text="一件朴素无华的传统学校泳衣。没想到居然会在这种情况下再次穿上它。" voices=""/><msg @l="206" char_id="-1" frame_id="-1" name=""   text="我已经做好了心理准备……但还是咬紧嘴唇忍住委屈。" voices=""/><msg @l="207" char_id="-1" frame_id="-1" name=""   text="我用颤抖的手解开衬衫的纽扣，脱下裙子。背后能感受到朽木教授那令人不适的目光如丝线般缠绕着我……" voices=""/><char @l="210" id="miho" pos="right" src="miho185"/><char @l="212" id="kutsu" pos="left" src="kutsu018"/><msg @l="214" char_id="-1" frame_id="-1" name="朽木" text="『呵呵呵……』" voices=""/><msg @l="216" char_id="-1" frame_id="-1" name=""   text="……想起在这个房间里失去了贞操的事……悲伤和恐惧让我放在内衣上的手因颤抖而无法动弹。" voices=""/><msg @l="218" char_id="-1" frame_id="-1" name="朽木"   text="『怎么了？别在意我，继续换衣服吧。』" voices=""/><msg @l="220" char_id="-1" frame_id="-1" name=""   text="教授那胜券在握的语气，让我更加意识到自己无法反抗的处境。我放弃抵抗，一次性脱掉了内衣。" voices=""/><char @l="223" id="miho" pos="right" src="miho105"/><msg @l="225" char_id="0" frame_id="-1" name="美帆" text="『………。』" voices=""/><msg @l="227" char_id="-1" frame_id="-1" name=""   text="在那贪婪的目光下，羞辱感倍增，双腿不住地颤抖。" voices=""/><msg @l="229" char_id="-1" frame_id="-1" name="朽木"   text="『真是的，明明一副稚嫩的面孔却有着这么好的身材。像你这样的女孩居然当情妇，真是可怜啊。呵呵呵』" voices=""/><msg @l="231" char_id="-1" frame_id="-1" name=""   text="我为了逃避那些言语和目光，急忙拿起泳衣。" voices=""/><msg @l="233" char_id="0" frame_id="-1" name="美帆" text="(嗯……有点……紧呢……)"   voices=""/><msg @l="235" char_id="-1" frame_id="-1" name=""   text="感受着布料紧贴肌肤的触感，我感到一丝违和，同时将四肢穿进校泳衣中。" voices=""/><msg @l="236" char_id="-1" frame_id="-1" name=""   text="可能是因为自从退出游泳部后就再也没穿过泳衣了吧。" voices=""/><msg @l="238" char_id="-1" frame_id="-1" name="朽木" text="『………。』" voices=""/><msg @l="240" char_id="0" frame_id="-1" name="美帆" text="『……唔…。』" voices=""/><msg @l="242" char_id="-1" frame_id="-1" name=""   text="为了逃避教授的目光，我迅速穿好泳衣，按照他的指示躺在了桌子上。" voices=""/><clear @l="245" class="all"/><label @l="248" id="chart_line50"/><wait_chgmv/><ev @l="251" src="ev-008ax1y2"/><description @l="254" text="扭曲角色扮演游戏(学校泳装)"/><bgm @l="257" src="bgm14" volume="1."/><msg @l="259" char_id="-1" frame_id="-1" name="朽木"   text="『呵呵，学校泳衣的触感真不错。』" voices=""/><msg @l="261" char_id="-1" frame_id="-1" name=""   text="教授沿着紧贴着肌肤的学校泳衣，用指尖滑过我的身体，仿佛在抚摸一般。" voices=""/><msg @l="263" char_id="-1" frame_id="-1" name="朽木"   text="『这种尼龙材质的触感真是让人欲火焚身啊……而且，这种紧绷感简直无法抗拒。』" voices=""/><msg @l="265" char_id="-1" frame_id="-1" name=""   text="教授边说着边隔着泳衣抚摸我的胸部和下体。我只能屏住呼吸，继续忍受着这一切。" voices=""/><msg @l="266" char_id="-1" frame_id="-1" name=""   text="他的手指覆在我的胸上，肆意揉捏。透过薄薄的泳衣布料，触感直接传递到皮肤上。" voices=""/><msg @l="267" char_id="-1" frame_id="-1" name=""   text="不知是泳衣太小还是因为没穿胸衣的缘故，胸前的突起隐约可见。每当教授的指尖划过那个位置时，上半身就像被轻微电流通过一般，感受到一阵刺激。"   voices=""/><msg @l="269" char_id="0" frame_id="-1" name="美帆" text="『……唔……。』"   voices="miho00960"/><msg @l="271" char_id="-1" frame_id="-1" name="朽木"   text="『哎呀，只是稍微抚摸一下乳头就已经挺立起来了吧。真是敏感的孩子。』" voices=""/><msg @l="273" char_id="-1" frame_id="-1" name=""   text="丰满的乳房如同水果般充满活力，教授感受到掌心那种吸附般的触感。这种愉悦感让他嘴角露出了淫笑。" voices=""/><msg @l="275" char_id="0" frame_id="-1" name="美帆" text="『嗯，唔唔……啊啊。』"   voices="miho10940"/><msg @l="277" char_id="-1" frame_id="-1" name=""   text="即使仰躺着也不会垮塌的胸部上，乳头骄傲地挺立着，即便隔着泳衣也能看出明显的凸起。教授用手指捏住那突起的顶端。"   voices=""/><msg @l="279" char_id="0" frame_id="-1" name="美帆" text="『嗯、啊呜……。』"   voices="miho09920"/><msg @l="281" char_id="-1" frame_id="-1" name="朽木"   text="『这边的地方应该也差不多痊愈了吧。』" voices=""/><msg @l="283" char_id="-1" frame_id="-1" name=""   text="说着，他的手指沿着泳衣覆盖下我的缝隙形状滑动。虽然厌恶感让我想要合拢双腿，但教授的身体已经挤进我的腿间，让我无法动弹。"   voices=""/><msg @l="284" char_id="-1" frame_id="-1" name=""   text="在这个失去处女之地，居然还要遭受更多的凌辱……" voices=""/><msg @l="285" char_id="-1" frame_id="-1" name=""   text="他用力将手指压进柔软的肉缝中，让泳衣更深地嵌入秘裂之间。然后，他的淫秽爱抚变得更加强烈。" voices=""/><msg @l="287" char_id="-1" frame_id="-1" name="朽木"   text="『呵呵呵，已经湿了吗？即使假装抗拒，身体还是很诚实地有了感觉吧。』" voices=""/><msg @l="289" char_id="0" frame_id="-1" name="美帆" text="『不，不是……嗯啊啊！』"   voices="miho01770"/><msg @l="291" char_id="-1" frame_id="-1" name=""   text="与我的意志相反，泳衣覆盖下腹部的小块布料上，已经形成了一块湿润且清晰可见的黑色痕迹。" voices=""/><msg @l="292" char_id="-1" frame_id="-1" name=""   text="最初被触碰时还感到刺痛的阴唇，现在已经不那么疼了，反而开始感受到一种甜美的感觉。"   voices=""/><msg @l="294" char_id="-1" frame_id="-1" name="朽木"   text="『好了，那么现在让我们来品尝里面的滋味吧。』" voices=""/><msg @l="296" char_id="-1" frame_id="-1" name=""   text="带着笑容咕哝着，朽木教授用在缝隙上爬行的指尖拨开了泳衣的布料，露出了我的秘部。" voices=""/><msg @l="297" char_id="-1" frame_id="-1" name=""   text="然后，他把脸贴近我的股间，开始发出嗅闻的声音。" voices=""/><msg @l="299" char_id="-1" frame_id="-1" name="朽木"   text="『哦，好香啊。这是一种难以言喻的芳香。』" voices=""/><msg @l="301" char_id="-1" frame_id="-1" name=""   text="尼龙布料中积聚的气味被释放出来，淫欲的浓郁官能香气刺激着教授的鼻腔。" voices=""/><msg @l="303" char_id="0" frame_id="-1" name="美帆"   text="『嗯啊……不、不行啊………这种，唔！』" voices="miho10110"/><msg @l="305" char_id="-1" frame_id="-1" name=""   text="然后，教授开始缓慢舔舐着阴唇。他将舌尖尖起来，像钻头一样插入那狭窄的蜜壶之中。" voices=""/><msg @l="306" char_id="-1" frame_id="-1" name=""   text="他一边享受着大腿肉紧贴两颊的舒适感，一边贪婪地进行着舔舐。" voices=""/><msg @l="308" char_id="-1" frame_id="-1" name="朽木"   text="『呵呵呵……你这里似乎已经迫不及待地想要我的东西了。』" voices=""/><msg @l="310" char_id="-1" frame_id="-1" name=""   text="然后……坚硬滚烫的肉棒前端抵在了暴露的秘部入口处。" voices=""/><msg @l="311" char_id="-1" frame_id="-1" name=""   text="失去处女时那种身体被撕裂般的剧痛重新浮现，秘裂中开始隐隐作痛。" voices=""/><msg @l="313" char_id="0" frame_id="-1" name="美帆"   text="『不、不要……啊……唔唔！！』" voices="miho10270"/><msg @l="315" char_id="0" frame_id="-1" name="美帆" text="『嗯……』"   voices="miho07860"/><msg @l="317" char_id="-1" frame_id="-1" name=""   text="那勃起的东西强硬地撑开了已经开始滴落蜜液的缝隙，径直入侵进来。" voices=""/><msg @l="318" char_id="-1" frame_id="-1" name=""   text="一阵从身体内部被扩张的钝痛袭来，下腹部感受到蜜壶被撑开的强烈压迫感。" voices=""/><msg @l="320" char_id="0" frame_id="-1" name="美帆" text="『呃——————。』"   voices="miho04860"/><msg @l="322" char_id="-1" frame_id="-1" name="朽木"   text="『适应之前可能会有些痛苦……不过，很快就会习惯的。』" voices=""/><msg @l="324" char_id="-1" frame_id="-1" name=""   text="教授一边这样说着，一边慢慢地活动腰部，确认着我的秘处的感觉。" voices=""/><msg @l="326" char_id="0" frame_id="-1" name="美帆"   text="『啊……啊，啊啊……呜咕。』" voices="miho11020"/><msg @l="328" char_id="-1" frame_id="-1" name=""   text="太阳穴传来一阵刺痛。为了忍耐，我想要抓住什么。" voices=""/><msg @l="330" char_id="0" frame_id="-1" name="美帆"   text="『至少，请解开我的手……我不会反抗的。』" voices="miho07880"/><msg @l="332" char_id="-1" frame_id="-1" name="朽木"   text="『那很快就会好起来。被束缚的状态会让你感受到最大的愉悦。』" voices=""/><msg @l="334" char_id="0" frame_id="-1" name="美帆" text="『我不……明白。』"   voices="miho07890"/><msg @l="336" char_id="-1" frame_id="-1" name="朽木" text="『那就放松身体，交给我好了。』"   voices=""/><msg @l="338" char_id="-1" frame_id="-1" name=""   text="教授愉悦地低语着，慢慢加快腰部的律动。" voices=""/><msg @l="339" char_id="-1" frame_id="-1" name=""   text="随着腰部的动作，那热烫跳动的硬物发出湿润的声音，摩擦着阴道浅处。" voices=""/><msg @l="341" char_id="0" frame_id="-1" name="美帆" text="『啊……嗯，唔唔……。』"   voices="miho07910"/><msg @l="343" char_id="-1" frame_id="-1" name=""   text="我的口中……不自觉地漏出淫靡的喘息。" voices=""/><msg @l="344" char_id="-1" frame_id="-1" name="" text="于是，我慌忙闭上嘴。"   voices=""/><msg @l="346" char_id="-1" frame_id="-1" name="朽木"   text="『不必忍耐，你也尽情地感受吧。』" voices=""/><msg @l="348" char_id="0" frame_id="-1" name="美帆"   text="『怎么，可能……嗯……啊啊……。』" voices="miho07920"/><msg @l="350" char_id="-1" frame_id="-1" name=""   text="每当那灼热的肉刃在被蜜液润湿的花瓣间进出，一种从未体验过的甜美麻痹感便涌了上来。" voices=""/><msg @l="352" char_id="0" frame_id="-1" name="美帆" text="(我……在感觉到……？)"   voices="miho07930"/><msg @l="354" char_id="0" frame_id="-1" name="美帆"   text="(这种情况下，被套上学校泳衣……然后……)" voices="miho07940"/><msg @l="356" char_id="-1" frame_id="-1" name=""   text="我对自己都难以理解的陌生感觉感到困惑。" voices=""/><msg @l="357" char_id="-1" frame_id="-1" name=""   text="这与摩擦阴蒂或乳头时那种伴随着疼痛的电击般的麻痹感不同。" voices=""/><msg @l="358" char_id="-1" frame_id="-1" name=""   text="这是一种纯粹甜美……同时又缓缓扩散的刺激。" voices=""/><msg @l="359" char_id="-1" frame_id="-1" name=""   text="这种感觉，在我的阴道内一点点扩散开来。" voices=""/><msg @l="361" char_id="-1" frame_id="-1" name="朽木"   text="『呵呵呵，看来你已经适应了。你的阴道壁正在缠绕着肉棒呢。』" voices=""/><msg @l="362" char_id="-1" frame_id="-1" name=""   text="看着结合处进出的肉棒与爱液交织拉丝，教授满意地说道。" voices=""/><msg @l="363" char_id="-1" frame_id="-1" name=""   text="我那里已经完全被从深处溢出的蜜液弄得湿哒哒了。教授像是撞击腰部一般不停地重复着抽插运动。"   voices=""/><msg @l="365" char_id="0" frame_id="-1" name="美帆" text="『嗯嗯，啊，嗯呜……。』"   voices="miho07950"/><msg @l="367" char_id="0" frame_id="-1" name="美帆"   text="『嗯，啊啊……啊………嗯呜！』" voices="miho07960"/><msg @l="369" char_id="-1" frame_id="-1" name="朽木"   text="『明明才刚刚失去处女身没几天，就已经如此淫乱了啊。』" voices=""/><msg @l="371" char_id="-1" frame_id="-1" name=""   text="一边投来羞辱的言语，一边以更加猛烈的势头摩擦着肉褶。" voices=""/><msg @l="373" char_id="0" frame_id="-1" name="美帆"   text="『呀啊……不是，嗯……这种，嗯，嗯嗯！』" voices="miho07970"/><msg @l="375" char_id="-1" frame_id="-1" name=""   text="坚硬的肉先端，正有些粗暴地摩擦着胎内深处。" voices=""/><msg @l="376" char_id="-1" frame_id="-1" name=""   text="已经完全没有了压迫下腹部的那种痛苦感。" voices=""/><msg @l="378" char_id="-1" frame_id="-1" name="朽木"   text="『别撒谎了……你这里正紧紧含住我的东西不放呢。』" voices=""/><msg @l="380" char_id="0" frame_id="-1" name="美帆" text="『嗯嗯……！』"   voices="miho07980"/><msg @l="382" char_id="-1" frame_id="-1" name=""   text="教授更加猛烈地冲刺，像是踩足了油门一般，肉棒不断地撞击着深处的子宫。阴道几乎要切断男根般地收缩着。"   voices=""/><msg @l="384" char_id="0" frame_id="-1" name="美帆" text="『啊啊……我，我……。』"   voices="miho07990"/><msg @l="386" char_id="-1" frame_id="-1" name=""   text="我一边拼命压住几乎要跳起来的腰，一边努力保持着理智。" voices=""/><msg @l="388" char_id="-1" frame_id="-1" name="朽木"   text="『老实地达到高潮吧……我也，快了。』" voices=""/><msg @l="390" char_id="0" frame_id="-1" name="美帆"   text="『啊啊啊，要去……要去，要去了，去了啊啊啊！！』" voices="miho08000"/><msg @l="392" char_id="-1" frame_id="-1" name=""   text="猛地，教授格外深地撞击了一下腰部的瞬间……我的脑中一片空白。" voices=""/><msg @l="393" char_id="-1" frame_id="-1" name=""   text="仅存的一点理智瞬间消失殆尽，如同融化般甜美的麻痹感袭击了全身。" voices=""/><msg @l="395" char_id="0" frame_id="-1" name="美帆" text="『嗯，啊啊啊啊！！』"   voices="miho08010"/><msg @l="397" char_id="-1" frame_id="-1" name="朽木" text="『呃……我也，要射了！！』"   voices=""/><msg @l="400" async="true" char_id="-1" frame_id="-1" name=""   text="要射在哪里……？" voices=""/><select @l="401"><menu @l="404" label="EventLabel_116" text="射在里面"/><menu @l="407" label="EventLabel_117" text="射在外面"/></select><label @l="413" id="EventLabel_116"/><flash @l="416" count="4" fade="100" image="white"/><wait_chgmv/><ev @l="419" src="ev-008ax2y2z1"/><msg @l="421" char_id="0" frame_id="-1" name="美帆" text="『嗯嗯啊啊啊！！』"   voices="miho08020"/><msg @l="423" char_id="-1" frame_id="-1" name=""   text="伴随着猛烈的顶弄，他的精液咕噜咕噜地深深注入我的体内深处。" voices=""/><msg @l="425" char_id="0" frame_id="-1" name="美帆"   text="『呀，啊…啊啊……里面……出来了……嗯嗯……。』" voices="miho08030"/><msg @l="427" char_id="-1" frame_id="-1" name=""   text="咚咚咚……。男根在蜜肉中剧烈跳动，连续喷射着。" voices=""/><msg @l="428" char_id="-1" frame_id="-1" name=""   text="我感受着体内热烫精液的触感，腰肢颤抖着……同时品尝着深深的绝望和甜美的喜悦。" voices=""/><goto @l="431" label="EventLabel_121"/><label @l="435" id="EventLabel_117"/><flash @l="438" count="4" fade="100" image="white"/><wait_chgmv/><ev @l="441" src="ev-008ax2y2z2"/><msg @l="443" char_id="-1" frame_id="-1" name=""   text="在即将达到顶峰的瞬间，教授从我的秘缝中抽出男根，在我被学校泳衣覆盖的小腹上洒落大量白浊液体。" voices=""/><msg @l="445" char_id="0" frame_id="-1" name="美帆"   text="『嗯……哈，哈……嗯嗯…………。』" voices="miho08040"/><msg @l="447" char_id="-1" frame_id="-1" name="" text="炽热的液体渐渐污染了我的学校泳衣，变得一片白浊。"   voices=""/><msg @l="448" char_id="-1" frame_id="-1" name=""   text="我沉浸在如同融化般的高潮中，恍惚地望着那缓缓渗入泳衣的白浊液体。" voices=""/><goto @l="451" label="EventLabel_121"/><label @l="455" id="EventLabel_118"/><msg @l="457" char_id="0" frame_id="-1" name="美帆"   text="『那个……网、网球服……。』" voices=""/><msg @l="459" char_id="-1" frame_id="-1" name=""   text="稍微犹豫了一下后，我拿起了装有网球服的袋子。" voices=""/><msg @l="461" char_id="-1" frame_id="-1" name="朽木"   text="『那么，请立刻换上它然后躺在桌子上。』" voices=""/><msg @l="463" char_id="0" frame_id="-1" name="美帆" text="『知道……了。』"   voices=""/><msg @l="465" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="467" char_id="-1" frame_id="-1" name=""   text="在感受到朽木教授的视线的同时，我从袋子里取出了网球服。" voices=""/><msg @l="469" char_id="0" frame_id="-1" name="美帆"   text="(没想到会以这种方式穿上它……)" voices=""/><msg @l="471" char_id="-1" frame_id="-1" name=""   text="解开衬衫的纽扣，裙子滑落。从背后传来朽木教授猥琐的视线缠绕着我……" voices=""/><char @l="474" id="miho" pos="right" src="miho185"/><char @l="476" id="kutsu" pos="left" src="kutsu018"/><msg @l="478" char_id="-1" frame_id="-1" name="朽木" text="『呵呵呵……』" voices=""/><msg @l="480" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="482" char_id="-1" frame_id="-1" name=""   text="我慢慢地穿上了从袋子里取出的网球服。" voices=""/><msg @l="483" char_id="-1" frame_id="-1" name=""   text="在我更衣的过程中，朽木教授的目光一直缠绕在我的全身。" voices=""/><msg @l="484" char_id="-1" frame_id="-1" name=""   text="系上裙子的钩扣时，我的表情微微扭曲。" voices=""/><msg @l="485" char_id="-1" frame_id="-1" name=""   text="一瞬间……稻庭学长的脸浮现在我的脑海。" voices=""/><msg @l="487" char_id="-1" frame_id="-1" name="朽木"   text="『怎么了？你还没准备好吗？』" voices=""/><msg @l="489" char_id="0" frame_id="-1" name="美帆"   text="『是，是的……马上就好。』" voices=""/><msg @l="491" char_id="-1" frame_id="-1" name=""   text="准备完毕后，我躺在教授的桌子上分开了双腿。" voices=""/><clear @l="494" class="all"/><label @l="497" id="chart_line50"/><wait_chgmv/><ev @l="500" src="ev-008ax1y1"/><description @l="503" text="扭曲角色扮演游戏(网球服)"/><bgm @l="506" src="bgm14" volume="1."/><msg @l="508" char_id="0" frame_id="-1" name="美帆" text="『那个……手，为什么要……？』"   voices="miho08050"/><msg @l="510" char_id="-1" frame_id="-1" name=""   text="教授用细绳将躺在桌子上的我的手绑了起来。" voices=""/><msg @l="511" char_id="-1" frame_id="-1" name="" text="这种东西……对现在的我来说应该已经没有必要了。"   voices=""/><msg @l="513" char_id="-1" frame_id="-1" name="朽木"   text="『这是心理作用。被束缚而失去的自由会凸显出一种背德感。』" voices=""/><msg @l="515" char_id="0" frame_id="-1" name="美帆" text="『是……这样吗。』"   voices="miho08060"/><msg @l="517" char_id="-1" frame_id="-1" name="朽木"   text="『嘛，现在你只要安静地把身体交给我就好。』" voices=""/><msg @l="519" char_id="0" frame_id="-1" name="美帆" text="『好的……。』"   voices="miho08070"/><msg @l="521" char_id="-1" frame_id="-1" name="朽木"   text="『呵呵……果然网球服真不错啊。』" voices=""/><msg @l="523" char_id="-1" frame_id="-1" name="朽木"   text="『尤其是从这短裙下看到的大腿……真是令人难以抗拒啊。』" voices=""/><msg @l="525" char_id="-1" frame_id="-1" name=""   text="朽木教授陶醉地低声呢喃着，一边抚摸着我的大腿。" voices=""/><msg @l="526" char_id="-1" frame_id="-1" name=""   text="他一边摩挲着大腿，一边将指尖移向柔软的腿间。" voices=""/><msg @l="528" char_id="-1" frame_id="-1" name="朽木" text="『哦哦……真是美景。』"   voices=""/><msg @l="530" char_id="-1" frame_id="-1" name=""   text="指尖越过内侧大腿，来到了腿根部。那里的柔软程度超过了大腿的肉感，这种淫欲的刺激使教授的兽欲变得更加残暴。"   voices=""/><msg @l="532" char_id="-1" frame_id="-1" name="朽木"   text="『每次看到穿着网球服训练的女孩，我都在想着要侵犯这短裙下的缝隙。』"   voices=""/><msg @l="534" char_id="-1" frame_id="-1" name=""   text="说着，教授一把扯下了我的内裤。在双腿大开的姿势下，短裙完全无法起到遮挡私处的作用，我的那里毫无抵抗地暴露在朽木教授面前。"   voices=""/><msg @l="536" char_id="0" frame_id="-1" name="美帆" text="『嗯嗯——————！！』"   voices="miho11030"/><msg @l="538" char_id="-1" frame_id="-1" name=""   text="竟然要在失去处女的这个地方，继续遭受凌辱……" voices=""/><msg @l="539" char_id="-1" frame_id="-1" name=""   text="他将手指用力插入暴露出来的柔软肉缝中，进一步加强了淫秽的爱抚。" voices=""/><msg @l="541" char_id="0" frame_id="-1" name="美帆" text="『啊……』"   voices="miho01570"/><msg @l="543" char_id="-1" frame_id="-1" name=""   text="他用手指揉弄着暴露在外的秘缝，另一只手则从上衣下摆伸进去，像是爱抚般搓揉着我的双乳。" voices=""/><msg @l="545" char_id="-1" frame_id="-1" name="朽木"   text="『什么啊，已经湿漉漉的了嘛。你也是个淫乱的家伙啊。』" voices=""/><msg @l="547" char_id="0" frame_id="-1" name="美帆" text="『不，不是……啊啊！』"   voices="miho01770"/><msg @l="549" char_id="-1" frame_id="-1" name="" text="与我的意志相反，蜜液不断溢出。"   voices=""/><msg @l="550" char_id="-1" frame_id="-1" name=""   text="最初被触碰时还会感到刺痛的阴唇，现在已经没那么疼了，反而开始感受到一种甜美的感觉。"   voices=""/><msg @l="552" char_id="-1" frame_id="-1" name="朽木"   text="『好了，那么现在来品尝一下里面的滋味吧。』" voices=""/><msg @l="554" char_id="-1" frame_id="-1" name=""   text="他带着笑意低语着，将脸贴近我的股间，开始发出嗅闻的声音。" voices=""/><msg @l="556" char_id="-1" frame_id="-1" name="朽木"   text="『哦哦，有味道了。这是难以形容的芳香啊。』" voices=""/><msg @l="558" char_id="-1" frame_id="-1" name=""   text="淫欲的浓郁官能气味刺激着教授的鼻腔。" voices=""/><msg @l="560" char_id="0" frame_id="-1" name="美帆"   text="『嗯呜……不、不行……这样，呜呜！』" voices="miho10110"/><msg @l="562" char_id="-1" frame_id="-1" name=""   text="然后，教授开始缓慢舔舐着阴唇。他将舌尖尖起来，像钻头一样插入那狭窄的蜜壶之中。" voices=""/><msg @l="563" char_id="-1" frame_id="-1" name=""   text="他一边享受着大腿肉贴合两颊的舒适感，一边贪婪地进行着舔舐。" voices=""/><msg @l="564" char_id="-1" frame_id="-1" name="朽木"   text="『爱液简直要溢出来了啊。这样看来，休息期间你一定很想念我的东西吧。』" voices=""/><msg @l="566" char_id="-1" frame_id="-1" name=""   text="教授说完拉下拉链，掏出自己的分身，像是在确认媚肉状态般用前端用力摩擦着阴道壁。" voices=""/><msg @l="568" char_id="0" frame_id="-1" name="美帆"   text="『嗯啊……嗯，呜呜……』" voices="miho08090"/><msg @l="570" char_id="-1" frame_id="-1" name=""   text="龟头摩擦阴道壁的瞬间，我感到一阵令人毛骨悚然的麻痹感，随后大量蜜液从深处涌出。" voices=""/><msg @l="571" char_id="-1" frame_id="-1" name=""   text="然而，失去处女时那种身体被撕裂的剧痛又重新袭来，私处开始隐隐作痛。" voices=""/><msg @l="573" char_id="-1" frame_id="-1" name="朽木"   text="『你的深处似乎相当敏感啊。只是稍微摩擦一下，就已经流出这么多液体了。』" voices=""/><msg @l="575" char_id="-1" frame_id="-1" name=""   text="教授喜气洋洋地这么说着，用指尖舀起从交合处溢出的蜜液，涂抹在我的脸颊上。" voices=""/><msg @l="577" char_id="0" frame_id="-1" name="美帆"   text="『啊啊……不是的，这个………不对……嗯嗯！』" voices="miho08100"/><msg @l="579" char_id="-1" frame_id="-1" name="朽木" text="『这没什么好羞耻的吧？』"   voices=""/><msg @l="581" char_id="0" frame_id="-1" name="美帆" text="『怎么会，这种事……嗯，啊啊！！』"   voices="miho08110"/><msg @l="583" char_id="-1" frame_id="-1" name="朽木"   text="『破处的伤应该也差不多痊愈了吧？几天没见了，今天要好好品尝一番。』" voices=""/><msg @l="585" char_id="-1" frame_id="-1" name=""   text="于是朽木教授用指尖分开花瓣，掰开被蜜液润湿的缝隙，把肉棒对准了入口。" voices=""/><msg @l="587" char_id="0" frame_id="-1" name="美帆" text="『嗯嗯……。』"   voices="miho08080"/><msg @l="589" char_id="-1" frame_id="-1" name=""   text="肉棒侵入的瞬间，我的脑海中浮现出失去处女时的恐惧。" voices=""/><msg @l="591" char_id="0" frame_id="-1" name="美帆" text="『啊……！？』"   voices="miho10250"/><msg @l="593" char_id="-1" frame_id="-1" name="" text="光滑细腻的全身肌肤上瞬间冒出大量汗水。"   voices=""/><msg @l="594" char_id="-1" frame_id="-1" name=""   text="柔软的臀肉痉挛抽搐着，一种热块扩张子宫的压迫感在体内蔓延。" voices=""/><msg @l="596" char_id="-1" frame_id="-1" name="朽木"   text="『适应之前可能会有点痛苦……不用担心，很快就会习惯的。』" voices=""/><msg @l="598" char_id="-1" frame_id="-1" name=""   text="教授一边这么说着，一边缓缓地摆动腰部，确认着秘处的状态。" voices=""/><msg @l="599" char_id="-1" frame_id="-1" name=""   text="太阳穴传来阵阵刺痛，眼前一片雪白。" voices=""/><msg @l="601" char_id="0" frame_id="-1" name="美帆"   text="『不，不要……啊……嗯嗯！！』" voices="miho10270"/><msg @l="603" char_id="-1" frame_id="-1" name=""   text="红肿的女阴几乎裂开般地张大，吞入了教授的肉棒。" voices=""/><msg @l="604" char_id="-1" frame_id="-1" name=""   text="甜蜜的爱液不断溢出，如同在清洗磨砺教授的炮身一般缠绕着。" voices=""/><msg @l="606" char_id="-1" frame_id="-1" name="朽木"   text="『呵呵呵，看来已经适应了。你的阴道壁正缠绕着肉棒呢。』" voices=""/><msg @l="608" char_id="-1" frame_id="-1" name=""   text="剧烈疼痛的阴道不知何时似乎已经麻木，疼痛感渐渐消失。接着，仿佛自慰时的快感开始包围全身。"   voices=""/><msg @l="610" char_id="-1" frame_id="-1" name="朽木"   text="『坦率地感受会更好。这样会更轻松的。』" voices=""/><msg @l="612" char_id="-1" frame_id="-1" name=""   text="教授就这样，打断我的话语，摆动着腰部，咕啾咕啾地搅动着阴道深处。" voices=""/><msg @l="613" char_id="-1" frame_id="-1" name=""   text="每当这时，我的腰部都会扩散出一种难以形容的麻痹感。" voices=""/><msg @l="615" char_id="0" frame_id="-1" name="美帆"   text="(这是什么……身体，变得好奇怪……)" voices="miho08120"/><msg @l="617" char_id="0" frame_id="-1" name="美帆"   text="(变得这么热……里面……感觉好舒服……)" voices="miho08130"/><msg @l="619" char_id="-1" frame_id="-1" name=""   text="在甜美融化的意识中，我对自己身体的变化感到困惑。" voices=""/><msg @l="620" char_id="-1" frame_id="-1" name="" text="这种感觉是什么呢。"   voices=""/><msg @l="621" char_id="-1" frame_id="-1" name="" text="这种麻痹感……是什么呢。"   voices=""/><msg @l="623" char_id="-1" frame_id="-1" name="朽木"   text="『更坦率地感受会更好。这样会更轻松的。』" voices=""/><msg @l="625" char_id="-1" frame_id="-1" name=""   text="教授在我耳边低语，一下子加快了腰部的动作，猛烈地撞击着我的双腿之间。" voices=""/><msg @l="627" char_id="0" frame_id="-1" name="美帆"   text="『嗯啊啊……啊，啊啊………嗯，啊呜！！』" voices="miho08140"/><msg @l="629" char_id="-1" frame_id="-1" name=""   text="我那里已经完全被从深处溢出的淫液弄得湿漉漉的。教授像是撞击着腰部一样不停地重复着抽插运动。"   voices=""/><msg @l="630" char_id="-1" frame_id="-1" name=""   text="每一次，我的腰部都会扩散出一种难以言喻的麻痹感。" voices=""/><msg @l="632" char_id="0" frame_id="-1" name="美帆"   text="(这是什么……身体，变得好奇怪……)" voices="miho08120"/><msg @l="634" char_id="0" frame_id="-1" name="美帆"   text="(变得这么热……里面……感觉好舒服……)" voices="miho08130"/><msg @l="636" char_id="-1" frame_id="-1" name=""   text="在甜美融化的意识中，我对自己身体的变化感到困惑。" voices=""/><msg @l="637" char_id="-1" frame_id="-1" name="" text="这种感觉是什么呢。"   voices=""/><msg @l="638" char_id="-1" frame_id="-1" name="" text="这种麻痹感……是什么呢。"   voices=""/><msg @l="640" char_id="-1" frame_id="-1" name="朽木"   text="『很好，就这样达到高潮吧。』" voices=""/><msg @l="642" char_id="-1" frame_id="-1" name=""   text="一边隔着网球服揉捏着我的胸部，教授的嘴角扭曲着。" voices=""/><msg @l="644" char_id="0" frame_id="-1" name="美帆"   text="『嗯嗯，嗯，嗯，嗯……啊，啊啊………』" voices="miho08150"/><msg @l="646" char_id="-1" frame_id="-1" name=""   text="隔着衣服刺激着已经变硬的乳头，我不由自主地甜美地颤抖着身体。" voices=""/><msg @l="648" char_id="0" frame_id="-1" name="美帆"   text="(这种感觉……已经，搞不懂了……)" voices="miho08160"/><msg @l="650" char_id="-1" frame_id="-1" name=""   text="教授更加猛烈地摆动腰部，肉棒猛烈地撞击着深处的子宫。阴道几乎要切断男根般地收缩着。" voices=""/><msg @l="652" char_id="0" frame_id="-1" name="美帆"   text="(穿着网球服……却被，插得这么深……)" voices="miho08170"/><msg @l="654" char_id="-1" frame_id="-1" name="" text="思绪变得混乱不堪。"   voices=""/><msg @l="655" char_id="-1" frame_id="-1" name=""   text="甜美的刺激甚至摧毁了仅存的理性，意识飘离。" voices=""/><msg @l="657" char_id="-1" frame_id="-1" name="朽木" text="『呃……』" voices=""/><msg @l="659" char_id="-1" frame_id="-1" name="" text="教授的腰部抽搐了一下。"   voices=""/><msg @l="661" char_id="0" frame_id="-1" name="美帆"   text="『啊啊……啊，要去，要去了……去，啊啊啊啊啊！！』" voices="miho08180"/><msg @l="664" async="true" char_id="-1" frame_id="-1" name=""   text="要射在哪里……？" voices=""/><select @l="665"><menu @l="668" label="EventLabel_119" text="射在里面"/><menu @l="671" label="EventLabel_120" text="射在外面"/></select><label @l="677" id="EventLabel_119"/><flash @l="680" count="4" fade="100" image="white"/><wait_chgmv/><ev @l="683" src="ev-008ax2y1z1"/><msg @l="685" char_id="0" frame_id="-1" name="美帆" text="『嗯嗯嗯！！』"   voices="miho08190"/><msg @l="687" char_id="-1" frame_id="-1" name=""   text="在我达到高潮的瞬间，大量灼热的白色液体在我的蜜壶中喷射而出。" voices=""/><msg @l="688" char_id="-1" frame_id="-1" name=""   text="伴随着脉动一股一股注入的灼热液体，进一步加速了我在高潮中溶解的愉悦感——让我的头脑变得一片空白。"   voices=""/><msg @l="690" char_id="0" frame_id="-1" name="美帆"   text="『啊……啊啊……好热的……嗯，嗯嗯……』" voices="miho08200"/><msg @l="692" char_id="-1" frame_id="-1" name=""   text="咚咚咚……肉柱在秘缝中一阵阵脉动，连续喷射着。" voices=""/><msg @l="693" char_id="-1" frame_id="-1" name=""   text="我好像发烧一样喃喃自语……腰部不住地颤抖着。" voices=""/><goto @l="696" label="EventLabel_121"/><label @l="700" id="EventLabel_120"/><flash @l="703" count="4" fade="100" image="white"/><wait_chgmv/><ev @l="706" src="ev-008ax2y1z2"/><msg @l="708" char_id="-1" frame_id="-1" name=""   text="在猛烈顶入阴道最深处后，教授从我身体里抽出肉茎，将大量精液洒在了我的网球服上。" voices=""/><msg @l="710" char_id="0" frame_id="-1" name="美帆"   text="『嗯……哈……哈………啊啊………』" voices="miho08210"/><msg @l="712" char_id="-1" frame_id="-1" name="" text="灼热的液体飞溅在网球服上，留下一片白浊。"   voices=""/><msg @l="713" char_id="-1" frame_id="-1" name=""   text="我恍惚地注视着渗入网球服的白浊液体，不禁轻轻叹了口气。" voices=""/><label @l="716" id="EventLabel_121"/><stopbgm @l="719" fadeout="1000"/><clear @l="722" class="all"/><end_scene @l="725"/><wait_chgmv/><bg @l="728" src="bg12"/><bgm @l="731" src="bgm03" volume="1."/><char @l="734" id="kutsu" pos="auto" src="kutsu010"/><description @l="737" text="朽木的奴隶·第2天"/><msg @l="739" char_id="-1" frame_id="-1" name="朽木"   text="『今天感觉相当不错吧？』" voices=""/><msg @l="741" char_id="-1" frame_id="-1" name=""   text="当我慵懒地慢吞吞换衣服时，教授嘴角浮现出下流的笑容，向我搭话。" voices=""/><msg @l="743" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="745" char_id="-1" frame_id="-1" name=""   text="我连回答的力气都没有，只是默默地穿着衣服。" voices=""/><msg @l="746" char_id="-1" frame_id="-1" name=""   text="……同时对身体的变化感到明显的困惑。" voices=""/><msg @l="748" char_id="0" frame_id="-1" name="美帆"   text="(那样地有感觉……变得那么混乱……我，到底怎么了)" voices=""/><msg @l="750" char_id="0" frame_id="-1" name="美帆"   text="(这就是我吗？ 有感觉到都不认识自己了……达到了高潮)" voices=""/><msg @l="752" char_id="0" frame_id="-1" name="美帆"   text="(越来越……感觉自己变成了一个我不认识的我……)" voices=""/><msg @l="754" char_id="0" frame_id="-1" name="美帆" text="(……好可怕……)"   voices=""/><msg @l="756" char_id="0" frame_id="-1" name="美帆"   text="(自己在改变……被玷污……好可怕)" voices=""/><se @l="759" buf="1" src="ノック" volume="1."/><clear @l="762" class="char"/><char @l="764" id="kutsu" pos="left" src="kutsu010"/><char @l="766" id="miho" pos="right" src="miho114"/><msg @l="768" char_id="0" frame_id="-1" name="美帆" text="『……！』" voices=""/><msg @l="770" char_id="-1" frame_id="-1" name=""   text="突然，教授室的门被敲响，我不禁屏住了呼吸。" voices=""/><msg @l="771" char_id="-1" frame_id="-1" name=""   text="慌忙看了一眼钟表，已经是第一节课结束的时间了。" voices=""/><msg @l="772" char_id="-1" frame_id="-1" name=""   text="虽然我已经整理好了仪容，本不该有什么好担心的，可因为心中有愧，心跳自然而然地加快了。" voices=""/><msg @l="774" char_id="-1" frame_id="-1" name="朽木" text="『请进。』" voices=""/><msg @l="776" char_id="-1" frame_id="-1" name="学生A" text="『打扰啦——』"   voices=""/><msg @l="778" char_id="-1" frame_id="-1" name="学生B" text="『打扰——』" voices=""/><msg @l="780" char_id="-1" frame_id="-1" name=""   text="教授的一声请进后，走进来的是几名男学生，我记得在考古学讲座上见过他们几次。" voices=""/><char @l="783" id="miho" pos="right" src="miho115"/><msg @l="785" char_id="-1" frame_id="-1" name="学生A"   text="『哦，这不是仲根吗。在干什么呢？』" voices=""/><msg @l="787" char_id="-1" frame_id="-1" name="学生B"   text="『果然是那个？上周考试的事？』" voices=""/><char @l="790" id="miho" pos="right" src="miho116"/><msg @l="792" char_id="0" frame_id="-1" name="美帆" text="『啊，嗯……差不多吧。』"   voices=""/><msg @l="794" char_id="-1" frame_id="-1" name="学生A" text="『下次一起参加联谊怎么样？』"   voices=""/><msg @l="796" char_id="-1" frame_id="-1" name="学生B"   text="『笨蛋，别在教授面前光明正大地搭讪啊。』" voices=""/><char @l="799" id="miho" pos="right" src="miho015"/><msg @l="801" char_id="0" frame_id="-1" name="美帆"   text="(怎、怎么办……这样尴尬的情况我没法出去啊……)" voices=""/><msg @l="803" char_id="-1" frame_id="-1" name="朽木"   text="『你们……这里不是聊天室吧？』" voices=""/><msg @l="805" char_id="-1" frame_id="-1" name="学生A" text="『对、对不起……』"   voices=""/><msg @l="807" char_id="-1" frame_id="-1" name="学生B"   text="『切……你这家伙真是不分场合啊。』" voices=""/><msg @l="809" char_id="-1" frame_id="-1" name="朽木"   text="『仲根同学，如果事情办完了就赶紧退出去吧。』" voices=""/><char @l="812" id="miho" pos="right" src="miho114"/><msg @l="814" char_id="0" frame_id="-1" name="美帆" text="『诶……啊，好的！』"   voices=""/><clear @l="817" layer="miho"/><msg @l="819" char_id="-1" frame_id="-1" name="" text="于是我朝着出口走去。"   voices=""/><msg @l="821" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="823" char_id="0" frame_id="-1" name="美帆"   text="(难道朽木教授是在帮助我吗……？)" voices=""/><msg @l="825" char_id="-1" frame_id="-1" name=""   text="穿过门的时候，我回头看了一眼，想确认教授的表情。" voices=""/><msg @l="826" char_id="-1" frame_id="-1" name=""   text="只是……他已经开始和后来的两名学生交谈，无法看清他是否有那种表情。" voices=""/><clear @l="829" class="all"/><wait_chgmv/><bg @l="832" src="bg09"/><char @l="835" id="miho" pos="auto" src="miho116"/><msg @l="837" char_id="0" frame_id="-1" name="美帆" text="『……呼。』" voices=""/><msg @l="839" char_id="0" frame_id="-1" name="美帆"   text="(没想到教授会以那种方式来帮助我……)" voices=""/><msg @l="841" char_id="0" frame_id="-1" name="美帆"   text="(但是……也不是说，因此有什么特别的含义)" voices=""/><msg @l="843" char_id="0" frame_id="-1" name="美帆"   text="(怎么回事……我，难道是感到高兴了吗……)" voices=""/><msg @l="845" char_id="0" frame_id="-1" name="美帆" text="(明明被做了那么过分的事……)"   voices=""/><msg @l="847" char_id="-1" frame_id="-1" name=""   text="我一边想着这样的事情，一边深深地叹了口气。" voices=""/><msg @l="849" char_id="0" frame_id="-1" name="美帆" text="『总觉得……我真是个傻瓜啊。』"   voices=""/><msg @l="851" char_id="-1" frame_id="-1" name=""   text="轻声嘀咕着……我开始朝着有第二节课的教室走去。" voices=""/><stopbgm @l="854" fadeout="1000"/><clear @l="857" class="all"/><call @l="860" target="EventLabel_123@root_kutuki04a"/><return @l="861" value="0&#13;&#10;"/></code></xscript>																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																