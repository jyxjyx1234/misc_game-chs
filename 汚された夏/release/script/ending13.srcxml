<?xml version="1.0" encoding="utf-8"?><xscript><debug editor="&quot;C:\Program&#32;Files&#32;(x86)\sakura\sakura.exe&quot;&#32;&quot;%src%&quot;&#32;-Y=%line%"   src="D:\シロップ\町ぐるみの罠＋汚された夏セット版\汚された夏\完成データ\汚された夏\script\text\ending13.txt"/><code><label @l="12" id="EventLabel_51"/><description @l="16" text="然后……"/><eval @l="18" expr="f.numDay=0&#13;&#10;"/><msg @l="20" char_id="-1" frame_id="-1" name="" text="……………………………。"   voices=""/><msg @l="21" char_id="-1" frame_id="-1" name="" text="……………………。" voices=""/><msg @l="22" char_id="-1" frame_id="-1" name="" text="…………。" voices=""/><label @l="26" id="chart_line73"/><wait_chgmv/><ev @l="30" src="ev-060"/><bgm @l="35" src="bgm02" volume="1."/><msg @l="37" char_id="0" frame_id="-1" name="美帆" text="『嗯～～～……啊呼。』"   voices="miho13380"/><msg @l="39" char_id="-1" frame_id="-1" name=""   text="走出正门来到主干道上，我微微伸了个懒腰。" voices=""/><msg @l="40" char_id="-1" frame_id="-1" name=""   text="今天从第一节课开始一直上到现在，腰有点痛。" voices=""/><msg @l="42" char_id="0" frame_id="-1" name="美帆"   text="『明明已经9月了……却还是这么热啊。』" voices="miho13390"/><msg @l="44" char_id="-1" frame_id="-1" name=""   text="走在被晚霞染成橘红色的放学路上，我仰望着西边的天空。" voices=""/><msg @l="45" char_id="-1" frame_id="-1" name=""   text="从那些令人不快的日子起……已经过去了3个月。" voices=""/><msg @l="46" char_id="-1" frame_id="-1" name=""   text="从南总町成功脱离的我，回到了家乡所在的城镇，在附近的私立大学办理了转学手续。" voices=""/><msg @l="47" char_id="-1" frame_id="-1" name=""   text="不过因为中间夹着暑假，实际开始上学也就是两周前的事情。" voices=""/><msg @l="48" char_id="-1" frame_id="-1" name=""   text="老实说……从那个小镇回来后的一段时间里，我什么事都做不了。" voices=""/><msg @l="49" char_id="-1" frame_id="-1" name=""   text="我受伤的心灵，在家人和妹妹亚季奈的鼓励下逐渐康复……现在已经能够正常地过日常生活了。"   voices=""/><msg @l="51" char_id="0" frame_id="-1" name="美帆"   text="（话说……玲小姐，现在怎么样了呢？）" voices=""/><msg @l="53" char_id="-1" frame_id="-1" name=""   text="在确定转入新大学后，我曾多次给玲小姐写信，但只收到过一次回信。" voices=""/><msg @l="54" char_id="-1" frame_id="-1" name=""   text="玲小姐似乎也在为了治愈心灵创伤而与自己内心的创伤进行斗争。" voices=""/><msg @l="55" char_id="-1" frame_id="-1" name=""   text="那时，如果不是玲小姐冒险帮我逃离，现在的我可能还在南总町度过苦难的日子。" voices=""/><msg @l="56" char_id="-1" frame_id="-1" name=""   text="想到这里……无论怎么感谢都不足以表达我的心意。" voices=""/><msg @l="58" char_id="0" frame_id="-1" name="美帆"   text="『今天……不绕路直接回家吧。』" voices="miho13420"/><msg @l="60" char_id="-1" frame_id="-1" name="女性朋友A" text="『美帆～。』" voices=""/><msg @l="62" char_id="-1" frame_id="-1" name="女性朋友B"   text="『我们正准备去吃冰淇淋，美帆要不要一起来？』" voices=""/><msg @l="64" char_id="-1" frame_id="-1" name="" text="同班的朋友看到我后向我打招呼。"   voices=""/><msg @l="65" char_id="-1" frame_id="-1" name=""   text="是啊，在这短短两周内，我一下子交到了两位朋友。" voices=""/><msg @l="66" char_id="-1" frame_id="-1" name=""   text="对于内向的我来说，这是前所未有的交友速度。" voices=""/><msg @l="68" char_id="-1" frame_id="-1" name="女性朋友A"   text="『听说车站前的咖啡店提前推出了秋季菜单哦。』" voices=""/><msg @l="70" char_id="-1" frame_id="-1" name="女性朋友B"   text="『有满满栗子馅的特大冰淇淋圣代哦……美帆当然会一起去吧？』" voices=""/><msg @l="72" char_id="0" frame_id="-1" name="美帆" text="『嗯～，那个啊……』"   voices="miho13430"/><msg @l="74" char_id="-1" frame_id="-1" name=""   text="虽然嘴上说着犹豫的话，但实际上我的心已经做出了决定。" voices=""/><msg @l="75" char_id="-1" frame_id="-1" name=""   text="虽然刚才还在想着早点回家，但现在的我已经完全沉浸在品尝微甜栗子冰淇淋的想象中了。"   voices=""/><msg @l="77" char_id="0" frame_id="-1" name="美帆"   text="(回家路上给她买个小蛋糕吧)" voices="miho13440"/><msg @l="79" char_id="0" frame_id="-1" name="美帆" text="(亚季奈……一定会很高兴吧)"   voices="miho13450"/><msg @l="81" char_id="-1" frame_id="-1" name=""   text="就这样，平淡无奇的日常今天也好，明天也好，就这样一天天过去了。" voices=""/><msg @l="82" char_id="-1" frame_id="-1" name=""   text="我……对于这样悠闲的日子终于回来了，不禁由衷地露出了微笑——。" voices=""/><stopbgm @l="86" fadeout="1000"/><begin_trans @l="92" time="500"/><clear @l="93" layer="cutin_f"/><clear @l="94" layer="cutin"/><end_trans @l="95"/><clear @l="97" class="char"/><msgshow @l="99" show="false"/><wait_chgmv/><bg @l="101" src="white" time="10000"/><clear @l="103" class="ev"/><wait_chgmv/><bg @l="105" src="white"/><eval @l="124" expr="s.flagGallery=1&#13;&#10;"/><eval @l="127" expr="f.b&#32;=&#32;(s.event60flag&#32;==&#32;0)&#13;&#10;"/><eval @l="129" expr="s.event60flag=1&#13;&#10;"/><ending @l="133"/><goto @l="135" cond="!(f.b)&#13;&#10;" label="TempLabel_295"/><wait_chgmv/><bg @l="139" src="newroot"/><wait @l="141" time="5000"/><wait_chgmv/><bg @l="143" src="black"/><label @l="146" id="TempLabel_295"/><return @l="150" value=""/></code></xscript>																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																											