<?xml version="1.0" encoding="utf-8"?><xscript><debug editor="&quot;C:\Program&#32;Files&#32;(x86)\sakura\sakura.exe&quot;&#32;&quot;%src%&quot;&#32;-Y=%line%"   src="D:\シロップ\町ぐるみの罠＋汚された夏セット版\汚された夏\完成データ\汚された夏\script\text\root_inaba01.txt"/><code><label @l="13" id="EventLabel_87"/><description @l="17" text="网球社团入会·第2天"/><eval @l="19" expr="f.numDay=8&#13;&#10;"/><msgshow @l="21" show="false"/><wait_chgmv/><bg @l="23" src="day08" time="2000"/><wait @l="25" time="500"/><wait_chgmv/><bg @l="27" src="black" time="2000"/><msgshow @l="29" show="true"/><wait_chgmv/><bg @l="33" src="bg13m1"/><bgm @l="37" src="bgm02" volume="1."/><char @l="41" id="miho" pos="auto" src="miho050"/><msg @l="43" char_id="0" frame_id="-1" name="美帆" text="『新生欢迎网球大赛，是吗？』"   voices=""/><msg @l="45" char_id="-1" frame_id="-1" name="" text="周一放学后。" voices=""/><msg @l="46" char_id="-1" frame_id="-1" name=""   text="刚到网球社团，就被恰好路过的男社员搭话了。" voices=""/><msg @l="48" char_id="-1" frame_id="-1" name="男会员"   text="『对，这是每年的惯例。明天就要举行了。』" voices=""/><msg @l="50" char_id="-1" frame_id="-1" name="男会员"   text="『原则上所有新生都要参加，你做好心理准备哦。』" voices=""/><char @l="54" id="miho" pos="auto" src="miho056"/><msg @l="56" char_id="0" frame_id="-1" name="美帆"   text="『但我觉得自己没法参加比赛啊？』" voices=""/><msg @l="58" char_id="-1" frame_id="-1" name=""   text="顺便说一句……我连球都还不能很好地击回去。" voices=""/><msg @l="60" char_id="-1" frame_id="-1" name="男会员"   text="『没关系啦，这种比赛就像游戏一样的。』" voices=""/><msg @l="62" char_id="-1" frame_id="-1" name="男会员"   text="『而且，网球大赛前还有午餐会和宾果大会，绝对很有趣。甚至有人说那才是主要活动呢。』"   voices=""/><char @l="66" id="miho" pos="auto" src="miho050"/><msg @l="68" char_id="0" frame_id="-1" name="美帆" text="『那样的话就没问题了……』"   voices=""/><msg @l="70" char_id="-1" frame_id="-1" name="男会员"   text="『OK，那明天中午在这里集合。』" voices=""/><msg @l="72" char_id="0" frame_id="-1" name="美帆" text="『知道了。』" voices=""/><msg @l="74" char_id="-1" frame_id="-1" name="男会员" text="『那就加油练习吧。』"   voices=""/><char @l="78" id="miho" pos="auto" src="miho051"/><msg @l="80" char_id="0" frame_id="-1" name="美帆" text="『啊，好的……谢谢您。』"   voices=""/><msg @l="82" char_id="-1" frame_id="-1" name=""   text="就这样，男社员朝着社团活动室走去。" voices=""/><msg @l="83" char_id="-1" frame_id="-1" name="" text="他今天应该是准备回去了吧。"   voices=""/><char @l="87" id="miho" pos="auto" src="miho050"/><msg @l="89" char_id="0" frame_id="-1" name="美帆" text="『……网球大赛啊。』"   voices=""/><msg @l="91" char_id="-1" frame_id="-1" name=""   text="我喃喃自语，看着自己手中握着的球拍。" voices=""/><msg @l="93" char_id="0" frame_id="-1" name="美帆"   text="（果然……比起技术差的孩子，技术好的孩子给人的印象更好吧？）" voices=""/><msg @l="95" char_id="-1" frame_id="-1" name=""   text="虽然被说是类似游戏的东西，但毕竟是要进行比赛，会被人看到的……" voices=""/><msg @l="96" char_id="-1" frame_id="-1" name=""   text="这样的话，就不能表现得太难看了……" voices=""/><msg @l="98" char_id="0" frame_id="-1" name="美帆" text="（只能多练习了，吧）"   voices=""/><msg @l="100" char_id="-1" frame_id="-1" name=""   text="一边点着头，我一边回想着被教导的内容，开始了练习。" voices=""/><clear @l="106" class="all"/><wait_chgmv/><bg @l="110" src="bg13m1"/><msg @l="112" char_id="0" frame_id="-1" name="美帆" text="『哈……哈……』"   voices=""/><msg @l="114" char_id="-1" frame_id="-1" name=""   text="气喘吁吁的我，将手中球拍的前端放在地面上，轻轻地靠在上面。" voices=""/><msg @l="115" char_id="-1" frame_id="-1" name=""   text="我已经对着墙练习了大约三十分钟的对打。" voices=""/><msg @l="116" char_id="-1" frame_id="-1" name=""   text="不过真正打回球的时间只有10分钟左右，剩下的时间都在跑来跑去捡那些飞得不知去向的球。"   voices=""/><msg @l="118" char_id="0" frame_id="-1" name="美帆"   text="『哈……完全，不能按照想法让球飞出去啊……』" voices=""/><msg @l="120" char_id="-1" frame_id="-1" name=""   text="我鼓着嘴，看着大约5米远处滚动的球。" voices=""/><msg @l="121" char_id="-1" frame_id="-1" name=""   text="虽然我按照玲教导的那样双手握拍，夹紧腋下，尽力做到挥臂笔直……但也只有三分之一的球能打好。"   voices=""/><msg @l="123" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="125" char_id="0" frame_id="-1" name="美帆" text="『嗯——，要不要换个球试试呢。』"   voices=""/><char @l="129" id="miho" pos="auto" src="miho050"/><msg @l="131" char_id="-1" frame_id="-1" name=""   text="终于调整好呼吸的我站了起来，走向装球的盒子。" voices=""/><char @l="135" id="miho" pos="auto" src="miho051"/><msg @l="137" char_id="0" frame_id="-1" name="美帆" text="『所以说你要被换下场啦。』"   voices=""/><msg @l="139" char_id="-1" frame_id="-1" name=""   text="一边轻戳着手中的球一边对它说话，然后放入盒子里。" voices=""/><msg @l="140" char_id="-1" frame_id="-1" name="" text="就在那时……" voices=""/><char @l="144" id="miho" pos="auto" src="miho050"/><msg @l="146" char_id="0" frame_id="-1" name="美帆" text="『咦，是稻庭学长。』"   voices=""/><msg @l="148" char_id="-1" frame_id="-1" name=""   text="在网球场的一角，我发现了稻庭学长的身影。" voices=""/><msg @l="150" char_id="0" frame_id="-1" name="美帆" text="（原来如此……他来了啊）"   voices=""/><msg @l="152" char_id="-1" frame_id="-1" name="" text="我凝视着稻庭学长一会儿。"   voices=""/><msg @l="153" char_id="-1" frame_id="-1" name=""   text="想着如果他看起来很忙的话就不去打扰他，于是环顾四周。" voices=""/><msg @l="154" char_id="-1" frame_id="-1" name=""   text="没有女生围着他……真难得，学长身边竟然一个人都没有。" voices=""/><msg @l="156" char_id="0" frame_id="-1" name="美帆" text="『学长。』" voices=""/><clear @l="159" class="char"/><char @l="161" id="miho" pos="left" src="miho050"/><char @l="164" id="inaba" pos="right" src="inaba050"/><bgm @l="168" src="bgm07" volume="1."/><msg @l="170" char_id="-1" frame_id="-1" name="稻庭" text="『哎呀，今天你也来了啊。』"   voices=""/><msg @l="172" char_id="0" frame_id="-1" name="美帆"   text="『是的……我想尽快提高自己的水平。』" voices=""/><msg @l="174" char_id="-1" frame_id="-1" name="稻庭" text="『有上进心是好事。』"   voices=""/><msg @l="176" char_id="-1" frame_id="-1" name="稻庭"   text="『啊，对了……明天的事你听说了吗？』" voices=""/><msg @l="178" char_id="0" frame_id="-1" name="美帆" text="『是迎新网球大赛吗？』"   voices=""/><msg @l="180" char_id="-1" frame_id="-1" name="稻庭" text="『对对。你的时间安排没问题吧？』"   voices=""/><msg @l="182" char_id="0" frame_id="-1" name="美帆"   text="『嗯，……平日下午我基本上没什么特别的安排。』" voices=""/><msg @l="184" char_id="-1" frame_id="-1" name="稻庭" text="『不和朋友出去玩吗？』"   voices=""/><msg @l="186" char_id="0" frame_id="-1" name="美帆"   text="『偶尔会去购物什么的，但那种活动一般都在周六或周日……』" voices=""/><msg @l="188" char_id="-1" frame_id="-1" name="稻庭"   text="『这样啊。那么约你出去约会的话，平日会比较好吧？』" voices=""/><char @l="192" id="miho" pos="left" src="miho054"/><msg @l="194" char_id="0" frame_id="-1" name="美帆" text="『诶……！？』" voices=""/><msg @l="196" char_id="0" frame_id="-1" name="美帆"   text="『约、约会是……是、是谁约谁啊！？』" voices=""/><msg @l="198" char_id="-1" frame_id="-1" name="稻庭" text="『当然是我约你……怎么了？』"   voices=""/><msg @l="200" char_id="0" frame_id="-1" name="美帆"   text="『为、为为为为为为为……为什么啊？』" voices=""/><msg @l="202" char_id="-1" frame_id="-1" name="稻庭"   text="『为什么……当然是因为我想和你约会啊？』" voices=""/><msg @l="204" char_id="0" frame_id="-1" name="美帆"   text="『请、请别开玩笑了……和我这种人约会根本不会有什么有趣的事吧！？』" voices=""/><msg @l="206" char_id="-1" frame_id="-1" name="稻庭"   text="『是否有趣，不实际约会一下的话是不会知道的吧。』" voices=""/><char @l="210" id="miho" pos="left" src="miho053"/><msg @l="212" char_id="0" frame_id="-1" name="美帆" text="『这、这倒是没错……。』"   voices=""/><msg @l="214" char_id="-1" frame_id="-1" name="稻庭"   text="『难道说……你不愿意和我约会吗？』" voices=""/><msg @l="216" char_id="0" frame_id="-1" name="美帆"   text="『不、不是不愿意……但是。』" voices=""/><msg @l="218" char_id="-1" frame_id="-1" name="稻庭" text="『但是？』" voices=""/><char @l="222" id="miho" pos="left" src="miho050"/><msg @l="224" char_id="0" frame_id="-1" name="美帆" text="『对玲小姐……不太好。』"   voices=""/><msg @l="226" char_id="-1" frame_id="-1" name="稻庭"   text="『啊，原来如此……你是白石的室友对吧。』" voices=""/><msg @l="228" char_id="-1" frame_id="-1" name="稻庭"   text="『那么，你也多少听说过我们之间的关系吗？』" voices=""/><msg @l="230" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="232" char_id="-1" frame_id="-1" name="" text="我默默地点了点头。"   voices=""/><msg @l="233" char_id="-1" frame_id="-1" name="" text="我已经察觉到了自己的心情。"   voices=""/><msg @l="234" char_id="-1" frame_id="-1" name=""   text="我……确实开始被稻庭学长吸引了。" voices=""/><msg @l="235" char_id="-1" frame_id="-1" name=""   text="但是，同时，明知道玲小姐的心意，这样做又感觉像是在背叛她一样。" voices=""/><msg @l="237" char_id="-1" frame_id="-1" name="稻庭"   text="『原来如此，这样的话就不能回答YES了吧。』" voices=""/><msg @l="239" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="241" char_id="-1" frame_id="-1" name="稻庭"   text="『那么，用一起练习来代替约会怎么样？』" voices=""/><char @l="245" id="miho" pos="left" src="miho054"/><msg @l="247" char_id="0" frame_id="-1" name="美帆" text="『啊？』" voices=""/><msg @l="249" char_id="-1" frame_id="-1" name="稻庭"   text="『只是一起练习的话，应该没什么问题吧？』" voices=""/><msg @l="251" char_id="0" frame_id="-1" name="美帆" text="『那个是……』" voices=""/><msg @l="255" async="true" char_id="-1" frame_id="-1" name=""   text="和稻庭学长一起练习……？" voices=""/><select @l="256"><menu @l="260" label="EventLabel_88" text="拜托了"/><menu @l="263" label="EventLabel_89" text="拒绝"/></select><label @l="271" id="EventLabel_88"/><char @l="275" id="miho" pos="left" src="miho053"/><msg @l="277" char_id="0" frame_id="-1" name="美帆"   text="『啊，那个……如果学长不介意的话。』" voices=""/><msg @l="279" char_id="-1" frame_id="-1" name="稻庭" text="『我随时都可以哦。』"   voices=""/><msg @l="281" char_id="0" frame_id="-1" name="美帆" text="『那个……那么，请多指教。』"   voices=""/><msg @l="283" char_id="-1" frame_id="-1" name="稻庭" text="『我才是，请多指教。』"   voices=""/><clear @l="289" class="all"/><wait_chgmv/><bg @l="293" src="bg13m2"/><char @l="297" id="miho" pos="left" src="miho050"/><msg @l="299" char_id="0" frame_id="-1" name="美帆" text="『这样……做，是这样吗？』"   voices=""/><char @l="305" id="inaba" pos="right" src="inaba050"/><msg @l="307" char_id="-1" frame_id="-1" name="稻庭"   text="『对对，尽量不要用多余的力气。』" voices=""/><msg @l="309" char_id="0" frame_id="-1" name="美帆" text="『我，我明白了。』"   voices=""/><msg @l="311" char_id="-1" frame_id="-1" name=""   text="在网球场的一角，我在稻庭学长的陪伴下练习挥拍。" voices=""/><msg @l="312" char_id="-1" frame_id="-1" name=""   text="稻庭学长给出的指示都很准确……虽然昨天今天不管怎么练习都无法让球直直地飞出去，但仅仅一小时就进步得很明显。"   voices=""/><msg @l="314" char_id="-1" frame_id="-1" name="稻庭"   text="『基本上，要把球打回前方，最好是用球拍的甜区击球。』" voices=""/><msg @l="316" char_id="-1" frame_id="-1" name="稻庭"   text="『特别是力量不足的孩子有这方面的劣势，所以必须更准确地使用球拍的甜区，否则比赛中就会拉开差距哦。』" voices=""/><msg @l="318" char_id="0" frame_id="-1" name="美帆" text="『嗯嗯……原来如此……』"   voices=""/><msg @l="320" char_id="-1" frame_id="-1" name="稻庭"   text="『而且，要用球拍的甜区击球，身体相对于来球位置的摆放方式很重要。』" voices=""/><msg @l="322" char_id="0" frame_id="-1" name="美帆" text="『嗯嗯。』" voices=""/><msg @l="324" char_id="-1" frame_id="-1" name="稻庭"   text="『双手握拍的话，很难覆盖太大的左右范围，所以尽量把球引到正面是很重要的。』"   voices=""/><msg @l="326" char_id="0" frame_id="-1" name="美帆" text="『把球引到正面……』"   voices=""/><msg @l="328" char_id="-1" frame_id="-1" name="稻庭"   text="『对，所以迅速追上对方打过来的球很重要。』" voices=""/><msg @l="330" char_id="-1" frame_id="-1" name="稻庭"   text="『我试着从那边抛球给你，你来打打看。』" voices=""/><char @l="334" id="miho" pos="left" src="miho051"/><msg @l="336" char_id="0" frame_id="-1" name="美帆" text="『好的！』" voices=""/><msg @l="338" char_id="-1" frame_id="-1" name="稻庭" text="『加油哦。』"   voices=""/><clear @l="344" class="all"/><wait_chgmv/><bg @l="348" src="bg13a"/><se @l="352" buf="1" src="テニスボール打つ音" volume="1."/><msg @l="354" char_id="-1" frame_id="-1" name=""   text="从球接触到球拍的那一瞬间，手感就完全不同了。" voices=""/><msg @l="355" char_id="-1" frame_id="-1" name=""   text="之前一直感觉很重的网球，在那一刻仿佛完全没有重量，我轻松地挥动了球拍。"   voices=""/><msg @l="356" char_id="-1" frame_id="-1" name=""   text="我回击的球漂亮地回到了稻庭学长那边。" voices=""/><char @l="360" id="miho" pos="auto" src="miho051"/><msg @l="362" char_id="0" frame_id="-1" name="美帆" text="『学长，您看到刚才那一球了吗！？』"   voices=""/><msg @l="364" char_id="-1" frame_id="-1" name=""   text="我微微喘着气，高兴得不得了，朝着学长跑了过去。" voices=""/><clear @l="367" class="char"/><char @l="369" id="miho" pos="left" src="miho051"/><char @l="372" id="inaba" pos="right" src="inaba050"/><msg @l="374" char_id="-1" frame_id="-1" name="稻庭" text="『嗯，刚才那球打得很完美啊。』"   voices=""/><msg @l="376" char_id="-1" frame_id="-1" name="稻庭"   text="『手感……是不是完全不一样了？』" voices=""/><char @l="380" id="miho" pos="left" src="miho054"/><msg @l="382" char_id="0" frame_id="-1" name="美帆"   text="『是的！ 球感觉特别轻啊！』" voices=""/><msg @l="384" char_id="-1" frame_id="-1" name="稻庭"   text="『那就是你击中了球拍的甜区。』" voices=""/><msg @l="386" char_id="0" frame_id="-1" name="美帆" text="『刚才那一下是甜区啊……』"   voices=""/><msg @l="388" char_id="-1" frame_id="-1" name="稻庭"   text="『无论是网球、棒球还是高尔夫，这个道理都是一样的，拍面的中心部分是力量最集中的点。』" voices=""/><msg @l="390" char_id="-1" frame_id="-1" name="稻庭"   text="『所以，当你用甜区击球时，即使不用额外的力气，也能通过离心力让球飞出去或者反弹回去。』"   voices=""/><char @l="394" id="miho" pos="left" src="miho051"/><msg @l="396" char_id="0" frame_id="-1" name="美帆" text="『学长，您教得真好呢！』"   voices=""/><msg @l="398" char_id="-1" frame_id="-1" name="稻庭"   text="『呵呵，谢谢。那么，记住刚才的感觉。』" voices=""/><msg @l="400" char_id="-1" frame_id="-1" name="稻庭"   text="『正面接球并用甜区击打……这是基本功哦。』" voices=""/><msg @l="402" char_id="0" frame_id="-1" name="美帆" text="『是！』" voices=""/><msg @l="404" char_id="-1" frame_id="-1" name="稻庭"   text="『……啊，天快黑了呢。』" voices=""/><char @l="408" id="miho" pos="left" src="miho050"/><msg @l="410" char_id="0" frame_id="-1" name="美帆" text="『说起来……』"   voices=""/><msg @l="412" char_id="-1" frame_id="-1" name=""   text="按照学长的指示看向网球场，周围已经太阳快要落山，变得有些昏暗了。或许是因为太专注于练习，完全没有注意到时间的流逝。"   voices=""/><msg @l="414" char_id="-1" frame_id="-1" name="稻庭" text="『今天就到此为止吧。』"   voices=""/><char @l="418" id="miho" pos="left" src="miho054"/><msg @l="420" char_id="0" frame_id="-1" name="美帆"   text="『啊，可是……我才刚刚掌握要领……。』" voices=""/><msg @l="422" char_id="-1" frame_id="-1" name="稻庭"   text="『勉强可不好。而且明天还有迎新活动，更要保存体力。』" voices=""/><char @l="426" id="miho" pos="left" src="miho050"/><msg @l="428" char_id="0" frame_id="-1" name="美帆" text="『是……啊。』"   voices=""/><msg @l="430" char_id="0" frame_id="-1" name="美帆"   text="『我明白了，今天就到此为止回去吧。』" voices=""/><msg @l="432" char_id="-1" frame_id="-1" name="稻庭"   text="『已经，很晚了啊……要不要我送你到车站？』" voices=""/><char @l="436" id="miho" pos="left" src="miho053"/><msg @l="438" char_id="0" frame_id="-1" name="美帆" text="『啊，呃……可以吗？』"   voices=""/><msg @l="440" char_id="-1" frame_id="-1" name="稻庭" text="『当然我是无所谓的。』"   voices=""/><msg @l="442" char_id="-1" frame_id="-1" name="稻庭"   text="『虽说是在大学校内，但这个时间独自行走也是很危险的。』" voices=""/><msg @l="444" char_id="0" frame_id="-1" name="美帆" text="『那，那就……拜托了。』"   voices=""/><msg @l="446" char_id="-1" frame_id="-1" name="稻庭"   text="『明白了。那就在你换完衣服后在俱乐部大楼前面碰面吧。』" voices=""/><msg @l="448" char_id="0" frame_id="-1" name="美帆" text="『好，好的！』" voices=""/><stopbgm @l="452" fadeout="1000"/><clear @l="458" class="all"/><wait_chgmv/><bg @l="462" src="bg14a"/><bgm @l="466" src="bgm02" volume="1."/><char @l="470" id="miho" pos="auto" src="miho053"/><msg @l="472" char_id="0" frame_id="-1" name="美帆" text="『啊啊啊啊啊啊啊！！』"   voices=""/><msg @l="474" char_id="0" frame_id="-1" name="美帆"   text="『怎么办，怎么办，怎么办！！』" voices=""/><msg @l="476" char_id="-1" frame_id="-1" name=""   text="回到部室后，我背手关上门的瞬间，脸涨得通红，小声地……发出了尖叫。" voices=""/><msg @l="478" char_id="0" frame_id="-1" name="美帆"   text="『感觉气氛超好的对吧……对吧？』" voices=""/><msg @l="480" char_id="-1" frame_id="-1" name="" text="当然，部室里没有其他人。"   voices=""/><msg @l="481" char_id="-1" frame_id="-1" name=""   text="要是有别人在的话……我肯定会因为太害羞而说不出口。" voices=""/><msg @l="483" char_id="0" frame_id="-1" name="美帆"   text="『虽然结果是拒绝了约会……但反过来想也许是好事呢。』" voices=""/><msg @l="485" char_id="0" frame_id="-1" name="美帆"   text="『和前辈约会什么的，肯定会太兴奋然后不停地出糗吧……』" voices=""/><msg @l="487" char_id="-1" frame_id="-1" name=""   text="这么说着……忽然意识到自己心中对玲的顾虑正在逐渐淡薄。" voices=""/><char @l="491" id="miho" pos="auto" src="miho050"/><msg @l="493" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="495" char_id="0" frame_id="-1" name="美帆"   text="『我……为什么擅自这么兴奋啊。』" voices=""/><msg @l="497" char_id="0" frame_id="-1" name="美帆"   text="『做这种，像是抢跑一样的事……。』" voices=""/><msg @l="499" char_id="-1" frame_id="-1" name="" text="但是……现在情况不同了。"   voices=""/><msg @l="500" char_id="-1" frame_id="-1" name=""   text="我对自己的感情……虽然还有些模糊，但已经有所察觉。" voices=""/><msg @l="501" char_id="-1" frame_id="-1" name="" text="那么问题就在于接下来……"   voices=""/><msg @l="502" char_id="-1" frame_id="-1" name="" text="我该如何面对稻庭前辈……"   voices=""/><msg @l="504" char_id="0" frame_id="-1" name="美帆"   text="『玲告诉过我她的心意……』" voices=""/><msg @l="506" char_id="0" frame_id="-1" name="美帆"   text="『尽管如此，我这样什么都不说就跟前辈亲近，果然还是不公平的吧……。』" voices=""/><msg @l="508" char_id="-1" frame_id="-1" name=""   text="轻轻地点了点头……我伸手去拿放在储物柜里的行李。" voices=""/><msg @l="509" char_id="-1" frame_id="-1" name=""   text="但如果我说我喜欢稻庭前辈……那就意味着，我会成为玲的情敌。" voices=""/><msg @l="510" char_id="-1" frame_id="0" name=""   text="「但是……即使你是我的情敌，我也不会输的哦」" voices=""/><msg @l="511" char_id="-1" frame_id="-1" name="" text="玲的这句话突然在我脑海中闪过。"   voices=""/><char @l="516" id="miho" pos="auto" src="miho055"/><msg @l="518" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="520" char_id="-1" frame_id="-1" name=""   text="我从储物柜里拿出包……紧紧地抱在胸前。" voices=""/><stopbgm @l="524" fadeout="1000"/><clear @l="530" class="all"/><wait_chgmv/><bg @l="534" src="bg07b"/><bgm @l="538" src="bgm07" volume="1."/><char @l="542" id="miho" pos="auto" src="miho110"/><msg @l="544" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="546" char_id="-1" frame_id="-1" name=""   text="到达社团大楼前的时候，天已经完全黑了。" voices=""/><msg @l="547" char_id="-1" frame_id="-1" name=""   text="朝入口附近的电灯看去，在那灯光下能看到稻庭前辈的身影。" voices=""/><msg @l="549" char_id="0" frame_id="-1" name="美帆" text="『让您久等了。』"   voices=""/><clear @l="552" class="char"/><char @l="554" id="miho" pos="left" src="miho110"/><char @l="557" id="inaba" pos="right" src="inaba010"/><msg @l="559" char_id="-1" frame_id="-1" name="稻庭"   text="『没关系，我根本就没等多久。』" voices=""/><msg @l="561" char_id="0" frame_id="-1" name="美帆" text="『是吗……那就好。』"   voices=""/><msg @l="563" char_id="-1" frame_id="-1" name="稻庭"   text="『嗯？你是不是有点没精神啊？』" voices=""/><char @l="568" id="miho" pos="left" src="miho113"/><msg @l="570" char_id="0" frame_id="-1" name="美帆" text="『没有……那种事。』"   voices=""/><msg @l="572" char_id="-1" frame_id="-1" name="稻庭"   text="『可能是有点累了吧。今天好好休息一下比较好。』" voices=""/><msg @l="574" char_id="0" frame_id="-1" name="美帆"   text="『感觉我一直在听到同样的话呢……。』" voices=""/><msg @l="576" char_id="-1" frame_id="-1" name="稻庭" text="『一开始大家都是这样的。』"   voices=""/><msg @l="578" char_id="-1" frame_id="-1" name="稻庭"   text="『和自己的身体商量着，慢慢地享受就好了。』" voices=""/><char @l="582" id="miho" pos="left" src="miho010"/><msg @l="584" char_id="0" frame_id="-1" name="美帆" text="『是啊。』" voices=""/><clear @l="590" class="all"/><wait_chgmv/><bg @l="594" src="bg07b"/><char @l="598" id="miho" pos="left" src="miho010"/><char @l="602" id="inaba" pos="right" src="inaba010"/><msg @l="604" char_id="-1" frame_id="-1" name="" text="与稻庭学长两人一起走在校园里。"   voices=""/><msg @l="605" char_id="-1" frame_id="-1" name=""   text="直到几天前，这还是一种无法想象的状况。" voices=""/><msg @l="607" char_id="-1" frame_id="-1" name="稻庭" text="『怎么样，对这个镇子有点习惯了吗？』"   voices=""/><msg @l="609" char_id="0" frame_id="-1" name="美帆"   text="『啊，是的……我想我多少习惯了一些。』" voices=""/><msg @l="611" char_id="-1" frame_id="-1" name="稻庭" text="『那太好了。』"   voices=""/><msg @l="613" char_id="-1" frame_id="-1" name="稻庭"   text="『这个镇子位于相当特殊的地方，所以不适应的人似乎会过得很辛苦。』" voices=""/><char @l="617" id="miho" pos="left" src="miho114"/><msg @l="619" char_id="0" frame_id="-1" name="美帆" text="『辛苦……吗？』"   voices=""/><msg @l="621" char_id="-1" frame_id="-1" name="稻庭"   text="『你看，这个镇子基本上娱乐设施很少吧？』" voices=""/><msg @l="623" char_id="-1" frame_id="-1" name="稻庭"   text="『游戏厅和卡拉OK的数量都不多，一些小众CD和书籍如果不用网购的话很难买到。』" voices=""/><char @l="627" id="miho" pos="left" src="miho011"/><msg @l="629" char_id="0" frame_id="-1" name="美帆"   text="『确实……邻镇很远，所以不能说想去买就去买呢。』" voices=""/><msg @l="631" char_id="0" frame_id="-1" name="美帆"   text="『不过，我没有感到困扰，所以没关系。』" voices=""/><msg @l="633" char_id="-1" frame_id="-1" name="稻庭"   text="『是吗？那样的话，我倒是不介意。』" voices=""/><msg @l="635" char_id="-1" frame_id="-1" name="稻庭" text="『我很喜欢这个镇子呢。』"   voices=""/><char @l="640" id="miho" pos="left" src="miho010"/><msg @l="642" char_id="0" frame_id="-1" name="美帆"   text="『喜欢这个镇子，是有什么美好的回忆吗？』" voices=""/><msg @l="644" char_id="-1" frame_id="-1" name="稻庭"   text="『啊……我从出生起身体就很虚弱，甚至影响到了日常生活。』" voices=""/><msg @l="646" char_id="-1" frame_id="-1" name="稻庭"   text="『但来到这个镇子之后……我康复了。』" voices=""/><char @l="650" id="miho" pos="left" src="miho014"/><msg @l="652" char_id="0" frame_id="-1" name="美帆"   text="『诶……身体虚弱什么的，从现在的学长身上根本看不出来呢。』" voices=""/><msg @l="654" char_id="-1" frame_id="-1" name="稻庭"   text="『医生称之为奇迹。我自己……也是这么认为的。』" voices=""/><msg @l="656" char_id="-1" frame_id="-1" name="稻庭"   text="『于是……为了能够稍微弥补一下童年时无法运动的遗憾，我开始打网球。』" voices=""/><char @l="660" id="miho" pos="left" src="miho110"/><msg @l="662" char_id="0" frame_id="-1" name="美帆" text="『是、这样啊……』"   voices=""/><clear @l="670" class="all"/><wait_chgmv/><bg @l="674" src="bg07b"/><char @l="678" id="miho" pos="left" src="miho010"/><char @l="682" id="inaba" pos="right" src="inaba010"/><msg @l="684" char_id="-1" frame_id="-1" name="稻庭" text="『好了，我就到这里吧。』"   voices=""/><msg @l="686" char_id="-1" frame_id="-1" name=""   text="到达校门附近后，稻庭学长停下了脚步。" voices=""/><msg @l="688" char_id="0" frame_id="-1" name="美帆" text="『那个……学长呢？』"   voices=""/><msg @l="690" char_id="-1" frame_id="-1" name="稻庭"   text="『我是开车来的，得去停车场。』" voices=""/><char @l="694" id="miho" pos="left" src="miho014"/><msg @l="696" char_id="0" frame_id="-1" name="美帆"   text="『诶……停车场，我们不是已经经过了吗！』" voices=""/><msg @l="698" char_id="-1" frame_id="-1" name="稻庭"   text="『啊哈哈，这点路程没什么大不了的。』" voices=""/><msg @l="700" char_id="-1" frame_id="-1" name="稻庭"   text="『我是男生嘛，护送女生是理所当然的。』" voices=""/><char @l="704" id="miho" pos="left" src="miho116"/><msg @l="706" char_id="0" frame_id="-1" name="美帆"   text="『对不起……总是给您添麻烦……。』" voices=""/><msg @l="708" char_id="-1" frame_id="-1" name="稻庭"   text="『说到底是我强行邀请你来练习的，你不用在意。』" voices=""/><msg @l="710" char_id="0" frame_id="-1" name="美帆" text="『可是……。』" voices=""/><msg @l="712" char_id="-1" frame_id="-1" name="稻庭" text="『没事没事。』"   voices=""/><msg @l="714" char_id="-1" frame_id="-1" name="稻庭"   text="『那么，明天的新生欢迎网球大赛……我很期待哦。』" voices=""/><char @l="718" id="miho" pos="left" src="miho011"/><msg @l="720" char_id="0" frame_id="-1" name="美帆" text="『是的！我会加油的！！』"   voices=""/><clear @l="724" layer="inaba"/><msg @l="726" char_id="-1" frame_id="-1" name=""   text="听到我的回答，学长微笑着转身朝停车场走去。" voices=""/><char @l="730" id="miho" pos="left" src="miho011"/><msg @l="732" char_id="0" frame_id="-1" name="美帆" text="『………。』" voices=""/><char @l="736" id="miho" pos="left" src="miho110"/><msg @l="738" char_id="0" frame_id="-1" name="美帆"   text="『稻庭学长也……经历了不少事情啊……。』" voices=""/><msg @l="740" char_id="-1" frame_id="-1" name=""   text="目送学长的背影直到看不见后，我小声嘀咕道。" voices=""/><clear @l="745" class="all"/><wait_chgmv/><bg @l="749" src="bg03b"/><bgm @l="752" src="bgm05" volume="1."/><char @l="755" id="miho" pos="auto" src="miho030"/><description @l="758" text="重归日常"/><eval @l="760" expr="f.numDay=3&#13;&#10;"/><msg @l="763" char_id="-1" frame_id="-1" name=""   text="吃完玲姐亲手做的意大利面汤后，我把两人吃空的盘子叠放在厨房的水槽里。" voices=""/><char @l="766" id="rei" pos="auto" src="rei030"/><msg @l="768" char_id="1" frame_id="-1" name="玲" text="『美帆，要不要和我聊一聊？』"   voices=""/><char @l="771" id="miho" pos="auto" src="miho134"/><msg @l="773" char_id="0" frame_id="-1" name="美帆" text="『好、好的，没问题。』"   voices=""/><msg @l="775" char_id="-1" frame_id="-1" name=""   text="难得看到玲姐一脸严肃地跟我说话，我只好草草收拾了一下，就坐到了她对面的沙发上。" voices=""/><clear @l="777" class="char"/><clear @l="783" class="all"/><msgshow @l="785" show="true"/><msg @l="787" char_id="-1" frame_id="-1" name=""   text="····················。" voices=""/><msg @l="788" char_id="-1" frame_id="-1" name="" text="··············。"   voices=""/><msg @l="789" char_id="-1" frame_id="-1" name="" text="·····。" voices=""/><wait_chgmv/><bg @l="792" src="bg03b"/><char @l="794" id="rei" pos="left" src="rei030"/><char @l="796" id="miho" pos="right" src="miho130"/><msg @l="799" char_id="1" frame_id="-1" name="玲" text="『原来如此……美帆也是冲着稻庭学长去的啊。』"   voices=""/><char @l="802" id="miho" pos="right" src="miho035"/><msg @l="804" char_id="0" frame_id="-1" name="美帆" text="『对、对不起……。』"   voices=""/><char @l="807" id="rei" pos="left" src="rei031"/><msg @l="809" char_id="1" frame_id="-1" name="玲" text="『你不用道歉啦。』"   voices=""/><msg @l="811" char_id="1" frame_id="-1" name="玲" text="『从旁人看来早就一清二楚了。』"   voices=""/><char @l="814" id="miho" pos="right" src="miho133"/><msg @l="816" char_id="0" frame_id="-1" name="美帆" text="『这、这个……。』"   voices=""/><char @l="819" id="rei" pos="left" src="rei033"/><msg @l="821" char_id="1" frame_id="-1" name="玲"   text="『而且我……就算稻庭学长喜欢上了谁……我对他的感情也不会有丝毫动摇。』" voices=""/><char @l="824" id="rei" pos="left" src="rei031"/><msg @l="826" char_id="1" frame_id="-1" name="玲"   text="『所以，你也不必顾虑什么。』" voices=""/><char @l="829" id="miho" pos="right" src="miho136"/><msg @l="831" char_id="0" frame_id="-1" name="美帆" text="『…………。』" voices=""/><msg @l="833" char_id="-1" frame_id="-1" name=""   text="玲姐表面上说得轻松，但那真的是她的真心话吗？" voices=""/><msg @l="834" char_id="-1" frame_id="0" name="" text="「不必有所顾虑。」"   voices=""/><msg @l="835" char_id="-1" frame_id="-1" name=""   text="对于一个接近自己心爱之人的女人，真的能摆出如此宽容的态度吗？" voices=""/><msg @l="837" char_id="-1" frame_id="-1" name=""   text="即使自己的爱意无法得到回应……却仍能继续爱着某个人……" voices=""/><msg @l="839" char_id="-1" frame_id="-1" name=""   text="我不禁自问，我真的能做到这种事吗？" voices=""/><msg @l="841" char_id="-1" frame_id="-1" name=""   text="当然，也许有一天我也会遇到一个让我如此深爱的人。" voices=""/><msg @l="842" char_id="-1" frame_id="-1" name="" text="但是，现在我想不到这样的人。"   voices=""/><msg @l="844" char_id="-1" frame_id="-1" name=""   text="我对稻庭学长的感情……与其说是爱，不如说是憧憬……这样的表达可能更准确。" voices=""/><char @l="847" id="miho" pos="right" src="miho133"/><msg @l="849" char_id="0" frame_id="-1" name="美帆" text="『为什么……您要说这种话呢？』"   voices=""/><char @l="852" id="rei" pos="left" src="rei030"/><msg @l="854" char_id="1" frame_id="-1" name="玲" text="『因为你像妹妹……吧。』"   voices=""/><char @l="857" id="miho" pos="right" src="miho034"/><msg @l="859" char_id="0" frame_id="-1" name="美帆" text="『啊？』" voices=""/><msg @l="861" char_id="1" frame_id="-1" name="玲"   text="『我小时候有个妹妹，但她死产没能来到这个世界。虽然没有任何根据，但和美帆在一起时，总觉得你像是我妹妹的转世……这种话，你会觉得讨厌吗？』"   voices=""/><char @l="864" id="miho" pos="right" src="miho136"/><msg @l="866" char_id="0" frame_id="-1" name="美帆" text="『不，怎么会。』"   voices=""/><char @l="869" id="rei" pos="left" src="rei031"/><msg @l="871" char_id="1" frame_id="-1" name="玲"   text="『所以呢，我希望妹妹能得到幸福，希望她和喜欢的人能有个好结果……即使那个人也是我喜欢的人。』"   voices=""/><char @l="874" id="miho" pos="right" src="miho134"/><msg @l="876" char_id="0" frame_id="-1" name="美帆" text="『我、我也是！』"   voices=""/><char @l="879" id="rei" pos="left" src="rei034"/><msg @l="881" char_id="1" frame_id="-1" name="玲" text="『嗯？』" voices=""/><char @l="884" id="miho" pos="right" src="miho133"/><msg @l="886" char_id="0" frame_id="-1" name="美帆"   text="『我也把玲姐当作真正的姐姐看待。从第一次碰面，到后来在这个房间又见面，我想着能和这么漂亮的人住在同一个房间真是太好了，每天和您聊些无关紧要的事情都觉得很开心……所以！』"   voices=""/><msg @l="888" char_id="0" frame_id="-1" name="美帆" text="『所以我也对玲姐……』"   voices=""/><clear @l="891" layer="rei"/><char @l="893" id="rei" pos="auto" src="rei031"/><msg @l="895" char_id="1" frame_id="-1" name="玲" text="『美帆。』" voices=""/><char @l="898" id="miho" pos="right" src="miho034"/><msg @l="900" char_id="0" frame_id="-1" name="美帆" text="『啊？』" voices=""/><flash @l="903" count="4" fade="100" image="white"/><msg @l="905" char_id="-1" frame_id="-1" name="" text="啪！" voices=""/><msg @l="907" char_id="0" frame_id="-1" name="美帆" text="『好痛！』" voices=""/><msg @l="909" char_id="-1" frame_id="-1" name=""   text="玲姐的脸突然凑近，紧接着毫无预警地弹了我的脑门一下。" voices=""/><char @l="912" id="miho" pos="right" src="miho035"/><msg @l="914" char_id="0" frame_id="-1" name="美帆" text="『您、您干嘛啊，玲姐。』"   voices=""/><char @l="917" id="rei" pos="auto" src="rei030"/><msg @l="919" char_id="1" frame_id="-1" name="玲"   text="『对手可不只有我一个，如果在我们互相客气的时候，稻庭学长被不知道哪来的女人抢走了怎么办？』"   voices=""/><msg @l="921" char_id="0" frame_id="-1" name="美帆" text="『那、那个是……』"   voices=""/><clear @l="924" class="char"/><char @l="926" id="rei" pos="left" src="rei031"/><msg @l="928" char_id="1" frame_id="-1" name="玲"   text="『就算不是我，如果是你的话我也能接受，美帆。所以你也不用对我有所顾虑。』" voices=""/><char @l="931" id="rei" pos="left" src="rei033"/><msg @l="933" char_id="1" frame_id="-1" name="玲"   text="『我们互相加油吧，这是姐姐的请求哦。』" voices=""/><clear @l="936" layer="rei"/><msg @l="938" char_id="-1" frame_id="-1" name=""   text="玲姐一边微笑着说完，一边利落地站起身，回到了自己的房间。" voices=""/><clear @l="941" class="char"/><char @l="943" id="miho" pos="auto" src="miho033"/><msg @l="945" char_id="0" frame_id="1" name="美帆" text="（玲姐，我可以相信您的，对吧。）"   voices=""/><eval @l="951" expr="f.稲庭コーチflag&#32;=&#32;1&#13;&#10;"/><goto @l="954" label="EventLabel_90"/><label @l="958" id="EventLabel_89"/><char @l="962" id="miho" pos="left" src="miho056"/><msg @l="964" char_id="0" frame_id="1" name="美帆"   text="『对、对不起……果然还是对不起学长。』" voices=""/><msg @l="966" char_id="-1" frame_id="-1" name="稻庭" text="『这样啊……真遗憾呢。』"   voices=""/><msg @l="968" char_id="0" frame_id="1" name="美帆" text="『对不起……』" voices=""/><msg @l="970" char_id="-1" frame_id="-1" name="稻庭"   text="『不，没关系……那有什么事的话就叫我吧。』" voices=""/><char @l="974" id="miho" pos="left" src="miho050"/><msg @l="976" char_id="0" frame_id="1" name="美帆" text="『好的……』" voices=""/><clear @l="980" layer="miho"/><bgm @l="984" src="bgm02" volume="1."/><msg @l="986" char_id="-1" frame_id="-1" name=""   text="学长露出平常的微笑，然后离开了。" voices=""/><msg @l="987" char_id="-1" frame_id="-1" name=""   text="如果那个自称是稻庭学长亲卫队的课堂朋友知道我拒绝了稻庭学长的邀请……她会说什么呢？" voices=""/><msg @l="988" char_id="-1" frame_id="-1" name=""   text="恐怕她会怒喊“这个大笨蛋！”也说不定……。" voices=""/><clear @l="991" layer="miho"/><msg @l="993" char_id="0" frame_id="1" name="美帆" text="『……。』" voices=""/><msg @l="995" char_id="0" frame_id="1" name="美帆" text="（我……果然还是有点悬在半空中的感觉）"   voices=""/><msg @l="997" char_id="-1" frame_id="-1" name=""   text="看着稻庭学长离去的背影，我在心中默默地想着。" voices=""/><msg @l="998" char_id="-1" frame_id="-1" name=""   text="西边天空中的太阳……有点，刺眼。" voices=""/><clear @l="1006" class="all"/><wait_chgmv/><bg @l="1010" src="bg07b"/><bgm @l="1014" src="bgm07" volume="1."/><char @l="1018" id="miho" pos="auto" src="miho110"/><msg @l="1020" char_id="0" frame_id="1" name="美帆" text="『……。』" voices=""/><msg @l="1022" char_id="-1" frame_id="-1" name=""   text="从社团楼出来的时候，天已经完全黑了。" voices=""/><msg @l="1023" char_id="-1" frame_id="-1" name=""   text="我拖着疲惫不堪的身体，朝着公交站台走去。" voices=""/><msg @l="1024" char_id="-1" frame_id="-1" name=""   text="当我望向入口附近的电灯时，看到稻庭学长的身影正站在灯光下。" voices=""/><msg @l="1026" char_id="0" frame_id="1" name="美帆" text="『啊，稻庭学长。』"   voices=""/><clear @l="1029" class="char"/><char @l="1031" id="miho" pos="left" src="miho110"/><char @l="1034" id="inaba" pos="right" src="inaba010"/><msg @l="1036" char_id="-1" frame_id="-1" name="稻庭" text="『哎呀，仲根同学，现在才回家吗？』"   voices=""/><msg @l="1038" char_id="0" frame_id="1" name="美帆" text="『啊……嗯。』" voices=""/><msg @l="1040" char_id="-1" frame_id="-1" name="稻庭"   text="『嗯？你是不是有点没精神啊？』" voices=""/><char @l="1045" id="miho" pos="left" src="miho113"/><msg @l="1047" char_id="0" frame_id="1" name="美帆" text="『没有……那种事。』"   voices=""/><msg @l="1049" char_id="-1" frame_id="-1" name="稻庭"   text="『可能是有点累了吧。今天好好休息一下比较好。』" voices=""/><msg @l="1051" char_id="0" frame_id="1" name="美帆"   text="『感觉我一直在听到同样的话呢……。』" voices=""/><msg @l="1053" char_id="-1" frame_id="-1" name="稻庭" text="『一开始大家都是这样的。』"   voices=""/><msg @l="1055" char_id="-1" frame_id="-1" name="稻庭"   text="『和自己的身体商量着，慢慢地享受就好了。』" voices=""/><char @l="1059" id="miho" pos="left" src="miho010"/><msg @l="1061" char_id="0" frame_id="1" name="美帆" text="『是啊。』" voices=""/><clear @l="1067" class="all"/><wait_chgmv/><bg @l="1071" src="bg07b"/><char @l="1075" id="miho" pos="left" src="miho010"/><char @l="1079" id="inaba" pos="right" src="inaba010"/><msg @l="1081" char_id="-1" frame_id="-1" name="" text="与稻庭学长两人一起走在校园里。"   voices=""/><msg @l="1082" char_id="-1" frame_id="-1" name=""   text="直到几天前，这还是一种无法想象的状况。" voices=""/><msg @l="1084" char_id="-1" frame_id="-1" name="稻庭" text="『怎么样，对这个镇子有点习惯了吗？』"   voices=""/><msg @l="1086" char_id="0" frame_id="1" name="美帆"   text="『啊，是的……我想我多少习惯了一些。』" voices=""/><msg @l="1088" char_id="-1" frame_id="-1" name="稻庭" text="『那太好了。』"   voices=""/><msg @l="1090" char_id="-1" frame_id="-1" name="稻庭"   text="『这个镇子位于相当特殊的地方，所以不适应的人似乎会过得很辛苦。』" voices=""/><char @l="1094" id="miho" pos="left" src="miho114"/><msg @l="1096" char_id="0" frame_id="1" name="美帆" text="『辛苦……吗？』"   voices=""/><msg @l="1098" char_id="-1" frame_id="-1" name="稻庭"   text="『你看，这个镇子基本上娱乐设施很少吧？』" voices=""/><msg @l="1100" char_id="-1" frame_id="-1" name="稻庭"   text="『游戏厅和卡拉OK的数量都不多，一些小众CD和书籍如果不用网购的话很难买到。』" voices=""/><char @l="1104" id="miho" pos="left" src="miho011"/><msg @l="1106" char_id="0" frame_id="1" name="美帆"   text="『确实……邻镇很远，所以不能说想去买就去买呢。』" voices=""/><msg @l="1108" char_id="0" frame_id="1" name="美帆"   text="『不过，我没有感到困扰，所以没关系。』" voices=""/><msg @l="1110" char_id="-1" frame_id="-1" name="稻庭"   text="『是吗？那样的话，我倒是不介意。』" voices=""/><msg @l="1112" char_id="-1" frame_id="-1" name="稻庭" text="『我很喜欢这个镇子呢。』"   voices=""/><char @l="1117" id="miho" pos="left" src="miho010"/><msg @l="1119" char_id="0" frame_id="1" name="美帆"   text="『喜欢这个镇子，是有什么美好的回忆吗？』" voices=""/><msg @l="1121" char_id="-1" frame_id="-1" name="稻庭"   text="『啊……我从出生起身体就很虚弱，甚至影响到了日常生活。』" voices=""/><msg @l="1123" char_id="-1" frame_id="-1" name="稻庭"   text="『但来到这个镇子之后……我康复了。』" voices=""/><char @l="1127" id="miho" pos="left" src="miho014"/><msg @l="1129" char_id="0" frame_id="1" name="美帆"   text="『诶……身体虚弱什么的，从现在的学长身上根本看不出来呢。』" voices=""/><msg @l="1131" char_id="-1" frame_id="-1" name="稻庭"   text="『医生称之为奇迹。我自己……也是这么认为的。』" voices=""/><msg @l="1133" char_id="-1" frame_id="-1" name="稻庭"   text="『于是……为了能够稍微弥补一下童年时无法运动的遗憾，我开始打网球。』" voices=""/><char @l="1137" id="miho" pos="left" src="miho110"/><msg @l="1139" char_id="0" frame_id="1" name="美帆" text="『是、这样啊……』"   voices=""/><clear @l="1147" class="all"/><wait_chgmv/><bg @l="1151" src="bg07b"/><char @l="1155" id="miho" pos="left" src="miho010"/><char @l="1159" id="inaba" pos="right" src="inaba010"/><msg @l="1161" char_id="-1" frame_id="-1" name="稻庭" text="『好了，我就到这里吧。』"   voices=""/><msg @l="1163" char_id="-1" frame_id="-1" name=""   text="到达校门附近后，稻庭学长停下了脚步。" voices=""/><msg @l="1165" char_id="0" frame_id="1" name="美帆" text="『那个……学长呢？』"   voices=""/><msg @l="1167" char_id="-1" frame_id="-1" name="稻庭"   text="『我是开车来的，得去停车场才行。』" voices=""/><msg @l="1169" char_id="-1" frame_id="-1" name=""   text="学长向我展示了他手指间把玩的带有车钥匙的钥匙扣。" voices=""/><char @l="1173" id="miho" pos="left" src="miho014"/><msg @l="1175" char_id="0" frame_id="1" name="美帆"   text="『咦……停车场不是已经过了吗！』" voices=""/><msg @l="1177" char_id="-1" frame_id="-1" name="稻庭"   text="『啊哈哈，这点路程没什么大不了的。』" voices=""/><msg @l="1179" char_id="-1" frame_id="-1" name="稻庭"   text="『我是男生嘛，护送女生是理所当然的。』" voices=""/><char @l="1183" id="miho" pos="left" src="miho116"/><msg @l="1185" char_id="0" frame_id="1" name="美帆" text="『可是……』" voices=""/><msg @l="1187" char_id="-1" frame_id="-1" name="稻庭" text="『没事没事。』"   voices=""/><msg @l="1189" char_id="-1" frame_id="-1" name="稻庭"   text="『那么，明天的新生欢迎网球大赛……我很期待哦。』" voices=""/><char @l="1193" id="miho" pos="left" src="miho011"/><msg @l="1195" char_id="0" frame_id="1" name="美帆" text="『好的！我会加油的！！』"   voices=""/><clear @l="1199" layer="inaba"/><msg @l="1201" char_id="-1" frame_id="-1" name=""   text="听到我的回答，学长微笑着，朝停车场方向走去。" voices=""/><char @l="1205" id="miho" pos="left" src="miho011"/><msg @l="1207" char_id="0" frame_id="1" name="美帆" text="『……。』" voices=""/><char @l="1211" id="miho" pos="left" src="miho110"/><msg @l="1213" char_id="0" frame_id="1" name="美帆"   text="『稻庭学长也……经历了不少事情啊……。』" voices=""/><msg @l="1215" char_id="-1" frame_id="-1" name=""   text="在目送学长的背影消失在视线中之后，我轻声呢喃道。" voices=""/><label @l="1219" id="EventLabel_90"/><stopbgm @l="1223" fadeout="1000"/><clear @l="1229" class="all"/><call @l="1233" target="EventLabel_91@root_inaba02"/><return @l="1234" value="0&#13;&#10;"/><return @l="1238" value=""/></code></xscript>																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																												