<?xml version="1.0" encoding="utf-8"?><xscript><debug editor="&quot;C:\Program&#32;Files&#32;(x86)\sakura\sakura.exe&quot;&#32;&quot;%src%&quot;&#32;-Y=%line%"   src="D:\シロップ\町ぐるみの罠＋汚された夏セット版\汚された夏\完成データ\汚された夏\script\text\common_root05.txt"/><code><label @l="19" id="EventLabel_35"/><description @l="23" text="丰富日常的片段"/><eval @l="25" expr="f.numDay=5&#13;&#10;"/><msgshow @l="27" show="false"/><wait_chgmv/><bg @l="29" src="day05" time="2000"/><wait @l="31" time="500"/><wait_chgmv/><bg @l="33" src="black" time="2000"/><msgshow @l="35" show="true"/><wait_chgmv/><bg @l="39" src="bg01"/><bgm @l="43" src="bgm02" volume="1."/><char @l="47" id="miho" pos="auto" src="miho010"/><msg @l="49" char_id="0" frame_id="-1" name="美帆" text="『那么我差不多要出门了。』"   voices=""/><clear @l="52" class="char"/><char @l="54" id="miho" pos="left" src="miho010"/><char @l="57" id="rei" pos="right" src="rei034"/><msg @l="59" char_id="1" frame_id="-1" name="玲" text="『啊呀，今天是悠闲地去上学呢。』"   voices=""/><msg @l="61" char_id="1" frame_id="-1" name="玲" text="『第二节课…我觉得你赶不上了吧？』"   voices=""/><msg @l="63" char_id="0" frame_id="-1" name="美帆" text="『今天只有第三节课。』"   voices=""/><msg @l="65" char_id="1" frame_id="-1" name="玲" text="『去上第三节课不是还太早吗？』"   voices=""/><char @l="68" id="miho" pos="left" src="miho111"/><msg @l="70" char_id="0" frame_id="-1" name="美帆"   text="『我想在图书馆找些报告的资料……参考文献是专业书籍，买的话会很贵。』" voices=""/><char @l="74" id="rei" pos="right" src="rei030"/><msg @l="76" char_id="1" frame_id="-1" name="玲" text="『考古学专业看起来也很辛苦呢。』"   voices=""/><msg @l="78" char_id="0" frame_id="-1" name="美帆"   text="『没有那回事。其实从小时候被带去参观古墓而感动开始，我就一直想着有朝一日要学习考古学。』"   voices=""/><msg @l="80" char_id="0" frame_id="-1" name="美帆"   text="『实际接触后，能够翻阅古老的文献，让我非常兴奋，还有机会接触各地的出土文物，真的很有趣。』"   voices=""/><msg @l="82" char_id="1" frame_id="-1" name="玲"   text="『能够边享受边学习真是太棒了呢。』" voices=""/><msg @l="84" char_id="0" frame_id="-1" name="美帆" text="『是的。』" voices=""/><msg @l="86" char_id="1" frame_id="-1" name="玲"   text="『啊，对了……你今天也要去参加社团活动是吧？』" voices=""/><char @l="89" id="miho" pos="left" src="miho010"/><msg @l="91" char_id="0" frame_id="-1" name="美帆"   text="『我是这么打算的……玲小姐，今天也参加不了吗？』" voices=""/><msg @l="93" char_id="1" frame_id="-1" name="玲" text="『不，我想今天应该能去。』"   voices=""/><char @l="97" id="rei" pos="right" src="rei031"/><msg @l="99" char_id="1" frame_id="-1" name="玲" text="『我也想好久不见地见见稻庭先生了。』"   voices=""/><msg @l="101" char_id="-1" frame_id="-1" name="" text="说着，玲小姐高兴地微笑起来。"   voices=""/><msg @l="102" char_id="-1" frame_id="-1" name=""   text="她真的很喜欢稻庭学长啊……我再次深切地感受到这一点。" voices=""/><msg @l="104" char_id="0" frame_id="-1" name="美帆"   text="『不过……社团活动日由成员主导决定，这挺特别的呢。』" voices=""/><msg @l="106" char_id="0" frame_id="-1" name="美帆"   text="『通常社团活动日应该是固定的吧……？』" voices=""/><char @l="110" id="rei" pos="right" src="rei030"/><msg @l="112" char_id="1" frame_id="-1" name="玲" text="『这就是那个社团的好处。』"   voices=""/><msg @l="114" char_id="1" frame_id="-1" name="玲"   text="『没人强制参加，也没有繁琐的规矩和规定。』" voices=""/><msg @l="116" char_id="1" frame_id="-1" name="玲"   text="『尽管如此，每天还是有最低限度的成员聚集，我想这正是因为稻庭先生的魅力所在。』" voices=""/><char @l="119" id="miho" pos="left" src="miho111"/><msg @l="121" char_id="0" frame_id="-1" name="美帆"   text="『是啊，我觉得稻庭学长真的很了不起。』" voices=""/><msg @l="123" char_id="0" frame_id="-1" name="美帆"   text="『明明那么受欢迎，却一点也不摆架子。』" voices=""/><msg @l="125" char_id="1" frame_id="-1" name="玲"   text="『是呢……但是，我觉得那个人的背后有时透着一丝冷漠……』" voices=""/><msg @l="127" char_id="1" frame_id="-1" name="玲" text="『和寂寞不同……我感受到了某种东西。』"   voices=""/><char @l="130" id="miho" pos="left" src="miho116"/><msg @l="132" char_id="0" frame_id="-1" name="美帆" text="『………。』" voices=""/><msg @l="134" char_id="-1" frame_id="-1" name=""   text="玲小姐所说的“冷漠”，我也隐约感受到了。" voices=""/><msg @l="135" char_id="-1" frame_id="-1" name=""   text="稻庭学长那完美笑容背后的冷淡氛围。" voices=""/><msg @l="136" char_id="-1" frame_id="-1" name=""   text="他的笑容越是看起来温柔，就越让人感觉背后隐藏着什么秘密……就是这样的感觉。"   voices=""/><msg @l="137" char_id="-1" frame_id="-1" name=""   text="只是，我认为那种“什么”也许正是为稻庭学长的魅力增光添彩的事实。" voices=""/><char @l="141" id="rei" pos="right" src="rei034"/><msg @l="143" char_id="1" frame_id="-1" name="玲"   text="『啊，不好……我们现在哪有闲功夫聊这些呢？』" voices=""/><char @l="147" id="miho" pos="left" src="miho014"/><msg @l="149" char_id="0" frame_id="-1" name="美帆"   text="『啊……是啊，如果错过了下一班电车的话可能会有点麻烦……』" voices=""/><char @l="153" id="rei" pos="right" src="rei030"/><msg @l="155" char_id="1" frame_id="-1" name="玲" text="『不好意思，莫名其妙地耽误了你的时间。』"   voices=""/><char @l="159" id="miho" pos="left" src="miho110"/><msg @l="161" char_id="0" frame_id="-1" name="美帆"   text="『不，没关系……那么网球场上再见。』" voices=""/><msg @l="163" char_id="1" frame_id="-1" name="玲" text="『嗯。一路顺风。』"   voices=""/><char @l="166" id="miho" pos="left" src="miho111"/><msg @l="168" char_id="0" frame_id="-1" name="美帆" text="『我走了。』" voices=""/><clear @l="174" class="all"/><msgshow @l="176" show="true"/><wait_chgmv/><bg @l="180" src="bg07"/><char @l="184" id="miho" pos="auto" src="miho015"/><bgm @l="188" src="bgm02" volume="1."/><msg @l="191" char_id="0" frame_id="-1" name="美帆" text="(啊…重…)"   voices=""/><msg @l="193" char_id="-1" frame_id="-1" name=""   text="在校园内的图书馆借完报告的参考文献，正在回去的路上。" voices=""/><msg @l="194" char_id="-1" frame_id="-1" name=""   text="我双手抱着三本厚重的专业书，略微踉跄地向有第三节课的教室走去。" voices=""/><msg @l="196" char_id="0" frame_id="-1" name="美帆"   text="(早知道应该带个大包来…)" voices=""/><msg @l="198" char_id="0" frame_id="-1" name="美帆"   text="(比起重量…嘿咻…更讨厌的是不方便携带…)" voices=""/><msg @l="200" char_id="-1" frame_id="-1" name=""   text="为什么专业书好像约好了似的全都是精装版呢。" voices=""/><msg @l="201" char_id="-1" frame_id="-1" name=""   text="虽然我明白精装版更耐用……" voices=""/><msg @l="202" char_id="-1" frame_id="-1" name=""   text="但是，希望他们考虑的不只是耐用性，还有难以携带这一点……" voices=""/><char @l="206" id="miho" pos="auto" src="miho110"/><msg @l="208" char_id="0" frame_id="-1" name="美帆"   text="(算了，抱怨也没用…)" voices=""/><msg @l="210" char_id="0" frame_id="-1" name="美帆"   text="(总之先把这个搬到教室去…然后)" voices=""/><msg @l="213" char_id="3" frame_id="-1" name="女孩" text="『美帆……』" voices=""/><char @l="217" id="miho" pos="auto" src="miho014"/><msg @l="219" char_id="0" frame_id="-1" name="美帆" text="『啊……？』" voices=""/><stopbgm @l="223" fadeout="1000"/><se @l="227" buf="1" src="人とぶつかる音" volume="1."/><char @l="231" id="miho" pos="auto" src="miho014"/><msg @l="233" char_id="0" frame_id="-1" name="美帆" text="『啊！？』" voices=""/><msg @l="235" char_id="-1" frame_id="-1" name=""   text="正好走到十字路口时，突然有人从后面抱住了我。" voices=""/><msg @l="236" char_id="-1" frame_id="-1" name="" text="我慌忙转身看向那个人。"   voices=""/><char @l="240" id="miho" pos="auto" src="miho016"/><msg @l="242" char_id="0" frame_id="-1" name="美帆"   text="『浅……奈那子……原来是你啊。』" voices=""/><msg @l="243" char_id="-1" frame_id="-1" name=""   text="我差点脱口而出叫她“浅间同学”，慌忙改了口。" voices=""/><msg @l="245" char_id="-1" frame_id="-1" name=""   text="突然抱住我的是奈那子。" voices=""/><clear @l="248" class="char"/><char @l="252" id="nanak" pos="center" src="nanako011f" y="-80"/><bgm @l="256" src="bgm06" volume="1."/><msg @l="258" char_id="3" frame_id="-1" name="奈那子" text="『嗅嗅嗅。』"   voices=""/><msg @l="260" char_id="-1" frame_id="-1" name=""   text="奈那子保持着抱住我的姿势，突然发出小小的鼻音，像小狗一样闻起了我的气味。" voices=""/><clear @l="263" class="char"/><char @l="267" id="miho" pos="left" src="miho014"/><char @l="269" id="nanak" pos="auto" src="nanako011"/><msg @l="272" char_id="0" frame_id="-1" name="美帆"   text="『啊！？……奈那子……你在干什么？』" voices=""/><char @l="275" id="nanak" pos="auto" src="nanako012"/><msg @l="277" char_id="3" frame_id="-1" name="奈那子"   text="『诶嘿嘿……美帆身上有种非常温柔的香味呢。』" voices=""/><char @l="281" id="miho" pos="left" src="miho013"/><msg @l="283" char_id="0" frame_id="-1" name="美帆" text="『诶？啊……』" voices=""/><msg @l="285" char_id="-1" frame_id="-1" name=""   text="面对她突如其来的举动和言语，我慌乱之余，听到“温柔”这个评价也不禁害羞起来。" voices=""/><char @l="288" id="nanak" pos="auto" src="nanako013"/><msg @l="290" char_id="3" frame_id="-1" name="奈那子"   text="『……总觉得，像妈妈一样让人安心呢……』" voices=""/><msg @l="292" char_id="-1" frame_id="-1" name=""   text="说完这句话，她就像只小猫一样咕噜咕噜地叫着，亲昵地依偎着我。" voices=""/><char @l="297" id="miho" pos="left" src="miho113"/><msg @l="299" char_id="0" frame_id="-1" name="美帆"   text="『呀……奈那子……好痒啊。』" voices=""/><char @l="302" id="nanak" pos="auto" src="nanako012"/><msg @l="304" char_id="3" frame_id="-1" name="奈那子" text="『美帆～……咕噜咕噜……』"   voices=""/><msg @l="307" char_id="-1" frame_id="-1" name=""   text="撒娇的她显得格外可爱。双马尾的头发散发着阳光的气息。" voices=""/><msg @l="309" char_id="-1" frame_id="-1" name=""   text="不知不觉中，我也心情愉悦地抚摸着她的头，而奈那子则更加亲昵地用脸颊蹭着我。" voices=""/><char @l="312" id="nanak" pos="auto" src="nanako013"/><msg @l="314" char_id="3" frame_id="-1" name="奈那子"   text="『美帆～……咕噜喵～……再多摸摸头。摸摸。』" voices=""/><msg @l="316" char_id="0" frame_id="-1" name="美帆" text="『好好好……奈那子。』"   voices=""/><msg @l="318" char_id="-1" frame_id="-1" name=""   text="我也有种成为妈妈的感觉，轻轻地抚摸着她的头发。" voices=""/><clear @l="320" class="char"/><char @l="323" id="nanak" pos="right" src="nanako010"/><char @l="325" id="miho" pos="left" src="miho113"/><stopbgm @l="328" fadeout="1000"/><msg @l="330" char_id="-1" frame_id="-1" name=""   text="刚才还像猫咪一样撒娇的奈那子突然变得严肃起来。" voices=""/><msg @l="332" char_id="-1" frame_id="-1" name="" text="她面色严峻，在我耳边低声说道。"   voices=""/><msg @l="335" char_id="3" frame_id="-1" name="奈那子"   text="『美帆。快点离开这个镇子吧。不然，会发生无法挽回的事情的。』" voices=""/><char @l="340" id="miho" pos="left" src="miho014"/><msg @l="343" char_id="0" frame_id="-1" name="美帆" text="『啊？』" voices=""/><msg @l="345" char_id="-1" frame_id="-1" name=""   text="被她突然的变化吓了一跳，我凑近看着奈那子的脸。" voices=""/><char @l="349" id="nanak" pos="right" src="nanako015"/><bgm @l="351" src="bgm11" volume="1."/><msg @l="353" char_id="3" frame_id="-1" name="奈那子"   text="『因为美帆是我交到的第一个朋友。所以，我要忠告你……快点离开这个镇子……』" voices=""/><msg @l="355" char_id="-1" frame_id="-1" name="" text="说到这里，她突然捂住了嘴。"   voices=""/><msg @l="356" char_id="-1" frame_id="-1" name=""   text="正当我想继续询问时，感觉到有人靠近，我朝那个方向看去。" voices=""/><msg @l="358" char_id="-1" frame_id="-1" name="声音" text="『奈那子……原来你在这里啊。』"   voices=""/><char @l="362" id="nanak" pos="right" src="nanako014"/><msg @l="364" char_id="3" frame_id="-1" name="奈那子" text="『哥哥！』" voices=""/><clear @l="367" class="char"/><char @l="369" id="nanak" pos="left" src="nanako014"/><char @l="372" id="shiny" pos="right" src="shinya010"/><msg @l="374" char_id="-1" frame_id="-1" name="奈那子的哥哥"   text="『奈那子，我不是告诉过你在我回来之前不要随便外出吗？』" voices=""/><char @l="378" id="nanak" pos="left" src="nanako015"/><msg @l="380" char_id="3" frame_id="-1" name="奈那子" text="『对不起……哥哥。』"   voices=""/><msg @l="382" char_id="3" frame_id="-1" name="奈那子"   text="『但是，我真的很想见美帆……』" voices=""/><msg @l="384" char_id="-1" frame_id="-1" name="奈那子的哥哥" text="『……』"   voices=""/><clear @l="387" class="char"/><char @l="390" id="shiny" pos="left" src="shinya010"/><char @l="393" id="miho" pos="right" src="miho115"/><msg @l="395" char_id="0" frame_id="-1" name="美帆"   text="『那个……我，只是在和奈那子聊天……』" voices=""/><msg @l="397" char_id="-1" frame_id="-1" name=""   text="感受到他不寻常的气氛，我插话说道。" voices=""/><char @l="401" id="shiny" pos="left" src="shinya017"/><msg @l="403" char_id="-1" frame_id="-1" name="奈那子的哥哥" text="『……』"   voices=""/><msg @l="405" char_id="-1" frame_id="-1" name="奈那子的哥哥"   text="『今后，不要与我和奈那子有任何往来。这是为了你好……』" voices=""/><char @l="409" id="shiny" pos="left" src="shinya210"/><msg @l="411" char_id="-1" frame_id="-1" name="奈那子的哥哥"   text="『否则……你会看到不想看的东西。』" voices=""/><char @l="415" id="miho" pos="right" src="miho114"/><msg @l="417" char_id="0" frame_id="-1" name="美帆" text="『啊……？』" voices=""/><msg @l="419" char_id="-1" frame_id="-1" name="奈那子的哥哥" text="『奈那子……过来。』"   voices=""/><clear @l="423" class="char"/><msg @l="425" char_id="3" frame_id="-1" name="奈那子" text="『啊，哥哥……。』"   voices=""/><msg @l="427" char_id="-1" frame_id="-1" name=""   text="被称为奈那子的“哥哥”的男子，就这样转身后快步走向通往大学外的道路。" voices=""/><msg @l="428" char_id="-1" frame_id="-1" name=""   text="接着，奈那子也像是追随着“哥哥”的背影一样跑了出去。" voices=""/><char @l="432" id="miho" pos="auto" src="miho114"/><msg @l="434" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="436" char_id="0" frame_id="-1" name="美帆" text="『不想看到的东西……。』"   voices=""/><char @l="439" id="miho" pos="auto" src="miho116"/><msg @l="441" char_id="0" frame_id="-1" name="美帆" text="『到底是什么呢……。』"   voices=""/><msg @l="443" char_id="-1" frame_id="-1" name=""   text="我被留在原地，思考着各种事情———。" voices=""/><stopbgm @l="447" fadeout="1000"/><clear @l="453" class="all"/><msgshow @l="455" show="true"/><wait_chgmv/><bg @l="459" src="bg13m1"/><bgm @l="463" src="bgm02" volume="1."/><msg @l="465" char_id="-1" frame_id="-1" name="" text="第三节课一结束……。"   voices=""/><msg @l="466" char_id="-1" frame_id="-1" name=""   text="当我想着这个时间应该没有人，来到网球场时，已经有几个社团成员开始了比赛和练习。"   voices=""/><char @l="470" id="miho" pos="auto" src="miho014"/><msg @l="472" char_id="0" frame_id="-1" name="美帆"   text="(哇…这么早就有人在了啊)" voices=""/><msg @l="474" char_id="0" frame_id="-1" name="美帆"   text="(不过，看来玲小姐还没来…)" voices=""/><char @l="478" id="miho" pos="auto" src="miho116"/><msg @l="480" char_id="0" frame_id="-1" name="美帆" text="(怎么办…麻烦了…)"   voices=""/><msg @l="482" char_id="-1" frame_id="-1" name=""   text="虽然已经来到了网球场，但总觉得自己没有立足之地。" voices=""/><msg @l="483" char_id="-1" frame_id="-1" name=""   text="正如活动日和内容都交由社团成员自主决定那样，场地内零星分布的社团成员们，各自在做着自己想做的事情。"   voices=""/><msg @l="484" char_id="-1" frame_id="-1" name=""   text="这种时候，如果有哪怕一个认识的人在场，情况就会大不相同……。" voices=""/><msg @l="485" char_id="-1" frame_id="-1" name=""   text="不巧的是，稻庭学长在场内也不见踪影。" voices=""/><msg @l="487" char_id="0" frame_id="-1" name="美帆"   text="(唉…事情哪有那么顺利呢…)" voices=""/><msg @l="489" char_id="0" frame_id="-1" name="美帆"   text="(必须去问问该怎么做…吧…)" voices=""/><char @l="492" id="miho" pos="auto" src="miho110"/><msg @l="494" char_id="0" frame_id="-1" name="美帆"   text="『那个……我想问一下。』" voices=""/><msg @l="496" char_id="-1" frame_id="-1" name="社团成员" text="『啊？』" voices=""/><msg @l="498" char_id="-1" frame_id="-1" name=""   text="姑且先向就在附近正在分类网球(?)的一位穿着网球服的男生搭话。" voices=""/><msg @l="500" char_id="0" frame_id="-1" name="美帆"   text="『我昨天才刚入会，不太清楚应该做些什么……』" voices=""/><msg @l="502" char_id="-1" frame_id="-1" name="社团成员" text="『啊，好的好的。』"   voices=""/><msg @l="504" char_id="-1" frame_id="-1" name="社团成员"   text="『这样吧……首先，去换衣服如何？』" voices=""/><msg @l="506" char_id="-1" frame_id="-1" name="社团成员"   text="『社团楼的位置你知道吧？那里有社团的休息室和女更衣室。』" voices=""/><char @l="509" id="miho" pos="auto" src="miho111"/><msg @l="511" char_id="0" frame_id="-1" name="美帆" text="『嗯……好的，我知道了……』"   voices=""/><msg @l="513" char_id="-1" frame_id="-1" name="社团成员" text="『……』"   voices=""/><msg @l="515" char_id="-1" frame_id="-1" name="社团成员"   text="『啊，稻庭没来真是可惜啊。』" voices=""/><char @l="518" id="miho" pos="auto" src="miho016"/><msg @l="520" char_id="0" frame_id="-1" name="美帆"   text="『那、那种事……真、真是失礼了……。』" voices=""/><clear @l="526" class="all"/><msg @l="528" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="530" char_id="0" frame_id="-1" name="美帆"   text="(果然，大家都以为我是冲着稻庭学长才加入的……)" voices=""/><msg @l="532" char_id="0" frame_id="-1" name="美帆"   text="(但是……我也不能完全否认这一点………)" voices=""/><msg @l="534" char_id="0" frame_id="-1" name="美帆"   text="(………我………到底想怎么样呢………)" voices=""/><clear @l="540" class="all"/><msgshow @l="542" show="true"/><wait_chgmv/><bg @l="546" src="bg14"/><se @l="550" buf="1" src="部室のドア開ける" volume="1."/><se @l="554" buf="1" src="部室のドア閉まる" volume="1."/><char @l="558" id="miho" pos="auto" src="miho016"/><msg @l="560" char_id="0" frame_id="-1" name="美帆" text="『打、打扰了～……』"   voices=""/><msg @l="562" char_id="-1" frame_id="-1" name=""   text="在社团楼中找到了网球社的休息室，我走了进去。" voices=""/><msg @l="563" char_id="-1" frame_id="-1" name=""   text="大约八叠榻榻米大小的小房间里随意摆放着网球和毛巾等物品，这方面确实给人一种运动系社团的感觉。"   voices=""/><msg @l="564" char_id="-1" frame_id="-1" name=""   text="不过，可能是因为女性比例较高的社团，并没有不整洁的感觉。" voices=""/><char @l="568" id="miho" pos="auto" src="miho110"/><msg @l="570" char_id="0" frame_id="-1" name="美帆"   text="(女更衣室在那边……网球服是穿这个就可以了吧)" voices=""/><msg @l="572" char_id="-1" frame_id="-1" name=""   text="社团活动室的桌子上放着一堆用塑料袋包着的网球服。" voices=""/><msg @l="573" char_id="-1" frame_id="-1" name=""   text="桌子上的网球服看起来都是新的，大概是可以随意选择使用的意思吧。" voices=""/><msg @l="575" char_id="0" frame_id="-1" name="美帆" text="(希望尺寸合适……)"   voices=""/><msg @l="577" char_id="-1" frame_id="-1" name=""   text="我从一堆网球服中选了一件看起来尺寸合适的，然后前往同一社团楼的女更衣室……" voices=""/><clear @l="583" class="all"/><msgshow @l="585" show="true"/><wait_chgmv/><bg @l="589" src="bg13m1"/><char @l="593" id="miho" pos="auto" src="miho050"/><bgm @l="596" src="bgm06" volume="1."/><msg @l="598" char_id="0" frame_id="-1" name="美帆" text="『那个……我换好衣服回来了……』"   voices=""/><msg @l="600" char_id="-1" frame_id="-1" name="社团成员"   text="『哦，尺寸看起来很合适嘛。』" voices=""/><msg @l="602" char_id="-1" frame_id="-1" name="社团成员"   text="『而且，挺适合你的嘛……』" voices=""/><msg @l="604" char_id="-1" frame_id="-1" name=""   text="男社员这么说着，上下打量着我全身。" voices=""/><char @l="608" id="miho" pos="auto" src="miho056"/><msg @l="610" char_id="0" frame_id="-1" name="美帆"   text="(呜……请不要那样盯着看啦………)" voices=""/><msg @l="612" char_id="-1" frame_id="-1" name=""   text="当我扭捏着身体感到害羞时，男社员看到我的举动开心地笑了起来。" voices=""/><msg @l="614" char_id="-1" frame_id="-1" name="社团成员"   text="『新成员的反应真是新鲜有趣啊……不过，很快你就会习惯这身网球服的。虽然现在可能会觉得害羞吧。』"   voices=""/><msg @l="616" char_id="0" frame_id="-1" name="美帆" text="『啊……是、是的。』" voices=""/><char @l="620" id="miho" pos="auto" src="miho050"/><msg @l="622" char_id="0" frame_id="-1" name="美帆"   text="『那、那个……接下来我该做什么呢？』" voices=""/><msg @l="624" char_id="-1" frame_id="-1" name="社团成员"   text="『嗯……你没有打过网球吧？』" voices=""/><msg @l="626" char_id="0" frame_id="-1" name="美帆" text="『啊，是的……没有打过。』"   voices=""/><msg @l="628" char_id="-1" frame_id="-1" name="社团成员"   text="『那么，一开始可以先去那边对着墙壁练习，直到你熟悉球拍的使用为止。』" voices=""/><msg @l="630" char_id="-1" frame_id="-1" name="社团成员"   text="『就是朝着墙壁击球，然后当球弹回来时再打回去。』" voices=""/><msg @l="632" char_id="0" frame_id="-1" name="美帆" text="『我、我明白了。』"   voices=""/><clear @l="636" class="char"/><msg @l="638" char_id="-1" frame_id="-1" name=""   text="我按照他说的，决定去球场边上一堵画有圆形标记的墙壁那里练习。" voices=""/><msg @l="639" char_id="-1" frame_id="-1" name=""   text="……话虽如此，关于网球我可是彻彻底底的门外汉。" voices=""/><msg @l="640" char_id="-1" frame_id="-1" name=""   text="别说对着墙壁打了，我甚至连用球拍击中球，让它笔直飞向墙壁这样简单的事都做不好。" voices=""/><msg @l="641" char_id="-1" frame_id="-1" name=""   text="我打出的球不知为何总是大幅度地向左或向右弹去，即使击中了墙壁，也会朝着奇怪的方向飞走。" voices=""/><msg @l="643" char_id="0" frame_id="-1" name="美帆"   text="(呃，唔……为什么球飞不直啊……？)" voices=""/><msg @l="645" char_id="-1" frame_id="-1" name=""   text="我忽然看向场内正在进行比赛的人们的动作。" voices=""/><msg @l="646" char_id="-1" frame_id="-1" name=""   text="他们看起来轻松地挥动球拍，回击着球。" voices=""/><msg @l="647" char_id="-1" frame_id="-1" name=""   text="但是……即使我做着同样的动作，我打出的球依然飞向莫名其妙的方向。" voices=""/><msg @l="648" char_id="-1" frame_id="-1" name="" text="……果然我还是不擅长球类运动啊……。"   voices=""/><msg @l="650" char_id="1" frame_id="-1" name="声音" text="『呵呵，一个人努力练习呢。』"   voices=""/><char @l="654" id="miho" pos="auto" src="miho054"/><msg @l="656" char_id="0" frame_id="-1" name="美帆" text="『诶……啊，玲小姐！』"   voices=""/><char @l="660" id="rei" pos="auto" src="rei051"/><msg @l="662" char_id="-1" frame_id="-1" name=""   text="我回过头，看到玲小姐正带着愉快的表情打量着我穿网球服的样子。" voices=""/><msg @l="664" char_id="1" frame_id="-1" name="玲" text="『感觉挺青涩的，真不错。』"   voices=""/><clear @l="668" class="char"/><char @l="670" id="rei" pos="left" src="rei050"/><char @l="672" id="miho" pos="right" src="miho053"/><msg @l="674" char_id="0" frame_id="-1" name="美帆" text="『呜呜……请别这么说。』"   voices=""/><msg @l="676" char_id="0" frame_id="-1" name="美帆"   text="『穿着这不习惯的衣服，我真的很害羞啊……。』" voices=""/><char @l="680" id="rei" pos="left" src="rei051"/><msg @l="682" char_id="1" frame_id="-1" name="玲" text="『呵呵，对不起。』"   voices=""/><char @l="686" id="rei" pos="left" src="rei050"/><msg @l="688" char_id="1" frame_id="-1" name="玲"   text="『话说回来……看起来你好像挺苦恼的嘛。』" voices=""/><msg @l="690" char_id="1" frame_id="-1" name="玲"   text="『姑且问一下，你是不是自己也不太明白为什么球飞不直？』" voices=""/><char @l="694" id="miho" pos="right" src="miho056"/><msg @l="696" char_id="0" frame_id="-1" name="美帆"   text="『是的……我本来是想模仿别人的动作的……。』" voices=""/><msg @l="698" char_id="-1" frame_id="-1" name=""   text="于是我试着挥了几下球拍。" voices=""/><msg @l="700" char_id="1" frame_id="-1" name="玲" text="『嗯嗯……。』" voices=""/><msg @l="702" char_id="1" frame_id="-1" name="玲"   text="『握拍和腋下的姿势不够稳啊。因为在击球前一瞬间球拍角度歪了，所以球才飞不直的。』" voices=""/><char @l="706" id="miho" pos="right" src="miho054"/><msg @l="708" char_id="0" frame_id="-1" name="美帆" text="『握拍……？』" voices=""/><msg @l="710" char_id="1" frame_id="-1" name="玲" text="『就是握球拍的方法啦。』"   voices=""/><msg @l="712" char_id="1" frame_id="-1" name="玲"   text="『嗯，基本的方法是把球拍放在地上，然后从正上方普通地握住它。』" voices=""/><char @l="716" id="miho" pos="right" src="miho050"/><msg @l="718" char_id="0" frame_id="-1" name="美帆" text="『是这样吗？』" voices=""/><msg @l="720" char_id="1" frame_id="-1" name="玲"   text="『对对。啊，不要握得太紧哦。不能太用力也不能太轻……。』" voices=""/><msg @l="722" char_id="0" frame_id="-1" name="美帆" text="『这样感觉如何？』"   voices=""/><char @l="725" id="rei" pos="left" src="rei051"/><msg @l="727" char_id="1" frame_id="-1" name="玲"   text="『嗯。手指再交叉一点……对，就这样。』" voices=""/><msg @l="729" char_id="1" frame_id="-1" name="玲" text="『然后击球时要紧紧握住。』"   voices=""/><msg @l="731" char_id="0" frame_id="-1" name="美帆" text="『这样……对吗？』"   voices=""/><char @l="734" id="rei" pos="left" src="rei054"/><msg @l="736" char_id="1" frame_id="-1" name="玲" text="『对……诶，你们在看什么啊。』"   voices=""/><msg @l="738" char_id="0" frame_id="-1" name="美帆" text="『啊？』" voices=""/><msg @l="740" char_id="-1" frame_id="-1" name=""   text="慌忙环顾四周，发现男性部员们一脸坏笑地看着这边。" voices=""/><msg @l="742" char_id="0" frame_id="-1" name="美帆" text="『那、那个，请问有什么事吗……？』"   voices=""/><msg @l="744" char_id="-1" frame_id="-1" name="社团成员"   text="『没什么，我们也想让你握一握我们的呢～』" voices=""/><msg @l="746" char_id="-1" frame_id="-1" name="社团成员"   text="『对对，也想让那白嫩的手指缠绕着紧紧握住呢～』" voices=""/><msg @l="748" char_id="0" frame_id="-1" name="美帆"   text="『诶？像我这样的新手也可以吗？』" voices=""/><msg @l="750" char_id="-1" frame_id="-1" name="社团成员"   text="『嘿嘿，我反而喜欢技术还不太好时那种生涩的感觉，更有感觉！』" voices=""/><char @l="753" id="rei" pos="left" src="rei057"/><char @l="755" id="miho" pos="right" src="miho054"/><msg @l="758" char_id="1" frame_id="-1" name="玲"   text="『够了！你们！！不要再戏弄新部员了！』" voices=""/><msg @l="760" char_id="1" frame_id="-1" name="玲"   text="『再过分的话我就去向稻庭先生报告了。』" voices=""/><msg @l="762" char_id="-1" frame_id="-1" name="社团成员" text="『开、开玩笑的啦。对吧。』"   voices=""/><msg @l="764" char_id="-1" frame_id="-1" name="社团成员" text="『啊，对对。抱歉抱歉。』"   voices=""/><msg @l="766" char_id="-1" frame_id="-1" name="社团成员"   text="『好好，我们这就走啦～白石生气起来很可怕啊～』" voices=""/><msg @l="768" char_id="-1" frame_id="-1" name=""   text="说完这些话，部员们各自回去继续练习了。" voices=""/><char @l="771" id="miho" pos="right" src="miho056"/><msg @l="773" char_id="0" frame_id="-1" name="美帆" text="『那、那个……发生什么事了吗？』"   voices=""/><char @l="776" id="rei" pos="left" src="rei050"/><msg @l="778" char_id="1" frame_id="-1" name="玲"   text="『真是的……唉，美帆。你应该多了解一下男人是什么样的生物。』" voices=""/><char @l="781" id="miho" pos="right" src="miho054"/><msg @l="783" char_id="0" frame_id="-1" name="美帆" text="『啊？』" voices=""/><char @l="786" id="rei" pos="left" src="rei051"/><msg @l="788" char_id="1" frame_id="-1" name="玲" text="『算了。继续练习吧。』"   voices=""/><char @l="791" id="miho" pos="right" src="miho051"/><msg @l="793" char_id="0" frame_id="-1" name="美帆" text="『好、好的。』" voices=""/><char @l="796" id="rei" pos="left" src="rei050"/><msg @l="798" char_id="1" frame_id="-1" name="玲"   text="『那么，接着刚才的内容。按照刚才教你的握法之后，接下来不是用手腕，而是用整个手臂和上半身来……挥动。』" voices=""/><char @l="802" id="miho" pos="right" src="miho056"/><msg @l="804" char_id="0" frame_id="-1" name="美帆"   text="『嗯……看起来很简单其实挺难的呢？』" voices=""/><char @l="808" id="rei" pos="left" src="rei051"/><msg @l="810" char_id="1" frame_id="-1" name="玲"   text="『刚开始可能不太习惯，但只要坚持练习，一定会慢慢变好的。』" voices=""/><char @l="814" id="rei" pos="left" src="rei050"/><msg @l="816" char_id="1" frame_id="-1" name="玲"   text="『总之，最重要的就是握拍姿势。常说万事开头难，对吧？时刻保持正确的握拍姿势非常重要。』"   voices=""/><char @l="820" id="miho" pos="right" src="miho050"/><msg @l="822" char_id="0" frame_id="-1" name="美帆"   text="『确实是这样。不过我还是不太清楚应该怎么挥动…』" voices=""/><char @l="825" id="rei" pos="left" src="rei051"/><msg @l="827" char_id="1" frame_id="-1" name="玲"   text="『嗯，百闻不如一见…我先示范一下墙打，你好好看着。』" voices=""/><char @l="830" id="miho" pos="right" src="miho054"/><msg @l="832" char_id="0" frame_id="-1" name="美帆" text="『好、好的！』" voices=""/><clear @l="838" class="all"/><msgshow @l="840" show="true"/><bgm @l="843" src="bgm04" volume="1."/><wait_chgmv/><bg @l="847" src="bg13m2"/><char @l="851" id="miho" pos="auto" src="miho056"/><msg @l="853" char_id="0" frame_id="-1" name="美帆"   text="『…网球比我想象中的难多了。』" voices=""/><msg @l="855" char_id="-1" frame_id="-1" name=""   text="尽管得到了玲小姐细心的指导，我却仿佛与“进步”这个词完全无缘，球总是被我打向莫名其妙的方向。"   voices=""/><msg @l="856" char_id="-1" frame_id="-1" name=""   text="我明明是按照玲同学说的，正面接住反弹回来的球并回击，但是…球就是不按我的意愿飞。"   voices=""/><clear @l="859" class="char"/><char @l="861" id="miho" pos="left" src="miho056"/><char @l="864" id="rei" pos="right" src="rei051"/><msg @l="866" char_id="1" frame_id="-1" name="玲"   text="『嗯，大家一开始都做不好的…』" voices=""/><msg @l="868" char_id="1" frame_id="-1" name="玲"   text="『总之，我觉得你应该先稳住腰，从熟悉动作开始比较好。』" voices=""/><char @l="872" id="miho" pos="left" src="miho051"/><msg @l="874" char_id="0" frame_id="-1" name="美帆" text="『好的……我会努力的。』"   voices=""/><clear @l="877" class="char"/><char @l="881" id="inaba" pos="auto" src="inaba050"/><msg @l="883" char_id="-1" frame_id="-1" name="稻庭" text="『嘿，看来你已经来了啊。』"   voices=""/><clear @l="886" class="char"/><char @l="888" id="inaba" pos="left" src="inaba050"/><char @l="890" id="miho" pos="right" src="miho051"/><msg @l="892" char_id="0" frame_id="-1" name="美帆" text="『啊，稻庭学长……』"   voices=""/><msg @l="894" char_id="-1" frame_id="-1" name="稻庭"   text="『白石同学，明明自己忙着找工作，还要照顾社团成员，真是不好意思啊。』" voices=""/><char @l="898" id="rei" pos="right" src="rei050"/><msg @l="900" char_id="1" frame_id="-1" name="玲" text="『没关系的，这只是我自己喜欢做而已。』"   voices=""/><char @l="904" id="rei" pos="right" src="rei051"/><msg @l="906" char_id="1" frame_id="-1" name="玲"   text="『而且跟稻庭先生的忙碌相比，我这边还算是比较闲的。』" voices=""/><char @l="910" id="rei" pos="right" src="rei050"/><msg @l="912" char_id="1" frame_id="-1" name="玲"   text="『我听说了哦，你打算参加下一场比赛是吗？』" voices=""/><msg @l="914" char_id="-1" frame_id="-1" name="稻庭"   text="『你还是一如既往地消息灵通啊，白石同学。』" voices=""/><msg @l="916" char_id="1" frame_id="-1" name="玲"   text="『真是的……光是毕业论文就够辛苦了，还要参加比赛，这样身体会吃不消的哦。』" voices=""/><msg @l="918" char_id="-1" frame_id="-1" name="稻庭"   text="『嘛，其实我也不是那么执着于比赛啦……』" voices=""/><msg @l="920" char_id="-1" frame_id="-1" name="稻庭"   text="『因为周围的人都硬要我参赛啊。』" voices=""/><msg @l="922" char_id="1" frame_id="-1" name="玲"   text="『这表明大家对你抱有很高期待呢，不过我觉得还是不要勉强自己比较好。』" voices=""/><msg @l="924" char_id="-1" frame_id="-1" name="稻庭"   text="『没关系，自己的身体状况自己最清楚了。』" voices=""/><char @l="928" id="rei" pos="right" src="rei051"/><msg @l="930" char_id="1" frame_id="-1" name="玲" text="『但愿如此……』"   voices=""/><msg @l="932" char_id="-1" frame_id="-1" name="稻庭"   text="『比起这个，你那边情况怎么样？』" voices=""/><msg @l="934" char_id="-1" frame_id="-1" name="稻庭"   text="『如果我没记错的话……大黑建设的第一轮考试差不多该开始了吧？』" voices=""/><char @l="938" id="rei" pos="right" src="rei050"/><msg @l="940" char_id="1" frame_id="-1" name="玲"   text="『嗯，笔试已经结束了……顺利的话下一步就是面试了。』" voices=""/><msg @l="942" char_id="-1" frame_id="-1" name="稻庭"   text="『是吗，从这里开始才是真正的挑战呢。不过，真没想到白石同学也会报考和我就职的同一家公司啊。如果我们俩都拿到内定的话，要不要一起在大黑建设成立个网球部？』"   voices=""/><msg @l="944" char_id="1" frame_id="-1" name="玲"   text="『呵呵，好啊。我会努力的，这样我们就能再一起打网球了。』" voices=""/><char @l="947" id="miho" pos="center" src="miho054f" y="-80"/><msg @l="949" char_id="0" frame_id="1" name="美帆"   text="（咦？同一家公司……原来如此，玲姐报考的公司就是稻庭学长的公司啊……难道说玲姐是因为想和稻庭学长进同一家公司所以才……？）"   voices=""/><stopbgm @l="953" fadeout="1000"/><char @l="957" id="miho" pos="center" src="miho055f" y="-80"/><bgm @l="961" src="bgm03" volume="1."/><msg @l="963" char_id="0" frame_id="1" name="美帆" text="『……。』" voices=""/><description @l="973" text="摇摆的心"/><msg @l="975" char_id="0" frame_id="1" name="美帆" text="(总感觉我……在这里格格不入……)"   voices=""/><msg @l="977" char_id="-1" frame_id="-1" name=""   text="我被夹在两位学长之间……一个人默默无语。" voices=""/><msg @l="978" char_id="-1" frame_id="-1" name=""   text="可能是因为他们同年级且处境相似，我感觉自己无法融入他们的对话。" voices=""/><msg @l="979" char_id="-1" frame_id="-1" name=""   text="无论是关于就职活动还是网球社的事情，全都是我不了解的世界的话题。" voices=""/><msg @l="980" char_id="-1" frame_id="-1" name=""   text="我非常羡慕他们之间有着共同话题的关系。" voices=""/><msg @l="981" char_id="-1" frame_id="-1" name=""   text="伴随着这种感觉，不知为何心中涌起一股悲伤……" voices=""/><msg @l="982" char_id="-1" frame_id="-1" name=""   text="这大概是因为，这种感觉类似于自己原本认为关系很好的朋友，在自己面前与其他朋友热烈交谈的那种感觉吧？"   voices=""/><msg @l="983" char_id="-1" frame_id="-1" name=""   text="仿佛自己的位置被夺走了一般的失落感。" voices=""/><msg @l="984" char_id="-1" frame_id="-1" name=""   text="我一直都很尊敬玲学姐，对稻庭学长也开始觉得他是个温柔的好学长。" voices=""/><msg @l="985" char_id="-1" frame_id="-1" name=""   text="对于这两个人除我之外关系很好这件事……我是在嫉妒吗？" voices=""/><msg @l="986" char_id="-1" frame_id="-1" name="" text="但是，真的仅仅如此吗……。"   voices=""/><msg @l="988" char_id="0" frame_id="1" name="美帆" text="(连自己的感受都搞不懂……)"   voices=""/><msg @l="990" char_id="0" frame_id="1" name="美帆"   text="(明明是关于自己的事情……为什么会不明白呢)" voices=""/><msg @l="992" char_id="0" frame_id="1" name="美帆" text="『……。』" voices=""/><msg @l="994" char_id="0" frame_id="1" name="美帆"   text="(我……为什么会有这样的感觉呢……)" voices=""/><char @l="998" id="rei" pos="right" src="rei054" z="100"/><msg @l="1000" char_id="1" frame_id="-1" name="玲" text="『美帆……怎么了，美帆？』"   voices=""/><clear @l="1007" class="char"/><bgm @l="1011" src="bgm02" volume="1."/><char @l="1015" id="miho" pos="left" src="miho054"/><msg @l="1018" char_id="0" frame_id="1" name="美帆" text="『诶……啊，什么？』"   voices=""/><char @l="1021" id="rei" pos="right" src="rei050"/><msg @l="1023" char_id="1" frame_id="-1" name="玲"   text="『你没事吧？看起来好像在发呆。』" voices=""/><char @l="1027" id="miho" pos="left" src="miho056"/><msg @l="1029" char_id="0" frame_id="1" name="美帆" text="『啊，是的……没什么事。』"   voices=""/><msg @l="1031" char_id="1" frame_id="-1" name="玲" text="『是吗？』" voices=""/><clear @l="1034" class="char"/><char @l="1038" id="inaba" pos="left" src="inaba050"/><char @l="1040" id="miho" pos="right" src="miho056"/><msg @l="1042" char_id="-1" frame_id="-1" name="稻庭"   text="『因为才刚入会第一天，可能是累了吧。』" voices=""/><msg @l="1044" char_id="0" frame_id="1" name="美帆"   text="『是啊……明明我什么特别的事都没做……』" voices=""/><msg @l="1046" char_id="-1" frame_id="-1" name=""   text="准确地说，我只是做了一下对墙练习，然后在玲学姐的指导下试了试挥拍……" voices=""/><msg @l="1047" char_id="-1" frame_id="-1" name=""   text="没想到我的体力已经差到这种地步了。" voices=""/><msg @l="1049" char_id="-1" frame_id="-1" name="稻庭"   text="『勉强自己导致身体出问题就麻烦了。我觉得今天就到此为止，去休息比较好。』" voices=""/><msg @l="1051" char_id="-1" frame_id="-1" name="稻庭"   text="『白石同学，你今天也可以陪她一起离开了。』" voices=""/><char @l="1055" id="rei" pos="right" src="rei050"/><msg @l="1057" char_id="1" frame_id="-1" name="玲"   text="『也是呢……那么，我就不客气地接受你的建议了。』" voices=""/><char @l="1061" id="miho" pos="left" src="miho056"/><msg @l="1063" char_id="0" frame_id="1" name="美帆" text="『对不起……』"   voices=""/><msg @l="1065" char_id="1" frame_id="-1" name="玲"   text="『如果你真的感到抱歉，那就好好休息恢复体力吧。』" voices=""/><char @l="1068" id="rei" pos="right" src="rei051"/><msg @l="1070" char_id="1" frame_id="-1" name="玲"   text="『好好管理自己的身体状况也很重要哦？』" voices=""/><char @l="1074" id="miho" pos="left" src="miho050"/><msg @l="1076" char_id="0" frame_id="1" name="美帆" text="『是，是的！』" voices=""/><char @l="1080" id="inaba" pos="left" src="inaba050"/><msg @l="1082" char_id="-1" frame_id="-1" name="稻庭"   text="『那么我就先跟后辈们玩会儿游戏，然后再回去吧。』" voices=""/><char @l="1086" id="rei" pos="right" src="rei051"/><msg @l="1088" char_id="1" frame_id="-1" name="玲" text="『不要太欺负后辈们哦。』"   voices=""/><msg @l="1090" char_id="-1" frame_id="-1" name="稻庭" text="『啊哈哈，我会铭记在心的。』"   voices=""/><clear @l="1096" class="all"/><msgshow @l="1098" show="true"/><bgm @l="1101" src="bgm04" volume="1."/><wait_chgmv/><bg @l="1105" src="bg14a"/><se @l="1109" buf="1" src="部室のドア開ける" volume="1."/><se @l="1113" buf="1" src="部室のドア閉まる" volume="1."/><char @l="1117" id="miho" pos="left" src="miho050"/><char @l="1121" id="rei" pos="right" src="rei050"/><msg @l="1123" char_id="1" frame_id="-1" name="玲" text="『……呼。』" voices=""/><char @l="1127" id="rei" pos="right" src="rei051"/><msg @l="1129" char_id="1" frame_id="-1" name="玲"   text="『到了这个季节，就算穿短袖也很热呢。』" voices=""/><msg @l="1131" char_id="0" frame_id="1" name="美帆" text="『…………。』" voices=""/><char @l="1135" id="rei" pos="right" src="rei050"/><msg @l="1137" char_id="1" frame_id="-1" name="玲" text="『美帆……？』" voices=""/><char @l="1141" id="miho" pos="left" src="miho054"/><msg @l="1143" char_id="0" frame_id="1" name="美帆"   text="『呃……啊，啊啊……是，是这样呢。』" voices=""/><char @l="1147" id="rei" pos="right" src="rei054"/><msg @l="1149" char_id="1" frame_id="-1" name="玲" text="『疲劳……很严重吗？』"   voices=""/><char @l="1153" id="miho" pos="left" src="miho056"/><msg @l="1155" char_id="0" frame_id="1" name="美帆"   text="『啊，不是……只是身体有点沉重而已。』" voices=""/><char @l="1159" id="rei" pos="right" src="rei050"/><msg @l="1161" char_id="1" frame_id="-1" name="玲"   text="『那么，先赶紧换衣服回去吧。』" voices=""/><msg @l="1163" char_id="1" frame_id="-1" name="玲"   text="『今天做晚饭的是我，我会使出浑身解数，给你准备一份能增强体力的料理哦。』" voices=""/><char @l="1167" id="miho" pos="left" src="miho050"/><msg @l="1169" char_id="0" frame_id="1" name="美帆"   text="『这么说的话，我会过度期待的哦？』" voices=""/><char @l="1173" id="rei" pos="right" src="rei051"/><msg @l="1175" char_id="1" frame_id="-1" name="玲"   text="『当然，你尽管期待好了。』" voices=""/><msg @l="1177" char_id="1" frame_id="-1" name="玲"   text="『我会好好招待你，让你吃个够特制的营养料理。』" voices=""/><char @l="1181" id="miho" pos="left" src="miho051"/><msg @l="1183" char_id="0" frame_id="1" name="美帆" text="『啊哈哈……』" voices=""/><stopbgm @l="1186" fadeout="1000"/><se @l="1190" buf="3" loop="true" src="着メロ2" volume="1."/><char @l="1194" id="miho" pos="left" src="miho054"/><msg @l="1196" char_id="0" frame_id="1" name="美帆" text="『啊，电话……是我的吗？』"   voices=""/><char @l="1200" id="rei" pos="right" src="rei050"/><msg @l="1202" char_id="1" frame_id="-1" name="玲"   text="『啊啦，那我先去换衣服了哦？』" voices=""/><char @l="1206" id="miho" pos="left" src="miho050"/><msg @l="1208" char_id="0" frame_id="1" name="美帆" text="『嗯。结束后我也会去的。』"   voices=""/><msg @l="1210" char_id="1" frame_id="-1" name="玲" text="『呵呵，慢慢来。』"   voices=""/><clear @l="1214" layer="rei"/><msg @l="1216" char_id="-1" frame_id="-1" name=""   text="玲小姐这样说着，意味深长地笑了笑，从储物柜里取出行李和换洗衣物，走出了休息室。" voices=""/><msg @l="1218" char_id="0" frame_id="1" name="美帆" text="『……？』" voices=""/><char @l="1222" id="miho" pos="left" src="miho054"/><msg @l="1224" char_id="0" frame_id="1" name="美帆" text="『啊……电话，得接一下。』"   voices=""/><clear @l="1228" layer="miho"/><msg @l="1230" char_id="-1" frame_id="-1" name=""   text="我慌忙从储物柜里拿出手提包，取出了手机。" voices=""/><msg @l="1231" char_id="-1" frame_id="-1" name=""   text="手机屏幕上显示着朋友的名字。" voices=""/><stopse @l="1235" buf="3"/><se @l="1239" buf="1" src="携帯ボタン押下音" volume="1."/><char @l="1243" id="miho" pos="auto" src="miho050"/><msg @l="1245" char_id="0" frame_id="1" name="美帆" text="『喂，久等啦～。』"   voices=""/><bgm @l="1248" src="bgm06" volume="1."/><msg @l="1250" char_id="-1" frame_id="-1" name="女性朋友" text="『美帆，我听说了！！』"   voices=""/><char @l="1254" id="miho" pos="auto" src="miho054"/><msg @l="1256" char_id="0" frame_id="1" name="美帆"   text="『哇，你突然大声喊什么啊……？』" voices=""/><msg @l="1258" char_id="-1" frame_id="-1" name="女性朋友"   text="『装傻是没用的！』" voices=""/><msg @l="1260" char_id="-1" frame_id="-1" name="女性朋友"   text="『你，加入网球社了是不是！？』" voices=""/><char @l="1264" id="miho" pos="auto" src="miho054"/><msg @l="1266" char_id="0" frame_id="1" name="美帆"   text="『啊……说起来，我没告诉你吗？』" voices=""/><msg @l="1268" char_id="-1" frame_id="-1" name="女性朋友" text="『一个字都没听说过！』"   voices=""/><char @l="1272" id="miho" pos="auto" src="miho056"/><msg @l="1274" char_id="0" frame_id="1" name="美帆" text="『对，对不起……』"   voices=""/><msg @l="1276" char_id="0" frame_id="1" name="美帆"   text="『虽然迟报确实是我不好……但是，今天我们选的课不一样，这也没办法吧。』" voices=""/><msg @l="1278" char_id="-1" frame_id="-1" name="女性朋友"   text="『其他事情我可能会原谅你，但是关于稻庭学长的事情抢先一步我绝对不——原——谅！』" voices=""/><char @l="1282" id="miho" pos="auto" src="miho054"/><msg @l="1284" char_id="0" frame_id="1" name="美帆"   text="『哪有……我根本没抢先一步什么的。』" voices=""/><msg @l="1286" char_id="0" frame_id="1" name="美帆"   text="『况且，我对稻庭学长……根本没什么特别的感觉。』" voices=""/><msg @l="1288" char_id="-1" frame_id="-1" name="女性朋友" text="『什么啊，那种奇怪的停顿！』"   voices=""/><char @l="1292" id="miho" pos="auto" src="miho056"/><msg @l="1294" char_id="0" frame_id="1" name="美帆" text="『没，没什么……』"   voices=""/><msg @l="1296" char_id="-1" frame_id="-1" name="女性朋友" text="『哼～哼。』"   voices=""/><msg @l="1298" char_id="0" frame_id="1" name="美帆" text="『什，什么……？』" voices=""/><msg @l="1300" char_id="-1" frame_id="-1" name="女性朋友" text="『你，对稻庭学长动心了吧。』"   voices=""/><char @l="1304" id="miho" pos="auto" src="miho054"/><msg @l="1306" char_id="0" frame_id="1" name="美帆" text="『诶……』" voices=""/><msg @l="1308" char_id="-1" frame_id="-1" name="女性朋友"   text="『终于连美帆也被稻庭学长的魅力迷得神魂颠倒了呢！』" voices=""/><char @l="1312" id="miho" pos="auto" src="miho056"/><msg @l="1314" char_id="0" frame_id="1" name="美帆" text="『神，神魂颠倒什么的……』"   voices=""/><msg @l="1316" char_id="0" frame_id="1" name="美帆" text="『我并没有那种感觉……应该吧。』"   voices=""/><msg @l="1318" char_id="-1" frame_id="-1" name="女性朋友"   text="『不能明确否认的地方就很可疑啊。』" voices=""/><msg @l="1320" char_id="0" frame_id="1" name="美帆" text="『哎，别取笑我了……』"   voices=""/><msg @l="1322" char_id="-1" frame_id="-1" name="女性朋友" text="『我才没有取笑你呢。』"   voices=""/><msg @l="1324" char_id="-1" frame_id="-1" name="女性朋友"   text="『昨天的参观会上有人看到美帆和稻庭学长聊得很开心呢，这件事已经被完完全全地看在眼里了哦。』" voices=""/><msg @l="1326" char_id="0" frame_id="1" name="美帆" text="『唔……』" voices=""/><msg @l="1328" char_id="-1" frame_id="-1" name=""   text="确实……可能有这样的场景。" voices=""/><msg @l="1329" char_id="-1" frame_id="-1" name=""   text="但那不是因为我怎么样，只是偶然碰到稻庭学长，然后聊了几句而已。" voices=""/><msg @l="1331" char_id="0" frame_id="1" name="美帆"   text="(话虽如此，在别人眼里我们肯定看起来很亲近吧……)" voices=""/><msg @l="1333" char_id="-1" frame_id="-1" name=""   text="实际上，社团成员已经把我和稻庭学长联系在一起了。" voices=""/><msg @l="1334" char_id="-1" frame_id="-1" name=""   text="多愁善感的年龄……虽然对我来说可能有点晚了，但自然而然地谈论起这方面的话题也是没办法的事。" voices=""/><msg @l="1335" char_id="-1" frame_id="-1" name=""   text="只是……这样被当真了，总觉得很不是滋味。" voices=""/><msg @l="1336" char_id="-1" frame_id="-1" name=""   text="是啊，对我来说那应该是……不情愿的才对。" voices=""/><msg @l="1338" char_id="-1" frame_id="-1" name="女性朋友" text="『这样沉默不语是卑鄙的哦。』"   voices=""/><char @l="1341" id="miho" pos="auto" src="miho054"/><msg @l="1343" char_id="0" frame_id="1" name="美帆" text="『什么沉默不语啊……』"   voices=""/><msg @l="1345" char_id="0" frame_id="1" name="美帆"   text="『而且我只是因为室友学姐在那里才加入网球社的……并不是专门冲着稻庭学长去的。』"   voices=""/><msg @l="1347" char_id="-1" frame_id="-1" name="女性朋友"   text="『那为什么不是和那个室友学姐，而是和稻庭学长聊天呢？』" voices=""/><char @l="1350" id="miho" pos="auto" src="miho056"/><msg @l="1352" char_id="0" frame_id="1" name="美帆"   text="『那是因为……参观会那天室友学姐没来……』" voices=""/><msg @l="1354" char_id="-1" frame_id="-1" name="女性朋友"   text="『啊，说起来被稻庭学长邀请的时候你确实说过什么。』" voices=""/><msg @l="1356" char_id="-1" frame_id="-1" name="女性朋友" text="『好像是，白石学姐什么的……』"   voices=""/><msg @l="1358" char_id="0" frame_id="1" name="美帆" text="『对对，所以我并不是……』"   voices=""/><msg @l="1360" char_id="-1" frame_id="-1" name="女性朋友" text="『啊，我明白了。』"   voices=""/><msg @l="1362" char_id="0" frame_id="1" name="美帆" text="『什、什么明白了……明白了什么？』"   voices=""/><msg @l="1364" char_id="-1" frame_id="-1" name="女性朋友"   text="『你是在顾虑那个白石学姐的心情吧？』" voices=""/><char @l="1368" id="miho" pos="auto" src="miho054"/><bgm @l="1371" src="bgm07" volume="1."/><msg @l="1373" char_id="0" frame_id="1" name="美帆" text="『啊……』" voices=""/><msg @l="1375" char_id="-1" frame_id="-1" name="女性朋友"   text="『网球社的白石玲，不就是那个传闻中和稻庭学长在交往的人吗。』" voices=""/><msg @l="1377" char_id="0" frame_id="1" name="美帆" text="(……原来如此)" voices=""/><msg @l="1379" char_id="-1" frame_id="-1" name="女性朋友"   text="『所以你啊，是因为自己也喜欢上了稻庭学长，却担心会和室友学姐成为情敌……才这么顾虑的吧。』"   voices=""/><char @l="1382" id="miho" pos="auto" src="miho056"/><msg @l="1384" char_id="0" frame_id="1" name="美帆" text="『………』" voices=""/><msg @l="1386" char_id="-1" frame_id="-1" name="" text="确实正如她所说。"   voices=""/><msg @l="1387" char_id="-1" frame_id="-1" name=""   text="虽然我一直试图回避不去想这件事，但总之我是在顾虑玲姐的感受……" voices=""/><msg @l="1388" char_id="-1" frame_id="-1" name=""   text="所以才固执地认为自己对稻庭学长“没有任何想法”。" voices=""/><msg @l="1389" char_id="-1" frame_id="-1" name=""   text="在那种状态下去探究自己的心情，结果只会浮现出模糊不清、犹豫不决的想法，这或许是理所当然的……"   voices=""/><msg @l="1391" char_id="-1" frame_id="-1" name="女性朋友"   text="『沉默就是默认的意思表态，我可以这么理解吧～？』" voices=""/><char @l="1395" id="miho" pos="auto" src="miho054"/><msg @l="1397" char_id="0" frame_id="1" name="美帆" text="『啊……等、等等。』"   voices=""/><char @l="1400" id="miho" pos="auto" src="miho056"/><msg @l="1402" char_id="0" frame_id="1" name="美帆"   text="『确实……可能有些地方是有所顾虑……』" voices=""/><msg @l="1404" char_id="0" frame_id="1" name="美帆"   text="『但也不是说我就……那个……』" voices=""/><msg @l="1406" char_id="-1" frame_id="-1" name="女性朋友"   text="『那么，如果稻庭学长被白石学姐抢走了，你也无所谓咯？』" voices=""/><char @l="1410" id="miho" pos="auto" src="miho054"/><msg @l="1412" char_id="0" frame_id="1" name="美帆" text="『抢、抢走……怎么会。』"   voices=""/><msg @l="1414" char_id="-1" frame_id="-1" name="女性朋友"   text="『归根结底不就是这么回事吗。』" voices=""/><msg @l="1416" char_id="-1" frame_id="-1" name="女性朋友"   text="『美帆你一直顾虑着不敢面对自己的感情，要是这期间稻庭学长和白石学姐在一起了，你怎么办啊。』" voices=""/><char @l="1420" id="miho" pos="auto" src="miho056"/><msg @l="1422" char_id="0" frame_id="1" name="美帆"   text="『那当然是……祝福……………他们吧。』" voices=""/><msg @l="1424" char_id="-1" frame_id="-1" name="女性朋友"   text="『啊——真是的，你这人，真是太善良了！！』" voices=""/><msg @l="1426" char_id="-1" frame_id="-1" name="女性朋友"   text="『这样真的好吗？你的心情就这样接受了？！？』" voices=""/><char @l="1429" id="miho" pos="auto" src="miho054"/><msg @l="1431" char_id="0" frame_id="1" name="美帆" text="『我的心情……？』"   voices=""/><msg @l="1433" char_id="-1" frame_id="-1" name="女性朋友"   text="『没错！不是别人的，是你自己的心情啊！！』" voices=""/><msg @l="1435" char_id="-1" frame_id="-1" name="女性朋友"   text="『室友学姐怎样什么的都无所谓，重要的是你自己对稻庭学长的感觉不是吗？』"   voices=""/><msg @l="1437" char_id="-1" frame_id="-1" name=""   text="不知不觉间，朋友已经情绪高涨，语气半是在进行恋爱咨询了。" voices=""/><msg @l="1438" char_id="-1" frame_id="-1" name=""   text="她应该是一心想从我这里问出真心话吧……" voices=""/><msg @l="1440" char_id="0" frame_id="1" name="美帆"   text="(说起来，我在听了玲小姐的心情后……好像就开始和稻庭学长保持距离了)" voices=""/><msg @l="1442" char_id="0" frame_id="1" name="美帆"   text="(但那和我自己的感受完全无关……)" voices=""/><msg @l="1444" char_id="0" frame_id="1" name="美帆"   text="(全都是……只是因为顾虑玲小姐的感受而已……)" voices=""/><msg @l="1446" char_id="0" frame_id="1" name="美帆"   text="(那么，我自己的感受到底是怎样的呢……？)" voices=""/><msg @l="1448" char_id="0" frame_id="1" name="美帆" text="(我……)" voices=""/><msg @l="1454" async="true" char_id="-1" frame_id="-1" name=""   text="我的心情是……？" voices=""/><select @l="1455"><menu @l="1457" label="EventLabel_36" text="喜欢稻庭学长"/><menu @l="1459" label="EventLabel_37" text="想要支持玲学姐"/></select><label @l="1466" id="EventLabel_36"/><description @l="1470" text="意识到心意的时刻"/><char @l="1473" id="miho" pos="auto" src="miho050"/><msg @l="1475" char_id="0" frame_id="1" name="美帆" text="『……。』" voices=""/><msg @l="1477" char_id="0" frame_id="1" name="美帆" text="『我……可能就是这样的。』"   voices=""/><msg @l="1479" char_id="-1" frame_id="-1" name="女性朋友" text="『嗯？』" voices=""/><msg @l="1481" char_id="0" frame_id="1" name="美帆" text="『关于稻庭学长……我………。』"   voices=""/><se @l="1485" buf="1" src="ドアの向こうで物音_バッグを落とすような感じ" volume="1."/><stopbgm @l="1488" fadeout="1000"/><char @l="1492" id="miho" pos="auto" src="miho054"/><msg @l="1494" char_id="0" frame_id="1" name="美帆"   text="『啊……学姐，好像回来了！』" voices=""/><msg @l="1496" char_id="-1" frame_id="-1" name="女性朋友"   text="『诶，你现在和稻庭学长在一起吗！？』" voices=""/><msg @l="1498" char_id="0" frame_id="1" name="美帆" text="『不，不是啦……是我的室友学姐。』"   voices=""/><msg @l="1500" char_id="-1" frame_id="-1" name="女性朋友" text="『哦，是白石学姐啊。』"   voices=""/><msg @l="1502" char_id="0" frame_id="1" name="美帆" text="『那么，我先挂了哦。』"   voices=""/><msg @l="1504" char_id="-1" frame_id="-1" name="女性朋友" text="『啊，等一下！』"   voices=""/><msg @l="1506" char_id="0" frame_id="1" name="美帆" text="『我之后再打给你，对不起啦！』"   voices=""/><se @l="1510" buf="1" src="携帯ボタン押下音" volume="1."/><char @l="1514" id="miho" pos="auto" src="miho050"/><msg @l="1516" char_id="0" frame_id="1" name="美帆" text="『……呼。』" voices=""/><se @l="1520" buf="1" src="部室のドア開ける" volume="1."/><clear @l="1523" class="char"/><char @l="1525" id="miho" pos="left" src="miho050"/><char @l="1528" id="rei" pos="right" src="rei010"/><bgm @l="1532" src="bgm02" volume="1."/><msg @l="1534" char_id="1" frame_id="-1" name="玲" text="『……怎么样，通话结束了？』"   voices=""/><msg @l="1536" char_id="-1" frame_id="-1" name=""   text="时机刚好……或者说差一点就来不及了，玲姐走进了休息室。" voices=""/><char @l="1539" id="miho" pos="left" src="miho056"/><msg @l="1541" char_id="0" frame_id="1" name="美帆"   text="『对不起……不小心聊太久了。』" voices=""/><msg @l="1543" char_id="1" frame_id="-1" name="玲" text="『看起来是呢。对方是你的朋友吗？』"   voices=""/><char @l="1547" id="miho" pos="left" src="miho054"/><msg @l="1549" char_id="0" frame_id="1" name="美帆" text="『啊，嗯……是的啊？』"   voices=""/><msg @l="1551" char_id="1" frame_id="-1" name="玲" text="『是吗，看你们关系不错，那就好。』"   voices=""/><msg @l="1553" char_id="1" frame_id="-1" name="玲" text="『话说回来……快去换衣服吧。』"   voices=""/><msg @l="1555" char_id="1" frame_id="-1" name="玲"   text="『之前不是说过最近这附近有可疑的男子出没吗？天黑了会很危险的哦。』" voices=""/><char @l="1559" id="miho" pos="left" src="miho050"/><msg @l="1561" char_id="0" frame_id="1" name="美帆" text="『啊，好的！』" voices=""/><clear @l="1565" layer="miho"/><msg @l="1567" char_id="-1" frame_id="-1" name=""   text="在玲姐的提醒下，我仿佛被推了一把，离开了休息室。" voices=""/><stopbgm @l="1571" fadeout="1000"/><msg @l="1573" char_id="1" frame_id="-1" name="玲" text="『……。』" voices=""/><char @l="1576" id="rei" pos="right" src="rei015"/><msg @l="1578" char_id="1" frame_id="-1" name="玲"   text="『美帆……你也……稻庭先生……。』" voices=""/><msg @l="1580" char_id="-1" frame_id="-1" name=""   text="……玲姐的低语，并没有传到我的耳中。" voices=""/><clear @l="1586" class="all"/><msgshow @l="1588" show="true"/><wait_chgmv/><bg @l="1592" src="bg07b"/><bgm @l="1596" src="bgm05" volume="1."/><char @l="1600" id="rei" pos="auto" src="rei010"/><msg @l="1602" char_id="1" frame_id="-1" name="玲"   text="『虽然白天已经变长了不少，但现在说是夏天可能还为时过早吧。』" voices=""/><msg @l="1604" char_id="1" frame_id="-1" name="玲"   text="『就算是这个时间，也这么黑啊……』" voices=""/><clear @l="1607" class="char"/><char @l="1609" id="rei" pos="left" src="rei010"/><char @l="1612" id="miho" pos="right" src="miho016"/><msg @l="1614" char_id="0" frame_id="1" name="美帆"   text="『对不起……完全耽误到这么晚了。』" voices=""/><char @l="1618" id="rei" pos="left" src="rei010"/><msg @l="1620" char_id="1" frame_id="-1" name="玲" text="『如果是那件事的话，我并不在意哦。』"   voices=""/><msg @l="1622" char_id="0" frame_id="1" name="美帆" text="『……。』" voices=""/><msg @l="1624" char_id="-1" frame_id="-1" name=""   text="不知为何，我从玲姐的话语中感受到了一丝刺痛。" voices=""/><msg @l="1625" char_id="-1" frame_id="-1" name=""   text="这大概是因为我内心有所愧疚吧。" voices=""/><msg @l="1626" char_id="-1" frame_id="-1" name=""   text="因为意识到自己喜欢上了稻庭学长，所以心里有些不安。" voices=""/><char @l="1630" id="rei" pos="left" src="rei011"/><msg @l="1632" char_id="1" frame_id="-1" name="玲" text="『怎么了，突然不说话了。』"   voices=""/><msg @l="1634" char_id="0" frame_id="1" name="美帆" text="『啊，没什么……。』" voices=""/><char @l="1638" id="miho" pos="right" src="miho010"/><msg @l="1640" char_id="0" frame_id="1" name="美帆" text="『这里……晚上变得很冷清呢。』"   voices=""/><char @l="1644" id="rei" pos="left" src="rei010"/><msg @l="1646" char_id="1" frame_id="-1" name="玲"   text="『是啊……虽然有路灯，但间隔太大了，光线不够。』" voices=""/><msg @l="1648" char_id="1" frame_id="-1" name="玲"   text="『人来人往也极度减少了，更显得冷清呢。』" voices=""/><msg @l="1650" char_id="0" frame_id="1" name="美帆" text="『电车……到几点为止来着？』"   voices=""/><msg @l="1652" char_id="1" frame_id="-1" name="玲" text="『没关系，还有两三班呢。』"   voices=""/><msg @l="1654" char_id="1" frame_id="-1" name="玲"   text="『不过……可能要稍微等一会儿。』" voices=""/><char @l="1657" id="miho" pos="right" src="miho116"/><msg @l="1659" char_id="0" frame_id="1" name="美帆" text="『……对不起。』"   voices=""/><msg @l="1661" char_id="1" frame_id="-1" name="玲"   text="『话说回来，太阳都下山了还这么热啊。』" voices=""/><msg @l="1663" char_id="1" frame_id="-1" name="玲"   text="『回去的路上买个冰淇淋怎么样。』" voices=""/><char @l="1667" id="miho" pos="right" src="miho011"/><msg @l="1669" char_id="0" frame_id="1" name="美帆" text="『啊，那个主意不错……咦？』"   voices=""/><char @l="1673" id="miho" pos="right" src="miho114"/><msg @l="1676" char_id="0" frame_id="1" name="美帆"   text="『那边站着的，不是稻庭学长吗……？』" voices=""/><char @l="1680" id="rei" pos="left" src="rei024"/><msg @l="1682" char_id="1" frame_id="-1" name="玲" text="『诶……稻庭先生？』"   voices=""/><clear @l="1687" class="char"/><stopbgm @l="1691" fadeout="1000"/><char @l="1695" id="inaba" pos="auto" src="inaba017"/><bgm @l="1699" src="bgm09" volume="1."/><msg @l="1701" char_id="-1" frame_id="-1" name=""   text="距离稻庭学长还有一段距离，对方还没有注意到这边。" voices=""/><msg @l="1703" char_id="1" frame_id="-1" name="玲"   text="『稻庭先生……这么晚了在做什么呢？』" voices=""/><msg @l="1705" char_id="0" frame_id="1" name="美帆" text="『要不要，打个招呼？』"   voices=""/><msg @l="1708" char_id="1" frame_id="-1" name="玲"   text="『咦？稻庭先生好像很不高兴的样子……我从来没见过他不高兴的表情呢。』" voices=""/><msg @l="1710" char_id="0" frame_id="1" name="美帆"   text="『诶？……连玲小姐也没见过吗？』" voices=""/><clear @l="1715" class="char"/><bgm @l="1719" src="bgm05" volume="1."/><char @l="1724" id="rei" pos="left" src="rei014"/><char @l="1726" id="miho" pos="right" src="miho014"/><msg @l="1728" char_id="1" frame_id="-1" name="玲" text="『啊……。』" voices=""/><msg @l="1730" char_id="-1" frame_id="-1" name=""   text="稻庭学长从路灯下面移开了，看不见他了。" voices=""/><msg @l="1731" char_id="-1" frame_id="-1" name="" text="他没有朝这边走过来的迹象。"   voices=""/><msg @l="1732" char_id="-1" frame_id="-1" name=""   text="校舍那边有停车场，他是不是朝那个方向去了呢。" voices=""/><char @l="1735" id="miho" pos="right" src="miho114"/><msg @l="1737" char_id="0" frame_id="1" name="美帆" text="『……他走了呢。』"   voices=""/><char @l="1741" id="rei" pos="left" src="rei010"/><msg @l="1743" char_id="1" frame_id="-1" name="玲" text="『是啊。』" voices=""/><char @l="1747" id="miho" pos="right" src="miho116"/><msg @l="1749" char_id="0" frame_id="1" name="美帆" text="『不去……追一下吗？』"   voices=""/><msg @l="1751" char_id="1" frame_id="-1" name="玲" text="『为什么要追？』" voices=""/><msg @l="1753" char_id="0" frame_id="1" name="美帆" text="『为什么……。』"   voices=""/><char @l="1757" id="rei" pos="left" src="rei110"/><msg @l="1760" char_id="1" frame_id="-1" name="玲"   text="『哎呀，你对稻庭先生还挺上心的嘛……？』" voices=""/><char @l="1763" id="miho" pos="right" src="miho014"/><msg @l="1765" char_id="0" frame_id="1" name="美帆" text="『才、才没有……那种事。』"   voices=""/><char @l="1769" id="rei" pos="left" src="rei128"/><msg @l="1771" char_id="1" frame_id="-1" name="玲" text="『嗯～……算了，也无所谓。』"   voices=""/><char @l="1775" id="miho" pos="right" src="miho114"/><msg @l="1777" char_id="0" frame_id="1" name="美帆"   text="『啊，那边有人朝这边走过来了……？』" voices=""/><char @l="1781" id="rei" pos="left" src="rei010"/><msg @l="1783" char_id="1" frame_id="-1" name="玲" text="『那是……这里的校工啊。』"   voices=""/><char @l="1787" id="miho" pos="right" src="miho116"/><msg @l="1789" char_id="0" frame_id="1" name="美帆" text="『校工先生……？』"   voices=""/><clear @l="1794" class="char"/><char @l="1798" id="kuma" pos="auto" src="kuma010"/><stopbgm @l="1800" fadeout="1000"/><msg @l="1802" char_id="-1" frame_id="-1" name="管理员"   text="『哎呀，这么晚了还留在学校，真是辛苦啊。』" voices=""/><msg @l="1804" char_id="0" frame_id="1" name="美帆" text="『啊，是的……您好。』"   voices=""/><msg @l="1806" char_id="-1" frame_id="-1" name="管理员"   text="『最近不太平，各种不好的传闻不断，几位女生单独行动实在让人不放心。』" voices=""/><msg @l="1808" char_id="-1" frame_id="-1" name="管理员"   text="『要不要我送你们到外面的车站？』" voices=""/><msg @l="1810" char_id="0" frame_id="1" name="美帆" text="『这个……。』" voices=""/><msg @l="1812" char_id="1" frame_id="-1" name="玲"   text="『不用了，不必担心我们。感谢您的好意。』" voices=""/><msg @l="1814" char_id="-1" frame_id="-1" name="管理员"   text="『这样啊，是我多事了。』" voices=""/><msg @l="1816" char_id="-1" frame_id="-1" name="管理员"   text="『那么……请你们回去的时候多加小心。』" voices=""/><clear @l="1820" class="char"/><msg @l="1822" char_id="-1" frame_id="-1" name=""   text="校工脸上挂着卑微的讨好笑容，说完一连串礼貌的话后，转身朝着后院方向走去。" voices=""/><msg @l="1823" char_id="-1" frame_id="-1" name=""   text="说起来……后院好像有个校工室。" voices=""/><char @l="1827" id="miho" pos="auto" src="miho014"/><bgm @l="1829" src="bgm05" volume="1."/><msg @l="1831" char_id="0" frame_id="1" name="美帆"   text="『我好像是第一次知道有校工在这里……』" voices=""/><clear @l="1834" class="char"/><char @l="1837" id="miho" pos="left" src="miho010"/><char @l="1840" id="rei" pos="right" src="rei128"/><msg @l="1842" char_id="1" frame_id="-1" name="玲" text="『……。』" voices=""/><msg @l="1844" char_id="1" frame_id="-1" name="玲"   text="『……我无论如何都无法喜欢那个人。』" voices=""/><char @l="1848" id="miho" pos="left" src="miho014"/><msg @l="1850" char_id="0" frame_id="1" name="美帆"   text="『玲小姐居然会说这种话，真是少见呢。』" voices=""/><char @l="1854" id="rei" pos="right" src="rei120"/><msg @l="1856" char_id="1" frame_id="-1" name="玲"   text="『那是因为，我也是普通人啊……有容易相处的人，当然也会有让我本能感到厌恶的人存在。』"   voices=""/><char @l="1860" id="miho" pos="left" src="miho016"/><msg @l="1862" char_id="0" frame_id="1" name="美帆"   text="『啊，不……我并不是说这样不好。』" voices=""/><char @l="1865" id="miho" pos="left" src="miho010"/><msg @l="1867" char_id="0" frame_id="1" name="美帆"   text="『只是觉得有点意外而已。』" voices=""/><msg @l="1869" char_id="1" frame_id="-1" name="玲"   text="『难道我讨厌某个人是件让人意外的事吗？』" voices=""/><msg @l="1871" char_id="0" frame_id="1" name="美帆"   text="『是啊……在我印象中，玲小姐人缘很好，理解能力也强，感觉无论面对什么人都能毫无障碍地相处呢。』"   voices=""/><char @l="1875" id="rei" pos="right" src="rei020"/><msg @l="1877" char_id="1" frame_id="-1" name="玲"   text="『是吗……你能这么想，我其实很高兴。』" voices=""/><msg @l="1879" char_id="0" frame_id="1" name="美帆" text="『您是有什么不愉快的经历吗？』"   voices=""/><msg @l="1881" char_id="1" frame_id="-1" name="玲"   text="『倒也不是有什么特别的经历……』" voices=""/><char @l="1885" id="rei" pos="right" src="rei128"/><msg @l="1887" char_id="1" frame_id="-1" name="玲"   text="『只是不知为何……我对那个人就是本能地无法接受。』" voices=""/><char @l="1890" id="miho" pos="left" src="miho110"/><msg @l="1892" char_id="0" frame_id="1" name="美帆"   text="『原来这种事情，每个人都会有啊……』" voices=""/><char @l="1896" id="rei" pos="right" src="rei120"/><msg @l="1898" char_id="1" frame_id="-1" name="玲"   text="『我想，没有一个讨厌的人这种情况反而比较少吧。』" voices=""/><msg @l="1900" char_id="1" frame_id="-1" name="玲"   text="『完美的人应该没那么常见……』" voices=""/><char @l="1904" id="rei" pos="right" src="rei121"/><msg @l="1906" char_id="1" frame_id="-1" name="玲"   text="『不……或许只是因为我自己无法做到完美，所以想要说服自己不只是我一个人如此罢了。』" voices=""/><msg @l="1908" char_id="-1" frame_id="-1" name=""   text="就这样，玲小姐……带着一丝寂寞地笑了。" voices=""/><eval @l="1911" expr="f.稲庭ルートflag&#32;=&#32;1&#13;&#10;"/><goto @l="1915" label="EventLabel_38"/><label @l="1919" id="EventLabel_37"/><description @l="1923" text="察觉到心意的时刻"/><bgm @l="1927" src="bgm02" volume="1."/><msg @l="1929" char_id="0" frame_id="1" name="美帆" text="『……我不这么认为。』"   voices=""/><msg @l="1931" char_id="-1" frame_id="-1" name="女性朋友" text="『啊……？』" voices=""/><char @l="1935" id="miho" pos="auto" src="miho051"/><msg @l="1937" char_id="0" frame_id="1" name="美帆"   text="『我喜欢的，不是稻庭学长。』" voices=""/><msg @l="1939" char_id="0" frame_id="1" name="美帆"   text="『因为……我更喜欢的是玲小姐。』" voices=""/><msg @l="1941" char_id="-1" frame_id="-1" name="女性朋友" text="『什么啊，这是什么意思……？』"   voices=""/><msg @l="1943" char_id="-1" frame_id="-1" name="女性朋友"   text="『难道你……是那边的人？』" voices=""/><char @l="1947" id="miho" pos="auto" src="miho056"/><msg @l="1949" char_id="0" frame_id="1" name="美帆" text="『不、不是啦。』" voices=""/><char @l="1953" id="miho" pos="auto" src="miho050"/><msg @l="1955" char_id="0" frame_id="1" name="美帆"   text="『我非常尊敬玲小姐……也很憧憬她。』" voices=""/><msg @l="1957" char_id="0" frame_id="1" name="美帆"   text="『这种憧憬，远远超过了我对稻庭学长的好感。』" voices=""/><msg @l="1959" char_id="0" frame_id="1" name="美帆"   text="『所以我想要真心实意地支持喜欢稻庭学长的玲小姐……』" voices=""/><char @l="1962" id="miho" pos="auto" src="miho051"/><msg @l="1964" char_id="0" frame_id="1" name="美帆" text="『仅此而已。』" voices=""/><msg @l="1966" char_id="-1" frame_id="-1" name="女性朋友"   text="『完——全——不明白啊……你的逻辑！！！』" voices=""/><char @l="1969" id="miho" pos="auto" src="miho050"/><msg @l="1971" char_id="0" frame_id="1" name="美帆"   text="『是吗……我觉得很简单啊……』" voices=""/><msg @l="1973" char_id="-1" frame_id="-1" name="女性朋友"   text="『不过，这样一来确实少了一个情敌呢。』" voices=""/><msg @l="1975" char_id="-1" frame_id="-1" name="女性朋友"   text="『这次就特别原谅你没告诉我就加入网球社的事吧！』" voices=""/><char @l="1979" id="miho" pos="auto" src="miho056"/><msg @l="1981" char_id="0" frame_id="1" name="美帆" text="『啊，谢谢……』"   voices=""/><msg @l="1983" char_id="-1" frame_id="-1" name="女性朋友"   text="『那么，好像差不多到吃饭时间了，先挂了。』" voices=""/><char @l="1987" id="miho" pos="auto" src="miho051"/><msg @l="1989" char_id="0" frame_id="1" name="美帆" text="『嗯，周一见。』"   voices=""/><msg @l="1991" char_id="-1" frame_id="-1" name="女性朋友" text="『再见～。』"   voices=""/><se @l="1995" buf="1" src="携帯ボタン押下音" volume="1."/><char @l="1999" id="miho" pos="auto" src="miho050"/><msg @l="2001" char_id="0" frame_id="1" name="美帆" text="『……。』" voices=""/><msg @l="2003" char_id="0" frame_id="1" name="美帆" text="『……谢谢。』" voices=""/><msg @l="2005" char_id="-1" frame_id="-1" name=""   text="我看着已经挂断的手机，微微一笑。" voices=""/><msg @l="2006" char_id="-1" frame_id="-1" name=""   text="怀着对这位让我意识到自己无意中的心情的朋友，一丝淡淡的感谢之情。" voices=""/><msg @l="2007" char_id="-1" frame_id="-1" name=""   text="同时，也感到庆幸，我所尊敬的学姐不必成为恋爱中的对手。" voices=""/><stopbgm @l="2011" fadeout="1000"/><clear @l="2016" class="all"/><msgshow @l="2018" show="true"/><wait_chgmv/><bg @l="2022" src="bg01b"/><bgm @l="2026" src="bgm04" volume="1."/><char @l="2030" id="miho" pos="auto" src="miho030"/><msg @l="2032" char_id="0" frame_id="1" name="美帆" text="『……。』" voices=""/><msg @l="2034" char_id="-1" frame_id="-1" name=""   text="晚饭后，我回到房间，正在拼命与报告……或者说是报告前的准备工作作斗争。" voices=""/><msg @l="2035" char_id="-1" frame_id="-1" name=""   text="即使要在报告中引用论证和参考文献，但由于原始参考文献是用英语写的，首先必须进行翻译。"   voices=""/><msg @l="2036" char_id="-1" frame_id="-1" name=""   text="本来在考古学这个领域里，很多著名的专业书籍都是用英语写的。" voices=""/><msg @l="2037" char_id="-1" frame_id="-1" name=""   text="更麻烦的是，这些英语专业书籍，原本是用法语或德语写的，然后被翻译成英语，整个过程相当复杂。"   voices=""/><msg @l="2039" char_id="0" frame_id="1" name="美帆"   text="(报告本身很有趣，但总是被这种日译拖后腿呢……)" voices=""/><msg @l="2041" char_id="-1" frame_id="-1" name=""   text="这一次也不例外，花在翻译上的时间最多。" voices=""/><msg @l="2042" char_id="-1" frame_id="-1" name=""   text="写报告本身一天时间就足够了。" voices=""/><msg @l="2043" char_id="-1" frame_id="-1" name=""   text="但是，由于论证中引用的专业书籍页数相当多，考虑到下周二就是提交日期，时间上已经非常紧张了。" voices=""/><msg @l="2045" char_id="0" frame_id="1" name="美帆"   text="(照这个情况，周六周日也得用来翻译，否则可能来不及……)" voices=""/><stopbgm @l="2048" fadeout="1000"/><se @l="2052" buf="3" loop="true" src="着メロ2" volume="1."/><char @l="2056" id="miho" pos="auto" src="miho134"/><msg @l="2058" char_id="0" frame_id="1" name="美帆" text="『啊……』" voices=""/><msg @l="2060" char_id="0" frame_id="1" name="美帆" text="(电话……是从家里打来的？)"   voices=""/><msg @l="2062" char_id="-1" frame_id="-1" name=""   text="我从包里拿出一直放在那里的手机，看了看屏幕，上面显示着熟悉的家里电话号码。" voices=""/><char @l="2068" id="miho" pos="auto" src="miho030"/><stopse @l="2072" buf="3"/><msg @l="2074" char_id="0" frame_id="1" name="美帆" text="喂，您好……"   voices=""/><msg @l="2076" char_id="2" frame_id="-1" name="声音" text="『喂，姐姐？』"   voices=""/><char @l="2080" id="miho" pos="auto" src="miho034"/><msg @l="2082" char_id="0" frame_id="1" name="美帆" text="『那个声音……亚季奈？』"   voices=""/><bgm @l="2086" src="bgm06" volume="1."/><msg @l="2088" char_id="2" frame_id="-1" name="亚季奈" text="『叮咚，回答正确。』"   voices=""/><msg @l="2090" char_id="2" frame_id="-1" name="亚季奈" text="『奖品是妹妹优待券，为期一年哦～。』"   voices=""/><char @l="2094" id="miho" pos="auto" src="miho036"/><msg @l="2096" char_id="0" frame_id="1" name="美帆" text="『什么啊，那个妹妹优待券……。』"   voices=""/><msg @l="2098" char_id="2" frame_id="-1" name="亚季奈"   text="『你看，以前不是给过你按摩券之类的吗？ 这是我的专属版本。』" voices=""/><msg @l="2100" char_id="2" frame_id="-1" name="亚季奈"   text="『拿到这个的姐姐必须优待我。』" voices=""/><msg @l="2102" char_id="0" frame_id="1" name="美帆" text="『我才不要那种东西呢……。』"   voices=""/><msg @l="2104" char_id="2" frame_id="-1" name="亚季奈" text="『切，明明不用客气的～。』"   voices=""/><char @l="2108" id="miho" pos="auto" src="miho030"/><msg @l="2110" char_id="0" frame_id="1" name="美帆" text="『话说回来，突然打电话有什么事？』"   voices=""/><char @l="2114" id="miho" pos="auto" src="miho036"/><msg @l="2116" char_id="0" frame_id="1" name="美帆"   text="『该不会，你就是为了说这个才打电话来的吧？』" voices=""/><msg @l="2118" char_id="2" frame_id="-1" name="亚季奈" text="『不是啦～。』" voices=""/><msg @l="2120" char_id="2" frame_id="-1" name="亚季奈"   text="『今天是有一个一生的请求，才打电话给姐姐的！』" voices=""/><char @l="2124" id="miho" pos="auto" src="miho034"/><msg @l="2126" char_id="0" frame_id="1" name="美帆" text="『一生的请求……？』"   voices=""/><msg @l="2128" char_id="2" frame_id="-1" name="亚季奈" text="『对，一生的请求！』"   voices=""/><char @l="2132" id="miho" pos="auto" src="miho036"/><msg @l="2134" char_id="0" frame_id="1" name="美帆" text="『……。』" voices=""/><msg @l="2136" char_id="-1" frame_id="-1" name=""   text="亚季奈的“一生的请求”，从以前开始就不知道让我经历过多少次麻烦事了。" voices=""/><msg @l="2137" char_id="-1" frame_id="-1" name=""   text="从瞒着妈妈捡回小狗的时候，到莫名其妙地被迫和亚季奈班上的男生约会的情况都有过。"   voices=""/><msg @l="2138" char_id="-1" frame_id="-1" name=""   text="总之亚季奈的“一生的请求”，没一件好事。" voices=""/><msg @l="2140" char_id="0" frame_id="1" name="美帆"   text="『……该不会，又是什么荒唐的事吧？』" voices=""/><msg @l="2142" char_id="2" frame_id="-1" name="亚季奈" text="『这根本不是什么荒唐事哦～。』"   voices=""/><msg @l="2144" char_id="2" frame_id="-1" name="亚季奈"   text="『你知道这次这边要举办游泳比赛吧？』" voices=""/><char @l="2148" id="miho" pos="auto" src="miho030"/><msg @l="2150" char_id="0" frame_id="1" name="美帆"   text="『啊，嗯……这个季节每年都会举办呢。』" voices=""/><msg @l="2152" char_id="-1" frame_id="-1" name="" text="亚季奈现在是游泳部的成员……"   voices=""/><msg @l="2153" char_id="-1" frame_id="-1" name=""   text="我也曾经和亚季奈一样，在几年前还是游泳部的成员。" voices=""/><msg @l="2154" char_id="-1" frame_id="-1" name=""   text="不过，当我和亚季奈同岁的时候，我早就退出游泳部了……" voices=""/><msg @l="2156" char_id="2" frame_id="-1" name="亚季奈"   text="『其实，为了那个比赛我们要进行强化集训……』" voices=""/><msg @l="2158" char_id="2" frame_id="-1" name="亚季奈"   text="『听好了吃惊吧！集训地点居然是姐姐你的大学！』" voices=""/><char @l="2162" id="miho" pos="auto" src="miho036"/><msg @l="2164" char_id="0" frame_id="1" name="美帆" text="『哦，哦……真巧呢。』"   voices=""/><msg @l="2166" char_id="2" frame_id="-1" name="亚季奈"   text="『什么啊～，你的反应也太冷淡了吧！？』" voices=""/><msg @l="2168" char_id="0" frame_id="1" name="美帆"   text="『那、那没有的事……不都是和平常一样吗。』" voices=""/><msg @l="2170" char_id="2" frame_id="-1" name="亚季奈" text="『唉，真没劲啊。』"   voices=""/><char @l="2174" id="miho" pos="auto" src="miho030"/><msg @l="2176" char_id="0" frame_id="1" name="美帆"   text="『但是……这和“一生的请求”有什么关系啊？』" voices=""/><msg @l="2178" char_id="2" frame_id="-1" name="亚季奈" text="『一生的请求是接下来要说的。』"   voices=""/><msg @l="2180" char_id="2" frame_id="-1" name="亚季奈"   text="『其实是想在那次强化集训的时候，请姐姐当我们的教练。』" voices=""/><char @l="2184" id="miho" pos="auto" src="miho034"/><msg @l="2186" char_id="0" frame_id="1" name="美帆" text="『啊……』" voices=""/><msg @l="2188" char_id="2" frame_id="-1" name="亚季奈"   text="『你看，虽然是过去的事了，但姐姐你也是记录保持者对吧？』" voices=""/><msg @l="2190" char_id="2" frame_id="-1" name="亚季奈"   text="『我觉得有这样的人在身边指导的话，大家的成绩应该都会提高的。』" voices=""/><msg @l="2192" char_id="0" frame_id="1" name="美帆"   text="『可、可是……如果在我们大学集训，当然会有游泳社团之类的来指导游泳不是吗？』" voices=""/><msg @l="2194" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯——，虽然表面上是这么说的，但姐姐你们学校也不是特别擅长游泳，也没有什么大赛的获奖者吧？』"   voices=""/><char @l="2198" id="miho" pos="auto" src="miho036"/><msg @l="2200" char_id="0" frame_id="1" name="美帆" text="『嗯、嗯……』" voices=""/><msg @l="2202" char_id="-1" frame_id="-1" name=""   text="确实，自从进了现在的大学后，就没听说过有人在游泳比赛中获奖的事。" voices=""/><msg @l="2203" char_id="-1" frame_id="-1" name=""   text="不……当初选择大学时，为了不产生留恋，我特意选择了不重视游泳的学校，所以这也是理所当然的。"   voices=""/><msg @l="2205" char_id="2" frame_id="-1" name="亚季奈"   text="『所以，有姐姐当帮手的话会让人很有信心！』" voices=""/><msg @l="2207" char_id="0" frame_id="1" name="美帆"   text="『但是……那种事，果然还是不行啊。』" voices=""/><msg @l="2209" char_id="0" frame_id="1" name="美帆"   text="『一个毫无关系的我在泳池边肯定会被奇怪地看待……啊，而且我放弃游泳的时候把竞速泳衣什么的都扔掉了。』"   voices=""/><msg @l="2211" char_id="2" frame_id="-1" name="亚季奈"   text="『没关系没关系，根本不会被奇怪地看待啦。』" voices=""/><msg @l="2213" char_id="2" frame_id="-1" name="亚季奈"   text="『而且姐姐是教练嘛，所以穿那种去海边或室外游泳池的泳衣也没关系。』" voices=""/><msg @l="2215" char_id="0" frame_id="1" name="美帆"   text="『真是的，亚季奈总是这样随便说些话……』" voices=""/><msg @l="2217" char_id="2" frame_id="-1" name="亚季奈"   text="『其实呢，我已经跟游泳部的孩子们说了“我姐姐会完美地担任教练，所以放心吧！”……已经这么说了。』"   voices=""/><msg @l="2219" char_id="2" frame_id="-1" name="亚季奈"   text="『所以，不管怎样，如果姐姐不来当教练的话，我就麻烦了！』" voices=""/><msg @l="2221" char_id="0" frame_id="1" name="美帆" text="(……原来如此)" voices=""/><msg @l="2223" char_id="-1" frame_id="-1" name="" text="所以才说是“一生的请求”啊。"   voices=""/><msg @l="2224" char_id="-1" frame_id="-1" name=""   text="真是的……果然提出了一个不讲道理的请求。" voices=""/><msg @l="2226" char_id="2" frame_id="-1" name="亚季奈"   text="『呐，拜托了……就当是帮助可爱的妹妹吧！』" voices=""/><msg @l="2228" char_id="0" frame_id="1" name="美帆"   text="『可是，我已经退出游泳了……』" voices=""/><msg @l="2230" char_id="0" frame_id="1" name="美帆"   text="『我已经三年多没游泳了哦？没信心教好啊。』" voices=""/><msg @l="2232" char_id="2" frame_id="-1" name="亚季奈"   text="『姐姐一定没问题，我可以保证！』" voices=""/><msg @l="2234" char_id="0" frame_id="1" name="美帆"   text="『被亚季奈保证也不会觉得高兴……』" voices=""/><msg @l="2236" char_id="2" frame_id="-1" name="亚季奈"   text="『呃……总、总之！集训从下周一开始。』" voices=""/><msg @l="2238" char_id="2" frame_id="-1" name="亚季奈"   text="『下课后一定要来室内游泳池哦！』" voices=""/><char @l="2242" id="miho" pos="auto" src="miho034"/><msg @l="2244" char_id="0" frame_id="1" name="美帆"   text="『诶，啊……等等，你怎么自顾自地把话题进行下去了……』" voices=""/><msg @l="2246" char_id="2" frame_id="-1" name="亚季奈" text="『那么，拜托你啦！』"   voices=""/><se @l="2250" buf="1" src="通話が切れた後の音" volume="1."/><msg @l="2252" char_id="0" frame_id="1" name="美帆"   text="『喂，亚季奈……啊，挂断了。』" voices=""/><stopse @l="2256" buf="1"/><bgm @l="2260" src="bgm02" volume="1."/><char @l="2264" id="miho" pos="auto" src="miho136"/><msg @l="2266" char_id="0" frame_id="1" name="美帆"   text="『真是的……总是这么自私……』" voices=""/><msg @l="2268" char_id="0" frame_id="1" name="美帆" text="『………』" voices=""/><msg @l="2270" char_id="0" frame_id="1" name="美帆" text="『游泳啊……』" voices=""/><msg @l="2272" char_id="0" frame_id="1" name="美帆"   text="『我也……如果没有那件事的话，现在也许还会继续游泳吧……』" voices=""/><msg @l="2274" char_id="-1" frame_id="-1" name=""   text="因为某个事件，我放弃了游泳。" voices=""/><msg @l="2275" char_id="-1" frame_id="-1" name=""   text="不是身体出了故障，也不是感觉到了极限……不是这种常见的理由。" voices=""/><msg @l="2276" char_id="-1" frame_id="-1" name="" text="那确实是一场「事件」。"   voices=""/><msg @l="2277" char_id="-1" frame_id="-1" name=""   text="一个被各相关人士……特别是按照我的意愿，避免公开而秘密埋葬于黑暗中的事件。" voices=""/><msg @l="2278" char_id="-1" frame_id="-1" name=""   text="但是，它至今仍在我的心中留下了深深的伤痕。" voices=""/><msg @l="2279" char_id="-1" frame_id="-1" name="" text="……确实如此。" voices=""/><msg @l="2283" char_id="0" frame_id="1" name="美帆" text="『………。』" voices=""/><char @l="2286" id="miho" pos="auto" src="miho036"/><msg @l="2288" char_id="0" frame_id="1" name="美帆"   text="(不过……比起那个，眼前的问题是这份报告能不能按时完成呢)" voices=""/><msg @l="2290" char_id="-1" frame_id="-1" name=""   text="我看着桌上那本摊开的厚重专业书籍，深深地叹了口气。" voices=""/><eval @l="2293" expr="f.亜季奈ルートflag&#32;+=&#32;1&#13;&#10;"/><label @l="2298" id="EventLabel_38"/><stopbgm @l="2302" fadeout="1000"/><clear @l="2308" class="all"/><goto @l="2311" cond="!(f.稲庭ルートflag&#32;==&#32;1)&#13;&#10;"   label="TempLabel_245"/><call @l="2315" target="EventLabel_87@root_inaba01"/><return @l="2316" value="0&#13;&#10;"/><goto @l="2319" label="TempLabel_321"/><label @l="2320" id="TempLabel_245"/><goto @l="2321" cond="!(f.亜季奈ルートflag&#32;==&#32;1)&#13;&#10;"   label="TempLabel_322"/><call @l="2326" target="EventLabel_59@root_akina01"/><return @l="2327" value="0&#13;&#10;"/><label @l="2329" id="TempLabel_322"/><label @l="2330" id="TempLabel_321"/><return @l="2336" value=""/></code></xscript>																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																												