<?xml version="1.0" encoding="utf-8"?><xscript><debug editor="&quot;C:\Program&#32;Files&#32;(x86)\sakura\sakura.exe&quot;&#32;&quot;%src%&quot;&#32;-Y=%line%"   src="D:\シロップ\町ぐるみの罠＋汚された夏セット版\汚された夏\完成データ\汚された夏\script\text\ending12.txt"/><code><label @l="12" id="EventLabel_50"/><description @l="16" text="网球部共用宠物"/><eval @l="18" expr="f.numDay=0&#13;&#10;"/><label @l="21" id="event_scene75"/><wait_chgmv/><bg @l="25" src="bg13m1"/><bgm @l="29" src="bgm03" volume="1."/><char @l="33" id="miho" pos="auto" src="miho050"/><msg @l="35" char_id="0" frame_id="-1" name="美帆" text="『……。』"   voices="miho12270"/><msg @l="37" char_id="-1" frame_id="-1" name="" text="———数周后。" voices=""/><msg @l="38" char_id="-1" frame_id="-1" name="" text="我今天也来到了网球场。"   voices=""/><msg @l="39" char_id="-1" frame_id="-1" name=""   text="从那以后，我几乎每天都参加网球社的活动。" voices=""/><msg @l="40" char_id="-1" frame_id="-1" name="" text="最初只是类似威胁的传唤。"   voices=""/><msg @l="41" char_id="-1" frame_id="-1" name=""   text="被男性会员们侵犯的我，以不想公开当时事实为由，第二天和第三天也被叫到部室里遭到轮奸。"   voices=""/><msg @l="42" char_id="-1" frame_id="-1" name=""   text="每次我都被刻印上深刻的高潮……身体各处都被凌辱、玷污。" voices=""/><msg @l="43" char_id="-1" frame_id="-1" name="" text="已经……无所谓了。"   voices=""/><msg @l="44" char_id="-1" frame_id="-1" name="" text="身体所获得的快感。"   voices=""/><msg @l="45" char_id="-1" frame_id="-1" name="" text="心灵所承受的绝望。" voices=""/><msg @l="46" char_id="-1" frame_id="-1" name="" text="已经麻痹了我的一切。"   voices=""/><msg @l="48" char_id="-1" frame_id="-1" name="男会员"   text="『哟，看来今天你也乖乖来了嘿嘿嘿……』" voices=""/><char @l="52" id="miho" pos="auto" src="miho053"/><msg @l="54" char_id="0" frame_id="-1" name="美帆" text="『……。』"   voices="miho12280"/><msg @l="56" char_id="-1" frame_id="-1" name="男会员"   text="『呵呵呵呵……那么？命令都遵守了吧？』" voices=""/><msg @l="58" char_id="0" frame_id="-1" name="美帆" text="『我……都遵守了。』"   voices="miho12290"/><msg @l="60" char_id="-1" frame_id="-1" name="" text="这么说着，我微微并拢了大腿。"   voices=""/><stopbgm @l="64" fadeout="1000"/><clear @l="70" class="all"/><msgshow @l="72" show="true"/><label @l="75" id="chart_line63"/><wait_chgmv/><ev @l="79" src="ev-043y1y2y3z1"/><bgm @l="83" src="bgm14" volume="1."/><msg @l="85" char_id="-1" frame_id="-1" name="" text="我的私处插入着震动棒。"   voices=""/><msg @l="86" char_id="-1" frame_id="-1" name=""   text="就这样，在插入震动棒之后穿上内裤……一路走到了这里。" voices=""/><msg @l="87" char_id="-1" frame_id="-1" name=""   text="走过人来人往的地方，装作若无其事的样子……" voices=""/><msg @l="89" char_id="-1" frame_id="-1" name="男会员"   text="『我要检查一下你是否真的遵守了命令嘿嘿嘿嘿嘿。』" voices=""/><msg @l="91" char_id="-1" frame_id="-1" name=""   text="昨天将震动棒交给我的男子社团成员说着这话，把手伸进口袋里鼓捣着什么。" voices=""/><msg @l="92" char_id="-1" frame_id="-1" name="" text="下一瞬间。" voices=""/><msg @l="93" char_id="-1" frame_id="-1" name="" text="嗡嗡嗡嗡嗡嗡嗡嗡嗡嗡嗡嗡嗡……"   voices=""/><msg @l="95" char_id="0" frame_id="-1" name="美帆" text="『嗯……』"   voices="miho12300"/><msg @l="97" char_id="-1" frame_id="-1" name=""   text="撑开我私处的震动棒发出低沉的声音开始振动。" voices=""/><msg @l="98" char_id="-1" frame_id="-1" name=""   text="他在口袋里按下了震动棒的开关。" voices=""/><msg @l="103" char_id="0" frame_id="-1" name="美帆" text="『啊，啊啊……』"   voices="miho12310"/><msg @l="105" char_id="-1" frame_id="-1" name=""   text="震动棒的振动使深处积累的蜜液溢了出来。" voices=""/><msg @l="106" char_id="-1" frame_id="-1" name=""   text="光是插入震动棒在光天化日之下行走的背德感，就已经让我的下体变得湿滑不堪。" voices=""/><msg @l="107" char_id="-1" frame_id="-1" name=""   text="网球场各处都能看到像他这样握着震动棒开关、面带猥琐笑容的男子部员们。"   voices=""/><msg @l="108" char_id="-1" frame_id="-1" name=""   text="……还有面带鄙夷与轻蔑表情的女性部员们。" voices=""/><msg @l="110" char_id="0" frame_id="-1" name="美帆"   text="『啊啊……要，要溢出来了。』" voices="miho12320"/><msg @l="112" char_id="-1" frame_id="-1" name="男会员" text="『嗯哼。』" voices=""/><msg @l="114" char_id="-1" frame_id="-1" name="男会员"   text="『不过，这样我可不知道你是不是真的塞进去了震动棒呢，呵呵呵呵。』" voices=""/><msg @l="116" char_id="0" frame_id="-1" name="美帆" text="『怎么会……真的塞进去了。』"   voices="miho12330"/><msg @l="118" char_id="-1" frame_id="-1" name="男会员"   text="『嘿嘿嘿嘿，你没有撒谎的证据在哪里？不是吗？』" voices=""/><msg @l="120" char_id="0" frame_id="-1" name="美帆" text="『那个是……』"   voices="miho12340"/><msg @l="122" char_id="-1" frame_id="-1" name="" text="嗡嗡嗡嗡嗡嗡嗡嗡嗡嗡嗡嗡嗡……"   voices=""/><msg @l="123" char_id="-1" frame_id="-1" name=""   text="即使在我们交谈的间隙，震动棒也在发出低沉的声音不停振动。" voices=""/><msg @l="124" char_id="-1" frame_id="-1" name=""   text="无论如何，他不可能没听到那震动的声音。" voices=""/><msg @l="126" char_id="-1" frame_id="-1" name="男会员"   text="『那你就在这里掀起裙子，脱掉内裤，让我看看插在小穴里的震动棒。』" voices=""/><msg @l="128" char_id="0" frame_id="-1" name="美帆" text="『那种事……』"   voices="miho10060"/><msg @l="130" char_id="-1" frame_id="-1" name=""   text="虽然我已经顺从了男子会员们的指令，但在女子会员面前展示还是很羞耻，再加上现在场外还有社团以外的人在看，所以我实在无法爽快地答应。"   voices=""/><msg @l="132" char_id="-1" frame_id="-1" name="男会员"   text="『什么嘛，挺反抗的嘛。算了。那如果你能忍受接下来100球的特训，我就相信你插了震动棒，不用给我看。』"   voices=""/><msg @l="134" char_id="-1" frame_id="-1" name=""   text="男子会员一边奸笑着一边提出了妥协方案。" voices=""/><msg @l="136" char_id="0" frame_id="-1" name="美帆" text="『啊……』"   voices="miho10200"/><msg @l="138" char_id="-1" frame_id="-1" name=""   text="美帆听到男子会员的话，表情变得阴郁。这也难怪，因为插着震动棒光是站着都很刺激了，如果这样进行训练的话，不知道会变成什么样。"   voices=""/><msg @l="140" char_id="-1" frame_id="-1" name="男会员"   text="『怎么了啊？该不会两个都不愿意吧？那我现在就在这里让大伙轮了你。』" voices=""/><msg @l="142" char_id="-1" frame_id="-1" name=""   text="男人说着轻轻举起手，正在练习的几名男子部员注意到了，朝着这边走过来。" voices=""/><msg @l="144" char_id="0" frame_id="-1" name="美帆" text="『……。』"   voices="miho12350"/><msg @l="146" char_id="-1" frame_id="-1" name="男会员" text="『你怎么决定？要做吗？』"   voices=""/><msg @l="148" char_id="-1" frame_id="-1" name=""   text="美帆短暂犹豫后，露出痛苦的表情点了点头。" voices=""/><msg @l="150" char_id="0" frame_id="-1" name="美帆" text="『……是的。』"   voices="miho12360"/><clear @l="156" class="all"/><msgshow @l="158" show="true"/><wait_chgmv/><ev @l="160" src="ev-043y1y2y3z1"/><msg @l="162" char_id="-1" frame_id="-1" name="男会员"   text="『喂——！你跟不上球啊——！！快追啊——！！』" voices=""/><msg @l="164" char_id="0" frame_id="-1" name="美帆" text="『……呃……。』"   voices="miho09930"/><msg @l="166" char_id="-1" frame_id="-1"   name=""   text="男子会员为了让美帆奔跑，总是将球打到她看似能够到却又够不到的地方。美帆也拼命追赶，但毕竟插着震动棒无法集中精力在球上，别说回击了，连追上球都做不到。"   voices=""/><msg @l="168" char_id="-1" frame_id="-1" name="男会员" text="『看这边看这边！左边啊左边——！！！』"   voices=""/><msg @l="170" char_id="0" frame_id="-1" name="美帆" text="『……！？』"   voices="miho10040"/><msg @l="172" char_id="-1" frame_id="-1" name="男会员" text="『这次是右边，右边——！！！』"   voices=""/><msg @l="174" char_id="0" frame_id="-1" name="美帆" text="『唔……。』"   voices="miho09910"/><msg @l="176" char_id="-1" frame_id="-1" name="男会员"   text="『看，前面，前面——！一个球都接不到啊——！！！』" voices=""/><msg @l="178" char_id="0" frame_id="-1" name="美帆" text="『嗯，啊……。』"   voices="miho09920"/><msg @l="180" char_id="-1" frame_id="-1" name=""   text="就这样当美帆追逐着球时，从插入震动棒的秘缝中漏出了水声。" voices=""/><msg @l="182" char_id="-1" frame_id="-1" name="" text="咕啾" voices=""/><msg @l="183" char_id="-1" frame_id="-1" name="" text="咕啾咕啾" voices=""/><msg @l="185" char_id="-1" frame_id="-1" name="男会员"   text="『什么啊！你这家伙明明在练习却把小穴弄湿了吗——！！真是个变态——！！！』" voices=""/><msg @l="187" char_id="0" frame_id="-1" name="美帆" text="『………………。』"   voices="miho09930"/><msg @l="189" char_id="-1" frame_id="-1" name="男会员"   text="『看啊——！球去后面了——！！这球总该能打到吧——！！！』" voices=""/><msg @l="191" char_id="-1" frame_id="-1" name=""   text="美帆拼命地追逐着球想把它打回去——然后就在她捕捉到球准备击打的瞬间……" voices=""/><msg @l="193" char_id="-1" frame_id="-1" name=""   text="男子会员得意地笑了笑，把震动棒的振动调到了最强！" voices=""/><msg @l="195" char_id="-1" frame_id="-1" name="" text="嗡嗡嗡嗡嗡嗡嗡嗡嗡嗡嗡嗡嗡嗡嗡嗡"   voices=""/><msg @l="197" char_id="0" frame_id="-1" name="美帆" text="『……！？』"   voices="miho10040"/><msg @l="199" char_id="0" frame_id="-1" name="美帆" text="『嗯嗯！』"   voices="miho09990"/><flash @l="203" count="4" fade="100" image="white"/><wait_chgmv/><ev @l="207" src="ev-043x1y1y2y3z2"/><msg @l="209" char_id="0" frame_id="-1" name="美帆" text="『嗯，啊啊啊啊！！』"   voices="miho10440"/><msg @l="211" char_id="-1" frame_id="-1" name=""   text="美帆在下腹用力准备击球的瞬间，震动棒被打开了开关，她直接感受到了振动，结果高潮了……。"   voices=""/><msg @l="212" char_id="-1" frame_id="-1" name="" text="然后就那样失禁了。"   voices=""/><flash @l="216" count="4" fade="100" image="white"/><msg @l="218" char_id="-1" frame_id="-1" name="" text="噗哗啊啊啊啊啊啊啊啊啊啊啊啊啊"   voices=""/><msg @l="220" char_id="0" frame_id="-1" name="美帆" text="『嗯，啊啊啊啊啊啊啊！！』"   voices="miho11040"/><clear @l="226" class="all"/><wait_chgmv/><bg @l="230" src="bg13m1"/><msg @l="232" char_id="-1" frame_id="-1" name="男会员"   text="『啊——哎，这家伙不仅高潮了还尿了裤子。真恶心。』" voices=""/><msg @l="234" char_id="-1" frame_id="-1" name=""   text="虽然嘴上这么说，但男子会员脸上却挂着得意的笑容，朝美帆走了过来。" voices=""/><msg @l="236" char_id="0" frame_id="-1" name="美帆" text="『……。』"   voices="miho09900"/><msg @l="238" char_id="-1" frame_id="-1" name="男会员"   text="『这样就没法继续练习了啊。……喂，你们几个。』" voices=""/><msg @l="240" char_id="-1" frame_id="-1" name=""   text="男人说着，招呼过那些正用淫邪目光盯着美帆的男子会员们。" voices=""/><msg @l="241" char_id="-1" frame_id="-1" name="男会员"   text="『把她抬到社团活动室去。练习中居然尿裤子了，必须好好惩罚她一下才行。』" voices=""/><msg @l="243" char_id="-1" frame_id="-1" name=""   text="于是美帆被人架着胳膊带到了社团活动室。" voices=""/><msg @l="245" char_id="0" frame_id="-1" name="美帆" text="『……。』"   voices="miho09900"/><msg @l="247" char_id="-1" frame_id="-1" name=""   text="被带走的过程中，美帆的表情却有些高兴的样子。" voices=""/><msg @l="248" char_id="-1" frame_id="-1" name=""   text="仿佛今天又在期待着……有人往这具身体里注入大量精液一般……。" voices=""/><clear @l="254" class="all"/><end_scene @l="257"/><label @l="259" id="event_scene38"/><goto @l="261" cond="!(f.flagInExtraMode&#32;&gt;&#32;100)&#13;&#10;"   label="TempLabel_317"/><bgm @l="263" src="bgm14" volume="1."/><label @l="264" id="TempLabel_317"/><msgshow @l="267" show="true"/><label @l="271" id="chart_line64"/><msg @l="273" char_id="-1" frame_id="-1" name="" text="撕拉撕拉撕拉撕拉撕啦"   voices=""/><msg @l="275" char_id="0" frame_id="-1" name="美帆" text="『呃啊！！』"   voices="miho10100"/><msg @l="277" char_id="-1" frame_id="-1" name=""   text="男子会员将美帆带进社团活动室后，像往常侵犯她时一样，撕裂了她的网球服。" voices=""/><msg @l="278" char_id="-1" frame_id="-1" name=""   text="然后粗暴地取出塞在美帆私处的震动棒。震动棒被取出后，她的私处发出了淫靡的水声。" voices=""/><msg @l="280" char_id="-1" frame_id="-1" name="" text="咕啾" voices=""/><msg @l="282" char_id="0" frame_id="-1" name="美帆" text="『嗯嗯………啊，啊啊啊…………。』"   voices="miho10330"/><msg @l="284" char_id="-1" frame_id="-1" name="男会员"   text="『嘿嘿，已经湿透了啊。这样的话马上就能插进去了。』" voices=""/><msg @l="285" char_id="-1" frame_id="-1" name=""   text="话音刚落，男子会员灼热坚硬的肉棒就贯穿了美帆私处的花唇。" voices=""/><wait_chgmv/><ev @l="289" src="ev-038"/><msg @l="291" char_id="0" frame_id="-1" name="美帆" text="『啊啊……。』"   voices="miho12370"/><msg @l="293" char_id="-1" frame_id="-1" name=""   text="男人隔着被撕裂的网球服，用力揉捏着柔软的乳房，甚至将其形状都揉得变形………。" voices=""/><msg @l="295" char_id="0" frame_id="-1" name="美帆" text="『嗯嗯！！』"   voices="miho10930"/><msg @l="297" char_id="-1" frame_id="-1" name="男会员"   text="『好啊，我要狠狠地侵犯你直到你昏过去。』" voices=""/><msg @l="299" char_id="-1" frame_id="-1" name=""   text="会员的他说完立刻猛烈地撞击起腰部。" voices=""/><msg @l="300" char_id="-1" frame_id="-1" name=""   text="每一次抽插，我那湿漉漉的私处都发出咕叽咕叽的淫靡水声，像是要将他的那物完全吞入最深处一般。"   voices=""/><msg @l="301" char_id="-1" frame_id="-1" name=""   text="一开始每次被撕裂网球服时我都感到恐惧，但现在被撕裂反而让我感到一阵阵快感。" voices=""/><msg @l="302" char_id="-1" frame_id="-1" name=""   text="他们也是……每次撕裂服装时，都会增强征服女性的快感。" voices=""/><msg @l="304" char_id="-1" frame_id="-1" name="男会员"   text="『嘿嘿……乳头已经这么硬了啊。』" voices=""/><msg @l="306" char_id="-1" frame_id="-1" name="" text="男人的手伸向胸部。" voices=""/><msg @l="307" char_id="-1" frame_id="-1" name=""   text="当他捏住并用力拉扯已经勃起变硬的乳头时，甜美的麻痹感在我全身蔓延。" voices=""/><msg @l="309" char_id="0" frame_id="-1" name="美帆" text="『嗯……啊，啊呜！！』"   voices="miho12380"/><msg @l="311" char_id="-1" frame_id="-1" name="男会员"   text="『嘿嘿嘿嘿嘿……感觉还是这么敏感嘛。』" voices=""/><msg @l="313" char_id="0" frame_id="-1" name="美帆"   text="『啊啊……嗯，嗯嗯………这种事………。』" voices="miho12390"/><msg @l="315" char_id="-1" frame_id="-1" name="男会员"   text="『现在装什么纯情啊，你淫荡的本性早就暴露了。』" voices=""/><msg @l="317" char_id="-1" frame_id="-1" name=""   text="男人的手伸向私处，搅动着已经湿得一塌糊涂的阴道。" voices=""/><msg @l="319" char_id="0" frame_id="-1" name="美帆"   text="『嗯，啊啊，那里不行……嗯，嗯嗯！！』" voices="miho12400"/><msg @l="321" char_id="-1" frame_id="-1" name="男会员"   text="『什么不行啊，说来听听。』" voices=""/><msg @l="323" char_id="0" frame_id="-1" name="美帆"   text="『那里，揉捏的话……啊……啊啊……要去了，嗯嗯！！』" voices="miho12410"/><msg @l="325" char_id="-1" frame_id="-1" name=""   text="每当他执拗地拨弄我的阴蒂，我就会大幅扭动腰部，身体不断地颤抖。" voices=""/><msg @l="326" char_id="-1" frame_id="-1" name=""   text="交合处大量的爱液噗嗤噗嗤地溢出……缠绕在男根上，闪闪发亮。" voices=""/><msg @l="328" char_id="-1" frame_id="-1" name="男会员"   text="『太厉害了，里面紧紧地吸住我。』" voices=""/><msg @l="330" char_id="-1" frame_id="-1" name="男会员"   text="『马上就要去了吧？要去的话就好好说出来。』" voices=""/><msg @l="332" char_id="0" frame_id="-1" name="美帆"   text="『嗯呜……啊，嗯啊………好……嗯……嗯嗯嗯嗯……。』" voices="miho12420"/><msg @l="334" char_id="0" frame_id="-1" name="美帆"   text="『要去了……已经，要去了……去，去去去……要去了啊……。』" voices="miho12430"/><msg @l="336" char_id="-1" frame_id="-1" name=""   text="阴蒂被捏起，子宫深处敏感的地方被龟头顶撞着，我按照他的要求告诉他即将到来的高潮。"   voices=""/><msg @l="338" char_id="-1" frame_id="-1" name="男会员"   text="『嘿嘿嘿嘿……好啊……去吧，尽情地去。』" voices=""/><msg @l="340" char_id="-1" frame_id="-1" name="" text="男人的手指用力扭捏着阴蒂。"   voices=""/><msg @l="342" char_id="0" frame_id="-1" name="美帆" text="『嘶——————！？』"   voices="miho12440"/><msg @l="344" char_id="-1" frame_id="-1" name="" text="强烈的麻痹感穿过全身。"   voices=""/><msg @l="345" char_id="-1" frame_id="-1" name=""   text="那带着大量疼痛的感觉，伴随着甜蜜的麻痹，化作强烈的刺激向我袭来。" voices=""/><msg @l="347" char_id="0" frame_id="-1" name="美帆"   text="『去去去去去去去去去……嗯，啊啊啊啊啊啊啊嘶啊啊啊啊啊啊！！！』" voices="miho12450"/><msg @l="349" char_id="-1" frame_id="-1" name="男会员" text="『咕呜呜！！』"   voices=""/><flash @l="353" count="4" fade="100" image="white"/><wait_chgmv/><ev @l="357" src="ev-038x1z1"/><msg @l="359" char_id="0" frame_id="-1" name="美帆"   text="『嗯嗯……啊……呼……哈啊……。』" voices="miho12460"/><msg @l="361" char_id="-1" frame_id="-1" name=""   text="灼热的液体先是注入子宫深处，随后男根抽出，大量精液撒在我的身体上。" voices=""/><msg @l="362" char_id="-1" frame_id="-1" name=""   text="白浊色的液体灼烧着我的皮肤，然后渗入网球服中。" voices=""/><msg @l="364" char_id="-1" frame_id="-1" name="男学生"   text="『嘿嘿嘿嘿……好，下一个可以进来了。』" voices=""/><msg @l="366" char_id="-1" frame_id="-1" name=""   text="射精结束后，男人对着部室外面喊道。" voices=""/><msg @l="367" char_id="-1" frame_id="-1" name=""   text="部室外面恐怕……是从网球场赶来的男性部员们排成的队伍吧。" voices=""/><stopbgm @l="371" fadeout="1000"/><clear @l="377" class="all"/><msg @l="379" char_id="0" frame_id="-1" name="美帆" text="『…………呵呵……呵…………。』"   voices="miho12470"/><msg @l="381" char_id="-1" frame_id="-1" name=""   text="我在高潮的余韵中心脏颤抖着……无力地笑着。" voices=""/><msg @l="382" char_id="-1" frame_id="-1" name=""   text="已经……再也不会回来的平静日常，我想着……同时感受着所失去的一切是如此巨大……。" voices=""/><clear @l="388" class="all"/><wait @l="390" time="2000"/><end_scene @l="392"/><goto @l="395" cond="!(s.exRootFlag)&#13;&#10;" label="TempLabel_318"/><call @l="398" target="EventLabel_56@ex_ending02"/><return @l="399" value="0&#13;&#10;"/><label @l="401" id="TempLabel_318"/><eval @l="406" expr="s.flagGallery=1&#13;&#10;"/><eval @l="408" expr="s.event38flag=1&#13;&#10;"/><eval @l="412"   expr="f.bEx&#32;=&#32;s.event20flag&#32;&amp;&amp;&#32;s.event23flag&#32;&amp;&amp;&#32;s.event25flag&#32;&amp;&amp;&#32;s.event30flag&#32;&amp;&amp;&#32;s.event31flag&#32;&amp;&amp;&#32;s.event32flag&#32;&amp;&amp;&#32;s.event33flag&#32;&amp;&amp;&#32;s.event35flag&#32;&amp;&amp;&#32;s.event37flag&#32;&amp;&amp;&#32;s.event38flag&#32;&amp;&amp;&#32;s.event60flag&#13;&#10;"/><goto @l="414" cond="!(f.bEx)&#13;&#10;" label="TempLabel_319"/><eval @l="416" expr="s.exRootFlag=1&#13;&#10;"/><label @l="417" id="TempLabel_319"/><ending @l="419"/><goto @l="421" cond="!(f.bEx)&#13;&#10;" label="TempLabel_320"/><wait_chgmv/><bg @l="425" src="newroot"/><wait @l="427" time="5000"/><wait_chgmv/><bg @l="429" src="black"/><label @l="432" id="TempLabel_320"/><return @l="436" value=""/></code></xscript>																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																		