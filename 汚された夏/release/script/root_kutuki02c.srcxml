<?xml version="1.0" encoding="utf-8"?><xscript><debug editor="&quot;C:\Program&#32;Files&#32;(x86)\sakura\sakura.exe&quot;&#32;&quot;%src%&quot;&#32;-Y=%line%"   src="D:\シロップ\町ぐるみの罠＋汚された夏セット版\汚された夏\完成データ\汚された夏\script\text\root_kutuki02c.txt"/><code><label @l="10" id="EventLabel_113"/><description @l="13" text="契约的日子·第1天"/><eval @l="15" expr="f.numDay=5&#13;&#10;"/><msgshow @l="17" show="false"/><wait_chgmv/><bg @l="19" src="day05" time="2000"/><wait @l="21" time="500"/><wait_chgmv/><bg @l="23" src="black" time="2000"/><msgshow @l="25" show="true"/><wait_chgmv/><bg @l="28" src="bg21m1"/><bgm @l="31" src="bgm03" volume="1."/><char @l="34" id="miho" pos="auto" src="miho116"/><msg @l="36" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="38" char_id="-1" frame_id="-1" name=""   text="刚过中午时分……我正准备在常去的站台登上电车。" voices=""/><msg @l="39" char_id="-1" frame_id="-1" name=""   text="今天只有第三节课，所以这么晚出门也没关系。" voices=""/><msg @l="41" char_id="0" frame_id="-1" name="美帆" text="（今天……没问题吧？）"   voices=""/><msg @l="43" char_id="-1" frame_id="-1" name=""   text="我警惕地环顾四周。" voices=""/><msg @l="44" char_id="-1" frame_id="-1" name="" text="暂时……没发现可疑的身影。"   voices=""/><msg @l="45" char_id="-1" frame_id="-1" name=""   text="当然，我警惕的对象是朽木教授……没错。" voices=""/><msg @l="47" char_id="0" frame_id="-1" name="美帆"   text="（这种时间应该不会被盯上吧……）" voices=""/><clear @l="50" class="all"/><label @l="53" id="event_scene73"/><msg @l="55" char_id="-1" frame_id="-1" name="" text="我掏出定期票，登上了电车。"   voices=""/><msg @l="56" char_id="-1" frame_id="-1" name=""   text="确认常坐的墙边位置空着后，我便侧身滑进那个位置站好。" voices=""/><se @l="59" buf="3" loop="true" src="電車走行中" volume="1."/><label @l="62" id="chart_line42"/><wait_chgmv/><ev @l="65" src="ev-005"/><msg @l="67" char_id="0" frame_id="-1" name="美帆" text="『……。』"   voices="miho07530"/><msg @l="69" char_id="-1" frame_id="-1" name=""   text="电车启动后的一段时间里，我漫无目的地望着窗外。" voices=""/><msg @l="70" char_id="-1" frame_id="-1" name=""   text="然而这种无所事事而幸福的时光……并没有持续太久。" voices=""/><stopbgm @l="73" fadeout="1000"/><description @l="76" text="陌生的痴汉"/><msg @l="78" char_id="0" frame_id="-1" name="美帆" text="（啊……不会吧……）"   voices="miho07540"/><msg @l="80" char_id="-1" frame_id="-1" name=""   text="隔着裙子感受到的明显异样，瞬间让我血色尽失。" voices=""/><bgm @l="83" src="bgm15" volume="1."/><msg @l="85" char_id="0" frame_id="-1" name="美帆" text="（明明……是这种……时间……）"   voices="miho07550"/><msg @l="87" char_id="-1" frame_id="-1" name="" text="我深深地低下头，紧紧咬住下唇。"   voices=""/><msg @l="88" char_id="-1" frame_id="-1" name="" text="不知何时他混了进来。"   voices=""/><msg @l="89" char_id="-1" frame_id="-1" name="" text="或者……是他一直在埋伏着等我？"   voices=""/><msg @l="90" char_id="-1" frame_id="-1" name=""   text="无论如何，在正午的拥挤电车上如此大胆地实施痴汉行为的人，除了朽木教授外我想不到别人。" voices=""/><msg @l="92" char_id="0" frame_id="-1" name="美帆" text="（怎、怎么办……）"   voices="miho07560"/><msg @l="94" char_id="-1" frame_id="-1" name=""   text="每当隔着裙子被抚摸臀部时，厌恶感让我背脊直发麻。" voices=""/><msg @l="95" char_id="-1" frame_id="-1" name="" text="但是……我无法反抗。"   voices=""/><msg @l="96" char_id="-1" frame_id="-1" name=""   text="如果我反抗的话，父亲……全家就会毁灭。" voices=""/><msg @l="98" char_id="0" frame_id="-1" name="美帆" text="『……。』"   voices="miho07570"/><msg @l="100" char_id="-1" frame_id="-1" name="痴汉" text="『……。』" voices=""/><msg @l="102" char_id="-1" frame_id="-1" name=""   text="他的手，慢慢地伸进了我的裙子里。" voices=""/><wait_chgmv/><ev @l="105" src="ev-005bx2y4"/><msg @l="107" char_id="-1" frame_id="-1" name=""   text="即便如此，我也无法反抗，只能一动不动地忍受着。" voices=""/><msg @l="109" char_id="0" frame_id="-1" name="美帆" text="『啊……。』"   voices="miho07580"/><msg @l="111" char_id="-1" frame_id="-1" name=""   text="手指刚侵入裙子内，就隔着内裤摩擦起我的缝隙。" voices=""/><msg @l="112" char_id="-1" frame_id="-1" name=""   text="仿佛在享受那柔软的触感，隔着内裤描绘着私密部位的缝隙，指尖前后蠕动着。" voices=""/><msg @l="114" char_id="0" frame_id="-1" name="美帆" text="『……唔……。』"   voices="miho01490"/><msg @l="116" char_id="-1" frame_id="-1" name="" text="那粗糙的指尖触感……有点疼。"   voices=""/><msg @l="118" char_id="-1" frame_id="-1" name="痴汉" text="『……。』" voices=""/><wait_chgmv/><ev @l="121" src="ev-005bx2y3"/><bgm @l="124" src="bgm14" volume="1."/><msg @l="126" char_id="-1" frame_id="-1" name=""   text="另一只手隔着衣服揉捏着被纯白胸罩包裹的胸部，扭曲着它的形状。" voices=""/><msg @l="128" char_id="0" frame_id="-1" name="美帆" text="『……。』"   voices="miho09880"/><msg @l="130" char_id="-1" frame_id="-1" name=""   text="确认我没有特别反抗后，他另一只手更加大胆地用手指抚摸起私处的沟壑。" voices=""/><msg @l="131" char_id="-1" frame_id="-1" name=""   text="只是……总觉得他今天的抚摸方式和以前有些不同。" voices=""/><msg @l="132" char_id="-1" frame_id="-1" name="" text="……总觉得是这样。"   voices=""/><msg @l="134" char_id="0" frame_id="-1" name="美帆" text="（就因为我无法反抗……）"   voices="miho07590"/><msg @l="136" char_id="-1" frame_id="-1" name=""   text="痴汉隔着衣服沿着胸部柔软的曲线画圆般地抚摸，还从下方托起，上下晃动，玩弄着富有青春弹性的胸部。"   voices=""/><msg @l="138" char_id="0" frame_id="-1" name="美帆" text="『……啊……。』"   voices="miho00740"/><msg @l="140" char_id="-1" frame_id="-1" name=""   text="我咬着丰满的嘴唇，忍耐着那在胸部上不断爬行的手的触感。" voices=""/><msg @l="142" char_id="-1" frame_id="-1" name="痴汉" text="『……。』" voices=""/><msg @l="144" char_id="-1" frame_id="-1" name="" text="他的手从胸部移开了。" voices=""/><msg @l="145" char_id="-1" frame_id="-1" name=""   text="我以为他厌倦了抚摸胸部，正松了一口气的瞬间，他的手指却从衣服的缝隙侵入，隔着胸罩用力揉捏起乳房的圆润，像是在确认其形状。"   voices=""/><msg @l="147" char_id="0" frame_id="-1" name="美帆" text="『嗯……。』"   voices="miho07600"/><msg @l="149" char_id="-1" frame_id="-1" name="痴汉" text="『……。』" voices=""/><msg @l="151" char_id="-1" frame_id="-1" name=""   text="痴汉的手在享受了一会儿胸罩的触感后，这次移动到了背后，隔着衬衫开始解开胸罩的搭扣。" voices=""/><msg @l="153" char_id="0" frame_id="-1" name="美帆" text="『啊……。』"   voices="miho11000"/><msg @l="155" char_id="-1" frame_id="-1" name=""   text="然后，胸罩的搭扣被轻而易举地解开，充满青春弹性的乳房仿佛被释放了强大的弹力，轻轻地晃动着，胸罩的罩杯滑落下来。"   voices=""/><msg @l="156" char_id="-1" frame_id="-1" name=""   text="接着，他再次从衣服的缝隙伸进手指，直接揉搓起乳房。" voices=""/><msg @l="158" char_id="0" frame_id="-1" name="美帆"   text="（不要……不要揉我的乳头……）" voices="miho07610"/><msg @l="160" char_id="-1" frame_id="-1" name=""   text="每当用两根手指搓弄乳头时，与内心相反，从喉咙深处涌上来的声音不禁漏了出来。" voices=""/><msg @l="162" char_id="0" frame_id="-1" name="美帆" text="『呜呜呜～～～。』"   voices="miho07620"/><msg @l="164" char_id="-1" frame_id="-1" name="痴汉" text="『……。』" voices=""/><msg @l="166" char_id="-1" frame_id="-1" name=""   text="然后这次用两根手指捏住小粒豆子般的乳头，用指腹摩擦。" voices=""/><msg @l="167" char_id="-1" frame_id="-1" name=""   text="原本像软糖一样柔软的乳头，眼看着充血变硬，变得尖挺，仿佛有一根淫荡的芯穿过一般。" voices=""/><msg @l="169" char_id="0" frame_id="-1" name="美帆" text="『嗯啊……嗯，嗯嗯！』"   voices="miho10960"/><msg @l="171" char_id="-1" frame_id="-1" name=""   text="他的一只手揉捏着胸部，而另一只在私密处摩擦的手指很快就找到了阴蒂的位置，集中地玩弄起来。"   voices=""/><msg @l="172" char_id="-1" frame_id="-1" name=""   text="手指抵在突起上，仿佛是要直接给核心部位施加震动般，进行着细微的震颤。" voices=""/><msg @l="174" char_id="0" frame_id="-1" name="美帆" text="『嗯嗯……呜……。』"   voices="miho07630"/><msg @l="176" char_id="-1" frame_id="-1" name="" text="我的口中不禁漏出微弱的喘息。"   voices=""/><msg @l="177" char_id="-1" frame_id="-1" name=""   text="明明是在拼命忍耐不让他发觉，却还是因为那执拗的爱抚让身体不由自主地产生了反应。" voices=""/><msg @l="179" char_id="-1" frame_id="-1" name="痴汉" text="『……。』" voices=""/><msg @l="181" char_id="-1" frame_id="-1" name="" text="在我耳边传来了微弱的笑声。"   voices=""/><msg @l="182" char_id="-1" frame_id="-1" name=""   text="仿佛以此为信号，那玩弄我身体的手指突然停止了动作，转而一把抓住了我的外衣。" voices=""/><wait_chgmv/><ev @l="185" src="ev-005bx3x5"/><msg @l="187" char_id="0" frame_id="-1" name="美帆" text="（啊……要干什么……）"   voices="miho07640"/><msg @l="189" char_id="-1" frame_id="-1" name=""   text="他熟练地掀起我的外套，露出了胸部和内衣。" voices=""/><msg @l="190" char_id="-1" frame_id="-1" name=""   text="甚至没有时间去抵抗……他的动作如此熟练。" voices=""/><msg @l="191" char_id="-1" frame_id="-1" name=""   text="暴露在外的白皙肌肤，足以撩起他的情欲。" voices=""/><msg @l="193" char_id="0" frame_id="-1" name="美帆" text="『……。』"   voices="miho07650"/><msg @l="195" char_id="-1" frame_id="-1" name=""   text="我本能地想要反抗，但强忍了下来。" voices=""/><msg @l="196" char_id="-1" frame_id="-1" name=""   text="如果我反抗，那么我为了保护父亲和家人的未来而献出处女之身所做的一切可能都会功亏一篑。" voices=""/><msg @l="197" char_id="-1" frame_id="-1" name=""   text="那样的结果……无论如何都必须避免。" voices=""/><msg @l="199" char_id="-1" frame_id="-1" name="痴汉" text="『……。』" voices=""/><msg @l="201" char_id="-1" frame_id="-1" name="" text="他又在我耳边笑了起来。"   voices=""/><msg @l="202" char_id="-1" frame_id="-1" name="" text="灼热的吐息喷在我的后颈上。"   voices=""/><msg @l="204" char_id="0" frame_id="-1" name="美帆" text="『唔嗯！』"   voices="miho00450"/><msg @l="206" char_id="-1" frame_id="-1" name=""   text="他靠近我的脖子，几乎要舔上来了，一边嗅着我的气味，一边隔着内裤不停地玩弄我的阴蒂。" voices=""/><msg @l="208" char_id="0" frame_id="-1" name="美帆" text="『嗯……呜……。』"   voices="miho07660"/><msg @l="210" char_id="-1" frame_id="-1" name=""   text="在持续不断的阴蒂刺激下，我的腰部渐渐开始麻痹。" voices=""/><msg @l="211" char_id="-1" frame_id="-1" name=""   text="他手指的振动越来越强烈，这种不讲理的快感几乎要化作声音溢出。" voices=""/><msg @l="213" char_id="0" frame_id="-1" name="美帆"   text="（不行……这种状态下发出声音的话……）" voices="miho07670"/><msg @l="215" char_id="0" frame_id="-1" name="美帆"   text="（周围的人会……会、看到的……）" voices="miho07680"/><msg @l="217" char_id="-1" frame_id="-1" name="" text="我拼命地想要抑制住自己的声音。"   voices=""/><msg @l="218" char_id="-1" frame_id="-1" name=""   text="但是……仿佛在享受我这样的反应一般，那只在我全身游走的手更加猛烈地摩擦着我的乳头和私处等敏感地带。"   voices=""/><msg @l="219" char_id="-1" frame_id="-1" name=""   text="尽管如此，我还是一直咬牙隐忍着……。" voices=""/><msg @l="221" char_id="0" frame_id="-1" name="美帆" text="『啊……嗯咕……。』"   voices="miho07690"/><msg @l="223" char_id="-1" frame_id="-1" name=""   text="那玩弄阴蒂的手指，一边摩擦延展着女阴上方，一边扩张入口，然后猛地插入了我的秘密肉穴。" voices=""/><msg @l="225" char_id="0" frame_id="-1" name="美帆" text="『呃啊！！』"   voices="miho10100"/><msg @l="227" char_id="-1" frame_id="-1" name=""   text="那一瞬间，我忍不住漏出了声音。" voices=""/><msg @l="229" char_id="0" frame_id="-1" name="美帆"   text="（呀……刚才那个，没被注意到吧……？）" voices="miho07700"/><msg @l="231" char_id="-1" frame_id="-1" name=""   text="我慌忙用手捂住嘴巴，深深低头把脸藏起来。" voices=""/><msg @l="232" char_id="-1" frame_id="-1" name=""   text="虽然胸部和内裤都被完全暴露着，但太过羞耻，我根本抬不起头来。" voices=""/><msg @l="234" char_id="0" frame_id="-1" name="美帆" text="『……。』"   voices="miho10340"/><msg @l="236" char_id="-1" frame_id="-1" name="痴汉" text="『……。』" voices=""/><msg @l="238" char_id="-1" frame_id="-1" name=""   text="就这样，他完全不在意我害怕周围目光的感受，揉捏着我那白皙美丽的半球形乳房直到变形，手指还在蜜壶里不停搅动。"   voices=""/><msg @l="240" char_id="0" frame_id="-1" name="美帆" text="（真……讨厌，快点到站啊……）"   voices="miho07710"/><msg @l="242" char_id="-1" frame_id="-1" name=""   text="我恳求般地望向窗外……但电车才刚刚过了一半路程而已。" voices=""/><msg @l="243" char_id="-1" frame_id="-1" name=""   text="也就是说这种状态还要持续十五分钟。" voices=""/><msg @l="245" char_id="0" frame_id="-1" name="美帆"   text="（这种事……不行……我忍不住了……）" voices="miho07720"/><msg @l="247" char_id="-1" frame_id="-1" name=""   text="就在我刚刚产生一丝放弃念头的瞬间，从下腹部涌出了一股热流。" voices=""/><msg @l="248" char_id="-1" frame_id="-1" name=""   text="那热热的淫靡液体顺着我体内流下，慢慢地从缝隙中溢了出来。" voices=""/><msg @l="250" char_id="0" frame_id="-1" name="美帆" text="『……！？』"   voices="miho10040"/><msg @l="252" char_id="-1" frame_id="-1" name=""   text="液滴顺着大腿流下，留下了宛如蛞蝓爬过的痕迹。" voices=""/><msg @l="253" char_id="-1" frame_id="-1" name=""   text="不久……那爱液粘腻地缠绕在他摩擦私处的手指上，开始发出淫秽的水声。" voices=""/><msg @l="255" char_id="0" frame_id="-1" name="美帆" text="『嗯唔……。』"   voices="miho09910"/><msg @l="257" char_id="-1" frame_id="-1" name="痴汉" text="『哦……。』"   voices=""/><msg @l="259" char_id="-1" frame_id="-1" name="" text="耳边传来一声惊讶的声音。"   voices=""/><msg @l="260" char_id="-1" frame_id="-1" name="" text="有什么不对劲。" voices=""/><msg @l="261" char_id="-1" frame_id="-1" name="" text="朽木教授会因为这种事情而惊讶吗？"   voices=""/><msg @l="262" char_id="-1" frame_id="-1" name="" text="冷静思考的话，我应该会这么想"   voices=""/><msg @l="263" char_id="-1" frame_id="-1" name=""   text="但此刻，他的手指在私处搅动的感觉让我丧失了思考能力。" voices=""/><msg @l="265" char_id="0" frame_id="-1" name="美帆" text="『嗯嗯，嗯……啊呜……。』"   voices="miho07730"/><msg @l="267" char_id="-1" frame_id="-1" name=""   text="明明想要压抑住声音，我的口中却伴随着炙热的吐息漏出些许哀切的呻吟。" voices=""/><msg @l="268" char_id="-1" frame_id="-1" name=""   text="女性私处的肉褶被摩擦，被搅动，发出咕啾咕啾的淫靡声音……回荡在周围。" voices=""/><msg @l="270" char_id="0" frame_id="-1" name="美帆"   text="『啊……啊啊………不，不行啊………。』" voices="miho07740"/><msg @l="272" char_id="-1" frame_id="-1" name="" text="头脑深处麻痹了，意识像是要飞离一般。"   voices=""/><msg @l="273" char_id="-1" frame_id="-1" name=""   text="仿佛被施了催眠术一样，理性随着蜜汁一起融化流淌。" voices=""/><msg @l="274" char_id="-1" frame_id="-1" name=""   text="就在两根手指深深插入已经湿漉漉的蜜壶根部的那一刻……" voices=""/><msg @l="276" char_id="0" frame_id="-1" name="美帆" text="『嗯，啊啊啊啊！！』"   voices="miho07750"/><flash @l="279" count="4" fade="100" image="white"/><wait_chgmv/><ev @l="282" src="ev-005bx3y5z2"/><msg @l="284" char_id="-1" frame_id="-1" name=""   text="一种强烈的高潮如同闪回般……袭击了我的身体。" voices=""/><msg @l="285" char_id="-1" frame_id="-1" name=""   text="随之从我因甜美快感而颤抖的私处喷涌出大量蜜液，一直流到了大腿上。" voices=""/><msg @l="287" char_id="-1" frame_id="-1" name="痴汉"   text="『真厉害啊……被痴汉弄到高潮了啊。』" voices=""/><msg @l="289" char_id="0" frame_id="-1" name="美帆" text="『诶……。』"   voices="miho07760"/><msg @l="291" char_id="-1" frame_id="-1" name=""   text="突然耳边传来一个不熟悉的声音，我惊讶地回头看去。" voices=""/><msg @l="292" char_id="-1" frame_id="-1" name=""   text="……而那里站着的不是朽木教授，而是一个陌生男子。" voices=""/><msg @l="293" char_id="-1" frame_id="-1" name=""   text="他用下流的笑容瞥了我一眼，然后向我炫耀他指尖上黏稠拉丝的蜜液。" voices=""/><msg @l="295" char_id="-1" frame_id="-1" name="痴汉"   text="『嘿嘿，你比我想象的还要淫荡嘛。』" voices=""/><msg @l="297" char_id="0" frame_id="-1" name="美帆" text="『那种、事……。』"   voices="miho07770"/><msg @l="299" char_id="-1" frame_id="-1" name="痴汉"   text="『都湿成这样拉丝了，现在说什么都晚了。』" voices=""/><msg @l="301" char_id="0" frame_id="-1" name="美帆" text="『………。』"   voices="miho07780"/><msg @l="303" char_id="-1" frame_id="-1" name=""   text="我试图朝墙边挪动一步，想要逃离他的言语。" voices=""/><msg @l="304" char_id="-1" frame_id="-1" name=""   text="对方不是朽木教授的话，逃跑应该没问题……我这样想着。" voices=""/><msg @l="305" char_id="-1" frame_id="-1" name=""   text="但就在那一瞬间……几双手缠上了我的身体，阻止了我的行动。" voices=""/><msg @l="307" char_id="0" frame_id="-1" name="美帆" text="『诶……！？』"   voices="miho07790"/><wait_chgmv/><ev @l="310" src="ev-005bx3y5z2"/><msg @l="312" char_id="0" frame_id="-1" name="美帆" text="（不会吧……这是什么……）"   voices="miho07800"/><msg @l="314" char_id="-1" frame_id="-1" name=""   text="不仅是身后男人的手，从四面八方伸过来的手开始玩弄我的胸部、腰部、胯下、腿部和臀部。" voices=""/><msg @l="316" char_id="-1" frame_id="-1" name="痴汉"   text="『大家都在看着你高潮的样子而兴奋呢。』" voices=""/><msg @l="318" char_id="-1" frame_id="-1" name="痴汉"   text="『看看吧……有人甚至把手伸进裤子里，在那撸着呢？』" voices=""/><msg @l="319" char_id="0" frame_id="-1" name="美帆" text="『………。』"   voices="miho07810"/><msg @l="321" char_id="-1" frame_id="-1" name=""   text="我不由自主地朝他所说的方向看去……确实有人把手放在裤子口袋里，在胯部附近蠕动着。" voices=""/><msg @l="323" char_id="0" frame_id="-1" name="美帆"   text="（不、不会吧……在这种地方……？）" voices="miho07820"/><msg @l="325" char_id="-1" frame_id="-1" name="痴汉"   text="说实话，我也已经硬邦邦的了。来摸摸看。" voices=""/><msg @l="327" char_id="0" frame_id="-1" name="美帆" text="『不、不要……。』"   voices="miho07830"/><msg @l="329" char_id="-1" frame_id="-1" name="痴汉"   text="『什么嘛，自己爽完就满足了吗。』" voices=""/><msg @l="331" char_id="0" frame_id="-1" name="美帆" text="『不、不是那样的……。』"   voices="miho07840"/><stopbgm @l="334" fadeout="1000"/><clear @l="337" class="all"/><msg @l="339" char_id="-1" frame_id="-1" name="广播"   text="『下一站是终点……大学前站，大学前站。』" voices=""/><msg @l="341" char_id="-1" frame_id="-1" name="广播"   text="『请注意检查您的随身物品，不要遗漏。』" voices=""/><msg @l="343" char_id="-1" frame_id="-1" name=""   text="熟悉的列车广播声在车厢内响起。" voices=""/><msg @l="344" char_id="-1" frame_id="-1" name=""   text="随着广播声，车厢内变得嘈杂起来，伸向我身体的那些手也纷纷收了回去。" voices=""/><msg @l="346" char_id="-1" frame_id="-1" name="痴汉" text="『啧……再过一会儿就好了。』"   voices=""/><msg @l="348" char_id="-1" frame_id="-1" name=""   text="我身后的那个人也不满地咂了咂舌，匆忙离开了原地。" voices=""/><msg @l="350" char_id="0" frame_id="-1" name="美帆" text="（得、得救了……）"   voices="miho07850"/><msg @l="352" char_id="-1" frame_id="-1" name=""   text="我松了一口气，赶紧整理被卷起的衣服。" voices=""/><msg @l="353" char_id="-1" frame_id="-1" name=""   text="直到电车到站，我都一直能感受到多道黏腻的视线。" voices=""/><stopse @l="356" buf="3"/><clear @l="359" class="all"/><end_scene @l="362"/><msgshow @l="365" show="true"/><wait_chgmv/><bg @l="368" src="bg09"/><bgm @l="371" src="bgm03" volume="1."/><char @l="374" id="miho" pos="auto" src="miho115"/><description @l="377" text="契約の日々・１日目"/><eval @l="379" expr="f.numDay=5&#13;&#10;"/><msg @l="381" char_id="0" frame_id="-1" name="美帆" text="『………。』" voices=""/><msg @l="383" char_id="-1" frame_id="-1" name=""   text="刚刚结束今天的讲座，我正快步走向车站。" voices=""/><msg @l="385" char_id="0" frame_id="-1" name="美帆"   text="（裙子里面凉飕飕的……）" voices=""/><msg @l="387" char_id="0" frame_id="-1" name="美帆"   text="（果然应该在哪买一条备用内裤的）" voices=""/><msg @l="389" char_id="-1" frame_id="-1" name=""   text="是啊……从家里穿来的内裤因为在电车上被弄湿了，所以我在站内的厕所脱下来扔掉了。" voices=""/><msg @l="390" char_id="-1" frame_id="-1" name=""   text="虽然也想过没必要扔掉，但是那种状态也不能直接放进包里……经过一番纠结后最终还是选择扔掉了。"   voices=""/><msg @l="392" char_id="0" frame_id="-1" name="美帆"   text="（那个……明明是我很喜欢的……真是太糟糕了……）" voices=""/><msg @l="394" char_id="-1" frame_id="-1" name=""   text="就在我一边想着这些事一边匆忙赶路时，在走廊尽头发现了现在最不想遇到的那个人。" voices=""/><clear @l="397" class="char"/><char @l="399" id="miho" pos="left" src="miho015"/><char @l="401" id="kutsu" pos="right" src="kutsu010"/><msg @l="403" char_id="-1" frame_id="-1" name="朽木" text="『哎呀，这不是仲根同学吗。』"   voices=""/><msg @l="405" char_id="0" frame_id="-1" name="美帆" text="『朽木……教授……』"   voices=""/><msg @l="407" char_id="-1" frame_id="-1" name="朽木"   text="『怎么了，看起来精神不太好啊？』" voices=""/><char @l="410" id="miho" pos="left" src="miho115"/><msg @l="412" char_id="0" frame_id="-1" name="美帆"   text="『这、这样吗？我一直都是这个样子的啊。』" voices=""/><char @l="415" id="kutsu" pos="right" src="kutsu018"/><msg @l="417" char_id="-1" frame_id="-1" name="朽木" text="『哦，和平常一样吗……。』"   voices=""/><msg @l="419" char_id="-1" frame_id="-1" name=""   text="教授这样说着，嘴角微微上扬。" voices=""/><msg @l="420" char_id="-1" frame_id="-1" name=""   text="就像是……在暗示他知道些什么一样。" voices=""/><msg @l="422" char_id="0" frame_id="-1" name="美帆" text="『那、那么……我就先……。』"   voices=""/><clear @l="425" layer="miho"/><msg @l="427" char_id="-1" frame_id="-1" name="朽木" text="『啊，让我问你一件事……。』"   voices=""/><char @l="430" id="miho" pos="left" src="miho015"/><msg @l="432" char_id="0" frame_id="-1" name="美帆" text="『什、什么事……？』"   voices=""/><msg @l="434" char_id="-1" frame_id="-1" name="朽木"   text="『被陌生男人玩弄到高潮这种事，对你来说是家常便饭吗？』" voices=""/><bgm @l="436" src="bgm15" volume="1."/><char @l="439" id="miho" pos="left" src="miho114"/><msg @l="441" char_id="0" frame_id="-1" name="美帆" text="『……！！』" voices=""/><char @l="444" id="miho" pos="left" src="miho115"/><msg @l="446" char_id="0" frame_id="-1" name="美帆"   text="『难道说……，教授就是那些人中的……。』" voices=""/><char @l="449" id="kutsu" pos="right" src="kutsu010"/><msg @l="451" char_id="-1" frame_id="-1" name="朽木"   text="『因为你拒绝成为我的人，我想可能你更喜欢被各种男人蹂躏，所以就帮你安排了这一切。』"   voices=""/><msg @l="453" char_id="0" frame_id="-1" name="美帆" text="『怎么会……。』" voices=""/><msg @l="455" char_id="-1" frame_id="-1" name="朽木"   text="『他们都是惯犯色狼呢。你应该也玩得很尽兴吧？』" voices=""/><msg @l="457" char_id="0" frame_id="-1" name="美帆" text="『我、我才没有尽兴……。』"   voices=""/><clear @l="460" layer="kutsu"/><char @l="462" id="kutsu" pos="auto" src="kutsu010"/><msg @l="464" char_id="-1" frame_id="-1" name="朽木"   text="『哦，难道是说还是喜欢我的手指更好吗？』" voices=""/><msg @l="466" char_id="0" frame_id="-1" name="美帆" text="『才、才不是那个意思……。』"   voices=""/><msg @l="468" char_id="-1" frame_id="-1" name="朽木" text="『呵呵，撒谎可不好啊。』"   voices=""/><msg @l="470" char_id="0" frame_id="-1" name="美帆" text="『啊……啊啊！？』"   voices=""/><clear @l="473" class="char"/><char @l="476" id="miho" pos="center" src="miho114f" y="-80"/><msg @l="478" char_id="-1" frame_id="-1" name=""   text="突然间，教授的手臂伸向我的腰，强行将我拉近。" voices=""/><msg @l="480" char_id="0" frame_id="-1" name="美帆" text="『你、你要做什么……。』"   voices=""/><msg @l="482" char_id="-1" frame_id="-1" name="朽木"   text="『那我来确认一下吧。看看你的身体到底更渴望谁的手指。』" voices=""/><msg @l="484" char_id="-1" frame_id="-1" name=""   text="说着，教授将手指滑入我的裙子里。" voices=""/><msg @l="485" char_id="-1" frame_id="-1" name=""   text="糟糕的是我没有穿内裤……他的手指直接探向那个部位。" voices=""/><char @l="488" id="miho" pos="center" src="miho015f" y="-80"/><msg @l="490" char_id="0" frame_id="-1" name="美帆" text="『诶……啊，不行！』"   voices=""/><begin_trans @l="493" time="500"/><layer @l="494" id="cutin_f" src="game_window_cutin" x="20" y="20" z="-1001"/><layer @l="495" id="cutin" src="cut003a" x="32" y="32" z="-1000"/><end_trans @l="496"/><msg @l="498" char_id="-1" frame_id="-1" name="" text="咕啾。" voices=""/><msg @l="500" char_id="-1" frame_id="-1" name="朽木"   text="『哦呀？这是怎么回事呢？』" voices=""/><msg @l="502" char_id="0" frame_id="-1" name="美帆" text="『……唔……。』" voices=""/><msg @l="504" char_id="-1" frame_id="-1" name=""   text="教授发现本应覆盖在那里的内裤不见了，发出了愉悦的声音。" voices=""/><msg @l="506" char_id="0" frame_id="-1" name="美帆" text="『这、这个是……。』"   voices=""/><msg @l="508" char_id="-1" frame_id="-1" name="朽木"   text="『原来如此，是因为湿得太厉害所以不能穿内裤了……是这样吧。』" voices=""/><msg @l="510" char_id="0" frame_id="-1" name="美帆" text="『呜啊……请、请不要说出来。』"   voices=""/><msg @l="512" char_id="-1" frame_id="-1" name="朽木"   text="『被陌生男人猥亵就能有感觉，真是个了不起的变态啊。』" voices=""/><msg @l="514" char_id="-1" frame_id="-1" name="" text="咕啾，咕唧。" voices=""/><msg @l="515" char_id="-1" frame_id="-1" name=""   text="朽木一边这么说着，一边将手指插入私处搅动着我的体内。" voices=""/><msg @l="517" char_id="0" frame_id="-1" name="美帆" text="『呜呜………。』" voices=""/><msg @l="519" char_id="-1" frame_id="-1" name="朽木"   text="『那么，弄湿的内裤你是怎么处理的？嗯？』" voices=""/><msg @l="521" char_id="0" frame_id="-1" name="美帆" text="『扔……扔掉了。』"   voices=""/><msg @l="523" char_id="-1" frame_id="-1" name="朽木"   text="『真是浪费啊。明明有那么多男人愿意花钱购买你的内裤。』" voices=""/><msg @l="525" char_id="0" frame_id="-1" name="美帆"   text="『与、与其卖给那种人……还不如扔掉更好。』" voices=""/><msg @l="527" char_id="-1" frame_id="-1" name="朽木"   text="『哼，是说至少内心还保持纯洁，是这个意思吗。』" voices=""/><msg @l="529" char_id="-1" frame_id="-1" name="朽木"   text="『算了，无所谓。总之先让你听从我的命令吧。』" voices=""/><msg @l="531" char_id="0" frame_id="-1" name="美帆" text="『命、命令……吗。』"   voices=""/><msg @l="533" char_id="-1" frame_id="-1" name="朽木"   text="『没错。下周一，你应该是从第一节课开始有课吧？』" voices=""/><msg @l="535" char_id="0" frame_id="-1" name="美帆" text="『是……是的。』"   voices=""/><msg @l="537" char_id="-1" frame_id="-1" name="朽木"   text="『那天你不准穿内裤就出门。』" voices=""/><msg @l="539" char_id="0" frame_id="-1" name="美帆" text="『诶……！？』" voices=""/><msg @l="541" char_id="-1" frame_id="-1" name="朽木" text="『很简单的事情吧？』"   voices=""/><msg @l="543" char_id="0" frame_id="-1" name="美帆" text="『………。』" voices=""/><msg @l="545" char_id="-1" frame_id="-1" name="朽木"   text="『如果不遵守的话……你明白的吧？』" voices=""/><msg @l="547" char_id="0" frame_id="-1" name="美帆" text="『……是……………是。』"   voices=""/><msg @l="549" char_id="-1" frame_id="-1" name="朽木" text="『那么……我很期待哦。』"   voices=""/><begin_trans @l="552" time="500"/><clear @l="553" layer="cutin_f"/><clear @l="554" layer="cutin"/><end_trans @l="555"/><clear @l="557" class="char"/><char @l="560" id="miho" pos="auto" src="miho115"/><msg @l="562" char_id="-1" frame_id="-1" name=""   text="说完，教授从裙子里抽出手……转身离开。" voices=""/><msg @l="563" char_id="-1" frame_id="-1" name=""   text="我含着悔恨的泪水，怒视着他离去的背影。" voices=""/><stopbgm @l="566" fadeout="1000"/><clear @l="569" class="all"/><call @l="572" target="EventLabel_122@root_kutuki03c"/><return @l="573" value="0&#13;&#10;"/></code></xscript>																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																					