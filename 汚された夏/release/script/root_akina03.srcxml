<?xml version="1.0" encoding="utf-8"?><xscript><debug editor="&quot;C:\Program&#32;Files&#32;(x86)\sakura\sakura.exe&quot;&#32;&quot;%src%&quot;&#32;-Y=%line%"   src="D:\シロップ\町ぐるみの罠＋汚された夏セット版\汚された夏\完成データ\汚された夏\script\text\root_akina03.txt"/><code><label @l="13" id="EventLabel_61"/><description @l="16" text="游泳教练·第3天"/><eval @l="18" expr="f.numDay=10&#13;&#10;"/><msgshow @l="20" show="false"/><wait_chgmv/><bg @l="22" src="day10" time="2000"/><wait @l="24" time="500"/><wait_chgmv/><bg @l="26" src="black" time="2000"/><msgshow @l="28" show="true"/><wait_chgmv/><bg @l="31" src="bg08m1"/><bgm @l="34" src="bgm03" volume="1."/><msg @l="36" char_id="-1" frame_id="-1" name="" text="下午的必修课……。" voices=""/><msg @l="37" char_id="-1" frame_id="-1" name=""   text="讲台上的讲师手拿教科书正在授课。" voices=""/><msg @l="39" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="41" char_id="-1" frame_id="-1" name=""   text="我皱着眉头，身体的疼痛并非来自肌肉酸痛……我一边忍受着这痛楚一边听着课。" voices=""/><msg @l="42" char_id="-1" frame_id="-1" name=""   text="我可以选择放弃，怨天尤人，想着为什么偏偏是我……" voices=""/><msg @l="43" char_id="-1" frame_id="-1" name=""   text="但我也明白，仅仅这样做并不能解决任何问题。" voices=""/><msg @l="45" char_id="0" frame_id="-1" name="美帆" text="（这样下去就跟三年前一样……）"   voices=""/><msg @l="47" char_id="0" frame_id="-1" name="美帆"   text="（人生被毁灭……支离破碎，然后）" voices=""/><msg @l="49" char_id="0" frame_id="-1" name="美帆" text="（不只是我……亚季奈也……）"   voices=""/><msg @l="51" char_id="-1" frame_id="-1" name=""   text="为什么渡部老师能够重返有亚季奈在的游泳部，我不得而知。" voices=""/><msg @l="52" char_id="-1" frame_id="-1" name="" text="是有什么隐秘交易吗……。"   voices=""/><msg @l="53" char_id="-1" frame_id="-1" name=""   text="还是说……那个事件本身被当做从未发生过……。" voices=""/><msg @l="54" char_id="-1" frame_id="-1" name=""   text="无论如何，渡部老师已重返岗位是不争的事实。" voices=""/><msg @l="56" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="58" char_id="0" frame_id="-1" name="美帆"   text="（我必须保护亚季奈……无论发生什么………）" voices=""/><stopbgm @l="61" fadeout="1000"/><clear @l="64" class="all"/><wait_chgmv/><bg @l="67" src="bg07"/><bgm @l="70" src="bgm03" volume="1."/><char @l="73" id="miho" pos="auto" src="miho115"/><msg @l="75" char_id="-1" frame_id="-1" name=""   text="结束讲座后，我一个人漫无目的地在校园里走着。" voices=""/><msg @l="76" char_id="-1" frame_id="-1" name=""   text="就这样直接前往泳池让我有些犹豫。" voices=""/><msg @l="77" char_id="-1" frame_id="-1" name="" text="但是，如果逃避的话……亚季奈就危险了。"   voices=""/><msg @l="78" char_id="-1" frame_id="-1" name="" text="在这样的矛盾中，我拖着沉重的脚步慢慢走着。"   voices=""/><char @l="81" id="miho" pos="auto" src="miho114"/><msg @l="83" char_id="0" frame_id="-1" name="美帆" text="『啊……。』" voices=""/><char @l="86" id="nanak" pos="auto" src="nanako019"/><bgm @l="89" src="bgm11" volume="1."/><msg @l="91" char_id="-1" frame_id="-1" name=""   text="她坐在校园一角的长椅上。" voices=""/><msg @l="92" char_id="-1" frame_id="-1" name=""   text="那个浅色双马尾的女孩……奈那子。" voices=""/><msg @l="93" char_id="-1" frame_id="-1" name=""   text="一个人坐在长椅上，没做什么特别的事，只是茫然地……望着天空。" voices=""/><msg @l="95" char_id="0" frame_id="-1" name="美帆" text="『………。』" voices=""/><char @l="98" id="nanak" pos="auto" src="nanako011"/><msg @l="100" char_id="3" frame_id="-1" name="奈那子" text="『啊，是美帆。』" voices=""/><msg @l="102" char_id="-1" frame_id="-1" name=""   text="正当我犹豫要不要打招呼时，奈那子先注意到了我，抬起头来。" voices=""/><msg @l="104" char_id="0" frame_id="-1" name="美帆" text="『你、你好。』"   voices=""/><msg @l="106" char_id="0" frame_id="-1" name="美帆" text="『你在……做什么？』"   voices=""/><char @l="109" id="nanak" pos="auto" src="nanako012"/><msg @l="111" char_id="3" frame_id="-1" name="奈那子" text="『午睡。』" voices=""/><msg @l="113" char_id="0" frame_id="-1" name="美帆" text="『在这种地方……？』"   voices=""/><char @l="116" id="nanak" pos="auto" src="nanako011"/><msg @l="118" char_id="3" frame_id="-1" name="奈那子" text="『嗯。』" voices=""/><msg @l="120" char_id="0" frame_id="-1" name="美帆" text="『不热吗？』" voices=""/><char @l="123" id="nanak" pos="auto" src="nanako012"/><msg @l="125" char_id="3" frame_id="-1" name="奈那子"   text="『这里在树荫下很凉快哦……而且今天还有风。』" voices=""/><msg @l="127" char_id="-1" frame_id="-1" name=""   text="奈那子舒服地闭上了眼睛。" voices=""/><msg @l="128" char_id="-1" frame_id="-1" name=""   text="确实，阳光被遮挡住了，偶尔吹来的风也恰到好处地温柔。" voices=""/><msg @l="130" char_id="0" frame_id="-1" name="美帆" text="『………。』" voices=""/><msg @l="132" char_id="0" frame_id="-1" name="美帆" text="『旁边……可以吗？』" voices=""/><char @l="135" id="nanak" pos="auto" src="nanako019"/><msg @l="137" char_id="3" frame_id="-1" name="奈那子" text="『………。』" voices=""/><msg @l="139" char_id="-1" frame_id="-1" name=""   text="奈那子带着疑惑的表情看着自己旁边的位置。" voices=""/><char @l="142" id="nanak" pos="auto" src="nanako012"/><msg @l="144" char_id="3" frame_id="-1" name="奈那子" text="『不用问我，这里不是空着吗？』"   voices=""/><msg @l="146" char_id="0" frame_id="-1" name="美帆" text="『啊，啊哈哈……是啊。』"   voices=""/><msg @l="148" char_id="0" frame_id="-1" name="美帆"   text="（我问的不是这个意思啊……）" voices=""/><clear @l="151" class="char"/><char @l="153" id="nanak" pos="left" src="nanako010"/><char @l="155" id="miho" pos="right" src="miho110"/><msg @l="157" char_id="-1" frame_id="-1" name=""   text="带着一点……不，是相当大的误会感觉，我在长椅上坐了下来。" voices=""/><char @l="160" id="miho" pos="right" src="miho011"/><msg @l="162" char_id="0" frame_id="-1" name="美帆" text="『嗯——……风，真舒服啊……。』"   voices=""/><msg @l="164" char_id="-1" frame_id="-1" name=""   text="我十指交叉轻轻伸了个懒腰……小声嘀咕着。" voices=""/><msg @l="165" char_id="-1" frame_id="-1" name=""   text="风吹得很舒服，让人几乎忘记了连日来的闷热。" voices=""/><msg @l="167" char_id="3" frame_id="-1" name="奈那子" text="『………。』" voices=""/><msg @l="169" char_id="3" frame_id="-1" name="奈那子" text="『昨天啊……被哥哥大人骂了。』"   voices=""/><char @l="172" id="miho" pos="right" src="miho014"/><msg @l="174" char_id="0" frame_id="-1" name="美帆" text="『诶？』" voices=""/><msg @l="176" char_id="3" frame_id="-1" name="奈那子"   text="『为什么奈那子，这么执着于美帆……这样说。』" voices=""/><char @l="179" id="miho" pos="right" src="miho114"/><msg @l="181" char_id="0" frame_id="-1" name="美帆" text="『啊……』" voices=""/><msg @l="183" char_id="-1" frame_id="-1" name=""   text="昨天，渡部老师救了差点被袭击的我的时候……" voices=""/><msg @l="184" char_id="-1" frame_id="-1" name=""   text="好像说过“奈那子无论如何……”之类的……话。" voices=""/><char @l="187" id="nanak" pos="left" src="nanako017"/><msg @l="189" char_id="3" frame_id="-1" name="奈那子"   text="『我……因为哥哥大人的缘故，经常反复转学，所以不能交朋友。』" voices=""/><msg @l="191" char_id="3" frame_id="-1" name="奈那子"   text="『因为分别会很伤心……所以不行。』" voices=""/><char @l="194" id="miho" pos="right" src="miho116"/><msg @l="196" char_id="0" frame_id="-1" name="美帆" text="『是……这样啊。』"   voices=""/><char @l="199" id="nanak" pos="left" src="nanako011"/><msg @l="201" char_id="3" frame_id="-1" name="奈那子"   text="『但是，我想和美帆成为朋友……』" voices=""/><char @l="204" id="nanak" pos="left" src="nanako019"/><msg @l="206" char_id="3" frame_id="-1" name="奈那子"   text="『美帆……总感觉，不能放着不管。』" voices=""/><msg @l="208" char_id="-1" frame_id="-1" name=""   text="听到奈那子的话，我鼓起腮帮子以示抗议。" voices=""/><char @l="211" id="miho" pos="right" src="miho016"/><msg @l="213" char_id="0" frame_id="-1" name="美帆"   text="『……这是说，我很不可靠的意思吗……？』" voices=""/><char @l="216" id="nanak" pos="left" src="nanako012"/><msg @l="218" char_id="3" frame_id="-1" name="奈那子" text="『嗯。』" voices=""/><char @l="221" id="miho" pos="right" src="miho015"/><msg @l="223" char_id="0" frame_id="-1" name="美帆" text="『呃啊……』" voices=""/><msg @l="225" char_id="-1" frame_id="-1" name=""   text="被她笑着如此肯定，我一时语塞。" voices=""/><char @l="228" id="nanak" pos="left" src="nanako018"/><msg @l="230" char_id="3" frame_id="-1" name="奈那子"   text="『我，以后也可以和美帆说话吗？』" voices=""/><char @l="233" id="miho" pos="right" src="miho014"/><msg @l="235" char_id="3" frame_id="-1" name="奈那子"   text="『虽然哥哥大人会生气……但是，我想和美帆做朋友。』" voices=""/><char @l="238" id="nanak" pos="left" src="nanako019"/><msg @l="240" char_id="3" frame_id="-1" name="奈那子" text="『……可以吗？』" voices=""/><char @l="243" id="miho" pos="right" src="miho110"/><msg @l="245" char_id="0" frame_id="-1" name="美帆" text="『你哥哥，没关系吗……？』"   voices=""/><char @l="248" id="nanak" pos="left" src="nanako011"/><msg @l="250" char_id="3" frame_id="-1" name="奈那子" text="『嗯……』" voices=""/><msg @l="252" char_id="3" frame_id="-1" name="奈那子"   text="『我想哥哥大人其实也明白的……』" voices=""/><char @l="255" id="nanak" pos="left" src="nanako010"/><msg @l="257" char_id="3" frame_id="-1" name="奈那子"   text="『因为我想他也明白，一个人是很痛苦的。』" voices=""/><char @l="260" id="miho" pos="right" src="miho116"/><msg @l="262" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="264" char_id="-1" frame_id="-1" name="" text="一个人很痛苦……" voices=""/><msg @l="265" char_id="-1" frame_id="-1" name="" text="谁都会觉得孤身一人很痛苦。"   voices=""/><msg @l="266" char_id="-1" frame_id="-1" name=""   text="所以才会交朋友，向往恋人，守护家人……我想大概就是这样吧。" voices=""/><char @l="269" id="nanak" pos="left" src="nanako018"/><msg @l="271" char_id="3" frame_id="-1" name="奈那子"   text="『所以……美帆，可以做朋友吗？』" voices=""/><char @l="274" id="miho" pos="right" src="miho111"/><msg @l="276" char_id="0" frame_id="-1" name="美帆" text="『嗯，以后请多关照！』"   voices=""/><char @l="279" id="nanak" pos="left" src="nanako011"/><msg @l="281" char_id="3" frame_id="-1" name="奈那子" text="『嗯，太好了。』"   voices=""/><msg @l="283" char_id="-1" frame_id="-1" name="" text="说着，奈那子露出了灿烂的笑容。"   voices=""/><char @l="286" id="nanak" pos="left" src="nanako014"/><msg @l="288" char_id="3" frame_id="-1" name="奈那子" text="『啊……哥哥大人。』" voices=""/><char @l="291" id="miho" pos="right" src="miho114"/><msg @l="293" char_id="0" frame_id="-1" name="美帆" text="『啊……。』" voices=""/><msg @l="295" char_id="-1" frame_id="-1" name=""   text="顺着奈那子的视线望去，果然在校园的一角看到了……哥哥。" voices=""/><char @l="298" id="nanak" pos="left" src="nanako012"/><msg @l="300" char_id="3" frame_id="-1" name="奈那子" text="『……我，得过去了。』"   voices=""/><char @l="303" id="miho" pos="right" src="miho016"/><msg @l="305" char_id="0" frame_id="-1" name="美帆" text="『嗯，嗯。』" voices=""/><clear @l="308" class="char"/><char @l="310" id="miho" pos="auto" src="miho110"/><msg @l="312" char_id="-1" frame_id="-1" name=""   text="说完，奈那子慌忙从长椅上站起身，小跑着朝哥哥那边奔去。" voices=""/><stopbgm @l="315" fadeout="1000"/><bgm @l="318" src="bgm02" volume="1."/><char @l="321" id="miho" pos="auto" src="miho010"/><msg @l="323" char_id="-1" frame_id="-1" name="" text="………………………"   voices=""/><msg @l="324" char_id="-1" frame_id="-1" name="" text="……………" voices=""/><msg @l="325" char_id="-1" frame_id="-1" name="" text="……" voices=""/><msg @l="327" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="329" char_id="0" frame_id="-1" name="美帆" text="『我也……该走了。』"   voices=""/><char @l="332" id="miho" pos="auto" src="miho110"/><msg @l="334" char_id="-1" frame_id="-1" name="" text="我也有喜欢的人。"   voices=""/><msg @l="335" char_id="-1" frame_id="-1" name="" text="因为想要……保护那个人。"   voices=""/><msg @l="337" char_id="0" frame_id="-1" name="美帆" text="（亚季奈……我，会加油的）"   voices=""/><msg @l="339" char_id="0" frame_id="-1" name="美帆" text="（所以……）" voices=""/><stopbgm @l="342" fadeout="1000"/><clear @l="345" class="all"/><msgshow @l="347" show="true"/><wait_chgmv/><bg @l="350" src="bg11"/><char @l="352" id="miho" pos="auto" src="miho015"/><msg @l="354" char_id="0" frame_id="-1" name="美帆" text="『这是什么啊……。』" voices=""/><bgm @l="357" src="bgm15" volume="1."/><msg @l="359" char_id="-1" frame_id="-1" name="" text="我本想要努力。" voices=""/><msg @l="360" char_id="-1" frame_id="-1" name=""   text="为了亚季奈，就算被捉弄一点也要忍耐。" voices=""/><msg @l="361" char_id="-1" frame_id="-1" name=""   text="但是……怎么会变成这样子。" voices=""/><clear @l="364" class="all"/><msg @l="366" char_id="-1" frame_id="-1" name=""   text="『关于昨天的事情有话要说训练后在这里见面』" voices=""/><msg @l="367" char_id="-1" frame_id="-1" name=""   text="合宿开始后，我一直在使用的储物柜里，放着一张被折成四折的纸。" voices=""/><msg @l="368" char_id="-1" frame_id="-1" name=""   text="然后，写在这张纸内侧的文字……就是这个。" voices=""/><clear @l="371" class="all"/><msgshow @l="373" show="true"/><wait_chgmv/><bg @l="376" src="bg11"/><char @l="379" id="miho" pos="auto" src="miho015"/><msg @l="381" char_id="0" frame_id="-1" name="美帆"   text="『关于昨天的事情有话要说……训练后，在这里见面吧。』" voices=""/><msg @l="383" char_id="-1" frame_id="-1" name="" text="我把纸上写的内容读了出来。"   voices=""/><msg @l="384" char_id="-1" frame_id="-1" name=""   text="因为全部都是片假名所以没有实感，但是……这明显是一封恐吓信。" voices=""/><msg @l="385" char_id="-1" frame_id="-1" name=""   text="字体全都像是用左手写的那样歪歪扭扭，勉强能读懂……就是这种感觉。" voices=""/><msg @l="386" char_id="-1" frame_id="-1" name=""   text="如果这不是片假名的话，可能就读不懂了。" voices=""/><msg @l="390" char_id="0" frame_id="-1" name="美帆" text="（为什么会这样……）"   voices=""/><msg @l="392" char_id="0" frame_id="-1" name="美帆" text="（总是我……）"   voices=""/><msg @l="394" char_id="-1" frame_id="-1" name="" text="………………………"   voices=""/><msg @l="395" char_id="-1" frame_id="-1" name=""   text="…………………………………" voices=""/><char @l="398" id="akina" pos="auto" src="akina064"/><msg @l="400" char_id="2" frame_id="-1" name="亚季奈" text="『咦，姐姐……？』"   voices=""/><stopbgm @l="403" fadeout="1000"/><clear @l="406" class="char"/><char @l="408" id="akina" pos="right" src="akina060"/><char @l="410" id="miho" pos="left" src="miho014"/><msg @l="412" char_id="0" frame_id="-1" name="美帆" text="『……！』" voices=""/><msg @l="414" char_id="0" frame_id="-1" name="美帆" text="『啊，亚季奈……。』"   voices=""/><msg @l="416" char_id="-1" frame_id="-1" name=""   text="听到突如其来的声音，我慌忙把纸折好塞进了储物柜深处。" voices=""/><msg @l="417" char_id="-1" frame_id="-1" name="" text="不能让亚季奈看见……。"   voices=""/><bgm @l="420" src="bgm06" volume="1."/><char @l="422" id="akina" pos="right" src="akina161"/><msg @l="424" char_id="2" frame_id="-1" name="亚季奈"   text="『姐姐，你刚到吗？ 怎么这么晚？』" voices=""/><char @l="427" id="miho" pos="left" src="miho116"/><msg @l="429" char_id="0" frame_id="-1" name="美帆" text="『啊，嗯……。』" voices=""/><char @l="432" id="miho" pos="left" src="miho016"/><msg @l="434" char_id="0" frame_id="-1" name="美帆" text="『课程……拖长了一点。』"   voices=""/><msg @l="436" char_id="-1" frame_id="-1" name="" text="我撒了谎。" voices=""/><msg @l="437" char_id="-1" frame_id="-1" name=""   text="没什么大不了的，只是个小小的善意谎言……。" voices=""/><msg @l="438" char_id="-1" frame_id="-1" name="" text="……心好痛……。"   voices=""/><char @l="441" id="akina" pos="right" src="akina060"/><msg @l="443" char_id="2" frame_id="-1" name="亚季奈"   text="『大家都在等姐姐来呢。』" voices=""/><char @l="446" id="miho" pos="left" src="miho014"/><msg @l="448" char_id="0" frame_id="-1" name="美帆" text="『是、是吗……？』"   voices=""/><char @l="451" id="akina" pos="right" src="akina061"/><msg @l="453" char_id="2" frame_id="-1" name="亚季奈" text="『姐姐可是人气王哦～。』"   voices=""/><char @l="456" id="akina" pos="right" src="akina062"/><msg @l="458" char_id="2" frame_id="-1" name="亚季奈"   text="『教学方式很到位……泳装也很性感～对吧？』" voices=""/><char @l="461" id="miho" pos="left" src="miho016"/><msg @l="463" char_id="0" frame_id="-1" name="美帆" text="『亚季奈～！』" voices=""/><char @l="466" id="akina" pos="right" src="akina161"/><msg @l="468" char_id="2" frame_id="-1" name="亚季奈"   text="『诶嘿嘿～，那么，我只是来拿备用护目镜的。』" voices=""/><clear @l="471" layer="miho"/><char @l="474" id="miho" pos="left" src="miho010"/><msg @l="476" char_id="0" frame_id="-1" name="美帆"   text="『好好，我换完衣服马上就去。』" voices=""/><msg @l="478" char_id="2" frame_id="-1" name="亚季奈" text="『等你哦～。』"   voices=""/><clear @l="481" class="char"/><char @l="483" id="miho" pos="left" src="miho010"/><msg @l="485" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><char @l="488" id="miho" pos="left" src="miho116"/><msg @l="490" char_id="0" frame_id="-1" name="美帆" text="『快点换衣服吧……。』"   voices=""/><stopbgm @l="493" fadeout="1000"/><clear @l="497" class="all"/><label @l="500" id="event_scene36"/><wait_chgmv/><bg @l="503" src="bg10m1"/><bgm @l="506" src="bgm02" volume="1."/><char @l="509" id="miho" pos="auto" src="miho060"/><msg @l="511" char_id="0" frame_id="-1" name="美帆"   text="『很好，就是这样放松……。』" voices=""/><msg @l="513" char_id="0" frame_id="-1" name="美帆"   text="『好的……那么请跟着我拍手的节奏，计算呼吸的时机。』" voices=""/><char @l="516" id="miho" pos="auto" src="miho166"/><msg @l="518" char_id="-1" frame_id="-1" name="" text="……在进行着平常的训练。"   voices=""/><msg @l="519" char_id="-1" frame_id="-1" name=""   text="亚季奈所在的游泳部合宿开始的第三天。" voices=""/><msg @l="520" char_id="-1" frame_id="-1" name=""   text="今天又要开始那段屈辱的游泳时间了……我本来是这么想的。" voices=""/><msg @l="521" char_id="-1" frame_id="-1" name="" text="但今天却一直在进行着普通的训练。"   voices=""/><msg @l="522" char_id="-1" frame_id="-1" name=""   text="因为今天，顾问老师渡部没有来。" voices=""/><msg @l="524" char_id="0" frame_id="-1" name="美帆" text="（为什么……）" voices=""/><msg @l="526" char_id="0" frame_id="-1" name="美帆"   text="（明明在储物柜里放了那种信，为什么他却没来呢？）" voices=""/><msg @l="528" char_id="0" frame_id="-1" name="美帆"   text="（他到底……在谋划什么………？）" voices=""/><msg @l="530" char_id="0" frame_id="-1" name="美帆"   text="（亚季奈和游泳部的那些孩子，似乎都不知道渡部老师没来的原因……）" voices=""/><msg @l="532" char_id="-1" frame_id="-1" name=""   text="带着这样的想法，大概已经过去三个小时了吧。" voices=""/><msg @l="533" char_id="-1" frame_id="-1" name=""   text="一直在泳池边警惕着渡部老师可能的恶作剧，观察着游泳的姿势，但今天觉得应该没事，我进入了竞泳道旁边的泳道。"   voices=""/><label @l="536" id="chart_line12"/><wait_chgmv/><ev @l="539" src="ev-036"/><description @l="542" text="新的凶手"/><msg @l="544" char_id="0" frame_id="-1" name="美帆" text="（是我……想太多了吗）"   voices="miho03590"/><msg @l="546" char_id="0" frame_id="-1" name="美帆"   text="（那张纸条，也许只是恶作剧而已……）" voices="miho03600"/><msg @l="548" char_id="-1" frame_id="-1" name=""   text="如果只是恶作剧的话……内容未免也太过火了。" voices=""/><msg @l="550" char_id="0" frame_id="-1" name="美帆"   text="（不过，渡部老师不在的话，也没什么好害怕的了……）" voices="miho03610"/><msg @l="552" char_id="0" frame_id="-1" name="美帆"   text="（应该不会……像昨天那样躲在某处偷看吧）" voices="miho03620"/><msg @l="554" char_id="-1" frame_id="-1" name=""   text="环视四周，但没有看到可疑的身影。" voices=""/><msg @l="555" char_id="-1" frame_id="-1" name=""   text="映入眼帘的只有那个据说从昨天起加入大学社团的留学生……大概就这样了吧。" voices=""/><msg @l="556" char_id="-1" frame_id="-1" name="" text="虽然不知道他是哪个国家的人……"   voices=""/><msg @l="557" char_id="-1" frame_id="-1" name=""   text="皮肤略黑，异常开朗，看到女孩子就不顾一切地上前搭讪。" voices=""/><msg @l="559" char_id="0" frame_id="-1" name="美帆" text="（真不擅长应付……那种人）"   voices="miho03630"/><msg @l="561" char_id="0" frame_id="-1" name="美帆"   text="（咦……他好像，朝这边来了……）" voices="miho03640"/><msg @l="564" char_id="-1" frame_id="-1" name="留学生" text="『哦，你非常可爱。』"   voices=""/><msg @l="566" char_id="0" frame_id="-1" name="美帆" text="『啊，谢谢……』"   voices="miho03650"/><msg @l="568" char_id="-1" frame_id="-1" name="留学生"   text="『日本女孩，都很漂亮。』" voices=""/><msg @l="570" char_id="-1" frame_id="-1" name="留学生"   text="『我，非常喜欢，日本女性。』" voices=""/><msg @l="572" char_id="0" frame_id="-1" name="美帆"   text="『这、这样啊……那个……您的日语说得真好。』" voices="miho03660"/><msg @l="574" char_id="-1" frame_id="-1" name="留学生"   text="『谢谢！阿里嘎多、哥咋伊马斯！』" voices=""/><msg @l="576" char_id="-1" frame_id="-1" name="留学生"   text="『我、日语、很多很多、学习了哦。』" voices=""/><msg @l="578" char_id="0" frame_id="-1" name="美帆" text="『啊……』"   voices="miho03670"/><msg @l="580" char_id="-1" frame_id="-1" name="留学生"   text="『想和、你、交往呢。』" voices=""/><msg @l="582" char_id="0" frame_id="-1" name="美帆" text="『啊，这……等一下。』"   voices="miho03680"/><stopbgm @l="586" fadeout="1000"/><wait_chgmv/><ev @l="589" src="ev-036x2y1y2"/><bgm @l="592" src="bgm15" volume="1."/><msg @l="594" char_id="-1" frame_id="-1" name=""   text="那个留学生来到我身后，然后伸出双手朝我身体摸来。" voices=""/><msg @l="596" char_id="0" frame_id="-1" name="美帆" text="『呀……你干什么！？』"   voices="miho03690"/><msg @l="598" char_id="-1" frame_id="-1" name="留学生"   text="『哦耶，日本的，大和抚子。』" voices=""/><msg @l="600" char_id="0" frame_id="-1" name="美帆"   text="『这种事……不要，请住手……』" voices="miho03700"/><msg @l="602" char_id="-1" frame_id="-1" name="留学生"   text="『为～什～么？你、这个、最喜欢。』" voices=""/><msg @l="604" char_id="0" frame_id="-1" name="美帆" text="『诶……什么……？』"   voices="miho03710"/><msg @l="606" char_id="-1" frame_id="-1" name="留学生" text="『昨天的事、我看见了哦。』"   voices=""/><msg @l="608" char_id="0" frame_id="-1" name="美帆" text="『———————！？』"   voices="miho03720"/><msg @l="610" char_id="-1" frame_id="-1" name=""   text="昨天……我在这里忍受着渡部老师的恶作剧接受指导。" voices=""/><msg @l="611" char_id="-1" frame_id="-1" name="" text="那时候的情况……被看见了！？"   voices=""/><msg @l="613" char_id="0" frame_id="-1" name="美帆"   text="『难道……储物柜里的那张便条……！？』" voices="miho03730"/><msg @l="615" char_id="-1" frame_id="-1" name="留学生"   text="『耶～斯，就是这样。是我给你的、情书哦。』" voices=""/><msg @l="617" char_id="0" frame_id="-1" name="美帆" text="『情、情书是……』"   voices="miho03740"/><msg @l="619" char_id="-1" frame_id="-1" name="" text="这个人绝对是误解了意思。"   voices=""/><msg @l="621" char_id="0" frame_id="-1" name="美帆"   text="『啊，那种东西不是情书……嗯嗯。』" voices="miho03750"/><msg @l="623" char_id="-1" frame_id="-1" name=""   text="黑人留学生的手隔着泳衣抓住了胸部，一松一紧地不断揉捏着。" voices=""/><msg @l="624" char_id="-1" frame_id="-1" name=""   text="另一只手不知何时已经爬上了大腿，还没来得及阻止就伸向了那里。" voices=""/><msg @l="626" char_id="-1" frame_id="-1" name="留学生"   text="『你、喜欢、痴汉、游戏，痴汉、是、日本人、的、好、文化。』" voices=""/><msg @l="628" char_id="0" frame_id="-1" name="美帆"   text="『都说了，不是……嗯嗯……不要，不要啊。』" voices="miho03760"/><msg @l="630" char_id="-1" frame_id="-1" name="留学生"   text="『好——的，口、说、不、要，心、里、喜、欢，对、吧？』" voices=""/><msg @l="632" char_id="0" frame_id="-1" name="美帆"   text="（不行……这个人，虽然勉强能听懂日语，但完全不理解其中的意思啊……）" voices="miho03770"/><msg @l="634" char_id="0" frame_id="-1" name="美帆"   text="（怎么办……不想因为大惊小怪而被大家注目，但是……）" voices="miho03780"/><msg @l="638" async="true" char_id="-1" frame_id="-1" name=""   text="对于奇怪的留学生，我要……？" voices=""/><select @l="639"><menu @l="643" label="EventLabel_62" text="进行抵抗"/><menu @l="646" label="EventLabel_63" text="乖乖就范"/></select><label @l="654" id="EventLabel_62"/><msg @l="656" char_id="0" frame_id="-1" name="美帆"   text="『不要……求你了，请住手……。』" voices="miho03790"/><msg @l="658" char_id="-1" frame_id="-1" name="" text="我奋力尝试抵抗。"   voices=""/><msg @l="659" char_id="-1" frame_id="-1" name=""   text="如果语言无法让他理解，那只能用行动让他明白了。" voices=""/><msg @l="661" char_id="-1" frame_id="-1" name="留学生"   text="『很好！胸部好软啊。』" voices=""/><msg @l="663" char_id="0" frame_id="-1" name="美帆"   text="『够了……我不是说了不要吗！』" voices="miho03800"/><clear @l="666" class="all"/><se @l="669" buf="1" src="人とぶつかる音" volume="1."/><flash @l="671" count="4" fade="100" image="white"/><msg @l="673" char_id="-1" frame_id="-1" name="留学生" text="『啊痛！？』"   voices=""/><stopbgm @l="676" fadeout="1000"/><msg @l="678" char_id="-1" frame_id="-1" name=""   text="就在我用力挣脱的瞬间，我的头直接撞上了他的下巴。" voices=""/><msg @l="679" char_id="-1" frame_id="-1" name=""   text="然后……他就那样沉入了水中。" voices=""/><clear @l="682" class="all"/><wait_chgmv/><bg @l="685" src="bg10m1"/><bgm @l="688" src="bgm06" volume="1."/><char @l="691" id="miho" pos="auto" src="miho064"/><msg @l="693" char_id="0" frame_id="-1" name="美帆" text="『哇，哇哇……。』"   voices="miho03810"/><clear @l="696" class="char"/><char @l="698" id="miho" pos="left" src="miho065"/><char @l="700" id="akina" pos="right" src="akina160"/><char @l="703" id="akina" pos="right" src="akina164"/><msg @l="705" char_id="2" frame_id="-1" name="亚季奈"   text="『姐姐怎么了……咦，有人沉下去了！？』" voices="akina00170"/><msg @l="708" char_id="0" frame_id="-1" name="美帆"   text="『这、这个人突然缠上我……我反抗的时候……头不小心撞到他下巴……。』" voices="miho03820"/><msg @l="710" char_id="0" frame_id="-1" name="美帆" text="『怎、怎怎……怎么办啊～～。』"   voices="miho03830"/><clear @l="713" layer="akina"/><char @l="716" id="akina" pos="center" src="akina064f" y="-80"/><msg @l="718" char_id="2" frame_id="-1" name="亚季奈"   text="『什么怎么办，得赶快把他拖上来，不然会溺水的！』" voices="akina00180"/><msg @l="720" char_id="0" frame_id="-1" name="美帆" text="『嗯、嗯！』"   voices="miho03840"/><clear @l="723" class="all"/><end_scene @l="726"/><wait_chgmv/><bg @l="729" src="bg10m1"/><bgm @l="732" src="bgm02" volume="1."/><char @l="735" id="miho" pos="auto" src="miho160"/><description @l="738" text="游泳教练·第3天"/><msg @l="740" char_id="0" frame_id="-1" name="美帆" text="『……呼。』" voices=""/><msg @l="742" char_id="-1" frame_id="-1" name=""   text="一阵混乱告一段落后，我长舒了一口气。" voices=""/><msg @l="743" char_id="-1" frame_id="-1" name=""   text="那个黑人留学生在游泳部男生和大学社团成员的帮助下被送进了男更衣室。" voices=""/><msg @l="744" char_id="-1" frame_id="-1" name=""   text="因为我如实陈述了经过，所以也没有什么特别的问题。" voices=""/><msg @l="745" char_id="-1" frame_id="-1" name=""   text="当然，我完全没有提到昨天的事情和储物柜里的纸条，而是把情况说成他突然抱住了我。"   voices=""/><msg @l="746" char_id="-1" frame_id="-1" name=""   text="不管怎样，得到大学社团成员……特别是女性社团成员的赞赏，让我稍微感到了一些鼓舞。" voices=""/><msg @l="747" char_id="-1" frame_id="-1" name=""   text="……看来大家都对他的行为感到忍无可忍了。" voices=""/><clear @l="750" class="char"/><char @l="752" id="miho" pos="left" src="miho160"/><char @l="754" id="akina" pos="right" src="akina062"/><msg @l="756" char_id="2" frame_id="-1" name="亚季奈" text="『真是遭罪了呢，姐姐。』"   voices=""/><char @l="759" id="miho" pos="left" src="miho066"/><msg @l="761" char_id="0" frame_id="-1" name="美帆" text="『嗯……我感觉有点累了。』"   voices=""/><char @l="764" id="akina" pos="right" src="akina061"/><msg @l="766" char_id="2" frame_id="-1" name="亚季奈" text="『啊哈哈，辛苦了。』"   voices=""/><char @l="769" id="akina" pos="right" src="akina167"/><msg @l="771" char_id="2" frame_id="-1" name="亚季奈" text="『不过，有一件事我不太明白~。』"   voices=""/><char @l="774" id="miho" pos="left" src="miho164"/><msg @l="776" char_id="0" frame_id="-1" name="美帆" text="『什么事？』" voices=""/><msg @l="778" char_id="2" frame_id="-1" name="亚季奈"   text="『那个人被抬走之后一直在重复着“情书，情书”之类的胡话。』" voices=""/><char @l="781" id="akina" pos="right" src="akina162"/><msg @l="783" char_id="2" frame_id="-1" name="亚季奈"   text="『姐姐，难道你收到了那个人的情书？』" voices=""/><char @l="786" id="miho" pos="left" src="miho066"/><msg @l="788" char_id="0" frame_id="-1" name="美帆" text="『呃，不不不……我不知道。』"   voices=""/><char @l="791" id="akina" pos="right" src="akina061"/><msg @l="793" char_id="2" frame_id="-1" name="亚季奈" text="『是吧？』" voices=""/><char @l="796" id="miho" pos="left" src="miho166"/><msg @l="798" char_id="0" frame_id="-1" name="美帆"   text="（原来他真的以为那是情书啊……那个黑人留学生）" voices=""/><msg @l="800" char_id="-1" frame_id="-1" name=""   text="我带着苦笑，在心中深深地叹了口气。" voices=""/><eval @l="803" expr="f.留学生に抵抗したflag&#32;=&#32;1&#13;&#10;"/><goto @l="806" label="EventLabel_64"/><label @l="810" id="EventLabel_63"/><bgm @l="813" src="bgm14" volume="1."/><msg @l="815" char_id="0" frame_id="-1" name="美帆" text="『………。』"   voices="miho03850"/><msg @l="817" char_id="0" frame_id="-1" name="美帆"   text="（如果反抗的话，昨天的事情可能会被说出去，那就麻烦了……）" voices="miho03860"/><msg @l="819" char_id="0" frame_id="-1" name="美帆"   text="（如果保持沉默安静地等待……他应该会放弃的吧）" voices="miho03870"/><msg @l="821" char_id="-1" frame_id="-1" name=""   text="无奈之下……我决定任由那个黑人留学生摆布。" voices=""/><msg @l="822" char_id="-1" frame_id="-1" name=""   text="虽然我并不认为这样做是对的，但如果我反抗刺激到黑人留学生，让他说出什么奇怪的话，可能会引发严重的后果。"   voices=""/><msg @l="823" char_id="-1" frame_id="-1" name=""   text="所以，我决定等黑人留学生厌倦为止。" voices=""/><msg @l="825" char_id="-1" frame_id="-1" name="留学生" text="『噢耶！不错！』"   voices=""/><msg @l="827" char_id="-1" frame_id="-1" name=""   text="我无法反抗，只能忍受那只在我身体上爬行的手。" voices=""/><msg @l="828" char_id="-1" frame_id="-1" name=""   text="年轻富有弹性的乳房隔着泳衣被那黑色的手蹂躏着。" voices=""/><msg @l="830" char_id="0" frame_id="-1" name="美帆" text="『……！？』"   voices="miho09970"/><msg @l="832" char_id="-1" frame_id="-1" name="留学生" text="『做得好，做得好！』"   voices=""/><msg @l="834" char_id="-1" frame_id="-1" name="" text="然后那黑色的手开始攻击白色山峰的顶端。"   voices=""/><msg @l="835" char_id="-1" frame_id="-1" name=""   text="揉捏着栖息在山顶的野莓。" voices=""/><msg @l="837" char_id="0" frame_id="-1" name="美帆" text="『………。』"   voices="miho00420"/><msg @l="839" char_id="-1" frame_id="-1" name="留学生" text="『不错！不错！』"   voices=""/><msg @l="841" char_id="-1" frame_id="-1" name=""   text="黑色的手进一步将侵略的魔爪伸向下半身如蜜桃般的臀部。" voices=""/><msg @l="842" char_id="-1" frame_id="-1" name=""   text="留学生用另一只手隔着泳衣，像是要托起那描绘出柔软曲线美的臀部肉一般揉捏着，爱抚着。" voices=""/><msg @l="844" char_id="0" frame_id="-1" name="美帆" text="『……唔……。』"   voices="miho09930"/><msg @l="846" char_id="-1" frame_id="-1" name="留学生" text="『哦，干得好！』"   voices=""/><msg @l="848" char_id="-1" frame_id="-1" name=""   text="留学生把原本抚摸臀部的黑手移向私处，压迫着女阴的中心。于是泳衣嵌入了女唇之间。"   voices=""/><msg @l="850" char_id="-1" frame_id="-1" name="" text="咕啾，姆啾。" voices=""/><msg @l="852" char_id="0" frame_id="-1" name="美帆" text="『不要……那里是……。』"   voices="miho00410"/><msg @l="854" char_id="-1" frame_id="-1" name="留学生" text="『小穴！小穴！』"   voices=""/><msg @l="856" char_id="-1" frame_id="-1" name=""   text="抚摸着蜜口的指腹突然向前滑动，触碰到了上方的突起。" voices=""/><msg @l="858" char_id="0" frame_id="-1" name="美帆" text="『嗯啊！』"   voices="miho00450"/><msg @l="860" char_id="-1" frame_id="-1" name="留学生" text="『哦……美妙的小穴……。』"   voices=""/><msg @l="862" char_id="0" frame_id="-1" name="美帆" text="『啊，不要……。』"   voices="miho03880"/><msg @l="864" char_id="-1" frame_id="-1" name=""   text="黑人留学生的手指隔着泳衣强行侵入秘处……用中指不断震动着。" voices=""/><msg @l="865" char_id="-1" frame_id="-1" name=""   text="我试图扭动身体反抗，但马上惊醒过来，僵住了。" voices=""/><msg @l="866" char_id="-1" frame_id="-1" name=""   text="如果反抗的话这事就没完没了……如果不管他的话，他应该会去找别的女孩……是的，我这样告诉自己。" voices=""/><msg @l="868" char_id="0" frame_id="-1" name="美帆" text="『……。』"   voices="miho03890"/><msg @l="870" char_id="-1" frame_id="-1" name="留学生" text="『嘿，张开张开……。』"   voices=""/><msg @l="872" char_id="-1" frame_id="-1" name=""   text="说着，他将手臂伸入我的大腿之间……试图让我张开双腿。" voices=""/><msg @l="874" char_id="0" frame_id="-1" name="美帆" text="『啊……嗯啊。』"   voices="miho03900"/><msg @l="876" char_id="-1" frame_id="-1" name=""   text="我……本想反抗而绷紧双腿，却在泳池底部滑了一下，不小心张开了双腿，反而像是接受了他的手。"   voices=""/><msg @l="878" char_id="-1" frame_id="-1" name="留学生" text="『好嘞。真棒……。』"   voices=""/><msg @l="880" char_id="0" frame_id="-1" name="美帆" text="『啊，我不是……那种。』"   voices="miho03910"/><msg @l="882" char_id="-1" frame_id="-1" name="" text="啪。" voices=""/><msg @l="883" char_id="-1" frame_id="-1" name="" text="同时伴随着我的话语，突起被他用力弹弄了一下。"   voices=""/><msg @l="885" char_id="0" frame_id="-1" name="美帆" text="『嗯啊！』"   voices="miho00450"/><msg @l="887" char_id="-1" frame_id="-1" name=""   text="我拼命压抑住差点漏出来的声音。" voices=""/><msg @l="888" char_id="-1" frame_id="-1" name="" text="就像是……有电流穿过全身一样。"   voices=""/><msg @l="890" char_id="-1" frame_id="-1" name="留学生" text="『真棒！小穴！！』"   voices=""/><msg @l="892" char_id="-1" frame_id="-1" name=""   text="留学生一边这么说着，一边用手指抚摸我的那里，还把腰贴在我的臀部蹭来蹭去。" voices=""/><msg @l="893" char_id="-1" frame_id="-1" name="留学生"   text="『我的鸡巴也……很不错吧。』" voices=""/><msg @l="895" char_id="0" frame_id="-1" name="美帆" text="『啊……。』"   voices="miho03920"/><msg @l="897" char_id="-1" frame_id="-1" name=""   text="黑人的手抓住了我的手，强行按在他的胯下。" voices=""/><msg @l="898" char_id="-1" frame_id="-1" name=""   text="黑人留学生的那里……令人惊讶地又大又硬。" voices=""/><msg @l="899" char_id="-1" frame_id="-1" name=""   text="因为第一次触碰男人的那东西而感到震惊，我不由自主地缩回了手。" voices=""/><msg @l="901" char_id="-1" frame_id="-1" name="留学生"   text="『哦，这里接下来，不行吗……』" voices=""/><msg @l="903" char_id="0" frame_id="-1" name="美帆" text="『啊……这是什么意思……』"   voices="miho03930"/><msg @l="905" char_id="-1" frame_id="-1" name="留学生" text="『嘿，过来，过来。』"   voices=""/><msg @l="907" char_id="0" frame_id="-1" name="美帆" text="『啊，等一下……』"   voices="miho03940"/><clear @l="910" class="all"/><end_scene @l="913"/><label @l="915" id="event_scene55"/><msg @l="917" char_id="-1" frame_id="-1" name=""   text="呼吸粗重的黑人留学生强行把我拉到了泳池边。" voices=""/><msg @l="918" char_id="-1" frame_id="-1" name=""   text="无论我多少次说周围有人看着，他都不听。" voices=""/><msg @l="919" char_id="-1" frame_id="-1" name=""   text="社团的成员们都困惑地看着我被那位黑人留学生牵着手离开泳池的样子。" voices=""/><msg @l="921" char_id="0" frame_id="-1" name="美帆"   text="(亚季奈……太好了，正好在游泳呢)" voices="miho03950"/><msg @l="923" char_id="-1" frame_id="-1" name="" text="被亚季奈看到可不妙。"   voices=""/><msg @l="924" char_id="-1" frame_id="-1" name=""   text="不能牵连亚季奈，让她也遭遇这种糟糕的事。" voices=""/><wait_chgmv/><bg @l="927" src="bg11"/><msg @l="929" char_id="-1" frame_id="-1" name="留学生" text="『嘿，快点。』"   voices=""/><char @l="932" id="miho" pos="auto" src="miho166"/><msg @l="934" char_id="0" frame_id="-1" name="美帆" text="『啊……』"   voices="miho03960"/><msg @l="936" char_id="-1" frame_id="-1" name=""   text="被留学生牵着手，就这样被带到了更衣室。" voices=""/><msg @l="938" char_id="-1" frame_id="-1" name="留学生" text="『这里可以了吧。』"   voices=""/><msg @l="940" char_id="0" frame_id="-1" name="美帆"   text="『啊，那个……我……并不是那个意思……』" voices="miho03970"/><msg @l="942" char_id="-1" frame_id="-1" name="留学生"   text="『不用客气，不用谢……快，摸摸我的那个。』" voices=""/><char @l="945" id="miho" pos="auto" src="miho164"/><msg @l="947" char_id="0" frame_id="-1" name="美帆" text="『呀！！』"   voices="miho03980"/><msg @l="949" char_id="0" frame_id="-1" name="美帆"   text="(那个……是小鸡鸡吧？)" voices="miho03990"/><msg @l="951" char_id="0" frame_id="-1" name="美帆"   text="(天啊……居然这么大……？)" voices="miho04000"/><msg @l="953" char_id="-1" frame_id="-1" name=""   text="他毫不犹豫地拉开泳裤，掏出那已经硬起来的东西。" voices=""/><msg @l="954" char_id="-1" frame_id="-1" name=""   text="可能……这是我第一次直接看到男人的那个东西变硬的样子。" voices=""/><msg @l="956" char_id="-1" frame_id="-1" name="留学生" text="『来吧。』" voices=""/><char @l="960" id="miho" pos="auto" src="miho165"/><msg @l="962" char_id="0" frame_id="-1" name="美帆" text="『等等……住手！？ 』"   voices="miho04010"/><clear @l="965" class="char"/><msg @l="967" char_id="-1" frame_id="-1" name=""   text="我的手臂被拉住，被强行拽到躺在地上的他身上。" voices=""/><msg @l="968" char_id="-1" frame_id="-1" name="" text="只是……这和普通的拥抱有些不同。"   voices=""/><msg @l="969" char_id="-1" frame_id="-1" name=""   text="他和我的头部呈相反的方向……" voices=""/><msg @l="970" char_id="-1" frame_id="-1" name=""   text="……眼前，那坚硬挺立的东西就这样暴露在我面前。" voices=""/><label @l="973" id="chart_line15"/><wait_chgmv/><ev @l="976" src="ev-055"/><description @l="979" text="强制口交"/><bgm @l="982" src="bgm14" volume="1."/><msg @l="984" char_id="0" frame_id="-1" name="美帆" text="『唔咯！？ 』"   voices="miho04020"/><msg @l="986" char_id="-1" frame_id="-1" name=""   text="坚硬的东西强行塞进口中，让我动弹不得。" voices=""/><msg @l="987" char_id="-1" frame_id="-1" name=""   text="想要吐出来却因为那肉棒太长，如果不改变姿势根本无处可逃。" voices=""/><msg @l="988" char_id="-1" frame_id="-1" name=""   text="试图挪动身体时，腰部被顶出，喉咙被戳刺。" voices=""/><msg @l="989" char_id="-1" frame_id="-1" name=""   text="头部被肉棒固定，腰部被手按住……被两点固定住，我只能认命了。" voices=""/><msg @l="991" char_id="0" frame_id="-1" name="美帆" text="『唔唔……唔，唔唔——！』"   voices="miho04030"/><msg @l="993" char_id="-1" frame_id="-1" name=""   text="整个口腔充满了泳池的……氯气的味道。" voices=""/><msg @l="994" char_id="-1" frame_id="-1" name=""   text="与其说是不适感，现在更多的是窒息感。" voices=""/><msg @l="995" char_id="-1" frame_id="-1" name=""   text="总之它太大了，太硬了，太深了……我快要喘不过气了。" voices=""/><msg @l="997" char_id="-1" frame_id="-1" name="留学生" text="『哦……哦——』"   voices=""/><msg @l="999" char_id="-1" frame_id="-1" name="留学生" text="『哦……哦哦——！』"   voices=""/><msg @l="1001" char_id="0" frame_id="-1" name="美帆" text="『唔嗯！？』"   voices="miho04040"/><msg @l="1003" char_id="-1" frame_id="-1" name=""   text="突然，塞在口腔内的东西开始激烈律动起来。" voices=""/><msg @l="1004" char_id="-1" frame_id="-1" name=""   text="我睁大眼睛不明所以，才发现他正在活动腰部从下方顶弄。" voices=""/><msg @l="1006" char_id="0" frame_id="-1" name="美帆" text="『唔唔，唔……唔咕！！』"   voices="miho04050"/><msg @l="1008" char_id="-1" frame_id="-1" name="" text="那根硬挺的东西在我口中来回抽动。"   voices=""/><msg @l="1009" char_id="-1" frame_id="-1" name=""   text="喉咙深处被戳刺着，我一次又一次地试图将它吐出。" voices=""/><msg @l="1011" char_id="-1" frame_id="-1" name="留学生" text="『不！』" voices=""/><msg @l="1013" char_id="-1" frame_id="-1" name=""   text="不知是否因为快感，他那本就蹩脚的日语变得更加不堪，同时他以惊人的气势发怒起来。" voices=""/><msg @l="1014" char_id="-1" frame_id="-1" name=""   text="我害怕了，慌忙地将那猛烈勃起的硬物吞进口中。" voices=""/><msg @l="1016" char_id="-1" frame_id="-1" name="留学生"   text="『哦！好的，好的，小穴……骚穴骚穴……』" voices=""/><msg @l="1018" char_id="0" frame_id="-1" name="美帆"   text="『嗯，嗯嗯……嗯咕…………嗯嗯嗯嗯！！』" voices="miho04060"/><msg @l="1020" char_id="-1" frame_id="-1" name=""   text="突然泳衣被拉下，他的舌头开始舔舐我私处的隆起。" voices=""/><msg @l="1021" char_id="-1" frame_id="-1" name=""   text="黏腻的触感在私密的唇瓣间游走，让人感到恶心。" voices=""/><msg @l="1022" char_id="-1" frame_id="-1" name=""   text="或许是出于恐惧而非快感，腰部以下的感觉逐渐麻痹，仿佛失去了知觉。" voices=""/><msg @l="1024" char_id="0" frame_id="-1" name="美帆" text="『嗯咕，嗯，嗯，呼啊……。』"   voices="miho04070"/><msg @l="1026" char_id="0" frame_id="-1" name="美帆"   text="『嗯呜呜……嗯咕………呼………。』" voices="miho04080"/><msg @l="1028" char_id="-1" frame_id="-1" name="" text="我无法呼吸。" voices=""/><msg @l="1029" char_id="-1" frame_id="-1" name="" text="下巴……好痛。" voices=""/><msg @l="1030" char_id="-1" frame_id="-1" name=""   text="尽管如此，为了尽快摆脱这种痛苦，我几乎是自发地前后摆动头部，用嘴尽力刺激那膨胀勃起的硬物。" voices=""/><msg @l="1032" char_id="-1" frame_id="-1" name="留学生"   text="『哦哦，哦哦，哦买嘎！』" voices=""/><msg @l="1034" char_id="-1" frame_id="-1" name="" text="那男人疯狂地叫喊着。"   voices=""/><msg @l="1035" char_id="-1" frame_id="-1" name="" text="然而，他的话语并未传达到我的意识中。"   voices=""/><msg @l="1037" char_id="0" frame_id="-1" name="美帆"   text="『嗯噗……嗯，嗯嗯……嗯咕……嗯咕呜！！』" voices="miho04090"/><msg @l="1039" char_id="0" frame_id="-1" name="美帆"   text="『嗯，嗯嗯……啊咕………嗯嗯嗯！！』" voices="miho04100"/><msg @l="1041" char_id="-1" frame_id="-1" name="留学生" text="『哦啊！嘎啊啊！！』"   voices=""/><msg @l="1043" char_id="0" frame_id="-1" name="美帆" text="『嗯噗呜！？』"   voices="miho04110"/><flash @l="1046" count="4" fade="100" image="white"/><wait_chgmv/><ev @l="1048" src="ev-055x1z1"/><msg @l="1050" char_id="-1" frame_id="-1" name=""   text="突然，巨大的阴茎剧烈膨胀，紧接着，积蓄已久的液体在我喉咙深处爆发。" voices=""/><msg @l="1052" char_id="0" frame_id="-1" name="美帆"   text="『嗯咕……嗯嗯………噗啊！！』" voices="miho04120"/><msg @l="1054" char_id="-1" frame_id="-1" name="留学生"   text="『不，不要！吞下去，吞下去！』" voices=""/><msg @l="1056" char_id="-1" frame_id="-1" name=""   text="我忍不住要从嘴角漏出来，但他甚至不允许这样，强迫我全部咽下。" voices=""/><msg @l="1058" char_id="0" frame_id="-1" name="美帆"   text="『咳啊……咳呃……咳，咳咳！！』" voices="miho04130"/><msg @l="1060" char_id="-1" frame_id="-1" name=""   text="因为窒息感，我不自觉地咕咚咕咚吞咽着。" voices=""/><msg @l="1061" char_id="-1" frame_id="-1" name=""   text="射精结束后，肉棒慢慢地从我喉咙深处抽出。" voices=""/><msg @l="1062" char_id="-1" frame_id="-1" name=""   text="当按住我腰部的手松开的瞬间，我本能地跳了起来，吐出那东西，剧烈地咳嗽起来。" voices=""/><msg @l="1063" char_id="-1" frame_id="-1" name=""   text="灌入喉咙深处的热液从口中溢出。" voices=""/><msg @l="1065" char_id="0" frame_id="-1" name="美帆" text="『哈……哈……。』"   voices="miho04140"/><msg @l="1067" char_id="-1" frame_id="-1" name=""   text="我甚至没有余力擦拭嘴唇，只是反复做着深呼吸。" voices=""/><msg @l="1068" char_id="-1" frame_id="-1" name=""   text="每次吸气，肺部都充满了腥臭的气味。" voices=""/><clear @l="1074" class="all"/><msg @l="1076" char_id="-1" frame_id="-1" name="留学生" text="『哦，哦啊……非常棒。』"   voices=""/><msg @l="1078" char_id="-1" frame_id="-1" name="留学生" text="『法克，太爽了。』"   voices=""/><msg @l="1080" char_id="-1" frame_id="-1" name=""   text="留学生这么说着，试图将那凶悪的肉棒插入美帆的私处。" voices=""/><msg @l="1082" char_id="0" frame_id="-1" name="美帆" text="『呀……不要……。』"   voices=""/><stopbgm @l="1085" fadeout="1000"/><se @l="1087" buf="1" src="扉を開ける音_金属" volume="1."/><msg @l="1089" char_id="-1" frame_id="-1" name="女部员A" text="『毛巾，毛巾！』"   voices=""/><msg @l="1091" char_id="-1" frame_id="-1" name="女部员B"   text="『快点啊——，我们还在训练呢——。』" voices=""/><msg @l="1093" char_id="-1" frame_id="-1" name="留学生"   text="『哦，太遗憾了。有人进来了。』" voices=""/><msg @l="1095" char_id="-1" frame_id="-1" name="留学生" text="『继续。下次……』"   voices=""/><msg @l="1097" char_id="-1" frame_id="-1" name="留学生"   text="『下次，下次。我很期待。』" voices=""/><msg @l="1099" char_id="-1" frame_id="-1" name=""   text="留学生说完，为了不被进来的女子部员发现，离开了更衣室。" voices=""/><clear @l="1102" class="all"/><end_scene @l="1105"/><wait_chgmv/><bg @l="1108" src="bg11"/><bgm @l="1111" src="bgm03" volume="1."/><description @l="1114" text="游泳教练·第3天"/><msg @l="1116" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="1118" char_id="-1" frame_id="-1" name=""   text="回过神来……我一个人被留在了更衣室里。" voices=""/><msg @l="1119" char_id="-1" frame_id="-1" name=""   text="刚才还在侵犯我喉咙的留学生已经不在了。" voices=""/><char @l="1122" id="miho" pos="auto" src="miho165"/><msg @l="1124" char_id="0" frame_id="-1" name="美帆" text="『我……。』" voices=""/><msg @l="1126" char_id="-1" frame_id="-1" name="" text="恢复意识后我抬起了身体。"   voices=""/><msg @l="1127" char_id="-1" frame_id="-1" name=""   text="这时，我才终于意识到自己倒在了地板上。" voices=""/><char @l="1130" id="miho" pos="auto" src="miho064"/><msg @l="1132" char_id="0" frame_id="-1" name="美帆" text="『啊……。』" voices=""/><msg @l="1134" char_id="-1" frame_id="-1" name="" text="从嘴角有什么东西流了下来。"   voices=""/><msg @l="1135" char_id="-1" frame_id="-1" name=""   text="用指尖挑起来一看……是白色浑浊的液体。" voices=""/><char @l="1138" id="miho" pos="auto" src="miho065"/><msg @l="1140" char_id="0" frame_id="-1" name="美帆"   text="『这、这个……是从那个小鸡鸡尖端出来的东西……。』" voices=""/><msg @l="1142" char_id="0" frame_id="-1" name="美帆" text="『这就是……精液……？』"   voices=""/><msg @l="1144" char_id="-1" frame_id="-1" name=""   text="我呆呆地……注视着缠绕在手指上的那东西。" voices=""/><msg @l="1145" char_id="-1" frame_id="-1" name=""   text="我并不太清楚自己究竟遭遇了什么。" voices=""/><msg @l="1146" char_id="-1" frame_id="-1" name="" text="只感到非常痛苦……难受。"   voices=""/><msg @l="1147" char_id="-1" frame_id="-1" name=""   text="之后留下的就是这白色浑浊的液体……。" voices=""/><char @l="1150" id="miho" pos="auto" src="miho066"/><msg @l="1152" char_id="0" frame_id="-1" name="美帆"   text="『原来如此……我……被玷污了啊……。』" voices=""/><msg @l="1154" char_id="-1" frame_id="-1" name=""   text="我茫然自语着，这才第一次真正领悟了那句话的含义。" voices=""/><msg @l="1156" char_id="0" frame_id="-1" name="美帆" text="『我……。』" voices=""/><char @l="1159" id="miho" pos="auto" src="miho165"/><msg @l="1161" char_id="0" frame_id="-1" name="美帆" text="『我……呜、呜呜……。』"   voices=""/><msg @l="1163" char_id="-1" frame_id="-1" name=""   text="在空无一人的更衣室里，我浑身浸透着腥臭的精液味，强忍着声音哭泣着。" voices=""/><stopbgm @l="1166" fadeout="1000"/><clear @l="1169" class="all"/><wait_chgmv/><bg @l="1172" src="bg07b"/><bgm @l="1175" src="bgm05" volume="1."/><char @l="1178" id="akina" pos="auto" src="akina014"/><msg @l="1180" char_id="2" frame_id="-1" name="亚季奈" text="『姐姐，你真的没事吗？』"   voices=""/><clear @l="1183" class="char"/><char @l="1185" id="akina" pos="right" src="akina010"/><char @l="1187" id="miho" pos="left" src="miho016"/><msg @l="1189" char_id="0" frame_id="-1" name="美帆" text="『嗯……没事。』"   voices=""/><char @l="1192" id="miho" pos="left" src="miho116"/><msg @l="1194" char_id="0" frame_id="-1" name="美帆"   text="『别担心，只是贫血而已……。』" voices=""/><msg @l="1196" char_id="-1" frame_id="-1" name=""   text="在那之后……我仔细地冲了淋浴才回到游泳池。" voices=""/><msg @l="1197" char_id="-1" frame_id="-1" name=""   text="我对亚季奈撒了谎，说自己是因为贫血感到不舒服才在更衣室休息的。" voices=""/><char @l="1200" id="akina" pos="right" src="akina011"/><msg @l="1202" char_id="2" frame_id="-1" name="亚季奈" text="『那就好啦～。』"   voices=""/><char @l="1205" id="akina" pos="right" src="akina115"/><msg @l="1207" char_id="2" frame_id="-1" name="亚季奈"   text="『不过，我吓了一跳呢……姐姐你突然不见了，再回来时脸色苍白得吓人。』" voices=""/><msg @l="1209" char_id="0" frame_id="-1" name="美帆" text="『让你担心了，对不起……。』"   voices=""/><char @l="1212" id="miho" pos="left" src="miho016"/><msg @l="1214" char_id="0" frame_id="-1" name="美帆" text="『但是……我现在已经没事了。』"   voices=""/><msg @l="1216" char_id="-1" frame_id="-1" name="" text="于是我勉强挤出一丝微笑。"   voices=""/><msg @l="1217" char_id="-1" frame_id="-1" name="" text="不知道自己笑得好不好……没有信心。"   voices=""/><char @l="1220" id="akina" pos="right" src="akina011"/><msg @l="1222" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯～，比刚才气色好多了，但是不要勉强自己哦？』" voices=""/><char @l="1225" id="miho" pos="left" src="miho110"/><msg @l="1227" char_id="0" frame_id="-1" name="美帆" text="『我知道的……谢谢。』"   voices=""/><char @l="1230" id="akina" pos="right" src="akina111"/><msg @l="1232" char_id="2" frame_id="-1" name="亚季奈" text="『诶嘿嘿～。』" voices=""/><msg @l="1234" char_id="2" frame_id="-1" name="亚季奈"   text="『那姐姐，明天见啦。』" voices=""/><char @l="1237" id="miho" pos="left" src="miho016"/><msg @l="1239" char_id="0" frame_id="-1" name="美帆" text="『嗯，明天……。』"   voices=""/><clear @l="1242" layer="akina"/><clear @l="1244" class="char"/><char @l="1246" id="miho" pos="auto" src="miho115"/><msg @l="1248" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="1250" char_id="0" frame_id="-1" name="美帆"   text="（又……增加了不必要的谎言呢……）" voices=""/><label @l="1253" id="EventLabel_64"/><stopbgm @l="1256" fadeout="1000"/><clear @l="1259" class="all"/><goto @l="1262" cond="!(f.留学生に抵抗したflag&#32;==&#32;1)&#13;&#10;"   label="TempLabel_214"/><call @l="1266" target="EventLabel_65@root_akina04a"/><return @l="1267" value="0&#13;&#10;"/><goto @l="1269" label="TempLabel_235"/><label @l="1270" id="TempLabel_214"/><call @l="1275" target="EventLabel_79@root_akina04b"/><return @l="1276" value="0&#13;&#10;"/><label @l="1278" id="TempLabel_235"/><return @l="1283" value=""/></code></xscript>																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																	