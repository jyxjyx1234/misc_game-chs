<?xml version="1.0" encoding="utf-8"?><xscript><debug editor="&quot;C:\Program&#32;Files&#32;(x86)\sakura\sakura.exe&quot;&#32;&quot;%src%&quot;&#32;-Y=%line%"   src="D:\シロップ\町ぐるみの罠＋汚された夏セット版\汚された夏\完成データ\汚された夏\script\text\ending11.txt"/><code><label @l="12" id="EventLabel_49"/><label @l="15" id="event_scene35"/><description @l="19" text="稻庭专属奴隶"/><eval @l="21" expr="f.numDay=0&#13;&#10;"/><wait_chgmv/><bg @l="25" src="bg07"/><bgm @l="29" src="bgm03" volume="1."/><msg @l="31" char_id="-1" frame_id="-1" name="" text="———数周后。" voices=""/><msg @l="32" char_id="-1" frame_id="-1" name=""   text="稻庭俊明从大学校园中消失，引起了对他有好感的女性们骚动，这是一周前左右的事情。" voices=""/><msg @l="33" char_id="-1" frame_id="-1" name=""   text="现在虽然有长期休学啦或者转入国外大学啦等看起来不太可能的谣言四处流传，但已经不像失踪直后那样引起轰动了。"   voices=""/><msg @l="34" char_id="-1" frame_id="-1" name=""   text="偶像之所以能被崇拜，是因为它一直在众人的眼前，一旦从眼前消失，其影响力往往会很快消退。"   voices=""/><msg @l="35" char_id="-1" frame_id="-1" name="" text="……就是这样的。" voices=""/><wait_chgmv/><bg @l="39" src="bg13"/><msg @l="41" char_id="-1" frame_id="-1" name=""   text="那么……在她们之间掀起的“稻庭俊明失踪”风波背后，有多少人注意到还有另外两名学生从大学校园里消失了呢？"   voices=""/><msg @l="42" char_id="-1" frame_id="-1" name="" text="一个是白石玲。" voices=""/><msg @l="43" char_id="-1" frame_id="-1" name="" text="据传言，她已经退学了。"   voices=""/><msg @l="44" char_id="-1" frame_id="-1" name=""   text="虽然真假尚不明确……但她们所住的公寓已被清空的事实使这一谣言更接近真相。" voices=""/><msg @l="45" char_id="-1" frame_id="-1" name=""   text="只是，知道她之后联系不上的少数几个人才会担心她的安危。" voices=""/><wait_chgmv/><bg @l="49" src="bg14"/><msg @l="51" char_id="-1" frame_id="-1" name="" text="还有另一位失踪者，仲根美帆。"   voices=""/><msg @l="52" char_id="-1" frame_id="-1" name="" text="她……就在这里。" voices=""/><msg @l="53" char_id="-1" frame_id="-1" name=""   text="被吊在网球社团专用活动室里的，可怜的人偶。" voices=""/><msg @l="54" char_id="-1" frame_id="-1" name="" text="这就是现在的“她”。"   voices=""/><msg @l="55" char_id="-1" frame_id="-1" name=""   text="而且……在她身旁总是有一个男人与她肌肤相亲。" voices=""/><stopbgm @l="59" fadeout="1000"/><label @l="63" id="chart_line60"/><wait_chgmv/><ev @l="67" src="ev-035"/><bgm @l="71" src="bgm14" volume="1."/><msg @l="73" char_id="-1" frame_id="-1" name="稻庭"   text="『哈，哈，哈……呼，咕呼……啊，啊哈哈哈哈哈！』" voices=""/><msg @l="75" char_id="0" frame_id="-1" name="美帆"   text="『啊，啊啊啊……嘶呜，啊，啊，嗯嗯嗯！！』" voices="miho12160"/><msg @l="77" char_id="-1" frame_id="-1" name=""   text="这两个被认为从大学校园里消失的人，实际上日夜不分地在这个活动室里交合着。" voices=""/><msg @l="78" char_id="-1" frame_id="-1" name=""   text="虽然两人就在附近，却没人发现他们存在的原因是，这一带是由负责管理的校工熊野负责的。"   voices=""/><msg @l="79" char_id="-1" frame_id="-1" name=""   text="而且……通过药物控制网球社团的大部分男性成员的熊野，巧妙地操纵了他们的记忆，成功地隐瞒了这一切。" voices=""/><msg @l="81" char_id="0" frame_id="-1" name="美帆"   text="『啊…啊，啊啊…嗯，嗯呜，啊啊啊。』" voices="miho12170"/><msg @l="83" char_id="-1" frame_id="-1" name=""   text="每当稻庭的肉棒贯穿美帆的秘处，甜美的喘息就从她口中溢出。" voices=""/><msg @l="84" char_id="-1" frame_id="-1" name=""   text="她的身体上已经沾满了超乎寻常数量的精液。" voices=""/><msg @l="85" char_id="-1" frame_id="-1" name="" text="全都是……从稻庭那里射出来的东西。"   voices=""/><msg @l="87" char_id="-1" frame_id="-1" name="稻庭"   text="『啊，啊啊啊啊…我的小穴……我，我的，哈哈哈！』" voices=""/><msg @l="89" char_id="-1" frame_id="-1" name=""   text="每当他猛烈地挺动阳具时，稻庭口中就会冒出一些毫无意义的话语。" voices=""/><msg @l="90" char_id="-1" frame_id="-1" name="" text="他双眼布满血丝……目光涣散。"   voices=""/><msg @l="91" char_id="-1" frame_id="-1" name="" text="恐怕是“某种东西”出了问题吧。"   voices=""/><msg @l="93" char_id="0" frame_id="-1" name="美帆"   text="『啊，啊，啊……呜，啊啊……嗯，嗯嗯嗯！』" voices="miho12180"/><msg @l="95" char_id="0" frame_id="-1" name="美帆"   text="『啊啊……啊，嗯，嗯………嗯……那里，那里！』" voices="miho12190"/><msg @l="97" char_id="-1" frame_id="-1" name=""   text="肉棒的前端顶撞着子宫口，美帆颤抖着腰肢，发出了仿佛要融化一般的声音。" voices=""/><msg @l="98" char_id="-1" frame_id="-1" name=""   text="稻庭仿佛对这声音做出反应一般，更加猛烈地撞击着腰部，顶弄、摩擦着美帆敏感的地方。" voices=""/><msg @l="100" char_id="0" frame_id="-1" name="美帆"   text="『好，好棒……插进来，再深点插进来！！』" voices="miho12200"/><msg @l="102" char_id="-1" frame_id="-1" name="稻庭"   text="『呼，啊哈哈……好啊，好，好小穴，嘿嘿嘿，呼哈哈哈！！』" voices=""/><msg @l="104" char_id="0" frame_id="-1" name="美帆"   text="『嗯啊……啊，不行……要，要来了……啊啊！』" voices="miho12210"/><msg @l="106" char_id="-1" frame_id="-1" name="稻庭"   text="『啊，啊哈哈……啊哈……小穴小穴……哈，哈，哈，呼哈！』" voices=""/><msg @l="108" char_id="-1" frame_id="-1" name=""   text="稻庭仿佛配合着美帆达到极限一般，疯狂地上下抽动着腰部。" voices=""/><msg @l="109" char_id="-1" frame_id="-1" name=""   text="然而……他的双眼却始终没有看向美帆。" voices=""/><msg @l="111" char_id="0" frame_id="-1" name="美帆"   text="『去了，去了去了去了………啊……嗯嗯嗯嗯嗯！！！』" voices="miho12220"/><msg @l="113" char_id="-1" frame_id="-1" name="稻庭" text="『呃啊！咕、啊啊啊啊啊啊！！』"   voices=""/><flash @l="117" count="4" fade="100" image="white"/><msg @l="119" char_id="-1" frame_id="-1" name=""   text="随着射精，美帆的身体剧烈地颤抖起伏。" voices=""/><msg @l="120" char_id="-1" frame_id="-1" name=""   text="稻庭对此毫不在意，深深地挺入腰部，继续着射精。" voices=""/><msg @l="122" char_id="0" frame_id="-1" name="美帆" text="『嗯唔！！』"   voices="miho12230"/><wait_chgmv/><ev @l="126" src="ev-035z1"/><msg @l="128" char_id="-1" frame_id="-1" name=""   text="美帆的身体猛烈摇晃，热棒从阴道内被抽出。" voices=""/><msg @l="129" char_id="-1" frame_id="-1" name=""   text="即便如此，稻庭的那话儿仍在持续射精……将美帆的身体染得更加白浊粘稠。" voices=""/><msg @l="131" char_id="0" frame_id="-1" name="美帆" text="『啊，啊啊……。』"   voices="miho12240"/><msg @l="133" char_id="-1" frame_id="-1" name="" text="美帆在高潮的余韵中身体颤抖着。"   voices=""/><msg @l="134" char_id="-1" frame_id="-1" name=""   text="伴随着咕噜咕噜的声音，精液从阴道内溢出……滴落在地板上。" voices=""/><msg @l="135" char_id="-1" frame_id="-1" name=""   text="在房间的黑暗中，有一双红色的眼睛注视着这两人的身影。" voices=""/><msg @l="136" char_id="-1" frame_id="-1" name="" text="是熊野……。" voices=""/><msg @l="138" char_id="-1" frame_id="-1" name="熊野" text="『咕咕咕咕咕，收集到了很好的数据。』"   voices=""/><msg @l="140" char_id="-1" frame_id="-1" name="熊野"   text="『多亏如此，勃起药物已经可以很快投入实用了，不过这些家伙……还得再加把劲才行。』" voices=""/><msg @l="142" char_id="-1" frame_id="-1" name="" text="说完，熊野融入黑暗中消失了。"   voices=""/><clear @l="148" class="all"/><msg @l="150" char_id="0" frame_id="-1" name="美帆" text="『……。』"   voices="miho12250"/><msg @l="152" char_id="-1" frame_id="-1" name="稻庭" text="『……呼嘿，嘿嘿嘿。』"   voices=""/><msg @l="154" char_id="0" frame_id="-1" name="美帆" text="『啊，嗯嗯……。』"   voices="miho12260"/><msg @l="156" char_id="-1" frame_id="-1" name="稻庭" text="『唔哦……。』" voices=""/><msg @l="158" char_id="-1" frame_id="-1" name=""   text="就这样……在没有充分休息的情况下，不知是谁主动，两人再次纠缠在一起，开始贪婪地索取快感。" voices=""/><msg @l="159" char_id="-1" frame_id="-1" name=""   text="仿佛，那是他们唯一的存在证明一般……。" voices=""/><stopbgm @l="163" fadeout="1000"/><clear @l="169" class="all"/><end_scene @l="172"/><eval @l="176" expr="s.flagGallery=1&#13;&#10;"/><eval @l="178" expr="s.event35flag=1&#13;&#10;"/><eval @l="183"   expr="f.bEx&#32;=&#32;s.event20flag&#32;&amp;&amp;&#32;s.event23flag&#32;&amp;&amp;&#32;s.event25flag&#32;&amp;&amp;&#32;s.event30flag&#32;&amp;&amp;&#32;s.event31flag&#32;&amp;&amp;&#32;s.event32flag&#32;&amp;&amp;&#32;s.event33flag&#32;&amp;&amp;&#32;s.event35flag&#32;&amp;&amp;&#32;s.event37flag&#32;&amp;&amp;&#32;s.event38flag&#32;&amp;&amp;&#32;s.event60flag&#13;&#10;"/><goto @l="185" cond="!(f.bEx)&#13;&#10;" label="TempLabel_301"/><eval @l="187" expr="s.exRootFlag=1&#13;&#10;"/><label @l="188" id="TempLabel_301"/><ending @l="190"/><goto @l="192" cond="!(f.bEx)&#13;&#10;" label="TempLabel_302"/><wait_chgmv/><bg @l="196" src="newroot"/><wait @l="198" time="5000"/><wait_chgmv/><bg @l="200" src="black"/><label @l="203" id="TempLabel_302"/><return @l="207" value=""/></code></xscript>																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																			