<?xml version="1.0" encoding="utf-8"?><xscript><debug editor="&quot;C:\Program&#32;Files&#32;(x86)\sakura\sakura.exe&quot;&#32;&quot;%src%&quot;&#32;-Y=%line%"   src="D:\シロップ\町ぐるみの罠＋汚された夏セット版\汚された夏\完成データ\汚された夏\script\text\root_kutuki04c.txt"/><code><label @l="10" id="EventLabel_125"/><description @l="13" text="契约的日子·第3天"/><eval @l="15" expr="f.numDay=9&#13;&#10;"/><msgshow @l="17" show="false"/><wait_chgmv/><bg @l="19" src="day09" time="2000"/><wait @l="21" time="500"/><wait_chgmv/><bg @l="23" src="black" time="2000"/><msgshow @l="25" show="true"/><wait_chgmv/><bg @l="28" src="bg18m1"/><bgm @l="31" src="bgm03" volume="1."/><char @l="34" id="miho" pos="auto" src="miho115"/><msg @l="36" char_id="0" frame_id="-1" name="美帆" text="『……唉。』" voices=""/><msg @l="38" char_id="-1" frame_id="-1" name="" text="不禁……叹了口气。"   voices=""/><msg @l="39" char_id="-1" frame_id="-1" name="" text="早晨，我正走在车站前，前往公交站点。"   voices=""/><msg @l="40" char_id="-1" frame_id="-1" name="" text="今天我穿着内衣。"   voices=""/><msg @l="41" char_id="-1" frame_id="-1" name=""   text="昨天没有被命令，所以应该不算违反约定吧。" voices=""/><msg @l="43" char_id="0" frame_id="-1" name="美帆" text="『………。』" voices=""/><msg @l="45" char_id="-1" frame_id="-1" name="" text="脚步变得沉重。" voices=""/><msg @l="46" char_id="-1" frame_id="-1" name=""   text="只要坐上电车，毫无疑问朽木教授又会在那里埋伏等待。" voices=""/><msg @l="47" char_id="-1" frame_id="-1" name=""   text="然后……等待着的将是身体被贪婪侵占的事情。" voices=""/><msg @l="49" char_id="0" frame_id="-1" name="美帆" text="（我才没有期待……）"   voices=""/><msg @l="51" char_id="0" frame_id="-1" name="美帆"   text="（绝对……绝对没有期待什么的……）" voices=""/><msg @l="53" char_id="-1" frame_id="-1" name=""   text="我像是在说服自己，快步走向车站，试图驱散内心的犹豫。" voices=""/><clear @l="56" class="all"/><msgshow @l="58" show="true"/><se @l="61" buf="3" loop="true" src="電車走行中" volume="1."/><wait_chgmv/><ev @l="64" src="ev-005"/><msg @l="66" char_id="0" frame_id="-1" name="美帆" text="『………。』"   voices="miho08800"/><msg @l="68" char_id="-1" frame_id="-1" name="" text="我站在平常的墙边位置。" voices=""/><msg @l="69" char_id="-1" frame_id="-1" name=""   text="然后抓着扶手，茫然地望着窗外流动的景色。" voices=""/><msg @l="70" char_id="-1" frame_id="-1" name=""   text="但是……我的意识始终集中在自己的背后。" voices=""/><msg @l="72" char_id="0" frame_id="-1" name="美帆"   text="（大概……不，朽木教授绝对在这趟电车上）" voices="miho08810"/><msg @l="74" char_id="0" frame_id="-1" name="美帆"   text="（现在肯定也在盯着我……看着我）" voices="miho08820"/><msg @l="76" char_id="-1" frame_id="-1" name=""   text="这么想的瞬间……突然，一阵寒意顺着脊背窜了上来。" voices=""/><msg @l="77" char_id="-1" frame_id="-1" name="" text="并不是有什么东西碰到了我。"   voices=""/><msg @l="78" char_id="-1" frame_id="-1" name="" text="这恐怕……是视线。"   voices=""/><msg @l="80" char_id="0" frame_id="-1" name="美帆"   text="（为什么，会这样……我真的被人看着吗……？）" voices="miho08830"/><msg @l="82" char_id="0" frame_id="-1" name="美帆"   text="（而且这感觉……不只一个人………）" voices="miho08840"/><msg @l="84" char_id="-1" frame_id="-1" name=""   text="我能清晰地感受到背后缠绕着的视线。" voices=""/><msg @l="85" char_id="-1" frame_id="-1" name=""   text="这是否意味着，有人正肆无忌惮地打量着我。" voices=""/><msg @l="86" char_id="-1" frame_id="-1" name=""   text="我的脑海中浮现出上周发生的事情……多只手无礼地玩弄我身体的那个画面清晰地浮现在我的脑海中。" voices=""/><msg @l="88" char_id="0" frame_id="-1" name="美帆" text="（那时候……我的脸，被记住了吗……？）"   voices="miho08850"/><msg @l="90" char_id="0" frame_id="-1" name="美帆" text="（所以，才被盯上了……？）"   voices="miho08860"/><msg @l="92" char_id="-1" frame_id="-1" name="" text="恐惧感一下子膨胀开来。"   voices=""/><msg @l="93" char_id="-1" frame_id="-1" name=""   text="那时伸向我身体的手不止一两只。" voices=""/><msg @l="94" char_id="-1" frame_id="-1" name=""   text="如果他们都像约好了似的乘坐这趟列车的话……" voices=""/><msg @l="95" char_id="-1" frame_id="-1" name=""   text="而且，如果他们正在瞄准我的话……" voices=""/><msg @l="97" char_id="0" frame_id="-1" name="美帆"   text="（怎、怎么办……该怎么办？）" voices="miho08870"/><msg @l="99" char_id="0" frame_id="-1" name="美帆"   text="（那时候是因为正好到了大学才没事的……）" voices="miho08880"/><msg @l="101" char_id="-1" frame_id="-1" name=""   text="现在，这列车才刚开动不到五分钟。" voices=""/><msg @l="102" char_id="-1" frame_id="-1" name=""   text="想到这种状态还要持续二十多分钟，不禁打了个寒颤。" voices=""/><msg @l="103" char_id="-1" frame_id="-1" name=""   text="不……如果只是感觉到背后的视线的话，那倒还好。" voices=""/><msg @l="104" char_id="-1" frame_id="-1" name="" text="如果像上次那样伸出手来的话……"   voices=""/><msg @l="106" char_id="-1" frame_id="-1" name="声音"   text="『你那惊恐的表情真是格外诱人呢。』" voices=""/><wait_chgmv/><ev @l="109" src="ev-005ax1"/><msg @l="111" char_id="0" frame_id="-1" name="美帆" text="『啊……！！』"   voices="miho08890"/><msg @l="113" char_id="-1" frame_id="-1" name=""   text="突然在耳边低语的声音，让我惊讶得差点不自觉地尖叫出声。" voices=""/><msg @l="114" char_id="-1" frame_id="-1" name="" text="不用确认也知道，是朽木教授。"   voices=""/><msg @l="116" char_id="-1" frame_id="-1" name="朽木"   text="『怎么样，被视线侵犯的感觉如何？』" voices=""/><msg @l="118" char_id="-1" frame_id="-1" name="朽木"   text="『上次的事情让大家都喜欢上了你。因为他们非要不可，我就告诉了他们你上学的时间。』" voices=""/><msg @l="120" char_id="0" frame_id="-1" name="美帆" text="『怎、怎么会……太过分…………。』"   voices="miho08900"/><msg @l="122" char_id="-1" frame_id="-1" name="朽木"   text="『放心吧，他们都不会未经我的允许就动手的。』" voices=""/><msg @l="124" char_id="-1" frame_id="-1" name="朽木"   text="『毕竟你是我的“玩物”啊。』" voices=""/><msg @l="126" char_id="0" frame_id="-1" name="美帆" text="『玩物……什么的。』"   voices="miho08910"/><msg @l="128" char_id="-1" frame_id="-1" name="朽木"   text="『拒绝成为我的情人的你，我认为用仅仅满足性欲的“玩物”这个词最为适合。』" voices=""/><msg @l="130" char_id="0" frame_id="-1" name="美帆"   text="『趁人弱点…折磨人…太过分了…』" voices="miho08920"/><msg @l="132" char_id="-1" frame_id="-1" name="朽木"   text="『我就把这当作称赞收下了。』" voices=""/><msg @l="134" char_id="0" frame_id="-1" name="美帆" text="『…』"   voices="miho08930"/><msg @l="136" char_id="-1" frame_id="-1" name="朽木"   text="『那么，今天也让我的消遣玩物来处理一下性欲吧。』" voices=""/><wait_chgmv/><ev @l="139" src="ev-005ax2y1"/><bgm @l="142" src="bgm14" volume="1."/><msg @l="144" char_id="0" frame_id="-1" name="美帆" text="『嗯…』"   voices="miho08940"/><msg @l="146" char_id="-1" frame_id="-1" name=""   text="隔着衣服，教授的手揉捏着我的胸部，像是要将乳房向上托起般抚摸着。" voices=""/><msg @l="147" char_id="-1" frame_id="-1" name="朽木"   text="『哦呀，今天看来你穿了内衣啊。』" voices=""/><msg @l="149" char_id="0" frame_id="-1" name="美帆"   text="『昨天…您没有说什么，所以…』" voices="miho08950"/><msg @l="151" char_id="-1" frame_id="-1" name="朽木" text="『原来如此，确实如你所说。』"   voices=""/><msg @l="153" char_id="-1" frame_id="-1" name=""   text="教授故作惊讶地表示赞同，同时揉捏胸部的手加大了力度，五指用力地揉搓着。" voices=""/><msg @l="155" char_id="0" frame_id="-1" name="美帆" text="『呃啊……。』"   voices="miho08960"/><msg @l="157" char_id="-1" frame_id="-1" name=""   text="胸部传来被压碎般的疼痛……我皱起了眉头。" voices=""/><msg @l="159" char_id="-1" frame_id="-1" name="朽木"   text="『最好不要说太多放肆的话。除非你连人生都想一起舍弃。』" voices=""/><msg @l="161" char_id="0" frame_id="-1" name="美帆" text="『……。』"   voices="miho08970"/><msg @l="163" char_id="-1" frame_id="-1" name="朽木"   text="『呵呵，对了……这样默默地颤抖着才最适合你。』" voices=""/><msg @l="165" char_id="0" frame_id="-1" name="美帆" text="『呜……。』"   voices="miho08980"/><msg @l="167" char_id="-1" frame_id="-1" name="朽木"   text="『很不甘心吧？但真正的屈辱才刚刚开始哦？』" voices=""/><msg @l="169" char_id="-1" frame_id="-1" name=""   text="说着，教授将手放在我的肩膀上，用力一按。" voices=""/><msg @l="171" char_id="0" frame_id="-1" name="美帆" text="『诶，要做什么……？』"   voices="miho08990"/><msg @l="173" char_id="-1" frame_id="-1" name="朽木"   text="『你只需默默服从就好。对吧？』" voices=""/><msg @l="175" char_id="0" frame_id="-1" name="美帆" text="『……。』"   voices="miho09000"/><clear @l="178" class="all"/><label @l="181" id="event_scene10"/><goto @l="183" cond="!(f.flagInExtraMode&#32;&gt;&#32;100)&#13;&#10;"   label="TempLabel_198"/><bgm @l="185" src="bgm14" volume="1."/><label @l="186" id="TempLabel_198"/><label @l="189" id="chart_line45"/><wait_chgmv/><ev @l="192" src="ev-010a"/><description @l="195" text="车内服侍"/><msg @l="197" char_id="-1" frame_id="-1" name="" text="我……被强行按坐在电车的地板上。"   voices=""/><msg @l="198" char_id="-1" frame_id="-1" name=""   text="冰冷的地板触感传到臀部，让我感到有些不舒服。" voices=""/><msg @l="200" char_id="-1" frame_id="-1" name="朽木"   text="『看来我必须让你更清楚地认识到自己的立场啊。』" voices=""/><msg @l="202" char_id="0" frame_id="-1" name="美帆" text="『你、你要做什么……。』"   voices="miho09010"/><msg @l="204" char_id="-1" frame_id="-1" name=""   text="教授嘴角微微上扬，手指搭在裤子的拉链上慢慢拉下。" voices=""/><wait_chgmv/><ev @l="207" src="ev-010a"/><msg @l="209" char_id="-1" frame_id="-1" name="朽木" text="『舔吧。』"   voices=""/><msg @l="211" char_id="0" frame_id="-1" name="美帆" text="『啊……。』"   voices="miho09020"/><msg @l="213" char_id="-1" frame_id="-1" name="朽木"   text="『舔我的东西。用你的嘴来服侍我。』" voices=""/><msg @l="215" char_id="0" frame_id="-1" name="美帆" text="『这种事……。』"   voices="miho09030"/><msg @l="217" char_id="-1" frame_id="-1" name="朽木"   text="『如果做不到的话，你父亲就会毁灭，仅此而已。』" voices=""/><msg @l="219" char_id="0" frame_id="-1" name="美帆" text="『……唔……。』"   voices="miho09040"/><msg @l="221" char_id="-1" frame_id="-1" name="朽木"   text="『我说过了吧，要让你明白自己的立场。』" voices=""/><msg @l="223" char_id="0" frame_id="-1" name="美帆"   text="『可是……周围有人……。』" voices="miho09050"/><msg @l="225" char_id="-1" frame_id="-1" name="朽木"   text="『我们周围的人都是我的熟人，只要他们在外面守着，就不用担心被其他人看到。』" voices=""/><msg @l="227" char_id="0" frame_id="-1" name="美帆" text="『怎么会……。』"   voices="miho09060"/><msg @l="229" char_id="-1" frame_id="-1" name="朽木"   text="『你没有拒绝的权利……别废话了，快含进去。』" voices=""/><msg @l="231" char_id="-1" frame_id="-1" name=""   text="说着，朽木教授将自己的东西凑近我的脸。" voices=""/><msg @l="233" char_id="0" frame_id="-1" name="美帆" text="『………。』"   voices="miho09070"/><msg @l="235" char_id="-1" frame_id="-1" name="" text="我……把目光移开了。" voices=""/><msg @l="236" char_id="-1" frame_id="-1" name=""   text="我对那极其丑陋的欲望之物感到一阵厌恶。" voices=""/><msg @l="237" char_id="-1" frame_id="-1" name=""   text="更何况，我的处女之身已经被这胯下的恶魔夺走了。" voices=""/><msg @l="239" char_id="-1" frame_id="-1" name="朽木"   text="『怎么了？如果不快点含进去的话，我可不管你父亲会变成什么样……。』" voices=""/><msg @l="241" char_id="0" frame_id="-1" name="美帆" text="『……唔……。』"   voices="miho01620"/><msg @l="243" char_id="-1" frame_id="-1" name="" text="我明白这根本不需要考虑。"   voices=""/><msg @l="244" char_id="-1" frame_id="-1" name=""   text="我没有立场对他反抗。" voices=""/><msg @l="246" char_id="0" frame_id="-1" name="美帆" text="『我知道……了……。』"   voices="miho09080"/><msg @l="248" char_id="-1" frame_id="-1" name=""   text="于是我……像是从喉咙深处挤出来一般，这样回答着。" voices=""/><clear @l="251" class="all"/><msg @l="253" char_id="0" frame_id="-1" name="美帆" text="『嗯……。』"   voices="miho09090"/><msg @l="255" char_id="-1" frame_id="-1" name="" text="我鼓起勇气伸出舌尖轻轻地舔了一下。"   voices=""/><msg @l="256" char_id="-1" frame_id="-1" name=""   text="舌尖触碰到的瞬间……那种奇怪的触感，让我不由自主地缩回了舌头。" voices=""/><msg @l="257" char_id="-1" frame_id="-1" name=""   text="我对那极其丑陋的欲望之物感到一阵厌恶。" voices=""/><msg @l="259" char_id="-1" frame_id="-1" name="朽木" text="『怎么了？快点含进去。』"   voices=""/><msg @l="261" char_id="0" frame_id="-1" name="美帆" text="『………。』"   voices="miho09100"/><wait_chgmv/><ev @l="264" src="ev-010bx1y1"/><msg @l="266" char_id="0" frame_id="-1" name="美帆" text="『嗯，咕……。』"   voices="miho09110"/><msg @l="268" char_id="-1" frame_id="-1" name="" text="下定决心，我将前端含入口中。"   voices=""/><msg @l="269" char_id="-1" frame_id="-1" name=""   text="那茎部有着柔软的表面，而顶端像毒蘑菇一样闪闪发光的奇怪东西，滑入了我的口腔。"   voices=""/><msg @l="271" char_id="0" frame_id="-1" name="美帆" text="（啊……好奇怪的味道…………）"   voices="miho09120"/><msg @l="273" char_id="-1" frame_id="-1" name=""   text="首先……那种在整个口腔中蔓延的带有苦味的独特味道让我感到恶心。" voices=""/><msg @l="274" char_id="-1" frame_id="-1" name="" text="然后那刺激鼻腔的体味……"   voices=""/><msg @l="275" char_id="-1" frame_id="-1" name=""   text="我因这两种感受而扭曲表情，皱紧了眉头。" voices=""/><msg @l="277" char_id="-1" frame_id="-1" name="朽木" text="『我的东西很美味吧？』"   voices=""/><msg @l="279" char_id="0" frame_id="-1" name="美帆" text="『………。』"   voices="miho09130"/><msg @l="281" char_id="-1" frame_id="-1" name="朽木" text="『很美味吧？』"   voices=""/><msg @l="283" char_id="0" frame_id="-1" name="美帆" text="『好、好吃……的。』"   voices="miho09140//咥えながら"/><msg @l="285" char_id="-1" frame_id="-1" name="朽木"   text="『那就好。好好品尝吧。』" voices=""/><msg @l="287" char_id="0" frame_id="-1" name="美帆" text="『嗯……。』"   voices="miho09150"/><msg @l="289" char_id="-1" frame_id="-1" name=""   text="我顺从他的话，慢慢地用舌头舔舐口中的硬物。" voices=""/><msg @l="290" char_id="-1" frame_id="-1" name=""   text="然而，口腔大部分都被教授的那东西占据了，根本无法自如地活动舌头。" voices=""/><msg @l="291" char_id="-1" frame_id="-1" name=""   text="这是我第一次做这种事……没办法……。" voices=""/><msg @l="293" char_id="-1" frame_id="-1" name="朽木" text="『做得不好啊。』"   voices=""/><wait_chgmv/><ev @l="296" src="ev-010a"/><msg @l="298" char_id="0" frame_id="-1" name="美帆"   text="『嗯啊……就算你那么说……。』" voices="miho09160"/><msg @l="300" char_id="0" frame_id="-1" name="美帆"   text="『这种事，我还是第一次做……。』" voices="miho09170"/><msg @l="302" char_id="-1" frame_id="-1" name=""   text="对没有经验的我来说，把排尿的器官含在嘴里这种行为除了厌恶感之外别无他物。" voices=""/><msg @l="304" char_id="-1" frame_id="-1" name="朽木"   text="『原来如此，说起来你直到前几天还是处女呢。呵呵呵……。』" voices=""/><msg @l="306" char_id="-1" frame_id="-1" name="" text="教授这样说着，故意地笑了起来。"   voices=""/><msg @l="308" char_id="0" frame_id="-1" name="美帆" text="『……。』"   voices="miho09180"/><msg @l="310" char_id="-1" frame_id="-1" name="朽木"   text="『按照我说的做吧。我来教你如何取悦男人。』" voices=""/><msg @l="312" char_id="0" frame_id="-1" name="美帆" text="『……是。』"   voices="miho09190"/><msg @l="314" char_id="-1" frame_id="-1" name=""   text="我小声地回答了他的话……悲伤的泪水在眼角积聚。" voices=""/><msg @l="315" char_id="-1" frame_id="-1" name="" text="好想大声哭出来。" voices=""/><msg @l="316" char_id="-1" frame_id="-1" name="" text="但是，即使我哭了，他也不会原谅我。"   voices=""/><msg @l="317" char_id="-1" frame_id="-1" name=""   text="除了听从朽木教授的指示，我别无选择。" voices=""/><msg @l="319" char_id="-1" frame_id="-1" name="朽木"   text="『首先，用嘴唇含住顶端部分，同时用舌尖涂上唾液。』" voices=""/><msg @l="321" char_id="0" frame_id="-1" name="美帆" text="『是这样吗……？』"   voices="miho09200"/><wait_chgmv/><ev @l="324" src="ev-010bx1y1"/><msg @l="326" char_id="0" frame_id="-1" name="美帆"   text="『嗯……唔……舔，舔……。』" voices="miho09210"/><msg @l="328" char_id="-1" frame_id="-1" name=""   text="我用嘴唇滑动着含住肉茎，舌尖爬过龟头。" voices=""/><msg @l="329" char_id="-1" frame_id="-1" name=""   text="面对不熟悉的味道和气味，厌恶感果然膨胀起来……但我不能吐出来，只能拼命地吮吸。" voices=""/><msg @l="331" char_id="-1" frame_id="-1" name="朽木"   text="『没错……充分涂上唾液后，紧闭嘴唇前后摇动头部，将唾液涂满整根肉棒。』" voices=""/><msg @l="333" char_id="0" frame_id="-1" name="美帆"   text="『呼、唔啊……嗯，呜咕……呜……呜……』" voices="miho09220"/><msg @l="335" char_id="-1" frame_id="-1" name=""   text="笨拙地……我紧闭嘴唇前后摇动着头。" voices=""/><msg @l="337" char_id="0" frame_id="-1" name="美帆"   text="『呜……呜姆……呜咕，嗯，呜呜……』" voices="miho09230"/><wait_chgmv/><ev @l="339" src="ev-010a"/><msg @l="341" char_id="0" frame_id="-1" name="美帆"   text="『咳咳……咳咳咳……唔，啊……咳啊。』" voices="miho09240"/><msg @l="342" char_id="-1" frame_id="-1" name=""   text="有时候，我控制不好力度，龟头深入喉咙深处……令我呛到。" voices=""/><msg @l="343" char_id="-1" frame_id="-1" name=""   text="尽管如此，教授仍用冷漠的目光看着我，立即让我重新含住肉棒。" voices=""/><wait_chgmv/><ev @l="346" src="ev-010bx1y1"/><msg @l="348" char_id="0" frame_id="-1" name="美帆" text="『呜咕……』"   voices="miho09250"/><msg @l="350" char_id="-1" frame_id="-1" name="朽木"   text="『如果不能深入摇动头部，就在口中积聚唾液，浅浅地摇晃同时用舌尖舔龟头，这样就不会顶到喉咙深处。』" voices=""/><msg @l="352" char_id="0" frame_id="-1" name="美帆" text="『……』"   voices="miho09260"/><msg @l="354" char_id="0" frame_id="-1" name="美帆" text="『呜……嗯，呜噗……』"   voices="miho09270"/><msg @l="356" char_id="-1" frame_id="-1" name=""   text="按照指示，我在口中积聚唾液，轻轻地移动头部。" voices=""/><msg @l="358" char_id="0" frame_id="-1" name="美帆"   text="『嗯，嗯嗯……啧，嗯，咕……。』" voices="miho09280"/><msg @l="360" char_id="-1" frame_id="-1" name=""   text="每次浅浅律动，我的嘴边都漏出咕叽咕叽的水声。" voices=""/><msg @l="361" char_id="-1" frame_id="-1" name=""   text="那声音异常淫靡……我羞耻得身体颤抖。" voices=""/><msg @l="363" char_id="-1" frame_id="-1" name="朽木" text="『看来你已经相当上手了啊。』"   voices=""/><msg @l="365" char_id="-1" frame_id="-1" name=""   text="教授满意地低语，按住我的头，开始按自己喜欢的方式摆动腰部。" voices=""/><msg @l="367" char_id="0" frame_id="-1" name="美帆"   text="『咕……嗯，啧……嗯……嗯嗯……。』" voices="miho09290"/><msg @l="369" char_id="0" frame_id="-1" name="美帆" text="（为什么我………）"   voices="miho09300"/><msg @l="371" char_id="0" frame_id="-1" name="美帆"   text="（在满员电车里……周围有那么多人，却这样）" voices="miho09310"/><msg @l="373" char_id="-1" frame_id="-1" name="朽木"   text="『怎么了，舌头停止动作了吗？』" voices=""/><msg @l="375" char_id="0" frame_id="-1" name="美帆"   text="『嗯嗯……啧，嗯，咕……啧啧。』" voices="miho09320"/><msg @l="377" char_id="-1" frame_id="-1" name=""   text="头部被按住……我拼命地活动舌头。" voices=""/><msg @l="378" char_id="-1" frame_id="-1" name=""   text="哪里会感觉舒服，该怎么做……这些事情我都不明白。" voices=""/><msg @l="379" char_id="-1" frame_id="-1" name=""   text="只是一心想从眼前的痛苦中解脱，我用嘴唇摩擦，舌头发出湿漉漉的声音不停舔舐。" voices=""/><msg @l="381" char_id="0" frame_id="-1" name="美帆"   text="『啧……嗯，嗯呜……嗯呜………嗯……嗯呼。』" voices="miho09330"/><msg @l="383" char_id="0" frame_id="-1" name="美帆"   text="『嗯，嗯，嗯……嗯呜……啧，嗯，啧啧……。』" voices="miho09340"/><msg @l="385" char_id="-1" frame_id="-1" name="朽木"   text="『很好，就保持这个节奏继续……你学得真快啊。』" voices=""/><msg @l="387" char_id="-1" frame_id="-1" name=""   text="这种事被表扬了也一点都不开心。" voices=""/><msg @l="389" char_id="0" frame_id="-1" name="美帆" text="『嗯嗯……嗯，啧。』"   voices="miho09350"/><msg @l="391" char_id="-1" frame_id="-1" name="朽木"   text="『啊……就这样，一边吸着前端一边活动舌头。』" voices=""/><msg @l="393" char_id="0" frame_id="-1" name="美帆"   text="『嗯……啾噗，嗯嗯………啾噗，啾噜噜………。』" voices="miho09360"/><msg @l="395" char_id="0" frame_id="-1" name="美帆"   text="（呜啊……有什么，苦的东西出来了…………）" voices="miho09370"/><msg @l="397" char_id="-1" frame_id="-1" name=""   text="我虽然因口中蔓延的奇怪苦味而扭曲了表情，但仍然努力地吸吮着前端，同时用舌头舔弄着肉茎。" voices=""/><msg @l="398" char_id="-1" frame_id="-1" name=""   text="自从那带苦味的液体开始渗出后，口中的热棒每次被舌尖舔过都会抽动跳动……变得更加坚硬，体味也增强了。"   voices=""/><msg @l="400" char_id="0" frame_id="-1" name="美帆"   text="『嗯，嗯咕………嗯噗……嗯噗…………嗯，啾噜噜。』" voices="miho09380"/><msg @l="402" char_id="-1" frame_id="-1" name="朽木" text="『咕……。』" voices=""/><msg @l="404" char_id="-1" frame_id="-1" name=""   text="在我轻轻吸吮前端的瞬间，教授小声呻吟着，腰部微微颤抖。" voices=""/><msg @l="407" async="true" char_id="-1" frame_id="-1" name=""   text="要射在哪里……？" voices=""/><select @l="408"><menu @l="411" label="EventLabel_126" text="口中"/><menu @l="414" label="EventLabel_127" text="脸上"/></select><label @l="420" id="EventLabel_126"/><flash @l="423" count="4" fade="100" image="white"/><wait_chgmv/><ev @l="426" src="ev-010bx1y1z1"/><msg @l="428" char_id="0" frame_id="-1" name="美帆" text="『唔呜！？』"   voices="miho09390"/><msg @l="430" char_id="-1" frame_id="-1" name=""   text="突然肉棒整体猛地跳动了一下，大量热液涌入我的口腔。" voices=""/><msg @l="432" char_id="-1" frame_id="-1" name="朽木"   text="『要紧闭嘴唇，不要漏出来。』" voices=""/><msg @l="434" char_id="0" frame_id="-1" name="美帆" text="『呜呜，唔嗯！？』"   voices="miho09400"/><msg @l="436" char_id="-1" frame_id="-1" name=""   text="头部被按住无法移开嘴巴，那液体不断地涌入我的口中。" voices=""/><msg @l="437" char_id="-1" frame_id="-1" name=""   text="那股令人头晕的腥味液体是精液……即使是我也立刻明白了这一点。" voices=""/><msg @l="439" char_id="0" frame_id="-1" name="美帆"   text="（不……这种东西，居然吐在嘴里…………）" voices="miho09410"/><msg @l="441" char_id="-1" frame_id="-1" name=""   text="虽然对口中溢满的液体感到困惑和厌恶，但我还是按照命令拼命地紧闭嘴唇，不让它漏出来。"   voices=""/><msg @l="443" char_id="0" frame_id="-1" name="美帆" text="『唔……呜呜……。』"   voices="miho09420"/><msg @l="445" char_id="-1" frame_id="-1" name=""   text="终于……肉棒的跳动平息下来，喷涌而出的精液也逐渐停止了。" voices=""/><msg @l="446" char_id="-1" frame_id="-1" name=""   text="即使这样我的头还是被按住不放……我喉咙发出呜咽声，急切地想要吐出几近溢满口腔的精液。" voices=""/><msg @l="448" char_id="-1" frame_id="-1" name="朽木" text="『咽下去。』" voices=""/><msg @l="450" char_id="0" frame_id="-1" name="美帆" text="『……！？』"   voices="miho09430"/><msg @l="452" char_id="-1" frame_id="-1" name="朽木"   text="『没听见吗？全部，给我咽下去。』" voices=""/><msg @l="454" char_id="0" frame_id="-1" name="美帆" text="『唔唔——！！』"   voices="miho09440"/><msg @l="456" char_id="-1" frame_id="-1" name=""   text="我的嘴巴还被迫含着它，无力地摇着头。" voices=""/><msg @l="458" char_id="-1" frame_id="-1" name="朽木"   text="『我只再说一次，咽下去。』" voices=""/><msg @l="460" char_id="-1" frame_id="-1" name=""   text="朽木教授直视着我，嘴角邪恶地扭曲着。" voices=""/><msg @l="462" char_id="0" frame_id="-1" name="美帆" text="『………。』"   voices="miho09450"/><msg @l="464" char_id="0" frame_id="-1" name="美帆" text="『……咕。』"   voices="miho09460"/><msg @l="466" char_id="0" frame_id="-1" name="美帆"   text="『呃咕……呃、呃咕……呃咕……呃咕、呃咕……。』" voices="miho09470"/><msg @l="468" char_id="-1" frame_id="-1" name="" text="我拼命地吞咽着口中的那东西。"   voices=""/><msg @l="469" char_id="-1" frame_id="-1" name=""   text="粘稠的精液缠绕在喉咙里非常难以下咽，我眼含泪水，中途多次停顿休息，才将所有液体送入体内。" voices=""/><goto @l="472" label="EventLabel_128"/><label @l="476" id="EventLabel_127"/><flash @l="479" count="4" fade="100" image="white"/><wait_chgmv/><ev @l="482" src="ev-010bx1y1z2"/><msg @l="484" char_id="0" frame_id="-1" name="美帆" text="『呃哈啊！？』"   voices="miho09480"/><msg @l="486" char_id="-1" frame_id="-1" name=""   text="突然间阴茎从我口腔中拔出，随即在我正前方，龟头格外胀大，大量白浊色的液体喷射而出，洒在我的脸上。"   voices=""/><msg @l="488" char_id="0" frame_id="-1" name="美帆" text="『呜呜呜！！』"   voices="miho09490"/><msg @l="490" char_id="-1" frame_id="-1" name=""   text="我不由自主地闭上眼睛，试图扭开脸。" voices=""/><msg @l="491" char_id="-1" frame_id="-1" name=""   text="但是，头被紧紧地按住，无法逃脱。" voices=""/><msg @l="493" char_id="-1" frame_id="-1" name="朽木" text="『还没结束呢。』"   voices=""/><msg @l="495" char_id="-1" frame_id="-1" name=""   text="教授说着将前端抵在我的脸颊上，把仍在溢出的白浊液体涂抹在上面。" voices=""/><msg @l="497" char_id="0" frame_id="-1" name="美帆" text="『呜啊……。』"   voices="miho09500"/><msg @l="499" char_id="-1" frame_id="-1" name=""   text="感受到抵在脸颊上的前端触感以及洒在脸上的那股腥臭精液的触感，我不禁露出厌恶的表情，发出了声音。" voices=""/><msg @l="500" char_id="-1" frame_id="-1" name="" text="肉棒和液体……都非常热。"   voices=""/><msg @l="502" char_id="-1" frame_id="-1" name="朽木"   text="『呵呵，这样子真不错……确实很适合你。』" voices=""/><msg @l="504" char_id="-1" frame_id="-1" name=""   text="教授俯视着满脸白浊液体的我，满意地笑着。" voices=""/><msg @l="505" char_id="-1" frame_id="-1" name=""   text="我脸上沾满精液，剧烈地喘着气，一时愣住了。" voices=""/><msg @l="507" char_id="0" frame_id="-1" name="美帆"   text="（又……被玷污了…………）" voices="miho09510"/><label @l="511" id="EventLabel_128"/><clear @l="515" class="all"/><end_scene @l="518"/><label @l="520" id="event_scene51"/><goto @l="522" cond="!(f.flagInExtraMode&#32;&gt;&#32;100)&#13;&#10;"   label="TempLabel_199"/><bgm @l="524" src="bgm14" volume="1."/><label @l="525" id="TempLabel_199"/><msg @l="527" char_id="-1" frame_id="-1" name="朽木"   text="『不，这次口交比我想象的还要棒。』" voices=""/><msg @l="529" char_id="-1" frame_id="-1" name=""   text="朽木教授一边把满足后的那物收回裤子里，一边愉快地说道。" voices=""/><msg @l="531" char_id="-1" frame_id="-1" name="朽木"   text="『如此美妙的口交只让我一人享用有些可惜啊。』" voices=""/><msg @l="533" char_id="-1" frame_id="-1" name="朽木"   text="『来，你们也让她给你们口吧。』" voices=""/><msg @l="535" char_id="0" frame_id="-1" name="美帆" text="『诶……。』"   voices="miho09520"/><msg @l="537" char_id="-1" frame_id="-1" name=""   text="当我还在发愣试图站起来时，朽木教授的手抓住了我的肩膀，强行让我再次坐下。" voices=""/><msg @l="539" char_id="-1" frame_id="-1" name="跑龙套的男子A" text="『啊，可以吗？』"   voices=""/><msg @l="541" char_id="-1" frame_id="-1" name="跑龙套的男子B" text="『那就恭敬不如从命了！』"   voices=""/><msg @l="543" char_id="0" frame_id="-1" name="美帆" text="『这、这种事……。』"   voices="miho09530"/><msg @l="545" char_id="-1" frame_id="-1" name="朽木"   text="『这也是我们之间契约的一部分……有什么问题吗？』" voices=""/><msg @l="547" char_id="0" frame_id="-1" name="美帆" text="『………。』"   voices="miho09540"/><msg @l="549" char_id="0" frame_id="-1" name="美帆" text="『我明……白了。』"   voices="miho09550"/><msg @l="551" char_id="-1" frame_id="-1" name=""   text="我简短地回答道……然后再次向两位龙套人员急不可耐地从裤子里掏出的阳具伸出舌尖。" voices=""/><msg @l="553" char_id="-1" frame_id="-1" name="跑龙套的男子A" text="『哦……等等，在那之前。』"   voices=""/><msg @l="555" char_id="0" frame_id="-1" name="美帆" text="『……？』"   voices="miho09560"/><msg @l="557" char_id="-1" frame_id="-1" name="跑龙套的男子A"   text="『让我们先营造一下气氛吧。』" voices=""/><msg @l="559" char_id="-1" frame_id="-1" name=""   text="男人说着，将手伸向我的衬衫下摆，一把掀到了胸部的位置。" voices=""/><msg @l="561" char_id="0" frame_id="-1" name="美帆" text="『啊……。』"   voices="miho09570"/><msg @l="563" char_id="-1" frame_id="-1" name=""   text="我短促地发出声音……但我不被允许反抗。" voices=""/><msg @l="564" char_id="-1" frame_id="-1" name=""   text="随后男人又拉开了我的胸罩，完全露出了我的胸部，开始用手掌揉捏起来。" voices=""/><msg @l="566" char_id="-1" frame_id="-1" name="跑龙套的男子A"   text="『只让我们享受服务太不公平了。作为回报，我们也来揉揉让你舒服舒服。』" voices=""/><msg @l="568" char_id="-1" frame_id="-1" name="跑龙套的男子B"   text="『那么，好好含住啊。』" voices=""/><msg @l="570" char_id="-1" frame_id="-1" name=""   text="男人说完邪笑一声……将前端凑到了我的嘴边。" voices=""/><msg @l="572" char_id="0" frame_id="-1" name="美帆" text="『……。』"   voices="miho09580"/><msg @l="574" char_id="-1" frame_id="-1" name=""   text="我再一次……将舌尖伸向了龟头。" voices=""/><clear @l="577" class="all"/><msgshow @l="580" show="true"/><label @l="583" id="chart_line46"/><wait_chgmv/><ev @l="586" src="ev-051"/><description @l="589" text="公然奉仕奴隷"/><msg @l="591" char_id="0" frame_id="-1" name="美帆" text="『嗯呼……。』"   voices="miho09590"/><msg @l="593" char_id="-1" frame_id="-1" name=""   text="我一边漏出喘息，一边缓缓用舌头舔舐着前端。" voices=""/><msg @l="594" char_id="-1" frame_id="-1" name=""   text="果然有着独特的气味和味道，让人涌起厌恶感，但我不能停下来。" voices=""/><msg @l="596" char_id="-1" frame_id="-1" name="跑龙套的男子A"   text="『嘿、嘿嘿……没想到能被口交啊。』" voices=""/><msg @l="598" char_id="-1" frame_id="-1" name="跑龙套的男子B"   text="『哦，这就是所谓的龙套福利吧？』" voices=""/><msg @l="600" char_id="0" frame_id="-1" name="美帆" text="『……。』"   voices="miho09600"/><msg @l="602" char_id="-1" frame_id="-1" name=""   text="男人们一边随意地嘀咕着，一边咯咯地笑着。" voices=""/><msg @l="603" char_id="-1" frame_id="-1" name=""   text="我虽然为自己只能任凭他们摆布而感到悲伤，但还是无法反抗，只能继续动着舌尖。" voices=""/><msg @l="605" char_id="0" frame_id="-1" name="美帆"   text="『嗯……嗯嗯…………啾噜……啾噜……。』" voices="miho09610"/><msg @l="607" char_id="-1" frame_id="-1" name=""   text="按照刚才教导的方式，涂上唾液，用嘴唇延展开。" voices=""/><msg @l="609" char_id="-1" frame_id="-1" name="跑龙套的男子A"   text="『哦……不错嘛，不愧是朽木先生亲自传授的。』" voices=""/><msg @l="611" char_id="-1" frame_id="-1" name="跑龙套的男子B"   text="『舔那边的时候，这边用手帮我弄弄吧。』" voices=""/><msg @l="613" char_id="-1" frame_id="-1" name=""   text="男人的手覆在我握住肉棒的手上，来回粗暴地摩擦着。" voices=""/><msg @l="614" char_id="-1" frame_id="-1" name=""   text="就这样像是指导一般动作了一会后，那男人松开了手，仿佛在说现在该你自己来了。" voices=""/><msg @l="616" char_id="0" frame_id="-1" name="美帆" text="『嗯唔……。』"   voices="miho09620"/><msg @l="618" char_id="-1" frame_id="-1" name=""   text="怀着一丝犹豫，我开始缓缓地活动手指。" voices=""/><msg @l="620" char_id="-1" frame_id="-1" name="跑龙套的男子B"   text="『对对，再握紧一点。』" voices=""/><msg @l="622" char_id="0" frame_id="-1" name="美帆" text="『嗯……嗯……。』"   voices="miho09630"/><msg @l="624" char_id="-1" frame_id="-1" name=""   text="我握紧那热烫的东西，开始套弄。" voices=""/><msg @l="625" char_id="-1" frame_id="-1" name=""   text="龟头部分的凹凸触感让我感到……有些奇怪。" voices=""/><msg @l="627" char_id="-1" frame_id="-1" name="跑龙套的男子A"   text="『喂，别只顾着用手啊，好好地舔一舔。』" voices=""/><msg @l="629" char_id="0" frame_id="-1" name="美帆"   text="『嗯嗯……嗯……啾……嗯，啾啾。』" voices="miho09640"/><msg @l="631" char_id="-1" frame_id="-1" name="跑龙套的男子B"   text="『啊……你的手真柔软，太棒了。』" voices=""/><msg @l="633" char_id="-1" frame_id="-1" name="跑龙套的男子A"   text="『这边的舌头动作也挺不错的。真难相信这只是你第二次做呢。』" voices=""/><msg @l="635" char_id="0" frame_id="-1" name="美帆"   text="『嗯噗，嗯噗，嗯噗……嗯，啾，啾噜……。』" voices="miho09650"/><msg @l="637" char_id="-1" frame_id="-1" name="跑龙套的男子A"   text="『哦……那个吸的动作，多来一点。』" voices=""/><msg @l="639" char_id="0" frame_id="-1" name="美帆"   text="『嗯……吮……啾，嗯……啾噜，啾噜噜。』" voices="miho09660"/><msg @l="641" char_id="-1" frame_id="-1" name="跑龙套的男子A" text="『对对，就是这样，很好……。』"   voices=""/><msg @l="643" char_id="-1" frame_id="-1" name=""   text="按照男人们的指示，我用嘴唇和舌头爱抚着那勃起的东西。" voices=""/><msg @l="644" char_id="-1" frame_id="-1" name=""   text="直到刚才我还对这些一无所知，现在却已经能熟练地取悦男人。" voices=""/><msg @l="645" char_id="-1" frame_id="-1" name="" text="想到这里……我感到悲伤。"   voices=""/><msg @l="647" char_id="0" frame_id="-1" name="美帆"   text="『嗯，嗯嗯……啾，啾，啾……。』" voices="miho09670"/><msg @l="649" char_id="-1" frame_id="-1" name=""   text="为了让男人们尽快射出来，我用嘴唇紧紧夹住那东西不停地上下套弄。" voices=""/><msg @l="651" char_id="-1" frame_id="-1" name="跑龙套的男子B"   text="『现在也帮我舔一舔吧。』" voices=""/><msg @l="653" char_id="-1" frame_id="-1" name=""   text="那个之前让我用手套弄的男人，一边用前端摩擦着我的脸颊一边说道。" voices=""/><msg @l="655" char_id="0" frame_id="-1" name="美帆" text="『嗯……啊，唔。』"   voices="miho09680"/><msg @l="657" char_id="0" frame_id="-1" name="美帆"   text="『嗯呼……嗯，啾……啾，啾。』" voices="miho09690"/><msg @l="659" char_id="-1" frame_id="-1" name="" text="我没有犹豫。" voices=""/><msg @l="660" char_id="-1" frame_id="-1" name=""   text="我含住了顶在我脸上的龟头，慢慢地用舌尖缠绕着它。" voices=""/><msg @l="662" char_id="0" frame_id="-1" name="美帆"   text="『啾，啾噗……嗯，嗯噗……嗯，嗯噗……。』" voices="miho09700"/><msg @l="664" char_id="0" frame_id="-1" name="美帆"   text="『嗯噗……啾噗，啾噗，啾噗……嗯，啾噜。』" voices="miho09710"/><msg @l="666" char_id="-1" frame_id="-1" name=""   text="然后……像之前那样吮吸着铃口，用舌头舔舐着冠状部分。" voices=""/><msg @l="668" char_id="-1" frame_id="-1" name="跑龙套的男子B"   text="『嘿嘿，舔得真香啊。』" voices=""/><msg @l="670" char_id="-1" frame_id="-1" name="跑龙套的男子A"   text="『是不是已经上瘾了？』" voices=""/><msg @l="672" char_id="-1" frame_id="-1" name=""   text="一边这么说着，最先让我含住的那个男人抓住我的手，让我套弄着柱身部分。" voices=""/><msg @l="673" char_id="-1" frame_id="-1" name=""   text="沾满了我唾液的那个东西，每次套弄都发出咕啾咕啾的淫靡声音。" voices=""/><msg @l="675" char_id="-1" frame_id="-1" name="跑龙套的男子A"   text="『哦哦……口交也不错，但这个也很棒啊。』" voices=""/><msg @l="677" char_id="-1" frame_id="-1" name="跑龙套的男子B"   text="『是啊。手活和口交都是满分。』" voices=""/><msg @l="679" char_id="-1" frame_id="-1" name="" text="男人们一脸陶醉地说道。"   voices=""/><msg @l="680" char_id="-1" frame_id="-1" name=""   text="我没有去理会他们的话语，只是专心地吮吸着。" voices=""/><msg @l="681" char_id="-1" frame_id="-1" name=""   text="必须让他们射出来……只有这个念头，在驱使着我。" voices=""/><msg @l="683" char_id="0" frame_id="-1" name="美帆"   text="『嗯唔……嗯，嗯嗯……啾噗，啾噗噗噗。』" voices="miho09720"/><msg @l="685" char_id="0" frame_id="-1" name="美帆"   text="『啾噗，啾噗，啾噗……嗯，嗯咕……啾噜噜。』" voices="miho09730"/><msg @l="687" char_id="-1" frame_id="-1" name="跑龙套的男子B"   text="『啊啊，就这样含着龟头继续动舌头。』" voices=""/><msg @l="689" char_id="0" frame_id="-1" name="美帆"   text="『嗯嗯……啾噗，啾噗，啾噗，啾噗，啾噗。』" voices="miho09740"/><msg @l="691" char_id="0" frame_id="-1" name="美帆"   text="『嗯，啾噗……嗯……啾噜，嗯噗，啾噜噜噜。』" voices="miho09750"/><msg @l="693" char_id="-1" frame_id="-1" name="跑龙套的男子B"   text="『呜啊……太厉害了，感觉要被榨干了。』" voices=""/><msg @l="695" char_id="-1" frame_id="-1" name="跑龙套的男子A"   text="『啊……这边也快要射了。』" voices=""/><msg @l="697" char_id="0" frame_id="-1" name="美帆"   text="『嗯呜……嗯，嗯，嗯……嗯呼，嗯，啾噗噗。』" voices="miho09760"/><msg @l="699" char_id="0" frame_id="-1" name="美帆"   text="『嗯，啾噗……啾噗，啾噗，啾噗，嗯嗯，啾噜！！』" voices="miho09770"/><msg @l="701" char_id="-1" frame_id="-1" name="跑龙套的男子B" text="『呜……要，出来了！！』"   voices=""/><msg @l="703" char_id="-1" frame_id="-1" name="跑龙套的男子A" text="『我，我要射了！！』"   voices=""/><flash @l="706" count="4" fade="100" image="white"/><wait_chgmv/><ev @l="709" src="ev-051z1"/><msg @l="711" char_id="0" frame_id="-1" name="美帆" text="『嗯啊！！』"   voices="miho09780"/><msg @l="713" char_id="-1" frame_id="-1" name=""   text="左右两边，同时被浇上了滚烫的精液。" voices=""/><msg @l="714" char_id="-1" frame_id="-1" name=""   text="随着强劲的喷射……瞬间把我的脸弄得白浊一片。" voices=""/><msg @l="716" char_id="0" frame_id="-1" name="美帆" text="『哈……哈……哈……。』"   voices="miho09790"/><msg @l="718" char_id="-1" frame_id="-1" name="跑龙套的男子A"   text="『嘿嘿……太厉害了，射了不少啊。』" voices=""/><msg @l="720" char_id="-1" frame_id="-1" name="跑龙套的男子B"   text="『是啊，果然让可爱的女孩子来做就是不一样。』" voices=""/><msg @l="722" char_id="-1" frame_id="-1" name="跑龙套的男子A"   text="『好了，那么最后请帮我们清理一下。』" voices=""/><msg @l="724" char_id="0" frame_id="-1" name="美帆" text="『诶……。』"   voices="miho09800"/><msg @l="726" char_id="-1" frame_id="-1" name="跑龙套的男子B"   text="『就是要把里面残留的吸出来。这是理所当然的吧？』" voices=""/><msg @l="728" char_id="0" frame_id="-1" name="美帆" text="『……。』"   voices="miho09810"/><msg @l="730" char_id="-1" frame_id="-1" name="" text="我一脸困惑地看向朽木教授。"   voices=""/><msg @l="732" char_id="-1" frame_id="-1" name="朽木" text="『照他们说的做吧。』"   voices=""/><msg @l="734" char_id="0" frame_id="-1" name="美帆" text="『……是。』"   voices="miho09820"/><msg @l="736" char_id="0" frame_id="-1" name="美帆"   text="『嗯……嗯噗，啾噗……啾，啾呜呜呜。』" voices="miho09830"/><msg @l="738" char_id="-1" frame_id="-1" name=""   text="我再次含住男人们的龟头，吮吸残留的精液。" voices=""/><msg @l="739" char_id="-1" frame_id="-1" name=""   text="就这样……把口中渗出的液体吞咽下去。" voices=""/><msg @l="741" char_id="0" frame_id="-1" name="美帆" text="(已经……不能回去了吗……？)"   voices="miho09840"/><msg @l="743" char_id="0" frame_id="-1" name="美帆"   text="(回到原来的生活，回到那些快乐的时光……已经)" voices="miho09850"/><msg @l="745" char_id="-1" frame_id="-1" name=""   text="尽管喉咙里精液的触感几乎让我呛住，我还是继续吮吸着他们的肉棒。" voices=""/><stopse @l="748" buf="3"/><stopbgm @l="751" fadeout="1000"/><clear @l="754" class="all"/><end_scene @l="757"/><msgshow @l="760" show="true"/><wait_chgmv/><bg @l="763" src="bg08m2"/><bgm @l="766" src="bgm03" volume="1."/><char @l="769" id="miho" pos="auto" src="miho116"/><description @l="772" text="契約の日々・３日目"/><msg @l="774" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="776" char_id="-1" frame_id="-1" name=""   text="确认第一节课结束，进入休息时间后，我走进了讲堂。" voices=""/><msg @l="777" char_id="-1" frame_id="-1" name=""   text="那之后……我用纸巾擦掉脸上被浇的精液，然后不让人看见地跑进了校内的厕所。" voices=""/><msg @l="778" char_id="-1" frame_id="-1" name="" text="反复洗脸，反复漱口。"   voices=""/><msg @l="779" char_id="-1" frame_id="-1" name=""   text="沾在头发上的精液怎么也弄不掉……用纸巾擦掉后，只能一点一点地用水打湿再慢慢刮掉，这已经是我能做的极限了。"   voices=""/><msg @l="780" char_id="-1" frame_id="-1" name=""   text="毕竟一碰到水就会凝固，顽固地粘在上面。" voices=""/><msg @l="781" char_id="-1" frame_id="-1" name=""   text="就这样折腾着……结果，第一节课我完全没能去上。" voices=""/><msg @l="783" char_id="-1" frame_id="-1" name="声音" text="『咦，这不是美帆吗？』"   voices=""/><char @l="786" id="miho" pos="auto" src="miho014"/><msg @l="788" char_id="0" frame_id="-1" name="美帆" text="『啊……』" voices=""/><msg @l="790" char_id="-1" frame_id="-1" name=""   text="与站起身转过来的讲座朋友对上了眼神。" voices=""/><msg @l="791" char_id="-1" frame_id="-1" name="" text="有点……心虚。"   voices=""/><msg @l="793" char_id="-1" frame_id="-1" name="女性朋友" text="『怎么了，刚来吗？』"   voices=""/><char @l="796" id="miho" pos="auto" src="miho016"/><msg @l="798" char_id="0" frame_id="-1" name="美帆" text="『嗯、嗯……我翘了第一节课。』"   voices=""/><msg @l="800" char_id="-1" frame_id="-1" name="女性朋友"   text="『你竟然会翘课，真稀奇啊。』" voices=""/><char @l="803" id="miho" pos="auto" src="miho116"/><msg @l="805" char_id="0" frame_id="-1" name="美帆" text="『是、是吗？』" voices=""/><msg @l="807" char_id="-1" frame_id="-1" name="女性朋友"   text="『当然啦。你除了认真学习就没别的优点了。』" voices=""/><char @l="810" id="miho" pos="auto" src="miho016"/><msg @l="812" char_id="0" frame_id="-1" name="美帆" text="『这话……让我有点不高兴啊。』"   voices=""/><msg @l="814" char_id="-1" frame_id="-1" name="女性朋友" text="『啊哈哈，对不起对不起！』"   voices=""/><msg @l="816" char_id="-1" frame_id="-1" name="" text="说着，她咯咯地笑了起来。"   voices=""/><msg @l="817" char_id="-1" frame_id="-1" name="" text="我也……被她带动，稍微笑了笑。"   voices=""/><msg @l="819" char_id="-1" frame_id="-1" name="女性朋友"   text="『嗯？那个，怎么回事？』" voices=""/><char @l="822" id="miho" pos="auto" src="miho116"/><msg @l="824" char_id="0" frame_id="-1" name="美帆" text="『啊，什么……？』" voices=""/><msg @l="826" char_id="-1" frame_id="-1" name="女性朋友" text="『你的头发，是不是有点湿？』"   voices=""/><stopbgm @l="829" fadeout="1000"/><char @l="832" id="miho" pos="auto" src="miho114"/><msg @l="834" char_id="0" frame_id="-1" name="美帆" text="『啊……』" voices=""/><msg @l="836" char_id="-1" frame_id="-1" name="" text="我心里咯噔一下。" voices=""/><msg @l="837" char_id="-1" frame_id="-1" name=""   text="虽然我在镜子前已经仔细检查过了，但也不能排除身上还残留着精液的可能性。" voices=""/><char @l="840" id="miho" pos="auto" src="miho115"/><bgm @l="843" src="bgm09" volume="1."/><msg @l="845" char_id="0" frame_id="-1" name="美帆" text="『有、有什么……沾在上面吗？』"   voices=""/><msg @l="847" char_id="-1" frame_id="-1" name="女性朋友"   text="『像是，有什么白色的东西……喂，怎么了？』" voices=""/><char @l="850" id="miho" pos="auto" src="miho015"/><msg @l="852" char_id="0" frame_id="-1" name="美帆" text="『啊，那个……』" voices=""/><char @l="855" id="miho" pos="auto" src="miho016"/><msg @l="857" char_id="0" frame_id="-1" name="美帆"   text="『来的路上呢，那个……鸽子的……』" voices=""/><msg @l="859" char_id="-1" frame_id="-1" name="" text="我立刻编了个谎话。"   voices=""/><msg @l="861" char_id="-1" frame_id="-1" name="女性朋友"   text="『啊！被袭击了吧！是在校门口那边吧？』" voices=""/><msg @l="863" char_id="0" frame_id="-1" name="美帆"   text="『嗯、嗯……就是那个鸽子很多的地方。』" voices=""/><msg @l="865" char_id="-1" frame_id="-1" name="女性朋友"   text="『我男朋友也是，在那里被轰炸过一次呢。』" voices=""/><msg @l="867" char_id="-1" frame_id="-1" name="女性朋友"   text="『我就觉得你运气不太好……真是遭罪了。』" voices=""/><msg @l="869" char_id="0" frame_id="-1" name="美帆"   text="『在洗手间已经弄掉了，没想到还有残留，我再去一下！』" voices=""/><msg @l="870" char_id="-1" frame_id="-1" name="女性朋友" text="『要一起去吗？』"   voices=""/><char @l="873" id="miho" pos="auto" src="miho115"/><msg @l="875" char_id="0" frame_id="-1" name="美帆"   text="『不用！……啊……没事……我马上就回来。』" voices=""/><msg @l="877" char_id="-1" frame_id="-1" name=""   text="我把被我的大声吓到的上课朋友留在原地，跑着离开了教室。" voices=""/><msg @l="878" char_id="-1" frame_id="-1" name="" text="眼中含着泪水……"   voices=""/><stopbgm @l="881" fadeout="1000"/><clear @l="884" class="all"/><call @l="887" target="EventLabel_129@root_kutuki05c"/><return @l="888" value="0&#13;&#10;"/></code></xscript>																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																													