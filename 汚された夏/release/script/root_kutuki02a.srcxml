<?xml version="1.0" encoding="utf-8"?><xscript><debug editor="&quot;C:\Program&#32;Files&#32;(x86)\sakura\sakura.exe&quot;&#32;&quot;%src%&quot;&#32;-Y=%line%"   src="D:\シロップ\町ぐるみの罠＋汚された夏セット版\汚された夏\完成データ\汚された夏\script\text\root_kutuki02a.txt"/><code><label @l="10" id="EventLabel_111"/><description @l="15" text="朽木的奴隶·第1天"/><eval @l="17" expr="f.numDay=5&#13;&#10;"/><msgshow @l="19" show="false"/><wait_chgmv/><bg @l="21" src="day05" time="2000"/><wait @l="23" time="500"/><wait_chgmv/><bg @l="25" src="black" time="2000"/><msgshow @l="27" show="true"/><wait_chgmv/><bg @l="30" src="bg09"/><bgm @l="33" src="bgm02" volume="1."/><char @l="36" id="miho" pos="auto" src="miho010"/><msg @l="38" char_id="-1" frame_id="-1" name="女性朋友" text="『嗯~今天吃什么好呢？』"   voices=""/><msg @l="40" char_id="-1" frame_id="-1" name=""   text="第二节课结束进入午休时间，必定会有的对话。" voices=""/><msg @l="41" char_id="-1" frame_id="-1" name=""   text="今天也是，我的课友一边嘀咕着这句话，一边伸了个大大的懒腰。" voices=""/><char @l="44" id="miho" pos="auto" src="miho011"/><msg @l="46" char_id="0" frame_id="-1" name="美帆"   text="『嗯~昨天吃的是学校食堂，今天要不要去外面吃？』" voices=""/><msg @l="48" char_id="-1" frame_id="-1" name="女性朋友"   text="『坡下那边，是不是有什么新套餐啊？』" voices=""/><char @l="51" id="miho" pos="auto" src="miho110"/><msg @l="53" char_id="0" frame_id="-1" name="美帆"   text="『不太清楚呢…最近没去过所以不知道。』" voices=""/><msg @l="55" char_id="-1" frame_id="-1" name="女性朋友" text="『那，要不要久违地去看看？』"   voices=""/><char @l="58" id="miho" pos="auto" src="miho111"/><msg @l="60" char_id="0" frame_id="-1" name="美帆" text="『好啊。』" voices=""/><se @l="63" buf="1" src="携帯電話呼び出し音02（ループ）" volume="1."/><stopbgm @l="66" fadeout="1000"/><char @l="69" id="miho" pos="auto" src="miho014"/><msg @l="71" char_id="0" frame_id="-1" name="美帆" text="『……！』" voices=""/><msg @l="73" char_id="-1" frame_id="-1" name=""   text="就在我们准备走的那一刻，包里的手机响了起来。" voices=""/><msg @l="74" char_id="-1" frame_id="-1" name=""   text="不过，这似乎并不是一个“电话”，响了两声后就立刻停止了。" voices=""/><bgm @l="77" src="bgm02" volume="1."/><msg @l="79" char_id="-1" frame_id="-1" name="女性朋友" text="『哎呀，是骚扰电话？』"   voices=""/><char @l="82" id="miho" pos="auto" src="miho016"/><msg @l="84" char_id="0" frame_id="-1" name="美帆"   text="『这、这样吗……我还以为最近这种情况减少了呢……』" voices=""/><msg @l="86" char_id="-1" frame_id="-1" name=""   text="我拿出手机，看了看屏幕。" voices=""/><msg @l="87" char_id="-1" frame_id="0" name="" text="「有新邮件」" voices=""/><msg @l="88" char_id="-1" frame_id="-1" name=""   text="看到屏幕上显示的文字……我感到一阵轻微的眩晕。" voices=""/><bgm @l="91" src="bgm15" volume="1."/><msg @l="93" char_id="-1" frame_id="-1" name="女性朋友" text="『怎么了？』" voices=""/><msg @l="95" char_id="0" frame_id="-1" name="美帆"   text="『啊，嗯……不是骚扰电话，是邮件。』" voices=""/><msg @l="97" char_id="-1" frame_id="-1" name="女性朋友" text="『什么嘛～，是网友？』"   voices=""/><msg @l="99" char_id="0" frame_id="-1" name="美帆" text="『嘛、嗯……差不多吧。』"   voices=""/><msg @l="101" char_id="-1" frame_id="-1" name="女性朋友"   text="『你这家伙～，什么时候偷偷搞起来的～？』" voices=""/><msg @l="103" char_id="0" frame_id="-1" name="美帆"   text="『不、不是那样的……真的不是。』" voices=""/><msg @l="105" char_id="-1" frame_id="-1" name="女性朋友"   text="『算了，无所谓。快看看内容是什么。』" voices=""/><msg @l="107" char_id="-1" frame_id="-1" name="女性朋友"   text="『如果是邀请你吃午饭，就说我们一起去好了。』" voices=""/><msg @l="109" char_id="0" frame_id="-1" name="美帆" text="『嗯、嗯……。』" voices=""/><char @l="112" id="miho" pos="auto" src="miho110"/><se @l="115" buf="1" src="携帯ボタン押下音" volume="1."/><msg @l="117" char_id="-1" frame_id="-1" name=""   text="我轻轻屏住呼吸，查看刚刚收到的邮件。" voices=""/><msg @l="118" char_id="-1" frame_id="-1" name="" text="也许是其他邮件也说不定。"   voices=""/><msg @l="119" char_id="-1" frame_id="-1" name="" text="怀着这样的期待……。"   voices=""/><msg @l="121" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><char @l="124" id="miho" pos="auto" src="miho116"/><msg @l="126" char_id="0" frame_id="-1" name="美帆" text="『……啊…。』" voices=""/><msg @l="128" char_id="-1" frame_id="-1" name="女性朋友" text="『怎么样？』"   voices=""/><char @l="131" id="miho" pos="auto" src="miho016"/><msg @l="133" char_id="0" frame_id="-1" name="美帆" text="『……抱歉，我午饭就不去了。』"   voices=""/><msg @l="135" char_id="-1" frame_id="-1" name="女性朋友"   text="『什么嘛，是那么紧急的邮件吗？』" voices=""/><msg @l="137" char_id="0" frame_id="-1" name="美帆"   text="『嗯……有点，突然必须要去一个地方。』" voices=""/><msg @l="139" char_id="-1" frame_id="-1" name="女性朋友" text="『去哪儿啊？』"   voices=""/><msg @l="141" char_id="0" frame_id="-1" name="美帆" text="『就是……那个。』"   voices=""/><msg @l="143" char_id="0" frame_id="-1" name="美帆"   text="『对不起，这次的补偿下次一定会做的。』" voices=""/><msg @l="145" char_id="-1" frame_id="-1" name="女性朋友"   text="『什么啊，真是个不带人的家伙呢～』" voices=""/><msg @l="147" char_id="0" frame_id="-1" name="美帆" text="『真的很抱歉……。』"   voices=""/><msg @l="149" char_id="-1" frame_id="-1" name="女性朋友"   text="『真是的，下次请你吃甜甜圈啊。』" voices=""/><msg @l="151" char_id="-1" frame_id="-1" name=""   text="讲课的朋友一边笑着一边说完后离开了。" voices=""/><msg @l="152" char_id="-1" frame_id="-1" name=""   text="我一边向她背影挥手……一边再次将视线投向手机显示屏上显示的那些文字。" voices=""/><msg @l="153" char_id="-1" frame_id="0" name="" text="「主题：来自教授」" voices=""/><msg @l="154" char_id="-1" frame_id="0" name="" text="「正文：立即到教授室来」"   voices=""/><char @l="157" id="miho" pos="auto" src="miho116"/><msg @l="159" char_id="0" frame_id="-1" name="美帆" text="『必须去了……。』"   voices=""/><msg @l="161" char_id="0" frame_id="-1" name="美帆" text="『是啊……毕竟我，是情人啊。』"   voices=""/><msg @l="163" char_id="-1" frame_id="-1" name="" text="我……慢慢地开始朝房间走去。"   voices=""/><stopbgm @l="166" fadeout="1000"/><clear @l="169" class="all"/><msgshow @l="171" show="true"/><wait_chgmv/><bg @l="174" src="bg12"/><bgm @l="177" src="bgm03" volume="1."/><char @l="180" id="miho" pos="auto" src="miho116"/><msg @l="182" char_id="0" frame_id="-1" name="美帆" text="『……是在下一节讲座吗？』"   voices=""/><clear @l="185" class="char"/><char @l="187" id="miho" pos="right" src="miho116"/><char @l="189" id="kutsu" pos="left" src="kutsu010"/><msg @l="191" char_id="-1" frame_id="-1" name="朽木"   text="『啊，你应该是在听我的讲座的吧？』" voices=""/><msg @l="193" char_id="0" frame_id="-1" name="美帆" text="『是的……虽然是这样……。』"   voices=""/><msg @l="195" char_id="-1" frame_id="-1" name=""   text="回应邮件召唤而来到教授室的我，等待着的并不是要与教授约会，而只是一个简单的提问。" voices=""/><msg @l="197" char_id="-1" frame_id="-1" name="朽木" text="『没什么，只是想确认一下。』"   voices=""/><msg @l="199" char_id="0" frame_id="-1" name="美帆" text="『啊……。』" voices=""/><msg @l="201" char_id="-1" frame_id="-1" name="朽木"   text="『啊对了……借我你的耳朵一下。』" voices=""/><char @l="204" id="miho" pos="right" src="miho014"/><msg @l="206" char_id="0" frame_id="-1" name="美帆" text="『诶……啊，好的……。』"   voices=""/><clear @l="209" class="char"/><char @l="211" id="miho" pos="auto" src="miho116"/><char @l="213" id="kutsu" pos="left" src="kutsu010"/><msg @l="216" char_id="-1" frame_id="-1" name=""   text="我按照他的话，靠近朽木教授身边稍微踮起脚尖。" voices=""/><msg @l="217" char_id="-1" frame_id="-1" name=""   text="不这样做的话……就无法将耳朵凑近他的嘴边。" voices=""/><msg @l="219" char_id="-1" frame_id="-1" name="朽木"   text="『接下来我说的话你要认真听……一定要遵守。』" voices=""/><msg @l="221" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><clear @l="224" class="all"/><wait_chgmv/><bg @l="227" src="bg12"/><char @l="230" id="miho" pos="right" src="miho116"/><char @l="233" id="kutsu" pos="left" src="kutsu010"/><msg @l="235" char_id="-1" frame_id="-1" name="朽木" text="『……就这样，你能做到吗？』"   voices=""/><msg @l="237" char_id="0" frame_id="-1" name="美帆"   text="『是的……我想我能做到，但是……。』" voices=""/><msg @l="239" char_id="-1" frame_id="-1" name="朽木" text="『那就好。』" voices=""/><clear @l="242" class="char"/><char @l="244" id="miho" pos="auto" src="miho116"/><msg @l="246" char_id="-1" frame_id="-1" name=""   text="教授冷淡地说着，就那样坐回了自己的椅子上。" voices=""/><msg @l="248" char_id="0" frame_id="-1" name="美帆"   text="『啊，那个……那么我……接下来该怎么做呢？』" voices=""/><msg @l="250" char_id="-1" frame_id="-1" name="朽木" text="『啊，现在你可以回去了。』"   voices=""/><msg @l="252" char_id="-1" frame_id="-1" name="朽木"   text="『不过，下次讲座开始前，一定要按照指示到达指定的地方。』" voices=""/><char @l="255" id="miho" pos="auto" src="miho015"/><msg @l="257" char_id="0" frame_id="-1" name="美帆" text="『是，是的……失礼了。』"   voices=""/><clear @l="260" class="all"/><msgshow @l="262" show="true"/><wait_chgmv/><bg @l="265" src="bg09"/><char @l="268" id="miho" pos="auto" src="miho116"/><msg @l="270" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="272" char_id="-1" frame_id="-1" name=""   text="走出教授室的我，对朽木教授指示的含义感到困惑不解。" voices=""/><msg @l="274" char_id="0" frame_id="-1" name="美帆" text="『指示……吗。』" voices=""/><msg @l="276" char_id="0" frame_id="-1" name="美帆"   text="『虽然不太明白……总之必须按照他说的去做。』" voices=""/><clear @l="279" class="char"/><msg @l="281" char_id="-1" frame_id="-1" name=""   text="我朝着朽木教授指定的地点走去。" voices=""/><stopbgm @l="284" fadeout="1000"/><clear @l="287" class="all"/><msgshow @l="289" show="true"/><wait_chgmv/><bg @l="292" src="bg08m1"/><bgm @l="295" src="bgm02" volume="1."/><msg @l="297" char_id="-1" frame_id="-1" name="朽木"   text="『嗯，今天进行突击测试。』" voices=""/><msg @l="299" char_id="-1" frame_id="-1" name="学生A" text="『不是吧，真的假的！』"   voices=""/><msg @l="301" char_id="-1" frame_id="-1" name="学生B"   text="『突击测试这种事，又不是义务教育啊。』" voices=""/><msg @l="303" char_id="-1" frame_id="-1" name="学生C"   text="『老师，这个跟学分有关系吗？』" voices=""/><msg @l="305" char_id="-1" frame_id="-1" name=""   text="听到朽木教授在讲堂上说出“测试”一词后，多名学生立刻发出了嘘声和质疑。"   voices=""/><msg @l="307" char_id="-1" frame_id="-1" name="朽木"   text="『当然了，这次测试如果不好的话会影响学分。好好做吧。』" voices=""/><msg @l="309" char_id="-1" frame_id="-1" name="学生A" text="『靠，这可不是开玩笑的。』"   voices=""/><msg @l="311" char_id="-1" frame_id="-1" name="学生B"   text="『明明已经够多报告了啊。』" voices=""/><msg @l="313" char_id="-1" frame_id="-1" name="朽木"   text="『教科书和资料随便看，但是严禁作弊。』" voices=""/><msg @l="315" char_id="-1" frame_id="-1" name=""   text="完全不在意学生们的抱怨，朽木教授平静地开始解释测试内容。" voices=""/><msg @l="316" char_id="-1" frame_id="-1" name=""   text="接着，他将准备好的试卷随意地交给前排的学生，让他们往后传递……然后自己坐在了讲台的椅子上。"   voices=""/><bgm @l="319" src="bgm09" volume="1."/><msg @l="321" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="323" char_id="-1" frame_id="-1" name=""   text="我……从讲台的缝隙中偷偷地观察着这一切。" voices=""/><msg @l="324" char_id="-1" frame_id="-1" name=""   text="没错，我现在正藏身在这个讲堂里的……讲台当中。" voices=""/><msg @l="326" char_id="0" frame_id="-1" name="美帆"   text="(教授……为什么要把我弄到这种地方……？)" voices=""/><msg @l="328" char_id="-1" frame_id="-1" name=""   text="从讲座开始前约15分钟起……我悄悄地来到还没有人的讲堂，藏在这个讲台下面。" voices=""/><msg @l="329" char_id="-1" frame_id="-1" name=""   text="这就是……朽木教授给我的“指示”。" voices=""/><msg @l="331" char_id="-1" frame_id="-1" name="朽木" text="『仲根同学……听得见吗？』"   voices=""/><msg @l="333" char_id="-1" frame_id="-1" name="" text="教授将肘部支在讲台上，对我低声耳语。"   voices=""/><msg @l="334" char_id="-1" frame_id="-1" name=""   text="在这宽敞的讲堂里……他的低语似乎连第一排的学生都听不到。" voices=""/><msg @l="336" char_id="0" frame_id="-1" name="美帆" text="『嗯……能听见。』"   voices=""/><msg @l="338" char_id="-1" frame_id="-1" name="朽木"   text="『放心吧，你不用参加考试也能拿到学分。』" voices=""/><msg @l="340" char_id="-1" frame_id="-1" name="朽木"   text="『甚至……即使一次课都不来，我也能保证你的学分。』" voices=""/><msg @l="342" char_id="0" frame_id="-1" name="美帆"   text="『啊，谢谢您……但是，为什么要这样做……？』" voices=""/><msg @l="344" char_id="-1" frame_id="-1" name="朽木"   text="『你不明白吗？ 就是这么回事。』" voices=""/><msg @l="346" char_id="-1" frame_id="-1" name=""   text="说着，教授将手放在裤子拉链上，缓缓拉下。" voices=""/><msg @l="347" char_id="-1" frame_id="-1" name="" text="我……移开了视线。" voices=""/><msg @l="349" char_id="-1" frame_id="-1" name="朽木"   text="『用你的嘴，帮我舔一下我的那个。』" voices=""/><msg @l="351" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="353" char_id="-1" frame_id="-1" name=""   text="我对那令人作呕的欲望之物感到厌恶。" voices=""/><msg @l="354" char_id="-1" frame_id="-1" name=""   text="更何况，我的第一次已经被这胯下的恶魔夺走了。" voices=""/><msg @l="356" char_id="-1" frame_id="-1" name="朽木"   text="『怎么了？你不会拒绝的，对吧？』" voices=""/><msg @l="358" char_id="0" frame_id="-1" name="美帆" text="『……。』"   voices=""/><msg @l="360" char_id="-1" frame_id="-1" name=""   text="看着眼前的凶器，悲伤和厌恶涌上心头。" voices=""/><msg @l="361" char_id="-1" frame_id="-1" name="" text="然而，现在的我除了顺从别无选择。"   voices=""/><msg @l="363" char_id="0" frame_id="-1" name="美帆" text="『……是。』"   voices=""/><clear @l="366" class="all"/><label @l="369" id="event_scene12"/><msg @l="371" char_id="-1" frame_id="-1" name="朽木"   text="『我不认为直到昨天还是处女的你会有这方面的经验。』" voices=""/><msg @l="373" char_id="-1" frame_id="-1" name="朽木"   text="『别想着做得好，只要按照我说的去做就行。』" voices=""/><msg @l="375" char_id="0" frame_id="-1" name="美帆" text="『我明…白了。』"   voices=""/><msg @l="377" char_id="-1" frame_id="-1" name=""   text="我结结巴巴地回答着，然后将从裤子里垂下来的那东西…慢慢地用嘴唇滑动，含进口中。" voices=""/><label @l="380" id="chart_line43"/><wait_chgmv/><ev @l="383" src="ev-012"/><description @l="386" text="讲台下的宠物"/><eval @l="388" expr="f.numDay=5&#13;&#10;"/><bgm @l="391" src="bgm14" volume="1."/><msg @l="393" char_id="0" frame_id="-1" name="美帆" text="『嗯…。』"   voices="miho07240"/><msg @l="395" char_id="-1" frame_id="-1" name=""   text="第一次含入口中的那东西…不禁让我想吐。" voices=""/><msg @l="397" char_id="-1" frame_id="-1" name="朽木" text="『那么，先让它硬起来吧。』"   voices=""/><msg @l="399" char_id="-1" frame_id="-1" name="朽木"   text="『含着它，动动嘴唇和舌头，吮吸就好。』" voices=""/><msg @l="401" char_id="0" frame_id="-1" name="美帆" text="『呜…好…嗯…。』"   voices="miho07250"/><msg @l="403" char_id="-1" frame_id="-1" name=""   text="按照他的指示，我在口中转动着那柔软无力的肉棒。" voices=""/><msg @l="404" char_id="-1" frame_id="-1" name=""   text="对于没有这种经验的我来说，将排尿的器官含在嘴里只觉得是令人作呕的行为。" voices=""/><msg @l="405" char_id="-1" frame_id="-1" name=""   text="那些强迫女性做这种事还说很舒服的男人，在我看来简直不讲道理。" voices=""/><msg @l="407" char_id="0" frame_id="-1" name="美帆" text="『嗯嗯…。』"   voices="miho07310"/><msg @l="409" char_id="-1" frame_id="-1" name=""   text="就这样用嘴唇和舌尖吮吸了一会儿后，之前还很柔软的阴茎逐渐增加了硬度和体积，慢慢地开始压迫我的口腔。"   voices=""/><msg @l="410" char_id="-1" frame_id="-1" name=""   text="一点一点地抬起头，眼看着变得硬挺起来。" voices=""/><msg @l="412" char_id="0" frame_id="-1" name="美帆"   text="『嗯，哈…那个……变大了……。』" voices="miho07260"/><msg @l="414" char_id="-1" frame_id="-1" name=""   text="将那硬挺膨胀的东西从口中吐出，我深深地吸了一口气。" voices=""/><msg @l="415" char_id="-1" frame_id="-1" name=""   text="刚才还被我的舌头舔舐着的肉棒因唾液而亮晶晶的，似乎还在轻微地抽动。" voices=""/><msg @l="417" char_id="-1" frame_id="-1" name="朽木"   text="『就那样，继续用嘴唇和舌头吮吸。』" voices=""/><msg @l="419" char_id="-1" frame_id="-1" name="朽木"   text="『别忘了用嘴唇紧紧包住它上下摩擦。』" voices=""/><msg @l="421" char_id="-1" frame_id="-1" name=""   text="甚至没有时间调整呼吸，教授就发出了下一个指示，将我的头拉向他的肉茎。" voices=""/><msg @l="423" char_id="0" frame_id="-1" name="美帆"   text="『是…是的…啊，嗯嗯…。』" voices="miho07270"/><msg @l="425" char_id="-1" frame_id="-1" name=""   text="舔舐那个玷污了自己身体的恶魔…虽然脑中想着别的事情，但还是继续吮吸着。" voices=""/><msg @l="427" char_id="0" frame_id="-1" name="美帆"   text="『嗯唔…嗯…嗯……啾…。』" voices="miho07280"/><msg @l="428" char_id="-1" frame_id="-1" name=""   text="我慢慢地…将那被唾液沾湿的东西再次含入口中。" voices=""/><msg @l="429" char_id="-1" frame_id="-1" name=""   text="肉块上青筋暴起，一跳一跳地脉动着。" voices=""/><msg @l="431" char_id="0" frame_id="-1" name="美帆" text="『嗯呼…嗯嗯…。』"   voices="miho07290"/><msg @l="433" char_id="-1" frame_id="-1" name=""   text="我努力用舌尖服侍着含在口中的肉棒。" voices=""/><msg @l="434" char_id="-1" frame_id="-1" name=""   text="不过，不知道哪里是敏感点的我，只能尽力在口中移动舌头而已。" voices=""/><msg @l="436" char_id="-1" frame_id="-1" name="朽木"   text="『呵呵呵…光是亲吻阴茎可感觉不到舒服啊。』" voices=""/><msg @l="438" char_id="-1" frame_id="-1" name="朽木"   text="『沾着唾液缠绕龟头用舌头。』" voices=""/><msg @l="440" char_id="0" frame_id="-1" name="美帆"   text="『啾…嗯…嗯嗯…嗯唔…。』" voices="miho07300"/><msg @l="442" char_id="-1" frame_id="-1" name="朽木" text="『对，就是这种感觉。』"   voices=""/><msg @l="444" char_id="0" frame_id="-1" name="美帆" text="『嗯嗯…。』"   voices="miho07310"/><msg @l="446" char_id="-1" frame_id="-1" name=""   text="我按照他说的用舌头缠绕龟头，同时收紧嘴唇。" voices=""/><msg @l="447" char_id="-1" frame_id="-1" name=""   text="这样就形成了仿佛要吞下那坚硬肉块顶端的姿势。" voices=""/><msg @l="449" char_id="0" frame_id="-1" name="美帆"   text="『嗯噗…嗯，嗯嗯…嗯咕…啾…。』" voices="miho07320"/><msg @l="450" char_id="0" frame_id="-1" name="美帆"   text="『啊呼…嗯咕…嗯，嗯，嗯…。』" voices="miho07330"/><msg @l="452" char_id="0" frame_id="-1" name="美帆"   text="『嗯嗯…嗯咕，嗯…嗯噗…啾，啾噜噜。』" voices="miho07340"/><msg @l="454" char_id="-1" frame_id="-1" name=""   text="将高高挺立的肉柱吞入到中段后，再抽出来吮吸顶端的小孔。" voices=""/><msg @l="455" char_id="-1" frame_id="-1" name="" text="窒息感让我眼前一片模糊。"   voices=""/><msg @l="456" char_id="-1" frame_id="-1" name=""   text="尽管如此，我不能中断用口服侍他，为了让朽木教授尽快满足，我继续吮吸着。" voices=""/><msg @l="458" char_id="0" frame_id="-1" name="美帆"   text="『嗯，嗯，嗯……嗯噗……嗯呼………。』" voices="miho07350"/><msg @l="460" char_id="-1" frame_id="-1" name=""   text="或许是因为我的嘴唇给予他的茎身带来快感，那如同粗蚯蚓般的血管中淫血流动得越来越快。" voices=""/><msg @l="462" char_id="0" frame_id="-1" name="美帆"   text="『啾噗……啾，噗……啊呼……嗯，嗯嗯……。』" voices="miho07360"/><msg @l="464" char_id="-1" frame_id="-1" name=""   text="每次用嘴唇套弄肉棒时，从嘴角溢出的唾液滴落形成一道水痕。" voices=""/><msg @l="465" char_id="-1" frame_id="-1" name=""   text="我没有去擦拭它……只是默默地滑动着嘴唇。" voices=""/><msg @l="467" char_id="-1" frame_id="-1" name="朽木"   text="『啊啊……很好，别忘了边吸边用力套弄。』" voices=""/><msg @l="469" char_id="0" frame_id="-1" name="美帆"   text="『嗯嗯，嗯……嗯咕………啾噗……嗯噗……。』" voices="miho07370"/><msg @l="471" char_id="0" frame_id="-1" name="美帆"   text="『嗯咕……嗯，嗯咕……啾噗……啾，啾呜呜。』" voices="miho07380"/><msg @l="473" char_id="-1" frame_id="-1" name=""   text="就在我吮吸龟头的瞬间，一股苦涩的液体突然在口中蔓延。" voices=""/><msg @l="475" char_id="0" frame_id="-1" name="美帆"   text="(呜啊……那个，从前端流出来了……)" voices="miho07390"/><msg @l="477" char_id="0" frame_id="-1" name="美帆" text="(这个，是精液吗……？)"   voices="miho07400"/><msg @l="479" char_id="-1" frame_id="-1" name=""   text="感受到从男根顶端渗出的液体，我不由皱眉，想要吐出来。" voices=""/><msg @l="480" char_id="-1" frame_id="-1" name=""   text="我咕咚一声将它与自己的唾液一起咽下，继续用湿润的嘴唇进行口部服务。" voices=""/><msg @l="482" char_id="0" frame_id="-1" name="美帆" text="『嗯呼……嗯嗯……。』"   voices="miho07290"/><msg @l="484" char_id="-1" frame_id="-1" name=""   text="浓稠的前液充满整个口腔，引起一阵恶心感，让我不禁颤抖。忍耐着这种感觉，我将其咽下。" voices=""/><msg @l="486" char_id="-1" frame_id="-1" name="学生A" text="『那个，老师。』"   voices=""/><msg @l="488" char_id="0" frame_id="-1" name="美帆" text="『……！？』"   voices="miho07410"/><msg @l="490" char_id="-1" frame_id="-1" name=""   text="一直在安静地参加考试的其中一名学生，突然开口说道。" voices=""/><msg @l="492" char_id="0" frame_id="-1" name="美帆" text="(难道……被发现了……！？)"   voices="miho07420"/><msg @l="494" char_id="-1" frame_id="-1" name=""   text="我惊讶得心脏几乎停止跳动……不由自主地停止了服务。" voices=""/><msg @l="496" char_id="-1" frame_id="-1" name="朽木"   text="『我想没人说可以停下来吧……？』" voices=""/><msg @l="498" char_id="0" frame_id="-1" name="美帆" text="『嗯嗯……。』"   voices="miho07430"/><msg @l="500" char_id="-1" frame_id="-1" name=""   text="我像是在为自己辩解一样，嘴里含着肉棒，发出喉音，向教授投去恳求的眼神。" voices=""/><msg @l="501" char_id="-1" frame_id="-1" name=""   text="然而……教授依然冷静地注视着这样的我……。" voices=""/><msg @l="503" char_id="-1" frame_id="-1" name="朽木" text="『……继续吧。』"   voices=""/><msg @l="505" char_id="-1" frame_id="-1" name="" text="说着，催促我继续。"   voices=""/><msg @l="507" char_id="0" frame_id="-1" name="美帆" text="『………。』"   voices="miho07440"/><msg @l="509" char_id="0" frame_id="-1" name="美帆" text="『嗯呼……嗯，啾啪……。』"   voices="miho07450"/><msg @l="511" char_id="-1" frame_id="-1" name=""   text="无奈之下……我慢慢地移动嘴唇，再次开始吮吸阴茎。" voices=""/><msg @l="512" char_id="-1" frame_id="-1" name="" text="只是……我特别注意不要发出声音。"   voices=""/><msg @l="514" char_id="-1" frame_id="-1" name="学生A" text="『老师？』" voices=""/><msg @l="516" char_id="-1" frame_id="-1" name="朽木"   text="『我听到了。考试中有什么事？』" voices=""/><msg @l="518" char_id="-1" frame_id="-1" name="学生A"   text="『那个……我想去厕所。』" voices=""/><msg @l="520" char_id="-1" frame_id="-1" name="朽木"   text="『那么，把答卷翻过来，安静地出去吧。』" voices=""/><msg @l="522" char_id="-1" frame_id="-1" name="学生A" text="『好的。』" voices=""/><msg @l="524" char_id="-1" frame_id="-1" name=""   text="说完，我从声音中得知一名学生离开了讲堂。" voices=""/><msg @l="525" char_id="-1" frame_id="-1" name=""   text="幸好他至少没有发现我们在做的事……" voices=""/><msg @l="527" char_id="0" frame_id="-1" name="美帆"   text="『嗯呼……嗯，嗯嗯……吮，啾啵。』" voices="miho07460"/><msg @l="529" char_id="-1" frame_id="-1" name=""   text="我必须尽快让他满足……否则可能被人发现。" voices=""/><msg @l="530" char_id="-1" frame_id="-1" name=""   text="在这种恐惧驱使下，我拼命地摆动着头，缠绕着舌尖，将它含得更深。" voices=""/><msg @l="532" char_id="-1" frame_id="-1" name="朽木" text="『呵呵……很好，就是这样。』"   voices=""/><msg @l="534" char_id="-1" frame_id="-1" name=""   text="不理会头顶上得意洋洋的教授，我只是拼命地努力着。" voices=""/><msg @l="535" char_id="-1" frame_id="-1" name=""   text="我紧紧地收缩嘴唇，拼命地前后摆动着脸。" voices=""/><msg @l="537" char_id="-1" frame_id="-1" name="朽木" text="『哦哦哦哦……』"   voices=""/><msg @l="539" char_id="-1" frame_id="-1" name=""   text="我吸得如此之用力以至于脸颊都凹陷下去，同时更加剧烈地前后摇晃着脸。这样子就像啄木鸟一样。" voices=""/><msg @l="541" char_id="0" frame_id="-1" name="美帆"   text="『嗯嗯，嗯……嗯咕……啾噗……嗯噗……』" voices="miho07370"/><msg @l="543" char_id="-1" frame_id="-1" name="朽木"   text="『我马上就要射了……全部用嘴接住，明白吗？』" voices=""/><msg @l="545" char_id="0" frame_id="-1" name="美帆" text="『……！？』"   voices="miho07470"/><msg @l="547" char_id="-1" frame_id="-1" name="朽木" text="『要、要射了……』"   voices=""/><flash @l="550" count="4" fade="100" image="white"/><wait_chgmv/><ev @l="553" src="ev-012x1z1"/><msg @l="555" char_id="0" frame_id="-1" name="美帆" text="『唔唔唔唔唔！！』"   voices="miho07480"/><msg @l="557" char_id="-1" frame_id="-1" name=""   text="就在我的双唇之间，男根剧烈地跳动了一下，随即一股热流强劲地射向我的喉咙深处。" voices=""/><msg @l="558" char_id="-1" frame_id="-1" name=""   text="那股极其腥臭的……缠绕在舌尖和口腔内的热液，让我一脸困惑地含在嘴里不知所措。" voices=""/><msg @l="560" char_id="-1" frame_id="-1" name="朽木" text="『为了不弄脏衣服……全部咽下去。』"   voices=""/><msg @l="562" char_id="0" frame_id="-1" name="美帆" text="『唔唔唔！？』"   voices="miho07490"/><msg @l="564" char_id="-1" frame_id="-1" name="朽木"   text="『怎么了，这次说不定真的会有人发现哦？』" voices=""/><msg @l="566" char_id="0" frame_id="-1" name="美帆" text="『……唔……』"   voices="miho07500"/><msg @l="568" char_id="0" frame_id="-1" name="美帆"   text="『唔唔……唔，唔咕……唔咕……唔咕……唔咕……』" voices="miho07510"/><msg @l="570" char_id="-1" frame_id="-1" name=""   text="短暂犹豫后……我拼命地把嘴里积攒的大量精液咽了下去。" voices=""/><msg @l="571" char_id="-1" frame_id="-1" name=""   text="那粘稠的东西很难咽下去，缠绕在喉咙里的感觉让我生出厌恶感。我强忍着差点要咳嗽的冲动。"   voices=""/><msg @l="572" char_id="-1" frame_id="-1" name="" text="眼中的泪水滑落。"   voices=""/><msg @l="574" char_id="-1" frame_id="-1" name="朽木"   text="『好了……把嘴里的东西全部咽下去后，再把前端吸一下，把留在深处的精液也好好地吸出来。』" voices=""/><msg @l="576" char_id="0" frame_id="-1" name="美帆"   text="『嗯、嗯咕……呼、好的……嗯姆、啾呜呜呜。』" voices="miho07520"/><msg @l="578" char_id="-1" frame_id="-1" name="朽木" text="『呵呵……真是个好孩子。』"   voices=""/><msg @l="580" char_id="-1" frame_id="-1" name=""   text="看着我这样吮吸着残余精液的样子，朽木教授嘴角上扬，浮现出愉悦的笑容。" voices=""/><stopbgm @l="583" fadeout="1000"/><clear @l="586" class="all"/><end_scene @l="589"/><msgshow @l="592" show="true"/><wait_chgmv/><bg @l="595" src="bg08m1"/><bgm @l="598" src="bgm03" volume="1."/><se @l="601" buf="1" src="チャイム" volume="1."/><description @l="604" text="朽木の奴隷・１日目"/><msg @l="606" char_id="-1" frame_id="-1" name="朽木"   text="『到此为止。大家把试卷翻到背面，迅速退场。』" voices=""/><msg @l="608" char_id="-1" frame_id="-1" name="学生B" text="『啊……真是太糟糕了。』"   voices=""/><msg @l="610" char_id="-1" frame_id="-1" name="学生C"   text="『可恶，我连一半都没填完啊。』" voices=""/><msg @l="612" char_id="-1" frame_id="-1" name="学生D"   text="『话说，饭后就考试也太不公平了吧。』" voices=""/><msg @l="614" char_id="-1" frame_id="-1" name=""   text="参加考试的学生们，一边小声嘀咕着感想和抱怨，一边离开讲堂。" voices=""/><wait_chgmv/><bg @l="617" src="bg08"/><msg @l="619" char_id="-1" frame_id="-1" name=""   text="在所有学生都退出讲堂后，朽木教授从讲台前的椅子上站起来，向藏在里面的我示意出来。"   voices=""/><char @l="622" id="miho" pos="left" src="miho115"/><msg @l="624" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><char @l="627" id="kutsu" pos="right" src="kutsu010"/><msg @l="629" char_id="-1" frame_id="-1" name="朽木"   text="『你的服侍真是太棒了，仲根同学。』" voices=""/><msg @l="631" char_id="-1" frame_id="-1" name="朽木"   text="『很难相信这是你第一次服侍呢。』" voices=""/><char @l="634" id="miho" pos="left" src="miho015"/><msg @l="636" char_id="0" frame_id="-1" name="美帆"   text="『怎么会…我，那种事真的是第一次……。』" voices=""/><msg @l="638" char_id="-1" frame_id="-1" name="朽木" text="『我知道。我是在夸奖你啊。』"   voices=""/><msg @l="640" char_id="0" frame_id="-1" name="美帆"   text="『这种事…被夸奖也不会开心……。』" voices=""/><msg @l="642" char_id="-1" frame_id="-1" name="朽木"   text="『你总有一天会明白的，服侍男人的快乐。』" voices=""/><char @l="645" id="miho" pos="left" src="miho115"/><msg @l="647" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="649" char_id="-1" frame_id="-1" name=""   text="听了这番话，我无法忍受朽木教授含笑的目光，转过脸去避开了视线。" voices=""/><stopbgm @l="652" fadeout="1000"/><clear @l="655" class="all"/><msgshow @l="657" show="true"/><wait_chgmv/><bg @l="660" src="bg07"/><bgm @l="663" src="bgm07" volume="1."/><char @l="666" id="miho" pos="auto" src="miho116"/><msg @l="668" char_id="0" frame_id="-1" name="美帆" text="『哈……。』" voices=""/><msg @l="670" char_id="-1" frame_id="-1" name=""   text="结束了一天所有的讲课后，我一个人拖着沉重的脚步在校园里行走。" voices=""/><msg @l="671" char_id="-1" frame_id="-1" name=""   text="本应该是从讲课中解放出来的愉快时光，但从我口中溜出的只有深深的叹息。" voices=""/><msg @l="672" char_id="-1" frame_id="-1" name=""   text="这一切都是因为……和朽木教授交换的约定让我陷入了忧郁。" voices=""/><msg @l="674" char_id="0" frame_id="-1" name="美帆"   text="(以前，只要回到家里就可以不用见到朽木教授……)" voices=""/><msg @l="676" char_id="0" frame_id="-1" name="美帆" text="(但是……现在已经不同了)"   voices=""/><msg @l="678" char_id="0" frame_id="-1" name="美帆"   text="(我，已经是教授的……情人……了啊)" voices=""/><msg @l="680" char_id="-1" frame_id="-1" name=""   text="大概，无论我在哪里，他都会毫不犹豫地给我发邮件吧。" voices=""/><msg @l="681" char_id="-1" frame_id="-1" name="" text="他拥有这个权利。"   voices=""/><msg @l="683" char_id="0" frame_id="-1" name="美帆" text="『唉……』" voices=""/><char @l="686" id="miho" pos="center" src="miho114f" y="-80"/><msg @l="688" char_id="0" frame_id="-1" name="美帆" text="『啊……』" voices=""/><stopbgm @l="691" fadeout="1000"/><msg @l="693" char_id="-1" frame_id="-1" name=""   text="忽然，注意到路边有个熟悉的身影……我停下了脚步。" voices=""/><msg @l="694" char_id="-1" frame_id="-1" name=""   text="他似乎在望着远方，看起来并没有注意到我。" voices=""/><char @l="697" id="shiny" pos="left" src="shinya210" z="100"/><msg @l="699" char_id="0" frame_id="-1" name="美帆"   text="(那个人……是我来到这个城镇时的……)" voices=""/><msg @l="701" char_id="-1" frame_id="-1" name="" text="就是被奈那子称为“哥哥大人”的那个人。"   voices=""/><msg @l="703" char_id="0" frame_id="-1" name="美帆" text="(他在做什么呢……)"   voices=""/><msg @l="705" char_id="0" frame_id="-1" name="美帆"   text="(奈那子好像……不在的样子……)" voices=""/><clear @l="708" class="char"/><char @l="710" id="shiny" pos="auto" src="shinya210"/><msg @l="712" char_id="-1" frame_id="-1" name="年轻男子" text="『……』" voices=""/><msg @l="714" char_id="-1" frame_id="-1" name=""   text="他保持着沉默，一直凝视着某处。" voices=""/><msg @l="715" char_id="-1" frame_id="-1" name=""   text="由于他背对着我，很难确切知道他在看哪里。" voices=""/><msg @l="716" char_id="-1" frame_id="-1" name=""   text="从方向来看……大概是我们称为“后院”的地方吧？" voices=""/><msg @l="718" char_id="0" frame_id="-1" name="美帆"   text="(后院那边有的是……停车场和工友室，大概吧)" voices=""/><msg @l="720" char_id="0" frame_id="-1" name="美帆"   text="(是在找工友吗……不对，不可能是这样的)" voices=""/><clear @l="723" class="char"/><msg @l="725" char_id="-1" frame_id="-1" name=""   text="我轻轻环顾四周，然后再次将视线转回他的方向。" voices=""/><msg @l="726" char_id="-1" frame_id="-1" name="" text="然而……他的身影已经消失了。"   voices=""/><stopbgm @l="729" fadeout="1000"/><clear @l="732" class="all"/><call @l="735" target="EventLabel_114@root_kutuki03a"/><return @l="736" value="0&#13;&#10;"/></code></xscript>																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																					