<?xml version="1.0" encoding="utf-8"?><xscript><debug editor="&quot;C:\Program&#32;Files&#32;(x86)\sakura\sakura.exe&quot;&#32;&quot;%src%&quot;&#32;-Y=%line%"   src="D:\シロップ\町ぐるみの罠＋汚された夏セット版\汚された夏\完成データ\汚された夏\script\text\ending03.txt"/><code><label @l="12" id="EventLabel_41"/><description @l="16" text="姐妹泳池奴隶"/><eval @l="18" expr="f.numDay=0&#13;&#10;"/><label @l="21" id="event_scene20"/><wait_chgmv/><bg @l="25" src="bg10b"/><bgm @l="29" src="bgm03" volume="1."/><msg @l="31" char_id="-1" frame_id="-1" name="" text="自那以后……过了多少天呢。"   voices=""/><msg @l="32" char_id="-1" frame_id="-1" name="" text="三天？" voices=""/><msg @l="33" char_id="-1" frame_id="-1" name="" text="一周？" voices=""/><msg @l="34" char_id="-1" frame_id="-1" name="" text="还是一个月？" voices=""/><msg @l="35" char_id="-1" frame_id="-1" name="" text="连过了多久都不清楚了。"   voices=""/><msg @l="36" char_id="-1" frame_id="-1" name=""   text="时间感变得模糊，日子仿佛失去了真实感。" voices=""/><msg @l="37" char_id="-1" frame_id="-1" name=""   text="那天，亚季奈被渡部他们凌辱之后……我也成了他们的玩物，身体各处都被玷污了……" voices=""/><msg @l="38" char_id="-1" frame_id="-1" name=""   text="嘴巴、下面、后面……所有地方都被侵犯，被玷污，被彻底凌辱。" voices=""/><msg @l="39" char_id="-1" frame_id="-1" name=""   text="即便如此也无法向警察举报，我只能一直忍受着。" voices=""/><msg @l="40" char_id="-1" frame_id="-1" name="" text="为了那孩子……为了亚季奈。"   voices=""/><stopbgm @l="43" fadeout="1000"/><bgm @l="46" src="bgm14" volume="1."/><msg @l="48" char_id="0" frame_id="-1" name="美帆" text="『嗯……啊啊……。』"   voices="miho11330"/><msg @l="50" char_id="-1" frame_id="-1" name=""   text="感受到秘肉被挤开插入的感觉，我不由自主地发出了声音。" voices=""/><msg @l="51" char_id="-1" frame_id="-1" name="" text="声音在颤抖……听起来有些饥渴。"   voices=""/><msg @l="53" char_id="-1" frame_id="-1" name="渡部"   text="『真不错……姐姐这边的小穴一如既往地好啊。』" voices=""/><msg @l="55" char_id="-1" frame_id="-1" name=""   text="渡部老师像是在品味我的阴道内壁触感，缓缓开始了抽送。" voices=""/><msg @l="56" char_id="-1" frame_id="-1" name=""   text="私密小孔自发地柔软地轻轻包裹住肉棒，接纳了它。" voices=""/><msg @l="58" char_id="-1" frame_id="-1" name="熊野"   text="『妹妹那边的小穴也紧紧地吸附着很舒服，不过我果断更喜欢这边。』" voices=""/><msg @l="60" char_id="-1" frame_id="-1" name=""   text="说着，熊野将肉棒的前端塞进了亚季奈的口中。" voices=""/><msg @l="61" char_id="-1" frame_id="-1" name=""   text="当熊野的味道在口腔中扩散时，亚季奈不由自主地开始摆动头部。" voices=""/><msg @l="62" char_id="-1" frame_id="-1" name=""   text="每当她的脸颊凹陷，淫猥的声音就会回响，唾液缠绕在肉伞上。" voices=""/><label @l="66" id="chart_line17"/><wait_chgmv/><ev @l="70" src="ev-020"/><msg @l="72" char_id="2" frame_id="-1" name="亚季奈"   text="『呜咕……呜，啾噗，啾噗，啾噗……。』" voices="akina03770"/><msg @l="74" char_id="-1" frame_id="-1" name="熊野"   text="『哦哦……不错啊，好好地遵守了我教的东西呢。』" voices=""/><msg @l="76" char_id="-1" frame_id="-1" name=""   text="亚季奈既没有回答他，也没有改变表情，只是一心一意地侍奉着熊野。" voices=""/><msg @l="78" char_id="0" frame_id="-1" name="美帆" text="『……。』"   voices="miho11340"/><msg @l="80" char_id="-1" frame_id="-1" name="" text="我们被当作游泳部的排泄工具饲养着。"   voices=""/><msg @l="81" char_id="-1" frame_id="-1" name=""   text="亚季奈……从那天起就再也没有露出以前那种明朗无邪的笑容，变成了一个无心地侍奉男人之物的人偶。"   voices=""/><msg @l="82" char_id="-1" frame_id="-1" name=""   text="我曾向渡部他们质问是不是药物的原因，但他们根本不予理会。" voices=""/><msg @l="83" char_id="-1" frame_id="-1" name=""   text="……我什么都……什么都做不到………………。" voices=""/><msg @l="85" char_id="-1" frame_id="-1" name="留学生" text="『哦啊哦哦，哦，女人，女人』"   voices=""/><msg @l="87" char_id="-1" frame_id="-1" name="渡部"   text="『都射了那么多次了，你还没完没了啊。就在那边看着我们的那玩意儿，给我老实点撸管去！』"   voices=""/><msg @l="89" char_id="-1" frame_id="-1" name="留学生" text="『呜呜，哦哦……』"   voices=""/><msg @l="91" char_id="-1" frame_id="-1" name=""   text="留学生一副无奈的样子，开始套弄起自己漆黑的硬物。" voices=""/><msg @l="92" char_id="-1" frame_id="-1" name=""   text="那因粗暴摩擦而变得更加坚硬的黑色凶器，牢牢地吸引着我的视线，让我无法移开。" voices=""/><msg @l="93" char_id="-1" frame_id="-1" name="" text="刚才那东西还在顶撞我的子宫。"   voices=""/><msg @l="94" char_id="-1" frame_id="-1" name=""   text="当他的那物完全插入时，我感觉内脏都要从嘴里出来了。" voices=""/><msg @l="95" char_id="-1" frame_id="-1" name=""   text="龟头紧贴着子宫口，一次又一次地吐出精液……。" voices=""/><msg @l="96" char_id="-1" frame_id="-1" name=""   text="被射入那一瞬间，子宫剧烈麻痹的感觉又浮现在脑海。" voices=""/><msg @l="97" char_id="-1" frame_id="-1" name=""   text="说起来，他射了那么多，难道是特别浓稠吗？" voices=""/><msg @l="98" char_id="-1" frame_id="-1" name="" text="还是说已经流到更深处去了？"   voices=""/><msg @l="99" char_id="-1" frame_id="-1" name=""   text="我不太清楚，但几乎没有从私处流回来……" voices=""/><msg @l="100" char_id="-1" frame_id="-1" name="" text="我，会不会怀孕呢？"   voices=""/><msg @l="101" char_id="-1" frame_id="-1" name=""   text="但是，到现在为止，他已经射了那么多次，从来没有避孕过。" voices=""/><msg @l="102" char_id="-1" frame_id="-1" name=""   text="任他随心所欲地侵犯，随心所欲地射进来……" voices=""/><msg @l="103" char_id="-1" frame_id="-1" name=""   text="现在才考虑怀孕的事情……我觉得为时已晚了……" voices=""/><msg @l="104" char_id="-1" frame_id="-1" name=""   text="这么想着，留学生那堪比美帆细臂的凶器，突然在我眼中变得可爱起来。" voices=""/><msg @l="105" char_id="-1" frame_id="-1" name=""   text="虽然很痛苦……但还想被他顶弄……还想让他射在里面……" voices=""/><msg @l="107" char_id="-1" frame_id="-1" name="" text="…………………" voices=""/><msg @l="108" char_id="-1" frame_id="-1" name="" text="…………" voices=""/><msg @l="109" char_id="-1" frame_id="-1" name="" text="……" voices=""/><msg @l="111" char_id="-1" frame_id="-1" name=""   text="……而现在，渡部老师正扭动着腰，仿佛要把留学生射出的精子揉进阴道褶皱里。" voices=""/><msg @l="113" char_id="-1" frame_id="-1" name="渡部"   text="『看招！……姐姐也别发愣了，叫出好听的声音来啊！』" voices=""/><msg @l="115" char_id="0" frame_id="-1" name="美帆" text="『嗯，啊啊……』"   voices="miho11350"/><msg @l="117" char_id="-1" frame_id="-1" name=""   text="……我的身体溢出炽热的淫液，不由自主地渴求着肉茎。" voices=""/><msg @l="118" char_id="-1" frame_id="-1" name="" text="……只是一具渴求男人肉茎的身体。"   voices=""/><msg @l="119" char_id="-1" frame_id="-1" name=""   text="几个月前的我，绝对想象不到会变成这样。" voices=""/><msg @l="121" char_id="0" frame_id="-1" name="美帆"   text="『嗯嗯……啊呜……嗯，嗯，嗯，啊啊啊。』" voices="miho11360"/><msg @l="123" char_id="0" frame_id="-1" name="美帆"   text="『啊，嗯呜……嗯……啊……啊……嗯哈。』" voices="miho11370"/><msg @l="125" char_id="-1" frame_id="-1" name=""   text="每当淫茎来回抽送，褶皱就颤抖不已，爱液也变得白浊。" voices=""/><msg @l="126" char_id="-1" frame_id="-1" name=""   text="阴肉发出咕啾咕啾的声音，被柔软地揉开。" voices=""/><msg @l="128" char_id="-1" frame_id="-1" name="渡部"   text="『爽翻了……里面的褶皱缠上来，简直要榨干我了。』" voices=""/><msg @l="130" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯噗……嗯，啾噗……嗯嗯……舔……舔……。』" voices="akina03780"/><msg @l="132" char_id="-1" frame_id="-1" name="熊野"   text="『再多些唾液涂在鳃部……对，然后，再用力吸一点。』" voices=""/><msg @l="134" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯嗯～……啾啪……嗯呼……咕噗，啾咯咯！』" voices="akina03790"/><msg @l="136" char_id="-1" frame_id="-1" name="熊野"   text="『对，就是这样……光是口交的话，妹妹已经超越姐姐了呢。』" voices=""/><msg @l="138" char_id="-1" frame_id="-1" name=""   text="熊野似乎对亚季奈的口交技巧很满意，轻轻抚摸着她的头。" voices=""/><msg @l="140" char_id="-1" frame_id="-1" name="渡部"   text="『是吗……那么，明天就试试用她的嘴吧。』" voices=""/><msg @l="142" char_id="-1" frame_id="-1" name=""   text="他一边顶弄着我，一边揉搓亚季奈的臀部。" voices=""/><msg @l="143" char_id="-1" frame_id="-1" name=""   text="熊野也俯视着脸色潮红的我，浮现出淫荡的笑容。" voices=""/><msg @l="145" char_id="-1" frame_id="-1" name="熊野"   text="『我也很久没品尝过她的肉壶了，很想试试呢。不过今天就用这边吧。把享受的时间留到明天，就这么说定了。』"   voices=""/><msg @l="147" char_id="-1" frame_id="-1" name=""   text="他们像闲聊家常一样，谈论着强暴我们的事。" voices=""/><msg @l="148" char_id="-1" frame_id="-1" name=""   text="插入的肉棒咕叽咕叽地剧烈摩擦着内壁的皱褶，一下下敲打着深处的子宫口。" voices=""/><msg @l="151" char_id="0" frame_id="-1" name="美帆"   text="『嗯，嗯，嗯，嗯……啊……嗯啊……。』" voices="miho11380"/><msg @l="153" char_id="0" frame_id="-1" name="美帆"   text="『好深……啊啊……那里……不行……。』" voices="miho11390"/><msg @l="155" char_id="-1" frame_id="-1" name=""   text="突然暴动的男根，强烈摩擦着美帆的G点。" voices=""/><msg @l="156" char_id="-1" frame_id="-1" name=""   text="我忍不住随着席卷全身的快感波涛颤抖着腰肢，泄露出甜美的喘息。" voices=""/><msg @l="158" char_id="-1" frame_id="-1" name="渡部"   text="『姐姐还是和以前一样，这里最敏感吧？』" voices=""/><msg @l="160" char_id="-1" frame_id="-1" name=""   text="他准确地找到G点，像是早有预谋般用龟头反复摩擦同一个地方，用冠状沟部刮擦着。" voices=""/><msg @l="161" char_id="-1" frame_id="-1" name="" text="高潮的浪潮一下子席卷了我。"   voices=""/><msg @l="162" char_id="-1" frame_id="-1" name="" text="在这执拗的责罚下，我无法抑制自己的声音。"   voices=""/><msg @l="164" char_id="0" frame_id="-1" name="美帆"   text="『啊啊……不、嗯……啊啊！！』" voices="miho11400"/><msg @l="166" char_id="0" frame_id="-1" name="美帆"   text="『一直弄那里的话……马上、嗯嗯……就要去了。』" voices="miho11410"/><msg @l="168" char_id="-1" frame_id="-1" name="熊野" text="『不行，给我忍住！』"   voices=""/><msg @l="170" char_id="-1" frame_id="-1" name="渡部"   text="『老子还没打算射呢。敢自己擅自高潮的话就把你光着身子扔到外面去！』" voices=""/><msg @l="172" char_id="0" frame_id="-1" name="美帆" text="『嗯嗯……我、我知道了。』"   voices="miho11420"/><msg @l="174" char_id="-1" frame_id="-1" name="" text="虽然是不讲理的命令，但我还是答应了。"   voices=""/><msg @l="175" char_id="-1" frame_id="-1" name="" text="因为我已经被调教得只能这样回答。"   voices=""/><msg @l="177" char_id="2" frame_id="-1" name="亚季奈"   text="『啊呜……嗯嗯，嗯……咕啾，啾噗……舔。』" voices="akina03800"/><msg @l="179" char_id="2" frame_id="-1" name="亚季奈"   text="『啾啵，啾啵，啾啵……嗯，嗯噗，啾噜噜……。』" voices="akina03810"/><msg @l="181" char_id="-1" frame_id="-1" name="熊野"   text="『哦……虽然有些可惜，但我差不多要射了。』" voices=""/><msg @l="184" char_id="-1" frame_id="-1" name="" text="亚季奈的动作变快了。"   voices=""/><msg @l="185" char_id="-1" frame_id="-1" name=""   text="但是，亚季奈的眼神依然没有焦点。" voices=""/><msg @l="186" char_id="-1" frame_id="-1" name=""   text="看起来她只是凭身体记忆对熊野肉棒的微妙变化做出反应而已。" voices=""/><msg @l="188" char_id="-1" frame_id="-1" name="渡部" text="『其他家伙看起来也到极限了。』"   voices=""/><msg @l="190" char_id="-1" frame_id="-1" name="留学生" text="『哦哦，哦哦！』"   voices=""/><msg @l="192" char_id="-1" frame_id="-1" name=""   text="回过神来，除了留学生，其他被迫忍耐的游泳部成员们也围在周围，一边看着我和亚季奈淫乱的样子一边猛烈地自慰着。"   voices=""/><msg @l="193" char_id="-1" frame_id="-1" name=""   text="无数视线缠绕在我全身每一处淫荡的部位，视奸着我们。" voices=""/><msg @l="194" char_id="-1" frame_id="-1" name=""   text="无形的肉棒挤压着我的嘴，乳头，肚脐，并且深入其中。" voices=""/><msg @l="195" char_id="-1" frame_id="-1" name=""   text="同样地，视线也投向亚季奈的腋下，秘缝，菊穴。" voices=""/><msg @l="197" char_id="0" frame_id="-1" name="美帆"   text="『呃啊……嗯，嗯，嗯，嗯嗯………啊啊！！』" voices="miho11430"/><msg @l="199" char_id="2" frame_id="-1" name="亚季奈"   text="『啾咯、啾噗……呣噗、呣噗、呣噗……啾噗噗。』" voices="akina03820"/><msg @l="201" char_id="-1" frame_id="-1" name=""   text="渡部老师像是要向周围的观众展示一样，执拗地责罚着我的弱点。" voices=""/><msg @l="202" char_id="-1" frame_id="-1" name=""   text="无法忍受连续的快感，身体弓形反弯，腰部悬空。" voices=""/><msg @l="204" char_id="0" frame_id="-1" name="美帆"   text="『嗯、嗯、嗯嗯……啊啊……嗯呼……啊啊……』" voices="miho11440"/><msg @l="206" char_id="-1" frame_id="-1" name="游泳部成员A"   text="『哦，原来如此……那里就是G点啊……待会我也试试。』" voices=""/><msg @l="208" char_id="0" frame_id="-1" name="美帆"   text="『嗯咕……嗯、嗯啊………啊呼……嗯、嗯、啊啊！！』" voices="miho11450"/><msg @l="210" char_id="-1" frame_id="-1" name="" text="无法忍受，轻轻地高潮了。"   voices=""/><msg @l="211" char_id="-1" frame_id="-1" name=""   text="但是，渡部老师不管不顾，继续用鳃盖刮擦着G点。" voices=""/><msg @l="213" char_id="2" frame_id="-1" name="亚季奈"   text="『啊姆……嗯、嗯噗……啾噗……啾噜、啾噗、啾噗。』" voices="akina03830"/><msg @l="215" char_id="-1" frame_id="-1" name="游泳部成员B"   text="『仲根那色情的口交表情……忍不住了。』" voices=""/><msg @l="217" char_id="-1" frame_id="-1" name=""   text="不知道她是否听到了，但吸吮淫茎的声音变得更大了。" voices=""/><msg @l="219" char_id="2" frame_id="-1" name="亚季奈"   text="『啊呼，嗯……嗯咕……舔……啾，啾噜噜噜噜！！』" voices="akina03840"/><msg @l="221" char_id="-1" frame_id="-1" name=""   text="可能是期待着精液冲击喉咙，亚季奈的秘裂中淫蜜啪嗒一声滴落，顺着大腿流下形成了一小滩蜜池。" voices=""/><msg @l="222" char_id="-1" frame_id="-1" name=""   text="散发着淫猥气味的蜜池，让亚季奈自身都为之颤栗。" voices=""/><msg @l="223" char_id="-1" frame_id="-1" name=""   text="她的双眼开始湿润，口腔变得如此灼热，仿佛要融化熊野的肉棒。" voices=""/><msg @l="225" char_id="-1" frame_id="-1" name=""   text="我们周围的空气越来越热，充满了淫靡的气味，就连只是在一旁观看的部员们也逐渐疯狂起来。" voices=""/><msg @l="227" char_id="-1" frame_id="-1" name="游泳部成员C"   text="『不行了，我快要射了……』" voices=""/><msg @l="229" char_id="-1" frame_id="-1" name="游泳部成员D"   text="『哦，哦……我也快到极限了啊。』" voices=""/><msg @l="231" char_id="-1" frame_id="-1" name="留学生" text="『哇，哦，哦哦哦！』"   voices=""/><msg @l="233" char_id="-1" frame_id="-1" name="熊野"   text="『差不多是时候了。……那么，跟着我的口令，一起来吧。』" voices=""/><msg @l="235" char_id="-1" frame_id="-1" name="渡部"   text="『好嘞，你们两个都听到了吧……现在就让你们尽情地享受一下！』" voices=""/><msg @l="237" char_id="-1" frame_id="-1" name="渡部" text="『被射满就高潮吧！！』"   voices=""/><msg @l="239" char_id="-1" frame_id="-1" name="熊野" text="『那么……。』" voices=""/><msg @l="241" char_id="-1" frame_id="-1" name=""   text="在熊野的信号下，所有人都开始了最后冲刺。" voices=""/><msg @l="243" char_id="-1" frame_id="-1" name="熊野"   text="『…………预备！ 射！！』" voices=""/><flash @l="247" count="4" fade="100" image="white"/><msg @l="249" char_id="-1" frame_id="-1" name=""   text="以熊野的释放为开始，所有人都朝着我们挺出了腰部。" voices=""/><msg @l="251" char_id="-1" frame_id="-1" name=""   text="啪！ 嗖！ 嗖！ 咕！ 咕！ 啪！ 嗖！"   voices=""/><msg @l="253" char_id="-1" frame_id="-1" name=""   text="浓稠得能听见声音的白浊液体如团块般飞过空中。" voices=""/><msg @l="255" char_id="0" frame_id="-1" name="美帆" text="『嗯嗯……！！』"   voices="miho11460"/><flash @l="259" count="4" fade="100" image="white"/><msg @l="261" char_id="2" frame_id="-1" name="亚季奈" text="『嗯，呼啊……。』"   voices="akina03850"/><wait_chgmv/><ev @l="265" src="ev-020z1"/><msg @l="267" char_id="0" frame_id="-1" name="美帆" text="『啊……啊啊…………。』"   voices="miho11470"/><msg @l="269" char_id="-1" frame_id="-1" name=""   text="滚烫的液体洒落在亚季奈和我身上，像积雪一样覆盖着我们的肌肤。" voices=""/><msg @l="270" char_id="-1" frame_id="-1" name=""   text="每当被白浊液体浇到，我的子宫都会有所反应，紧缩一下。" voices=""/><msg @l="272" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯……嗯啊………哈，哈，哈………。』" voices="akina03860"/><msg @l="274" char_id="-1" frame_id="-1" name=""   text="亚季奈闭着眼睛，伸出舌头接住喷洒在她脸上散发着气味的子种。" voices=""/><msg @l="275" char_id="-1" frame_id="-1" name=""   text="粘在眼皮和脸颊上的精液被手指舀起，送入口中。" voices=""/><msg @l="276" char_id="-1" frame_id="-1" name=""   text="沾满精液的手指被含在嘴里，啵地一声抽出。" voices=""/><msg @l="277" char_id="-1" frame_id="-1" name=""   text="当口中积满精液后，喉咙一动，便将其咽进了胃里。" voices=""/><msg @l="278" char_id="-1" frame_id="-1" name=""   text="她一边小口喘气，一边让小小的胸部上下起伏调整呼吸，然后又开始收集精液。" voices=""/><msg @l="279" char_id="-1" frame_id="-1" name=""   text="亚季奈陶醉于精液缠绕在喉咙里的触感……。" voices=""/><msg @l="281" char_id="-1" frame_id="-1" name=""   text="我用余光瞥见亚季奈这样的模样，自己也用双手捧起积聚在胸部和腹部上的精液，将嘴唇凑近，喝下精液……………。" voices=""/><stopbgm @l="285" fadeout="1000"/><clear @l="291" class="all"/><msg @l="293" char_id="-1" frame_id="-1" name=""   text="为了能够稍微接近亚季奈，接近妹妹所在的地方……我也不断地吞咽着精液……。" voices=""/><msg @l="294" char_id="-1" frame_id="-1" name=""   text="既然已经喝完了自己身上的，就去喝染白了亚季奈背部的精液吧…。" voices=""/><msg @l="296" char_id="-1" frame_id="-1" name=""   text="虽然肚子已经很饱了，但不喝不行……。" voices=""/><msg @l="298" char_id="-1" frame_id="-1" name="" text="亚季奈的小麦色肌肤真适合她………。"   voices=""/><msg @l="300" char_id="0" frame_id="-1" name="美帆"   text="『不知何时……我能否也去到那边，亚季奈…。』" voices="miho11480"/><msg @l="302" char_id="-1" frame_id="-1" name=""   text="我小声地嘀咕着……将嘴唇贴在了亚季奈的背上…………………。" voices=""/><clear @l="308" class="all"/><end_scene @l="311"/><eval @l="315" expr="s.flagGallery=1&#13;&#10;"/><eval @l="317" expr="s.event20flag=1&#13;&#10;"/><eval @l="321"   expr="f.bEx&#32;=&#32;s.event20flag&#32;&amp;&amp;&#32;s.event23flag&#32;&amp;&amp;&#32;s.event25flag&#32;&amp;&amp;&#32;s.event30flag&#32;&amp;&amp;&#32;s.event31flag&#32;&amp;&amp;&#32;s.event32flag&#32;&amp;&amp;&#32;s.event33flag&#32;&amp;&amp;&#32;s.event35flag&#32;&amp;&amp;&#32;s.event37flag&#32;&amp;&amp;&#32;s.event38flag&#32;&amp;&amp;&#32;s.event60flag&#13;&#10;"/><goto @l="323" cond="!(f.bEx)&#13;&#10;" label="TempLabel_230"/><eval @l="325" expr="s.exRootFlag=1&#13;&#10;"/><label @l="326" id="TempLabel_230"/><ending @l="328"/><goto @l="330" cond="!(f.bEx)&#13;&#10;" label="TempLabel_231"/><wait_chgmv/><bg @l="334" src="newroot"/><wait @l="336" time="5000"/><wait_chgmv/><bg @l="338" src="black"/><label @l="341" id="TempLabel_231"/><return @l="345" value=""/></code></xscript>																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																				