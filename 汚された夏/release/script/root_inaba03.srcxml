<?xml version="1.0" encoding="utf-8"?><xscript><debug editor="&quot;C:\Program&#32;Files&#32;(x86)\sakura\sakura.exe&quot;&#32;&quot;%src%&quot;&#32;-Y=%line%"   src="D:\シロップ\町ぐるみの罠＋汚された夏セット版\汚された夏\完成データ\汚された夏\script\text\root_inaba03.txt"/><code><eval @l="11" expr="f.稲庭ルート即席02flag&#32;=&#32;0&#13;&#10;"/><label @l="17" id="EventLabel_96"/><eval @l="20" expr="f.稲庭ルート即席02flag&#32;=&#32;0&#13;&#10;"/><description @l="23" text="网球社入会·第4天"/><msgshow @l="26" show="false"/><wait @l="28" time="500"/><wait_chgmv/><bg @l="30" src="black" time="2000"/><msgshow @l="32" show="true"/><clear @l="35" class="all"/><msg @l="37" char_id="-1" frame_id="-1" name=""   text="眼前，那些本应在网球比赛中失败先行离场的女生们正被男社员们侵犯着。" voices=""/><msg @l="39" char_id="-1" frame_id="-1" name="男会员A"   text="『你们是失败者，所以我们要用我们的肉拍子来惩罚你们。』" voices=""/><msg @l="41" char_id="-1" frame_id="-1" name=""   text="男社员们带着血丝的眼睛，正围着女孩们。" voices=""/><msg @l="42" char_id="-1" frame_id="-1" name=""   text="女孩们的网球服几乎都被撕破了，尽管是光天化日之下的户外，她们却以接近全裸的状态被蹂躏着。" voices=""/><msg @l="43" char_id="-1" frame_id="-1" name=""   text="或许已经被相当多的人侵犯过了，她们的身体惨不忍睹地被弄得黏糊糊的。可能已经没有抵抗的气力了，只能任由男社员们摆布。"   voices=""/><msg @l="46" char_id="-1" frame_id="-1" name=""   text="我仍然难以相信眼前正在上演的这幅地狱图景。" voices=""/><msg @l="47" char_id="-1" frame_id="-1" name=""   text="几十分钟前我还相信这是一个和平的网球社，而现在摆在眼前的，无论如何看都是赤裸裸的强奸社团。" voices=""/><wait_chgmv/><bg @l="50" src="bg13"/><msg @l="52" char_id="-1" frame_id="-1" name="声音" text="『你们，干得不错啊？』"   voices=""/><msg @l="54" char_id="-1" frame_id="-1" name="" text="突然，一个熟悉的声音传来。"   voices=""/><msg @l="56" char_id="-1" frame_id="-1" name="男会员B" text="『哟，会长！』"   voices=""/><bgm @l="59" src="bgm09" volume="1."/><char @l="62" id="inaba" pos="auto" src="inaba050"/><msg @l="64" char_id="-1" frame_id="-1" name="" text="那是稻庭学长。"   voices=""/><msg @l="65" char_id="-1" frame_id="-1" name="" text="为什么他会出现在这种地方……"   voices=""/><msg @l="67" char_id="-1" frame_id="-1" name="稻庭" text="『来，这是常用的药。』"   voices=""/><msg @l="69" char_id="-1" frame_id="-1" name="男会员C"   text="『太好了，是新的药物呢。』" voices=""/><msg @l="71" char_id="-1" frame_id="-1" name="男会员D"   text="『笨蛋，不是说了要叫它增强剂吗！』" voices=""/><char @l="74" id="miho" pos="auto" src="miho054"/><msg @l="76" char_id="0" frame_id="1" name="美帆"   text="（药？……药物？那是什么意思？）" voices=""/><char @l="79" id="miho" pos="auto" src="miho055"/><msg @l="81" char_id="0" frame_id="1" name="美帆"   text="『稻庭学长，这到底是怎么回事？』" voices=""/><msg @l="83" char_id="-1" frame_id="-1" name=""   text="在这种情况下，我实在无法相信会长会对此一无所知。" voices=""/><msg @l="84" char_id="-1" frame_id="-1" name=""   text="但是，我仍然希望这是某种误会。" voices=""/><clear @l="87" class="char"/><char @l="89" id="miho" pos="right" src="miho055"/><char @l="91" id="inaba" pos="left" src="inaba050"/><msg @l="94" char_id="-1" frame_id="-1" name="稻庭" text="『仲根君……』" voices=""/><msg @l="96" char_id="-1" frame_id="-1" name="稻庭"   text="『我之前跟你说过，我小时候身体很弱吧。』" voices=""/><char @l="99" id="miho" pos="right" src="miho054"/><msg @l="101" char_id="0" frame_id="1" name="美帆" text="『是、是的……』" voices=""/><msg @l="103" char_id="-1" frame_id="-1" name=""   text="面对这意外的开场白，我一时有些发愣。" voices=""/><msg @l="104" char_id="-1" frame_id="-1" name="" text="这个人到底想说什么呢。"   voices=""/><msg @l="106" char_id="-1" frame_id="-1" name="稻庭"   text="『然后为了静养，我来到了这个城镇……当时应该还是个村子吧……我家的别墅，但康复的可能性可以说是完全没有。』"   voices=""/><msg @l="108" char_id="-1" frame_id="-1" name="稻庭"   text="『就在那时，这个城镇里的大黑制药研究所询问我是否愿意成为某种新药的试验对象。』" voices=""/><msg @l="110" char_id="-1" frame_id="-1" name="" text="我很了解大黑制药。"   voices=""/><msg @l="111" char_id="-1" frame_id="-1" name=""   text="一方面是因为它是大企业，但最主要的原因是那是父亲的工作单位。" voices=""/><msg @l="112" char_id="-1" frame_id="-1" name=""   text="虽然父亲也在研究所工作，但我从未听说过这个城镇有研究所。" voices=""/><msg @l="113" char_id="-1" frame_id="-1" name="" text="搬家的时候也没有人跟我提过。"   voices=""/><msg @l="115" char_id="-1" frame_id="-1" name="稻庭"   text="『当时抓住任何救命稻草的父母立刻接受了这个提议，结果，我的身体奇迹般地康复了。』" voices=""/><msg @l="117" char_id="-1" frame_id="-1" name="稻庭"   text="『只是，那种药有副作用。一个是必须持续服用，另一个是……难以控制自己的情绪，特别是性欲。』"   voices=""/><char @l="120" id="miho" pos="right" src="miho055"/><msg @l="122" char_id="0" frame_id="1" name="美帆" text="『所以才会做这种事……』"   voices=""/><msg @l="124" char_id="-1" frame_id="-1" name="稻庭"   text="『情绪控制可以通过训练改善，但抑制性欲却很困难。不过，有了强奸俱乐部就能轻松获得女人，就算频繁做爱也没人会起疑。』"   voices=""/><msg @l="126" char_id="0" frame_id="1" name="美帆" text="『为、为了这种事……』"   voices=""/><clear @l="129" class="char"/><char @l="131" id="kuma" pos="auto" src="kuma012"/><msg @l="133" char_id="-1" frame_id="-1" name="声音"   text="『当然不仅仅是为了这个理由。』" voices=""/><msg @l="135" char_id="-1" frame_id="-1" name="" text="突然一位像是校工的人插话进来。"   voices=""/><clear @l="138" class="char"/><char @l="140" id="inaba" pos="right" src="inaba050"/><char @l="142" id="kuma" pos="left" src="kuma012"/><msg @l="145" char_id="-1" frame_id="-1" name="稻庭"   text="『这位熊野先生是我成为试验对象时研究所的负责人，到现在还在这样为我提供药物。』" voices=""/><clear @l="148" class="char"/><char @l="150" id="miho" pos="auto" src="miho055"/><msg @l="152" char_id="-1" frame_id="-1" name="" text="这个人就是……？" voices=""/><msg @l="153" char_id="-1" frame_id="-1" name=""   text="但是，为什么这样的人会在大学做校工呢。" voices=""/><clear @l="156" class="char"/><char @l="158" id="miho" pos="right" src="miho055"/><char @l="160" id="kuma" pos="left" src="kuma012"/><msg @l="163" char_id="-1" frame_id="-1" name="熊野"   text="『你……知道制药公司至今仍未能实现的药物是什么吗？』" voices=""/><char @l="166" id="miho" pos="right" src="miho054"/><msg @l="168" char_id="0" frame_id="1" name="美帆" text="『啊？癌症特效药之类的……』"   voices=""/><msg @l="170" char_id="-1" frame_id="-1" name="熊野"   text="『绝对不会在检查中被发现的兴奋剂和安全可靠的勃起药物。如果能比其他公司先实现这些，肯定能创造巨额财富。为此才请稻庭先生帮忙的。』"   voices=""/><msg @l="172" char_id="0" frame_id="1" name="美帆" text="『这和稻庭学长有什么……啊！』"   voices=""/><msg @l="174" char_id="-1" frame_id="-1" name="熊野"   text="『没错，稻庭先生是同时具备这两个条件的少数成功案例之一。』" voices=""/><msg @l="176" char_id="-1" frame_id="-1" name="稻庭"   text="『只是，要完善它还需要大量数据。于是，我把网球社改造成强奸社，把改良后的药物以壮阳药、迷幻药的名义让社员服用。』"   voices=""/><char @l="179" id="inaba" pos="left" src="inaba050"/><msg @l="181" char_id="-1" frame_id="-1" name="稻庭" text="『结果是……如你所见。』"   voices=""/><clear @l="184" class="char"/><msg @l="186" char_id="-1" frame_id="-1" name=""   text="环顾四周，男生们正专心致志地侵犯着女生们。" voices=""/><msg @l="187" char_id="-1" frame_id="-1" name=""   text="即使射精多次也不会疲软，眼前上演着一场不知何时才会结束的强奸表演。" voices=""/><char @l="190" id="miho" pos="auto" src="miho055"/><msg @l="192" char_id="0" frame_id="1" name="美帆"   text="『啊……那，那么，玲学姐怎么样？玲学姐什么都没说过网球社的事。为什么会这样？是因为稻庭学长喜欢玲学姐……所以到现在都没对她下手吗？』"   voices=""/><msg @l="194" char_id="-1" frame_id="-1" name="" text="我拼命地质问着稻庭学长。"   voices=""/><msg @l="195" char_id="-1" frame_id="-1" name=""   text="在这样的强奸社团里，像玲学姐这样的美人不可能不受害。" voices=""/><clear @l="198" class="char"/><char @l="200" id="inaba" pos="left" src="inaba050"/><char @l="202" id="miho" pos="right" src="miho055"/><msg @l="205" char_id="-1" frame_id="-1" name="稻庭"   text="『确实……玲从大学入学时起就是一个美丽而引人注目的存在。但是，像她这样正义感强的女性拉入伙伴圈风险太大。最终，那个在老师眼中表现良好又被同性信任的她只能被用作表面网球部的宣传招牌罢了。』"   voices=""/><msg @l="207" char_id="0" frame_id="1" name="美帆" text="『这，这种……怎么会这样。』"   voices=""/><msg @l="209" char_id="-1" frame_id="-1" name="稻庭"   text="『而且呢，我只对处女的子宫才能满足……也就是说，我对像玲这样污秽的女人没兴趣。』" voices=""/><msg @l="211" char_id="0" frame_id="1" name="美帆" text="『太，太过分了……。』" voices=""/><msg @l="213" char_id="-1" frame_id="-1" name="稻庭" text="『很遗憾，我只是说了事实而已。』"   voices=""/><msg @l="215" char_id="-1" frame_id="-1" name="男会员E"   text="『会长，差不多该走了，否则二次会就要……』" voices=""/><msg @l="217" char_id="-1" frame_id="-1" name=""   text="突然，一名男子走过来对稻庭学长耳语。" voices=""/><clear @l="220" class="char"/><char @l="222" id="inaba" pos="center" src="inaba050f" y="-80"/><msg @l="225" char_id="-1" frame_id="-1" name="稻庭" text="『喂喂，你给我察言观色啊，副会长。』"   voices=""/><msg @l="227" char_id="-1" frame_id="-1" name=""   text="学长伸出右臂，小指竖立，瞪着副会长。" voices=""/><msg @l="228" char_id="-1" frame_id="-1" name="" text="表情虽带着笑容，但眼睛却完全没有笑意。"   voices=""/><msg @l="230" char_id="-1" frame_id="-1" name="男会员E" text="『……十，十分抱歉！』"   voices=""/><msg @l="232" char_id="-1" frame_id="-1" name=""   text="副会长看了看学长和我两人，似乎察觉到了什么，便跑开了。" voices=""/><clear @l="234" class="char"/><char @l="236" id="inaba" pos="auto" src="inaba050"/><msg @l="239" char_id="-1" frame_id="-1" name="稻庭"   text="『对现在的我来说，比起二次会，眼前的你更重要啊。』" voices=""/><clear @l="242" class="char"/><char @l="244" id="inaba" pos="left" src="inaba050"/><char @l="246" id="miho" pos="right" src="miho054"/><msg @l="248" char_id="0" frame_id="1" name="美帆" text="『啊？』" voices=""/><msg @l="250" char_id="0" frame_id="1" name="美帆" text="（这，这是什么……意思？）"   voices=""/><stopbgm @l="253" fadeout="1000"/><msg @l="255" char_id="-1" frame_id="-1" name="稻庭"   text="『我的欲望啊……如果不能品尝像你这样极品的处女肉的话，是无法得到满足的，仲根美帆同学。』" voices=""/><msg @l="257" char_id="0" frame_id="1" name="美帆" text="『啊啊！？』" voices=""/><bgm @l="260" src="bgm08" volume="1."/><msg @l="262" char_id="-1" frame_id="-1" name="" text="我发不出声音。" voices=""/><msg @l="263" char_id="-1" frame_id="-1" name=""   text="为什么，这个人怎么会知道我是处女的事情。" voices=""/><msg @l="265" char_id="-1" frame_id="-1" name="稻庭"   text="『你看起来很疑惑啊……对于散过几百个处女的我来说，分辨是不是处女这种事简直轻而易举。』" voices=""/><char @l="268" id="miho" pos="right" src="miho055"/><msg @l="270" char_id="0" frame_id="1" name="美帆" text="『这种……请饶了我吧。』"   voices=""/><msg @l="272" char_id="-1" frame_id="-1" name="稻庭"   text="『这样啊……幸运的是现在药物的副作用也不是很明显。如果你能用别的方式让我满足的话，我也可以放你走。』" voices=""/><msg @l="274" char_id="0" frame_id="1" name="美帆" text="『我该怎么做呢？』"   voices=""/><clear @l="277" class="char"/><char @l="279" id="inaba" pos="center" src="inaba050f" y="-80"/><msg @l="281" char_id="-1" frame_id="-1" name="稻庭"   text="『让这里的所有成员都满足，用你的嘴代替那里，懂吗？』" voices=""/><msg @l="283" char_id="-1" frame_id="-1" name=""   text="学长的提议，在正常情况下是无法想象的荒谬。" voices=""/><msg @l="284" char_id="-1" frame_id="-1" name="" text="但是……。" voices=""/><stopbgm @l="287" fadeout="1000"/><clear @l="290" class="char"/><char @l="292" id="miho" pos="auto" src="miho055"/><msg @l="294" char_id="0" frame_id="1" name="美帆" text="『我明白了，用嘴……来做。』"   voices=""/><msg @l="296" char_id="-1" frame_id="-1" name="" text="我当时脱口而出这样说了。"   voices=""/><msg @l="297" char_id="-1" frame_id="-1" name=""   text="这句话是出于不想因为这种事失去处女之身的一心，但仔细一想，用嘴做这种事对我来说也是第一次。" voices=""/><msg @l="298" char_id="-1" frame_id="-1" name=""   text="无论如何……我的第一次还是会被夺走。" voices=""/><msg @l="300" char_id="0" frame_id="1" name="美帆" text="『……。』" voices=""/><msg @l="302" char_id="0" frame_id="1" name="美帆" text="（但是……如果这样就结束的话）"   voices=""/><clear @l="310" class="all"/><label @l="313" id="event_scene16"/><msgshow @l="316" show="true"/><label @l="320" id="chart_line54"/><wait_chgmv/><ev @l="324" src="ev-016"/><description @l="327" text="敗者の処刑"/><bgm @l="331" src="bgm14" volume="1."/><msg @l="333" char_id="-1" frame_id="-1" name=""   text="我第一次近距离看到那个无比丑陋的欲望之物，顿时一阵厌恶感涌上心头。" voices=""/><msg @l="335" char_id="0" frame_id="1" name="美帆" text="『唔……。』"   voices="miho05680"/><msg @l="337" char_id="-1" frame_id="-1" name=""   text="在含住那个还略显柔软的东西的瞬间，我的口腔内弥漫开了之前从未体验过的味道和气味。" voices=""/><msg @l="338" char_id="-1" frame_id="-1" name=""   text="第一次含住那个东西……我不禁感到一阵恶心。" voices=""/><msg @l="339" char_id="-1" frame_id="-1" name=""   text="一边对那种腥味或者说青涩的气味和味道感到困惑，我将那个东西的前端完全含入口中后停止了动作。"   voices=""/><msg @l="341" char_id="0" frame_id="1" name="美帆" text="『……。』"   voices="miho05690"/><msg @l="343" char_id="-1" frame_id="-1" name="男会员A" text="『怎么了，怎么回事？』"   voices=""/><msg @l="345" char_id="0" frame_id="1" name="美帆"   text="『那个……接下来，我该怎么做呢？』" voices="miho05700//咥えたまましゃべってます"/><msg @l="347" char_id="-1" frame_id="-1" name="男会员A"   text="『啊？你不知道口交怎么做吗！？』" voices=""/><msg @l="349" char_id="0" frame_id="1" name="美帆" text="『对、对不起……。』"   voices="miho05710//咥えたまましゃべってます"/><msg @l="351" char_id="-1" frame_id="-1" name="男会员A"   text="『那，我来教你，你要好好舔啊。』" voices=""/><msg @l="353" char_id="0" frame_id="1" name="美帆" text="『好、好的。』"   voices="miho05720"/><msg @l="355" char_id="-1" frame_id="-1" name="男会员A"   text="『首先用舌头舔舐。』" voices=""/><msg @l="357" char_id="0" frame_id="1" name="美帆"   text="『嗯……舔、舔……舔……。』" voices="miho05730"/><msg @l="359" char_id="-1" frame_id="-1" name=""   text="我按照他的指示，在口中用舌头舔舐着男根。" voices=""/><msg @l="360" char_id="-1" frame_id="-1" name=""   text="舌尖触碰到的那种感觉又是如此奇怪……我不由得皱起了眉头。" voices=""/><msg @l="362" char_id="-1" frame_id="-1" name="男会员A"   text="『就那样像涂抹唾液一样继续舔。』" voices=""/><msg @l="364" char_id="0" frame_id="1" name="美帆"   text="『嗯咕……嗯，啾……啾咯……啾咯…………。』" voices="miho05740"/><msg @l="366" char_id="-1" frame_id="-1" name=""   text="把排尿的器官含在嘴里，只能让我觉得很肮脏。忍受着一次又一次涌上来的胃液，继续舔着。" voices=""/><msg @l="368" char_id="-1" frame_id="-1" name="男会员A"   text="『哦，感觉不错……那么接下来吸顶端。』" voices=""/><msg @l="370" char_id="0" frame_id="1" name="美帆" text="『嗯……。』"   voices="miho05750"/><msg @l="372" char_id="-1" frame_id="-1" name=""   text="按照他说的，我撅起嘴唇吸吮着顶端。" voices=""/><msg @l="374" char_id="-1" frame_id="-1" name="男会员A"   text="『吸得太用力的话只会疼，所以要轻柔地吸，同时时而收紧时而放松嘴唇。』" voices=""/><msg @l="376" char_id="0" frame_id="1" name="美帆"   text="『呼……嗯，嗯嗯……啾……嗯，啾噜噜。』" voices="miho05760"/><msg @l="378" char_id="-1" frame_id="-1" name="男会员A" text="『哦？刚才那下还不错嘛。』"   voices=""/><msg @l="380" char_id="-1" frame_id="-1" name=""   text="听着他高兴的话语，我只觉得强迫别人觉得这种事情很舒服的男性是多么的不讲理。" voices=""/><msg @l="382" char_id="-1" frame_id="-1" name="男会员A"   text="『那么……接下来像刚才那样轻轻吸着，同时前后摆动头部，用嘴唇来套弄。』" voices=""/><msg @l="384" char_id="0" frame_id="1" name="美帆" text="『嗯……啾…………。』"   voices="miho05770"/><msg @l="386" char_id="-1" frame_id="-1" name="" text="我试着慢慢地动了一下头。"   voices=""/><msg @l="387" char_id="-1" frame_id="-1" name=""   text="从我嘴边漏出的唾液发出的水声听起来异常淫靡，让我感到难为情。" voices=""/><msg @l="389" char_id="-1" frame_id="-1" name="男会员A"   text="『不用含太深。碰到喉咙深处会恶心的。』" voices=""/><msg @l="391" char_id="0" frame_id="1" name="美帆"   text="『啾……嗯，嗯咕……啾………啾……。』" voices="miho05780"/><msg @l="393" char_id="-1" frame_id="-1" name="男会员A"   text="『对……就是那种感觉……就那样继续。』" voices=""/><msg @l="395" char_id="-1" frame_id="-1" name=""   text="那肉块上青筋凸起如蚯蚓，一跳一跳地脉动着。" voices=""/><msg @l="397" char_id="0" frame_id="1" name="美帆"   text="『嗯嗯……嗯，啾，啾………嗯咕，啾。』" voices="miho05790"/><msg @l="399" char_id="-1" frame_id="-1" name=""   text="我照着他教我的那样，浅浅地用嘴唇套弄着前端部分。" voices=""/><msg @l="400" char_id="-1" frame_id="-1" name=""   text="就这样持续着，嘴里的那东西逐渐变硬变大。" voices=""/><msg @l="402" char_id="0" frame_id="1" name="美帆"   text="『嗯……啾，嗯嗯……啾，啾，啾。』" voices="miho05800"/><msg @l="404" char_id="-1" frame_id="-1" name="男会员A"   text="『不错，就那样继续，注意别碰到牙齿。』" voices=""/><msg @l="406" char_id="0" frame_id="1" name="美帆"   text="『嗯呼……嗯嗯………啾，嗯……嗯嗯………。』" voices="miho05810"/><msg @l="408" char_id="-1" frame_id="-1" name=""   text="我大大张开嘴，用嘴唇和舌头小心不让牙齿碰到，继续吮吸着那个。" voices=""/><msg @l="409" char_id="-1" frame_id="-1" name=""   text="当舌尖碰到前端明显缩进的部分时，男人的腰抖动了一下。" voices=""/><msg @l="411" char_id="0" frame_id="1" name="美帆" text="『嗯……？』"   voices="miho05820"/><msg @l="413" char_id="-1" frame_id="-1" name="男会员A"   text="『那里是男人的敏感点……你给我记住了！』" voices=""/><msg @l="415" char_id="0" frame_id="1" name="美帆" text="『嗯……嗯，啾。』"   voices="miho05830"/><msg @l="417" char_id="0" frame_id="1" name="美帆"   text="『啊呜、嗯……嗯啾、啾噜……嗯……嗯噗……。』" voices="miho05840"/><msg @l="419" char_id="-1" frame_id="-1" name="" text="因为憋气让我眼前一片模糊。"   voices=""/><msg @l="420" char_id="-1" frame_id="-1" name=""   text="尽管如此，我也不能停止服务，为了让他尽快满足，我继续吮吸着。" voices=""/><msg @l="422" char_id="-1" frame_id="-1" name="男会员A"   text="『啊啊，真不错……就那样重点舔前端部分。』" voices=""/><msg @l="424" char_id="0" frame_id="1" name="美帆"   text="『嗯，啾噗……啾……啾噜……啾噗，啾噗，啾噗。』" voices="miho05850"/><msg @l="426" char_id="-1" frame_id="-1" name="男会员A" text="『咕……。』"   voices=""/><msg @l="428" char_id="0" frame_id="1" name="美帆"   text="（呜啊……从前端流出了什么东西…………）" voices="miho05860"/><msg @l="430" char_id="-1" frame_id="-1" name=""   text="男人短促地发出声音并颤抖腰部时，他的前端相应地渗出了透明而苦涩的液体。虽然感到恶心而颤抖，但我仍然继续舔着。"   voices=""/><msg @l="432" char_id="-1" frame_id="-1" name="男会员A" text="『我、我快要射了……。』"   voices=""/><msg @l="434" char_id="0" frame_id="1" name="美帆"   text="『嗯嗯……啾噗，嗯，啾噗，啾噗，啾噗……。』" voices="miho05870"/><msg @l="436" char_id="0" frame_id="1" name="美帆"   text="『啾噜……唔，嗯……唔咕……咕，啾噜噜。』" voices="miho05880"/><msg @l="438" char_id="-1" frame_id="-1" name="男会员A"   text="『呃……要，要射了……是射在脸上还是嘴里好？』" voices=""/><msg @l="442" async="true" char_id="-1" frame_id="-1" name=""   text="要让我射在哪里……？" voices=""/><select @l="443"><menu @l="447" label="TempLabel_304" text="脸上"/><menu @l="450" label="TempLabel_306" text="嘴里"/></select><goto @l="455" label="TempLabel_305"/><label @l="457" id="TempLabel_304"/><eval @l="459" expr="f.稲庭ルート即席02flag&#32;=&#32;1&#13;&#10;"/><goto @l="460" label="TempLabel_305"/><label @l="462" id="TempLabel_306"/><eval @l="464" expr="f.稲庭ルート即席02flag&#32;=&#32;2&#13;&#10;"/><goto @l="465" label="TempLabel_305"/><label @l="467" id="TempLabel_305"/><label @l="471" id="EventLabel_97"/><goto @l="474" cond="!(f.稲庭ルート即席02flag&#32;==&#32;1)&#13;&#10;"   label="TempLabel_307"/><msg @l="476" char_id="0" frame_id="1" name="美帆" text="『那，那就射在脸上吧……。』"   voices="miho05890"/><msg @l="478" char_id="-1" frame_id="-1" name=""   text="男孩子会射精这件事……就算是我也是知道的。" voices=""/><msg @l="479" char_id="-1" frame_id="-1" name=""   text="然而，对于用嘴接精液这种事，我还是感到抵触，所以不得已选择了“脸上”。" voices=""/><msg @l="481" char_id="-1" frame_id="-1" name="男会员A"   text="『好啊，那我就把精液满满地射在你脸上！』" voices=""/><msg @l="483" char_id="0" frame_id="1" name="美帆" text="『好，好的。』"   voices="miho05900"/><flash @l="487" count="4" fade="100" image="white"/><wait_chgmv/><ev @l="491" src="ev-016x1z1"/><msg @l="493" char_id="0" frame_id="1" name="美帆" text="『嗯嗯！！！』"   voices="miho05910"/><msg @l="495" char_id="-1" frame_id="-1" name=""   text="与男子腰部震颤的同时，从前端喷出大量乳白色的液体，玷污了我的脸。刺鼻的腥臭刺激着我的鼻腔，我不禁打了个寒颤。"   voices=""/><msg @l="497" char_id="0" frame_id="1" name="美帆"   text="(好厉害……居然能射出这么多………)" voices="miho05920"/><msg @l="499" char_id="-1" frame_id="-1" name=""   text="这是否是那种增强剂的效果，我并不清楚，但对于不断溢出的那个东西，确实让人感到压倒性的震撼。" voices=""/><goto @l="502" label="TempLabel_308"/><label @l="503" id="TempLabel_307"/><msg @l="506" char_id="0" frame_id="1" name="美帆" text="『请……射在嘴里。』"   voices="miho05930"/><msg @l="508" char_id="-1" frame_id="-1" name=""   text="一心只想着不要弄脏网球服的我，就这样回答了。" voices=""/><msg @l="509" char_id="-1" frame_id="-1" name=""   text="仔细想想，这意味着我必须用嘴接住从前端溢出的精液……但当我意识到这一点时，已经太晚了。"   voices=""/><msg @l="511" char_id="-1" frame_id="-1" name="男会员A"   text="『好，那就好好含着。』" voices=""/><msg @l="513" char_id="0" frame_id="1" name="美帆" text="『唔咕……嗯，唔姆。』"   voices="miho05940"/><msg @l="515" char_id="-1" frame_id="-1" name="男会员A" text="『要，要射了！』"   voices=""/><flash @l="519" count="4" fade="100" image="white"/><wait_chgmv/><ev @l="523" src="ev-016x1z4"/><msg @l="525" char_id="0" frame_id="1" name="美帆" text="『呜呜！！』"   voices="miho05950"/><msg @l="527" char_id="-1" frame_id="-1" name=""   text="男子的前端瞬间膨胀起来，随即从那里猛烈地喷射出热液，注入我的口腔内。" voices=""/><msg @l="529" char_id="-1" frame_id="-1" name="男会员A"   text="『哦，哦哦……给我一滴不剩地全部吞下去。』" voices=""/><msg @l="531" char_id="0" frame_id="1" name="美帆"   text="『呜，呜呜……呜……呜咕……呜咕……。』" voices="miho05960"/><msg @l="533" char_id="-1" frame_id="-1" name=""   text="虽然有所抵抗，但因为不断喷出的精液让我无法呼吸，我终于忍不住了，咕咚一声吞下了那些液体。"   voices=""/><msg @l="534" char_id="-1" frame_id="-1" name=""   text="那粘稠的液体缠绕在喉咙里的感觉引起了厌恶感。我强忍住了差点要咳嗽的冲动。" voices=""/><msg @l="535" char_id="-1" frame_id="-1" name="" text="眼中的泪水滴落下来。"   voices=""/><msg @l="537" char_id="-1" frame_id="-1" name="男会员A"   text="『不错，就这样吸住前端，把里面剩下的也全部喝干净。』" voices=""/><msg @l="539" char_id="0" frame_id="1" name="美帆"   text="『呜咕……呜……啾噗……呜，啾噜噜噜噜。』" voices="miho05970"/><label @l="542" id="TempLabel_308"/><clear @l="549" class="all"/><msg @l="551" char_id="-1" frame_id="-1" name="男会员A"   text="『好～嘞，那就换下一个人了。』" voices=""/><msg @l="553" char_id="0" frame_id="1" name="美帆" text="『啊……已经，要换了吗？』"   voices="miho05980"/><msg @l="555" char_id="0" frame_id="1" name="美帆" text="『能不能，让我休息一下……。』"   voices="miho05990"/><msg @l="557" char_id="-1" frame_id="-1" name="男会员A"   text="『你在说什么啊，不一个接一个做的话天都要黑了吧？』" voices=""/><msg @l="559" char_id="0" frame_id="1" name="美帆" text="『………。』"   voices="miho06000"/><msg @l="561" char_id="-1" frame_id="-1" name="男会员B"   text="『喂，赶紧让开。现在轮到我了！！』" voices=""/><msg @l="563" char_id="-1" frame_id="-1" name="男会员A" text="『知道了啦。』"   voices=""/><msg @l="565" char_id="-1" frame_id="-1" name=""   text="他们完全不把无言的我放在心上，下一个男人从胯下掏出性器，伸到我的眼前。然后，把它压在我的脸上。"   voices=""/><msg @l="567" char_id="-1" frame_id="-1" name=""   text="阴茎的灼热触感传到我的脸颊。男人像钟摆一样啪啪地把那玩意儿贴在我脸上，催促我快点。" voices=""/><msg @l="568" char_id="-1" frame_id="-1" name=""   text="我因那散发出的难以形容的性臭而皱起了脸。" voices=""/><msg @l="570" char_id="-1" frame_id="-1" name=""   text="然而，无论我如何恳求，这些胯下高高鼓起的男人们都不会放过我。不仅如此，如果我表现出奇怪的态度，可能会惹恼熊野，进而连玲小姐也会受到伤害……。那是我最想避免的。"   voices=""/><msg @l="572" char_id="-1" frame_id="-1" name=""   text="现在我只能尽力服侍眼前这些野兽般的人，并且希望能得到熊野满意的结果……已经没有逃避的余地了。"   voices=""/><msg @l="574" char_id="-1" frame_id="-1" name="男会员B"   text="『好了……给我好好舔啊。』" voices=""/><msg @l="576" char_id="0" frame_id="1" name="美帆" text="『……是。』"   voices="miho06010"/><clear @l="582" class="all"/><msgshow @l="584" show="true"/><goto @l="587" cond="!(f.稲庭ルート即席02flag&#32;==&#32;1)&#13;&#10;"   label="TempLabel_309"/><wait_chgmv/><ev @l="591" src="ev-016x1z1"/><goto @l="594" label="TempLabel_310"/><label @l="595" id="TempLabel_309"/><wait_chgmv/><ev @l="600" src="ev-016x1z4"/><label @l="603" id="TempLabel_310"/><msg @l="606" char_id="0" frame_id="1" name="美帆" text="『嗯，啊呜……。』"   voices="miho06020"/><msg @l="608" char_id="-1" frame_id="-1" name="男会员B"   text="『哦，嘴里好温暖啊……。』" voices=""/><msg @l="610" char_id="-1" frame_id="-1" name=""   text="当我含住前端时，男人颤抖着腰肢，发出欢愉的声音。" voices=""/><msg @l="611" char_id="-1" frame_id="-1" name=""   text="听着这声音，我怀着复杂的心情……开始了服侍。" voices=""/><msg @l="613" char_id="0" frame_id="1" name="美帆"   text="『嗯噗……嗯，嗯咕……啾噗，啾噗噗。』" voices="miho06030"/><msg @l="615" char_id="-1" frame_id="-1" name=""   text="我将前端含在口腔里，用舌尖涂抹唾液。" voices=""/><msg @l="616" char_id="-1" frame_id="-1" name=""   text="我只是按照被教导的方式一遍遍重复着，但无论怎么忍耐，恶心感都无法停止。" voices=""/><msg @l="618" char_id="-1" frame_id="-1" name="男会员B"   text="『不错，就这样嘴里含着唾液，试着动动头。』" voices=""/><msg @l="620" char_id="0" frame_id="1" name="美帆" text="『嗯唔……嗯……。』"   voices="miho06040"/><msg @l="622" char_id="0" frame_id="1" name="美帆"   text="『嗯咕……啾噗……啾，啾噗……啾噗噗噗。』" voices="miho06050"/><msg @l="624" char_id="-1" frame_id="-1" name=""   text="我将唾液充满口腔，缓缓摇动头部。" voices=""/><msg @l="625" char_id="-1" frame_id="-1" name=""   text="为了防止唾液溢出，我紧闭嘴唇，而口腔内的勃起物似乎对此有所反应，猛地跳动了一下。" voices=""/><msg @l="627" char_id="-1" frame_id="-1" name="男会员B"   text="『对对……很好，再多做一些。』" voices=""/><msg @l="629" char_id="0" frame_id="1" name="美帆"   text="『啾噗……嗯，嗯嗯……嗯噗，啾，啾噗，啾噗。』" voices="miho06060"/><msg @l="631" char_id="-1" frame_id="-1" name=""   text="每当我摇动头部，淫靡的水声就从我口中响起。" voices=""/><msg @l="632" char_id="-1" frame_id="-1" name=""   text="与感到无比羞耻的我相反，让我含住的男人却满意地放松了嘴角。" voices=""/><msg @l="634" char_id="0" frame_id="1" name="美帆"   text="『嗯唔……嗯，啾噗……啾噜，啾噜噜。』" voices="miho06070"/><msg @l="636" char_id="0" frame_id="1" name="美帆"   text="『嗯，嗯，嗯……啾噗，唔……嗯嗯嗯！』" voices="miho06080"/><msg @l="638" char_id="-1" frame_id="-1" name="男会员B"   text="『你挺厉害的……仲根……你真的是第一次吗？』" voices=""/><msg @l="640" char_id="0" frame_id="1" name="美帆" text="『唔嗯……』"   voices="miho06090"/><msg @l="642" char_id="-1" frame_id="-1" name=""   text="我不由自主地停止了嘴巴的动作，剧烈地上下点着头。'不是第一次'……对我来说，这是令人难以置信地羞耻的话语。"   voices=""/><msg @l="644" char_id="-1" frame_id="-1" name="男会员B"   text="『知道了，别那么生气嘛……继续吧。』" voices=""/><msg @l="646" char_id="0" frame_id="1" name="美帆"   text="『啾姆……嗯，唔……呼，嗯，嗯，嗯。』" voices="miho06100"/><msg @l="648" char_id="0" frame_id="1" name="美帆"   text="『啾噗，啾噗，啾噗……唔，嗯，啾噜噜。』" voices="miho06110"/><msg @l="650" char_id="-1" frame_id="-1" name="男会员B"   text="『呃，太棒了……你真有天赋啊？』" voices=""/><msg @l="652" char_id="-1" frame_id="-1" name=""   text="对这种事情有天赋一点也不高兴。与其说是这样，不如说接近于羞辱。" voices=""/><msg @l="653" char_id="-1" frame_id="-1" name=""   text="忍受着羞耻，我拼命地吮吸着男人的肉棒。" voices=""/><msg @l="655" char_id="0" frame_id="1" name="美帆"   text="『嗯呼，嗯，嗯……啾噗……汁，啾噗噗。』" voices="miho06120"/><msg @l="657" char_id="-1" frame_id="-1" name=""   text="我轻轻地含住前端部分，舔舐着据说很敏感的龟头根部。" voices=""/><msg @l="659" char_id="-1" frame_id="-1" name="男会员B"   text="『哦，哦哦……太棒了仲根……简直爽爆了。你的嘴像小穴一样舒服极了。』" voices=""/><msg @l="661" char_id="-1" frame_id="-1" name="男会员B"   text="『就是口交穴啊！仲根！！从今天起你的外号就叫「口交穴」！！哈哈……』" voices=""/><msg @l="663" char_id="0" frame_id="1" name="美帆" text="『嗯姆……？』"   voices="miho06130"/><msg @l="665" char_id="-1" frame_id="-1" name=""   text="眼看就要被取上这种离谱的外号，我摇头表示拒绝。然而，没想到这个举动反而更加挑起男人的性欲。"   voices=""/><msg @l="667" char_id="-1" frame_id="-1" name="男会员B"   text="『哦哦！太棒了仲根！那表情真让人兴奋。你那可爱的脸因为我的肉棒而扭曲的样子简直绝了。』" voices=""/><msg @l="669" char_id="-1" frame_id="-1" name="男会员B"   text="『还有，舔舔尿道吧。我喜欢被刺激尿道的感觉。』" voices=""/><msg @l="671" char_id="-1" frame_id="-1" name=""   text="他的喜好对我来说无所谓，但我想如果舔那里的话就能从这种痛苦中解脱……这么想着，我勉强决定舔那个地方。"   voices=""/><msg @l="672" char_id="-1" frame_id="-1" name=""   text="但我不知道尿道在哪里……我用眼神询问他那个地方到底在哪。" voices=""/><msg @l="674" char_id="-1" frame_id="-1" name="男会员B"   text="『哦！太棒了。那个上目线的眼神。你真的很懂男人的弱点啊……你有性爱天赋啊。』" voices=""/><msg @l="676" char_id="-1" frame_id="-1" name=""   text="我本想反驳说不需要那种天赋……但嘴巴被粗大的肉块堵住了。现在必须做的事，是让这个男人尽快射精……这样告诫自己后，我再次用眼神询问他。"   voices=""/><msg @l="678" char_id="-1" frame_id="-1" name="男会员B"   text="『啊？尿道啊，那个是……龟头上有个小孔吧？用舌尖在那里轻轻舔舐。』" voices=""/><msg @l="680" char_id="0" frame_id="1" name="美帆"   text="『嗯……唔，啾噗……嗯姆，舔舔舔舔舔。』" voices="miho06140"/><msg @l="682" char_id="-1" frame_id="-1" name="男会员B"   text="『咕，太厉害了……要，要出来了！！』" voices=""/><flash @l="686" count="4" fade="100" image="white"/><goto @l="689" cond="!(f.稲庭ルート即席02flag&#32;==&#32;1)&#13;&#10;"   label="TempLabel_311"/><wait_chgmv/><ev @l="693" src="ev-016x1z1z2"/><msg @l="695" char_id="0" frame_id="1" name="美帆" text="『嗯哈！！』"   voices="miho06150"/><msg @l="697" char_id="-1" frame_id="-1" name=""   text="男人腰部颤抖着，从我口腔中抽出肉棒。" voices=""/><msg @l="698" char_id="-1" frame_id="-1" name=""   text="然后他自己套弄了几下勃起的肉棒，大量精液喷射出来，弄脏了我的脸。" voices=""/><goto @l="701" label="TempLabel_312"/><label @l="702" id="TempLabel_311"/><wait_chgmv/><ev @l="707" src="ev-016z4z5"/><msg @l="709" char_id="0" frame_id="1" name="美帆" text="『嗯姆！！』"   voices="miho06160"/><msg @l="711" char_id="-1" frame_id="-1" name=""   text="之前在肉棒前端爬行的舌头上，大量精液溢了出来。" voices=""/><msg @l="713" char_id="0" frame_id="1" name="美帆"   text="『嗯呼……嗯、嗯咕……嗯咕……啾、啾噗。』" voices="miho06170"/><msg @l="715" char_id="-1" frame_id="-1" name=""   text="这次在口腔被灌满之前，我一点点地将精液送入喉咙深处吞咽下去。那温热的液体粘稠地通过喉咙。我皱着眉头，忍住想要呕吐的感觉，吞了下去。"   voices=""/><label @l="718" id="TempLabel_312"/><clear @l="725" class="all"/><msg @l="727" char_id="-1" frame_id="-1" name="男会员B"   text="『呼……太厉害了，射了好多啊。』" voices=""/><msg @l="729" char_id="-1" frame_id="-1" name=""   text="当他射完所有精液后，刚才让我含着的他很快就站起身来，准备与下一个人交换位置。" voices=""/><msg @l="730" char_id="-1" frame_id="-1" name=""   text="而我……只能顺从地将下一根递到面前的男根含入口中。" voices=""/><clear @l="736" class="all"/><msgshow @l="738" show="true"/><goto @l="741" cond="!(f.稲庭ルート即席02flag&#32;==&#32;1)&#13;&#10;"   label="TempLabel_313"/><wait_chgmv/><ev @l="745" src="ev-016x1z1z2"/><goto @l="748" label="TempLabel_314"/><label @l="749" id="TempLabel_313"/><wait_chgmv/><ev @l="754" src="ev-016z4z5"/><label @l="756" id="TempLabel_314"/><msg @l="759" char_id="0" frame_id="1" name="美帆"   text="『啾噗，嗯……啾噗，啾噗……。』" voices="miho06180"/><msg @l="761" char_id="-1" frame_id="-1" name="男会员C"   text="『啊，啊啊……好舒服啊……。』" voices=""/><msg @l="763" char_id="-1" frame_id="-1" name=""   text="每当在口中摩擦，他就会颤抖着腰部，发出欢愉的声音。" voices=""/><msg @l="764" char_id="-1" frame_id="-1" name=""   text="明明才刚含入没多久，他的那话儿已经硬邦邦了。" voices=""/><msg @l="766" char_id="0" frame_id="1" name="美帆"   text="(呜啊……太厉害了，好像马上就要射了)" voices="miho06190"/><msg @l="768" char_id="-1" frame_id="-1" name=""   text="我为了加速他的快感，紧紧缩起嘴唇，浅浅地摩擦着龟头的凹陷处。" voices=""/><msg @l="770" char_id="0" frame_id="1" name="美帆"   text="『嗯噗……嗯，啾噗……啾噗，啾噗，啾噗。』" voices="miho06200"/><msg @l="772" char_id="-1" frame_id="-1" name=""   text="下巴已经疲惫不堪，嘴角不断有起泡的白色唾液丝缓缓滴落。" voices=""/><msg @l="774" char_id="-1" frame_id="-1" name="男会员C"   text="『哇，哇啊啊……这样弄的话！』" voices=""/><msg @l="776" char_id="0" frame_id="1" name="美帆"   text="『嗯……嗯咕，啾噗，啾噗噗，啾噜噜噜。』" voices="miho06210"/><msg @l="778" char_id="-1" frame_id="-1" name="男会员C"   text="『啊，啊啊……要出来了，要出来了！』" voices=""/><flash @l="782" count="4" fade="100" image="white"/><goto @l="785" cond="!(f.稲庭ルート即席02flag&#32;==&#32;1)&#13;&#10;"   label="TempLabel_315"/><wait_chgmv/><ev @l="789" src="ev-016x1z1z2z3"/><msg @l="791" char_id="0" frame_id="1" name="美帆" text="『嗯，呼啊！！』"   voices="miho06220"/><msg @l="793" char_id="-1" frame_id="-1" name=""   text="男人朝着我的脸射精。这已经是第3个男人了……" voices=""/><msg @l="794" char_id="-1" frame_id="-1" name=""   text="我的脸已经被精液弄得一塌糊涂……连睁开眼睛都很勉强。" voices=""/><msg @l="795" char_id="-1" frame_id="-1" name=""   text="想到自己被这样羞辱的样子，泪水不禁涌了出来。" voices=""/><goto @l="798" label="TempLabel_316"/><label @l="799" id="TempLabel_315"/><wait_chgmv/><ev @l="804" src="ev-016z4z5z6"/><msg @l="806" char_id="0" frame_id="1" name="美帆"   text="『嗯嗯……嗯………嗯咕………。』" voices="miho06230"/><msg @l="808" char_id="0" frame_id="1" name="美帆"   text="『啾噗……啾姆……嗯，嗯嗯……嗯库，嗯库。』" voices="miho06240"/><msg @l="810" char_id="-1" frame_id="-1" name=""   text="在射精的瞬间，我紧紧地缩起嘴唇促使其发生。" voices=""/><msg @l="811" char_id="-1" frame_id="-1" name=""   text="然后，慢慢地发出吞咽的声音，将大量射入口腔的精液咽了下去。当感觉到那污浊的液体通过喉咙时，泪水不禁渗了出来。"   voices=""/><label @l="814" id="TempLabel_316"/><stopbgm @l="819" fadeout="1000"/><clear @l="824" class="all"/><end_scene @l="827"/><wait_chgmv/><bg @l="831" src="bg13a"/><bgm @l="835" src="bgm15" volume="1."/><char @l="838" id="miho" pos="auto" src="miho055"/><msg @l="840" char_id="0" frame_id="1" name="美帆" text="『已、已经结束了……。』"   voices=""/><msg @l="842" char_id="-1" frame_id="-1" name=""   text="当漫长的口交服务终于结束时，太阳已经西斜，天色已至黄昏。" voices=""/><msg @l="843" char_id="-1" frame_id="-1" name=""   text="我大口喘着气，看向前辈的方向。" voices=""/><msg @l="845" char_id="0" frame_id="1" name="美帆" text="『这样……可以原谅我了吗？』"   voices=""/><clear @l="848" class="char"/><char @l="850" id="inaba" pos="left" src="inaba050"/><char @l="852" id="miho" pos="right" src="miho055"/><msg @l="854" char_id="-1" frame_id="-1" name="稻庭" text="『嗯，做得很好。』"   voices=""/><msg @l="856" char_id="-1" frame_id="-1" name=""   text="终于可以解脱了……由于疲劳和释然的感觉，我全身的力气一下子泄光了。" voices=""/><msg @l="858" char_id="-1" frame_id="-1" name="稻庭"   text="『仲根同学，能不能最后去一趟社团活动室？』" voices=""/><msg @l="860" char_id="0" frame_id="1" name="美帆" text="『这是什么意思？』" voices=""/><msg @l="862" char_id="-1" frame_id="-1" name="稻庭"   text="『我想让你写一份不向外泄露社团秘密的保证书。作为交换，我也会写一份不对你动手的保证书。』"   voices=""/><msg @l="864" char_id="-1" frame_id="-1" name=""   text="可能是因为完全放心了，我跟着稻庭前辈一起前往活动室。" voices=""/><msg @l="865" char_id="-1" frame_id="-1" name=""   text="也许我还想相信前辈吧，虽然如果他们真有那个意图的话，这种纸片根本毫无意义……" voices=""/><clear @l="872" class="all"/><wait_chgmv/><bg @l="875" src="bg14a"/><char @l="878" id="inaba" pos="auto" src="inaba050"/><msg @l="880" char_id="-1" frame_id="-1" name="稻庭" text="『来，进来吧。』"   voices=""/><msg @l="882" char_id="-1" frame_id="-1" name="" text="在前辈的催促下，我走进活动室。"   voices=""/><msg @l="883" char_id="-1" frame_id="-1" name=""   text="明明应该是熟悉的活动室，却不知为何感觉像是完全不同的空间。" voices=""/><clear @l="886" class="char"/><char @l="888" id="inaba" pos="center" src="inaba050f" y="-80"/><stopbgm @l="890" fadeout="1000"/><msg @l="893" char_id="-1" frame_id="-1" name="稻庭" text="『终于只剩我们两个人了。』"   voices=""/><clear @l="896" class="char"/><char @l="898" id="inaba" pos="left" src="inaba050"/><char @l="900" id="miho" pos="right" src="miho054"/><msg @l="902" char_id="0" frame_id="1" name="美帆" text="『啊！？』" voices=""/><bgm @l="905" src="bgm13" volume="1."/><msg @l="907" char_id="-1" frame_id="-1" name=""   text="感觉到了异样的氛围，我不由自主地向门口退去……但是，门被锁上了，出不去！" voices=""/><char @l="910" id="miho" pos="right" src="miho055"/><msg @l="912" char_id="0" frame_id="1" name="美帆" text="『稻庭学长，你、你要干什么！？』"   voices=""/><clear @l="915" class="char"/><char @l="917" id="inaba" pos="center" src="inaba050f" y="-80"/><msg @l="919" char_id="-1" frame_id="-1" name="稻庭" text="『啊，抱歉。』"   voices=""/><stopbgm @l="922" fadeout="1000"/><msg @l="924" char_id="-1" frame_id="-1" name="稻庭" text="『不是两个人，而是三个人。』"   voices=""/><clear @l="927" class="char"/><se @l="930" buf="1" src="金属扉にモノを叩きつけた音" volume="1."/><flash @l="932" count="4" fade="100" image="white"/><shake @l="934" amp="10" class="all" cycle="30" duration="300" type="random"/><msg @l="936" char_id="-1" frame_id="-1" name="" text="砰！" voices=""/><msg @l="938" char_id="-1" frame_id="-1" name="" text="说着，学长突然踢了一下储物柜。"   voices=""/><msg @l="939" char_id="-1" frame_id="-1" name=""   text="储物柜的门打开了，里面的什么东西朝这边倒了过来。" voices=""/><se @l="942" buf="1" src="人とぶつかる音" volume="1."/><msg @l="944" char_id="-1" frame_id="-1" name="稻庭" text="『……。』" voices=""/><msg @l="946" char_id="0" frame_id="1" name="美帆" text="『玲小姐！！』" voices=""/><msg @l="949" char_id="-1" frame_id="-1" name=""   text="那是双手被绳子绑住，嘴里塞着口塞的玲小姐。" voices=""/><msg @l="950" char_id="-1" frame_id="-1" name=""   text="我跑到被滚倒的玲小姐身旁，把她半身抱起。" voices=""/><msg @l="951" char_id="-1" frame_id="-1" name=""   text="她勉强……还在呼吸的样子。" voices=""/><bgm @l="954" src="bgm09" volume="1."/><char @l="957" id="inaba" pos="auto" src="inaba050"/><msg @l="959" char_id="-1" frame_id="-1" name="稻庭" text="『这都是仲根同学你的错啊。』"   voices=""/><clear @l="962" class="char"/><char @l="964" id="inaba" pos="left" src="inaba050"/><char @l="966" id="miho" pos="right" src="miho055"/><msg @l="968" char_id="0" frame_id="1" name="美帆"   text="『你、你在说什么！对玲小姐做出这么残忍的事情。』" voices=""/><msg @l="970" char_id="-1" frame_id="-1" name="稻庭"   text="『你告诉玲今天的事了吧？她不幸撞见了强奸现场，吵吵嚷嚷说要举报什么的……所以我只好让她安静一下。』"   voices=""/><msg @l="972" char_id="-1" frame_id="-1" name="稻庭"   text="『我对处女以外的人比较没有顾忌……所以手段稍微粗暴了一点。』" voices=""/><msg @l="973" char_id="-1" frame_id="-1" name=""   text="就我所见，这绝不是粗暴就能形容的伤势。" voices=""/><msg @l="974" char_id="-1" frame_id="-1" name="" text="比起外伤，我更担心她的内脏和骨头。"   voices=""/><msg @l="976" char_id="0" frame_id="1" name="美帆"   text="『我来做你的对象。所以，请放过玲小姐！』" voices=""/><clear @l="979" class="char"/><char @l="981" id="inaba" pos="center" src="inaba050f" y="-80"/><msg @l="983" char_id="-1" frame_id="-1" name="稻庭" text="『我就等着这句话呢。』"   voices=""/><msg @l="985" char_id="-1" frame_id="-1" name="" text="稻庭学长突然只把头转向这边。"   voices=""/><clear @l="988" class="char"/><char @l="990" id="miho" pos="auto" src="miho055"/><msg @l="992" char_id="0" frame_id="1" name="美帆" text="『什、什么意思？』"   voices=""/><clear @l="995" class="char"/><char @l="997" id="inaba" pos="left" src="inaba050"/><char @l="999" id="miho" pos="right" src="miho055"/><msg @l="1001" char_id="-1" frame_id="-1" name="稻庭"   text="『我不喜欢强迫女性这种行为。我一直在等你主动开口。』" voices=""/><msg @l="1003" char_id="0" frame_id="1" name="美帆"   text="『怎么会……你竟然能这么厚颜无耻。』" voices=""/><msg @l="1005" char_id="-1" frame_id="-1" name="稻庭"   text="『但是，现在你已经主动提出要做我的对象了。』" voices=""/><msg @l="1007" char_id="0" frame_id="1" name="美帆" text="『呜！』" voices=""/><clear @l="1010" class="char"/><char @l="1012" id="inaba" pos="center" src="inaba054f" y="-80"/><msg @l="1014" char_id="-1" frame_id="-1" name="稻庭"   text="『看来你还不明白自己的处境啊。』" voices=""/><msg @l="1016" char_id="-1" frame_id="-1" name=""   text="稻庭学长把脚放在玲小姐的腹部，来回碾压。" voices=""/><msg @l="1017" char_id="-1" frame_id="-1" name=""   text="随着学长脚的移动，玲小姐痛苦地呻吟着。" voices=""/><clear @l="1020" class="char"/><char @l="1022" id="miho" pos="auto" src="miho055"/><msg @l="1024" char_id="0" frame_id="1" name="美帆" text="『住手！』" voices=""/><clear @l="1027" class="char"/><char @l="1029" id="inaba" pos="center" src="inaba050f" y="-80"/><msg @l="1031" char_id="-1" frame_id="-1" name="稻庭"   text="『那就是说，你喜欢我，想被我侵犯……就是这个意思对吧？』" voices=""/><msg @l="1033" char_id="-1" frame_id="-1" name=""   text="确实以前，我应该是喜欢稻庭学长的。" voices=""/><msg @l="1034" char_id="-1" frame_id="-1" name=""   text="但现在，眼前的这个人只是一个长着稻庭学长脸的恶魔。" voices=""/><msg @l="1035" char_id="-1" frame_id="-1" name=""   text="面对要主动请求这种男人侵犯自己的屈辱，我一瞬间别过了脸。" voices=""/><char @l="1037" id="inaba" pos="center" src="inaba054f" y="-80"/><msg @l="1039" char_id="-1" frame_id="-1" name="稻庭" text="『不是这样吗？』"   voices=""/><msg @l="1041" char_id="-1" frame_id="-1" name=""   text="一边温柔地说着，稻庭学长一边用脚尖快速地戳着玲小姐的肋腹部位。" voices=""/><msg @l="1042" char_id="-1" frame_id="-1" name=""   text="可能是肋骨已经断了，玲小姐浑身发抖，抽搐起来。" voices=""/><msg @l="1044" char_id="1" frame_id="-1" name="玲" text="『呃……呜呃！』"   voices=""/><clear @l="1047" class="char"/><char @l="1049" id="miho" pos="auto" src="miho055"/><msg @l="1051" char_id="0" frame_id="1" name="美帆"   text="『住手！请住手！我想被侵犯！我想被你侵犯！』" voices=""/><msg @l="1053" char_id="-1" frame_id="-1" name=""   text="听到这话，稻庭学长把脚从玲小姐身上移开了。" voices=""/><msg @l="1054" char_id="-1" frame_id="-1" name=""   text="从折磨中解放出来的玲小姐依然疲惫不堪，连续重复着粗重的呼吸。" voices=""/><clear @l="1057" class="char"/><char @l="1059" id="inaba" pos="center" src="inaba050f" y="-80"/><msg @l="1061" char_id="-1" frame_id="-1" name="稻庭" text="『也就是说，你想把处女之身献给我？』"   voices=""/><clear @l="1064" class="char"/><char @l="1066" id="miho" pos="auto" src="miho055"/><msg @l="1068" char_id="0" frame_id="1" name="美帆" text="『是、是的……献给您。』"   voices=""/><clear @l="1071" class="char"/><char @l="1073" id="inaba" pos="center" src="inaba050f" y="-80"/><msg @l="1075" char_id="-1" frame_id="-1" name="稻庭"   text="『你想被我的那话儿贯穿处女膜吗？』" voices=""/><clear @l="1078" class="char"/><char @l="1080" id="miho" pos="auto" src="miho055"/><msg @l="1082" char_id="0" frame_id="1" name="美帆"   text="『……是的，请……破开……我的处女膜。』" voices=""/><msg @l="1084" char_id="-1" frame_id="-1" name=""   text="学长满意地扭曲嘴角，然后转向脚边的玲小姐，仔细观察着什么。" voices=""/><clear @l="1087" class="char"/><char @l="1089" id="inaba" pos="center" src="inaba054f" y="-80"/><msg @l="1091" char_id="-1" frame_id="-1" name="稻庭" text="『玲，你已经没用了。』"   voices=""/><msg @l="1093" char_id="-1" frame_id="-1" name=""   text="说完，稻庭学长用脚底推开玲小姐的身体，粗暴地让她滚开。" voices=""/><msg @l="1094" char_id="-1" frame_id="-1" name=""   text="学长一口气咬碎了好几片药片，全身肌肉比刚才更加隆起，胯下的隆起也变得更加有力。"   voices=""/><clear @l="1097" class="char"/><char @l="1099" id="miho" pos="auto" src="miho055"/><msg @l="1101" char_id="0" frame_id="1" name="美帆" text="『啊，啊啊！』" voices=""/><clear @l="1104" class="char"/><msg @l="1106" char_id="-1" frame_id="-1" name=""   text="尽管已经下定决心，但当我直视被疯狂扭曲的学长的眼睛时，全身的力气都被抽空，瘫软在了那里。" voices=""/><char @l="1109" id="inaba" pos="center" src="inaba058f" y="-80"/><msg @l="1111" char_id="-1" frame_id="-1" name="稻庭"   text="『太好了！那表情！那姿态！那肉体！我所追求的一切就在眼前！』" voices=""/><msg @l="1113" char_id="-1" frame_id="-1" name="稻庭" text="『啊哈哈哈哈哈哈！』"   voices=""/><stopbgm @l="1117" fadeout="1000"/><label @l="1121" id="chart_line77"/><call @l="1125" target="EventLabel_98@root_inaba_c_ev01"/><stopbgm @l="1129" fadeout="1000"/><clear @l="1135" class="all"/><wait_chgmv/><bg @l="1139" src="bg14b"/><msg @l="1141" char_id="0" frame_id="1" name="美帆" text="『嗯……。』" voices=""/><msg @l="1143" char_id="0" frame_id="1" name="美帆" text="『咦……我……。』"   voices=""/><msg @l="1145" char_id="-1" frame_id="-1" name=""   text="远去的意识在某一瞬间突然苏醒。" voices=""/><msg @l="1146" char_id="-1" frame_id="-1" name=""   text="映入眼帘的是网球社的社团活动室……。" voices=""/><msg @l="1147" char_id="-1" frame_id="-1" name=""   text="正当我以为刚才发生的一切都是梦，准备舒一口气时，我的视线里出现了无力横卧着的稻庭学长的身影。"   voices=""/><bgm @l="1151" src="bgm15" volume="1."/><msg @l="1153" char_id="0" frame_id="1" name="美帆" text="『学、学长！？』"   voices=""/><msg @l="1155" char_id="-1" frame_id="-1" name=""   text="我战战兢兢地起身，试图蹭到学长身边。" voices=""/><msg @l="1156" char_id="-1" frame_id="-1" name=""   text="然而，仅仅这样身体就已经嘎吱作响，根本不可能站起来走路的样子。" voices=""/><msg @l="1157" char_id="-1" frame_id="-1" name=""   text="看向刚才被撕裂的那个地方……破处的证明——鲜红的血液正清晰地流淌着，在我的大腿上形成了一道痕迹。" voices=""/><msg @l="1158" char_id="-1" frame_id="-1" name=""   text="果然……这并不是什么梦。" voices=""/><msg @l="1160" char_id="0" frame_id="1" name="美帆" text="『学长，您没事吧……学长！』"   voices=""/><msg @l="1162" char_id="-1" frame_id="-1" name="稻庭" text="『呃……啊…啊……。』"   voices=""/><msg @l="1164" char_id="-1" frame_id="-1" name=""   text="稻庭学长对我的呼唤没有反应，也没有要睁开眼睛的迹象。" voices=""/><msg @l="1165" char_id="-1" frame_id="-1" name="" text="是那种药物的原因吗。"   voices=""/><char @l="1168" id="kuma" pos="center" src="kuma017f" y="-80"/><msg @l="1170" char_id="-1" frame_id="-1" name="熊野"   text="『竟然担心刚才那样粗暴侵犯你的男人，真是令人敬佩的好人啊。』" voices=""/><msg @l="1172" char_id="-1" frame_id="-1" name="" text="熊野女士突然出现了。"   voices=""/><msg @l="1173" char_id="-1" frame_id="-1" name=""   text="她的语气与先前完全不同，或许正因如此，整体氛围也给人一种粗暴的感觉。" voices=""/><clear @l="1176" class="char"/><char @l="1178" id="kuma" pos="auto" src="kuma012"/><msg @l="1181" char_id="-1" frame_id="-1" name="熊野"   text="『真是了不起的伪善啊。对你们来说，他就这样死了不是更方便吗？』" voices=""/><clear @l="1184" class="char"/><char @l="1186" id="kuma" pos="auto" src="kuma012"/><msg @l="1190" char_id="0" frame_id="1" name="美帆"   text="『怎…怎么会……稻庭学长……死……。』" voices=""/><msg @l="1192" char_id="-1" frame_id="-1" name="熊野"   text="『放心吧，只是处于假死状态……药物的反作用罢了。他不是说过吗？不继续服药就会变成这样。』"   voices=""/><msg @l="1194" char_id="-1" frame_id="-1" name="熊野"   text="『以前从未缺过药，唯独这次因为专注于侵犯你而忘记了……你可真是个了不起的肉体啊。』" voices=""/><msg @l="1196" char_id="-1" frame_id="-1" name=""   text="熊野一边奸笑着，一边像舔舐一般地打量着我赤裸的身体。" voices=""/><msg @l="1199" char_id="0" frame_id="1" name="美帆"   text="『什…什么意思！？那种事……。』" voices=""/><msg @l="1201" char_id="-1" frame_id="-1" name="熊野"   text="『嘛……是真是假很快就知道了。』" voices=""/><msg @l="1203" char_id="-1" frame_id="-1" name=""   text="熊野说着举起一只手，等候在社团活动室外的男部员们蜂拥而入。" voices=""/><msg @l="1204" char_id="-1" frame_id="-1" name="" text="社团活动室里……没有玲小姐的身影。"   voices=""/><msg @l="1207" char_id="0" frame_id="1" name="美帆" text="『你…你要做什么……？』"   voices=""/><msg @l="1209" char_id="-1" frame_id="-1" name="熊野"   text="『正如迄今为止吃过几百个处女的稻庭所看中的那样，你确实拥有着出色的肉体。』" voices=""/><msg @l="1211" char_id="-1" frame_id="-1" name="熊野"   text="『所以……我想按照这个镇子的规则，将你调教成最顶级的“镇里的女人”。』" voices=""/><msg @l="1213" char_id="0" frame_id="1" name="美帆"   text="『镇子的规则……调教是……？』" voices=""/><msg @l="1215" char_id="-1" frame_id="-1" name="熊野"   text="『问题太多了……你已经无处可逃了。只要乖乖听从我的话，就不会受到伤害。』" voices=""/><msg @l="1217" char_id="0" frame_id="1" name="美帆" text="『这、这种事……。』"   voices=""/><msg @l="1219" char_id="-1" frame_id="-1" name="熊野"   text="『对了对了……这些人都服用了改良自稻庭药物的新药。』" voices=""/><msg @l="1221" char_id="0" frame_id="1" name="美帆" text="『啊……！！』" voices=""/><msg @l="1223" char_id="-1" frame_id="-1" name=""   text="仔细一看，那些男部员们的表情都一样空洞。" voices=""/><msg @l="1225" char_id="-1" frame_id="-1" name="熊野"   text="『他们侵犯网球部女生的时候也有点不对劲吧？那就是新药的影响。』" voices=""/><msg @l="1227" char_id="-1" frame_id="-1" name="熊野"   text="『这种新药与稻庭的不同，是专门为性爱调整过的。』" voices=""/><msg @l="1229" char_id="-1" frame_id="-1" name="熊野"   text="『这是特制的药物，虽然不会强化肉体，但作为替代，精液中会含有媚药成分。放心地被侵犯吧。』" voices=""/><clear @l="1232" class="char"/><msg @l="1234" char_id="0" frame_id="1" name="美帆" text="『这种事……啊啊！？』"   voices=""/><msg @l="1236" char_id="-1" frame_id="-1" name="男会员A" text="『……。』"   voices=""/><msg @l="1238" char_id="-1" frame_id="-1" name="男会员B" text="『……。』"   voices=""/><msg @l="1240" char_id="-1" frame_id="-1" name=""   text="我的双手被两侧的两名男性社团成员各自抓住。" voices=""/><msg @l="1242" char_id="-1" frame_id="-1" name="熊野"   text="『啊，我忘了说，他们刚刚被药物唤醒，性欲是普通人的几十倍。他们会好好地蹂躏你的。』"   voices=""/><msg @l="1244" char_id="0" frame_id="1" name="美帆" text="『呃……。』" voices=""/><msg @l="1246" char_id="0" frame_id="1" name="美帆"   text="『不要啊啊啊啊啊啊啊啊啊啊啊啊！！！』" voices=""/><stopbgm @l="1250" fadeout="1000"/><clear @l="1256" class="all"/><call @l="1260" target="EventLabel_99@root_inaba_c_ev02"/><call @l="1262" target="EventLabel_50@ending12"/><return @l="1263" value="0&#13;&#10;"/><return @l="1266" value=""/></code></xscript>																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																								