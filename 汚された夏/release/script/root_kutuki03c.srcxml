<?xml version="1.0" encoding="utf-8"?><xscript><debug editor="&quot;C:\Program&#32;Files&#32;(x86)\sakura\sakura.exe&quot;&#32;&quot;%src%&quot;&#32;-Y=%line%"   src="D:\シロップ\町ぐるみの罠＋汚された夏セット版\汚された夏\完成データ\汚された夏\script\text\root_kutuki03c.txt"/><code><label @l="10" id="EventLabel_122"/><description @l="13" text="契约的日子·第2天"/><eval @l="15" expr="f.numDay=8&#13;&#10;"/><msgshow @l="17" show="false"/><wait_chgmv/><bg @l="19" src="day08" time="2000"/><wait @l="21" time="500"/><wait_chgmv/><bg @l="23" src="black" time="2000"/><msgshow @l="25" show="true"/><wait_chgmv/><bg @l="28" src="bg03"/><bgm @l="31" src="bgm03" volume="1."/><char @l="34" id="miho" pos="auto" src="miho126"/><msg @l="36" char_id="0" frame_id="-1" name="美帆" text="『那么……我出门了。』"   voices=""/><msg @l="38" char_id="-1" frame_id="-1" name=""   text="周一的早晨，我像往常一样收拾完毕，向玄关走去。" voices=""/><msg @l="39" char_id="-1" frame_id="-1" name=""   text="周末的两天，幸运的是平安度过，没有遇到朽木教授。" voices=""/><msg @l="40" char_id="-1" frame_id="-1" name=""   text="话虽如此，我几乎整天都在房间里度过，一边害怕遇见他而瑟瑟发抖，所以说根本不可能遇到也是事实。"   voices=""/><msg @l="41" char_id="-1" frame_id="-1" name=""   text="而今天，忧郁的阴影依然……萦绕在我心头。" voices=""/><clear @l="44" class="char"/><char @l="46" id="miho" pos="left" src="miho126"/><char @l="48" id="rei" pos="right" src="rei030"/><msg @l="50" char_id="1" frame_id="-1" name="玲" text="『哎呀，你已经要出门了啊。』"   voices=""/><msg @l="52" char_id="1" frame_id="-1" name="玲" text="『路上小心，一路顺风。』"   voices=""/><msg @l="54" char_id="0" frame_id="-1" name="美帆" text="『嗯……』" voices=""/><clear @l="57" layer="miho"/><msg @l="59" char_id="-1" frame_id="-1" name=""   text="简短地回应后，我就打算离开客厅。" voices=""/><msg @l="61" char_id="1" frame_id="-1" name="玲" text="『……。』" voices=""/><char @l="64" id="rei" pos="right" src="rei034"/><msg @l="66" char_id="1" frame_id="-1" name="玲" text="『美帆。』" voices=""/><char @l="69" id="miho" pos="left" src="miho124"/><msg @l="71" char_id="0" frame_id="-1" name="美帆" text="『啊……啊，是？』" voices=""/><char @l="74" id="rei" pos="right" src="rei030"/><msg @l="76" char_id="1" frame_id="-1" name="玲" text="『你……脸色不太好哦？』"   voices=""/><msg @l="78" char_id="1" frame_id="-1" name="玲" text="『身体不舒服吗？』"   voices=""/><char @l="81" id="miho" pos="left" src="miho026"/><msg @l="83" char_id="0" frame_id="-1" name="美帆" text="『没，没事的。』"   voices=""/><msg @l="85" char_id="1" frame_id="-1" name="玲" text="『……是吗？那就好。』"   voices=""/><char @l="88" id="miho" pos="left" src="miho125"/><msg @l="90" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="92" char_id="0" frame_id="-1" name="美帆" text="（怎么可能……告诉她呢）"   voices=""/><msg @l="94" char_id="0" frame_id="-1" name="美帆"   text="（成为朽木教授的奴隶……遵照命令……没穿内衣什么的）" voices=""/><char @l="97" id="rei" pos="right" src="rei034"/><msg @l="99" char_id="1" frame_id="-1" name="玲" text="『什么？发生什么事了？』"   voices=""/><char @l="102" id="miho" pos="left" src="miho026"/><msg @l="104" char_id="0" frame_id="-1" name="美帆" text="『没……没什么事。』"   voices=""/><clear @l="107" layer="miho"/><msg @l="109" char_id="0" frame_id="-1" name="美帆" text="『……我出发了。』"   voices=""/><clear @l="112" class="all"/><msgshow @l="114" show="true"/><wait_chgmv/><bg @l="117" src="bg21"/><msg @l="119" char_id="-1" frame_id="-1" name=""   text="到达车站时，恰好是首班电车刚刚到站。" voices=""/><msg @l="120" char_id="-1" frame_id="-1" name=""   text="我慌忙小跑着靠近排队的人群的最后方。" voices=""/><char @l="123" id="miho" pos="auto" src="miho125"/><msg @l="125" char_id="0" frame_id="-1" name="美帆" text="『………。』" voices=""/><msg @l="127" char_id="0" frame_id="-1" name="美帆" text="（呜啊……跑步的时候胸部会摩擦……）"   voices=""/><msg @l="129" char_id="-1" frame_id="-1" name="" text="因为没穿内衣，所以这也是没办法的事。"   voices=""/><msg @l="130" char_id="-1" frame_id="-1" name=""   text="站在队伍最后的我隔着衣服用手按住胸部……轻轻地呼出一口气。" voices=""/><msg @l="132" char_id="-1" frame_id="-1" name="男学生" text="『………。』"   voices=""/><msg @l="134" char_id="-1" frame_id="-1" name=""   text="排在队尾的男学生转过身来，看向我。" voices=""/><msg @l="135" char_id="-1" frame_id="-1" name=""   text="难道……他注意到了吗？" voices=""/><msg @l="137" char_id="0" frame_id="-1" name="美帆" text="『………。』" voices=""/><msg @l="139" char_id="-1" frame_id="-1" name="男学生" text="『………。』"   voices=""/><msg @l="141" char_id="-1" frame_id="-1" name=""   text="那名男学生瞥了我一眼，随即又转回了头。" voices=""/><msg @l="142" char_id="-1" frame_id="-1" name=""   text="大概只是我跑过来的脚步声引起了他的注意吧……" voices=""/><char @l="145" id="miho" pos="auto" src="miho126"/><msg @l="147" char_id="0" frame_id="-1" name="美帆"   text="（呼……原来她并没有注意到）" voices=""/><msg @l="149" char_id="0" frame_id="-1" name="美帆"   text="（对、对啊……就算没穿内衣，从衣服外面也看不出来吧）" voices=""/><msg @l="151" char_id="0" frame_id="-1" name="美帆" text="（是我太担心……了吧）"   voices=""/><msg @l="153" char_id="-1" frame_id="-1" name="" text="怀着这样的想法，我登上了电车。"   voices=""/><clear @l="156" class="all"/><label @l="159" id="event_scene14"/><se @l="162" buf="3" loop="true" src="電車走行中" volume="1."/><msg @l="164" char_id="0" frame_id="-1" name="美帆" text="『…………。』" voices=""/><msg @l="166" char_id="-1" frame_id="-1" name="" text="我常坐的位置已经被占了。"   voices=""/><msg @l="167" char_id="-1" frame_id="-1" name=""   text="我只好随便抓住一个吊环，任凭身体随着电车晃动。" voices=""/><msg @l="169" char_id="0" frame_id="-1" name="美帆"   text="(我、我为什么要做这种事呢………)" voices=""/><msg @l="171" char_id="-1" frame_id="-1" name=""   text="一边注意着裙摆，我不禁一次又一次地深深叹息。" voices=""/><msg @l="172" char_id="-1" frame_id="-1" name=""   text="为了保护父亲，必须按照朽木教授说的去做……这是没办法的事，我明白。" voices=""/><msg @l="173" char_id="-1" frame_id="-1" name="" text="但是……这究竟要持续到什么时候呢？"   voices=""/><msg @l="174" char_id="-1" frame_id="-1" name=""   text="就像教授说的，要等到父亲退休的十几年后吗？" voices=""/><msg @l="175" char_id="-1" frame_id="-1" name="" text="还是说……。" voices=""/><msg @l="177" char_id="0" frame_id="-1" name="美帆"   text="(不行……想这些也没用啊)" voices=""/><msg @l="179" char_id="0" frame_id="-1" name="美帆" text="(现在除了遵从教授的话……别无选择)"   voices=""/><msg @l="181" char_id="-1" frame_id="-1" name="" text="我的脸上浮现出放弃的表情。"   voices=""/><msg @l="183" char_id="-1" frame_id="-1" name="声音" text="『真是个清爽宜人的早晨啊。』"   voices=""/><msg @l="185" char_id="0" frame_id="-1" name="美帆" text="『……！！』" voices=""/><msg @l="187" char_id="-1" frame_id="-1" name="" text="突然，有人在我耳边低语。"   voices=""/><msg @l="189" char_id="0" frame_id="-1" name="美帆" text="『……教授……。』"   voices=""/><msg @l="191" char_id="-1" frame_id="-1" name="朽木"   text="『在电车里这样见面已经很久没有了呢。』" voices=""/><msg @l="193" char_id="0" frame_id="-1" name="美帆" text="『………。』" voices=""/><msg @l="195" char_id="-1" frame_id="-1" name="" text="如果可能的话，我真希望再也不要见到他。"   voices=""/><msg @l="197" char_id="-1" frame_id="-1" name="朽木"   text="『原来如此，看来要从你口中听到欢迎的话语还需要一些时间啊。』" voices=""/><msg @l="199" char_id="0" frame_id="-1" name="美帆"   text="『无论过了多久……我都不会出卖我的心。』" voices=""/><msg @l="201" char_id="-1" frame_id="-1" name="朽木" text="『呵呵，算了。』"   voices=""/><msg @l="203" char_id="-1" frame_id="-1" name="朽木"   text="『那么……今天你有好好遵守我的命令吗？』" voices=""/><msg @l="205" char_id="0" frame_id="-1" name="美帆" text="『是的……。』" voices=""/><msg @l="207" char_id="-1" frame_id="-1" name="朽木" text="『真的吗？』" voices=""/><msg @l="209" char_id="0" frame_id="-1" name="美帆" text="『真、真的……。』"   voices=""/><msg @l="211" char_id="-1" frame_id="-1" name="朽木"   text="『嗯。但光靠言语我无法相信。』" voices=""/><msg @l="213" char_id="-1" frame_id="-1" name="朽木" text="『……让我确认一下吧。』"   voices=""/><msg @l="215" char_id="0" frame_id="-1" name="美帆" text="『……啊，不会吧！？』"   voices=""/><msg @l="217" char_id="-1" frame_id="-1" name="朽木" text="『呵呵……。』" voices=""/><label @l="220" id="chart_line44"/><wait_chgmv/><ev @l="223" src="ev-014"/><description @l="226" text="露出痴汉游戏"/><bgm @l="229" src="bgm14" volume="1."/><msg @l="231" char_id="-1" frame_id="-1" name=""   text="教授的指尖抓住衣服的下摆往上掀起，让我这个没穿内衣的人在拥挤的电车中暴露出胸部和私处。" voices=""/><msg @l="233" char_id="0" frame_id="-1" name="美帆" text="『啊……。』"   voices="miho08220"/><msg @l="235" char_id="-1" frame_id="-1" name=""   text="我不被允许反抗，只能发出放弃的声音，任由朽木教授摆布。" voices=""/><msg @l="237" char_id="-1" frame_id="-1" name="朽木"   text="『哦，确实遵守了命令呢。』" voices=""/><msg @l="239" char_id="0" frame_id="-1" name="美帆"   text="『如、如果确认了我遵守命令……请放开手。』" voices="miho08230"/><msg @l="241" char_id="0" frame_id="-1" name="美帆"   text="『这种地方……如果被谁看到的话………。』" voices="miho08240"/><msg @l="243" char_id="-1" frame_id="-1" name=""   text="我眼前座位上的人都在看杂志或睡觉，所以目前还没有注意到这边的情况。" voices=""/><msg @l="244" char_id="-1" frame_id="-1" name=""   text="但是……如果继续这样下去，总有一天一定会被看到的。" voices=""/><msg @l="246" char_id="-1" frame_id="-1" name="朽木"   text="『这不是很好吗，让大家都看看。』" voices=""/><msg @l="248" char_id="-1" frame_id="-1" name=""   text="教授的指尖轻轻地在我胸部的隆起处画着圆圈般地抚摸着。" voices=""/><msg @l="250" char_id="0" frame_id="-1" name="美帆" text="『这、这种——。』"   voices="miho08250"/><msg @l="252" char_id="-1" frame_id="-1" name=""   text="我差点情不自禁地提高声音……慌忙闭上嘴。" voices=""/><msg @l="253" char_id="-1" frame_id="-1" name=""   text="在这里如果我发出声音，被乘客注意到可不行。" voices=""/><msg @l="255" char_id="-1" frame_id="-1" name="朽木"   text="『呵呵……这样保持沉默对你才是有利的。』" voices=""/><msg @l="257" char_id="-1" frame_id="-1" name=""   text="慢慢地……朽木教授的指尖紧紧抓住我白皙的半球形乳房，揉捏着使其变形。" voices=""/><msg @l="258" char_id="-1" frame_id="-1" name=""   text="因为没有内衣，另一只手轻易地分开了秘缝的嫩肉，玩弄着蜜壶。" voices=""/><msg @l="260" char_id="0" frame_id="-1" name="美帆" text="『……。』"   voices="miho08260"/><msg @l="262" char_id="-1" frame_id="-1" name=""   text="我……只能在抑制着即将发出的声音的同时，听从他的摆布。" voices=""/><msg @l="263" char_id="-1" frame_id="-1" name=""   text="战战兢兢地担心……周围的人随时可能注意到我的样子。" voices=""/><msg @l="265" char_id="-1" frame_id="-1" name="朽木"   text="『哦呀……是不是，有点感觉了呢？』" voices=""/><msg @l="267" char_id="0" frame_id="-1" name="美帆" text="『才、才不是……没有的事。』"   voices="miho08270"/><msg @l="269" char_id="-1" frame_id="-1" name="朽木"   text="『但看起来，你的乳头已经相当硬起来了呢。』" voices=""/><msg @l="271" char_id="-1" frame_id="-1" name=""   text="教授一边说着，一边用指尖搓弄着像软糖一样的乳头。" voices=""/><msg @l="272" char_id="-1" frame_id="-1" name=""   text="确实……我的那里已经稍微充血并开始勃起了。" voices=""/><msg @l="274" char_id="0" frame_id="-1" name="美帆" text="『不、不是的……那是……。』"   voices="miho08280"/><msg @l="276" char_id="-1" frame_id="-1" name="朽木" text="『那是？』" voices=""/><msg @l="278" char_id="0" frame_id="-1" name="美帆" text="『唔…嗯…。』"   voices="miho08290"/><msg @l="280" char_id="-1" frame_id="-1" name="朽木" text="『怎么了？不是吗？』"   voices=""/><msg @l="282" char_id="-1" frame_id="-1" name="朽木"   text="『不穿内衣在人前暴露阴部还让乳头硬起来，现在说这些又有什么意义呢？』" voices=""/><msg @l="284" char_id="0" frame_id="-1" name="美帆" text="『请、请不要说出来……。』"   voices="miho08300"/><msg @l="286" char_id="-1" frame_id="-1" name="朽木" text="『也就是说，你承认了。』"   voices=""/><msg @l="288" char_id="0" frame_id="-1" name="美帆" text="『……。』"   voices="miho08310"/><msg @l="290" char_id="-1" frame_id="-1" name="朽木" text="『呵呵，果然如此。』"   voices=""/><msg @l="292" char_id="-1" frame_id="-1" name="朽木"   text="『装作为了父亲牺牲身体的坚强女儿，实际上却是在他人面前暴露阴部被玩弄就会有感觉的淫乱女子，是吗？』"   voices=""/><msg @l="294" char_id="0" frame_id="-1" name="美帆"   text="『不、不是的，我并不是什么淫乱的人……。』" voices="miho08320"/><msg @l="296" char_id="-1" frame_id="-1" name="朽木"   text="『那么……这个该如何解释呢？』" voices=""/><msg @l="298" char_id="0" frame_id="-1" name="美帆" text="『嗯！！』"   voices="miho08330"/><msg @l="300" char_id="-1" frame_id="-1" name=""   text="教授的三根手指插入了阴道内。然后，像是在搅动蜜壶一般，进进出出地抽动着手指。" voices=""/><msg @l="301" char_id="-1" frame_id="-1" name=""   text="抽插的速度逐渐加快，摩擦着媚肉，发出啪嗒啪嗒的淫靡水声，在车内回响。" voices=""/><msg @l="303" char_id="0" frame_id="-1" name="美帆"   text="『不行、不可以啊……嗯、嗯嗯……啊啊啊！』" voices="miho10160"/><msg @l="305" char_id="-1" frame_id="-1" name=""   text="他还用空闲的手指指腹抚摸着被包皮包裹的秘核。" voices=""/><msg @l="307" char_id="-1" frame_id="-1" name="朽木"   text="『这里也，变得相当硬了呢？』" voices=""/><msg @l="309" char_id="0" frame_id="-1" name="美帆" text="『呀，啊啊……』"   voices="miho08340"/><msg @l="311" char_id="-1" frame_id="-1" name=""   text="教授的手指撑开肉瓣，里面积蓄的如同百合花一般的馥郁香气弥漫开来，刺激着教授的神经。" voices=""/><msg @l="313" char_id="-1" frame_id="-1" name="朽木"   text="『多么诱人的气味啊。原来淫乱女子散发的香气如此与众不同吗？』" voices=""/><msg @l="315" char_id="0" frame_id="-1" name="美帆"   text="（明明不是……我明明不是淫乱的人……）" voices="miho08350"/><msg @l="317" char_id="-1" frame_id="-1" name=""   text="彻底沉醉在蜜液香气中的教授，深深地吸入这芬芳的气息，手指的动作变得更加激烈。" voices=""/><msg @l="318" char_id="-1" frame_id="-1" name=""   text="与内心想法相悖，被指尖玩弄的秘核变得更加坚硬膨胀。" voices=""/><msg @l="319" char_id="-1" frame_id="-1" name=""   text="伴随着刺痛的麻痹感袭击着下腹部，子宫口涌出点点淫液，使她的体内变得炙热。" voices=""/><stopbgm @l="322" fadeout="1000"/><clear @l="325" class="all"/><msg @l="327" char_id="-1" frame_id="-1" name="朽木"   text="『好了……差不多可以了，把衣服整理好吧。』" voices=""/><msg @l="329" char_id="0" frame_id="-1" name="美帆" text="『啊……』"   voices="miho08360"/><msg @l="331" char_id="-1" frame_id="-1" name="朽木"   text="『我已经确认你遵守了我的命令，这样就行了。』" voices=""/><msg @l="333" char_id="0" frame_id="-1" name="美帆" text="『可是，还……』"   voices="miho08370"/><msg @l="335" char_id="-1" frame_id="-1" name="朽木" text="『还什么？』" voices=""/><msg @l="337" char_id="0" frame_id="-1" name="美帆" text="『不，没什么……』"   voices="miho08380"/><msg @l="339" char_id="-1" frame_id="-1" name=""   text="于是我急急忙忙地开始整理被敞开的衣服。" voices=""/><msg @l="341" char_id="0" frame_id="-1" name="美帆" text="（我……是在期待吗？）"   voices="miho08390"/><msg @l="343" char_id="0" frame_id="-1" name="美帆"   text="（被做到最后……被弄到高潮，我是在期待这些吗？）" voices="miho08400"/><msg @l="345" char_id="-1" frame_id="-1" name=""   text="整理衣服的同时，我在心里像是自问般喃喃自语着。" voices=""/><stopse @l="348" buf="3"/><clear @l="351" class="all"/><end_scene @l="354"/><call @l="357" target="EventLabel_125@root_kutuki04c"/><return @l="358" value="0&#13;&#10;"/></code></xscript>																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																															