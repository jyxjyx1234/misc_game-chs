<?xml version="1.0" encoding="utf-8"?><xscript><debug editor="&quot;C:\Program&#32;Files&#32;(x86)\sakura\sakura.exe&quot;&#32;&quot;%src%&quot;&#32;-Y=%line%"   src="D:\シロップ\町ぐるみの罠＋汚された夏セット版\汚された夏\完成データ\汚された夏\script\text\root_akina04a.txt"/><code><label @l="14" id="EventLabel_65"/><description @l="17" text="游泳教练·第4天(A)"/><eval @l="19" expr="f.numDay=11&#13;&#10;"/><msgshow @l="21" show="false"/><wait_chgmv/><bg @l="23" src="day11" time="2000"/><wait @l="25" time="500"/><wait_chgmv/><bg @l="27" src="black" time="2000"/><msgshow @l="29" show="true"/><wait_chgmv/><bg @l="32" src="bg03"/><bgm @l="35" src="bgm02" volume="1."/><char @l="38" id="miho" pos="auto" src="miho010"/><msg @l="40" char_id="0" frame_id="-1" name="美帆" text="『我吃饱了。』"   voices=""/><clear @l="43" class="char"/><char @l="45" id="miho" pos="left" src="miho010"/><char @l="47" id="rei" pos="right" src="rei030"/><msg @l="49" char_id="1" frame_id="-1" name="玲" text="『啊，已经吃好了吗？』" voices=""/><char @l="52" id="miho" pos="left" src="miho016"/><msg @l="54" char_id="0" frame_id="-1" name="美帆" text="『啊，是的……胃口有点不好。』"   voices=""/><char @l="57" id="rei" pos="right" src="rei031"/><msg @l="59" char_id="1" frame_id="-1" name="玲"   text="『早餐必须好好吃才行啊。这可是一天的基础。』" voices=""/><msg @l="61" char_id="0" frame_id="-1" name="美帆"   text="『我知道是这样……但是，就是吃不下去。』" voices=""/><char @l="64" id="rei" pos="right" src="rei030"/><msg @l="66" char_id="1" frame_id="-1" name="玲" text="『这样啊……嗯，别勉强自己。』"   voices=""/><char @l="69" id="miho" pos="left" src="miho116"/><msg @l="71" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="73" char_id="-1" frame_id="-1" name="" text="我也不想勉强自己。"   voices=""/><msg @l="74" char_id="-1" frame_id="-1" name="" text="但是……。" voices=""/><msg @l="76" char_id="1" frame_id="-1" name="玲" text="『美帆……怎么了？』"   voices=""/><char @l="79" id="miho" pos="left" src="miho014"/><msg @l="81" char_id="0" frame_id="-1" name="美帆" text="『啊，那个……没什么。』"   voices=""/><char @l="84" id="miho" pos="left" src="miho016"/><msg @l="86" char_id="0" frame_id="-1" name="美帆" text="『那我差不多该出发了。』"   voices=""/><msg @l="88" char_id="1" frame_id="-1" name="玲" text="『啊，嗯。』" voices=""/><msg @l="90" char_id="1" frame_id="-1" name="玲" text="『嗯，加油哦。』" voices=""/><clear @l="93" class="all"/><wait_chgmv/><bg @l="96" src="bg09"/><char @l="99" id="miho" pos="auto" src="miho014"/><msg @l="101" char_id="0" frame_id="-1" name="美帆" text="『咦……？』" voices=""/><msg @l="103" char_id="-1" frame_id="-1" name=""   text="第二节课结束后，在前往食堂的途中，我在走廊上发现了一张熟悉的面孔。" voices=""/><msg @l="105" char_id="2" frame_id="-1" name="女孩" text="『啊……』" voices=""/><char @l="108" id="akina" pos="auto" src="akina057"/><bgm @l="111" src="bgm06" volume="1."/><msg @l="113" char_id="2" frame_id="-1" name="亚季奈"   text="『糟了……突然被姐姐发现了！？』" voices=""/><clear @l="116" class="char"/><char @l="119" id="miho" pos="auto" src="miho014"/><msg @l="121" char_id="0" frame_id="-1" name="美帆" text="『喂，亚季奈……给我站住！』"   voices=""/><msg @l="123" char_id="-1" frame_id="-1" name=""   text="我抓住了发现我后想要逃跑的亚季奈的衣领，将她拦住。" voices=""/><msg @l="125" char_id="2" frame_id="-1" name="亚季奈" text="『呜啊……果、果然是你？』"   voices=""/><msg @l="127" char_id="0" frame_id="-1" name="美帆" text="『果然是我。』" voices=""/><clear @l="130" class="char"/><char @l="132" id="miho" pos="left" src="miho010"/><char @l="134" id="akina" pos="right" src="akina155"/><msg @l="136" char_id="2" frame_id="-1" name="亚季奈"   text="『哎呀呀，没想到这么快就被发现了～。』" voices=""/><char @l="139" id="miho" pos="left" src="miho014"/><msg @l="141" char_id="0" frame_id="-1" name="美帆"   text="『真是的……话说，亚季奈为什么会在这栋校舍里？』" voices=""/><msg @l="143" char_id="0" frame_id="-1" name="美帆"   text="『来集训的亚季奈她们基本上除了宿舍和游泳池以外，应该是禁止进入其他地方的吧？』" voices=""/><msg @l="145" char_id="-1" frame_id="-1" name=""   text="虽然没人在意，但大学校内是禁止无关人员入内的。" voices=""/><char @l="148" id="akina" pos="right" src="akina051"/><msg @l="150" char_id="2" frame_id="-1" name="亚季奈" text="『诶嘿嘿～。』" voices=""/><msg @l="152" char_id="0" frame_id="-1" name="美帆" text="『别'诶嘿嘿～'的。』"   voices=""/><msg @l="154" char_id="0" frame_id="-1" name="美帆"   text="『被保安看到的话会被赶出去的哦？』" voices=""/><msg @l="156" char_id="2" frame_id="-1" name="亚季奈"   text="『没关系的啦，到时候我会全速逃跑的。』" voices=""/><char @l="159" id="miho" pos="left" src="miho116"/><msg @l="161" char_id="0" frame_id="-1" name="美帆" text="『这不是那种问题吧……』"   voices=""/><msg @l="163" char_id="0" frame_id="-1" name="美帆"   text="『话说，你在这种地方闲逛是怎么回事啊？』" voices=""/><char @l="166" id="akina" pos="right" src="akina157"/><msg @l="168" char_id="2" frame_id="-1" name="亚季奈"   text="『说什么闲逛，太过分了啦。』" voices=""/><msg @l="170" char_id="2" frame_id="-1" name="亚季奈"   text="『我现在可是在执行重要作战任务呢。』" voices=""/><char @l="173" id="miho" pos="left" src="miho010"/><msg @l="175" char_id="0" frame_id="-1" name="美帆" text="『作战？任务？』"   voices=""/><char @l="178" id="akina" pos="right" src="akina051"/><msg @l="180" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯。不被任何人发现地前往食堂，获取布丁这一非常重大且重要的任务正在进行中！』"   voices=""/><msg @l="182" char_id="-1" frame_id="-1" name="" text="亚季奈一边说着一边将手放在额头上。"   voices=""/><msg @l="183" char_id="-1" frame_id="-1" name="" text="大概是想表示敬礼吧。"   voices=""/><char @l="186" id="miho" pos="left" src="miho014"/><msg @l="188" char_id="0" frame_id="-1" name="美帆"   text="『诶，布丁……食堂的布丁只有套餐里附带的，不单独售卖的哦？』" voices=""/><msg @l="190" char_id="-1" frame_id="-1" name=""   text="虽然生协里也有布丁，但是数量少，很快就会卖光。" voices=""/><msg @l="191" char_id="-1" frame_id="-1" name=""   text="所以我也很喜欢带甜点的午餐套餐。" voices=""/><char @l="194" id="akina" pos="right" src="akina054"/><msg @l="196" char_id="2" frame_id="-1" name="亚季奈" text="『诶，是这样的吗！？』"   voices=""/><char @l="199" id="miho" pos="left" src="miho010"/><msg @l="201" char_id="0" frame_id="-1" name="美帆"   text="『是啊。布丁只有套餐里才有的。』" voices=""/><char @l="204" id="akina" pos="right" src="akina154"/><msg @l="206" char_id="2" frame_id="-1" name="亚季奈" text="『啊～！！』" voices=""/><char @l="209" id="akina" pos="right" src="akina055"/><msg @l="211" char_id="2" frame_id="-1" name="亚季奈"   text="『明明好不容易想在合宿所那寂寞的饭菜中，添加一点小小的乐趣，特地来到这里的说……。』" voices=""/><char @l="214" id="miho" pos="left" src="miho011"/><msg @l="216" char_id="0" frame_id="-1" name="美帆" text="『节哀顺变。』"   voices=""/><msg @l="218" char_id="2" frame_id="-1" name="亚季奈" text="『嗯～……。』" voices=""/><char @l="221" id="miho" pos="left" src="miho111"/><msg @l="223" char_id="0" frame_id="-1" name="美帆"   text="『喂，别像小孩子一样撅着嘴了，在大学的人来之前回宿舍去吧。』" voices=""/><msg @l="225" char_id="0" frame_id="-1" name="美帆" text="『你不想被抓住，成为俘虏吧？』"   voices=""/><char @l="228" id="akina" pos="right" src="akina050"/><msg @l="230" char_id="2" frame_id="-1" name="亚季奈" text="『……切。』" voices=""/><clear @l="233" layer="akina"/><msg @l="235" char_id="-1" frame_id="-1" name=""   text="就这样，亚季奈垂头丧气地朝着宿舍的方向走去。" voices=""/><msg @l="236" char_id="-1" frame_id="-1" name="" text="看来她真的很期待能吃到布丁。"   voices=""/><msg @l="238" char_id="0" frame_id="-1" name="美帆" text="(布丁……吗)" voices=""/><clear @l="241" class="char"/><char @l="243" id="miho" pos="auto" src="miho011"/><msg @l="245" char_id="0" frame_id="-1" name="美帆"   text="(今天的套餐要不要选带布丁的那个呢)" voices=""/><char @l="248" id="miho" pos="auto" src="miho110"/><msg @l="250" char_id="0" frame_id="-1" name="美帆"   text="(之后给亚季奈带过去的话，她会高兴吗……)" voices=""/><clear @l="253" class="char"/><msg @l="255" char_id="-1" frame_id="-1" name=""   text="我一边想着这些事，一边快步走向食堂。" voices=""/><stopbgm @l="258" fadeout="1000"/><clear @l="261" class="all"/><msgshow @l="263" show="true"/><wait_chgmv/><bg @l="266" src="bg10"/><bgm @l="269" src="bgm02" volume="1."/><msg @l="271" char_id="-1" frame_id="-1" name=""   text="像往常一样，我怀着忧郁的心情来到了游泳部的训练场。" voices=""/><msg @l="272" char_id="-1" frame_id="-1" name=""   text="我以为今天又会被捉弄。但是……。" voices=""/><char @l="275" id="miho" pos="auto" src="miho064"/><msg @l="277" char_id="0" frame_id="-1" name="美帆" text="『游泳比赛……是吗？』"   voices=""/><clear @l="280" class="char"/><char @l="282" id="miho" pos="left" src="miho064"/><char @l="284" id="watab" pos="right" src="watabe010"/><msg @l="286" char_id="-1" frame_id="-1" name="渡部"   text="『没错。大学里的游泳社团提出了申请。』" voices=""/><char @l="289" id="miho" pos="left" src="miho066"/><msg @l="291" char_id="0" frame_id="-1" name="美帆" text="『啊……但是，为什么要告诉我这个？』"   voices=""/><msg @l="293" char_id="-1" frame_id="-1" name="渡部"   text="『既然社团指名的是你，那也没办法吧。』" voices=""/><msg @l="295" char_id="0" frame_id="-1" name="美帆" text="『指名……。』" voices=""/><msg @l="297" char_id="-1" frame_id="-1" name="声音" text="『哦哦，美帆酱！』"   voices=""/><char @l="300" id="miho" pos="left" src="miho064"/><msg @l="302" char_id="0" frame_id="-1" name="美帆" text="『诶……这、这个声音是！？』"   voices=""/><msg @l="304" char_id="-1" frame_id="-1" name=""   text="被那熟悉的奇怪语调吓了一跳，回头一看，室内游泳池入口处站着那位留学生，他身后还跟着几名游泳社团的成员。"   voices=""/><msg @l="305" char_id="-1" frame_id="-1" name=""   text="顺便一提……在留学生身后待命的社团成员们全都面露僵硬的表情。" voices=""/><msg @l="306" char_id="-1" frame_id="-1" name="" text="大概是对他的行为感到厌烦吧。"   voices=""/><msg @l="308" char_id="0" frame_id="-1" name="美帆"   text="『难道，指名我的游泳社团的人……是他吗？』" voices=""/><char @l="311" id="watab" pos="right" src="watabe014"/><msg @l="313" char_id="-1" frame_id="-1" name="渡部"   text="『好像是这样。你做了什么吗？』" voices=""/><char @l="316" id="miho" pos="left" src="miho066"/><char @l="318" id="watab" pos="right" src="watabe010"/><msg @l="320" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="322" char_id="-1" frame_id="-1" name=""   text="难道说……他对昨天的事情耿耿于怀了吗？" voices=""/><msg @l="324" char_id="-1" frame_id="-1" name="留学生" text="『昨天，失，礼，了。』"   voices=""/><msg @l="326" char_id="-1" frame_id="-1" name="留学生"   text="『今天，正正堂堂，比赛吧。』" voices=""/><msg @l="328" char_id="0" frame_id="-1" name="美帆" text="『啊，啊……。』" voices=""/><msg @l="330" char_id="-1" frame_id="-1" name=""   text="为什么做了失礼的事情，就非得正正堂堂地比赛不可呢。" voices=""/><msg @l="331" char_id="-1" frame_id="-1" name=""   text="与其说如此，他竟然意识到自己做了失礼的事情，这点倒是令人吃惊。" voices=""/><msg @l="333" char_id="-1" frame_id="-1" name="渡部" text="『昨天……发生什么事了？』"   voices=""/><char @l="336" id="miho" pos="left" src="miho166"/><msg @l="338" char_id="0" frame_id="-1" name="美帆"   text="『没，没什么……不是什么大事……。』" voices=""/><char @l="341" id="miho" pos="left" src="miho060"/><msg @l="343" char_id="0" frame_id="-1" name="美帆"   text="『话说回来，游泳比赛该怎么进行呢？』" voices=""/><msg @l="345" char_id="-1" frame_id="-1" name="留学生" text="『喔！OK吗！？』"   voices=""/><char @l="348" id="miho" pos="left" src="miho066"/><msg @l="350" char_id="0" frame_id="-1" name="美帆" text="『嗯，嗯……好吧。』"   voices=""/><msg @l="352" char_id="-1" frame_id="-1" name=""   text="在这里如果奇怪地拒绝他的提议，反而可能会让他提起昨天的事情，那就麻烦了……。" voices=""/><msg @l="353" char_id="-1" frame_id="-1" name=""   text="如果通过游泳比赛，能把昨天的事情彻底一笔勾销的话……。" voices=""/><msg @l="354" char_id="-1" frame_id="-1" name=""   text="无论过程如何，那样做总是好的。" voices=""/><msg @l="355" char_id="-1" frame_id="-1" name="留学生"   text="『规则，很简单。我和你，100米游泳。OK？』" voices=""/><msg @l="357" char_id="-1" frame_id="-1" name="留学生"   text="『谁，先到终点，谁赢。』" voices=""/><char @l="360" id="miho" pos="left" src="miho060"/><msg @l="362" char_id="0" frame_id="-1" name="美帆"   text="『明白了……是100米自由泳，对吧？』" voices=""/><msg @l="364" char_id="-1" frame_id="-1" name="留学生" text="『耶斯，耶斯。』"   voices=""/><char @l="367" id="akina" pos="right" src="akina060"/><msg @l="369" char_id="2" frame_id="-1" name="亚季奈"   text="『虽然我不太明白是怎么回事……。既然如此，要不要我来当裁判？』" voices=""/><msg @l="371" char_id="0" frame_id="-1" name="美帆" text="『嗯，可以拜托你吗？』"   voices=""/><msg @l="373" char_id="2" frame_id="-1" name="亚季奈" text="『okk。』" voices=""/><char @l="376" id="akina" pos="right" src="akina062"/><msg @l="378" char_id="2" frame_id="-1" name="亚季奈"   text="『说实话，我也很久没看到姐姐认真游泳的样子了。』" voices=""/><char @l="381" id="miho" pos="left" src="miho066"/><msg @l="383" char_id="0" frame_id="-1" name="美帆" text="『真是的……』" voices=""/><char @l="386" id="watab" pos="right" src="watabe014"/><msg @l="388" char_id="-1" frame_id="-1" name="渡部"   text="『练习时间有限……请简短一点。』" voices=""/><char @l="391" id="akina" pos="right" src="akina060"/><msg @l="393" char_id="2" frame_id="-1" name="亚季奈" text="『好～！』" voices=""/><msg @l="395" char_id="-1" frame_id="-1" name="留学生" text="『嗖！』" voices=""/><msg @l="397" char_id="-1" frame_id="-1" name=""   text="听到渡部的话，亚季奈和留学生精神饱满地回应着。" voices=""/><msg @l="398" char_id="-1" frame_id="-1" name=""   text="不知不觉间，比起当事人的我，亚季奈反而更加兴致勃勃，这让我有点害怕。" voices=""/><char @l="401" id="miho" pos="left" src="miho160"/><msg @l="403" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="405" char_id="0" frame_id="-1" name="美帆" text="(游泳比赛吗……)" voices=""/><msg @l="407" char_id="0" frame_id="-1" name="美帆"   text="(希望能平安无事地结束……)" voices=""/><msg @l="409" char_id="-1" frame_id="-1" name=""   text="我感到漠然的不安，轻轻地叹了口气。" voices=""/><clear @l="412" class="all"/><wait_chgmv/><bg @l="415" src="bg10"/><char @l="418" id="akina" pos="auto" src="akina060"/><msg @l="420" char_id="2" frame_id="-1" name="亚季奈" text="『你们两个，准备好了吗？』"   voices=""/><msg @l="422" char_id="-1" frame_id="-1" name=""   text="亚季奈交替看着站在跳台前的我和那位留学生，问道。" voices=""/><msg @l="423" char_id="-1" frame_id="-1" name=""   text="亚季奈脖子上挂着带绳子的哨子，双手拿着秒表，一副准备万全的样子。" voices=""/><char @l="426" id="miho" pos="auto" src="miho060"/><msg @l="428" char_id="0" frame_id="-1" name="美帆" text="『嗯，嗯……没问题。』"   voices=""/><msg @l="430" char_id="-1" frame_id="-1" name="留学生" text="『欧啦！』"   voices=""/><char @l="433" id="akina" pos="auto" src="akina060"/><msg @l="435" char_id="2" frame_id="-1" name="亚季奈"   text="『你们两个都上跳台～。』" voices=""/><msg @l="437" char_id="2" frame_id="-1" name="亚季奈"   text="『听到哨声的同时跳入水中哦。』" voices=""/><msg @l="439" char_id="2" frame_id="-1" name="亚季奈"   text="『抢跳和终点之类的细节判定由我来负责。』" voices=""/><char @l="442" id="miho" pos="auto" src="miho060"/><msg @l="444" char_id="0" frame_id="-1" name="美帆" text="『好的。』" voices=""/><msg @l="446" char_id="-1" frame_id="-1" name="留学生" text="『拜托您了。』"   voices=""/><char @l="449" id="akina" pos="auto" src="akina161"/><msg @l="451" char_id="2" frame_id="-1" name="亚季奈" text="『很好。』" voices=""/><msg @l="453" char_id="-1" frame_id="-1" name=""   text="亚季奈点点头，把哨子含在嘴里。" voices=""/><msg @l="454" char_id="-1" frame_id="-1" name=""   text="双手则放在秒表的开始按钮上。" voices=""/><clear @l="457" class="char"/><stopbgm @l="460" fadeout="1000"/><msg @l="462" char_id="2" frame_id="-1" name="亚季奈" text="『那么，预备～。』"   voices=""/><msg @l="464" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="466" char_id="-1" frame_id="-1" name="留学生" text="『……。』" voices=""/><msg @l="468" char_id="-1" frame_id="-1" name=""   text="我们分别站在自己赛道上的跳台上。" voices=""/><msg @l="469" char_id="-1" frame_id="-1" name=""   text="脚趾抓住跳台边缘，慢慢地……摆出前屈姿势。" voices=""/><msg @l="470" char_id="-1" frame_id="-1" name=""   text="尽管从小重复过无数次，这一刻还是会不由自主地紧张起来。" voices=""/><msg @l="472" char_id="0" frame_id="-1" name="美帆"   text="(既然要比赛就要努力争取胜利……)" voices=""/><msg @l="474" char_id="0" frame_id="-1" name="美帆"   text="(我好歹也有作为有经验者的骄傲)" voices=""/><msg @l="476" char_id="-1" frame_id="-1" name=""   text="就在我怀揣着这微小的决心的那一瞬间——。" voices=""/><se @l="479" buf="1" src="ホイッスル（室内プール）" volume="1."/><se @l="482" buf="1" src="飛び込む音" volume="1."/><bgm @l="485" src="bgm17" volume="1."/><msg @l="487" char_id="0" frame_id="-1" name="美帆" text="『……！！』" voices=""/><msg @l="489" char_id="-1" frame_id="-1" name=""   text="随着哨声响起，我和那位留学生几乎同时跳入水中。" voices=""/><msg @l="490" char_id="-1" frame_id="-1" name=""   text="一旦进入水中，就会与外界完全隔绝。" voices=""/><msg @l="491" char_id="-1" frame_id="-1" name="" text="视野中铺展开的是一片水的世界。"   voices=""/><msg @l="492" char_id="-1" frame_id="-1" name=""   text="能听到的只有划开水流前进的声音。" voices=""/><msg @l="493" char_id="-1" frame_id="-1" name="" text="还有……心跳声就在耳边回响。"   voices=""/><msg @l="495" char_id="0" frame_id="-1" name="美帆" text="(首先是……)" voices=""/><msg @l="499" async="true" char_id="-1" frame_id="-1" name=""   text="跳水之后……怎么办？" voices=""/><select @l="500"><menu @l="504" label="EventLabel_66" text="立即浮出水面发起快攻"/><menu @l="507" label="EventLabel_67" text="潜泳一段时间观察情况"/></select><label @l="515" id="EventLabel_66"/><msg @l="517" char_id="0" frame_id="-1" name="美帆" text="(立刻浮上水面发动快攻……！)"   voices=""/><msg @l="519" char_id="-1" frame_id="-1" name=""   text="我还没游到10米就浮出水面开始游泳。" voices=""/><msg @l="520" char_id="-1" frame_id="-1" name=""   text="再怎么自满于过去保持过记录，也要避免被绊倒。" voices=""/><goto @l="523" label="EventLabel_68"/><label @l="527" id="EventLabel_67"/><msg @l="529" char_id="0" frame_id="-1" name="美帆"   text="(嗯……还是按照基本原则，开始时潜水不要完全消耗跳水的力量，争取获得距离优势吧)" voices=""/><msg @l="531" char_id="-1" frame_id="-1" name=""   text="我决定潜在水下，观察一会儿情况。" voices=""/><msg @l="532" char_id="-1" frame_id="-1" name=""   text="如果在前半段过度消耗体力，对我来说就不利了。" voices=""/><eval @l="535" expr="f.水泳勝負flag&#32;+=&#32;1&#13;&#10;"/><label @l="539" id="EventLabel_68"/><msg @l="541" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="543" char_id="-1" frame_id="-1" name=""   text="在游过大约一半赛道时，我们横向排成了一列。" voices=""/><msg @l="544" char_id="-1" frame_id="-1" name=""   text="通常，从起跳到浮出水面这段过程会反映出身体能力的差异……" voices=""/><msg @l="545" char_id="-1" frame_id="-1" name=""   text="在腿部力量和爆发力方面，他似乎并不太出色。" voices=""/><msg @l="547" char_id="0" frame_id="-1" name="美帆" text="(好了……真正的比赛从现在开始……)"   voices=""/><msg @l="549" char_id="0" frame_id="-1" name="美帆"   text="(要回忆过去，做回自己的游泳方式)" voices=""/><msg @l="551" char_id="0" frame_id="-1" name="美帆" text="(先从姿势开始……)"   voices=""/><msg @l="555" async="true" char_id="-1" frame_id="-1" name=""   text="游泳姿势是……？" voices=""/><select @l="556"><menu @l="560" label="EventLabel_69" text="放松身体的力量，伸展手臂"/><menu @l="563" label="EventLabel_70" text="在手臂上用力，划开水面"/></select><label @l="571" id="EventLabel_69"/><msg @l="573" char_id="0" frame_id="-1" name="美帆"   text="(放松手臂的力量，好好伸展……)" voices=""/><msg @l="575" char_id="-1" frame_id="-1" name=""   text="如果用力过猛，反作用力会导致身体下沉，增加阻力。" voices=""/><msg @l="576" char_id="-1" frame_id="-1" name="" text="结果就是体力消耗得更快。"   voices=""/><msg @l="577" char_id="-1" frame_id="-1" name=""   text="我在心中反复念叨着当初指导游泳部时说过的话，仿佛在提醒自己。" voices=""/><msg @l="578" char_id="-1" frame_id="-1" name=""   text="即使是过度紧张用力……也发挥不出真正的力量。" voices=""/><msg @l="580" char_id="0" frame_id="-1" name="美帆" text="(希望这样能掌握好节奏……)"   voices=""/><msg @l="582" char_id="-1" frame_id="-1" name=""   text="即使头脑理解了，问题是身体能否跟上。" voices=""/><msg @l="583" char_id="-1" frame_id="-1" name="" text="三年的空白期……太长了。"   voices=""/><eval @l="586" expr="f.水泳勝負flag&#32;+=&#32;1&#13;&#10;"/><goto @l="590" label="EventLabel_71"/><label @l="593" id="EventLabel_70"/><msg @l="595" char_id="0" frame_id="-1" name="美帆"   text="(不行……得尽早拉开距离……)" voices=""/><msg @l="597" char_id="-1" frame_id="-1" name=""   text="技术暂且不论，根本的体力差距确实无法忽视。" voices=""/><msg @l="598" char_id="-1" frame_id="-1" name=""   text="这样的话，与其等到后半程被追上时慌乱，不如在前半程就尽可能拉开差距。" voices=""/><msg @l="599" char_id="-1" frame_id="-1" name="" text="但是……" voices=""/><msg @l="601" char_id="0" frame_id="-1" name="美帆"   text="(咦……没能像想象中那样前进……)" voices=""/><msg @l="603" char_id="0" frame_id="-1" name="美帆"   text="(果然，是因为中断太久了吗……)" voices=""/><msg @l="605" char_id="-1" frame_id="-1" name=""   text="即使用力划水也无法如愿前进，我的身体深深沉入水中。" voices=""/><msg @l="606" char_id="-1" frame_id="-1" name=""   text="这样沉入水中后，自然阻力也会变大，速度变慢。" voices=""/><label @l="609" id="EventLabel_71"/><msg @l="611" char_id="0" frame_id="-1" name="美帆" text="(不行……并排着没法甩开她)"   voices=""/><msg @l="613" char_id="0" frame_id="-1" name="美帆" text="(意外地快啊……？)"   voices=""/><msg @l="615" char_id="-1" frame_id="-1" name=""   text="在喘息的间隙，我瞥了一眼隔壁泳道，他正紧紧地咬着我，位置离我并不远。" voices=""/><msg @l="617" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="619" char_id="-1" frame_id="-1" name="" text="在50米处转身。"   voices=""/><msg @l="620" char_id="-1" frame_id="-1" name=""   text="虽然一瞬间有些困惑……但身体似乎还记得，转身很顺利。" voices=""/><msg @l="621" char_id="-1" frame_id="-1" name=""   text="不过，那个留学生也紧紧地跟在我身后不远处。" voices=""/><msg @l="622" char_id="-1" frame_id="-1" name="" text="最后的50米，这里是关键时刻。"   voices=""/><msg @l="626" async="true" char_id="-1" frame_id="-1" name=""   text="最后50米……怎么办？" voices=""/><select @l="627"><menu @l="631" label="EventLabel_72" text="加快速度甩开对手"/><menu @l="634" label="EventLabel_73" text="坚持按自己的节奏游"/></select><label @l="642" id="EventLabel_72"/><msg @l="644" char_id="0" frame_id="-1" name="美帆"   text="(还剩50米……必须一口气拉开差距！)" voices=""/><msg @l="646" char_id="-1" frame_id="-1" name=""   text="我开始冲刺，试图一口气甩开在隔壁泳道的留学生。" voices=""/><msg @l="647" char_id="-1" frame_id="-1" name=""   text="不过，对方也在冲刺，所以最终这变成了体力的较量。" voices=""/><msg @l="648" char_id="-1" frame_id="-1" name=""   text="如果就这样持续50米的体力较量……对我来说有些不利。" voices=""/><goto @l="651" label="EventLabel_74"/><label @l="654" id="EventLabel_73"/><msg @l="656" char_id="0" frame_id="-1" name="美帆"   text="(体力对决会输掉……还是要保持自己的节奏，冷静应对)" voices=""/><msg @l="658" char_id="-1" frame_id="-1" name=""   text="我一边反复告诉自己，一边压抑着急躁的情绪。" voices=""/><msg @l="659" char_id="-1" frame_id="-1" name=""   text="即使勉强提高速度，体力也会支撑不住。" voices=""/><msg @l="660" char_id="-1" frame_id="-1" name="" text="那就只需要继续保持自己的游泳节奏。"   voices=""/><eval @l="663" expr="f.水泳勝負flag&#32;+=&#32;1&#13;&#10;"/><label @l="667" id="EventLabel_74"/><msg @l="669" char_id="-1" frame_id="-1" name="留学生" text="『……。』" voices=""/><msg @l="671" char_id="-1" frame_id="-1" name="" text="那位留学生……微微地超过了我。"   voices=""/><msg @l="672" char_id="-1" frame_id="-1" name="" text="他大概是开始了最后冲刺。"   voices=""/><goto @l="675" cond="!(f.水泳勝負flag&#32;&gt;=&#32;2)&#13;&#10;"   label="TempLabel_215"/><msg @l="677" char_id="0" frame_id="-1" name="美帆"   text="(没关系……那种加速的节奏，不会持续太久)" voices=""/><msg @l="679" char_id="-1" frame_id="-1" name="" text="我怀着确信继续游泳。"   voices=""/><msg @l="680" char_id="-1" frame_id="-1" name=""   text="相信自己、不急躁，这似乎忠实地再现了我过去的泳姿。" voices=""/><msg @l="682" char_id="0" frame_id="-1" name="美帆" text="『哈……哈……哈………。』"   voices=""/><msg @l="684" char_id="-1" frame_id="-1" name="" text="自己以固定间隔进行的呼吸感觉舒适。"   voices=""/><msg @l="686" char_id="0" frame_id="-1" name="美帆" text="(没关系……)" voices=""/><msg @l="688" char_id="-1" frame_id="-1" name=""   text="我再一次，仿佛在对自己说话般在心中低语。" voices=""/><msg @l="689" char_id="-1" frame_id="-1" name="" text="神奇的是，我并没有认输的念头。"   voices=""/><msg @l="690" char_id="-1" frame_id="-1" name=""   text="还剩40米、30米、20米……。" voices=""/><msg @l="691" char_id="-1" frame_id="-1" name=""   text="就在还剩15米的地方，变化出现了。" voices=""/><msg @l="693" char_id="-1" frame_id="-1" name="留学生" text="『……嘶……。』"   voices=""/><msg @l="695" char_id="-1" frame_id="-1" name=""   text="隔壁游泳的留学生的速度明显地下降了。" voices=""/><msg @l="696" char_id="-1" frame_id="-1" name=""   text="是腿抽筋了，还是疲劳达到了极限呢。" voices=""/><msg @l="697" char_id="-1" frame_id="-1" name=""   text="些微的差距顷刻间缩小，然后…………。" voices=""/><se @l="700" buf="1" src="ホイッスル（室内プール）" volume="1."/><msg @l="702" char_id="-1" frame_id="-1" name="" text="哔————————————！！"   voices=""/><msg @l="703" char_id="-1" frame_id="-1" name="" text="哨声高亢地响起。"   voices=""/><stopbgm @l="706" fadeout="1000"/><char @l="709" id="akina" pos="auto" src="akina060"/><msg @l="711" char_id="2" frame_id="-1" name="亚季奈" text="『第一名，姐姐！！』"   voices=""/><msg @l="713" char_id="-1" frame_id="-1" name="" text="泳池边传来亚季奈的声音。"   voices=""/><msg @l="714" char_id="-1" frame_id="-1" name=""   text="我听着这声音，凝视着天花板……眯起了眼睛。" voices=""/><msg @l="716" char_id="-1" frame_id="-1" name="留学生" text="『该死！！』"   voices=""/><msg @l="718" char_id="-1" frame_id="-1" name=""   text="隔壁泳道上，那位留学生一直发出懊恼的声音。" voices=""/><clear @l="722" class="all"/><wait_chgmv/><bg @l="725" src="bg10m1"/><bgm @l="728" src="bgm06" volume="1."/><char @l="731" id="akina" pos="auto" src="akina061"/><msg @l="733" char_id="2" frame_id="-1" name="亚季奈" text="『姐姐，太棒了♪』"   voices=""/><msg @l="735" char_id="-1" frame_id="-1" name=""   text="当我从泳道上岸到泳池边时，迎接我的亚季奈这样说着，还做了个胜利的手势。" voices=""/><clear @l="738" class="char"/><char @l="740" id="akina" pos="left" src="akina061"/><char @l="742" id="miho" pos="right" src="miho060"/><msg @l="744" char_id="0" frame_id="-1" name="美帆"   text="『只是偶然而已。因为很久没游了，所以相当不适应。』" voices=""/><msg @l="746" char_id="2" frame_id="-1" name="亚季奈"   text="『哎呀呀～，最后15米简直太厉害了。』" voices=""/><char @l="749" id="akina" pos="left" src="akina062"/><msg @l="751" char_id="2" frame_id="-1" name="亚季奈"   text="『这可是间隔了3年的空白期啊，真是名副其实的天才呢。』" voices=""/><msg @l="753" char_id="0" frame_id="-1" name="美帆"   text="『够了，再怎么奉承我也不会有什么好处的。』" voices=""/><char @l="756" id="akina" pos="left" src="akina161"/><msg @l="758" char_id="2" frame_id="-1" name="亚季奈" text="『切，被发现了吗。』"   voices=""/><char @l="761" id="miho" pos="right" src="miho061"/><msg @l="763" char_id="0" frame_id="-1" name="美帆" text="『那是当然的。』"   voices=""/><char @l="766" id="akina" pos="left" src="akina060"/><msg @l="768" char_id="-1" frame_id="-1" name="留学生" text="『……。』" voices=""/><char @l="771" id="miho" pos="right" src="miho060"/><msg @l="773" char_id="0" frame_id="-1" name="美帆" text="『啊，呃……那个……你好。』"   voices=""/><msg @l="775" char_id="-1" frame_id="-1" name=""   text="回过神来……那位留学生也已经上岸来到了泳池边。" voices=""/><msg @l="776" char_id="-1" frame_id="-1" name=""   text="看他那副闷闷不乐的样子，大概是没想到会输吧。" voices=""/><msg @l="778" char_id="-1" frame_id="-1" name="留学生" text="『……我，认输了。』"   voices=""/><msg @l="780" char_id="-1" frame_id="-1" name="留学生"   text="『……对你的事，我放弃了。』" voices=""/><char @l="783" id="miho" pos="right" src="miho066"/><msg @l="785" char_id="0" frame_id="-1" name="美帆" text="『啊，哈啊……。』" voices=""/><msg @l="787" char_id="-1" frame_id="-1" name=""   text="说完这些话，那位留学生垂头丧气地走开了。" voices=""/><char @l="790" id="akina" pos="left" src="akina060"/><msg @l="792" char_id="2" frame_id="-1" name="亚季奈" text="『………。』" voices=""/><msg @l="794" char_id="2" frame_id="-1" name="亚季奈" text="『那是怎么回事啊？』"   voices=""/><char @l="797" id="miho" pos="right" src="miho060"/><msg @l="799" char_id="0" frame_id="-1" name="美帆" text="『谁，谁知道……？』" voices=""/><stopbgm @l="802" fadeout="1000"/><clear @l="805" class="all"/><msgshow @l="807" show="true"/><goto @l="810" label="EventLabel_75"/><label @l="812" id="TempLabel_215"/><msg @l="815" char_id="0" frame_id="-1" name="美帆" text="(这样下去，追不上了……！？)"   voices=""/><msg @l="817" char_id="-1" frame_id="-1" name="" text="突然一阵焦急袭上了我的心头。"   voices=""/><msg @l="818" char_id="-1" frame_id="-1" name=""   text="即使有休息期，这种水上比赛我也不应该输才对。" voices=""/><msg @l="820" char_id="0" frame_id="-1" name="美帆"   text="(还有30米……这样的话！)" voices=""/><msg @l="822" char_id="-1" frame_id="-1" name="" text="我加快了手臂的划水速度。"   voices=""/><msg @l="823" char_id="-1" frame_id="-1" name="" text="距离上还完全有机会追上。"   voices=""/><msg @l="825" char_id="-1" frame_id="-1" name="留学生" text="『……嗯……。』"   voices=""/><msg @l="827" char_id="-1" frame_id="-1" name=""   text="在还剩15米的地方，他的速度突然慢了下来。" voices=""/><msg @l="828" char_id="-1" frame_id="-1" name="" text="我不由自主地确信胜利在望。"   voices=""/><msg @l="829" char_id="-1" frame_id="-1" name="" text="就在那一瞬间——————。" voices=""/><msg @l="831" char_id="0" frame_id="-1" name="美帆" text="(咦……)" voices=""/><msg @l="833" char_id="-1" frame_id="-1" name="" text="突然……我的腿不能动了。"   voices=""/><msg @l="834" char_id="-1" frame_id="-1" name=""   text="先是感觉消失，仿佛麻痹了一般，然后一阵如同电击般的剧烈疼痛从小腿部位窜过。"   voices=""/><msg @l="836" char_id="0" frame_id="-1" name="美帆" text="(抽筋了……！？)" voices=""/><msg @l="838" char_id="-1" frame_id="-1" name="" text="可能是因为突然加速吧。"   voices=""/><msg @l="839" char_id="-1" frame_id="-1" name=""   text="或者是准备运动不够充分……。" voices=""/><msg @l="841" char_id="0" frame_id="-1" name="美帆"   text="(但是，只剩大约10米的话……)" voices=""/><msg @l="843" char_id="-1" frame_id="-1" name=""   text="忍受这疼痛前进几秒钟就能完成的距离。" voices=""/><msg @l="844" char_id="-1" frame_id="-1" name="" text="那样的话也许就能赢。"   voices=""/><msg @l="845" char_id="-1" frame_id="-1" name="" text="……这个判断是错误的。"   voices=""/><clear @l="848" class="all"/><msg @l="850" char_id="0" frame_id="-1" name="美帆" text="(不行，我在下沉……！？)"   voices=""/><msg @l="852" char_id="-1" frame_id="-1" name=""   text="当我试图仅用双臂前进以避免使用抽筋的腿时，结果我的姿势剧烈地崩塌并沉了下去。" voices=""/><msg @l="854" char_id="0" frame_id="-1" name="美帆"   text="(怎么会……终点就在眼前了……)" voices=""/><msg @l="856" char_id="-1" frame_id="-1" name="" text="我拼命地划水试图浮上来。"   voices=""/><msg @l="857" char_id="-1" frame_id="-1" name=""   text="然而与我的努力相反，越是挣扎，身体就沉得越深。" voices=""/><msg @l="858" char_id="-1" frame_id="-1" name="" text="呼吸困难。" voices=""/><msg @l="859" char_id="-1" frame_id="-1" name="" text="身体异常沉重。" voices=""/><msg @l="860" char_id="-1" frame_id="-1" name="" text="意识……渐渐远去。"   voices=""/><msg @l="862" char_id="0" frame_id="-1" name="美帆"   text="(我……为什么要做这种事呢……)" voices=""/><msg @l="864" char_id="-1" frame_id="-1" name=""   text="透过泳镜看着波动不停的水面，我的意识慢慢地坠入了黑暗中……" voices=""/><stopbgm @l="867" fadeout="1000"/><clear @l="870" class="all"/><msgshow @l="873" show="true"/><wait_chgmv/><bg @l="876" src="bg10"/><bgm @l="879" src="bgm03" volume="1."/><msg @l="881" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="883" char_id="-1" frame_id="-1" name=""   text="美帆失去意识的身体被横放在泳池边上。" voices=""/><msg @l="884" char_id="-1" frame_id="-1" name=""   text="她似乎完全失去了知觉，瘫软着一动不动。" voices=""/><msg @l="885" char_id="-1" frame_id="-1" name="" text="在美帆身旁……渡部正在守候着。"   voices=""/><char @l="888" id="akina" pos="auto" src="akina064"/><msg @l="890" char_id="2" frame_id="-1" name="亚季奈" text="『姐姐，姐姐……！？』"   voices=""/><msg @l="892" char_id="-1" frame_id="-1" name="" text="亚季奈推开围观的人群，跑了过来。"   voices=""/><char @l="895" id="akina" pos="auto" src="akina065"/><msg @l="897" char_id="2" frame_id="-1" name="亚季奈"   text="『渡部老师……我姐姐没事吧！？』" voices=""/><clear @l="900" class="char"/><char @l="902" id="akina" pos="left" src="akina065"/><char @l="904" id="watab" pos="right" src="watabe014"/><msg @l="906" char_id="-1" frame_id="-1" name="渡部"   text="『腿抽筋了啊……不是现役选手还勉强自己，所以才会这样。』" voices=""/><char @l="909" id="akina" pos="left" src="akina165"/><msg @l="911" char_id="2" frame_id="-1" name="亚季奈"   text="『比起这个，姐姐的情况怎么样啊？』" voices=""/><msg @l="913" char_id="-1" frame_id="-1" name="渡部" text="『啊，对了对了。』"   voices=""/><msg @l="915" char_id="-1" frame_id="-1" name="渡部"   text="『嗯……看来吸入了一些水。』" voices=""/><msg @l="917" char_id="-1" frame_id="-1" name="渡部"   text="『呼吸很微弱，肺里可能进水了。』" voices=""/><msg @l="919" char_id="2" frame_id="-1" name="亚季奈" text="『那个，很危险吗……？』"   voices=""/><char @l="922" id="watab" pos="right" src="watabe014"/><msg @l="924" char_id="-1" frame_id="-1" name="渡部"   text="『如果肺里进水的话，确实很危险。』" voices=""/><char @l="927" id="akina" pos="left" src="akina064"/><msg @l="929" char_id="2" frame_id="-1" name="亚季奈" text="『怎么会……』"   voices=""/><msg @l="931" char_id="-1" frame_id="-1" name="渡部"   text="『这样吧……现在把仲根送到更衣室去进行人工呼吸和心脏按摩。』" voices=""/><char @l="934" id="watab" pos="right" src="watabe014"/><msg @l="936" char_id="-1" frame_id="-1" name="渡部"   text="『除了我指定的人外，其他人都回去继续训练吧。』" voices=""/><char @l="939" id="akina" pos="left" src="akina164"/><msg @l="941" char_id="2" frame_id="-1" name="亚季奈" text="『我、我也要去！』"   voices=""/><msg @l="943" char_id="-1" frame_id="-1" name="渡部" text="『你不行。』"   voices=""/><char @l="946" id="akina" pos="left" src="akina065"/><msg @l="948" char_id="2" frame_id="-1" name="亚季奈" text="『为什么啊！？』"   voices=""/><msg @l="950" char_id="-1" frame_id="-1" name="渡部"   text="『亲人在急救处置旁边的话，可能无法冷静地应对吧。』" voices=""/><char @l="953" id="akina" pos="left" src="akina165"/><msg @l="955" char_id="2" frame_id="-1" name="亚季奈" text="『……。』" voices=""/><char @l="958" id="watab" pos="right" src="watabe010"/><msg @l="960" char_id="-1" frame_id="-1" name="渡部"   text="『别担心，我会救你姐姐的。』" voices=""/><msg @l="962" char_id="2" frame_id="-1" name="亚季奈" text="『……好。』" voices=""/><msg @l="964" char_id="-1" frame_id="-1" name="渡部"   text="『喂，明白了就赶紧回去训练。』" voices=""/><msg @l="966" char_id="2" frame_id="-1" name="亚季奈" text="『我、我知道了……。』"   voices=""/><char @l="969" id="akina" pos="auto" src="akina065"/><msg @l="971" char_id="2" frame_id="-1" name="亚季奈"   text="『姐姐……绝对不可以死啊！！』" voices=""/><msg @l="973" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><clear @l="976" class="char"/><char @l="978" id="watab" pos="auto" src="watabe014"/><msg @l="980" char_id="-1" frame_id="-1" name="渡部"   text="『好，那么你和你，只要你们两个帮忙搬运。』" voices=""/><msg @l="982" char_id="-1" frame_id="-1" name="留学生" text="『我，帮忙。』"   voices=""/><msg @l="984" char_id="-1" frame_id="-1" name=""   text="说着，那位黑人留学生从人群中向前迈出一步。" voices=""/><msg @l="985" char_id="-1" frame_id="-1" name=""   text="也许多少感到了……一些责任吧。" voices=""/><msg @l="987" char_id="-1" frame_id="-1" name="渡部" text="『嗯……好吧。』"   voices=""/><msg @l="989" char_id="-1" frame_id="-1" name="渡部"   text="『那么，其他人可以回去训练了。』" voices=""/><msg @l="991" char_id="-1" frame_id="-1" name="游泳部成员们" text="『知道了……。』"   voices=""/><msg @l="993" char_id="-1" frame_id="-1" name=""   text="几名游泳部员和渡部离开了室内泳池，把美帆抬到了更衣室。" voices=""/><msg @l="994" char_id="-1" frame_id="-1" name=""   text="留下的游泳俱乐部成员们，默默地目送着他们离开。" voices=""/><stopbgm @l="997" fadeout="1000"/><msg @l="998" char_id="-1" frame_id="-1" name=""   text="如果溺水的不是美帆，亚季奈应该会发现渡部说的话是胡说八道。" voices=""/><msg @l="999" char_id="-1" frame_id="-1" name=""   text="虽然微弱但仍在呼吸的美帆并不需要人工呼吸，而且本来就没有“人工按摩”这种说法。" voices=""/><msg @l="1000" char_id="-1" frame_id="-1" name=""   text="即使肺里进了水，只要量少，也不会导致死亡。" voices=""/><msg @l="1001" char_id="-1" frame_id="-1" name=""   text="用一些随便的话，最碍事的亚季奈就被很好地打发走了。" voices=""/><msg @l="1003" char_id="-1" frame_id="-1" name=""   text="而且，没有一个女性部员被选来帮忙，这一点没有人注意到。" voices=""/><clear @l="1006" class="all"/><label @l="1009" id="event_scene24"/><label @l="1012" id="chart_line14"/><wait_chgmv/><ev @l="1015" src="ev-024"/><description @l="1018" text="混浊的凌辱"/><bgm @l="1021" src="bgm15" volume="1."/><msg @l="1023" char_id="-1" frame_id="-1" name="渡部" text="『那么，好了。』" voices=""/><msg @l="1025" char_id="-1" frame_id="-1" name=""   text="到了更衣室，渡部像是在品评商品一样打量着美帆的身体。" voices=""/><msg @l="1026" char_id="-1" frame_id="-1" name="" text="他的嘴角浮现出一抹扭曲的笑容。"   voices=""/><msg @l="1028" char_id="-1" frame_id="-1" name="游泳部成员A"   text="『那个，老师……我们该怎么做？』" voices=""/><msg @l="1030" char_id="-1" frame_id="-1" name="游泳部成员B"   text="『急救措施什么的，我们从来没做过啊……』" voices=""/><msg @l="1032" char_id="-1" frame_id="-1" name="留学生" text="『哦……美帆桑……』"   voices=""/><msg @l="1034" char_id="-1" frame_id="-1" name="渡部"   text="『噗……啊哈哈哈哈，什么呀，你们也信了啊。』" voices=""/><msg @l="1036" char_id="-1" frame_id="-1" name="游泳部成员A" text="『啊……。』"   voices=""/><msg @l="1038" char_id="-1" frame_id="-1" name="游泳部成员B"   text="『信了……什、什么意思？』" voices=""/><msg @l="1040" char_id="-1" frame_id="-1" name="渡部" text="『就是我刚才说的话啊。』"   voices=""/><msg @l="1042" char_id="-1" frame_id="-1" name="留学生" text="『……？』" voices=""/><msg @l="1044" char_id="-1" frame_id="-1" name="渡部" text="『真是群迟钝的家伙。』"   voices=""/><msg @l="1046" char_id="-1" frame_id="-1" name="渡部"   text="『这家伙没事，我的意思是，刚才我说的全是胡说八道。』" voices=""/><msg @l="1048" char_id="-1" frame_id="-1" name="游泳部成员B"   text="『啊……那为什么……』" voices=""/><msg @l="1050" char_id="-1" frame_id="-1" name="渡部"   text="『喂，眼前有这么个漂亮女人啊？』" voices=""/><msg @l="1052" char_id="-1" frame_id="-1" name="渡部"   text="『难道不觉得这是个机会吗……作为男人。』" voices=""/><msg @l="1054" char_id="-1" frame_id="-1" name="游泳部成员A" text="『啊，可是那样……。』"   voices=""/><msg @l="1056" char_id="-1" frame_id="-1" name="游泳部成员B"   text="『这不是……犯罪吗？』" voices=""/><msg @l="1058" char_id="-1" frame_id="-1" name="渡部"   text="『别担心……只是个小恶作剧，不是什么大不了的事。』" voices=""/><msg @l="1060" char_id="-1" frame_id="-1" name="渡部"   text="『而且主犯是我。你们只要默默帮我的忙，也能得到不少好处。』" voices=""/><msg @l="1062" char_id="-1" frame_id="-1" name="游泳部成员A" text="『……。』"   voices=""/><msg @l="1064" char_id="-1" frame_id="-1" name="游泳部成员B" text="『……。』"   voices=""/><msg @l="1066" char_id="-1" frame_id="-1" name="渡部"   text="『看你们那犹豫的表情……不过，看了这个你们还能犹豫吗？』" voices=""/><wait_chgmv/><ev @l="1069" src="ev-024_1"/><msg @l="1071" char_id="-1" frame_id="-1" name="游泳部成员A" text="『哇哇哇哇！？』"   voices=""/><msg @l="1073" char_id="-1" frame_id="-1" name="游泳部成员B"   text="『厉、厉害……真奶啊！』" voices=""/><msg @l="1075" char_id="-1" frame_id="-1" name="留学生"   text="『哦，非常非常漂亮。』" voices=""/><msg @l="1077" char_id="-1" frame_id="-1" name="渡部" text="『怎么样，有干劲了吧？』"   voices=""/><msg @l="1079" char_id="-1" frame_id="-1" name="游泳部成员A"   text="『那是……但是，为什么是我们啊？』" voices=""/><msg @l="1081" char_id="-1" frame_id="-1" name="游泳部成员B"   text="『对，对啊……只有我们什么的……。』" voices=""/><msg @l="1083" char_id="-1" frame_id="-1" name="渡部"   text="『那当然是因为你们在练习的时候总是偷瞄这个女人啊。』" voices=""/><msg @l="1085" char_id="-1" frame_id="-1" name="渡部"   text="『每天不都在宿舍厕所里以这个女人为对象打飞机吗？』" voices=""/><msg @l="1087" char_id="-1" frame_id="-1" name="游泳部成员A"   text="『那，那个……那个……。』" voices=""/><msg @l="1089" char_id="-1" frame_id="-1" name="游泳部成员B"   text="『这个……我不否认。』" voices=""/><msg @l="1091" char_id="-1" frame_id="-1" name="渡部" text="『那就没什么好犹豫的了吧。』"   voices=""/><msg @l="1093" char_id="-1" frame_id="-1" name="渡部" text="『别客气……可以摸摸看哦？』"   voices=""/><msg @l="1095" char_id="-1" frame_id="-1" name="游泳部成员A" text="『……。』"   voices=""/><msg @l="1097" char_id="-1" frame_id="-1" name="游泳部成员B" text="『……。』"   voices=""/><msg @l="1099" char_id="-1" frame_id="-1" name="渡部"   text="『当然，不只是胸部，这里也可以。』" voices=""/><msg @l="1101" char_id="-1" frame_id="-1" name=""   text="渡部这么说着捏住了泳装的裆部，稍微拉开让他们看。" voices=""/><wait_chgmv/><ev @l="1104" src="ev-024_2"/><msg @l="1106" char_id="-1" frame_id="-1" name="游泳部成员A" text="『哇哦！！』"   voices=""/><msg @l="1108" char_id="-1" frame_id="-1" name="游泳部成员B"   text="『那，那那……真的小穴……。』" voices=""/><msg @l="1110" char_id="-1" frame_id="-1" name="留学生"   text="『哦哦，日本妹子的私处。』" voices=""/><wait_chgmv/><ev @l="1113" src="ev-024_1"/><msg @l="1115" char_id="-1" frame_id="-1" name="渡部"   text="『怎么样……只要听我的话就可以随便你们哦？』" voices=""/><msg @l="1117" char_id="-1" frame_id="-1" name="游泳部成员A"   text="『听，听您的……什么都行！』" voices=""/><msg @l="1119" char_id="-1" frame_id="-1" name="游泳部成员B"   text="『我……我也听您的。』" voices=""/><msg @l="1121" char_id="-1" frame_id="-1" name="留学生" text="『OK，我明白了。』"   voices=""/><clear @l="1124" class="all"/><wait_chgmv/><bg @l="1127" src="bg11"/><char @l="1130" id="watab" pos="auto" src="watabe010"/><msg @l="1132" char_id="-1" frame_id="-1" name="渡部" text="『那就这么定了。』"   voices=""/><msg @l="1134" char_id="-1" frame_id="-1" name="渡部"   text="『那就尽情地欺负她吧。』" voices=""/><msg @l="1136" char_id="-1" frame_id="-1" name="游泳部成员A" text="『诶……老师您呢？』"   voices=""/><msg @l="1138" char_id="-1" frame_id="-1" name="游泳部成员B"   text="『您不一起来吗？』" voices=""/><char @l="1141" id="watab" pos="auto" src="watabe012"/><msg @l="1142" char_id="-1" frame_id="-1" name="渡部"   text="『我有点杂事要处理……。』" voices=""/><char @l="1145" id="watab" pos="auto" src="watabe014"/><msg @l="1147" char_id="-1" frame_id="-1" name="渡部"   text="『还有，摸也好做什么都行，但绝对不能做本垒打。』" voices=""/><msg @l="1149" char_id="-1" frame_id="-1" name="留学生" text="『本垒打？』"   voices=""/><msg @l="1151" char_id="-1" frame_id="-1" name="渡部" text="『就是说不能做爱。』"   voices=""/><msg @l="1153" char_id="-1" frame_id="-1" name="留学生" text="『哦，不行！』"   voices=""/><msg @l="1155" char_id="-1" frame_id="-1" name="渡部"   text="『只要遵守约定，之后我会好好让你们做全套的。』" voices=""/><char @l="1158" id="watab" pos="auto" src="watabe010"/><msg @l="1160" char_id="-1" frame_id="-1" name="渡部" text="『明白了吗？』"   voices=""/><msg @l="1162" char_id="-1" frame_id="-1" name="留学生" text="『……遵命。』"   voices=""/><msg @l="1164" char_id="-1" frame_id="-1" name="渡部"   text="『那就……尽量不要弄出太大动静。』" voices=""/><clear @l="1167" class="char"/><msg @l="1169" char_id="-1" frame_id="-1" name="" text="说完，渡部离开了更衣室。"   voices=""/><msg @l="1171" char_id="-1" frame_id="-1" name="游泳部成员A"   text="『老师……去干什么了呢？』" voices=""/><msg @l="1173" char_id="-1" frame_id="-1" name="游泳部成员B"   text="『那种事，无所谓啦。』" voices=""/><msg @l="1175" char_id="-1" frame_id="-1" name="留学生" text="『没错。』"   voices=""/><msg @l="1177" char_id="-1" frame_id="-1" name="游泳部成员A" text="『哦，哦……！』"   voices=""/><clear @l="1180" class="all"/><wait_chgmv/><ev @l="1183" src="ev-024_1"/><msg @l="1185" char_id="-1" frame_id="-1" name="游泳部成员A"   text="『那，那么……我要把下面也脱掉了哦？』" voices=""/><msg @l="1187" char_id="-1" frame_id="-1" name="游泳部成员B"   text="『别磨蹭了……得抓紧点，谁知道她什么时候会醒过来。』" voices=""/><msg @l="1189" char_id="-1" frame_id="-1" name="留学生" text="『嘿，快点。』"   voices=""/><msg @l="1191" char_id="-1" frame_id="-1" name=""   text="留学生这么说着，毫不犹豫地脱下了她的泳衣。" voices=""/><msg @l="1192" char_id="-1" frame_id="-1" name=""   text="美帆一丝不挂的身体毫无保留地展现在众人面前。" voices=""/><wait_chgmv/><ev @l="1195" src="ev-024_2"/><msg @l="1197" char_id="-1" frame_id="-1" name="留学生"   text="『哦，美帆小姐的裸体，非常可爱又性感！』" voices=""/><msg @l="1199" char_id="-1" frame_id="-1" name="游泳部成员A" text="『……。』"   voices=""/><msg @l="1201" char_id="-1" frame_id="-1" name="游泳部成员B" text="『……。』"   voices=""/><msg @l="1203" char_id="-1" frame_id="-1" name="游泳部成员A"   text="『我、我再也忍不住了！』" voices=""/><msg @l="1205" char_id="-1" frame_id="-1" name="游泳部成员B"   text="『管他会怎样！』" voices=""/><stopbgm @l="1208" fadeout="1000"/><clear @l="1211" class="all"/><msgshow @l="1213" show="true"/><wait_chgmv/><ev @l="1216" src="ev-024_3"/><bgm @l="1219" src="bgm14" volume="1."/><msg @l="1221" char_id="0" frame_id="-1" name="美帆" text="『嗯……。』"   voices="miho04150"/><msg @l="1223" char_id="-1" frame_id="-1" name=""   text="男生们的手一齐缠绕在美帆的胸部和下体上。" voices=""/><msg @l="1224" char_id="-1" frame_id="-1" name=""   text="美帆的口中微微漏出一丝喘息，但是……似乎没有清醒的迹象。" voices=""/><msg @l="1226" char_id="-1" frame_id="-1" name="游泳部成员A"   text="『哇哦，胸部好软啊。』" voices=""/><msg @l="1228" char_id="-1" frame_id="-1" name="留学生" text="『小穴，小穴……。』"   voices=""/><msg @l="1230" char_id="-1" frame_id="-1" name="游泳部成员B"   text="『……感觉我有点落后了。』" voices=""/><msg @l="1232" char_id="-1" frame_id="-1" name="游泳部成员A"   text="『随便找个地方摸摸就行了。』" voices=""/><msg @l="1234" char_id="-1" frame_id="-1" name="游泳部成员B" text="『切……。』"   voices=""/><msg @l="1236" char_id="-1" frame_id="-1" name=""   text="就这样，三个人的手开始肆意玩弄美帆的身体。" voices=""/><msg @l="1237" char_id="-1" frame_id="-1" name=""   text="揉捏丰满的胸部，抚摸大腿，爱抚下面的缝隙。" voices=""/><msg @l="1240" char_id="-1" frame_id="-1" name="游泳部成员A"   text="『乳头好像变硬了？』" voices=""/><msg @l="1242" char_id="-1" frame_id="-1" name="游泳部成员A"   text="『即使失去意识，也会有感觉吗？』" voices=""/><msg @l="1244" char_id="-1" frame_id="-1" name="游泳部成员B"   text="『这不就像晨勃一样的东西吗？』" voices=""/><msg @l="1246" char_id="-1" frame_id="-1" name="游泳部成员A"   text="『哈哈，又硬又脆的感觉真有趣啊。』" voices=""/><msg @l="1248" char_id="-1" frame_id="-1" name="留学生" text="『阴蒂，阴蒂……。』"   voices=""/><msg @l="1250" char_id="-1" frame_id="-1" name=""   text="因为对方没有意识，自然也不会有任何抵抗，三人的恶作剧行为随着时间的推移逐渐升级，变得更加过激。"   voices=""/><msg @l="1251" char_id="-1" frame_id="-1" name=""   text="最初还小心翼翼触摸的胸部隆起，不知何时变成了肆无忌惮的揉搓，而用指尖拨弄的乳头则开始被嘴唇贴上吮吸。"   voices=""/><msg @l="1252" char_id="-1" frame_id="-1" name=""   text="留学生甚至用指尖掰开秘唇，窥视着胎内的样子。" voices=""/><msg @l="1253" char_id="-1" frame_id="-1" name=""   text="就这样他们玩弄了美帆的全身后，其中一名游泳部成员像是忍不住似的开口了。" voices=""/><msg @l="1255" char_id="-1" frame_id="-1" name="游泳部成员A"   text="『那、那个……我，可以让她握住我的鸡巴吗？』" voices=""/><msg @l="1257" char_id="-1" frame_id="-1" name="游泳部成员B" text="『啊，那个好啊。』"   voices=""/><msg @l="1259" char_id="-1" frame_id="-1" name="游泳部成员B"   text="『那我就让她含住我的鸡巴吧。』" voices=""/><msg @l="1261" char_id="-1" frame_id="-1" name=""   text="说着他们从泳裤中掏出已经勃起的那话儿，分别放到美帆的手中和嘴边。" voices=""/><wait_chgmv/><ev @l="1264" src="ev-024_4"/><msg @l="1266" char_id="0" frame_id="-1" name="美帆" text="『嗯啊……唔………。』"   voices="miho04160"/><msg @l="1268" char_id="-1" frame_id="-1" name=""   text="肉棒的前端撑开她的嘴唇，插入了美帆的口腔。" voices=""/><msg @l="1269" char_id="-1" frame_id="-1" name=""   text="大概是呼吸困难吧，美帆微微皱起眉头，漏出了一丝喘息。" voices=""/><msg @l="1271" char_id="-1" frame_id="-1" name="游泳部成员B"   text="『哦哦哦……嘴里，超级舒服啊。』" voices=""/><msg @l="1273" char_id="-1" frame_id="-1" name="游泳部成员A"   text="『这边也是，只是让她握着就完全不一样了啊。』" voices=""/><msg @l="1275" char_id="-1" frame_id="-1" name=""   text="在享用美帆的身体时，两名游泳部成员编织着欢愉的言语。" voices=""/><msg @l="1276" char_id="-1" frame_id="-1" name="" text="他们两人应该都是性经验不足。"   voices=""/><msg @l="1277" char_id="-1" frame_id="-1" name=""   text="他们顶在美帆身体上的那物已经胀得又大又硬，几乎要爆裂开来。" voices=""/><msg @l="1279" char_id="-1" frame_id="-1" name="留学生"   text="『哦……处女爱液，太美味了。』" voices=""/><msg @l="1281" char_id="-1" frame_id="-1" name=""   text="与那些持续失控的游泳部员相比，那位留学生却一直在执着地玩弄着美帆的秘部。" voices=""/><msg @l="1282" char_id="-1" frame_id="-1" name=""   text="沿着缝隙形状滑动着长舌……用指腹轻轻拨弄着微微露出的小突起。" voices=""/><msg @l="1283" char_id="-1" frame_id="-1" name=""   text="他细致地吮吸着从秘唇中溢出的蜜液，一滴不剩。" voices=""/><stopbgm @l="1286" fadeout="1000"/><clear @l="1289" class="all"/><end_scene @l="1292"/><wait_chgmv/><bg @l="1295" src="bg11"/><bgm @l="1298" src="bgm10" volume="1."/><char @l="1301" id="watab" pos="auto" src="watabe010"/><msg @l="1303" char_id="-1" frame_id="-1" name="渡部" text="『喔，在玩啊。』"   voices=""/><msg @l="1305" char_id="-1" frame_id="-1" name="游泳部成员A"   text="『呜哇……糟了，他回来了。』" voices=""/><msg @l="1307" char_id="-1" frame_id="-1" name="游泳部成员B"   text="『靠，我还没射呢……』" voices=""/><msg @l="1309" char_id="-1" frame_id="-1" name="留学生" text="『……已经，到极限了吗？』"   voices=""/><char @l="1312" id="watab" pos="auto" src="watabe012"/><msg @l="1314" char_id="-1" frame_id="-1" name="渡部"   text="『哦，你们忍不住开始自己撸了啊。』" voices=""/><msg @l="1316" char_id="-1" frame_id="-1" name=""   text="渡部看着被压在美帆手和嘴上的肉茎，不屑地笑了。" voices=""/><msg @l="1318" char_id="-1" frame_id="-1" name="游泳部成员A"   text="『但、但是……我们按约定没有插进去啊。』" voices=""/><char @l="1321" id="watab" pos="auto" src="watabe017"/><msg @l="1323" char_id="-1" frame_id="-1" name="渡部"   text="『那是当然的。这家伙的处女是我的东西。』" voices=""/><char @l="1326" id="watab" pos="auto" src="watabe014"/><msg @l="1328" char_id="-1" frame_id="-1" name="渡部"   text="『好了……剩下的交给我，你们回去吧。』" voices=""/><msg @l="1330" char_id="-1" frame_id="-1" name="游泳部成员B"   text="『啊……怎么这样，明明刚要开始的说。』" voices=""/><msg @l="1332" char_id="-1" frame_id="-1" name="渡部"   text="『别抱怨了……在这里乖乖听话的话，说不定有好处呢？』" voices=""/><msg @l="1334" char_id="-1" frame_id="-1" name="游泳部成员A" text="『这是，真的吗？』"   voices=""/><msg @l="1336" char_id="-1" frame_id="-1" name="游泳部成员B"   text="『那时候……能，能让我们做到最后吗？』" voices=""/><char @l="1339" id="watab" pos="auto" src="watabe010"/><msg @l="1341" char_id="-1" frame_id="-1" name="渡部" text="『嘛……如果进展顺利的话。』"   voices=""/><msg @l="1343" char_id="-1" frame_id="-1" name="渡部"   text="『你们应该明白，今天的事不能告诉任何人，知道吗？』" voices=""/><msg @l="1345" char_id="-1" frame_id="-1" name="游泳部成员A"   text="『我们不会说的……这种好事，怎么可能告诉其他人啊。』" voices=""/><msg @l="1347" char_id="-1" frame_id="-1" name="游泳部成员B"   text="『就是啊，绝对不会告诉任何人的。』" voices=""/><msg @l="1349" char_id="-1" frame_id="-1" name="渡部" text="『哦，这可是约定了。』"   voices=""/><msg @l="1351" char_id="-1" frame_id="-1" name="游泳部成员A" text="『明、明白了！』"   voices=""/><msg @l="1353" char_id="-1" frame_id="-1" name="游泳部成员B"   text="『那么……下次真的拜托你了啊。』" voices=""/><msg @l="1355" char_id="-1" frame_id="-1" name=""   text="于是两名游泳部的成员匆匆忙忙地离开了更衣室。" voices=""/><msg @l="1357" char_id="-1" frame_id="-1" name="留学生" text="『……。』"   voices=""/><char @l="1360" id="watab" pos="auto" src="watabe014"/><msg @l="1362" char_id="-1" frame_id="-1" name="渡部"   text="『怎么，你也赶紧回去如何？』" voices=""/><msg @l="1364" char_id="-1" frame_id="-1" name="留学生"   text="『我，对她，痴心一片。』" voices=""/><msg @l="1366" char_id="-1" frame_id="-1" name="留学生"   text="『我，想要，加入伙伴。』" voices=""/><char @l="1369" id="watab" pos="auto" src="watabe017"/><msg @l="1371" char_id="-1" frame_id="-1" name="渡部" text="『加入伙伴？』"   voices=""/><msg @l="1373" char_id="-1" frame_id="-1" name="留学生"   text="『你，和她，稳定关系。』" voices=""/><msg @l="1375" char_id="-1" frame_id="-1" name="留学生"   text="『我也，想和她，成为稳定关系呢。』" voices=""/><char @l="1378" id="watab" pos="auto" src="watabe014"/><msg @l="1380" char_id="-1" frame_id="-1" name="渡部"   text="『喂，他说这种话你怎么办……熊野小姐？』" voices=""/><msg @l="1382" char_id="-1" frame_id="-1" name="声音" text="『哎呀哎呀……』"   voices=""/><clear @l="1385" class="char"/><char @l="1387" id="watab" pos="left" src="watabe014"/><char @l="1389" id="kuma" pos="right" src="kuma010"/><msg @l="1391" char_id="-1" frame_id="-1" name="留学生"   text="『哦？熊野小姐，什么时候……』" voices=""/><msg @l="1393" char_id="-1" frame_id="-1" name=""   text="无声无息地，从渡部背后悄然出现的是大学的工友……熊野。" voices=""/><msg @l="1394" char_id="-1" frame_id="-1" name=""   text="她大概是躲在魁梧的渡部背后吧。" voices=""/><char @l="1397" id="watab" pos="left" src="watabe017"/><msg @l="1399" char_id="-1" frame_id="-1" name="渡部"   text="『如果太深入地插手，可能就抽不出来了哦？』" voices=""/><msg @l="1401" char_id="-1" frame_id="-1" name=""   text="渡部对一脸疑惑的留学生凑近脸来，摆出凶狠的表情威吓道。" voices=""/><msg @l="1402" char_id="-1" frame_id="-1" name=""   text="但是……他的凶狠表情似乎对留学生不起作用。" voices=""/><msg @l="1404" char_id="-1" frame_id="-1" name="熊野" text="『啊……他的话没关系的。』"   voices=""/><msg @l="1406" char_id="-1" frame_id="-1" name="熊野"   text="『虽然在初始阶段增加外部人员会提高信息泄露的可能性，这也很麻烦，但我们的计划也需要像他这样的性爱怪兽啊。』"   voices=""/><char @l="1409" id="watab" pos="left" src="watabe010"/><msg @l="1411" char_id="-1" frame_id="-1" name="渡部"   text="『什么啊，是你安排的啊……那早点说啊。』" voices=""/><msg @l="1413" char_id="-1" frame_id="-1" name="留学生" text="『哦，谢谢！』"   voices=""/><char @l="1416" id="watab" pos="left" src="watabe017"/><msg @l="1418" char_id="-1" frame_id="-1" name="渡部" text="『……。』" voices=""/><msg @l="1420" char_id="-1" frame_id="-1" name=""   text="渡部瞪着做出夸张动作表示喜悦的留学生，但当事人完全没注意到这个眼神。" voices=""/><char @l="1423" id="kuma" pos="right" src="kuma012"/><msg @l="1425" char_id="-1" frame_id="-1" name="熊野" text="『那么，开始吧。』"   voices=""/><msg @l="1427" char_id="-1" frame_id="-1" name=""   text="熊野笑起来时，嘴角挂着……一抹邪恶的微笑。" voices=""/><stopbgm @l="1430" fadeout="1000"/><clear @l="1433" class="all"/><label @l="1436" id="chart_line20"/><call @l="1439" target="EventLabel_82@root_akina_c_ev01"/><return @l="1440" value="0&#13;&#10;"/><label @l="1443" id="EventLabel_75"/><wait_chgmv/><bg @l="1446" src="bg11"/><bgm @l="1449" src="bgm02" volume="1."/><char @l="1452" id="miho" pos="auto" src="miho060"/><msg @l="1454" char_id="0" frame_id="-1" name="美帆" text="『……呼。』" voices=""/><clear @l="1457" class="char"/><char @l="1459" id="miho" pos="left" src="miho060"/><char @l="1461" id="akina" pos="right" src="akina010"/><msg @l="1463" char_id="2" frame_id="-1" name="亚季奈"   text="『怎么了，竟然叹气了。』" voices=""/><char @l="1466" id="akina" pos="right" src="akina011"/><msg @l="1468" char_id="2" frame_id="-1" name="亚季奈"   text="『啊，难道是……所谓的'胜利者的忧郁'？』" voices=""/><char @l="1471" id="akina" pos="right" src="akina010"/><msg @l="1473" char_id="2" frame_id="-1" name="亚季奈"   text="『刚才姐姐你可是拼命了呢。』" voices=""/><char @l="1476" id="miho" pos="left" src="miho066"/><msg @l="1478" char_id="0" frame_id="-1" name="美帆" text="『真是的，才不是那样……。』"   voices=""/><char @l="1481" id="miho" pos="left" src="miho060"/><msg @l="1483" char_id="0" frame_id="-1" name="美帆" text="『只是有点累了而已。』"   voices=""/><msg @l="1485" char_id="2" frame_id="-1" name="亚季奈"   text="『感觉是好久没有全力游泳了？』" voices=""/><char @l="1488" id="miho" pos="left" src="miho066"/><msg @l="1490" char_id="0" frame_id="-1" name="美帆"   text="『嗯……又不是每天都在练习，突然游100米这种距离可不行啊。』" voices=""/><msg @l="1492" char_id="0" frame_id="-1" name="美帆"   text="『真是的，全身都软绵绵的了。』" voices=""/><char @l="1495" id="akina" pos="right" src="akina011"/><msg @l="1497" char_id="2" frame_id="-1" name="亚季奈"   text="『啊哈哈哈，是不是运动不足啊？』" voices=""/><char @l="1500" id="miho" pos="left" src="miho160"/><msg @l="1502" char_id="0" frame_id="-1" name="美帆" text="『可能是吧。』" voices=""/><char @l="1505" id="akina" pos="right" src="akina010"/><msg @l="1507" char_id="2" frame_id="-1" name="亚季奈"   text="『姐姐，你洗过澡了吗？』" voices=""/><char @l="1510" id="miho" pos="left" src="miho060"/><msg @l="1512" char_id="0" frame_id="-1" name="美帆"   text="『嗯。只剩下换衣服了……你在外面等我一下？』" voices=""/><char @l="1515" id="akina" pos="right" src="akina111"/><msg @l="1517" char_id="2" frame_id="-1" name="亚季奈" text="『遵命～。』"   voices=""/><clear @l="1520" layer="akina"/><msg @l="1522" char_id="-1" frame_id="-1" name=""   text="亚季奈轻快地应了一声，走出了更衣室。" voices=""/><msg @l="1523" char_id="-1" frame_id="-1" name=""   text="看她始终笑容满面的样子，大概是对我在游泳比赛中获胜感到特别高兴吧。" voices=""/><msg @l="1525" char_id="0" frame_id="-1" name="美帆"   text="『游泳……要不要再次开始练习呢……。』" voices=""/><msg @l="1527" char_id="-1" frame_id="-1" name="声音"   text="『这是个好主意，我非常希望你能那样做。』" voices=""/><stopbgm @l="1530" fadeout="1000"/><char @l="1533" id="miho" pos="left" src="miho064"/><msg @l="1535" char_id="0" frame_id="-1" name="美帆" text="『诶……。』" voices=""/><msg @l="1537" char_id="-1" frame_id="-1" name="" text="我被突如其来的声音吓了一跳，转身朝声音传来的方向看去。"   voices=""/><char @l="1540" id="watab" pos="right" src="watabe010"/><bgm @l="1543" src="bgm10" volume="1."/><msg @l="1545" char_id="-1" frame_id="-1" name=""   text="不知何时渡部老师已经站在了更衣室的入口处。" voices=""/><msg @l="1546" char_id="-1" frame_id="-1" name=""   text="他大概是用社团保管的备用钥匙进来的吧。" voices=""/><msg @l="1548" char_id="-1" frame_id="-1" name="渡部"   text="『三年的空白期确实很长……虽然比不上现役选手，但作为教练的话应该还是绰绰有余的。』"   voices=""/><msg @l="1550" char_id="-1" frame_id="-1" name="渡部"   text="『说实话，对我来说那样反而更好。』" voices=""/><char @l="1553" id="miho" pos="left" src="miho165"/><msg @l="1555" char_id="0" frame_id="-1" name="美帆" text="『您啊……真是个不长记性的人。』"   voices=""/><msg @l="1557" char_id="-1" frame_id="-1" name="渡部"   text="『对，我希望你不要露出那么明显厌恶的表情。』" voices=""/><msg @l="1559" char_id="0" frame_id="-1" name="美帆"   text="『这里应该是女更衣室吧？』" voices=""/><char @l="1562" id="watab" pos="right" src="watabe012"/><msg @l="1564" char_id="-1" frame_id="-1" name="渡部" text="『你以为我会在意这个？』"   voices=""/><char @l="1567" id="miho" pos="left" src="miho065"/><msg @l="1569" char_id="0" frame_id="-1" name="美帆" text="『是我，在意这个。』"   voices=""/><char @l="1572" id="watab" pos="right" src="watabe010"/><msg @l="1574" char_id="-1" frame_id="-1" name="渡部"   text="『那你不妨像之前那样大声叫喊试试。』" voices=""/><msg @l="1576" char_id="-1" frame_id="-1" name="渡部"   text="『你让妹妹在下面出口处等你吧？她会担心你然后跑上来的吧？』" voices=""/><msg @l="1578" char_id="-1" frame_id="-1" name="" text="说着渡部露出了奸笑。"   voices=""/><msg @l="1579" char_id="-1" frame_id="-1" name=""   text="这个人十分清楚亚季奈是我的软肋。" voices=""/><char @l="1582" id="miho" pos="left" src="miho165"/><msg @l="1584" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><char @l="1587" id="watab" pos="right" src="watabe012"/><msg @l="1589" char_id="-1" frame_id="-1" name="渡部"   text="『不过，在外面有人的情况下如果你真敢大喊大叫，就算是我也不得不采取一些粗暴的手段了……』" voices=""/><char @l="1592" id="watab" pos="right" src="watabe014"/><msg @l="1594" char_id="-1" frame_id="-1" name="渡部"   text="『比如说……强行让跑上来的妹妹闭嘴，之类的？』" voices=""/><msg @l="1596" char_id="0" frame_id="-1" name="美帆" text="『……这是威胁吗？』"   voices=""/><msg @l="1598" char_id="-1" frame_id="-1" name="渡部" text="『你爱怎么理解都行。』"   voices=""/><msg @l="1600" char_id="0" frame_id="-1" name="美帆" text="『…………。』"   voices=""/><char @l="1603" id="watab" pos="right" src="watabe010"/><msg @l="1605" char_id="-1" frame_id="-1" name="渡部"   text="『嘛……今天我是想和你进行一次所谓的和平谈话。』" voices=""/><char @l="1608" id="miho" pos="left" src="miho065"/><msg @l="1610" char_id="0" frame_id="-1" name="美帆" text="『和平谈话……吗？』"   voices=""/><msg @l="1612" char_id="0" frame_id="-1" name="美帆"   text="『至少，我认为在有人正在换衣服的更衣室里进行这种谈话是不恰当的。』" voices=""/><msg @l="1614" char_id="-1" frame_id="-1" name="渡部"   text="『别这么说嘛……如果不利用这种机会，我们根本没法两个人单独好好谈谈。』" voices=""/><msg @l="1616" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="1618" char_id="0" frame_id="-1" name="美帆"   text="『……那么……您想跟我谈什么呢？』" voices=""/><msg @l="1620" char_id="-1" frame_id="-1" name="渡部"   text="『看了今天的游泳比赛……我无论如何都想要得到你。』" voices=""/><msg @l="1622" char_id="-1" frame_id="-1" name="渡部"   text="『怎么样，要不要来做我们专属的教练？』" voices=""/><msg @l="1624" char_id="-1" frame_id="-1" name="渡部"   text="『当然不会让你白干，钱的话我可以给你相应的报酬。』" voices=""/><char @l="1627" id="miho" pos="left" src="miho164"/><msg @l="1629" char_id="0" frame_id="-1" name="美帆" text="『什…！别开玩笑了！』"   voices=""/><msg @l="1631" char_id="0" frame_id="-1" name="美帆"   text="『你觉得我会乖乖接受这种提议吗？』" voices=""/><msg @l="1633" char_id="-1" frame_id="-1" name="渡部" text="『你不接受吗？』"   voices=""/><msg @l="1635" char_id="0" frame_id="-1" name="美帆"   text="『当然不接受……请你想想自己到现在为止都做了什么！』" voices=""/><msg @l="1637" char_id="-1" frame_id="-1" name="渡部"   text="『那就没办法了。这个提议我不找你，改去找你妹妹吧。』" voices=""/><msg @l="1639" char_id="0" frame_id="-1" name="美帆" text="『啊……』" voices=""/><msg @l="1641" char_id="-1" frame_id="-1" name="渡部"   text="『正好是她需要选择升学还是就业的时期啊。只要给出点好条件，她肯定会点头答应的。』" voices=""/><msg @l="1643" char_id="0" frame_id="-1" name="美帆"   text="『等，等一下……她还是在校生啊？』" voices=""/><msg @l="1645" char_id="0" frame_id="-1" name="美帆"   text="『把她变成教练，她自己的意愿怎么办？』" voices=""/><msg @l="1647" char_id="-1" frame_id="-1" name="渡部"   text="『她的意愿？那种东西无关紧要。』" voices=""/><char @l="1650" id="watab" pos="right" src="watabe017"/><msg @l="1652" char_id="-1" frame_id="-1" name="渡部"   text="『我想要的是能作为我手足工作的忠实游泳教练，而不是选手。』" voices=""/><char @l="1655" id="miho" pos="left" src="miho164"/><msg @l="1657" char_id="0" frame_id="-1" name="美帆"   text="『这种事……亚季奈也不可能接受的！』" voices=""/><char @l="1660" id="watab" pos="right" src="watabe010"/><msg @l="1662" char_id="-1" frame_id="-1" name="渡部" text="『哎呀，这种事很简单。』"   voices=""/><msg @l="1664" char_id="-1" frame_id="-1" name="渡部"   text="『她好像爱上我了，只要好好利用这点，就能轻松搞定。』" voices=""/><char @l="1667" id="miho" pos="left" src="miho064"/><msg @l="1669" char_id="0" frame_id="-1" name="美帆" text="『亚季奈对你……？』"   voices=""/><msg @l="1671" char_id="-1" frame_id="-1" name=""   text="确实，亚季奈看起来好像无条件地信任这个人。" voices=""/><msg @l="1672" char_id="-1" frame_id="-1" name=""   text="但是，我一直以为那只是对部活顾问的尊敬罢了……" voices=""/><char @l="1675" id="miho" pos="left" src="miho165"/><msg @l="1677" char_id="0" frame_id="-1" name="美帆"   text="『难以置信……那孩子，亚季奈居然会喜欢上您这样的人。』" voices=""/><msg @l="1679" char_id="-1" frame_id="-1" name="渡部"   text="『喂喂，那不是等于在说你自己妹妹的坏话吗？』" voices=""/><char @l="1682" id="miho" pos="left" src="miho164"/><msg @l="1684" char_id="0" frame_id="-1" name="美帆" text="『请不要抓我话柄！』"   voices=""/><msg @l="1686" char_id="-1" frame_id="-1" name="渡部"   text="『而且，我这边对那家伙根本没什么特别的想法。』" voices=""/><msg @l="1688" char_id="-1" frame_id="-1" name="渡部"   text="『我想要作为专属教练迎接的……是你啊？』" voices=""/><char @l="1691" id="miho" pos="left" src="miho065"/><msg @l="1693" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="1695" char_id="-1" frame_id="-1" name="渡部"   text="『如果你在这里接受的话，我就不必勉强拉你妹妹进来了。』" voices=""/><msg @l="1697" char_id="-1" frame_id="-1" name="渡部" text="『怎么样……不是个坏提议吧？』"   voices=""/><msg @l="1699" char_id="-1" frame_id="-1" name=""   text="渡部说着，嘴角扭曲成一抹奸笑。" voices=""/><msg @l="1701" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><char @l="1704" id="miho" pos="left" src="miho165"/><msg @l="1706" char_id="0" frame_id="-1" name="美帆" text="『能问一个问题吗？』"   voices=""/><msg @l="1708" char_id="-1" frame_id="-1" name="渡部" text="『什么事？』" voices=""/><msg @l="1710" char_id="0" frame_id="-1" name="美帆"   text="『让我成为专属教练……您打算做什么？』" voices=""/><msg @l="1712" char_id="-1" frame_id="-1" name="渡部"   text="『这还用说吗？就是让你指导部员们。』" voices=""/><msg @l="1714" char_id="0" frame_id="-1" name="美帆" text="『真的只是这样吗？』"   voices=""/><msg @l="1716" char_id="0" frame_id="-1" name="美帆"   text="『您不会再像三年前或前几天练习时那样做事吧？』" voices=""/><char @l="1719" id="watab" pos="right" src="watabe017"/><msg @l="1721" char_id="-1" frame_id="-1" name="渡部" text="『如果是那样又怎么样？』"   voices=""/><char @l="1724" id="miho" pos="left" src="miho164"/><msg @l="1726" char_id="0" frame_id="-1" name="美帆" text="『……！？』" voices=""/><msg @l="1728" char_id="-1" frame_id="-1" name="渡部"   text="『如果你不接受这个提议，我就去找你妹妹。你没有余裕去计较内容细节吧？』" voices=""/><msg @l="1730" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><char @l="1733" id="watab" pos="right" src="watabe010"/><msg @l="1735" char_id="-1" frame_id="-1" name="渡部"   text="『我再说一遍，这对我来说并不是什么坏事。』" voices=""/><char @l="1738" id="miho" pos="left" src="miho165"/><msg @l="1740" char_id="0" frame_id="-1" name="美帆" text="『请出去……』"   voices=""/><char @l="1743" id="watab" pos="right" src="watabe014"/><msg @l="1745" char_id="-1" frame_id="-1" name="渡部" text="『啊？』" voices=""/><char @l="1748" id="miho" pos="left" src="miho065"/><msg @l="1750" char_id="0" frame_id="-1" name="美帆"   text="『请您现在立刻离开这里。』" voices=""/><msg @l="1752" char_id="-1" frame_id="-1" name="渡部"   text="『哦，打算把一切都推给妹妹吗？』" voices=""/><char @l="1755" id="miho" pos="left" src="miho166"/><msg @l="1757" char_id="0" frame_id="-1" name="美帆"   text="『不是的……我相信那孩子。』" voices=""/><msg @l="1759" char_id="0" frame_id="-1" name="美帆"   text="『我相信她不会选择错误的道路。』" voices=""/><msg @l="1761" char_id="-1" frame_id="-1" name="渡部" text="『哼……谈判失败了啊。』"   voices=""/><msg @l="1763" char_id="-1" frame_id="-1" name="渡部" text="『你就好好后悔吧。』"   voices=""/><stopbgm @l="1766" fadeout="1000"/><clear @l="1769" class="char"/><char @l="1771" id="miho" pos="auto" src="miho166"/><bgm @l="1774" src="bgm03" volume="1."/><msg @l="1776" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><clear @l="1779" class="char"/><msg @l="1781" char_id="-1" frame_id="-1" name=""   text="留下这句像是临别嘲讽的话后，渡部离开了更衣室。" voices=""/><msg @l="1782" char_id="-1" frame_id="-1" name=""   text="看着渡部老师离去的背影……我轻轻咬住了嘴唇。" voices=""/><stopbgm @l="1785" fadeout="1000"/><clear @l="1788" class="all"/><wait_chgmv/><bg @l="1791" src="bg07b"/><bgm @l="1794" src="bgm05" volume="1."/><char @l="1797" id="miho" pos="left" src="miho010"/><msg @l="1799" char_id="0" frame_id="-1" name="美帆" text="『……让你久等了。』"   voices=""/><char @l="1802" id="akina" pos="right" src="akina017"/><msg @l="1804" char_id="2" frame_id="-1" name="亚季奈" text="『姐姐，你太慢啦！』"   voices=""/><msg @l="1806" char_id="-1" frame_id="-1" name=""   text="在体育馆出口处，我与亚季奈会合了。" voices=""/><msg @l="1807" char_id="-1" frame_id="-1" name=""   text="我曾担心她可能被先走的渡部老师骗走，不在这里了……但看到她在这里等着，真是太好了。"   voices=""/><char @l="1810" id="miho" pos="left" src="miho016"/><msg @l="1812" char_id="0" frame_id="-1" name="美帆"   text="『对不起……我刚才和渡部老师聊了一会儿……。』" voices=""/><char @l="1815" id="akina" pos="right" src="akina110"/><msg @l="1817" char_id="2" frame_id="-1" name="亚季奈"   text="『啊，说起来刚才老师出去了呢……。』" voices=""/><char @l="1820" id="miho" pos="left" src="miho014"/><msg @l="1822" char_id="0" frame_id="-1" name="美帆" text="『诶……他对你说什么了吗？』"   voices=""/><msg @l="1824" char_id="2" frame_id="-1" name="亚季奈" text="『嗯，没有啊？』"   voices=""/><char @l="1827" id="miho" pos="left" src="miho110"/><msg @l="1829" char_id="0" frame_id="-1" name="美帆" text="『是吗……那，就好……。』"   voices=""/><msg @l="1831" char_id="0" frame_id="-1" name="美帆"   text="（那果然是为了威胁我而撒的谎吗……？）" voices=""/><msg @l="1833" char_id="0" frame_id="-1" name="美帆"   text="（但是，为什么他会那么简单就放弃了……）" voices=""/><char @l="1836" id="akina" pos="right" src="akina010"/><msg @l="1838" char_id="2" frame_id="-1" name="亚季奈" text="『姐姐？』"   voices=""/><char @l="1841" id="miho" pos="left" src="miho016"/><msg @l="1843" char_id="0" frame_id="-1" name="美帆"   text="『啊，啊……没，没什么。』" voices=""/><msg @l="1845" char_id="2" frame_id="-1" name="亚季奈" text="『……？』" voices=""/><clear @l="1848" class="all"/><wait_chgmv/><bg @l="1851" src="bg07b"/><char @l="1854" id="miho" pos="left" src="miho010"/><char @l="1857" id="akina" pos="right" src="akina010"/><msg @l="1859" char_id="2" frame_id="-1" name="亚季奈" text="『那么，我要走这边了。』"   voices=""/><msg @l="1861" char_id="0" frame_id="-1" name="美帆" text="『嗯……。』" voices=""/><msg @l="1863" char_id="2" frame_id="-1" name="亚季奈"   text="『姐姐，你看起来有点沮丧？』" voices=""/><char @l="1866" id="miho" pos="left" src="miho116"/><msg @l="1868" char_id="0" frame_id="-1" name="美帆"   text="『啊……不、并不是那样的……没事的。』" voices=""/><msg @l="1870" char_id="0" frame_id="-1" name="美帆"   text="（果然，还是应该跟亚季奈好好说清楚，让她拒绝他吧……）" voices=""/><msg @l="1872" char_id="0" frame_id="-1" name="美帆"   text="（可是……突然那样说也很奇怪吧……）" voices=""/><char @l="1875" id="akina" pos="right" src="akina117"/><msg @l="1877" char_id="2" frame_id="-1" name="亚季奈"   text="『姐姐，你果然有点不对劲吧？』" voices=""/><char @l="1880" id="miho" pos="left" src="miho016"/><msg @l="1882" char_id="0" frame_id="-1" name="美帆"   text="『是、是吗……我觉得只是有点累了。』" voices=""/><msg @l="1884" char_id="2" frame_id="-1" name="亚季奈" text="『嗯？』" voices=""/><char @l="1887" id="akina" pos="right" src="akina011"/><msg @l="1889" char_id="2" frame_id="-1" name="亚季奈"   text="『那么，我差不多要回宿舍了。』" voices=""/><clear @l="1892" layer="akina"/><char @l="1895" id="miho" pos="left" src="miho014"/><msg @l="1897" char_id="0" frame_id="-1" name="美帆" text="『啊，等等！』" voices=""/><char @l="1900" id="akina" pos="right" src="akina010"/><msg @l="1902" char_id="2" frame_id="-1" name="亚季奈" text="『怎么了？』" voices=""/><char @l="1905" id="miho" pos="left" src="miho016"/><msg @l="1907" char_id="0" frame_id="-1" name="美帆" text="『呃……啊，那个……。』"   voices=""/><msg @l="1909" char_id="-1" frame_id="-1" name=""   text="虽然情不自禁地挽留了她，但真要说的时候，又不知道该怎么开口。" voices=""/><msg @l="1911" char_id="0" frame_id="-1" name="美帆"   text="『对不起……算了没什么……。』" voices=""/><char @l="1914" id="akina" pos="right" src="akina014"/><msg @l="1916" char_id="2" frame_id="-1" name="亚季奈"   text="『什么啊，你果然在烦恼什么事吧？』" voices=""/><msg @l="1918" char_id="0" frame_id="-1" name="美帆"   text="『呃，不不……别在意，真的没什么。』" voices=""/><char @l="1921" id="akina" pos="right" src="akina010"/><msg @l="1923" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯，既然姐姐都这么说了，那我就不多问了……。』" voices=""/><msg @l="1925" char_id="2" frame_id="-1" name="亚季奈" text="『那么，我回宿舍去了哦？』"   voices=""/><msg @l="1927" char_id="0" frame_id="-1" name="美帆"   text="『啊，嗯……突然挽留你真是对不起。』" voices=""/><char @l="1930" id="akina" pos="right" src="akina111"/><msg @l="1932" char_id="2" frame_id="-1" name="亚季奈" text="『那么，明天见。』"   voices=""/><clear @l="1935" layer="akina"/><msg @l="1937" char_id="-1" frame_id="-1" name=""   text="亚季奈说完便朝宿舍方向跑去。" voices=""/><char @l="1940" id="miho" pos="left" src="miho116"/><msg @l="1942" char_id="0" frame_id="-1" name="美帆" text="『………。』" voices=""/><msg @l="1944" char_id="0" frame_id="-1" name="美帆" text="(如果我不相信……不行，对吧)"   voices=""/><stopbgm @l="1947" fadeout="1000"/><clear @l="1950" class="all"/><wait_chgmv/><bg @l="1953" src="bg01b"/><bgm @l="1956" src="bgm03" volume="1."/><msg @l="1958" char_id="0" frame_id="-1" name="美帆" text="『……哈。』" voices=""/><msg @l="1960" char_id="-1" frame_id="-1" name=""   text="我躺在房间的床上，轻轻地叹了口气。" voices=""/><msg @l="1961" char_id="-1" frame_id="-1" name=""   text="无论做什么，脑海中浮现的都只有亚季奈的事……。" voices=""/><msg @l="1962" char_id="-1" frame_id="-1" name=""   text="一方面我作为姐姐应该相信亚季奈才对，另一方面却又忍不住担心那孩子。" voices=""/><msg @l="1963" char_id="-1" frame_id="-1" name=""   text="这一切……都是因为渡部老师留下的最后那句话。" voices=""/><msg @l="1965" char_id="0" frame_id="-1" name="美帆" text="『好好后悔去吧……吗。』"   voices=""/><msg @l="1967" char_id="-1" frame_id="-1" name=""   text="如果那只是为了威胁而撒的谎，就没什么好烦恼的了。" voices=""/><msg @l="1968" char_id="-1" frame_id="-1" name="" text="只是……我不能完全认为那是谎言。"   voices=""/><msg @l="1969" char_id="-1" frame_id="-1" name="" text="毕竟对方可是那个渡部老师啊……。"   voices=""/><msg @l="1970" char_id="-1" frame_id="-1" name=""   text="认为他在策划什么……这样想会比较好吧？" voices=""/><msg @l="1972" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="1974" char_id="0" frame_id="-1" name="美帆"   text="(果然，至少应该传达些什么)" voices=""/><msg @l="1976" char_id="0" frame_id="-1" name="美帆"   text="(相信她和什么都不做……是不一样的啊！)" voices=""/><msg @l="1978" char_id="-1" frame_id="-1" name="" text="我看了看房间里的时钟。"   voices=""/><msg @l="1979" char_id="-1" frame_id="-1" name="" text="已经远远过了十点。"   voices=""/><msg @l="1981" char_id="0" frame_id="-1" name="美帆"   text="(电车已经没有了……如果是出租车的话，在车站前能拦到吗)" voices=""/><msg @l="1983" char_id="0" frame_id="-1" name="美帆"   text="(或者……给宿舍打个电话，说上一句话)" voices=""/><msg @l="1985" char_id="0" frame_id="-1" name="美帆" text="(怎么办……)"   voices=""/><msg @l="1989" async="true" char_id="-1" frame_id="-1" name=""   text="该怎么联系亚季奈……？" voices=""/><select @l="1990"><menu @l="1994" label="EventLabel_76" text="打电话到宿舍"/><menu @l="1997" label="EventLabel_77" text="亲自前往谈话"/></select><label @l="2006" id="EventLabel_76"/><char @l="2009" id="miho" pos="auto" src="miho130"/><msg @l="2011" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="2013" char_id="-1" frame_id="-1" name=""   text="我突然从床上站起来，向放在桌上充电器上的手机伸出了手。" voices=""/><msg @l="2014" char_id="-1" frame_id="-1" name=""   text="微凉的触感异常真实，让我不由得有些畏缩。" voices=""/><se @l="2017" buf="3" loop="true" src="発信音" volume="1."/><msg @l="2019" char_id="-1" frame_id="-1" name=""   text="从通讯录里找到亚季奈的手机号码，拨了过去。" voices=""/><msg @l="2021" char_id="-1" frame_id="-1" name="" text="嘟嘟嘟嘟……嘟嘟嘟嘟……"   voices=""/><char @l="2024" id="miho" pos="auto" src="miho034"/><msg @l="2026" char_id="0" frame_id="-1" name="美帆" text="(……明明在响铃却不接……)"   voices=""/><msg @l="2028" char_id="-1" frame_id="-1" name=""   text="能够响铃就说明，她既没有关机也不是信号不好的问题。" voices=""/><msg @l="2029" char_id="-1" frame_id="-1" name=""   text="这么说的话，她已经睡了吗……？" voices=""/><msg @l="2030" char_id="-1" frame_id="-1" name=""   text="不对……虽说是运动系的合宿，但十点就睡觉也太早了。" voices=""/><stopse @l="2033" buf="3"/><se @l="2036" buf="1" src="携帯ボタン押下音" volume="1."/><char @l="2039" id="miho" pos="auto" src="miho136"/><msg @l="2041" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="2043" char_id="0" frame_id="-1" name="美帆"   text="（怎么回事……是手机调成了静音模式没注意到吗？）" voices=""/><msg @l="2045" char_id="-1" frame_id="-1" name=""   text="如果亚季奈注意到有来电然后联系我就好了，否则无论打多少次电话结果都一样。" voices=""/><char @l="2048" id="miho" pos="auto" src="miho134"/><msg @l="2050" char_id="0" frame_id="-1" name="美帆"   text="『啊……对了，我好像问过宿舍的电话号码。』" voices=""/><msg @l="2052" char_id="-1" frame_id="-1" name=""   text="当初亚季奈请我当合宿教练的时候，为了应对手机联系不上的情况，我向她问了宿舍固定电话的号码。"   voices=""/><msg @l="2053" char_id="-1" frame_id="-1" name=""   text="没想到会在这种情况下派上用场。" voices=""/><char @l="2056" id="miho" pos="auto" src="miho130"/><se @l="2059" buf="3" loop="true" src="発信音" volume="1."/><msg @l="2061" char_id="-1" frame_id="-1" name="" text="一声，两声，三声……"   voices=""/><msg @l="2062" char_id="-1" frame_id="-1" name=""   text="每当听到铃声持续响起，一种奇怪的不安便袭上心头。" voices=""/><msg @l="2063" char_id="-1" frame_id="-1" name="" text="我不禁开始……胡思乱想。"   voices=""/><stopse @l="2066" buf="3"/><msg @l="2068" char_id="-1" frame_id="-1" name="声音"   text="『让您久等了。我是负责学校内设施管理的熊野。』" voices=""/><char @l="2071" id="miho" pos="auto" src="miho134"/><msg @l="2073" char_id="0" frame_id="-1" name="美帆"   text="『那个……我是仲根……。』" voices=""/><msg @l="2075" char_id="0" frame_id="-1" name="美帆"   text="『能帮我接通来参加合宿的妹妹，游泳部的仲根亚季奈吗？』" voices=""/><msg @l="2077" char_id="-1" frame_id="-1" name="熊野"   text="『是仲根小姐吧……请稍等。』" voices=""/><char @l="2080" id="miho" pos="auto" src="miho136"/><se @l="2083" buf="3" loop="true" src="保留音" volume="1."/><msg @l="2085" char_id="-1" frame_id="-1" name="" text="电话那头传来了等待音乐。"   voices=""/><msg @l="2086" char_id="-1" frame_id="-1" name=""   text="即使是那在某处听过的平缓曲调，也无法让焦急的我平静下来。" voices=""/><msg @l="2087" char_id="-1" frame_id="-1" name="" text="…………。" voices=""/><msg @l="2088" char_id="-1" frame_id="-1" name="" text="……………………。"   voices=""/><msg @l="2089" char_id="-1" frame_id="-1" name="" text="…………………………。"   voices=""/><msg @l="2090" char_id="-1" frame_id="-1" name=""   text="……………………………………。" voices=""/><msg @l="2091" char_id="-1" frame_id="-1" name="" text="不知等了有多久。"   voices=""/><msg @l="2092" char_id="-1" frame_id="-1" name="" text="说起来可能就几分钟……。"   voices=""/><msg @l="2093" char_id="-1" frame_id="-1" name="" text="不，或许连一分钟都不到。"   voices=""/><msg @l="2094" char_id="-1" frame_id="-1" name=""   text="就这样，当不安达到顶点的那一刻……。" voices=""/><stopse @l="2097" buf="3"/><msg @l="2099" char_id="-1" frame_id="-1" name="熊野" text="『抱歉，让您久等了。』"   voices=""/><char @l="2102" id="miho" pos="auto" src="miho134"/><msg @l="2104" char_id="0" frame_id="-1" name="美帆" text="『那个……亚季奈呢？』"   voices=""/><msg @l="2106" char_id="-1" frame_id="-1" name="熊野"   text="『是这样的，参加合宿的人们都已经休息了。』" voices=""/><msg @l="2108" char_id="-1" frame_id="-1" name="熊野"   text="『因为明天一大早就要起床，顾问老师嘱咐过不要去打扰她们……。』" voices=""/><char @l="2111" id="miho" pos="auto" src="miho136"/><msg @l="2113" char_id="0" frame_id="-1" name="美帆" text="『是这样啊……。』"   voices=""/><msg @l="2115" char_id="-1" frame_id="-1" name="熊野" text="『实在抱歉。』"   voices=""/><msg @l="2117" char_id="0" frame_id="-1" name="美帆"   text="『不，不，是我突然过来，实在抱歉。』" voices=""/><msg @l="2119" char_id="-1" frame_id="-1" name="熊野" text="『没关系，那么。』"   voices=""/><se @l="2122" buf="1" src="携帯ボタン押下音" volume="1."/><msg @l="2124" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="2126" char_id="0" frame_id="-1" name="美帆" text="（原来如此……是睡着了啊）"   voices=""/><msg @l="2128" char_id="0" frame_id="-1" name="美帆"   text="（看来明天只能直接见面说了……）" voices=""/><goto @l="2131" label="EventLabel_78"/><label @l="2135" id="EventLabel_77"/><char @l="2138" id="miho" pos="auto" src="miho130"/><msg @l="2140" char_id="0" frame_id="-1" name="美帆" text="『……嗯，走吧。』"   voices=""/><msg @l="2142" char_id="0" frame_id="-1" name="美帆"   text="『这样烦恼下去也没用呢。』" voices=""/><msg @l="2144" char_id="-1" frame_id="-1" name=""   text="与其什么都不做只是思考，不如行动起来会让人感到不那么焦虑。" voices=""/><clear @l="2147" class="all"/><wait_chgmv/><bg @l="2150" src="bg03b"/><char @l="2153" id="miho" pos="auto" src="miho010"/><msg @l="2155" char_id="0" frame_id="-1" name="美帆"   text="『那个……我，要出去一下。』" voices=""/><clear @l="2158" class="char"/><char @l="2160" id="miho" pos="left" src="miho010"/><char @l="2162" id="rei" pos="right" src="rei034"/><msg @l="2164" char_id="1" frame_id="-1" name="玲" text="『啊，现在吗？』" voices=""/><msg @l="2166" char_id="0" frame_id="-1" name="美帆"   text="『嗯。我想一两个小时后就会回来。』" voices=""/><char @l="2169" id="rei" pos="right" src="rei033"/><msg @l="2171" char_id="1" frame_id="-1" name="玲" text="『啊，难道是深夜幽会？』"   voices=""/><char @l="2174" id="miho" pos="left" src="miho016"/><msg @l="2176" char_id="0" frame_id="-1" name="美帆" text="『……不是。』"   voices=""/><char @l="2179" id="rei" pos="right" src="rei030"/><msg @l="2181" char_id="1" frame_id="-1" name="玲"   text="『哎呀真遗憾……嘛，路上小心。』" voices=""/><msg @l="2183" char_id="1" frame_id="-1" name="玲" text="『深夜一个人走路很危险的啊。』"   voices=""/><msg @l="2185" char_id="0" frame_id="-1" name="美帆" text="『嗯……』" voices=""/><clear @l="2188" class="all"/><wait_chgmv/><bg @l="2193" src="bg07b"/><char @l="2196" id="miho" pos="auto" src="miho116"/><msg @l="2198" char_id="0" frame_id="-1" name="美帆" text="『………』" voices=""/><msg @l="2200" char_id="-1" frame_id="-1" name="" text="深夜的校园没有人气，显得十分寂寞。"   voices=""/><msg @l="2201" char_id="-1" frame_id="-1" name=""   text="从正门前的公交站开始，我一直沉默地走着。" voices=""/><msg @l="2202" char_id="-1" frame_id="-1" name=""   text="从正门步行到游泳部成员使用的宿舍大约需要十分钟左右。" voices=""/><msg @l="2203" char_id="-1" frame_id="-1" name=""   text="这段距离不近也不远，反而让人感到焦躁不安。" voices=""/><msg @l="2205" char_id="0" frame_id="-1" name="美帆" text="(亚季奈……)" voices=""/><clear @l="2208" class="all"/><msg @l="2210" char_id="-1" frame_id="-1" name="" text="看到了一栋像是目的地的建筑。"   voices=""/><msg @l="2211" char_id="-1" frame_id="-1" name=""   text="正如之前所说是旧民宿一样，它有着古旧而典型的外观。" voices=""/><se @l="2214" buf="1" src="扉を開ける音_引き戸" volume="1."/><msg @l="2216" char_id="0" frame_id="-1" name="美帆" text="『………。』" voices=""/><msg @l="2218" char_id="0" frame_id="-1" name="美帆" text="『打、打扰了——。』"   voices=""/><wait_chgmv/><bg @l="2221" src="bg20b"/><char @l="2224" id="miho" pos="auto" src="miho110"/><msg @l="2226" char_id="-1" frame_id="-1" name="" text="进入里面来到走廊。"   voices=""/><msg @l="2227" char_id="-1" frame_id="-1" name=""   text="虽然在入口处喊了几次，但没有反应，而且门锁开着，所以就进来了。" voices=""/><msg @l="2229" char_id="0" frame_id="-1" name="美帆"   text="(总之，虽然是到了宿舍……)" voices=""/><msg @l="2231" char_id="0" frame_id="-1" name="美帆"   text="(擅自进来被发现的话，会不会被骂呢……？)" voices=""/><msg @l="2233" char_id="-1" frame_id="-1" name=""   text="虽然不能说是鸣虫地板……但老化的木质走廊每走一步都会发出吱吱嘎嘎的奇怪声音。"   voices=""/><msg @l="2234" char_id="-1" frame_id="-1" name=""   text="走廊上排列的房间里没有亮灯。" voices=""/><msg @l="2235" char_id="-1" frame_id="-1" name=""   text="想用手表确认时间，但因为看不清楚就放弃了。" voices=""/><msg @l="2237" char_id="0" frame_id="-1" name="美帆" text="(亚季奈……在哪里呢……)"   voices=""/><msg @l="2239" char_id="-1" frame_id="-1" name="" text="姑且先沿着走廊走走看。"   voices=""/><msg @l="2240" char_id="-1" frame_id="-1" name="" text="房间数量出乎意料地多，让人感到惊讶。"   voices=""/><msg @l="2241" char_id="-1" frame_id="-1" name=""   text="左手边连续的房间都是空房，完全没有人的气息。" voices=""/><msg @l="2243" char_id="0" frame_id="-1" name="美帆" text="(是在那扇门的另一边吗……)"   voices=""/><clear @l="2246" class="all"/><msg @l="2248" char_id="-1" frame_id="-1" name="" text="朝着走廊尽头看到的门走去。"   voices=""/><msg @l="2249" char_id="-1" frame_id="-1" name=""   text="是一扇木门，看起来并没有特别装锁。" voices=""/><msg @l="2251" char_id="0" frame_id="-1" name="美帆" text="『…………。』" voices=""/><wait_chgmv/><bg @l="2254" src="bg20b"/><char @l="2257" id="miho" pos="auto" src="miho110"/><msg @l="2259" char_id="-1" frame_id="-1" name=""   text="穿过门后，进入了一条完全相同结构的走廊。" voices=""/><msg @l="2260" char_id="-1" frame_id="-1" name=""   text="看来这是一栋横向延伸的平房，几栋相同结构的建筑直线连接在一起。" voices=""/><msg @l="2262" char_id="0" frame_id="-1" name="美帆" text="(啊……那边，有光透出来)"   voices=""/><msg @l="2264" char_id="-1" frame_id="-1" name="" text="其中一个房间透出了灯光。"   voices=""/><msg @l="2265" char_id="-1" frame_id="-1" name="" text="同排的其他房间都没有人气。"   voices=""/><msg @l="2267" char_id="0" frame_id="-1" name="美帆"   text="(亚季奈……我突然出现会不会吓她一跳)" voices=""/><msg @l="2269" char_id="0" frame_id="-1" name="美帆"   text="(不过，我想尽快告诉她……也没办法了吧)" voices=""/><stopbgm @l="2272" fadeout="1000"/><clear @l="2276" class="all"/><label @l="2279" id="event_scene19"/><msg @l="2281" char_id="-1" frame_id="-1" name=""   text="总之，我决定蹑手蹑脚地向那个透着灯光的房间走去。" voices=""/><msg @l="2282" char_id="-1" frame_id="-1" name=""   text="即使小心翼翼地走，走廊吱吱嘎嘎的声响还是无法避免。" voices=""/><msg @l="2284" char_id="0" frame_id="-1" name="美帆" text="(总感觉我…变成小偷的感觉)"   voices=""/><msg @l="2286" char_id="-1" frame_id="-1" name=""   text="一步，又一步地接近透着灯光的房间。" voices=""/><msg @l="2287" char_id="-1" frame_id="-1" name=""   text="从房间里隐约能听到人的声音。" voices=""/><msg @l="2288" char_id="-1" frame_id="-1" name="" text="看来…她还没有睡。"   voices=""/><msg @l="2290" char_id="0" frame_id="-1" name="美帆"   text="(先确认一下亚季奈是不是在里面…)" voices=""/><msg @l="2292" char_id="0" frame_id="-1" name="美帆" text="(啊…这是什么！？)"   voices=""/><label @l="2295" id="chart_line13"/><wait_chgmv/><ev @l="2298" src="ev-019"/><description @l="2301" text="绽放的青色果实"/><bgm @l="2304" src="bgm13" volume="1."/><msg @l="2306" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯，嗯嗯…啊呜…。』" voices="akina00190"/><msg @l="2308" char_id="-1" frame_id="-1" name="渡部"   text="『哦哦，不愧是第一次…紧紧地夹着呢。』" voices=""/><msg @l="2310" char_id="2" frame_id="-1" name="亚季奈"   text="『啊…不，不行…这样，动起来…嗯啊！』" voices="akina00200"/><msg @l="2312" char_id="-1" frame_id="-1" name="留学生" text="『含得更深一点。』"   voices=""/><msg @l="2314" char_id="2" frame_id="-1" name="亚季奈"   text="『好、好的……呜咽……啾噗……嗯，啾啵！』" voices="akina00240"/><msg @l="2316" char_id="-1" frame_id="-1" name="留学生" text="『哦哦，哦哦！』"   voices=""/><msg @l="2318" char_id="2" frame_id="-1" name="亚季奈"   text="『呜咽……嗯……嗯嗯～……。』" voices="akina00230"/><msg @l="2320" char_id="-1" frame_id="-1" name="熊野"   text="『喂喂，你的手闲着呢。』" voices=""/><msg @l="2322" char_id="2" frame_id="-1" name="亚季奈"   text="『啊……这、这样吗……？ 』" voices="akina00210"/><msg @l="2324" char_id="-1" frame_id="-1" name="熊野"   text="『要好好地，考虑力度的轻重来触摸啊。』" voices=""/><msg @l="2326" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯，嗯……啊呜……唔，做不好啊……。』" voices="akina00220"/><msg @l="2328" char_id="-1" frame_id="-1" name="熊野"   text="『不是做不好，是要去做啊。』" voices=""/><msg @l="2330" char_id="0" frame_id="-1" name="美帆" text="『……。』"   voices="miho04170"/><msg @l="2332" char_id="-1" frame_id="-1" name=""   text="房间里发生的景象太过于不真实，我看呆了，说不出话来。" voices=""/><msg @l="2333" char_id="-1" frame_id="-1" name="" text="亚季奈……到底在做什么呢。"   voices=""/><msg @l="2334" char_id="-1" frame_id="-1" name=""   text="渡部老师，那个留学生，还有叫熊野的用务员……他们围着亚季奈。" voices=""/><msg @l="2335" char_id="-1" frame_id="-1" name="" text="在做什么……。" voices=""/><msg @l="2337" char_id="2" frame_id="-1" name="亚季奈"   text="『唔呃，嗯嗯……呼啊………啊，嗯啊啊……。』" voices="akina00250"/><msg @l="2339" char_id="2" frame_id="-1" name="亚季奈"   text="『不要……啊呃………嗯，啊啊！！』" voices="akina00260"/><msg @l="2341" char_id="-1" frame_id="-1" name="渡部"   text="『好了，别太挣扎……药效很快就起作用，疼痛也会消失。』" voices=""/><msg @l="2343" char_id="-1" frame_id="-1" name="渡部"   text="『那样的话……我会马上带你上天堂的。』" voices=""/><msg @l="2345" char_id="-1" frame_id="-1" name="熊野"   text="『不愧是处女，药效发作需要一点时间啊。这个可能需要稍微改良一下呢。』" voices=""/><msg @l="2347" char_id="-1" frame_id="-1" name="渡部"   text="『嘛，一开始就发疯了也没意思吧。这样的程度刚刚好不是吗？』" voices=""/><msg @l="2349" char_id="-1" frame_id="-1" name="熊野"   text="『原来如此，那么就再多收集一些数据来研究吧。』" voices=""/><msg @l="2351" char_id="0" frame_id="-1" name="美帆" text="（药……？）"   voices="miho04180"/><msg @l="2353" char_id="0" frame_id="-1" name="美帆"   text="（亚季奈被人用了奇怪的药……然后被侵犯了？）" voices="miho04190"/><msg @l="2355" char_id="0" frame_id="-1" name="美帆" text="（亚季奈她……）"   voices="miho04200"/><clear @l="2358" class="ev"/><stopbgm @l="2361" fadeout="1000"/><wait_chgmv/><bg @l="2364" src="bg19b"/><char @l="2367" id="miho" pos="auto" src="miho115"/><msg @l="2369" char_id="0" frame_id="-1" name="美帆"   text="『你，你们……在干什么！！ 』" voices="miho04210"/><msg @l="2371" char_id="-1" frame_id="-1" name=""   text="终于恢复了意识的我，冲进房间大声喊道。" voices=""/><bgm @l="2374" src="bgm09" volume="1."/><msg @l="2376" char_id="-1" frame_id="-1" name="渡部" text="『哦……？』" voices=""/><msg @l="2378" char_id="-1" frame_id="-1" name="熊野"   text="『哎呀哎呀，这真是意外的客人啊。』" voices=""/><msg @l="2380" char_id="0" frame_id="-1" name="美帆"   text="『这么多人一起欺负亚季奈……』" voices="miho04220"/><msg @l="2382" char_id="0" frame_id="-1" name="美帆"   text="『而且还使用药物……！！』" voices="miho04230"/><clear @l="2385" class="char"/><char @l="2387" id="miho" pos="left" src="miho014"/><char @l="2389" id="watab" pos="right" src="watabe010"/><msg @l="2391" char_id="-1" frame_id="-1" name="渡部"   text="『什么，你连这种事都听到了吗？』" voices=""/><char @l="2394" id="kuma" pos="left" src="kuma010"/><msg @l="2396" char_id="-1" frame_id="-1" name="熊野"   text="『这样的话……就不能让你乖乖回去了呢。』" voices=""/><msg @l="2398" char_id="-1" frame_id="-1" name="渡部"   text="『本来想用刚刚搞定的妹妹来逼你就范的，现在少了一个乐趣了。』" voices=""/><msg @l="2400" char_id="-1" frame_id="-1" name="留学生"   text="『哦，女，女人……女人。』" voices=""/><char @l="2403" id="miho" pos="left" src="miho015"/><msg @l="2405" char_id="0" frame_id="-1" name="美帆"   text="『你们，你们意识到自己在做什么吗！？』" voices="miho04240"/><msg @l="2407" char_id="0" frame_id="-1" name="美帆" text="『这可是严重的犯罪行为啊！！』"   voices="miho04250"/><char @l="2410" id="watab" pos="right" src="watabe014"/><msg @l="2412" char_id="-1" frame_id="-1" name="渡部"   text="『缺乏认知的是你吧？』" voices=""/><msg @l="2414" char_id="-1" frame_id="-1" name="渡部"   text="『所谓犯罪啊，如果没有受害者站出来，就不能成立的。』" voices=""/><msg @l="2416" char_id="0" frame_id="-1" name="美帆"   text="『那种事……我这就去警察那里……。』" voices="miho04260"/><char @l="2419" id="watab" pos="right" src="watabe012"/><msg @l="2421" char_id="-1" frame_id="-1" name="渡部"   text="『你跑去能说什么？说你妹妹被强奸了吗？』" voices=""/><msg @l="2423" char_id="-1" frame_id="-1" name="渡部"   text="『忘了自己当时是怎么做的吗？』" voices=""/><msg @l="2425" char_id="-1" frame_id="-1" name="渡部"   text="『自己差点被强奸的时候保持沉默，但妹妹被侵犯了就要公开，完全不考虑妹妹的感受。』" voices=""/><char @l="2428" id="miho" pos="left" src="miho115"/><msg @l="2430" char_id="0" frame_id="-1" name="美帆" text="『啊……』"   voices="miho04270"/><msg @l="2432" char_id="-1" frame_id="-1" name="熊野"   text="『那真的是明智之举吗？』" voices=""/><char @l="2435" id="kuma" pos="right" src="kuma010"/><msg @l="2437" char_id="-1" frame_id="-1" name="熊野"   text="『确实我们可能会被追究责任，但这样不也会让你妹妹的人生大乱吗？』" voices=""/><msg @l="2440" char_id="0" frame_id="-1" name="美帆" text="『这，这个……』"   voices="miho04280"/><msg @l="2442" char_id="-1" frame_id="-1" name="熊野"   text="『而且……谁知道你妹妹会不会作为受害者出来作证呢。』" voices=""/><msg @l="2444" char_id="0" frame_id="-1" name="美帆" text="『这是什么意思……』"   voices="miho04290"/><msg @l="2446" char_id="-1" frame_id="-1" name="熊野"   text="『我是说，你妹妹看起来挺……享受的。』" voices=""/><char @l="2449" id="miho" pos="left" src="miho014"/><msg @l="2451" char_id="0" frame_id="-1" name="美帆"   text="『那是因为！……你们用了奇怪的药！』" voices="miho04300"/><msg @l="2453" char_id="-1" frame_id="-1" name="熊野"   text="『可是，在暴力或强奸的情况下，当事人的证词是最重要的。』" voices=""/><msg @l="2455" char_id="-1" frame_id="-1" name="熊野"   text="『如果当事人不作为受害者进行证言的话……不管是什么情况，都会被视为合意性行为。』" voices=""/><msg @l="2457" char_id="0" frame_id="-1" name="美帆" text="『怎么会！！』"   voices="miho04310"/><msg @l="2459" char_id="-1" frame_id="-1" name="熊野"   text="『那么，我们来问问当事人如何？』" voices=""/><char @l="2462" id="miho" pos="left" src="miho015"/><msg @l="2464" char_id="0" frame_id="-1" name="美帆" text="『唔……亚季奈，亚季奈！！』"   voices="miho04320"/><msg @l="2466" char_id="0" frame_id="-1" name="美帆"   text="『没事了……我来救你了！？』" voices="miho04330"/><msg @l="2468" char_id="2" frame_id="-1" name="亚季奈"   text="『哈……哈……哈………姐姐……？』" voices="akina00270"/><msg @l="2470" char_id="0" frame_id="-1" name="美帆"   text="『是啊，是姐姐啊……所以，我们回家吧？ 』" voices="miho04340"/><msg @l="2472" char_id="2" frame_id="-1" name="亚季奈"   text="『不行……不行的……因为我，终于和最喜欢的老师合为一体了。』" voices="akina00280"/><stopbgm @l="2475" fadeout="1000"/><clear @l="2477" class="char"/><char @l="2479" id="miho" pos="auto" src="miho015"/><msg @l="2481" char_id="0" frame_id="-1" name="美帆" text="『诶……？』"   voices="miho04350"/><char @l="2484" id="miho" pos="auto" src="miho115"/><msg @l="2486" char_id="0" frame_id="-1" name="美帆" text="『亚季奈……你、在说什么……。』"   voices="miho04360"/><msg @l="2488" char_id="2" frame_id="-1" name="亚季奈"   text="『而且呢，一开始很疼……但现在不知怎么的感觉痒痒的。』" voices="akina00290"/><msg @l="2490" char_id="2" frame_id="-1" name="亚季奈"   text="『那里呢……热热的，痒痒的……忍不住了……。』" voices="akina00300"/><msg @l="2492" char_id="2" frame_id="-1" name="亚季奈"   text="『呐，老师……我，想要更多啊。』" voices="akina00310"/><clear @l="2495" class="char"/><char @l="2497" id="watab" pos="auto" src="watabe010"/><msg @l="2499" char_id="-1" frame_id="-1" name="渡部" text="『……听到了吧。』"   voices=""/><clear @l="2502" class="char"/><char @l="2504" id="watab" pos="right" src="watabe010"/><char @l="2506" id="miho" pos="left" src="miho015"/><msg @l="2509" char_id="0" frame_id="-1" name="美帆" text="『亚季奈……。』"   voices="miho04370"/><char @l="2512" id="kuma" pos="right" src="kuma010"/><msg @l="2514" char_id="-1" frame_id="-1" name="熊野"   text="『那么，碍事的你暂且先打这个吧。』" voices=""/><flash @l="2517" count="4" fade="100" image="white"/><char @l="2519" id="miho" pos="left" src="miho014"/><msg @l="2521" char_id="0" frame_id="-1" name="美帆" text="『痛……刚才那是什么！？』"   voices="miho04380"/><msg @l="2523" char_id="-1" frame_id="-1" name="" text="脖颈处传来一阵刺痛。"   voices=""/><char @l="2525" id="kuma" pos="right" src="kuma012"/><msg @l="2526" char_id="-1" frame_id="-1" name=""   text="回头一看，熊野手持注射器，嘴角扭曲地站在那里。" voices=""/><msg @l="2528" char_id="-1" frame_id="-1" name="熊野"   text="『请放心，不是什么严重的药物。』" voices=""/><msg @l="2530" char_id="-1" frame_id="-1" name="熊野"   text="『这叫做松弛剂，只会让全身无法使上力气而已。』" voices=""/><msg @l="2532" char_id="-1" frame_id="-1" name="熊野"   text="『不过，注射过量的话连呼吸都会停止就是了。』" voices=""/><msg @l="2534" char_id="-1" frame_id="-1" name="" text="说着，熊野发出下流的笑声。"   voices=""/><char @l="2537" id="miho" pos="left" src="miho015"/><msg @l="2539" char_id="0" frame_id="-1" name="美帆" text="『啊……啊啊……。』"   voices="miho04390"/><clear @l="2542" class="char"/><se @l="2545" buf="1" src="ベッドに倒れこむ音" volume="1."/><char @l="2548" id="watab" pos="left" src="watabe010"/><char @l="2550" id="kuma" pos="right" src="kuma010"/><msg @l="2552" char_id="-1" frame_id="-1" name=""   text="不知是药效已经显现，还是被注入药物的心理冲击导致的症状。" voices=""/><msg @l="2553" char_id="-1" frame_id="-1" name=""   text="我感到手脚有轻微麻痹，不由得瘫坐在地上。" voices=""/><msg @l="2555" char_id="-1" frame_id="-1" name="渡部"   text="『呵，就在那里好好看着你妹妹堕落的样子吧。』" voices=""/><msg @l="2557" char_id="-1" frame_id="-1" name=""   text="渡部老师这么说着，将瘫坐的我推到墙边，然后骄傲地在我眼前露出他坚硬勃起的男根。" voices=""/><msg @l="2559" char_id="2" frame_id="-1" name="亚季奈"   text="『老师……快用那个插进我的下面……。』" voices="akina00320"/><msg @l="2561" char_id="2" frame_id="-1" name="亚季奈"   text="『我、我的身体好奇怪……好热……好痒……。』" voices="akina00330"/><char @l="2564" id="watab" pos="left" src="watabe012"/><msg @l="2566" char_id="-1" frame_id="-1" name="渡部"   text="『啊，等着吧……马上就让你一直高潮个不停。』" voices=""/><clear @l="2569" class="all"/><wait_chgmv/><ev @l="2572" src="ev-019"/><bgm @l="2575" src="bgm14" volume="1."/><msg @l="2577" char_id="2" frame_id="-1" name="亚季奈" text="『嗯，啊啊啊啊啊！！』"   voices="akina00340"/><msg @l="2579" char_id="-1" frame_id="-1" name=""   text="渡部的那物刺入湿润滚烫的秘部的瞬间，亚季奈发出颤抖的声音，猛地挺起了腰。" voices=""/><msg @l="2581" char_id="-1" frame_id="-1" name="渡部"   text="『哈哈，只是插入就高潮了啊。』" voices=""/><msg @l="2583" char_id="-1" frame_id="-1" name="熊野"   text="『我自己都要说……这药效果相当了得啊。有了这药，今后也能创造出和这里一样的城镇呢。』" voices=""/><msg @l="2585" char_id="-1" frame_id="-1" name="渡部"   text="『处女就有这种敏感度……真是个相当喜欢的类型啊！』" voices=""/><msg @l="2587" char_id="2" frame_id="-1" name="亚季奈"   text="『啊，啊啊……哈……啊呜……嗯，啊呜！！』" voices="akina00350"/><msg @l="2589" char_id="-1" frame_id="-1" name=""   text="渡部的硬物在幼嫩的花蕾中肆虐，强行撑开了本应紧闭的处女穴。" voices=""/><msg @l="2590" char_id="-1" frame_id="-1" name="" text="亚季奈不断颤抖着腰肢，痛苦地挣扎着。"   voices=""/><msg @l="2591" char_id="-1" frame_id="-1" name=""   text="尽管是难以忍受的疼痛，亚季奈的肉壁却在微微颤抖，紧紧缠绕着渡部的肉茎。" voices=""/><msg @l="2593" char_id="-1" frame_id="-1" name="留学生" text="『哦，拜托拜托。』"   voices=""/><msg @l="2595" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯啊啊啊……啊，嗯咕……啾，啾姆，啊呜！！』" voices="akina00360"/><msg @l="2597" char_id="-1" frame_id="-1" name=""   text="亚季奈专心致志地吮吸着递到嘴边的留学生的那物。" voices=""/><msg @l="2598" char_id="-1" frame_id="-1" name=""   text="她用嘴唇含住前端，舌尖执拗地舔舐着下侧的筋脉，同时还在吸吮着。" voices=""/><msg @l="2600" char_id="-1" frame_id="-1" name="留学生" text="『哦哦哦……太——棒了』"   voices=""/><msg @l="2602" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯噗，嗯噗，嗯哈……啪啾，啾啪……嗯姆！』" voices="akina00370"/><msg @l="2604" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯，嗯啊……哈呜，嗯哈……嗯……啾噜噜！！』" voices="akina00380"/><msg @l="2606" char_id="-1" frame_id="-1" name=""   text="大概是因为被夸奖而高兴起来了吧。" voices=""/><msg @l="2607" char_id="-1" frame_id="-1" name=""   text="亚季奈更加猛烈地吸附在肉棒的前端，开始缠绕起舌头。" voices=""/><msg @l="2608" char_id="-1" frame_id="-1" name=""   text="她撅起嘴唇在龟头周围套弄，发出啧啧的淫靡声响，甚至将包皮垢都舔得干干净净。" voices=""/><msg @l="2610" char_id="-1" frame_id="-1" name="熊野"   text="『那么，要不要更用力地套弄一下呢』" voices=""/><msg @l="2612" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯呼……嗯呜………嗯，啊啊……好硬啊。』" voices="akina00390"/><msg @l="2614" char_id="2" frame_id="-1" name="亚季奈"   text="『小鸡鸡……又硬又粗………嗯，好热………』" voices="akina00400"/><msg @l="2616" char_id="-1" frame_id="-1" name=""   text="亚季奈一边笨拙地套弄着被塞进手中的肉棒，一边喃喃自语般地重复着。" voices=""/><msg @l="2617" char_id="-1" frame_id="-1" name=""   text="她空洞的目光固定在手中的肉棒上，似乎在愉快地观察着随着力度变化而产生变化的肉茎。" voices=""/><msg @l="2619" char_id="-1" frame_id="-1" name="渡部"   text="『喂，又热又硬的东西可不只在你手中哦。』" voices=""/><msg @l="2621" char_id="-1" frame_id="-1" name=""   text="仿佛要把专注于手中肉棒的亚季奈拉回现实一般，渡部深深地挺动腰部，用龟头搅动着她子宫深处。" voices=""/><msg @l="2622" char_id="-1" frame_id="-1" name=""   text="随着肉棒侵入到更深处带来的刺激，她的肉壁各处都涌出了爱液。" voices=""/><msg @l="2624" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯啊……啊呜……嗯，嗯，嗯……。』" voices="akina00410"/><msg @l="2626" char_id="2" frame_id="-1" name="亚季奈"   text="『老师……不行，太深了………嗯，啊啊啊！！』" voices="akina00420"/><msg @l="2628" char_id="-1" frame_id="-1" name="渡部"   text="『什么太深了，每次顶到深处时你的肉壁不是都在颤抖着缠上来吗？』" voices=""/><msg @l="2630" char_id="2" frame_id="-1" name="亚季奈"   text="『可是……嗯嗯，被顶到深处的地方……。』" voices="akina00430"/><msg @l="2632" char_id="2" frame_id="-1" name="亚季奈"   text="『我的身体，会不由自主地那样……嗯，嗯嗯！！』" voices="akina00440"/><msg @l="2634" char_id="-1" frame_id="-1" name="渡部"   text="『那么，我就得好好地顶弄你的深处了！』" voices=""/><msg @l="2636" char_id="2" frame_id="-1" name="亚季奈"   text="『呼啊……嗯呜，啊，啊，啊，啊啊！！』" voices="akina00450"/><msg @l="2638" char_id="2" frame_id="-1" name="亚季奈"   text="『这样下去……嗯嗯……不行，不行……。』" voices="akina00460"/><msg @l="2640" char_id="-1" frame_id="-1" name="渡部"   text="『来啊……什么不行，说出来。』" voices=""/><msg @l="2642" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯啊……要来了，要来了……热的东西……要来了！！』" voices="akina00470"/><msg @l="2644" char_id="-1" frame_id="-1" name="熊野"   text="『哦，那么配合着一起……怎么样？』" voices=""/><msg @l="2646" char_id="-1" frame_id="-1" name="留学生"   text="『哦、哦哦，哦嗷……OK』" voices=""/><msg @l="2648" char_id="-1" frame_id="-1" name="渡部"   text="『好——那么，给我好好接着。』" voices=""/><msg @l="2650" char_id="-1" frame_id="-1" name=""   text="就这样渡部开始激烈地摆动腰部，搅动亚季奈的体内。" voices=""/><msg @l="2651" char_id="-1" frame_id="-1" name=""   text="每次撞击腰部时，大量淫液从亚季奈体内溢出，发出啧啧的淫秽声音，滴落在大腿上。"   voices=""/><msg @l="2653" char_id="-1" frame_id="-1" name="留学生"   text="『哦、哦哦……哦买嘎！！』" voices=""/><msg @l="2655" char_id="-1" frame_id="-1" name=""   text="留学生也学着样子，让亚季奈的小嘴含住巨炮的前端，抓住她的头毫不留情地猛烈抽送着腰部。"   voices=""/><msg @l="2657" char_id="2" frame_id="-1" name="亚季奈"   text="『啊呜，嗯……呜……呜，啧，啧，啧。』" voices="akina00480"/><msg @l="2659" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯，啧……滋，啧，啾……呜啊！』" voices="akina00490"/><msg @l="2661" char_id="-1" frame_id="-1" name=""   text="亚季奈虽然对插入的巨炮势头感到困惑，但很快就缠绕上舌尖，用嘴唇套弄起来。" voices=""/><msg @l="2663" char_id="-1" frame_id="-1" name="熊野"   text="『那么，也请带领我到最后吧。』" voices=""/><msg @l="2665" char_id="-1" frame_id="-1" name=""   text="熊野让亚季奈的小手帮他套弄，或许是那份生涩感让他难以忍受，他将自己的手覆在亚季奈的手上，猛烈地撸动起来。"   voices=""/><msg @l="2667" char_id="2" frame_id="-1" name="亚季奈"   text="『啾啵……嗯噗……嗯噗………嗯，嗯哈！！』" voices="akina00500"/><msg @l="2669" char_id="2" frame_id="-1" name="亚季奈"   text="『不行……已……忍不住……了，啊，嗯嗯！！』" voices="akina00510"/><msg @l="2671" char_id="-1" frame_id="-1" name="渡部"   text="『好啊，我也差不多了……要在里面全部射给你。』" voices=""/><msg @l="2673" char_id="-1" frame_id="-1" name="熊野" text="『我也……马上就到了。』"   voices=""/><msg @l="2675" char_id="-1" frame_id="-1" name="留学生" text="『哦哦！哦啊啊啊！』"   voices=""/><msg @l="2677" char_id="2" frame_id="-1" name="亚季奈"   text="『啾呜……嗯咕，嗯噗，嗯噗……啾姆！！』" voices="akina00520"/><msg @l="2679" char_id="-1" frame_id="-1" name=""   text="男人们纷纷表示已到极限，呼吸急促起来。" voices=""/><msg @l="2680" char_id="-1" frame_id="-1" name=""   text="感受到男人们即将到达极限的亚季奈也……放任自己沉浸在一直忍耐着的高潮中，腰部颤抖起来。" voices=""/><msg @l="2682" char_id="2" frame_id="-1" name="亚季奈"   text="『呼哈……不行，要来了，要来了……来，啊啊啊啊！！』" voices="akina00530"/><flash @l="2685" count="4" fade="100" image="white"/><wait_chgmv/><ev @l="2688" src="ev-019x1z1"/><msg @l="2690" char_id="-1" frame_id="-1" name=""   text="一齐射出的白浊液体，逐渐玷污了亚季奈的身体。" voices=""/><msg @l="2691" char_id="-1" frame_id="-1" name=""   text="渡部在亚季奈的子宫深处注入大量精液，而熊野则将肉棒靠近亚季奈的嘴边，将精液喷洒在她脸上。" voices=""/><msg @l="2692" char_id="-1" frame_id="-1" name=""   text="留学生则是……仿佛不嫌多似的，将大量精液撒在亚季奈的脸上和胸部，遍布她的全身。" voices=""/><msg @l="2694" char_id="-1" frame_id="-1" name="熊野"   text="『来，要把全部都喝下去哦。』" voices=""/><msg @l="2696" char_id="-1" frame_id="-1" name="熊野"   text="『里面还有残留的……不要忘记把它吸出来哦。』" voices=""/><msg @l="2698" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯啊……嗯，嗯咕……啾噗……嗯咕，嗯咕……。』" voices="akina00540"/><msg @l="2700" char_id="2" frame_id="-1" name="亚季奈"   text="『啊呼，嗯……啾噗……嗯噗……嗯噗……嗯咕。』" voices="akina00550"/><msg @l="2702" char_id="-1" frame_id="-1" name=""   text="亚季奈按照命令咽下口腔内的精液，甚至还吸出了肿胀阴茎深处残留的部分。" voices=""/><msg @l="2703" char_id="-1" frame_id="-1" name=""   text="亚季奈的表情中已经没有一丝理性的痕迹……" voices=""/><msg @l="2704" char_id="-1" frame_id="-1" name=""   text="只是，那机械地完成被命令事项的样子，就像一个人偶一般。" voices=""/><stopbgm @l="2707" fadeout="1000"/><clear @l="2710" class="all"/><msg @l="2712" char_id="0" frame_id="-1" name="美帆" text="(亚季奈……对不起………)"   voices="miho04400"/><msg @l="2714" char_id="-1" frame_id="-1" name=""   text="我再也无法忍受看着亚季奈被这样玷污的样子，颤抖着慢慢闭上了眼睛。" voices=""/><msg @l="2715" char_id="-1" frame_id="-1" name="" text="仿佛是在……逃避所有的现实一般。"   voices=""/><clear @l="2718" class="all"/><end_scene @l="2721"/><msgshow @l="2724" show="true"/><call @l="2727" target="EventLabel_41@ending03"/><return @l="2728" value="0&#13;&#10;"/><label @l="2731" id="EventLabel_78"/><stopbgm @l="2734" fadeout="1000"/><clear @l="2737" class="all"/><call @l="2740" target="EventLabel_80@root_akina05"/><return @l="2741" value="0&#13;&#10;"/><return @l="2744" value=""/></code></xscript>																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																												