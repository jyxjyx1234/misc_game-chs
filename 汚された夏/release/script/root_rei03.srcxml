<?xml version="1.0" encoding="utf-8"?><xscript><debug editor="&quot;C:\Program&#32;Files&#32;(x86)\sakura\sakura.exe&quot;&#32;&quot;%src%&quot;&#32;-Y=%line%"   src="D:\シロップ\町ぐるみの罠＋汚された夏セット版\汚された夏\完成データ\汚された夏\script\text\root_rei03.txt"/><code><label @l="12" id="EventLabel_132"/><description @l="16" text="室友的忧郁·第3天"/><eval @l="18" expr="f.numDay=9&#13;&#10;"/><msgshow @l="20" show="false"/><wait_chgmv/><bg @l="22" src="day09" time="2000"/><wait @l="24" time="500"/><wait_chgmv/><bg @l="26" src="black" time="2000"/><msgshow @l="28" show="true"/><wait_chgmv/><bg @l="32" src="bg03"/><bgm @l="36" src="bgm03" volume="1."/><char @l="40" id="miho" pos="auto" src="miho116"/><msg @l="42" char_id="0" frame_id="-1" name="美帆" text="『那个……那么，我出门了。』"   voices=""/><msg @l="44" char_id="-1" frame_id="-1" name=""   text="吃完早饭后，我做好了外出准备，在出门前试着向玲打个招呼。" voices=""/><char @l="48" id="rei" pos="auto" src="rei030"/><msg @l="50" char_id="1" frame_id="-1" name="玲" text="『……。』" voices=""/><msg @l="52" char_id="-1" frame_id="-1" name="" text="然而，果然没有得到回应。"   voices=""/><msg @l="53" char_id="-1" frame_id="-1" name=""   text="这不是错觉，我确实被她刻意回避了。" voices=""/><char @l="57" id="miho" pos="auto" src="miho115"/><msg @l="59" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="61" char_id="0" frame_id="-1" name="美帆" text="『……我出门了。』"   voices=""/><clear @l="65" class="char"/><msg @l="67" char_id="-1" frame_id="-1" name=""   text="再一次……我像是在对自己说话般低声呢喃着，然后离开了家。" voices=""/><stopbgm @l="71" fadeout="1000"/><clear @l="77" class="all"/><wait_chgmv/><bg @l="81" src="bg03"/><bgm @l="85" src="bgm05" volume="1."/><char @l="89" id="rei" pos="auto" src="rei035"/><msg @l="91" char_id="1" frame_id="-1" name="玲" text="『……。』" voices=""/><msg @l="93" char_id="-1" frame_id="-1" name=""   text="美帆离开家后，玲带着复杂的表情望向玄关方向。" voices=""/><msg @l="94" char_id="-1" frame_id="-1" name=""   text="玲自己也明白自己做的事很幼稚。" voices=""/><msg @l="95" char_id="-1" frame_id="-1" name=""   text="只是……无论如何都无法正常地与她交谈。" voices=""/><msg @l="97" char_id="1" frame_id="-1" name="玲" text="『为什么啊，美帆……。』"   voices=""/><msg @l="99" char_id="1" frame_id="-1" name="玲"   text="『在我好不容易拼命努力才到达的地方……为什么你也要。』" voices=""/><msg @l="101" char_id="-1" frame_id="-1" name=""   text="本该对美帆提出的质问……玲在只剩下自己一人的客厅里说了出来。" voices=""/><msg @l="103" char_id="1" frame_id="-1" name="玲"   text="『我一直以为你不是那种会抢先下手的女孩……我已经看不懂你了……美帆。』" voices=""/><msg @l="105" char_id="-1" frame_id="-1" name=""   text="对于美帆，玲一直希望自己能像个温柔的姐姐一样。" voices=""/><msg @l="106" char_id="-1" frame_id="-1" name="" text="但是，现在……似乎已经无法再温柔下去了……。"   voices=""/><msg @l="108" char_id="1" frame_id="-1" name="玲" text="『………。』" voices=""/><msg @l="110" char_id="-1" frame_id="-1" name=""   text="玲喝下已经变凉的咖啡，从座位上站了起来。" voices=""/><msg @l="111" char_id="-1" frame_id="-1" name="" text="美帆离开家已经过去了大约30分钟。"   voices=""/><msg @l="113" char_id="1" frame_id="-1" name="玲" text="『推荐信……该找谁要呢。』"   voices=""/><stopbgm @l="117" fadeout="1000"/><clear @l="123" class="all"/><msgshow @l="125" show="true"/><bgm @l="130" src="bgm07" volume="1."/><msg @l="133" char_id="-1" frame_id="-1" name="指导员"   text="『关于就职活动所需的推荐信发行事宜，已全权委托给朽木阳大教授了。』" voices=""/><msg @l="135" char_id="-1" frame_id="-1" name=""   text="在考虑从谁那里获得推荐信最好的结果是，姑且先去拜访了就职活动指导部，但却得到了上述回答。" voices=""/><msg @l="137" char_id="1" frame_id="-1" name="玲"   text="『为什么只有朽木教授能发行推荐信呢？』" voices=""/><msg @l="139" char_id="1" frame_id="-1" name="玲"   text="『我认为一般来说，所有教授都能发行才对。』" voices=""/><msg @l="141" char_id="-1" frame_id="-1" name=""   text="通常，只要是教授，谁都可以发行推荐信，不过根据教授的知名度等因素，效力会有所差异。" voices=""/><msg @l="142" char_id="-1" frame_id="-1" name=""   text="然而，这所大学却规定只有朽木教授能够发行。" voices=""/><msg @l="144" char_id="-1" frame_id="-1" name="指导员"   text="『这个嘛……我不清楚具体原因。』" voices=""/><msg @l="146" char_id="1" frame_id="-1" name="玲" text="『……是吗。』" voices=""/><msg @l="148" char_id="1" frame_id="-1" name="玲"   text="『不好意思，谢谢您……。』" voices=""/><msg @l="150" char_id="-1" frame_id="-1" name="指导员" text="『不用谢，那么。』"   voices=""/><stopbgm @l="154" fadeout="1000"/><clear @l="160" class="all"/><wait_chgmv/><bg @l="164" src="bg09"/><bgm @l="168" src="bgm03" volume="1."/><char @l="172" id="rei" pos="auto" src="rei115"/><msg @l="174" char_id="1" frame_id="-1" name="玲" text="『………。』" voices=""/><msg @l="176" char_id="-1" frame_id="-1" name="" text="———忧郁。" voices=""/><msg @l="177" char_id="-1" frame_id="-1" name="" text="从玲的表情上明显可以看出这一点。"   voices=""/><msg @l="178" char_id="-1" frame_id="-1" name=""   text="也难怪……偏偏要去向那个朽木低头请求写推荐信。" voices=""/><msg @l="179" char_id="-1" frame_id="-1" name="" text="向那个惯犯性骚扰的朽木教授……"   voices=""/><msg @l="181" char_id="1" frame_id="-1" name="玲" text="『……想也没用。』"   voices=""/><msg @l="183" char_id="1" frame_id="-1" name="玲"   text="『总之……只能去试试看了。』" voices=""/><clear @l="189" class="all"/><se @l="193" buf="1" src="ノック" volume="1."/><msg @l="195" char_id="-1" frame_id="-1" name="声音" text="『门开着呢。请进来吧。』"   voices=""/><msg @l="197" char_id="1" frame_id="-1" name="玲" text="『……打扰了。』" voices=""/><wait_chgmv/><bg @l="201" src="bg12"/><char @l="205" id="rei" pos="auto" src="rei123"/><msg @l="207" char_id="1" frame_id="-1" name="玲" text="『突然来访很抱歉。』" voices=""/><clear @l="210" class="char"/><char @l="212" id="rei" pos="left" src="rei123"/><char @l="215" id="kutsu" pos="right" src="kutsu010"/><msg @l="217" char_id="-1" frame_id="-1" name="朽木" text="『哎呀……这可真是稀客啊。』"   voices=""/><msg @l="219" char_id="-1" frame_id="-1" name=""   text="当朽木得知进来的人是玲时，他这样说着，咧嘴一笑。" voices=""/><msg @l="220" char_id="-1" frame_id="-1" name=""   text="就仿佛他早已知道她今天会来这个地方一样。" voices=""/><msg @l="222" char_id="1" frame_id="-1" name="玲"   text="『我在就业指导部询问推荐信的制作事宜时，听说这项工作是由朽木教授全权负责的，所以就来了。』" voices=""/><msg @l="224" char_id="-1" frame_id="-1" name="朽木"   text="『啊，关于企业推荐信的发行确实是由我全权负责的。』" voices=""/><char @l="227" id="kutsu" pos="right" src="kutsu018"/><char @l="229" id="rei" pos="left" src="rei125"/><msg @l="232" char_id="-1" frame_id="-1" name="朽木"   text="『我拥有你前几天所质疑的那种独特的人脉关系哦。』" voices=""/><msg @l="234" char_id="-1" frame_id="-1" name="" text="朽木用蛇一般令人不快的目光注视着玲。"   voices=""/><msg @l="235" char_id="-1" frame_id="-1" name=""   text="看起来他还在为前几天的事耿耿于怀。" voices=""/><msg @l="237" char_id="1" frame_id="-1" name="玲" text="『……。』" voices=""/><char @l="240" id="rei" pos="left" src="rei115"/><msg @l="242" char_id="1" frame_id="-1" name="玲" text="『那么……我想请您给我写一份推荐信。』"   voices=""/><msg @l="244" char_id="-1" frame_id="-1" name="朽木"   text="『白石同学是希望到大黑集团就职对吧？』" voices=""/><msg @l="246" char_id="1" frame_id="-1" name="玲" text="『……是的。』" voices=""/><msg @l="248" char_id="-1" frame_id="-1" name="朽木"   text="『是吗，那个大型的大黑集团啊……』" voices=""/><msg @l="250" char_id="1" frame_id="-1" name="玲" text="『……。』" voices=""/><msg @l="252" char_id="1" frame_id="-1" name="玲" text="『……您想说什么？』"   voices=""/><msg @l="254" char_id="-1" frame_id="-1" name="朽木"   text="『没什么……只是最近经济不景气，女性就业很困难吧。』" voices=""/><char @l="257" id="rei" pos="left" src="rei015"/><msg @l="259" char_id="1" frame_id="-1" name="玲"   text="『所以，我才特地来请您给我写推荐信。』" voices=""/><msg @l="261" char_id="-1" frame_id="-1" name="朽木" text="『是啊，确实如此。』"   voices=""/><msg @l="263" char_id="-1" frame_id="-1" name="朽木"   text="『如果没有推荐信，进入大企业简直就是痴人说梦。』" voices=""/><msg @l="265" char_id="1" frame_id="-1" name="玲" text="『……。』" voices=""/><char @l="268" id="kutsu" pos="right" src="kutsu018"/><msg @l="270" char_id="-1" frame_id="-1" name="朽木"   text="『你不明白我的意思吗？』" voices=""/><msg @l="272" char_id="-1" frame_id="-1" name="朽木"   text="『也就是说……你能否进入大黑集团完全取决于我。』" voices=""/><char @l="276" id="rei" pos="left" src="rei025"/><msg @l="278" char_id="1" frame_id="-1" name="玲"   text="『什…那是什么意思！？』" voices=""/><msg @l="280" char_id="-1" frame_id="-1" name="朽木"   text="『你真是不聪明啊……这可不像以聪慧著称的白石同学会说的话。』" voices=""/><msg @l="282" char_id="-1" frame_id="-1" name="朽木"   text="『意思是，如果想要推荐信的话，就得让我随心所欲……这就是我的意思。』" voices=""/><clear @l="286" class="char"/><bgm @l="290" src="bgm15" volume="1."/><char @l="294" id="rei" pos="center" src="rei014f" y="-80"/><msg @l="296" char_id="1" frame_id="-1" name="玲" text="『啊！？』" voices=""/><msg @l="301" char_id="-1" frame_id="-1" name="" text="朽木抓住玲的手臂，用力将她拉近。"   voices=""/><msg @l="302" char_id="-1" frame_id="-1" name=""   text="完全被打了个措手不及的玲还来不及抵抗，就被朽木拥入了怀中。" voices=""/><char @l="306" id="rei" pos="center" src="rei017f" y="-80"/><msg @l="308" char_id="1" frame_id="-1" name="玲" text="『不…请放开我！！』"   voices=""/><msg @l="310" char_id="-1" frame_id="-1" name="朽木"   text="『怎么了，你不是想要推荐信吗？』" voices=""/><msg @l="312" char_id="-1" frame_id="-1" name="朽木"   text="『如果你要反抗的话…那就别想拿到推荐信了。』" voices=""/><msg @l="314" char_id="1" frame_id="-1" name="玲" text="『卑鄙！！』" voices=""/><msg @l="316" char_id="-1" frame_id="-1" name="朽木" text="『那又怎样呢。』"   voices=""/><msg @l="318" char_id="-1" frame_id="-1" name="朽木"   text="『如果不需要推荐信的话，你大可以离开这个房间。』" voices=""/><msg @l="320" char_id="-1" frame_id="-1" name="朽木" text="『选择权在你手上。』"   voices=""/><char @l="323" id="rei" pos="center" src="rei015f" y="-80"/><msg @l="325" char_id="1" frame_id="-1" name="玲" text="『呃…你真是个卑鄙小人。』"   voices=""/><msg @l="327" char_id="-1" frame_id="-1" name="朽木"   text="『呵呵呵…我就把这当作赞美收下了。』" voices=""/><begin_trans @l="331" time="500"/><layer @l="332" id="cutin_f" src="game_window_cutin" x="20" y="20" z="-1001"/><layer @l="333" id="cutin" src="cut005b" x="32" y="32" z="-1000"/><end_trans @l="334"/><msg @l="336" char_id="-1" frame_id="-1" name=""   text="朽木说完，将手滑入裙子里，隔着内裤抚摸她的私处。" voices=""/><msg @l="337" char_id="-1" frame_id="-1" name="" text="摸啊，摸啊。" voices=""/><msg @l="339" char_id="1" frame_id="-1" name="玲" text="『唔唔……！』" voices=""/><msg @l="341" char_id="-1" frame_id="-1" name=""   text="玲扭动身体想要逃脱……但一想到与稻庭同期入职的梦想，就无法反抗。" voices=""/><msg @l="343" char_id="-1" frame_id="-1" name="朽木"   text="『对对，无论发生什么，你都想要推荐信……对吧？』" voices=""/><msg @l="345" char_id="1" frame_id="-1" name="玲" text="『这、这个……』" voices=""/><msg @l="347" char_id="-1" frame_id="-1" name="朽木"   text="『没什么，我不会做过分的事……只要你服从我的话，我一定会准备好推荐信的。』" voices=""/><begin_trans @l="350" time="500"/><layer @l="351" id="cutin_f" src="game_window_cutin" x="20" y="20" z="-1001"/><layer @l="352" id="cutin" src="cut005a" x="32" y="32" z="-1000"/><end_trans @l="353"/><msg @l="355" char_id="-1" frame_id="-1" name=""   text="朽木轻松地将手伸进内裤，将手指插入她的私处缝隙中。" voices=""/><msg @l="356" char_id="-1" frame_id="-1" name="" text="揉，揉，揉。"   voices=""/><msg @l="358" char_id="1" frame_id="-1" name="玲" text="『嗯……！！』" voices=""/><msg @l="360" char_id="-1" frame_id="-1" name="朽木"   text="『咯咯……，对了，把一切都交给我吧。』" voices=""/><msg @l="362" char_id="-1" frame_id="-1" name=""   text="说着，他用指腹摩擦着肉壁上的细微褶皱，开始拨弄秘缝上方那颗红色的珍珠。" voices=""/><msg @l="364" char_id="-1" frame_id="-1" name="" text="揉，揉，揉。" voices=""/><msg @l="366" char_id="1" frame_id="-1" name="玲" text="『啊……！』" voices=""/><msg @l="368" char_id="-1" frame_id="-1" name="朽木"   text="『嗯……？怎么了，有感觉了吗？』" voices=""/><msg @l="370" char_id="-1" frame_id="-1" name="朽木"   text="『明明很抗拒却还是有感觉，你真是个淫荡的女人啊。』" voices=""/><msg @l="372" char_id="1" frame_id="-1" name="玲" text="『我、我才不是……』"   voices=""/><msg @l="374" char_id="-1" frame_id="-1" name="朽木"   text="『嘛，有这么好的身材，肯定有很多男人围着你转吧。是不是玩弄男人于股掌之间，享尽好处呢？』"   voices=""/><msg @l="376" char_id="-1" frame_id="-1" name=""   text="朽木一边奸笑着，一边用手指更加用力地挤压着她的私密肉体。" voices=""/><msg @l="378" char_id="1" frame_id="-1" name="玲"   text="『我……我不是那种女人……唔唔……！』" voices=""/><msg @l="380" char_id="-1" frame_id="-1" name="朽木"   text="『呵呵呵……那么……差不多该尝尝你的味道了。』" voices=""/><msg @l="382" char_id="1" frame_id="-1" name="玲" text="『啊！？』" voices=""/><msg @l="384" char_id="-1" frame_id="-1" name="朽木"   text="『来，把手放在那边的墙上，把屁股转过来。』" voices=""/><msg @l="386" char_id="1" frame_id="-1" name="玲" text="『……唔……。』" voices=""/><msg @l="388" char_id="-1" frame_id="-1" name="朽木"   text="『怎么了？不快点的话，我可就不给你写推荐信了哦？』" voices=""/><msg @l="390" char_id="1" frame_id="-1" name="玲" text="『………不………。』"   voices=""/><msg @l="392" char_id="-1" frame_id="-1" name="朽木" text="『嗯？』" voices=""/><msg @l="394" char_id="1" frame_id="-1" name="玲" text="『我果然不要！』" voices=""/><begin_trans @l="397" time="500"/><clear @l="398" layer="cutin_f"/><clear @l="399" layer="cutin"/><end_trans @l="400"/><msg @l="402" char_id="-1" frame_id="-1" name="朽木" text="『都到这时候了，你在说什么啊。』"   voices=""/><clear @l="405" class="char"/><char @l="407" id="rei" pos="auto" src="rei015"/><msg @l="409" char_id="1" frame_id="-1" name="玲"   text="『没错，我是想进入大黑集团工作！但那是因为我喜欢稻庭先生，想和稻庭先生进入同一家公司！』"   voices=""/><msg @l="411" char_id="1" frame_id="-1" name="玲"   text="『但是，即使靠这种事进了公司，我也无法再像以前那样和稻庭先生相处。』" voices=""/><msg @l="413" char_id="1" frame_id="-1" name="玲" text="『那样的话就完全没有意义了。』"   voices=""/><msg @l="415" char_id="1" frame_id="-1" name="玲"   text="『所以我不需要您的推荐信。那么，失礼了！』" voices=""/><msg @l="417" char_id="-1" frame_id="-1" name="朽木"   text="『……呵呵呵。你的行动真是如我所料。』" voices=""/><msg @l="419" char_id="1" frame_id="-1" name="玲" text="『这是什么意思！？』"   voices=""/><msg @l="421" char_id="-1" frame_id="-1" name="朽木"   text="『没什么，只是像你这样高傲的女人，我就知道最后肯定会拒绝，结果真被我说中了。不禁笑出声来而已。』"   voices=""/><msg @l="423" char_id="1" frame_id="-1" name="玲"   text="『什！？……哼，您爱怎么想就怎么想吧，总之我这就告辞了。』" voices=""/><msg @l="425" char_id="-1" frame_id="-1" name="朽木"   text="『嘛，等等，白石君。在离开房间之前看看这张照片如何？』" voices=""/><msg @l="427" char_id="1" frame_id="-1" name="玲" text="『……照片？』"   voices=""/><clear @l="430" class="char"/><char @l="432" id="rei" pos="center" src="rei015f" y="-80"/><msg @l="434" char_id="1" frame_id="-1" name="玲" text="『…………。』"   voices=""/><msg @l="436" char_id="1" frame_id="-1" name="玲"   text="『这、这是！您从哪里弄到这种东西的！？』" voices=""/><msg @l="438" char_id="-1" frame_id="-1" name=""   text="他拿出的照片，正是前几天在大黑集团以检查为名被迫进行性骚扰接待时的画面。" voices=""/><msg @l="440" char_id="-1" frame_id="-1" name="朽木"   text="『拍得不错吧？如果大家知道连校花都被选上的你竟然做这种事，会怎么想呢？』" voices=""/><msg @l="442" char_id="1" frame_id="-1" name="玲" text="『啊！？』" voices=""/><msg @l="444" char_id="-1" frame_id="-1" name="朽木"   text="『呵呵呵……要不要我多洗几张这照片，散布到你所在的网球社呢。那样的话，你最喜欢的稻庭君也能看到了吧？』"   voices=""/><msg @l="446" char_id="1" frame_id="-1" name="玲"   text="『那、那种事请绝对不要做！如果那样的话我、我没法活下去了！』" voices=""/><msg @l="448" char_id="-1" frame_id="-1" name="朽木"   text="『……那么，你应该明白了吧。手扶墙，屁股朝这边。』" voices=""/><msg @l="450" char_id="1" frame_id="-1" name="玲" text="『那、那个是……。』"   voices=""/><msg @l="452" char_id="-1" frame_id="-1" name="朽木"   text="『现在，如果你拒绝，这张照片就会散布到整个校园，当然，稻庭君也会知道。但是，如果让我抱你，我不仅会还给你这张照片，还会给你推荐信。』"   voices=""/><msg @l="453" char_id="-1" frame_id="-1" name="朽木"   text="『对你来说应该是百利而无一害的提议吧？』" voices=""/><msg @l="455" char_id="-1" frame_id="-1" name=""   text="确实如果失去一切的话，也许只要再忍一次就好了。但是，如果要被自己厌恶的朽木教授抱的话，自然而然地会产生排斥反应。"   voices=""/><msg @l="457" char_id="-1" frame_id="-1" name="朽木"   text="『你已经只剩下一条路可选了。放弃吧。』" voices=""/><msg @l="459" char_id="-1" frame_id="-1" name=""   text="说着，朽木将玲推向墙壁。" voices=""/><se @l="463" buf="1" src="人とぶつかる音" volume="1."/><msg @l="465" char_id="-1" frame_id="-1" name="" text="咚！" voices=""/><msg @l="467" char_id="1" frame_id="-1" name="玲" text="『呀！』" voices=""/><msg @l="469" char_id="-1" frame_id="-1" name=""   text="玲被朽木推着，不由自主地双手撑在墙上，做出翘起臀部的姿势。" voices=""/><msg @l="471" char_id="1" frame_id="-1" name="玲" text="『啊！！』" voices=""/><msg @l="473" char_id="-1" frame_id="-1" name="朽木"   text="『呵呵呵……如果你敢把手从墙上拿开，我就散布这张照片。不想的话就乖乖别动。』" voices=""/><msg @l="475" char_id="-1" frame_id="-1" name=""   text="听到这话，玲动弹不得。虽然被朽木抱很可怕，但更不想照片被散布出去。" voices=""/><clear @l="481" class="all"/><msg @l="483" char_id="-1" frame_id="-1" name=""   text="确认玲双手撑在墙上不再反抗后，朽木隔着职业套装抓住她的胸部，试图脱掉她的衬衫露出胸部。"   voices=""/><msg @l="485" char_id="1" frame_id="-1" name="玲" text="『不要啊！』" voices=""/><msg @l="487" char_id="-1" frame_id="-1" name=""   text="玲本能地想把手从墙上拿开逃走，但朽木用言语制止了她。" voices=""/><msg @l="489" char_id="-1" frame_id="-1" name="朽木"   text="『我应该说过不要动吧。如果不想照片被散布出去，就乖乖地别动。』" voices=""/><msg @l="491" char_id="1" frame_id="-1" name="玲" text="『呜呜！』" voices=""/><msg @l="493" char_id="-1" frame_id="-1" name=""   text="因为朽木的话，玲失去了抵抗的力气。朽木随即以熟练的手法解开了玲衬衫的纽扣，将黑色胸罩拉开，从胸前露出了白皙的乳房。"   voices=""/><msg @l="494" char_id="-1" frame_id="-1" name=""   text="被暴露出来的玲那形状优美丰满的乳房，描绘出优美的曲线，顶端部分点缀着如同粉色樱桃般的乳头。"   voices=""/><msg @l="496" char_id="1" frame_id="-1" name="玲" text="『啊啊！』" voices=""/><msg @l="498" char_id="-1" frame_id="-1" name="朽木"   text="『呵呵，白石君的胸部果然很大啊。每次看到你打网球时，运动服下这对大胸部在晃动，我都在想什么时候能这样揉一揉它们。』"   voices=""/><msg @l="500" char_id="-1" frame_id="-1" name=""   text="朽木眼中闪烁着欲望的光芒，紧紧抓住揉捏着。" voices=""/><msg @l="501" char_id="-1" frame_id="-1" name=""   text="然后，他将那骄傲地挺立着的乳头含入口中，像婴儿一样用力吮吸，同时用舌尖轻轻拨弄。"   voices=""/><msg @l="503" char_id="1" frame_id="-1" name="玲" text="『啊啊，嗯！』" voices=""/><msg @l="505" char_id="-1" frame_id="-1" name="朽木"   text="『呵呵，看来敏感度很高嘛。』" voices=""/><msg @l="507" char_id="-1" frame_id="-1" name=""   text="当他一边揉捏着富有弹性的乳房一边继续用舌头挑逗时，起初像软糖般柔软的乳头逐渐充血变硬，最终形成了一个淫靡的坚挺顶端。"   voices=""/><msg @l="509" char_id="1" frame_id="-1" name="玲" text="『啊呜！』" voices=""/><msg @l="511" char_id="-1" frame_id="-1" name=""   text="不久，揉捏胸部的手松开了，朽木绕到玲的臀部前方，隔着内裤开始爱抚她的私密处。" voices=""/><msg @l="513" char_id="1" frame_id="-1" name="玲" text="『不要！那里不行！！』"   voices=""/><msg @l="515" char_id="-1" frame_id="-1" name=""   text="玲本能地想要并拢双腿，但朽木反而抓住她的膝盖将其分开。接着他掀起紧身裙，熟练地拉下黑色内裤，露出了她的私处。"   voices=""/><msg @l="517" char_id="1" frame_id="-1" name="玲" text="『啊，不要看，请不要看！！』"   voices=""/><msg @l="519" char_id="-1" frame_id="-1" name=""   text="玲因为极度羞耻，眼角泛着泪光祈求着。" voices=""/><msg @l="521" char_id="-1" frame_id="-1" name="朽木"   text="『这就是校花的私处吗……这条缝隙鲜艳的粉色真漂亮啊。太令人受不了了……微微隆起的阴蒂也显得很优雅。』"   voices=""/><msg @l="523" char_id="-1" frame_id="-1" name=""   text="说着，他分开她的私密缝隙，伸进手指，触碰着阴蒂。" voices=""/><msg @l="525" char_id="1" frame_id="-1" name="玲" text="『呀啊！那种地方，不要摸啊！！』"   voices=""/><msg @l="527" char_id="-1" frame_id="-1" name=""   text="玲因为自己的性器官被如此描述以及私处被玩弄的感觉，羞耻得脸变得通红。" voices=""/><msg @l="529" char_id="-1" frame_id="-1" name="朽木" text="『不乖的话，就这样。』"   voices=""/><flash @l="532" count="4" fade="100" image="white"/><se @l="535" buf="1" src="尻を叩く" volume="1."/><msg @l="537" char_id="-1" frame_id="-1" name=""   text="突然，朽木啪地一巴掌打在玲的臀部上。" voices=""/><msg @l="538" char_id="-1" frame_id="-1" name="" text="清脆的声音在教授室内回响。"   voices=""/><msg @l="540" char_id="1" frame_id="-1" name="玲" text="『啊！』" voices=""/><msg @l="542" char_id="-1" frame_id="-1" name="朽木"   text="『呵呵呵……外面走廊上也可能听得到哦。』" voices=""/><flash @l="545" count="4" fade="100" image="white"/><se @l="548" buf="1" src="尻を叩く" volume="1."/><msg @l="550" char_id="-1" frame_id="-1" name=""   text="又一次，清脆的声音回响着。确实有可能传到外面去。" voices=""/><msg @l="552" char_id="1" frame_id="-1" name="玲" text="『不，不要！我会乖乖的！』"   voices=""/><msg @l="554" char_id="-1" frame_id="-1" name=""   text="朽木确认玲变得温顺后，将脸埋入她的双腿之间。随后用舌尖舔舐她羞耻的缝隙，吮吸着阴蒂。"   voices=""/><msg @l="556" char_id="1" frame_id="-1" name="玲" text="『呃，啊啊！！』" voices=""/><msg @l="558" char_id="-1" frame_id="-1" name=""   text="朽木将脸贴在她的私处，沉浸在恍惚的感觉中，吸入那隐秘的香气。" voices=""/><msg @l="559" char_id="-1" frame_id="-1" name=""   text="淫欲的馥郁香气强烈刺激着朽木的鼻腔，仿佛要麻痹他的理智。" voices=""/><msg @l="561" char_id="-1" frame_id="-1" name="朽木"   text="『真是淫荡的味道。下体的气味浓烈扑鼻啊。』" voices=""/><msg @l="563" char_id="-1" frame_id="-1" name=""   text="玲因这羞辱的行为从脸颊红到耳朵，咬着嘴唇忍耐着。" voices=""/><msg @l="565" char_id="-1" frame_id="-1" name=""   text="朽木用力使舌尖变尖，插入那狭窄的蜜壶。美妙的酸味让他的舌尖微微麻痹。" voices=""/><msg @l="567" char_id="-1" frame_id="-1" name="朽木"   text="『不必那么忍耐，可以放心地沉浸在快感中啊。反正都要被侵犯了，白石君也感到舒服一点不是更好吗？』"   voices=""/><msg @l="569" char_id="-1" frame_id="-1" name=""   text="朽木用舌头舔得她的秘裂湿漉漉的。然而，爱液却迟迟不从蜜口渗出。" voices=""/><msg @l="571" char_id="1" frame_id="-1" name="玲"   text="『谁，谁会因为你这种爱抚而感到舒服啊！我只是为了拿回照片才勉强忍耐的！老实说只觉得恶心而已！！』"   voices=""/><msg @l="573" char_id="-1" frame_id="-1" name="朽木"   text="『是吗，我这么说是为了你着想啊。不过我也喜欢插入没有湿润的下面，所以无所谓了。』" voices=""/><msg @l="575" char_id="-1" frame_id="-1" name=""   text="说着，朽木从裤子里掏出阴茎，摩擦着玲的秘裂。" voices=""/><msg @l="577" char_id="1" frame_id="-1" name="玲" text="『嘶……。』" voices=""/><msg @l="579" char_id="-1" frame_id="-1" name=""   text="玲感受到秘部触碰到的热度，双手撑着墙回头看去。看到朽木胯下耸立的东西后，再次被恐惧感笼罩。"   voices=""/><msg @l="580" char_id="-1" frame_id="-1" name=""   text="然而，她想着被散布照片比这更糟……于是决定忍耐。" voices=""/><msg @l="582" char_id="-1" frame_id="-1" name="朽木"   text="『呵呵，那就让我好好品尝一下吧。』" voices=""/><msg @l="584" char_id="-1" frame_id="-1" name="" text="然后———。" voices=""/><msg @l="585" char_id="-1" frame_id="-1" name=""   text="朽木将肉棒前端抵在尚未湿润的秘裂上。" voices=""/><msg @l="587" char_id="1" frame_id="-1" name="玲" text="『呀啊……。』" voices=""/><msg @l="589" char_id="-1" frame_id="-1" name="朽木" text="『已经，来不及了。』" voices=""/><msg @l="591" char_id="-1" frame_id="-1" name=""   text="说着，朽木抓住试图逃跑的玲的腰，将肉棒刺入了她的秘裂。" voices=""/><stopbgm @l="595" fadeout="1000"/><clear @l="601" class="all"/><label @l="604" id="event_scene45"/><msgshow @l="607" show="true"/><label @l="611" id="chart_line28"/><wait_chgmv/><ev @l="615" src="ev-045"/><description @l="618" text="望まない取り引きＡ"/><bgm @l="622" src="bgm14" volume="1."/><msg @l="624" char_id="1" frame_id="-1" name="玲" text="『唔嗯……痛！！』"   voices="rei01310"/><msg @l="626" char_id="-1" frame_id="-1" name=""   text="插入的瞬间，由于秘部没有润湿，玲的表情因痛苦而扭曲。" voices=""/><msg @l="628" char_id="1" frame_id="-1" name="玲"   text="『呃啊……好痛！！再，慢一点………。』" voices="rei01320"/><msg @l="630" char_id="-1" frame_id="-1" name=""   text="仿佛无法忍受贯穿秘部的剧痛，玲带着悔恨的表情恳求道。" voices=""/><msg @l="632" char_id="-1" frame_id="-1" name="朽木"   text="『呵呵，疼痛是因为没湿所以理所当然的。这可是你自己希望的啊。』" voices=""/><msg @l="634" char_id="-1" frame_id="-1" name=""   text="朽木浮现出邪恶的笑容，用肉枪撑开了尚未润湿的秘裂。" voices=""/><msg @l="636" char_id="1" frame_id="-1" name="玲" text="『嗯啊！！好痛……好痛啊』"   voices="rei01340"/><msg @l="638" char_id="-1" frame_id="-1" name="朽木"   text="『不过如果你真的坚持的话，应该有请求的方式吧？难道不应该说'请再慢一点'吗？』" voices=""/><msg @l="640" char_id="1" frame_id="-1" name="玲" text="『………。』"   voices="rei01330"/><msg @l="642" char_id="-1" frame_id="-1" name=""   text="由于痛苦，玲的腰肢仿佛在挑逗般扭动着，逐渐增加了朽木的欲望。" voices=""/><msg @l="644" char_id="-1" frame_id="-1" name="朽木"   text="『我倒是无所谓啊？就这样继续也行。』" voices=""/><msg @l="646" char_id="-1" frame_id="-1" name=""   text="每次用肉棒摩擦干涩的阴道壁，玲都会发出悲痛的声音痛苦地扭动。" voices=""/><msg @l="648" char_id="1" frame_id="-1" name="玲" text="『呃啊！！痛…痛啊。』"   voices="rei01340"/><msg @l="650" char_id="-1" frame_id="-1" name="朽木"   text="『怎么样？想要我继续这样搅动吗？』" voices=""/><msg @l="652" char_id="-1" frame_id="-1" name=""   text="朽木用力地插入肉棒，冲击着子宫。" voices=""/><msg @l="654" char_id="1" frame_id="-1" name="玲"   text="『…慢…一点…求…您…』" voices="rei01350"/><msg @l="656" char_id="-1" frame_id="-1" name="朽木"   text="『这么小的声音我可听不见啊？』" voices=""/><msg @l="658" char_id="1" frame_id="-1" name="玲"   text="『呃…请…慢一…点…』" voices="rei01360"/><msg @l="660" char_id="-1" frame_id="-1" name="朽木"   text="『哦？看来是非常想要我激烈一点啊。』" voices=""/><msg @l="662" char_id="-1" frame_id="-1" name=""   text="当朽木恶意地回应时，他的腰部活塞运动加快，以猛烈的势头摩擦着肉壁。玲的脸因痛苦而扭曲。" voices=""/><msg @l="664" char_id="1" frame_id="-1" name="玲"   text="『请、请慢一点……求求您。』" voices="rei01370"/><msg @l="666" char_id="-1" frame_id="-1" name="朽木"   text="『呵呵……好吧，被这样恳求的话也没办法。』" voices=""/><msg @l="668" char_id="-1" frame_id="-1" name="朽木" text="『那就放慢速度吧。』"   voices=""/><msg @l="670" char_id="-1" frame_id="-1" name=""   text="说着，朽木抽回腰部，改为缓慢的抽送动作。" voices=""/><msg @l="671" char_id="-1" frame_id="-1" name=""   text="即便如此，玲仍然感到剧烈疼痛，全身僵硬得像是被贯穿一般。" voices=""/><msg @l="673" char_id="-1" frame_id="-1" name="朽木"   text="『从一开始就保持这种态度就好了。』" voices=""/><msg @l="675" char_id="-1" frame_id="-1" name="朽木"   text="『女人的存在本来就只是为了处理和缓解男人的性欲。』" voices=""/><msg @l="677" char_id="-1" frame_id="-1" name="朽木"   text="『女人就该被男人的东西贯穿，然后愉悦地呻吟！』" voices=""/><msg @l="679" char_id="1" frame_id="-1" name="玲"   text="『……正因为有像你这样的人，社会才会变坏……呃……』" voices="rei01390"/><msg @l="681" char_id="-1" frame_id="-1" name=""   text="他一边说着强词夺理的道理，一边用阳具像捣药杵一样摩擦着阴道。粘稠的蜜肉在蠕动中收缩着。" voices=""/><msg @l="684" char_id="-1" frame_id="-1" name="朽木"   text="『呵呵，在我面前扭着腰的母猪说什么都没有说服力啊。』" voices=""/><msg @l="685" char_id="1" frame_id="-1" name="玲" text="『嗯嗯……痛……。』"   voices="rei01400"/><msg @l="687" char_id="-1" frame_id="-1" name=""   text="朽木愉快地说着，用肉棒顶撞着子宫口，同时逐渐加快节奏搅动着私处。" voices=""/><msg @l="689" char_id="1" frame_id="-1" name="玲"   text="『嗯，啊……嗯呃……痛……好痛啊……。』" voices="rei01410"/><msg @l="691" char_id="-1" frame_id="-1" name=""   text="男根在尚未充分湿润的肉壶中翻搅着，一次又一次地摩擦。" voices=""/><msg @l="692" char_id="-1" frame_id="-1" name=""   text="玲那含蓄的樱色花唇，被朽木的肉棒撑开到几乎要裂开的程度。" voices=""/><msg @l="694" char_id="1" frame_id="-1" name="玲"   text="『呀啊……嗯，嗯嗯……好痛……。』" voices="rei01420"/><msg @l="696" char_id="-1" frame_id="-1" name=""   text="玲一边漏出痛苦的喘息，一边眼含泪水拼命忍耐着。" voices=""/><msg @l="698" char_id="-1" frame_id="-1" name="朽木"   text="『如果不快点湿润起来，你就要一直忍受这种痛苦了。』" voices=""/><msg @l="700" char_id="1" frame_id="-1" name="玲" text="『这种事，我知道……呃啊！！』"   voices="rei01430"/><msg @l="702" char_id="-1" frame_id="-1" name=""   text="就在她想要反驳的瞬间，朽木猛地拉过玲的腰向上顶去。" voices=""/><msg @l="703" char_id="-1" frame_id="-1" name=""   text="玲感觉到龟头撞击在子宫口上，一阵如同电击般的刺激袭来。" voices=""/><msg @l="705" char_id="-1" frame_id="-1" name="朽木"   text="『怎么了？难道说你有感觉了？』" voices=""/><msg @l="707" char_id="-1" frame_id="-1" name=""   text="朽木看着玲的反应，高兴地继续挺动着腰部。" voices=""/><msg @l="709" char_id="1" frame_id="-1" name="玲" text="『啊……嗯，呃……。』"   voices="rei01440"/><msg @l="711" char_id="-1" frame_id="-1" name=""   text="每当朽木挺压腰部时，玲都会漏出短促的喘息，摇晃着头。" voices=""/><msg @l="712" char_id="-1" frame_id="-1" name=""   text="她的头发因汗水而闪亮，贴在皮肤上，散发出一种妖艳的气息。" voices=""/><msg @l="713" char_id="-1" frame_id="-1" name=""   text="看到这一幕的朽木更加兴奋，用肉棒搅动着秘裂，仿佛要顶到敏感部位一般。" voices=""/><msg @l="715" char_id="1" frame_id="-1" name="玲"   text="『嗯啊……嗯，嗯，嗯……。』" voices="rei01450"/><msg @l="717" char_id="-1" frame_id="-1" name=""   text="玲发出呼吸困难般的声音，同时用力抵住墙壁的手。" voices=""/><msg @l="718" char_id="-1" frame_id="-1" name=""   text="每当敏感部位被攻击时，痛苦之外的感觉也随之涌现，她的声音中开始混入与先前不同的喘息。" voices=""/><msg @l="720" char_id="-1" frame_id="-1" name="朽木"   text="『哎呀哎呀，这里很舒服吧？』" voices=""/><msg @l="722" char_id="-1" frame_id="-1" name=""   text="朽木仿佛看穿了玲拼命想要隐藏“那种感觉”的心思，笑了起来。" voices=""/><msg @l="724" char_id="1" frame_id="-1" name="玲" text="『不、不是……嗯………啊呜！！』"   voices="rei01460"/><msg @l="726" char_id="-1" frame_id="-1" name=""   text="她的否认被朽木向上顶撞的腰部动作打断了。" voices=""/><msg @l="727" char_id="-1" frame_id="-1" name=""   text="这种状态下，玲花瓣般的唇中逐渐渗出了蜜液。" voices=""/><msg @l="729" char_id="-1" frame_id="-1" name="朽木"   text="『呵呵……你的身体倒是非常诚实呢？』" voices=""/><msg @l="731" char_id="1" frame_id="-1" name="玲" text="『嗯啊啊！！』"   voices="rei01470"/><msg @l="733" char_id="-1" frame_id="-1" name=""   text="以蜜液的渗出为信号，教授室里开始回响着从玲秘处传出的咕啾咕啾淫靡水声。" voices=""/><msg @l="735" char_id="-1" frame_id="-1" name="朽木"   text="『好了……差不多是时候，让我射进你的阴道里了。』" voices=""/><msg @l="737" char_id="1" frame_id="-1" name="玲" text="『啊……不，不可以射在里面！！』"   voices="rei01480"/><msg @l="739" char_id="-1" frame_id="-1" name="朽木"   text="『请射在里面，求求你了……不是吗？』" voices=""/><msg @l="741" char_id="1" frame_id="-1" name="玲"   text="『不要啊……里面，只有射在里面这点请饶了我吧！！』" voices="rei01490"/><msg @l="743" char_id="-1" frame_id="-1" name="朽木"   text="『那真遗憾啊……明明都做到这一步了，如果连在阴道里接受都做不到的话，我可没法准备推荐信了。』" voices=""/><msg @l="745" char_id="1" frame_id="-1" name="玲"   text="『怎么这样……唔嗯，不要，啊啊啊！！』" voices="rei01500"/><msg @l="747" char_id="-1" frame_id="-1" name=""   text="在朽木激烈的最后冲刺中身体被不断晃动，玲带着悲痛的表情发出了呻吟。这是要摧毁理性，将她拖入快感深渊的做法。"   voices=""/><msg @l="749" char_id="-1" frame_id="-1" name="朽木"   text="『那么该怎么选呢……阴道内还是体外，选择权在你手里哦？』" voices=""/><msg @l="751" char_id="-1" frame_id="-1" name=""   text="朽木一边故意用手掌拍打着雪白的臀部，一边对玲说道。" voices=""/><msg @l="752" char_id="-1" frame_id="-1" name=""   text="当然，不用问这种问题也知道，朽木打算将精液灌入她的子宫内。" voices=""/><msg @l="753" char_id="-1" frame_id="-1" name=""   text="但是，通过让当事人自己决定，这是要彻底撕裂和击溃玲的自尊心的算计。" voices=""/><msg @l="755" char_id="1" frame_id="-1" name="玲" text="『嗯……哈……哈……哈……。』"   voices="rei01510"/><msg @l="757" char_id="-1" frame_id="-1" name="朽木"   text="『那么……阴道内还是体外，我想从你口中清楚地听到答案？』" voices=""/><msg @l="759" char_id="1" frame_id="-1" name="玲" text="『……。』"   voices="rei01520"/><msg @l="761" char_id="1" frame_id="-1" name="玲" text="『……请……射在里面。』"   voices="rei01530"/><msg @l="763" char_id="-1" frame_id="-1" name="朽木"   text="『说得更清楚些。你想要推荐信不是吗？』" voices=""/><msg @l="765" char_id="1" frame_id="-1" name="玲"   text="『射在里面……请把朽木教授的热精液，注入到我的里面！』" voices="rei01540"/><msg @l="767" char_id="-1" frame_id="-1" name="朽木"   text="『呵呵，好吧。被这样恳求也没办法了，我会把它全部灌满到你最深处。』" voices=""/><msg @l="769" char_id="1" frame_id="-1" name="玲" text="『啊，啊，啊……呃啊啊！！』"   voices="rei01550"/><msg @l="771" char_id="-1" frame_id="-1" name=""   text="朽木猛地加大力度摩擦肉壁，龟头仿佛顶到了子宫口。" voices=""/><msg @l="772" char_id="-1" frame_id="-1" name=""   text="玲也不由自主地因为这个动作而紧缩阴道，漏出灼热的喘息。" voices=""/><msg @l="773" char_id="-1" frame_id="-1" name=""   text="朽木加强了抽插运动，像速射炮一样不断埋入肉柱。" voices=""/><msg @l="775" char_id="-1" frame_id="-1" name="朽木" text="『要射了！！』" voices=""/><msg @l="777" char_id="1" frame_id="-1" name="玲" text="『嗯，啊啊啊啊啊！！』"   voices="rei01560"/><flash @l="781" count="4" fade="100" image="white"/><wait_chgmv/><ev @l="785" src="ev-045z1"/><msg @l="787" char_id="1" frame_id="-1" name="玲"   text="『嗯……啊，啊………热的东西……正在流进来………。』" voices="rei01570"/><msg @l="789" char_id="-1" frame_id="-1" name=""   text="感受到注入阴道内的滚烫液体，玲发出悲伤的声音，腰部颤抖着。" voices=""/><msg @l="791" char_id="1" frame_id="-1" name="玲" text="『嗯啊！！』"   voices="rei01580"/><msg @l="793" char_id="-1" frame_id="-1" name="" text="在第几次脉动的时候———。"   voices=""/><msg @l="794" char_id="-1" frame_id="-1" name=""   text="玲的腰猛地弹起，仍在射精的肉棒从秘处滑落。" voices=""/><msg @l="795" char_id="-1" frame_id="-1" name=""   text="即使滑出，仍在喷出的精液洒落在玲白皙圆润的臀部上。" voices=""/><stopbgm @l="799" fadeout="1000"/><clear @l="805" class="all"/><end_scene @l="808"/><wait_chgmv/><bg @l="812" src="bg12"/><bgm @l="816" src="bgm15" volume="1."/><char @l="820" id="kutsu" pos="center" src="kutsu010f" y="-80"/><description @l="823" text="室友的忧郁·第3天"/><msg @l="825" char_id="-1" frame_id="-1" name="朽木"   text="『呵呵呵，我可是尽情享用了。』" voices=""/><msg @l="827" char_id="-1" frame_id="-1" name=""   text="朽木一边用纸巾粗略地擦拭着从玲阴道里滑出的东西，一边满意地说道。" voices=""/><msg @l="829" char_id="1" frame_id="-1" name="玲"   text="『哈……哈……哈………快，约定好的，照片……请还给我……。』" voices=""/><char @l="832" id="kutsu" pos="center" src="kutsu018f" y="-80"/><msg @l="834" char_id="-1" frame_id="-1" name="朽木"   text="『约定？我不记得有什么约定呢？』" voices=""/><msg @l="836" char_id="1" frame_id="-1" name="玲" text="『别，别装傻了！』"   voices=""/><msg @l="838" char_id="1" frame_id="-1" name="玲"   text="『都已经射在里面了……竟然还这样！？』" voices=""/><msg @l="840" char_id="-1" frame_id="-1" name="朽木"   text="『但是，我正在射精的过程中，你却把我的东西拔出来了不是吗？』" voices=""/><msg @l="842" char_id="-1" frame_id="-1" name="朽木"   text="『我都没能把一半射入你的子宫吧？这是违反契约的行为。』" voices=""/><msg @l="844" char_id="1" frame_id="-1" name="玲" text="『这种说法，纯粹是强词夺理！！』"   voices=""/><msg @l="846" char_id="-1" frame_id="-1" name="朽木"   text="『我不是在强词夺理……根据你的行为，判断是否归还照片的人是我，没错吧？』" voices=""/><msg @l="848" char_id="1" frame_id="-1" name="玲" text="『那是……。』" voices=""/><char @l="851" id="kutsu" pos="center" src="kutsu010f" y="-80"/><msg @l="853" char_id="-1" frame_id="-1" name="朽木"   text="『你违背了与我的约定。也就是说这个交易作废了。』" voices=""/><msg @l="855" char_id="-1" frame_id="-1" name="朽木"   text="『话虽如此，我也不是恶魔。就当我射了一半在阴道里吧，推荐信我还是会准备给你的。』" voices=""/><msg @l="857" char_id="-1" frame_id="-1" name="朽木"   text="『但是，照片的事就放弃吧。明天我就把它散布到整个大学。』" voices=""/><clear @l="859" class="char"/><char @l="861" id="rei" pos="auto" src="rei015"/><msg @l="863" char_id="1" frame_id="-1" name="玲"   text="『等、等一下……我再做一次，再做一次可以吧！！』" voices=""/><clear @l="866" class="char"/><char @l="868" id="kutsu" pos="left" src="kutsu010"/><char @l="870" id="rei" pos="right" src="rei015"/><msg @l="872" char_id="-1" frame_id="-1" name="朽木"   text="『已经太迟了。而且如果有多次机会的话，约定就没有意义了。』" voices=""/><char @l="875" id="rei" pos="right" src="rei125"/><msg @l="877" char_id="1" frame_id="-1" name="玲"   text="『怎么会……那，我该怎么办才好……。』" voices=""/><msg @l="879" char_id="1" frame_id="-1" name="玲"   text="『如果那种照片流传开来，我……我……。』" voices=""/><msg @l="881" char_id="-1" frame_id="-1" name="朽木"   text="『嗯……你那么想要回照片吗？』" voices=""/><char @l="884" id="rei" pos="right" src="rei015"/><msg @l="886" char_id="1" frame_id="-1" name="玲" text="『那当然！！』"   voices=""/><msg @l="888" char_id="1" frame_id="-1" name="玲"   text="『如果照片被散布出去……如果被稻庭先生看到的话，我会失去一切的。』" voices=""/><msg @l="890" char_id="-1" frame_id="-1" name="朽木"   text="『是吗，那我再给你一次机会吧。』" voices=""/><char @l="893" id="rei" pos="right" src="rei014"/><msg @l="895" char_id="1" frame_id="-1" name="玲" text="『真、真的吗！？』"   voices=""/><char @l="899" id="kutsu" pos="left" src="kutsu018"/><msg @l="901" char_id="-1" frame_id="-1" name="朽木"   text="『啊……如果你能帮我做我接下来要说的事情……不过嘛。』" voices=""/><msg @l="903" char_id="-1" frame_id="-1" name=""   text="朽木说着，用爬行动物般的眼睛看着玲，露出了阴险的笑容。" voices=""/><msg @l="904" char_id="-1" frame_id="-1" name=""   text="玲从朽木的这番话中看到了救赎，松了一口气。" voices=""/><msg @l="905" char_id="-1" frame_id="-1" name=""   text="她完全没有意识到自己正被他狡猾的计谋所利用———。" voices=""/><stopbgm @l="909" fadeout="1000"/><clear @l="915" class="all"/><msgshow @l="917" show="true"/><wait_chgmv/><bg @l="921" src="bg03b"/><bgm @l="925" src="bgm03" volume="1."/><char @l="929" id="miho" pos="auto" src="miho136"/><msg @l="931" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="933" char_id="-1" frame_id="-1" name=""   text="晚上，我一个人在客厅里，一边等待还没回来的玲小姐，一边犹豫是否该准备晚餐。" voices=""/><msg @l="934" char_id="-1" frame_id="-1" name="" text="今天的晚饭轮到玲小姐负责。"   voices=""/><msg @l="935" char_id="-1" frame_id="-1" name=""   text="我不想因为她回来晚而擅自准备晚餐，然后又引起尴尬。" voices=""/><msg @l="936" char_id="-1" frame_id="-1" name=""   text="但是……只是什么都不做，单纯等待玲小姐回来，这样做也让我犹豫不决。" voices=""/><msg @l="938" char_id="0" frame_id="-1" name="美帆" text="(该怎么办呢……)"   voices=""/><char @l="942" id="rei" pos="auto" src="rei115"/><bgm @l="946" src="bgm05" volume="1."/><msg @l="948" char_id="1" frame_id="-1" name="玲" text="『我回来了。』" voices=""/><clear @l="951" class="char"/><char @l="953" id="rei" pos="left" src="rei115"/><char @l="956" id="miho" pos="right" src="miho034"/><msg @l="958" char_id="0" frame_id="-1" name="美帆" text="『啊……欢、欢迎回来。』"   voices=""/><char @l="961" id="miho" pos="right" src="miho136"/><msg @l="963" char_id="-1" frame_id="-1" name=""   text="夜已经很深了，玲小姐终于回来了。" voices=""/><msg @l="964" char_id="-1" frame_id="-1" name=""   text="我像早上一样试探性地观察着玲小姐的状态。" voices=""/><msg @l="965" char_id="-1" frame_id="-1" name=""   text="期待着玲小姐的心情能比早上好哪怕一点点。" voices=""/><char @l="969" id="rei" pos="left" src="rei125"/><msg @l="971" char_id="1" frame_id="-1" name="玲" text="『………………………。』"   voices=""/><msg @l="973" char_id="-1" frame_id="-1" name=""   text="但是，和早上一样，还是没有得到回应。" voices=""/><char @l="977" id="miho" pos="right" src="miho035"/><msg @l="979" char_id="0" frame_id="-1" name="美帆" text="『啊………。』"   voices=""/><char @l="983" id="rei" pos="left" src="rei115"/><msg @l="985" char_id="1" frame_id="-1" name="玲" text="『我，先去休息了……。』"   voices=""/><clear @l="988" layer="rei"/><msg @l="989" char_id="-1" frame_id="-1" name=""   text="玲说完这句话就立刻进了自己的房间。" voices=""/><msg @l="991" char_id="0" frame_id="-1" name="美帆" text="『晚、晚安……。』"   voices=""/><msg @l="993" char_id="-1" frame_id="-1" name=""   text="不过，感觉和早上有些不同。玲小姐的脸色苍白，看起来非常疲惫。" voices=""/><clear @l="998" class="char"/><stopbgm @l="1003" fadeout="1000"/><clear @l="1009" class="all"/><call @l="1013" target="EventLabel_133@root_rei04"/><return @l="1014" value="0&#13;&#10;"/><return @l="1017" value=""/></code></xscript>																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																		