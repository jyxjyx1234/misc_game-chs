<?xml version="1.0" encoding="utf-8"?><xscript><debug editor="&quot;C:\Program&#32;Files&#32;(x86)\sakura\sakura.exe&quot;&#32;&quot;%src%&quot;&#32;-Y=%line%"   src="D:\シロップ\町ぐるみの罠＋汚された夏セット版\汚された夏\完成データ\汚された夏\script\text\ending08.txt"/><code><label @l="12" id="EventLabel_46"/><description @l="16" text="高级会所女郎，美帆"/><eval @l="18" expr="f.numDay=0&#13;&#10;"/><wait_chgmv/><bg @l="24" src="bg18a"/><msg @l="27" char_id="-1" frame_id="-1" name="" text="———数月后" voices=""/><char @l="31" id="miho" pos="auto" src="miho124"/><bgm @l="35" src="bgm02" volume="1."/><msg @l="37" char_id="0" frame_id="-1" name="美帆" text="『糟，要迟到了！』"   voices="miho11750"/><char @l="40" id="miho" pos="auto" src="miho120"/><msg @l="42" char_id="-1" frame_id="-1" name=""   text="我眼看就要迟到了，正急匆匆地赶往工作场所。" voices=""/><msg @l="43" char_id="-1" frame_id="-1" name="" text="距离那时已经过去好几个月了。"   voices=""/><msg @l="44" char_id="-1" frame_id="-1" name=""   text="在朽木教授的介绍下开始工作的我，为了家人拼命地赚钱，一直不停地努力着。" voices=""/><wait_chgmv/><bg @l="47" src="black"/><clear @l="49" class="char"/><msg @l="52" char_id="-1" frame_id="-1" name="" text="但是……不知从何时起。"   voices=""/><msg @l="53" char_id="-1" frame_id="-1" name=""   text="我开始感到工作是件快乐的事。" voices=""/><msg @l="54" char_id="-1" frame_id="-1" name=""   text="最初，我过着白天去大学、晚上去工作的双重生活，但渐渐地变得只顾着工作……不知不觉中，我已经不再去大学了——"   voices=""/><clear @l="61" class="all"/><msgshow @l="63" show="true"/><label @l="67" id="event_scene26"/><msg @l="69" char_id="-1" frame_id="-1" name=""   text="今天，我又一次走进了工作的地方，那座高级酒店。" voices=""/><msg @l="71" char_id="0" frame_id="-1" name="美帆" text="『早上好~』"   voices="miho11760"/><msg @l="73" char_id="-1" frame_id="-1" name=""   text="我精神饱满地向酒店前台的姐姐打招呼。" voices=""/><msg @l="74" char_id="-1" frame_id="-1" name=""   text="自从开始这份工作以来，我好像变得比过去内向的时候开朗多了。" voices=""/><msg @l="75" char_id="-1" frame_id="-1" name=""   text="现在我认为……这也是因为现在的工作是我的天职。" voices=""/><msg @l="77" char_id="-1" frame_id="-1" name="向导"   text="『美帆，已经有指名你的客人了，请赶快准备一下哦~』" voices=""/><msg @l="79" char_id="0" frame_id="-1" name="美帆" text="『好的~』"   voices="miho11770"/><msg @l="81" char_id="-1" frame_id="-1" name=""   text="这是这座城镇里唯一被允许营业的高级浴场。" voices=""/><msg @l="82" char_id="-1" frame_id="-1" name="" text="这就是我现在的工作场所。"   voices=""/><msg @l="83" char_id="-1" frame_id="-1" name=""   text="当我开始在这里工作时，朽木教授第一次向我讲述了这座城镇的计划。" voices=""/><stopbgm @l="85" fadeout="1000"/><msg @l="87" char_id="-1" frame_id="-1" name=""   text="为什么这座城镇里只有一家风俗店，而且客人甚至完全不用付钱……" voices=""/><wait_chgmv/><bg @l="90" src="bg23a"/><msg @l="92" char_id="-1" frame_id="-1" name=""   text="事实上，在这个南总町，正在推进将整个城镇变成一个巨大的性欲处理场的计划。这是为了一举改善人口减少和城镇经济恶化而制定的计划。"   voices=""/><msg @l="93" char_id="-1" frame_id="-1" name=""   text="被引进的企业只要出示员工证就可以免费获得性服务，作为回报，企业将为当地带来巨大的经济效益。"   voices=""/><msg @l="94" char_id="-1" frame_id="-1" name=""   text="已经有多家大企业决定进驻，城镇中各种商店和住宅的女性都开始拥有了夜晚的另一面……" voices=""/><msg @l="95" char_id="-1" frame_id="-1" name="" text="不过，也有些人喜欢“风俗”这个词的感觉。"   voices=""/><msg @l="96" char_id="-1" frame_id="-1" name=""   text="据说为了这些喜欢风俗的人，这家店有一套不需要支付费用也能玩乐的系统——" voices=""/><wait_chgmv/><bg @l="99" src="black"/><msg @l="101" char_id="-1" frame_id="-1" name=""   text="不过现在，这些理由已经无关紧要了。" voices=""/><msg @l="102" char_id="-1" frame_id="-1" name=""   text="最初对出卖身体这种行为感到厌恶……但通过身体的交融开始感受到幸福，也喜欢上了做爱。"   voices=""/><msg @l="103" char_id="-1" frame_id="-1" name=""   text="现在因为能够提供像恋人一样的甜蜜服务，美帆成为了人气第一的女孩。" voices=""/><clear @l="110" class="all"/><msg @l="113" char_id="-1" frame_id="-1" name=""   text="今天也有专程来找美帆的常客到访，开始与美帆做爱。" voices=""/><msg @l="114" char_id="-1" frame_id="-1" name=""   text="今天美帆的服装是根据对方的喜好选择的，胸部布料缺失、乳房裸露的旗袍。" voices=""/><bgm @l="118" src="bgm04" volume="1."/><msg @l="120" char_id="0" frame_id="-1" name="美帆"   text="『风间大叔～，三天没联系，我好想你啊～。来和美帆亲亲～。』" voices=""/><msg @l="122" char_id="-1" frame_id="-1" name=""   text="美帆说着小恶魔般的话语，突然夺取了风间的嘴唇。柔软光滑的舌头在风间的口中游走。" voices=""/><msg @l="124" char_id="0" frame_id="-1" name="美帆" text="『嗯哈……嗯，嗯嗯！』"   voices=""/><msg @l="126" char_id="-1" frame_id="-1" name=""   text="………风间是一家商社的社长，年龄已超过50岁，他在光顾高级风俗店时指名了美帆，并对她十分中意，成为了每周来访约三次的常客………"   voices=""/><msg @l="128" char_id="-1" frame_id="-1" name=""   text="风间也配合着美帆的动作，与她的舌头交缠，品尝着她口中的感觉。" voices=""/><msg @l="129" char_id="-1" frame_id="-1" name=""   text="美帆用舌头细致地舔遍风间口腔的每一个角落，脸颊泛红地离开了他的嘴唇。" voices=""/><msg @l="131" char_id="0" frame_id="-1" name="美帆"   text="『呼啊～风间大叔，您的吻技真棒呢。』" voices=""/><msg @l="133" char_id="-1" frame_id="-1" name="风间大叔"   text="『美帆的嘴唇还是一如既往地美味啊。』" voices=""/><msg @l="135" char_id="-1" frame_id="-1" name=""   text="风间这样说着，轻舔了一下美帆的嘴唇，然后从下巴一直亲到脖子，随即又将舌头滑向她锁骨的凹陷处。" voices=""/><msg @l="137" char_id="0" frame_id="-1" name="美帆" text="『呜呜，嗯哈啊。』"   voices=""/><msg @l="139" char_id="0" frame_id="-1" name="美帆"   text="『哈啊哈啊哈啊，我真的好开心。大叔，我好喜欢你。』" voices=""/><msg @l="141" char_id="-1" frame_id="-1" name=""   text="美帆紧紧地抱住风间，开始用舌头舔舐他的耳朵。然后用沾满泡沫的双手爱抚着风间的胸部和腰部。" voices=""/><msg @l="142" char_id="-1" frame_id="-1" name=""   text="她还将自己的胸部贴在风间的胸口上，用乳房来回摩擦，为他洗澡。" voices=""/><msg @l="143" char_id="-1" frame_id="-1" name=""   text="在美帆的爱抚下，风间胯下的男根高高耸立。" voices=""/><msg @l="145" char_id="0" frame_id="-1" name="美帆"   text="『哇啊，果然每次看到大叔的都觉得好大啊。』" voices=""/><msg @l="147" char_id="-1" frame_id="-1" name=""   text="美帆用陶醉的眼神看着，用十根手指包裹住风间的肉棒轻轻蠕动。" voices=""/><msg @l="149" char_id="-1" frame_id="-1" name="风间大叔"   text="『那么，先用腿交让我舒服一下吧。』" voices=""/><msg @l="150" char_id="0" frame_id="-1" name="美帆" text="『好的，大叔。』"   voices=""/><msg @l="152" char_id="-1" frame_id="-1" name=""   text="说着美帆用大腿夹住了风间挺立的肉棒。" voices=""/><label @l="156" id="chart_line40"/><wait_chgmv/><ev @l="160" src="ev-026"/><msg @l="163" char_id="0" frame_id="-1" name="美帆"   text="『好厉害……好大……啊。』" voices="miho10950"/><msg @l="165" char_id="-1" frame_id="-1" name=""   text="美帆在大腿和小穴上涂满泡沫后，夹住风间的肉棒，开始扭动腰肢，用秘部摩擦着它。" voices=""/><msg @l="167" char_id="-1" frame_id="-1" name="风间大叔"   text="『哦哦，对，再多摩擦一些。』" voices=""/><msg @l="169" char_id="-1" frame_id="-1" name="" text="说着握住美帆的大腿让她动起来。"   voices=""/><msg @l="171" char_id="0" frame_id="-1" name="美帆" text="『嗯哈……嗯，嗯嗯！』"   voices="miho10960"/><msg @l="173" char_id="-1" frame_id="-1" name="风间大叔"   text="『对了，就这样。用你的小穴夹住我的东西，对了。』" voices=""/><msg @l="175" char_id="0" frame_id="-1" name="美帆" text="『嗯呼……嗯……啊呼。』"   voices="miho10970"/><msg @l="177" char_id="-1" frame_id="-1" name="风间大叔" text="『很好。』"   voices=""/><msg @l="179" char_id="-1" frame_id="-1" name=""   text="美帆感受着风间的肉棒摩擦秘部的触感，快感贯穿全身，她楚楚动人地抓住风间的手按在自己的胸部上。风间一边轻柔地刺激着美帆的乳房，一边用手指刺激着她的乳头。"   voices=""/><msg @l="181" char_id="0" frame_id="-1" name="美帆" text="『嗯，嗯，嗯，嗯嗯！』"   voices="miho10980"/><msg @l="183" char_id="-1" frame_id="-1" name="风间大叔"   text="『美帆，你真可爱。我爱你。』" voices=""/><msg @l="185" char_id="-1" frame_id="-1" name=""   text="说着风间用手轻柔地抚摸着她的大腿、腰部、臀部和胸部，给予她刺激。" voices=""/><msg @l="186" char_id="-1" frame_id="-1" name=""   text="美帆沉醉在风间的话语、手的爱抚以及秘部与肉棒摩擦的感觉中，达到了高潮。" voices=""/><msg @l="188" char_id="0" frame_id="-1" name="美帆"   text="『啊……啊…………不，不行了……………。』" voices="miho07740"/><msg @l="190" char_id="0" frame_id="-1" name="美帆" text="『嗯嗯——————！！』"   voices="miho11030"/><msg @l="192" char_id="0" frame_id="-1" name="美帆" text="『嗯，啊啊啊啊啊啊啊！！』"   voices="miho11040"/><flash @l="196" count="4" fade="100" image="white"/><msg @l="198" char_id="-1" frame_id="-1" name="风间大叔"   text="『呵呵，看来你舒服得去了呢。』" voices=""/><msg @l="200" char_id="0" frame_id="-1" name="美帆" text="『啊……。』"   voices="miho11000"/><msg @l="202" char_id="-1" frame_id="-1" name="风间大叔"   text="『但是，这还没结束呢。我还没去呢。你要自己把我的东西放进你那里。你喜欢我，对吧？』"   voices=""/><msg @l="204" char_id="-1" frame_id="-1" name=""   text="说着风间的手指沿着她的秘缝滑动，促使她进行插入。美帆听到这话脸颊泛红，含着泪的眼睛轻轻地点了点头。" voices=""/><msg @l="206" char_id="0" frame_id="-1" name="美帆" text="『是，是的……。』"   voices="miho12760"/><msg @l="208" char_id="-1" frame_id="-1" name=""   text="然后美帆将肉棒对准自己的秘部，慢慢地沉入阴道中。" voices=""/><wait_chgmv/><ev @l="211" src="ev-026x1"/><msg @l="213" char_id="0" frame_id="-1" name="美帆" text="『嗯嗯——————！！』"   voices="miho11030"/><msg @l="215" char_id="-1" frame_id="-1" name="风间大叔"   text="『怎么样？进到最深处了吗？』" voices=""/><msg @l="217" char_id="0" frame_id="-1" name="美帆"   text="『嗯啊啊……嗯呜……好深，啊。』" voices="miho10990"/><msg @l="219" char_id="-1" frame_id="-1" name="风间大叔"   text="『呵呵，那么这次你试着动一动，让我也舒服起来。』" voices=""/><msg @l="221" char_id="0" frame_id="-1" name="美帆" text="『好，好的……。』"   voices="miho12760"/><msg @l="223" char_id="0" frame_id="-1" name="美帆"   text="『那么，我要慢慢动了哦……。』" voices="miho11800"/><msg @l="225" char_id="-1" frame_id="-1" name=""   text="我抬起旗袍的下摆，让结合处暴露出来，慢慢地开始摆动腰部。" voices=""/><msg @l="226" char_id="-1" frame_id="-1" name=""   text="刚才还在做素股而受到刺激的那里已经湿得泥泞不堪，每当扭动腰肢抽送时，都会发出咕啾咕啾的水声。"   voices=""/><msg @l="228" char_id="0" frame_id="-1" name="美帆"   text="『啊哈……好厉害，都顶到最里面了……嗯，啊啊好大啊。』" voices="miho11810"/><msg @l="230" char_id="-1" frame_id="-1" name=""   text="美帆用秘部的肉褶紧紧缠绕着肉棒，前后左右摆动腰肢，细细品味着肉棒的感觉。" voices=""/><msg @l="231" char_id="-1" frame_id="-1" name=""   text="在这个体位下，只要稍微沉一下腰，龟头就会立刻顶到子宫深处。" voices=""/><msg @l="233" char_id="-1" frame_id="-1" name="风间大叔"   text="『美帆的小穴，好柔软啊……太舒服了。』" voices=""/><msg @l="235" char_id="0" frame_id="-1" name="美帆"   text="『嗯嗯……还不够，还能更舒服的哦～。』" voices="miho11820"/><msg @l="237" char_id="-1" frame_id="-1" name=""   text="说着，美帆扭动腰肢，将那跳动的阴茎吞得更深，然后猛地收紧下体，紧紧地夹住它。" voices=""/><msg @l="239" char_id="-1" frame_id="-1" name="风间大叔"   text="『哦，哦哦……这太厉害了，太厉害了。感觉肉褶都缠上来了。美帆你又变得更会了呢。』" voices=""/><msg @l="241" char_id="0" frame_id="-1" name="美帆"   text="『嗯呵呵……嗯嗯，能让您开心，太好了。』" voices="miho11830"/><msg @l="243" char_id="-1" frame_id="-1" name=""   text="美帆因风间的话语而感到开心，更加用力地收紧阴道夹住肉棒，同时加快了抽送的速度。" voices=""/><msg @l="244" char_id="-1" frame_id="-1" name=""   text="风间则配合着她的动作，用龟头不断摩擦着美帆阴道壁上最敏感的部位。" voices=""/><msg @l="246" char_id="0" frame_id="-1" name="美帆"   text="『啊……啊，啊啊啊……嗯啊。』" voices="miho11020"/><msg @l="248" char_id="-1" frame_id="-1" name=""   text="风间熟悉美帆的敏感点。为了让美帆能和自己一起感受快感，他时不时地挑逗她最敏感的地方。" voices=""/><msg @l="250" char_id="0" frame_id="-1" name="美帆"   text="『啊啊……嗯啊……好深，啊。』" voices="miho10990"/><msg @l="252" char_id="-1" frame_id="-1" name="风间大叔"   text="『还不行哦……美帆，不准比我先高潮。』" voices=""/><msg @l="254" char_id="0" frame_id="-1" name="美帆"   text="『啊……别这么坏嘛，让我去吧……啊。』" voices="miho11850"/><msg @l="256" char_id="-1" frame_id="-1" name="风间大叔"   text="『那么，你要让我更舒服，然后我们一起高潮。』" voices=""/><msg @l="257" char_id="-1" frame_id="-1" name=""   text="听到这话，美帆舌尖舔了舔嘴唇，露出一丝魅惑的表情。" voices=""/><msg @l="259" char_id="0" frame_id="-1" name="美帆"   text="『那么，我要认真起来了哦～。』" voices="miho11860"/><msg @l="262" char_id="-1" frame_id="-1" name=""   text="美帆一改之前的恋人模式，转换为认真让风间高潮的模式。" voices=""/><msg @l="264" char_id="0" frame_id="-1" name="美帆" text="『嗯，嗯嗯……啊啊。』"   voices="miho10940"/><msg @l="266" char_id="0" frame_id="-1" name="美帆" text="『嗯，嗯，嗯嗯！』"   voices="miho11870"/><msg @l="268" char_id="-1" frame_id="-1" name=""   text="我紧紧地吸住阴茎，同时比之前更用力地收缩阴道壁，在风间身上跳动着加快了腰部的动作。"   voices=""/><msg @l="269" char_id="-1" frame_id="-1" name=""   text="于是室内回荡着腰部拍打的声音和咕啾咕啾的淫靡水声，增添了几分情色的气息。" voices=""/><msg @l="270" char_id="-1" frame_id="-1" name=""   text="美帆在激烈地挑逗风间的同时，也没忘记控制着将他的前端抵在自己的敏感点上，好让两人一起达到高潮。"   voices=""/><msg @l="272" char_id="-1" frame_id="-1" name="风间大叔"   text="『哦……好啊美帆，那样真是太棒了！』" voices=""/><msg @l="274" char_id="0" frame_id="-1" name="美帆"   text="『啊啊……我也是，龟头顶到最里面了，嗯嗯……呜啊！！』" voices="miho11880"/><msg @l="276" char_id="-1" frame_id="-1" name="风间大叔"   text="『美帆也很舒服吗？我的东西最棒吧？』" voices=""/><msg @l="278" char_id="0" frame_id="-1" name="美帆"   text="『好……啊，嗯嗯……感觉很舒服，小鸡鸡感觉很舒服。嗯，啊呜！』" voices="miho11890"/><msg @l="280" char_id="-1" frame_id="-1" name=""   text="我用空出的手用力揉搓着发热的乳房，指尖拨弄着更为炙热的乳头。" voices=""/><msg @l="281" char_id="-1" frame_id="-1" name=""   text="每当我这样玩弄自己的乳头时，子宫就会不由自主地颤抖痉挛，更加剧烈地绞紧肉棒。" voices=""/><msg @l="283" char_id="-1" frame_id="-1" name="风间大叔"   text="『差……差不多了……我要射了……。』" voices=""/><msg @l="285" char_id="-1" frame_id="-1" name=""   text="风间发出一声似乎是被榨取般的悲鸣，伴随着阴道壁的蠕动，他颤抖着发出声音并向上顶着腰部。" voices=""/><msg @l="287" char_id="0" frame_id="-1" name="美帆"   text="『嗯嗯，请全部……射在里面哦……嗯嗯……啊啊！』" voices="miho11900"/><msg @l="289" char_id="-1" frame_id="-1" name=""   text="美帆对风间的声音做出反应，像是冲刺一般一口气加快了腰部的动作。" voices=""/><msg @l="291" char_id="0" frame_id="-1" name="美帆"   text="『啊，啊，啊……好，啊啊啊！！』" voices="miho11910"/><msg @l="293" char_id="0" frame_id="-1" name="美帆"   text="『要，要去了……我也，去了……去，去去去……去了啊！！』" voices="miho11920"/><msg @l="295" char_id="-1" frame_id="-1" name="风间大叔" text="『我，我也要去了！！』"   voices=""/><flash @l="299" count="4" fade="100" image="white"/><msg @l="301" char_id="0" frame_id="-1" name="美帆"   text="『啊，啊啊……嗯，啊啊啊！！』" voices="miho11930"/><msg @l="303" char_id="-1" frame_id="-1" name=""   text="紧紧夹住的瞬间，滚烫的汁液咕咚咕咚地喷涌而出。小穴内壁被精液的热度浸透，我不禁颤抖着腰肢达到了高潮。"   voices=""/><msg @l="304" char_id="-1" frame_id="-1" name=""   text="我全身心地沉浸在这快感之中后……疲惫地倚靠在风间的胸膛上。" voices=""/><clear @l="310" class="all"/><msg @l="312" char_id="0" frame_id="-1" name="美帆"   text="『哈啊……哈啊……哈啊……嗯，啊呜………。』" voices="miho11940"/><msg @l="314" char_id="-1" frame_id="-1" name="风间大叔"   text="『呵呵，美帆连续高潮了两次呢。』" voices=""/><msg @l="316" char_id="0" frame_id="-1" name="美帆"   text="『嗯嗯……因为，太舒服了嘛………。』" voices="miho11950"/><msg @l="318" char_id="-1" frame_id="-1" name=""   text="说着，美帆仿佛沉浸在余韵中般亲吻着风间，贪婪地疼爱着他的嘴唇。" voices=""/><msg @l="319" char_id="-1" frame_id="-1" name="" text="美帆在这一刻感到了幸福。"   voices=""/><msg @l="320" char_id="-1" frame_id="-1" name=""   text="直到现在，她几乎很少能感受到“幸福”，但通过这份工作，通过与人交合，她开始能够感受到幸福。这到底是好事还是坏事她不知道，但此刻，她只想沉浸在这份幸福中——。"   voices=""/><stopbgm @l="325" fadeout="1000"/><clear @l="331" class="all"/><end_scene @l="334"/><return @l="340" value=""/></code></xscript>																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																				