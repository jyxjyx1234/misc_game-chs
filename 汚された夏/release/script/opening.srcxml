<?xml version="1.0" encoding="utf-8"?><xscript><debug editor="&quot;C:\Program&#32;Files&#32;(x86)\sakura\sakura.exe&quot;&#32;&quot;%src%&quot;&#32;-Y=%line%"   src="D:\シロップ\町ぐるみの罠＋汚された夏セット版\汚された夏\完成データ\汚された夏\script\text\opening.txt"/><code><label @l="6" id="EventLabel_57"/><eval @l="10" expr="f.痴漢flag&#32;=&#32;0&#13;&#10;"/><eval @l="12" expr="f.名前を知られてるflag&#32;=&#32;0&#13;&#10;"/><eval @l="14" expr="f.訴えるflag&#32;=&#32;0&#13;&#10;"/><eval @l="16" expr="f.サークル見学会flag&#32;=&#32;0&#13;&#10;"/><eval @l="18" expr="f.亜季奈ルート確定flag&#32;=&#32;0&#13;&#10;"/><eval @l="20" expr="f.玲ルート確定flag&#32;=&#32;0&#13;&#10;"/><eval @l="22" expr="f.朽木ルートflag&#32;=&#32;0&#13;&#10;"/><eval @l="24" expr="f.稲庭ルートflag&#32;=&#32;0&#13;&#10;"/><eval @l="26" expr="f.稲庭ルート即席flag&#32;=&#32;0&#13;&#10;"/><eval @l="28" expr="f.亜季奈ルートflag&#32;=&#32;0&#13;&#10;"/><eval @l="30" expr="f.留学生に抵抗したflag&#32;=&#32;0&#13;&#10;"/><eval @l="32" expr="f.水泳勝負flag&#32;=&#32;0&#13;&#10;"/><eval @l="34" expr="f.過去の反芻_中出しflag&#32;=&#32;0&#13;&#10;"/><eval @l="36" expr="f.ご褒美奉仕flag&#32;=&#32;0&#13;&#10;"/><eval @l="38" expr="f.稲庭コーチflag&#32;=&#32;0&#13;&#10;"/><eval @l="40" expr="f._3d_exodus&#32;=&#32;0&#13;&#10;"/><label @l="46" id="EventLabel_58"/><description @l="49" text="开场"/><eval @l="51" expr="f.numDay=0&#13;&#10;"/><msgshow @l="57" show="true"/><goto @l="61" cond="!(s.opening_flag)&#13;&#10;" label="TempLabel_156"/><msg @l="64" async="true" char_id="-1" frame_id="-1" name=""   text="是否观看开场？" voices=""/><select @l="65"><menu @l="67" text="观看"/><menu @l="69" label="TempLabel_157" text="跳过"/></select><goto @l="72" label="TempLabel_323"/><label @l="74" id="TempLabel_157"/><call @l="76" target="EventLabel_19@common_root01"/><return @l="77" value="0&#13;&#10;"/><goto @l="78" label="TempLabel_323"/><label @l="80" id="TempLabel_323"/><label @l="82" id="TempLabel_156"/><label @l="87" id="event_scene54"/><msg @l="89" char_id="-1" frame_id="-1" name="女人的声音" text="『啊呜，嗯，嗯……嗯嗯！』"   voices="rei02240"/><msg @l="91" char_id="-1" frame_id="-1" name=""   text="从被薄暗所笼罩的肮脏公共厕所里传来女人妩媚的声音。" voices=""/><msg @l="92" char_id="-1" frame_id="-1" name=""   text="然后……随着声音此起彼伏地响起含有大量粘液的淫靡水声。" voices=""/><msg @l="93" char_id="-1" frame_id="-1" name="" text="———那是女人被侵犯的声音。"   voices=""/><wait_chgmv/><ev @l="97" src="ev-054"/><bgm @l="101" src="bgm08" volume="1."/><msg @l="103" char_id="-1" frame_id="-1" name="女人"   text="『嗯哈，啊啊……嗯，嗯，嗯，啊呜！！』" voices="rei02270"/><msg @l="105" char_id="-1" frame_id="-1" name=""   text="被肉棒深深贯穿子宫深处，女人发出甜美娇声，腰部颤抖不已。" voices=""/><msg @l="106" char_id="-1" frame_id="-1" name=""   text="男人抓住女人纤细的腰，将白皙的臀部拍打着，更加深入地向上顶去。" voices=""/><msg @l="108" char_id="-1" frame_id="-1" name="女人"   text="『嗯嗯，啊……不行……那里，那样用力顶的话！！』" voices="rei02430"/><msg @l="110" char_id="-1" frame_id="-1" name="男人"   text="『嘿嘿嘿，怎么样？我的肉棒已经顶到子宫了吧？』" voices=""/><msg @l="112" char_id="-1" frame_id="-1" name=""   text="男人一边激烈搅动着滴着蜜液的秘处，脸上浮现出下流的笑容。" voices=""/><msg @l="113" char_id="-1" frame_id="-1" name=""   text="然后，更加激烈地搅动着女人的阴道内部。" voices=""/><msg @l="115" char_id="-1" frame_id="-1" name="女人"   text="『不要……嗯……嗯……那么用力，嗯啊啊！！』" voices="rei02360"/><msg @l="117" char_id="-1" frame_id="-1" name=""   text="仿佛麻痹全部神经的快感，包围了女人，她甜美地扭动着身体。" voices=""/><msg @l="119" char_id="-1" frame_id="-1" name="男人" text="『看好了，要冲刺了。』"   voices=""/><msg @l="121" char_id="-1" frame_id="-1" name=""   text="男人像吐出一口气般说道，加快了腰部的律动。" voices=""/><msg @l="122" char_id="-1" frame_id="-1" name=""   text="每当男根在湿透的蜜处激烈进出，大量的淫液都会溢落到地板上。" voices=""/><msg @l="124" char_id="-1" frame_id="-1" name="女人" text="『嗯，啊啊！！』"   voices="rei02340"/><msg @l="126" char_id="-1" frame_id="-1" name="女人"   text="『还、啊，要去了……去……啊啊啊！！』" voices="rei02300"/><msg @l="128" char_id="-1" frame_id="-1" name=""   text="女人将柔软的身体弯成弓形，发出欢愉的声音，全身颤抖着。" voices=""/><msg @l="129" char_id="-1" frame_id="-1" name=""   text="此时“羞耻”这个词已经不存在于她的脑海中了。" voices=""/><msg @l="130" char_id="-1" frame_id="-1" name=""   text="炽热的双眸已经无法正常映射出自己所处的位置。" voices=""/><msg @l="131" char_id="-1" frame_id="-1" name=""   text="她已经变成了一只只沉醉于被给予的快感中的野兽……。" voices=""/><msg @l="133" char_id="-1" frame_id="-1" name="男人"   text="『嘿……我要把精液全部射进你的阴道里！』" voices=""/><msg @l="135" char_id="-1" frame_id="-1" name="男人" text="『感受到子宫深处吧！！要射了！』"   voices=""/><msg @l="137" char_id="-1" frame_id="-1" name="女人"   text="『还、啊，要去了……去……啊啊啊！！』" voices="rei02300"/><flash @l="141" count="4" fade="100" image="white"/><wait_chgmv/><ev @l="145" src="ev-054z1"/><msg @l="147" char_id="-1" frame_id="-1" name=""   text="就在男人将滚烫的精液射入阴道深处的瞬间，女人也达到了高潮。" voices=""/><msg @l="148" char_id="-1" frame_id="-1" name=""   text="子宫容纳不下的精液顺着女人的腿流下……将地板染成白色。" voices=""/><msg @l="150" char_id="-1" frame_id="-1" name="女人"   text="『嗯……啊，啊………滚烫的……流进来了………。』" voices="rei01570"/><msg @l="152" char_id="-1" frame_id="-1" name="女人"   text="『啊，啊啊……好烫……射了这么多…………。』" voices="rei02390"/><msg @l="154" char_id="-1" frame_id="-1" name=""   text="女人喘着粗气注视着这一切，陶醉地眯起了眼睛……。" voices=""/><stopbgm @l="158" fadeout="1000"/><clear @l="164" class="all"/><end_scene @l="167"/><wait @l="170" time="1000"/><msgshow @l="172" show="true"/><msg @l="175" char_id="-1" frame_id="-1" name="" text="…………………………。"   voices=""/><msg @l="176" char_id="-1" frame_id="-1" name="" text="……………。" voices=""/><msg @l="177" char_id="-1" frame_id="-1" name="" text="………。" voices=""/><se @l="181" buf="3" loop="true" src="電車走行中" volume="1."/><msg @l="183" char_id="-1" frame_id="-1" name=""   text="……已经这样摇晃了多久呢。" voices=""/><msg @l="184" char_id="-1" frame_id="-1" name="" text="舒适的震动奇妙地引诱着睡意。"   voices=""/><msg @l="185" char_id="-1" frame_id="-1" name=""   text="时不时被浅浅的睡意诱惑着做一些梦，但醒来时却记不得梦的内容。" voices=""/><msg @l="186" char_id="-1" frame_id="-1" name=""   text="那是重要的事情，还是无关紧要的事情……当我试图回想起来的时候，睡魔又一次向我袭来。" voices=""/><msg @l="188" char_id="0" frame_id="-1" name="美帆" text="『………。』" voices=""/><msg @l="192" char_id="-1" frame_id="-1" name=""   text="突然，我仿佛要驱散缠绕的睡意一般，透过旁边的窗户仰望天空。" voices=""/><msg @l="193" char_id="-1" frame_id="-1" name="" text="湛蓝晴朗的广阔天空，异常舒适。"   voices=""/><msg @l="195" char_id="0" frame_id="-1" name="美帆" text="(嗯——，好风景……)"   voices=""/><msg @l="197" char_id="0" frame_id="-1" name="美帆"   text="(是错觉吗，感觉这里的天空比东京的更蓝)" voices=""/><msg @l="199" char_id="0" frame_id="-1" name="美帆"   text="(说起来……这里其实是在山里吧？)" voices=""/><msg @l="201" char_id="-1" frame_id="-1" name=""   text="我像是想起什么似的从包里拿出了指南手册。" voices=""/><msg @l="202" char_id="-1" frame_id="-1" name=""   text="三折的宣传册上应该写着关于我今年将要就读的分校以及该分校所在的“南总町（なんそうちょう）”的介绍。"   voices=""/><msg @l="204" char_id="0" frame_id="-1" name="美帆" text="(找到了……)" voices=""/><msg @l="206" char_id="-1" frame_id="-1" name=""   text="在介绍文的一节中，有关“南总町”形成经过的内容，配上了蜡笔画的可爱插图，以故事形式叙述着。" voices=""/><msg @l="207" char_id="-1" frame_id="-1" name=""   text="通过开发连绵山脉环绕的陆地孤岛而诞生的“南总町”。" voices=""/><msg @l="208" char_id="-1" frame_id="-1" name=""   text="虽然四周被小山丘环绕，却拥有都市般功能的现代化小镇。" voices=""/><msg @l="209" char_id="-1" frame_id="-1" name=""   text="据说，那是一个应该称为兼具自然和人工的理想乡的地方。" voices=""/><msg @l="211" char_id="0" frame_id="-1" name="美帆"   text="(理想乡啊……希望是个宜居的地方)" voices=""/><msg @l="213" char_id="-1" frame_id="-1" name=""   text="作为城镇功能实验的一部分，我就读的大学分校大约是在两年前建在了“南总町”。" voices=""/><msg @l="214" char_id="-1" frame_id="-1" name=""   text="从那时起，新增了一项规定，要求在四年学习期间的后两年必须到“南总町”的分校就读。" voices=""/><msg @l="215" char_id="-1" frame_id="-1" name=""   text="而我在今年春天顺利成为三年级学生，因此也就这样开始前往这个理想乡“南总町”求学。" voices=""/><msg @l="217" char_id="-1" frame_id="-1" name="广播"   text="『下一站是终点———南总町站前，南总町站前。』" voices=""/><msg @l="219" char_id="0" frame_id="-1" name="美帆" text="(啊……得下车了)"   voices=""/><stopbgm @l="223" fadeout="1000"/><stopse @l="227" buf="3"/><clear @l="233" class="all"/><wait_chgmv/><bg @l="237" src="bg18m1"/><se @l="241" buf="1" src="電車停車～発進" volume="1."/><char @l="245" id="miho" pos="auto" src="miho010"/><bgm @l="249" src="bgm02" volume="1."/><msg @l="251" char_id="0" frame_id="-1" name="美帆" text="『……呼。』" voices=""/><msg @l="253" char_id="-1" frame_id="-1" name=""   text="我把手中的行李放在脚边，轻轻地叹了口气。" voices=""/><msg @l="254" char_id="-1" frame_id="-1" name=""   text="在有轨电车上摇晃了约一小时……终于抵达了南总町的中心。" voices=""/><msg @l="255" char_id="-1" frame_id="-1" name=""   text="车站前的景象繁华热闹，显得相当都市化，很难想象这是一个被群山环绕的地方。" voices=""/><msg @l="257" char_id="0" frame_id="-1" name="美帆"   text="(呃，首先必须得去大学那边对吧？)" voices=""/><wait_chgmv/><bg @l="261" src="bg21"/><char @l="265" id="miho" pos="auto" src="miho010"/><msg @l="267" char_id="-1" frame_id="-1" name=""   text="稍作休息后，我马上拿起脚边的行李，在车站前排列着的几个有轨电车站台中寻找开往大学前的那一班，然后在那里排队。"   voices=""/><msg @l="268" char_id="-1" frame_id="-1" name=""   text="虽然新学期要到下周初才开始，但因为必须向大学提交转移手续的文件，所以被告知要去校内的事务局。"   voices=""/><msg @l="269" char_id="-1" frame_id="-1" name=""   text="搬家工作加上转移手续，今年的春假看来没有闲暇时间玩乐了。" voices=""/><stopse @l="273" buf="3"/><se @l="277" buf="1" src="電車停車" volume="1."/><msg @l="281" char_id="-1" frame_id="-1" name=""   text="不到五分钟，一辆双节车厢的有轨电车驶入站台前。" voices=""/><msg @l="282" char_id="-1" frame_id="-1" name=""   text="车身设计有种古典风格，但整体制作却给人一种出奇崭新的感觉。" voices=""/><msg @l="283" char_id="-1" frame_id="-1" name=""   text="可能车厢外部是过去行驶的有轨电车的复制品。" voices=""/><char @l="285" id="miho" pos="auto" src="miho110"/><msg @l="286" char_id="0" frame_id="-1" name="美帆"   text="(办完手续，回来后整理房间……大概是这样？)" voices=""/><msg @l="288" char_id="-1" frame_id="-1" name=""   text="我隐约回想起从家里寄送到南总町的行李内容。" voices=""/><msg @l="289" char_id="-1" frame_id="-1" name=""   text="虽然书架和床这类大件物品已经事先由搬家公司的人运进去了，但是后来寄送的小物件还是得自己整理。"   voices=""/><msg @l="290" char_id="-1" frame_id="-1" name=""   text="衣物和生活必需品是不得已的，除此之外，我好像还打包了书籍和CD，还有装饰房间用的挂毯和毛绒玩具。"   voices=""/><char @l="292" id="miho" pos="auto" src="miho016"/><msg @l="293" char_id="0" frame_id="-1" name="美帆"   text="(嗯——……光是整理行李可能就会耗尽假期了)" voices=""/><char @l="297" id="miho" pos="auto" src="miho110"/><msg @l="299" char_id="-1" frame_id="-1" name=""   text="伴随着微弱的叹息，我乘上了开往大学的有轨电车。" voices=""/><clear @l="305" class="all"/><msgshow @l="307" show="true"/><msg @l="309" char_id="-1" frame_id="-1" name="广播"   text="『下一站是终点……大学前，大学前站。』" voices=""/><msg @l="311" char_id="-1" frame_id="-1" name="广播"   text="『请注意不要遗忘随身携带的物品。』" voices=""/><clear @l="317" class="all"/><msgshow @l="319" show="true"/><label @l="323" id="chart_line1"/><wait_chgmv/><ev @l="327" src="ev-001"/><msg @l="329" char_id="0" frame_id="-1" name="美帆" text="『嗯～……风真舒服啊。』"   voices="miho00000"/><msg @l="331" char_id="-1" frame_id="-1" name=""   text="从大学前站一直到办公室的这段路，我一边欣赏着校园的景色一边走着。" voices=""/><msg @l="332" char_id="-1" frame_id="-1" name=""   text="第一次走在校园里，自然是一切都感到新鲜，仿佛自己变成了新生一样。" voices=""/><msg @l="334" char_id="0" frame_id="-1" name="美帆"   text="『美好的邂逅……虽然光靠期待偶然可能是不行的。』" voices="miho00010"/><msg @l="339" char_id="0" frame_id="-1" name="美帆"   text="『但果然，还是会稍微期待一下呢……』" voices="miho00020"/><msg @l="341" char_id="-1" frame_id="-1" name=""   text="微眯着眼睛感受吹拂而过的温暖春风，我独自苦笑着。" voices=""/><msg @l="342" char_id="-1" frame_id="-1" name=""   text="我很清楚自己比别人更加内向害羞。" voices=""/><msg @l="343" char_id="-1" frame_id="-1" name=""   text="总是因为无法变得积极主动而焦躁不安。" voices=""/><msg @l="344" char_id="-1" frame_id="-1" name=""   text="但是，也不可能因此就轻易地变成积极的性格……" voices=""/><msg @l="349" char_id="0" frame_id="-1" name="美帆"   text="『既然环境都变了，应该把它当作机会，努力改变自己才行啊。』" voices="miho00030"/><msg @l="351" char_id="-1" frame_id="-1" name=""   text="新的生活，新的环境……希望这次转学能成为某种契机。" voices=""/><msg @l="352" char_id="-1" frame_id="-1" name=""   text="虽然要立刻改变自己的性格很困难……" voices=""/><msg @l="353" char_id="-1" frame_id="-1" name=""   text="但努力成为新的自己应该是每个人都能做到的。" voices=""/><msg @l="354" char_id="-1" frame_id="-1" name="" text="我只是模糊地想着这样的事情。"   voices=""/><wait_chgmv/><ev @l="358" src="ev-001x2"/><msg @l="360" char_id="0" frame_id="-1" name="美帆"   text="(……话说，我自己在这嘀嘀咕咕什么呢)" voices="miho00040"/><msg @l="362" char_id="-1" frame_id="-1" name=""   text="突然意识到周围行人的目光，我慌忙捂住了嘴。" voices=""/><msg @l="363" char_id="-1" frame_id="-1" name=""   text="不自觉流露出的“期待的微笑”让我感到异常难为情。" voices=""/><msg @l="365" char_id="0" frame_id="-1" name="美帆" text="(赶紧去事务局吧……)"   voices="miho00050"/><msg @l="367" char_id="-1" frame_id="-1" name=""   text="我像是要遮掩发烫的脸颊一般，快步走过校园。" voices=""/><clear @l="373" class="all"/><msg @l="375" char_id="-1" frame_id="-1" name="事务员"   text="『那么，请您在第一天上课时带上印章和保险卡。』" voices=""/><msg @l="377" char_id="0" frame_id="-1" name="美帆" text="『好的，非常感谢。』"   voices=""/><wait_chgmv/><bg @l="381" src="bg07"/><char @l="385" id="miho" pos="auto" src="miho010"/><msg @l="387" char_id="-1" frame_id="-1" name=""   text="处理完办公室简单的手续后，我走出校舍，再次回到了校园。" voices=""/><char @l="391" id="miho" pos="auto" src="miho015"/><msg @l="393" char_id="0" frame_id="-1" name="美帆"   text="(气味……如果洗不掉该怎么办……)" voices=""/><msg @l="395" char_id="-1" frame_id="-1" name=""   text="我嘟囔着切实又率直的抱怨，皱眉嗅着沾在衣服上的烟味。" voices=""/><msg @l="396" char_id="-1" frame_id="-1" name=""   text="转学手续本身不到10分钟就办完了……" voices=""/><msg @l="397" char_id="-1" frame_id="-1" name=""   text="校内唯一的办公室，因为前来办理转学手续的同龄学生而始终嘈杂不堪……" voices=""/><msg @l="398" char_id="-1" frame_id="-1" name=""   text="而且，指定为溢出学生等候区的食堂，禁烟区和吸烟区之间没有任何物理隔断。"   voices=""/><msg @l="399" char_id="-1" frame_id="-1" name=""   text="不巧我是个对烟味很敏感的人，在充满浓烟甚至模糊视线的地方一直等待自己的顺序实在是太痛苦了。"   voices=""/><msg @l="401" char_id="0" frame_id="-1" name="美帆"   text="(唉……为什么不把接待期安排在春假最后三天，而是从春假一开始就安排呢)" voices=""/><msg @l="403" char_id="-1" frame_id="-1" name=""   text="我用手帕按着仍然泛泪的双眼，再次抱怨道。" voices=""/><msg @l="404" char_id="-1" frame_id="-1" name=""   text="明明是为了避开预料中的拥挤，特意选择了受理第一天前来，却没想到第一天就已经是这种状态。"   voices=""/><msg @l="406" char_id="0" frame_id="-1" name="美帆"   text="(算了……光抱怨也没用)" voices=""/><msg @l="408" char_id="0" frame_id="-1" name="美帆"   text="(转学手续已经顺利办完了，就这样吧)" voices=""/><msg @l="410" char_id="-1" frame_id="-1" name=""   text="我用手指按摩似地抚平皱起的眉头，心情稍微放松了些。" voices=""/><msg @l="411" char_id="-1" frame_id="-1" name=""   text="凡事都要积极向上，这是我借此次转学机会为自己立下的目标。" voices=""/><char @l="415" id="miho" pos="auto" src="miho011"/><msg @l="417" char_id="0" frame_id="-1" name="美帆"   text="『嗯嗯，总觉得能变得积极起来的感觉……』" voices=""/><msg @l="422" char_id="-1" frame_id="0" name="" text="「咕噜噜……」" voices=""/><char @l="427" id="miho" pos="auto" src="miho013"/><msg @l="429" char_id="0" frame_id="-1" name="美帆" text="(啊呜……)" voices=""/><msg @l="431" char_id="-1" frame_id="-1" name=""   text="肚子突然咕咕叫了起来，让我不由得面红耳赤。" voices=""/><msg @l="432" char_id="-1" frame_id="-1" name=""   text="看了看表，已经三点多了。" voices=""/><msg @l="433" char_id="-1" frame_id="-1" name=""   text="现在吃午饭有点晚了，但要忍到晚上又还有太多时间。" voices=""/><char @l="437" id="miho" pos="auto" src="miho116"/><msg @l="439" char_id="0" frame_id="-1" name="美帆"   text="(这样的话，在车站前解决了再来会比较好吧……)" voices=""/><msg @l="441" char_id="-1" frame_id="-1" name=""   text="也可以在回家的路上顺便吃个迟来的午餐，再逛逛橱窗，但那样的话，行李就赶不及在晚饭前收拾完了……"   voices=""/><char @l="445" id="miho" pos="auto" src="miho016"/><msg @l="447" char_id="0" frame_id="-1" name="美帆"   text="(不行不行……搬家的行李还没整理好呢)" voices=""/><msg @l="449" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><char @l="453" id="miho" pos="auto" src="miho013"/><msg @l="455" char_id="0" frame_id="-1" name="美帆"   text="(不过……只是稍微看一下的话，应该没关系吧？)" voices=""/><msg @l="457" char_id="-1" frame_id="-1" name=""   text="就这样，在“只看不买”的条件下，刚才的决心很快就动摇了，紧接着，什么转校庆祝礼物啦，乔迁礼物啦，为了重新振作啦，各种各样的理由在脑海中盘旋，为购物找着冠冕堂皇的借口。"   voices=""/><msg @l="459" char_id="-1" frame_id="-1" name="" text="……不管怎样，还是去看看吧。"   voices=""/><char @l="462" id="miho" pos="auto" src="miho011"/><msg @l="464" char_id="0" frame_id="-1" name="美帆"   text="(呵呵……既然这么决定了，得赶紧去车站前才行)" voices=""/><clear @l="470" class="all"/><msg @l="472" char_id="-1" frame_id="-1" name=""   text="我迈着轻快的步伐，朝着公交站点走去。" voices=""/><msg @l="474" char_id="0" frame_id="-1" name="美帆"   text="(嗯，是在这个拐角转弯吧……？)" voices=""/><stopbgm @l="479" fadeout="1000"/><wait_chgmv/><bg @l="484" src="bg07"/><char @l="488" id="rei" pos="auto" src="rei014"/><msg @l="490" char_id="1" frame_id="-1" name="穿西装的女性" text="『……！』" voices=""/><char @l="495" id="miho" pos="auto" src="miho114"/><msg @l="497" char_id="0" frame_id="-1" name="美帆" text="『诶……？』" voices=""/><se @l="501" buf="1" src="人とぶつかる音軽め" volume="1."/><shake @l="505" amp="10" class="all" cycle="30" duration="600" type="random"/><msg @l="507" char_id="0" frame_id="-1" name="美帆" text="『哇哇！？』" voices=""/><msg @l="509" char_id="1" frame_id="-1" name="穿西装的女性" text="『危险……！』"   voices=""/><se @l="513" buf="1" src="人が倒れる音_軽め" volume="1."/><shake @l="517" amp="10" class="all" cycle="30" duration="1000"   type="random"/><clear @l="523" class="all"/><msg @l="525" char_id="0" frame_id="-1" name="美帆" text="『痛痛痛……。』"   voices="miho00060"/><msg @l="527" char_id="-1" frame_id="-1" name=""   text="我与突然出现在视野中的西装女性相撞，当场狼狈地摔了个屁股蹲儿。" voices=""/><label @l="531" id="chart_line2"/><wait_chgmv/><ev @l="535" src="ev-003"/><bgm @l="539" src="bgm05" volume="1."/><msg @l="541" char_id="1" frame_id="-1" name="穿西装的女性" text="『……你没事吧？』"   voices="rei00000"/><msg @l="543" char_id="-1" frame_id="-1" name=""   text="西装女性担忧地俯身看向摔倒的我。" voices=""/><msg @l="544" char_id="-1" frame_id="-1" name=""   text="她那又长又美的秀发随风飘动，散发出淡淡的花香。" voices=""/><msg @l="546" char_id="0" frame_id="-1" name="美帆" text="(哇……好漂亮的人……)"   voices="miho00070"/><msg @l="548" char_id="-1" frame_id="-1" name=""   text="我不由自主地被眼前的女性迷住了。" voices=""/><msg @l="549" char_id="-1" frame_id="-1" name=""   text="冷静沉着、知性、成熟……这些词语都很适合她。" voices=""/><msg @l="551" char_id="0" frame_id="-1" name="美帆"   text="(是四年级的人吧……感觉，氛围什么的完全不一样呢)" voices="miho00080"/><msg @l="553" char_id="1" frame_id="-1" name="穿西装的女性" text="『………。』"   voices="rei00010"/><msg @l="555" char_id="1" frame_id="-1" name="穿西装的女性" text="『你，真的没事吗？』"   voices="rei00020"/><msg @l="557" char_id="0" frame_id="-1" name="美帆" text="『啊？』"   voices="miho00090"/><msg @l="559" char_id="1" frame_id="-1" name="穿西装的女性"   text="『发呆的样子……是不是身体不舒服？ 』" voices="rei00030"/><msg @l="561" char_id="0" frame_id="-1" name="美帆" text="『不、不是……不是这样的！』"   voices="miho00100"/><msg @l="563" char_id="0" frame_id="-1" name="美帆" text="『我只是……那个，呃……。』"   voices="miho00110"/><msg @l="565" char_id="-1" frame_id="-1" name="" text="我突然在这里语塞了。"   voices=""/><msg @l="566" char_id="-1" frame_id="-1" name=""   text="我觉得“看入迷了”这种话不适合对同性说，但一时半会儿又想不出什么巧妙的回应，只能慌慌张张地着急。"   voices=""/><msg @l="568" char_id="1" frame_id="-1" name="穿西装的女性" text="『我只是……？』"   voices="rei00040"/><msg @l="570" char_id="0" frame_id="-1" name="美帆" text="『啊……那个……。』"   voices="miho00120"/><msg @l="572" char_id="0" frame_id="-1" name="美帆"   text="『……对不起，我只是有点走神了。』" voices="miho00130"/><msg @l="574" char_id="1" frame_id="-1" name="穿西装的女性" text="『……。』"   voices="rei00050"/><msg @l="576" char_id="0" frame_id="-1" name="美帆" text="『……对不起。』"   voices="miho00140"/><msg @l="578" char_id="1" frame_id="-1" name="穿西装的女性"   text="『没什么，我不在意。』" voices="rei00070"/><msg @l="580" char_id="1" frame_id="-1" name="穿西装的女性" text="『来……抓住我的手。』"   voices="rei00080"/><clear @l="586" class="all"/><msg @l="588" char_id="-1" frame_id="-1" name=""   text="西装女性露出一副“唉”的表情，随即抓住我的手将我拉了起来。" voices=""/><msg @l="590" char_id="0" frame_id="-1" name="美帆" text="『对、对不起！』"   voices="miho00150"/><msg @l="592" char_id="-1" frame_id="-1" name=""   text="我慌忙捡起掉在旁边的包，几乎是被拉扯着站了起来。" voices=""/><wait_chgmv/><bg @l="596" src="bg07"/><char @l="600" id="miho" pos="left" src="miho015"/><char @l="604" id="rei" pos="right" src="rei010"/><msg @l="606" char_id="1" frame_id="-1" name="穿西装的女性"   text="『怎么样？没受伤吧？』" voices=""/><char @l="610" id="miho" pos="left" src="miho016"/><msg @l="612" char_id="0" frame_id="-1" name="美帆" text="『嗯……我想没事。』"   voices=""/><char @l="616" id="rei" pos="right" src="rei011"/><msg @l="618" char_id="1" frame_id="-1" name="穿西装的女性" text="『是吗，太好了。』"   voices=""/><char @l="622" id="miho" pos="left" src="miho010"/><msg @l="624" char_id="0" frame_id="-1" name="美帆" text="『那个……真的非常抱歉。』"   voices=""/><char @l="628" id="rei" pos="right" src="rei020"/><msg @l="630" char_id="1" frame_id="-1" name="穿西装的女性"   text="『结果还好，我们俩都没事，不是挺好的吗？』" voices=""/><msg @l="632" char_id="-1" frame_id="-1" name=""   text="说着，西装女性略带俏皮地眨了眨眼。" voices=""/><char @l="636" id="miho" pos="left" src="miho111"/><msg @l="638" char_id="-1" frame_id="-1" name=""   text="这个可爱的动作与她干练的外表形成了奇妙的反差，我不由得笑出了声。" voices=""/><char @l="642" id="rei" pos="right" src="rei114"/><msg @l="644" char_id="1" frame_id="-1" name="穿西装的女性"   text="『哎呀……刚才那个，有那么好笑吗？』" voices=""/><char @l="648" id="miho" pos="left" src="miho011"/><msg @l="650" char_id="0" frame_id="-1" name="美帆"   text="『不，我觉得挺好的。让我感到非常亲切。』" voices=""/><char @l="654" id="rei" pos="right" src="rei128"/><msg @l="656" char_id="1" frame_id="-1" name="穿西装的女性"   text="『嗯——总觉得有点不太理解……不过算了。』" voices=""/><msg @l="658" char_id="-1" frame_id="-1" name=""   text="这样说着，西装女性露出了稍微困扰的表情。" voices=""/><msg @l="659" char_id="-1" frame_id="-1" name=""   text="看来她并不像我想象中那么严厉的人。" voices=""/><char @l="663" id="rei" pos="right" src="rei010"/><msg @l="665" char_id="1" frame_id="-1" name="穿西装的女性"   text="『说起来，你是今年刚调到南总町校区的学生吧？』" voices=""/><char @l="669" id="miho" pos="left" src="miho010"/><msg @l="671" char_id="0" frame_id="-1" name="美帆" text="『诶，您能看出来吗？』"   voices=""/><char @l="674" id="miho" pos="left" src="miho016"/><msg @l="676" char_id="1" frame_id="-1" name="穿西装的女性"   text="『一看就是不熟悉环境的样子，很容易看出来哦。』" voices=""/><msg @l="678" char_id="0" frame_id="-1" name="美帆" text="『……抱歉。』"   voices=""/><char @l="682" id="rei" pos="right" src="rei021"/><msg @l="684" char_id="1" frame_id="-1" name="穿西装的女性"   text="『没必要道歉。谁都有刚开始不习惯的时候。』" voices=""/><char @l="688" id="rei" pos="right" src="rei010"/><msg @l="690" char_id="1" frame_id="-1" name="穿西装的女性"   text="『只是……嗯，我可能稍微有点担心。』" voices=""/><char @l="694" id="miho" pos="left" src="miho014"/><msg @l="696" char_id="0" frame_id="-1" name="美帆" text="『担心……吗？』"   voices=""/><msg @l="698" char_id="1" frame_id="-1" name="穿西装的女性" text="『……。』"   voices=""/><msg @l="700" char_id="1" frame_id="-1" name="穿西装的女性"   text="『虽然不想在你刚转学就说些让人不安的事情……但是最近在这附近经常有人目击到可疑的男子。』" voices=""/><char @l="704" id="miho" pos="left" src="miho115"/><msg @l="706" char_id="0" frame_id="-1" name="美帆" text="『可疑的男子……是吗？』"   voices=""/><msg @l="708" char_id="1" frame_id="-1" name="穿西装的女性"   text="『是的。傍晚或晚上……似乎没有固定的时间，他会出现在校园里，然后沉默地盯着某处看。』"   voices=""/><msg @l="710" char_id="1" frame_id="-1" name="穿西装的女性"   text="『目前好像没有什么特别的受害情况……但如果考虑到他可能是变态的话，我想还是多加注意为好。』"   voices=""/><char @l="714" id="miho" pos="left" src="miho010"/><msg @l="716" char_id="0" frame_id="-1" name="美帆" text="『我知道了，我会注意的。』"   voices=""/><clear @l="722" class="all"/><msgshow @l="724" show="true"/><wait_chgmv/><bg @l="728" src="bg07"/><char @l="732" id="miho" pos="left" src="miho010"/><char @l="736" id="rei" pos="right" src="rei011"/><msg @l="738" char_id="1" frame_id="-1" name="穿西装的女性"   text="『那么，我现在要去社团了。』" voices=""/><char @l="742" id="miho" pos="left" src="miho113"/><msg @l="744" char_id="0" frame_id="-1" name="美帆"   text="『呃，谢谢您告诉我这些。』" voices=""/><msg @l="746" char_id="1" frame_id="-1" name="穿西装的女性" text="『我想这也是一种缘分吧。』"   voices=""/><char @l="750" id="rei" pos="right" src="rei111"/><msg @l="752" char_id="1" frame_id="-1" name="穿西装的女性"   text="『下次有机会的话，我们再聊。』" voices=""/><clear @l="756" layer="rei"/><msg @l="758" char_id="-1" frame_id="-1" name=""   text="那位穿西装的女性微笑着说完这些话，迈着优雅的脚步走远了。" voices=""/><msg @l="759" char_id="-1" frame_id="-1" name=""   text="她的背影看起来就像是平面模特或时尚模特一样……" voices=""/><msg @l="760" char_id="-1" frame_id="-1" name=""   text="看着她那美丽的身影，我果然还是不由自主地看呆了一会儿。" voices=""/><char @l="764" id="miho" pos="left" src="miho010"/><msg @l="766" char_id="0" frame_id="-1" name="美帆"   text="(啊……至少应该问一下名字的)" voices=""/><msg @l="768" char_id="-1" frame_id="-1" name=""   text="在她的身影消失在视线中后，我再次朝车站方向走去。" voices=""/><stopbgm @l="772" fadeout="1000"/><clear @l="776" layer="miho"/><clear @l="782" class="all"/><msgshow @l="784" show="true"/><msg @l="786" char_id="-1" frame_id="-1" name="" text="…………………。" voices=""/><msg @l="787" char_id="-1" frame_id="-1" name="" text="………………。" voices=""/><msg @l="788" char_id="-1" frame_id="-1" name="" text="……。" voices=""/><wait_chgmv/><bg @l="792" src="bg18m1"/><bgm @l="796" src="bgm02" volume="1."/><msg @l="798" char_id="0" frame_id="-1" name="美帆" text="(呼……终于，到车站前了……)"   voices=""/><msg @l="800" char_id="0" frame_id="-1" name="美帆"   text="(晚饭……买个便当回去吃好了)" voices=""/><msg @l="802" char_id="-1" frame_id="-1" name=""   text="想着这些事情，我朝着车站前的大型百货商店走去。" voices=""/><msg @l="803" char_id="-1" frame_id="-1" name=""   text="不熟悉的道路果然不好走，差点就被人流冲散了。" voices=""/><msg @l="804" char_id="-1" frame_id="-1" name=""   text="不…就算走在熟悉的路上也可能会被卷入人流中吧……" voices=""/><msg @l="805" char_id="-1" frame_id="-1" name=""   text="就在我这么想的时候……一个人突然从我眼前冲了出来。" voices=""/><char @l="809" id="miho" pos="auto" src="miho114"/><msg @l="811" char_id="0" frame_id="-1" name="美帆" text="『啊……？』" voices=""/><msg @l="813" char_id="-1" frame_id="0" name="" text="「砰！」" voices=""/><se @l="817" buf="1" src="人とぶつかる音軽め" volume="1."/><shake @l="821" amp="10" class="all" cycle="30" duration="600" type="random"/><msg @l="823" char_id="0" frame_id="-1" name="美帆" text="『呀！』" voices=""/><msg @l="825" char_id="-1" frame_id="-1" name="路人" text="『喂！你走路都不看路的吗！』"   voices=""/><msg @l="827" char_id="0" frame_id="-1" name="美帆" text="『对、对不起！』"   voices=""/><msg @l="829" char_id="-1" frame_id="-1" name="路人" text="『切！小心点啊！』"   voices=""/><char @l="833" id="miho" pos="auto" src="miho015"/><msg @l="835" char_id="0" frame_id="-1" name="美帆" text="『……对不起……』"   voices=""/><msg @l="837" char_id="0" frame_id="-1" name="美帆" text="『………』" voices=""/><clear @l="841" class="char"/><msg @l="843" char_id="0" frame_id="-1" name="美帆"   text="(真是的……我居然撞了两次，真是太笨手笨脚了……)" voices=""/><msg @l="845" char_id="0" frame_id="-1" name="美帆" text="(唉……)" voices=""/><msg @l="847" char_id="0" frame_id="-1" name="美帆" text="(不过……)" voices=""/><msg @l="849" char_id="0" frame_id="-1" name="美帆"   text="(无论如何……我真的不擅长人多的地方)" voices=""/><msg @l="851" char_id="0" frame_id="-1" name="美帆" text="(刚才撞到的那个人也是……)"   voices=""/><msg @l="853" char_id="0" frame_id="-1" name="美帆"   text="(总觉得大家都很冷漠，好像只考虑自己的事情……)" voices=""/><msg @l="855" char_id="0" frame_id="-1" name="美帆"   text="(这种感觉真是……有点寂寞啊)" voices=""/><msg @l="857" char_id="-1" frame_id="-1" name=""   text="我疲于应对人流，靠在街道一角深深地叹了口气。" voices=""/><msg @l="859" char_id="3" frame_id="-1" name="女孩" text="『……。』" voices=""/><msg @l="861" char_id="0" frame_id="-1" name="美帆" text="『……？』" voices=""/><msg @l="863" char_id="-1" frame_id="-1" name=""   text="突然，我感到人群中有一道视线，往那边看去，发现一个女孩正默默地注视着我。" voices=""/><msg @l="864" char_id="-1" frame_id="-1" name=""   text="一个肤色苍白……给人一种存在感稀薄的神秘少女———。" voices=""/><msg @l="865" char_id="-1" frame_id="-1" name="" text="那个少女，正目不转睛地注视着“我”。"   voices=""/><msg @l="867" char_id="0" frame_id="-1" name="美帆" text="『……请问有什么事吗？』"   voices=""/><char @l="871" id="nanak" pos="auto" src="nanako015"/><msg @l="873" char_id="3" frame_id="-1" name="女孩" text="『你并不寂寞。』"   voices=""/><stopbgm @l="877" fadeout="1000"/><msg @l="879" char_id="0" frame_id="-1" name="美帆" text="『诶……？』" voices=""/><bgm @l="883" src="bgm11" volume="1."/><char @l="887" id="nanak" pos="auto" src="nanako010"/><msg @l="889" char_id="3" frame_id="-1" name="女孩" text="『没关系，你并不寂寞。』"   voices=""/><msg @l="891" char_id="0" frame_id="-1" name="美帆"   text="『不寂寞……是什么……意思。』" voices=""/><msg @l="893" char_id="-1" frame_id="-1" name="" text="“不寂寞”" voices=""/><msg @l="894" char_id="-1" frame_id="-1" name=""   text="我不由自主地感到背脊一凉……" voices=""/><msg @l="895" char_id="-1" frame_id="-1" name=""   text="这似乎是对我刚才内心想法的回应———。" voices=""/><msg @l="896" char_id="-1" frame_id="-1" name=""   text="面对仿佛能读懂我心思的话语，我不禁语塞了。" voices=""/><msg @l="898" char_id="3" frame_id="-1" name="女孩" text="『……。』" voices=""/><msg @l="900" char_id="-1" frame_id="-1" name="" text="———沉默。" voices=""/><msg @l="901" char_id="-1" frame_id="-1" name="" text="少女只是默默地注视着我。"   voices=""/><msg @l="902" char_id="-1" frame_id="-1" name=""   text="那视线仿佛能够看透我的内心……" voices=""/><msg @l="904" char_id="0" frame_id="-1" name="美帆" text="『……你，难道是……。』"   voices=""/><msg @l="906" char_id="-1" frame_id="-1" name=""   text="话刚出口，我就因为自己假设的荒谬而停下了后面的话。" voices=""/><msg @l="907" char_id="-1" frame_id="-1" name=""   text="与其这样，不如认为是我自己恰好露出了沮丧的表情，这样解释更合理。" voices=""/><char @l="911" id="nanak" pos="auto" src="nanako018"/><msg @l="913" char_id="3" frame_id="-1" name="女孩" text="『……？』" voices=""/><msg @l="915" char_id="-1" frame_id="-1" name="" text="少女疑惑地歪着小脑袋。"   voices=""/><msg @l="916" char_id="-1" frame_id="-1" name=""   text="要说困惑的话，应该是我才对……" voices=""/><msg @l="918" char_id="-1" frame_id="-1" name="男人的声音" text="『———奈那子。』"   voices=""/><clear @l="921" class="char"/><char @l="923" id="nanak" pos="left" src="nanako010"/><char @l="926" id="shiny" pos="right" src="shinya210"/><msg @l="928" char_id="-1" frame_id="-1" name="" text="不知何时，他已经走近了。"   voices=""/><msg @l="929" char_id="-1" frame_id="-1" name=""   text="回过神来，少女身旁已有一个男子陪伴在侧。" voices=""/><msg @l="930" char_id="-1" frame_id="-1" name=""   text="男子背对着我，看不清他的表情。" voices=""/><msg @l="931" char_id="-1" frame_id="-1" name=""   text="只是……一股强烈的肃杀气氛清晰地传达了过来。" voices=""/><msg @l="933" char_id="-1" frame_id="-1" name="年轻男子"   text="『奈那子，我不是说过不要一个人先走吗。』" voices=""/><char @l="937" id="nanak" pos="left" src="nanako015"/><msg @l="939" char_id="3" frame_id="-1" name="女孩"   text="『对不起……总觉得，有人在叫我。』" voices=""/><msg @l="941" char_id="-1" frame_id="-1" name=""   text="被称作奈那子的少女，说着既像道歉又像解释的话语，露出歉意的表情，随后双手环绕着那个男子的手臂，轻轻地抱住了他。"   voices=""/><msg @l="942" char_id="-1" frame_id="-1" name=""   text="那一连串的动作如此可爱，我不由自主地联想到了几十年前曾经非常流行的“抱抱娃娃”。"   voices=""/><char @l="946" id="nanak" pos="left" src="nanako018"/><msg @l="948" char_id="3" frame_id="-1" name="女孩" text="『……那是什么？』"   voices=""/><msg @l="950" char_id="0" frame_id="-1" name="美帆" text="『……啊！？』" voices=""/><msg @l="952" char_id="-1" frame_id="-1" name="" text="“什么”到底是指什么呢？"   voices=""/><msg @l="953" char_id="-1" frame_id="-1" name=""   text="明明刚才我一句话都没说——" voices=""/><msg @l="954" char_id="-1" frame_id="-1" name="" text="难道说……" voices=""/><msg @l="956" char_id="-1" frame_id="-1" name="年轻男子" text="『………』" voices=""/><msg @l="958" char_id="-1" frame_id="-1" name="年轻男子"   text="『……最好不要过多地打探我们的事。』" voices=""/><msg @l="960" char_id="0" frame_id="-1" name="美帆" text="『啊……？』" voices=""/><msg @l="962" char_id="-1" frame_id="-1" name="年轻男子" text="『奈那子，我们走。』"   voices=""/><char @l="966" id="nanak" pos="left" src="nanako010"/><msg @l="968" char_id="3" frame_id="-1" name="女孩" text="『好的……哥哥。』"   voices=""/><clear @l="973" class="char"/><msg @l="975" char_id="0" frame_id="-1" name="美帆" text="『啊……』" voices=""/><msg @l="977" char_id="-1" frame_id="-1" name=""   text="对着即将离去的两人，我条件反射地伸出了手———。" voices=""/><msg @l="979" char_id="-1" frame_id="-1" name=""   text="然而两人转眼间就消失在人群之中。" voices=""/><msg @l="981" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="983" char_id="0" frame_id="-1" name="美帆" text="『我……』" voices=""/><msg @l="985" char_id="0" frame_id="-1" name="美帆"   text="『我……想把那两个人留在这里，究竟是为了什么呢？』" voices=""/><msg @l="987" char_id="-1" frame_id="-1" name=""   text="在稍微远离人流的建筑墙边，我独自喃喃自语。" voices=""/><msg @l="988" char_id="-1" frame_id="-1" name="" text="他们肯定不会给我任何答案。"   voices=""/><msg @l="989" char_id="-1" frame_id="-1" name=""   text="那个女孩似乎能读懂我的心思，以及我对那两人莫名感到的奇怪违和感……。" voices=""/><msg @l="991" char_id="0" frame_id="-1" name="美帆"   text="『……或许还是忘掉比较好吧。』" voices=""/><msg @l="993" char_id="-1" frame_id="-1" name=""   text="感受着背后冰冷的混凝土触感，我皱着眉头，像是在对自己说服般地喃喃自语。" voices=""/><stopbgm @l="997" fadeout="1000"/><clear @l="1003" class="all"/><msgshow @l="1005" show="true"/><msg @l="1007" char_id="-1" frame_id="-1" name="" text="…………………。" voices=""/><msg @l="1008" char_id="-1" frame_id="-1" name="" text="………………。" voices=""/><msg @l="1009" char_id="-1" frame_id="-1" name="" text="……。" voices=""/><wait_chgmv/><bg @l="1013" src="bg04"/><bgm @l="1017" src="bgm02" volume="1."/><char @l="1021" id="miho" pos="auto" src="miho010"/><msg @l="1023" char_id="0" frame_id="-1" name="美帆"   text="(终于到了——……从车站还要走不少路，这点确实是个缺点呢)" voices=""/><msg @l="1025" char_id="-1" frame_id="-1" name=""   text="刚在几天前完成搬家的公寓楼前，我一边调整着略微紊乱的呼吸，一边缓缓抬头仰望着这栋建筑物。"   voices=""/><msg @l="1026" char_id="-1" frame_id="-1" name=""   text="在遇到那对奇怪的兄妹后，我放弃了去百货商店的打算，直接回来了。" voices=""/><msg @l="1027" char_id="-1" frame_id="-1" name=""   text="不知怎的，我已经没有了去逛街橱窗购物的心情。" voices=""/><msg @l="1029" char_id="0" frame_id="-1" name="美帆"   text="(好像被毒气侵袭一样，身体感觉有点沉重……)" voices=""/><clear @l="1035" class="all"/><msg @l="1040" char_id="-1" frame_id="-1" name=""   text="我打开正门，按下电梯按钮。" voices=""/><se @l="1044" buf="1" src="エレベータが来る音" volume="1."/><msg @l="1046" char_id="-1" frame_id="-1" name=""   text="没过多久电梯下来了，我走了进去。" voices=""/><msg @l="1048" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="1050" char_id="-1" frame_id="-1" name=""   text="在不熟悉的地方乘坐电梯，总感觉有些不习惯，甚至有点害怕。" voices=""/><msg @l="1051" char_id="-1" frame_id="-1" name=""   text="被关在狭小空间里的不安感……。" voices=""/><msg @l="1053" char_id="0" frame_id="-1" name="美帆" text="『……呼……。』"   voices=""/><msg @l="1055" char_id="-1" frame_id="-1" name=""   text="我靠在电梯墙壁上，轻轻地叹了口气。" voices=""/><msg @l="1056" char_id="-1" frame_id="-1" name=""   text="自从遇见那个少女后，我的状态就一直不太对劲。" voices=""/><msg @l="1057" char_id="-1" frame_id="-1" name=""   text="不——状态变得奇怪，或许是从“南总町”到访开始的吧。" voices=""/><msg @l="1059" char_id="0" frame_id="-1" name="美帆" text="(果然……是累了啊)"   voices=""/><msg @l="1061" char_id="-1" frame_id="-1" name="" text="我就那样缓缓闭上了眼睛。"   voices=""/><msg @l="1062" char_id="-1" frame_id="-1" name=""   text="然后……像是将身体交给电梯马达的震动一样，决定静静等待抵达目标楼层。" voices=""/><wait_chgmv/><bg @l="1067" src="bg05"/><msg @l="1069" char_id="-1" frame_id="-1" name=""   text="走出电梯，踏入了两侧排列着门的走廊。" voices=""/><msg @l="1070" char_id="-1" frame_id="-1" name=""   text="尽管是白天，走廊上却完全没有人的气息。" voices=""/><msg @l="1071" char_id="-1" frame_id="-1" name=""   text="根据说明会上听到的介绍，这栋公寓是专门为南总町校区的学生提供租赁的特殊住所，所以没有一般的入住者。"   voices=""/><msg @l="1072" char_id="-1" frame_id="-1" name=""   text="这似乎是大学与当地建筑公司合作进行的项目，除了伙食费外，生活费和房租都是从学费中支付的。"   voices=""/><msg @l="1073" char_id="-1" frame_id="-1" name=""   text="在这南总町，为了这个目的建造的公寓楼和公寓房有好几处，转校生可以自由选择入住地点。"   voices=""/><char @l="1077" id="miho" pos="auto" src="miho110"/><msg @l="1079" char_id="0" frame_id="-1" name="美帆"   text="(因为是春假，大家都回老家了吗？)" voices=""/><msg @l="1081" char_id="-1" frame_id="-1" name=""   text="带着这样的想法，我确认着房间号码，走在走廊上。" voices=""/><msg @l="1082" char_id="-1" frame_id="-1" name="" text="———307号室" voices=""/><msg @l="1083" char_id="-1" frame_id="-1" name=""   text="那就是我从今往后将要生活的房间。" voices=""/><msg @l="1085" char_id="0" frame_id="-1" name="美帆"   text="(如果没记错的话……转学生一定会有一位学姐作为室友吧)" voices=""/><char @l="1089" id="miho" pos="auto" src="miho116"/><msg @l="1091" char_id="0" frame_id="-1" name="美帆" text="(不知道能不能相处得好……)"   voices=""/><msg @l="1093" char_id="-1" frame_id="-1" name=""   text="我回想起在宣传手册上写的那句话，内心涌起一丝不安。" voices=""/><msg @l="1094" char_id="-1" frame_id="-1" name=""   text="因为我很怕生，与新认识的人打成一片需要很长时间。" voices=""/><msg @l="1095" char_id="-1" frame_id="-1" name=""   text="这样的我，实在难以想象能从一开始就与初次见面的人建立“和睦的共同生活”。" voices=""/><char @l="1099" id="miho" pos="auto" src="miho010"/><msg @l="1101" char_id="0" frame_id="-1" name="美帆" text="(不行不行……我得积极一点)"   voices=""/><clear @l="1105" class="char"/><msg @l="1107" char_id="-1" frame_id="-1" name=""   text="仿佛在承受着压力一般，我在标着307号室的门前停下了脚步。" voices=""/><msg @l="1108" char_id="-1" frame_id="-1" name=""   text="在门旁安装的户主名牌上，贴着我的名字“仲根 美帆”的门牌，以及将成为室友的“白石 玲”的门牌。"   voices=""/><msg @l="1110" char_id="0" frame_id="-1" name="美帆"   text="(希望能是个温柔的人啊……)" voices=""/><se @l="1114" buf="1" src="呼び鈴_壁越しでくぐもってる" volume="1."/><msg @l="1116" char_id="-1" frame_id="-1" name=""   text="怀着既像愿望又像祈祷的“想法”，我按下了门铃开关。" voices=""/><msg @l="1117" char_id="-1" frame_id="-1" name=""   text="透过门缝听到的微弱电子音，引起一种奇妙的紧张感。" voices=""/><msg @l="1118" char_id="-1" frame_id="-1" name="" text="…………………"   voices=""/><stopbgm @l="1121" fadeout="1000"/><msg @l="1123" char_id="0" frame_id="-1" name="美帆" text="『……咦？』" voices=""/><msg @l="1125" char_id="-1" frame_id="-1" name=""   text="按门铃后大概等了足足30秒吧。" voices=""/><msg @l="1126" char_id="-1" frame_id="-1" name=""   text="既没有门要开的迹象，更没有房间里有人走动的声音。" voices=""/><se @l="1130" buf="1" src="呼び鈴_壁越しでくぐもってる" volume="1."/><msg @l="1132" char_id="-1" frame_id="-1" name=""   text="我又按了一次门铃开关，等了一会儿。" voices=""/><msg @l="1133" char_id="-1" frame_id="-1" name=""   text="……但是，依然完全没有从内侧开门的迹象。" voices=""/><msg @l="1135" char_id="0" frame_id="-1" name="美帆" text="(……是不在家吗？)"   voices=""/><msg @l="1137" char_id="-1" frame_id="-1" name=""   text="今天我要入住这个房间的事，应该已经通过学校提前通知给了将成为同居人的她。" voices=""/><msg @l="1138" char_id="-1" frame_id="-1" name=""   text="话虽如此，她也没有必要专门为了迎接转学生而留在这里。" voices=""/><msg @l="1139" char_id="-1" frame_id="-1" name="" text="毕竟是难得的春假。"   voices=""/><msg @l="1140" char_id="-1" frame_id="-1" name=""   text="她（白石）可能也回老家与家人一起共度天伦了吧。" voices=""/><msg @l="1142" char_id="0" frame_id="-1" name="美帆" text="(呃……)" voices=""/><msg @l="1144" char_id="0" frame_id="-1" name="美帆"   text="(虽然有点不好意思，但也没办法……对吧？)" voices=""/><clear @l="1150" class="all"/><msg @l="1152" char_id="-1" frame_id="-1" name=""   text="我从手提包中取出装在牛皮信封里的备用钥匙。" voices=""/><msg @l="1153" char_id="-1" frame_id="-1" name=""   text="钥匙上贴着简朴的标签，上面写着“307”。" voices=""/><se @l="1156" buf="1" src="鍵を開ける音" volume="1."/><msg @l="1158" char_id="-1" frame_id="-1" name=""   text="用不太熟练的手势将取出的备用钥匙插入钥匙孔时，我苦笑了一下。" voices=""/><msg @l="1159" char_id="-1" frame_id="-1" name="" text="如果第三者看到现在的我会怎么想呢。"   voices=""/><msg @l="1160" char_id="-1" frame_id="-1" name="" text="会不会觉得我像个可疑人物……。"   voices=""/><msg @l="1162" char_id="0" frame_id="-1" name="美帆" text="『那个……打扰了。』"   voices=""/><msg @l="1164" char_id="-1" frame_id="-1" name=""   text="我故意大声喊着开了门。" voices=""/><msg @l="1165" char_id="-1" frame_id="-1" name=""   text="不用说，这种刻意的行为反而显得更加可疑，让我感到更加尴尬……。" voices=""/><clear @l="1171" class="all"/><wait_chgmv/><bg @l="1175" src="bg03"/><bgm @l="1179" src="bgm02" volume="1."/><msg @l="1181" char_id="0" frame_id="-1" name="美帆" text="(哇……好宽敞啊)"   voices=""/><msg @l="1183" char_id="-1" frame_id="-1" name=""   text="进入房间直走就到了客厅。" voices=""/><msg @l="1184" char_id="-1" frame_id="-1" name=""   text="走廊中途有三扇门，但我不知道它们通向什么房间，也不好贸然开门，所以就先直走了。"   voices=""/><msg @l="1186" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="1188" char_id="0" frame_id="-1" name="美帆"   text="(我要在这里……生活两年了吧？)" voices=""/><msg @l="1190" char_id="0" frame_id="-1" name="美帆"   text="(这么想的话，还挺让人兴奋的)" voices=""/><msg @l="1192" char_id="-1" frame_id="-1" name=""   text="我这才像刚刚想起来似的，把从车站前一直挂在肩上的包放到了沙发上。"   voices=""/><msg @l="1193" char_id="-1" frame_id="-1" name=""   text="然后我自己也轻轻地在包的旁边坐下，深深地叹了口气。" voices=""/><bgm @l="1196" src="bgm07" volume="1."/><msg @l="1198" char_id="0" frame_id="-1" name="美帆" text="(今天发生了好多事啊……)"   voices=""/><msg @l="1200" char_id="0" frame_id="-1" name="美帆"   text="(坐了好久的电车，还在满是烟味的食堂里等了好久)" voices=""/><msg @l="1202" char_id="0" frame_id="-1" name="美帆"   text="(撞到了一位漂亮的人……她稍微笑了笑)" voices=""/><msg @l="1204" char_id="0" frame_id="-1" name="美帆" text="(然后……)" voices=""/><msg @l="1206" char_id="0" frame_id="-1" name="美帆"   text="(然后……那个叫七子……的女孩子……她是……？)" voices=""/><msg @l="1208" char_id="-1" frame_id="-1" name=""   text="想着各种事情，可能是因为疲劳，突然一阵困意袭来……。" voices=""/><msg @l="1210" char_id="0" frame_id="-1" name="美帆" text="(哈啊……)" voices=""/><msg @l="1213" char_id="-1" frame_id="-1" name=""   text="身体渐渐变暖……感觉真舒服。" voices=""/><msg @l="1214" char_id="-1" frame_id="-1" name=""   text="——我……慢慢地陷入了深深的睡眠。" voices=""/><stopbgm @l="1218" fadeout="1000"/><clear @l="1224" class="all"/><msgshow @l="1226" show="true"/><msg @l="1228" char_id="-1" frame_id="-1" name="" text="…………。" voices=""/><msg @l="1229" char_id="-1" frame_id="-1" name="" text="………………。" voices=""/><msg @l="1230" char_id="-1" frame_id="-1" name="" text="……。" voices=""/><msg @l="1232" char_id="0" frame_id="-1" name="美帆" text="『嗯……。』" voices=""/><se @l="1236" buf="1" src="扉を開ける音_金属" volume="1."/><msg @l="1238" char_id="0" frame_id="-1" name="美帆" text="『咦……？』" voices=""/><msg @l="1240" char_id="-1" frame_id="-1" name="" text="突然，玄关处传来了开门的声音。"   voices=""/><msg @l="1241" char_id="-1" frame_id="-1" name=""   text="我因为这声音而醒来，这才发现自己不知何时在沙发上睡着了。四周已经完全黑了。" voices=""/><msg @l="1243" char_id="-1" frame_id="-1" name=""   text="当然，除了同居者以外不会把备用钥匙给其他人，而且大学规定禁止私自复制钥匙。" voices=""/><msg @l="1244" char_id="-1" frame_id="-1" name="" text="这样的话——。"   voices=""/><wait_chgmv/><bg @l="1248" src="bg03c"/><msg @l="1250" char_id="1" frame_id="-1" name="声音" text="『咦……有人在吗？』"   voices=""/><msg @l="1252" char_id="1" frame_id="-1" name="声音"   text="『说起来，合租的那孩子是今天来吗……？』" voices=""/><msg @l="1254" char_id="-1" frame_id="-1" name="" text="从玄关处传来了一个耳熟的声音。"   voices=""/><msg @l="1256" char_id="0" frame_id="-1" name="美帆" text="(咦……这个声音，在哪里听过……？)"   voices=""/><msg @l="1258" char_id="-1" frame_id="-1" name=""   text="我慌忙坐起身，打开了房间的灯。" voices=""/><msg @l="1260" char_id="-1" frame_id="0" name="" text="「啪嗒」" voices=""/><wait_chgmv/><bg @l="1264" src="bg03b"/><msg @l="1266" char_id="-1" frame_id="-1" name=""   text="从走廊通向客厅的门被打开，出现的是我白天撞到的那位穿西装的女性。" voices=""/><char @l="1270" id="rei" pos="auto" src="rei010"/><bgm @l="1274" src="bgm05" volume="1."/><msg @l="1276" char_id="1" frame_id="-1" name="穿西装的女性"   text="『真是不好意思，我不在家。』" voices=""/><msg @l="1278" char_id="1" frame_id="-1" name="穿西装的女性"   text="『社团的会议实在是推不掉……。』" voices=""/><char @l="1282" id="rei" pos="auto" src="rei014"/><msg @l="1284" char_id="1" frame_id="-1" name="玲" text="『哎呀……你是……。』"   voices=""/><clear @l="1287" class="char"/><char @l="1290" id="rei" pos="left" src="rei014"/><char @l="1293" id="miho" pos="right" src="miho014"/><msg @l="1295" char_id="0" frame_id="-1" name="美帆" text="『啊……你就是白石玲……学姐？』"   voices=""/><char @l="1299" id="rei" pos="left" src="rei010"/><msg @l="1301" char_id="1" frame_id="-1" name="玲"   text="『是的……来这个房间合租的人竟然是你。』" voices=""/><char @l="1305" id="rei" pos="left" src="rei011"/><msg @l="1307" char_id="1" frame_id="-1" name="玲" text="『这也是一种缘分吧？』"   voices=""/><msg @l="1309" char_id="-1" frame_id="-1" name="" text="她愉快地微笑着。"   voices=""/><msg @l="1310" char_id="-1" frame_id="-1" name=""   text="我完全没有想到白天遇到的那位迷人女性会是我的室友，我因为困惑和惊讶而说不出话来。" voices=""/><char @l="1314" id="rei" pos="left" src="rei110"/><msg @l="1316" char_id="1" frame_id="-1" name="玲" text="『仲根美帆小姐……没错吧？』"   voices=""/><char @l="1320" id="miho" pos="right" src="miho110"/><msg @l="1322" char_id="0" frame_id="-1" name="美帆"   text="『啊，……是的……我是仲根……那次真是……』" voices=""/><msg @l="1324" char_id="1" frame_id="-1" name="玲"   text="『虽然我觉得已经不需要自我介绍了，不过还是正式地说一下吧。这是礼节嘛。』" voices=""/><char @l="1328" id="rei" pos="left" src="rei011"/><msg @l="1330" char_id="1" frame_id="-1" name="玲"   text="『我是白石玲，这个房间的合租人……接下来的一年请多关照。』" voices=""/><msg @l="1332" char_id="-1" frame_id="-1" name=""   text="她说完，温柔地微笑着伸出了右手。" voices=""/><msg @l="1333" char_id="-1" frame_id="-1" name=""   text="我带着喜悦和困惑交织的表情，与她握了手。" voices=""/><msg @l="1335" char_id="-1" frame_id="-1" name="" text="……………………。" voices=""/><msg @l="1336" char_id="-1" frame_id="-1" name="" text="………………。" voices=""/><msg @l="1337" char_id="-1" frame_id="-1" name="" text="…………。" voices=""/><stopbgm @l="1342" fadeout="1000"/><eval @l="1346" expr="s.opening_flag=1&#13;&#10;"/><clear @l="1352" class="all"/><call @l="1356" target="EventLabel_19@common_root01"/><return @l="1357" value="0&#13;&#10;"/></code></xscript>																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																					