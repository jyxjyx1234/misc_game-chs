<?xml version="1.0" encoding="utf-8"?><xscript><debug editor="&quot;C:\Program&#32;Files&#32;(x86)\sakura\sakura.exe&quot;&#32;&quot;%src%&quot;&#32;-Y=%line%"   src="D:\シロップ\町ぐるみの罠＋汚された夏セット版\汚された夏\完成データ\汚された夏\script\text\ex_ending02.txt"/><code><label @l="12" id="EventLabel_56"/><msg @l="16" char_id="-1" frame_id="-1" name="" text="………………………………。"   voices=""/><msg @l="17" char_id="-1" frame_id="-1" name="" text="……………………。" voices=""/><msg @l="18" char_id="-1" frame_id="-1" name="" text="…………。" voices=""/><bgm @l="22" src="bgm04" volume="1."/><wait_chgmv/><bg @l="26" src="bg18a"/><msg @l="28" char_id="0" frame_id="-1" name="美帆" text="『…………。』" voices=""/><msg @l="30" char_id="-1" frame_id="-1" name=""   text="从那时起已经过去了将近一年……春天到来了。再过几天，季节也将转变到升级的时期。" voices=""/><msg @l="31" char_id="-1" frame_id="-1" name=""   text="在被网球部的人们调教的过程中，我逐渐觉醒了被欺负的快感，感觉自己作为“南总町的居民”已经相当融入了。"   voices=""/><wait_chgmv/><bg @l="34" src="black"/><wait_chgmv/><bg @l="36" src="bg23a"/><msg @l="38" char_id="-1" frame_id="-1" name=""   text="———实际上，在这个“南总町”，为了解决人口减少和经济恶化的问题，正在推进将整个町变成巨大的性欲处理场的计划。"   voices=""/><msg @l="39" char_id="-1" frame_id="-1" name=""   text="通过这个计划，被引进的企业只要出示员工证就能免费接受性服务。作为回报，企业会给当地带来巨大的经济效益。"   voices=""/><msg @l="40" char_id="-1" frame_id="-1" name=""   text="已经有多家大企业决定进驻，町内的各种商店和住宅中的女性们都开始拥有了夜晚的另一面———" voices=""/><msg @l="42" char_id="-1" frame_id="-1" name=""   text="虽然在被告知之前我没有意识到这个事实，但当我在镇上被迫进行众人围观的游戏时，路过的人们并不感到特别惊讶，反而理所当然地加入进来，这让我开始切实感受到了。"   voices=""/><msg @l="44" char_id="-1" frame_id="-1" name=""   text="我最初也很抗拒，但在被调教后觉醒了做爱的喜悦，开始主动接受这个町的系统——" voices=""/><wait_chgmv/><bg @l="47" src="black"/><wait_chgmv/><bg @l="49" src="bg18a"/><msg @l="51" char_id="-1" frame_id="-1" name=""   text="而且……我周围的事情也发生了各种变化。" voices=""/><msg @l="52" char_id="-1" frame_id="-1" name=""   text="亚季奈曾经回过一次娘家，但在参加部活时被老师目睹了和部员做爱的场景，于是被迫转学。当时在稻庭先生和熊野先生的安排下，亚季奈转学到了这个町的学园。"   voices=""/><msg @l="53" char_id="-1" frame_id="-1" name=""   text="不过考虑到亚季奈的性格，与其说是不小心被发现，倒不如说是为了转学才故意让人看见的吧……。" voices=""/><msg @l="54" char_id="-1" frame_id="-1" name=""   text="现在她作为特别措施一边上学，一边作为临时教练为大学游泳部的人们教授“各种事情”。" voices=""/><msg @l="55" char_id="-1" frame_id="-1" name=""   text="……总是能在泳池里做真让人羡慕……。" voices=""/><msg @l="57" char_id="0" frame_id="1" name="美帆"   text="（下次要不要也拜托他们让我用一下泳池呢……）" voices=""/><wait_chgmv/><bg @l="59" src="black"/><msg @l="60" char_id="-1" frame_id="-1" name=""   text="对了对了……差点忘了说，亚季奈现在住在大学的合宿所里，好像是和熊野先生一起住的。" voices=""/><msg @l="61" char_id="-1" frame_id="-1" name=""   text="我邀请她一起住，可以玩姐妹游戏，但她似乎有被多名男性侵犯的愿望，所以选择住进了合宿所。真可惜……"   voices=""/><msg @l="62" char_id="-1" frame_id="-1" name=""   text="嗯……对了，好像渡部老师也一起搬过来了吧。" voices=""/><msg @l="64" char_id="0" frame_id="1" name="美帆"   text="（现在大概正在泳池里开心地做爱吧。）" voices=""/><msg @l="66" char_id="-1" frame_id="-1" name="" text="……………。"   voices=""/><stopbgm @l="70" fadeout="1000"/><clear @l="76" class="all"/><msgshow @l="78" show="true"/><bgm @l="82" src="bgm06" volume="1."/><wait_chgmv/><bg @l="87" src="bg10am1"/><msg @l="89" char_id="2" frame_id="-1" name="亚季奈"   text="『好—了，那么今天也要好好练习哦！』" voices=""/><msg @l="91" char_id="-1" frame_id="-1" name=""   text="说着，亚季奈穿着渡部特制的泳衣走向泳池边。" voices=""/><msg @l="92" char_id="-1" frame_id="-1" name=""   text="所谓渡部特制，不过是用剪刀漂亮地把泳衣胸部和胯部的布料剪掉，让乳头和小穴完全暴露在外的东西。"   voices=""/><msg @l="94" char_id="-1" frame_id="-1" name="游泳部员A"   text="『喂，快看……亚季奈今天也湿漉漉的。』" voices=""/><msg @l="96" char_id="-1" frame_id="-1" name="游泳部员B"   text="『明明还没下水，泳衣都没湿……但是从那里到大腿都流满了爱液。』" voices=""/><msg @l="98" char_id="-1" frame_id="-1" name=""   text="游泳部的成员们看着亚季奈那副打扮，个个露出坏笑，一脸开心的样子。" voices=""/><msg @l="99" char_id="-1" frame_id="-1" name=""   text="尽管如此，亚季奈还是若无其事地走在泳池边，在游泳部员们面前停下脚步。" voices=""/><msg @l="100" char_id="2" frame_id="-1" name="亚季奈"   text="『首先热身做25米自由泳三次，完成的人按顺序计时50米！当然今天也有前三名的奖励哦。』"   voices=""/><msg @l="102" char_id="-1" frame_id="-1" name=""   text="说完，亚季奈站在游泳部员旁边，轻轻抚摸他们的胯部。" voices=""/><msg @l="104" char_id="-1" frame_id="-1" name="游泳部员A" text="『呜，哇！』"   voices=""/><msg @l="106" char_id="2" frame_id="-1" name="亚季奈"   text="『嘿嘿，要加油哦。我在等着你们把这个插进来呢。』" voices=""/><msg @l="108" char_id="-1" frame_id="-1" name="游泳部员A" text="『是，是的！』"   voices=""/><msg @l="110" char_id="-1" frame_id="-1" name="游泳部员B" text="『是！』"   voices=""/><msg @l="112" char_id="-1" frame_id="-1" name=""   text="亚季奈看着他们胯下鼓胀的样子，不禁想象着自己被肉棒贯穿的场景，秘部发出“咕啾”的淫靡声音。"   voices=""/><stopbgm @l="115" fadeout="1000"/><clear @l="121" class="all"/><label @l="124" id="event_scene70"/><se @l="127" buf="1" src="ホイッスル（室内プール）" volume="1."/><msg @l="129" char_id="2" frame_id="-1" name="亚季奈" text="『好—了！结束了哦—！』"   voices=""/><msg @l="131" char_id="-1" frame_id="-1" name=""   text="随着亚季奈吹响哨子的声音，练习结束了。" voices=""/><msg @l="133" char_id="2" frame_id="-1" name="亚季奈"   text="『那么，今天成绩好的前三名留下来—。其他人可以留下来继续练习，也可以留下来观看奖励时间哦—。』"   voices=""/><msg @l="135" char_id="-1" frame_id="-1" name=""   text="亚季奈说完，成绩好的三人抱起亚季奈跳入泳池。" voices=""/><se @l="138" buf="1" src="飛び込む音" volume="1."/><msg @l="140" char_id="2" frame_id="-1" name="亚季奈"   text="『噗哈！吓了我一跳！真是急性子啊。』" voices=""/><bgm @l="143" src="bgm04" volume="1."/><msg @l="145" char_id="-1" frame_id="-1" name=""   text="从水中探出头的亚季奈鼓起腮帮子说道。然而游泳部员们不顾亚季奈的话，开始摸她的胸部和臀部。"   voices=""/><msg @l="147" char_id="-1" frame_id="-1" name="游泳部员B"   text="『哦哦！果然亚季奈酱的小穴好软啊。』" voices=""/><msg @l="149" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯嗯！真是的，不用那么着急，我会让你们尽情享用的。来，这里也摸摸。』" voices=""/><msg @l="151" char_id="-1" frame_id="-1" name=""   text="亚季奈说着，拉过游泳部员的手放在自己的小穴上。" voices=""/><msg @l="153" char_id="2" frame_id="-1" name="亚季奈"   text="『呐，用手指把这里弄得湿湿的，然后用你那匹马一样的东西刺进来。』" voices=""/><msg @l="154" char_id="-1" frame_id="-1" name="游泳部员A"   text="『但是如果马上插入的话，亚季奈酱就可以什么都不做就舒服了，所以像我们一样，先让你等一等吧。』"   voices=""/><msg @l="156" char_id="-1" frame_id="-1" name=""   text="游泳部员们交换了个眼神后这么说着，将三根手指插入亚季奈的秘部搅动起来。另外两人则捏着她的乳头，或是亲吻她，将唾液流入她的口中。"   voices=""/><msg @l="158" char_id="-1" frame_id="-1" name=""   text="亚季奈在三人配合默契的爱抚下全身颤抖，扭动着身体。" voices=""/><label @l="162" id="chart_line65"/><wait_chgmv/><ev @l="166" src="ev-070"/><msg @l="168" char_id="2" frame_id="-1" name="亚季奈" text="『嗯，呜啊……』"   voices="akina03850"/><msg @l="170" char_id="2" frame_id="-1" name="亚季奈"   text="『啊啊……已经不行了……已经，忍不住了啊……。』" voices="akina00880"/><msg @l="172" char_id="-1" frame_id="-1" name=""   text="亚季奈投去迷醉诱人的目光，主动从水泳部员的泳裤中掏出男根，自己将它刺入秘裂中。" voices=""/><msg @l="174" char_id="-1" frame_id="-1" name="" text="咕啾，咕啾，咕啾，咕啾，咕啾"   voices=""/><msg @l="176" char_id="-1" frame_id="-1" name=""   text="由于亚季奈的秘裂已经湿润，加上泳池的水渗入那里，她毫不费力地吞入了水泳部员如同马匹一般的巨大肉棒。" voices=""/><msg @l="178" char_id="2" frame_id="-1" name="亚季奈" text="『嗯嗯嗯！！！』"   voices="akina00930"/><msg @l="180" char_id="-1" frame_id="-1" name="游泳部员A"   text="『哇哦！亚季奈酱，自己把它放进小穴里了呢。这样的话，就好像是我被侵犯了一样啊。』" voices=""/><msg @l="182" char_id="-1" frame_id="-1" name="游泳部员C"   text="『你小子，真好啊。等会儿也让我换上去啊。』" voices=""/><msg @l="184" char_id="-1" frame_id="-1" name="游泳部员B"   text="『那么，我在等待的时候就让她用嘴吸一下吧。』" voices=""/><msg @l="186" char_id="-1" frame_id="-1" name="游泳部员C" text="『啊，我也要我也要。』"   voices=""/><msg @l="188" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯，啾……就算不说，我也会吸的嘛～。』" voices="akina03930"/><msg @l="190" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯哼……好厉害，已经硬邦邦了呢。』" voices="akina03870"/><msg @l="192" char_id="-1" frame_id="-1" name=""   text="亚季奈和水泳部员们在其他部员的注视下，像往常一样在泳池里开始了4P。" voices=""/><msg @l="193" char_id="-1" frame_id="-1" name=""   text="正在贯穿亚季奈秘裂的部员抱着她的双腿，伴随着哗啦哗啦的水声，反复进行着激烈的抽插。" voices=""/><msg @l="194" char_id="-1" frame_id="-1" name=""   text="另外两名部员一边享受着她手的套弄，一边贪婪地品尝着亚季奈健康的肌肤。" voices=""/><msg @l="196" char_id="-1" frame_id="-1" name="游泳部员A"   text="『不过，水流进来的感觉无论做多少次都很舒服，让人上瘾啊！』" voices=""/><msg @l="198" char_id="2" frame_id="-1" name="亚季奈"   text="『呜啊啊……嗯，啊，啊，啊，啊啊！！』" voices="akina00450"/><msg @l="200" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯哼……啊，啊，啊啊……好……好啊……。』" voices="akina00870"/><msg @l="202" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯噗……嗯，啾……嗯嗯……舔……舔……。』" voices="akina03780"/><msg @l="204" char_id="-1" frame_id="-1" name="游泳部员B"   text="『哇啊，果然亚季奈酱口活很棒啊。』" voices=""/><msg @l="206" char_id="-1" frame_id="-1" name="游泳部员C"   text="『是啊，亚季奈酱舔肉棒时的表情我也很喜欢啊。』" voices=""/><msg @l="208" char_id="2" frame_id="-1" name="亚季奈"   text="『因为嘛……这个，我超喜欢的～啊。』" voices="akina03920"/><msg @l="210" char_id="-1" frame_id="-1" name=""   text="听到游泳部员们的话，亚季奈高兴地更加激烈地吮吸起来。" voices=""/><msg @l="212" char_id="2" frame_id="-1" name="亚季奈"   text="『啊～呜……啾噗啾噗啾噗………啾，啾噜噜噜。』" voices="akina03980"/><msg @l="214" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯咕，嗯啾，啾噗，啾噗，啾噗……嗯噗啊！』" voices="akina03990"/><msg @l="216" char_id="2" frame_id="-1" name="亚季奈"   text="『好厉害，变得这么硬邦邦的……嗯哈……舔，舔。』" voices="akina04010"/><msg @l="218" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯呼……啊呼……嗯咕，嗯噗，嗯噗……噗啊。』" voices="akina04000"/><msg @l="220" char_id="-1" frame_id="-1" name=""   text="不知何时，泳池周围已经聚集了许多部员，都在观看亚季奈给予奖励的场景。其中甚至有人一边看着奖励S●X的样子一边自●。"   voices=""/><msg @l="221" char_id="-1" frame_id="-1" name=""   text="大家似乎都拼命想要一睹亚季奈的模样。" voices=""/><msg @l="224" char_id="-1" frame_id="-1" name="游泳部员A"   text="『哇哦……！？我，我快射了！』" voices=""/><msg @l="226" char_id="-1" frame_id="-1" name="游泳部员B" text="『我也要射了！』"   voices=""/><msg @l="228" char_id="-1" frame_id="-1" name=""   text="让亚季奈口交的部员们已经到达了忍耐的极限。" voices=""/><msg @l="230" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯呼……可以哦，射吧……嗯啾……。』" voices="akina04250"/><msg @l="232" char_id="2" frame_id="-1" name="亚季奈"   text="『就这样……嗯，在我的嘴巴和脸上射满牛奶吧。』" voices="akina04260"/><msg @l="234" char_id="-1" frame_id="-1" name="游泳部员A"   text="『那么，我们一起射吧！』" voices=""/><msg @l="236" char_id="-1" frame_id="-1" name=""   text="正在贯穿亚季奈秘缝的部员对其他部员说道。" voices=""/><msg @l="238" char_id="2" frame_id="-1" name="亚季奈"   text="『好……好啊……来啊……再深一点！！』" voices="akina00900"/><msg @l="240" char_id="2" frame_id="-1" name="亚季奈"   text="『啊呜，里面，射在里面……嗯嗯……要来了，要来了！！』" voices="akina00910"/><msg @l="243" char_id="-1" frame_id="-1" name="游泳部员B" text="『要，要射了！』"   voices=""/><msg @l="245" char_id="-1" frame_id="-1" name="游泳部员C" text="『我也是！』"   voices=""/><msg @l="247" char_id="-1" frame_id="-1" name="游泳部员A"   text="『要满满地内射了！！』" voices=""/><msg @l="249" char_id="2" frame_id="-1" name="亚季奈" text="『嗯，啊啊啊啊啊！！』"   voices="akina00340"/><flash @l="253" count="4" fade="100" image="white"/><msg @l="255" char_id="2" frame_id="-1" name="亚季奈"   text="『去了……要去了……啊，嗯嗯……呼啊啊啊！！』" voices="akina00920"/><flash @l="259" count="4" fade="100" image="white"/><clear @l="265" class="all"/><msg @l="267" char_id="-1" frame_id="-1" name="游泳部员A"   text="『呜哇，好舒服！亚季奈酱的小穴把我榨干了。』" voices=""/><msg @l="269" char_id="-1" frame_id="-1" name="游泳部员B" text="『喂，该换人了吧。』"   voices=""/><msg @l="271" char_id="-1" frame_id="-1" name="游泳部员C" text="『下一个是我！』"   voices=""/><msg @l="273" char_id="-1" frame_id="-1" name="游泳部员A"   text="『那么，我就插后面好了』" voices=""/><msg @l="275" char_id="2" frame_id="-1" name="亚季奈" text="『啊———————！？』"   voices="akina00730"/><msg @l="277" char_id="2" frame_id="-1" name="亚季奈"   text="『不要……那里……不行，痛……好痛……呜呜！！』" voices="akina00700"/><msg @l="279" char_id="-1" frame_id="-1" name="游泳部员C"   text="『什么，亚季奈酱后面是第一次啊。那么我就收下这个后面的第一次了！』" voices=""/><msg @l="281" char_id="-1" frame_id="-1" name="游泳部员B" text="『喂，只有你占便宜太狡猾了！』"   voices=""/><msg @l="283" char_id="-1" frame_id="-1" name="游泳部员C" text="『对、对啊！』"   voices=""/><msg @l="285" char_id="-1" frame_id="-1" name=""   text="———就这样亚季奈每天都在泳池里过着S●X不断的生活———" voices=""/><clear @l="293" class="all"/><end_scene @l="296"/><msgshow @l="299" show="true"/><bgm @l="303" src="bgm05" volume="1."/><wait_chgmv/><bg @l="307" src="bg18a"/><msg @l="309" char_id="0" frame_id="1" name="美帆"   text="（呵呵……亚季奈，不知道有没有好好服侍游泳部的大家呢）" voices=""/><msg @l="311" char_id="-1" frame_id="-1" name=""   text="想象着亚季奈的“工作”，我微微一笑。" voices=""/><msg @l="312" char_id="-1" frame_id="-1" name=""   text="如果那孩子能作为南总町的居民出色地提供服务，作为姐姐的我也就放心了。" voices=""/><msg @l="314" char_id="0" frame_id="1" name="美帆"   text="（啊呀，光是想象亚季奈在泳池里做的事情就湿了。）" voices=""/><msg @l="316" char_id="0" frame_id="1" name="美帆" text="（有没有人能和我做爱呢。）"   voices=""/><msg @l="318" char_id="-1" frame_id="-1" name=""   text="一边想着这些事一边环顾四周，进入视线的是一位穿着求职西装的女孩。" voices=""/><msg @l="320" char_id="0" frame_id="1" name="美帆"   text="（说起来，我也该认真找工作了……）" voices=""/><msg @l="322" char_id="-1" frame_id="-1" name=""   text="美帆想起了正好一年前玲正在找工作的事情。" voices=""/><msg @l="324" char_id="0" frame_id="1" name="美帆"   text="（…玲，你现在过得怎么样呢。刚刚通电话时你听起来很有活力，想必正在享受愉快的OL生活吧。）"   voices=""/><msg @l="326" char_id="-1" frame_id="-1" name=""   text="我回想起玲决定正式加入大黑建设的事情。" voices=""/><msg @l="327" char_id="-1" frame_id="-1" name=""   text="自从确定进入大黑建设后，因为搬进了公司宿舍，我们不能总是在一起，但现在仍然偶尔保持联系。"   voices=""/><msg @l="328" char_id="-1" frame_id="-1" name=""   text="据说她刚入职就立刻被选为一个大型交易的演讲负责人。" voices=""/><msg @l="329" char_id="-1" frame_id="-1" name=""   text="如果是玲的话，大概能轻松应对任何工作吧。" voices=""/><msg @l="331" char_id="-1" frame_id="-1" name=""   text="说起来，前不久通电话时玲学姐邀请我去大黑建设。" voices=""/><msg @l="333" char_id="0" frame_id="1" name="美帆"   text="（大黑建设吗…该怎么办呢，要不要去应聘看看呢……）" voices=""/><msg @l="335" char_id="-1" frame_id="-1" name=""   text="美帆仰望着天空思考着这些事情———" voices=""/><stopbgm @l="339" fadeout="1000"/><clear @l="345" class="all"/><msgshow @l="347" show="true"/><msg @l="349" char_id="-1" frame_id="-1" name=""   text="…………………………。" voices=""/><msg @l="350" char_id="-1" frame_id="-1" name=""   text="…………………。" voices=""/><msg @l="351" char_id="-1" frame_id="-1" name="" text="……………。"   voices=""/><bgm @l="355" src="bgm07" volume="1."/><wait_chgmv/><bg @l="359" src="bg17a"/><msg @l="361" char_id="-1" frame_id="-1" name="大黑"   text="『那么接下来，将由我公司引以为豪的新秀，白石君为大家进行展示。』" voices=""/><msg @l="363" char_id="-1" frame_id="-1" name="" text="大黑的声音透过接待室的门传了过来。"   voices=""/><msg @l="364" char_id="-1" frame_id="-1" name=""   text="目前大黑建设正在接待国家官员的来访，官员们正在观摩下一个公共工程的投标展示。" voices=""/><msg @l="365" char_id="-1" frame_id="-1" name=""   text="当然，如果被选为公共工程的承包商，大黑建设将在同行竞争中获得巨大优势。" voices=""/><clear @l="373" class="all"/><label @l="376" id="event_scene68"/><msg @l="379" char_id="1" frame_id="-1" name="玲"   text="『我是刚才介绍的白石玲……请多关照。』" voices=""/><msg @l="381" char_id="-1" frame_id="-1" name=""   text="说着，玲优雅地站起身来，缓缓走向接待室深处设置的投影屏幕前。" voices=""/><label @l="385" id="chart_line66"/><wait_chgmv/><ev @l="389" src="ev-068"/><msg @l="391" char_id="-1" frame_id="-1" name=""   text="在昏暗的房间里，当玲在投影仪的光线前转身时，来访的官员们不禁发出“哦”的赞叹声。"   voices=""/><msg @l="392" char_id="-1" frame_id="-1" name=""   text="玲所穿的西装几乎被光线照透，西装下隐藏的肌肤清晰地显现出来。" voices=""/><msg @l="393" char_id="-1" frame_id="-1" name="" text="而且……玲没有穿内衣。"   voices=""/><msg @l="394" char_id="-1" frame_id="-1" name=""   text="胸前的乳头，腰部的线条，一切都一览无余地展露出来。" voices=""/><msg @l="396" char_id="1" frame_id="-1" name="玲"   text="『那么，首先请看这个项目。』" voices=""/><msg @l="398" char_id="-1" frame_id="-1" name=""   text="玲没有因官员们的目光而感到困扰，平静地开始了演示。" voices=""/><msg @l="399" char_id="-1" frame_id="-1" name=""   text="然而……这些男人们根本没有余力去倾听玲所说的话。" voices=""/><msg @l="400" char_id="-1" frame_id="-1" name=""   text="他们只是热切地将目光注视着玲的身体。" voices=""/><msg @l="402" char_id="-1" frame_id="-1" name="官僚"   text="『哈，哈哈……虽然早有耳闻，但这真是……』" voices=""/><msg @l="404" char_id="-1" frame_id="-1" name="官僚" text="『太令人难以抗拒了……』"   voices=""/><msg @l="406" char_id="-1" frame_id="-1" name=""   text="在官员们炙热的目光下，玲的私密处发出了“咕啾”的湿润声音。" voices=""/><msg @l="407" char_id="-1" frame_id="-1" name="" text="听到这声音，官员们发出了欢呼。"   voices=""/><msg @l="409" char_id="-1" frame_id="-1" name="官僚"   text="『哦——刚才听到了淫靡的声音啊——』" voices=""/><msg @l="411" char_id="-1" frame_id="-1" name="官僚"   text="『确实如此啊——我认为这是演示中非常重要的声音，必须靠近一点才能听清……』" voices=""/><msg @l="413" char_id="-1" frame_id="-1" name=""   text="说着，演示开始不到五分钟，这些男人们就纷纷起身，开始聚集在玲的周围。" voices=""/><msg @l="414" char_id="-1" frame_id="-1" name=""   text="不久，仅仅看着已经无法满足他们，一个接一个地向隐藏在西装下的玲的身体伸出手，开始用指尖缠绕起来。"   voices=""/><msg @l="416" char_id="1" frame_id="-1" name="玲"   text="『呵呵……这就是我们公司为您准备的特别服务。』" voices=""/><msg @l="418" char_id="1" frame_id="-1" name="玲"   text="『请尽情享用后，也请在工作上多多关照呢。』" voices=""/><msg @l="420" char_id="-1" frame_id="-1" name=""   text="玲就这样被男人们戏弄着，却依然保持着妩媚的微笑，自己摆动着腰肢，迎合着男人们的手指进入她的私处。" voices=""/><msg @l="422" char_id="-1" frame_id="-1" name="官僚"   text="『哈哈哈，这服务真不错啊。比其他公司领先一步了。』" voices=""/><msg @l="424" char_id="-1" frame_id="-1" name="官僚"   text="『嗯——不过啊——感觉还差那么一点点啊——』" voices=""/><msg @l="426" char_id="-1" frame_id="-1" name=""   text="官僚们隔着衣服揉捏着玲的胸部，捏住她的乳头并扭转着。" voices=""/><msg @l="428" char_id="1" frame_id="-1" name="玲" text="『嗯，嗯嗯！！』" voices=""/><msg @l="430" char_id="-1" frame_id="-1" name=""   text="还有另一个人则把脸贴在紧身裙上方的下腹部摩擦，手伸进裙子里面摸索着她的私处。" voices=""/><msg @l="432" char_id="1" frame_id="-1" name="玲"   text="『嗯嗯，真舒服啊——我们公司的服务正如各位现在体验的那样，越用越能感受到它的好处，所以请多多使用哦。』"   voices=""/><msg @l="434" char_id="-1" frame_id="-1" name=""   text="玲这样说着，用空闲的手抚摸上正在揉捏她胸部的男人的胯下。" voices=""/><msg @l="436" char_id="-1" frame_id="-1" name="官僚"   text="『哦哦！你真是充满干劲啊。这服务质量很高啊。一定要拜托你们下次再来。』" voices=""/><msg @l="438" char_id="-1" frame_id="-1" name="官僚"   text="『真不错啊，我也正在考虑这个。』" voices=""/><msg @l="440" char_id="-1" frame_id="-1" name="官僚"   text="『大黑君，可以吗？让我们试试下一个服务？』" voices=""/><msg @l="442" char_id="-1" frame_id="-1" name="大黑"   text="『请便，请便。请随意尝试。我们能够应对任何服务需求。甚至是●馈服务也可以……。』"   voices=""/><msg @l="444" char_id="-1" frame_id="-1" name="官僚" text="『哦哦！真的吗！？』"   voices=""/><msg @l="446" char_id="-1" frame_id="-1" name="官僚"   text="『那么，就让我们马上试试吧。』" voices=""/><msg @l="448" char_id="-1" frame_id="-1" name="官僚" text="『就这么办，就这么办。』"   voices=""/><msg @l="450" char_id="1" frame_id="-1" name="玲" text="『啊………。』"   voices=""/><clear @l="456" class="all"/><msg @l="458" char_id="-1" frame_id="-1" name=""   text="官僚们说着就把玲推倒，撕破她的衣服脱光后开始侵犯她。" voices=""/><msg @l="459" char_id="-1" frame_id="-1" name="" text="大黑满意地看着这一幕。"   voices=""/><msg @l="461" char_id="-1" frame_id="1" name="大黑"   text="（呵呵，那位校园女神玲为了拿到工作居然到了出卖身体的地步……正是想看到她这副模样啊……这堕落的样子。）"   voices=""/><msg @l="462" char_id="-1" frame_id="1" name="大黑"   text="（而且她现在在为曾经用看虫子般的眼神看待的我的公司利益而工作……这大合同看来也能拿下了……我感觉真是太棒了。）"   voices=""/><msg @l="463" char_id="-1" frame_id="1" name="大黑"   text="（今后也请您继续“各种”配合啊……玲小姐……）" voices=""/><msg @l="465" char_id="-1" frame_id="-1" name=""   text="大黑一边在心里低语，一边看着玲被侵犯的场景……。" voices=""/><stopbgm @l="470" fadeout="1000"/><clear @l="476" class="all"/><end_scene @l="479"/><msgshow @l="482" show="true"/><msg @l="484" char_id="0" frame_id="1" name="美帆"   text="（嗯——虽然和玲小姐一起工作也不错，但我更倾向于能在外面进行很多羞耻游戏式色情活动的公司呢。）"   voices=""/><msg @l="486" char_id="-1" frame_id="-1" name=""   text="美帆其实是想成为女主播，在现场报道中与各行各业的许多人交配，所以她才应聘电视台。" voices=""/><msg @l="488" char_id="0" frame_id="1" name="美帆" text="（该怎么办呢～）"   voices=""/><msg @l="490" char_id="-1" frame_id="-1" name="？？？" text="『········嗯。』"   voices=""/><msg @l="492" char_id="-1" frame_id="-1" name="？？？" text="『······姐姐。』"   voices=""/><msg @l="494" char_id="-1" frame_id="-1" name="？？？" text="『姐姐！』"   voices=""/><msg @l="496" char_id="0" frame_id="1" name="美帆" text="『啊····。』" voices=""/><bgm @l="500" src="bgm06" volume="1."/><wait_chgmv/><bg @l="504" src="bg18a"/><char @l="508" id="akina" pos="auto" src="akina054"/><msg @l="510" char_id="2" frame_id="-1" name="亚季奈" text="『别'啊'了好吗。』"   voices=""/><msg @l="512" char_id="2" frame_id="-1" name="亚季奈"   text="『我都叫你好几次了，你竟然完全没注意到，太过分了～。』" voices=""/><msg @l="514" char_id="0" frame_id="1" name="美帆" text="『抱歉，抱歉啦。』"   voices=""/><msg @l="516" char_id="0" frame_id="1" name="美帆" text="『亚季奈，你要去哪里？』"   voices=""/><char @l="520" id="akina" pos="auto" src="akina051"/><msg @l="522" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯，现在课程结束了，我要再去游泳池做S●X。』" voices=""/><char @l="526" id="akina" pos="auto" src="akina150"/><msg @l="528" char_id="2" frame_id="-1" name="亚季奈"   text="『话说，姐姐······你那副打扮。』" voices=""/><msg @l="530" char_id="-1" frame_id="-1" name=""   text="亚季奈边说边从上到下打量着我的衣服，仿佛在抚摸一般。" voices=""/><msg @l="531" char_id="-1" frame_id="-1" name=""   text="我现在穿着的是一件连衣裙，布料薄到身体的曲线和肌肤都清晰可见。" voices=""/><msg @l="532" char_id="-1" frame_id="-1" name=""   text="而且因为没穿内衣，连乳头和覆盖私处的阴毛都若隐若现地透了出来。" voices=""/><msg @l="534" char_id="0" frame_id="1" name="美帆" text="『呵呵……好看吗？』" voices=""/><char @l="538" id="akina" pos="auto" src="akina052"/><msg @l="540" char_id="2" frame_id="-1" name="亚季奈" text="『姐姐好色～，真好呀～。』"   voices=""/><msg @l="542" char_id="0" frame_id="1" name="美帆"   text="『说这话的亚季奈，不也准备了类似的吗？』" voices=""/><msg @l="544" char_id="-1" frame_id="-1" name=""   text="我看着亚季奈小心翼翼抱着的纸袋，笑了起来。" voices=""/><msg @l="545" char_id="-1" frame_id="-1" name="" text="那个纸袋是前面那家服装店的。"   voices=""/><char @l="549" id="akina" pos="auto" src="akina151"/><msg @l="551" char_id="2" frame_id="-1" name="亚季奈" text="『嘿嘿～，其实是这样的～。』"   voices=""/><msg @l="553" char_id="-1" frame_id="-1" name=""   text="亚季奈微微羞涩地从纸袋中取出刚刚才拿到的新衣服给我看。" voices=""/><char @l="557" id="akina" pos="auto" src="akina051"/><msg @l="559" char_id="2" frame_id="-1" name="亚季奈"   text="『你看～，我的制服，超透的哦～。』" voices=""/><msg @l="561" char_id="0" frame_id="1" name="美帆" text="『我们穿着同款透视装呢。』"   voices=""/><msg @l="563" char_id="2" frame_id="-1" name="亚季奈" text="『嗯。』" voices=""/><bgm @l="566" src="bgm03" volume="1."/><msg @l="568" char_id="-1" frame_id="-1" name="大学生"   text="『哦，这不是美帆吗。你在这干嘛呢？』" voices=""/><msg @l="570" char_id="-1" frame_id="-1" name=""   text="从抱着新制服兴奋不已的亚季奈身后，美帆的三个男同学向她们打招呼。" voices=""/><msg @l="572" char_id="0" frame_id="1" name="美帆"   text="『嗯～，我正在跟妹妹亚季奈聊天呢。』" voices=""/><msg @l="574" char_id="2" frame_id="-1" name="亚季奈"   text="『哈～原来如此。让我看看…。』" voices=""/><msg @l="576" char_id="-1" frame_id="-1" name=""   text="美帆的同学说完，像是在估价般打量着亚季奈的身体。" voices=""/><msg @l="578" char_id="-1" frame_id="-1" name="大学生"   text="『哦～，真可爱啊～，亚季奈酱。去那边的公园强奸她吧。』" voices=""/><char @l="582" id="akina" pos="auto" src="akina150"/><msg @l="584" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯，可以哦，不过要等我换上这件透视制服再说。』" voices=""/><msg @l="586" char_id="-1" frame_id="-1" name="大学生"   text="『哦～，那太棒了，那就三个人一起来吧。』" voices=""/><char @l="590" id="akina" pos="auto" src="akina152"/><msg @l="592" char_id="2" frame_id="-1" name="亚季奈"   text="『呵呵，好啊。不过作为交换，要尽情激烈点哦。』" voices=""/><clear @l="596" class="char"/><msg @l="598" char_id="-1" frame_id="-1" name=""   text="就这样，亚季奈被三个男生围着，一起走向车站前一角建造的公园。" voices=""/><msg @l="600" char_id="0" frame_id="1" name="美帆"   text="『呵呵……看来她已经完全能胜任南总町居民的工作了呢。』" voices=""/><msg @l="602" char_id="-1" frame_id="-1" name=""   text="我注视着亚季奈渐行渐远的背影，开心地目送她离开。" voices=""/><clear @l="608" class="all"/><label @l="611" id="event_scene72"/><msgshow @l="614" show="true"/><bgm @l="616" src="bgm07" volume="1."/><label @l="620" id="chart_line67"/><msg @l="622" char_id="2" frame_id="-1" name="亚季奈" text="『我准备好了哦～』"   voices=""/><msg @l="624" char_id="-1" frame_id="-1" name=""   text="说着，亚季奈在大学生们面前换上了透视制服，摆了个姿势。" voices=""/><msg @l="625" char_id="-1" frame_id="-1" name=""   text="换衣服时，她没有穿回胸罩和内裤，所以在夕阳的逆光下，她的身体若隐若现，乳头和私密部位都能隐约看见。" voices=""/><msg @l="627" char_id="-1" frame_id="-1" name="大学生A"   text="『哦～，可等你好久了，亚季奈酱。』" voices=""/><msg @l="629" char_id="-1" frame_id="-1" name="大学生B"   text="『虽然强奸美帆姐姐的大奶子也很爽，但贫乳萝莉看起来也很美味啊～。』" voices=""/><msg @l="631" char_id="2" frame_id="-1" name="亚季奈"   text="『哼，现在是贫乳没错，但只要让你们多揉一揉就会变大的。』" voices=""/><msg @l="633" char_id="-1" frame_id="-1" name="大学生C"   text="『好啦好啦，先别管这个，赶紧开始吧。我会好好揉你让它变大的。』" voices=""/><msg @l="635" char_id="2" frame_id="-1" name="亚季奈" text="『知道啦～。』"   voices=""/><msg @l="637" char_id="2" frame_id="-1" name="亚季奈"   text="『喂，你就躺那边吧～。我想试试在上面的感觉。』" voices=""/><msg @l="639" char_id="-1" frame_id="-1" name="大学生C"   text="『嘿嘿，那我就躺下面好了。』" voices=""/><msg @l="641" char_id="-1" frame_id="-1" name=""   text="说着，大学生躺下来，从裤子里掏出肉棒。那肉棒一跳一跳地搏动着，高高翘起指向天空。" voices=""/><msg @l="643" char_id="2" frame_id="-1" name="亚季奈"   text="『好厉害～。哥哥的是我见过最大的呢～。』" voices=""/><msg @l="645" char_id="-1" frame_id="-1" name="大学生A"   text="『喂，现在可不是感叹的时候。快点也帮我们口交啊。』" voices=""/><msg @l="647" char_id="2" frame_id="-1" name="亚季奈" text="『啊，稍等一下～。』"   voices=""/><wait_chgmv/><ev @l="651" src="ev-072"/><msg @l="653" char_id="-1" frame_id="-1" name=""   text="亚季奈说着，用手指分开自己的秘部，慢慢沉下腰，将躺着的大学生的肉棒纳入体内。" voices=""/><msg @l="655" char_id="-1" frame_id="-1" name="" text="噗嗤噗嗤噗嗤噗嗤噗嗤噗嗤"   voices=""/><msg @l="657" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯～，好、好大啊～～！！』" voices=""/><msg @l="659" char_id="-1" frame_id="-1" name=""   text="亚季奈的秘缝被撑开到难以想象的程度。" voices=""/><msg @l="661" char_id="-1" frame_id="-1" name="大学生B"   text="『嘿嘿，有空说话不如含住我的。』" voices=""/><msg @l="663" char_id="2" frame_id="-1" name="亚季奈"   text="『好～的……啊呜，嗯……啾……啾噜，嗯噗，嗯噗！』" voices=""/><msg @l="665" char_id="-1" frame_id="-1" name="大学生C"   text="『喂，腰也动一动啊。不那样的话可不会舒服的。』" voices=""/><msg @l="667" char_id="2" frame_id="-1" name="亚季奈"   text="『可是……嗯嗯，可是……嗯，嗯嗯……。』" voices=""/><msg @l="669" char_id="-1" frame_id="-1" name="大学生C"   text="『看来骑乘位是第一次吧，亚季奈酱。那今天我特别帮你一下，不过之后要好好向美帆姐姐学习哦。美帆姐姐可是很厉害的～。』"   voices=""/><msg @l="671" char_id="-1" frame_id="-1" name=""   text="大学生说完便开始激烈地摆动腰部，从下面顶弄亚季奈。" voices=""/><msg @l="673" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯呼……啊，好棒，那里再多顶一顶～。』" voices=""/><msg @l="675" char_id="2" frame_id="-1" name="亚季奈"   text="『好～好舒服～～～来～～～再深一点！！』" voices=""/><msg @l="677" char_id="-1" frame_id="-1" name=""   text="亚季奈跨坐在男人身上自己扭动着腰，发出妩媚的声音。" voices=""/><msg @l="678" char_id="-1" frame_id="-1" name=""   text="透过肌肤若隐若现的制服凌乱不堪，她贪婪地追求快感的样子，与她幼小的容貌形成鲜明对比，显得格外妩媚。" voices=""/><msg @l="680" char_id="-1" frame_id="-1" name="大学生A"   text="『嘿嘿～～那小小的小穴完全吃进去了呢。』" voices=""/><msg @l="682" char_id="2" frame_id="-1" name="亚季奈"   text="『讨厌～，不要说这种话嘛～。』" voices=""/><msg @l="684" char_id="-1" frame_id="-1" name="大学生B"   text="『说什么呢，明明是你自己在动腰啊。』" voices=""/><msg @l="686" char_id="-1" frame_id="-1" name="大学生C" text="『啊，真是个了不起的淫乱啊。』"   voices=""/><msg @l="688" char_id="2" frame_id="-1" name="亚季奈"   text="『因为～～～我喜欢这个嘛。』" voices=""/><msg @l="690" char_id="-1" frame_id="-1" name=""   text="亚季奈一边这样说着，双手各握住一根热烈勃起的男根，陶醉的表情下将唇凑上去，含入口腔中吮吸。"   voices=""/><msg @l="692" char_id="2" frame_id="-1" name="亚季奈"   text="『啊呜～～嗯，啾噗～～～嗯，嗯～～～～啾噗噗。』" voices=""/><msg @l="694" char_id="-1" frame_id="-1" name="" text="亚季奈发出淫猥的水声，舔舐着男根。"   voices=""/><msg @l="695" char_id="-1" frame_id="-1" name=""   text="她那染上欢喜的表情，散发出深不见底的贪婪。" voices=""/><msg @l="697" char_id="-1" frame_id="-1" name="大学生B" text="『真棒啊……相当厉害嘛。』"   voices=""/><msg @l="699" char_id="-1" frame_id="-1" name="大学生B"   text="『舌尖缠绕着……唔，感觉要被榨干了。比姐姐还厉害吧？』" voices=""/><msg @l="701" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯哼哼哼……我真的会把你榨干的哦。』" voices=""/><msg @l="703" char_id="-1" frame_id="-1" name=""   text="亚季奈微微眯起眼睛，恶作剧般地笑着。" voices=""/><msg @l="704" char_id="-1" frame_id="-1" name=""   text="然后，一边用舌尖舔弄着口中含着的前端部分，一边吮吸着。" voices=""/><msg @l="706" char_id="-1" frame_id="-1" name="大学生C"   text="『喂……别光顾着上面的嘴巴享乐，这边也要好好服务啊。』" voices=""/><msg @l="708" char_id="2" frame_id="-1" name="亚季奈" text="『嗯啊啊！』" voices=""/><msg @l="710" char_id="-1" frame_id="-1" name="" text="男人用力从下面顶了上来。"   voices=""/><msg @l="711" char_id="-1" frame_id="-1" name=""   text="当龟头顶到子宫口时，亚季奈发出销魂的呻吟，身体不禁扭动起来。" voices=""/><msg @l="713" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯啊……刚才那个……再多来点。』" voices=""/><msg @l="715" char_id="-1" frame_id="-1" name="大学生C"   text="『想要我插到最深处的话就给我用小穴好好夹紧。』" voices=""/><msg @l="717" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯，我会夹紧的……小穴会好好夹紧的，像刚才那样顶到最里面嘛。』" voices=""/><msg @l="719" char_id="-1" frame_id="-1" name="大学生C"   text="『这种对自己坦诚的家伙……我还挺喜欢的。』" voices=""/><msg @l="721" char_id="-1" frame_id="-1" name=""   text="男人嘴角扭曲着低语，随即再次挺动腰部，贯穿亚季奈的秘处。" voices=""/><msg @l="723" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯啊啊啊……啊，好棒……好舒服，嗯嗯，呜啊！』" voices=""/><msg @l="725" char_id="-1" frame_id="-1" name="大学生B"   text="『喂，上面的嘴也得好好努力才行啊。』" voices=""/><msg @l="727" char_id="-1" frame_id="-1" name="大学生A"   text="『也得好好地把我的东西伺候好啊。』" voices=""/><msg @l="729" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯，嗯……我会做的……嗯，嗯啊啊啊！！』" voices=""/><msg @l="731" char_id="-1" frame_id="-1" name=""   text="亚季奈在被顶弄的快感中颤抖着，向嘴边伸出的男根伸出舌尖试图舔舐。" voices=""/><msg @l="732" char_id="-1" frame_id="-1" name=""   text="但是，下面的男人像是要妨碍她一样，猛烈地顶撞着她的秘部，使她无法好好地含住。" voices=""/><msg @l="734" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯啊啊啊……不行啊………嗯，没法好好含住啊。』" voices=""/><msg @l="736" char_id="-1" frame_id="-1" name="大学生B"   text="『哦哦，看她拼命伸出舌头的样子。』" voices=""/><msg @l="738" char_id="-1" frame_id="-1" name="大学生A"   text="『说明她骨子里就是喜欢肉棒吧。跟你姐姐一个样！』" voices=""/><msg @l="740" char_id="-1" frame_id="-1" name=""   text="男人们露出下流的笑容，吐出这些话语。" voices=""/><msg @l="741" char_id="-1" frame_id="-1" name=""   text="然而，亚季奈根本不在意这些话语……只是继续扭动着腰肢，仿佛要贪婪地享受这快乐。" voices=""/><msg @l="743" char_id="-1" frame_id="-1" name="大学生B" text="『我要射了！』"   voices=""/><msg @l="745" char_id="-1" frame_id="-1" name="大学生A"   text="『我也是，要把你的脸射得满满的！』" voices=""/><msg @l="747" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯嗯……射吧，在我的嘴里和脸上射满牛奶吧。』" voices=""/><msg @l="749" char_id="-1" frame_id="-1" name="大学生C"   text="『给你，我要射在最深处了！』" voices=""/><msg @l="751" char_id="2" frame_id="-1" name="亚季奈" text="『嗯，来吧，快来啊！！』"   voices=""/><flash @l="755" count="4" fade="100" image="white"/><msg @l="757" char_id="2" frame_id="-1" name="亚季奈"   text="『啊呜，深，射在深处吧……嗯嗯……要来了，要来了！！』" voices=""/><flash @l="761" count="4" fade="100" image="white"/><msg @l="763" char_id="-1" frame_id="-1" name="" text="亚季奈带着陶醉的表情叫喊着。"   voices=""/><msg @l="764" char_id="-1" frame_id="-1" name=""   text="插入她花唇的男人露出满足的表情，更加剧烈地摆动腰部，摩擦着那溢出蜜液的膣内。" voices=""/><msg @l="765" char_id="-1" frame_id="-1" name="" text="一直，一直地持续着。"   voices=""/><msg @l="766" char_id="-1" frame_id="-1" name=""   text="从被夕阳照耀的公园里，回荡着亚季奈妩媚的声音。" voices=""/><stopbgm @l="770" fadeout="1000"/><clear @l="776" class="all"/><end_scene @l="779"/><msgshow @l="782" show="true"/><msg @l="784" char_id="0" frame_id="1" name="美帆"   text="『呵呵，亚季奈真是感觉那么强烈啊……。』" voices=""/><msg @l="786" char_id="0" frame_id="1" name="美帆"   text="『看起来很舒服的样子……好羡慕……。』" voices=""/><label @l="789" id="event_scene61"/><wait_chgmv/><bg @l="793" src="bg18a"/><msg @l="795" char_id="0" frame_id="1" name="美帆" text="『………。』" voices=""/><msg @l="797" char_id="0" frame_id="1" name="美帆" text="『差不多该是时候了吧……？』"   voices=""/><msg @l="799" char_id="-1" frame_id="-1" name=""   text="我看了看手机屏幕确认时间，然后朝车站走去。" voices=""/><msg @l="800" char_id="-1" frame_id="-1" name=""   text="途中，虽然有好几个男人向我搭讪，但现在比起为镇里服务，我还有更重要的事情要做，所以让他们改天再说。"   voices=""/><se @l="804" buf="1" src="電車停止" volume="1."/><stopse @l="808" buf="3"/><msg @l="810" char_id="0" frame_id="1" name="美帆" text="『啊……就是那辆电车啊。』"   voices=""/><msg @l="812" char_id="-1" frame_id="-1" name=""   text="从外面来的电车到站了，大批的人从里面下车。" voices=""/><msg @l="813" char_id="-1" frame_id="-1" name=""   text="他们都是今年刚转入大学的新生。" voices=""/><msg @l="814" char_id="-1" frame_id="-1" name=""   text="电车停在站台片刻后，一个肩上挎着大包的女孩走了下来。" voices=""/><msg @l="816" char_id="-1" frame_id="-1" name="女孩" text="『……。』" voices=""/><msg @l="818" char_id="0" frame_id="1" name="美帆" text="『呵呵，就是那个女孩呢。』" voices=""/><msg @l="820" char_id="-1" frame_id="-1" name=""   text="就这样，在川流不息的人群中，我找到了等待的那个人的身影。" voices=""/><msg @l="821" char_id="-1" frame_id="-1" name=""   text="我拿出之前收到的照片进行比对。" voices=""/><msg @l="822" char_id="-1" frame_id="-1" name="" text="———毫无疑问。" voices=""/><msg @l="824" char_id="-1" frame_id="-1" name="女孩" text="『……。』" voices=""/><msg @l="826" char_id="-1" frame_id="-1" name=""   text="那个女孩东张西望地环顾四周。" voices=""/><msg @l="827" char_id="-1" frame_id="-1" name=""   text="她大概是在……寻找约定来接她的我吧。" voices=""/><label @l="831" id="chart_line68"/><wait_chgmv/><ev @l="835" src="ev-061"/><msg @l="837" char_id="0" frame_id="1" name="美帆" text="『呵呵……青涩可爱。』"   voices="miho13470"/><msg @l="839" char_id="-1" frame_id="-1" name=""   text="我带着妖艳的微笑低语着，向她走去。" voices=""/><bgm @l="843" src="bgm16" volume="1."/><msg @l="845" char_id="0" frame_id="1" name="美帆" text="『欢迎来到南总町。』"   voices="miho13480"/><msg @l="847" char_id="-1" frame_id="-1" name="女孩" text="『啊……您是仲根小姐吗？』"   voices=""/><msg @l="849" char_id="-1" frame_id="-1" name=""   text="我站在困惑地望着这边的新生面前，露出妖艳的微笑。" voices=""/><msg @l="852" char_id="0" frame_id="1" name="美帆"   text="『你……是要搬到307号房间的人吧？』" voices=""/><msg @l="854" char_id="-1" frame_id="-1" name="女孩" text="『啊……嗯，是的。』"   voices=""/><msg @l="856" char_id="0" frame_id="1" name="美帆"   text="『嗯，我是从今天开始成为你室友的仲根美帆。请多指教哦。』" voices="miho13490"/><msg @l="858" char_id="-1" frame_id="-1" name="女孩" text="『请、请多指教……。』"   voices=""/><msg @l="860" char_id="-1" frame_id="-1" name=""   text="她这样说着，努力想挤出一个生硬的笑容。" voices=""/><msg @l="861" char_id="-1" frame_id="-1" name=""   text="然而，当她的视线投向我的衣着时，那笑容瞬间凝固……先是惊讶，接着脸变得通红低下了头。" voices=""/><msg @l="862" char_id="-1" frame_id="-1" name="" text="这样青涩的举止……真可爱。"   voices=""/><msg @l="864" char_id="0" frame_id="1" name="美帆" text="『呵呵。』"   voices="miho13500"/><msg @l="866" char_id="-1" frame_id="-1" name=""   text="我故意假装没注意到她的视线，继续说道。" voices=""/><msg @l="868" char_id="0" frame_id="1" name="美帆"   text="『欢迎来到这美妙的南总町。像你这样可爱的人一定会被作为优秀的南总町居民迎接的。』"   voices="miho13510"/><msg @l="870" char_id="-1" frame_id="-1" name=""   text="是啊，只要可爱，在这个小镇生活就是如此简单的事情。" voices=""/><msg @l="871" char_id="-1" frame_id="-1" name=""   text="而她现在所需要的，只是一个能引导她的存在……" voices=""/><msg @l="872" char_id="-1" frame_id="-1" name=""   text="在想象着她将来可能经历的种种官能体验时，我……已经湿润了自己的私处。"   voices=""/><msg @l="874" char_id="-1" frame_id="-1" name=""   text="一边静静地幻想着未来的日子，我再次说出了同样的话。" voices=""/><msg @l="876" char_id="0" frame_id="1" name="美帆" text="『欢迎来到南总町。』"   voices="miho13480"/><msg @l="878" char_id="-1" frame_id="-1" name="" text="是的，一切都将从这个小镇开始。"   voices=""/><msg @l="879" char_id="-1" frame_id="-1" name="" text="从今天这一天开始。"   voices=""/><msg @l="880" char_id="-1" frame_id="-1" name=""   text="那必将绚丽多彩的——充满官能的每一天。" voices=""/><stopbgm @l="884" fadeout="1000"/><clear @l="890" class="all"/><end_scene @l="893"/><call @l="896" target="EventLabel_154@staffroom"/><return @l="897" value="0&#13;&#10;"/><return @l="900" value=""/></code></xscript>																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																	