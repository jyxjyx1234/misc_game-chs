<?xml version="1.0" encoding="utf-8"?><xscript><debug editor="&quot;C:\Program&#32;Files&#32;(x86)\sakura\sakura.exe&quot;&#32;&quot;%src%&quot;&#32;-Y=%line%"   src="D:\シロップ\町ぐるみの罠＋汚された夏セット版\汚された夏\完成データ\汚された夏\script\text\root_kutuki05c.txt"/><code><label @l="10" id="EventLabel_129"/><description @l="13" text="契约的日子·第4天"/><eval @l="15" expr="f.numDay=10&#13;&#10;"/><msgshow @l="17" show="false"/><wait_chgmv/><bg @l="19" src="day10" time="2000"/><wait @l="21" time="500"/><wait_chgmv/><bg @l="23" src="black" time="2000"/><msgshow @l="25" show="true"/><bgm @l="28" src="bgm03" volume="1."/><wait_chgmv/><bg @l="31" src="bg05"/><char @l="34" id="miho" pos="auto" src="miho116"/><msg @l="36" char_id="0" frame_id="-1" name="美帆" text="『我出门了……』"   voices=""/><msg @l="38" char_id="-1" frame_id="-1" name=""   text="我从玄关外向房间深处小声说道。" voices=""/><msg @l="39" char_id="-1" frame_id="-1" name="" text="然后静静地关上门……锁好。"   voices=""/><msg @l="40" char_id="-1" frame_id="-1" name=""   text="也许是因为他睡得太晚了，到我出门的时间，前辈还在睡觉，无奈之下我只好准备好早餐就出门了。"   voices=""/><msg @l="42" char_id="0" frame_id="-1" name="美帆" text="『………』" voices=""/><msg @l="44" char_id="0" frame_id="-1" name="美帆" text="『……今天肯定也是。』"   voices=""/><msg @l="46" char_id="-1" frame_id="-1" name="" text="凝视着关闭的门，我轻轻地嘀咕着。"   voices=""/><msg @l="47" char_id="-1" frame_id="-1" name=""   text="只要坐上电车……朽木教授就会在那里等着，准备贪婪地占有我的身体。" voices=""/><msg @l="48" char_id="-1" frame_id="-1" name=""   text="即使知道这一点，今天我还是必须去那里。" voices=""/><msg @l="49" char_id="-1" frame_id="-1" name="" text="为了父亲……为了拯救家人。"   voices=""/><clear @l="52" class="all"/><wait_chgmv/><bg @l="55" src="bg18m1"/><char @l="58" id="miho" pos="auto" src="miho116"/><msg @l="60" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="62" char_id="-1" frame_id="-1" name=""   text="快到车站前时，我在人流中艰难地朝着站台前进。" voices=""/><msg @l="64" char_id="0" frame_id="-1" name="美帆"   text="（电车，好像已经来了……得快点）" voices=""/><msg @l="66" char_id="-1" frame_id="-1" name="" text="我加快脚步向站台走去。"   voices=""/><clear @l="69" class="all"/><label @l="72" id="event_scene11"/><se @l="75" buf="3" loop="true" src="電車走行中" volume="1."/><wait_chgmv/><ev @l="78" src="ev-005"/><msg @l="80" char_id="0" frame_id="-1" name="美帆" text="『……。』"   voices="miho09860"/><msg @l="82" char_id="-1" frame_id="-1" name="" text="熟悉的时间，熟悉的电车，熟悉的地点。"   voices=""/><msg @l="83" char_id="-1" frame_id="-1" name=""   text="在这个习以为常的空间里，今天我也依然身处其中。" voices=""/><msg @l="84" char_id="-1" frame_id="-1" name="" text="我曾经只想要平淡如常的每一天。"   voices=""/><msg @l="85" char_id="-1" frame_id="-1" name="" text="我曾经只想要无聊但不变的日子。"   voices=""/><msg @l="86" char_id="-1" frame_id="-1" name=""   text="望着窗外掠过的风景……我稍稍想到。" voices=""/><msg @l="88" char_id="0" frame_id="-1" name="美帆" text="（但是……已经，无法回头了）"   voices="miho09870"/><msg @l="90" char_id="-1" frame_id="-1" name="声音"   text="『你的脸色似乎一天比一天好了呢。』" voices=""/><msg @l="92" char_id="0" frame_id="-1" name="美帆" text="『……。』"   voices="miho09880"/><msg @l="94" char_id="-1" frame_id="-1" name="" text="我已经不会对那句话感到惊讶了。"   voices=""/><msg @l="95" char_id="-1" frame_id="-1" name="" text="窗户上……倒映着教授的身影。"   voices=""/><wait_chgmv/><ev @l="98" src="ev-005ax1"/><msg @l="100" char_id="-1" frame_id="-1" name="朽木"   text="『看起来很憔悴呢。你有好好睡觉吗？』" voices=""/><msg @l="102" char_id="-1" frame_id="-1" name=""   text="教授像是开玩笑似的，在我耳边低声细语。" voices=""/><msg @l="103" char_id="-1" frame_id="-1" name="" text="有好好睡觉吗？"   voices=""/><msg @l="104" char_id="-1" frame_id="-1" name=""   text="明明在折磨着我的身体，却还能说出这种话……。" voices=""/><msg @l="106" char_id="0" frame_id="-1" name="美帆" text="『您……居然说这种话。』"   voices="miho09890"/><msg @l="108" char_id="-1" frame_id="-1" name="朽木"   text="『如果那么痛苦的话，就做我的情人吧。把心和身体全都奉献给我。』" voices=""/><msg @l="110" char_id="-1" frame_id="-1" name="朽木"   text="『那样的话……就不会像现在这样痛苦了。』" voices=""/><msg @l="112" char_id="0" frame_id="-1" name="美帆" text="『……。』"   voices="miho09900"/><msg @l="114" char_id="-1" frame_id="-1" name="朽木"   text="『哼，算了。既然不愿成为情人，那我就只好随心所欲地玩弄你的身体了。』" voices=""/><bgm @l="118" src="bgm14" volume="1."/><wait_chgmv/><ev @l="121" src="ev-005ax3y2"/><msg @l="123" char_id="-1" frame_id="-1" name=""   text="说着，教授从裙子下摆伸手进去，将指尖滑向私处。" voices=""/><msg @l="124" char_id="-1" frame_id="-1" name="" text="总觉得……他有些烦躁。"   voices=""/><msg @l="125" char_id="-1" frame_id="-1" name="" text="是因为我没有听从他的话吗？"   voices=""/><msg @l="127" char_id="0" frame_id="-1" name="美帆" text="『唔嗯……。』"   voices="miho09910"/><msg @l="129" char_id="-1" frame_id="-1" name=""   text="教授的手指隔着内裤摩擦着阴蒂。" voices=""/><msg @l="130" char_id="-1" frame_id="-1" name=""   text="虽然比以前更加粗暴，但这动作让我想起了每天持续遭受的痴汉行为的感觉。" voices=""/><msg @l="132" char_id="-1" frame_id="-1" name="朽木"   text="『来吧，在我面前发出欢喜的声音哭泣吧。』" voices=""/><msg @l="134" char_id="-1" frame_id="-1" name="朽木"   text="『在屈辱与愉悦之中……我要摧毁你所守护的那颗心。』" voices=""/><msg @l="136" char_id="0" frame_id="-1" name="美帆" text="『嗯，啊…。』"   voices="miho09920"/><msg @l="138" char_id="-1" frame_id="-1" name=""   text="大拇指弹拨着红色突起，同时其余的手指摩擦着缝隙。" voices=""/><msg @l="140" char_id="-1" frame_id="-1" name="朽木"   text="『哎呀，你这里已经开始湿润了吧？』" voices=""/><msg @l="142" char_id="0" frame_id="-1" name="美帆" text="『……唔……。』"   voices="miho09930"/><msg @l="144" char_id="-1" frame_id="-1" name=""   text="教授掰开紧闭的肉瓣，揉弄着秘处，同时用牙齿轻咬我的耳垂。" voices=""/><msg @l="145" char_id="-1" frame_id="-1" name=""   text="我的那里正如朽木教授所说已经开始变得湿润。" voices=""/><msg @l="146" char_id="-1" frame_id="-1" name=""   text="而且……他那带有戏弄意味的话语，让我的身体变得更加燥热。" voices=""/><msg @l="148" char_id="0" frame_id="-1" name="美帆"   text="（不会吧……居然因为这种事，有感觉了……）" voices="miho09940"/><msg @l="150" char_id="-1" frame_id="-1" name=""   text="我能感觉到一股热流从体内深处渗出。" voices=""/><msg @l="151" char_id="-1" frame_id="-1" name=""   text="它逐渐顺着我的体内流下……在内裤上留下一大片湿痕。" voices=""/><msg @l="153" char_id="-1" frame_id="-1" name="朽木" text="『呵呵……这次量可真不少啊。』"   voices=""/><msg @l="155" char_id="-1" frame_id="-1" name=""   text="教授一边向我展示着牵出淫猥粘膜丝线缠绕在指尖的蜜液，一边笑着。" voices=""/><msg @l="157" char_id="0" frame_id="-1" name="美帆"   text="（为什么会这样……明明很讨厌……明明应该很讨厌的）" voices="miho09950"/><msg @l="159" char_id="-1" frame_id="-1" name=""   text="感受着私处分泌的淫液多到顺着大腿流下，我痛恨着自己这具因为屡次被痴汉侵犯而变得敏感的身体。"   voices=""/><clear @l="162" class="all"/><msg @l="164" char_id="-1" frame_id="-1" name="朽木"   text="『已经湿成这样应该没问题了吧。』" voices=""/><msg @l="166" char_id="-1" frame_id="-1" name=""   text="说着，教授在我的裙子下面活动手指，强行拉下了我的内裤。" voices=""/><msg @l="168" char_id="0" frame_id="-1" name="美帆" text="『诶……你、你要做什么……？』"   voices="miho09960"/><msg @l="170" char_id="-1" frame_id="-1" name="朽木" text="『让我久违地尝尝味道吧。』"   voices=""/><msg @l="172" char_id="0" frame_id="-1" name="美帆" text="『……！？』"   voices="miho09970"/><msg @l="174" char_id="-1" frame_id="-1" name=""   text="教授说着紧紧拉过我的腰，不知何时已经暴露在外的炽热硬物抵在了我的缝隙入口处。" voices=""/><msg @l="175" char_id="-1" frame_id="-1" name=""   text="……毫无疑问，那是教授勃起的肉棒。" voices=""/><msg @l="177" char_id="0" frame_id="-1" name="美帆" text="『等、等一下……那个！』"   voices="miho09980"/><msg @l="179" char_id="-1" frame_id="-1" name="朽木" text="『你认为我会等吗？』"   voices=""/><clear @l="182" class="all"/><label @l="192" id="chart_line47"/><wait_chgmv/><ev @l="195" src="ev-011"/><description @l="198" text="白浊色的洗礼"/><msg @l="200" char_id="0" frame_id="-1" name="美帆" text="『嗯嗯！』"   voices="miho09990"/><msg @l="202" char_id="-1" frame_id="-1" name="" text="一下子……教授的那个贯穿了我的体内。"   voices=""/><msg @l="203" char_id="-1" frame_id="-1" name=""   text="被强行撑开阴道深处并侵入的那个东西的触感，让我不由自主地发出了痛苦的声音。" voices=""/><msg @l="205" char_id="-1" frame_id="-1" name="朽木"   text="『哦……你这里依然又窄又紧啊。』" voices=""/><msg @l="207" char_id="0" frame_id="-1" name="美帆"   text="『呜、啊啊……呀……啊，请拔出来……。』" voices="miho10000"/><msg @l="209" char_id="-1" frame_id="-1" name="朽木" text="『请拔出来？真是个麻烦的孩子啊。』"   voices=""/><flash @l="212" count="4" fade="100" image="white"/><se @l="215" buf="1" src="尻を叩く" volume="1."/><msg @l="217" char_id="-1" frame_id="-1" name=""   text="朽木突然用手掌拍打了我的臀部。" voices=""/><msg @l="218" char_id="-1" frame_id="-1" name="" text="清脆的声音在车内回荡。"   voices=""/><msg @l="220" char_id="0" frame_id="-1" name="美帆" text="『……！？』"   voices="miho10040"/><msg @l="222" char_id="-1" frame_id="-1" name="朽木"   text="『呵呵呵……周围的人可能会听到哦。』" voices=""/><flash @l="225" count="4" fade="100" image="white"/><se @l="228" buf="1" src="尻を叩く" volume="1."/><msg @l="230" char_id="-1" frame_id="-1" name="" text="啪！" voices=""/><msg @l="231" char_id="-1" frame_id="-1" name="" text="又是一声清脆的声音回荡开来。"   voices=""/><msg @l="232" char_id="-1" frame_id="-1" name=""   text="我因为羞耻和悔恨，紧紧咬住嘴唇，强忍着不发出声音。" voices=""/><msg @l="234" char_id="-1" frame_id="-1" name="朽木" text="『这样就好了。就这样。』"   voices=""/><msg @l="236" char_id="-1" frame_id="-1" name=""   text="教授满意地低声说着，那个夺走我宝贵处女的可恨教授的分身不断地深入我的肉穴中。" voices=""/><msg @l="238" char_id="-1" frame_id="-1" name="朽木"   text="『没什么，疼痛只是在适应前的事。很快就会舒服起来的。』" voices=""/><msg @l="240" char_id="-1" frame_id="-1" name=""   text="教授这样说着笑了，然后缓缓地前后律动着腰部。" voices=""/><msg @l="241" char_id="-1" frame_id="-1" name=""   text="随着搅动体内的钝痛，光滑白皙的肌肤上渐渐渗出了汗珠。" voices=""/><msg @l="242" char_id="-1" frame_id="-1" name="朽木"   text="『哦……你这里依然又窄又紧啊。』" voices=""/><msg @l="244" char_id="0" frame_id="-1" name="美帆" text="『嗯……啊啊！』"   voices="miho10010"/><msg @l="246" char_id="-1" frame_id="-1" name=""   text="每当粗壮的男根在体内进出时，都有一种肉壁被拖拽般的剧烈摩擦感袭击我的身体。" voices=""/><msg @l="247" char_id="-1" frame_id="-1" name=""   text="每次都伴随着麻痹全部神经的剧痛刺痛我的大脑。" voices=""/><msg @l="249" char_id="0" frame_id="-1" name="美帆"   text="『等，请等一下……请温柔一点……。』" voices="miho10020"/><msg @l="251" char_id="-1" frame_id="-1" name="朽木"   text="『温柔？现在是说这种话的时候吗？』" voices=""/><msg @l="253" char_id="0" frame_id="-1" name="美帆" text="『诶……。』"   voices="miho10030"/><msg @l="255" char_id="-1" frame_id="-1" name="朽木"   text="『喂，看看周围……大家都在兴致勃勃地观赏你那淫荡的样子哦。』" voices=""/><msg @l="257" char_id="0" frame_id="-1" name="美帆" text="『……！？』"   voices="miho10040"/><msg @l="259" char_id="-1" frame_id="-1" name=""   text="听到他的话，我慌忙环顾四周，确实每个映入眼帘的人都在看着我和教授，开心地笑着。" voices=""/><msg @l="260" char_id="-1" frame_id="-1" name=""   text="而且……我这才注意到这节车厢里一个女性都没有。" voices=""/><msg @l="262" char_id="0" frame_id="-1" name="美帆" text="『为、为什么会这样！？』"   voices="miho10050"/><msg @l="264" char_id="-1" frame_id="-1" name="朽木" text="『他们都是我的熟人哦。』"   voices=""/><msg @l="266" char_id="-1" frame_id="-1" name="朽木"   text="『当我告诉他们今天要在车内侵犯你的时候，他们都想参与，所以就跟来了。』" voices=""/><msg @l="268" char_id="0" frame_id="-1" name="美帆" text="『怎么会……。』"   voices="miho10060"/><msg @l="270" char_id="-1" frame_id="-1" name="朽木"   text="『来，在众人面前尽情展示你的快感吧。』" voices=""/><msg @l="272" char_id="0" frame_id="-1" name="美帆" text="『嗯，啊啊啊！？』"   voices="miho10070"/><msg @l="274" char_id="-1" frame_id="-1" name=""   text="他强硬地将腰部撞击在美帆雪白的臀部上，在深深刺入她体内深处的同时，教授的指尖还紧紧捏住秘缝上方那颗红润的珍珠。"   voices=""/><msg @l="275" char_id="-1" frame_id="-1" name=""   text="同时被攻击两处的快感如同吞噬般包裹着我的身体。" voices=""/><msg @l="276" char_id="-1" frame_id="-1" name=""   text="那一瞬间，一种刺痛的感觉和灼热的麻痹感贯穿了我的全身。" voices=""/><msg @l="278" char_id="-1" frame_id="-1" name="朽木"   text="『在众人面前让阴蒂勃起到这种程度。你很快就会成为这个城镇不可或缺的女性了。』" voices=""/><msg @l="280" char_id="0" frame_id="-1" name="美帆"   text="『啊，唔嗯……这个，城镇………？』" voices="miho10080"/><msg @l="282" char_id="-1" frame_id="-1" name="朽木"   text="『呵呵，这不是你需要担心的事。』" voices=""/><msg @l="284" char_id="-1" frame_id="-1" name="朽木"   text="『你只要喘息着……这样就足够了。』" voices=""/><msg @l="286" char_id="0" frame_id="-1" name="美帆"   text="『啊，啊啊……呜，啊啊………深处，不行了。』" voices="miho10090"/><msg @l="288" char_id="-1" frame_id="-1" name=""   text="每当炽热的顶端深深地顶进阴道深处敲击着子宫口时，原本感受到的痛苦被一种麻痹般的愉悦所取代，这种感觉在下腹部扩散开来。"   voices=""/><msg @l="290" char_id="-1" frame_id="-1" name="朽木" text="『哦……原来你这里是弱点啊。』"   voices=""/><msg @l="292" char_id="0" frame_id="-1" name="美帆" text="『呃啊！！』"   voices="miho10100"/><msg @l="294" char_id="-1" frame_id="-1" name=""   text="咚，咚，龟头不断顶撞着深处那敏感的地方。" voices=""/><msg @l="296" char_id="-1" frame_id="-1" name="朽木"   text="『呵呵……让他们多听听你那可爱的声音吧。』" voices=""/><msg @l="298" char_id="0" frame_id="-1" name="美帆"   text="『嗯唔……不、不行……这种，啊啊！』" voices="miho10110"/><msg @l="300" char_id="-1" frame_id="-1" name=""   text="我拼命拉住即将飞走的理智，试图逃离那搅动蜜壶的炽热肉棒。" voices=""/><msg @l="301" char_id="-1" frame_id="-1" name=""   text="然而……与我的意愿相反，阴道内的肉褶却紧紧缠绕着肉棒，不让它逃离。" voices=""/><msg @l="303" char_id="-1" frame_id="-1" name="朽木"   text="『哦，真是惊人的紧致。而且肉褶蠕动着，缠绕着我的东西。』" voices=""/><msg @l="305" char_id="0" frame_id="-1" name="美帆"   text="『这种……羞……耻……的事……嗯啊……不要……说……嗯，啊啊！？』" voices="miho10120"/><msg @l="307" char_id="-1" frame_id="-1" name=""   text="被强烈顶撞着敏感之处，我不禁颤抖起了腰部。每当肉棒在雪白的臀部间进进出出时，" voices=""/><msg @l="308" char_id="-1" frame_id="-1" name=""   text="那曾是白色泡沫的液体就从秘处咕啾咕啾地溢出，在地板上形成了一滩水洼。" voices=""/><msg @l="310" char_id="-1" frame_id="-1" name="朽木"   text="『怎么样，你的身体正如此愉悦地接纳着我呢？』" voices=""/><msg @l="312" char_id="0" frame_id="-1" name="美帆" text="『啊、啊啊……』"   voices="miho10130"/><msg @l="314" char_id="-1" frame_id="-1" name="" text="身体因快感而颤抖。" voices=""/><msg @l="315" char_id="-1" frame_id="-1" name=""   text="每一次撞击都让我的腰部发麻，眼前变得一片空白，产生了全身都成为了性感带的错觉。" voices=""/><msg @l="317" char_id="0" frame_id="-1" name="美帆"   text="『啊、啊啊……嗯……啊哈！！』" voices="miho10140"/><msg @l="319" char_id="-1" frame_id="-1" name="朽木"   text="『哦，突然变得紧致了呢？』" voices=""/><msg @l="321" char_id="-1" frame_id="-1" name=""   text="察觉到我身体的变化，教授更加猛烈地撞击着我的臀部。" voices=""/><msg @l="323" char_id="0" frame_id="-1" name="美帆" text="『嗯，嗯……啊，嗯啊！』"   voices="miho10150"/><msg @l="325" char_id="0" frame_id="-1" name="美帆"   text="『不行，不行啊……嗯、嗯啊……啊啊啊！！』" voices="miho10160"/><msg @l="327" char_id="-1" frame_id="-1" name=""   text="已经……彻底失去了想要压抑声音的思考。" voices=""/><msg @l="328" char_id="-1" frame_id="-1" name=""   text="在被给予的快乐中喘息，身体不断颤抖，结合处大量的爱液滴落下来。" voices=""/><msg @l="330" char_id="-1" frame_id="-1" name="朽木" text="『很好，就这样达到高潮吧！』"   voices=""/><msg @l="332" char_id="0" frame_id="-1" name="美帆"   text="『啊……啊啊……不行，嗯，不行啊……』" voices="miho10170"/><msg @l="334" char_id="-1" frame_id="-1" name="朽木" text="『我也……要射在你子宫里了。』"   voices=""/><msg @l="336" char_id="0" frame_id="-1" name="美帆"   text="『诶？啊，啊啊……啊啊啊啊啊！！』" voices="miho10180"/><flash @l="339" count="4" fade="100" image="white"/><wait_chgmv/><ev @l="342" src="ev-011x1z1"/><msg @l="344" char_id="-1" frame_id="-1" name=""   text="甜美的麻痹感瞬间在我脑中蔓延开来。" voices=""/><msg @l="345" char_id="-1" frame_id="-1" name="" text="———高潮。" voices=""/><msg @l="346" char_id="-1" frame_id="-1" name="" text="那，让我的理性……彻底消失了。"   voices=""/><clear @l="349" class="all"/><end_scene @l="352"/><msg @l="354" char_id="0" frame_id="-1" name="美帆" text="『嗯……啊啊……。』"   voices="miho10190"/><msg @l="356" char_id="-1" frame_id="-1" name="" text="滚烫的液体流入我的体内。"   voices=""/><msg @l="357" char_id="-1" frame_id="-1" name=""   text="但是……就连这个现在不知为何也感到很舒服。" voices=""/><msg @l="358" char_id="-1" frame_id="-1" name=""   text="体内被灼烧般的感觉……非常。" voices=""/><label @l="361" id="event_scene34"/><goto @l="363" cond="!(f.flagInExtraMode&#32;&gt;&#32;100)&#13;&#10;"   label="TempLabel_200"/><bgm @l="365" src="bgm14" volume="1."/><label @l="366" id="TempLabel_200"/><msg @l="368" char_id="-1" frame_id="-1" name="朽木" text="『这还没结束呢。呵呵呵……』"   voices=""/><msg @l="370" char_id="-1" frame_id="-1" name=""   text="教授这么说着，抱起了浑身无力的我。" voices=""/><msg @l="371" char_id="-1" frame_id="-1" name=""   text="然后强行让我站起来，将我的双手分别穿过左右的吊环。" voices=""/><msg @l="372" char_id="-1" frame_id="-1" name=""   text="就像是……被吊起来一样的姿势。" voices=""/><label @l="375" id="chart_line48"/><wait_chgmv/><ev @l="378" src="ev-034"/><description @l="381" text="车内大轮奸"/><msg @l="383" char_id="0" frame_id="-1" name="美帆" text="『诶……。』"   voices="miho10200"/><msg @l="385" char_id="0" frame_id="-1" name="美帆" text="『你……要……什么？』"   voices="miho10210"/><msg @l="387" char_id="-1" frame_id="-1" name="朽木"   text="『他们是来侵犯你的啊。』" voices=""/><msg @l="389" char_id="-1" frame_id="-1" name="公司员工A"   text="『哎呀，能被邀请参加这样精彩的活动，真是感激不尽啊。』" voices=""/><msg @l="391" char_id="-1" frame_id="-1" name="公司员工B"   text="『说真的，朽木先生的手段真是越来越高明了。』" voices=""/><msg @l="393" char_id="-1" frame_id="-1" name=""   text="围在周围的男人们你一言我一语地说着这样的话，然后大笑起来。" voices=""/><msg @l="395" char_id="-1" frame_id="-1" name="朽木"   text="『他们可是为了你特地请假来的。如果不好好服侍他们岂不是太对不起他们了？』" voices=""/><msg @l="397" char_id="-1" frame_id="-1" name="朽木"   text="『当然，我一次怎么够呢。至少也要侵犯你五次才行。』" voices=""/><msg @l="399" char_id="-1" frame_id="-1" name=""   text="这么说着的朽木的肉棒看起来比射精前还要大。" voices=""/><msg @l="401" char_id="0" frame_id="-1" name="美帆" text="『不……要……。』"   voices="miho10220"/><msg @l="403" char_id="-1" frame_id="-1" name="" text="我的声音在颤抖。" voices=""/><msg @l="404" char_id="-1" frame_id="-1" name=""   text="这是出于恐惧还是高潮的余韵，连我自己都不清楚。" voices=""/><msg @l="406" char_id="-1" frame_id="-1" name="朽木"   text="『来吧，开始轮奸派对吧。』" voices=""/><wait_chgmv/><ev @l="409" src="ev-034y1"/><msg @l="411" char_id="0" frame_id="-1" name="美帆" text="『唔唔……！』"   voices="miho10230"/><msg @l="413" char_id="-1" frame_id="-1" name=""   text="被注入大量精液的秘处，再次被朽木教授的那话儿插入。" voices=""/><msg @l="415" char_id="-1" frame_id="-1" name="" text="咕滋咕滋咕滋咕滋咕滋" voices=""/><msg @l="417" char_id="-1" frame_id="-1" name="朽木"   text="『哎呀，刚才感觉相当舒服吧？你的体内正在抽搐呢？』" voices=""/><msg @l="419" char_id="0" frame_id="-1" name="美帆" text="『不，啊啊啊啊啊。』"   voices="miho10240"/><msg @l="421" char_id="-1" frame_id="-1" name=""   text="在前一次高潮余韵中颤抖的阴道内，教授粗暴地向上顶弄着。" voices=""/><msg @l="423" char_id="0" frame_id="-1" name="美帆" text="『嗯，嗯嗯……嗯啊啊。』"   voices="miho10940"/><msg @l="425" char_id="-1" frame_id="-1" name=""   text="敏感部位被给予强烈刺激，蜜壶中流出的白色欲液被肉棒搅动的感觉，让我不禁扭动腰肢，身体颤抖着挣扎。"   voices=""/><msg @l="427" char_id="-1" frame_id="-1" name="公司员工A" text="『朽木先生，这边的开发进展如何？』"   voices=""/><msg @l="429" char_id="-1" frame_id="-1" name="朽木"   text="『还没有动手……请享用这个处女地吧。』" voices=""/><msg @l="431" char_id="-1" frame_id="-1" name="公司员工A"   text="『噢，那真是太感谢了。』" voices=""/><msg @l="433" char_id="-1" frame_id="-1" name=""   text="就这样交谈了几句后，站在我身后的男人开始用指尖在我的后庭处游走。" voices=""/><msg @l="435" char_id="0" frame_id="-1" name="美帆" text="『啊……！？』"   voices="miho10250"/><msg @l="437" char_id="-1" frame_id="-1" name="公司员工A"   text="『我最近很喜欢这里。我要好好享受一番。』" voices=""/><msg @l="439" char_id="0" frame_id="-1" name="美帆"   text="『不，不要……住手……那种地方……不要碰……。』" voices="miho10260"/><msg @l="441" char_id="-1" frame_id="-1" name="公司员工A"   text="『你在说什么呢。不好好放松的话可能会撕裂啊……不好好疼爱一下可不行吧？』"   voices=""/><msg @l="443" char_id="0" frame_id="-1" name="美帆"   text="『不，不要………啊……嗯嗯！！』" voices="miho10270"/><msg @l="445" char_id="-1" frame_id="-1" name="" text="臀部感受到了一丝冰凉的触感。"   voices=""/><msg @l="446" char_id="-1" frame_id="-1" name=""   text="那似乎是某种液体……在涂抹了一会儿我的臀部周围后，他的指尖慢慢地侵入了我的后庭。" voices=""/><msg @l="448" char_id="0" frame_id="-1" name="美帆"   text="『呀啊……不要……只有那里……请饶了我……啊……嗯嗯……拔出来，请拔出来！』"   voices="miho10280"/><msg @l="450" char_id="-1" frame_id="-1" name="朽木"   text="『喂，仲根同学……不要太任性了。』" voices=""/><msg @l="452" char_id="-1" frame_id="-1" name="朽木"   text="『他们可是我重要的朋友啊？必须比对我还要礼貌地接待他们，否则就太失礼了。』" voices=""/><msg @l="454" char_id="0" frame_id="-1" name="美帆" text="『可、可是……嗯，嗯嗯！！』"   voices="miho10290"/><msg @l="456" char_id="-1" frame_id="-1" name=""   text="他的指尖开始搅动着位于白桃般臀部中心的菊花。" voices=""/><msg @l="457" char_id="-1" frame_id="-1" name=""   text="每当他在直肠内动一下手指，粘膜被摩擦的感觉都让我脊背发颤。" voices=""/><msg @l="459" char_id="-1" frame_id="-1" name="公司员工A"   text="『我刚才涂的润滑液还有促进性快感的效果，你很快就会爽得不得了。』" voices=""/><msg @l="461" char_id="0" frame_id="-1" name="美帆" text="『怎么会……嗯，啊呜！？』"   voices="miho10300"/><msg @l="463" char_id="-1" frame_id="-1" name="" text="手指……变成了两根。"   voices=""/><msg @l="464" char_id="-1" frame_id="-1" name=""   text="他从内侧搓揉着按摩放松，同时也用指尖揉搓着入口进行爱抚。" voices=""/><msg @l="466" char_id="0" frame_id="-1" name="美帆"   text="（不会吧……感觉，有点舒服……）" voices="miho10310"/><msg @l="468" char_id="-1" frame_id="-1" name=""   text="一开始是整个肛门都被压入，但随后那小小的洞口突然张开，吞入了那粗大的手指。" voices=""/><msg @l="470" char_id="0" frame_id="-1" name="美帆"   text="（这是因为润滑液……的缘故吧？）" voices="miho10320"/><msg @l="472" char_id="-1" frame_id="-1" name=""   text="前面被插入的感觉和白桃般柔软的臀穴被玩弄的刺激重叠在一起，厌恶感渐渐淡去。" voices=""/><msg @l="474" char_id="0" frame_id="-1" name="美帆" text="『嗯，啊…呜…。』"   voices="miho09920"/><msg @l="476" char_id="-1" frame_id="-1" name=""   text="取而代之的是与秘处不同的灼热麻痹感在那里蔓延，我不由自主地扭动身体。" voices=""/><msg @l="478" char_id="-1" frame_id="-1" name="公司员工A"   text="『嗯，看来已经完全放松下来了呢。』" voices=""/><msg @l="480" char_id="-1" frame_id="-1" name=""   text="他一边用指尖撑开像打了结的细线般的臀穴，一边露出奸笑。" voices=""/><msg @l="482" char_id="0" frame_id="-1" name="美帆" text="『嗯嗯……啊，啊啊啊……。』"   voices="miho10330"/><msg @l="484" char_id="-1" frame_id="-1" name=""   text="即使被侵犯着后庭，我却惊讶地发现自己正不由自主地颤抖着腰肢，感受着快感。" voices=""/><msg @l="486" char_id="-1" frame_id="-1" name="朽木"   text="『差不多该试试两根一起插入了吧。』" voices=""/><msg @l="488" char_id="-1" frame_id="-1" name="公司员工A"   text="『确实如此。这样的话应该没问题。』" voices=""/><msg @l="490" char_id="-1" frame_id="-1" name=""   text="说着，我背后的男人将那巨大滚烫的东西抵在了我的臀部。" voices=""/><msg @l="492" char_id="0" frame_id="-1" name="美帆" text="『嘶！！』"   voices="miho10100"/><msg @l="494" char_id="-1" frame_id="-1" name="" text="我不由得……倒吸了一口气。"   voices=""/><msg @l="495" char_id="-1" frame_id="-1" name=""   text="仅仅被手指玩弄就已经让我的腰部麻痹不已……" voices=""/><msg @l="496" char_id="-1" frame_id="-1" name=""   text="如果那炙热的粗壮之物插入进来，我会变成什么样呢？" voices=""/><msg @l="498" char_id="-1" frame_id="-1" name="公司员工A"   text="『那么，我要进去了……请放松点。』" voices=""/><wait_chgmv/><ev @l="501" src="ev-034y1y3"/><msg @l="503" char_id="0" frame_id="-1" name="美帆"   text="『唔……啊，啊，啊啊……啊………。』" voices="miho10350"/><msg @l="505" char_id="-1" frame_id="-1" name=""   text="缓慢地，那滚烫的东西进入了我的后庭。" voices=""/><msg @l="506" char_id="-1" frame_id="-1" name=""   text="也许是因为被充分地扩张过了……疼痛感比我想象的要轻。" voices=""/><msg @l="508" char_id="-1" frame_id="-1" name="公司员工A"   text="『嗯，唔……果然很紧啊。』" voices=""/><msg @l="510" char_id="0" frame_id="-1" name="美帆" text="『嗯，啊啊啊！？』"   voices="miho10070"/><msg @l="512" char_id="-1" frame_id="-1" name="朽木" text="『这就是第一次的特权吧。』"   voices=""/><msg @l="514" char_id="-1" frame_id="-1" name="公司员工A" text="『是啊，正如您所说。』"   voices=""/><msg @l="516" char_id="-1" frame_id="-1" name="公司员工A"   text="『我们公司的女孩子，最近都松松垮垮的。』" voices=""/><msg @l="518" char_id="0" frame_id="-1" name="美帆"   text="『唔……啊，啊，啊啊……啊………。』" voices="miho10350"/><msg @l="520" char_id="-1" frame_id="-1" name="朽木"   text="『呵呵，那就请您尽情享用吧。』" voices=""/><msg @l="522" char_id="-1" frame_id="-1" name="公司员工A" text="『嗯，我正有此意。』"   voices=""/><msg @l="524" char_id="-1" frame_id="-1" name=""   text="就这样两人意气相投，各自以自己的速度开始动腰责罚她。" voices=""/><msg @l="526" char_id="0" frame_id="-1" name="美帆" text="『啊，啊啊…………啊………………。』"   voices="miho10360"/><msg @l="528" char_id="-1" frame_id="-1" name=""   text="每当两根男根在股间来回进出，一种难以言喻的感觉就贯穿了身体的核心。" voices=""/><msg @l="529" char_id="-1" frame_id="-1" name=""   text="令头脑融化的秘部麻痹感，与缓缓扩散至下腹部的臀部麻痹感交替着折磨我。" voices=""/><msg @l="531" char_id="0" frame_id="-1" name="美帆"   text="『啊啊，啊………呜啊………啊啊………啊嗯………呜啊啊………。』" voices="miho10370"/><msg @l="533" char_id="-1" frame_id="-1" name=""   text="当阴道内的肉棒拖拽着肉褶抽出时，臀部的责罚棒却像是要挤进直肠般向上顶入。" voices=""/><msg @l="534" char_id="-1" frame_id="-1" name=""   text="而当臀部的肉棒抽出时，那炙热的棒子又直捣子宫，顶到了子宫口。" voices=""/><msg @l="535" char_id="-1" frame_id="-1" name=""   text="就这样，美帆毫无休息的机会，一直被不断地顶弄、责罚着。" voices=""/><msg @l="537" char_id="-1" frame_id="-1" name="公司员工A"   text="『哦，哦哦………这紧致感太棒了！』" voices=""/><msg @l="539" char_id="-1" frame_id="-1" name="朽木"   text="『前面也在配合后面的动作，一抽一抽地痉挛着呢。』" voices=""/><msg @l="541" char_id="-1" frame_id="-1" name=""   text="从各个洞穴中，咕嗒咕嗒的水声回荡四周。" voices=""/><msg @l="543" char_id="0" frame_id="-1" name="美帆"   text="『嗯嗯……啊、啊啊………咿、啊、啊呜………。』" voices="miho10380"/><msg @l="545" char_id="0" frame_id="-1" name="美帆"   text="『啊……啊啊………啊、啊、啊………嗯、呜啊啊！』" voices="miho10390"/><msg @l="547" char_id="-1" frame_id="-1" name="公司员工A" text="『哦，太厉害了……。』"   voices=""/><msg @l="549" char_id="-1" frame_id="-1" name="公司员工A"   text="『每次朽木先生向上顶时，这边也感觉要被挤压榨干了。』" voices=""/><msg @l="551" char_id="-1" frame_id="-1" name="朽木" text="『这就是双穴责罚的妙处啊。』"   voices=""/><msg @l="553" char_id="-1" frame_id="-1" name=""   text="教授一边这么说着，一边更加用力地挺动腰部，让龟头深深地潜入最深处。" voices=""/><msg @l="555" char_id="0" frame_id="-1" name="美帆"   text="『嗯、嗯嗯……啊啊……不行……嗯呜、啊啊！！』" voices="miho10400"/><msg @l="557" char_id="-1" frame_id="-1" name="公司员工A" text="『我也不能认输啊。』"   voices=""/><msg @l="559" char_id="-1" frame_id="-1" name=""   text="或许是受到了那激烈律动的感染，犯着她后庭的他也猛烈地挺动腰部，以一种仿佛要从直肠贯穿到胃部的气势，刺入男根。"   voices=""/><msg @l="561" char_id="0" frame_id="-1" name="美帆"   text="『啊啊、啊啊啊啊……那么深……不行、啊、头……变得……奇怪了……嗯……啊啊！！』"   voices="miho10410"/><msg @l="563" char_id="-1" frame_id="-1" name="公司员工A"   text="『哇啊，这么紧地夹住的话……』" voices=""/><msg @l="565" char_id="-1" frame_id="-1" name="朽木" text="『我也……一起来吧。』"   voices=""/><msg @l="567" char_id="-1" frame_id="-1" name=""   text="两人互相使了个眼色，协调腰部动作，加快了律动的节奏。" voices=""/><msg @l="568" char_id="-1" frame_id="-1" name=""   text="就这样前后同时被深深摩擦到最深处的那一瞬间……" voices=""/><msg @l="570" char_id="0" frame_id="-1" name="美帆"   text="『啊、啊啊……不行，这种……啊，啊，啊啊啊！』" voices="miho05080"/><msg @l="572" char_id="0" frame_id="-1" name="美帆"   text="『啊啊啊，啊……啊，啊，啊……嗯，嗯嗯！！』" voices="miho10420"/><msg @l="574" char_id="-1" frame_id="-1" name=""   text="犹如融化般的绝顶感毫无阻碍地迅速袭来。" voices=""/><msg @l="576" char_id="0" frame_id="-1" name="美帆"   text="『啊……啊啊……不行，嗯，不行啊啊………』" voices="miho10170"/><msg @l="578" char_id="0" frame_id="-1" name="美帆"   text="『要、去了……去了……要去，了，啊，啊啊啊！！』" voices="miho10430"/><msg @l="580" char_id="-1" frame_id="-1" name="公司员工A" text="『咕、呜呜呜！』"   voices=""/><msg @l="582" char_id="-1" frame_id="-1" name="朽木" text="『我要射了！』"   voices=""/><flash @l="585" count="4" fade="100" image="white"/><msg @l="587" char_id="0" frame_id="-1" name="美帆" text="『嗯、啊啊啊啊！！』"   voices="miho10440"/><flash @l="590" count="4" fade="100" image="white"/><msg @l="592" char_id="-1" frame_id="-1" name=""   text="滚烫的液体噗噗地射进体内。" voices=""/><wait_chgmv/><ev @l="595" src="ev-034x1y1y3z1"/><msg @l="597" char_id="-1" frame_id="-1" name=""   text="每当那两根异物咕咕地脉动一次，我就剧烈地颤抖腰肢，全身扭动。" voices=""/><msg @l="600" char_id="0" frame_id="-1" name="美帆" text="『嗯……。』"   voices="miho10450"/><msg @l="602" char_id="0" frame_id="-1" name="美帆" text="『嗯、嗯嗯………嗯啊啊。』"   voices="miho10940"/><msg @l="604" char_id="-1" frame_id="-1" name=""   text="侵犯我的两人腰部颤抖，不仅在阴道内，还用白浊液体弄脏了我的身体。" voices=""/><msg @l="605" char_id="-1" frame_id="-1" name=""   text="炽热粘稠的液体肆无忌惮地游走在我的身体上……将肌肤染成白色。" voices=""/><clear @l="608" class="all"/><msg @l="610" char_id="-1" frame_id="-1" name="朽木"   text="『来吧，各位也请尽情品尝。』" voices=""/><msg @l="612" char_id="-1" frame_id="-1" name=""   text="朽木一边说着，一边拔出肉棒，被解开堵塞的精液从秘部哗哗地流了下来。" voices=""/><msg @l="614" char_id="-1" frame_id="-1" name="公司员工D"   text="『那么，我就不客气地享用了。』" voices=""/><msg @l="616" char_id="-1" frame_id="-1" name=""   text="下一个男人看着美帆被男人们的欲液浸透的秘部，浮现出下流的笑容，然后将硬挺肉棒的前端抵在充满精液的蜜口上。"   voices=""/><msg @l="618" char_id="-1" frame_id="-1" name="公司员工E"   text="『这边也要……尽情地使用了。』" voices=""/><msg @l="620" char_id="-1" frame_id="-1" name=""   text="从后面侵犯她的男人也和排队等候的人交换，新的侵略者将肉棒抵在沾满精液的菊座上。" voices=""/><wait_chgmv/><ev @l="623" src="ev-034x1y2y4z1"/><msg @l="625" char_id="0" frame_id="-1" name="美帆"   text="『已经……不行了……我……高潮了两次……身体……要坏掉了……。』" voices="miho10460"/><msg @l="627" char_id="-1" frame_id="-1" name=""   text="但男人们仿佛没有听到美帆的话，插入着欲望。" voices=""/><msg @l="629" char_id="0" frame_id="-1" name="美帆" text="『啊、啊啊……嗯……啊呜！』"   voices="miho10470"/><msg @l="631" char_id="-1" frame_id="-1" name=""   text="阴道和直肠还残留着高潮的余韵就被深深贯穿，我发出颤抖的声音，身体不断扭动。" voices=""/><msg @l="633" char_id="-1" frame_id="-1" name="公司员工D"   text="『哦，虽然被精液和爱液弄得湿滑，但紧致度还是很惊人啊。』" voices=""/><msg @l="635" char_id="-1" frame_id="-1" name="公司员工E"   text="『这边的内部蠕动和根部的紧缩感，真是太棒了。』" voices=""/><msg @l="637" char_id="-1" frame_id="-1" name=""   text="男人们一边说着侮辱美帆的话，一边肆意地用力撞击着腰部。" voices=""/><msg @l="639" char_id="0" frame_id="-1" name="美帆"   text="『嗯嗯……啊……啊啊……啊嘶……呃啊……嗯呜，啊呜！！』" voices="miho10480"/><msg @l="641" char_id="-1" frame_id="-1" name=""   text="当被深深刺入的阴道内被注入白浊液体的瞬间，我感觉子宫被侵犯，全身剧烈颤抖。" voices=""/><msg @l="642" char_id="-1" frame_id="-1" name=""   text="就在我身体还在颤抖时，贯穿臀部的灼热肉楔又进一步追击，在体内的柔软内壁中噗嗤噗嗤地挤进来。"   voices=""/><msg @l="644" char_id="0" frame_id="-1" name="美帆"   text="『啊，啊啊……嗯………啊啊啊啊！！』" voices="miho10490"/><msg @l="646" char_id="-1" frame_id="-1" name=""   text="两个欲望的肉块分别凌辱着两个穴口，每当它们从两侧摩擦隔开它们的那层壁时，我的脑海就变得一片空白。" voices=""/><msg @l="647" char_id="-1" frame_id="-1" name="" text="周围的目光我已经不在乎了。"   voices=""/><msg @l="649" char_id="-1" frame_id="-1" name="公司员工D"   text="『这种紧缩感和蠕动……真让人上瘾。』" voices=""/><msg @l="651" char_id="-1" frame_id="-1" name="公司员工E"   text="『后穴的触感也是，柔软且紧致……感觉极好。』" voices=""/><msg @l="653" char_id="-1" frame_id="-1" name="公司员工D"   text="『而且，在里面这种相互摩擦的感觉……真是棒极了。』" voices=""/><msg @l="655" char_id="-1" frame_id="-1" name=""   text="说着这话，与在臀部有节奏律动的男人的动作配合，侵犯着秘部的男人也慢慢地扭动着腰肢。" voices=""/><msg @l="657" char_id="-1" frame_id="-1" name="公司员工E"   text="『隔着这层薄壁的感觉，这就是所谓双穴责罚的独特之处啊。』" voices=""/><msg @l="659" char_id="0" frame_id="-1" name="美帆"   text="『啊，啊，啊……不行，在里面摩擦……嗯，啊啊！』" voices="miho10500"/><msg @l="661" char_id="-1" frame_id="-1" name=""   text="贯穿前后的男根有意地相互摩擦，我大幅度地震颤着腰肢，向后仰起背部，身体不停扭动。" voices=""/><msg @l="662" char_id="-1" frame_id="-1" name=""   text="每当我这样震颤腰肢时，我并没有意识到自己正在强烈地紧缩着吞入的两根东西。" voices=""/><msg @l="663" char_id="-1" frame_id="-1" name=""   text="男人们为了享受我这种无意识的紧缩感，不断地让阴道和直肠内的欲望互相摩擦，无休止地折磨着我。"   voices=""/><msg @l="665" char_id="0" frame_id="-1" name="美帆"   text="『啊……啊……啊啊……嗯，嗯，嗯……不行……已经……嗯嗯嗯！！』" voices="miho10510"/><msg @l="667" char_id="0" frame_id="-1" name="美帆"   text="『啊啊……不行………又要，去了……要去，嗯嗯！』" voices="miho10520"/><msg @l="669" char_id="-1" frame_id="-1" name=""   text="我再次被迅速推向了高潮。" voices=""/><msg @l="670" char_id="-1" frame_id="-1" name=""   text="甜美的麻痹感在全身奔走，让头脑、腰肢甜美地融化了。" voices=""/><msg @l="672" char_id="-1" frame_id="-1" name="公司员工D" text="『哦，我也快到极限了！』"   voices=""/><msg @l="674" char_id="-1" frame_id="-1" name="公司员工E" text="『我也无法再忍耐了———。』"   voices=""/><msg @l="676" char_id="-1" frame_id="-1" name=""   text="两个男人像是接着我的话一样漏出声音，腰部震动得更加剧烈。" voices=""/><msg @l="678" char_id="0" frame_id="-1" name="美帆"   text="『嗯嗯，啊，啊，啊……去了，啊，啊啊，嗯嗯嗯！！』" voices="miho10530"/><msg @l="680" char_id="-1" frame_id="-1" name="公司员工D" text="『唔唔！』" voices=""/><msg @l="682" char_id="-1" frame_id="-1" name="公司员工E" text="『好，好紧！』"   voices=""/><msg @l="684" char_id="0" frame_id="-1" name="美帆"   text="『嗯呜……啊啊，去了……去了，去了去了去了……。』" voices="miho05090"/><flash @l="687" count="4" fade="100" image="white"/><msg @l="689" char_id="0" frame_id="-1" name="美帆" text="『嗯，啊啊啊啊啊啊啊！！』"   voices="miho11040"/><flash @l="692" count="4" fade="100" image="white"/><wait_chgmv/><ev @l="695" src="ev-034y2y4z1z2z4"/><msg @l="697" char_id="-1" frame_id="-1" name=""   text="前后两处再次被注入大量热液，我被强烈而深沉的高潮吞噬，身体剧烈地痉挛着，变得僵硬。" voices=""/><msg @l="698" char_id="-1" frame_id="-1" name=""   text="射精在阴道内还不够，男人们还将更多滚烫的液体射向我的身体。" voices=""/><msg @l="700" char_id="0" frame_id="-1" name="美帆"   text="『嗯，啊，啊啊……嗯嗯…………。』" voices="miho12040"/><msg @l="702" char_id="-1" frame_id="-1" name=""   text="我的全身都被那腥臭的白浊液体彻底弄脏了……" voices=""/><msg @l="703" char_id="-1" frame_id="-1" name=""   text="然而，大量的白浊液体缠绕在泛着粉红的火热肌肤上的景象，却让我这被玷污的身体显得异常妖艳。" voices=""/><clear @l="706" class="all"/><msg @l="708" char_id="-1" frame_id="-1" name="公司员工D" text="『哦，她还在高潮，还在高潮呢。』"   voices=""/><msg @l="710" char_id="-1" frame_id="-1" name="公司员工E"   text="『里面的褶皱痛苦地缠绕着……紧紧地夹着呢。』" voices=""/><msg @l="712" char_id="-1" frame_id="-1" name=""   text="为了品味射精后仍在高潮中颤抖的子宫和体内的感受，前后两个男人毫不留情地继续摆动腰部，像是要将最后一滴都注入进去。"   voices=""/><msg @l="714" char_id="-1" frame_id="-1" name="公司员工J"   text="『喂，完事了就赶紧让开。』" voices=""/><msg @l="716" char_id="-1" frame_id="-1" name="公司员工K"   text="『这边已经…已经快爆发了！』" voices=""/><wait_chgmv/><ev @l="719" src="ev-034y1y3z1z2z4"/><msg @l="721" char_id="-1" frame_id="-1" name=""   text="推开已经发泄完的男人们，下一批男人将即将爆发的肉棒滑入我的前后两穴。" voices=""/><msg @l="722" char_id="-1" frame_id="-1" name=""   text="那已经不是单纯享用身体的程度了。" voices=""/><msg @l="723" char_id="-1" frame_id="-1" name=""   text="只是在寻找一个发泄积攒的精液的地方罢了。" voices=""/><msg @l="725" char_id="0" frame_id="-1" name="美帆"   text="『啊，啊啊……嗯……不行……再这样下去，嗯嗯！』" voices="miho10550"/><msg @l="726" char_id="-1" frame_id="-1" name=""   text="男人们打断我的话，从下方猛烈顶弄，撑开秘缝插入的肉棒直击子宫口。" voices=""/><msg @l="727" char_id="-1" frame_id="-1" name=""   text="那一瞬间，大量精液从阴道内喷涌而出，顺着大腿流到地板上滴落。" voices=""/><msg @l="729" char_id="0" frame_id="-1" name="美帆" text="『嗯，啊啊啊啊！！』"   voices="miho10440"/><msg @l="731" char_id="-1" frame_id="-1" name="公司员工J"   text="『啊啊……因为用力插得太深，精液都被挤出来了。』" voices=""/><msg @l="733" char_id="-1" frame_id="-1" name="公司员工K"   text="『无所谓，我可是忍了很久！再说之后还要往这肚子里灌注几十人份的精液，流出一点也无所谓。』"   voices=""/><msg @l="735" char_id="-1" frame_id="-1" name=""   text="男人一边这么说着，一边拍打着我的小腹。" voices=""/><msg @l="737" char_id="0" frame_id="-1" name="美帆" text="『嗯，啊呜……。』"   voices="miho09920"/><msg @l="739" char_id="-1" frame_id="-1" name=""   text="插入我秘部的男人，这样说着，更猛烈地顶撞着我的子宫。" voices=""/><msg @l="740" char_id="-1" frame_id="-1" name=""   text="他微妙地摆动腰部，让肉棒在我的阴道内朝各个方向肆虐。" voices=""/><msg @l="742" char_id="0" frame_id="-1" name="美帆"   text="『啊，啊啊……咕，啊啊………深处，不行了。』" voices="miho10090"/><msg @l="744" char_id="-1" frame_id="-1" name=""   text="扩张开的龟头部分，时不时刮擦到我敏感的弱点。" voices=""/><msg @l="745" char_id="-1" frame_id="-1" name=""   text="龟头卷入褶皱，渗出的爱液从秘缝的缝隙中被刮出。" voices=""/><msg @l="747" char_id="0" frame_id="-1" name="美帆"   text="『嗯，嗯嗯……啊啊……不行……嗯呜，啊啊！！』" voices="miho10400"/><msg @l="749" char_id="-1" frame_id="-1" name="公司员工K" text="『哦，继续扭动吧扭动吧。』"   voices=""/><msg @l="751" char_id="-1" frame_id="-1" name=""   text="男人们加快抽插的速度，责罚着菊座，让我再次燥热起来。" voices=""/><msg @l="752" char_id="-1" frame_id="-1" name=""   text="也许是因为第三次的肛交，一种排泄感涌上心头。" voices=""/><msg @l="754" char_id="0" frame_id="-1" name="美帆"   text="『啊……啊啊……不行，嗯，不行啊啊………。』" voices="miho10170"/><msg @l="756" char_id="-1" frame_id="-1" name=""   text="我试着忍住被责罚菊座的刺激，但当我的臀部与上班族的腰紧贴时，子宫被从直肠处顶起，眼前一阵阵发闪。"   voices=""/><msg @l="758" char_id="0" frame_id="-1" name="美帆" text="『嗯……啊呃！』"   voices="miho10010"/><msg @l="760" char_id="0" frame_id="-1" name="美帆"   text="『嗯啊啊……啊，嗯啊………嗯，嗯，嗯嗯！！』" voices="miho11170"/><msg @l="762" char_id="0" frame_id="-1" name="美帆"   text="『啊，啊，啊……不行，里面摩擦着……嗯，啊啊！』" voices="miho10500"/><msg @l="764" char_id="-1" frame_id="-1" name="公司员工J"   text="『哦哦！感觉真好。……隔着一层肉壁这边都能感觉到硬邦邦的摩擦呢。』" voices=""/><msg @l="766" char_id="-1" frame_id="-1" name="公司员工K"   text="『这才是双穴责罚的醍醐味啊。』" voices=""/><msg @l="768" char_id="-1" frame_id="-1" name="公司员工K"   text="『喂！我们一起把她小穴顶到坏掉吧！』" voices=""/><msg @l="770" char_id="-1" frame_id="-1" name="公司员工J" text="『好啊！』"   voices=""/><msg @l="772" char_id="-1" frame_id="-1" name=""   text="打入直肠的肉棒与下方的阳具猛烈碰撞。" voices=""/><msg @l="773" char_id="-1" frame_id="-1" name=""   text="阴茎挤压着阴道壁相互摩擦。" voices=""/><msg @l="775" char_id="0" frame_id="-1" name="美帆"   text="『啊，啊啊……嗯……不行……再这样下去，嗯嗯！』" voices="miho10550"/><msg @l="776" char_id="0" frame_id="-1" name="美帆"   text="『不行……那个，后面的在摩擦……嗯，啊呜！！』" voices="miho11180"/><msg @l="778" char_id="0" frame_id="-1" name="美帆"   text="『啊啊，啊啊啊啊……这么深……不行，啊，脑袋……要变得……奇怪了……嗯……啊啊！！』"   voices="miho10410"/><msg @l="780" char_id="-1" frame_id="-1" name="公司员工J"   text="『这女人，我一猛烈抽插她就紧紧缠住我的肉棒。』" voices=""/><msg @l="782" char_id="-1" frame_id="-1" name="公司员工K"   text="『这婊子！母狗！在电车里被轮奸还能爽成这样简直是变态吧！』" voices=""/><msg @l="784" char_id="-1" frame_id="-1" name=""   text="尽管这么说着，两个男人还是因我身体的反应而更加兴奋，更加猛烈地向上顶弄。" voices=""/><msg @l="786" char_id="0" frame_id="-1" name="美帆"   text="『嗯啊啊……已经，不要啊……不行啊……』" voices="miho10560"/><msg @l="788" char_id="0" frame_id="-1" name="美帆"   text="『啊啊……不行………又要，去了……去了，嗯嗯！』" voices="miho10520"/><msg @l="790" char_id="-1" frame_id="-1" name="公司员工J"   text="『哦，我要射了！接好我浓稠的精液。』" voices=""/><msg @l="792" char_id="-1" frame_id="-1" name="公司员工K"   text="『我也，忍不住了！给你灌个满满的！』" voices=""/><msg @l="794" char_id="0" frame_id="-1" name="美帆"   text="『嗯呜……啊啊，要去了……去，去去去去……。』" voices="miho05090"/><msg @l="796" char_id="-1" frame_id="-1" name=""   text="男人们一齐射出了浓稠的积攒已久的精液。" voices=""/><msg @l="798" char_id="-1" frame_id="-1" name="" text="咻噜噜噜噜噜噜噜噜噜噜噜噜噜噜噜"   voices=""/><msg @l="800" char_id="0" frame_id="-1" name="美帆" text="『嗯嗯嗯！！！』"   voices="miho05100"/><flash @l="803" count="4" fade="100" image="white"/><wait_chgmv/><ev @l="806" src="ev-034y1y3z1z2z4z3z5"/><msg @l="808" char_id="0" frame_id="-1" name="美帆" text="『啊，啊啊啊啊啊啊啊啊啊！！！』"   voices="miho04870"/><msg @l="810" char_id="-1" frame_id="-1" name=""   text="第三次灼热的白色熔岩，大量倾注在我身上，几乎将我的肌肤完全覆盖。" voices=""/><clear @l="813" class="all"/><wait @l="815" time="1000"/><msg @l="817" char_id="-1" frame_id="-1" name="" text="之后———" voices=""/><msg @l="818" char_id="-1" frame_id="-1" name=""   text="男人们一个接一个地，不断向我的身体注入白浊液体。" voices=""/><msg @l="819" char_id="-1" frame_id="-1" name=""   text="然后又有其他男人，玩弄着我这沾满精液的身体，责弄我的胸部，抓挠我的臀部，让他们的肉棒再次硬挺勃起。"   voices=""/><msg @l="820" char_id="-1" frame_id="-1" name=""   text="从阴道和后庭的入口处，男人们多次射出的大量欲液已经装不下，咕噜咕噜地逆流而出。" voices=""/><clear @l="823" class="all"/><msg @l="825" char_id="-1" frame_id="-1" name=""   text="────不知道过了多久了……。" voices=""/><msg @l="826" char_id="-1" frame_id="-1" name=""   text="────不知道被多少人侵犯了……。" voices=""/><msg @l="827" char_id="-1" frame_id="-1" name=""   text="────不知道有多少精液被射进了我身体的各个洞穴中……。" voices=""/><msg @l="829" char_id="-1" frame_id="-1" name=""   text="我意识模糊，什么都记不清了……。" voices=""/><wait_chgmv/><ev @l="832" src="ev-034x1z1z2z4z3z5"/><msg @l="834" char_id="-1" frame_id="-1" name="朽木"   text="『呵呵呵……真美。真美啊，美帆君。今后我也会每天好好地侵犯你的。』" voices=""/><msg @l="836" char_id="0" frame_id="-1" name="美帆" text="『……呃啊……。』"   voices="miho00430"/><msg @l="838" char_id="-1" frame_id="-1" name="朽木" text="『来吧，下一位是哪位？』"   voices=""/><msg @l="840" char_id="-1" frame_id="-1" name="公司员工Z"   text="『终于轮到我了，下一个是我吧。』" voices=""/><msg @l="842" char_id="-1" frame_id="-1" name=""   text="说着，那位面相凶狠的公司职员掏出了镶有珍珠的肉棒对准了美帆。" voices=""/><msg @l="844" char_id="0" frame_id="-1" name="美帆" text="『……啊……。』"   voices="miho00840"/><msg @l="846" char_id="-1" frame_id="-1" name="朽木"   text="『哦呵，如果把这个插进去的话，仲根君说不定会高潮到发疯呢。』" voices=""/><msg @l="848" char_id="-1" frame_id="-1" name="公司员工Z"   text="『嘿嘿，要是插进我的东西，她可能不只是发疯，说不定会彻底坏掉呢。』" voices=""/><msg @l="850" char_id="-1" frame_id="-1" name="朽木" text="『呵呵，请便请便，随你喜欢。』"   voices=""/><msg @l="852" char_id="-1" frame_id="-1" name="公司员工A"   text="『那么，我也要开始第二轮了。这孩子这么可爱，今天我至少要做十次。』" voices=""/><msg @l="854" char_id="-1" frame_id="-1" name=""   text="男人们的淫秽对话在交谈中，沉浸在高潮余韵中的美帆已经听不到这些话语。" voices=""/><msg @l="856" char_id="0" frame_id="-1" name="美帆"   text="（……已经……怎样都好了……）" voices="miho10570"/><msg @l="858" char_id="0" frame_id="-1" name="美帆"   text="（我已经累了……真的累了……）" voices="miho10580"/><msg @l="860" char_id="-1" frame_id="-1" name="" text="我……缓缓地，坠落下去。"   voices=""/><msg @l="862" char_id="-1" frame_id="-1" name=""   text="然后，新的男人们的肉棒开始侵入美帆的身体———" voices=""/><clear @l="865" class="all"/><stopse @l="868" buf="3"/><wait_chgmv/><bg @l="871" src="black"/><end_scene @l="874"/><wait @l="877" time="1500"/><call @l="880" target="EventLabel_47@ending09"/><return @l="881" value="0&#13;&#10;"/></code></xscript>																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																															