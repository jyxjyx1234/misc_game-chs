<?xml version="1.0" encoding="utf-8"?><xscript><debug editor="&quot;C:\Program&#32;Files&#32;(x86)\sakura\sakura.exe&quot;&#32;&quot;%src%&quot;&#32;-Y=%line%"   src="D:\シロップ\町ぐるみの罠＋汚された夏セット版\汚された夏\完成データ\汚された夏\script\text\ex_ending01.txt"/><code><label @l="12" id="EventLabel_55"/><label @l="17" id="event_scene62"/><msg @l="19" char_id="-1" frame_id="-1" name="" text="………………………………。"   voices=""/><msg @l="20" char_id="-1" frame_id="-1" name="" text="……………………。" voices=""/><msg @l="21" char_id="-1" frame_id="-1" name="" text="…………。" voices=""/><bgm @l="25" src="bgm21" volume="1."/><msg @l="27" char_id="0" frame_id="-1" name="美帆"   text="『啊、啊啊………啊………………。』" voices="miho04940"/><msg @l="29" char_id="0" frame_id="-1" name="美帆"   text="『嗯啊……啊………不要、啊、呃！』" voices="miho04970"/><msg @l="31" char_id="0" frame_id="-1" name="美帆"   text="『啊、啊啊……啊、嗯、啊、啊、啊、啊！！！』" voices="miho04920"/><msg @l="33" char_id="0" frame_id="-1" name="美帆" text="『啊、啊啊啊啊啊啊啊啊啊！！！』"   voices="miho04870"/><msg @l="35" char_id="-1" frame_id="-1" name=""   text="美帆发出声音，身体颤抖着……这已经是第几次高潮了呢。到底要侵犯多少次才能满足呢……。" voices=""/><msg @l="36" char_id="-1" frame_id="-1" name="" text="…………。" voices=""/><msg @l="37" char_id="-1" frame_id="-1" name="" text="……………………。" voices=""/><msg @l="38" char_id="-1" frame_id="-1" name="" text="从那以后，已经过去了10个月的时间。"   voices=""/><msg @l="39" char_id="-1" frame_id="-1" name=""   text="逃跑的美帆被抓住后，在家中被粗绳捆绑监禁，从此每天都被熊野不断侵犯。" voices=""/><msg @l="40" char_id="-1" frame_id="-1" name=""   text="最终美帆怀上了孩子……被植入的那个孩子已经发育到临产前夕。" voices=""/><msg @l="41" char_id="-1" frame_id="-1" name=""   text="从那之后，原本一直在施加惩罚般折磨的熊野，开始像是要把自己的欲望发泄在美帆身上一样侵犯她。" voices=""/><msg @l="42" char_id="-1" frame_id="-1" name=""   text="……除了睡觉和吃饭的时间外，一直不断被侵犯着……" voices=""/><msg @l="43" char_id="-1" frame_id="-1" name=""   text="她的嘴唇已经很久没有发出任何言语——" voices=""/><msg @l="44" char_id="-1" frame_id="-1" name=""   text="美帆的眼睛里已经感觉不到任何光彩了——" voices=""/><wait_chgmv/><bg @l="48" src="bg01c"/><char @l="51" id="kuma" pos="center" src="kuma018f" y="-80"/><msg @l="53" char_id="-1" frame_id="-1" name="熊野" text="『哈、哈、哈、哈……』"   voices=""/><msg @l="55" char_id="-1" frame_id="-1" name="熊野" text="『呼……昏过去了吗……』"   voices=""/><msg @l="57" char_id="-1" frame_id="-1" name="" text="熊野像是吐出什么一样说道。"   voices=""/><msg @l="59" char_id="-1" frame_id="-1" name="熊野"   text="『但不知为何，孕妇真是不错啊……无论侵犯多少次，多少次都还是不够……就算一辈子插在里面也满足不了啊！』" voices=""/><msg @l="61" char_id="-1" frame_id="-1" name=""   text="尽管熊野的肉棒今晚已经射精了10次，却仍然在一跳一跳地搏动着，直挺挺地指向天空。"   voices=""/><msg @l="63" char_id="-1" frame_id="-1" name=""   text="熊野甚至自己都没有意识到，他对孕妇产生了异常的欲望。" voices=""/><msg @l="65" char_id="-1" frame_id="-1" name="熊野"   text="『又硬起来了……再来一次，狠狠地插进去！』" voices=""/><msg @l="67" char_id="-1" frame_id="-1" name=""   text="说完这话，熊野一边慢慢靠近美帆，一边拿出药丸嚼碎吞下。" voices=""/><msg @l="68" char_id="-1" frame_id="-1" name=""   text="随即熊野的眼睛闪烁着红光，身体膨胀变大了一圈，衣服被撑破了。" voices=""/><flash @l="71" count="4" fade="100" image="white"/><se @l="73" buf="1" src="ムチの音" volume="1."/><flash @l="76" count="4" fade="100" image="white"/><msg @l="77" char_id="-1" frame_id="-1" name="" text="撕啦撕啦撕" voices=""/><msg @l="79" char_id="-1" frame_id="-1" name="熊野"   text="『咕咕……咕咕咕，哈哈哈哈哈哈！我要再次侵犯你！彻彻底底地！』" voices=""/><clear @l="83" class="char"/><clear @l="90" class="all"/><label @l="94" id="chart_line69"/><wait_chgmv/><ev @l="98" src="ev-062"/><msg @l="100" char_id="-1" frame_id="-1" name="" text="噗嗤噗嗤噗嗤噗嗤噗嗤" voices=""/><msg @l="102" char_id="-1" frame_id="-1" name="熊野"   text="『什么啊，里面已经是大洪水了啊！肚子里的孩子要是知道了一定会吓一跳吧。』" voices=""/><msg @l="104" char_id="0" frame_id="-1" name="美帆" text="『嗯、嗯、嗯、嗯嗯！』"   voices="miho10980"/><msg @l="106" char_id="0" frame_id="-1" name="美帆"   text="『嗯啊…啊…不要，啊，啊呜！』" voices="miho04970"/><msg @l="108" char_id="-1" frame_id="-1" name="熊野" text="『哼，看来你已经听不见我的声音了吧。』"   voices=""/><msg @l="110" char_id="-1" frame_id="-1" name="熊野"   text="『算了，无所谓。作为替代，我会好好疼爱你的孩子的！！』" voices=""/><msg @l="112" char_id="-1" frame_id="-1" name=""   text="熊野这样说着，一边猛烈地向上挺动腰部，一边对着美帆高高隆起的肚子大喊。" voices=""/><msg @l="114" char_id="-1" frame_id="-1" name="熊野"   text="『喂！感觉如何？…今天也精神地闹腾着吗？』" voices=""/><msg @l="116" char_id="-1" frame_id="-1" name="熊野"   text="『被我射了这么多精液，想必会成为一个很喜欢精液的孩子吧。』" voices=""/><msg @l="118" char_id="-1" frame_id="-1" name="熊野"   text="『听说你是个女孩呢！等你出生后，我会一起调教你和你妈妈，把你培养成适合这个镇子的优秀母猪！！』"   voices=""/><msg @l="120" char_id="-1" frame_id="-1" name=""   text="熊野想象着自己对美帆肚子说的话变成现实的场景，肉棒因淫欲而变得更加坚硬，摩擦着湿漉漉的秘穴，让蜜汁发出的声音回荡在整个房间里。"   voices=""/><msg @l="122" char_id="-1" frame_id="-1" name="" text="咕啾、咕啾、咕啾、咕啾、咕啾"   voices=""/><msg @l="124" char_id="0" frame_id="-1" name="美帆" text="『嗯、啊啊啊！？』"   voices="miho10070"/><msg @l="126" char_id="0" frame_id="-1" name="美帆"   text="『嗯，嗯嗯……啊……嗯咕，啊，啊啊啊！！』" voices="miho05020"/><msg @l="127" char_id="-1" frame_id="-1" name=""   text="美帆已经只能感受到下腹部和秘穴传来的刺激，只能完全将身体委托给熊野的抽送。" voices=""/><msg @l="129" char_id="0" frame_id="-1" name="美帆"   text="『啊，啊啊……啊……啊………啊咕！！』" voices="miho04880"/><msg @l="131" char_id="-1" frame_id="-1" name=""   text="当熊野的肉棒抵达子宫，轻轻敲击时，她发出痛苦的喘息。" voices=""/><msg @l="132" char_id="-1" frame_id="-1" name=""   text="但是……她那朦胧的表情却没有丝毫变化。" voices=""/><msg @l="134" char_id="-1" frame_id="-1" name="熊野"   text="『呵呵呵，就这样神志不清已经好几天了……这种情况让我想起了与那个女人在一起的日子。』" voices=""/><msg @l="136" char_id="-1" frame_id="-1" name=""   text="熊野嘲笑般地说着，加快了腰部撞击的速度。" voices=""/><msg @l="137" char_id="-1" frame_id="-1" name=""   text="每当被顶弄一次，美帆的身体就无力地颤抖摇晃着。" voices=""/><msg @l="138" char_id="0" frame_id="-1" name="美帆" text="『呜啊！！？』"   voices="miho04930"/><msg @l="140" char_id="0" frame_id="-1" name="美帆"   text="『呜咕……啊、啊、啊啊……啊………。』" voices="miho10350"/><msg @l="142" char_id="0" frame_id="-1" name="美帆"   text="『啊啊、啊……呜啊……啊啊……啊嘶……呜啊啊……。』" voices="miho10370"/><msg @l="144" char_id="-1" frame_id="-1" name=""   text="熊野加快了抽送速度，快感随之增加，他的肉棒仿佛要冲破阴道最深处一般顶撞着她的秘裂。" voices=""/><msg @l="145" char_id="-1" frame_id="-1" name=""   text="这时，她那高高隆起的腹部内，胎儿似乎在炫耀自己的存在般开始剧烈活动起来。" voices=""/><msg @l="147" char_id="-1" frame_id="-1" name="熊野"   text="『原来如此，这种刺激让你很高兴吗！？呵呵呵……是因为给你的药的缘故吗，连孩子都在剧烈地躁动呢。』" voices=""/><msg @l="149" char_id="-1" frame_id="-1" name="熊野"   text="『别着急，马上就给你……满满地给你。』" voices=""/><msg @l="151" char_id="-1" frame_id="-1" name=""   text="熊野一边抚摸着美帆隆起的腹部，一边变得更加兴奋，他的肉棒变得更硬更大，同时加快了律动的频率。" voices=""/><msg @l="152" char_id="-1" frame_id="-1" name=""   text="在药物作用下变得更加柔软的阴道，轻而易举地吞下并包裹着熊野那变得更加坚硬的肉棒。" voices=""/><msg @l="154" char_id="0" frame_id="-1" name="美帆" text="『嗯，啊啊啊啊！！』"   voices="miho10440"/><msg @l="156" char_id="0" frame_id="-1" name="美帆"   text="『啊啊，啊……呜啊……啊啊……啊嘶……呜啊啊……。』" voices="miho10370"/><msg @l="158" char_id="0" frame_id="-1" name="美帆"   text="『嗯嗯……啊、啊啊……啊、啊、啊呜……。』" voices="miho10380"/><msg @l="160" char_id="0" frame_id="-1" name="美帆"   text="『啊……啊啊………啊、啊、啊……嗯、呜啊啊！』" voices="miho10390"/><msg @l="162" char_id="-1" frame_id="-1" name="熊野"   text="『果然孕妇的胎内最棒，和小丫头不同，有如成熟果实般的韵味。』" voices=""/><msg @l="164" char_id="-1" frame_id="-1" name=""   text="他这么说着，将龟头抵在子宫口，一边强行撑开一边将肉棒侵入子宫。" voices=""/><msg @l="165" char_id="-1" frame_id="-1" name=""   text="瞬间羊水溢出，但当肉茎推入一定程度后，子宫口紧紧地吸附住，一滴也不会漏出来了。" voices=""/><msg @l="167" char_id="0" frame_id="-1" name="美帆" text="『啊、啊啊啊！！！』"   voices="miho10540"/><msg @l="169" char_id="0" frame_id="-1" name="美帆"   text="『啊、啊啊……啊……啊………啊呜呜！！』" voices="miho04880"/><msg @l="171" char_id="-1" frame_id="-1" name="" text="美帆的表情严厉地扭曲着。"   voices=""/><msg @l="172" char_id="-1" frame_id="-1" name=""   text="即使在药物的作用下被扩张了，那本不该存在的刺激还是给美帆带来了难以忍受的痛苦。" voices=""/><msg @l="174" char_id="-1" frame_id="-1" name="熊野" text="『让我看看，你在哪里呢？』"   voices=""/><msg @l="176" char_id="-1" frame_id="-1" name="熊野"   text="『我要把我超浓的精液射在孩子身上！！』" voices=""/><msg @l="178" char_id="0" frame_id="-1" name="美帆"   text="『嗯啊……啊………不要，啊，呃啊！』" voices="miho04970"/><msg @l="180" char_id="0" frame_id="-1" name="美帆"   text="『嗯，嗯嗯……啊……呃，呃，啊啊啊！！』" voices="miho05020"/><msg @l="181" char_id="-1" frame_id="-1" name=""   text="熊野嘴角上扬地笑着，猛烈地将肉棒推入。" voices=""/><msg @l="182" char_id="-1" frame_id="-1" name=""   text="然后———就在顶端碰到什么东西的瞬间，熊野腰部猛地一颤，射出了大量精液。" voices=""/><flash @l="186" count="4" fade="100" image="white"/><msg @l="188" char_id="0" frame_id="-1" name="美帆" text="『嗯嗯嗯！！！』"   voices="miho05100"/><flash @l="192" count="4" fade="100" image="white"/><flash @l="195" count="4" fade="100" image="white"/><msg @l="197" char_id="0" frame_id="-1" name="美帆" text="『啊，啊啊啊啊啊啊啊啊啊！！！』"   voices="miho04870"/><msg @l="199" char_id="-1" frame_id="-1" name=""   text="美帆因为感受到渗入子宫的精液，以及腹中的孩子可能正欣喜地吸吮着那些精液，发出了近乎疯狂的声音，全身颤抖。"   voices=""/><msg @l="201" char_id="-1" frame_id="-1" name="熊野"   text="『呵呵……很好，就这样继续给你注入更多……真奈。』" voices=""/><msg @l="203" char_id="-1" frame_id="-1" name=""   text="熊野叫的不是美帆，而是另一个名字……。" voices=""/><msg @l="204" char_id="-1" frame_id="-1" name=""   text="但是，熊野的话语并没有传达到美帆的耳中………。" voices=""/><msg @l="205" char_id="-1" frame_id="-1" name=""   text="美帆已经对一切都无所谓了…………。" voices=""/><msg @l="207" char_id="-1" frame_id="-1" name=""   text="熊野面带满足的表情，尽管刚刚射精，却又开始律动起腰部。" voices=""/><msg @l="209" char_id="0" frame_id="-1" name="美帆"   text="『啊、啊啊………啊………………。』" voices="miho04940"/><msg @l="211" char_id="-1" frame_id="-1" name=""   text="美帆只是默默承受着这一切，不断发出无依无靠的喘息。" voices=""/><msg @l="213" char_id="-1" frame_id="-1" name=""   text="将身体交托于这可能永远持续下去的折磨之中……。" voices=""/><stopbgm @l="217" fadeout="1000"/><clear @l="223" class="all"/><wait @l="225" time="2000"/><end_scene @l="230"/><eval @l="233" expr="s.flagGallery=1&#13;&#10;"/><eval @l="235" expr="s.event62flag=1&#13;&#10;"/><call @l="238" target="EventLabel_154@staffroom"/><return @l="239" value="0&#13;&#10;"/><return @l="242" value=""/></code></xscript>																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																		