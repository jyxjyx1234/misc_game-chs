<?xml version="1.0" encoding="utf-8"?><xscript><debug editor="&quot;C:\Program&#32;Files&#32;(x86)\sakura\sakura.exe&quot;&#32;&quot;%src%&quot;&#32;-Y=%line%"   src="D:\シロップ\町ぐるみの罠＋汚された夏セット版\汚された夏\完成データ\汚された夏\script\text\root_akina01.txt"/><code><label @l="13" id="EventLabel_59"/><description @l="17" text="游泳教练·第一天"/><eval @l="19" expr="f.numDay=8&#13;&#10;"/><msgshow @l="21" show="false"/><wait_chgmv/><bg @l="23" src="day08" time="2000"/><wait @l="25" time="500"/><wait_chgmv/><bg @l="27" src="black" time="2000"/><msgshow @l="29" show="true"/><wait_chgmv/><bg @l="33" src="bg03"/><bgm @l="37" src="bgm04" volume="1."/><char @l="41" id="miho" pos="left" src="miho035"/><msg @l="43" char_id="0" frame_id="-1" name="美帆" text="『……早上好。』"   voices=""/><char @l="47" id="rei" pos="right" src="rei030"/><msg @l="49" char_id="1" frame_id="-1" name="玲"   text="『嗯，早上好……怎么了？』" voices=""/><char @l="53" id="rei" pos="right" src="rei034"/><msg @l="55" char_id="1" frame_id="-1" name="玲" text="『眼睛红通通的哦？』" voices=""/><msg @l="57" char_id="0" frame_id="-1" name="美帆"   text="『稍微有点，报告……为了写报告的日译没完成。』" voices=""/><char @l="61" id="rei" pos="right" src="rei030"/><msg @l="63" char_id="1" frame_id="-1" name="玲" text="『熬夜了？』" voices=""/><char @l="66" id="miho" pos="left" src="miho135"/><msg @l="68" char_id="0" frame_id="-1" name="美帆"   text="『不，我姑且还是睡了大约3小时……平时我不会这么乱来，所以现在真的很累啊。』" voices=""/><msg @l="70" char_id="1" frame_id="-1" name="玲" text="『平时你睡多久？』"   voices=""/><msg @l="72" char_id="0" frame_id="-1" name="美帆"   text="『至少睡8个小时呢……休息日的话，还会另外午睡。』" voices=""/><char @l="75" id="rei" pos="right" src="rei034"/><msg @l="77" char_id="1" frame_id="-1" name="玲" text="『……真厉害啊。』" voices=""/><msg @l="79" char_id="0" frame_id="-1" name="美帆"   text="『我从小就是只要睡眠时间少了，身体状况立刻就会变差。』" voices=""/><msg @l="81" char_id="0" frame_id="-1" name="美帆"   text="『虽然我一直很注意不要勉强自己……』" voices=""/><char @l="84" id="rei" pos="right" src="rei031"/><msg @l="86" char_id="1" frame_id="-1" name="玲"   text="『即使这样，像这次这种情况你还是拼命熬夜了啊。』" voices=""/><msg @l="88" char_id="1" frame_id="-1" name="玲"   text="『可是，为什么会有这么紧张的日程安排呢？』" voices=""/><char @l="91" id="rei" pos="right" src="rei030"/><msg @l="93" char_id="1" frame_id="-1" name="玲"   text="『报告的日译真的有这么多吗？』" voices=""/><char @l="96" id="miho" pos="left" src="miho035"/><msg @l="98" char_id="0" frame_id="-1" name="美帆"   text="『报告本身确实挺麻烦的，但最主要的原因是因为“一生的请求”……』" voices=""/><char @l="101" id="rei" pos="right" src="rei034"/><msg @l="103" char_id="1" frame_id="-1" name="玲" text="『一生的请求……？』"   voices=""/><clear @l="109" class="all"/><wait_chgmv/><bg @l="113" src="bg03"/><char @l="117" id="miho" pos="left" src="miho136"/><char @l="121" id="rei" pos="right" src="rei034"/><msg @l="123" char_id="1" frame_id="-1" name="玲" text="『……原来如此。』" voices=""/><char @l="126" id="rei" pos="right" src="rei030"/><msg @l="128" char_id="1" frame_id="-1" name="玲" text="『所以是“一生的请求”惹的祸啊。』"   voices=""/><msg @l="130" char_id="-1" frame_id="-1" name=""   text="我带着抱怨的语气，向学姐讲述了事情的经过。" voices=""/><msg @l="131" char_id="-1" frame_id="-1" name=""   text="顺便，我还偷偷地揭露了亚季奈过去那些“请求”所闯的祸。" voices=""/><char @l="134" id="miho" pos="left" src="miho035"/><msg @l="136" char_id="0" frame_id="-1" name="美帆"   text="『真是的，从以前开始每逢有事就说什么“一生的请求”然后提出各种过分的要求。』" voices=""/><char @l="139" id="miho" pos="left" src="miho135"/><msg @l="141" char_id="0" frame_id="-1" name="美帆"   text="『真希望她能考虑一下接受请求的人的感受……』" voices=""/><char @l="144" id="rei" pos="right" src="rei031"/><msg @l="146" char_id="1" frame_id="-1" name="玲"   text="『呵呵，确实如果一生的请求被用了好几次，接受的人也会很辛苦呢。』" voices=""/><char @l="149" id="rei" pos="right" src="rei030"/><msg @l="151" char_id="1" frame_id="-1" name="玲"   text="『不过，这也证明她很依赖你不是吗？』" voices=""/><char @l="154" id="miho" pos="left" src="miho035"/><msg @l="156" char_id="0" frame_id="-1" name="美帆"   text="『这，或许是这样没错……』" voices=""/><char @l="160" id="rei" pos="right" src="rei031"/><msg @l="162" char_id="1" frame_id="-1" name="玲" text="『加油吧，姐姐。』"   voices=""/><msg @l="164" char_id="0" frame_id="-1" name="美帆" text="『呜呜……这话让我感觉很复杂。』"   voices=""/><goto @l="167" cond="!(f.サークル見学会flag&#32;==&#32;2)&#13;&#10;"   label="TempLabel_212"/><char @l="171" id="rei" pos="right" src="rei034"/><msg @l="173" char_id="1" frame_id="-1" name="玲"   text="『啊，不过，如果去参加游泳集训的话，就没法参加社团活动了吧。』" voices=""/><char @l="176" id="miho" pos="left" src="miho036"/><msg @l="178" char_id="0" frame_id="-1" name="美帆"   text="『是啊……虽然好不容易加入了，但暂时只能请假了。』" voices=""/><char @l="182" id="rei" pos="right" src="rei031"/><msg @l="184" char_id="1" frame_id="-1" name="玲"   text="『没关系，我会向稻庭先生适当地解释的。』" voices=""/><msg @l="186" char_id="1" frame_id="-1" name="玲"   text="『虽然我们社团以“自由”为特色，但如果刚入会就突然不来了，还没有任何解释，大家肯定会担心的。』"   voices=""/><char @l="189" id="miho" pos="left" src="miho136"/><msg @l="191" char_id="0" frame_id="-1" name="美帆" text="『对不起……』"   voices=""/><goto @l="194" label="TempLabel_213"/><label @l="195" id="TempLabel_212"/><msg @l="198" char_id="1" frame_id="-1" name="玲" text="『呵呵。』" voices=""/><char @l="202" id="miho" pos="left" src="miho035"/><msg @l="204" char_id="0" frame_id="-1" name="美帆" text="『请，请别笑我……』"   voices=""/><char @l="208" id="rei" pos="right" src="rei030"/><msg @l="210" char_id="1" frame_id="-1" name="玲"   text="『对不起，我并没有恶意。』" voices=""/><msg @l="212" char_id="1" frame_id="-1" name="玲"   text="『我只是在感叹，不管怎么说到头来还是会答应她的请求，果然你很疼爱妹妹啊。』" voices=""/><char @l="215" id="miho" pos="left" src="miho136"/><msg @l="217" char_id="0" frame_id="-1" name="美帆"   text="『那是因为她总是在我无法拒绝的情况下提出请求……』" voices=""/><char @l="220" id="miho" pos="left" src="miho033"/><msg @l="222" char_id="0" frame_id="-1" name="美帆"   text="『我并不是因为她是妹妹就特别对待她……不是的。』" voices=""/><char @l="225" id="rei" pos="right" src="rei031"/><msg @l="227" char_id="1" frame_id="-1" name="玲" text="『哎呀，你不用害羞嘛。』"   voices=""/><char @l="230" id="rei" pos="right" src="rei030"/><msg @l="232" char_id="1" frame_id="-1" name="玲"   text="『我可能之前也说过，我是独生子女所以很羡慕你们。』" voices=""/><msg @l="234" char_id="1" frame_id="-1" name="玲"   text="『既没有会对我任性的妹妹，也没有会听我任性要求的姐姐。』" voices=""/><char @l="237" id="miho" pos="left" src="miho030"/><msg @l="239" char_id="0" frame_id="-1" name="美帆" text="『是这样的吗……？』"   voices=""/><char @l="243" id="rei" pos="right" src="rei031"/><msg @l="245" char_id="1" frame_id="-1" name="玲" text="『就是这样的。』" voices=""/><label @l="248" id="TempLabel_213"/><clear @l="255" class="all"/><wait_chgmv/><bg @l="259" src="bg09"/><char @l="263" id="miho" pos="auto" src="miho110"/><bgm @l="266" src="bgm02" volume="1."/><msg @l="268" char_id="0" frame_id="-1" name="美帆" text="『………。』" voices=""/><msg @l="270" char_id="-1" frame_id="-1" name="" text="讲座一结束。" voices=""/><msg @l="271" char_id="-1" frame_id="-1" name=""   text="我无奈地……前往了室内游泳池。" voices=""/><msg @l="272" char_id="-1" frame_id="-1" name=""   text="当然，我并不打算轻易答应亚季奈的“一生的请求”。" voices=""/><msg @l="273" char_id="-1" frame_id="-1" name=""   text="只是，无论是接受还是拒绝担任游泳集训的教练，我觉得……至少得见一面才能谈。" voices=""/><msg @l="274" char_id="-1" frame_id="-1" name=""   text="……不过最终，我可能还是会被亚季奈说服吧。" voices=""/><char @l="277" id="miho" pos="auto" src="miho016"/><msg @l="279" char_id="0" frame_id="-1" name="美帆"   text="(说起来……我好像还是第一次来这个游泳池呢……)" voices=""/><char @l="283" id="miho" pos="auto" src="miho116"/><msg @l="285" char_id="0" frame_id="-1" name="美帆"   text="(……话说……从那以后我有没有游过泳呢……)" voices=""/><msg @l="287" char_id="-1" frame_id="-1" name=""   text="从那个在我心中留下深深伤痕的事件发生至今，已经过去三年了。" voices=""/><msg @l="288" char_id="-1" frame_id="-1" name=""   text="多亏了避免公开，之后也没有人提及或议论那个事件……" voices=""/><msg @l="289" char_id="-1" frame_id="-1" name="" text="我过着平静的日子……。"   voices=""/><msg @l="290" char_id="-1" frame_id="-1" name=""   text="……但这并不意味着事件本身就此消失了。" voices=""/><msg @l="291" char_id="-1" frame_id="-1" name=""   text="因为那件事我放弃了游泳，之后也主动不再游泳。" voices=""/><msg @l="292" char_id="-1" frame_id="-1" name=""   text="游泳的时候……总觉得会想起那个事件……。" voices=""/><msg @l="293" char_id="-1" frame_id="-1" name=""   text="……所以……我一直避开游泳池和海滩这类地方。" voices=""/><msg @l="295" char_id="0" frame_id="-1" name="美帆" text="(已经三年了……吗)"   voices=""/><msg @l="297" char_id="0" frame_id="-1" name="美帆" text="(唉，已经过了这么久了……)"   voices=""/><stopbgm @l="301" fadeout="1000"/><clear @l="306" class="all"/><msg @l="308" char_id="-1" frame_id="-1" name=""   text="在感受到不知不觉流逝的时间的那一瞬间，当年的事情如同闪回般浮现在脑海中。" voices=""/><bgm @l="312" src="bgm03" volume="1."/><msg @l="314" char_id="-1" frame_id="-1" name=""   text="游泳练习结束后，我正在更衣室换衣服……。" voices=""/><msg @l="315" char_id="-1" frame_id="-1" name=""   text="……突然一个男人从后面抱住了我……。" voices=""/><msg @l="316" char_id="-1" frame_id="-1" name=""   text="我因这突如其来的事情而震惊，甚至连声音都发不出来。" voices=""/><msg @l="317" char_id="-1" frame_id="-1" name=""   text="男人的手隔着湿漉漉的泳衣粗暴地揉捏着我的胸部……。" voices=""/><msg @l="318" char_id="-1" frame_id="-1" name=""   text="另一只手则隔着同样湿漉漉的泳衣摩擦我的下体……。" voices=""/><msg @l="319" char_id="-1" frame_id="-1" name="" text="就在那一瞬间——。" voices=""/><msg @l="320" char_id="-1" frame_id="-1" name=""   text="我尖叫着挣脱了男人的手，跑出更衣室后呼救。" voices=""/><msg @l="321" char_id="-1" frame_id="-1" name=""   text="我发出了自己能发出的最大声音，竭尽全力地……。" voices=""/><msg @l="322" char_id="-1" frame_id="-1" name="" text="……然后……。" voices=""/><msg @l="324" char_id="0" frame_id="-1" name="美帆" text="(啊……)" voices=""/><clear @l="330" class="all"/><msgshow @l="332" show="true"/><wait_chgmv/><bg @l="336" src="bg09"/><char @l="340" id="miho" pos="auto" src="miho114"/><msg @l="342" char_id="0" frame_id="-1" name="美帆" text="(不知不觉……)" voices=""/><msg @l="344" char_id="-1" frame_id="-1" name=""   text="回过神来，我已经走到了通往有室内游泳池的体育馆的连廊。" voices=""/><msg @l="345" char_id="-1" frame_id="-1" name=""   text="这一带因为不通往其他校舍的缘故，人来人往很少。" voices=""/><char @l="349" id="miho" pos="auto" src="miho116"/><msg @l="351" char_id="0" frame_id="-1" name="美帆" text="………。" voices=""/><msg @l="353" char_id="0" frame_id="-1" name="美帆"   text="(……那时的事……记得很清楚………)" voices=""/><msg @l="355" char_id="0" frame_id="-1" name="美帆"   text="(……我……果然，还是忘不掉吧………)" voices=""/><msg @l="357" char_id="-1" frame_id="-1" name=""   text="那时，袭击我的是担任游泳部顾问的教师。" voices=""/><msg @l="358" char_id="-1" frame_id="-1" name=""   text="幸好事件没有公开化，而且只是未遂，他才免于被吊销教师资格证……。" voices=""/><msg @l="359" char_id="-1" frame_id="-1" name=""   text="……据说是这样，不过后来怎么样了我就不清楚了。" voices=""/><msg @l="360" char_id="-1" frame_id="-1" name=""   text="只是，大家都说他大概再也不能以教育者的身份自居了……。" voices=""/><char @l="363" id="miho" pos="auto" src="miho016"/><msg @l="365" char_id="0" frame_id="-1" name="美帆" text="(··不行··得好好忘记才行)"   voices=""/><stopbgm @l="369" fadeout="1000"/><char @l="373" id="miho" pos="auto" src="miho110"/><msg @l="375" char_id="0" frame_id="-1" name="美帆"   text="(一直在意过去的事情也没有用······对吧)" voices=""/><clear @l="381" class="all"/><wait_chgmv/><bg @l="385" src="bg10m1"/><bgm @l="389" src="bgm02" volume="1."/><char @l="393" id="miho" pos="auto" src="miho014"/><msg @l="395" char_id="0" frame_id="-1" name="美帆" text="(····哎，挺宽敞的嘛)"   voices=""/><msg @l="397" char_id="-1" frame_id="-1" name=""   text="我来到了体育馆三楼的室内游泳池。" voices=""/><msg @l="398" char_id="-1" frame_id="-1" name=""   text="虽然听说这所大学并不太重视游泳……" voices=""/><msg @l="399" char_id="-1" frame_id="-1" name=""   text="但就我所知，设备似乎都是最新式的。" voices=""/><msg @l="401" char_id="0" frame_id="-1" name="美帆"   text="(既然是新大学，设施新是理所当然的··)" voices=""/><char @l="404" id="miho" pos="auto" src="miho010"/><msg @l="406" char_id="0" frame_id="-1" name="美帆" text="(总觉得有点奇怪··)"   voices=""/><char @l="410" id="miho" pos="auto" src="miho110"/><msg @l="412" char_id="0" frame_id="-1" name="美帆"   text="(··不，不对··亚季奈在哪呢····)" voices=""/><msg @l="414" char_id="-1" frame_id="-1" name="" text="我环顾四周。" voices=""/><msg @l="415" char_id="-1" frame_id="-1" name=""   text="泳池边和泳池里有几个人，各自在练习着。" voices=""/><msg @l="416" char_id="-1" frame_id="-1" name="" text="我不知道谁是游泳部的，谁是外来的。"   voices=""/><msg @l="417" char_id="-1" frame_id="-1" name=""   text="也不知道哪个孩子是从亚季奈的学校来的。" voices=""/><char @l="421" id="miho" pos="auto" src="miho011"/><msg @l="423" char_id="0" frame_id="-1" name="美帆"   text="(啊··那个孩子，姿势真漂亮)" voices=""/><char @l="427" id="miho" pos="auto" src="miho110"/><msg @l="429" char_id="0" frame_id="-1" name="美帆"   text="(如果再稍微调整一下换气的时机，成绩应该能提高··)" voices=""/><msg @l="431" char_id="-1" frame_id="-1" name="" text="应该是在计时吧。"   voices=""/><msg @l="432" char_id="-1" frame_id="-1" name=""   text="有一个女孩默默地在50米泳道来回游着。" voices=""/><msg @l="433" char_id="-1" frame_id="-1" name=""   text="池边拿着秒表的也是穿泳装的女孩，看起来应该不是亚季奈说的“集训”练习在计时。"   voices=""/><msg @l="434" char_id="-1" frame_id="-1" name=""   text="如果是这样，应该是大学里的人吧……？" voices=""/><char @l="437" id="miho" pos="auto" src="miho014"/><msg @l="439" char_id="0" frame_id="-1" name="美帆"   text="(哎，我们大学也有这么游泳漂亮的孩子啊··)" voices=""/><char @l="442" id="miho" pos="auto" src="miho016"/><msg @l="444" char_id="0" frame_id="-1" name="美帆"   text="(有这样的人在，我觉得就算我不当教练也没问题了··)" voices=""/><msg @l="446" char_id="0" frame_id="-1" name="美帆"   text="(··就算我这么想，不说服亚季奈的话也没有意义啊)" voices=""/><msg @l="448" char_id="0" frame_id="-1" name="美帆"   text="(总之··等亚季奈来了再说比较好吗？)" voices=""/><se @l="451" buf="1" src="ホイッスル（室内プール）" volume="1."/><msg @l="453" char_id="-1" frame_id="-1" name=""   text="游泳的女孩碰到了跳台，计时的女孩吹响哨子，宣告计时结束。" voices=""/><char @l="456" id="miho" pos="auto" src="miho010"/><msg @l="458" char_id="0" frame_id="-1" name="美帆" text="(看来计时结束了)"   voices="miho03260"/><msg @l="460" char_id="0" frame_id="-1" name="美帆"   text="(那个游泳的孩子摘下泳帽和护目镜··诶！？)" voices="miho03270"/><char @l="463" id="miho" pos="auto" src="miho014"/><bgm @l="466" src="bgm06" volume="1."/><label @l="469" id="chart_line6"/><wait_chgmv/><ev @l="472" src="ev-002"/><description @l="475" text="正在练习的亚季奈"/><msg @l="477" char_id="2" frame_id="-1" name="穿泳装的女孩" text="『……。』"   voices="akina00000"/><msg @l="479" char_id="0" frame_id="-1" name="美帆" text="(不会吧··那是亚季奈啊)"   voices="miho03280"/><msg @l="481" char_id="-1" frame_id="-1" name=""   text="摘下泳帽和护目镜爬上泳池边的人……是亚季奈。" voices=""/><msg @l="482" char_id="-1" frame_id="-1" name=""   text="亚季奈似乎没有注意到这边，正和刚才计时的女孩聊天，同时整理着泳装的下摆。" voices=""/><msg @l="484" char_id="0" frame_id="-1" name="美帆"   text="(好像是春季大赛的冠军··老实说，没想到她的姿势这么漂亮··)"   voices="miho03290"/><msg @l="486" char_id="0" frame_id="-1" name="美帆"   text="(我在游泳部的时候，有时会去市民游泳池看看她们的游泳姿势··比那时候进步太多了，我都认不出来了··)"   voices="miho03300"/><msg @l="488" char_id="0" frame_id="-1" name="美帆" text="『亚季奈！』"   voices="miho03310"/><wait_chgmv/><ev @l="491" src="ev-002x1"/><msg @l="493" char_id="2" frame_id="-1" name="亚季奈" text="『嗯……？』"   voices="akina00010"/><msg @l="495" char_id="-1" frame_id="-1" name=""   text="听到有人叫自己的名字，亚季奈转过身来。" voices=""/><msg @l="496" char_id="-1" frame_id="-1" name=""   text="但她似乎不知道是谁在叫她，东张西望着。" voices=""/><msg @l="498" char_id="0" frame_id="-1" name="美帆" text="『亚季奈，这边，这边。』"   voices="miho03320"/><wait_chgmv/><ev @l="501" src="ev-002x2"/><msg @l="503" char_id="2" frame_id="-1" name="亚季奈" text="『啊，姐姐！！』"   voices="akina00020"/><msg @l="505" char_id="2" frame_id="-1" name="亚季奈" text="『你真的来了！！』"   voices="akina00030"/><msg @l="507" char_id="0" frame_id="-1" name="美帆"   text="『被那样挂电话，我怎么可能不来嘛～。』" voices="miho03330"/><msg @l="509" char_id="2" frame_id="-1" name="亚季奈" text="『嘿嘿嘿，计划成功～。』"   voices="akina00040"/><msg @l="511" char_id="0" frame_id="-1" name="美帆" text="『真是的……』"   voices="miho03340"/><clear @l="514" class="all"/><wait_chgmv/><bg @l="517" src="bg10m1"/><char @l="520" id="miho" pos="left" src="miho016"/><char @l="523" id="akina" pos="right" src="akina161"/><description @l="526" text="游泳教练·第一天"/><msg @l="528" char_id="2" frame_id="-1" name="亚季奈" text="『哟。姐姐，好久不见啊。』"   voices=""/><msg @l="530" char_id="0" frame_id="-1" name="美帆" text="『什么好久不见啊！』"   voices=""/><char @l="533" id="miho" pos="left" src="miho116"/><msg @l="535" char_id="0" frame_id="-1" name="美帆"   text="『我还以为难得你主动打电话过来呢……结果突然就让我当游泳集训的教练……』" voices=""/><char @l="538" id="akina" pos="right" src="akina062"/><msg @l="540" char_id="2" frame_id="-1" name="亚季奈"   text="『好啦好啦，别在意这些小细节。』" voices=""/><char @l="543" id="miho" pos="left" src="miho014"/><msg @l="545" char_id="0" frame_id="-1" name="美帆" text="『我当然要在意！』" voices=""/><char @l="548" id="miho" pos="left" src="miho016"/><msg @l="550" char_id="0" frame_id="-1" name="美帆"   text="『话说回来，为什么游泳集训要来我们大学啊。』" voices=""/><msg @l="552" char_id="0" frame_id="-1" name="美帆"   text="『亚季奈你上的学校，又不是我们大学的附属学校吧？』" voices=""/><char @l="555" id="akina" pos="right" src="akina160"/><msg @l="557" char_id="2" frame_id="-1" name="亚季奈" text="『详细情况我也不太清楚啦～。』"   voices=""/><msg @l="559" char_id="2" frame_id="-1" name="亚季奈"   text="『··刚好，老师找到的就是姐姐你上的大学！』" voices=""/><char @l="562" id="miho" pos="left" src="miho010"/><msg @l="564" char_id="0" frame_id="-1" name="美帆" text="『是、是这样啊……。』"   voices=""/><char @l="567" id="miho" pos="left" src="miho116"/><msg @l="569" char_id="0" frame_id="-1" name="美帆"   text="『但是，我们学校有住宿设施吗？』" voices=""/><char @l="572" id="akina" pos="right" src="akina061"/><msg @l="574" char_id="2" frame_id="-1" name="亚季奈"   text="『好像有个挺老旧的地方？』" voices=""/><char @l="577" id="akina" pos="right" src="akina060"/><msg @l="579" char_id="2" frame_id="-1" name="亚季奈"   text="『本来是个旅馆还是什么的，没有拆掉而是保留下来，夏天什么的当集训场所用。』" voices=""/><char @l="582" id="miho" pos="left" src="miho010"/><msg @l="584" char_id="0" frame_id="-1" name="美帆" text="『嗯～……。』" voices=""/><char @l="587" id="miho" pos="left" src="miho116"/><msg @l="589" char_id="-1" frame_id="-1" name=""   text="让亚季奈比我更了解大学里的事情，有点羞耻呢……。" voices=""/><char @l="592" id="akina" pos="right" src="akina061"/><msg @l="594" char_id="2" frame_id="-1" name="亚季奈"   text="『话，话说回来，姐姐。快点换衣服过来吧？』" voices=""/><char @l="597" id="akina" pos="right" src="akina162"/><msg @l="599" char_id="2" frame_id="-1" name="亚季奈"   text="『在泳池边上只有一个人穿便服看起来很傻哦？』" voices=""/><char @l="602" id="miho" pos="left" src="miho016"/><msg @l="604" char_id="0" frame_id="-1" name="美帆" text="『抱歉我傻啊……。』"   voices=""/><char @l="607" id="miho" pos="left" src="miho110"/><msg @l="609" char_id="0" frame_id="-1" name="美帆"   text="『而且我还没有答应要当教练呢，一句话都没……』" voices=""/><char @l="612" id="akina" pos="right" src="akina061"/><msg @l="614" char_id="2" frame_id="-1" name="亚季奈"   text="『好啦好啦，这种事情不重要啦，快去更衣室！』" voices=""/><char @l="617" id="akina" pos="right" src="akina062"/><msg @l="619" char_id="2" frame_id="-1" name="亚季奈"   text="『反正那个包里面有泳衣吧？』" voices=""/><char @l="622" id="miho" pos="left" src="miho016"/><msg @l="624" char_id="0" frame_id="-1" name="美帆" text="『呜……那个……。』"   voices=""/><msg @l="626" char_id="-1" frame_id="-1" name="" text="确实，包里装着泳衣。"   voices=""/><msg @l="627" char_id="-1" frame_id="-1" name=""   text="是去年暑假前准备去海边，和朋友一起去买的泳衣。" voices=""/><msg @l="628" char_id="-1" frame_id="-1" name=""   text="结果最后没去海边……所以泳衣几乎还是全新的。" voices=""/><char @l="631" id="akina" pos="right" src="akina161"/><msg @l="633" char_id="2" frame_id="-1" name="亚季奈"   text="『好啦好啦，快点去换衣服！』" voices=""/><char @l="636" id="miho" pos="left" src="miho114"/><msg @l="638" char_id="0" frame_id="-1" name="美帆" text="『哇……别推我啦。』"   voices=""/><clear @l="641" class="all"/><wait_chgmv/><bg @l="644" src="bg11"/><char @l="647" id="akina" pos="left" src="akina161"/><msg @l="649" char_id="2" frame_id="-1" name="亚季奈" text="『这里就是更衣室了。』"   voices=""/><char @l="652" id="miho" pos="right" src="miho014"/><msg @l="654" char_id="0" frame_id="-1" name="美帆"   text="『什么更衣室……亚季奈……你这家伙。』" voices=""/><char @l="657" id="akina" pos="left" src="akina061"/><msg @l="659" char_id="2" frame_id="-1" name="亚季奈" text="『姐姐，你真是输不起啊？』"   voices=""/><char @l="662" id="akina" pos="left" src="akina067"/><msg @l="664" char_id="2" frame_id="-1" name="亚季奈"   text="『都到这一步了就乖乖当教练吧！OK？』" voices=""/><char @l="667" id="miho" pos="right" src="miho016"/><msg @l="669" char_id="0" frame_id="-1" name="美帆" text="『唔……。』" voices=""/><char @l="672" id="akina" pos="left" src="akina161"/><msg @l="674" char_id="2" frame_id="-1" name="亚季奈" text="『OK！？』" voices=""/><msg @l="676" char_id="0" frame_id="-1" name="美帆" text="『好，好吧……。』"   voices=""/><char @l="679" id="akina" pos="left" src="akina061"/><msg @l="681" char_id="2" frame_id="-1" name="亚季奈" text="『好，成交～♪』"   voices=""/><msg @l="683" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><char @l="686" id="miho" pos="right" src="miho110"/><msg @l="688" char_id="-1" frame_id="-1" name="" text="什么时候有过“交易”或“谈判”了？"   voices=""/><msg @l="689" char_id="-1" frame_id="-1" name="" text="说实话，这简直就像是恶劣的上门推销。"   voices=""/><char @l="692" id="akina" pos="left" src="akina160"/><msg @l="694" char_id="2" frame_id="-1" name="亚季奈"   text="『那么，我在泳池那边等你哦。』" voices=""/><char @l="697" id="miho" pos="right" src="miho016"/><msg @l="699" char_id="0" frame_id="-1" name="美帆" text="『嗯，嗯。』" voices=""/><char @l="702" id="akina" pos="left" src="akina060"/><msg @l="704" char_id="2" frame_id="-1" name="亚季奈" text="『姐姐。』" voices=""/><char @l="707" id="miho" pos="right" src="miho010"/><msg @l="709" char_id="0" frame_id="-1" name="美帆" text="『什么事？』" voices=""/><char @l="712" id="akina" pos="left" src="akina162"/><msg @l="714" char_id="2" frame_id="-1" name="亚季奈"   text="『如果你逃跑的话，我就告诉妈妈，让她减少你的零花钱哦。』" voices=""/><char @l="717" id="miho" pos="right" src="miho014"/><msg @l="719" char_id="0" frame_id="-1" name="美帆" text="『什…我才不会逃跑呢！』"   voices=""/><char @l="722" id="akina" pos="left" src="akina161"/><msg @l="724" char_id="2" frame_id="-1" name="亚季奈" text="『啊哈哈哈哈～。』"   voices=""/><stopbgm @l="727" fadeout="1000"/><clear @l="730" class="char"/><char @l="732" id="miho" pos="auto" src="miho016"/><bgm @l="735" src="bgm02" volume="1."/><msg @l="738" char_id="0" frame_id="-1" name="美帆" text="『……真是的。』" voices=""/><msg @l="740" char_id="-1" frame_id="-1" name=""   text="我怨恨地看着亚季奈跑出更衣室的背影。" voices=""/><msg @l="741" char_id="-1" frame_id="-1" name="" text="……。" voices=""/><msg @l="742" char_id="-1" frame_id="-1" name=""   text="……其实……今天带来的泳衣就是……那个……。" voices=""/><msg @l="743" char_id="-1" frame_id="-1" name=""   text="相当……不如说，是非常大胆的设计。" voices=""/><char @l="746" id="miho" pos="auto" src="miho116"/><msg @l="748" char_id="0" frame_id="-1" name="美帆"   text="『但是……只有这一件泳衣了……。』" voices=""/><msg @l="750" char_id="0" frame_id="-1" name="美帆" text="『………。』" voices=""/><char @l="753" id="miho" pos="auto" src="miho016"/><msg @l="755" char_id="0" frame_id="-1" name="美帆" text="『……没办法……吧。』"   voices=""/><msg @l="757" char_id="0" frame_id="-1" name="美帆" text="『总之，先换上吧……。』"   voices=""/><clear @l="760" class="all"/><wait_chgmv/><bg @l="763" src="bg11"/><char @l="766" id="miho" pos="auto" src="miho163"/><msg @l="768" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="770" char_id="-1" frame_id="-1" name="" text="虽然换上了泳衣……。"   voices=""/><msg @l="771" char_id="-1" frame_id="-1" name=""   text="但是……怎么说呢……总感觉太过显眼了。" voices=""/><msg @l="772" char_id="-1" frame_id="-1" name=""   text="在周围的人都穿着竞泳泳衣的情况下，只有自己一个人穿比基尼，这也太引人注目了……" voices=""/><msg @l="773" char_id="-1" frame_id="-1" name=""   text="……而且这个颜色也相当醒目。" voices=""/><msg @l="775" char_id="0" frame_id="-1" name="美帆"   text="『不过……这种理由，亚季奈肯定不会接受的……。』" voices=""/><char @l="778" id="miho" pos="auto" src="miho166"/><msg @l="780" char_id="0" frame_id="-1" name="美帆" text="『……只能去了吧……。』"   voices=""/><clear @l="783" class="all"/><wait_chgmv/><bg @l="786" src="bg10m1"/><char @l="789" id="miho" pos="auto" src="miho166"/><msg @l="791" char_id="0" frame_id="-1" name="美帆"   text="『啊，亚季奈……我换好了，但是……。』" voices=""/><char @l="794" id="miho" pos="auto" src="miho165"/><msg @l="796" char_id="0" frame_id="-1" name="美帆" text="『这件泳衣……太引人注目了吧……。』"   voices=""/><clear @l="799" class="char"/><char @l="801" id="miho" pos="left" src="miho166"/><char @l="803" id="akina" pos="right" src="akina164"/><bgm @l="806" src="bgm06" volume="1."/><msg @l="808" char_id="2" frame_id="-1" name="亚季奈"   text="『哇！姐姐居然穿比基尼，真大胆呢。』" voices=""/><char @l="811" id="akina" pos="right" src="akina060"/><msg @l="813" char_id="2" frame_id="-1" name="亚季奈"   text="『我本来以为你会穿平常那种连衣裙式泳衣，所以就说普通款式也可以的……不过，既然这样的话，穿比基尼也行吧。』"   voices=""/><char @l="816" id="akina" pos="right" src="akina062"/><char @l="819" id="miho" pos="left" src="miho065"/><msg @l="821" char_id="0" frame_id="-1" name="美帆" text="『呜呜……一点都不行啊。』"   voices=""/><msg @l="823" char_id="0" frame_id="-1" name="美帆"   text="『要是知道会这样，我就好好买一件竞泳泳衣了……。』" voices=""/><char @l="826" id="akina" pos="right" src="akina160"/><msg @l="828" char_id="2" frame_id="-1" name="亚季奈"   text="『但是姐姐，你不是之前说再也不想穿竞泳泳衣了吗？』" voices=""/><char @l="831" id="miho" pos="left" src="miho160"/><msg @l="833" char_id="0" frame_id="-1" name="美帆"   text="『嗯……是这样没错，但是……。』" voices=""/><char @l="836" id="akina" pos="right" src="akina060"/><msg @l="838" char_id="2" frame_id="-1" name="亚季奈"   text="『确实，对于那种争夺零点几秒的世界感到疲惫，而放弃游泳的姐姐的心情，我也不是不能理解……。』"   voices=""/><char @l="841" id="akina" pos="right" src="akina167"/><msg @l="843" char_id="2" frame_id="-1" name="亚季奈"   text="『但也没必要连泳衣都厌恶吧。』" voices=""/><char @l="846" id="miho" pos="left" src="miho166"/><msg @l="848" char_id="0" frame_id="-1" name="美帆"   text="『这个……我自己……也是……这么想的。』" voices=""/><char @l="851" id="miho" pos="left" src="miho066"/><msg @l="853" char_id="0" frame_id="-1" name="美帆" text="『但是，总是……有些抵触。』"   voices=""/><char @l="856" id="akina" pos="right" src="akina060"/><msg @l="858" char_id="2" frame_id="-1" name="亚季奈" text="『嗯～……。』"   voices=""/><msg @l="860" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="862" char_id="0" frame_id="-1" name="美帆"   text="(我放弃游泳的真正原因……连亚季奈都不知道)" voices=""/><msg @l="864" char_id="0" frame_id="-1" name="美帆"   text="(绝对不能让亚季奈知道这件事……)" voices=""/><char @l="867" id="akina" pos="right" src="akina167"/><msg @l="869" char_id="2" frame_id="-1" name="亚季奈"   text="『真是的，你这样闷闷不乐是个坏习惯。』" voices=""/><char @l="872" id="akina" pos="right" src="akina062"/><msg @l="874" char_id="2" frame_id="-1" name="亚季奈"   text="『这件泳衣挺好的嘛。……胸部看起来更丰满了，对姐姐来说已经很性感了。』" voices=""/><char @l="877" id="miho" pos="left" src="miho164"/><msg @l="879" char_id="0" frame_id="-1" name="美帆" text="『亚季奈！』" voices=""/><char @l="882" id="akina" pos="right" src="akina161"/><msg @l="884" char_id="2" frame_id="-1" name="亚季奈"   text="『啊哈哈哈，姐姐生气啦～。』" voices=""/><clear @l="887" layer="akina"/><char @l="890" id="miho" pos="left" src="miho160"/><msg @l="892" char_id="-1" frame_id="-1" name=""   text="亚季奈像是逃开我一样跑向泳池边。" voices=""/><msg @l="893" char_id="-1" frame_id="-1" name=""   text="像小狗一样跑来跑去的亚季奈，看起来非常可爱。" voices=""/><msg @l="895" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="897" char_id="0" frame_id="-1" name="美帆" text="(必须尽快忘记……)"   voices=""/><msg @l="899" char_id="0" frame_id="-1" name="美帆" text="(亚季奈也……在努力啊)"   voices=""/><clear @l="902" class="all"/><wait_chgmv/><bg @l="905" src="bg10m1"/><char @l="908" id="miho" pos="left" src="miho060"/><char @l="911" id="akina" pos="right" src="akina161"/><msg @l="913" char_id="0" frame_id="-1" name="美帆" text="『话说……指导老师呢？』"   voices=""/><msg @l="915" char_id="-1" frame_id="-1" name=""   text="虽然是被妹妹拜托当教练，但我本来是局外人。" voices=""/><msg @l="916" char_id="-1" frame_id="-1" name=""   text="我先环顾泳池，想找指导老师说明情况，但没看到相关人士的身影。" voices=""/><char @l="919" id="akina" pos="right" src="akina064"/><msg @l="921" char_id="2" frame_id="-1" name="亚季奈" text="『啊，今天老师休息。』"   voices=""/><char @l="924" id="miho" pos="left" src="miho064"/><msg @l="926" char_id="0" frame_id="-1" name="美帆" text="『休息？』" voices=""/><char @l="929" id="miho" pos="left" src="miho160"/><msg @l="931" char_id="-1" frame_id="-1" name=""   text="集训第一天指导老师就休息……这样真的没问题吗？" voices=""/><char @l="934" id="akina" pos="right" src="akina060"/><msg @l="936" char_id="2" frame_id="-1" name="亚季奈"   text="『好像是有个必须参加的会议。』" voices=""/><char @l="939" id="miho" pos="left" src="miho166"/><msg @l="941" char_id="0" frame_id="-1" name="美帆" text="『会议……是吗？』" voices=""/><msg @l="943" char_id="-1" frame_id="-1" name=""   text="集训第一天没有指导老师，真是奇怪……" voices=""/><msg @l="945" char_id="0" frame_id="-1" name="美帆"   text="(即使指导老师是那样，亚季奈的实力还是提高了呢)" voices=""/><char @l="948" id="miho" pos="left" src="miho060"/><msg @l="950" char_id="0" frame_id="-1" name="美帆"   text="(难道……亚季奈的天赋真的很好吗)" voices=""/><msg @l="952" char_id="-1" frame_id="-1" name="" text="回想起刚才看到的亚季奈的游泳姿态。"   voices=""/><msg @l="953" char_id="-1" frame_id="-1" name=""   text="她全身充分伸展，追求毫无多余动作的速度的姿势，同时能感受到她是在享受游泳的乐趣。" voices=""/><msg @l="954" char_id="-1" frame_id="-1" name=""   text="也就是说，她很喜欢游泳吧。" voices=""/><msg @l="955" char_id="-1" frame_id="-1" name=""   text="怎么说呢，让我想起了以前喜欢游泳的自己……非常羡慕。" voices=""/><char @l="958" id="akina" pos="right" src="akina064"/><msg @l="960" char_id="2" frame_id="-1" name="亚季奈" text="『姐姐？』" voices=""/><char @l="963" id="miho" pos="left" src="miho064"/><msg @l="965" char_id="0" frame_id="-1" name="美帆" text="『啊，啊……抱歉。』"   voices=""/><char @l="968" id="miho" pos="left" src="miho066"/><msg @l="970" char_id="0" frame_id="-1" name="美帆" text="『刚才在想事情。』"   voices=""/><char @l="973" id="akina" pos="right" src="akina161"/><msg @l="975" char_id="2" frame_id="-1" name="亚季奈"   text="『哎呀……真是的，姐姐你总是这么迷迷糊糊的！』" voices=""/><char @l="978" id="miho" pos="left" src="miho065"/><msg @l="980" char_id="0" frame_id="-1" name="美帆" text="『太、太过分了……』"   voices=""/><char @l="983" id="miho" pos="left" src="miho066"/><msg @l="985" char_id="0" frame_id="-1" name="美帆" text="『那个……总之要开始指导吗？』"   voices=""/><char @l="988" id="akina" pos="right" src="akina161"/><msg @l="990" char_id="2" frame_id="-1" name="亚季奈"   text="『比起那个，姐姐，我要向大家介绍姐姐你，所以过来这边。』" voices=""/><clear @l="993" layer="akina"/><char @l="995" id="miho" pos="left" src="miho164"/><msg @l="997" char_id="0" frame_id="-1" name="美帆"   text="『不要，别拉我的手啦……喂。』" voices=""/><char @l="1000" id="akina" pos="right" src="akina161"/><msg @l="1002" char_id="2" frame_id="-1" name="亚季奈" text="『快点快点～。』"   voices=""/><clear @l="1005" class="char"/><clear @l="1008" class="all"/><wait_chgmv/><bg @l="1011" src="bg10m1"/><char @l="1013" id="miho" pos="auto" src="miho160"/><msg @l="1015" char_id="0" frame_id="-1" name="美帆"   text="『那、那么……刚才已经被介绍过了，我是仲根美帆。』" voices=""/><char @l="1018" id="miho" pos="auto" src="miho063"/><msg @l="1020" char_id="0" frame_id="-1" name="美帆"   text="『大家，请多指教……』" voices=""/><msg @l="1022" char_id="-1" frame_id="-1" name=""   text="在聚集在泳池边的游泳部的孩子们面前，我简单地做了自我介绍后轻轻鞠了一躬。" voices=""/><msg @l="1023" char_id="-1" frame_id="-1" name=""   text="来参加集训的游泳部的孩子，包括亚季奈在内一共十人。" voices=""/><msg @l="1024" char_id="-1" frame_id="-1" name=""   text="人数不多不少，刚刚好。" voices=""/><msg @l="1026" char_id="-1" frame_id="-1" name="游泳部成员A"   text="『哎～，那就是亚季奈的姐姐啊。』" voices=""/><msg @l="1028" char_id="-1" frame_id="-1" name="游泳部成员B"   text="『和亚季奈不同，看起来很温顺呢。』" voices=""/><msg @l="1030" char_id="-1" frame_id="-1" name="游泳部成员C"   text="『但是但是，她在高中不是保持着记录吗？』" voices=""/><msg @l="1032" char_id="0" frame_id="-1" name="美帆"   text="『那个……已经三年没游泳了……我想可能没法实际下水给大家示范……不过给些建议的话还是可以的。』"   voices=""/><msg @l="1034" char_id="-1" frame_id="-1" name="游泳部成员A" text="『知道啦～。』"   voices=""/><msg @l="1036" char_id="-1" frame_id="-1" name="游泳部成员B"   text="『喂喂，亚季奈～。你姐姐就是你之前说的，生气起来像鬼一样的人吗？』" voices=""/><msg @l="1038" char_id="2" frame_id="-1" name="亚季奈"   text="『对！超～～～～级可怕的哦～。』" voices=""/><char @l="1041" id="miho" pos="auto" src="miho064"/><msg @l="1043" char_id="0" frame_id="-1" name="美帆"   text="『喂！亚季奈！！不要教他们胡说八道啊～！！』" voices=""/><clear @l="1046" class="char"/><char @l="1048" id="miho" pos="left" src="miho164"/><char @l="1050" id="akina" pos="right" src="akina161"/><msg @l="1052" char_id="2" frame_id="-1" name="亚季奈"   text="『诶～，总、之，想要姐姐看看游泳姿势或者呼吸节奏的人，请按顺序告诉姐姐～。』" voices=""/><char @l="1055" id="miho" pos="left" src="miho065"/><msg @l="1057" char_id="0" frame_id="1" name="美帆" text="（唔，被蒙混过去了）"   voices=""/><msg @l="1059" char_id="-1" frame_id="-1" name="游泳部成员们" text="『好～的。』"   voices=""/><msg @l="1061" char_id="-1" frame_id="-1" name=""   text="听了亚季奈的话，所有人异口同声地回答，然后各自散开去练习了。" voices=""/><char @l="1064" id="miho" pos="left" src="miho064"/><msg @l="1066" char_id="0" frame_id="1" name="美帆" text="『哎呀，真是听话呢。』"   voices=""/><char @l="1069" id="akina" pos="right" src="akina061"/><msg @l="1071" char_id="2" frame_id="-1" name="亚季奈"   text="『这也是多亏了优秀部长深藏不露的人缘哦。』" voices=""/><char @l="1074" id="miho" pos="left" src="miho061"/><msg @l="1076" char_id="0" frame_id="1" name="美帆" text="『只是因为亚季奈是高年级学生吧。』"   voices=""/><char @l="1079" id="akina" pos="right" src="akina062"/><msg @l="1081" char_id="2" frame_id="-1" name="亚季奈" text="『切，被发现了啊。』"   voices=""/><msg @l="1083" char_id="0" frame_id="1" name="美帆" text="『一眼就看穿了好吗。』" voices=""/><char @l="1086" id="miho" pos="left" src="miho060"/><msg @l="1088" char_id="0" frame_id="1" name="美帆"   text="『不过……你真的可以做这种事吗？』" voices=""/><msg @l="1090" char_id="0" frame_id="1" name="美帆" text="『亚季奈今年也是要考试的学生啊。』"   voices=""/><char @l="1093" id="akina" pos="right" src="akina060"/><msg @l="1095" char_id="2" frame_id="-1" name="亚季奈"   text="『虽然我本来是打算走体育特长生的升学路线，但可能不会进入大学……』" voices=""/><char @l="1098" id="miho" pos="left" src="miho064"/><msg @l="1100" char_id="0" frame_id="1" name="美帆" text="『诶，那你打算怎么办？』"   voices=""/><char @l="1103" id="akina" pos="right" src="akina061"/><msg @l="1105" char_id="2" frame_id="-1" name="亚季奈"   text="『我在想，要不要去参加职业队的选拔。』" voices=""/><char @l="1108" id="miho" pos="left" src="miho061"/><msg @l="1110" char_id="0" frame_id="1" name="美帆" text="『哇！真厉害啊！』"   voices=""/><char @l="1113" id="akina" pos="right" src="akina161"/><msg @l="1115" char_id="2" frame_id="-1" name="亚季奈"   text="『别夸张了，选拔测试谁都可以参加的。』" voices=""/><char @l="1118" id="miho" pos="left" src="miho060"/><msg @l="1120" char_id="0" frame_id="1" name="美帆"   text="『但是，能够考虑参加职业队选拔，说明你已经有那样的实力了吧？』" voices=""/><char @l="1123" id="akina" pos="right" src="akina060"/><msg @l="1125" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯——，也不是说有明确的把握。』" voices=""/><msg @l="1127" char_id="2" frame_id="-1" name="亚季奈" text="『只是想试一试而已。』"   voices=""/><msg @l="1129" char_id="2" frame_id="-1" name="亚季奈"   text="『我想确认一下……自己是不是真的能靠游泳走下去。』" voices=""/><msg @l="1131" char_id="0" frame_id="1" name="美帆" text="『……这样啊。』" voices=""/><char @l="1134" id="miho" pos="left" src="miho061"/><msg @l="1136" char_id="0" frame_id="1" name="美帆" text="『亚季奈……你真的很努力啊。』"   voices=""/><char @l="1139" id="akina" pos="right" src="akina062"/><msg @l="1141" char_id="2" frame_id="-1" name="亚季奈"   text="『所·以·啊……为了不浪费这份努力，我必须要姐姐好好地给我当教练才行呢。』" voices=""/><msg @l="1143" char_id="0" frame_id="1" name="美帆"   text="『好好。我会好好操练你的，做好心理准备吧。』" voices=""/><char @l="1146" id="akina" pos="right" src="akina161"/><msg @l="1148" char_id="2" frame_id="-1" name="亚季奈" text="『诶嘿嘿，这才对嘛！』"   voices=""/><stopbgm @l="1151" fadeout="1000"/><clear @l="1154" class="all"/><wait_chgmv/><bg @l="1157" src="bg11"/><bgm @l="1160" src="bgm02" volume="1."/><msg @l="1163" char_id="-1" frame_id="-1" name="游泳部成员A" text="『辛苦啦～』"   voices=""/><msg @l="1165" char_id="-1" frame_id="-1" name="游泳部成员B" text="『辛苦了～』"   voices=""/><msg @l="1167" char_id="-1" frame_id="-1" name="游泳部成员C" text="『呜～，肚子好饿～』"   voices=""/><char @l="1170" id="miho" pos="auto" src="miho166"/><msg @l="1172" char_id="0" frame_id="1" name="美帆" text="『……呼。』" voices=""/><msg @l="1174" char_id="-1" frame_id="-1" name=""   text="墙上的挂钟刚过七点的时候，因为大学方面的游泳社团全员要回去的缘故，来参加集训的亚季奈他们也结束了练习。"   voices=""/><msg @l="1175" char_id="-1" frame_id="-1" name=""   text="由于亚季奈的指导老师不在场，无法管理钥匙，这是原因所在。" voices=""/><clear @l="1178" class="char"/><char @l="1180" id="miho" pos="left" src="miho166"/><char @l="1182" id="akina" pos="right" src="akina161"/><bgm @l="1185" src="bgm06" volume="1."/><msg @l="1187" char_id="2" frame_id="-1" name="亚季奈" text="『姐姐，辛苦啦～』"   voices=""/><char @l="1190" id="miho" pos="left" src="miho061"/><msg @l="1192" char_id="0" frame_id="1" name="美帆" text="『辛苦啦～』"   voices=""/><msg @l="1194" char_id="-1" frame_id="-1" name=""   text="亚季奈一边用手巾粗暴地胡乱擦拭着头发，一边穿着泳装走进了更衣室。" voices=""/><msg @l="1195" char_id="-1" frame_id="-1" name="" text="她大概是刚刚洗过淋浴吧。"   voices=""/><char @l="1198" id="akina" pos="right" src="akina061"/><msg @l="1200" char_id="2" frame_id="-1" name="亚季奈"   text="『这里的热水出得挺好的呢。』" voices=""/><char @l="1203" id="akina" pos="right" src="akina067"/><msg @l="1205" char_id="2" frame_id="-1" name="亚季奈"   text="『我们学校的淋浴间，时不时就只出冷水，可麻烦了。』" voices=""/><char @l="1208" id="miho" pos="left" src="miho060"/><msg @l="1210" char_id="0" frame_id="1" name="美帆" text="『我也是第一次用这里的淋浴间。』"   voices=""/><char @l="1213" id="miho" pos="left" src="miho161"/><msg @l="1215" char_id="0" frame_id="1" name="美帆"   text="『又宽敞，又有独立的隔间，真不错。』" voices=""/><char @l="1218" id="akina" pos="right" src="akina162"/><msg @l="1220" char_id="2" frame_id="-1" name="亚季奈"   text="『我反正没有什么被看到会困扰的地方，所以怎样都无所谓啦～』" voices=""/><char @l="1223" id="miho" pos="left" src="miho066"/><msg @l="1225" char_id="0" frame_id="1" name="美帆" text="『你、你什么意思……那眼神是……』"   voices=""/><char @l="1228" id="akina" pos="right" src="akina062"/><msg @l="1230" char_id="2" frame_id="-1" name="亚季奈"   text="『不不～，我只是在想，我是不是以后也会像姐姐那样变得软乎乎的呢～。』" voices=""/><char @l="1233" id="miho" pos="left" src="miho164"/><msg @l="1235" char_id="0" frame_id="1" name="美帆" text="『你、你在说什么啊，真是的。』"   voices=""/><char @l="1238" id="akina" pos="right" src="akina162"/><msg @l="1240" char_id="2" frame_id="-1" name="亚季奈" text="『这是事实嘛～。』"   voices=""/><char @l="1243" id="miho" pos="left" src="miho066"/><msg @l="1245" char_id="0" frame_id="1" name="美帆" text="『亚季奈！』" voices=""/><msg @l="1247" char_id="2" frame_id="-1" name="亚季奈" text="『诶嘿嘿～。』" voices=""/><clear @l="1250" class="all"/><label @l="1253" id="chart_line10"/><wait_chgmv/><ev @l="1256" src="ev-057"/><msg @l="1258" char_id="0" frame_id="1" name="美帆"   text="『不过，真的很遗憾呢……泳池只能在游泳社团活动时间使用。』" voices="miho03350"/><msg @l="1260" char_id="0" frame_id="1" name="美帆"   text="『这样的话，来合宿就没什么意义了吧。』" voices="miho03360"/><msg @l="1262" char_id="2" frame_id="-1" name="亚季奈"   text="『没办法啊，钥匙好像只有指导老师才能借出来。』" voices="akina00050"/><msg @l="1264" char_id="2" frame_id="-1" name="亚季奈"   text="『而且，第一天大家都挺紧张的，我觉得这样刚刚好吧？』" voices="akina00060"/><msg @l="1266" char_id="0" frame_id="1" name="美帆" text="『这倒也是。』"   voices="miho03370"/><msg @l="1268" char_id="0" frame_id="1" name="美帆"   text="『真是的……他们把大家的努力当成什么了啊。』" voices="miho03380"/><msg @l="1270" char_id="2" frame_id="-1" name="亚季奈" text="『哦，难得见你这么激动啊？』"   voices="akina00070"/><msg @l="1272" char_id="0" frame_id="1" name="美帆" text="『别取笑我了，真是的。』"   voices="miho03390"/><msg @l="1274" char_id="2" frame_id="-1" name="亚季奈"   text="『啊哈哈……话说回来，我肚子饿了～。』" voices="akina00080"/><msg @l="1276" char_id="2" frame_id="-1" name="亚季奈"   text="『今天晚饭该吃什么好呢。』" voices="akina00090"/><msg @l="1278" char_id="0" frame_id="1" name="美帆"   text="『肚子饿了就去吃啊，有什么问题？』" voices="miho03400"/><msg @l="1280" char_id="2" frame_id="-1" name="亚季奈"   text="『不是这个意思……我是在想晚饭要吃什么好。』" voices="akina00100"/><msg @l="1282" char_id="2" frame_id="-1" name="亚季奈"   text="『因为我们的饭得自己准备。』" voices="akina00110"/><msg @l="1284" char_id="0" frame_id="1" name="美帆"   text="『与其说是合宿，倒更像是野营呢……这种情况。』" voices="miho03410"/><msg @l="1286" char_id="2" frame_id="-1" name="亚季奈" text="『嘛，差不多是一回事吧。』"   voices="akina00120"/><msg @l="1288" char_id="2" frame_id="-1" name="亚季奈"   text="『听说宿舍那边已经接通了煤气和电，看来不用太狼狈过日子了。』"   voices="akina00130"/><msg @l="1290" char_id="0" frame_id="1" name="美帆" text="『嗯——那要不要来我这里吃？』"   voices="miho03420"/><msg @l="1292" char_id="0" frame_id="1" name="美帆"   text="『虽然我室友学姐也在，但我想她应该会同意的。』" voices="miho03430"/><msg @l="1294" char_id="2" frame_id="-1" name="亚季奈"   text="『抱歉，大家应该都会在宿舍吃，只有我一个人这样做总觉得有点不好意思。』" voices="akina00140"/><msg @l="1296" char_id="0" frame_id="1" name="美帆" text="『是吗……嗯，也是呢。』"   voices="miho03440"/><msg @l="1298" char_id="2" frame_id="-1" name="亚季奈"   text="『谢谢你邀请我，姐姐。』" voices="akina00150"/><msg @l="1300" char_id="0" frame_id="1" name="美帆" text="『要加油哦。』"   voices="miho03450"/><msg @l="1302" char_id="2" frame_id="-1" name="亚季奈" text="『嗯！』"   voices="akina00160"/><stopbgm @l="1305" fadeout="1000"/><clear @l="1308" class="all"/><wait_chgmv/><bg @l="1311" src="bg07b"/><char @l="1313" id="miho" pos="left" src="miho010"/><char @l="1316" id="akina" pos="right" src="akina010"/><bgm @l="1319" src="bgm05" volume="1."/><msg @l="1321" char_id="-1" frame_id="-1" name=""   text="我们来到了电车站和亚季奈他们宿舍所在方向的岔路口。" voices=""/><msg @l="1322" char_id="-1" frame_id="-1" name=""   text="据亚季奈说，宿舍是在穿过大学后院到达的停车场旁边的建筑物。" voices=""/><msg @l="1324" char_id="0" frame_id="1" name="美帆" text="『那么，我就走这边了。』"   voices=""/><char @l="1327" id="akina" pos="right" src="akina011"/><msg @l="1329" char_id="2" frame_id="-1" name="亚季奈" text="『嗯。明天也请多关照。』"   voices=""/><msg @l="1331" char_id="0" frame_id="1" name="美帆"   text="『顾问老师来了的话，记得跟他提一下我的事。』" voices=""/><char @l="1334" id="akina" pos="right" src="akina010"/><msg @l="1336" char_id="2" frame_id="-1" name="亚季奈"   text="『没关系啦，我已经跟顾问老师好好谈过了。』" voices=""/><char @l="1339" id="akina" pos="right" src="akina012"/><msg @l="1341" char_id="2" frame_id="-1" name="亚季奈"   text="『老师说非常欢迎姐姐你哦？』" voices=""/><char @l="1344" id="miho" pos="left" src="miho016"/><msg @l="1346" char_id="0" frame_id="1" name="美帆" text="『那样就好……』"   voices=""/><char @l="1349" id="akina" pos="right" src="akina111"/><msg @l="1351" char_id="2" frame_id="-1" name="亚季奈" text="『姐姐真是太爱担心了。』"   voices=""/><char @l="1354" id="akina" pos="right" src="akina010"/><msg @l="1356" char_id="2" frame_id="-1" name="亚季奈"   text="『不活得轻松一点会累坏的哦？』" voices=""/><msg @l="1358" char_id="0" frame_id="1" name="美帆" text="『是亚季奈太随性了……』"   voices=""/><msg @l="1360" char_id="-1" frame_id="-1" name="游泳部成员A"   text="『亚季奈，快点过来啊～』" voices=""/><msg @l="1362" char_id="-1" frame_id="-1" name="游泳部成员B"   text="『再不快点的话就不给你吃饭了哦～』" voices=""/><msg @l="1364" char_id="-1" frame_id="-1" name=""   text="道路前方，游泳部的同学们在挥手。" voices=""/><msg @l="1365" char_id="-1" frame_id="-1" name=""   text="应该是亚季奈的朋友吧……看来是在等她过去。" voices=""/><char @l="1368" id="akina" pos="right" src="akina114"/><msg @l="1370" char_id="2" frame_id="-1" name="亚季奈"   text="『哇，她们说了些好过分的话！』" voices=""/><char @l="1373" id="miho" pos="left" src="miho011"/><msg @l="1375" char_id="0" frame_id="1" name="美帆" text="『快去吧，别让她们等。』"   voices=""/><char @l="1378" id="akina" pos="right" src="akina011"/><msg @l="1380" char_id="2" frame_id="-1" name="亚季奈"   text="『啊，嗯！那就再见啦！』" voices=""/><clear @l="1383" class="char"/><char @l="1385" id="miho" pos="auto" src="miho010"/><msg @l="1387" char_id="-1" frame_id="-1" name=""   text="亚季奈慌忙地跑向游泳部的同学们。" voices=""/><msg @l="1388" char_id="-1" frame_id="-1" name=""   text="明明刚游完那么多泳，居然还能跑得动，真让人惊讶。" voices=""/><msg @l="1390" char_id="2" frame_id="-1" name="亚季奈" text="『抱歉～让你们久等了～』"   voices=""/><msg @l="1392" char_id="-1" frame_id="-1" name="游泳部成员C" text="『亚季奈……你真精神啊。』"   voices=""/><msg @l="1394" char_id="2" frame_id="-1" name="亚季奈"   text="『不过，我饿得咕咕叫，快要倒下了……』" voices=""/><msg @l="1396" char_id="-1" frame_id="-1" name="游泳部成员B" text="『啊，我也是～』"   voices=""/><char @l="1399" id="miho" pos="auto" src="miho011"/><msg @l="1401" char_id="0" frame_id="1" name="美帆" text="『……。』" voices=""/><msg @l="1403" char_id="0" frame_id="1" name="美帆" text="(呵呵··看起来挺有趣的嘛)"   voices=""/><se @l="1406" buf="1" src="腹の音" volume="1."/><char @l="1409" id="miho" pos="auto" src="miho016"/><msg @l="1411" char_id="0" frame_id="1" name="美帆" text="『……哇啊。』" voices=""/><char @l="1414" id="miho" pos="auto" src="miho011"/><msg @l="1416" char_id="0" frame_id="1" name="美帆" text="『我也……赶紧回家吃饭去吧。』"   voices=""/><stopbgm @l="1419" fadeout="1000"/><clear @l="1422" class="all"/><call @l="1425" target="EventLabel_60@root_akina02"/><return @l="1426" value="0&#13;&#10;"/><return @l="1429" value=""/></code></xscript>																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																								