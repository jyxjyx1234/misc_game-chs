<?xml version="1.0" encoding="utf-8"?><xscript><debug editor="&quot;C:\Program&#32;Files&#32;(x86)\sakura\sakura.exe&quot;&#32;&quot;%src%&quot;&#32;-Y=%line%"   src="D:\シロップ\町ぐるみの罠＋汚された夏セット版\汚された夏\完成データ\汚された夏\script\text\root_akina05.txt"/><code><label @l="14" id="EventLabel_80"/><description @l="18" text="游泳教练·第5天"/><eval @l="20" expr="f.numDay=12&#13;&#10;"/><msgshow @l="22" show="false"/><wait_chgmv/><bg @l="24" src="day12" time="2000"/><wait @l="26" time="500"/><wait_chgmv/><bg @l="28" src="black" time="2000"/><msgshow @l="30" show="true"/><goto @l="34" cond="!(f.留学生に抵抗したflag&#32;!=&#32;0)&#13;&#10;"   label="TempLabel_232"/><goto @l="36" label="EventLabel_81"/><label @l="37" id="TempLabel_232"/><wait_chgmv/><bg @l="41" src="bg03"/><bgm @l="45" src="bgm03" volume="1."/><char @l="49" id="miho" pos="auto" src="miho114"/><msg @l="51" char_id="0" frame_id="-1" name="美帆" text="『现在就……要去吗？』"   voices=""/><msg @l="53" char_id="-1" frame_id="-1" name="" text="大清早，大学打来了电话。"   voices=""/><msg @l="54" char_id="-1" frame_id="-1" name="" text="对方是渡部老师……是那个人。"   voices=""/><msg @l="56" char_id="-1" frame_id="-1" name="渡部" text="『没错。越早越好。』"   voices=""/><msg @l="58" char_id="0" frame_id="-1" name="美帆" text="『为什么是我……。』"   voices=""/><msg @l="60" char_id="-1" frame_id="-1" name="渡部"   text="『我可是为了你才特地打电话来的。』" voices=""/><char @l="64" id="miho" pos="auto" src="miho015"/><msg @l="66" char_id="0" frame_id="-1" name="美帆" text="『这是什么……意思？』"   voices=""/><msg @l="68" char_id="-1" frame_id="-1" name="渡部" text="『来了就知道了。』" voices=""/><char @l="72" id="miho" pos="auto" src="miho115"/><msg @l="74" char_id="0" frame_id="-1" name="美帆"   text="『光这样我不明白。而且还有课……。』" voices=""/><msg @l="76" char_id="-1" frame_id="-1" name="渡部"   text="『我认为……应当珍惜妹妹。』" voices=""/><msg @l="78" char_id="0" frame_id="-1" name="美帆" text="『啊……！？』" voices=""/><msg @l="80" char_id="0" frame_id="-1" name="美帆" text="『妹妹，亚季奈怎么了！？』"   voices=""/><se @l="84" buf="1" src="通話が切れた後の音" volume="1."/><msg @l="86" char_id="0" frame_id="-1" name="美帆" text="『啊……。』" voices=""/><msg @l="88" char_id="-1" frame_id="-1" name="" text="电话被对方单方面挂断了。"   voices=""/><msg @l="89" char_id="-1" frame_id="-1" name="" text="亚季奈……到底怎么了？"   voices=""/><stopse @l="92" buf="1"/><clear @l="95" class="char"/><char @l="97" id="miho" pos="left" src="miho015"/><char @l="100" id="rei" pos="right" src="rei030"/><msg @l="102" char_id="1" frame_id="-1" name="玲" text="『什么……电话？』" voices=""/><msg @l="104" char_id="-1" frame_id="-1" name="" text="大概是我的声音吵醒了她。"   voices=""/><msg @l="105" char_id="-1" frame_id="-1" name=""   text="玲小姐一边揉着眼睛一边从房间里走出来。" voices=""/><msg @l="107" char_id="0" frame_id="-1" name="美帆"   text="『对不起……我马上就出门。』" voices=""/><char @l="111" id="rei" pos="right" src="rei034"/><msg @l="113" char_id="1" frame_id="-1" name="玲" text="『诶，啊……等等！？』"   voices=""/><clear @l="117" layer="miho"/><msg @l="119" char_id="1" frame_id="-1" name="玲" text="『………。』" voices=""/><char @l="123" id="rei" pos="right" src="rei030"/><msg @l="125" char_id="1" frame_id="-1" name="玲" text="『……怎么回事？』" voices=""/><clear @l="131" class="all"/><wait_chgmv/><bg @l="135" src="bg07"/><char @l="139" id="miho" pos="auto" src="miho115"/><msg @l="141" char_id="0" frame_id="-1" name="美帆" text="『哈，哈……。』"   voices=""/><msg @l="143" char_id="-1" frame_id="-1" name=""   text="在清晨……或者说有点接近上午的时候，我终于到达了校园。" voices=""/><msg @l="144" char_id="-1" frame_id="-1" name=""   text="只是从车站一路跑到这里，就已经上气不接下气了。" voices=""/><msg @l="146" char_id="0" frame_id="-1" name="美帆" text="(亚季奈……)" voices=""/><clear @l="152" class="all"/><wait_chgmv/><bg @l="156" src="bg09"/><char @l="160" id="miho" pos="auto" src="miho115"/><msg @l="162" char_id="0" frame_id="-1" name="美帆" text="『游泳池……竟然这么远。』"   voices=""/><msg @l="164" char_id="-1" frame_id="-1" name=""   text="平时并没有特别注意，这所大学其实挺大的。" voices=""/><msg @l="165" char_id="-1" frame_id="-1" name=""   text="直到昨天，我都没想到从一栋教学楼到另一栋会这么费劲。" voices=""/><msg @l="167" char_id="0" frame_id="-1" name="美帆"   text="(为什么我、这么着急呢……)" voices=""/><msg @l="169" char_id="-1" frame_id="-1" name=""   text="是因为渡部老师说最好尽早来吗。" voices=""/><msg @l="170" char_id="-1" frame_id="-1" name="" text="不……不是这样。"   voices=""/><msg @l="171" char_id="-1" frame_id="-1" name="" text="我心里有种不安。" voices=""/><msg @l="172" char_id="-1" frame_id="-1" name=""   text="快点，快点……好像有什么在催促着我。" voices=""/><msg @l="173" char_id="-1" frame_id="-1" name="" text="有什么……。" voices=""/><msg @l="175" char_id="0" frame_id="-1" name="美帆"   text="(亚季奈……没事吧，安全吧……！？)" voices=""/><clear @l="181" class="all"/><wait_chgmv/><bg @l="185" src="bg10"/><char @l="189" id="miho" pos="auto" src="miho115"/><msg @l="191" char_id="0" frame_id="-1" name="美帆" text="『哈……哈……哈……。』"   voices=""/><msg @l="193" char_id="0" frame_id="-1" name="美帆" text="『啊，亚季奈……亚季奈……！？』"   voices=""/><stopbgm @l="197" fadeout="1000"/><msg @l="199" char_id="-1" frame_id="-1" name="" text="这里一个人都没有。" voices=""/><msg @l="200" char_id="-1" frame_id="-1" name="" text="渡部老师明明说要来游泳池的。"   voices=""/><msg @l="201" char_id="-1" frame_id="-1" name="" text="难道，我被骗了……？"   voices=""/><msg @l="202" char_id="-1" frame_id="-1" name="" text="就算是骗我，又是为了什么？"   voices=""/><msg @l="205" char_id="0" frame_id="-1" name="美帆"   text="『为什么这里一个人都没有……为什么………。』" voices=""/><msg @l="207" char_id="2" frame_id="-1" name="声音" text="『……啊……呜啊………。』"   voices="akina00760"/><msg @l="209" char_id="0" frame_id="-1" name="美帆" text="『亚季奈！？』"   voices="miho04410"/><clear @l="216" class="all"/><label @l="219" id="event_scene48"/><msg @l="221" char_id="-1" frame_id="-1" name=""   text="凭借着微弱传来的声音，我冲向了泳池边。" voices=""/><msg @l="222" char_id="-1" frame_id="-1" name="" text="声音……是从女更衣室那边传来的。"   voices=""/><msg @l="224" char_id="0" frame_id="-1" name="美帆" text="『亚季奈！！』"   voices="miho04420"/><label @l="228" id="chart_line22"/><wait_chgmv/><ev @l="232" src="ev-048"/><description @l="235" text="幼小的祭品"/><bgm @l="239" src="bgm13" volume="1."/><msg @l="242" char_id="-1" frame_id="-1" name="渡部" text="『哟……来晚了啊，仲根。』"   voices=""/><msg @l="244" char_id="-1" frame_id="-1" name="渡部"   text="『抱歉，我已经先开始了。』" voices=""/><msg @l="246" char_id="0" frame_id="-1" name="美帆" text="『亚…季…奈……』"   voices="miho04430"/><msg @l="248" char_id="-1" frame_id="-1" name=""   text="冲进更衣室后，惨剧立刻映入我的视野。" voices=""/><msg @l="249" char_id="-1" frame_id="-1" name=""   text="穿着泳装的亚季奈在渡部老师身上摇晃着……" voices=""/><msg @l="251" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯，嗯嗯……呀……姐姐，不要看……』" voices="akina00770"/><msg @l="253" char_id="-1" frame_id="-1" name="" text="亚季奈在渡部老师身上偏过脸去。"   voices=""/><msg @l="254" char_id="-1" frame_id="-1" name="" text="这是……怎么回事？"   voices=""/><msg @l="255" char_id="-1" frame_id="-1" name="" text="她是被强奸了吗？" voices=""/><msg @l="256" char_id="-1" frame_id="-1" name="" text="为什么亚季奈没有反抗？"   voices=""/><msg @l="257" char_id="-1" frame_id="-1" name="" text="她是不是害怕渡部老师的暴力？"   voices=""/><msg @l="258" char_id="-1" frame_id="-1" name="" text="还是说……" voices=""/><msg @l="260" char_id="-1" frame_id="-1" name="渡部" text="『嗯？别误会了。』"   voices=""/><msg @l="262" char_id="-1" frame_id="-1" name="渡部"   text="『我和亚季奈是在双方同意的情况下做爱的。也就是说，这不是强奸，而是合奸。』" voices=""/><msg @l="264" char_id="0" frame_id="-1" name="美帆" text="『怎么会……亚季奈，为什么！？』"   voices="miho04440"/><msg @l="266" char_id="2" frame_id="-1" name="亚季奈"   text="『我……喜欢老师嘛。』" voices="akina00780"/><msg @l="268" char_id="2" frame_id="-1" name="亚季奈"   text="『明明是这样，姐姐却说不行……所以才……』" voices="akina00790"/><msg @l="270" char_id="0" frame_id="-1" name="美帆" text="『就算是这样也不能做这种事……』"   voices="miho04450"/><msg @l="272" char_id="2" frame_id="-1" name="亚季奈"   text="『我已经不是小孩子了，这种程度……我没关系的！』" voices="akina00800"/><msg @l="274" char_id="-1" frame_id="-1" name=""   text="说着，亚季奈自己扭动腰肢，吞入渡部老师的肉棒。" voices=""/><msg @l="276" char_id="-1" frame_id="-1" name="渡部"   text="『哦，哦，哦哦……真棒，小穴夹得更紧了，感觉真不错。』" voices=""/><msg @l="278" char_id="0" frame_id="-1" name="美帆" text="『怎么会这样……』"   voices="miho04460"/><msg @l="280" char_id="-1" frame_id="-1" name="渡部"   text="『看，让姐姐好好看看你高潮的样子。』" voices=""/><msg @l="282" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯嗯……啊，啊啊……不行……里面，不行……太窄了！』" voices="akina00810"/><msg @l="284" char_id="-1" frame_id="-1" name=""   text="渡部老师从笨拙摆动腰肢的亚季奈下方猛烈地向上顶。" voices=""/><msg @l="285" char_id="-1" frame_id="-1" name=""   text="亚季奈娇小的身体每次被顶起时，都大幅地弹跳起来。" voices=""/><msg @l="287" char_id="0" frame_id="-1" name="美帆" text="『啊，啊啊……啊……』"   voices="miho04470"/><msg @l="289" char_id="-1" frame_id="-1" name=""   text="我……连眨眼都做不到，只是呆呆地看着亚季奈淫乱的样子。" voices=""/><msg @l="290" char_id="-1" frame_id="-1" name=""   text="即使想说些什么，喉咙深处也只能漏出干涩的喘息。" voices=""/><msg @l="291" char_id="-1" frame_id="-1" name="" text="我感觉……失去了重要的东西。"   voices=""/><msg @l="293" char_id="-1" frame_id="-1" name="渡部"   text="『看，这里很舒服吧……我会好好顶上去的。』" voices=""/><msg @l="295" char_id="2" frame_id="-1" name="亚季奈"   text="『呜啊……不行，那里……老师……呜啊啊啊！！』" voices="akina00820"/><msg @l="297" char_id="2" frame_id="-1" name="亚季奈"   text="『一直弄那里的话……我，我……嗯嗯！！』" voices="akina00830"/><msg @l="299" char_id="-1" frame_id="-1" name="渡部"   text="『还不能高潮哦……好好忍耐，让姐姐看到你盛大高潮的样子，不是吗？』" voices=""/><msg @l="301" char_id="2" frame_id="-1" name="亚季奈"   text="『可是……嗯嗯，可是……嗯，嗯嗯……。』" voices="akina00840"/><msg @l="303" char_id="2" frame_id="-1" name="亚季奈"   text="『啊，啊，啊，啊，啊啊……不行了……我忍不住了！』" voices="akina00850"/><msg @l="305" char_id="-1" frame_id="-1" name="渡部"   text="『果然……这东西的效果真是厉害啊。』" voices=""/><msg @l="307" char_id="-1" frame_id="-1" name=""   text="渡部老师看着躺在自己身边的东西，暗自窃笑。" voices=""/><msg @l="309" char_id="-1" frame_id="-1" name="" text="顺着他的视线看去，那里有一个空注射器。"   voices=""/><msg @l="311" char_id="0" frame_id="-1" name="美帆" text="『那是……注射器……？』"   voices="miho04480"/><msg @l="313" char_id="0" frame_id="-1" name="美帆"   text="『你……你对亚季奈做了什么！？』" voices="miho04490"/><msg @l="315" char_id="-1" frame_id="-1" name="渡部"   text="『给她注射了特制的性感增强剂。』" voices=""/><msg @l="317" char_id="-1" frame_id="-1" name="渡部"   text="『效果如何……你看到的就是结果。』" voices=""/><msg @l="319" char_id="0" frame_id="-1" name="美帆" text="『怎么会……』"   voices="miho04500"/><msg @l="321" char_id="-1" frame_id="-1" name="渡部"   text="『毕竟，要在一晚上就把昨天还是处女的女人调教到这种程度，不借助药物的力量是做不到的。』" voices=""/><msg @l="323" char_id="2" frame_id="-1" name="亚季奈"   text="『啊啊……不行，不行……要去了……』" voices="akina00860"/><msg @l="325" char_id="-1" frame_id="-1" name="" text="她大概已经看不到我了吧……"   voices=""/><msg @l="326" char_id="-1" frame_id="-1" name=""   text="亚季奈在渡部老师身上淫荡地扭动着腰肢，甜腻地呻吟着。" voices=""/><msg @l="328" char_id="-1" frame_id="-1" name="渡部"   text="『哦，不错……就这样紧紧地夹住。』" voices=""/><msg @l="330" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯啊……啊，啊，啊啊………好舒服………』" voices="akina00870"/><msg @l="332" char_id="2" frame_id="-1" name="亚季奈"   text="『啊啊……不行了……已经，忍不住了啊……』" voices="akina00880"/><msg @l="334" char_id="-1" frame_id="-1" name="渡部"   text="『没办法啊……现在，就让你高潮吧。』" voices=""/><msg @l="336" char_id="-1" frame_id="-1" name=""   text="说着，渡部老师紧紧抓住亚季奈的腰，开始猛烈地向上顶弄。" voices=""/><msg @l="337" char_id="-1" frame_id="-1" name=""   text="亚季奈小小的性器被渡部老师的那个大大地扩张着。" voices=""/><msg @l="338" char_id="-1" frame_id="-1" name=""   text="从结合处的缝隙中，大量的爱液和白色精液混合成的泡沫溢了出来。" voices=""/><msg @l="340" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯，嗯，嗯，嗯，嗯……嗯嗯！！』" voices="akina00890"/><msg @l="342" char_id="2" frame_id="-1" name="亚季奈"   text="『好……好啊……来啊……再深一点进来啊！！』" voices="akina00900"/><msg @l="344" char_id="-1" frame_id="-1" name="渡部"   text="『我要射了……射在最深处！！』" voices=""/><msg @l="346" char_id="0" frame_id="-1" name="美帆"   text="『诶，射进去……怎么会……』" voices="miho04510"/><msg @l="348" char_id="-1" frame_id="-1" name=""   text="听到这可怕的话语，我慌忙想要上前阻止，但听到亚季奈接下来说的话后却呆住了。" voices=""/><msg @l="350" char_id="2" frame_id="-1" name="亚季奈"   text="『啊呜，深处，射在深处……嗯嗯…………要来了，要来了！！』" voices="akina00910"/><msg @l="352" char_id="-1" frame_id="-1" name="渡部"   text="『没错……去吧！ 被我贯穿的同时，让你亲姐姐看着你大声高潮的样子！』" voices=""/><msg @l="354" char_id="2" frame_id="-1" name="亚季奈"   text="『去了……去了…………啊，嗯嗯…………呜啊啊啊！！』" voices="akina00920"/><flash @l="357" count="4" fade="100" image="white"/><wait_chgmv/><ev @l="360" src="ev-048x1z1"/><msg @l="362" char_id="2" frame_id="-1" name="亚季奈" text="『嗯嗯嗯！！！』"   voices="akina00930"/><msg @l="364" char_id="-1" frame_id="-1" name="" text="亚季奈攀上高潮的顶峰的下一瞬间。"   voices=""/><msg @l="365" char_id="-1" frame_id="-1" name=""   text="渡部老师发出低沉的声音，紧贴着她的腰。" voices=""/><msg @l="366" char_id="-1" frame_id="-1" name=""   text="腰部抽搐之后，从两人的结合处，没能完全留在阴道内的白浊精液缓缓溢了出来。" voices=""/><stopbgm @l="370" fadeout="1000"/><clear @l="374" class="ev"/><end_scene @l="377"/><wait_chgmv/><bg @l="381" src="bg11"/><bgm @l="385" src="bgm10" volume="1."/><char @l="389" id="miho" pos="auto" src="miho015"/><msg @l="391" char_id="0" frame_id="-1" name="美帆"   text="『亚季奈……对不起，对不起………。』" voices=""/><msg @l="393" char_id="-1" frame_id="-1" name=""   text="对着高潮中颤抖不已的亚季奈……我轻声低语。" voices=""/><msg @l="394" char_id="-1" frame_id="-1" name=""   text="即使这些话语或许已经传不到亚季奈心里了……。" voices=""/><msg @l="395" char_id="-1" frame_id="-1" name=""   text="即使这是无法挽回的事情……" voices=""/><clear @l="398" class="char"/><char @l="400" id="miho" pos="left" src="miho015"/><char @l="403" id="watab" pos="right" src="watabe010"/><msg @l="405" char_id="-1" frame_id="-1" name="渡部"   text="『好了，前菜就到此为止吧。』" voices=""/><char @l="408" id="watab" pos="right" src="watabe012"/><msg @l="410" char_id="-1" frame_id="-1" name="渡部"   text="『是时候享用主菜了。』" voices=""/><msg @l="412" char_id="-1" frame_id="-1" name="" text="渡部老师向我慢慢靠近。"   voices=""/><char @l="416" id="miho" pos="left" src="miho015"/><msg @l="418" char_id="0" frame_id="-1" name="美帆" text="『诶……你、你要干什么？』"   voices=""/><char @l="421" id="watab" pos="right" src="watabe014"/><msg @l="423" char_id="-1" frame_id="-1" name="渡部"   text="『现在装傻已经太迟了。』" voices=""/><msg @l="425" char_id="-1" frame_id="-1" name="渡部"   text="『做到这一步了，你以为只有你能逃掉吗？』" voices=""/><msg @l="427" char_id="0" frame_id="-1" name="美帆"   text="『但你和亚季奈……既然是双方同意的话……难道你们不是恋人关系吗？』" voices=""/><char @l="430" id="watab" pos="right" src="watabe017"/><msg @l="432" char_id="-1" frame_id="-1" name="渡部"   text="『你是傻子吗。那种小丫头谁会满足啊。』" voices=""/><msg @l="434" char_id="-1" frame_id="-1" name="渡部"   text="『而且就因为双方同意做爱就是恋人了？别逗我笑了。』" voices=""/><char @l="438" id="miho" pos="left" src="miho015"/><msg @l="440" char_id="0" frame_id="-1" name="美帆"   text="『怎么会……你把女孩子当成什么了！？』" voices=""/><char @l="443" id="watab" pos="right" src="watabe017"/><msg @l="445" char_id="-1" frame_id="-1" name="渡部"   text="『唠唠叨叨烦死了！那种事情无所谓，先把这个穿上。』" voices=""/><msg @l="447" char_id="-1" frame_id="-1" name=""   text="渡部老师说着，把我的泳衣扔给了我。" voices=""/><char @l="450" id="miho" pos="left" src="miho115"/><msg @l="452" char_id="0" frame_id="-1" name="美帆" text="『这、这是什么意思！？』"   voices=""/><msg @l="456" char_id="-1" frame_id="-1" name="渡部"   text="『你这家伙真是问题多。你没有选择权。不快点穿上的话，你亲爱的妹妹就要遭殃了。』" voices=""/><char @l="459" id="miho" pos="left" src="miho015"/><msg @l="461" char_id="0" frame_id="-1" name="美帆"   text="『你、你还想做什么！？』" voices=""/><char @l="464" id="watab" pos="right" src="watabe012"/><msg @l="466" char_id="-1" frame_id="-1" name="渡部"   text="『让我想想啊，如果你不听话，我就给亚季奈灌药，把她卖到某个国家去。』" voices=""/><msg @l="468" char_id="0" frame_id="-1" name="美帆" text="『这、这种事………』"   voices=""/><char @l="471" id="watab" pos="right" src="watabe017"/><msg @l="473" char_id="-1" frame_id="-1" name="渡部"   text="『如果不想那样，就赶快把那个穿上！』" voices=""/><char @l="476" id="miho" pos="left" src="miho115"/><msg @l="478" char_id="0" frame_id="-1" name="美帆" text="『………呜…………。』"   voices=""/><char @l="481" id="watab" pos="right" src="watabe010"/><msg @l="483" char_id="-1" frame_id="-1" name="渡部"   text="『啊，想逃跑也是徒劳的哦。要是那样做的话，我会立刻抓住你们姐妹俩，给你们灌药，然后一起卖掉哦。』" voices=""/><msg @l="485" char_id="0" frame_id="-1" name="美帆" text="『…………。』"   voices=""/><char @l="488" id="watab" pos="right" src="watabe017"/><msg @l="490" char_id="-1" frame_id="-1" name="渡部" text="『你怎么选择！嗯！？』"   voices=""/><char @l="493" id="miho" pos="left" src="miho015"/><msg @l="495" char_id="0" frame_id="-1" name="美帆" text="『我…我知道了。』"   voices=""/><char @l="498" id="watab" pos="right" src="watabe012"/><msg @l="500" char_id="-1" frame_id="-1" name="渡部"   text="『一开始就这么听话不就好了嘛。』" voices=""/><msg @l="502" char_id="-1" frame_id="-1" name="" text="渡部老师听到我的话后高兴地笑了。"   voices=""/><msg @l="503" char_id="-1" frame_id="-1" name=""   text="我想着暂且假装服从渡部老师的命令，寻找逃跑的机会。" voices=""/><msg @l="504" char_id="-1" frame_id="-1" name=""   text="相信只要从这里逃出去叫人来，就能救出亚季奈。" voices=""/><clear @l="507" class="char"/><clear @l="513" class="all"/><msgshow @l="515" show="true"/><wait_chgmv/><bg @l="517" src="bg11"/><char @l="520" id="miho" pos="left" src="miho165"/><char @l="522" id="watab" pos="right" src="watabe012"/><msg @l="524" char_id="0" frame_id="-1" name="美帆" text="『我…我换好了。』"   voices=""/><msg @l="526" char_id="-1" frame_id="-1" name=""   text="我被迫在渡部老师面前换衣服。" voices=""/><msg @l="527" char_id="-1" frame_id="-1" name=""   text="尽管如此，我还是换好了衣服，脸涨得通红，含着泪水告诉他换好了。" voices=""/><msg @l="529" char_id="-1" frame_id="-1" name="渡部"   text="嘿嘿，果然不愧是我盯上的，身材真不错啊。" voices=""/><msg @l="531" char_id="-1" frame_id="-1" name="渡部"   text="『看看这个。我这家伙已经这么硬了。』" voices=""/><msg @l="533" char_id="-1" frame_id="-1" name=""   text="说着渡部老师拉下裤子，指着已经恢复硬度的那话儿。" voices=""/><char @l="536" id="miho" pos="left" src="miho065"/><msg @l="538" char_id="0" frame_id="-1" name="美帆" text="『呜……。』" voices=""/><clear @l="542" layer="miho"/><msg @l="544" char_id="-1" frame_id="-1" name=""   text="他拉下裤子的此刻正是机会。那副模样应该追不上来……这么想着的我，转身跑向门口。" voices=""/><msg @l="545" char_id="-1" frame_id="-1" name=""   text="我离门口更近，按理说应该能逃出去的。" voices=""/><msg @l="546" char_id="-1" frame_id="-1" name="" text="……我是这么以为的。" voices=""/><msg @l="548" char_id="-1" frame_id="-1" name="管理员"   text="『很抱歉，不能让你逃走啊。』" voices=""/><char @l="551" id="kuma" pos="right" src="kuma010"/><char @l="554" id="miho" pos="left" src="miho165"/><msg @l="556" char_id="0" frame_id="-1" name="美帆" text="『啊……。』" voices=""/><msg @l="558" char_id="-1" frame_id="-1" name="留学生" text="『美帆酱，你好啊。』"   voices=""/><msg @l="560" char_id="0" frame_id="-1" name="美帆"   text="『你、你们是什么人……』" voices=""/><msg @l="562" char_id="-1" frame_id="-1" name="管理员"   text="『我是这里的用务员，名叫熊野。』" voices=""/><msg @l="564" char_id="-1" frame_id="-1" name="留学生"   text="『我是助理，“鲍比”哦。』" voices=""/><char @l="567" id="miho" pos="left" src="miho065"/><msg @l="569" char_id="0" frame_id="-1" name="美帆"   text="『不是这个……为什么，你们会在这种地方……』" voices=""/><char @l="573" id="watab" pos="right" src="watabe017"/><msg @l="575" char_id="-1" frame_id="-1" name="渡部"   text="『哼，以为能逃掉吗……太天真了。』" voices=""/><msg @l="577" char_id="0" frame_id="-1" name="美帆" text="『难道，从一开始就……』"   voices=""/><msg @l="579" char_id="-1" frame_id="-1" name="渡部"   text="『没错。你让我吃足了苦头。我叫你来就是为了狠狠地上你。』" voices=""/><msg @l="581" char_id="-1" frame_id="-1" name="留学生" text="『耶，来玩吧。』"   voices=""/><char @l="585" id="kuma" pos="right" src="kuma010"/><msg @l="587" char_id="-1" frame_id="-1" name="熊野"   text="『我们一直在等待这一刻啊。』" voices=""/><msg @l="589" char_id="0" frame_id="-1" name="美帆" text="『怎、怎么……会……』"   voices=""/><char @l="593" id="watab" pos="right" src="watabe010"/><msg @l="595" char_id="-1" frame_id="-1" name="渡部"   text="『别担心，放心好了。为了让你不会感到疼痛……我会给你施魔法的。』" voices=""/><msg @l="597" char_id="0" frame_id="-1" name="美帆" text="『啊……什么……魔法？』"   voices=""/><msg @l="599" char_id="-1" frame_id="-1" name="熊野"   text="『虽说是魔法，其实不过是现代化学诞生的产物罢了。』" voices=""/><flash @l="602" count="4" fade="100" image="white"/><msg @l="604" char_id="0" frame_id="-1" name="美帆" text="『……！？』" voices=""/><msg @l="606" char_id="-1" frame_id="-1" name="" text="突然，颈部传来一阵钝痛。"   voices=""/><msg @l="607" char_id="-1" frame_id="-1" name=""   text="接着有什么东西流入体内的灼热感。" voices=""/><msg @l="608" char_id="-1" frame_id="-1" name=""   text="我慌忙后退转身……渡部老师手里握着一支注射器。" voices=""/><char @l="611" id="miho" pos="left" src="miho164"/><msg @l="613" char_id="0" frame_id="-1" name="美帆"   text="『你给我……刚才，你给我注射了什么！？』" voices=""/><msg @l="615" char_id="-1" frame_id="-1" name="渡部" text="『不是说了吗，是魔法啊。』"   voices=""/><char @l="619" id="miho" pos="left" src="miho065"/><msg @l="621" char_id="0" frame_id="-1" name="美帆"   text="『不要，别开玩笑……啊——……』" voices=""/><stopbgm @l="625" fadeout="1000"/><clear @l="631" class="all"/><msg @l="633" char_id="0" frame_id="-1" name="美帆" text="(咦……？)" voices=""/><msg @l="635" char_id="-1" frame_id="-1" name="" text="突然……视野变暗了。"   voices=""/><msg @l="636" char_id="-1" frame_id="-1" name=""   text="如果要形容的话，可能类似于贫血即将失去意识的那一刻。" voices=""/><msg @l="637" char_id="-1" frame_id="-1" name="" text="无法自控的意识混沌……"   voices=""/><msg @l="638" char_id="-1" frame_id="-1" name="" text="然后……" voices=""/><msg @l="639" char_id="-1" frame_id="-1" name=""   text="我的意识缓缓地……坠入了黑暗之中。" voices=""/><clear @l="645" class="all"/><msgshow @l="647" show="true"/><label @l="651" id="chart_line23"/><call @l="655" target="EventLabel_82@root_akina_c_ev01"/><return @l="656" value="0&#13;&#10;"/><label @l="660" id="EventLabel_81"/><wait_chgmv/><bg @l="664" src="bg07"/><bgm @l="668" src="bgm02" volume="1."/><char @l="672" id="miho" pos="auto" src="miho110"/><msg @l="674" char_id="-1" frame_id="-1" name="" text="在我未能警告亚季奈的第二天。"   voices=""/><msg @l="675" char_id="-1" frame_id="-1" name=""   text="我乘坐最早的一班电车来到了大学。" voices=""/><msg @l="676" char_id="-1" frame_id="-1" name=""   text="虽然今天只有第三节课，但我迫不及待地想要告诉亚季奈昨天渡部老师说的事情……" voices=""/><msg @l="677" char_id="-1" frame_id="-1" name="" text="所以我才急急忙忙地赶过来了。"   voices=""/><msg @l="679" char_id="0" frame_id="-1" name="美帆" text="(亚季奈……还在宿舍吗……)"   voices=""/><clear @l="685" class="all"/><msg @l="687" char_id="-1" frame_id="-1" name=""   text="我穿过后院，朝着停车场旁边的宿舍走去。" voices=""/><msg @l="688" char_id="-1" frame_id="-1" name=""   text="虽然大概知道位置，但实际前往时又是另一回事。" voices=""/><msg @l="690" char_id="0" frame_id="-1" name="美帆" text="(穿过停车场就到了呢……)"   voices=""/><msg @l="692" char_id="-1" frame_id="-1" name=""   text="从后院延伸出来的楼梯下到停车场，穿过停车场后，眼前就是一栋大型日式建筑。" voices=""/><msg @l="694" char_id="0" frame_id="-1" name="美帆" text="『…………。』" voices=""/><msg @l="696" char_id="0" frame_id="-1" name="美帆" text="(门铃……没有啊……)"   voices=""/><se @l="700" buf="1" src="扉を開ける音_引き戸" volume="1."/><msg @l="702" char_id="0" frame_id="-1" name="美帆" text="『打扰了——』"   voices=""/><msg @l="704" char_id="0" frame_id="-1" name="美帆" text="『…………。』" voices=""/><msg @l="706" char_id="0" frame_id="-1" name="美帆" text="『……没有人出来吗……』"   voices=""/><msg @l="708" char_id="-1" frame_id="-1" name=""   text="打开玄关喊了声，但没有人要出来的迹象。" voices=""/><wait_chgmv/><bg @l="712" src="bg20"/><char @l="716" id="miho" pos="auto" src="miho110"/><msg @l="718" char_id="0" frame_id="-1" name="美帆" text="『那个，有人在吗？』"   voices=""/><msg @l="720" char_id="-1" frame_id="-1" name=""   text="没办法……虽然觉得有些失礼，但还是进去后喊了一声。" voices=""/><msg @l="721" char_id="-1" frame_id="-1" name=""   text="也许，我的声音没有传到里面。" voices=""/><msg @l="723" char_id="0" frame_id="-1" name="美帆" text="『…………。』" voices=""/><msg @l="725" char_id="0" frame_id="-1" name="美帆"   text="(没有人在……难道，大家都去游泳池了吗？)" voices=""/><wait_chgmv/><bg @l="729" src="bg20"/><char @l="733" id="miho" pos="auto" src="miho110"/><msg @l="735" char_id="0" frame_id="-1" name="美帆" text="『…………。』" voices=""/><msg @l="737" char_id="-1" frame_id="-1" name="声音" text="『请问您有什么事呢？』"   voices=""/><char @l="741" id="miho" pos="auto" src="miho014"/><msg @l="743" char_id="0" frame_id="-1" name="美帆" text="『啊！？』" voices=""/><msg @l="745" char_id="-1" frame_id="-1" name=""   text="突然从背后被叫住，我差点尖叫出声。" voices=""/><msg @l="747" char_id="-1" frame_id="-1" name="声音" text="『哎呀……怎么了？』"   voices=""/><msg @l="749" char_id="-1" frame_id="-1" name="" text="不过，这声音听起来很熟悉。"   voices=""/><clear @l="752" class="char"/><char @l="754" id="miho" pos="left" src="miho010"/><char @l="757" id="kuma" pos="right" src="kuma010"/><msg @l="759" char_id="0" frame_id="-1" name="美帆" text="『啊……是看管员先生。』"   voices=""/><msg @l="761" char_id="-1" frame_id="-1" name=""   text="回头一看，站在那里的是看管员先生。" voices=""/><msg @l="762" char_id="-1" frame_id="-1" name=""   text="说起来昨天打电话时接听的也是看管员先生，他说过类似于自己管理这栋建筑的话。" voices=""/><msg @l="763" char_id="-1" frame_id="-1" name=""   text="平常……他应该经常出入这里吧。" voices=""/><char @l="767" id="miho" pos="left" src="miho016"/><msg @l="769" char_id="0" frame_id="-1" name="美帆"   text="『对、对不起……我喊了几声但没人出来，以为没人听见我的声音，就擅自进来了……。』"   voices=""/><msg @l="771" char_id="-1" frame_id="-1" name="熊野" text="『没关系的。』"   voices=""/><msg @l="773" char_id="-1" frame_id="-1" name="熊野" text="『您是……昨天打电话的人吧？』"   voices=""/><char @l="777" id="miho" pos="left" src="miho014"/><msg @l="779" char_id="0" frame_id="-1" name="美帆" text="『呃……啊，是的！』"   voices=""/><char @l="783" id="miho" pos="left" src="miho016"/><msg @l="785" char_id="0" frame_id="-1" name="美帆"   text="『昨晚突然打电话过去实在是太冒昧了……』" voices=""/><msg @l="787" char_id="-1" frame_id="-1" name="熊野"   text="『不不，是我这边没能帮上什么忙才是。』" voices=""/><msg @l="789" char_id="-1" frame_id="-1" name="熊野"   text="『那么……今天您有什么事呢？』" voices=""/><char @l="793" id="miho" pos="left" src="miho014"/><msg @l="795" char_id="0" frame_id="-1" name="美帆"   text="『啊，对了！参加集训的那些孩子们去哪里了？』" voices=""/><msg @l="797" char_id="-1" frame_id="-1" name="熊野"   text="『啊，那些孩子们的话，现在应该在大学周围跑步吧。』" voices=""/><msg @l="799" char_id="-1" frame_id="-1" name="熊野"   text="『这个时间，他们一般都是这样的。』" voices=""/><char @l="803" id="miho" pos="left" src="miho010"/><msg @l="805" char_id="0" frame_id="-1" name="美帆" text="『这样啊……是在进行肌肉训练呢。』"   voices=""/><msg @l="807" char_id="-1" frame_id="-1" name=""   text="说起来……除了亚季奈她们在游泳池游泳的时间外，她们平时都在干什么，我好像现在才第一次知道。" voices=""/><msg @l="808" char_id="-1" frame_id="-1" name=""   text="虽然我自己在现役时期也是这样做的，说是理所当然也确实如此。" voices=""/><msg @l="810" char_id="0" frame_id="-1" name="美帆" text="『上午一直都在外面吗？』"   voices=""/><msg @l="812" char_id="-1" frame_id="-1" name="熊野"   text="『嗯……虽然我不太清楚详细情况，但除了中午回来一次外，他们似乎一直都在外面活动。』" voices=""/><msg @l="814" char_id="0" frame_id="-1" name="美帆" text="『是这样啊……』"   voices=""/><msg @l="816" char_id="0" frame_id="-1" name="美帆"   text="(果然，下午训练开始前去比较稳妥吧)" voices=""/><msg @l="818" char_id="-1" frame_id="-1" name="熊野"   text="『需要我帮您传什么话吗？』" voices=""/><char @l="822" id="miho" pos="left" src="miho016"/><msg @l="824" char_id="0" frame_id="-1" name="美帆"   text="『啊，不用……我待会儿再来见他们，没关系的。』" voices=""/><msg @l="826" char_id="-1" frame_id="-1" name="熊野" text="『这样啊。』" voices=""/><msg @l="828" char_id="0" frame_id="-1" name="美帆"   text="『突然打扰您真是不好意思。』" voices=""/><msg @l="830" char_id="-1" frame_id="-1" name="熊野" text="『不会不会。』" voices=""/><clear @l="836" class="all"/><wait_chgmv/><bg @l="840" src="bg07"/><char @l="844" id="miho" pos="auto" src="miho110"/><msg @l="846" char_id="-1" frame_id="-1" name="" text="我穿过后院，回到了校园。"   voices=""/><msg @l="847" char_id="-1" frame_id="-1" name=""   text="毫无收获……只感觉是在浪费时间。" voices=""/><msg @l="848" char_id="-1" frame_id="-1" name=""   text="漫无目的地在校园里走动，遇见亚季奈的概率很低。" voices=""/><msg @l="849" char_id="-1" frame_id="-1" name="" text="去游泳池训练时间的话肯定能见到她。"   voices=""/><msg @l="850" char_id="-1" frame_id="-1" name=""   text="我这样想着，决定先去上课打发时间。" voices=""/><msg @l="852" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="854" char_id="0" frame_id="-1" name="美帆"   text="『亚季奈……你现在在哪里呢……。』" voices=""/><msg @l="856" char_id="-1" frame_id="-1" name=""   text="我喃喃自语，思绪飘向校园某处的亚季奈……" voices=""/><stopbgm @l="860" fadeout="1000"/><clear @l="866" class="all"/><msgshow @l="868" show="true"/><wait_chgmv/><bg @l="872" src="bg10m1"/><bgm @l="876" src="bgm03" volume="1."/><char @l="880" id="miho" pos="auto" src="miho166"/><msg @l="882" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="884" char_id="-1" frame_id="-1" name=""   text="下课后我匆忙赶往室内游泳池……但还是晚了。" voices=""/><msg @l="885" char_id="-1" frame_id="-1" name=""   text="游泳部的孩子们已经开始训练了，而且最重要的是……" voices=""/><msg @l="893" char_id="-1" frame_id="-1" name=""   text="在泳池的其中一条泳道，亚季奈和渡部老师正在进行一对一的训练。" voices=""/><msg @l="894" char_id="-1" frame_id="-1" name=""   text="他们两个总是形影不离……甚至可以说是过于亲密了。" voices=""/><msg @l="895" char_id="-1" frame_id="-1" name="" text="……这已经不是简单的忠告能解决的问题了。"   voices=""/><msg @l="897" char_id="0" frame_id="-1" name="美帆" text="(亚季奈……那个人不行啊……)"   voices=""/><msg @l="899" char_id="-1" frame_id="-1" name=""   text="我一直在寻找亚季奈单独一人的时机，但因为我也是来当教练的，行动上多有不便。"   voices=""/><msg @l="900" char_id="-1" frame_id="-1" name=""   text="每当我觉得亚季奈终于一个人了，她总会过来请我看她的游泳姿势，反而是我陷入了动弹不得的境地。"   voices=""/><msg @l="902" char_id="0" frame_id="-1" name="美帆" text="(亚季奈……)" voices=""/><clear @l="912" class="char"/><msg @l="917" char_id="-1" frame_id="-1" name="渡部"   text="『看，你姐姐正一脸担心地看着这边呢？』" voices=""/><msg @l="919" char_id="2" frame_id="-1" name="亚季奈" text="『嗯……。』" voices=""/><msg @l="921" char_id="-1" frame_id="-1" name="渡部" text="『怎么了，去找她怎么样？』"   voices=""/><msg @l="923" char_id="2" frame_id="-1" name="亚季奈"   text="『……这种……老师，别欺负我……。』" voices=""/><msg @l="925" char_id="-1" frame_id="-1" name="渡部"   text="『欺负你？我不知道你在说什么啊？』" voices=""/><msg @l="927" char_id="-1" frame_id="-1" name=""   text="就这样嘴角扭曲着，渡部的手在水下玩弄着亚季奈的私密部位。" voices=""/><msg @l="928" char_id="-1" frame_id="-1" name=""   text="亚季奈的脸颊染上樱花色……腰随着指尖的动作颤抖着。" voices=""/><msg @l="930" char_id="-1" frame_id="-1" name="渡部"   text="『昨天那个有那么舒服吗，亚季奈？』" voices=""/><msg @l="932" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯……老师，太厉害了。』" voices=""/><msg @l="934" char_id="2" frame_id="-1" name="亚季奈"   text="『没想到那种事会那么舒服……我之前都不知道。』" voices=""/><msg @l="936" char_id="-1" frame_id="-1" name="渡部"   text="『是吗。那么，想要变得更舒服吗？』" voices=""/><msg @l="938" char_id="2" frame_id="-1" name="亚季奈"   text="『想要……我想要变得更更舒服。』" voices=""/><msg @l="940" char_id="-1" frame_id="-1" name=""   text="这样说着看向渡部的亚季奈的眼眸，已经变得湿润而炽热。" voices=""/><msg @l="941" char_id="-1" frame_id="-1" name=""   text="每当隔着泳衣摩擦爱核，她嘴边不断漏出热气……口腔里的舌尖渴望地颤抖着。"   voices=""/><msg @l="943" char_id="-1" frame_id="-1" name="渡部"   text="『好……那就靠在那边的泳道线上吧。』" voices=""/><msg @l="945" char_id="2" frame_id="-1" name="亚季奈" text="『你要做什么……？』"   voices=""/><msg @l="947" char_id="-1" frame_id="-1" name="渡部"   text="『不是想让我让你舒服吗？乖乖听话就是了。』" voices=""/><msg @l="949" char_id="2" frame_id="-1" name="亚季奈" text="『嗯、嗯……。』"   voices=""/><clear @l="955" class="all"/><label @l="958" id="event_scene21"/><label @l="962" id="chart_line16"/><wait_chgmv/><ev @l="966" src="ev-021"/><description @l="969" text="秘密的交合"/><bgm @l="973" src="bgm10" volume="1."/><msg @l="975" char_id="2" frame_id="-1" name="亚季奈" text="『唔唔……。』"   voices="akina00940"/><msg @l="977" char_id="-1" frame_id="-1" name=""   text="靠在泳道线上，亚季奈的秘裂被爱抚打开，肉棒插了进去。" voices=""/><msg @l="978" char_id="-1" frame_id="-1" name=""   text="她的表情充满困惑，看起来恐惧着周围人的视线。" voices=""/><msg @l="980" char_id="-1" frame_id="-1" name="渡部"   text="『害怕吗？害怕被姐姐发现会怎么样。』" voices=""/><msg @l="982" char_id="2" frame_id="-1" name="亚季奈"   text="『不要啊……我不想被姐姐看到啊。』" voices="akina00950"/><msg @l="984" char_id="-1" frame_id="-1" name="渡部"   text="『哦？那么除了姐姐以外的人看到也无所谓了？』" voices=""/><msg @l="986" char_id="2" frame_id="-1" name="亚季奈"   text="『才、才不是那个意思……嗯、啊啊！！』" voices="akina00960"/><msg @l="988" char_id="-1" frame_id="-1" name=""   text="渡部打断亚季奈的话，摆动腰部搅动着她的阴肉。" voices=""/><msg @l="990" char_id="2" frame_id="-1" name="亚季奈"   text="『啊、嗯呜……还有……有点疼……。』" voices="akina00970"/><msg @l="992" char_id="-1" frame_id="-1" name="渡部"   text="『你本来就很淫乱，这样做着做着很快就会习惯变得舒服起来。』" voices=""/><msg @l="994" char_id="2" frame_id="-1" name="亚季奈"   text="『我、我才不淫乱呢……。』" voices="akina00980"/><msg @l="996" char_id="-1" frame_id="-1" name="渡部"   text="『明明这么说，你的这里却紧紧地夹着我都快疼了，怎么回事？』" voices=""/><msg @l="998" char_id="2" frame_id="-1" name="亚季奈"   text="『那是因为……嗯嗯……啊、不要……。』" voices="akina00990"/><msg @l="1000" char_id="-1" frame_id="-1" name=""   text="渡部的指尖扭捏着亚季奈被撑开的裂缝上方的突起。" voices=""/><msg @l="1001" char_id="-1" frame_id="-1" name=""   text="仅仅是这样，亚季奈的阴道内就渗出大量的蜜汁，变得炽热起来。" voices=""/><msg @l="1003" char_id="2" frame_id="-1" name="亚季奈"   text="『呀啊……那里，很敏感的……嗯，唔唔……不行啊……。』" voices="akina01000"/><msg @l="1005" char_id="-1" frame_id="-1" name="渡部"   text="『怎么了，不是想要舒服吗？』" voices=""/><msg @l="1007" char_id="2" frame_id="-1" name="亚季奈"   text="『但、但是……嗯啊，在这种地方……啊！』" voices="akina01010"/><msg @l="1009" char_id="-1" frame_id="-1" name="渡部"   text="『放心吧，姐姐正忙着指导那群人呢。』" voices=""/><msg @l="1011" char_id="-1" frame_id="-1" name="渡部"   text="『至少三十分钟内她应该没空看这边。』" voices=""/><msg @l="1013" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯……可是，声音……如果发出来，会被发现的啊……。』" voices="akina01020"/><msg @l="1015" char_id="-1" frame_id="-1" name="渡部" text="『那就不要发出声音就好了。』"   voices=""/><msg @l="1017" char_id="2" frame_id="-1" name="亚季奈"   text="『怎么可能……嗯，啊，啊，啊啊！！』" voices="akina01030"/><msg @l="1019" char_id="-1" frame_id="-1" name=""   text="当渡部加快腰部的律动时，亚季奈娇小的身体被顶得摇摇晃晃。" voices=""/><msg @l="1020" char_id="-1" frame_id="-1" name=""   text="由于水的浮力使她整个身体漂浮起来，亚季奈的意识完全集中在渡部的男根上。" voices=""/><msg @l="1021" char_id="-1" frame_id="-1" name="" text="以两人为中心，泳池中泛起阵阵波纹。"   voices=""/><msg @l="1023" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯嗯……老师的……嗯，好热……。』" voices="akina01040"/><msg @l="1025" char_id="-1" frame_id="-1" name="渡部"   text="『你喜欢吧？这种热热的感觉。』" voices=""/><msg @l="1027" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯，嗯……又热又大又硬的肉棒，最喜欢了。』" voices="akina01050"/><msg @l="1029" char_id="-1" frame_id="-1" name="渡部" text="『果然你就是个淫荡的女孩，亚季奈。』"   voices=""/><msg @l="1031" char_id="2" frame_id="-1" name="亚季奈"   text="『啊啊……嗯，嗯，嗯……呀啊，都顶到了。』" voices="akina01060"/><msg @l="1033" char_id="2" frame_id="-1" name="亚季奈"   text="『热热的东西顶到最深处……嗯，啊啊……麻麻的……。』" voices="akina01070"/><msg @l="1035" char_id="-1" frame_id="-1" name="渡部"   text="『哦，这边也被你夹得很紧……快要被榨干了。』" voices=""/><msg @l="1037" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯啊……又、肉棒又变大了哦？』" voices="akina01080"/><msg @l="1039" char_id="-1" frame_id="-1" name="渡部"   text="『啊，我这就射在里面。』" voices=""/><msg @l="1041" char_id="2" frame_id="-1" name="亚季奈"   text="『好啊……来吧……想要老师的热热的精液，请全部灌进来……。』" voices="akina01090"/><msg @l="1043" char_id="-1" frame_id="-1" name="渡部" text="『哈哈，你已经学会这么说了啊。』"   voices=""/><msg @l="1045" char_id="-1" frame_id="-1" name="渡部"   text="『好啊……我要射进你最深处，注入你的子宫。』" voices=""/><msg @l="1047" char_id="-1" frame_id="-1" name=""   text="说着，渡部猛力挺腰，将硬物深深推入亚季奈蜜穴的最深处。" voices=""/><msg @l="1048" char_id="-1" frame_id="-1" name="" text="渡部的那物完全消失在亚季奈体内。"   voices=""/><msg @l="1049" char_id="-1" frame_id="-1" name=""   text="渡部那比阴道还长的硬挺，将亚季奈的内脏都顶了起来。" voices=""/><msg @l="1051" char_id="2" frame_id="-1" name="亚季奈"   text="『啊呜……嗯，啊，啊，啊，嗯啊！！』" voices="akina01100"/><msg @l="1053" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯，啊啊……深处……顶到了……嗯嗯！！！』" voices="akina01110"/><flash @l="1057" count="4" fade="100" image="white"/><wait_chgmv/><ev @l="1061" src="ev-021x1"/><msg @l="1063" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯嗯……好厉害，都流进来了……。』" voices="akina01120"/><msg @l="1065" char_id="-1" frame_id="-1" name=""   text="亚季奈阴道内注入的精液溢了出来，污染了泳池的水。" voices=""/><msg @l="1066" char_id="-1" frame_id="-1" name=""   text="不过，这些精液很快就会混入流向排水沟的水中消失不见吧。" voices=""/><msg @l="1068" char_id="-1" frame_id="-1" name="渡部"   text="『怎么样，你最喜欢的牛奶的味道如何？』" voices=""/><msg @l="1070" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯……好热，好舒服……。』" voices="akina01130"/><msg @l="1072" char_id="-1" frame_id="-1" name="渡部" text="『那就好。』"   voices=""/><clear @l="1078" class="all"/><end_scene @l="1081"/><wait_chgmv/><bg @l="1085" src="bg10m1"/><char @l="1089" id="akina" pos="auto" src="akina165"/><msg @l="1094" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯……感觉，要漏出来了。』" voices=""/><msg @l="1096" char_id="-1" frame_id="-1" name="渡部" text="『别中途漏出来被发现了。』"   voices=""/><msg @l="1098" char_id="2" frame_id="-1" name="亚季奈" text="『嗯，好……。』"   voices=""/><msg @l="1100" char_id="-1" frame_id="-1" name="渡部"   text="『哎呀……你姐姐正用可怕的表情瞪着我们呢。』" voices=""/><msg @l="1102" char_id="-1" frame_id="-1" name="渡部"   text="『我去看看其他人，你就去随便冲个澡吧。』" voices=""/><char @l="1105" id="akina" pos="auto" src="akina060"/><msg @l="1107" char_id="2" frame_id="-1" name="亚季奈"   text="『知道了……我该怎么跟姐姐解释？』" voices=""/><msg @l="1109" char_id="-1" frame_id="-1" name="渡部"   text="『如果你还想继续享受快感的话，什么都别说。』" voices=""/><msg @l="1111" char_id="2" frame_id="-1" name="亚季奈"   text="『……嗯，我想要继续享受快感。』" voices=""/><msg @l="1113" char_id="-1" frame_id="-1" name="渡部"   text="『那就想办法蒙混过关吧……如果你能做到，待会我再好好疼爱你。』" voices=""/><char @l="1117" id="akina" pos="auto" src="akina061"/><msg @l="1119" char_id="2" frame_id="-1" name="亚季奈"   text="『真的？ 这是约定哦！？』" voices=""/><msg @l="1121" char_id="-1" frame_id="-1" name="渡部" text="『啊，这是约定。』"   voices=""/><msg @l="1123" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯！ 我会好好蒙混过关的！』" voices=""/><msg @l="1125" char_id="-1" frame_id="-1" name="渡部" text="『啊，加油。』"   voices=""/><msg @l="1130" char_id="-1" frame_id="-1" name=""   text="就这样，渡部故意瞥了美帆一眼后，朝着队员们游泳的反方向泳道走去。" voices=""/><msg @l="1131" char_id="-1" frame_id="-1" name=""   text="美帆……一边瞪着离开的渡部，一边趁着指导间隙走向亚季奈所在的泳池边。"   voices=""/><bgm @l="1135" src="bgm03" volume="1."/><clear @l="1138" class="char"/><char @l="1140" id="akina" pos="left" src="akina060"/><char @l="1143" id="miho" pos="right" src="miho160"/><msg @l="1145" char_id="0" frame_id="-1" name="美帆" text="『我有点事想和你说，可以吗？』"   voices=""/><msg @l="1147" char_id="2" frame_id="-1" name="亚季奈" text="『……。』" voices=""/><msg @l="1149" char_id="0" frame_id="-1" name="美帆" text="『亚季奈……？』" voices=""/><char @l="1153" id="akina" pos="left" src="akina067"/><msg @l="1155" char_id="2" frame_id="-1" name="亚季奈"   text="『对不起，姐姐……我现在不太想说话。』" voices=""/><msg @l="1157" char_id="0" frame_id="-1" name="美帆" text="『很快就好，拜托……。』"   voices=""/><msg @l="1159" char_id="2" frame_id="-1" name="亚季奈" text="『能不能改天再说？』"   voices=""/><char @l="1162" id="akina" pos="left" src="akina164"/><msg @l="1164" char_id="2" frame_id="-1" name="亚季奈" text="『啊！？』" voices=""/><char @l="1167" id="miho" pos="right" src="miho064"/><msg @l="1169" char_id="0" frame_id="-1" name="美帆" text="『怎、怎么了亚季奈？』"   voices=""/><char @l="1172" id="akina" pos="left" src="akina065"/><msg @l="1174" char_id="-1" frame_id="-1" name=""   text="刚才射进亚季奈阴道口的精液流了出来，沾到了泳衣的胯部。" voices=""/><char @l="1177" id="akina" pos="left" src="akina061"/><msg @l="1179" char_id="2" frame_id="-1" name="亚季奈"   text="『没、没什么……真的没什么。』" voices=""/><char @l="1182" id="miho" pos="right" src="miho066"/><msg @l="1184" char_id="0" frame_id="-1" name="美帆"   text="『但是你脸好像有点红……要不要一起去医务室？』" voices=""/><msg @l="1186" char_id="-1" frame_id="-1" name=""   text="亚季奈表面上装作平静，内心却拼命收紧阴道，试图封住入口。" voices=""/><msg @l="1187" char_id="-1" frame_id="-1" name=""   text="然而，无情的第一滴精液还是从大腿内侧渗了出来。" voices=""/><msg @l="1188" char_id="-1" frame_id="-1" name=""   text="竞泳泳衣的耻骨处，逐渐晕开了一片淡淡的白色污渍。" voices=""/><char @l="1191" id="akina" pos="left" src="akina164"/><msg @l="1193" char_id="2" frame_id="-1" name="亚季奈" text="『呜啊！？』" voices=""/><char @l="1196" id="miho" pos="right" src="miho164"/><msg @l="1198" char_id="0" frame_id="-1" name="美帆" text="『啊，亚季奈，你没事吧？』"   voices=""/><char @l="1202" id="akina" pos="left" src="akina067"/><msg @l="1204" char_id="2" frame_id="-1" name="亚季奈" text="『没、没什么都说了！』"   voices=""/><char @l="1207" id="miho" pos="right" src="miho065"/><msg @l="1209" char_id="0" frame_id="-1" name="美帆" text="『……！！』" voices=""/><msg @l="1211" char_id="2" frame_id="-1" name="亚季奈" text="『…………。』" voices=""/><msg @l="1213" char_id="2" frame_id="-1" name="亚季奈"   text="『我、我出汗了要去冲个澡！……回头见。』" voices=""/><clear @l="1217" layer="akina"/><char @l="1221" id="miho" pos="right" src="miho064"/><msg @l="1223" char_id="0" frame_id="-1" name="美帆" text="『啊，亚季奈……？』"   voices=""/><msg @l="1225" char_id="-1" frame_id="-1" name=""   text="亚季奈单方面结束谈话，朝着更衣室走去。" voices=""/><msg @l="1226" char_id="-1" frame_id="-1" name=""   text="美帆想要伸手挽留，却没有勇气将手放在她肩上。" voices=""/><msg @l="1227" char_id="-1" frame_id="-1" name="" text="亚季奈就这样离开了。"   voices=""/><char @l="1231" id="miho" pos="right" src="miho166"/><msg @l="1233" char_id="0" frame_id="-1" name="美帆" text="『…………。』" voices=""/><msg @l="1235" char_id="-1" frame_id="-1" name=""   text="美帆一个人带着寂寞的表情，注视着亚季奈离开室内泳池的背影……。" voices=""/><clear @l="1241" class="all"/><wait_chgmv/><bg @l="1245" src="bg07b"/><char @l="1249" id="miho" pos="auto" src="miho116"/><msg @l="1251" char_id="0" frame_id="-1" name="美帆" text="『…………。』" voices=""/><msg @l="1253" char_id="-1" frame_id="-1" name=""   text="在有室内泳池的体育馆前，我等待着亚季奈出来。" voices=""/><msg @l="1254" char_id="-1" frame_id="-1" name=""   text="虽然在泳池边不明不白地被她躲开了，但也不能就这样不管不顾。"   voices=""/><msg @l="1255" char_id="-1" frame_id="-1" name=""   text="说不定她是被渡部老师胁迫了……这种可能性也是存在的。" voices=""/><msg @l="1257" char_id="0" frame_id="-1" name="美帆"   text="(刚才那个……也许只是心情不好而已)" voices=""/><msg @l="1259" char_id="0" frame_id="-1" name="美帆"   text="(如果好好按顺序说明理由的话，亚季奈应该会理解的吧)" voices=""/><msg @l="1261" char_id="-1" frame_id="-1" name=""   text="我半是自言自语地在心中低语着。" voices=""/><msg @l="1262" char_id="-1" frame_id="-1" name=""   text="刚才亚季奈的态度……明显是在回避我。" voices=""/><msg @l="1263" char_id="-1" frame_id="-1" name=""   text="考虑到这一点，必须把话说清楚才行……。" voices=""/><clear @l="1267" class="char"/><msg @l="1269" char_id="0" frame_id="-1" name="美帆" text="(话说回来……亚季奈，好慢啊)"   voices=""/><msg @l="1271" char_id="-1" frame_id="-1" name=""   text="结果，亚季奈说要去冲澡离开室内泳池后就再也没有回来。" voices=""/><msg @l="1272" char_id="-1" frame_id="-1" name=""   text="我想她可能先回宿舍了……但亚季奈平时使用的储物柜确实上了锁，所以她肯定还在里面。"   voices=""/><char @l="1276" id="akina" pos="auto" src="akina010"/><msg @l="1278" char_id="2" frame_id="-1" name="亚季奈" text="『…………。』" voices=""/><msg @l="1280" char_id="0" frame_id="-1" name="美帆" text="『啊，亚季奈！』"   voices=""/><clear @l="1283" class="char"/><char @l="1285" id="akina" pos="left" src="akina010"/><char @l="1288" id="miho" pos="right" src="miho111"/><msg @l="1290" char_id="-1" frame_id="-1" name="" text="亚季奈从体育馆的入口走了出来。"   voices=""/><msg @l="1291" char_id="-1" frame_id="-1" name=""   text="我一边喊着她一边跑过去，站在了她旁边。" voices=""/><msg @l="1293" char_id="0" frame_id="-1" name="美帆"   text="『你好慢啊，我们一起走一段路回去吧。』" voices=""/><char @l="1297" id="akina" pos="left" src="akina014"/><msg @l="1299" char_id="2" frame_id="-1" name="亚季奈" text="『……你为什么要等我？』"   voices=""/><char @l="1303" id="miho" pos="right" src="miho011"/><msg @l="1305" char_id="0" frame_id="-1" name="美帆"   text="『啊，为什么……我们不是一直都这样的吗。』" voices=""/><msg @l="1307" char_id="2" frame_id="-1" name="亚季奈" text="『………。』" voices=""/><char @l="1311" id="akina" pos="left" src="akina017"/><msg @l="1313" char_id="2" frame_id="-1" name="亚季奈"   text="『今天我不想和任何人说话……你自己回去吧。』" voices=""/><char @l="1317" id="miho" pos="right" src="miho116"/><msg @l="1319" char_id="0" frame_id="-1" name="美帆"   text="『可是……我……有话要和亚季奈说……。』" voices=""/><char @l="1323" id="akina" pos="left" src="akina117"/><msg @l="1326" char_id="2" frame_id="-1" name="亚季奈" text="『我不想说话。』"   voices=""/><msg @l="1328" char_id="0" frame_id="-1" name="美帆" text="『怎么这样……。』" voices=""/><msg @l="1330" char_id="2" frame_id="-1" name="亚季奈"   text="『而且姐姐……你有点太关心我了。』" voices=""/><char @l="1334" id="miho" pos="right" src="miho014"/><msg @l="1336" char_id="0" frame_id="-1" name="美帆" text="『诶……那是什么意思？』"   voices=""/><msg @l="1338" char_id="2" frame_id="-1" name="亚季奈"   text="『我已经不是小孩子了……能不要那么关心我吗？』" voices=""/><clear @l="1342" layer="akina"/><clear @l="1345" class="char"/><char @l="1348" id="miho" pos="right" src="miho114"/><msg @l="1350" char_id="0" frame_id="-1" name="美帆" text="『啊，等等……亚季奈！？』"   voices=""/><msg @l="1352" char_id="-1" frame_id="-1" name=""   text="亚季奈说完这句话就独自快步走开了。" voices=""/><msg @l="1353" char_id="-1" frame_id="-1" name=""   text="我不知道是否该追上去，只能目送她离开的背影。" voices=""/><char @l="1357" id="miho" pos="right" src="miho115"/><msg @l="1359" char_id="0" frame_id="-1" name="美帆" text="『为什么……。』"   voices=""/><msg @l="1361" char_id="-1" frame_id="-1" name=""   text="我这样喃喃自语的疑问无法传达给亚季奈……。" voices=""/><msg @l="1362" char_id="-1" frame_id="-1" name=""   text="溶解在阻隔两人之间的深沉夜色中……最终消失不见……………。" voices=""/><stopbgm @l="1366" fadeout="1000"/><clear @l="1372" class="all"/><label @l="1375" id="event_scene22"/><msgshow @l="1378" show="true"/><wait_chgmv/><bg @l="1382" src="bg19b"/><bgm @l="1386" src="bgm10" volume="1."/><msg @l="1388" char_id="2" frame_id="-1" name="声音"   text="『啊呜……嗯……嗯……啊啊……。』" voices="akina01310"/><msg @l="1390" char_id="-1" frame_id="-1" name="" text="―――深夜。" voices=""/><msg @l="1391" char_id="-1" frame_id="-1" name=""   text="从游泳部的宿舍某个房间里，传出了艳丽的喘息声。" voices=""/><msg @l="1392" char_id="-1" frame_id="-1" name=""   text="在灯光熄灭，宿舍沉浸在深沉黑暗中的环境里，唯独那个房间的灯光……仿佛在抗拒黑暗一般明亮地亮着。"   voices=""/><char @l="1396" id="watab" pos="auto" src="watabe010"/><msg @l="1398" char_id="-1" frame_id="-1" name="渡部"   text="『哟……看来已经迫不及待地开始了啊。』" voices=""/><msg @l="1400" char_id="-1" frame_id="-1" name=""   text="结束了深夜的巡查，渡部回到了房间。" voices=""/><msg @l="1402" char_id="-1" frame_id="-1" name="留学生"   text="『哦哦！哦哦，哦啊啊！』" voices=""/><clear @l="1405" class="char"/><char @l="1407" id="watab" pos="left" src="watabe010"/><char @l="1410" id="kuma" pos="right" src="kuma010"/><msg @l="1412" char_id="-1" frame_id="-1" name="熊野"   text="『我本来打算等您回来的，但他说什么也忍不住了。』" voices=""/><char @l="1415" id="watab" pos="left" src="watabe012"/><msg @l="1417" char_id="-1" frame_id="-1" name="渡部"   text="『嘛，对付那家伙这种程度正好吧？』" voices=""/><char @l="1420" id="kuma" pos="right" src="kuma012"/><msg @l="1422" char_id="-1" frame_id="-1" name="熊野" text="『确实如此啊。』" voices=""/><label @l="1426" id="chart_line18"/><wait_chgmv/><ev @l="1430" src="ev-022y1"/><description @l="1433" text="亚季奈，轮奸"/><msg @l="1435" char_id="2" frame_id="-1" name="亚季奈"   text="『呃啊…嗯，嗯，嗯……啊呜！！』" voices="akina01320"/><msg @l="1437" char_id="-1" frame_id="-1" name="" text="不知过了多长时间。"   voices=""/><msg @l="1438" char_id="-1" frame_id="-1" name=""   text="房间里，留学生一直在不停地侵犯着亚季奈。" voices=""/><msg @l="1439" char_id="-1" frame_id="-1" name=""   text="她已经被推上高潮多次，脸上的表情复杂，仿佛是恍惚与厌恶混杂在一起。" voices=""/><msg @l="1441" char_id="2" frame_id="-1" name="亚季奈"   text="『老师……我果然，除了老师以外的人我不要啊……』" voices="akina01330"/><msg @l="1443" char_id="-1" frame_id="-1" name="渡部"   text="『话虽如此，看起来你还是感觉挺爽的嘛。』" voices=""/><msg @l="1445" char_id="2" frame_id="-1" name="亚季奈"   text="『不，不是的……这种事……我……嗯，啊啊！！』" voices="akina01340"/><msg @l="1447" char_id="-1" frame_id="-1" name=""   text="就在亚季奈想要说出否定的话语的那一瞬间……搅动着她蜜穴的东西强烈地擦过，让她的否定变成了一声声娇喘。"   voices=""/><msg @l="1448" char_id="-1" frame_id="-1" name=""   text="渡部满意地注视着这一切，嘴角露出邪恶的笑容。" voices=""/><msg @l="1450" char_id="-1" frame_id="-1" name="渡部" text="『哦，哪里不一样了？』"   voices=""/><msg @l="1452" char_id="2" frame_id="-1" name="亚季奈"   text="『这、这是……嗯、嗯嗯………呼……啊啊……。』" voices="akina01350"/><msg @l="1454" char_id="-1" frame_id="-1" name=""   text="每当她想要找借口辩解时，敏感的地方就会被顶弄，无论如何都无法把话说完整。" voices=""/><msg @l="1455" char_id="-1" frame_id="-1" name=""   text="即使想要反抗，但仅仅支撑自己的身体就已经耗尽全力，当留学生挺动腰部时，她那娇小的身体就会不稳地摇晃，再做更多的抵抗已经完全不可能了。"   voices=""/><clear @l="1459" class="ev"/><wait_chgmv/><bg @l="1463" src="bg19b"/><char @l="1467" id="watab" pos="left" src="watabe010"/><char @l="1471" id="kuma" pos="right" src="kuma010"/><msg @l="1473" char_id="-1" frame_id="-1" name="渡部" text="『开发进展得很顺利嘛？』"   voices=""/><msg @l="1475" char_id="-1" frame_id="-1" name="熊野"   text="『是啊……不过，心理上还能看到一些抵抗。』" voices=""/><msg @l="1477" char_id="-1" frame_id="-1" name="渡部"   text="『照这个势头，那点抵抗也很快就会消失吧。』" voices=""/><msg @l="1479" char_id="-1" frame_id="-1" name="熊野"   text="『是啊，费心安排黑人过来真是值得。』" voices=""/><msg @l="1481" char_id="-1" frame_id="-1" name="熊野"   text="『嘛，实验就先算是成功了，您看这样如何？』" voices=""/><msg @l="1483" char_id="-1" frame_id="-1" name="渡部"   text="『啊……虽然让主要目标跑了，但暂时用这家伙做各种试验也不错。』" voices=""/><msg @l="1485" char_id="-1" frame_id="-1" name=""   text="渡部微微眯起眼睛，看向正在被不情愿的对象侵犯，在痛苦与快感中挣扎的亚季奈。" voices=""/><msg @l="1486" char_id="-1" frame_id="-1" name=""   text="他的表情上浮现着一丝冷淡的笑意。" voices=""/><wait_chgmv/><ev @l="1490" src="ev-022y1"/><msg @l="1492" char_id="-1" frame_id="-1" name="留学生"   text="『哦，小穴，要，来了，来了。』" voices=""/><msg @l="1494" char_id="-1" frame_id="-1" name="渡部"   text="『被黑人的黑屌弄得欲仙欲死，这样下去那里不就变松垮垮的没法用了吗？』" voices=""/><msg @l="1496" char_id="2" frame_id="-1" name="亚季奈"   text="『呀啊……那种事……嗯嗯……啊，嗯啊。』" voices="akina01360"/><msg @l="1498" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯，嗯，嗯，啊……那么深处……嗯，呃啊！』" voices="akina01370"/><msg @l="1500" char_id="-1" frame_id="-1" name=""   text="留学生完全不在意她的否定之词，贪婪地律动着腰部，品尝着被蜜液充分润滑到几乎溢出的膣穴。"   voices=""/><msg @l="1501" char_id="-1" frame_id="-1" name=""   text="每当她的蜜壶被这样搅动，亚季奈的疼痛感就不由自主地膨胀，最后甚至开始自己摇晃起腰来。" voices=""/><msg @l="1503" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯呜……啊呼………嗯……嗯………啊啊………。』" voices="akina01380"/><msg @l="1505" char_id="2" frame_id="-1" name="亚季奈"   text="『不行……这种……嗯咕，好舒服……什么的……。』" voices="akina01390"/><msg @l="1507" char_id="-1" frame_id="-1" name=""   text="与她内心对这行为的否定相反，摩擦着膣壁的肉炮所产生的热量和麻痹感正在逐渐膨胀。" voices=""/><msg @l="1508" char_id="-1" frame_id="-1" name=""   text="亚季奈对这无法自控的快感感到困惑，泪水从她的眼中溢出。" voices=""/><msg @l="1510" char_id="-1" frame_id="-1" name="渡部" text="『看来还需要再推一把啊。』"   voices=""/><msg @l="1512" char_id="-1" frame_id="-1" name="熊野"   text="『那么，是时候让我们也加入了吧。』" voices=""/><msg @l="1514" char_id="-1" frame_id="-1" name="渡部"   text="『啊……得好好调教成一只优秀的母犬才行。』" voices=""/><msg @l="1516" char_id="-1" frame_id="-1" name="熊野"   text="『正好福池议员先生也在寻求新的宠物呢。有了这个，这座城市的项目终于可以顺利推进了。』"   voices=""/><msg @l="1518" char_id="-1" frame_id="-1" name="渡部"   text="『是啊，那个人厌倦得很快……辛辛苦苦调教的女人一天就被退回来，真是让人火大啊。』" voices=""/><msg @l="1520" char_id="-1" frame_id="-1" name="熊野" text="『唉，确实如此。』"   voices=""/><msg @l="1522" char_id="-1" frame_id="-1" name=""   text="熊野一边吐出既像抱怨又像嘟囔的话语，一边在被留学生侵犯着的亚季奈面前跪下，手搭在裤子的皮带上。"   voices=""/><msg @l="1523" char_id="-1" frame_id="-1" name=""   text="接着，他将已经硬挺的肉枪暴露在她面前，大幅度扭曲嘴角，将龟头抵在她的嘴边。" voices=""/><wait_chgmv/><ev @l="1527" src="ev-022x1y1y3"/><msg @l="1529" char_id="2" frame_id="-1" name="亚季奈" text="『嗯呜！？』"   voices="akina01400"/><msg @l="1531" char_id="-1" frame_id="-1" name="熊野"   text="『来，用你的嘴唇和舌头好好地舔吮我的东西吧。』" voices=""/><msg @l="1533" char_id="-1" frame_id="-1" name=""   text="肉枪的前端被插入亚季奈的口腔中。" voices=""/><msg @l="1534" char_id="-1" frame_id="-1" name=""   text="不过……仅仅是被搅动阴道，亚季奈已经精疲力尽了。" voices=""/><msg @l="1535" char_id="-1" frame_id="-1" name=""   text="当然，她不可能好好地应付被塞入口中的东西。" voices=""/><msg @l="1537" char_id="2" frame_id="-1" name="亚季奈" text="『呜咕……呜，呜呜！！』"   voices="akina01410"/><msg @l="1539" char_id="-1" frame_id="-1" name=""   text="面对在口腔内肆虐的肉茎，亚季奈瞪大双眼，喘息不已。" voices=""/><msg @l="1540" char_id="-1" frame_id="-1" name="" text="直到前几天她还是处女。"   voices=""/><msg @l="1541" char_id="-1" frame_id="-1" name=""   text="她几乎没有为男人的东西服务的知识和技巧。" voices=""/><msg @l="1543" char_id="-1" frame_id="-1" name="熊野"   text="『不知道怎么做吗？真是没办法啊。』" voices=""/><msg @l="1545" char_id="-1" frame_id="-1" name=""   text="熊野一边嘟囔着这样说，一边细心地指导她如何用口腔服务。" voices=""/><msg @l="1546" char_id="-1" frame_id="-1" name=""   text="要用唾液涂抹含在口中的前端，用舌尖仔细舔舐龟头的缝隙和背侧的筋络，这样细致的指导持续了一段时间。"   voices=""/><msg @l="1547" char_id="-1" frame_id="-1" name=""   text="亚季奈含着泪水听着这些，带着几分惧怕的神情看着熊野。" voices=""/><msg @l="1549" char_id="2" frame_id="-1" name="亚季奈" text="『……。』"   voices="akina01420"/><msg @l="1551" char_id="-1" frame_id="-1" name=""   text="然后，亚季奈像是寻求帮助一般抬起脸，望向房间的一角。" voices=""/><msg @l="1552" char_id="-1" frame_id="-1" name=""   text="在她视线的尽头是渡部……他正怒目而视。" voices=""/><msg @l="1554" char_id="-1" frame_id="-1" name="渡部" text="『……。』" voices=""/><msg @l="1556" char_id="-1" frame_id="-1" name=""   text="渡部拒绝了亚季奈求助的眼神，用下巴示意她继续。" voices=""/><msg @l="1557" char_id="-1" frame_id="-1" name=""   text="亚季奈看到这一幕，瞬间露出绝望的表情，但很快就像是放弃了一般，开始继续服务口中的那个东西。" voices=""/><msg @l="1559" char_id="2" frame_id="-1" name="亚季奈" text="『嗯……啾。』"   voices="akina01430"/><msg @l="1561" char_id="2" frame_id="-1" name="亚季奈"   text="『唔，啾，啾……啊……。』" voices="akina01440"/><msg @l="1563" char_id="-1" frame_id="-1" name=""   text="亚季奈正在口中那物上施展刚刚学会的服务技巧。" voices=""/><msg @l="1564" char_id="-1" frame_id="-1" name="" text="只不过，她的舌技自然还很生疏。"   voices=""/><msg @l="1566" char_id="-1" frame_id="-1" name="熊野"   text="『如果不能更认真地服务的话，我又要不得不强行动起来了呢。』" voices=""/><msg @l="1568" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯嗯……嗯，舔，舔……嗯呜，嗯，啾。』" voices="akina01450"/><msg @l="1570" char_id="-1" frame_id="-1" name=""   text="第一次口交时，那东西几乎要刺穿她的喉咙深处，应该是痛苦至极。" voices=""/><msg @l="1571" char_id="-1" frame_id="-1" name=""   text="亚季奈听到熊野的话后，露出惊恐的表情，开始认真地用舌尖在口腔内的那物上来回舔舐。" voices=""/><msg @l="1573" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯呼……嗯……嗯……嗯……嗯噗……啾。』" voices="akina01460"/><msg @l="1575" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯，呼啊……这，这样可以吗……？』" voices="akina01470"/><msg @l="1577" char_id="-1" frame_id="-1" name="熊野"   text="『对，很好……请继续。』" voices=""/><msg @l="1579" char_id="2" frame_id="-1" name="亚季奈"   text="『是，是的……啊姆……啾，啾……嗯，啾。』" voices="akina01480"/><msg @l="1581" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯，嗯咕……嗯噗，嗯噗，嗯噗……啾噗……嗯哈。』" voices="akina01490"/><msg @l="1583" char_id="-1" frame_id="-1" name=""   text="不知是因为害怕喉咙深处被顶到的恐惧感，还是出于想要贯彻对渡部的爱情的意志而顺从地任由摆布……"   voices=""/><msg @l="1584" char_id="-1" frame_id="-1" name=""   text="亚季奈一边观察着熊野的反应，一边拼命地吮吸着肉棒。" voices=""/><msg @l="1586" char_id="2" frame_id="-1" name="亚季奈"   text="『那个……这里……凹陷的地方要舔对吧？』" voices="akina01500"/><msg @l="1588" char_id="-1" frame_id="-1" name="熊野"   text="『对对，请好好舔啊。』" voices=""/><msg @l="1590" char_id="2" frame_id="-1" name="亚季奈"   text="『好的……啊，嗯姆……啾咯……啾咯……』" voices="akina01510"/><msg @l="1592" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯呼……嗯噗……啾姆，啾啪………汁噜噜。』" voices="akina01520"/><msg @l="1594" char_id="-1" frame_id="-1" name=""   text="起初生涩的舌头动作，在熊野的指导下渐渐变得流畅起来，不知不觉中，亚季奈的服务也变得更加积极主动了。"   voices=""/><msg @l="1596" char_id="-1" frame_id="-1" name="留学生" text="『喝啊啊啊，哦啊！』"   voices=""/><msg @l="1598" char_id="-1" frame_id="-1" name="留学生" text="『法克！法克！』"   voices=""/><msg @l="1600" char_id="-1" frame_id="-1" name=""   text="也许是因为感到被疏远，尽管亚季奈热心地继续着服侍，贯穿子宫口的留学生突然加快了腰部的动作。" voices=""/><msg @l="1602" char_id="2" frame_id="-1" name="亚季奈"   text="『唔嗯……嗯嗯嗯……呃嗯……呼啊！！』" voices="akina01530"/><msg @l="1604" char_id="-1" frame_id="-1" name=""   text="口腔被阴茎堵住的状态下，亚季奈在猛烈的律动中漏出了灼热的喘息。" voices=""/><msg @l="1605" char_id="-1" frame_id="-1" name=""   text="因呼吸困难和涌上的灼热疼痛而扭曲着表情，双眼中积蓄的泪水随着律动一滴滴落下。" voices=""/><msg @l="1607" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯啊……嗯，嗯嗯……噗嗯……嗯……嗯呜！！』" voices="akina01540"/><msg @l="1609" char_id="2" frame_id="-1" name="亚季奈"   text="『啊噗，呃嗯……嗯……呜嗯……啾噗！！』" voices="akina01550"/><msg @l="1611" char_id="-1" frame_id="-1" name=""   text="即使身体随着律动摇晃不已，亚季奈也没有试图吐出嘴里含着的肉棒。" voices=""/><msg @l="1612" char_id="-1" frame_id="-1" name=""   text="不知是在极力忠实地执行被命令的事情，还是。" voices=""/><msg @l="1613" char_id="-1" frame_id="-1" name=""   text="……已经，体会到了新的快感了吧。" voices=""/><msg @l="1615" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯，嗯，嗯……呼嗯……哈呼，嗯，嗯呜……。』" voices="akina01560"/><msg @l="1617" char_id="2" frame_id="-1" name="亚季奈"   text="『呣噗……啾呣……啾噗噗……嗯、呣噗……呣咕。』" voices="akina01570"/><msg @l="1619" char_id="-1" frame_id="-1" name="渡部" text="『哼……还挺灵巧嘛。』"   voices=""/><msg @l="1621" char_id="-1" frame_id="-1" name="渡部"   text="『怎么样亚季奈，这样做感觉也不错吧？』" voices=""/><msg @l="1623" char_id="2" frame_id="-1" name="亚季奈"   text="『呣噗……呼哈……嗯……哈、是的……。』" voices="akina01580"/><msg @l="1625" char_id="2" frame_id="-1" name="亚季奈"   text="『感、感觉……嗯嗯……很好……啊、呣咕！！』" voices="akina01590"/><msg @l="1627" char_id="-1" frame_id="-1" name=""   text="亚季奈带着无奈的表情回答道。" voices=""/><msg @l="1628" char_id="-1" frame_id="-1" name="" text="那是否是真心话已经无关紧要了。"   voices=""/><msg @l="1629" char_id="-1" frame_id="-1" name=""   text="如果展现越多淫荡姿态能让渡部满足的话，她别无选择。" voices=""/><msg @l="1630" char_id="-1" frame_id="-1" name="" text="已经无法回头了。"   voices=""/><msg @l="1632" char_id="-1" frame_id="-1" name="渡部"   text="『既然感觉不错就去让那两个人高潮吧。』" voices=""/><msg @l="1634" char_id="-1" frame_id="-1" name="渡部"   text="『这样的话，接下来就轮到我来搅拌你的小穴了。』" voices=""/><msg @l="1636" char_id="2" frame_id="-1" name="亚季奈"   text="『是、是的……啊呣……嗯、嗯咕……啾噗噗！！』" voices="akina01600"/><msg @l="1638" char_id="-1" frame_id="-1" name="熊野"   text="『哦哦……突然吸得更紧了呢？』" voices=""/><msg @l="1640" char_id="-1" frame_id="-1" name="留学生"   text="『哦、哦哦哦哦！哦买嘎、买嘎！！』" voices=""/><msg @l="1642" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯嗯……嗯呣……嗯呼……嗯、嗯、嗯嗯……。』" voices="akina01610"/><msg @l="1644" char_id="2" frame_id="-1" name="亚季奈"   text="『啾呣……嗯呜、嗯呣……嗯咕……嗯……嗯哈！！』" voices="akina01620"/><msg @l="1646" char_id="-1" frame_id="-1" name=""   text="房间里回荡着肉体碰撞的声音和从亚季奈身体发出的淫靡水声。" voices=""/><msg @l="1647" char_id="-1" frame_id="-1" name=""   text="溢出的热蜜被粗壮的肉棒搅拌的声音。" voices=""/><msg @l="1648" char_id="-1" frame_id="-1" name=""   text="口中积攒的唾液涂抹在肉柱上的声音。" voices=""/><msg @l="1650" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯呜呜……嗯哈………那个，还不射吗……？』" voices="akina01630"/><msg @l="1652" char_id="2" frame_id="-1" name="亚季奈"   text="『快点射出来……快点………嗯，嗯咕………啾噜噜！』" voices="akina01640"/><msg @l="1654" char_id="-1" frame_id="-1" name="" text="她大概是想尽快与渡部交合吧。"   voices=""/><msg @l="1655" char_id="-1" frame_id="-1" name=""   text="亚季奈吐出催促射精的话语，同时猛烈吮吸着眼前的肉柱。" voices=""/><msg @l="1657" char_id="-1" frame_id="-1" name="熊野"   text="『哦，哦哦哦……好啊，马上就给你射出来。』" voices=""/><msg @l="1659" char_id="-1" frame_id="-1" name="留学生" text="『哈哦哦哦！哦哦！』"   voices=""/><msg @l="1661" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯，嗯，嗯，嗯………嗯咕………哈呼，嗯噗！！』" voices="akina01650"/><msg @l="1663" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯咕……嗯噗，嗯噗…………嗯啾，啾噗噗噗！！』" voices="akina01660"/><msg @l="1665" char_id="-1" frame_id="-1" name="熊野" text="『要，要去了。』"   voices=""/><msg @l="1667" char_id="-1" frame_id="-1" name="留学生" text="『哦哦！呼呜呜！！』"   voices=""/><wait_chgmv/><ev @l="1671" src="ev-022x1y1y3z1z4"/><msg @l="1673" char_id="2" frame_id="-1" name="亚季奈" text="『嗯噗！！』"   voices="akina01670"/><msg @l="1675" char_id="-1" frame_id="-1" name=""   text="大量的精液注入了亚季奈的口腔和阴道。" voices=""/><msg @l="1676" char_id="-1" frame_id="-1" name=""   text="留学生一边发出无法成声的呻吟，一边多次紧贴着腰部，将热液注入子宫口更深处，直达子宫。" voices=""/><msg @l="1678" char_id="2" frame_id="-1" name="亚季奈" text="『嗯咕………嗯呼！！』"   voices="akina01680"/><msg @l="1680" char_id="-1" frame_id="-1" name=""   text="她一边因下腹部注入的热精液而颤抖着臀部，一边被喷射到喉咙深处的精液吓到，慌忙想将肉棒从口中拔出。"   voices=""/><msg @l="1682" char_id="-1" frame_id="-1" name="熊野"   text="『哎呀……不能吐出来哦，请好好喝下去。』" voices=""/><msg @l="1684" char_id="-1" frame_id="-1" name=""   text="熊野的手按住了亚季奈的头，使她无法吐出肉棒。" voices=""/><msg @l="1686" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯………嗯嗯…………嗯嗯………………。』" voices="akina01690"/><msg @l="1688" char_id="-1" frame_id="-1" name=""   text="似乎对吞咽精液有所抵触，亚季奈将射出的精液积存在口腔内。" voices=""/><msg @l="1689" char_id="-1" frame_id="-1" name=""   text="不过，熊野射出的精液量对亚季奈来说太多了，很快就到达极限，乳白色的液体从嘴角溢出。"   voices=""/><msg @l="1691" char_id="-1" frame_id="-1" name="熊野"   text="『没办法啊……剩下的就射在脸上吧。』" voices=""/><msg @l="1693" char_id="2" frame_id="-1" name="亚季奈" text="『嗯嗯！！』"   voices="akina01700"/><msg @l="1695" char_id="-1" frame_id="-1" name=""   text="从口腔抽出的肉棒，仿佛在说还不够似的跳动了几下，随即将大量白浊液喷洒在亚季奈的脸上。" voices=""/><msg @l="1697" char_id="2" frame_id="-1" name="亚季奈" text="『嗯呜………嗯嗯………………。』"   voices="akina01710"/><msg @l="1699" char_id="-1" frame_id="-1" name="" text="问题是，口腔里积存的精液。"   voices=""/><msg @l="1700" char_id="-1" frame_id="-1" name=""   text="亚季奈皱着眉头，闻着精液的腥臭味，仍然像是寻求指示一般，将视线投向渡部。" voices=""/><msg @l="1702" char_id="-1" frame_id="-1" name="渡部"   text="『刚才不是告诉你了吗？&#32;要好好把射出的精液吞下去。』" voices=""/><msg @l="1704" char_id="2" frame_id="-1" name="亚季奈" text="『嗯……。』"   voices="akina01720"/><msg @l="1706" char_id="-1" frame_id="-1" name=""   text="听到渡部冷酷的话语，她露出绝望的表情，慌乱地望着虚空。" voices=""/><msg @l="1707" char_id="-1" frame_id="-1" name=""   text="但是，无论怎么思考……答案已经注定。" voices=""/><msg @l="1709" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯………嗯咕………嗯咯，嗯咯，嗯咯…………。』" voices="akina01730"/><msg @l="1711" char_id="-1" frame_id="-1" name=""   text="亚季奈露出放弃的表情，咽下口腔内的精液。" voices=""/><msg @l="1712" char_id="-1" frame_id="-1" name=""   text="只是……果然还是不容易咽下去吧，亚季奈像是在与口中的那东西搏斗一般，喉咙发出声响持续了一阵。" voices=""/><clear @l="1718" class="all"/><wait_chgmv/><bg @l="1722" src="bg19b"/><msg @l="1724" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯，嗯，嗯……嗯哈……嗯……嗯咕……。』" voices="akina01740"/><msg @l="1726" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯咕……嗯哈…………哈……哈……。』" voices="akina01750"/><char @l="1730" id="watab" pos="auto" src="watabe010"/><msg @l="1732" char_id="-1" frame_id="-1" name="渡部" text="『怎么样，全部吞下去了吗？』"   voices=""/><msg @l="1734" char_id="2" frame_id="-1" name="亚季奈"   text="『是的……全部，都喝下去了……。』" voices="akina01760"/><msg @l="1736" char_id="-1" frame_id="-1" name=""   text="说着，亚季奈喘着粗气，张开嘴展示里面。" voices=""/><msg @l="1738" char_id="-1" frame_id="-1" name="渡部"   text="『那么，从上面这张嘴喝下去的牛奶好喝吗？』" voices=""/><msg @l="1740" char_id="2" frame_id="-1" name="亚季奈" text="『诶……那，那个是……。』"   voices="akina01770"/><msg @l="1742" char_id="-1" frame_id="-1" name="渡部" text="『好喝吗？』"   voices=""/><msg @l="1744" char_id="2" frame_id="-1" name="亚季奈" text="『……是的。』"   voices="akina01780"/><msg @l="1746" char_id="2" frame_id="-1" name="亚季奈"   text="『射在嘴里的牛奶……很好喝……………的。』" voices="akina01790"/><msg @l="1748" char_id="-1" frame_id="-1" name="渡部" text="『很好，真是乖孩子。』"   voices=""/><msg @l="1750" char_id="-1" frame_id="-1" name="渡部"   text="『那么按照约定，我会好好搅弄你的小穴。』" voices=""/><msg @l="1752" char_id="2" frame_id="-1" name="亚季奈" text="『嗯……老师，快来吧。』"   voices="akina01800"/><msg @l="1754" char_id="-1" frame_id="-1" name=""   text="亚季奈高兴地再次在榻榻米上摆出四肢着地的姿势，诱惑般地摇晃着臀部。" voices=""/><msg @l="1756" char_id="-1" frame_id="-1" name="留学生" text="『哦，拜托拜托』"   voices=""/><msg @l="1758" char_id="-1" frame_id="-1" name=""   text="留学生在亚季奈面前，挺出隆起的男根。" voices=""/><msg @l="1760" char_id="2" frame_id="-1" name="亚季奈"   text="『诶……现在，才刚刚射过……。』" voices="akina01810"/><msg @l="1762" char_id="-1" frame_id="-1" name="留学生" text="『没问题。』"   voices=""/><msg @l="1764" char_id="2" frame_id="-1" name="亚季奈"   text="『可是……好不容易能和老师做了……。』" voices="akina01820"/><msg @l="1766" char_id="-1" frame_id="-1" name="渡部"   text="『别这么说，用嘴帮他做吧。』" voices=""/><msg @l="1768" char_id="-1" frame_id="-1" name="渡部"   text="『那家伙是我邀请的客人，最大限度地款待他才是礼貌，不是吗？』" voices=""/><msg @l="1770" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯……如果老师这么说的话，我倒是无所谓……。』" voices="akina01830"/><msg @l="1772" char_id="-1" frame_id="-1" name="留学生" text="『哦，口交！』"   voices=""/><wait_chgmv/><ev @l="1776" src="ev-022y2y4z1z4"/><msg @l="1778" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯，啊啊……老师的肉棒……进来了呢。』" voices="akina01840"/><msg @l="1780" char_id="-1" frame_id="-1" name="渡部"   text="『虽然被别人的精液弄得黏糊糊的小穴让我有点不爽，不过偶尔这样也不错吧。』" voices=""/><msg @l="1782" char_id="-1" frame_id="-1" name=""   text="渡部边说着，边用力挺动腰部，仿佛在确认肉褶的感觉。" voices=""/><msg @l="1784" char_id="2" frame_id="-1" name="亚季奈"   text="『呜啊……这样，这么用力顶的话我马上就要去了……。』" voices="akina01850"/><msg @l="1786" char_id="-1" frame_id="-1" name="渡部"   text="『无所谓，你想去几次就去几次吧。』" voices=""/><msg @l="1788" char_id="2" frame_id="-1" name="亚季奈"   text="『怎么……嗯，呜呜……啊啊啊啊，呜啊！！』" voices="akina01860"/><msg @l="1790" char_id="-1" frame_id="-1" name=""   text="就这样，虽然嘴上说着否定的话，但亚季奈还是随着渡部腰部的动作，摇晃着自己的腰。" voices=""/><msg @l="1791" char_id="-1" frame_id="-1" name=""   text="比起之前被两个人侵犯时，她的动作明显更加积极。" voices=""/><msg @l="1793" char_id="-1" frame_id="-1" name="留学生" text="『哦，吸吸舔舔』"   voices=""/><msg @l="1795" char_id="-1" frame_id="-1" name=""   text="在被渡部的那物搅动而扭曲着表情的亚季奈嘴边，留学生那比他的肤色更深黑的巨大肉棒伸了过来。"   voices=""/><msg @l="1796" char_id="-1" frame_id="-1" name=""   text="尽管刚才才射精过，留学生的那物却以比射精前更高的角度和硬度耸立着。" voices=""/><msg @l="1798" char_id="2" frame_id="-1" name="亚季奈" text="『嗯，好的……。』"   voices="akina01870"/><msg @l="1800" char_id="2" frame_id="-1" name="亚季奈"   text="『啊呜……嗯，唔……啾。』" voices="akina01880"/><msg @l="1802" char_id="-1" frame_id="-1" name=""   text="亚季奈一瞬间露出厌恶的表情看了它一眼，然后一副无可奈何的样子把它含进了口中。" voices=""/><msg @l="1804" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯……呜……啾……嗯，啾……。』" voices="akina01890"/><msg @l="1806" char_id="2" frame_id="-1" name="亚季奈"   text="『呜咕、嗯、嗯、嗯……啾呣……嗯、呜咕……。』" voices="akina01900"/><msg @l="1808" char_id="-1" frame_id="-1" name=""   text="深入，浅出……亚季奈含着肉棒吐出。" voices=""/><msg @l="1809" char_id="-1" frame_id="-1" name=""   text="比起含着熊野那物的时候，她已经熟练了许多。" voices=""/><msg @l="1810" char_id="-1" frame_id="-1" name=""   text="不过与其说是技术提高，不如说是情感麻木所致。" voices=""/><msg @l="1812" char_id="-1" frame_id="-1" name="渡部"   text="『再来，再仔细地舔。』" voices=""/><msg @l="1814" char_id="-1" frame_id="-1" name=""   text="一边慢慢摩擦着亚季奈的肉穴，渡部愉快地笑着。" voices=""/><msg @l="1816" char_id="2" frame_id="-1" name="亚季奈" text="『嗯哈……好、好的……。』"   voices="akina01910"/><msg @l="1818" char_id="2" frame_id="-1" name="亚季奈"   text="『啾噗、嗯、嗯、嗯……嗯呼……嗯、啾噗噗。』" voices="akina01920"/><msg @l="1820" char_id="-1" frame_id="-1" name=""   text="遵循渡部的话，亚季奈慢慢地仔细地舔舐着整根肉棒。" voices=""/><msg @l="1821" char_id="-1" frame_id="-1" name=""   text="虽然没有急促的激烈感，但她那粘腻缠绵的方式却相当巧妙。" voices=""/><msg @l="1823" char_id="-1" frame_id="-1" name="留学生"   text="『喔哦，真，棒啊……喔呜。』" voices=""/><msg @l="1825" char_id="-1" frame_id="-1" name="渡部" text="『不错嘛，亚季奈。』"   voices=""/><msg @l="1827" char_id="-1" frame_id="-1" name="渡部"   text="『既然得到了表扬，就要好好地服侍才行啊？』" voices=""/><msg @l="1829" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯呼……嗯…嗯呜……啾噗，啾噗，啾噗……。』" voices="akina01930"/><msg @l="1831" char_id="-1" frame_id="-1" name=""   text="虽然对留学生的称赞毫无反应，但听到渡部的话，亚季奈却高兴地发出了喉音。" voices=""/><msg @l="1833" char_id="-1" frame_id="-1" name="渡部"   text="『很好，就这样继续吮吸吧。』" voices=""/><msg @l="1835" char_id="-1" frame_id="-1" name=""   text="渡部满意地注视着含着勃起之物的亚季奈，同时将腰部的韵律变得更加强烈激烈。" voices=""/><msg @l="1836" char_id="-1" frame_id="-1" name=""   text="顿时，亚季奈的蜜壶中渗出了滚烫的淫液，顺着晒得黝黑的纤细大腿滑落。" voices=""/><msg @l="1838" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯嗯……嗯，嗯，嗯，嗯呜！！』" voices="akina01940"/><msg @l="1840" char_id="2" frame_id="-1" name="亚季奈"   text="『呼哈，嗯……嗯咕……嗯噗，嗯噗……嗯咕！！』" voices="akina01950"/><msg @l="1842" char_id="-1" frame_id="-1" name=""   text="随着渡部的律动，亚季奈娇小的身体前后晃动，被推向前方的亚季奈被半强制地将硬物吞入喉咙深处，也就是所谓的深喉。"   voices=""/><msg @l="1844" char_id="-1" frame_id="-1" name="留学生"   text="『哦，哦啊哦……哦呼，呼哦。』" voices=""/><msg @l="1846" char_id="-1" frame_id="-1" name=""   text="他似乎相当喜欢这种半强制的深喉。" voices=""/><msg @l="1847" char_id="-1" frame_id="-1" name=""   text="每当肉柱的顶端摩擦喉咙深处的壁面时，留学生都会边颤抖腰部边发出欢愉的声音。" voices=""/><msg @l="1849" char_id="-1" frame_id="-1" name="渡部"   text="『仅仅一天就掌握了口交和深喉技巧，不愧是淫乱的母狗，层次就是不一样。』" voices=""/><msg @l="1851" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯，嗯嗯……我，我才不是……那种东西。』" voices="akina01960"/><msg @l="1854" char_id="-1" frame_id="-1" name="渡部"   text="『不，你就是淫乱的母狗……对吧！？』" voices=""/><msg @l="1856" char_id="2" frame_id="-1" name="亚季奈" text="『嗯，噗啊！？』"   voices="akina01970"/><msg @l="1858" char_id="-1" frame_id="-1" name=""   text="渡部猛地挺入腰部的瞬间，亚季奈吐出含着的肉块，全身颤抖起来。" voices=""/><msg @l="1859" char_id="-1" frame_id="-1" name=""   text="只是一次挺入，她似乎就达到了高潮。" voices=""/><msg @l="1861" char_id="-1" frame_id="-1" name="渡部"   text="『怎么样，光是这样就高潮的家伙不就是淫乱的母狗吗？』" voices=""/><msg @l="1863" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯呜……不……不是……不是的……』" voices="akina01980"/><msg @l="1865" char_id="2" frame_id="-1" name="亚季奈"   text="『这是因为是老师，是因为是老师的肉棒才这样的……』" voices="akina01990"/><msg @l="1867" char_id="-1" frame_id="-1" name="渡部" text="『哦？那真遗憾啊。』"   voices=""/><msg @l="1869" char_id="-1" frame_id="-1" name="渡部"   text="『我啊，最喜欢那种不管被谁的鸡巴插入都能淫荡地疯狂呻吟的母狗了。』" voices=""/><msg @l="1871" char_id="-1" frame_id="-1" name=""   text="说着，渡部试图将插入阴道内的勃起抽出来。" voices=""/><msg @l="1873" char_id="2" frame_id="-1" name="亚季奈" text="『啊……不要，不可以拔出来！』"   voices="akina02000"/><msg @l="1875" char_id="-1" frame_id="-1" name="渡部"   text="『你不是淫乱的母狗吧？』" voices=""/><msg @l="1877" char_id="-1" frame_id="-1" name="渡部"   text="『那就没有继续做下去的意义了。我对那些叽叽喳喳谈什么爱啊情啊的小屁孩没兴趣。』" voices=""/><msg @l="1879" char_id="-1" frame_id="-1" name=""   text="于是渡部完全从亚季奈的秘缝中抽出了肉棒。" voices=""/><msg @l="1881" char_id="2" frame_id="-1" name="亚季奈"   text="『怎、怎么这样……我……我是……。』" voices="akina02010"/><msg @l="1883" char_id="-1" frame_id="-1" name="渡部" text="『我是？什么？』"   voices=""/><msg @l="1885" char_id="-1" frame_id="-1" name=""   text="渡部在她耳边低语着，同时用龟头在她秘部的入口处来回挑逗。" voices=""/><msg @l="1886" char_id="-1" frame_id="-1" name=""   text="亚季奈突出腰部，试图用自己的秘贝吞入那根东西，但每次渡部都会往后撤腰逃开，只是在挑逗她而已。"   voices=""/><msg @l="1888" char_id="2" frame_id="-1" name="亚季奈" text="『……。』"   voices="akina02020"/><msg @l="1890" char_id="-1" frame_id="-1" name="渡部"   text="『怎么了？这家伙只专属于淫乱的母狗。我只会插进那种货色里哦？』" voices=""/><msg @l="1892" char_id="2" frame_id="-1" name="亚季奈" text="『我是……。』"   voices="akina02030"/><msg @l="1894" char_id="2" frame_id="-1" name="亚季奈"   text="『我是……淫乱的、母狗……啊。』" voices="akina02040"/><msg @l="1896" char_id="-1" frame_id="-1" name="渡部"   text="『哦，你是那种不管被谁的鸡巴插入都会淫荡呻吟的骚货吧？』" voices=""/><msg @l="1898" char_id="2" frame_id="-1" name="亚季奈"   text="『是、是的……我是那种不管被谁的肉棒插入都会有感觉的淫乱女。』" voices="akina02050"/><msg @l="1900" char_id="-1" frame_id="-1" name="渡部"   text="『也就是说，你是那种能够随便含住除了我以外的鸡巴，一条母狗，对吧？』" voices=""/><msg @l="1902" char_id="2" frame_id="-1" name="亚季奈" text="『是……的……。』"   voices="akina02060"/><msg @l="1904" char_id="2" frame_id="-1" name="亚季奈"   text="『我是，能够随便含住任何人的肉棒的母狗……。』" voices="akina02070"/><msg @l="1906" char_id="2" frame_id="-1" name="亚季奈"   text="『所以，请快点把肉棒……插进来。』" voices="akina02080"/><msg @l="1908" char_id="2" frame_id="-1" name="亚季奈"   text="『我已经忍不住了……请把硬硬的肉棒插到最深处！！』" voices="akina02090"/><msg @l="1910" char_id="-1" frame_id="-1" name="渡部"   text="『哈哈，这才是我看中的女人！』" voices=""/><msg @l="1912" char_id="2" frame_id="-1" name="亚季奈" text="『呃啊啊！！』"   voices="akina02100"/><msg @l="1914" char_id="-1" frame_id="-1" name=""   text="一下子，硬挺的肉茎贯穿了亚季奈的秘所。" voices=""/><msg @l="1915" char_id="-1" frame_id="-1" name=""   text="亚季奈因为阴肉被撑开的感觉而发出欢喜的声音，腰部剧烈地颤抖着。" voices=""/><msg @l="1917" char_id="-1" frame_id="-1" name="渡部"   text="『不错，像个母狗一样扭动腰部，尽情地呻吟吧。』" voices=""/><msg @l="1919" char_id="2" frame_id="-1" name="亚季奈"   text="『是、是的……啊、啊、啊、嗯嗯、嗯啊！！』" voices="akina02110"/><msg @l="1921" char_id="-1" frame_id="-1" name="留学生" text="『哦哦、哦、哦啊啊。』"   voices=""/><msg @l="1923" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯呜……嗯咕………嗯、嗯嗯……啾噜噜！！』" voices="akina02120"/><msg @l="1925" char_id="-1" frame_id="-1" name=""   text="尽管身体因为在淫荡的阴道内肆虐的肉棒而颤抖，亚季奈仍然用舌尖缠绕着嘴里插入的龟头吮吸着。" voices=""/><msg @l="1927" char_id="-1" frame_id="-1" name="熊野" text="『……堕落了啊。』"   voices=""/><msg @l="1929" char_id="-1" frame_id="-1" name=""   text="看着亚季奈吸附在肉茎顶端的样子，熊野轻声说道。" voices=""/><msg @l="1930" char_id="-1" frame_id="-1" name=""   text="然而……那些话已经无法传达到亚季奈的心中了。" voices=""/><msg @l="1932" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯、嗯、嗯……嗯呼……嗯呼……嗯咕……。』" voices="akina02130"/><msg @l="1934" char_id="2" frame_id="-1" name="亚季奈"   text="『啾噗、啾噗、啾噗……嗯……嗯噗………嗯哈！！』" voices="akina02140"/><msg @l="1936" char_id="-1" frame_id="-1" name="渡部"   text="『好啊，就这样射在最里面给你。』" voices=""/><msg @l="1938" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯、嗯嗯、嗯咕……嗯哈……。』" voices="akina02150"/><msg @l="1940" char_id="2" frame_id="-1" name="亚季奈"   text="『啊啊……啊……我也要、去了……嗯、嗯咕！！』" voices="akina02160"/><msg @l="1942" char_id="-1" frame_id="-1" name="留学生"   text="『哦呜、啊、啊哦、咕噜咕噜』" voices=""/><msg @l="1944" char_id="-1" frame_id="-1" name=""   text="留学生牢牢按住亚季奈的头，激烈地撞击着腰部。" voices=""/><msg @l="1945" char_id="-1" frame_id="-1" name=""   text="尽管痛苦地皱起眉头，亚季奈仍然用喉咙深处接受着它，同时因快感的浪潮而颤抖着腰部。" voices=""/><msg @l="1947" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯咕……嗯呼、嗯、嗯、嗯、嗯嗯！！』" voices="akina02170"/><msg @l="1949" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯啊啊……不行……要去了、嗯呼、嗯、嗯咕呜！！』" voices="akina02180"/><msg @l="1951" char_id="-1" frame_id="-1" name="渡部" text="『要射了！！』"   voices=""/><msg @l="1953" char_id="-1" frame_id="-1" name="留学生"   text="『嗯哦啊！哦啊、哦啊啊啊啊啊啊！！』" voices=""/><msg @l="1955" char_id="2" frame_id="-1" name="亚季奈" text="『嗯、嗯嗯嗯嗯嗯！！！』"   voices="akina02190"/><flash @l="1959" count="4" fade="100" image="white"/><wait_chgmv/><ev @l="1964" src="ev-022x1y2y4z1z4z2z5"/><msg @l="1966" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯啊……嗯、嗯咕………嗯库………嗯库………。』" voices="akina02200"/><msg @l="1968" char_id="-1" frame_id="-1" name=""   text="亚季奈不用被命令就已经开始吞咽喉咙深处被射入的大量精液。" voices=""/><msg @l="1969" char_id="-1" frame_id="-1" name="" text="她的这个动作毫不犹豫。"   voices=""/><msg @l="1971" char_id="-1" frame_id="-1" name="渡部"   text="『哦哦，感觉要被榨干了……。』" voices=""/><msg @l="1973" char_id="-1" frame_id="-1" name=""   text="渡部一边向亚季奈小小的子宫里注入滚烫的精液，一边因阴道壁紧紧挤压着肉棒的淫荡动作而愉悦地歪着嘴角。"   voices=""/><msg @l="1983" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯………呼啊………哈啊，哈啊，哈啊，哈啊………。』" voices="akina02210"/><msg @l="1985" char_id="-1" frame_id="-1" name=""   text="亚季奈吞下了全部榨取的精液后，疲惫地吐出肉块的顶端，一边摇晃着肩膀一边急促地呼吸着。"   voices=""/><msg @l="1986" char_id="-1" frame_id="-1" name=""   text="她的眼神有些空洞……略微黯淡。" voices=""/><msg @l="1988" char_id="-1" frame_id="-1" name="渡部"   text="『亚季奈，用嘴抽出后，把里面剩下的东西也一滴不剩地吸出来，这才是母狗的职责哦？』" voices=""/><msg @l="1990" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯，好的………啊呜……嗯，啾噗……啾噗噗………。』" voices="akina02220"/><msg @l="1992" char_id="-1" frame_id="-1" name=""   text="再次，亚季奈含住了眼前已半疲软的黑色肉茎。" voices=""/><msg @l="1993" char_id="-1" frame_id="-1" name=""   text="她一边啧啧地吮吸着肉棒，一边缓缓地吸取着深处残留的精液。" voices=""/><msg @l="1995" char_id="-1" frame_id="-1" name="留学生" text="『哦、哦哦哦，不、不要。』"   voices=""/><msg @l="1997" char_id="-1" frame_id="-1" name="渡部"   text="『别客气。再次使用这家伙去发泄就好。』" voices=""/><msg @l="1999" char_id="-1" frame_id="-1" name="渡部"   text="『对吧？母狗。』" voices=""/><msg @l="2001" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯啊……是的，我是淫乱的母狗……。』" voices="akina02230"/><msg @l="2003" char_id="2" frame_id="-1" name="亚季奈"   text="『请……在我身体里灌注大量滚烫的牛奶。』" voices="akina02240"/><msg @l="2005" char_id="-1" frame_id="-1" name="留学生" text="『哦哦，耶耶耶斯！』"   voices=""/><msg @l="2007" char_id="2" frame_id="-1" name="亚季奈" text="『嗯嗯！！』"   voices="akina02250"/><msg @l="2009" char_id="-1" frame_id="-1" name=""   text="留学生说完，绕到亚季奈背后，将已经硬挺的巨炮插了进去。" voices=""/><msg @l="2010" char_id="-1" frame_id="-1" name=""   text="亚季奈用溢出着精液的秘缝接纳着，漏出了充满热度的喘息。" voices=""/><msg @l="2012" char_id="-1" frame_id="-1" name="渡部"   text="『你也要加入吗？还能继续吧？』" voices=""/><msg @l="2014" char_id="-1" frame_id="-1" name="熊野"   text="『是啊……那么，再让她的上面这张嘴喝一次如何。』" voices=""/><wait_chgmv/><ev @l="2018" src="ev-022x1y1y3z1z4z2z5"/><msg @l="2020" char_id="2" frame_id="-1" name="亚季奈"   text="『唔唔……嗯，咕……嗯，嗯，嗯，啊啊！！』" voices="akina02260"/><msg @l="2022" char_id="-1" frame_id="-1" name=""   text="第三次，亚季奈的口腔和秘部被坚硬的肉块堵住。" voices=""/><msg @l="2023" char_id="-1" frame_id="-1" name=""   text="她那依旧因厌恶而扭曲的表情看起来很痛苦，但与这表情相反的是她积极的舌头动作和腰部摆动，让人感到一丝滑稽。"   voices=""/><msg @l="2024" char_id="-1" frame_id="-1" name=""   text="渡部注视着被两个男人侵犯而扭动呻吟的亚季奈，同时慢慢回想起自己真正想要得到的那个女人。" voices=""/><msg @l="2026" char_id="-1" frame_id="-1" name="渡部"   text="『我要让你后悔到极点……后悔从我身边逃走。』" voices=""/><msg @l="2028" char_id="-1" frame_id="-1" name=""   text="他自言自语地低声说着，用蔑视的眼神看向亚季奈。" voices=""/><msg @l="2030" char_id="2" frame_id="-1" name="亚季奈"   text="『啊啊啊……唔，啾，啾噜……嗯，咕呜！！』" voices="akina02270"/><msg @l="2032" char_id="2" frame_id="-1" name="亚季奈"   text="『哈呼……嗯噗，嗯噗，嗯噗，咕噜噜噜！！』" voices="akina02280"/><msg @l="2034" char_id="-1" frame_id="-1" name=""   text="她配合着在阴道内搅动的巨棒的动作扭动着腰，用舌头缠绕着插入口中的肉物。" voices=""/><msg @l="2035" char_id="-1" frame_id="-1" name=""   text="小小的阴道被黑色巨大的肉块搅动着，她吮吸着从肉棒前端渗出的液体并吞咽下去。" voices=""/><msg @l="2036" char_id="-1" frame_id="-1" name=""   text="一只淫乱的母狗……已经在那里形成了。" voices=""/><msg @l="2038" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯呼……嗯，啊呼……啊，啊，啊，嗯库！！』" voices="akina02290"/><msg @l="2040" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯噗，嗯，嗯……啊……不行，要去了！！』" voices="akina02300"/><msg @l="2042" char_id="-1" frame_id="-1" name="熊野"   text="『来，我要射在你嘴里了。』" voices=""/><msg @l="2044" char_id="-1" frame_id="-1" name="留学生" text="『哦，上帝啊！』"   voices=""/><msg @l="2046" char_id="2" frame_id="-1" name="亚季奈"   text="『啊呼，嗯，嗯，嗯，呼啊……嗯，啾噜噜！！』" voices="akina02310"/><msg @l="2048" char_id="-1" frame_id="-1" name="熊野" text="『咕！！』" voices=""/><msg @l="2050" char_id="-1" frame_id="-1" name="留学生" text="『啊哦哦，哦啊啊！！』"   voices=""/><flash @l="2054" count="4" fade="100" image="white"/><wait_chgmv/><ev @l="2058" src="ev-022x1y1y3z1z4z2z5z3z6"/><msg @l="2060" char_id="2" frame_id="-1" name="亚季奈" text="『嗯姆呜呜！！』"   voices="akina02320"/><msg @l="2062" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯呜……嗯，嗯嗯……嗯咕，嗯库，嗯库……。』" voices="akina02330"/><msg @l="2064" char_id="-1" frame_id="-1" name="" text="第三次精液射入了她的口中和子宫。"   voices=""/><msg @l="2065" char_id="-1" frame_id="-1" name=""   text="亚季奈脸上虽然显露着厌恶，内心却怀着某种不同的感情，慢慢地仿佛在品尝般地吞咽下去。" voices=""/><msg @l="2067" char_id="2" frame_id="-1" name="亚季奈"   text="『啊呼……嗯，哈呼……嗯普，啾噗……啾噜噜。』" voices="akina02340"/><msg @l="2069" char_id="-1" frame_id="-1" name=""   text="她吞下了所有射出的精液，没有人吩咐就自行吸取尿道里残留的种子。" voices=""/><msg @l="2070" char_id="-1" frame_id="-1" name=""   text="当没有剩余的液体可以吞咽时，她开始用舌头舔舐地板上溢出的大量精液。" voices=""/><msg @l="2071" char_id="-1" frame_id="-1" name="" text="就像一只真正的狗一样……。"   voices=""/><clear @l="2077" class="all"/><end_scene @l="2080"/><wait_chgmv/><bg @l="2084" src="bg20b"/><char @l="2088" id="watab" pos="auto" src="watabe010"/><msg @l="2090" char_id="-1" frame_id="-1" name="渡部" text="『真不错啊，亚季奈。』"   voices=""/><msg @l="2092" char_id="-1" frame_id="-1" name="渡部"   text="『这样一来你也正式成为了一只母狗的同伴。』" voices=""/><msg @l="2094" char_id="-1" frame_id="-1" name=""   text="渡部像是自言自语般吐出这些话，没有特定的对象。" voices=""/><msg @l="2095" char_id="-1" frame_id="-1" name=""   text="从渡部背后，传来了亚季奈第四次的娇声。" voices=""/><msg @l="2096" char_id="-1" frame_id="-1" name=""   text="留学生的精力似乎无穷无尽，熊野也不厌其烦地继续用嘴服务着。" voices=""/><msg @l="2097" char_id="-1" frame_id="-1" name=""   text="直到天亮前，亚季奈还要被浇灌多少次精液呢……。" voices=""/><stopbgm @l="2102" fadeout="1000"/><clear @l="2108" class="all"/><call @l="2112" target="EventLabel_42@ending04"/><return @l="2113" value="0&#13;&#10;"/><return @l="2119" value=""/></code></xscript>																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																	