<?xml version="1.0" encoding="utf-8"?><xscript><debug editor="&quot;C:\Program&#32;Files&#32;(x86)\sakura\sakura.exe&quot;&#32;&quot;%src%&quot;&#32;-Y=%line%"   src="D:\シロップ\町ぐるみの罠＋汚された夏セット版\汚された夏\完成データ\汚された夏\script\text\root_akina_c_ev01.txt"/><code><label @l="13" id="EventLabel_82"/><label @l="16" id="event_scene50"/><wait_chgmv/><bg @l="20" src="bg11"/><bgm @l="24" src="bgm10" volume="1."/><description @l="27" text="回忆过往"/><msg @l="29" char_id="0" frame_id="-1" name="美帆" text="『嗯啊……痛……。』"   voices="miho01820"/><msg @l="31" char_id="-1" frame_id="-1" name="" text="一阵尖锐的疼痛从下腹部窜上来。"   voices=""/><msg @l="32" char_id="-1" frame_id="-1" name=""   text="我陷入黑暗的意识被强行拉回了明亮的世界。" voices=""/><msg @l="33" char_id="-1" frame_id="-1" name="" text="感觉头痛得像是敲打着破裂的钟。"   voices=""/><msg @l="34" char_id="-1" frame_id="-1" name="" text="而且……，" voices=""/><msg @l="35" char_id="-1" frame_id="-1" name="" text="全身异常沉重……。"   voices=""/><msg @l="37" char_id="-1" frame_id="-1" name="声音" text="『哎呀，看来您醒了啊。』"   voices=""/><msg @l="38" char_id="-1" frame_id="-1" name=""   text="那声音粘腻得像是喉咙深处有痰……。" voices=""/><msg @l="39" char_id="-1" frame_id="-1" name=""   text="在我浑浊的耳朵听来十分不悦的声音，让我开始思考确认当前的状况。" voices=""/><msg @l="41" char_id="0" frame_id="-1" name="美帆" text="『咦……我……？』"   voices="miho01830"/><msg @l="43" char_id="-1" frame_id="-1" name="声音"   text="『因为不想引起骚动……，所以趁你休息的时候，就开始了……。』" voices=""/><msg @l="45" char_id="0" frame_id="-1" name="美帆" text="『啊……？』"   voices="miho01840"/><wait_chgmv/><ev @l="49" src="ev-050y1"/><bgm @l="52" src="bgm14" volume="1."/><msg @l="54" char_id="0" frame_id="-1" name="美帆" text="『啊，唔咕！？』"   voices="miho01850"/><msg @l="56" char_id="-1" frame_id="-1" name=""   text="我慌忙想要支起上半身，这时终于明白了那促使我意识清醒的下腹部疼痛的含义。" voices=""/><msg @l="57" char_id="-1" frame_id="-1" name="" text="在我身体的最深处……，"   voices=""/><msg @l="58" char_id="-1" frame_id="-1" name=""   text="渡部那凶暴的硬物，正深深地插入其中……。" voices=""/><msg @l="60" char_id="0" frame_id="-1" name="美帆"   text="『这是什么，为什么……啊咕！！』" voices="miho01860"/><msg @l="62" char_id="-1" frame_id="-1" name="熊野"   text="『哎呀哎呀……您想去哪儿呢？』" voices=""/><msg @l="64" char_id="-1" frame_id="-1" name=""   text="就在我想要后退的瞬间，那个叫熊野的勤杂工，按住了我的身体。" voices=""/><msg @l="65" char_id="-1" frame_id="-1" name=""   text="虽然熊野只是浮现出一丝浅笑，我却完全动弹不得了。" voices=""/><msg @l="66" char_id="-1" frame_id="-1" name=""   text="阻止我后退的力量之强，从他那看似脆弱的外表，完全无法想象。" voices=""/><msg @l="68" char_id="0" frame_id="-1" name="美帆" text="『呀……放，放开我！』"   voices="miho01870"/><msg @l="70" char_id="-1" frame_id="-1" name="渡部"   text="『你在干什么，像个小婴儿似的？……你已经尝过男人的滋味了……现在想逃已经没用了吧。』"   voices=""/><msg @l="72" char_id="0" frame_id="-1" name="美帆" text="『这种事……唔！！』"   voices="miho01880"/><msg @l="74" char_id="-1" frame_id="-1" name="" text="渡部突然猛烈地撞击起腰部。"   voices=""/><msg @l="75" char_id="-1" frame_id="-1" name=""   text="那粗大的肉刃随着动作凶暴地深深贯穿我的身体。" voices=""/><msg @l="76" char_id="-1" frame_id="-1" name=""   text="刚刚破瓜的伤口被渡部的凶器摩擦，再次有如被撕裂般的剧痛袭来。" voices=""/><msg @l="78" char_id="-1" frame_id="-1" name="渡部"   text="『这是三年来的相思吧？……让你久等了，我会好好让你享受的，高兴点吧……。』"   voices=""/><msg @l="79" char_id="-1" frame_id="-1" name=""   text="渡部一边说着自己臆想出的故事，一边猛烈地顶弄着我的身体。" voices=""/><msg @l="81" char_id="0" frame_id="-1" name="美帆"   text="『啊啊……嗯、唔唔……不、啊啊！！』" voices="miho01890"/><msg @l="83" char_id="-1" frame_id="-1" name=""   text="每当渡部这样搅动我受伤的子宫，疼痛和耻辱就会灼热地染遍我的全身。" voices=""/><msg @l="84" char_id="-1" frame_id="-1" name=""   text="在无力抗拒的屈辱中，一股与绝望截然不同的奇怪热感从我体内深处涌了上来。" voices=""/><msg @l="85" char_id="-1" frame_id="-1" name=""   text="阴道内的伤口，因被粗暴对待而变得灼热……" voices=""/><msg @l="87" char_id="-1" frame_id="-1" name="" text="我拼命地这样想着……"   voices=""/><msg @l="88" char_id="-1" frame_id="-1" name=""   text="却开始感觉到，这奇怪的燥热，与我想象的并不相同……" voices=""/><msg @l="90" char_id="0" frame_id="-1" name="美帆"   text="『不……这是什么……有种、奇怪的感觉……』" voices="miho01900"/><msg @l="92" char_id="-1" frame_id="-1" name="熊野"   text="『啊啊，看来药终于开始发挥作用了。』" voices=""/><msg @l="94" char_id="0" frame_id="-1" name="美帆" text="『药……难道……』"   voices="miho01910"/><msg @l="96" char_id="-1" frame_id="-1" name="渡部"   text="『呵呵……感觉很爽吧，你……正如我想象的那样，答对了。只找亚季奈不公平吧？我也给你用了同样的东西哦？』"   voices=""/><goto @l="99" cond="!(f.留学生に抵抗したflag&#32;==&#32;1)&#13;&#10;"   label="TempLabel_216"/><msg @l="101" char_id="-1" frame_id="-1" name=""   text="熊野的表情看起来好像很满意……" voices=""/><msg @l="102" char_id="-1" frame_id="-1" name=""   text="渡部的语气听起来好像很愉悦……" voices=""/><msg @l="103" char_id="-1" frame_id="-1" name=""   text="就这样，我明白了自己体内涌起的异样兴奋是什么。" voices=""/><msg @l="104" char_id="-1" frame_id="-1" name=""   text="让我感到那种飘飘然的热感的东西是……" voices=""/><msg @l="105" char_id="-1" frame_id="-1" name=""   text="大概是……渡部对亚季奈使用的……那种药。" voices=""/><msg @l="106" char_id="-1" frame_id="-1" name=""   text="那个让亚季奈变成那样的疯狂产物也对我……" voices=""/><msg @l="110" char_id="-1" frame_id="-1" name="渡部"   text="『子宫被捅破了也能高潮不断，这可是高性能产品哦？』" voices=""/><msg @l="112" char_id="0" frame_id="-1" name="美帆" text="『怎么会……太过分了……』"   voices="miho01920"/><msg @l="114" char_id="-1" frame_id="-1" name="渡部"   text="『你是不是日语说错了？……应该说“谢谢”啊。你也比起疼痛更喜欢舒服的感觉吧？感谢这种事啊……在该表达的时候好好表达，这才是日本人的美德吧……对吧？』"   voices=""/><msg @l="115" char_id="-1" frame_id="-1" name=""   text="渡部说着这些只能让人彻底无语的话，夸张地哈哈大笑起来。" voices=""/><msg @l="117" char_id="-1" frame_id="-1" name="渡部"   text="『而且啊……如果不用药，你可能会痛得直冒汗哦？我可是喜欢重口味的。』" voices=""/><msg @l="119" char_id="0" frame_id="-1" name="美帆" text="『……。』"   voices="miho01930"/><goto @l="122" label="TempLabel_217"/><label @l="123" id="TempLabel_216"/><msg @l="126" char_id="-1" frame_id="-1" name="熊野"   text="『这不是麻药，请放心。』" voices=""/><msg @l="127" char_id="-1" frame_id="-1" name=""   text="在我失语的一旁，熊野带着讽刺意味的假装礼貌地插嘴道。" voices=""/><msg @l="129" char_id="-1" frame_id="-1" name="熊野"   text="『虽然确实是某种药物的副产品……但只是效果太强，不能作为商品销售而已。』"   voices=""/><msg @l="131" char_id="0" frame_id="-1" name="美帆" text="『做这种事……太过分了……』"   voices="miho01940"/><msg @l="133" char_id="-1" frame_id="-1" name="熊野"   text="『过分？……别在意嘛……这里本来就是这样的地方……你不也成为了这里的居民吗？……入乡随俗才是有理性的成年人应有的做法吧？』"   voices=""/><msg @l="135" char_id="0" frame_id="-1" name="美帆" text="『啊……』"   voices="miho01950"/><label @l="138" id="TempLabel_217"/><msg @l="141" char_id="-1" frame_id="-1" name="渡部"   text="『啊，这些细节有什么关系呢。反正我们现在这样，能尽情享用彼此的身体不是很好吗……』"   voices=""/><msg @l="143" char_id="-1" frame_id="-1" name=""   text="渡部对熊野的微笑感到厌烦似的皱了皱眉，猛烈地律动起腰部。" voices=""/><msg @l="144" char_id="-1" frame_id="-1" name=""   text="熊野的话在我脑海中一瞬间闪过，但渡部带来的狂野性欲，轻易地将这一切都冲刷得无影无踪。" voices=""/><msg @l="145" char_id="-1" frame_id="-1" name=""   text="我的意识集中在被渡部大力撑开，毫无反抗之力被蹂躏的那个部位。" voices=""/><msg @l="147" char_id="0" frame_id="-1" name="美帆"   text="『啊，嗯，嗯，嗯……呃啊！！』" voices="miho01960"/><msg @l="149" char_id="0" frame_id="-1" name="美帆"   text="(明明很讨厌……我……明明很讨厌这种事，为什么……)" voices="miho01970"/><msg @l="151" char_id="-1" frame_id="-1" name=""   text="仿佛身体从内部被撕裂的尖锐疼痛，在结合部的深处反复袭来。" voices=""/><msg @l="152" char_id="-1" frame_id="-1" name="" text="可是……"   voices=""/><msg @l="153" char_id="-1" frame_id="-1" name=""   text="疼痛随着渡部每一次律动逐渐变淡……" voices=""/><msg @l="154" char_id="-1" frame_id="-1" name="" text="感觉正在变得模糊不清。"   voices=""/><msg @l="155" char_id="-1" frame_id="-1" name=""   text="除了被侵入深处的疼痛之外，一种“不明正体的炽热感”正在取代我的痛苦……" voices=""/><msg @l="156" char_id="-1" frame_id="-1" name="" text="……真不甘心……"   voices=""/><msg @l="157" char_id="-1" frame_id="-1" name=""   text="渡部那赤裸裸的征服欲望，将他粗俗的情欲，开始染上我内心深处那粘稠的樱色。" voices=""/><msg @l="158" char_id="-1" frame_id="-1" name=""   text="明明是被蹂躏着的身体，却开始违背我意志地做出反应，这让我感到恶心，不禁落泪。" voices=""/><msg @l="160" char_id="-1" frame_id="-1" name="渡部"   text="『不愧是直到刚才还带着处女膜啊……』" voices=""/><msg @l="162" char_id="-1" frame_id="-1" name="渡部"   text="『每次插入……都紧紧缠住啊？……你也能听到这黏糊糊的声音吧？』" voices=""/><msg @l="164" char_id="0" frame_id="-1" name="美帆"   text="『呜啊……请，请停下……这种……』" voices="miho01980"/><msg @l="166" char_id="0" frame_id="-1" name="美帆"   text="『嗯……呃啊……啊……啊……啊……啊……』" voices="miho01990"/><msg @l="168" char_id="-1" frame_id="-1" name="渡部"   text="『哦哦，发出这么好听的声音呢。跟肉体被搅动的声音重叠起来简直棒极了？』" voices=""/><msg @l="170" char_id="0" frame_id="-1" name="美帆"   text="『这，这只是……因为药物……我并不是……』" voices="miho02000"/><msg @l="172" char_id="-1" frame_id="-1" name="渡部"   text="『哈哈……真是教科书般的台词啊。那么……那紧紧吸附着我那话儿的感觉又是什么？……嘿嘿……像现在这样，给我解释一下？』"   voices=""/><msg @l="174" char_id="0" frame_id="-1" name="美帆"   text="『不要！呜啊，啊，啊，啊啊……嗯啊！！』" voices="miho02010"/><msg @l="176" char_id="-1" frame_id="-1" name=""   text="我拼命想要否定渡部的话语和自己可悲的反应……，" voices=""/><msg @l="177" char_id="-1" frame_id="-1" name=""   text="但随着他腰部的撞击而袭来的麻痹般的感觉，让我无法集中任何思考。" voices=""/><msg @l="178" char_id="-1" frame_id="-1" name=""   text="每当那硬物顶到深处，我作为女性的本能就会阵阵发痛。" voices=""/><msg @l="179" char_id="-1" frame_id="-1" name=""   text="无论我怎样摇头拒绝渡部的蹂躏，我都意识到自己的下体不断地涌出液体。" voices=""/><msg @l="180" char_id="-1" frame_id="-1" name=""   text="那毫不掩饰欲望的肉棒，也在执着地持续索求我的身体。" voices=""/><msg @l="182" char_id="0" frame_id="-1" name="美帆"   text="(这种……这种事……不要……我……)" voices="miho02020"/><msg @l="184" char_id="-1" frame_id="-1" name="渡部"   text="『看你的表情，好像已经不痛了嘛。』" voices=""/><msg @l="186" char_id="0" frame_id="-1" name="美帆" text="『……！？』"   voices="miho02030"/><msg @l="188" char_id="0" frame_id="-1" name="美帆"   text="『不，不是的……这种事，只有痛而已……。』" voices="miho02040"/><msg @l="190" char_id="-1" frame_id="-1" name="渡部"   text="『小穴都在叫了，说这种话……完全，没有说服力啊！』" voices=""/><msg @l="191" char_id="-1" frame_id="-1" name=""   text="渡部的腰部，猛烈地冲撞着我的腹内。" voices=""/><msg @l="192" char_id="-1" frame_id="-1" name=""   text="宛如被铁棒贯穿般的冲击，从我的下腹部直达头顶。" voices=""/><msg @l="193" char_id="-1" frame_id="-1" name=""   text="在那近似钝痛的触感下，我如同被击中一般向后仰去。" voices=""/><msg @l="195" char_id="0" frame_id="-1" name="美帆" text="『嗯，啊啊啊！！』"   voices="miho02050"/><msg @l="197" char_id="-1" frame_id="-1" name=""   text="每当渡部用力顶入时，我都拼命咬紧牙关试图压抑住呻吟声。" voices=""/><msg @l="198" char_id="-1" frame_id="-1" name=""   text="这样做反而让腹肌绷紧，与我的意图相反，我的阴道更加紧紧吸附着渡部。" voices=""/><msg @l="199" char_id="-1" frame_id="-1" name=""   text="用力收缩反而将肉棒引向身体深处，渡部灼热的前端成功侵入到我的最深处。" voices=""/><msg @l="200" char_id="-1" frame_id="-1" name=""   text="就这样被渡部顶撞着子宫口……，" voices=""/><msg @l="201" char_id="-1" frame_id="-1" name="" text="我的全身仿佛被灼烧成一片空白……。"   voices=""/><msg @l="203" char_id="-1" frame_id="-1" name="渡部"   text="『好啊，太棒了……就这样，紧紧地夹住啊！』" voices=""/><msg @l="205" char_id="0" frame_id="-1" name="美帆"   text="『嗯嗯……哈，哈，哈……嗯啊啊！！』" voices="miho02060"/><msg @l="207" char_id="0" frame_id="-1" name="美帆"   text="(明明很讨厌……这种事……明明很讨厌……)" voices="miho02070"/><msg @l="209" char_id="-1" frame_id="-1" name="留学生"   text="『哦哦，吸吮！射精！』" voices=""/><msg @l="211" char_id="-1" frame_id="-1" name=""   text="头顶上方，那留学生双眼血红发亮，用双手疯狂地套弄着他那膨胀得令人窒息的肉棒。" voices=""/><msg @l="213" char_id="-1" frame_id="-1" name="熊野"   text="『真是的，你在急什么？……别自顾自地兴奋起来好吗？如果不想被强制遣返，就得按照我说的做。』"   voices=""/><msg @l="215" char_id="-1" frame_id="-1" name="留学生" text="『呜呜……呜。』"   voices=""/><msg @l="217" char_id="-1" frame_id="-1" name="渡部"   text="『这家伙的小穴正如想象中的名器……，嘛，你的兴奋我也不是不能理解。』" voices=""/><msg @l="219" char_id="-1" frame_id="-1" name="渡部"   text="『喂，看到了吗？我的东西被她吞到这么深处……滚烫的褶皱……缠绕着痴迷地享受着呢！？』"   voices=""/><msg @l="221" char_id="0" frame_id="-1" name="美帆"   text="『才没有那种事……嗯呜……啊，啊，啊……。』" voices="miho02080"/><msg @l="223" char_id="-1" frame_id="-1" name="渡部"   text="『别在那嘀嘀咕咕的，你也赶紧享受起来吧。』" voices=""/><msg @l="225" char_id="-1" frame_id="-1" name="渡部"   text="『无论你怎么哭着说讨厌……这边可是在开心地含着我呢？那种口是心非的态度，对正在欢喜的子宫来说太失礼了吧……给我好好享受啊！』"   voices=""/><msg @l="227" char_id="-1" frame_id="-1" name=""   text="渡部腰部的抽送动作，超越了极限加快了速度。" voices=""/><msg @l="228" char_id="-1" frame_id="-1" name=""   text="在那毫无顾忌和罪恶感的插入下，自己的一部分露出了怎样的姿态，光是想想都令人恐惧。" voices=""/><msg @l="230" char_id="0" frame_id="-1" name="美帆"   text="『啊……别、别那么激烈……啊……啊啊……。』" voices="miho02090"/><msg @l="232" char_id="0" frame_id="-1" name="美帆"   text="『嗯、嗯……啊……呃啊……呼啊啊！！』" voices="miho02100"/><msg @l="234" char_id="-1" frame_id="-1" name="渡部"   text="『哈哈，都感觉到子宫里面了吧？……老实承认你感觉到了啊！』" voices=""/><msg @l="236" char_id="0" frame_id="-1" name="美帆"   text="『我、我才没有……感觉到……。』" voices="miho02110"/><msg @l="238" char_id="-1" frame_id="-1" name="渡部"   text="『你是笨蛋吗！……湿哒哒的，明明淫液都四处飞溅了……怎么可能没感觉到嘛！』"   voices=""/><msg @l="240" char_id="-1" frame_id="-1" name=""   text="渡部那带着明显烦躁的手指，拧住了我最敏感的肉芽。" voices=""/><msg @l="242" char_id="0" frame_id="-1" name="美帆" text="『啊呜……！？』"   voices="miho02120"/><msg @l="244" char_id="-1" frame_id="-1" name=""   text="令我自己都感到惊讶的是，那里变得如此坚硬尖锐，遭受了激烈的刺激……。" voices=""/><msg @l="245" char_id="-1" frame_id="-1" name=""   text="麻痹般的强烈疼痛，以及与之相反的电击般的白色刺激……。" voices=""/><msg @l="246" char_id="-1" frame_id="-1" name=""   text="那种仿佛闪电染遍大脑的感觉，正是我本应最为恐惧的“那个”……。" voices=""/><msg @l="248" char_id="-1" frame_id="-1" name="渡部"   text="『哦哦……滴滴答答地溢出来了呢。呵呵呵……变成不守规矩的水龙头了吧？』" voices=""/><msg @l="250" char_id="0" frame_id="-1" name="美帆"   text="『不要…这种事…………啊，嗯，不要啊！』" voices="miho02130"/><msg @l="252" char_id="-1" frame_id="-1" name=""   text="对于自己被蹂躏却仍在做出反应的身体，我感到难以言表的厌恶和恐惧。" voices=""/><msg @l="253" char_id="-1" frame_id="-1" name="" text="尽管如此……，"   voices=""/><msg @l="254" char_id="-1" frame_id="-1" name=""   text="无论我如何表现出抗拒，已经，无法靠自己停下来了……。" voices=""/><msg @l="255" char_id="-1" frame_id="-1" name=""   text="阴蒂被暴力地玩弄的瞬间，我体内积攒的粘稠蜜液，无可救药地从结合处涌出……。"   voices=""/><msg @l="256" char_id="-1" frame_id="-1" name=""   text="每当被渡部插入，被摇晃之时，那种液体不断发出淫靡的水声……，在这令人绝望的行为中，我的意志对此已经无能为力……，"   voices=""/><msg @l="257" char_id="-1" frame_id="-1" name=""   text="……已经……无法做到了……。" voices=""/><msg @l="259" char_id="0" frame_id="-1" name="美帆"   text="(怎么办……怎么办………怎么办……)" voices="miho02140"/><msg @l="261" char_id="0" frame_id="-1" name="美帆"   text="(这样不行……不行……我已经，忍不住了……)" voices="miho02150"/><msg @l="263" char_id="-1" frame_id="-1" name="" text="腹部深处猛地爆发出一股炽热感。"   voices=""/><msg @l="264" char_id="-1" frame_id="-1" name=""   text="与那种刺痛感截然不同，这是伴随着疼痛的灼热团块……那种之前一直在煽动我的刺痛感觉。" voices=""/><msg @l="265" char_id="-1" frame_id="-1" name="" text="如同渴望般的……，"   voices=""/><msg @l="266" char_id="-1" frame_id="-1" name="" text="如同燃烧般的……，"   voices=""/><msg @l="267" char_id="-1" frame_id="-1" name="" text="……那是……，"   voices=""/><msg @l="268" char_id="-1" frame_id="-1" name=""   text="也许是“期待已久的热度”……。" voices=""/><msg @l="270" char_id="-1" frame_id="-1" name="渡部"   text="『好啦，要来咯，要来咯，要来咯……。』" voices=""/><msg @l="274" async="true" char_id="-1" frame_id="-1" name=""   text="要射在哪里……？" voices=""/><select @l="275"><menu @l="279" label="EventLabel_83" text="射在里面"/><menu @l="282" label="EventLabel_84" text="射在外面"/></select><label @l="290" id="EventLabel_83"/><msg @l="292" char_id="-1" frame_id="-1" name="渡部"   text="『哦，来来来……要射了，全都灌进你的体内……直到子宫深处……我要……把你玷污得彻底！！』"   voices=""/><msg @l="294" char_id="0" frame_id="-1" name="美帆"   text="『不……里面不行……住手啊！！』" voices="miho02160"/><msg @l="296" char_id="-1" frame_id="-1" name="渡部"   text="『怎么可能停下来！呃啊……全部在子宫里好好品尝吧！！！』" voices=""/><msg @l="298" char_id="0" frame_id="-1" name="美帆" text="『呜啊！？』"   voices="miho02170"/><flash @l="301" count="4" fade="100" image="white"/><wait_chgmv/><ev @l="305" src="ev-050y1z1"/><msg @l="307" char_id="-1" frame_id="-1" name="" text="好烫，好烫好烫好烫好烫好烫……。"   voices=""/><msg @l="308" char_id="-1" frame_id="-1" name="" text="在我的体内………，"   voices=""/><msg @l="309" char_id="-1" frame_id="-1" name="" text="在我的深处………，"   voices=""/><msg @l="310" char_id="-1" frame_id="-1" name="" text="太脏了，热热的液体在迸发……。"   voices=""/><msg @l="311" char_id="-1" frame_id="-1" name=""   text="撑开柔软肉壁的肉茎，每次抽动痉挛跳动，都会射入一股接一股的热液，玷污着我的内部……。"   voices=""/><msg @l="313" char_id="-1" frame_id="-1" name="渡部"   text="『就这样全部射进最深处！！』" voices=""/><msg @l="315" char_id="-1" frame_id="-1" name=""   text="渡部依然吐着污浊的液体，将他的凶器推向更深处。" voices=""/><msg @l="316" char_id="-1" frame_id="-1" name="" text="好深好热……，" voices=""/><msg @l="317" char_id="-1" frame_id="-1" name=""   text="进入到我自己……非常，非常深的地方……。" voices=""/><msg @l="318" char_id="-1" frame_id="-1" name=""   text="第一次迎接雄性白浊液带来的刺激，让被肉壁包裹的所有内脏都在战栗。" voices=""/><msg @l="320" char_id="0" frame_id="-1" name="美帆"   text="『不行…不行…要来了，要来了……！？』" voices="miho02180"/><msg @l="322" char_id="0" frame_id="-1" name="美帆"   text="『啊，啊啊……啊…啊啊………嗯，啊啊啊啊！！！』" voices="miho02190"/><flash @l="326" count="4" fade="100" image="white"/><msg @l="330" char_id="-1" frame_id="-1" name="" text="白色的闪光……，" voices=""/><msg @l="331" char_id="-1" frame_id="-1" name="" text="在意识深处瞬间爆发。"   voices=""/><msg @l="332" char_id="-1" frame_id="-1" name="" text="视野被染成一片雪白……，"   voices=""/><msg @l="333" char_id="-1" frame_id="-1" name="" text="连自己也……，" voices=""/><msg @l="334" char_id="-1" frame_id="-1" name="" text="……从世界中远去……。"   voices=""/><msg @l="335" char_id="-1" frame_id="-1" name=""   text="从被贯穿的身体深处，仿佛听到了沸腾的水声……。" voices=""/><wait_chgmv/><bg @l="339" src="bg11"/><msg @l="341" char_id="-1" frame_id="-1" name="渡部"   text="『哈哈！这家伙被射在阴道里就高潮了。』" voices=""/><msg @l="343" char_id="0" frame_id="-1" name="美帆" text="(这就是……高潮……？)"   voices="miho02200"/><msg @l="345" char_id="0" frame_id="-1" name="美帆" text="(我……高潮了……？)"   voices="miho02210"/><eval @l="348" expr="f.過去の反芻_中出しflag&#32;=&#32;1&#13;&#10;"/><goto @l="352" label="EventLabel_85"/><label @l="356" id="EventLabel_84"/><msg @l="358" char_id="-1" frame_id="-1" name="渡部"   text="『我要把我的全部……射在你可爱的脸上！！』" voices=""/><msg @l="360" char_id="0" frame_id="-1" name="美帆"   text="『呼……啊，啊，啊……。』" voices="miho02220"/><msg @l="362" char_id="0" frame_id="-1" name="美帆"   text="『有什么……要来了……要来了……要来啦……！？』" voices="miho02230"/><flash @l="366" count="4" fade="100" image="white"/><wait_chgmv/><ev @l="370" src="ev-050y1z4"/><msg @l="372" char_id="0" frame_id="-1" name="美帆"   text="『嗯、嗯、嗯嗯、呃啊……呼啊啊啊！！』" voices="miho02240"/><msg @l="374" char_id="-1" frame_id="-1" name=""   text="散发着令人作呕气味的热液，洒落在我的脸上。" voices=""/><msg @l="375" char_id="-1" frame_id="-1" name=""   text="从仍在断断续续抽搐的肉棒中喷射而出的液体……，" voices=""/><msg @l="376" char_id="-1" frame_id="-1" name="" text="玷污了我的脸颊……，"   voices=""/><msg @l="377" char_id="-1" frame_id="-1" name="" text="玷污了我的鼻子……，"   voices=""/><msg @l="378" char_id="-1" frame_id="-1" name="" text="蹂躏着我的头发……。"   voices=""/><msg @l="379" char_id="-1" frame_id="-1" name=""   text="渡部射出的充满兽欲的白浊液体，污染着我的皮肤，滑落下来，在地板上拉出一条丝线……。" voices=""/><msg @l="381" char_id="-1" frame_id="-1" name="渡部"   text="『哈哈……什么啊，这家伙……。被射在脸上就高潮了啊。』" voices=""/><msg @l="383" char_id="0" frame_id="-1" name="美帆" text="(要……去……？)"   voices="miho02250"/><msg @l="385" char_id="0" frame_id="-1" name="美帆" text="(我……去了……吗？)"   voices="miho02260"/><label @l="388" id="EventLabel_85"/><clear @l="393" class="all"/><msg @l="395" char_id="-1" frame_id="-1" name="熊野"   text="『哎呀哎呀，真是盛大地照顾了我们啊……。』" voices=""/><msg @l="397" char_id="-1" frame_id="-1" name="留学生" text="『哦哦，女人，女人。』"   voices=""/><msg @l="399" char_id="-1" frame_id="-1" name="熊野"   text="『那么……轮到我了吗……。』" voices=""/><msg @l="401" char_id="-1" frame_id="-1" name="留学生" text="『哦哦……不——！』"   voices=""/><msg @l="403" char_id="0" frame_id="-1" name="美帆" text="『下一个……轮到我了……？』"   voices="miho02270"/><msg @l="405" char_id="-1" frame_id="-1" name="熊野"   text="『哎呀，你以为只有他一个就结束了吗？』" voices=""/><msg @l="407" char_id="0" frame_id="-1" name="美帆"   text="『可是……我……刚才……。』" voices="miho02280"/><msg @l="409" char_id="0" frame_id="-1" name="美帆"   text="『不……已经……不要了……饶了我吧……。』" voices="miho02290"/><msg @l="411" char_id="-1" frame_id="-1" name="熊野"   text="『看到那样妖艳的姿态……嗯……我也不过是个男人而已……。如果被搁置不管，就像半死不活一样痛苦啊……。』"   voices=""/><msg @l="413" char_id="-1" frame_id="-1" name="熊野"   text="『而且……您品尝过的那种药……。我们也用了同样的东西，你知道吗……？』" voices=""/><msg @l="415" char_id="0" frame_id="-1" name="美帆" text="『啊……。』"   voices="miho02300"/><msg @l="417" char_id="-1" frame_id="-1" name="熊野"   text="『那药除了有增强性感的功效外……还有提高性欲的作用……。』" voices=""/><msg @l="419" char_id="-1" frame_id="-1" name="熊野"   text="『用通俗的话对你说……就是不知疲软的意思……。』" voices=""/><msg @l="421" char_id="-1" frame_id="-1" name=""   text="工友……熊野一边这么说着，一边俯视着刚刚勉强站起身的渡部的全身。" voices=""/><msg @l="422" char_id="-1" frame_id="-1" name=""   text="我也跟随着他的目光看去……。" voices=""/><msg @l="423" char_id="-1" frame_id="-1" name=""   text="刚刚射精不久的下半身，已经显露出胀满而坚硬的挺立。" voices=""/><msg @l="425" char_id="-1" frame_id="-1" name="熊野"   text="『嘛，考虑到药效的持续时间……大概射个十次就会平息吧……。』" voices=""/><msg @l="427" char_id="-1" frame_id="-1" name="熊野"   text="『在那之前……请好好地陪我们吧。』" voices=""/><msg @l="429" char_id="0" frame_id="-1" name="美帆" text="『怎么会……！？』"   voices="miho02310"/><bgm @l="432" src="bgm08" volume="1."/><goto @l="435" cond="!(f.過去の反芻_中出しflag&#32;==&#32;1)&#13;&#10;"   label="TempLabel_218"/><wait_chgmv/><ev @l="439" src="ev-050y2z1"/><goto @l="442" label="TempLabel_219"/><label @l="443" id="TempLabel_218"/><wait_chgmv/><ev @l="448" src="ev-050y2z4"/><label @l="451" id="TempLabel_219"/><msg @l="454" char_id="0" frame_id="-1" name="美帆" text="『啊呜……。』"   voices="miho02320"/><msg @l="456" char_id="-1" frame_id="-1" name=""   text="没有丝毫间隙，熊野坚硬挺立的肉棒，深深插入了我的体内。" voices=""/><msg @l="457" char_id="-1" frame_id="-1" name=""   text="这绝非我所期望的，只是为了满足男人欲望而被贪婪索取的悲惨交合…………。" voices=""/><msg @l="458" char_id="-1" frame_id="-1" name="" text="…………尽管如此…………，"   voices=""/><msg @l="459" char_id="-1" frame_id="-1" name=""   text="违背意志的是，我的媚肉私自开始发痒，不知不觉中已经紧紧包裹住熊野的肉棒…………。" voices=""/><msg @l="461" char_id="0" frame_id="-1" name="美帆"   text="『呜啊……啊，啊啊………不要………不要啊………。』" voices="miho02330"/><msg @l="463" char_id="-1" frame_id="-1" name=""   text="徒劳的抵抗话语，不断从喉咙深处涌出。" voices=""/><msg @l="464" char_id="-1" frame_id="-1" name=""   text="就连逃跑的气力，如今，我也已经没有了……。" voices=""/><msg @l="466" char_id="-1" frame_id="-1" name="熊野"   text="『哦，这确实太棒了……实在是……舒服啊……。』" voices=""/><msg @l="468" char_id="-1" frame_id="-1" name="熊野"   text="『这样缠着我……感觉连灵魂都要被榨干了……。难怪他会如此着迷，我能理解了。』" voices=""/><msg @l="470" char_id="0" frame_id="-1" name="美帆" text="『他……？……嗯，啊啊！！』"   voices="miho02340"/><msg @l="472" char_id="-1" frame_id="-1" name=""   text="熊野猛力撞击腰部时，我的爱液发出咕啾咕啾的泡沫声……。" voices=""/><msg @l="473" char_id="-1" frame_id="-1" name=""   text="连外部花瓣都被卷入的秘部，溢出了黏稠的淫靡白蜜……，" voices=""/><msg @l="474" char_id="-1" frame_id="-1" name=""   text="使沉浸在激烈抽插行为中的熊野的肉棒泛着湿滑的光泽。" voices=""/><msg @l="476" char_id="0" frame_id="-1" name="美帆"   text="『嗯……求你，放过……我……啊，啊，啊啊……。』" voices="miho02350"/><msg @l="478" char_id="0" frame_id="-1" name="美帆"   text="(明明很讨厌……明明很讨厌这种事……为什么……)" voices="miho02360"/><msg @l="480" char_id="-1" frame_id="-1" name=""   text="我的口中，已经只是漫无目的地吐出炽热的喘息声。" voices=""/><msg @l="481" char_id="-1" frame_id="-1" name=""   text="随着律动而不断颤抖的全身，恐怕正散发出汗水和女人的气味吧……。" voices=""/><msg @l="483" char_id="-1" frame_id="-1" name="熊野"   text="『看到您如此愉悦，我深感荣幸，仲根美帆女士。』" voices=""/><msg @l="486" char_id="0" frame_id="-1" name="美帆"   text="『嗯啊，啊，啊，啊啊……呜，啊啊……。』" voices="miho02370"/><msg @l="488" char_id="0" frame_id="-1" name="美帆"   text="『我才没有愉悦……啊，啊啊……不要……呜啊啊……。』" voices="miho02380"/><msg @l="490" char_id="-1" frame_id="-1" name="熊野"   text="『您的身体很诚实，所以不必害羞地含糊其辞哦。』" voices=""/><msg @l="492" char_id="-1" frame_id="-1" name="" text="从我的入口延伸到女性的核心……，"   voices=""/><msg @l="493" char_id="-1" frame_id="-1" name=""   text="狂暴的肉棒，一次又一次地往返抽插。" voices=""/><msg @l="494" char_id="-1" frame_id="-1" name=""   text="每当毫不留情地翻搅秘肉时，湿漉漉的粘稠声音就会涌现出来。" voices=""/><msg @l="495" char_id="-1" frame_id="-1" name=""   text="当熊野将其顶端抽出时，从我身体最深处涌出的大量淫液，甚至将大腿都湿润得发热。" voices=""/><msg @l="497" char_id="-1" frame_id="-1" name="熊野"   text="『如何？……您也明白了吧？您的身体正在诚实地回应着。』" voices=""/><msg @l="499" char_id="0" frame_id="-1" name="美帆"   text="『不啊啊……不是……不是这样……呜，啊啊！！』" voices="miho02390"/><se @l="503" buf="1" src="心臓" volume="1."/><msg @l="505" char_id="-1" frame_id="-1" name=""   text="……感觉有什么在我耳边低语。" voices=""/><msg @l="506" char_id="-1" frame_id="-1" name=""   text="……从深渊传来的低语，到底是谁的声音呢？" voices=""/><msg @l="507" char_id="-1" frame_id="-1" name="" text="……我的……？"   voices=""/><msg @l="508" char_id="-1" frame_id="-1" name="" text="……还是说……？"   voices=""/><msg @l="509" char_id="-1" frame_id="-1" name="" text="……但是，不行……，"   voices=""/><msg @l="510" char_id="-1" frame_id="-1" name=""   text="……我……已经什么都……思考不了了……。" voices=""/><msg @l="511" char_id="-1" frame_id="-1" name=""   text="不断被玩弄的秘处不由自主地蠕动着……，" voices=""/><msg @l="512" char_id="-1" frame_id="-1" name="" text="子宫因他们的欲望而颤抖……，"   voices=""/><msg @l="513" char_id="-1" frame_id="-1" name="" text="……把我……，"   voices=""/><msg @l="514" char_id="-1" frame_id="-1" name=""   text="……把我的一切……变得疯狂……。" voices=""/><msg @l="516" char_id="0" frame_id="-1" name="美帆"   text="『哈，哈，哈……嗯，啊呜！！』" voices="miho02400"/><msg @l="518" char_id="0" frame_id="-1" name="美帆"   text="『不行……不行啊……这种……这种感觉！！！』" voices="miho02410"/><msg @l="520" char_id="-1" frame_id="-1" name="熊野"   text="『看来你也快到极限了……没关系，就这样去吧……。』" voices=""/><goto @l="524" cond="!(f.過去の反芻_中出しflag&#32;==&#32;1)&#13;&#10;"   label="TempLabel_220"/><msg @l="526" char_id="-1" frame_id="-1" name="熊野"   text="『我也会……往你最深处，注入进去的……。』" voices=""/><msg @l="528" char_id="0" frame_id="-1" name="美帆"   text="『啊呀……会怀……孕的……嗯，呜呜………哈啊……。』" voices="miho02420"/><msg @l="530" char_id="0" frame_id="-1" name="美帆"   text="『嗯……啊，啊，啊………嗯，啊啊！！』" voices="miho02430"/><msg @l="532" char_id="-1" frame_id="-1" name="熊野"   text="『请务必，这么做吧……怀上我的孩子……如果你能爱抚我的孩子……我会很高兴的。』"   voices=""/><msg @l="534" char_id="0" frame_id="-1" name="美帆"   text="『嗯，呜嗯………嗯，啊啊………。』" voices="miho02440"/><msg @l="536" char_id="-1" frame_id="-1" name="熊野"   text="『……那么……就好好接受吧……我的种子……。』" voices=""/><msg @l="538" char_id="-1" frame_id="-1" name=""   text="熊野慢慢地眯起眼睛，将腰部深深地沉了下去。" voices=""/><msg @l="539" char_id="-1" frame_id="-1" name=""   text="前端侵入到紧闭着的最深处……，" voices=""/><msg @l="540" char_id="-1" frame_id="-1" name="" text="剧烈膨胀后一下子迸发开来……。"   voices=""/><msg @l="542" char_id="0" frame_id="-1" name="美帆" text="『诶……！？』"   voices="miho02450"/><flash @l="546" count="4" fade="100" image="white"/><wait_chgmv/><ev @l="550" src="ev-050y2z1z2"/><msg @l="552" char_id="0" frame_id="-1" name="美帆" text="『啊、啊啊啊啊……！？』"   voices="miho02460"/><msg @l="554" char_id="-1" frame_id="-1" name=""   text="一股股滚烫的污液注入我的子宫内。" voices=""/><msg @l="555" char_id="-1" frame_id="-1" name="" text="啊……好烫……。"   voices=""/><msg @l="556" char_id="-1" frame_id="-1" name="" text="滚烫的液体……，" voices=""/><msg @l="557" char_id="-1" frame_id="-1" name="" text="……又……射在里面了……。"   voices=""/><msg @l="559" char_id="-1" frame_id="-1" name="熊野"   text="『让您久等了呢……来吧，可以了。』" voices=""/><msg @l="561" char_id="-1" frame_id="-1" name="留学生"   text="『哦啊哦哦……啪、啪因兹普西……。……迪金……伊兹奥兹……！』" voices=""/><msg @l="563" char_id="0" frame_id="-1" name="美帆" text="『已经……不行了……求你……。』"   voices="miho02510"/><msg @l="565" char_id="-1" frame_id="-1" name=""   text="那位留学生似乎完全听不见我无力的恳求。" voices=""/><msg @l="566" char_id="-1" frame_id="-1" name=""   text="他不仅听不见我的声音，甚至都不知道我哭泣的意义是否能够传达给他。" voices=""/><msg @l="567" char_id="-1" frame_id="-1" name=""   text="留学生得到熊野的许可后，不顾形象地压在我身上。" voices=""/><bgm @l="570" src="bgm09" volume="1."/><goto @l="574" label="TempLabel_221"/><label @l="575" id="TempLabel_220"/><msg @l="578" char_id="-1" frame_id="-1" name="熊野"   text="『让我们来……弄脏那张可爱的脸吧。』" voices=""/><msg @l="580" char_id="0" frame_id="-1" name="美帆"   text="『呜啊……啊，啊啊………嗯，嗯呜………。』" voices="miho02470"/><msg @l="582" char_id="0" frame_id="-1" name="美帆"   text="『啊，啊，啊，啊………呜，啊啊啊！！』" voices="miho02480"/><msg @l="584" char_id="-1" frame_id="-1" name="熊野"   text="『已经……语言似乎变得毫无意义了。』" voices=""/><msg @l="586" char_id="0" frame_id="-1" name="美帆"   text="『嗯嗯……哈，哈………嗯啊………。』" voices="miho02490"/><msg @l="588" char_id="-1" frame_id="-1" name="熊野"   text="『好了，用你的身体好好接受吧。』" voices=""/><msg @l="590" char_id="-1" frame_id="-1" name=""   text="熊野在多次贯穿我的秘处后，像是满足了一般抽出了那肉块。" voices=""/><flash @l="594" count="4" fade="100" image="white"/><wait_chgmv/><ev @l="598" src="ev-050y2z4z5"/><msg @l="600" char_id="-1" frame_id="-1" name=""   text="我恍惚地注视着白浊液体一边抽动一边洒落在我脸上的景象。" voices=""/><msg @l="602" char_id="0" frame_id="-1" name="美帆" text="『呼……啊啊………。』"   voices="miho02500"/><msg @l="604" char_id="-1" frame_id="-1" name=""   text="我的肌肤被散发着令人作呕气味的男人液体弄脏，轻轻地漏出一声叹息。" voices=""/><msg @l="606" char_id="-1" frame_id="-1" name="熊野"   text="『让您久等了……来吧，可以了。』" voices=""/><msg @l="608" char_id="-1" frame_id="-1" name="留学生"   text="『哦啊哦哦……普，普，普西，曼科，曼科。』" voices=""/><msg @l="610" char_id="0" frame_id="-1" name="美帆" text="『已经……不行了……求你………。』"   voices="miho02510"/><msg @l="612" char_id="-1" frame_id="-1" name=""   text="那位留学生似乎完全没有在听我说话。" voices=""/><msg @l="613" char_id="-1" frame_id="-1" name=""   text="首先，我的话能否传达给他都很可疑。" voices=""/><msg @l="614" char_id="-1" frame_id="-1" name=""   text="一获得熊野的许可，留学生便推开熊野，像是等待已久般压在我身上。" voices=""/><bgm @l="617" src="bgm09" volume="1."/><label @l="620" id="TempLabel_221"/><goto @l="624" cond="!(f.過去の反芻_中出しflag&#32;==&#32;1)&#13;&#10;"   label="TempLabel_222"/><wait_chgmv/><ev @l="628" src="ev-050y3z1z2"/><msg @l="630" char_id="0" frame_id="-1" name="美帆" text="『嗯嗯！！』"   voices="miho02520"/><msg @l="632" char_id="-1" frame_id="-1" name=""   text="留学生黑亮的粗壮肉棒深深插入的同时，发出了咕啾的响亮水声。" voices=""/><msg @l="633" char_id="-1" frame_id="-1" name=""   text="渡部和熊野射入我体内的大量精液，和淫液混杂着黏稠地溢了出来。" voices=""/><msg @l="634" char_id="-1" frame_id="-1" name=""   text="在这片污浊的白浊海洋中，我能感觉到那把黑色的凶器正在肆虐乱窜……" voices=""/><msg @l="635" char_id="-1" frame_id="-1" name=""   text="……我正体验着即将昏厥的绝望感……。" voices=""/><goto @l="638" label="TempLabel_223"/><label @l="639" id="TempLabel_222"/><wait_chgmv/><ev @l="644" src="ev-050y3z4z5"/><msg @l="646" char_id="0" frame_id="-1" name="美帆" text="『嗯嗯！！』"   voices="miho02520"/><label @l="649" id="TempLabel_223"/><msg @l="652" char_id="-1" frame_id="-1" name="留学生"   text="『噢——，噢，女人，女人。』" voices=""/><msg @l="654" char_id="-1" frame_id="-1" name="渡部"   text="『喂喂……太厉害了，简直就像真正的野兽一样啊。』" voices=""/><msg @l="656" char_id="-1" frame_id="-1" name="熊野"   text="『果然，不愧是自称为了侵犯日本女人才来留学的人呢。』" voices=""/><msg @l="658" char_id="-1" frame_id="-1" name="留学生"   text="『噢，噢！噢哦——！』" voices=""/><msg @l="660" char_id="0" frame_id="-1" name="美帆" text="『嗯！！』"   voices="miho02530"/><msg @l="662" char_id="-1" frame_id="-1" name=""   text="那种足以让人昏厥的猛烈无礼的插入，正在灼烧着我的大脑……。" voices=""/><msg @l="663" char_id="-1" frame_id="-1" name=""   text="这种行为让人错觉他的东西已经深入到了子宫内部……" voices=""/><msg @l="664" char_id="-1" frame_id="-1" name=""   text="不仅仅是他那疯狂摆动腰部的节奏之猛烈……" voices=""/><msg @l="665" char_id="-1" frame_id="-1" name=""   text="那根肉棒的尺寸和粗度，也完全无法与渡部和熊野相比。" voices=""/><msg @l="666" char_id="-1" frame_id="-1" name=""   text="被一根长大的烧红铁桩贯穿内脏的黑色恐惧，强迫我的口中发出痛苦的呻吟。" voices=""/><msg @l="667" char_id="-1" frame_id="-1" name="" text="呼吸困难……"   voices=""/><msg @l="668" char_id="-1" frame_id="-1" name=""   text="身体内部从上到下被彻底搅动，我被压垮的肺在寻求空气时发出喘息。" voices=""/><msg @l="669" char_id="-1" frame_id="-1" name=""   text="直接的震动甚至传递到心脏，我随时都可能失去意识。" voices=""/><msg @l="670" char_id="-1" frame_id="-1" name=""   text="尽管如此，我的圣域却适应了这样的刺激，对那化为凶器的勃起震颤不已。" voices=""/><msg @l="671" char_id="-1" frame_id="-1" name=""   text="蜜壁已经扩张到极限，却依然想要迎接这暴力深入子宫深处，全身的肉体都在发出欢喜和悦乐的战栗……" voices=""/><msg @l="673" char_id="0" frame_id="-1" name="美帆"   text="『嗯……嗯嗯……哈，哈，哈………嗯啊！！』" voices="miho02540"/><msg @l="675" char_id="0" frame_id="-1" name="美帆"   text="『呜啊，啊，嗯啊……啊………嗯，啊呜！！』" voices="miho02550"/><msg @l="677" char_id="-1" frame_id="-1" name="留学生"   text="『哦，哦啊，哦，麦噶，麦噶德！』" voices=""/><msg @l="679" char_id="-1" frame_id="-1" name=""   text="留学生保持着反复抽插的姿势，上半身向前倾，在我耳边发出近乎癫狂的尖叫。" voices=""/><msg @l="680" char_id="-1" frame_id="-1" name=""   text="那些从电影中听过的简短单词，在我心中种下了令人作呕的厌恶感。" voices=""/><msg @l="681" char_id="-1" frame_id="-1" name="" text="我想发出拒绝的尖叫……。"   voices=""/><msg @l="682" char_id="-1" frame_id="-1" name=""   text="想不停地叫喊，逃离这痛苦……。" voices=""/><msg @l="683" char_id="-1" frame_id="-1" name=""   text="然而，那埋入体内的黑色铁块压迫着紧闭的子宫口，痛苦到连声音都发不出来……。" voices=""/><msg @l="684" char_id="-1" frame_id="-1" name=""   text="我感到恐惧，仿佛子宫内部随时会被侵入……。" voices=""/><msg @l="685" char_id="-1" frame_id="-1" name=""   text="紧咬的后牙发出咯咯的坚硬声响。" voices=""/><msg @l="686" char_id="-1" frame_id="-1" name=""   text="面对这种我人生中第一次感受到的恐惧，我的脸几乎完全失去了血色。" voices=""/><msg @l="688" char_id="-1" frame_id="-1" name="熊野"   text="『药物已经增加了他性器的硬度……，就连妓女都会痛哭求饶的折磨吧……。』" voices=""/><msg @l="690" char_id="0" frame_id="-1" name="美帆"   text="『呼……啊………嗯，啊呜！！』" voices="miho02560"/><msg @l="692" char_id="0" frame_id="-1" name="美帆" text="(我不明白……)"   voices="miho02570"/><msg @l="694" char_id="0" frame_id="-1" name="美帆" text="(已经，什么都不明白了……)"   voices="miho02580"/><msg @l="696" char_id="0" frame_id="-1" name="美帆"   text="(我……究竟被做了什么……我……)" voices="miho02590"/><msg @l="698" char_id="-1" frame_id="-1" name="留学生"   text="『哦，哦啊哦……要来了，要来了！』" voices=""/><msg @l="700" char_id="-1" frame_id="-1" name="熊野"   text="『哎呀，看来他已经到极限了？……意外地是普通的反应呢……』" voices=""/><msg @l="702" char_id="-1" frame_id="-1" name="渡部"   text="『大概是看着我们的时候手淫过头了吧。』" voices=""/><msg @l="704" char_id="-1" frame_id="-1" name="熊野"   text="『嘛，对他来说一两次射精……根本不算什么吧？』" voices=""/><msg @l="706" char_id="0" frame_id="-1" name="美帆"   text="『哈………啊，呜啊…………嗯，啊呜………。』" voices="miho02600"/><msg @l="708" char_id="0" frame_id="-1" name="美帆"   text="『啊、啊啊………啊…………嗯嗯嗯！！』" voices="miho02610"/><msg @l="710" char_id="-1" frame_id="-1" name="" text="下半身疯狂地颤抖着······。"   voices=""/><msg @l="711" char_id="-1" frame_id="-1" name="" text="头顶麻痹般的被虐感······。"   voices=""/><msg @l="712" char_id="-1" frame_id="-1" name=""   text="被倒错的快感侵袭，仿佛身体内部被拖拽出来，美帆的理智完全崩溃了。" voices=""/><goto @l="715" cond="!(f.過去の反芻_中出しflag&#32;==&#32;1)&#13;&#10;"   label="TempLabel_224"/><msg @l="717" char_id="-1" frame_id="-1" name="留学生"   text="『哦哦！哦啊！哦啊啊啊！！』" voices=""/><flash @l="721" count="4" fade="100" image="white"/><wait_chgmv/><ev @l="725" src="ev-050y3z1z2z3"/><msg @l="727" char_id="0" frame_id="-1" name="美帆"   text="『呜啊…………啊………啊啊……………。』" voices="miho02620"/><msg @l="729" char_id="-1" frame_id="-1" name="" text="体内的黑色巨棒猛然膨胀…………，"   voices=""/><msg @l="730" char_id="-1" frame_id="-1" name=""   text="接着喷出了一股非同寻常、充满热量的白色浊液。" voices=""/><msg @l="731" char_id="-1" frame_id="-1" name=""   text="那在阴道内部肆虐的液体，也猛烈地冲击着深处沉睡的子宫口。" voices=""/><msg @l="732" char_id="-1" frame_id="-1" name=""   text="留学生释放出大量精液后，满足地猛地拔出肉棒，发出了充满征服喜悦的尖叫。" voices=""/><wait_chgmv/><ev @l="735" src="ev-050z1z2z3"/><shake @l="737" amp="10" class="all" cycle="30" duration="2000"   type="random"/><msg @l="739" char_id="-1" frame_id="-1" name="留学生"   text="『乌哦哦哦哦哦哦哦！！！！！』" voices=""/><msg @l="743" char_id="-1" frame_id="-1" name=""   text="那声呐喊震撼着子宫，让我全身痉挛。" voices=""/><goto @l="746" label="TempLabel_225"/><label @l="747" id="TempLabel_224"/><msg @l="750" char_id="-1" frame_id="-1" name="留学生"   text="『乌哦！哦！哦哦哦！！』" voices=""/><msg @l="752" char_id="-1" frame_id="-1" name=""   text="在达到高潮的瞬间，留学生猛地从阴道中抽出了巨棒。" voices=""/><msg @l="753" char_id="-1" frame_id="-1" name=""   text="黑色巨根的顶端，在我的肚子上瞄准……，" voices=""/><flash @l="757" count="4" fade="100" image="white"/><wait_chgmv/><ev @l="761" src="ev-050z4z5z6"/><msg @l="763" char_id="0" frame_id="-1" name="美帆" text="『嗯……。』"   voices="miho02630"/><msg @l="765" char_id="-1" frame_id="-1" name=""   text="他挺出腰部，手上下套弄着翘起的肉茎。" voices=""/><msg @l="766" char_id="-1" frame_id="-1" name=""   text="霎那间，那抽搐的部位喷射出精液，啪嗒啪嗒地落在我的脸上。" voices=""/><msg @l="767" char_id="-1" frame_id="-1" name=""   text="我淋浴到的量，远远超过了渡部和熊野的……，" voices=""/><msg @l="768" char_id="-1" frame_id="-1" name=""   text="那气味和热度，足以将我推入黑暗的深渊……。" voices=""/><label @l="771" id="TempLabel_225"/><clear @l="778" class="all"/><wait_chgmv/><bg @l="782" src="bg11"/><msg @l="784" char_id="0" frame_id="-1" name="美帆"   text="『………………啊啊…………呃…………………。』" voices="miho02640"/><char @l="788" id="watab" pos="auto" src="watabe010"/><msg @l="790" char_id="-1" frame_id="-1" name="渡部"   text="『哼哼····这家伙就是个无药可救的性爱狂啊····。』" voices=""/><clear @l="793" class="char"/><char @l="795" id="watab" pos="left" src="watabe010"/><char @l="798" id="kuma" pos="right" src="kuma010"/><msg @l="800" char_id="-1" frame_id="-1" name="熊野"   text="『这还远远····没有结束呢····。』" voices=""/><msg @l="802" char_id="-1" frame_id="-1" name="熊野"   text="『····不，这应该说是····开始才对吧？』" voices=""/><msg @l="804" char_id="-1" frame_id="-1" name="渡部"   text="『啊，是啊……这么说来····确实如此····。』" voices=""/><msg @l="806" char_id="-1" frame_id="-1" name="留学生"   text="『嘿，当然····哦，耶！』" voices=""/><msg @l="808" char_id="0" frame_id="-1" name="美帆" text="『…………。』"   voices="miho02650"/><msg @l="810" char_id="-1" frame_id="-1" name=""   text="留学生一次又一次地将他的肉棒插入我那已经无法闭合的私处··············。" voices=""/><msg @l="811" char_id="-1" frame_id="-1" name=""   text="在被一次又一次地践踏，不断遭受绝对的凌辱中··············，" voices=""/><msg @l="812" char_id="-1" frame_id="-1" name=""   text="我感到自己的意识正坠入无限深邃的黑暗之底··············。" voices=""/><stopbgm @l="816" fadeout="1000"/><clear @l="822" class="all"/><end_scene @l="825"/><call @l="829" target="EventLabel_86@root_akina_c_ev02"/><return @l="830" value="0&#13;&#10;"/><return @l="833" value=""/></code></xscript>																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																	