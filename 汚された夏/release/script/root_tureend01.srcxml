<?xml version="1.0" encoding="utf-8"?><xscript><debug editor="&quot;C:\Program&#32;Files&#32;(x86)\sakura\sakura.exe&quot;&#32;&quot;%src%&quot;&#32;-Y=%line%"   src="D:\シロップ\町ぐるみの罠＋汚された夏セット版\汚された夏\完成データ\汚された夏\script\text\root_tureend01.txt"/><code><label @l="13" id="EventLabel_146"/><bgm @l="16" src="bgm13" volume="1."/><msg @l="19" char_id="-1" frame_id="-1" name="" text="………………………………。"   voices=""/><msg @l="20" char_id="-1" frame_id="-1" name="" text="………………。" voices=""/><msg @l="21" char_id="-1" frame_id="-1" name="" text="…………。" voices=""/><wait_chgmv/><bg @l="24" src="bg15a"/><char @l="26" id="miho" pos="auto" src="miho115"/><description @l="29" text="？？？"/><msg @l="31" char_id="-1" frame_id="-1" name="" text="我走出了校园。" voices=""/><msg @l="32" char_id="-1" frame_id="-1" name=""   text="即使全力奔跑，从网球场到这里也要花上10分钟。" voices=""/><msg @l="33" char_id="-1" frame_id="-1" name=""   text="只有不停奔跑的我发出了声音。" voices=""/><msg @l="34" char_id="-1" frame_id="-1" name="" text="除此之外，一切仿佛失去了声音，静止不动。"   voices=""/><msg @l="35" char_id="-1" frame_id="-1" name=""   text="在这诡异地失去了人气的校园里，西斜的阳光将树木的影子拉得很长。" voices=""/><msg @l="36" char_id="-1" frame_id="-1" name=""   text="必须告诉别人这件事。得赶快叫人来帮忙。我怀着这唯一的想法不停奔跑着………。" voices=""/><char @l="39" id="miho" pos="auto" src="miho015"/><msg @l="42" char_id="0" frame_id="-1" name="美帆"   text="『……哈啊……哈啊……哈啊……哈啊……。』" voices=""/><msg @l="44" char_id="-1" frame_id="-1" name=""   text="胸口疼得几乎无法呼吸，我停下脚步反复喘息，调整呼吸。" voices=""/><msg @l="45" char_id="-1" frame_id="-1" name=""   text="提前到来的夏日沉重空气黏在皮肤上……汗水慢慢渗了出来。" voices=""/><msg @l="47" char_id="0" frame_id="-1" name="美帆"   text="『哈啊……哈啊……哈啊………哈啊……。』" voices=""/><msg @l="49" char_id="-1" frame_id="-1" name=""   text="我一边缓慢做着深呼吸一边回头望去。" voices=""/><msg @l="50" char_id="-1" frame_id="-1" name="" text="……追兵还没有追上来。"   voices=""/><msg @l="51" char_id="-1" frame_id="-1" name="" text="玲小姐……还平安吗……。"   voices=""/><msg @l="53" char_id="0" frame_id="-1" name="美帆" text="『玲小姐……。』" voices=""/><msg @l="55" char_id="-1" frame_id="-1" name=""   text="我微弱地呢喃着……抬头仰望，像是在忍住随时可能流出的泪水。" voices=""/><msg @l="56" char_id="-1" frame_id="-1" name=""   text="就算我哭了，玲小姐他们也不会高兴的。" voices=""/><msg @l="57" char_id="-1" frame_id="-1" name=""   text="必须尽快找人求救，尽快去救玲小姐他们。" voices=""/><char @l="60" id="miho" pos="auto" src="miho115"/><msg @l="62" char_id="0" frame_id="-1" name="美帆"   text="（总之先去车站前，向警察求助吧）" voices=""/><msg @l="64" char_id="0" frame_id="-1" name="美帆"   text="（虽然玲小姐让我'逃跑'……）" voices=""/><msg @l="66" char_id="0" frame_id="-1" name="美帆"   text="（绝对不要……我不想失去重要的人……）" voices=""/><msg @l="68" char_id="0" frame_id="-1" name="美帆"   text="（等着我……我一定会叫来救援的……）" voices=""/><msg @l="70" char_id="0" frame_id="-1" name="美帆" text="（等着我…………）"   voices=""/><clear @l="73" class="all"/><msg @l="75" char_id="-1" frame_id="-1" name=""   text="离开大学。朝着公交站，我又开始奔跑。" voices=""/><msg @l="77" char_id="0" frame_id="-1" name="美帆" text="（越快越好……）" voices=""/><msg @l="79" char_id="0" frame_id="-1" name="美帆"   text="哈……哈……哈…………哈………。" voices=""/><msg @l="81" char_id="0" frame_id="-1" name="美帆" text="（哪怕只是……）" voices=""/><stopbgm @l="84" fadeout="1000"/><msg @l="86" char_id="0" frame_id="-1" name="美帆" text="（……咦？）" voices=""/><label @l="89" id="chart_line55"/><wait_chgmv/><ev @l="92" src="ev-058"/><msg @l="94" char_id="-1" frame_id="-1" name=""   text="当我把目光投向电车站时，注意到了站在通往市区的轨道中途的一个熟悉身影。" voices=""/><msg @l="95" char_id="-1" frame_id="-1" name=""   text="那个肤色浅淡的少女被黄昏染上了颜色，脸上浮现出与往常不同的充满悲伤的表情，低垂着目光看着自己的脚下。" voices=""/><bgm @l="98" src="bgm16" volume="1."/><msg @l="100" char_id="0" frame_id="-1" name="美帆" text="『奈那子……酱？』"   voices="miho13530"/><wait_chgmv/><ev @l="103" src="ev-058x1"/><msg @l="105" char_id="3" frame_id="-1" name="奈那子" text="『美帆……。』"   voices="nanako00080"/><msg @l="107" char_id="3" frame_id="-1" name="奈那子" text="『我想在这里的话能见到你。』"   voices="nanako00090"/><msg @l="109" char_id="0" frame_id="-1" name="美帆" text="『诶……为什么……。』"   voices="miho13540"/><msg @l="111" char_id="3" frame_id="-1" name="奈那子"   text="『美帆本不该来这个镇上的。』" voices="nanako00100"/><msg @l="113" char_id="3" frame_id="-1" name="奈那子"   text="『不……谁都不该来这里的。』" voices="nanako00110"/><msg @l="115" char_id="0" frame_id="-1" name="美帆" text="『你在说什么……。』"   voices="miho13550"/><msg @l="117" char_id="-1" frame_id="-1" name=""   text="我不理解她话中的含义，正想追问，却犹豫了。" voices=""/><msg @l="118" char_id="-1" frame_id="-1" name=""   text="看着奈那子眼中微微漂浮的哀伤，我感觉这似乎是不该询问的事情。" voices=""/><msg @l="120" char_id="3" frame_id="-1" name="奈那子" text="『逃吧，美帆。』"   voices="nanako00120"/><msg @l="122" char_id="0" frame_id="-1" name="美帆" text="『诶……。』"   voices="miho13560"/><msg @l="124" char_id="3" frame_id="-1" name="奈那子"   text="『美帆不应该在这个小镇上。所以奈那子要帮你逃走。』" voices="nanako00130"/><msg @l="126" char_id="0" frame_id="-1" name="美帆"   text="『帮我逃走……可是，我。』" voices="miho13570"/><msg @l="128" char_id="-1" frame_id="-1" name=""   text="我不能丢下为了帮我逃走而豁出自己的玲小姐不管。" voices=""/><msg @l="130" char_id="0" frame_id="-1" name="美帆"   text="『我不能就这样逃走……。』" voices="miho13580"/><clear @l="133" class="all"/><msg @l="135" char_id="3" frame_id="-1" name="奈那子"   text="『没关系。哥哥一定会来救援的……走吧，美帆。』" voices=""/><msg @l="137" char_id="0" frame_id="-1" name="美帆" text="『啊，奈那子酱……！？』"   voices=""/><msg @l="139" char_id="-1" frame_id="-1" name=""   text="奈那子不等我回答，就这样说着抓住了我的手。" voices=""/><msg @l="140" char_id="-1" frame_id="-1" name=""   text="我……看着抓着我手的奈那子，不知该如何是好，僵在了原地。" voices=""/><msg @l="142" char_id="0" frame_id="-1" name="美帆" text="『可是……得通知警察啊……。』"   voices=""/><msg @l="144" char_id="3" frame_id="-1" name="奈那子"   text="『警察不会听美帆说的话的……不，不只是警察……其他所有人也是……。』" voices=""/><msg @l="146" char_id="0" frame_id="-1" name="美帆" text="『怎么会……。』"   voices=""/><msg @l="148" char_id="3" frame_id="-1" name="奈那子"   text="『她明白这点才帮美帆逃走的。因为想保护她最喜欢的美帆……。』" voices=""/><msg @l="150" char_id="0" frame_id="-1" name="美帆"   text="（让我逃走……是因为想保护我……）" voices=""/><msg @l="152" char_id="0" frame_id="-1" name="美帆" text="（那就是……玲小姐的愿望……）"   voices=""/><msg @l="154" char_id="0" frame_id="-1" name="美帆"   text="（玲小姐不惜牺牲自己也要让我逃走……）" voices=""/><msg @l="156" char_id="0" frame_id="-1" name="美帆"   text="（是啊……我不能让她的努力白费……）" voices=""/><msg @l="158" char_id="-1" frame_id="-1" name=""   text="我像是在说服自己似的低声呢喃，将视线投向网球场的方向。" voices=""/><msg @l="159" char_id="-1" frame_id="-1" name=""   text="球场的尽头，仿佛要将一切焚烧殆尽的夕阳，染成了朱红色，炫耀着它的姿态。" voices=""/><stopbgm @l="162" fadeout="1000"/><msg @l="164" char_id="-1" frame_id="-1" name="" text="………………………………。"   voices=""/><msg @l="165" char_id="-1" frame_id="-1" name="" text="………………。" voices=""/><msg @l="166" char_id="-1" frame_id="-1" name="" text="…………。" voices=""/><bgm @l="169" src="bgm13" volume="1."/><msg @l="171" char_id="0" frame_id="-1" name="美帆" text="『…………。』" voices=""/><msg @l="173" char_id="3" frame_id="-1" name="奈那子" text="『…………。』" voices=""/><msg @l="175" char_id="-1" frame_id="-1" name="" text="我们就这样无言地奔跑着。"   voices=""/><msg @l="176" char_id="-1" frame_id="-1" name="" text="渐渐地，跑步的速度加快了。"   voices=""/><msg @l="177" char_id="-1" frame_id="-1" name="" text="最终变成了全力冲刺。"   voices=""/><msg @l="178" char_id="-1" frame_id="-1" name=""   text="我也拼命地摆动着快要纠缠在一起的双腿，奋力奔跑着。" voices=""/><msg @l="179" char_id="-1" frame_id="-1" name="" text="只是，不知目的地为何，却依然不停地向前跑去。"   voices=""/><clear @l="182" class="all"/><wait_chgmv/><bg @l="185" src="bg15a"/><char @l="187" id="miho" pos="left" src="miho115"/><char @l="189" id="nanak" pos="right" src="nanako015"/><msg @l="191" char_id="-1" frame_id="-1" name=""   text="穿过一段像是捷径的地方后，我们来到了大学的后院。" voices=""/><msg @l="192" char_id="-1" frame_id="-1" name=""   text="阳光开始暗淡，被染成绯红色的这个地方，美得令人恐惧，又带着几分诡异……" voices=""/><msg @l="194" char_id="3" frame_id="-1" name="奈那子" text="『应该是这附近……』"   voices=""/><msg @l="196" char_id="-1" frame_id="-1" name=""   text="就在奈那子以平淡的声音低语的那一刻，我感觉到空气中有一种令人不快的扭曲感。" voices=""/><shake @l="199" amp="10" class="all" cycle="30" duration="500" type="random"/><msg @l="201" char_id="-1" frame_id="-1" name="" text="轰！" voices=""/><msg @l="203" char_id="-1" frame_id="-1" name="" text="强风呼啸着吹拂过来。"   voices=""/><msg @l="204" char_id="-1" frame_id="-1" name="" text="与此同时" voices=""/><stopbgm @l="207" fadeout="1000"/><clear @l="209" class="all"/><msg @l="211" char_id="-1" frame_id="-1" name="" text="《唔哦哦哦哦哦哦哦哦》"   voices=""/><msg @l="213" char_id="-1" frame_id="-1" name="" text="突然，我听到一声像是什么野兽的远吠声。"   voices=""/><msg @l="214" char_id="-1" frame_id="-1" name="" text="是狼……？不……不对……。"   voices=""/><msg @l="215" char_id="-1" frame_id="-1" name=""   text="恐惧令我几乎忘记了呼吸，心跳加速。" voices=""/><msg @l="216" char_id="-1" frame_id="-1" name="" text="在林间的缝隙中只能看到一个影子……。"   voices=""/><msg @l="217" char_id="-1" frame_id="-1" name="" text="那影子……不是野兽……而是人形……。"   voices=""/><msg @l="218" char_id="-1" frame_id="-1" name="" text="只是……那双眼睛呈现着红色，闪烁着摇曳的光芒……。"   voices=""/><msg @l="219" char_id="-1" frame_id="-1" name="" text="———鬼！！" voices=""/><msg @l="220" char_id="-1" frame_id="-1" name="" text="我不由自主地想起了传说中的怪物。"   voices=""/><bgm @l="223" src="bgm13" volume="1."/><wait_chgmv/><bg @l="225" src="bg15a"/><char @l="227" id="miho" pos="left" src="miho115"/><char @l="229" id="nanak" pos="right" src="nanako015"/><msg @l="231" char_id="0" frame_id="-1" name="美帆" text="『奈……奈那子酱！！』"   voices=""/><msg @l="233" char_id="3" frame_id="-1" name="奈那子" text="『美帆！这边！！』"   voices=""/><clear @l="236" layer="nanak"/><msg @l="238" char_id="-1" frame_id="-1" name=""   text="奈那子说完，又开始奔跑起来。" voices=""/><msg @l="239" char_id="-1" frame_id="-1" name=""   text="前进的方向是……校舍后面的后山方向。" voices=""/><msg @l="240" char_id="-1" frame_id="-1" name=""   text="我不明白原因和意义，纯粹被恐惧驱使，拼命地跟在她后面。" voices=""/><msg @l="242" char_id="0" frame_id="-1" name="美帆" text="『呃……』" voices=""/><clear @l="245" layer="miho"/><clear @l="248" class="all"/><msg @l="250" char_id="0" frame_id="-1" name="美帆"   text="『哈……哈……哈………哈……』" voices=""/><msg @l="252" char_id="-1" frame_id="-1" name="" text="心脏像急促的钟声一样跳动。"   voices=""/><msg @l="253" char_id="-1" frame_id="-1" name=""   text="已经不知道自己跑了多久……" voices=""/><msg @l="254" char_id="-1" frame_id="-1" name=""   text="只是为了远离那不明身份的“某物——恐惧”而不停地奔跑……" voices=""/><msg @l="255" char_id="3" frame_id="-1" name="奈那子"   text="『丘陵那边……有条小路。从那里可以不被任何人发现就能出去。』" voices=""/><msg @l="257" char_id="-1" frame_id="-1" name=""   text="虽然奈那子告诉了我目的地，但恐惧充斥的大脑已经没有思考的余地了。" voices=""/><msg @l="259" char_id="3" frame_id="-1" name="奈那子" text="『看到了……。』" voices=""/><msg @l="261" char_id="-1" frame_id="-1" name=""   text="我们跑到了环绕校舍的砖墙前才停下脚步。" voices=""/><msg @l="262" char_id="-1" frame_id="-1" name=""   text="沿着墙壁走了一小段，发现有一处洞口开着。" voices=""/><msg @l="263" char_id="-1" frame_id="-1" name=""   text="奈那子抓住我的手，半强迫地把我拉了进去。" voices=""/><clear @l="266" class="all"/><msgshow @l="268" show="true"/><wait_chgmv/><bg @l="271" src="bg22_1"/><char @l="274" id="miho" pos="auto" src="miho114"/><msg @l="276" char_id="0" frame_id="-1" name="美帆"   text="『这种地方居然……有条地下通道……。』" voices=""/><msg @l="278" char_id="-1" frame_id="-1" name=""   text="穿过入口，一条精心建造得不自然的废弃通道呈现在眼前。" voices=""/><msg @l="279" char_id="-1" frame_id="-1" name=""   text="石头墙壁和最基本的采光窗，都做工精细得令人难以置信。" voices=""/><clear @l="282" class="char"/><char @l="284" id="miho" pos="right" src="miho115"/><char @l="286" id="nanak" pos="left" src="nanako017"/><msg @l="288" char_id="3" frame_id="-1" name="奈那子" text="『……美帆先走吧。』"   voices=""/><char @l="291" id="miho" pos="right" src="miho114"/><msg @l="293" char_id="0" frame_id="-1" name="美帆" text="『诶，奈那子呢……？』"   voices=""/><char @l="296" id="nanak" pos="left" src="nanako010"/><msg @l="298" char_id="3" frame_id="-1" name="奈那子" text="『我要在这里……等哥哥大人。』"   voices=""/><char @l="301" id="miho" pos="right" src="miho015"/><msg @l="303" char_id="0" frame_id="-1" name="美帆"   text="『怎么会！不一起走吗！？』" voices=""/><char @l="306" id="nanak" pos="left" src="nanako011"/><msg @l="308" char_id="3" frame_id="-1" name="奈那子"   text="『哥哥大人还有必须要做的事情没有结束……所以我不能走。』" voices=""/><msg @l="310" char_id="0" frame_id="-1" name="美帆"   text="『必须要做的事情……怎么会……在这种地方的话奈那子你也会！！』" voices=""/><clear @l="313" class="char"/><stopbgm @l="315" fadeout="1000"/><wait @l="317" time="5000"/><char @l="319" id="nanak" pos="center" src="nanako013f" y="-80"/><msg @l="321" char_id="3" frame_id="-1" name="奈那子" text="『美帆——。』"   voices=""/><msg @l="323" char_id="-1" frame_id="-1" name=""   text="奈那子的手臂环绕在我的背后……紧紧地抱住了我。" voices=""/><msg @l="324" char_id="-1" frame_id="-1" name="" text="她的长发轻轻搔着我的脸颊……。"   voices=""/><bgm @l="327" src="bgm11" volume="1."/><msg @l="329" char_id="3" frame_id="-1" name="奈那子" text="『不要……辜负这个愿望。』"   voices=""/><msg @l="331" char_id="0" frame_id="-1" name="美帆" text="『诶……』" voices=""/><msg @l="333" char_id="3" frame_id="-1" name="奈那子"   text="『不只是那些帮美帆逃脱的人……我也……希望美帆能得救。』" voices=""/><msg @l="335" char_id="3" frame_id="-1" name="奈那子"   text="『……我……和美帆成为朋友，真的很开心哦……。』" voices=""/><msg @l="337" char_id="-1" frame_id="-1" name=""   text="奈那子的眼眸中，隐约浮现着泪水。" voices=""/><msg @l="339" char_id="0" frame_id="-1" name="美帆"   text="『我···我也很开心哦···。最初···觉得你是个···有点奇怪的女孩···但是···。』" voices=""/><msg @l="341" char_id="3" frame_id="-1" name="奈那子" text="『·····。』" voices=""/><msg @l="343" char_id="-1" frame_id="-1" name=""   text="奈那子轻轻推着我的背，朝着废弃道路的深处。" voices=""/><clear @l="346" class="char"/><char @l="348" id="nanak" pos="auto" src="nanako013"/><msg @l="350" char_id="0" frame_id="-1" name="美帆" text="『我···。』" voices=""/><msg @l="352" char_id="3" frame_id="-1" name="奈那子"   text="『去吧。再见这句话—我不会说的。』" voices=""/><msg @l="354" char_id="0" frame_id="-1" name="美帆" text="『呜···！！』" voices=""/><msg @l="356" char_id="3" frame_id="-1" name="奈那子" text="『没关系。我们一定能再见面的。』"   voices=""/><msg @l="358" char_id="0" frame_id="-1" name="美帆" text="『奈那子···。』"   voices=""/><char @l="361" id="nanak" pos="auto" src="nanako011"/><msg @l="363" char_id="3" frame_id="-1" name="奈那子"   text="『因为，我最喜欢美帆了呀。』" voices=""/><msg @l="365" char_id="0" frame_id="-1" name="美帆"   text="『嗯！绝对会的！！一定要再见面哦！』" voices=""/><msg @l="367" char_id="3" frame_id="-1" name="奈那子" text="『嗯。』" voices=""/><clear @l="370" class="all"/><msg @l="372" char_id="-1" frame_id="-1" name=""   text="听到她的回答，我像弹簧一样冲了出去。" voices=""/><msg @l="373" char_id="-1" frame_id="-1" name=""   text="虽然早已超过体力极限，但为了回应玲小姐和奈那子，仅凭这个信念，我的双腿依然在不停移动。" voices=""/><stopbgm @l="376" fadeout="1000"/><clear @l="378" class="all"/><msgshow @l="380" show="true"/><msg @l="382" char_id="-1" frame_id="-1" name="" text="……………。"   voices=""/><clear @l="385" class="all"/><msgshow @l="387" show="true"/><wait_chgmv/><bg @l="390" src="bg15a"/><char @l="392" id="kuma" pos="auto" src="kuma018f"/><bgm @l="395" src="bgm17" volume="1."/><msg @l="397" char_id="-1" frame_id="-1" name="熊野"   text="『啧……那家伙不行，比想象中逃得快。』" voices=""/><msg @l="399" char_id="-1" frame_id="-1" name="熊野"   text="『警察至今都找不到她……依旧是群没用的家伙。』" voices=""/><msg @l="401" char_id="-1" frame_id="-1" name=""   text="伴随着这番话，缓缓抬起的面容中，那双泛着红光的眼睛明显流露出烦躁。" voices=""/><msg @l="402" char_id="-1" frame_id="-1" name=""   text="在他视线的前方，是一个不自然地暴露出背后黑暗的洞穴。" voices=""/><msg @l="403" char_id="-1" frame_id="-1" name=""   text="看清前方的熊野那残酷的嘴角，挂上了轻蔑与怀疑的笑容。" voices=""/><msg @l="405" char_id="-1" frame_id="1" name="熊野"   text="（这里确实………无聊……但……有趣……）" voices=""/><msg @l="407" char_id="-1" frame_id="-1" name="熊野"   text="『那个叫白石的女人也是……总是来妨碍我。』" voices=""/><msg @l="409" char_id="-1" frame_id="-1" name="熊野" text="『……但，我不会轻易让她逃脱的。』"   voices=""/><clear @l="412" class="char"/><char @l="414" id="kuma" pos="left" src="kuma018"/><char @l="416" id="nanak" pos="right" src="nanako017"/><msg @l="418" char_id="-1" frame_id="-1" name="熊野" text="『小丫头。你是什么人……。』"   voices=""/><msg @l="420" char_id="-1" frame_id="-1" name=""   text="当熊野正要上前时，奈那子挡在了他的面前。" voices=""/><msg @l="421" char_id="-1" frame_id="-1" name="" text="与美帆分别后……她回来了。"   voices=""/><msg @l="423" char_id="3" frame_id="-1" name="奈那子" text="『……。』" voices=""/><msg @l="425" char_id="-1" frame_id="-1" name="熊野"   text="『嗯，看你的样子是在等我吗……小丫头，让开。』" voices=""/><msg @l="427" char_id="-1" frame_id="-1" name="熊野"   text="『乖乖让开的话，我就饶你一命。但是，如果不让开的话，你会遭殃的……后果不仅仅是痛苦而已。』" voices=""/><msg @l="429" char_id="3" frame_id="-1" name="奈那子" text="『美帆……我不会交给你。』"   voices=""/><msg @l="431" char_id="-1" frame_id="-1" name="熊野"   text="『哼。小丫头能做什么呢。』" voices=""/><msg @l="433" char_id="3" frame_id="-1" name="奈那子" text="『……。』" voices=""/><msg @l="435" char_id="-1" frame_id="-1" name="熊野"   text="『看来你还不明白啊，如果你把我当成那些普通大叔的话，那就大错特错了！』" voices=""/><clear @l="438" class="char"/><shake @l="441" amp="10" class="all" cycle="30" duration="500" type="random"/><msg @l="443" char_id="-1" frame_id="-1" name=""   text="熊野像是要发泄自己的烦躁，大幅度地将手臂横向挥出。" voices=""/><msg @l="445" char_id="-1" frame_id="-1" name=""   text="强风掀起波浪般的气流，奈那子刚才所站位置的空气被瞬间掏空。" voices=""/><msg @l="446" char_id="-1" frame_id="-1" name=""   text="不过奈那子虽然险象环生，但还是躲过了熊野的手臂。" voices=""/><char @l="449" id="kuma" pos="left" src="kuma018"/><char @l="451" id="nanak" pos="right" src="nanako017"/><msg @l="453" char_id="3" frame_id="-1" name="奈那子" text="『……。』" voices=""/><msg @l="455" char_id="-1" frame_id="-1" name="熊野"   text="『不知道你是在哪里学的那点武艺，但终究只是个小丫头。与我为敌就是你运气用尽的时候了。』" voices=""/><msg @l="457" char_id="-1" frame_id="-1" name=""   text="熊野的嘴角邪恶地扭曲，红光的双瞳更加妖异地闪耀。" voices=""/><stopbgm @l="460" fadeout="1000"/><clear @l="463" class="char"/><char @l="465" id="nanak" pos="center" src="nanako014f" y="-80"/><msg @l="467" char_id="3" frame_id="-1" name="奈那子" text="『啊……！？』"   voices=""/><msg @l="469" char_id="-1" frame_id="-1" name=""   text="刹那间，在奈那子眨眼的瞬间，熊野的身影消失了。" voices=""/><msg @l="471" char_id="-1" frame_id="-1" name="熊野" text="『到此为止了。』" voices=""/><msg @l="473" char_id="-1" frame_id="-1" name=""   text="突然间，从背后传来熊野的声音。同时，颈部感到一阵刺痛。" voices=""/><char @l="476" id="nanak" pos="center" src="nanako015f" y="-80"/><flash @l="478" count="4" fade="100" image="white"/><msg @l="480" char_id="3" frame_id="-1" name="奈那子" text="『呃，啊……。』"   voices=""/><clear @l="483" class="char"/><msg @l="485" char_id="-1" frame_id="-1" name=""   text="顿时，身体失去了力气……倒在了原地。" voices=""/><shake @l="488" amp="10" class="all" cycle="30" duration="100" type="random"/><se @l="490" buf="1" src="人とぶつかる音" volume="1."/><clear @l="493" class="all"/><label @l="496" id="event_scene69"/><label @l="499" id="chart_line56"/><wait_chgmv/><ev @l="502" src="ev-069"/><bgm @l="505" src="bgm10" volume="1."/><msg @l="507" char_id="3" frame_id="-1" name="奈那子" text="『啊，啊啊啊……！？』"   voices="nanako00160"/><msg @l="509" char_id="-1" frame_id="-1" name="" text="一种令人毛骨悚然的感觉在奈那子体内蔓延。"   voices=""/><msg @l="510" char_id="-1" frame_id="-1" name=""   text="从身体深处涌出的甜美而又迟钝的麻痹感，瞬间侵蚀着理性。" voices=""/><msg @l="512" char_id="3" frame_id="-1" name="奈那子" text="『这是……什么……。』"   voices="nanako00170"/><msg @l="514" char_id="-1" frame_id="-1" name="熊野"   text="『本来想好好地侵犯你一番，但现在封住那个女孩的嘴更重要。』" voices=""/><msg @l="516" char_id="3" frame_id="-1" name="奈那子" text="『嗯嗯……呜、啊啊！』"   voices="nanako00180"/><msg @l="518" char_id="-1" frame_id="-1" name="" text="奈那子试图向熊野伸出手。"   voices=""/><msg @l="519" char_id="-1" frame_id="-1" name=""   text="然而，与奈那子的意愿相反，她的手在揉搓自己的胸部，隔着内衣摩擦着私密处。" voices=""/><msg @l="520" char_id="-1" frame_id="-1" name=""   text="对于被未知感觉所操控的奈那子来说，这已经是过于强烈的刺激了。" voices=""/><msg @l="521" char_id="-1" frame_id="-1" name=""   text="从这种状态到开始追求更强烈的快感，并没有花费太多时间。" voices=""/><msg @l="522" char_id="-1" frame_id="-1" name=""   text="她捏起即使隔着衣服也能看出明显凸起的乳头，同时注意力也从私密处转移到了敏感的花核上。" voices=""/><msg @l="523" char_id="-1" frame_id="-1" name=""   text="每当指尖拨弄乳头时都会产生甜美的麻痹感，而被按压的花核下方的私密处则溢出蜜液，濡湿了薄薄的布料。" voices=""/><msg @l="525" char_id="3" frame_id="-1" name="奈那子" text="『啊……啊、啊……。』"   voices="nanako00190"/><msg @l="527" char_id="-1" frame_id="-1" name=""   text="每当擦过私密处，指尖触碰到花核时，奈那子的双腿就会绷直，腰部向上抬起。" voices=""/><msg @l="528" char_id="-1" frame_id="-1" name=""   text="她的眼神变得空洞，半张的嘴角流下唾液。" voices=""/><msg @l="529" char_id="-1" frame_id="-1" name=""   text="她被自己不停的手指玩弄着，脸颊变得通红，吐出炙热的气息。" voices=""/><msg @l="531" char_id="-1" frame_id="-1" name="熊野"   text="『小丫头就在那里像小丫头一样安慰自己吧。』" voices=""/><msg @l="533" char_id="-1" frame_id="-1" name="熊野"   text="『等我抓到另一个女孩，就一起好好疼爱你们。呵呵呵。』" voices=""/><msg @l="535" char_id="-1" frame_id="-1" name=""   text="熊野把奈那子留在原地，朝着废弃的道路走去。" voices=""/><clear @l="538" class="all"/><msgshow @l="540" show="true"/><msg @l="542" char_id="3" frame_id="-1" name="奈那子"   text="『嗯唔……美…帆………逃…走……。』" voices="nanako00200"/><msg @l="544" char_id="-1" frame_id="-1" name=""   text="即使知道自己的大脑正在融化，她还是无法摆脱这种甜美的麻痹感，只能屈服于其中。" voices=""/><msg @l="545" char_id="-1" frame_id="-1" name=""   text="即使在这种状态下，奈那子依然在喃喃着美帆的名字。" voices=""/><msg @l="546" char_id="-1" frame_id="-1" name="" text="只是……祈祷美帆平安无事……。"   voices=""/><clear @l="549" class="all"/><stopbgm @l="551" fadeout="1000"/><wait @l="553" time="1000"/><end_scene @l="556"/><wait_chgmv/><bg @l="559" src="bg22_1"/><char @l="561" id="miho" pos="auto" src="miho115"/><bgm @l="563" src="bgm16" volume="1."/><msg @l="565" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="567" char_id="-1" frame_id="-1" name=""   text="她不知道这条路会延伸到何处，只是拼命地一直奔跑着。" voices=""/><msg @l="568" char_id="-1" frame_id="-1" name=""   text="这是一个每迈出一步就会扬起灰尘的地方。" voices=""/><msg @l="570" char_id="0" frame_id="-1" name="美帆" text="（奈那子酱……不知道她还好吗）"   voices=""/><msg @l="572" char_id="-1" frame_id="-1" name="" text="她停下脚步，回头望向刚才走过的路。"   voices=""/><msg @l="573" char_id="-1" frame_id="-1" name="" text="已经走到相当深入的地方了。"   voices=""/><msg @l="574" char_id="-1" frame_id="-1" name=""   text="即使现在回去……又能做什么呢？" voices=""/><msg @l="576" char_id="0" frame_id="-1" name="美帆" text="『………。』" voices=""/><msg @l="578" char_id="0" frame_id="-1" name="美帆"   text="（……现在只考虑如何离开这里吧）" voices=""/><msg @l="580" char_id="0" frame_id="-1" name="美帆"   text="（如果这……是玲小姐和奈那子酱的“愿望”的话………）" voices=""/><clear @l="583" class="all"/><wait_chgmv/><bg @l="586" src="bg22_2"/><msg @l="588" char_id="0" frame_id="-1" name="美帆" text="（……道路分成了两条）"   voices=""/><msg @l="590" char_id="-1" frame_id="-1" name="" text="路中途有一条因墙壁坍塌而形成的岔路。"   voices=""/><msg @l="591" char_id="-1" frame_id="-1" name="" text="姑且……前面看起来仍有道路的样子。"   voices=""/><wait_chgmv/><bg @l="594" src="bg22_1"/><msg @l="596" char_id="-1" frame_id="-1" name=""   text="走进岔路前行片刻后，与之前相同模样的道路再次展现在眼前。" voices=""/><msg @l="598" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><call @l="601" target="EventLabel_0@3drpg"/><goto @l="604" cond="!(f._3d_exodus&#32;==&#32;0)&#13;&#10;"   label="TempLabel_293"/><goto @l="607" label="EventLabel_147"/><goto @l="610" label="TempLabel_294"/><label @l="611" id="TempLabel_293"/><goto @l="615" label="EventLabel_148"/><label @l="618" id="TempLabel_294"/><label @l="622" id="EventLabel_147"/><wait_chgmv/><bg @l="625" src="bg22_5"/><msg @l="626" char_id="-1" frame_id="-1" name="人影" text="『……。』" voices=""/><stopbgm @l="629" fadeout="1000"/><char @l="631" id="miho" pos="auto" src="miho114"/><msg @l="633" char_id="0" frame_id="-1" name="美帆" text="『谁？！……是谁在那里！？』"   voices=""/><clear @l="636" class="char"/><char @l="638" id="miho" pos="left" src="miho014"/><char @l="640" id="shiny" pos="right" src="shinya010"/><msg @l="642" char_id="-1" frame_id="-1" name="真弥" text="『……。』" voices=""/><msg @l="644" char_id="0" frame_id="-1" name="美帆" text="『奈那子的……哥哥。』"   voices=""/><char @l="647" id="shiny" pos="right" src="shinya017"/><bgm @l="649" src="bgm12" volume="1."/><msg @l="651" char_id="-1" frame_id="-1" name="真弥" text="『是你啊……快走吧。』"   voices=""/><char @l="654" id="miho" pos="left" src="miho115"/><msg @l="656" char_id="0" frame_id="-1" name="美帆"   text="『那、那个！……为、为了救我奈那子留下来了！……说不定奈那子她…奈那子她……』" voices=""/><char @l="659" id="shiny" pos="right" src="shinya010"/><msg @l="661" char_id="-1" frame_id="-1" name="真弥" text="『……。』" voices=""/><char @l="664" id="miho" pos="left" src="miho015"/><msg @l="666" char_id="0" frame_id="-1" name="美帆"   text="『连室友学姐也为了救我……！』" voices=""/><msg @l="668" char_id="0" frame_id="-1" name="美帆"   text="『求求您！请救救大家！请、请叫人来救我们！！』" voices=""/><char @l="671" id="shiny" pos="right" src="shinya017"/><msg @l="673" char_id="-1" frame_id="-1" name="真弥"   text="『放心吧……奈那子有我保护。但是……镇上的人们已经被卷入因果之中……这都是我们的过错……抱歉……。』"   voices=""/><msg @l="675" char_id="0" frame_id="-1" name="美帆" text="『奈那子的哥哥……。』"   voices=""/><char @l="678" id="shiny" pos="right" src="shinya010"/><msg @l="680" char_id="-1" frame_id="-1" name="真弥" text="『……。』" voices=""/><msg @l="682" char_id="-1" frame_id="-1" name=""   text="突然，奈那子的哥哥越过我的肩膀凝视着废弃的道路。" voices=""/><msg @l="683" char_id="-1" frame_id="-1" name=""   text="他像是在看穿通往黑暗的道路……不，是在看穿那远方肉眼看不见的什么东西。" voices=""/><msg @l="685" char_id="-1" frame_id="-1" name="真弥" text="『快走吧……时间不多了。』"   voices=""/><char @l="688" id="miho" pos="left" src="miho115"/><msg @l="690" char_id="0" frame_id="-1" name="美帆" text="『可是！』" voices=""/><char @l="693" id="shiny" pos="right" src="shinya210"/><msg @l="695" char_id="-1" frame_id="-1" name="真弥" text="『……拜托了。』"   voices=""/><msg @l="697" char_id="0" frame_id="-1" name="美帆" text="『？』" voices=""/><msg @l="699" char_id="-1" frame_id="-1" name="真弥"   text="『……如果能活着出去……以后也请继续做奈那子的朋友……拜托了。』" voices=""/><msg @l="700" char_id="0" frame_id="-1" name="美帆" text="『啊……』" voices=""/><msg @l="702" char_id="-1" frame_id="-1" name="真弥" text="『快走吧。』"   voices=""/><msg @l="704" char_id="0" frame_id="-1" name="美帆" text="『……！』" voices=""/><clear @l="707" layer="miho"/><msg @l="709" char_id="-1" frame_id="-1" name=""   text="奈那子的哥哥像是要结束和我的谈话，推开我，盯着废弃的道路。" voices=""/><msg @l="710" char_id="-1" frame_id="-1" name=""   text="我想不出任何可以对他的背影说的话，只好听从他的话。" voices=""/><clear @l="713" class="char"/><wait_chgmv/><bg @l="715" src="bg22_3"/><char @l="717" id="miho" pos="auto" src="miho115"/><msg @l="719" char_id="-1" frame_id="-1" name=""   text="走了一会儿后，终于到达了出口。" voices=""/><msg @l="721" char_id="0" frame_id="-1" name="美帆" text="『………。』" voices=""/><msg @l="723" char_id="0" frame_id="-1" name="美帆" text="（这里是出口……）" voices=""/><char @l="726" id="miho" pos="auto" src="miho015"/><msg @l="728" char_id="0" frame_id="-1" name="美帆"   text="（从这里出去就能逃离南总町了……）" voices=""/><stopbgm @l="731" fadeout="1000"/><msg @l="733" char_id="-1" frame_id="-1" name=""   text="摇摇晃晃地……我朝着透进光线的出口走去。" voices=""/><begin_trans @l="736" time="500"/><clear @l="737" layer="cutin_f"/><clear @l="738" layer="cutin"/><end_trans @l="739"/><clear @l="741" class="char"/><msgshow @l="743" show="false"/><wait_chgmv/><bg @l="745" src="white" time="10000"/><clear @l="747" class="ev"/><begin_trans @l="750" time="500"/><clear @l="751" layer="cutin_f"/><clear @l="752" layer="cutin"/><end_trans @l="753"/><clear @l="755" class="char"/><msgshow @l="757" show="false"/><wait_chgmv/><bg @l="759" src="white"/><clear @l="761" class="ev"/><msg @l="763" char_id="-1" frame_id="-1" name="" text="…………………………。"   voices=""/><msg @l="764" char_id="-1" frame_id="-1" name="" text="………………。" voices=""/><msg @l="765" char_id="-1" frame_id="-1" name="" text="……。" voices=""/><label @l="768" id="chart_line57"/><wait_chgmv/><ev @l="771" src="ev-053y1y2"/><bgm @l="773" src="bgm20" volume="1."/><msg @l="775" char_id="-1" frame_id="-1" name=""   text="两个人影注视着被夕阳染红的南总町。" voices=""/><msg @l="776" char_id="-1" frame_id="-1" name=""   text="两个人沉默不语地伫立着，柔和的风像是抚摸般从他们之间吹过。" voices=""/><msg @l="777" char_id="-1" frame_id="-1" name="" text="仿佛……在宣告结束。"   voices=""/><msg @l="780" char_id="-1" frame_id="-1" name="男人" text="『……。』" voices=""/><wait_chgmv/><ev @l="783" src="ev-053y1"/><msg @l="785" char_id="3" frame_id="-1" name="女孩" text="『……。』" voices=""/><wait_chgmv/><ev @l="789" src="ev-053"/><begin_trans @l="792" time="500"/><clear @l="793" layer="cutin_f"/><clear @l="794" layer="cutin"/><end_trans @l="795"/><clear @l="797" class="char"/><msgshow @l="799" show="false"/><wait_chgmv/><bg @l="801" src="white" time="3000"/><clear @l="803" class="ev"/><wait_chgmv/><bg @l="805" src="white"/><call @l="808" target="EventLabel_51@ending13"/><return @l="809" value="0&#13;&#10;"/><label @l="812" id="EventLabel_148"/><char @l="815" id="miho" pos="auto" src="miho115"/><bgm @l="818" src="bgm13" volume="1."/><msg @l="820" char_id="-1" frame_id="-1" name="声音"   text="『呼哈哈哈哈！我终于追上你了！』" voices=""/><msg @l="822" char_id="0" frame_id="-1" name="美帆" text="『啊…！』" voices=""/><clear @l="825" class="char"/><char @l="827" id="miho" pos="left" src="miho115"/><char @l="829" id="kuma" pos="right" src="kuma018"/><msg @l="831" char_id="-1" frame_id="-1" name="熊野"   text="『真是的……让我费了这么大功夫。』" voices=""/><msg @l="833" char_id="-1" frame_id="-1" name=""   text="突然，一道黑影从头顶掠过，随即眼前站着一个眼睛闪烁着红光的熊野。" voices=""/><msg @l="834" char_id="-1" frame_id="-1" name=""   text="但是，感觉比平常的熊野要大上一圈。" voices=""/><msg @l="836" char_id="-1" frame_id="-1" name="熊野"   text="『连我都不得不用药了……本来应该直接杀了你的。』" voices=""/><msg @l="837" char_id="0" frame_id="-1" name="美帆"   text="『这、这怎么……竟然追上来了……。』" voices=""/><char @l="840" id="miho" pos="left" src="miho114"/><msg @l="842" char_id="0" frame_id="-1" name="美帆" text="『那、奈那子呢……她怎么样了！？』"   voices=""/><msg @l="844" char_id="-1" frame_id="-1" name="熊野"   text="『啊，那个小姑娘现在应该已经成了欲望的俘虏了。』" voices=""/><char @l="847" id="miho" pos="left" src="miho115"/><msg @l="849" char_id="0" frame_id="-1" name="美帆" text="『诶……？。』" voices=""/><msg @l="851" char_id="-1" frame_id="-1" name="熊野"   text="『看起来她能做一点，但终究只是个小丫头。不到半刻就会变成色情狂吧？』" voices=""/><char @l="854" id="miho" pos="left" src="miho015"/><msg @l="856" char_id="0" frame_id="-1" name="美帆" text="『怎么会……』" voices=""/><msg @l="858" char_id="-1" frame_id="-1" name="熊野"   text="『放心吧，你也马上就会被带到与那个小丫头同样的世界。』" voices=""/><msg @l="860" char_id="-1" frame_id="-1" name=""   text="说着，熊野一步一步慢慢地靠近过来。" voices=""/><msg @l="862" char_id="0" frame_id="-1" name="美帆"   text="『不要……别、别过来…………』" voices=""/><msg @l="864" char_id="-1" frame_id="-1" name="熊野" text="『呵呵……认命吧。』"   voices=""/><msg @l="866" char_id="0" frame_id="-1" name="美帆" text="『不要，不要啊啊啊啊啊啊啊！！』"   voices="miho10750"/><clear @l="869" class="all"/><stopbgm @l="871" fadeout="1000"/><wait @l="873" time="6000"/><msgshow @l="876" show="true"/><call @l="880" target="EventLabel_55@ex_ending01"/><return @l="881" value="0&#13;&#10;"/><return @l="884" value=""/></code></xscript>																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																										