<?xml version="1.0" encoding="utf-8"?><xscript><debug editor="&quot;C:\Program&#32;Files&#32;(x86)\sakura\sakura.exe&quot;&#32;&quot;%src%&quot;&#32;-Y=%line%"   src="D:\シロップ\町ぐるみの罠＋汚された夏セット版\汚された夏\完成データ\汚された夏\script\text\root_akina_c_ev02.txt"/><code><label @l="12" id="EventLabel_86"/><description @l="16" text="绝望之日"/><goto @l="19" cond="!(f.留学生に抵抗したflag&#32;==&#32;1)&#13;&#10;"   label="TempLabel_226"/><eval @l="23" expr="f.numDay=12&#13;&#10;"/><msgshow @l="25" show="false"/><wait_chgmv/><bg @l="27" src="day12" time="2000"/><wait @l="29" time="500"/><wait_chgmv/><bg @l="31" src="black" time="2000"/><msgshow @l="33" show="true"/><goto @l="36" label="TempLabel_227"/><label @l="37" id="TempLabel_226"/><eval @l="41" expr="f.numDay=13&#13;&#10;"/><msgshow @l="43" show="false"/><wait_chgmv/><bg @l="45" src="day13" time="2000"/><wait @l="47" time="500"/><wait_chgmv/><bg @l="49" src="black" time="2000"/><msgshow @l="51" show="true"/><label @l="54" id="TempLabel_227"/><wait_chgmv/><bg @l="59" src="bg01"/><bgm @l="63" src="bgm03" volume="1."/><msg @l="65" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="67" char_id="-1" frame_id="-1" name="" text="早晨……早已过去了。"   voices=""/><msg @l="68" char_id="-1" frame_id="-1" name=""   text="房间里的数字钟显示现在是13点55分。" voices=""/><msg @l="69" char_id="-1" frame_id="-1" name=""   text="我……仍然躺在床上，凝视着天花板。" voices=""/><msg @l="70" char_id="-1" frame_id="-1" name=""   text="从那噩梦般的事件过去了一晚……。" voices=""/><msg @l="72" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="74" char_id="-1" frame_id="-1" name="" text="什么也，思考不了。"   voices=""/><msg @l="75" char_id="-1" frame_id="-1" name="" text="不……是什么都不想思考。"   voices=""/><msg @l="76" char_id="-1" frame_id="-1" name="" text="真想把一切都忘掉。" voices=""/><msg @l="77" char_id="-1" frame_id="-1" name="" text="一切，真想当作都没发生过。"   voices=""/><msg @l="78" char_id="-1" frame_id="-1" name=""   text="在身体被玷污的过程中，以及之后……无数次地这么想。" voices=""/><msg @l="79" char_id="-1" frame_id="-1" name="" text="但是，事实永远不会为我改变。"   voices=""/><msg @l="81" char_id="1" frame_id="-1" name="声音" text="『美帆……午饭怎么办？』"   voices=""/><msg @l="83" char_id="-1" frame_id="-1" name="" text="门外传来了玲姐的声音。"   voices=""/><msg @l="84" char_id="-1" frame_id="-1" name=""   text="和平常一样的声音……玲姐根本不知道我身上发生了什么。" voices=""/><msg @l="85" char_id="-1" frame_id="-1" name=""   text="昨天，失去意识的我在深夜无人的更衣室里醒来。" voices=""/><msg @l="86" char_id="-1" frame_id="-1" name=""   text="洗了个澡……无声地哭泣……然后回来了。" voices=""/><msg @l="87" char_id="-1" frame_id="-1" name=""   text="偷偷地回到房间，不让人发现……" voices=""/><msg @l="88" char_id="-1" frame_id="-1" name="" text="从那之后我一直把自己关在房间里。"   voices=""/><msg @l="90" char_id="1" frame_id="-1" name="玲" text="『还在睡吗？』" voices=""/><msg @l="92" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="94" char_id="1" frame_id="-1" name="玲" text="『课……今天没有吗？』"   voices=""/><msg @l="96" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="98" char_id="1" frame_id="-1" name="玲"   text="『虽然不知道发生了什么，但总之你至少要吃点饭。』" voices=""/><msg @l="100" char_id="1" frame_id="-1" name="玲"   text="『你……从昨天开始什么都没吃吧？』" voices=""/><msg @l="102" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="104" char_id="1" frame_id="-1" name="玲" text="『……美帆，你真的在睡觉吗？』"   voices=""/><msg @l="106" char_id="0" frame_id="-1" name="美帆" text="『……放过……我。』"   voices=""/><msg @l="108" char_id="1" frame_id="-1" name="玲" text="『啊……？』" voices=""/><msg @l="110" char_id="0" frame_id="-1" name="美帆"   text="『请别管我！……拜托了……。』" voices=""/><msg @l="112" char_id="1" frame_id="-1" name="玲" text="『美帆……。』" voices=""/><msg @l="114" char_id="0" frame_id="-1" name="美帆"   text="『我什么都不想说，也什么都不想吃……所以。』" voices=""/><msg @l="116" char_id="1" frame_id="-1" name="玲"   text="『好吧，我明白了……对不起，我不会问什么的。』" voices=""/><msg @l="118" char_id="1" frame_id="-1" name="玲"   text="『午饭……虽然只是意大利面，我放在桌子上了。』" voices=""/><msg @l="120" char_id="1" frame_id="-1" name="玲" text="『饿了就吃吧。那我先走了。』"   voices=""/><se @l="124" buf="1" src="遠ざかっていく足音_室内" volume="1."/><msg @l="126" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="128" char_id="0" frame_id="-1" name="美帆"   text="『……呜……呜呜……。』" voices=""/><msg @l="130" char_id="-1" frame_id="-1" name=""   text="听着渐行渐远的脚步声，我把脸埋在枕头里哭了起来。" voices=""/><msg @l="131" char_id="-1" frame_id="-1" name="" text="不能让她听到我的声音。"   voices=""/><msg @l="132" char_id="-1" frame_id="-1" name="" text="不能牵连玲。"   voices=""/><msg @l="133" char_id="-1" frame_id="-1" name=""   text="这么想着……拼命地、压抑着自己的声音———。" voices=""/><stopbgm @l="137" fadeout="1000"/><se @l="141" buf="3" loop="true" src="着メロ2" volume="1."/><msg @l="143" char_id="0" frame_id="-1" name="美帆" text="『……！！』" voices=""/><msg @l="145" char_id="-1" frame_id="-1" name="" text="突如其来的电子音，让我不由得肩膀颤抖起来。"   voices=""/><msg @l="146" char_id="-1" frame_id="-1" name="" text="有种……不好的预感。" voices=""/><msg @l="148" char_id="0" frame_id="-1" name="美帆" text="『………。』" voices=""/><msg @l="150" char_id="-1" frame_id="-1" name=""   text="从一直放在包里的手机中取出，战战兢兢地看向屏幕。" voices=""/><msg @l="151" char_id="-1" frame_id="-1" name="" text="来电显示是——。" voices=""/><se @l="155" buf="3" loop="true" src="心臓" volume="1."/><msg @l="157" char_id="-1" frame_id="-1" name="" text="中根&#32;秋菜&#32;手机"   voices=""/><stopse @l="161" buf="3"/><msg @l="163" char_id="0" frame_id="-1" name="美帆" text="『………。』" voices=""/><msg @l="165" char_id="-1" frame_id="-1" name="" text="我无法呼吸。" voices=""/><msg @l="166" char_id="-1" frame_id="-1" name=""   text="拿着手机的手不由自主地颤抖起来。" voices=""/><msg @l="167" char_id="-1" frame_id="-1" name="" text="亚季奈不能——知道这件事。"   voices=""/><msg @l="168" char_id="-1" frame_id="-1" name=""   text="无论如何都不能牵连亚季奈。" voices=""/><msg @l="169" char_id="-1" frame_id="-1" name="" text="要尽量正常地接电话……"   voices=""/><stopse @l="173" buf="3"/><char @l="177" id="miho" pos="auto" src="miho136"/><msg @l="179" char_id="0" frame_id="-1" name="美帆" text="『喂……』" voices=""/><msg @l="181" char_id="2" frame_id="-1" name="声音" text="『………』" voices=""/><char @l="185" id="miho" pos="auto" src="miho134"/><msg @l="187" char_id="0" frame_id="-1" name="美帆" text="『亚季奈……喂，是亚季奈对吧？』"   voices=""/><msg @l="189" char_id="2" frame_id="-1" name="亚季奈"   text="『呜……嗯…姐姐………』" voices=""/><msg @l="191" char_id="0" frame_id="-1" name="美帆"   text="『亚季奈！……你现在在哪里？』" voices=""/><msg @l="193" char_id="2" frame_id="-1" name="亚季奈" text="『在游泳池……这里。』"   voices=""/><msg @l="195" char_id="0" frame_id="-1" name="美帆" text="『难道，你被做了什么……？』"   voices=""/><msg @l="197" char_id="2" frame_id="-1" name="亚季奈"   text="『我……没被……做什么……，但是，姐姐……。』" voices=""/><msg @l="199" char_id="2" frame_id="-1" name="亚季奈"   text="『如果姐姐不来的话……会……做过分的事……说……。』" voices=""/><char @l="203" id="miho" pos="auto" src="miho135"/><msg @l="205" char_id="0" frame_id="-1" name="美帆"   text="『那个人……渡部老师是这么说的对吧？』" voices=""/><msg @l="207" char_id="2" frame_id="-1" name="亚季奈" text="『嗯……。』" voices=""/><msg @l="209" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="211" char_id="2" frame_id="-1" name="亚季奈"   text="『怎么办……姐姐，我……怎么办……。』" voices=""/><msg @l="213" char_id="2" frame_id="-1" name="亚季奈" text="『呜……。』" voices=""/><msg @l="215" char_id="0" frame_id="-1" name="美帆" text="『马上……。』" voices=""/><char @l="219" id="miho" pos="auto" src="miho035"/><msg @l="221" char_id="0" frame_id="-1" name="美帆"   text="『我马上就去，请你这样转告渡部老师。』" voices=""/><msg @l="223" char_id="2" frame_id="-1" name="亚季奈" text="『姐姐……。』"   voices=""/><msg @l="225" char_id="0" frame_id="-1" name="美帆"   text="『没事的……我一定，会救你的……。』" voices=""/><msg @l="227" char_id="-1" frame_id="-1" name="" text="亚季奈，我一定要救她……。"   voices=""/><msg @l="228" char_id="-1" frame_id="-1" name="" text="即使……我遭遇什么样的对待也在所不惜。"   voices=""/><stopbgm @l="232" fadeout="1000"/><clear @l="238" class="all"/><wait_chgmv/><bg @l="242" src="bg10"/><bgm @l="246" src="bgm10" volume="1."/><char @l="250" id="watab" pos="auto" src="watabe010"/><msg @l="252" char_id="-1" frame_id="-1" name="渡部" text="『哟，来得真晚啊。』"   voices=""/><msg @l="254" char_id="-1" frame_id="-1" name=""   text="这样迎接我的渡部老师表情中带着某种得意与满足。" voices=""/><msg @l="255" char_id="-1" frame_id="-1" name="" text="……亚季奈，不在这里。"   voices=""/><clear @l="258" class="char"/><char @l="260" id="watab" pos="left" src="watabe010"/><char @l="263" id="miho" pos="right" src="miho114"/><msg @l="265" char_id="0" frame_id="-1" name="美帆"   text="『那孩子……亚季奈在哪里！？』" voices=""/><msg @l="267" char_id="-1" frame_id="-1" name="渡部"   text="『啊，那家伙的话大概在更衣室吧？』" voices=""/><msg @l="269" char_id="0" frame_id="-1" name="美帆" text="『……！？』" voices=""/><msg @l="271" char_id="0" frame_id="-1" name="美帆"   text="『你又对亚季奈做了什么！？』" voices=""/><msg @l="273" char_id="-1" frame_id="-1" name="渡部"   text="『如果那么担心的话，不如去看看？』" voices=""/><char @l="275" id="miho" pos="right" src="miho015"/><msg @l="277" char_id="0" frame_id="-1" name="美帆" text="『呃……！！』" voices=""/><clear @l="283" class="all"/><wait_chgmv/><bg @l="287" src="bg11"/><char @l="291" id="miho" pos="auto" src="miho114"/><msg @l="293" char_id="0" frame_id="-1" name="美帆" text="『亚季奈！！』" voices=""/><clear @l="296" class="char"/><char @l="298" id="miho" pos="left" src="miho114"/><char @l="301" id="akina" pos="right" src="akina054"/><msg @l="303" char_id="2" frame_id="-1" name="亚季奈" text="『姐姐！！！』"   voices=""/><msg @l="305" char_id="0" frame_id="-1" name="美帆"   text="『你没事吧？没有被做什么过分的事吧！？』" voices=""/><char @l="309" id="akina" pos="right" src="akina055"/><msg @l="311" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯，嗯……我没事，但是……。』" voices=""/><char @l="315" id="watab" pos="right" src="watabe010"/><msg @l="317" char_id="-1" frame_id="-1" name="渡部"   text="『即使牺牲自己也要救妹妹……吗。』" voices=""/><msg @l="319" char_id="-1" frame_id="-1" name="渡部"   text="『哎呀哎呀，姐妹之爱真是了不起啊。』" voices=""/><char @l="322" id="miho" pos="left" src="miho015"/><msg @l="324" char_id="0" frame_id="-1" name="美帆"   text="『你就这样轻易地践踏别人的心……』" voices=""/><msg @l="326" char_id="0" frame_id="-1" name="美帆"   text="『你不觉得羞耻吗……！？』" voices=""/><msg @l="328" char_id="-1" frame_id="-1" name="渡部"   text="『很遗憾，我没有这种想法呢。』" voices=""/><char @l="332" id="akina" pos="right" src="akina055"/><msg @l="334" char_id="2" frame_id="-1" name="亚季奈" text="『姐姐……我……』"   voices=""/><char @l="338" id="miho" pos="left" src="miho010"/><msg @l="340" char_id="0" frame_id="-1" name="美帆"   text="『亚季奈，你先回去吧……这里，交给我。』" voices=""/><msg @l="342" char_id="2" frame_id="-1" name="亚季奈" text="『但是……』" voices=""/><char @l="345" id="miho" pos="left" src="miho116"/><msg @l="347" char_id="0" frame_id="-1" name="美帆" text="『没关系，交给我……好吗？』"   voices=""/><msg @l="349" char_id="2" frame_id="-1" name="亚季奈" text="『嗯，嗯……』"   voices=""/><clear @l="353" layer="akina"/><msg @l="355" char_id="-1" frame_id="-1" name=""   text="就这样，亚季奈一边观察着渡部老师的样子，一边走出了更衣室。" voices=""/><msg @l="356" char_id="-1" frame_id="-1" name=""   text="渡部老师只是用余光追随她的身影……看起来并没有特别在意。" voices=""/><char @l="363" id="watab" pos="right" src="watabe010"/><msg @l="365" char_id="0" frame_id="-1" name="美帆" text="『那么……今天找我有什么事呢？』"   voices=""/><msg @l="367" char_id="-1" frame_id="-1" name="渡部"   text="『哼，把游泳部的教练叫到游泳池来，不就只有一件事吗？』" voices=""/><msg @l="369" char_id="0" frame_id="-1" name="美帆" text="『……真是难以置信。』"   voices=""/><msg @l="371" char_id="-1" frame_id="-1" name="渡部"   text="『如果你不能接受，我可以让你妹妹来代替你。』" voices=""/><char @l="375" id="miho" pos="left" src="miho114"/><msg @l="377" char_id="0" frame_id="-1" name="美帆" text="『……！！』" voices=""/><msg @l="379" char_id="-1" frame_id="-1" name="渡部"   text="『毕竟就算集训结束后，你妹妹还是会在我眼皮底下。』" voices=""/><msg @l="381" char_id="-1" frame_id="-1" name="渡部"   text="『我要是有心的话，随时都可以……就是这意思。』" voices=""/><char @l="385" id="miho" pos="left" src="miho115"/><msg @l="387" char_id="0" frame_id="-1" name="美帆" text="『呃……。』" voices=""/><msg @l="389" char_id="-1" frame_id="-1" name="渡部"   text="『我倒是无所谓是谁……。』" voices=""/><msg @l="391" char_id="-1" frame_id="-1" name="渡部" text="『你怎么选？』" voices=""/><char @l="393" id="miho" pos="left" src="miho015"/><msg @l="394" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="396" char_id="0" frame_id="-1" name="美帆"   text="『我明白了……如果我听你的话，你能保证绝对不会碰我妹妹吗？』" voices=""/><msg @l="398" char_id="-1" frame_id="-1" name="渡部" text="『那就要看你的态度了。』"   voices=""/><char @l="400" id="miho" pos="left" src="miho115"/><msg @l="401" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><stopbgm @l="405" fadeout="1000"/><clear @l="411" class="all"/><msgshow @l="413" show="true"/><wait_chgmv/><bg @l="417" src="bg10"/><bgm @l="421" src="bgm02" volume="1."/><char @l="425" id="miho" pos="auto" src="miho060"/><msg @l="427" char_id="0" frame_id="-1" name="美帆"   text="『好，手臂再伸直一点……肩膀放松。』" voices=""/><msg @l="429" char_id="0" frame_id="-1" name="美帆"   text="『自己掌握节奏，在合适的时机呼吸，这样就不容易失去平衡了。』" voices=""/><msg @l="431" char_id="-1" frame_id="-1" name="游泳部成员" text="『好的，我明白了！』"   voices=""/><char @l="435" id="miho" pos="auto" src="miho061"/><msg @l="437" char_id="0" frame_id="-1" name="美帆" text="『加油。』" voices=""/><msg @l="439" char_id="-1" frame_id="-1" name="游泳部成员" text="『谢谢您！』"   voices=""/><msg @l="441" char_id="-1" frame_id="-1" name=""   text="我……试图营造出一如往常的景象。" voices=""/><msg @l="442" char_id="-1" frame_id="-1" name=""   text="我试着告诉自己，昨天发生的事情只是一场噩梦。" voices=""/><msg @l="443" char_id="-1" frame_id="-1" name="" text="但是，亚季奈不在这里。"   voices=""/><msg @l="444" char_id="-1" frame_id="-1" name=""   text="那孩子可能……再也不会回到这里来了。" voices=""/><msg @l="445" char_id="-1" frame_id="-1" name=""   text="也许她会完全放弃游泳。" voices=""/><msg @l="446" char_id="-1" frame_id="-1" name="" text="就像三年前的我一样……"   voices=""/><clear @l="449" class="char"/><char @l="451" id="miho" pos="auto" src="miho060"/><stopbgm @l="457" fadeout="1000"/><msg @l="459" char_id="-1" frame_id="-1" name="渡部"   text="『怎么了，在发什么呆呢……教练。』" voices=""/><char @l="463" id="miho" pos="auto" src="miho165"/><msg @l="465" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><bgm @l="469" src="bgm10" volume="1."/><msg @l="471" char_id="-1" frame_id="-1" name=""   text="回过神来，渡部老师已经悄悄靠近了我的背后。" voices=""/><msg @l="472" char_id="-1" frame_id="-1" name="" text="他的目的是什么……不用确认也知道。"   voices=""/><msg @l="473" char_id="-1" frame_id="-1" name="" text="他又来贪求我的身体了吧。"   voices=""/><char @l="477" id="miho" pos="auto" src="miho166"/><msg @l="479" char_id="0" frame_id="-1" name="美帆" text="『……我按照您说的去做了。』"   voices=""/><msg @l="482" char_id="-1" frame_id="-1" name="渡部"   text="『你没必要这么冷淡吧。』" voices=""/><msg @l="484" char_id="-1" frame_id="-1" name="渡部"   text="『我只是想通过肢体接触加深顾问和教练之间的感情而已。嘿嘿嘿。』" voices=""/><clear @l="487" class="char"/><char @l="490" id="miho" pos="center" src="miho165f" y="-80"/><begin_trans @l="494" time="500"/><layer @l="495" id="cutin_f" src="game_window_cutin" x="20" y="20" z="-1001"/><layer @l="496" id="cutin" src="cut004" x="32" y="32" z="-1000"/><end_trans @l="497"/><msg @l="499" char_id="-1" frame_id="-1" name=""   text="说着，渡部老师隔着泳衣开始抚摸我的臀部。" voices=""/><msg @l="501" char_id="-1" frame_id="-1" name="渡部"   text="『还是说……你不喜欢这种肢体接触？』" voices=""/><msg @l="503" char_id="-1" frame_id="-1" name=""   text="渡部老师在我耳边低语，嘴角露出邪恶的笑容。" voices=""/><msg @l="504" char_id="-1" frame_id="-1" name=""   text="如果我说不……矛头就会指向亚季奈。" voices=""/><msg @l="505" char_id="-1" frame_id="-1" name="" text="从一开始就没有选择的余地。"   voices=""/><msg @l="507" char_id="0" frame_id="-1" name="美帆"   text="『无论是肢体接触还是什么都请随意……。』" voices="miho02660"/><msg @l="509" char_id="0" frame_id="-1" name="美帆"   text="『只是……请不要让其他人发现。』" voices="miho02670"/><msg @l="511" char_id="-1" frame_id="-1" name="渡部" text="『那就看你自己了。』"   voices=""/><msg @l="513" char_id="-1" frame_id="-1" name="渡部"   text="『尽量不要让其他队员发现……想办法蒙混过关吧。』" voices=""/><msg @l="515" char_id="-1" frame_id="-1" name=""   text="说着，渡部老师愉快地开始像揉捏一样搓弄我的臀部。" voices=""/><msg @l="516" char_id="-1" frame_id="-1" name=""   text="更过分的是，他试图将食指和中指滑进我的大腿内侧。" voices=""/><char @l="519" id="miho" pos="center" src="miho166f" y="-80"/><msg @l="520" char_id="0" frame_id="-1" name="美帆"   text="（不能在意，现在必须专注于训练……）" voices="miho02680"/><msg @l="522" char_id="-1" frame_id="-1" name=""   text="我装作若无其事，试图将视线重新投向在隔壁泳道游泳的孩子。" voices=""/><msg @l="523" char_id="-1" frame_id="-1" name=""   text="但是……这种装出来的平静也不得不因渡部老师的下一步行动而崩溃。" voices=""/><char @l="527" id="miho" pos="center" src="miho064f" y="-80"/><msg @l="529" char_id="0" frame_id="-1" name="美帆" text="『诶……。』"   voices="miho02690"/><msg @l="531" char_id="-1" frame_id="-1" name=""   text="渡部老师的手伸向固定泳衣的绳结，试图解开它。" voices=""/><msg @l="533" char_id="0" frame_id="-1" name="美帆" text="『不……你、你在做什么！？』"   voices="miho02700"/><msg @l="535" char_id="-1" frame_id="-1" name="渡部"   text="『喂，怎么了……你不用管我，继续指导不就好了。』" voices=""/><msg @l="537" char_id="-1" frame_id="-1" name=""   text="他嘴角浮现出一丝得意的笑容低声说道，渡部老师仍然不停地摆弄着我泳衣的结。" voices=""/><char @l="540" id="miho" pos="center" src="miho164f" y="-80"/><msg @l="541" char_id="0" frame_id="-1" name="美帆" text="『啊……』"   voices="miho02710"/><begin_trans @l="545" time="500"/><layer @l="546" id="cutin_f" src="game_window_cutin" x="20" y="20" z="-1001"/><layer @l="547" id="cutin" src="cut003" x="32" y="32" z="-1000"/><end_trans @l="548"/><msg @l="550" char_id="-1" frame_id="-1" name=""   text="围裙式泳裙被解开，里面的泳裤也被拉了下来。" voices=""/><msg @l="551" char_id="-1" frame_id="-1" name=""   text="仅仅是失去了覆盖下半身的那块小小的布料，顿时大腿间流过的水的触感变得异常真实。" voices=""/><char @l="555" id="miho" pos="center" src="miho065f" y="-80"/><msg @l="557" char_id="0" frame_id="-1" name="美帆"   text="『请停下……会被游泳部的孩子们发现的。』" voices="miho02720"/><msg @l="559" char_id="-1" frame_id="-1" name="渡部"   text="『既然明白那就自己遮掩啊。被发现的话，困扰的是你吧？』" voices=""/><msg @l="561" char_id="-1" frame_id="-1" name="渡部"   text="『尽量努力不要被发现吧。』" voices=""/><char @l="565" id="miho" pos="center" src="miho164f" y="-80"/><msg @l="567" char_id="0" frame_id="-1" name="美帆" text="『这种事……！！』"   voices="miho02730"/><msg @l="569" char_id="-1" frame_id="-1" name="游泳部成员B"   text="『那个……美帆教练，您怎么了吗？』" voices=""/><char @l="573" id="miho" pos="center" src="miho163f" y="-80"/><msg @l="575" char_id="0" frame_id="-1" name="美帆"   text="『啊……那个，没什么……没什么事。』" voices="miho02740"/><msg @l="577" char_id="-1" frame_id="-1" name="游泳部成员B"   text="『可是，您的脸好像有点红啊？』" voices=""/><msg @l="579" char_id="0" frame_id="-1" name="美帆" text="『没、没有那回事……』"   voices="miho02750"/><msg @l="581" char_id="-1" frame_id="-1" name="游泳部成员B" text="『是吗？』"   voices=""/><char @l="583" id="miho" pos="center" src="miho165f" y="-80"/><msg @l="584" char_id="0" frame_id="-1" name="美帆" text="『……。』"   voices="miho02760"/><msg @l="586" char_id="-1" frame_id="-1" name=""   text="在这样的对话交流过程中，水面下渡部老师的手指正插入着我裸露的私处。" voices=""/><msg @l="587" char_id="-1" frame_id="-1" name=""   text="水的冰冷触感和从粗糙手指传来的热度之间的不平衡……给那里带来了奇妙的刺激。" voices=""/><char @l="591" id="miho" pos="center" src="miho164f" y="-80"/><msg @l="593" char_id="0" frame_id="-1" name="美帆" text="『嗯……』"   voices="miho02770"/><msg @l="595" char_id="-1" frame_id="-1"   name="" text="原本在阴道口周围游走的手指，现在深入到了缝隙深处。我不由自主地发出了声音。"   voices=""/><msg @l="596" char_id="-1" frame_id="-1" name=""   text="前来搭话的游泳部的孩子，疑惑地注视着这样的我。" voices=""/><msg @l="597" char_id="-1" frame_id="-1" name=""   text="我露出苦笑回答“没什么事”后……她再次回去继续练习了。" voices=""/><msg @l="599" char_id="-1" frame_id="-1" name="渡部"   text="『喂喂，刚才那个很危险不是吗？』" voices=""/><char @l="602" id="miho" pos="center" src="miho163f" y="-80"/><msg @l="604" char_id="0" frame_id="-1" name="美帆"   text="『那是因为你啊…呀…嗯嗯…。』" voices="miho02780"/><msg @l="606" char_id="-1" frame_id="-1" name=""   text="渡部老师在已经插入的食指之外，又将中指伸入私处，用指腹来回抚摸着秘壁。" voices=""/><msg @l="608" char_id="-1" frame_id="-1" name="渡部"   text="『喂…我怎么了…？』" voices=""/><char @l="612" id="miho" pos="center" src="miho166f" y="-80"/><msg @l="614" char_id="0" frame_id="-1" name="美帆"   text="『没什么…练习，不用继续了吗？』" voices="miho02790"/><msg @l="616" char_id="-1" frame_id="-1" name="渡部" text="『练习的话你自己教不就行了吗？』"   voices=""/><msg @l="618" char_id="-1" frame_id="-1" name="渡部"   text="『我在享用你的那里，你别在意继续做你的事。』" voices=""/><char @l="620" id="miho" pos="center" src="miho163f" y="-80"/><msg @l="621" char_id="0" frame_id="-1" name="美帆" text="『啊…嗯嗯。』"   voices="miho02800"/><msg @l="623" char_id="-1" frame_id="-1" name=""   text="渡部老师插入秘处的手指撑开缝隙，进一步侵入深处。" voices=""/><msg @l="624" char_id="-1" frame_id="-1" name=""   text="被撑开的阴道口让泳池的水流入，他的手指同时搅动着子宫内部和水流。" voices=""/><msg @l="626" char_id="0" frame_id="-1" name="美帆"   text="(嗯嗯…不要……但是……就算抵抗也只会让这个人更高兴……)" voices="miho02810"/><char @l="629" id="miho" pos="center" src="miho060f" y="-80"/><msg @l="630" char_id="0" frame_id="-1" name="美帆"   text="(在这种情况下，只能假装若无其事地忍耐了吗……)" voices="miho02820"/><msg @l="632" char_id="-1" frame_id="-1" name=""   text="为了不让注意力被渡部老师蠕动的手指吸引，我再次将视线转向旁边的泳道。" voices=""/><msg @l="633" char_id="-1" frame_id="-1" name=""   text="可能是因为我有段时间没有发出指示，大家似乎都在以各自的方式继续练习。" voices=""/><msg @l="635" char_id="-1" frame_id="-1" name="渡部"   text="『哦……打算忍耐是吗。』" voices=""/><msg @l="637" char_id="-1" frame_id="-1" name=""   text="看穿了我意图的渡部老师，像是想到了什么，脸上浮现出淫邪的笑容。" voices=""/><msg @l="638" char_id="-1" frame_id="-1" name=""   text="他开始反复地将插入的手指慢慢抽出，然后再推向更深处。" voices=""/><char @l="642" id="miho" pos="center" src="miho164f" y="-80"/><msg @l="644" char_id="0" frame_id="-1" name="美帆" text="『啊……嗯嗯！！』"   voices="miho02830"/><msg @l="646" char_id="-1" frame_id="-1" name=""   text="突然的刺激让我不由自主地发出了声音。" voices=""/><msg @l="647" char_id="-1" frame_id="-1" name=""   text="幸好……附近没有游泳部的学生，似乎没有人听到。" voices=""/><char @l="651" id="miho" pos="center" src="miho166f" y="-80"/><msg @l="653" char_id="0" frame_id="-1" name="美帆"   text="『请停下……求您了……』" voices="miho02840"/><msg @l="655" char_id="0" frame_id="-1" name="美帆"   text="『被这样对待……唔，我没法集中精神练习。』" voices="miho02850"/><msg @l="657" char_id="-1" frame_id="-1" name="渡部"   text="『不是没法，而是必须做到。』" voices=""/><char @l="659" id="miho" pos="center" src="miho065f" y="-80"/><msg @l="660" char_id="0" frame_id="-1" name="美帆" text="『怎么可能啊。』"   voices="miho02860"/><msg @l="662" char_id="-1" frame_id="-1" name="渡部"   text="『而且，这种程度就认输的话，你可承受不了那个东西。』" voices=""/><char @l="664" id="miho" pos="center" src="miho064f" y="-80"/><msg @l="665" char_id="0" frame_id="-1" name="美帆" text="『啊……』"   voices="miho02870"/><begin_trans @l="669" time="500"/><clear @l="670" layer="cutin_f"/><clear @l="671" layer="cutin"/><end_trans @l="672"/><msg @l="674" char_id="-1" frame_id="-1" name=""   text="玩弄的手指突然抽出，取而代之的是一个热且硬的东西抵在我的秘处。" voices=""/><msg @l="675" char_id="-1" frame_id="-1" name=""   text="我不可能忘记……那是昨天贯穿我身体的肉棒。" voices=""/><char @l="679" id="miho" pos="center" src="miho164f" y="-80"/><msg @l="681" char_id="0" frame_id="-1" name="美帆" text="『不会吧……您疯了吗！？』"   voices="miho02880"/><msg @l="683" char_id="-1" frame_id="-1" name="渡部"   text="『如果要说是清醒还是疯狂，我早就是后者了。』" voices=""/><msg @l="685" char_id="-1" frame_id="-1" name="渡部"   text="『从三年前……试图袭击你的那时起就是！』" voices=""/><label @l="688" id="event_scene18"/><label @l="692" id="chart_line24"/><wait_chgmv/><ev @l="696" src="ev-018"/><description @l="699" text="水中插入"/><bgm @l="703" src="bgm14" volume="1."/><msg @l="705" char_id="0" frame_id="-1" name="美帆" text="『嗯啊……！！』"   voices="miho02890"/><msg @l="707" char_id="-1" frame_id="-1" name=""   text="那坚硬挺立的东西撑开秘处，咕叽咕叽地深深插入。" voices=""/><msg @l="708" char_id="-1" frame_id="-1" name=""   text="被泳池水冷却的身体里插入的那个，就像被烧得滚烫的铁棒，在冰冷的肉壁中滋滋作响地融化着四处搅动。"   voices=""/><msg @l="710" char_id="-1" frame_id="-1" name="渡部"   text="『被水冷却的小穴感觉也不一样，真有趣啊。』" voices=""/><msg @l="712" char_id="0" frame_id="-1" name="美帆"   text="『呀啊……嗯，唔唔……在这种地方……。』" voices="miho02900"/><msg @l="714" char_id="-1" frame_id="-1" name="渡部"   text="『正因为是在这种地方，这种状况才更令人兴奋不是吗？』" voices=""/><msg @l="716" char_id="-1" frame_id="-1" name="渡部"   text="『喏……如果不好好指导一下，恐怕周围的人已经开始起疑了吧？』" voices=""/><msg @l="718" char_id="0" frame_id="-1" name="美帆" text="『才、才没有呢……嗯啊……。』"   voices="miho02910"/><msg @l="720" char_id="-1" frame_id="-1" name=""   text="确实……有好几个孩子用怀疑的眼神看着这边。" voices=""/><msg @l="721" char_id="-1" frame_id="-1" name="" text="没有下达新的指示。"   voices=""/><msg @l="722" char_id="-1" frame_id="-1" name="" text="和顾问靠得异常近。"   voices=""/><msg @l="723" char_id="-1" frame_id="-1" name="" text="状态有些奇怪。" voices=""/><msg @l="724" char_id="-1" frame_id="-1" name="" text="大概在她们眼里就是这样吧。"   voices=""/><msg @l="726" char_id="0" frame_id="-1" name="美帆"   text="『大、大家……暂且自由游泳吧。』" voices="miho02920"/><msg @l="728" char_id="0" frame_id="-1" name="美帆"   text="『如果有什么问题，我会单独……嗯嗯……指导的。』" voices="miho02930"/><msg @l="730" char_id="-1" frame_id="-1" name="游泳部成员们" text="『好——的。』"   voices=""/><msg @l="732" char_id="-1" frame_id="-1" name=""   text="情急之下……我随口下达了指示来应付过去。" voices=""/><msg @l="733" char_id="-1" frame_id="-1" name=""   text="尽管这几乎接近于“自由活动”的指示，游泳部的孩子们还是重新开始在竞泳道上游泳。" voices=""/><msg @l="735" char_id="-1" frame_id="-1" name="渡部" text="『哼……逃得倒挺巧妙。』"   voices=""/><msg @l="737" char_id="-1" frame_id="-1" name="渡部"   text="『不过，现在就放心还为时过早哦？』" voices=""/><msg @l="739" char_id="-1" frame_id="-1" name=""   text="渡部老师说着缓缓挺腰，将灼热的棒状物深深地插入。" voices=""/><msg @l="740" char_id="-1" frame_id="-1" name=""   text="我能感觉到龟头的前端分开褶皱侵入进来。" voices=""/><msg @l="742" char_id="0" frame_id="-1" name="美帆" text="『啊……。』"   voices="miho02940"/><msg @l="744" char_id="-1" frame_id="-1" name=""   text="不久……侵入的肉棒到达了最深处。" voices=""/><msg @l="745" char_id="-1" frame_id="-1" name=""   text="前端顶着内壁，身体仿佛对此做出反应一般变得灼热起来。" voices=""/><msg @l="747" char_id="-1" frame_id="-1" name="渡部" text="『哦，里面突然变热了呢？』"   voices=""/><msg @l="749" char_id="0" frame_id="-1" name="美帆" text="『……唔……。』"   voices="miho02950"/><msg @l="751" char_id="-1" frame_id="-1" name=""   text="身体深处变得如此灼热，连我自己都能感觉到。" voices=""/><msg @l="752" char_id="-1" frame_id="-1" name=""   text="明明很讨厌……应该很讨厌才对……却不由自主地起了反应。" voices=""/><msg @l="754" char_id="0" frame_id="-1" name="美帆"   text="（难道，这也是因为昨天用的药……？）" voices="miho02960"/><msg @l="756" char_id="0" frame_id="-1" name="美帆"   text="（还是说……正如渡部老师所说，因为这种状况才会有反应？）" voices="miho02970"/><msg @l="758" char_id="-1" frame_id="-1" name="渡部"   text="『怎么了，你那里已经被泳池水以外的东西弄湿了吧？』" voices=""/><msg @l="760" char_id="-1" frame_id="-1" name="渡部"   text="『这种白浊的液体可不是泳池水吧，啊？』" voices=""/><msg @l="762" char_id="0" frame_id="-1" name="美帆"   text="『别……不要说这种刻薄的话……请……唔！』" voices="miho02980"/><msg @l="764" char_id="0" frame_id="-1" name="美帆"   text="『啊……不行……请不要动……。』" voices="miho02990"/><msg @l="766" char_id="-1" frame_id="-1" name=""   text="龟头锐利地刮擦着我体内的壁壁，感受到硬挺的肉棒在整个阴道内摩擦的触感，我的腰不禁颤抖起来。" voices=""/><msg @l="768" char_id="-1" frame_id="-1" name="渡部"   text="『动的不只是我一个人吧？』" voices=""/><msg @l="770" char_id="0" frame_id="-1" name="美帆" text="『诶……。』"   voices="miho03000"/><msg @l="772" char_id="-1" frame_id="-1" name="渡部"   text="『你的腰不是正随着我的动作摇晃着吗？』" voices=""/><msg @l="774" char_id="0" frame_id="-1" name="美帆" text="『怎么会……有这种……事……。』"   voices="miho03010"/><msg @l="776" char_id="-1" frame_id="-1" name="渡部"   text="『就是有这种事，你这个淫乱的家伙……看招！』" voices=""/><msg @l="778" char_id="0" frame_id="-1" name="美帆" text="『嗯……啊，啊，嗯嗯……。』"   voices="miho03020"/><msg @l="780" char_id="-1" frame_id="-1" name=""   text="否定的话语被肆虐的肉棒搅乱了。" voices=""/><msg @l="781" char_id="-1" frame_id="-1" name="" text="明明是自己的身体却不受控制……。"   voices=""/><msg @l="782" char_id="-1" frame_id="-1" name=""   text="腰部违背我的意愿动了起来，淫液再次溢了出来。" voices=""/><msg @l="784" char_id="-1" frame_id="-1" name="渡部"   text="『看，泳池边上那个家伙……正在看这边呢。』" voices=""/><msg @l="786" char_id="0" frame_id="-1" name="美帆" text="『……！？』"   voices="miho03030"/><msg @l="788" char_id="-1" frame_id="-1" name=""   text="渡部用下巴指向的方向站着游泳部的孩子，正在盯着这边看。" voices=""/><msg @l="789" char_id="-1" frame_id="-1" name=""   text="脸涨得通红，局促不安地……。" voices=""/><msg @l="791" char_id="0" frame_id="-1" name="美帆"   text="（不会吧……她好像……在肚子那边窸窸窣窣地动着手）" voices="miho03040"/><msg @l="793" char_id="0" frame_id="-1" name="美帆"   text="（那是……她、她在自己弄吗………？）" voices="miho03050"/><msg @l="795" char_id="-1" frame_id="-1" name="渡部"   text="『那家伙怎么回事，注意到我们就开始撸起来了。』" voices=""/><msg @l="797" char_id="0" frame_id="-1" name="美帆" text="『诶……。』"   voices="miho03060"/><msg @l="799" char_id="-1" frame_id="-1" name="渡部"   text="『你不明白吗？他在把你被侵犯的样子当作下饭菜一个人自慰呢。』" voices=""/><msg @l="801" char_id="0" frame_id="-1" name="美帆" text="『………。』"   voices="miho03070"/><msg @l="803" char_id="-1" frame_id="-1" name=""   text="我再次偷偷地看了看泳池边。" voices=""/><msg @l="805" char_id="-1" frame_id="-1" name="游泳部成员" text="『………呃……。』"   voices=""/><msg @l="807" char_id="-1" frame_id="-1" name=""   text="抱着双膝坐着……大腿之间手在鬼鬼祟祟地动着。" voices=""/><msg @l="808" char_id="-1" frame_id="-1" name=""   text="时不时东张西望，虽然在意周围人的目光，但动作却没有停下。" voices=""/><msg @l="810" char_id="0" frame_id="-1" name="美帆"   text="（呜啊……总觉得，有种奇怪的感觉………）" voices="miho03080"/><msg @l="812" char_id="0" frame_id="-1" name="美帆"   text="（那么脸红……看着我的身体，看着我被侵犯，还那么认真地……动着……）"   voices="miho03090"/><msg @l="814" char_id="-1" frame_id="-1" name="渡部"   text="『真不错啊，这不是女人的福分吗？』" voices=""/><msg @l="816" char_id="0" frame_id="-1" name="美帆" text="『什……那、那种事…………。』"   voices="miho03100"/><msg @l="818" char_id="-1" frame_id="-1" name="渡部"   text="『来，好好展示你那淫荡的表情，让他射出来……教练。』" voices=""/><msg @l="820" char_id="0" frame_id="-1" name="美帆" text="『嗯啊！？』"   voices="miho03110"/><msg @l="822" char_id="-1" frame_id="-1" name=""   text="渡部老师愉快地说着，加快了腰部抽送的力度。" voices=""/><msg @l="823" char_id="-1" frame_id="-1" name=""   text="每当那又长又粗的硬物在秘肉中进出时，那粗壮膨胀的龟头部分都会刮蹭着已经发热的内壁。"   voices=""/><msg @l="825" char_id="0" frame_id="-1" name="美帆"   text="『嗯嗯……啊，啊，啊………嗯呜………。』" voices="miho03120"/><msg @l="827" char_id="0" frame_id="-1" name="美帆"   text="『嗯啊……不行……这样，被看着却还……………。』" voices="miho03130"/><msg @l="829" char_id="-1" frame_id="-1" name="渡部"   text="『话虽这么说，你这里不是紧紧吸住不放吗？』" voices=""/><msg @l="831" char_id="-1" frame_id="-1" name="" text="腰部向后抽，男根缓缓地被抽出。"   voices=""/><msg @l="832" char_id="-1" frame_id="-1" name=""   text="然而，不顾我的意愿，内壁的褶皱却缠绕着它。" voices=""/><msg @l="833" char_id="-1" frame_id="-1" name=""   text="就像是舍不得它被抽出一样……。" voices=""/><msg @l="835" char_id="0" frame_id="-1" name="美帆" text="『才，才不是……这是……。』"   voices="miho03140"/><msg @l="837" char_id="-1" frame_id="-1" name="渡部"   text="『你就是个被看着也会兴奋的变态，懂吗。』" voices=""/><msg @l="839" char_id="0" frame_id="-1" name="美帆" text="『才不是……嗯，呜啊！？』"   voices="miho03150"/><msg @l="841" char_id="-1" frame_id="-1" name=""   text="再次，那膨胀的前端被深深地插入最深处。" voices=""/><msg @l="842" char_id="-1" frame_id="-1" name=""   text="从身体深处涌上来的热感与麻痹感……无法阻止。" voices=""/><msg @l="843" char_id="-1" frame_id="-1" name=""   text="虽然我和渡部老师周围都没有游泳，水花却不自然地四溅，但我们甚至不在意这些，只是互相摆动着腰部。" voices=""/><msg @l="845" char_id="0" frame_id="-1" name="美帆"   text="『嗯……嗯，嗯，嗯……呜……。』" voices="miho03160"/><msg @l="847" char_id="0" frame_id="-1" name="美帆"   text="『啊呜……嗯，嗯嗯……不要……不要……。』" voices="miho03170"/><msg @l="849" char_id="-1" frame_id="-1" name="渡部"   text="『很好，就这样攀升吧……那家伙看起来也快到极限了。』" voices=""/><msg @l="851" char_id="-1" frame_id="-1" name="游泳部成员" text="『……唔……。』"   voices=""/><msg @l="853" char_id="-1" frame_id="-1" name=""   text="泳池边的孩子已经顾不上周围的目光，拼命地摩擦着自己的东西。" voices=""/><msg @l="854" char_id="-1" frame_id="-1" name=""   text="即使隔着泳衣……也能看出那硬挺的东西的形状。" voices=""/><msg @l="855" char_id="-1" frame_id="-1" name="" text="我咽了口唾液。"   voices=""/><msg @l="857" char_id="0" frame_id="-1" name="美帆" text="『嗯嗯……。』"   voices="miho03180"/><msg @l="860" char_id="0" frame_id="-1" name="美帆"   text="『嗯，啊啊……不行……不行……。』" voices="miho03190"/><msg @l="862" char_id="0" frame_id="-1" name="美帆"   text="『已经……不行了……我，我……。』" voices="miho03200"/><msg @l="864" char_id="-1" frame_id="-1" name="渡部"   text="『好……我也要这样射进你的子宫里。』" voices=""/><msg @l="866" char_id="0" frame_id="-1" name="美帆"   text="『不，不行……阴道里……。』" voices="miho03210"/><msg @l="868" char_id="-1" frame_id="-1" name="" text="我不由得提高了声音。"   voices=""/><msg @l="869" char_id="-1" frame_id="-1" name=""   text="就在那一瞬间……与泳池边惊讶地抬起头的孩子，四目相对。" voices=""/><msg @l="871" char_id="-1" frame_id="-1" name="游泳部成员" text="『……！？』"   voices=""/><msg @l="873" char_id="0" frame_id="-1" name="美帆" text="『啊……不，别看！！』"   voices="miho03220"/><msg @l="875" char_id="0" frame_id="-1" name="美帆"   text="『嗯，啊……去，啊，啊啊……嗯啊啊啊啊！！』" voices="miho03230"/><flash @l="879" count="4" fade="100" image="white"/><msg @l="881" char_id="-1" frame_id="-1" name=""   text="我……情不自禁地因袭来的高潮而叫出声来。" voices=""/><msg @l="882" char_id="-1" frame_id="-1" name=""   text="同时，一股热流注入了我的子宫口。" voices=""/><msg @l="883" char_id="-1" frame_id="-1" name="" text="咚咚……咚咚地……。"   voices=""/><msg @l="885" char_id="0" frame_id="-1" name="美帆"   text="『啊，啊啊……好多……射进来了……。』" voices="miho03240"/><msg @l="887" char_id="-1" frame_id="-1" name=""   text="我眼含泪水，感受着喷洒的热精，看向在泳池边自慰的男孩。" voices=""/><msg @l="889" char_id="-1" frame_id="-1" name="游泳部成员"   text="『哈……哈……哈……！！』" voices=""/><msg @l="891" char_id="-1" frame_id="-1" name=""   text="泳池边的孩子……从泳衣的边缘渗出了乳白色的液体。" voices=""/><msg @l="892" char_id="-1" frame_id="-1" name=""   text="看来他和我同时达到了高潮……。" voices=""/><msg @l="894" char_id="-1" frame_id="-1" name="渡部"   text="『被看着高潮啊……看来你就好这一口，哈哈哈。』" voices=""/><wait_chgmv/><ev @l="898" src="ev-018x1z1"/><msg @l="900" char_id="0" frame_id="-1" name="美帆" text="『嗯嗯……。』"   voices="miho03250"/><msg @l="902" char_id="-1" frame_id="-1" name=""   text="渡部老师在我耳边低语着，满足地抽出了他的肉块。" voices=""/><msg @l="903" char_id="-1" frame_id="-1" name=""   text="从秘口溢出的精液混入泳池的水中……污浊地搅混了水质。" voices=""/><clear @l="909" class="all"/><end_scene @l="912"/><msg @l="914" char_id="-1" frame_id="-1" name="游泳部成员A"   text="『喂，喂……刚才那个特别淫荡的叫声是……。』" voices=""/><msg @l="916" char_id="-1" frame_id="-1" name="游泳部成员B"   text="『真的假的，仲根姐姐和渡部在泳池里面直接做了？』" voices=""/><msg @l="918" char_id="-1" frame_id="-1" name="游泳部成员C"   text="『不会吧……这样我们就不能下水了！』" voices=""/><msg @l="920" char_id="-1" frame_id="-1" name="" text="从某处传来了声音。"   voices=""/><msg @l="921" char_id="-1" frame_id="-1" name="" text="欢喜的声音。" voices=""/><msg @l="922" char_id="-1" frame_id="-1" name="" text="侮蔑的声音。" voices=""/><msg @l="923" char_id="-1" frame_id="-1" name="" text="好色的声音。" voices=""/><msg @l="924" char_id="-1" frame_id="-1" name=""   text="在朦胧意识的彼岸听着这些声音，我感觉到内心深处有什么东西在发出声音崩塌着……。" voices=""/><stopbgm @l="928" fadeout="1000"/><clear @l="934" class="all"/><call @l="938" target="EventLabel_40@ending02"/><return @l="939" value="0&#13;&#10;"/><return @l="942" value=""/></code></xscript>																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																		