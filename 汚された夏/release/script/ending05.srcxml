<?xml version="1.0" encoding="utf-8"?><xscript><debug editor="&quot;C:\Program&#32;Files&#32;(x86)\sakura\sakura.exe&quot;&#32;&quot;%src%&quot;&#32;-Y=%line%"   src="D:\シロップ\町ぐるみの罠＋汚された夏セット版\汚された夏\完成データ\汚された夏\script\text\ending05.txt"/><code><label @l="12" id="EventLabel_43"/><description @l="16" text="工地上的肉人偶"/><eval @l="18" expr="f.numDay=0&#13;&#10;"/><label @l="21" id="event_scene31"/><msg @l="25" char_id="-1" frame_id="-1" name=""   text="被工人们轮奸后的美帆和玲，就这样被监禁起来，被教导各种取悦男人的技巧，如今已经被调教成了雌奴隶。"   voices=""/><msg @l="26" char_id="-1" frame_id="-1" name=""   text="而后她们就这样被强行参与到南总町正在推进的计划中……那是一个将整个城镇变成巨大性欲处理场的邪恶计划。"   voices=""/><msg @l="27" char_id="-1" frame_id="-1" name=""   text="那个计划是，被引进的企业只要出示员工证，就能免费享受性服务，作为回报，企业会为当地带来巨大利益的合约。但她们两人被迫担任的工作，并不仅仅是普通的性服务……。"   voices=""/><msg @l="29" char_id="-1" frame_id="-1" name="" text="从事那份工作八个月后———。"   voices=""/><bgm @l="33" src="bgm03" volume="1."/><msg @l="35" char_id="-1" frame_id="-1" name="" text="———大黑建设·建筑工地"   voices=""/><msg @l="36" char_id="-1" frame_id="-1" name=""   text="对工人们来说，堪称休憩的午餐时间到了。" voices=""/><msg @l="37" char_id="-1" frame_id="-1" name=""   text="大家从尘土飞扬的工作中解放出来，一边休息身体一边吃饭。" voices=""/><msg @l="38" char_id="-1" frame_id="-1" name="" text="再平常不过的日常。" voices=""/><msg @l="39" char_id="-1" frame_id="-1" name="" text="一如既往的每一天。" voices=""/><msg @l="40" char_id="-1" frame_id="-1" name="" text="这样的时光……今天也在继续流逝着。"   voices=""/><msg @l="42" char_id="-1" frame_id="-1" name="工作人员A"   text="『感觉有点想尿了……我去趟厕所。』" voices=""/><msg @l="44" char_id="-1" frame_id="-1" name="工作人员B"   text="『啊……其实我也正打算去呢。』" voices=""/><msg @l="46" char_id="-1" frame_id="-1" name="工作人员A"   text="『什么啊，要和你一起去小便吗？』" voices=""/><msg @l="48" char_id="-1" frame_id="-1" name="工作人员B"   text="『没什么大不了的吧，厕所不是有两个坑吗。』" voices=""/><msg @l="50" char_id="-1" frame_id="-1" name="工作人员A" text="『嗯，也行啦。』"   voices=""/><msg @l="52" char_id="-1" frame_id="-1" name=""   text="建筑工地一角交谈着的毫无营养的日常对话。" voices=""/><msg @l="53" char_id="-1" frame_id="-1" name=""   text="然而，他们言语背后隐藏着……非日常的含义。" voices=""/><msg @l="54" char_id="-1" frame_id="-1" name=""   text="其一是所谓的“想要”，并不仅仅是指尿意。" voices=""/><msg @l="55" char_id="-1" frame_id="-1" name=""   text="而另一个是……他们所指的“便器”并非物品。" voices=""/><stopbgm @l="59" fadeout="1000"/><label @l="63" id="chart_line38"/><wait_chgmv/><ev @l="67" src="ev-031"/><bgm @l="71" src="bgm14" volume="1."/><msg @l="73" char_id="0" frame_id="-1" name="美帆" text="『……。』"   voices="miho11520"/><msg @l="75" char_id="1" frame_id="-1" name="玲" text="『……。』"   voices="rei02540"/><msg @l="77" char_id="-1" frame_id="-1" name=""   text="他们前往的地方所谓的“便器”……是被束缚工具剥夺了自由的玲和美帆。" voices=""/><msg @l="78" char_id="-1" frame_id="-1" name=""   text="虽然南总町的计划进展顺利，但由于开发过于匆忙，对支撑这一切的劳动者的性需求照顾被忽略了。" voices=""/><msg @l="79" char_id="-1" frame_id="-1" name=""   text="通常，健康按摩等风俗店会提供这些服务，但由于优先考虑招商引资的大企业建筑，小型店铺自然而然地被排在了后面。"   voices=""/><msg @l="80" char_id="-1" frame_id="-1" name=""   text="其他建筑公司也曾表示要建设风俗店，但在由大黑建设掌控的这座城镇里，那是不可能的。" voices=""/><msg @l="81" char_id="-1" frame_id="-1" name=""   text="拥有众多劳工的大黑建设与政府部门协商后，作为应急措施，决定在各处设置建筑工人用的性欲处理“便所”。"   voices=""/><msg @l="82" char_id="-1" frame_id="-1" name=""   text="美帆她们就被束缚在那里，成为其中一个“便器”。" voices=""/><msg @l="83" char_id="-1" frame_id="-1" name=""   text="她们的身体上沾满了未被擦拭的小便和精液等物，可以看出她们也被其他工人使用过。"   voices=""/><msg @l="84" char_id="-1" frame_id="-1" name=""   text="美帆的腹部异常隆起，是因为被工人们侵犯，不断被内射的结果，怀上了父亲不明的孩子……"   voices=""/><msg @l="86" char_id="-1" frame_id="-1" name="工作人员A" text="『怎么回事，挺脏的嘛。』"   voices=""/><msg @l="88" char_id="-1" frame_id="-1" name="工作人员B" text="『嘛，公共物品就这样了，没办法。』"   voices=""/><msg @l="90" char_id="-1" frame_id="-1" name="工作人员A"   text="『话是这么说，但我还是希望他们能为后面的人着想着点使用啊。』" voices=""/><msg @l="92" char_id="-1" frame_id="-1" name="" text="注视着玲的其中一人注意到一个小小的异常。"   voices=""/><msg @l="94" char_id="-1" frame_id="-1" name="工作人员A"   text="『哦？点滴停了。』" voices=""/><msg @l="96" char_id="-1" frame_id="-1" name="工作人员B" text="『哎呀，还真是。』"   voices=""/><msg @l="98" char_id="-1" frame_id="-1" name="工作人员A"   text="『前一个家伙，是不是觉得可怜就停了？明明没胆量把她从这带出去，却做这种半吊子的事。』" voices=""/><msg @l="100" char_id="-1" frame_id="-1" name="工作人员B"   text="『就是就是，半吊子的怜悯是没必要的。』" voices=""/><msg @l="102" char_id="-1" frame_id="-1" name=""   text="玲的身旁，挂着一个明显不寻常的点滴瓶。" voices=""/><msg @l="103" char_id="-1" frame_id="-1" name=""   text="能看出挂着的点滴液体里混杂着局部发黄的精液。" voices=""/><msg @l="104" char_id="-1" frame_id="-1" name=""   text="其底部的开关仍处于“关闭”状态。" voices=""/><msg @l="105" char_id="-1" frame_id="-1" name=""   text="从点滴延伸出的粗橡胶管正插入玲的秘缝中。" voices=""/><msg @l="106" char_id="-1" frame_id="-1" name=""   text="从外面看不到，但管子的前端直接连接着玲的子宫口。" voices=""/><msg @l="107" char_id="-1" frame_id="-1" name=""   text="转动开关的话，不知是谁的混合精液就会慢慢流入玲的子宫中。" voices=""/><msg @l="109" char_id="-1" frame_id="-1" name="工作人员A" text="『要打开啦～。』"   voices=""/><msg @l="111" char_id="1" frame_id="-1" name="玲" text="『…………。』"   voices="rei02540"/><msg @l="113" char_id="-1" frame_id="-1" name="" text="说着，配合着“打开”的动作。"   voices=""/><msg @l="114" char_id="-1" frame_id="-1" name=""   text="一滴，又一滴精液流入玲的子宫。" voices=""/><msg @l="116" char_id="-1" frame_id="-1" name="" text="滴滴答答" voices=""/><msg @l="118" char_id="-1" frame_id="-1" name="工作人员B"   text="『快点怀上啊。隔壁的便器孤单地想要个伙伴呢。』" voices=""/><msg @l="120" char_id="-1" frame_id="-1" name="工作人员A"   text="『就是。我们更喜欢操已经怀孕的女人啊。』" voices=""/><msg @l="122" char_id="-1" frame_id="-1" name="工作人员B" text="『是啊，是啊。』"   voices=""/><msg @l="124" char_id="-1" frame_id="-1" name=""   text="俯视着玲，温柔地说着恐怖的话语。" voices=""/><msg @l="126" char_id="-1" frame_id="-1" name="工作人员A" text="『差不多该小便了。』"   voices=""/><msg @l="128" char_id="-1" frame_id="-1" name="工作人员B"   text="『对啊，我们是来方便的嘛。』" voices=""/><msg @l="130" char_id="-1" frame_id="-1" name=""   text="工作人员们这么说着，朝着被束缚的美帆和玲拉下裤子掏出阴茎。" voices=""/><wait_chgmv/><ev @l="134" src="ev-031z1"/><msg @l="136" char_id="-1" frame_id="-1" name=""   text="他们一副对着真正的“便器”的表情，往两人身上浇小便。" voices=""/><msg @l="137" char_id="-1" frame_id="-1" name="" text="附着的精液稍微被冲走了一些。"   voices=""/><msg @l="139" char_id="-1" frame_id="-1" name="工作人员A"   text="『啊……这种解放感真是爽。』" voices=""/><msg @l="141" char_id="-1" frame_id="-1" name="工作人员B"   text="『不愧是大黑建设的便器啊。小便的舒适感也不一样吧。』" voices=""/><msg @l="143" char_id="0" frame_id="-1" name="美帆" text="『嗯……。』"   voices="miho11530"/><msg @l="145" char_id="1" frame_id="-1" name="玲" text="『……唔……。』"   voices="rei02550"/><msg @l="147" char_id="-1" frame_id="-1" name=""   text="美帆和玲只是略微露出阴郁的表情，没有反抗，默默忍受着他们的恶行。" voices=""/><msg @l="148" char_id="-1" frame_id="-1" name=""   text="无谓的反抗也不会有任何改变，这大概是真岛彻底灌输给她们的结果。" voices=""/><msg @l="150" char_id="-1" frame_id="-1" name="工作人员A"   text="『好啦，小便之后当然是这个啦。』" voices=""/><msg @l="152" char_id="-1" frame_id="-1" name=""   text="说着，其中一名工作人员开始套弄自己的那话儿。" voices=""/><msg @l="154" char_id="-1" frame_id="-1" name="工作人员B"   text="『光看看有点不够过瘾，但这么脏的话又不想碰啊。衣服会弄脏的。』" voices=""/><msg @l="156" char_id="-1" frame_id="-1" name=""   text="另一个人也一边套弄着自己的肉棒，一边哈哈大笑。" voices=""/><msg @l="158" char_id="0" frame_id="-1" name="美帆" text="『……呜……。』"   voices="miho11540"/><msg @l="160" char_id="-1" frame_id="-1" name=""   text="听到男人们无情的话语，美帆发出悲伤的声音。" voices=""/><msg @l="161" char_id="-1" frame_id="-1" name=""   text="但由于口中戴着束缚装置，无法说出话来。" voices=""/><msg @l="163" char_id="-1" frame_id="-1" name="工作人员A"   text="『你看，这边这个便器的小穴，好像湿了？』" voices=""/><msg @l="165" char_id="1" frame_id="-1" name="玲" text="『……！！』"   voices="rei02560"/><msg @l="167" char_id="-1" frame_id="-1" name=""   text="一边套弄着自己的肉棒，其中一名男子指着玲的私处说道。" voices=""/><msg @l="168" char_id="-1" frame_id="-1" name=""   text="玲的那里已经被精液和小便弄得一塌糊涂，但仔细凝视的话，可以看到除此之外，还有半透明的液滴从内侧渗出来。"   voices=""/><msg @l="170" char_id="-1" frame_id="-1" name="工作人员B"   text="『哪里？哦，真的啊……便器竟然发情了，还真是……』" voices=""/><msg @l="172" char_id="-1" frame_id="-1" name="工作人员A"   text="『肯定是看到我们的肉棒想被插了吧。』" voices=""/><msg @l="174" char_id="-1" frame_id="-1" name="工作人员B" text="『明明只是个便器还挺不知天高地厚的。』"   voices=""/><msg @l="176" char_id="1" frame_id="-1" name="玲" text="『呃……』"   voices="rei02570"/><msg @l="178" char_id="-1" frame_id="-1" name=""   text="尽管被任意羞辱，玲还是咬紧牙关强忍着，一直在忍耐着。" voices=""/><msg @l="179" char_id="-1" frame_id="-1" name="" text="便器无论发生什么都不能发出言语。"   voices=""/><msg @l="180" char_id="-1" frame_id="-1" name=""   text="这是给她们的绝对规则。" voices=""/><msg @l="182" char_id="-1" frame_id="-1" name="工作人员A" text="『啊……要来了，要来了。』"   voices=""/><msg @l="184" char_id="-1" frame_id="-1" name=""   text="一边激烈地套弄着自己勃起的阳具，其中一个作业员发出了尖锐的声音。" voices=""/><msg @l="186" char_id="-1" frame_id="-1" name="工作人员B"   text="『这边也……再，差一点了。』" voices=""/><msg @l="188" char_id="0" frame_id="-1" name="美帆" text="『…………。』"   voices="miho11550"/><msg @l="190" char_id="1" frame_id="-1" name="玲" text="『…………。』"   voices="rei02580"/><msg @l="192" char_id="-1" frame_id="-1" name=""   text="听到男人们的话语，“便器”们的眼睛微微湿润起来。" voices=""/><msg @l="194" char_id="-1" frame_id="-1" name="工作人员A" text="『呜，哦哦哦！』"   voices=""/><msg @l="196" char_id="-1" frame_id="-1" name="工作人员B" text="『要射了！』"   voices=""/><flash @l="200" count="4" fade="100" image="white"/><wait_chgmv/><ev @l="204" src="ev-031z2"/><msg @l="206" char_id="0" frame_id="-1" name="美帆" text="『嗯呜……。』"   voices="miho11560"/><msg @l="208" char_id="1" frame_id="-1" name="玲" text="『………啊……。』"   voices="rei02590"/><msg @l="210" char_id="-1" frame_id="-1" name=""   text="从男人们的阳具中射出的精液，洒落在两个便器上。" voices=""/><msg @l="211" char_id="-1" frame_id="-1" name=""   text="美帆和玲微微发出带着热气的吐息……默默地承受着这一切。" voices=""/><msg @l="212" char_id="-1" frame_id="-1" name="工作人员A" text="『呼，舒服多了。』"   voices=""/><msg @l="214" char_id="-1" frame_id="-1" name="工作人员B"   text="『这样下午的工作也能干劲十足了。』" voices=""/><msg @l="216" char_id="-1" frame_id="-1" name=""   text="说完这话，男人们收起已经开始萎缩的阴茎，离开了两个便器。" voices=""/><msg @l="218" char_id="0" frame_id="-1" name="美帆" text="『…………。』"   voices="miho11570"/><msg @l="220" char_id="1" frame_id="-1" name="玲" text="『…………。』"   voices="rei02600"/><msg @l="222" char_id="-1" frame_id="-1" name=""   text="沦落到这个城镇最底层的她们，继续等待着前来向自己排泄的男人们。" voices=""/><msg @l="223" char_id="-1" frame_id="-1" name=""   text="直到她们的身体记住这就是她们的快乐……她们会一直…………。" voices=""/><stopbgm @l="226" fadeout="1000"/><clear @l="232" class="all"/><msg @l="233" char_id="-1" frame_id="-1" name="" text="··············。"   voices=""/><msg @l="234" char_id="-1" frame_id="-1" name="" text="········。" voices=""/><msg @l="236" char_id="-1" frame_id="-1" name=""   text="大黑和真岛通过安装好的监视器看着她们的样子。看着玲的身影，大黑脸上浮现出如爬行动物般的笑容。" voices=""/><msg @l="238" char_id="-1" frame_id="1" name="大黑"   text="（真美啊，玲小姐。那个曾经美丽高贵的你，现在却沦落为工人们的厕所呢。）" voices=""/><msg @l="240" char_id="-1" frame_id="1" name="大黑"   text="（如果玲小姐怀上了工人的孩子就太棒了。真想早点见到啊。到时候我们再让一百个人内射她，给肚子里的孩子补充营养吧……呵呵呵呵）"   voices=""/><msg @l="242" char_id="-1" frame_id="-1" name=""   text="在一旁看着这一切的真岛苦笑着。" voices=""/><msg @l="244" char_id="-1" frame_id="1" name="真岛"   text="（嘿嘿……果然很可怕啊，大黑先生……你们俩也真是被一个恐怖的家伙盯上了啊。）" voices=""/><msg @l="246" char_id="-1" frame_id="-1" name=""   text="就这样，两个男人继续用蔑视的目光注视着沦为牲畜的玲和美帆……。" voices=""/><clear @l="253" class="all"/><end_scene @l="256"/><eval @l="260" expr="s.flagGallery=1&#13;&#10;"/><eval @l="262" expr="s.event31flag=1&#13;&#10;"/><eval @l="266"   expr="f.bEx&#32;=&#32;s.event20flag&#32;&amp;&amp;&#32;s.event23flag&#32;&amp;&amp;&#32;s.event25flag&#32;&amp;&amp;&#32;s.event30flag&#32;&amp;&amp;&#32;s.event31flag&#32;&amp;&amp;&#32;s.event32flag&#32;&amp;&amp;&#32;s.event33flag&#32;&amp;&amp;&#32;s.event35flag&#32;&amp;&amp;&#32;s.event37flag&#32;&amp;&amp;&#32;s.event38flag&#32;&amp;&amp;&#32;s.event60flag&#13;&#10;"/><goto @l="268" cond="!(f.bEx)&#13;&#10;" label="TempLabel_239"/><eval @l="270" expr="s.exRootFlag=1&#13;&#10;"/><label @l="271" id="TempLabel_239"/><ending @l="273"/><goto @l="275" cond="!(f.bEx)&#13;&#10;" label="TempLabel_240"/><wait_chgmv/><bg @l="279" src="newroot"/><wait @l="281" time="5000"/><wait_chgmv/><bg @l="283" src="black"/><label @l="286" id="TempLabel_240"/><return @l="290" value=""/></code></xscript>																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																					