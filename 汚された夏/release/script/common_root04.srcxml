<?xml version="1.0" encoding="utf-8"?><xscript><debug editor="&quot;C:\Program&#32;Files&#32;(x86)\sakura\sakura.exe&quot;&#32;&quot;%src%&quot;&#32;-Y=%line%"   src="D:\シロップ\町ぐるみの罠＋汚された夏セット版\汚された夏\完成データ\汚された夏\script\text\common_root04.txt"/><code><label @l="19" id="EventLabel_29"/><description @l="22" text="来自稻庭的邀请"/><eval @l="24" expr="f.numDay=4&#13;&#10;"/><msgshow @l="26" show="false"/><wait_chgmv/><bg @l="28" src="day04" time="2000"/><wait @l="30" time="500"/><wait_chgmv/><bg @l="32" src="black" time="2000"/><msgshow @l="34" show="true"/><wait_chgmv/><bg @l="38" src="bg07"/><bgm @l="42" src="bgm02" volume="1."/><char @l="46" id="miho" pos="right" src="miho010"/><char @l="50" id="inaba" pos="left" src="inaba010"/><msg @l="52" char_id="0" frame_id="-1" name="美帆" text="『社团的参观会……吗？』"   voices=""/><msg @l="54" char_id="-1" frame_id="-1" name=""   text="这是在第二节课后，和女性朋友两人一边商量午餐菜单一边在校园里散步时发生的事。" voices=""/><msg @l="55" char_id="-1" frame_id="-1" name=""   text="偶然间，稻庭学长发现了我们，前来搭话，这就是开始。" voices=""/><msg @l="57" char_id="-1" frame_id="-1" name="稻庭"   text="『是的，今天下午四点半将在网球场举行。』" voices=""/><msg @l="59" char_id="0" frame_id="-1" name="美帆" text="『真是突然的事呢……』"   voices=""/><msg @l="61" char_id="-1" frame_id="-1" name="稻庭"   text="『是成员之一突然提出来的。当然，如果你有安排的话拒绝也没关系。』" voices=""/><msg @l="63" char_id="-1" frame_id="-1" name="" text="说着，稻庭学长微微一笑。"   voices=""/><msg @l="64" char_id="-1" frame_id="-1" name=""   text="那是……令人惊讶的亲切，仿佛能够原谅一切的笑容。" voices=""/><char @l="68" id="miho" pos="right" src="miho013"/><msg @l="70" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="72" char_id="0" frame_id="-1" name="美帆"   text="(玲喜欢上他的理由……我好像有点明白了)" voices=""/><char @l="76" id="miho" pos="right" src="miho116"/><msg @l="78" char_id="0" frame_id="-1" name="美帆" text="(但是，比起这个……总觉得有点可怕……)"   voices=""/><msg @l="80" char_id="-1" frame_id="-1" name=""   text="……稻庭学长的微笑，不知为何显得过于完美。" voices=""/><msg @l="81" char_id="-1" frame_id="-1" name=""   text="但又在某处透露出极为脆弱，如同人造物般的无机质感。" voices=""/><msg @l="82" char_id="-1" frame_id="-1" name=""   text="当然，也许正因为如此，才会吸引那么多人。" voices=""/><char @l="85" id="miho" pos="right" src="miho110"/><msg @l="87" char_id="0" frame_id="-1" name="美帆" text="(我……会怎样呢？)"   voices=""/><msg @l="89" char_id="0" frame_id="-1" name="美帆"   text="(被吸引的感觉……也许是有的……)" voices=""/><char @l="92" id="inaba" pos="left" src="inaba014"/><msg @l="94" char_id="-1" frame_id="-1" name="稻庭" text="『仲根同学……？』" voices=""/><char @l="98" id="miho" pos="right" src="miho014"/><msg @l="100" char_id="0" frame_id="-1" name="美帆" text="『啊，呃……对不起。』"   voices=""/><char @l="104" id="miho" pos="right" src="miho016"/><msg @l="106" char_id="0" frame_id="-1" name="美帆" text="『刚才有点走神了……。』"   voices=""/><char @l="109" id="inaba" pos="left" src="inaba010"/><msg @l="111" char_id="-1" frame_id="-1" name="稻庭" text="『哦，没什么就好。』"   voices=""/><msg @l="113" char_id="-1" frame_id="-1" name="稻庭"   text="『如果让你感到为难的话，你可以拒绝我哦？』" voices=""/><char @l="117" id="miho" pos="right" src="miho110"/><msg @l="119" char_id="0" frame_id="-1" name="美帆" text="『那个……』" voices=""/><msg @l="121" char_id="0" frame_id="-1" name="美帆"   text="『嗯……能和您聊天我很高兴，但是——唔！？』" voices=""/><char @l="125" id="miho" pos="right" src="miho114"/><msg @l="127" char_id="-1" frame_id="-1" name=""   text="就在我准备随便应付一下的时候。" voices=""/><msg @l="128" char_id="-1" frame_id="-1" name=""   text="一直在旁边痴迷地看着稻庭学长的那个女友人，突然强行捂住了我的嘴，插了进来。" voices=""/><msg @l="129" char_id="-1" frame_id="-1" name=""   text="虽然我知道她平时就很强势，但一涉及到稻庭学长的事情，这种强势就更加明显了。" voices=""/><bgm @l="132" src="bgm06" volume="1."/><msg @l="134" char_id="-1" frame_id="-1" name="女性朋友"   text="『没什么没什么！』" voices=""/><msg @l="136" char_id="-1" frame_id="-1" name="女性朋友"   text="『刚才这孩子说的话，完全不用在意不用在意！！』" voices=""/><char @l="139" id="miho" pos="right" src="miho115"/><msg @l="141" char_id="0" frame_id="-1" name="美帆" text="『小、小广……』"   voices=""/><msg @l="144" char_id="-1" frame_id="-1" name="稻庭" text="『啊哈哈，你很有精神嘛。』"   voices=""/><msg @l="146" char_id="-1" frame_id="-1" name="女性朋友"   text="『是的！精神充沛大概是我唯一的优点了！』" voices=""/><msg @l="148" char_id="-1" frame_id="-1" name="稻庭" text="『是吗，有精神是件好事哦。』"   voices=""/><msg @l="150" char_id="-1" frame_id="-1" name="女性朋友"   text="『那么学长喜欢精力充沛的女孩子吗！？』" voices=""/><msg @l="152" char_id="-1" frame_id="-1" name="稻庭"   text="『嗯～我觉得精力充沛的女孩子也很有魅力呢。』" voices=""/><msg @l="154" char_id="-1" frame_id="-1" name="女性朋友"   text="『呀啊啊啊啊啊啊啊啊啊啊啊！！』" voices=""/><msg @l="156" char_id="-1" frame_id="-1" name="女性朋友"   text="『喂美帆，你听到了吗，学长说他喜欢精力充沛的女孩子！！』" voices=""/><char @l="159" id="miho" pos="right" src="miho116"/><msg @l="161" char_id="0" frame_id="-1" name="美帆"   text="『嗯、嗯……哇、哈哈哈啦呃呼呼呃呃呼呃呼哈哈……』" voices=""/><msg @l="164" char_id="-1" frame_id="-1" name="女性朋友" text="『哇……对、对不起……』"   voices=""/><char @l="168" id="miho" pos="right" src="miho015"/><msg @l="170" char_id="0" frame_id="-1" name="美帆" text="『真是的……太过分了。』"   voices=""/><msg @l="172" char_id="-1" frame_id="-1" name="女性朋友" text="『所以我说对不起嘛。』"   voices=""/><msg @l="174" char_id="-1" frame_id="-1" name="稻庭"   text="『那么，社团的参观会你们能来吗？』" voices=""/><msg @l="176" char_id="-1" frame_id="-1" name="女性朋友"   text="『啊哈哈哈……当然了，我们怎么可能拒绝稻庭学长的邀请呢！』" voices=""/><char @l="179" id="miho" pos="right" src="miho016"/><msg @l="181" char_id="0" frame_id="-1" name="美帆" text="(不知不觉，我也被包括进去了……)"   voices=""/><msg @l="183" char_id="-1" frame_id="-1" name="稻庭"   text="『太好了……虽然是这么突发的参观会吧？』" voices=""/><msg @l="185" char_id="-1" frame_id="-1" name="稻庭"   text="『一开始只是成员们的想法，但既然我这个会长批准了，就是正式活动了。』" voices=""/><msg @l="187" char_id="-1" frame_id="-1" name="稻庭"   text="『我一直担心没人来怎么办。』" voices=""/><msg @l="189" char_id="-1" frame_id="-1" name="女性朋友"   text="『社团会长真是辛苦呢。』" voices=""/><msg @l="191" char_id="-1" frame_id="-1" name="稻庭"   text="『也还好啦。社团成员都是好人。』" voices=""/><msg @l="193" char_id="-1" frame_id="-1" name="稻庭"   text="『我总是受到大家的帮助，反而感到愧疚呢。』" voices=""/><msg @l="195" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><char @l="199" id="miho" pos="right" src="miho010"/><msg @l="201" char_id="0" frame_id="-1" name="美帆"   text="『那个，今天的参观会，玲…白石学姐会参加吗？』" voices=""/><msg @l="203" char_id="-1" frame_id="-1" name="稻庭"   text="『白石因为求职活动要去参加说明会。很遗憾，好像不能参加了。』" voices=""/><msg @l="205" char_id="-1" frame_id="-1" name="稻庭"   text="『啊…说起来你是白石的室友对吧。』" voices=""/><char @l="208" id="miho" pos="right" src="miho014"/><msg @l="210" char_id="0" frame_id="-1" name="美帆"   text="『啊，是的。白石学姐有聊起过我吗？』" voices=""/><msg @l="212" char_id="-1" frame_id="-1" name="稻庭"   text="『只有一点点。放心，我没有打听你的私事。』" voices=""/><msg @l="214" char_id="-1" frame_id="-1" name="稻庭" text="『那样做，不太公平吧？』"   voices=""/><char @l="217" id="miho" pos="right" src="miho110"/><msg @l="219" char_id="0" frame_id="-1" name="美帆" text="『是、是的…确实。』"   voices=""/><msg @l="221" char_id="0" frame_id="-1" name="美帆"   text="(这样啊……玲姐不参加参观会啊……)" voices=""/><msg @l="223" char_id="-1" frame_id="-1" name="稻庭"   text="『那么，我还要去招募其他人。』" voices=""/><msg @l="225" char_id="-1" frame_id="-1" name="女性朋友" text="『好的，我一定会去的！』"   voices=""/><msg @l="227" char_id="-1" frame_id="-1" name="稻庭" text="『嗯，我期待着你的到来。』"   voices=""/><stopbgm @l="231" fadeout="1000"/><clear @l="235" class="char"/><bgm @l="239" src="bgm02" volume="1."/><char @l="243" id="miho" pos="auto" src="miho010"/><msg @l="246" char_id="-1" frame_id="-1" name="女性朋友" text="『……。』" voices=""/><msg @l="248" char_id="-1" frame_id="-1" name="女性朋友" text="『嗯～～～～～～！！』"   voices=""/><msg @l="250" char_id="-1" frame_id="-1" name="女性朋友"   text="『稻庭学长，今天也很帅气啊！！』" voices=""/><msg @l="252" char_id="-1" frame_id="-1" name=""   text="在目送稻庭学长离开后，她仿佛要释放之前积攒的“某种情感”一般，双手紧握着尖叫起来。"   voices=""/><char @l="256" id="miho" pos="auto" src="miho016"/><msg @l="258" char_id="0" frame_id="-1" name="美帆" text="『是、是啊……。』"   voices=""/><msg @l="260" char_id="-1" frame_id="-1" name=""   text="我尴尬地应和着她的话，暗自苦笑。" voices=""/><msg @l="261" char_id="-1" frame_id="-1" name=""   text="在这种情况下，如果奇怪地称赞稻庭学长，显然会引起她的误解，导致无休止的质问攻击。" voices=""/><msg @l="262" char_id="-1" frame_id="-1" name=""   text="但如果不同意，也会被问“为什么美帆不明白稻庭学长的魅力”，同样会遭受说教攻击吧。"   voices=""/><msg @l="263" char_id="-1" frame_id="-1" name=""   text="既然无论如何都会遭到攻击，我只能含糊地微笑以对。" voices=""/><msg @l="265" char_id="-1" frame_id="-1" name="女性朋友"   text="『啊～，我心爱的稻庭学长……只要能够欣赏您那英姿，即使家里有丧事我也会赶来！！』" voices=""/><msg @l="267" char_id="0" frame_id="-1" name="美帆"   text="『……这样做是不是有点过分了。』" voices=""/><msg @l="269" char_id="-1" frame_id="-1" name="女性朋友" text="『美帆！』" voices=""/><char @l="273" id="miho" pos="auto" src="miho014"/><msg @l="275" char_id="0" frame_id="-1" name="美帆" text="『啊，在。』" voices=""/><msg @l="277" char_id="-1" frame_id="-1" name="女性朋友" text="『参观会，你一定要去哦。』"   voices=""/><msg @l="279" char_id="-1" frame_id="-1" name="女性朋友"   text="『美帆也一定要空出时间来！』" voices=""/><char @l="283" id="miho" pos="auto" src="miho016"/><msg @l="285" char_id="0" frame_id="-1" name="美帆"   text="『可，可是……我并没有说要去……。』" voices=""/><msg @l="287" char_id="-1" frame_id="-1" name="女性朋友" text="『你一定要去！』"   voices=""/><char @l="290" id="miho" pos="auto" src="miho014"/><msg @l="292" char_id="0" frame_id="-1" name="美帆" text="『是，是的！』" voices=""/><msg @l="294" char_id="-1" frame_id="-1" name="女性朋友" text="『嗯，很好。』"   voices=""/><msg @l="296" char_id="-1" frame_id="-1" name="" text="说着，她满意地点了点头。"   voices=""/><msg @l="297" char_id="-1" frame_id="-1" name="" text="如此强硬的态度反而显得干脆利落。"   voices=""/><char @l="301" id="miho" pos="auto" src="miho110"/><msg @l="303" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="305" char_id="0" frame_id="-1" name="美帆" text="(精力充沛的女孩子也很有魅力……吗)"   voices=""/><msg @l="307" char_id="-1" frame_id="-1" name=""   text="不知为何，这句话在我脑海中反复回响。" voices=""/><stopbgm @l="311" fadeout="1000"/><clear @l="317" class="all"/><wait_chgmv/><bg @l="321" src="bg09"/><bgm @l="325" src="bgm02" volume="1."/><char @l="329" id="miho" pos="auto" src="miho110"/><msg @l="331" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="333" char_id="0" frame_id="-1" name="美帆" text="『真慢啊……。』" voices=""/><msg @l="335" char_id="-1" frame_id="-1" name=""   text="我一个人在走廊上，被晾在一旁等待着。" voices=""/><msg @l="336" char_id="-1" frame_id="-1" name=""   text="第四节课结束后已经过去了十五分钟。" voices=""/><msg @l="337" char_id="-1" frame_id="-1" name=""   text="当然，我是在和朋友约好了见面，目的地是去参观稻庭学长领导的网球社团。" voices=""/><msg @l="339" char_id="0" frame_id="-1" name="美帆"   text="(明明离约定时间已经不多了……)" voices=""/><msg @l="341" char_id="-1" frame_id="-1" name=""   text="因为第四节课大家的课程都不一样，所以是她提议把离网球场比较近的我的教室作为见面地点的。"   voices=""/><msg @l="342" char_id="-1" frame_id="-1" name=""   text="所以，不可能是约错了地方。" voices=""/><msg @l="343" char_id="-1" frame_id="-1" name="" text="总觉得……有种不好的预感。"   voices=""/><msg @l="345" char_id="0" frame_id="-1" name="美帆"   text="(我……本来并不是很有兴趣的……)" voices=""/><char @l="348" id="miho" pos="auto" src="miho113"/><msg @l="350" char_id="0" frame_id="-1" name="美帆"   text="(这样被晾在这里等着，简直就像是我在期待一样……)" voices=""/><msg @l="352" char_id="-1" frame_id="-1" name=""   text="实际上，我是被朋友拉着才同意一起去的，并不是特别想去参观什么网球社团。"   voices=""/><msg @l="353" char_id="-1" frame_id="-1" name=""   text="话虽如此，说完全没兴趣也是骗人的。" voices=""/><msg @l="354" char_id="-1" frame_id="-1" name=""   text="纯粹是想尝试打网球，对稻庭学长也有一点……。" voices=""/><msg @l="355" char_id="-1" frame_id="-1" name=""   text="但是即使如此，我本来根本就没打算突然加入这种临时性的参观活动。" voices=""/><msg @l="356" char_id="-1" frame_id="-1" name=""   text="如果想加入网球社的话直接去办入会手续就好了，如果是因为对稻庭学长有兴趣而去见他的话……我想做好心理准备再去见他。"   voices=""/><char @l="359" id="miho" pos="auto" src="miho116"/><msg @l="361" char_id="-1" frame_id="-1" name="" text="但是，现在的我两者都不是。"   voices=""/><msg @l="362" char_id="-1" frame_id="-1" name=""   text="只是因为莫名其妙变成了这样，所以就像是被推着走一样去参加参观活动。" voices=""/><msg @l="364" char_id="0" frame_id="-1" name="美帆" text="(……原来如此……)"   voices=""/><msg @l="366" char_id="0" frame_id="-1" name="美帆" text="(我是在顾虑玲姐的感受啊……)"   voices=""/><msg @l="368" char_id="0" frame_id="-1" name="美帆"   text="(因为玲姐喜欢稻庭学长……)" voices=""/><msg @l="370" char_id="0" frame_id="-1" name="美帆" text="(所以……？)" voices=""/><msg @l="372" char_id="-1" frame_id="-1" name="" text="我自己的心情很难理解。"   voices=""/><msg @l="373" char_id="-1" frame_id="-1" name=""   text="为什么，自己会这样顾虑别人呢……。" voices=""/><msg @l="374" char_id="-1" frame_id="-1" name="" text="确实有着漫不经心的迷茫。"   voices=""/><msg @l="375" char_id="-1" frame_id="-1" name=""   text="但是，我自己也不清楚到底在迷茫什么。" voices=""/><msg @l="377" char_id="0" frame_id="-1" name="美帆"   text="(但是，为什么我要因此而顾虑呢……？)" voices=""/><msg @l="379" char_id="0" frame_id="-1" name="美帆"   text="(明明我对稻庭学长……应该没有什么特别的感觉)" voices=""/><msg @l="381" char_id="-1" frame_id="-1" name="声音" text="『美帆～～～。』" voices=""/><char @l="385" id="miho" pos="auto" src="miho111"/><msg @l="387" char_id="0" frame_id="-1" name="美帆" text="『啊……。』" voices=""/><msg @l="390" char_id="-1" frame_id="-1" name=""   text="走廊的另一头，从网球社团所在的部室栋相反的方向，一个女孩子朋友跑过来。" voices=""/><msg @l="391" char_id="-1" frame_id="-1" name=""   text="因为迟到而急匆匆地跑过来倒是好，但边喊着别人的名字边挥手实在有点尴尬。" voices=""/><char @l="395" id="miho" pos="auto" src="miho016"/><msg @l="397" char_id="-1" frame_id="-1" name="" text="不，是非常尴尬……。"   voices=""/><msg @l="399" char_id="-1" frame_id="-1" name="女性朋友" text="『对不起～，让你久等了。』"   voices=""/><msg @l="401" char_id="0" frame_id="-1" name="美帆"   text="『啊……嗯，我也才等了一会儿而已。』" voices=""/><char @l="405" id="miho" pos="auto" src="miho010"/><msg @l="407" char_id="0" frame_id="-1" name="美帆"   text="『比起这个，我们得赶紧走，不然赶不上参观会了哦？』" voices=""/><msg @l="409" char_id="-1" frame_id="-1" name="女性朋友" text="『啊—，关于这个……。』"   voices=""/><msg @l="411" char_id="0" frame_id="-1" name="美帆" text="『嗯？』" voices=""/><msg @l="413" char_id="-1" frame_id="-1" name="女性朋友"   text="『那个……该怎么说呢，就是～。』" voices=""/><bgm @l="416" src="bgm06" volume="1."/><msg @l="418" char_id="-1" frame_id="-1" name="女性朋友" text="『对不起！』" voices=""/><char @l="422" id="miho" pos="auto" src="miho014"/><msg @l="424" char_id="0" frame_id="-1" name="美帆" text="『你、你突然怎么了？』"   voices=""/><msg @l="426" char_id="-1" frame_id="-1" name="女性朋友"   text="『网球社团的参观会，我不能去了！！』" voices=""/><msg @l="428" char_id="0" frame_id="-1" name="美帆" text="『啊？ 为什么！？』"   voices=""/><msg @l="430" char_id="-1" frame_id="-1" name="女性朋友"   text="『我男朋友说，他今天无论如何都想见我。』" voices=""/><msg @l="432" char_id="0" frame_id="-1" name="美帆"   text="『男朋友…诶，你不是喜欢稻庭学长吗！？』" voices=""/><msg @l="434" char_id="-1" frame_id="-1" name="女性朋友"   text="『我当然爱稻庭学长啊～。』" voices=""/><msg @l="436" char_id="-1" frame_id="-1" name="女性朋友"   text="『但是啊，现实中的男朋友又是另一回事。我献给稻庭学长的爱，只是崇拜的一种表现而已。』" voices=""/><char @l="440" id="miho" pos="auto" src="miho016"/><msg @l="442" char_id="0" frame_id="-1" name="美帆" text="『那个…有点过分吧？』"   voices=""/><msg @l="444" char_id="-1" frame_id="-1" name="女性朋友" text="『才不过分呢！』"   voices=""/><msg @l="446" char_id="-1" frame_id="-1" name="女性朋友"   text="『男生不也是这样吗，即使有女朋友，看到偶像写真也会偷笑吧。这是一样的道理。』" voices=""/><msg @l="448" char_id="0" frame_id="-1" name="美帆" text="『…总觉得有点不一样。』"   voices=""/><msg @l="450" char_id="-1" frame_id="-1" name="女性朋友"   text="『总之，就是这么回事……参观会就由美帆一个人去吧。』" voices=""/><char @l="454" id="miho" pos="auto" src="miho015"/><msg @l="456" char_id="0" frame_id="-1" name="美帆"   text="『怎么这样…我一个人不敢去啊。』" voices=""/><msg @l="458" char_id="-1" frame_id="-1" name="女性朋友"   text="『这可是和你心爱的稻庭学长拉近关系的难得机会啊。』" voices=""/><char @l="462" id="miho" pos="auto" src="miho016"/><msg @l="464" char_id="0" frame_id="-1" name="美帆" text="『亲、亲近关系什么的……』"   voices=""/><msg @l="466" char_id="-1" frame_id="-1" name="女性朋友"   text="『那么，也替我向稻庭学长宣传一下我哦！』" voices=""/><char @l="469" id="miho" pos="auto" src="miho114"/><msg @l="471" char_id="0" frame_id="-1" name="美帆" text="『啊……』" voices=""/><msg @l="473" char_id="-1" frame_id="-1" name=""   text="还没来得及阻止，她就以比来时大约三倍的速度跑走了。" voices=""/><msg @l="474" char_id="-1" frame_id="-1" name=""   text="看着她满脸开心地跑远，就能明白她有多喜欢自己的男朋友。" voices=""/><bgm @l="477" src="bgm05" volume="1."/><msg @l="479" char_id="-1" frame_id="-1" name=""   text="与其说是网球社的参观会，她宁可选择和男朋友约会，这种感情的优先顺序非常明显。" voices=""/><msg @l="481" char_id="0" frame_id="-1" name="美帆"   text="『说来说去，还是男朋友最重要……啊。』" voices=""/><char @l="485" id="miho" pos="auto" src="miho116"/><msg @l="487" char_id="0" frame_id="-1" name="美帆" text="『………』" voices=""/><msg @l="489" char_id="0" frame_id="-1" name="美帆" text="(我……是怎么想的呢……)"   voices=""/><msg @l="491" char_id="0" frame_id="-1" name="美帆"   text="(如果今天就这样一个人去参加网球社的参观会，总觉得对玲姐的心情不太好……)" voices=""/><msg @l="493" char_id="0" frame_id="-1" name="美帆"   text="(但是，撇开那个不说……我还是挺有兴趣的)" voices=""/><msg @l="495" char_id="0" frame_id="-1" name="美帆" text="(该怎么办呢……)"   voices=""/><msg @l="499" async="true" char_id="-1" frame_id="-1" name=""   text="去网球社的参观会吗……？" voices=""/><select @l="500"><menu @l="502" label="EventLabel_30" text="去"/><menu @l="504" label="EventLabel_33" text="不去"/></select><label @l="510" id="EventLabel_30"/><msg @l="512" char_id="0" frame_id="-1" name="美帆" text="『………。』" voices=""/><char @l="515" id="miho" pos="auto" src="miho110"/><msg @l="517" char_id="0" frame_id="-1" name="美帆"   text="(果然还是有兴趣……去看看吧)" voices=""/><msg @l="519" char_id="0" frame_id="-1" name="美帆"   text="(而且，只是去参观会的话玲姐应该也不会介意吧？)" voices=""/><eval @l="522" expr="f.サークル見学会flag&#32;=&#32;1&#13;&#10;"/><clear @l="528" class="all"/><bgm @l="531" src="bgm06" volume="1."/><wait_chgmv/><bg @l="535" src="bg13m1"/><char @l="539" id="miho" pos="auto" src="miho014"/><se @l="543" buf="1" src="ラケットでボールを打つ音" volume="1."/><description @l="546" text="网球参观会"/><msg @l="548" char_id="0" frame_id="-1" name="美帆" text="『哇……。』" voices=""/><msg @l="550" char_id="-1" frame_id="-1" name=""   text="当我来到网球场时，身穿网球服的社团成员们正引导着穿便服的人们在球场内行走。"   voices=""/><msg @l="551" char_id="-1" frame_id="-1" name="" text="看来参观会已经开始了。"   voices=""/><char @l="555" id="miho" pos="auto" src="miho116"/><msg @l="557" char_id="0" frame_id="-1" name="美帆"   text="(怎么办……因为时间晚了，不太好意思进去了)" voices=""/><msg @l="559" char_id="-1" frame_id="-1" name="声音" text="『哎呀，你来了啊。』"   voices=""/><clear @l="562" class="char"/><char @l="565" id="miho" pos="right" src="miho113"/><char @l="568" id="inaba" pos="left" src="inaba050"/><msg @l="570" char_id="0" frame_id="-1" name="美帆" text="『啊，稻庭学长……。』"   voices=""/><msg @l="572" char_id="0" frame_id="-1" name="美帆"   text="『对不起，我迟到了……。』" voices=""/><msg @l="574" char_id="-1" frame_id="-1" name="稻庭"   text="『刚刚才开始而已，不用在意。』" voices=""/><msg @l="576" char_id="-1" frame_id="-1" name="稻庭"   text="『而且，我正要开始参观会的致词呢。你混在其中的话，迟到这种小事根本无所谓。』" voices=""/><msg @l="578" char_id="0" frame_id="-1" name="美帆" text="『对不起……。』"   voices=""/><msg @l="580" char_id="-1" frame_id="-1" name="稻庭"   text="『咦，那个活泼的女孩子没有一起来吗？』" voices=""/><msg @l="582" char_id="0" frame_id="-1" name="美帆"   text="『啊，是的。她突然有事不能来了……。』" voices=""/><msg @l="584" char_id="-1" frame_id="-1" name="稻庭" text="『这样啊，虽然很遗憾但也没办法。』"   voices=""/><msg @l="586" char_id="0" frame_id="-1" name="美帆"   text="(虽然被告知要向稻庭学长表现一下自己，但我完全不知道该怎么表现、表现什么好……)" voices=""/><msg @l="588" char_id="-1" frame_id="-1" name="稻庭"   text="『那么，我们也去加入参观会吧？』" voices=""/><clear @l="592" layer="inaba"/><char @l="595" id="miho" pos="right" src="miho111"/><msg @l="597" char_id="0" frame_id="-1" name="美帆" text="『啊，好的！』" voices=""/><clear @l="601" layer="miho"/><msg @l="603" char_id="-1" frame_id="-1" name=""   text="为了加入走在前面的参观人群，我和稻庭学长一起走在网球场内。" voices=""/><msg @l="604" char_id="-1" frame_id="-1" name=""   text="不过，稻庭学长在社团里似乎相当引人注目，看到他和我并排走着，好几个人都露出了疑惑的表情。"   voices=""/><msg @l="605" char_id="-1" frame_id="-1" name=""   text="顺便说一下，露出疑惑表情的几乎都是女性社团成员或者疑似冲着稻庭学长来参加参观会的人，这让我感到更加如芒在背。"   voices=""/><char @l="609" id="inaba" pos="left" src="inaba050"/><char @l="612" id="miho" pos="right" src="miho116"/><msg @l="614" char_id="-1" frame_id="-1" name="稻庭"   text="『大家好像都在怀疑我们呢。』" voices=""/><msg @l="616" char_id="0" frame_id="-1" name="美帆" text="『咦，那个……对不起。』"   voices=""/><msg @l="618" char_id="-1" frame_id="-1" name="稻庭" text="『你为什么要道歉呢？』"   voices=""/><msg @l="620" char_id="0" frame_id="-1" name="美帆"   text="『那个……因为我这种人会让您被奇怪地误解，会给您添麻烦吧。』" voices=""/><msg @l="622" char_id="-1" frame_id="-1" name="稻庭"   text="『我倒是不介意和你一起被误解呢。』" voices=""/><char @l="626" id="miho" pos="right" src="miho114"/><msg @l="628" char_id="0" frame_id="-1" name="美帆" text="『诶……那是什么意思……。』"   voices=""/><msg @l="630" char_id="-1" frame_id="-1" name="稻庭"   text="『喂，不快点的话，好像要移动到下一个地方了哦？』" voices=""/><char @l="634" id="miho" pos="right" src="miho110"/><msg @l="636" char_id="0" frame_id="-1" name="美帆" text="『啊……好的。』" voices=""/><msg @l="638" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="640" char_id="0" frame_id="-1" name="美帆"   text="(刚才稻庭学长的话……到底是什么意思呢……)" voices=""/><clear @l="646" class="all"/><wait_chgmv/><bg @l="650" src="bg13m1"/><char @l="654" id="inaba" pos="auto" src="inaba050"/><msg @l="656" char_id="-1" frame_id="-1" name="稻庭"   text="『各位，感谢大家来参加这次社团参观会。』" voices=""/><msg @l="658" char_id="-1" frame_id="-1" name="稻庭"   text="『我是这个网球社团的会长，我叫稻庭俊明（稻庭俊明）。』" voices=""/><msg @l="660" char_id="-1" frame_id="-1" name=""   text="当稻庭学长微微一笑时，参观会参加者中立刻爆发出一阵尖叫声。" voices=""/><msg @l="661" char_id="-1" frame_id="-1" name=""   text="参加者中约八成是女性，几乎所有人都是这种状态，作为同样站在参观队伍中的我几乎被完全震慑住了。" voices=""/><msg @l="663" char_id="0" frame_id="-1" name="美帆"   text="(传言果然没错……稻庭学长真的很受欢迎啊)" voices=""/><msg @l="665" char_id="-1" frame_id="-1" name="稻庭"   text="『啊哈哈，来参加的大家看起来都很有精神呢。』" voices=""/><msg @l="667" char_id="-1" frame_id="-1" name="稻庭"   text="『希望能保持这种状态，让今天的参观会变得愉快。』" voices=""/><msg @l="669" char_id="-1" frame_id="-1" name="稻庭"   text="『各位，请尽情参观我们网球社团的活动内容。』" voices=""/><msg @l="671" char_id="-1" frame_id="-1" name="社团成员"   text="『那么接下来我们将为大家讲解本社团的活动内容，请大家到右手边的C场地集合。』" voices=""/><msg @l="673" char_id="-1" frame_id="-1" name=""   text="稻庭学长结束参观会致辞后，社团成员开始引导参加者。" voices=""/><msg @l="674" char_id="-1" frame_id="-1" name=""   text="但是，大部分参加者都争先恐后地涌向刚刚结束致辞的稻庭学长身边。" voices=""/><msg @l="676" char_id="-1" frame_id="-1" name="参加者A"   text="『稻庭学长，待会请教教我关于网球的各种事情！』" voices=""/><msg @l="678" char_id="-1" frame_id="-1" name="参加者B"   text="『啊，太狡猾了，我也想请学长教我各种事情！』" voices=""/><msg @l="680" char_id="-1" frame_id="-1" name="参加者C"   text="『我想成为稻庭学长的专属经理……』" voices=""/><msg @l="682" char_id="-1" frame_id="-1" name="稻庭"   text="『啊哈哈，我很高兴你们这么热情，但现在请跟随社团成员的引导哦。』" voices=""/><msg @l="684" char_id="-1" frame_id="-1" name="参加者A·B·C" text="『好的！』"   voices=""/><msg @l="686" char_id="-1" frame_id="-1" name=""   text="那些本来根本不愿听从社团成员引导的参加者们，听到稻庭学长的一句话后，就乖乖地开始向C场地走去。" voices=""/><msg @l="687" char_id="-1" frame_id="-1" name=""   text="参加者们的热情固然惊人，但稻庭学长的魅力也令人惊讶。" voices=""/><msg @l="688" char_id="-1" frame_id="-1" name=""   text="如果是追星族的情况，即使是偶像本人的话语，也不可能仅凭一句话就平息或指挥粉丝们。"   voices=""/><msg @l="689" char_id="-1" frame_id="-1" name=""   text="相反，狂热的粉丝们可能会更加拥挤上前。" voices=""/><msg @l="690" char_id="-1" frame_id="-1" name=""   text="他们会想，我也想要被偶像本人搭话。" voices=""/><char @l="694" id="miho" pos="auto" src="miho010"/><msg @l="696" char_id="0" frame_id="-1" name="美帆"   text="(真厉害啊……学长一句话大家就乖乖听从了)" voices=""/><msg @l="698" char_id="-1" frame_id="-1" name="社团成员" text="『请问有什么事吗？』"   voices=""/><char @l="702" id="miho" pos="auto" src="miho014"/><msg @l="704" char_id="0" frame_id="-1" name="美帆" text="『啊……啊，什么？』"   voices=""/><msg @l="706" char_id="-1" frame_id="-1" name="社团成员"   text="『社团活动的说明会在C场地进行，请移动到那边。』" voices=""/><char @l="710" id="miho" pos="auto" src="miho016"/><msg @l="712" char_id="0" frame_id="-1" name="美帆" text="『对、对不起！』"   voices=""/><clear @l="718" class="all"/><wait_chgmv/><bg @l="722" src="bg13m1"/><msg @l="724" char_id="-1" frame_id="-1" name="社团成员"   text="『那么，关于活动内容的说明到此结束。』" voices=""/><msg @l="726" char_id="-1" frame_id="-1" name="社团成员"   text="『接下来作为体验活动，我们打算让大家与社团成员进行简易的网球比赛。』" voices=""/><msg @l="728" char_id="-1" frame_id="-1" name="社团成员"   text="『有网球经验的请去A场地，没有经验的请先在B场地进行简单练习后再进行比赛。』" voices=""/><char @l="732" id="miho" pos="auto" src="miho110"/><msg @l="734" char_id="0" frame_id="-1" name="美帆" text="(我是没有经验的，所以去B场地吧……)"   voices=""/><msg @l="736" char_id="-1" frame_id="-1" name=""   text="按照社团成员的引导，我朝着B场地走去。" voices=""/><msg @l="737" char_id="-1" frame_id="-1" name=""   text="从出生到现在除了体育课之外没有任何经验的我，虽然有简单的练习，但突然要进行比赛还是有些不安。" voices=""/><msg @l="738" char_id="-1" frame_id="-1" name=""   text="比起胜负，我甚至不知道自己能不能打出一场像样的比赛。" voices=""/><clear @l="741" class="char"/><char @l="744" id="miho" pos="right" src="miho010"/><char @l="747" id="inaba" pos="left" src="inaba050"/><msg @l="749" char_id="-1" frame_id="-1" name="稻庭" text="『仲根同学。』" voices=""/><char @l="753" id="miho" pos="right" src="miho111"/><msg @l="755" char_id="0" frame_id="-1" name="美帆"   text="『啊，稻庭学长……学长也是负责B场地的吗？』" voices=""/><msg @l="757" char_id="-1" frame_id="-1" name="稻庭"   text="『我怎么说也是社团会长嘛，觉得至少应该能给没有网球经验的人做些指导。』" voices=""/><char @l="761" id="miho" pos="right" src="miho016"/><msg @l="763" char_id="0" frame_id="-1" name="美帆"   text="『一般来说，会长本人不会亲自做这种事吧。』" voices=""/><msg @l="766" char_id="-1" frame_id="-1" name="稻庭"   text="『我们社团的活动方针是不受年级上下关系的束缚。』" voices=""/><msg @l="768" char_id="-1" frame_id="-1" name="稻庭"   text="『体育社团那种风格，不太符合我的性格。』" voices=""/><char @l="772" id="miho" pos="right" src="miho011"/><msg @l="774" char_id="0" frame_id="-1" name="美帆"   text="『是吗……我也不太擅长应付体育社团那种氛围，听您这么说就放心了。』" voices=""/><msg @l="776" char_id="-1" frame_id="-1" name="稻庭"   text="『那太好了。我啊，一直努力创建一个即使是像仲根同学这样文静的孩子也能愉快活动的社团。』" voices=""/><msg @l="778" char_id="-1" frame_id="-1" name="稻庭"   text="『所以，如果你能喜欢上这里，我会非常高兴的。』" voices=""/><char @l="781" id="miho" pos="right" src="miho013"/><msg @l="783" char_id="0" frame_id="-1" name="美帆"   text="『啊………这样的理念真是太好了。』" voices=""/><char @l="787" id="miho" pos="right" src="miho110"/><msg @l="789" char_id="0" frame_id="-1" name="美帆"   text="『我是个相当内向的人……一直以为社团活动会很辛苦……如果有这样一个即使是我这种人也能享受的地方，我会很高兴。』"   voices=""/><msg @l="791" char_id="-1" frame_id="-1" name="稻庭"   text="『嗯嗯，看来我的话相当有说服力呢。』" voices=""/><msg @l="793" char_id="-1" frame_id="-1" name="参加者A"   text="『稻庭学长，我不太明白怎么握球拍～』" voices=""/><msg @l="795" char_id="-1" frame_id="-1" name="参加者B"   text="『稻庭学长，腰部的动作这样对吗？』" voices=""/><msg @l="797" char_id="-1" frame_id="-1" name="参加者C"   text="『……球打不直，稻庭学长。』" voices=""/><msg @l="799" char_id="-1" frame_id="-1" name="稻庭"   text="『哎呀……看来我只能说到这里了。』" voices=""/><msg @l="801" char_id="0" frame_id="-1" name="美帆"   text="『没关系，请不要在意我，去她们那边帮忙吧。』" voices=""/><msg @l="803" char_id="-1" frame_id="-1" name="稻庭"   text="『等我有空了，会再过来的。』" voices=""/><msg @l="805" char_id="0" frame_id="-1" name="美帆" text="『谢谢您。』"   voices=""/><clear @l="809" class="char"/><char @l="811" id="miho" pos="auto" src="miho010"/><msg @l="813" char_id="-1" frame_id="-1" name="参加者A"   text="『呀～，稻庭学长来了～！』" voices=""/><msg @l="815" char_id="-1" frame_id="-1" name="参加者B"   text="『学长学长，关于腰部的动作——』" voices=""/><msg @l="817" char_id="-1" frame_id="-1" name="参加者C" text="『球……』"   voices=""/><char @l="821" id="miho" pos="auto" src="miho016"/><msg @l="823" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><char @l="828" id="miho" pos="auto" src="miho010"/><msg @l="830" char_id="0" frame_id="-1" name="美帆" text="(稻庭学长……吗)"   voices=""/><msg @l="832" char_id="0" frame_id="-1" name="美帆"   text="(最初给人感觉有点难以接近，但这样多聊几次后，似乎也没那么回事……)" voices=""/><msg @l="834" char_id="0" frame_id="-1" name="美帆"   text="(社团活动也似乎没有想象中那么严格)" voices=""/><msg @l="836" char_id="0" frame_id="-1" name="美帆"   text="(这样的话，以课后稍微运动一下的心态，应该能够享受其中吧？)" voices=""/><char @l="840" id="miho" pos="auto" src="miho013"/><msg @l="842" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="844" char_id="-1" frame_id="-1" name=""   text="我悄悄地望着稻庭学长在场地边缘教几个女生正确姿势的样子。" voices=""/><msg @l="845" char_id="-1" frame_id="-1" name=""   text="容姿端丽又性格随和，而且还很温柔，三拍子齐全的完美人物。" voices=""/><msg @l="846" char_id="-1" frame_id="-1" name=""   text="玲小姐喜欢上稻庭学长这件事，我觉得很能理解。" voices=""/><char @l="850" id="miho" pos="auto" src="miho014"/><msg @l="852" char_id="0" frame_id="-1" name="美帆" text="(……啊？)" voices=""/><char @l="856" id="miho" pos="auto" src="miho116"/><msg @l="858" char_id="0" frame_id="-1" name="美帆"   text="(真是的……我到底在发什么呆，盯着稻庭学长看得出神)" voices=""/><msg @l="860" char_id="0" frame_id="-1" name="美帆"   text="(不能无视玲小姐的感受，而且对我来说稻庭学长就是高不可攀的存在……等等，我又不是对稻庭学长……)"   voices=""/><char @l="864" id="miho" pos="auto" src="miho013"/><msg @l="866" char_id="0" frame_id="-1" name="美帆"   text="(明明对稻庭学长，并不是喜欢……)" voices=""/><msg @l="868" char_id="-1" frame_id="-1" name=""   text="为了驱散那些开始萌生的朦胧情感，我在心中轻声低语。" voices=""/><msg @l="869" char_id="-1" frame_id="-1" name="" text="这话听起来有些故作姿态，让人心里不舒服。"   voices=""/><char @l="873" id="miho" pos="auto" src="miho016"/><msg @l="875" char_id="0" frame_id="-1" name="美帆"   text="(不行不行不行不行，想太多的话就会陷得更深)" voices=""/><char @l="879" id="miho" pos="auto" src="miho110"/><msg @l="881" char_id="0" frame_id="-1" name="美帆" text="(好了……我也去练习吧)"   voices=""/><clear @l="887" class="all"/><bgm @l="890" src="bgm02" volume="1."/><wait_chgmv/><bg @l="894" src="bg13m2"/><msg @l="896" char_id="-1" frame_id="-1" name="社团成员"   text="『感谢各位今天的到场。』" voices=""/><msg @l="898" char_id="-1" frame_id="-1" name="社团成员"   text="『本次社团参观会到此结束。有意加入的同学请向后面的社团成员领取入会申请表。』"   voices=""/><char @l="902" id="miho" pos="auto" src="miho116"/><msg @l="904" char_id="0" frame_id="-1" name="美帆" text="『……呼。』" voices=""/><msg @l="906" char_id="-1" frame_id="-1" name=""   text="久违的运动带来沉重的疲劳感，让我不由自主地叹了口气。" voices=""/><msg @l="907" char_id="-1" frame_id="-1" name=""   text="自从上大学以来，算得上运动的也就是往返家和车站的路程，或者在广阔的校园里为了赶路而匆忙奔走。"   voices=""/><msg @l="908" char_id="-1" frame_id="-1" name=""   text="对这样的我来说，即使只有一小时，连续不断地运动身体也是相当辛苦的事情。" voices=""/><msg @l="909" char_id="-1" frame_id="-1" name=""   text="……姑且先不提这只是单纯的运动不足……" voices=""/><msg @l="911" char_id="0" frame_id="-1" name="美帆"   text="(嗯……然后，如果想加入社团的话是要领取入会表格对吧？)" voices=""/><msg @l="913" char_id="0" frame_id="-1" name="美帆" text="『…………』" voices=""/><msg @l="915" char_id="0" frame_id="-1" name="美帆" text="(该怎么办……呢)"   voices=""/><msg @l="919" async="true" char_id="-1" frame_id="-1" name=""   text="要加入网球社团吗？" voices=""/><select @l="920"><menu @l="922" label="EventLabel_31" text="加入"/><menu @l="924" label="EventLabel_32" text="不加入"/></select><label @l="931" id="EventLabel_31"/><char @l="936" id="miho" pos="auto" src="miho010"/><msg @l="938" char_id="0" frame_id="-1" name="美帆"   text="(对呀……既然都来参观了)" voices=""/><msg @l="940" char_id="0" frame_id="-1" name="美帆"   text="(不去想什么不像自己之类的，勇敢地加入看看也是个不错的选择……对吧？)" voices=""/><clear @l="943" class="char"/><char @l="945" id="miho" pos="right" src="miho010"/><char @l="948" id="inaba" pos="left" src="inaba050"/><msg @l="950" char_id="-1" frame_id="-1" name="稻庭"   text="『嘿，仲根同学今天的参观会玩得开心吗？』" voices=""/><char @l="954" id="miho" pos="right" src="miho113"/><msg @l="956" char_id="0" frame_id="-1" name="美帆" text="『啊……嗯，很开心。』"   voices=""/><char @l="960" id="miho" pos="right" src="miho016"/><msg @l="962" char_id="0" frame_id="-1" name="美帆" text="『只是……有点累了。』"   voices=""/><msg @l="964" char_id="-1" frame_id="-1" name="稻庭"   text="『哈哈哈，我觉得基础体力对大学生也很重要哦。』" voices=""/><char @l="968" id="miho" pos="right" src="miho015"/><msg @l="970" char_id="0" frame_id="-1" name="美帆" text="『呜……现在深有体会。』"   voices=""/><msg @l="972" char_id="-1" frame_id="-1" name="稻庭"   text="『是啊……如果你愿意的话，要不要考虑加入我们社团试试？』" voices=""/><msg @l="974" char_id="-1" frame_id="-1" name="稻庭"   text="『一开始可能会有点累，但坚持一段时间后，我想你的体力也会提高的。』" voices=""/><char @l="978" id="miho" pos="right" src="miho013"/><msg @l="980" char_id="0" frame_id="-1" name="美帆"   text="『那个……其实，我正在考虑要不要加入呢。』" voices=""/><msg @l="982" char_id="-1" frame_id="-1" name="稻庭" text="『那太好了！』"   voices=""/><msg @l="984" char_id="-1" frame_id="-1" name="稻庭"   text="『如果你有这个想法，真希望你能加入。欢迎你哦。』" voices=""/><char @l="988" id="miho" pos="right" src="miho116"/><msg @l="990" char_id="0" frame_id="-1" name="美帆" text="『但是……那个，没问题吗？』"   voices=""/><msg @l="992" char_id="0" frame_id="-1" name="美帆"   text="『我体力也不好……不会成为你们的负担吧？』" voices=""/><msg @l="994" char_id="-1" frame_id="-1" name="稻庭"   text="『刚才也说过了，我们社团并不是以变强或锻炼身体为目的的。』" voices=""/><msg @l="996" char_id="-1" frame_id="-1" name="稻庭"   text="『没关系，我相信你一定能玩得开心的。』" voices=""/><char @l="1000" id="miho" pos="right" src="miho111"/><msg @l="1002" char_id="0" frame_id="-1" name="美帆" text="『真的吗？』"   voices=""/><msg @l="1004" char_id="-1" frame_id="-1" name="稻庭" text="『嗯，我来保证。』"   voices=""/><msg @l="1006" char_id="0" frame_id="-1" name="美帆"   text="『那我去拿入会申请表了。』" voices=""/><clear @l="1010" class="char"/><msg @l="1012" char_id="-1" frame_id="-1" name=""   text="在得到稻庭学长的鼓励后，我轻快地去领取入会申请表。" voices=""/><msg @l="1013" char_id="-1" frame_id="-1" name=""   text="参加运动类社团活动，算起来已经是三年前的事了吧。" voices=""/><msg @l="1014" char_id="-1" frame_id="-1" name=""   text="直到大学入学考试前一年左右，我一直是游泳部的成员。" voices=""/><msg @l="1015" char_id="-1" frame_id="-1" name=""   text="虽然我不擅长运动，但游泳是个例外，我有相当不错的成绩，而且最重要的是，我非常享受游泳本身带来的乐趣。" voices=""/><msg @l="1016" char_id="-1" frame_id="-1" name=""   text="但是……自从高二夏天发生的某件事后，我放弃了游泳，也在内心某处不自觉地避开了运动。" voices=""/><msg @l="1017" char_id="-1" frame_id="-1" name=""   text="不过，或许借此机会，这种感觉会消失吧。" voices=""/><msg @l="1018" char_id="-1" frame_id="-1" name=""   text="也许终于能从过去的心理阴影中解脱出来了。" voices=""/><msg @l="1019" char_id="-1" frame_id="-1" name=""   text="这样的期待，让我感到兴奋不已———。" voices=""/><eval @l="1022" expr="f.サークル見学会flag&#32;=&#32;2&#13;&#10;"/><goto @l="1026" label="EventLabel_34"/><label @l="1030" id="EventLabel_32"/><msg @l="1033" char_id="0" frame_id="-1" name="美帆" text="(果然……还是放弃吧)"   voices=""/><msg @l="1035" char_id="0" frame_id="-1" name="美帆"   text="(这种活动，好像不太适合我……)" voices=""/><msg @l="1037" char_id="-1" frame_id="-1" name="" text="见学会本身我觉得很有趣。"   voices=""/><msg @l="1038" char_id="-1" frame_id="-1" name=""   text="但那只是因为我作为第三者临时参加，并不能保证正式成为会员后也能乐在其中。" voices=""/><clear @l="1041" class="char"/><char @l="1043" id="miho" pos="right" src="miho116"/><char @l="1046" id="inaba" pos="left" src="inaba050"/><msg @l="1048" char_id="-1" frame_id="-1" name="稻庭" text="『看起来很累啊，仲根同学。』"   voices=""/><msg @l="1050" char_id="0" frame_id="-1" name="美帆"   text="『是的……好像有点，对我来说太辛苦了。』" voices=""/><msg @l="1052" char_id="-1" frame_id="-1" name="稻庭"   text="『到了大学生这个阶段，如果不主动去运动的话，活动身体的机会实在是不多呢。』" voices=""/><msg @l="1054" char_id="-1" frame_id="-1" name="稻庭"   text="『从这个角度来说，加入这种社团是个不错的机会，你觉得呢？』" voices=""/><msg @l="1056" char_id="0" frame_id="-1" name="美帆" text="『那个，对不起……』"   voices=""/><msg @l="1058" char_id="0" frame_id="-1" name="美帆"   text="『虽然我很有兴趣……但是，这好像不太适合我。』" voices=""/><msg @l="1060" char_id="-1" frame_id="-1" name="稻庭"   text="『每个人一开始都是这样的。常常会因为不熟悉而误以为自己不适合。』" voices=""/><msg @l="1062" char_id="-1" frame_id="-1" name="稻庭"   text="『我们社团的目的不是要变得多厉害，只是一起愉快地运动就可以了，不是吗？』" voices=""/><char @l="1065" id="miho" pos="right" src="miho016"/><msg @l="1067" char_id="0" frame_id="-1" name="美帆"   text="『能这么说真是感谢……』" voices=""/><msg @l="1069" char_id="0" frame_id="-1" name="美帆"   text="『但是……果然……对不起。』" voices=""/><msg @l="1071" char_id="-1" frame_id="-1" name="稻庭" text="『这样啊……』" voices=""/><bgm @l="1074" src="bgm03" volume="1."/><msg @l="1076" char_id="-1" frame_id="-1" name="稻庭"   text="『我以为你会理解的，真遗憾。』" voices=""/><msg @l="1078" char_id="-1" frame_id="-1" name=""   text="一瞬间，我感觉稻庭学长的语气中似乎包含了某种烦躁的情绪。" voices=""/><msg @l="1079" char_id="-1" frame_id="-1" name=""   text="那种感觉异常尖锐激烈，完全出乎我对平日里他的预料……" voices=""/><msg @l="1080" char_id="-1" frame_id="-1" name=""   text="我不由得感到一阵寒意顺着脊背窜了上来。" voices=""/><char @l="1084" id="miho" pos="right" src="miho114"/><msg @l="1086" char_id="0" frame_id="-1" name="美帆" text="『稻庭……学长……？』"   voices=""/><msg @l="1088" char_id="-1" frame_id="-1" name="稻庭" text="『不，没什么。』"   voices=""/><msg @l="1090" char_id="-1" frame_id="-1" name="稻庭"   text="『那我先走了，接下来有社团会议。』" voices=""/><char @l="1094" id="miho" pos="right" src="miho116"/><msg @l="1096" char_id="0" frame_id="-1" name="美帆" text="『啊……好的。』" voices=""/><clear @l="1100" layer="inaba"/><msg @l="1102" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="1104" char_id="0" frame_id="-1" name="美帆" text="『是不是……被讨厌了呢。』"   voices=""/><msg @l="1106" char_id="-1" frame_id="-1" name=""   text="转身朝社团大楼走去的稻庭学长的背影……非常冷漠。" voices=""/><goto @l="1109" label="EventLabel_34"/><label @l="1113" id="EventLabel_33"/><msg @l="1116" char_id="0" frame_id="-1" name="美帆" text="(参观会……要不要放弃去呢)"   voices=""/><msg @l="1118" char_id="-1" frame_id="-1" name=""   text="仔细想想，既然邀请我一起去的朋友已经不去了，那么我一个人去参观会可以说是完全没必要的。"   voices=""/><msg @l="1119" char_id="-1" frame_id="-1" name=""   text="虽然说，尽管是被勉强的，但毕竟已经答应了要去，对稻庭学长感到有些抱歉……" voices=""/><msg @l="1120" char_id="-1" frame_id="-1" name=""   text="况且我还因为玲小姐的事情感到莫名的愧疚。" voices=""/><msg @l="1121" char_id="-1" frame_id="-1" name=""   text="干脆，就这样回去或许更好。" voices=""/><msg @l="1123" char_id="0" frame_id="-1" name="美帆" text="(……对不起，稻庭学长)"   voices=""/><msg @l="1125" char_id="0" frame_id="-1" name="美帆"   text="(还有……对不起，我没能表现出来)" voices=""/><msg @l="1127" char_id="-1" frame_id="-1" name=""   text="在心里向朋友道歉的同时，我朝着车站走去……。" voices=""/><goto @l="1130" label="EventLabel_34"/><label @l="1134" id="EventLabel_34"/><msgshow @l="1137" show="false"/><clear @l="1139" class="all"/><stopbgm @l="1142" fadeout="1000"/><wait_chgmv/><bg @l="1150" src="bg03b"/><msgshow @l="1153" show="true"/><bgm @l="1157" src="bgm04" volume="1."/><char @l="1161" id="miho" pos="auto" src="miho030"/><description @l="1164" text="揺れ動くとき"/><msg @l="1166" char_id="0" frame_id="-1" name="美帆" text="『我洗完澡了。』"   voices=""/><msg @l="1168" char_id="1" frame_id="-1" name="玲"   text="『浴缸的热水就这样留着吧……我马上也要洗，所以。』" voices=""/><char @l="1172" id="miho" pos="auto" src="miho031"/><msg @l="1174" char_id="0" frame_id="-1" name="美帆" text="『我也是这么想的，所以没关火。』"   voices=""/><msg @l="1176" char_id="1" frame_id="-1" name="玲" text="『谢谢。』" voices=""/><msg @l="1178" char_id="-1" frame_id="-1" name=""   text="玲小姐视线依然盯着电视，轻轻地摆了摆手。" voices=""/><msg @l="1179" char_id="-1" frame_id="-1" name="" text="这应该算是个“谢谢”的手势吧。"   voices=""/><msg @l="1180" char_id="-1" frame_id="-1" name=""   text="电视屏幕上正在播放时尚剧的高潮部分。" voices=""/><goto @l="1183" cond="!(f.サークル見学会flag&#32;&gt;=&#32;1)&#13;&#10;"   label="TempLabel_206"/><clear @l="1187" class="char"/><char @l="1189" id="miho" pos="left" src="miho030"/><char @l="1192" id="rei" pos="right" src="rei030"/><msg @l="1194" char_id="0" frame_id="-1" name="美帆"   text="『说起来……今天我去参加了玲小姐所属的网球社的见学会。』" voices=""/><msg @l="1196" char_id="1" frame_id="-1" name="玲"   text="『哦，那个见学会我还以为是临时决定的呢……没想到他们还有时间招募参与者啊。』" voices=""/><char @l="1200" id="miho" pos="left" src="miho036"/><msg @l="1202" char_id="0" frame_id="-1" name="美帆"   text="『其实……今天中午我突然就被邀请了。』" voices=""/><char @l="1206" id="rei" pos="right" src="rei034"/><msg @l="1208" char_id="1" frame_id="-1" name="玲"   text="『能这样就去参加见学会，你还挺有行动力的嘛。』" voices=""/><msg @l="1210" char_id="0" frame_id="-1" name="美帆"   text="『不，那个……被邀请时和我在一起的朋友无论如何都要去见学会，所以我就……。』" voices=""/><char @l="1214" id="rei" pos="right" src="rei030"/><msg @l="1216" char_id="1" frame_id="-1" name="玲" text="『那个朋友是女孩子吧？』"   voices=""/><char @l="1220" id="miho" pos="left" src="miho030"/><msg @l="1222" char_id="0" frame_id="-1" name="美帆"   text="『是没错……但您怎么知道的？』" voices=""/><char @l="1226" id="rei" pos="right" src="rei031"/><msg @l="1228" char_id="1" frame_id="-1" name="玲" text="『这种事情我当然知道。』"   voices=""/><msg @l="1230" char_id="1" frame_id="-1" name="玲"   text="『那孩子，是冲着稻庭学长才想去见学会的吧？』" voices=""/><char @l="1234" id="miho" pos="left" src="miho036"/><msg @l="1236" char_id="0" frame_id="-1" name="美帆" text="『是、是这样的。』"   voices=""/><char @l="1240" id="rei" pos="right" src="rei030"/><msg @l="1242" char_id="1" frame_id="-1" name="玲"   text="『果然如此。我就猜到是这么回事。』" voices=""/><msg @l="1244" char_id="1" frame_id="-1" name="玲"   text="『因为担心临时举办的见学会能不能有足够的参与者，所以就把稻庭先生抬出来当招牌了吧。』" voices=""/><char @l="1248" id="miho" pos="left" src="miho131"/><msg @l="1250" char_id="0" frame_id="-1" name="美帆" text="『啊哈哈……』" voices=""/><msg @l="1252" char_id="1" frame_id="-1" name="玲" text="『那么，美帆决定加入社团了吗？』"   voices=""/><char @l="1256" id="miho" pos="left" src="miho030"/><msg @l="1258" char_id="0" frame_id="-1" name="美帆" text="『啊……那个。』"   voices=""/><goto @l="1261" cond="!(f.サークル見学会flag&#32;==&#32;2)&#13;&#10;"   label="TempLabel_207"/><char @l="1266" id="miho" pos="left" src="miho036"/><msg @l="1268" char_id="0" frame_id="-1" name="美帆" text="『姑且……已经，加入了。』"   voices=""/><msg @l="1270" char_id="1" frame_id="-1" name="玲"   text="『哎呀，我还以为你昨天似乎不太感兴趣呢？』" voices=""/><msg @l="1272" char_id="0" frame_id="-1" name="美帆"   text="『我自己，在去见学会之前也不太感兴趣……但实际和社团的人接触后，发现比想象中有趣多了。』"   voices=""/><char @l="1276" id="rei" pos="right" src="rei031"/><msg @l="1278" char_id="1" frame_id="-1" name="玲"   text="『别这么说，该不会你其实也是冲着稻庭先生去的吧。』" voices=""/><char @l="1282" id="miho" pos="left" src="miho034"/><msg @l="1284" char_id="0" frame_id="-1" name="美帆" text="『不、不是那样的。』"   voices=""/><char @l="1287" id="miho" pos="left" src="miho133"/><msg @l="1289" char_id="0" frame_id="-1" name="美帆"   text="『我……我我，我是纯粹对网球感兴趣，所以才……。』" voices=""/><char @l="1293" id="rei" pos="right" src="rei030"/><msg @l="1295" char_id="1" frame_id="-1" name="玲"   text="『哎呀，别那么慌张……连开玩笑的我都紧张起来了。』" voices=""/><char @l="1299" id="miho" pos="left" src="miho035"/><msg @l="1301" char_id="0" frame_id="-1" name="美帆"   text="『呜……那就别戏弄我了……。』" voices=""/><char @l="1305" id="rei" pos="right" src="rei031"/><msg @l="1307" char_id="1" frame_id="-1" name="玲" text="『呵呵，对不起。』"   voices=""/><char @l="1311" id="rei" pos="right" src="rei030"/><msg @l="1313" char_id="1" frame_id="-1" name="玲"   text="『但是……就算你是我的情敌，我也不会认输的哦。』" voices=""/><char @l="1317" id="rei" pos="right" src="rei030"/><msg @l="1319" char_id="1" frame_id="-1" name="玲"   text="『无论如何，我一定会让稻庭先生回头看我的。』" voices=""/><char @l="1323" id="miho" pos="left" src="miho034"/><msg @l="1325" char_id="0" frame_id="-1" name="美帆" text="『玲小姐……。』" voices=""/><char @l="1329" id="rei" pos="right" src="rei030"/><msg @l="1331" char_id="1" frame_id="-1" name="玲" text="『爱情的力量是很强大的。』"   voices=""/><msg @l="1333" char_id="1" frame_id="-1" name="玲" text="『你也要做好心理准备哦。』"   voices=""/><char @l="1337" id="miho" pos="left" src="miho130"/><msg @l="1339" char_id="0" frame_id="-1" name="美帆" text="『是、是的。』" voices=""/><goto @l="1342" label="TempLabel_208"/><label @l="1343" id="TempLabel_207"/><char @l="1349" id="miho" pos="left" src="miho036"/><msg @l="1351" char_id="0" frame_id="-1" name="美帆" text="『我……没有加入社团。』"   voices=""/><char @l="1355" id="rei" pos="right" src="rei034"/><msg @l="1357" char_id="1" frame_id="-1" name="玲" text="『咦，为什么呢？』"   voices=""/><msg @l="1359" char_id="0" frame_id="-1" name="美帆"   text="『没有什么明确的理由……。』" voices=""/><msg @l="1361" char_id="0" frame_id="-1" name="美帆"   text="『体育类的社团……果然觉得不太适合我。』" voices=""/><char @l="1365" id="rei" pos="right" src="rei030"/><msg @l="1367" char_id="1" frame_id="-1" name="玲"   text="『其实我们社团没有那么多条条框框……不过，既然你参加了见学会后觉得不合适，那也没办法了。』"   voices=""/><char @l="1371" id="miho" pos="left" src="miho136"/><msg @l="1373" char_id="0" frame_id="-1" name="美帆" text="『……对不起。』"   voices=""/><msg @l="1375" char_id="1" frame_id="-1" name="玲" text="『你没必要向我道歉吧？』"   voices=""/><msg @l="1377" char_id="0" frame_id="-1" name="美帆" text="『啊，是的……对不起。』"   voices=""/><char @l="1381" id="rei" pos="right" src="rei034"/><msg @l="1383" char_id="1" frame_id="-1" name="玲" text="『又在道歉了。』" voices=""/><char @l="1387" id="miho" pos="left" src="miho035"/><msg @l="1389" char_id="0" frame_id="-1" name="美帆"   text="『呜……已经，这成了我的习惯了。』" voices=""/><msg @l="1391" char_id="0" frame_id="-1" name="美帆"   text="『不知为何，我总是会条件反射地道歉……。』" voices=""/><char @l="1395" id="rei" pos="right" src="rei030"/><msg @l="1397" char_id="1" frame_id="-1" name="玲" text="『这可能是个不太好的习惯呢。』"   voices=""/><msg @l="1399" char_id="0" frame_id="-1" name="美帆" text="『对不起……。』"   voices=""/><msg @l="1401" char_id="1" frame_id="-1" name="玲" text="『又来了。』" voices=""/><char @l="1405" id="miho" pos="left" src="miho135"/><msg @l="1407" char_id="0" frame_id="-1" name="美帆" text="『啊呜……。』" voices=""/><msg @l="1409" char_id="1" frame_id="-1" name="玲"   text="『确实，如果不改变这种性格的话，别说是加入社团了。』" voices=""/><msg @l="1411" char_id="0" frame_id="-1" name="美帆" text="『对不——……啊，呜呜。』"   voices=""/><char @l="1415" id="rei" pos="right" src="rei031"/><msg @l="1417" char_id="1" frame_id="-1" name="玲"   text="『对了对了，就这样一点一点地努力吧。』" voices=""/><char @l="1421" id="rei" pos="right" src="rei030"/><msg @l="1423" char_id="1" frame_id="-1" name="玲"   text="『人是可以随时改变的，不要自己给自己下定论说'我就是这样的人'，要努力去改变才行呢。』"   voices=""/><msg @l="1425" char_id="0" frame_id="-1" name="美帆" text="『……好的。』" voices=""/><stopbgm @l="1428" fadeout="1000"/><se @l="1432" buf="3" loop="true" src="着メロ2" volume="1."/><char @l="1436" id="rei" pos="right" src="rei031"/><msg @l="1438" char_id="1" frame_id="-1" name="玲"   text="『咦，这个时间接到电话真是少见呢……？』" voices=""/><char @l="1442" id="miho" pos="left" src="miho034"/><msg @l="1444" char_id="0" frame_id="-1" name="美帆"   text="『啊，是我的手机……我出去接一下。』" voices=""/><stopse @l="1448" buf="3"/><stopbgm @l="1452" fadeout="1000"/><clear @l="1457" class="all"/><wait_chgmv/><bg @l="1461" src="bg01b"/><se @l="1465" buf="3" loop="true" src="着メロ2" volume="1."/><char @l="1469" id="miho" pos="auto" src="miho030"/><msg @l="1471" char_id="0" frame_id="-1" name="美帆" text="(嗯……手机在……啊，找到了)"   voices=""/><msg @l="1473" char_id="0" frame_id="-1" name="美帆" text="(打来的是……家里打来的？)"   voices=""/><stopse @l="1477" buf="3"/><msg @l="1479" char_id="0" frame_id="-1" name="美帆" text="『喂，您好……』"   voices=""/><msg @l="1481" char_id="2" frame_id="-1" name="声音" text="『喂，姐姐？』"   voices=""/><char @l="1485" id="miho" pos="auto" src="miho034"/><msg @l="1487" char_id="0" frame_id="-1" name="美帆" text="『这个声音……亚季奈？』"   voices=""/><bgm @l="1491" src="bgm06" volume="1."/><msg @l="1493" char_id="2" frame_id="-1" name="亚季奈" text="『叮咚，完全正确。』"   voices=""/><msg @l="1495" char_id="2" frame_id="-1" name="亚季奈" text="『奖品是妹妹优待券，为期一年哦～。』"   voices=""/><char @l="1499" id="miho" pos="auto" src="miho036"/><msg @l="1501" char_id="0" frame_id="-1" name="美帆" text="『什么啊，那个妹妹优待券……』"   voices=""/><msg @l="1503" char_id="2" frame_id="-1" name="亚季奈"   text="『你看，以前不是有送按摩券之类的吗？那个的我版本。』" voices=""/><msg @l="1505" char_id="2" frame_id="-1" name="亚季奈"   text="『拿到券的姐姐必须优待我哦。』" voices=""/><msg @l="1507" char_id="0" frame_id="-1" name="美帆" text="『我才不需要那种东西呢……』"   voices=""/><msg @l="1509" char_id="2" frame_id="-1" name="亚季奈" text="『切，明明不用客气的～』"   voices=""/><char @l="1513" id="miho" pos="auto" src="miho030"/><msg @l="1515" char_id="0" frame_id="-1" name="美帆" text="『话说回来，突然怎么了？』"   voices=""/><char @l="1519" id="miho" pos="auto" src="miho036"/><msg @l="1521" char_id="0" frame_id="-1" name="美帆"   text="『该不会，你只是为了说这种事才打电话来的吧？』" voices=""/><msg @l="1523" char_id="2" frame_id="-1" name="亚季奈" text="『不是啦～』" voices=""/><msg @l="1525" char_id="2" frame_id="-1" name="亚季奈"   text="『今天打电话是因为有一辈子的请求要对姐姐说！』" voices=""/><char @l="1529" id="miho" pos="auto" src="miho034"/><msg @l="1531" char_id="0" frame_id="-1" name="美帆" text="『一辈子的请求……？』"   voices=""/><msg @l="1533" char_id="2" frame_id="-1" name="亚季奈" text="『对，一辈子的请求！』"   voices=""/><char @l="1537" id="miho" pos="auto" src="miho036"/><msg @l="1539" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="1541" char_id="-1" frame_id="-1" name=""   text="对于亚季奈的“一辈子的请求”，从以前开始就已经多次让我经历了不少麻烦事。" voices=""/><msg @l="1542" char_id="-1" frame_id="-1" name=""   text="瞒着妈妈捡回小狗的时候，或者莫名其妙地要和亚季奈班上的男生约会的情况也发生过。"   voices=""/><msg @l="1543" char_id="-1" frame_id="-1" name=""   text="总之亚季奈的“一辈子的请求”，从来没好事。" voices=""/><msg @l="1545" char_id="0" frame_id="-1" name="美帆"   text="『……该不会，又是什么过分的事情吧？』" voices=""/><msg @l="1547" char_id="2" frame_id="-1" name="亚季奈" text="『才不是什么过分的事呢～』"   voices=""/><msg @l="1549" char_id="2" frame_id="-1" name="亚季奈"   text="『你知道这边最近有游泳比赛吧？』" voices=""/><char @l="1553" id="miho" pos="auto" src="miho030"/><msg @l="1555" char_id="0" frame_id="-1" name="美帆"   text="『啊，嗯……这个时期每年都会举办呢。』" voices=""/><msg @l="1557" char_id="-1" frame_id="-1" name="" text="亚季奈现在是游泳部的成员……"   voices=""/><msg @l="1558" char_id="-1" frame_id="-1" name=""   text="我也在几年前和亚季奈一样是游泳部的成员。" voices=""/><msg @l="1559" char_id="-1" frame_id="-1" name=""   text="不过在我和亚季奈同龄的时候，我早就退出游泳部了……。" voices=""/><msg @l="1561" char_id="2" frame_id="-1" name="亚季奈"   text="『其实，为了那个比赛我们要进行强化集训……。』" voices=""/><msg @l="1563" char_id="2" frame_id="-1" name="亚季奈"   text="『听好了！竟然集训地点就在姐姐的大学！』" voices=""/><char @l="1567" id="miho" pos="auto" src="miho036"/><msg @l="1569" char_id="0" frame_id="-1" name="美帆" text="『啊，哦……真巧呢。』"   voices=""/><msg @l="1571" char_id="2" frame_id="-1" name="亚季奈"   text="『什么啊～，反应也太平淡了吧！？』" voices=""/><msg @l="1573" char_id="0" frame_id="-1" name="美帆"   text="『没，没有那回事啦……不就是和平常一样嘛。』" voices=""/><msg @l="1575" char_id="2" frame_id="-1" name="亚季奈" text="『真是的，太没劲了。』"   voices=""/><char @l="1579" id="miho" pos="auto" src="miho030"/><msg @l="1581" char_id="0" frame_id="-1" name="美帆"   text="『但是……这和“一辈子的请求”有什么关系？』" voices=""/><msg @l="1583" char_id="2" frame_id="-1" name="亚季奈" text="『一辈子的请求是接下来的事。』"   voices=""/><msg @l="1585" char_id="2" frame_id="-1" name="亚季奈"   text="『其实我想在那次强化集训的时候，能不能请姐姐当我们的教练。』" voices=""/><char @l="1589" id="miho" pos="auto" src="miho034"/><msg @l="1591" char_id="0" frame_id="-1" name="美帆" text="『啊……』" voices=""/><msg @l="1593" char_id="2" frame_id="-1" name="亚季奈"   text="『你看，虽然是过去的事了，但姐姐也是纪录保持者对吧？』" voices=""/><msg @l="1595" char_id="2" frame_id="-1" name="亚季奈"   text="『果然有这样的人在身边指导的话，大家的成绩也会有所提高吧。』" voices=""/><msg @l="1597" char_id="0" frame_id="-1" name="美帆"   text="『但，但是……如果在我们大学集训的话，不是应该有游泳社团之类的来指导你们游泳吗？』" voices=""/><msg @l="1599" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯——，虽然大致是这么安排的，不过姐姐所在的大学也不是游泳特别强，也没有什么大赛获奖者对吧？』"   voices=""/><char @l="1603" id="miho" pos="auto" src="miho036"/><msg @l="1605" char_id="0" frame_id="-1" name="美帆" text="『嗯，嗯……』"   voices=""/><msg @l="1607" char_id="-1" frame_id="-1" name=""   text="确实，自从进入现在的大学后，我没听说过有人在游泳比赛中获奖的事。" voices=""/><msg @l="1608" char_id="-1" frame_id="-1" name=""   text="不……选择大学时，为了不让自己产生留恋，我特意选了一所不太重视游泳的学校，所以这也是理所当然的吧。"   voices=""/><msg @l="1610" char_id="2" frame_id="-1" name="亚季奈"   text="『所以，有姐姐作为援手的话会让人很有底气！』" voices=""/><msg @l="1612" char_id="0" frame_id="-1" name="美帆"   text="『但是……这种事，果然不可能啊。』" voices=""/><msg @l="1614" char_id="0" frame_id="-1" name="美帆"   text="『一个没什么关系的人出现在泳池边肯定会被奇怪地看待吧……啊，而且我退出游泳时把竞泳用的泳衣都扔掉了。』"   voices=""/><msg @l="1616" char_id="2" frame_id="-1" name="亚季奈"   text="『没问题没问题，根本不会被奇怪地看待啦。』" voices=""/><msg @l="1618" char_id="2" frame_id="-1" name="亚季奈"   text="『而且姐姐是教练嘛，所以穿那种去海边或户外泳池用的泳衣也完全可以哦。』" voices=""/><msg @l="1620" char_id="0" frame_id="-1" name="美帆"   text="『真是的，亚季奈总是这样随便说话……』" voices=""/><msg @l="1622" char_id="2" frame_id="-1" name="亚季奈"   text="『其实呢，我已经跟游泳部的孩子们说了'我姐姐会完美地担任教练，所以放心吧！'……这样的话了。』"   voices=""/><msg @l="1624" char_id="2" frame_id="-1" name="亚季奈"   text="『所以，无论如何姐姐不来当教练的话我就麻烦了！』" voices=""/><msg @l="1626" char_id="0" frame_id="-1" name="美帆" text="(……原来如此)"   voices=""/><msg @l="1628" char_id="-1" frame_id="-1" name="" text="难怪说是“一生的请求”啊。"   voices=""/><msg @l="1629" char_id="-1" frame_id="-1" name=""   text="真是的……果然提出了一个不讲道理的请求啊。" voices=""/><msg @l="1631" char_id="2" frame_id="-1" name="亚季奈"   text="『呐，拜托了……就当是帮可爱的妹妹一把吧！』" voices=""/><msg @l="1633" char_id="0" frame_id="-1" name="美帆"   text="『可是，我已经退出游泳了啊……』" voices=""/><msg @l="1635" char_id="0" frame_id="-1" name="美帆"   text="『我已经超过三年没游泳了哦？我没信心能教得好。』" voices=""/><msg @l="1637" char_id="2" frame_id="-1" name="亚季奈"   text="『姐姐肯定没问题的，我来保证！』" voices=""/><msg @l="1639" char_id="0" frame_id="-1" name="美帆"   text="『被亚季奈保证我可高兴不起来……』" voices=""/><msg @l="1641" char_id="2" frame_id="-1" name="亚季奈"   text="『呜……总、总之！合宿从下周一开始。』" voices=""/><msg @l="1643" char_id="2" frame_id="-1" name="亚季奈"   text="『课程结束后一定要来室内游泳池哦！』" voices=""/><char @l="1647" id="miho" pos="auto" src="miho034"/><msg @l="1649" char_id="0" frame_id="-1" name="美帆"   text="『诶，啊……等下，你怎么自己擅自决定了……』" voices=""/><msg @l="1651" char_id="2" frame_id="-1" name="亚季奈" text="『那么，拜托你了！』"   voices=""/><se @l="1655" buf="1" src="通話が切れた後の音" volume="1."/><msg @l="1657" char_id="0" frame_id="-1" name="美帆"   text="『喂，亚季奈……挂断了。』" voices=""/><stopse @l="1661" buf="1"/><bgm @l="1665" src="bgm02" volume="1."/><char @l="1669" id="miho" pos="auto" src="miho136"/><msg @l="1671" char_id="0" frame_id="-1" name="美帆"   text="『真是的……总是这么自私任性……』" voices=""/><msg @l="1673" char_id="0" frame_id="-1" name="美帆" text="『………。』" voices=""/><msg @l="1675" char_id="0" frame_id="-1" name="美帆" text="『游泳啊……』"   voices=""/><msg @l="1677" char_id="0" frame_id="-1" name="美帆"   text="『如果没发生那件事的话，我现在说不定还在继续游泳呢……』" voices=""/><msg @l="1679" char_id="-1" frame_id="-1" name=""   text="因为某个事件，我放弃了游泳。" voices=""/><msg @l="1680" char_id="-1" frame_id="-1" name=""   text="不是身体受伤或感到了极限……不是这种常见的理由。" voices=""/><msg @l="1681" char_id="-1" frame_id="-1" name="" text="那确实是一起“事件”。"   voices=""/><msg @l="1682" char_id="-1" frame_id="-1" name=""   text="在相关人士……特别是按照我的意愿，避免公开而秘密埋葬在黑暗中的事件。" voices=""/><msg @l="1683" char_id="-1" frame_id="-1" name=""   text="然而，它至今仍在我心中留下了深深的伤痕。" voices=""/><msg @l="1684" char_id="-1" frame_id="-1" name="" text="……毫无疑问。" voices=""/><msg @l="1686" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><char @l="1690" id="miho" pos="auto" src="miho130"/><msg @l="1692" char_id="0" frame_id="-1" name="美帆"   text="(不过……眼前的问题是，总之周二要交的报告吧)" voices=""/><msg @l="1694" char_id="-1" frame_id="-1" name=""   text="我想起了今天必修课上布置的报告。" voices=""/><msg @l="1695" char_id="-1" frame_id="-1" name=""   text="截止日期连一周都不到本来就很离谱，但现在抱怨也不会让期限延长。"   voices=""/><msg @l="1697" char_id="0" frame_id="-1" name="美帆"   text="(明天要去图书馆借资料，然后……)" voices=""/><char @l="1701" id="miho" pos="auto" src="miho136"/><msg @l="1703" char_id="0" frame_id="-1" name="美帆"   text="(当什么教练……报告，能按时完成吗……)" voices=""/><stopbgm @l="1707" fadeout="1000"/><clear @l="1712" class="all"/><wait_chgmv/><bg @l="1716" src="bg03b"/><bgm @l="1720" src="bgm04" volume="1."/><char @l="1724" id="miho" pos="left" src="miho030"/><char @l="1727" id="rei" pos="right" src="rei030"/><msg @l="1729" char_id="1" frame_id="-1" name="玲" text="『电话，聊得挺起劲的嘛。』"   voices=""/><msg @l="1731" char_id="1" frame_id="-1" name="玲" text="『大学的朋友？』" voices=""/><char @l="1735" id="miho" pos="left" src="miho036"/><msg @l="1737" char_id="0" frame_id="-1" name="美帆" text="『不，是我妹妹。』"   voices=""/><stopbgm @l="1740" fadeout="1000"/><char @l="1744" id="rei" pos="right" src="rei034"/><msg @l="1746" char_id="1" frame_id="-1" name="玲" text="『……妹妹……。』"   voices=""/><char @l="1749" id="miho" pos="left" src="miho034"/><msg @l="1751" char_id="0" frame_id="-1" name="美帆"   text="『……玲小姐？怎么了？』" voices=""/><char @l="1754" id="rei" pos="right" src="rei031"/><msg @l="1756" char_id="1" frame_id="-1" name="玲"   text="『啊……，没什么……那你妹妹怎么了？』" voices=""/><bgm @l="1759" src="bgm04" volume="1."/><char @l="1761" id="miho" pos="left" src="miho036"/><msg @l="1762" char_id="0" frame_id="-1" name="美帆"   text="『嗯……她好像很喜欢社团活动，学习方面倒是一塌糊涂，让我很头疼。』" voices=""/><char @l="1766" id="rei" pos="right" src="rei030"/><msg @l="1768" char_id="1" frame_id="-1" name="玲"   text="『学习什么的需要的时候再做就好了。说起来是妹妹啊，我是独生女所以很羡慕呢。』" voices=""/><msg @l="1770" char_id="1" frame_id="-1" name="玲"   text="『如果我也有个妹妹……会不会像你这样呢？』" voices=""/><char @l="1773" id="miho" pos="left" src="miho136"/><msg @l="1775" char_id="0" frame_id="-1" name="美帆" text="『我觉得会有点不一样。』"   voices=""/><msg @l="1777" char_id="0" frame_id="-1" name="美帆"   text="『我和玲小姐只差一岁……而且，亚季奈……我妹妹是个和我完全相反的活泼孩子。』" voices=""/><char @l="1781" id="rei" pos="right" src="rei031"/><msg @l="1783" char_id="1" frame_id="-1" name="玲"   text="『性格啊年龄差什么的都无所谓，这只是所谓的感觉问题。』" voices=""/><char @l="1786" id="miho" pos="left" src="miho036"/><msg @l="1788" char_id="0" frame_id="-1" name="美帆" text="『嗯——，我不太明白呢……。』"   voices=""/><char @l="1792" id="miho" pos="left" src="miho030"/><msg @l="1794" char_id="0" frame_id="-1" name="美帆"   text="『那么这么说的话，假如我有个姐姐……会不会就像玲小姐这样呢。』" voices=""/><char @l="1798" id="miho" pos="left" src="miho036"/><msg @l="1800" char_id="0" frame_id="-1" name="美帆"   text="『话虽如此，我家妹妹才不会对我用敬语呢……。』" voices=""/><char @l="1804" id="rei" pos="right" src="rei030"/><msg @l="1806" char_id="1" frame_id="-1" name="玲"   text="『呵呵，姐妹之间大概就是这样吧。』" voices=""/><eval @l="1809" expr="f.亜季奈ルート確定flag&#32;=&#32;1&#13;&#10;"/><label @l="1813" id="TempLabel_208"/><msg @l="1816" char_id="1" frame_id="-1" name="玲"   text="『那么，我也去洗个澡了。』" voices=""/><char @l="1820" id="miho" pos="left" src="miho030"/><msg @l="1822" char_id="0" frame_id="-1" name="美帆" text="『啊，好的。』" voices=""/><msg @l="1824" char_id="0" frame_id="-1" name="美帆"   text="『我就这样睡了，电视和电灯我会关掉的。』" voices=""/><char @l="1828" id="rei" pos="right" src="rei030"/><msg @l="1830" char_id="1" frame_id="-1" name="玲" text="『拜托你了。』" voices=""/><clear @l="1834" layer="rei"/><msg @l="1836" char_id="0" frame_id="-1" name="美帆"   text="『那么把灯关掉……。』" voices=""/><wait_chgmv/><bg @l="1839" src="bg03c"/><msg @l="1841" char_id="0" frame_id="1" name="美帆" text="（晚安……。）"   voices=""/><goto @l="1844" label="TempLabel_209"/><label @l="1845" id="TempLabel_206"/><goto @l="1846" cond="!(f.サークル見学会flag&#32;==&#32;0)&#13;&#10;"   label="TempLabel_210"/><clear @l="1851" class="char"/><char @l="1854" id="miho" pos="left" src="miho031"/><msg @l="1856" char_id="0" frame_id="1" name="美帆"   text="『这部电视剧，你经常看吧……有意思吗？』" voices=""/><char @l="1860" id="rei" pos="right" src="rei030"/><msg @l="1862" char_id="1" frame_id="-1" name="玲"   text="『还行吧。听说是最近很热门的电视剧，所以想看看。』" voices=""/><char @l="1866" id="miho" pos="left" src="miho036"/><msg @l="1868" char_id="0" frame_id="1" name="美帆"   text="『对我来说，所有电视剧看起来都差不多……』" voices=""/><char @l="1872" id="miho" pos="left" src="miho031"/><msg @l="1874" char_id="0" frame_id="1" name="美帆" text="『真的有好坏之分吗？』"   voices=""/><char @l="1878" id="rei" pos="right" src="rei031"/><msg @l="1880" char_id="1" frame_id="-1" name="玲"   text="『当然有啊。不同作品有不同的导演、编剧，演员也各不相同。』" voices=""/><char @l="1884" id="rei" pos="right" src="rei030"/><msg @l="1886" char_id="1" frame_id="-1" name="玲"   text="『自然而然，各部作品的评价也就千差万别了。』" voices=""/><msg @l="1888" char_id="0" frame_id="1" name="美帆" text="『是这样啊……』"   voices=""/><msg @l="1890" char_id="1" frame_id="-1" name="玲"   text="『熟能生巧嘛。首先选一部系列剧，不管哪一部都行，从头看到尾试试看。』" voices=""/><msg @l="1892" char_id="1" frame_id="-1" name="玲" text="『说不定，你会找到喜欢的电视剧哦？』"   voices=""/><msg @l="1894" char_id="0" frame_id="1" name="美帆"   text="『我比起看电视，更喜欢读书……所以才不怎么看电视剧的。』" voices=""/><char @l="1897" id="rei" pos="right" src="rei031"/><msg @l="1899" char_id="1" frame_id="-1" name="玲"   text="『哎呀，读书挺好的啊。说实话，比起看电视，读书更有益处。』" voices=""/><char @l="1903" id="rei" pos="right" src="rei034"/><msg @l="1905" char_id="1" frame_id="-1" name="玲"   text="『说起来我……最近除了公司介绍手册以外什么都没读呢。』" voices=""/><char @l="1909" id="miho" pos="left" src="miho036"/><msg @l="1911" char_id="0" frame_id="1" name="美帆" text="『求职活动看起来真辛苦呢。』"   voices=""/><char @l="1915" id="rei" pos="right" src="rei030"/><msg @l="1917" char_id="1" frame_id="-1" name="玲"   text="『是啊……其实我看这部电视剧，也是因为它现在很流行，所以想着看一看会不会有帮助。不过，到目前为止这还没跟求职考试有过任何关系……』"   voices=""/><char @l="1920" id="miho" pos="left" src="miho031"/><msg @l="1922" char_id="0" frame_id="1" name="美帆"   text="『呵呵，真遗憾呢。不过说不定哪天会派上用场哦？』" voices=""/><char @l="1926" id="miho" pos="left" src="miho030"/><msg @l="1928" char_id="0" frame_id="1" name="美帆"   text="『话说回来，求职考试都做了些什么准备呢？』" voices=""/><char @l="1931" id="rei" pos="right" src="rei030"/><msg @l="1933" char_id="1" frame_id="-1" name="玲"   text="『为了笔试，我准备了大学实习时做的报告，还有因为我是设计方向的，所以带上几份原创设计图就可以了吧。』"   voices=""/><msg @l="1935" char_id="0" frame_id="1" name="美帆" text="『真实用呢。』"   voices=""/><msg @l="1937" char_id="1" frame_id="-1" name="玲"   text="『光靠学历是做不好设计的。当然也不能忽视学习就是了。』" voices=""/><char @l="1941" id="miho" pos="left" src="miho034"/><msg @l="1943" char_id="0" frame_id="1" name="美帆" text="『是这样吗……？』"   voices=""/><msg @l="1945" char_id="1" frame_id="-1" name="玲"   text="『建筑设计这份工作，不仅要考虑外观，还必须兼顾实用性和耐久性……所以物理计算是必不可少的。』"   voices=""/><msg @l="1947" char_id="1" frame_id="-1" name="玲"   text="『还有，有时候还需要懂一些无机材料化学。』" voices=""/><msg @l="1949" char_id="0" frame_id="1" name="美帆"   text="『嗯……建筑设计师需要掌握很多知识啊。』" voices=""/><msg @l="1951" char_id="1" frame_id="-1" name="玲" text="『正因如此，我觉得这份工作很有成就感。』"   voices=""/><char @l="1955" id="miho" pos="left" src="miho031"/><msg @l="1957" char_id="0" frame_id="1" name="美帆" text="『好帅气啊。』"   voices=""/><char @l="1961" id="rei" pos="right" src="rei031"/><msg @l="1963" char_id="1" frame_id="-1" name="玲"   text="『这种赞美的话，等我拿到录用通知后再说吧。』" voices=""/><char @l="1967" id="rei" pos="right" src="rei030"/><msg @l="1969" char_id="1" frame_id="-1" name="玲"   text="『光有目标谁都可以……问题是，能不能真正踏上自己向往的道路。』" voices=""/><char @l="1972" id="miho" pos="left" src="miho030"/><msg @l="1974" char_id="0" frame_id="1" name="美帆" text="『说得对。』" voices=""/><char @l="1977" id="miho" pos="left" src="miho136"/><msg @l="1979" char_id="0" frame_id="1" name="美帆"   text="『像我这种，连目标都还没确定的人……』" voices=""/><msg @l="1981" char_id="1" frame_id="-1" name="玲"   text="『再这么磨蹭下去，明年就要遇到麻烦了哦。』" voices=""/><char @l="1985" id="miho" pos="left" src="miho036"/><msg @l="1987" char_id="0" frame_id="1" name="美帆" text="『我，我会加油的。』"   voices=""/><msg @l="1989" char_id="-1" frame_id="-1" name=""   text="一边这么说着，一边不经意地看向电视，屏幕上正在播放一则广告，里面有棵似曾相识的大树。伴随着优美的钢琴旋律和那棵雄伟的树木作为背景，各种公司的名字不断地在屏幕上滚动。"   voices=""/><msg @l="1991" char_id="-1" frame_id="-1" name="ＣＭ"   text="『承诺为您的城市带来未来的大黑集团。本节目由大黑集团赞助播出───。』" voices=""/><char @l="1994" id="miho" pos="left" src="miho134"/><msg @l="1996" char_id="0" frame_id="1" name="美帆"   text="『啊，这该不会就是玲姐要应聘的大黑建设吧？』" voices=""/><char @l="1999" id="rei" pos="right" src="rei031"/><msg @l="2001" char_id="1" frame_id="-1" name="玲"   text="『没错。自己即将就职的公司赞助的节目，肯定要好好关注一下才行吧？』"   voices=""/><msg @l="2003" char_id="0" frame_id="1" name="美帆"   text="『原来大黑集团是这么大的企业啊。』" voices=""/><msg @l="2005" char_id="1" frame_id="-1" name="玲"   text="『是啊。实际上，就连这座城市也是多亏了大黑集团旗下不仅有大黑建设，还有各种产业的支持，才发展到现在这么大规模的。』"   voices=""/><char @l="2008" id="miho" pos="left" src="miho131"/><msg @l="2010" char_id="0" frame_id="1" name="美帆"   text="『哇～玲姐真是太厉害了。』" voices=""/><char @l="2013" id="rei" pos="right" src="rei030"/><msg @l="2015" char_id="1" frame_id="-1" name="玲"   text="『喂喂，我现在只是准备去应聘而已，一点都不厉害哦。』" voices=""/><msg @l="2017" char_id="0" frame_id="1" name="美帆"   text="『但我相信玲姐一定没问题的。我会为你加油的。』" voices=""/><char @l="2020" id="rei" pos="right" src="rei031"/><msg @l="2022" char_id="1" frame_id="-1" name="玲" text="『呵呵，谢谢。』"   voices=""/><eval @l="2025" expr="f.玲ルート確定flag&#32;=&#32;1&#13;&#10;"/><label @l="2028" id="TempLabel_210"/><label @l="2029" id="TempLabel_209"/><stopbgm @l="2034" fadeout="1000"/><clear @l="2040" class="all"/><goto @l="2046" cond="!(f.亜季奈ルート確定flag&#32;==&#32;1)&#13;&#10;"   label="TempLabel_211"/><call @l="2049" target="EventLabel_59@root_akina01"/><return @l="2050" value="0&#13;&#10;"/><goto @l="2053" label="TempLabel_236"/><label @l="2054" id="TempLabel_211"/><goto @l="2055" cond="!(f.玲ルート確定flag&#32;==&#32;1)&#13;&#10;"   label="TempLabel_237"/><call @l="2060" target="EventLabel_130@root_rei01"/><return @l="2061" value="0&#13;&#10;"/><goto @l="2064" label="TempLabel_236"/><label @l="2065" id="TempLabel_237"/><call @l="2070" target="EventLabel_35@common_root05"/><return @l="2071" value="0&#13;&#10;"/><label @l="2074" id="TempLabel_236"/><return @l="2078" value=""/></code></xscript>																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																												