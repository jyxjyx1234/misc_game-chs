<?xml version="1.0" encoding="utf-8"?><xscript><debug editor="&quot;C:\Program&#32;Files&#32;(x86)\sakura\sakura.exe&quot;&#32;&quot;%src%&quot;&#32;-Y=%line%"   src="D:\シロップ\町ぐるみの罠＋汚された夏セット版\汚された夏\完成データ\汚された夏\script\text\root_akina04b.txt"/><code><label @l="12" id="EventLabel_79"/><description @l="16" text="游泳教练·第4天(B)"/><eval @l="18" expr="f.numDay=11&#13;&#10;"/><msgshow @l="20" show="false"/><wait_chgmv/><bg @l="22" src="day11" time="2000"/><wait @l="24" time="500"/><wait_chgmv/><bg @l="26" src="black" time="2000"/><msgshow @l="28" show="true"/><wait_chgmv/><bg @l="32" src="bg09"/><bgm @l="36" src="bgm10" volume="1."/><char @l="40" id="miho" pos="auto" src="miho116"/><msg @l="42" char_id="0" frame_id="-1" name="美帆" text="『这……是什么意思？』"   voices=""/><clear @l="45" class="char"/><char @l="47" id="miho" pos="left" src="miho116"/><char @l="49" id="watab" pos="right" src="watabe010"/><msg @l="51" char_id="-1" frame_id="-1" name="渡部"   text="『没什么特别的意思，我只是在问你昨天练习期间做了什么而已。』" voices=""/><msg @l="53" char_id="-1" frame_id="-1" name="渡部"   text="『难道作为顾问询问自己负责的部门的练习内容，是很奇怪的事情吗？』" voices=""/><msg @l="55" char_id="0" frame_id="1" name="美帆"   text="（这种事……明明之前从来都不会过问的）" voices=""/><msg @l="57" char_id="-1" frame_id="-1" name=""   text="确实……渡部老师的说法是合理的。" voices=""/><msg @l="58" char_id="-1" frame_id="-1" name=""   text="向作为教练的我询问训练内容，从常识上考虑也是很正常的。" voices=""/><msg @l="59" char_id="-1" frame_id="-1" name=""   text="但是，为什么偏偏要问「昨天的事情」呢。" voices=""/><msg @l="60" char_id="-1" frame_id="-1" name=""   text="我被玷污的那个时间……竟然要我详细说明那时的训练内容。" voices=""/><char @l="63" id="miho" pos="left" src="miho016"/><msg @l="65" char_id="0" frame_id="1" name="美帆"   text="『我昨天在训练途中感到身体不适……没能监督训练。』" voices=""/><msg @l="67" char_id="0" frame_id="1" name="美帆"   text="『所以……我无法准确地汇报昨天的训练内容。』" voices=""/><msg @l="69" char_id="-1" frame_id="-1" name="渡部" text="『哦，感到身体不适是吗……？』"   voices=""/><msg @l="71" char_id="0" frame_id="1" name="美帆" text="『你、你是什么意思……。』"   voices=""/><char @l="74" id="watab" pos="right" src="watabe012"/><msg @l="76" char_id="-1" frame_id="-1" name="渡部"   text="『没什么，只是我听到的事实和你说的不一致。』" voices=""/><msg @l="78" char_id="0" frame_id="1" name="美帆" text="『听到……？』" voices=""/><char @l="82" id="miho" pos="left" src="miho114"/><msg @l="84" char_id="0" frame_id="1" name="美帆" text="『这是什么意思！？』"   voices=""/><msg @l="86" char_id="-1" frame_id="-1" name=""   text="难道亚季奈已经知道了一切，然后把昨天的事情全部告诉了渡部老师……？" voices=""/><msg @l="87" char_id="-1" frame_id="-1" name="" text="不……这不可能……。"   voices=""/><msg @l="88" char_id="-1" frame_id="-1" name=""   text="那之后，我回到游泳池时亚季奈的惊讶反应绝对不是正常的。" voices=""/><char @l="91" id="watab" pos="right" src="watabe010"/><msg @l="93" char_id="-1" frame_id="-1" name="渡部"   text="『昨天，有人偶然看到了你们在更衣室里做的事。』" voices=""/><msg @l="95" char_id="0" frame_id="1" name="美帆" text="『什…。』" voices=""/><msg @l="97" char_id="-1" frame_id="-1" name="" text="在更衣室里做的事……。"   voices=""/><msg @l="98" char_id="-1" frame_id="-1" name=""   text="毫无疑问，渡部老师说的就是我和那个留学生的事。" voices=""/><char @l="101" id="watab" pos="right" src="watabe012"/><msg @l="103" char_id="-1" frame_id="-1" name="渡部"   text="『不过真是让人吃惊啊……我那么热心地邀请你，你却一直坚持说'不要'，不肯把身体交给我，但面对黑人却立刻就OK了啊。』"   voices=""/><char @l="106" id="miho" pos="left" src="miho014"/><msg @l="108" char_id="0" frame_id="1" name="美帆" text="『不、不是那样的！』"   voices=""/><msg @l="110" char_id="0" frame_id="1" name="美帆" text="『我是被强迫的……然后…。』"   voices=""/><char @l="113" id="watab" pos="right" src="watabe010"/><msg @l="115" char_id="-1" frame_id="-1" name="渡部"   text="『如果是被强迫的，为什么不去警察局，而是直接回到游泳池呢？』" voices=""/><char @l="118" id="miho" pos="left" src="miho115"/><msg @l="120" char_id="0" frame_id="1" name="美帆" text="『那是因为……。』" voices=""/><msg @l="122" char_id="0" frame_id="1" name="美帆"   text="『如果去警察局的话会闹大，而如果我忍耐的话，亚季奈也能继续游泳……。』" voices=""/><msg @l="124" char_id="-1" frame_id="-1" name="" text="而且对方是留学生。"   voices=""/><msg @l="125" char_id="-1" frame_id="-1" name=""   text="国际问题如果被夸大，会引发什么样的骚动根本无法想象。" voices=""/><msg @l="127" char_id="-1" frame_id="-1" name="渡部" text="『原来如此，真是相当高尚的考虑啊。』"   voices=""/><msg @l="129" char_id="-1" frame_id="-1" name="渡部"   text="『但是……你真的是因为这种理由才选择保持沉默的吗？』" voices=""/><msg @l="131" char_id="0" frame_id="1" name="美帆" text="『……？』" voices=""/><msg @l="133" char_id="-1" frame_id="-1" name="渡部" text="『也可以这样想吧。』"   voices=""/><char @l="136" id="watab" pos="right" src="watabe012"/><msg @l="138" char_id="-1" frame_id="-1" name="渡部"   text="『在妹妹所在的游泳部合宿期间想要男人，因为觉得真枪实弹不太好所以只用口交来解决……。』"   voices=""/><char @l="141" id="miho" pos="left" src="miho014"/><msg @l="143" char_id="0" frame_id="1" name="美帆"   text="『什！这种胡言乱语，绝对不可能！』" voices=""/><char @l="146" id="watab" pos="right" src="watabe010"/><msg @l="148" char_id="-1" frame_id="-1" name="渡部" text="『有什么证据能证明不是这样。』"   voices=""/><msg @l="150" char_id="0" frame_id="1" name="美帆"   text="『什么证据……当事人的我都说不是这样了！？』" voices=""/><msg @l="152" char_id="-1" frame_id="-1" name="渡部" text="『有什么证据证明你没说谎？』"   voices=""/><char @l="155" id="miho" pos="left" src="miho115"/><msg @l="157" char_id="0" frame_id="1" name="美帆" text="『证据……没有。』"   voices=""/><msg @l="159" char_id="0" frame_id="1" name="美帆"   text="『但是，这么说的话，现在渡部老师您说的话不也是没有任何证据的编造吗？』" voices=""/><char @l="162" id="watab" pos="right" src="watabe014"/><msg @l="164" char_id="-1" frame_id="-1" name="渡部"   text="『是不是编造根本无所谓。』" voices=""/><msg @l="166" char_id="-1" frame_id="-1" name="渡部"   text="『重要的是外面那些人会怎样解释事实。』" voices=""/><char @l="169" id="miho" pos="left" src="miho015"/><msg @l="172" char_id="0" frame_id="1" name="美帆" text="『什么……』" voices=""/><msg @l="174" char_id="-1" frame_id="-1" name="渡部"   text="『如果我把昨天的事透露给某人会怎样？』" voices=""/><msg @l="176" char_id="-1" frame_id="-1" name="渡部"   text="『当然，是刚才说的那些没有任何证据的编造。』" voices=""/><msg @l="178" char_id="0" frame_id="1" name="美帆"   text="『那种事……和事实不符，所以没人会相信……啊！！！』" voices=""/><char @l="181" id="miho" pos="left" src="miho014"/><char @l="184" id="watab" pos="right" src="watabe010"/><msg @l="186" char_id="-1" frame_id="-1" name="渡部" text="『看来你终于明白了。』"   voices=""/><msg @l="188" char_id="-1" frame_id="-1" name="渡部"   text="『因为没人知道事实，所以我怎么添油加醋都没关系。』" voices=""/><msg @l="190" char_id="-1" frame_id="-1" name="渡部"   text="“而且因为内容都是基于已发生的事实，所以你无论如何都无法狡辩”。" voices=""/><char @l="193" id="miho" pos="left" src="miho115"/><msg @l="195" char_id="0" frame_id="1" name="美帆" text="『怎么会……』" voices=""/><char @l="198" id="watab" pos="right" src="watabe012"/><msg @l="200" char_id="-1" frame_id="-1" name="渡部"   text="『明白了吗？你将会被视为一个随便的女人。』" voices=""/><char @l="203" id="miho" pos="left" src="miho114"/><msg @l="205" char_id="0" frame_id="1" name="美帆"   text="『但，但是……与事实无关的话只会成为谣言而已。』" voices=""/><msg @l="207" char_id="0" frame_id="1" name="美帆"   text="『我可能会感到羞耻，但这种事情随着时间会自然解决的。』" voices=""/><char @l="210" id="miho" pos="left" src="miho116"/><msg @l="212" char_id="-1" frame_id="-1" name=""   text="没错。我已经是个身体再次被玷污的人了。" voices=""/><msg @l="213" char_id="-1" frame_id="-1" name=""   text="世人的看法，更别说谣言和风评，根本不需要在意。" voices=""/><msg @l="214" char_id="-1" frame_id="-1" name=""   text="我现在必须做的是保护亚季奈……" voices=""/><msg @l="215" char_id="-1" frame_id="-1" name="" text="仅此而已。" voices=""/><char @l="218" id="watab" pos="right" src="watabe014"/><msg @l="220" char_id="-1" frame_id="-1" name="渡部" text="『……。』" voices=""/><msg @l="222" char_id="0" frame_id="1" name="美帆"   text="『如果你以为用这种威胁的手段能让我听你的话，那就大错特错了。』" voices=""/><char @l="225" id="miho" pos="left" src="miho015"/><msg @l="227" char_id="0" frame_id="1" name="美帆"   text="『我绝不会屈服于这种威胁……为了亚季奈，绝对不会！』" voices=""/><char @l="231" id="miho" pos="left" src="miho116"/><msg @l="233" char_id="0" frame_id="1" name="美帆" text="『……失礼了。』" voices=""/><clear @l="237" layer="miho"/><stopbgm @l="241" fadeout="1000"/><clear @l="244" class="char"/><char @l="246" id="watab" pos="auto" src="watabe017"/><msg @l="248" char_id="-1" frame_id="-1" name="渡部" text="『该死……！！』"   voices=""/><msg @l="250" char_id="-1" frame_id="-1" name="渡部"   text="『喂，这是怎么回事……不是说绝对会成功的吗！？』" voices=""/><msg @l="252" char_id="-1" frame_id="-1" name="人影" text="『嘛……别那么着急。』"   voices=""/><msg @l="254" char_id="-1" frame_id="-1" name="人影"   text="『虽然失败确实是个失算，但也有所收获。』" voices=""/><msg @l="256" char_id="-1" frame_id="-1" name="渡部" text="『嗯？ 什么意思？』"   voices=""/><msg @l="258" char_id="-1" frame_id="-1" name="人影"   text="『只要切断让那个女孩如此坚强的根源就行了。』" voices=""/><msg @l="260" char_id="-1" frame_id="-1" name="人影"   text="『那些通过保护什么而找到自我价值的人……一旦失去就会崩溃。』" voices=""/><msg @l="262" char_id="-1" frame_id="-1" name="人影" text="『令人恐怖的是，他们会如此轻易地崩溃。』"   voices=""/><clear @l="265" class="all"/><wait_chgmv/><bg @l="268" src="bg10m1"/><bgm @l="271" src="bgm03" volume="1."/><char @l="274" id="miho" pos="auto" src="miho166"/><msg @l="276" char_id="0" frame_id="1" name="美帆" text="『……。』" voices=""/><msg @l="278" char_id="-1" frame_id="-1" name="" text="练习的间隙。" voices=""/><msg @l="279" char_id="-1" frame_id="-1" name="" text="休息时间。" voices=""/><msg @l="280" char_id="-1" frame_id="-1" name=""   text="我坐在泳池边，呆呆地望着水面。" voices=""/><msg @l="281" char_id="-1" frame_id="-1" name=""   text="想要依靠谁，想要哭泣……但又无法接受这样的自己。" voices=""/><msg @l="283" char_id="2" frame_id="-1" name="声音" text="『姐～姐。』" voices=""/><clear @l="286" class="char"/><char @l="288" id="miho" pos="left" src="miho166"/><char @l="290" id="akina" pos="right" src="akina070"/><msg @l="292" char_id="2" frame_id="-1" name="亚季奈" text="『一个人在这里发什么呆呢？』"   voices=""/><msg @l="294" char_id="0" frame_id="1" name="美帆" text="『亚季奈……』" voices=""/><msg @l="296" char_id="0" frame_id="1" name="美帆"   text="『我才没有发呆呢……只是在想点事情而已。』" voices=""/><char @l="299" id="akina" pos="right" src="akina071"/><msg @l="301" char_id="2" frame_id="-1" name="亚季奈"   text="『我觉得这就是所谓的发呆啊。』" voices=""/><msg @l="303" char_id="0" frame_id="1" name="美帆" text="『……。』" voices=""/><char @l="307" id="akina" pos="right" src="akina070"/><msg @l="309" char_id="2" frame_id="-1" name="亚季奈" text="『有什么烦恼吗？』"   voices=""/><msg @l="311" char_id="0" frame_id="1" name="美帆" text="『嗯……差不多吧。』"   voices=""/><msg @l="313" char_id="2" frame_id="-1" name="亚季奈" text="『哦～……』" voices=""/><msg @l="315" char_id="0" frame_id="1" name="美帆" text="『亚季奈……没有吗？』"   voices=""/><msg @l="317" char_id="2" frame_id="-1" name="亚季奈" text="『嗯？什么？』"   voices=""/><msg @l="319" char_id="0" frame_id="1" name="美帆"   text="『烦恼啊……迷茫的事情，没有吗？』" voices=""/><msg @l="321" char_id="2" frame_id="-1" name="亚季奈"   text="『烦恼啊……我基本上不太会烦恼呢。』" voices=""/><msg @l="323" char_id="-1" frame_id="-1" name="" text="从小看着她长大，所以我很了解。"   voices=""/><msg @l="324" char_id="-1" frame_id="-1" name=""   text="这孩子在烦恼或迷茫之前，就已经行动起来了。" voices=""/><msg @l="325" char_id="-1" frame_id="-1" name=""   text="在需要决定左右的场合，她会先凭直觉选择其中一个方向就开始走。" voices=""/><msg @l="326" char_id="-1" frame_id="-1" name=""   text="即使后来发现失败了也不会消沉。" voices=""/><msg @l="327" char_id="-1" frame_id="-1" name=""   text="她会迅速地把失败当作失败处理掉，然后朝着下一个目标前进。" voices=""/><msg @l="328" char_id="-1" frame_id="-1" name=""   text="对于能够这样生活的亚季奈，我已经“羡慕”过她无数次了。" voices=""/><char @l="331" id="miho" pos="left" src="miho066"/><msg @l="333" char_id="0" frame_id="1" name="美帆" text="『真好啊，没有烦恼什么的。』"   voices=""/><char @l="336" id="akina" pos="right" src="akina077"/><bgm @l="338" src="bgm06" volume="1."/><msg @l="340" char_id="2" frame_id="-1" name="亚季奈"   text="『啊，姐姐刚才是在嘲笑我吧。』" voices=""/><msg @l="342" char_id="0" frame_id="1" name="美帆"   text="『没，没有啊……只是觉得很羡慕而已。』" voices=""/><msg @l="344" char_id="2" frame_id="-1" name="亚季奈" text="『果然是在嘲笑我～！』"   voices=""/><msg @l="346" char_id="2" frame_id="-1" name="亚季奈"   text="『真是的……我也有自己的烦恼的好吗。』" voices=""/><char @l="349" id="miho" pos="left" src="miho161"/><msg @l="351" char_id="0" frame_id="1" name="美帆"   text="『反正，不就是'今天晚饭吃什么呢～'之类的吧。』" voices=""/><char @l="354" id="akina" pos="right" src="akina177"/><msg @l="356" char_id="2" frame_id="-1" name="亚季奈"   text="『才不是！不是那种东西，是更正经的烦恼啦！』" voices=""/><char @l="359" id="miho" pos="left" src="miho060"/><msg @l="361" char_id="0" frame_id="1" name="美帆" text="『哦，什么烦恼？』"   voices=""/><char @l="364" id="akina" pos="right" src="akina070"/><msg @l="366" char_id="2" frame_id="-1" name="亚季奈" text="『嗯那个……恋爱的烦恼。』"   voices=""/><char @l="369" id="miho" pos="left" src="miho164"/><msg @l="371" char_id="0" frame_id="1" name="美帆" text="『不会吧！？』" voices=""/><char @l="374" id="akina" pos="right" src="akina174"/><msg @l="376" char_id="2" frame_id="-1" name="亚季奈"   text="『哇，姐姐，你那反应也太过分了！！』" voices=""/><char @l="379" id="miho" pos="left" src="miho066"/><msg @l="381" char_id="0" frame_id="1" name="美帆" text="『诶……啊，抱歉抱歉。』"   voices=""/><msg @l="383" char_id="0" frame_id="1" name="美帆"   text="『没想到居然会从亚季奈口中听到“恋爱”这种词……』…。" voices=""/><char @l="386" id="akina" pos="right" src="akina077"/><msg @l="388" char_id="2" frame_id="-1" name="亚季奈"   text="『哼～，我也是女孩子啊，当然也会谈恋爱～！』" voices=""/><msg @l="390" char_id="0" frame_id="1" name="美帆" text="『这样啊……嗯，是这样呢。』"   voices=""/><msg @l="392" char_id="0" frame_id="1" name="美帆"   text="『刚才是我不对。对不起。』" voices=""/><char @l="395" id="akina" pos="right" src="akina070"/><msg @l="397" char_id="2" frame_id="-1" name="亚季奈" text="『嗯，你明白就好！』"   voices=""/><char @l="400" id="miho" pos="left" src="miho060"/><msg @l="402" char_id="0" frame_id="1" name="美帆" text="『那么……对方是谁呢？』"   voices=""/><char @l="405" id="akina" pos="right" src="akina071"/><msg @l="407" char_id="2" frame_id="-1" name="亚季奈" text="『诶～，这个不能说啦。』"   voices=""/><char @l="410" id="miho" pos="left" src="miho061"/><msg @l="412" char_id="0" frame_id="1" name="美帆"   text="『有什么关系嘛，告诉我吧。是同一个游泳部的男生吗？』" voices=""/><msg @l="414" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯～……虽然在游泳部里，但有点不一样啊～。』" voices=""/><char @l="417" id="miho" pos="left" src="miho164"/><msg @l="419" char_id="0" frame_id="1" name="美帆"   text="『难，难道……对方是女生之类的………？』" voices=""/><char @l="422" id="akina" pos="right" src="akina177"/><msg @l="424" char_id="2" frame_id="-1" name="亚季奈" text="『不是～！』" voices=""/><char @l="427" id="miho" pos="left" src="miho060"/><msg @l="429" char_id="0" frame_id="1" name="美帆" text="『这样啊……那，到底是谁啊？』"   voices=""/><char @l="432" id="akina" pos="right" src="akina070"/><msg @l="434" char_id="2" frame_id="-1" name="亚季奈" text="『………。』" voices=""/><msg @l="436" char_id="0" frame_id="1" name="美帆"   text="『啊，说到这个地步却不肯说出来太狡猾了吧。』" voices=""/><char @l="439" id="miho" pos="left" src="miho061"/><msg @l="441" char_id="0" frame_id="1" name="美帆"   text="『来嘛来嘛，向姐姐坦白吧～。』" voices=""/><msg @l="443" char_id="2" frame_id="-1" name="亚季奈" text="『唔唔……』" voices=""/><msg @l="445" char_id="0" frame_id="1" name="美帆" text="『我不会告诉别人的。』"   voices=""/><msg @l="447" char_id="2" frame_id="-1" name="亚季奈" text="『唔唔唔唔……』"   voices=""/><char @l="450" id="miho" pos="left" src="miho161"/><msg @l="452" char_id="0" frame_id="1" name="美帆"   text="『车站前的咖啡店有种叫特制巨无霸芭菲的东西……我要不要请你吃呢。』" voices=""/><char @l="455" id="akina" pos="right" src="akina171"/><msg @l="457" char_id="2" frame_id="-1" name="亚季奈" text="『真的吗！？』"   voices=""/><msg @l="459" char_id="0" frame_id="1" name="美帆" text="『我才不会骗你呢。』"   voices=""/><char @l="462" id="akina" pos="right" src="akina070"/><msg @l="464" char_id="2" frame_id="-1" name="亚季奈"   text="『那，只告诉姐姐一个人哦……？』" voices=""/><msg @l="466" char_id="0" frame_id="1" name="美帆"   text="『我都要请你吃芭菲了，什么特不特别的都不存在了吧。』" voices=""/><char @l="469" id="akina" pos="right" src="akina071"/><msg @l="471" char_id="2" frame_id="-1" name="亚季奈"   text="『因为是姐姐，所以只要一个芭菲就告诉你啦。』" voices=""/><char @l="474" id="miho" pos="left" src="miho060"/><msg @l="476" char_id="0" frame_id="1" name="美帆"   text="『好好，谢谢……那么对方是谁呢？』" voices=""/><char @l="479" id="akina" pos="right" src="akina070"/><msg @l="481" char_id="2" frame_id="-1" name="亚季奈" text="『那个……耳朵，靠过来一点。』"   voices=""/><msg @l="483" char_id="0" frame_id="1" name="美帆" text="『什么呀，又没人在听。』"   voices=""/><msg @l="485" char_id="2" frame_id="-1" name="亚季奈" text="『这种事怎么知道啊！』"   voices=""/><char @l="488" id="miho" pos="left" src="miho061"/><msg @l="490" char_id="0" frame_id="1" name="美帆" text="(呵呵……还像个大人似的害羞起来了)"   voices=""/><clear @l="493" class="char"/><msg @l="495" char_id="0" frame_id="1" name="美帆" text="『那么……好，这样可以吗？』"   voices=""/><msg @l="497" char_id="-1" frame_id="-1" name=""   text="我微微一笑，把耳朵凑到亚季奈的嘴边。" voices=""/><char @l="500" id="akina" pos="center" src="akina070f" y="-80"/><msg @l="502" char_id="2" frame_id="-1" name="亚季奈" text="『那个啊。』" voices=""/><msg @l="504" char_id="2" frame_id="-1" name="亚季奈" text="『我喜欢的人是……。』"   voices=""/><msg @l="506" char_id="0" frame_id="1" name="美帆" text="『嗯嗯。』" voices=""/><char @l="509" id="akina" pos="center" src="akina071f" y="-80"/><msg @l="511" char_id="2" frame_id="-1" name="亚季奈" text="『是渡部老师哦。』"   voices=""/><stopbgm @l="514" fadeout="1000"/><clear @l="517" class="char"/><msg @l="519" char_id="0" frame_id="1" name="美帆" text="『诶……？』" voices=""/><msg @l="521" char_id="0" frame_id="1" name="美帆" text="『刚才……你说……什么？』"   voices=""/><msg @l="523" char_id="-1" frame_id="-1" name=""   text="这孩子……亚季奈刚才说她喜欢谁？" voices=""/><char @l="526" id="akina" pos="auto" src="akina077"/><msg @l="528" char_id="2" frame_id="-1" name="亚季奈"   text="『诶——，还要我再说一次吗？姐姐真坏！』" voices=""/><msg @l="530" char_id="0" frame_id="1" name="美帆" text="『不是……那个意思……』"   voices=""/><msg @l="532" char_id="0" frame_id="1" name="美帆" text="『拜托……再说一次。』"   voices=""/><char @l="535" id="akina" pos="auto" src="akina071"/><msg @l="537" char_id="2" frame_id="-1" name="亚季奈"   text="『所以说，是渡部老师啦……游泳部的指导老师。』" voices=""/><bgm @l="540" src="bgm03" volume="1."/><msg @l="542" char_id="-1" frame_id="-1" name="" text="渡部老师！！" voices=""/><msg @l="543" char_id="-1" frame_id="-1" name="" text="亚季奈刚才就是这么说的吗！？"   voices=""/><msg @l="544" char_id="-1" frame_id="-1" name="" text="渡部……那个男人的名字？"   voices=""/><msg @l="545" char_id="-1" frame_id="-1" name="" text="亚季奈会……？" voices=""/><clear @l="548" class="char"/><char @l="550" id="miho" pos="left" src="miho165"/><char @l="552" id="akina" pos="right" src="akina071"/><msg @l="554" char_id="0" frame_id="1" name="美帆" text="『……不行。』" voices=""/><char @l="557" id="akina" pos="right" src="akina074"/><msg @l="559" char_id="2" frame_id="-1" name="亚季奈" text="『啊？』" voices=""/><msg @l="561" char_id="0" frame_id="1" name="美帆" text="『那个人绝对……不行。』"   voices=""/><msg @l="563" char_id="0" frame_id="1" name="美帆"   text="『亚季奈，那个人你绝对不能喜欢上。』" voices=""/><msg @l="565" char_id="2" frame_id="-1" name="亚季奈" text="『姐，姐姐……！？』"   voices=""/><msg @l="567" char_id="0" frame_id="1" name="美帆"   text="『那个人绝对不行！ ……求你了听姐姐的话！』" voices=""/><msg @l="569" char_id="2" frame_id="-1" name="亚季奈" text="『为什么要这么说？』"   voices=""/><char @l="572" id="akina" pos="right" src="akina175"/><msg @l="574" char_id="2" frame_id="-1" name="亚季奈"   text="『我喜欢谁对姐姐来说都……。』" voices=""/><char @l="577" id="miho" pos="left" src="miho064"/><msg @l="579" char_id="0" frame_id="1" name="美帆" text="『亚季奈！！』" voices=""/><char @l="582" id="akina" pos="right" src="akina075"/><msg @l="584" char_id="2" frame_id="-1" name="亚季奈"   text="『……！？ 难道，姐姐……。』" voices=""/><se @l="587" buf="1" src="ホイッスル（室内プール）" volume="1."/><msg @l="589" char_id="-1" frame_id="-1" name="渡部的声音" text="『休息时间结束了，都集合吧。』"   voices=""/><char @l="592" id="miho" pos="left" src="miho065"/><msg @l="594" char_id="0" frame_id="1" name="美帆"   text="『求你了，要明白……绝对不能接近渡部老师。』" voices=""/><clear @l="597" layer="miho"/><msg @l="599" char_id="2" frame_id="-1" name="亚季奈" text="『……。』" voices=""/><clear @l="602" layer="akina"/><msg @l="604" char_id="-1" frame_id="-1" name=""   text="亚季奈没有继续说下去，只是用悲伤的表情看着我。" voices=""/><msg @l="605" char_id="-1" frame_id="-1" name="" text="大概是对我的态度……感到很惊讶吧。"   voices=""/><msg @l="607" char_id="0" frame_id="1" name="美帆"   text="(绝对不能，靠近那个人……)" voices=""/><msg @l="609" char_id="-1" frame_id="-1" name=""   text="我在心里默念着……重新回到训练中。" voices=""/><msg @l="610" char_id="-1" frame_id="-1" name=""   text="渡部老师……不肯与我对视。" voices=""/><msg @l="611" char_id="-1" frame_id="-1" name=""   text="比起被恶作剧要好得多……但此刻那种沉默反而让人害怕。" voices=""/><msg @l="613" char_id="0" frame_id="1" name="美帆"   text="(靠近那种男人的话……亚季奈也会，遭遇不幸的)" voices=""/><msg @l="615" char_id="0" frame_id="1" name="美帆"   text="(拜托了……亚季奈………明白吗)" voices=""/><msg @l="617" char_id="-1" frame_id="-1" name=""   text="亚季奈也……不肯与我对视。" voices=""/><clear @l="620" class="all"/><wait_chgmv/><bg @l="622" src="bg07b"/><char @l="625" id="miho" pos="left" src="miho116"/><char @l="628" id="akina" pos="right" src="akina015"/><msg @l="630" char_id="0" frame_id="1" name="美帆" text="『……。』" voices=""/><msg @l="632" char_id="2" frame_id="-1" name="亚季奈" text="『……。』" voices=""/><msg @l="634" char_id="-1" frame_id="-1" name="" text="训练结束后的归途。" voices=""/><msg @l="635" char_id="-1" frame_id="-1" name=""   text="我和亚季奈无言地走在校园里。" voices=""/><msg @l="636" char_id="-1" frame_id="-1" name="" text="气氛很尴尬……。" voices=""/><msg @l="637" char_id="-1" frame_id="-1" name="" text="……这也是理所当然的吧。"   voices=""/><msg @l="638" char_id="-1" frame_id="-1" name=""   text="我否定了妹妹喜欢的对象……而且没有给出任何理由。" voices=""/><msg @l="640" char_id="2" frame_id="-1" name="亚季奈" text="『那么……我，走这边了。』"   voices=""/><msg @l="642" char_id="0" frame_id="1" name="美帆" text="『啊……嗯。』" voices=""/><clear @l="645" layer="akina"/><msg @l="647" char_id="-1" frame_id="-1" name="" text="宿舍和车站的岔路口。"   voices=""/><msg @l="648" char_id="-1" frame_id="-1" name=""   text="亚季奈低着头说完这句话，一言不发地走了起来。" voices=""/><msg @l="649" char_id="-1" frame_id="-1" name=""   text="与其说是被讨厌了……不如说是被回避的感觉。" voices=""/><msg @l="651" char_id="0" frame_id="1" name="美帆"   text="『这样……只要亚季奈能平安无事的话………。』" voices=""/><clear @l="654" layer="miho"/><msg @l="656" char_id="-1" frame_id="-1" name=""   text="我像是在自言自语般说着……走向通往车站的路。" voices=""/><msg @l="657" char_id="-1" frame_id="-1" name=""   text="却不知道，这将成为一场巨大误会的开始……。" voices=""/><stopbgm @l="660" fadeout="1000"/><clear @l="663" class="all"/><label @l="666" id="event_scene49"/><msg @l="669" char_id="2" frame_id="-1" name="女人的声音"   text="『渡部老师喜欢姐姐吗？』" voices=""/><msg @l="671" char_id="-1" frame_id="-1" name="男人的声音"   text="『你姐姐对我说想和我交往。』" voices=""/><msg @l="673" char_id="2" frame_id="-1" name="女人的声音"   text="『我、我也喜欢渡部老师。比姐姐还要……』" voices=""/><msg @l="675" char_id="-1" frame_id="-1" name="男人的声音"   text="『那就得用行动证明给我看啊。』" voices=""/><msg @l="677" char_id="2" frame_id="-1" name="女人的声音" text="『行动……？』" voices=""/><msg @l="679" char_id="-1" frame_id="-1" name="男人的声音"   text="『如果你愿意让我夺走你的第一次，我就相信你。』" voices=""/><msg @l="681" char_id="2" frame_id="-1" name="女人的声音" text="『啊……那、那个……』"   voices=""/><msg @l="683" char_id="-1" frame_id="-1" name="男人的声音"   text="『做不到就回去吧。我可没空陪小屁孩胡闹。』" voices=""/><msg @l="685" char_id="2" frame_id="-1" name="女人的声音" text="『我……我知道了。』"   voices=""/><msg @l="687" char_id="-1" frame_id="-1" name="男人的声音" text="『呵呵……这样可以吧？』"   voices=""/><msg @l="689" char_id="2" frame_id="-1" name="女人的声音" text="『没关系的……。』"   voices=""/><msg @l="691" char_id="-1" frame_id="-1" name="" text="夜晚……周围的人都安静入睡的时候。"   voices=""/><msg @l="692" char_id="-1" frame_id="-1" name=""   text="在合宿所的一个空房间里，两个人正在交谈。" voices=""/><msg @l="693" char_id="-1" frame_id="-1" name=""   text="是女方主动邀约的……而男方，则始终挂着一副淫邪的笑容。" voices=""/><msg @l="695" char_id="2" frame_id="-1" name="女人的声音" text="『我……才不会输给姐姐呢。』"   voices=""/><msg @l="697" char_id="-1" frame_id="-1" name="男人的声音" text="『那就，过来吧。』"   voices=""/><msg @l="699" char_id="2" frame_id="-1" name="女人的声音" text="『好、好的……。』"   voices=""/><wait_chgmv/><bg @l="702" src="bg19b"/><bgm @l="705" src="bgm10" volume="1."/><char @l="708" id="watab" pos="auto" src="watabe010"/><msg @l="710" char_id="-1" frame_id="-1" name="渡部" text="『这身打扮不错啊。』"   voices=""/><clear @l="713" class="char"/><char @l="716" id="watab" pos="left" src="watabe010"/><char @l="719" id="akina" pos="right" src="akina065"/><msg @l="721" char_id="2" frame_id="-1" name="亚季奈"   text="『老、老师……为什么要这样的打扮……。』" voices=""/><char @l="724" id="watab" pos="left" src="watabe014"/><msg @l="726" char_id="-1" frame_id="-1" name="渡部" text="『因为我喜欢。』"   voices=""/><msg @l="728" char_id="-1" frame_id="-1" name=""   text="在深夜的合宿所里，亚季奈不是在部活时间，却被要求穿上了泳衣。" voices=""/><msg @l="729" char_id="-1" frame_id="-1" name=""   text="那还未完全干透的竞泳泳衣紧贴在亚季奈的肌肤上。" voices=""/><msg @l="730" char_id="-1" frame_id="-1" name=""   text="因为微微残留的氯气气味，以及湿润冰冷的尼龙触感，她不由得皱起了眉头。" voices=""/><msg @l="731" char_id="-1" frame_id="-1" name=""   text="但是，既然是渡部的要求，她也不能明显表现出厌恶，只能扭扭捏捏地观察着渡部的表情。" voices=""/><char @l="734" id="watab" pos="left" src="watabe012"/><msg @l="736" char_id="-1" frame_id="-1" name="渡部"   text="『很适合你啊仲根，这样看着就让我想起你姐姐了。』" voices=""/><msg @l="738" char_id="2" frame_id="-1" name="亚季奈"   text="『请不要提姐姐的事。』" voices=""/><char @l="741" id="watab" pos="left" src="watabe010"/><msg @l="743" char_id="-1" frame_id="-1" name="渡部" text="『那可不一定。这取决于你自己了。』"   voices=""/><char @l="746" id="akina" pos="right" src="akina064"/><msg @l="748" char_id="-1" frame_id="-1" name=""   text="说着，渡部突然夺取了亚季奈的嘴唇，纠缠起她的舌头。" voices=""/><msg @l="749" char_id="-1" frame_id="-1" name=""   text="面对这突如其来的状况，她一瞬间有些混乱，但当意识到这是与渡部的初吻时，她仿佛陶醉般全身力气都松懈了。" voices=""/><char @l="752" id="watab" pos="left" src="watabe017"/><msg @l="754" char_id="-1" frame_id="-1" name="渡部"   text="『不对！太敷衍了！』" voices=""/><char @l="757" id="akina" pos="right" src="akina065"/><msg @l="759" char_id="2" frame_id="-1" name="亚季奈" text="『嗯……嗯嗯嗯！！』"   voices=""/><msg @l="761" char_id="-1" frame_id="-1" name=""   text="渡部对亚季奈的吻感到不满，毫不掩饰自己的焦躁，强行蹂躏着亚季奈的口腔。" voices=""/><msg @l="763" char_id="-1" frame_id="-1" name="渡部"   text="『喂，再多伸出舌头啊！』" voices=""/><char @l="766" id="akina" pos="right" src="akina165"/><msg @l="768" char_id="2" frame_id="-1" name="亚季奈" text="『这……这样吗……。』"   voices=""/><msg @l="770" char_id="2" frame_id="-1" name="亚季奈" text="『嗯嗯嗯！嗯，嗯呼——。』"   voices=""/><msg @l="772" char_id="-1" frame_id="-1" name=""   text="亚季奈像寻求食物的雏鸟一样，将她那可爱的粉色舌头伸到极限。" voices=""/><msg @l="773" char_id="-1" frame_id="-1" name=""   text="渡部对此感到满意，不再回答，而是将自己的舌头缠绕上去，熟练地摩擦着。" voices=""/><msg @l="774" char_id="-1" frame_id="-1" name=""   text="不久，亚季奈也学着样子，开始与渡部的舌头交缠起来。" voices=""/><char @l="777" id="watab" pos="left" src="watabe010"/><msg @l="779" char_id="-1" frame_id="-1" name="渡部"   text="『好，真乖。接下来喝下我的唾液！』" voices=""/><msg @l="781" char_id="2" frame_id="-1" name="亚季奈"   text="『啊呼，嗯嗯……嗯，嗯，嗯。』" voices=""/><char @l="784" id="akina" pos="right" src="akina164"/><msg @l="786" char_id="-1" frame_id="-1" name=""   text="也许是因为被表扬而高兴，亚季奈咕咚咕咚地喝下了积存在渡部口中的唾液。" voices=""/><msg @l="787" char_id="-1" frame_id="-1" name=""   text="每当那粘稠的液体通过喉咙，亚季奈都能感受到体内涌起一股热流，肩膀因此而颤抖着。" voices=""/><msg @l="789" char_id="-1" frame_id="-1" name="渡部" text="『好，差不多该开始了吧。』"   voices=""/><msg @l="791" char_id="-1" frame_id="-1" name=""   text="说着，渡部开始脱下裤子，从胯下中央显现出一根直冲云霄的肉棒。" voices=""/><char @l="794" id="akina" pos="right" src="akina064"/><msg @l="796" char_id="2" frame_id="-1" name="亚季奈" text="『啊！？』" voices=""/><msg @l="798" char_id="-1" frame_id="-1" name="" text="面对这根狰狞的巨棒，她不禁屏住了呼吸。"   voices=""/><char @l="801" id="watab" pos="left" src="watabe012"/><msg @l="804" char_id="-1" frame_id="-1" name="渡部"   text="『没必要惊讶吧。这可是能让你成为女人的珍贵之物。』" voices=""/><char @l="807" id="akina" pos="right" src="akina065"/><msg @l="809" char_id="2" frame_id="-1" name="亚季奈" text="『老，老师，可是还……。』"   voices=""/><msg @l="811" char_id="-1" frame_id="-1" name=""   text="在舌头交缠的期间，渡部一直用双手抚摸着她的胸部和下体，但与正式的爱抚相比还远远不够。" voices=""/><msg @l="812" char_id="-1" frame_id="-1" name=""   text="尽管如此，也许是因为喝下唾液而兴奋，亚季奈的花唇已经渗出了粘稠的蜜液，顺着大腿内侧流下。" voices=""/><char @l="815" id="watab" pos="left" src="watabe010"/><msg @l="817" char_id="-1" frame_id="-1" name="渡部" text="『不足的部分，我用这个来补充。』"   voices=""/><msg @l="819" char_id="-1" frame_id="-1" name=""   text="说着，渡部在他粗糙的手掌上涂满了唾液，然后将其涂抹在亚季奈的双腿之间。" voices=""/><char @l="822" id="akina" pos="right" src="akina164"/><msg @l="824" char_id="2" frame_id="-1" name="亚季奈" text="『呀！』" voices=""/><char @l="827" id="akina" pos="right" src="akina065"/><msg @l="829" char_id="2" frame_id="-1" name="亚季奈"   text="『老师，请温柔些……请对我温柔些……』" voices=""/><char @l="832" id="watab" pos="left" src="watabe017"/><msg @l="834" char_id="-1" frame_id="-1" name="渡部" text="『不可能。』" voices=""/><msg @l="836" char_id="-1" frame_id="-1" name=""   text="面对亚季奈如梦呓般重复的请求，渡部冷酷地回绝道。" voices=""/><msg @l="837" char_id="-1" frame_id="-1" name="" text="一滴眼泪顺着亚季奈的脸颊流下。"   voices=""/><label @l="840" id="chart_line21"/><wait_chgmv/><ev @l="843" src="ev-049"/><description @l="846" text="绽放的花蕾"/><bgm @l="849" src="bgm14" volume="1."/><msg @l="851" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯……啊啊……呃……好痛！！』" voices="akina00560"/><msg @l="853" char_id="-1" frame_id="-1" name=""   text="铁一般坚硬挺立的阳具，正一点一点地撑开少女狭窄的秘处。" voices=""/><msg @l="854" char_id="-1" frame_id="-1" name=""   text="这大概是她第一次，那里既没有得到充分的放松……也缺乏足够的润滑液来容纳男人的东西，已经肿得通红。"   voices=""/><msg @l="855" char_id="-1" frame_id="-1" name=""   text="从被强行撑开的阴道口和肉棒之间，处女的证明——鲜血正逐渐流淌下来。" voices=""/><msg @l="857" char_id="2" frame_id="-1" name="亚季奈"   text="『呃……唔，呜呜……痛……好痛啊！！』" voices="akina00570"/><msg @l="859" char_id="-1" frame_id="-1" name="渡部" text="『好了，全部进去了。』"   voices=""/><msg @l="861" char_id="-1" frame_id="-1" name=""   text="男人一边用力将女孩纤细的身体拉近，一边满意地说道。" voices=""/><msg @l="862" char_id="-1" frame_id="-1" name="" text="丝毫没有……体贴的样子。"   voices=""/><msg @l="863" char_id="-1" frame_id="-1" name=""   text="只是随心所欲地抱住那仍残留着稚嫩的肉体，从下方挺动着肉体的活塞。" voices=""/><msg @l="864" char_id="-1" frame_id="-1" name=""   text="他的脑海中，正盘旋着一个利用眼前这个喘息微弱的少女的黑暗计谋。" voices=""/><msg @l="866" char_id="2" frame_id="-1" name="亚季奈"   text="『哈……哈，哈……痛……呜，啊！！』" voices="akina00580"/><msg @l="868" char_id="2" frame_id="-1" name="亚季奈"   text="『没关系……的……请……继续……。』" voices="akina00590"/><msg @l="870" char_id="-1" frame_id="-1" name="渡部"   text="『不用你说我也打算这么做。我会彻底蹂躏你的。』" voices=""/><msg @l="872" char_id="2" frame_id="-1" name="亚季奈"   text="『唔唔……痛……好痛……。』" voices="akina00600"/><msg @l="874" char_id="-1" frame_id="-1" name=""   text="伴随着咯吱咯吱的声音，女孩的花芯被强行撑开。" voices=""/><msg @l="875" char_id="-1" frame_id="-1" name=""   text="女孩的身体对男人来说太小了……一看就知道这是勉强的。" voices=""/><msg @l="877" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯，唔唔……痛……呃，啊呜……好痛……。』" voices="akina00610"/><msg @l="879" char_id="2" frame_id="-1" name="亚季奈"   text="『哈……哈……唔唔……呃啊……痛……好痛啊……！！』" voices="akina00620"/><msg @l="881" char_id="-1" frame_id="-1" name=""   text="当渡部开始用肉棒顶撞她的最深处时，亚季奈痛苦地喘着气。" voices=""/><msg @l="882" char_id="-1" frame_id="-1" name=""   text="每当他粗暴地刮擦着子宫口，那既像呼吸声又像呻吟的喘息，就会有节奏地从她喉咙深处泄露出来。" voices=""/><msg @l="883" char_id="-1" frame_id="-1" name=""   text="渐渐地，亚季奈的喘息……只剩下痛苦的、反复的呼吸声。" voices=""/><msg @l="885" char_id="-1" frame_id="-1" name="渡部"   text="『不错，你那小穴夹得我的肉棒都疼了。』" voices=""/><msg @l="887" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯嗯……嗯，嗯，嗯………呃啊………。』" voices="akina00630"/><msg @l="889" char_id="2" frame_id="-1" name="亚季奈"   text="『老师……呜，啊啊…………难受……好痛……嗯哈！！』" voices="akina00640"/><msg @l="891" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯嗯嗯……，住手………嗯，呜啊……好痛！！』" voices="akina00650"/><msg @l="893" char_id="-1" frame_id="-1" name="渡部"   text="『喂喂，我才刚插进去……现在喊痛未免也太早了吧。』" voices=""/><msg @l="895" char_id="2" frame_id="-1" name="亚季奈"   text="『可，可是………老师的………太大了…………。』" voices="akina00660"/><msg @l="897" char_id="-1" frame_id="-1" name="渡部"   text="『你这话说得真让人高兴啊。也许是我的太大了，但更多的是仲根的小穴太小了。』" voices=""/><msg @l="899" char_id="-1" frame_id="-1" name="渡部"   text="『想要舒服的话，就把小穴撑大来适应我的东西，明白吗？』" voices=""/><msg @l="901" char_id="2" frame_id="-1" name="亚季奈"   text="『怎么，会……嗯……啊啊！！』" voices="akina00670"/><msg @l="903" char_id="-1" frame_id="-1" name=""   text="肉棒再次压迫着亚季奈已经受伤流血的花径。" voices=""/><msg @l="904" char_id="-1" frame_id="-1" name=""   text="每当处女被破处的部位被摩擦时，亚季奈都会抖动着腰肢，眼中含泪，发出痛苦的喘息。" voices=""/><msg @l="905" char_id="-1" frame_id="-1" name=""   text="为什么自己会这样做，想要做什么……已经因为疼痛而无法思考了。" voices=""/><msg @l="907" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯啊……嗯……啊，嗯咕……。』" voices="akina00680"/><msg @l="909" char_id="-1" frame_id="-1" name="渡部" text="『放松点……不然会裂开的。』"   voices=""/><msg @l="911" char_id="-1" frame_id="-1" name="渡部"   text="『看，我来玩弄你的阴蒂……这里会舒服的吧？』" voices=""/><msg @l="913" char_id="2" frame_id="-1" name="亚季奈"   text="『呼……嗯，嗯嗯……哈……哈呼……。』" voices="akina00690"/><msg @l="915" char_id="2" frame_id="-1" name="亚季奈"   text="『不啊……那里……不行，痛……好痛……嗯咕！！』" voices="akina00700"/><msg @l="917" char_id="-1" frame_id="-1" name=""   text="每当渡部的手指拨弄秘部的小突起时，亚季奈的阴道肉壁就会紧缩，挤压着深深插入的肉楔。" voices=""/><msg @l="918" char_id="-1" frame_id="-1" name=""   text="这样当阴道壁的褶皱紧缩着硬棒时……本就狭窄的阴道内部就会变成想要将异物推出去的动作。" voices=""/><msg @l="920" char_id="-1" frame_id="-1" name="渡部"   text="『什么不行，再说一次放松点……不然我没法插到最深处！』" voices=""/><msg @l="922" char_id="2" frame_id="-1" name="亚季奈"   text="『痛，痛……嗯，呃……啊咕……好痛啊！』" voices="akina00710"/><msg @l="924" char_id="2" frame_id="-1" name="亚季奈"   text="『呃……啊，啊啊……呜……啊，唔！！』" voices="akina00720"/><msg @l="926" char_id="-1" frame_id="-1" name="渡部"   text="『来，我也要好好揉捏你这小小的胸部……嗯，很好，再放松点！』" voices=""/><msg @l="928" char_id="-1" frame_id="-1" name=""   text="这样，渡部的手抓住亚季奈的肩膀，用力压下全身的重量，强行将肉棒插到最深处。" voices=""/><msg @l="930" char_id="2" frame_id="-1" name="亚季奈" text="『呃啊————！？』"   voices="akina00730"/><msg @l="932" char_id="2" frame_id="-1" name="亚季奈"   text="『啊……啊，啊啊啊啊啊啊啊！！！』" voices="akina00740"/><msg @l="934" char_id="-1" frame_id="-1" name=""   text="渡部愉快地说着，将无法完全容纳在亚季奈秘部的肉棒更加用力地挤入，强行顶撞着子宫口，同时逐渐加快节奏搅动着她的私处。"   voices=""/><msg @l="936" char_id="2" frame_id="-1" name="亚季奈"   text="『啊……唔，呜……好痛……好痛啊！！』" voices="akina00570"/><msg @l="938" char_id="-1" frame_id="-1" name=""   text="亚季奈那娇小的樱色花唇，被可怖的肉棒撑开到几乎要裂开的程度，惨不忍睹地扩张着。" voices=""/><msg @l="940" char_id="2" frame_id="-1" name="亚季奈"   text="『哈……哈……呜……啊……痛……好痛啊……！！』" voices="akina00620"/><msg @l="942" char_id="-1" frame_id="-1" name=""   text="渡部看着亚季奈的反应，浮现出残忍的笑容，愉快地继续挺动腰部。" voices=""/><msg @l="944" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯嗯……痛……好痛……。』" voices="akina00600"/><msg @l="946" char_id="-1" frame_id="-1" name=""   text="合宿室内响起了亚季奈秘部因处女膜破裂而流出的血液发出的咕啾咕啾的声音。" voices=""/><msg @l="948" char_id="-1" frame_id="-1" name="渡部"   text="『嘿嘿……看着你痛苦的表情，我也变得更加兴奋了。』" voices=""/><msg @l="950" char_id="-1" frame_id="-1" name="渡部"   text="『我要把我的精液全部射进你那小小的下面！』" voices=""/><msg @l="951" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯嗯嗯……住手……嗯，呜啊……好痛！！』" voices="akina00650"/><msg @l="953" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯嗯……嗯，嗯，嗯……呃啊……。』" voices="akina00630"/><msg @l="955" char_id="2" frame_id="-1" name="亚季奈"   text="『呜啊……啊，啊啊啊啊啊啊啊！！！』" voices="akina00740"/><flash @l="959" count="4" fade="100" image="white"/><wait_chgmv/><ev @l="962" src="ev-049x1z1"/><flash @l="966" count="4" fade="100" image="white"/><msg @l="967" char_id="-1" frame_id="-1" name=""   text="房间内回荡着近乎惨叫的尖叫声，亚季奈身体僵硬地颤抖着。" voices=""/><msg @l="968" char_id="-1" frame_id="-1" name=""   text="下一瞬间，肉棒在亚季奈的子宫口……最深处爆发，喷涌而出的精液大量灌注进去。" voices=""/><msg @l="970" char_id="-1" frame_id="-1" name="渡部"   text="『嘿嘿……虽然是小小的下面，但感觉真不错啊，亚季奈。』" voices=""/><msg @l="972" char_id="2" frame_id="-1" name="亚季奈"   text="『呜啊……啊……啊啊………。』" voices="akina00750"/><msg @l="974" char_id="-1" frame_id="-1" name=""   text="面对渡部的低语，亚季奈无法做出回应。" voices=""/><msg @l="975" char_id="-1" frame_id="-1" name=""   text="亚季奈的意识如同射入阴道内的炽热精子一样变得混浊，连对方在耳边低语什么都无法理解。" voices=""/><msg @l="976" char_id="-1" frame_id="-1" name=""   text="就这样，在渡部身上颤抖了一会儿的亚季奈，最终如同断了线的木偶一般缓缓倒下……。" voices=""/><stopbgm @l="979" fadeout="1000"/><clear @l="982" class="all"/><wait_chgmv/><bg @l="985" src="bg19b"/><bgm @l="988" src="bgm10" volume="1."/><msg @l="990" char_id="2" frame_id="-1" name="亚季奈" text="『……呼……呼……。』"   voices=""/><msg @l="992" char_id="-1" frame_id="-1" name="渡部" text="『呼……晕过去了吗。』"   voices=""/><msg @l="994" char_id="-1" frame_id="-1" name=""   text="渡部将失去意识倒下的亚季奈推到地板上，然后站了起来。" voices=""/><msg @l="995" char_id="-1" frame_id="-1" name=""   text="他的眼中浮现出某种俯视轻蔑之物的神色。" voices=""/><msg @l="997" char_id="-1" frame_id="-1" name="渡部"   text="『没想到这家伙会主动靠近我啊……。』" voices=""/><msg @l="999" char_id="-1" frame_id="-1" name="渡部"   text="『不过这样一来，倒是省了不少麻烦……。』" voices=""/><msg @l="1001" char_id="-1" frame_id="-1" name=""   text="渡部朝着隔开房间与外界的障子门，露出邪恶的笑容。" voices=""/><msg @l="1003" char_id="-1" frame_id="-1" name="人影" text="『……。』" voices=""/><msg @l="1005" char_id="-1" frame_id="-1" name=""   text="朝着浮现在障子门上的……人影……。" voices=""/><stopbgm @l="1008" fadeout="1000"/><clear @l="1011" class="all"/><end_scene @l="1014"/><call @l="1017" target="EventLabel_80@root_akina05"/><return @l="1018" value="0&#13;&#10;"/><return @l="1021" value=""/></code></xscript>																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																