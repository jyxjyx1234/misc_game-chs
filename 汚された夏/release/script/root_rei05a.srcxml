<?xml version="1.0" encoding="utf-8"?><xscript><debug editor="&quot;C:\Program&#32;Files&#32;(x86)\sakura\sakura.exe&quot;&#32;&quot;%src%&quot;&#32;-Y=%line%"   src="D:\シロップ\町ぐるみの罠＋汚された夏セット版\汚された夏\完成データ\汚された夏\script\text\root_rei05a.txt"/><code><label @l="13" id="EventLabel_142"/><description @l="17" text="室友的忧郁·第5天(A)"/><eval @l="19" expr="f.numDay=11&#13;&#10;"/><msgshow @l="21" show="false"/><wait_chgmv/><bg @l="23" src="day11" time="2000"/><wait @l="25" time="500"/><wait_chgmv/><bg @l="27" src="black" time="2000"/><msgshow @l="29" show="true"/><wait_chgmv/><bg @l="33" src="bg03"/><bgm @l="37" src="bgm03" volume="1."/><msg @l="39" char_id="0" frame_id="-1" name="美帆" text="『嗯……。』" voices=""/><msg @l="41" char_id="-1" frame_id="-1" name=""   text="透过眼皮感受到的刺眼阳光和热度带来了些许不适，我因此醒了过来。" voices=""/><msg @l="42" char_id="-1" frame_id="-1" name=""   text="皱着眉头慢慢睁开眼睛……熟悉的家具和房间布局映入眼帘，我像往常一样坐起了身。"   voices=""/><char @l="46" id="miho" pos="auto" src="miho136"/><msg @l="48" char_id="0" frame_id="-1" name="美帆" text="『咦……我？』" voices=""/><msg @l="50" char_id="-1" frame_id="-1" name=""   text="看来我是在客厅的沙发上……睡着了。" voices=""/><char @l="54" id="miho" pos="auto" src="miho035"/><msg @l="56" char_id="0" frame_id="-1" name="美帆" text="『………。』" voices=""/><msg @l="58" char_id="0" frame_id="-1" name="美帆"   text="『原来如此……是在等玲小姐回来，然后就…………。』" voices=""/><msg @l="60" char_id="-1" frame_id="-1" name=""   text="昨天……朽木教授离开后，我觉得无论如何都必须做些什么，于是决定等玲小姐回来。" voices=""/><msg @l="61" char_id="-1" frame_id="-1" name=""   text="不过，也许那只是因为我想向别人求助而已。" voices=""/><msg @l="62" char_id="-1" frame_id="-1" name=""   text="也许我只是想要被别人安慰而已。" voices=""/><msg @l="63" char_id="-1" frame_id="-1" name=""   text="没关系的，你并不肮脏……我只是想听到有人这样对我说——。" voices=""/><msg @l="64" char_id="-1" frame_id="-1" name=""   text="我一边揉着仍有些朦胧的眼睛，一边追溯着中断的记忆。" voices=""/><msg @l="66" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="68" char_id="-1" frame_id="-1" name=""   text="餐桌上摆着仍然用保鲜膜包着的晚餐。" voices=""/><msg @l="69" char_id="-1" frame_id="-1" name="" text="玲小姐……果然没有回来。"   voices=""/><msg @l="71" char_id="0" frame_id="-1" name="美帆" text="『玲小姐，为什么……。』"   voices=""/><char @l="75" id="miho" pos="auto" src="miho135"/><msg @l="77" char_id="0" frame_id="-1" name="美帆" text="『为什么不回来呢……。』"   voices=""/><msg @l="79" char_id="-1" frame_id="-1" name=""   text="我用颤抖的声音只说了这些……然后小声啜泣起来。" voices=""/><msg @l="80" char_id="-1" frame_id="-1" name="" text="现在我只是无论如何都想见到玲小姐……。"   voices=""/><msg @l="82" char_id="0" frame_id="-1" name="美帆" text="『……呜……。』" voices=""/><msg @l="84" char_id="-1" frame_id="-1" name=""   text="滴落的眼泪落在膝上紧握的手背上。" voices=""/><msg @l="85" char_id="-1" frame_id="-1" name="" text="被夺走的处女。" voices=""/><msg @l="86" char_id="-1" frame_id="-1" name="" text="受伤的身体。" voices=""/><msg @l="87" char_id="-1" frame_id="-1" name="" text="被污染的……心灵。" voices=""/><msg @l="88" char_id="-1" frame_id="-1" name=""   text="直到昨天还理所当然拥有的东西，就这样被一个男人毁掉、夺走了。" voices=""/><msg @l="89" char_id="-1" frame_id="-1" name="" text="这比什么都令人悔恨……。"   voices=""/><msg @l="91" char_id="0" frame_id="-1" name="美帆" text="『………。』" voices=""/><msg @l="93" char_id="0" frame_id="-1" name="美帆"   text="(不行……光哭着也解决不了什么)" voices=""/><msg @l="95" char_id="0" frame_id="-1" name="美帆" text="(必须思考……)" voices=""/><msg @l="97" char_id="0" frame_id="-1" name="美帆"   text="(好好想想自己能做什么，然后采取行动)" voices=""/><clear @l="103" class="all"/><se @l="107" buf="3" loop="true" src="水音2" volume="1."/><msg @l="109" char_id="-1" frame_id="-1" name="" text="之后我冲了个澡。"   voices=""/><msg @l="110" char_id="-1" frame_id="-1" name=""   text="眼泪、悲伤、流出的血、精液……全部冲洗干净就好。" voices=""/><msg @l="111" char_id="-1" frame_id="-1" name="" text="等到动弹不得时就太迟了。"   voices=""/><msg @l="112" char_id="-1" frame_id="-1" name=""   text="一旦迷失前进的方向，就会蜷缩在原地无法动弹……这是我的坏习惯。" voices=""/><msg @l="113" char_id="-1" frame_id="-1" name=""   text="来到这个城镇时，我想着至少要改掉这个习惯。" voices=""/><msg @l="114" char_id="-1" frame_id="-1" name="" text="我想改变缺乏积极性的自己。"   voices=""/><msg @l="115" char_id="-1" frame_id="-1" name=""   text="如果在这里停下脚步，我感觉自己可能再也无法前进了。" voices=""/><msg @l="116" char_id="-1" frame_id="-1" name="" text="所以……我不能停下。"   voices=""/><msg @l="117" char_id="-1" frame_id="-1" name="" text="为了玲小姐，也为了自己——。"   voices=""/><stopse @l="121" buf="3"/><wait_chgmv/><bg @l="125" src="bg03"/><char @l="129" id="miho" pos="auto" src="miho126"/><msg @l="131" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="133" char_id="0" frame_id="-1" name="美帆"   text="(走吧……从寻找自己能做的事情开始)" voices=""/><clear @l="139" class="all"/><msgshow @l="141" show="true"/><wait_chgmv/><bg @l="145" src="bg16"/><char @l="149" id="miho" pos="auto" src="miho126"/><msg @l="151" char_id="0" frame_id="-1" name="美帆"   text="(……虽然我什么都没想就来到这里了)" voices=""/><msg @l="153" char_id="0" frame_id="-1" name="美帆"   text="(这么突然……不知道能不能见到玲小姐)" voices=""/><msg @l="155" char_id="-1" frame_id="-1" name=""   text="我仰望着眼前的建筑……在刺眼的阳光下眯起了眼睛。" voices=""/><msg @l="156" char_id="-1" frame_id="-1" name="" text="不知不觉间，我已经走到了大黑建设公司的门前。"   voices=""/><msg @l="157" char_id="-1" frame_id="-1" name="" text="我只是想见玲小姐，和她谈谈。"   voices=""/><clear @l="163" class="all"/><se @l="167" buf="1" src="自動ドアの音" volume="1."/><msg @l="169" char_id="-1" frame_id="-1" name=""   text="穿过自动门，我径直走向前台。" voices=""/><wait_chgmv/><bg @l="173" src="bg17m1"/><char @l="176" id="miho" pos="center" src="miho025f" y="-80"/><msg @l="178" char_id="0" frame_id="-1" name="美帆"   text="『那个，请问这里有一位叫白石的人，能帮我叫她出来吗？』" voices=""/><msg @l="180" char_id="-1" frame_id="-1" name="前台小姐"   text="『白石是吗……请稍等一下。』" voices=""/><msg @l="182" char_id="-1" frame_id="-1" name=""   text="说着这样事务性的语气，前台小姐敲打着手边的键盘。" voices=""/><msg @l="184" char_id="-1" frame_id="-1" name="前台小姐"   text="『非常抱歉，我们公司没有叫白石的员工。』" voices=""/><char @l="186" id="miho" pos="center" src="miho024f" y="-80"/><msg @l="188" char_id="0" frame_id="-1" name="美帆"   text="『啊，那个……不是员工，我想应该有一位这几天来面试的人。』" voices=""/><msg @l="190" char_id="-1" frame_id="-1" name="前台小姐" text="『……我明白了。』"   voices=""/><msg @l="192" char_id="-1" frame_id="-1" name="前台小姐"   text="『我这就叫负责的人过来，请稍等片刻。』" voices=""/><char @l="195" id="miho" pos="center" src="miho025f" y="-80"/><msg @l="197" char_id="0" frame_id="-1" name="美帆" text="『好的……麻烦您了。』"   voices=""/><msg @l="199" char_id="0" frame_id="-1" name="美帆"   text="(表情瞬间变了……果然，这里有问题)" voices=""/><msg @l="201" char_id="-1" frame_id="-1" name="前台小姐" text="『是的……是，我知道了。』"   voices=""/><msg @l="203" char_id="-1" frame_id="-1" name="前台小姐" text="『那么，我会这样处理的。』"   voices=""/><msg @l="205" char_id="-1" frame_id="-1" name="" text="应该是内线电话吧。" voices=""/><msg @l="206" char_id="-1" frame_id="-1" name=""   text="看着她对着电话以同样事务性的口吻应答，我正在恍惚地思考着“朽木教授说过的事”。"   voices=""/><msg @l="207" char_id="-1" frame_id="-1" name="" text="关于“男性员工的性欲处理对象”的事。"   voices=""/><msg @l="208" char_id="-1" frame_id="-1" name=""   text="以及……玲小姐是否作为那个“男性员工的性欲处理对象”，被软禁在这个大黑建设公司。" voices=""/><msg @l="210" char_id="-1" frame_id="-1" name="前台小姐"   text="『负责的人员说会见您，我这就带您过去。』" voices=""/><msg @l="212" char_id="0" frame_id="-1" name="美帆" text="『啊……好的。』" voices=""/><clear @l="218" class="all"/><msgshow @l="220" show="true"/><wait_chgmv/><bg @l="224" src="bg17m1"/><msg @l="226" char_id="-1" frame_id="-1" name="前台小姐"   text="『负责的人员很快就会到，请在这里稍等。』" voices=""/><char @l="230" id="miho" pos="auto" src="miho126"/><msg @l="232" char_id="0" frame_id="-1" name="美帆" text="『我知道了……』"   voices=""/><msg @l="234" char_id="-1" frame_id="-1" name=""   text="她带我来到几天前曾经访问过的那个办公室入口，然后独自沿着刚才走过的走廊返回。" voices=""/><msg @l="235" char_id="-1" frame_id="-1" name=""   text="她是否知道这家公司在暗地里做着什么呢？" voices=""/><msg @l="236" char_id="-1" frame_id="-1" name=""   text="如果她知道的话……作为同为女性，难道不会像我现在这样感到厌恶吗？" voices=""/><msg @l="237" char_id="-1" frame_id="-1" name=""   text="很难想象玲小姐会自愿从事那种工作……" voices=""/><msg @l="238" char_id="-1" frame_id="-1" name="" text="如果是这样的话，可以考虑两种可能性……"   voices=""/><msg @l="239" char_id="-1" frame_id="-1" name=""   text="要么是被威胁了……要么是被欺骗了。" voices=""/><msg @l="241" char_id="0" frame_id="-1" name="美帆"   text="(如果能让他们明白自己在做坏事，或许至少能让他们释放玲小姐)" voices=""/><msg @l="243" char_id="-1" frame_id="-1" name="声音" text="『让您久等了。』"   voices=""/><char @l="246" id="miho" pos="auto" src="miho024"/><msg @l="248" char_id="0" frame_id="-1" name="美帆" text="『啊……』" voices=""/><char @l="252" id="ookur" pos="auto" src="ookuro010"/><bgm @l="256" src="bgm09" volume="1."/><msg @l="258" char_id="-1" frame_id="-1" name=""   text="随着话语走近的那位体格健硕的男性，我有印象。" voices=""/><msg @l="259" char_id="-1" frame_id="-1" name=""   text="是之前我来送文件时遇到的……那个男人。" voices=""/><msg @l="261" char_id="-1" frame_id="-1" name="穿西装的男子"   text="『欢迎您的到来。』" voices=""/><msg @l="263" char_id="-1" frame_id="-1" name="穿西装的男子"   text="『您的来意我已经从前台那里听说了。请跟我来。』" voices=""/><clear @l="267" class="char"/><char @l="271" id="miho" pos="auto" src="miho024"/><msg @l="273" char_id="0" frame_id="-1" name="美帆" text="『啊……那、那个！』"   voices=""/><clear @l="276" class="char"/><char @l="278" id="miho" pos="left" src="miho024"/><char @l="281" id="ookur" pos="right" src="ookuro010"/><msg @l="283" char_id="-1" frame_id="-1" name="穿西装的男子" text="『什么事？』" voices=""/><char @l="287" id="miho" pos="left" src="miho025"/><msg @l="289" char_id="0" frame_id="-1" name="美帆"   text="『玲小姐……白石小姐在这里吗？』" voices=""/><msg @l="291" char_id="-1" frame_id="-1" name="穿西装的男子"   text="『这个问题，跟我来就知道了。』" voices=""/><msg @l="293" char_id="0" frame_id="-1" name="美帆" text="『……她在这里对吧。』"   voices=""/><msg @l="295" char_id="-1" frame_id="-1" name="穿西装的男子"   text="『不用着急，很快就会知道……这样回答您不满意吗？』" voices=""/><char @l="297" id="miho" pos="left" src="miho125"/><msg @l="299" char_id="0" frame_id="-1" name="美帆" text="『………。』" voices=""/><msg @l="301" char_id="-1" frame_id="-1" name="穿西装的男子"   text="『原来如此，看来您不太满意呢。』" voices=""/><msg @l="303" char_id="-1" frame_id="-1" name="穿西装的男子"   text="『那我就直说了……她的确在这里，仲根美帆小姐。』" voices=""/><char @l="307" id="miho" pos="left" src="miho024"/><msg @l="309" char_id="0" frame_id="-1" name="美帆" text="『……！？』" voices=""/><msg @l="311" char_id="0" frame_id="-1" name="美帆" text="『为、为什么你知道我的名字……？』"   voices=""/><msg @l="313" char_id="-1" frame_id="-1" name="穿西装的男子"   text="『嗯……这是为什么呢。』" voices=""/><clear @l="316" layer="ookur"/><char @l="318" id="ookur" pos="auto" src="ookuro010"/><msg @l="320" char_id="-1" frame_id="-1" name="穿西装的男子"   text="『比起这个，现在去见她不是更重要吗？』" voices=""/><char @l="324" id="miho" pos="left" src="miho125"/><msg @l="326" char_id="0" frame_id="-1" name="美帆" text="『………。』" voices=""/><msg @l="328" char_id="-1" frame_id="-1" name=""   text="那个体格魁梧的男人一本正经地说完，便把手搭在了美帆的腰上。" voices=""/><msg @l="329" char_id="-1" frame_id="-1" name=""   text="他抚摸她腰部的手让美帆感到恶心，她身体猛地一颤，试图挣脱。" voices=""/><msg @l="330" char_id="-1" frame_id="-1" name="穿西装的男子"   text="『啊，如果不想见她的话，你当然可以离开。』" voices=""/><msg @l="331" char_id="-1" frame_id="-1" name=""   text="他一脸胜利者的表情说道，同时把放在腰上的手移向了她的臀部。" voices=""/><msg @l="333" char_id="0" frame_id="-1" name="美帆" text="『…………唔。』"   voices=""/><msg @l="335" char_id="0" frame_id="-1" name="美帆"   text="(……现在，只能跟着他走了……吗)" voices=""/><msg @l="337" char_id="-1" frame_id="-1" name="大黑" text="『您打算怎么办？』"   voices=""/><char @l="339" id="miho" pos="left" src="miho025"/><msg @l="340" char_id="0" frame_id="-1" name="美帆" text="『……我、我知道了。』"   voices=""/><msg @l="342" char_id="-1" frame_id="-1" name=""   text="我……稍微犹豫了一下，但很快就按照他说的去做了。" voices=""/><clear @l="344" class="char"/><clear @l="349" class="all"/><wait_chgmv/><bg @l="353" src="bg17h1"/><char @l="357" id="ookur" pos="left" src="ookuro010"/><msg @l="359" char_id="-1" frame_id="-1" name="穿西装的男子" text="『请这边走。』"   voices=""/><char @l="363" id="miho" pos="right" src="miho126"/><msg @l="365" char_id="0" frame_id="-1" name="美帆" text="『………。』" voices=""/><msg @l="367" char_id="-1" frame_id="-1" name=""   text="穿过办公室，我被带到了最里面类似会议区的地方。" voices=""/><msg @l="368" char_id="-1" frame_id="-1" name=""   text="隔板分隔出的空间里，摆放着一张办公桌，四把椅子围绕着它整齐排列。" voices=""/><msg @l="369" char_id="-1" frame_id="-1" name=""   text="桌上放着一台电脑，墙边的液晶显示器屏幕上显示着大量文件。" voices=""/><msg @l="371" char_id="-1" frame_id="-1" name="穿西装的男子"   text="『首先，请您看一下这个吧。』" voices=""/><msg @l="373" char_id="-1" frame_id="-1" name=""   text="他让我坐在椅子上，穿着西装的他说着这话，越过我的肩膀伸手到了桌上。" voices=""/><msg @l="374" char_id="-1" frame_id="-1" name=""   text="当他移动鼠标时，屏幕上显示出一个新的框架。" voices=""/><msg @l="376" char_id="0" frame_id="-1" name="美帆" text="『那个……这是什么？』"   voices=""/><msg @l="378" char_id="-1" frame_id="-1" name="穿西装的男子" text="『看了就知道了。』"   voices=""/><msg @l="380" char_id="0" frame_id="-1" name="美帆" text="『啊……。』" voices=""/><msg @l="382" char_id="-1" frame_id="-1" name=""   text="按照他说的，我凝视着屏幕上新出现的那个框架。" voices=""/><msg @l="383" char_id="-1" frame_id="-1" name=""   text="不过框内依然是一片漆黑，看着也什么都没有……。" voices=""/><msg @l="385" char_id="1" frame_id="-1" name="声音" text="『嗯……啊啊……。』"   voices=""/><char @l="389" id="miho" pos="right" src="miho124"/><msg @l="391" char_id="0" frame_id="-1" name="美帆" text="『……！？』" voices=""/><msg @l="393" char_id="-1" frame_id="-1" name=""   text="突然，从扬声器中传来了妩媚的声音。" voices=""/><msg @l="394" char_id="-1" frame_id="-1" name=""   text="在刚才还漆黑一片的框内……清晰地显示出一对裸体男女正在进行一看就知道是什么的行为。" voices=""/><msg @l="396" char_id="0" frame_id="-1" name="美帆" text="『呃……这是，玲小姐……？』"   voices=""/><msg @l="398" char_id="-1" frame_id="-1" name=""   text="框内显示的裸体女性，是玲小姐。" voices=""/><msg @l="399" char_id="-1" frame_id="-1" name=""   text="被多名男性包围，嘴巴、胸部和私处都被粗暴侵犯的玲小姐的身影，清晰地显示在那个小框框里。" voices=""/><msg @l="401" char_id="-1" frame_id="-1" name="穿西装的男子"   text="『怎么样，拍得很清晰吧？』" voices=""/><msg @l="403" char_id="-1" frame_id="-1" name="穿西装的男子"   text="『这是还没有进行马赛克处理的版本，所以连结合部位都看得一清二楚。』" voices=""/><msg @l="405" char_id="-1" frame_id="-1" name="" text="西装男愉快地在我耳边低语道。"   voices=""/><msg @l="406" char_id="-1" frame_id="-1" name=""   text="我……虽然知道不应该看，但目光却无法从屏幕上移开。" voices=""/><msg @l="408" char_id="-1" frame_id="-1" name="穿西装的男子"   text="『顺便说一下，这是昨天刚录制的内容。』" voices=""/><msg @l="410" char_id="-1" frame_id="-1" name="穿西装的男子"   text="『今天的视频还在录制中，所以如果您能再稍等一会儿，我就能给您看了哦？』" voices=""/><char @l="413" id="miho" pos="right" src="miho024"/><msg @l="415" char_id="0" frame_id="-1" name="美帆" text="『今天的……！？』"   voices=""/><msg @l="417" char_id="-1" frame_id="-1" name=""   text="这意味着，像现在播放的这种事情，此刻仍在某处进行着。" voices=""/><msg @l="418" char_id="-1" frame_id="-1" name=""   text="在这栋建筑的某个地方，玲小姐现在仍被那些男人们不断蹂躏着。" voices=""/><msg @l="419" char_id="-1" frame_id="-1" name=""   text="想到这里……胸口传来一阵刺痛。" voices=""/><char @l="422" id="miho" pos="right" src="miho025"/><msg @l="424" char_id="0" frame_id="-1" name="美帆" text="『太过分了……为什么要做这种……。』"   voices=""/><msg @l="426" char_id="-1" frame_id="-1" name="穿西装的男子"   text="『过分？这话我可不爱听。』" voices=""/><msg @l="428" char_id="-1" frame_id="-1" name="穿西装的男子"   text="『她是希望在我们公司就职的，所以我们才委托她完成我司的一项业务。』" voices=""/><msg @l="430" char_id="-1" frame_id="-1" name="穿西装的男子"   text="『话虽如此……她还只是在培训阶段而已。』" voices=""/><char @l="434" id="miho" pos="right" src="miho125"/><msg @l="436" char_id="0" frame_id="-1" name="美帆" text="『那是……。』" voices=""/><msg @l="438" char_id="-1" frame_id="-1" name="穿西装的男子" text="『什么？』" voices=""/><msg @l="440" char_id="0" frame_id="-1" name="美帆"   text="『那是……玲小姐，是她自己主动想要的吗！？』" voices=""/><msg @l="442" char_id="-1" frame_id="-1" name="穿西装的男子" text="『当然是。』"   voices=""/><char @l="446" id="miho" pos="right" src="miho125"/><msg @l="448" char_id="0" frame_id="-1" name="美帆"   text="『骗人！玲小姐说过她想成为建筑设计师。』" voices=""/><msg @l="450" char_id="0" frame_id="-1" name="美帆"   text="『居然会这样……难以置信。』" voices=""/><msg @l="452" char_id="-1" frame_id="-1" name=""   text="屏幕中被侵犯的玲小姐的表情，充满痛苦，完全不像是自愿的。" voices=""/><msg @l="454" char_id="-1" frame_id="-1" name="穿西装的男子"   text="『真是麻烦啊……不知道该如何解释才能让您相信呢。』" voices=""/><msg @l="456" char_id="0" frame_id="-1" name="美帆" text="『不管你说什么我都不会相信。』"   voices=""/><char @l="458" id="miho" pos="right" src="miho025"/><msg @l="459" char_id="0" frame_id="-1" name="美帆"   text="『让我见……让我见玲小姐！』" voices=""/><msg @l="461" char_id="-1" frame_id="-1" name="穿西装的男子" text="『这是不可能的。』"   voices=""/><msg @l="463" char_id="0" frame_id="-1" name="美帆" text="『为什么啊！？』"   voices=""/><msg @l="465" char_id="-1" frame_id="-1" name="穿西装的男子"   text="『因为她现在正处于培训的关键阶段。而且，如果她好不容易下定的决心因为见到您而动摇的话，那就麻烦了。』" voices=""/><char @l="469" id="miho" pos="right" src="miho025"/><msg @l="471" char_id="0" frame_id="-1" name="美帆" text="『那是什么意思……』"   voices=""/><msg @l="473" char_id="-1" frame_id="-1" name="穿西装的男子"   text="『好了……我们的谈话就到此为止吧。』" voices=""/><msg @l="475" char_id="-1" frame_id="-1" name="穿西装的男子"   text="『真岛君，请拘束这位女士。』" voices=""/><msg @l="477" char_id="-1" frame_id="-1" name=""   text="西装男说着嘴角扭曲，一个眼神锐利的男性从隔间的屏风后走进来，抓住了我的手。"   voices=""/><msg @l="478" char_id="-1" frame_id="-1" name=""   text="……看来他一直在隔间外观察我们的情况。" voices=""/><char @l="482" id="miho" pos="right" src="miho124"/><msg @l="484" char_id="0" frame_id="-1" name="美帆" text="『不要……请放开我！』"   voices=""/><msg @l="486" char_id="-1" frame_id="-1" name="真岛"   text="『哎呀……小姐，乖乖听话对你比较有利哦。』" voices=""/><msg @l="488" char_id="-1" frame_id="-1" name="真岛"   text="『我是个平等主义者，不管对方是男是女，只要不听话的家伙我一概不会手下留情。』" voices=""/><char @l="492" id="miho" pos="right" src="miho125"/><msg @l="494" char_id="0" frame_id="-1" name="美帆" text="『………。』" voices=""/><msg @l="496" char_id="-1" frame_id="-1" name="真岛"   text="『对，就是这样。乖乖的话就不会遭罪了。』" voices=""/><msg @l="498" char_id="-1" frame_id="-1" name="真岛"   text="『嘛，其实我更喜欢你反抗，那样更有趣啊？』" voices=""/><msg @l="500" char_id="-1" frame_id="-1" name="穿西装的男子"   text="『真岛君，不能拿她寻开心啊。』" voices=""/><msg @l="502" char_id="-1" frame_id="-1" name="真岛"   text="『嘿嘿，别担心，我不会对大黑先生的客人动粗的。』" voices=""/><char @l="506" id="miho" pos="right" src="miho024"/><msg @l="508" char_id="0" frame_id="-1" name="美帆" text="『咦……大黑？』"   voices=""/><msg @l="510" char_id="-1" frame_id="-1" name="穿西装的男子"   text="『啊，我还没有自我介绍呢。』" voices=""/><msg @l="512" char_id="-1" frame_id="-1" name="大黑"   text="『我是大黑建设南总町支社的支社长，大黑满彦。请多关照。』" voices=""/><char @l="516" id="miho" pos="right" src="miho025"/><msg @l="518" char_id="0" frame_id="-1" name="美帆" text="『………。』" voices=""/><msg @l="520" char_id="-1" frame_id="-1" name="大黑"   text="『感到意外吗？还是说惊讶呢？』" voices=""/><msg @l="522" char_id="0" frame_id="-1" name="美帆"   text="『社长亲自做这种事……真是疯了……。』" voices=""/><msg @l="524" char_id="-1" frame_id="-1" name="大黑"   text="『我就把这当作赞美接受了。』" voices=""/><msg @l="526" char_id="-1" frame_id="-1" name="大黑"   text="『在这个城镇里，疯狂才是……正确的啊。』" voices=""/><msg @l="528" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="530" char_id="0" frame_id="-1" name="美帆" text="『你打算怎么处置我？』"   voices=""/><msg @l="532" char_id="0" frame_id="-1" name="美帆"   text="『是不是打算像对玲小姐那样……强迫我接客？』" voices=""/><msg @l="534" char_id="-1" frame_id="-1" name="大黑"   text="『这样吧……看在你为了救玲小姐而来的勇气和决心的份上，我们来打个赌如何？』" voices=""/><msg @l="536" char_id="0" frame_id="-1" name="美帆" text="『打赌……吗？』"   voices=""/><msg @l="538" char_id="-1" frame_id="-1" name="大黑"   text="『是的。如果你能赢得这个赌局，我就让你见她。』" voices=""/><msg @l="540" char_id="-1" frame_id="-1" name="大黑"   text="『如果那时她希望回家的话……你们两个都可以回去，我不会阻拦。』" voices=""/><char @l="544" id="miho" pos="right" src="miho024"/><msg @l="546" char_id="0" frame_id="-1" name="美帆" text="『啊……真、真的吗！？』"   voices=""/><msg @l="548" char_id="-1" frame_id="-1" name="大黑"   text="『信不信由你。』" voices=""/><char @l="552" id="miho" pos="right" src="miho125"/><msg @l="554" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="556" char_id="-1" frame_id="-1" name=""   text="老实说……我不能相信这个人的话。" voices=""/><msg @l="557" char_id="-1" frame_id="-1" name=""   text="但是，现在除了相信并服从……没有其他救玲小姐的方法。" voices=""/><msg @l="559" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><char @l="562" id="miho" pos="right" src="miho025"/><msg @l="564" char_id="0" frame_id="-1" name="美帆" text="『我明白了……我相信你。』"   voices=""/><msg @l="566" char_id="-1" frame_id="-1" name="大黑" text="『很好。』"   voices=""/><msg @l="568" char_id="-1" frame_id="-1" name="大黑" text="『真岛君，请准备一下。』"   voices=""/><msg @l="570" char_id="-1" frame_id="-1" name="真岛" text="『我知道了。』"   voices=""/><msg @l="572" char_id="-1" frame_id="-1" name=""   text="那个被称为真岛的目光锐利的男人这样回答着，浮现出一丝猥琐的笑容，瞥了我一眼后，就离开了隔间。" voices=""/><msg @l="574" char_id="0" frame_id="-1" name="美帆"   text="『……打赌的话，我需要做什么？』" voices=""/><msg @l="576" char_id="-1" frame_id="-1" name="大黑" text="『等一会儿就知道了。』"   voices=""/><msg @l="578" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><clear @l="584" class="all"/><msgshow @l="586" show="true"/><wait_chgmv/><bg @l="590" src="bg17h1"/><char @l="594" id="ookur" pos="left" src="ookuro010"/><char @l="598" id="miho" pos="right" src="miho125"/><msg @l="602" char_id="-1" frame_id="-1" name="真岛" text="『准备工作已经完成了。』"   voices=""/><msg @l="604" char_id="-1" frame_id="-1" name="" text="大概等了五分钟吧。"   voices=""/><msg @l="605" char_id="-1" frame_id="-1" name=""   text="与大黑建设的社长在狭小空间里独处……那是一段令人窒息的时间。" voices=""/><msg @l="607" char_id="-1" frame_id="-1" name="大黑" text="『那么，请跟我来。』"   voices=""/><msg @l="609" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="611" char_id="0" frame_id="-1" name="美帆" text="『……好的。』" voices=""/><clear @l="617" class="all"/><msgshow @l="619" show="true"/><wait_chgmv/><bg @l="623" src="bg17"/><char @l="627" id="ookur" pos="left" src="ookuro010"/><char @l="631" id="miho" pos="right" src="miho126"/><msg @l="633" char_id="-1" frame_id="-1" name=""   text="我被带到的地方是一间奇怪的纵长房间前。" voices=""/><msg @l="634" char_id="-1" frame_id="-1" name=""   text="说是接待室似乎有些不相称……一个奇怪的房间。" voices=""/><msg @l="636" char_id="0" frame_id="-1" name="美帆" text="『那个……到底要做什么呢？』"   voices=""/><msg @l="638" char_id="-1" frame_id="-1" name="大黑" text="『是打赌。』" voices=""/><char @l="641" id="miho" pos="right" src="miho025"/><msg @l="643" char_id="0" frame_id="-1" name="美帆" text="『这个我知道。』"   voices=""/><msg @l="645" char_id="0" frame_id="-1" name="美帆" text="『请告诉我……打赌的内容。』"   voices=""/><msg @l="647" char_id="-1" frame_id="-1" name="大黑" text="『真岛君。』" voices=""/><msg @l="649" char_id="-1" frame_id="-1" name="真岛" text="『是。』" voices=""/><msg @l="651" char_id="-1" frame_id="-1" name="大黑" text="『请你来陪这位小姐。』"   voices=""/><msg @l="653" char_id="-1" frame_id="-1" name="真岛"   text="『我可以吗？我还以为能久违地看到大黑先生的厉害之处呢。』" voices=""/><msg @l="655" char_id="-1" frame_id="-1" name="大黑"   text="『我得在旁边进行面试……这边就拜托你了。』" voices=""/><msg @l="657" char_id="-1" frame_id="-1" name="大黑"   text="『不过，不要超出赌约范围做到最后，那样可不行哦。』" voices=""/><msg @l="659" char_id="-1" frame_id="-1" name="真岛"   text="『原来如此……那么，我们也是比谁能忍耐得更久的比赛吗？』" voices=""/><msg @l="661" char_id="-1" frame_id="-1" name="大黑" text="『怎么样？这是最棒的宴会吧。』"   voices=""/><msg @l="663" char_id="-1" frame_id="-1" name="真岛"   text="『嗯。不愧是大黑先生，真是够恶劣的。』" voices=""/><char @l="667" id="miho" pos="right" src="miho024"/><msg @l="669" char_id="0" frame_id="-1" name="美帆" text="『诶……那个，等一下？』"   voices=""/><msg @l="671" char_id="-1" frame_id="-1" name=""   text="仿佛没听见我的话一样，两人擅自推进了谈话。" voices=""/><msg @l="672" char_id="-1" frame_id="-1" name=""   text="对手啊，留着啊……真是搞不懂他们在说什么。" voices=""/><msg @l="674" char_id="-1" frame_id="-1" name="大黑" text="『那么，就拜托你了。』"   voices=""/><clear @l="678" class="char"/><char @l="681" id="miho" pos="auto" src="miho024"/><msg @l="683" char_id="0" frame_id="-1" name="美帆" text="『啊……』" voices=""/><msg @l="685" char_id="-1" frame_id="-1" name=""   text="大黑像什么都没发生一样转身准备去隔壁房间。" voices=""/><msg @l="686" char_id="-1" frame_id="-1" name=""   text="明明还没听说赌约的内容……就这样擅自离开真是太过分了。" voices=""/><msg @l="687" char_id="-1" frame_id="-1" name=""   text="对我来说，这可能是拯救玲小姐的唯一手段。" voices=""/><char @l="690" id="miho" pos="auto" src="miho025"/><msg @l="692" char_id="0" frame_id="-1" name="美帆" text="『那个，赌约要怎么进行啊！？』"   voices=""/><msg @l="694" char_id="-1" frame_id="-1" name="大黑"   text="『赌约的话，已经开始了哦……加油啊。』" voices=""/><msg @l="696" char_id="-1" frame_id="-1" name="真岛"   text="『嘛，就是这样。拜托你了！』" voices=""/><char @l="700" id="miho" pos="auto" src="miho124"/><msg @l="702" char_id="0" frame_id="-1" name="美帆" text="『诶……啊啊！？』"   voices=""/><stopbgm @l="706" fadeout="1000"/><clear @l="712" class="all"/><msgshow @l="714" show="true"/><wait_chgmv/><bg @l="718" src="bg17h1"/><bgm @l="722" src="bgm15" volume="1."/><msg @l="724" char_id="-1" frame_id="-1" name=""   text="突然，那个叫真岛的男人把我推倒在房间里。" voices=""/><msg @l="725" char_id="-1" frame_id="-1" name=""   text="话虽如此，如果说我没有预想到会变成这样，那就是在撒谎了。" voices=""/><msg @l="726" char_id="-1" frame_id="-1" name="" text="我……已经做好了心理准备。"   voices=""/><char @l="730" id="miho" pos="center" src="miho005f" y="-80"/><msg @l="732" char_id="0" frame_id="-1" name="美帆" text="『这就是……赌约的内容吗？』"   voices=""/><msg @l="734" char_id="-1" frame_id="-1" name="真岛"   text="『是啊。如果你能让我射的话，就算你赢。』" voices=""/><char @l="737" id="miho" pos="center" src="miho004f" y="-80"/><msg @l="739" char_id="0" frame_id="-1" name="美帆" text="『那是……。』" voices=""/><msg @l="741" char_id="-1" frame_id="-1" name="真岛"   text="『太简单了吗？别把我和那些普通大叔相提并论啊。』" voices=""/><char @l="744" id="miho" pos="center" src="miho005f" y="-80"/><msg @l="746" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="748" char_id="-1" frame_id="-1" name="真岛"   text="『不过确实，如果只是让我射出来这一个条件的话太简单了……那我再加两个条件吧。』" voices=""/><msg @l="750" char_id="0" frame_id="-1" name="美帆" text="『两个……吗。』"   voices=""/><msg @l="752" char_id="-1" frame_id="-1" name="真岛" text="『不愿意的话可以放弃哦？』"   voices=""/><msg @l="754" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="756" char_id="-1" frame_id="-1" name="" text="我无言地点了点头。" voices=""/><msg @l="757" char_id="-1" frame_id="-1" name="" text="虽然觉得很不合理……但那是唯一的办法。"   voices=""/><msg @l="759" char_id="-1" frame_id="-1" name="真岛" text="『那么，条件是。』"   voices=""/><msg @l="761" char_id="-1" frame_id="-1" name="真岛"   text="『第一个条件是要在15分钟内让我射……第二个条件是，你什么都不能做。』" voices=""/><msg @l="763" char_id="0" frame_id="-1" name="美帆" text="『诶……什么都不能做是……。』"   voices=""/><msg @l="765" char_id="-1" frame_id="-1" name="真岛"   text="『你什么都不做，想办法让我有感觉。』" voices=""/><char @l="768" id="miho" pos="center" src="miho105f" y="-80"/><msg @l="770" char_id="0" frame_id="-1" name="美帆" text="『这种事……。』" voices=""/><msg @l="772" char_id="-1" frame_id="-1" name="真岛" text="『做不到的话就算你输了。』"   voices=""/><msg @l="774" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="776" char_id="-1" frame_id="-1" name="真岛" text="『怎么样，要放弃的话现在就说？』"   voices=""/><char @l="779" id="miho" pos="center" src="miho005f" y="-80"/><msg @l="781" char_id="0" frame_id="-1" name="美帆" text="『……我做。』" voices=""/><msg @l="783" char_id="-1" frame_id="-1" name="真岛" text="『那很好。那我们马上开始吧。』"   voices=""/><msg @l="785" char_id="0" frame_id="-1" name="美帆" text="『……好的。』" voices=""/><label @l="788" id="event_scene28"/><label @l="792" id="chart_line35"/><wait_chgmv/><ev @l="796" src="ev-028"/><description @l="799" text="充满恶意的交易"/><bgm @l="803" src="bgm14" volume="1."/><msg @l="805" char_id="0" frame_id="-1" name="美帆" text="『嗯……。』"   voices="miho12480"/><msg @l="807" char_id="-1" frame_id="-1" name=""   text="几乎还未硬起来的东西被放在了我胸部的沟壑之间。" voices=""/><msg @l="808" char_id="-1" frame_id="-1" name=""   text="既然赌约规则中加入了“什么都不能做”这个条件，我就只能按照所说的什么都不做。" voices=""/><msg @l="809" char_id="-1" frame_id="-1" name=""   text="如果反抗导致赌约作废，那就得不偿失了。" voices=""/><msg @l="811" char_id="-1" frame_id="-1" name="真岛"   text="『既然说了不能用下面，让你用嘴又没意思……我就用你那看起来柔软的胸部了。』"   voices=""/><msg @l="813" char_id="-1" frame_id="-1" name=""   text="说完，真岛双手托起我的胸部，让我的乳沟夹住他放在中间的肉棒，从两侧挤压。" voices=""/><msg @l="815" char_id="0" frame_id="-1" name="美帆" text="『……。』"   voices="miho12490"/><msg @l="817" char_id="-1" frame_id="-1" name="真岛"   text="『喂，怎么了？就这么沉默的话我可射不出来哦？』" voices=""/><msg @l="819" char_id="0" frame_id="-1" name="美帆"   text="『但是，我……不知道该怎么办才好……。』" voices="miho12500"/><msg @l="821" char_id="0" frame_id="-1" name="美帆"   text="『这种事……我从没做过……。』" voices="miho12510"/><msg @l="823" char_id="-1" frame_id="-1" name="真岛"   text="『那就一直保持沉默等着15分钟过去吧。如果你不介意输掉比赛的话。』" voices=""/><msg @l="825" char_id="0" frame_id="-1" name="美帆"   text="『不行……那绝对不行……。』" voices="miho12520"/><msg @l="827" char_id="0" frame_id="-1" name="美帆"   text="『请、请教教我……我该怎么做……。』" voices="miho12530"/><msg @l="829" char_id="-1" frame_id="-1" name="真岛"   text="『要是我教你了那还叫什么比赛啊。』" voices=""/><msg @l="831" char_id="0" frame_id="-1" name="美帆"   text="『可是……这种事，我……。』" voices="miho12540"/><msg @l="833" char_id="-1" frame_id="-1" name="" text="我几乎是挤出声音来。"   voices=""/><msg @l="834" char_id="-1" frame_id="-1" name="" text="真是难堪。" voices=""/><msg @l="835" char_id="-1" frame_id="-1" name="" text="真是不甘心。" voices=""/><msg @l="836" char_id="-1" frame_id="-1" name=""   text="但即便如此，我……必须赢得这场赌约。" voices=""/><msg @l="837" char_id="-1" frame_id="-1" name=""   text="即使那是充满耻辱的事情，比如询问如何让男人射精的方法。" voices=""/><msg @l="839" char_id="0" frame_id="-1" name="美帆"   text="『求求你……至少告诉我该怎么做。』" voices="miho12550"/><msg @l="841" char_id="-1" frame_id="-1" name="真岛" text="『啧……没办法啊。』"   voices=""/><msg @l="843" char_id="-1" frame_id="-1" name=""   text="面对这样的我，真岛带着烦躁的表情，发出短促的咂舌声，吐出了几句话。" voices=""/><msg @l="845" char_id="-1" frame_id="-1" name="真岛"   text="『听好了？男人不只是靠触感，还会通过听觉感受的。』" voices=""/><msg @l="847" char_id="-1" frame_id="-1" name="真岛"   text="『所以你要说些能让我兴奋的话来挑逗我。』" voices=""/><msg @l="849" char_id="0" frame_id="-1" name="美帆" text="『等、挑逗是……。』"   voices="miho12560"/><msg @l="851" char_id="-1" frame_id="-1" name="真岛"   text="『如果做不到的话就算你输了。就这么简单。』" voices=""/><msg @l="853" char_id="-1" frame_id="-1" name="真岛" text="『……好好让我享受一下吧。』"   voices=""/><msg @l="855" char_id="0" frame_id="-1" name="美帆" text="『………。』"   voices="miho12570"/><msg @l="857" char_id="-1" frame_id="-1" name="" text="我拼命地思考着“挑逗”的台词。"   voices=""/><msg @l="858" char_id="-1" frame_id="-1" name=""   text="但是，当然我并不知道说什么话能让男人感到兴奋。" voices=""/><msg @l="860" char_id="0" frame_id="-1" name="美帆" text="『那、那个……。』"   voices="miho12580"/><msg @l="862" char_id="-1" frame_id="-1" name="真岛" text="『怎么了，又有问题吗？』"   voices=""/><msg @l="864" char_id="-1" frame_id="-1" name="真岛"   text="『你就不能用自己的脑子想想吗？』" voices=""/><msg @l="866" char_id="0" frame_id="-1" name="美帆"   text="『那、那个……把小、小鸡鸡……夹在胸部中间，会、会舒服吗？』" voices="miho12590"/><msg @l="868" char_id="-1" frame_id="-1" name="真岛"   text="『……嘿嘿，你开始懂了嘛。』" voices=""/><msg @l="870" char_id="-1" frame_id="-1" name="真岛"   text="『啊，你的这对还挺不错的。』" voices=""/><msg @l="872" char_id="0" frame_id="-1" name="美帆"   text="『那、那么……请……变得更舒服吧。』" voices="miho12600"/><msg @l="874" char_id="0" frame_id="-1" name="美帆"   text="『用我的胸部……让……小鸡鸡……变得舒服。』" voices="miho12610"/><msg @l="876" char_id="-1" frame_id="-1" name=""   text="我强忍着羞耻，拼命地说着色情的话语。" voices=""/><msg @l="878" char_id="-1" frame_id="-1" name="真岛"   text="『嗯。嘛，作为第一次来说算是不错的表现了。』" voices=""/><msg @l="880" char_id="-1" frame_id="-1" name="真岛"   text="『多少让我有点兴致了。』" voices=""/><msg @l="882" char_id="-1" frame_id="-1" name=""   text="说着，真岛开始缓缓地在我乳房的沟壑间移动那根肉柱。" voices=""/><msg @l="883" char_id="-1" frame_id="-1" name=""   text="原本完全没有硬度的肉棒，现在也开始微微变硬了。" voices=""/><msg @l="885" char_id="0" frame_id="-1" name="美帆" text="(这样……就好)"   voices="miho12620"/><msg @l="887" char_id="0" frame_id="-1" name="美帆"   text="(如、如果说很多色情的话……男人会高兴吗)" voices="miho12630"/><msg @l="889" char_id="-1" frame_id="-1" name=""   text="轻轻看着在胸与胸之间来回移动的肉棒…我说出了更加下流的话。" voices=""/><msg @l="891" char_id="0" frame_id="-1" name="美帆"   text="『小、小鸡鸡…在我的胸部之间来来回回，着呢。』" voices="miho12640"/><msg @l="893" char_id="0" frame_id="-1" name="美帆"   text="『前、前端部分…一会儿露出来一会儿进去…呢…。』" voices="miho12650"/><msg @l="895" char_id="0" frame_id="-1" name="美帆" text="『总感觉好色情啊……。』"   voices="miho12660"/><msg @l="897" char_id="-1" frame_id="-1" name="真岛" text="『你是第一次做乳交吗？』"   voices=""/><msg @l="899" char_id="0" frame_id="-1" name="美帆" text="『这个……叫做乳交吗？』"   voices="miho12670"/><msg @l="901" char_id="-1" frame_id="-1" name="真岛"   text="『没错。像你这样形状好看的胸部，所有人都会想要尝试一次的吧。』" voices=""/><msg @l="903" char_id="-1" frame_id="-1" name="真岛"   text="『跟用嘴或小穴的时候传达给肉棒的感觉微妙地不同，这种方式也相当容易让人上瘾啊。』" voices=""/><msg @l="905" char_id="-1" frame_id="-1" name=""   text="说完，真岛慢慢地摆动腰部，在随之轻轻摇晃的丰满之间撸动着他的男性器官。" voices=""/><msg @l="906" char_id="-1" frame_id="-1" name=""   text="那东西逐渐增加硬度，渐渐变得发热，像铁桩一样，每次律动都强烈地撑开胸部的沟壑。" voices=""/><msg @l="908" char_id="0" frame_id="-1" name="美帆" text="『……。』"   voices="miho12680"/><msg @l="910" char_id="-1" frame_id="-1" name=""   text="我……像是发热般恍惚地注视着真岛的龟头如同划开胸部般露出头来的样子。" voices=""/><msg @l="911" char_id="-1" frame_id="-1" name=""   text="即使是用胸部，被侵犯的屈辱感也没有任何改变。" voices=""/><msg @l="912" char_id="-1" frame_id="-1" name=""   text="然而，在这种屈辱感的背后……我感到身体正因一种从未体验过的美妙冲击而变得灼热。" voices=""/><msg @l="914" char_id="-1" frame_id="-1" name="真岛" text="『你……眼睛湿润起来了啊。』"   voices=""/><msg @l="916" char_id="0" frame_id="-1" name="美帆" text="『诶……。』"   voices="miho12690"/><msg @l="918" char_id="-1" frame_id="-1" name="真岛"   text="『你的身体在渴望这家伙吧？但现在还不行哦。』" voices=""/><msg @l="920" char_id="-1" frame_id="-1" name=""   text="真岛指着从我乳房之间缓缓进出的肉桩，嘴角歪斜地笑了。" voices=""/><msg @l="922" char_id="0" frame_id="-1" name="美帆"   text="『才没有……我才没有渴望什么！』" voices="miho12700"/><msg @l="924" char_id="-1" frame_id="-1" name="真岛"   text="『是吗？可你的乳头都已经挺立起来了呢？』" voices=""/><msg @l="926" char_id="-1" frame_id="-1" name=""   text="真岛的手指捏住了胸前的乳头。" voices=""/><msg @l="928" char_id="0" frame_id="-1" name="美帆" text="『嗯啊！！』"   voices="miho12710"/><msg @l="930" char_id="-1" frame_id="-1" name="" text="连我自己都惊讶于那泄露出的巨大声音。"   voices=""/><msg @l="931" char_id="-1" frame_id="-1" name=""   text="仅仅是乳头被轻轻捏住而已，尖锐而又甜美的刺激一瞬间就席卷了全身。" voices=""/><msg @l="933" char_id="0" frame_id="-1" name="美帆"   text="『呀啊……啊………嗯嗯………。』" voices="miho12720"/><msg @l="935" char_id="-1" frame_id="-1" name="真岛" text="『看吧……对自己坦诚一点。』"   voices=""/><msg @l="937" char_id="-1" frame_id="-1" name="真岛"   text="『那样的话，多少也能学会一些如何对待男人的方法哦。』" voices=""/><msg @l="939" char_id="0" frame_id="-1" name="美帆"   text="『嗯嗯……那种事……我，不明白啊………。』" voices="miho12730"/><msg @l="941" char_id="-1" frame_id="-1" name="真岛"   text="『不明白的话至少要嗯嗯地娇喘啊。那样的话或许能让我快点射出来。』" voices=""/><msg @l="943" char_id="-1" frame_id="-1" name=""   text="真岛这样愉快地笑着，抓住了微微颤抖的乳房，" voices=""/><msg @l="944" char_id="-1" frame_id="-1" name=""   text="缓缓移动着已经变硬的肉棒，继续侵犯着我。" voices=""/><msg @l="946" char_id="0" frame_id="-1" name="美帆"   text="(就这样耗着的话，赌注的时间也会一点点过去……)" voices="miho12740"/><msg @l="948" char_id="0" frame_id="-1" name="美帆" text="(但是……该怎么办……)"   voices="miho12750"/><msg @l="950" char_id="-1" frame_id="-1" name="真岛"   text="『怎么了？就这样一言不发的话，别说高潮了，我都要萎了。』" voices=""/><msg @l="952" char_id="0" frame_id="-1" name="美帆" text="『是、是的……。』"   voices="miho12760"/><msg @l="954" char_id="0" frame_id="-1" name="美帆"   text="『请、请更多地……用肉棒侵犯我的胸部。』" voices="miho12770"/><msg @l="956" char_id="0" frame_id="-1" name="美帆"   text="『请用我的胸部……快点、射出来吧………。』" voices="miho12780"/><msg @l="958" char_id="-1" frame_id="-1" name=""   text="我……颤抖着声音，能说出这些已经是竭尽全力了。" voices=""/><stopbgm @l="962" fadeout="1000"/><clear @l="968" class="all"/><msgshow @l="971" show="true"/><wait_chgmv/><bg @l="975" src="bg17h1"/><char @l="979" id="ookur" pos="left" src="ookuro010"/><char @l="983" id="rei" pos="right" src="rei115"/><bgm @l="987" src="bgm09" volume="1."/><msg @l="990" char_id="-1" frame_id="-1" name="大黑" text="『就、就是这么回事。』"   voices=""/><msg @l="992" char_id="-1" frame_id="-1" name=""   text="在美帆被迫进行“赌约”的房间隔壁，大黑和玲一直站在变成了单向玻璃的大镜子前观察着里面的情况。"   voices=""/><msg @l="993" char_id="-1" frame_id="-1" name="" text="声音并没有传过来。" voices=""/><msg @l="994" char_id="-1" frame_id="-1" name=""   text="只是透过玻璃看到了两人的样子而已。" voices=""/><msg @l="996" char_id="-1" frame_id="-1" name="大黑"   text="『她好像，无论如何都想进入我们公司工作……。』" voices=""/><msg @l="998" char_id="-1" frame_id="-1" name="大黑"   text="『当我说明招聘名额有限时，她也表示无论是什么部门都无所谓。』" voices=""/><msg @l="1000" char_id="-1" frame_id="-1" name="大黑"   text="『无奈之下，我们让她和您一样接受测试。』" voices=""/><msg @l="1002" char_id="1" frame_id="-1" name="玲" text="『为什么……。』" voices=""/><msg @l="1004" char_id="-1" frame_id="-1" name="" text="玲焦急起来。" voices=""/><msg @l="1005" char_id="-1" frame_id="-1" name=""   text="她担心美帆是为了报复自己的背叛，想要取消这次的内定，所以才会挑战这种屈辱性的测试……。"   voices=""/><msg @l="1006" char_id="-1" frame_id="-1" name=""   text="当然，她并不知道这是大黑和朽木为了让两人堕落而设下的陷阱———。" voices=""/><msg @l="1008" char_id="-1" frame_id="-1" name="大黑"   text="『我理解玲小姐的愤怒，但作为企业，这是为了获得更优秀人才而采取的措施。』" voices=""/><msg @l="1010" char_id="-1" frame_id="-1" name="大黑" text="『请务必理解……。』"   voices=""/><msg @l="1012" char_id="1" frame_id="-1" name="玲"   text="『假如……她通过了这个测试，我会怎么样！？』" voices=""/><msg @l="1014" char_id="-1" frame_id="-1" name="大黑"   text="『那种情况下，很遗憾，这就意味着玲小姐与我们公司没有共同的缘分。』" voices=""/><char @l="1017" id="rei" pos="right" src="rei117"/><msg @l="1019" char_id="1" frame_id="-1" name="玲" text="『怎么会！！』" voices=""/><msg @l="1021" char_id="1" frame_id="-1" name="玲"   text="『那我到现在为止参加的测试又算什么呢！？』" voices=""/><msg @l="1023" char_id="-1" frame_id="-1" name=""   text="玲的脑海中浮现出至今为止忍受的种种凌辱。那一切都是为了实现自己成为建筑设计师的梦想，以及与稻庭同期入职……"   voices=""/><msg @l="1024" char_id="-1" frame_id="-1" name=""   text="仿佛能听到一切崩塌的声音。" voices=""/><msg @l="1026" char_id="-1" frame_id="-1" name="大黑"   text="『嗯……的确如您所说。』" voices=""/><msg @l="1028" char_id="-1" frame_id="-1" name="大黑"   text="『所以，我想在这里给您一个机会。』" voices=""/><char @l="1031" id="rei" pos="right" src="rei115"/><msg @l="1033" char_id="1" frame_id="-1" name="玲" text="『机会？』"   voices=""/><msg @l="1035" char_id="-1" frame_id="-1" name="大黑"   text="『是的……如果您能让我高潮的速度比仲根小姐让真岛君高潮的速度更快，那么无论她是否合格，我们都会录用您。』"   voices=""/><msg @l="1037" char_id="-1" frame_id="-1" name="大黑"   text="『当然，是否接受这个机会完全取决于您。』" voices=""/><msg @l="1039" char_id="-1" frame_id="-1" name="大黑"   text="『如果您不介意之前的努力付诸东流，那么就这样继续见证她的考试结果也无妨。』" voices=""/><msg @l="1041" char_id="1" frame_id="-1" name="玲" text="『……。』" voices=""/><msg @l="1043" char_id="-1" frame_id="-1" name="大黑"   text="『您怎么决定？不快点的话测试就要结束了。』" voices=""/><char @l="1046" id="rei" pos="right" src="rei113"/><msg @l="1048" char_id="1" frame_id="-1" name="玲" text="『我、我要做……。』"   voices=""/><msg @l="1050" char_id="1" frame_id="-1" name="玲" text="『请让我做！』"   voices=""/><msg @l="1052" char_id="-1" frame_id="-1" name="" text="猎物完全落入了黑暗的陷阱。"   voices=""/><msg @l="1053" char_id="-1" frame_id="-1" name=""   text="此刻的玲，已经失去了冷静判断的能力。" voices=""/><stopbgm @l="1057" fadeout="1000"/><clear @l="1063" class="all"/><label @l="1066" id="event_scene29"/><label @l="1070" id="chart_line36"/><wait_chgmv/><ev @l="1074" src="ev-029a"/><description @l="1077" text="交错的敌对心理"/><bgm @l="1081" src="bgm14" volume="1."/><msg @l="1083" char_id="-1" frame_id="-1" name="大黑"   text="『是的……请像旁边那位小姐一样只用胸部。』" voices=""/><msg @l="1085" char_id="1" frame_id="-1" name="玲" text="『好、好的……嗯，唔嗯。』"   voices="rei02740"/><msg @l="1087" char_id="-1" frame_id="-1" name=""   text="玲跪在大黑脚下，粗暴地将胸罩往下拉。两团丰满的圆润曲线弹跳而出。然后，她用那丰满的乳房托起他胯间无力垂挂的东西，轻轻地夹住了。"   voices=""/><msg @l="1089" char_id="1" frame_id="-1" name="玲" text="『怎、怎么样……？』"   voices="rei02750"/><msg @l="1091" char_id="-1" frame_id="-1" name="大黑" text="『哦，感觉相当不错呢。』"   voices=""/><msg @l="1093" char_id="-1" frame_id="-1" name=""   text="被两团如同瓜果般大小的肉房轻柔挤压着的肉桩，眼看着迅速增加硬度，变成了炙热的铁柱。"   voices=""/><msg @l="1094" char_id="-1" frame_id="-1" name=""   text="最终完全挺立的男根，仿佛要推开玲的胸部一般，从乳沟的上方露出了龟头。" voices=""/><msg @l="1096" char_id="1" frame_id="-1" name="玲" text="『啊……。』"   voices="rei02760"/><msg @l="1098" char_id="-1" frame_id="-1" name="" text="玲咕咚一声咽了口唾沫。"   voices=""/><msg @l="1099" char_id="-1" frame_id="-1" name=""   text="大概是被近在眼前跳动的生物震慑住了吧。它已经成长为相当可观的大小，表面浮现着如同蚯蚓般粗壮的血管。"   voices=""/><msg @l="1102" char_id="-1" frame_id="-1" name="大黑"   text="『好了，没有慢慢欣赏的余裕了哦？』" voices=""/><msg @l="1104" char_id="1" frame_id="-1" name="玲" text="『啊，是的……。』"   voices="rei02770"/><msg @l="1106" char_id="-1" frame_id="-1" name=""   text="慌忙回答后，玲开始缓缓地上下摇动身体。" voices=""/><msg @l="1107" char_id="-1" frame_id="-1" name=""   text="包裹在如丰收果实般丰满乳房中的肉柱，随着玲身体的摇动，在饱满肉体的狭缝间被不断摩擦。" voices=""/><msg @l="1109" char_id="1" frame_id="-1" name="玲" text="『嗯，嗯……。』"   voices="rei02780"/><msg @l="1111" char_id="-1" frame_id="-1" name="大黑" text="『很好，就是这样的节奏。』"   voices=""/><msg @l="1113" char_id="-1" frame_id="-1" name=""   text="大黒用满意的声音鼓励着努力为男根服务的玲。" voices=""/><msg @l="1115" char_id="1" frame_id="-1" name="玲" text="『嗯嗯……嗯，啊啊……。』"   voices="rei02790"/><msg @l="1117" char_id="-1" frame_id="-1" name=""   text="或许是感觉单纯的摩擦不够，大黒伸向乳房的手指开始玩弄起那如樱桃般羞涩喘息的乳首，轻轻揉搓起来。"   voices=""/><msg @l="1118" char_id="-1" frame_id="-1" name=""   text="玲虽然因敏感部位被玩弄而漏出喘息，却始终没有停下摩擦肉棒的动作。" voices=""/><msg @l="1120" char_id="-1" frame_id="-1" name="大黑"   text="『这弹性十足的艳丽肌肤……真棒，简直完美。』" voices=""/><msg @l="1122" char_id="1" frame_id="-1" name="玲"   text="『啊……嗯嗯……谢、谢谢您。』" voices="rei02800"/><msg @l="1124" char_id="-1" frame_id="-1" name=""   text="玲在大黒的爱抚下身体颤抖着回答。听到这话，大黒更加用力地揉捏着她的乳首。玲扭动着腰肢，淫靡地扭动着身体。"   voices=""/><msg @l="1125" char_id="-1" frame_id="-1" name=""   text="然后，为了回应大黒的期待，她用自己的丰满更紧地包裹住大黒的分身，加快了上下的动作。" voices=""/><msg @l="1127" char_id="-1" frame_id="-1" name="大黑" text="『哦哦哦……。』"   voices=""/><msg @l="1129" char_id="-1" frame_id="-1" name=""   text="被汗水浸湿的玲的胸部散发着洁白的光泽，发出轻微的晃动声。" voices=""/><msg @l="1131" char_id="-1" frame_id="-1" name="大黑"   text="『就那样……请舔一舔前端。』" voices=""/><msg @l="1133" char_id="1" frame_id="-1" name="玲"   text="『啊……可是，像她那样只用胸部……。』" voices="rei02810"/><msg @l="1135" char_id="-1" frame_id="-1" name="大黑"   text="『这是我给你的一点小福利。如果一切都要和仲根小姐完全公平的话，对一直以来努力的你来说太不公平了。』"   voices=""/><msg @l="1137" char_id="1" frame_id="-1" name="玲" text="『这、这样的话……。』"   voices="rei02820"/><wait_chgmv/><ev @l="1141" src="ev-029bz1"/><msg @l="1143" char_id="1" frame_id="-1" name="玲" text="『嗯……啾。』"   voices="rei02830"/><msg @l="1145" char_id="-1" frame_id="-1" name=""   text="她一边向上挤压着乳房一边俯下身，向着肉棒的前端伸出舌头。" voices=""/><msg @l="1146" char_id="-1" frame_id="-1" name=""   text="当舌尖触及龟头时，玲开始轻轻地舔舐马眼，像是在描绘它的形状。" voices=""/><msg @l="1148" char_id="-1" frame_id="-1" name="大黑"   text="『呃……就是这样，请继续保持这个节奏。』" voices=""/><msg @l="1150" char_id="1" frame_id="-1" name="玲" text="『好、好的……我明白了。』"   voices="rei02840"/><msg @l="1152" char_id="1" frame_id="-1" name="玲"   text="『嗯嗯……嗯，啾……舔……舔……。』" voices="rei02850"/><msg @l="1154" char_id="-1" frame_id="-1" name=""   text="她再次上下摇动身体，将舌尖靠近出现在曲线优美的乳沟上方的龟头，发出啧啧的声音舔舐着。"   voices=""/><msg @l="1156" char_id="1" frame_id="-1" name="玲"   text="『啾……嗯，嗯呼……啾……啾……。』" voices="rei02860"/><msg @l="1158" char_id="-1" frame_id="-1" name=""   text="伴随着淫靡的水声，她继续用胸部和舌尖服侍着。" voices=""/><msg @l="1159" char_id="-1" frame_id="-1" name=""   text="从前端滴落的唾液湿润了乳沟，当用乳房摩擦时也发出了咕叽咕叽的水声。" voices=""/><msg @l="1161" char_id="-1" frame_id="-1" name="大黑"   text="『如果不再快一点，会输给旁边的她哦？』" voices=""/><msg @l="1163" char_id="1" frame_id="-1" name="玲" text="『……！！』"   voices="rei02870"/><msg @l="1165" char_id="1" frame_id="-1" name="玲"   text="『嗯嗯……嗯，嗯……啾！！』" voices="rei02880"/><msg @l="1167" char_id="-1" frame_id="-1" name=""   text="受大黒的话语刺激，玲的动作变快了。" voices=""/><msg @l="1169" char_id="-1" frame_id="-1" name="大黑"   text="『……那么，另一边情况如何呢。』" voices=""/><msg @l="1171" char_id="-1" frame_id="-1" name=""   text="就这样，一边用余光看着慌张的玲……大黒将视线投向单向镜的另一侧。" voices=""/><msg @l="1172" char_id="-1" frame_id="-1" name=""   text="像是向正在让美帆做乳交的真岛使眼色一样……" voices=""/><clear @l="1177" class="all"/><wait_chgmv/><ev @l="1181" src="ev-028"/><msg @l="1183" char_id="0" frame_id="-1" name="美帆" text="『嗯嗯……』"   voices="miho12790"/><msg @l="1185" char_id="-1" frame_id="-1" name=""   text="我皱着眉头，额头上渗出汗水，努力寻找能让他高兴的话语。" voices=""/><msg @l="1186" char_id="-1" frame_id="-1" name=""   text="从刚才起已经过了大约10分钟了吧……" voices=""/><msg @l="1187" char_id="-1" frame_id="-1" name=""   text="侵犯着我乳沟的他的那个虽然高高勃起，但却丝毫没有射精的迹象。" voices=""/><msg @l="1189" char_id="-1" frame_id="-1" name="真岛" text="『快点快点，已经没时间了哦？』"   voices=""/><msg @l="1191" char_id="0" frame_id="-1" name="美帆"   text="『拜、拜托了……请您快点射出来……』" voices="miho12800"/><msg @l="1193" char_id="-1" frame_id="-1" name="真岛"   text="『这种没创意的台词可不行啊。』" voices=""/><msg @l="1195" char_id="0" frame_id="-1" name="美帆"   text="『这样……呃，那个……』" voices="miho12810"/><msg @l="1197" char_id="-1" frame_id="-1" name="真岛"   text="『怎么了？你不是想让我把精液射在你身上吗？』" voices=""/><msg @l="1199" char_id="-1" frame_id="-1" name=""   text="说着，真岛嘴角露出一丝狡黠的笑容。" voices=""/><msg @l="1201" char_id="0" frame_id="-1" name="美帆" text="『啊……』"   voices="miho12820"/><msg @l="1203" char_id="0" frame_id="-1" name="美帆"   text="『精、精液……请……请射给我………』" voices="miho12830"/><msg @l="1205" char_id="0" frame_id="-1" name="美帆"   text="『请……在我身上……射上……很多……精液。』" voices="miho12840"/><msg @l="1207" char_id="-1" frame_id="-1" name=""   text="我借用了他的话语，说出了这些挑逗的话。" voices=""/><msg @l="1208" char_id="-1" frame_id="-1" name="" text="从刚才开始一直是这样……"   voices=""/><msg @l="1209" char_id="-1" frame_id="-1" name=""   text="每当不懂性爱词汇的我陷入窘境时，真岛就故意抛出淫秽的词语。" voices=""/><msg @l="1210" char_id="-1" frame_id="-1" name=""   text="就像是在暗示着我使用这种词语一样。" voices=""/><msg @l="1212" char_id="-1" frame_id="-1" name="真岛"   text="『真不错啊，从你嘴里听到“精液”这种词，实在是太棒了。』" voices=""/><msg @l="1214" char_id="-1" frame_id="-1" name="真岛"   text="『就按这个节奏，说些平时不会说出口的淫秽词汇吧。』" voices=""/><msg @l="1216" char_id="0" frame_id="-1" name="美帆" text="『……。』"   voices="miho12850"/><msg @l="1218" char_id="-1" frame_id="-1" name=""   text="真岛一边让美帆为他乳交，一边向大黑发出信号。" voices=""/><clear @l="1223" class="all"/><wait_chgmv/><ev @l="1227" src="ev-029bz1"/><msg @l="1229" char_id="-1" frame_id="-1" name="大黑" text="『……。』" voices=""/><msg @l="1231" char_id="-1" frame_id="-1" name="大黑"   text="『看来真岛君那边也进展顺利呢……』" voices=""/><msg @l="1233" char_id="-1" frame_id="-1" name=""   text="大黑一边用指尖调整着塞在耳朵里的无线耳机位置，一边说道。" voices=""/><msg @l="1234" char_id="-1" frame_id="-1" name=""   text="隔壁房间的所有对话都通过那个耳机传了过来。" voices=""/><msg @l="1236" char_id="1" frame_id="-1" name="玲" text="『嗯……？』"   voices="rei02890"/><msg @l="1238" char_id="-1" frame_id="-1" name=""   text="玲注意到了大黑的低语，暂停了服务，抬眼看向他。" voices=""/><msg @l="1240" char_id="-1" frame_id="-1" name="大黑"   text="『不用在意我……请继续。』" voices=""/><msg @l="1242" char_id="1" frame_id="-1" name="玲" text="『……好的。』"   voices="rei02900"/><msg @l="1244" char_id="-1" frame_id="-1" name="" text="玲慢慢地重新开始。"   voices=""/><msg @l="1246" char_id="1" frame_id="-1" name="玲"   text="『嗯……啾噗………嗯嗯，舔……。』" voices="rei02910"/><msg @l="1248" char_id="1" frame_id="-1" name="玲"   text="『嗯，嗯，嗯……舔……嗯，啾噜噜。』" voices="rei02920"/><msg @l="1250" char_id="-1" frame_id="-1" name=""   text="她一边晃动着丰满的双峰服侍，一边用舌尖滴着唾液服侍，同时发出咕啾咕啾的淫靡声音，给大黑的欲望之棒带来刺激。"   voices=""/><msg @l="1252" char_id="-1" frame_id="-1" name="大黑"   text="『啊啊……请再多吸一下前端。』" voices=""/><msg @l="1254" char_id="1" frame_id="-1" name="玲"   text="『嗯……啾噗，啾呜呜呜呜！！』" voices="rei02930"/><msg @l="1256" char_id="-1" frame_id="-1" name=""   text="玲紧紧闭合柔软的嘴唇，用力吸吮着大黑，甚至连脸颊都凹陷下去。" voices=""/><msg @l="1257" char_id="-1" frame_id="-1" name="" text="她像是要把他的精华全部榨干一般。"   voices=""/><msg @l="1259" char_id="-1" frame_id="-1" name="大黑" text="『哦，哦哦……我要射了！！』"   voices=""/><flash @l="1263" count="4" fade="100" image="white"/><wait_chgmv/><ev @l="1267" src="ev-029ax1z1"/><msg @l="1269" char_id="1" frame_id="-1" name="玲" text="『嗯啊！？』"   voices="rei02940"/><msg @l="1271" char_id="-1" frame_id="-1" name=""   text="正当玲努力吮吸前端铃口想要吸出白浊的时候，阴茎在她口中猛烈地胀大了一圈，玲本能地移开了脸。"   voices=""/><msg @l="1272" char_id="-1" frame_id="-1" name=""   text="就在她转脸的瞬间，大量灼热黏稠的液体不仅弄脏了玲的嘴唇，就连胸部也……都被污染了。" voices=""/><msg @l="1274" char_id="1" frame_id="-1" name="玲"   text="『哈……哈………美，美帆呢……？』" voices="rei02950"/><msg @l="1276" char_id="-1" frame_id="-1" name="大黑"   text="『嗯，她现在怎么样了呢……。』" voices=""/><clear @l="1281" class="all"/><msg @l="1282" char_id="-1" frame_id="-1" name=""   text="此时的美帆还未能让真岛达到高潮。" voices=""/><wait_chgmv/><ev @l="1286" src="ev-028"/><msg @l="1288" char_id="-1" frame_id="-1" name=""   text="正如他充满自信的话所说，真岛依然面不改色地继续侵犯着我的胸部。" voices=""/><msg @l="1289" char_id="-1" frame_id="-1" name=""   text="5分钟过去了，10分钟过去了……我的焦虑逐渐膨胀。" voices=""/><msg @l="1291" char_id="-1" frame_id="-1" name="真岛"   text="『怎么了，剩下的时间不多了，你要放弃了吗？』" voices=""/><msg @l="1293" char_id="0" frame_id="-1" name="美帆"   text="『求，求您了……请射出精液。』" voices="miho12860"/><msg @l="1295" char_id="0" frame_id="-1" name="美帆"   text="『请把从肉棒前端流出的，那淫荡的精液射在我身上！』" voices="miho12870"/><msg @l="1297" char_id="-1" frame_id="-1" name=""   text="为了煽动真岛的兴奋，我正在说出我所知道的所有淫秽词汇。" voices=""/><msg @l="1299" char_id="-1" frame_id="-1" name="真岛"   text="『好啊……马上，马上就要射了！』" voices=""/><msg @l="1301" char_id="-1" frame_id="-1" name=""   text="终于……真岛腰部颤抖着，宣告着即将达到极限。" voices=""/><msg @l="1302" char_id="-1" frame_id="-1" name=""   text="他紧紧抓住我胸部的手也不由自主地用力，挤压在乳沟间的肉棒变得比之前更加坚硬膨胀。" voices=""/><msg @l="1304" char_id="0" frame_id="-1" name="美帆" text="『求你，快点射出来吧！！』"   voices="miho12880"/><msg @l="1306" char_id="0" frame_id="-1" name="美帆"   text="『精液……请把满满的精液，都射在我身上！！』" voices="miho12890"/><msg @l="1308" char_id="-1" frame_id="-1" name=""   text="到了最后关头，我主动说出色情的话语。" voices=""/><msg @l="1309" char_id="-1" frame_id="-1" name="" text="已经……羞耻心什么的早就没有了。"   voices=""/><msg @l="1311" char_id="-1" frame_id="-1" name="真岛"   text="『好啊，既然这么想要，那就给你！！』" voices=""/><flash @l="1315" count="4" fade="100" image="white"/><wait_chgmv/><ev @l="1319" src="ev-028x1z1"/><msg @l="1321" char_id="0" frame_id="-1" name="美帆" text="『嗯嗯！！』"   voices="miho12900"/><msg @l="1323" char_id="-1" frame_id="-1" name=""   text="在我胸部的乳沟间，那凶猛的肉棒猛地一跳，从顶端喷射出大量白浊液体，瞄准我的脸喷射而出。"   voices=""/><msg @l="1324" char_id="-1" frame_id="-1" name=""   text="炽热的液体黏稠地粘在我的脸颊、前额甚至睫毛上……溢落的欲望之露在地板上形成了一片水洼。" voices=""/><clear @l="1333" class="all"/><msg @l="1334" char_id="-1" frame_id="-1" name=""   text="玲确认了美帆的情况后，松了一口气说道。" voices=""/><msg @l="1336" char_id="1" frame_id="-1" name="玲" text="『太好了，我比较快——』"   voices="rei02960"/><msg @l="1338" char_id="-1" frame_id="-1" name="大黑" text="『……再来一次，拜托了。』"   voices=""/><msg @l="1340" char_id="1" frame_id="-1" name="玲" text="『诶……唔姆！？』"   voices="rei02970"/><wait_chgmv/><ev @l="1344" src="ev-029ax1z1"/><msg @l="1349" char_id="-1" frame_id="-1" name=""   text="一直在隔壁房间观察情况的大黑，突然按住玲的头，再次将勃起的顶端从美丽的嘴唇挤入口中。" voices=""/><msg @l="1350" char_id="-1" frame_id="-1" name=""   text="然后……大黑不管玲的困惑，自己开始动起腰来。" voices=""/><msg @l="1352" char_id="1" frame_id="-1" name="玲" text="『嗯、呜咕……。』"   voices="rei02980"/><msg @l="1354" char_id="-1" frame_id="-1" name=""   text="肉枪滋滋地侵犯着玲的嘴，一直顶到喉咙深处。玲因喉咙深处的不适而漏出了呜咽声。" voices=""/><msg @l="1355" char_id="-1" frame_id="-1" name=""   text="她感到下巴像要脱臼一般疼痛，意识因兴奋而变得模糊。" voices=""/><msg @l="1357" char_id="1" frame_id="-1" name="玲" text="『嗯、呜咕……。』"   voices="rei02980"/><msg @l="1359" char_id="-1" frame_id="-1" name=""   text="大黑就像是在插入蜜壶一样，用自己的凶器蹂躏着玲的嘴。" voices=""/><msg @l="1360" char_id="-1" frame_id="-1" name=""   text="玲也逐渐感觉自己的嘴像是变成了秘缝，身体开始感到一阵阵燥热。" voices=""/><msg @l="1362" char_id="-1" frame_id="-1" name="大黑"   text="『嗯嗯……啊，要射了！这是为了庆祝你不惜丢掉自尊也要赢得的精液！』" voices=""/><msg @l="1364" char_id="-1" frame_id="-1" name="大黑" text="『请尽情沐浴吧！』"   voices=""/><flash @l="1368" count="4" fade="100" image="white"/><wait_chgmv/><ev @l="1372" src="ev-029ax1z1z2"/><msg @l="1374" char_id="-1" frame_id="-1" name=""   text="从玲的嘴中抽出肉枪后，从枪尖以猛烈的势头射出了滚烫的粘液。" voices=""/><msg @l="1375" char_id="-1" frame_id="-1" name=""   text="大量的浊液仿佛不是第二次射精，沾染了毫无防备的玲的额头和头发。美丽的脸颊和如丝般的秀发都被白浊的欲望玷污了。" voices=""/><msg @l="1377" char_id="1" frame_id="-1" name="玲" text="『嗯嗯……。』"   voices="rei02990"/><msg @l="1379" char_id="-1" frame_id="-1" name="大黑"   text="『哎呀哎呀，真是精彩的胜利啊……玲小姐。』" voices=""/><msg @l="1381" char_id="-1" frame_id="-1" name="大黑"   text="『而且还能被浇上胜利的精液，真是太好了呢。』" voices=""/><msg @l="1383" char_id="1" frame_id="-1" name="玲" text="『嗯……啊………。』"   voices="rei02320"/><msg @l="1385" char_id="-1" frame_id="-1" name="大黑"   text="『呵呵呵，这样终于可以正式欢迎您成为我们公司的优秀员工了。』" voices=""/><msg @l="1387" char_id="-1" frame_id="-1" name=""   text="大黑对沾满大量精液而感到困惑的玲这样说道……然后露出了奸笑。" voices=""/><msg @l="1388" char_id="-1" frame_id="-1" name=""   text="那笑容与平时亲切的笑容不同，看起来非常邪恶。" voices=""/><stopbgm @l="1392" fadeout="1000"/><clear @l="1398" class="all"/><end_scene @l="1401"/><msgshow @l="1404" show="true"/><wait_chgmv/><bg @l="1408" src="bg17"/><bgm @l="1412" src="bgm15" volume="1."/><msg @l="1414" char_id="0" frame_id="-1" name="美帆" text="『时、时间……！』"   voices=""/><msg @l="1416" char_id="-1" frame_id="-1" name=""   text="带着真岛射出的精液，我站起身来查看时间。" voices=""/><se @l="1420" buf="1" src="時計のアラーム" volume="1."/><msg @l="1422" char_id="-1" frame_id="-1" name=""   text="就在那一瞬间……真岛的手表闹铃开始刺耳地响了起来。" voices=""/><msg @l="1424" char_id="-1" frame_id="-1" name="真岛" text="『这就是15分钟了，啊。』"   voices=""/><msg @l="1426" char_id="-1" frame_id="-1" name="真岛"   text="『恭喜啊……赌局是你赢了。』" voices=""/><stopse @l="1429" buf="1"/><msg @l="1431" char_id="0" frame_id="-1" name="美帆" text="『那、那么！』"   voices=""/><msg @l="1433" char_id="-1" frame_id="-1" name="真岛"   text="『我会让你见到你的玲女士的。』" voices=""/><msg @l="1435" char_id="-1" frame_id="-1" name="真岛"   text="『接下来的事情……就靠你自己确认了。』" voices=""/><msg @l="1437" char_id="0" frame_id="-1" name="美帆"   text="『玲女士……玲女士在哪里！？』" voices=""/><msg @l="1439" char_id="-1" frame_id="-1" name="大黑" text="『她的话就在这里哦。』"   voices=""/><msg @l="1441" char_id="0" frame_id="-1" name="美帆" text="『啊……。』" voices=""/><char @l="1445" id="ookur" pos="left" src="ookuro010"/><char @l="1449" id="rei" pos="right" src="rei185"/><msg @l="1451" char_id="-1" frame_id="-1" name=""   text="我朝声音传来的方向转身……果然玲就在那里。" voices=""/><msg @l="1452" char_id="-1" frame_id="-1" name=""   text="虽然我们只见过一天，却莫名地怀念起来。" voices=""/><msg @l="1454" char_id="1" frame_id="-1" name="玲" text="『美帆……。』" voices=""/><msg @l="1456" char_id="0" frame_id="-1" name="美帆" text="『玲、玲女士……！！』"   voices=""/><msg @l="1458" char_id="-1" frame_id="-1" name=""   text="我立刻朝着玲女士的方向跑去。" voices=""/><msg @l="1459" char_id="-1" frame_id="-1" name="" text="但是……。" voices=""/><char @l="1463" id="rei" pos="right" src="rei187"/><msg @l="1465" char_id="1" frame_id="-1" name="玲" text="『别过来！！』" voices=""/><char @l="1468" id="miho" pos="left" src="miho005"/><msg @l="1470" char_id="0" frame_id="-1" name="美帆" text="『啊……玲、玲女士？』"   voices=""/><msg @l="1472" char_id="1" frame_id="-1" name="玲"   text="『为什么……你要破坏我的梦想！』" voices=""/><msg @l="1474" char_id="1" frame_id="-1" name="玲"   text="『的确我……我对你做了过分的事。』" voices=""/><msg @l="1476" char_id="1" frame_id="-1" name="玲"   text="『但是……那是因为，最初是你……是你想要毁掉我的一切！！』" voices=""/><msg @l="1478" char_id="0" frame_id="-1" name="美帆" text="『玲女士……你在说什么……？』"   voices=""/><msg @l="1480" char_id="0" frame_id="-1" name="美帆"   text="『我、我是为了帮助玲女士才……来到这里的……。』" voices=""/><char @l="1484" id="rei" pos="right" src="rei184"/><msg @l="1486" char_id="1" frame_id="-1" name="玲"   text="『啊……！？美帆，你不是来应聘这家公司的吗……？』" voices=""/><msg @l="1488" char_id="0" frame_id="-1" name="美帆"   text="『什、什么啊，玲女士您在说什么呢。我是因为被告知如果想帮助玲女士的话，才来到这里的……。』" voices=""/><msg @l="1490" char_id="1" frame_id="-1" name="玲"   text="『那、那么……难道，刚才的也是……。』" voices=""/><char @l="1493" id="rei" pos="right" src="rei185"/><msg @l="1495" char_id="-1" frame_id="-1" name="大黑"   text="『好了好了，你们两个就此打住吧。』" voices=""/><msg @l="1497" char_id="-1" frame_id="-1" name="大黑"   text="『既然事情已经发展到这一步，也没办法了不是吗？』" voices=""/><msg @l="1499" char_id="-1" frame_id="-1" name="真岛"   text="『就是这么回事。毕竟你们两个今后可是要长期为我们工作的啊。』" voices=""/><msg @l="1501" char_id="1" frame_id="-1" name="玲" text="『两个人……是什么意思？』" voices=""/><msg @l="1503" char_id="-1" frame_id="-1" name="大黑"   text="『啊，我们还没有告诉玲女士呢。』" voices=""/><msg @l="1505" char_id="-1" frame_id="-1" name="大黑"   text="『其实这家公司的男性职员和现场工作人员加起来超过了400人。恰好我们正缺少清洁工作的女孩子，所以打算把你们两个都录用呢。』"   voices=""/><char @l="1509" id="rei" pos="right" src="rei187"/><msg @l="1511" char_id="1" frame_id="-1" name="玲"   text="『那么，从一开始你们就打算要陷害我和美帆两个人吗！！』" voices=""/><msg @l="1513" char_id="-1" frame_id="-1" name="大黑"   text="『这不对吧。我们什么都没做啊。最先说想要就职的不是你吗？』" voices=""/><msg @l="1515" char_id="-1" frame_id="-1" name="大黑"   text="『也就是说，你相当于是自己说着“想被侵犯”而来到这里的。』" voices=""/><msg @l="1517" char_id="1" frame_id="-1" name="玲"   text="『什！我、我是因为想在理想的公司做理想的工作，才来应聘这家公司的！！』" voices=""/><msg @l="1519" char_id="-1" frame_id="-1" name="大黑"   text="『那么，你是对我们公司的研究不够充分啊。因为你连入职意味着什么都不清楚……。』"   voices=""/><char @l="1522" id="rei" pos="right" src="rei185"/><msg @l="1524" char_id="1" frame_id="-1" name="玲" text="『呜……。』"   voices=""/><msg @l="1526" char_id="-1" frame_id="-1" name="大黑"   text="『啊，再让我说一句……是仲根小姐，把你给陷害了啊。』" voices=""/><char @l="1529" id="rei" pos="right" src="rei184"/><msg @l="1531" char_id="1" frame_id="-1" name="玲" text="『什！』" voices=""/><char @l="1534" id="miho" pos="left" src="miho104"/><msg @l="1536" char_id="0" frame_id="-1" name="美帆" text="『诶！？』" voices=""/><msg @l="1538" char_id="-1" frame_id="-1" name="大黑"   text="『你以为我不知道吗？朽木教授已经把一切都告诉我了……。』" voices=""/><msg @l="1540" char_id="0" frame_id="-1" name="美帆" text="『这、这是什么意思！？』"   voices=""/><char @l="1543" id="rei" pos="right" src="rei185"/><msg @l="1545" char_id="1" frame_id="-1" name="玲" text="『不要，不要说！』"   voices=""/><msg @l="1547" char_id="-1" frame_id="-1" name="大黑"   text="『呵呵呵……，玲小姐，你为了获得我们公司的内定，提出了以仲根小姐作为玩物的条件。』" voices=""/><msg @l="1549" char_id="-1" frame_id="-1" name="大黑"   text="『为了实现自己廉价的梦想，你把可爱的后辈献给了朽木教授……说着“请侵犯她”……。』" voices=""/><msg @l="1551" char_id="0" frame_id="-1" name="美帆" text="『啊！？』" voices=""/><msg @l="1553" char_id="0" frame_id="-1" name="美帆" text="『不、不会吧……。』"   voices=""/><msg @l="1555" char_id="0" frame_id="-1" name="美帆"   text="『这种事是谎言！是、是谎言对吧……玲小姐……？』" voices=""/><msg @l="1557" char_id="1" frame_id="-1" name="玲" text="『…………………………。』"   voices=""/><char @l="1560" id="miho" pos="left" src="miho105"/><msg @l="1562" char_id="0" frame_id="-1" name="美帆" text="『玲、玲小姐…………？』"   voices=""/><msg @l="1564" char_id="-1" frame_id="-1" name="大黑" text="『呵呵呵……。』"   voices=""/><msg @l="1566" char_id="-1" frame_id="-1" name="大黑"   text="『仲根小姐，真是可怜啊，你所仰慕的聪明女孩居然在背后暗中策划这一切。』" voices=""/><msg @l="1568" char_id="-1" frame_id="1" name="大黑"   text="（嘛，虽然事情变成这样也是因为我设下的陷阱……不过玲小姐却认为是自己的错。）" voices=""/><msg @l="1570" char_id="-1" frame_id="1" name="大黑"   text="（活该……玲小姐。看着像你这样拥有一切的女人，逐渐失去一切的样子……）" voices=""/><msg @l="1572" char_id="-1" frame_id="1" name="大黑"   text="（这一切都是你的错啊……是你的错……）" voices=""/><msg @l="1574" char_id="-1" frame_id="-1" name="大黑"   text="『而且你好不容易来救她，结果却一起被侵犯了。』" voices=""/><msg @l="1576" char_id="1" frame_id="-1" name="玲" text="『呜……呜呜呜……。』"   voices=""/><msg @l="1578" char_id="1" frame_id="-1" name="玲" text="『对不……起……。』"   voices=""/><msg @l="1580" char_id="1" frame_id="-1" name="玲"   text="『对不起……美帆……。』" voices=""/><msg @l="1582" char_id="1" frame_id="-1" name="玲"   text="『都是我……都是我太愚蠢了……竟然让你……遭受这种事情……。』" voices=""/><msg @l="1584" char_id="0" frame_id="-1" name="美帆" text="『玲、玲小姐……。』"   voices=""/><msg @l="1586" char_id="-1" frame_id="-1" name="大黑"   text="『好了，误会解开后的感人相见到此为止。』" voices=""/><msg @l="1588" char_id="-1" frame_id="-1" name="大黑"   text="『真岛君，请把她们两个带到调教室去。』" voices=""/><char @l="1592" id="miho" pos="left" src="miho104"/><msg @l="1594" char_id="0" frame_id="-1" name="美帆" text="『调教室是……。』"   voices=""/><msg @l="1596" char_id="-1" frame_id="-1" name="真岛"   text="『啊，就是厕所。特制的那种。你们要当清洁工了，要用你们的全身吸收所有男人的精液。』"   voices=""/><msg @l="1598" char_id="1" frame_id="-1" name="玲"   text="『求、求你！请让美帆回去……。』" voices=""/><msg @l="1600" char_id="1" frame_id="-1" name="玲"   text="『不管我怎么样都没关系……。』" voices=""/><msg @l="1602" char_id="-1" frame_id="-1" name="真岛"   text="『不行。你们两个都要为这家公司沾满精液，要好好工作到精疲力竭为止。』"   voices=""/><char @l="1606" id="rei" pos="right" src="rei185"/><msg @l="1608" char_id="1" frame_id="-1" name="玲" text="『什……。』" voices=""/><char @l="1612" id="miho" pos="left" src="miho105"/><msg @l="1614" char_id="0" frame_id="-1" name="美帆" text="『玲小姐……。』" voices=""/><msg @l="1616" char_id="-1" frame_id="-1" name="真岛"   text="『嗯，像你们这样精力旺盛的家伙，就让你们去做那些臭烘烘的“鸡巴”、积满浓稠精液的工地大叔们的性欲处理员吧！』"   voices=""/><msg @l="1618" char_id="-1" frame_id="-1" name="真岛"   text="『那些大叔的东西，超级臭的啊！要用你们的小穴和嘴巴好好地把它们清理干净哦！！』" voices=""/><msg @l="1620" char_id="-1" frame_id="-1" name="真岛"   text="『哈哈哈，哈———哈哈哈哈哈！！！』" voices=""/><char @l="1624" id="rei" pos="right" src="rei185"/><char @l="1627" id="miho" pos="left" src="miho105"/><msg @l="1629" char_id="1" frame_id="-1" name="玲" text="『呜呜呜呜呜……。』"   voices=""/><msg @l="1631" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="1633" char_id="-1" frame_id="-1" name=""   text="我和玲小姐不由自主地互相对视……" voices=""/><msg @l="1634" char_id="-1" frame_id="-1" name=""   text="但是……玲小姐很快就转过脸去，避开了视线。" voices=""/><msg @l="1635" char_id="-1" frame_id="-1" name="" text="这座城市疯了。" voices=""/><msg @l="1636" char_id="-1" frame_id="-1" name="" text="这座城市……正在使我们发疯。"   voices=""/><msg @l="1637" char_id="-1" frame_id="-1" name="" text="如果能早点发现这一点的话……"   voices=""/><msg @l="1638" char_id="-1" frame_id="-1" name="" text="但已经……太迟了……。"   voices=""/><stopbgm @l="1642" fadeout="1000"/><clear @l="1648" class="all"/><msgshow @l="1650" show="true"/><wait_chgmv/><bg @l="1654" src="bg17a"/><bgm @l="1658" src="bgm03" volume="1."/><msg @l="1660" char_id="-1" frame_id="-1" name="" text="———三天后。" voices=""/><msg @l="1661" char_id="-1" frame_id="-1" name=""   text="人才派遣部的办公室依旧如常运转着。" voices=""/><msg @l="1662" char_id="-1" frame_id="-1" name="" text="但是，那里的主人真岛却不见踪影。"   voices=""/><msg @l="1663" char_id="-1" frame_id="-1" name=""   text="他现在……在特制的厕所里……为了调教我们……。" voices=""/><clear @l="1669" class="all"/><label @l="1672" id="event_scene56"/><msg @l="1674" char_id="-1" frame_id="-1" name="真岛"   text="『喂，完事的家伙赶紧让开！』" voices=""/><msg @l="1676" char_id="-1" frame_id="-1" name=""   text="在大黑建设广阔的场地内有一座小建筑。" voices=""/><msg @l="1677" char_id="-1" frame_id="-1" name=""   text="那是被俗称为“工人专用厕所”的地方，是用来支付给工地人员肉体奖励的性欲处理厕所。" voices=""/><msg @l="1678" char_id="-1" frame_id="-1" name=""   text="在那个“厕所”里，现在有两只母猪正在工作的最高潮。" voices=""/><label @l="1682" id="chart_line37"/><wait_chgmv/><ev @l="1686" src="ev-056"/><description @l="1689" text="最终面试"/><bgm @l="1693" src="bgm15" volume="1."/><msg @l="1695" char_id="0" frame_id="-1" name="美帆" text="『唔唔……嗯、嗯嗯——！』"   voices="miho12910"/><msg @l="1697" char_id="1" frame_id="-1" name="玲"   text="『嗯嗯……咕唔……嗯、嗯、啊啊啊！！』" voices="rei03000"/><msg @l="1699" char_id="-1" frame_id="-1" name="" text="在房间里……两人被吊了起来。"   voices=""/><msg @l="1700" char_id="-1" frame_id="-1" name=""   text="双臂被绳子固定住，固定绳子的一端连接着天花板。" voices=""/><msg @l="1701" char_id="-1" frame_id="-1" name=""   text="正在侵犯美帆和玲的，全都是衣着邋遢的男人，几乎每个人都穿着印有“大黑建设”字样的工装。"   voices=""/><msg @l="1702" char_id="-1" frame_id="-1" name=""   text="这些都是真岛从工地上召集来的粗野男人。" voices=""/><msg @l="1703" char_id="-1" frame_id="-1" name="" text="他们大概直到刚才都还在工作。"   voices=""/><msg @l="1704" char_id="-1" frame_id="-1" name=""   text="他们满身灰尘和汗水，无一例外地散发着刺鼻的男人气味。" voices=""/><msg @l="1706" char_id="-1" frame_id="-1" name="真岛"   text="『别磨蹭……好好伺候这些男人。』" voices=""/><msg @l="1708" char_id="-1" frame_id="-1" name="" text="真岛在房间的一角大声怒吼。"   voices=""/><msg @l="1709" char_id="-1" frame_id="-1" name=""   text="房间外还有30多个男人。" voices=""/><msg @l="1710" char_id="-1" frame_id="-1" name=""   text="今天的工作是看在短暂的午休时间内能处理多少人的性欲……" voices=""/><msg @l="1712" char_id="0" frame_id="-1" name="美帆"   text="『唔咕……嗯，嗯嗯……呃哈……咳咳……呃哈……呜，不要了。』" voices="miho12920"/><msg @l="1714" char_id="-1" frame_id="-1" name=""   text="美帆强行吐出在她口中抽插的散发异味的肉棒，啜泣起来。" voices=""/><msg @l="1715" char_id="-1" frame_id="-1" name=""   text="那刺鼻的汗臭味和肉柱上附着的包皮垢的恶心感，让她多次差点吐出来，发出屈辱的呜咽声。" voices=""/><msg @l="1717" char_id="-1" frame_id="-1" name="工作人员A"   text="『什么啊……难得的奖金机会，你至少得好好满足我们才对得起这价钱啊！』" voices=""/><msg @l="1719" char_id="0" frame_id="-1" name="美帆"   text="『呜咕……唔咕……嗯，嗯嗯嗯嗯嗯！！』" voices="miho12930"/><msg @l="1721" char_id="-1" frame_id="-1" name=""   text="那肮脏的、布满包皮垢的男根再次撑开美帆可爱的嘴唇，强行插入她的口腔。" voices=""/><msg @l="1722" char_id="-1" frame_id="-1" name=""   text="这些人大概已经好几天没洗澡了……尽管有些污垢应该已经被唾液溶解冲走，但那独特的异味却始终挥之不去。"   voices=""/><msg @l="1724" char_id="0" frame_id="-1" name="美帆"   text="『呜呜……嗯……唔咕……嗯，嗯嗯！！』" voices="miho12940"/><msg @l="1726" char_id="-1" frame_id="-1" name=""   text="美帆松开嘴，任凭男人将肉棒插入。" voices=""/><msg @l="1727" char_id="-1" frame_id="-1" name=""   text="她大概是在期待男人自己快点射出来吧。" voices=""/><msg @l="1729" char_id="-1" frame_id="-1" name="真岛"   text="混蛋！好好吸啊，不要偷懒！！" voices=""/><msg @l="1731" char_id="0" frame_id="-1" name="美帆"   text="『是、是的……呜、啾、呃……』" voices="miho12950"/><msg @l="1733" char_id="-1" frame_id="-1" name=""   text="美帆脸上浮现出被真岛一声怒喝吓到的表情，舌头开始缠绕口中那坚硬的肉块。" voices=""/><msg @l="1734" char_id="-1" frame_id="-1" name=""   text="然而，舌尖直接感受到的异味和滑腻感实在无法习惯，恶心感不断袭来。" voices=""/><msg @l="1736" char_id="-1" frame_id="-1" name="真岛"   text="『你们以为谁的功劳让你们有遮风挡雨的房子住？』" voices=""/><msg @l="1738" char_id="-1" frame_id="-1" name="真岛"   text="『还不是因为有这些拿身体冒险干苦力活的家伙们！？』" voices=""/><msg @l="1740" char_id="-1" frame_id="-1" name="工作人员A"   text="『就是啊。我们每天拿着微薄的工资累得半死。』" voices=""/><msg @l="1742" char_id="-1" frame_id="-1" name="真岛" text="『对，就是这样。』"   voices=""/><msg @l="1744" char_id="-1" frame_id="-1" name="真岛"   text="『抚慰疲惫的男人也是你们这些废猪的重要工作，不要偷懒，好好服务！』" voices=""/><msg @l="1746" char_id="0" frame_id="-1" name="美帆"   text="『呜，呜咽……嗯……啾……啾，啾噗噗噗。』" voices="miho12960"/><msg @l="1748" char_id="-1" frame_id="-1" name="工作人员A"   text="『哦……舌头缠绕上来了，要融化了啊。』" voices=""/><msg @l="1750" char_id="-1" frame_id="-1" name=""   text="或许是因为受不了口中那小小舌头的触感，原本几乎要撕裂美帆小嘴的男人自己开始剧烈摆动腰部。"   voices=""/><msg @l="1752" char_id="0" frame_id="-1" name="美帆" text="『唔呣呣呣！？』"   voices="miho12970"/><msg @l="1754" char_id="-1" frame_id="-1" name="真岛"   text="『别吐出来。好好配合节奏收紧嘴唇吸吮。』" voices=""/><msg @l="1756" char_id="0" frame_id="-1" name="美帆"   text="『嗯嗯……嗯噗，嗯咕………嗯，嗯嗯。』" voices="miho12980"/><msg @l="1758" char_id="-1" frame_id="-1" name=""   text="按照真岛的指示，美帆一边让嘴唇周围沾满唾液和腺液，一边发出咕啾咕啾淫靡的声音套弄着口中的肉棒。"   voices=""/><msg @l="1759" char_id="-1" frame_id="-1" name=""   text="虽然恶心感一次又一次涌上来，但男人腰部的抽插毫不留情。" voices=""/><msg @l="1761" char_id="-1" frame_id="-1" name="工作人员B"   text="『哦，那边的姑娘真是努力啊。』" voices=""/><msg @l="1763" char_id="-1" frame_id="-1" name=""   text="在玲的口中抽插的男人，看到美帆和真岛的互动后说出了这句话。" voices=""/><msg @l="1764" char_id="-1" frame_id="-1" name=""   text="看来他对玲的口交不太满意。" voices=""/><msg @l="1766" char_id="-1" frame_id="-1" name="工作人员B"   text="『这边的小姐也得再努把力啊。』" voices=""/><msg @l="1768" char_id="1" frame_id="-1" name="玲" text="『嗯，嗯嗯嗯！！』"   voices="rei03010"/><msg @l="1770" char_id="-1" frame_id="-1" name=""   text="男人像对待美帆那样，猛烈摆动腰部试图深入玲的口腔。男人强行将自己的肉块顶入她的喉咙深处。"   voices=""/><msg @l="1771" char_id="-1" frame_id="-1" name=""   text="玲含着泪水，虽然勉强接受了它……但完全不愿意用舌头缠绕。" voices=""/><msg @l="1773" char_id="-1" frame_id="-1" name="工作人员B"   text="『喂，不好好吸的话可不会舒服啊。』" voices=""/><msg @l="1775" char_id="1" frame_id="-1" name="玲"   text="『呜哈……谁，谁会舔这种污秽的东西！！』" voices="rei03020"/><msg @l="1777" char_id="-1" frame_id="-1" name="工作人员B" text="『你说什么！！』"   voices=""/><se @l="1781" buf="1" src="ムチの音" volume="1."/><flash @l="1785" count="4" fade="100" image="white"/><msg @l="1787" char_id="1" frame_id="-1" name="玲" text="『呃咯……！！』"   voices="rei03030"/><msg @l="1789" char_id="-1" frame_id="-1" name=""   text="让玲含着的工人男子，就在他即将发怒的那一刻，真岛的鞭子朝着玲的背部猛地一抽。" voices=""/><msg @l="1791" char_id="-1" frame_id="-1" name="真岛"   text="『喂猪…你还不明白自己的立场吗？』" voices=""/><msg @l="1793" char_id="1" frame_id="-1" name="玲" text="『…』"   voices="rei03040"/><msg @l="1795" char_id="-1" frame_id="-1" name="真岛"   text="『这里的任何人比起你们这些母猪都干净得多。』" voices=""/><msg @l="1797" char_id="-1" frame_id="-1" name="真岛"   text="『你这肮脏的东西舔的无论是谁的肉棒，都必须认真地从头到尾都好好舔…我不是已经教过你了吗！？』"   voices=""/><se @l="1801" buf="1" src="ムチの音" volume="1."/><flash @l="1805" count="4" fade="100" image="white"/><msg @l="1807" char_id="1" frame_id="-1" name="玲" text="『呜啊！！』"   voices="rei03050"/><msg @l="1809" char_id="1" frame_id="-1" name="玲"   text="『不，不要…我会好好舔的…别再打我了！』" voices="rei03060"/><msg @l="1811" char_id="-1" frame_id="-1" name="真岛"   text="『蠢货母狗…那就一开始就好好做！！』" voices=""/><msg @l="1813" char_id="1" frame_id="-1" name="玲" text="『呜…。』"   voices="rei03070"/><msg @l="1815" char_id="-1" frame_id="-1" name="工作人员B"   text="『那么，重新好好地给我舔吧。』" voices=""/><msg @l="1817" char_id="-1" frame_id="-1" name=""   text="男人将自己的肉棒擦在玲的脸颊上，露出了陶醉的笑容。" voices=""/><msg @l="1819" char_id="1" frame_id="-1" name="玲" text="『……。』"   voices="rei03080"/><msg @l="1821" char_id="1" frame_id="-1" name="玲"   text="『嗯咕……嗯，啾噗，啾……嗯噗，啾噗噗。』" voices="rei03090"/><msg @l="1823" char_id="-1" frame_id="-1" name=""   text="玲一脸无奈地含住了工人男子的肉棒。" voices=""/><msg @l="1824" char_id="-1" frame_id="-1" name=""   text="看来她确实在意气味和污垢……她多次作呕想要吐出男根，但每次都被真岛瞪视着，慌忙重新含了回去。"   voices=""/><msg @l="1826" char_id="-1" frame_id="-1" name="真岛"   text="『好啦，母猪们都变得服从了……你们尽情地狠狠干她们吧！』" voices=""/><msg @l="1828" char_id="-1" frame_id="-1" name="工作人员C"   text="『哦！交给我们吧！』" voices=""/><msg @l="1830" char_id="-1" frame_id="-1" name="工作人员D"   text="『不用你说，我们也会好好干她们的！』" voices=""/><msg @l="1832" char_id="-1" frame_id="-1" name="工作人员E"   text="『真正的女人已经多少年没碰过了都记不清了！』" voices=""/><msg @l="1834" char_id="-1" frame_id="-1" name=""   text="围在两人周围的男人们七嘴八舌地说着，开始如饥似渴地侵犯她们的全身。" voices=""/><msg @l="1836" char_id="-1" frame_id="-1" name="工作人员C"   text="『来，姐姐，得再把小穴夹紧点才行啊！』" voices=""/><msg @l="1838" char_id="0" frame_id="-1" name="美帆"   text="『啊啊……好，好的……嗯，唔唔………啊啊啊。』" voices="miho12990"/><msg @l="1840" char_id="-1" frame_id="-1" name=""   text="按照男人的指示，美帆试图用下腹部的力量收紧秘穴，但由于被像锉刀一样搅动秘肉的刺激太强烈，她无法好好使上力气。"   voices=""/><msg @l="1842" char_id="-1" frame_id="-1" name="工作人员D"   text="『这边的姐姐……呃，阴道里面缠得真紧啊！』" voices=""/><msg @l="1844" char_id="1" frame_id="-1" name="玲"   text="『唔唔……呀，不要那么深……嗯嗯，啊，呜咕！！』" voices="rei03100"/><msg @l="1846" char_id="-1" frame_id="-1" name=""   text="被前后夹击无处可逃的玲的蜜穴，在男人猛烈的抽插下，发出咕啾咕啾的声音。" voices=""/><msg @l="1847" char_id="-1" frame_id="-1" name=""   text="男人张开的肉伞，将玲涌出的蜜液刮出，同时摩擦着她的粘膜。" voices=""/><msg @l="1848" char_id="-1" frame_id="-1" name=""   text="玲的腰不由自主地配合着男人的律动，有节奏地摆动，就像是自己主动想让对方插到子宫深处一样，将白皙的臀部朝着男人的方向挺出。"   voices=""/><msg @l="1850" char_id="-1" frame_id="-1" name="工作人员E" text="『呜，呜呜呜……。』"   voices=""/><msg @l="1852" char_id="-1" frame_id="-1" name=""   text="可能是等不及自己的回合了，一个正在排队等候的男人一边看着被侵犯的两人，一边开始自己套弄起兴奋的分身。"   voices=""/><msg @l="1853" char_id="-1" frame_id="-1" name=""   text="他大概是忍得太久了，龟头前端溢出大量的前列腺液，不断地滴落下来。" voices=""/><msg @l="1855" char_id="0" frame_id="-1" name="美帆"   text="『嗯噗，嗯，嗯，嗯，嗯呜呜！！』" voices="miho13000"/><msg @l="1857" char_id="1" frame_id="-1" name="玲"   text="『啾噗……嗯，嗯嗯……呼啊，啊，嗯啊啊！！』" voices="rei03110"/><msg @l="1859" char_id="-1" frame_id="-1" name=""   text="尽管两人因秘部和口中肆虐的肉欲之兽而目瞪口呆，但她们的喘息中还是混杂着某种喜悦。" voices=""/><msg @l="1860" char_id="-1" frame_id="-1" name=""   text="而且，她们开始主动伸出舌头，淫靡地扭动着下半身。" voices=""/><msg @l="1861" char_id="-1" frame_id="-1" name=""   text="这是因为真岛的调教，还是两人本就具有这种资质，已无从得知。" voices=""/><msg @l="1862" char_id="-1" frame_id="-1" name=""   text="只是……男人们的蹂躏正在逐渐掀起的愉悦浪潮，正试图将她们推向真正的「雌性」深渊，这是不争的事实。"   voices=""/><msg @l="1864" char_id="0" frame_id="-1" name="美帆"   text="『嗯嗯……不行，这样插得太深的话我……嗯呜！！』" voices="miho13010"/><msg @l="1866" char_id="1" frame_id="-1" name="玲"   text="『嗯啊……啊，啊啊……已，不行了……嗯，啊啊啊！』" voices="rei03120"/><msg @l="1868" char_id="-1" frame_id="-1" name=""   text="令人厌恶的肉棒与美帆和玲的粘膜摩擦，灼热的律动给两人带来刺激。她们已经成为了淫荡的俘虏。"   voices=""/><msg @l="1870" char_id="-1" frame_id="-1" name="真岛"   text="『这些母猪好像快高潮了。你们也把浓稠的精液全都喂给她们吧。』" voices=""/><msg @l="1872" char_id="-1" frame_id="-1" name=""   text="好嘞……我要射了，我的又浓又多……你真可能会怀孕的啊！！" voices=""/><msg @l="1874" char_id="-1" frame_id="-1" name="工作人员B"   text="『我要射满你的嘴……全都给我咽下去。』" voices=""/><msg @l="1876" char_id="-1" frame_id="-1" name="工作人员C"   text="『这边也要，射进子宫里，让你怀孕！』" voices=""/><msg @l="1878" char_id="-1" frame_id="-1" name="工作人员D"   text="『哦……要，要射了，要射了！！』" voices=""/><msg @l="1880" char_id="-1" frame_id="-1" name="工作人员E" text="『啊，啊啊啊啊啊！』"   voices=""/><msg @l="1882" char_id="0" frame_id="-1" name="美帆"   text="『呜噗……呜，呜啊……射在里面……不行，啊，会怀孕的！』" voices="miho13020"/><msg @l="1884" char_id="1" frame_id="-1" name="玲"   text="『嗯嗯嗯……啊，今……今天是危险期……啊，会怀，怀孕的……啊，啊啊啊啊啊！！』"   voices="rei03130"/><flash @l="1888" count="4" fade="100" image="white"/><wait_chgmv/><ev @l="1892" src="ev-056z1"/><msg @l="1894" char_id="0" frame_id="-1" name="美帆"   text="『呜嗯……嗯，咕……咕，咕，咕……。』" voices="miho13030"/><msg @l="1896" char_id="1" frame_id="-1" name="玲"   text="『嗯嗯嗯嗯嗯……嗯……咕……嗯嗯……咕。』" voices="rei03140"/><msg @l="1898" char_id="-1" frame_id="-1" name=""   text="强奸着两个人的男人们，以及在周围自慰的男人们，一齐洒出了大量沸腾的欲望。" voices=""/><msg @l="1899" char_id="-1" frame_id="-1" name=""   text="脸上、口中、胸部、背部、臀部、私处……各种各样的地方，都被工人们积攒已久的灼热欲液所染遍。" voices=""/><msg @l="1900" char_id="-1" frame_id="-1" name=""   text="被涂满了如同发酵般浓稠精液的雌性脸上，浮现出某种愉悦的表情。" voices=""/><msg @l="1902" char_id="-1" frame_id="-1" name="工作人员A"   text="『呼，好了，帮我们清理一下吧。』" voices=""/><msg @l="1904" char_id="-1" frame_id="-1" name="工作人员B"   text="『这边也拜托了，小姐。』" voices=""/><msg @l="1906" char_id="0" frame_id="-1" name="美帆"   text="『嗯啊……啊呣，嗯……咕啾，啾噗，啾噗，啾噗。』" voices="miho13040"/><msg @l="1908" char_id="1" frame_id="-1" name="玲"   text="『嗯呼……嗯，啾呜，啾，啾啪……啾噜噜。』" voices="rei03150"/><msg @l="1910" char_id="-1" frame_id="-1" name=""   text="遵照男人们的命令，两人在口中咽下大量白浊的污液后，浑身沾满精液和唾液，再次将舌头缠绕在散发着淫秽光泽的肉柱上开始吮吸。"   voices=""/><msg @l="1911" char_id="-1" frame_id="-1" name=""   text="已经……她们的眼神中不再浮现厌恶。" voices=""/><msg @l="1913" char_id="-1" frame_id="-1" name="工作人员F"   text="『来，轮到我们了！后面还有30个人等着呢，别磨磨蹭蹭的！！』" voices=""/><msg @l="1915" char_id="-1" frame_id="-1" name=""   text="作为雌性猪，被烙印标记的两人的命运……已经，注定了———。" voices=""/><stopbgm @l="1919" fadeout="1000"/><clear @l="1925" class="all"/><end_scene @l="1928"/><msgshow @l="1931" show="true"/><call @l="1935" target="EventLabel_43@ending05"/><return @l="1936" value="0&#13;&#10;"/><return @l="1940" value=""/></code></xscript>																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																									