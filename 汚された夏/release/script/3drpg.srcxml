"670" id="TempLabel_287"/><goto @l="671" cond="(f.act)&#32;!=&#32;(2)&#13;&#10;" label="TempLabel_290"/><eval @l="673" expr="f.x&#32;-=&#32;1&#13;&#10;"/><goto @l="675" cond="!(f.x&#32;&lt;&#32;0)&#13;&#10;" label="TempLabel_291"/><eval @l="677" expr="f.x&#32;=&#32;0&#13;&#10;"/><label @l="678" id="TempLabel_291"/><goto @l="680" label="TempLabel_289"/><label @l="682" id="TempLabel_290"/><goto @l="683" cond="(f.act)&#32;!=&#32;(3)&#13;&#10;" label="TempLabel_292"/><eval @l="685" expr="f.bx&#32;=&#32;f.map[f.y][f.x].nPrevX&#13;&#10;"/><eval @l="687" expr="f.by&#32;=&#32;f.map[f.y][f.x].nPrevY&#13;&#10;"/><eval @l="689" expr="f.x&#32;=&#32;f.bx&#13;&#10;"/><eval @l="691" expr="f.y&#32;=&#32;f.by&#13;&#10;"/><goto @l="693" label="TempLabel_289"/><label @l="696" id="TempLabel_292"/><label @l="697" id="TempLabel_289"/><label @l="700" id="TempLabel_281"/><eval @l="704" expr="f.i&#32;+=&#32;1&#13;&#10;"/><goto @l="706" label="TempLabel_252"/><label @l="707" id="TempLabel_251"/><label @l="711" id="EventLabel_1"/><msg @l="713" char_id="-1" frame_id="-1" name=""   text="忽然，从远处传来了类似什么东西的咆哮声。" voices=""/><msg @l="714" char_id="-1" frame_id="-1" name=""   text="这声音似乎随着时间的推移变得越来越大、越来越近。" voices=""/><msg @l="716" char_id="0" frame_id="-1" name="美帆" text="哈…哈…哈…"   voices=""/><msg @l="718" char_id="-1" frame_id="-1" name=""   text="我拼命地奔跑着，仿佛要逃离那个“咆哮声”。" voices=""/><msg @l="719" char_id="-1" frame_id="-1" name=""   text="然而…那声音却渐渐靠近，变得越来越大。" voices=""/><msg @l="721" char_id="0" frame_id="-1" name="美帆" text="(快点，快点——！)"   voices=""/><msg @l="723" char_id="-1" frame_id="-1" name="" text="我心急如焚，脚步却变得凌乱不堪。"   voices=""/><msg @l="724" char_id="-1" frame_id="-1" name=""   text="脚被地面上突起的石头绊住，好几次差点摔倒。" voices=""/><msg @l="725" char_id="-1" frame_id="-1" name="" text="咆哮声越来越近。"   voices=""/><msg @l="727" char_id="0" frame_id="-1" name="美帆" text="(要被追上了——！？)"   voices=""/><msg @l="729" char_id="-1" frame_id="-1" name=""   text="这种不安掠过心头，当我战战兢兢地回头看向身后的那一刻。" voices=""/><msg @l="730" char_id="-1" frame_id="-1" name="" text="它——就在那里。" voices=""/><eval @l="733" expr="f._3d_exodus&#32;=&#32;1&#13;&#10;"/><goto @l="736" label="EventLabel_3"/><label @l="739" id="EventLabel_2"/><label @l="742" id="EventLabel_3"/><return @l="745" value=""/><label @l="754" id="EventLabel_4"/><msg @l="755" char_id="-1" frame_id="-1" name=""   text="感受着黏腻湿润的空气贴在皮肤上，我缓缓前进。" voices=""/><return @l="758" value=""/><label @l="762" id="EventLabel_5"/><msg @l="763" char_id="-1" frame_id="-1" name="" text="看来我又回到了入口处。"   voices=""/><msg @l="764" char_id="-1" frame_id="-1" name="" text="必须抓紧时间……" voices=""/><return @l="766" value=""/><label @l="770" id="EventLabel_6"/><msg @l="771" char_id="-1" frame_id="-1" name="" text="左边有一条出路。" voices=""/><return @l="773" value=""/><label @l="777" id="EventLabel_7"/><msg @l="778" char_id="-1" frame_id="-1" name="" text="看来这是死路。"   voices=""/><msg @l="779" char_id="-1" frame_id="-1" name="" text="先回到岔路口吧。"   voices=""/><return @l="781" value=""/><label @l="785" id="EventLabel_8"/><msg @l="786" char_id="0" frame_id="-1" name="美帆" text="哈，哈，哈……。"   voices=""/><msg @l="788" char_id="-1" frame_id="-1" name="" text="废弃道路的尽头出现了光亮。"   voices=""/><msg @l="789" char_id="-1" frame_id="-1" name=""   text="出口可能就在眼前不远处。" voices=""/><return @l="792" value=""/><label @l="796" id="EventLabel_9"/><return @l="799" value=""/><label @l="808" id="EventLabel_10"/><return @l="810" value=""/><label @l="814" id="EventLabel_11"/><return @l="816" value=""/><label @l="820" id="EventLabel_12"/><return @l="822" value=""/><label @l="826" id="EventLabel_13"/><return @l="828" value=""/><label @l="832" id="EventLabel_14"/><return @l="834" value=""/><label @l="838" id="EventLabel_15"/><return @l="840" value=""/><label @l="844" id="EventLabel_16"/><return @l="846" value=""/><label @l="850" id="EventLabel_17"/><return @l="852" value=""/><label @l="856" id="EventLabel_18"/><return @l="858" value=""/><return @l="862" value=""/></code></xscript>																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																		