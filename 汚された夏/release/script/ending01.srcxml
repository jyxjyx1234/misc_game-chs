<?xml version="1.0" encoding="utf-8"?><xscript><debug editor="&quot;C:\Program&#32;Files&#32;(x86)\sakura\sakura.exe&quot;&#32;&quot;%src%&quot;&#32;-Y=%line%"   src="D:\シロップ\町ぐるみの罠＋汚された夏セット版\汚された夏\完成データ\汚された夏\script\text\ending01.txt"/><code><label @l="10" id="EventLabel_39"/><description @l="13" text="街妓"/><eval @l="15" expr="f.numDay=0&#13;&#10;"/><wait_chgmv/><bg @l="19" src="bg04"/><bgm @l="23" src="bgm03" volume="1."/><msg @l="25" char_id="-1" frame_id="-1" name=""   text="——在电车里朽木教授所遭受的羞辱……美帆的脑中一片空白，当场昏厥倒地。" voices=""/><msg @l="26" char_id="-1" frame_id="-1" name=""   text="当美帆醒来时，已经被带到了朽木教授的房间。而电车里的噩梦也只是换了个地方继续。" voices=""/><msg @l="27" char_id="-1" frame_id="-1" name=""   text="被监禁在朽木教授的房间里，被灌输各种取悦男人的技巧，如今已经被调教成了一个雌奴隶。" voices=""/><msg @l="28" char_id="-1" frame_id="-1" name="" text="一个月后———。" voices=""/><msg @l="29" char_id="-1" frame_id="-1" name=""   text="被释放的美帆接到朽木教授的命令，要在自己的住所经营类似性感沙龙的“工作”，接待客人。尽管被调教成雌奴隶，但接客仍让她感到抵抗。"   voices=""/><msg @l="30" char_id="-1" frame_id="-1" name=""   text="然而，由于在接受调教时被教授拍摄了淫秽照片作为威胁的素材，她已经失去了反抗的手段。" voices=""/><msg @l="31" char_id="-1" frame_id="-1" name=""   text="不，……或许堕落的美帆从一开始就没有打算反抗。" voices=""/><msg @l="32" char_id="-1" frame_id="-1" name=""   text="但是，朽木教授的指示，这份“工作”背后……有着阴谋。" voices=""/><wait_chgmv/><bg @l="35" src="bg23a"/><msg @l="39" char_id="-1" frame_id="-1" name=""   text="事实上，在这个南总町，为了解决人口减少和经济恶化的问题，正在推进将整个城镇变成巨大性欲处理场的计划。"   voices=""/><msg @l="40" char_id="-1" frame_id="-1" name=""   text="通过这个计划，被招募来的企业只要出示员工证就能免费获得性服务。作为回报，企业将为当地带来巨大的经济效益。"   voices=""/><msg @l="41" char_id="-1" frame_id="-1" name=""   text="已经有多家大企业决定进驻，城镇的各种商店和住宅中的女性们开始过上了白天一面，晚上另一面的生活……" voices=""/><msg @l="42" char_id="-1" frame_id="-1" name=""   text="美帆自己也不知道，但她已经被编入其中成为了其中一员——" voices=""/><msg @l="43" char_id="-1" frame_id="-1" name=""   text="当然，美帆不可能知道发生了什么。" voices=""/><msg @l="46" char_id="-1" frame_id="-1" name="" text="就这样过去了几个月……"   voices=""/><msg @l="47" char_id="-1" frame_id="-1" name=""   text="我按照朽木教授的指示接待客人。" voices=""/><wait_chgmv/><bg @l="51" src="bg05"/><se @l="55" buf="1" src="呼び鈴_壁越しでくぐもってる" volume="1."/><msg @l="57" char_id="-1" frame_id="-1" name="" text="房间的门铃响了。" voices=""/><msg @l="58" char_id="-1" frame_id="-1" name="" text="又有客人来寻求我的身体了。"   voices=""/><msg @l="59" char_id="-1" frame_id="-1" name=""   text="玲小姐……今天说是去参加企业说明会，大约30分钟前刚刚出门。她大概要到傍晚才会回来。当然，我对玲小姐隐瞒了这份工作。"   voices=""/><msg @l="60" char_id="-1" frame_id="-1" name=""   text="我请朽木教授安排客人在玲小姐不在的时间来访。" voices=""/><msg @l="61" char_id="-1" frame_id="-1" name=""   text="在自己的房间接待客人，在平时睡觉的床上进行“工作”，我感到相当抵触。" voices=""/><msg @l="62" char_id="-1" frame_id="-1" name=""   text="然而，很多客人强烈要求来美帆的家，说这样更有恋人的感觉，更加令人兴奋，因此几乎所有客人都希望在我的房间进行。" voices=""/><msg @l="65" char_id="0" frame_id="-1" name="美帆" text="『……请进。』"   voices="miho10790"/><msg @l="68" char_id="-1" frame_id="-1" name="" text="我去玄关迎接客人。"   voices=""/><wait_chgmv/><bg @l="72" src="bg03"/><char @l="76" id="miho" pos="auto" src="miho110"/><msg @l="78" char_id="0" frame_id="-1" name="美帆" text="『欢迎光临。』"   voices="miho10800"/><msg @l="80" char_id="-1" frame_id="-1" name="客人" text="『嘿嘿，美帆酱。今天我又来了哦。』"   voices=""/><msg @l="82" char_id="-1" frame_id="-1" name=""   text="我将即将成为客人的男人引入客厅。" voices=""/><msg @l="83" char_id="-1" frame_id="-1" name="" text="这是一位每周来三次的常客。"   voices=""/><msg @l="84" char_id="-1" frame_id="-1" name=""   text="一位四十多岁的上班族，头顶秃了，戴着像牛奶瓶底一样厚的眼镜，看起来毫不起眼。" voices=""/><msg @l="85" char_id="-1" frame_id="-1" name=""   text="他似乎曾目睹我在去大学的电车上被朽木教授猥亵的场景，从那时起就盯上了我。" voices=""/><msg @l="87" char_id="0" frame_id="-1" name="美帆"   text="『那个，这里不太方便……请到房间里来吧。』" voices="miho10810"/><msg @l="89" char_id="-1" frame_id="-1" name="客人"   text="『虽然在玄关让你穿裸体围裙的幼妻游戏也不错……但今天我想换个情境，所以去房间吧。』"   voices=""/><msg @l="91" char_id="0" frame_id="-1" name="美帆" text="『……好的。』"   voices="miho10820"/><wait_chgmv/><bg @l="95" src="bg01"/><char @l="99" id="miho" pos="auto" src="miho110"/><msg @l="101" char_id="0" frame_id="-1" name="美帆" text="『今天您要用哪一套呢？』"   voices="miho10830"/><msg @l="103" char_id="-1" frame_id="-1" name=""   text="我打开衣柜，向客人展示各种服装。" voices=""/><msg @l="104" char_id="-1" frame_id="-1" name=""   text="衣柜里整齐地摆放着我所有的“工作服”。" voices=""/><msg @l="106" char_id="-1" frame_id="-1" name="客人"   text="『今天啊，我路过学校旁边时正好在举行运动会，看到好多穿着健美裤的女孩子。一看到那样子我就想要侵犯穿健美裤的女孩子了！』"   voices=""/><msg @l="108" char_id="-1" frame_id="-1" name="客人" text="『所以，今天请你穿健美裤吧。』"   voices=""/><msg @l="110" char_id="0" frame_id="-1" name="美帆" text="『遵命。』"   voices="miho10840"/><clear @l="114" class="char"/><char @l="117" id="miho" pos="auto" src="miho186"/><msg @l="119" char_id="-1" frame_id="-1" name=""   text="我从衣柜里取出运动服和健美裤，在客人注视的目光下慢慢换上。" voices=""/><msg @l="121" char_id="-1" frame_id="-1" name="客人"   text="『每次看到都觉得很棒啊，美帆酱的身体。让人立刻就想扑上去啊。』" voices=""/><clear @l="124" class="char"/><char @l="127" id="miho" pos="auto" src="miho106"/><msg @l="129" char_id="-1" frame_id="-1" name=""   text="虽然应该早已习惯被看着换衣服，但当客人这样贪婪地用眼睛侵犯我时，还是会感到羞耻。" voices=""/><msg @l="130" char_id="-1" frame_id="-1" name=""   text="而且仅仅是被注视着…我的那里就已经溢出了大量的蜜液。" voices=""/><msg @l="132" char_id="-1" frame_id="-1" name="" text="咕啾" voices=""/><clear @l="135" class="char"/><msg @l="137" char_id="0" frame_id="-1" name="美帆" text="『那个…我已经换好了。』"   voices="miho10850"/><msg @l="139" char_id="-1" frame_id="-1" name="客人"   text="『好好，那就躺到床上去！』" voices=""/><clear @l="145" class="all"/><label @l="148" id="event_scene27"/><msg @l="150" char_id="-1" frame_id="-1" name=""   text="说完，他将换上运动服的我推倒在床上。" voices=""/><msg @l="151" char_id="-1" frame_id="-1" name=""   text="喜欢来这里的客人，无一例外都是些想要“侵犯”的人。" voices=""/><msg @l="152" char_id="-1" frame_id="-1" name=""   text="所以，我只需要把身体交给对方就可以了。" voices=""/><msg @l="153" char_id="-1" frame_id="-1" name="" text="不需要敞开心扉。" voices=""/><msg @l="154" char_id="-1" frame_id="-1" name=""   text="只要默默地敞开身体……就能让对方开心……" voices=""/><label @l="158" id="chart_line5"/><wait_chgmv/><ev @l="162" src="ev-027"/><bgm @l="166" src="bgm14" volume="1."/><msg @l="168" char_id="0" frame_id="-1" name="美帆" text="『……。』"   voices="miho10860"/><msg @l="170" char_id="-1" frame_id="-1" name=""   text="我穿着体操服，被迫大大地张开双腿。" voices=""/><msg @l="171" char_id="-1" frame_id="-1" name=""   text="透过健美裤，我能感受到他热烈的目光投向我的那里……我微微地漏出一丝喘息。" voices=""/><msg @l="172" char_id="-1" frame_id="-1" name=""   text="仅仅是被注视着，我就已经感受到甜美的快感，身体变得阵阵发热。" voices=""/><msg @l="174" char_id="-1" frame_id="-1" name="客人"   text="『美帆酱穿健美裤的样子，真不错！好可爱啊！！』" voices=""/><msg @l="176" char_id="-1" frame_id="-1" name=""   text="他把脸凑得如此之近，以至于我能感受到他的呼吸喷在我的私处上。" voices=""/><msg @l="177" char_id="-1" frame_id="-1" name=""   text="在这期间，他的指尖不断地在我的大腿上蜿蜒爬行。" voices=""/><msg @l="179" char_id="0" frame_id="-1" name="美帆" text="『谢谢……您。』"   voices="miho10870"/><msg @l="181" char_id="-1" frame_id="-1" name=""   text="感受着那沿着脊背窜过的战栗感，我的身体不禁颤抖起来，我决定任由他摆布我的身体。" voices=""/><msg @l="182" char_id="-1" frame_id="-1" name=""   text="我的蜜壶里，黏稠的液体如泉水般不断涌出溢满。" voices=""/><msg @l="184" char_id="-1" frame_id="-1" name="客人"   text="『呵呵，美帆酱的这里好热呢。而且还在动呢。』" voices=""/><msg @l="186" char_id="-1" frame_id="-1" name=""   text="客人一边这么说着，一边隔着健美裤的布料，像是确认下面的形状一样，将手指抵在上面，慢慢地施加力道。随着他手指的移动，我的私密处变得越发湿润。"   voices=""/><msg @l="188" char_id="0" frame_id="-1" name="美帆" text="『嗯……啊啊……。』"   voices="miho10190"/><msg @l="190" char_id="-1" frame_id="-1" name="客人"   text="『美帆酱真色情呢。只是稍微摸了摸这里就变得这么湿了。』" voices=""/><msg @l="192" char_id="0" frame_id="-1" name="美帆" text="『才…没…。』"   voices="miho10220"/><msg @l="194" char_id="-1" frame_id="-1" name="客人"   text="『都已经变成这样了，否认也没有说服力啊。』" voices=""/><msg @l="196" char_id="-1" frame_id="-1" name=""   text="客人一边说着下流的话，一边描摹着我的秘穴，抚弄着我饱满的女性唇瓣。" voices=""/><msg @l="197" char_id="-1" frame_id="-1" name=""   text="他用力将手指压向我的私缝，加剧着我私处的快感。" voices=""/><msg @l="198" char_id="-1" frame_id="-1" name="" text="每当这时，我的腰便会微微颤抖痉挛。"   voices=""/><msg @l="200" char_id="-1" frame_id="-1" name="客人"   text="『美帆酱，差不多该像往常一样做了吧？』" voices=""/><msg @l="202" char_id="-1" frame_id="-1" name=""   text="说着，他用指尖捏起了健美裤私处的部分。" voices=""/><msg @l="204" char_id="0" frame_id="-1" name="美帆" text="『……呃啊……。』"   voices="miho00430"/><msg @l="206" char_id="0" frame_id="-1" name="美帆" text="『那个……在桌子上。』"   voices="miho10880"/><msg @l="208" char_id="-1" frame_id="-1" name="客人" text="『哦，今天准备得不错嘛。』"   voices=""/><msg @l="210" char_id="-1" frame_id="-1" name=""   text="他在桌子上找到了想要的东西，高兴地伸出了手。" voices=""/><wait_chgmv/><ev @l="214" src="ev-027y1"/><msg @l="216" char_id="-1" frame_id="-1" name="客人"   text="『就是这个……果然还是得用这个啊。』" voices=""/><msg @l="218" char_id="-1" frame_id="-1" name=""   text="他从桌上拿起剪刀，将刀尖对准健美裤。" voices=""/><msg @l="219" char_id="-1" frame_id="-1" name=""   text="这大概是他最近的爱好……和他“做”的时候，总是这样。" voices=""/><msg @l="221" char_id="-1" frame_id="-1" name="客人" text="『那么，请保持不动哦。』"   voices=""/><msg @l="223" char_id="-1" frame_id="-1" name=""   text="他这么说着，用剪刀剪下了被捏起的健美裤。" voices=""/><msg @l="224" char_id="-1" frame_id="-1" name=""   text="最初我感到惊讶，但现在已经没什么恐惧感了。" voices=""/><msg @l="225" char_id="-1" frame_id="-1" name=""   text="相反，我对被这样逐渐暴露的兴奋感反而更加强烈。" voices=""/><msg @l="227" char_id="-1" frame_id="-1" name="" text="咔嚓，咔嚓，咔嚓……。"   voices=""/><wait_chgmv/><ev @l="231" src="ev-027y2"/><msg @l="233" char_id="0" frame_id="-1" name="美帆" text="『嗯……。』"   voices="miho10890"/><msg @l="235" char_id="-1" frame_id="-1" name=""   text="健美裤和内裤被干净利落地剪开，我的私处完全暴露在他眼前。" voices=""/><msg @l="236" char_id="-1" frame_id="-1" name=""   text="随之，他的视线也更加锐利地缠绕上来。" voices=""/><msg @l="238" char_id="-1" frame_id="-1" name="客人"   text="『哎呀哎呀，美帆酱，已经湿了吗？』" voices=""/><msg @l="240" char_id="-1" frame_id="-1" name="客人"   text="『这样的话，什么都不做可能就能进去了呢。』" voices=""/><msg @l="242" char_id="0" frame_id="-1" name="美帆" text="『不要……这样说。』"   voices="miho10900"/><msg @l="244" char_id="-1" frame_id="-1" name="客人"   text="『这样比喻，这里不是已经牵丝了吗。』" voices=""/><msg @l="246" char_id="-1" frame_id="-1" name=""   text="客人高兴地从我的蜜穴中抽出手指，展示着粘在拇指和食指之间那淫靡的丝桥。" voices=""/><msg @l="248" char_id="0" frame_id="-1" name="美帆" text="『那、那是……。』"   voices="miho10910"/><msg @l="250" char_id="0" frame_id="-1" name="美帆" text="『嗯嗯……！』"   voices="miho10230"/><msg @l="252" char_id="-1" frame_id="-1" name="客人"   text="『装作害羞也骗不了大叔我。』" voices=""/><msg @l="254" char_id="-1" frame_id="-1" name="客人"   text="『美帆酱对言语刺激很敏感这点，我可是一清二楚的哦。』" voices=""/><msg @l="256" char_id="0" frame_id="-1" name="美帆" text="『……请不要欺负我。』"   voices="miho10920"/><msg @l="258" char_id="-1" frame_id="-1" name="客人"   text="『哈哈，那么差不多该享用期待已久的主菜了吧。』" voices=""/><msg @l="260" char_id="-1" frame_id="-1" name=""   text="说着，他将粗硬的男根一口气深深地插了进来。" voices=""/><msg @l="262" char_id="0" frame_id="-1" name="美帆" text="『嗯嗯！！』"   voices="miho10930"/><msg @l="264" char_id="-1" frame_id="-1" name=""   text="狭窄的阴道内，肉棒毫不客气地撑开柔软的内壁，不断深入。" voices=""/><msg @l="265" char_id="-1" frame_id="-1" name=""   text="客人陶醉于蜜穴的紧致和融化般的肉感触感。" voices=""/><msg @l="267" char_id="-1" frame_id="-1" name="客人"   text="『美帆酱的这里一如既往地绝品啊。』" voices=""/><msg @l="269" char_id="-1" frame_id="-1" name=""   text="他高兴地说着，毫不客气地开始摆动腰部。" voices=""/><msg @l="271" char_id="0" frame_id="-1" name="美帆" text="『嗯，嗯嗯……嗯啊啊。』"   voices="miho10940"/><msg @l="273" char_id="0" frame_id="-1" name="美帆"   text="『好……好大…………啊。』" voices="miho10950"/><msg @l="275" char_id="0" frame_id="-1" name="美帆" text="『嗯……啊啊……………。』"   voices="miho10190"/><msg @l="277" char_id="-1" frame_id="-1" name="客人" text="『是吧是吧。』"   voices=""/><msg @l="279" char_id="-1" frame_id="-1" name="客人"   text="『美帆酱的小穴被大叔的东西撑得紧紧的，看起来随时都会裂开呢。』" voices=""/><msg @l="281" char_id="-1" frame_id="-1" name=""   text="男人一边津津有味地盯着泳裤的缝隙，一边高兴地说道。" voices=""/><msg @l="282" char_id="-1" frame_id="-1" name=""   text="那当然不是关心的话语……。" voices=""/><msg @l="283" char_id="-1" frame_id="-1" name=""   text="他是通过言语，在煽动我的羞耻心。" voices=""/><msg @l="285" char_id="0" frame_id="-1" name="美帆" text="『嗯啊……嗯，嗯嗯！』"   voices="miho10960"/><msg @l="287" char_id="-1" frame_id="-1" name=""   text="每当那勃起的东西深深贯穿到我体内深处时，我的意识就坠入深沉黑暗的地方。" voices=""/><msg @l="288" char_id="-1" frame_id="-1" name="" text="但是，还不够……。"   voices=""/><msg @l="289" char_id="-1" frame_id="-1" name=""   text="我的意识在最后一步之前仍紧紧抓住理性的牢笼。" voices=""/><msg @l="291" char_id="0" frame_id="-1" name="美帆" text="『嗯呜……嗯……啊呜。』"   voices="miho10970"/><msg @l="293" char_id="-1" frame_id="-1" name="客人"   text="『哎呀哎呀，美帆酱发出了这么淫荡的声音啊。』" voices=""/><msg @l="295" char_id="-1" frame_id="-1" name="客人"   text="『你发出这种不满足的声音，大叔我也不得不更加努力了啊。』" voices=""/><msg @l="297" char_id="-1" frame_id="-1" name=""   text="察觉到我的“不满足”的他，这样说着加快了腰部的律动。" voices=""/><msg @l="298" char_id="-1" frame_id="-1" name=""   text="比之前更快更深地，男根在搅动着我的肉壁。" voices=""/><msg @l="299" char_id="-1" frame_id="-1" name=""   text="像速射炮一样猛烈抽插的肉桩，正凶猛地嵌入我狭窄的阴道，仿佛要将其撑坏。" voices=""/><msg @l="301" char_id="0" frame_id="-1" name="美帆" text="『嗯，嗯，嗯，嗯嗯！』"   voices="miho10980"/><msg @l="303" char_id="0" frame_id="-1" name="美帆"   text="『嗯啊啊……嗯呜……好深，啊。』" voices="miho10990"/><msg @l="305" char_id="-1" frame_id="-1" name=""   text="在连子宫深处都能感受到的律动下，我不禁漏出热烈的喘息。" voices=""/><msg @l="306" char_id="-1" frame_id="-1" name=""   text="淫荡地扭动着腰肢，将他的前端引导至秘穴的最深处……" voices=""/><msg @l="307" char_id="-1" frame_id="-1" name=""   text="尽管如此，我仍因无法达到高潮的焦躁感而浑身颤抖。" voices=""/><msg @l="309" char_id="-1" frame_id="-1" name="声音"   text="『……看起来你似乎因无法高潮而很焦躁啊，美帆。』" voices=""/><msg @l="311" char_id="0" frame_id="-1" name="美帆" text="『啊……』"   voices="miho11000"/><msg @l="313" char_id="-1" frame_id="-1" name=""   text="从耳中隐藏的无线耳机里，传来了那熟悉的声音。" voices=""/><msg @l="315" char_id="-1" frame_id="-1" name="声音"   text="『给你个好消息。现在，白石君正乘坐公寓电梯返回房间。』" voices=""/><msg @l="317" char_id="0" frame_id="-1" name="美帆" text="『啊……』"   voices="miho10200"/><msg @l="319" char_id="-1" frame_id="-1" name="声音"   text="『如果不快点让客人高潮，白石君就会回到房间。你接客的事就会被发现了。』" voices=""/><msg @l="321" char_id="0" frame_id="-1" name="美帆" text="『怎么会……嗯，啊呜！？』"   voices="miho10300"/><msg @l="323" char_id="-1" frame_id="-1" name=""   text="仅仅听到那个声音，我的蜜穴就涌出更多爱液，紧紧地夹住贯穿其中的肉柱。" voices=""/><msg @l="325" char_id="-1" frame_id="-1" name="客人"   text="『哦……突然变紧了呢。』" voices=""/><msg @l="327" char_id="-1" frame_id="-1" name="客人" text="『这样的话，我很快就要射了。』"   voices=""/><msg @l="329" char_id="-1" frame_id="-1" name=""   text="他高兴地说着，更加猛烈地搅动着我的媚肉。" voices=""/><msg @l="330" char_id="-1" frame_id="-1" name=""   text="贯穿我的肉桩每次律动都在跳动，每跳动一次就变得更加坚硬粗大。" voices=""/><msg @l="332" char_id="0" frame_id="-1" name="美帆" text="『啊，啊，啊……嗯嗯……』"   voices="miho11010"/><msg @l="334" char_id="0" frame_id="1" name="美帆"   text="（必、必须赶快高潮…不然玲小姐就要回来了…。会被看到的…。）" voices=""/><msg @l="336" char_id="0" frame_id="1" name="美帆"   text="『要…。啊，啊啊啊…。嗯咕。』" voices="miho11020"/><msg @l="338" char_id="0" frame_id="1" name="美帆"   text="『啊啊啊，啊…。啊，啊，啊…。嗯，嗯嗯！！』" voices="miho10420"/><msg @l="340" char_id="-1" frame_id="-1" name="声音"   text="『呵呵呵…，怎么样？白石君现在正在门前开锁哦…。』" voices=""/><se @l="343" buf="1" src="鍵を開ける音" volume="1."/><msg @l="345" char_id="0" frame_id="1" name="美帆" text="『怎么会…嗯，啊呜！？』"   voices="miho10300"/><se @l="348" buf="1" src="扉を開ける音_金属" volume="1."/><msg @l="350" char_id="0" frame_id="1" name="美帆"   text="『不，不要…啊…嗯嗯！！』" voices="miho10270"/><msg @l="352" char_id="-1" frame_id="-1" name="客人" text="『美帆酱，要去了，要去了！？』"   voices=""/><msg @l="354" char_id="0" frame_id="1" name="美帆" text="『嗯——！！』"   voices="miho11030"/><msg @l="356" char_id="-1" frame_id="-1" name="客人" text="『要射了！』" voices=""/><msg @l="358" char_id="0" frame_id="1" name="美帆" text="『啊，啊啊啊！！！』"   voices="miho10540"/><msg @l="360" char_id="0" frame_id="1" name="美帆" text="『嗯，啊啊啊啊啊啊啊！！』"   voices="miho11040"/><flash @l="364" count="4" fade="100" image="white"/><wait_chgmv/><ev @l="368" src="ev-027y2z1"/><msg @l="370" char_id="-1" frame_id="-1" name=""   text="大量滚烫的欲液深深地注入了阴道深处。" voices=""/><msg @l="371" char_id="-1" frame_id="-1" name=""   text="它瞬间填满了我狭窄的子宫……白浊液体从结合处溢了出来。" voices=""/><msg @l="373" char_id="0" frame_id="1" name="美帆" text="『哈……哈………哈………。』"   voices="miho11050"/><msg @l="375" char_id="-1" frame_id="-1" name="客人"   text="『哎呀，美帆酱的那里太舒服了，所以全都射在里面了～。』" voices=""/><msg @l="377" char_id="-1" frame_id="-1" name=""   text="在我体内充分注入欲望的液体后，他这样说着，满足地笑了。" voices=""/><clear @l="383" class="all"/><msg @l="385" char_id="-1" frame_id="-1" name="声音"   text="『真是精彩的高潮啊……不过你最好赶快把那个男人赶出去吧？白石君马上就要进房间了。』" voices=""/><se @l="388" buf="3" loop="true" src="廊下を歩く音2" volume="1."/><msg @l="390" char_id="0" frame_id="1" name="美帆" text="『啊……！』" voices=""/><msg @l="392" char_id="-1" frame_id="-1" name="客人" text="『嗯？』" voices=""/><msg @l="394" char_id="0" frame_id="1" name="美帆" text="『拜托了……请快点穿好衣服。』"   voices=""/><msg @l="396" char_id="-1" frame_id="-1" name="客人" text="『怎么了……这么慌张。』"   voices=""/><msg @l="398" char_id="0" frame_id="1" name="美帆"   text="（脚步声越来越近，玲小姐要来了！）" voices=""/><msg @l="400" char_id="0" frame_id="1" name="美帆" text="『拜托，快点！』" voices=""/><msg @l="402" char_id="-1" frame_id="-1" name="客人" text="『有什么关系嘛，再来一次吧。』"   voices=""/><msg @l="404" char_id="-1" frame_id="-1" name="" text="说着，他就抱住了我的身体。"   voices=""/><msg @l="406" char_id="0" frame_id="1" name="美帆"   text="『啊，啊啊……嗯……不行……不能再继续了，嗯嗯！』" voices=""/><msg @l="408" char_id="1" frame_id="-1" name="玲"   text="『美帆—。我好像忘了点东西—』" voices=""/><msg @l="410" char_id="0" frame_id="1" name="美帆"   text="（不要，玲小姐不要过来……如果被看到这样的姿态……我，我……）" voices=""/><msg @l="412" char_id="1" frame_id="-1" name="玲" text="『你有没有看到我的记事本—。咦，美帆—？』"   voices=""/><stopse @l="416" buf="3"/><msg @l="418" char_id="-1" frame_id="-1" name=""   text="然后，脚步声在我的门前停下……门把手转动起来——" voices=""/><msg @l="420" char_id="1" frame_id="-1" name="玲" text="『美帆—，你在吗？我进来了哦—。』"   voices=""/><se @l="423" buf="1" src="ノック2" volume="1."/><msg @l="425" char_id="0" frame_id="1" name="美帆" text="『……呀……。』"   voices="miho00740"/><se @l="428" buf="1" src="部室のドア開ける" volume="1."/><msg @l="430" char_id="-1" frame_id="-1" name="" text="咔嚓" voices=""/><msg @l="432" char_id="0" frame_id="1" name="美帆" text="『不要，不要啊啊啊啊啊啊啊啊！！』"   voices="miho10750"/><stopbgm @l="436" fadeout="1000"/><clear @l="442" class="all"/><end_scene @l="445"/></code></xscript>																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																														