<?xml version="1.0" encoding="utf-8"?><xscript><debug editor="&quot;C:\Program&#32;Files&#32;(x86)\sakura\sakura.exe&quot;&#32;&quot;%src%&quot;&#32;-Y=%line%"   src="D:\シロップ\町ぐるみの罠＋汚された夏セット版\汚された夏\完成データ\汚された夏\script\text\ending09.txt"/><code><label @l="12" id="EventLabel_47"/><description @l="16" text="消失的自我"/><eval @l="18" expr="f.numDay=0&#13;&#10;"/><bgm @l="21" src="bgm14" volume="1."/><msg @l="23" char_id="-1" frame_id="-1" name=""   text="——在电车内被乘客们轮奸调教后，美帆开始每天被那时乘坐电车的乘客们指定乘坐特定的电车。"   voices=""/><msg @l="24" char_id="-1" frame_id="-1" name=""   text="那辆电车已经变成了只有痴汉爱好者乘坐的痴汉专用车厢，美帆每次乘车都会被轮奸，遭受极致的凌辱。"   voices=""/><msg @l="25" char_id="-1" frame_id="-1" name=""   text="然后她的阴道内和全身都被几十个男人的精液灌满，总是被白浊液体覆盖着。" voices=""/><stopbgm @l="29" fadeout="1000"/><clear @l="35" class="all"/><msgshow @l="37" show="true"/><wait_chgmv/><bg @l="41" src="bg18a"/><char @l="47" id="miho" pos="auto" src="miho120"/><msg @l="49" char_id="0" frame_id="-1" name="美帆" text="『……。』"   voices="miho11970"/><msg @l="51" char_id="-1" frame_id="-1" name="" text="———数周后。" voices=""/><msg @l="52" char_id="-1" frame_id="-1" name=""   text="美帆带着某种释然的心情走在车站前。" voices=""/><msg @l="53" char_id="-1" frame_id="-1" name=""   text="大学放学后，像往常一样前往车站准备乘坐回家的电车。" voices=""/><msg @l="54" char_id="-1" frame_id="-1" name=""   text="但是，美帆已经不是被谁威胁才被叫出来的了。" voices=""/><msg @l="55" char_id="-1" frame_id="-1" name=""   text="是因为忘不了被多人轮奸的快感……她是自己主动想去被痴汉的。" voices=""/><clear @l="62" class="all"/><msgshow @l="64" show="true"/><label @l="67" id="event_scene33"/><bgm @l="71" src="bgm04" volume="1."/><msg @l="73" char_id="-1" frame_id="-1" name=""   text="美帆一上电车，附近的乘客就伸手过来摸她的屁股。" voices=""/><msg @l="75" char_id="-1" frame_id="-1" name="学生" text="『哦，姐姐的屁股好软啊。』"   voices=""/><msg @l="77" char_id="-1" frame_id="-1" name=""   text="作为乘客的学生一边抱住美帆，一边用双手抚摸她。" voices=""/><msg @l="79" char_id="0" frame_id="-1" name="美帆"   text="『啊，等一下。我来脱衣服……』" voices=""/><msg @l="81" char_id="-1" frame_id="-1" name=""   text="然而，我已经不满足于仅仅被触摸，只有在众目睽睽之下于公共场所被凌辱才能感到快感，所以我开始主动脱衣服。"   voices=""/><msg @l="83" char_id="0" frame_id="-1" name="美帆"   text="『我，只有在电车里裸体被侵犯才能有感觉的……』" voices=""/><msg @l="85" char_id="-1" frame_id="-1" name=""   text="美帆说着，全身赤裸地双手撑在窗户上，翘起屁股。" voices=""/><msg @l="87" char_id="0" frame_id="-1" name="美帆"   text="『请把你那根雄壮的肉棒插进姐姐的这里。』" voices=""/><msg @l="89" char_id="-1" frame_id="-1" name="" text="美帆用手指张开秘部，用妩媚的声音说道。"   voices=""/><msg @l="91" char_id="-1" frame_id="-1" name="学生"   text="『哇，简直像做梦一样。没想到能在电车里和这么可爱的姐姐做爱。』" voices=""/><msg @l="93" char_id="-1" frame_id="-1" name=""   text="说着，学生从背后抱住美帆娇小的身体，抓住她纤细的腰肢，将肉棒埋入她的秘裂中。" voices=""/><se @l="97" buf="3" loop="true" src="電車走行中" volume="1."/><label @l="101" id="chart_line49"/><wait_chgmv/><ev @l="105" src="ev-033"/><msg @l="108" char_id="0" frame_id="-1" name="美帆" text="『嗯…啊啊……。』"   voices="miho11990"/><msg @l="110" char_id="-1" frame_id="-1" name=""   text="学生用肉棒猛烈搅动着美帆湿热的阴道内部。强壮的肉茎贯穿并撑开秘裂，发出咕啾咕啾的淫靡水声。"   voices=""/><msg @l="112" char_id="0" frame_id="-1" name="美帆" text="『嗯，嗯嗯……嗯啊啊。』"   voices="miho10940"/><msg @l="114" char_id="-1" frame_id="-1" name="学生"   text="『哇哦，太厉害了姐姐。我们相连的部位都起泡沫了，姐姐的淫液不断溢出来。』" voices=""/><msg @l="116" char_id="-1" frame_id="-1" name=""   text="插入我体内的男学生毫不顾忌周围，发出欢喜的声音。" voices=""/><msg @l="117" char_id="-1" frame_id="-1" name=""   text="其他乘客看着美帆被侵犯的样子，都在等待着轮到自己的时候。" voices=""/><msg @l="118" char_id="-1" frame_id="-1" name=""   text="还有等不及的乘客看着两人的痴态，开始抚摸我的全身，或是将自己的那话儿贴在美帆发热的肌肤上。"   voices=""/><msg @l="120" char_id="0" frame_id="-1" name="美帆"   text="『啊啊…嗯，啊，啊啊……嗯，啊呜！』" voices="miho12000"/><msg @l="122" char_id="-1" frame_id="-1" name=""   text="学生每次抽插都能看到秘裂被翻出红色嫩肉的结合部位，这使他更加兴奋，大幅度地摆动腰部，顶撞着子宫口。" voices=""/><msg @l="124" char_id="0" frame_id="-1" name="美帆" text="『啊、啊、啊……嗯嗯……。』"   voices="miho11010"/><msg @l="126" char_id="0" frame_id="-1" name="美帆"   text="『要……啊啊，啊啊啊……嗯呜。』" voices="miho11020"/><msg @l="128" char_id="-1" frame_id="1" name="学生"   text="（年长的姐姐，因为我的插入而感到舒服。）" voices=""/><msg @l="130" char_id="-1" frame_id="-1" name=""   text="学生看到美帆的反应这样想着，更加想让她感到舒服，于是舔舐着美帆白皙的肌肤，突然在她背上亲吻并用舌头舔舐。"   voices=""/><msg @l="132" char_id="0" frame_id="-1" name="美帆" text="『嗯嗯！』"   voices="miho10930"/><msg @l="134" char_id="0" frame_id="-1" name="美帆" text="『嗯，嗯嗯……嗯啊啊。』"   voices="miho10940"/><msg @l="136" char_id="-1" frame_id="1" name="学生"   text="（哇，紧紧地夹住了！我，我已经忍不住了）" voices=""/><msg @l="138" char_id="-1" frame_id="-1" name="学生"   text="『那，那个姐姐……可以射在里面吗？』" voices=""/><msg @l="140" char_id="0" frame_id="-1" name="美帆"   text="『射进来吧，把浓浓的精液全部射到里面来……。』" voices="miho12010"/><msg @l="142" char_id="-1" frame_id="-1" name="学生" text="『我要射了，要射在姐姐里面了！！』"   voices=""/><msg @l="144" char_id="0" frame_id="-1" name="美帆"   text="『嗯嗯，嗯，嗯……嗯……啊啊！』" voices="miho12020"/><msg @l="146" char_id="-1" frame_id="-1" name="学生"   text="『啊啊，啊啊……已、已经到极限了！』" voices=""/><msg @l="148" char_id="-1" frame_id="-1" name=""   text="学生发出可怜的声音，激烈地撞击着腰部。" voices=""/><msg @l="149" char_id="-1" frame_id="-1" name=""   text="双腿颤抖着……看起来随时都要射精了。" voices=""/><msg @l="151" char_id="0" frame_id="-1" name="美帆"   text="『嗯，嗯嗯……嗯……啊呜………嗯，啊啊啊啊！』" voices="miho12030"/><msg @l="153" char_id="-1" frame_id="-1" name=""   text="美帆也……想要榨取更多的精液，用肉壁紧紧地挤压着肉棒。" voices=""/><msg @l="155" char_id="-1" frame_id="-1" name="学生" text="『啊，啊啊！』" voices=""/><msg @l="157" char_id="0" frame_id="-1" name="美帆" text="『嗯嗯————！！』"   voices="miho11030"/><flash @l="161" count="4" fade="100" image="white"/><wait_chgmv/><ev @l="165" src="ev-033x1"/><msg @l="167" char_id="0" frame_id="-1" name="美帆" text="『嗯，啊啊啊啊啊啊啊！！』"   voices="miho11040"/><msg @l="169" char_id="0" frame_id="-1" name="美帆"   text="『嗯，啊，啊啊………嗯嗯…………。』" voices="miho12040"/><msg @l="171" char_id="-1" frame_id="-1" name=""   text="随着咚、咚、咚、咚、咚的声音，炽热的液体流入阴道内。感受到这股热烫精液的触感，美帆浑身颤抖着达到高潮，露出恍惚的表情，大口喘着粗气。"   voices=""/><msg @l="173" char_id="-1" frame_id="-1" name="学生"   text="『姐、姐姐也去了呢……我真高兴。』" voices=""/><msg @l="175" char_id="-1" frame_id="-1" name=""   text="看着身体微微颤抖的美帆……学生高兴地说道。" voices=""/><clear @l="181" class="all"/><msg @l="183" char_id="0" frame_id="-1" name="美帆" text="『嗯哼……下次，再来骚扰我吧。』"   voices="miho12050"/><msg @l="185" char_id="-1" frame_id="-1" name=""   text="美帆沉浸在高潮的余韵中，轻声低语道。" voices=""/><msg @l="186" char_id="-1" frame_id="-1" name=""   text="学生听到美帆的话似乎高兴地说了些什么，但美帆已经听不到他的话了。" voices=""/><msg @l="187" char_id="-1" frame_id="-1" name=""   text="因为已经有下一个男人一边揉捏着美帆的胸部舔舐着乳头，一边试图插入自己的肉棒。" voices=""/><msg @l="189" char_id="0" frame_id="-1" name="美帆"   text="（啊哈……还有十五分钟……不知道还有多少人会射在里面呢）" voices="miho12060"/><msg @l="191" char_id="-1" frame_id="-1" name=""   text="就这样，美帆在通学的电车上享受着这种游戏。" voices=""/><msg @l="192" char_id="-1" frame_id="-1" name="" text="这将会一直持续到毕业为止……"   voices=""/><stopse @l="197" buf="3"/><stopbgm @l="201" fadeout="1000"/><clear @l="207" class="all"/><end_scene @l="210"/><eval @l="214" expr="s.flagGallery=1&#13;&#10;"/><eval @l="216" expr="s.event33flag=1&#13;&#10;"/><eval @l="220"   expr="f.bEx&#32;=&#32;s.event20flag&#32;&amp;&amp;&#32;s.event23flag&#32;&amp;&amp;&#32;s.event25flag&#32;&amp;&amp;&#32;s.event30flag&#32;&amp;&amp;&#32;s.event31flag&#32;&amp;&amp;&#32;s.event32flag&#32;&amp;&amp;&#32;s.event33flag&#32;&amp;&amp;&#32;s.event35flag&#32;&amp;&amp;&#32;s.event37flag&#32;&amp;&amp;&#32;s.event38flag&#32;&amp;&amp;&#32;s.event60flag&#13;&#10;"/><goto @l="222" cond="!(f.bEx)&#13;&#10;" label="TempLabel_201"/><eval @l="224" expr="s.exRootFlag=1&#13;&#10;"/><label @l="225" id="TempLabel_201"/><ending @l="227"/><goto @l="229" cond="!(f.bEx)&#13;&#10;" label="TempLabel_202"/><wait_chgmv/><bg @l="233" src="newroot"/><wait @l="235" time="5000"/><wait_chgmv/><bg @l="237" src="black"/><label @l="240" id="TempLabel_202"/><return @l="244" value=""/></code></xscript>																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																					