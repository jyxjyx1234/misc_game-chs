<?xml version="1.0" encoding="utf-8"?><xscript><debug editor="&quot;C:\Program&#32;Files&#32;(x86)\sakura\sakura.exe&quot;&#32;&quot;%src%&quot;&#32;-Y=%line%"   src="D:\シロップ\町ぐるみの罠＋汚された夏セット版\汚された夏\完成データ\汚された夏\script\text\root_rei02.txt"/><code><label @l="12" id="EventLabel_131"/><description @l="16" text="室友的忧郁·第二天"/><eval @l="18" expr="f.numDay=8&#13;&#10;"/><msgshow @l="20" show="false"/><wait_chgmv/><bg @l="22" src="day08" time="2000"/><wait @l="24" time="500"/><wait_chgmv/><bg @l="26" src="black" time="2000"/><msgshow @l="28" show="true"/><wait_chgmv/><bg @l="32" src="bg03"/><bgm @l="36" src="bgm04" volume="1."/><char @l="40" id="miho" pos="auto" src="miho120"/><msg @l="42" char_id="0" frame_id="-1" name="美帆" text="『那么，我出门了。』"   voices=""/><clear @l="45" class="char"/><msg @l="47" char_id="-1" frame_id="-1" name=""   text="我对空无一人的客厅礼貌性地说了一声，准备出门。" voices=""/><msg @l="48" char_id="-1" frame_id="-1" name=""   text="就在这时，门开的声音响起，刚刚起床的玲走了进来。" voices=""/><msg @l="50" char_id="-1" frame_id="-1" name="" text="咔嚓" voices=""/><char @l="53" id="rei" pos="center" src="rei185f" y="-80"/><bgm @l="55" src="bgm06" volume="1."/><msg @l="57" char_id="1" frame_id="-1" name="玲" text="『……早上好……。』"   voices=""/><msg @l="59" char_id="0" frame_id="-1" name="美帆" text="『………………』"   voices=""/><msg @l="61" char_id="1" frame_id="-1" name="玲" text="『………………嗯？』"   voices=""/><msg @l="63" char_id="0" frame_id="-1" name="美帆" text="『啊！』" voices=""/><clear @l="66" class="char"/><char @l="68" id="miho" pos="left" src="miho124"/><char @l="71" id="rei" pos="right" src="rei185"/><msg @l="75" char_id="0" frame_id="-1" name="美帆"   text="『玲、玲小姐！？您怎么穿成这样！』" voices=""/><msg @l="77" char_id="1" frame_id="-1" name="玲" text="『咦……什么事？』" voices=""/><msg @l="79" char_id="-1" frame_id="-1" name="" text="玲小姐带着迷迷糊糊的睡眼回答道。"   voices=""/><char @l="82" id="miho" pos="left" src="miho024"/><msg @l="84" char_id="0" frame_id="-1" name="美帆"   text="『就是您现在的这副样子啊！总之请快点去换衣服！！』" voices=""/><msg @l="86" char_id="1" frame_id="-1" name="玲"   text="『嗯？……是说内衣的事？没关系啦，我们都是女生嘛……』" voices=""/><char @l="89" id="miho" pos="left" src="miho026"/><msg @l="91" char_id="0" frame_id="-1" name="美帆"   text="『那个，这个，不是女生不女生的问题啊！万一被别人看到了怎么办！？』" voices=""/><char @l="94" id="rei" pos="right" src="rei188"/><msg @l="96" char_id="1" frame_id="-1" name="玲"   text="『没有人看见啦～，看到的只有美帆酱而已～』" voices=""/><clear @l="99" class="char"/><char @l="101" id="rei" pos="center" src="rei181f" y="-80"/><msg @l="103" char_id="1" frame_id="-1" name="玲" text="『如果是美帆酱的话，摸一下也没关系哦～』"   voices=""/><clear @l="106" class="char"/><char @l="109" id="miho" pos="left" src="miho123"/><msg @l="111" char_id="0" frame_id="-1" name="美帆"   text="『啊哇哇！请不要擅自把别人的手按在胸上！！玲小姐，您是不是太迷糊了！？』" voices=""/><char @l="114" id="rei" pos="right" src="rei181"/><msg @l="116" char_id="1" frame_id="-1" name="玲" text="『挺大的吧？』"   voices=""/><char @l="119" id="miho" pos="left" src="miho026"/><msg @l="121" char_id="0" frame_id="-1" name="美帆" text="『快、快点回房间去吧！』"   voices=""/><msg @l="123" char_id="-1" frame_id="-1" name=""   text="我牵着玲小姐的手，把她带回房间。" voices=""/><char @l="126" id="rei" pos="right" src="rei184"/><msg @l="128" char_id="1" frame_id="-1" name="玲" text="『呀！』" voices=""/><clear @l="131" class="char"/><clear @l="137" class="all"/><msgshow @l="139" show="true"/><wait_chgmv/><bg @l="144" src="bg02"/><char @l="147" id="miho" pos="center" src="miho026f" y="-80"/><msg @l="150" char_id="0" frame_id="-1" name="美帆"   text="『总·之·请·去·换衣服！我在客厅等你。』" voices=""/><clear @l="153" class="char"/><char @l="155" id="rei" pos="auto" src="rei188"/><msg @l="157" char_id="1" frame_id="-1" name="玲" text="『知道啦～，哼哼。』"   voices=""/><msg @l="159" char_id="-1" frame_id="-1" name="" text="玲小姐看起来还是一副迷迷糊糊的样子。"   voices=""/><msg @l="160" char_id="-1" frame_id="-1" name=""   text="没想到能看到她这么孩子气的一面，真是意外。" voices=""/><clear @l="163" class="char"/><stopbgm @l="166" fadeout="1000"/><clear @l="172" class="all"/><msgshow @l="174" show="true"/><bgm @l="178" src="bgm05" volume="1."/><wait_chgmv/><bg @l="182" src="bg03"/><char @l="185" id="miho" pos="auto" src="miho126"/><msg @l="187" char_id="0" frame_id="-1" name="美帆"   text="『呼～…。玲小姐真是吓了我一跳。』" voices=""/><char @l="190" id="miho" pos="auto" src="miho023"/><msg @l="192" char_id="0" frame_id="1" name="美帆"   text="（不过，玲小姐的身材真的很好啊～…）" voices=""/><char @l="195" id="miho" pos="auto" src="miho120"/><msg @l="197" char_id="-1" frame_id="-1" name=""   text="我开始比较自己的身材和刚才看到的玲小姐的身材…" voices=""/><char @l="200" id="miho" pos="auto" src="miho125"/><msg @l="202" char_id="0" frame_id="1" name="美帆"   text="（呜～…要不要减肥呢～…）" voices=""/><bgm @l="206" src="bgm04" volume="1."/><clear @l="208" class="char"/><char @l="210" id="rei" pos="auto" src="rei030"/><msg @l="212" char_id="1" frame_id="-1" name="玲" text="『我换好衣服了……。』"   voices=""/><msg @l="214" char_id="-1" frame_id="-1" name=""   text="回到客厅的玲小姐已经换上了平常穿的吊带背心。" voices=""/><clear @l="217" class="char"/><char @l="219" id="miho" pos="left" src="miho126"/><char @l="221" id="rei" pos="right" src="rei030"/><msg @l="223" char_id="0" frame_id="1" name="美帆"   text="『话说，你为什么穿成那样？』" voices=""/><msg @l="225" char_id="1" frame_id="-1" name="玲"   text="『昨天洗完澡后，我一直在看书直到天亮……。』" voices=""/><char @l="228" id="miho" pos="left" src="miho024"/><msg @l="230" char_id="0" frame_id="1" name="美帆"   text="『从洗完澡开始…所以才只穿着内衣吗？』" voices=""/><char @l="233" id="rei" pos="right" src="rei031"/><msg @l="235" char_id="1" frame_id="-1" name="玲"   text="『是啊，那样更凉快舒服不是吗。在自己房间里又不会被谁看到。』" voices=""/><char @l="238" id="miho" pos="left" src="miho026"/><msg @l="240" char_id="0" frame_id="1" name="美帆"   text="『如果只是在自己房间里那倒没问题……。』" voices=""/><char @l="243" id="rei" pos="right" src="rei033"/><msg @l="245" char_id="1" frame_id="-1" name="玲"   text="『知道了啦，以后我会注意的。』" voices=""/><char @l="249" id="miho" pos="left" src="miho020"/><msg @l="251" char_id="0" frame_id="1" name="美帆"   text="『话说回来，您为什么要看书看到天亮呢？』" voices=""/><msg @l="253" char_id="-1" frame_id="-1" name=""   text="记得玲小姐说过她不怎么看书的。" voices=""/><char @l="256" id="rei" pos="right" src="rei030"/><msg @l="258" char_id="1" frame_id="-1" name="玲"   text="『……虽然我自己也觉得不太适合我。』" voices=""/><char @l="261" id="miho" pos="left" src="miho024"/><msg @l="263" char_id="0" frame_id="1" name="美帆" text="『发生什么事了吗？』"   voices=""/><char @l="266" id="rei" pos="right" src="rei033"/><msg @l="268" char_id="1" frame_id="-1" name="玲" text="『那个，你能不笑着听我说吗？』"   voices=""/><char @l="271" id="miho" pos="left" src="miho026"/><msg @l="273" char_id="0" frame_id="1" name="美帆" text="『我不会笑的。』"   voices=""/><char @l="276" id="rei" pos="right" src="rei031"/><msg @l="278" char_id="1" frame_id="-1" name="玲" text="『我在看面试参考书。』"   voices=""/><char @l="281" id="miho" pos="left" src="miho024"/><msg @l="283" char_id="0" frame_id="1" name="美帆"   text="『啊，这样啊……今天是面试的日子对吧。』" voices=""/><char @l="286" id="rei" pos="right" src="rei030"/><msg @l="288" char_id="1" frame_id="-1" name="玲"   text="『是的。11点在车站前的大黑建设大楼进行面试。』" voices=""/><char @l="292" id="miho" pos="left" src="miho020"/><msg @l="294" char_id="0" frame_id="1" name="美帆"   text="『大黑建设的大楼，原来在车站前啊。』" voices=""/><msg @l="296" char_id="1" frame_id="-1" name="玲"   text="『嗯……不过，公司在哪里其实都无所谓。』" voices=""/><stopbgm @l="299" fadeout="1000"/><char @l="301" id="miho" pos="left" src="miho024"/><msg @l="303" char_id="0" frame_id="1" name="美帆" text="『诶，是这样吗？』"   voices=""/><char @l="306" id="rei" pos="right" src="rei033"/><msg @l="308" char_id="1" frame_id="-1" name="玲"   text="『……无论如何，我都想进入大黑建设……』" voices=""/><char @l="311" id="miho" pos="left" src="miho126"/><msg @l="313" char_id="0" frame_id="1" name="美帆"   text="『……你对大黑建设有什么特别的情感吗？』" voices=""/><char @l="316" id="rei" pos="right" src="rei030"/><msg @l="318" char_id="1" frame_id="-1" name="玲"   text="『虽然我也想从事建筑业，但比起这个……』" voices=""/><char @l="321" id="miho" pos="left" src="miho024"/><msg @l="323" char_id="0" frame_id="1" name="美帆" text="『？』" voices=""/><bgm @l="326" src="bgm07" volume="1."/><msg @l="328" char_id="1" frame_id="-1" name="玲"   text="『……其实，稻庭先生已经收到大黑建设的内定，决定入职那里。』" voices=""/><char @l="331" id="rei" pos="right" src="rei033"/><msg @l="333" char_id="1" frame_id="-1" name="玲"   text="『我无论如何都想和稻庭先生去同一家公司……』" voices=""/><char @l="336" id="miho" pos="left" src="miho120"/><stopbgm @l="339" fadeout="1000"/><msg @l="341" char_id="0" frame_id="1" name="美帆" text="『啊……』" voices=""/><msg @l="343" char_id="0" frame_id="1" name="美帆"   text="（原来如此，所以才熬夜那么努力啊……）" voices=""/><char @l="347" id="rei" pos="right" src="rei031"/><bgm @l="350" src="bgm04" volume="1."/><msg @l="352" char_id="1" frame_id="-1" name="玲"   text="『呵呵，女人总是想和喜欢的人一直在一起的。』" voices=""/><char @l="356" id="miho" pos="left" src="miho026"/><msg @l="358" char_id="0" frame_id="1" name="美帆"   text="『嗯～，我可能做不到这样……』" voices=""/><char @l="361" id="rei" pos="right" src="rei030"/><msg @l="363" char_id="1" frame_id="-1" name="玲"   text="『现在做不到也没关系，有了喜欢的人后自然而然就会变成那样的。』" voices=""/><char @l="367" id="rei" pos="right" src="rei031"/><msg @l="369" char_id="1" frame_id="-1" name="玲"   text="『有爱的话，什么都能做到，也能变得更加努力。』" voices=""/><msg @l="371" char_id="-1" frame_id="-1" name="" text="说着这些话，玲小姐温柔地笑了。"   voices=""/><msg @l="373" char_id="0" frame_id="1" name="美帆" text="『……学、学到了。』"   voices=""/><char @l="377" id="miho" pos="left" src="miho020"/><char @l="379" id="rei" pos="right" src="rei030"/><msg @l="381" char_id="0" frame_id="1" name="美帆"   text="『不过，这样的话你更要全力以赴了吧。』" voices=""/><char @l="385" id="rei" pos="right" src="rei031"/><msg @l="387" char_id="1" frame_id="-1" name="玲"   text="『这可是关乎人生的头号志愿，我一定要拿到内定。』" voices=""/><char @l="392" id="miho" pos="left" src="miho121"/><msg @l="394" char_id="0" frame_id="1" name="美帆" text="『加油哦！我支持你。』"   voices=""/><msg @l="396" char_id="1" frame_id="-1" name="玲" text="『谢谢。』" voices=""/><msg @l="398" char_id="0" frame_id="1" name="美帆" text="『那么我要去大学了。』"   voices=""/><msg @l="400" char_id="1" frame_id="-1" name="玲" text="『嗯，路上小心。』"   voices=""/><stopbgm @l="403" fadeout="1000"/><clear @l="405" class="char"/><char @l="407" id="rei" pos="center" src="rei030f" y="-80"/><msg @l="409" char_id="1" frame_id="-1" name="玲"   text="『好，得赶紧准备，不然要迟到了……』" voices=""/><se @l="413" buf="1" src="発信音" volume="1."/><msg @l="414" char_id="-1" frame_id="-1" name=""   text="叮铃铃，叮铃铃，叮铃铃，叮铃铃" voices=""/><char @l="417" id="rei" pos="center" src="rei034f" y="-80"/><msg @l="419" char_id="1" frame_id="-1" name="玲" text="『咦，电话？』" voices=""/><msg @l="420" char_id="1" frame_id="-1" name="玲"   text="『一大早就来电话，是谁呢』" voices=""/><stopse @l="424" buf="1"/><msg @l="427" char_id="-1" frame_id="-1" name="" text="咔嚓" voices=""/><char @l="430" id="rei" pos="center" src="rei030f" y="-80"/><msg @l="432" char_id="1" frame_id="-1" name="玲" text="『喂，您好』" voices=""/><bgm @l="435" src="bgm14" volume="1."/><msg @l="437" char_id="-1" frame_id="-1" name="女人"   text="『我是大黑建设招聘负责人，小仓。』" voices=""/><char @l="440" id="rei" pos="center" src="rei034f" y="-80"/><msg @l="442" char_id="1" frame_id="-1" name="玲" text="『啊，您好！我是白石』"   voices=""/><msg @l="444" char_id="-1" frame_id="-1" name="女人"   text="『白石女士是吧。关于今天预定的面试，因为有些情况，想把时间从11点改到14点，可以吗？』"   voices=""/><msg @l="446" char_id="1" frame_id="-1" name="玲" text="『更改……时间？』"   voices=""/><msg @l="448" char_id="-1" frame_id="-1" name="女人"   text="『是的。如果给您造成不便，您可以放弃这次面试。』" voices=""/><msg @l="450" char_id="1" frame_id="-1" name="玲"   text="『不，不！时间更改没关系的！！』" voices=""/><char @l="453" id="rei" pos="center" src="rei031f" y="-80"/><msg @l="455" char_id="1" frame_id="-1" name="玲"   text="『我会在14点到达，请多关照。』" voices=""/><msg @l="457" char_id="-1" frame_id="-1" name="女人"   text="『那么，我们14点恭候您的到来。』" voices=""/><stopbgm @l="460" fadeout="1000"/><msg @l="463" char_id="-1" frame_id="-1" name="" text="嘟嘟，嘟嘟，嘟嘟"   voices=""/><char @l="466" id="rei" pos="center" src="rei034f" y="-80"/><msg @l="468" char_id="1" frame_id="-1" name="玲" text="『唉……。』"   voices=""/><char @l="471" id="rei" pos="center" src="rei030f" y="-80"/><msg @l="473" char_id="1" frame_id="-1" name="玲"   text="『……更改……。为什么会这么突然地……改时间呢……。』" voices=""/><stopbgm @l="477" fadeout="1000"/><clear @l="479" class="char"/><clear @l="485" class="all"/><msgshow @l="487" show="true"/><wait_chgmv/><bg @l="491" src="bg05"/><bgm @l="495" src="bgm04" volume="1."/><char @l="499" id="miho" pos="auto" src="miho120"/><msg @l="501" char_id="0" frame_id="1" name="美帆"   text="『玲小姐喜欢稻庭学长……。』" voices=""/><char @l="504" id="miho" pos="auto" src="miho126"/><msg @l="506" char_id="0" frame_id="1" name="美帆"   text="(感觉他们真是般配的美男美女啊。为什么还没有在一起呢？)" voices=""/><char @l="509" id="miho" pos="auto" src="miho026"/><msg @l="511" char_id="0" frame_id="1" name="美帆"   text="『说起来，我现在可没时间操心别人的事情啊。』" voices=""/><char @l="514" id="miho" pos="auto" src="miho120"/><msg @l="516" char_id="0" frame_id="1" name="美帆" text="『……。』" voices=""/><char @l="519" id="miho" pos="auto" src="miho121"/><msg @l="521" char_id="0" frame_id="1" name="美帆" text="『……我也想要个男朋友啊！』"   voices=""/><msg @l="523" char_id="-1" frame_id="-1" name=""   text="仰望着清澈的蓝天，我情不自禁地喊了出来。" voices=""/><stopbgm @l="528" fadeout="1000"/><clear @l="534" class="all"/><msgshow @l="536" show="true"/><wait_chgmv/><bg @l="540" src="bg18"/><bgm @l="544" src="bgm02" volume="1."/><char @l="548" id="rei" pos="auto" src="rei110"/><msg @l="550" char_id="-1" frame_id="-1" name="" text="刚过13点40分的时候。"   voices=""/><msg @l="551" char_id="-1" frame_id="-1" name=""   text="玲正沿着车站前的人行道朝大黑建设的大楼走去。" voices=""/><char @l="554" id="rei" pos="auto" src="rei125"/><msg @l="556" char_id="1" frame_id="-1" name="玲" text="『……果然还是有点紧张呢。』"   voices=""/><msg @l="558" char_id="-1" frame_id="-1" name=""   text="玲带着苦笑，加快脚步走向有大黑建设大楼的办公区。" voices=""/><clear @l="564" class="all"/><wait_chgmv/><bg @l="568" src="bg16"/><char @l="572" id="rei" pos="auto" src="rei113"/><msg @l="574" char_id="1" frame_id="-1" name="玲" text="『……就是这里了。』" voices=""/><msg @l="576" char_id="-1" frame_id="-1" name=""   text="在大黑建设大楼前，玲像是在抑制自己急促的心跳，小声嘀咕着。" voices=""/><msg @l="578" char_id="1" frame_id="-1" name="玲"   text="『13点50分……面试开始前10分钟啊。』" voices=""/><stopbgm @l="581" fadeout="1000"/><msg @l="583" char_id="-1" frame_id="-1" name="稻庭" text="『咦，是玲吧？』"   voices=""/><char @l="586" id="rei" pos="auto" src="rei114"/><msg @l="588" char_id="1" frame_id="-1" name="玲" text="『啊！？』" voices=""/><clear @l="591" class="char"/><char @l="593" id="rei" pos="left" src="rei024"/><char @l="595" id="inaba" pos="right" src="inaba010"/><msg @l="597" char_id="1" frame_id="-1" name="玲" text="『稻庭先生！你怎么在这种地方。』"   voices=""/><msg @l="599" char_id="-1" frame_id="-1" name="稻庭"   text="『今天这里有内定者的培训，所以我被叫来了。』" voices=""/><bgm @l="602" src="bgm05" volume="1."/><msg @l="604" char_id="-1" frame_id="-1" name="稻庭" text="『话说回来，玲为什么会在这里？』"   voices=""/><char @l="607" id="rei" pos="left" src="rei021"/><msg @l="609" char_id="1" frame_id="-1" name="玲" text="『我是来面试的。』" voices=""/><msg @l="611" char_id="-1" frame_id="-1" name="稻庭"   text="『是这样啊。那就加油吧。如果你能拿到内定的话，毕业后我们还能在一起呢。』" voices=""/><msg @l="613" char_id="-1" frame_id="-1" name=""   text="稻庭露出能让世上所有女性都为之倾倒的清爽笑容，如此说道。" voices=""/><char @l="616" id="rei" pos="left" src="rei013"/><msg @l="618" char_id="1" frame_id="-1" name="玲" text="『啊…啊啊！是啊！』"   voices=""/><msg @l="620" char_id="-1" frame_id="-1" name="" text="玲被稻庭的笑容弄得脸颊泛红，高兴地点着头。"   voices=""/><char @l="623" id="rei" pos="left" src="rei111"/><msg @l="625" char_id="1" frame_id="-1" name="玲" text="『那我去了哦。』"   voices=""/><msg @l="627" char_id="-1" frame_id="-1" name=""   text="玲与稻庭告别，轻快地走向面试会场。" voices=""/><stopbgm @l="631" fadeout="1000"/><clear @l="637" class="all"/><msgshow @l="639" show="true"/><se @l="643" buf="1" src="自動ドアの音" volume="1."/><msg @l="645" char_id="1" frame_id="-1" name="玲"   text="『那个，我是预约今天下午2点面试的白石。』" voices=""/><msg @l="647" char_id="-1" frame_id="-1" name="前台小姐" text="『面试吗……？』"   voices=""/><msg @l="648" char_id="-1" frame_id="-1" name="前台小姐"   text="『今天除了上午11点的面试，没有其他面试安排……。』" voices=""/><msg @l="650" char_id="1" frame_id="-1" name="玲"   text="『啊？可，可是今天早上贵公司联系我说要更改面试时间的……。』" voices=""/><msg @l="652" char_id="-1" frame_id="-1" name="前台小姐" text="『更改时间的联系吗？』"   voices=""/><msg @l="654" char_id="-1" frame_id="-1" name=""   text="前台小姐正在查看手边的访客预约表确认情况。" voices=""/><msg @l="656" char_id="-1" frame_id="-1" name="前台小姐"   text="『啊，您就是早上我们打电话联系的那位吧。』" voices=""/><msg @l="658" char_id="-1" frame_id="-1" name="前台小姐"   text="『我这就联系人事部，请您稍等片刻。』" voices=""/><msg @l="660" char_id="1" frame_id="-1" name="玲" text="『啊，好的。』" voices=""/><msg @l="662" char_id="-1" frame_id="-1" name="" text="前台小姐拿起了电话听筒。"   voices=""/><msg @l="664" char_id="-1" frame_id="-1" name="前台小姐"   text="『有一位来参加个人面试的人已经到了。』" voices=""/><msg @l="666" char_id="-1" frame_id="-1" name="前台小姐" text="『是的……是的……。』"   voices=""/><msg @l="668" char_id="1" frame_id="1" name="玲" text="（……？个人面试……？）"   voices=""/><msg @l="669" char_id="-1" frame_id="1" name=""   text="（明明还是一次面试却是个人面试……？）" voices=""/><msg @l="670" char_id="-1" frame_id="1" name=""   text="（这家公司除了最终面试以外，不是都是集体面试吗……）" voices=""/><msg @l="671" char_id="-1" frame_id="-1" name="前台小姐"   text="『明白了……那么，我这就带她过去。』" voices=""/><msg @l="673" char_id="-1" frame_id="-1" name=""   text="前台小姐放下听筒，微笑着说道。" voices=""/><msg @l="675" char_id="-1" frame_id="-1" name="前台小姐"   text="『让您久等了。现在我将带您前往接待室。』" voices=""/><msg @l="677" char_id="1" frame_id="1" name="玲" text="『好的！请多关照。』"   voices=""/><msg @l="679" char_id="1" frame_id="1" name="玲"   text="（……也许，他们对我有期待……）" voices=""/><msg @l="681" char_id="1" frame_id="1" name="玲" text="（这是个展示自己的机会！）"   voices=""/><msg @l="683" char_id="1" frame_id="1" name="玲"   text="（……为了能和稻庭先生进入同一家公司，我一定要拿到内定！）" voices=""/><clear @l="689" class="all"/><msgshow @l="691" show="true"/><bgm @l="693" src="bgm21" volume="1."/><wait_chgmv/><bg @l="697" src="bg17m1"/><msg @l="699" char_id="-1" frame_id="-1" name="前台小姐"   text="『走到尽头就是接待室。』" voices=""/><char @l="703" id="rei" pos="auto" src="rei011"/><msg @l="705" char_id="1" frame_id="1" name="玲" text="『好的，谢谢您。』"   voices=""/><msg @l="707" char_id="-1" frame_id="-1" name=""   text="前台小姐点头示意后，回到了前台。" voices=""/><char @l="710" id="rei" pos="auto" src="rei123"/><msg @l="712" char_id="1" frame_id="1" name="玲" text="『……走到尽头就是接待室对吧。』"   voices=""/><msg @l="714" char_id="-1" frame_id="-1" name=""   text="她深呼一口气缓解紧张，向接待室走去。" voices=""/><clear @l="718" class="char"/><msg @l="720" char_id="-1" frame_id="-1" name=""   text="就在玲这样走着的时候……办公室的一角，一位体格魁梧的男子正注视着她。" voices=""/><stopbgm @l="724" fadeout="1000"/><msg @l="726" char_id="-1" frame_id="-1" name="？？？" text="『……。』" voices=""/><msg @l="728" char_id="-1" frame_id="-1" name=""   text="那目光，是一种对猎物期待已久的欲望的注视。" voices=""/><msg @l="729" char_id="-1" frame_id="-1" name=""   text="然而，被注视着的玲完全没有察觉，就这样消失在了接待室里。眼中闪烁着欲望的男子见玲进入接待室后，嘴角浮现出一丝奸笑，随后也朝着接待室走去。"   voices=""/><clear @l="737" class="all"/><label @l="740" id="event_scene06"/><msgshow @l="743" show="true"/><bgm @l="747" src="bgm03" volume="1."/><label @l="751" id="chart_line7"/><wait_chgmv/><ev @l="755" src="ev-006a"/><description @l="758" text="一次面接Ａ"/><msg @l="760" char_id="-1" frame_id="-1" name=""   text="两位身着高级西装的男子走进了接待室。他们像是在观察猎物一般，一言不发地打量着玲。"   voices=""/><msg @l="761" char_id="-1" frame_id="-1" name=""   text="在长时间的沉默之后，第一个问题终于开始了。" voices=""/><msg @l="763" char_id="-1" frame_id="-1" name="面试官"   text="『那么，先从自我介绍开始吧。』" voices=""/><msg @l="765" char_id="1" frame_id="1" name="玲" text="『啊，好的。』"   voices="rei00760"/><msg @l="767" char_id="1" frame_id="1" name="玲" text="『我是白石玲，现在是大学四年级学生。』"   voices="rei00770"/><msg @l="769" char_id="-1" frame_id="-1" name="面试官"   text="『那么玲小姐是明年三月毕业，对吧？』" voices=""/><msg @l="771" char_id="1" frame_id="1" name="玲" text="『是的。』"   voices="rei00780"/><msg @l="773" char_id="-1" frame_id="-1" name="面试官"   text="『那么，您知道我们公司关于应届女性录用的事宜吧？』" voices=""/><msg @l="775" char_id="1" frame_id="1" name="玲" text="『啊，是的。』"   voices="rei00760"/><msg @l="777" char_id="-1" frame_id="-1" name="面试官"   text="『那就好办了。我们公司只招聘能够长期工作的女性员工。』" voices=""/><msg @l="779" char_id="-1" frame_id="-1" name="面试官"   text="『因为女性员工往往会出现各种问题。』" voices=""/><msg @l="781" char_id="1" frame_id="1" name="玲" text="『问题……吗？』"   voices="rei00810"/><msg @l="783" char_id="-1" frame_id="-1" name="面试官"   text="『是的……首先，结婚后辞职的女性非常多。』" voices=""/><msg @l="785" char_id="-1" frame_id="-1" name="面试官"   text="『在她们刚刚掌握了业务知识，正准备成为战力时离开，这对我们来说非常困扰。』" voices=""/><msg @l="787" char_id="1" frame_id="1" name="玲" text="『原来如此……』"   voices="rei00820"/><msg @l="789" char_id="-1" frame_id="-1" name="面试官"   text="『第二，很多女性拒绝加班或者不愿意去现场。』" voices=""/><msg @l="791" char_id="-1" frame_id="-1" name="面试官"   text="『嘛，婚后退职也许无法避免，但拒绝公司的工作就令人困扰了。』" voices=""/><msg @l="793" char_id="1" frame_id="1" name="玲" text="『……。』"   voices="rei00830"/><msg @l="795" char_id="1" frame_id="1" name="玲"   text="『也就是说，为了避免这些问题，贵公司减少了女性员工的雇用数量？』" voices="rei00840"/><msg @l="797" char_id="-1" frame_id="-1" name="面试官"   text="『是的。除此之外，受经济不景气的影响，我们也在整体上严格筛选应聘者。』" voices=""/><msg @l="798" char_id="-1" frame_id="-1" name="面试官"   text="『实际上，来我们公司参加招聘考试的女性今年也有2000多名，但其中只录用1名。』"   voices=""/><msg @l="800" char_id="1" frame_id="1" name="玲"   text="『是吗……虽然能理解，但确实很严格啊。』" voices="rei00850"/><msg @l="802" char_id="-1" frame_id="-1" name="面试官"   text="『是啊。我们公司也希望入职的人能担负起公司的未来，所以在录用上非常谨慎。』" voices=""/><msg @l="804" char_id="-1" frame_id="-1" name=""   text="体格魁梧的面试官夸张地笑了起来。" voices=""/><msg @l="805" char_id="-1" frame_id="-1" name=""   text="面试官笑的时候，即使是松软的沙发也发出吱吱的讨厌声音。" voices=""/><msg @l="807" char_id="1" frame_id="1" name="玲"   text="『我即使结婚也不打算辞职。』" voices="rei00860"/><msg @l="809" char_id="1" frame_id="1" name="玲"   text="『至于结婚本身……现在还没有考虑过。』" voices="rei00870"/><msg @l="811" char_id="-1" frame_id="-1" name="面试官" text="『原来如此。』" voices=""/><msg @l="813" char_id="-1" frame_id="-1" name=""   text="就在那一瞬间，面试官眼底深处燃起了欲望的火焰，并狡黠地笑了。" voices=""/><bgm @l="816" src="bgm09" volume="1."/><msg @l="818" char_id="-1" frame_id="-1" name="面试官"   text="『不过……女性往往容易改变主意呢。』" voices=""/><msg @l="820" char_id="1" frame_id="1" name="玲" text="『啊……。』"   voices="rei00880"/><msg @l="822" char_id="-1" frame_id="-1" name="面试官"   text="『但请您不要担心。我已经在笔试报告中看到了白石小姐的热情。』" voices=""/><msg @l="824" char_id="-1" frame_id="-1" name="面试官"   text="『从报告中我感受到了与其他应聘者不同的热情，所以今天特别为白石小姐安排了个人面试。』" voices=""/><msg @l="826" char_id="-1" frame_id="-1" name="面试官"   text="『不过，仅凭热情还无法衡量您是否适合我们公司。如果您真的很想在我们公司工作，我们可以为您进行一次特别的招聘考试，您意下如何？』"   voices=""/><msg @l="828" char_id="1" frame_id="1" name="玲"   text="『是的，如果有考试的话请一定让我参加。』" voices="rei00890"/><msg @l="830" char_id="-1" frame_id="-1" name="面试官"   text="『我明白了。但是，这个特别考试是为了测试您是否能长期工作，以及是否能灵活地适应公司的要求，所以会非常严格哦。』"   voices=""/><msg @l="832" char_id="-1" frame_id="-1" name="面试官" text="『即便如此，您还要参加吗？』"   voices=""/><msg @l="834" char_id="1" frame_id="1" name="玲" text="『啊，好的。』"   voices="rei00760"/><msg @l="836" char_id="-1" frame_id="-1" name="面试官"   text="『是吗！那我们现在就开始吧。』" voices=""/><msg @l="838" char_id="1" frame_id="1" name="玲" text="『啊……现在吗？』"   voices="rei00900"/><msg @l="840" char_id="-1" frame_id="-1" name="面试官"   text="『啊，您也可以不参加。不过这种机会可不会再有第二次哦』" voices=""/><msg @l="842" char_id="1" frame_id="1" name="玲"   text="『不，我不是那个意思……只是我没做什么准备。』" voices="rei00910"/><msg @l="844" char_id="-1" frame_id="-1" name="面试官"   text="『啊，不不。不需要特别准备什么。』" voices=""/><msg @l="846" char_id="-1" frame_id="-1" name="面试官"   text="『白石小姐只需要坐在那里就可以了。』" voices=""/><msg @l="848" char_id="1" frame_id="1" name="玲"   text="『哦，如果是这样的话我没问题。』" voices="rei00920"/><msg @l="850" char_id="-1" frame_id="-1" name="面试官" text="『那么，我们开始吧。』"   voices=""/><wait_chgmv/><ev @l="854" src="ev-006b"/><msg @l="856" char_id="-1" frame_id="-1" name=""   text="说着，体格魁梧的面试官在玲旁边坐了下来，另一个人则站在沙发后面。" voices=""/><msg @l="858" char_id="1" frame_id="1" name="玲"   text="『那个……不是要进行实地检查吗？』" voices="rei00930"/><msg @l="860" char_id="-1" frame_id="-1" name="面试官" text="『是啊，这就是实地检查啊？』"   voices=""/><msg @l="862" char_id="1" frame_id="1" name="玲" text="『这就是……吗？』"   voices="rei00940"/><msg @l="864" char_id="-1" frame_id="-1" name="面试官"   text="『是的。现在的女性中有些人会把肢体接触大肆宣扬成性骚扰，破坏公司的氛围。』" voices=""/><msg @l="866" char_id="-1" frame_id="-1" name="面试官"   text="『为了长期共事，我们需要能接受肢体接触的女性，所以要检查一下您的忍耐力如何。』"   voices=""/><msg @l="868" char_id="1" frame_id="1" name="玲" text="『啊，忍耐力是……』"   voices="rei00950"/><wait_chgmv/><ev @l="872" src="ev-006bx3y2"/><msg @l="874" char_id="1" frame_id="1" name="玲" text="『啊，您在做什么……』"   voices="rei00960"/><msg @l="876" char_id="-1" frame_id="-1" name=""   text="面试官的手抚摸着玲从紧身裙下伸出的白皙大腿。" voices=""/><msg @l="877" char_id="-1" frame_id="-1" name=""   text="玲想要挣脱，但又立刻停住了手。" voices=""/><msg @l="878" char_id="-1" frame_id="-1" name=""   text="如果在这里表现出不好的态度，好不容易得到的特别面试机会就会泡汤。" voices=""/><msg @l="879" char_id="-1" frame_id="-1" name=""   text="如果那样的话，和稻庭一起进同一家公司的梦想就会破灭……。" voices=""/><msg @l="881" char_id="-1" frame_id="-1" name="面试官"   text="『呵呵……不愧是“玲小姐”。您那坚忍的性格从以前到现在都没有变啊。』" voices=""/><stopbgm @l="885" fadeout="1000"/><wait_chgmv/><ev @l="887" src="ev-006b"/><msg @l="889" char_id="1" frame_id="1" name="玲" text="『欸……？』"   voices="rei01140"/><msg @l="891" char_id="-1" frame_id="-1" name="面试官"   text="『您这表情，是在疑惑为什么我会知道您过去的事情吧。』" voices=""/><msg @l="893" char_id="-1" frame_id="-1" name="大黑"   text="『呵呵呵……你可能不记得了，我是高中时和你同班的大黑满彦（大黑光彦）。』"   voices=""/><msg @l="895" char_id="1" frame_id="1" name="玲" text="『……！？』"   voices="rei01010"/><msg @l="897" char_id="-1" frame_id="-1" name="" text="玲对大黑的话感到震惊。"   voices=""/><msg @l="898" char_id="1" frame_id="1" name="玲" text="（大、大黑？是谁……？）"   voices=""/><msg @l="899" char_id="-1" frame_id="-1" name=""   text="她拼命地试图回忆高中时代的事情。但可能因为印象不深，一时难以想起来。" voices=""/><msg @l="901" char_id="1" frame_id="1" name="玲"   text="（不过如果真的是同学的话，聊聊往事或许能让面试更有利）" voices=""/><msg @l="903" char_id="-1" frame_id="-1" name=""   text="玲本想为这偶然相遇感到高兴，但这期待很快就被接下来的话语所背叛。" voices=""/><bgm @l="906" src="bgm15" volume="1."/><msg @l="908" char_id="-1" frame_id="-1" name="大黑"   text="『玲小姐现在依然很美丽，以前也很漂亮呢。我曾经仰慕您，还给您写过信……』" voices=""/><msg @l="910" char_id="-1" frame_id="-1" name="大黑"   text="『结果被彻底拒绝了……而且还在众人面前把信读出来……让我成了笑柄……真的很痛苦啊。』"   voices=""/><msg @l="912" char_id="1" frame_id="1" name="玲" text="『……！？』"   voices="rei01010"/><msg @l="914" char_id="1" frame_id="1" name="玲" text="『那、那是……。』"   voices="rei01070"/><msg @l="916" char_id="-1" frame_id="-1" name=""   text="她本想说那是误会，但大黑打断了她。" voices=""/><msg @l="918" char_id="-1" frame_id="-1" name="大黑"   text="『不过，现在与过去立场已经不同了！从前是您做选择的一方，而现在是我做选择的一方了。……世事难料啊。』"   voices=""/><msg @l="920" char_id="1" frame_id="1" name="玲" text="『………。』"   voices="rei00980"/><msg @l="922" char_id="-1" frame_id="-1" name=""   text="大黑完全误会了。确实，高中时期收到过很多情书的记忆是有的。但是，没有拿给别人看让人出丑的记忆，也不可能做那种事。"   voices=""/><msg @l="923" char_id="-1" frame_id="-1" name=""   text="……然而，由于玲仍然想不起大黑是谁，无法清楚地解释情况，此刻只能对大黑的话语保持沉默。"   voices=""/><msg @l="925" char_id="-1" frame_id="-1" name="大黑"   text="『啊，回忆过去的话说得太多了。我们回到检查上来吧？』" voices=""/><wait_chgmv/><ev @l="928" src="ev-006bx3y2"/><msg @l="930" char_id="-1" frame_id="-1" name=""   text="大黑嘴角扭曲露出奸笑，从玲的膝盖一直到大腿缓慢而粘腻地抚摸着。" voices=""/><msg @l="932" char_id="1" frame_id="1" name="玲" text="『……唔……。』"   voices="rei00990"/><msg @l="934" char_id="-1" frame_id="-1" name="大黑"   text="『不过，看到玲小姐的履历表时我真是吃了一惊。简直像是命运的安排一样。』" voices=""/><msg @l="936" char_id="-1" frame_id="-1" name=""   text="大黑一脸高兴的样子，黏黏糊糊地触摸着她白皙的腿。" voices=""/><msg @l="937" char_id="-1" frame_id="-1" name=""   text="玲虽然想不起大黑给她写过的情书，但她很确信自己从未对任何人做过他所说的那种事。" voices=""/><msg @l="938" char_id="-1" frame_id="-1" name=""   text="所以她相信面试结束后去找大黑先生，真心诚意地解释清楚，他一定会理解的。" voices=""/><msg @l="939" char_id="-1" frame_id="-1" name=""   text="否则，如果就这样被误解下去，很可能会被面试淘汰。因此玲现在只能忍受着被做的一切，祈祷面试能早点结束。"   voices=""/><msg @l="941" char_id="-1" frame_id="-1" name=""   text="然而，仿佛是在背叛玲的期望一般，大黑继续用他那黏腻的手抚摸着她细腻白皙的腿。" voices=""/><msg @l="943" char_id="-1" frame_id="-1" name="大黑"   text="『呵呵呵呵……做梦也没想到会有这么一天，能够触碰“玲小姐”这美丽的腿。』" voices=""/><msg @l="945" char_id="1" frame_id="1" name="玲" text="『……。』"   voices="rei01020"/><msg @l="947" char_id="-1" frame_id="-1" name="大黑"   text="『玲小姐。到目前为止，您让多少男人碰过这肌肤呢？』" voices=""/><msg @l="949" char_id="1" frame_id="1" name="玲" text="『……。』"   voices="rei01020"/><msg @l="951" char_id="-1" frame_id="-1" name="" text="玲只是默默忍耐着。"   voices=""/><wait_chgmv/><ev @l="954" src="ev-006b"/><msg @l="956" char_id="-1" frame_id="-1" name="大黑"   text="『嗯，看来是太紧张了无法回答问题呢。不过，面试中这种情况很常见。』" voices=""/><msg @l="958" char_id="-1" frame_id="-1" name="大黑"   text="『通常我们不会这样做，但为了我仰慕的玲小姐。让我用特别的方式帮您缓解紧张吧。』" voices=""/><msg @l="960" char_id="1" frame_id="1" name="玲" text="『诶……？』"   voices="rei01140"/><msg @l="962" char_id="-1" frame_id="-1" name="大黑"   text="『喂，高桥……为了缓解紧张，去揉一揉玲小姐的胸部吧。』" voices=""/><wait_chgmv/><ev @l="966" src="ev-006bx3y3"/><msg @l="968" char_id="-1" frame_id="-1" name=""   text="大黑这么一说，玲身后的面试官就抓住了玲的乳房，开始隔着西装揉搓那即使隔着衣服也能看出很大的胸部。"   voices=""/><msg @l="970" char_id="1" frame_id="1" name="玲" text="『啊，你在干什么……。』"   voices="rei00960"/><msg @l="972" char_id="-1" frame_id="-1" name="大黑"   text="『哦，这不是已经放松下来能出声了吗。』" voices=""/><msg @l="974" char_id="1" frame_id="1" name="玲" text="『…………。』"   voices="rei00990"/><msg @l="976" char_id="-1" frame_id="-1" name="高桥"   text="『喂！大黑先生这么照顾你，连谢谢都不会说吗！』" voices=""/><msg @l="978" char_id="1" frame_id="1" name="玲" text="『……。』"   voices="rei01020"/><msg @l="980" char_id="1" frame_id="1" name="玲" text="『…谢、谢谢您。』"   voices="rei01000"/><msg @l="982" char_id="-1" frame_id="-1" name="大黑"   text="『呵呵呵，竟然能得到玲小姐的道谢。在高中时代连想象都不敢想呢。』" voices=""/><msg @l="984" char_id="-1" frame_id="-1" name="大黑"   text="『那么，虽然想继续进行检查，但到此为止吧。』" voices=""/><wait_chgmv/><ev @l="987" src="ev-006b"/><msg @l="989" char_id="1" frame_id="1" name="玲" text="『诶……？』"   voices="rei01140"/><msg @l="991" char_id="1" frame_id="1" name="玲" text="『…谢、谢谢您。』"   voices="rei01000"/><stopbgm @l="995" fadeout="1000"/><msg @l="997" char_id="-1" frame_id="-1" name=""   text="玲终于以为自己能从这场性骚扰面试中解脱出来，不由松了一口气。然而，她松懈的时间只是短暂的，大黑随即告知了她一个无情的消息。"   voices=""/><msg @l="999" char_id="-1" frame_id="-1" name="大黑"   text="『但是，检查并不只有这些哦。』" voices=""/><msg @l="1001" char_id="1" frame_id="1" name="玲" text="『诶……？』"   voices="rei01140"/><msg @l="1003" char_id="1" frame_id="1" name="玲" text="『……还有什么吗？』"   voices="rei01030"/><msg @l="1005" char_id="-1" frame_id="-1" name="大黑"   text="『今天为了庆祝与玲小姐的重逢，我亲自准备了特别的检查。』" voices=""/><msg @l="1006" char_id="-1" frame_id="-1" name="大黑"   text="『今天早上，突然更改了面试时间吧？那是我的指示。为了能够彻底检查玲小姐，需要时间准备各种事项。』"   voices=""/><msg @l="1008" char_id="-1" frame_id="-1" name="大黑"   text="『玲小姐无论如何都想得到我们公司的内定吧？那么接下来的检查，也最好接受一下……。』"   voices=""/><msg @l="1010" char_id="1" frame_id="1" name="玲" text="『………。』"   voices="rei01020"/><msg @l="1012" char_id="-1" frame_id="-1" name=""   text="玲从大黑的话语中感受到了阴暗的意图，但她认为如果现在退出肯定会被刷下来。那样的话，与稻庭在同一家公司工作的梦想就会破灭。"   voices=""/><msg @l="1013" char_id="-1" frame_id="-1" name=""   text="而且，她相信大黑进行这种性骚扰面试也一定是因为误会，只要解开误会就能变成正常的面试，她怀着这样的希望。"   voices=""/><msg @l="1014" char_id="-1" frame_id="-1" name=""   text="所以，她决定再忍耐一下，创造解开误会的机会，于是决定继续接受检查。" voices=""/><msg @l="1016" char_id="1" frame_id="1" name="玲" text="『……我明白了。』"   voices="rei01740"/><msg @l="1018" char_id="-1" frame_id="-1" name=""   text="但是此时的玲，无法察觉到大黑眼底闪烁着的巨大复仇之火。" voices=""/><clear @l="1024" class="all"/><end_scene @l="1027"/><bgm @l="1029" src="bgm09" volume="1."/><msg @l="1031" char_id="-1" frame_id="-1" name="" text="大黑和高桥从沙发上站了起来。"   voices=""/><msg @l="1033" char_id="-1" frame_id="-1" name="大黑" text="『那么，开始下一项检查吧。』"   voices=""/><msg @l="1035" char_id="-1" frame_id="-1" name="大黑"   text="『直接开始，请脱掉衣服。』" voices=""/><msg @l="1037" char_id="1" frame_id="1" name="玲" text="『……啊？』" voices=""/><msg @l="1039" char_id="-1" frame_id="-1" name=""   text="玲不明白大黑话语的含义，不由自主地请他重复一遍。" voices=""/><msg @l="1041" char_id="-1" frame_id="-1" name="大黑"   text="『没听清吗？请脱掉衣服。』" voices=""/><msg @l="1043" char_id="1" frame_id="1" name="玲"   text="『为、为什么要做这种羞耻的事情！？』" voices=""/><msg @l="1045" char_id="-1" frame_id="-1" name="大黑"   text="『羞耻的事情？请别误会了。这也是正规检查的一部分。』" voices=""/><msg @l="1047" char_id="1" frame_id="1" name="玲" text="『这种检查太奇怪了……。』"   voices=""/><msg @l="1049" char_id="-1" frame_id="-1" name=""   text="玲本想稍后向大黑解释，但因为检查内容太过分，不由自主地说了出来。" voices=""/><msg @l="1051" char_id="1" frame_id="1" name="玲"   text="『求求您停下吧。刚才您说我把高中时收到的信给大家看了，但我没有做过这种事。这是误会！』"   voices=""/><msg @l="1053" char_id="1" frame_id="1" name="玲"   text="『拜托了，请回到正常的面试上来……。』" voices=""/><msg @l="1055" char_id="-1" frame_id="-1" name="大黑"   text="『不知道玲小姐误会了什么，但过去的事情和这次检查的内容没有任何关系。』" voices=""/><msg @l="1057" char_id="-1" frame_id="-1" name=""   text="虽然这么说着，大黑内心却燃起了强烈的怒火。" voices=""/><msg @l="1058" char_id="-1" frame_id="-1" name=""   text="对玲来说，那件事是如此无关紧要，以至于她都记不起来了吗……。" voices=""/><msg @l="1059" char_id="-1" frame_id="-1" name=""   text="那就让她永远忘不了自己，他决心要尽情凌辱她。" voices=""/><msg @l="1060" char_id="-1" frame_id="-1" name=""   text="但是，现在就侵犯她未免太无趣了。必须让她自己主动做出羞耻的行为，自愿提供自己的身体。"   voices=""/><msg @l="1061" char_id="-1" frame_id="-1" name=""   text="为此，需要逐步提高检查的难度。大黑这样想着，给出了一个让玲能够接受的回答。" voices=""/><msg @l="1063" char_id="-1" frame_id="-1" name="大黑"   text="『听好了……我们公司在工作时，不想因为是男性还是女性而有所区别对待。』" voices=""/><msg @l="1065" char_id="-1" frame_id="-1" name="大黑"   text="『也就是说，为了平等工作，不应该用男人、女人这种观点来看待同事。』" voices=""/><msg @l="1067" char_id="1" frame_id="1" name="玲"   text="『这和这次检查有什么关系啊……』" voices=""/><msg @l="1069" char_id="-1" frame_id="-1" name="大黑"   text="『玲小姐在换衣服时，在同性面前穿着内衣也不会在意吧？』" voices=""/><msg @l="1071" char_id="1" frame_id="1" name="玲"   text="『嗯……那个，嘛…………』" voices=""/><msg @l="1073" char_id="-1" frame_id="-1" name="大黑"   text="『这是同样的道理，为了能把公司的男性视为同性而非异性，我们需要您穿着内衣在公司走动，以适应周围的目光。』"   voices=""/><msg @l="1075" char_id="1" frame_id="1" name="玲" text="『这、这种事我做不到……。』"   voices=""/><msg @l="1077" char_id="-1" frame_id="-1" name="大黑"   text="『啊，我不是说要勉强您。您当然可以在这里停止。』" voices=""/><msg @l="1079" char_id="-1" frame_id="-1" name="大黑"   text="『只是，如果现在放弃的话，检查就到此为止了，也就意味着您与我们公司无缘了。』" voices=""/><msg @l="1081" char_id="1" frame_id="1" name="玲"   text="『可、可是……穿着内衣走来走去什么的……。』" voices=""/><msg @l="1083" char_id="-1" frame_id="-1" name=""   text="即使通过检查能够进入大黑建设公司，如果被众多员工看到穿着内衣在公司里走动的样子，入职后，稻庭先生肯定也会听说。"   voices=""/><msg @l="1084" char_id="-1" frame_id="-1" name=""   text="如果这种事被知道了，稻庭先生可能会用鄙视的眼光看我。那样就等同于失去了一切。" voices=""/><msg @l="1086" char_id="1" frame_id="1" name="玲"   text="『拜托了！如果是其他事情的话，我什么都愿意做，能不能换成别的检查呢？我，真的非常想在贵公司工作！』"   voices=""/><msg @l="1088" char_id="-1" frame_id="-1" name="大黑"   text="『原来如此……既然玲小姐都这么说了，那没办法。』" voices=""/><msg @l="1090" char_id="-1" frame_id="-1" name="大黑"   text="『那么，我们这样吧。特别降低一下检查等级如何？』" voices=""/><msg @l="1092" char_id="-1" frame_id="-1" name="大黑"   text="『当然，相应的评价也会降低……。』" voices=""/><msg @l="1094" char_id="-1" frame_id="-1" name=""   text="说着，大黑用舔舐般黏腻的目光看着玲。" voices=""/><msg @l="1096" char_id="1" frame_id="1" name="玲"   text="『检、检查等级降低的话，会变成什么内容呢……』" voices=""/><msg @l="1098" char_id="-1" frame_id="-1" name="大黑"   text="『检查内容和刚才一样，让您在公司内走动，看看您是否能做到不把男性视为异性。』" voices=""/><msg @l="1100" char_id="1" frame_id="1" name="玲"   text="『诶！那、那不就和刚才一样吗……。』" voices=""/><msg @l="1102" char_id="-1" frame_id="-1" name="大黑"   text="『啊，当然和刚才指定的服装不同。穿着西装就可以了。』" voices=""/><msg @l="1104" char_id="1" frame_id="1" name="玲" text="『是、是吗……。』"   voices=""/><msg @l="1106" char_id="-1" frame_id="-1" name=""   text="玲听到大黑的话，松了一口气。然而——" voices=""/><msg @l="1108" char_id="-1" frame_id="-1" name="大黑"   text="『只是……这次要请您脱掉内衣。』" voices=""/><msg @l="1110" char_id="1" frame_id="1" name="玲" text="『啊！？』" voices=""/><msg @l="1112" char_id="-1" frame_id="-1" name="大黑"   text="『还有，请您脱掉西装外套，上半身只穿衬衫。』" voices=""/><msg @l="1114" char_id="1" frame_id="1" name="玲"   text="『怎么会！只穿衬衫不穿内衣的话……会透出来的……！』" voices=""/><msg @l="1116" char_id="-1" frame_id="-1" name="大黑"   text="『但是，您并不是穿着内衣的样子，只要正常一点没人会注意到的。』" voices=""/><msg @l="1117" char_id="-1" frame_id="-1" name="大黑"   text="『接下来就看玲小姐能否做到不把员工们视为异性，保持正常了。』" voices=""/><msg @l="1119" char_id="-1" frame_id="-1" name="大黑"   text="『只要您不要因为衣服下没穿内衣而过度在意男性员工们的目光，让下面湿得一塌糊涂就好了……』"   voices=""/><msg @l="1121" char_id="1" frame_id="1" name="玲" text="『什…………！？』"   voices=""/><msg @l="1123" char_id="-1" frame_id="-1" name="大黑"   text="『您怎么选？要放弃接受这个检测吗？』" voices=""/><msg @l="1125" char_id="1" frame_id="1" name="玲"   text="『………………………………。』" voices=""/><msg @l="1127" char_id="-1" frame_id="-1" name="" text="真不想接受这种检测……。"   voices=""/><msg @l="1128" char_id="-1" frame_id="-1" name=""   text="但是，如果我拒绝了这个检测，就再也无法进入这家公司了……。" voices=""/><msg @l="1129" char_id="-1" frame_id="-1" name=""   text="那样的话，就不能和稻庭先生在一起了……。" voices=""/><msg @l="1130" char_id="-1" frame_id="-1" name="" text="那是我绝对不想要的……。"   voices=""/><bgm @l="1133" src="bgm14" volume="1."/><msg @l="1135" char_id="1" frame_id="1" name="玲" text="『……我知道了。』"   voices=""/><msg @l="1137" char_id="1" frame_id="1" name="玲" text="『请按照那个检测内容进行。』"   voices=""/><msg @l="1139" char_id="-1" frame_id="-1" name="大黑"   text="『很好。那么我们就在外面等着，准备好了请出来。』" voices=""/><msg @l="1141" char_id="1" frame_id="1" name="玲" text="『……好的。』" voices=""/><stopbgm @l="1144" fadeout="1000"/><clear @l="1150" class="all"/><msgshow @l="1152" show="true"/><wait_chgmv/><bg @l="1156" src="bg17m1"/><char @l="1160" id="ookur" pos="center" src="ookuro010f" y="-80"/><msg @l="1162" char_id="-1" frame_id="-1" name="大黑"   text="『没想到那位美丽而高傲的玲小姐，竟然会接受性骚扰面试而不做抵抗……。』" voices=""/><msg @l="1164" char_id="-1" frame_id="-1" name="高桥"   text="『太好了呢，少爷。过去的仇得以报复。』" voices=""/><msg @l="1166" char_id="-1" frame_id="-1" name="大黑"   text="『别叫我少爷了，高桥！虽然是从父亲那继承的职位，但我好歹也是社长啊。』" voices=""/><msg @l="1168" char_id="-1" frame_id="-1" name="高桥" text="『非、非常抱歉。』"   voices=""/><msg @l="1170" char_id="-1" frame_id="-1" name="高桥"   text="『不、不过那位白石女士真是漂亮啊，难怪大黑先生会看入迷。比那些偶像还要美丽呢。』"   voices=""/><msg @l="1172" char_id="-1" frame_id="-1" name="大黑"   text="『那是当然的。玲小姐可是我们的女神。……不过，没想到那位玲小姐竟然能忍受被人触摸身体……。』"   voices=""/><msg @l="1174" char_id="-1" frame_id="-1" name="大黑"   text="『看来正如调查所示，她非常喜欢那个叫稻庭的男人，无论如何都想进入同一家公司呢……。』" voices=""/><msg @l="1176" char_id="-1" frame_id="-1" name="大黑"   text="『但是我不会允许这种事的……。』" voices=""/><msg @l="1178" char_id="-1" frame_id="-1" name="大黑"   text="『在最爱的人面前，给予最大的羞辱……。我会让你尝到和我一样的滋味，玲小姐。』" voices=""/><msg @l="1180" char_id="-1" frame_id="-1" name="高桥"   text="『那么，要把那个叫稻庭的男人带来吗？』" voices=""/><msg @l="1182" char_id="-1" frame_id="-1" name="大黑"   text="『不，把乐趣留到最后吧。』" voices=""/><msg @l="1184" char_id="-1" frame_id="-1" name="大黑"   text="『得让她一点一点地堕落下去，才更有趣啊……。』" voices=""/><msg @l="1186" char_id="-1" frame_id="-1" name=""   text="在接待室前，大黑脸上浮现出一丝淫邪的笑容。" voices=""/><se @l="1190" buf="1" src="扉を開ける音_金属" volume="1."/><msg @l="1192" char_id="-1" frame_id="-1" name="" text="咔嚓" voices=""/><clear @l="1195" class="char"/><char @l="1197" id="ookur" pos="auto" src="ookuro010"/><bgm @l="1201" src="bgm14" volume="1."/><msg @l="1203" char_id="1" frame_id="1" name="玲" text="『……。』" voices=""/><msg @l="1205" char_id="-1" frame_id="-1" name=""   text="门开了，一脸厌恶表情的玲从里面走出来。" voices=""/><msg @l="1207" char_id="-1" frame_id="-1" name="大黑" text="『看来准备好了呢。』"   voices=""/><msg @l="1209" char_id="1" frame_id="1" name="玲" text="『……是。』" voices=""/><msg @l="1211" char_id="-1" frame_id="-1" name=""   text="于是，玲带着混合着羞耻与屈辱的表情，轻轻地点了点头。" voices=""/><msg @l="1213" char_id="-1" frame_id="-1" name="大黑" text="『那么，我们走吧。』"   voices=""/><msg @l="1215" char_id="1" frame_id="1" name="玲" text="『……。』" voices=""/><clear @l="1221" class="all"/><label @l="1224" id="event_scene47"/><label @l="1228" id="chart_line26"/><wait_chgmv/><ev @l="1232" src="ev-047a"/><description @l="1235" text="一次面试B"/><msg @l="1237" char_id="-1" frame_id="-1" name=""   text="大黑他们带着没穿内衣的玲，开始穿行于众多员工正在工作的办公室中。" voices=""/><msg @l="1238" char_id="-1" frame_id="-1" name=""   text="玲一直低着头，因为担心胸部会透过衣服被看到而羞耻地颤抖着。" voices=""/><msg @l="1239" char_id="-1" frame_id="-1" name=""   text="这时，虽然一开始没注意到，但路过的每一位员工都对大黑礼貌地打着招呼。" voices=""/><msg @l="1241" char_id="1" frame_id="1" name="玲"   text="『……那个，为什么大家都向您行礼呢？』" voices="rei01050"/><msg @l="1243" char_id="-1" frame_id="-1" name="大黑"   text="『呵呵，这说明员工教育做得很到位啊。』" voices=""/><msg @l="1245" char_id="1" frame_id="1" name="玲" text="『……？』"   voices="rei01060"/><msg @l="1247" char_id="-1" frame_id="-1" name="大黑"   text="『话说回来，你感觉如何……能不在意异性的目光走路吗？』" voices=""/><msg @l="1249" char_id="1" frame_id="1" name="玲" text="『这，这个嘛……』"   voices="rei01070"/><msg @l="1251" char_id="-1" frame_id="-1" name="大黑"   text="『看来你还不太习惯呢。那么为了让你不觉得羞耻，我来帮你一下吧。』" voices=""/><msg @l="1253" char_id="1" frame_id="1" name="玲" text="『……？』"   voices="rei01060"/><msg @l="1255" char_id="-1" frame_id="-1" name="大黑"   text="『刚才走过去的那个人，好像注意到玲小姐没有穿内衣了哦？』" voices=""/><msg @l="1257" char_id="1" frame_id="1" name="玲" text="『……！！』"   voices="rei01080"/><msg @l="1259" char_id="-1" frame_id="-1" name=""   text="听到大黑的话，玲下意识地想用双手遮住胸前。" voices=""/><msg @l="1260" char_id="-1" frame_id="-1" name=""   text="但是，她的手被名叫高桥的面试官抓住……制止了。" voices=""/><msg @l="1262" char_id="1" frame_id="1" name="玲" text="『啊，你干什么……』"   voices="rei00960"/><msg @l="1264" char_id="-1" frame_id="-1" name="高桥"   text="『现在正在进行检测中，不能用手去遮掩。』" voices=""/><msg @l="1266" char_id="1" frame_id="1" name="玲" text="『…………。』"   voices="rei01090"/><msg @l="1268" char_id="-1" frame_id="-1" name="大黑"   text="『我再说一遍，这项检查是为了测试玲小姐能否做到不被异性的目光影响，所以隐藏身体这种事是绝对不行的。』"   voices=""/><msg @l="1270" char_id="-1" frame_id="-1" name="大黑"   text="『如果下次再做同样的事，就会被取消录用资格，请务必注意。』" voices=""/><msg @l="1272" char_id="1" frame_id="1" name="玲" text="『…………。』"   voices="rei01090"/><msg @l="1274" char_id="1" frame_id="1" name="玲" text="『……我明白了。』"   voices="rei01740"/><msg @l="1276" char_id="-1" frame_id="-1" name="" text="大黑『那么，我们继续检查』"   voices=""/><msg @l="1278" char_id="-1" frame_id="-1" name=""   text="大黑肆无忌惮地盯着她衬衫下没穿胸罩而若隐若现的胸部。" voices=""/><msg @l="1280" char_id="-1" frame_id="-1" name="大黑"   text="『玲小姐的胸部似乎比以前大了呢。透过光线，衬衫变得透明，能清晰看到那形状优美的胸部。』" voices=""/><msg @l="1282" char_id="1" frame_id="1" name="玲" text="『……！！』"   voices="rei01080"/><msg @l="1284" char_id="-1" frame_id="-1" name="大黑"   text="『这么大的话，走路时会不停地摇晃，乳头摩擦会不会感到疼痛呢？』" voices=""/><msg @l="1286" char_id="1" frame_id="1" name="玲" text="『……。』"   voices="rei01090"/><msg @l="1288" char_id="-1" frame_id="-1" name="大黑"   text="『嗯……，你的乳头是不是立起来了？衬衫都凸出来了。』" voices=""/><msg @l="1290" char_id="1" frame_id="1" name="玲" text="『……唔……。』"   voices="rei00990"/><msg @l="1292" char_id="-1" frame_id="-1" name="大黑"   text="『嗯——，不行啊——。如果仅仅因为我的话就感到害羞的话。』" voices=""/><msg @l="1294" char_id="-1" frame_id="-1" name="大黑"   text="『果然是因为遮掩着，才会感到害羞。』" voices=""/><msg @l="1296" char_id="-1" frame_id="-1" name="大黑"   text="『干脆，全部脱掉或许就不会害羞了呢。』" voices=""/><msg @l="1298" char_id="1" frame_id="1" name="玲" text="『那、那个……。』"   voices="rei01070"/><msg @l="1300" char_id="-1" frame_id="-1" name="大黑"   text="『呵呵呵。开玩笑的，开玩笑。不过也有“熟能生巧”这种说法呢。』" voices=""/><msg @l="1301" char_id="-1" frame_id="-1" name="大黑"   text="『你那丰满的胸部被塞在衬衫里可能会很拘束，所以如果你想的话，随时可以脱掉也没关系哦。』"   voices=""/><msg @l="1303" char_id="1" frame_id="1" name="玲" text="『……唔……。』"   voices="rei00990"/><msg @l="1305" char_id="1" frame_id="1" name="玲"   text="（为什么我要遭受这种残忍的对待……）" voices=""/><msg @l="1307" char_id="-1" frame_id="-1" name="高桥"   text="『喂！刚才不是说过了吗，上级人士给你建议时要表示感谢！』" voices=""/><msg @l="1309" char_id="-1" frame_id="-1" name="高桥"   text="『连最基本礼貌都不懂的人，没资格成为我们公司的员工！』" voices=""/><msg @l="1311" char_id="1" frame_id="1" name="玲" text="『……。』"   voices="rei01090"/><msg @l="1313" char_id="-1" frame_id="-1" name="高桥"   text="『怎么了！快点道谢。』" voices=""/><msg @l="1315" char_id="1" frame_id="1" name="玲" text="『……谢、谢谢您。』"   voices="rei01000"/><msg @l="1317" char_id="-1" frame_id="-1" name="大黑"   text="『玲小姐甚至连我这个在她记忆边缘都不存在的人说这种淫秽的话，都能心存感谢……呵呵呵。』"   voices=""/><msg @l="1319" char_id="-1" frame_id="-1" name="大黑"   text="『那个美丽聪明的玲小姐，竟然变成了会因下流话而高兴的变态女人，真是让人震惊啊。』" voices=""/><msg @l="1321" char_id="1" frame_id="1" name="玲" text="『……唔……。』"   voices="rei00990"/><msg @l="1323" char_id="-1" frame_id="-1" name="大黑"   text="『看来这对变大的奶子，也是被男人们揉搓才变大的吧……。』" voices=""/><msg @l="1325" char_id="-1" frame_id="-1" name="大黑"   text="『高中时代，体操服下摇晃的胸部比现在小一圈，现在却变得这么大……一定是被揉了很多次，乳头也被吸得啧啧作响吧。』"   voices=""/><msg @l="1327" char_id="1" frame_id="1" name="玲" text="『……唔……。』"   voices="rei00990"/><msg @l="1329" char_id="-1" frame_id="-1" name=""   text="之后，玲被带着在办公室里四处走动，持续受到大黑的侮辱性言论。" voices=""/><clear @l="1337" class="all"/><msgshow @l="1339" show="true"/><wait_chgmv/><bg @l="1343" src="bg17m1"/><msg @l="1346" char_id="-1" frame_id="-1" name=""   text="玲被带着参观了与之前不同的楼层。在此过程中，她与走廊上的公司员工擦肩而过。" voices=""/><wait_chgmv/><ev @l="1350" src="ev-047a"/><msg @l="1352" char_id="1" frame_id="1" name="玲" text="『………。』"   voices="rei01100"/><msg @l="1354" char_id="-1" frame_id="-1" name="" text="玲带着不甘的表情走着。"   voices=""/><msg @l="1355" char_id="-1" frame_id="-1" name=""   text="明显不合理的要求，以及无法反抗的自己。" voices=""/><msg @l="1356" char_id="-1" frame_id="-1" name=""   text="即便如此，只要能澄清误会就能回到正常的面试。" voices=""/><msg @l="1357" char_id="-1" frame_id="-1" name=""   text="这样想着，玲忍受着这屈辱的检查。" voices=""/><msg @l="1358" char_id="-1" frame_id="-1" name=""   text="然而，大黑的言语侮辱却越来越升级……。" voices=""/><msg @l="1360" char_id="-1" frame_id="-1" name="大黑"   text="『每当有人擦肩而过，都会看着玲小姐的胸部呢。』" voices=""/><msg @l="1362" char_id="-1" frame_id="-1" name="大黑"   text="『嘛，像玲小姐这样的美人，不穿胸罩让粉色乳头若隐若现，任谁都会在意的吧。』" voices=""/><msg @l="1364" char_id="1" frame_id="1" name="玲" text="『…………。』"   voices="rei00990"/><msg @l="1366" char_id="-1" frame_id="-1" name="大黑"   text="『啊，难道是被男人们玩弄过度，乳头已经变黑了吗？』" voices=""/><msg @l="1368" char_id="-1" frame_id="-1" name=""   text="大黑一边说着更加侮辱玲的话，一边将脸靠近从衬衫中露出的白皙乳沟。" voices=""/><msg @l="1370" char_id="1" frame_id="1" name="玲" text="『……！！』"   voices="rei01110"/><msg @l="1372" char_id="-1" frame_id="-1" name=""   text="玲在感受到大黑温热的鼻息喷在乳沟上的瞬间，本能地向后退去。" voices=""/><msg @l="1373" char_id="-1" frame_id="-1" name="" text="就在那一刻———。" voices=""/><msg @l="1375" char_id="-1" frame_id="-1" name="女员工" text="『呀！？』"   voices=""/><msg @l="1377" char_id="1" frame_id="1" name="玲" text="『啊……。』"   voices="rei01120"/><msg @l="1379" char_id="-1" frame_id="-1" name=""   text="玲正好撞上了一位擦肩而过的女性员工。" voices=""/><msg @l="1381" char_id="-1" frame_id="-1" name="" text="哗啦" voices=""/><wait_chgmv/><ev @l="1385" src="ev-047bx1z1"/><stopbgm @l="1388" fadeout="1000"/><msg @l="1390" char_id="1" frame_id="1" name="玲" text="『……！？』"   voices="rei01150"/><msg @l="1392" char_id="-1" frame_id="-1" name=""   text="不巧的是，女性员工手中的杯子被弹开，水洒在了玲的身上。" voices=""/><msg @l="1394" char_id="-1" frame_id="-1" name="女员工" text="『对、对不起……！』"   voices=""/><msg @l="1396" char_id="1" frame_id="1" name="玲"   text="『啊，不……该道歉的是我才对。』" voices="rei01130"/><msg @l="1398" char_id="-1" frame_id="-1" name="女员工"   text="『但是，您的衣服被水……啊………！』" voices=""/><msg @l="1400" char_id="1" frame_id="1" name="玲" text="『诶……？』"   voices="rei01140"/><msg @l="1402" char_id="-1" frame_id="-1" name="" text="女性员工的视线停留在玲的胸前。"   voices=""/><msg @l="1403" char_id="-1" frame_id="-1" name="" text="在她视线的尽头，是被水打湿的衬衫。"   voices=""/><msg @l="1404" char_id="-1" frame_id="-1" name=""   text="然后……湿透的衬衫紧贴在皮肤上，没有穿内衣的乳房透过衣服清晰可见。" voices=""/><msg @l="1405" char_id="-1" frame_id="-1" name=""   text="不知不觉间，周围的员工们也都在盯着她透明的胸口看。" voices=""/><msg @l="1407" char_id="1" frame_id="1" name="玲" text="『……！？』"   voices="rei01150"/><wait_chgmv/><ev @l="1411" src="ev-047bx1y1z1"/><bgm @l="1413" src="bgm13" volume="1."/><msg @l="1415" char_id="1" frame_id="1" name="玲" text="『呀啊啊！？』"   voices="rei01160"/><msg @l="1417" char_id="-1" frame_id="-1" name=""   text="玲满脸通红地用手遮住胸前，发出一声短促的尖叫。" voices=""/><msg @l="1419" char_id="-1" frame_id="-1" name="大黑"   text="『哦呵！这就是我做梦都想看到的玲小姐的胸部……形状和我想象的一样好。乳头也是粉色的。』" voices=""/><msg @l="1421" char_id="-1" frame_id="-1" name=""   text="看到湿衬衫贴身透出的胸部，兴奋的大黑几乎要贴上去似的将脸凑近玲的胸前。" voices=""/><msg @l="1422" char_id="-1" frame_id="-1" name=""   text="周围的员工们听到骚动，都向玲这边靠拢过来……。" voices=""/><msg @l="1424" char_id="-1" frame_id="-1" name="男员工" text="『嗯？怎么了，怎么回事？』"   voices=""/><msg @l="1426" char_id="-1" frame_id="-1" name=""   text="靠过来的员工们看到玲透明的衬衫样子，最初表情惊讶，但很快变成了轻蔑的表情。" voices=""/><msg @l="1428" char_id="-1" frame_id="-1" name="男员工"   text="『什么啊，那女孩没穿内衣啊。』" voices=""/><msg @l="1430" char_id="-1" frame_id="-1" name="男员工"   text="『而且乳头都硬了，真是个变态。』" voices=""/><msg @l="1432" char_id="-1" frame_id="-1" name="男员工"   text="『谁啊，是谁把应召女郎叫到公司来的。』" voices=""/><msg @l="1434" char_id="-1" frame_id="-1" name=""   text="不知不觉中，玲已经被大约10个人包围，他们肆无忌惮地盯着她被水浸透的上半身。玲被众多男性用眼神侵犯着胸部，脸涨得通红。"   voices=""/><msg @l="1436" char_id="1" frame_id="1" name="玲" text="『请、请不要看……。』"   voices="rei01170"/><msg @l="1438" char_id="-1" frame_id="-1" name="大黑"   text="『没必要遮掩什么。你一直用那对出色的奶子诱惑男人不是吗。』" voices=""/><msg @l="1440" char_id="1" frame_id="1" name="玲" text="『不是那样的……。』"   voices="rei02050"/><msg @l="1442" char_id="-1" frame_id="-1" name="大黑"   text="『难得机会，要不要让所有员工都共享一下呢？』" voices=""/><msg @l="1444" char_id="-1" frame_id="-1" name="" text="说着，大黑慢慢靠近了。"   voices=""/><msg @l="1446" char_id="1" frame_id="1" name="玲" text="『……！？』"   voices="rei01150"/><msg @l="1448" char_id="-1" frame_id="-1" name=""   text="玲一边用手遮掩胸部，一边后退。这时，大黑突然面色严峻地提醒她。" voices=""/><msg @l="1450" char_id="-1" frame_id="-1" name="大黑"   text="『玲小姐，请不要让我重复说明。现在检查还在继续中。不可以用手遮挡。』" voices=""/><wait_chgmv/><ev @l="1453" src="ev-047bx1z1"/><msg @l="1454" char_id="1" frame_id="1" name="玲" text="『呀啊啊！？』"   voices="rei01160"/><msg @l="1456" char_id="-1" frame_id="-1" name=""   text="玲遮掩胸部的手被大黑抓住，湿透衬衫紧贴的乳房完全暴露，上半身几乎等同于裸体状态。" voices=""/><msg @l="1457" char_id="-1" frame_id="-1" name=""   text="玲因为极度羞耻，脸涨得通红，发出了悲鸣。" voices=""/><msg @l="1459" char_id="-1" frame_id="-1" name="大黑"   text="『检查必须进行到最后，否则无法得出结果。』" voices=""/><msg @l="1461" char_id="1" frame_id="1" name="玲" text="『……呜……。』"   voices="rei00990"/><msg @l="1463" char_id="-1" frame_id="-1" name=""   text="大黑拉着玲的手，再次开始走动。这时那个泼水的女职员向大黑搭话。" voices=""/><stopbgm @l="1466" fadeout="1000"/><msg @l="1468" char_id="-1" frame_id="-1" name="女员工" text="『那、那个……』"   voices=""/><msg @l="1470" char_id="-1" frame_id="-1" name="大黑"   text="『啊，你已经可以了。退下吧。』" voices=""/><msg @l="1472" char_id="-1" frame_id="-1" name="" text="大黑冷淡地回应。"   voices=""/><msg @l="1474" char_id="-1" frame_id="-1" name="女员工"   text="『是、是的……非常抱歉。社长。』" voices=""/><msg @l="1476" char_id="1" frame_id="1" name="玲" text="『啊……？』"   voices="rei01140"/><clear @l="1482" class="all"/><wait_chgmv/><bg @l="1486" src="bg17m1"/><char @l="1490" id="ookur" pos="center" src="ookuro010f" y="-80"/><bgm @l="1493" src="bgm09" volume="1."/><msg @l="1495" char_id="-1" frame_id="-1" name=""   text="女职员向大黑鞠躬后，快步离开了现场。" voices=""/><msg @l="1497" char_id="-1" frame_id="-1" name="大黑"   text="『失礼了。来，继续检查吧。』" voices=""/><msg @l="1499" char_id="1" frame_id="1" name="玲"   text="『那、那个，刚才那位女性说的社长是指……？』" voices=""/><msg @l="1501" char_id="-1" frame_id="-1" name="大黑"   text="『啊，说起来我还没告诉你呢。』" voices=""/><msg @l="1503" char_id="-1" frame_id="-1" name="大黑"   text="『实际上我父亲是集团的董事长，所以我继承了社长的职位。』" voices=""/><msg @l="1505" char_id="1" frame_id="1" name="玲"   text="『啊……？大黑先生，您是社长吗………！？』" voices=""/><msg @l="1507" char_id="-1" frame_id="-1" name="大黑" text="『是的。』"   voices=""/><msg @l="1509" char_id="-1" frame_id="-1" name="大黑"   text="『玲小姐很幸运啊。从一面开始，就由作为社长的我来面试你。』" voices=""/><msg @l="1511" char_id="-1" frame_id="1" name="大黑"   text="（不过其实是我更幸运呢。可以随意摆布曾经高不可攀的玲小姐，还能报以前的仇）"   voices=""/><msg @l="1513" char_id="1" frame_id="1" name="玲" text="『…………。』" voices=""/><msg @l="1515" char_id="-1" frame_id="-1" name="" text="玲不禁哑口无言。"   voices=""/><msg @l="1516" char_id="-1" frame_id="-1" name="" text="大黑先生竟然是社长……。"   voices=""/><msg @l="1517" char_id="-1" frame_id="-1" name=""   text="而且还被作为社长的大黑先生误解和记恨……。" voices=""/><msg @l="1518" char_id="-1" frame_id="-1" name=""   text="这样下去别说拿到内定了，甚至不知道会受到什么样的恶劣对待。" voices=""/><msg @l="1519" char_id="-1" frame_id="-1" name=""   text="必须尽快消除误会……想到这里，玲越来越焦急。" voices=""/><msg @l="1521" char_id="-1" frame_id="-1" name="大黑"   text="『好了……差不多该去下一个区域了吧。虽然玲小姐可能还想继续炫耀你那对奶子，但我们还有其他检查要做。』"   voices=""/><msg @l="1523" char_id="1" frame_id="1" name="玲" text="『啊………！？』" voices=""/><msg @l="1525" char_id="-1" frame_id="-1" name="大黑" text="『好了，我们走吧。』"   voices=""/><msg @l="1527" char_id="1" frame_id="1" name="玲"   text="『拜、拜托您了。请、请让我换件衣服。』" voices=""/><msg @l="1529" char_id="1" frame_id="1" name="玲" text="『求求您了……………。』"   voices=""/><msg @l="1531" char_id="-1" frame_id="-1" name=""   text="玲满脸通红，含着泪水恳求道。" voices=""/><msg @l="1533" char_id="-1" frame_id="-1" name="大黑"   text="『再参观三个楼层就结束了。再忍耐一下吧。』" voices=""/><msg @l="1535" char_id="1" frame_id="1" name="玲" text="『这、这种……不可能的……。』"   voices=""/><msg @l="1537" char_id="1" frame_id="1" name="玲"   text="『这副模样被陌生人看到……我无法忍受。』" voices=""/><msg @l="1539" char_id="-1" frame_id="-1" name="大黑"   text="『您是不想被陌生人看到吗？那么被认识的人看到就没关系了？』" voices=""/><msg @l="1541" char_id="1" frame_id="1" name="玲" text="『啊！？』" voices=""/><msg @l="1543" char_id="-1" frame_id="-1" name="大黑"   text="『已经拿到内定的学生们正在上面几层进行培训呢。』" voices=""/><msg @l="1545" char_id="1" frame_id="1" name="玲" text="（那、那是指稻庭先生他们吗！？）"   voices=""/><msg @l="1547" char_id="-1" frame_id="-1" name="大黑"   text="『现在我打算把他们叫到这层楼，让这些可能会成为你同期的人看看你这幅模样如何？』" voices=""/><msg @l="1549" char_id="1" frame_id="1" name="玲" text="『这、这怎么行！？』" voices=""/><msg @l="1551" char_id="-1" frame_id="-1" name="大黑"   text="『看到玲小姐这淫荡的样子，无论是谁都会很高兴吧。当然，如果是玲小姐喜欢的人，那就更加有趣了。』"   voices=""/><msg @l="1553" char_id="-1" frame_id="-1" name=""   text="如果被叫来的稻庭先生看到自己现在的样子……恐怕再也无法面对他了。想到这里，玲失去了抵抗的力量。" voices=""/><bgm @l="1556" src="bgm14" volume="1."/><msg @l="1558" char_id="1" frame_id="1" name="玲"   text="『……我、我知道了。请不要把我留在这里。』" voices=""/><msg @l="1560" char_id="1" frame_id="1" name="玲"   text="『请……随意继续您的检查吧……。』" voices=""/><msg @l="1562" char_id="-1" frame_id="-1" name="大黑"   text="『呵呵，一开始就这样的态度不就好了吗。』" voices=""/><msg @l="1564" char_id="-1" frame_id="-1" name="大黑" text="『那么我们继续检查。』"   voices=""/><wait_chgmv/><ev @l="1566" src="ev-047bx1z1"/><msg @l="1568" char_id="-1" frame_id="-1" name="大黑"   text="『这个结束后立刻进行下一项检查。』" voices=""/><msg @l="1570" char_id="1" frame_id="1" name="玲" text="『啊……？』"   voices="rei01140"/><msg @l="1572" char_id="-1" frame_id="-1" name="大黑"   text="『好了好了，总之先到下一层楼看看吧。在这里待太久，万一上面楼层认识的人下来看到你这副样子，你不会很尴尬吗？』"   voices=""/><msg @l="1574" char_id="1" frame_id="1" name="玲" text="『啊……！』"   voices="rei01120"/><msg @l="1576" char_id="-1" frame_id="-1" name=""   text="大黑打断了对话，半强制地抓住玲的手臂开始走动。" voices=""/><wait_chgmv/><ev @l="1580" src="ev-047az1"/><msg @l="1582" char_id="-1" frame_id="-1" name=""   text="这时，玲听到两名OL看到她的样子后在窃窃私语。" voices=""/><msg @l="1584" char_id="-1" frame_id="-1" name="女职员1" text="『天啊，那女孩是什么情况。暴露狂？』"   voices=""/><msg @l="1586" char_id="1" frame_id="1" name="玲" text="『……！？』"   voices="rei01150"/><msg @l="1588" char_id="-1" frame_id="-1" name="女职员2"   text="『明明是来面试的，却穿成那样，是不是变态啊？』" voices=""/><msg @l="1589" char_id="1" frame_id="1" name="玲" text="『………。』"   voices="rei01100"/><msg @l="1591" char_id="-1" frame_id="-1" name="女职员1"   text="『不是啦，她是来钓男人的啦。』" voices=""/><msg @l="1593" char_id="1" frame_id="1" name="玲" text="『……唔……。』"   voices="rei00990"/><msg @l="1595" char_id="-1" frame_id="-1" name=""   text="玲听着OL们的交谈，羞耻得快要哭出来了，却仍然穿着湿透的衬衫，被大黑拉着离开了……。" voices=""/><stopbgm @l="1599" fadeout="1000"/><clear @l="1605" class="all"/><end_scene @l="1608"/><wait_chgmv/><bg @l="1613" src="bg07"/><msg @l="1615" char_id="-1" frame_id="-1" name="" text="与此同时，在大学里——。"   voices=""/><clear @l="1621" class="all"/><wait_chgmv/><bg @l="1625" src="bg08m2"/><bgm @l="1629" src="bgm02" volume="1."/><char @l="1633" id="miho" pos="auto" src="miho114"/><msg @l="1635" char_id="0" frame_id="1" name="美帆" text="『……咦？』" voices=""/><msg @l="1637" char_id="-1" frame_id="-1" name=""   text="当讲座结束，正准备把笔记本放进包里时，她注意到里面有一张陌生的纸。" voices=""/><msg @l="1638" char_id="-1" frame_id="-1" name=""   text="展开那张折叠的纸，发现是昨天在客厅捡到的那份录取通知书。" voices=""/><msg @l="1640" char_id="0" frame_id="1" name="美帆"   text="『这是……玲小姐的录取通知书………。』" voices=""/><char @l="1643" id="miho" pos="auto" src="miho116"/><msg @l="1645" char_id="0" frame_id="1" name="美帆"   text="『原来如此，我本打算早上起床后交给她的……结果就这么带出来了。』" voices=""/><msg @l="1647" char_id="-1" frame_id="-1" name=""   text="已经错拿出来的东西也没办法了。今天回去后再交给玲小姐吧。" voices=""/><msg @l="1648" char_id="-1" frame_id="-1" name=""   text="正想着把纸收起来的时候，她发现这纸其实是两张重叠在一起的。" voices=""/><char @l="1651" id="miho" pos="auto" src="miho114"/><msg @l="1653" char_id="0" frame_id="1" name="美帆" text="『咦，还有一张……。』"   voices=""/><stopbgm @l="1656" fadeout="1000"/><msg @l="1658" char_id="0" frame_id="1" name="美帆" text="『呃……录取证明书？』"   voices=""/><msg @l="1660" char_id="-1" frame_id="-1" name=""   text="文件上写着，个人面试时必须携带此证明。" voices=""/><msg @l="1662" char_id="0" frame_id="1" name="美帆"   text="『这不是……今天面试需要的文件吗！？』" voices=""/><char @l="1666" id="miho" pos="auto" src="miho115"/><bgm @l="1668" src="bgm08" volume="1."/><msg @l="1670" char_id="0" frame_id="1" name="美帆"   text="『如果是我带出来了的话……那就糟了……。』" voices=""/><msg @l="1672" char_id="-1" frame_id="-1" name=""   text="如果因为这个导致玲小姐无法在大黑建设就职，那就麻烦大了。" voices=""/><msg @l="1673" char_id="-1" frame_id="-1" name=""   text="……这样会毁掉玲小姐的梦想。" voices=""/><msg @l="1674" char_id="-1" frame_id="-1" name=""   text="这么想着，我能感觉到自己的血色都在褪去。" voices=""/><char @l="1678" id="miho" pos="auto" src="miho114"/><msg @l="1680" char_id="0" frame_id="1" name="美帆" text="『总、总之先给玲小姐打电话……。』"   voices=""/><char @l="1683" id="miho" pos="center" src="miho116f" y="-80"/><msg @l="1685" char_id="-1" frame_id="-1" name="" text="我慌忙地用手机联系玲小姐。"   voices=""/><msg @l="1686" char_id="-1" frame_id="-1" name=""   text="……但是，等了很久也没有听到拨号音。" voices=""/><msg @l="1687" char_id="-1" frame_id="-1" name="" text="刚以为终于听到声音了……。"   voices=""/><msg @l="1689" char_id="-1" frame_id="-1" name="广播"   text="『……对方现在所处位置无法接通信号……。』" voices=""/><msg @l="1691" char_id="-1" frame_id="-1" name="" text="……是通话无法接通时的录音播报。"   voices=""/><se @l="1695" buf="1" src="携帯ボタン押下音" volume="1."/><char @l="1699" id="miho" pos="center" src="miho115f" y="-80"/><msg @l="1701" char_id="-1" frame_id="-1" name=""   text="我挂断电话，看了看屏幕上的时间。" voices=""/><msg @l="1702" char_id="-1" frame_id="-1" name=""   text="现在她是不是正在面试中把手机关机了呢。" voices=""/><msg @l="1704" char_id="0" frame_id="1" name="美帆" text="『……怎么办才好。』"   voices=""/><msg @l="1706" char_id="-1" frame_id="-1" name=""   text="我盯着手中的纸，一时间惊慌失措。" voices=""/><msg @l="1708" char_id="0" frame_id="1" name="美帆" text="『…………。』" voices=""/><char @l="1712" id="miho" pos="center" src="miho114f" y="-80"/><msg @l="1714" char_id="0" frame_id="1" name="美帆" text="『啊，对了……。』"   voices=""/><msg @l="1716" char_id="0" frame_id="1" name="美帆"   text="『给公司打电话解释情况的话，他们也许能理解。』" voices=""/><char @l="1720" id="miho" pos="center" src="miho116f" y="-80"/><se @l="1724" buf="1" src="携帯電話番号入力電子音" volume="1."/><msg @l="1726" char_id="-1" frame_id="-1" name=""   text="我开始在手机上输入手中资料最底部写着的大黑建设的电话号码。" voices=""/><se @l="1730" buf="3" loop="true" src="発信音" volume="1."/><msg @l="1732" char_id="-1" frame_id="-1" name="" text="嘟嘟嘟嘟，嘟嘟嘟嘟……。"   voices=""/><msg @l="1733" char_id="-1" frame_id="-1" name=""   text="按下通话键后，立即传来了呼叫音。" voices=""/><stopse @l="1737" buf="3"/><msg @l="1739" char_id="-1" frame_id="-1" name="前台小姐"   text="『您好，这里是大黑建设南总町支社。』" voices=""/><char @l="1742" id="miho" pos="center" src="miho114f" y="-80"/><msg @l="1744" char_id="0" frame_id="1" name="美帆" text="『那个……其实……。』"   voices=""/><char @l="1747" id="miho" pos="center" src="miho115f" y="-80"/><msg @l="1749" char_id="-1" frame_id="-1" name=""   text="我虽然因紧张而结结巴巴，但还是解释了自己是室友，不小心带错了玲小姐的录取证明的事情。"   voices=""/><msg @l="1751" char_id="-1" frame_id="-1" name=""   text="前台接待小姐安静地听完后，说道“请稍候，我来确认一下”，然后将电话置于保留状态。" voices=""/><se @l="1755" buf="3" loop="true" src="保留音" volume="1."/><char @l="1758" id="miho" pos="center" src="miho015f" y="-80"/><msg @l="1760" char_id="0" frame_id="1" name="美帆" text="『…………。』" voices=""/><msg @l="1762" char_id="-1" frame_id="-1" name=""   text="可能是因为我太慌张了，这短暂的等待时间显得异常漫长。" voices=""/><msg @l="1763" char_id="-1" frame_id="-1" name=""   text="电话那头现在会是怎样的讨论呢。" voices=""/><msg @l="1764" char_id="-1" frame_id="-1" name=""   text="玲小姐的面试是否受到了影响，公司是否能理解这种情况……这些问题在我脑海中不断盘旋。"   voices=""/><stopse @l="1768" buf="3"/><msg @l="1770" char_id="-1" frame_id="-1" name="前台小姐" text="『让您久等了。』"   voices=""/><char @l="1773" id="miho" pos="center" src="miho114f" y="-80"/><msg @l="1775" char_id="0" frame_id="1" name="美帆" text="『啊，是的……。』" voices=""/><msg @l="1777" char_id="-1" frame_id="-1" name="前台小姐"   text="『我已经确认了白石小姐的面试情况，但如果不带来那份文件，确实无法进行正规的手续办理。』"   voices=""/><char @l="1780" id="miho" pos="center" src="miho115f" y="-80"/><msg @l="1782" char_id="0" frame_id="1" name="美帆"   text="『请问，如果没有这份文件，面试本身会不会无法进行？』" voices=""/><msg @l="1784" char_id="-1" frame_id="-1" name="前台小姐"   text="『那份文件可以在面试结束后再交给我们，面试本身是可以进行的。』" voices=""/><stopbgm @l="1787" fadeout="1000"/><char @l="1789" id="miho" pos="center" src="miho111f" y="-80"/><msg @l="1791" char_id="0" frame_id="1" name="美帆" text="『是这样啊……』"   voices=""/><char @l="1794" id="miho" pos="center" src="miho110f" y="-80"/><msg @l="1796" char_id="-1" frame_id="-1" name="" text="听到这话，我松了一口气。"   voices=""/><msg @l="1797" char_id="-1" frame_id="-1" name=""   text="然后立刻决定“去送文件”。" voices=""/><msg @l="1798" char_id="-1" frame_id="-1" name=""   text="现在赶过去的话，下一节课就要缺席了，但比起这个，玲小姐的面试更重要。" voices=""/><char @l="1801" id="miho" pos="center" src="miho116f" y="-80"/><msg @l="1803" char_id="0" frame_id="1" name="美帆"   text="『我会立即把文件送过去。』" voices=""/><msg @l="1805" char_id="-1" frame_id="-1" name="前台小姐"   text="『明白了，请问可以告诉我您的名字吗？』" voices=""/><char @l="1808" id="miho" pos="center" src="miho114f" y="-80"/><msg @l="1810" char_id="0" frame_id="1" name="美帆" text="『啊，好的……我叫仲根。』"   voices=""/><msg @l="1812" char_id="-1" frame_id="-1" name="前台小姐"   text="『是仲根女士对吧，我们期待您的到来。』" voices=""/><se @l="1816" buf="1" src="携帯ボタン押下音" volume="1."/><bgm @l="1819" src="bgm02" volume="1."/><clear @l="1821" class="char"/><char @l="1824" id="miho" pos="auto" src="miho116"/><msg @l="1826" char_id="0" frame_id="1" name="美帆" text="『………。』" voices=""/><msg @l="1828" char_id="0" frame_id="1" name="美帆"   text="『……哎，事情变得有点麻烦了啊。』" voices=""/><msg @l="1830" char_id="-1" frame_id="-1" name=""   text="于是我再次叹了口气后，拿起行李快步走向公交站。" voices=""/><stopbgm @l="1832" fadeout="1000"/><clear @l="1838" class="all"/><wait_chgmv/><bg @l="1842" src="bg18m1"/><char @l="1846" id="miho" pos="auto" src="miho126"/><msg @l="1848" char_id="0" frame_id="1" name="美帆" text="（嗯……）" voices=""/><msg @l="1850" char_id="-1" frame_id="-1" name=""   text="我匆忙前往办公区，目标是大黑建设的大楼。" voices=""/><clear @l="1856" class="all"/><wait_chgmv/><bg @l="1860" src="bg16"/><msg @l="1862" char_id="0" frame_id="1" name="美帆" text="（找到了……大黑建设）"   voices=""/><char @l="1866" id="miho" pos="auto" src="miho024"/><msg @l="1868" char_id="-1" frame_id="-1" name=""   text="我站在大黑建设的大楼前，抬头仰望着建筑物。" voices=""/><msg @l="1869" char_id="-1" frame_id="-1" name="" text="不知道有多少层……真是非常巨大。"   voices=""/><char @l="1873" id="miho" pos="auto" src="miho124"/><msg @l="1875" char_id="0" frame_id="1" name="美帆" text="（……得，赶快送过去才行）"   voices=""/><clear @l="1881" class="all"/><bgm @l="1884" src="bgm14" volume="1."/><se @l="1887" buf="1" src="自動ドアの音" volume="1."/><msg @l="1889" char_id="-1" frame_id="-1" name="" text="一进入入口，我立刻走向接待处。"   voices=""/><msg @l="1891" char_id="0" frame_id="1" name="美帆"   text="『那个，我是刚才打电话的仲根……』" voices=""/><msg @l="1893" char_id="-1" frame_id="-1" name="前台小姐"   text="『是的……仲根女士对吧………。』" voices=""/><msg @l="1895" char_id="-1" frame_id="-1" name=""   text="接待处的姐姐正在查看访客表进行确认。" voices=""/><msg @l="1897" char_id="-1" frame_id="-1" name="前台小姐" text="『已经收到您的信息了。』"   voices=""/><msg @l="1899" char_id="-1" frame_id="-1" name="前台小姐"   text="『负责人表示希望亲自接收，所以我将为您带路前往那里。』" voices=""/><msg @l="1901" char_id="0" frame_id="1" name="美帆" text="『好、好的……』" voices=""/><msg @l="1903" char_id="0" frame_id="1" name="美帆" text="（还好赶上了………）"   voices=""/><msg @l="1905" char_id="-1" frame_id="-1" name="前台小姐" text="『请这边走。』"   voices=""/><msg @l="1907" char_id="0" frame_id="1" name="美帆" text="『啊，好的……』"   voices=""/><msg @l="1909" char_id="0" frame_id="1" name="美帆"   text="（玲小姐……希望面试顺利）" voices=""/><clear @l="1915" class="all"/><wait_chgmv/><bg @l="1919" src="bg17m1"/><char @l="1922" id="miho" pos="auto" src="miho120"/><msg @l="1924" char_id="0" frame_id="1" name="美帆" text="『………』" voices=""/><msg @l="1926" char_id="-1" frame_id="-1" name=""   text="乘电梯上到7楼后，被带到了办公区的一个角落。" voices=""/><msg @l="1927" char_id="-1" frame_id="-1" name=""   text="自然周围都是公司员工，他们看起来都很忙碌地工作着。" voices=""/><msg @l="1929" char_id="-1" frame_id="-1" name="前台小姐"   text="『请在这个房间里稍等。』" voices=""/><char @l="1932" id="miho" pos="auto" src="miho026"/><msg @l="1933" char_id="0" frame_id="1" name="美帆" text="『我知道了。』" voices=""/><clear @l="1937" class="char"/><clear @l="1943" class="all"/><msg @l="1945" char_id="0" frame_id="1" name="美帆" text="『………』" voices=""/><msg @l="1947" char_id="-1" frame_id="-1" name=""   text="我进入的房间是一个奇怪地很深且细长的房间。" voices=""/><msg @l="1948" char_id="-1" frame_id="-1" name=""   text="而且一侧的墙壁上安装着一面巨大的镜子，让人感到不自在。" voices=""/><msg @l="1950" char_id="0" frame_id="1" name="美帆" text="（好奇怪的房间……）"   voices=""/><msg @l="1952" char_id="-1" frame_id="-1" name="" text="我姑且坐在椅子上等待。"   voices=""/><stopbgm @l="1956" fadeout="1000"/><clear @l="1962" class="all"/><msgshow @l="1964" show="true"/><wait_chgmv/><bg @l="1968" src="bg17m1"/><bgm @l="1972" src="bgm09" volume="1."/><char @l="1976" id="ookur" pos="auto" src="ookuro010"/><msg @l="1978" char_id="-1" frame_id="-1" name="大黑"   text="『哦……那就是你说的女孩吧。』" voices=""/><msg @l="1980" char_id="-1" frame_id="-1" name="大黑"   text="『虽然和玲小姐的类型不同，但也是个可爱的孩子啊。』" voices=""/><msg @l="1982" char_id="-1" frame_id="-1" name=""   text="在办公室的一角，大黑和接待员正在交谈。" voices=""/><msg @l="1983" char_id="-1" frame_id="-1" name=""   text="大黑面前放着一台电脑，显示器上显示着美帆乖巧地坐在房间里的样子。" voices=""/><msg @l="1985" char_id="-1" frame_id="-1" name="前台小姐"   text="『按照您的指示，我们还没有收取她的资料。』" voices=""/><msg @l="1987" char_id="-1" frame_id="-1" name="大黑"   text="『啊，虽然对那孩子有些过意不去，但让她在那个房间里多等一会儿吧。因为可能会用在玲小姐的面试上呢。』" voices=""/><msg @l="1989" char_id="-1" frame_id="-1" name="大黑"   text="『你去给她拿点饮料吧。』" voices=""/><msg @l="1991" char_id="-1" frame_id="-1" name="前台小姐" text="『遵命。』"   voices=""/><stopbgm @l="1994" fadeout="1000"/><clear @l="1996" class="char"/><char @l="1998" id="ookur" pos="center" src="ookuro010f" y="-80"/><msg @l="2000" char_id="-1" frame_id="1" name="大黑"   text="（不过，是玲小姐的室友吗……来得正好）" voices=""/><msg @l="2002" char_id="-1" frame_id="1" name="大黑"   text="（要让玲小姐产生即使身体被玷污也想加入我们公司的想法，还缺少一个条件）" voices=""/><msg @l="2004" char_id="-1" frame_id="1" name="大黑"   text="（如果是为了羞辱玲小姐，我会不择手段的）" voices=""/><msg @l="2006" char_id="-1" frame_id="-1" name="前台小姐"   text="『那么，我去准备饮料了。』" voices=""/><bgm @l="2009" src="bgm09" volume="1."/><clear @l="2011" class="char"/><char @l="2013" id="ookur" pos="auto" src="ookuro010"/><msg @l="2015" char_id="-1" frame_id="-1" name="大黑" text="『好好干。』"   voices=""/><msg @l="2017" char_id="-1" frame_id="-1" name=""   text="大黑露出下流的笑容，抚摸着准备离开的接待员的臀部。" voices=""/><msg @l="2018" char_id="-1" frame_id="-1" name=""   text="接待员对此表情毫无变化，径直走向茶水间。" voices=""/><msg @l="2020" char_id="-1" frame_id="-1" name="大黑"   text="『哼，忠诚是不错，但未免缺乏点趣味。』" voices=""/><msg @l="2022" char_id="-1" frame_id="-1" name="高桥"   text="『社长……有客人来了。』" voices=""/><msg @l="2024" char_id="-1" frame_id="-1" name="大黑"   text="『好的，那就请把玲小姐叫过来吧。让我们开始下一项检查吧。』" voices=""/><msg @l="2026" char_id="-1" frame_id="-1" name="高桥" text="『遵命。』"   voices=""/><clear @l="2032" class="all"/><msg @l="2035" char_id="-1" frame_id="-1" name="大黑"   text="『哎呀，玲小姐……看来您已经准备好了？』" voices=""/><msg @l="2037" char_id="-1" frame_id="-1" name="" text="大黑走进了接待室。"   voices=""/><msg @l="2038" char_id="-1" frame_id="-1" name=""   text="房间里，被允许换上西装的玲坐在沙发上。" voices=""/><msg @l="2040" char_id="-1" frame_id="-1" name=""   text="她原本以为今天要一直穿着衬衫直到检查结束的……" voices=""/><clear @l="2046" class="all"/><msgshow @l="2048" show="true"/><wait_chgmv/><bg @l="2050" src="bg17m1"/><msg @l="2052" char_id="-1" frame_id="-1" name="大黑"   text="『下一项检查可以换回原来的求职西装，内衣也可以穿上。』" voices=""/><msg @l="2054" char_id="1" frame_id="1" name="玲"   text="『啊……真的吗！？……啊，非常感谢。』" voices=""/><msg @l="2056" char_id="-1" frame_id="-1" name=""   text="她原以为会被脱光，听到大黑这意料之外的话语，稍微安心了一些。" voices=""/><msg @l="2057" char_id="-1" frame_id="-1" name=""   text="然而，这短暂的安心很快就被证明是一场误会。" voices=""/><msg @l="2059" char_id="-1" frame_id="-1" name="大黑"   text="『毕竟，对方似乎特别喜欢求职西装呢。』" voices=""/><msg @l="2061" char_id="1" frame_id="1" name="玲"   text="『啊！？这是什么意思……！？』" voices=""/><msg @l="2063" char_id="-1" frame_id="-1" name="大黑" text="『您很快就会明白的。』"   voices=""/><clear @l="2069" class="all"/><msgshow @l="2071" show="true"/><msg @l="2074" char_id="1" frame_id="1" name="玲" text="『……。』" voices=""/><msg @l="2076" char_id="1" frame_id="1" name="玲"   text="『那个……接下来要进行什么样的检查呢？』" voices=""/><msg @l="2078" char_id="-1" frame_id="-1" name="大黑" text="『是接待啊，接待。』"   voices=""/><msg @l="2080" char_id="1" frame_id="1" name="玲"   text="『接待…？接待是什么意思呢？』" voices=""/><msg @l="2082" char_id="-1" frame_id="-1" name="大黑"   text="『啊，说起来我还没告诉您接待的内容呢。』" voices=""/><msg @l="2084" char_id="-1" frame_id="-1" name=""   text="明知道自己没有做解释，大黑却故意这样说道。" voices=""/><msg @l="2086" char_id="-1" frame_id="-1" name="大黑"   text="『这次的接待将在实际的交易场所进行。请务必做好接待工作，争取让谈判成功。』" voices=""/><msg @l="2088" char_id="1" frame_id="1" name="玲" text="『啊……这种事，我做不到！』"   voices=""/><msg @l="2090" char_id="-1" frame_id="-1" name="大黑"   text="『听好了，玲小姐。由于您之前的检测结果不佳，本来是无法进入下一阶段的检测的。』" voices=""/><msg @l="2092" char_id="-1" frame_id="-1" name="大黑"   text="『但是，看在同学的情分上，我特意关照您，再给您一次机会，您就是这种态度吗！』" voices=""/><msg @l="2094" char_id="1" frame_id="1" name="玲"   text="『可是，我从来没做过接待这种事……。』" voices=""/><msg @l="2096" char_id="-1" frame_id="-1" name="大黑"   text="『呵呵呵……请放心，我们不会让玲小姐一个人承担谈判角色。』" voices=""/><msg @l="2098" char_id="1" frame_id="1" name="玲"   text="『是、是这样啊……太好了……。』" voices=""/><msg @l="2100" char_id="-1" frame_id="-1" name="" text="听了大黑的话，我稍微松了口气。"   voices=""/><msg @l="2102" char_id="1" frame_id="1" name="玲"   text="『但是……那么，我该做什么呢？』" voices=""/><msg @l="2104" char_id="-1" frame_id="-1" name="大黑"   text="『做只有玲小姐能做的事情，让交易对象高兴起来哦。』" voices=""/><msg @l="2106" char_id="1" frame_id="1" name="玲" text="『啊……！？』" voices=""/><msg @l="2108" char_id="-1" frame_id="-1" name="大黑"   text="『听好了。无论发生什么事都绝对不能拒绝。如果想通过检测的话……就必须顺从地接待到结束。』"   voices=""/><msg @l="2110" char_id="-1" frame_id="-1" name=""   text="说着，大黑露出了一丝猥琐的笑容。" voices=""/><stopbgm @l="2113" fadeout="1000"/><clear @l="2119" class="all"/><label @l="2122" id="event_scene41"/><label @l="2126" id="chart_line27"/><bgm @l="2129" src="bgm15" volume="1."/><wait_chgmv/><ev @l="2133" src="ev-041x1"/><description @l="2136" text="一次面试C"/><msg @l="2138" char_id="-1" frame_id="-1" name="建筑设计师"   text="『哎呀，没想到真的会给我准备一位穿着求职西装的姑娘。』" voices=""/><msg @l="2140" char_id="-1" frame_id="-1" name="大黑"   text="『哪里哪里，只要像您这样的建筑设计师能为我们设计公寓，我们会尽力满足您的任何要求。』"   voices=""/><msg @l="2142" char_id="-1" frame_id="-1" name="建筑设计师"   text="『既然你们这么尽心，我也会努力的。』" voices=""/><msg @l="2144" char_id="1" frame_id="1" name="玲" text="『……。』"   voices="rei01180"/><msg @l="2146" char_id="-1" frame_id="-1" name=""   text="在两人谈笑风生的同时，玲被夹在交易对象建筑设计师和大黑之间，忍受着这种不合理的状况。" voices=""/><msg @l="2147" char_id="-1" frame_id="-1" name="" text="这也是理所当然的。"   voices=""/><msg @l="2148" char_id="-1" frame_id="-1" name=""   text="来谈判的建筑设计师一边谈着工作，一边突然把手伸进西装的胸前，揉捏起胸部。" voices=""/><msg @l="2149" char_id="-1" frame_id="-1" name=""   text="至于大黑，则让玲套弄着自己的那话儿，同时抚摸着她的大腿。" voices=""/><msg @l="2151" char_id="-1" frame_id="-1" name="建筑设计师"   text="『然后，我想用触感光滑的材料作为墙壁材料……。』" voices=""/><msg @l="2153" char_id="-1" frame_id="-1" name="大黑"   text="『原来如此。那么，像这大腿一样细腻的感觉如何？』" voices=""/><msg @l="2155" char_id="-1" frame_id="-1" name=""   text="说着，大黑抚摸着玲被裸露出来的白皙大腿。" voices=""/><msg @l="2157" char_id="-1" frame_id="-1" name="" text="抚、抚" voices=""/><msg @l="2159" char_id="-1" frame_id="-1" name="建筑设计师"   text="『不错啊。那么，客厅的灯泡大小就做成这个胸部大小吧。』" voices=""/><msg @l="2161" char_id="-1" frame_id="-1" name=""   text="建筑设计师一边淫笑着一边揉搓着玲的乳房。" voices=""/><msg @l="2163" char_id="-1" frame_id="-1" name="" text="揉、揉" voices=""/><msg @l="2165" char_id="-1" frame_id="-1" name="大黑"   text="『如果是那么大的灯泡，房间里一定会非常明亮吧。』" voices=""/><msg @l="2167" char_id="-1" frame_id="-1" name="建筑设计师" text="『当然可以。』"   voices=""/><msg @l="2169" char_id="-1" frame_id="-1" name=""   text="说着，两人笑着肆意玩弄着玲的身体。" voices=""/><msg @l="2171" char_id="1" frame_id="1" name="玲" text="『……。』"   voices="rei01180"/><msg @l="2173" char_id="-1" frame_id="-1" name=""   text="玲被陌生人亵玩身体，羞耻和痛苦让她几乎要哭出来。" voices=""/><msg @l="2174" char_id="1" frame_id="1" name="玲"   text="（为什么……，为什么，我必须做这种事）" voices=""/><msg @l="2176" char_id="1" frame_id="1" name="玲"   text="（为了进入和稻庭先生同一家公司，我确实非常想要这个内定……）" voices=""/><msg @l="2178" char_id="1" frame_id="1" name="玲"   text="（但是……，被稻庭先生以外的人触摸身体已经受不了了……）" voices=""/><msg @l="2180" char_id="1" frame_id="1" name="玲"   text="（刚才被摸胸的时候还隔着衣服……）" voices=""/><msg @l="2182" char_id="1" frame_id="1" name="玲"   text="（现在却被直接揉捏，最后甚至被迫握住男人的那个东西……）" voices=""/><msg @l="2183" char_id="-1" frame_id="-1" name="大黑"   text="『怎么了玲小姐。在这种场合笑容是基本礼仪哦？』" voices=""/><msg @l="2185" char_id="-1" frame_id="-1" name=""   text="大黑对已经对这种不合理状况感到忍无可忍的玲，像是雪上加霜般地说道。" voices=""/><msg @l="2187" char_id="1" frame_id="1" name="玲" text="『……。』"   voices="rei01190"/><msg @l="2189" char_id="-1" frame_id="-1" name=""   text="看到沉默的玲，建筑设计师对大黑说道。" voices=""/><msg @l="2191" char_id="-1" frame_id="-1" name="建筑设计师"   text="『大黑先生，难道是因为没有提到水电部分的话题让您不满意吗？』" voices=""/><msg @l="2193" char_id="-1" frame_id="-1" name="大黑"   text="『水电部分……。啊！原来如此。确实差点忘了家中最重要的水电部分。』" voices=""/><msg @l="2195" char_id="-1" frame_id="-1" name=""   text="大黑理解了建筑设计师的话后，用猥琐的眼神看着玲。" voices=""/><msg @l="2197" char_id="1" frame_id="1" name="玲" text="『咦……？』"   voices="rei01140"/><msg @l="2199" char_id="-1" frame_id="-1" name=""   text="下一瞬间，大黑将原本抚摸大腿的手，移向了她的私处。" voices=""/><msg @l="2201" char_id="1" frame_id="1" name="玲" text="『……唔……。』"   voices="rei00990"/><msg @l="2203" char_id="-1" frame_id="-1" name=""   text="被触碰私处的玲，已经达到了忍耐的极限。" voices=""/><msg @l="2205" char_id="1" frame_id="1" name="玲"   text="（与其被当成风俗娘这样对待，宁愿不要内定……）" voices=""/><msg @l="2207" char_id="-1" frame_id="-1" name=""   text="就在她这么想着，准备站起来的那一瞬间——。" voices=""/><stopbgm @l="2210" fadeout="1000"/><msg @l="2212" char_id="-1" frame_id="-1" name="大黑"   text="『还是不能笑着接待客人吗。真是没办法啊……。』" voices=""/><msg @l="2214" char_id="1" frame_id="1" name="玲" text="『……？』"   voices="rei01060"/><msg @l="2216" char_id="-1" frame_id="-1" name=""   text="说着，大黑从口袋里掏出了一个小遥控器。" voices=""/><msg @l="2218" char_id="-1" frame_id="-1" name="大黑"   text="『我给您看个好东西，玲小姐。』" voices=""/><msg @l="2220" char_id="1" frame_id="1" name="玲" text="『诶……？』"   voices="rei01140"/><msg @l="2222" char_id="-1" frame_id="-1" name="建筑设计师"   text="『怎么了，大黑先生？』" voices=""/><bgm @l="2225" src="bgm09" volume="1."/><msg @l="2227" char_id="-1" frame_id="-1" name="大黑"   text="『其实现在，这位小姐正在参加录用考试呢。』" voices=""/><msg @l="2229" char_id="-1" frame_id="-1" name="建筑设计师" text="『哦？』"   voices=""/><msg @l="2231" char_id="-1" frame_id="-1" name="大黑"   text="『今年我们打算从两名有前途的候选人中选择。』" voices=""/><msg @l="2233" char_id="1" frame_id="1" name="玲" text="『……！？』"   voices="rei01150"/><msg @l="2235" char_id="1" frame_id="1" name="玲"   text="（两名！？……这么说，我已经进入最终选拔了？）" voices=""/><msg @l="2237" char_id="1" frame_id="1" name="玲"   text="（难道再努力一下，就能和稻庭先生在同一家公司……）" voices=""/><msg @l="2239" char_id="-1" frame_id="-1" name="建筑设计师"   text="『哦哦，两个人……是吗。』" voices=""/><msg @l="2241" char_id="-1" frame_id="-1" name="大黑"   text="『难得有这个机会……请您从设计师的角度比较一下，在隔壁房间等候的另一位候选人和这位小姐，说说哪个更好。』"   voices=""/><msg @l="2243" char_id="1" frame_id="1" name="玲" text="『啊……这种，比较什么的。』"   voices="rei01210"/><msg @l="2245" char_id="-1" frame_id="-1" name="大黑"   text="『设计最重要的是外表。其他事情特别无关紧要。』" voices=""/><msg @l="2246" char_id="1" frame_id="1" name="玲" text="『无、无关紧要是……。』"   voices="rei01240"/><msg @l="2248" char_id="-1" frame_id="-1" name="大黑"   text="『而且，玲小姐现在是负责接待的角色，不是发表意见的立场吧。』" voices=""/><msg @l="2250" char_id="1" frame_id="1" name="玲" text="『……。』"   voices="rei01250"/><msg @l="2252" char_id="-1" frame_id="-1" name="大黑"   text="『呵呵，那么我们来看一下另一位候选人吧。』" voices=""/><stopbgm @l="2255" fadeout="1000"/><clear @l="2261" class="all"/><msg @l="2263" char_id="-1" frame_id="-1" name=""   text="说着大黑操作起了手中的遥控器。" voices=""/><msg @l="2264" char_id="-1" frame_id="-1" name=""   text="然后……百叶窗发出声音缓缓升起。" voices=""/><msg @l="2265" char_id="-1" frame_id="-1" name=""   text="那面墙整面都是玻璃，能够清晰地看到隔壁房间的情况。" voices=""/><bgm @l="2268" src="bgm15" volume="1."/><msg @l="2270" char_id="1" frame_id="1" name="玲" text="『诶……美帆！？』"   voices="rei01260"/><msg @l="2272" char_id="-1" frame_id="-1" name="" text="那个房间里……坐着美帆。"   voices=""/><msg @l="2274" char_id="1" frame_id="1" name="玲" text="『为什么……？』"   voices="rei01270"/><msg @l="2276" char_id="-1" frame_id="-1" name="" text="但是美帆似乎并没有注意到这边。"   voices=""/><msg @l="2278" char_id="-1" frame_id="-1" name="大黑"   text="『这块玻璃是单向镜，从那边的房间是看不到这边的。』" voices=""/><msg @l="2280" char_id="-1" frame_id="-1" name="建筑设计师"   text="『哦，相当可爱嘛。』" voices=""/><msg @l="2282" char_id="-1" frame_id="-1" name="大黑" text="『比较一下如何呢？』"   voices=""/><msg @l="2284" char_id="-1" frame_id="-1" name="建筑设计师"   text="『不错啊，素质上是最棒的。』" voices=""/><msg @l="2286" char_id="1" frame_id="1" name="玲" text="『……。』"   voices="rei01280"/><msg @l="2288" char_id="-1" frame_id="-1" name="大黑"   text="『原来如此，那就是说比起玲小姐，您更中意那位女孩是吗？』" voices=""/><msg @l="2290" char_id="1" frame_id="1" name="玲" text="『……唔……。』"   voices="rei00990"/><wait_chgmv/><ev @l="2293" src="ev-041x1"/><msg @l="2295" char_id="-1" frame_id="-1" name="大黑"   text="『那么……怎么办呢，玲小姐？虽然进入了最后两名，但照这样下去，恐怕您拿不到内定了哦。』" voices=""/><msg @l="2297" char_id="-1" frame_id="-1" name="" text="玲的内心，各种情绪翻腾着。"   voices=""/><msg @l="2298" char_id="-1" frame_id="-1" name="" text="为什么美帆会在这种地方？"   voices=""/><msg @l="2299" char_id="-1" frame_id="-1" name=""   text="美帆进入大黑建设的最终选考是怎么回事……？" voices=""/><msg @l="2301" char_id="-1" frame_id="-1" name="大黑"   text="『怎么了？不打算更多地展示自己吗？还是说您已经放弃了？』" voices=""/><msg @l="2303" char_id="1" frame_id="1" name="玲" text="『……。』"   voices="rei01290"/><msg @l="2305" char_id="-1" frame_id="-1" name=""   text="无论如何，现在必须让大黑他们满意，避免被淘汰出局。确认美帆的事情可以之后再说……。" voices=""/><msg @l="2306" char_id="-1" frame_id="-1" name=""   text="总之为了能和稻庭先生一起进入同一家公司，现在就忍耐吧。" voices=""/><msg @l="2307" char_id="-1" frame_id="-1" name=""   text="忍耐到了这一步，如果现在放弃的话，一切都将变得毫无意义。" voices=""/><msg @l="2308" char_id="-1" frame_id="-1" name="" text="玲下定了决心……。"   voices=""/><bgm @l="2311" src="bgm14" volume="1."/><wait_chgmv/><ev @l="2314" src="ev-041"/><msg @l="2316" char_id="-1" frame_id="-1" name=""   text="玲的脸上浮现出一丝生硬的微笑。那无疑是一个职业性的笑容。" voices=""/><msg @l="2318" char_id="1" frame_id="1" name="玲"   text="『那个……您想继续之前的交易吗？』" voices="rei01300"/><msg @l="2320" char_id="-1" frame_id="-1" name="" text="玲用略微颤抖的声音说道。"   voices=""/><msg @l="2321" char_id="-1" frame_id="-1" name=""   text="然后，玲开始用手指缠绕着大黑的肉棒，有轻有重地套弄起来。她对那肉棒的处理方式，与先前那种勉强的态度完全不同了。"   voices=""/><msg @l="2322" char_id="-1" frame_id="-1" name=""   text="看到玲这样，两人相视一笑，露出了奸诈的表情。" voices=""/><msg @l="2324" char_id="-1" frame_id="-1" name="大黑"   text="『呵呵呵……那我们继续吧。』" voices=""/><msg @l="2326" char_id="-1" frame_id="-1" name="建筑设计师"   text="『好啊，大黑先生……』" voices=""/><wait_chgmv/><ev @l="2329" src="ev-041x1"/><msg @l="2331" char_id="-1" frame_id="-1" name="大黑"   text="『毕竟，水路系统必须做好，如果水流不畅，住户会很麻烦，所以必须确认它是否能正常流出。』"   voices=""/><msg @l="2333" char_id="-1" frame_id="-1" name=""   text="说着，他继续隔着内裤抚弄玲的私密部位。" voices=""/><msg @l="2335" char_id="-1" frame_id="-1" name="建筑设计师"   text="『水路系统确实重要，但就像这对乳房从职业装中露出来一样，我认为让客厅的灯泡暴露出来也很重要。』"   voices=""/><msg @l="2337" char_id="-1" frame_id="-1" name=""   text="建筑设计师不甘示弱，用力揉搓着玲的胸部，使它变形。" voices=""/><msg @l="2339" char_id="1" frame_id="1" name="玲" text="『……唔……』"   voices="rei00990"/><msg @l="2341" char_id="-1" frame_id="-1" name=""   text="由于揉捏过于用力，她白皙的胸部变得红肿起来。" voices=""/><msg @l="2342" char_id="-1" frame_id="-1" name=""   text="尽管如此，玲还是主动挺起胸部，同时用手继续热情地套弄着大黑的那话儿。" voices=""/><stopbgm @l="2345" fadeout="1000"/><clear @l="2351" class="all"/><end_scene @l="2354"/><bgm @l="2357" src="bgm09" volume="1."/><wait_chgmv/><bg @l="2360" src="bg17m1"/><char @l="2364" id="ookur" pos="auto" src="ookuro010"/><description @l="2367" text="室友的忧郁·第2天"/><msg @l="2369" char_id="-1" frame_id="-1" name="大黑" text="『今天真是谢谢您了。』"   voices=""/><msg @l="2371" char_id="-1" frame_id="-1" name="建筑设计师"   text="『不，是我该谢谢您才对，我有了很好的设计方案，这是次充实的会议。』" voices=""/><msg @l="2373" char_id="-1" frame_id="-1" name=""   text="会议结束后，大黑和建筑设计师正在交谈。" voices=""/><msg @l="2375" char_id="-1" frame_id="-1" name="建筑设计师"   text="『那么我就先告辞了。稍后会把设计方案发送给您。』" voices=""/><msg @l="2377" char_id="-1" frame_id="-1" name="大黑" text="『好的，拜托您了。』"   voices=""/><msg @l="2379" char_id="-1" frame_id="-1" name="建筑设计师" text="『再见。』"   voices=""/><msg @l="2381" char_id="-1" frame_id="-1" name=""   text="建筑设计师向大黑道别后，离开了房间。" voices=""/><msg @l="2383" char_id="-1" frame_id="-1" name="大黑" text="『好了……』" voices=""/><char @l="2387" id="rei" pos="auto" src="rei015"/><msg @l="2389" char_id="1" frame_id="1" name="玲" text="『……。』" voices=""/><msg @l="2391" char_id="-1" frame_id="-1" name="大黑"   text="『今天辛苦了，暂且就此结束实地检查。』" voices=""/><msg @l="2393" char_id="1" frame_id="1" name="玲" text="『那个……隔壁房间的那位是？』"   voices=""/><msg @l="2395" char_id="-1" frame_id="-1" name="大黑"   text="『啊，如果是说室友的话，她已经回去了。』" voices=""/><char @l="2398" id="rei" pos="auto" src="rei125"/><msg @l="2400" char_id="1" frame_id="1" name="玲" text="『啊！？为什么那样！！』"   voices=""/><msg @l="2402" char_id="-1" frame_id="-1" name="大黑"   text="『玲小姐不知道她也申请了我们公司吗？』" voices=""/><char @l="2405" id="rei" pos="auto" src="rei115"/><msg @l="2407" char_id="1" frame_id="1" name="玲"   text="『怎么会……！因为，美帆比我晚一年毕业啊！面试不应该在同一年度吧！？』" voices=""/><msg @l="2409" char_id="-1" frame_id="-1" name="大黑"   text="『……？玲小姐有好好阅读这次的通知吗？』" voices=""/><char @l="2412" id="rei" pos="auto" src="rei125"/><msg @l="2414" char_id="1" frame_id="1" name="玲" text="『呃……？』" voices=""/><msg @l="2416" char_id="-1" frame_id="-1" name="大黑"   text="『通知上写着，今年度女性的录用因故将从明年和后年的毕业生中选择一人。』" voices=""/><char @l="2419" id="rei" pos="auto" src="rei015"/><msg @l="2421" char_id="1" frame_id="1" name="玲" text="『这、这种事我不知道！？』"   voices=""/><msg @l="2423" char_id="-1" frame_id="-1" name=""   text="说着，玲在包里翻找应该放着的通知。" voices=""/><char @l="2426" id="rei" pos="auto" src="rei115"/><msg @l="2428" char_id="1" frame_id="1" name="玲" text="『咦……找不到……。』"   voices=""/><msg @l="2430" char_id="-1" frame_id="-1" name="大黑"   text="『啊，玲小姐的录取通知刚才被那位仲根小姐拿走了。』" voices=""/><char @l="2433" id="rei" pos="auto" src="rei125"/><msg @l="2435" char_id="1" frame_id="1" name="玲" text="『啊……！？』" voices=""/><msg @l="2437" char_id="-1" frame_id="-1" name="大黑"   text="『有些奇怪呢。难道仲根小姐是想对玲小姐隐瞒自己也应聘了大黑建设这件事吗？』" voices=""/><msg @l="2439" char_id="-1" frame_id="-1" name="大黑" text="『为此还把通知也藏起来了……。』"   voices=""/><stopbgm @l="2442" fadeout="1000"/><char @l="2445" id="rei" pos="auto" src="rei115"/><msg @l="2447" char_id="1" frame_id="1" name="玲" text="『不、不会吧………？』"   voices=""/><msg @l="2449" char_id="-1" frame_id="-1" name=""   text="当然，美帆和玲两人都进入最终选考这件事，更别说美帆应聘大黑建设的事，都是大黑的谎言。" voices=""/><msg @l="2450" char_id="-1" frame_id="-1" name="" text="这是一个陷害玲的陷阱。"   voices=""/><msg @l="2452" char_id="-1" frame_id="-1" name="大黑"   text="『那么，我接下来还有会议要开……。』" voices=""/><char @l="2455" id="rei" pos="auto" src="rei015"/><msg @l="2457" char_id="1" frame_id="1" name="玲" text="『啊！？那、那个，面试结果是……。』"   voices=""/><msg @l="2459" char_id="-1" frame_id="-1" name="大黑"   text="『结果吗？接待时表现出那种态度，还能若无其事地问，真是厉害啊。』" voices=""/><msg @l="2460" char_id="1" frame_id="1" name="玲" text="『啊！？』" voices=""/><msg @l="2462" char_id="-1" frame_id="-1" name="大黑" text="『老实说，你应该做好心理准备，情况不太乐观。』"   voices=""/><char @l="2465" id="rei" pos="auto" src="rei115"/><msg @l="2467" char_id="1" frame_id="1" name="玲"   text="『怎、怎么会！？我不是已经那么尽力服务了吗……。』" voices=""/><msg @l="2469" char_id="1" frame_id="1" name="玲"   text="『求您了！我无论如何都想进贵公司！』" voices=""/><char @l="2472" id="rei" pos="auto" src="rei125"/><msg @l="2474" char_id="1" frame_id="1" name="玲" text="『……什么都愿意做……。』"   voices=""/><msg @l="2476" char_id="-1" frame_id="1" name="大黑" text="（呵呵呵……再推一把……）"   voices=""/><clear @l="2479" class="char"/><bgm @l="2481" src="bgm09" volume="1."/><char @l="2483" id="rei" pos="left" src="rei125"/><char @l="2485" id="ookur" pos="auto" src="ookuro010"/><msg @l="2487" char_id="-1" frame_id="-1" name="大黑"   text="『……好吧。既然你都这么说了，那就去拿一份大学的推荐信来吧。』" voices=""/><msg @l="2489" char_id="-1" frame_id="-1" name=""   text="说着，大黑向玲逼近了过去。" voices=""/><msg @l="2491" char_id="-1" frame_id="-1" name="大黑"   text="『这样一来，也能证明大学对玲小姐的高度评价，我们公司才能让你参加下一轮面试。』" voices=""/><clear @l="2494" class="char"/><char @l="2497" id="rei" pos="left" src="rei115"/><char @l="2499" id="ookur" pos="right" src="ookuro010"/><msg @l="2501" char_id="1" frame_id="1" name="玲" text="『推荐信……吗？』"   voices=""/><msg @l="2503" char_id="-1" frame_id="-1" name="大黑"   text="『如果没有的话，仲根小姐就会获得内定了。』" voices=""/><char @l="2507" id="rei" pos="left" src="rei015"/><msg @l="2509" char_id="1" frame_id="1" name="玲"   text="『等、等一下！我一定会拿到的！拜托了！！』" voices=""/><msg @l="2511" char_id="-1" frame_id="-1" name="大黑"   text="『我明白了。那请在三天内带到我们公司来。』" voices=""/><char @l="2514" id="rei" pos="left" src="rei125"/><msg @l="2516" char_id="1" frame_id="1" name="玲" text="『……我知道了。』"   voices=""/><clear @l="2520" class="char"/><msg @l="2522" char_id="-1" frame_id="-1" name=""   text="玲带着忧心忡忡的表情离开了房间。" voices=""/><bgm @l="2525" src="bgm12" volume="1."/><char @l="2527" id="ookur" pos="center" src="ookuro010f" y="-80"/><msg @l="2529" char_id="-1" frame_id="-1" name="大黑" text="『还差一点啊……。』"   voices=""/><msg @l="2531" char_id="-1" frame_id="-1" name="大黑"   text="『接下来把这张照片交给朽木……。』" voices=""/><msg @l="2533" char_id="-1" frame_id="-1" name="大黑"   text="『嗯？对了，要不要利用刚才那个室友再推一把。』" voices=""/><msg @l="2535" char_id="-1" frame_id="-1" name=""   text="大黑拨打内线电话，叫来了正在带领公司参观的内定者参观的负责人。" voices=""/><msg @l="2536" char_id="-1" frame_id="-1" name="大黑"   text="『啊，是我。我记得内定者中有个叫稻庭的家伙，让他去正门入口。快点。』" voices=""/><msg @l="2538" char_id="-1" frame_id="-1" name="" text="只说了事情就挂断了内线电话。"   voices=""/><msg @l="2540" char_id="-1" frame_id="-1" name="大黑"   text="『如果看到自己喜欢的男生和可能成为竞争对手的室友一起，在想要入职的公司前聊天，会是什么心情呢……我很期待看到玲小姐那时的表情。』"   voices=""/><stopbgm @l="2544" fadeout="1000"/><clear @l="2550" class="all"/><wait_chgmv/><bg @l="2554" src="bg16"/><bgm @l="2558" src="bgm02" volume="1."/><char @l="2562" id="miho" pos="auto" src="miho126"/><msg @l="2564" char_id="0" frame_id="1" name="美帆" text="『呼……』" voices=""/><msg @l="2566" char_id="-1" frame_id="-1" name=""   text="安全地交完文件后，我走到外面深深地呼出一口气。" voices=""/><msg @l="2567" char_id="-1" frame_id="-1" name=""   text="结果，自称负责人的人来到房间时，我已经等了很久了。" voices=""/><msg @l="2568" char_id="-1" frame_id="-1" name=""   text="那个体格健壮、总是挂着亲切笑容的人，在我交完带来的文件后，仍然不停地东拉西扯，迟迟不肯放我离开。"   voices=""/><msg @l="2569" char_id="-1" frame_id="-1" name=""   text="这种人应该称为……粘人吧？" voices=""/><msg @l="2571" char_id="0" frame_id="1" name="美帆"   text="（不过玲小姐的文件也安全送达了……太好了）" voices=""/><msg @l="2573" char_id="-1" frame_id="-1" name=""   text="拿出手机看了看时间，已经过了16点。" voices=""/><msg @l="2574" char_id="-1" frame_id="-1" name="" text="课程已经结束了。"   voices=""/><char @l="2577" id="miho" pos="auto" src="miho026"/><msg @l="2579" char_id="0" frame_id="1" name="美帆"   text="（嗯，今天就这样回去吧……）" voices=""/><msg @l="2581" char_id="-1" frame_id="-1" name="稻庭" text="『咦？这不是仲根同学吗。』"   voices=""/><clear @l="2585" class="char"/><bgm @l="2587" src="bgm04" volume="1."/><char @l="2589" id="miho" pos="right" src="miho124"/><char @l="2591" id="inaba" pos="left" src="inaba010"/><msg @l="2593" char_id="0" frame_id="1" name="美帆"   text="『啊，稻庭学长。您怎么在这里？』" voices=""/><msg @l="2595" char_id="-1" frame_id="-1" name="稻庭"   text="『我明年要入职这家公司，现在是来培训的。』" voices=""/><msg @l="2597" char_id="-1" frame_id="-1" name="稻庭"   text="『倒是仲根同学，你在这里做什么呢？』" voices=""/><char @l="2600" id="miho" pos="right" src="miho023"/><msg @l="2602" char_id="0" frame_id="1" name="美帆"   text="『我是来给正在面试的玲小姐送文件的。』" voices=""/><msg @l="2604" char_id="-1" frame_id="-1" name="稻庭"   text="『文件？难道那个送面试必需文件来的女孩就是仲根同学吗？』" voices=""/><char @l="2606" id="miho" pos="right" src="miho024"/><msg @l="2608" char_id="0" frame_id="1" name="美帆"   text="『诶！？你怎么知道这件事的？』" voices=""/><msg @l="2610" char_id="-1" frame_id="-1" name="稻庭"   text="『其实公司的人让我把公司概况交给送文件来的女孩子。』" voices=""/><char @l="2613" id="miho" pos="right" src="miho120"/><msg @l="2615" char_id="0" frame_id="1" name="美帆" text="『给我吗？』" voices=""/><msg @l="2617" char_id="-1" frame_id="-1" name="稻庭" text="『嗯，不就是你吗？』"   voices=""/><char @l="2620" id="miho" pos="right" src="miho026"/><msg @l="2622" char_id="0" frame_id="1" name="美帆"   text="『但是，我的就职活动还有半年多才开始，现在还用不着……』" voices=""/><msg @l="2624" char_id="-1" frame_id="-1" name="稻庭"   text="『嘛，无所谓啦。先收下来作为参考资料也好。』" voices=""/><char @l="2627" id="miho" pos="right" src="miho023"/><msg @l="2629" char_id="0" frame_id="1" name="美帆"   text="『嗯——，也是。那我就收下了。』" voices=""/><msg @l="2631" char_id="-1" frame_id="-1" name="" text="美帆面带笑容接过了文件。"   voices=""/><stopbgm @l="2635" fadeout="1000"/><clear @l="2641" class="all"/><msgshow @l="2643" show="true"/><msg @l="2645" char_id="-1" frame_id="-1" name=""   text="远处有个人在看着交接文件的两人。那是玲。" voices=""/><msg @l="2646" char_id="-1" frame_id="-1" name=""   text="玲并不相信，也不愿相信大黑告诉她的美帆正在参加大黑建设入职考试的事情。" voices=""/><msg @l="2647" char_id="-1" frame_id="-1" name=""   text="与美帆成为室友已有数月，如今她已成为玲心目中可爱的妹妹般的存在，玲自认为多少了解美帆的为人。"   voices=""/><msg @l="2648" char_id="-1" frame_id="-1" name="" text="然而，这种感觉开始动摇……"   voices=""/><msg @l="2649" char_id="-1" frame_id="-1" name=""   text="虽然不想相信，但大黑说的入职考试的事似乎是真的。" voices=""/><msg @l="2650" char_id="-1" frame_id="-1" name=""   text="事实上，她正从实习中的稻庭那里接过文件，还在聊着自己不知道的话题……" voices=""/><msg @l="2651" char_id="-1" frame_id="-1" name=""   text="尽管想要相信美帆，但越是思考就越无法相信……" voices=""/><stopbgm @l="2656" fadeout="1000"/><clear @l="2662" class="all"/><msgshow @l="2664" show="true"/><wait_chgmv/><bg @l="2669" src="bg03b"/><bgm @l="2673" src="bgm03" volume="1."/><msg @l="2675" char_id="0" frame_id="1" name="美帆" text="『……』" voices=""/><msg @l="2677" char_id="1" frame_id="1" name="玲" text="『……』" voices=""/><msg @l="2679" char_id="-1" frame_id="-1" name="" text="夜晚——寂静的晚餐时间无休止地持续着。"   voices=""/><char @l="2683" id="miho" pos="auto" src="miho036"/><msg @l="2685" char_id="0" frame_id="1" name="美帆"   text="『那个……今天我稍微改变了一下调味。』" voices=""/><msg @l="2687" char_id="-1" frame_id="-1" name=""   text="无法忍受这奇怪的沉默，我开口寻找话题。" voices=""/><clear @l="2690" class="char"/><char @l="2692" id="miho" pos="left" src="miho036"/><char @l="2695" id="rei" pos="right" src="rei030"/><msg @l="2697" char_id="1" frame_id="1" name="玲" text="『……是吗。』" voices=""/><msg @l="2699" char_id="-1" frame_id="-1" name=""   text="然而，玲只是冷淡地说了这一句，便继续默默地动着筷子。" voices=""/><char @l="2703" id="miho" pos="left" src="miho136"/><msg @l="2705" char_id="0" frame_id="1" name="美帆" text="『……。』" voices=""/><msg @l="2707" char_id="1" frame_id="1" name="玲" text="『……。』" voices=""/><msg @l="2709" char_id="-1" frame_id="-1" name="" text="餐桌上再次弥漫着沉重的气氛。"   voices=""/><msg @l="2710" char_id="-1" frame_id="-1" name=""   text="自从搬进这个房间至今，从未有过如此尴尬的气氛。" voices=""/><msg @l="2711" char_id="-1" frame_id="-1" name=""   text="即使是玲心情不太好的日子，她也会体谅我，不会像今天这样。" voices=""/><msg @l="2712" char_id="-1" frame_id="-1" name=""   text="既然玲沉默不语……我也无法继续说下去。" voices=""/><msg @l="2714" char_id="1" frame_id="1" name="玲" text="『……。』" voices=""/><msg @l="2716" char_id="-1" frame_id="-1" name=""   text="一直默默吃饭的玲，突然低声说道。" voices=""/><stopbgm @l="2719" fadeout="1000"/><msg @l="2721" char_id="1" frame_id="1" name="玲"   text="『……为什么会在那个地方……。』" voices=""/><char @l="2725" id="miho" pos="left" src="miho034"/><msg @l="2727" char_id="0" frame_id="1" name="美帆" text="『诶！？』" voices=""/><msg @l="2729" char_id="0" frame_id="1" name="美帆" text="『……刚才说什么了？』"   voices=""/><msg @l="2731" char_id="1" frame_id="1" name="玲" text="『…………。』" voices=""/><char @l="2734" id="rei" pos="right" src="rei035"/><msg @l="2736" char_id="1" frame_id="1" name="玲" text="『没什么……。』"   voices=""/><msg @l="2738" char_id="1" frame_id="1" name="玲" text="『……我吃好了。』"   voices=""/><msg @l="2740" char_id="-1" frame_id="-1" name=""   text="玲没有回答我的话，拿起自己的餐具站了起来。" voices=""/><msg @l="2742" char_id="0" frame_id="1" name="美帆" text="『啊，那个……。』" voices=""/><msg @l="2744" char_id="1" frame_id="1" name="玲"   text="『……餐具待会我来洗，你放在水槽里就好。』" voices=""/><clear @l="2748" layer="rei"/><char @l="2752" id="miho" pos="left" src="miho135"/><msg @l="2754" char_id="0" frame_id="1" name="美帆" text="『啊……。』" voices=""/><msg @l="2756" char_id="-1" frame_id="-1" name=""   text="就这样，玲把餐具放到水槽后，直接回到了自己的房间。" voices=""/><msg @l="2757" char_id="-1" frame_id="-1" name="" text="……看起来她在躲着我。"   voices=""/><char @l="2761" id="miho" pos="left" src="miho035"/><msg @l="2763" char_id="0" frame_id="1" name="美帆" text="『玲……。』" voices=""/><msg @l="2765" char_id="-1" frame_id="-1" name=""   text="就这样我一个人被留在了客厅……。" voices=""/><stopbgm @l="2769" fadeout="1000"/><clear @l="2775" class="all"/><call @l="2779" target="EventLabel_132@root_rei03"/><return @l="2780" value="0&#13;&#10;"/><return @l="2783" value=""/></code></xscript>																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																			