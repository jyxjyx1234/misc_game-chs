<?xml version="1.0" encoding="utf-8"?><xscript><debug editor="&quot;C:\Program&#32;Files&#32;(x86)\sakura\sakura.exe&quot;&#32;&quot;%src%&quot;&#32;-Y=%line%"   src="D:\シロップ\町ぐるみの罠＋汚された夏セット版\汚された夏\完成データ\汚された夏\script\text\root_rei04.txt"/><code><label @l="12" id="EventLabel_133"/><description @l="16" text="室友的忧郁·第4天"/><eval @l="18" expr="f.numDay=10&#13;&#10;"/><msgshow @l="20" show="false"/><wait_chgmv/><bg @l="22" src="day10" time="2000"/><wait @l="24" time="500"/><wait_chgmv/><bg @l="26" src="black" time="2000"/><msgshow @l="28" show="true"/><wait_chgmv/><bg @l="32" src="bg03"/><bgm @l="36" src="bgm07" volume="1."/><char @l="40" id="miho" pos="auto" src="miho116"/><msg @l="42" char_id="0" frame_id="-1" name="美帆" text="『那么，我出门了。』"   voices=""/><msg @l="44" char_id="1" frame_id="-1" name="玲" text="『嗯，路上小心。』"   voices=""/><clear @l="48" class="char"/><char @l="51" id="rei" pos="auto" src="rei035"/><msg @l="53" char_id="-1" frame_id="-1" name=""   text="早晨……玲像往常一样为美帆送行。" voices=""/><msg @l="55" char_id="-1" frame_id="-1" name=""   text="然而，在美帆离开后……她脸上浮现的不是往常那种睡眼惺忪的晨间微笑。" voices=""/><msg @l="56" char_id="-1" frame_id="-1" name="" text="而是一副复杂的表情。" voices=""/><msg @l="57" char_id="-1" frame_id="-1" name=""   text="昨天朽木提出的“交换条件”，在玲的脑海中时隐时现。" voices=""/><msg @l="59" char_id="1" frame_id="-1" name="玲" text="『……我该怎么办？』"   voices=""/><msg @l="61" char_id="1" frame_id="-1" name="玲" text="『……但是，除此之外别无选择不是吗。』"   voices=""/><msg @l="63" char_id="-1" frame_id="-1" name=""   text="她仿佛在强迫自己接受这一事实，拼命为与朽木的“交换条件”寻找正当理由。" voices=""/><msg @l="64" char_id="-1" frame_id="-1" name=""   text="今天，接下来会发生在美帆身上的事情……多少能够预想到。" voices=""/><msg @l="65" char_id="-1" frame_id="-1" name=""   text="即便如此，对现在的玲来说，自己今后的前途也同样重要。" voices=""/><msg @l="66" char_id="-1" frame_id="-1" name=""   text="让她内心摇摆不定的天平最终倾斜的关键是，美帆瞒着自己接受了大黑建设的邀请，瞒着自己和稻庭亲密往来。"   voices=""/><msg @l="68" char_id="-1" frame_id="-1" name=""   text="被自己信任的可爱妹妹先行背叛——" voices=""/><msg @l="70" char_id="-1" frame_id="-1" name=""   text="那么，自己这样做又有什么不可以呢？……玲再次对自己如此说道。" voices=""/><msg @l="71" char_id="-1" frame_id="-1" name=""   text="即使这意味着将仰慕自己的学妹推入深渊……" voices=""/><stopbgm @l="75" fadeout="1000"/><clear @l="81" class="all"/><msgshow @l="83" show="true"/><wait_chgmv/><bg @l="87" src="bg12"/><bgm @l="91" src="bgm03" volume="1."/><char @l="95" id="rei" pos="auto" src="rei015"/><msg @l="97" char_id="1" frame_id="-1" name="玲" text="『……』" voices=""/><msg @l="98" char_id="-1" frame_id="-1" name=""   text="刚过十二点三十分，玲来到了朽木的教授室。" voices=""/><msg @l="99" char_id="-1" frame_id="-1" name=""   text="为了避免在校园里偶遇美帆，她特意选择了上课时间，并乘坐出租车前来。" voices=""/><msg @l="100" char_id="-1" frame_id="-1" name=""   text="朽木这个时间会在教授室，这也是昨天就已经确认过的事情。" voices=""/><clear @l="103" class="char"/><char @l="105" id="rei" pos="left" src="rei015"/><char @l="108" id="kutsu" pos="right" src="kutsu010"/><bgm @l="112" src="bgm15" volume="1."/><msg @l="114" char_id="-1" frame_id="-1" name=""   text="朽木仿佛在期待着约定的物品，露出一抹猥琐的笑容向玲问道。" voices=""/><msg @l="116" char_id="-1" frame_id="-1" name="朽木"   text="『那么，昨天说的东西准备好了吗？』" voices=""/><char @l="120" id="rei" pos="left" src="rei025"/><msg @l="122" char_id="1" frame_id="-1" name="玲"   text="『是的……毕竟昨天到今天要复制钥匙有些困难，所以我带来了备用钥匙……』" voices=""/><msg @l="124" char_id="-1" frame_id="-1" name=""   text="玲从包里取出备用钥匙交给朽木。" voices=""/><msg @l="125" char_id="-1" frame_id="-1" name=""   text="那是美帆和玲居住的那个房间的钥匙。" voices=""/><msg @l="127" char_id="-1" frame_id="-1" name="朽木"   text="『这很好。那么请拿走这些照片和推荐信吧。』" voices=""/><msg @l="129" char_id="-1" frame_id="-1" name=""   text="接过钥匙的朽木，像是交换一样从桌子的抽屉里取出一个A4尺寸的文件信封，递到玲的面前。" voices=""/><char @l="133" id="rei" pos="left" src="rei014"/><msg @l="135" char_id="1" frame_id="-1" name="玲" text="『……！』" voices=""/><msg @l="137" char_id="-1" frame_id="-1" name=""   text="玲像是抢夺一般接过它，慌忙确认文件信封的内容。" voices=""/><msg @l="138" char_id="-1" frame_id="-1" name=""   text="那确实是在大黑建设偷拍的羞辱照片，以及给大黑建设的玲的推荐信。" voices=""/><char @l="141" id="kutsu" pos="right" src="kutsu018"/><msg @l="143" char_id="-1" frame_id="-1" name="朽木"   text="『呵呵……不用那么怀疑，这就是约定好的照片和正式的推荐信。』" voices=""/><char @l="146" id="rei" pos="left" src="rei125"/><msg @l="148" char_id="1" frame_id="-1" name="玲" text="『……。』" voices=""/><char @l="152" id="rei" pos="left" src="rei015"/><msg @l="154" char_id="1" frame_id="-1" name="玲"   text="『照片和推荐信……我确实收到了……』" voices=""/><char @l="157" id="kutsu" pos="right" src="kutsu010"/><msg @l="159" char_id="-1" frame_id="-1" name="朽木"   text="『不过，我没想到像你这样关心后辈的人，真的会答应这个交换条件。』" voices=""/><msg @l="161" char_id="1" frame_id="-1" name="玲" text="『……。』" voices=""/><msg @l="163" char_id="-1" frame_id="-1" name="朽木"   text="『我还以为会被放鸽子呢……嘛，人类嘛，谁都是以自己为第一位的。』" voices=""/><char @l="166" id="rei" pos="left" src="rei115"/><msg @l="168" char_id="1" frame_id="-1" name="玲" text="『………。』" voices=""/><msg @l="170" char_id="-1" frame_id="-1" name=""   text="当然，玲对这个“交换条件”感到极大的内疚。" voices=""/><msg @l="171" char_id="-1" frame_id="-1" name="" text="听到朽木的话，玲的表情阴沉了下来。"   voices=""/><msg @l="172" char_id="-1" frame_id="-1" name=""   text="但是，事情已经发展到了无法挽回的地步。" voices=""/><char @l="175" id="rei" pos="left" src="rei017"/><msg @l="177" char_id="1" frame_id="-1" name="玲"   text="『……你打算对美帆做什么……。』" voices=""/><msg @l="179" char_id="-1" frame_id="-1" name=""   text="她仿佛是要确认即将发生的恐怖事情一般，向朽木提问。" voices=""/><msg @l="181" char_id="-1" frame_id="-1" name="朽木"   text="『呵呵呵，出卖后辈的你有必要知道吗？』" voices=""/><msg @l="183" char_id="-1" frame_id="-1" name=""   text="朽木恶意的回答刺痛了玲的心。" voices=""/><char @l="186" id="rei" pos="left" src="rei125"/><msg @l="188" char_id="1" frame_id="-1" name="玲" text="『呃………。』"   voices=""/><char @l="191" id="kutsu" pos="right" src="kutsu018"/><msg @l="193" char_id="-1" frame_id="-1" name="朽木"   text="『不过，我已经得到了想要的东西，所以也无所谓了。』" voices=""/><msg @l="195" char_id="1" frame_id="-1" name="玲" text="『………。』" voices=""/><msg @l="197" char_id="-1" frame_id="-1" name="朽木"   text="『那么……你差不多该离开的时间到了。』" voices=""/><msg @l="199" char_id="-1" frame_id="-1" name="" text="朽木指着时钟。"   voices=""/><msg @l="200" char_id="-1" frame_id="-1" name=""   text="确实……已经快到第二节课结束的时间了。" voices=""/><char @l="203" id="rei" pos="left" src="rei015"/><msg @l="205" char_id="1" frame_id="-1" name="玲"   text="『那么……我会在预定的时间之前先出去的……。』" voices=""/><msg @l="207" char_id="-1" frame_id="-1" name="朽木"   text="『请这样做吧。如果你不想让她产生不信任感的话。』" voices=""/><msg @l="209" char_id="1" frame_id="-1" name="玲" text="『……。』" voices=""/><msg @l="211" char_id="1" frame_id="-1" name="玲" text="『……失礼了。』"   voices=""/><clear @l="215" layer="rei"/><msg @l="217" char_id="-1" frame_id="-1" name=""   text="就这样……玲像是逃跑一般离开了教授室。" voices=""/><msg @l="218" char_id="-1" frame_id="-1" name=""   text="大概是想要稍微逃避自己所做之事的严重性吧。" voices=""/><clear @l="221" layer="kutsu"/><char @l="223" id="kutsu" pos="center" src="kutsu010f" y="-80"/><msg @l="225" char_id="-1" frame_id="-1" name="朽木" text="『……。』" voices=""/><msg @l="227" char_id="-1" frame_id="-1" name="朽木"   text="『呵呵，白石玲……意外地轻易就堕落了啊。』" voices=""/><char @l="230" id="kutsu" pos="center" src="kutsu018f" y="-80"/><msg @l="232" char_id="-1" frame_id="-1" name="朽木"   text="『不，应该说是大黑的铺垫做得很好吧。这次得感谢那家伙了。』" voices=""/><msg @l="234" char_id="-1" frame_id="-1" name=""   text="玲离开后，独自留在房间里的朽木，一边玩弄着备用钥匙，一边自言自语道。" voices=""/><msg @l="236" char_id="-1" frame_id="-1" name=""   text="大黑建设的分社长，大黑满彦和朽木是旧相识，也是在同一个城镇项目中合作的同志。" voices=""/><msg @l="237" char_id="-1" frame_id="-1" name=""   text="朽木拥有的“人脉”中有超过一半是由大黑牵线搭桥的，这在地下世界是众所周知的事情。" voices=""/><msg @l="238" char_id="-1" frame_id="-1" name=""   text="当然，在大黑建设内部偷拍的照片，也不过是企图吞噬玲和美帆的项目所设下的小陷阱而已。" voices=""/><clear @l="241" class="char"/><msg @l="243" char_id="-1" frame_id="-1" name="朽木"   text="『呵呵……好吧，那就尽情地利用这个特权吧。』" voices=""/><msg @l="245" char_id="-1" frame_id="-1" name="朽木" text="『为了我自己，也为了南总町。』"   voices=""/><stopbgm @l="249" fadeout="1000"/><clear @l="255" class="all"/><msgshow @l="257" show="true"/><se @l="261" buf="1" src="チャイム" volume="1."/><msg @l="263" char_id="-1" frame_id="-1" name=""   text="走出教授室，正走在通往校园的连廊上时，预示第二节课结束的铃声响起了。" voices=""/><msg @l="264" char_id="-1" frame_id="-1" name=""   text="学生们从按时结束的教室里涌出，大学内转眼间从刚才的宁静变成了一片喧嚣。"   voices=""/><wait_chgmv/><bg @l="268" src="bg15"/><bgm @l="272" src="bgm11" volume="1."/><char @l="276" id="rei" pos="auto" src="rei015"/><msg @l="278" char_id="1" frame_id="-1" name="玲" text="『……。』" voices=""/><msg @l="280" char_id="-1" frame_id="-1" name=""   text="等玲到达校园时，熟悉的喧闹景象已经完全形成了。" voices=""/><msg @l="281" char_id="-1" frame_id="-1" name=""   text="第二节和第三节课之间有午休时间，所以这个时间段格外忙乱。" voices=""/><msg @l="283" char_id="1" frame_id="-1" name="玲" text="『接下来……该怎么办呢……』"   voices=""/><msg @l="285" char_id="-1" frame_id="-1" name=""   text="玲带着忧郁的表情走在校园里。" voices=""/><msg @l="286" char_id="-1" frame_id="-1" name=""   text="往常的玲在校园里走动时总是露出让所有男生都会回头的可爱笑容，但现在她完全失去了那份明朗。"   voices=""/><msg @l="287" char_id="-1" frame_id="-1" name=""   text="她的目的地……暂且是正门前的公交站。" voices=""/><msg @l="288" char_id="-1" frame_id="-1" name=""   text="不过……现在距离和朽木约定的时间还有一段空闲，暂且需要找个地方打发时间。" voices=""/><msg @l="290" char_id="1" frame_id="-1" name="玲" text="『………』" voices=""/><msg @l="292" char_id="-1" frame_id="-1" name=""   text="玲突然像是想到了什么，从包里拿出手机。" voices=""/><msg @l="293" char_id="-1" frame_id="-1" name=""   text="然后在电话簿中搜索刚在前几天注册的“大黑建设”，按下通话键。" voices=""/><msg @l="294" char_id="-1" frame_id="-1" name=""   text="她想着至少把获得推荐信的事告诉大黑社长，借此缓解一下这阴郁的心情。" voices=""/><msg @l="295" char_id="-1" frame_id="-1" name=""   text="而且，之前从大黑那里听说的与美帆的最终选拔也在她脑海中挥之不去。" voices=""/><msg @l="296" char_id="-1" frame_id="-1" name=""   text="……现在的玲，已经被逼到了这种地步。" voices=""/><char @l="299" id="rei" pos="auto" src="rei025"/><se @l="303" buf="3" loop="true" src="発信音" volume="1."/><stopse @l="307" buf="3"/><msg @l="309" char_id="-1" frame_id="-1" name="前台小姐"   text="『您好，这里是大黑建设南总町支社。』" voices=""/><msg @l="311" char_id="-1" frame_id="-1" name=""   text="几声呼叫音后，从电话那头传来了一位接待得体的女性声音。" voices=""/><msg @l="313" char_id="1" frame_id="-1" name="玲"   text="『那个，我是前几天来面试的白石……』" voices=""/><msg @l="315" char_id="-1" frame_id="-1" name="前台小姐"   text="『是的，我知道您。请问今天有什么事情吗？』" voices=""/><msg @l="317" char_id="1" frame_id="-1" name="玲"   text="『前几天面试时被告知需要准备的推荐信已经准备好了，但我不知道什么时候交给您比较好……』"   voices=""/><msg @l="319" char_id="-1" frame_id="-1" name="前台小姐"   text="『明白了，那我去询问一下负责人，请稍等。』" voices=""/><msg @l="321" char_id="1" frame_id="-1" name="玲" text="『……好的。』" voices=""/><se @l="325" buf="3" loop="true" src="保留音" volume="1."/><msg @l="327" char_id="-1" frame_id="-1" name=""   text="在如同按照手册操作般的应对后，电话里传来了某处听过的曲子作为等待音乐。" voices=""/><msg @l="329" char_id="1" frame_id="-1" name="玲" text="『………。』" voices=""/><stopse @l="333" buf="3"/><msg @l="335" char_id="-1" frame_id="-1" name="前台小姐" text="『让您久等了。』"   voices=""/><msg @l="337" char_id="-1" frame_id="-1" name="前台小姐"   text="『负责人说今天下午3点可以安排时间，您觉得如何？』" voices=""/><char @l="340" id="rei" pos="auto" src="rei024"/><msg @l="342" char_id="1" frame_id="-1" name="玲" text="『今天吗……。』" voices=""/><msg @l="344" char_id="-1" frame_id="-1" name="前台小姐"   text="『如果您时间不方便，我们可以另约日期再与您联系。』" voices=""/><char @l="347" id="rei" pos="auto" src="rei025"/><msg @l="349" char_id="1" frame_id="-1" name="玲" text="『………。』" voices=""/><msg @l="351" char_id="1" frame_id="-1" name="玲"   text="『不……今天下午3点可以吗？』" voices=""/><msg @l="353" char_id="-1" frame_id="-1" name="前台小姐"   text="『遵命，那么我们恭候您的到来。』" voices=""/><se @l="357" buf="1" src="携帯ボタン押下音" volume="1."/><char @l="360" id="rei" pos="auto" src="rei125"/><msg @l="362" char_id="1" frame_id="-1" name="玲" text="『………。』" voices=""/><msg @l="364" char_id="-1" frame_id="-1" name=""   text="玲凝视着已经挂断的手机，脸上浮现出一丝安心的表情。" voices=""/><msg @l="365" char_id="-1" frame_id="-1" name=""   text="虽然是突如其来的通知，但如果这意味着她必须消耗的时间中有一部分可以无条件地得到利用，对玲来说，这正是她求之不得的事。"   voices=""/><msg @l="366" char_id="-1" frame_id="-1" name=""   text="而且如果能够递交推荐信，就能更接近梦想中的进入大黑建设公司，和仰慕的稻庭同期入职的理想。" voices=""/><stopbgm @l="370" fadeout="1000"/><clear @l="376" class="all"/><msgshow @l="378" show="true"/><wait_chgmv/><bg @l="382" src="bg17m1"/><bgm @l="386" src="bgm09" volume="1."/><char @l="390" id="ookur" pos="auto" src="ookuro010"/><msg @l="392" char_id="-1" frame_id="-1" name="大黑"   text="『哎呀哎呀，您能来真是太好了。』" voices=""/><msg @l="394" char_id="-1" frame_id="-1" name=""   text="在车站前稍微打发了一下时间后，玲提前10分钟到达了大黑建设公司。" voices=""/><msg @l="395" char_id="-1" frame_id="-1" name=""   text="然后在接待员引导的等候室里等了约20分钟后，体格魁梧的大黑晃动着身体出现了。" voices=""/><clear @l="398" class="char"/><char @l="400" id="ookur" pos="left" src="ookuro010"/><char @l="403" id="rei" pos="right" src="rei015"/><msg @l="405" char_id="1" frame_id="-1" name="玲"   text="『不……应该是我冒昧突然打电话给您才是。』" voices=""/><msg @l="407" char_id="-1" frame_id="-1" name="大黑"   text="『没关系的。毕竟求职中的学生，在拿到至少一个内定前，都是难免会感到不安的呢。』"   voices=""/><msg @l="409" char_id="-1" frame_id="-1" name="大黑"   text="『尤其是像玲小姐这样选择门槛较高职种的人。』" voices=""/><msg @l="411" char_id="1" frame_id="-1" name="玲" text="『……嗯，是啊。』"   voices=""/><msg @l="413" char_id="-1" frame_id="-1" name=""   text="听着大黑的话，玲带着微微阴郁的表情随意地回答道。" voices=""/><msg @l="415" char_id="-1" frame_id="-1" name="大黑"   text="『那么，先让我收下推荐信吧。』" voices=""/><msg @l="417" char_id="1" frame_id="-1" name="玲" text="『啊，是的……这就是。』"   voices=""/><msg @l="419" char_id="-1" frame_id="-1" name=""   text="玲递给大黑一份刚在几小时前从朽木那里收到的推荐信。" voices=""/><msg @l="420" char_id="-1" frame_id="-1" name=""   text="就为了那一张A4大小的纸……玲舍弃了自己的尊严和重要的人。" voices=""/><msg @l="421" char_id="-1" frame_id="-1" name=""   text="不……应该说是为了获得那张纸带来的“自己的未来”。" voices=""/><msg @l="423" char_id="-1" frame_id="-1" name="大黑" text="『我确认收到了。』"   voices=""/><msg @l="425" char_id="1" frame_id="-1" name="玲"   text="『那个……这样的话，我能得到内定吗？』" voices=""/><msg @l="427" char_id="-1" frame_id="-1" name="大黑"   text="『关于详细结果，在前几天的考核结束之前无法告知您，这一点请您谅解。』" voices=""/><char @l="430" id="rei" pos="right" src="rei125"/><msg @l="432" char_id="1" frame_id="-1" name="玲" text="『是……这样啊。』" voices=""/><msg @l="434" char_id="-1" frame_id="-1" name="" text="玲咬紧下唇。"   voices=""/><msg @l="435" char_id="-1" frame_id="-1" name=""   text="为了想要得到的未来甚至背叛了美帆。在得到确切承诺之前，感到焦躁不安也是理所当然的。" voices=""/><char @l="438" id="ookur" pos="left" src="ookuro014"/><msg @l="440" char_id="-1" frame_id="-1" name="大黑" text="『您有什么不方便的地方吗？』"   voices=""/><char @l="443" id="rei" pos="right" src="rei015"/><msg @l="445" char_id="1" frame_id="-1" name="玲"   text="『也不是不方便……只是……』" voices=""/><msg @l="447" char_id="1" frame_id="-1" name="玲"   text="『如果可能的话，我想尽快知道结果……想得到内定后安心下来。』" voices=""/><char @l="450" id="ookur" pos="left" src="ookuro010"/><msg @l="452" char_id="-1" frame_id="-1" name="大黑"   text="『嗯，看来您有什么急迫的情况啊。』" voices=""/><char @l="455" id="rei" pos="right" src="rei115"/><msg @l="457" char_id="1" frame_id="-1" name="玲" text="『……』" voices=""/><msg @l="459" char_id="-1" frame_id="-1" name=""   text="听到大黑的话，玲投去了可能是她人生中第一次“恳求的目光”。" voices=""/><char @l="462" id="ookur" pos="left" src="ookuro010"/><msg @l="464" char_id="-1" frame_id="-1" name="大黑"   text="『那我们这样吧。先给您一个我们公司其他部门的临时内定，等您大学毕业时再调到您希望的部门。』"   voices=""/><char @l="467" id="rei" pos="right" src="rei014"/><msg @l="469" char_id="1" frame_id="-1" name="玲" text="『这种事……可以做到吗？』"   voices=""/><msg @l="471" char_id="-1" frame_id="-1" name="大黑"   text="『实际上，考虑到近年来罕见的不景气，我们为了支持新入职员工引入了一项新制度。』" voices=""/><msg @l="473" char_id="-1" frame_id="-1" name="大黑"   text="『而且我们正想设立一个让女性员工大展身手的特别部门。』" voices=""/><msg @l="475" char_id="-1" frame_id="-1" name="大黑"   text="『虽然没有先例……不过，没关系，会顺利的。』" voices=""/><msg @l="477" char_id="-1" frame_id="-1" name=""   text="说完这番话，大黑脸上露出了满面笑容。" voices=""/><char @l="480" id="rei" pos="right" src="rei115"/><msg @l="482" char_id="1" frame_id="-1" name="玲"   text="『既然如此，那就拜托您了。』" voices=""/><msg @l="484" char_id="-1" frame_id="-1" name="大黑"   text="『在您就读的大学里的那位，是叫稻庭君对吧？他也已经通过这个制度获得临时录用了。』" voices=""/><char @l="487" id="rei" pos="right" src="rei114"/><msg @l="489" char_id="1" frame_id="-1" name="玲" text="『啊！是这样吗？』"   voices=""/><msg @l="491" char_id="-1" frame_id="-1" name="大黑"   text="『是的，白石小姐也请一定要加油。』" voices=""/><char @l="494" id="rei" pos="right" src="rei015"/><msg @l="496" char_id="1" frame_id="-1" name="玲"   text="『我……无论什么事都会全力以赴的！请多关照！』" voices=""/><msg @l="498" char_id="-1" frame_id="-1" name=""   text="表现出无论什么都能接受的心态，玲坚定地说道。" voices=""/><msg @l="500" char_id="-1" frame_id="-1" name="大黑"   text="『能听到您这样说，我们这边也很感激。』" voices=""/><msg @l="502" char_id="-1" frame_id="-1" name="大黑"   text="『那么，接下来我想再进行一次简单的适性检测……您时间方面没问题吧？』" voices=""/><char @l="505" id="rei" pos="right" src="rei110"/><msg @l="507" char_id="1" frame_id="-1" name="玲" text="『是的，没问题。』"   voices=""/><msg @l="509" char_id="-1" frame_id="-1" name=""   text="对玲来说，从来没有一天像今天这样，觉得时间的浪费如此珍贵。" voices=""/><msg @l="510" char_id="-1" frame_id="-1" name=""   text="而且，因为向梦想迈进了一步，之前那种忧郁的心情一扫而空，她的表情逐渐变得明亮起来。" voices=""/><msg @l="512" char_id="-1" frame_id="-1" name="大黑"   text="『那太好了。那么请跟我来，我来带您过去。』" voices=""/><char @l="515" id="rei" pos="right" src="rei120"/><msg @l="517" char_id="1" frame_id="-1" name="玲" text="『麻烦您了。』" voices=""/><clear @l="521" layer="ookur"/><clear @l="524" layer="rei"/><msg @l="526" char_id="-1" frame_id="-1" name=""   text="大黑先走了出去，玲跟在他背后走着。" voices=""/><msg @l="527" char_id="-1" frame_id="-1" name=""   text="听到两人对话的员工们，脸上带着几分愉快的笑容。" voices=""/><msg @l="528" char_id="-1" frame_id="-1" name="" text="又来了一个……" voices=""/><msg @l="529" char_id="-1" frame_id="-1" name="" text="有人小声地嘀咕着。"   voices=""/><msg @l="530" char_id="-1" frame_id="-1" name=""   text="不过，这些话并没有……传到玲的耳中———。" voices=""/><stopbgm @l="534" fadeout="1000"/><clear @l="540" class="all"/><msgshow @l="542" show="true"/><wait_chgmv/><bg @l="546" src="bg03a"/><bgm @l="550" src="bgm04" volume="1."/><char @l="554" id="miho" pos="auto" src="miho010"/><msg @l="556" char_id="0" frame_id="-1" name="美帆" text="『我回来啦。』" voices=""/><msg @l="558" char_id="-1" frame_id="-1" name="" text="———黄昏时分。" voices=""/><msg @l="559" char_id="-1" frame_id="-1" name=""   text="我带着一整天的疲惫身心回到了家。" voices=""/><char @l="563" id="miho" pos="auto" src="miho014"/><msg @l="565" char_id="0" frame_id="-1" name="美帆" text="『咦……玲小姐不在吗？』"   voices=""/><msg @l="567" char_id="-1" frame_id="-1" name=""   text="我把手里的购物袋放在客厅桌上，然后开始四处寻找不见踪影的玲小姐。" voices=""/><msg @l="568" char_id="-1" frame_id="-1" name=""   text="客厅当然，厨房，厕所，浴室，玲小姐的房间……" voices=""/><msg @l="569" char_id="-1" frame_id="-1" name=""   text="我大致找了一遍，但果然哪里都没有玲小姐的身影。" voices=""/><char @l="573" id="miho" pos="auto" src="miho110"/><msg @l="575" char_id="0" frame_id="-1" name="美帆"   text="『奇怪啊……按平常这个时间她应该已经回来了才对。』" voices=""/><msg @l="577" char_id="-1" frame_id="-1" name=""   text="这么嘀咕着，我忽然想起了昨天的事。" voices=""/><msg @l="579" char_id="0" frame_id="-1" name="美帆" text="『找工作，很辛苦吧……』"   voices=""/><msg @l="581" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><char @l="585" id="miho" pos="auto" src="miho010"/><msg @l="587" char_id="0" frame_id="-1" name="美帆" text="『先准备晚饭吧……』"   voices=""/><char @l="590" id="miho" pos="auto" src="miho011"/><msg @l="592" char_id="0" frame_id="-1" name="美帆"   text="『为了让疲惫的玲小姐恢复元气，今天要做美帆酱特制的超级营养餐！』" voices=""/><msg @l="594" char_id="-1" frame_id="-1" name=""   text="在空无一人的家里，我一个人装出了开朗的样子。" voices=""/><msg @l="596" char_id="-1" frame_id="-1" name=""   text="虽然是为了给自己打气才说的话，但意识到这有点幼稚后，我突然感到害羞，不由自主地环顾四周。" voices=""/><char @l="599" id="miho" pos="auto" src="miho113"/><msg @l="601" char_id="0" frame_id="-1" name="美帆" text="『还好没人看见。』"   voices=""/><msg @l="603" char_id="-1" frame_id="-1" name="" text="我脸颊泛红，深深地呼出一口气。"   voices=""/><stopbgm @l="608" fadeout="1000"/><clear @l="614" class="all"/><msgshow @l="616" show="true"/><wait_chgmv/><bg @l="620" src="bg03b"/><bgm @l="624" src="bgm03" volume="1."/><char @l="628" id="miho" pos="auto" src="miho136"/><msg @l="630" char_id="0" frame_id="-1" name="美帆"   text="『饭菜……已经完全凉了啊。』" voices=""/><msg @l="632" char_id="-1" frame_id="-1" name=""   text="从准备好晚饭到现在，已经过去多久了呢？" voices=""/><msg @l="633" char_id="-1" frame_id="-1" name=""   text="客厅的时钟指向刚过21点的位置。" voices=""/><msg @l="634" char_id="-1" frame_id="-1" name=""   text="按照平时19点左右的晚餐时间来算，那就意味着已经过去了两个多小时……。" voices=""/><msg @l="635" char_id="-1" frame_id="-1" name="" text="我就这样漫无目的地想着。"   voices=""/><msg @l="636" char_id="-1" frame_id="-1" name=""   text="顺便一提，经过反复犹豫后，我自己还是抵挡不住饥饿，不久前已经吃完了饭，并换上了居家服。" voices=""/><msg @l="637" char_id="-1" frame_id="-1" name=""   text="因为等待迟迟不归的玲小姐而感到疲惫，本想回到自己房间，但是……一旦在客厅的沙发上坐下，这次却又懒得站起来了。"   voices=""/><msg @l="639" char_id="0" frame_id="-1" name="美帆"   text="『玲小姐要是晚回来的话，提前说一声就好了啊……』" voices=""/><msg @l="641" char_id="-1" frame_id="-1" name=""   text="收拾只有一个人的餐具也莫名觉得麻烦，我就这样无所事事地看了一会儿电视。" voices=""/><msg @l="643" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="645" char_id="-1" frame_id="-1" name=""   text="每当广告开始时，我就起身去厨房泡咖啡或者上个厕所，就这样度过了大约一个小时……" voices=""/><stopbgm @l="649" fadeout="1000"/><se @l="653" buf="1" src="鍵を開ける音" volume="1."/><char @l="657" id="miho" pos="auto" src="miho134"/><msg @l="659" char_id="0" frame_id="-1" name="美帆" text="『啊……是回来了吗？』"   voices=""/><bgm @l="663" src="bgm02" volume="1."/><msg @l="665" char_id="-1" frame_id="-1" name="" text="玄关那边传来了开锁的声音。"   voices=""/><msg @l="666" char_id="-1" frame_id="-1" name=""   text="看了一眼时钟，已经快到晚上10点了。" voices=""/><char @l="670" id="miho" pos="auto" src="miho031"/><msg @l="672" char_id="0" frame_id="-1" name="美帆" text="『真是的，玲小姐回来得真晚啊。』"   voices=""/><msg @l="674" char_id="-1" frame_id="-1" name=""   text="我一边朝着接近的脚步声喊着，一边回过头去。" voices=""/><msg @l="675" char_id="-1" frame_id="-1" name=""   text="毫无疑问地……我转身时坚信玲小姐一定在那里。" voices=""/><stopbgm @l="679" fadeout="1000"/><msg @l="681" char_id="-1" frame_id="-1" name="" text="但是……。" voices=""/><char @l="685" id="kutsu" pos="auto" src="kutsu010"/><bgm @l="689" src="bgm15" volume="1."/><msg @l="691" char_id="-1" frame_id="-1" name="朽木"   text="『哟，仲根同学……像这样正式交谈已经很久没有了吧？』" voices=""/><msg @l="693" char_id="-1" frame_id="-1" name=""   text="……站在客厅入口的不是玲小姐，而是朽木教授。" voices=""/><msg @l="694" char_id="-1" frame_id="-1" name=""   text="因为自从痴汉那件事后，我有意识地避免与他见面，从这个意义上说确实很久没见了。" voices=""/><msg @l="695" char_id="-1" frame_id="-1" name=""   text="……只是，没想到时隔多日的重逢会以这种形式出现。" voices=""/><clear @l="698" class="char"/><char @l="700" id="kutsu" pos="right" src="kutsu010"/><char @l="703" id="miho" pos="left" src="miho034"/><msg @l="705" char_id="0" frame_id="-1" name="美帆" text="『朽木教授为什么会在这里！？』"   voices=""/><msg @l="707" char_id="0" frame_id="-1" name="美帆"   text="『门口应该是锁着的才对……啊。』" voices=""/><char @l="710" id="miho" pos="left" src="miho134"/><msg @l="712" char_id="-1" frame_id="-1" name=""   text="这时，美帆发现了朽木手中握着的“那个东西”。" voices=""/><msg @l="713" char_id="-1" frame_id="-1" name="" text="那是一个熟悉形状的金属片——"   voices=""/><msg @l="714" char_id="-1" frame_id="-1" name=""   text="即使在远处，也能立刻认出那是这栋公寓使用的钥匙。" voices=""/><msg @l="716" char_id="0" frame_id="-1" name="美帆" text="『为什么教授会有那个……』"   voices=""/><char @l="719" id="kutsu" pos="right" src="kutsu018"/><msg @l="721" char_id="-1" frame_id="-1" name="朽木"   text="『那种事怎样都无所谓吧。比起这个，现在你是不是应该有点别的担忧呢？』" voices=""/><char @l="724" id="miho" pos="left" src="miho034"/><msg @l="726" char_id="0" frame_id="-1" name="美帆" text="『咦……？』" voices=""/><msg @l="728" char_id="-1" frame_id="-1" name="朽木"   text="『你不明白吗？现在这个地方，只有一男一女而已。』" voices=""/><char @l="731" id="miho" pos="left" src="miho035"/><msg @l="733" char_id="0" frame_id="-1" name="美帆" text="『这是什么……意思。』"   voices=""/><msg @l="735" char_id="-1" frame_id="-1" name="朽木"   text="『是说要继续在电车上的事情啊。』" voices=""/><clear @l="739" layer="kutsu"/><msg @l="741" char_id="-1" frame_id="-1" name="" text="朽木教授快步朝我走来。"   voices=""/><char @l="744" id="miho" pos="left" src="miho034"/><msg @l="746" char_id="0" frame_id="-1" name="美帆" text="『……！？』" voices=""/><clear @l="750" layer="miho"/><msg @l="752" char_id="-1" frame_id="-1" name=""   text="这时我终于意识到他的意图，慌忙想与教授拉开距离……" voices=""/><msg @l="753" char_id="-1" frame_id="-1" name="" text="然而，我的反应稍晚了一些……"   voices=""/><char @l="756" id="miho" pos="left" src="miho035"/><char @l="758" id="kutsu" pos="auto" src="kutsu018"/><msg @l="760" char_id="0" frame_id="-1" name="美帆" text="『啊……！？』" voices=""/><msg @l="762" char_id="-1" frame_id="-1" name=""   text="就在我想要跑开的瞬间，朽木教授抓住了我的手臂，将我推到了墙上。" voices=""/><msg @l="763" char_id="-1" frame_id="-1" name=""   text="接着……教授用自己的身体和墙壁将我夹在中间，整个人压了过来。" voices=""/><clear @l="766" class="char"/><char @l="768" id="miho" pos="center" src="miho035f" y="-80"/><msg @l="770" char_id="-1" frame_id="-1" name="朽木" text="『呵呵呵，抓到你了。』"   voices=""/><msg @l="772" char_id="0" frame_id="-1" name="美帆" text="『呀……不，请放开我！！』"   voices=""/><msg @l="774" char_id="-1" frame_id="-1" name="朽木" text="『呵呵呵，真可爱啊。』"   voices=""/><msg @l="776" char_id="0" frame_id="-1" name="美帆"   text="『不，救命啊……玲小姐……玲小姐！！』" voices=""/><msg @l="778" char_id="-1" frame_id="-1" name="朽木"   text="『不管你怎么呼救她都不会来的。绝对不会。』" voices=""/><char @l="781" id="miho" pos="center" src="miho034f" y="-80"/><msg @l="783" char_id="0" frame_id="-1" name="美帆"   text="『怎么会……啊，难道你对玲小姐也做了这种事！？』" voices=""/><msg @l="785" char_id="-1" frame_id="-1" name="朽木" text="『嗯，谁知道呢。』"   voices=""/><char @l="788" id="miho" pos="center" src="miho035f" y="-80"/><msg @l="790" char_id="0" frame_id="-1" name="美帆" text="『……你真是太过分了。』"   voices=""/><msg @l="792" char_id="-1" frame_id="-1" name="朽木" text="『不如你直接去问问她如何？』"   voices=""/><msg @l="794" char_id="-1" frame_id="-1" name=""   text="教授嘴角扭曲着，隔着衣服粗暴地揉捏着我的胸部。" voices=""/><char @l="797" id="miho" pos="center" src="miho135f" y="-80"/><msg @l="799" char_id="0" frame_id="-1" name="美帆"   text="『呀，不啊啊……住手，请住手！！』" voices=""/><msg @l="801" char_id="-1" frame_id="-1" name="朽木"   text="『死心吧，这公寓的隔音非常完美……不管你怎么喊叫，都不会有人注意到这里发生的事。』" voices=""/><char @l="804" id="miho" pos="center" src="miho035f" y="-80"/><msg @l="806" char_id="0" frame_id="-1" name="美帆"   text="『那是谎话……救命，谁来救救我！！』" voices=""/><msg @l="808" char_id="-1" frame_id="-1" name="朽木" text="『我不是说了没用吗。』"   voices=""/><msg @l="810" char_id="-1" frame_id="-1" name=""   text="他嘲笑般地吐出这句话，随后将原本揉捏着我胸部的手伸进了我的短裤里。" voices=""/><begin_trans @l="814" time="500"/><layer @l="815" id="cutin_f" src="game_window_cutin" x="20" y="20" z="-1001"/><layer @l="816" id="cutin" src="cut001b" x="32" y="32" z="-1000"/><end_trans @l="817"/><msg @l="819" char_id="-1" frame_id="-1" name=""   text="坚硬的指尖……隔着内裤贴上了我的私处。" voices=""/><msg @l="820" char_id="-1" frame_id="-1" name="" text="摸摸，摸摸。" voices=""/><msg @l="822" char_id="0" frame_id="-1" name="美帆" text="『啊，不啊啊啊啊啊！！』"   voices=""/><msg @l="824" char_id="-1" frame_id="-1" name=""   text="在朽木教授的指尖隔着内裤描绘我花瓣的瞬间，我使出全身力气发出了最大的惨叫。" voices=""/><msg @l="826" char_id="-1" frame_id="-1" name="朽木"   text="『呵呵……在电车上只能隔着内裤摸你。今天我要好好品尝你这里的滋味。』"   voices=""/><msg @l="828" char_id="-1" frame_id="-1" name=""   text="说着，他把手伸进了我的内裤里。" voices=""/><begin_trans @l="831" time="500"/><layer @l="832" id="cutin_f" src="game_window_cutin" x="20" y="20" z="-1001"/><layer @l="833" id="cutin" src="cut001a" x="32" y="32" z="-1000"/><end_trans @l="834"/><msg @l="836" char_id="-1" frame_id="-1" name="" text="咕啾。" voices=""/><msg @l="838" char_id="0" frame_id="-1" name="美帆" text="『啊，不啊啊啊啊啊啊！』"   voices=""/><clear @l="841" class="char"/><begin_trans @l="843" time="500"/><clear @l="844" layer="cutin_f"/><clear @l="845" layer="cutin"/><end_trans @l="846"/><se @l="850" buf="1" src="人とぶつかる音" volume="1."/><msg @l="851" char_id="-1" frame_id="-1" name="" text="砰！" voices=""/><msg @l="853" char_id="-1" frame_id="-1" name=""   text="我一边尖叫着一边拼命推开朽木教授，跑向自己的房间。" voices=""/><char @l="856" id="kutsu" pos="center" src="kutsu010f" y="-80"/><msg @l="858" char_id="-1" frame_id="-1" name="朽木" text="『哼……真是不懂事的孩子啊。』"   voices=""/><msg @l="860" char_id="-1" frame_id="-1" name=""   text="对于我发出的尖叫，朽木教授露骨地抛下一句讽刺的话，然后跟了上来。" voices=""/><clear @l="866" class="all"/><msgshow @l="868" show="true"/><wait_chgmv/><bg @l="872" src="bg01b"/><char @l="874" id="miho" pos="auto" src="miho135"/><msg @l="876" char_id="-1" frame_id="-1" name=""   text="我上气不接下气地从里面按住自己房间的门把手。" voices=""/><msg @l="878" char_id="0" frame_id="1" name="美帆" text="（为什么，为什么会变成这样……）"   voices=""/><msg @l="881" char_id="-1" frame_id="-1" name="" text="咔嚓，咔嚓。" voices=""/><char @l="884" id="miho" pos="auto" src="miho134"/><msg @l="886" char_id="0" frame_id="1" name="美帆" text="『呃……！』" voices=""/><msg @l="888" char_id="-1" frame_id="-1" name="朽木"   text="『仲根同学，不用那么害怕嘛。放心吧。我会让你舒服的。你一定会上瘾的……。』"   voices=""/><char @l="891" id="miho" pos="auto" src="miho035"/><msg @l="893" char_id="0" frame_id="1" name="美帆" text="『求求您！请回去吧！！』"   voices=""/><msg @l="895" char_id="-1" frame_id="-1" name="朽木"   text="『没那么容易哦。既然好不容易受到邀请，那就得好好享受。』" voices=""/><char @l="898" id="miho" pos="auto" src="miho034"/><msg @l="900" char_id="0" frame_id="1" name="美帆" text="『诶……？』" voices=""/><msg @l="902" char_id="-1" frame_id="-1" name=""   text="听到这话，我一瞬间分神了，握住门把的手也不自觉地松了力气。" voices=""/><msg @l="903" char_id="-1" frame_id="-1" name=""   text="当然，教授没有错过这一瞬间，用力推开门闯进了房间。" voices=""/><se @l="907" buf="1" src="人とぶつかる音" volume="1."/><shake @l="911" amp="10" class="all" cycle="30" duration="1000"   type="random"/><msg @l="913" char_id="-1" frame_id="-1" name="" text="咚！" voices=""/><char @l="916" id="miho" pos="auto" src="miho134"/><msg @l="918" char_id="0" frame_id="1" name="美帆" text="『呀啊！！』" voices=""/><clear @l="921" class="char"/><msg @l="923" char_id="-1" frame_id="-1" name=""   text="我被猛然打开的门冲得摔倒在地。" voices=""/><msg @l="925" char_id="-1" frame_id="-1" name="朽木"   text="『虽说吊男人胃口是女人的本领，但吊太久可不行啊。』" voices=""/><char @l="928" id="miho" pos="center" src="miho035f" y="-80"/><msg @l="930" char_id="-1" frame_id="-1" name="" text="朽木教授慢慢地向我靠近。"   voices=""/><msg @l="931" char_id="-1" frame_id="-1" name=""   text="我拼命想要逃跑，即使摔倒了也在往后退。" voices=""/><msg @l="932" char_id="-1" frame_id="-1" name=""   text="然而，在这不算宽敞的房间里没有地方可逃，很快我就被逼到了房间的角落。" voices=""/><msg @l="933" char_id="-1" frame_id="-1" name=""   text="接着，朽木教授从口袋里拿出一个长方形的……如果要形容的话，就像是稍大一点的手机那样的“东西”，然后抵在了我的脖子上。"   voices=""/><char @l="936" id="miho" pos="center" src="miho034f" y="-80"/><msg @l="938" char_id="0" frame_id="1" name="美帆" text="『诶……？』" voices=""/><msg @l="940" char_id="-1" frame_id="-1" name="朽木" text="『这是惩罚。』" voices=""/><msg @l="942" char_id="-1" frame_id="-1" name=""   text="说着，朽木教授用指尖操作了手中那个长方形的物体。" voices=""/><msg @l="943" char_id="-1" frame_id="-1" name="" text="瞬间———。" voices=""/><se @l="947" buf="1" src="ムチの音" volume="1."/><flash @l="951" count="4" fade="100" image="white"/><char @l="954" id="miho" pos="center" src="miho134f" y="-80"/><msg @l="956" char_id="0" frame_id="1" name="美帆" text="『呜啊！？』" voices=""/><msg @l="958" char_id="-1" frame_id="-1" name=""   text="耳边响起一阵巨大的声音，紧接着从脖颈处传来一阵刺痛，迅速蔓延至全身。" voices=""/><char @l="961" id="miho" pos="center" src="miho035f" y="-80"/><msg @l="963" char_id="0" frame_id="1" name="美帆" text="『什么……刚才那个……？』"   voices=""/><msg @l="965" char_id="-1" frame_id="-1" name=""   text="当我转动头部想看看抵在脖子上的“那个东西”时，一阵眩晕感袭来。" voices=""/><msg @l="966" char_id="-1" frame_id="-1" name=""   text="刺痛瞬间消失，取而代之的是一种奇怪的麻痹感袭击了全身。" voices=""/><msg @l="968" char_id="-1" frame_id="-1" name="朽木"   text="『这叫做电击枪，是用来像这样使对方失去行动能力的东西。』" voices=""/><msg @l="970" char_id="-1" frame_id="-1" name=""   text="教授嘲讽地说着，将手中的机器展示在我眼前。" voices=""/><msg @l="972" char_id="0" frame_id="1" name="美帆" text="『怎…么…会…。』"   voices=""/><clear @l="975" class="char"/><msg @l="977" char_id="-1" frame_id="-1" name=""   text="我的身体违背自己的意愿，一下子失去力气倒在了地上。" voices=""/><msg @l="979" char_id="-1" frame_id="-1" name="" text="意识渐渐远去，眼前一片漆黑。"   voices=""/><clear @l="982" class="all"/><wait_chgmv/><bg @l="984" src="bg01b"/><msg @l="986" char_id="-1" frame_id="-1" name="朽木"   text="『没什么，这只是电流和电压都不高的现成产品…虽然可能会暂时意识模糊，但不会留下什么后遗症，请放心。』"   voices=""/><clear @l="989" class="all"/><wait_chgmv/><bg @l="991" src="bg01b"/><msg @l="993" char_id="-1" frame_id="-1" name=""   text="朽木教授带着一脸奸笑，滔滔不绝地讲述着什么专业知识。" voices=""/><msg @l="994" char_id="-1" frame_id="-1" name=""   text="我听着那些仿佛从远处传来的话语…慢慢地放开了意识。" voices=""/><stopbgm @l="998" fadeout="1000"/><clear @l="1004" class="all"/><msgshow @l="1006" show="true"/><wait_chgmv/><bg @l="1010" src="bg01b"/><msg @l="1012" char_id="0" frame_id="1" name="美帆" text="『嗯…。』" voices=""/><msg @l="1014" char_id="-1" frame_id="-1" name=""   text="伴随着微微头痛醒来后，映入眼帘的是那熟悉的天花板。" voices=""/><msg @l="1016" char_id="0" frame_id="1" name="美帆"   text="『这里是、我的房间……咦……我……。』" voices=""/><char @l="1020" id="kutsu" pos="center" src="kutsu010f" y="-80"/><bgm @l="1024" src="bgm15" volume="1."/><msg @l="1026" char_id="-1" frame_id="-1" name="朽木" text="『看来你醒了啊，仲根同学。』"   voices=""/><msg @l="1028" char_id="-1" frame_id="-1" name=""   text="朽木教授的脸在我的视野中逼近。" voices=""/><msg @l="1029" char_id="-1" frame_id="-1" name=""   text="我……被朽木教授以压在身上的姿势，安置在床上。" voices=""/><msg @l="1031" char_id="0" frame_id="1" name="美帆"   text="『啊……朽木教授………为什么……啊！？』" voices=""/><msg @l="1033" char_id="-1" frame_id="-1" name=""   text="想起刚才发生的事，我慌忙想要坐起身来。" voices=""/><msg @l="1034" char_id="-1" frame_id="-1" name=""   text="……但，当我试图移动身体时，头脑一片混沌根本做不到。" voices=""/><msg @l="1036" char_id="-1" frame_id="-1" name="朽木"   text="『你现在正处于轻微脑震荡状态……我劝你还是乖乖的好。』" voices=""/><char @l="1039" id="kutsu" pos="center" src="kutsu018f" y="-80"/><msg @l="1041" char_id="-1" frame_id="-1" name="朽木"   text="『而且现在，如果让你逃跑的话，那我精心准备的前戏就全白费了。』" voices=""/><msg @l="1043" char_id="-1" frame_id="-1" name="" text="教授邪笑着。"   voices=""/><msg @l="1045" char_id="0" frame_id="1" name="美帆"   text="『前戏……什……啊，呀！！我为什么是裸体的啊！？』" voices=""/><msg @l="1047" char_id="-1" frame_id="-1" name=""   text="我终于注意到自己的衣服已经被脱掉了。" voices=""/><msg @l="1049" char_id="0" frame_id="1" name="美帆" text="『不要……请不要看！！』"   voices=""/><msg @l="1051" char_id="-1" frame_id="-1" name="朽木"   text="『现在说这个有什么用，你昏迷的时候，我已经把你全身上下仔细地欣赏并舔遍了。』" voices=""/><clear @l="1054" class="char"/><msg @l="1056" char_id="-1" frame_id="-1" name=""   text="朽木教授一边这么说着，一边将舌头舔上她那具有适当弹性的乳房，似乎想要进一步品尝她那不谙世事的柔嫩肌肤。" voices=""/><msg @l="1057" char_id="-1" frame_id="-1" name=""   text="看来，在她昏迷期间所做的事情还远远不能满足他。" voices=""/><char @l="1060" id="miho" pos="center" src="miho105f" y="-80"/><msg @l="1062" char_id="0" frame_id="1" name="美帆" text="『不要啊啊……住手。』"   voices=""/><msg @l="1064" char_id="-1" frame_id="-1" name=""   text="无视我痛苦的叫喊，教授吮吸着我的右乳房。" voices=""/><msg @l="1066" char_id="-1" frame_id="-1" name="" text="手指也开始轻轻挑逗我的阴唇。"   voices=""/><begin_trans @l="1069" time="500"/><layer @l="1070" id="cutin_f" src="game_window_cutin" x="20" y="20"   z="-1001"/><layer @l="1071" id="cutin" src="cut003a" x="32" y="32" z="-1000"/><end_trans @l="1072"/><char @l="1075" id="miho" pos="center" src="miho005f" y="-80"/><msg @l="1077" char_id="0" frame_id="1" name="美帆" text="『啊……不要。』"   voices=""/><msg @l="1079" char_id="-1" frame_id="-1" name=""   text="突然被陌生人触碰私密部位，我的身体不禁颤抖了一下。" voices=""/><msg @l="1080" char_id="-1" frame_id="-1" name=""   text="教授的舌头不断挑逗着我的乳首，看到它变得更加挺立后似乎很满意，随即又更加用力地舔舐、揉捏。" voices=""/><msg @l="1082" char_id="-1" frame_id="-1" name="朽木"   text="『你的身体美得让人不敢亵渎。』" voices=""/><msg @l="1084" char_id="-1" frame_id="-1" name=""   text="教授的手指和舌头一样，更加肆无忌惮地揉捏我的肉核，开始描摹我的花瓣。" voices=""/><char @l="1087" id="miho" pos="center" src="miho105f" y="-80"/><msg @l="1089" char_id="0" frame_id="1" name="美帆" text="『呜啊……不要，这种事不要！』"   voices=""/><msg @l="1091" char_id="-1" frame_id="-1" name=""   text="听着我抵抗的声音，朽木教授轻咬着乳首玩弄。" voices=""/><msg @l="1092" char_id="-1" frame_id="-1" name=""   text="在充分品尝那触感之后，他又将嘴凑向我重要的私密部位。" voices=""/><begin_trans @l="1095" time="500"/><layer @l="1096" id="cutin_f" src="game_window_cutin" x="20" y="20"   z="-1001"/><layer @l="1097" id="cutin" src="cut003" x="32" y="32" z="-1000"/><end_trans @l="1098"/><char @l="1100" id="miho" pos="center" src="miho005f" y="-80"/><msg @l="1102" char_id="0" frame_id="1" name="美帆" text="『啊啊……！』" voices=""/><msg @l="1104" char_id="-1" frame_id="-1" name=""   text="对于还不懂男人的我来说，这是难以忍受的耻辱。我在喉咙深处呻吟着扭动身体，但教授并没有饶过我。" voices=""/><msg @l="1105" char_id="-1" frame_id="-1" name=""   text="他盯着我身体的动作，直接用舌头刺激着最敏感的阴蒂。" voices=""/><char @l="1108" id="miho" pos="center" src="miho004f" y="-80"/><msg @l="1110" char_id="0" frame_id="1" name="美帆" text="『嘶、呀啊！』" voices=""/><msg @l="1112" char_id="-1" frame_id="-1" name=""   text="仿佛全身通过电流一般，我的身体不住地颤抖。教授看到这反应后，更加啧啧有声地用舌头拨弄着蜜液，继续着舔舐。"   voices=""/><char @l="1115" id="miho" pos="center" src="miho005f" y="-80"/><msg @l="1117" char_id="0" frame_id="1" name="美帆"   text="『呀啊啊……这种事，太过分了……太过分了啊。』" voices=""/><begin_trans @l="1120" time="500"/><clear @l="1121" layer="cutin_f"/><clear @l="1122" layer="cutin"/><end_trans @l="1123"/><char @l="1125" id="kutsu" pos="center" src="kutsu018f" y="-80"/><msg @l="1127" char_id="-1" frame_id="-1" name="朽木"   text="『很遗憾，更过分的事才刚刚开始呢。』" voices=""/><char @l="1130" id="miho" pos="center" src="miho004f" y="-80"/><msg @l="1132" char_id="0" frame_id="1" name="美帆" text="『诶……？』" voices=""/><msg @l="1134" char_id="-1" frame_id="-1" name=""   text="伴随着一丝轻笑，朽木教授拉下裤子的拉链，从里面掏出那又硬又挺的怪异生物，似乎是故意展示给我看。"   voices=""/><msg @l="1135" char_id="-1" frame_id="-1" name=""   text="接着，他将那生物抵在我的私密处，像是在确定目标一般来回摩擦了几次。" voices=""/><msg @l="1137" char_id="0" frame_id="1" name="美帆" text="『……！？』" voices=""/><char @l="1140" id="kutsu" pos="center" src="kutsu010f" y="-80"/><msg @l="1142" char_id="-1" frame_id="-1" name="朽木"   text="『品尝了你鲜嫩的身体后，我的那话儿已经变成这样了。』" voices=""/><msg @l="1144" char_id="-1" frame_id="-1" name=""   text="然后教授将那勃起的肉棒顶端抵在了我的私密处。" voices=""/><clear @l="1147" class="char"/><char @l="1149" id="miho" pos="left" src="miho105"/><char @l="1151" id="kutsu" pos="right" src="kutsu010"/><msg @l="1153" char_id="0" frame_id="1" name="美帆"   text="『不啊啊…不要，请住手！！』" voices=""/><msg @l="1155" char_id="0" frame_id="1" name="美帆"   text="『我、我…是第一次啊…求求您了！！』" voices=""/><char @l="1158" id="kutsu" pos="right" src="kutsu018"/><msg @l="1160" char_id="-1" frame_id="-1" name="朽木"   text="『呵呵，你是处女这点我在充分玩弄你的秘部时就已经知道了。』" voices=""/><msg @l="1162" char_id="-1" frame_id="-1" name="朽木"   text="『但是，那又怎样呢？』" voices=""/><char @l="1165" id="miho" pos="left" src="miho005"/><msg @l="1167" char_id="0" frame_id="1" name="美帆" text="『……。』" voices=""/><char @l="1170" id="kutsu" pos="right" src="kutsu010"/><msg @l="1172" char_id="-1" frame_id="-1" name="朽木"   text="『至少第一次要给喜欢的人之类的幻想，还是趁早放弃比较好哦…特别是在这个南总町这个地方。』" voices=""/><char @l="1175" id="miho" pos="left" src="miho105"/><msg @l="1177" char_id="0" frame_id="1" name="美帆" text="『那是，什么意思…？』"   voices=""/><msg @l="1179" char_id="-1" frame_id="-1" name="朽木"   text="『嗯…自从电车那件事以来，禁欲太久了，我似乎话有点多了。』" voices=""/><msg @l="1181" char_id="-1" frame_id="-1" name=""   text="教授毫不在意地说完，又用那丑陋肉柱的顶端在我的秘缝上下来回滑动起来。" voices=""/><char @l="1184" id="miho" pos="left" src="miho005"/><msg @l="1186" char_id="0" frame_id="1" name="美帆" text="『嗯嗯……。』" voices=""/><msg @l="1188" char_id="-1" frame_id="-1" name=""   text="大概是因为被过度玩弄的缘故，我的那里似乎变得异常敏感，每当他用顶端摩擦时，一阵阵麻痹感就从头顶流窜而过。"   voices=""/><char @l="1191" id="kutsu" pos="right" src="kutsu018"/><msg @l="1193" char_id="-1" frame_id="-1" name="朽木"   text="『作为处女来说湿得相当不错，这样的话在这个镇上肯定能过得很好。』" voices=""/><msg @l="1195" char_id="0" frame_id="1" name="美帆"   text="『……呀……不要……请住手……。』" voices=""/><msg @l="1197" char_id="-1" frame_id="-1" name=""   text="教授又一次低语着关于这个镇子的事情，同时像是品尝我的触感一般，反复用顶端摩擦着我的缝隙，发出淫靡的水声。" voices=""/><clear @l="1203" class="all"/><label @l="1206" id="event_scene46"/><msg @l="1208" char_id="-1" frame_id="-1" name="朽木"   text="『呵呵呵，那么……就开始期待已久的开通仪式吧。』" voices=""/><msg @l="1210" char_id="0" frame_id="1" name="美帆" text="『……！！』" voices=""/><msg @l="1212" char_id="-1" frame_id="-1" name=""   text="教授伴随着充满喜色的声音，猛地挺腰压了过来。" voices=""/><msg @l="1213" char_id="-1" frame_id="-1" name=""   text="那一瞬间———仿佛身体被整个劈成两半的疼痛，贯穿了我的下腹部。" voices=""/><label @l="1217" id="chart_line29"/><wait_chgmv/><ev @l="1221" src="ev-046"/><description @l="1224" text="不情愿的交易B"/><bgm @l="1228" src="bgm14" volume="1."/><msg @l="1230" char_id="0" frame_id="1" name="美帆" text="『啊啊啊！！』"   voices="miho10590"/><msg @l="1232" char_id="-1" frame_id="-1" name=""   text="教授的欲望深深埋入阴道深处，撕破了我的处女膜，一下子将顶端直抵子宫。" voices=""/><msg @l="1233" char_id="-1" frame_id="-1" name=""   text="因撕裂般的剧痛，我扭动身体发出惨叫。" voices=""/><msg @l="1235" char_id="-1" frame_id="-1" name="朽木"   text="『哦，不愧是处女……真紧啊。』" voices=""/><msg @l="1237" char_id="-1" frame_id="-1" name=""   text="炽热坚硬的东西插入身体深处，强烈的冲击让我忍不住弓起身子。我屏住呼吸忍受着被撕裂的痛楚，忍耐着从下腹部蔓延至全身的疼痛与厌恶。"   voices=""/><msg @l="1239" char_id="-1" frame_id="-1" name=""   text="教授像是确认着被插入的胎内感觉一般前后摆动腰部，愉快地抽送着肉棒。" voices=""/><msg @l="1241" char_id="0" frame_id="1" name="美帆"   text="『呃啊……不，不要动……疼……好疼啊……。』" voices="miho10600"/><msg @l="1243" char_id="-1" frame_id="-1" name=""   text="他一动腰，插入的肉柱就摩擦着刚被撕裂的私密处。……那产生的剧痛直冲脑门，我不禁发出了痛苦的呻吟。"   voices=""/><msg @l="1245" char_id="-1" frame_id="-1" name="朽木"   text="『没什么，这种紧致感很快就会结束。呵呵呵，而且你很快就会习惯，变得欲仙欲死。』" voices=""/><msg @l="1247" char_id="-1" frame_id="-1" name=""   text="教授不负责任地笑着，抓住我的腰，加大了抽送的力度。" voices=""/><msg @l="1248" char_id="-1" frame_id="-1" name=""   text="每一次，我都会被他的龟头拖拽着子宫内壁的感触和无法呼吸的疼痛侵袭。" voices=""/><msg @l="1250" char_id="0" frame_id="1" name="美帆"   text="『啊、啊、啊……不要啊……痛……唔，啊呜！！』" voices="miho10610"/><msg @l="1252" char_id="0" frame_id="1" name="美帆"   text="『呜啊……唔，唔，唔……好痛……住手，请不要动！！』" voices="miho10620"/><msg @l="1254" char_id="-1" frame_id="-1" name="朽木"   text="『说什么傻话啊。已经插入如此舒适的阴道了，不动腰简直愚蠢。』" voices=""/><msg @l="1256" char_id="0" frame_id="1" name="美帆"   text="『那种事……唔啊……与我无关……唔唔……好痛……痛……啊啊！！』"   voices="miho10630"/><msg @l="1258" char_id="0" frame_id="1" name="美帆"   text="『啊……啊，唔呜……那里……啊，啊啊！！』" voices="miho10640"/><msg @l="1260" char_id="-1" frame_id="-1" name=""   text="……被称为肉枪的凶器撕裂的我的阴道内，因教授的摩擦带来的疼痛，第一次接纳男人的我的私处不断地痉挛着。"   voices=""/><msg @l="1262" char_id="-1" frame_id="-1" name="朽木"   text="『太棒了，真棒……你的阴道实在是太舒服了。』" voices=""/><msg @l="1264" char_id="-1" frame_id="-1" name=""   text="沉浸在淫欲中的教授腰部速度更快了。他猛烈地搅动着阴道深处，抽插着肉棒。" voices=""/><msg @l="1266" char_id="-1" frame_id="-1" name="朽木"   text="『紧紧吸附着我的东西，每当我想拔出时就缠绕收紧。呵呵呵，想到这还是处女，真让人期待未来啊。』"   voices=""/><msg @l="1268" char_id="-1" frame_id="-1" name=""   text="或许是因为兴奋，教授一边说着赞美的话，一边不断扭动着腰。" voices=""/><msg @l="1270" char_id="0" frame_id="1" name="美帆"   text="『啊、啊、啊……不要啊……痛……唔，啊呜！！』" voices="miho10610"/><msg @l="1272" char_id="-1" frame_id="-1" name=""   text="的确，违背我的意志，因为下腹部的疼痛，一用力就会使私处收紧，结果导致紧紧裹住了他的肉棒。"   voices=""/><msg @l="1274" char_id="0" frame_id="1" name="美帆"   text="『唔唔……唔，唔，唔，唔啊！！』" voices="miho10650"/><msg @l="1276" char_id="0" frame_id="1" name="美帆"   text="『啊，不要那么用力……不要压得那么紧……』" voices="miho10660"/><msg @l="1278" char_id="-1" frame_id="-1" name=""   text="不知不觉中，房间里回荡着啪嗒、咕啾、黏腻的淫靡声音。每当教授的肉棒在私处抽插时，蜜汁都会奏响那淫秽的音色。"   voices=""/><msg @l="1279" char_id="-1" frame_id="-1" name=""   text="我拒绝接受体内的感觉，却恨自己的身体即使面对朽木教授也试图去适应。" voices=""/><msg @l="1281" char_id="0" frame_id="1" name="美帆"   text="『唔，唔唔……啊，啊，啊，唔呜！！』" voices="miho10670"/><msg @l="1283" char_id="0" frame_id="1" name="美帆"   text="『啊呜……唔，唔啊……不行……不行啊！！』" voices="miho10680"/><msg @l="1285" char_id="-1" frame_id="-1" name=""   text="我试图逃离他那想要进一步搅动我深处的男根，在床上向上移动身体想要逃开。"   voices=""/><msg @l="1286" char_id="-1" frame_id="-1" name=""   text="然而，教授牢牢固定住我试图逃离的腰，反而用比之前更强力的冲击，向我的深处摩擦上去。"   voices=""/><msg @l="1287" char_id="-1" frame_id="-1" name=""   text="涌出的蜜液和破处的血被搅动着，更加淫靡的声音在房间中回响。" voices=""/><msg @l="1289" char_id="0" frame_id="1" name="美帆" text="『呃啊啊啊！！！』"   voices="miho10690"/><msg @l="1291" char_id="0" frame_id="1" name="美帆"   text="『啊、啊、啊、啊、啊、啊啊啊！！』" voices="miho10700"/><msg @l="1293" char_id="-1" frame_id="-1" name=""   text="每当在我体内肆虐的他顶撞我的子宫口时，我的眼前就会一片空白。" voices=""/><msg @l="1294" char_id="-1" frame_id="-1" name=""   text="疼痛和痛苦……不知何时变得麻木模糊……。" voices=""/><msg @l="1295" char_id="-1" frame_id="-1" name=""   text="我每被深深顶入一次，就会被涌出的灼热“什么”所支配，发出既像啜泣又像喘息的声音，身体不断颤抖。"   voices=""/><msg @l="1297" char_id="0" frame_id="1" name="美帆"   text="『嗯嗯，啊，啊，啊……嗯，啊呜！！』" voices="miho10710"/><msg @l="1299" char_id="-1" frame_id="-1" name="朽木"   text="『怎么样，仲根同学……充分品尝了我的东西，似乎感觉好多了吧。』" voices=""/><msg @l="1301" char_id="0" frame_id="1" name="美帆"   text="『呃啊，嗯……嗯，嗯，嗯，嗯嗯！！』" voices="miho10720"/><msg @l="1303" char_id="-1" frame_id="-1" name="朽木"   text="『唔……好，差不多该射了。』" voices=""/><msg @l="1305" char_id="-1" frame_id="-1" name=""   text="随着教授如野兽般咆哮的话语，肆虐在我秘处的他的肉棒变得更加巨大坚硬。" voices=""/><msg @l="1309" async="true" char_id="-1" frame_id="-1" name="" text="射在哪里？"   voices=""/><select @l="1310"><menu @l="1314" label="EventLabel_134" text="射在里面"/><menu @l="1317" label="EventLabel_135" text="射在外面"/></select><label @l="1327" id="EventLabel_134"/><msg @l="1330" char_id="-1" frame_id="-1" name="朽木"   text="『要来了，难得的破处仪式……最后就射在阴道里吧。』" voices=""/><msg @l="1332" char_id="0" frame_id="1" name="美帆" text="『诶……！？』"   voices="miho10730"/><msg @l="1334" char_id="-1" frame_id="-1" name=""   text="在恍惚的意识中，突然有什么东西让我清醒过来。" voices=""/><msg @l="1336" char_id="0" frame_id="1" name="美帆"   text="『不……不行，请不要射在里面……！！』" voices="miho10740"/><msg @l="1338" char_id="-1" frame_id="-1" name="朽木"   text="『呵呵，已经来不及了……我要射得多到从你子宫溢出来。』" voices=""/><msg @l="1340" char_id="0" frame_id="1" name="美帆" text="『不要，不要啊啊啊啊啊啊啊！！』"   voices="miho10750"/><flash @l="1344" count="4" fade="100" image="white"/><wait_chgmv/><ev @l="1348" src="ev-046x1z1"/><msg @l="1350" char_id="0" frame_id="1" name="美帆"   text="『啊……呜啊………里面……热热的东西………』" voices="miho10760"/><msg @l="1352" char_id="-1" frame_id="-1" name=""   text="深深插入我体内的肉楔猛地跳动了一下，随即大量灼热的白浊液体强劲地一股一股地喷射出来。"   voices=""/><msg @l="1354" char_id="-1" frame_id="-1" name="朽木"   text="『哦哦……你的阴道正随着我的射精而收缩呢？』" voices=""/><msg @l="1356" char_id="-1" frame_id="-1" name=""   text="教授对着射入我阴道内的酣畅淋漓的精液，露出了满意的笑容。" voices=""/><msg @l="1358" char_id="-1" frame_id="-1" name="朽木"   text="『这样看来，反倒像是我被你榨取了呢。』" voices=""/><msg @l="1360" char_id="-1" frame_id="-1" name=""   text="教授一边在我体内持续射精，一边发出欢愉的声音。" voices=""/><msg @l="1361" char_id="-1" frame_id="-1" name=""   text="在他那些模糊飘过我意识的话语中，我感受着溢满阴道的热液从我们结合处逆流而出的触感，陷入了深深的绝望。"   voices=""/><goto @l="1364" label="EventLabel_136"/><label @l="1368" id="EventLabel_135"/><msg @l="1371" char_id="-1" frame_id="-1" name="朽木"   text="『你也和我一起达到高潮吧。』" voices=""/><msg @l="1373" char_id="-1" frame_id="-1" name=""   text="教授将深深插入的肉楔从我体内抽出，脸上因情欲的甜美而扭曲着，同时将一个长方形的物体贴向我的秘处。" voices=""/><msg @l="1374" char_id="-1" frame_id="-1" name=""   text="我对那个物体感到一阵恐惧，盯向了自己的股间。那是曾经使我痛苦昏厥的电击枪。" voices=""/><msg @l="1376" char_id="0" frame_id="1" name="美帆" text="『嘶——————。』"   voices="miho04860"/><msg @l="1378" char_id="-1" frame_id="-1" name="" text="我的脸因恐惧而抽搐。"   voices=""/><msg @l="1380" char_id="-1" frame_id="-1" name="朽木" text="『来，去吧。』"   voices=""/><se @l="1384" buf="1" src="ムチの音" volume="1."/><flash @l="1388" count="4" fade="100" image="white"/><msg @l="1390" char_id="0" frame_id="1" name="美帆" text="『去、啊啊啊啊啊啊啊啊啊啊！！！』"   voices="miho04870"/><msg @l="1392" char_id="-1" frame_id="-1" name=""   text="我的下肢痉挛得病态，绷直到极限后僵硬了。" voices=""/><msg @l="1393" char_id="-1" frame_id="-1" name=""   text="一种仿佛贯穿头顶的楔子打入，脑中一片空白。" voices=""/><se @l="1397" buf="1" src="おしっこ2" volume="1."/><msg @l="1399" char_id="-1" frame_id="-1" name=""   text="完全感觉不到下半身的力量，尿道伴随着淫靡的水声，流出了尿液。" voices=""/><msg @l="1401" char_id="-1" frame_id="-1" name="朽木"   text="『啊……真是美景。就这样弄脏你白皙的肌肤吧。』" voices=""/><msg @l="1403" char_id="-1" frame_id="-1" name=""   text="教授带着陶醉的表情，用自己的手撸动着那根挺立的肉棒，将顶端对准了我的肚子。" voices=""/><stopse @l="1407" buf="3"/><msg @l="1409" char_id="-1" frame_id="-1" name="朽木" text="『我要射了！』" voices=""/><flash @l="1413" count="4" fade="100" image="white"/><wait_chgmv/><ev @l="1417" src="ev-046x2z2"/><msg @l="1419" char_id="0" frame_id="1" name="美帆" text="『唔唔……』"   voices="miho10770"/><msg @l="1421" char_id="-1" frame_id="-1" name=""   text="肉枪前端喷出乳白色液体，洒落在我身上。" voices=""/><msg @l="1423" char_id="-1" frame_id="-1" name="朽木"   text="『呵呵……果然你被精液弄脏的样子很相配。』" voices=""/><msg @l="1425" char_id="-1" frame_id="-1" name=""   text="他将那沸腾欲望的乳白液体榨到最后一滴，脸上浮现满足的笑容。" voices=""/><msg @l="1427" char_id="0" frame_id="1" name="美帆" text="『精液……这就是……』"   voices="miho10780"/><msg @l="1429" char_id="-1" frame_id="-1" name=""   text="我一边急促地深呼吸，一边呆呆地望着玷污自己发热身体的乳白色液体。" voices=""/><msg @l="1430" char_id="-1" frame_id="-1" name=""   text="然后只是……在深深的悲伤中，意识渐渐远去……" voices=""/><label @l="1434" id="EventLabel_136"/><stopbgm @l="1438" fadeout="1000"/><clear @l="1444" class="all"/><end_scene @l="1447"/><msgshow @l="1450" show="true"/><wait_chgmv/><bg @l="1454" src="bg01b"/><bgm @l="1458" src="bgm03" volume="1."/><msg @l="1460" char_id="0" frame_id="1" name="美帆" text="『……』" voices=""/><msg @l="1462" char_id="-1" frame_id="-1" name=""   text="被朽木教授蹂躏后，我呆滞地倒在地板上。" voices=""/><msg @l="1463" char_id="-1" frame_id="-1" name=""   text="虽然赤身裸体，但因失去珍贵之物的绝望感，连这点都已无所谓了。" voices=""/><char @l="1467" id="kutsu" pos="auto" src="kutsu010"/><msg @l="1469" char_id="-1" frame_id="-1" name="朽木"   text="『呵呵呵，不愧是我瞄准的身体，果然名不虚传。』" voices=""/><msg @l="1471" char_id="-1" frame_id="-1" name="朽木" text="『仲根同学，你真是太棒了。』"   voices=""/><clear @l="1474" class="char"/><char @l="1476" id="kutsu" pos="left" src="kutsu010"/><char @l="1479" id="miho" pos="right" src="miho105"/><msg @l="1481" char_id="0" frame_id="1" name="美帆"   text="『就算你这么说……我也一点都不高兴。』" voices=""/><msg @l="1483" char_id="-1" frame_id="-1" name="朽木" text="『哦，那真是遗憾啊。』"   voices=""/><char @l="1486" id="kutsu" pos="left" src="kutsu018"/><msg @l="1488" char_id="-1" frame_id="-1" name="朽木"   text="『你不也是……感觉到了吗？』" voices=""/><char @l="1492" id="miho" pos="right" src="miho104"/><msg @l="1494" char_id="0" frame_id="1" name="美帆" text="『什么……！？』" voices=""/><char @l="1497" id="miho" pos="right" src="miho105"/><msg @l="1499" char_id="0" frame_id="1" name="美帆" text="『感、感觉什么的……。』"   voices=""/><msg @l="1501" char_id="0" frame_id="1" name="美帆"   text="『比起这个……您这样悠闲自在真的好吗？』" voices=""/><char @l="1504" id="kutsu" pos="left" src="kutsu010"/><msg @l="1506" char_id="-1" frame_id="-1" name="朽木" text="『为什么这么问呢？』" voices=""/><msg @l="1508" char_id="0" frame_id="1" name="美帆"   text="『如果我就这样报警说我“被强奸”了，教授可就是名副其实的罪犯了哦。』" voices=""/><char @l="1511" id="kutsu" pos="left" src="kutsu018"/><msg @l="1513" char_id="-1" frame_id="-1" name="朽木" text="『什么，就这事啊。』"   voices=""/><char @l="1516" id="miho" pos="right" src="miho104"/><msg @l="1518" char_id="0" frame_id="1" name="美帆" text="『就这事是什么意思……。』"   voices=""/><char @l="1521" id="kutsu" pos="left" src="kutsu010"/><msg @l="1524" char_id="-1" frame_id="-1" name="朽木" text="『想报警就报吧。』"   voices=""/><char @l="1528" id="miho" pos="right" src="miho105"/><msg @l="1530" char_id="0" frame_id="1" name="美帆" text="『啊！？』" voices=""/><msg @l="1532" char_id="-1" frame_id="-1" name=""   text="我从包里拿出了手机。" voices=""/><msg @l="1534" char_id="-1" frame_id="-1" name="朽木"   text="『你可能不知道，在这个南总町，就算你向警察投诉“痴汉”或“强奸”，也不会有人理睬你的。』" voices=""/><char @l="1538" id="miho" pos="right" src="miho005"/><msg @l="1540" char_id="0" frame_id="1" name="美帆"   text="『……不管会怎样，我可不管了！？』" voices=""/><msg @l="1542" char_id="-1" frame_id="-1" name=""   text="面对朽木教授过分的态度，我气愤地拨打了110报警电话。" voices=""/><msg @l="1543" char_id="-1" frame_id="-1" name=""   text="我本来并没有想要把他变成罪犯的意思。" voices=""/><msg @l="1544" char_id="-1" frame_id="-1" name=""   text="只是……我只希望他能意识到自己对对方造成了多大的伤害，如果这只是一时冲动犯下的错误，至少也该真心地道歉。"   voices=""/><msg @l="1545" char_id="-1" frame_id="-1" name="" text="只要这样就好了……。"   voices=""/><char @l="1549" id="miho" pos="right" src="miho105"/><se @l="1553" buf="3" loop="true" src="発信音" volume="1."/><msg @l="1555" char_id="-1" frame_id="-1" name="" text="嘟嘟嘟嘟，嘟嘟嘟嘟……。"   voices=""/><msg @l="1556" char_id="-1" frame_id="-1" name=""   text="电话那头传来一声、两声呼叫音。" voices=""/><msg @l="1558" char_id="0" frame_id="1" name="美帆" text="『……。』" voices=""/><msg @l="1560" char_id="-1" frame_id="-1" name=""   text="我一边听着电话音……一边将拇指放在挂断按钮上，如果朽木教授道歉了，我就立刻挂断电话。"   voices=""/><char @l="1563" id="kutsu" pos="left" src="kutsu018"/><msg @l="1565" char_id="-1" frame_id="-1" name="朽木" text="『呵呵。』" voices=""/><msg @l="1567" char_id="-1" frame_id="-1" name=""   text="然而，与我的想法相反……他只是嘴角挂着淡淡的微笑，默默地看着正在拨打的电话被接通。"   voices=""/><stopse @l="1571" buf="3"/><msg @l="1573" char_id="-1" frame_id="-1" name="署员"   text="『您好，这里是南总警察署……是事故吗？还是案件？』" voices=""/><msg @l="1575" char_id="0" frame_id="1" name="美帆" text="『啊，那个……是案件。』"   voices=""/><msg @l="1577" char_id="-1" frame_id="-1" name="署员"   text="『请冷静下来，准确地告诉我当前的情况。』" voices=""/><msg @l="1579" char_id="0" frame_id="1" name="美帆" text="『好、好的……。』" voices=""/><msg @l="1581" char_id="0" frame_id="1" name="美帆"   text="『我……刚刚被、被强……被强奸了。』" voices=""/><msg @l="1583" char_id="-1" frame_id="-1" name="署员"   text="『嗯？奇怪啊。这个城镇至今为止从未发生过妇女暴行事件，以后也不会发生的。』" voices=""/><char @l="1587" id="miho" pos="right" src="miho104"/><msg @l="1589" char_id="0" frame_id="1" name="美帆" text="『啊！？为什么这么说？』"   voices=""/><msg @l="1591" char_id="-1" frame_id="-1" name="署员"   text="『因为这个城镇是「被那样设计的」，所以不可能发生你所说的事情。』" voices=""/><msg @l="1593" char_id="-1" frame_id="-1" name="署员" text="『一定是你弄错了。』"   voices=""/><char @l="1596" id="miho" pos="right" src="miho004"/><msg @l="1598" char_id="0" frame_id="1" name="美帆" text="『怎么会！！』" voices=""/><msg @l="1600" char_id="-1" frame_id="-1" name=""   text="面对如此怠慢的对待，我更加想要与对方理论。" voices=""/><msg @l="1601" char_id="-1" frame_id="-1" name=""   text="然而……这一切却以电话被对方单方面挂断而告终。" voices=""/><se @l="1605" buf="1" src="携帯ボタン押下音" volume="1."/><char @l="1608" id="miho" pos="right" src="miho105"/><msg @l="1610" char_id="0" frame_id="1" name="美帆" text="『啊……。』" voices=""/><msg @l="1612" char_id="-1" frame_id="-1" name="朽木"   text="『呵呵呵，所以我说过这是徒劳的吧？现在明白原因了吗？』" voices=""/><char @l="1615" id="miho" pos="right" src="miho005"/><msg @l="1617" char_id="0" frame_id="1" name="美帆" text="『这种事……是谎言！！』"   voices=""/><char @l="1620" id="kutsu" pos="left" src="kutsu010"/><msg @l="1622" char_id="-1" frame_id="-1" name="朽木"   text="『这不是谎言，而是不折不扣的现实。』" voices=""/><msg @l="1624" char_id="-1" frame_id="-1" name="朽木"   text="『只不过……这只在南总町有效，是个极其狭小的现实罢了。』" voices=""/><char @l="1627" id="miho" pos="right" src="miho105"/><msg @l="1629" char_id="0" frame_id="1" name="美帆" text="『……到底，这是什么意思？』"   voices=""/><msg @l="1631" char_id="-1" frame_id="-1" name="朽木"   text="『与其在意这些事，不如担心一下你的室友的安危比较好吧。』" voices=""/><char @l="1634" id="miho" pos="right" src="miho104"/><msg @l="1636" char_id="0" frame_id="1" name="美帆" text="『诶……？』" voices=""/><msg @l="1638" char_id="-1" frame_id="-1" name="朽木"   text="『不过……可能已经来不及了。』" voices=""/><msg @l="1640" char_id="-1" frame_id="-1" name=""   text="朽木教授像是自言自语般低语着，看了看手表。" voices=""/><msg @l="1641" char_id="-1" frame_id="-1" name=""   text="我也看了一眼手机上的时钟……已经快23点了。" voices=""/><char @l="1644" id="miho" pos="right" src="miho105"/><msg @l="1646" char_id="0" frame_id="1" name="美帆"   text="『来不及是什么意思……玲小姐，你对她做了什么！？』" voices=""/><char @l="1649" id="kutsu" pos="left" src="kutsu018"/><msg @l="1651" char_id="-1" frame_id="-1" name="朽木" text="『我什么都没做啊。』"   voices=""/><msg @l="1653" char_id="0" frame_id="1" name="美帆" text="『……。』" voices=""/><msg @l="1655" char_id="-1" frame_id="-1" name="朽木"   text="『首先，我一直都跟你在一起，不是吗？』" voices=""/><msg @l="1657" char_id="-1" frame_id="-1" name="朽木"   text="『像这样跟你在一起的我，能对她做什么呢。』" voices=""/><msg @l="1659" char_id="0" frame_id="1" name="美帆" text="『那是……。』" voices=""/><char @l="1662" id="kutsu" pos="left" src="kutsu010"/><msg @l="1664" char_id="-1" frame_id="-1" name="朽木"   text="『好了，既然明白了，那就忘掉今天的事然后去睡觉吧。』" voices=""/><msg @l="1666" char_id="-1" frame_id="-1" name="朽木"   text="『当然……我是不会忘记今天的事的。呵呵呵，下次想抱你的身体时我会再来的。』" voices=""/><clear @l="1670" layer="kutsu"/><msg @l="1672" char_id="-1" frame_id="-1" name=""   text="教授露出淫邪的表情，准备离开我的房间。" voices=""/><msg @l="1674" char_id="0" frame_id="1" name="美帆" text="『……。』" voices=""/><msg @l="1678" async="true" char_id="-1" frame_id="-1" name=""   text="朽木正准备离开……？" voices=""/><select @l="1679"><menu @l="1683" label="EventLabel_137" text="拦住他"/><menu @l="1686" label="EventLabel_141" text="不拦住他"/></select><label @l="1695" id="EventLabel_137"/><char @l="1699" id="miho" pos="right" src="miho005"/><msg @l="1701" char_id="0" frame_id="1" name="美帆" text="『请等一下！！』"   voices=""/><char @l="1705" id="kutsu" pos="left" src="kutsu010"/><msg @l="1707" char_id="-1" frame_id="-1" name="朽木" text="『……。』" voices=""/><msg @l="1709" char_id="-1" frame_id="-1" name=""   text="听到我制止的话语，朽木教授停下脚步转过身来。" voices=""/><msg @l="1711" char_id="0" frame_id="1" name="美帆"   text="『关于这座城镇的事我不会再问了……但是，至少能告诉我关于玲小姐的事吗？』" voices=""/><msg @l="1713" char_id="-1" frame_id="-1" name="朽木"   text="『你知道了又能怎样呢。』" voices=""/><msg @l="1715" char_id="0" frame_id="1" name="美帆"   text="『都已经听说可能来不及了……听到这种事，我不可能保持沉默假装不知道。』" voices=""/><char @l="1719" id="miho" pos="right" src="miho105"/><msg @l="1721" char_id="0" frame_id="1" name="美帆"   text="『如果可以的话，我想帮助玲小姐……。』" voices=""/><msg @l="1723" char_id="-1" frame_id="-1" name="朽木" text="『呵呵呵，不可能的。』"   voices=""/><msg @l="1725" char_id="0" frame_id="1" name="美帆" text="『也许……是这样。』"   voices=""/><msg @l="1727" char_id="0" frame_id="1" name="美帆"   text="『但是，即便如此我还是想帮助玲小姐。』" voices=""/><msg @l="1729" char_id="-1" frame_id="-1" name="朽木" text="『……。』" voices=""/><char @l="1733" id="miho" pos="right" src="miho005"/><msg @l="1735" char_id="0" frame_id="1" name="美帆"   text="『教授……请告诉我，玲小姐现在在哪里！？』" voices=""/><char @l="1738" id="kutsu" pos="left" src="kutsu018"/><msg @l="1740" char_id="-1" frame_id="-1" name="朽木"   text="『……如果可能的话我并不想让大黑独占所有好处……不过这次是多亏了那家伙的引导才顺利进行，处女也已经得到了……嘛，就这样吧。』"   voices=""/><char @l="1744" id="miho" pos="right" src="miho105"/><msg @l="1746" char_id="0" frame_id="1" name="美帆" text="『那是……什么意思？』"   voices=""/><msg @l="1748" char_id="-1" frame_id="-1" name="朽木" text="『不，这是我们的事……。』"   voices=""/><msg @l="1750" char_id="-1" frame_id="-1" name=""   text="教授面露些许无聊的表情，看着我。" voices=""/><msg @l="1752" char_id="-1" frame_id="-1" name="朽木"   text="『好吧，既然你这么说了，我就告诉你……。』" voices=""/><char @l="1755" id="kutsu" pos="left" src="kutsu010"/><msg @l="1757" char_id="-1" frame_id="-1" name="朽木"   text="『如果是她的话，现在大概正在车站前的大黑建设公司办公室接受实地培训吧。』" voices=""/><char @l="1760" id="miho" pos="right" src="miho104"/><msg @l="1762" char_id="0" frame_id="1" name="美帆"   text="『实地培训……这么晚了还在进行吗！？』" voices=""/><msg @l="1764" char_id="-1" frame_id="-1" name="朽木"   text="『那家公司不在乎时间……不，准确地说那家公司有一个主要在夜间工作的清扫部门。』" voices=""/><msg @l="1766" char_id="-1" frame_id="-1" name="朽木"   text="『她现在应该正在接受分配到那个部门的培训。』" voices=""/><char @l="1769" id="miho" pos="right" src="miho105"/><msg @l="1771" char_id="0" frame_id="1" name="美帆"   text="『清扫部门……是指公司内部的清洁工作吗？』" voices=""/><char @l="1774" id="kutsu" pos="left" src="kutsu018"/><msg @l="1776" char_id="-1" frame_id="-1" name="朽木"   text="『呵呵，你还真是天真啊。』" voices=""/><char @l="1780" id="miho" pos="right" src="miho004"/><msg @l="1782" char_id="0" frame_id="1" name="美帆" text="『啊……不是吗？』"   voices=""/><msg @l="1784" char_id="-1" frame_id="-1" name="朽木"   text="『说是清洁工确实没错，但内容和你想象的完全不同。』" voices=""/><char @l="1787" id="miho" pos="right" src="miho005"/><msg @l="1789" char_id="0" frame_id="1" name="美帆" text="『……？』" voices=""/><msg @l="1791" char_id="-1" frame_id="-1" name="朽木" text="『是男性员工的性欲处理人员哦。』"   voices=""/><char @l="1794" id="miho" pos="right" src="miho104"/><msg @l="1796" char_id="0" frame_id="1" name="美帆"   text="『性欲处理……诶？那个……做那种事？』" voices=""/><char @l="1799" id="kutsu" pos="left" src="kutsu010"/><msg @l="1801" char_id="-1" frame_id="-1" name="朽木"   text="『没错。大黑建设为了让男性员工发泄压力，提高工作能力，专门设立了性欲处理部。』" voices=""/><msg @l="1803" char_id="0" frame_id="1" name="美帆"   text="『诶？怎么可能，公司里会有这种部门……』" voices=""/><msg @l="1805" char_id="-1" frame_id="-1" name="朽木"   text="『就是有啊。在那个大黑建设里。』" voices=""/><char @l="1809" id="miho" pos="right" src="miho005"/><msg @l="1811" char_id="0" frame_id="1" name="美帆" text="『那玲小姐是……』"   voices=""/><msg @l="1813" char_id="-1" frame_id="-1" name="朽木"   text="『正在接受进入清扫部门的测试，就是这么回事。』" voices=""/><char @l="1817" id="miho" pos="right" src="miho105"/><msg @l="1819" char_id="0" frame_id="1" name="美帆"   text="『太过分了……为什么会变成那样……』" voices=""/><msg @l="1821" char_id="-1" frame_id="-1" name="朽木"   text="『呵呵呵，谁知道呢。不过对她来说，与其考虑为什么要入职，恐怕她已经只能考虑入职这一件事了吧？』"   voices=""/><msg @l="1823" char_id="0" frame_id="1" name="美帆" text="『………』" voices=""/><char @l="1826" id="kutsu" pos="left" src="kutsu018"/><msg @l="1828" char_id="-1" frame_id="-1" name="朽木"   text="『总之我已经确实回答了你的问题。这样你满意了吗？』" voices=""/><msg @l="1830" char_id="-1" frame_id="-1" name=""   text="当我对朽木教授的话无言以对时，他单方面结束了谈话，离开了房间。" voices=""/><clear @l="1834" class="char"/><stopbgm @l="1838" fadeout="1000"/><clear @l="1844" class="all"/><msgshow @l="1846" show="true"/><wait_chgmv/><bg @l="1850" src="bg17"/><bgm @l="1854" src="bgm09" volume="1."/><char @l="1858" id="ookur" pos="left" src="ookuro010"/><char @l="1861" id="rei" pos="right" src="rei010"/><msg @l="1863" char_id="-1" frame_id="-1" name="" text="———数小时前。" voices=""/><msg @l="1864" char_id="-1" frame_id="-1" name=""   text="在不同楼层的办公室入口处，带着玲的大黑停了下来。" voices=""/><msg @l="1865" char_id="-1" frame_id="-1" name=""   text="那里表面上被称为“人才派遣部”的部门。" voices=""/><msg @l="1866" char_id="-1" frame_id="-1" name="" text="这个部门的主要业务是———。"   voices=""/><msg @l="1867" char_id="-1" frame_id="-1" name=""   text="第一，作为公司内部清洁人员，成为男性员工的消遣对象。" voices=""/><msg @l="1868" char_id="-1" frame_id="-1" name=""   text="第二，作为企业间接待人员，用身体进行营销。" voices=""/><msg @l="1869" char_id="-1" frame_id="-1" name=""   text="第三，协助那个将城镇女性作为消遣对象的项目。" voices=""/><msg @l="1871" char_id="-1" frame_id="-1" name=""   text="当然……这里是这样的场所，这一点并没有告诉玲。" voices=""/><msg @l="1873" char_id="1" frame_id="-1" name="玲" text="『是在这里进行适性检查吗？』"   voices=""/><msg @l="1875" char_id="-1" frame_id="-1" name="大黑"   text="『是的。我现在去叫负责的人，请稍等一下。』" voices=""/><clear @l="1879" layer="ookur"/><msg @l="1881" char_id="-1" frame_id="-1" name=""   text="大黒走近办公室中间的一张座位，拍了拍一位面无表情盯着电脑屏幕的男性员工的肩膀，然后对他说话。" voices=""/><msg @l="1882" char_id="-1" frame_id="-1" name=""   text="那位面无表情的男性员工沉默地听完大黒的话后，突然抬起头远远地看了玲一眼，然后点了点头。" voices=""/><msg @l="1883" char_id="-1" frame_id="-1" name=""   text="玲想，他大概是在介绍自己吧……" voices=""/><char @l="1887" id="ookur" pos="left" src="ookuro010"/><msg @l="1889" char_id="-1" frame_id="-1" name="大黑" text="『抱歉，让您久等了。』"   voices=""/><msg @l="1891" char_id="-1" frame_id="-1" name="大黑"   text="『这位是即将为白石小姐进行适性检查的真岛君。』" voices=""/><msg @l="1893" char_id="1" frame_id="-1" name="玲" text="『初次见面，我是白石玲。』"   voices=""/><msg @l="1895" char_id="-1" frame_id="-1" name="真岛" text="『你好……』"   voices=""/><msg @l="1897" char_id="-1" frame_id="-1" name=""   text="被介绍为真岛的他，耸了耸肩，简短地回应了我的话。" voices=""/><msg @l="1898" char_id="-1" frame_id="-1" name=""   text="不知道他是没干劲还是这就是他的基本行为模式，很难判断。" voices=""/><msg @l="1900" char_id="-1" frame_id="-1" name="大黑"   text="『那么，就像往常一样拜托你了？』" voices=""/><msg @l="1902" char_id="-1" frame_id="-1" name="真岛" text="『嗯。』" voices=""/><msg @l="1904" char_id="-1" frame_id="-1" name=""   text="即使对自己的雇主大黒，他也只是敷衍地回答，然后真岛转向办公室方向，微微抬了抬下巴。" voices=""/><msg @l="1905" char_id="-1" frame_id="-1" name=""   text="于是，原本静静坐着的员工中有两人默不作声地站起来，小跑着向这边靠近。" voices=""/><msg @l="1907" char_id="-1" frame_id="-1" name="真岛"   text="『你们，按住她别让她闹。』" voices=""/><msg @l="1909" char_id="-1" frame_id="-1" name="男员工A" text="『是。』"   voices=""/><msg @l="1911" char_id="-1" frame_id="-1" name="男员工B" text="『明白了。』"   voices=""/><msg @l="1913" char_id="-1" frame_id="-1" name=""   text="两位男性员工对真岛的指示点头后，站在玲的左右两侧抓住她的肩膀。" voices=""/><char @l="1917" id="rei" pos="right" src="rei014"/><msg @l="1919" char_id="1" frame_id="-1" name="玲" text="『诶……这、这是怎么回事？』"   voices=""/><msg @l="1921" char_id="-1" frame_id="-1" name="大黑" text="『啊，请不要担心。』"   voices=""/><msg @l="1923" char_id="-1" frame_id="-1" name="大黑"   text="『只要按照我们的指示行动，他们不会伤害你的。』" voices=""/><clear @l="1927" class="char"/><char @l="1929" id="rei" pos="auto" src="rei128"/><msg @l="1931" char_id="1" frame_id="-1" name="玲" text="『啊……』" voices=""/><msg @l="1933" char_id="-1" frame_id="-1" name=""   text="因为不明白“不会伤害”这句话的含义，玲发出了一声茫然的声音。" voices=""/><msg @l="1934" char_id="-1" frame_id="-1" name=""   text="其实大黒的话中包含着“如果不听从指示就会伤害你”的暗示，但玲并没有察觉到这点。"   voices=""/><msg @l="1936" char_id="-1" frame_id="-1" name="真岛"   text="『你……是叫白石吧，我们先从第一项检查开始。』" voices=""/><char @l="1939" id="rei" pos="auto" src="rei010"/><msg @l="1941" char_id="1" frame_id="-1" name="玲"   text="『啊，好的……我需要做什么呢？』" voices=""/><msg @l="1943" char_id="-1" frame_id="-1" name="真岛" text="『帮我口交。』"   voices=""/><stopbgm @l="1947" fadeout="1000"/><msg @l="1949" char_id="1" frame_id="-1" name="玲" text="『…………。』" voices=""/><msg @l="1951" char_id="-1" frame_id="-1" name="" text="一瞬间……玲的世界仿佛凝固了。"   voices=""/><msg @l="1952" char_id="-1" frame_id="-1" name=""   text="比起刚才大黒说话时的表情，她现在更显露出不理解那意味是什么的神情。" voices=""/><msg @l="1954" char_id="-1" frame_id="-1" name="真岛"   text="『没听见吗？我说给我口交。』" voices=""/><bgm @l="1958" src="bgm17" volume="1."/><char @l="1960" id="rei" pos="auto" src="rei014"/><msg @l="1962" char_id="-1" frame_id="-1" name=""   text="真岛烦躁地皱起眉头，把手搭在玲的肩膀上，强行将她按坐在地板上。" voices=""/><msg @l="1963" char_id="-1" frame_id="-1" name=""   text="玲的眼前刚好对着真岛的胯部，仿佛是计算好的一般，他拉下拉链，在她面前暴露出了自己的那话儿。"   voices=""/><char @l="1967" id="rei" pos="auto" src="rei017"/><msg @l="1969" char_id="1" frame_id="-1" name="玲"   text="『不要……你、你要干什么！』" voices=""/><msg @l="1971" char_id="-1" frame_id="-1" name="真岛"   text="『你是白痴吗？我不是说了让你口交吗。』" voices=""/><msg @l="1973" char_id="1" frame_id="-1" name="玲"   text="『所以，为什么我要做那种事啊！？』" voices=""/><msg @l="1975" char_id="-1" frame_id="-1" name="真岛"   text="『你果然是个白痴吧。这当然是检查的一部分啊。』" voices=""/><msg @l="1977" char_id="1" frame_id="-1" name="玲"   text="『请不要随便叫别人白痴！』" voices=""/><msg @l="1979" char_id="1" frame_id="-1" name="玲"   text="『而且，这种事怎么可能是适性检查……』" voices=""/><msg @l="1981" char_id="-1" frame_id="-1" name="大黑" text="『是有的。』"   voices=""/><msg @l="1983" char_id="-1" frame_id="-1" name=""   text="在玲说完所有话之前，大黒保持着满面笑容回答道。" voices=""/><msg @l="1985" char_id="-1" frame_id="-1" name="大黑"   text="『他说的不是玩笑而是事实。这是为了录用内定而必须进行的检查，请您配合。』" voices=""/><char @l="1988" id="rei" pos="auto" src="rei015"/><msg @l="1990" char_id="1" frame_id="-1" name="玲"   text="『这种事……不管怎样我都不能配合。』" voices=""/><msg @l="1992" char_id="-1" frame_id="-1" name="大黑"   text="『哎呀，您不是说会全力以赴做任何事吗？』" voices=""/><msg @l="1994" char_id="1" frame_id="-1" name="玲"   text="『那要看内容。而且为什么这种检查是必要的……』" voices=""/><msg @l="1996" char_id="-1" frame_id="-1" name="" text="大黒的话语打断了玲的话。"   voices=""/><msg @l="1998" char_id="-1" frame_id="-1" name="大黑"   text="『拒绝适性检查可真是令人困扰啊。正因为您就读的大学很优秀，我们才在这次制度中优先让您临时入社，这真是遗憾。』"   voices=""/><msg @l="2000" char_id="-1" frame_id="-1" name="大黑"   text="『这样的话，就连已经内定的稻庭君也需要重新考虑了。』" voices=""/><char @l="2003" id="rei" pos="auto" src="rei014"/><msg @l="2005" char_id="1" frame_id="-1" name="玲" text="『！！』" voices=""/><char @l="2008" id="rei" pos="auto" src="rei015"/><msg @l="2010" char_id="1" frame_id="-1" name="玲" text="『稻、稻庭先生跟这无关……。』"   voices=""/><msg @l="2012" char_id="-1" frame_id="-1" name="真岛"   text="『真是烦死了，母猪。』" voices=""/><msg @l="2014" char_id="-1" frame_id="-1" name="真岛"   text="『你只要乖乖地给主人舔屌就行了。』" voices=""/><label @l="2017" id="event_scene07"/><goto @l="2019" cond="!(f.flagInExtraMode&#32;&gt;&#32;100)&#13;&#10;"   label="TempLabel_238"/><bgm @l="2021" src="bgm17" volume="1."/><label @l="2022" id="TempLabel_238"/><label @l="2026" id="chart_line30"/><wait_chgmv/><ev @l="2030" src="ev-007bx1"/><description @l="2033" text="二次面试A"/><msg @l="2035" char_id="1" frame_id="-1" name="玲" text="『唔唔呜！？』"   voices="rei01590"/><msg @l="2037" char_id="-1" frame_id="-1" name=""   text="正准备反驳的玲的嘴里，被塞进了真岛粗壮的男根。" voices=""/><msg @l="2038" char_id="-1" frame_id="-1" name=""   text="他那几乎还未完全勃起的肉棒，每当玲发出痛苦的声音，眼角泛泪，为了拒绝而移动舌头时，就在她口中变得更加坚硬粗大。"   voices=""/><msg @l="2040" char_id="-1" frame_id="-1" name="大黑"   text="『他非常喜欢虐待对方身心的施虐游戏呢。』" voices=""/><msg @l="2042" char_id="-1" frame_id="-1" name="大黑"   text="『最近的女孩子们动不动就大喊大叫，为了让她们能够适应这个部门，像他这样能让人屈服的玩法正合适。不过如果太过反抗的话会很可怕哦？』"   voices=""/><msg @l="2044" char_id="1" frame_id="-1" name="玲" text="『……。』"   voices="rei01600"/><msg @l="2046" char_id="-1" frame_id="-1" name=""   text="听到大黑的话，玲的表情明显阴沉了下来。" voices=""/><msg @l="2047" char_id="-1" frame_id="-1" name=""   text="当然，大黑所说的是真是假还不得而知。" voices=""/><msg @l="2048" char_id="-1" frame_id="-1" name=""   text="不过……玲从真岛的态度中感觉到这并非谎言。" voices=""/><msg @l="2050" char_id="-1" frame_id="-1" name="真岛"   text="『别浪费大黑先生的忠告哦？母猪。』" voices=""/><msg @l="2052" char_id="-1" frame_id="-1" name=""   text="真岛依旧一脸兴致缺缺地说着，按住玲的头部，不断地挺腰贴近。" voices=""/><msg @l="2053" char_id="-1" frame_id="-1" name=""   text="当然，每被压迫一分，塞进玲口腔内的肉柱就会寻找应该容纳它的位置，钻进喉咙深处。"   voices=""/><msg @l="2055" char_id="1" frame_id="-1" name="玲" text="『唔，唔唔！！』"   voices="rei01610"/><msg @l="2057" char_id="-1" frame_id="-1" name=""   text="真岛的粗大之物塞满了喉咙深处，玲发出声音挣扎着。" voices=""/><msg @l="2059" char_id="-1" frame_id="-1" name="真岛"   text="『别像个白痴一样呻吟，猪。』" voices=""/><msg @l="2061" char_id="-1" frame_id="-1" name="真岛"   text="『老子说了让你舔，你已经忘了吗！？』" voices=""/><msg @l="2063" char_id="1" frame_id="-1" name="玲" text="『嗯嗯———啊！！』"   voices="rei01620"/><wait_chgmv/><bg @l="2067" src="bg17am1"/><msg @l="2069" char_id="1" frame_id="-1" name="玲" text="『咳咳……咳、咳咳……！！』"   voices="rei01630"/><msg @l="2071" char_id="-1" frame_id="-1" name=""   text="就在真岛大喊的同时深深地挺进腰部的瞬间，肉枪的前端猛烈顶撞着喉咙深处，玲不禁咳嗽起来。" voices=""/><msg @l="2073" char_id="-1" frame_id="-1" name="真岛"   text="『喂，谁允许你自作主张吐出来的！！』" voices=""/><msg @l="2075" char_id="1" frame_id="-1" name="玲"   text="『咳咳咳……别、别说傻话……。』" voices="rei01640"/><msg @l="2077" char_id="1" frame_id="-1" name="玲"   text="『都是你……嗯，强行顶腰的错吧！』" voices="rei01650"/><msg @l="2079" char_id="-1" frame_id="-1" name="真岛"   text="『不想被强行对待的话，就按我说的好好舔。』" voices=""/><msg @l="2081" char_id="-1" frame_id="-1" name="真岛"   text="『如果做不到，不管你吐还是窒息，我都会一直顶到你的喉咙破裂为止。』" voices=""/><msg @l="2083" char_id="1" frame_id="-1" name="玲" text="『……。』"   voices="rei01660"/><msg @l="2085" char_id="-1" frame_id="-1" name="大黑"   text="『所以我说了吧？违抗他真的很可怕。』" voices=""/><msg @l="2087" char_id="-1" frame_id="-1" name=""   text="大黑仿佛在煽动玲的恐惧一般，在她耳边低语。" voices=""/><msg @l="2088" char_id="-1" frame_id="-1" name=""   text="当然，他的表情依旧是一如既往的笑容。" voices=""/><msg @l="2090" char_id="-1" frame_id="-1" name="真岛"   text="『我很宽宏大量，再给你一次机会。』" voices=""/><msg @l="2092" char_id="-1" frame_id="-1" name="真岛"   text="『如果这次还不能按命令好好舔的话……你明白的吧？』" voices=""/><msg @l="2094" char_id="1" frame_id="-1" name="玲" text="『……。』"   voices="rei01670"/><msg @l="2096" char_id="-1" frame_id="-1" name=""   text="面对真岛带有威胁性的话语……玲微微颤抖着。" voices=""/><msg @l="2097" char_id="-1" frame_id="-1" name=""   text="到这种地步还要莫名其妙地反抗只会没有任何好处，这点从之前的交流中已经充分理解了。" voices=""/><msg @l="2098" char_id="-1" frame_id="-1" name=""   text="更何况，如果因为自己的责任导致稻庭的内定被取消的话……。她决定现在只能忍耐。" voices=""/><wait_chgmv/><ev @l="2102" src="ev-007ax1"/><msg @l="2104" char_id="-1" frame_id="-1" name="真岛" text="『首先用舌头舔龟头。』"   voices=""/><msg @l="2106" char_id="1" frame_id="-1" name="玲"   text="『是，是的……嗯……舔……舔……。』" voices="rei01680"/><msg @l="2108" char_id="-1" frame_id="-1" name=""   text="虽然算不上乖顺……显得有些生硬，玲伸出粉红色的舌头，开始轻舔着那能满足真岛征服欲的炮身前端。"   voices=""/><msg @l="2109" char_id="-1" frame_id="-1" name=""   text="玲虽然不是处女，但也绝非性经验丰富。特别是对于服侍男性这种行为，她还相当生疏。"   voices=""/><msg @l="2111" char_id="-1" frame_id="-1" name=""   text="当然，她从杂志或其他途径了解过口交这种行为，也曾出于好奇看过成人视频，所以大致知道应该怎么做。"   voices=""/><msg @l="2112" char_id="-1" frame_id="-1" name="" text="但也仅此而已。"   voices=""/><msg @l="2114" char_id="1" frame_id="-1" name="玲"   text="『嗯，舔，舔……呜……呼，嗯……。』" voices="rei01690"/><msg @l="2116" char_id="-1" frame_id="-1" name="真岛"   text="『光是舔可不行啊。』" voices=""/><msg @l="2118" char_id="-1" frame_id="-1" name="真岛"   text="『要把我的肉棒舔得湿淋淋的，好好地用唾液涂抹，发出啧啧的声音，用听觉刺激对方的兴奋……连这种事都不懂吗，你这家伙。』"   voices=""/><msg @l="2120" char_id="1" frame_id="-1" name="玲" text="『咕……』"   voices="rei01700"/><msg @l="2122" char_id="-1" frame_id="-1" name=""   text="玲一瞬间露出不甘的表情，但在真岛冰冷的目光中感到一丝恐惧，很快就按照他说的去做了。" voices=""/><msg @l="2124" char_id="1" frame_id="-1" name="玲"   text="『嗯……呜……啾，啾……』" voices="rei01710"/><msg @l="2126" char_id="-1" frame_id="-1" name=""   text="嘴里积满唾液，将其缠绕在舌头上后，舔舐龟头的顶端。" voices=""/><msg @l="2127" char_id="-1" frame_id="-1" name=""   text="像是涂抹一般用唾液湿润肉棒后，再将舌头舔过，仿佛要把唾液推开一样。" voices=""/><msg @l="2128" char_id="-1" frame_id="-1" name=""   text="真岛的那话儿因被吮吸的快感而怒张，粗大的血管像蚯蚓一样浮现出来，湿漉漉地闪着淫秽的光泽。"   voices=""/><msg @l="2130" char_id="-1" frame_id="-1" name="真岛"   text="『好，接下来舔龟头下方的沟壑。』" voices=""/><msg @l="2132" char_id="1" frame_id="-1" name="玲"   text="『嗯，舔，舔……呜……哈，嗯……。』" voices="rei01690"/><msg @l="2134" char_id="-1" frame_id="-1" name=""   text="玲虽然对真岛低俗丑陋的肉棒感到厌恶，却还是伸出舌头舔舐着。" voices=""/><msg @l="2136" char_id="-1" frame_id="-1" name="真岛"   text="『笨蛋！要用舌尖来来回回地舔啊！』" voices=""/><msg @l="2138" char_id="-1" frame_id="-1" name=""   text="真岛用勃起的分身像打耳光一样啪啪地拍打着玲的脸颊。" voices=""/><msg @l="2140" char_id="1" frame_id="-1" name="玲" text="『呃……。』"   voices="rei01700"/><msg @l="2142" char_id="-1" frame_id="-1" name=""   text="面对这种屈辱，玲忍耐着内心涌上的情绪，集中精力用舌头舔弄龟头的下方。" voices=""/><msg @l="2144" char_id="-1" frame_id="-1" name="真岛"   text="『在肉棒上涂满唾液后，接下来是阴囊。』" voices=""/><msg @l="2146" char_id="1" frame_id="-1" name="玲" text="『……好。』"   voices="rei01720"/><msg @l="2148" char_id="1" frame_id="-1" name="玲"   text="『嗯，啊呜……嗯……嗯唔……啾咯……啪唧，啪唧。』" voices="rei01730"/><msg @l="2150" char_id="-1" frame_id="-1" name=""   text="玲按照指示将嘴唇贴近那根淫秽肉棒下方如钟摆般摇晃着的阴囊，然后像刚才一样用涂满唾液的舌尖舔舐起来。"   voices=""/><msg @l="2151" char_id="-1" frame_id="-1" name=""   text="当然，这是她第一次舔这种地方，玲一边感受着阴囊冰凉的触感和令人不适的构造而感到恶心，一边还是努力吮吸着它。"   voices=""/><msg @l="2152" char_id="-1" frame_id="-1" name=""   text="一种难以形容的性臭刺激着玲的鼻腔。" voices=""/><msg @l="2154" char_id="-1" frame_id="-1" name="真岛"   text="『好，接下来在我说停之前你自己随意舔吧。』" voices=""/><msg @l="2156" char_id="-1" frame_id="-1" name="真岛"   text="『无论是囊袋、龟头沟还是柱身，哪里都行。用你的舌尖和嘴唇侍奉你认为我会感到舒服的地方。』" voices=""/><msg @l="2158" char_id="1" frame_id="-1" name="玲" text="『……我知道了。』"   voices="rei01740"/><msg @l="2160" char_id="-1" frame_id="-1" name=""   text="她简短地回答后……玲沉默犹豫了片刻，然后慢慢开始在那肉炮的顶端部分爬行舌尖。" voices=""/><msg @l="2162" char_id="1" frame_id="-1" name="玲"   text="『嗯、嗯……嗯啾……嗯啊………啧………。』" voices="rei01750"/><msg @l="2164" char_id="1" frame_id="-1" name="玲"   text="『啾噜……啾噜………嗯、嗯呼………舔舔舔舔。』" voices="rei01760"/><msg @l="2166" char_id="-1" frame_id="-1" name=""   text="凭借着贫乏的知识，玲为了尽可能满足真岛，拼命用舌尖继续吮吸着肉柱的顶端部分。" voices=""/><msg @l="2167" char_id="-1" frame_id="-1" name=""   text="为了不再遭受那屈辱的肉棒掌掴，她拼命地持续舔舐着。" voices=""/><msg @l="2168" char_id="-1" frame_id="-1" name=""   text="然而真岛对玲的这种侍奉没有发出任何声音，只是默默地注视着。" voices=""/><msg @l="2169" char_id="-1" frame_id="-1" name=""   text="因此，她开始不确定自己是否真的让他感到舒服了。" voices=""/><msg @l="2171" char_id="1" frame_id="-1" name="玲"   text="『嗯呜……嗯，啾噗………舔，舔………嗯，啾噜………。』" voices="rei01770"/><msg @l="2173" char_id="1" frame_id="-1" name="玲"   text="『舔，舔………嗯哈………嗯，嗯，嗯………啧，啧。』" voices="rei01780"/><msg @l="2175" char_id="-1" frame_id="-1" name=""   text="带着疑虑和不安，玲舔遍了她所能想到的每一个地方。" voices=""/><msg @l="2176" char_id="-1" frame_id="-1" name=""   text="她亲吻龟头部位，用舌尖舔舐尿道口，不断地用舌头舔遍龟头冠部。" voices=""/><msg @l="2177" char_id="-1" frame_id="-1" name=""   text="在舔舐的间隙，玲偶尔会抬眼察看真岛的表情，但他依然和刚才一样面无表情。" voices=""/><msg @l="2179" char_id="-1" frame_id="-1" name="真岛" text="『好了，舔的部分到此为止。』"   voices=""/><msg @l="2181" char_id="1" frame_id="-1" name="玲" text="『嗯…………。』"   voices="rei01790"/><msg @l="2183" char_id="-1" frame_id="-1" name=""   text="玲擦去从嘴角流下的唾液，松了一口气。" voices=""/><msg @l="2184" char_id="-1" frame_id="-1" name="" text="然而这种松懈并没有持续多久。"   voices=""/><msg @l="2186" char_id="-1" frame_id="-1" name="真岛" text="『接下来含进去。尽可能深一点。』"   voices=""/><msg @l="2188" char_id="1" frame_id="-1" name="玲" text="『…………。』"   voices="rei01800"/><msg @l="2190" char_id="-1" frame_id="-1" name=""   text="真岛说这话的语气，仿佛刚才的那些服侍根本不算什么。" voices=""/><msg @l="2191" char_id="-1" frame_id="-1" name="" text="当然，玲别无选择，只能服从。"   voices=""/><wait_chgmv/><ev @l="2195" src="ev-007bx1"/><msg @l="2197" char_id="1" frame_id="-1" name="玲" text="『呃嗯……嗯，嗯嗯………。』"   voices="rei01810"/><msg @l="2199" char_id="-1" frame_id="-1" name=""   text="慢慢地，这次是玲自己主动地将刚才服侍时已被唾液弄得黑亮的炮身深深含入口腔。" voices=""/><msg @l="2200" char_id="-1" frame_id="-1" name=""   text="那硬挺的肉块仅仅是前端就已经占据了玲口腔的大部分空间，似乎不可能将它整个含入。" voices=""/><msg @l="2202" char_id="-1" frame_id="-1" name="真岛"   text="『光靠嘴巴可容纳不下我的鸡巴。』" voices=""/><msg @l="2204" char_id="-1" frame_id="-1" name="真岛"   text="『深含的时候要打开喉咙，像吞咽一样。』" voices=""/><msg @l="2206" char_id="1" frame_id="-1" name="玲" text="『……。』"   voices="rei01820"/><msg @l="2208" char_id="-1" frame_id="-1" name=""   text="真岛用冷漠的声音斥责着技术不佳的玲。" voices=""/><msg @l="2209" char_id="-1" frame_id="-1" name=""   text="尽管玲心中涌起一丝愤怒，但她不被允许反抗，只能按照指示吞入那丑陋而异形的肉块。"   voices=""/><msg @l="2211" char_id="1" frame_id="-1" name="玲"   text="『嗯……咕，唔唔……。』" voices="rei01830"/><msg @l="2213" char_id="-1" frame_id="-1" name=""   text="即使快要吐出来，玲还是拼命地引导口中的肉柱深入喉咙。" voices=""/><msg @l="2214" char_id="-1" frame_id="-1" name=""   text="然而无论她尝试多少次，当前端摩擦到喉咙深处的壁面时，那种痛苦都让她无法忍受，始终无法将真岛的男根完全含入。"   voices=""/><msg @l="2216" char_id="-1" frame_id="-1" name="真岛" text="『……没用的母猪。』"   voices=""/><msg @l="2218" char_id="-1" frame_id="-1" name="真岛"   text="『深喉就算了……试试用口交让我射出来。』" voices=""/><msg @l="2220" char_id="1" frame_id="-1" name="玲" text="『………。』"   voices="rei01840"/><msg @l="2222" char_id="-1" frame_id="-1" name=""   text="真岛恼怒地瞪着玲，但即使被这么说，她也不知道该怎么做才好。" voices=""/><msg @l="2224" char_id="-1" frame_id="-1" name="真岛"   text="『什么，连口交都不会吗……真是废物啊。』" voices=""/><msg @l="2226" char_id="-1" frame_id="-1" name="真岛"   text="『听好了……口交是这样做的。』" voices=""/><msg @l="2228" char_id="-1" frame_id="-1" name=""   text="说着这些烦躁的话，真岛牢牢抓住玲的头前后摇晃。" voices=""/><msg @l="2230" char_id="1" frame_id="-1" name="玲" text="『唔唔唔唔！？』"   voices="rei01850"/><msg @l="2232" char_id="-1" frame_id="-1" name=""   text="突如其来的动作让玲瞪大眼睛呻吟着，但真岛根本不在意这些，猛烈地摇晃着她的头。" voices=""/><msg @l="2233" char_id="-1" frame_id="-1" name=""   text="他紧紧抓住玲的头不让她逃脱，像插入蜜穴一样侵犯着玲的嘴。" voices=""/><msg @l="2235" char_id="1" frame_id="-1" name="玲" text="『嗯，嗯，嗯，嗯，嗯呜！！』"   voices="rei01860"/><msg @l="2237" char_id="1" frame_id="-1" name="玲"   text="『嗯咕，嗯嗯，嗯噗，嗯噗，嗯噗……嗯，嗯咕！！』" voices="rei01870"/><msg @l="2239" char_id="-1" frame_id="-1" name=""   text="即使是真岛，在明白深喉是不可能的情况下，也没有试图将肉根插入太深。" voices=""/><msg @l="2240" char_id="-1" frame_id="-1" name=""   text="这位以摧残对方而闻名的虐待狂，看来也多少明白适度这个词的意思。" voices=""/><msg @l="2242" char_id="1" frame_id="-1" name="玲"   text="『嗯嗯，嗯，嗯……嗯嗯！！』" voices="rei01880"/><msg @l="2244" char_id="-1" frame_id="-1" name=""   text="然而，在这激烈的动作下，玲的嘴角淫靡地流下涎水。" voices=""/><msg @l="2246" char_id="-1" frame_id="-1" name="真岛"   text="『明白了吗？就是这样一边动头一边用舌头缠绕。』" voices=""/><msg @l="2248" char_id="-1" frame_id="-1" name="真岛"   text="『真是的，口交这种事连路边的小鬼都会做。』" voices=""/><msg @l="2250" char_id="-1" frame_id="-1" name=""   text="在进行了一阵子深喉之后，真岛骂骂咧咧地停下了手上的动作。" voices=""/><msg @l="2251" char_id="-1" frame_id="-1" name=""   text="玲双眼含泪，缓缓地开始摆动头部，仿佛在追随刚才的动作。" voices=""/><wait_chgmv/><ev @l="2255" src="ev-007by2"/><msg @l="2257" char_id="1" frame_id="-1" name="玲"   text="『嗯，嗯噗……嗯，嗯，嗯……。』" voices="rei01890"/><msg @l="2259" char_id="-1" frame_id="-1" name=""   text="含着热棒，前后摆动着头部，用嘴唇套弄着肉茎部分。" voices=""/><msg @l="2260" char_id="-1" frame_id="-1" name=""   text="虽然没有真岛那样的无礼举动，但作为初学者来说，这已经是相当能取悦男人的服侍了。更何况，侵犯像玲这样美人的嘴巴的景象，应该是快乐的极致吧。"   voices=""/><msg @l="2262" char_id="-1" frame_id="-1" name="真岛"   text="『就这样一边摆动头部，一边积攒唾液用舌头缠绕。』" voices=""/><msg @l="2264" char_id="-1" frame_id="-1" name="真岛"   text="『还有，别忘了吸吮前端。』" voices=""/><msg @l="2266" char_id="1" frame_id="-1" name="玲"   text="『嗯啊……嗯，啾噗……啾噗……嗯，嗯嗯……啾啪。』" voices="rei01900"/><msg @l="2268" char_id="-1" frame_id="-1" name=""   text="啾噗啾噗的淫靡声音与玲含着痛苦的呜咽声混在一起。" voices=""/><msg @l="2270" char_id="1" frame_id="-1" name="玲"   text="『嗯咕，啾噗，啾噗，啾噗……嗯……啾噜噜噜。』" voices="rei01910"/><msg @l="2272" char_id="-1" frame_id="-1" name=""   text="按照真岛的指示，玲在充满唾液的口腔内发出更大的声音，同时让巨大的肉茎前端在口中进进出出。" voices=""/><msg @l="2273" char_id="-1" frame_id="-1" name=""   text="偶尔牙齿碰到肉身时，真岛就会用可怕的表情瞪着玲，用脚尖踢她的大腿附近。" voices=""/><msg @l="2274" char_id="-1" frame_id="-1" name=""   text="每当这种时候，玲都会变得畏缩……越来越顺从。" voices=""/><msg @l="2276" char_id="1" frame_id="-1" name="玲"   text="『啾啵，嗯呼……啾噗啾噗啾噗……嗯，嗯嗯……。』" voices="rei01920"/><msg @l="2278" char_id="1" frame_id="-1" name="玲"   text="『嗯，嗯，嗯……啾噜噜……嗯，嗯呼……啾啵！』" voices="rei01930"/><msg @l="2280" char_id="-1" frame_id="-1" name=""   text="这样的侍奉到底持续了多久呢。" voices=""/><msg @l="2281" char_id="-1" frame_id="-1" name=""   text="玲那拙劣的技术很难让真岛达到最后的高潮。" voices=""/><msg @l="2282" char_id="-1" frame_id="-1" name=""   text="她的下巴已经疲惫不堪，嘴角不断有起泡的白色唾液丝缓缓滴落。" voices=""/><msg @l="2284" char_id="-1" frame_id="-1" name="真岛" text="『……真烦人啊。』"   voices=""/><msg @l="2286" char_id="-1" frame_id="-1" name="真岛"   text="『头不用动了，只要含住前端，舔舐龟头下面的部分就行。』" voices=""/><msg @l="2288" char_id="-1" frame_id="-1" name="真岛"   text="『还有，别忘了用你闲着的手。』" voices=""/><msg @l="2290" char_id="-1" frame_id="-1" name=""   text="真岛烦躁地说完，将自己的手覆在玲的手上，让她套弄自己勃起的分身根部。玲纤细的指尖笨拙地滑动着。"   voices=""/><msg @l="2292" char_id="1" frame_id="-1" name="玲"   text="『啾噗……嗯，嗯啾，啾咯，啾咯，啾咯，啾咯……。』" voices="rei01940"/><msg @l="2294" char_id="1" frame_id="-1" name="玲"   text="『嗯噗，嗯……啾噗，啾噗，啾噗……嗯，啾噜噜。』" voices="rei01950"/><msg @l="2296" char_id="-1" frame_id="-1" name=""   text="玲按照指示只含住前端部分，用嘴唇和舌头执着地吮吸着龟头下方的部位。" voices=""/><msg @l="2297" char_id="-1" frame_id="-1" name=""   text="可能是因为这样比摇头缠绕舌头要轻松一些，她以比之前更加激烈的动作舔舐着，纤细的手指也逐渐有节奏地摩擦起肉棒。"   voices=""/><msg @l="2299" char_id="-1" frame_id="-1" name="真岛"   text="『感觉不错。就这样继续舔吧。』" voices=""/><msg @l="2301" char_id="-1" frame_id="-1" name="" text="这是真岛第一次说出表扬的话语。"   voices=""/><msg @l="2302" char_id="-1" frame_id="-1" name=""   text="也许是因为被一直嘲笑自己的对手稍微认可而感到高兴，玲的侍奉变得更加热情，嘴边湿漉漉的，像是要榨干一样用力吮吸。"   voices=""/><msg @l="2304" char_id="1" frame_id="-1" name="玲"   text="『啾咯，嗯噗……啾噗，啾噗，啾噗，啾噗，啾噗。』" voices="rei01960"/><msg @l="2306" char_id="1" frame_id="-1" name="玲" text="『嗯，啾噜噜噜噜噜噜！！』"   voices="rei01970"/><msg @l="2308" char_id="-1" frame_id="-1" name="真岛" text="『好啊……我要射了。』"   voices=""/><msg @l="2312" async="true" char_id="-1" frame_id="-1" name=""   text="要射在哪里……？" voices=""/><select @l="2313"><menu @l="2317" label="EventLabel_138" text="射在嘴里"/><menu @l="2320" label="EventLabel_139" text="射在脸上"/></select><label @l="2329" id="EventLabel_138"/><msg @l="2331" char_id="-1" frame_id="-1" name="真岛" text="『好好含着！』"   voices=""/><msg @l="2333" char_id="1" frame_id="-1" name="玲" text="『唔呜！？』"   voices="rei01980"/><flash @l="2337" count="4" fade="100" image="white"/><wait_chgmv/><ev @l="2341" src="ev-007az1"/><msg @l="2343" char_id="1" frame_id="-1" name="玲" text="『嗯，唔唔唔唔唔！？』"   voices="rei01990"/><msg @l="2345" char_id="-1" frame_id="-1" name=""   text="在真岛说完话的瞬间，大量灼热的白浊液体注入了她的口腔。" voices=""/><msg @l="2346" char_id="-1" frame_id="-1" name=""   text="玲对此感到惊讶，慌忙想要吐出来……但她的头被按住了，无法离开。" voices=""/><msg @l="2347" char_id="-1" frame_id="-1" name=""   text="那令人窒息的浓厚性臭弥漫开来，微温的液体充满了她的整个口腔。" voices=""/><msg @l="2349" char_id="-1" frame_id="-1" name="真岛"   text="『别吐出来……一滴不剩地全部咽下去。』" voices=""/><msg @l="2351" char_id="1" frame_id="-1" name="玲" text="『嗯嗯——！？』"   voices="rei02000"/><msg @l="2353" char_id="-1" frame_id="-1" name="真岛" text="『喝下去。』" voices=""/><msg @l="2355" char_id="1" frame_id="-1" name="玲" text="『……。』"   voices="rei02010"/><msg @l="2357" char_id="1" frame_id="-1" name="玲"   text="『嗯……嗯咕……嗯咕，嗯咕……咕噜咕噜咕噜……。』" voices="rei02020"/><msg @l="2359" char_id="-1" frame_id="-1" name=""   text="短暂犹豫后，玲虽面露痛苦表情，但在真岛的目光逼迫下，发出咕噜一声将口中积聚的污浊液体吞咽了下去。"   voices=""/><msg @l="2360" char_id="-1" frame_id="-1" name=""   text="男人浓稠的原液通过了玲的喉咙。" voices=""/><msg @l="2361" char_id="-1" frame_id="-1" name="" text="……然而，这种状态只持续了片刻。"   voices=""/><clear @l="2367" class="all"/><msg @l="2372" char_id="1" frame_id="-1" name="玲"   text="『嗯咕！？ 咳咳，咳咳咳……咳咳！！』" voices="rei02030"/><msg @l="2374" char_id="-1" frame_id="-1" name=""   text="粘稠如浆糊般的男人液体缠绕在喉咙里，玲剧烈地咳嗽起来。" voices=""/><msg @l="2375" char_id="-1" frame_id="-1" name=""   text="毕竟她第一次喝下精液，这种反应也是正常的。" voices=""/><msg @l="2377" char_id="-1" frame_id="-1" name="真岛"   text="『我不是说了一滴不剩全都喝下去吗！！』" voices=""/><msg @l="2379" char_id="-1" frame_id="-1" name=""   text="当玲咳嗽着似乎要吐出来时，真岛厉声喝道。" voices=""/><msg @l="2380" char_id="-1" frame_id="-1" name=""   text="实际上……被命令要吞下的真岛滚烫欲望的大部分，已经被吐在了地板上。" voices=""/><msg @l="2382" char_id="1" frame_id="-1" name="玲" text="『对不起……我喝不下。』"   voices="rei02040"/><msg @l="2384" char_id="-1" frame_id="-1" name="真岛"   text="『啧……连精液都喝不下的废物猪还有什么价值。』" voices=""/><msg @l="2386" char_id="1" frame_id="-1" name="玲" text="『怎么这样……』"   voices="rei02050"/><goto @l="2389" label="EventLabel_140"/><label @l="2393" id="EventLabel_139"/><msg @l="2395" char_id="-1" frame_id="-1" name="真岛" text="『那就用脸接着吧！』"   voices=""/><msg @l="2397" char_id="1" frame_id="-1" name="玲" text="『呿啊！？』"   voices="rei02060"/><flash @l="2401" count="4" fade="100" image="white"/><wait_chgmv/><ev @l="2405" src="ev-007bz1"/><msg @l="2407" char_id="-1" frame_id="-1" name=""   text="就在肉质火箭从玲的口中被抽出的瞬间，前端喷射出大量白浊色的精液。" voices=""/><msg @l="2408" char_id="-1" frame_id="-1" name=""   text="那些液体接连不断地洒落在玲的脸上，将她美丽的脸颊和可爱的嘴唇染得一片雪白。" voices=""/><msg @l="2410" char_id="-1" frame_id="-1" name="真岛"   text="『嗯……把射在脸上的精液，用手指舀起来喝下去。』" voices=""/><msg @l="2412" char_id="-1" frame_id="-1" name="真岛" text="『一滴都不准剩下。』"   voices=""/><msg @l="2414" char_id="1" frame_id="-1" name="玲" text="『啊……』"   voices="rei02070"/><msg @l="2416" char_id="-1" frame_id="-1" name="真岛"   text="『别啊了，快点做我说的事！』" voices=""/><msg @l="2418" char_id="1" frame_id="-1" name="玲" text="『是，是的。』"   voices="rei02080"/><msg @l="2420" char_id="1" frame_id="-1" name="玲"   text="『嗯……嗯咕……啧……啧……』" voices="rei02090"/><msg @l="2422" char_id="-1" frame_id="-1" name=""   text="在真岛的一声厉喝下，玲肩膀颤抖着，用指尖舀起喷在脸颊和眼皮上的欲望粘液，一次次送入口中。"   voices=""/><msg @l="2423" char_id="-1" frame_id="-1" name=""   text="尽管她因送入口腔的精液散发出的浓重腥味而皱眉，但仍然努力地想把它吞咽下去。" voices=""/><msg @l="2424" char_id="-1" frame_id="-1" name="" text="……但这样的状态并没有持续多久。"   voices=""/><clear @l="2430" class="all"/><msg @l="2435" char_id="1" frame_id="-1" name="玲"   text="『嗯……嗯咕，嗯咕………嗯……嗯呃！？』" voices="rei02100"/><msg @l="2437" char_id="1" frame_id="-1" name="玲"   text="『咳咳……咳咳，嗯，咳咳咳……。』" voices="rei02110"/><msg @l="2439" char_id="-1" frame_id="-1" name=""   text="在第几次尝试咽下那淫液的瞬间，玲呛到了，剧烈地咳嗽起来。" voices=""/><msg @l="2440" char_id="-1" frame_id="-1" name=""   text="对她来说，这是今天第一次尝到男人的原液，对那浓重的性臭和温热感产生排斥反应也是无可厚非的。"   voices=""/><msg @l="2442" char_id="-1" frame_id="-1" name="真岛" text="『喂，谁让你吐出来了！』"   voices=""/><msg @l="2444" char_id="-1" frame_id="-1" name=""   text="看着那些她无法咽下、滴落在地板上的白色液体，真岛愤怒地提高了嗓门。" voices=""/><msg @l="2446" char_id="1" frame_id="-1" name="玲"   text="『对不起……这种，我做不到……。』" voices="rei02120"/><msg @l="2448" char_id="-1" frame_id="-1" name="真岛"   text="『连精液都处理不好，真是废物女人！』" voices=""/><msg @l="2450" char_id="1" frame_id="-1" name="玲" text="『这也太，过分了……。』"   voices="rei02130"/><label @l="2454" id="EventLabel_140"/><end_scene @l="2457"/><stopbgm @l="2461" fadeout="1000"/><wait_chgmv/><bg @l="2465" src="bg17"/><char @l="2469" id="ookur" pos="auto" src="ookuro010"/><bgm @l="2473" src="bgm09" volume="1."/><msg @l="2476" char_id="-1" frame_id="-1" name="大黑"   text="『好了好了，她还只是在培训阶段嘛。』" voices=""/><msg @l="2478" char_id="-1" frame_id="-1" name=""   text="大黑依旧挂着平常的笑容，插嘴打断了真岛那仿佛在看垃圾般俯视玲的目光。" voices=""/><msg @l="2479" char_id="-1" frame_id="-1" name=""   text="但是……大黑接下来说的话，还是让玲大吃一惊。" voices=""/><msg @l="2481" char_id="-1" frame_id="-1" name="大黑"   text="『有真岛君的指导，她迟早会自己开口要求的。』" voices=""/><clear @l="2484" class="char"/><char @l="2486" id="ookur" pos="left" src="ookuro010"/><char @l="2489" id="rei" pos="right" src="rei015"/><msg @l="2491" char_id="1" frame_id="-1" name="玲" text="『……！？』" voices=""/><msg @l="2493" char_id="-1" frame_id="-1" name=""   text="大黑接着说“我很期待”，拍了拍真岛的肩膀。" voices=""/><msg @l="2494" char_id="-1" frame_id="-1" name=""   text="玲用难以置信的表情看着大黑，而他依然挂着满脸笑容，还说了些“下次检查也要加油啊”之类不负责任的话。"   voices=""/><msg @l="2496" char_id="-1" frame_id="-1" name="真岛"   text="『真走运啊，母猪，多亏大黑先生宽宏大量。』" voices=""/><msg @l="2498" char_id="-1" frame_id="-1" name="真岛" text="『总之第一项算是合格了。』"   voices=""/><msg @l="2500" char_id="-1" frame_id="-1" name=""   text="真岛带着蔑视的表情，像吐痰一样说道。" voices=""/><msg @l="2501" char_id="-1" frame_id="-1" name=""   text="看来他是打算一直践踏玲的尊严到底。" voices=""/><msg @l="2503" char_id="-1" frame_id="-1" name="大黑"   text="『哎呀，虽然他那样说，但第一次就能让真岛君射精的女孩可不多见啊。』" voices=""/><msg @l="2505" char_id="-1" frame_id="-1" name="大黑"   text="『我对玲小姐抱有很高期待，希望你能一直保持这样的状态。』" voices=""/><msg @l="2507" char_id="1" frame_id="-1" name="玲" text="『……。』" voices=""/><msg @l="2509" char_id="-1" frame_id="-1" name="" text="大黑凑到玲的耳边，轻声细语地说道。"   voices=""/><msg @l="2510" char_id="-1" frame_id="-1" name=""   text="虽然他是想称赞她，但毫无疑问，玲的表情上不可能浮现出丝毫喜悦。" voices=""/><msg @l="2512" char_id="-1" frame_id="-1" name="真岛"   text="『好了，那我们赶紧进行下一项检查吧。』" voices=""/><msg @l="2514" char_id="-1" frame_id="-1" name="真岛" text="『你们……准备那个。』"   voices=""/><msg @l="2516" char_id="-1" frame_id="-1" name="男员工A"   text="『是那个吧。明白了。』" voices=""/><msg @l="2518" char_id="-1" frame_id="-1" name="男员工B"   text="『那我去打印检查清单。』" voices=""/><msg @l="2520" char_id="-1" frame_id="-1" name=""   text="真岛一下达指示，两位看起来是他手下的男职员就忙碌地开始准备检查。" voices=""/><msg @l="2521" char_id="-1" frame_id="-1" name=""   text="一个人搬运着放在办公室入口角落的，似乎是由泡沫板制成的箱子，另一个人则在自己的电脑上打印着什么。"   voices=""/><char @l="2525" id="rei" pos="right" src="rei014"/><msg @l="2527" char_id="1" frame_id="-1" name="玲" text="『……你们要做什么？』"   voices=""/><msg @l="2529" char_id="-1" frame_id="-1" name=""   text="一直对真岛保持警惕而沉默的玲，看着两位忙碌准备的男职员，轻声问出了疑问。"   voices=""/><msg @l="2531" char_id="-1" frame_id="-1" name="真岛" text="『马上就知道了。臭猪给我闭嘴。』"   voices=""/><char @l="2535" id="rei" pos="right" src="rei017"/><msg @l="2537" char_id="1" frame_id="-1" name="玲" text="『………。』" voices=""/><msg @l="2539" char_id="-1" frame_id="-1" name=""   text="面对这无礼的回答，玲脸上浮现出愤怒的表情，但在真岛看来，这只不过是他见惯了的表情而已。" voices=""/><msg @l="2540" char_id="-1" frame_id="-1" name=""   text="被分配到这里的每个人，一开始都是这样无意义地反抗着。" voices=""/><msg @l="2541" char_id="-1" frame_id="-1" name=""   text="然而这些女孩们的归宿都是一样的。" voices=""/><wait_chgmv/><bg @l="2544" src="bg17h1"/><msg @l="2546" char_id="-1" frame_id="-1" name="真岛" text="『看，准备好了。』"   voices=""/><msg @l="2548" char_id="-1" frame_id="-1" name=""   text="真岛懒洋洋地指着一位男职员准备的箱状物说道。" voices=""/><char @l="2552" id="rei" pos="right" src="rei014"/><msg @l="2554" char_id="1" frame_id="-1" name="玲" text="『……这是什么？』" voices=""/><msg @l="2556" char_id="-1" frame_id="-1" name="大黑"   text="『啊，这是我们公司正在开发的下一代隔热材料。』" voices=""/><msg @l="2558" char_id="-1" frame_id="-1" name="大黑"   text="『这款产品的基本设计和理念是创造一种轻便耐用的材料，不仅适用于新建筑，也适合翻新和扩建工程。』"   voices=""/><msg @l="2560" char_id="-1" frame_id="-1" name="真岛"   text="『你，接下来要为这种隔热材料进行耐久测试。』" voices=""/><msg @l="2562" char_id="1" frame_id="-1" name="玲" text="『啊……？』" voices=""/><msg @l="2564" char_id="-1" frame_id="-1" name=""   text="玲不禁对真岛的话语发出了愚蠢的声音。" voices=""/><msg @l="2565" char_id="-1" frame_id="-1" name="" text="这也难怪。" voices=""/><msg @l="2566" char_id="-1" frame_id="-1" name=""   text="与之前那些看似与建筑和建设毫无关系的荒谬检测相比，这突然变得“像样”的检测内容。"   voices=""/><msg @l="2568" char_id="-1" frame_id="-1" name="真岛" text="『怎么，有意见吗？』"   voices=""/><char @l="2572" id="rei" pos="right" src="rei115"/><msg @l="2574" char_id="1" frame_id="-1" name="玲" text="『不，不……我没有意见。』"   voices=""/><msg @l="2576" char_id="1" frame_id="-1" name="玲"   text="『只是……那个下一代隔热材料，还是未发布的产品对吧？』" voices=""/><msg @l="2578" char_id="-1" frame_id="-1" name="大黑"   text="『是的。因为还在实验阶段。』" voices=""/><char @l="2581" id="rei" pos="right" src="rei114"/><msg @l="2583" char_id="1" frame_id="-1" name="玲"   text="『那个测试……我可以做吗？』" voices=""/><msg @l="2585" char_id="1" frame_id="-1" name="玲"   text="『这类东西通常不是属于企业机密吗？』" voices=""/><msg @l="2587" char_id="-1" frame_id="-1" name="大黑"   text="『新产品的测试者当然是越多越好。』" voices=""/><msg @l="2589" char_id="-1" frame_id="-1" name="大黑"   text="『而且，我认为在试错阶段，应该积极采纳各种人的意见。』" voices=""/><char @l="2593" id="rei" pos="right" src="rei110"/><msg @l="2595" char_id="1" frame_id="-1" name="玲"   text="『原来如此……确实，我觉得您说的很有道理。』" voices=""/><msg @l="2597" char_id="-1" frame_id="-1" name=""   text="这意外的发展，让玲那颓废的心灵立刻焕发了生机。" voices=""/><msg @l="2598" char_id="-1" frame_id="-1" name=""   text="终于谈到了她的专业领域。" voices=""/><msg @l="2599" char_id="-1" frame_id="-1" name=""   text="这一点，让一直处于萎靡状态的她重新振作起来。" voices=""/><msg @l="2601" char_id="-1" frame_id="-1" name="真岛"   text="『别在那儿唧唧歪歪的，你拿着这个从那个洞里伸进头去。』" voices=""/><char @l="2605" id="rei" pos="right" src="rei115"/><msg @l="2607" char_id="1" frame_id="-1" name="玲" text="『啊，好的……』"   voices=""/><msg @l="2609" char_id="-1" frame_id="-1" name=""   text="玲从真岛那里接过一张A4大小的纸和一支圆珠笔。" voices=""/><msg @l="2610" char_id="-1" frame_id="-1" name=""   text="那张纸上写着1到5个项目，每个项目都设置了5个等级的勾选栏。" voices=""/><msg @l="2611" char_id="-1" frame_id="-1" name="" text="就像是一种问卷调查表。"   voices=""/><msg @l="2613" char_id="-1" frame_id="-1" name="真岛"   text="『接下来按照纸上写的顺序进行测试。你在箱子里按顺序打勾就行了。』" voices=""/><msg @l="2615" char_id="1" frame_id="-1" name="玲"   text="『为什么必须在里面打勾呢……？』" voices=""/><msg @l="2617" char_id="-1" frame_id="-1" name="大黑"   text="『我们希望玲小姐能够模拟在实际使用了隔热材料的房间内，从内部进行检查。』" voices=""/><msg @l="2619" char_id="-1" frame_id="-1" name="大黑"   text="『至于测试材料是小型盒状这一点，是因为在试制阶段无法大量生产材料的缘故，请见谅。』"   voices=""/><char @l="2622" id="rei" pos="right" src="rei110"/><msg @l="2624" char_id="1" frame_id="-1" name="玲"   text="『是这样啊……既然如此，我愿意协助。』" voices=""/><clear @l="2628" class="char"/><clear @l="2630" class="all"/><msg @l="2632" char_id="-1" frame_id="-1" name=""   text="玲点头回应大黒的话，然后将上半身探入隔热材料制成的盒子侧面开的洞中。" voices=""/><msg @l="2633" char_id="-1" frame_id="-1" name=""   text="由于箱子的四边做得不太大，无法容纳整个身体。" voices=""/><msg @l="2634" char_id="-1" frame_id="-1" name=""   text="大约到腰骨的位置就会碰到对面的墙壁。" voices=""/><msg @l="2635" char_id="-1" frame_id="-1" name=""   text="也就是说，从外面看起来，只有下半身从箱子中突出来的样子。" voices=""/><msg @l="2637" char_id="-1" frame_id="-1" name="真岛" text="『能听到我的声音吗？』"   voices=""/><char @l="2640" id="rei" pos="center" src="rei014f" y="-80"/><msg @l="2642" char_id="1" frame_id="-1" name="玲" text="『啊，能。』" voices=""/><msg @l="2644" char_id="-1" frame_id="-1" name="" text="真岛的声音在箱子里产生了很大的回响。"   voices=""/><msg @l="2645" char_id="-1" frame_id="-1" name=""   text="由于声音异常清晰，她感到奇怪便环顾四周，发现箱子天花板上装有一个小扬声器。" voices=""/><msg @l="2647" char_id="-1" frame_id="-1" name="真岛"   text="『那种隔热材料也具有隔音效果，所以我的声音应该是通过箱子里的扬声器传到你耳朵里的。』" voices=""/><msg @l="2649" char_id="-1" frame_id="-1" name="真岛"   text="『你的声音也会通过麦克风传到我的耳机里，所以说话要清楚点，否则我听不见。』" voices=""/><msg @l="2651" char_id="-1" frame_id="-1" name=""   text="真岛一边说着，一边用指尖弹了弹耳朵上的无线耳机。" voices=""/><char @l="2654" id="rei" pos="center" src="rei010f" y="-80"/><msg @l="2656" char_id="1" frame_id="-1" name="玲" text="『我明白了。』" voices=""/><msg @l="2658" char_id="-1" frame_id="-1" name="真岛"   text="『那么，就从第一项开始按顺序检查吧。』" voices=""/><msg @l="2660" char_id="1" frame_id="-1" name="玲" text="『好的。』" voices=""/><msg @l="2662" char_id="-1" frame_id="-1" name=""   text="箱子里还很贴心地安装了一个豆电灯，玲点亮它后查看手中纸张上列出的项目。" voices=""/><msg @l="2663" char_id="-1" frame_id="-1" name=""   text="表格上列出的项目从上到下依次是：热传导、隔音、抗冲击、抗震、防水这五项构成。" voices=""/><msg @l="2665" char_id="1" frame_id="-1" name="玲" text="『首先是热传导检查对吧。』"   voices=""/><msg @l="2667" char_id="-1" frame_id="-1" name="真岛"   text="『先把胸部从宇航服里露出来！』" voices=""/><char @l="2670" id="rei" pos="center" src="rei014f" y="-80"/><msg @l="2672" char_id="1" frame_id="-1" name="玲" text="『啊……？』" voices=""/><msg @l="2674" char_id="-1" frame_id="-1" name="真岛"   text="『你真啰嗦啊。我们必须确认在体温下，箱内的湿度感觉如何。』" voices=""/><msg @l="2676" char_id="-1" frame_id="-1" name="真岛"   text="『反正也没人看见，快点把胸部露出来！！』" voices=""/><char @l="2679" id="rei" pos="center" src="rei015f" y="-80"/><msg @l="2681" char_id="1" frame_id="-1" name="玲" text="『知、知道了。』"   voices=""/><msg @l="2683" char_id="-1" frame_id="-1" name=""   text="虽然玲心里不太认同，但确实没人会看见，于是她从宇航服缝隙间露出丰满的胸部进行湿度检查。"   voices=""/><char @l="2686" id="rei" pos="center" src="rei185f" y="-80"/><msg @l="2688" char_id="1" frame_id="-1" name="玲"   text="『接下来是隔音检查……这个该怎么做？』" voices=""/><msg @l="2690" char_id="-1" frame_id="-1" name="真岛"   text="『我要关掉箱子里的麦克风，你在里面解说接下来发生在自己身上的事情。』" voices=""/><char @l="2693" id="rei" pos="center" src="rei184f" y="-80"/><msg @l="2695" char_id="1" frame_id="-1" name="玲" text="『啊……？』" voices=""/><msg @l="2697" char_id="-1" frame_id="-1" name=""   text="就在玲通过扬声器对这番话提出疑问之前，有什么东西已经开始触摸她露在箱子外面的下半身。" voices=""/><msg @l="2698" char_id="-1" frame_id="-1" name="" text="真岛在抚摸玲的臀部。"   voices=""/><char @l="2701" id="rei" pos="center" src="rei187f" y="-80"/><msg @l="2703" char_id="1" frame_id="-1" name="玲"   text="『喂……不要，请住手！』" voices=""/><msg @l="2705" char_id="-1" frame_id="-1" name=""   text="玲扭动着腰肢试图反抗，但由于箱子里的麦克风已被关闭，她的话语只能模糊地传到外面。"   voices=""/><msg @l="2707" char_id="-1" frame_id="-1" name="真岛"   text="『听不清啊，大声解说。』" voices=""/><msg @l="2709" char_id="-1" frame_id="-1" name=""   text="从扬声器里清晰地传来了真岛的声音。" voices=""/><msg @l="2710" char_id="-1" frame_id="-1" name=""   text="似乎只有从内部向外部传声的麦克风被关闭了。" voices=""/><msg @l="2712" char_id="1" frame_id="-1" name="玲" text="『可、可是……。』"   voices=""/><msg @l="2714" char_id="-1" frame_id="-1" name="真岛"   text="『啊？我不是说听不见吗！？』" voices=""/><char @l="2717" id="rei" pos="center" src="rei185f" y="-80"/><msg @l="2719" char_id="1" frame_id="-1" name="玲" text="『……。』" voices=""/><msg @l="2721" char_id="-1" frame_id="-1" name=""   text="玲终于意识到这项检查与之前进行的那些是同一水平的东西。" voices=""/><msg @l="2722" char_id="-1" frame_id="-1" name=""   text="也就是说，如果玲不在这里好好解说的话……果然是拿不到内定的意思吧。" voices=""/><msg @l="2724" char_id="1" frame_id="-1" name="玲" text="『……屁股。』" voices=""/><msg @l="2726" char_id="-1" frame_id="-1" name="真岛" text="『你说什么？』"   voices=""/><msg @l="2728" char_id="1" frame_id="-1" name="玲" text="『屁、屁股被抚摸了！』"   voices=""/><msg @l="2730" char_id="-1" frame_id="-1" name="真岛" text="『哦，然后呢？』"   voices=""/><msg @l="2732" char_id="-1" frame_id="-1" name=""   text="听到玲低沉的声音，真岛露出奸笑，他那抚摸着玲那美丽线条的白皙臀部的手，这次滑向了丰满的大腿之间。"   voices=""/><msg @l="2734" char_id="1" frame_id="-1" name="玲" text="『大腿……被抚摸了。』"   voices=""/><msg @l="2736" char_id="-1" frame_id="-1" name="真岛" text="『好—，那么下一个怎么样。』"   voices=""/><msg @l="2738" char_id="-1" frame_id="-1" name=""   text="用滑过大腿的手掀起裙子，隔着内裤揉捏着湿润的臀肉。" voices=""/><msg @l="2740" char_id="1" frame_id="-1" name="玲" text="『嗯……屁、屁股被揉捏着。』"   voices=""/><msg @l="2742" char_id="-1" frame_id="-1" name="真岛" text="『不只是单纯地揉吧？』"   voices=""/><msg @l="2744" char_id="1" frame_id="-1" name="玲"   text="『是、是的……隔着内裤，被揉捏着。』" voices=""/><msg @l="2746" char_id="-1" frame_id="-1" name="真岛"   text="『那么下一个是最后了……这个怎么样？』" voices=""/><msg @l="2748" char_id="-1" frame_id="-1" name=""   text="真岛带着猥琐的表情，隔着内裤抚摸着秘部。" voices=""/><begin_trans @l="2752" time="500"/><layer @l="2753" id="cutin_f" src="game_window_cutin" x="20" y="20"   z="-1001"/><layer @l="2754" id="cutin" src="cut005b" x="32" y="32" z="-1000"/><end_trans @l="2755"/><msg @l="2757" char_id="1" frame_id="-1" name="玲" text="『……！！』" voices=""/><msg @l="2759" char_id="-1" frame_id="-1" name=""   text="真岛的手指粘腻地抚摸上媚肉的瞬间，玲大幅摆动腰肢，倒吸一口气。" voices=""/><msg @l="2761" char_id="-1" frame_id="-1" name="真岛"   text="『怎么了？快回答啊。』" voices=""/><msg @l="2763" char_id="1" frame_id="-1" name="玲"   text="『内、内裤上面……被……触摸着。』" voices=""/><msg @l="2765" char_id="-1" frame_id="-1" name="真岛"   text="『啊？被摸的是哪里！？』" voices=""/><msg @l="2767" char_id="1" frame_id="-1" name="玲" text="『………。』" voices=""/><msg @l="2769" char_id="-1" frame_id="-1" name="真岛"   text="『喂，为什么沉默了母猪！』" voices=""/><msg @l="2771" char_id="-1" frame_id="-1" name="真岛"   text="『要好好说出“小穴被抚摸着”啊！！』" voices=""/><msg @l="2773" char_id="1" frame_id="-1" name="玲" text="『呜……。』" voices=""/><msg @l="2775" char_id="1" frame_id="-1" name="玲"   text="『小、小穴……被……抚摸着。』" voices=""/><msg @l="2777" char_id="-1" frame_id="-1" name="真岛"   text="『我说了听不见啊！！』" voices=""/><msg @l="2779" char_id="1" frame_id="-1" name="玲"   text="『小、小穴被……抚摸着。』" voices=""/><msg @l="2781" char_id="-1" frame_id="-1" name="真岛" text="『再说一遍！』"   voices=""/><char @l="2784" id="rei" pos="center" src="rei187f" y="-80"/><msg @l="2786" char_id="1" frame_id="-1" name="玲" text="『小穴被抚摸着！』"   voices=""/><msg @l="2788" char_id="-1" frame_id="-1" name="真岛"   text="『好，可以了。记得检查一下隔音的地方。』" voices=""/><char @l="2791" id="rei" pos="center" src="rei185f" y="-80"/><begin_trans @l="2793" time="500"/><clear @l="2794" layer="cutin_f"/><clear @l="2795" layer="cutin"/><end_trans @l="2796"/><msg @l="2798" char_id="1" frame_id="-1" name="玲" text="『……是。』" voices=""/><msg @l="2801" char_id="-1" frame_id="-1" name=""   text="说完，真岛重新打开了扬声器的开关。" voices=""/><msg @l="2802" char_id="-1" frame_id="-1" name=""   text="意识到这只是让她大声说出下流台词的测试，玲感到愤怒和羞耻，几乎要发疯。" voices=""/><msg @l="2804" char_id="-1" frame_id="-1" name=""   text="玲脸上混合着耻辱与屈辱，脸颊通红，却仍然认真地填写着手中表格上的检查栏。" voices=""/><msg @l="2806" char_id="-1" frame_id="-1" name="真岛" text="『接下来是抗冲击性的检查。』"   voices=""/><msg @l="2808" char_id="-1" frame_id="-1" name=""   text="从扬声器中传来真岛愉快的声音。" voices=""/><msg @l="2809" char_id="-1" frame_id="-1" name=""   text="玲对这过于欢快的声音感到恐惧，不自觉地咽了咽口水。" voices=""/><msg @l="2811" char_id="-1" frame_id="-1" name="真岛" text="『开始了哦？』" voices=""/><char @l="2814" id="rei" pos="center" src="rei184f" y="-80"/><msg @l="2816" char_id="1" frame_id="-1" name="玲" text="『……！？』" voices=""/><se @l="2820" buf="1" src="箱を蹴ってる" volume="1."/><shake @l="2824" amp="10" class="all" cycle="30" duration="1000"   type="random"/><msg @l="2826" char_id="-1" frame_id="-1" name=""   text="伴随着闷响，一股冲击从箱子的左侧传来。" voices=""/><msg @l="2827" char_id="-1" frame_id="-1" name="" text="真岛对耐热材料的侧面踢了一脚。"   voices=""/><char @l="2830" id="rei" pos="center" src="rei187f" y="-80"/><msg @l="2832" char_id="1" frame_id="-1" name="玲" text="『你、你在做什么啊！？』"   voices=""/><msg @l="2834" char_id="-1" frame_id="-1" name="真岛"   text="『做什么，这不是在测试抗冲击性嘛。』" voices=""/><char @l="2837" id="rei" pos="center" src="rei184f" y="-80"/><msg @l="2839" char_id="1" frame_id="-1" name="玲"   text="『就、就算是这样也不能……呀！？』" voices=""/><se @l="2843" buf="1" src="箱を蹴ってる" volume="1."/><shake @l="2847" amp="10" class="all" cycle="30" duration="1000"   type="random"/><msg @l="2849" char_id="-1" frame_id="-1" name="" text="真岛再次踢了一脚。"   voices=""/><msg @l="2850" char_id="-1" frame_id="-1" name=""   text="从墙壁传来的冲击本身并不算什么，但由于整个箱子的面积和质量较小，横向的冲击让它差点倾斜。" voices=""/><char @l="2853" id="rei" pos="center" src="rei185f" y="-80"/><msg @l="2855" char_id="1" frame_id="-1" name="玲"   text="『这、这样的话……怎么可能获得准确的数据……啊！？』" voices=""/><se @l="2859" buf="1" src="箱を蹴ってる" volume="1."/><shake @l="2863" amp="10" class="all" cycle="30" duration="1000"   type="random"/><msg @l="2865" char_id="-1" frame_id="-1" name=""   text="打断玲的话语，第三次踢击袭来。" voices=""/><msg @l="2866" char_id="-1" frame_id="-1" name=""   text="在隔热材料内部的玲无法看到，每次踢向箱子时，真岛脸上都浮现出一种恍惚的微笑。" voices=""/><msg @l="2867" char_id="-1" frame_id="-1" name=""   text="面对边狂笑边踢打隔热材料的真岛，玲感到恐惧，只能屏住呼吸，祈祷这暴行快点结束。" voices=""/><msg @l="2869" char_id="-1" frame_id="-1" name="大黑"   text="『真岛君，玩得开心是好事，但适可而止吧。』" voices=""/><msg @l="2871" char_id="-1" frame_id="-1" name="大黑"   text="『她都被吓得说不出话来了。』" voices=""/><msg @l="2873" char_id="-1" frame_id="-1" name="真岛" text="『啊……是啊。』"   voices=""/><msg @l="2875" char_id="-1" frame_id="-1" name="真岛"   text="『抱歉，我有点太兴奋了。』" voices=""/><msg @l="2877" char_id="1" frame_id="-1" name="玲" text="『……。』" voices=""/><msg @l="2879" char_id="-1" frame_id="-1" name=""   text="大黒和真岛的这段对话，透过扬声器传到了玲的耳中。" voices=""/><msg @l="2880" char_id="-1" frame_id="-1" name=""   text="玲的双眼中……已经涌出了大颗的泪水。" voices=""/><msg @l="2882" char_id="-1" frame_id="-1" name="真岛"   text="『啧，耐冲击检查就这么结束了啊。』" voices=""/><msg @l="2884" char_id="-1" frame_id="-1" name="真岛" text="『那么，接下来是耐震检查了。』"   voices=""/><msg @l="2886" char_id="-1" frame_id="-1" name=""   text="真岛边得意洋洋地说着，边开始慢慢抚摸玲美丽的臀部。" voices=""/><msg @l="2887" char_id="-1" frame_id="-1" name=""   text="就这样透过内裤享受了一会儿如桃子般的臀部触感后，他突然将那内裤拉了下来。" voices=""/><begin_trans @l="2890" time="500"/><layer @l="2891" id="cutin_f" src="game_window_cutin" x="20" y="20"   z="-1001"/><layer @l="2892" id="cutin" src="cut007" x="32" y="32" z="-1000"/><end_trans @l="2893"/><msg @l="2895" char_id="1" frame_id="-1" name="玲" text="『诶……你、你在做什么……！？』"   voices=""/><msg @l="2897" char_id="-1" frame_id="-1" name="真岛"   text="『做什么，当然是进行耐震检查啊，不是吗？』" voices=""/><begin_trans @l="2900" time="500"/><layer @l="2901" id="cutin_f" src="game_window_cutin" x="20" y="20"   z="-1001"/><layer @l="2902" id="cutin" src="cut007a" x="32" y="32" z="-1000"/><end_trans @l="2903"/><msg @l="2905" char_id="-1" frame_id="-1" name=""   text="真岛依然愉快地回答着，将手指插入了暴露出来的秘缝。" voices=""/><msg @l="2906" char_id="-1" frame_id="-1" name=""   text="玲的那里不知什么时候已从深处渗出蜜液变得湿润，真岛分开裂缝的手指瞬间就被淋得湿漉漉的。"   voices=""/><msg @l="2908" char_id="-1" frame_id="-1" name="真岛"   text="『什么啊？已经湿答答的了嘛。』" voices=""/><msg @l="2910" char_id="-1" frame_id="-1" name=""   text="一边嗅着从玲的肉瓣中散发出的圣蜜香气，真岛恶心地问道。" voices=""/><msg @l="2912" char_id="-1" frame_id="-1" name="真岛"   text="『你该不会是那种被虐待就会兴奋的受虐狂吧？』" voices=""/><msg @l="2914" char_id="-1" frame_id="-1" name="真岛"   text="『还是说刚才那一脚吓得你失禁了啊？』" voices=""/><msg @l="2916" char_id="-1" frame_id="-1" name=""   text="真岛露出虐待狂般的笑容，大声说道。" voices=""/><msg @l="2917" char_id="-1" frame_id="-1" name=""   text="与此同时，办公室各处响起了女员工们窃窃的笑声。" voices=""/><msg @l="2919" char_id="1" frame_id="-1" name="玲" text="『这种事……没、没有。』"   voices=""/><msg @l="2921" char_id="-1" frame_id="-1" name="真岛"   text="『装什么乖乖女啊，你这母猪！』" voices=""/><msg @l="2923" char_id="-1" frame_id="-1" name=""   text="真岛一边说着侮辱玲的话，一边分开粉红的肉壁，用手指轻轻地玩弄着她的女唇。" voices=""/><msg @l="2925" char_id="-1" frame_id="-1" name="真岛"   text="『现在狡辩也没用，改变不了你下面湿透了的事实。』" voices=""/><msg @l="2927" char_id="-1" frame_id="-1" name=""   text="真岛开始用手指更加执拗地揉捏玲的肉芯。" voices=""/><msg @l="2929" char_id="1" frame_id="-1" name="玲" text="『不要啊……不是这样的，这个是……』"   voices=""/><msg @l="2931" char_id="-1" frame_id="-1" name=""   text="玲拼命地想要辩解，但每当被真岛的手指触碰到秘芯时，身体都会猛地弹跳起来。" voices=""/><msg @l="2932" char_id="-1" frame_id="-1" name=""   text="当然，真岛根本不可能有耐心听她的辩解。" voices=""/><begin_trans @l="2935" time="500"/><clear @l="2936" layer="cutin_f"/><clear @l="2937" layer="cutin"/><end_trans @l="2938"/><clear @l="2940" class="char"/><msg @l="2942" char_id="-1" frame_id="-1" name="真岛"   text="『吵死了。淫乱受虐的母猪就该被鸡巴插进小穴里嗯嗯地喘着就行了！』" voices=""/><msg @l="2944" char_id="-1" frame_id="-1" name=""   text="真岛带着嘲笑的表情，一边说着，一边将肉棒抵在玲的私处。" voices=""/><msg @l="2946" char_id="-1" frame_id="-1" name="真岛"   text="『可以吗？大黑先生，我得用我的东西给这家伙肮脏的小穴消毒一下，不然对不起大黑先生啊』" voices=""/><msg @l="2948" char_id="-1" frame_id="-1" name="大黑"   text="『是啊，本来应该由我来贯穿玲小姐的，但要是被玲小姐肮脏的阴部传染了什么病可就麻烦了。』" voices=""/><msg @l="2950" char_id="1" frame_id="-1" name="玲" text="『什么！？』" voices=""/><msg @l="2952" char_id="-1" frame_id="-1" name=""   text="肮脏？……病？……这实在是太屈辱的言辞了。" voices=""/><msg @l="2953" char_id="-1" frame_id="-1" name=""   text="从小时候起，就习惯于被周围人称赞为“可爱”、“美丽”的玲来说，这是无上的侮辱言辞。" voices=""/><msg @l="2955" char_id="-1" frame_id="-1" name="" text="她的心灵几乎要崩溃了———。"   voices=""/><msg @l="2956" char_id="-1" frame_id="-1" name=""   text="她那因泪水而扭曲的美丽脸庞上，已经感觉不到往日的高傲了。" voices=""/><label @l="2959" id="event_scene40"/><label @l="2963" id="chart_line33"/><wait_chgmv/><ev @l="2967" src="ev-040"/><description @l="2970" text="二次面试B"/><bgm @l="2974" src="bgm13" volume="1."/><msg @l="2976" char_id="-1" frame_id="-1" name="真岛"   text="『这是你最喜欢的鸡巴！！母猪啊！！！！』" voices=""/><msg @l="2978" char_id="1" frame_id="-1" name="玲" text="『呃啊啊啊！！？』"   voices="rei02140"/><msg @l="2980" char_id="-1" frame_id="-1" name=""   text="肉枪一下子插入，玲发出痛苦的声音，腰部不住地颤抖。" voices=""/><msg @l="2982" char_id="-1" frame_id="-1" name="真岛"   text="『哇啊，这是什么啊。里面全都湿湿黏黏的？』" voices=""/><msg @l="2984" char_id="-1" frame_id="-1" name="真岛"   text="『果然你就是个淫乱受虐的母猪啊。』" voices=""/><msg @l="2986" char_id="-1" frame_id="-1" name=""   text="说着，真岛毫不客气地猛烈摆动腰部，用肉炮蹂躏着玲的秘缝。" voices=""/><msg @l="2987" char_id="-1" frame_id="-1" name=""   text="每当肉欲的柱身深深插入，玲的身体和耐热材料箱一起嘎吱嘎吱地摇晃着。" voices=""/><msg @l="2989" char_id="1" frame_id="-1" name="玲"   text="『嗯嗯……不要，突然这么激烈什么的……』" voices="rei02150"/><msg @l="2991" char_id="-1" frame_id="-1" name=""   text="喘着气，玲在箱子内发出悲痛的声音。" voices=""/><msg @l="2992" char_id="-1" frame_id="-1" name=""   text="不过……她的呼吸中明显带着热度，声音也微微颤抖。" voices=""/><msg @l="2994" char_id="-1" frame_id="-1" name="真岛"   text="『哦，确实如母猪小姐所说。』" voices=""/><msg @l="2996" char_id="-1" frame_id="-1" name="真岛"   text="『突然这么激烈的话，根本没法进行耐震检查啊。』" voices=""/><msg @l="2998" char_id="-1" frame_id="-1" name=""   text="故意这么说着，真岛突然完全停止了腰部的动作。" voices=""/><msg @l="3000" char_id="-1" frame_id="-1" name="真岛"   text="『那么重新开始耐震检查……先从震度1开始吧。』" voices=""/><msg @l="3002" char_id="-1" frame_id="-1" name=""   text="与刚才激烈的腰部动作相反，他用缓慢的动作，用龟头的冠状沟勾住般搅动着玲阴道内的肉壁。"   voices=""/><msg @l="3003" char_id="-1" frame_id="-1" name=""   text="虽然失去了激烈程度，但抽插的长度和腰部动作更加细致，慢慢地几乎要将前端抽出，然后又以同样每毫米的速度，花时间深深地插入到最深处。"   voices=""/><msg @l="3004" char_id="-1" frame_id="-1" name=""   text="这种程度的律动几乎不会让保温材料摇晃，当然也不会发出嘎吱声。" voices=""/><msg @l="3005" char_id="-1" frame_id="-1" name=""   text="也就是说……他是在把腰部抽插的激烈程度比作地震震级。" voices=""/><msg @l="3007" char_id="1" frame_id="-1" name="玲" text="『嗯……。』"   voices="rei02160"/><msg @l="3009" char_id="-1" frame_id="-1" name=""   text="被粗壮的肉棒慢慢搅动私处的感觉，让玲轻微颤抖着身体，发出带着鼻音的微弱呻吟。" voices=""/><msg @l="3010" char_id="-1" frame_id="-1" name=""   text="由于没有被粗暴地摩擦，她的蜜壶违背自己的意志感受着肉棒的形状和动作，玲因此感到困惑和羞耻。"   voices=""/><msg @l="3012" char_id="-1" frame_id="-1" name="真岛"   text="『嘛，震度1也就这样了。』" voices=""/><msg @l="3014" char_id="-1" frame_id="-1" name="真岛"   text="『那么接下来是震度2，开始了。』" voices=""/><msg @l="3016" char_id="-1" frame_id="-1" name=""   text="随着话音，腰部撞击的速度略微加快。" voices=""/><msg @l="3017" char_id="-1" frame_id="-1" name=""   text="比刚才稍微快一些……但依然带着某种挑逗性的动作，玲的体内被肉筒缓缓搅动着。" voices=""/><msg @l="3019" char_id="1" frame_id="-1" name="玲" text="『嗯嗯……啊……。』"   voices="rei02170"/><msg @l="3021" char_id="-1" frame_id="-1" name=""   text="随着真岛缓慢的动作，玲的口中漏出了柔弱而痛苦的声音。" voices=""/><msg @l="3022" char_id="-1" frame_id="-1" name=""   text="这声音听起来仿佛在邀请更加激烈的动作。" voices=""/><msg @l="3024" char_id="-1" frame_id="-1" name="真岛" text="『这样不错吧？』"   voices=""/><msg @l="3026" char_id="-1" frame_id="-1" name="真岛"   text="『我一开始猛烈抽动是因为，在痛到极限后再被挑逗，你会变得更加敏感，更加难以忍受。』"   voices=""/><msg @l="3028" char_id="-1" frame_id="-1" name="真岛"   text="『特别是对你这种淫乱受虐狂来说，简直无法抵抗吧？』" voices=""/><msg @l="3030" char_id="1" frame_id="-1" name="玲"   text="『才、才不是那样…嗯，啊呜……。』" voices="rei02180"/><msg @l="3032" char_id="1" frame_id="-1" name="玲"   text="『不要…那里，别摩擦…嗯，唔唔！』" voices="rei02190"/><msg @l="3034" char_id="-1" frame_id="-1" name="真岛"   text="『发出一副渴求的声音，还说什么别摩擦。』" voices=""/><msg @l="3036" char_id="-1" frame_id="-1" name="真岛"   text="『其实你想要被更激烈地侵犯吧？但不行哦。』" voices=""/><msg @l="3038" char_id="-1" frame_id="-1" name=""   text="真岛一边戏谑地笑着，一边仍以缓慢的速度继续摆动着腰部。" voices=""/><msg @l="3040" char_id="1" frame_id="-1" name="玲"   text="『啊啊……嗯，嗯，啊……。』" voices="rei02200"/><msg @l="3042" char_id="1" frame_id="-1" name="玲"   text="『啊……嗯呜……啊，不要……。』" voices="rei02210"/><msg @l="3044" char_id="-1" frame_id="-1" name=""   text="随着真岛缓慢的腰部动作，玲的美臀在左右摇晃。" voices=""/><msg @l="3045" char_id="-1" frame_id="-1" name=""   text="这是为了逃离贯穿秘裂的那个东西而做的动作，还是如真岛所说想要被激烈侵犯的意志表现，连玲自己都不清楚。"   voices=""/><msg @l="3047" char_id="-1" frame_id="-1" name="真岛"   text="『哎哎，腰已经在动了嘛。』" voices=""/><msg @l="3049" char_id="-1" frame_id="-1" name="真岛"   text="『震度2级就这样，后面可怎么办啊？』" voices=""/><msg @l="3051" char_id="-1" frame_id="-1" name=""   text="真岛看着她腰部的扭动感到满足，一边愉快地揉捏着玲白皙的双臀，一边浮现出愉悦的笑容。" voices=""/><msg @l="3053" char_id="1" frame_id="-1" name="玲"   text="『嗯呜……不，嗯……啊啊……。』" voices="rei02220"/><msg @l="3055" char_id="-1" frame_id="-1" name="真岛"   text="『一边扭腰一边说什么都没有说服力啊，母猪。』" voices=""/><msg @l="3057" char_id="-1" frame_id="-1" name="真岛"   text="『看啊……接下来是震度3级，要渐渐变得激烈了哦。』" voices=""/><shake @l="3061" amp="10" class="all" cycle="30" duration="1000"   type="random"/><msg @l="3063" char_id="1" frame_id="-1" name="玲" text="『啊啊啊！！』"   voices="rei02230"/><msg @l="3065" char_id="-1" frame_id="-1" name=""   text="真岛进一步加快了抽插的速度，将男根的前端比之前更深更强地推进到子宫口。" voices=""/><msg @l="3067" char_id="1" frame_id="-1" name="玲" text="『啊呜，嗯，嗯……嗯嗯！』"   voices="rei02240"/><msg @l="3069" char_id="-1" frame_id="-1" name=""   text="断热材料的箱子发出吱吱嘎嘎的声音，玲的身体前后摇晃着。" voices=""/><msg @l="3070" char_id="-1" frame_id="-1" name=""   text="事实上，无论那是否真的是震度3的摇晃……由断热材料制成的四方小房间纹丝不动，在这前后运动中依然保持着原有的形状。"   voices=""/><msg @l="3072" char_id="-1" frame_id="-1" name="真岛"   text="『喂，你有好好检查吗！？』" voices=""/><msg @l="3074" char_id="1" frame_id="-1" name="玲"   text="『嗯嗯……嗯……嗯………啊啊！！』" voices="rei02250"/><msg @l="3076" char_id="-1" frame_id="-1" name="真岛"   text="『哈哈，已经顾不上那些事了吧！？』" voices=""/><msg @l="3078" char_id="-1" frame_id="-1" name=""   text="每当真岛所谓的“震度”提高，玲就会发出炽热的呻吟，甚至连拒绝的话语都无暇说出。" voices=""/><msg @l="3079" char_id="-1" frame_id="-1" name=""   text="从玲的秘处涌出咕叽咕叽的爱液，真岛的肉棒沾满了起泡的爱液，淫靡地湿漉漉闪着光。" voices=""/><msg @l="3081" char_id="-1" frame_id="-1" name="真岛" text="『震度4！』"   voices=""/><shake @l="3085" amp="10" class="all" cycle="30" duration="1000"   type="random"/><msg @l="3087" char_id="-1" frame_id="-1" name=""   text="真岛像疯狗一样大叫着，毫不客气地将腰部撞击在玲的臀部上，以足以冲破子宫口的气势将肉棒插入秘处。" voices=""/><msg @l="3088" char_id="-1" frame_id="-1" name=""   text="那已经不是什么震度4能形容的振动了，但无论是真岛还是玲，这些都已经无关紧要。痛苦与快感交织在一起。"   voices=""/><msg @l="3090" char_id="1" frame_id="-1" name="玲"   text="『嗯啊，啊，啊，啊，啊呜！！』" voices="rei02260"/><msg @l="3092" char_id="-1" frame_id="-1" name=""   text="随着断热材料箱子剧烈的吱嘎声，玲发出的喘息也变得更加激烈。" voices=""/><msg @l="3093" char_id="-1" frame_id="-1" name=""   text="从她那可爱的嘴唇中，只有甜美的呻吟声不断地泄露出来。" voices=""/><msg @l="3095" char_id="-1" frame_id="-1" name="真岛"   text="『真不错啊，明明没用鞭子和绳子，状态却这么好。』" voices=""/><msg @l="3097" char_id="-1" frame_id="-1" name="真岛"   text="『你的小穴散发出的母猪味让我兴奋得发抖啊。』" voices=""/><msg @l="3099" char_id="-1" frame_id="-1" name=""   text="真岛一边嗅着从玲花瓣般的私处散发出的粘稠花蜜香气，一边露出更加下流的笑容。" voices=""/><msg @l="3101" char_id="1" frame_id="-1" name="玲"   text="『嗯哈，啊啊……嗯，嗯，嗯，啊呜！！』" voices="rei02270"/><msg @l="3103" char_id="1" frame_id="-1" name="玲"   text="『啊啊……嗯，啊呜……啊，啊，嗯啊啊！！』" voices="rei02280"/><msg @l="3105" char_id="-1" frame_id="-1" name=""   text="玲发出一声急促的叫声，她那白皙美丽的身体如同通电般猛地向后弓起。" voices=""/><msg @l="3106" char_id="-1" frame_id="-1" name=""   text="她的呼吸，她的身体，她的私处……她的一切都在宣告着“极限”。" voices=""/><msg @l="3108" char_id="-1" frame_id="-1" name="真岛" text="『呃……真没出息，我也到极限了。』"   voices=""/><msg @l="3110" char_id="-1" frame_id="-1" name="真岛"   text="『耐震测试结束……接下来直接进行防水测试吧！』" voices=""/><msg @l="3112" char_id="1" frame_id="-1" name="玲"   text="『啊，啊，啊，啊……不行，不行……呜，啊啊！！』" voices="rei02290"/><msg @l="3114" char_id="1" frame_id="-1" name="玲"   text="『还……嗯啊，要去了……要去……嗯嗯嗯！！』" voices="rei02300"/><msg @l="3116" char_id="-1" frame_id="-1" name="真岛" text="『我也要来了！』" voices=""/><msg @l="3118" char_id="1" frame_id="-1" name="玲" text="『嗯，啊啊啊啊啊啊啊啊！！！』"   voices="rei02310"/><flash @l="3122" count="4" fade="100" image="white"/><wait_chgmv/><ev @l="3126" src="ev-040z1"/><msg @l="3128" char_id="-1" frame_id="-1" name=""   text="在攀升至顶点的瞬间……真岛从玲的花唇中抽出怒涨的前端，自己套弄了几下，然后将大量白浊液体洒在了她圆润洁白的臀部上。"   voices=""/><msg @l="3130" char_id="1" frame_id="-1" name="玲" text="『嗯……啊……。』"   voices="rei02320"/><msg @l="3132" char_id="-1" frame_id="-1" name=""   text="感受到那热烫的液体飞溅在泛着粉红色潮红的肌肤上，玲的腰微微颤抖着。" voices=""/><msg @l="3134" char_id="1" frame_id="-1" name="玲"   text="『哈……哈……哈……嗯……啊……。』" voices="rei02330"/><msg @l="3136" char_id="-1" frame_id="-1" name=""   text="在被隔热材料包围的箱子里，感到些许呼吸困难……。" voices=""/><msg @l="3137" char_id="-1" frame_id="-1" name=""   text="玲在高潮的余韵中轻微痉挛着，吐出炽热的喘息。" voices=""/><stopbgm @l="3141" fadeout="1000"/><clear @l="3147" class="all"/><end_scene @l="3150"/><wait_chgmv/><bg @l="3154" src="bg17h1"/><bgm @l="3158" src="bgm09" volume="1."/><char @l="3162" id="ookur" pos="auto" src="ookuro010"/><msg @l="3164" char_id="-1" frame_id="-1" name="大黑" text="『辛苦了。』"   voices=""/><msg @l="3166" char_id="-1" frame_id="-1" name="大黑"   text="『虽然最后的检查有些含糊，但检查结果总体良好。』" voices=""/><msg @l="3168" char_id="-1" frame_id="-1" name=""   text="大黑向刚刚把欲望的体液撒在玲白皙光滑臀部上的真岛，说了慰问的话。" voices=""/><msg @l="3169" char_id="-1" frame_id="-1" name=""   text="真岛一边露出玩世不恭的笑容回应，一边收起自己的东西。" voices=""/><msg @l="3171" char_id="-1" frame_id="-1" name="真岛"   text="『这家伙相当不错啊。不愧是大黑先生看中的女人。』" voices=""/><msg @l="3173" char_id="-1" frame_id="-1" name="真岛"   text="『如果交给我的话，两周……不，10天我就能把她调教成一个以鸡巴和精液为最爱的完美受虐奴隶。』" voices=""/><msg @l="3175" char_id="-1" frame_id="-1" name=""   text="真岛切断了连接到箱子里的麦克风开关后说道。" voices=""/><msg @l="3176" char_id="-1" frame_id="-1" name=""   text="从耳机中传来了箱子里沉浸在高潮余韵中的玲发出的灼热喘息声。" voices=""/><msg @l="3178" char_id="-1" frame_id="-1" name="大黑"   text="『原来如此。那就请你务必接手这件事吧。』" voices=""/><msg @l="3180" char_id="-1" frame_id="-1" name="大黑"   text="『请务必在她心中植入无上的屈辱感和淫欲。』" voices=""/><msg @l="3182" char_id="-1" frame_id="-1" name="真岛" text="『嗯，我明白。』"   voices=""/><msg @l="3184" char_id="-1" frame_id="-1" name="大黑"   text="『另外，其他女人随时可以找到替代品，但玲小姐是特别的，所以千万不要把她弄坏了。』" voices=""/><msg @l="3186" char_id="-1" frame_id="-1" name="真岛" text="『嗯，明白了。』"   voices=""/><msg @l="3188" char_id="-1" frame_id="-1" name="大黑"   text="『看着那个曾经高傲的玲小姐一步步堕落，是无上的喜悦啊。』" voices=""/><msg @l="3190" char_id="-1" frame_id="-1" name="真岛"   text="『我会按照大黑先生想要的方式把她调教得妥妥的。』" voices=""/><msg @l="3192" char_id="-1" frame_id="-1" name="真岛"   text="『我会把她调教成一边哭着一边求着要鸡巴的母猪。』" voices=""/><msg @l="3194" char_id="-1" frame_id="-1" name=""   text="真岛露出一抹嗜虐的笑容，用充满侮辱的眼神肆意打量着从箱子里伸出的玲那狼狈不堪的下半身。"   voices=""/><stopbgm @l="3198" fadeout="1000"/><clear @l="3204" class="all"/><label @l="3207" id="event_scene52"/><label @l="3211" id="chart_line34"/><wait_chgmv/><bg @l="3215" src="bg17b"/><msg @l="3217" char_id="-1" frame_id="-1" name="" text="———同日·深夜。" voices=""/><msg @l="3218" char_id="-1" frame_id="-1" name=""   text="尽管末班电车时间临近，大部分员工都已离开，但公司内闻名的“人才派遣部”办公室里依然亮着灯。" voices=""/><msg @l="3219" char_id="-1" frame_id="-1" name=""   text="办公室里只剩下几名男性。" voices=""/><bgm @l="3223" src="bgm14" volume="1."/><wait_chgmv/><ev @l="3227" src="ev-052y1y3"/><description @l="3229" text="二次试验C"/><msg @l="3231" char_id="1" frame_id="-1" name="声音" text="『嗯，啊啊！！』"   voices="rei02340"/><msg @l="3233" char_id="-1" frame_id="-1" name="" text="甜腻的声音在办公室内回荡。"   voices=""/><msg @l="3235" char_id="-1" frame_id="-1" name="男员工A"   text="『喂，还没完事吗？』" voices=""/><msg @l="3237" char_id="-1" frame_id="-1" name="男员工B"   text="『别急……马上就好了。』" voices=""/><msg @l="3239" char_id="-1" frame_id="-1" name=""   text="办公室一角围观的人群中传来烦躁的声音，另一边则有人在安抚。" voices=""/><msg @l="3240" char_id="-1" frame_id="-1" name=""   text="这种场景在这个“人才派遣部”时不时就能看到。" voices=""/><msg @l="3241" char_id="-1" frame_id="-1" name=""   text="按照真岛的命令，任意挑选数名男性员工留下加班。" voices=""/><msg @l="3242" char_id="-1" frame_id="-1" name=""   text="是的……这是“人才派遣部”新人培训的一环。" voices=""/><msg @l="3244" char_id="1" frame_id="-1" name="玲" text="『嗯嗯……啊，嗯呃……。』"   voices="rei02350"/><msg @l="3246" char_id="-1" frame_id="-1" name=""   text="在搬开办公桌腾出的空间里，玲被放倒在地。" voices=""/><msg @l="3247" char_id="-1" frame_id="-1" name=""   text="人才派遣部的男性员工正在侵犯着她暴露的私处和两个颤抖的乳房。" voices=""/><msg @l="3249" char_id="-1" frame_id="-1" name="男员工B"   text="『看，看看看看！再夹紧点！』" voices=""/><msg @l="3251" char_id="-1" frame_id="-1" name="男员工C"   text="『哇哦……这家伙的乳交太棒了。』" voices=""/><msg @l="3253" char_id="1" frame_id="-1" name="玲"   text="『不要……嗯……嗯……不要那么用力，啊啊！！』" voices="rei02360"/><msg @l="3255" char_id="-1" frame_id="-1" name=""   text="男性们随意蹂躏着她的身体，但玲依然自己揉捏着乳房，从左右两侧以适当的力度挤压着肉棒。巨乳像垫子一样弹动着，那丰满的触感有着舒适的柔软度。"   voices=""/><msg @l="3256" char_id="-1" frame_id="-1" name=""   text="与内心相反……一阵阵灼热的战栗沿着脊背蔓延开来。" voices=""/><clear @l="3259" class="ev"/><wait_chgmv/><bg @l="3263" src="bg17b"/><char @l="3267" id="ookur" pos="auto" src="ookuro010"/><msg @l="3269" char_id="-1" frame_id="-1" name="大黑" text="『情况怎么样？』"   voices=""/><msg @l="3271" char_id="-1" frame_id="-1" name=""   text="大黑站在人群一角观察着玲的情况，开口问道。" voices=""/><msg @l="3272" char_id="-1" frame_id="-1" name=""   text="他看起来并不像是要离开的样子，大概是来看看玲的状况吧。" voices=""/><msg @l="3274" char_id="-1" frame_id="-1" name="真岛"   text="『啊，大黑先生……状态相当不错。』" voices=""/><msg @l="3276" char_id="-1" frame_id="-1" name="真岛"   text="『一开始她还有点抵抗，但我让人强行插进去后就变成那样了。』" voices=""/><msg @l="3278" char_id="-1" frame_id="-1" name="大黑" text="『没有使用药物吗？』"   voices=""/><msg @l="3280" char_id="-1" frame_id="-1" name="真岛"   text="『不用药也可以做到。还是您觉得应该用药？』" voices=""/><msg @l="3282" char_id="-1" frame_id="-1" name="大黑"   text="『不，如果不用药就能调教好，那再好不过了。』" voices=""/><msg @l="3284" char_id="-1" frame_id="-1" name="大黑"   text="『玲沦落无妨，但要她崩溃……这有点。』" voices=""/><msg @l="3286" char_id="-1" frame_id="-1" name="真岛"   text="『话说回来，大黑先生您怎么样，要不要也来一发？』" voices=""/><msg @l="3288" char_id="-1" frame_id="-1" name="大黑"   text="『这个嘛。如果可以的话，我想先婉拒……』" voices=""/><msg @l="3290" char_id="-1" frame_id="-1" name="真岛"   text="『啊，真的吗？居然是大黑先生您！？身体不舒服吗？』" voices=""/><msg @l="3292" char_id="-1" frame_id="-1" name="大黑"   text="『不不，不是那样的。实际上，这位玲女士是我高中时代的女神，我不知道曾多少次想着她自慰……』"   voices=""/><msg @l="3294" char_id="-1" frame_id="-1" name="大黑"   text="『如果我马上就射了，在各位员工面前，作为社长的体面……你懂的。』" voices=""/><msg @l="3296" char_id="-1" frame_id="-1" name="真岛"   text="『原来如此，不过没关系的，这帮家伙经常看到大黑先生厉害的一面。』" voices=""/><msg @l="3298" char_id="-1" frame_id="-1" name="大黑"   text="『那么，恭敬不如从命，等大家都冷静下来后我再享用吧。』" voices=""/><wait_chgmv/><ev @l="3302" src="ev-052y1y3"/><msg @l="3304" char_id="1" frame_id="-1" name="玲" text="『唔唔，唔，唔……啊啊！！』"   voices="rei02370"/><msg @l="3306" char_id="-1" frame_id="-1" name=""   text="不顾大黑他们的对话，男人们依然如饥似渴地继续侵犯着玲的身体。" voices=""/><msg @l="3307" char_id="-1" frame_id="-1" name=""   text="一个人用肉刃发出咕叽咕叽的声音贯穿着她炽热的秘穴，另一个人则把巨根夹在她美丽摇晃的丰满乳肉之间享受着那触感。"   voices=""/><msg @l="3309" char_id="-1" frame_id="-1" name="男员工B"   text="『要来了要来了……好，我要射了，要射了！』" voices=""/><msg @l="3311" char_id="-1" frame_id="-1" name="男员工C"   text="『我这边也要，要射得你满脸都是！』" voices=""/><msg @l="3313" char_id="-1" frame_id="-1" name=""   text="覆盖在玲身体上的两个人，像是最后冲刺一般同时猛烈地摆动腰部。活塞运动的速度达到了极限。"   voices=""/><msg @l="3315" char_id="1" frame_id="-1" name="玲"   text="『嗯啊，不行，嗯……啊啊啊啊！！』" voices="rei02380"/><flash @l="3319" count="4" fade="100" image="white"/><wait_chgmv/><ev @l="3323" src="ev-052x1y1y3z1z4"/><msg @l="3325" char_id="1" frame_id="-1" name="玲"   text="『啊，啊啊……好烫……射了这么多……。』" voices="rei02390"/><msg @l="3327" char_id="-1" frame_id="-1" name=""   text="玲那桃色潮红的美丽脸庞和蜜壶都被浇灌了大量炙热欲望的粘液，她身体抽搐着发出了哀切的声音。" voices=""/><msg @l="3329" char_id="-1" frame_id="-1" name="男员工B"   text="『嘿嘿……射了你满满的。』" voices=""/><msg @l="3331" char_id="-1" frame_id="-1" name="男员工C" text="『脸和胸都变得雪白了呢。』"   voices=""/><msg @l="3333" char_id="-1" frame_id="-1" name=""   text="两个人仿佛沉浸在余韵中一样，对着玲的身体歪着嘴笑了。" voices=""/><msg @l="3334" char_id="-1" frame_id="-1" name=""   text="他们的表情完全忘记了这只是一项“工作”。" voices=""/><clear @l="3337" class="ev"/><wait_chgmv/><bg @l="3340" src="bg17b"/><msg @l="3342" char_id="-1" frame_id="-1" name="真岛"   text="『喂，结束了就赶紧换人。』" voices=""/><msg @l="3344" char_id="-1" frame_id="-1" name="真岛"   text="『大黑先生要亲自来尝尝味道啊。』" voices=""/><char @l="3348" id="ookur" pos="auto" src="ookuro010"/><msg @l="3350" char_id="-1" frame_id="-1" name="大黑"   text="『抱歉打乱了顺序。』" voices=""/><msg @l="3352" char_id="-1" frame_id="-1" name="男员工B"   text="『没事没事，人才派遣部全靠社长您。』" voices=""/><msg @l="3354" char_id="-1" frame_id="-1" name="男员工C"   text="『确实如此。请别在意顺序，随您喜欢怎么使用都可以。』" voices=""/><msg @l="3356" char_id="-1" frame_id="-1" name=""   text="两名男员工说着从玲的身体上退开，把位置让给了大黑。" voices=""/><msg @l="3358" char_id="-1" frame_id="-1" name="真岛"   text="『大黑先生，胸和小穴……您要用哪个？』" voices=""/><msg @l="3360" char_id="-1" frame_id="-1" name="大黑"   text="『让我想想……那么，试试乳交吧。』" voices=""/><msg @l="3362" char_id="-1" frame_id="-1" name="男员工A" text="『那、那个……。』"   voices=""/><msg @l="3364" char_id="-1" frame_id="-1" name="真岛" text="『啊？』" voices=""/><msg @l="3366" char_id="-1" frame_id="-1" name=""   text="听到大黑和真岛的对话，一名在人群中等待轮到自己的男员工挪了过来。" voices=""/><msg @l="3368" char_id="-1" frame_id="-1" name="真岛" text="『你小子想干嘛？』"   voices=""/><msg @l="3370" char_id="-1" frame_id="-1" name="男员工A"   text="『那个，我是下一个轮到的人……』" voices=""/><msg @l="3372" char_id="-1" frame_id="-1" name="男员工A"   text="『如果社长要用胸的话，我可以同时用下面那里吗？』" voices=""/><msg @l="3374" char_id="-1" frame_id="-1" name="真岛"   text="『啊？别开玩笑了。』" voices=""/><msg @l="3376" char_id="-1" frame_id="-1" name="真岛"   text="『给我老实等到大黑先生结束，你这废物玩意！』" voices=""/><msg @l="3378" char_id="-1" frame_id="-1" name="男员工A"   text="『呃……对、对不起！！』" voices=""/><msg @l="3380" char_id="-1" frame_id="-1" name=""   text="被真岛一声呵斥，那名男员工缩着肩膀变得畏畏缩缩。" voices=""/><msg @l="3381" char_id="-1" frame_id="-1" name=""   text="顺带一提，他所属的部门是财务部，是从别处听说了今天的新人教育而擅自参加的其他部门人员，所以不知道这里的“潜规则”。"   voices=""/><msg @l="3383" char_id="-1" frame_id="-1" name="大黑" text="『算了算了。』" voices=""/><msg @l="3385" char_id="-1" frame_id="-1" name="大黑"   text="『真岛君，别那么死板嘛，让他也一起参与不就行了吗？』" voices=""/><msg @l="3387" char_id="-1" frame_id="-1" name="真岛" text="『但是……』"   voices=""/><msg @l="3389" char_id="-1" frame_id="-1" name="大黑"   text="『这样的话，我也会更加兴奋呢……』" voices=""/><msg @l="3391" char_id="-1" frame_id="-1" name="真岛"   text="『嗯，既然大黑先生都这么说了，那我也没什么意见……』" voices=""/><msg @l="3393" char_id="-1" frame_id="-1" name="大黑"   text="『那么，你去侵犯她的那里吧。』" voices=""/><msg @l="3395" char_id="-1" frame_id="-1" name="男员工A"   text="『啊，谢谢您！』" voices=""/><wait_chgmv/><ev @l="3399" src="ev-052y2y4z1z4"/><msg @l="3401" char_id="-1" frame_id="-1" name="大黑"   text="『我会好好品尝的。』" voices=""/><msg @l="3403" char_id="-1" frame_id="-1" name=""   text="内心深处，大黑因过度喜悦而颤抖着。因为高中时代那个他一直朝思暮想的玲，现在已经成为了任他摆布的宠物。" voices=""/><msg @l="3405" char_id="-1" frame_id="-1" name=""   text="大黑占据了玲的上半身，将她那丰满洁白的乳房聚拢，然后把自己的分身挤进形成的乳沟中。" voices=""/><msg @l="3406" char_id="-1" frame_id="-1" name=""   text="像棉花糖一样柔软的双峰却又有着确实的弹性，紧紧包裹住被挤入沟壑中的肉柱。" voices=""/><msg @l="3408" char_id="-1" frame_id="-1" name="大黑"   text="『哦哦，这确实很棒啊。』" voices=""/><msg @l="3410" char_id="-1" frame_id="-1" name=""   text="大黑因肌肤那吸附般的触感而发出欢喜的声音笑了起来。" voices=""/><msg @l="3412" char_id="1" frame_id="-1" name="玲" text="『……。』"   voices="rei02400"/><msg @l="3414" char_id="-1" frame_id="-1" name=""   text="玲甚至没有看大黑一眼……只是像在忍耐着什么一样望着天花板。" voices=""/><msg @l="3415" char_id="-1" frame_id="-1" name="" text="这大概是微小的反抗吧。"   voices=""/><msg @l="3416" char_id="-1" frame_id="-1" name=""   text="然而不管玲的这种态度，刚才那位男性员工将肉棒的前端抵在溢满蜜液如花朵般的秘门上……一口气插入到最深处。"   voices=""/><msg @l="3418" char_id="1" frame_id="-1" name="玲" text="『啊，唔唔！！』"   voices="rei02410"/><msg @l="3420" char_id="-1" frame_id="-1" name=""   text="在插入的瞬间，似乎无法忍受肉壁被如此粗暴摩擦的刺激，玲不禁发出声音并扭动着身体。"   voices=""/><msg @l="3422" char_id="-1" frame_id="-1" name="男员工A"   text="『哇，好厉害……阴道内壁紧紧缠绕过来！』" voices=""/><msg @l="3424" char_id="-1" frame_id="-1" name=""   text="男子一边发出像是叫喊一般的欢喜声，一边猛烈地挺动着刚刚插入的肉根，蹂躏着玲的秘裂。" voices=""/><msg @l="3425" char_id="-1" frame_id="-1" name=""   text="由于持续进行着过于深入且激烈的抽插，结合处不断滴落出之前那名男子射入的精液，发出咕啾咕啾的声音。" voices=""/><msg @l="3427" char_id="-1" frame_id="-1" name="大黑" text="『哈哈，一开始就这么猛啊。』"   voices=""/><msg @l="3429" char_id="-1" frame_id="-1" name="男员工A"   text="『抱、抱歉……里面太舒服了。』" voices=""/><msg @l="3431" char_id="-1" frame_id="-1" name="大黑"   text="『不不，请别客气，尽情地侵犯她吧。』" voices=""/><msg @l="3433" char_id="-1" frame_id="-1" name=""   text="大黑一边越过肩膀与对方交谈，一边仔细揉搓着玲丰满的乳房。" voices=""/><msg @l="3434" char_id="-1" frame_id="-1" name=""   text="他一边揉捏着几乎要从手掌中溢出的丰满，一边慢慢地撸动着插入乳沟中的硬挺肉棒。"   voices=""/><msg @l="3436" char_id="-1" frame_id="-1" name="大黑"   text="『真不错，手感和大小都很充分……这么适合乳交的胸部可不多见啊。』" voices=""/><msg @l="3438" char_id="1" frame_id="-1" name="玲"   text="『嗯啊……呀，啊啊……嗯，嗯……。』" voices="rei02420"/><msg @l="3440" char_id="-1" frame_id="-1" name=""   text="每当那灼热坚硬的欲望之棒如同征服般地在美丽双峰之间摩擦上下时，玲虽然面露厌恶之色，却仍然漏出甜美的喘息，身体微微颤抖。"   voices=""/><msg @l="3441" char_id="-1" frame_id="-1" name=""   text="是被侵犯的状况转变为了快感，从而让她兴奋了吗。" voices=""/><msg @l="3442" char_id="-1" frame_id="-1" name=""   text="还是说她已经堕落到连乳沟都能感受到快感的地步了……。" voices=""/><msg @l="3444" char_id="-1" frame_id="-1" name="男员工A"   text="『哦，怎么突然变紧了？』" voices=""/><msg @l="3446" char_id="-1" frame_id="-1" name="真岛" text="『那是她快高潮的征兆啊。』"   voices=""/><msg @l="3448" char_id="-1" frame_id="-1" name="真岛"   text="『试着用力顶一下最深处看看。她肯定会夹得更紧的。』" voices=""/><msg @l="3450" char_id="-1" frame_id="-1" name="男员工A" text="『好、好的！』"   voices=""/><msg @l="3452" char_id="-1" frame_id="-1" name=""   text="在真岛的鼓励下，之前侵犯玲的男子深沉地压低腰部，让肉棒前端猛烈地顶撞着阴道最深处……子宫口附近。"   voices=""/><msg @l="3454" char_id="1" frame_id="-1" name="玲"   text="『嗯啊，啊……不行……那里，那样用力顶的话！！』" voices="rei02430"/><msg @l="3456" char_id="-1" frame_id="-1" name=""   text="每当男子的腰部发出啪啪的清脆节奏撞击时，玲都会边颤抖着腰肢边喘息。" voices=""/><msg @l="3457" char_id="-1" frame_id="-1" name="" text="看来那里是她的弱点。"   voices=""/><msg @l="3459" char_id="-1" frame_id="-1" name="男员工A"   text="『真、真的诶……每次顶到深处时，她的小穴都会紧紧地收缩，像是要榨取似的蠕动着！！』" voices=""/><msg @l="3461" char_id="-1" frame_id="-1" name=""   text="对阴道内的变化感到欣喜若狂，男人更加执拗地瞄准子宫口，仿佛要贯穿般地猛烈冲击。" voices=""/><msg @l="3462" char_id="-1" frame_id="-1" name=""   text="技巧上可能稍显不足，但对现在的玲来说，这种单调反而成了强烈的刺激。" voices=""/><msg @l="3464" char_id="1" frame_id="-1" name="玲"   text="『啊呜……嗯嗯……嗯，嗯，嗯……嗯啊啊啊！』" voices="rei02440"/><msg @l="3466" char_id="1" frame_id="-1" name="玲"   text="『不行，那里……嗯嗯………不要，那样顶上来……。』" voices="rei02450"/><msg @l="3468" char_id="-1" frame_id="-1" name=""   text="每当被强烈地撞击深处时，都会发出咕啾咕啾的淫靡声响，秘处也吐出白色的蜜汁。" voices=""/><msg @l="3469" char_id="-1" frame_id="-1" name=""   text="玲露出雪白的脖颈，不断地发出娇喘。" voices=""/><msg @l="3471" char_id="-1" frame_id="-1" name="大黑" text="『气氛相当热烈啊。』"   voices=""/><msg @l="3473" char_id="-1" frame_id="-1" name=""   text="粘腻地吸附着美丽乳房揉捏的大黑，说着这话，像是要认真起来一般，从两侧强烈挤压乳沟，让肉棒在中间摩擦。"   voices=""/><msg @l="3474" char_id="-1" frame_id="-1" name=""   text="从如小丘般的双乳之间，因玲湿润的白色汗水，发出仿佛私处一般的咕啾咕啾淫靡声响。"   voices=""/><msg @l="3476" char_id="-1" frame_id="-1" name="大黑"   text="『那么，我也来努力一下吧。』" voices=""/><msg @l="3478" char_id="-1" frame_id="-1" name=""   text="那高傲、不容他人接近的凛然美丽……如今却在自己身下，像是依附般，沦为乞求肉棒的母猪。"   voices=""/><msg @l="3480" char_id="-1" frame_id="-1" name=""   text="不知道多少次，想象着这样的场景自慰过。" voices=""/><msg @l="3481" char_id="-1" frame_id="-1" name=""   text="而现在，这一切就作为现实呈现在眼前——" voices=""/><msg @l="3482" char_id="-1" frame_id="-1" name=""   text="仅仅是这样想着，大黑就感到了几乎要射精的兴奋。" voices=""/><msg @l="3484" char_id="1" frame_id="-1" name="玲" text="『呃啊，啊，啊，嗯嗯！！』"   voices="rei02460"/><msg @l="3486" char_id="1" frame_id="-1" name="玲"   text="『嗯……啊，啊，啊，嗯呜……啊啊！！』" voices="rei02470"/><msg @l="3488" char_id="-1" frame_id="-1" name=""   text="被两根不同的肉柱以各自的速度美妙地蹂躏着，玲逐渐发出甜美的叹息。" voices=""/><msg @l="3489" char_id="-1" frame_id="-1" name=""   text="声音变得尖锐，不知不觉中她的腰也跟着侵犯花唇的男人的腰部动作有节奏地摆动起来。不断漏出喘息，下半身淫荡地扭动着。"   voices=""/><msg @l="3491" char_id="-1" frame_id="-1" name="男员工A"   text="『我，我已经……要射了！』" voices=""/><msg @l="3493" char_id="-1" frame_id="-1" name=""   text="粗重地反复喘息着，侵犯着子宫的男人发出了可怜的声音。" voices=""/><msg @l="3494" char_id="-1" frame_id="-1" name=""   text="从他的腰部剧烈颤抖来看，到现在为止他应该是在意识到周围环境而忍耐着吧。" voices=""/><msg @l="3496" char_id="-1" frame_id="-1" name="真岛"   text="『不错啊，就那样满满地注入到她深处吧。』" voices=""/><msg @l="3498" char_id="-1" frame_id="-1" name="男员工A" text="『哈，哈啊啊！』"   voices=""/><msg @l="3500" char_id="-1" frame_id="-1" name=""   text="对真岛的话回应着无力的回答，男人使劲将自己的顶端猛击子宫，像是要贯穿它一般撞击着。" voices=""/><msg @l="3503" char_id="-1" frame_id="-1" name="大黑" text="『哦，我也快要射了。』"   voices=""/><msg @l="3505" char_id="-1" frame_id="-1" name=""   text="在如白桃般柔软的乳沟中摩擦着的肉棒一抖一抖，大黑喘着粗气。" voices=""/><msg @l="3506" char_id="-1" frame_id="-1" name=""   text="然后用指尖捏住胸部凸起顶端那如同大颗樱桃般的乳头，用力地拧转。" voices=""/><msg @l="3508" char_id="-1" frame_id="-1" name=""   text="那位玲小姐，正用媚眼看着自己。与高中时代的立场完全颠倒了。" voices=""/><msg @l="3509" char_id="-1" frame_id="-1" name=""   text="从前，玲小姐看自己的表情，就像是在看虫子一样充满厌恶。" voices=""/><msg @l="3510" char_id="-1" frame_id="-1" name=""   text="但现在怎么样？她用湿润的眼睛诱惑地问着：“舒服吗？请更加享受吧。”" voices=""/><msg @l="3512" char_id="-1" frame_id="-1" name=""   text="堕落女神……在这行为中，大黑感受到了前所未有的征服感，胸中满溢而出。" voices=""/><msg @l="3514" char_id="1" frame_id="-1" name="玲"   text="『嗯啊……嗯嗯，嗯，嗯，嗯，嗯！！』" voices="rei02480"/><msg @l="3516" char_id="1" frame_id="-1" name="玲"   text="『啊呜，嗯……嗯啊……不行啊……啊，啊，啊啊啊！！』" voices="rei02490"/><msg @l="3518" char_id="-1" frame_id="-1" name=""   text="玲的身体猛地弓起，僵硬不动。" voices=""/><msg @l="3519" char_id="-1" frame_id="-1" name=""   text="……她比两个人都先达到了高潮。" voices=""/><msg @l="3521" char_id="-1" frame_id="-1" name="男员工A"   text="『哦，哦哦哦，夹紧了！』" voices=""/><msg @l="3523" char_id="-1" frame_id="-1" name="大黑"   text="『我要射在您那美丽的脸上！！玲小姐！！』" voices=""/><flash @l="3527" count="4" fade="100" image="white"/><wait_chgmv/><ev @l="3531" src="ev-052x1y2y4z1z4z2z5"/><msg @l="3533" char_id="1" frame_id="-1" name="玲" text="『嗯嗯……。』"   voices="rei02500"/><msg @l="3535" char_id="-1" frame_id="-1" name=""   text="沐浴在两人射出的白浊粘液中，玲沉浸在高潮余韵中，吐出灼热的喘息。" voices=""/><msg @l="3537" char_id="-1" frame_id="-1" name="大黑"   text="『呼，一想到是玲小姐，情绪就高涨起来，稍微射得有点多了呢。』" voices=""/><msg @l="3539" char_id="-1" frame_id="-1" name=""   text="享受了极乐的射精后，大黑浑身颤抖着，看着被欲液玷污、红润柔软肌肤的玲的脸，满足地说道。"   voices=""/><msg @l="3540" char_id="-1" frame_id="-1" name=""   text="玲并没有回应他的话……只是反复急促地喘息着。" voices=""/><msg @l="3542" char_id="-1" frame_id="-1" name="男员工A"   text="『啊，啊啊……全部……射出来了。』" voices=""/><msg @l="3544" char_id="-1" frame_id="-1" name=""   text="男人保持着腰部紧贴，仿佛要顶到玲子宫深处的姿势，发出了同样可怜的声音。他将浓稠的白浊液体射向了她的子宫内部。"   voices=""/><msg @l="3545" char_id="-1" frame_id="-1" name=""   text="高潮过后兴奋褪去，大概是罪恶感开始涌上心头了吧。" voices=""/><msg @l="3547" char_id="-1" frame_id="-1" name="真岛"   text="『别担心，反正大家都内射了。就算这家伙怀孕了，你也不用担心会被追究责任。』" voices=""/><msg @l="3549" char_id="-1" frame_id="-1" name="男员工A"   text="『是，是这样啊……太好了……。』" voices=""/><msg @l="3551" char_id="-1" frame_id="-1" name="真岛" text="『这种事根本无所谓。』"   voices=""/><msg @l="3553" char_id="-1" frame_id="-1" name="真岛"   text="『比起这个，你别老是把软掉的鸡巴插在里面不拔出来，赶紧跟后面的家伙换位置。』" voices=""/><msg @l="3555" char_id="-1" frame_id="-1" name="男员工A" text="『是、是的！』"   voices=""/><stopbgm @l="3559" fadeout="1000"/><clear @l="3563" class="char"/><clear @l="3565" class="ev"/><wait_chgmv/><bg @l="3569" src="bg17b"/><msg @l="3571" char_id="-1" frame_id="-1" name="男员工A" text="『打、打扰了！』"   voices=""/><msg @l="3573" char_id="-1" frame_id="-1" name=""   text="侵犯着玲私处的男性员工只说了这么一句，就像逃跑一样离开了人才派遣部的办公室。" voices=""/><char @l="3577" id="ookur" pos="auto" src="ookuro010"/><bgm @l="3581" src="bgm09" volume="1."/><msg @l="3583" char_id="-1" frame_id="-1" name="大黑"   text="『真岛君，不应该太过欺负其他部门的人啊。』" voices=""/><msg @l="3585" char_id="-1" frame_id="-1" name="真岛"   text="『看到那种家伙就让我火大……。』" voices=""/><msg @l="3587" char_id="-1" frame_id="-1" name="大黑"   text="『哈哈，你还是老样子那么可怕啊。』" voices=""/><msg @l="3589" char_id="-1" frame_id="-1" name=""   text="大黑像往常一样笑着回应真岛的话。" voices=""/><msg @l="3591" char_id="-1" frame_id="-1" name="真岛"   text="『你们，别给她休息的机会，猛烈地侵犯她。』" voices=""/><msg @l="3593" char_id="-1" frame_id="-1" name="真岛"   text="『直到硬不起来为止，彻底地搞她。』" voices=""/><msg @l="3595" char_id="-1" frame_id="-1" name="男员工D" text="『遵命！』"   voices=""/><msg @l="3597" char_id="-1" frame_id="-1" name="男员工E"   text="『请交给我们吧，真岛先生。』" voices=""/><msg @l="3599" char_id="-1" frame_id="-1" name=""   text="在接到真岛的指示后，因为大黑的突然加入而暂时中断的轮奸行为又重新开始了。" voices=""/><msg @l="3601" char_id="-1" frame_id="-1" name="大黑" text="『不愧是各位，真是厉害啊。』"   voices=""/><msg @l="3603" char_id="-1" frame_id="-1" name="真岛"   text="『这可是他们唯一的生存意义啊。』" voices=""/><msg @l="3605" char_id="-1" frame_id="-1" name="真岛"   text="『话说回来，大黑先生您怎么办呢。如果要一直陪伴到早上的话……。』" voices=""/><msg @l="3607" char_id="-1" frame_id="-1" name="大黑"   text="『哈哈，在出丑之前，我先告辞了。』" voices=""/><msg @l="3609" char_id="-1" frame_id="-1" name="大黑"   text="『如果我认真起来会怎样，你也知道的吧？』" voices=""/><msg @l="3610" char_id="-1" frame_id="-1" name="真岛"   text="『是啊。如果大黑先生认真起来，这家伙就会被彻底毁掉的。』" voices=""/><msg @l="3612" char_id="-1" frame_id="-1" name="大黑"   text="『那也不是我所期望的，所以今天就先告辞了。』" voices=""/><msg @l="3614" char_id="-1" frame_id="-1" name="真岛"   text="『是吗。有兴致的话随时过来看看情况。』" voices=""/><msg @l="3616" char_id="-1" frame_id="-1" name="真岛"   text="『我会让你亲身体验调教的成果。』" voices=""/><msg @l="3618" char_id="-1" frame_id="-1" name="大黑"   text="『是啊。我很期待。请把我的玲小姐，变成一个纯粹的雌性吧。』" voices=""/><clear @l="3622" class="char"/><msg @l="3624" char_id="-1" frame_id="-1" name=""   text="大黑轻轻举起一只手，悠然地离开了人才派遣部的办公室。" voices=""/><msg @l="3625" char_id="-1" frame_id="-1" name=""   text="真岛看着离去的大黑的背影，嘴角上扬，用谁也听不到的微弱声音喃喃道：“大黑先生…你果然很可怕啊。”"   voices=""/><stopbgm @l="3629" fadeout="1000"/><clear @l="3635" class="all"/><msgshow @l="3637" show="true"/><wait_chgmv/><bg @l="3641" src="bg17b"/><msg @l="3643" char_id="-1" frame_id="-1" name="" text="不知过了多长时间。"   voices=""/><msg @l="3644" char_id="-1" frame_id="-1" name=""   text="人才派遣部办公室的灯依然亮着。" voices=""/><msg @l="3645" char_id="-1" frame_id="-1" name=""   text="不…他们的“工作”绝不可能在“夜晚”结束。" voices=""/><msg @l="3646" char_id="-1" frame_id="-1" name=""   text="一旦开始了“新人培训”，在朝阳升起之前是不会结束的。" voices=""/><wait_chgmv/><ev @l="3650" src="ev-052x2y1y3z1z4z2z5"/><bgm @l="3654" src="bgm14" volume="1."/><msg @l="3656" char_id="1" frame_id="-1" name="玲"   text="『嗯啊…啊…啊…啊……。』" voices="rei02510"/><msg @l="3658" char_id="-1" frame_id="-1" name=""   text="玲脸上浮现出浓重的疲惫表情，虚弱地喘息着。" voices=""/><msg @l="3659" char_id="-1" frame_id="-1" name=""   text="她的意识已经模糊不清，双眼毫无生气。" voices=""/><msg @l="3660" char_id="-1" frame_id="-1" name="" text="不知道已经达到高潮多少次了。"   voices=""/><msg @l="3661" char_id="-1" frame_id="-1" name="" text="不知道子宫里已经被灌注了多少次精液。"   voices=""/><msg @l="3662" char_id="-1" frame_id="-1" name=""   text="从子宫和口腔溢出的精液，又与新注入的精液混在一起。" voices=""/><msg @l="3663" char_id="-1" frame_id="-1" name=""   text="从每一寸粘膜，她都被迫吸收着男人们释放的那股青涩气味的东西。" voices=""/><msg @l="3664" char_id="-1" frame_id="-1" name=""   text="每达到一次高潮，每被注入一次精液……她都确实地“坠落”得更深——。" voices=""/><msg @l="3666" char_id="-1" frame_id="-1" name="男员工D" text="『要射了！』"   voices=""/><msg @l="3668" char_id="-1" frame_id="-1" name="男员工E" text="『我也…要、出来了！！』"   voices=""/><msg @l="3670" char_id="1" frame_id="-1" name="玲" text="『嗯，啊啊啊！！』"   voices="rei02520"/><flash @l="3674" count="4" fade="100" image="white"/><wait_chgmv/><ev @l="3678" src="ev-052x2y1y3z1z4z2z5z3z6"/><msg @l="3680" char_id="-1" frame_id="-1" name=""   text="随着男人们的高潮，玲也违背自己的意志，感受到一种冲击顶穿头顶的感觉，双腿痉挛着攀上了高潮。"   voices=""/><msg @l="3681" char_id="-1" frame_id="-1" name=""   text="从秘门中大量的欲液缓缓溢出，乳头和阴蒂疼痛般地硬挺勃起。" voices=""/><msg @l="3682" char_id="-1" frame_id="-1" name=""   text="一种无法凭借自己意志控制的疼痛感，不断地在玲的身体中游走。" voices=""/><msg @l="3683" char_id="-1" frame_id="-1" name=""   text="唤醒了她内心深处的性欲望，仿佛将身体交付给了恶魔一般。" voices=""/><msg @l="3685" char_id="1" frame_id="-1" name="玲"   text="『哈……哈……哈………嗯，啊………。』" voices="rei02530"/><msg @l="3687" char_id="-1" frame_id="-1" name="" text="已经无法停止了……。"   voices=""/><msg @l="3688" char_id="-1" frame_id="-1" name=""   text="那里只存在着肉体交合所产生的淫靡肉欲。" voices=""/><msg @l="3689" char_id="-1" frame_id="-1" name=""   text="在朦胧的意识中，玲因绝望和肉欲而身体颤抖。" voices=""/><msg @l="3691" char_id="-1" frame_id="-1" name="真岛" text="『好——了，下一个。』"   voices=""/><msg @l="3693" char_id="-1" frame_id="-1" name="" text="深夜的办公室里回荡着无情的声音。"   voices=""/><msg @l="3694" char_id="-1" frame_id="-1" name=""   text="不知第几次有男根插入了玲的秘口。" voices=""/><msg @l="3695" char_id="-1" frame_id="-1" name=""   text="狂欢的盛宴才刚刚开始。" voices=""/><stopbgm @l="3699" fadeout="1000"/><clear @l="3705" class="all"/><end_scene @l="3708"/><call @l="3712" target="EventLabel_142@root_rei05a"/><return @l="3713" value="0&#13;&#10;"/><label @l="3717" id="EventLabel_141"/><msg @l="3719" char_id="0" frame_id="1" name="美帆" text="『……。』" voices=""/><msg @l="3721" char_id="-1" frame_id="-1" name="" text="发不出声音。" voices=""/><msg @l="3722" char_id="-1" frame_id="-1" name=""   text="按理说，我应该不顾一切地拦住她，问清楚玲身上到底发生了什么事。" voices=""/><msg @l="3723" char_id="-1" frame_id="-1" name="" text="但是……我做不到。"   voices=""/><msg @l="3724" char_id="-1" frame_id="-1" name=""   text="我已经竭尽全力承受自己身上的灾难———。" voices=""/><msg @l="3725" char_id="-1" frame_id="-1" name=""   text="任凭泪水不由自主地流淌，我只能沉默地目送朽木教授离去的背影……什么也做不了。" voices=""/><stopbgm @l="3729" fadeout="1000"/><clear @l="3735" class="all"/><msgshow @l="3738" show="false"/><call @l="3742" target="EventLabel_143@root_rei05b"/><return @l="3743" value="0&#13;&#10;"/><return @l="3747" value=""/></code></xscript>																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																							