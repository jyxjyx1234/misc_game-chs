<?xml version="1.0" encoding="utf-8"?><xscript><debug editor="&quot;C:\Program&#32;Files&#32;(x86)\sakura\sakura.exe&quot;&#32;&quot;%src%&quot;&#32;-Y=%line%"   src="D:\シロップ\町ぐるみの罠＋汚された夏セット版\汚された夏\完成データ\汚された夏\script\text\root_inaba_c_ev01.txt"/><code><label @l="13" id="EventLabel_98"/><label @l="16" id="event_scene44"/><wait_chgmv/><bg @l="19" src="bg14a"/><bgm @l="23" src="bgm14" volume="1."/><msg @l="25" char_id="-1" frame_id="-1" name=""   text="回过神来，我已经被按倒在社团活动室的地板上。稻庭学长压在我身上，我穿着的衣服从胸口处被撕裂，变得像废纸一样。"   voices=""/><msg @l="27" char_id="-1" frame_id="-1" name="稻庭"   text="『啊哈哈哈，太棒了仲根同学！这么有吸引力的肌肤可不是普通处女能体验到的哦！』" voices=""/><msg @l="29" char_id="-1" frame_id="-1" name=""   text="稻庭学长发出一阵疯狂的声音，像是要吞噬我的身体一样四处游走着他的手。" voices=""/><msg @l="30" char_id="-1" frame_id="-1" name=""   text="那种蛮横的行为，丝毫感受不到爱情或快乐……只有痛苦。" voices=""/><msg @l="32" char_id="0" frame_id="-1" name="美帆"   text="『稻庭学长，请您清醒一点啊…！』" voices="miho04800"/><msg @l="34" char_id="-1" frame_id="-1" name="稻庭" text="『太棒了！真是太棒了！』"   voices=""/><msg @l="36" char_id="0" frame_id="-1" name="美帆"   text="『不要，学长……请您清醒过来，学长！！』" voices="miho04810"/><msg @l="38" char_id="-1" frame_id="-1" name="稻庭" text="『呼…呼……呼…。』"   voices=""/><msg @l="40" char_id="-1" frame_id="-1" name=""   text="稻庭学长仿佛完全没有注意到我的呼唤，一边粗重地喘息着一边揉捏着我的胸部。" voices=""/><msg @l="42" char_id="0" frame_id="-1" name="美帆" text="『稻庭学长…。』"   voices="miho04820"/><msg @l="44" char_id="-1" frame_id="-1" name=""   text="为什么我必须遭受这种对待……。" voices=""/><msg @l="45" char_id="-1" frame_id="-1" name="" text="这么想着……眼泪不自觉地涌了出来。"   voices=""/><goto @l="48" cond="!(f.稲庭ルート即席flag&#32;==&#32;1)&#13;&#10;"   label="TempLabel_299"/><msg @l="50" char_id="-1" frame_id="-1" name=""   text="在房间角落里，玲学姐被捆绑着滚倒在地，一直在哭泣。" voices=""/><msg @l="51" char_id="-1" frame_id="-1" name=""   text="她的目光所及之处是稻庭学长，她专注地盯着他的方向。" voices=""/><msg @l="53" char_id="-1" frame_id="-1" name="稻庭"   text="『乳头也是漂亮的粉色！啊哈哈哈！』" voices=""/><msg @l="55" char_id="-1" frame_id="-1" name=""   text="然而……不管玲学姐怎么看着学长，他都没有表现出任何兴趣。" voices=""/><msg @l="56" char_id="-1" frame_id="-1" name=""   text="他只是兴高采烈地揉捏着美帆的胸部，一边对着那突起的尖端流着口水，一边贪婪地吮吸着。" voices=""/><msg @l="58" char_id="-1" frame_id="-1" name=""   text="学长的舌头不断挑逗着我的乳头，见它变得更加挺立后似乎满意了，进一步压迫揉搓着乳尖。" voices=""/><msg @l="60" char_id="-1" frame_id="-1" name="稻庭" text="『好吃，真好吃！』"   voices=""/><msg @l="62" char_id="0" frame_id="-1" name="美帆"   text="『不，不要……啊……嗯嗯！！』" voices="miho10270"/><msg @l="64" char_id="-1" frame_id="-1" name="" text="学长轻咬着乳首，不断玩弄。"   voices=""/><msg @l="65" char_id="-1" frame_id="-1" name=""   text="充分品尝了那触感后，又将舌头滑向更重要的私密处。" voices=""/><msg @l="67" char_id="-1" frame_id="-1" name="稻庭" text="『啊哈哈哈！小穴也是粉色的！』"   voices=""/><msg @l="69" char_id="-1" frame_id="-1" name=""   text="对于第一次被男人看到私处的我来说，这是无法忍受的羞辱。尽管我在喉咙深处呻吟着扭动身体，但学长并没有饶恕我。"   voices=""/><msg @l="70" char_id="-1" frame_id="-1" name=""   text="学长的舌头直接刺激着最敏感的阴蒂。" voices=""/><msg @l="72" char_id="0" frame_id="-1" name="美帆" text="『不，啊啊啊啊啊！』"   voices="miho10240"/><msg @l="74" char_id="-1" frame_id="-1" name=""   text="将脸贴在我私处的学长沉浸在恍惚感中，吸入着那隐秘的香气。" voices=""/><msg @l="75" char_id="-1" frame_id="-1" name=""   text="淫欲的香气刺激着他的鼻腔，沉浸在这官能中的学长脸上流露出近乎疯狂的神情。" voices=""/><msg @l="77" char_id="-1" frame_id="-1" name="稻庭"   text="『处女小穴的香气！果然处女就是不一样。啊哈哈哈！』" voices=""/><msg @l="79" char_id="-1" frame_id="-1" name=""   text="如同嗅闻猎物气味的野兽，学长不断发出嗅探的声音。" voices=""/><label @l="82" id="TempLabel_299"/><msg @l="85" char_id="-1" frame_id="-1" name="稻庭"   text="『来吧，按照约定，我要用我的东西捅破你的处女膜！』" voices=""/><msg @l="87" char_id="0" frame_id="-1" name="美帆" text="『啊……。』"   voices="miho04840"/><msg @l="89" char_id="-1" frame_id="-1" name="稻庭" text="『呵，哈哈！这样你就是我的东西了！』"   voices=""/><msg @l="91" char_id="-1" frame_id="-1" name=""   text="稻庭学长像被热浪侵袭般叫喊着，将那又大又硬的挺立之物抵在我的私处。" voices=""/><msg @l="92" char_id="-1" frame_id="-1" name=""   text="我的内裤已经……被彻底撕碎扔在一旁。" voices=""/><clear @l="94" class="char"/><char @l="96" id="miho" pos="center" src="miho055f" y="-80"/><msg @l="98" char_id="0" frame_id="-1" name="美帆"   text="『不要，学长……那个至少……。』" voices="miho04850"/><msg @l="100" char_id="-1" frame_id="-1" name="" text="就在我希望他能温柔一点的那一刹那———。"   voices=""/><msg @l="101" char_id="-1" frame_id="-1" name=""   text="他炽热的肉茎一下子刺入了我的体内。" voices=""/><wait_chgmv/><ev @l="105" src="ev-044"/><description @l="108" text="处女丧失"/><msg @l="110" char_id="0" frame_id="-1" name="美帆" text="『啊啊————。』"   voices="miho04860"/><msg @l="112" char_id="-1" frame_id="-1" name=""   text="学长的东西贯穿了处女膜的瞬间……我屏住了呼吸。" voices=""/><msg @l="113" char_id="-1" frame_id="-1" name="" text="然后……剧痛。" voices=""/><msg @l="115" char_id="0" frame_id="-1" name="美帆" text="『啊、啊啊啊啊啊啊啊啊啊！！！』"   voices="miho04870"/><msg @l="117" char_id="-1" frame_id="-1" name=""   text="仿佛身体被完全撕裂成两半的剧痛，席卷了我的全身。有种啪啪地什么东西被撕裂的感觉，一种钝重的、好像身体被钉入木桩般的疼痛贯穿了我的全身。"   voices=""/><msg @l="119" char_id="-1" frame_id="-1" name="稻庭"   text="『哈、哈哈哈哈……进去了！仲根同学的处女小穴里现在，插入了我的东西！』" voices=""/><msg @l="121" char_id="-1" frame_id="-1" name=""   text="用自己的肉块夺走了我第一次的学长，正肆无忌惮地在我的阴道内搅动着。" voices=""/><msg @l="122" char_id="-1" frame_id="-1" name=""   text="从结合处滴落的血丝，在地板上形成了黑色的污渍。" voices=""/><msg @l="124" char_id="0" frame_id="-1" name="美帆"   text="『我、啊啊……啊……啊………唔啊！！』" voices="miho04880"/><msg @l="126" char_id="-1" frame_id="-1" name=""   text="每当阴茎猛烈撞击蜜壶时，我都会感到几乎失去意识的剧痛，扭曲着表情。" voices=""/><msg @l="127" char_id="-1" frame_id="-1" name=""   text="我的那里几乎没有湿润……只有破瓜的血作为唯一的润滑油，接纳了学长硬挺的肉棒。"   voices=""/><msg @l="129" char_id="0" frame_id="-1" name="美帆"   text="『呃……疼……啊、唔呃………嗯嗯………。』" voices="miho07090"/><msg @l="131" char_id="-1" frame_id="-1" name=""   text="在蜜壶中，学长膨胀起来的欲望开始蠕动。" voices=""/><msg @l="132" char_id="-1" frame_id="-1" name=""   text="肉棒拖拽着肉壁，侵入秘穴的巨大野兽在我的阴道内肆意摩擦。" voices=""/><msg @l="133" char_id="-1" frame_id="-1" name=""   text="那里没有丝毫的愉悦……只有窒息感和尖锐的疼痛。" voices=""/><msg @l="135" char_id="-1" frame_id="-1" name="稻庭"   text="『呼，哈呼…………哈、哈哈…………我的、我的………。』" voices=""/><msg @l="137" char_id="-1" frame_id="-1" name=""   text="稻庭学长邪恶地扭曲着脸，像着了魔一样执拗地顶弄着我。" voices=""/><msg @l="138" char_id="-1" frame_id="-1" name=""   text="每一下我的身体都像木偶一样咯吱咯吱地摇晃………发出嘎吱声。" voices=""/><msg @l="140" char_id="0" frame_id="-1" name="美帆"   text="『我、啊啊……啊……啊………唔啊！！』" voices="miho04880"/><msg @l="142" char_id="-1" frame_id="-1" name="" text="疼痛……已经不足以形容。"   voices=""/><msg @l="143" char_id="-1" frame_id="-1" name=""   text="阴道被强行撕裂的触感和灼热的剧痛，是无法用其他任何事物来比喻的。" voices=""/><msg @l="145" char_id="0" frame_id="-1" name="美帆"   text="（为什么会变成……这样子呢）" voices="miho04890"/><msg @l="147" char_id="-1" frame_id="-1" name=""   text="想到这种痛苦还要持续两倍以上，我的意识几乎要远去，在这种状况下，我却在想着别的事情。" voices=""/><msg @l="149" char_id="0" frame_id="-1" name="美帆"   text="（是因为我……我什么都做不到吗？）" voices="miho04900"/><msg @l="151" char_id="0" frame_id="-1" name="美帆" text="（我……是……）"   voices="miho04910"/><msg @l="153" char_id="-1" frame_id="-1" name=""   text="快要在痛苦中失去的意识，又被下一波痛楚唤醒。" voices=""/><msg @l="154" char_id="-1" frame_id="-1" name=""   text="在这种绝望的循环中被侵犯着身体，我只能任其摆布。" voices=""/><msg @l="156" char_id="-1" frame_id="-1" name="稻庭"   text="『咕、哈………要、去了…………要去了，要去了要去了要去了。』" voices=""/><msg @l="158" char_id="0" frame_id="-1" name="美帆"   text="『啊、啊啊……啊、唔呃、啊、啊、啊、啊！！！』" voices="miho04920"/><msg @l="160" char_id="-1" frame_id="-1" name=""   text="稻庭的动作变得更快。学长那热且硬的东西小幅度地痉挛了2、3下。" voices=""/><msg @l="162" char_id="-1" frame_id="-1" name="稻庭" text="『哦、哦哦哦哦哦哦！！』"   voices=""/><flash @l="166" count="4" fade="100" image="white"/><wait_chgmv/><ev @l="170" src="ev-044x1z1"/><msg @l="172" char_id="0" frame_id="-1" name="美帆" text="『呜啊！！？』"   voices="miho04930"/><msg @l="174" char_id="-1" frame_id="-1" name=""   text="学长的腰部剧烈颤抖，一股炙热的液体注入了我的体内。" voices=""/><msg @l="175" char_id="-1" frame_id="-1" name=""   text="那液体转眼间就充满了我的子宫和阴道，仍然装不下的部分从私处咕噜咕噜地逆流而出。然后，更加猛烈地溢出体外。如此大量的精液侵占了我的全身，简直难以想象这是人类能够释放的量。"   voices=""/><msg @l="177" char_id="-1" frame_id="-1" name="稻庭" text="『哦哦………哦哦哦哦哦哦！！』"   voices=""/><msg @l="179" char_id="-1" frame_id="-1" name=""   text="一次又一次……学长一边向我的秘缝释放着灼热的液体，一边嚎叫着。" voices=""/><msg @l="180" char_id="-1" frame_id="-1" name=""   text="他的眼睛中已经完全感觉不到人类的理性。" voices=""/><msg @l="181" char_id="-1" frame_id="-1" name=""   text="那副模样简直就像是一头被欲望驱使的野兽。" voices=""/><msg @l="183" char_id="0" frame_id="-1" name="美帆"   text="『啊、啊啊……啊………。』" voices="miho04940"/><msg @l="185" char_id="-1" frame_id="-1" name=""   text="随着充满阴道的灼热液体，我的身体不断颤抖，我感觉到自己一直勉强维持的意识正慢慢地坠入黑暗之中。"   voices=""/><msg @l="186" char_id="-1" frame_id="-1" name=""   text="就这样，在沉入黑暗的意识中………我……感受到了绝望。" voices=""/><clear @l="192" class="all"/><wait @l="194" time="1000"/><end_scene @l="197"/><goto @l="200" cond="!(f.稲庭ルート即席flag&#32;==&#32;1)&#13;&#10;"   label="TempLabel_300"/><call @l="204" target="EventLabel_49@ending11"/><return @l="205" value="0&#13;&#10;"/><goto @l="207" label="TempLabel_303"/><label @l="208" id="TempLabel_300"/><return @l="213" value=""/><label @l="215" id="TempLabel_303"/><return @l="220" value=""/></code></xscript>																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																								