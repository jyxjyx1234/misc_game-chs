<?xml version="1.0" encoding="utf-8"?><xscript><debug editor="&quot;C:\Program&#32;Files&#32;(x86)\sakura\sakura.exe&quot;&#32;&quot;%src%&quot;&#32;-Y=%line%"   src="D:\シロップ\町ぐるみの罠＋汚された夏セット版\汚された夏\完成データ\汚された夏\script\text\root_inaba02.txt"/><code><label @l="12" id="EventLabel_91"/><description @l="15" text="网球俱乐部入会·第3天"/><eval @l="17" expr="f.numDay=9&#13;&#10;"/><msgshow @l="19" show="false"/><wait_chgmv/><bg @l="21" src="day09" time="2000"/><wait @l="23" time="500"/><wait_chgmv/><bg @l="25" src="black" time="2000"/><msgshow @l="27" show="true"/><wait_chgmv/><bg @l="30" src="bg03"/><bgm @l="32" src="bgm02" volume="1."/><char @l="34" id="miho" pos="left" src="miho030"/><char @l="36" id="rei" pos="right" src="rei035"/><msg @l="38" char_id="1" frame_id="-1" name="玲" text="『早啊……』" voices=""/><char @l="41" id="miho" pos="left" src="miho031"/><msg @l="43" char_id="0" frame_id="-1" name="美帆" text="『啊，早上好。』"   voices=""/><msg @l="45" char_id="-1" frame_id="-1" name=""   text="对着揉着惺忪睡眼从房间里出来的玲小姐，我从厨房里回应了比平时更早的早安问候。" voices=""/><char @l="48" id="miho" pos="left" src="miho030"/><msg @l="50" char_id="0" frame_id="-1" name="美帆" text="『今天这么早啊？』"   voices=""/><msg @l="52" char_id="1" frame_id="-1" name="玲"   text="『昨天啊……我们教授突然打电话过来。』" voices=""/><msg @l="54" char_id="0" frame_id="-1" name="美帆" text="『是那之后吗？』" voices=""/><msg @l="56" char_id="1" frame_id="-1" name="玲"   text="『在这么忙的时候，教授说让我去帮忙，所以得早点出门。』" voices=""/><msg @l="58" char_id="1" frame_id="-1" name="玲"   text="『真是的……希望他能考虑一下我正在找工作啊。』" voices=""/><char @l="61" id="miho" pos="left" src="miho036"/><msg @l="63" char_id="0" frame_id="-1" name="美帆" text="『那真是辛苦了。』"   voices=""/><msg @l="65" char_id="1" frame_id="-1" name="玲" text="『真是的……』" voices=""/><clear @l="68" layer="rei"/><msg @l="70" char_id="-1" frame_id="-1" name="" text="玲小姐无精打采地坐在沙发上。"   voices=""/><msg @l="71" char_id="-1" frame_id="-1" name=""   text="她伸手拿起电视遥控器……打开了电源。" voices=""/><msg @l="72" char_id="-1" frame_id="-1" name=""   text="电视屏幕上正播放着清晨时段的“晨间电视”节目。" voices=""/><char @l="75" id="miho" pos="left" src="miho130"/><msg @l="77" char_id="0" frame_id="-1" name="美帆"   text="『给，提神用的咖啡。可能有点浓。』" voices=""/><char @l="80" id="rei" pos="right" src="rei031"/><msg @l="82" char_id="1" frame_id="-1" name="玲" text="『谢谢。』" voices=""/><msg @l="84" char_id="-1" frame_id="-1" name=""   text="玲小姐带着迷糊的笑容，将冒着热气的咖啡送到嘴边喝了一口。" voices=""/><char @l="87" id="rei" pos="right" src="rei030"/><msg @l="89" char_id="1" frame_id="-1" name="玲"   text="『嗯——这个味道，对驱散睡意的头脑很有效呢。』" voices=""/><char @l="92" id="miho" pos="left" src="miho131"/><msg @l="94" char_id="0" frame_id="-1" name="美帆" text="『呵呵，那就好。』"   voices=""/><clear @l="97" class="char"/><char @l="99" id="rei" pos="auto" src="rei030"/><msg @l="101" char_id="0" frame_id="-1" name="美帆"   text="『啊，说起来……玲小姐，今天去不了吗？』" voices=""/><msg @l="103" char_id="-1" frame_id="-1" name=""   text="我回到厨房，一边搅拌着玉米汤的锅一边说道。" voices=""/><char @l="106" id="rei" pos="auto" src="rei034"/><msg @l="108" char_id="1" frame_id="-1" name="玲" text="『今天？有什么事吗？』"   voices=""/><msg @l="110" char_id="0" frame_id="-1" name="美帆"   text="『您不知道吗？网球社要举办新生欢迎会的事。』" voices=""/><msg @l="112" char_id="1" frame_id="-1" name="玲" text="『啊？我没听说过这种事啊。』"   voices=""/><msg @l="114" char_id="0" frame_id="-1" name="美帆" text="『是这样吗？』"   voices=""/><char @l="117" id="rei" pos="auto" src="rei030"/><msg @l="119" char_id="1" frame_id="-1" name="玲"   text="『唔～最近因为就职活动太紧张了，可能没听到吧。』" voices=""/><msg @l="121" char_id="1" frame_id="-1" name="玲" text="『那么，你打算去吗？』"   voices=""/><msg @l="123" char_id="0" frame_id="-1" name="美帆"   text="『是的。难得为我们举办新生欢迎会，作为新部员的我如果不参加的话会很失礼的吧？……』" voices=""/><msg @l="125" char_id="1" frame_id="-1" name="玲"   text="『说什么呢，其实你是冲着稻庭先生去的吧。』" voices=""/><msg @l="127" char_id="0" frame_id="-1" name="美帆"   text="『才、才才才、才不是那样的！』" voices=""/><char @l="130" id="rei" pos="auto" src="rei031"/><msg @l="132" char_id="1" frame_id="-1" name="玲"   text="『好好，谢谢你这么明显的反应。』" voices=""/><msg @l="134" char_id="0" frame_id="-1" name="美帆" text="『呜～……。』" voices=""/><msg @l="136" char_id="1" frame_id="-1" name="玲"   text="『那么，为了不输给你这个情敌，我也得去那个欢迎会露个脸才行啊。』" voices=""/><char @l="139" id="rei" pos="auto" src="rei030"/><msg @l="141" char_id="1" frame_id="-1" name="玲"   text="『啊，不过我可能会迟到，所以在我到之前别对稻庭先生出手哦。』" voices=""/><clear @l="144" class="char"/><char @l="146" id="miho" pos="auto" src="miho136"/><msg @l="148" char_id="0" frame_id="-1" name="美帆" text="『玲姐……』" voices=""/><msg @l="150" char_id="-1" frame_id="-1" name=""   text="玲姐的视线一直盯着电视屏幕上播放的新闻节目，说出这话时……大概是带着寂寞的笑容。" voices=""/><stopbgm @l="153" fadeout="1000"/><clear @l="156" class="all"/><msgshow @l="158" show="true"/><wait_chgmv/><bg @l="161" src="bg13m1"/><bgm @l="164" src="bgm06" volume="1."/><char @l="167" id="inaba" pos="auto" src="inaba050"/><msg @l="169" char_id="-1" frame_id="-1" name="稻庭"   text="『那么，现在开始举行新生欢迎网球大赛。』" voices=""/><msg @l="171" char_id="-1" frame_id="-1" name="" text="下午两点刚过的时候……"   voices=""/><msg @l="172" char_id="-1" frame_id="-1" name="" text="网球场上回荡着声音。"   voices=""/><msg @l="173" char_id="-1" frame_id="-1" name=""   text="在轻松的午餐会兼宾果游戏中增进了部员之间的亲睦后，终于到了今天的主要活动——网球大赛开始的时刻。"   voices=""/><msg @l="174" char_id="-1" frame_id="-1" name=""   text="作为主持人的稻庭学长周围站着包括我在内的所有新入会成员，他们身后整齐排列着前辈会员们。" voices=""/><msg @l="175" char_id="-1" frame_id="-1" name=""   text="不过，在前辈会员中没有看到玲姐的身影。" voices=""/><msg @l="177" char_id="0" frame_id="1" name="美帆" text="（她说过会迟到的）"   voices=""/><msg @l="179" char_id="-1" frame_id="-1" name=""   text="发现自己竟有些松了口气，这让我感到有点不舒服。" voices=""/><msg @l="181" char_id="-1" frame_id="-1" name="稻庭"   text="『这次参加的新生总共有三十六人，所以我们将分成两个场地分别进行比赛。』" voices=""/><msg @l="183" char_id="-1" frame_id="-1" name="稻庭"   text="『这是为了增进亲睦关系的比赛，所以请大家不要太紧张，尽情享受。』" voices=""/><msg @l="185" char_id="-1" frame_id="-1" name=""   text="在稻庭学长的指示下，前辈部员们将写有对战对手和比赛地点的表格一一递给新生们。" voices=""/><msg @l="186" char_id="-1" frame_id="-1" name=""   text="接过后确认内容……我的比赛似乎将在第二会场进行。" voices=""/><clear @l="188" class="char"/><msg @l="190" char_id="-1" frame_id="-1" name="女会员A"   text="『我来带路。来吧，我们走。』" voices=""/><msg @l="192" char_id="-1" frame_id="-1" name=""   text="在午餐会上熟络起来的女前辈们带领下，我向第二会场走去。" voices=""/><msg @l="193" char_id="-1" frame_id="-1" name=""   text="走路时，我难得地与几乎是初次见面的人聊得热火朝天。" voices=""/><clear @l="196" class="all"/><char @l="199" id="miho" pos="auto" src="miho051"/><msg @l="201" char_id="0" frame_id="1" name="美帆"   text="『稻庭学长果然很厉害呢。大学社团的宾果大会竟然能有那么多赞助商。』" voices=""/><msg @l="203" char_id="-1" frame_id="-1" name="女会员B"   text="『是啊，你那个包不就是维顿的新款吗？就连东京市区的专卖店里都还几乎没有进货呢。』" voices=""/><msg @l="205" char_id="0" frame_id="1" name="美帆" text="『啊，你知道啊？』" voices=""/><clear @l="208" class="char"/><msg @l="210" char_id="-1" frame_id="-1" name=""   text="午餐会上有电视上见过的一流厨师大展身手，宾果大会则有以大黑集团为首的大企业提供奖品。"   voices=""/><msg @l="211" char_id="-1" frame_id="-1" name=""   text="也许是因为抽中了名牌包的缘故吧，在这个我平生第一次体验的华丽世界里，我完全飘飘然了。"   voices=""/><msg @l="213" char_id="-1" frame_id="-1" name="女会员C" text="『好了，到了哦。』"   voices=""/><wait_chgmv/><bg @l="216" src="bg13"/><char @l="219" id="miho" pos="auto" src="miho050"/><msg @l="221" char_id="-1" frame_id="-1" name=""   text="在前辈们的带领下，我踏入了作为网球部副场地的第二会场。" voices=""/><msg @l="222" char_id="-1" frame_id="-1" name=""   text="我立即按照纸上所写的地点开始准备，但就在这时我第一次注意到了一个奇怪的地方。" voices=""/><msg @l="223" char_id="-1" frame_id="-1" name=""   text="这里一个男生都没有。无论是前辈还是同级生。" voices=""/><msg @l="224" char_id="-1" frame_id="-1" name=""   text="就在这时，似乎是女子部队的领队……刚才还在一起聊天的那个人……来到了球场中央。"   voices=""/><msg @l="226" char_id="-1" frame_id="-1" name="女会员A"   text="『那么，现在开始网球部惯例的脱衣网球比赛。』" voices=""/><stopbgm @l="229" fadeout="1000"/><char @l="231" id="miho" pos="auto" src="miho054"/><msg @l="233" char_id="0" frame_id="1" name="美帆" text="『啊？』" voices=""/><msg @l="235" char_id="-1" frame_id="-1" name="" text="我一瞬间怀疑自己的耳朵。"   voices=""/><msg @l="236" char_id="-1" frame_id="-1" name=""   text="“脱衣网球”……她刚才是这么说的吗？" voices=""/><msg @l="238" char_id="-1" frame_id="-1" name="女会员A"   text="『顺便一提，胜利者可以参加由会长稻庭学长主办的二次聚会哦。』" voices=""/><bgm @l="241" src="bgm09" volume="1."/><msg @l="243" char_id="0" frame_id="1" name="美帆"   text="『不，不是这个问题，这到底是怎么回事？』" voices=""/><msg @l="245" char_id="-1" frame_id="-1" name="女会员A"   text="『你知道野球拳吧？就是那种猜拳输一次就脱一件衣服的游戏。这个是网球版的。』" voices=""/><msg @l="247" char_id="-1" frame_id="-1" name="女会员A"   text="『每被得一分就要脱掉外套、裙子、胸罩、内裤等衣物，被得4分，也就是1局，就算输了。另外，为了件数合适，不允许穿裙裤。』"   voices=""/><char @l="250" id="miho" pos="auto" src="miho056"/><msg @l="252" char_id="0" frame_id="1" name="美帆" text="『我不是这个意思……』"   voices=""/><msg @l="254" char_id="-1" frame_id="-1" name="女会员A"   text="『所以才把女生和男生分开。女孩子之间脱光了也不会觉得害羞吧？』" voices=""/><msg @l="256" char_id="0" frame_id="1" name="美帆" text="『但是，这里是户外啊。』"   voices=""/><msg @l="258" char_id="-1" frame_id="-1" name="女会员A"   text="『这里不仅远离周围，还是网球部专用场地，而且我们也派了部员把风，绝对没问题，对吧？』" voices=""/><msg @l="260" char_id="0" frame_id="1" name="美帆" text="『但是……』" voices=""/><msg @l="262" char_id="-1" frame_id="-1" name="女会员A"   text="『这可是在搬到这个校区之前就传承了十几年的部门传统活动。你打算因为一己之私破坏它吗？』"   voices=""/><msg @l="264" char_id="-1" frame_id="-1" name=""   text="听到她声音突然变得严厉，我猛然回过神来环顾四周，发现同级生们都已经做好随时开始比赛的准备，目不转睛地盯着我。"   voices=""/><msg @l="265" char_id="-1" frame_id="-1" name=""   text="刚才顺着闲聊的氛围不由自主地开口了，但冷静想想，现在变成了只有我一个人在唱反调的局面。"   voices=""/><msg @l="267" char_id="-1" frame_id="-1" name="同级生A" text="『你打算让我们等到什么时候？』"   voices=""/><msg @l="269" char_id="-1" frame_id="-1" name="同级生B"   text="『学姐都说没问题了。』" voices=""/><msg @l="271" char_id="-1" frame_id="-1" name="同级生C"   text="『都这个年纪了还害羞什么啊。』" voices=""/><msg @l="273" char_id="-1" frame_id="-1" name="同级生D"   text="『一个人故作矜持，真是害羞的家伙～』" voices=""/><msg @l="275" char_id="-1" frame_id="-1" name=""   text="那些最初和我一起表示担忧的孩子们，现在用可以清晰听见的窃窃私语渐渐地把我逼入绝境。" voices=""/><msg @l="276" char_id="-1" frame_id="-1" name=""   text="我确实没有坚强到在这种情况下不随波逐流而坚决拒绝的程度。" voices=""/><msg @l="277" char_id="-1" frame_id="-1" name=""   text="没关系，这是这么正规的社团在做的事，而且稻庭学长也已经批准了。" voices=""/><msg @l="278" char_id="-1" frame_id="-1" name="" text="没关系，只有女孩子在场，没关系……"   voices=""/><msg @l="279" char_id="-1" frame_id="-1" name=""   text="我在心里一遍又一遍地告诉自己没关系。" voices=""/><char @l="282" id="miho" pos="auto" src="miho055"/><stopbgm @l="285" fadeout="1000"/><msg @l="287" char_id="0" frame_id="1" name="美帆" text="『……我明白了。』"   voices=""/><bgm @l="290" src="bgm06" volume="1."/><msg @l="292" char_id="-1" frame_id="-1" name="女会员A"   text="『那么，我们开始吧。对战对手是根据大家的网球经历和训练内容决定的，所以实力差距应该不会太大，加油哦。』"   voices=""/><msg @l="294" char_id="-1" frame_id="-1" name="" text="我下定决心走向球场中央。"   voices=""/><msg @l="296" char_id="-1" frame_id="-1" name="女孩" text="『请多指教～』"   voices=""/><char @l="299" id="miho" pos="auto" src="miho056"/><msg @l="301" char_id="0" frame_id="1" name="美帆" text="『请、请多指教……』"   voices=""/><msg @l="303" char_id="-1" frame_id="-1" name=""   text="我的对手是新入部员中特别笨拙的女孩子。" voices=""/><msg @l="304" char_id="-1" frame_id="-1" name=""   text="抱歉，但这样的话，也许我也能应付……" voices=""/><stopbgm @l="307" fadeout="1000"/><clear @l="310" class="all"/><msg @l="312" char_id="-1" frame_id="-1" name="女会员B"   text="『高发球……你们两个人都还不行，所以双方都可以用低手发球哦？』" voices=""/><msg @l="314" char_id="0" frame_id="1" name="美帆" text="『是的……就这样吧。』"   voices=""/><msg @l="316" char_id="-1" frame_id="-1" name="女会员B"   text="『这次是一局定胜负，所以每得一分就交换发球权，采用变则规则。』" voices=""/><msg @l="318" char_id="-1" frame_id="-1" name="女会员B"   text="『那么，从铃木同学开始发球，比赛开始吧』" voices=""/><msg @l="320" char_id="-1" frame_id="-1" name="铃木" text="『好的。』" voices=""/><label @l="323" id="event_scene43"/><label @l="326" id="chart_line9"/><wait_chgmv/><ev @l="328" src="ev-043y1y2y3"/><description @l="330" text="脱衣网球对决"/><bgm @l="333" src="bgm14" volume="1."/><msg @l="335" char_id="-1" frame_id="-1" name=""   text="我握紧球拍，隔着网看着对面的女孩子……铃木同学。" voices=""/><msg @l="337" char_id="-1" frame_id="-1" name="铃木"   text="『呼啊……发球什么的我真的很不擅长啊。』" voices=""/><msg @l="339" char_id="0" frame_id="1" name="美帆" text="『……。』"   voices="miho05250"/><msg @l="341" char_id="-1" frame_id="-1" name=""   text="铃木同学比我小一圈，是个总是一副睡眼惺忪的女孩子。" voices=""/><msg @l="342" char_id="-1" frame_id="-1" name=""   text="和冲着稻庭学长而入部的新成员们一样，她似乎过着与球类运动完全无缘的生活。" voices=""/><msg @l="343" char_id="-1" frame_id="-1" name=""   text="我对球类运动也不太擅长，不过由于过去游泳锻炼过，在体力方面还是有些自信的。" voices=""/><msg @l="344" char_id="-1" frame_id="-1" name="" text="没问题……我能行。" voices=""/><msg @l="346" char_id="-1" frame_id="-1" name="女会员B"   text="『比赛开始时我会吹哨，大家听到哨声后就开始比赛。』" voices=""/><msg @l="348" char_id="-1" frame_id="-1" name="铃木" text="『知道啦。』"   voices=""/><msg @l="350" char_id="0" frame_id="1" name="美帆" text="『……。』"   voices="miho05260"/><msg @l="352" char_id="-1" frame_id="-1" name="" text="真想尽快结束这场比赛。"   voices=""/><msg @l="353" char_id="-1" frame_id="-1" name=""   text="只要直接赢下比赛就不用脱衣服了，还能和稻庭学长一起参加二次会……" voices=""/><msg @l="355" char_id="0" frame_id="1" name="美帆" text="（学长……我……）"   voices="miho05270"/><msg @l="357" char_id="-1" frame_id="-1" name=""   text="我紧咬嘴唇，做了个深呼吸来驱散杂念。" voices=""/><msg @l="358" char_id="-1" frame_id="-1" name=""   text="现实没有那么美好，必须集中精神。" voices=""/><clear @l="361" class="all"/><wait_chgmv/><bg @l="363" src="bg13"/><stopbgm @l="365" fadeout="1000"/><se @l="368" buf="1" src="ホイッスル（テニス場）" volume="1."/><bgm @l="370" src="bgm17" volume="1."/><msg @l="372" char_id="0" frame_id="1" name="美帆" text="『……！！』"   voices="miho05290"/><msg @l="374" char_id="-1" frame_id="-1" name="" text="———比赛开始了。"   voices=""/><msg @l="375" char_id="-1" frame_id="-1" name=""   text="铃木同学轻轻把手中的球向上抛起……" voices=""/><se @l="378" buf="1" src="テニスボール打つ音" volume="1."/><msg @l="380" char_id="-1" frame_id="-1" name="" text="然后用球拍击打下落的球。"   voices=""/><se @l="383" buf="1" src="ホイッスル（テニス場）" volume="1."/><msg @l="385" char_id="0" frame_id="1" name="美帆" text="『啊……！？』"   voices="miho05300"/><msg @l="387" char_id="-1" frame_id="-1" name="" text="那只是一瞬间的事。" voices=""/><msg @l="388" char_id="-1" frame_id="-1" name=""   text="等我注意到的时候……铃木同学击出的球已经在我身后滚动着了。" voices=""/><msg @l="390" char_id="-1" frame_id="-1" name="铃木" text="『哇哦！？』" voices=""/><msg @l="392" char_id="-1" frame_id="-1" name=""   text="铃木同学击出的强烈发球直接刺入球场，连她自己都感到惊讶，我想不脱一件衣服就解决比赛的想法从一开始就破灭了。"   voices=""/><msg @l="394" char_id="-1" frame_id="-1" name="女会员B" text="『得分，铃木。0-15』"   voices=""/><msg @l="396" char_id="-1" frame_id="-1" name="" text="裁判用毫无感情的声音宣布。"   voices=""/><msg @l="398" char_id="-1" frame_id="-1" name="女会员C"   text="『被拿走一分了呢。』" voices=""/><msg @l="400" char_id="-1" frame_id="-1" name=""   text="女子学姐带着令人不快的微笑，向我走来。" voices=""/><msg @l="401" char_id="-1" frame_id="-1" name="" text="然后，缓缓伸出了手。"   voices=""/><msg @l="403" char_id="0" frame_id="1" name="美帆" text="『……。』"   voices="miho05310"/><msg @l="405" char_id="-1" frame_id="-1" name="" text="失去一分……失分。" voices=""/><msg @l="406" char_id="-1" frame_id="-1" name=""   text="也就是说，让我脱下一件衣服给她。" voices=""/><wait_chgmv/><ev @l="409" src="ev-043y1y2y3"/><wait_chgmv/><ev @l="412" src="ev-043y2y3"/><msg @l="414" char_id="-1" frame_id="-1" name="" text="既然是约定……也没办法。"   voices=""/><msg @l="415" char_id="-1" frame_id="-1" name=""   text="我脱下网球服的外套，把它交给女子学姐。" voices=""/><msg @l="416" char_id="-1" frame_id="-1" name="" text="接下来轮到我发球了。"   voices=""/><msg @l="417" char_id="-1" frame_id="-1" name="" text="必须在这里扳回失去的分数……"   voices=""/><msg @l="419" char_id="-1" frame_id="-1" name=""   text="我深吸一口气，看着对方的球场思考要把发球落在哪里。" voices=""/><msg @l="420" char_id="-1" frame_id="-1" name=""   text="铃木同学并不是站在球场中央，而是明显偏向右侧。" voices=""/><msg @l="421" char_id="-1" frame_id="-1" name=""   text="无论怎么看，从我这边看右侧的空间都很开阔。" voices=""/><msg @l="423" char_id="0" frame_id="1" name="美帆" text="（右边……？）"   voices="miho05330"/><msg @l="425" char_id="-1" frame_id="-1" name=""   text="我尽量意识着要将球落在右侧，进入了发球姿势。" voices=""/><msg @l="426" char_id="-1" frame_id="-1" name=""   text="我把球高高抛向空中，注意不要用力过猛，从下方向上挥动球拍。" voices=""/><msg @l="427" char_id="-1" frame_id="-1" name=""   text="然而，球没有击中球拍的中心，而是打到了接近框架的部分，一股强烈的冲击传到了我的手腕上。" voices=""/><msg @l="429" char_id="0" frame_id="1" name="美帆" text="『唔……』"   voices="miho05320"/><msg @l="431" char_id="-1" frame_id="-1" name=""   text="伴随着一种钝感，球朝着完全错误的方向飞了出去。" voices=""/><msg @l="433" char_id="0" frame_id="1" name="美帆" text="（不会吧，方向反了！？）"   voices="miho05340"/><msg @l="435" char_id="-1" frame_id="-1" name=""   text="球正好飞向铃木同学的正前方，她迅速伸出球拍，轻而易举地将球回到了我的场地。" voices=""/><msg @l="436" char_id="-1" frame_id="-1" name=""   text="我试图调整姿势，慌忙地想要回球……" voices=""/><msg @l="437" char_id="-1" frame_id="-1" name="" text="但是，已经来不及了。"   voices=""/><se @l="440" buf="1" src="ホイッスル（テニス場）" volume="1."/><msg @l="442" char_id="-1" frame_id="-1" name=""   text="球落在距离网不远的地方，然后滚到了我的脚边。" voices=""/><msg @l="444" char_id="0" frame_id="1" name="美帆" text="『唔……』"   voices="miho05320"/><msg @l="446" char_id="-1" frame_id="-1" name="女会员B" text="『得分，铃木。0-30』"   voices=""/><msg @l="448" char_id="-1" frame_id="-1" name="女会员C"   text="『真遗憾……又被拿走一分呢。』" voices=""/><msg @l="450" char_id="0" frame_id="1" name="美帆" text="『……。』"   voices="miho05350"/><msg @l="452" char_id="-1" frame_id="-1" name="女会员C"   text="『来，现在该脱掉裙子了。』" voices=""/><msg @l="454" char_id="-1" frame_id="-1" name=""   text="虽然手已经放在了裙子上，但因为太羞耻，我一时无法脱下来。" voices=""/><msg @l="456" char_id="-1" frame_id="-1" name="女会员C"   text="『脱不下来吗？要不我来帮你脱？』" voices=""/><msg @l="458" char_id="-1" frame_id="-1" name=""   text="女子学姐一边这样说着，一边笑嘻嘻地向我靠近。" voices=""/><msg @l="460" char_id="0" frame_id="1" name="美帆" text="『我、我自己脱！』"   voices="miho05360"/><wait_chgmv/><ev @l="463" src="ev-043y3"/><msg @l="465" char_id="-1" frame_id="-1" name=""   text="感觉到她态度中有些可疑之处，我下定决心脱掉了裙子。" voices=""/><msg @l="467" char_id="-1" frame_id="-1" name="女会员C"   text="『哎呀，内裤上有痕迹……这是汗水？还是说……』" voices=""/><msg @l="468" char_id="0" frame_id="1" name="美帆" text="『你…你在干什么！』"   voices="miho05370"/><msg @l="470" char_id="-1" frame_id="-1" name="女会员B"   text="『仲根小姐，比赛还在进行中呢，快回到球场上！』" voices=""/><msg @l="472" char_id="-1" frame_id="-1" name="" text="裁判强行打断了我的抗议。"   voices=""/><msg @l="473" char_id="-1" frame_id="-1" name="" text="希望快点结束……"   voices=""/><msg @l="474" char_id="-1" frame_id="-1" name=""   text="我只穿着内衣，蹒跚地走回球场中央。" voices=""/><clear @l="477" class="all"/><wait_chgmv/><ev @l="480" src="ev-043"/><msg @l="482" char_id="-1" frame_id="-1" name=""   text="从那以后，我们一直在进行着你来我往的攻防战。" voices=""/><msg @l="483" char_id="-1" frame_id="-1" name=""   text="确切地说，是技术拙劣的新手之间因失误互相自毁的混战一直在持续，从平分（DEUCE）开始始终无法拉开两分的差距，双方都只穿着一条内裤，时间就这样一点点流逝了。"   voices=""/><msg @l="485" char_id="-1" frame_id="-1" name="女会员B" text="『平分。』"   voices=""/><msg @l="487" char_id="-1" frame_id="-1" name=""   text="铃木小姐的发球高高地越过我的头顶，比赛又回到了原点。" voices=""/><msg @l="488" char_id="-1" frame_id="-1" name=""   text="也许其他人已经分出胜负回到休息室了，现在场地上只剩下我们还在进行着脱衣网球。" voices=""/><msg @l="489" char_id="-1" frame_id="-1" name=""   text="回过神来，不知为何周围已经聚集了男子部员们，他们混在女生观众中间，目不转睛地盯着这边。" voices=""/><msg @l="490" char_id="-1" frame_id="-1" name=""   text="我向裁判提出质疑，但她完全不理会，只说是因为比赛时间拖得太久的缘故。" voices=""/><msg @l="492" char_id="-1" frame_id="-1" name="女会员B"   text="『现在停止的话双方都会被判失格。你打算让铃木小姐到现在的努力都白费吗？』" voices=""/><msg @l="494" char_id="-1" frame_id="-1" name=""   text="我看向球场对面，铃木小姐也只穿着一条内裤，正忍受着周围人好奇的目光。" voices=""/><msg @l="495" char_id="-1" frame_id="-1" name=""   text="她也是为了参加稻庭学长的二次会才这么努力的啊……" voices=""/><msg @l="496" char_id="-1" frame_id="-1" name=""   text="仅凭我一个人的意志已经无法让这场比赛停止了。" voices=""/><msg @l="498" char_id="0" frame_id="1" name="美帆" text="『继、继续比赛。』"   voices="miho05380"/><msg @l="500" char_id="-1" frame_id="-1" name="女会员B"   text="『那么，接下来由仲根小姐发球。』" voices=""/><msg @l="502" char_id="-1" frame_id="-1" name="女会员B"   text="『这样下去没完没了，所以接下来谁先得分谁就获胜。这样可以吧？』" voices=""/><msg @l="504" char_id="0" frame_id="1" name="美帆" text="『好、好的！』"   voices="miho05390"/><msg @l="506" char_id="-1" frame_id="-1" name="铃木" text="『好、好的。』"   voices=""/><msg @l="508" char_id="-1" frame_id="-1" name="" text="这样终于可以从这场比赛中解脱出来了。"   voices=""/><msg @l="509" char_id="-1" frame_id="-1" name=""   text="我退回到边线附近准备发球。" voices=""/><msg @l="511" char_id="-1" frame_id="-1" name="男会员A"   text="『哇，她的胸部真漂亮啊。』" voices=""/><msg @l="513" char_id="-1" frame_id="-1" name="男会员B"   text="『大小刚刚好，不会太大也不会太小……太诱人了啊。』" voices=""/><msg @l="515" char_id="-1" frame_id="-1" name="男会员C"   text="『那粉色的小樱桃看起来真漂亮，真想咬上一口啊。』" voices=""/><msg @l="517" char_id="-1" frame_id="-1" name=""   text="身后，坐在板凳上的男部员们一边盯着我暴露的胸部，一边肆无忌惮地说着各种话。" voices=""/><msg @l="518" char_id="-1" frame_id="-1" name=""   text="我虽然因羞耻而身体发抖，但还是右手拿着球，摆好了球拍姿势。" voices=""/><msg @l="520" char_id="-1" frame_id="-1" name="" text="咕啾……" voices=""/><stopbgm @l="523" fadeout="1000"/><msg @l="525" char_id="0" frame_id="1" name="美帆" text="（啊……）"   voices="miho00210"/><bgm @l="528" src="bgm13" volume="1."/><msg @l="530" char_id="-1" frame_id="-1" name=""   text="当我轻轻扭转身体想要遮住胸部不被他们看到的瞬间，股间传来了黏腻的水声。" voices=""/><msg @l="532" char_id="-1" frame_id="-1" name="男会员A" text="『喂，喂，刚才那个是……』"   voices=""/><msg @l="534" char_id="0" frame_id="1" name="美帆" text="（难道……被发现了……！？）"   voices="miho07420"/><msg @l="536" char_id="-1" frame_id="-1" name="男会员B" text="『啊啊……』"   voices=""/><msg @l="538" char_id="-1" frame_id="-1" name=""   text="其中一位男部员点了点头，慌忙地去向其他男生传递消息。" voices=""/><msg @l="539" char_id="-1" frame_id="-1" name=""   text="一眨眼的功夫，我身后就已经聚集了一大群男生。" voices=""/><msg @l="541" char_id="0" frame_id="1" name="美帆" text="『咦……怎么了？』"   voices="miho00350"/><msg @l="543" char_id="-1" frame_id="-1" name="男会员C"   text="『没事没事，继续比赛吧。』" voices=""/><msg @l="545" char_id="-1" frame_id="-1" name=""   text="为了准备发球，我弯下腰摆好姿势。" voices=""/><msg @l="547" char_id="-1" frame_id="-1" name="男会员D"   text="『哦……哦哦！太厉害了，真的湿了啊。』" voices=""/><msg @l="549" char_id="0" frame_id="1" name="美帆" text="『……啊！！』"   voices="miho00370"/><msg @l="551" char_id="-1" frame_id="-1" name=""   text="我不由自主地跳了起来，慌忙地把手伸到背后想要遮掩。" voices=""/><msg @l="552" char_id="-1" frame_id="-1" name=""   text="这时，内裤里发出了比刚才更加明显的湿黏声响。" voices=""/><msg @l="554" char_id="-1" frame_id="-1" name="男会员F"   text="『哇，好色情的声音。被大家看着让你兴奋起来了吧。』" voices=""/><msg @l="555" char_id="0" frame_id="1" name="美帆" text="（我……在感觉到……吗？）"   voices="miho07930"/><msg @l="557" char_id="-1" frame_id="-1" name=""   text="对这种异常状况的反应唤醒了另一种麻痹般的感觉，我的膝盖不住地颤抖。" voices=""/><msg @l="558" char_id="-1" frame_id="-1" name=""   text="在外面裸露身体，还被人看见那里湿了什么的……" voices=""/><stopbgm @l="561" fadeout="1000"/><wait_chgmv/><bg @l="564" src="bg13"/><msg @l="566" char_id="-1" frame_id="-1" name="女会员B"   text="『仲根同学，快开始发球吧！』" voices=""/><msg @l="568" char_id="-1" frame_id="-1" name="" text="听到裁判的声音，我才回过神来。"   voices=""/><msg @l="569" char_id="-1" frame_id="-1" name=""   text="大概是看不下去我这副丑态，想要帮我解围吧。" voices=""/><msg @l="570" char_id="-1" frame_id="-1" name=""   text="无论如何，只要发完这个球，不管输赢，我都能从这种异常状况中解脱出来。" voices=""/><msg @l="571" char_id="-1" frame_id="-1" name=""   text="我重新拿起球，紧紧握住它，像是在确认手感。" voices=""/><msg @l="573" char_id="0" frame_id="1" name="美帆" text="『……。』"   voices="miho05400"/><msg @l="575" char_id="0" frame_id="1" name="美帆"   text="（就假装是朝着墙打球吧……）" voices="miho05410"/><msg @l="577" char_id="0" frame_id="1" name="美帆" text="（这样的话……就不会害怕了）"   voices="miho05420"/><msg @l="579" char_id="-1" frame_id="-1" name=""   text="我深呼吸着，在心里这样告诉自己，然后轻轻抛出球。" voices=""/><msg @l="580" char_id="-1" frame_id="-1" name="" text="然后……。" voices=""/><bgm @l="583" src="bgm17" volume="1."/><msg @l="585" char_id="0" frame_id="1" name="美帆" text="『哈……！』"   voices="miho05430"/><se @l="588" buf="1" src="テニスボール打つ音" volume="1."/><msg @l="590" char_id="-1" frame_id="-1" name="" text="球拍击打着球。"   voices=""/><msg @l="591" char_id="-1" frame_id="-1" name=""   text="难得地，球笔直地飞了出去……落入了铃木小姐的场地中。" voices=""/><msg @l="592" char_id="-1" frame_id="-1" name=""   text="她拼命地向球跑去，试图尽可能地回击这个球。" voices=""/><goto @l="595" cond="!(f.稲庭コーチflag&#32;==&#32;1)&#13;&#10;"   label="TempLabel_246"/><goto @l="598" label="EventLabel_92"/><goto @l="601" label="TempLabel_247"/><label @l="602" id="TempLabel_246"/><msg @l="607" async="true" char_id="-1" frame_id="-1" name=""   text="追球的方向是……？" voices=""/><select @l="608"><menu @l="612" label="EventLabel_92" text="向右"/><menu @l="615" label="EventLabel_95" text="向左"/></select><label @l="623" id="TempLabel_247"/><label @l="627" id="EventLabel_92"/><msg @l="629" char_id="0" frame_id="1" name="美帆" text="（这边……！）"   voices="miho05440"/><msg @l="631" char_id="-1" frame_id="-1" name="" text="我本能地向右跑去。"   voices=""/><msg @l="633" char_id="-1" frame_id="-1" name="铃木" text="『嘿……！』" voices=""/><se @l="636" buf="1" src="テニスボール打つ音" volume="1."/><msg @l="638" char_id="-1" frame_id="-1" name=""   text="可能是因为没能保持充分的姿势，球的力道并不强。" voices=""/><msg @l="639" char_id="-1" frame_id="-1" name=""   text="然后，球正好落在了我的眼前。" voices=""/><goto @l="642" cond="!(f.稲庭コーチflag&#32;==&#32;1)&#13;&#10;"   label="TempLabel_248"/><msg @l="644" char_id="0" frame_id="1" name="美帆"   text="（像昨天那样，用球拍的最佳击球点击中———）" voices="miho05450"/><label @l="647" id="TempLabel_248"/><msg @l="650" char_id="0" frame_id="1" name="美帆" text="『哈……！』"   voices="miho05460"/><msg @l="652" char_id="-1" frame_id="-1" name=""   text="收紧腋部，挥动球拍直直地击出。" voices=""/><se @l="655" buf="1" src="テニスボール打つ音" volume="1."/><msg @l="657" char_id="-1" frame_id="-1" name=""   text="伴随着轻快的声音，球被回击至铃木所在的球场。" voices=""/><msg @l="658" char_id="-1" frame_id="-1" name=""   text="或许是在回击的那一刻用尽了力气，她一动也不能动。" voices=""/><msg @l="659" char_id="-1" frame_id="-1" name="" text="然后……。" voices=""/><se @l="662" buf="1" src="ホイッスル（テニス場）" volume="1."/><stopbgm @l="665" fadeout="1000"/><msg @l="667" char_id="-1" frame_id="-1" name="女会员B" text="『比赛胜者，仲根。』"   voices=""/><msg @l="669" char_id="-1" frame_id="-1" name="" text="裁判的声音……在网球场上回响。"   voices=""/><msg @l="670" char_id="-1" frame_id="-1" name=""   text="我倾尽全力打出的球，失去了力道，咕噜咕噜地滚向了网。" voices=""/><msg @l="671" char_id="0" frame_id="1" name="美帆" text="『诶……？』"   voices="miho05470"/><msg @l="673" char_id="-1" frame_id="-1" name="" text="我不太明白发生了什么。"   voices=""/><bgm @l="676" src="bgm05" volume="1."/><msg @l="678" char_id="-1" frame_id="-1" name="女会员B" text="『仲根小姐，你赢了。』"   voices=""/><msg @l="680" char_id="0" frame_id="1" name="美帆" text="『我……赢了？』"   voices="miho05480"/><msg @l="682" char_id="-1" frame_id="-1" name="女会员B"   text="『是的，你赢了。』" voices=""/><msg @l="684" char_id="0" frame_id="1" name="美帆" text="『真的……吗？』"   voices="miho05490"/><msg @l="686" char_id="-1" frame_id="-1" name="女会员B" text="『嗯。』" voices=""/><msg @l="688" char_id="-1" frame_id="-1" name=""   text="我急忙穿上了被脱下后随意放置的胸罩和网球服。" voices=""/><msg @l="689" char_id="-1" frame_id="-1" name="女会员A"   text="『那么，新生欢迎会到此结束。』" voices=""/><clear @l="692" class="all"/><end_scene @l="695"/><bgm @l="698" src="bgm02" volume="1."/><msg @l="701" char_id="-1" frame_id="-1" name="女会员A"   text="『恭喜你，仲根小姐。那我们现在就去二次聚会的场地吧。』" voices=""/><msg @l="703" char_id="-1" frame_id="-1" name=""   text="活动结束后我刚松了口气，女生学姐就来搭话了。" voices=""/><msg @l="705" char_id="0" frame_id="1" name="美帆" text="『啊，现在就去吗？』"   voices=""/><msg @l="707" char_id="-1" frame_id="-1" name="女会员A"   text="『是啊，因为场地的安排，我们必须现在就走了。比赛花了太多时间，已经耽误了不少了。』"   voices=""/><msg @l="709" char_id="0" frame_id="1" name="美帆" text="『对不起。』" voices=""/><msg @l="711" char_id="-1" frame_id="-1" name="女会员A"   text="『不用在意。更重要的是，礼服什么的在那边都准备好了，你只要带着行李到正门前等着就行。我会安排车的。』"   voices=""/><msg @l="713" char_id="0" frame_id="1" name="美帆" text="『我知道了。……啊！』"   voices=""/><msg @l="715" char_id="-1" frame_id="-1" name="女会员A" text="『怎么了？』"   voices=""/><msg @l="717" char_id="0" frame_id="1" name="美帆"   text="『那、那个……我能去一下厕所吗？』" voices=""/><msg @l="719" char_id="-1" frame_id="-1" name="女会员A" text="『……快点哦。』"   voices=""/><stopbgm @l="723" fadeout="1000"/><clear @l="726" class="all"/><msg @l="728" char_id="-1" frame_id="-1" name="" text="……………。"   voices=""/><se @l="731" buf="1" src="おしっこ" volume="1."/><msg @l="733" char_id="-1" frame_id="-1" name="" text="哗啦哗啦哗啦……。"   voices=""/><msg @l="735" char_id="-1" frame_id="-1" name="" text="我一个人留下来解决生理需求。"   voices=""/><msg @l="737" char_id="0" frame_id="1" name="美帆"   text="（啊，我真是太不会挑时候了。那个人，肯定对我很失望吧。）" voices=""/><msg @l="739" char_id="-1" frame_id="-1" name=""   text="网球比赛结束后，或许是因为紧张的神经松弛下来，我突然感到一阵尿意。" voices=""/><msg @l="740" char_id="-1" frame_id="-1" name=""   text="虽然忍一忍也不是不可能，但想到万一在车上途中想上厕所，我觉得还是先在这里解决比较好。"   voices=""/><msg @l="742" char_id="0" frame_id="1" name="美帆"   text="（我已经问好了地点，之后坐出租车去就行了吧。）" voices=""/><msg @l="744" char_id="-1" frame_id="-1" name="" text="就在我这样想着的时候，终于完事了。"   voices=""/><msg @l="745" char_id="-1" frame_id="-1" name=""   text="我拿纸巾贴在私处，擦干剩余的水滴。" voices=""/><msg @l="747" char_id="-1" frame_id="-1" name="" text="咕啾。" voices=""/><msg @l="749" char_id="0" frame_id="1" name="美帆" text="『嗯呼。』" voices=""/><msg @l="751" char_id="-1" frame_id="-1" name=""   text="当我移开纸巾时，秘唇之间拉出一丝白色的细丝。" voices=""/><msg @l="753" char_id="0" frame_id="1" name="美帆" text="（果然，已经湿得不得了了。）"   voices=""/><msg @l="755" char_id="0" frame_id="1" name="美帆"   text="（我，是因为被看到了而感到兴奋吗····。）" voices=""/><clear @l="758" class="all"/><msg @l="760" char_id="-1" frame_id="-1" name="" text="····················。"   voices=""/><msg @l="761" char_id="-1" frame_id="-1" name="" text="··········。" voices=""/><wait_chgmv/><bg @l="764" src="bg07"/><char @l="767" id="miho" pos="auto" src="miho020"/><bgm @l="770" src="bgm02" volume="1."/><msg @l="772" char_id="-1" frame_id="-1" name=""   text="上完厕所后，反正已经迟到了，我索性换上了便装。" voices=""/><msg @l="774" char_id="0" frame_id="1" name="美帆"   text="（总觉得有点不好意思去呢····，但是取消的话就不好了吧。）" voices=""/><msg @l="776" char_id="-1" frame_id="-1" name="声音" text="『····！！』" voices=""/><msg @l="778" char_id="-1" frame_id="-1" name="" text="突然从远处传来了一个女人的声音。"   voices=""/><msg @l="780" char_id="0" frame_id="1" name="美帆"   text="（那是····玲小姐的声音。原来玲小姐来了啊。）" voices=""/><msg @l="782" char_id="-1" frame_id="-1" name=""   text="感到有些孤独的我突然很想见玲小姐，于是朝着声音传来的方向走去。" voices=""/><msg @l="783" char_id="-1" frame_id="-1" name=""   text="看来她好像在平时使用的网球场。" voices=""/><clear @l="786" class="all"/><bgm @l="789" src="bgm13" volume="1."/><wait_chgmv/><bg @l="792" src="bg13"/><msg @l="794" char_id="0" frame_id="1" name="美帆" text="『玲小姐……诶诶！？』"   voices=""/><char @l="797" id="miho" pos="auto" src="miho124"/><msg @l="799" char_id="-1" frame_id="-1" name=""   text="我无法理解眼前发生的景象。" voices=""/><msg @l="800" char_id="-1" frame_id="-1" name="" text="玲小姐她……被侵犯了？"   voices=""/><msg @l="801" char_id="-1" frame_id="-1" name=""   text="由于极度恐惧想要退回去时，眼前出现了一张熟悉的面孔。" voices=""/><clear @l="804" class="char"/><char @l="807" id="inaba" pos="auto" src="inaba050"/><msg @l="809" char_id="-1" frame_id="-1" name="稻庭" text="『仲根同学？』" voices=""/><msg @l="811" char_id="0" frame_id="1" name="美帆"   text="『稻、稻庭学长，玲小姐！玲小姐！』" voices=""/><stopbgm @l="814" fadeout="1000"/><flash @l="817" count="4" fade="100" image="white"/><se @l="819" buf="1" src="箱を蹴ってる" volume="1."/><shake @l="821" amp="10" class="all" cycle="30" duration="500" type="random"/><msg @l="823" char_id="-1" frame_id="-1" name="" text="咚！" voices=""/><msg @l="825" char_id="0" frame_id="1" name="美帆" text="『呃。』" voices=""/><msg @l="827" char_id="-1" frame_id="-1" name=""   text="下一瞬间我全身受到强烈冲击，失去了意识。" voices=""/><clear @l="830" class="char"/><clear @l="833" class="all"/><char @l="836" id="inaba" pos="auto" src="inaba058f"/><msg @l="838" char_id="-1" frame_id="-1" name="稻庭" text="『…………。』" voices=""/><msg @l="840" char_id="-1" frame_id="-1" name=""   text="在我眼皮落下之前那一瞬间看到的学长脸上，是我从未见过的可怕表情。" voices=""/><clear @l="844" class="all"/><msgshow @l="846" show="true"/><wait_chgmv/><bg @l="848" src="bg13"/><bgm @l="851" src="bgm03" volume="1."/><msg @l="853" char_id="0" frame_id="1" name="美帆" text="『嗯……。』" voices=""/><msg @l="855" char_id="-1" frame_id="-1" name=""   text="突然，我被许多人喧闹的声音惊醒了。" voices=""/><msg @l="856" char_id="-1" frame_id="-1" name=""   text="环顾四周，这里是网球场……我试图回想起自己为什么会在这里。" voices=""/><flash @l="859" count="4" fade="100" image="white"/><msg @l="861" char_id="0" frame_id="1" name="美帆" text="（呜啊……头好痛…………）"   voices=""/><msg @l="863" char_id="-1" frame_id="-1" name=""   text="当我试图回忆记忆时，感到一阵剧烈的偏头痛。" voices=""/><msg @l="864" char_id="-1" frame_id="-1" name=""   text="太阳穴附近随着脉搏一跳一跳地疼痛。" voices=""/><msg @l="866" char_id="-1" frame_id="-1" name="男会员B"   text="『喂，你在磨蹭什么呢！咯咯咯！！』" voices=""/><msg @l="868" char_id="-1" frame_id="-1" name="男会员C"   text="『咕咕咕，快点结束掉吧。』" voices=""/><msg @l="870" char_id="0" frame_id="1" name="美帆" text="（啊……有人在说话……是什么呢）"   voices=""/><msg @l="872" char_id="-1" frame_id="-1" name=""   text="我忍着偏头痛慢慢地撑起身体。" voices=""/><msg @l="873" char_id="-1" frame_id="-1" name=""   text="网球场的一角围着一群人。" voices=""/><msg @l="874" char_id="-1" frame_id="-1" name=""   text="从这里能看到的只有男子部员们的背影，看不清人群中心到底是什么情况。" voices=""/><msg @l="876" char_id="0" frame_id="1" name="美帆" text="（能……站起来吗？）"   voices=""/><msg @l="878" char_id="-1" frame_id="-1" name="" text="我试着让双腿用力。" voices=""/><msg @l="879" char_id="-1" frame_id="-1" name=""   text="虽然有些摇晃……但总算能够站起来了。" voices=""/><char @l="882" id="miho" pos="auto" src="miho016"/><msg @l="884" char_id="0" frame_id="1" name="美帆" text="『那个……你们在做什么呢？』"   voices=""/><msg @l="886" char_id="-1" frame_id="-1" name="男会员D"   text="『嗯？啊，看来另一个也醒了。呵呵呵。』" voices=""/><msg @l="888" char_id="-1" frame_id="-1" name="男会员E"   text="『哦，这样一来能处理的量一下子就增加了呢。嘿嘿嘿嘿嘿。』" voices=""/><msg @l="889" char_id="-1" frame_id="-1" name="男会员F"   text="『笨蛋，不是说过不要动手吗？』" voices=""/><char @l="892" id="miho" pos="auto" src="miho116"/><msg @l="894" char_id="0" frame_id="1" name="美帆" text="『啊，那个……你们在说什么？』"   voices=""/><msg @l="896" char_id="-1" frame_id="-1" name="男会员B"   text="『嘿嘿，如果好奇的话你也一起来看看吧。咕咕咕……很有意思哦。』" voices=""/><char @l="899" id="miho" pos="auto" src="miho114"/><msg @l="901" char_id="0" frame_id="1" name="美帆" text="『……？』" voices=""/><stopbgm @l="904" fadeout="1000"/><clear @l="907" class="all"/><label @l="910" id="event_scene15"/><msg @l="912" char_id="-1" frame_id="-1" name=""   text="人群中的一名男子部员让出了位置，把我推了进去。" voices=""/><msg @l="915" char_id="0" frame_id="1" name="美帆" text="『你，你们在做什么……啊！？』"   voices=""/><label @l="918" id="chart_line53"/><wait_chgmv/><ev @l="920" src="ev-015_1"/><description @l="922" text="悲伤的胜利"/><bgm @l="925" src="bgm14" volume="1."/><msg @l="927" char_id="1" frame_id="-1" name="玲"   text="『嗯嗯呜……嗯，嗯嗯……嗯………啾……。』" voices="rei00260"/><msg @l="929" char_id="-1" frame_id="-1" name=""   text="人群的中心……玲学姐正含着一个男人的那个。" voices=""/><msg @l="930" char_id="-1" frame_id="-1" name=""   text="她把那根硬挺的肉棒前端含在口中，发出啾啾的淫靡水声吮吸着。" voices=""/><msg @l="932" char_id="0" frame_id="1" name="美帆" text="『学，学姐………呜！？』"   voices="miho05140"/><msg @l="934" char_id="-1" frame_id="-1" name=""   text="就在我想开口的瞬间，站在我身旁的男子部员强行捂住了我的嘴。" voices=""/><msg @l="936" char_id="-1" frame_id="-1" name="男会员E"   text="『她好不容易才乖乖地开始吸了，别多余地打扰，给我安静地看着，咔咔咔咔。』" voices=""/><msg @l="938" char_id="-1" frame_id="-1" name="男会员D"   text="『嘿嘿嘿嘿，是啊……比起看着那个又酷又倔强的女孩被打了强行含着，这样不是好多了吗？』" voices=""/><msg @l="940" char_id="0" frame_id="1" name="美帆" text="『……。』"   voices="miho05150"/><msg @l="942" char_id="-1" frame_id="-1" name=""   text="在耳边低语的狂气让我陷入了沉默。" voices=""/><msg @l="944" char_id="1" frame_id="-1" name="玲"   text="『呜咕……嗯，啾……呜咕，呜咕，呜咕，呜咕。』" voices="rei00270"/><msg @l="946" char_id="-1" frame_id="-1" name="男会员A"   text="『哦，不错啊……技术相当好嘛。』" voices=""/><msg @l="948" char_id="1" frame_id="-1" name="玲"   text="『嗯，嗯嗯……嗯……嗯咕，啾，啾………。』" voices="rei00280"/><msg @l="950" char_id="-1" frame_id="-1" name=""   text="不知是放弃了还是被威胁的结果……玲学姐带着一副不情愿的表情，发出啾啾的水声爱抚着口中的那个。"   voices=""/><msg @l="952" char_id="1" frame_id="-1" name="玲"   text="『嗯嗯……嗯，嗯，嗯嗯……啾，啾噜。』" voices="rei00290"/><msg @l="954" char_id="-1" frame_id="-1" name="男会员A"   text="『呜哇！太棒了，刚才那种吸法感觉真不错。』" voices=""/><msg @l="956" char_id="-1" frame_id="-1" name=""   text="让玲含着的男人这样说着，腰部颤抖起来。" voices=""/><msg @l="957" char_id="-1" frame_id="-1" name=""   text="……看来是要她更用力地吸。" voices=""/><msg @l="959" char_id="1" frame_id="-1" name="玲"   text="『啾……嗯，嗯咕……嗯……啾，啾噗。』" voices="rei00300"/><msg @l="961" char_id="-1" frame_id="-1" name=""   text="但是……玲似乎没有理解男人的意图，没有吸吮，而是用嘴唇和舌头啧啧地舔弄着前端部分。"   voices=""/><msg @l="963" char_id="-1" frame_id="-1" name="男会员A"   text="『什么啊，不是说了要吸吗。』" voices=""/><msg @l="965" char_id="-1" frame_id="-1" name=""   text="男人猛地向上顶胯，肉棒的前端撞击着玲的喉咙。" voices=""/><msg @l="967" char_id="1" frame_id="-1" name="玲"   text="『嗯咕……嗯，嗯嗯嗯……！！』" voices="rei00310"/><msg @l="969" char_id="-1" frame_id="-1" name="男会员A"   text="『你只要用口技让这里所有人都射出来就结束了，哈哈哈哈。』" voices=""/><msg @l="971" char_id="-1" frame_id="-1" name="男会员A"   text="『想要早点结束的话就老实地舔吧。』" voices=""/><msg @l="973" char_id="1" frame_id="-1" name="玲"   text="『啊呜……嗯，啾噗……啾，啾噜噜噜噜……。』" voices="rei00320"/><msg @l="975" char_id="-1" frame_id="-1" name="男会员A"   text="『对对，就是这样老实点……就好了，呵呵呵呵。』" voices=""/><msg @l="977" char_id="0" frame_id="1" name="美帆" text="『什么……。』"   voices="miho05170"/><msg @l="979" char_id="0" frame_id="1" name="美帆"   text="（这里所有人……到底，他们以为有多少人啊！？）" voices="miho05180"/><msg @l="981" char_id="-1" frame_id="-1" name="" text="粗略估计至少有十几个人吧。"   voices=""/><msg @l="982" char_id="-1" frame_id="-1" name=""   text="要用嘴为他们所有人服务……太残忍了。" voices=""/><msg @l="984" char_id="0" frame_id="1" name="美帆" text="（只能沉默地看着吗……？）"   voices="miho05190"/><msg @l="986" char_id="-1" frame_id="-1" name=""   text="环顾四周，全是网球部的学生，找不到可以求助的大人。" voices=""/><msg @l="987" char_id="0" frame_id="1" name="美帆" text="（……稻庭学长也不在……）"   voices="miho05210"/><msg @l="989" char_id="-1" frame_id="-1" name=""   text="突然，脑海中浮现出失去意识前最后看到的学长的脸。" voices=""/><msg @l="990" char_id="-1" frame_id="-1" name=""   text="当时看到的是否真的是稻庭学长，混乱的头脑无法做出判断。" voices=""/><msg @l="991" char_id="-1" frame_id="-1" name=""   text="尽管如此，现在能依靠的只有稻庭学长了。" voices=""/><msg @l="992" char_id="-1" frame_id="-1" name=""   text="而且，也不能就这样放着玲不管。" voices=""/><msg @l="994" char_id="0" frame_id="1" name="美帆" text="（该怎么……做呢？）"   voices="miho05230"/><msg @l="996" char_id="1" frame_id="-1" name="玲"   text="『嗯噗，嗯噗……嗯咕，啾噗……嗯，啾噗噗噗。』" voices="rei00330"/><msg @l="998" char_id="-1" frame_id="-1" name="男会员A"   text="『呵呵呵呵……不错啊，越来越好了啊……。』" voices=""/><msg @l="1000" char_id="1" frame_id="-1" name="玲"   text="『啾姆……嗯，嗯嗯……嗯噗……啾噗，啾噗，啾噗。』" voices="rei00340"/><msg @l="1002" char_id="-1" frame_id="-1" name="男会员A"   text="『来，吸一下前端！』" voices=""/><msg @l="1004" char_id="1" frame_id="-1" name="玲"   text="『嗯嗯……啾，啾噜噜……啾噜噜噜噜噜！』" voices="rei00350"/><msg @l="1006" char_id="-1" frame_id="-1" name="男会员A" text="『呜哦哦！』"   voices=""/><flash @l="1009" count="4" fade="100" image="white"/><wait_chgmv/><ev @l="1011" src="ev-015_2"/><msg @l="1013" char_id="1" frame_id="-1" name="玲" text="『嗯噗！？』"   voices="rei00360"/><msg @l="1015" char_id="-1" frame_id="-1" name=""   text="含着那个男人的腰部颤抖着，玲闭上眼睛一脸痛苦的样子。" voices=""/><msg @l="1016" char_id="-1" frame_id="-1" name=""   text="从她含着男人那个的嘴角，溢出了装不下的精液。" voices=""/><wait_chgmv/><ev @l="1019" src="ev-015_3"/><msg @l="1021" char_id="-1" frame_id="-1" name="男会员A" text="『喝下去！！』"   voices=""/><msg @l="1023" char_id="1" frame_id="-1" name="玲" text="『嗯姆呜！？』"   voices="rei00370"/><msg @l="1025" char_id="-1" frame_id="-1" name="男会员A"   text="『吐出来的话就得重来啊！』" voices=""/><msg @l="1027" char_id="1" frame_id="-1" name="玲" text="『……。』"   voices="rei00380"/><msg @l="1029" char_id="1" frame_id="-1" name="玲"   text="『嗯……嗯咕……嗯库，嗯库……嗯库……。』" voices="rei00390"/><msg @l="1031" char_id="-1" frame_id="-1" name=""   text="玲的喉咙发出声音，把口中的精液咽了下去。" voices=""/><msg @l="1032" char_id="-1" frame_id="-1" name=""   text="大概量很多吧……她一次又一次地发出咕咚咕咚的声音。眼角还挂着泪水。" voices=""/><clear @l="1035" class="all"/><msg @l="1037" char_id="-1" frame_id="-1" name="男会员B"   text="『下一个，该轮到我了啊。嘿嘿嘿嘿嘿。』" voices=""/><msg @l="1039" char_id="-1" frame_id="-1" name=""   text="刚才让她含着的男人从她口中抽出阴茎后，接着下一个男人立刻坐到了玲的面前，将勃起的肉棒抵到了她的口中。"   voices=""/><msg @l="1041" char_id="1" frame_id="-1" name="玲" text="『嗯……啊，嗯呜。』"   voices="rei00400"/><msg @l="1043" char_id="-1" frame_id="-1" name=""   text="玲在短暂迟疑后，开始用舌头缠绕着插入的男根。" voices=""/><clear @l="1046" class="all"/><msgshow @l="1048" show="true"/><wait_chgmv/><ev @l="1051" src="ev-015_2"/><msg @l="1053" char_id="-1" frame_id="-1" name="男会员B"   text="『要好好地闭紧嘴唇，发出色情的声音来舔啊。嘻嘻嘻嘻。』" voices=""/><msg @l="1055" char_id="1" frame_id="-1" name="玲"   text="『嗯，啾……嗯，嗯嗯……啾啪……滴啾……。』" voices="rei00410"/><msg @l="1057" char_id="-1" frame_id="-1" name=""   text="玲听从男人的指示，紧紧地撅起嘴唇，前后摆动着头部。" voices=""/><msg @l="1058" char_id="-1" frame_id="-1" name=""   text="可能是因为还没有足够的唾液润滑的缘故，每当那东西进出时，她的嘴唇都像是黏在肉上一样被大幅拉扯着。"   voices=""/><msg @l="1060" char_id="1" frame_id="-1" name="玲"   text="『嗯呜……嗯，啾……嗯咕，嗯，嗯嗯……。』" voices="rei00420"/><msg @l="1062" char_id="-1" frame_id="-1" name="男会员B"   text="『再多点，在嘴里多积点唾液，弄得像你的小穴一样湿漉漉的啊。嘻嘻嘻嘻嘻嘻……。』" voices=""/><msg @l="1064" char_id="1" frame_id="-1" name="玲" text="『嗯……。』"   voices="rei00430"/><msg @l="1066" char_id="-1" frame_id="-1" name=""   text="按照男人的指示，她停止了口部的动作。" voices=""/><msg @l="1067" char_id="-1" frame_id="-1" name=""   text="或许是因为不甘心，眼角泛着泪光，嘴里含着男根的同时积蓄唾液，将其完全浸湿后，又开始前后摆动头部。"   voices=""/><msg @l="1069" char_id="1" frame_id="-1" name="玲"   text="『嗯……嗯嗯……啾噗……啾噗噗…………嗯，嗯呜呜。』" voices="rei00440"/><msg @l="1071" char_id="-1" frame_id="-1" name=""   text="比刚才更加淫靡的水声回荡着，玲用嘴唇和舌头不断套弄着男人的那话儿。" voices=""/><msg @l="1072" char_id="-1" frame_id="-1" name=""   text="嘴角溢出了刚才射进去的精液和唾液的混合物，沿着她的大腿滴落下来。" voices=""/><msg @l="1074" char_id="-1" frame_id="-1" name="男会员B"   text="『对对……嘿嘿嘿……哇啊，真爽啊。』" voices=""/><msg @l="1076" char_id="-1" frame_id="-1" name="男会员B"   text="『那个，重点舔舔下面的筋……哦哦！』" voices=""/><msg @l="1078" char_id="-1" frame_id="-1" name=""   text="当她的舌头舔过男根的背面，用舌尖刺激龟头时，男人发出了舒服的声音。玲就像一个人偶一样……按照命令吮吸着肉棒。"   voices=""/><msg @l="1080" char_id="1" frame_id="-1" name="玲"   text="『啾噗啾噗啾噗……嗯，啾姆……嗯呼。』" voices="rei00450"/><msg @l="1082" char_id="1" frame_id="-1" name="玲"   text="『啾、啾噗……呃、嗯、嗯、嗯嗯……啾噜噜。』" voices="rei00460"/><wait_chgmv/><ev @l="1085" src="ev-015_4"/><msg @l="1087" char_id="-1" frame_id="-1" name="男会员C"   text="『啊啊啊……还没好吗，快点啊。』" voices=""/><msg @l="1089" char_id="-1" frame_id="-1" name=""   text="旁边，等待轮到自己的男人一边撸动自己的肉棒一边开始催促。" voices=""/><msg @l="1090" char_id="-1" frame_id="-1" name=""   text="龟头前端已经渗出了前液，一跳一跳地脉动着。" voices=""/><msg @l="1092" char_id="-1" frame_id="-1" name="男会员B"   text="『嘿嘿嘿嘿嘿，再等一下啊……我现在正舒服呢。』" voices=""/><msg @l="1094" char_id="-1" frame_id="-1" name=""   text="说着，让她含着的男人抓住玲的头，猛烈地前后摆动起来。" voices=""/><msg @l="1096" char_id="1" frame_id="-1" name="玲"   text="『啾噗……啾、呃……嗯、嗯、嗯嗯……。』" voices="rei00470"/><msg @l="1098" char_id="-1" frame_id="-1" name="男会员C"   text="『哈……哈……哈……。』" voices=""/><msg @l="1100" char_id="-1" frame_id="-1" name="男会员C"   text="『我、我已经忍不住了……要射你脸上！』" voices=""/><msg @l="1102" char_id="-1" frame_id="-1" name="男会员B" text="『啊，喂……！』"   voices=""/><flash @l="1105" count="4" fade="100" image="white"/><wait_chgmv/><ev @l="1108" src="ev-015_5"/><msg @l="1110" char_id="1" frame_id="-1" name="玲" text="『嗯嗯呜！？』"   voices="rei00480"/><msg @l="1112" char_id="-1" frame_id="-1" name=""   text="从旁边，一大股乳白色的液体喷洒在玲的脸上，将她漂亮的脸蛋弄得黏糊糊的。" voices=""/><msg @l="1114" char_id="-1" frame_id="-1" name="男会员B"   text="『啊——啊，搞得黏糊糊的了。』" voices=""/><msg @l="1116" char_id="-1" frame_id="-1" name="男会员C"   text="『嘿嘿嘿嘿嘿，好得很，我早就想把这家伙漂亮的脸蛋弄得黏黏的了。』" voices=""/><msg @l="1118" char_id="-1" frame_id="-1" name="男会员B"   text="『我不是说等我射完再说嘛！难得被那个有名的美人白石，一边看着那张端正的脸一边给我口交，结果被你那肮脏的精液挡住视线了！！』"   voices=""/><msg @l="1120" char_id="-1" frame_id="-1" name="男会员C"   text="『嘿嘿嘿嘿嘿，别这样嘛。我就喜欢颜射。咱们其他人也往她脸上射吧。』" voices=""/><msg @l="1122" char_id="-1" frame_id="-1" name="男会员D"   text="『我、我也……马上就要射了……啊、啊啊啊啊！』" voices=""/><flash @l="1125" count="4" fade="100" image="white"/><wait_chgmv/><ev @l="1128" src="ev-015_6"/><msg @l="1130" char_id="1" frame_id="-1" name="玲" text="『嗯嗯……呜、啾……。』"   voices="rei00490"/><msg @l="1132" char_id="-1" frame_id="-1" name=""   text="男人们对着摇头表示抗拒的玲，释放出了他们炽热的液体。" voices=""/><msg @l="1134" char_id="-1" frame_id="-1" name="男会员B"   text="『哦？……这样也挺色情的嘛……呵呵呵呵呵……。』" voices=""/><msg @l="1136" char_id="-1" frame_id="-1" name="男会员C"   text="『对吧？这就是所谓的精液面膜。嘿嘿嘿嘿嘿。』" voices=""/><msg @l="1138" char_id="-1" frame_id="-1" name="男会员B"   text="『真是便宜你了啊！能让精液从脸上每个地方都渗透进去！！』" voices=""/><msg @l="1140" char_id="-1" frame_id="-1" name=""   text="正让她含着的男人一边欣赏着她被白浊弄脏的脸，一边挺动腰部顶撞着她的喉咙深处。" voices=""/><msg @l="1142" char_id="-1" frame_id="-1" name="男会员B"   text="『好——啊，就这样用整个嘴吧！！』" voices=""/><msg @l="1144" char_id="1" frame_id="-1" name="玲"   text="『嗯，嗯嗯！……唔，啾，啾，啾……。』" voices="rei00500"/><msg @l="1146" char_id="-1" frame_id="-1" name=""   text="男人猛烈摆动腰部，肆意蹂躏着她的口腔。" voices=""/><msg @l="1147" char_id="-1" frame_id="-1" name="" text="玲拼命地承受着这一切。"   voices=""/><msg @l="1149" char_id="-1" frame_id="-1" name="男会员B"   text="『啊，啊啊……我要射了，给我好好喝下去！！』" voices=""/><msg @l="1151" char_id="1" frame_id="-1" name="玲"   text="『嗯嗯，啾，啾……嗯……嗯嗯，咕，啾噜！』" voices="rei00510"/><msg @l="1153" char_id="-1" frame_id="-1" name="男会员B" text="『呜呜！』"   voices=""/><flash @l="1156" count="4" fade="100" image="white"/><wait_chgmv/><ev @l="1159" src="ev-015_7"/><msg @l="1161" char_id="1" frame_id="-1" name="玲"   text="『嗯嗯……嗯……嗯咕……嗯咕，嗯咕…………嗯咕。』" voices="rei00520"/><msg @l="1163" char_id="-1" frame_id="-1" name=""   text="虽然对这突然的举动感到惊讶，但她还是把口中射出的精液咽了下去。" voices=""/><msg @l="1165" char_id="1" frame_id="-1" name="玲"   text="『嗯……嗯咕……嗯咕……嗯咕………嗯，嗯呼。』" voices="rei00540"/><msg @l="1167" char_id="-1" frame_id="-1" name="男会员B"   text="『呜，呜哇……被吸干了…………。』" voices=""/><msg @l="1169" char_id="-1" frame_id="-1" name=""   text="即使口内射精已经结束，她似乎仍然在吮吸着肉棒。" voices=""/><msg @l="1171" char_id="0" frame_id="1" name="美帆" text="『……。』"   voices="miho05240"/><stopbgm @l="1174" fadeout="1000"/><clear @l="1177" class="all"/><wait_chgmv/><bg @l="1180" src="bg13"/><bgm @l="1183" src="bgm03" volume="1."/><msg @l="1185" char_id="-1" frame_id="-1" name="" text="我已经……看不下去了。"   voices=""/><msg @l="1186" char_id="-1" frame_id="-1" name=""   text="之后，那些男人们继续肆意地发泄着欲望在玲身上。" voices=""/><msg @l="1187" char_id="-1" frame_id="-1" name=""   text="而她却依然默默地服从着那些男人们……继续着侍奉。" voices=""/><end_scene @l="1190"/><char @l="1193" id="miho" pos="auto" src="miho015"/><msg @l="1195" char_id="0" frame_id="1" name="美帆"   text="（这种事太奇怪了……是错误的啊………）" voices=""/><se @l="1198" buf="1" src="テニスコートをしきるフェンスの扉" volume="1."/><msg @l="1200" char_id="-1" frame_id="-1" name="男会员A" text="『啊，会长！』"   voices=""/><msg @l="1202" char_id="-1" frame_id="-1" name="" text="我立刻看向了场馆入口。"   voices=""/><msg @l="1203" char_id="-1" frame_id="-1" name="" text="是稻庭学长。" voices=""/><clear @l="1206" class="char"/><char @l="1208" id="miho" pos="right" src="miho115"/><char @l="1210" id="inaba" pos="left" src="inaba050"/><msg @l="1212" char_id="0" frame_id="1" name="美帆" text="『学、学长！』" voices=""/><msg @l="1214" char_id="-1" frame_id="-1" name=""   text="我强行推开其他部员，跑到稻庭学长面前。" voices=""/><msg @l="1215" char_id="-1" frame_id="-1" name="" text="学长轻轻抓住了我的肩膀。"   voices=""/><msg @l="1217" char_id="-1" frame_id="-1" name="稻庭" text="『冷静点，仲根同学。』"   voices=""/><msg @l="1219" char_id="-1" frame_id="-1" name=""   text="站在我面前的确实是平常的稻庭学长。" voices=""/><char @l="1222" id="miho" pos="right" src="miho015"/><msg @l="1224" char_id="0" frame_id="1" name="美帆"   text="『玲、玲小姐……白石学姐，被大家做了过分的事，然、然后……』" voices=""/><clear @l="1227" class="char"/><char @l="1229" id="inaba" pos="auto" src="inaba050"/><msg @l="1231" char_id="-1" frame_id="-1" name="稻庭" text="『玲……。』" voices=""/><msg @l="1233" char_id="1" frame_id="-1" name="玲"   text="『咳咳……稻、稻庭先生，这到底是……。』" voices=""/><msg @l="1235" char_id="-1" frame_id="-1" name=""   text="玲小姐一边从嘴里吐出精液一边摇摇晃晃地站了起来。" voices=""/><msg @l="1237" char_id="-1" frame_id="-1" name="稻庭"   text="『玲，没想到会变成这样。』" voices=""/><msg @l="1239" char_id="1" frame_id="-1" name="玲" text="『稻庭先生……。』" voices=""/><stopbgm @l="1243" fadeout="1000"/><char @l="1246" id="inaba" pos="auto" src="inaba058"/><msg @l="1248" char_id="-1" frame_id="-1" name="稻庭"   text="『如果不多管闲事的话就不会遭这种罪了啊。』" voices=""/><msg @l="1251" char_id="-1" frame_id="-1" name=""   text="一瞬间稻庭学长的眼睛闪过可疑的光芒，表情变得凶恶起来。" voices=""/><msg @l="1252" char_id="-1" frame_id="-1" name=""   text="那个……和刚才看到的完全一样。" voices=""/><bgm @l="1256" src="bgm13" volume="1."/><flash @l="1259" count="4" fade="100" image="white"/><se @l="1261" buf="1" src="箱を蹴ってる" volume="1."/><shake @l="1263" amp="10" class="all" cycle="30" duration="500"   type="random"/><msg @l="1265" char_id="-1" frame_id="-1" name="" text="咚！" voices=""/><msg @l="1267" char_id="1" frame_id="-1" name="玲" text="『呃啊啊！』" voices=""/><msg @l="1269" char_id="-1" frame_id="-1" name=""   text="稻庭学长踢中了玲小姐的心窝位置，被击飞的玲小姐一边吐出胃液和精液一边滚倒在地。" voices=""/><clear @l="1272" class="char"/><char @l="1274" id="miho" pos="right" src="miho115"/><char @l="1276" id="inaba" pos="left" src="inaba058"/><msg @l="1278" char_id="0" frame_id="1" name="美帆"   text="『玲、玲小姐！？稻庭学长，您在做什么啊！』" voices=""/><msg @l="1280" char_id="-1" frame_id="-1" name="稻庭"   text="『都怪玲啊！都是因为你看到了我们社团的地下活动！』" voices=""/><char @l="1283" id="miho" pos="right" src="miho015"/><msg @l="1285" char_id="0" frame_id="1" name="美帆"   text="『这、这到底是怎么回事啊？』" voices=""/><msg @l="1287" char_id="-1" frame_id="-1" name="声音" text="『哎呀哎呀，这可不行啊。』"   voices=""/><msg @l="1289" char_id="-1" frame_id="-1" name="稻庭" text="『熊野……先生。』"   voices=""/><clear @l="1292" class="char"/><char @l="1294" id="kuma" pos="auto" src="kuma012"/><msg @l="1296" char_id="-1" frame_id="-1" name=""   text="我惊讶地回头看，发现工友……好像是叫熊野先生的人站在那里。" voices=""/><clear @l="1298" class="char"/><char @l="1300" id="kuma" pos="right" src="kuma012"/><char @l="1302" id="inaba" pos="left" src="inaba057"/><msg @l="1304" char_id="-1" frame_id="-1" name=""   text="熊野先生将几片药片交给稻庭学长，学长一口气吞了下去。" voices=""/><msg @l="1305" char_id="-1" frame_id="-1" name=""   text="过了一会儿，刚才还呼吸急促的学长完全恢复了冷静，不知不觉中又回到了平时的表情。" voices=""/><stopbgm @l="1308" fadeout="1000"/><clear @l="1311" class="char"/><char @l="1313" id="inaba" pos="auto" src="inaba050"/><msg @l="1315" char_id="0" frame_id="1" name="美帆" text="『……。』" voices=""/><bgm @l="1318" src="bgm16" volume="1."/><msg @l="1320" char_id="-1" frame_id="-1" name="稻庭"   text="『我虽然想过总有一天可能会暴露……但是，忘记了仲根同学是玲的室友这件事是我的失误。』"   voices=""/><clear @l="1323" class="char"/><char @l="1325" id="inaba" pos="left" src="inaba050"/><char @l="1327" id="miho" pos="right" src="miho115"/><msg @l="1329" char_id="0" frame_id="1" name="美帆"   text="『稻庭学长，什么是地下社团活动啊？』" voices=""/><msg @l="1331" char_id="-1" frame_id="-1" name="稻庭" text="『说来话长……』"   voices=""/><msg @l="1333" char_id="0" frame_id="1" name="美帆" text="『我不介意！』" voices=""/><char @l="1336" id="kuma" pos="left" src="kuma012"/><msg @l="1338" char_id="-1" frame_id="-1" name="熊野"   text="『站着说话也不是办法，不如坐在那里一边看表演一边聊聊如何？』" voices=""/><char @l="1341" id="miho" pos="right" src="miho015"/><msg @l="1343" char_id="0" frame_id="1" name="美帆" text="『表演？』" voices=""/><char @l="1346" id="inaba" pos="left" src="inaba050"/><msg @l="1348" char_id="-1" frame_id="-1" name="稻庭" text="『也好，就这样吧。』"   voices=""/><clear @l="1351" class="char"/><wait @l="1353" time="600"/><msg @l="1355" char_id="-1" frame_id="-1" name=""   text="稻庭说完给了个信号，社团成员们从部室楼带来了几个裸体的女孩。" voices=""/><msg @l="1357" char_id="-1" frame_id="-1" name="男会员A"   text="『会长，可以开始了吗？』" voices=""/><msg @l="1359" char_id="-1" frame_id="-1" name=""   text="仔细一看，被带来的女孩们全都是在脱衣网球中输掉的人。" voices=""/><msg @l="1360" char_id="-1" frame_id="-1" name=""   text="其中当然也有和我对战过的铃木小姐的身影。" voices=""/><msg @l="1361" char_id="-1" frame_id="-1" name=""   text="昏迷不醒的铃木小姐的大腿上，隐约可见血迹的痕迹。" voices=""/><msg @l="1363" char_id="-1" frame_id="-1" name="男会员B"   text="『呵呵呵，会长，您觉得她们的滋味如何？』" voices=""/><char @l="1366" id="inaba" pos="auto" src="inaba050"/><msg @l="1368" char_id="-1" frame_id="-1" name="稻庭"   text="『没什么好说的，只有三个处女，这也太不像话了。』" voices=""/><msg @l="1370" char_id="-1" frame_id="-1" name="男会员C" text="『真是令人遗憾。』"   voices=""/><msg @l="1372" char_id="-1" frame_id="-1" name="稻庭"   text="『这就是宽松教育的弊端啊。』" voices=""/><msg @l="1374" char_id="-1" frame_id="-1" name="男会员D"   text="『不愧是会长，真有见识。』" voices=""/><msg @l="1376" char_id="-1" frame_id="-1" name=""   text="男生们边说着，开始围住蜷缩在地上的女生们。" voices=""/><msg @l="1377" char_id="-1" frame_id="-1" name="男会员E"   text="『你们这些败者，就用我们的肉拍子来惩罚你们。』" voices=""/><msg @l="1379" char_id="-1" frame_id="-1" name=""   text="学长从后面抱着我坐在长椅上，示意我和他一起观看这一幕。" voices=""/><clear @l="1382" class="char"/><char @l="1385" id="inaba" pos="left" src="inaba050"/><char @l="1387" id="miho" pos="right" src="miho115"/><msg @l="1389" char_id="0" frame_id="1" name="美帆" text="『请住手！』"   voices=""/><msg @l="1391" char_id="-1" frame_id="-1" name=""   text="稻庭学长抓住了我想要转开的下巴，强行让我面向那些女孩子的方向。" voices=""/><msg @l="1392" char_id="-1" frame_id="-1" name=""   text="我被用力固定住，感觉如果反抗的话脖子可能会被折断，我已经快没有反抗的气力了。" voices=""/><stopbgm @l="1395" fadeout="1000"/><msg @l="1397" char_id="-1" frame_id="-1" name="稻庭"   text="『我之前跟你说过吧，我小时候身体很弱。』" voices=""/><char @l="1400" id="miho" pos="right" src="miho114"/><bgm @l="1403" src="bgm09" volume="1."/><msg @l="1405" char_id="0" frame_id="1" name="美帆" text="『是、是的……』" voices=""/><msg @l="1407" char_id="-1" frame_id="-1" name=""   text="面对这意外的开场白，我一时愣住了。" voices=""/><msg @l="1408" char_id="-1" frame_id="-1" name="" text="这个人到底想说什么呢。"   voices=""/><msg @l="1410" char_id="-1" frame_id="-1" name="稻庭"   text="『于是为了静养，我来到了这个城镇……当时还是村子吧……我家的别墅，但是当时恢复的可能性几乎为零。』"   voices=""/><msg @l="1412" char_id="-1" frame_id="-1" name="稻庭"   text="『就在那时，这个城镇的大黑制药研究所找上门来，问我是否愿意成为某种新药的实验对象。』" voices=""/><clear @l="1415" class="all"/><msg @l="1417" char_id="-1" frame_id="-1" name="" text="我很了解大黑制药。"   voices=""/><msg @l="1418" char_id="-1" frame_id="-1" name=""   text="不仅因为它是大企业，更重要的是因为那是父亲的工作单位。" voices=""/><msg @l="1419" char_id="-1" frame_id="-1" name=""   text="父亲也在研究所工作，但我从未听说过这个城镇有研究所。" voices=""/><msg @l="1420" char_id="-1" frame_id="-1" name="" text="搬家的时候也没人告诉过我。"   voices=""/><wait_chgmv/><bg @l="1424" src="bg13"/><char @l="1427" id="inaba" pos="left" src="inaba050"/><char @l="1429" id="miho" pos="right" src="miho115"/><msg @l="1432" char_id="-1" frame_id="-1" name="稻庭"   text="『绝望中的父母立刻抓住了这个机会，结果，我的身体奇迹般地恢复了。』" voices=""/><msg @l="1434" char_id="-1" frame_id="-1" name="稻庭"   text="『不过，那药有副作用。一个是必须持续服用，另一个是……难以控制自己的情绪，尤其是性欲。』"   voices=""/><char @l="1437" id="miho" pos="right" src="miho015"/><msg @l="1439" char_id="0" frame_id="1" name="美帆" text="『所以你才会做这种事……』"   voices=""/><msg @l="1441" char_id="-1" frame_id="-1" name="稻庭"   text="『控制情绪可以通过训练，但抑制性欲却很困难。不过，在强奸俱乐部里获取女性很容易，而且疯狂做爱也没人会起疑心。』"   voices=""/><msg @l="1443" char_id="0" frame_id="1" name="美帆" text="『为、为了这种事……』"   voices=""/><char @l="1446" id="kuma" pos="right" src="kuma012"/><msg @l="1448" char_id="-1" frame_id="-1" name="熊野"   text="『当然不仅仅是为了这个原因哦。』" voices=""/><msg @l="1450" char_id="-1" frame_id="-1" name="" text="突然，熊野女士插话进来。"   voices=""/><msg @l="1452" char_id="-1" frame_id="-1" name="稻庭"   text="『熊野女士是我成为试验者时研究所里的负责人，现在也一直为我提供药物。』" voices=""/><msg @l="1454" char_id="-1" frame_id="-1" name="" text="这个人是……？" voices=""/><msg @l="1455" char_id="-1" frame_id="-1" name=""   text="但是，为什么这样的人会在大学当个杂工呢。" voices=""/><msg @l="1457" char_id="-1" frame_id="-1" name="熊野"   text="『你……知道制药公司至今仍未能实现的药物是什么吗？』" voices=""/><clear @l="1460" class="char"/><char @l="1463" id="kuma" pos="left" src="kuma012"/><char @l="1465" id="miho" pos="right" src="miho115"/><msg @l="1467" char_id="0" frame_id="1" name="美帆" text="『啊？癌症特效药之类的……。』"   voices=""/><msg @l="1469" char_id="-1" frame_id="-1" name="熊野"   text="『绝对不会被检测出的兴奋剂和安全可靠的勃起药物。如果能比其他公司先实现这些，肯定能创造巨大财富。为此我们才请稻庭先生帮忙的。』"   voices=""/><char @l="1472" id="miho" pos="right" src="miho114"/><msg @l="1474" char_id="0" frame_id="1" name="美帆" text="『这和稻庭学长有什么关系……啊！』"   voices=""/><msg @l="1476" char_id="-1" frame_id="-1" name="熊野"   text="『没错，稻庭先生是同时具备这两个条件的少数成功案例之一。』" voices=""/><char @l="1479" id="inaba" pos="left" src="inaba050"/><msg @l="1481" char_id="-1" frame_id="-1" name="稻庭"   text="『不过，要完善这些药物需要大量数据。因此，我把网球社改造成强奸社团，让成员们服用改良后的药物，告诉他们那是壮阳药、毒品之类的。』"   voices=""/><msg @l="1483" char_id="-1" frame_id="-1" name="稻庭" text="『结果……就和你现在看到的一样。』"   voices=""/><msg @l="1485" char_id="-1" frame_id="-1" name=""   text="环顾四周，男生们正全神贯注地侵犯着女生们。" voices=""/><msg @l="1486" char_id="-1" frame_id="-1" name=""   text="不管射精多少次都不会萎，眼前上演着不知何时才会结束的强奸秀。" voices=""/><char @l="1489" id="miho" pos="right" src="miho015"/><msg @l="1491" char_id="0" frame_id="1" name="美帆"   text="『啊……那、那么，玲小姐怎么样呢？玲小姐今天才第一次知道这件事。为什么呢？是因为稻庭学长喜欢玲小姐……所以到现在都没有对她出手吗？』"   voices=""/><msg @l="1493" char_id="-1" frame_id="-1" name="" text="我拼命地质问稻庭学长。"   voices=""/><msg @l="1494" char_id="-1" frame_id="-1" name=""   text="在这样的强奸社团里，玲小姐这样的美人不可能不被盯上。" voices=""/><msg @l="1495" char_id="-1" frame_id="-1" name=""   text="学长从长椅上站起来，向玲小姐走去。" voices=""/><clear @l="1498" class="char"/><char @l="1500" id="inaba" pos="left" src="inaba050"/><char @l="1502" id="rei" pos="right" src="rei055"/><msg @l="1504" char_id="1" frame_id="-1" name="玲" text="『稻庭先生……』" voices=""/><msg @l="1506" char_id="-1" frame_id="-1" name="稻庭"   text="『确实……玲从大学入学时起就是个引人注目的美人。但是，像她这样正义感强的女性拉入伙伴中风险太大。结果，这个在老师眼中评价好且同性信任的她只能被用作表面网球部的广告招牌罢了。』"   voices=""/><char @l="1509" id="miho" pos="left" src="miho015"/><msg @l="1511" char_id="0" frame_id="1" name="美帆" text="『这、这种……怎么会这样。』"   voices=""/><char @l="1514" id="inaba" pos="right" src="inaba050"/><msg @l="1516" char_id="-1" frame_id="-1" name="稻庭"   text="『而且啊，我只能在处女的子宫里得到满足……也就是说，我对玲这种被玷污的女人没兴趣。』" voices=""/><msg @l="1518" char_id="1" frame_id="-1" name="玲" text="『……！？』" voices=""/><msg @l="1520" char_id="-1" frame_id="-1" name="" text="玲小姐不由自主地低下头。"   voices=""/><msg @l="1521" char_id="-1" frame_id="-1" name=""   text="虽然头发遮住了表情，但能看到泪滴正滴落在地面上。" voices=""/><clear @l="1524" class="char"/><msg @l="1526" char_id="-1" frame_id="-1" name="男会员E"   text="『会长，差不多该出发了，否则二次聚会就要……』" voices=""/><msg @l="1528" char_id="-1" frame_id="-1" name=""   text="突然，一名男子走过来在稻庭学长耳边轻声说着。" voices=""/><clear @l="1531" class="char"/><char @l="1533" id="inaba" pos="center" src="inaba050f" y="-80"/><msg @l="1535" char_id="-1" frame_id="-1" name="稻庭" text="『喂喂，副会长，看看场合啊。』"   voices=""/><msg @l="1537" char_id="-1" frame_id="-1" name=""   text="学长伸出右臂，保持小指翘起的姿势，瞪着副会长。" voices=""/><msg @l="1538" char_id="-1" frame_id="-1" name="" text="虽然表情似乎在微笑，但眼神中却没有丝毫笑意。"   voices=""/><msg @l="1540" char_id="-1" frame_id="-1" name="男会员E"   text="『……失、失礼了！』" voices=""/><msg @l="1542" char_id="-1" frame_id="-1" name=""   text="副会长看了看学长又看了看我，好像察觉到了什么，匆忙跑开了。" voices=""/><clear @l="1544" class="char"/><char @l="1546" id="inaba" pos="auto" src="inaba050"/><msg @l="1548" char_id="-1" frame_id="-1" name="稻庭"   text="『对现在的我来说，比起二次聚会，眼前的你更重要啊。』" voices=""/><clear @l="1551" class="char"/><char @l="1553" id="inaba" pos="left" src="inaba050"/><char @l="1555" id="miho" pos="right" src="miho114"/><msg @l="1557" char_id="0" frame_id="1" name="美帆" text="『啊？』" voices=""/><msg @l="1559" char_id="0" frame_id="1" name="美帆" text="（这、这是什么……意思？）"   voices=""/><stopbgm @l="1562" fadeout="1000"/><msg @l="1564" char_id="-1" frame_id="-1" name="稻庭"   text="『我的欲望啊……如果不能品尝像你这样极品的处女，就无法得到满足，仲根美帆同学。』" voices=""/><msg @l="1566" char_id="0" frame_id="1" name="美帆" text="『啊啊！？』" voices=""/><bgm @l="1569" src="bgm08" volume="1."/><msg @l="1571" char_id="-1" frame_id="-1" name="" text="我发不出声音。"   voices=""/><msg @l="1572" char_id="-1" frame_id="-1" name=""   text="为什么，为什么这个人知道我是处女这件事。" voices=""/><msg @l="1574" char_id="-1" frame_id="-1" name="稻庭"   text="『你看起来很惊讶呢……对于已经让数百名处女失去第一次的我来说，分辨一个人是不是处女这种事简直轻而易举。』" voices=""/><msg @l="1576" char_id="-1" frame_id="-1" name="稻庭"   text="『从那天目睹你被朽木教授猥亵的那天起，我就一直在觊觎你的身体。而今天，终于可以如愿以偿了……』" voices=""/><char @l="1579" id="miho" pos="right" src="miho115"/><msg @l="1581" char_id="0" frame_id="1" name="美帆"   text="『不行，我不会让你如愿的。』" voices=""/><msg @l="1583" char_id="-1" frame_id="-1" name="稻庭"   text="『是吗，那就只能换玲来代替了。』" voices=""/><msg @l="1585" char_id="0" frame_id="1" name="美帆"   text="『但是，你不是说如果不是处女的话就不能满足吗……』" voices=""/><clear @l="1588" class="char"/><char @l="1590" id="inaba" pos="center" src="inaba050f" y="-80"/><msg @l="1592" char_id="-1" frame_id="-1" name="稻庭"   text="『确实如此。所以我……决定要了玲喉咙的第一次。』" voices=""/><msg @l="1594" char_id="-1" frame_id="-1" name=""   text="学长抓住蜷缩在地上的玲小姐的脖子将她提起来，强行把自己的肉棒插入她的喉咙深处。" voices=""/><wait_chgmv/><ev @l="1597" src="ev-015_1"/><msg @l="1599" char_id="1" frame_id="-1" name="玲" text="『唔咯！？……唔唔唔——！！』"   voices=""/><bgm @l="1602" src="bgm14" volume="1."/><msg @l="1604" char_id="-1" frame_id="-1" name="稻庭"   text="『像吸入更多空气那样扩张喉咙深处！』" voices=""/><msg @l="1606" char_id="1" frame_id="-1" name="玲" text="『呜咯！啊噶，呕咯哦！』"   voices=""/><msg @l="1608" char_id="-1" frame_id="-1" name="稻庭"   text="『哦哦……这就是玲的喉咙深处的触感啊！仅次于处女的阴道肉壁，太棒了！』" voices=""/><msg @l="1610" char_id="0" frame_id="1" name="美帆" text="『不，不要啊——！』"   voices=""/><msg @l="1612" char_id="-1" frame_id="-1" name=""   text="我拼命地喊叫着，但稻庭学长完全不看我这边，继续侵犯着玲小姐的喉咙。" voices=""/><msg @l="1614" char_id="1" frame_id="-1" name="玲" text="『呕啊！咳，啊啊！』"   voices=""/><msg @l="1616" char_id="-1" frame_id="-1" name="稻庭"   text="『对了，每次你发出声音时，你喉咙里的小肉球就会啪啪地拍打我的龟头，感觉太棒了！』" voices=""/><msg @l="1618" char_id="-1" frame_id="-1" name=""   text="学长完全不顾玲小姐的状况，肆无忌惮地享受着她喉咙的触感。" voices=""/><msg @l="1619" char_id="-1" frame_id="-1" name=""   text="亲眼目睹了这种我从未想象过的异常性行为，我的双腿不住地颤抖着。" voices=""/><stopbgm @l="1622" fadeout="1000"/><clear @l="1625" class="all"/><end_scene @l="1628"/><wait_chgmv/><bg @l="1631" src="bg13"/><bgm @l="1634" src="bgm03" volume="1."/><char @l="1638" id="miho" pos="auto" src="miho115"/><msg @l="1641" char_id="0" frame_id="1" name="美帆" text="『……。』" voices=""/><msg @l="1643" char_id="-1" frame_id="-1" name="" text="该怎么办……。"   voices=""/><msg @l="1644" char_id="-1" frame_id="-1" name=""   text="这样下去……这样下去玲小姐会死的！" voices=""/><goto @l="1647" cond="!(f.稲庭コーチflag&#32;==&#32;1)&#13;&#10;"   label="TempLabel_249"/><msg @l="1651" async="true" char_id="-1" frame_id="-1" name=""   text="要救玲小姐……？" voices=""/><select @l="1652"><menu @l="1656" label="EventLabel_93" text="救她"/><menu @l="1659" label="EventLabel_94" text="不救"/></select><goto @l="1667" label="TempLabel_250"/><label @l="1668" id="TempLabel_249"/><goto @l="1674" label="EventLabel_94"/><label @l="1677" id="TempLabel_250"/><label @l="1681" id="EventLabel_93"/><stopbgm @l="1686" fadeout="1000"/><char @l="1689" id="miho" pos="auto" src="miho015"/><msg @l="1691" char_id="0" frame_id="1" name="美帆" text="『我……我来代替玲小姐。』"   voices=""/><msg @l="1693" char_id="-1" frame_id="-1" name="稻庭" text="『什么？』" voices=""/><bgm @l="1697" src="bgm07" volume="1."/><msg @l="1699" char_id="1" frame_id="-1" name="玲" text="『咳咳！美帆……？』"   voices=""/><msg @l="1701" char_id="0" frame_id="1" name="美帆"   text="『我来代替玲小姐满足你。所以，请不要再做这种残忍的事了！』" voices=""/><stopbgm @l="1704" fadeout="1000"/><clear @l="1707" class="char"/><char @l="1709" id="inaba" pos="center" src="inaba050f" y="-80"/><msg @l="1711" char_id="-1" frame_id="-1" name="稻庭" text="『我正等着你这句话呢。』"   voices=""/><msg @l="1713" char_id="-1" frame_id="-1" name=""   text="刚才还专心侵犯着玲小姐喉咙的稻庭学长突然只把头转向了这边。" voices=""/><clear @l="1716" class="char"/><char @l="1718" id="miho" pos="auto" src="miho015"/><msg @l="1720" char_id="0" frame_id="1" name="美帆" text="『这、这是什么意思？』"   voices=""/><bgm @l="1723" src="bgm09" volume="1."/><msg @l="1725" char_id="-1" frame_id="-1" name="稻庭"   text="『我不喜欢强迫女性的行为。我一直在等你主动开口呢。』" voices=""/><char @l="1728" id="miho" pos="auto" src="miho115"/><msg @l="1730" char_id="0" frame_id="1" name="美帆"   text="『怎么会……你怎么能厚颜无耻地说这种话。』" voices=""/><msg @l="1732" char_id="-1" frame_id="-1" name="稻庭"   text="『啊，你是在说玲的事吗？她可是说过愿意被我抱的，也就是说这并不是强迫。』" voices=""/><msg @l="1734" char_id="1" frame_id="-1" name="玲" text="『唔唔——！』" voices=""/><msg @l="1736" char_id="-1" frame_id="-1" name=""   text="稻庭学长抓住玲小姐的头，前后猛烈地摆动。" voices=""/><msg @l="1737" char_id="-1" frame_id="-1" name=""   text="肉棒的前端在喉咙深处不断撞击，玲小姐痛苦地呻吟着。" voices=""/><msg @l="1739" char_id="0" frame_id="1" name="美帆" text="『住手！』" voices=""/><msg @l="1741" char_id="-1" frame_id="-1" name="稻庭"   text="『这就是说，你喜欢我，想被我侵犯……是这个意思没错吧？』" voices=""/><msg @l="1743" char_id="-1" frame_id="-1" name=""   text="确实，以前我应该是喜欢稻庭学长的。" voices=""/><msg @l="1744" char_id="-1" frame_id="-1" name=""   text="但现在，眼前的这个人只是披着稻庭学长外表的恶魔。" voices=""/><msg @l="1745" char_id="-1" frame_id="-1" name=""   text="想到要主动被这种男人侵犯的屈辱，我一瞬间别过了脸。" voices=""/><msg @l="1746" char_id="-1" frame_id="-1" name="稻庭" text="『不是吗？』"   voices=""/><msg @l="1748" char_id="-1" frame_id="-1" name=""   text="一边温柔地这么说着，稻庭学长一边堵住了玲小姐的鼻孔。" voices=""/><msg @l="1749" char_id="-1" frame_id="-1" name=""   text="口鼻同时被堵住，玲小姐浑身颤抖，开始抽搐。" voices=""/><msg @l="1750" char_id="-1" frame_id="-1" name=""   text="然而，她根本不可能战胜男人的力量，越是挣扎，体内的氧气就越快耗尽。" voices=""/><msg @l="1752" char_id="-1" frame_id="-1" name="稻庭"   text="『啊……真棒啊玲，你因为无法呼吸而整个口腔紧贴上来的感觉太棒了。』" voices=""/><char @l="1755" id="miho" pos="auto" src="miho015"/><msg @l="1757" char_id="0" frame_id="1" name="美帆"   text="『住手！请住手！我愿意被侵犯！我想被您侵犯！』" voices=""/><msg @l="1759" char_id="-1" frame_id="-1" name=""   text="稻庭学长松开了堵住玲鼻孔的手，玲小姐从鼻孔和眼角流着泪水，咳咳地大口喘着气。" voices=""/><clear @l="1762" class="char"/><char @l="1764" id="inaba" pos="center" src="inaba050f" y="-80"/><msg @l="1766" char_id="-1" frame_id="-1" name="稻庭" text="『也就是说，你想把处女之身献给我？』"   voices=""/><clear @l="1769" class="char"/><char @l="1771" id="miho" pos="auto" src="miho015"/><msg @l="1773" char_id="0" frame_id="1" name="美帆" text="『是、是的……我愿意献给您。』"   voices=""/><clear @l="1776" class="char"/><char @l="1778" id="inaba" pos="center" src="inaba050f" y="-80"/><msg @l="1780" char_id="-1" frame_id="-1" name="稻庭"   text="『你想被我的那话儿捅破处女膜是吗？』" voices=""/><clear @l="1783" class="char"/><char @l="1785" id="miho" pos="auto" src="miho015"/><msg @l="1787" char_id="0" frame_id="1" name="美帆"   text="『……是的，请……破掉……我的处女膜。』" voices=""/><msg @l="1789" char_id="1" frame_id="-1" name="玲" text="『美帆，别说傻话！美帆！』"   voices=""/><char @l="1792" id="miho" pos="auto" src="miho115"/><stopbgm @l="1795" fadeout="1000"/><msg @l="1797" char_id="0" frame_id="1" name="美帆" text="『玲小姐……』" voices=""/><bgm @l="1800" src="bgm07" volume="1."/><msg @l="1802" char_id="0" frame_id="1" name="美帆"   text="『玲小姐……您曾经和我说过关于妹妹的事情。我也慢慢地把您当成了真正的姐姐，所以我觉得在这种时候必须要帮助您……。』"   voices=""/><char @l="1805" id="miho" pos="auto" src="miho116"/><msg @l="1807" char_id="0" frame_id="1" name="美帆" text="『我的话……没关系的。』"   voices=""/><msg @l="1809" char_id="-1" frame_id="-1" name=""   text="我这样说着对玲小姐微笑，但恐怕我并没有笑得很好看……。" voices=""/><msg @l="1811" char_id="1" frame_id="-1" name="玲" text="『美帆……。』" voices=""/><stopbgm @l="1814" fadeout="1000"/><clear @l="1817" class="char"/><msg @l="1819" char_id="-1" frame_id="-1" name="稻庭" text="『玲，你已经没用了。』"   voices=""/><bgm @l="1822" src="bgm13" volume="1."/><msg @l="1824" char_id="-1" frame_id="-1" name=""   text="说完，稻庭学长粗暴地推开了玲小姐，朝着我这边走来。" voices=""/><msg @l="1825" char_id="-1" frame_id="-1" name=""   text="学长一口气嚼碎了好几片药片，全身的肌肉比刚才更加隆起，胯下的隆起也更加壮大。"   voices=""/><char @l="1828" id="inaba" pos="center" src="inaba058f" y="-80"/><msg @l="1830" char_id="-1" frame_id="-1" name="稻庭"   text="『啊哈哈哈哈！仲根同学，请用你的处女小穴来净化我那被非处女的口器弄脏的东西吧！』" voices=""/><clear @l="1833" class="char"/><char @l="1835" id="miho" pos="auto" src="miho015"/><msg @l="1837" char_id="0" frame_id="1" name="美帆" text="『呃，呃啊！』" voices=""/><clear @l="1840" class="char"/><msg @l="1842" char_id="-1" frame_id="-1" name=""   text="尽管我已经做好了心理准备，但当我直视学长那被疯狂扭曲的眼睛时，全身的力气都被抽空了，我瘫坐在了那里。" voices=""/><char @l="1845" id="inaba" pos="center" src="inaba058f" y="-80"/><msg @l="1847" char_id="-1" frame_id="-1" name="稻庭"   text="『好啊！那表情！那姿态！那肉体！我所追求的一切就在眼前！』" voices=""/><msg @l="1849" char_id="-1" frame_id="-1" name="稻庭" text="『啊哈哈哈哈哈哈！』"   voices=""/><stopbgm @l="1852" fadeout="1000"/><clear @l="1855" class="all"/><wait_chgmv/><bg @l="1859" src="bg13"/><flash @l="1864" count="4" fade="100" image="white"/><se @l="1866" buf="1" src="刃物刺す音1" volume="1."/><shake @l="1868" amp="10" class="all" cycle="30" duration="100"   type="random"/><msg @l="1870" char_id="-1" frame_id="-1" name="稻庭" text="『什…么？』"   voices=""/><wait_chgmv/><bg @l="1874" src="bg13"/><bgm @l="1879" src="bgm15" volume="1."/><msg @l="1881" char_id="-1" frame_id="-1" name=""   text="就在稻庭学长转身背对的那一瞬间，一记突如其来的袭击刺入了他的肋部。那是一把用来修剪树木的大剪刀，几乎整个刀柄都刺穿了学长的身体。"   voices=""/><char @l="1884" id="miho" pos="auto" src="miho015"/><msg @l="1886" char_id="0" frame_id="1" name="美帆" text="『玲小姐！？』" voices=""/><msg @l="1888" char_id="1" frame_id="-1" name="玲" text="『快逃！』" voices=""/><clear @l="1891" class="char"/><msg @l="1893" char_id="-1" frame_id="-1" name=""   text="在玲小姐的一声喝令下，我仿佛被推动一般，从那里跑了出去。" voices=""/><msg @l="1894" char_id="-1" frame_id="-1" name=""   text="我穿过球场围栏的门，急忙向外跑去。" voices=""/><msg @l="1895" char_id="-1" frame_id="-1" name=""   text="回头一看，稻庭学长的肋部正随着心脏的跳动汩汩地喷出鲜血。" voices=""/><msg @l="1896" char_id="-1" frame_id="-1" name=""   text="那是一道看起来无法救治的伤口……。" voices=""/><char @l="1899" id="kuma" pos="auto" src="kuma017"/><msg @l="1901" char_id="-1" frame_id="-1" name="熊野"   text="『你、你这女人！竟敢伤害我重要的实验体！！』" voices=""/><flash @l="1904" count="4" fade="100" image="white"/><shake @l="1906" amp="10" class="all" cycle="30" duration="100"   type="random"/><se @l="1908" buf="1" src="ムチの音" volume="1."/><msg @l="1910" char_id="-1" frame_id="-1" name="" text="啪！！" voices=""/><flash @l="1913" count="4" fade="100" image="white"/><msg @l="1915" char_id="1" frame_id="-1" name="玲" text="『呃啊！？』" voices=""/><msg @l="1917" char_id="-1" frame_id="-1" name=""   text="熊野勃然大怒，一巴掌抽在玲小姐脸上，玲小姐顿时如崩塌般倒在地上。" voices=""/><char @l="1919" id="miho" pos="auto" src="miho115"/><msg @l="1921" char_id="0" frame_id="1" name="美帆" text="『玲小姐！！』" voices=""/><char @l="1924" id="rei" pos="auto" src="rei055"/><msg @l="1926" char_id="1" frame_id="-1" name="玲" text="『……。』" voices=""/><char @l="1929" id="miho" pos="auto" src="miho114"/><msg @l="1931" char_id="0" frame_id="1" name="美帆" text="『玲小姐！！』" voices=""/><char @l="1934" id="rei" pos="auto" src="rei055"/><stopbgm @l="1937" fadeout="1000"/><msg @l="1939" char_id="1" frame_id="-1" name="玲" text="『美帆……对不起。』"   voices=""/><char @l="1942" id="miho" pos="auto" src="miho015"/><msg @l="1944" char_id="0" frame_id="1" name="美帆" text="『玲…小姐……？』" voices=""/><bgm @l="1947" src="bgm18" volume="1."/><msg @l="1949" char_id="1" frame_id="-1" name="玲"   text="『因为喜欢他……所以什么重要的事都看不见了。』" voices=""/><msg @l="1951" char_id="1" frame_id="-1" name="玲" text="『把你也卷进来了……对不起。』"   voices=""/><char @l="1954" id="miho" pos="auto" src="miho115"/><msg @l="1956" char_id="0" frame_id="1" name="美帆" text="『玲小姐……呜呜，玲小姐。』"   voices=""/><char @l="1959" id="rei" pos="auto" src="rei057"/><shake @l="1961" amp="10" class="all" cycle="30" duration="100"   type="random"/><msg @l="1963" char_id="1" frame_id="-1" name="玲" text="『快跑！！美帆！！！』"   voices=""/><msg @l="1965" char_id="-1" frame_id="-1" name=""   text="我听到玲小姐的一声厉喝，朝出口跑去。" voices=""/><wait @l="1968" time="600"/><char @l="1970" id="miho" pos="auto" src="miho014"/><msg @l="1972" char_id="0" frame_id="1" name="美帆" text="『玲小姐！？』" voices=""/><clear @l="1975" class="all"/><se @l="1977" buf="1" src="部室のドア閉まる" volume="1."/><msg @l="1979" char_id="-1" frame_id="-1" name="" text="我注意到声音回过头一看———。"   voices=""/><se @l="1982" buf="1" src="鍵を掛ける音" volume="1."/><msg @l="1984" char_id="-1" frame_id="-1" name=""   text="玲小姐用门上的挂锁锁上了门，然后把钥匙扔掉。" voices=""/><msg @l="1986" char_id="1" frame_id="-1" name="玲"   text="『这里我来拖住他……你快逃吧。』" voices=""/><msg @l="1988" char_id="0" frame_id="1" name="美帆"   text="『玲小姐，不行……这样太危险了！！』" voices=""/><msg @l="1990" char_id="1" frame_id="-1" name="玲" text="『快逃啊！！』"   voices=""/><msg @l="1992" char_id="0" frame_id="1" name="美帆" text="『可是！！！』" voices=""/><msg @l="1994" char_id="1" frame_id="-1" name="玲" text="『美帆─────。』"   voices=""/><msg @l="1996" char_id="1" frame_id="-1" name="玲"   text="『如果你把我当姐姐的话……就听我的话。』" voices=""/><msg @l="1998" char_id="1" frame_id="-1" name="玲"   text="『这是姐姐最后的……请求。』" voices=""/><msg @l="2000" char_id="1" frame_id="-1" name="玲"   text="『快走吧……然后一定要，逃出去……』" voices=""/><stopbgm @l="2003" fadeout="1000"/><msg @l="2005" char_id="1" frame_id="-1" name="玲" text="『我可爱的妹妹……美帆。』"   voices=""/><msg @l="2007" char_id="0" frame_id="1" name="美帆" text="『呜……』" voices=""/><msg @l="2009" char_id="-1" frame_id="-1" name="" text="我……拼命地跑了起来。"   voices=""/><msg @l="2010" char_id="-1" frame_id="-1" name="" text="跑到哪里去了，怎么跑的，我都记不得了。"   voices=""/><msg @l="2011" char_id="-1" frame_id="-1" name=""   text="总之为了尽快……逃得更远，我拼命地奔跑着。" voices=""/><msg @l="2012" char_id="-1" frame_id="-1" name="" text="这是……玲小姐的愿望。"   voices=""/><msg @l="2014" char_id="0" frame_id="1" name="美帆"   text="(这种……这种情况……玲小姐！！)" voices=""/><call @l="2018" target="EventLabel_146@root_tureend01"/><return @l="2019" value="0&#13;&#10;"/><label @l="2023" id="EventLabel_94"/><char @l="2027" id="miho" pos="auto" src="miho015"/><msg @l="2029" char_id="0" frame_id="1" name="美帆"   text="(我该怎么办……该怎么办……)" voices=""/><clear @l="2032" class="char"/><msg @l="2034" char_id="-1" frame_id="-1" name=""   text="我……用完全惊恐的眼神看着玲小姐和稻庭学长的行为。" voices=""/><msg @l="2035" char_id="-1" frame_id="-1" name=""   text="射精结束后，学长向这边走来。" voices=""/><msg @l="2036" char_id="-1" frame_id="-1" name=""   text="他的眼睛……仍然散发着诡异的光芒。" voices=""/><char @l="2039" id="inaba" pos="left" src="inaba050"/><msg @l="2041" char_id="-1" frame_id="-1" name="稻庭"   text="『来吧，仲根同学！先让你换上网球服吧。』" voices=""/><msg @l="2043" char_id="-1" frame_id="-1" name=""   text="稻庭学长说着，把网球服扔给了我。" voices=""/><char @l="2046" id="miho" pos="right" src="miho015"/><msg @l="2048" char_id="0" frame_id="1" name="美帆" text="『啊！？这是什么意思！？』"   voices=""/><msg @l="2050" char_id="-1" frame_id="-1" name="稻庭"   text="『你可以拒绝。如果你不介意玲遭遇更惨的话。』" voices=""/><msg @l="2052" char_id="0" frame_id="1" name="美帆"   text="『你、你还想干什么！？』" voices=""/><msg @l="2055" char_id="-1" frame_id="-1" name="稻庭"   text="『谁知道呢～。对我来说，不是处女的女人只是“废弃物”而已……会怎样完全看我心情吧。』" voices=""/><msg @l="2057" char_id="-1" frame_id="-1" name=""   text="稻庭学长说着，脸上浮现出残忍的笑容。" voices=""/><char @l="2060" id="miho" pos="right" src="miho115"/><msg @l="2062" char_id="0" frame_id="1" name="美帆" text="『这、这种事……』"   voices=""/><msg @l="2064" char_id="-1" frame_id="-1" name="稻庭"   text="『怎么样？穿吗？还是……。』" voices=""/><msg @l="2066" char_id="0" frame_id="1" name="美帆" text="『……唔……。』"   voices=""/><msg @l="2068" char_id="0" frame_id="1" name="美帆"   text="（这样下去玲小姐可能会被杀……我得想办法拖延时间……。）" voices=""/><char @l="2071" id="miho" pos="right" src="miho015"/><msg @l="2073" char_id="0" frame_id="1" name="美帆"   text="『为、为什么是网球服啊！？』" voices=""/><msg @l="2075" char_id="-1" frame_id="-1" name="稻庭"   text="『这还用说吗。我喜欢处女穿网球服的样子。』" voices=""/><msg @l="2076" char_id="-1" frame_id="-1" name="稻庭"   text="『我为此特意成立了网球社团……所以我希望仲根同学被我侵犯的时候也穿着网球服。』"   voices=""/><msg @l="2078" char_id="-1" frame_id="-1" name=""   text="稻庭学长说着，一边舔着嘴唇一边向我靠近。" voices=""/><char @l="2081" id="miho" pos="right" src="miho115"/><msg @l="2083" char_id="0" frame_id="1" name="美帆"   text="（不行……我不能再拖延了……只能换衣服了……。）" voices=""/><msg @l="2085" char_id="0" frame_id="1" name="美帆" text="『我、我知道了。』"   voices=""/><msg @l="2087" char_id="-1" frame_id="-1" name="稻庭"   text="『呵呵，仲根同学真是个好孩子呢。来，快点换衣服吧。』" voices=""/><msg @l="2089" char_id="0" frame_id="1" name="美帆" text="『…………。』"   voices=""/><msg @l="2091" char_id="-1" frame_id="-1" name="" text="稻庭学长听到我的话高兴地笑了起来。"   voices=""/><msg @l="2092" char_id="-1" frame_id="-1" name=""   text="总之我慢慢地更换着衣服，同时寄希望于有人会经过网球场来帮助我。" voices=""/><clear @l="2095" class="char"/><clear @l="2101" class="all"/><wait_chgmv/><bg @l="2104" src="bg13"/><char @l="2107" id="miho" pos="right" src="miho055"/><msg @l="2109" char_id="0" frame_id="1" name="美帆" text="『换、换好了。』"   voices=""/><msg @l="2111" char_id="-1" frame_id="-1" name=""   text="尽管我换得很慢，但最终还是没有人经过网球场，最后一丝希望也消失了。" voices=""/><msg @l="2112" char_id="-1" frame_id="-1" name=""   text="稻庭学长像是用眼睛舔舐一般，从上到下视奸着我换好的衣服，然后以一种抑制不住兴奋的样子靠近过来。" voices=""/><char @l="2115" id="inaba" pos="left" src="inaba057"/><msg @l="2117" char_id="-1" frame_id="-1" name="稻庭"   text="『哈、哈哈哈，来吧，让我享用你的处女之身吧！』" voices=""/><msg @l="2119" char_id="0" frame_id="1" name="美帆" text="『啊………！』"   voices=""/><msg @l="2121" char_id="-1" frame_id="-1" name=""   text="我稍微向后退了一步。就在那一瞬间，玲站到了稻庭学长的面前，挡住了他的去路。" voices=""/><char @l="2124" id="inaba" pos="left" src="inaba050"/><msg @l="2126" char_id="-1" frame_id="-1" name="稻庭" text="『嗯……？』"   voices=""/><char @l="2129" id="rei" pos="right" src="rei055"/><msg @l="2131" char_id="1" frame_id="-1" name="玲"   text="『求你了，请放过美帆吧，稻庭同学！』" voices=""/><char @l="2134" id="inaba" pos="left" src="inaba057"/><msg @l="2136" char_id="-1" frame_id="-1" name="稻庭" text="『吵死了！』"   voices=""/><msg @l="2138" char_id="-1" frame_id="-1" name=""   text="玲像是哀求般抓住他的裤子，试图阻止他，但稻庭学长一挥手臂就将她推开了。" voices=""/><flash @l="2141" count="4" fade="100" image="white"/><se @l="2143" buf="1" src="箱を蹴ってる" volume="1."/><shake @l="2145" amp="10" class="all" cycle="30" duration="100"   type="random"/><clear @l="2149" layer="rei"/><se @l="2152" buf="1" src="人とぶつかる音" volume="1."/><msg @l="2154" char_id="-1" frame_id="-1" name=""   text="她被推飞出去，重重地撞在了围栏上。" voices=""/><msg @l="2156" char_id="1" frame_id="-1" name="玲" text="『稻庭…先…生？』"   voices=""/><msg @l="2158" char_id="-1" frame_id="-1" name="稻庭" text="『碍事。』" voices=""/><msg @l="2160" char_id="1" frame_id="-1" name="玲" text="『……！？』" voices=""/><msg @l="2162" char_id="-1" frame_id="-1" name=""   text="听到稻庭学长的话，玲小姐瞪大了双眼，僵在了原地。" voices=""/><msg @l="2163" char_id="-1" frame_id="-1" name=""   text="那是一句令人如此……震惊的话语。" voices=""/><clear @l="2166" class="char"/><char @l="2168" id="inaba" pos="auto" src="inaba050"/><msg @l="2170" char_id="-1" frame_id="-1" name="稻庭" text="『…………。』" voices=""/><msg @l="2172" char_id="-1" frame_id="-1" name=""   text="接着，稻庭学长兴高采烈地迈着步子，向我走了过来。" voices=""/><clear @l="2175" class="char"/><char @l="2177" id="inaba" pos="left" src="inaba050"/><char @l="2179" id="miho" pos="right" src="miho055"/><msg @l="2181" char_id="0" frame_id="1" name="美帆" text="『稻庭学长………？』"   voices=""/><msg @l="2183" char_id="-1" frame_id="-1" name="稻庭" text="『找到了……。』"   voices=""/><char @l="2186" id="inaba" pos="left" src="inaba058"/><msg @l="2188" char_id="-1" frame_id="-1" name="稻庭"   text="『哈、哈哈哈，找到了………我找到了我一直在寻找的东西！』" voices=""/><clear @l="2191" class="char"/><msg @l="2193" char_id="-1" frame_id="-1" name=""   text="稻庭学长说完，突然抱住了我。" voices=""/><char @l="2196" id="miho" pos="auto" src="miho054"/><msg @l="2198" char_id="0" frame_id="1" name="美帆" text="『诶……干、干什么！？』"   voices=""/><se @l="2201" buf="1" src="人とぶつかる音軽め" volume="1."/><msg @l="2202" char_id="-1" frame_id="-1" name="" text="咔嚓" voices=""/><msg @l="2204" char_id="-1" frame_id="-1" name=""   text="在我还没说完最后一句话时，稻庭学长用手刀敲击了我的后颈。我的——意识逐渐沉入黑暗。" voices=""/><stopbgm @l="2207" fadeout="1000"/><clear @l="2211" class="all"/><msgshow @l="2213" show="true"/><msg @l="2215" char_id="0" frame_id="1" name="美帆" text="『嗯、嗯嗯……。』"   voices=""/><msg @l="2217" char_id="-1" frame_id="-1" name="" text="似乎听到附近有声音……。"   voices=""/><msg @l="2218" char_id="-1" frame_id="-1" name="" text="到底是什么声音呢……。"   voices=""/><msg @l="2220" char_id="-1" frame_id="-1" name="稻庭" text="『………找到………。』"   voices=""/><msg @l="2222" char_id="-1" frame_id="-1" name="稻庭" text="『……找…到了………。』"   voices=""/><msg @l="2224" char_id="-1" frame_id="-1" name="" text="嗯……这声音，是稻庭学长………。"   voices=""/><msg @l="2225" char_id="-1" frame_id="-1" name="" text="说找到了………找到什么……………。"   voices=""/><msg @l="2226" char_id="-1" frame_id="-1" name="" text="诶……稻庭学长………！！"   voices=""/><msg @l="2227" char_id="-1" frame_id="-1" name="" text="为什么会在这里？" voices=""/><msg @l="2228" char_id="-1" frame_id="-1" name="" text="这么想的瞬间我醒了过来。"   voices=""/><msg @l="2229" char_id="-1" frame_id="-1" name="" text="然后当我睁开眼睛时———。"   voices=""/><wait_chgmv/><bg @l="2233" src="bg14a"/><msg @l="2235" char_id="-1" frame_id="-1" name="稻庭"   text="『终于找到了。再也不会放手…………这是我的东西！！』" voices=""/><msg @l="2237" char_id="0" frame_id="1" name="美帆" text="『诶！？ 啊啊啊！？』"   voices=""/><eval @l="2240" expr="f.稲庭ルート即席flag&#32;=&#32;1&#13;&#10;"/><label @l="2244" id="chart_line58"/><call @l="2248" target="EventLabel_98@root_inaba_c_ev01"/><return @l="2249" value="0&#13;&#10;"/><clear @l="2253" class="all"/><wait_chgmv/><bg @l="2258" src="bg13"/><bgm @l="2261" src="bgm03" volume="1."/><msg @l="2263" char_id="0" frame_id="1" name="美帆" text="『嗯……。』" voices=""/><msg @l="2265" char_id="0" frame_id="1" name="美帆" text="『咦………我…………。』"   voices=""/><msg @l="2267" char_id="-1" frame_id="-1" name="" text="醒来的地方是……社团活动室里。"   voices=""/><msg @l="2268" char_id="-1" frame_id="-1" name=""   text="正当我想松一口气，心想刚才发生的一切是否都是一场梦时，我的视线中映入了无力横躺着的稻庭学长的身影。"   voices=""/><bgm @l="2272" src="bgm17" volume="1."/><msg @l="2274" char_id="0" frame_id="1" name="美帆" text="『学、学长！？』"   voices=""/><msg @l="2276" char_id="-1" frame_id="-1" name=""   text="我直起身，想要爬到学长身边。" voices=""/><msg @l="2277" char_id="-1" frame_id="-1" name="" text="就在那一刻，我的下腹部感到一阵钝痛。"   voices=""/><msg @l="2278" char_id="-1" frame_id="-1" name=""   text="当我看向疼痛的地方时……在我的双腿之间到大腿处沾满了暗红色的血迹。" voices=""/><msg @l="2279" char_id="-1" frame_id="-1" name="" text="果然……这不是什么梦。"   voices=""/><msg @l="2281" char_id="0" frame_id="1" name="美帆"   text="『学长，您没事吧……稻庭学长！』" voices=""/><msg @l="2283" char_id="-1" frame_id="-1" name="稻庭" text="『…………。』"   voices=""/><msg @l="2285" char_id="-1" frame_id="-1" name=""   text="稻庭学长对我的呼唤完全没有反应的迹象。" voices=""/><msg @l="2286" char_id="-1" frame_id="-1" name=""   text="是学长服用的那种药物导致的吗？" voices=""/><char @l="2290" id="kuma" pos="auto" src="kuma010"/><msg @l="2292" char_id="-1" frame_id="-1" name="熊野"   text="『居然担心刚才粗暴侵犯了你自己的男人，真是令人钦佩的善良啊。』" voices=""/><msg @l="2294" char_id="-1" frame_id="-1" name="" text="熊野小姐突然出现了。"   voices=""/><msg @l="2295" char_id="-1" frame_id="-1" name=""   text="与之前相比，她的语气完全改变了，可能正因如此，整体氛围也显得粗暴起来。" voices=""/><msg @l="2297" char_id="0" frame_id="1" name="美帆"   text="『他……学长在某种意义上也是受害者啊。』" voices=""/><msg @l="2299" char_id="-1" frame_id="-1" name="熊野"   text="『真是了不起的伪善啊。这个男人在你不知道的地方，已经帮助陷害了无数女性。即使是因为药物的副作用，也不是可以被原谅的事情。』"   voices=""/><msg @l="2301" char_id="-1" frame_id="-1" name="熊野"   text="『不过，对你们来说他就这样死掉岂不是更方便吗？』" voices=""/><msg @l="2303" char_id="0" frame_id="1" name="美帆"   text="『怎……怎么会……稻庭学长……死……。』" voices=""/><msg @l="2305" char_id="-1" frame_id="-1" name="熊野"   text="『放心吧，他只是处于假死状态罢了……是药物的反作用。他之前不是说过吗？如果不持续服药就会变成这样。』"   voices=""/><msg @l="2307" char_id="-1" frame_id="-1" name="熊野"   text="『以前他从不会忘记，唯独这次因为专注于侵犯你而忘记了……真是了不起的肉体啊。』" voices=""/><msg @l="2309" char_id="-1" frame_id="-1" name=""   text="熊野一边咧嘴笑着，一边舔舐般地打量着我赤裸的身体。" voices=""/><msg @l="2311" char_id="0" frame_id="1" name="美帆"   text="『什……你在说什么啊！？怎么会……。』" voices=""/><msg @l="2313" char_id="-1" frame_id="-1" name="熊野"   text="『嘛……真相如何很快就会知道了。』" voices=""/><msg @l="2315" char_id="-1" frame_id="-1" name=""   text="熊野说完举起一只手，之前等候在部室外的男性部员们蜂拥而入。" voices=""/><msg @l="2316" char_id="-1" frame_id="-1" name=""   text="这些人刚才还在让玲服务。" voices=""/><msg @l="2317" char_id="-1" frame_id="-1" name=""   text="话说回来……部室里，看不到玲的身影。" voices=""/><msg @l="2319" char_id="0" frame_id="1" name="美帆" text="『你……你要做什么……？』"   voices=""/><msg @l="2321" char_id="-1" frame_id="-1" name="熊野"   text="『不愧是那个吃过几百个处女的稻庭所看中的，你确实拥有出色的肉体。』" voices=""/><msg @l="2323" char_id="-1" frame_id="-1" name="熊野"   text="『所以呢……我打算按照这个镇的规则，调教你成为最顶级的“镇上女性”。』" voices=""/><msg @l="2325" char_id="0" frame_id="1" name="美帆"   text="『镇的规则……调教是……？』" voices=""/><msg @l="2327" char_id="-1" frame_id="-1" name="熊野"   text="『问题真多啊……你已经无处可逃了。乖乖听从我的话就不会受苦。』" voices=""/><msg @l="2329" char_id="0" frame_id="1" name="美帆" text="『这、这种事……。』"   voices=""/><msg @l="2331" char_id="-1" frame_id="-1" name="熊野"   text="『对了……这些家伙都服用了改良自稻庭药物的新药。』" voices=""/><msg @l="2333" char_id="0" frame_id="1" name="美帆" text="『呃啊……！！』" voices=""/><msg @l="2335" char_id="-1" frame_id="-1" name=""   text="仔细看的话，这些男性部员全都一样，表情呆滞空洞。" voices=""/><msg @l="2337" char_id="-1" frame_id="-1" name="熊野"   text="『在让那个叫白石的女人口交的时候，这些家伙就有点不对劲了吧？那就是新药的影响。』" voices=""/><msg @l="2339" char_id="-1" frame_id="-1" name="熊野"   text="『这种新药和稻庭的不同，是专门为性行为调整的。』" voices=""/><msg @l="2341" char_id="-1" frame_id="-1" name="熊野"   text="『虽然不会强化肉体，但作为替代，精液中会含有媚药成分，是特制品。放心地被侵犯吧。』" voices=""/><msg @l="2343" char_id="0" frame_id="1" name="美帆" text="『这种事……呀啊！？』"   voices=""/><msg @l="2345" char_id="-1" frame_id="-1" name="男会员A" text="『………。』"   voices=""/><msg @l="2347" char_id="-1" frame_id="-1" name="男会员B" text="『………。』"   voices=""/><msg @l="2349" char_id="-1" frame_id="-1" name=""   text="我的双手分别被两侧的两名男性社团成员抓住。" voices=""/><msg @l="2351" char_id="-1" frame_id="-1" name="熊野"   text="『啊，我忘了说，他们刚被药物唤醒，性欲是普通人的几十倍。尽情地被蹂躏吧。』"   voices=""/><msg @l="2353" char_id="0" frame_id="1" name="美帆" text="『嘶……。』" voices=""/><msg @l="2355" char_id="0" frame_id="1" name="美帆"   text="『不要啊啊啊啊啊啊啊啊啊啊啊！！！』" voices=""/><clear @l="2361" class="all"/><call @l="2364" target="EventLabel_99@root_inaba_c_ev02"/><call @l="2367" target="EventLabel_49@ending11"/><return @l="2368" value="0&#13;&#10;"/><label @l="2373" id="EventLabel_95"/><msg @l="2375" char_id="0" frame_id="1" name="美帆" text="（这条路线应该是左边才对！）"   voices="miho05500"/><msg @l="2377" char_id="-1" frame_id="-1" name=""   text="我开始朝着预测球会被打回来的方向跑去。" voices=""/><msg @l="2379" char_id="-1" frame_id="-1" name="铃木" text="『嘿！！』" voices=""/><se @l="2383" buf="1" src="テニスボール打つ音" volume="1."/><msg @l="2385" char_id="-1" frame_id="-1" name=""   text="可能是因为没能保持充分的姿势，球的力道不是很大。" voices=""/><msg @l="2387" char_id="-1" frame_id="-1" name=""   text="然而……被打回的球却朝着与我预测不同的方向飞去。" voices=""/><msg @l="2389" char_id="0" frame_id="1" name="美帆" text="『什……？』"   voices="miho05040"/><msg @l="2391" char_id="-1" frame_id="-1" name=""   text="我慌忙追赶球并伸出球拍，但球已经从我面前飞过去了。" voices=""/><msg @l="2393" char_id="0" frame_id="1" name="美帆" text="『唔啊……。』"   voices="miho05520"/><se @l="2397" buf="1" src="ホイッスル（テニス場）" volume="1."/><msg @l="2399" char_id="-1" frame_id="-1" name="女会员B" text="『比赛获胜者，铃木。』"   voices=""/><msg @l="2401" char_id="-1" frame_id="-1" name="" text="裁判无情的声音在球场上回响。"   voices=""/><msg @l="2403" char_id="0" frame_id="1" name="美帆" text="『啊，啊啊……。』"   voices="miho05560"/><msg @l="2405" char_id="-1" frame_id="-1" name="" text="伴随着颤抖的声音，我蹲在了原地。"   voices=""/><msg @l="2406" char_id="-1" frame_id="-1" name="" text="输了。" voices=""/><msg @l="2407" char_id="-1" frame_id="-1" name="" text="我……输了。"   voices=""/><msg @l="2408" char_id="-1" frame_id="-1" name=""   text="按照规则，我现在必须脱掉内裤。" voices=""/><msg @l="2409" char_id="-1" frame_id="-1" name="" text="怎么办……。" voices=""/><stopbgm @l="2412" fadeout="1000"/><msg @l="2414" char_id="-1" frame_id="-1" name="女会员A"   text="『至此，新生欢迎会圆满结束。』" voices=""/><msg @l="2416" char_id="0" frame_id="1" name="美帆" text="『诶？』"   voices="miho10030"/><msg @l="2418" char_id="-1" frame_id="-1" name="" text="女性前辈突然宣布结束。"   voices=""/><msg @l="2419" char_id="-1" frame_id="-1" name="" text="这到底是……。" voices=""/><msg @l="2421" char_id="-1" frame_id="-1" name="男会员B" text="『喂，这是怎么回事啊！』"   voices=""/><msg @l="2423" char_id="-1" frame_id="-1" name="女会员A"   text="『因为比赛意外地拖延了时间，我们必须赶紧去参加第二场聚会了。』" voices=""/><msg @l="2425" char_id="-1" frame_id="-1" name="女会员A"   text="『你们也最好快点，毕竟校舍的清场也不能一直拖着。』" voices=""/><msg @l="2427" char_id="-1" frame_id="-1" name="男会员B"   text="『这、这倒也是……喂，你快点穿上衣服吧。』" voices=""/><msg @l="2429" char_id="0" frame_id="1" name="美帆" text="『啊？』"   voices="miho10030"/><msg @l="2431" char_id="-1" frame_id="-1" name=""   text="事情发生得太突然，我一时愣住了，不过既然允许我穿上衣服，还是赶紧穿上比较好。" voices=""/><bgm @l="2434" src="bgm02" volume="1."/><wait_chgmv/><bg @l="2437" src="bg13"/><char @l="2440" id="miho" pos="auto" src="miho050"/><msg @l="2442" char_id="-1" frame_id="-1" name="男会员C"   text="『刚才你差点就赢了。虽然稻庭会长不在，但我们现在要举行一个失败者的遗憾会，你也过来吧。』"   voices=""/><msg @l="2444" char_id="0" frame_id="1" name="美帆" text="『啊，什么？』"   voices="miho12760"/><clear @l="2451" class="all"/><msg @l="2453" char_id="-1" frame_id="-1" name=""   text="被强行拉着手臂，我被带到了主赛场。虽然没能参加第二场聚会很遗憾，但给失败的孩子提供适当的关怀大概是稻庭前辈的方针吧。"   voices=""/><msg @l="2455" char_id="-1" frame_id="-1" name="男会员C" text="『好了，到了。』"   voices=""/><msg @l="2457" char_id="0" frame_id="1" name="美帆" text="『诶……诶诶！？』"   voices=""/><msg @l="2459" char_id="-1" frame_id="-1" name=""   text="我看到眼前发生的景象，顿时说不出话来。" voices=""/><stopbgm @l="2463" fadeout="1000"/><end_scene @l="2466"/><call @l="2470" target="EventLabel_96@root_inaba03"/><return @l="2471" value="0&#13;&#10;"/><return @l="2474" value=""/></code></xscript>																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																															