<?xml version="1.0" encoding="utf-8"?><xscript><debug editor="&quot;C:\Program&#32;Files&#32;(x86)\sakura\sakura.exe&quot;&#32;&quot;%src%&quot;&#32;-Y=%line%"   src="D:\シロップ\町ぐるみの罠＋汚された夏セット版\汚された夏\完成データ\汚された夏\script\text\root_kutuki01.txt"/><code><label @l="10" id="EventLabel_100"/><description @l="13" text="忧郁的契约"/><eval @l="15" expr="f.numDay=4&#13;&#10;"/><msgshow @l="17" show="false"/><wait_chgmv/><bg @l="19" src="day04" time="2000"/><wait @l="21" time="500"/><wait_chgmv/><bg @l="23" src="black" time="2000"/><msgshow @l="25" show="true"/><wait_chgmv/><bg @l="28" src="bg21m1"/><bgm @l="31" src="bgm03" volume="1."/><char @l="34" id="miho" pos="auto" src="miho115"/><msg @l="36" char_id="0" frame_id="-1" name="美帆" text="『……哈。』" voices=""/><msg @l="38" char_id="-1" frame_id="-1" name=""   text="我看着进站的有轨电车，微微叹了口气。" voices=""/><msg @l="39" char_id="-1" frame_id="-1" name="" text="这是个令人忧郁的早晨……" voices=""/><msg @l="40" char_id="-1" frame_id="-1" name=""   text="昨天……从朽木教授那里听说了父亲的事情后，我为了确认真相，在晚饭后给家里打了电话。" voices=""/><msg @l="41" char_id="-1" frame_id="-1" name=""   text="但我不可能直接问“爸爸要被裁员了吗？”这种话。" voices=""/><msg @l="42" char_id="-1" frame_id="-1" name=""   text="无奈之下，我只好在闲聊中委婉地询问最近有没有什么变化……但是没能问得很顺利。" voices=""/><msg @l="43" char_id="-1" frame_id="-1" name=""   text="基本上都是普通的日常闲聊，到最后甚至还被鼓励说“在陌生的地方要好好努力大学生活”之类的话。" voices=""/><clear @l="46" class="all"/><msg @l="48" char_id="0" frame_id="-1" name="美帆"   text="(呐，爸爸……我努力的话真的没问题吗……)" voices=""/><msg @l="50" char_id="0" frame_id="-1" name="美帆" text="(………真的吗……)"   voices=""/><msg @l="52" char_id="-1" frame_id="-1" name=""   text="在心里默念着这些抱怨的话语，我跟随前面的人走进了电车。" voices=""/><msg @l="53" char_id="-1" frame_id="-1" name=""   text="直达大学的首班电车依然拥挤，更加重了我忧郁的心情。" voices=""/><se @l="56" buf="3" loop="true" src="電車走行中" volume="1."/><wait_chgmv/><ev @l="59" src="ev-005"/><msg @l="61" char_id="0" frame_id="-1" name="美帆" text="(唉……)"   voices="miho06250"/><msg @l="63" char_id="0" frame_id="-1" name="美帆"   text="(事情怎么会变成这样呢……)" voices="miho06260"/><msg @l="65" char_id="-1" frame_id="-1" name=""   text="我靠在墙边，一个人忧郁地望着窗外的景色。" voices=""/><msg @l="66" char_id="-1" frame_id="-1" name=""   text="脑海中不断浮现的只有昨天与朽木教授的对话。" voices=""/><msg @l="68" char_id="0" frame_id="-1" name="美帆" text="(爸爸要被裁员……什么的)"   voices="miho06270"/><msg @l="70" char_id="0" frame_id="-1" name="美帆" text="(这种事，虽然不想相信……)"   voices="miho06280"/><msg @l="72" char_id="-1" frame_id="-1" name=""   text="因为经济不景气持续的缘故，很多公司的裁员增加了，这样的新闻在电视上看到过几次。" voices=""/><msg @l="73" char_id="-1" frame_id="-1" name=""   text="但是，在这种事降临到父亲身上之前……我并没有真实感受到。" voices=""/><msg @l="74" char_id="-1" frame_id="-1" name=""   text="老实说……之前一直以为这只是别人家的事。" voices=""/><msg @l="75" char_id="-1" frame_id="-1" name=""   text="但现在，这事却降临到了我们自己家。" voices=""/><msg @l="76" char_id="-1" frame_id="-1" name="" text="所以……我才会听从朽木教授的话。"   voices=""/><msg @l="78" char_id="0" frame_id="-1" name="美帆" text="(那种事……)"   voices="miho06290"/><msg @l="80" char_id="0" frame_id="-1" name="美帆"   text="(做出那样的约定……我……)" voices="miho06300"/><msg @l="82" char_id="-1" frame_id="-1" name=""   text="他为什么要提出那样的约定……我能想象得到。" voices=""/><msg @l="83" char_id="-1" frame_id="-1" name=""   text="只是……即便如此我别无选择，只能顺从他。" voices=""/><msg @l="84" char_id="-1" frame_id="-1" name=""   text="因为除此之外……没有其他救父亲的方法。" voices=""/><msg @l="86" char_id="0" frame_id="-1" name="美帆" text="(啊……)"   voices="miho06310"/><wait_chgmv/><ev @l="89" src="ev-005ax1"/><stopbgm @l="92" fadeout="1000"/><description @l="95" text="初次的巅峰"/><msg @l="97" char_id="-1" frame_id="-1" name=""   text="突然……臀部附近，感觉有人的手在蠕动。" voices=""/><msg @l="99" char_id="0" frame_id="-1" name="美帆" text="(痴汉……难、难道……？)"   voices="miho06320"/><msg @l="101" char_id="-1" frame_id="-1" name=""   text="我稍微扭转身体，看向站在正后方的乘客。" voices=""/><bgm @l="104" src="bgm15" volume="1."/><msg @l="106" char_id="0" frame_id="-1" name="美帆" text="『朽木……教授。』"   voices="miho06330"/><msg @l="108" char_id="-1" frame_id="-1" name="朽木" text="『哎呀，早上就见面真是巧啊。』"   voices=""/><msg @l="110" char_id="-1" frame_id="-1" name=""   text="朽木教授愉快地扭曲嘴角，在我耳边低语。" voices=""/><msg @l="111" char_id="-1" frame_id="-1" name=""   text="明明不是什么巧合……虽然这么想，但却说不出口。" voices=""/><msg @l="113" char_id="-1" frame_id="-1" name="朽木"   text="『请别露出这么不满的表情。这样的话，我会忍不住想要抛弃你的父亲的。』" voices=""/><msg @l="115" char_id="0" frame_id="-1" name="美帆" text="『……！』"   voices="miho06340"/><msg @l="117" char_id="-1" frame_id="-1" name="朽木" text="『呵呵……真是好表情，非常诱人。』"   voices=""/><msg @l="119" char_id="-1" frame_id="-1" name="" text="教授发自内心地愉悦地笑着。"   voices=""/><msg @l="121" char_id="-1" frame_id="-1" name="朽木"   text="『来吧，让我好好教教你在耻辱与屈辱之间摇摆的快感。』" voices=""/><wait_chgmv/><ev @l="124" src="ev-005ax2y1"/><msg @l="126" char_id="-1" frame_id="-1" name=""   text="说着，朽木教授用一只手猛地抓住了我的胸部。" voices=""/><msg @l="127" char_id="-1" frame_id="-1" name=""   text="突如其来的行为让我的身体不由自主地颤抖了一下。" voices=""/><msg @l="129" char_id="0" frame_id="-1" name="美帆" text="『嗯……』"   voices="miho06350"/><msg @l="131" char_id="-1" frame_id="-1" name=""   text="我不由自主地扭动身体试图反抗。" voices=""/><msg @l="132" char_id="-1" frame_id="-1" name="" text="但那只是一瞬间的事情……"   voices=""/><msg @l="133" char_id="-1" frame_id="-1" name=""   text="很快我就想起了朽木教授的话，乖乖地任由摆布。" voices=""/><msg @l="135" char_id="-1" frame_id="-1" name="朽木"   text="『呵呵呵，真高兴你还记得我们之间的约定。』" voices=""/><msg @l="137" char_id="0" frame_id="-1" name="美帆" text="『……。』"   voices="miho06360"/><msg @l="139" char_id="0" frame_id="-1" name="美帆"   text="『您真的会遵守约定吗？』" voices="miho06370"/><msg @l="141" char_id="0" frame_id="-1" name="美帆" text="『帮助我父亲……这件事。』"   voices="miho06380"/><msg @l="143" char_id="-1" frame_id="-1" name="朽木" text="『当然了。』"   voices=""/><msg @l="145" char_id="-1" frame_id="-1" name="朽木"   text="『昨晚我已经确认过朋友的研究室有空缺。』" voices=""/><msg @l="147" char_id="-1" frame_id="-1" name="朽木"   text="『只要你这样顺从，我不会亏待你的。』" voices=""/><msg @l="149" char_id="0" frame_id="-1" name="美帆" text="『…………。』"   voices="miho06390"/><msg @l="151" char_id="-1" frame_id="-1" name=""   text="朽木教授嘴角咧开得很大，他像是在享受形状优美的胸部的弹性一般，用手掌按压揉捏着。" voices=""/><msg @l="152" char_id="-1" frame_id="-1" name=""   text="他粗暴地抚摸着，交替地蹂躏着丰满的胸部。" voices=""/><msg @l="154" char_id="0" frame_id="-1" name="美帆" text="『………呜……。』"   voices="miho00430"/><msg @l="156" char_id="-1" frame_id="-1" name="朽木"   text="『除了我之外，到现在为止，你被多少男人揉过了？』" voices=""/><msg @l="158" char_id="-1" frame_id="-1" name=""   text="朽木教授就像是在确认自己得到的宝物是多么美妙一样，揉搓着胸部。" voices=""/><msg @l="160" char_id="0" frame_id="-1" name="美帆" text="『…………。』"   voices="miho01450"/><msg @l="162" char_id="-1" frame_id="-1" name=""   text="我对此感到屈辱，甚至无法回答。" voices=""/><msg @l="164" char_id="-1" frame_id="-1" name="朽木"   text="『如果不回答的话，我就要随心所欲地对待这对胸了。』" voices=""/><msg @l="166" char_id="-1" frame_id="-1" name=""   text="他不怀好意地笑了笑，熟练地开始解开我背后的胸罩扣子。" voices=""/><msg @l="167" char_id="-1" frame_id="-1" name=""   text="啪的一声，胸罩的搭扣被完美地解开，胸罩在衬衫内滑落，丰满的乳房顿时颤抖跳动起来。" voices=""/><msg @l="169" char_id="0" frame_id="-1" name="美帆" text="『…唔……。』"   voices="miho09930"/><msg @l="171" char_id="-1" frame_id="-1" name=""   text="那完美无瑕的胸部丘陵形状无可挑剔，可能是因为年轻而富有弹性，乳头骄傲地挺立着，即使隔着衬衫也能清晰地看出形状。"   voices=""/><msg @l="173" char_id="0" frame_id="-1" name="美帆" text="『啊……。』"   voices="miho06460"/><msg @l="175" char_id="-1" frame_id="-1" name=""   text="我意识到了这种状况，但没有任何反抗的方法，只能任他为所欲为。" voices=""/><msg @l="176" char_id="-1" frame_id="-1" name=""   text="然而，当朽木教授的另一只手的指尖抚摸我的大腿时，我不禁想要缩回腰部……" voices=""/><msg @l="178" char_id="0" frame_id="-1" name="美帆" text="『…………。』"   voices="miho09880"/><msg @l="180" char_id="-1" frame_id="-1" name=""   text="但这一次，我设法忍住了没有逃开。" voices=""/><msg @l="182" char_id="-1" frame_id="-1" name="朽木"   text="『对对，注意不要逃走。』" voices=""/><msg @l="184" char_id="-1" frame_id="-1" name="朽木"   text="『毕竟你父亲的毁灭可是取决于我的心情啊。』" voices=""/><msg @l="186" char_id="0" frame_id="-1" name="美帆"   text="『这一点我已经明白了……请不要说这么可怕的话。』" voices="miho06400"/><msg @l="187" char_id="-1" frame_id="-1" name="朽木" text="『哎呀，真是失礼了。』"   voices=""/><msg @l="189" char_id="-1" frame_id="-1" name="朽木"   text="『确实，用这种无趣的话题破坏美好时光可不好。』" voices=""/><msg @l="191" char_id="-1" frame_id="-1" name=""   text="教授并没有停下在我胸部游走的手。随着对胸部爱抚的加剧，尽管我试图忍耐，身体还是不由自主地缩了起来。"   voices=""/><msg @l="193" char_id="0" frame_id="-1" name="美帆" text="『……嗯啊……。』"   voices="miho00430"/><msg @l="195" char_id="-1" frame_id="-1" name=""   text="丰满的胸部如同揉捏橡皮球一般，在教授的手掌中弹性十足。" voices=""/><msg @l="196" char_id="-1" frame_id="-1" name=""   text="仿佛回应着这种行为，白色丘陵上那如草莓般鲜红的蓓蕾开始悸动。" voices=""/><msg @l="198" char_id="0" frame_id="-1" name="美帆" text="『……呀……啊啊……。』"   voices="miho01630"/><msg @l="200" char_id="-1" frame_id="-1" name="朽木"   text="『如果能直接触摸，那感觉会有多好啊。光是想象就令人愉悦。』" voices=""/><msg @l="202" char_id="0" frame_id="-1" name="美帆" text="『嗯嗯……。』"   voices="miho06410"/><msg @l="204" char_id="-1" frame_id="-1" name="" text="教授开始向下一个目标进攻。"   voices=""/><msg @l="205" char_id="-1" frame_id="-1" name=""   text="抚摸着双腿的指尖，逐渐侵入大腿内侧。" voices=""/><msg @l="206" char_id="-1" frame_id="-1" name=""   text="朽木教授的指尖在敏感的大腿内侧爬行，仿佛在确认那吸附般柔软的肌肤触感。" voices=""/><msg @l="208" char_id="0" frame_id="-1" name="美帆" text="『呀……嗯啊。』"   voices="miho06420"/><msg @l="210" char_id="-1" frame_id="-1" name=""   text="朽木教授一边缓慢地抚摸着靠近私处的大腿内侧，一边愉悦地观察着我的反应。" voices=""/><msg @l="212" char_id="-1" frame_id="-1" name="朽木"   text="『你真敏感，这种反应简直在勾引着男人呢。』" voices=""/><msg @l="214" char_id="0" frame_id="-1" name="美帆" text="『才没有那种事……嗯……。』"   voices="miho06430"/><msg @l="216" char_id="-1" frame_id="-1" name=""   text="每当指尖在敏感的大腿内侧爬行时，都会感觉像有虫子爬上来一样，一阵寒意袭来，背脊不禁颤抖。" voices=""/><msg @l="217" char_id="-1" frame_id="-1" name=""   text="然而，因为父亲的事情被他握住了把柄，我既不能推开他的手，也无法从这里逃脱。" voices=""/><msg @l="219" char_id="0" frame_id="-1" name="美帆"   text="(……到大学之前要忍耐……)" voices="miho06440"/><msg @l="221" char_id="-1" frame_id="-1" name="朽木"   text="『呵呵，你的腿不是在颤抖吗？』" voices=""/><msg @l="223" char_id="-1" frame_id="-1" name=""   text="在我耳边……近到能感受到他的吐息，教授低声耳语。" voices=""/><msg @l="225" char_id="0" frame_id="-1" name="美帆" text="『我、我才没有在颤抖……』"   voices="miho06450"/><msg @l="227" char_id="-1" frame_id="-1" name="朽木"   text="『呵呵，不用逞强……我马上就会把这颤抖，变成快感。』" voices=""/><msg @l="229" char_id="-1" frame_id="-1" name=""   text="朽木教授一边笑着，一边将在大腿内侧爬行的手指一下子推进到股间，隔着内裤揉弄起我的密穴。" voices=""/><wait_chgmv/><ev @l="232" src="ev-005ax3y2"/><msg @l="234" char_id="-1" frame_id="-1" name="" text="触碰。" voices=""/><msg @l="236" char_id="0" frame_id="-1" name="美帆" text="『啊……』"   voices="miho06460"/><msg @l="238" char_id="-1" frame_id="-1" name="" text="我的身体猛地颤抖了一下。"   voices=""/><msg @l="240" char_id="-1" frame_id="-1" name="朽木"   text="『你期待这个吗？ 期待被玩弄这里。』" voices=""/><msg @l="242" char_id="0" frame_id="-1" name="美帆" text="『我才没有……期待什么。』"   voices="miho06470"/><msg @l="244" char_id="-1" frame_id="-1" name="朽木"   text="『呵呵呵，我看你能嘴硬到什么时候。』" voices=""/><msg @l="246" char_id="-1" frame_id="-1" name="" text="揉，揉。" voices=""/><msg @l="248" char_id="0" frame_id="-1" name="美帆" text="『嗯……！』"   voices="miho06480"/><msg @l="250" char_id="-1" frame_id="-1" name=""   text="抵在私密缝隙的指尖，隔着内裤爱抚着缝隙。" voices=""/><msg @l="251" char_id="-1" frame_id="-1" name=""   text="丰满肥润的肉因羞耻而渗出汗水，内裤里面已经变得湿润。" voices=""/><wait_chgmv/><ev @l="254" src="ev-005ax2y1"/><msg @l="256" char_id="-1" frame_id="-1" name=""   text="一边抚摸着我的胸部，一边将头靠近到能感受到鼻息拂过颈部的程度，舌头轻舔着我的肌肤。" voices=""/><msg @l="257" char_id="-1" frame_id="-1" name="" text="嗯。" voices=""/><msg @l="259" char_id="0" frame_id="-1" name="美帆" text="『唔唔……。』"   voices="miho06490"/><msg @l="261" char_id="-1" frame_id="-1" name=""   text="我不由自主地绷紧身体，但不被允许反抗。" voices=""/><msg @l="262" char_id="-1" frame_id="-1" name=""   text="教授将唾液搅入我的耳朵，把耳道弄得黏糊糊的。" voices=""/><msg @l="264" char_id="-1" frame_id="-1" name="朽木"   text="『呵呵，你似乎也挺喜欢这样啊。』" voices=""/><msg @l="266" char_id="-1" frame_id="-1" name=""   text="教授嘴角吐出下流的言语，在我的耳朵之间拉出一座淫秽的唾液桥梁。" voices=""/><msg @l="267" char_id="-1" frame_id="-1" name=""   text="朽木教授隔着衣服肆无忌惮地揉捏着我丰满的乳房，我只能无助地看着。" voices=""/><msg @l="268" char_id="-1" frame_id="-1" name="" text="揉，捏，揉。"   voices=""/><msg @l="270" char_id="0" frame_id="-1" name="美帆" text="『……啊……。』"   voices="miho00840"/><msg @l="272" char_id="-1" frame_id="-1" name="朽木"   text="『真是美妙的身体。让我想就这样在这里侵犯你。』" voices=""/><msg @l="274" char_id="0" frame_id="-1" name="美帆" text="『不要……那，那样绝对不行……。』"   voices="miho06500"/><msg @l="276" char_id="-1" frame_id="-1" name="朽木" text="『哦？你敢违抗我吗？』"   voices=""/><msg @l="278" char_id="0" frame_id="-1" name="美帆"   text="『求，求您了……那件事……请放过我。』" voices="miho06510"/><msg @l="280" char_id="-1" frame_id="-1" name="朽木"   text="『嗯……好吧，今天就这样吧。』" voices=""/><msg @l="282" char_id="-1" frame_id="-1" name="朽木"   text="『现在就让我隔着衣服好好享受你的身体吧。』" voices=""/><wait_chgmv/><ev @l="285" src="ev-005ax3y2"/><msg @l="287" char_id="-1" frame_id="-1" name="" text="沙啦。" voices=""/><msg @l="288" char_id="-1" frame_id="-1" name=""   text="朽木教授说完，隔着内衣猛烈摩擦着我的私处缝隙，像是在确认女性器官的形状一般揉捏着。" voices=""/><msg @l="289" char_id="-1" frame_id="-1" name="" text="咕噜，咕啾。" voices=""/><msg @l="291" char_id="0" frame_id="-1" name="美帆" text="『嗯啊！』"   voices="miho00450"/><msg @l="293" char_id="-1" frame_id="-1" name="" text="力道不强不弱……"   voices=""/><msg @l="294" char_id="-1" frame_id="-1" name=""   text="以绝妙的触感摩擦着私处的指尖动作，渐渐唤起了我体内除了厌恶之外的“某种感觉”。" voices=""/><msg @l="296" char_id="0" frame_id="-1" name="美帆" text="『唔嗯……不，啊……。』"   voices="miho06520"/><msg @l="298" char_id="-1" frame_id="-1" name=""   text="对自己身体的变化……我感到困惑，不禁漏出甜腻的呻吟。" voices=""/><msg @l="299" char_id="-1" frame_id="-1" name=""   text="湿润……地，从秘穴深处渗出透明的淫液。" voices=""/><msg @l="301" char_id="-1" frame_id="-1" name="朽木" text="『哦呀……腰在颤抖吗？』"   voices=""/><msg @l="303" char_id="0" frame_id="-1" name="美帆" text="『……！』"   voices="miho06530"/><msg @l="305" char_id="-1" frame_id="-1" name="朽木"   text="『这里……是不是开始有感觉了呢？』" voices=""/><msg @l="307" char_id="0" frame_id="-1" name="美帆"   text="『才没有……那种，事……。』" voices="miho06540"/><msg @l="309" char_id="-1" frame_id="-1" name="朽木"   text="『呵呵，那为什么每当我的手指划过这里……你的腰就会这样颤抖呢？』" voices=""/><msg @l="311" char_id="0" frame_id="-1" name="美帆"   text="『因、因为恶心啊……被做这种事……怎么可能会有感觉。』" voices="miho06550"/><msg @l="313" char_id="-1" frame_id="-1" name="朽木"   text="『原来如此，那这里也会觉得恶心吗？』" voices=""/><msg @l="315" char_id="-1" frame_id="-1" name="" text="咕啾。" voices=""/><msg @l="316" char_id="-1" frame_id="-1" name=""   text="朽木教授说着，隔着内裤捏住了私处上方的突起。" voices=""/><msg @l="318" char_id="0" frame_id="-1" name="美帆" text="『啊……！？』"   voices="miho06560"/><msg @l="320" char_id="-1" frame_id="-1" name="朽木"   text="『到下一站还有充足的时间……我会好好享受的。』" voices=""/><wait_chgmv/><ev @l="323" src="ev-005ax3y2"/><msg @l="325" char_id="-1" frame_id="-1" name=""   text="他在我耳边低语着，然后隔着内裤捏住那颗像软糖一样硬的突起，开始轻轻揉搓。" voices=""/><wait_chgmv/><ev @l="328" src="ev-005ax2y1"/><msg @l="330" char_id="-1" frame_id="-1" name="" text="揉，揉。" voices=""/><msg @l="331" char_id="-1" frame_id="-1" name=""   text="另一只手的手指则在柔软的丘陵上游走，像是在确认其形状，将胸部揉成不同形状。" voices=""/><msg @l="332" char_id="-1" frame_id="-1" name="" text="搓，搓。" voices=""/><msg @l="333" char_id="-1" frame_id="-1" name=""   text="用揉捏丰满胸部的手指，找到了乳首，像是夹住它一样来回搓动。" voices=""/><msg @l="335" char_id="0" frame_id="-1" name="美帆" text="『嗯嗯……嗯，嗯！』"   voices="miho06570"/><msg @l="337" char_id="-1" frame_id="-1" name=""   text="我紧紧握住扶手，拼命压抑着不自觉发出的颤抖声音。" voices=""/><msg @l="338" char_id="-1" frame_id="-1" name="" text="也许有人会注意到。"   voices=""/><msg @l="339" char_id="-1" frame_id="-1" name="" text="也许会被人看见。"   voices=""/><msg @l="341" char_id="0" frame_id="-1" name="美帆" text="『嗯……呜……。』"   voices="miho06580"/><msg @l="343" char_id="-1" frame_id="-1" name="朽木"   text="『你真是拼命忍耐啊。是不是因为担心被人看见，所以拒绝坦率地感受这份快感呢？』"   voices=""/><msg @l="345" char_id="0" frame_id="-1" name="美帆"   text="『我、我才没有……感觉什么的……。』" voices="miho06590"/><wait_chgmv/><ev @l="348" src="ev-005ax3y2z2"/><msg @l="350" char_id="-1" frame_id="-1" name="" text="咕啾。" voices=""/><msg @l="352" char_id="0" frame_id="-1" name="美帆" text="『嗯嗯！！』"   voices="miho01670"/><msg @l="354" char_id="-1" frame_id="-1" name="朽木"   text="『呵呵，即使隔着内裤这里也已经湿润了，你还说没感觉？』" voices=""/><msg @l="356" char_id="0" frame_id="-1" name="美帆" text="『那、那是……。』"   voices="miho06600"/><msg @l="358" char_id="-1" frame_id="-1" name="朽木"   text="『还是说你即使没感觉也会让这里变湿？』" voices=""/><msg @l="360" char_id="-1" frame_id="-1" name=""   text="朽木教授就这样隔着内裤，如同拨开双层墙壁般将指尖压进了缝隙中。" voices=""/><msg @l="361" char_id="-1" frame_id="-1" name="" text="咕啾，咕啾。" voices=""/><msg @l="363" char_id="0" frame_id="-1" name="美帆" text="『嗯啊！！』"   voices="miho06610"/><msg @l="365" char_id="-1" frame_id="-1" name=""   text="啧啧……这淫靡的水声响起，我感觉自己都能察觉到，成熟内部溢出的蜜液渗透了内裤，逐渐扩散开来。"   voices=""/><msg @l="367" char_id="-1" frame_id="-1" name="朽木" text="『这已经泛滥成灾了啊。』"   voices=""/><msg @l="369" char_id="-1" frame_id="-1" name=""   text="他将被蜜液弄得亮晶晶、淫靡湿润的指尖在我眼前展示，拉出一丝细线，教授得意地笑了。" voices=""/><msg @l="370" char_id="-1" frame_id="-1" name=""   text="看到这一幕的我因为羞耻而满脸通红。" voices=""/><msg @l="372" char_id="-1" frame_id="-1" name="朽木" text="『还有，要不要告诉你一件好事？』"   voices=""/><msg @l="374" char_id="-1" frame_id="-1" name="朽木"   text="『你认为可能会被别人看到的想法是对的，已经有几个人注意到我们的痴汉游戏，从刚才开始一直在看着呢。』"   voices=""/><msg @l="376" char_id="0" frame_id="-1" name="美帆" text="『……唔……。』"   voices="miho06620"/><msg @l="378" char_id="-1" frame_id="-1" name=""   text="听到他的话，我猛然惊醒，环顾四周……确实，附近的几个男性正时不时地瞥向这边。" voices=""/><msg @l="380" char_id="0" frame_id="-1" name="美帆" text="『……～～唔……。』"   voices="miho06630"/><msg @l="382" char_id="-1" frame_id="-1" name=""   text="我一时语塞，为了避开视线深深地低下了头。" voices=""/><msg @l="383" char_id="-1" frame_id="-1" name="" text="我想逃走。" voices=""/><msg @l="384" char_id="-1" frame_id="-1" name=""   text="我多想立刻从这里跑开。" voices=""/><msg @l="385" char_id="-1" frame_id="-1" name=""   text="但是，我却做不到……。" voices=""/><msg @l="386" char_id="-1" frame_id="-1" name="" text="咕啾，咕啾，咕啾。"   voices=""/><msg @l="387" char_id="-1" frame_id="-1" name="" text="朽木教授的纠缠不休的痴汉行为仍在继续。"   voices=""/><msg @l="389" char_id="0" frame_id="-1" name="美帆" text="(被看……见了)"   voices="miho06640"/><msg @l="391" char_id="0" frame_id="-1" name="美帆"   text="(被痴汉骚扰而湿了的样子，被不认识的人看到了……)" voices="miho06650"/><msg @l="393" char_id="-1" frame_id="-1" name="" text="想到这里的瞬间，我的脑海变得一片空白。"   voices=""/><msg @l="394" char_id="-1" frame_id="-1" name=""   text="身体上不断被施加的刺激，趁着这个空隙……逐渐支配了我的心。" voices=""/><msg @l="396" char_id="-1" frame_id="-1" name="朽木"   text="『哦呀，你这里开始抽动了哦？』" voices=""/><msg @l="398" char_id="-1" frame_id="-1" name="" text="教授没有错过我的变化。"   voices=""/><msg @l="399" char_id="-1" frame_id="-1" name="" text="咕。" voices=""/><msg @l="401" char_id="0" frame_id="-1" name="美帆" text="『怎么会……啊啊！』"   voices="miho01710"/><msg @l="403" char_id="-1" frame_id="-1" name=""   text="当他隔着被羞耻的淫液浸湿的内裤摩擦我丰满的缝隙和阴蒂时，更多的爱液咕啾一声溢了出来。"   voices=""/><msg @l="405" char_id="0" frame_id="-1" name="美帆" text="『嗯呜……呀……。』"   voices="miho06660"/><msg @l="407" char_id="-1" frame_id="-1" name="朽木"   text="『原来如此，仲根同学知道自己被人看见了所以兴奋起来了啊。』" voices=""/><msg @l="409" char_id="0" frame_id="-1" name="美帆" text="『不，不是这样的……。』"   voices="miho06670"/><msg @l="411" char_id="-1" frame_id="-1" name="朽木"   text="『呵呵……那么，这是什么呢？』" voices=""/><msg @l="413" char_id="0" frame_id="-1" name="美帆" text="『啊……不要！』"   voices="miho06680"/><msg @l="415" char_id="-1" frame_id="-1" name="" text="咕啾。" voices=""/><msg @l="416" char_id="-1" frame_id="-1" name=""   text="教授的手指从内裤的缝隙中侵入，直接抚摸着被黏腻泉水湿润的缝隙。" voices=""/><msg @l="417" char_id="-1" frame_id="-1" name=""   text="当他用指尖将溢出花液的花瓣周围的花瓣推开时……从深处涌出了更多的蜜液。" voices=""/><msg @l="418" char_id="-1" frame_id="-1" name="" text="咕啾，咕啾。" voices=""/><msg @l="420" char_id="0" frame_id="-1" name="美帆" text="(啊……不行……要溢出来了)"   voices="miho01720"/><msg @l="422" char_id="-1" frame_id="-1" name="朽木"   text="『都湿成这样了……发出这么淫荡的水声……你真是个坏女孩啊。』" voices=""/><msg @l="424" char_id="0" frame_id="-1" name="美帆" text="『……呜啊……。』"   voices="miho06690"/><msg @l="426" char_id="-1" frame_id="-1" name=""   text="我发出了难以言喻的娇吟，为了逃离贴在耳边的教授的嘴唇，我转过了脸。" voices=""/><msg @l="428" char_id="-1" frame_id="-1" name="朽木"   text="『不管你怎么否认，身体总是诚实的。』" voices=""/><msg @l="430" char_id="-1" frame_id="-1" name="" text="咕啾。" voices=""/><msg @l="432" char_id="0" frame_id="-1" name="美帆" text="『不要……啊啊！』"   voices="miho01710"/><msg @l="434" char_id="-1" frame_id="-1" name=""   text="说着，他伴随着淫靡的水声，将手指更深地插入被爱液浸润的缝隙中。" voices=""/><msg @l="435" char_id="-1" frame_id="-1" name=""   text="每当插入花穴的指尖蠕动一次，就会发出咕啾咕啾的淫靡水声，想到这些声音可能被附近的乘客听到……我感觉腰都快要软了。"   voices=""/><msg @l="437" char_id="0" frame_id="-1" name="美帆" text="『嗯，啊……啊啊……。』"   voices="miho06700"/><msg @l="439" char_id="-1" frame_id="-1" name=""   text="每次被手指搅动秘处、阴蒂被拨弄，下腹部就一阵阵地发热。" voices=""/><msg @l="440" char_id="-1" frame_id="-1" name=""   text="我无法抵抗这种感觉……只能任其摆布。" voices=""/><msg @l="441" char_id="-1" frame_id="-1" name="" text="啧，啧，啧，啧。"   voices=""/><msg @l="443" char_id="0" frame_id="-1" name="美帆" text="『啊呜……嗯，嗯嗯………。』"   voices="miho06710"/><msg @l="445" char_id="-1" frame_id="-1" name=""   text="明明想要压抑住声音，却自然而然地漏了出来。" voices=""/><msg @l="446" char_id="-1" frame_id="-1" name=""   text="随着我的呻吟声，他的手指在我淫荡的中心部位更加激烈地抽插起来。" voices=""/><msg @l="447" char_id="-1" frame_id="-1" name=""   text="咕啾，咕啾，咕啾，咕啾，咕啾，咕啾。" voices=""/><msg @l="449" char_id="0" frame_id="-1" name="美帆"   text="『不行，不行……这样的话，嗯啊……。』" voices="miho06720"/><msg @l="451" char_id="-1" frame_id="-1" name="朽木" text="『这样的话，会怎么样呢？』"   voices=""/><msg @l="453" char_id="-1" frame_id="-1" name="" text="朽木教授的声音在我耳边响起。"   voices=""/><msg @l="454" char_id="-1" frame_id="-1" name=""   text="伴随着声音，他那带着中年男人特有气味的吐息喷在我身上，我不由自主地后仰身体，浑身颤抖。" voices=""/><msg @l="456" char_id="0" frame_id="-1" name="美帆"   text="『我、我会变奇怪的……再这样下去，我会变得不正常的……。』" voices="miho06730"/><msg @l="458" char_id="-1" frame_id="-1" name="朽木"   text="『呵呵……很好，就那样达到高潮吧。』" voices=""/><msg @l="460" char_id="-1" frame_id="-1" name=""   text="咕啾，咕啾，咕啾，咕啾，咕啾，咕啾。" voices=""/><msg @l="462" char_id="0" frame_id="-1" name="美帆"   text="『怎么会……啊，嗯嗯……啊啊………。』" voices="miho06740"/><msg @l="464" char_id="-1" frame_id="-1" name=""   text="我用仅存的一丝理智拼命地试图阻止自己加速达到高潮。" voices=""/><msg @l="465" char_id="-1" frame_id="-1" name=""   text="如果在这种电车里达到高潮的话……如果变成那样的话……。" voices=""/><msg @l="466" char_id="-1" frame_id="-1" name=""   text="这种想法越是膨胀，对高潮的欲望就越强烈……让我全身麻痹。" voices=""/><msg @l="468" char_id="-1" frame_id="-1" name="朽木" text="『这样子……还能忍耐住吗？』"   voices=""/><msg @l="470" char_id="-1" frame_id="-1" name="" text="咕哩，咕哩。" voices=""/><msg @l="472" char_id="0" frame_id="-1" name="美帆" text="『嗯嗯嗯！？』"   voices="miho06750"/><msg @l="474" char_id="-1" frame_id="-1" name=""   text="教授的手指开始直接激烈地揉动阴蒂。" voices=""/><msg @l="475" char_id="-1" frame_id="-1" name=""   text="用指腹摩擦、弹拨、挤压那变得火热坚硬勃起的小小尖塔。" voices=""/><msg @l="476" char_id="-1" frame_id="-1" name="" text="咕噜。" voices=""/><msg @l="477" char_id="-1" frame_id="-1" name=""   text="那一瞬间……足以轻易消灭仅存理智的强烈高潮，袭击了我。" voices=""/><msg @l="479" char_id="0" frame_id="-1" name="美帆" text="『嗯……嗯嗯嗯！！！』"   voices="miho06760"/><msg @l="481" char_id="-1" frame_id="-1" name=""   text="在理智消失的瞬间，我用自己的手臂捂住嘴，用力咬住衣服。" voices=""/><msg @l="483" char_id="0" frame_id="-1" name="美帆"   text="(——要去了，去去去去去……要去，嗯嗯！！)" voices="miho06770"/><flash @l="486" count="4" fade="100" image="white"/><msg @l="488" char_id="0" frame_id="-1" name="美帆"   text="『嗯……嗯…………嗯嗯…………。』" voices="miho06780"/><msg @l="490" char_id="-1" frame_id="-1" name=""   text="深刻……而强烈的高潮贯穿了我的身体。" voices=""/><msg @l="491" char_id="-1" frame_id="-1" name=""   text="像小波浪一样的战栗越来越强烈，视野变得一片空白，勉强站立着……我紧紧抓住了扶手。" voices=""/><msg @l="493" char_id="0" frame_id="-1" name="美帆"   text="『哈……嗯啊……哈……哈……。』" voices="miho06790"/><msg @l="495" char_id="-1" frame_id="-1" name="朽木" text="『看来你高潮了呢。』"   voices=""/><msg @l="497" char_id="-1" frame_id="-1" name=""   text="教授搂住了我因高潮余韵和脱力感而颤抖的腰，笑了起来。" voices=""/><clear @l="500" class="all"/><label @l="503" id="event_scene09"/><msg @l="505" char_id="-1" frame_id="-1" name="朽木"   text="『那么，接下来请你照顾一下我的东西吧。』" voices=""/><msg @l="507" char_id="0" frame_id="-1" name="美帆" text="『诶……。』"   voices="miho06800"/><label @l="510" id="chart_line8"/><wait_chgmv/><ev @l="513" src="ev-009a"/><msg @l="515" char_id="-1" frame_id="-1" name=""   text="教授拉下裤子的拉链，毫不羞耻地露出已经硬挺勃起的肉棒。" voices=""/><msg @l="516" char_id="-1" frame_id="-1" name=""   text="从拉链中弹出的那个东西直立得几乎要碰到肚脐下方。" voices=""/><msg @l="517" char_id="-1" frame_id="-1" name=""   text="然后他拉过我的手，将其按在高高翘起的阴茎上。" voices=""/><msg @l="519" char_id="0" frame_id="-1" name="美帆" text="『呜啊……。』"   voices="miho06810"/><msg @l="521" char_id="-1" frame_id="-1" name=""   text="掌心触碰到的男根非常炙热，而且异常坚硬。" voices=""/><msg @l="522" char_id="-1" frame_id="-1" name=""   text="想想看，像这样触摸变成这种状态的男人的东西……还是第一次。" voices=""/><msg @l="523" char_id="-1" frame_id="-1" name=""   text="跳动着脉搏，这狰狞的赤铜色肉棒上盘踞着粗大的血管。" voices=""/><msg @l="524" char_id="-1" frame_id="-1" name="" text="非常炙热，传递到我的手掌上。"   voices=""/><msg @l="525" char_id="-1" frame_id="-1" name=""   text="传达到手上的触感，既怪异又令人不适。" voices=""/><msg @l="527" char_id="-1" frame_id="-1" name="朽木" text="『来吧，帮我撸一下吧。』"   voices=""/><msg @l="529" char_id="0" frame_id="-1" name="美帆" text="『啊，可是……在这种地方……。』"   voices="miho06820"/><msg @l="531" char_id="-1" frame_id="-1" name="朽木" text="『你会帮我撸的吧……。』"   voices=""/><msg @l="533" char_id="-1" frame_id="-1" name="" text="朽木用不容拒绝的表情看着美帆。"   voices=""/><msg @l="535" char_id="0" frame_id="-1" name="美帆" text="『呜……我，我知道了。』"   voices="miho06830"/><msg @l="537" char_id="-1" frame_id="-1" name="" text="慢慢地……用手掌包裹住肉棒。"   voices=""/><msg @l="539" char_id="0" frame_id="-1" name="美帆"   text="(这是什么……好厉害，还在跳动……)" voices="miho06840"/><msg @l="541" char_id="-1" frame_id="-1" name=""   text="虽然对手心中跳动着的凶恶生物感到惊讶，但我还是按照教授说的那样开始撸动它。" voices=""/><msg @l="543" char_id="-1" frame_id="-1" name="朽木"   text="『哦，对了……柔软的手真是受不了啊。』" voices=""/><msg @l="545" char_id="0" frame_id="-1" name="美帆" text="『……唔……。』"   voices="miho06850"/><msg @l="547" char_id="-1" frame_id="-1" name=""   text="听到教授的话……我感觉自己的脸颊一下子变得通红。" voices=""/><msg @l="548" char_id="-1" frame_id="-1" name=""   text="如果是被痴汉侵犯也就算了，但在这样的电车里握着男人的那个东西……。" voices=""/><msg @l="550" char_id="-1" frame_id="-1" name="朽木"   text="『更多地用指尖缠绕，如果不好好撸动的话我可不会满足。』" voices=""/><msg @l="552" char_id="0" frame_id="-1" name="美帆" text="『是……是的……。』"   voices="miho06860"/><msg @l="554" char_id="-1" frame_id="-1" name=""   text="按照指示，我用指尖缠绕着硬挺勃起的肉棒，慢慢地上下撸动。" voices=""/><msg @l="555" char_id="-1" frame_id="-1" name=""   text="我的手指顺着那炙热……且坚硬的男根扭曲的形状移动着。" voices=""/><msg @l="557" char_id="-1" frame_id="-1" name="朽木"   text="『不错，你还挺有天赋的嘛。』" voices=""/><msg @l="559" char_id="0" frame_id="-1" name="美帆" text="『这种事……我一点也不高兴。』"   voices="miho06870"/><msg @l="561" char_id="-1" frame_id="-1" name="朽木"   text="『终有一天，你会主动渴求的。』" voices=""/><msg @l="563" char_id="0" frame_id="-1" name="美帆" text="『……。』"   voices="miho06880"/><msg @l="565" char_id="-1" frame_id="-1" name=""   text="听着教授的话，我皱起眉头，集中注意力在撸动肉棒的动作上。" voices=""/><msg @l="566" char_id="-1" frame_id="-1" name=""   text="我根本无法想象自己会主动做这种事。" voices=""/><msg @l="567" char_id="-1" frame_id="-1" name=""   text="但是……朽木教授肯定会要求我变成那样。" voices=""/><msg @l="568" char_id="-1" frame_id="-1" name=""   text="那么我就必须按照他说的去做。哪怕只是装样子。" voices=""/><msg @l="569" char_id="-1" frame_id="-1" name="" text="为了父亲……为了保护家人。"   voices=""/><msg @l="571" char_id="0" frame_id="-1" name="美帆" text="『哈……哈……。』"   voices="miho06890"/><msg @l="573" char_id="-1" frame_id="-1" name=""   text="不知不觉间，我的嘴里已经漏出了粗重的喘息声。" voices=""/><msg @l="574" char_id="-1" frame_id="-1" name=""   text="额头上……不知何时已经渗出了豆大的汗珠。" voices=""/><msg @l="575" char_id="-1" frame_id="-1" name=""   text="我用拇指和食指形成的环套在龟头的根部，继续撸动着。" voices=""/><msg @l="577" char_id="0" frame_id="-1" name="美帆" text="『嗯嗯……嗯……。』"   voices="miho06900"/><msg @l="579" char_id="-1" frame_id="-1" name="朽木"   text="『啊啊……很好，就这样继续用力撸动。』" voices=""/><msg @l="581" char_id="-1" frame_id="-1" name=""   text="教授的前端滴滴答答地流出淫液，随着我撸动肉棒的动作，他的呼吸变得更加急促。" voices=""/><msg @l="582" char_id="-1" frame_id="-1" name=""   text="指尖和手掌感受到比之前更加强烈的脉动，总觉得他的阴茎似乎变得更大更硬了。" voices=""/><msg @l="583" char_id="-1" frame_id="-1" name=""   text="每当我用沾满黏腻淫液的手指环撸动肉柱时，淫靡的声音就回荡在车内。" voices=""/><msg @l="585" char_id="-1" frame_id="-1" name="朽木" text="『咕……要射了！』"   voices=""/><msg @l="587" char_id="0" frame_id="-1" name="美帆" text="『诶……！？』"   voices="miho06910"/><msg @l="590" async="true" char_id="-1" frame_id="-1" name=""   text="射在哪里……？" voices=""/><select @l="591"><menu @l="594" label="EventLabel_101" text="手心"/><menu @l="597" label="EventLabel_102" text="裙子"/></select><label @l="603" id="EventLabel_101"/><flash @l="606" count="4" fade="100" image="white"/><wait_chgmv/><ev @l="608" src="ev-009ax1z1"/><msg @l="610" char_id="0" frame_id="-1" name="美帆" text="『呀！？』"   voices="miho06920"/><msg @l="612" char_id="-1" frame_id="-1" name=""   text="教授让我的手掌覆盖住他硕大的龟头，随后剧烈地摆动腰部，将滚烫的白浊液体噗噜噗噜地射满了我的手心。"   voices=""/><msg @l="614" char_id="0" frame_id="-1" name="美帆" text="『呜啊……这是、精液……？』"   voices="miho06930"/><msg @l="616" char_id="-1" frame_id="-1" name=""   text="我一脸困惑地看着手掌上散落的欲望能量。" voices=""/><msg @l="617" char_id="-1" frame_id="-1" name=""   text="滚烫的……黏稠的白浊液体顺着手掌缓缓流下，拉出白丝，滴落在地板上。" voices=""/><goto @l="620" label="EventLabel_103"/><label @l="624" id="EventLabel_102"/><msg @l="626" char_id="-1" frame_id="-1" name=""   text="朽木教授把手覆在我的手上，一起摩擦着那根黑亮的肉棒。" voices=""/><msg @l="627" char_id="-1" frame_id="-1" name=""   text="就在射精前一刻……教授将炮口对准了我的大腿附近。" voices=""/><flash @l="630" count="4" fade="100" image="white"/><wait_chgmv/><ev @l="633" src="ev-009by1z2"/><msg @l="635" char_id="0" frame_id="-1" name="美帆" text="『啊……』"   voices="miho06940"/><msg @l="637" char_id="-1" frame_id="-1" name=""   text="肉棒的前端似乎飞出了什么东西，那东西被洒落在了我的裙子上。" voices=""/><msg @l="639" char_id="0" frame_id="-1" name="美帆"   text="(这、这是什么……难道是……精液……？)" voices="miho06950"/><msg @l="641" char_id="-1" frame_id="-1" name=""   text="我带着困惑的表情，注视着洒在裙子上的热烫液体。" voices=""/><msg @l="642" char_id="-1" frame_id="-1" name=""   text="第一次见到的男性欲液正如传闻中所说是白浊色的，我一时间恍惚地盯着它看了好一会儿。" voices=""/><label @l="645" id="EventLabel_103"/><stopbgm @l="648" fadeout="1000"/><clear @l="651" class="all"/><msg @l="653" char_id="-1" frame_id="-1" name="广播"   text="『下一站是终点…大学前，大学前站。』" voices=""/><msg @l="655" char_id="-1" frame_id="-1" name="广播"   text="『请注意检查是否有遗忘的随身物品。』" voices=""/><stopse @l="658" buf="3"/><msg @l="660" char_id="-1" frame_id="-1" name=""   text="车内广播响起，电车开始微微减速。" voices=""/><msg @l="661" char_id="-1" frame_id="-1" name=""   text="随之车厢内因乘客准备下车而变得忙乱起来，不知不觉间，本应在我身后的朽木教授的身影已经消失了。" voices=""/><msg @l="663" char_id="0" frame_id="-1" name="美帆" text="『…………』"   voices="miho06960"/><msg @l="665" char_id="0" frame_id="-1" name="美帆" text="(这种事……会一直持续下去吗)"   voices="miho06970"/><msg @l="667" char_id="-1" frame_id="-1" name=""   text="我仍然呆然地站在原地，精液就那样洒在裙子上，一动不动。" voices=""/><clear @l="670" class="all"/><end_scene @l="673"/><msgshow @l="676" show="true"/><wait_chgmv/><bg @l="679" src="bg09"/><bgm @l="682" src="bgm03" volume="1."/><char @l="685" id="miho" pos="auto" src="miho115"/><msg @l="687" char_id="0" frame_id="-1" name="美帆" text="『唉……。』" voices=""/><msg @l="689" char_id="-1" frame_id="-1" name="女性朋友"   text="『又在叹气了。你今天有点忧郁啊？』" voices=""/><char @l="692" id="miho" pos="auto" src="miho016"/><msg @l="694" char_id="0" frame_id="-1" name="美帆" text="『诶……啊，抱歉。』"   voices=""/><msg @l="696" char_id="-1" frame_id="-1" name=""   text="第二节课结束后，吃完午饭———。" voices=""/><msg @l="697" char_id="-1" frame_id="-1" name=""   text="我和一个女同学两人一起走在走廊上，聊着剩下的时间该怎么度过。" voices=""/><msg @l="698" char_id="-1" frame_id="-1" name=""   text="只是，不知不觉中我似乎总是在叹气……每次都被这个课堂朋友说“忧郁”啊“烦人”什么的。"   voices=""/><msg @l="700" char_id="0" frame_id="-1" name="美帆" text="『有点……可能是累了吧。』"   voices=""/><msg @l="702" char_id="-1" frame_id="-1" name="女性朋友" text="『什么累了吧，啊。』"   voices=""/><msg @l="704" char_id="-1" frame_id="-1" name="女性朋友"   text="『我们是年轻人哦？年轻小伙哦？』" voices=""/><msg @l="706" char_id="0" frame_id="-1" name="美帆"   text="『要说的话，我觉得应该是年轻女性才对……。』" voices=""/><msg @l="708" char_id="-1" frame_id="-1" name="女性朋友"   text="『哎呀，吐槽的精神还挺足嘛？』" voices=""/><msg @l="710" char_id="-1" frame_id="-1" name="女性朋友"   text="『你我都还是朝气蓬勃的现役，花一样的少女啊，别说什么累了之类的，打起精神来！』" voices=""/><char @l="713" id="miho" pos="auto" src="miho011"/><msg @l="715" char_id="0" frame_id="-1" name="美帆" text="『啊哈哈……嗯，是啊。』"   voices=""/><bgm @l="718" src="bgm04" volume="1."/><msg @l="720" char_id="-1" frame_id="-1" name="女性朋友" text="『嗯，你明白就好。』"   voices=""/><msg @l="722" char_id="-1" frame_id="-1" name="" text="说着，她挺起胸膛展示给我看。"   voices=""/><msg @l="723" char_id="-1" frame_id="-1" name=""   text="也许……这是她自己的方式在鼓励我吧。" voices=""/><msg @l="725" char_id="0" frame_id="-1" name="美帆"   text="『那么，接下来要怎么……。』" voices=""/><stopbgm @l="728" fadeout="1000"/><clear @l="730" class="char"/><char @l="732" id="miho" pos="center" src="miho014f" y="-80"/><msg @l="734" char_id="-1" frame_id="-1" name="" text="话语突然停了下来。" voices=""/><msg @l="735" char_id="-1" frame_id="-1" name="" text="视线边缘进入了……一个人影。"   voices=""/><msg @l="736" char_id="-1" frame_id="-1" name=""   text="那个人影虽然背对着这边站着，但我立刻就认出了那是谁。" voices=""/><bgm @l="739" src="bgm15" volume="1."/><char @l="742" id="miho" pos="center" src="miho115f" y="-80"/><msg @l="744" char_id="0" frame_id="-1" name="美帆" text="『朽木……教授……』"   voices=""/><msg @l="746" char_id="-1" frame_id="-1" name="女性朋友" text="『怎么了怎么了，发生什么事了？』"   voices=""/><clear @l="749" class="char"/><char @l="751" id="miho" pos="auto" src="miho016"/><msg @l="753" char_id="0" frame_id="-1" name="美帆"   text="『啊，没什么……只是突然想起有点急事。』" voices=""/><msg @l="755" char_id="-1" frame_id="-1" name="女性朋友" text="『急事？那是什么啊？』"   voices=""/><msg @l="757" char_id="0" frame_id="-1" name="美帆"   text="『呃，没什么大不了的……不好意思，你先去教室吧。』" voices=""/><msg @l="759" char_id="-1" frame_id="-1" name="女性朋友"   text="『说教室，距离下一节课开始还有30分钟呢……』" voices=""/><msg @l="761" char_id="-1" frame_id="-1" name="女性朋友"   text="『啊，要不我也跟你一起去……』" voices=""/><char @l="764" id="miho" pos="auto" src="miho115"/><msg @l="766" char_id="0" frame_id="-1" name="美帆" text="『不行！！』" voices=""/><msg @l="768" char_id="-1" frame_id="-1" name="女性朋友" text="『啊……』" voices=""/><char @l="771" id="miho" pos="auto" src="miho016"/><msg @l="773" char_id="0" frame_id="-1" name="美帆" text="『啊……对、对不起。』"   voices=""/><msg @l="775" char_id="0" frame_id="-1" name="美帆"   text="『真的，没什么事……拜托……你先走吧。』" voices=""/><msg @l="777" char_id="-1" frame_id="-1" name="女性朋友"   text="『我、我知道了……那待会儿见。』" voices=""/><msg @l="779" char_id="-1" frame_id="-1" name=""   text="在我的气势压迫下，那位上课的朋友快步离开了。" voices=""/><msg @l="780" char_id="-1" frame_id="-1" name=""   text="这也难怪……在她面前那样大声说话，还是第一次。" voices=""/><msg @l="782" char_id="-1" frame_id="-1" name="声音"   text="『对关心你的朋友，你还真是狠心啊。』" voices=""/><msg @l="784" char_id="-1" frame_id="-1" name=""   text="确认上课的朋友离开后，那个人影说着这话转过身来面向这边。" voices=""/><clear @l="787" class="char"/><char @l="789" id="miho" pos="left" src="miho115"/><char @l="791" id="kutsu" pos="right" src="kutsu010"/><msg @l="793" char_id="-1" frame_id="-1" name="朽木"   text="『做出那种事，之后不会感到尴尬吗？』" voices=""/><msg @l="795" char_id="0" frame_id="-1" name="美帆" text="『……她一定，会理解的。』"   voices=""/><msg @l="797" char_id="-1" frame_id="-1" name="朽木"   text="『呵呵呵，失礼了。这么说你们是被热烈的友谊之链紧紧相连着啊。』" voices=""/><msg @l="799" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><char @l="802" id="miho" pos="left" src="miho015"/><msg @l="804" char_id="0" frame_id="-1" name="美帆"   text="『比起这个……请不要再埋伏等人了。这很让人困扰。』" voices=""/><char @l="807" id="kutsu" pos="right" src="kutsu018"/><msg @l="809" char_id="-1" frame_id="-1" name="朽木"   text="『困扰？你认为自己有权利用这种口气跟我说话吗？』" voices=""/><char @l="812" id="miho" pos="left" src="miho115"/><msg @l="814" char_id="0" frame_id="-1" name="美帆"   text="『那、那是……早上的事……你不是已经接受了吗。』" voices=""/><msg @l="816" char_id="-1" frame_id="-1" name="朽木" text="『啊，那种东西只不过是开胃菜罢了。』"   voices=""/><msg @l="818" char_id="-1" frame_id="-1" name="朽木"   text="『如果你认为那种程度就结束了，那可就大错特错了。』" voices=""/><char @l="821" id="miho" pos="left" src="miho114"/><msg @l="823" char_id="0" frame_id="-1" name="美帆" text="『怎么会！』" voices=""/><char @l="826" id="kutsu" pos="right" src="kutsu010"/><msg @l="828" char_id="-1" frame_id="-1" name="朽木"   text="『难道你忘记了自己亲口说出的契约之词吗？』" voices=""/><char @l="831" id="miho" pos="left" src="miho115"/><msg @l="833" char_id="0" frame_id="-1" name="美帆" text="『我没有忘记……但是。』"   voices=""/><msg @l="835" char_id="-1" frame_id="-1" name="朽木"   text="『要不要我在这里大声说出来让你确认一下呢？』" voices=""/><char @l="838" id="miho" pos="left" src="miho015"/><msg @l="840" char_id="0" frame_id="-1" name="美帆"   text="『别、别这样……求你了。』" voices=""/><char @l="843" id="kutsu" pos="right" src="kutsu018"/><msg @l="845" char_id="-1" frame_id="-1" name="朽木"   text="『呵呵……你的眼神真是不错。』" voices=""/><msg @l="847" char_id="-1" frame_id="-1" name="朽木"   text="『光是看着你那种恳求的眼神，我下面就已经硬起来了。』" voices=""/><clear @l="850" layer="kutsu"/><char @l="852" id="kutsu" pos="auto" src="kutsu018"/><msg @l="854" char_id="-1" frame_id="-1" name=""   text="说着，教授拉过我的手，按在了他裤子的胯部。" voices=""/><msg @l="855" char_id="-1" frame_id="-1" name=""   text="确实……即使隔着裤子，也能感觉到教授那里已经硬邦邦地胀大了。" voices=""/><msg @l="857" char_id="0" frame_id="-1" name="美帆" text="『……唔……。』" voices=""/><clear @l="860" class="char"/><char @l="862" id="kutsu" pos="right" src="kutsu010"/><msg @l="864" char_id="-1" frame_id="-1" name="朽木"   text="『对了……仲根同学，现在跟我到教授室来。』" voices=""/><msg @l="866" char_id="-1" frame_id="-1" name="朽木"   text="『我要用这家伙好好疼爱你一番。』" voices=""/><msg @l="868" char_id="0" frame_id="-1" name="美帆"   text="『这、这种……可是，早上不是已经……。』" voices=""/><msg @l="870" char_id="-1" frame_id="-1" name="朽木"   text="『可惜，我还没有老到一次就满足的地步。』" voices=""/><msg @l="872" char_id="-1" frame_id="-1" name="朽木" text="『来吧……快跟我来。』"   voices=""/><clear @l="875" layer="kutsu"/><msg @l="877" char_id="-1" frame_id="-1" name=""   text="教授说着，搂住我的腰，准备往有教授室的教学楼走去。" voices=""/><msg @l="881" async="true" char_id="-1" frame_id="-1" name=""   text="对于朽木的邀请……？" voices=""/><select @l="882"><menu @l="885" label="EventLabel_104" text="服从"/><menu @l="888" label="EventLabel_110" text="拒绝"/></select><label @l="895" id="EventLabel_104"/><clear @l="898" class="char"/><char @l="900" id="miho" pos="auto" src="miho115"/><msg @l="902" char_id="0" frame_id="-1" name="美帆" text="『……我知道了。』"   voices=""/><msg @l="904" char_id="-1" frame_id="-1" name=""   text="我点头应允了教授的话语，慢慢地开始行走。" voices=""/><msg @l="905" char_id="-1" frame_id="-1" name="" text="我很清楚接下来会发生什么……"   voices=""/><msg @l="906" char_id="-1" frame_id="-1" name="" text="即便如此……。" voices=""/><msg @l="907" char_id="-1" frame_id="-1" name=""   text="尽管如此，我还是……不能违抗朽木教授的话。" voices=""/><msg @l="909" char_id="0" frame_id="-1" name="美帆" text="(爸爸……我……会忍耐的)"   voices=""/><msg @l="911" char_id="0" frame_id="-1" name="美帆"   text="(无论发生什么……我都会、好好地，忍耐下去的……)" voices=""/><msg @l="913" char_id="-1" frame_id="-1" name=""   text="……我喃喃自语，仿佛是在说服自己。" voices=""/><stopbgm @l="916" fadeout="1000"/><clear @l="919" class="all"/><bgm @l="922" src="bgm09" volume="1."/><msg @l="924" char_id="-1" frame_id="-1" name="朽木" text="『来吧，别客气，请进。』"   voices=""/><msg @l="926" char_id="0" frame_id="-1" name="美帆" text="『……好的。』" voices=""/><wait_chgmv/><bg @l="929" src="bg12"/><char @l="932" id="miho" pos="left" src="miho015"/><char @l="935" id="kutsu" pos="right" src="kutsu010"/><msg @l="937" char_id="-1" frame_id="-1" name="" text="我被带进了教授室。" voices=""/><msg @l="938" char_id="-1" frame_id="-1" name=""   text="朽木教授先让我进入房间，然后背手关上门并上了锁。" voices=""/><msg @l="940" char_id="0" frame_id="-1" name="美帆" text="『啊，那个……您，您要做什么？』"   voices=""/><char @l="943" id="kutsu" pos="right" src="kutsu018"/><msg @l="945" char_id="-1" frame_id="-1" name="朽木"   text="『呵呵呵，今天我打算为特别可爱的你提供个人指导，仲根同学。』" voices=""/><char @l="948" id="miho" pos="left" src="miho115"/><msg @l="950" char_id="0" frame_id="-1" name="美帆"   text="『求、求求你……请、请原谅我……。』" voices=""/><msg @l="952" char_id="-1" frame_id="-1" name="朽木"   text="『原谅？原谅什么呢？我只是在做你希望我做的事情，不是吗？呵呵呵。』" voices=""/><msg @l="954" char_id="0" frame_id="-1" name="美帆" text="『这、这种事……』"   voices=""/><char @l="957" id="kutsu" pos="right" src="kutsu010"/><msg @l="959" char_id="-1" frame_id="-1" name="朽木" text="『难道不是吗？』" voices=""/><char @l="962" id="miho" pos="left" src="miho015"/><msg @l="964" char_id="0" frame_id="-1" name="美帆" text="『……是、是的……是……这样的……』"   voices=""/><char @l="967" id="kutsu" pos="right" src="kutsu018"/><msg @l="969" char_id="-1" frame_id="-1" name="朽木"   text="『那么，你说过想要我检查你的身体吧。赶快把衣服脱掉吧。』" voices=""/><char @l="972" id="miho" pos="left" src="miho115"/><msg @l="974" char_id="0" frame_id="-1" name="美帆"   text="『啊，衣、衣服要……脱掉吗……？』" voices=""/><msg @l="976" char_id="-1" frame_id="-1" name="朽木"   text="『你是想让我重复多少遍？我倒是无所谓，不管你会变得多么困扰。』" voices=""/><msg @l="978" char_id="0" frame_id="-1" name="美帆" text="『是的……我明白了……』"   voices=""/><clear @l="981" class="char"/><msg @l="983" char_id="-1" frame_id="-1" name=""   text="我像是下定决心般深深地吸了一口气，然后用颤抖的指尖一个一个地解开衬衫的纽扣。" voices=""/><msg @l="984" char_id="-1" frame_id="-1" name="" text="我已经放弃了。" voices=""/><msg @l="985" char_id="-1" frame_id="-1" name="" text="为了救父亲和家人，这是不得已的事情。"   voices=""/><msg @l="986" char_id="-1" frame_id="-1" name=""   text="但我因悔恨而咬紧嘴唇，不禁流下了眼泪。" voices=""/><msg @l="987" char_id="-1" frame_id="-1" name=""   text="我慢慢地，一个一个解开胸前的纽扣。" voices=""/><char @l="990" id="miho" pos="auto" src="miho185"/><msg @l="992" char_id="0" frame_id="-1" name="美帆" text="『这、这样可以吗……？』"   voices=""/><clear @l="995" class="char"/><char @l="997" id="miho" pos="left" src="miho185"/><char @l="999" id="kutsu" pos="right" src="kutsu018"/><msg @l="1000" char_id="-1" frame_id="-1" name="朽木"   text="『这是我第一次看到你穿内衣的样子呢。呵呵呵，那么内衣也脱掉吧。』" voices=""/><msg @l="1002" char_id="0" frame_id="-1" name="美帆" text="『……我明白了……』"   voices=""/><clear @l="1005" class="char"/><msg @l="1007" char_id="-1" frame_id="-1" name=""   text="我怀着放弃的心情，慢慢解开胸罩的搭扣，脱下来扔在沙发上。从未被任何人看过的胸部，就这样暴露在带着猥琐笑容的朽木教授面前。"   voices=""/><msg @l="1009" char_id="-1" frame_id="-1" name="朽木" text="『不要试图用手遮挡。』"   voices=""/><msg @l="1011" char_id="0" frame_id="-1" name="美帆"   text="『是、是的……对不起…………』" voices=""/><msg @l="1013" char_id="-1" frame_id="-1" name=""   text="我因教授的话语而颤抖……暴露的胸部就那样不加掩饰，慢慢地脱下内裤。" voices=""/><char @l="1016" id="miho" pos="auto" src="miho105"/><msg @l="1018" char_id="0" frame_id="-1" name="美帆" text="『我、我已经……全部脱完了。』"   voices=""/><msg @l="1020" char_id="-1" frame_id="-1" name=""   text="我感觉到朽木教授的目光像粘附在我的胸部和腿间。我因为羞耻而别过脸，紧闭双眼忍耐着快要溢出的泪水。"   voices=""/><msg @l="1022" char_id="-1" frame_id="-1" name="朽木"   text="『很好，那么请躺在桌子上吧。』" voices=""/><clear @l="1025" class="all"/><msg @l="1027" char_id="-1" frame_id="-1" name="朽木"   text="『哦，在那之前，我们先做点准备工作吧。』" voices=""/><msg @l="1029" char_id="-1" frame_id="-1" name=""   text="说着，教授抓住了躺在桌上的我的双臂，从架子上取来绳子，开始围着我的手腕缠绕捆绑。" voices=""/><msg @l="1031" char_id="0" frame_id="-1" name="美帆" text="『呀……你、你要做什么？』"   voices=""/><msg @l="1033" char_id="-1" frame_id="-1" name="朽木" text="『绑起来防止你乱动。』"   voices=""/><msg @l="1035" char_id="0" frame_id="-1" name="美帆"   text="『这、这种，像强迫一样的……』" voices=""/><msg @l="1037" char_id="-1" frame_id="-1" name="朽木"   text="『怎么会是强迫呢？我当然打算温柔对待你……嘛，这只是一种防备措施而已。』" voices=""/><msg @l="1039" char_id="-1" frame_id="-1" name="朽木"   text="『只要你不乱动，这就不会有问题。』" voices=""/><msg @l="1041" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="1043" char_id="-1" frame_id="-1" name=""   text="也许我犯了一个可怕的错误……" voices=""/><msg @l="1044" char_id="-1" frame_id="-1" name=""   text="强烈的绝望感和让我脑袋一片空白的羞耻感或许让我无法正常思考。无论出于什么原因，在这个密室里，被束缚着毫无防备地面对朽木教授的现在，一切都已经太迟了……"   voices=""/><label @l="1047" id="event_scene08"/><bgm @l="1050" src="bgm14" volume="1."/><label @l="1053" id="chart_line41"/><wait_chgmv/><ev @l="1056" src="ev-008a"/><description @l="1059" text="纯洁的消散"/><msg @l="1061" char_id="0" frame_id="-1" name="美帆" text="『嗯嗯……』"   voices="miho06980"/><msg @l="1063" char_id="-1" frame_id="-1" name=""   text="教授的双手直接触摸着有弹性的乳房。他用手掌大力抓住左右两边的乳房，当两根手指按压着粉红色的乳头时，我因厌恶而身体变得僵硬。"   voices=""/><msg @l="1065" char_id="-1" frame_id="-1" name="朽木"   text="『你的胸部形状相当不错嘛。』" voices=""/><msg @l="1067" char_id="-1" frame_id="-1" name=""   text="那隆起如水蜜桃般水润，朽木对这触感感到十分满意。" voices=""/><msg @l="1068" char_id="0" frame_id="-1" name="美帆"   text="『嗯……啊，嗯嗯……啊，啊啊……』" voices="miho07000"/><msg @l="1070" char_id="-1" frame_id="-1" name=""   text="感受到胸前尖端仿佛被电流刺激，让我忍不住扭动身体。教授俯身玩弄着我的乳房，吮吸着已经开始变硬的乳首。"   voices=""/><msg @l="1072" char_id="0" frame_id="-1" name="美帆"   text="『啊啊…哈，哈，哈………嗯，呃…。』" voices="miho07010"/><msg @l="1074" char_id="-1" frame_id="-1" name=""   text="他一边上目线观察着我的反应，一边用左手拇指揉搓着丰满白皙球体上的红色果实，另一边则用舌头挑逗着另一侧的乳首。"   voices=""/><msg @l="1076" char_id="0" frame_id="-1" name="美帆" text="『嗯，啊啊啊！？』"   voices="miho10070"/><msg @l="1078" char_id="-1" frame_id="-1" name=""   text="我想要抵抗，但与这想法相反，我的身体却不由自主地颤抖起来。" voices=""/><msg @l="1080" char_id="-1" frame_id="-1" name="朽木"   text="『真美味。能够享用如此盛宴…』" voices=""/><msg @l="1082" char_id="-1" frame_id="-1" name=""   text="教授像是要弄脏我的胸部一样，将唾液涂抹在上面。" voices=""/><msg @l="1084" char_id="0" frame_id="-1" name="美帆" text="『嘶！！』"   voices="miho10100"/><msg @l="1086" char_id="-1" frame_id="-1" name=""   text="乳首渐渐变得坚硬突起，每次被舌头攻击时，我的身体都会随之颤抖。" voices=""/><msg @l="1088" char_id="-1" frame_id="-1" name="朽木"   text="『呵呵呵，那么接下来让我好好观察一下你的私处吧。』" voices=""/><msg @l="1090" char_id="-1" frame_id="-1" name=""   text="教授把手放在我紧闭的膝盖上，强行将我的双腿向左右大大分开。当教授那黏腻的目光洒在我的私处时，我的全身因羞耻而变得通红。"   voices=""/><msg @l="1092" char_id="0" frame_id="-1" name="美帆" text="『呀，啊啊啊啊！』"   voices="miho10240"/><msg @l="1094" char_id="-1" frame_id="-1" name="朽木"   text="『嗯，多么漂亮的颜色啊。你难道是处女吗？』" voices=""/><msg @l="1096" char_id="-1" frame_id="-1" name=""   text="教授浮现出一丝淫邪的笑容，顺着缝隙滑动着手指。" voices=""/><msg @l="1097" char_id="-1" frame_id="-1" name=""   text="他将手爬过我那令人销魂的下肢，仔细端详着我的下半身。" voices=""/><msg @l="1099" char_id="0" frame_id="-1" name="美帆"   text="『呀，啊啊……请不要说……嗯，唔唔。』" voices="miho07020"/><msg @l="1100" char_id="-1" frame_id="-1" name="朽木"   text="『哦！？这太棒了，真的是处女吗。我可是得到了上等货啊。』" voices=""/><msg @l="1102" char_id="-1" frame_id="-1" name=""   text="教授的脸从我的大腿内侧经过，一直来到腿根。然后，将脸贴在我的私处，沉浸在恍惚感中，吸入那隐秘的香气。"   voices=""/><msg @l="1103" char_id="-1" frame_id="-1" name=""   text="淫欲的香气刺激着他的鼻腔，沉浸在这种官能中的朽木教授脸上露出了淫邪的笑容。" voices=""/><msg @l="1105" char_id="-1" frame_id="-1" name="朽木"   text="『你散发着淫荡的气味呢。作为处女，你可真是个放荡的女人。』" voices=""/><msg @l="1107" char_id="0" frame_id="-1" name="美帆" text="『那…样的…』"   voices="miho10220"/><msg @l="1109" char_id="-1" frame_id="-1" name=""   text="教授对我说完那些羞辱的话后，强行将舌头挤进了我柔软的肉缝中。" voices=""/><msg @l="1110" char_id="-1" frame_id="-1" name=""   text="他的舌头肆意挑逗着我的私处，黏腻而执拗地爱抚着。" voices=""/><msg @l="1112" char_id="0" frame_id="-1" name="美帆"   text="『嗯…啊，嗯嗯…啊，啊啊…』" voices="miho07000"/><msg @l="1114" char_id="-1" frame_id="-1" name=""   text="我的腰猛地一颤，向朽木教授展示着诡异的扭动。" voices=""/><msg @l="1115" char_id="-1" frame_id="-1" name=""   text="此时我的花唇已经被溢出的蜜液浸得湿滑不堪。" voices=""/><msg @l="1116" char_id="-1" frame_id="-1" name=""   text="教授表现出浓厚的兴趣，动用了手指，窥探着我的蜜壶。" voices=""/><msg @l="1117" char_id="-1" frame_id="-1" name=""   text="他从两侧揉捏着我丰满的私处，沿着缝隙滑动手指后，指尖捏住了我的阴蒂。" voices=""/><msg @l="1119" char_id="0" frame_id="-1" name="美帆" text="『啊啊啊！！』"   voices="miho00780"/><msg @l="1121" char_id="-1" frame_id="-1" name=""   text="朽木教授一边分开我的缝隙将手指插入蜜口，一边执拗地用手指捏着阴蒂来回揉搓。" voices=""/><msg @l="1122" char_id="-1" frame_id="-1" name=""   text="每当私密的缝隙被粗暴蹂躏，一种类似于钝痛的摩擦感就会袭击我的下腹部，疼痛褪去后，残留着一种带着热度的麻痹感。"   voices=""/><msg @l="1124" char_id="-1" frame_id="-1" name="朽木"   text="『你明明是个处女，却在被痴汉侵犯时表现得那么享受。真是个淫荡的女孩啊。呵呵呵呵。』" voices=""/><msg @l="1126" char_id="0" frame_id="-1" name="美帆"   text="『啊…那是，嗯…哎…。』" voices="miho06990"/><msg @l="1128" char_id="-1" frame_id="-1" name=""   text="为了逃避搅动秘唇的手指动作和蜜汁发出的咕啾咕啾声，我咬住嘴唇，拼命忍耐着羞耻感。" voices=""/><msg @l="1130" char_id="0" frame_id="-1" name="美帆"   text="『嗯嗯…嗯，嗯…啊啊…。』" voices="miho07030"/><msg @l="1132" char_id="-1" frame_id="-1" name="朽木"   text="『淫液正一点点溢出来了。』" voices=""/><msg @l="1134" char_id="-1" frame_id="-1" name=""   text="双腿被大大分开，毫无防备的花核被揉捏，花缝的入口被不停搅动。" voices=""/><msg @l="1135" char_id="-1" frame_id="-1" name=""   text="我扭动着身体，使得桌子发出吱吱嘎嘎的声响。" voices=""/><msg @l="1136" char_id="-1" frame_id="-1" name=""   text="他插入的手指像是在摩擦秘壁一样搅拌着，渐渐地将我融化在快感之中。" voices=""/><msg @l="1138" char_id="-1" frame_id="-1" name="朽木"   text="『这样，湿成这样的话，应该能减轻一些疼痛吧。』" voices=""/><msg @l="1140" char_id="-1" frame_id="-1" name=""   text="教授这样说着，用指尖分开溢出黏稠爱液的裂缝，发出了啾噗的声音。" voices=""/><msg @l="1141" char_id="-1" frame_id="-1" name=""   text="我的那里，因为之前持续不断的爱抚已经变得泥泞不堪。" voices=""/><msg @l="1143" char_id="0" frame_id="-1" name="美帆"   text="『哈…哈……嗯，啊啊……。』" voices="miho07040"/><msg @l="1145" char_id="-1" frame_id="-1" name="朽木"   text="『我们用我的阴茎来举行通路仪式吧。你应该感到荣幸才是。』" voices=""/><msg @l="1147" char_id="-1" frame_id="-1" name="" text="肉棒的前端被抵在入口处。"   voices=""/><msg @l="1149" char_id="0" frame_id="-1" name="美帆" text="『呃——————。』"   voices="miho04860"/><msg @l="1151" char_id="-1" frame_id="-1" name=""   text="那东西先是像要缠绕溢出的蜜液一样，在裂缝的褶皱上下搅动，然后慢慢地侵入了我的体内。"   voices=""/><msg @l="1153" char_id="0" frame_id="-1" name="美帆" text="『啊啊！！！』"   voices="miho07050"/><msg @l="1155" char_id="-1" frame_id="-1" name="" text="秘缝被异物撕裂了。"   voices=""/><msg @l="1157" char_id="0" frame_id="-1" name="美帆" text="『啊，啊啊啊啊啊啊啊啊啊！！！』"   voices="miho04870"/><msg @l="1159" char_id="-1" frame_id="-1" name=""   text="感觉有什么东西噗嗤噗嗤地被撕裂开，一种钝重的、仿佛全身被钉入木桩般的疼痛席卷了全身。" voices=""/><msg @l="1161" char_id="-1" frame_id="-1" name="朽木"   text="『慢慢深呼吸，然后放松。我的东西还没进去一半呢？』" voices=""/><msg @l="1163" char_id="0" frame_id="-1" name="美帆" text="『啊啊…呃，啊啊啊！！』"   voices="miho07060"/><msg @l="1165" char_id="-1" frame_id="-1" name=""   text="想到这种疼痛还要持续两倍以上，我感觉快要失去意识了。" voices=""/><msg @l="1166" char_id="-1" frame_id="-1" name="" text="疼痛…已经不足以形容。"   voices=""/><msg @l="1167" char_id="-1" frame_id="-1" name=""   text="阴道被强行撕裂的触感和灼热的剧痛，是无法用其他词汇来比喻的。" voices=""/><msg @l="1169" char_id="-1" frame_id="-1" name="朽木" text="『啊…快了…就要到底了。』"   voices=""/><msg @l="1171" char_id="-1" frame_id="-1" name="" text="教授用略微颤抖的声音说道。"   voices=""/><msg @l="1172" char_id="-1" frame_id="-1" name="" text="我的秘穴想必是太窄了。"   voices=""/><msg @l="1173" char_id="-1" frame_id="-1" name=""   text="朽木的欲望无法完全进入到我的身体深处。" voices=""/><msg @l="1175" char_id="0" frame_id="-1" name="美帆"   text="『呼……啊、唔嗯……哈、哈、哈………呼啊啊！！！』" voices="miho07070"/><msg @l="1177" char_id="-1" frame_id="-1" name=""   text="朽木教授用全身的重量，将滚烫的东西深深推入我身体的深处。" voices=""/><msg @l="1178" char_id="-1" frame_id="-1" name=""   text="意识到那是教授的肉茎……需要一点时间。" voices=""/><msg @l="1179" char_id="-1" frame_id="-1" name=""   text="那一瞬间，我因疼痛和初次的感觉几乎失去意识。" voices=""/><msg @l="1181" char_id="0" frame_id="-1" name="美帆"   text="『不、不要……停、啊啊啊！！』" voices="miho05050"/><msg @l="1183" char_id="-1" frame_id="-1" name="朽木"   text="『全部进去了，这下你也成为成年女性的一员了。』" voices=""/><msg @l="1185" char_id="-1" frame_id="-1" name=""   text="教授嘲讽似地说着，嘴角微微扭曲。" voices=""/><msg @l="1186" char_id="-1" frame_id="-1" name=""   text="我……没有余力回应他的话，只是不断急促喘息，试图缓解感受到的疼痛。" voices=""/><msg @l="1188" char_id="-1" frame_id="-1" name="朽木"   text="『那么……就让我好好享受一下处女的胎内吧。』" voices=""/><msg @l="1190" char_id="0" frame_id="-1" name="美帆"   text="『呜……啊………是、是的………。』" voices="miho07080"/><msg @l="1192" char_id="-1" frame_id="-1" name=""   text="教授等待我的呼吸平稳下来后，像是试探般缓缓律动起腰部。" voices=""/><msg @l="1194" char_id="0" frame_id="-1" name="美帆"   text="『嘶…疼…啊、唔咕…嗯嗯…。』" voices="miho07090"/><msg @l="1196" char_id="-1" frame_id="-1" name="" text="在我的阴道内，他膨胀的欲望开始蠕动起来。"   voices=""/><msg @l="1197" char_id="-1" frame_id="-1" name=""   text="由于充分润滑的爱液，肉壁被肉棒拉扯的疼痛感比我想象的要轻，但那巨大的“异物感”仍然占据着我的阴道，不断扩张摩擦着。"   voices=""/><msg @l="1198" char_id="-1" frame_id="-1" name=""   text="我感受不到一丝快感…只有窒息般的压迫和尖锐的疼痛。" voices=""/><msg @l="1200" char_id="0" frame_id="-1" name="美帆"   text="『嗯、啊啊…呀、啊呜…住手…嗯啊！』" voices="miho04980"/><msg @l="1202" char_id="-1" frame_id="-1" name="朽木"   text="『看来还是疼痛更胜一筹啊……。』" voices=""/><msg @l="1204" char_id="-1" frame_id="-1" name="朽木"   text="『那么，我就从这边让你获得快乐吧。』" voices=""/><msg @l="1206" char_id="-1" frame_id="-1" name=""   text="教授一边说着，一边保持着贯穿我的状态，开始揉弄我的阴蒂。" voices=""/><msg @l="1208" char_id="0" frame_id="-1" name="美帆" text="『嗯、啊啊…！！』"   voices="miho07100"/><msg @l="1210" char_id="-1" frame_id="-1" name=""   text="由于阴道被贯穿，我的那里变得更加炙热敏感。" voices=""/><msg @l="1211" char_id="-1" frame_id="-1" name=""   text="教授的指尖只是轻轻拨弄那炙热的花核，被贯穿前那种甜美的麻痹感便再次回到了我的身体。" voices=""/><msg @l="1213" char_id="-1" frame_id="-1" name="朽木"   text="『如果不多加调教，恐怕你还无法从阴道内部获得快感，至少我要这样让你也能享受到乐趣。』" voices=""/><msg @l="1215" char_id="0" frame_id="-1" name="美帆"   text="『嗯嗯，嗯……啊……啊啊！！！』" voices="miho07110"/><msg @l="1217" char_id="-1" frame_id="-1" name=""   text="教授一边缓缓摆动腰部，一边将从蜜壶中咕叽咕叽溢出的爱液缠绕在指尖作为润滑……猛烈地摩擦着已经硬挺勃起的红色肉芽。"   voices=""/><msg @l="1218" char_id="-1" frame_id="-1" name=""   text="阴穴被撑开的压迫感，以及被撕裂的伤口被摩擦的钝痛，与那甜美的麻痹感混合在一起，让我的思绪变得混乱。" voices=""/><msg @l="1220" char_id="0" frame_id="-1" name="美帆"   text="『啊，嗯嗯……嗯……哈，嗯呜！！』" voices="miho07120"/><msg @l="1222" char_id="-1" frame_id="-1" name="朽木"   text="『呵呵，看来你很享受啊……那么我也来享受一下吧。』" voices=""/><msg @l="1224" char_id="-1" frame_id="-1" name=""   text="教授说完，加快了阴茎摩擦肉壁的律动。" voices=""/><msg @l="1225" char_id="-1" frame_id="-1" name=""   text="我的身体绷得笔直，双腿充满了力量。" voices=""/><msg @l="1227" char_id="0" frame_id="-1" name="美帆" text="『嘶呜！！』"   voices="miho10100"/><msg @l="1229" char_id="-1" frame_id="-1" name="朽木"   text="『你的阴道内部真是极品。明明是第一次却已经用肉褶缠绕着我的东西，想要榨取我。』" voices=""/><msg @l="1231" char_id="-1" frame_id="-1" name=""   text="教授喘着气，在我耳边低语。" voices=""/><msg @l="1232" char_id="-1" frame_id="-1" name=""   text="但是，比我意识到那些话语更早的是，耳垂上被黏腻的舌头爬行的刺激让我感到兴奋不已，背脊不由自主地颤栗着向后仰。"   voices=""/><msg @l="1234" char_id="0" frame_id="-1" name="美帆"   text="『啊啊……啊，啊………嗯，啊呜………呀，好舒服……！？』" voices="miho07130"/><msg @l="1236" char_id="0" frame_id="-1" name="美帆"   text="『啊，啊啊啊………要，去了……呀……不行，已经……搞不……清楚了……嗯嗯！』" voices="miho07140"/><msg @l="1238" char_id="-1" frame_id="-1" name="朽木"   text="『呵呵呵……开始神志不清了吗……那么就给你最后一击吧。』" voices=""/><msg @l="1240" char_id="-1" frame_id="-1" name=""   text="当我像发烧一样宣告自己到达极限时，教授浮现出淫荡的笑容，像速射炮一样加快了腰部的律动。" voices=""/><msg @l="1241" char_id="-1" frame_id="-1" name=""   text="被强烈快速地顶弄使身体大幅上下晃动，每一次我所坐的桌子都发出吱吱嘎嘎的声响。" voices=""/><msg @l="1242" char_id="-1" frame_id="-1" name=""   text="但是……这些声音甚至都没有传入我的耳中，在痛苦与愉悦交织的奇妙麻痹感中，我将身体交给即将到来的高潮浪潮。" voices=""/><msg @l="1244" char_id="0" frame_id="-1" name="美帆"   text="『嗯啊、啊……不行……嗯，啊啊啊……要变、变得奇怪了……！！』" voices="miho07150"/><msg @l="1246" char_id="-1" frame_id="-1" name="朽木" text="『到极限了……我要射了！！』"   voices=""/><msg @l="1249" async="true" char_id="-1" frame_id="-1" name=""   text="射在哪里……？" voices=""/><select @l="1250"><menu @l="1253" label="EventLabel_105" text="射在里面"/><menu @l="1256" label="EventLabel_106" text="射在外面"/></select><label @l="1262" id="EventLabel_105"/><msg @l="1264" char_id="-1" frame_id="-1" name="朽木"   text="『唔……就这样，注入你的阴道内。』" voices=""/><wait_chgmv/><ev @l="1267" src="ev-008ax1"/><msg @l="1269" char_id="0" frame_id="-1" name="美帆" text="『诶……！？』"   voices="miho07160"/><msg @l="1271" char_id="-1" frame_id="-1" name=""   text="突然，在愉悦的间隙传来令人难以置信的话语，我一瞬间回到了现实。" voices=""/><msg @l="1273" char_id="0" frame_id="-1" name="美帆"   text="『不行……只有那个……只有那个请饶了我吧……会、会怀孕的！！』" voices="miho07170"/><msg @l="1275" char_id="-1" frame_id="-1" name="朽木" text="『唔，已经来不及了……哈！』"   voices=""/><msg @l="1277" char_id="0" frame_id="-1" name="美帆" text="『不啊啊啊啊啊啊！！』"   voices="miho07180"/><flash @l="1280" count="4" fade="100" image="white"/><wait_chgmv/><ev @l="1283" src="ev-008ax2z1"/><msg @l="1285" char_id="-1" frame_id="-1" name=""   text="咻咻咻咻，热烫的液体注入体内。" voices=""/><msg @l="1286" char_id="-1" frame_id="-1" name=""   text="滚烫的白浊液体喷洒在子宫最深处。" voices=""/><msg @l="1288" char_id="0" frame_id="-1" name="美帆"   text="『啊……啊啊……好多……都流进来了……』" voices="miho07190"/><msg @l="1290" char_id="0" frame_id="-1" name="美帆"   text="『射这么多的话……会、会怀上宝宝的……』" voices="miho07200"/><msg @l="1292" char_id="-1" frame_id="-1" name="" text="我体内的某样东西，又一次被破坏了。"   voices=""/><msg @l="1293" char_id="-1" frame_id="-1" name="" text="那是非常珍贵的东西。" voices=""/><msg @l="1294" char_id="-1" frame_id="-1" name=""   text="……朽木教授……毫不在意地将它踩在脚下。" voices=""/><goto @l="1297" label="EventLabel_107"/><label @l="1300" id="EventLabel_106"/><msg @l="1302" char_id="0" frame_id="-1" name="美帆"   text="『啊……啊啊，啊，啊……去了，去去去，啊啊！』" voices="miho07210"/><msg @l="1304" char_id="-1" frame_id="-1" name="朽木"   text="『为了庆祝这值得纪念的处女丧失时刻，我要把你弄得黏糊糊的。』" voices=""/><msg @l="1306" char_id="-1" frame_id="-1" name=""   text="教授说着从体内抽出肉棒，然后在我的肚子上重新握住它，激烈地套弄起来。" voices=""/><msg @l="1308" char_id="-1" frame_id="-1" name="朽木" text="『呃啊！』" voices=""/><flash @l="1311" count="4" fade="100" image="white"/><wait_chgmv/><ev @l="1314" src="ev-008ax2z2"/><msg @l="1316" char_id="-1" frame_id="-1" name=""   text="教授短促地叫了一声，腰部颤抖着，热棒前端喷出炙热的白色液体洒落在我身体上。" voices=""/><msg @l="1318" char_id="0" frame_id="-1" name="美帆"   text="『嗯……啊…………嗯咕…………。』" voices="miho07220"/><msg @l="1320" char_id="-1" frame_id="-1" name=""   text="我身体因高潮的余韵而颤抖着，对袭来的绝望感感到茫然。" voices=""/><msg @l="1321" char_id="-1" frame_id="-1" name=""   text="被蹂躏了处女之身……这样的念头直到此刻才如重担般压来。" voices=""/><msg @l="1323" char_id="-1" frame_id="-1" name="朽木"   text="『你的身体真是极品。沾满精液颤抖的样子也非常妖艳。』" voices=""/><msg @l="1325" char_id="-1" frame_id="-1" name=""   text="教授这样说着，用指尖挑起洒在我肚子上的一滴白浊液体……然后将其送到我的嘴边。" voices=""/><msg @l="1327" char_id="-1" frame_id="-1" name="朽木" text="『来……舔吧。』"   voices=""/><msg @l="1329" char_id="-1" frame_id="-1" name=""   text="感受到嘴边精液的触感，我微微皱起了眉头。" voices=""/><msg @l="1330" char_id="-1" frame_id="-1" name="" text="已经……我没有拒绝的余地了。"   voices=""/><msg @l="1331" char_id="-1" frame_id="-1" name=""   text="无论怎样拒绝，我已经没有什么可以守护的了。" voices=""/><msg @l="1333" char_id="0" frame_id="-1" name="美帆" text="『……。』"   voices="miho07230"/><msg @l="1335" char_id="-1" frame_id="-1" name=""   text="在逐渐远去的意识中，我缓缓地含住了朽木教授的手指。" voices=""/><label @l="1338" id="EventLabel_107"/><stopbgm @l="1341" fadeout="1000"/><clear @l="1344" class="all"/><end_scene @l="1347"/><msgshow @l="1350" show="true"/><wait_chgmv/><bg @l="1353" src="bg12"/><bgm @l="1356" src="bgm03" volume="1."/><description @l="1359" text="散らされたあと"/><msg @l="1361" char_id="0" frame_id="-1" name="美帆" text="『嗯……。』" voices=""/><msg @l="1363" char_id="0" frame_id="-1" name="美帆" text="『咦……我……？』"   voices=""/><char @l="1366" id="kutsu" pos="left" src="kutsu010"/><msg @l="1368" char_id="-1" frame_id="-1" name="朽木" text="『看来你醒了啊。』"   voices=""/><char @l="1371" id="miho" pos="right" src="miho005"/><msg @l="1373" char_id="0" frame_id="-1" name="美帆" text="『教授……我，为什么……。』"   voices=""/><msg @l="1375" char_id="-1" frame_id="-1" name="朽木"   text="『你刚才晕过去了。因为破身的疼痛和高潮的冲击啊。』" voices=""/><msg @l="1377" char_id="0" frame_id="-1" name="美帆" text="『晕过去……是吗，我……。』"   voices=""/><msg @l="1379" char_id="-1" frame_id="-1" name="朽木"   text="『比起这个，你要不要先穿上衣服？』" voices=""/><msg @l="1381" char_id="-1" frame_id="-1" name="朽木"   text="『你这副模样可没法开房门锁啊。』" voices=""/><char @l="1384" id="miho" pos="right" src="miho105"/><msg @l="1386" char_id="0" frame_id="-1" name="美帆" text="『啊……啊，啊啊！？』"   voices=""/><clear @l="1389" class="char"/><char @l="1391" id="kutsu" pos="auto" src="kutsu010"/><msg @l="1394" char_id="-1" frame_id="-1" name=""   text="我这才终于意识到自己全身赤裸，慌忙坐在了原地。" voices=""/><msg @l="1396" char_id="-1" frame_id="-1" name="朽木" text="『第四节课马上就要开始了。』"   voices=""/><msg @l="1398" char_id="-1" frame_id="-1" name="朽木"   text="『我也得去上课，你快点收拾好回去吧。』" voices=""/><msg @l="1400" char_id="0" frame_id="-1" name="美帆" text="『好、好的……。』"   voices=""/><msg @l="1402" char_id="-1" frame_id="-1" name=""   text="我伸手拿起沙发上脱下的衣服，急忙穿了起来。" voices=""/><msg @l="1404" char_id="-1" frame_id="-1" name="朽木" text="『……。』" voices=""/><msg @l="1406" char_id="-1" frame_id="-1" name="朽木"   text="『就那样就好……请你回答我一个问题。』" voices=""/><clear @l="1409" class="char"/><char @l="1411" id="kutsu" pos="left" src="kutsu010"/><char @l="1413" id="miho" pos="right" src="miho115"/><msg @l="1415" char_id="0" frame_id="-1" name="美帆" text="『……？』" voices=""/><bgm @l="1418" src="bgm15" volume="1."/><msg @l="1420" char_id="-1" frame_id="-1" name="朽木"   text="『你有没有兴趣，专门为我提供你的身体？』" voices=""/><char @l="1423" id="miho" pos="right" src="miho015"/><msg @l="1425" char_id="0" frame_id="-1" name="美帆"   text="『诶……这是什么意思？』" voices=""/><msg @l="1427" char_id="-1" frame_id="-1" name="朽木" text="『你拥有最完美的身体。』"   voices=""/><msg @l="1429" char_id="-1" frame_id="-1" name="朽木"   text="『如果你能成为我的专属……没错，我不仅会为仲根启三先生提供支持，还会照顾你自己的未来。』"   voices=""/><msg @l="1431" char_id="0" frame_id="-1" name="美帆" text="『………。』" voices=""/><msg @l="1433" char_id="-1" frame_id="-1" name="朽木"   text="『距离你父亲退休还有十多年。』" voices=""/><msg @l="1435" char_id="-1" frame_id="-1" name="朽木"   text="『在这期间，你是想一边担心父亲的处境，一边继续活在对我言语的恐惧中吗？』" voices=""/><char @l="1438" id="miho" pos="right" src="miho115"/><msg @l="1440" char_id="0" frame_id="-1" name="美帆" text="『这是……。』"   voices=""/><msg @l="1442" char_id="-1" frame_id="-1" name="朽木"   text="『但是，如果你愿意专门侍奉于我，我可以保证给你比现在更好的待遇。』" voices=""/><msg @l="1444" char_id="0" frame_id="-1" name="美帆"   text="『但是……那就是说，我将成为教授的……。』" voices=""/><msg @l="1446" char_id="-1" frame_id="-1" name="朽木" text="『成为我的情人。』"   voices=""/><msg @l="1448" char_id="0" frame_id="-1" name="美帆" text="『这种事……。』"   voices=""/><msg @l="1450" char_id="-1" frame_id="-1" name="朽木" text="『做出选择吧。』"   voices=""/><msg @l="1452" char_id="-1" frame_id="-1" name="朽木"   text="『是全心全意为我服务……还是在恐惧中战栗，继续过着只提供身体的日子。』" voices=""/><msg @l="1454" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="1457" async="true" char_id="-1" frame_id="-1" name=""   text="成为朽木的专属奴隶……？" voices=""/><select @l="1458"><menu @l="1461" label="EventLabel_108" text="接受"/><menu @l="1464" label="EventLabel_109" text="拒绝"/></select><label @l="1470" id="EventLabel_108"/><char @l="1473" id="miho" pos="right" src="miho015"/><msg @l="1475" char_id="0" frame_id="-1" name="美帆"   text="『我……我明白了，请让我……成为教授的情人。』" voices=""/><msg @l="1477" char_id="-1" frame_id="-1" name="朽木"   text="『呵呵，我一直相信你一定会这么说的。』" voices=""/><msg @l="1479" char_id="-1" frame_id="-1" name="朽木"   text="『那么你去上课吧。当我想要拥抱你的身体时……我会给你的手机发邮件的。』" voices=""/><char @l="1482" id="miho" pos="right" src="miho115"/><msg @l="1484" char_id="0" frame_id="-1" name="美帆" text="『是的……。』" voices=""/><clear @l="1487" class="all"/><msg @l="1489" char_id="-1" frame_id="-1" name=""   text="就这样，我带着痛苦的表情离开了教授室。" voices=""/><msg @l="1490" char_id="-1" frame_id="-1" name="" text="只能这样做了。" voices=""/><msg @l="1491" char_id="-1" frame_id="-1" name=""   text="我一边说服自己，反正……自己已经没有什么可以失去的了。" voices=""/><stopbgm @l="1494" fadeout="1000"/><clear @l="1497" class="all"/><call @l="1500" target="EventLabel_111@root_kutuki02a"/><return @l="1501" value="0&#13;&#10;"/><label @l="1505" id="EventLabel_109"/><char @l="1508" id="miho" pos="right" src="miho015"/><msg @l="1510" char_id="0" frame_id="-1" name="美帆" text="『那……我做不到。』"   voices=""/><char @l="1513" id="kutsu" pos="left" src="kutsu014"/><msg @l="1515" char_id="-1" frame_id="-1" name="朽木"   text="『为什么？只要你一心一意，就能从无谓的恐惧中解放出来啊？』" voices=""/><msg @l="1517" char_id="0" frame_id="-1" name="美帆"   text="『我会继续好好遵守与教授签订的契约。』" voices=""/><msg @l="1519" char_id="0" frame_id="-1" name="美帆"   text="『但是，我……不会让我的心也成为奴隶。』" voices=""/><char @l="1522" id="kutsu" pos="left" src="kutsu010"/><msg @l="1524" char_id="-1" frame_id="-1" name="朽木"   text="『哼，就是这种愚蠢的自尊心会让你后悔的。』" voices=""/><msg @l="1526" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="1528" char_id="-1" frame_id="-1" name="朽木"   text="『算了……那你赶紧去上课吧。』" voices=""/><msg @l="1530" char_id="-1" frame_id="-1" name="朽木"   text="『好好在每天的恐惧中体会你选择的愚蠢吧。』" voices=""/><char @l="1533" id="miho" pos="right" src="miho115"/><msg @l="1535" char_id="0" frame_id="-1" name="美帆" text="『失礼……了。』"   voices=""/><clear @l="1538" class="all"/><msg @l="1540" char_id="-1" frame_id="-1" name=""   text="我带着恐惧离开了教授室，他的话语深深刺入我的心。" voices=""/><msg @l="1541" char_id="-1" frame_id="-1" name=""   text="我想要守护的是父亲，为此我献出了自己的身体。" voices=""/><msg @l="1542" char_id="-1" frame_id="-1" name=""   text="但是，我不想连心也一起献出。因为我觉得如果连心也献出去，就会搞不清自己到底在守护什么……。"   voices=""/><stopbgm @l="1545" fadeout="1000"/><clear @l="1548" class="all"/><call @l="1551" target="EventLabel_113@root_kutuki02c"/><return @l="1552" value="0&#13;&#10;"/><label @l="1556" id="EventLabel_110"/><msg @l="1558" char_id="0" frame_id="-1" name="美帆"   text="『我、我……果然不能服从这种事！』" voices=""/><msg @l="1560" char_id="-1" frame_id="-1" name="" text="那已经接近一种冲动了。"   voices=""/><msg @l="1561" char_id="-1" frame_id="-1" name=""   text="我甩开教授环在我腰上的手，后退两三步拉开了距离。" voices=""/><char @l="1564" id="kutsu" pos="auto" src="kutsu014"/><msg @l="1566" char_id="-1" frame_id="-1" name="朽木"   text="『哼……你知道你在做什么吗！？』" voices=""/><msg @l="1568" char_id="-1" frame_id="-1" name="朽木"   text="『如果不听从我的话，你的父亲……你的家人肯定会走向毁灭的！？』" voices=""/><clear @l="1571" class="char"/><char @l="1573" id="kutsu" pos="left" src="kutsu014"/><char @l="1575" id="miho" pos="right" src="miho115"/><msg @l="1577" char_id="0" frame_id="-1" name="美帆"   text="『这种话果然无法相信！』" voices=""/><msg @l="1579" char_id="0" frame_id="-1" name="美帆"   text="『父亲被裁员的事，爸爸也什么都没说过……。』" voices=""/><char @l="1581" id="kutsu" pos="left" src="kutsu010"/><msg @l="1583" char_id="-1" frame_id="-1" name="朽木"   text="『哪有父母会特意说些让自己女儿担忧的事呢。』" voices=""/><msg @l="1585" char_id="-1" frame_id="-1" name="朽木"   text="『现在我还可以原谅你。听我的话吧。』" voices=""/><msg @l="1587" char_id="-1" frame_id="-1" name=""   text="教授说着伸出手，一步一步地缩短着距离。" voices=""/><char @l="1590" id="miho" pos="right" src="miho015"/><msg @l="1592" char_id="0" frame_id="-1" name="美帆" text="『请不要过来！』"   voices=""/><msg @l="1594" char_id="0" frame_id="-1" name="美帆"   text="『如果再靠近我的话，我就要尖叫了。』" voices=""/><char @l="1597" id="kutsu" pos="left" src="kutsu014"/><msg @l="1599" char_id="-1" frame_id="-1" name="朽木" text="『……什么？』"   voices=""/><msg @l="1601" char_id="0" frame_id="-1" name="美帆"   text="『如果我现在在这里尖叫并胡乱作证……教授您是不是会被赶出这所大学？』" voices=""/><msg @l="1603" char_id="-1" frame_id="-1" name="朽木"   text="『你是想威胁我吗？ 威胁我这种人！？』" voices=""/><msg @l="1605" char_id="0" frame_id="-1" name="美帆" text="『才不是……』"   voices=""/><msg @l="1607" char_id="0" frame_id="-1" name="美帆"   text="『我只是希望您停止这种愚蠢的行为。』" voices=""/><msg @l="1609" char_id="0" frame_id="-1" name="美帆" text="『这种事……是错误的！』"   voices=""/><char @l="1612" id="kutsu" pos="left" src="kutsu018"/><msg @l="1614" char_id="-1" frame_id="-1" name="朽木"   text="『愚蠢的行为？ 错误的？』" voices=""/><msg @l="1616" char_id="-1" frame_id="-1" name="朽木"   text="『呵呵……你之所以能这么说，是因为你不了解这个城镇的事情。』" voices=""/><msg @l="1618" char_id="0" frame_id="-1" name="美帆" text="『那……是什么意思？』"   voices=""/><char @l="1621" id="kutsu" pos="left" src="kutsu010"/><msg @l="1623" char_id="-1" frame_id="-1" name="朽木" text="『哼，谁知道呢。』"   voices=""/><msg @l="1625" char_id="-1" frame_id="-1" name="朽木"   text="『算了。既然你采取这种态度，我也有我的打算。』" voices=""/><char @l="1628" id="miho" pos="right" src="miho115"/><msg @l="1630" char_id="0" frame_id="-1" name="美帆"   text="『哼，威胁我也没用……就算父亲被裁员，他也有能力靠自己的力量解决问题。』" voices=""/><msg @l="1632" char_id="-1" frame_id="-1" name="朽木"   text="『呵呵，我很期待。』" voices=""/><msg @l="1634" char_id="-1" frame_id="-1" name="朽木"   text="『你一定……会在不久后来向我请求原谅的。』" voices=""/><clear @l="1637" layer="kutsu"/><msg @l="1639" char_id="-1" frame_id="-1" name=""   text="说完这话如同撂下狠话，朽木教授转身离去。" voices=""/><msg @l="1641" char_id="0" frame_id="-1" name="美帆" text="（那、那种事……肯定是骗人的）"   voices=""/><msg @l="1643" char_id="0" frame_id="-1" name="美帆"   text="（爸爸并不需要依靠那种人……一定没问题的）" voices=""/><msg @l="1645" char_id="-1" frame_id="-1" name=""   text="我盯着教授远去的背影，像是在自言自语地对自己说道。" voices=""/><stopbgm @l="1648" fadeout="1000"/><clear @l="1651" class="all"/><msgshow @l="1653" show="true"/><wait_chgmv/><bg @l="1656" src="bg01b"/><bgm @l="1659" src="bgm03" volume="1."/><msg @l="1661" char_id="0" frame_id="-1" name="美帆" text="『啊……这是什么意思？』"   voices=""/><char @l="1664" id="miho" pos="auto" src="miho034"/><msg @l="1666" char_id="-1" frame_id="-1" name=""   text="晚上，吃完晚饭的我因为担心给家里打了电话。" voices=""/><msg @l="1667" char_id="-1" frame_id="-1" name=""   text="似乎父亲不在家，接电话的是我妹妹亚季奈。" voices=""/><msg @l="1669" char_id="2" frame_id="-1" name="亚季奈"   text="『所以，爸爸……已经不能工作了……』" voices=""/><msg @l="1671" char_id="0" frame_id="-1" name="美帆"   text="『怎么会，爸爸不是只是被裁员了吗？』" voices=""/><msg @l="1673" char_id="2" frame_id="-1" name="亚季奈"   text="『不是……爸爸，好像做了什么挪用公款的事。』" voices=""/><msg @l="1675" char_id="0" frame_id="-1" name="美帆"   text="『啊，挪用公款……你是说爸爸私自用了公司的钱！？』" voices=""/><msg @l="1677" char_id="-1" frame_id="-1" name=""   text="亚季奈对我的话小声回答“好像是这样”。" voices=""/><char @l="1680" id="miho" pos="auto" src="miho035"/><msg @l="1682" char_id="0" frame_id="-1" name="美帆"   text="『但这种事怎么会……爸爸自己怎么说？』" voices=""/><msg @l="1684" char_id="2" frame_id="-1" name="亚季奈"   text="『我不太清楚……妈妈说爸爸在公司被警察抓了，现在正在接受审讯。』" voices=""/><char @l="1687" id="miho" pos="auto" src="miho135"/><msg @l="1689" char_id="0" frame_id="-1" name="美帆" text="『怎么会这样……』"   voices=""/><msg @l="1691" char_id="-1" frame_id="-1" name="" text="这简直是最糟糕的情况。"   voices=""/><msg @l="1692" char_id="-1" frame_id="-1" name=""   text="关于父亲被裁员的事，似乎我已经在几天前就被告知了。" voices=""/><msg @l="1693" char_id="-1" frame_id="-1" name=""   text="但是，今天下午这事突然变成了挪用公款之类的说法，转眼间就变成了警方案件。" voices=""/><msg @l="1694" char_id="-1" frame_id="-1" name=""   text="很明显……不得不感觉到这其中有人为因素。" voices=""/><msg @l="1696" char_id="0" frame_id="-1" name="美帆" text="（这一切……都是我的错吗？）"   voices=""/><msg @l="1698" char_id="0" frame_id="-1" name="美帆"   text="（是因为我违背了与朽木教授的约定……！？）" voices=""/><msg @l="1700" char_id="2" frame_id="-1" name="亚季奈" text="『姐姐……？』"   voices=""/><char @l="1703" id="miho" pos="auto" src="miho035"/><msg @l="1705" char_id="0" frame_id="-1" name="美帆" text="『啊，嗯……对不起。』"   voices=""/><msg @l="1707" char_id="2" frame_id="-1" name="亚季奈"   text="『姐姐，爸爸没有做坏事吧？ 他什么都没做吧？』" voices=""/><char @l="1710" id="miho" pos="auto" src="miho036"/><msg @l="1712" char_id="0" frame_id="-1" name="美帆" text="『……嗯，没事的。』"   voices=""/><msg @l="1714" char_id="0" frame_id="-1" name="美帆"   text="『爸爸，绝对会回来的……亚季奈不要担心。』" voices=""/><msg @l="1716" char_id="2" frame_id="-1" name="亚季奈" text="『嗯……』" voices=""/><msg @l="1718" char_id="-1" frame_id="-1" name=""   text="亚季奈用带着哭腔的声音这样说着，在电话那头不断地抽鼻子。" voices=""/><msg @l="1719" char_id="-1" frame_id="-1" name=""   text="父亲眼看就要被当作罪犯对待……不禁想哭也是正常的。" voices=""/><char @l="1722" id="miho" pos="auto" src="miho135"/><msg @l="1724" char_id="0" frame_id="-1" name="美帆" text="（……我不会再犹豫了）"   voices=""/><msg @l="1726" char_id="0" frame_id="-1" name="美帆"   text="（我怎么样都无所谓……所以，一定要救爸爸他们）" voices=""/><msg @l="1728" char_id="-1" frame_id="-1" name=""   text="我一边安慰着在电话那头抽泣的亚季奈，一边在心中默默发誓。" voices=""/><stopbgm @l="1731" fadeout="1000"/><clear @l="1734" class="all"/><call @l="1738" target="EventLabel_112@root_kutuki02b"/><return @l="1739" value="0&#13;&#10;"/></code></xscript>																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																				