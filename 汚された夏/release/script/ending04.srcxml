<?xml version="1.0" encoding="utf-8"?><xscript><debug editor="&quot;C:\Program&#32;Files&#32;(x86)\sakura\sakura.exe&quot;&#32;&quot;%src%&quot;&#32;-Y=%line%"   src="D:\シロップ\町ぐるみの罠＋汚された夏セット版\汚された夏\完成データ\汚された夏\script\text\ending04.txt"/><code><label @l="12" id="EventLabel_42"/><description @l="16" text="性处理宠物亚季奈"/><eval @l="18" expr="f.numDay=0&#13;&#10;"/><wait_chgmv/><bg @l="22" src="bg07"/><bgm @l="26" src="bgm03" volume="1."/><char @l="30" id="miho" pos="auto" src="miho116"/><msg @l="32" char_id="0" frame_id="-1" name="美帆" text="『……。』"   voices="miho11490"/><msg @l="34" char_id="-1" frame_id="-1" name=""   text="自从与亚季奈发生那次轻微冲突后，已经过去一周了。" voices=""/><msg @l="35" char_id="-1" frame_id="-1" name=""   text="在那件事发生的第二天……当我来到室内游泳池时，等待着我的是渡部宣布从今天起解除我教练职务的话语。"   voices=""/><msg @l="36" char_id="-1" frame_id="-1" name="" text="没有任何解释。" voices=""/><msg @l="37" char_id="-1" frame_id="-1" name=""   text="只是被告知已经不再需要我了，然后话题就被终止了。" voices=""/><msg @l="38" char_id="-1" frame_id="-1" name=""   text="当然我尝试向亚季奈询问，但结果和那天一样，被她避开了。" voices=""/><msg @l="39" char_id="-1" frame_id="-1" name=""   text="然后……游泳部的集训期宣告结束。" voices=""/><msg @l="40" char_id="-1" frame_id="-1" name="" text="最终，我什么都没能对亚季奈说。"   voices=""/><msg @l="42" char_id="0" frame_id="-1" name="美帆" text="(亚季奈……我，只是在多管闲事吗？)"   voices="miho11500"/><msg @l="44" char_id="0" frame_id="-1" name="美帆" text="(真的只是……给你添麻烦了吗？)"   voices="miho11510"/><msg @l="46" char_id="-1" frame_id="-1" name=""   text="站在通往亚季奈他们使用的宿舍的路上，我在心中询问着。" voices=""/><msg @l="47" char_id="-1" frame_id="-1" name=""   text="但是，亚季奈已经不会再回到那个宿舍了。" voices=""/><msg @l="48" char_id="-1" frame_id="-1" name="" text="也不会回到……我的身边。" voices=""/><stopbgm @l="52" fadeout="1000"/><clear @l="58" class="all"/><label @l="61" id="event_scene23"/><msg @l="63" char_id="-1" frame_id="-1" name="" text="———放学后·教室" voices=""/><label @l="67" id="chart_line19"/><wait_chgmv/><ev @l="71" src="ev-023"/><bgm @l="75" src="bgm14" volume="1."/><msg @l="77" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯啊……好厉害，已经硬邦邦了呢。』" voices="akina03870"/><msg @l="79" char_id="-1" frame_id="-1" name=""   text="黄昏时分，教室的一角，穿着制服的亚季奈从含着的肉棒上移开了嘴。" voices=""/><msg @l="80" char_id="-1" frame_id="-1" name=""   text="确认一度释放后变软的阴茎再次恢复了力量，亚季奈高兴地笑了。" voices=""/><msg @l="81" char_id="-1" frame_id="-1" name=""   text="眼前并排站着两名男生，他们的肉棒赤裸裸地暴露出来，还在跳动着。" voices=""/><msg @l="82" char_id="-1" frame_id="-1" name=""   text="从她的嘴角，刚才喝下的白浊液体的残余正滴落下来。" voices=""/><msg @l="83" char_id="-1" frame_id="-1" name=""   text="从那天开始……自从宣布自己是母狗的那天起，亚季奈几乎每天都在渴求精液。" voices=""/><msg @l="84" char_id="-1" frame_id="-1" name=""   text="我是母狗所以要喝牛奶。仿佛从肉棒中喷出的牛奶理所当然应该被喝下一样。" voices=""/><msg @l="85" char_id="-1" frame_id="-1" name=""   text="这就是现在亚季奈的……作为母狗的行动原则。" voices=""/><msg @l="86" char_id="-1" frame_id="-1" name=""   text="放学后的教室被用作与游泳部成员们狂欢开始前的热身。" voices=""/><msg @l="88" char_id="-1" frame_id="-1" name="游泳部成员A"   text="『当然了。按照你的希望，我还能射更多呢。』" voices=""/><msg @l="90" char_id="-1" frame_id="-1" name="游泳部成员B"   text="『我啊，因为你说想喝很多，所以这三天左右都没手淫，一直在积攒着呢。』" voices=""/><msg @l="92" char_id="-1" frame_id="-1" name=""   text="听到这话的亚季奈爱怜地轻轻揉捏着他的阴囊。" voices=""/><msg @l="94" char_id="2" frame_id="-1" name="亚季奈"   text="『那么，这里面一定装满了热乎乎的牛奶呢。』" voices="akina03880"/><msg @l="96" char_id="-1" frame_id="-1" name="游泳部成员B"   text="『与其说是牛奶，不如说是炼乳吧？量也很充足哦。』" voices=""/><msg @l="98" char_id="-1" frame_id="-1" name=""   text="还没射精的那位自信满满地上下摇晃着肉棒。" voices=""/><msg @l="99" char_id="-1" frame_id="-1" name=""   text="听到这话的亚季奈脸上露出光彩，张口含住了他的阴囊。" voices=""/><msg @l="101" char_id="-1" frame_id="-1" name="游泳部成员A"   text="『哇……一上来就从睾丸袋开始啊。』" voices=""/><msg @l="103" char_id="-1" frame_id="-1" name=""   text="她嘴巴嘟嘟地动着下颚，口腔内舌头滚动着睾丸。" voices=""/><msg @l="105" char_id="-1" frame_id="-1" name="游泳部成员B"   text="『不愧是每天都在吸肉棒的人啊。对睾丸的处理手法很巧妙呢。』" voices=""/><msg @l="107" char_id="2" frame_id="-1" name="亚季奈"   text="『才不是每天呢……只有社团活动的日子才会啦。』" voices="akina03890"/><msg @l="109" char_id="-1" frame_id="-1" name=""   text="亚季奈停止了含吮，一脸仿佛受到了莫大冤枉般地否认道。" voices=""/><msg @l="111" char_id="-1" frame_id="-1" name="游泳部成员A"   text="反正没有社团活动的日子你就去吸渡部的那玩意儿了吧？" voices=""/><msg @l="113" char_id="2" frame_id="-1" name="亚季奈" text="『虽然是这样没错啦……』"   voices="akina03900"/><msg @l="115" char_id="-1" frame_id="-1" name="游泳部成员B"   text="『那不就还是每天嘛，搞什么啊。』" voices=""/><msg @l="117" char_id="-1" frame_id="-1" name=""   text="亚季奈想要抗议，但被说中了要害无法反驳。" voices=""/><msg @l="119" char_id="2" frame_id="-1" name="亚季奈" text="『呜——……』"   voices="akina03910"/><msg @l="121" char_id="-1" frame_id="-1" name=""   text="她无可奈何地撅起嘴唇，鼓起脸颊，一副赌气的样子。" voices=""/><msg @l="123" char_id="2" frame_id="-1" name="亚季奈"   text="『因为嘛——……我最喜欢这个了～』" voices="akina03920"/><msg @l="125" char_id="-1" frame_id="-1" name="" text="亚季奈干脆破罐子破摔，用脸颊蹭着那硕物。"   voices=""/><msg @l="126" char_id="-1" frame_id="-1" name=""   text="她陶醉地眯起眼睛，舌尖轻舔着前端。" voices=""/><msg @l="128" char_id="-1" frame_id="-1" name="游泳部成员A"   text="『嘿嘿……一脸馋相啊。』" voices=""/><msg @l="130" char_id="-1" frame_id="-1" name="游泳部成员B"   text="『别客气，尽管喝个够吧。』" voices=""/><msg @l="132" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯，啾——……不用你说，我也会舔的～』" voices="akina03930"/><msg @l="134" char_id="-1" frame_id="-1" name=""   text="回答得像个小孩子一样，亚季奈一口气将其中一根男根含到喉咙深处。" voices=""/><msg @l="135" char_id="-1" frame_id="-1" name=""   text="然后她撮起嘴唇紧紧包裹着柱身，快速地摆动起头来。" voices=""/><msg @l="137" char_id="2" frame_id="-1" name="亚季奈"   text="『唔嗯——……咕唔……啾，啾噗，啾噗，啾噗！』" voices="akina03940"/><msg @l="139" char_id="-1" frame_id="-1" name=""   text="为了不让刺激变得单调，她还不时地添加左右扭转的动作。" voices=""/><msg @l="141" char_id="-1" frame_id="-1" name="游泳部成员B"   text="『哇啊，等——太突然了！！』" voices=""/><msg @l="143" char_id="2" frame_id="-1" name="亚季奈"   text="『呵啊——不是说了让我尽情舔吗？』" voices="akina03950"/><msg @l="145" char_id="-1" frame_id="-1" name="游泳部成员B"   text="『话虽如此，这么快就射了不是很可惜吗？难得憋了这么久，好歹让我多享受一下啊。』" voices=""/><msg @l="147" char_id="2" frame_id="-1" name="亚季奈" text="『唔嗯——真是要求多多呢。』"   voices="akina03960"/><msg @l="149" char_id="-1" frame_id="-1" name="游泳部成员A"   text="『没关系啦，反正也不打算只做一次吧。』" voices=""/><msg @l="151" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯哼哼～——那这样如何啊？』" voices="akina03970"/><msg @l="153" char_id="-1" frame_id="-1" name=""   text="愉快地说着，亚季奈再次含住了龟头。" voices=""/><msg @l="155" char_id="2" frame_id="-1" name="亚季奈"   text="『啊～嗯……啾噗啾噗啾噗………啾，啾噜噜噜。』" voices="akina03980"/><msg @l="157" char_id="-1" frame_id="-1" name=""   text="她将舌头紧贴在龟头上吸吮，同时轻柔地按摩着阴茎下方的筋络。" voices=""/><msg @l="159" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯咕，嗯啾，啾噗，啾噗，啾噗……嗯噗啊！』" voices="akina03990"/><msg @l="161" char_id="-1" frame_id="-1" name=""   text="亚季奈像是在玩弄含在口中的肉茎，利用积聚起来的唾液，慢慢地缠绕着马眼继续吮吸。" voices=""/><msg @l="162" char_id="-1" frame_id="-1" name=""   text="从嘴唇缝隙间传出的水声和喘息声，将教室变成了一个淫靡的世界。" voices=""/><msg @l="164" char_id="-1" frame_id="-1" name="游泳部成员A"   text="『对对……那样很好……爽死了。』" voices=""/><msg @l="166" char_id="-1" frame_id="-1" name=""   text="她那淫靡的嘴唇收紧挤压着肉茎，在唾液中游动的舌尖试图钻入马眼。" voices=""/><msg @l="167" char_id="-1" frame_id="-1" name=""   text="当黏液从马眼流出时，蠕动的舌头开始搅拌唾液与前列腺液的混合物。" voices=""/><msg @l="168" char_id="-1" frame_id="-1" name=""   text="唾液中带上了苦味，亚季奈却像品尝美食一样发出咕噜声吞了下去。" voices=""/><msg @l="170" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯呼……啊呼……嗯咕，嗯噗，嗯噗……噗啊。』" voices="akina04000"/><msg @l="172" char_id="2" frame_id="-1" name="亚季奈"   text="『好厉害，变得这么硬……嗯呼……舔，舔。』" voices="akina04010"/><msg @l="174" char_id="-1" frame_id="-1" name=""   text="她用舌头细心地舔舐流出的前液，仿佛在惜惜不要浪费。" voices=""/><msg @l="176" char_id="-1" frame_id="-1" name="游泳部成员A"   text="『那，那个……也差不多该轮到我了吧。』" voices=""/><msg @l="178" char_id="-1" frame_id="-1" name="" text="他向亚季奈提出了第二轮的要求。"   voices=""/><msg @l="180" char_id="2" frame_id="-1" name="亚季奈" text="『好～的。』"   voices="akina04020"/><msg @l="182" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯噗……嗯，啾噗，啾噗，嗯咕……啾噜噜。』" voices="akina04030"/><msg @l="184" char_id="-1" frame_id="-1" name=""   text="她离开了刚才吮吸的那根，同样的方式含住了另一根等待着的肉棒。" voices=""/><msg @l="185" char_id="-1" frame_id="-1" name=""   text="这次她从一开始就缓慢地像是怜爱般缠绕着舌头，用嘴唇和口中积蓄的唾液爱抚着。" voices=""/><msg @l="187" char_id="-1" frame_id="-1" name="游泳部成员A"   text="『哦哦……太厉害了，果然你最棒了！』" voices=""/><msg @l="189" char_id="2" frame_id="-1" name="亚季奈" text="『噗啊……这么舒服吗？』"   voices="akina04040"/><msg @l="191" char_id="-1" frame_id="-1" name=""   text="亚季奈眼中含着水光，脸颊泛红，开心地问道。" voices=""/><msg @l="193" char_id="-1" frame_id="-1" name="游泳部成员A"   text="『无可挑剔！我都想让你每天帮我吸呢。』" voices=""/><msg @l="195" char_id="2" frame_id="-1" name="亚季奈"   text="『诶嘿嘿……因为很开心，所以要给你特别服务！』" voices="akina04050"/><msg @l="197" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯～……嗯姆……嗯，嗯噗，嗯噗……嗯，嗯姆。』" voices="akina04060"/><msg @l="199" char_id="-1" frame_id="-1" name=""   text="亚季奈以深长的起伏动作，将肉柱深深地吞入口中。" voices=""/><msg @l="200" char_id="-1" frame_id="-1" name=""   text="口腔已经无法容纳，前端甚至到达了喉咙深处。" voices=""/><msg @l="201" char_id="-1" frame_id="-1" name=""   text="当她感觉到龟头抵达咽喉时，便动起喉咙，用粘膜轻柔地包裹住它。" voices=""/><msg @l="203" char_id="-1" frame_id="-1" name="游泳部成员A"   text="『呜啊……这就是所谓的深喉吧？』" voices=""/><msg @l="205" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯咕………嗯嗯……嗯姆……噗啊！！』" voices="akina04070"/><msg @l="207" char_id="2" frame_id="-1" name="亚季奈" text="『哈呼……怎么样，舒服吗？』"   voices="akina04080"/><msg @l="209" char_id="-1" frame_id="-1" name="游泳部成员A"   text="『嗯，太厉害了……真的太厉害了。』" voices=""/><msg @l="211" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯哼哼……不过，服务到此为止了哦。』" voices="akina04090"/><msg @l="213" char_id="2" frame_id="-1" name="亚季奈"   text="『我……差不多，想喝牛奶了呢。』" voices="akina04100"/><msg @l="215" char_id="-1" frame_id="-1" name=""   text="亚季奈将食指贴在嘴唇上，微微抬头用眼神恳求着精液。" voices=""/><msg @l="217" char_id="-1" frame_id="-1" name="游泳部成员A"   text="『啊啊，会让你喝个够的。』" voices=""/><msg @l="219" char_id="-1" frame_id="-1" name="游泳部成员B"   text="『作为回报，你可要好好榨干我们哦。』" voices=""/><msg @l="221" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯，我会把你们榨得一滴不剩的♪』" voices="akina04110"/><msg @l="223" char_id="-1" frame_id="-1" name=""   text="等待的时间结束了，亚季奈脸上浮现出满面笑容。" voices=""/><msg @l="224" char_id="-1" frame_id="-1" name=""   text="然后她精神饱满地吮吸着肉棒。" voices=""/><msg @l="226" char_id="2" frame_id="-1" name="亚季奈"   text="『啊呜……嗯咕，啾噗，啾噗，啾噗……啾噜噜。』" voices="akina04120"/><msg @l="228" char_id="-1" frame_id="-1" name=""   text="重新含住顶端后，亚季奈用她小巧的嘴唇和口腔技巧责弄着他们。" voices=""/><msg @l="229" char_id="-1" frame_id="-1" name=""   text="她用舌尖舔舐龟头的冠状沟，然后收紧嘴唇包裹住整个龟头。" voices=""/><msg @l="231" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯噗……嗯噗……嗯噗……啾噗……嗯，啾啪。』" voices="akina04130"/><msg @l="233" char_id="2" frame_id="-1" name="亚季奈"   text="『诶嘿……小鸡鸡的前端，流出苦苦的东西啦。』" voices="akina04140"/><msg @l="235" char_id="-1" frame_id="-1" name="游泳部成员A"   text="『哦，哦……好好品尝吧。』" voices=""/><msg @l="237" char_id="2" frame_id="-1" name="亚季奈"   text="『好~的……啊呜，嗯……啾……啾噜，嗯噗，嗯噗！』" voices="akina04150"/><msg @l="239" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯咕，嗯呜嗯呜……啾噗……啾噗，啾噗，啾噗！！』" voices="akina04160"/><msg @l="241" char_id="-1" frame_id="-1" name=""   text="嘴角流淌着起泡的白色液体，她发出淫靡的水声舔舐着肉棒。" voices=""/><msg @l="243" char_id="-1" frame_id="-1" name="游泳部成员B"   text="『来来，没被吸的肉棒要用手撸哦。』" voices=""/><msg @l="245" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯呜……嗯呼，嗯，嗯，嗯………嗯，啾噜噜。』" voices="akina04170"/><msg @l="247" char_id="-1" frame_id="-1" name="" text="他抓住亚季奈的手腕，引导她抚摸自己的肉棒。"   voices=""/><msg @l="248" char_id="-1" frame_id="-1" name=""   text="亚季奈将手指缠绕在肉柱上，弯曲食指开始挑逗铃口。" voices=""/><msg @l="249" char_id="-1" frame_id="-1" name=""   text="她以从刚才就一直流出的前液作为润滑油，发出咕啾咕啾的声音揉搓上去。" voices=""/><msg @l="250" char_id="-1" frame_id="-1" name=""   text="当然，她也没有忘记用口腔吮吸龟头。" voices=""/><msg @l="252" char_id="-1" frame_id="-1" name="游泳部成员A" text="『糟了……要，要射了。』"   voices=""/><msg @l="254" char_id="2" frame_id="-1" name="亚季奈" text="『嗯哈……那，这次换这边♪』"   voices="akina04180"/><msg @l="256" char_id="-1" frame_id="-1" name=""   text="当她含着的那根快要达到极限时，亚季奈恶作剧般地低语，将嘴巴凑到了刚才用手撸动的肉棒上。" voices=""/><msg @l="257" char_id="-1" frame_id="-1" name=""   text="对于刚刚离开嘴巴的那根，她同样缠绕着指尖，持续给予恰到好处的刺激，既不让它软下来，又不至于射精。" voices=""/><msg @l="258" char_id="-1" frame_id="-1" name="" text="亚季奈似乎希望两根能同时射精。"   voices=""/><msg @l="260" char_id="2" frame_id="-1" name="亚季奈"   text="『舔……嗯，咕……啾，啪，啪，啪，哈。』" voices="akina04190"/><msg @l="262" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯，舔舔舔舔……啾，嗯……啾噜。』" voices="akina04200"/><msg @l="264" char_id="-1" frame_id="-1" name="游泳部成员B"   text="『哇啊，肉棒背面……是我的弱点啊。一直舔那里……啊！！』" voices=""/><msg @l="266" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯哈……诶嘿嘿～，受不了了吧？』" voices="akina04210"/><msg @l="268" char_id="2" frame_id="-1" name="亚季奈"   text="『不过，我会让你更加无法忍耐的哦～。』" voices="akina04220"/><msg @l="270" char_id="-1" frame_id="-1" name=""   text="亚季奈恶作剧般地这样说着，重新含住龟头，紧紧地闭合嘴唇……然后只对龟头部分进行来回吞吐，前后摆动着头部。"   voices=""/><msg @l="272" char_id="2" frame_id="-1" name="亚季奈"   text="『啊呜，嗯……啾噗，啾噗，啾噗，啾噗，啾噗。』" voices="akina04230"/><msg @l="274" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯嗯……嗯噗，嗯噗，嗯噗……嗯，啾啪！！』" voices="akina04240"/><msg @l="276" char_id="-1" frame_id="-1" name="游泳部成员B"   text="『这，太，太厉害了……啊啊！！』" voices=""/><msg @l="278" char_id="-1" frame_id="-1" name=""   text="其中一名男生发出了可怜的声音，腰部颤抖起来。" voices=""/><msg @l="279" char_id="-1" frame_id="-1" name="" text="看来已经到极限了。" voices=""/><msg @l="281" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯呼……可以哦，射出来吧……嗯啾……。』" voices="akina04250"/><msg @l="283" char_id="2" frame_id="-1" name="亚季奈"   text="『就这样……嗯，在我的嘴巴和脸上射出满满的牛奶吧。』" voices="akina04260"/><msg @l="285" char_id="-1" frame_id="-1" name="" text="她用妩媚的声音索求着射精。"   voices=""/><msg @l="286" char_id="-1" frame_id="-1" name=""   text="亚季奈大概是想品尝这经过三天时间精心酝酿的精液吧，她再次将那根吞入，更加激烈地吮吸起来。"   voices=""/><msg @l="288" char_id="2" frame_id="-1" name="亚季奈"   text="『啾啪……嗯，呼……嗯噗，嗯噗，嗯噗，嗯噗！』" voices="akina04270"/><msg @l="290" char_id="2" frame_id="-1" name="亚季奈"   text="『啾噗，啾噗，啾噗，啾噗，啾噗……嗯，啾噜噜！！』" voices="akina04280"/><msg @l="292" char_id="-1" frame_id="-1" name="游泳部成员A" text="『啊，要射了！！』"   voices=""/><msg @l="294" char_id="-1" frame_id="-1" name="游泳部成员B" text="『哦哦……要，出来了！！』"   voices=""/><flash @l="298" count="4" fade="100" image="white"/><wait_chgmv/><ev @l="302" src="ev-023z1"/><msg @l="304" char_id="2" frame_id="-1" name="亚季奈" text="『嗯呜呜呜！！』"   voices="akina04290"/><msg @l="306" char_id="-1" frame_id="-1" name="" text="两名男生同时腰部颤抖起来。"   voices=""/><msg @l="307" char_id="-1" frame_id="-1" name=""   text="一个人射在了口腔里，另一个人则对准了脸部喷出热腾腾的白浊液体。" voices=""/><msg @l="309" char_id="2" frame_id="-1" name="亚季奈"   text="『嗯噗……嗯，嗯………嗯嗯…………。』" voices="akina04300"/><msg @l="311" char_id="-1" frame_id="-1" name=""   text="亚季奈用喉咙深处接住了积攒三天的浓稠精液。" voices=""/><msg @l="312" char_id="-1" frame_id="-1" name=""   text="被近乎固态的精液击打喉咙的触感让她浑身颤抖。" voices=""/><msg @l="313" char_id="-1" frame_id="-1" name=""   text="她用舌头收集口腔内的精液，连同粘在喉咙上的一起咽了下去。" voices=""/><msg @l="315" char_id="-1" frame_id="-1" name="游泳部成员A"   text="『剩下的也会好好吸干净吧？』" voices=""/><msg @l="317" char_id="-1" frame_id="-1" name="游泳部成员B"   text="『对啊，口交后的清理是基本礼仪啊。』" voices=""/><msg @l="319" char_id="2" frame_id="-1" name="亚季奈"   text="『哎呀，不用你们说我也知道啦。』" voices="akina04310"/><msg @l="321" char_id="2" frame_id="-1" name="亚季奈"   text="『啊呣……嗯咕……啾噗，啾噗……嗯，啾噗噗噗。』" voices="akina04320"/><msg @l="323" char_id="-1" frame_id="-1" name=""   text="她将嘴唇贴在射精后还在一张一合的铃口上，吮吸着残留的精液。" voices=""/><msg @l="324" char_id="-1" frame_id="-1" name="" text="…………" voices=""/><msg @l="325" char_id="-1" frame_id="-1" name="" text="…………" voices=""/><msg @l="326" char_id="-1" frame_id="-1" name="" text="………" voices=""/><msg @l="327" char_id="-1" frame_id="-1" name="" text="…" voices=""/><msg @l="329" char_id="-1" frame_id="-1" name=""   text="即使已经吸完了所有的精液，亚季奈却仿佛还在索求更多一般，舔舐的动作丝毫没有停下。" voices=""/><msg @l="331" char_id="-1" frame_id="-1" name="游泳部成员A"   text="『话说，你真的很喜欢口交呢。』" voices=""/><msg @l="333" char_id="-1" frame_id="-1" name="游泳部成员B"   text="『啊……不愧是渡部的宠物啊。』" voices=""/><msg @l="335" char_id="2" frame_id="-1" name="亚季奈"   text="『噗啊……不对啦，我才不是老师的宠物呢。』" voices="akina04330"/><msg @l="337" char_id="-1" frame_id="-1" name="游泳部成员A" text="『诶……？』"   voices=""/><msg @l="339" char_id="2" frame_id="-1" name="亚季奈" text="『因为……』"   voices="akina04340"/><stopbgm @l="343" fadeout="1000"/><clear @l="349" class="all"/><msg @l="351" char_id="2" frame_id="-1" name="亚季奈"   text="『因为我是游泳部大家的宠物嘛。』" voices="akina04350"/><msg @l="353" char_id="-1" frame_id="-1" name="" text="如果再让我喝一次，就去社团活动吧。"   voices=""/><msg @l="354" char_id="-1" frame_id="-1" name=""   text="大家都会让亚季奈喝到肚子装满为止。" voices=""/><msg @l="355" char_id="-1" frame_id="-1" name=""   text="无论是嘴巴，还是那里，还是屁股，都会被填满到溢出来为止……" voices=""/><msg @l="357" char_id="-1" frame_id="-1" name=""   text="微笑的亚季奈的眼眸中……充满了至福的喜悦………" voices=""/><clear @l="363" class="all"/><end_scene @l="366"/><eval @l="370" expr="s.flagGallery=1&#13;&#10;"/><eval @l="372" expr="s.event23flag=1&#13;&#10;"/><eval @l="376"   expr="f.bEx&#32;=&#32;s.event20flag&#32;&amp;&amp;&#32;s.event23flag&#32;&amp;&amp;&#32;s.event25flag&#32;&amp;&amp;&#32;s.event30flag&#32;&amp;&amp;&#32;s.event31flag&#32;&amp;&amp;&#32;s.event32flag&#32;&amp;&amp;&#32;s.event33flag&#32;&amp;&amp;&#32;s.event35flag&#32;&amp;&amp;&#32;s.event37flag&#32;&amp;&amp;&#32;s.event38flag&#32;&amp;&amp;&#32;s.event60flag&#13;&#10;"/><goto @l="378" cond="!(f.bEx)&#13;&#10;" label="TempLabel_233"/><eval @l="380" expr="s.exRootFlag=1&#13;&#10;"/><label @l="381" id="TempLabel_233"/><ending @l="383"/><goto @l="385" cond="!(f.bEx)&#13;&#10;" label="TempLabel_234"/><wait_chgmv/><bg @l="389" src="newroot"/><wait @l="391" time="5000"/><wait_chgmv/><bg @l="393" src="black"/><label @l="396" id="TempLabel_234"/><return @l="400" value=""/></code></xscript>																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																															