<?xml version="1.0" encoding="utf-8"?><xscript><debug editor="&quot;C:\Program&#32;Files&#32;(x86)\sakura\sakura.exe&quot;&#32;&quot;%src%&quot;&#32;-Y=%line%"   src="D:\シロップ\町ぐるみの罠＋汚された夏セット版\汚された夏\完成データ\汚された夏\script\text\common_root01.txt"/><code><label @l="17" id="EventLabel_19"/><description @l="22" text="开始之日"/><eval @l="24" expr="f.numDay=1&#13;&#10;"/><msgshow @l="26" show="false"/><wait_chgmv/><bg @l="28" src="day01" time="2000"/><wait @l="30" time="500"/><wait_chgmv/><bg @l="32" src="black" time="2000"/><msgshow @l="34" show="true"/><wait_chgmv/><bg @l="38" src="bg03"/><char @l="42" id="miho" pos="center" src="miho030"/><bgm @l="46" src="bgm02" volume="1."/><msg @l="48" char_id="0" frame_id="-1" name="美帆" text="『学姐，早餐做好了哦。』"   voices=""/><msg @l="50" char_id="0" frame_id="-1" name="美帆"   text="『会凉掉的，请尽快吃掉哦。』" voices=""/><msg @l="52" char_id="-1" frame_id="-1" name=""   text="我从厨房探出个脑袋，向正在客厅专注观看《早间特写！》的白石学姐喊道。" voices=""/><msg @l="53" char_id="-1" frame_id="-1" name="" text="从那令人惊讶的入住日算起，已经过去一个多月了。"   voices=""/><msg @l="54" char_id="-1" frame_id="-1" name=""   text="我渐渐习惯了这种同居生活，现在感觉我们的相处已经变得相对“自然”了……至少我是这么认为的。" voices=""/><msg @l="56" char_id="1" frame_id="-1" name="玲"   text="『谢谢。放在那里我会吃的。』" voices=""/><msg @l="58" char_id="0" frame_id="-1" name="美帆" text="『《特写》……好看吗？』"   voices=""/><msg @l="60" char_id="1" frame_id="-1" name="玲"   text="『虽然综艺元素比较强……但还算挺有意思的。』" voices=""/><char @l="64" id="miho" pos="center" src="miho036"/><msg @l="66" char_id="0" frame_id="-1" name="美帆"   text="『嗯～…我不是很懂就是了……』" voices=""/><clear @l="69" class="char"/><char @l="71" id="miho" pos="left" src="miho036"/><char @l="73" id="rei" pos="right" src="rei031"/><msg @l="75" char_id="1" frame_id="-1" name="玲"   text="『嘛，它也会好好报道主要新闻，比起枯燥的新闻，这种方式更适合了解时事。我每天早上都不会错过占卜环节哦～。』"   voices=""/><msg @l="77" char_id="0" frame_id="-1" name="美帆" text="『呃，占卜吗……准确吗？』"   voices=""/><char @l="80" id="rei" pos="right" src="rei030"/><msg @l="82" char_id="1" frame_id="-1" name="玲" text="『这只是个心情问题罢了。』" voices=""/><msg @l="84" char_id="-1" frame_id="-1" name=""   text="白石学姐这么说着，从盘子上拿起吐司送入口中。" voices=""/><msg @l="85" char_id="-1" frame_id="-1" name=""   text="看着嘴上说着并不是很热衷，却依然目光专注地盯着电视的学姐，不知为何感觉很可爱。"   voices=""/><char @l="88" id="miho" pos="left" src="miho130"/><msg @l="90" char_id="0" frame_id="-1" name="美帆"   text="『那么我今天从第一节课开始上课，先去洗澡了。』" voices=""/><char @l="93" id="rei" pos="right" src="rei031"/><msg @l="95" char_id="1" frame_id="-1" name="玲" text="『没问题。我今天是从第三节课开始的。』"   voices=""/><msg @l="97" char_id="0" frame_id="-1" name="美帆" text="『学姐，您不进行就业活动吗？』"   voices=""/><msg @l="99" char_id="1" frame_id="-1" name="玲"   text="『哎呀，我看起来是这样，但其实我也有好好在找工作哦？』" voices=""/><msg @l="101" char_id="1" frame_id="-1" name="玲"   text="『现在只是在等招聘考试结果，所以稍微有点闲而已。』" voices=""/><msg @l="103" char_id="0" frame_id="-1" name="美帆"   text="『学姐，您学的是建筑专业吧？是想成为设计师吗？』" voices=""/><msg @l="105" char_id="1" frame_id="-1" name="玲"   text="『是啊。我的首选是这一带最大的大黑建设公司。』" voices=""/><msg @l="107" char_id="0" frame_id="-1" name="美帆"   text="『大黑建设，是不是那个协助引进大学到南总町的建筑公司？』" voices=""/><msg @l="109" char_id="1" frame_id="-1" name="玲"   text="『嗯。正好这周有第一轮考试。虽然还不是面试，只是笔试和报告而已。』" voices=""/><char @l="113" id="miho" pos="left" src="miho034"/><msg @l="115" char_id="0" frame_id="-1" name="美帆" text="『哇，这周就是了，好快啊。』"   voices=""/><msg @l="117" char_id="1" frame_id="-1" name="玲"   text="『女性的入职门槛比较高，从一开始就得打起精神。如果不表现出积极性，光看文件就会被刷掉的。』"   voices=""/><char @l="121" id="miho" pos="left" src="miho030"/><msg @l="123" char_id="0" frame_id="-1" name="美帆" text="『是这样啊……真不容易呢。』"   voices=""/><char @l="127" id="rei" pos="right" src="rei031"/><msg @l="129" char_id="1" frame_id="-1" name="玲"   text="『哎呀，你要是像旁观者一样想着，明年就要吃苦头了哦。』" voices=""/><char @l="133" id="miho" pos="left" src="miho036"/><msg @l="135" char_id="0" frame_id="-1" name="美帆"   text="『别、别说这么可怕的话啊……』" voices=""/><msg @l="137" char_id="1" frame_id="-1" name="玲"   text="『呵呵，开玩笑的……不过提早行动总是好的。』" voices=""/><char @l="141" id="rei" pos="right" src="rei030"/><msg @l="143" char_id="1" frame_id="-1" name="玲"   text="『尤其是早点和学科教授建立人脉，以后就轻松多了。』" voices=""/><char @l="147" id="miho" pos="left" src="miho034"/><msg @l="149" char_id="0" frame_id="-1" name="美帆" text="『人脉……吗。』"   voices=""/><char @l="153" id="miho" pos="left" src="miho036"/><msg @l="155" char_id="0" frame_id="-1" name="美帆" text="『我，不太擅长这种事……』"   voices=""/><msg @l="157" char_id="0" frame_id="-1" name="美帆"   text="『总感觉不是靠自己的实力在竞争，有点像作弊一样。』" voices=""/><msg @l="159" char_id="1" frame_id="-1" name="玲" text="『……唉。』" voices=""/><msg @l="161" char_id="1" frame_id="-1" name="玲" text="『你肯定是太老实了。』"   voices=""/><msg @l="163" char_id="1" frame_id="-1" name="玲"   text="『人类可不能只靠做正确的事生存，你最好放松一点，活得轻松些。』" voices=""/><msg @l="165" char_id="0" frame_id="-1" name="美帆" text="『我不……太明白。』"   voices=""/><msg @l="167" char_id="1" frame_id="-1" name="玲"   text="『嗯，我觉得不用急着明白也没关系。』" voices=""/><msg @l="169" char_id="1" frame_id="-1" name="玲"   text="『喂……不快点的话要迟到了哦。』" voices=""/><char @l="173" id="miho" pos="left" src="miho034"/><msg @l="175" char_id="0" frame_id="-1" name="美帆" text="『啊，好的……』"   voices=""/><clear @l="179" layer="miho"/><msg @l="181" char_id="1" frame_id="-1" name="玲" text="『………』" voices=""/><msg @l="183" char_id="1" frame_id="-1" name="玲" text="『……真好啊，这么青涩。』"   voices=""/><clear @l="189" class="all"/><msgshow @l="191" show="true"/><wait_chgmv/><bg @l="195" src="bg03"/><char @l="199" id="miho" pos="auto" src="miho010"/><msg @l="201" char_id="0" frame_id="-1" name="美帆" text="『那，我出门了。』"   voices=""/><msg @l="203" char_id="-1" frame_id="-1" name=""   text="洗完淋浴，整理好行装后，我回到客厅道别。" voices=""/><msg @l="204" char_id="-1" frame_id="-1" name=""   text="在老家一直都是这么做的，对我来说很平常，但白石学姐却说我“还是那么认真呢”。" voices=""/><msg @l="205" char_id="-1" frame_id="-1" name=""   text="因为已经习惯了，对我来说这很自然。这样，算是认真吗？" voices=""/><clear @l="208" class="char"/><char @l="210" id="miho" pos="left" src="miho010"/><char @l="213" id="rei" pos="right" src="rei030"/><msg @l="215" char_id="1" frame_id="-1" name="玲"   text="『路上小心。最近电车上的色狼好像增多了。』" voices=""/><char @l="219" id="miho" pos="left" src="miho016"/><msg @l="221" char_id="0" frame_id="-1" name="美帆" text="『色狼吗……真讨厌。』"   voices=""/><msg @l="223" char_id="1" frame_id="-1" name="玲"   text="『像你这样可爱又文静的孩子是最危险的。注意别被盯上。』" voices=""/><msg @l="225" char_id="0" frame_id="-1" name="美帆"   text="『啊……但是像我这样普通的人……』" voices=""/><msg @l="227" char_id="1" frame_id="-1" name="玲" text="『呵呵，总之要小心哦。』"   voices=""/><msg @l="229" char_id="0" frame_id="-1" name="美帆" text="『嗯，我，我会努力的。』"   voices=""/><clear @l="235" class="all"/><msgshow @l="237" show="true"/><msg @l="239" char_id="-1" frame_id="-1" name="" text="……………………" voices=""/><wait_chgmv/><bg @l="243" src="bg18m1"/><char @l="247" id="miho" pos="auto" src="miho110"/><msg @l="249" char_id="-1" frame_id="-1" name=""   text="比起一个月前，我迈着稍微熟练一些的步伐，朝着车站走去。" voices=""/><msg @l="250" char_id="-1" frame_id="-1" name=""   text="越靠近车站，准备乘坐同一班去大学的电车的同龄人就越多。" voices=""/><msg @l="251" char_id="-1" frame_id="-1" name=""   text="对不擅长人群的我来说，明知道会有通学高峰期却不得不乘电车的情况真的很痛苦。" voices=""/><msg @l="252" char_id="-1" frame_id="-1" name=""   text="在以前的学校，我会乘坐比正常时间早几班的电车去上学，但在这种一天班次极少的区间电车线路上也没办法。"   voices=""/><msg @l="253" char_id="-1" frame_id="-1" name=""   text="毕竟我现在要乘坐的电车是这条线路的始发车。" voices=""/><msg @l="254" char_id="-1" frame_id="-1" name=""   text="虽然坐下一班电车勉强也能赶上第一节课，但会比始发车更加拥挤。" voices=""/><msg @l="255" char_id="-1" frame_id="-1" name=""   text="这种根据地区设置的完全本地化电车，按目前的班次运行应该没问题，但还是希望他们能多考虑一下乘客的感受……"   voices=""/><wait_chgmv/><bg @l="259" src="bg21m1"/><char @l="263" id="miho" pos="auto" src="miho116"/><msg @l="265" char_id="0" frame_id="-1" name="美帆"   text="(唉……这一点真是怎么都让人郁闷啊)" voices=""/><msg @l="267" char_id="-1" frame_id="-1" name=""   text="刚在车站站台形成的电车等候队伍末尾排好队，我就轻轻地叹了口气。" voices=""/><msg @l="268" char_id="-1" frame_id="-1" name=""   text="很快电车就到了，队伍陆续流入车厢。" voices=""/><msg @l="269" char_id="-1" frame_id="-1" name=""   text="我也被后面的人催促着挤进了电车。" voices=""/><clear @l="275" class="all"/><label @l="278" id="event_scene05_1"/><msgshow @l="281" show="true"/><se @l="285" buf="3" loop="true" src="電車走行中" volume="1."/><msg @l="287" char_id="0" frame_id="-1" name="美帆" text="『………』"   voices="miho00160"/><label @l="291" id="chart_line3"/><eval @l="294" expr="s.event5flag=0&#13;&#10;"/><wait_chgmv/><ev @l="298" src="ev-005"/><msg @l="300" char_id="0" frame_id="-1" name="美帆" text="(人……还是一如既往地多啊)"   voices="miho00170"/><msg @l="302" char_id="0" frame_id="-1" name="美帆"   text="(而且总觉得最近男性乘客特别多……)" voices="miho00180"/><msg @l="304" char_id="-1" frame_id="-1" name=""   text="大概是从一周前开始，我感觉车厢内的男女比例在逐渐变化。" voices=""/><msg @l="305" char_id="-1" frame_id="-1" name=""   text="刚转学来的时候男女比例差不多，但从一周前开始，总觉得男性乘客变多了。" voices=""/><msg @l="307" char_id="0" frame_id="-1" name="美帆"   text="(说起来白石学姐说过这里会出现痴汉，大家是不是都在警惕这个，所以改变了乘车时间呢……)"   voices="miho00190"/><msg @l="309" char_id="-1" frame_id="-1" name=""   text="如果是这样的话，我是不是也得从明天起改变乘车时间呢。" voices=""/><msg @l="310" char_id="-1" frame_id="-1" name=""   text="坐满员电车当然很讨厌，但遇到痴汉是绝对不能接受的。" voices=""/><msg @l="312" char_id="0" frame_id="-1" name="美帆" text="(总之先观察一下情况，吧……)"   voices="miho00200"/><msg @l="314" char_id="-1" frame_id="-1" name=""   text="就在我恍惚地想着这些事情，任由身体随着电车的震动摇晃时，突然察觉到腰部附近有什么东西在蠕动。"   voices=""/><stopbgm @l="318" fadeout="1000"/><wait_chgmv/><ev @l="322" src="ev-005ax1"/><description @l="325" text="遭遇痴汉"/><msg @l="327" char_id="0" frame_id="-1" name="美帆" text="(诶……)"   voices="miho00210"/><msg @l="329" char_id="-1" frame_id="-1" name=""   text="起初我以为是后面乘客的包或什么东西碰到了我，但这动作对于一个包来说实在太奇怪了。" voices=""/><msg @l="330" char_id="-1" frame_id="-1" name=""   text="就在我困惑之际，那原本在腰部附近抚摸的东西，如同在试探般，慢慢地向臀部移动。" voices=""/><msg @l="332" char_id="0" frame_id="-1" name="美帆" text="(这是……痴汉……？？？)"   voices="miho00220"/><bgm @l="336" src="bgm15" volume="1."/><msg @l="338" char_id="0" frame_id="-1" name="美帆" text="(……该、该怎么办……)"   voices="miho00230"/><msg @l="340" char_id="-1" frame_id="-1" name=""   text="白石学姐刚刚才提醒我“要小心痴汉”，可是当我真实遭遇痴汉后，再怎么小心也无济于事了。"   voices=""/><msg @l="341" char_id="-1" frame_id="-1" name=""   text="也许我应该像其他女生一样调整上学的时间，但现在说这些都已经太晚了。" voices=""/><msg @l="343" char_id="0" frame_id="-1" name="美帆" text="(总、总之得想办法……)"   voices="miho00240"/><msg @l="347" async="true" char_id="-1" frame_id="-1" name=""   text="面对痴汉，我选择" voices=""/><select @l="348"><menu @l="350" label="EventLabel_20" text="反抗"/><menu @l="352" label="EventLabel_21" text="忍耐"/></select><label @l="359" id="EventLabel_20"/><msg @l="362" char_id="0" frame_id="-1" name="美帆" text="『住、住手请您……』"   voices="miho00250"/><msg @l="364" char_id="-1" frame_id="-1" name=""   text="我小声地喊着，扭动身体，试图摆脱那只在抚摸我臀部的痴汉的手。" voices=""/><msg @l="365" char_id="-1" frame_id="-1" name=""   text="也许我应该尖叫一声，但对于这种引人注目的行为，我内心总是本能地排斥，导致完全发不出声音来。"   voices=""/><msg @l="367" char_id="-1" frame_id="-1" name="痴汉" text="『…………。』" voices=""/><msg @l="369" char_id="-1" frame_id="-1" name="" text="一瞬间，痴汉在我耳边倒吸了一口气。"   voices=""/><msg @l="370" char_id="-1" frame_id="-1" name=""   text="我缩着肩膀，担心自己可能惹怒了他，但那只抚摸着我臀部的手却慢慢地移开了。" voices=""/><msg @l="371" char_id="-1" frame_id="-1" name=""   text="不太明白为什么，但看来我的反抗起了作用。" voices=""/><stopbgm @l="375" fadeout="1000"/><msg @l="377" char_id="0" frame_id="-1" name="美帆" text="（……太好了）"   voices="miho00260"/><msg @l="379" char_id="-1" frame_id="-1" name=""   text="我松了一口气，只是切切地祈祷这列电车能尽快到达大学。" voices=""/><clear @l="383" class="ev"/><goto @l="386" label="EventLabel_22"/><return @l="388" value=""/><label @l="392" id="EventLabel_21"/><msg @l="395" char_id="0" frame_id="-1" name="美帆"   text="(虽然想说请住手，但如果贸然吵闹可能会被周围的人注意到……)" voices="miho00270"/><msg @l="397" char_id="0" frame_id="-1" name="美帆"   text="（如果被注意到，大家就会知道是我被痴汉骚扰……）" voices="miho00280"/><msg @l="399" char_id="0" frame_id="-1" name="美帆"   text="(要是变成那样的话……我会羞耻得没法再坐电车了……)" voices="miho00290"/><wait_chgmv/><ev @l="403" src="ev-005ax2y1"/><msg @l="405" char_id="-1" frame_id="-1" name=""   text="痴汉确认我在默默忍耐后，伸手摸向了我的胸部。" voices=""/><msg @l="406" char_id="-1" frame_id="-1" name=""   text="那只手从腋下滑上来，隔着衣服贴上了我被纯白内衣包裹的胸部。" voices=""/><msg @l="408" char_id="0" frame_id="-1" name="美帆" text="『………嗯………。』"   voices="miho09930"/><msg @l="410" char_id="-1" frame_id="-1" name=""   text="我的身体瞬间颤抖了一下，但却无法做出更多抵抗，只能默默忍受。" voices=""/><msg @l="411" char_id="-1" frame_id="-1" name="" text="摸，摸，摸。" voices=""/><msg @l="412" char_id="-1" frame_id="-1" name=""   text="痴汉放在我胸部上的手，开始滑溜溜地摩擦起来。" voices=""/><msg @l="413" char_id="-1" frame_id="-1" name=""   text="隔着衣服沿着胸部柔软的曲线画圈抚摸，还从下方托起，上下晃动揉捏。"   voices=""/><msg @l="414" char_id="-1" frame_id="-1" name=""   text="我紧闭双眼，忍受着那只像虫子一样在我胸部上爬来爬去的手的触感。" voices=""/><msg @l="416" char_id="0" frame_id="-1" name="美帆"   text="(距离大学前的站点还有15分钟……忍耐一下，就好了吧？)" voices="miho00300"/><msg @l="418" char_id="-1" frame_id="-1" name="" text="痴汉很可怕。" voices=""/><msg @l="419" char_id="-1" frame_id="-1" name=""   text="但是，让周围的人知道我正在被痴汉骚扰这件事，对我来说更加羞耻。" voices=""/><msg @l="420" char_id="-1" frame_id="-1" name="" text="所以我只能任由痴汉摆布。"   voices=""/><msg @l="421" char_id="-1" frame_id="-1" name="" text="我相信他很快就会放弃的，就这样坚信着。"   voices=""/><msg @l="423" char_id="-1" frame_id="-1" name="痴汉" text="『呵呵……』" voices=""/><msg @l="424" char_id="-1" frame_id="-1" name=""   text="一直抚摸着我胸部的痴汉，在我耳边发出下流的笑声。" voices=""/><msg @l="425" char_id="-1" frame_id="-1" name=""   text="然后，他的行为变本加厉。" voices=""/><msg @l="426" char_id="-1" frame_id="-1" name=""   text="他开始解我内衣上覆盖乳头的文胸扣子。" voices=""/><msg @l="428" char_id="0" frame_id="-1" name="美帆" text="『啊！』"   voices="miho10030"/><msg @l="430" char_id="-1" frame_id="-1" name=""   text="我无法反抗，只能忍受这只在我身体上爬行的虫子移到我背后解开内衣扣的行为。"   voices=""/><msg @l="431" char_id="-1" frame_id="-1" name=""   text="年轻而挺拔的乳房仿佛被解放般轻轻晃动，胸罩杯滑落了。" voices=""/><msg @l="433" char_id="0" frame_id="-1" name="美帆" text="『……！？』"   voices="miho09970"/><msg @l="435" char_id="-1" frame_id="-1" name=""   text="彷佛在等待这一刻，痴汉的手开始攻击那白色山峰的顶端。" voices=""/><msg @l="436" char_id="-1" frame_id="-1" name=""   text="他搓揉着生长在顶端的野莓，白色的山峰被蹂躏着。" voices=""/><msg @l="438" char_id="0" frame_id="-1" name="美帆" text="『……。』"   voices="miho00420"/><msg @l="440" char_id="-1" frame_id="-1" name=""   text="征服者进一步将魔爪伸向下半身如桃山般的臀部。" voices=""/><msg @l="441" char_id="-1" frame_id="-1" name=""   text="痴汉用另一只手隔着裙子，像是要托起那勾勒出柔美曲线的臀肉一般揉捏着，抚摸着。" voices=""/><msg @l="443" char_id="0" frame_id="-1" name="美帆" text="『……唔……。』"   voices="miho09930"/><msg @l="445" char_id="-1" frame_id="-1" name=""   text="我想要逃离这一切，紧贴着墙壁，但痴汉不愿放过猎物，贴得如此之近，我甚至能感受到他喷在我颈部的呼吸。" voices=""/><msg @l="446" char_id="-1" frame_id="-1" name=""   text="痴汉将美帆压在墙上，执拗地继续触摸她的臀部。" voices=""/><msg @l="448" char_id="0" frame_id="-1" name="美帆" text="『……。』"   voices="miho00420"/><msg @l="450" char_id="-1" frame_id="-1" name=""   text="每当那手指试图强行分开臀缝抚摸上去时，一阵恶寒便窜上美帆的脊背，颈部也渗出了汗水。"   voices=""/><msg @l="452" char_id="0" frame_id="-1" name="美帆" text="(忍耐，忍耐……)"   voices="miho00310"/><msg @l="454" char_id="-1" frame_id="-1" name=""   text="然而，仿佛是在嘲笑她的忍耐，这次痴汉隔着裙子开始强行攻击她的后庭部位。" voices=""/><msg @l="456" char_id="-1" frame_id="-1" name=""   text="虽然因裙子的阻挡而不能完全得逞，但他确实是在瞄准她的后庭。" voices=""/><msg @l="459" char_id="0" frame_id="-1" name="美帆" text="『………唔………。』"   voices="miho09930"/><msg @l="461" char_id="-1" frame_id="-1" name="痴汉" text="『咕咕咕……。』"   voices=""/><msg @l="463" char_id="-1" frame_id="-1" name=""   text="他的手指仿佛在享受着按压后再回弹的触感，不断地移动给予刺激。" voices=""/><msg @l="464" char_id="-1" frame_id="-1" name=""   text="不知不觉中，原本在抚摸臀部的痴汉的手，正一点点从臀部滑向大腿附近。" voices=""/><msg @l="465" char_id="-1" frame_id="-1" name="" text="嗖。" voices=""/><msg @l="466" char_id="-1" frame_id="-1" name=""   text="突然间，他的手掀起了裙子，从裙摆处侵入了内部。" voices=""/><msg @l="468" char_id="0" frame_id="-1" name="美帆"   text="(骗人……不要，居然连裙子里面都要摸吗！？)" voices="miho00320"/><msg @l="470" char_id="-1" frame_id="-1" name=""   text="这与我之前头脑中模糊概念里的“痴汉”行为相去甚远，如此大胆的举动让我差点不由自主地陷入恐慌。"   voices=""/><msg @l="471" char_id="-1" frame_id="-1" name=""   text="虽然我以前也遇到过几次痴汉，但最多就是被摸了两三下大腿而已。" voices=""/><msg @l="472" char_id="-1" frame_id="-1" name=""   text="大学前我一直在女校上学，那时乘坐的路线巴士也几乎成了专用车。" voices=""/><msg @l="473" char_id="-1" frame_id="-1" name=""   text="在东京校区上学时，我也会选择人不太多的时间乘电车，所以几乎没遇到过痴汉。"   voices=""/><msg @l="474" char_id="-1" frame_id="-1" name=""   text="但现在，我只能乘坐这辆几乎清一色都是男性的电车。" voices=""/><msg @l="476" char_id="0" frame_id="-1" name="美帆" text="(怎、怎么办……这种事……)"   voices="miho00330"/><msg @l="478" char_id="0" frame_id="-1" name="美帆"   text="(居然还要继续忍耐10分钟以上……)" voices="miho00340"/><msg @l="480" char_id="-1" frame_id="-1" name=""   text="就在我手心冒汗，紧紧握住扶手忍耐的时候，痴汉的手已经在裙子里直接抚摸着我的大腿。"   voices=""/><msg @l="481" char_id="-1" frame_id="-1" name="" text="沙、沙、沙。" voices=""/><msg @l="483" char_id="0" frame_id="-1" name="美帆" text="『……！？』"   voices="miho09970"/><msg @l="485" char_id="-1" frame_id="-1" name=""   text="我被摸大腿的触感让身体不住地颤抖。" voices=""/><msg @l="486" char_id="-1" frame_id="-1" name=""   text="那只直接触摸皮肤的手的感觉，简直令人恶心。" voices=""/><msg @l="487" char_id="-1" frame_id="-1" name=""   text="更糟的是，我还感觉到从某处投来一种奇怪而尖锐的视线。" voices=""/><msg @l="488" char_id="-1" frame_id="-1" name=""   text="如果被其他乘客看到我裙子被掀起来，遭遇痴汉的样子……一想到这点，我就羞耻得无法公然反抗。"   voices=""/><msg @l="490" char_id="-1" frame_id="-1" name="痴汉" text="『别出声。』"   voices=""/><msg @l="492" char_id="0" frame_id="-1" name="美帆" text="(咦……什么？)"   voices="miho00350"/><msg @l="494" char_id="-1" frame_id="-1" name=""   text="痴汉在我耳边低语后，那只一直在抚摸我白嫩大腿的手滑进了我的腿间。" voices=""/><msg @l="495" char_id="-1" frame_id="-1" name=""   text="伸进腿间的手，一边抚摸着大腿内侧，一边像爬行一般向上移动到了腿根部位。" voices=""/><msg @l="497" char_id="0" frame_id="-1" name="美帆" text="(不……那里不行)"   voices="miho00360"/><msg @l="499" char_id="-1" frame_id="-1" name=""   text="直觉感到危险，我慌忙合拢双腿，用大腿夹住了痴汉的手。" voices=""/><msg @l="501" char_id="-1" frame_id="-1" name="痴汉"   text="『怎么了……你想靠这样来反抗吗？』" voices=""/><wait_chgmv/><ev @l="504" src="ev-005ax3y2"/><msg @l="506" char_id="-1" frame_id="-1" name=""   text="痴汉再次在我耳边低语……而那只没被大腿夹住的手绕到了我的下腹部，沿着内裤与大腿的交界线来回抚摸。"   voices=""/><msg @l="508" char_id="0" frame_id="-1" name="美帆" text="『嗯……』"   voices="miho10450"/><msg @l="510" char_id="-1" frame_id="-1" name=""   text="在像是故意挑逗般反复描摹边缘后，这次他直接抚摸起了内裤陷入的缝隙处。" voices=""/><msg @l="512" char_id="0" frame_id="-1" name="美帆" text="『……呀！！』"   voices="miho00370"/><msg @l="514" char_id="-1" frame_id="-1" name="" text="我情不自禁地发出一声短促的叫声。"   voices=""/><msg @l="515" char_id="-1" frame_id="-1" name=""   text="与此同时，周围的人们一齐将目光投向了我。" voices=""/><msg @l="516" char_id="-1" frame_id="-1" name=""   text="被发现遭到痴汉的事实——我那羞耻的样子被看到了——这样的念头闪过的瞬间，我浑身无力，大腿间夹住的痴汉的手被释放出来，他立刻从臀部方向继续袭击我的私处。"   voices=""/><msg @l="518" char_id="-1" frame_id="-1" name="痴汉" text="『我不是说过不要出声吗。』"   voices=""/><msg @l="520" char_id="-1" frame_id="-1" name="痴汉"   text="『你是想让周围的人看到你被痴汉猥亵的样子吗？』" voices=""/><msg @l="522" char_id="0" frame_id="-1" name="美帆" text="『……唔……。』"   voices="miho00380"/><msg @l="524" char_id="-1" frame_id="-1" name="痴汉"   text="『对，就这样保持安静，我会让你「舒服」的。呵呵呵呵呵。』" voices=""/><msg @l="526" char_id="-1" frame_id="-1" name="" text="痴汉说完，发出了猥琐的笑声。"   voices=""/><msg @l="527" char_id="-1" frame_id="-1" name=""   text="我——除了压抑声音忍耐之外，别无选择。" voices=""/><msg @l="529" char_id="-1" frame_id="-1" name="痴汉"   text="『呵呵……看到你那可爱的脸因恐惧而颤抖，真是令人难以抗拒。』" voices=""/><msg @l="531" char_id="-1" frame_id="-1" name="痴汉" text="『你有受虐的潜质呢。』"   voices=""/><msg @l="533" char_id="-1" frame_id="-1" name="" text="咕啾。" voices=""/><msg @l="534" char_id="-1" frame_id="-1" name=""   text="痴汉一边开心地笑着，这次从前后伸出双手，隔着内裤直接黏腻地摩擦起来。" voices=""/><msg @l="536" char_id="0" frame_id="-1" name="美帆" text="『嗯……』"   voices="miho10450"/><msg @l="538" char_id="-1" frame_id="-1" name=""   text="我身体颤抖着，试图保护私处，紧紧夹住大腿拒绝他的手指侵入。" voices=""/><msg @l="539" char_id="-1" frame_id="-1" name=""   text="但是，无论我怎样紧紧夹住大腿，中间总是会出现缝隙，痴汉的手指不断靠近那没有任何防御的地方。" voices=""/><msg @l="540" char_id="-1" frame_id="-1" name=""   text="然后，当他终于到达我的私密部位时，便像是在确认形状一样肆意玩弄起来。" voices=""/><msg @l="541" char_id="-1" frame_id="-1" name="" text="咕啾，咕嘟。" voices=""/><msg @l="543" char_id="0" frame_id="-1" name="美帆" text="『……。』"   voices="miho10340"/><msg @l="545" char_id="-1" frame_id="-1" name=""   text="痴汉沿着我丰满柔软的肉体抚摸，那侵略者般的中指和食指肆无忌惮地像划船一样不断摩擦着内裤的底部。"   voices=""/><msg @l="546" char_id="-1" frame_id="-1" name=""   text="我想要反抗却动弹不得，只能静静地忍受。" voices=""/><msg @l="547" char_id="-1" frame_id="-1" name=""   text="每当他从前后伸出的手指前后移动时，我都会因恶心而不停颤抖着后背。" voices=""/><msg @l="549" char_id="0" frame_id="-1" name="美帆" text="『……唔……。』"   voices="miho09930"/><msg @l="551" char_id="-1" frame_id="-1" name="痴汉"   text="『哦？反应不错嘛……你平时会自慰吗？』" voices=""/><msg @l="553" char_id="0" frame_id="-1" name="美帆" text="『这种事……我、我不能回答！』"   voices="miho00390"/><msg @l="555" char_id="-1" frame_id="-1" name="痴汉"   text="『不保持沉默的话，会被周围的人发现哦？』" voices=""/><msg @l="557" char_id="0" frame_id="-1" name="美帆" text="『呃……。』"   voices="miho00400"/><msg @l="559" char_id="-1" frame_id="-1" name=""   text="不知不觉间，我似乎已经被卷入了痴汉的节奏中。" voices=""/><msg @l="560" char_id="-1" frame_id="-1" name=""   text="是因为我性格上容易被人趁虚而入，还是因为这个痴汉太过于狡猾？" voices=""/><msg @l="561" char_id="-1" frame_id="-1" name="" text="无论如何，在这种情况下我都无法反抗。"   voices=""/><msg @l="563" char_id="-1" frame_id="-1" name="痴汉"   text="『还是说你更喜欢这样？』" voices=""/><msg @l="565" char_id="-1" frame_id="-1" name=""   text="痴汉用抵在内裤底部的小指指腹轻轻向上一挑，用力按压着女阴的中心。这使得内裤陷入了阴唇之间。"   voices=""/><msg @l="567" char_id="0" frame_id="-1" name="美帆" text="『…………。』"   voices="miho00420"/><msg @l="569" char_id="-1" frame_id="-1" name=""   text="我发出了无声的呻吟。在强忍的过程中，前齿咬进了嘴唇。" voices=""/><msg @l="570" char_id="-1" frame_id="-1" name=""   text="无视我的忍耐，他又无礼地将中指和食指两根手指伸了进来。" voices=""/><msg @l="571" char_id="-1" frame_id="-1" name=""   text="蠕动的指尖肆意玩弄着女阴，接着弯曲第一关节，用指尖勾住丰满的女唇，爱抚着蜜口。" voices=""/><msg @l="573" char_id="0" frame_id="-1" name="美帆" text="『……唔……。』"   voices="miho09930"/><msg @l="575" char_id="-1" frame_id="-1" name=""   text="从未被任何人触碰过，也从未被男人看见过的蜜口，如今正被这卑劣的痴汉玷污着。" voices=""/><msg @l="577" char_id="-1" frame_id="-1" name="痴汉"   text="『从未被任何人触碰过的，这里又如何呢？』" voices=""/><msg @l="579" char_id="-1" frame_id="-1" name=""   text="爱抚蜜口的指腹一滑向前，立刻贴上了上方的突起。" voices=""/><msg @l="581" char_id="0" frame_id="-1" name="美帆" text="『嗯啊！』"   voices="miho00450"/><msg @l="583" char_id="-1" frame_id="-1" name=""   text="仅仅是被手指触碰，全身就窜过类似疼痛的强烈快感，我痉挛般地颤抖，几乎向前倒下。"   voices=""/><msg @l="585" char_id="0" frame_id="-1" name="美帆" text="『不要……那里是……。』"   voices="miho00410"/><msg @l="587" char_id="-1" frame_id="-1" name="痴汉" text="『那里，是什么呢……？』"   voices=""/><msg @l="589" char_id="0" frame_id="-1" name="美帆" text="『………。』"   voices="miho00420"/><msg @l="591" char_id="-1" frame_id="-1" name="痴汉"   text="『没错……如果回答不出来，就继续保持沉默吧。』" voices=""/><msg @l="593" char_id="-1" frame_id="-1" name=""   text="痴汉就这样，慢慢地用指腹挑逗般地拨弄起那突起。" voices=""/><msg @l="595" char_id="0" frame_id="-1" name="美帆" text="『……呃啊……。』"   voices="miho00430"/><msg @l="597" char_id="-1" frame_id="-1" name=""   text="从我紧闭的嘴唇中，不经意间泄露出一丝喘息。" voices=""/><msg @l="598" char_id="-1" frame_id="-1" name=""   text="痴汉的手指轻轻拨弄那突起，我的腰便不由自主地颤抖起来。" voices=""/><msg @l="600" char_id="0" frame_id="-1" name="美帆" text="『………。』"   voices="miho09900"/><msg @l="602" char_id="-1" frame_id="-1" name=""   text="我不知道这是出于恐惧还是生理反应。" voices=""/><msg @l="603" char_id="-1" frame_id="-1" name=""   text="我只知道，身体正在对痴汉蹂躏我重要部位的行为作出反应。" voices=""/><msg @l="604" char_id="-1" frame_id="-1" name="" text="咕啾，咕啾。" voices=""/><msg @l="606" char_id="0" frame_id="-1" name="美帆" text="『……唔……。』"   voices="miho09930"/><msg @l="608" char_id="-1" frame_id="-1" name=""   text="痴汉似乎很喜欢我的反应，用食指更加用力地继续仔细玩弄那突起。" voices=""/><msg @l="609" char_id="-1" frame_id="-1" name=""   text="每次阴蒂被触碰，我都忍住泪水，咬着嘴唇不让自己发出声音。" voices=""/><msg @l="611" char_id="0" frame_id="-1" name="美帆" text="『……。』"   voices="miho09880"/><msg @l="613" char_id="-1" frame_id="-1" name="痴汉"   text="『只是隔着内裤被玩弄就有感觉了吗？真是个了不起的淫乱啊。这里已经变热了不是吗。』" voices=""/><msg @l="615" char_id="0" frame_id="-1" name="美帆" text="『不…不是的。』"   voices="miho00440"/><msg @l="617" char_id="-1" frame_id="-1" name="痴汉"   text="『那么，这话是真是假，不如问问这张嘴吧。』" voices=""/><msg @l="619" char_id="-1" frame_id="-1" name="" text="啪。" voices=""/><msg @l="620" char_id="-1" frame_id="-1" name="" text="话音刚落，那突起就被用力地弹了一下。"   voices=""/><msg @l="622" char_id="0" frame_id="-1" name="美帆" text="『嗯啊！』"   voices="miho00450"/><msg @l="624" char_id="-1" frame_id="-1" name=""   text="我拼命压抑住差点脱口而出的声音。" voices=""/><msg @l="625" char_id="-1" frame_id="-1" name="" text="像是有电流……贯穿了全身。"   voices=""/><msg @l="627" char_id="-1" frame_id="-1" name="痴汉" text="『你的敏感度真不错啊。』"   voices=""/><msg @l="629" char_id="-1" frame_id="-1" name="痴汉"   text="『不过，如果把我的东西塞进这里……你会感觉更舒服的。』" voices=""/><msg @l="631" char_id="-1" frame_id="-1" name=""   text="痴汉一边这么说着，一边用手指抚摸着那里，同时将腰部贴着我的臀部摩擦起来。" voices=""/><msg @l="632" char_id="-1" frame_id="-1" name=""   text="我感受到臀部被贴上的那根热且硬的棒状物，脑海中浮现出只在想象中知道的男性器官，下意识地想要回头看。"   voices=""/><msg @l="633" char_id="-1" frame_id="-1" name=""   text="就在我要回头的瞬间，痴汉笑着的嘴角略微进入了我的视野。" voices=""/><msg @l="634" char_id="-1" frame_id="-1" name="" text="就在我以为马上就能看清痴汉的脸时。"   voices=""/><msg @l="635" char_id="-1" frame_id="-1" name=""   text="电车猛烈晃动，同时他的脸从我的视野中大幅偏离。" voices=""/><eval @l="639" expr="f.痴漢flag&#32;+=&#32;1&#13;&#10;"/><stopbgm @l="643" fadeout="1000"/><clear @l="649" class="all"/><msgshow @l="651" show="true"/><msg @l="653" char_id="-1" frame_id="-1" name="广播"   text="『下一站是终点……大学前站，大学前站。』" voices=""/><msg @l="655" char_id="-1" frame_id="-1" name="广播"   text="『请注意不要遗忘随身物品。』" voices=""/><msg @l="657" char_id="0" frame_id="-1" name="美帆" text="(啊，得救了……)"   voices="miho00460"/><msg @l="659" char_id="-1" frame_id="-1" name=""   text="剧烈晃动过后，车内响起终点即将到达的广播。" voices=""/><msg @l="660" char_id="-1" frame_id="-1" name="" text="窗外已经能看到大学的建筑。"   voices=""/><msg @l="662" char_id="-1" frame_id="-1" name="痴汉" text="『今天看来时间到了啊。』"   voices=""/><msg @l="664" char_id="-1" frame_id="-1" name="痴汉"   text="『虽然可惜，但请期待下次继续。』" voices=""/><msg @l="666" char_id="0" frame_id="-1" name="美帆" text="『谁、谁会期待什么下次啊……』"   voices="miho00470"/><msg @l="668" char_id="-1" frame_id="-1" name="痴汉" text="『呵呵……』" voices=""/><msg @l="670" char_id="-1" frame_id="-1" name=""   text="痴汉不知何时混入人群中消失了。" voices=""/><msg @l="671" char_id="-1" frame_id="-1" name=""   text="我只能勉强捕捉到痴汉的背影一瞬间，最终也没能确认他的长相。" voices=""/><msg @l="673" char_id="0" frame_id="-1" name="美帆" text="(……谁会……期待什么下次……)"   voices="miho00480"/><msg @l="675" char_id="-1" frame_id="-1" name=""   text="在开始减速的电车内，我轻声呢喃着，仿佛想要否定那微小的“摇晃”。" voices=""/><goto @l="678" label="EventLabel_22"/><return @l="681" value=""/><label @l="685" id="EventLabel_22"/><end_scene @l="689"/><stopse @l="693" buf="3"/><wait_chgmv/><bg @l="697" src="bg07"/><bgm @l="701" src="bgm03" volume="1."/><char @l="705" id="miho" pos="auto" src="miho015"/><description @l="708" text="开始的日子"/><msg @l="710" char_id="0" frame_id="-1" name="美帆" text="(呜……遭遇了太糟糕的事)"   voices=""/><msg @l="712" char_id="0" frame_id="-1" name="美帆"   text="(明天绝对要坐下一班电车……绝对)" voices=""/><msg @l="714" char_id="-1" frame_id="-1" name=""   text="从下电车开始，我一直含着泪水走着。" voices=""/><msg @l="715" char_id="-1" frame_id="-1" name=""   text="虽然尽量低着头不让别人发现，但可能还是有人注意到我在哭，感到奇怪。" voices=""/><msg @l="717" char_id="-1" frame_id="-1" name="声音" text="『哎呀，怎么了吗？』"   voices=""/><char @l="721" id="miho" pos="auto" src="miho014"/><msg @l="723" char_id="0" frame_id="-1" name="美帆" text="『啊……』" voices=""/><clear @l="726" class="char"/><char @l="728" id="miho" pos="left" src="miho014"/><char @l="731" id="kutsu" pos="right" src="kutsu010"/><msg @l="733" char_id="-1" frame_id="-1" name=""   text="突然被叫住，慌忙擦掉眼泪回过头，发现负责考古学讲座的朽木阳大（くつきようだい）教授站在那里。"   voices=""/><msg @l="734" char_id="-1" frame_id="-1" name=""   text="因为我的专业也是考古学，所以有很多见面的机会，他对我也很关照。" voices=""/><msg @l="735" char_id="-1" frame_id="-1" name=""   text="现在，白石学姐所说的「人脉」最有力的候选人……大概就是他吧。" voices=""/><msg @l="737" char_id="0" frame_id="-1" name="美帆" text="『教授也是坐同一班电车吗？』"   voices=""/><msg @l="739" char_id="-1" frame_id="-1" name="朽木"   text="『啊啊。没想到仲根同学也在那班电车上啊。』" voices=""/><msg @l="741" char_id="-1" frame_id="-1" name=""   text="朽木教授这样说着，嘴角带着几分愉快地扭曲了。" voices=""/><msg @l="742" char_id="-1" frame_id="-1" name=""   text="我不明白他话中的含义，只是模糊地歪了歪头。" voices=""/><char @l="746" id="kutsu" pos="right" src="kutsu014"/><msg @l="748" char_id="-1" frame_id="-1" name="朽木"   text="『咦，仲根同学，你的眼睛有点红啊……？』" voices=""/><char @l="752" id="miho" pos="left" src="miho015"/><msg @l="754" char_id="0" frame_id="-1" name="美帆" text="『啊，不……没什么的。』"   voices=""/><msg @l="756" char_id="0" frame_id="-1" name="美帆"   text="『只是有点灰尘进眼睛了，所以……』" voices=""/><msg @l="758" char_id="-1" frame_id="-1" name=""   text="面对突然的追问，我惊慌之下随口编了个谎。" voices=""/><msg @l="759" char_id="-1" frame_id="-1" name=""   text="连我自己都觉得，这是个平淡无奇又毫无机智的谎言。" voices=""/><msg @l="760" char_id="-1" frame_id="-1" name=""   text="不过我当然不能说，我是因为遭遇了痴汉才哭的……" voices=""/><char @l="764" id="kutsu" pos="right" src="kutsu010"/><msg @l="766" char_id="-1" frame_id="-1" name="朽木"   text="『嗯。转学过来差不多一个月了啊。如果放松警惕的话，就会被一些小事绊倒……还是多加注意为好。』"   voices=""/><msg @l="768" char_id="-1" frame_id="-1" name="朽木"   text="『我对你特别期待，希望你能做好哦。』" voices=""/><char @l="772" id="miho" pos="left" src="miho116"/><msg @l="774" char_id="0" frame_id="-1" name="美帆" text="『好的，谢谢您。』"   voices=""/><clear @l="778" class="char"/><char @l="780" id="miho" pos="auto" src="miho116"/><msg @l="782" char_id="0" frame_id="-1" name="美帆" text="『……』" voices=""/><msg @l="784" char_id="0" frame_id="-1" name="美帆" text="『被绊倒……啊。』"   voices=""/><msg @l="786" char_id="0" frame_id="-1" name="美帆" text="『我的确是突然就被绊倒了呢。』"   voices=""/><msg @l="788" char_id="-1" frame_id="-1" name=""   text="望着朽木教授渐行渐远的背影，我小声地自言自语着。" voices=""/><stopbgm @l="792" fadeout="1000"/><clear @l="798" class="all"/><msgshow @l="800" show="true"/><wait_chgmv/><bg @l="804" src="bg09"/><bgm @l="808" src="bgm02" volume="1."/><msg @l="810" char_id="0" frame_id="-1" name="美帆" text="『稻庭学长？』"   voices=""/><msg @l="812" char_id="-1" frame_id="-1" name="女性朋友"   text="『对对。网球社的会长，超级帅气的哦！』" voices=""/><msg @l="814" char_id="0" frame_id="-1" name="美帆"   text="『哦～，网球啊……我对球类运动完全不行呢。』" voices=""/><msg @l="816" char_id="-1" frame_id="-1" name="女性朋友"   text="『网球什么的随便打打就行啦。社团里九成的女生都是冲着稻庭学长去的！』" voices=""/><msg @l="818" char_id="0" frame_id="-1" name="美帆"   text="『但是，既然加入社团，我觉得还是应该会打网球才行吧。』" voices=""/><msg @l="820" char_id="-1" frame_id="-1" name="女性朋友"   text="『唉，美帆你总是这么认真～。』" voices=""/><msg @l="822" char_id="-1" frame_id="-1" name=""   text="必修课结束后，与经常一起上课的女生边聊天边走在走廊上，这已经成为我最近的习惯了。" voices=""/><msg @l="823" char_id="-1" frame_id="-1" name=""   text="转学一个月就交到朋友，对我来说还真是少见。" voices=""/><msg @l="824" char_id="-1" frame_id="-1" name=""   text="这大概也是「凡事都要积极向上」这个目标的功劳吧……。" voices=""/><msg @l="826" char_id="0" frame_id="-1" name="美帆"   text="『先不说那个稻庭学长，我也该考虑加入什么社团了。』" voices=""/><msg @l="828" char_id="-1" frame_id="-1" name="女性朋友"   text="『哦～，把那位稻庭学长说成「先不说」～！』" voices=""/><msg @l="830" char_id="0" frame_id="-1" name="美帆"   text="『抱歉抱歉，我不是那个意思啦。』" voices=""/><msg @l="832" char_id="0" frame_id="-1" name="美帆" text="『我……不太擅长和男生相处。』"   voices=""/><msg @l="834" char_id="-1" frame_id="-1" name="女性朋友"   text="『诶，美帆该不会是那个什么同性恋之类的吧？』" voices=""/><msg @l="836" char_id="0" frame_id="-1" name="美帆" text="『要说的话应该是同性恋倾向，才对吧。』"   voices=""/><msg @l="838" char_id="-1" frame_id="-1" name="女性朋友"   text="『啊～对对。同性恋什么的。』" voices=""/><msg @l="840" char_id="0" frame_id="-1" name="美帆" text="『结果还是“什么的”啊……』"   voices=""/><msg @l="842" char_id="-1" frame_id="-1" name="女性朋友"   text="『那么，美帆是那种什么的吗？』" voices=""/><msg @l="844" char_id="0" frame_id="-1" name="美帆"   text="『不是啦！ 我并不是那种类型的……只是单纯不擅长而已。』" voices=""/><msg @l="846" char_id="-1" frame_id="-1" name="女性朋友" text="『我搞不太懂啊～』"   voices=""/><msg @l="848" char_id="0" frame_id="-1" name="美帆" text="『我自己也搞不太懂。』"   voices=""/><msg @l="850" char_id="-1" frame_id="-1" name="女性朋友" text="『什么啊那是～』"   voices=""/><clear @l="856" class="all"/><msgshow @l="858" show="true"/><msg @l="860" char_id="0" frame_id="-1" name="美帆" text="『啊……』" voices=""/><msg @l="862" char_id="-1" frame_id="-1" name="女性朋友" text="『哎，怎么了？』"   voices=""/><wait_chgmv/><bg @l="866" src="bg15"/><char @l="870" id="inaba" pos="auto" src="inaba010"/><msg @l="872" char_id="0" frame_id="-1" name="美帆" text="『真少见啊……后院有人哦？』"   voices=""/><msg @l="874" char_id="-1" frame_id="-1" name=""   text="对话中断的一瞬间，我不经意地从走廊的窗户看向校舍的后面……俗称“后院”的地方，那个平时根本没有人气的地方，罕见地出现了人影。"   voices=""/><msg @l="875" char_id="-1" frame_id="-1" name=""   text="年轻的……应该属于相当“帅气”类型的男人。" voices=""/><msg @l="877" char_id="-1" frame_id="-1" name="女性朋友"   text="『让我看看，是爱的告白吗……咦，那不是稻庭学长吗！』" voices=""/><msg @l="879" char_id="0" frame_id="-1" name="美帆" text="『哦，那就是稻庭学长啊。』"   voices=""/><msg @l="881" char_id="-1" frame_id="-1" name="" text="确实，有传闻也是有道理的。"   voices=""/><msg @l="882" char_id="-1" frame_id="-1" name=""   text="那种有着如此帅气会长的社团，肯定会有很多女生慕名而来。" voices=""/><msg @l="884" char_id="-1" frame_id="-1" name="女性朋友"   text="『是谁是谁啊，居然想向我的稻庭学长告白！』" voices=""/><msg @l="886" char_id="0" frame_id="-1" name="美帆"   text="『我的稻庭学长……这话，大概是个有问题的发言吧？』" voices=""/><msg @l="888" char_id="-1" frame_id="-1" name="女性朋友"   text="『我怎么想都是我的自由吧！』" voices=""/><msg @l="890" char_id="0" frame_id="-1" name="美帆" text="『这话也许没错啦……』"   voices=""/><msg @l="892" char_id="-1" frame_id="-1" name="女性朋友" text="『可恶，看不到啊——！』"   voices=""/><msg @l="894" char_id="0" frame_id="-1" name="美帆"   text="『刚好被树荫挡住了呢。』" voices=""/><clear @l="898" class="char"/><msg @l="900" char_id="-1" frame_id="-1" name="女性朋友"   text="『啊……稻庭学长进校舍了！』" voices=""/><wait_chgmv/><bg @l="904" src="bg09"/><msg @l="906" char_id="-1" frame_id="-1" name="女性朋友" text="『美帆，我们走！』"   voices=""/><msg @l="908" char_id="0" frame_id="-1" name="美帆" text="『诶，走去哪啊？』"   voices=""/><msg @l="910" char_id="-1" frame_id="-1" name="女性朋友"   text="『当然是去迎接稻庭学长啊！』" voices=""/><msg @l="912" char_id="0" frame_id="-1" name="美帆" text="『等，等一下……！？』"   voices=""/><clear @l="918" class="all"/><msgshow @l="920" show="true"/><msg @l="922" char_id="-1" frame_id="-1" name=""   text="我被半拖半拽地，朝着校舍后门所在的地方走去。" voices=""/><msg @l="923" char_id="-1" frame_id="-1" name=""   text="所谓后门，也只是外墙上装了一扇双开的玻璃门而已，和其他地方没什么特别的区别。"   voices=""/><msg @l="924" char_id="-1" frame_id="-1" name=""   text="如果非要说有什么不同的话，大概就是因为没人会特意去后院，所以几乎没什么人经过这里吧。"   voices=""/><wait_chgmv/><bg @l="928" src="bg09"/><msg @l="930" char_id="0" frame_id="-1" name="美帆"   text="『喂……算了吧，说不定会打扰到稻庭学长的。』" voices=""/><msg @l="932" char_id="-1" frame_id="-1" name="女性朋友"   text="『你在说什么呀，这可是个机会。』" voices=""/><msg @l="934" char_id="0" frame_id="-1" name="美帆" text="『机会……什么机会？』"   voices=""/><msg @l="936" char_id="-1" frame_id="-1" name="女性朋友"   text="『这是在那些盯上稻庭学长的竞争对手面前领先一步的机会！』" voices=""/><msg @l="938" char_id="0" frame_id="-1" name="美帆"   text="『领先一步，不就是见面聊天而已嘛……』" voices=""/><msg @l="940" char_id="-1" frame_id="-1" name="女性朋友"   text="『正是这种见面聊天才重要啊！』" voices=""/><msg @l="942" char_id="-1" frame_id="-1" name="女性朋友"   text="『要把“我”这个存在牢牢刻在稻庭学长的脑细胞里！』" voices=""/><msg @l="944" char_id="0" frame_id="-1" name="美帆" text="『是、是这样啊……』"   voices=""/><msg @l="946" char_id="-1" frame_id="-1" name="" text="这种说法有点吓人啊……"   voices=""/><msg @l="948" char_id="-1" frame_id="-1" name="女性朋友" text="『啊……稻庭学长来了！』"   voices=""/><char @l="952" id="inaba" pos="auto" src="inaba010"/><stopbgm @l="956" fadeout="1000"/><bgm @l="959" src="bgm06" volume="1."/><msg @l="961" char_id="-1" frame_id="-1" name="女性朋友" text="『稻庭学长，你好呀～♪』"   voices=""/><msg @l="963" char_id="-1" frame_id="-1" name=""   text="稻庭学长打开通往后院的门那一刻，她就像是被设定好的闹钟一样冲了出去，用洪亮的声音亲切地打招呼。"   voices=""/><msg @l="964" char_id="-1" frame_id="-1" name=""   text="而且，还是平常对话中不会用的“外出专用声音”，真是厉害。" voices=""/><msg @l="965" char_id="-1" frame_id="-1" name=""   text="顺便一提，这“外出专用声音”比平时的声音高了一个八度。" voices=""/><msg @l="967" char_id="-1" frame_id="-1" name="稻庭"   text="『哈哈……这还真是，相当热闹的迎接啊。』" voices=""/><msg @l="969" char_id="-1" frame_id="-1" name="" text="说着，稻庭学长露出了微笑。"   voices=""/><msg @l="970" char_id="-1" frame_id="-1" name=""   text="面对突如其来的迎接也没有显得特别惊讶，一副从容不迫的样子。" voices=""/><msg @l="971" char_id="-1" frame_id="-1" name=""   text="这样的事情对稻庭学长来说可能是家常便饭。" voices=""/><msg @l="973" char_id="-1" frame_id="-1" name="女性朋友"   text="『我真的很激动能见到稻庭学长！』" voices=""/><msg @l="975" char_id="-1" frame_id="-1" name="稻庭"   text="『哈哈哈，只要来网球场的话，我觉得每天都能见到我哦。』" voices=""/><msg @l="977" char_id="-1" frame_id="-1" name="女性朋友"   text="『那是在邀请我加入社团吗～？』" voices=""/><msg @l="979" char_id="-1" frame_id="-1" name="稻庭"   text="『是啊。像你这样充满活力的女孩子如果能加入社团的话，肯定会很有趣的。』" voices=""/><msg @l="981" char_id="-1" frame_id="-1" name="女性朋友"   text="『太棒了，居然是稻庭学长主动邀请我……真感动！』" voices=""/><msg @l="983" char_id="-1" frame_id="-1" name="稻庭"   text="『下次来网球场参观社团活动吧。我会教你很多东西的。』" voices=""/><msg @l="985" char_id="-1" frame_id="-1" name="女性朋友" text="『真的吗！？』"   voices=""/><msg @l="987" char_id="-1" frame_id="-1" name="稻庭" text="『你觉得我会骗你吗？』"   voices=""/><msg @l="989" char_id="-1" frame_id="-1" name="女性朋友"   text="『不会不会，绝绝对不会！』" voices=""/><msg @l="991" char_id="-1" frame_id="-1" name="稻庭"   text="『太好了，我会一直等着你，随时都可以来。』" voices=""/><msg @l="993" char_id="-1" frame_id="-1" name="女性朋友"   text="『啊啊啊啊啊，稻庭学长居然说会等我！！』" voices=""/><msg @l="995" char_id="-1" frame_id="-1" name=""   text="看着在稻庭学长的话语前狂喜乱舞的朋友，我正犹豫着该何时插话，结果完全错过了时机，一个人默默不语。"   voices=""/><msg @l="997" char_id="-1" frame_id="-1" name="女性朋友"   text="『啊，我一个人在这兴奋也没用呢。』" voices=""/><msg @l="999" char_id="-1" frame_id="-1" name="女性朋友"   text="『喂……美帆，难得的机会，你也至少打个招呼吧。』" voices=""/><msg @l="1001" char_id="-1" frame_id="-1" name="" text="大概是突然回过神来了吧。"   voices=""/><msg @l="1002" char_id="-1" frame_id="-1" name=""   text="刚才在稻庭学长面前忙着又蹦又跳的朋友猛地转过身来，对我这个找不到立足之地、呆立在原地的人干脆利落地说道。"   voices=""/><msg @l="1003" char_id="-1" frame_id="-1" name=""   text="我本想问她到底是谁害我变成这种尴尬局面的，但此时此刻这种事想必已经不重要了。" voices=""/><msg @l="1005" char_id="0" frame_id="-1" name="美帆" text="『啊……嗯，嗯。』"   voices=""/><msg @l="1007" char_id="0" frame_id="-1" name="美帆" text="『那个……你好。』"   voices=""/><msg @l="1009" char_id="-1" frame_id="-1" name=""   text="我不得已按照她说的打了招呼，低了下头。" voices=""/><msg @l="1010" char_id="-1" frame_id="-1" name=""   text="这真是个糟糕至极、十分尴尬的招呼。连我自己都这么觉得。" voices=""/><stopbgm @l="1014" fadeout="1000"/><char @l="1018" id="inaba" pos="auto" src="inaba014"/><msg @l="1020" char_id="-1" frame_id="-1" name="稻庭" text="『……！』" voices=""/><msg @l="1022" char_id="-1" frame_id="-1" name=""   text="当我透过她的肩膀与稻庭学长目光相对的瞬间，不知为何，他第一次露出了非微笑的表情。" voices=""/><msg @l="1024" char_id="0" frame_id="-1" name="美帆" text="『那个……怎么了吗？』"   voices=""/><char @l="1028" id="inaba" pos="auto" src="inaba010"/><msg @l="1030" char_id="-1" frame_id="-1" name="稻庭" text="『没……没什么。』"   voices=""/><msg @l="1032" char_id="-1" frame_id="-1" name=""   text="说着，稻庭学长的脸上浮现出微笑。" voices=""/><msg @l="1033" char_id="-1" frame_id="-1" name=""   text="刚才那一瞬间流露出的惊讶表情已经完全消失，取而代之的是一个完美的笑容。" voices=""/><bgm @l="1036" src="bgm02" volume="1."/><msg @l="1038" char_id="-1" frame_id="-1" name="稻庭"   text="『话说回来，你们是转学生吧？』" voices=""/><msg @l="1040" char_id="-1" frame_id="-1" name="稻庭"   text="『如果可以的话……能告诉我你们的名字吗？』" voices=""/><msg @l="1042" char_id="0" frame_id="-1" name="美帆"   text="『啊，好的……我是仲根美帆………。』" voices=""/><msg @l="1044" char_id="0" frame_id="-1" name="美帆"   text="『同伴的“同”加上根部的“根”就是仲根，美丽的“美”加上船帆的“帆”就是美帆。』" voices=""/><msg @l="1046" char_id="-1" frame_id="-1" name="稻庭" text="『美帆啊……是个好名字呢。』"   voices=""/><msg @l="1048" char_id="0" frame_id="-1" name="美帆"   text="『啊……呃，谢谢您。』" voices=""/><msg @l="1050" char_id="-1" frame_id="-1" name="女性朋友"   text="『学长学长学长，我的名字是————！！』" voices=""/><msg @l="1052" char_id="-1" frame_id="-1" name="稻庭"   text="『啊哈哈，不用那么大声说我也能听得清楚哦。』" voices=""/><clear @l="1058" class="all"/><msgshow @l="1060" show="true"/><msg @l="1062" char_id="-1" frame_id="-1" name=""   text="在简单的自我介绍结束后，我们开始了愉快的闲聊。" voices=""/><msg @l="1063" char_id="-1" frame_id="-1" name=""   text="不过，与其说是闲聊，不如说只是她不停地像机关枪一样说个不停，而我和稻庭学长只是在一旁听着……这样的情况罢了。"   voices=""/><wait_chgmv/><bg @l="1067" src="bg09"/><char @l="1071" id="inaba" pos="auto" src="inaba010"/><msg @l="1073" char_id="-1" frame_id="-1" name="稻庭"   text="『那么我就先告辞了。』" voices=""/><msg @l="1075" char_id="-1" frame_id="-1" name="女性朋友"   text="『诶，已经要走了吗～。』" voices=""/><msg @l="1077" char_id="-1" frame_id="-1" name="稻庭"   text="『因为待会儿有社团会议，作为会长的我不能缺席吧？』" voices=""/><msg @l="1079" char_id="-1" frame_id="-1" name="女性朋友"   text="『虽然是这样，但还是很遗憾～。』" voices=""/><msg @l="1081" char_id="-1" frame_id="-1" name=""   text="她这么说着，表情沉了下来，看起来真的很遗憾。" voices=""/><msg @l="1082" char_id="-1" frame_id="-1" name=""   text="真是的，她坦率表达自己的样子让人羡慕。" voices=""/><msg @l="1084" char_id="0" frame_id="-1" name="美帆"   text="『那个，突然挽留您真是非常抱歉。』" voices=""/><msg @l="1086" char_id="-1" frame_id="-1" name="稻庭"   text="『别在意。而且我也很高兴能和你们聊天。』" voices=""/><msg @l="1088" char_id="-1" frame_id="-1" name=""   text="稻庭学长依然用那毫无破绽的笑容说道。" voices=""/><msg @l="1089" char_id="-1" frame_id="-1" name=""   text="虽然嘴上说着“你们”，但稻庭学长的视线好像一直只注视着我……这样想是不是太自恋了……。"   voices=""/><msg @l="1091" char_id="0" frame_id="-1" name="美帆" text="『是吗……太好了。』"   voices=""/><msg @l="1093" char_id="-1" frame_id="-1" name="稻庭" text="『希望下次还能聊天。』"   voices=""/><msg @l="1095" char_id="-1" frame_id="-1" name="女性朋友" text="『是的呢，一定要！』"   voices=""/><msg @l="1097" char_id="-1" frame_id="-1" name=""   text="比我说什么更快，“客套的声音”从我旁边响起。" voices=""/><msg @l="1098" char_id="-1" frame_id="-1" name="" text="而且还双眼闪闪发光。"   voices=""/><msg @l="1100" char_id="-1" frame_id="-1" name="稻庭" text="『啊哈哈哈，那么。』"   voices=""/><clear @l="1104" class="char"/><stopbgm @l="1107" fadeout="1000"/><bgm @l="1109" src="bgm02" volume="1."/><msg @l="1111" char_id="-1" frame_id="-1" name="女性朋友" text="『……。』"   voices=""/><msg @l="1113" char_id="-1" frame_id="-1" name="女性朋友"   text="『……哈啊，果然稻庭学长好帅啊～。』" voices=""/><msg @l="1115" char_id="-1" frame_id="-1" name=""   text="目送稻庭学长的背影直到看不见，然后她一脸陶醉地说道。" voices=""/><msg @l="1117" char_id="0" frame_id="-1" name="美帆"   text="『是啊……总感觉，我好像有点明白了。』" voices=""/><msg @l="1119" char_id="-1" frame_id="-1" name="女性朋友"   text="『哎呀哎呀～，不是说不擅长应对男生吗？』" voices=""/><msg @l="1121" char_id="0" frame_id="-1" name="美帆" text="『不、不是那种意思啦……。』"   voices=""/><msg @l="1123" char_id="0" frame_id="-1" name="美帆"   text="『怎么说呢，稻庭学长给人一种有点神秘的感觉。』" voices=""/><msg @l="1125" char_id="0" frame_id="-1" name="美帆" text="『虽然我不太会……表达。』"   voices=""/><msg @l="1127" char_id="-1" frame_id="-1" name="女性朋友"   text="『就是这样不知不觉地坠入爱河的哦。』" voices=""/><msg @l="1129" char_id="0" frame_id="-1" name="美帆" text="『爱……是这样吗？』"   voices=""/><msg @l="1131" char_id="-1" frame_id="-1" name="女性朋友"   text="『这样一来，情敌又一个接一个地增加了！』" voices=""/><msg @l="1133" char_id="-1" frame_id="-1" name="女性朋友"   text="『美帆，抱歉，就算是你我也不会让步的！』" voices=""/><msg @l="1135" char_id="0" frame_id="-1" name="美帆"   text="『唉，都说了不是那回事啦……！』" voices=""/><msg @l="1137" char_id="-1" frame_id="-1" name="女性朋友" text="『知道了知道了。』"   voices=""/><msg @l="1139" char_id="-1" frame_id="-1" name="女性朋友"   text="『小孩子气的美帆还早着谈恋爱呢～。』" voices=""/><msg @l="1141" char_id="0" frame_id="-1" name="美帆" text="『呜……我才不是小孩子呢。』"   voices=""/><msg @l="1143" char_id="-1" frame_id="-1" name="女性朋友" text="『喂，别撅着嘴了，我们走吧！』"   voices=""/><msg @l="1145" char_id="0" frame_id="-1" name="美帆" text="『啊，真是的……等等我啦！』"   voices=""/><msg @l="1147" char_id="-1" frame_id="-1" name=""   text="追着已经快步走开的朋友，我也小跑着追了上去。" voices=""/><clear @l="1153" class="all"/><msg @l="1155" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="1157" char_id="0" frame_id="-1" name="美帆" text="『稻庭学长……吗。』"   voices=""/><msg @l="1159" char_id="-1" frame_id="-1" name=""   text="追赶着前面朋友的背影，我小声地自言自语。" voices=""/><msg @l="1160" char_id="-1" frame_id="-1" name="" text="果然……总觉得有点不可思议的感觉。"   voices=""/><stopbgm @l="1164" fadeout="1000"/><clear @l="1170" class="all"/><msgshow @l="1172" show="true"/><stopbgm @l="1175" fadeout="1000"/><wait_chgmv/><bg @l="1179" src="bg01b"/><msg @l="1182" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="1184" char_id="-1" frame_id="-1" name=""   text="和白石学姐一起吃完她做的卷心菜卷后。" voices=""/><msg @l="1185" char_id="-1" frame_id="-1" name=""   text="我回到房间，平静地做着英语翻译作业。" voices=""/><msg @l="1186" char_id="-1" frame_id="-1" name=""   text="查找不懂的单词意思，将它们重新排列组合成通顺的语句。" voices=""/><msg @l="1187" char_id="-1" frame_id="-1" name=""   text="我想，即便继续这样做下去，作为“英译”的作业可能会做得越来越好，但对英语本身的掌握可能几乎没有提高。" voices=""/><msg @l="1188" char_id="-1" frame_id="-1" name=""   text="与其只是读文献，不如直接去当地，那样学习效率会快好几倍。" voices=""/><msg @l="1189" char_id="-1" frame_id="-1" name=""   text="正所谓熟能生巧。" voices=""/><msg @l="1190" char_id="-1" frame_id="-1" name=""   text="突然这些想法掠过脑海……让我觉得很烦躁。" voices=""/><msg @l="1192" char_id="0" frame_id="-1" name="美帆" text="『……真是不行啊，我。』"   voices=""/><se @l="1196" buf="1" src="ベッドに倒れこむ音" volume="1."/><bgm @l="1199" src="bgm03" volume="1."/><msg @l="1201" char_id="-1" frame_id="-1" name="" text="放下笔，我躺在了床上。"   voices=""/><msg @l="1202" char_id="-1" frame_id="-1" name=""   text="仰面朝天盯着天花板，我莫名有种错觉，仿佛这里成了只属于自己的空间。" voices=""/><msg @l="1203" char_id="-1" frame_id="-1" name=""   text="神游太虚时，白天发生的事不由自主地涌上心头。" voices=""/><msg @l="1204" char_id="-1" frame_id="-1" name=""   text="我摇了摇头，努力不去回想白天的事情。" voices=""/><msg @l="1205" char_id="-1" frame_id="-1" name=""   text="然而，越是努力不去想，越是差点回想起白天被痴汉骚扰的事情……。" voices=""/><msg @l="1206" char_id="-1" frame_id="-1" name="" text="这种时候，我觉得一个人真的不行。"   voices=""/><msg @l="1207" char_id="-1" frame_id="-1" name="" text="情绪会无限下沉。"   voices=""/><stopbgm @l="1211" fadeout="1000"/><clear @l="1217" class="all"/><msg @l="1219" char_id="0" frame_id="-1" name="美帆"   text="(希望前辈还在客厅……)" voices=""/><msg @l="1221" char_id="-1" frame_id="-1" name="" text="我慢慢地从床上坐了起来。"   voices=""/><msg @l="1222" char_id="-1" frame_id="-1" name=""   text="如果学姐不在客厅的话，就去洗个澡赶紧睡觉吧。" voices=""/><msg @l="1223" char_id="-1" frame_id="-1" name=""   text="带着这样的想法，我走出房间，从走廊望向客厅的门。" voices=""/><msg @l="1224" char_id="-1" frame_id="-1" name="" text="客厅里的灯还亮着。"   voices=""/><wait_chgmv/><bg @l="1228" src="bg03b"/><wait @l="1231" time="100"/><bgm @l="1235" src="bgm05" volume="1."/><char @l="1240" id="miho" pos="auto" src="miho030"/><msg @l="1242" char_id="0" frame_id="-1" name="美帆" text="『学姐，您还没睡啊。』"   voices=""/><clear @l="1245" class="char"/><char @l="1248" id="miho" pos="left" src="miho030"/><char @l="1251" id="rei" pos="right" src="rei030"/><msg @l="1253" char_id="1" frame_id="-1" name="玲"   text="『你才是，明天不是还有早八吗？』" voices=""/><char @l="1257" id="miho" pos="left" src="miho036"/><msg @l="1259" char_id="0" frame_id="-1" name="美帆"   text="『我有作业所以一直在熬夜……但是，有点集中不了精神。』" voices=""/><msg @l="1261" char_id="1" frame_id="-1" name="玲" text="『是啊……有时候就是这样。』"   voices=""/><clear @l="1265" layer="rei"/><msg @l="1267" char_id="1" frame_id="-1" name="玲" text="『我要泡咖啡，你要喝吗？』"   voices=""/><clear @l="1271" layer="miho"/><msg @l="1273" char_id="0" frame_id="-1" name="美帆" text="『啊，我来做吧。』"   voices=""/><msg @l="1275" char_id="1" frame_id="-1" name="玲" text="『没事，你坐那别动。』"   voices=""/><char @l="1279" id="miho" pos="auto" src="miho030"/><msg @l="1281" char_id="-1" frame_id="-1" name=""   text="白石学姐把手放在我正要站起来的肩膀上阻止了我，然后拖着拖鞋啪嗒啪嗒地发出声音走进了厨房。"   voices=""/><msg @l="1282" char_id="-1" frame_id="-1" name="" text="她可能是……在关心我吧。"   voices=""/><msg @l="1284" char_id="1" frame_id="-1" name="玲" text="『睡前喝的话，咖啡应该要淡一点吧？』"   voices=""/><msg @l="1286" char_id="0" frame_id="-1" name="美帆"   text="『是的……麻烦您了。』" voices=""/><msg @l="1288" char_id="1" frame_id="-1" name="玲" text="『好的。』" voices=""/><msg @l="1290" char_id="-1" frame_id="-1" name=""   text="说完后，能听到叮叮当当的餐具碰撞的声音。" voices=""/><msg @l="1292" char_id="1" frame_id="-1" name="玲" text="『糖还是和平时一样放两块就行吗？』"   voices=""/><char @l="1296" id="miho" pos="auto" src="miho036"/><msg @l="1298" char_id="0" frame_id="-1" name="美帆" text="『嗯……请稍微甜一点。』"   voices=""/><msg @l="1300" char_id="1" frame_id="-1" name="玲" text="『会胖的哦～。』"   voices=""/><msg @l="1302" char_id="0" frame_id="-1" name="美帆" text="『今天特别破例。』"   voices=""/><msg @l="1304" char_id="1" frame_id="-1" name="玲" text="『这样啊，那我就放三块吧。』"   voices=""/><char @l="1308" id="miho" pos="auto" src="miho031"/><msg @l="1310" char_id="0" frame_id="-1" name="美帆" text="『好的。』" voices=""/><msg @l="1312" char_id="-1" frame_id="-1" name=""   text="就这样，白石学姐沉默地泡着咖啡，而我则漫不经心地望着电视上播放的爱情剧，并没有特别投入。"   voices=""/><char @l="1316" id="miho" pos="auto" src="miho030"/><msg @l="1318" char_id="-1" frame_id="-1" name=""   text="剧中的女主角和男主角正开心地走着，突然，一个自称是男主角学妹的女性出现了……" voices=""/><msg @l="1319" char_id="-1" frame_id="-1" name=""   text="那个男主角似乎喜欢上了那个学妹……剧情大概是这样的。" voices=""/><wait @l="1322" time="100"/><bgm @l="1325" src="bgm06" volume="1."/><msg @l="1327" char_id="1" frame_id="-1" name="玲" text="『这个女孩子也是，在磨蹭什么呢。』"   voices=""/><msg @l="1329" char_id="-1" frame_id="-1" name=""   text="学姐一边对着电视说话，一边把装着咖啡的杯子递给了我。" voices=""/><msg @l="1330" char_id="-1" frame_id="-1" name=""   text="她的目光依然盯着电视剧，同时把玻璃杯送到嘴边。" voices=""/><msg @l="1332" char_id="-1" frame_id="-1" name=""   text="玻璃杯里的啤酒装得满满的。" voices=""/><msg @l="1333" char_id="-1" frame_id="-1" name=""   text="学姐一口气喝完后，又开始对着电视说话。" voices=""/><msg @l="1335" char_id="1" frame_id="-1" name="玲"   text="『啊？这就让步了？难以置信……如果是我的话绝对不会放弃的。』" voices=""/><char @l="1339" id="miho" pos="auto" src="miho133"/><msg @l="1341" char_id="0" frame_id="-1" name="美帆"   text="『学姐……那个，你喝醉了吗？』" voices=""/><msg @l="1343" char_id="-1" frame_id="-1" name=""   text="她变成了一个与平时印象中有些不同的、更像普通女大学生的样子。" voices=""/><msg @l="1345" char_id="1" frame_id="-1" name="玲"   text="『我才没有醉呢！比起这个，她就这么让步了？正常吗！？』" voices=""/><msg @l="1347" char_id="0" frame_id="-1" name="美帆"   text="『只是电视剧而已，不用那么激动。』" voices=""/><msg @l="1349" char_id="1" frame_id="-1" name="玲"   text="『但是，你会把自己喜欢的人让给后来出现的女孩吗？』" voices=""/><char @l="1353" id="miho" pos="auto" src="miho034"/><msg @l="1355" char_id="0" frame_id="-1" name="美帆" text="『啊……？』" voices=""/><msg @l="1357" char_id="-1" frame_id="-1" name=""   text="突然被问到这个，我很困惑。不知道是在说现实中的事，还是电视剧里的情节……" voices=""/><clear @l="1360" class="char"/><char @l="1364" id="rei" pos="right" src="rei033"/><msg @l="1366" char_id="1" frame_id="-1" name="玲"   text="『如果是我的话，不管对手是谁都绝对不会放弃的……』" voices=""/><msg @l="1368" char_id="-1" frame_id="-1" name=""   text="说完，学姐的眼神有些飘远。……大概是把自己和这部电视剧的女主角重合起来了吧。" voices=""/><char @l="1373" id="rei" pos="right" src="rei031"/><msg @l="1375" char_id="1" frame_id="-1" name="玲" text="『美帆的话……怎么样？会放弃吗？』"   voices=""/><char @l="1379" id="miho" pos="left" src="miho134"/><msg @l="1381" char_id="0" frame_id="-1" name="美帆" text="『啊？…我…是…吗？』"   voices=""/><msg @l="1383" char_id="-1" frame_id="-1" name=""   text="又一次被提问，我无法掩饰自己的困惑。" voices=""/><char @l="1387" id="rei" pos="right" src="rei030"/><msg @l="1389" char_id="1" frame_id="-1" name="玲"   text="『嗯～。以美帆的性格，应该和这个女主角一样会选择放弃吧。』" voices=""/><msg @l="1391" char_id="-1" frame_id="-1" name=""   text="学姐似乎不等我回答就下结论了。虽然这样有点让人困扰，不过这次就算了吧。" voices=""/><char @l="1395" id="miho" pos="left" src="miho033"/><msg @l="1397" char_id="0" frame_id="-1" name="美帆"   text="『是…是这样呢。我也会放弃的。』" voices=""/><char @l="1401" id="rei" pos="right" src="rei037"/><msg @l="1403" char_id="1" frame_id="-1" name="玲"   text="『所·以·说！这点我就不明白了。』" voices=""/><msg @l="1405" char_id="1" frame_id="-1" name="玲"   text="『那可是自己喜欢的人啊！是爱情啊？！』" voices=""/><char @l="1409" id="miho" pos="left" src="miho036"/><msg @l="1411" char_id="0" frame_id="-1" name="美帆"   text="『学姐……您，情绪有点奇怪啊……』" voices=""/><char @l="1415" id="rei" pos="right" src="rei034"/><msg @l="1417" char_id="1" frame_id="-1" name="玲"   text="『因为……你看起来很消沉所以……啊！！』" voices=""/><stopbgm @l="1421" fadeout="1000"/><char @l="1425" id="miho" pos="left" src="miho131"/><msg @l="1427" char_id="0" frame_id="-1" name="美帆" text="『呵呵……』" voices=""/><msg @l="1429" char_id="-1" frame_id="-1" name=""   text="我注意到学姐是在为我着想，想要鼓励我，不禁开心地笑了出来。" voices=""/><char @l="1433" id="rei" pos="right" src="rei033"/><bgm @l="1435" src="bgm05" volume="1."/><msg @l="1438" char_id="1" frame_id="-1" name="玲"   text="『真是的，我做这种不适合我的事干嘛。』" voices=""/><char @l="1443" id="miho" pos="left" src="miho031"/><msg @l="1445" char_id="0" frame_id="-1" name="美帆" text="『呵呵呵。谢谢您。』"   voices=""/><msg @l="1447" char_id="-1" frame_id="-1" name=""   text="学姐一边显得有些害羞，一边端起杯子，喝完了剩下的啤酒。" voices=""/><msg @l="1448" char_id="-1" frame_id="-1" name=""   text="我也学着她的样子小小地抿了一口咖啡。" voices=""/><msg @l="1449" char_id="-1" frame_id="-1" name="" text="三块糖的甜度比我想象的还要甜。"   voices=""/><char @l="1453" id="miho" pos="left" src="miho136"/><char @l="1457" id="rei" pos="right" src="rei031"/><msg @l="1459" char_id="1" frame_id="-1" name="玲" text="『果然应该放两块糖比较好吗？』"   voices=""/><char @l="1463" id="miho" pos="left" src="miho131"/><msg @l="1465" char_id="0" frame_id="-1" name="美帆"   text="『不，这种甜度……反而让人安心。』" voices=""/><msg @l="1467" char_id="1" frame_id="-1" name="玲" text="『是这样吗？』"   voices=""/><msg @l="1469" char_id="-1" frame_id="-1" name=""   text="白石学姐说完这句话后笑了笑，然后又把视线转向了电视屏幕。" voices=""/><msg @l="1470" char_id="-1" frame_id="-1" name="" text="她的温柔，此刻让我感到非常开心。"   voices=""/><clear @l="1476" class="all"/><wait_chgmv/><bg @l="1480" src="bg03b"/><char @l="1484" id="miho" pos="auto" src="miho030"/><msg @l="1486" char_id="0" frame_id="-1" name="美帆" text="『我，去洗个澡。』"   voices=""/><msg @l="1488" char_id="0" frame_id="-1" name="美帆"   text="『洗完就直接睡了，您可以把灯关掉。』" voices=""/><msg @l="1490" char_id="-1" frame_id="-1" name=""   text="喝完甜甜的咖啡，我站了起来。" voices=""/><msg @l="1491" char_id="-1" frame_id="-1" name=""   text="正好，电视节目也开始播放片尾字幕了。" voices=""/><clear @l="1494" class="char"/><char @l="1496" id="miho" pos="left" src="miho030"/><char @l="1499" id="rei" pos="right" src="rei030"/><msg @l="1501" char_id="1" frame_id="-1" name="玲" text="『作业没关系吗？』" voices=""/><msg @l="1503" char_id="0" frame_id="-1" name="美帆" text="『截止日期是本周末，所以没问题。』"   voices=""/><msg @l="1505" char_id="1" frame_id="-1" name="玲" text="『这样啊，加油哦。』"   voices=""/><char @l="1509" id="miho" pos="left" src="miho031"/><msg @l="1511" char_id="0" frame_id="-1" name="美帆" text="『嗯。谢谢您。』"   voices=""/><msg @l="1513" char_id="1" frame_id="-1" name="玲" text="『……。』" voices=""/><msg @l="1515" char_id="1" frame_id="-1" name="玲" text="『对不起啊。』"   voices=""/><char @l="1519" id="miho" pos="left" src="miho030"/><msg @l="1521" char_id="0" frame_id="-1" name="美帆" text="『嗯……？』" voices=""/><msg @l="1523" char_id="1" frame_id="-1" name="玲" text="『没能给你太多帮助。』"   voices=""/><msg @l="1525" char_id="0" frame_id="-1" name="美帆" text="『不会的，您帮了很大忙。』"   voices=""/><char @l="1529" id="miho" pos="left" src="miho031"/><msg @l="1531" char_id="0" frame_id="-1" name="美帆" text="『咖啡，很好喝。』"   voices=""/><char @l="1535" id="rei" pos="right" src="rei031"/><msg @l="1537" char_id="1" frame_id="-1" name="玲" text="『是吗……太好了。』"   voices=""/><char @l="1541" id="miho" pos="left" src="miho131"/><msg @l="1543" char_id="0" frame_id="-1" name="美帆" text="『那么，晚安。』"   voices=""/><stopbgm @l="1547" fadeout="1000"/><clear @l="1553" class="all"/><msgshow @l="1555" show="true"/><msg @l="1557" char_id="-1" frame_id="-1" name=""   text="然后，我泡了个热水澡，钻进了被窝。" voices=""/><msg @l="1558" char_id="-1" frame_id="-1" name=""   text="把被子盖到头上，慢慢闭上眼睛，困意很快就袭来。" voices=""/><msg @l="1559" char_id="-1" frame_id="-1" name=""   text="还没来得及想多余的事情，我就坠入了深沉的睡眠中。" voices=""/><msg @l="1561" char_id="1" frame_id="-1" name="声音" text="『……晚安。』" voices=""/><msg @l="1563" char_id="-1" frame_id="-1" name=""   text="恍惚间，在逐渐模糊的意识中，我听到了某人的声音。" voices=""/><msg @l="1564" char_id="-1" frame_id="-1" name=""   text="不知为何，那声音感觉像是白石学姐，又像是妈妈那样温柔。" voices=""/><msgshow @l="1567" show="false"/><call @l="1570" target="EventLabel_23@common_root02"/><return @l="1571" value="0&#13;&#10;"/></code></xscript>																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																								