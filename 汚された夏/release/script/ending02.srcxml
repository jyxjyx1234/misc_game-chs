<?xml version="1.0" encoding="utf-8"?><xscript><debug editor="&quot;C:\Program&#32;Files&#32;(x86)\sakura\sakura.exe&quot;&#32;&quot;%src%&quot;&#32;-Y=%line%"   src="D:\シロップ\町ぐるみの罠＋汚された夏セット版\汚された夏\完成データ\汚された夏\script\text\ending02.txt"/><code><label @l="12" id="EventLabel_40"/><description @l="16" text="游泳部的共用宠物"/><eval @l="18" expr="f.numDay=0&#13;&#10;"/><msg @l="22" char_id="-1" frame_id="-1" name="" text="然后……。" voices=""/><wait_chgmv/><bg @l="26" src="bg10b"/><msg @l="28" char_id="-1" frame_id="-1" name="" text="两天过去了。" voices=""/><msg @l="29" char_id="-1" frame_id="-1" name="" text="我现在仍旧几乎每天都去游泳池。"   voices=""/><msg @l="30" char_id="-1" frame_id="-1" name="" text="去那个已经没有亚季奈的游泳池。"   voices=""/><char @l="34" id="watab" pos="left" src="watabe010"/><char @l="37" id="miho" pos="right" src="miho060"/><bgm @l="41" src="bgm10" volume="1."/><msg @l="43" char_id="-1" frame_id="-1" name="渡部"   text="『好，今天的训练就到此为止吧。』" voices=""/><msg @l="45" char_id="-1" frame_id="-1" name=""   text="渡部的声音在泳池内回荡，仿佛早就在等这一刻，游泳部的男生们全都面带猥琐的笑容看向我。" voices=""/><msg @l="46" char_id="-1" frame_id="-1" name=""   text="女孩子们则都带着鄙视或无奈的表情离开了泳池。" voices=""/><msg @l="47" char_id="-1" frame_id="-1" name="" text="这也是理所当然的吧……。"   voices=""/><msg @l="48" char_id="-1" frame_id="-1" name=""   text="她们知道，训练结束后我们会做什么。" voices=""/><msg @l="49" char_id="-1" frame_id="-1" name="" text="对普通人来说，这是理所当然的反应。"   voices=""/><msg @l="51" char_id="0" frame_id="-1" name="美帆" text="『……。』"   voices="miho11100"/><msg @l="53" char_id="-1" frame_id="-1" name=""   text="部员中有些人不再参加集训了，我还听说有几个人因为受不了这种荒唐行为，已经退出了游泳部。"   voices=""/><msg @l="54" char_id="-1" frame_id="-1" name=""   text="那天在泳池边，把我当做自慰对象的那个孩子……听说也退出了游泳部。"   voices=""/><msg @l="55" char_id="-1" frame_id="-1" name=""   text="留下来的某个部员说，那孩子对我抱有好感。" voices=""/><msg @l="56" char_id="-1" frame_id="-1" name=""   text="但是现在，这些事对我来说已经无所谓了。" voices=""/><msg @l="58" char_id="-1" frame_id="-1" name="渡部"   text="『今天仲根教练也会为你们缓解疲劳。所以要好好训练，提高成绩啊。』" voices=""/><msg @l="60" char_id="-1" frame_id="-1" name="游泳部男生" text="『是！』" voices=""/><stopbgm @l="64" fadeout="1000"/><clear @l="70" class="all"/><label @l="73" id="event_scene37"/><msgshow @l="76" show="true"/><label @l="80" id="chart_line25"/><wait_chgmv/><ev @l="84" src="ev-037"/><bgm @l="88" src="bgm14" volume="1."/><msg @l="90" char_id="0" frame_id="-1" name="美帆"   text="『嗯…嗯……嗯咕………呼啊。』" voices="miho11110"/><msg @l="92" char_id="-1" frame_id="-1" name="" text="这是第几次了呢。"   voices=""/><msg @l="93" char_id="-1" frame_id="-1" name=""   text="我将口腔内释放出的腥臭液体，按照命令一饮而尽。" voices=""/><msg @l="94" char_id="-1" frame_id="-1" name=""   text="训练中我是指导者，但训练后却不被允许违抗他们。" voices=""/><msg @l="96" char_id="-1" frame_id="-1" name="游泳部成员A"   text="『喂。别休息了，下一个轮到我了。』" voices=""/><msg @l="98" char_id="0" frame_id="-1" name="美帆"   text="『是……啊呣……嗯，咕……。』" voices="miho11120"/><msg @l="100" char_id="-1" frame_id="-1" name=""   text="当新的东西递到嘴边时，我就按照指示含住它。" voices=""/><msg @l="101" char_id="-1" frame_id="-1" name=""   text="一开始觉得刺鼻的氯气味，与喉咙深处残留的精液气味相比，几乎已经不被在意了。" voices=""/><msg @l="103" char_id="-1" frame_id="-1" name="游泳部成员B"   text="『搞什么啊，好不容易紧得正舒服……让她口交后注意力分散变松了啊。』" voices=""/><msg @l="105" char_id="-1" frame_id="-1" name="游泳部成员A"   text="『那你也让她给你口交啊。这家伙最近终于学会用舌头了，感觉很不错哦？』" voices=""/><msg @l="107" char_id="-1" frame_id="-1" name="渡部"   text="『你们还是太嫩了……处女穴虽然不错，但男人果然还是后面吧。这入口的紧致感，真是爽到不行啊。』"   voices=""/><msg @l="109" char_id="-1" frame_id="-1" name=""   text="我用嘴，秘缝，甚至后穴都在服侍着他们。" voices=""/><msg @l="110" char_id="-1" frame_id="-1" name=""   text="渡部先生开始喜欢上了后面，最近总是专攻那里。" voices=""/><msg @l="111" char_id="-1" frame_id="-1" name=""   text="他们一边口出下流言语，一边肆意蹂躏我的身体。" voices=""/><msg @l="112" char_id="-1" frame_id="-1" name=""   text="在他们的行为中，丝毫看不到罪恶感或同情这类情感。" voices=""/><msg @l="114" char_id="0" frame_id="-1" name="美帆"   text="『嗯嗯…嗯姆，啊呜…嗯，嗯，嗯姆…。』" voices="miho11130"/><msg @l="115" char_id="-1" frame_id="-1" name=""   text="含着的那个人用放在我头上的手粗暴地把我拉开。" voices=""/><msg @l="117" char_id="-1" frame_id="-1" name="游泳部成员A"   text="『喂喂别偷懒，好好舔啊。而且我不是教过你尽量发出啧啧的声音，色情地吮吸吗？不要用手，只用嘴和舌头。』"   voices=""/><msg @l="119" char_id="0" frame_id="-1" name="美帆"   text="『嗯哈…对，对不起…嗯姆，嗯…啾噜。』" voices="miho11140"/><msg @l="121" char_id="-1" frame_id="-1" name=""   text="我慌忙重新含住龟头，用舌头缠绕，吮吸尿道口。" voices=""/><msg @l="122" char_id="-1" frame_id="-1" name=""   text="将唾液集中在冠状沟上，然后在口中留出空隙让声音漏出。" voices=""/><msg @l="123" char_id="-1" frame_id="-1" name="" text="按照指示发出声音，反复这个动作。"   voices=""/><msg @l="125" char_id="-1" frame_id="-1" name="游泳部成员B"   text="『喔，指示还真是详细啊。』" voices=""/><msg @l="127" char_id="-1" frame_id="-1" name="游泳部成员A"   text="『笨蛋，调教当然要做到这种程度啊。』" voices=""/><msg @l="129" char_id="-1" frame_id="-1" name="渡部"   text="『哈哈哈，你开始懂得说这种话了啊。老师很高兴。』" voices=""/><msg @l="131" char_id="-1" frame_id="-1" name="游泳部成员A"   text="『啊，谢谢您！』" voices=""/><msg @l="133" char_id="0" frame_id="-1" name="美帆"   text="『嗯，嗯嗯……啊呜，嗯……啾噗，嗯咕……啾啪。』" voices="miho11150"/><msg @l="135" char_id="-1" frame_id="-1" name=""   text="听着这样的对话，我按照指示继续摆动着头部和腰部。" voices=""/><msg @l="137" char_id="0" frame_id="-1" name="美帆"   text="『嗯，嗯，嗯，嗯……嗯哈……啊，嗯嗯！！』" voices="miho11160"/><msg @l="139" char_id="-1" frame_id="-1" name=""   text="突如其来的从下方顶撞击中了子宫口，一阵甜美的麻痹感袭击了我的小腹。" voices=""/><msg @l="140" char_id="-1" frame_id="-1" name="" text="不由得松开了嘴里含着的东西。"   voices=""/><msg @l="141" char_id="-1" frame_id="-1" name=""   text="积聚在口中的唾液从嘴角溢出，滴落在下面顶撞我的那个人的胸膛上。" voices=""/><msg @l="143" char_id="-1" frame_id="-1" name="游泳部成员A"   text="『啊，喂……你太猛烈地顶撞，才让她吐出来了吧。』" voices=""/><msg @l="145" char_id="-1" frame_id="-1" name="游泳部成员B"   text="『谁有工夫陪你玩什么调教游戏啊。还有，别流口水啊！太脏了吧！』" voices=""/><msg @l="147" char_id="-1" frame_id="-1" name=""   text="插入我私处的那个人这么说着，更加猛烈地顶撞着我的子宫。" voices=""/><msg @l="148" char_id="-1" frame_id="-1" name=""   text="他微微晃动着腰部，在我的阴道内各个方向肆虐。" voices=""/><msg @l="149" char_id="-1" frame_id="-1" name=""   text="张开的伞状部分，时不时刮擦着我的敏感处。" voices=""/><msg @l="150" char_id="-1" frame_id="-1" name=""   text="褶皱被伞状部分卷入，渗出的爱液从秘缝的缝隙中被刮出。" voices=""/><msg @l="152" char_id="0" frame_id="-1" name="美帆"   text="『啊啊……啊，嗯啊……嗯，嗯，嗯嗯！！』" voices="miho11170"/><msg @l="154" char_id="-1" frame_id="-1" name="游泳部成员B"   text="『哦，她爽起来了爽起来了。』" voices=""/><msg @l="156" char_id="-1" frame_id="-1" name=""   text="渡部老师缓慢而长时间的抽插让我的菊座变得火热。" voices=""/><msg @l="157" char_id="-1" frame_id="-1" name="" text="排泄感和插入感让我兴奋不已。"   voices=""/><msg @l="158" char_id="-1" frame_id="-1" name=""   text="当我的臀部与渡部老师的腰紧贴在一起时，子宫从直肠被向上推挤，一瞬间，呼吸停滞了。" voices=""/><msg @l="160" char_id="-1" frame_id="-1" name="渡部"   text="『哦！感觉真不错。隔着一层肉壁都能感受到这边的摩擦啊。』" voices=""/><msg @l="162" char_id="-1" frame_id="-1" name="游泳部成员B"   text="『这就是双穴责罚的醍醐味啊。』" voices=""/><msg @l="164" char_id="-1" frame_id="-1" name="渡部"   text="『没错。那么就让仲根教练，好好品尝一下我们师徒组合的厉害吧。』" voices=""/><msg @l="166" char_id="-1" frame_id="-1" name="游泳部成员B" text="『是！』"   voices=""/><msg @l="168" char_id="-1" frame_id="-1" name=""   text="下面的肉棒猛烈地撞击着插入直肠的坚挺。" voices=""/><msg @l="169" char_id="-1" frame_id="-1" name=""   text="阴茎摩擦着被挤压的阴道壁。" voices=""/><msg @l="170" char_id="-1" frame_id="-1" name=""   text="两人配合着交替顶弄，子宫被剧烈摇晃，眼前一阵阵发黑。" voices=""/><msg @l="172" char_id="0" frame_id="-1" name="美帆"   text="『不行…那个，后面的在摩擦……呜，啊呜！！』" voices="miho11180"/><msg @l="174" char_id="-1" frame_id="-1" name=""   text="渡部老师的动作变得更加猛烈，打断了我的话。" voices=""/><msg @l="176" char_id="-1" frame_id="-1" name="渡部"   text="『仲根教练。光是享受可不行啊，这样下去什么时候才能结束呢？』" voices=""/><msg @l="178" char_id="-1" frame_id="-1" name=""   text="他一边说着，一边捏起我胸前的凸起。我的乳头早在事情开始前就已经充血了。" voices=""/><msg @l="180" char_id="-1" frame_id="-1" name="渡部"   text="『既然有空让乳头勃起，那就好好收紧你的阴道和肛门啊！』" voices=""/><msg @l="182" char_id="-1" frame_id="-1" name="游泳部成员B"   text="『我可是在帮教练尽快结束呢？结果教练却只顾自己享受？真过分啊。』"   voices=""/><msg @l="184" char_id="-1" frame_id="-1" name="渡部"   text="『真是的，真是个淫乱又懒散的教练。看来得花更多时间好好指导你才行啊？』" voices=""/><msg @l="186" char_id="0" frame_id="-1" name="美帆"   text="『嗯，嗯嗯……嗯呜……嗯，啾，啾噜。』" voices="miho11190"/><msg @l="188" char_id="-1" frame_id="-1" name="" text="听到渡部的话，我不寒而栗。"   voices=""/><msg @l="189" char_id="-1" frame_id="-1" name=""   text="之前，在指导的名义下，我被一直侵犯到早上。" voices=""/><msg @l="190" char_id="-1" frame_id="-1" name=""   text="中途我曾经昏过去，但即使在那期间也在被侵犯着。" voices=""/><msg @l="191" char_id="-1" frame_id="-1" name=""   text="当我醒来时，子宫和肛门都已经被灌得满满的，一按肚子，精液就会发出声音喷涌而出。" voices=""/><msg @l="192" char_id="-1" frame_id="-1" name="" text="那段我绝不想再经历的惨痛记忆涌上心头。"   voices=""/><msg @l="194" char_id="0" frame_id="-1" name="美帆"   text="『嗯呼，哈呼……嗯咕……嗯噗，嗯噗……嗯哈！！』" voices="miho11200"/><msg @l="196" char_id="-1" frame_id="-1" name="游泳部成员A"   text="『哦，不错啊～，自己开始吮吸了。对对，服侍就是要主动才行。』" voices=""/><msg @l="198" char_id="-1" frame_id="-1" name="游泳部成员B"   text="『这边的感觉也突然变好了。不愧是教练，只要努力就能做到嘛。』" voices=""/><msg @l="200" char_id="0" frame_id="-1" name="美帆"   text="『嗯呜呜……嗯，嗯咕……哈呼，啾噗！』" voices="miho11210"/><msg @l="202" char_id="-1" frame_id="-1" name="游泳部成员A"   text="『怎么样？好吃吗？我的肉棒。』" voices=""/><msg @l="204" char_id="0" frame_id="-1" name="美帆"   text="『呼啊……嗯，嗯嗯……啾噗，嗯……嗯噗，嗯噗！』" voices="miho11220"/><msg @l="206" char_id="-1" frame_id="-1" name="渡部"   text="『是不是肉棒太美味了，连回答都不能了？哈哈！』" voices=""/><msg @l="208" char_id="-1" frame_id="-1" name=""   text="即使前后两处都被猛烈顶弄着，我仍拼命吮吸着被塞入口中的阴茎前端。" voices=""/><msg @l="209" char_id="-1" frame_id="-1" name=""   text="我将它含到喉咙深处，用喉部肌肉挤压着，用嘴唇夹住阴囊。" voices=""/><msg @l="211" char_id="-1" frame_id="-1" name=""   text="我用力收紧下腹部，同时绞紧阴道和后庭。" voices=""/><msg @l="212" char_id="-1" frame_id="-1" name=""   text="这样反而会让刺激变得更强烈，但不这样做的话就会被他们无休止地折磨下去。" voices=""/><msg @l="214" char_id="-1" frame_id="-1" name=""   text="要结束这场噩梦般的时间只有一个方法。" voices=""/><msg @l="215" char_id="-1" frame_id="-1" name=""   text="用尽一切可能的方式满足他们，让他们尽快射精。" voices=""/><msg @l="216" char_id="-1" frame_id="-1" name="" text="除此之外……别无他法……。"   voices=""/><msg @l="218" char_id="-1" frame_id="-1" name="游泳部成员A"   text="『哦，真厉害的舌技……再，再含深点，吞到喉咙里……。』" voices=""/><msg @l="220" char_id="-1" frame_id="-1" name="渡部"   text="『这边每次动腰的时候，她后面的肉也变得柔软了，感觉真不错。肠液也似乎逐渐适应了。』"   voices=""/><msg @l="222" char_id="-1" frame_id="-1" name="游泳部成员B"   text="『太棒了，这种缠绕感简直极品。』" voices=""/><msg @l="224" char_id="0" frame_id="-1" name="美帆"   text="『嗯嗯……嗯，嗯咕……哈呼……嗯，嗯咕。』" voices="miho11230"/><msg @l="226" char_id="0" frame_id="-1" name="美帆"   text="『哈……哈………啊姆……嗯咕，啾噗，啾噗噗！』" voices="miho11240"/><msg @l="228" char_id="-1" frame_id="-1" name="游泳部成员A"   text="『哦哦……要去了，要去了！？』" voices=""/><msg @l="230" char_id="-1" frame_id="-1" name="游泳部成员B"   text="『我，我也是……快要射了。』" voices=""/><msg @l="232" char_id="-1" frame_id="-1" name="渡部" text="『好，大家一起射精吧！』"   voices=""/><msg @l="234" char_id="-1" frame_id="-1" name=""   text="他们的性器官像是要刮掉我喉咙、粘膜和肠壁一样膨胀起来。" voices=""/><msg @l="236" char_id="0" frame_id="-1" name="美帆"   text="『啊呜，嗯，嗯，嗯嗯……啊，嗯咕！！』" voices="miho11250"/><msg @l="238" char_id="0" frame_id="-1" name="美帆"   text="『嗯噗……啾噗，嗯咕……嗯，嗯噗……啾噜噜！』" voices="miho11260"/><msg @l="240" char_id="-1" frame_id="-1" name="游泳部成员们" text="『呃……！！』"   voices=""/><msg @l="242" char_id="-1" frame_id="-1" name="渡部" text="『唔哦！！』" voices=""/><wait_chgmv/><ev @l="246" src="ev-037z1"/><msg @l="248" char_id="0" frame_id="-1" name="美帆" text="『嗯呜……！！』"   voices="miho11270"/><msg @l="250" char_id="-1" frame_id="-1" name="" text="3人紧紧地抱住我，贴在我身上。"   voices=""/><msg @l="251" char_id="-1" frame_id="-1" name="" text="屏住呼吸让精液流入食道。"   voices=""/><msg @l="252" char_id="-1" frame_id="-1" name=""   text="把弯曲的直肠拉直，精液喷射到了S形结肠上。" voices=""/><msg @l="253" char_id="-1" frame_id="-1" name=""   text="从紧贴着子宫口的铃口直接射击子宫。" voices=""/><msg @l="254" char_id="-1" frame_id="-1" name=""   text="为了一滴不漏，他们深入到我的极限，精液不断侵入。" voices=""/><msg @l="255" char_id="-1" frame_id="-1" name="" text="与此同时，我也迎来了高潮。"   voices=""/><msg @l="256" char_id="-1" frame_id="-1" name=""   text="大脑一片空白，从喉咙、后庭和子宫扩散开来的快感……" voices=""/><msg @l="257" char_id="-1" frame_id="-1" name=""   text="在各个部位感受着流入的精液的热度和数量，身体不住地颤抖着……" voices=""/><msg @l="260" char_id="-1" frame_id="-1" name="游泳部成员A"   text="『喂……全部喝完后要好好清理干净哦。』" voices=""/><msg @l="262" char_id="-1" frame_id="-1" name="" text="我不被允许休息。"   voices=""/><msg @l="263" char_id="-1" frame_id="-1" name="" text="立刻就被强迫进行下一轮服务。"   voices=""/><msg @l="265" char_id="0" frame_id="-1" name="美帆"   text="『嗯……唔咕……哈……哈………好的………。』" voices="miho11280"/><msg @l="267" char_id="0" frame_id="-1" name="美帆"   text="『啊呜，嗯……啾噗……舔……舔……啾噜噜。』" voices="miho11290"/><msg @l="269" char_id="-1" frame_id="-1" name=""   text="我一边急促地喘着粗气，一边再次对着伸过来的前端吸吮起来。" voices=""/><msg @l="270" char_id="-1" frame_id="-1" name=""   text="就这样把残留在尿道中的精液残渣全部吸干净……咽了下去。" voices=""/><msg @l="272" char_id="-1" frame_id="-1" name="渡部"   text="『那边结束了的话，接下来把我的也弄干净。毕竟，刚才可是插进你屁股里的啊。』" voices=""/><msg @l="274" char_id="-1" frame_id="-1" name="游泳部成员B" text="『也帮我弄干净哦～。』"   voices=""/><msg @l="276" char_id="-1" frame_id="-1" name=""   text="没有回答，我只是继续舔舐着精液……。" voices=""/><stopbgm @l="280" fadeout="1000"/><clear @l="284" class="ev"/><wait_chgmv/><bg @l="288" src="bg10b"/><stopbgm @l="292" fadeout="1000"/><msg @l="294" char_id="-1" frame_id="-1" name="游泳部成员A"   text="『呼，果然口交最棒了。』" voices=""/><msg @l="296" char_id="-1" frame_id="-1" name="游泳部成员B"   text="『笨蛋，内射小穴才是男人的浪漫啊。』" voices=""/><msg @l="298" char_id="-1" frame_id="-1" name="渡部"   text="『小穴也不错，但比起那个，菊穴好像更加驯服了呢。』" voices=""/><msg @l="300" char_id="-1" frame_id="-1" name=""   text="行为结束后，那些之前热衷于侵犯我身体的游泳部的孩子们和渡部老师离开了。" voices=""/><msg @l="301" char_id="-1" frame_id="-1" name=""   text="然后，等待轮到的下一批孩子们……开始贪婪地享用我的身体。" voices=""/><msg @l="302" char_id="-1" frame_id="-1" name="" text="部员们还有很多。" voices=""/><msg @l="303" char_id="-1" frame_id="-1" name="" text="这就是我的每一天。" voices=""/><msg @l="304" char_id="-1" frame_id="-1" name="" text="这就是我的日常。" voices=""/><msg @l="305" char_id="-1" frame_id="-1" name="" text="我已经……无法回头了。"   voices=""/><msg @l="307" char_id="0" frame_id="-1" name="美帆" text="『……。』"   voices="miho11300"/><msg @l="309" char_id="0" frame_id="-1" name="美帆" text="(亚季奈……我，会努力的……)"   voices="miho11310"/><msg @l="311" char_id="0" frame_id="-1" name="美帆" text="(一定会……保护你的……)"   voices="miho11320"/><msg @l="313" char_id="-1" frame_id="-1" name=""   text="当被精液污染的秘处，刚刚闭合的肛门，再次感受到侵入的男根时，我的腰不由自主地颤抖着，心中默默念着……"   voices=""/><stopbgm @l="317" fadeout="1000"/><clear @l="323" class="all"/><end_scene @l="326"/><eval @l="330" expr="s.flagGallery=1&#13;&#10;"/><eval @l="332" expr="s.event37flag=1&#13;&#10;"/><eval @l="336"   expr="f.bEx&#32;=&#32;s.event20flag&#32;&amp;&amp;&#32;s.event23flag&#32;&amp;&amp;&#32;s.event25flag&#32;&amp;&amp;&#32;s.event30flag&#32;&amp;&amp;&#32;s.event31flag&#32;&amp;&amp;&#32;s.event32flag&#32;&amp;&amp;&#32;s.event33flag&#32;&amp;&amp;&#32;s.event35flag&#32;&amp;&amp;&#32;s.event37flag&#32;&amp;&amp;&#32;s.event38flag&#32;&amp;&amp;&#32;s.event60flag&#13;&#10;"/><goto @l="338" cond="!(f.bEx)&#13;&#10;" label="TempLabel_228"/><eval @l="340" expr="s.exRootFlag=1&#13;&#10;"/><label @l="341" id="TempLabel_228"/><ending @l="343"/><goto @l="345" cond="!(f.bEx)&#13;&#10;" label="TempLabel_229"/><wait_chgmv/><bg @l="349" src="newroot"/><wait @l="351" time="5000"/><wait_chgmv/><bg @l="353" src="black"/><label @l="356" id="TempLabel_229"/><return @l="360" value=""/></code></xscript>																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																										