<?xml version="1.0" encoding="utf-8"?><xscript><debug editor="&quot;C:\Program&#32;Files&#32;(x86)\sakura\sakura.exe&quot;&#32;&quot;%src%&quot;&#32;-Y=%line%"   src="D:\シロップ\町ぐるみの罠＋汚された夏セット版\汚された夏\完成データ\汚された夏\script\text\ending06.txt"/><code><label @l="12" id="EventLabel_44"/><description @l="16" text="疯狂的系统"/><eval @l="18" expr="f.numDay=0&#13;&#10;"/><wait_chgmv/><bg @l="22" src="bg03a"/><bgm @l="26" src="bgm03" volume="1."/><char @l="30" id="miho" pos="auto" src="miho125"/><msg @l="32" char_id="0" frame_id="-1" name="美帆" text="『……学长，最终还是没有回来啊。』"   voices="miho11580"/><msg @l="34" char_id="-1" frame_id="-1" name="" text="那之后已经过了半年。" voices=""/><msg @l="35" char_id="-1" frame_id="-1" name="" text="学长一次也没有回过家。"   voices=""/><msg @l="36" char_id="-1" frame_id="-1" name=""   text="我试着多次拨打他的手机，但显示无信号连接不上。" voices=""/><msg @l="37" char_id="-1" frame_id="-1" name=""   text="即使向他所属的社团询问，也被告知没人知道他的去向……。" voices=""/><msg @l="38" char_id="-1" frame_id="-1" name=""   text="找学校交涉，但因为他已经取得了全部学分，学校方面并不认为有什么问题，反而说他可能是在毕业前去了一次长期旅行之类的。"   voices=""/><msg @l="39" char_id="-1" frame_id="-1" name=""   text="我多次前往可能的地点寻找，但始终找不到他，最后只能求助警察。然而——" voices=""/><msg @l="41" char_id="-1" frame_id="-1" name="警察"   text="『按照这个镇的规则，不可能出现失踪者。一定是你弄错了。』" voices=""/><msg @l="43" char_id="-1" frame_id="-1" name=""   text="就这样，我因一个难以理解的理由被拒之门外。" voices=""/><msg @l="44" char_id="-1" frame_id="-1" name="" text="……但是我仍然继续寻找玲学长。"   voices=""/><msg @l="45" char_id="-1" frame_id="-1" name=""   text="如果那时……和玲见的最后一面时……能够挽留住他的话……" voices=""/><msg @l="47" char_id="-1" frame_id="-1" name=""   text="如果能多为看起来很痛苦的玲着想，而不是只考虑自己的话……" voices=""/><msg @l="49" char_id="-1" frame_id="-1" name=""   text="如果还能有机会再见面的话，我想对玲说一句话。" voices=""/><msg @l="51" char_id="-1" frame_id="-1" name=""   text="“如果有烦恼的话请跟我商量。……因为我，一直把玲当作家人啊……我想成为你的力量。”"   voices=""/><msg @l="53" char_id="-1" frame_id="-1" name="" text="然而……这个愿望没能实现。"   voices=""/><msg @l="55" char_id="0" frame_id="-1" name="美帆" text="『行李，这是最后一件……吧。』"   voices="miho11590"/><msg @l="57" char_id="-1" frame_id="-1" name=""   text="我从沙发上拿起一直钟爱使用的包包，自言自语道。" voices=""/><msg @l="58" char_id="-1" frame_id="-1" name=""   text="其他行李刚刚已经被搬家公司的人运出去了。" voices=""/><msg @l="59" char_id="-1" frame_id="-1" name="" text="我决定退学……回老家。"   voices=""/><msg @l="60" char_id="-1" frame_id="-1" name=""   text="我已经没有自信继续一个人等待玲学长了。" voices=""/><msg @l="61" char_id="-1" frame_id="-1" name=""   text="待在这里的话，每天都会想起玲学长不在了这件事，感觉心都要碎了。" voices=""/><msg @l="62" char_id="-1" frame_id="-1" name=""   text="一个人承受这些实在太痛苦了，我向父亲倾诉后，他说会拜托认识的警察总部的人去寻找，让我不要担心，回老家来。"   voices=""/><msg @l="63" char_id="-1" frame_id="-1" name="" text="我一边流泪一边照父亲的话做了。"   voices=""/><msg @l="64" char_id="-1" frame_id="-1" name=""   text="为什么，会变成这样呢……" voices=""/><msg @l="65" char_id="-1" frame_id="-1" name=""   text="虽然不太明白，但我总觉得这一切都是因为这个镇子疯了的缘故——" voices=""/><msg @l="67" char_id="-1" frame_id="-1" name="搬家工人"   text="『那么，我们差不多要出发了。』" voices=""/><char @l="71" id="miho" pos="auto" src="miho025"/><msg @l="73" char_id="0" frame_id="-1" name="美帆" text="『好的……拜托了。』"   voices="miho11600"/><msg @l="75" char_id="-1" frame_id="-1" name=""   text="我回答后，搬家公司的人拿着行李，走出了房间。" voices=""/><msg @l="76" char_id="-1" frame_id="-1" name=""   text="公寓楼下有搬家用的卡车在待命，按照约定会把行李直接送到我老家去。" voices=""/><char @l="80" id="miho" pos="auto" src="miho125"/><msg @l="82" char_id="0" frame_id="-1" name="美帆" text="『……。』"   voices="miho11610"/><char @l="86" id="miho" pos="auto" src="miho115"/><msg @l="88" char_id="0" frame_id="-1" name="美帆" text="『这个……我放这里了，学长。』"   voices="miho11620"/><msg @l="90" char_id="-1" frame_id="-1" name=""   text="我把手中心爱的包放在沙发上，也离开了房间。" voices=""/><msg @l="91" char_id="-1" frame_id="-1" name=""   text="这是我最珍视的包。这么做是因为我觉得，如果玲看到这个包，就能明白我一直在等她的心情。"   voices=""/><char @l="95" id="miho" pos="auto" src="miho015"/><msg @l="97" char_id="0" frame_id="-1" name="美帆" text="『……再见。』"   voices="miho11630"/><clear @l="101" class="char"/><msg @l="103" char_id="-1" frame_id="-1" name=""   text="最后只轻声说了一句话，我也……离开了房间。" voices=""/><stopbgm @l="107" fadeout="1000"/><clear @l="113" class="all"/><msgshow @l="116" show="true"/><msg @l="117" char_id="-1" frame_id="-1" name=""   text="美帆离开这个小镇时感到的不安——那是正确的。" voices=""/><msg @l="118" char_id="-1" frame_id="-1" name=""   text="其实在这个南总町，某个计划正在推进……那是将整个小镇变成巨大性欲处理场的恶劣计划。" voices=""/><msg @l="119" char_id="-1" frame_id="-1" name=""   text="被引进的企业只要出示员工证就能免费获得性服务，作为回报，企业会为当地带来巨大的经济效益。"   voices=""/><msg @l="120" char_id="-1" frame_id="-1" name=""   text="已经有多家大企业决定进驻，镇上各种商店和住宅的女性们都开始过上了白天一面、夜晚另一面的生活……" voices=""/><msg @l="121" char_id="-1" frame_id="-1" name=""   text="而玲也被卷入了这个计划。" voices=""/><msg @l="122" char_id="-1" frame_id="-1" name=""   text="而且，由于这个计划的核心人物之一是大黑满彦，出于大黑的报复，玲不仅仅被赋予了一个夜晚的面孔，还被安排了一个更加凄惨的角色——。"   voices=""/><wait_chgmv/><bg @l="126" src="bg17hm1"/><bgm @l="130" src="bgm03" volume="1."/><msg @l="132" char_id="-1" frame_id="-1" name="" text="———同日·大黑建设办公室。"   voices=""/><msg @l="134" char_id="-1" frame_id="-1" name="男员工A" text="『嗯～，终于到午休时间了。』"   voices=""/><msg @l="136" char_id="-1" frame_id="-1" name="男员工A"   text="『白天时间过得太慢，真让人厌烦。』" voices=""/><msg @l="138" char_id="-1" frame_id="-1" name="男员工B"   text="『这边的工作太无聊了啊……。』" voices=""/><msg @l="140" char_id="-1" frame_id="-1" name="" text="人才派遣部门里进行着如常的对话。"   voices=""/><msg @l="141" char_id="-1" frame_id="-1" name=""   text="由于白天他们只能处理一些无关紧要的文书工作，他们的积极性也在不断下降。" voices=""/><msg @l="143" char_id="-1" frame_id="-1" name="男员工A"   text="『这种时候果然还是去趟厕所清爽一下吧！』" voices=""/><msg @l="145" char_id="-1" frame_id="-1" name="男员工B"   text="『啊—，不行不行。要用厕所的话得在午休一开始就去，不然在排队等待的时候休息时间就结束了。』" voices=""/><msg @l="147" char_id="-1" frame_id="-1" name="男员工A"   text="『真的假的……唉，明明是我们的厕所。』" voices=""/><msg @l="149" char_id="-1" frame_id="-1" name=""   text="这个以白天萎靡不振而闻名的人才派遣部，新增设的「厕所」的消息，已经传遍了其他部门。" voices=""/><msg @l="150" char_id="-1" frame_id="-1" name=""   text="从那以后，人才派遣部办公室所在楼层的男厕，一到午休或下班时间就人满为患，排起长龙。"   voices=""/><msg @l="151" char_id="-1" frame_id="-1" name=""   text="这完全是因为便器质量好……这是员工们之间的评价。" voices=""/><stopbgm @l="155" fadeout="1000"/><clear @l="161" class="all"/><label @l="164" id="event_scene30"/><msgshow @l="167" show="true"/><msg @l="169" char_id="-1" frame_id="-1" name="男员工" text="『啊，啊啊啊！』"   voices=""/><msg @l="171" char_id="-1" frame_id="-1" name="" text="男厕里，短促的咆哮声回荡。"   voices=""/><msg @l="172" char_id="-1" frame_id="-1" name=""   text="与此同时，正在使用「厕所」的男子腰部猛地一颤，大量白浊液体被排泄到便器中。" voices=""/><label @l="176" id="chart_line32"/><wait_chgmv/><ev @l="180" src="ev-030"/><bgm @l="184" src="bgm14" volume="1."/><msg @l="186" char_id="1" frame_id="-1" name="玲" text="『呣嗯……。』"   voices="rei02610"/><msg @l="188" char_id="-1" frame_id="-1" name=""   text="玲的阴道内被注入大量精液，她微微呼出一口气。" voices=""/><msg @l="189" char_id="-1" frame_id="-1" name=""   text="她被绑住双手双脚扔在厕所的一角，已经度过了好几天。" voices=""/><msg @l="190" char_id="-1" frame_id="-1" name=""   text="「普通职员专用厕所」……这就是玲被赋予的工作职责。" voices=""/><msg @l="191" char_id="-1" frame_id="-1" name=""   text="即使是在南总町，面对大黑集团这样的大企业，也无法完全处理所有员工的性欲。" voices=""/><msg @l="192" char_id="-1" frame_id="-1" name=""   text="于是，以分担维护费用的形式，公司内部设置了普通职员专用的厕所。" voices=""/><msg @l="193" char_id="-1" frame_id="-1" name="" text="厕所角落里的分娩台。" voices=""/><msg @l="194" char_id="-1" frame_id="-1" name=""   text="并非孕妇的玲被固定在上面，双腿被大大分开，暴露出阴道口。" voices=""/><msg @l="195" char_id="-1" frame_id="-1" name=""   text="口中塞着口球，连发出正常声音都做不到。" voices=""/><msg @l="196" char_id="-1" frame_id="-1" name=""   text="身体上装着黑色菱形束缚带，淫靡地装饰着她白皙光滑的肌肤。还有大量精液缠绕其上，散发着独特的异味。"   voices=""/><msg @l="197" char_id="-1" frame_id="-1" name=""   text="下班时间过后，当所有员工都回家了，便会用水管冲洗，进行便器的清洁。" voices=""/><msg @l="198" char_id="-1" frame_id="-1" name=""   text="在那之前，她只能一直浸泡在排泄物中。" voices=""/><msg @l="200" char_id="-1" frame_id="-1" name=""   text="就这样，玲……每天都在不断被侵犯………。" voices=""/><msg @l="202" char_id="-1" frame_id="-1" name="" text="咚咚咚咚咚" voices=""/><msg @l="204" char_id="-1" frame_id="-1" name="男员工" text="『……呼。』"   voices=""/><msg @l="206" char_id="-1" frame_id="-1" name=""   text="他将滚烫的大量白浊液体射入那抽搐颤抖的淫靡蜜穴中，男职员满足地松了一口气。" voices=""/><msg @l="207" char_id="-1" frame_id="-1" name=""   text="这时，紧接着排在后面的男子发出了抱怨声。" voices=""/><msg @l="210" char_id="-1" frame_id="-1" name="资深员工"   text="『喂喂，后面还有人等着呢，你居然内射了。』" voices=""/><msg @l="212" char_id="-1" frame_id="-1" name="男员工"   text="『无所谓吧，反正就是个便器。射在哪里都随便不是吗。』" voices=""/><msg @l="214" char_id="-1" frame_id="-1" name="男员工E"   text="『切……今天只能用满是精液的便器将就了。喂，下一个轮到你了，时间不多了，快点。』" voices=""/><msg @l="216" char_id="-1" frame_id="-1" name="新员工" text="『啊，啊啊……。』"   voices=""/><msg @l="218" char_id="-1" frame_id="-1" name="资深员工"   text="『嗯，怎么了？难道说光是看着就射了？』" voices=""/><msg @l="220" char_id="-1" frame_id="-1" name="新员工"   text="『不，不是的！总觉得这个女孩……很像我大学里的一个女生……。』" voices=""/><msg @l="222" char_id="-1" frame_id="-1" name="资深员工"   text="『嘿——，那么也许这个女人可能是你大学里的那个女生？』" voices=""/><msg @l="223" char_id="-1" frame_id="-1" name="新员工"   text="『不，不可能的啦。我们大学里的那个女生可是被选为校花的美女呢。那样的女孩不可能做这种厕所工作的啦。现在估计已经嫁给哪个富豪了吧。』"   voices=""/><msg @l="225" char_id="-1" frame_id="-1" name="资深员工"   text="『嗯——，不过比起强奸完全不认识的女人，强奸一个长得像你认识的女人不是更有感觉吗。』" voices=""/><msg @l="227" char_id="-1" frame_id="-1" name="新员工"   text="『是，是这样的呢——。那就当她是我憧憬的校花“玲小姐”，尽情地侵犯她吧。』" voices=""/><msg @l="229" char_id="1" frame_id="-1" name="玲" text="『……唔……。』"   voices="rei02550"/><msg @l="231" char_id="-1" frame_id="-1" name=""   text="听到这句话的瞬间，玲的身体猛地颤抖了一下。“校花”……已经多久没听到这个词了呢……。那还是我能做“自己”的时候……。然而这样的想法很快就被新员工抚弄秘缝的触感冲散了。"   voices=""/><msg @l="233" char_id="1" frame_id="-1" name="玲" text="『嗯呜……。』"   voices="rei02610"/><msg @l="235" char_id="-1" frame_id="-1" name="新员工"   text="『嘿嘿，那我就给你来一发狠的吧。做好准备接受吧，你这厕所女！』" voices=""/><msg @l="237" char_id="-1" frame_id="-1" name=""   text="说着，他将凶悍的肉棒对准了玲的秘处。那狰狞的铅色肉伞张开到极致，上面布满了如蚯蚓般粗大的血管。"   voices=""/><msg @l="238" char_id="-1" frame_id="-1" name=""   text="新员工用力压下身体，分开粉色的秘缝嘴唇，将那黝黑的肉棒塞了进去。" voices=""/><msg @l="240" char_id="1" frame_id="-1" name="玲" text="『……啊……。』"   voices="rei02590"/><msg @l="242" char_id="-1" frame_id="-1" name=""   text="每当粗壮的男根在体内进出，剧烈的摩擦感就像拖拽着肉褶一样袭击着玲的身体，刺痛着她的大脑。"   voices=""/><msg @l="244" char_id="1" frame_id="-1" name="玲" text="『嗯……呜呜……。』"   voices="rei02620"/><msg @l="246" char_id="-1" frame_id="-1" name="新员工"   text="『什么啊，这个厕所女的下面，这么松啊。果然和那个“玲小姐”绝对不是一个人。』" voices=""/><msg @l="248" char_id="-1" frame_id="-1" name=""   text="新员工一边剧烈扭动腰部一边责骂玲。但对玲来说，这些话已经无法传达到她的意识中了。" voices=""/><msg @l="249" char_id="-1" frame_id="-1" name=""   text="伴随着噗嗤噗嗤的下流水声，先前那个男人排泄的白浊液体从玲的秘部溢了出来。" voices=""/><msg @l="251" char_id="1" frame_id="-1" name="玲"   text="『啊啊……啊……嗯啊啊……。』" voices="rei02630"/><msg @l="253" char_id="-1" frame_id="-1" name=""   text="玲发出低沉的喘息声，不时让她那瘫软的身体微微抽搐。" voices=""/><msg @l="254" char_id="-1" frame_id="-1" name=""   text="每当这时，含着男根的“便器”就会紧紧地收缩，给排泄行为带来更强烈的加速。" voices=""/><msg @l="255" char_id="-1" frame_id="-1" name="" text="这应该称之为无意识的奉献吧。"   voices=""/><msg @l="257" char_id="-1" frame_id="-1" name="资深员工"   text="『喂，你要磨蹭到什么时候啊。不快点的话时间就不够了。』" voices=""/><msg @l="259" char_id="-1" frame_id="-1" name="新员工" text="『我，我知道了啦。』"   voices=""/><msg @l="261" char_id="-1" frame_id="-1" name=""   text="作为公共便器，其使用需要保持迅速。" voices=""/><msg @l="262" char_id="-1" frame_id="-1" name=""   text="毕竟，在仅有一小时的午休时间内，有三十多人涌来。" voices=""/><msg @l="263" char_id="-1" frame_id="-1" name=""   text="即使每人两分钟完成排泄，也刚好能轮到所有人。" voices=""/><msg @l="265" char_id="-1" frame_id="-1" name="资深员工"   text="『啊，算了，我自己来撸吧。』" voices=""/><msg @l="267" char_id="-1" frame_id="-1" name="男员工A"   text="『我也是……如果午休结束还没射出来的话，下午的工作就没法专心了。』" voices=""/><msg @l="269" char_id="-1" frame_id="-1" name=""   text="预感到时间不够的男人们纷纷挤进男厕，对着便器各自撸动自己的肉棒。" voices=""/><msg @l="271" char_id="1" frame_id="-1" name="玲" text="『嗯……啊呜……。』"   voices="rei02640"/><msg @l="273" char_id="-1" frame_id="-1" name=""   text="玲恍惚地望着这一幕，发出甜美的喉音。" voices=""/><msg @l="274" char_id="-1" frame_id="-1" name=""   text="这声音是否是对即将射出的精液的期待，还是对那些不用她的身体就自行解决的男人们的喜悦，这点尚不明确。"   voices=""/><msg @l="275" char_id="-1" frame_id="-1" name=""   text="只是可以确定的是，她那甜美的声音更加激发了男人们的排泄感。" voices=""/><msg @l="277" char_id="-1" frame_id="-1" name="资深员工" text="『要，要射了！』"   voices=""/><msg @l="279" char_id="-1" frame_id="-1" name="男员工A"   text="『这边也是，我要射在你脸上。』" voices=""/><msg @l="281" char_id="-1" frame_id="-1" name="新员工"   text="『我，我也要出来了！！要灌满你的里面！』" voices=""/><flash @l="285" count="4" fade="100" image="white"/><wait_chgmv/><ev @l="289" src="ev-030z1"/><msg @l="291" char_id="1" frame_id="-1" name="玲" text="『嗯嗯……嗯，嗯呼……。』"   voices="rei02650"/><msg @l="293" char_id="-1" frame_id="-1" name=""   text="一瞬间，白浊色的排泄物将玲的身体弄得黏糊糊的。" voices=""/><msg @l="294" char_id="-1" frame_id="-1" name=""   text="然后，已经数不清第几次的大量精液被注入她淫荡的蜜壶中。" voices=""/><msg @l="295" char_id="-1" frame_id="-1" name=""   text="玲的身体微微抽搐着接受了这些，发出炽热的喘息。随即，伴随着啵咕的声音，蜜壶无法容纳的精液从秘缝处逆流而出。"   voices=""/><msg @l="297" char_id="-1" frame_id="-1" name="新员工"   text="『呼，真是舒畅了。但是果然是越靠近看越像啊，这个厕所女。』" voices=""/><msg @l="299" char_id="-1" frame_id="-1" name="资深员工"   text="『可恶……你小子可真好啊。能跟长得像校花的女人做爱，既兴奋又满足吧。……明天得早点来才行啊。』"   voices=""/><msg @l="300" char_id="-1" frame_id="-1" name="新员工"   text="『对，对不起。下次我会更早射出来的。』" voices=""/><msg @l="302" char_id="-1" frame_id="-1" name="资深员工"   text="『拜托了，年轻人。还有下次去人少的厕所吧。你还是个新人啊。』" voices=""/><msg @l="304" char_id="-1" frame_id="-1" name="新员工"   text="『知，知道了啦。……啊，对了，刚才听说，课长每晚都让蛋糕店的姐姐帮他弄出来……真是羡慕啊。』"   voices=""/><msg @l="306" char_id="-1" frame_id="-1" name="资深员工"   text="『那个女孩啊……我从她还小的时候就认识了，真的非常可爱啊。不可能轮到我们这边的……嘛，像我们这样的底层人物只能对着便器忍耐了。』"   voices=""/><msg @l="308" char_id="-1" frame_id="-1" name=""   text="对着便器发泄完的男人们一边嘀咕着一边离开了那个地方。" voices=""/><msg @l="309" char_id="-1" frame_id="-1" name="" text="没有一个人关心那个便器的感受。"   voices=""/><msg @l="310" char_id="-1" frame_id="-1" name=""   text="这是因为他们知道……这对现在的玲来说，是最大的愉悦。" voices=""/><stopbgm @l="314" fadeout="1000"/><clear @l="320" class="all"/><end_scene @l="323"/><eval @l="327" expr="s.flagGallery=1&#13;&#10;"/><eval @l="329" expr="s.event30flag=1&#13;&#10;"/><eval @l="333"   expr="f.bEx&#32;=&#32;s.event20flag&#32;&amp;&amp;&#32;s.event23flag&#32;&amp;&amp;&#32;s.event25flag&#32;&amp;&amp;&#32;s.event30flag&#32;&amp;&amp;&#32;s.event31flag&#32;&amp;&amp;&#32;s.event32flag&#32;&amp;&amp;&#32;s.event33flag&#32;&amp;&amp;&#32;s.event35flag&#32;&amp;&amp;&#32;s.event37flag&#32;&amp;&amp;&#32;s.event38flag&#32;&amp;&amp;&#32;s.event60flag&#13;&#10;"/><goto @l="335" cond="!(f.bEx)&#13;&#10;" label="TempLabel_243"/><eval @l="337" expr="s.exRootFlag=1&#13;&#10;"/><label @l="338" id="TempLabel_243"/><ending @l="340"/><goto @l="342" cond="!(f.bEx)&#13;&#10;" label="TempLabel_244"/><wait_chgmv/><bg @l="346" src="newroot"/><wait @l="348" time="5000"/><wait_chgmv/><bg @l="350" src="black"/><label @l="353" id="TempLabel_244"/><return @l="357" value=""/></code></xscript>																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																