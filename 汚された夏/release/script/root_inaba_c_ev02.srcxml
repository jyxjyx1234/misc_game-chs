<?xml version="1.0" encoding="utf-8"?><xscript><debug editor="&quot;C:\Program&#32;Files&#32;(x86)\sakura\sakura.exe&quot;&#32;&quot;%src%&quot;&#32;-Y=%line%"   src="D:\シロップ\町ぐるみの罠＋汚された夏セット版\汚された夏\完成データ\汚された夏\script\text\root_inaba_c_ev02.txt"/><code><label @l="13" id="EventLabel_99"/><label @l="16" id="event_scene39"/><bgm @l="20" src="bgm13" volume="1."/><msg @l="23" char_id="-1" frame_id="-1" name="" text="男人们一齐压在了我的身上。"   voices=""/><msg @l="24" char_id="-1" frame_id="-1" name=""   text="他们抓住我被撕破衣服而裸露出来的乳房，揉捏着，将嘴唇贴上乳头吮吸起来。" voices=""/><msg @l="25" char_id="-1" frame_id="-1" name=""   text="就这样……其中一个男人把脸凑近刚刚才被贯穿的我的秘部，开始舔舐大腿和秘部上凝固的血迹，仿佛要将它们全部舔净。"   voices=""/><msg @l="27" char_id="0" frame_id="-1" name="美帆"   text="『啊啊啊……不要，请住手！』" voices="miho04950"/><msg @l="29" char_id="-1" frame_id="-1" name=""   text="我拖着残破不堪的身体，拼命想从他们的手中逃脱。" voices=""/><msg @l="30" char_id="-1" frame_id="-1" name=""   text="但他们对我的这种抵抗完全不以为意，按住我的手脚使我无法动弹……毫不在意地开始舔遍我的全身。"   voices=""/><msg @l="32" char_id="-1" frame_id="-1" name="熊野" text="『好好地射进去啊。』"   voices=""/><msg @l="34" char_id="-1" frame_id="-1" name=""   text="熊野这么一说，那个舔着秘部的男人就把已经变硬的怒张前端抵在了我的身上。" voices=""/><label @l="38" id="chart_line61"/><wait_chgmv/><ev @l="42" src="ev-039y1"/><description @l="45" text="网球社团大轮奸"/><msg @l="47" char_id="0" frame_id="-1" name="美帆" text="『呀……啊，啊啊啊！』"   voices="miho04960"/><msg @l="49" char_id="-1" frame_id="-1" name=""   text="男人的前端撑开了我的缝隙，侵入了我的体内。" voices=""/><msg @l="50" char_id="-1" frame_id="-1" name=""   text="龟头摩擦着刚刚才被侵犯过的伤口，疼痛传遍全身。" voices=""/><msg @l="52" char_id="0" frame_id="-1" name="美帆"   text="『呃啊…啊…不要，啊，呃啊！』" voices="miho04970"/><msg @l="54" char_id="-1" frame_id="-1" name="男会员A"   text="『哈，哈，哈…哦，哦哦哦…』" voices=""/><msg @l="56" char_id="-1" frame_id="-1" name=""   text="与我发出痛苦呻吟相反…正在贯穿我密穴的那个男子会员，像野兽一样吼叫着，带着陶醉的表情拼命地摆动腰部。"   voices=""/><msg @l="57" char_id="-1" frame_id="-1" name=""   text="每当他这样做，先前注入的学长精液和从我腿间流出的血混合成的粉红色液体就会从我们结合处渗出。"   voices=""/><msg @l="59" char_id="0" frame_id="-1" name="美帆"   text="『嗯，啊啊…呀，呃…住手…嗯！』" voices="miho04980"/><msg @l="61" char_id="-1" frame_id="-1" name=""   text="除了破身的伤口被摩擦的疼痛外，还有未经润滑的秘部敏感处被顶弄，我在痛苦中身体抽搐着扭动。"   voices=""/><msg @l="63" char_id="-1" frame_id="-1" name="男会员B" text="『呵呵呵…』"   voices=""/><msg @l="65" char_id="-1" frame_id="-1" name="男会员C" text="『嘻嘻嘻嘻嘻…』"   voices=""/><msg @l="67" char_id="-1" frame_id="-1" name="" text="我突然注意到视野角落有什么东西在动。"   voices=""/><msg @l="68" char_id="-1" frame_id="-1" name=""   text="好奇地望去，那些男性会员们正一脸茫然地套弄着自己的那话儿。" voices=""/><msg @l="70" char_id="0" frame_id="-1" name="美帆" text="『……。』"   voices="miho04990"/><msg @l="72" char_id="-1" frame_id="-1" name=""   text="我被这情景震撼，一时间只能呆呆地注视着。" voices=""/><msg @l="73" char_id="-1" frame_id="-1" name=""   text="他们熟练地握紧自己的肉块，时而改变摩擦速度，时而调整握法，不断地撸动着坚硬挺立的肉棒。"   voices=""/><msg @l="74" char_id="-1" frame_id="-1" name=""   text="而且……他们的目光全都一致地盯向我的私处。" voices=""/><msg @l="76" char_id="0" frame_id="-1" name="美帆"   text="(他们都在看着我的那里想象着……)" voices="miho05000"/><msg @l="78" char_id="0" frame_id="-1" name="美帆"   text="(他们在想象着插入我的那里……做爱的场景)" voices="miho05010"/><msg @l="80" char_id="-1" frame_id="-1" name=""   text="这样的念头涌上心头，我顿时感到无比悲凉。" voices=""/><msg @l="81" char_id="-1" frame_id="-1" name=""   text="他们大概只是被熊野利用了而已……。" voices=""/><msg @l="83" char_id="0" frame_id="-1" name="美帆"   text="『嗯，嗯嗯……啊……嗯咕，咿，啊啊啊！！』" voices="miho05020"/><msg @l="85" char_id="-1" frame_id="-1" name=""   text="我的私处被猛烈地顶撞着，肌肤与肌肤激烈地碰撞在一起。" voices=""/><msg @l="86" char_id="-1" frame_id="-1" name=""   text="我忍受着每次撞击带来的疼痛，同时感觉到除此之外，身体深处还涌现出一种奇妙的感觉。" voices=""/><msg @l="88" char_id="-1" frame_id="-1" name="男会员A" text="『…………。』"   voices=""/><msg @l="90" char_id="-1" frame_id="-1" name=""   text="在我体内摩擦的他，突然抬起我的一条腿，改变了顶撞的位置。" voices=""/><msg @l="91" char_id="-1" frame_id="-1" name=""   text="那一瞬间……一股炙热的麻痹感沿着我的背脊窜过。" voices=""/><msg @l="93" char_id="0" frame_id="-1" name="美帆" text="『啊啊……嗯，嗯咕！？』"   voices="miho05030"/><msg @l="95" char_id="-1" frame_id="-1" name=""   text="随着顶撞位置的改变，每一次撞击都让那种麻痹感逐渐扩大蔓延。" voices=""/><msg @l="97" char_id="-1" frame_id="-1" name="熊野"   text="『啊，我还忘了说一件事。』" voices=""/><msg @l="99" char_id="-1" frame_id="-1" name="熊野"   text="『这些家伙的唾液和前液等体液中也含有媚药成分。』" voices=""/><msg @l="101" char_id="0" frame_id="-1" name="美帆" text="『什…？』"   voices="miho05040"/><msg @l="103" char_id="-1" frame_id="-1" name="熊野"   text="『也就是说，媚药效果差不多要开始发挥作用了。』" voices=""/><msg @l="105" char_id="-1" frame_id="-1" name=""   text="或许是注意到我发出的声音中开始带有一丝热意，熊野这样说着，愉快地笑了起来。" voices=""/><msg @l="106" char_id="-1" frame_id="-1" name="" text="媚药效果…" voices=""/><msg @l="107" char_id="-1" frame_id="-1" name=""   text="我也会变得像眼前这些男人一样…吗？" voices=""/><msg @l="109" char_id="0" frame_id="-1" name="美帆" text="『不，不要…住手，啊啊啊！！』"   voices="miho05050"/><msg @l="111" char_id="-1" frame_id="-1" name=""   text="我慌忙地试图将插入体内的肉棒拔出来。" voices=""/><msg @l="112" char_id="-1" frame_id="-1" name=""   text="但是…每次被撞击腰部时，传遍全身的麻痹感让我犹豫着无法将它拔出。" voices=""/><msg @l="114" char_id="0" frame_id="-1" name="美帆" text="『啊，啊啊啊啊！？』"   voices="miho05060"/><msg @l="116" char_id="-1" frame_id="-1" name="熊野"   text="『看来你察觉得有点晚啊。』" voices=""/><msg @l="118" char_id="-1" frame_id="-1" name="" text="正如他所说的，已经……太晚了。"   voices=""/><msg @l="119" char_id="-1" frame_id="-1" name=""   text="我几乎要被下半身产生的甜美热感吞噬了。" voices=""/><msg @l="120" char_id="-1" frame_id="-1" name=""   text="不知何时疼痛消失了，取而代之的是足以让视野闪烁的强烈快感，一波波扩散又消失。" voices=""/><msg @l="122" char_id="0" frame_id="-1" name="美帆"   text="『嗯嗯……啊……啊啊……嗯，啊呜！』" voices="miho05070"/><msg @l="124" char_id="-1" frame_id="-1" name=""   text="每当那滚烫勃起的肉棒噗嗤噗嗤地贯穿我的秘处时，我都会颤抖着腰肢接受它。" voices=""/><msg @l="125" char_id="-1" frame_id="-1" name=""   text="从身体深处自然涌出大量蜜液……发出淫靡的水声。" voices=""/><msg @l="127" char_id="-1" frame_id="-1" name="男会员B" text="『哈，哈，哈……』"   voices=""/><msg @l="129" char_id="-1" frame_id="-1" name="男会员C" text="『呼……唔……』"   voices=""/><msg @l="131" char_id="-1" frame_id="-1" name=""   text="周围的男部员们一边注视着泛白起泡的交合处，一边加快了撸动自己那话儿的速度。" voices=""/><msg @l="133" char_id="0" frame_id="-1" name="美帆"   text="『啊，啊啊……不行，这种……啊，啊，啊啊啊！』" voices="miho05080"/><msg @l="135" char_id="0" frame_id="-1" name="美帆"   text="『嗯唔……啊啊，要去了……去了，去去去去去……。』" voices="miho05090"/><msg @l="137" char_id="-1" frame_id="-1" name="男会员A" text="『啊，啊啊……。』"   voices=""/><msg @l="139" char_id="-1" frame_id="-1" name="男会员B" text="『呃啊啊！！』"   voices=""/><msg @l="141" char_id="-1" frame_id="-1" name="男会员C" text="『啊啊！！』"   voices=""/><flash @l="145" count="4" fade="100" image="white"/><wait_chgmv/><ev @l="149" src="ev-039x1y1z1"/><msg @l="151" char_id="0" frame_id="-1" name="美帆" text="『嗯嗯嗯！！！』"   voices="miho05100"/><msg @l="153" char_id="-1" frame_id="-1" name=""   text="大量精液……洒落在我的阴道内和全身各处。" voices=""/><msg @l="154" char_id="-1" frame_id="-1" name=""   text="那乳白色的欲望之露无论是脸，胸，还是腹部，都把我的全身染成了一片白色黏腻的模样。" voices=""/><msg @l="156" char_id="0" frame_id="-1" name="美帆" text="『嗯呼……嗯……。』"   voices="miho05110"/><msg @l="158" char_id="-1" frame_id="-1" name=""   text="我全身被那些炙热又青涩的液体弄脏了，却仍在高潮的愉悦中颤抖着身体，发出炙热的喘息。" voices=""/><msg @l="159" char_id="-1" frame_id="-1" name="" text="但是，这还没有结束。"   voices=""/><msg @l="160" char_id="-1" frame_id="-1" name=""   text="精液顺着皮肤流淌……同时，注入体内深处的精液在我全身点燃了更剧烈的热度，再次将我拖入甜美快感的深渊中。" voices=""/><msg @l="162" char_id="0" frame_id="-1" name="美帆" text="『嗯嗯……。』"   voices="miho05120"/><msg @l="164" char_id="-1" frame_id="-1" name=""   text="就这样，我……缓缓接纳了下一根阴茎。" voices=""/><clear @l="170" class="all"/><wait_chgmv/><bg @l="173" src="bg14b"/><msg @l="175" char_id="0" frame_id="-1" name="美帆" text="『啊，啊啊……嗯呼呜……。』"   voices="miho05130"/><msg @l="177" char_id="-1" frame_id="-1" name="" text="美帆甜美的呻吟回荡在部室之中。"   voices=""/><msg @l="178" char_id="-1" frame_id="-1" name=""   text="如今……她心中已不再有任何抵抗或厌恶之情。" voices=""/><msg @l="179" char_id="-1" frame_id="-1" name=""   text="沉醉于肉体带来的快美……然后堕落———。" voices=""/><msg @l="180" char_id="-1" frame_id="-1" name="" text="这就是她的归宿———。"   voices=""/><stopbgm @l="184" fadeout="1000"/><clear @l="190" class="all"/><wait @l="192" time="2000"/><end_scene @l="195"/><return @l="198" value=""/><return @l="202" value=""/></code></xscript>																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																									