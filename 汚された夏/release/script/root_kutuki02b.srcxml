<?xml version="1.0" encoding="utf-8"?><xscript><debug editor="&quot;C:\Program&#32;Files&#32;(x86)\sakura\sakura.exe&quot;&#32;&quot;%src%&quot;&#32;-Y=%line%"   src="D:\シロップ\町ぐるみの罠＋汚された夏セット版\汚された夏\完成データ\汚された夏\script\text\root_kutuki02b.txt"/><code><label @l="13" id="EventLabel_112"/><description @l="17" text="拒绝契约的结果"/><eval @l="19" expr="f.numDay=5&#13;&#10;"/><msgshow @l="21" show="false"/><wait_chgmv/><bg @l="23" src="day05" time="2000"/><wait @l="25" time="500"/><wait_chgmv/><bg @l="27" src="black" time="2000"/><msgshow @l="29" show="true"/><wait_chgmv/><bg @l="32" src="bg09"/><char @l="34" id="miho" pos="auto" src="miho115"/><msg @l="36" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="38" char_id="-1" frame_id="-1" name=""   text="第二天午休时分……我来到了朽木教授的办公室前。" voices=""/><msg @l="39" char_id="-1" frame_id="-1" name=""   text="目的当然是为了洗清父亲的冤屈。" voices=""/><se @l="42" buf="1" src="ノック" volume="1."/><msg @l="44" char_id="0" frame_id="-1" name="美帆" text="『……打扰了。』" voices=""/><bgm @l="47" src="bgm03" volume="1."/><wait_chgmv/><bg @l="50" src="bg12"/><char @l="52" id="miho" pos="auto" src="miho015"/><msg @l="54" char_id="0" frame_id="-1" name="美帆" text="『教授，今天我是有事来找您。』"   voices=""/><clear @l="57" class="char"/><char @l="59" id="miho" pos="right" src="miho015"/><char @l="61" id="kutsu" pos="left" src="kutsu010"/><msg @l="63" char_id="-1" frame_id="-1" name="朽木" text="『啊，是你啊……比我预想的来得早啊。』"   voices=""/><msg @l="65" char_id="-1" frame_id="-1" name="朽木"   text="『我原以为要等事情再发展一段时间你才会来呢。』" voices=""/><char @l="68" id="miho" pos="right" src="miho115"/><msg @l="70" char_id="0" frame_id="-1" name="美帆"   text="『果然……父亲的挪用公款嫌疑，是教授您一手策划的吧。』" voices=""/><msg @l="72" char_id="-1" frame_id="-1" name="朽木" text="『说成是我策划的未免有失偏颇。』"   voices=""/><msg @l="74" char_id="-1" frame_id="-1" name="朽木"   text="『我只是帮他把罪行昭告天下罢了。』" voices=""/><msg @l="76" char_id="0" frame_id="-1" name="美帆"   text="『胡说！父亲不可能会挪用公款！』" voices=""/><char @l="79" id="kutsu" pos="left" src="kutsu018"/><msg @l="81" char_id="-1" frame_id="-1" name="朽木"   text="『没错，他本人是个非常诚实清廉的人。』" voices=""/><msg @l="83" char_id="-1" frame_id="-1" name="朽木"   text="『想必他绝不会主动考虑挪用公司的钱吧。』" voices=""/><char @l="86" id="miho" pos="right" src="miho114"/><msg @l="88" char_id="0" frame_id="-1" name="美帆" text="『您……认识我父亲吗……？』"   voices=""/><msg @l="90" char_id="-1" frame_id="-1" name="朽木"   text="『嗯。在他工作的大黑制药我有一个朋友。』" voices=""/><char @l="93" id="miho" pos="right" src="miho015"/><msg @l="95" char_id="0" frame_id="-1" name="美帆"   text="『那为什么还要给父亲扣这种不白之冤！』" voices=""/><char @l="98" id="kutsu" pos="left" src="kutsu010"/><msg @l="100" char_id="-1" frame_id="-1" name="朽木"   text="『我不是说了吗，我只是让他的罪行大白于天下而已。』" voices=""/><msg @l="102" char_id="-1" frame_id="-1" name="朽木"   text="『他啊，把直属下属一个人五年来持续进行的挪用公款行为全部扛在了自己身上。』" voices=""/><char @l="105" id="miho" pos="right" src="miho014"/><msg @l="107" char_id="0" frame_id="-1" name="美帆" text="『啊……』" voices=""/><char @l="110" id="kutsu" pos="left" src="kutsu018"/><msg @l="112" char_id="-1" frame_id="-1" name="朽木"   text="『他是个非常诚实的男人。但这次似乎反而害了他。』" voices=""/><msg @l="114" char_id="-1" frame_id="-1" name="朽木"   text="『我并不是向警方泄露信息，而是亲自告诉了他关于部下挪用公款的事情。』" voices=""/><msg @l="116" char_id="0" frame_id="-1" name="美帆" text="『那是……什么意思？』"   voices=""/><msg @l="118" char_id="-1" frame_id="-1" name="朽木"   text="『部下的责任就是上司的责任，他是这么说的。没能发现挪用公款是他自己的过错。』" voices=""/><char @l="121" id="miho" pos="right" src="miho015"/><msg @l="123" char_id="0" frame_id="-1" name="美帆"   text="『可是……父亲没必要一个人背负所有罪责啊！』" voices=""/><char @l="126" id="kutsu" pos="left" src="kutsu010"/><msg @l="128" char_id="-1" frame_id="-1" name="朽木"   text="『嗯，这就不是我能干涉的事情了。』" voices=""/><msg @l="130" char_id="0" frame_id="-1" name="美帆"   text="『请您帮父亲洗清冤屈……只要这样的话，这次我一定会听从教授的一切要求！』" voices=""/><char @l="133" id="kutsu" pos="left" src="kutsu014"/><msg @l="135" char_id="-1" frame_id="-1" name="朽木" text="『别撒娇！』"   voices=""/><char @l="138" id="miho" pos="right" src="miho115"/><msg @l="140" char_id="0" frame_id="-1" name="美帆" text="『啊！？』" voices=""/><char @l="143" id="kutsu" pos="left" src="kutsu010"/><msg @l="145" char_id="-1" frame_id="-1" name="朽木"   text="『你已经一次因为自己的私事违约了，不是吗？』" voices=""/><msg @l="147" char_id="-1" frame_id="-1" name="朽木"   text="『难道你不认为，为了自己的私事再要求重新签订契约是极其荒谬的吗！？』" voices=""/><msg @l="149" char_id="0" frame_id="-1" name="美帆" text="『怎么会……我……。』"   voices=""/><msg @l="151" char_id="-1" frame_id="-1" name="朽木"   text="『而且，很遗憾，既然警方已经介入，就算是我也无法让一切回到原点。』" voices=""/><char @l="154" id="kutsu" pos="left" src="kutsu018"/><msg @l="156" char_id="-1" frame_id="-1" name="朽木"   text="『即使明确证实仲根启三先生是在包庇部下的挪用行为，公司恐怕还是必须解雇他。』"   voices=""/><char @l="159" id="miho" pos="right" src="miho015"/><msg @l="161" char_id="0" frame_id="-1" name="美帆"   text="『这、这怎么可能……那样的话……。』" voices=""/><msg @l="163" char_id="-1" frame_id="-1" name="朽木"   text="『最好的结果是失业，最坏的结果则是留下前科。』" voices=""/><char @l="166" id="miho" pos="right" src="miho115"/><msg @l="168" char_id="0" frame_id="-1" name="美帆" text="『呜……太过分了……。』"   voices=""/><char @l="171" id="kutsu" pos="left" src="kutsu010"/><msg @l="173" char_id="-1" frame_id="-1" name="朽木"   text="『过分？别让我发笑。』" voices=""/><msg @l="175" char_id="-1" frame_id="-1" name="朽木"   text="『这一切，全都是你的错不是吗！』" voices=""/><msg @l="177" char_id="0" frame_id="-1" name="美帆" text="『呜……呜呜……。』"   voices=""/><msg @l="179" char_id="-1" frame_id="-1" name="朽木"   text="『我认为这不是哭就能解决的问题，不是吗？』" voices=""/><msg @l="181" char_id="0" frame_id="-1" name="美帆"   text="『那、那我该怎么办……我，该怎么办才好啊。』" voices=""/><msg @l="183" char_id="0" frame_id="-1" name="美帆"   text="『怎样才能救父亲……救家人……呜呜……。』" voices=""/><clear @l="186" layer="miho"/><msg @l="188" char_id="-1" frame_id="-1" name=""   text="我不由自主地瘫坐在地上哭泣起来。" voices=""/><msg @l="189" char_id="-1" frame_id="-1" name="" text="已经……不知道该怎么办才好了。"   voices=""/><msg @l="191" char_id="-1" frame_id="-1" name="朽木" text="『………。』" voices=""/><msg @l="193" char_id="-1" frame_id="-1" name="朽木" text="『……抬起头来。』"   voices=""/><char @l="196" id="miho" pos="right" src="miho015"/><msg @l="198" char_id="0" frame_id="-1" name="美帆" text="『呜……呜呜……。』"   voices=""/><char @l="201" id="kutsu" pos="left" src="kutsu018"/><bgm @l="204" src="bgm15" volume="1."/><msg @l="206" char_id="-1" frame_id="-1" name="朽木"   text="『如果你真的那么想救你的家人，那我不妨帮你一把。』" voices=""/><char @l="209" id="miho" pos="right" src="miho114"/><msg @l="211" char_id="0" frame_id="-1" name="美帆" text="『诶……真、真的吗！？』"   voices=""/><msg @l="213" char_id="-1" frame_id="-1" name="朽木"   text="『嗯。关于你父亲，我可以在证明他是被冤枉的这方面提供帮助……但遗憾的是，对于失业一事我也无能为力。』"   voices=""/><msg @l="215" char_id="-1" frame_id="-1" name="朽木"   text="『为他准备的位置，已经给了其他人。』" voices=""/><char @l="217" id="miho" pos="right" src="miho015"/><msg @l="219" char_id="0" frame_id="-1" name="美帆" text="『…………。』" voices=""/><msg @l="221" char_id="-1" frame_id="-1" name="朽木"   text="『不过，我可以解决你家庭的经济问题。』" voices=""/><char @l="224" id="miho" pos="right" src="miho115"/><msg @l="226" char_id="0" frame_id="-1" name="美帆" text="『怎么……做呢？』"   voices=""/><char @l="229" id="kutsu" pos="left" src="kutsu010"/><msg @l="231" char_id="-1" frame_id="-1" name="朽木"   text="『你来工作就好。我可以给你介绍一份能一边上大学一边工作的工作。』" voices=""/><msg @l="233" char_id="-1" frame_id="-1" name="朽木"   text="『这样你就能自己承担所有的学费。你可以告诉家人获得了奖学金，他们就不会担心了吧？』" voices=""/><msg @l="235" char_id="-1" frame_id="-1" name="" text="说着，教授露出了一抹奸笑。"   voices=""/><msg @l="236" char_id="-1" frame_id="-1" name=""   text="那时，我因为自责自己的微小行为毁了家人的幸福，内心充满了罪恶感，以至于什么都看不清了。"   voices=""/><msg @l="237" char_id="-1" frame_id="-1" name="" text="这大概可以称为自暴自弃吧。"   voices=""/><msg @l="238" char_id="-1" frame_id="-1" name="" text="所以，我没能察觉到。"   voices=""/><msg @l="239" char_id="-1" frame_id="-1" name=""   text="在他的笑容背后……潜藏着邪恶的东西。" voices=""/><msg @l="240" char_id="-1" frame_id="-1" name="" text="然后……。" voices=""/><char @l="243" id="miho" pos="right" src="miho015"/><msg @l="245" char_id="0" frame_id="-1" name="美帆" text="『好的……拜托您了。』"   voices=""/><msg @l="247" char_id="-1" frame_id="-1" name="" text="我缓缓地，对他的话语点了点头。"   voices=""/><clear @l="253" class="all"/><msgshow @l="255" show="true"/><call @l="259" target="EventLabel_46@ending08"/><return @l="260" value="0&#13;&#10;"/><return @l="264" value=""/></code></xscript>																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																			