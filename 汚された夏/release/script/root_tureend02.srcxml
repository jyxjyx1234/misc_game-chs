<?xml version="1.0" encoding="utf-8"?><xscript><debug editor="&quot;C:\Program&#32;Files&#32;(x86)\sakura\sakura.exe&quot;&#32;&quot;%src%&quot;&#32;-Y=%line%"   src="D:\シロップ\町ぐるみの罠＋汚された夏セット版\汚された夏\完成データ\汚された夏\script\text\root_tureend02.txt"/><code><label @l="13" id="EventLabel_149"/><eval @l="16" expr="f.numDay=0&#13;&#10;"/><msg @l="18" char_id="-1" frame_id="-1" name="" text="…………………………………………。"   voices=""/><msg @l="19" char_id="-1" frame_id="-1" name="" text="………………………………。"   voices=""/><msg @l="20" char_id="-1" frame_id="-1" name="" text="……………………。" voices=""/><msg @l="21" char_id="-1" frame_id="-1" name="" page_feed="true"   text="…………。" voices=""/><bgm @l="26" src="bgm19" volume="1."/><page @l="29" fade="300"/><wait_chgmv/><bg @l="32" src="bg15a"/><char @l="34" id="shiny" pos="auto" src="shinya010"/><description @l="37" text="？？？"/><eval @l="39" expr="f.numDay=0&#13;&#10;"/><msg @l="41" char_id="-1" frame_id="-1" name="" text=":『终于行动了吗……。』"   voices=""/><msg @l="43" char_id="-1" frame_id="-1" name=""   text=":\n:在被黄昏染上颜色的校园一角，浅间真弥静静地低语道。" voices=""/><msg @l="44" char_id="-1" frame_id="-1" name="" text="视线的前方是网球场—————。"   voices=""/><msg @l="45" char_id="-1" frame_id="-1" name=""   text="真弥望着球场微微眯起眼睛，然后………嘴角扭曲了一下。" voices=""/><msg @l="47" char_id="-1" frame_id="-1" name="" text=":『这样一来……就能有个了断了………。』"   voices=""/><msg @l="49" char_id="-1" frame_id="-1" name="" page_feed="true"   text=": :真弥慢慢地开始走动。" voices=""/><clear @l="52" class="all"/><page @l="55" fade="300"/><wait_chgmv/><ev @l="58" src="ev-058"/><msg @l="60" char_id="-1" frame_id="-1" name="" text="『……。』" voices=""/><msg @l="62" char_id="-1" frame_id="-1" name=""   text=":在有轨电车站附近……奈那子正等着美帆。" voices=""/><msg @l="63" char_id="-1" frame_id="-1" name=""   text="她的哥哥真弥曾再三叮嘱她不要与特定人建立亲密关系。" voices=""/><msg @l="64" char_id="-1" frame_id="-1" name=""   text="但是……奈那子无法将美帆视为其他芸芸众生中的一员。" voices=""/><msg @l="65" char_id="-1" frame_id="-1" name=""   text="为什么会对美帆抱有特别的感情，连奈那子自己也说不清楚。" voices=""/><msg @l="66" char_id="-1" frame_id="-1" name=""   text="只是，奈那子主动“想成为朋友”的人，美帆是第一个。" voices=""/><msg @l="67" char_id="-1" frame_id="-1" name=""   text="同样，答应了这个请求的也是美帆，这也是第一次。" voices=""/><msg @l="68" char_id="-1" frame_id="-1" name="" page_feed="true"   text=":奈那子非常喜欢美帆。" voices=""/><clear @l="71" class="all"/><page @l="73" fade="300"/><msg @l="75" char_id="-1" frame_id="-1" name="" page_feed="true"   text="回想起与真弥的对话─────。" voices=""/><clear @l="78" class="all"/><page @l="80" fade="300"/><msg @l="82" char_id="-1" frame_id="-1" name="" text="《奈那子……》" voices=""/><msg @l="84" char_id="-1" frame_id="-1" name="" text=":《…………》" voices=""/><msg @l="86" char_id="-1" frame_id="-1" name=""   text=":《我现在要去做个了断。………这里很危险，你待在安全的地方》" voices=""/><msg @l="88" char_id="-1" frame_id="-1" name="" text=":《危险……？》" voices=""/><msg @l="90" char_id="-1" frame_id="-1" name="" text=":《刚才，我找到了目标中的一人》"   voices=""/><msg @l="92" char_id="-1" frame_id="-1" name=""   text="《这个镇子已经………变成无法挽回的状况了……》" voices=""/><msg @l="94" char_id="-1" frame_id="-1" name="" text=":《美帆………被盯上了吗？》"   voices=""/><msg @l="96" char_id="-1" frame_id="-1" name="" text=":《…………》" voices=""/><msg @l="98" char_id="-1" frame_id="-1" name="" text=":《是这样啊……》"   voices=""/><msg @l="100" char_id="-1" frame_id="-1" name="" text="《拜托，救救美帆……哥哥》"   voices="nanako00260"/><msg @l="102" char_id="-1" frame_id="-1" name=""   text=":《奈那子，我追他们并不是为了助人为乐……》" voices=""/><msg @l="104" char_id="-1" frame_id="-1" name="" text=":\n:《哥哥……拜托了》"   voices=""/><msg @l="106" char_id="-1" frame_id="-1" name="" text=":《……》" voices=""/><msg @l="108" char_id="-1" frame_id="-1" name="" text="《有条小路……在大学后面的山丘上》"   voices=""/><msg @l="110" char_id="-1" frame_id="-1" name=""   text="《沿着那条路应该能逃出这个镇子》" voices=""/><msg @l="112" char_id="-1" frame_id="-1" name="" text="《你带着那个女孩先到那条小路去……》"   voices=""/><msg @l="114" char_id="-1" frame_id="-1" name="" text=":《哥哥……谢谢》"   voices=""/><msg @l="116" char_id="-1" frame_id="-1" name=""   text=":《这是我最后一次干涉别人的事，明白吗？》" voices=""/><msg @l="118" char_id="-1" frame_id="-1" name="" page_feed="true"   text=":《嗯……》" voices=""/><clear @l="121" class="all"/><page @l="123" fade="300"/><wait_chgmv/><ev @l="126" src="ev-058"/><msg @l="128" char_id="-1" frame_id="-1" name=""   text=":────哥哥说他会去救美帆……" voices=""/><msg @l="129" char_id="-1" frame_id="-1" name="" text="……虽然也担心哥哥………。"   voices=""/><msg @l="130" char_id="-1" frame_id="-1" name=""   text="……现在，必须带美帆去小路了。" voices=""/><msg @l="132" char_id="-1" frame_id="-1" name="" text=":\n:《…………。》"   voices=""/><msg @l="134" char_id="-1" frame_id="-1" name="" text=":《美帆……。》" voices=""/><msg @l="136" char_id="-1" frame_id="-1" name=""   text=":奈那子察觉到逐渐靠近的美帆的气息，低声呢喃道。" voices=""/><msg @l="137" char_id="-1" frame_id="-1" name="" page_feed="true"   text="然后……她如同祈祷般低垂着眼眸，等待着她的到来。" voices=""/><clear @l="140" class="all"/><page @l="142" fade="300"/><wait_chgmv/><bg @l="145" src="bg15a"/><se @l="148" buf="3" loop="true" src="心臓" volume="1."/><msg @l="150" char_id="-1" frame_id="-1" name="" text="──咚" voices=""/><msg @l="151" char_id="-1" frame_id="-1" name="" text="咚咚咚" voices=""/><msg @l="152" char_id="-1" frame_id="-1" name="" text="咚咚咚咚咚" voices=""/><msg @l="153" char_id="-1" frame_id="-1" name="" page_feed="true"   text="咚！" voices=""/><stopse @l="156" buf="3"/><page @l="159" fade="300"/><msg @l="161" char_id="-1" frame_id="-1" name="" text="『………哈……哈…………。』"   voices=""/><msg @l="163" char_id="-1" frame_id="-1" name=""   text=":不由自主地在体内横冲直撞的暴力快感，正在逐渐平息。" voices=""/><msg @l="164" char_id="-1" frame_id="-1" name=""   text="奈那子一边抑制着略显兴奋的感觉，一边重复着粗重的呼吸站了起来。" voices=""/><char @l="167" id="nanak" pos="auto" src="nanako015"/><msg @l="169" char_id="-1" frame_id="-1" name=""   text="被熊野射入的药剂夺走自由，究竟过了多长时间呢……。" voices=""/><msg @l="170" char_id="-1" frame_id="-1" name=""   text="虽然不太清楚，但熊野注射的药剂效果似乎已经消退了……。" voices=""/><msg @l="172" char_id="-1" frame_id="-1" name="" text="头脑也逐渐变得清醒起来。"   voices=""/><msg @l="173" char_id="-1" frame_id="-1" name="" text="担心美帆的安危，她环顾四周寻找着。"   voices=""/><msg @l="175" char_id="-1" frame_id="-1" name=""   text=":『美帆……。你成功逃脱了吗………。』" voices=""/><msg @l="177" char_id="-1" frame_id="-1" name="" page_feed="true"   text=":美帆现在怎么样了呢。" voices=""/><page @l="180" fade="300"/><msg @l="182" char_id="-1" frame_id="-1" name="" text="………。" voices=""/><msg @l="183" char_id="-1" frame_id="-1" name="" text=":………哥哥……、美帆………。"   voices=""/><clear @l="186" class="char"/><msg @l="188" char_id="-1" frame_id="-1" name=""   text=":奈那子注视着落入环绕南总町的群山山脊的太阳，像是下定了某种决心开始向前走去。" voices=""/><msg @l="189" char_id="-1" frame_id="-1" name="" page_feed="true"   text=":\n:\n:她露出了对奈那子来说相当罕见的………严峻表情———。" voices=""/><stopbgm @l="192" fadeout="1000"/><clear @l="195" class="all"/><page @l="197" fade="300"/><wait_chgmv/><bg @l="200" src="bg22_3"/><char @l="202" id="shiny" pos="left" src="shinya010"/><char @l="204" id="kuma" pos="right" src="kuma018"/><bgm @l="207" src="bgm21" volume="1."/><msg @l="209" char_id="-1" frame_id="-1" name=""   text="在废弃道路的出口处……浅间真弥和熊野兵吉正在对峙。" voices=""/><msg @l="210" char_id="-1" frame_id="-1" name=""   text="真弥一如往常板着脸，挡在废弃道路出口的中央。" voices=""/><msg @l="211" char_id="-1" frame_id="-1" name=""   text="熊野恶狠狠地瞪着真弥，向他发泄着自己的烦躁。" voices=""/><msg @l="213" char_id="-1" frame_id="-1" name=""   text=":『旧大黑制药研究所通道……没想到这条通道竟然能够使用……难怪警察一直找不到。』" voices=""/><msg @l="215" char_id="-1" frame_id="-1" name=""   text=":『你居然知道这个地方，你到底是什么人。』" voices=""/><msg @l="217" char_id="-1" frame_id="-1" name="" text=":『…………。』" voices=""/><msg @l="219" char_id="-1" frame_id="-1" name=""   text=":『给我让开………那个女人要逃掉了！』" voices=""/><msg @l="221" char_id="-1" frame_id="-1" name="" text=":『…………。』" voices=""/><msg @l="223" char_id="-1" frame_id="-1" name="" text=":真弥没有回应熊野的话。"   voices=""/><msg @l="225" char_id="-1" frame_id="-1" name=""   text=":『刚才那个小丫头也好，你这家伙也好，尽给我添麻烦。看来突然成了我的厄运日啊！该死！』"   voices=""/><char @l="228" id="shiny" pos="left" src="shinya017"/><msg @l="230" char_id="-1" frame_id="-1" name=""   text=":『啊……确实对你来说是厄运日……。毕竟你遇到了我……。』" voices=""/><msg @l="232" char_id="-1" frame_id="-1" name=""   text=":『你这混蛋！别开玩笑了！！』" voices=""/><msg @l="234" char_id="-1" frame_id="-1" name=""   text=":熊野一边喊叫，一边摆出要扑向真弥的架势。" voices=""/><msg @l="236" char_id="-1" frame_id="-1" name="" page_feed="true"   text=":\n:――就在那一瞬间。" voices=""/><stopbgm @l="239" fadeout="1000"/><page @l="242" fade="300"/><clear @l="244" class="char"/><char @l="246" id="shiny" pos="center" src="shinya017f" y="-80"/><wait @l="248" time="1000"/><se @l="250" buf="1" src="心臓" volume="1."/><char @l="252" id="shiny" pos="center" src="shinya018f" y="-80"/><msg @l="254" char_id="-1" frame_id="-1" name="" text="真弥的双眸染成了猩红色。"   voices=""/><msg @l="255" char_id="-1" frame_id="-1" name=""   text="注意到这变化的熊野惊讶得停下了动作。" voices=""/><bgm @l="258" src="bgm21" volume="1."/><clear @l="261" class="char"/><char @l="263" id="kuma" pos="auto" src="kuma018"/><msg @l="265" char_id="-1" frame_id="-1" name=""   text=":『什！！你这家伙……难道……。』" voices=""/><clear @l="268" class="char"/><char @l="270" id="shiny" pos="left" src="shinya018"/><char @l="272" id="kuma" pos="right" src="kuma018"/><msg @l="274" char_id="-1" frame_id="-1" name="" text=":『既然知道的话，那就简单了……。』"   voices=""/><msg @l="276" char_id="-1" frame_id="-1" name=""   text=":真弥说完这句话，浑身上下散发出杀气。" voices=""/><msg @l="278" char_id="-1" frame_id="-1" name=""   text=":『等，等等！！为什么？！有了那药不就能掌控一切了吗？』" voices=""/><msg @l="280" char_id="-1" frame_id="-1" name="" text=":『……。』" voices=""/><msg @l="282" char_id="-1" frame_id="-1" name=""   text=":『你不也在服用吗？既然如此，你不可能不明白它的好处吧！？』" voices=""/><msg @l="284" char_id="-1" frame_id="-1" name="" text=":『……。』" voices=""/><msg @l="286" char_id="-1" frame_id="-1" name=""   text=":与激动的熊野形成鲜明对比，真弥的表情毫无变化。" voices=""/><msg @l="288" char_id="-1" frame_id="-1" name=""   text=":『我们是特殊的存在，操控那些平凡的人类有什么错！』" voices=""/><msg @l="290" char_id="-1" frame_id="-1" name=""   text=":『…………你想说的……就只有这些吗……。』" voices=""/><msg @l="292" char_id="-1" frame_id="-1" name=""   text=":听完熊野的话后，真弥平静地说道。" voices=""/><msg @l="294" char_id="-1" frame_id="-1" name=""   text=":『那药物的痕迹——我会全部抹除，这就是我的复仇。』" voices=""/><msg @l="296" char_id="-1" frame_id="-1" name="" page_feed="true"   text=":『啧！那就让我反击一下吧！』" voices=""/><clear @l="299" class="all"/><page @l="301" fade="300"/><bgm @l="303" src="bgm13" volume="1."/><msg @l="305" char_id="-1" frame_id="-1" name="" text="瞬间，熊野踢地跃起。"   voices=""/><msg @l="306" char_id="-1" frame_id="-1" name=""   text="本应年迈的熊野展现出难以想象的强劲而灵活的跳跃。这个时机和角度本应足以让熊野确信胜利——本应如此。"   voices=""/><flash @l="309" count="4" fade="100" image="white"/><msg @l="311" char_id="-1" frame_id="-1" name="" text=":『什么？！』" voices=""/><msg @l="313" char_id="-1" frame_id="-1" name=""   text=":但是，被击飞的却是熊野。" voices=""/><msg @l="314" char_id="-1" frame_id="-1" name=""   text="真弥横扫而出的手臂轻而易举地抓住了熊野，随即将他重重地摔向一棵大树的树干。" voices=""/><se @l="317" buf="1" src="刃物刺す音4" volume="1."/><flash @l="319" count="4" fade="100" image="white"/><msg @l="321" char_id="-1" frame_id="-1" name="" text=":『呃啊！！！』"   voices=""/><msg @l="323" char_id="-1" frame_id="-1" name=""   text=":熊野背部重重撞上大树，发出短促的呻吟。" voices=""/><msg @l="324" char_id="-1" frame_id="-1" name="" page_feed="true"   text="真弥注视着熊野，眼神中带着怜悯，慢慢地向他走去。" voices=""/><page @l="327" fade="300"/><wait_chgmv/><bg @l="329" src="bg23a"/><bgm @l="332" src="bgm12" volume="1."/><char @l="335" id="shiny" pos="auto" src="shinya018"/><msg @l="337" char_id="-1" frame_id="-1" name="" text="『…………。』" voices=""/><char @l="340" id="kuma" pos="center" src="kuma018"/><msg @l="342" char_id="-1" frame_id="-1" name=""   text=":『等、等等……咳、该死这是什么力量！？』" voices=""/><clear @l="345" class="char"/><char @l="347" id="shiny" pos="left" src="shinya018"/><char @l="349" id="kuma" pos="right" src="kuma018"/><msg @l="351" char_id="-1" frame_id="-1" name="" text=":『你没有胜算，放弃吧。』"   voices=""/><msg @l="353" char_id="-1" frame_id="-1" name=""   text=":『混账东西为什么！？为什么，要妨碍我！你不也和我们是同类吗！！』" voices=""/><msg @l="355" char_id="-1" frame_id="-1" name="" text=":『别把我和你们相提并论。』"   voices=""/><msg @l="357" char_id="-1" frame_id="-1" name=""   text=":『什么！！该死。我好不容易才把这个城镇发展到这个地步。难道要我眼睁睁看着它毁于一旦吗！！』"   voices=""/><msg @l="359" char_id="-1" frame_id="-1" name="" text=":『你是说这个扭曲的性欲处理场吗？』"   voices=""/><msg @l="361" char_id="-1" frame_id="-1" name=""   text=":  『扭曲？不，这才是这个镇子……不，这个村庄本来的样子。』" voices=""/><msg @l="363" char_id="-1" frame_id="-1" name=""   text=":  『什么……？』" voices=""/><msg @l="365" char_id="-1" frame_id="-1" name=""   text=":  『二十多年前，这个南总村有一座大黑制药的研究所。表面上是在开发营养剂和蛋白质补充剂之类的东西，但真正的目的是创造出拥有极致肉体的超人。当然，是为了军事目的。』"   voices=""/><msg @l="367" char_id="-1" frame_id="-1" name=""   text=":  『然后，经过许多失败作品，最终达到了一个完成形态。』" voices=""/><msg @l="369" char_id="-1" frame_id="-1" name="" text=":『那就是注射给稻庭俊明的药物吗。』"   voices=""/><msg @l="371" char_id="-1" frame_id="-1" name=""   text=":  『没错。强健的肉体和强烈的斗争本能，实验看起来很成功。作为副产品，还确认了能提高性欲的媚药效果。但是，为了实用化，需要进行大量的实验。』"   voices=""/><msg @l="373" char_id="-1" frame_id="-1" name=""   text=":  『其中，控制性冲动尤其困难，最终得出需要专门实验设施的结论。』"   voices=""/><msg @l="375" char_id="-1" frame_id="-1" name=""   text=":  『然后诞生的计划就是将整个镇子变成性欲处理场吗……荒谬至极。』" voices=""/><msg @l="377" char_id="-1" frame_id="-1" name=""   text=":  『你这么认为吗？但是那些害怕村子荒废的村民们爽快地同意了，政治家的运作也比预想的顺利得多。你知道这意味着什么吗？』"   voices=""/><msg @l="379" char_id="-1" frame_id="-1" name=""   text=":  『…………。』" voices=""/><msg @l="381" char_id="-1" frame_id="-1" name=""   text=":  『是理想乡啊。』" voices=""/><msg @l="383" char_id="-1" frame_id="-1" name="" text=":  『什么！？』"   voices=""/><msg @l="385" char_id="-1" frame_id="-1" name=""   text=":  『对政治家和企业的人来说是性的度假胜地，对村民来说是带来巨大财富的金蛋。而对我们来说，整个镇子将成为提供无限数据的实验场。』"   voices=""/><msg @l="387" char_id="-1" frame_id="-1" name=""   text=":  『已经结束了初期阶段的测试，接下来计划将开始全面启动。当然，许多企业和居民都会搬来这里。』"   voices=""/><msg @l="389" char_id="-1" frame_id="-1" name="" text=":『…………。』" voices=""/><msg @l="391" char_id="-1" frame_id="-1" name=""   text=":『你能理解我们至今的辛苦吗？如果贸然毁掉这个镇子，镇上的人们的生活会怎样？你到底想要什么？』"   voices=""/><msg @l="393" char_id="-1" frame_id="-1" name=""   text=":『这种药虽然出色，但还有很多副作用。不过如果你和我合作，很快就能找到解决办法。这不是个坏提议，对吧？』"   voices=""/><msg @l="395" char_id="-1" frame_id="-1" name="" text=":熊野向真弥投去谄媚的笑容。"   voices=""/><msg @l="396" char_id="-1" frame_id="-1" name="" text="但是，接收到这笑容的真弥表情没有任何变化。"   voices=""/><msg @l="397" char_id="-1" frame_id="-1" name="" text="他回以拒绝的话语。"   voices=""/><msg @l="399" char_id="-1" frame_id="-1" name=""   text=":『的确，我也拥有与你相同类型的力量。但是……我与你有着根本性的区别。』" voices=""/><msg @l="401" char_id="-1" frame_id="-1" name=""   text=":『？！ 区别……是……』" voices=""/><stopbgm @l="404" fadeout="1000"/><msg @l="406" char_id="-1" frame_id="-1" name="" text=":『我的力量是与生俱来的。』"   voices=""/><msg @l="408" char_id="-1" frame_id="-1" name="" text=":『什、什么……？！』"   voices=""/><msg @l="410" char_id="-1" frame_id="-1" name=""   text=":『我母亲的名字是浅间真那。你应该有印象吧！！』" voices=""/><msg @l="412" char_id="-1" frame_id="-1" name="" page_feed="true"   text=":  『难、难道……。』" voices=""/><page @l="415" fade="300"/><bgm @l="417" src="bgm18" volume="1."/><msg @l="419" char_id="-1" frame_id="-1" name=""   text=":『我是，被你们杀害的浅间真那的儿子，浅间真弥。』" voices=""/><msg @l="421" char_id="-1" frame_id="-1" name=""   text=":『等等，请等一下。的确当时我把浅间作为实验对象进行研究。但是，那只是一场意外……是意外啊。』"   voices=""/><msg @l="423" char_id="-1" frame_id="-1" name=""   text=":『真可悲………你们犯下的罪行已经被调查清楚了。』" voices=""/><msg @l="425" char_id="-1" frame_id="-1" name=""   text=":  『你们同步推进的项目……“通过强化母体诞生超人”的计划。』"   voices=""/><msg @l="427" char_id="-1" frame_id="-1" name=""   text=":  『什……，你从哪里知道的！难道！？』" voices=""/><msg @l="429" char_id="-1" frame_id="-1" name=""   text=":  『没错，我自己就是计划的活证人。』" voices=""/><msg @l="431" char_id="-1" frame_id="-1" name=""   text=":  『不是通过药物从外部强化，而是事先用药物强化母体，让她生下孩子，创造出天生就拥有超人身体素质的人类的计划。我就是第一个试验品。』"   voices=""/><msg @l="433" char_id="-1" frame_id="-1" name=""   text=":『那么你难道……是大黑藏之介的！？』" voices=""/><msg @l="435" char_id="-1" frame_id="-1" name=""   text=":  『不要在我面前提那个名字！』" voices=""/><msg @l="437" char_id="-1" frame_id="-1" name=""   text=":  『母亲，盲目地爱着那家伙。她总是对我们兄妹说，只要这项研究对大黑集团……也就是对藏之介有利，她自己变成什么样都无所谓。但是，那个男人却利用这点，把母亲变成了一个只为生产实验体的人偶！！』"   voices=""/><msg @l="439" char_id="-1" frame_id="-1" name="" page_feed="true"   text=":  『但是，实验应该全都以失败告终！出生的孩子与普通孩子没什么区别，浅间也因为无法承受反复的强化而在实验中意外死亡。之后，当时的大部分研究员都被某人杀害了。』"   voices=""/><stopbgm @l="443" fadeout="1000"/><page @l="445" fade="300"/><msg @l="447" char_id="-1" frame_id="-1" name=""   text=":  『实验其实成功了。』" voices=""/><msg @l="449" char_id="-1" frame_id="-1" name=""   text=":  『什么！？』" voices=""/><bgm @l="452" src="bgm12" volume="1."/><msg @l="455" char_id="-1" frame_id="-1" name=""   text=":  『从对稻庭的实验中你应该已经知道，力量的显现与情感有很大关联。』" voices=""/><msg @l="457" char_id="-1" frame_id="-1" name=""   text=":  『那又怎样……难道！』" voices=""/><msg @l="459" char_id="-1" frame_id="-1" name=""   text=":  『没错，我体内潜藏的力量突然觉醒了。就在那个偶然目睹母亲被杀害的时刻！』"   voices=""/><msg @l="461" char_id="-1" frame_id="-1" name=""   text=":  『我的目标是大黑制药，以及大黑集团。我复仇的对象是为了超人这种愚蠢目标而践踏弱者的所有人，包括你这样的家伙！！！』"   voices=""/><msg @l="463" char_id="-1" frame_id="-1" name="" text=":『！！！！！！』"   voices=""/><msg @l="465" char_id="-1" frame_id="-1" name=""   text=":『…………我会埋葬你们……一个不留。这就是我的复仇。』" voices=""/><msg @l="467" char_id="-1" frame_id="-1" name="" text=":『…………………。』"   voices=""/><msg @l="469" char_id="-1" frame_id="-1" name=""   text=":熊野露出了一副像是嚼碎了苦虫般的表情。" voices=""/><msg @l="470" char_id="-1" frame_id="-1" name=""   text="既然真弥的目标是自己，避免战斗是不可能的。" voices=""/><msg @l="471" char_id="-1" frame_id="-1" name=""   text="自己和真弥。能力方面真弥绝对占上风。" voices=""/><msg @l="473" char_id="-1" frame_id="-1" name=""   text=":───一边寻找着可乘之机一边观察周围，当目光扫到废弃道路的出口处时，熊野咧嘴一笑。"   voices=""/><msg @l="475" char_id="-1" frame_id="-1" name=""   text=":熊野朝真弥冲了过去，在真弥摆好架势的同时猛地踢地。" voices=""/><msg @l="477" char_id="-1" frame_id="-1" name="" page_feed="true"   text="他越过真弥的头顶落在废弃道路出口附近，然后向潜伏在那里的人影伸出了手。" voices=""/><stopbgm @l="480" fadeout="1000"/><clear @l="483" class="char"/><page @l="485" fade="300"/><char @l="487" id="nanak" pos="auto" src="nanako014"/><char @l="489" id="kuma" pos="left" src="kuma018"/><msg @l="491" char_id="-1" frame_id="-1" name="" text="『啊……。』" voices=""/><msg @l="493" char_id="-1" frame_id="-1" name="" text=":『别动，小丫头，你也是。』"   voices=""/><msg @l="495" char_id="-1" frame_id="-1" name=""   text=":熊野绕到奈那子背后，把手放在她脖子上说道。" voices=""/><char @l="498" id="nanak" pos="auto" src="nanako015"/><char @l="500" id="kuma" pos="auto" src="kuma018"/><bgm @l="502" src="bgm13" volume="1."/><msg @l="504" char_id="-1" frame_id="-1" name="" text=":『奈那子！？』"   voices=""/><msg @l="506" char_id="-1" frame_id="-1" name="" text=":『对不起……兄长。』"   voices=""/><msg @l="508" char_id="-1" frame_id="-1" name=""   text=":『呋哈哈哈，疏忽大意啊。浅间小子！！』" voices=""/><msg @l="510" char_id="-1" frame_id="-1" name="" text=":真弥朝熊野逼近。"   voices=""/><msg @l="512" char_id="-1" frame_id="-1" name="" text="熊野把奈那子的身体……当作盾牌。"   voices=""/><msg @l="514" char_id="-1" frame_id="-1" name=""   text=":『嗯～？轻举妄动的话就杀了这小丫头。』" voices=""/><msg @l="516" char_id="-1" frame_id="-1" name="" text=":『啧……卑鄙。』"   voices=""/><msg @l="518" char_id="-1" frame_id="-1" name=""   text=":『没想到这小丫头是你妹妹啊。对我来说正好。』" voices=""/><msg @l="520" char_id="-1" frame_id="-1" name=""   text=":因为奈那子被当做人质，真弥的动作不得不停下来，熊野朝他的侧腹部给予了强烈的一击。" voices=""/><se @l="524" buf="1" src="箱を蹴ってる" volume="1."/><flash @l="526" count="4" fade="100" image="white"/><msg @l="528" char_id="-1" frame_id="-1" name="" text=":『呃啊啊啊啊啊！！』"   voices=""/><msg @l="530" char_id="-1" frame_id="-1" name=""   text=":直接承受攻击的真弥的侧腹被猛烈震动。瞬间，真弥的口中喷出大量鲜血。" voices=""/><msg @l="532" char_id="-1" frame_id="-1" name="" text=":『咳哈啊！！』"   voices=""/><msg @l="534" char_id="-1" frame_id="-1" name="" text=":『兄长————！』"   voices=""/><msg @l="536" char_id="-1" frame_id="-1" name=""   text=":奈那子抓住熊野手松懈的瞬间，跑到了真弥身边。" voices=""/><msg @l="537" char_id="-1" frame_id="-1" name="" page_feed="true"   text="真弥因肋腹被掏空般的剧痛而扭曲了脸。他咬紧牙关，勉强支撑起身体。" voices=""/><label @l="540" id="chart_line62"/><wait_chgmv/><ev @l="543" src="ev-066"/><page @l="545" fade="300"/><msg @l="547" char_id="-1" frame_id="-1" name=""   text="『奈那子！你没事吧……你退后！』" voices=""/><msg @l="549" char_id="-1" frame_id="-1" name=""   text=":『还能动真是厉害，不愧是你。但是你妹妹呢？只要你有一丝破绽，我能在一瞬间就折断你妹妹的脖子。』"   voices=""/><msg @l="551" char_id="-1" frame_id="-1" name=""   text=":说完，熊野凶猛地向两人袭来。准确地说，是朝着奈那子冲去。" voices=""/><msg @l="552" char_id="-1" frame_id="-1" name=""   text="当然，真弥为了保护奈那子，用自己的全身承受了熊野的拳头。" voices=""/><msg @l="553" char_id="-1" frame_id="-1" name=""   text="正如熊野所料，真弥没有反击。" voices=""/><msg @l="554" char_id="-1" frame_id="-1" name=""   text="即使想要反击，除非能确保完全制止熊野的动作，否则奈那子就会受到伤害。真弥无法接受这样的赌博。"   voices=""/><msg @l="558" char_id="-1" frame_id="-1" name="" text=":『喝啊啊啊啊啊！』"   voices=""/><se @l="562" buf="0" src="刃物刺す音3" volume="1."/><flash @l="564" count="4" fade="100" image="white"/><msg @l="566" char_id="-1" frame_id="-1" name="" text=":『呃，噶！』"   voices=""/><se @l="570" buf="1" src="刃物刺す音1" volume="1."/><flash @l="572" count="4" fade="100" image="white"/><wait @l="574" time="300"/><se @l="576" buf="1" src="刃物刺す音4" volume="1."/><flash @l="578" count="4" fade="100" image="white"/><wait @l="580" time="300"/><se @l="582" buf="1" src="刃物刺す音3" volume="1."/><flash @l="584" count="4" fade="100" image="white"/><wait @l="586" time="300"/><se @l="588" buf="1" src="刃物刺す音1" volume="1."/><flash @l="590" count="4" fade="100" image="white"/><msg @l="593" char_id="-1" frame_id="-1" name="" text=":真弥单方面地不断受伤。"   voices=""/><msg @l="594" char_id="-1" frame_id="-1" name=""   text="熊野对着受伤的真弥，高高抬起腿，用尽全力踢了过去。" voices=""/><se @l="596" buf="1" src="箱を蹴ってる" volume="1."/><shake @l="598" amp="10" class="all" cycle="30" duration="1000"   type="random"/><msg @l="600" char_id="-1" frame_id="-1" name="" page_feed="true"   text="真弥被踢飞，重重摔在地上。发出痛苦的呻吟声，蜷缩成一团。" voices=""/><page @l="603" fade="300"/><msg @l="605" char_id="-1" frame_id="-1" name=""   text=":『啊哈哈哈！你的复仇就到此为止了吗？』" voices=""/><msg @l="607" char_id="-1" frame_id="-1" name=""   text=":面对熊野的嘲笑，现在的真弥已经毫无还手之力。" voices=""/><msg @l="608" char_id="-1" frame_id="-1" name=""   text="面对这样的真弥，熊野毫不留情地说道。" voices=""/><msg @l="610" char_id="-1" frame_id="-1" name=""   text=":『你这家伙虽然没用，但你妹妹倒是有用。她身材不错，也该加入镇上的玩物行列了！！哈哈哈哈！！』"   voices=""/><msg @l="612" char_id="-1" frame_id="-1" name=""   text=":『奈…奈那子…快，逃跑…』" voices=""/><msg @l="614" char_id="-1" frame_id="-1" name="" text=":『…』"   voices=""/><msg @l="616" char_id="-1" frame_id="-1" name="" text=":『快…快逃啊…』"   voices=""/><msg @l="618" char_id="-1" frame_id="-1" name="" text=":『看来你妹妹很识相嘛。』"   voices=""/><msg @l="620" char_id="-1" frame_id="-1" name="" text=":『…』"   voices=""/><msg @l="622" char_id="-1" frame_id="-1" name="" text=":『奈，奈那子…？』"   voices=""/><msg @l="624" char_id="-1" frame_id="-1" name="" page_feed="true"   text=":『时间不多了。来吧，你这没用的家伙就去死吧！』" voices=""/><page @l="627" fade="300"/><clear @l="629" class="all"/><se @l="631" buf="3" loop="true" src="心臓" volume="1."/><stopbgm @l="633" fadeout="1000"/><flash @l="636" count="4" fade="100" image="white"/><wait @l="638" time="300"/><msg @l="640" char_id="-1" frame_id="-1" name="" text=":咚" voices=""/><flash @l="643" count="4" fade="100" image="white"/><wait @l="645" time="300"/><msg @l="647" char_id="-1" frame_id="-1" name="" text="咚咚咚" voices=""/><flash @l="650" count="4" fade="100" image="white"/><wait @l="652" time="300"/><msg @l="654" char_id="-1" frame_id="-1" name="" text=":『………不……。』"   voices=""/><msg @l="656" char_id="-1" frame_id="-1" name=""   text=":之前一直呆呆地坐在真弥旁边的奈那子，她的嘴唇突然动了起来。" voices=""/><msg @l="658" char_id="-1" frame_id="-1" name="" text=":『……什么？』" voices=""/><msg @l="660" char_id="-1" frame_id="-1" name="" page_feed="true"   text=":『奈……奈那子………！？』" voices=""/><page @l="663" fade="300"/><label @l="666" id="chart_line70"/><wait_chgmv/><ev @l="669" src="ev-004"/><msgshow @l="671" show="true"/><msg @l="673" char_id="-1" frame_id="-1" name="" text="『……不能原谅……。』" voices=""/><msg @l="675" char_id="-1" frame_id="-1" name=""   text=":『哼，我还以为你很识相呢………小丫头。』" voices=""/><msg @l="677" char_id="-1" frame_id="-1" name=""   text=":『不可原谅………伤害哥哥和美帆的人……。』" voices=""/><stopse @l="680" buf="3"/><msg @l="682" char_id="-1" frame_id="-1" name="" page_feed="true"   text=":与平时的奈那子不同，那凛然的声音随风飘荡，使草木都为之摇曳。" voices=""/><page @l="684" fade="300"/><wait_chgmv/><ev @l="686" src="ev-004x1"/><bgm @l="688" src="bgm17" volume="1."/><msg @l="690" char_id="-1" frame_id="-1" name="" page_feed="true"   text=":『不·可·原·谅·！！』" voices=""/><page @l="693" fade="300"/><msg @l="695" char_id="-1" frame_id="-1" name=""   text=":『奈那子………难道是觉醒了……吗？』" voices=""/><msg @l="697" char_id="-1" frame_id="-1" name="" page_feed="true"   text=":『啊？！ 觉醒…你说………难道…………！？』" voices=""/><page @l="700" fade="300"/><clear @l="702" class="all"/><msg @l="704" char_id="-1" frame_id="-1" name="" page_feed="true"   text=":\n:\n:\n:\n:\n:『……我………要杀了你。』" voices=""/><page @l="707" fade="300"/><wait_chgmv/><bg @l="710" src="bg23a"/><char @l="712" id="nanak" pos="auto" src="nanako118"/><msg @l="714" char_id="-1" frame_id="-1" name="" text="奈那子摇晃着向熊野靠近。"   voices=""/><msg @l="715" char_id="-1" frame_id="-1" name="" text="刚才那种柔弱的气息已经荡然无存。"   voices=""/><msg @l="716" char_id="-1" frame_id="-1" name=""   text="取而代之的，是让空气都为之震颤的……压倒性的气势与愤怒。" voices=""/><clear @l="719" class="char"/><char @l="721" id="nanak" pos="left" src="nanako118"/><char @l="723" id="kuma" pos="right" src="kuma018"/><msg @l="725" char_id="-1" frame_id="-1" name=""   text=":『……喂。什什么！！这小丫头也是！！不过，我会把你制服的！』" voices=""/><clear @l="728" layer="kuma"/><msg @l="730" char_id="-1" frame_id="-1" name=""   text=":熊野像是要掩饰一丝畏缩，一边吼叫一边向奈那子挥拳攻击。" voices=""/><msg @l="732" char_id="-1" frame_id="-1" name=""   text=":『小丫头啊啊啊啊啊啊啊啊啊啊啊！！！』" voices=""/><msg @l="734" char_id="-1" frame_id="-1" name="" page_feed="true"   text=":『…………。』" voices=""/><clear @l="737" class="all"/><flash @l="740" count="4" fade="100" image="white"/><se @l="742" buf="1" src="刃物刺す音1" volume="1."/><page @l="744" fade="300"/><msg @l="747" char_id="-1" frame_id="-1" name="" text=":熊野的拳头击中了奈那子的脸颊。"   voices=""/><msg @l="748" char_id="-1" frame_id="-1" name="" page_feed="true"   text=":\n:\n:不———看似击中了。" voices=""/><page @l="751" fade="300"/><label @l="754" id="chart_line71"/><wait_chgmv/><ev @l="757" src="ev-063"/><msg @l="759" char_id="-1" frame_id="-1" name="" text="『怎、怎么回事………？』"   voices=""/><msg @l="761" char_id="-1" frame_id="-1" name=""   text=":熊野的拳头打在了奈那子身后的树干上。" voices=""/><msg @l="762" char_id="-1" frame_id="-1" name=""   text="树干被重重地砸出一个大凹陷，拳头深深地陷了进去。" voices=""/><wait @l="764" time="300"/><msg @l="766" char_id="-1" frame_id="-1" name="" text=":『你………太慢了。』"   voices=""/><msg @l="768" char_id="-1" frame_id="-1" name="" text=":『……！？』" voices=""/><wait_chgmv/><ev @l="771" src="ev-063a"/><msg @l="773" char_id="-1" frame_id="-1" name="" text=":奈那子突然出现在熊野的背后。"   voices=""/><msg @l="774" char_id="-1" frame_id="-1" name=""   text="就在拳头看似击中的那一瞬间，她以让人以为消失了的速度绕到了熊野的背后。" voices=""/><msg @l="775" char_id="-1" frame_id="-1" name=""   text="从背后传来的压迫感，让熊野意识到奈那子已经绕到了他的身后。" voices=""/><msg @l="777" char_id="-1" frame_id="-1" name="" text=":『胡、胡闹……！？』"   voices=""/><msg @l="779" char_id="-1" frame_id="-1" name=""   text=":然、然而面对背后不断膨胀的压迫感，他无法回头查看。" voices=""/><msg @l="780" char_id="-1" frame_id="-1" name="" page_feed="true"   text="如果稍有分神，脖子以上的部分就会瞬间消失。" voices=""/><page @l="782" fade="300"/><msg @l="784" char_id="-1" frame_id="-1" name=""   text=":『住手―――奈那子！只有我一个人被血污染就够了！你不需要也沾染复仇的罪孽………。』"   voices=""/><msg @l="786" char_id="-1" frame_id="-1" name="" page_feed="true"   text=":『哥哥……对不起。但是，唯独这个人我无论如何都无法原谅。母亲的仇人。伤害了哥哥，还让美帆伤心的人。』"   voices=""/><page @l="789" fade="300"/><msg @l="791" char_id="-1" frame_id="-1" name="" page_feed="true"   text=":『夺走喜欢的人，夺走所爱之人的你…………由我来杀。』" voices=""/><clear @l="794" class="all"/><stopbgm @l="796" fadeout="1000"/><page @l="798" fade="300"/><msg @l="801" char_id="-1" frame_id="-1" name=""   text=":奈那子话音刚落，熊野就跳了起来。" voices=""/><msg @l="802" char_id="-1" frame_id="-1" name=""   text="无论他动与不动，结局大致都已经注定。" voices=""/><msg @l="803" char_id="-1" frame_id="-1" name=""   text="但如果还有哪怕一丝可能性……熊野的求生本能促使他行动了。" voices=""/><se @l="806" buf="1" src="刃物刺す音4" volume="1."/><flash @l="808" count="4" fade="100" image="white"/><msg @l="810" char_id="-1" frame_id="-1" name=""   text=":\n:  ────然而，就在熊野的身体刚离地10厘米的时间里，奈那子已经拉近了距离，将熊野的头颅击飞了。"   voices=""/><msg @l="812" char_id="-1" frame_id="-1" name=""   text=":奈那子保持着挥臂的姿势，指尖滴落着熊野的血液。" voices=""/><msg @l="813" char_id="-1" frame_id="-1" name="" page_feed="true"   text="真弥……用某种寂寞的表情注视着这一切。" voices=""/><clear @l="817" class="all"/><page @l="819" fade="300"/><wait @l="821" time="1000"/><bgm @l="823" src="bgm20" volume="1."/><label @l="826" id="chart_line72"/><wait_chgmv/><ev @l="829" src="ev-053y1y2"/><msg @l="831" char_id="-1" frame_id="-1" name="" text="『……。』" voices=""/><msg @l="833" char_id="-1" frame_id="-1" name="" text=":『……。』"   voices="nanako00390"/><msg @l="835" char_id="-1" frame_id="-1" name=""   text=":两人从远离城镇的空地上，眺望着南总町。" voices=""/><msg @l="836" char_id="-1" frame_id="-1" name=""   text="因为创建这个城镇的熊野消失了，南总町将会如何变化呢。" voices=""/><msg @l="837" char_id="-1" frame_id="-1" name=""   text="毫无疑问，对于那些曾经依附于他并吮吸甜蜜的人来说，这里将变成一个难以居住的地方。" voices=""/><msg @l="838" char_id="-1" frame_id="-1" name=""   text="只是……尽管如此，熊野留下的痕迹依然很深。" voices=""/><msg @l="839" char_id="-1" frame_id="-1" name="" page_feed="true"   text="南总町要恢复成正常运转的城镇，恐怕还需要相当长的时间。" voices=""/><page @l="841" fade="300"/><msg @l="843" char_id="-1" frame_id="-1" name=""   text=":『哥哥……我们还要去别的城镇吗？』" voices="nanako00400"/><msg @l="845" char_id="-1" frame_id="-1" name=""   text=":『啊啊。因为这里的复仇已经结束了。』" voices=""/><msg @l="847" char_id="-1" frame_id="-1" name="" text=":『是吗……。』"   voices="nanako00410"/><msg @l="849" char_id="-1" frame_id="-1" name="" text=":『你感到寂寞吗？』"   voices=""/><msg @l="851" char_id="-1" frame_id="-1" name="" page_feed="true"   text=":『嗯……有一点。』" voices="nanako00420"/><page @l="854" fade="300"/><msg @l="856" char_id="-1" frame_id="-1" name="" text=":奈那子说完这句话后，微微低下了头。"   voices=""/><msg @l="857" char_id="-1" frame_id="-1" name=""   text="在对熊野发起一击之后，奈那子就像断了线的人偶一样失去了意识……醒来后，她不记得之前发生的事情了。"   voices=""/><msg @l="859" char_id="-1" frame_id="-1" name=""   text=":『奈那子……你，那个时候……。』" voices=""/><msg @l="861" char_id="-1" frame_id="-1" name="" text=":『那个时候是指什么？』"   voices="nanako00430"/><msg @l="863" char_id="-1" frame_id="-1" name="" text=":『不……没什么。』"   voices=""/><msg @l="865" char_id="-1" frame_id="-1" name="" text=":『呵呵，哥哥真奇怪。』"   voices="nanako00440"/><msg @l="867" char_id="-1" frame_id="-1" name=""   text=":真弥再次思考着，那时的事情，她是否记得，这样的事情其实是微不足道的。" voices=""/><msg @l="868" char_id="-1" frame_id="-1" name=""   text="只是，从那天起，她开始称呼真弥为“哥哥”。" voices=""/><msg @l="869" char_id="-1" frame_id="-1" name=""   text="但是，对真弥来说这也无关紧要。" voices=""/><msg @l="870" char_id="-1" frame_id="-1" name="" page_feed="true"   text=":只要奈那子能…在身边就…足够了…。" voices=""/><stopbgm @l="873" fadeout="1000"/><clear @l="876" class="all"/><page @l="878" fade="300"/><wait @l="880" time="2000"/><msg @l="886" char_id="-1" frame_id="-1" name="" page_feed="true"   text="———几个月后。" voices=""/><page @l="889" fade="300"/><msg @l="891" char_id="-1" frame_id="-1" name=""   text="———距离南总町那件事已经过去了几个月。" voices=""/><msg @l="892" char_id="-1" frame_id="-1" name=""   text="奈那子在与真弥的旅途中经历了几次战斗，觉醒了“与常人不同的力量”。今天他们也融入某个城市的黑暗中，两人继续着复仇之旅——。"   voices=""/><label @l="896" id="chart_line74"/><wait_chgmv/><ev @l="900" src="ev-064"/><bgm @l="904" src="bgm11" volume="1."/><msg @l="906" char_id="-1" frame_id="-1" name=""   text=":&#32;&#32;『身体状况怎么样…奈那子。』" voices=""/><msg @l="908" char_id="-1" frame_id="-1" name=""   text=":&#32;&#32;『没事，还不错。』" voices="nanako00000"/><msg @l="910" char_id="-1" frame_id="-1" name=""   text=":&#32;&#32;在铁塔的最顶层附近，奈那子和真弥眺望着夜晚的城镇。" voices=""/><msg @l="911" char_id="-1" frame_id="-1" name=""   text="奈那子的瞳孔已经染成了红色……表明她作为“异于常人的存在”已经觉醒的事实。" voices=""/><msg @l="912" char_id="-1" frame_id="-1" name=""   text=":&#32;&#32;自那天起，奈那子偶尔会觉醒“力量”。" voices=""/><msg @l="913" char_id="-1" frame_id="-1" name=""   text="奈那子的感觉敏锐，拥有比真弥强数十倍的感知能力。" voices=""/><msg @l="915" char_id="-1" frame_id="-1" name="" page_feed="true"   text=":&#32;&#32;只是，每当完成一次复仇，真弥总觉得往常的奈那子似乎在消失，因此他每次都会像刚才那样问候……担心着她。"   voices=""/><page @l="918" fade="300"/><msg @l="920" char_id="-1" frame_id="-1" name="" page_feed="true"   text="为了不让她被“力量”吞噬……。" voices=""/><page @l="923" fade="300"/><msg @l="925" char_id="-1" frame_id="-1" name=""   text=":&#32;&#32;『哥哥……那边，我感觉到了什么。』" voices="nanako00010"/><msg @l="927" char_id="-1" frame_id="-1" name=""   text=":&#32;&#32;『奈那子……。』" voices=""/><msg @l="929" char_id="-1" frame_id="-1" name="" text=":&#32;&#32;『……？』"   voices=""/><msg @l="931" char_id="-1" frame_id="-1" name=""   text=":&#32;&#32;『没什么，没事……来，我们走吧。』" voices=""/><clear @l="937" class="all"/><msg @l="939" char_id="-1" frame_id="-1" name=""   text=":&#32;&#32;听了奈那子的话，真弥跃入夜空。" voices=""/><msg @l="940" char_id="-1" frame_id="-1" name="" page_feed="true"   text="奈那子也跟在真弥身后，将身体投入夜空之中。" voices=""/><page @l="942" fade="300"/><msg @l="944" char_id="-1" frame_id="-1" name="" page_feed="true"   text="他们的复仇之旅……至今仍在某处继续着———。" voices=""/><stopbgm @l="948" fadeout="1000"/><page @l="952" fade="300"/><msgshow @l="954" show="false"/><wait @l="956" time="2000"/><description @l="970" text="再会"/><eval @l="972" expr="f.numDay=0&#13;&#10;"/><page @l="975" fade="300"/><wait @l="977" time="3000"/><msg @l="979" char_id="-1" frame_id="-1" name="" page_feed="true"   text=":\n:\n:\n:\n:\n:———然后，重逢。" voices=""/><page @l="982" fade="300"/><label @l="984" id="chart_line75"/><wait_chgmv/><ev @l="987" src="ev-065"/><bgm @l="990" src="bgm11" volume="1."/><msg @l="992" char_id="-1" frame_id="-1" name=""   text=":&#32;&#32;『真的……这是最后一次了啊。』" voices=""/><msg @l="994" char_id="-1" frame_id="-1" name=""   text=":&#32;&#32;『嗯，我知道的……哥哥。』" voices="nanako00020"/><msg @l="996" char_id="-1" frame_id="-1" name=""   text=":&#32;&#32;与真弥无奈的表情相反，奈那子脸上挂着灿烂的笑容。" voices=""/><msg @l="997" char_id="-1" frame_id="-1" name=""   text="找到了美帆所在的地方……最先告诉她这个消息的，正是真弥本人。" voices=""/><msg @l="998" char_id="-1" frame_id="-1" name=""   text="看到奈那子时常露出寂寞的表情……他是为了照顾她的心情。" voices=""/><msg @l="1000" char_id="-1" frame_id="-1" name=""   text=":&#32;&#32;『不过……我觉得没必要非得一起去……』" voices=""/><msg @l="1002" char_id="-1" frame_id="-1" name=""   text=":&#32;&#32;『不行哦。仔细想想，我还没有好～好地把哥哥介绍给美帆呢。』"   voices="nanako00030"/><msg @l="1004" char_id="-1" frame_id="-1" name=""   text=":&#32;&#32;『不需要什么介绍……对她来说，还是不要和我这样的人扯上关系比较好。』" voices=""/><msg @l="1006" char_id="-1" frame_id="-1" name=""   text=":&#32;&#32;『噗～，不～行～。』" voices="nanako00040"/><msg @l="1008" char_id="-1" frame_id="-1" name=""   text=":&#32;&#32;『……。』" voices=""/><msg @l="1010" char_id="-1" frame_id="-1" name=""   text=":&#32;&#32;听了奈那子的话，真弥默不作声，脸上浮现出一副无可奈何的表情。" voices=""/><msg @l="1011" char_id="-1" frame_id="-1" name="" page_feed="true"   text="平时很听话的奈那子，一旦涉及到美帆的事情，就完全不听真弥的话了。" voices=""/><page @l="1014" fade="300"/><msg @l="1016" char_id="-1" frame_id="-1" name=""   text="只是……不可否认，能够满足奈那子这样的任性要求，对真弥来说也是一种小小的喜悦。" voices=""/><msg @l="1017" char_id="-1" frame_id="-1" name="" page_feed="true"   text=":&#32;&#32;「与人不同的存在」与「人类」……仅仅因为这样微小的差异就舍弃一切，果然还是很痛苦的。" voices=""/><page @l="1020" fade="300"/><msg @l="1022" char_id="-1" frame_id="-1" name=""   text=":&#32;&#32;自那次事件以来，奈那子正在迅速觉醒。" voices=""/><msg @l="1023" char_id="-1" frame_id="-1" name=""   text="照这样下去，不久的将来她就会作为「与人不同的存在」彻底觉醒吧。" voices=""/><msg @l="1024" char_id="-1" frame_id="-1" name=""   text=":这同时也意味着，与内心破坏冲动的孤独斗争即将开始。" voices=""/><msg @l="1025" char_id="-1" frame_id="-1" name="" page_feed="true"   text=":&#32;&#32;在最坏的情况下，甚至可能需要亲手埋葬最爱的妹妹……" voices=""/><page @l="1028" fade="300"/><msg @l="1030" char_id="-1" frame_id="-1" name=""   text=":&#32;&#32;但是，即使如此……" voices=""/><msg @l="1031" char_id="-1" frame_id="-1" name=""   text="在那之前，至少想让她体验一下普通人的友情。" voices=""/><msg @l="1032" char_id="-1" frame_id="-1" name=""   text="而且，那个叫美帆的少女身上有一种莫名让人想起已故母亲的气质。" voices=""/><msg @l="1034" char_id="-1" frame_id="-1" name=""   text=":&#32;&#32;『也许不只是奈那子想见她……』" voices=""/><msg @l="1036" char_id="-1" frame_id="-1" name="" page_feed="true"   text=":&#32;&#32;说着，真弥抬头望向西方的天空。" voices=""/><clear @l="1040" class="all"/><page @l="1042" fade="300"/><msg @l="1044" char_id="-1" frame_id="-1" name="" text="不知过了多长时间———。"   voices=""/><msg @l="1045" char_id="-1" frame_id="-1" name="" page_feed="true"   text="太阳已经完全快要落山，橙色的晚霞笼罩着周围。" voices=""/><page @l="1048" fade="300"/><char @l="1050" id="shiny" pos="left" src="shinya010"/><msg @l="1052" char_id="-1" frame_id="-1" name="" text=":&#32;&#32;『奈那子。』"   voices=""/><char @l="1055" id="nanak" pos="right" src="nanako019"/><msg @l="1057" char_id="-1" frame_id="-1" name="" text=":&#32;&#32;『嗯？』"   voices="nanako00050"/><msg @l="1059" char_id="-1" frame_id="-1" name=""   text=":&#32;&#32;真弥没有说话，只是默默地移动下巴示意看向道路前方。" voices=""/><stopbgm @l="1063" fadeout="1000"/><char @l="1066" id="nanak" pos="right" src="nanako014"/><msg @l="1068" char_id="-1" frame_id="-1" name="" text=":&#32;&#32;『啊！』"   voices="nanako00060"/><msg @l="1070" char_id="-1" frame_id="-1" name=""   text=":&#32;&#32;道路前方站着美帆的身影。" voices=""/><msg @l="1071" char_id="-1" frame_id="-1" name=""   text=":&#32;&#32;最后一次见面是几个月前的那一天———。" voices=""/><msg @l="1072" char_id="-1" frame_id="-1" name="" page_feed="true"   text="自从引导她去废弃道路以来。" voices=""/><clear @l="1078" class="all"/><page @l="1080" fade="300"/><label @l="1084" id="chart_line76"/><wait_chgmv/><ev @l="1088" src="ev-060"/><bgm @l="1092" src="bgm02" volume="1."/><msg @l="1094" char_id="-1" frame_id="-1" name="" text="『美帆！！』"   voices="nanako00070"/><msg @l="1096" char_id="-1" frame_id="-1" name=""   text=":&#32;&#32;『诶，奈那子……酱！？』" voices="miho13520"/><msg @l="1098" char_id="-1" frame_id="-1" name=""   text=":&#32;&#32;奈那子跑向美帆，突然抱住了她。" voices=""/><msg @l="1099" char_id="-1" frame_id="-1" name="" page_feed="true"   text="美帆接住奈那子的同时……脸上露出了惊讶的表情。" voices=""/><page @l="1102" fade="300"/><msg @l="1104" char_id="-1" frame_id="-1" name=""   text=":&#32;&#32;『这样的日子……要是能一直持续下去就好了。』" voices=""/><msg @l="1106" char_id="-1" frame_id="-1" name=""   text=":&#32;&#32;真弥望着她们俩的身影，若有所思地……轻声喃喃道。" voices=""/><msg @l="1107" char_id="-1" frame_id="-1" name="" page_feed="true"   text="带着寂寞与温柔交织的复杂表情……。" voices=""/><stopbgm @l="1111" fadeout="1000"/><clear @l="1115" class="all"/><page @l="1118" fade="300"/><msg @l="1122" char_id="-1" frame_id="-1" name="" page_feed="true"   text=":祈祷着她能够从疯狂的城市中安全逃脱后的人生……以及，我们今后的人生……能够平静祥和地延续下去———。"   voices=""/><page @l="1130" fade="300"/><clear @l="1132" class="char"/><msgshow @l="1134" show="false"/><wait_chgmv/><bg @l="1136" src="white" time="3000"/><clear @l="1138" class="ev"/><wait_chgmv/><bg @l="1140" src="white"/><wait @l="1142" time="6000"/><eval @l="1145" expr="s.event60flag=1&#13;&#10;"/><eval @l="1148"   expr="f.bEx&#32;=&#32;s.event20flag&#32;&amp;&amp;&#32;s.event23flag&#32;&amp;&amp;&#32;s.event25flag&#32;&amp;&amp;&#32;s.event30flag&#32;&amp;&amp;&#32;s.event31flag&#32;&amp;&amp;&#32;s.event32flag&#32;&amp;&amp;&#32;s.event33flag&#32;&amp;&amp;&#32;s.event35flag&#32;&amp;&amp;&#32;s.event37flag&#32;&amp;&amp;&#32;s.event38flag&#32;&amp;&amp;&#32;s.event60flag&#13;&#10;"/><goto @l="1150" cond="!(f.bEx)&#13;&#10;" label="TempLabel_324"/><eval @l="1152" expr="s.exRootFlag=1&#13;&#10;"/><label @l="1153" id="TempLabel_324"/><call @l="1155" target="EventLabel_155@staffroom"/><goto @l="1157" cond="!(f.bEx)&#13;&#10;" label="TempLabel_325"/><wait_chgmv/><bg @l="1161" src="newroot"/><wait @l="1163" time="5000"/><wait_chgmv/><bg @l="1165" src="black"/><label @l="1168" id="TempLabel_325"/><return @l="1174" value=""/></code></xscript>																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																		