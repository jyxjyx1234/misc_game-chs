<?xml version="1.0" encoding="utf-8"?><xscript><debug editor="&quot;C:\Program&#32;Files&#32;(x86)\sakura\sakura.exe&quot;&#32;&quot;%src%&quot;&#32;-Y=%line%"   src="D:\シロップ\町ぐるみの罠＋汚された夏セット版\汚された夏\完成データ\汚された夏\script\text\ending07.txt"/><code><label @l="13" id="EventLabel_45"/><description @l="17" text="破碎的齿轮"/><eval @l="19" expr="f.numDay=0&#13;&#10;"/><msg @l="21" char_id="-1" frame_id="-1" name=""   text="被公司员工轮奸的美帆和玲，就这样被监禁，接受各种取悦男人的技巧训练。" voices=""/><msg @l="22" char_id="-1" frame_id="-1" name=""   text="两人的阴道内和全身都被几十个男人的精液浸透，总是被白浊液体覆盖，最终被调教成了雌奴隶。"   voices=""/><msg @l="24" char_id="-1" frame_id="-1" name="" text="一个月后———"   voices=""/><wait_chgmv/><bg @l="28" src="bg17m1"/><bgm @l="32" src="bgm03" volume="1."/><msg @l="34" char_id="-1" frame_id="-1" name="" text="———某日·大黑建设公司办公室。"   voices=""/><msg @l="35" char_id="-1" frame_id="-1" name=""   text="办公室的时钟宣告上午工作时间结束，办公室各处传来带着疲劳的叹息声和伸展身体的声音。"   voices=""/><msg @l="37" char_id="-1" frame_id="-1" name="男员工A"   text="『嗯~……终于到午休了。那我去领取营业成绩优秀奖了。』" voices=""/><msg @l="39" char_id="-1" frame_id="-1" name=""   text="那个一直忙碌地敲击键盘的男人边伸展身体边嘀咕着，脸上因期待已久的时间到来而露出松弛的表情。" voices=""/><msg @l="41" char_id="-1" frame_id="-1" name="男员工B"   text="『你又要去啊？真好啊，我也想去一次啊。』" voices=""/><msg @l="43" char_id="-1" frame_id="-1" name="" text="旁边的男人一边打开便当盒一边说道。"   voices=""/><msg @l="45" char_id="-1" frame_id="-1" name="男员工A"   text="『那就得努力工作获得奖励啊。我为了拿这个奖可是付出了很大努力呢。』" voices=""/><msg @l="47" char_id="-1" frame_id="-1" name="男员工B"   text="『是是，知道了。我会努力的。对了，今天你打算选哪个？』" voices=""/><msg @l="49" char_id="-1" frame_id="-1" name="男员工A"   text="『该选哪个呢～啊，糟了！光是想象就硬了。』" voices=""/><msg @l="51" char_id="-1" frame_id="-1" name="男员工B"   text="『知道了，别在那炫耀了，快去好好享受吧。』" voices=""/><msg @l="52" char_id="-1" frame_id="-1" name="男员工A"   text="『嘿嘿，那我去尽情享受了。』" voices=""/><msg @l="54" char_id="-1" frame_id="-1" name="男员工B"   text="『哈哈，看他高兴地走了……』" voices=""/><msg @l="56" char_id="-1" frame_id="-1" name="男员工B"   text="『咦，你不是也拿到特别奖了吗？不去吗？』" voices=""/><msg @l="58" char_id="-1" frame_id="-1" name="男员工C"   text="『我的是另一个女孩啊。拿到特别奖的话可以从镇上女孩名单里指定喜欢的对象。所以今天我约了那个我一直暗恋的面包店女孩……嘿嘿。』"   voices=""/><msg @l="60" char_id="-1" frame_id="-1" name="男员工B"   text="『你也挺不错的啊。真让人羡慕！』" voices=""/><msg @l="62" char_id="-1" frame_id="-1" name="男员工C" text="『那我先走了。』"   voices=""/><msg @l="64" char_id="-1" frame_id="-1" name=""   text="就这样，那个男人站起身离开了办公室。" voices=""/><msg @l="65" char_id="-1" frame_id="-1" name=""   text="除了他之外，其他获得奖励的员工们也陆陆续续离开了办公室，看起来他们都是前往同一个地方。" voices=""/><msg @l="67" char_id="-1" frame_id="-1" name="男员工B"   text="『我也……好想和秘书部的女孩做啊……这个月得好好努力工作了……』" voices=""/><msg @l="69" char_id="-1" frame_id="-1" name=""   text="一边展开便当，留下的男人遗憾地喃喃自语着。" voices=""/><stopbgm @l="73" fadeout="1000"/><clear @l="79" class="all"/><label @l="82" id="event_scene32"/><msgshow @l="85" show="true"/><bgm @l="89" src="bgm14" volume="1."/><msg @l="91" char_id="0" frame_id="-1" name="美帆" text="『嗯，啊啊……！！』"   voices="miho11640"/><msg @l="93" char_id="-1" frame_id="-1" name=""   text="在狭小的空间里，我的喘息声清晰地回荡着。" voices=""/><msg @l="94" char_id="-1" frame_id="-1" name=""   text="我……从那以后几乎每天都被侵犯。" voices=""/><msg @l="95" char_id="-1" frame_id="-1" name=""   text="数十个男人轮番侵犯我，发泄欲望，而每一次我都被带到不情愿的高潮。" voices=""/><msg @l="96" char_id="-1" frame_id="-1" name="" text="大概是从几天前开始吧……"   voices=""/><msg @l="97" char_id="-1" frame_id="-1" name=""   text="被这样蹂躏的每一天不再让我感到痛苦了。" voices=""/><msg @l="98" char_id="-1" frame_id="-1" name=""   text="渐渐地，我开始说出渴望交合的话语，声音中也开始混入妩媚的喘息。" voices=""/><msg @l="99" char_id="-1" frame_id="-1" name=""   text="每当这时，男人们就会辱骂我为“母猪”，然后在我体内射出大量精液。" voices=""/><msg @l="101" char_id="-1" frame_id="-1" name="真岛"   text="『那么，你从明天开始就变成厕所了。』" voices=""/><msg @l="103" char_id="-1" frame_id="-1" name=""   text="就这样简单的一句话，我成为了接受男人们精液的“厕所”。" voices=""/><msg @l="104" char_id="-1" frame_id="-1" name="" text="日复一日地被轻蔑，被注入滚烫的精液。"   voices=""/><msg @l="105" char_id="-1" frame_id="-1" name=""   text="即使在这样的耻辱中，我的大脑也在融化……我发出喘息声。" voices=""/><msg @l="107" char_id="-1" frame_id="-1" name="真岛"   text="『这可不是普通的厕所，是连社长都会使用的精英专用高级厕所啊。』" voices=""/><label @l="111" id="chart_line39"/><wait_chgmv/><ev @l="115" src="ev-032"/><msg @l="117" char_id="-1" frame_id="-1" name=""   text="大黑建设最高层的一角有几个厕所，其中一个似乎就是我的工作场所。" voices=""/><msg @l="118" char_id="-1" frame_id="-1" name=""   text="在这里，只有业绩优秀的人才被允许使用这个厕所。" voices=""/><msg @l="119" char_id="-1" frame_id="-1" name=""   text="美帆全身被粗绳捆绑，绳子深深勒进她柔嫩的肌肤。她还被固定在台座上，双腿大开，随时准备接纳男人们的肉棒。"   voices=""/><msg @l="120" char_id="-1" frame_id="-1" name=""   text="不愧是高级厕所，我的仪表总是保持干净整洁，但关于食物，除了每周提供一次之外，我不被允许把精液以外的东西放入口中。"   voices=""/><msg @l="122" char_id="1" frame_id="-1" name="玲" text="『嗯嗯……啊，呜啊！！』"   voices="rei02660"/><msg @l="124" char_id="-1" frame_id="-1" name="" text="透过薄薄的墙壁，传来了另一个娇媚的呻吟声。"   voices=""/><msg @l="126" char_id="0" frame_id="-1" name="美帆" text="（啊……隔壁也开始了啊）"   voices="miho11650"/><msg @l="128" char_id="-1" frame_id="-1" name=""   text="隔壁厕所的人……呃……是谁来着……" voices=""/><msg @l="129" char_id="-1" frame_id="-1" name=""   text="我在沉浸在愉悦中的脑海一角模糊地思考着，但这想法很快就消失了。" voices=""/><msg @l="130" char_id="-1" frame_id="-1" name="" text="……无所谓了。" voices=""/><msg @l="131" char_id="-1" frame_id="-1" name=""   text="现在我只想沉醉于在体内搅动的灼热肉棒的触感。" voices=""/><msg @l="133" char_id="-1" frame_id="-1" name=""   text="美帆隔壁的是身体被菱形束缚带绑住，双手被手铐拘束着的玲。" voices=""/><msg @l="134" char_id="-1" frame_id="-1" name=""   text="玲仿佛是自己渴求男人的肉棒一般，以骑在男人身上的姿势，将肉棒插入自己的秘缝中。" voices=""/><msg @l="136" char_id="0" frame_id="-1" name="美帆"   text="『呃啊……顶到深处了……嗯，啊呜！』" voices="miho11660"/><msg @l="138" char_id="-1" frame_id="-1" name=""   text="似乎是意识到透过墙壁传来的娇声，贯穿我下体的热棒更加用力地顶向了我阴道深处。" voices=""/><msg @l="139" char_id="-1" frame_id="-1" name=""   text="每当那硕大且棱角分明的龟头撑开深处的褶皱，一种麻痹般的甜美快感就会传遍子宫。" voices=""/><msg @l="141" char_id="-1" frame_id="-1" name="男员工D"   text="『太棒了……不愧是精英专用便器，平时努力取得好成绩真值啊！哇，感觉要被榨干了！』" voices=""/><msg @l="143" char_id="-1" frame_id="-1" name=""   text="男人一边发出尖锐的声音，一边专心致志地搅动着我的私处。" voices=""/><msg @l="144" char_id="-1" frame_id="-1" name=""   text="允许这样侵犯我的时间好像只有特定的一部分，那些来注入精液的男人们总是无意识地摆动着腰部。" voices=""/><msg @l="145" char_id="-1" frame_id="-1" name=""   text="他们只优先考虑自己的释放，对作为便器的我没有丝毫的体贴。" voices=""/><msg @l="146" char_id="-1" frame_id="-1" name=""   text="这只是简单的排泄行为，不断地重复着。" voices=""/><msg @l="148" char_id="0" frame_id="-1" name="美帆"   text="『啊啊……嗯，啊，啊，啊，唔呃！』" voices="miho11670"/><msg @l="150" char_id="0" frame_id="-1" name="美帆"   text="『深处，深处被摩擦了……嗯，啊啊啊啊！！！』" voices="miho11680"/><flash @l="154" count="4" fade="100" image="white"/><msg @l="156" char_id="0" frame_id="-1" name="美帆" text="『嗯、啊啊啊啊啊啊啊！！』"   voices="miho11040"/><msg @l="158" char_id="-1" frame_id="-1" name=""   text="在剧烈的律动冲击下，我达到了高潮。" voices=""/><msg @l="159" char_id="-1" frame_id="-1" name=""   text="这已经是今天第几十次绝顶了，我已经记不清了。" voices=""/><msg @l="160" char_id="-1" frame_id="-1" name=""   text="眼前仿佛闪光般一片雪白，随后一种迟钝的麻痹感从后脑勺开始蔓延，让我对一切都变得无所谓。"   voices=""/><msg @l="162" char_id="-1" frame_id="-1" name="男员工D" text="『哦哦…啊，好紧！！』"   voices=""/><msg @l="164" char_id="-1" frame_id="-1" name=""   text="正当我攀登高潮的阶梯时，痉挛般收缩的阴道壁引导着男人也达到了顶点，将热液注入我的阴道内。"   voices=""/><msg @l="165" char_id="-1" frame_id="-1" name=""   text="他将腰部尽可能地压向我，让前端尽量深入到最深处。" voices=""/><msg @l="166" char_id="-1" frame_id="-1" name=""   text="甚至仿佛要强行撑开子宫口，将所有精液都灌注到那深处一般。" voices=""/><msg @l="168" char_id="0" frame_id="-1" name="美帆" text="『嗯…。』"   voices="miho11690"/><msg @l="170" char_id="-1" frame_id="-1" name=""   text="随着体内深处被热液填满的触感，我的快感更加加速。" voices=""/><msg @l="171" char_id="-1" frame_id="-1" name=""   text="与不断重复的脉动一起注入的热液，将快要平息的高潮浪潮再次唤回，让我融化在其中。" voices=""/><msg @l="173" char_id="-1" frame_id="-1" name="男员工D"   text="『太厉害了…还在纠缠不休啊。』" voices=""/><msg @l="175" char_id="-1" frame_id="-1" name=""   text="射精后的男人仍然贯穿着我的身体，腰部微微颤抖。" voices=""/><msg @l="176" char_id="-1" frame_id="-1" name=""   text="他正陶醉于我的阴道壁随着一波波高潮的涌来而蠕动的触感。" voices=""/><msg @l="178" char_id="-1" frame_id="-1" name="男员工A"   text="『喂，后面还排着队呢。』" voices=""/><msg @l="180" char_id="-1" frame_id="-1" name="男员工D" text="『啧…知道了啦。』"   voices=""/><msg @l="182" char_id="-1" frame_id="-1" name=""   text="对那个迟迟不愿离开“便器”前面的男人，排在他身后的男人表示不满。" voices=""/><msg @l="183" char_id="-1" frame_id="-1" name=""   text="我这才注意到，这个狭小的房间里已经挤满了好几个男人，他们都急不可耐地盯着这边。" voices=""/><msg @l="185" char_id="0" frame_id="-1" name="美帆"   text="（啊哈……那边的人，已经因为前液变得湿滑了）" voices="miho11700"/><msg @l="187" char_id="0" frame_id="-1" name="美帆"   text="（那边的人还没什么精神……希望能快点硬起来）" voices="miho11710"/><msg @l="189" char_id="-1" frame_id="-1" name=""   text="在意识模糊的快感中，我望着那些前来泄欲的男人们的胯部，脸上浮现出欣喜的表情。" voices=""/><msg @l="190" char_id="-1" frame_id="-1" name="" text="还没结束……" voices=""/><msg @l="191" char_id="-1" frame_id="-1" name=""   text="想到这愉悦的时光还将继续，我发热的身体深处分泌出大量蜜液，从秘处溢了出来。"   voices=""/><msg @l="193" char_id="-1" frame_id="-1" name="大黑" text="『哎呀哎呀，隔壁真激烈啊。』"   voices=""/><msg @l="195" char_id="-1" frame_id="-1" name="" text="就在薄薄的墙壁阻隔的近处。"   voices=""/><msg @l="196" char_id="-1" frame_id="-1" name=""   text="大黑一边缓缓在玲的体内进出，一边低声呢喃道。" voices=""/><msg @l="198" char_id="1" frame_id="-1" name="玲" text="『嗯唔……嗯，啊啊啊……』"   voices="rei02670"/><msg @l="200" char_id="-1" frame_id="-1" name=""   text="玲对大黑这种不痛不痒的律动发出不满的呻吟，扭动着腰肢，仿佛在恳求他激烈地占有自己。" voices=""/><msg @l="201" char_id="-1" frame_id="-1" name=""   text="尽管仅仅是这种缓慢的抽插动作就已经让玲高潮了三次，但大黑却还一次都没有释放。"   voices=""/><msg @l="203" char_id="1" frame_id="-1" name="玲"   text="『啊啊……喂，求你了……快点射啊……』" voices="rei02680"/><msg @l="205" char_id="-1" frame_id="-1" name=""   text="玲发出撒娇又带点赌气的声音，乞求射精。" voices=""/><msg @l="206" char_id="-1" frame_id="-1" name=""   text="就在几天前，根本无法想象她会主动说出催促射精的话语。" voices=""/><msg @l="207" char_id="-1" frame_id="-1" name="" text="但那都是过去的事了。"   voices=""/><msg @l="208" char_id="-1" frame_id="-1" name=""   text="曾经彰显理性与尊严的双眸，如今只浮现着渴望被侵犯的情感。" voices=""/><msg @l="210" char_id="1" frame_id="-1" name="玲"   text="『求你了……又热又浓的精液……请……大量射在最深处。』" voices="rei02690"/><msg @l="212" char_id="-1" frame_id="-1" name=""   text="玲猛烈地摆动着腰肢，声音颤抖着。" voices=""/><msg @l="213" char_id="-1" frame_id="-1" name=""   text="第四次高潮，大概就要来临了吧。" voices=""/><msg @l="215" char_id="-1" frame_id="-1" name="大黑"   text="『呵呵，没想到那个美丽高贵的“玲小姐”竟会说出这种话啊。』" voices=""/><msg @l="217" char_id="-1" frame_id="-1" name="大黑"   text="『那个拒绝了无数表白却依然人气爆棚的“玲小姐”现在竟在做这种事……同学们肯定谁都想象不到吧。』"   voices=""/><msg @l="219" char_id="1" frame_id="-1" name="玲"   text="『啊啊……嗯，啊呜……啊，啊，嗯啊啊！！』" voices="rei02280"/><msg @l="221" char_id="-1" frame_id="-1" name="大黑"   text="『呵呵，你已经听不懂我说的话了吗……』" voices=""/><msg @l="223" char_id="-1" frame_id="-1" name=""   text="大黑就这样从下方猛烈地顶弄着玲的蜜穴。" voices=""/><msg @l="225" char_id="1" frame_id="-1" name="玲"   text="『啊……啊……嗯，嗯，嗯，啊啊好棒！！』" voices="rei02700"/><msg @l="227" char_id="-1" frame_id="-1" name=""   text="每次被猛烈顶弄时，玲那丰满的乳房剧烈摇晃，同时发出甜美的喘息声。" voices=""/><msg @l="228" char_id="-1" frame_id="-1" name=""   text="她的表情沉浸在愉悦中，松弛的嘴角有唾液滴落，形成了一道水痕。" voices=""/><msg @l="230" char_id="-1" frame_id="-1" name="大黑"   text="『这就是你的报应，玲小姐。曾经用看虫子般的眼神看我的你，现在却骑在我身上浪叫呢。』"   voices=""/><msg @l="232" char_id="-1" frame_id="-1" name=""   text="大黑一边从下方顶弄研磨，一边用手指揉弄她的秘芯。那已经完全充血的女性核心变得异常敏感，稍微触碰就会让人眼冒金星。"   voices=""/><msg @l="234" char_id="1" frame_id="-1" name="玲"   text="『啊啊，不行，嗯……啊啊啊！！』" voices="rei02380"/><msg @l="236" char_id="1" frame_id="-1" name="玲"   text="『不要，那里……嗯嗯……不要，那样顶上来……』" voices="rei02450"/><msg @l="238" char_id="-1" frame_id="-1" name="大黑"   text="『哦，每次顶到深处，整个阴道都紧紧地收缩呢？』" voices=""/><msg @l="240" char_id="1" frame_id="-1" name="玲"   text="『还、还要……啊，要去了……要去了……嗯嗯嗯！！』" voices="rei02300"/><msg @l="242" char_id="-1" frame_id="-1" name="大黑"   text="『你已经只是个公共厕所了。那么就让我在这厕所里，把精液满满地灌进你的子宫吧。』" voices=""/><msg @l="244" char_id="-1" frame_id="-1" name=""   text="大黑在玲耳边说着可怕的话，同时更加用力地向上顶弄着腰部。" voices=""/><msg @l="245" char_id="-1" frame_id="-1" name=""   text="从两人结合处，被肉棒挤出的爱液大量溢出，在地板上形成了几处黑色的痕迹。" voices=""/><msg @l="247" char_id="1" frame_id="-1" name="玲"   text="『啊，啊，啊，啊……不行，不行……啊，啊啊！！』" voices="rei02290"/><msg @l="249" char_id="-1" frame_id="-1" name=""   text="玲疯狂地喘息着。这究竟是对内射的拒绝，还是对即将到来的高潮的反应，已经分不清了。" voices=""/><msg @l="250" char_id="-1" frame_id="-1" name=""   text="这时，从墙的另一边，传来了美帆颤抖的声音。" voices=""/><msg @l="252" char_id="0" frame_id="-1" name="美帆"   text="『啊……啊啊………啊，啊，啊………嗯，呜啊啊！』" voices="miho10390"/><msg @l="254" char_id="0" frame_id="-1" name="美帆"   text="『啊，啊，啊……要去了，要去了………啊啊啊！！』" voices="miho11720"/><msg @l="256" char_id="-1" frame_id="-1" name=""   text="大黑听到这声音后嘴角扭曲成一抹奸笑，为了配合隔壁的节奏，他的腰部动作变得更加快速。" voices=""/><msg @l="257" char_id="-1" frame_id="-1" name="" text="……看来是想一起结束。"   voices=""/><msg @l="259" char_id="1" frame_id="-1" name="玲"   text="『啊啊啊……啊，最深处，顶得好厉害……嗯，啊啊！！』" voices="rei02710"/><msg @l="261" char_id="0" frame_id="-1" name="美帆"   text="『嗯嗯，嗯，嗯，嗯，嗯……不行，不行啊！！』" voices="miho11730"/><msg @l="263" char_id="0" frame_id="-1" name="美帆"   text="『啊，啊啊啊啊……那么深……不行，啊，头……要变得……奇怪了……嗯……啊啊！！』"   voices="miho10410"/><msg @l="265" char_id="-1" frame_id="-1" name=""   text="隔着薄薄的墙壁，玲和美帆的声音高昂地响彻着。" voices=""/><msg @l="266" char_id="-1" frame_id="-1" name=""   text="彼此被对方的喘息声刺激着，引发更强烈的兴奋。" voices=""/><msg @l="268" char_id="-1" frame_id="-1" name="大黑"   text="『我会射给你满满的……然后你就怀上那个曾被你用看虫子般眼神看待的我的孩子吧！』" voices=""/><msg @l="270" char_id="1" frame_id="-1" name="玲"   text="『啊啊啊，不行，嗯……啊啊啊啊！！』" voices="rei02380"/><msg @l="272" char_id="1" frame_id="-1" name="玲"   text="『啊啊……来了……去了，去了去了去了……啊，啊啊啊啊啊啊！！』" voices="rei02720"/><msg @l="274" char_id="0" frame_id="-1" name="美帆"   text="『射进来吧，把浓浓的精液全部射到里面来……。』" voices="miho12010"/><msg @l="276" char_id="0" frame_id="-1" name="美帆" text="『嗯，啊啊啊啊啊啊啊！！』"   voices="miho11040"/><flash @l="280" count="4" fade="100" image="white"/><msg @l="282" char_id="0" frame_id="-1" name="美帆"   text="『去了……去了，啊啊……出来了……在肚子里面满满地出来了！……啊，啊，嗯啊啊！！！』"   voices="miho11740"/><flash @l="286" count="4" fade="100" image="white"/><wait_chgmv/><ev @l="290" src="ev-032z1"/><msg @l="292" char_id="-1" frame_id="-1" name="" text="———两人的喘息声交织在一起，随即爆发。"   voices=""/><msg @l="293" char_id="-1" frame_id="-1" name=""   text="玲和美帆的阴道内分别灌入了大量的精液，当男根抽出时，精液如同缠绕着它一般溢了出来。" voices=""/><msg @l="295" char_id="1" frame_id="-1" name="玲"   text="『嗯……啊，啊………热热的东西……流进来了………。』" voices="rei01570"/><msg @l="297" char_id="1" frame_id="-1" name="玲"   text="『嗯……啊啊……精液……好多……。』" voices="rei02730"/><msg @l="299" char_id="-1" frame_id="-1" name=""   text="余韵中颤抖着的玲的腰部剧烈震颤，从结合部位稍上方，黄色的液体渗漏出来。" voices=""/><msg @l="301" char_id="-1" frame_id="-1" name="" text="噗哧啊啊啊啊啊啊啊啊啊啊啊啊啊啊"   voices=""/><msg @l="303" char_id="-1" frame_id="-1" name=""   text="那液体猛烈地涌出，没能全部落入大黑坐着的马桶中，溅起水花散落在地板上。" voices=""/><msg @l="305" char_id="-1" frame_id="-1" name="大黑"   text="『哎呀哎呀，不仅高潮得这么夸张，还尿了出来吗……。』" voices=""/><msg @l="307" char_id="-1" frame_id="-1" name="大黑"   text="『真是的……这就是作为便器自觉不够的证据呢。』" voices=""/><msg @l="309" char_id="-1" frame_id="-1" name="大黑"   text="『对了，我想到一件好事。』" voices=""/><msg @l="311" char_id="-1" frame_id="-1" name="大黑"   text="『下次同学会时就穿成这样去吧。然后在你曾经憧憬的同学面前像刚才那样尿出来。』" voices=""/><msg @l="313" char_id="-1" frame_id="-1" name="大黑"   text="『……大家会露出什么表情呢……真令人期待啊……呵呵呵。』" voices=""/><msg @l="315" char_id="-1" frame_id="-1" name=""   text="大黑愉快地眯起眼睛，说着这些话的同时舔舐着玲的颈部。" voices=""/><msg @l="316" char_id="-1" frame_id="-1" name=""   text="玲……一边听着大黑的话，一边保持着恍惚的表情，黄色的液体仍在不停地喷溅着。" voices=""/><stopbgm @l="320" fadeout="1000"/><clear @l="326" class="all"/><end_scene @l="329"/><eval @l="333" expr="s.flagGallery=1&#13;&#10;"/><eval @l="335" expr="s.event32flag=1&#13;&#10;"/><eval @l="339"   expr="f.bEx&#32;=&#32;s.event20flag&#32;&amp;&amp;&#32;s.event23flag&#32;&amp;&amp;&#32;s.event25flag&#32;&amp;&amp;&#32;s.event30flag&#32;&amp;&amp;&#32;s.event31flag&#32;&amp;&amp;&#32;s.event32flag&#32;&amp;&amp;&#32;s.event33flag&#32;&amp;&amp;&#32;s.event35flag&#32;&amp;&amp;&#32;s.event37flag&#32;&amp;&amp;&#32;s.event38flag&#32;&amp;&amp;&#32;s.event60flag&#13;&#10;"/><goto @l="341" cond="!(f.bEx)&#13;&#10;" label="TempLabel_241"/><eval @l="343" expr="s.exRootFlag=1&#13;&#10;"/><label @l="344" id="TempLabel_241"/><ending @l="346"/><goto @l="348" cond="!(f.bEx)&#13;&#10;" label="TempLabel_242"/><wait_chgmv/><bg @l="352" src="newroot"/><wait @l="354" time="5000"/><wait_chgmv/><bg @l="356" src="black"/><label @l="359" id="TempLabel_242"/><return @l="363" value=""/></code></xscript>																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																						