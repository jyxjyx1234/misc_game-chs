<?xml version="1.0" encoding="utf-8"?><xscript><debug editor="&quot;C:\Program&#32;Files&#32;(x86)\sakura\sakura.exe&quot;&#32;&quot;%src%&quot;&#32;-Y=%line%"   src="D:\シロップ\町ぐるみの罠＋汚された夏セット版\汚された夏\完成データ\汚された夏\script\text\root_rei05b.txt"/><code><label @l="12" id="EventLabel_143"/><description @l="16" text="室友的忧郁·第5天(B)"/><eval @l="18" expr="f.numDay=13&#13;&#10;"/><msgshow @l="20" show="false"/><wait_chgmv/><bg @l="22" src="day13" time="2000"/><wait @l="24" time="500"/><wait_chgmv/><bg @l="26" src="black" time="2000"/><msgshow @l="28" show="true"/><wait_chgmv/><bg @l="32" src="bg01c"/><bgm @l="36" src="bgm03" volume="1."/><msg @l="38" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="40" char_id="-1" frame_id="-1" name="" text="那晚过去已经两天了。"   voices=""/><msg @l="41" char_id="-1" frame_id="-1" name=""   text="那个被朽木教授强奸失去贞操的夜晚———。" voices=""/><msg @l="42" char_id="-1" frame_id="-1" name=""   text="尽管遭受了不讲理的蹂躏，我最终还是没能控告朽木教授。" voices=""/><msg @l="43" char_id="-1" frame_id="-1" name=""   text="本该依靠的警察也不肯正经对待我的事，可除此之外又没有其他求助之处……" voices=""/><msg @l="44" char_id="-1" frame_id="-1" name=""   text="我只能拿房间里的毛绒玩具撒气，然后一直哭泣。" voices=""/><msg @l="46" char_id="-1" frame_id="-1" name=""   text="究竟是哪里做错了，为什么总是我一个人遭遇这种事。" voices=""/><msg @l="47" char_id="-1" frame_id="-1" name=""   text="独自一人在房间里，茫然地望着墙壁和天花板……" voices=""/><msg @l="50" char_id="0" frame_id="-1" name="美帆" text="『玲小姐……不知道她现在怎么样了？』"   voices=""/><msg @l="52" char_id="-1" frame_id="-1" name="" text="我用嘶哑的声音轻声嘀咕着。"   voices=""/><msg @l="53" char_id="-1" frame_id="-1" name="" text="那之后，玲小姐一直没有回来。"   voices=""/><msg @l="54" char_id="-1" frame_id="-1" name=""   text="当然，我也并不是整天都醒着，说不定她在我睡着的时候已经回来过了……。"   voices=""/><msg @l="55" char_id="-1" frame_id="-1" name=""   text="难道真如朽木教授所说，她身上发生了什么不好的事情吗？" voices=""/><msg @l="56" char_id="-1" frame_id="-1" name="" text="还是说……" voices=""/><wait_chgmv/><bg @l="60" src="bg03c"/><char @l="64" id="miho" pos="auto" src="miho136"/><msg @l="66" char_id="0" frame_id="-1" name="美帆" text="『………。』" voices=""/><msg @l="68" char_id="-1" frame_id="-1" name=""   text="感到一丝饥饿，我慢吞吞地走出房间，前往客厅。" voices=""/><msg @l="69" char_id="-1" frame_id="-1" name=""   text="说起来，自从昨晚稍微吃了点东西后，就一直没再进食了。" voices=""/><clear @l="73" class="char"/><msg @l="75" char_id="-1" frame_id="-1" name=""   text="我走进厨房，也没开灯就打开了冰箱门。" voices=""/><msg @l="76" char_id="-1" frame_id="-1" name=""   text="因为没去购物，冰箱里空空如也。" voices=""/><msg @l="77" char_id="-1" frame_id="-1" name=""   text="我正打算煎个鸡蛋，伸手去拿那包已经开封的鸡蛋时……。" voices=""/><se @l="81" buf="1" src="扉を開ける音_木製" volume="1."/><stopbgm @l="85" fadeout="1000"/><char @l="89" id="miho" pos="auto" src="miho134"/><msg @l="91" char_id="0" frame_id="-1" name="美帆" text="『……！？』" voices=""/><char @l="94" id="miho" pos="auto" src="miho135"/><msg @l="96" char_id="-1" frame_id="-1" name=""   text="突然听到客厅的门被打开的声音，我慌忙转身。" voices=""/><msg @l="97" char_id="-1" frame_id="-1" name=""   text="那晚的恐惧重新袭来，双腿微微颤抖着。" voices=""/><char @l="101" id="rei" pos="auto" src="rei125"/><bgm @l="105" src="bgm03" volume="1."/><msg @l="107" char_id="1" frame_id="-1" name="玲" text="『………。』" voices=""/><msg @l="109" char_id="0" frame_id="-1" name="美帆" text="『啊……玲小姐……。』"   voices=""/><msg @l="111" char_id="-1" frame_id="-1" name=""   text="站在我转身处的是玲小姐。" voices=""/><msg @l="112" char_id="-1" frame_id="-1" name=""   text="两天未见的她看起来异常憔悴，脸色很差。" voices=""/><msg @l="114" char_id="0" frame_id="-1" name="美帆" text="『………。』" voices=""/><msg @l="116" char_id="-1" frame_id="-1" name="" text="我说不出话来。" voices=""/><msg @l="117" char_id="-1" frame_id="-1" name="" text="我不知道该说什么好。"   voices=""/><msg @l="118" char_id="-1" frame_id="0" name="" text="「两天没回来，您怎么了？」"   voices=""/><msg @l="119" char_id="-1" frame_id="0" name=""   text="「是不是发生了什么麻烦事？」" voices=""/><msg @l="120" char_id="-1" frame_id="0" name="" text="「我被朽木教授强奸了……。」"   voices=""/><msg @l="121" char_id="-1" frame_id="-1" name="" text="这些话都说不出口。"   voices=""/><msg @l="122" char_id="-1" frame_id="-1" name=""   text="明明就在几天前我们还住在同一个地方，甚至我已经把她当成了家人。" voices=""/><msg @l="123" char_id="-1" frame_id="-1" name=""   text="不知何时，连接我们的纽带已经断裂了……。" voices=""/><msg @l="125" char_id="1" frame_id="-1" name="玲" text="『……只是回来拿换洗衣服。』"   voices=""/><msg @l="127" char_id="1" frame_id="-1" name="玲" text="『我想，我又要有一段时间不回来了。』"   voices=""/><clear @l="131" class="char"/><char @l="135" id="miho" pos="auto" src="miho034"/><msg @l="137" char_id="0" frame_id="-1" name="美帆" text="『啊……？』" voices=""/><msg @l="139" char_id="-1" frame_id="-1" name=""   text="她只说了这一句话，便从站在厨房入口的我面前径直走过，朝着自己的房间走去。" voices=""/><char @l="143" id="miho" pos="auto" src="miho135"/><msg @l="145" char_id="0" frame_id="-1" name="美帆" text="（……玲，果然发生了什么事）"   voices=""/><msg @l="147" char_id="0" frame_id="-1" name="美帆"   text="（但是……就算问了，我恐怕也帮不上忙……）" voices=""/><msg @l="149" char_id="0" frame_id="-1" name="美帆"   text="（只要逝去的时间无法挽回……什么也……）" voices=""/><char @l="153" id="rei" pos="auto" src="rei125"/><msg @l="155" char_id="-1" frame_id="-1" name=""   text="从房间里出来的玲小姐手里拿着一个大波士顿包。" voices=""/><msg @l="156" char_id="-1" frame_id="-1" name=""   text="里面装的应该是她刚才提到的换洗衣物。" voices=""/><msg @l="158" char_id="1" frame_id="-1" name="玲" text="『………。』" voices=""/><clear @l="162" class="char"/><msg @l="164" char_id="-1" frame_id="-1" name=""   text="玲小姐瞥了我一眼，然后直接走向玄关。" voices=""/><char @l="168" id="miho" pos="auto" src="miho135"/><msg @l="172" async="true" char_id="-1" frame_id="-1" name=""   text="面对默默无言准备离开的玲……？" voices=""/><select @l="173"><menu @l="177" label="EventLabel_144" text="叫住她"/><menu @l="180" label="EventLabel_145" text="不叫住她"/></select><label @l="189" id="EventLabel_144"/><char @l="193" id="miho" pos="auto" src="miho035"/><msg @l="195" char_id="0" frame_id="-1" name="美帆" text="『请等一下！』"   voices=""/><msg @l="197" char_id="-1" frame_id="-1" name=""   text="虽然我知道这可能是多余的举动，但我还是不由自主地叫住了玲小姐。" voices=""/><msg @l="198" char_id="-1" frame_id="-1" name="" text="当然，我并没有什么具体的想法。"   voices=""/><msg @l="199" char_id="-1" frame_id="-1" name=""   text="只是，如果就这样什么都不做的话……我们之间的羁绊就会彻底消失———。" voices=""/><msg @l="200" char_id="-1" frame_id="-1" name="" text="我这样想着。" voices=""/><clear @l="203" class="char"/><char @l="205" id="miho" pos="left" src="miho035"/><char @l="208" id="rei" pos="right" src="rei125"/><msg @l="210" char_id="1" frame_id="-1" name="玲" text="『……什么事？』" voices=""/><msg @l="212" char_id="-1" frame_id="-1" name=""   text="玲小姐手扶在客厅的门上，没有转身就回答了我。" voices=""/><msg @l="213" char_id="-1" frame_id="-1" name=""   text="她的表情与其说是烦躁……不如说是笼罩在寂寞之中。" voices=""/><char @l="217" id="miho" pos="left" src="miho035"/><msg @l="219" char_id="0" frame_id="-1" name="美帆" text="『玲小姐……会回来的吧？』"   voices=""/><msg @l="221" char_id="0" frame_id="-1" name="美帆" text="『一定会回来的，对吗？』"   voices=""/><msg @l="223" char_id="1" frame_id="-1" name="玲" text="『……。』" voices=""/><msg @l="225" char_id="1" frame_id="-1" name="玲" text="『……不知道。』" voices=""/><msg @l="227" char_id="1" frame_id="-1" name="玲"   text="『而且，这与你无关……。』" voices=""/><char @l="231" id="miho" pos="left" src="miho034"/><msg @l="233" char_id="0" frame_id="-1" name="美帆" text="『无关……怎么会！』"   voices=""/><char @l="236" id="miho" pos="left" src="miho035"/><msg @l="238" char_id="0" frame_id="-1" name="美帆"   text="『我们是室友啊，对吗？ 对吧？』" voices=""/><msg @l="240" char_id="1" frame_id="-1" name="玲" text="『……那又怎样？』"   voices=""/><char @l="243" id="rei" pos="right" src="rei017"/><msg @l="245" char_id="1" frame_id="-1" name="玲"   text="『就因为是室友，是同居人就能怎样！』" voices=""/><char @l="249" id="miho" pos="left" src="miho135"/><msg @l="251" char_id="0" frame_id="-1" name="美帆" text="『啊……。』" voices=""/><char @l="254" id="rei" pos="right" src="rei125"/><msg @l="256" char_id="1" frame_id="-1" name="玲"   text="『这不过是大学方面擅自决定的……到头来只是陌生人……而已。』" voices=""/><char @l="260" id="miho" pos="left" src="miho034"/><msg @l="262" char_id="0" frame_id="-1" name="美帆"   text="『不对……怎么会……怎么可能是陌生人……我对玲小姐……。』" voices=""/><char @l="266" id="rei" pos="right" src="rei017"/><msg @l="268" char_id="1" frame_id="-1" name="玲" text="『别再说漂亮话了！！』"   voices=""/><char @l="271" id="miho" pos="left" src="miho035"/><msg @l="273" char_id="0" frame_id="-1" name="美帆" text="『……！？』" voices=""/><char @l="277" id="rei" pos="right" src="rei125"/><msg @l="279" char_id="1" frame_id="-1" name="玲" text="『拜托……。』" voices=""/><msg @l="281" char_id="1" frame_id="-1" name="玲" text="『请不要再和我有任何瓜葛了……。』"   voices=""/><clear @l="285" layer="rei"/><char @l="288" id="miho" pos="left" src="miho134"/><msg @l="290" char_id="0" frame_id="-1" name="美帆" text="『啊……。』" voices=""/><msg @l="292" char_id="-1" frame_id="-1" name=""   text="玲小姐像是要甩开一切似的离开了房间。" voices=""/><msg @l="293" char_id="-1" frame_id="-1" name="" text="仿佛……是在逃避我一样。"   voices=""/><msg @l="295" char_id="0" frame_id="-1" name="美帆" text="『玲小姐！』" voices=""/><clear @l="301" class="all"/><wait_chgmv/><bg @l="305" src="bg05b"/><char @l="309" id="miho" pos="auto" src="miho135"/><msg @l="311" char_id="-1" frame_id="-1" name="" text="我追着玲小姐跑出了外面。"   voices=""/><msg @l="312" char_id="-1" frame_id="-1" name=""   text="明明之前我试了很多次想往外走，双脚却不听使唤，现在却像没事一样能动了。" voices=""/><msg @l="313" char_id="-1" frame_id="-1" name="" text="为什么会这样，我不知道。"   voices=""/><msg @l="314" char_id="-1" frame_id="-1" name=""   text="只是，我必须去……这么想着。" voices=""/><msg @l="316" char_id="0" frame_id="-1" name="美帆" text="（玲在……？）" voices=""/><msg @l="318" char_id="-1" frame_id="-1" name="" text="走廊上没有她的身影。"   voices=""/><msg @l="319" char_id="-1" frame_id="-1" name=""   text="我猛地跑到电梯前，电梯已经载着玲小姐开始向一楼移动了。" voices=""/><char @l="322" id="miho" pos="auto" src="miho035"/><msg @l="324" char_id="0" frame_id="-1" name="美帆" text="『啧……。』" voices=""/><clear @l="328" class="char"/><msg @l="330" char_id="-1" frame_id="-1" name="" text="我立刻朝楼梯跑去。"   voices=""/><msg @l="331" char_id="-1" frame_id="-1" name=""   text="对各种田径运动都不擅长的我，肯定比电梯慢多了。" voices=""/><msg @l="332" char_id="-1" frame_id="-1" name=""   text="但是，我既不能只是沉默地看着，也不能……放弃。" voices=""/><msg @l="334" char_id="0" frame_id="-1" name="美帆" text="『哈……哈……哈……。』"   voices=""/><msg @l="336" char_id="-1" frame_id="-1" name=""   text="我下楼梯，喘着粗气穿过公寓的出口。" voices=""/><msg @l="338" char_id="1" frame_id="-1" name="玲" text="『……。』" voices=""/><msg @l="340" char_id="-1" frame_id="-1" name=""   text="刚出门的瞬间，我隐约看到了玲小姐的背影。" voices=""/><msg @l="341" char_id="-1" frame_id="-1" name="" text="看来她似乎是打算前往车站。"   voices=""/><msg @l="343" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="345" char_id="0" frame_id="-1" name="美帆" text="（玲……）" voices=""/><msg @l="347" char_id="-1" frame_id="-1" name=""   text="我也……跟随着玲小姐的背影，走了过去。" voices=""/><clear @l="353" class="all"/><wait_chgmv/><bg @l="357" src="bg18b"/><char @l="361" id="rei" pos="auto" src="rei115"/><msg @l="363" char_id="1" frame_id="-1" name="玲" text="『……。』" voices=""/><clear @l="367" class="char"/><char @l="371" id="miho" pos="auto" src="miho135"/><msg @l="373" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="375" char_id="-1" frame_id="-1" name="" text="到达车站前。" voices=""/><msg @l="376" char_id="-1" frame_id="-1" name=""   text="玲小姐像着了魔般，默默地在夜晚的街道上行走。" voices=""/><msg @l="377" char_id="-1" frame_id="-1" name="" text="我也……默默地跟在她身后。"   voices=""/><msg @l="379" char_id="0" frame_id="-1" name="美帆"   text="（这种跟踪的行为……有点于心不忍）" voices=""/><msg @l="381" char_id="0" frame_id="-1" name="美帆"   text="（但是，都到这一步了就不能回头了……）" voices=""/><msg @l="383" char_id="-1" frame_id="-1" name=""   text="我微微喘着气，保持着距离，不让自己跟丢她的背影。" voices=""/><msg @l="384" char_id="-1" frame_id="-1" name=""   text="因为是深夜，路上行人稀少，我更加小心翼翼地避免被发现，继续跟着她。" voices=""/><msg @l="386" char_id="1" frame_id="-1" name="玲" text="『……。』" voices=""/><msg @l="388" char_id="-1" frame_id="-1" name=""   text="玲小姐穿过电车轨道，进入了办公区。" voices=""/><msg @l="389" char_id="-1" frame_id="-1" name=""   text="车站在轨道的这边，看来她不是要去大学的样子。" voices=""/><msg @l="391" char_id="0" frame_id="-1" name="美帆"   text="（这么晚了她要去哪儿呢？）" voices=""/><msg @l="393" char_id="0" frame_id="-1" name="美帆"   text="（如果不是去大学的话……啊，难道是去大黑建设？）" voices=""/><msg @l="395" char_id="-1" frame_id="-1" name=""   text="她所前往的办公区有大黑建设的南总町支社。" voices=""/><msg @l="396" char_id="-1" frame_id="-1" name=""   text="据我所知，这附近玲小姐会去的地方也就只有那里了。" voices=""/><msg @l="398" char_id="0" frame_id="-1" name="美帆"   text="（但是，这个时间去大黑建设想要做什么呢……？）" voices=""/><msg @l="400" char_id="-1" frame_id="-1" name=""   text="我怀着疑问……沿着行人稀少的办公区，跟踪着玲小姐继续走着。" voices=""/><clear @l="406" class="all"/><msg @l="408" char_id="1" frame_id="-1" name="玲" text="『……。』" voices=""/><msg @l="410" char_id="-1" frame_id="-1" name="" text="在大黑建设公司大楼前，玲小姐停了下来。"   voices=""/><msg @l="411" char_id="-1" frame_id="-1" name=""   text="然后……她环顾了一下四周的情况。" voices=""/><msg @l="413" char_id="0" frame_id="-1" name="美帆" text="『……！！』" voices=""/><msg @l="415" char_id="-1" frame_id="-1" name="" text="我慌忙钻入附近的小巷，藏起身来。"   voices=""/><msg @l="416" char_id="-1" frame_id="-1" name=""   text="她看起来并不像是发现了有人跟踪，而是在警戒周围是否有认识的人。" voices=""/><msg @l="417" char_id="-1" frame_id="-1" name=""   text="就这样，我屏住呼吸躲了一会儿……" voices=""/><msg @l="418" char_id="-1" frame_id="-1" name=""   text="玲小姐就那样走进了大黑建设。" voices=""/><msg @l="420" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="422" char_id="0" frame_id="-1" name="美帆" text="（果然她是有事要去大黑建设……）"   voices=""/><msg @l="424" char_id="0" frame_id="-1" name="美帆" text="（但是，为什么……？）"   voices=""/><msg @l="426" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="428" char_id="0" frame_id="-1" name="美帆"   text="（不行……现在不是思考的时候，得亲自确认才行）" voices=""/><msg @l="430" char_id="0" frame_id="-1" name="美帆"   text="（这不是别人的事……因为我们之间，是有羁绊的）" voices=""/><msg @l="432" char_id="-1" frame_id="-1" name=""   text="我仿佛在自言自语地说服自己，随后跟着她进入了大黑建设。" voices=""/><se @l="436" buf="1" src="自動ドアの音" volume="1."/><msg @l="438" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="440" char_id="-1" frame_id="-1" name=""   text="看到玲小姐径直穿过无人的前台，我也没说什么就跟着走了过去。" voices=""/><msg @l="441" char_id="-1" frame_id="-1" name=""   text="我先观察她乘坐电梯，确认她在哪一层停下后，便搭乘了旁边的电梯。" voices=""/><wait_chgmv/><bg @l="445" src="bg17bh1"/><char @l="449" id="miho" pos="auto" src="miho135"/><msg @l="451" char_id="0" frame_id="-1" name="美帆" text="（呃……）" voices=""/><msg @l="453" char_id="-1" frame_id="-1" name=""   text="我在玲小姐下电梯的楼层也跟着下了电梯，一边察看周围的情况一边来到办公室入口。" voices=""/><msg @l="454" char_id="-1" frame_id="-1" name=""   text="从电梯到办公室入口的走廊上只有厕所和茶水间，只能往这边走。" voices=""/><msg @l="455" char_id="-1" frame_id="-1" name=""   text="办公室入口的牌子上写着“人才派遣部”。" voices=""/><msg @l="457" char_id="0" frame_id="-1" name="美帆" text="（……她去哪里了呢）"   voices=""/><msg @l="459" char_id="-1" frame_id="-1" name=""   text="我靠在办公室入口的墙边，试图从缝隙中窥视内部寻找玲小姐的身影。" voices=""/><msg @l="460" char_id="-1" frame_id="-1" name=""   text="由于是夜晚，虽说办公室里没人，但我也不能堂而皇之地四处寻找。" voices=""/><msg @l="461" char_id="-1" frame_id="-1" name=""   text="如果被巡逻的保安或加班的员工发现就麻烦了。" voices=""/><msg @l="463" char_id="-1" frame_id="-1" name="声音" text="『喂，你在那里干什么？』"   voices=""/><char @l="467" id="miho" pos="auto" src="miho134"/><msg @l="469" char_id="0" frame_id="-1" name="美帆" text="『啊！？』" voices=""/><msg @l="471" char_id="-1" frame_id="-1" name=""   text="被人从背后搭话，我不由得屏住了呼吸。" voices=""/><msg @l="472" char_id="-1" frame_id="-1" name=""   text="慌忙转身……一位目光锐利、面相凶狠的男性正瞪着我。" voices=""/><char @l="476" id="miho" pos="auto" src="miho035"/><msg @l="478" char_id="0" frame_id="-1" name="美帆"   text="『啊，那个……擅自进来真是对不起。但是，我并不是什么可疑人物……。』" voices=""/><msg @l="480" char_id="-1" frame_id="-1" name="男员工"   text="『可疑的家伙通常都这么说。』" voices=""/><char @l="482" id="miho" pos="auto" src="miho036"/><msg @l="483" char_id="0" frame_id="-1" name="美帆"   text="『唔……这话，也许没错。』" voices=""/><msg @l="485" char_id="0" frame_id="-1" name="美帆" text="『我只是来找人的……。』"   voices=""/><msg @l="487" char_id="1" frame_id="-1" name="声音" text="『……美帆？』" voices=""/><char @l="491" id="miho" pos="auto" src="miho034"/><msg @l="493" char_id="0" frame_id="-1" name="美帆" text="『啊……。』" voices=""/><clear @l="496" class="char"/><char @l="498" id="miho" pos="left" src="miho034"/><char @l="501" id="rei" pos="right" src="rei115"/><bgm @l="505" src="bgm05" volume="1."/><msg @l="507" char_id="-1" frame_id="-1" name="" text="玲女士从办公室方向急忙跑过来。"   voices=""/><msg @l="508" char_id="-1" frame_id="-1" name="" text="……还是一如既往地脸色不好。"   voices=""/><char @l="510" id="miho" pos="left" src="miho035"/><msg @l="511" char_id="0" frame_id="-1" name="美帆" text="『玲女士！』" voices=""/><msg @l="513" char_id="1" frame_id="-1" name="玲"   text="『你怎么会在这种地方……。』" voices=""/><char @l="515" id="rei" pos="right" src="rei125"/><msg @l="516" char_id="1" frame_id="-1" name="玲"   text="『……难道说，一直从家里跟踪我来的？』" voices=""/><char @l="520" id="miho" pos="left" src="miho135"/><msg @l="522" char_id="0" frame_id="-1" name="美帆" text="『……是的。』" voices=""/><msg @l="524" char_id="0" frame_id="-1" name="美帆"   text="『我知道这样不好……但不知不觉身体就自己行动起来了。』" voices=""/><char @l="528" id="rei" pos="right" src="rei017"/><msg @l="530" char_id="1" frame_id="-1" name="玲"   text="『为什么……我应该说过吧？不要跟我扯上关系比较好。』" voices=""/><char @l="533" id="rei" pos="right" src="rei115"/><msg @l="534" char_id="1" frame_id="-1" name="玲"   text="『可是你却做出跟踪这种愚蠢的事……而且还追到这种地方。』" voices=""/><char @l="538" id="miho" pos="left" src="miho035"/><msg @l="540" char_id="0" frame_id="-1" name="美帆"   text="『玲女士才是，为什么要说那种话就离开啊！』" voices=""/><char @l="542" id="miho" pos="left" src="miho135"/><msg @l="543" char_id="0" frame_id="-1" name="美帆"   text="『被那样说了之后……怎么可能不管不顾啊。』" voices=""/><char @l="547" id="rei" pos="right" src="rei125"/><msg @l="549" char_id="1" frame_id="-1" name="玲" text="『美帆……。』" voices=""/><bgm @l="553" src="bgm03" volume="1."/><msg @l="555" char_id="-1" frame_id="-1" name="男员工"   text="『好了好了，到此为止吧。』" voices=""/><msg @l="557" char_id="-1" frame_id="-1" name=""   text="一直带着厌烦表情听着我们对话的那个目光锐利、长相凶悍的男人，故意叹了口气，插了进来。"   voices=""/><msg @l="559" char_id="-1" frame_id="-1" name="男员工"   text="『不管你们是什么感人重逢还是别的什么，对我们来说你们的私事根本无所谓。』" voices=""/><char @l="563" id="miho" pos="left" src="miho035"/><msg @l="565" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="567" char_id="1" frame_id="-1" name="玲" text="『……。』" voices=""/><msg @l="569" char_id="-1" frame_id="-1" name="男员工"   text="『哼，真识相，帮大忙了。』" voices=""/><msg @l="571" char_id="-1" frame_id="-1" name="男员工"   text="『那么？你到底是什么人啊？』" voices=""/><char @l="575" id="miho" pos="left" src="miho034"/><msg @l="577" char_id="0" frame_id="-1" name="美帆" text="『啊，那个……我是……。』"   voices=""/><msg @l="579" char_id="1" frame_id="-1" name="玲" text="『她是……我大学的学妹。』"   voices=""/><msg @l="581" char_id="-1" frame_id="-1" name="男员工" text="『哦，原来是学生啊。』"   voices=""/><char @l="585" id="miho" pos="left" src="miho135"/><msg @l="587" char_id="0" frame_id="-1" name="美帆" text="『是、是的……。』" voices=""/><msg @l="589" char_id="-1" frame_id="-1" name="男员工" text="『……。』"   voices=""/><msg @l="591" char_id="-1" frame_id="-1" name=""   text="他用一种仿佛在估价般的目光直勾勾地盯着我。" voices=""/><msg @l="592" char_id="-1" frame_id="-1" name=""   text="特别是在我的腰线和胸口处，我感受到了一种粘腻缠绕、令人不适的猥琐视线。" voices=""/><char @l="595" id="miho" pos="left" src="miho135"/><msg @l="597" char_id="0" frame_id="-1" name="美帆" text="『啊？……干、干什么。』"   voices=""/><msg @l="599" char_id="-1" frame_id="-1" name="男员工"   text="『你很有潜力嘛。要不要来这里当员工？』" voices=""/><char @l="602" id="miho" pos="left" src="miho034"/><msg @l="604" char_id="0" frame_id="-1" name="美帆" text="『员工吗……？』"   voices=""/><msg @l="606" char_id="-1" frame_id="-1" name="男员工"   text="『对、当了员工就要为男性工作人员提供各种服务哦。』" voices=""/><char @l="610" id="rei" pos="right" src="rei014"/><msg @l="612" char_id="1" frame_id="-1" name="玲"   text="『真、真岛先生……怎么能，她……。』" voices=""/><msg @l="614" char_id="-1" frame_id="-1" name="真岛"   text="『闭嘴，你给我安静点。』" voices=""/><msg @l="616" char_id="1" frame_id="-1" name="玲" text="『啊……。』" voices=""/><clear @l="620" class="char"/><char @l="623" id="rei" pos="center" src="rei014f" y="-80"/><msg @l="625" char_id="-1" frame_id="-1" name=""   text="那个被称作真岛的男人，一把搂住玲小姐的腰将她拉近。" voices=""/><msg @l="626" char_id="-1" frame_id="-1" name=""   text="就这样，她被迫背对着我，被压在那男人的胸前。" voices=""/><msg @l="627" char_id="-1" frame_id="-1" name=""   text="简单来说……就是他们面对面地拥抱在一起的感觉。" voices=""/><msg @l="629" char_id="-1" frame_id="-1" name="真岛" text="『不许出声，听到没。』"   voices=""/><begin_trans @l="633" time="500"/><layer @l="634" id="cutin_f" src="game_window_cutin" x="20" y="20" z="-1001"/><layer @l="635" id="cutin" src="cut005b" x="32" y="32" z="-1000"/><end_trans @l="636"/><char @l="639" id="rei" pos="center" src="rei015f" y="-80"/><msg @l="641" char_id="1" frame_id="-1" name="玲" text="『不要……。』" voices=""/><msg @l="643" char_id="-1" frame_id="-1" name="真岛" text="『老实点别动，母猪。』"   voices=""/><msg @l="645" char_id="1" frame_id="-1" name="玲" text="『……。』" voices=""/><msg @l="647" char_id="-1" frame_id="-1" name=""   text="他在玲小姐耳边低语了什么，她点了点头，停止了反抗。" voices=""/><msg @l="649" char_id="-1" frame_id="-1" name="真岛"   text="『你想要舒服吧？想让这里湿漉漉的吧？』" voices=""/><msg @l="651" char_id="1" frame_id="-1" name="玲" text="『……是。』" voices=""/><msg @l="653" char_id="-1" frame_id="-1" name=""   text="随着玲的回答，真岛的手伸进了她的内裤。" voices=""/><msg @l="654" char_id="-1" frame_id="-1" name="" text="咕啾，咕啾。" voices=""/><msg @l="656" char_id="1" frame_id="-1" name="玲" text="『嗯……嗯嗯……。』"   voices=""/><msg @l="658" char_id="-1" frame_id="-1" name="真岛"   text="『嘿嘿，这变态女人已经湿了。来，来，很舒服吧。』" voices=""/><msg @l="660" char_id="-1" frame_id="-1" name=""   text="玲小姐被言语挑逗着，同时她的私处被手指搅动着，抽插着。" voices=""/><msg @l="662" char_id="1" frame_id="-1" name="玲" text="『嗯……哈啊……。』"   voices=""/><char @l="666" id="rei" pos="center" src="rei013f" y="-80"/><msg @l="668" char_id="0" frame_id="-1" name="美帆" text="『玲小姐……？』" voices=""/><msg @l="670" char_id="1" frame_id="-1" name="玲"   text="『没、没什么……别在意。』" voices=""/><msg @l="672" char_id="1" frame_id="-1" name="玲"   text="『不用管我，你快点回去吧……啊，嗯嗯！』" voices=""/><msg @l="674" char_id="-1" frame_id="-1" name=""   text="当玲小姐正要说什么的时候，那个没有搂着她腰的手动了一下，她的话语戛然而止。" voices=""/><msg @l="675" char_id="-1" frame_id="-1" name=""   text="虽然我能猜到他在做什么，但从我所在的位置看不到，所以不清楚具体是什么。"   voices=""/><msg @l="676" char_id="-1" frame_id="-1" name=""   text="不过，我能隐约听到咕叽咕叽的水声。" voices=""/><msg @l="678" char_id="0" frame_id="-1" name="美帆" text="『玲、玲小姐……您没事吧？』"   voices=""/><char @l="682" id="rei" pos="center" src="rei013f" y="-80"/><msg @l="684" char_id="1" frame_id="-1" name="玲"   text="『我、我没事……不用管我。』" voices=""/><msg @l="686" char_id="0" frame_id="-1" name="美帆" text="『可是……。』" voices=""/><msg @l="688" char_id="-1" frame_id="-1" name="真岛"   text="『都让你别管了，不理她不就好了吗？』" voices=""/><msg @l="690" char_id="-1" frame_id="-1" name="真岛"   text="『嘛，我是无所谓被发现啦？后辈小姐，要不要过来看看？』" voices=""/><msg @l="692" char_id="1" frame_id="-1" name="玲"   text="『不行……真的，我没事的。求你了……不要过来……。』" voices=""/><msg @l="694" char_id="-1" frame_id="-1" name=""   text="玲小姐回过头来看着我，满脸绯红地拼命哀求道。" voices=""/><msg @l="696" char_id="0" frame_id="-1" name="美帆" text="『玲小姐……。』" voices=""/><msg @l="698" char_id="-1" frame_id="-1" name=""   text="我想走近她，却被拒绝无法靠近。" voices=""/><msg @l="700" char_id="-1" frame_id="-1" name="真岛"   text="『不想牵连后辈吗？真是够忠心的啊。』" voices=""/><msg @l="702" char_id="-1" frame_id="-1" name="真岛"   text="『但是，看到这种傻得可爱的忠心反而让我更想欺负你，这就是我这个人啊。』" voices=""/><msg @l="704" char_id="-1" frame_id="-1" name=""   text="真岛嘴角上扬，用食指和中指摩擦着秘部内的肉壁。" voices=""/><msg @l="705" char_id="-1" frame_id="-1" name="" text="那一瞬间———。" voices=""/><clear @l="711" class="all"/><msg @l="713" char_id="1" frame_id="-1" name="玲" text="『嗯、啊啊啊啊！！』"   voices=""/><msg @l="716" char_id="-1" frame_id="-1" name="" text="噗哧啊————————！"   voices=""/><wait_chgmv/><bg @l="720" src="bg17bh1"/><msg @l="722" char_id="-1" frame_id="-1" name=""   text="玲小姐发出一声尖叫的同时，水声在室内回荡。" voices=""/><msg @l="723" char_id="-1" frame_id="-1" name=""   text="她身体颤抖着，拼命按住裙子的下摆，瘫坐在地上。" voices=""/><msg @l="724" char_id="-1" frame_id="-1" name=""   text="玲小姐坐着的地方，一大片水渍正在蔓延开来，就像泼了大量的水一样。" voices=""/><char @l="728" id="miho" pos="auto" src="miho034"/><msg @l="730" char_id="0" frame_id="-1" name="美帆" text="『玲……小姐？』" voices=""/><msg @l="732" char_id="1" frame_id="-1" name="玲"   text="『不，啊啊……别看……别看啊……。』" voices=""/><msg @l="734" char_id="-1" frame_id="-1" name=""   text="玲小姐声音颤抖着，拼命恳求道。" voices=""/><msg @l="735" char_id="-1" frame_id="-1" name=""   text="我不明白发生了什么……只是呆呆地望着这样的玲小姐。" voices=""/><msg @l="737" char_id="-1" frame_id="-1" name="真岛"   text="『啊哈哈哈哈哈哈……这母猪，居然在后辈面前被玩弄下体尿了出来！！』" voices=""/><msg @l="739" char_id="-1" frame_id="-1" name="真岛" text="『已经是出色的淫乱受虐狂了啊，喂。』"   voices=""/><msg @l="741" char_id="1" frame_id="-1" name="玲" text="『呀啊啊啊啊……！』"   voices=""/><msg @l="743" char_id="-1" frame_id="-1" name=""   text="玲小姐一边发出悲痛的声音，一边不停地扭动着腰。" voices=""/><msg @l="744" char_id="-1" frame_id="-1" name=""   text="那看起来并非是因为排尿的余韵而颤抖……而是在对真岛的侮辱言语做出反应。" voices=""/><msg @l="746" char_id="1" frame_id="-1" name="玲" text="『不行啊……身体变得奇怪了……。』"   voices=""/><msg @l="748" char_id="1" frame_id="-1" name="玲"   text="『被蔑视，被看到羞耻的样子……我……我竟然感觉到兴奋了……。』" voices=""/><msg @l="750" char_id="-1" frame_id="-1" name="真岛"   text="『你可是我调教出来的最高级的淫乱受虐狂啊。』" voices=""/><msg @l="752" char_id="-1" frame_id="-1" name="真岛"   text="『不久之后，光是被言语羞辱就能高潮，我会让你变成那样的。』" voices=""/><msg @l="754" char_id="1" frame_id="-1" name="玲"   text="『嗯，怎么会……我……我啊啊啊……。』" voices=""/><msg @l="756" char_id="-1" frame_id="-1" name=""   text="听到真岛的话，玲小姐露出悲伤的表情，身体不停地颤抖着。" voices=""/><msg @l="757" char_id="-1" frame_id="-1" name=""   text="虽然内心在拒绝，但身体却在切实感受着他的话语……。" voices=""/><char @l="761" id="miho" pos="auto" src="miho135"/><msg @l="763" char_id="0" frame_id="-1" name="美帆" text="『唔……。』" voices=""/><msg @l="765" char_id="-1" frame_id="-1" name=""   text="看着她那样坐在地板上扭动身体的样子，我感到愤怒。" voices=""/><msg @l="766" char_id="-1" frame_id="-1" name=""   text="为什么玲小姐要遭受这种对待呢。" voices=""/><msg @l="768" char_id="-1" frame_id="-1" name="真岛"   text="『总之，我想让你也做这样的工作。』" voices=""/><char @l="772" id="miho" pos="auto" src="miho034"/><msg @l="774" char_id="0" frame_id="-1" name="美帆"   text="『什么！！太过分了……这种事，太过分了！』" voices=""/><msg @l="776" char_id="-1" frame_id="-1" name="真岛"   text="『不错啊，那张因愤怒而颤抖的脸。』" voices=""/><msg @l="778" char_id="-1" frame_id="-1" name="真岛"   text="『真想把你那张装清高的脸，用精液弄得黏糊糊乱七八糟的。』" voices=""/><char @l="781" id="miho" pos="auto" src="miho035"/><msg @l="783" char_id="0" frame_id="-1" name="美帆" text="『你这个人！』" voices=""/><msg @l="785" char_id="-1" frame_id="-1" name="真岛"   text="『哼，趁现在尽情地恨我吧。』" voices=""/><msg @l="787" char_id="-1" frame_id="-1" name="真岛"   text="『那样的话……事后屈辱感会成倍增加啊。』" voices=""/><msg @l="789" char_id="-1" frame_id="-1" name=""   text="他说完这话，嘴角浮现出一丝蛇般的笑容，然后朝着办公室内部轻轻挥了挥手。" voices=""/><msg @l="790" char_id="-1" frame_id="-1" name=""   text="……接着，几个身穿西装的公司职员模样的人立刻出现，将我团团围住。" voices=""/><msg @l="792" char_id="-1" frame_id="-1" name="真岛" text="『把她带走。』"   voices=""/><msg @l="794" char_id="-1" frame_id="-1" name="男员工A" text="『明白了。』"   voices=""/><msg @l="796" char_id="-1" frame_id="-1" name=""   text="那些身穿西装的职员模样的人，在围住我的同时抓住了我的手腕和腰部进行控制，然后试图强行将我带往办公室深处。"   voices=""/><char @l="800" id="miho" pos="auto" src="miho134"/><msg @l="802" char_id="0" frame_id="-1" name="美帆"   text="『不要……住手，请放开我！』" voices=""/><msg @l="804" char_id="-1" frame_id="-1" name="真岛" text="『最好别太挣扎哦？』"   voices=""/><msg @l="806" char_id="-1" frame_id="-1" name="真岛"   text="『不然的话，你会遭遇比直接被侵犯更加悲惨的下场。』" voices=""/><char @l="809" id="miho" pos="auto" src="miho135"/><msg @l="811" char_id="0" frame_id="-1" name="美帆"   text="『这种事……就算不挣扎，也没有任何保证不会遭遇可怕的事情吧！』" voices=""/><msg @l="813" char_id="-1" frame_id="-1" name="真岛" text="『确实如你所说。』"   voices=""/><msg @l="815" char_id="-1" frame_id="-1" name="真岛"   text="『那就试着挣扎看看吧。我会让你十二分地后悔的。』" voices=""/><char @l="819" id="miho" pos="auto" src="miho035"/><msg @l="821" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="823" char_id="-1" frame_id="-1" name="男员工B"   text="『真岛先生难得给你忠告，别让我们费工夫了。』" voices=""/><msg @l="825" char_id="0" frame_id="-1" name="美帆"   text="『呀……痛，请不要那么用力地拉我。』" voices=""/><char @l="829" id="miho" pos="auto" src="miho135"/><msg @l="831" char_id="0" frame_id="-1" name="美帆" text="『我自己……能走。』"   voices=""/><clear @l="835" class="char"/><msg @l="837" char_id="-1" frame_id="-1" name=""   text="在公司职员的引导下，我向办公室深处走去。" voices=""/><msg @l="839" char_id="1" frame_id="-1" name="玲" text="『……。』" voices=""/><msg @l="841" char_id="-1" frame_id="-1" name="" text="背后……能感觉到玲小姐的视线。"   voices=""/><clear @l="847" class="all"/><wait_chgmv/><bg @l="851" src="bg17b"/><msg @l="853" char_id="-1" frame_id="-1" name="" text="……。" voices=""/><msg @l="854" char_id="-1" frame_id="-1" name=""   text="从那之后一直……我被软禁在办公室一角用隔板隔开的会议空间里。" voices=""/><msg @l="855" char_id="-1" frame_id="-1" name=""   text="狭小的会议空间里有四把椅子和一张桌子，桌子上放着一台电脑。" voices=""/><msg @l="856" char_id="-1" frame_id="-1" name="" text="我只是被安排坐在其中一把椅子上。"   voices=""/><msg @l="858" char_id="0" frame_id="-1" name="美帆"   text="『……我要坐到什么时候才能离开？』" voices=""/><msg @l="860" char_id="-1" frame_id="-1" name=""   text="我小声地向会议空间外的看守男子询问。" voices=""/><msg @l="861" char_id="-1" frame_id="-1" name=""   text="办公室墙上的挂钟已经指向凌晨1点。" voices=""/><msg @l="863" char_id="-1" frame_id="-1" name="男员工A"   text="『要等到真岛先生说可以为止。』" voices=""/><msg @l="865" char_id="0" frame_id="-1" name="美帆"   text="『……那个叫真岛的人什么时候回来？』" voices=""/><msg @l="867" char_id="-1" frame_id="-1" name="男员工A" text="『这种事我怎么会知道。』"   voices=""/><msg @l="869" char_id="-1" frame_id="-1" name=""   text="重复着不知从刚才开始已经交谈了多少次的对话。" voices=""/><msg @l="870" char_id="-1" frame_id="-1" name=""   text="从被软禁在这里开始，大概已经过去3个小时了吧。" voices=""/><msg @l="871" char_id="-1" frame_id="-1" name=""   text="去厕所时，喝水时，总是有人监视陪同，根本没有逃跑的机会。" voices=""/><msg @l="873" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="875" char_id="0" frame_id="-1" name="美帆" text="（玲……现在怎么样了呢……）"   voices=""/><msg @l="877" char_id="0" frame_id="-1" name="美帆" text="『………。』"   voices=""/><msg @l="879" char_id="-1" frame_id="-1" name="男员工A" text="『喂。』" voices=""/><msg @l="881" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="883" char_id="-1" frame_id="-1" name="男员工A" text="『喂，你这家伙！』"   voices=""/><msg @l="885" char_id="0" frame_id="-1" name="美帆" text="『啊……哦，什么事？』"   voices=""/><msg @l="887" char_id="-1" frame_id="-1" name="男员工A"   text="『真岛先生回来了。社长也一起来了。』" voices=""/><msg @l="889" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="891" char_id="0" frame_id="-1" name="美帆" text="（……社长？）" voices=""/><clear @l="897" class="all"/><wait_chgmv/><bg @l="901" src="bg17b"/><bgm @l="905" src="bgm09" volume="1."/><char @l="909" id="ookur" pos="auto" src="ookuro010"/><msg @l="911" char_id="-1" frame_id="-1" name="社长" text="『久等了。』"   voices=""/><msg @l="913" char_id="-1" frame_id="-1" name="真岛" text="『哟，让你久等了啊。』"   voices=""/><msg @l="915" char_id="0" frame_id="-1" name="美帆" text="（啊……那个人……）"   voices=""/><msg @l="917" char_id="-1" frame_id="-1" name=""   text="和真岛一起走进会议区的，是那个我曾经给玲小姐送文件时见过的男性。" voices=""/><msg @l="919" char_id="0" frame_id="-1" name="美帆"   text="（为什么社长会特地来取个人面试资料呢……）" voices=""/><msg @l="921" char_id="0" frame_id="-1" name="美帆"   text="（不，更重要的是，为什么会在这种地方……？）" voices=""/><msg @l="923" char_id="-1" frame_id="-1" name="社长"   text="『我听真岛君说呢，这里有个新员工候选人，所以就适当地结束了商谈赶回来了……』"   voices=""/><msg @l="925" char_id="-1" frame_id="-1" name="社长" text="『哦……就是这个孩子啊。』"   voices=""/><msg @l="927" char_id="-1" frame_id="-1" name=""   text="在那里，那位看起来像是“社长”的体格不错的男人，正在打量着我。" voices=""/><msg @l="928" char_id="-1" frame_id="-1" name=""   text="他盯着我看了一会儿后……似乎想起之前曾经见过我，眉毛微微动了一下。" voices=""/><msg @l="930" char_id="-1" frame_id="-1" name="社长"   text="『啊，你就是之前来送文件的那个……』" voices=""/><msg @l="932" char_id="-1" frame_id="-1" name="真岛" text="『你们认识吗？』"   voices=""/><msg @l="934" char_id="-1" frame_id="-1" name="社长"   text="『谈不上认识……原来如此，当时播下的种子这么快就结果了啊。』" voices=""/><msg @l="936" char_id="-1" frame_id="-1" name="社长"   text="『我本以为你会是明年的'乐趣'……』" voices=""/><clear @l="939" class="char"/><char @l="941" id="ookur" pos="left" src="ookuro010"/><char @l="943" id="miho" pos="right" src="miho034"/><msg @l="945" char_id="0" frame_id="-1" name="美帆" text="『啊？……您在说什么？』"   voices=""/><msg @l="947" char_id="-1" frame_id="-1" name="社长" text="『没什么，我自己的事。』"   voices=""/><msg @l="949" char_id="-1" frame_id="-1" name="社长"   text="『话说回来，我还没做自我介绍呢。我是大黑建设南总町支社的支社长，我叫大黑满彦。』"   voices=""/><char @l="952" id="miho" pos="right" src="miho136"/><msg @l="954" char_id="0" frame_id="-1" name="美帆" text="『啊……』" voices=""/><msg @l="956" char_id="-1" frame_id="-1" name=""   text="被半强迫地软禁在这种地方，现在才来自我介绍什么的已经毫无意义。" voices=""/><msg @l="957" char_id="-1" frame_id="-1" name=""   text="我带着微微燃起的敌意注视着他……大黑。" voices=""/><msg @l="959" char_id="-1" frame_id="-1" name="大黑"   text="『哎呀哎呀，看来是被相当讨厌了呢。』" voices=""/><msg @l="961" char_id="-1" frame_id="-1" name="真岛"   text="『是不是因为被大黑先生关进来得太晚，等得不耐烦了？』" voices=""/><msg @l="963" char_id="-1" frame_id="-1" name="真岛"   text="『好好对待她……很快就会变得亲近了哦。』" voices=""/><msg @l="965" char_id="-1" frame_id="-1" name="大黑"   text="『原来如此。那么我可得好好招待才行啊。』" voices=""/><msg @l="967" char_id="-1" frame_id="-1" name=""   text="他们就像是在谈论什么宠物一样说着这些话，大黑和真岛相视而笑。" voices=""/><clear @l="973" class="all"/><label @l="976" id="event_scene42"/><msg @l="978" char_id="-1" frame_id="-1" name="真岛" text="『喂，过来这边！』"   voices=""/><msg @l="980" char_id="0" frame_id="-1" name="美帆" text="『啊！？』" voices=""/><wait_chgmv/><bg @l="984" src="bg17b"/><msg @l="986" char_id="-1" frame_id="-1" name=""   text="当大黑说要从隔板围起来的会议区域出来时，真岛粗暴地抓住我的手将我拽了出去。" voices=""/><msg @l="987" char_id="-1" frame_id="-1" name=""   text="我失去平衡摇摇晃晃地被拉到了走廊的中间。" voices=""/><msg @l="989" char_id="-1" frame_id="-1" name="大黑" text="『真岛君，粗暴可不好啊。』"   voices=""/><msg @l="991" char_id="-1" frame_id="-1" name="真岛"   text="『哎呀，这也是一种小小的演出罢了。』" voices=""/><msg @l="993" char_id="-1" frame_id="-1" name="真岛"   text="『不这样做可没有气氛啊。』" voices=""/><msg @l="995" char_id="-1" frame_id="-1" name=""   text="真岛一边说着，一边愉快地扬起嘴角，粗暴地掀起了我的衣服。" voices=""/><char @l="998" id="miho" pos="center" src="miho035f" y="-80"/><msg @l="1000" char_id="0" frame_id="-1" name="美帆" text="『啊啊……不，不要！！』"   voices=""/><msg @l="1002" char_id="-1" frame_id="-1" name="真岛"   text="『哎呀，挣扎也没什么好处哦。』" voices=""/><msg @l="1004" char_id="-1" frame_id="-1" name="真岛"   text="『不想被打的话就老实点。』" voices=""/><msg @l="1006" char_id="0" frame_id="-1" name="美帆" text="『……唔……。』"   voices=""/><msg @l="1008" char_id="-1" frame_id="-1" name=""   text="手腕被抓住，我被推倒在地板上。" voices=""/><msg @l="1009" char_id="-1" frame_id="-1" name=""   text="想要抵抗却无济于事，真岛的力量非常强大，即使想要挣脱也完全不是对手。" voices=""/><msg @l="1011" char_id="-1" frame_id="-1" name="真岛"   text="『来……大黑先生，请您好好拍下来。』" voices=""/><msg @l="1013" char_id="-1" frame_id="-1" name="大黑"   text="『真是不好意思啊。那么就心怀感激地接受吧。』" voices=""/><msg @l="1015" char_id="-1" frame_id="-1" name=""   text="大黑高兴地说着，覆盖到了我的身上。" voices=""/><msg @l="1016" char_id="-1" frame_id="-1" name=""   text="他下腹部的那个东西已经硬挺起来，暗红色的顶端仿佛在威吓般地抽动着。" voices=""/><msg @l="1018" char_id="-1" frame_id="-1" name="真岛"   text="『其他人，上面的嘴想怎么用就怎么用。』" voices=""/><msg @l="1020" char_id="-1" frame_id="-1" name="男员工A" text="『哦哦！』"   voices=""/><msg @l="1022" char_id="-1" frame_id="-1" name="男员工B"   text="『不愧是真岛先生，真懂我们！』" voices=""/><msg @l="1024" char_id="-1" frame_id="-1" name=""   text="随着真岛的话语，整个办公室里响起了欢呼声。" voices=""/><msg @l="1025" char_id="-1" frame_id="-1" name=""   text="不知不觉中，我周围聚集了许多男性员工，他们都目不转睛地盯着我的身体。" voices=""/><msg @l="1026" char_id="-1" frame_id="-1" name=""   text="其中有些人，一边看着我的身体一边爱抚着自己的那话儿。" voices=""/><char @l="1029" id="miho" pos="center" src="miho135f" y="-80"/><msg @l="1031" char_id="0" frame_id="-1" name="美帆" text="『呀…不要啊啊……。』"   voices=""/><msg @l="1033" char_id="-1" frame_id="-1" name="大黑"   text="『那么，我要好好品尝一番了。』" voices=""/><label @l="1037" id="chart_line31"/><wait_chgmv/><ev @l="1041" src="ev-042"/><description @l="1044" text="第二个祭品"/><bgm @l="1048" src="bgm13" volume="1."/><msg @l="1050" char_id="0" frame_id="-1" name="美帆" text="『嗯，啊呜！！』"   voices="miho13050"/><msg @l="1052" char_id="-1" frame_id="-1" name=""   text="尚未湿润的体内，被一根炙热坚硬的勃起物猛地刺入。" voices=""/><msg @l="1053" char_id="-1" frame_id="-1" name=""   text="私密处被紧紧闭合的地方被强行撑开的压迫感让我发出了痛苦的呻吟。" voices=""/><msg @l="1055" char_id="0" frame_id="-1" name="美帆" text="『啊啊…啊，嗯嗯……。』"   voices="miho13060"/><msg @l="1057" char_id="-1" frame_id="-1" name=""   text="在忍受了一阵强烈的摩擦感后，那勃起物的顶端最终深深顶入了我体内最深处然后停住了。" voices=""/><msg @l="1059" char_id="0" frame_id="-1" name="美帆"   text="『哈，哈，哈……嗯……。』" voices="miho13080"/><msg @l="1061" char_id="-1" frame_id="-1" name=""   text="我一边摇动着肩膀急促地呼吸着，一边因为私密处涌上的钝痛和灼热皱起了眉头。" voices=""/><msg @l="1062" char_id="-1" frame_id="-1" name=""   text="几天前被蹂躏撕裂的伤口已经愈合，但尚未习惯被贯穿的阴道被大黑的肉茎压迫得几乎无法呼吸。"   voices=""/><msg @l="1064" char_id="-1" frame_id="-1" name="男员工A"   text="『喂喂，别休息了，这边也拜托了哦。』" voices=""/><msg @l="1066" char_id="0" frame_id="-1" name="美帆" text="『唔唔唔！？』"   voices="miho13090"/><msg @l="1068" char_id="-1" frame_id="-1" name=""   text="为了深呼吸而张开的嘴唇被撑开，男人的前端被强行塞了进来。" voices=""/><msg @l="1070" char_id="-1" frame_id="-1" name="男员工A"   text="『不要用牙齿，好好地舔啊。』" voices=""/><msg @l="1072" char_id="0" frame_id="-1" name="美帆" text="『唔，唔唔！！』"   voices="miho13100"/><msg @l="1074" char_id="-1" frame_id="-1" name=""   text="把肉棒塞进我嘴里的他，不断地前后摆动腰部，仿佛在插入私密处一般摩擦着我的口腔。" voices=""/><msg @l="1075" char_id="-1" frame_id="-1" name=""   text="我因窒息感和排斥感发出呻吟声表示抵抗。" voices=""/><msg @l="1076" char_id="-1" frame_id="-1" name=""   text="然而，在侵犯着我口腔的他却完全不在意，继续着猛烈的深喉。" voices=""/><msg @l="1078" char_id="-1" frame_id="-1" name="大黑"   text="『一开始会很难受，但请忍耐一下。』" voices=""/><msg @l="1080" char_id="-1" frame_id="-1" name="大黑" text="『很快你就会上瘾的。』"   voices=""/><msg @l="1082" char_id="-1" frame_id="-1" name=""   text="大黑将插入的阳具停住不动，享受着阴道内的触感，看着痛苦挣扎的我，愉快地笑了起来。" voices=""/><msg @l="1083" char_id="-1" frame_id="-1" name="" text="……他疯了。" voices=""/><msg @l="1084" char_id="-1" frame_id="-1" name=""   text="虽然这么想着，但口腔里肆虐的勃起猛烈程度，很快就让我无法继续思考。" voices=""/><msg @l="1086" char_id="-1" frame_id="-1" name="男员工A"   text="『不行啊，要好好动舌头舔啊。』" voices=""/><msg @l="1088" char_id="0" frame_id="-1" name="美帆" text="『唔咕……唔，唔唔！！』"   voices="miho13110"/><msg @l="1090" char_id="0" frame_id="-1" name="美帆"   text="『唔噗，唔……啾噗，啾啪！』" voices="miho13120"/><msg @l="1092" char_id="-1" frame_id="-1" name=""   text="无法忍受口腔被猛烈搅动的痛苦，我不情愿地按照男人说的那样，开始用舌头缠绕着前端，啧啧有声地舔了起来。"   voices=""/><msg @l="1094" char_id="-1" frame_id="-1" name="男员工A" text="『对对，就是这样，感觉不错。』"   voices=""/><msg @l="1096" char_id="-1" frame_id="-1" name=""   text="我终于开始服侍他，男人似乎因此心情变好了，放缓了原本粗暴的腰部动作，将身体交给缠绕在龟头上的舌头。"   voices=""/><msg @l="1098" char_id="0" frame_id="-1" name="美帆"   text="『唔嗯……啾噗……啾咯，啾咯……。』" voices="miho13130"/><msg @l="1100" char_id="-1" frame_id="-1" name=""   text="我的嘴角沾满了唾液，拼命地继续舔弄着他的肉棒。" voices=""/><msg @l="1101" char_id="-1" frame_id="-1" name=""   text="如果惹他不高兴，他就会把肉棒一直顶到我喉咙深处……" voices=""/><msg @l="1102" char_id="-1" frame_id="-1" name=""   text="在这种恐惧的驱使下，我的服侍自然而然地变得更加卖力。" voices=""/><msg @l="1104" char_id="0" frame_id="-1" name="美帆"   text="『唔呼，唔，唔……啾噗……啾噗噗……。』" voices="miho13140"/><msg @l="1106" char_id="-1" frame_id="-1" name="男员工A"   text="『不错嘛，看起来你也开始有感觉了。』" voices=""/><msg @l="1108" char_id="-1" frame_id="-1" name=""   text="我变得积极主动，他似乎特别高兴。" voices=""/><msg @l="1109" char_id="-1" frame_id="-1" name=""   text="在我口中肆虐的他一边露出得意的笑容，一边抚摸着我的头。" voices=""/><msg @l="1111" char_id="0" frame_id="-1" name="美帆" text="『唔……。』"   voices="miho13150"/><msg @l="1114" char_id="0" frame_id="1" name="美帆" text="（求你了……快点结束吧……）"   voices="miho13160"/><msg @l="1116" char_id="-1" frame_id="-1" name=""   text="为了尽快摆脱这种痛苦，我继续用沾满唾液的嘴唇和舌头吮吸着口中那勃起的肉棒。" voices=""/><msg @l="1118" char_id="-1" frame_id="-1" name="大黑"   text="『哦，看来你渐入佳境了嘛。』" voices=""/><msg @l="1120" char_id="-1" frame_id="-1" name="大黑"   text="『那么我这边，也来让你享受一下吧。』" voices=""/><msg @l="1122" char_id="0" frame_id="1" name="美帆" text="『嗯――――！！』"   voices="miho13170"/><msg @l="1124" char_id="-1" frame_id="-1" name=""   text="之前只是插入而几乎不怎么动，一直在观察着我被口中侵犯的样子的大黑，突然开始扭动腰部，猛烈地搅动起我的秘处。"   voices=""/><msg @l="1126" char_id="0" frame_id="1" name="美帆"   text="（诶……骗人，竟然不怎么痛苦……）" voices="miho13180"/><msg @l="1128" char_id="-1" frame_id="-1" name=""   text="他用缓慢而绵长的抽送摩擦着我的体内，感觉和最初插入时完全不同了。" voices=""/><msg @l="1129" char_id="-1" frame_id="-1" name=""   text="几乎没有疼痛和不适，只有那灼热坚硬的物体如同抚摸般摩擦着阴道内壁，我感到肉壁正紧紧缠绕着他的肉棒。" voices=""/><msg @l="1130" char_id="-1" frame_id="-1" name=""   text="那感觉慢慢膨胀……让我的腰部开始发麻。" voices=""/><msg @l="1132" char_id="0" frame_id="1" name="美帆" text="『嗯，嗯嗯……啊………。』"   voices="miho13190"/><msg @l="1134" char_id="-1" frame_id="-1" name="大黑"   text="『来，发出好听的声音吧。』" voices=""/><msg @l="1136" char_id="-1" frame_id="-1" name=""   text="大黑一副得意的表情，继续用龟头和冠状沟部分慢慢摩擦着我湿润的内壁。" voices=""/><msg @l="1137" char_id="-1" frame_id="-1" name=""   text="每当这时，秘处都会发出啧啧的淫靡水声，回荡在整个宽敞的办公室里。" voices=""/><msg @l="1139" char_id="0" frame_id="1" name="美帆"   text="（为什么……我，会变得那么湿……）" voices="miho13200"/><msg @l="1141" char_id="-1" frame_id="-1" name=""   text="面对自己都感到不可思议的爱液泛滥，我依然为了摆脱眼前的恐惧而继续着努力的服侍。" voices=""/><msg @l="1143" char_id="0" frame_id="1" name="美帆"   text="『嗯呜……啾，啾……嗯啊，嗯，嗯，嗯。』" voices="miho13210"/><msg @l="1145" char_id="-1" frame_id="-1" name="男员工A"   text="『不错，就这样轻轻吸着前端部分！』" voices=""/><msg @l="1147" char_id="0" frame_id="1" name="美帆"   text="『嗯啊，好……嗯，啾……嗯……啾噜噜。』" voices="miho13220"/><msg @l="1149" char_id="-1" frame_id="-1" name=""   text="按照指示，我含住前端，吮吸着从马眼流出的前液。" voices=""/><msg @l="1151" char_id="-1" frame_id="-1" name="男员工A"   text="『哦，哦哦……太棒了，太棒了！』" voices=""/><msg @l="1153" char_id="0" frame_id="1" name="美帆"   text="『嗯呼……嗯，嗯噗………嗯，啾噗噗。』" voices="miho13230"/><msg @l="1155" char_id="0" frame_id="1" name="美帆"   text="『啾噜……哈呼……嗯，嗯嗯……嗯，啾呜呜！』" voices="miho13240"/><msg @l="1157" char_id="-1" frame_id="-1" name="男员工A"   text="『哇哦……感觉要被吸干了！』" voices=""/><msg @l="1159" char_id="-1" frame_id="-1" name=""   text="当我用舌尖舔着冠状沟部分并小幅度地吸吮时，被我含住的他一边颤抖着腰一边发出了声音。" voices=""/><msg @l="1161" char_id="-1" frame_id="-1" name="大黑" text="『看来她的嘴巴感觉绝佳呢。』"   voices=""/><msg @l="1163" char_id="-1" frame_id="-1" name="男员工A" text="『是啊，简直太棒了。』"   voices=""/><msg @l="1165" char_id="-1" frame_id="-1" name="大黑"   text="『那是那是……这边的感觉也相当不错哦？』" voices=""/><msg @l="1167" char_id="0" frame_id="1" name="美帆" text="『嗯啊！！』"   voices="miho13250"/><msg @l="1169" char_id="-1" frame_id="-1" name=""   text="之前一直保持缓慢律动的大黑的腰，突然加重了体重，一下子深深地沉了下来。" voices=""/><msg @l="1170" char_id="-1" frame_id="-1" name=""   text="就这样，那炽热膨胀的顶端深入到了子宫最深处，点燃了我体内那刚开始膨胀的微弱愉悦感。"   voices=""/><msg @l="1172" char_id="0" frame_id="1" name="美帆"   text="『啊，啊啊……好厉害……顶到……最深处了……嗯啊！』" voices="miho13070"/><msg @l="1174" char_id="0" frame_id="1" name="美帆"   text="『呜啊……嗯，啊，啊，啊……。』" voices="miho13260"/><msg @l="1176" char_id="0" frame_id="1" name="美帆"   text="『啊呜，啊，啊，啊，啊……嗯啊啊！！』" voices="miho13270"/><msg @l="1178" char_id="-1" frame_id="-1" name=""   text="随着他沉重的抽插节奏，我不由自主地发出了连自己都惊讶的甜美呻吟。" voices=""/><msg @l="1179" char_id="-1" frame_id="-1" name=""   text="每当肉棒摩擦阴道壁并敲击子宫口时，一股热流就从下腹部缓缓膨胀开来。" voices=""/><msg @l="1180" char_id="-1" frame_id="-1" name=""   text="伴随着从私处溢出的咕啾咕啾声，那感觉麻痹了我的大脑深处。" voices=""/><msg @l="1182" char_id="-1" frame_id="-1" name="大黑"   text="『唔……差不多要，要去了！』" voices=""/><msg @l="1184" char_id="-1" frame_id="-1" name=""   text="大黑低吼着喊道，深深插入的肉柱猛地膨胀开来，剧烈搅动着我体内的肉褶。"   voices=""/><msg @l="1186" char_id="-1" frame_id="-1" name="男员工A"   text="『我，我这边也……要射了！！』" voices=""/><msg @l="1188" char_id="-1" frame_id="-1" name=""   text="那个强奸我口腔的男人也重新开始了激烈的深喉，想要侵犯到我喉咙深处并注入精液。" voices=""/><msg @l="1190" char_id="0" frame_id="1" name="美帆"   text="『嗯呜，嗯……啾，啾啵啵……啾噜噜！！』" voices="miho13280"/><msg @l="1192" char_id="0" frame_id="1" name="美帆"   text="『呼啊，嗯啊啊啊……不行……要……要去了！！』" voices="miho13290"/><msg @l="1194" char_id="-1" frame_id="-1" name=""   text="在我体内膨胀的炽热之物，让头脑的麻痹感更加加剧。" voices=""/><msg @l="1195" char_id="-1" frame_id="-1" name="" text="眼前变得一片雪白……"   voices=""/><msg @l="1196" char_id="-1" frame_id="-1" name=""   text="只有那摩擦着子宫内壁的肉感从阴道内，从口腔内真实地传来。" voices=""/><msg @l="1197" char_id="-1" frame_id="-1" name="" text="终于……爆发了———。"   voices=""/><msg @l="1199" char_id="0" frame_id="1" name="美帆" text="『嗯啊！！！』"   voices="miho13300"/><flash @l="1203" count="4" fade="100" image="white"/><wait_chgmv/><ev @l="1207" src="ev-042x1z1"/><msg @l="1209" char_id="0" frame_id="1" name="美帆" text="『呃，呃啊啊，嗯，嗯啊啊啊！』"   voices="miho13310"/><msg @l="1211" char_id="-1" frame_id="-1" name=""   text="就在我达到高潮的同时，大量炽热的液体涌入了我的阴道和口腔。" voices=""/><msg @l="1212" char_id="-1" frame_id="-1" name=""   text="然后，周围的男人们像是到达极限一样，手淫着自己的那物对准我，一起向我的身体上喷洒白浊色的液体———。"   voices=""/><msg @l="1214" char_id="-1" frame_id="-1" name="男员工A"   text="『喂，射到嘴里的东西要好好喝下去哦。』" voices=""/><msg @l="1216" char_id="0" frame_id="1" name="美帆" text="『……。』"   voices="miho13320"/><msg @l="1218" char_id="0" frame_id="1" name="美帆"   text="『嗯嗯……嗯，咕，咕，咕……。』" voices="miho13330"/><msg @l="1220" char_id="-1" frame_id="-1" name=""   text="我按照男人的指示，吞咽着口中积攒的大量精液。" voices=""/><msg @l="1221" char_id="-1" frame_id="-1" name=""   text="那粘稠的液体很难下咽，我只好一边发出喉咙的声音，一边将其灌进体内。" voices=""/><msg @l="1223" char_id="-1" frame_id="-1" name="男员工A"   text="『里面还残留着呢，要好好吸出来哦。』" voices=""/><msg @l="1225" char_id="0" frame_id="1" name="美帆"   text="『嗯……嗯啊……嗯，啾呜呜呜……。』" voices="miho13340"/><msg @l="1227" char_id="0" frame_id="1" name="美帆"   text="『啾噗……咕，啾噜噜……嗯哈，啾，啾呜。』" voices="miho13350"/><msg @l="1229" char_id="-1" frame_id="-1" name=""   text="我任凭自己沉浸在仿佛漂浮在水中般的倦怠感中，用嘴从开始萎缩的勃起物的铃口吸吮着精液。" voices=""/><msg @l="1230" char_id="-1" frame_id="-1" name=""   text="每当吸吮前端时，之前射出的液体残留物便渗出来，苦涩的味道再次在口中扩散。" voices=""/><clear @l="1236" class="all"/><wait_chgmv/><bg @l="1240" src="bg17b"/><msg @l="1242" char_id="-1" frame_id="-1" name="男员工B"   text="『太厉害了，受不了……我也想快点让她喝。』" voices=""/><msg @l="1244" char_id="-1" frame_id="-1" name="男员工C"   text="『那，那个，我可以乳交吗？』" voices=""/><msg @l="1246" char_id="-1" frame_id="-1" name="男员工D"   text="『那我就用后面的洞……。』" voices=""/><msg @l="1248" char_id="-1" frame_id="-1" name=""   text="像看热闹一样在周围观望我们行为的男性社员们，纷纷说出自己的欲望，投来闪烁着贪婪的目光。"   voices=""/><msg @l="1250" char_id="-1" frame_id="-1" name="真岛"   text="『别担心，她会好~好地招待每个人的。』" voices=""/><msg @l="1252" char_id="0" frame_id="1" name="美帆" text="『……。』"   voices="miho13360"/><msg @l="1254" char_id="-1" frame_id="-1" name=""   text="在朦胧模糊的意识中，我听到了真岛的话。" voices=""/><clear @l="1260" class="all"/><msg @l="1262" char_id="0" frame_id="1" name="美帆" text="（啊……还没结束啊）"   voices="miho13370"/><msg @l="1264" char_id="-1" frame_id="-1" name=""   text="怀着确切的绝望和难以言表的兴奋感，我缓缓闭上眼睛。" voices=""/><msg @l="1265" char_id="-1" frame_id="-1" name=""   text="……不知道要接受到什么程度才能轻松些。" voices=""/><msg @l="1266" char_id="-1" frame_id="-1" name=""   text="在被黑暗封闭的世界中，我正思考着这样的事情———。" voices=""/><stopbgm @l="1270" fadeout="1000"/><clear @l="1276" class="all"/><end_scene @l="1279"/><msgshow @l="1282" show="true"/><call @l="1286" target="EventLabel_45@ending07"/><return @l="1287" value="0&#13;&#10;"/><label @l="1291" id="EventLabel_145"/><msg @l="1293" char_id="0" frame_id="1" name="美帆" text="『………。』" voices=""/><msg @l="1295" char_id="-1" frame_id="-1" name=""   text="我找不到该说的话……只能默默地目送玲小姐的背影。" voices=""/><msg @l="1297" char_id="0" frame_id="1" name="美帆"   text="（不行啊……自己的事都已经尽力了……）" voices=""/><msg @l="1299" char_id="-1" frame_id="-1" name="" text="失去重要之人的丧失感……。"   voices=""/><msg @l="1300" char_id="-1" frame_id="-1" name=""   text="但却无能为力，因为我知道自己是多么无力。" voices=""/><msg @l="1302" char_id="0" frame_id="1" name="美帆" text="（所以……）" voices=""/><msg @l="1304" char_id="-1" frame_id="-1" name=""   text="我……甚至失去了与玲小姐最后的羁绊。" voices=""/><clear @l="1310" class="all"/><call @l="1314" target="EventLabel_44@ending06"/><return @l="1315" value="0&#13;&#10;"/><return @l="1318" value=""/></code></xscript>																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																					