<?xml version="1.0" encoding="utf-8"?><xscript><debug editor="&quot;C:\Program&#32;Files&#32;(x86)\sakura\sakura.exe&quot;&#32;&quot;%src%&quot;&#32;-Y=%line%"   src="D:\シロップ\町ぐるみの罠＋汚された夏セット版\汚された夏\完成データ\汚された夏\script\text\root_akina02.txt"/><code><label @l="12" id="EventLabel_60"/><description @l="15" text="游泳教练·第2天"/><eval @l="17" expr="f.numDay=9&#13;&#10;"/><msgshow @l="19" show="false"/><wait_chgmv/><bg @l="21" src="day09" time="2000"/><wait @l="23" time="500"/><wait_chgmv/><bg @l="25" src="black" time="2000"/><msgshow @l="27" show="true"/><wait_chgmv/><bg @l="30" src="bg08m2"/><bgm @l="33" src="bgm02" volume="1."/><char @l="36" id="miho" pos="auto" src="miho115"/><msg @l="38" char_id="0" frame_id="-1" name="美帆"   text="『啊疼……呜啊，这样的姿势也不行啊………。』" voices=""/><msg @l="40" char_id="-1" frame_id="-1" name=""   text="刚下完第二节课，我光是要从座位上站起来就已经费劲了。" voices=""/><msg @l="41" char_id="-1" frame_id="-1" name=""   text="……身体各处都疼痛不已，无论如何动作都显得十分僵硬。" voices=""/><msg @l="43" char_id="-1" frame_id="-1" name="女性朋友" text="『怎么了，你怎么啦？』"   voices=""/><char @l="46" id="miho" pos="auto" src="miho016"/><msg @l="48" char_id="0" frame_id="-1" name="美帆"   text="『啊，没……没什么的…………呃。』" voices=""/><msg @l="50" char_id="-1" frame_id="-1" name="女性朋友"   text="『怎么会没什么……看起来根本不是这样吧？』" voices=""/><char @l="53" id="miho" pos="auto" src="miho015"/><msg @l="55" char_id="0" frame_id="-1" name="美帆"   text="『嗯……就是有点，肌肉酸痛………哎哟哟…………。』" voices=""/><msg @l="57" char_id="-1" frame_id="-1" name="" text="上半身稍微左右扭动一下就会疼痛难忍。"   voices=""/><msg @l="59" char_id="-1" frame_id="-1" name="女性朋友" text="『肌肉酸痛………是腰部吗？』"   voices=""/><char @l="62" id="miho" pos="auto" src="miho016"/><msg @l="64" char_id="0" frame_id="-1" name="美帆"   text="『嗯，腰部、腹肌和大腿根部最痛苦……。』" voices=""/><msg @l="66" char_id="0" frame_id="-1" name="美帆"   text="『好久没做了，一下子就这样……我果然是缺乏运动啊。』" voices=""/><msg @l="68" char_id="-1" frame_id="-1" name="女性朋友" text="『腰部、腹肌和大腿根部………啊！』"   voices=""/><char @l="71" id="miho" pos="auto" src="miho015"/><msg @l="73" char_id="0" frame_id="-1" name="美帆"   text="『太得意忘形了，做了三套……现在正后悔着呢。』" voices=""/><msg @l="75" char_id="-1" frame_id="-1" name="女性朋友"   text="『三套？！&#32;……连续的？！』" voices=""/><char @l="78" id="miho" pos="auto" src="miho016"/><msg @l="81" char_id="0" frame_id="-1" name="美帆"   text="『嗯……而且因为好久没做了，已经是减量的版本了。』" voices=""/><char @l="84" id="miho" pos="auto" src="miho015"/><msg @l="86" char_id="0" frame_id="-1" name="美帆"   text="『以前的话，十套也是轻轻松松的……。』" voices=""/><bgm @l="89" src="bgm06" volume="1."/><msg @l="92" char_id="-1" frame_id="-1" name="女性朋友"   text="『十套都不在话下！&#32;你这人外表看不出来这么厉害啊～。』" voices=""/><char @l="95" id="miho" pos="auto" src="miho010"/><msg @l="97" char_id="0" frame_id="-1" name="美帆"   text="『我经常听人这么说，长时间的话，关键在于怎样在动作时不浪费多余的体力。』" voices=""/><msg @l="99" char_id="-1" frame_id="-1" name="女性朋友" text="『嗯嗯……。』"   voices=""/><char @l="102" id="miho" pos="auto" src="miho111"/><msg @l="104" char_id="0" frame_id="-1" name="美帆"   text="『不用费力，以自然的姿态活动……仅仅做到这一点就能持续很久了哦。』" voices=""/><msg @l="106" char_id="-1" frame_id="-1" name="女性朋友" text="『诶，诶……我不知道呢。』"   voices=""/><char @l="109" id="miho" pos="auto" src="miho011"/><msg @l="111" char_id="0" frame_id="-1" name="美帆"   text="『啊，还有，呼吸的时机也很重要。』" voices=""/><msg @l="113" char_id="-1" frame_id="-1" name="女性朋友"   text="『呼吸……啊，你是说呼吸法？』" voices=""/><char @l="116" id="miho" pos="auto" src="miho010"/><msg @l="118" char_id="0" frame_id="-1" name="美帆"   text="『对对，如果频繁地呼吸反而会更累，所以我觉得尽量控制在最小限度比较好。』" voices=""/><msg @l="120" char_id="-1" frame_id="-1" name="女性朋友"   text="『原来如此……呼吸要尽可能最小限度，是吧。』" voices=""/><msg @l="122" char_id="-1" frame_id="-1" name=""   text="突然一看，她已经拿出了笔记本，不知不觉间开始记起笔记来。" voices=""/><msg @l="123" char_id="-1" frame_id="-1" name=""   text="对我来说是理所当然的事情，但对普通人来说可能并不了解吧。" voices=""/><char @l="126" id="miho" pos="auto" src="miho016"/><msg @l="128" char_id="0" frame_id="-1" name="美帆"   text="『不过，果然三年没做就变迟钝了呢。』" voices=""/><msg @l="130" char_id="0" frame_id="-1" name="美帆"   text="『以前能自然而然做到的事情，现在完全不行了嘛。』" voices=""/><msg @l="132" char_id="-1" frame_id="-1" name="女性朋友"   text="『从前的你……相当厉害呢。』" voices=""/><char @l="135" id="miho" pos="auto" src="miho010"/><msg @l="137" char_id="0" frame_id="-1" name="美帆" text="『我觉得也没什么特别厉害的……』"   voices=""/><msg @l="139" char_id="-1" frame_id="-1" name="女性朋友"   text="『不，已经够厉害了……我一直以为你很文静，没想到竟然是这方面的专家。』" voices=""/><char @l="142" id="miho" pos="auto" src="miho016"/><msg @l="144" char_id="0" frame_id="-1" name="美帆"   text="『文静不文静，应该没什么关系吧？』" voices=""/><msg @l="146" char_id="-1" frame_id="-1" name="女性朋友"   text="『也是呢……我现在也有同感。』" voices=""/><msg @l="148" char_id="-1" frame_id="-1" name="女性朋友"   text="『谢谢你，我会参考你说的！』" voices=""/><stopbgm @l="151" fadeout="1000"/><char @l="154" id="miho" pos="auto" src="miho014"/><msg @l="156" char_id="0" frame_id="-1" name="美帆"   text="『诶，啊……午饭怎么办……她走了。』" voices=""/><char @l="159" id="miho" pos="auto" src="miho110"/><msg @l="161" char_id="0" frame_id="-1" name="美帆"   text="『说是要参考，她是要开始了吗？……游泳。』" voices=""/><clear @l="164" class="all"/><bgm @l="167" src="bgm02" volume="1."/><wait_chgmv/><bg @l="170" src="bg09"/><char @l="173" id="miho" pos="auto" src="miho110"/><msg @l="175" char_id="0" frame_id="-1" name="美帆" text="(午饭……该怎么办呢)"   voices=""/><msg @l="177" char_id="-1" frame_id="-1" name=""   text="虽然并没有特定的目的地，但我还是先到走廊去看看。" voices=""/><msg @l="178" char_id="-1" frame_id="-1" name=""   text="平时一起吃午饭的朋友们……" voices=""/><msg @l="179" char_id="-1" frame_id="-1" name=""   text="都已经离开储物柜，没有再回来。" voices=""/><msg @l="181" char_id="0" frame_id="-1" name="美帆"   text="(就算在教室等着，她也不一定会回来……)" voices=""/><char @l="184" id="miho" pos="auto" src="miho010"/><msg @l="186" char_id="0" frame_id="-1" name="美帆"   text="(没办法……今天只能一个人去学生食堂了……)" voices=""/><clear @l="189" class="char"/><char @l="192" id="miho" pos="auto" src="miho111"/><msg @l="194" char_id="0" frame_id="-1" name="美帆" text="(今天的午餐菜单……会是什么呢～)"   voices=""/><msg @l="196" char_id="-1" frame_id="-1" name=""   text="我漫不经心地想着这些事，朝着学生食堂走去。" voices=""/><msg @l="197" char_id="-1" frame_id="-1" name=""   text="这里的午餐菜单虽然便宜，但甜点会附赠布丁或酸奶之类的，其实挺合我胃口的……"   voices=""/><msg @l="198" char_id="-1" frame_id="-1" name=""   text="就是不太喜欢大碗饭类的……" voices=""/><msg @l="199" char_id="-1" frame_id="-1" name=""   text="因为饭量是按男生的标准来盛的，以我的胃口是吃不完的。" voices=""/><msg @l="200" char_id="-1" frame_id="-1" name=""   text="我从小就不喜欢剩饭，所以除非有把握能吃完，否则不会点这类食物。" voices=""/><char @l="203" id="miho" pos="auto" src="miho016"/><msg @l="205" char_id="0" frame_id="-1" name="美帆"   text="(……仅仅昨天的练习就让我肌肉酸痛成这样，根本没资格做教练啊……)" voices=""/><msg @l="207" char_id="0" frame_id="-1" name="美帆"   text="(三年前的我明明能轻松应对那种程度的……)" voices=""/><msg @l="209" char_id="-1" frame_id="-1" name=""   text="只是轻轻地游了三个50米，腹肌和腰部就嘎吱嘎吱地痛。" voices=""/><char @l="212" id="miho" pos="auto" src="miho110"/><msg @l="214" char_id="0" frame_id="-1" name="美帆"   text="(回去后得做做柔韧体操才行……)" voices=""/><char @l="217" id="miho" pos="auto" src="miho114"/><msg @l="219" char_id="0" frame_id="-1" name="美帆" text="(……咦？)" voices=""/><stopbgm @l="222" fadeout="1000"/><msg @l="224" char_id="-1" frame_id="-1" name=""   text="发现走在走廊前方的人影后，我的脚步停了下来。" voices=""/><char @l="227" id="watab" pos="auto" src="watabe010"/><msg @l="229" char_id="-1" frame_id="-1" name="穿运动服的男子"   text="『哎呀……哦，这不是仲根吗！』" voices=""/><clear @l="232" class="char"/><char @l="234" id="watab" pos="left" src="watabe010"/><char @l="236" id="miho" pos="right" src="miho114"/><bgm @l="239" src="bgm15" volume="1."/><msg @l="241" char_id="0" frame_id="-1" name="美帆"   text="『……渡部……老师………。』" voices=""/><msg @l="243" char_id="-1" frame_id="-1" name=""   text="对于这个过于亲昵的人物，我确实有印象……" voices=""/><msg @l="244" char_id="-1" frame_id="-1" name="" text="不……··。" voices=""/><msg @l="245" char_id="-1" frame_id="0" name="" text="「……我还没有忘记。」"   voices=""/><msg @l="246" char_id="-1" frame_id="-1" name="" text="那个从我这里夺走游泳的……，"   voices=""/><msg @l="247" char_id="-1" frame_id="-1" name="" text="那个挂着淡淡笑容的男人的脸……。"   voices=""/><char @l="250" id="miho" pos="right" src="miho015"/><msg @l="252" char_id="0" frame_id="-1" name="美帆"   text="『为什么！？为什么你会在这种地方！？』" voices=""/><msg @l="254" char_id="-1" frame_id="-1" name="渡部"   text="『什么什么，'为什么'可真是个奇怪的问候啊。』" voices=""/><msg @l="256" char_id="0" frame_id="-1" name="美帆"   text="『……我是在问，为什么你会在这所大学里。』" voices=""/><char @l="259" id="watab" pos="left" src="watabe012"/><msg @l="261" char_id="-1" frame_id="-1" name="渡部"   text="『别摆着可怕的表情嘛，这样你漂亮的脸蛋就浪费了。』" voices=""/><char @l="264" id="miho" pos="right" src="miho115"/><msg @l="266" char_id="0" frame_id="-1" name="美帆" text="『请回答我的问题！！』"   voices=""/><char @l="269" id="watab" pos="left" src="watabe010"/><msg @l="271" char_id="-1" frame_id="-1" name="渡部"   text="『哼……当然是因为我作为游泳部顾问来这所大学集训的啊。』" voices=""/><char @l="274" id="miho" pos="right" src="miho014"/><msg @l="276" char_id="0" frame_id="-1" name="美帆" text="『啊？……不会吧……。』"   voices=""/><msg @l="278" char_id="-1" frame_id="-1" name="渡部" text="『怎么会是谎话。』" voices=""/><msg @l="280" char_id="-1" frame_id="-1" name="渡部"   text="『事实上，每天照看你妹妹的人就是我。』" voices=""/><msg @l="282" char_id="0" frame_id="-1" name="美帆" text="『什——！？』"   voices=""/><msg @l="284" char_id="0" frame_id="-1" name="美帆" text="『为什么会这样……。』"   voices=""/><msg @l="286" char_id="-1" frame_id="-1" name="渡部"   text="『因为这是我的工作啊，这不是理所当然的吗？』" voices=""/><char @l="289" id="miho" pos="right" src="miho015"/><msg @l="291" char_id="0" frame_id="-1" name="美帆" text="『你……竟然还能……。』"   voices=""/><char @l="294" id="miho" pos="right" src="miho115"/><msg @l="296" char_id="0" frame_id="-1" name="美帆"   text="『难道你忘记了三年前自己做过什么吗！？』" voices=""/><char @l="299" id="watab" pos="left" src="watabe014"/><msg @l="301" char_id="-1" frame_id="-1" name="渡部"   text="『 啊～是什么事呢····没有印象啊······？』" voices=""/><char @l="304" id="miho" pos="right" src="miho015"/><msg @l="306" char_id="0" frame_id="-1" name="美帆" text="『———！？』"   voices=""/><se @l="309" buf="1" src="平手打ち" volume="1."/><flash @l="311" count="4" fade="100" image="white"/><char @l="314" id="watab" pos="left" src="watabe010"/><msg @l="316" char_id="-1" frame_id="-1" name="渡部" text="『哎……哎哎。』"   voices=""/><msg @l="318" char_id="-1" frame_id="-1" name="渡部"   text="『腰倒是用力了，但一点也不痛啊？……喂……你的身体有没有变迟钝啊？』" voices=""/><char @l="321" id="miho" pos="right" src="miho115"/><msg @l="323" char_id="0" frame_id="-1" name="美帆"   text="『你竟然……把我的人生搞得一团糟，还敢说这种话！！』" voices=""/><char @l="326" id="watab" pos="left" src="watabe014"/><msg @l="328" char_id="-1" frame_id="-1" name="渡部"   text="『把你人生搞得一团糟？我？喂喂别误会了。』" voices=""/><char @l="331" id="watab" pos="left" src="watabe010"/><msg @l="333" char_id="-1" frame_id="-1" name="渡部"   text="『自己擅自放弃游泳的不是你吗？这又不是我的错。』" voices=""/><char @l="336" id="miho" pos="right" src="miho114"/><msg @l="338" char_id="0" frame_id="-1" name="美帆"   text="『什……你知道自己在说什么吗！？』" voices=""/><msg @l="340" char_id="-1" frame_id="-1" name="" text="我…………，" voices=""/><msg @l="341" char_id="-1" frame_id="-1" name="" text="绝对，不会忘记那个事件。"   voices=""/><msg @l="342" char_id="-1" frame_id="-1" name=""   text="这个男人的行为，虽然只是未遂，却给我的心灵留下了深深的伤痕。" voices=""/><msg @l="343" char_id="-1" frame_id="-1" name="" text="所以我放弃了游泳……。"   voices=""/><msg @l="344" char_id="-1" frame_id="-1" name=""   text="……被我信任的人，以那种方式背叛……。" voices=""/><msg @l="345" char_id="-1" frame_id="-1" name="" text="即便如此……。" voices=""/><char @l="348" id="watab" pos="left" src="watabe012"/><msg @l="350" char_id="-1" frame_id="-1" name="渡部"   text="『我明白啊。我什么都没做……。』" voices=""/><msg @l="352" char_id="-1" frame_id="-1" name="渡部"   text="『事实上你看……我并没有被追究责任，还能这样继续当老师。』" voices=""/><msg @l="354" char_id="-1" frame_id="-1" name="渡部"   text="『我是正常的，没有问题……这不就是最好的证据吗？』" voices=""/><char @l="357" id="miho" pos="right" src="miho015"/><msg @l="359" char_id="0" frame_id="-1" name="美帆" text="『怎么会有这种荒谬的事……。』"   voices=""/><char @l="362" id="watab" pos="left" src="watabe014"/><msg @l="364" char_id="-1" frame_id="-1" name="渡部"   text="『虽然我不明白你在说什么……，但这是事实。』" voices=""/><char @l="367" id="watab" pos="left" src="watabe010"/><msg @l="369" char_id="-1" frame_id="-1" name="渡部"   text="『犯罪的话当然会被抓。我呢？没有任何处罚吧？』" voices=""/><msg @l="371" char_id="-1" frame_id="-1" name="渡部"   text="『简而言之，我根本没有犯什么罪。至少……在社会上……是这样的。』" voices=""/><char @l="374" id="miho" pos="right" src="miho115"/><msg @l="376" char_id="0" frame_id="-1" name="美帆" text="『那是——！！』"   voices=""/><msg @l="378" char_id="-1" frame_id="-1" name="" text="那是……，" voices=""/><msg @l="379" char_id="-1" frame_id="-1" name="" text="那是错的！" voices=""/><msg @l="380" char_id="-1" frame_id="-1" name=""   text="那起事件被掩盖的原因，完全是因为我请求学校不要向外界公开事情的始末。" voices=""/><msg @l="381" char_id="-1" frame_id="-1" name=""   text="而且，我个人之所以没有向任何人透露事实……，" voices=""/><msg @l="382" char_id="-1" frame_id="-1" name="" text="并不是因为我原谅了这个男人！"   voices=""/><msg @l="384" char_id="-1" frame_id="-1" name="渡部"   text="『嘛，所以我们就好好相处吧。』" voices=""/><char @l="387" id="watab" pos="left" src="watabe012"/><msg @l="389" char_id="-1" frame_id="-1" name="渡部" text="『——就像三年前那样？』"   voices=""/><char @l="392" id="miho" pos="right" src="miho114"/><msg @l="394" char_id="0" frame_id="-1" name="美帆" text="『呜……请不要靠近我！！』"   voices=""/><char @l="397" id="miho" pos="right" src="miho015"/><msg @l="399" char_id="0" frame_id="-1" name="美帆" text="『我没有和您和睦相处的意思！』"   voices=""/><char @l="402" id="watab" pos="left" src="watabe010"/><msg @l="404" char_id="-1" frame_id="-1" name="渡部"   text="『哼……那么，你打算怎么处理你妹妹的事？』" voices=""/><msg @l="406" char_id="-1" frame_id="-1" name="渡部"   text="『不是被拜托做游泳训练营的教练了吗？』" voices=""/><char @l="409" id="miho" pos="right" src="miho116"/><msg @l="411" char_id="0" frame_id="-1" name="美帆" text="『那…那个是…。』"   voices=""/><msg @l="413" char_id="-1" frame_id="-1" name="" text="……对了……。"   voices=""/><msg @l="414" char_id="-1" frame_id="-1" name=""   text="亚季奈说她已经得到了顾问老师的许可。" voices=""/><msg @l="415" char_id="-1" frame_id="-1" name=""   text="那也就是说，她已经得到了这个人的许可……这件事……。" voices=""/><msg @l="416" char_id="-1" frame_id="-1" name=""   text="当亚季奈告诉我她想让我当教练时，这个人在想什么呢……。" voices=""/><msg @l="417" char_id="-1" frame_id="-1" name="" text="一定……，" voices=""/><msg @l="418" char_id="-1" frame_id="-1" name=""   text="一定是满脸笑容地高兴着吧。" voices=""/><msg @l="419" char_id="-1" frame_id="-1" name=""   text="把当时的我弄得一团糟……，" voices=""/><msg @l="420" char_id="-1" frame_id="-1" name=""   text="丝毫没有罪恶感的这个人一定是……。" voices=""/><msg @l="422" char_id="-1" frame_id="-1" name="渡部"   text="『……总、总之就是这么回事……。』" voices=""/><char @l="425" id="watab" pos="left" src="watabe012"/><msg @l="427" char_id="-1" frame_id="-1" name="渡部"   text="『要让你来训练我可爱的学生们吗？』" voices=""/><char @l="430" id="miho" pos="right" src="miho115"/><msg @l="432" char_id="0" frame_id="-1" name="美帆" text="『……卑鄙。』" voices=""/><char @l="435" id="watab" pos="left" src="watabe010"/><msg @l="437" char_id="-1" frame_id="-1" name="渡部"   text="『卑鄙？ 这日语用得不对吧？应该说我世故圆滑才对。』" voices=""/><char @l="440" id="miho" pos="right" src="miho015"/><msg @l="442" char_id="0" frame_id="-1" name="美帆"   text="『呜……我，绝对不会……为了你当什么教练的。』" voices=""/><msg @l="444" char_id="0" frame_id="-1" name="美帆"   text="『是为了亚季奈……为了妹妹才这么做的！』" voices=""/><msg @l="446" char_id="-1" frame_id="-1" name="渡部" text="『理由什么的无所谓啦。』"   voices=""/><msg @l="448" char_id="-1" frame_id="-1" name="渡部"   text="『下一场比赛……只要我们部里有人能夺冠，那就行了。』" voices=""/><msg @l="450" char_id="-1" frame_id="-1" name="渡部"   text="『那样的话我的声望就会暴涨……比现在更能捞到好处吧？』" voices=""/><char @l="453" id="miho" pos="right" src="miho115"/><msg @l="455" char_id="0" frame_id="-1" name="美帆" text="『真是……最差劲的。』" voices=""/><msg @l="457" char_id="-1" frame_id="-1" name="渡部" text="『咕咕咕咕咕。』"   voices=""/><clear @l="460" class="char"/><char @l="462" id="miho" pos="auto" src="miho115"/><msg @l="464" char_id="-1" frame_id="-1" name=""   text="渡部老师开心地笑着，从我身边走过。" voices=""/><msg @l="466" char_id="0" frame_id="-1" name="美帆" text="(为什么……)" voices=""/><msg @l="468" char_id="0" frame_id="-1" name="美帆" text="(为什么会变成这样！！)"   voices=""/><msg @l="470" char_id="-1" frame_id="-1" name=""   text="我勉强忍住想要因震惊和愤怒而大喊的冲动，用充满憎恨的眼神盯着渡部。" voices=""/><stopbgm @l="473" fadeout="1000"/><clear @l="476" class="all"/><wait_chgmv/><bg @l="479" src="bg10m1"/><bgm @l="482" src="bgm02" volume="1."/><char @l="485" id="watab" pos="auto" src="watabe010"/><msg @l="487" char_id="-1" frame_id="-1" name="渡部"   text="『……啊，就是因为这样才晚了一天的缘故，从今天起我打算认真指导，你们做好心理准备吧！』"   voices=""/><msg @l="489" char_id="-1" frame_id="-1" name="游泳部成员们" text="『是，是的！』"   voices=""/><msg @l="491" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="493" char_id="-1" frame_id="-1" name="渡部"   text="『另外，关于细节技术指导，和昨天一样由这位仲根美帆同学负责，大家要好好依靠她啊。』" voices=""/><clear @l="496" class="char"/><char @l="498" id="miho" pos="left" src="miho166"/><char @l="500" id="akina" pos="right" src="akina061"/><msg @l="502" char_id="2" frame_id="-1" name="亚季奈" text="『姐姐，请多指教啊。』"   voices=""/><char @l="505" id="miho" pos="left" src="miho066"/><msg @l="507" char_id="0" frame_id="-1" name="美帆" text="『……嗯，嗯。』" voices=""/><char @l="510" id="akina" pos="right" src="akina064"/><msg @l="512" char_id="2" frame_id="-1" name="亚季奈"   text="『咦？……怎么感觉没什么精神啊？』" voices=""/><char @l="515" id="miho" pos="left" src="miho066"/><msg @l="517" char_id="0" frame_id="-1" name="美帆"   text="『没、没有那回事啦……没有那种……。』" voices=""/><char @l="520" id="akina" pos="right" src="akina161"/><msg @l="522" char_id="2" frame_id="-1" name="亚季奈"   text="『是吗？那就好……。』" voices=""/><char @l="525" id="miho" pos="left" src="miho166"/><msg @l="527" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="529" char_id="0" frame_id="-1" name="美帆"   text="(亚季奈……你为什么要加入这种有这种人的游泳部啊……)" voices=""/><msg @l="531" char_id="0" frame_id="-1" name="美帆" text="(不……不对)"   voices=""/><msg @l="533" char_id="0" frame_id="-1" name="美帆"   text="(话说回来，为什么这个人能够作为教师复职？)" voices=""/><msg @l="535" char_id="0" frame_id="-1" name="美帆"   text="(明明说过他再也……不能自称是教师了的……)" voices=""/><msg @l="537" char_id="2" frame_id="-1" name="亚季奈" text="『姐姐？』" voices=""/><char @l="540" id="akina" pos="right" src="akina064"/><msg @l="542" char_id="2" frame_id="-1" name="亚季奈" text="『姐姐，怎么了？』"   voices=""/><char @l="545" id="miho" pos="left" src="miho064"/><msg @l="547" char_id="0" frame_id="-1" name="美帆" text="『啊……？』" voices=""/><char @l="550" id="miho" pos="left" src="miho066"/><msg @l="552" char_id="0" frame_id="-1" name="美帆"   text="『啊，对不起……刚才有点走神了……。』" voices=""/><char @l="555" id="watab" pos="right" src="watabe014"/><msg @l="557" char_id="-1" frame_id="-1" name="渡部"   text="『喂喂，作为教练的你如果不打起精神来可就麻烦了啊。』" voices=""/><char @l="560" id="miho" pos="left" src="miho166"/><msg @l="562" char_id="0" frame_id="-1" name="美帆" text="『……抱歉。』"   voices=""/><char @l="565" id="akina" pos="right" src="akina064"/><msg @l="567" char_id="2" frame_id="-1" name="亚季奈" text="『姐姐……真的没事吗？』"   voices=""/><char @l="570" id="akina" pos="right" src="akina065"/><msg @l="572" char_id="2" frame_id="-1" name="亚季奈" text="『难道是身体不舒服？』"   voices=""/><char @l="575" id="miho" pos="left" src="miho066"/><msg @l="577" char_id="0" frame_id="-1" name="美帆"   text="『没事……没那回事，我完全没问题。』" voices=""/><char @l="580" id="akina" pos="right" src="akina060"/><msg @l="582" char_id="2" frame_id="-1" name="亚季奈"   text="『是吗？那么，开始练习吧？』" voices=""/><msg @l="584" char_id="0" frame_id="-1" name="美帆" text="『对、对啊……。』"   voices=""/><char @l="587" id="miho" pos="left" src="miho166"/><msg @l="589" char_id="0" frame_id="-1" name="美帆" text="『………。』" voices=""/><msg @l="591" char_id="0" frame_id="-1" name="美帆" text="(……必须振作起来……)"   voices=""/><msg @l="593" char_id="0" frame_id="-1" name="美帆"   text="(……我……必须振作起来………)" voices=""/><clear @l="596" class="all"/><wait_chgmv/><bg @l="599" src="bg10m1"/><char @l="602" id="miho" pos="auto" src="miho066"/><msg @l="604" char_id="0" frame_id="-1" name="美帆"   text="『好的……那边，手臂应该再抬高一点。』" voices=""/><msg @l="606" char_id="0" frame_id="-1" name="美帆"   text="『啊，呼吸的节奏太早了……。』" voices=""/><char @l="609" id="miho" pos="auto" src="miho166"/><msg @l="611" char_id="-1" frame_id="-1" name=""   text="我在竞泳泳道旁边的池边指导着游泳方法。" voices=""/><msg @l="612" char_id="-1" frame_id="-1" name=""   text="比起进到泳池里指导，这样更能清楚地看到大家身体的浮沉，所以我尽量想保持这样的指导方式。" voices=""/><msg @l="613" char_id="-1" frame_id="-1" name="" text="……但是……。"   voices=""/><msg @l="615" char_id="-1" frame_id="-1" name="渡部" text="『……。』" voices=""/><msg @l="617" char_id="-1" frame_id="-1" name=""   text="不知为何，渡部老师站在我旁边……" voices=""/><msg @l="618" char_id="-1" frame_id="-1" name=""   text="一直贴在我身边，对着我的胸部和腰部，带着猥琐的笑容不断投来下流的目光。" voices=""/><char @l="621" id="miho" pos="auto" src="miho066"/><msg @l="623" char_id="0" frame_id="-1" name="美帆"   text="『身体要再伸展一些……腰部下沉是因为用力过猛哦。』" voices=""/><msg @l="625" char_id="-1" frame_id="-1" name="渡部" text="『……。』" voices=""/><msg @l="627" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><char @l="630" id="miho" pos="auto" src="miho166"/><msg @l="632" char_id="0" frame_id="-1" name="美帆"   text="(你能不能快点去别处啊……)" voices=""/><msg @l="634" char_id="0" frame_id="-1" name="美帆"   text="(别什么都不说……就只是盯着……用那种下流的眼神一直盯着我的身体看……)" voices=""/><msg @l="636" char_id="-1" frame_id="-1" name="渡部" text="『……怎么了，不指导了吗？』"   voices=""/><char @l="639" id="miho" pos="auto" src="miho064"/><msg @l="641" char_id="0" frame_id="-1" name="美帆" text="『啊……是、是的。』"   voices=""/><char @l="644" id="miho" pos="auto" src="miho160"/><msg @l="646" char_id="-1" frame_id="-1" name=""   text="我再次将视线转回正在游泳的孩子们那边。" voices=""/><msg @l="647" char_id="-1" frame_id="-1" name="" text="就在这一瞬间……，" voices=""/><msg @l="648" char_id="-1" frame_id="-1" name="" text="有什么东西轻轻地抚过了我的腰部。"   voices=""/><stopbgm @l="651" fadeout="1000"/><char @l="654" id="miho" pos="center" src="miho064f" y="-80"/><begin_trans @l="656" time="500"/><layer @l="657" id="cutin_f" src="game_window_cutin" x="20" y="20" z="-1001"/><layer @l="658" id="cutin" src="cut004b" x="32" y="32" z="-1000"/><end_trans @l="659"/><msg @l="661" char_id="0" frame_id="-1" name="美帆" text="『！？……诶……？』"   voices=""/><msg @l="663" char_id="-1" frame_id="-1" name=""   text="那是不用确认也知道是渡部老师的手。" voices=""/><bgm @l="666" src="bgm15" volume="1."/><msg @l="668" char_id="-1" frame_id="-1" name="渡部"   text="『怎么了？……就这样继续指导不好吗？』" voices=""/><char @l="671" id="miho" pos="center" src="miho065f" y="-80"/><msg @l="673" char_id="0" frame_id="-1" name="美帆" text="『不，不要……。』" voices=""/><msg @l="675" char_id="-1" frame_id="-1" name="渡部"   text="『这样抵抗的话，会不会被妹妹注意到呢？』" voices=""/><msg @l="677" char_id="0" frame_id="-1" name="美帆" text="『……！』" voices=""/><clear @l="680" class="char"/><char @l="683" id="akina" pos="right" src="akina161"/><msg @l="685" char_id="-1" frame_id="-1" name=""   text="我立刻看向泳池边正在休息的亚季奈。" voices=""/><msg @l="686" char_id="-1" frame_id="-1" name=""   text="亚季奈正在和旁边的游泳部学生聊天，没有看向我这边。" voices=""/><clear @l="689" class="char"/><char @l="692" id="miho" pos="center" src="miho065f" y="-80"/><begin_trans @l="694" time="500"/><layer @l="695" id="cutin_f" src="game_window_cutin" x="20" y="20" z="-1001"/><layer @l="696" id="cutin" src="cut004" x="32" y="32" z="-1000"/><end_trans @l="697"/><msg @l="699" char_id="-1" frame_id="-1" name="渡部"   text="『不是挺好的吗？没被发现……。』" voices=""/><msg @l="701" char_id="-1" frame_id="-1" name="渡部"   text="『我和你互相抚摸的事情，被妹妹知道就不好了，对吧？』" voices=""/><char @l="704" id="miho" pos="center" src="miho064f" y="-80"/><msg @l="706" char_id="0" frame_id="-1" name="美帆"   text="『啊！什、什么互相抚摸，怎么可能！这只是渡部老师单方面地……。』" voices=""/><char @l="709" id="miho" pos="center" src="miho065f" y="-80"/><msg @l="711" char_id="0" frame_id="-1" name="美帆"   text="『而、而且……老师如果被人知道对我做这种事的话……这次真的会被迫辞去教师职位的吧……？』"   voices=""/><msg @l="713" char_id="-1" frame_id="-1" name="渡部"   text="『啊，如果那样的话，这次妹妹那边可能会遇到麻烦呢。』" voices=""/><msg @l="715" char_id="0" frame_id="-1" name="美帆" text="『诶……。』" voices=""/><msg @l="717" char_id="-1" frame_id="-1" name="渡部"   text="『好像没听清楚，那我再说一遍。……我说的是'这次妹妹那边会遇到麻烦'……这句话。』"   voices=""/><msg @l="719" char_id="0" frame_id="-1" name="美帆"   text="『！？……亚季奈吗！？……为什么……亚季奈和这事没关系！！』" voices=""/><msg @l="721" char_id="-1" frame_id="-1" name="渡部" text="『对我来说有关系。』"   voices=""/><msg @l="723" char_id="-1" frame_id="-1" name="渡部"   text="『是让亚季奈被我侵犯呢？还是让你妹妹放弃她珍视的游泳呢？……嘛，对我来说无所谓就是了……』"   voices=""/><msg @l="725" char_id="-1" frame_id="-1" name="渡部"   text="『对你而言……无论选哪一个，都会失去重要的东西吧？』" voices=""/><msg @l="727" char_id="0" frame_id="-1" name="美帆" text="『怎么会……。』" voices=""/><msg @l="729" char_id="-1" frame_id="-1" name="渡部"   text="『啊，就算事情闹大了，也没有证据证明我说过这种话，而且我随时都能侵犯你妹妹那种小角色……。』"   voices=""/><msg @l="731" char_id="-1" frame_id="-1" name="渡部"   text="『明白了吧？你从一开始就没有胜算。』" voices=""/><msg @l="733" char_id="0" frame_id="-1" name="美帆" text="『……唔……』"   voices=""/><msg @l="735" char_id="-1" frame_id="-1" name="渡部"   text="『啊？……你说什么？……我听不清』" voices=""/><msg @l="737" char_id="0" frame_id="-1" name="美帆"   text="『……连亚季奈都……这种事……』" voices=""/><msg @l="739" char_id="-1" frame_id="-1" name="渡部"   text="『……呵呵……是说别对妹妹下手吗？……哦哦，真是个好姐姐啊……』" voices=""/><msg @l="741" char_id="0" frame_id="-1" name="美帆"   text="『……你这个人……』" voices=""/><msg @l="743" char_id="-1" frame_id="-1" name="渡部"   text="『嘛，我也不是魔鬼……，给你一个保护妹妹的方法……一个还是可以的……。』"   voices=""/><msg @l="745" char_id="0" frame_id="-1" name="美帆" text="『什、什么？』"   voices=""/><msg @l="747" char_id="-1" frame_id="-1" name="渡部"   text="『你做替身不就行了吗？……对，这主意不错。务必这么做吧。』" voices=""/><msg @l="749" char_id="-1" frame_id="-1" name="渡部"   text="『你不想让可爱的妹妹落入我的魔爪吧？……呵呵……这样不是很简单吗。』" voices=""/><msg @l="751" char_id="0" frame_id="-1" name="美帆" text="『咕……。』" voices=""/><msg @l="754" char_id="-1" frame_id="-1" name="渡部"   text="『喂喂，你在咬什么啊？……没听懂我的建议吗？……真没办法啊……我来给你解释一下。我是在说？……你代替妹妹，来做我的对象就行了。』"   voices=""/><msg @l="756" char_id="-1" frame_id="-1" name="" text="我的耳边感受到了一股腥臭的吐息。"   voices=""/><msg @l="757" char_id="-1" frame_id="-1" name=""   text="渡部一边黏糊糊地低语，一边用那肮脏的指尖，像涂抹黏液一样抚摸着我的大腿。" voices=""/><msg @l="758" char_id="-1" frame_id="-1" name=""   text="渡部的另一只手爬上了呆立着的我的腰部，然后慢慢下移。" voices=""/><msg @l="759" char_id="-1" frame_id="-1" name=""   text="他张开的五指，揉捏着忘记了动弹的我的臀部。" voices=""/><msg @l="760" char_id="-1" frame_id="-1" name=""   text="渡部那仿佛在揉捏泥巴般的动作，使我臀部的肉变了形。" voices=""/><msg @l="761" char_id="-1" frame_id="-1" name="" text="然后……，" voices=""/><begin_trans @l="764" time="500"/><layer @l="765" id="cutin_f" src="game_window_cutin" x="20" y="20" z="-1001"/><layer @l="766" id="cutin" src="cut004b" x="32" y="32" z="-1000"/><end_trans @l="767"/><msg @l="769" char_id="0" frame_id="-1" name="美帆" text="『……！！』" voices=""/><msg @l="771" char_id="-1" frame_id="-1" name=""   text="像蛞蝓一样肥厚的手指……沿着臀缝向前游走。" voices=""/><msg @l="772" char_id="-1" frame_id="-1" name=""   text="被那令人毛骨悚然的触感惊到，我不禁颤抖着肩膀瞪向他……但是，" voices=""/><msg @l="773" char_id="-1" frame_id="-1" name=""   text="渡部那带着下流笑容的目光，轻易击退了我无声的抗议。" voices=""/><msg @l="775" char_id="-1" frame_id="-1" name="渡部"   text="『瞪得这么厉害啊……如果你不在乎妹妹会怎样，就继续瞪着吧。……如果你不想那样……就乖乖听话。』"   voices=""/><char @l="778" id="miho" pos="center" src="miho165f" y="-80"/><msg @l="780" char_id="0" frame_id="-1" name="美帆" text="(为什么……为什么……)"   voices=""/><msg @l="782" char_id="0" frame_id="-1" name="美帆"   text="(明明已经忘记了……这样不就和三年前一样……)" voices=""/><msg @l="784" char_id="-1" frame_id="-1" name="" text="……什么……都做不了。"   voices=""/><msg @l="785" char_id="-1" frame_id="-1" name="" text="如果我不保护亚季奈的话……，"   voices=""/><msg @l="786" char_id="-1" frame_id="-1" name=""   text="这次就轮到她遭遇和当时的我同样的命运了……。" voices=""/><msg @l="787" char_id="-1" frame_id="-1" name="" text="那种事绝对……，"   voices=""/><msg @l="789" char_id="-1" frame_id="-1" name="" text="无论发生什么，那种事绝对……。"   voices=""/><msg @l="791" char_id="-1" frame_id="-1" name="游泳部成员A"   text="『那个……刚才的姿势，有什么不对的地方吗？』" voices=""/><char @l="794" id="miho" pos="center" src="miho064f" y="-80"/><msg @l="796" char_id="0" frame_id="-1" name="美帆" text="『啊！？……是、是的！』"   voices=""/><msg @l="798" char_id="-1" frame_id="-1" name=""   text="突然，游泳的女孩向我搭话。" voices=""/><msg @l="799" char_id="-1" frame_id="-1" name=""   text="我本能地扭动身体想要离开，但爱抚着我的渡部的手臂却没有松开。" voices=""/><char @l="802" id="miho" pos="center" src="miho165f" y="-80"/><msg @l="804" char_id="0" frame_id="-1" name="美帆"   text="『请……不要……放开我。』" voices=""/><msg @l="806" char_id="-1" frame_id="-1" name=""   text="我背过脸，小声说道，以免被游泳部的女孩听到。" voices=""/><msg @l="807" char_id="-1" frame_id="-1" name=""   text="如果被她看到太多，就会知道我正在遭受什么。" voices=""/><msg @l="809" char_id="-1" frame_id="-1" name="游泳部成员A" text="『那个——？』"   voices=""/><msg @l="811" char_id="-1" frame_id="-1" name="渡部"   text="『喂，不好好教她的话会让人起疑的哦？』" voices=""/><msg @l="813" char_id="-1" frame_id="-1" name="渡部"   text="『作为温柔的「姐姐」，不会想要阻断妹妹的道路吧？』" voices=""/><char @l="816" id="miho" pos="center" src="miho065f" y="-80"/><msg @l="818" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="820" char_id="-1" frame_id="-1" name="游泳部成员A" text="『那个，仲根学姐……？』"   voices=""/><char @l="823" id="miho" pos="center" src="miho066f" y="-80"/><msg @l="825" char_id="0" frame_id="-1" name="美帆" text="『啊，啊啊，对不起……。』"   voices=""/><msg @l="826" char_id="0" frame_id="-1" name="美帆"   text="『刚，刚才那个……把手臂再伸直一些的话，就能再稍微……嗯啊！』" voices=""/><char @l="829" id="miho" pos="center" src="miho065f" y="-80"/><msg @l="831" char_id="-1" frame_id="-1" name=""   text="尽管有被部员发现的危险，渡部却不打算停下抚弄我的手。" voices=""/><msg @l="832" char_id="-1" frame_id="-1" name=""   text="他带着那浅浅的笑容，隔着泳衣持续摩擦着我的秘处。" voices=""/><msg @l="833" char_id="-1" frame_id="-1" name="" text="咕啾，咕啾。" voices=""/><msg @l="835" char_id="0" frame_id="1" name="美帆"   text="（必须忍耐……绝对不能被发现……）" voices=""/><msg @l="837" char_id="-1" frame_id="-1" name="游泳部成员A"   text="『那个——把手臂伸直就可以了吗……？』" voices=""/><char @l="840" id="miho" pos="center" src="miho066f" y="-80"/><msg @l="842" char_id="0" frame_id="1" name="美帆"   text="『啊…………嗯。手臂……伸直的话………嗯啊…………我想应该会更快…………。』" voices=""/><msg @l="844" char_id="0" frame_id="1" name="美帆"   text="『总之………先试试看………吧……。』" voices=""/><msg @l="846" char_id="-1" frame_id="-1" name="游泳部成员A"   text="『………？好的，伸直手臂……明白了，我试试看。』" voices=""/><msg @l="848" char_id="-1" frame_id="-1" name=""   text="在复述我的建议的同时，部员回到了泳道。" voices=""/><msg @l="849" char_id="-1" frame_id="-1" name=""   text="途中，她回头看了我一眼，那眼神中透露着一丝疑惑。" voices=""/><msg @l="851" char_id="-1" frame_id="-1" name="渡部" text="『不愧是你，建议真是精准啊。』"   voices=""/><char @l="854" id="miho" pos="center" src="miho065f" y="-80"/><msg @l="856" char_id="0" frame_id="1" name="美帆" text="『嗯啊……。』" voices=""/><msg @l="858" char_id="-1" frame_id="-1" name=""   text="他仿佛是在给我奖励一般，执拗地用手指在我身上游走。" voices=""/><msg @l="860" char_id="-1" frame_id="-1" name="" text="来了，来了，来了。"   voices=""/><msg @l="862" char_id="-1" frame_id="-1" name=""   text="敏感部位被玩弄的厌恶感让我想哭出来。" voices=""/><msg @l="863" char_id="-1" frame_id="-1" name=""   text="如果可以的话，我真想就这样尖叫出来，但如果那样做了，渡部会怎么对待亚季奈呢……。" voices=""/><msg @l="864" char_id="-1" frame_id="-1" name=""   text="我只能压抑住开始颤抖的身体，继续假装检查正在训练的部员们的姿势……。" voices=""/><msg @l="866" char_id="-1" frame_id="-1" name="渡部"   text="『很好，继续保持这个状态加油啊……教练。』" voices=""/><msg @l="868" char_id="0" frame_id="1" name="美帆" text="(为什么会变成这样……？)"   voices=""/><msg @l="870" char_id="0" frame_id="1" name="美帆"   text="(为什么……这种事情……)" voices=""/><msg @l="872" char_id="-1" frame_id="-1" name=""   text="虽然明白不会有答案，但我还是忍不住质问自己。" voices=""/><msg @l="873" char_id="-1" frame_id="-1" name=""   text="明知道这样做很愚蠢……，" voices=""/><msg @l="874" char_id="-1" frame_id="-1" name="" text="却只能眼睁睁地看着渡部蹂躏自己……，"   voices=""/><msg @l="875" char_id="-1" frame_id="-1" name=""   text="只能默默地、站在那里……。" voices=""/><msg @l="876" char_id="-1" frame_id="-1" name="" text="……。" voices=""/><stopbgm @l="879" fadeout="1000"/><clear @l="882" class="all"/><wait_chgmv/><bg @l="885" src="bg11"/><bgm @l="888" src="bgm03" volume="1."/><char @l="891" id="miho" pos="auto" src="miho166"/><msg @l="893" char_id="0" frame_id="1" name="美帆" text="『…………。』" voices=""/><msg @l="895" char_id="-1" frame_id="-1" name=""   text="练习结束后，游泳部的孩子们早已换好了衣服。" voices=""/><msg @l="896" char_id="-1" frame_id="-1" name=""   text="刚才从里面传出的娇声现在也听不见了。" voices=""/><msg @l="897" char_id="-1" frame_id="-1" name=""   text="因为一个人收拾而耽误了时间的我，终于回到了更衣室。" voices=""/><msg @l="899" char_id="0" frame_id="1" name="美帆"   text="(洗澡有点麻烦啊………)" voices=""/><msg @l="901" char_id="-1" frame_id="-1" name=""   text="真的……很累了……。" voices=""/><msg @l="902" char_id="-1" frame_id="-1" name="" text="那个渡部再次出现在我面前……，"   voices=""/><msg @l="903" char_id="-1" frame_id="-1" name="" text="然后，身体被玩弄了……。"   voices=""/><msg @l="904" char_id="-1" frame_id="-1" name=""   text="虽说是为了保护亚季奈，但我却无法抵抗，身体一直被他触摸着。" voices=""/><msg @l="905" char_id="-1" frame_id="-1" name="" text="3年前也是如此……。"   voices=""/><msg @l="906" char_id="-1" frame_id="-1" name=""   text="一开始是伪装成肢体接触的对我的性骚扰。" voices=""/><msg @l="907" char_id="-1" frame_id="-1" name="" text="这种行为逐渐升级……，"   voices=""/><msg @l="908" char_id="-1" frame_id="-1" name="" text="最终导致了那个事件……。"   voices=""/><clear @l="911" class="char"/><char @l="913" id="miho" pos="left" src="miho166"/><char @l="915" id="akina" pos="right" src="akina014"/><msg @l="917" char_id="2" frame_id="-1" name="亚季奈"   text="『咦，姐姐……还没换衣服吗？』" voices=""/><char @l="920" id="miho" pos="left" src="miho066"/><msg @l="922" char_id="0" frame_id="1" name="美帆" text="『嗯……刚才一直在收拾。』"   voices=""/><char @l="925" id="akina" pos="right" src="akina015"/><msg @l="927" char_id="2" frame_id="-1" name="亚季奈"   text="『对不起，连这种事都让你做……。』" voices=""/><char @l="930" id="miho" pos="left" src="miho066"/><msg @l="932" char_id="0" frame_id="1" name="美帆"   text="『没关系的啦……。在这里亚季奈你们才是主角对吧？』" voices=""/><msg @l="934" char_id="0" frame_id="1" name="美帆"   text="『我也希望大家能开心地努力啊。』" voices=""/><char @l="937" id="akina" pos="right" src="akina011"/><msg @l="939" char_id="2" frame_id="-1" name="亚季奈"   text="『嘿嘿嘿，谢谢。我最喜欢这样的姐姐了。』" voices=""/><char @l="942" id="miho" pos="left" src="miho063"/><msg @l="944" char_id="0" frame_id="1" name="美帆" text="『真是的，亚季奈你啊……。』"   voices=""/><char @l="947" id="akina" pos="right" src="akina010"/><msg @l="949" char_id="2" frame_id="-1" name="亚季奈"   text="『话说回来，姐姐……脸色有点不好呢，没事吧？』" voices=""/><char @l="952" id="miho" pos="left" src="miho166"/><msg @l="954" char_id="0" frame_id="1" name="美帆"   text="『嗯……没事，只是有点……累了而已。』" voices=""/><char @l="957" id="akina" pos="right" src="akina111"/><msg @l="959" char_id="2" frame_id="-1" name="亚季奈"   text="『这样啊……话说，今天老是聊这种话题呢。』" voices=""/><char @l="962" id="miho" pos="left" src="miho066"/><msg @l="964" char_id="0" frame_id="1" name="美帆" text="『呵呵，是啊。』" voices=""/><char @l="967" id="akina" pos="right" src="akina011"/><msg @l="969" char_id="2" frame_id="-1" name="亚季奈"   text="『与其这样，不如赶快换好衣服出去吧。』" voices=""/><msg @l="971" char_id="2" frame_id="-1" name="亚季奈"   text="『总觉得这个更衣室空调开得太强了，好冷。』" voices=""/><char @l="974" id="miho" pos="left" src="miho060"/><msg @l="976" char_id="0" frame_id="1" name="美帆"   text="『嗯……不过，我还没洗澡呢。』" voices=""/><char @l="979" id="akina" pos="right" src="akina014"/><msg @l="981" char_id="2" frame_id="-1" name="亚季奈" text="『诶，是这样吗？』"   voices=""/><char @l="984" id="miho" pos="left" src="miho166"/><msg @l="986" char_id="0" frame_id="1" name="美帆"   text="（……被触摸的感觉还残留着……好恶心……。我……不想带着这种感觉回去……）"   voices=""/><char @l="989" id="miho" pos="left" src="miho066"/><msg @l="991" char_id="0" frame_id="1" name="美帆"   text="『……亚季奈，今天你先回去吧。』" voices=""/><char @l="994" id="akina" pos="right" src="akina010"/><msg @l="996" char_id="2" frame_id="-1" name="亚季奈"   text="『这样啊……那，不好意思，能拜托你锁门吗？』" voices=""/><msg @l="998" char_id="0" frame_id="1" name="美帆"   text="『好好，客人不用担心直接回去就行啦。』" voices=""/><char @l="1001" id="akina" pos="right" src="akina111"/><msg @l="1003" char_id="2" frame_id="-1" name="亚季奈" text="『太好了♪』" voices=""/><msg @l="1005" char_id="2" frame_id="-1" name="亚季奈" text="『那么，明天见！』"   voices=""/><msg @l="1007" char_id="0" frame_id="1" name="美帆" text="『嗯，路上小心哦？』"   voices=""/><clear @l="1010" class="char"/><char @l="1012" id="miho" pos="auto" src="miho166"/><msg @l="1014" char_id="0" frame_id="1" name="美帆" text="『……。』" voices=""/><msg @l="1016" char_id="0" frame_id="1" name="美帆" text="『路上小心……吗……。』"   voices=""/><msg @l="1018" char_id="-1" frame_id="-1" name=""   text="看着亚季奈精神抖擞地离开更衣室的背影，我小声地嘀咕着。" voices=""/><msg @l="1019" char_id="-1" frame_id="-1" name=""   text="既然已经听说了渡部的“意图”……，" voices=""/><msg @l="1020" char_id="-1" frame_id="-1" name=""   text="现在说什么“小心”都已经没有意义了……。" voices=""/><msg @l="1021" char_id="-1" frame_id="-1" name=""   text="无论如何，必须确保亚季奈不会成为那个男人欲望的牺牲品……。" voices=""/><msg @l="1022" char_id="-1" frame_id="-1" name="" text="亚季奈……，"   voices=""/><msg @l="1023" char_id="-1" frame_id="-1" name=""   text="能保护重要的妹妹的，只有我了……。" voices=""/><char @l="1026" id="miho" pos="auto" src="miho165"/><msg @l="1028" char_id="0" frame_id="1" name="美帆" text="『……。』" voices=""/><msg @l="1030" char_id="0" frame_id="1" name="美帆"   text="(赶紧洗个澡，今天就回家吧………)" voices=""/><msg @l="1032" char_id="0" frame_id="1" name="美帆"   text="(然后，得考虑接下来该怎么办才行……)" voices=""/><clear @l="1035" class="char"/><label @l="1038" id="event_scene17"/><msg @l="1040" char_id="-1" frame_id="-1" name=""   text="从储物柜里拿出浴巾……，" voices=""/><msg @l="1041" char_id="-1" frame_id="-1" name=""   text="正要前往淋浴间的那一瞬间……。" voices=""/><bgm @l="1044" src="bgm13" volume="1."/><msg @l="1046" char_id="-1" frame_id="-1" name="" text="突然，一个黑影笼罩过来……，"   voices=""/><msg @l="1047" char_id="-1" frame_id="-1" name=""   text="我被强行压在了身后的储物柜上。" voices=""/><msg @l="1049" char_id="0" frame_id="1" name="美帆" text="『你、你要干什么―――――！？ 』"   voices="miho03460"/><msg @l="1051" char_id="-1" frame_id="-1" name="黑影"   text="『哎呀，最好不要大声喊哦。』" voices=""/><msg @l="1053" char_id="0" frame_id="1" name="美帆" text="『啊……是你！！ 』"   voices="miho03470"/><label @l="1056" id="chart_line11"/><wait_chgmv/><ev @l="1059" src="ev-017"/><description @l="1062" text="噩梦重现"/><msg @l="1064" char_id="-1" frame_id="-1" name="渡部"   text="『哈哈，没想到第一天就能单独相处啊？』" voices=""/><msg @l="1066" char_id="-1" frame_id="-1" name="渡部"   text="『有趣的是把你妹妹赶走得如此顺利，我还以为被发现躲在这里了，吓得我心惊胆战。』" voices=""/><msg @l="1068" char_id="0" frame_id="1" name="美帆"   text="『如果……我知道的话，绝对不会一个人待着的。』" voices="miho03480"/><msg @l="1070" char_id="-1" frame_id="-1" name="渡部" text="『那可不一定啊……？』"   voices=""/><msg @l="1072" char_id="-1" frame_id="-1" name="渡部"   text="『练习的时候我已经那么仔细地爱抚你了。其实你内心深处非常渴望我的东西插进去吧？』" voices=""/><msg @l="1074" char_id="0" frame_id="1" name="美帆"   text="『才、才不是……这种事，绝对，不可能！』" voices="miho03490"/><msg @l="1076" char_id="-1" frame_id="-1" name="渡部"   text="『女人这种生物说的话和心里想的总是不一样。』" voices=""/><msg @l="1078" char_id="-1" frame_id="-1" name="渡部"   text="『别担心……我会好好询问你的身体的。』" voices=""/><msg @l="1080" char_id="-1" frame_id="-1" name=""   text="渡部的手掌隔着泳衣，一把抓住了我的胸部。" voices=""/><msg @l="1081" char_id="-1" frame_id="-1" name=""   text="他先是松开了手，接着又像是揉捏一样捧起我胸前的隆起。" voices=""/><msg @l="1082" char_id="-1" frame_id="-1" name=""   text="他粗糙的手掌摩擦着我的乳尖，双乳被轻重不一地揉搓着。" voices=""/><msg @l="1083" char_id="-1" frame_id="-1" name=""   text="恶心和恐惧感瞬间窜上我的脊背。" voices=""/><msg @l="1085" char_id="0" frame_id="1" name="美帆" text="『不要……请住手！』"   voices="miho03500"/><msg @l="1087" char_id="-1" frame_id="-1" name="渡部"   text="『给我乖一点，很快你自己就会想要的……这个东西。』" voices=""/><msg @l="1089" char_id="-1" frame_id="-1" name=""   text="我大腿的位置感觉到一个硬邦邦的东西顶了过来。" voices=""/><msg @l="1091" char_id="0" frame_id="1" name="美帆" text="『啊——！？』"   voices="miho03510"/><msg @l="1093" char_id="-1" frame_id="-1" name="渡部"   text="『我的跟那些小鬼们不一样……可不是普通货色。』" voices=""/><msg @l="1095" char_id="-1" frame_id="-1" name="渡部"   text="『能够深深地插到最里面，把你的里面搅得一塌糊涂。』" voices=""/><msg @l="1097" char_id="0" frame_id="1" name="美帆"   text="『不要……不要，请放开我！！』" voices="miho03520"/><msg @l="1099" char_id="-1" frame_id="-1" name=""   text="我拼命挣扎，试图从渡部的手中逃脱。" voices=""/><msg @l="1100" char_id="-1" frame_id="-1" name="" text="但是，在力量上我根本就不是他的对手。"   voices=""/><msg @l="1101" char_id="-1" frame_id="-1" name=""   text="虽然我瞎乱挣扎了一通，但连一条胳膊都推不开。" voices=""/><msg @l="1103" char_id="-1" frame_id="-1" name="渡部"   text="『哈哈哈哈哈哈哈，别费劲了。没用的，没用的！！』" voices=""/><msg @l="1105" char_id="-1" frame_id="-1" name="渡部"   text="『就你一个人在那挣扎……要扭断你可是很容易的！』" voices=""/><se @l="1108" buf="1" src="金属扉にモノを叩きつけた音" volume="1."/><flash @l="1110" count="4" fade="100" image="white"/><shake @l="1112" amp="10" class="all" cycle="30" duration="100"   type="random"/><msg @l="1114" char_id="0" frame_id="1" name="美帆" text="『呃啊。』"   voices="miho03530"/><msg @l="1116" char_id="-1" frame_id="-1" name=""   text="我被猛地压倒在地，狠狠地撞到了头。" voices=""/><msg @l="1117" char_id="-1" frame_id="-1" name=""   text="一瞬间意识变得恍惚，视野开始一片模糊。" voices=""/><msg @l="1118" char_id="-1" frame_id="-1" name=""   text="趁我意识朦胧之际，渡部用左手抱起我的一条腿，粗暴地将我的泳衣拨到一边。" voices=""/><msg @l="1119" char_id="-1" frame_id="-1" name=""   text="他空出的右手不耐烦地拉下裤子，握住已经呈现疯狂勃起状态的、那根怪异的肉棒。" voices=""/><msg @l="1120" char_id="-1" frame_id="-1" name=""   text="耳边传来渡部喘息时呼出的气息，散发着令人想转头逃离的臭气。" voices=""/><msg @l="1121" char_id="-1" frame_id="-1" name=""   text="从渡部急切行动的呼吸和眼神中，我只能感受到野兽般发酵的腥臭。" voices=""/><msg @l="1122" char_id="-1" frame_id="-1" name="渡部"   text="『赶紧来一发……直接干了吧……』" voices=""/><msg @l="1123" char_id="-1" frame_id="-1" name=""   text="渡部那张挂着下流笑容的脸，深深烙印在我模糊发白的意识中。" voices=""/><msg @l="1124" char_id="-1" frame_id="-1" name=""   text="从他上扬的嘴角，拉出一条粘稠的唾液丝。" voices=""/><msg @l="1125" char_id="-1" frame_id="-1" name=""   text="渡部将那已膨胀到极限的肉块抵在我的私密处，不管三七二十一，完成了入侵的准备。" voices=""/><msg @l="1127" char_id="-1" frame_id="-1" name="" text="瞬间，恐惧使我的意识变得无比清晰。"   voices=""/><msg @l="1129" char_id="0" frame_id="1" name="美帆"   text="（要被夺走第一次了……我本想献给喜欢的人的……）" voices="miho03540"/><msg @l="1131" char_id="0" frame_id="1" name="美帆" text="『不要……不要……不要！！』"   voices="miho03550"/><msg @l="1133" char_id="0" frame_id="1" name="美帆"   text="『不要啊啊啊啊啊啊啊啊啊啊啊啊啊啊！！』" voices="miho03560"/><msg @l="1135" char_id="-1" frame_id="-1" name="渡部"   text="『吵死了！既然要哭，就给我绝望地哭啊！！！』" voices=""/><se @l="1139" buf="1" src="平手打ち" volume="1."/><flash @l="1141" count="4" fade="100" image="white"/><msg @l="1143" char_id="0" frame_id="1" name="美帆"   text="『呃啊……不，救命……谁来救救我！！』" voices="miho03570"/><msg @l="1145" char_id="-1" frame_id="-1" name="" text="灼热的疼痛掠过我的脸颊。"   voices=""/><msg @l="1146" char_id="-1" frame_id="-1" name=""   text="痛苦煽动着恐惧，除了悲鸣外，我甚至发不出任何叫声。" voices=""/><msg @l="1148" char_id="-1" frame_id="-1" name="渡部"   text="『啧……女人真没意思！叽叽喳喳，像个白痴一样吵闹……我不是叫你给我试试另一种哭法吗……。』"   voices=""/><msg @l="1149" char_id="-1" frame_id="-1" name=""   text="渡部皱着眉头说话的声音，与他的话语完全相反，甚至给人一种充满欢喜的感觉。" voices=""/><msg @l="1150" char_id="-1" frame_id="-1" name=""   text="无论我表现出什么样的抵抗，他心里一定都在暗自窃喜。" voices=""/><msg @l="1151" char_id="-1" frame_id="-1" name=""   text="只要我还在这里，对渡部来说，这只不过是他的一种欢愉……" voices=""/><msg @l="1152" char_id="-1" frame_id="-1" name=""   text="我已经隐约理解了这一点……" voices=""/><msg @l="1154" char_id="-1" frame_id="-1" name="渡部"   text="『算了，说这么多也没用……反正插进去后就会吵闹起来，这是常识嘛……』" voices=""/><msg @l="1156" char_id="-1" frame_id="-1" name="渡部"   text="『你知道吗？对我来说……这样……也挺不错的啊？』" voices=""/><msg @l="1158" char_id="-1" frame_id="-1" name=""   text="那恶心的勃起物随着脉搏跳动，从泳装的边缘向我的秘处逼近。" voices=""/><msg @l="1159" char_id="-1" frame_id="-1" name=""   text="如今被抓住双腿，我根本无法逃脱。" voices=""/><msg @l="1160" char_id="-1" frame_id="-1" name=""   text="那如同张开的伞一样突出的前端，溢出着油腻发亮的粘液。" voices=""/><msg @l="1161" char_id="-1" frame_id="-1" name=""   text="从那逐渐强行分开我身体外侧的部位，我能感受到渡部的心跳和呼吸，让我的身体和意识都在痉挛。" voices=""/><msg @l="1162" char_id="-1" frame_id="-1" name=""   text="我那从未允许任何人进入的小小入口，被花了极长的时间，强行地向两边撑开。" voices=""/><msg @l="1163" char_id="-1" frame_id="-1" name=""   text="污秽的灼热感撕裂着我，但它并没有立即进入内部。" voices=""/><msg @l="1164" char_id="-1" frame_id="-1" name=""   text="渡部凶狠的眉头一瞬间变得模糊，不知为何中断了对我的侵入。" voices=""/><msg @l="1166" char_id="-1" frame_id="1" name="渡部"   text="（嗯？……这家伙的……这触感……。原来如此……看来真的是处女啊……。呵呵……这可真不错……。第一次，强行破坏什么的……我还真是挺走运的……。）"   voices=""/><msg @l="1168" char_id="-1" frame_id="1" name="渡部"   text="（这女人的膜还特地为我保留着呢……。哈哈……这太棒了！！！）" voices=""/><msg @l="1170" char_id="-1" frame_id="-1" name=""   text="渡部的脸上挂着让人无法直视的笑容，逼近我的眼前。" voices=""/><msg @l="1171" char_id="-1" frame_id="-1" name=""   text="如野兽般带着阴影的渡部那污秽的分身，此时再次开始向我体内推进。" voices=""/><msg @l="1172" char_id="-1" frame_id="-1" name=""   text="一种直达头顶的抽搐般的异物感，以及从接触点涌上的灼热感，让我不禁挤出呻吟声。" voices=""/><msg @l="1174" char_id="-1" frame_id="-1" name="渡部"   text="『好啦，你这个年纪还是处女嘛……在这时候从小孩变成女人也不错吧？』" voices=""/><msg @l="1175" char_id="-1" frame_id="-1" name="渡部"   text="『我来给你安排最棒的场景怎么样？……嗯……这个怎么样？』" voices=""/><msg @l="1176" char_id="-1" frame_id="-1" name=""   text="渡部一边只把自己的一半推入我体内，一边像唱着低俗的歌曲一样开始说话。" voices=""/><msg @l="1178" char_id="-1" frame_id="-1" name="渡部"   text="『……你一直就像3年前那样……一直在等着我……』" voices=""/><msg @l="1180" char_id="0" frame_id="1" name="美帆" text="（不……）" voices=""/><msg @l="1182" char_id="-1" frame_id="-1" name="渡部"   text="『然后呢……嘿嘿……今天你要把一切都献给……你朝思暮想的心上人……就是这样的剧情。』" voices=""/><msg @l="1184" char_id="0" frame_id="1" name="美帆" text="（不要……）" voices=""/><msg @l="1187" char_id="-1" frame_id="-1" name="渡部"   text="『……喜欢吧？……其实我也非常激动……我会按照你的希望，全部射在你体内的！！！』" voices=""/><msg @l="1189" char_id="0" frame_id="1" name="美帆"   text="『不要！不要啊啊啊啊啊啊！！』" voices="miho03580"/><clear @l="1192" class="all"/><end_scene @l="1195"/><bgm @l="1198" src="bgm12" volume="1."/><msg @l="1200" char_id="-1" frame_id="-1" name="声音" text="『到此为止吧……。』"   voices=""/><msg @l="1202" char_id="-1" frame_id="-1" name="渡部" text="『什……是，是谁啊。』"   voices=""/><wait_chgmv/><bg @l="1205" src="bg11"/><char @l="1208" id="shiny" pos="auto" src="shinya210"/><msg @l="1210" char_id="-1" frame_id="-1" name=""   text="在我即将陷入黑暗的意识中，一个如铁般坚硬的声音闯了进来。" voices=""/><msg @l="1211" char_id="-1" frame_id="-1" name=""   text="我轻轻转回头，透过渡部肮脏的肩膀，看到了一张熟悉的脸。" voices=""/><msg @l="1212" char_id="-1" frame_id="-1" name="" text="……啊……那个人……。"   voices=""/><msg @l="1213" char_id="-1" frame_id="-1" name=""   text="……奈那子的……哥哥……。" voices=""/><msg @l="1215" char_id="-1" frame_id="-1" name="奈那子的哥哥"   text="『因为奈那子坚持要我来看看，所以我就来了……。』" voices=""/><clear @l="1218" class="char"/><char @l="1220" id="shiny" pos="left" src="shinya210"/><char @l="1222" id="watab" pos="right" src="watabe014"/><msg @l="1224" char_id="-1" frame_id="-1" name="渡部"   text="『你，你这家伙……为什么这个时候会……。』" voices=""/><msg @l="1225" char_id="-1" frame_id="-1" name="" text="渡部也像被弹开一样回过头来。"   voices=""/><msg @l="1226" char_id="-1" frame_id="-1" name=""   text="渡部那张恶心的淫笑脸，一瞬间僵硬地凝固了。" voices=""/><msg @l="1227" char_id="-1" frame_id="-1" name=""   text="渡部表情的变化，是连我都没有预想到的。" voices=""/><char @l="1230" id="watab" pos="right" src="watabe017"/><msg @l="1232" char_id="-1" frame_id="-1" name="渡部"   text="『不…比起这个，你是怎么进来的。钥匙呢！』" voices=""/><msg @l="1233" char_id="-1" frame_id="-1" name=""   text="充满怒气的渡部脸色，眼看着从红变成了青。" voices=""/><msg @l="1234" char_id="-1" frame_id="-1" name=""   text="这种情况恐怕连渡部自己都没有想象过。" voices=""/><msg @l="1236" char_id="-1" frame_id="-1" name="奈那子的哥哥"   text="『你自己去查查看吧……』" voices=""/><msg @l="1237" char_id="-1" frame_id="-1" name=""   text="面对渡部那几乎要咬人的气势和咒骂，奈那子的哥哥依然连眉头都没皱一下。" voices=""/><msg @l="1238" char_id="-1" frame_id="-1" name=""   text="仿佛能在肌肤上感受到风一般，那双纹丝不动的眼睛带着平静，倒映着暴怒的渡部。" voices=""/><msg @l="1240" char_id="-1" frame_id="-1" name="渡部" text="『可恶！！』" voices=""/><msg @l="1242" char_id="-1" frame_id="-1" name=""   text="渡部似乎任由自己被愤怒控制，嘴角飞溅着唾沫，朝着奈那子的哥哥挥拳打去。" voices=""/><clear @l="1245" layer="watab"/><msg @l="1248" char_id="-1" frame_id="-1" name="奈那子的哥哥" text="『……。』"   voices=""/><msg @l="1249" char_id="-1" frame_id="-1" name=""   text="面对踏着地板扑过来的渡部，他甚至没有避开……" voices=""/><msg @l="1250" char_id="-1" frame_id="-1" name=""   text="奈那子的哥哥只是稍微动了一下右臂。" voices=""/><msg @l="1251" char_id="-1" frame_id="-1" name="" text="然后——。" voices=""/><flash @l="1255" count="4" fade="100" image="white"/><msg @l="1257" char_id="-1" frame_id="-1" name="渡部" text="『呜啊啊啊！？』"   voices=""/><se @l="1260" buf="1" src="ベッドに倒れこむ音" volume="1."/><msg @l="1262" char_id="-1" frame_id="-1" name=""   text="就在渡部的拳头即将击中奈那子哥哥的那一瞬间……" voices=""/><msg @l="1263" char_id="-1" frame_id="-1" name=""   text="渡部那庞大的身躯像录像带倒放一样，画出一道不自然的弧线，飞向了半空。" voices=""/><msg @l="1264" char_id="-1" frame_id="-1" name=""   text="这看起来有点像我以前在电视上看到的高手使用的合气道技巧，但眼前发生的这一幕，简直难以相信是同一种东西。" voices=""/><char @l="1267" id="watab" pos="right" src="watabe014"/><msg @l="1269" char_id="-1" frame_id="-1" name="渡部"   text="『什…什么，刚才那是…你做了…什么！？』" voices=""/><msg @l="1271" char_id="-1" frame_id="-1" name=""   text="渡部拖着刺耳的声音在地上翻滚，然后一边按着头一边站了起来。" voices=""/><msg @l="1272" char_id="-1" frame_id="-1" name=""   text="虽然看不到外伤，但背部着地的冲击，肯定让他受了不轻的伤。" voices=""/><msg @l="1273" char_id="-1" frame_id="-1" name=""   text="他强撑着身体站起来，但从膝盖以下都在发抖。" voices=""/><msg @l="1275" char_id="-1" frame_id="-1" name="奈那子的哥哥" text="『……。』"   voices=""/><char @l="1278" id="watab" pos="right" src="watabe017"/><msg @l="1280" char_id="-1" frame_id="-1" name="渡部" text="『呃……该死。』"   voices=""/><msg @l="1282" char_id="-1" frame_id="-1" name="渡部"   text="『仲根……如果你敢逃离我……你知道后果的吧！？』" voices=""/><msg @l="1284" char_id="0" frame_id="1" name="美帆" text="『……。』" voices=""/><msg @l="1286" char_id="-1" frame_id="-1" name="渡部" text="『啧……。』" voices=""/><clear @l="1289" layer="watab"/><msg @l="1291" char_id="-1" frame_id="-1" name=""   text="短暂露出惊恐表情后，渡部像兔子一样飞快地冲出了更衣室的门。" voices=""/><msg @l="1292" char_id="-1" frame_id="-1" name=""   text="渡部临走前扔下的那句话，无力地撞在奈那子哥哥的背上，然后虚无地散去了。" voices=""/><bgm @l="1295" src="bgm03" volume="1."/><char @l="1298" id="miho" pos="right" src="miho165"/><msg @l="1300" char_id="0" frame_id="1" name="美帆" text="『……。』" voices=""/><msg @l="1302" char_id="-1" frame_id="-1" name="奈那子的哥哥" text="『……。』"   voices=""/><msg @l="1304" char_id="0" frame_id="1" name="美帆"   text="『那个……谢、谢谢您。』" voices=""/><msg @l="1306" char_id="-1" frame_id="-1" name="奈那子的哥哥"   text="『……奈那子被你吸引了……。』" voices=""/><char @l="1309" id="miho" pos="right" src="miho064"/><msg @l="1311" char_id="0" frame_id="1" name="美帆" text="『诶……？』" voices=""/><clear @l="1314" class="char"/><char @l="1316" id="miho" pos="auto" src="miho064"/><msg @l="1319" char_id="-1" frame_id="-1" name="奈那子的哥哥"   text="『……我也··虽然不明白其中的理由··……』" voices=""/><msg @l="1320" char_id="-1" frame_id="-1" name=""   text="只留下这一句话，奈那子的哥哥也离开了更衣室。" voices=""/><msg @l="1321" char_id="-1" frame_id="-1" name=""   text="就像他出现时一样，他离去的背影如风般飘然消失。" voices=""/><msg @l="1322" char_id="-1" frame_id="-1" name=""   text="那几乎听不见的低语，究竟是对谁说的呢……。" voices=""/><msg @l="1324" char_id="0" frame_id="1" name="美帆" text="『……。』" voices=""/><char @l="1327" id="miho" pos="auto" src="miho065"/><msg @l="1329" char_id="0" frame_id="1" name="美帆"   text="『到底是怎么回事啊，真是的……理由……我完全搞不懂啊。』" voices=""/><msg @l="1331" char_id="-1" frame_id="-1" name=""   text="被所有人抛在后面，只剩下我一个人，我瘫坐在了原地。" voices=""/><msg @l="1332" char_id="-1" frame_id="-1" name=""   text="我想，我是被从暴力和绝望中拯救出来了……。" voices=""/><msg @l="1333" char_id="-1" frame_id="-1" name="" text="但是……，"   voices=""/><msg @l="1334" char_id="-1" frame_id="-1" name=""   text="不知为何，我的心情阴沉到想哭的地步……。" voices=""/><stopbgm @l="1337" fadeout="1000"/><clear @l="1340" class="all"/><call @l="1343" target="EventLabel_61@root_akina03"/><return @l="1344" value="0&#13;&#10;"/><return @l="1347" value=""/></code></xscript>																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																											