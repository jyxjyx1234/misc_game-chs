<?xml version="1.0" encoding="utf-8"?><xscript><debug editor="&quot;C:\Program&#32;Files&#32;(x86)\sakura\sakura.exe&quot;&#32;&quot;%src%&quot;&#32;-Y=%line%"   src="D:\シロップ\町ぐるみの罠＋汚された夏セット版\汚された夏\完成データ\汚された夏\script\text\root_rei01.txt"/><code><label @l="13" id="EventLabel_130"/><description @l="17" text="室友的忧郁·第一天"/><eval @l="19" expr="f.numDay=5&#13;&#10;"/><msgshow @l="21" show="false"/><wait_chgmv/><bg @l="23" src="day05" time="2000"/><wait @l="25" time="500"/><wait_chgmv/><bg @l="27" src="black" time="2000"/><msgshow @l="29" show="true"/><wait_chgmv/><bg @l="33" src="bg03"/><bgm @l="37" src="bgm04" volume="1."/><char @l="41" id="rei" pos="auto" src="rei010"/><msg @l="43" char_id="1" frame_id="-1" name="玲" text="『多谢款待。』" voices=""/><char @l="47" id="rei" pos="auto" src="rei011"/><msg @l="49" char_id="1" frame_id="-1" name="玲"   text="『那么，不好意思，能帮我收拾一下吗？』" voices=""/><msg @l="51" char_id="-1" frame_id="-1" name=""   text="玲小姐喝完早餐后的咖啡站了起来。" voices=""/><msg @l="52" char_id="-1" frame_id="-1" name=""   text="今天她似乎无论如何都必须从第一节课开始上课。" voices=""/><msg @l="53" char_id="-1" frame_id="-1" name=""   text="为此，如果不搭乘首班电车就来不及了。" voices=""/><clear @l="56" class="char"/><char @l="59" id="rei" pos="left" src="rei010"/><char @l="62" id="miho" pos="right" src="miho031"/><msg @l="64" char_id="0" frame_id="-1" name="美帆"   text="『好的，我只有第三节课，您不用担心请尽管去吧。』" voices=""/><char @l="67" id="rei" pos="left" src="rei111"/><msg @l="69" char_id="1" frame_id="-1" name="玲"   text="『呵呵……感觉和平时角色互换了，真有趣呢。』" voices=""/><char @l="72" id="miho" pos="right" src="miho033"/><msg @l="74" char_id="0" frame_id="-1" name="美帆" text="『您这么一说确实是呢。』"   voices=""/><char @l="78" id="miho" pos="right" src="miho136"/><msg @l="80" char_id="0" frame_id="-1" name="美帆"   text="『不过……求职活动期间还要上课真是辛苦啊。』" voices=""/><char @l="84" id="rei" pos="left" src="rei020"/><msg @l="86" char_id="1" frame_id="-1" name="玲" text="『确实啊……』" voices=""/><char @l="89" id="rei" pos="left" src="rei118"/><msg @l="91" char_id="1" frame_id="-1" name="玲"   text="『如果可能的话，我本想在三年级前把所有学分都修完。』" voices=""/><char @l="95" id="miho" pos="right" src="miho031"/><msg @l="97" char_id="0" frame_id="-1" name="美帆"   text="『虽然很辛苦，但请加油啊。』" voices=""/><char @l="101" id="rei" pos="left" src="rei111"/><msg @l="103" char_id="1" frame_id="-1" name="玲" text="『谢谢。』" voices=""/><msg @l="105" char_id="-1" frame_id="-1" name=""   text="说完这句话，学姐眨了眨眼，然后出门离开了。" voices=""/><stopbgm @l="109" fadeout="1000"/><clear @l="115" class="all"/><msgshow @l="117" show="true"/><bgm @l="120" src="bgm02" volume="1."/><wait_chgmv/><bg @l="124" src="bg09"/><char @l="128" id="miho" pos="auto" src="miho013"/><msg @l="130" char_id="0" frame_id="-1" name="美帆"   text="『嗯～，果然吃完午饭后的课总是让人犯困啊～。』" voices=""/><msg @l="132" char_id="-1" frame_id="-1" name=""   text="第三节课结束后，我和朋友一起走在走廊上。" voices=""/><bgm @l="135" src="bgm06" volume="1."/><msg @l="137" char_id="-1" frame_id="-1" name="女性朋友"   text="『你在说什么啊，你不是只要上重要的课就行了吗。』" voices=""/><char @l="140" id="miho" pos="auto" src="miho010"/><msg @l="142" char_id="-1" frame_id="-1" name="女性朋友"   text="『我们可是从第一节课开始上的。困得要命啊……』" voices=""/><char @l="145" id="miho" pos="auto" src="miho016"/><msg @l="147" char_id="0" frame_id="-1" name="美帆"   text="『我自己也是，第三节课开始的时候……咦？』" voices=""/><char @l="151" id="miho" pos="auto" src="miho114"/><stopbgm @l="155" fadeout="1000"/><msg @l="157" char_id="-1" frame_id="-1" name=""   text="在走廊的一角发现了一张熟悉的面孔，我不由自主地停下了脚步。" voices=""/><msg @l="159" char_id="-1" frame_id="-1" name="女性朋友" text="『怎么了怎么了，出什么事了？』"   voices=""/><char @l="162" id="miho" pos="auto" src="miho016"/><msg @l="164" char_id="0" frame_id="-1" name="美帆"   text="『啊，嗯……我看到那边的人，好像是玲学姐。』" voices=""/><msg @l="166" char_id="-1" frame_id="-1" name="女性朋友"   text="『玲？……哦，美帆的室友啊。』" voices=""/><msg @l="168" char_id="-1" frame_id="-1" name="女性朋友"   text="『嗯——……看起来，她好像在和考古学的朽木教授说话呢。』" voices=""/><char @l="172" id="miho" pos="auto" src="miho116"/><msg @l="174" char_id="0" frame_id="-1" name="美帆" text="『嗯……看起来是这样。』"   voices=""/><clear @l="179" class="char"/><clear @l="185" class="all"/><msgshow @l="187" show="true"/><wait_chgmv/><bg @l="192" src="bg09"/><char @l="196" id="rei" pos="left" src="rei017"/><char @l="199" id="kutsu" pos="right" src="kutsu010"/><bgm @l="203" src="bgm15" volume="1."/><msg @l="205" char_id="1" frame_id="-1" name="玲" text="『那是……什么意思？』"   voices=""/><char @l="208" id="kutsu" pos="right" src="kutsu018"/><msg @l="210" char_id="-1" frame_id="-1" name="朽木"   text="『没什么特别的意思，就是字面上的意思。』" voices=""/><char @l="213" id="rei" pos="left" src="rei027"/><msg @l="215" char_id="1" frame_id="-1" name="玲" text="『我无法接受这样的回答……』"   voices=""/><msg @l="217" char_id="1" frame_id="-1" name="玲"   text="『为什么面试的录取结果，不是就业指导部而是朽木教授您会知道呢？』" voices=""/><msg @l="219" char_id="-1" frame_id="-1" name="朽木"   text="『信息不一定只由特定的人知道，就是这么回事。』" voices=""/><char @l="221" id="rei" pos="left" src="rei117"/><msg @l="223" char_id="1" frame_id="-1" name="玲" text="『请不要敷衍我。』"   voices=""/><char @l="226" id="kutsu" pos="right" src="kutsu010"/><msg @l="228" char_id="-1" frame_id="-1" name="朽木"   text="『我并没有敷衍你。虽然看起来不像，但我的交友圈很广泛。』" voices=""/><msg @l="230" char_id="-1" frame_id="-1" name="朽木"   text="『我有各种各样的人脉。仅此而已。』" voices=""/><char @l="233" id="rei" pos="left" src="rei127"/><msg @l="235" char_id="1" frame_id="-1" name="玲"   text="『原来如此……您是利用这些人脉进行不正当交易的意思吗？』" voices=""/><char @l="238" id="kutsu" pos="right" src="kutsu014"/><msg @l="240" char_id="-1" frame_id="-1" name="朽木"   text="『这话我可不能当作没听见。我什么时候利用这些人脉进行不正当交易了？』" voices=""/><char @l="243" id="rei" pos="left" src="rei017"/><msg @l="245" char_id="1" frame_id="-1" name="玲"   text="『没有证据。但是确实有很多这样的传言在流传。』" voices=""/><char @l="248" id="kutsu" pos="right" src="kutsu018"/><msg @l="250" char_id="-1" frame_id="-1" name="朽木"   text="『相信传言就来无端指责……真是太肤浅了。』" voices=""/><char @l="253" id="rei" pos="left" src="rei027"/><msg @l="255" char_id="1" frame_id="-1" name="玲"   text="『……但是，无风不起浪。』" voices=""/><char @l="258" id="kutsu" pos="right" src="kutsu010"/><msg @l="260" char_id="-1" frame_id="-1" name="朽木"   text="『对任何事都会感到羡慕或嫉妒的人总是存在的。大概是这些人散布了谣言吧。』" voices=""/><char @l="263" id="rei" pos="left" src="rei017"/><msg @l="265" char_id="1" frame_id="-1" name="玲"   text="“那么，教授是出于什么目的来告诉我面试的结果的呢？" voices=""/><msg @l="267" char_id="-1" frame_id="-1" name="朽木"   text="『当然，仅仅是出于善意告诉你罢了。』" voices=""/><char @l="270" id="kutsu" pos="right" src="kutsu018"/><msg @l="272" char_id="-1" frame_id="-1" name="朽木"   text="『事实上……我有向你索要过那个信息的报酬吗？』" voices=""/><char @l="275" id="rei" pos="left" src="rei027"/><msg @l="277" char_id="1" frame_id="-1" name="玲"   text="『的确没有索要。不过从教授的言辞中，我很难相信这只是出于单纯的善意。』" voices=""/><msg @l="279" char_id="-1" frame_id="-1" name="朽木"   text="『那或许是你个人理解上的问题吧？』" voices=""/><char @l="282" id="rei" pos="left" src="rei115"/><msg @l="284" char_id="1" frame_id="-1" name="玲" text="『…唔………。』" voices=""/><char @l="287" id="kutsu" pos="right" src="kutsu010"/><msg @l="289" char_id="-1" frame_id="-1" name="朽木"   text="『我理解在这不景气的时代找工作很辛苦，但如果不让心情放宽松一点，可能会产生奇怪的误解哦。』"   voices=""/><clear @l="292" layer="kutsu"/><char @l="294" id="kutsu" pos="auto" src="kutsu018"/><msg @l="296" char_id="-1" frame_id="-1" name="朽木"   text="『特别是像你这种类型的人容易树敌，最好多加注意。』" voices=""/><char @l="299" id="rei" pos="left" src="rei125"/><msg @l="301" char_id="1" frame_id="-1" name="玲" text="『……谢谢……您的忠告。』"   voices=""/><clear @l="305" class="char"/><char @l="308" id="kutsu" pos="right" src="kutsu018"/><msg @l="310" char_id="-1" frame_id="-1" name="朽木" text="『那么，祝你好运。』"   voices=""/><clear @l="314" layer="kutsu"/><msg @l="316" char_id="-1" frame_id="-1" name=""   text="朽木教授面带奸笑地离开了。" voices=""/><char @l="319" id="rei" pos="left" src="rei015"/><msg @l="321" char_id="1" frame_id="-1" name="玲" text="『……。』" voices=""/><char @l="325" id="rei" pos="left" src="rei027"/><msg @l="327" char_id="1" frame_id="-1" name="玲" text="『……什么“祝你好运”啊。』"   voices=""/><msg @l="329" char_id="-1" frame_id="-1" name=""   text="留在原地的玲愤愤不平地低语道。" voices=""/><msg @l="330" char_id="-1" frame_id="-1" name=""   text="……她那张漂亮的脸上浮现出愤怒的表情。" voices=""/><stopbgm @l="334" fadeout="1000"/><msg @l="336" char_id="0" frame_id="-1" name="美帆" text="『学姐……。』" voices=""/><bgm @l="340" src="bgm07" volume="1."/><char @l="344" id="rei" pos="left" src="rei024"/><msg @l="346" char_id="1" frame_id="-1" name="玲" text="『啊……？』" voices=""/><char @l="350" id="miho" pos="right" src="miho116"/><msg @l="352" char_id="1" frame_id="-1" name="玲" text="『美帆……天啊，你刚才都看到了吗？』"   voices=""/><char @l="356" id="miho" pos="right" src="miho016"/><msg @l="358" char_id="0" frame_id="-1" name="美帆" text="『那个，嗯……虽然我不是故意的。』"   voices=""/><char @l="362" id="rei" pos="left" src="rei113"/><msg @l="364" char_id="1" frame_id="-1" name="玲"   text="『那你应该更早点出声……不过在那种情况下也确实开不了口呢。』" voices=""/><char @l="367" id="miho" pos="right" src="miho116"/><msg @l="369" char_id="0" frame_id="-1" name="美帆" text="『是的……。』" voices=""/><msg @l="371" char_id="-1" frame_id="-1" name=""   text="但我没有勇气插入两人的对话。" voices=""/><char @l="375" id="rei" pos="left" src="rei123"/><msg @l="377" char_id="1" frame_id="-1" name="玲" text="『被你看到奇怪的一面了呢。』"   voices=""/><char @l="380" id="rei" pos="left" src="rei128"/><msg @l="382" char_id="1" frame_id="-1" name="玲"   text="『说实话……我就是不太擅长应付那个朽木教授。』" voices=""/><char @l="386" id="miho" pos="right" src="miho014"/><msg @l="388" char_id="0" frame_id="-1" name="美帆" text="『那是……。』" voices=""/><msg @l="390" char_id="-1" frame_id="-1" name=""   text="我本想问是不是因为变态的事情……，但还是把话咽了回去。" voices=""/><msg @l="391" char_id="-1" frame_id="-1" name="" text="我想起了就在旁边还有朋友在。"   voices=""/><char @l="395" id="rei" pos="left" src="rei021"/><msg @l="397" char_id="1" frame_id="-1" name="玲" text="『不，跟那件事没关系。』"   voices=""/><msg @l="399" char_id="-1" frame_id="-1" name=""   text="学姐似乎注意到了我的欲言又止，笑着这样说道。" voices=""/><char @l="402" id="miho" pos="right" src="miho010"/><char @l="406" id="rei" pos="left" src="rei128"/><msg @l="408" char_id="1" frame_id="-1" name="玲"   text="『只是莫名其妙地……硬要说的话，大概是一种生理上的反感吧。』" voices=""/><char @l="411" id="miho" pos="right" src="miho116"/><msg @l="413" char_id="0" frame_id="-1" name="美帆" text="『是这样啊……。』"   voices=""/><stopbgm @l="416" fadeout="1000"/><msg @l="418" char_id="-1" frame_id="-1" name=""   text="虽然玲学姐说与那件事无关，但我确信那多少还是给她留下了负面印象。" voices=""/><msg @l="419" char_id="-1" frame_id="-1" name=""   text="这么想来……难道是我造成了刚才那场争执的契机吗？" voices=""/><msg @l="420" char_id="-1" frame_id="-1" name="" text="总觉得……很没面子。"   voices=""/><bgm @l="423" src="bgm06" volume="1."/><msg @l="425" char_id="-1" frame_id="-1" name="女性朋友"   text="『那个～……我从刚才开始就一直听不懂你们在说什么啊。』" voices=""/><char @l="428" id="miho" pos="right" src="miho114"/><msg @l="430" char_id="-1" frame_id="-1" name=""   text="也许是看不下去我奇怪地沉默的样子，朋友探出头来，用轻松的语气插话道。" voices=""/><msg @l="431" char_id="-1" frame_id="-1" name=""   text="姑且……她可能是在为我着想吧。" voices=""/><char @l="435" id="rei" pos="left" src="rei014"/><msg @l="437" char_id="1" frame_id="-1" name="玲" text="『哎呀，这位是美帆的朋友？』"   voices=""/><char @l="441" id="miho" pos="right" src="miho011"/><msg @l="443" char_id="0" frame_id="-1" name="美帆"   text="『啊，是的……我们上同一门课。』" voices=""/><char @l="447" id="rei" pos="left" src="rei021"/><msg @l="449" char_id="1" frame_id="-1" name="玲" text="『真不好意思，打扰你们了。』"   voices=""/><msg @l="451" char_id="-1" frame_id="-1" name="女性朋友"   text="『没关系，我一点都不在意。』" voices=""/><char @l="454" id="miho" pos="right" src="miho110"/><char @l="457" id="rei" pos="left" src="rei111"/><msg @l="459" char_id="1" frame_id="-1" name="玲" text="『是吗，那就好。』"   voices=""/><char @l="463" id="rei" pos="left" src="rei110"/><msg @l="465" char_id="1" frame_id="-1" name="玲" text="『美帆……你现在要回去了吗？』"   voices=""/><char @l="468" id="miho" pos="right" src="miho010"/><msg @l="470" char_id="0" frame_id="-1" name="美帆" text="『是的。』" voices=""/><char @l="473" id="rei" pos="left" src="rei121"/><msg @l="475" char_id="1" frame_id="-1" name="玲"   text="『那我们一起走吧？我还想请你帮忙买晚饭的食材。』" voices=""/><char @l="478" id="miho" pos="right" src="miho011"/><msg @l="480" char_id="0" frame_id="-1" name="美帆" text="『好的，我去！』"   voices=""/><char @l="483" id="rei" pos="left" src="rei110"/><char @l="486" id="miho" pos="right" src="miho013"/><msg @l="488" char_id="0" frame_id="-1" name="美帆" text="『那个……你怎么办？要一起来吗？』"   voices=""/><msg @l="490" char_id="-1" frame_id="-1" name="" text="我这样问着，看向朋友。"   voices=""/><msg @l="492" char_id="-1" frame_id="-1" name="女性朋友" text="『啊，我还有课要上。』"   voices=""/><char @l="495" id="miho" pos="right" src="miho116"/><msg @l="497" char_id="0" frame_id="-1" name="美帆" text="『这样啊，那我们就在这里分开吧。』"   voices=""/><msg @l="499" char_id="-1" frame_id="-1" name="女性朋友" text="『好啊。下周一见。』"   voices=""/><char @l="502" id="miho" pos="right" src="miho111"/><msg @l="504" char_id="0" frame_id="-1" name="美帆" text="『拜拜。』" voices=""/><msg @l="506" char_id="-1" frame_id="-1" name=""   text="我的朋友向玲轻轻点头示意，然后回到了教室。" voices=""/><bgm @l="509" src="bgm07" volume="1."/><char @l="513" id="rei" pos="left" src="rei011"/><msg @l="515" char_id="1" frame_id="-1" name="玲" text="『你的朋友，是个挺不错的孩子嘛。』"   voices=""/><char @l="518" id="miho" pos="right" src="miho016"/><msg @l="520" char_id="0" frame_id="-1" name="美帆" text="『啊哈哈……虽然她有点强势就是了。』"   voices=""/><char @l="524" id="rei" pos="left" src="rei020"/><msg @l="526" char_id="1" frame_id="-1" name="玲"   text="『美帆的朋友，这种程度刚刚好哦。』" voices=""/><char @l="530" id="miho" pos="right" src="miho116"/><msg @l="532" char_id="0" frame_id="-1" name="美帆" text="『是这样吗？』" voices=""/><msg @l="534" char_id="-1" frame_id="-1" name=""   text="我带着苦笑，走到玲的身旁并肩前行。" voices=""/><char @l="538" id="rei" pos="left" src="rei111"/><msg @l="540" char_id="1" frame_id="-1" name="玲" text="『当然是了。』" voices=""/><msg @l="542" char_id="-1" frame_id="-1" name=""   text="玲看着我鼓起的脸颊，咯咯地笑了起来。" voices=""/><stopbgm @l="546" fadeout="1000"/><clear @l="552" class="all"/><msgshow @l="554" show="true"/><wait_chgmv/><bg @l="558" src="bg03b"/><bgm @l="562" src="bgm05" volume="1."/><char @l="566" id="rei" pos="left" src="rei114"/><char @l="570" id="miho" pos="right" src="miho116"/><msg @l="572" char_id="1" frame_id="-1" name="玲" text="『我回来啦。』" voices=""/><msg @l="574" char_id="0" frame_id="-1" name="美帆" text="『呼……终于到家了呢。』"   voices=""/><msg @l="576" char_id="-1" frame_id="-1" name=""   text="我们两手提满了购物袋。" voices=""/><msg @l="577" char_id="-1" frame_id="-1" name=""   text="本来只打算买晚饭的材料，却不自觉地逛起了洋装和包包等各种东西，结果连不必要的物品也买了不少。"   voices=""/><char @l="581" id="rei" pos="left" src="rei128"/><msg @l="583" char_id="1" frame_id="-1" name="玲" text="『啊～……肩膀，都快脱臼了。』"   voices=""/><char @l="587" id="miho" pos="right" src="miho011"/><msg @l="589" char_id="0" frame_id="-1" name="美帆"   text="『不过难得能橱窗购物，还挺开心的。』" voices=""/><msg @l="591" char_id="-1" frame_id="-1" name=""   text="进入客厅后，我把东西放在地板上，松了口气。" voices=""/><char @l="595" id="miho" pos="right" src="miho111"/><msg @l="597" char_id="0" frame_id="-1" name="美帆"   text="『先泡杯咖啡吧。』" voices=""/><char @l="601" id="rei" pos="left" src="rei118"/><msg @l="603" char_id="1" frame_id="-1" name="玲"   text="『嗯……整理的事情稍后再说，先休息一下吧。』" voices=""/><char @l="607" id="miho" pos="right" src="miho016"/><msg @l="609" char_id="0" frame_id="-1" name="美帆" text="『好的。』" voices=""/><clear @l="613" layer="miho"/><clear @l="615" layer="rei"/><msg @l="617" char_id="-1" frame_id="-1" name=""   text="我边苦笑着……边走向厨房。" voices=""/><msg @l="618" char_id="-1" frame_id="-1" name=""   text="从橱柜里拿出咖啡机，打开了开关。" voices=""/><msg @l="619" char_id="-1" frame_id="-1" name="" text="接下来只需等它煮好就行了。"   voices=""/><char @l="623" id="rei" pos="left" src="rei123"/><msg @l="625" char_id="0" frame_id="-1" name="美帆" text="『玲姐，我已经设置好了～。』"   voices=""/><msg @l="628" char_id="1" frame_id="-1" name="玲" text="『……。』" voices=""/><msg @l="630" char_id="0" frame_id="-1" name="美帆" text="『……玲姐？』" voices=""/><msg @l="632" char_id="-1" frame_id="-1" name=""   text="从厨房往客厅看去，只见玲姐正盯着从信箱里拿出的信封发呆。" voices=""/><char @l="636" id="miho" pos="right" src="miho110"/><msg @l="638" char_id="0" frame_id="-1" name="美帆" text="『玲姐，怎么了？』"   voices=""/><char @l="642" id="rei" pos="left" src="rei124"/><msg @l="644" char_id="1" frame_id="-1" name="玲" text="『啊，对不起。』"   voices=""/><char @l="648" id="rei" pos="left" src="rei010"/><msg @l="650" char_id="1" frame_id="-1" name="玲"   text="『昨天说的大黑建设公司，寄来了一封信。』" voices=""/><stopbgm @l="654" fadeout="1000"/><char @l="657" id="miho" pos="right" src="miho014"/><msg @l="659" char_id="0" frame_id="-1" name="美帆" text="『是录取通知吗？』"   voices=""/><msg @l="661" char_id="1" frame_id="-1" name="玲" text="『应该是吧。』" voices=""/><msg @l="663" char_id="-1" frame_id="-1" name=""   text="说着，她打开了信封，从里面拿出一张纸。" voices=""/><char @l="667" id="miho" pos="right" src="miho116"/><msg @l="669" char_id="0" frame_id="-1" name="美帆" text="『怎么样……？』"   voices=""/><msg @l="671" char_id="1" frame_id="-1" name="玲"   text="『嗯……在本公司最近进行的笔试中，我们很高兴地通知您已经通过了考试。』" voices=""/><char @l="674" id="rei" pos="left" src="rei013"/><msg @l="676" char_id="1" frame_id="-1" name="玲"   text="『接下来我们将进行面试，请携带本信及随函附上的证明书前来本公司。』" voices=""/><msg @l="678" char_id="1" frame_id="-1" name="玲" text="『……就是这样。』" voices=""/><bgm @l="682" src="bgm02" volume="1."/><char @l="686" id="miho" pos="right" src="miho011"/><msg @l="688" char_id="0" frame_id="-1" name="美帆" text="『太厉害了，你通过了！』"   voices=""/><char @l="692" id="rei" pos="left" src="rei021"/><msg @l="694" char_id="1" frame_id="-1" name="玲" text="『谢谢。』" voices=""/><char @l="698" id="rei" pos="left" src="rei118"/><msg @l="700" char_id="1" frame_id="-1" name="玲"   text="『不过，这只是笔试而已。真正困难的才刚开始呢。』" voices=""/><char @l="703" id="miho" pos="right" src="miho111"/><msg @l="705" char_id="0" frame_id="-1" name="美帆"   text="『但是，不管怎么说你已经向前迈出了一步呢。』" voices=""/><char @l="708" id="rei" pos="left" src="rei021"/><msg @l="710" char_id="1" frame_id="-1" name="玲"   text="『是啊。坦率地为这一点高兴一下应该不会遭天谴吧。』" voices=""/><msg @l="712" char_id="0" frame_id="-1" name="美帆" text="『当然不会。』" voices=""/><char @l="715" id="miho" pos="right" src="miho011"/><msg @l="717" char_id="0" frame_id="-1" name="美帆"   text="『那么，今天为了庆祝，我要大显身手做一顿美味的饭菜。』" voices=""/><char @l="721" id="rei" pos="left" src="rei111"/><msg @l="723" char_id="1" frame_id="-1" name="玲" text="『哎呀，那我就不客气地享用啦。』"   voices=""/><char @l="726" id="miho" pos="right" src="miho013"/><msg @l="728" char_id="0" frame_id="-1" name="美帆" text="『交给我吧！』"   voices=""/><stopbgm @l="732" fadeout="1000"/><clear @l="738" class="all"/><bgm @l="742" src="bgm05" volume="1."/><wait_chgmv/><bg @l="746" src="bg03b"/><char @l="750" id="rei" pos="auto" src="rei031"/><msg @l="752" char_id="1" frame_id="-1" name="玲" text="『多谢款待。』" voices=""/><clear @l="755" class="char"/><char @l="757" id="rei" pos="left" src="rei031"/><char @l="760" id="miho" pos="right" src="miho031"/><msg @l="762" char_id="0" frame_id="-1" name="美帆" text="『哪里，招待不周。』"   voices=""/><msg @l="764" char_id="-1" frame_id="-1" name=""   text="晚餐结束后，我把空盘子搬到厨房。" voices=""/><msg @l="765" char_id="-1" frame_id="-1" name=""   text="今天的菜单是美帆特制的蛋包饭和煎鸡肉，还有清汤和新鲜蔬菜沙拉……作为庆祝餐是不是有点简朴了呢。"   voices=""/><msg @l="766" char_id="-1" frame_id="-1" name=""   text="不过，因为并非是预先以庆祝为前提购买的食材，所以我认为这已经是尽了最大努力了。" voices=""/><char @l="770" id="miho" pos="right" src="miho034"/><msg @l="772" char_id="0" frame_id="-1" name="美帆"   text="『说起来，下一次面试是什么时候？』" voices=""/><char @l="775" id="rei" pos="left" src="rei030"/><msg @l="777" char_id="1" frame_id="-1" name="玲" text="『据说是周一中午开始。』"   voices=""/><char @l="780" id="miho" pos="right" src="miho134"/><msg @l="782" char_id="0" frame_id="-1" name="美帆" text="『时间安排得相当紧凑呢？』"   voices=""/><char @l="786" id="rei" pos="left" src="rei031"/><msg @l="788" char_id="1" frame_id="-1" name="玲"   text="『是啊……不过，总比要等几周好吧。』" voices=""/><char @l="792" id="miho" pos="right" src="miho031"/><msg @l="794" char_id="0" frame_id="-1" name="美帆" text="『啊哈哈……也是呢。』"   voices=""/><char @l="798" id="rei" pos="left" src="rei030"/><msg @l="800" char_id="1" frame_id="-1" name="玲"   text="『与大企业打交道的时候通常都是这种感觉。』" voices=""/><char @l="803" id="rei" pos="left" src="rei031"/><msg @l="805" char_id="1" frame_id="-1" name="玲"   text="『考试结束不到一周就收到回复，已经算是很快的了。』" voices=""/><char @l="809" id="miho" pos="right" src="miho031"/><msg @l="811" char_id="0" frame_id="-1" name="美帆"   text="『这不正说明他们对你很期待吗？』" voices=""/><char @l="814" id="rei" pos="left" src="rei033"/><msg @l="816" char_id="1" frame_id="-1" name="玲" text="『如果是这样的话，我会很高兴的。』"   voices=""/><char @l="819" id="rei" pos="left" src="rei030"/><msg @l="821" char_id="1" frame_id="-1" name="玲"   text="『……不过，结果本身似乎更早就出来了。』" voices=""/><stopbgm @l="825" fadeout="1000"/><char @l="829" id="miho" pos="right" src="miho034"/><msg @l="831" char_id="0" frame_id="-1" name="美帆" text="『诶……？』" voices=""/><char @l="835" id="rei" pos="left" src="rei031"/><msg @l="837" char_id="1" frame_id="-1" name="玲" text="『啊，没什么……没什么。』"   voices=""/><char @l="841" id="rei" pos="left" src="rei030"/><msg @l="843" char_id="1" frame_id="-1" name="玲"   text="『话说回来，我想洗个澡……可以先用浴室吗？』" voices=""/><char @l="847" id="miho" pos="right" src="miho131"/><msg @l="849" char_id="0" frame_id="-1" name="美帆"   text="『没问题。我还有碗要洗。』" voices=""/><char @l="852" id="rei" pos="left" src="rei031"/><msg @l="854" char_id="1" frame_id="-1" name="玲" text="『谢谢，那我就先去了。』"   voices=""/><clear @l="858" layer="rei"/><msg @l="860" char_id="-1" frame_id="-1" name=""   text="说完，玲小姐向自己房间走去拿换洗衣物。" voices=""/><char @l="864" id="miho" pos="right" src="miho034"/><bgm @l="867" src="bgm03" volume="1."/><msg @l="869" char_id="0" frame_id="-1" name="美帆" text="『咦……？』" voices=""/><clear @l="873" layer="miho"/><msg @l="875" char_id="-1" frame_id="-1" name=""   text="我注意到客厅桌子旁边掉了什么东西，便捡了起来。" voices=""/><msg @l="876" char_id="-1" frame_id="-1" name=""   text="那是刚才看到的大黑建设的面试结果通知书。" voices=""/><msg @l="877" char_id="-1" frame_id="-1" name=""   text="好像在带回房间的时候，只有里面的信掉出来了。" voices=""/><msg @l="879" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="881" char_id="0" frame_id="-1" name="美帆"   text="『和朽木教授谈话的事……果然是关于这个吗。』" voices=""/><msg @l="883" char_id="-1" frame_id="-1" name=""   text="我回想起中午在大学走廊里争论的那两个人的对话。" voices=""/><msg @l="884" char_id="-1" frame_id="-1" name=""   text="信息怎么样啦合格与否怎么样啦，确实是在说那样的事情。" voices=""/><msg @l="885" char_id="-1" frame_id="-1" name="" text="还有……刚才学姐的低语。"   voices=""/><msg @l="886" char_id="-1" frame_id="-1" name=""   text="果然那时候谈论的内容，就是关于这封信上写的事情吧，我不禁这么想。" voices=""/><msg @l="888" char_id="0" frame_id="-1" name="美帆"   text="『这种事……我担心也没用吧……。』" voices=""/><msg @l="890" char_id="-1" frame_id="-1" name=""   text="而且我对朽木教授抱有不好的感情，所以才会冒出负面的想法，实际上可能只是小事一桩。"   voices=""/><char @l="893" id="miho" pos="auto" src="miho030"/><msg @l="895" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><char @l="898" id="miho" pos="auto" src="miho036"/><bgm @l="900" src="bgm02" volume="1."/><msg @l="902" char_id="0" frame_id="-1" name="美帆"   text="『总之……现在得先收拾好这些东西。』" voices=""/><msg @l="904" char_id="-1" frame_id="-1" name=""   text="看着水槽里排列的餐具，我像是在自言自语般低声说道。" voices=""/><stopbgm @l="908" fadeout="1000"/><clear @l="914" class="all"/><call @l="918" target="EventLabel_131@root_rei02"/><return @l="919" value="0&#13;&#10;"/><return @l="923" value=""/></code></xscript>																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																															