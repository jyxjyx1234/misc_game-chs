<?xml version="1.0" encoding="utf-8"?><xscript><debug editor="&quot;C:\Program&#32;Files&#32;(x86)\sakura\sakura.exe&quot;&#32;&quot;%src%&quot;&#32;-Y=%line%"   src="D:\シロップ\町ぐるみの罠＋汚された夏セット版\汚された夏\完成データ\汚された夏\script\text\root_kutuki04a.txt"/><code><label @l="10" id="EventLabel_123"/><description @l="14" text="朽木的奴隶·第3天"/><eval @l="16" expr="f.numDay=9&#13;&#10;"/><msgshow @l="18" show="false"/><wait_chgmv/><bg @l="20" src="day09" time="2000"/><wait @l="22" time="500"/><wait_chgmv/><bg @l="24" src="black" time="2000"/><msgshow @l="26" show="true"/><wait_chgmv/><bg @l="29" src="bg08m1"/><bgm @l="32" src="bgm02" volume="1."/><msg @l="34" char_id="-1" frame_id="-1" name="朽木"   text="『那么，现在开始发还上周进行的考卷。』" voices=""/><msg @l="36" char_id="-1" frame_id="-1" name=""   text="朽木教授那带着几分高压的声音回荡在安静的讲堂里。" voices=""/><msg @l="37" char_id="-1" frame_id="-1" name=""   text="他负责的考古学……是今天最后一节课。" voices=""/><msg @l="39" char_id="-1" frame_id="-1" name="朽木"   text="『叫到名字的人依次到前面来领取。』" voices=""/><msg @l="41" char_id="-1" frame_id="-1" name="学生A" text="『哦——』" voices=""/><msg @l="43" char_id="-1" frame_id="-1" name="学生B" text="『啊——……噩梦啊，噩梦来临了。』"   voices=""/><msg @l="45" char_id="-1" frame_id="-1" name="学生C"   text="『……不是吧，上周有考试吗？』" voices=""/><msg @l="47" char_id="-1" frame_id="-1" name="" text="教室各处传出各种各样的议论声。"   voices=""/><msg @l="49" char_id="0" frame_id="-1" name="美帆"   text="(话说回来，我好像没参加考试……)" voices=""/><msg @l="51" char_id="-1" frame_id="-1" name=""   text="看着站在讲台上的朽木教授的身影，我思考着这样的事情。" voices=""/><msg @l="52" char_id="-1" frame_id="-1" name=""   text="考试那天，我躲在他脚下的讲台背面。" voices=""/><msg @l="53" char_id="-1" frame_id="-1" name=""   text="在大家正常参加考试的时候……我却。" voices=""/><msg @l="55" char_id="0" frame_id="-1" name="美帆"   text="(还是别想了……想这些也没什么用)" voices=""/><msg @l="57" char_id="-1" frame_id="-1" name="朽木" text="『北原。』" voices=""/><msg @l="59" char_id="-1" frame_id="-1" name="北原" text="『在～』" voices=""/><msg @l="61" char_id="-1" frame_id="-1" name=""   text="朽木教授一个接一个地发还着试卷。" voices=""/><stopbgm @l="64" fadeout="1000"/><msg @l="66" char_id="0" frame_id="-1" name="美帆" text="(咦……？)" voices=""/><msg @l="68" char_id="-1" frame_id="-1" name=""   text="忽然，我注意到发还试卷的朽木教授时不时对前来领取试卷的学生耳语着什么。"   voices=""/><msg @l="69" char_id="-1" frame_id="-1" name=""   text="而且都是对考试成绩好的人……" voices=""/><msg @l="71" char_id="0" frame_id="-1" name="美帆" text="(他在……干什么呢？)"   voices=""/><msg @l="73" char_id="-1" frame_id="-1" name=""   text="之后，教授依然以每几个人中就有一个的比例在进行着类似耳语的行为。" voices=""/><msg @l="74" char_id="-1" frame_id="-1" name=""   text="而且仔细观察的话，对象全都是男生。" voices=""/><msg @l="76" char_id="0" frame_id="-1" name="美帆" text="(不像是在……鼓励吧)"   voices=""/><msg @l="78" char_id="0" frame_id="-1" name="美帆"   text="(如果是鼓励的话，应该是对考得不好的人说才对)" voices=""/><msg @l="80" char_id="0" frame_id="-1" name="美帆"   text="(那样的话……是在表扬考得好的人吗？)" voices=""/><msg @l="82" char_id="-1" frame_id="-1" name="朽木" text="『仲根。』" voices=""/><msg @l="84" char_id="0" frame_id="-1" name="美帆"   text="(这次考试，女生的分数都不太好吗……)" voices=""/><msg @l="86" char_id="-1" frame_id="-1" name="朽木"   text="『仲根美帆同学，今天是缺席了吗？』" voices=""/><char @l="89" id="miho" pos="auto" src="miho114"/><msg @l="91" char_id="0" frame_id="-1" name="美帆" text="『诶……啊，在！？』"   voices=""/><msg @l="93" char_id="-1" frame_id="-1" name=""   text="注意到教授在叫我的名字，我慌忙站了起来。" voices=""/><msg @l="95" char_id="-1" frame_id="-1" name="朽木"   text="『快点来领取试卷。』" voices=""/><msg @l="97" char_id="0" frame_id="-1" name="美帆" text="『好、好的！』" voices=""/><clear @l="100" class="char"/><bgm @l="103" src="bgm03" volume="1."/><msg @l="105" char_id="0" frame_id="-1" name="美帆"   text="(我……明明没参加考试……为什么？)" voices=""/><msg @l="107" char_id="-1" frame_id="-1" name=""   text="虽然内心这么想，但也不能说出口……我慌忙跑到讲台前。" voices=""/><msg @l="109" char_id="-1" frame_id="-1" name="朽木" text="『拿去吧。』"   voices=""/><msg @l="111" char_id="-1" frame_id="-1" name=""   text="站在讲台前，教授冷淡地这么说着，将试卷递给我。" voices=""/><msg @l="113" char_id="0" frame_id="-1" name="美帆" text="(诶……满分？)" voices=""/><msg @l="115" char_id="-1" frame_id="-1" name=""   text="交给我的试卷上答案都写得整整齐齐，甚至还体贴地标明了我的名字。" voices=""/><msg @l="116" char_id="-1" frame_id="-1" name=""   text="只是……那字迹明显不是我的。" voices=""/><msg @l="118" char_id="-1" frame_id="-1" name="朽木" text="『这是对你服务的评价。』"   voices=""/><msg @l="120" char_id="0" frame_id="-1" name="美帆" text="『啊……。』" voices=""/><msg @l="122" char_id="-1" frame_id="-1" name=""   text="也就是说，他指的是上周考试期间我在讲台后面用嘴进行的那种服务吧。" voices=""/><bgm @l="125" src="bgm09" volume="1."/><msg @l="127" char_id="-1" frame_id="-1" name="朽木"   text="『另外……这节课结束后来我的房间。』" voices=""/><msg @l="129" char_id="-1" frame_id="-1" name="朽木"   text="『我为你准备了精彩的余兴节目。』" voices=""/><msg @l="131" char_id="0" frame_id="-1" name="美帆" text="『……！？』" voices=""/><msg @l="133" char_id="-1" frame_id="-1" name=""   text="听到他在耳边低语的话，我不由得脸色苍白。" voices=""/><msg @l="134" char_id="-1" frame_id="-1" name=""   text="没想到他竟然会在这种地方，而且是直接开口说出这种事情。" voices=""/><msg @l="136" char_id="-1" frame_id="-1" name="朽木" text="『回答呢？』"   voices=""/><msg @l="138" char_id="0" frame_id="-1" name="美帆" text="『我……我知道了。』"   voices=""/><msg @l="140" char_id="-1" frame_id="-1" name="朽木" text="『很好。那就回到座位上去吧。』"   voices=""/><msg @l="142" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><clear @l="145" class="all"/><msg @l="147" char_id="-1" frame_id="-1" name="朽木" text="『野村。』" voices=""/><msg @l="149" char_id="-1" frame_id="-1" name=""   text="当我转身回到自己座位时，从我背后响起了教授呼唤下一位学生的声音。" voices=""/><msg @l="150" char_id="-1" frame_id="-1" name="" text="但那声音并没有传入我的耳中……。"   voices=""/><msg @l="151" char_id="-1" frame_id="-1" name=""   text="我满脑子都在担心刚才的对话是否被周围的人听到了。" voices=""/><msg @l="153" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="155" char_id="-1" frame_id="-1" name="" text="所以，我没有注意到。"   voices=""/><msg @l="156" char_id="-1" frame_id="-1" name=""   text="我没注意到在我之后，他也对那位考试成绩优秀的男生耳语道“讲课结束后到教授室来”这件事。"   voices=""/><stopbgm @l="159" fadeout="1000"/><clear @l="162" class="all"/><msgshow @l="164" show="true"/><wait_chgmv/><bg @l="167" src="bg09"/><bgm @l="170" src="bgm03" volume="1."/><char @l="173" id="miho" pos="auto" src="miho116"/><msg @l="175" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="177" char_id="-1" frame_id="-1" name="" text="讲课结束后约二十分钟。"   voices=""/><msg @l="178" char_id="-1" frame_id="-1" name=""   text="我坐在走廊旁边的长椅上，观察着合适的时机去拜访教授室。" voices=""/><msg @l="179" char_id="-1" frame_id="-1" name=""   text="在人来人往的环境中，我不太想去拜访他的教授室。" voices=""/><msg @l="181" char_id="0" frame_id="-1" name="美帆"   text="(话说回来……刚才那个，到底是怎么回事呢)" voices=""/><msg @l="183" char_id="-1" frame_id="-1" name=""   text="明明用邮件叫我过去就足够了，为什么偏偏要在那种可能被别人听到的场合跟我耳语呢。"   voices=""/><msg @l="185" char_id="0" frame_id="-1" name="美帆" text="(是在……捉弄我吗？)"   voices=""/><msg @l="187" char_id="-1" frame_id="-1" name="" text="这种可能性完全存在。"   voices=""/><msg @l="188" char_id="-1" frame_id="-1" name=""   text="为了自己的乐趣，他可能会不顾一些风险也要执行。" voices=""/><msg @l="189" char_id="-1" frame_id="-1" name=""   text="或者说，如果不是这样，他根本不会染指猥亵行为。" voices=""/><msg @l="191" char_id="0" frame_id="-1" name="美帆"   text="(啊，说起来他好像也在对我以外的人耳语……)" voices=""/><msg @l="193" char_id="0" frame_id="-1" name="美帆"   text="(不过，除了我之外都是男生……或许没关系吧)" voices=""/><msg @l="195" char_id="0" frame_id="-1" name="美帆"   text="(应该……不会去叫其他人之类的吧)" voices=""/><msg @l="197" char_id="-1" frame_id="-1" name=""   text="一边想着这些……我喝了一口从自动贩卖机买的奶茶。" voices=""/><msg @l="199" char_id="0" frame_id="-1" name="美帆"   text="(人也差不多都走光了……应该可以了吧)" voices=""/><msg @l="201" char_id="-1" frame_id="-1" name=""   text="我把空罐子扔进自动贩卖机旁边的垃圾桶，向教授室走去。" voices=""/><msg @l="202" char_id="-1" frame_id="-1" name=""   text="却不知道在前方……等待着我的是巨大的绝望。" voices=""/><clear @l="205" class="all"/><wait_chgmv/><bg @l="208" src="bg12"/><bgm @l="211" src="bgm15" volume="1."/><char @l="214" id="miho" pos="auto" src="miho015"/><msg @l="216" char_id="0" frame_id="-1" name="美帆" text="『这是……什么意思啊。』"   voices=""/><clear @l="219" class="char"/><char @l="221" id="miho" pos="right" src="miho015"/><char @l="223" id="kutsu" pos="left" src="kutsu010"/><msg @l="225" char_id="-1" frame_id="-1" name="朽木"   text="『我不是说过了吗，准备了精彩的余兴节目。』" voices=""/><msg @l="227" char_id="-1" frame_id="-1" name="朽木" text="『这就是那个余兴节目啊。』"   voices=""/><msg @l="229" char_id="-1" frame_id="-1" name=""   text="说着，教授看向站在房间墙边的男学生们。" voices=""/><msg @l="230" char_id="-1" frame_id="-1" name=""   text="刚才在讲座上……是教授在耳语的那些人。" voices=""/><msg @l="231" char_id="-1" frame_id="-1" name=""   text="他们都带着某种奇怪的表情看着我和教授的对话。" voices=""/><msg @l="232" char_id="-1" frame_id="-1" name="" text="看来他们并没有被告知情况。"   voices=""/><char @l="235" id="miho" pos="right" src="miho115"/><msg @l="237" char_id="0" frame_id="-1" name="美帆" text="『余兴节目怎么会是这种！』"   voices=""/><msg @l="239" char_id="-1" frame_id="-1" name="朽木" text="『仲根同学……。』"   voices=""/><msg @l="241" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><clear @l="244" layer="kutsu"/><char @l="246" id="kutsu" pos="auto" src="kutsu018"/><msg @l="248" char_id="-1" frame_id="-1" name="朽木"   text="『你只要按照我说的做就好了，不是吗？』" voices=""/><msg @l="250" char_id="0" frame_id="-1" name="美帆" text="『……是。』" voices=""/><msg @l="252" char_id="-1" frame_id="-1" name="朽木" text="『那就乖乖听话照做吧。』"   voices=""/><msg @l="254" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><char @l="258" id="kutsu" pos="auto" src="kutsu010"/><msg @l="260" char_id="-1" frame_id="-1" name="朽木"   text="『那么……各位，让你们久等了，非常抱歉。』" voices=""/><msg @l="262" char_id="-1" frame_id="-1" name="朽木"   text="『今天邀请你们来这里，就是为了给你们这些成绩优秀的人一些“奖励”。』" voices=""/><msg @l="264" char_id="-1" frame_id="-1" name="学生A" text="『奖励……吗？』"   voices=""/><msg @l="266" char_id="-1" frame_id="-1" name="学生B" text="『是现金奖励之类的？』"   voices=""/><msg @l="268" char_id="-1" frame_id="-1" name="学生C"   text="『肯定就是笔记本和圆珠笔吧。』" voices=""/><msg @l="270" char_id="-1" frame_id="-1" name="学生D" text="『嗯，可能就那种东西吧。』"   voices=""/><msg @l="272" char_id="-1" frame_id="-1" name="朽木"   text="『呵呵，这是比你们想象中要好得多的奖励哦。』" voices=""/><msg @l="274" char_id="-1" frame_id="-1" name="朽木" text="『仲根同学。』" voices=""/><clear @l="277" class="char"/><char @l="279" id="kutsu" pos="auto" src="kutsu010"/><char @l="281" id="miho" pos="right" src="miho015"/><msg @l="283" char_id="0" frame_id="-1" name="美帆" text="『……是。』" voices=""/><msg @l="285" char_id="-1" frame_id="-1" name="朽木"   text="『请脱掉衣服，趴在那边的桌子上。』" voices=""/><msg @l="287" char_id="0" frame_id="-1" name="美帆" text="『我明……明白了。』"   voices=""/><clear @l="290" layer="miho"/><msg @l="292" char_id="-1" frame_id="-1" name="学生A" text="『诶……？』" voices=""/><msg @l="294" char_id="-1" frame_id="-1" name=""   text="男生们因教授的话语感到震惊,一片骚动,我瞥了他们一眼,按照他的命令开始脱衣服。" voices=""/><char @l="297" id="kutsu" pos="auto" src="kutsu018"/><char @l="299" id="miho" pos="right" src="miho185"/><msg @l="301" char_id="0" frame_id="-1" name="美帆" text="『这样可以了吗……？』"   voices=""/><msg @l="303" char_id="-1" frame_id="-1" name="朽木" text="『内衣也全部脱掉。』"   voices=""/><msg @l="305" char_id="0" frame_id="-1" name="美帆" text="『……是……。』"   voices=""/><clear @l="308" layer="miho"/><msg @l="310" char_id="-1" frame_id="-1" name="学生B" text="『………。』" voices=""/><msg @l="312" char_id="-1" frame_id="-1" name="学生C" text="『………。』" voices=""/><msg @l="314" char_id="-1" frame_id="-1" name=""   text="当我的手指触碰到文胸的搭扣时,几个男学生咽了咽口水,目不转睛地盯着我的胸部。" voices=""/><msg @l="316" char_id="0" frame_id="-1" name="美帆" text="『………。』" voices=""/><msg @l="318" char_id="-1" frame_id="-1" name=""   text="在承受着那几乎要刺痛皮肤的目光中……我缓缓解开了文胸。" voices=""/><msg @l="320" char_id="-1" frame_id="-1" name="学生B" text="『哦哦！』" voices=""/><msg @l="322" char_id="-1" frame_id="-1" name="学生C" text="『太厉害了……她真的脱了。』"   voices=""/><msg @l="324" char_id="-1" frame_id="-1" name="" text="教室里响起了小小的欢呼声。"   voices=""/><msg @l="325" char_id="-1" frame_id="-1" name=""   text="我忍不住想要立刻逃离这个地方，但教授的目光让我连这样做的勇气都没有。" voices=""/><msg @l="327" char_id="0" frame_id="-1" name="美帆" text="『……唔…。』" voices=""/><msg @l="329" char_id="-1" frame_id="-1" name=""   text="我像是下定了决心一般，一口气脱下内裤……扔在一旁。" voices=""/><msg @l="330" char_id="-1" frame_id="-1" name=""   text="然后，慢吞吞地趴在了桌子上。" voices=""/><msg @l="331" char_id="-1" frame_id="-1" name="" text="到了这一步……已经不允许回头了。"   voices=""/><char @l="334" id="miho" pos="right" src="miho105"/><char @l="336" id="kutsu" pos="auto" src="kutsu010"/><msg @l="338" char_id="-1" frame_id="-1" name="朽木"   text="『这是我给予的奖赏，请随意享用她吧。』" voices=""/><msg @l="340" char_id="-1" frame_id="-1" name="学生A"   text="『强奸……真、真的吗……。』" voices=""/><msg @l="342" char_id="-1" frame_id="-1" name="学生B" text="『这、这样真的可以吗！？』"   voices=""/><msg @l="344" char_id="-1" frame_id="-1" name="学生C" text="『这是某种活动……之类的吗？』"   voices=""/><msg @l="346" char_id="-1" frame_id="-1" name="朽木"   text="『我不是说了吗，这是对你们的奖励。』" voices=""/><msg @l="348" char_id="-1" frame_id="-1" name="朽木"   text="『不必有任何顾虑……尽情享用就好。』" voices=""/><msg @l="350" char_id="-1" frame_id="-1" name="学生D" text="『但、但是……。』"   voices=""/><msg @l="352" char_id="-1" frame_id="-1" name="学生E" text="『即使这么说……。』"   voices=""/><msg @l="354" char_id="-1" frame_id="-1" name=""   text="学生们只是窃窃私语喧闹着，丝毫没有要从原地移动的意思。" voices=""/><msg @l="355" char_id="-1" frame_id="-1" name=""   text="大家……似乎都在最后一步犹豫不决。" voices=""/><msg @l="357" char_id="-1" frame_id="-1" name="朽木"   text="『好吧。我也能理解你们的猜疑心。』" voices=""/><msg @l="359" char_id="-1" frame_id="-1" name="朽木"   text="『那么在这里……仲根同学，不如由你来开口请求如何。』" voices=""/><char @l="362" id="miho" pos="right" src="miho104"/><msg @l="364" char_id="0" frame_id="-1" name="美帆" text="『诶……。』" voices=""/><msg @l="366" char_id="-1" frame_id="-1" name=""   text="本已半放弃地想把一切交给命运，却突然被这样要求，让我困惑不已。" voices=""/><msg @l="368" char_id="-1" frame_id="-1" name="朽木"   text="『怎么了，难道你对他们的努力，没有一点慰劳之情吗？』" voices=""/><msg @l="370" char_id="-1" frame_id="-1" name="朽木"   text="『来吧，用你的嘴和小穴来服侍他们。』" voices=""/><char @l="373" id="miho" pos="right" src="miho005"/><msg @l="375" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="377" char_id="-1" frame_id="-1" name="" text="教授的目光紧逼着我。"   voices=""/><msg @l="378" char_id="-1" frame_id="-1" name="" text="已经没有拒绝的选择了。"   voices=""/><msg @l="379" char_id="-1" frame_id="-1" name=""   text="我已经……只能按照他说的做了。" voices=""/><clear @l="382" class="all"/><msg @l="384" char_id="0" frame_id="-1" name="美帆"   text="『各、各位……请、请随意使用我的嘴和小穴……。』" voices=""/><msg @l="386" char_id="0" frame_id="-1" name="美帆"   text="『……请用我的身体……让你们舒服……。』" voices=""/><msg @l="388" char_id="-1" frame_id="-1" name="学生A" text="『她、她是认真的……。』"   voices=""/><msg @l="390" char_id="-1" frame_id="-1" name="学生B" text="『既然仲根都这么说了？』"   voices=""/><msg @l="392" char_id="-1" frame_id="-1" name="学生C" text="『不上她就亏了……对吧？』"   voices=""/><msg @l="394" char_id="-1" frame_id="-1" name=""   text="随着我的话语，男生们被犹豫这一枷锁所束缚的状态逐渐解除了。" voices=""/><msg @l="395" char_id="-1" frame_id="-1" name="" text="已经，无法阻止了。" voices=""/><msg @l="396" char_id="-1" frame_id="-1" name="" text="已经……无法回头了。" voices=""/><msg @l="398" char_id="-1" frame_id="-1" name="朽木"   text="『不过，在那之前先给仲根同学这个……。』" voices=""/><msg @l="400" char_id="-1" frame_id="-1" name=""   text="说着，他将我俯卧着的双手反绑在背后。" voices=""/><msg @l="402" char_id="0" frame_id="-1" name="美帆" text="『呜啊……。』" voices=""/><msg @l="404" char_id="0" frame_id="-1" name="美帆" text="(又……这样……)"   voices=""/><msg @l="406" char_id="-1" frame_id="-1" name="朽木"   text="『好了，接下来你们随意吧。』" voices=""/><msg @l="408" char_id="-1" frame_id="-1" name="朽木" text="『不过……禁止内射。』"   voices=""/><msg @l="410" char_id="-1" frame_id="-1" name="学生们" text="『是！』" voices=""/><msg @l="412" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><clear @l="415" class="all"/><label @l="418" id="event_scene13"/><msgshow @l="421" show="true"/><label @l="424" id="chart_line51"/><wait_chgmv/><ev @l="427" src="ev-013y1"/><description @l="430" text="ご褒美奉仕"/><bgm @l="433" src="bgm14" volume="1."/><msg @l="435" char_id="-1" frame_id="-1" name="学生A"   text="『那、那个……那就我先……。』" voices=""/><msg @l="437" char_id="-1" frame_id="-1" name=""   text="一个看起来内向的男孩，这样说着压在我的背上开始揉捏我的胸部。" voices=""/><msg @l="438" char_id="-1" frame_id="-1" name=""   text="粗重的呼吸喷在我的背上。仅仅是看着全裸被束缚的我横躺在桌上，那个男孩似乎已经完全兴奋起来了。"   voices=""/><msg @l="440" char_id="-1" frame_id="-1" name="学生A"   text="『好、好软啊。舒、舒服吗？喂，舒服吗？』" voices=""/><msg @l="441" char_id="-1" frame_id="-1" name=""   text="他似乎兴奋得忘乎所以，粗暴地用力揉捏着我的胸部。那力道强得让我感到像水球般的胸部快要破裂的钝痛。"   voices=""/><msg @l="442" char_id="-1" frame_id="-1" name=""   text="尽管如此，我的胸部仍被肆意揉搓。两个隆起被粗暴地揉捏着。" voices=""/><msg @l="443" char_id="-1" frame_id="-1" name=""   text="直到前几天，这里还是和平日常的一部分——教授室。曾经和朽木教授只有一点点交谈的几个男孩，现在正视奸着我，一个像野兽般兴奋的男孩正在凌辱我。"   voices=""/><msg @l="444" char_id="-1" frame_id="-1" name=""   text="在这种情况下，加上我白瓷般的胸部受到的强烈刺激，不禁让我感到一阵眩晕。" voices=""/><msg @l="445" char_id="-1" frame_id="-1" name="" text="我想逃离这一切。"   voices=""/><msg @l="446" char_id="-1" frame_id="-1" name=""   text="身体仅存的那一点点抵抗力，也在逐渐减弱。" voices=""/><msg @l="448" char_id="0" frame_id="-1" name="美帆" text="『嗯啊……嗯嗯……。』"   voices="miho08410"/><msg @l="450" char_id="-1" frame_id="-1" name=""   text="呼吸急促的男孩将目光投向了我挺立的乳头。" voices=""/><msg @l="451" char_id="-1" frame_id="-1" name=""   text="他那因兴奋而发热的手指找到了如樱桃般粉嫩的乳头，并开始拧弄。我情不自禁地发出了声音。" voices=""/><msg @l="452" char_id="-1" frame_id="-1" name=""   text="与我的意愿相反，原本软糯如糖果般的乳头变得坚硬而尖挺。" voices=""/><msg @l="454" char_id="-1" frame_id="-1" name="学生B"   text="『太厉害了……这家伙，该不会是真的有感觉吧？』" voices=""/><msg @l="456" char_id="-1" frame_id="-1" name="学生C"   text="『她都讲那种话了，肯定是个淫荡的女人啊。』" voices=""/><msg @l="458" char_id="-1" frame_id="-1" name="学生D"   text="『我第一次见到真正淫荡的女人诶。』" voices=""/><msg @l="460" char_id="-1" frame_id="-1" name="学生A"   text="『乳头变得超级硬了哦，是因为我的手让你有感觉了吗？我的手很舒服对吧！』" voices=""/><msg @l="462" char_id="0" frame_id="-1" name="美帆" text="『嗯……』"   voices="miho08420"/><msg @l="464" char_id="-1" frame_id="-1" name=""   text="听着男生们说出的话，我感到绝望……为了逃避现实，我任由身后压着我的学生爱抚我的身体。" voices=""/><msg @l="465" char_id="-1" frame_id="-1" name=""   text="逐渐地，支配我思想的感觉变得甜蜜起来……我的身体虽然遭受这样的折磨，却还是有了感觉。" voices=""/><msg @l="467" char_id="-1" frame_id="-1" name="学生A"   text="『女孩子的皮肤原来这么光滑啊。太棒了！』" voices=""/><msg @l="469" char_id="-1" frame_id="-1" name="学生C" text="『喂，你该不会是处男吧？』"   voices=""/><msg @l="471" char_id="-1" frame_id="-1" name=""   text="周围的男生们嘲笑着那个揉捏我乳头的男孩的言行，哄堂大笑。在这样的嘲笑中，我继续承受着羞辱。" voices=""/><msg @l="474" char_id="-1" frame_id="-1" name="学生A"   text="『我，我想看。想看仲根小姐的小穴……真的好想看……』" voices=""/><msg @l="476" char_id="-1" frame_id="-1" name=""   text="男孩说着下流的话，像个买不到玩具的孩子一样撒娇耍赖。" voices=""/><msg @l="478" char_id="-1" frame_id="-1" name="学生D"   text="『快看看啊，真的超粉的哎。』" voices=""/><msg @l="480" char_id="-1" frame_id="-1" name="" text="另一个男生在一旁煽风点火。"   voices=""/><msg @l="481" char_id="-1" frame_id="-1" name=""   text="我一瞬间想要合拢双腿，但男孩的臂力很强，我微微隆起的秘密花园被他们盯着看。" voices=""/><msg @l="483" char_id="0" frame_id="-1" name="美帆" text="『啊，啊啊……』"   voices="miho10130"/><msg @l="485" char_id="-1" frame_id="-1" name="学生A"   text="『太，太厉害了！仲根小姐的小穴味道好浓……』" voices=""/><msg @l="487" char_id="-1" frame_id="-1" name=""   text="男孩鼻翼翕动，沉浸在陶醉感中。我被看到了羞耻的地方，每当他发出嗅闻的声音，我的身体就变得燥热，仿佛身体的核心在融化。"   voices=""/><msg @l="488" char_id="-1" frame_id="-1" name=""   text="然后，他用手指摩擦我的秘缝，将最敏感的部位暴露出来。" voices=""/><msg @l="490" char_id="0" frame_id="-1" name="美帆" text="『嗯，嗯……啊，嗯呃！』"   voices="miho10150"/><msg @l="492" char_id="-1" frame_id="-1" name=""   text="我无法抑制的欲望一波接一波涌出，下半身淫荡地颤动。这一幕点燃了男孩们兽性的欲望。" voices=""/><msg @l="495" char_id="-1" frame_id="-1" name="学生A"   text="『我我已经忍不住了……呃，那个……可以……插进去吗？』" voices=""/><msg @l="497" char_id="-1" frame_id="-1" name="朽木" text="『……。』" voices=""/><msg @l="499" char_id="-1" frame_id="-1" name=""   text="当那个内向的男生不知是在问谁地说出这句话时，朽木教授像是在代他回答般点了点头。" voices=""/><msg @l="500" char_id="-1" frame_id="-1" name=""   text="于是得到了教授许可的他，仿佛那就是自己的意愿一般，满足地将他那硬挺的年轻肉棒一口气刺入我的阴道。"   voices=""/><msg @l="502" char_id="0" frame_id="-1" name="美帆" text="『嗯，啊啊……。』"   voices="miho08430"/><msg @l="504" char_id="-1" frame_id="-1" name=""   text="在插入的瞬间，从被撑开的裂缝深处，大量的蜜液咕啾一声溢了出来。" voices=""/><msg @l="505" char_id="-1" frame_id="-1" name=""   text="我的身体……明明被这么多人注视着，却已经湿得一塌糊涂了……。" voices=""/><msg @l="507" char_id="-1" frame_id="-1" name="学生A"   text="『好，好厉害……湿哒哒的。呜…哇啊。太太舒服了！』" voices=""/><msg @l="509" char_id="-1" frame_id="-1" name="学生C" text="『这说明她就是个骚货呗。』"   voices=""/><msg @l="511" char_id="-1" frame_id="-1" name="学生E"   text="『也就是说，不用客气了，对吧？』" voices=""/><msg @l="513" char_id="-1" frame_id="-1" name="" text="是嘲讽，还是欢喜。"   voices=""/><msg @l="514" char_id="-1" frame_id="-1" name=""   text="无论如何，周围男生们的话语都在让我这个存在坠入深渊。" voices=""/><msg @l="516" char_id="-1" frame_id="-1" name="朽木" text="『……。』" voices=""/><msg @l="518" char_id="0" frame_id="-1" name="美帆" text="『……。』"   voices="miho08440"/><msg @l="520" char_id="-1" frame_id="-1" name="" text="我与教授的目光相遇了。" voices=""/><msg @l="521" char_id="-1" frame_id="-1" name="" text="他满意地扭曲着嘴角。"   voices=""/><msg @l="523" char_id="0" frame_id="-1" name="美帆" text="『嗯嗯…啊，啊啊……。』"   voices="miho08450"/><msg @l="525" char_id="-1" frame_id="-1" name=""   text="压在我身上的他每次自顾自地摆动腰肢，那坚硬的前端就在我的深处搅动，引起子宫一阵阵酥麻。" voices=""/><msg @l="526" char_id="-1" frame_id="-1" name=""   text="而责罚我上半身的手也不停地揉捏着我的胸部。" voices=""/><msg @l="527" char_id="-1" frame_id="-1" name=""   text="现在的他已经像发疯一样贪婪地索取着我的身体。" voices=""/><msg @l="529" char_id="-1" frame_id="-1" name="学生A"   text="『哇，哇，太厉害了……她在吸住我啊！？』" voices=""/><msg @l="531" char_id="-1" frame_id="-1" name="" text="他真的还是个处男吧。"   voices=""/><msg @l="532" char_id="-1" frame_id="-1" name=""   text="他一边享受着我体内肉壁的触感，一边发出欢喜的声音。" voices=""/><msg @l="534" char_id="-1" frame_id="-1" name="朽木"   text="『那是仲根同学感觉到快感的证明。让她更有感觉，相对地，阴部的感觉也会变得更好。』" voices=""/><msg @l="536" char_id="-1" frame_id="-1" name="学生A"   text="『她，她有感觉了……因为我的那个而有感觉了！？』" voices=""/><msg @l="538" char_id="0" frame_id="-1" name="美帆" text="『啊，嗯啊啊……嗯，嗯嗯！』"   voices="miho08460"/><msg @l="540" char_id="-1" frame_id="-1" name=""   text="龟头更加猛烈地敲击着我的子宫，我不由自主地抖动着腰肢。" voices=""/><msg @l="541" char_id="-1" frame_id="-1" name=""   text="腰的摆动方式，前端摩擦的位置，节奏的激烈程度。" voices=""/><msg @l="542" char_id="-1" frame_id="-1" name=""   text="这些都与朽木教授不同……我感受到了不一样的快感。" voices=""/><msg @l="543" char_id="-1" frame_id="-1" name=""   text="……意识已经被快感完全涂抹殆尽……。" voices=""/><msg @l="545" char_id="0" frame_id="-1" name="美帆" text="(不行……好像，好厉害……)"   voices="miho08470"/><msg @l="547" char_id="0" frame_id="-1" name="美帆"   text="(这种……啊，真是的……！？)" voices="miho08480"/><msg @l="549" char_id="0" frame_id="-1" name="美帆"   text="嗯嗯，嗯，啊……嗯嗯嗯嗯嗯！！" voices="miho08490"/><msg @l="551" char_id="-1" frame_id="-1" name=""   text="我的子宫内肉褶颤抖着，一阵一阵地蠕动。" voices=""/><msg @l="552" char_id="-1" frame_id="-1" name=""   text="一种令人头脑融化的麻痹感……一下子扩散开来，我的意识飞走了。" voices=""/><msg @l="554" char_id="-1" frame_id="-1" name="学生A"   text="『呜啊……怎么突然里面绞紧了。』" voices=""/><msg @l="556" char_id="-1" frame_id="-1" name="朽木"   text="『哦呀，看来仲根同学已经高潮了呢。』" voices=""/><msg @l="558" char_id="-1" frame_id="-1" name="学生A" text="『诶……已经去了吗？』"   voices=""/><msg @l="560" char_id="0" frame_id="-1" name="美帆"   text="『嗯嗯……哈……哈………嗯，啊啊………。』" voices="miho08500"/><msg @l="562" char_id="-1" frame_id="-1" name=""   text="在高潮的余韵中，我眼含泪水，喘着粗气。" voices=""/><msg @l="564" char_id="-1" frame_id="-1" name="学生A"   text="『我……还没射呢……。』" voices=""/><msg @l="566" char_id="-1" frame_id="-1" name="朽木"   text="『不用在意。就那样继续吧。』" voices=""/><msg @l="568" char_id="0" frame_id="-1" name="美帆"   text="『诶，等一下，让我休息一下……啊啊！』" voices="miho08510"/><msg @l="570" char_id="-1" frame_id="-1" name=""   text="他根本不听我说话，肉柱又开始摩擦起再次收缩的蜜壶。" voices=""/><msg @l="571" char_id="-1" frame_id="-1" name=""   text="因为已经高潮，变得更加敏感的阴道壁被肉棒用力摩擦，又一波高潮的浪潮袭来，带来甜美的麻痹感。" voices=""/><msg @l="573" char_id="0" frame_id="-1" name="美帆"   text="『不，啊啊……啊……啊………嗯，啊呜！！』" voices="miho08520"/><msg @l="575" char_id="-1" frame_id="-1" name=""   text="可能是因为达到高潮而大量流出蜜液，每次律动都伴随着咕啾咕啾的淫靡声音回荡开来。" voices=""/><msg @l="577" char_id="-1" frame_id="-1" name="学生A"   text="『啊，啊啊……我……我也快要……。』" voices=""/><msg @l="579" char_id="-1" frame_id="-1" name="学生B"   text="『喂，反正不能射在里面，咱们一起射在同一个地方吧。』" voices=""/><msg @l="581" char_id="-1" frame_id="-1" name=""   text="突然从脸旁传来的声音让我吓了一跳，转头望了过去。" voices=""/><msg @l="582" char_id="-1" frame_id="-1" name=""   text="于是，其他男生也忍不住了，各自开始用手撸动自己的那话儿。" voices=""/><msg @l="584" char_id="-1" frame_id="-1" name="学生C"   text="『你不是一直喜欢颜射吗。』" voices=""/><msg @l="586" char_id="-1" frame_id="-1" name="学生B"   text="『闭嘴……话说，想射在哪里？』" voices=""/><msg @l="588" char_id="-1" frame_id="-1" name="学生E" text="『当然是脸上啊。』"   voices=""/><msg @l="590" char_id="-1" frame_id="-1" name="学生D"   text="『不，射在背上也不错吧？』" voices=""/><msg @l="592" char_id="-1" frame_id="-1" name="学生C" text="『……真有品味啊。』"   voices=""/><msg @l="594" char_id="-1" frame_id="-1" name="学生D" text="『这不挺好的嘛，我就喜欢这样。』"   voices=""/><msg @l="596" char_id="-1" frame_id="-1" name="学生B" text="『你觉得哪边更好？』"   voices=""/><msg @l="598" char_id="-1" frame_id="-1" name="学生A" text="『诶……我、我……？』"   voices=""/><msg @l="600" char_id="-1" frame_id="-1" name="学生B"   text="『嘛，第一个是你，就由你决定吧。』" voices=""/><msg @l="602" char_id="-1" frame_id="-1" name="学生A" text="『那、那个……我是……。』"   voices=""/><msg @l="605" async="true" char_id="-1" frame_id="-1" name=""   text="要射在哪里……？" voices=""/><select @l="606"><menu @l="609" label="TempLabel_191" text="脸上"/><menu @l="611" label="TempLabel_193" text="背上"/></select><goto @l="615" label="TempLabel_192"/><label @l="617" id="TempLabel_191"/><eval @l="619" expr="f.ご褒美奉仕flag&#32;=&#32;1&#13;&#10;"/><goto @l="620" label="TempLabel_192"/><label @l="622" id="TempLabel_193"/><eval @l="624" expr="f.ご褒美奉仕flag&#32;=&#32;2&#13;&#10;"/><goto @l="625" label="TempLabel_192"/><label @l="627" id="TempLabel_192"/><label @l="630" id="EventLabel_124"/><goto @l="633" cond="!(f.ご褒美奉仕flag&#32;==&#32;1)&#13;&#10;"   label="TempLabel_194"/><msg @l="635" char_id="-1" frame_id="-1" name="学生A" text="『那、那就脸上吧……。』"   voices=""/><msg @l="637" char_id="-1" frame_id="-1" name="学生B"   text="『好嘞。那我们就一起把他的脸弄得黏糊糊的吧。』" voices=""/><msg @l="639" char_id="-1" frame_id="-1" name="学生E" text="『那是当然的啊。』"   voices=""/><msg @l="641" char_id="-1" frame_id="-1" name="学生D"   text="『嘛，既然这样的话，脸上也行。』" voices=""/><msg @l="643" char_id="-1" frame_id="-1" name="学生C"   text="『……随便哪边不都行吗。』" voices=""/><wait_chgmv/><ev @l="646" src="ev-013y1y2"/><msg @l="648" char_id="-1" frame_id="-1" name=""   text="猛烈侵犯下半身的东西被抽了出来。" voices=""/><msg @l="649" char_id="-1" frame_id="-1" name=""   text="所有人的性器都排在我精疲力尽的面前，一齐，用力地，开始各自套弄起来。" voices=""/><msg @l="651" char_id="-1" frame_id="-1" name="学生A"   text="『那、那么……要射了，要射了！！』" voices=""/><msg @l="653" char_id="0" frame_id="-1" name="美帆"   text="『嗯，嗯，嗯……啊，嗯呃………啊，啊啊！』" voices="miho08530"/><msg @l="655" char_id="-1" frame_id="-1" name="学生A" text="『嗯嗯！』" voices=""/><flash @l="658" count="4" fade="100" image="white"/><wait_chgmv/><ev @l="661" src="ev-013x2y2z1z2"/><msg @l="663" char_id="0" frame_id="-1" name="美帆" text="『嗯……。』"   voices="miho08540"/><msg @l="665" char_id="-1" frame_id="-1" name=""   text="从脸到胸口，大量的精液被喷洒开来。" voices=""/><msg @l="666" char_id="-1" frame_id="-1" name=""   text="势头太猛，结果全身上下都被喷满了白色液体。" voices=""/><msg @l="667" char_id="-1" frame_id="-1" name="" text="滚烫的精液顺着脸颊流下……。"   voices=""/><msg @l="669" char_id="-1" frame_id="-1" name="学生A"   text="『哈，哈……对不起……射了好多。』" voices=""/><msg @l="671" char_id="-1" frame_id="-1" name="学生B"   text="『嗯，嗯啊。这，这边也要射了！』" voices=""/><msg @l="673" char_id="-1" frame_id="-1" name="学生C" text="『啊，啊啊，我，我也要！！』"   voices=""/><flash @l="676" count="4" fade="100" image="white"/><wait_chgmv/><ev @l="678" src="ev-013x2y2z4z5"/><msg @l="680" char_id="-1" frame_id="-1" name="" text="一波接一波的精液被射到脸上。"   voices=""/><msg @l="681" char_id="-1" frame_id="-1" name=""   text="黏稠浓厚的液体沿着身体流下。" voices=""/><msg @l="682" char_id="-1" frame_id="-1" name=""   text="倾泻而下的热雨终于停了，我慢慢睁开眼睛。" voices=""/><msg @l="683" char_id="-1" frame_id="-1" name=""   text="环顾四周，那些握着各自阳具的男人们都露出猥琐的笑容。" voices=""/><msg @l="684" char_id="-1" frame_id="-1" name=""   text="那些肉棒没有一根有萎缩的迹象，反而像是看到被精液覆盖的我而更加兴奋了……" voices=""/><msg @l="685" char_id="-1" frame_id="-1" name="" text="朽木教授在角落里得意地笑着。"   voices=""/><msg @l="686" char_id="-1" frame_id="-1" name="" text="我想逃跑。" voices=""/><msg @l="687" char_id="-1" frame_id="-1" name=""   text="但我被束缚着，连自由活动都做不到。" voices=""/><msg @l="688" char_id="-1" frame_id="-1" name=""   text="不知道他们是否理解我的心情，男生们明明刚刚射过，却又为了寻求欲望的发泄口而蜂拥向我的下半身。" voices=""/><msg @l="690" char_id="-1" frame_id="-1" name="学生B" text="『赶紧的，该轮到我爽了。』"   voices=""/><msg @l="692" char_id="-1" frame_id="-1" name="学生C" text="『嗯。』" voices=""/><clear @l="695" class="all"/><wait_chgmv/><ev @l="698" src="ev-013x2y3z1z2z3"/><msg @l="700" char_id="0" frame_id="-1" name="美帆" text="『啊，唔啊……。』"   voices="miho08560"/><msg @l="702" char_id="-1" frame_id="-1" name="" text="男根再次插入了我的秘缝。"   voices=""/><msg @l="703" char_id="-1" frame_id="-1" name=""   text="这次的肉棒比之前那根更大，被撑开入口的感觉让我不由自主地颤抖起来。" voices=""/><msg @l="704" char_id="-1" frame_id="-1" name=""   text="我的意识再次被从下半身涌上的快感所淹没……。" voices=""/><msg @l="706" char_id="-1" frame_id="-1" name="学生B" text="『太太厉害了……还挺紧的嘛。』"   voices=""/><msg @l="708" char_id="0" frame_id="-1" name="美帆"   text="『嗯啊，啊啊……好……好大，啊啊啊！！』" voices="miho08570"/><msg @l="709" char_id="-1" frame_id="-1" name="学生B"   text="『嘿，这东西我可是很有自信的。』" voices=""/><msg @l="711" char_id="-1" frame_id="-1" name=""   text="第二个男生这样说着，用力挺腰，将肉块深深推入我的最深处。" voices=""/><msg @l="712" char_id="-1" frame_id="-1" name=""   text="比之前强烈得多的刺激在身体深处扩散开来。" voices=""/><msg @l="713" char_id="-1" frame_id="-1" name=""   text="我已经无法忍住声音了。嘴巴不受控制地发出呻吟声。" voices=""/><msg @l="715" char_id="0" frame_id="-1" name="美帆"   text="『嗯啊、啊、啊……不行、深处……啊啊！！』" voices="miho08580"/><msg @l="717" char_id="-1" frame_id="-1" name="学生B"   text="『呵呵……能让你这么开心真是荣幸啊。』" voices=""/><msg @l="719" char_id="-1" frame_id="-1" name="学生B"   text="『我这边也会，好好享受个够的哦。』" voices=""/><msg @l="721" char_id="0" frame_id="-1" name="美帆"   text="『啊……嗯、嗯嗯………啊啊………。』" voices="miho08590"/><msg @l="723" char_id="-1" frame_id="-1" name=""   text="深入，浅出，肉棒在我的体内来回进出，不断扩张着我的内壁。" voices=""/><msg @l="724" char_id="-1" frame_id="-1" name=""   text="每次接纳那粗壮的欲望，大量蜜液就从我的深处渗出，从结合处咕啾咕啾地溢出来。"   voices=""/><msg @l="726" char_id="-1" frame_id="-1" name="学生D" text="『啊，我已经忍不了了。』"   voices=""/><msg @l="728" char_id="-1" frame_id="-1" name=""   text="排队等候的学生中的一个这样说着，将硬挺勃起的阴茎对准我的脸前开始撸动。" voices=""/><msg @l="730" char_id="0" frame_id="-1" name="美帆" text="『…………。』"   voices="miho08600"/><msg @l="732" char_id="0" frame_id="-1" name="美帆"   text="(好厉害……变得那么大了……)" voices="miho08610"/><msg @l="734" char_id="-1" frame_id="-1" name="学生C"   text="『什么啊，真是个没耐性的家伙。』" voices=""/><msg @l="736" char_id="-1" frame_id="-1" name="学生B"   text="『嘛，就按照什么都可以的方向来吧。』" voices=""/><msg @l="738" char_id="-1" frame_id="-1" name="学生D"   text="『哦。就算不说我也打算这么做。』" voices=""/><msg @l="740" char_id="0" frame_id="-1" name="美帆"   text="『嗯嗯…嗯，嗯嗯……啊…………啊啊………。』" voices="miho08620"/><msg @l="742" char_id="-1" frame_id="-1" name=""   text="我也像是被他们投向我的欲望缠绕一般，漏出炽热的喘息。" voices=""/><msg @l="743" char_id="-1" frame_id="-1" name=""   text="我正被支配着这个房间的空气所吞噬。" voices=""/><msg @l="744" char_id="-1" frame_id="-1" name="" text="……，……已经……怎样都好了……。"   voices=""/><msg @l="746" char_id="0" frame_id="-1" name="美帆"   text="『嗯啊……啊，啊啊………嗯，啾。』" voices="miho08630"/><msg @l="748" char_id="-1" frame_id="-1" name="学生D" text="『哇哦！？』" voices=""/><msg @l="750" char_id="-1" frame_id="-1" name=""   text="我向着眼前那正被套弄着的肉块顶端伸出舌头，舔了上去。" voices=""/><msg @l="751" char_id="-1" frame_id="-1" name=""   text="就在那一瞬间，正在套弄自己那物的他开始微微抖动腰部。" voices=""/><msg @l="753" char_id="-1" frame_id="-1" name="学生D"   text="『再、再来一次……刚才那样。』" voices=""/><msg @l="755" char_id="0" frame_id="-1" name="美帆"   text="『嗯嗯………嗯……………啊呼，嗯…………啾噜。』" voices="miho08640"/><msg @l="757" char_id="-1" frame_id="-1" name="学生D"   text="『太棒了………太，舒服了。』" voices=""/><msg @l="759" char_id="-1" frame_id="-1" name="学生D"   text="『我来撸根部……你含住前面吧。』" voices=""/><msg @l="761" char_id="0" frame_id="-1" name="美帆"   text="『啊，嗯呼……嗯，呜……啾噗，啾噗噗。』" voices="miho08650"/><msg @l="762" char_id="-1" frame_id="-1" name=""   text="我将顶在鼻尖的龟头含进口中，用舌头缠绕着。" voices=""/><msg @l="764" char_id="0" frame_id="-1" name="美帆"   text="『嗯，啾噗，啾噗，啾噗……嗯嗯，呜，嗯啊啊。』" voices="miho08660"/><msg @l="766" char_id="-1" frame_id="-1" name=""   text="随着子宫被顶撞的节奏，我移动着嘴唇和舌头，吮吸着口中的肉柱。" voices=""/><msg @l="768" char_id="-1" frame_id="-1" name="学生B"   text="『气氛变得相当不错了嘛。』" voices=""/><msg @l="770" char_id="-1" frame_id="-1" name="学生D"   text="『轮奸这种东西……果然得这样才行啊。』" voices=""/><msg @l="772" char_id="0" frame_id="-1" name="美帆"   text="『嗯呼，嗯，啊呜……嗯咕……啾啪。』" voices="miho08670"/><msg @l="774" char_id="-1" frame_id="-1" name=""   text="私处被撑开直达子宫口的感觉让我扭动着腰，同时用嘴唇套弄着口中的那物……" voices=""/><msg @l="776" char_id="0" frame_id="-1" name="美帆"   text="『啊啊，啊，啊……嗯呼……嗯咕，啾噗，啾噗噗。』" voices="miho08680"/><msg @l="778" char_id="-1" frame_id="-1" name="" text="第二次高潮即将来临。"   voices=""/><msg @l="779" char_id="-1" frame_id="-1" name=""   text="我努力地让舌头在口中的那物上啾噗啾噗地游走，身体因即将到来的甜美麻痹感而颤抖。" voices=""/><msg @l="781" char_id="-1" frame_id="-1" name="学生D" text="『要、要射了！』"   voices=""/><msg @l="783" char_id="-1" frame_id="-1" name=""   text="在我口中被舔舐的肉棒震颤起来，自己撸动着的他低吼出声。" voices=""/><flash @l="786" count="4" fade="100" image="white"/><msg @l="788" char_id="0" frame_id="-1" name="美帆" text="『噗啊。』"   voices="miho08690"/><msg @l="790" char_id="-1" frame_id="-1" name=""   text="那话儿从口中抽出的瞬间，大量精液飞溅到我的脸和胸上。" voices=""/><msg @l="792" char_id="-1" frame_id="-1" name="学生D" text="『呼，太爽了。』"   voices=""/><msg @l="794" char_id="-1" frame_id="-1" name="学生B"   text="『好嘞，我也马上给你射！』" voices=""/><msg @l="796" char_id="0" frame_id="-1" name="美帆"   text="『嗯啊…啊，嗯咕……啊！』" voices="miho08710"/><msg @l="798" char_id="-1" frame_id="-1" name=""   text="仿佛是最后冲刺一般，侵犯着我私处的他加快了腰部的动作。" voices=""/><msg @l="800" char_id="0" frame_id="-1" name="美帆"   text="『不行…那样的话……嗯，嗯呜！！』" voices="miho08720"/><msg @l="802" char_id="-1" frame_id="-1" name="学生B" text="『来吧，再高潮一次吧！！』"   voices=""/><msg @l="804" char_id="0" frame_id="-1" name="美帆"   text="『啊，啊啊…不，啊…要，要去了！！』" voices="miho08730"/><msg @l="806" char_id="-1" frame_id="-1" name="学生B" text="『要，要射了！！』"   voices=""/><msg @l="808" char_id="0" frame_id="-1" name="美帆"   text="『啊啊……啊，去了……啊，啊啊，嗯嗯嗯嗯！！！』" voices="miho08740"/><flash @l="811" count="4" fade="100" image="white"/><wait_chgmv/><ev @l="814" src="ev-013x2y3z4z5z6"/><msg @l="816" char_id="0" frame_id="-1" name="美帆" text="『嗯嗯！！』"   voices="miho08750"/><msg @l="818" char_id="-1" frame_id="-1" name=""   text="第三波精液洒落在我的脸上，使得整张脸都沾满了白浊液体。" voices=""/><msg @l="819" char_id="-1" frame_id="-1" name=""   text="仿佛要溺水一般……感受到脸上精液的热度和腥味，我不禁陶醉其中。" voices=""/><msg @l="821" char_id="-1" frame_id="-1" name="学生B"   text="『嘿嘿……你的脸变得真不错啊。』" voices=""/><msg @l="823" char_id="-1" frame_id="-1" name=""   text="他一边把从前端渗出的精液残余蹭在我的脸颊上，一边说道，刚才还在侵犯我私处的他。" voices=""/><msg @l="825" char_id="0" frame_id="-1" name="美帆" text="『嗯，啊啊……』"   voices="miho08760"/><msg @l="827" char_id="-1" frame_id="-1" name=""   text="我无法回应他的话语……只是因高潮的余韵和精液的热度而身体颤抖着。" voices=""/><msg @l="828" char_id="-1" frame_id="-1" name=""   text="只剩下遍布全身的甜美感觉……意识……逐渐模糊……" voices=""/><goto @l="832" label="TempLabel_195"/><label @l="833" id="TempLabel_194"/><msg @l="838" char_id="-1" frame_id="-1" name="学生A"   text="『那个……背，背部应该不错吧。』" voices=""/><msg @l="840" char_id="-1" frame_id="-1" name="学生D" text="『啊，果然是背部呢！』"   voices=""/><msg @l="842" char_id="-1" frame_id="-1" name="学生B" text="『闭嘴，别吵。』"   voices=""/><msg @l="844" char_id="-1" frame_id="-1" name="学生B"   text="『那么，我们一起射在她身上，让她变得黏糊糊的吧。』" voices=""/><msg @l="845" char_id="-1" frame_id="-1" name="学生E"   text="『切……颜射的浪漫就……。』" voices=""/><msg @l="847" char_id="-1" frame_id="-1" name="学生A"   text="『那、那么……来了，要来了！！』" voices=""/><msg @l="849" char_id="-1" frame_id="-1" name=""   text="猛烈责罚我下半身的东西被抽了出来。" voices=""/><msg @l="850" char_id="-1" frame_id="-1" name=""   text="他们围绕着瘫软的我排成一圈，一齐用力开始套弄各自的分身。" voices=""/><msg @l="852" char_id="0" frame_id="-1" name="美帆"   text="『嗯，嗯，嗯……啊，嗯呜……啊，啊啊！』" voices="miho08530"/><msg @l="854" char_id="-1" frame_id="-1" name="学生A" text="『嗯嗯！』" voices=""/><flash @l="857" count="4" fade="100" image="white"/><wait_chgmv/><ev @l="860" src="ev-013x1y1z1"/><msg @l="862" char_id="0" frame_id="-1" name="美帆" text="『啊……嗯嗯………。』"   voices="miho08550"/><msg @l="864" char_id="-1" frame_id="-1" name="" text="大量的白浊液体注入我的背上。"   voices=""/><msg @l="865" char_id="-1" frame_id="-1" name=""   text="那灼烧般的热感让我微微扭动身体，腰部颤抖着。" voices=""/><msg @l="867" char_id="-1" frame_id="-1" name="学生A"   text="『哈，哈……对不起……射了好多。』" voices=""/><msg @l="869" char_id="-1" frame_id="-1" name="学生D"   text="『别在意啦。这种场合不多射点怎么行。』" voices=""/><msg @l="871" char_id="-1" frame_id="-1" name="学生B"   text="『唔，啊。这，这边也要射了！』" voices=""/><msg @l="873" char_id="-1" frame_id="-1" name="学生C" text="『哦，哦啊，我，我也是！！』"   voices=""/><flash @l="876" count="4" fade="100" image="white"/><wait_chgmv/><ev @l="879" src="ev-013x2y1z4"/><msg @l="881" char_id="-1" frame_id="-1" name=""   text="没有片刻休息的时间，这次是精液浇在了我的脸上。" voices=""/><msg @l="882" char_id="-1" frame_id="-1" name=""   text="热腾腾黏糊糊的液体顺着脸颊流下。" voices=""/><msg @l="884" char_id="-1" frame_id="-1" name="学生D"   text="『喂！不是说好射在背上吗！』" voices=""/><msg @l="886" char_id="-1" frame_id="-1" name="学生B"   text="『无所谓吧。别那么斤斤计较啊，对吧。』" voices=""/><msg @l="888" char_id="-1" frame_id="-1" name="学生A"   text="『我，我射在手上了……。』" voices=""/><msg @l="890" char_id="-1" frame_id="-1" name="" text="男生们说着这些话，嘻嘻哈哈地笑着。"   voices=""/><msg @l="891" char_id="-1" frame_id="-1" name=""   text="环顾四周，每个握着自己那话儿的男生脸上都挂着淫邪的笑容。" voices=""/><msg @l="892" char_id="-1" frame_id="-1" name=""   text="那些肉棒没有一根有萎缩的迹象，反而像是看到被精液覆盖的我而更加兴奋了……" voices=""/><msg @l="893" char_id="-1" frame_id="-1" name="" text="朽木教授在角落里得意地笑着。"   voices=""/><msg @l="894" char_id="-1" frame_id="-1" name="" text="我想逃跑。" voices=""/><msg @l="895" char_id="-1" frame_id="-1" name=""   text="但我被束缚着，连自由活动都做不到。" voices=""/><msg @l="896" char_id="-1" frame_id="-1" name=""   text="不知道他们是否理解我的心情，男生们明明刚刚射过，却又为了寻求欲望的发泄口而蜂拥向我的下半身。" voices=""/><msg @l="898" char_id="-1" frame_id="-1" name="学生B" text="『赶紧的，该轮到我爽了。』"   voices=""/><msg @l="900" char_id="-1" frame_id="-1" name="学生C" text="『嗯。』" voices=""/><clear @l="903" class="all"/><wait_chgmv/><ev @l="906" src="ev-013x2y3z1z2z3"/><msg @l="908" char_id="0" frame_id="-1" name="美帆" text="『啊、嗯唔……。』"   voices="miho08560"/><msg @l="910" char_id="-1" frame_id="-1" name="" text="男根再次插入我的体内。"   voices=""/><msg @l="911" char_id="-1" frame_id="-1" name=""   text="这次的肉棒比先前那根更大，感受到入口被撑开的触感，我不由自主地颤抖起来。" voices=""/><msg @l="912" char_id="-1" frame_id="-1" name=""   text="我的意识再次被从下半身涌上来的快感所覆盖……" voices=""/><msg @l="914" char_id="-1" frame_id="-1" name="学生B" text="『太棒了……还挺紧的嘛。』"   voices=""/><msg @l="916" char_id="0" frame_id="-1" name="美帆"   text="『嗯啊、啊啊……好、好大……啊啊啊！！』" voices="miho08570"/><msg @l="917" char_id="-1" frame_id="-1" name="学生B"   text="『嘿，这东西我可是很有自信的。』" voices=""/><msg @l="919" char_id="-1" frame_id="-1" name=""   text="第二个男生这样说着，用力挺腰，将肉块深深推入我的最深处。" voices=""/><msg @l="920" char_id="-1" frame_id="-1" name=""   text="比之前强烈得多的刺激在身体深处扩散开来。" voices=""/><msg @l="921" char_id="-1" frame_id="-1" name=""   text="我已经无法忍住声音了。嘴巴不受控制地发出呻吟声。" voices=""/><msg @l="923" char_id="0" frame_id="-1" name="美帆"   text="『嗯啊、啊、啊……不行、深处……啊啊！！』" voices="miho08580"/><msg @l="925" char_id="-1" frame_id="-1" name="学生B"   text="『呵呵……能让你这么开心真是荣幸啊。』" voices=""/><msg @l="927" char_id="-1" frame_id="-1" name="学生B"   text="『我这边也会，好好享受个够的哦。』" voices=""/><msg @l="929" char_id="0" frame_id="-1" name="美帆"   text="『啊……嗯、嗯嗯………啊啊………。』" voices="miho08590"/><msg @l="931" char_id="-1" frame_id="-1" name=""   text="深入，浅出，肉棒在我的体内来回进出，不断扩张着我的内壁。" voices=""/><msg @l="932" char_id="-1" frame_id="-1" name=""   text="每次接纳那粗壮的欲望，大量蜜液就从我的深处渗出，从结合处咕啾咕啾地溢出来。"   voices=""/><msg @l="934" char_id="-1" frame_id="-1" name="学生D" text="『啊，我，已经忍不住了。』"   voices=""/><msg @l="936" char_id="-1" frame_id="-1" name=""   text="一个正在等待轮到自己的学生这样说着，将硬挺勃起的阴茎伸到我的脸前，开始套弄起来。" voices=""/><msg @l="938" char_id="0" frame_id="-1" name="美帆" text="『………。』"   voices="miho08600"/><msg @l="940" char_id="0" frame_id="-1" name="美帆"   text="(好厉害……变得那么大了……)" voices="miho08610"/><msg @l="942" char_id="-1" frame_id="-1" name="学生C"   text="『什么啊，真是个没耐性的家伙。』" voices=""/><msg @l="944" char_id="-1" frame_id="-1" name="学生B"   text="『嘛，就按照什么都可以的方向来吧。』" voices=""/><msg @l="946" char_id="-1" frame_id="-1" name="学生D"   text="『哦。就算不说我也打算这么做。』" voices=""/><msg @l="948" char_id="0" frame_id="-1" name="美帆"   text="『嗯嗯…嗯，嗯嗯……啊…………啊啊………。』" voices="miho08620"/><msg @l="950" char_id="-1" frame_id="-1" name=""   text="我也像是被他们投向我的欲望缠绕一般，漏出炽热的喘息。" voices=""/><msg @l="951" char_id="-1" frame_id="-1" name=""   text="我正被支配着这个房间的空气所吞噬。" voices=""/><msg @l="952" char_id="-1" frame_id="-1" name="" text="……，……已经……怎样都好了……。"   voices=""/><msg @l="954" char_id="0" frame_id="-1" name="美帆"   text="『嗯啊……啊，啊啊………嗯，啾。』" voices="miho08630"/><msg @l="956" char_id="-1" frame_id="-1" name="学生D" text="『哇哦！？』" voices=""/><msg @l="958" char_id="-1" frame_id="-1" name=""   text="我向着眼前那正被套弄着的肉块顶端伸出舌头，舔了上去。" voices=""/><msg @l="959" char_id="-1" frame_id="-1" name=""   text="就在那一瞬间，正在套弄自己那物的他开始微微抖动腰部。" voices=""/><msg @l="961" char_id="-1" frame_id="-1" name="学生D"   text="『再、再来一次……刚才那样。』" voices=""/><msg @l="963" char_id="0" frame_id="-1" name="美帆"   text="『嗯嗯……嗯……啊呼，嗯……啾咯。』" voices="miho08640"/><msg @l="965" char_id="-1" frame_id="-1" name="学生D"   text="『太棒了……太、太舒服了。』" voices=""/><msg @l="967" char_id="-1" frame_id="-1" name="学生D"   text="『我来套弄根部……你含住龟头吧。』" voices=""/><msg @l="969" char_id="0" frame_id="-1" name="美帆"   text="『啊，嗯呼……嗯，呜……啾噗，啾噗噗。』" voices="miho08650"/><msg @l="970" char_id="-1" frame_id="-1" name=""   text="我将顶在鼻尖的龟头含进口中，用舌头缠绕着。" voices=""/><msg @l="972" char_id="0" frame_id="-1" name="美帆"   text="『嗯，啾噗，啾噗，啾噗……嗯嗯，呜，嗯啊啊。』" voices="miho08660"/><msg @l="974" char_id="-1" frame_id="-1" name=""   text="随着子宫被顶撞的节奏，我移动着嘴唇和舌头，吮吸着口中的肉柱。" voices=""/><msg @l="976" char_id="-1" frame_id="-1" name="学生B"   text="『气氛变得相当不错了嘛。』" voices=""/><msg @l="978" char_id="-1" frame_id="-1" name="学生D"   text="『轮奸这种东西……果然得这样才行啊。』" voices=""/><msg @l="980" char_id="0" frame_id="-1" name="美帆"   text="『嗯呼，嗯，啊呜……嗯咕……啾啪。』" voices="miho08670"/><msg @l="982" char_id="-1" frame_id="-1" name=""   text="私处被撑开直达子宫口的感觉让我扭动着腰，同时用嘴唇套弄着口中的那物……" voices=""/><msg @l="984" char_id="0" frame_id="-1" name="美帆"   text="『啊啊，啊，啊……嗯呼……嗯咕，啾噗，啾噗噗。』" voices="miho08680"/><msg @l="986" char_id="-1" frame_id="-1" name="" text="第二次高潮即将来临。"   voices=""/><msg @l="987" char_id="-1" frame_id="-1" name=""   text="我努力地让舌头在口中的那物上啾噗啾噗地游走，身体因即将到来的甜美麻痹感而颤抖。" voices=""/><msg @l="989" char_id="-1" frame_id="-1" name="学生D" text="『要、要射了！』"   voices=""/><msg @l="991" char_id="-1" frame_id="-1" name=""   text="在我口中被舔着的肉棒颤抖起来，自己套弄着的他发出呻吟。" voices=""/><flash @l="994" count="4" fade="100" image="white"/><msg @l="996" char_id="0" frame_id="-1" name="美帆" text="『嗯哈……』"   voices="miho08700"/><msg @l="998" char_id="-1" frame_id="-1" name=""   text="在达到顶点的瞬间，他将自己套弄着的、含在我口中的肉茎抽出，对着我喷出大量精液。" voices=""/><msg @l="1000" char_id="-1" frame_id="-1" name="学生D"   text="『哦啊，果然射的话就该射在背上啊！！』" voices=""/><msg @l="1002" char_id="-1" frame_id="-1" name="学生B"   text="『好啊，我也马上就射给你！』" voices=""/><msg @l="1004" char_id="0" frame_id="-1" name="美帆"   text="『嗯啊…啊，嗯咕……啊！』" voices="miho08710"/><msg @l="1006" char_id="-1" frame_id="-1" name=""   text="仿佛是最后冲刺一般，侵犯着我私处的他加快了腰部的动作。" voices=""/><msg @l="1008" char_id="0" frame_id="-1" name="美帆"   text="『不行…那样的话……嗯，嗯呜！！』" voices="miho08720"/><msg @l="1010" char_id="-1" frame_id="-1" name="学生B"   text="『来吧，再高潮一次吧！！』" voices=""/><msg @l="1012" char_id="0" frame_id="-1" name="美帆"   text="『啊，啊啊…不，啊…要，要去了！！』" voices="miho08730"/><msg @l="1014" char_id="-1" frame_id="-1" name="学生B" text="『要，要射了！！』"   voices=""/><msg @l="1016" char_id="0" frame_id="-1" name="美帆"   text="『呃啊…啊，去了……啊，啊啊，嗯嗯嗯嗯！！！』" voices="miho08740"/><flash @l="1019" count="4" fade="100" image="white"/><wait_chgmv/><ev @l="1022" src="ev-013x2y3z4z5z6"/><msg @l="1024" char_id="0" frame_id="-1" name="美帆" text="『啊啊……』"   voices="miho08770"/><msg @l="1026" char_id="-1" frame_id="-1" name=""   text="颤抖高潮的背上，第三次白浊液体被注入。" voices=""/><msg @l="1027" char_id="-1" frame_id="-1" name=""   text="背上形成了精液的水洼，沿着腰线流下的精液……弄脏了桌子。" voices=""/><msg @l="1029" char_id="-1" frame_id="-1" name="学生B"   text="『浑身沾满精液的样子，你更可爱啊。』" voices=""/><msg @l="1031" char_id="-1" frame_id="-1" name=""   text="射完精液的他这么说着，将手指蘸取背上积聚的液滴送到我嘴边。" voices=""/><msg @l="1033" char_id="0" frame_id="-1" name="美帆"   text="『嗯呼……嗯，啧溜……。』" voices="miho08780"/><msg @l="1035" char_id="-1" frame_id="-1" name=""   text="我毫不犹豫地吮吸着那些……爱怜地咽了下去。" voices=""/><msg @l="1036" char_id="-1" frame_id="-1" name=""   text="现在，我体内只剩下遍布全身的甜美感觉……，……意识……开始模糊不清……。" voices=""/><label @l="1039" id="TempLabel_195"/><clear @l="1046" class="all"/><end_scene @l="1049"/><wait_chgmv/><bg @l="1053" src="bg12"/><msg @l="1055" char_id="-1" frame_id="-1" name="学生C"   text="『那么，接下来换我来让你高潮吧。』" voices=""/><msg @l="1057" char_id="-1" frame_id="-1" name="学生E" text="『帮我用嘴弄吧。』"   voices=""/><msg @l="1059" char_id="0" frame_id="-1" name="美帆"   text="『嗯啊……啊……嗯咕，啧噗，啧溜溜。』" voices="miho08790"/><msg @l="1061" char_id="-1" frame_id="-1" name=""   text="我顺从地含住递到面前的肉棒，同时紧紧夹住插入秘部的肉柱。" voices=""/><char @l="1065" id="kutsu" pos="auto" src="kutsu018"/><msg @l="1067" char_id="-1" frame_id="-1" name="朽木" text="『……。』" voices=""/><msg @l="1069" char_id="-1" frame_id="-1" name=""   text="而朽木就在稍远的地方，面带愉悦的表情，默默地注视着美帆被学生们侵犯的场景。" voices=""/><msg @l="1071" char_id="-1" frame_id="-1" name="朽木"   text="『太棒了……实在是太棒了，你啊。』" voices=""/><msg @l="1073" char_id="-1" frame_id="-1" name=""   text="他低声喃喃……爱怜地看着美帆。" voices=""/><stopbgm @l="1077" fadeout="1000"/><clear @l="1083" class="all"/><call @l="1089" target="EventLabel_48@ending10"/><return @l="1090" value="0&#13;&#10;"/></code></xscript>																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																						