<?xml version="1.0" encoding="utf-8"?><xscript><debug editor="&quot;C:\Program&#32;Files&#32;(x86)\sakura\sakura.exe&quot;&#32;&quot;%src%&quot;&#32;-Y=%line%"   src="D:\シロップ\町ぐるみの罠＋汚された夏セット版\汚された夏\完成データ\汚された夏\script\text\common_root03.txt"/><code><label @l="17" id="EventLabel_27"/><description @l="21" text="忧郁的日常"/><eval @l="23" expr="f.numDay=3&#13;&#10;"/><msgshow @l="25" show="false"/><wait_chgmv/><bg @l="27" src="day03" time="2000"/><wait @l="29" time="500"/><wait_chgmv/><bg @l="31" src="black" time="2000"/><msgshow @l="33" show="true"/><wait_chgmv/><bg @l="38" src="bg18m1"/><bgm @l="42" src="bgm02" volume="1."/><char @l="46" id="rei" pos="left" src="rei015"/><char @l="50" id="miho" pos="right" src="miho010"/><msg @l="52" char_id="1" frame_id="-1" name="玲" text="『早上起得太早……我不太擅长。』"   voices=""/><msg @l="54" char_id="-1" frame_id="-1" name=""   text="到达车站前的环形广场时，学姐小声嘀咕道。" voices=""/><msg @l="55" char_id="-1" frame_id="-1" name=""   text="因为白石学姐想在中午前回来，我们按照铁路线路的首班车时间离开了家。" voices=""/><msg @l="56" char_id="-1" frame_id="-1" name=""   text="虽然比JR的首班车要晚得多，但对于没有选修第一节课的学生来说，这已经可以称得上是“清晨”的电车了。"   voices=""/><msg @l="58" char_id="0" frame_id="-1" name="美帆"   text="『所以学姐才不太选第一节的课程啊。』" voices=""/><char @l="62" id="rei" pos="left" src="rei010"/><msg @l="64" char_id="1" frame_id="-1" name="玲" text="『就是这样。』" voices=""/><msg @l="66" char_id="1" frame_id="-1" name="玲"   text="『不过也有因为我在三年级时就已经修完了大部分必修课的原因。』" voices=""/><char @l="70" id="miho" pos="right" src="miho014"/><msg @l="72" char_id="0" frame_id="-1" name="美帆"   text="『啊……三年级内就完成？那样的话不就从早到晚都是课程吗……？』" voices=""/><msg @l="74" char_id="-1" frame_id="-1" name=""   text="确实如果在三年级内修完必修学分，四年级就会轻松许多，但那样的话每天就只剩下在大学和家之间往返了。"   voices=""/><msg @l="76" char_id="1" frame_id="-1" name="玲"   text="『是啊……嗯，一周大概有五天是这样的日子吧？』" voices=""/><char @l="80" id="miho" pos="right" src="miho016"/><msg @l="82" char_id="0" frame_id="-1" name="美帆" text="『那就等于是每天了好吗……』"   voices=""/><char @l="86" id="rei" pos="left" src="rei011"/><msg @l="88" char_id="1" frame_id="-1" name="玲" text="『这么说也对呢。』" voices=""/><msg @l="90" char_id="-1" frame_id="-1" name="" text="白石学姐爽朗地笑着回答道。"   voices=""/><msg @l="91" char_id="-1" frame_id="-1" name=""   text="从她的表情中丝毫感受不到一点辛苦，真是了不起。" voices=""/><msg @l="93" char_id="1" frame_id="-1" name="玲" text="『啊……电车，好像已经来了哦？』"   voices=""/><clear @l="97" layer="rei"/><char @l="101" id="miho" pos="right" src="miho014"/><msg @l="103" char_id="0" frame_id="-1" name="美帆" text="『啊，学姐……』"   voices=""/><char @l="107" id="miho" pos="right" src="miho010"/><msg @l="109" char_id="0" frame_id="-1" name="美帆" text="『………』" voices=""/><msg @l="111" char_id="0" frame_id="-1" name="美帆" text="(今天希望不会遇到痴汉……)"   voices=""/><stopbgm @l="114" fadeout="1000"/><clear @l="120" class="all"/><label @l="123" id="event_scene05_3"/><bgm @l="126" src="bgm07" volume="1."/><msg @l="128" char_id="-1" frame_id="-1" name="广播"   text="『呃，车厢非常拥挤……』" voices=""/><msg @l="130" char_id="-1" frame_id="-1" name="广播"   text="『请不要在途中停留，向车厢中部前进。』" voices=""/><msg @l="132" char_id="-1" frame_id="-1" name=""   text="在车站站点形成的队伍末尾排队等待了不到五分钟。" voices=""/><msg @l="133" char_id="-1" frame_id="-1" name=""   text="我和学姐跟随着人流被吞没进了车厢。" voices=""/><msg @l="135" char_id="0" frame_id="-1" name="美帆" text="『真的很挤呢……』"   voices="miho01100"/><msg @l="137" char_id="1" frame_id="-1" name="玲" text="『是啊……』"   voices="rei00090"/><msg @l="139" char_id="1" frame_id="-1" name="玲"   text="『在这个地方，想坐着舒舒服服地到大学是不可能的了吧。』" voices="rei00100"/><msg @l="141" char_id="-1" frame_id="-1" name=""   text="学姐说着苦笑了一下，我也跟着她一样露出苦笑。" voices=""/><msg @l="142" char_id="-1" frame_id="-1" name=""   text="尽管是始发站，车厢里却异常拥挤，别说坐下了，就连确保自己的立足之地都很费劲。" voices=""/><msg @l="144" char_id="1" frame_id="-1" name="玲" text="『那边……靠墙的地方，有空位哦。』"   voices="rei00110"/><msg @l="146" char_id="0" frame_id="-1" name="美帆" text="『啊，好的……』"   voices="miho01110"/><msg @l="148" char_id="-1" frame_id="-1" name=""   text="我按照学姐的指示，将身体滑入了墙边的空位。" voices=""/><msg @l="149" char_id="-1" frame_id="-1" name=""   text="然后我一直等着学姐来到我旁边，但不管等多久，都没有看到她的身影。" voices=""/><msg @l="150" char_id="-1" frame_id="-1" name=""   text="不仅如此，反而是一个素不相识的男人挤到了我的身边。" voices=""/><msg @l="152" char_id="0" frame_id="-1" name="美帆" text="『学姐……？』"   voices="miho01120"/><msg @l="154" char_id="-1" frame_id="-1" name=""   text="我透过人群的缝隙寻找失散的学姐的身影，突然与被挤到较远位置的她四目相对。" voices=""/><msg @l="156" char_id="1" frame_id="-1" name="玲" text="『对不起——……稍微分开了。』"   voices="rei00120"/><msg @l="158" char_id="-1" frame_id="-1" name=""   text="学姐露出抱歉的表情，在肩膀附近轻轻地挥了挥手。" voices=""/><msg @l="159" char_id="-1" frame_id="-1" name=""   text="一旦变成这样，再汇合就有点困难了。" voices=""/><eval @l="162" expr="s.event5flag=2&#13;&#10;"/><wait_chgmv/><ev @l="166" src="ev-005"/><se @l="170" buf="3" loop="true" src="電車走行中" volume="1."/><msg @l="172" char_id="0" frame_id="-1" name="美帆"   text="(唉……最终还是变成这样了……)" voices="miho01130"/><msg @l="174" char_id="-1" frame_id="-1" name=""   text="我在墙边的空间里紧抓着扶手，轻轻地叹了口气。" voices=""/><msg @l="175" char_id="-1" frame_id="-1" name="" text="结果……又是一个人了。"   voices=""/><msg @l="177" char_id="0" frame_id="-1" name="美帆"   text="(不过，只是和学姐乘坐同一班电车，感觉就完全不一样了呢)" voices="miho01140"/><msg @l="179" char_id="0" frame_id="-1" name="美帆" text="(精神上也轻松多了……而且)"   voices="miho01150"/><msg @l="181" char_id="-1" frame_id="-1" name=""   text="而且……如果有什么事，还可以向学姐求助。" voices=""/><msg @l="183" char_id="0" frame_id="-1" name="美帆" text="『……。』"   voices="miho01160"/><msg @l="185" char_id="0" frame_id="-1" name="美帆" text="(为什么我会这样想呢……)"   voices="miho01170"/><msg @l="187" char_id="0" frame_id="-1" name="美帆" text="(明明从一开始就什么都没有比较好)"   voices="miho01180"/><msg @l="189" char_id="-1" frame_id="-1" name=""   text="平时我并不会这么消极思考。" voices=""/><msg @l="190" char_id="-1" frame_id="-1" name=""   text="思绪变得这么负面，大概是因为这两天连续遭遇痴汉所带来的影响吧。" voices=""/><msg @l="191" char_id="-1" frame_id="-1" name=""   text="不知不觉中，我开始担心今天是否也会发生，产生了多余的恐惧。" voices=""/><goto @l="194" cond="!(f.痴漢flag&#32;==&#32;2)&#13;&#10;"   label="TempLabel_162"/><msg @l="197" char_id="0" frame_id="-1" name="美帆"   text="(那个痴汉是在盯着我……对吧)" voices="miho01190"/><msg @l="199" char_id="0" frame_id="-1" name="美帆"   text="(如果是这样的话，今天可能也会被盯上……)" voices="miho01200"/><msg @l="201" char_id="0" frame_id="-1" name="美帆" text="(今天也……)"   voices="miho01210"/><goto @l="204" label="TempLabel_163"/><label @l="205" id="TempLabel_162"/><goto @l="206" cond="!(f.名前を知られてるflag&#32;==&#32;1)&#13;&#10;"   label="TempLabel_164"/><msg @l="210" char_id="0" frame_id="-1" name="美帆" text="(那个痴汉知道我的名字……)"   voices="miho01220"/><msg @l="212" char_id="0" frame_id="-1" name="美帆"   text="(这是不是意味着，从一开始他就是针对我进行痴汉行为的……？)" voices="miho01230"/><msg @l="214" char_id="0" frame_id="-1" name="美帆" text="(但是……这种事情……)"   voices="miho01240"/><goto @l="218" label="TempLabel_163"/><label @l="219" id="TempLabel_164"/><goto @l="220"   cond="!((f.痴漢flag&#32;==&#32;1)&#32;&amp;&#32;(f.名前を知られてるflag&#32;==&#32;0))&#13;&#10;"   label="TempLabel_165"/><msg @l="224" char_id="0" frame_id="-1" name="美帆" text="(说起来……)"   voices="miho01250"/><msg @l="226" char_id="0" frame_id="-1" name="美帆"   text="(前几天那个痴汉……好像说了什么后续之类的……)" voices="miho01260"/><msg @l="228" char_id="0" frame_id="-1" name="美帆"   text="(啊………难道说，昨天的痴汉也是？)" voices="miho01270"/><goto @l="231" label="TempLabel_163"/><label @l="232" id="TempLabel_165"/><goto @l="233" cond="!(f.痴漢flag&#32;==&#32;0)&#13;&#10;"   label="TempLabel_166"/><msg @l="237" char_id="0" frame_id="-1" name="美帆"   text="(不管怎么说，这么多巧合不可能接连发生……)" voices="miho01280"/><msg @l="239" char_id="0" frame_id="-1" name="美帆"   text="(为什么总是我……这种事情……)" voices="miho01290"/><msg @l="241" char_id="0" frame_id="-1" name="美帆" text="(不可能……的吧……)"   voices="miho01300"/><label @l="244" id="TempLabel_166"/><label @l="245" id="TempLabel_163"/><msg @l="248" char_id="-1" frame_id="-1" name=""   text="回过神来，我发现自己正用惊慌失措的眼神环顾四周的人群。" voices=""/><msg @l="249" char_id="-1" frame_id="-1" name=""   text="视野中的每个人都开始让我觉得像是痴汉。" voices=""/><msg @l="250" char_id="-1" frame_id="-1" name=""   text="不过，从旁人看来，像这样坐立不安的我或许才更显得可疑吧。" voices=""/><clear @l="256" class="all"/><msg @l="259" char_id="0" frame_id="-1" name="美帆" text="(稍微冷静一下……)"   voices="miho01310"/><msg @l="261" char_id="0" frame_id="-1" name="美帆"   text="(学姐也在，应该没事……必须这么想才行)" voices="miho01320"/><msg @l="263" char_id="-1" frame_id="-1" name=""   text="我越过自己的肩膀，在人群中寻找已经混入其中的学长的身影。" voices=""/><msg @l="264" char_id="-1" frame_id="-1" name=""   text="说是寻找，连扭动半个身子都困难无比。" voices=""/><msg @l="265" char_id="-1" frame_id="-1" name=""   text="最多只能透过乘客之间的缝隙往学长所在的方向窥视一下。" voices=""/><msg @l="267" char_id="0" frame_id="-1" name="美帆" text="(学姐……在哪里呢……？)"   voices="miho01330"/><msg @l="269" char_id="-1" frame_id="-1" name=""   text="我试着将视线投向刚才学长所在的区域，但人墙没有丝毫缝隙，甚至连一点空隙都没有，结果……我无法找到学长的身影。"   voices=""/><wait_chgmv/><ev @l="273" src="ev-005"/><msg @l="275" char_id="0" frame_id="-1" name="美帆"   text="(果然，上车时分开坐是个失误啊)" voices="miho01340"/><msg @l="277" char_id="0" frame_id="-1" name="美帆"   text="(早知如此，一开始就应该更加——咦？)" voices="miho01350"/><stopbgm @l="281" fadeout="1000"/><msg @l="283" char_id="-1" frame_id="-1" name="" text="突然，我在臀部附近感到一丝异样。"   voices=""/><msg @l="284" char_id="-1" frame_id="-1" name=""   text="隔着裙子蠕动的那个东西——————是痴汉的手！" voices=""/><bgm @l="288" src="bgm15" volume="1."/><wait_chgmv/><ev @l="292" src="ev-005ax1"/><description @l="295" text="痴汉三度来袭"/><msg @l="297" char_id="0" frame_id="-1" name="美帆" text="(啊——————！？)"   voices="miho01360"/><msg @l="299" char_id="-1" frame_id="-1" name="" text="果然被盯上了……我这样想着。"   voices=""/><msg @l="301" char_id="0" frame_id="-1" name="美帆"   text="(总、总之要冷静下来……去找学姐求救……)" voices="miho01370"/><msg @l="303" char_id="-1" frame_id="-1" name="" text="我这样想着准备转过身去。"   voices=""/><msg @l="304" char_id="-1" frame_id="-1" name=""   text="然而，痴汉的手紧紧抓住了我正要转身的肩膀。" voices=""/><msg @l="305" char_id="-1" frame_id="-1" name=""   text="感到疼痛，但因恐惧而发不出声音，我只能竭尽全力看着抓住我肩膀的那只手。" voices=""/><msg @l="306" char_id="-1" frame_id="-1" name=""   text="那只手像是在享受我纤细肩膀的触感，手指不断地蠕动着。" voices=""/><msg @l="308" char_id="-1" frame_id="-1" name="痴汉" text="『又见面了，仲根美帆君。』"   voices=""/><goto @l="312"   cond="!((f.名前を知られてるflag&#32;==&#32;0)&#32;&amp;&#32;(f.痴漢flag&#32;==&#32;0))&#13;&#10;"   label="TempLabel_167"/><msg @l="314" char_id="0" frame_id="-1" name="美帆"   text="『咦……你怎么知道我的名字的？』" voices="miho01380"/><msg @l="316" char_id="-1" frame_id="-1" name="痴汉"   text="『难道你以为连续三天被痴汉骚扰是偶然吗？』" voices=""/><msg @l="318" char_id="0" frame_id="-1" name="美帆"   text="『怎么会……那就是说昨天和前天也是你……！？』" voices="miho01390"/><msg @l="320" char_id="-1" frame_id="-1" name="痴汉"   text="『呵呵……当然了。你现在才发现吗。』" voices=""/><msg @l="322" char_id="-1" frame_id="-1" name="痴汉"   text="『还是说你更希望被三个不同的男人轮流猥亵呢。』" voices=""/><msg @l="324" char_id="-1" frame_id="-1" name="痴汉"   text="『要不要我去叫隔壁的乘客过来？但得等我玩够了之后……。』" voices=""/><msg @l="326" char_id="0" frame_id="-1" name="美帆"   text="『为什么会这样……为什么，要选我这样的人……。』" voices="miho01400"/><msg @l="328" char_id="-1" frame_id="-1" name="痴汉" text="『嗯，这个嘛，为什么呢。』"   voices=""/><goto @l="332" label="TempLabel_168"/><label @l="333" id="TempLabel_167"/><goto @l="334"   cond="!((f.名前を知られてるflag&#32;==&#32;0)&#32;&amp;&#32;(f.痴漢flag&#32;&gt;=&#32;1))&#13;&#10;"   label="TempLabel_169"/><msg @l="337" char_id="0" frame_id="-1" name="美帆"   text="『什……为什么你会知道我的名字……。』" voices="miho01410"/><msg @l="339" char_id="-1" frame_id="-1" name="痴汉"   text="『呵呵……你以为我会连续3天对一个连名字都不知道的人进行痴汉行为吗？』" voices=""/><msg @l="341" char_id="-1" frame_id="-1" name="痴汉"   text="『现在我只知道你的名字，但如果每天都这样在电车里抚摸你的身体，总有一天会了解你的一切……是的，每一寸都会了解。』"   voices=""/><msg @l="343" char_id="0" frame_id="-1" name="美帆" text="『别、别糊弄我！』"   voices="miho01420"/><msg @l="345" char_id="-1" frame_id="-1" name=""   text="我小声地说，但尽量表现得愤怒。" voices=""/><msg @l="346" char_id="-1" frame_id="-1" name=""   text="尽管如此，我的声音依然缺乏气势。" voices=""/><msg @l="348" char_id="-1" frame_id="-1" name="痴汉"   text="『哎呀哎呀，温顺的女孩生气起来很可怕这句话果然是真的。』" voices=""/><msg @l="350" char_id="-1" frame_id="-1" name="痴汉"   text="『然而，你该担心的不是我如何知道你的名字，而是如何从这种状况中脱身，不是吗？』"   voices=""/><msg @l="352" char_id="0" frame_id="-1" name="美帆" text="『……。』"   voices="miho01430"/><goto @l="355" label="TempLabel_168"/><label @l="356" id="TempLabel_169"/><goto @l="357" cond="!(f.名前を知られてるflag&#32;==&#32;1)&#13;&#10;"   label="TempLabel_170"/><msg @l="360" char_id="0" frame_id="-1" name="美帆"   text="『你……又……是吗……。』" voices="miho01440"/><msg @l="362" char_id="-1" frame_id="-1" name="痴汉"   text="『真不错，你生气时的表情很好看。』" voices=""/><msg @l="364" char_id="-1" frame_id="-1" name="痴汉"   text="『而且……从昨天的情况来看，似乎你并不讨厌吧？』" voices=""/><msg @l="366" char_id="0" frame_id="-1" name="美帆" text="『……。』"   voices="miho01450"/><msg @l="368" char_id="-1" frame_id="-1" name="痴汉"   text="『呵呵，算了。就算你上面的嘴不说话，我也能从下面的嘴知道你的真心。』" voices=""/><msg @l="370" char_id="0" frame_id="-1" name="美帆" text="『………唔……。』"   voices="miho01460"/><msg @l="372" char_id="-1" frame_id="-1" name="痴汉" text="『那么……今天我可不会让你逃掉。』"   voices=""/><label @l="375" id="TempLabel_170"/><label @l="376" id="TempLabel_168"/><goto @l="380" cond="!(f.痴漢flag&#32;&lt;=&#32;1)&#13;&#10;"   label="TempLabel_171"/><msg @l="382" char_id="-1" frame_id="-1" name="" text="滑动。" voices=""/><wait_chgmv/><ev @l="386" src="ev-005ax3y2"/><msg @l="388" char_id="-1" frame_id="-1" name=""   text="痴汉的手慢慢地把裙子稍微掀起，然后侵入到里面。" voices=""/><msg @l="389" char_id="-1" frame_id="-1" name="" text="摸，摸。" voices=""/><msg @l="391" char_id="0" frame_id="-1" name="美帆" text="『……唔……。』"   voices="miho09930"/><msg @l="393" char_id="-1" frame_id="-1" name=""   text="每当那粗糙的手触感抚过白皙的大腿，我都感到恶心，不由自主地缩腰后退。" voices=""/><msg @l="394" char_id="-1" frame_id="-1" name=""   text="然而这样一来，臀部反而向着痴汉方向突出，痴汉立即一把抓住了我的臀部。" voices=""/><msg @l="396" char_id="0" frame_id="-1" name="美帆" text="『……啊……。』"   voices="miho00430"/><msg @l="398" char_id="-1" frame_id="-1" name=""   text="另一只手则抓住我如桃子般光滑的腰部，不让我逃脱。" voices=""/><msg @l="399" char_id="-1" frame_id="-1" name=""   text="就这样，在我无法逃脱的状况下，痴汉的手隔着内裤触碰到了那里。" voices=""/><msg @l="401" char_id="0" frame_id="-1" name="美帆" text="『不要，请住手……。』"   voices="miho01470"/><msg @l="403" char_id="-1" frame_id="-1" name=""   text="我扭动着身体，试图从痴汉的手中逃脱。" voices=""/><msg @l="405" char_id="-1" frame_id="-1" name="痴汉"   text="『哎呀，这样抵抗真的好吗？』" voices=""/><msg @l="407" char_id="-1" frame_id="-1" name="痴汉"   text="『如果闹大了，受困扰的不是你自己吗？』" voices=""/><msg @l="409" char_id="0" frame_id="-1" name="美帆" text="『那、那个……。』"   voices="miho01480"/><msg @l="411" char_id="-1" frame_id="-1" name="痴汉"   text="『呵呵……如果不想被乘客目睹你被痴汉骚扰的场面，引起奇怪的传闻，就乖乖保持沉默吧。』" voices=""/><msg @l="413" char_id="-1" frame_id="-1" name=""   text="痴汉说着，隔着内裤试图将手指伸进秘处，掰开那如花朵般隆起的柔软肉瓣，另外的手指像是拨开般挑逗着。"   voices=""/><msg @l="415" char_id="0" frame_id="-1" name="美帆" text="『………。』"   voices="miho09880"/><msg @l="417" char_id="-1" frame_id="-1" name=""   text="然后，让紧闭的肉瓣中渗出的些微蜜液浸湿了内裤。" voices=""/><msg @l="419" char_id="-1" frame_id="-1" name="痴汉"   text="『如果不是在车厢内，我真想好好享受你那馥郁的香气……。』" voices=""/><msg @l="421" char_id="-1" frame_id="-1" name=""   text="痴汉深深地吸了一口周围的空气。" voices=""/><msg @l="422" char_id="-1" frame_id="-1" name=""   text="试图从中嗅出那微量飘散的圣蜜香气。" voices=""/><msg @l="423" char_id="-1" frame_id="-1" name=""   text="我拼命想紧闭双腿拒绝他的进入，可痴汉强行将一条腿插入我的双腿之间，迫使我张开了大腿。"   voices=""/><msg @l="424" char_id="-1" frame_id="-1" name=""   text="我的双腿因羞耻和恐惧交织，不住地颤抖起来。" voices=""/><msg @l="426" char_id="0" frame_id="-1" name="美帆" text="『……唔……。』"   voices="miho01490"/><msg @l="428" char_id="-1" frame_id="-1" name="痴汉"   text="『对，很好……就这样保持安静就行。』" voices=""/><msg @l="430" char_id="-1" frame_id="-1" name=""   text="他沉醉于强行分开我惊恐双腿的快感，低声对我说道。" voices=""/><msg @l="432" char_id="-1" frame_id="-1" name="痴汉"   text="『你这里，很快就会变得湿漉漉的，感觉很舒服。』" voices=""/><msg @l="434" char_id="-1" frame_id="-1" name=""   text="痴汉说着，将身体紧贴过来，毫不客气地把手伸进我无力抵抗而被迫张开的双腿间。" voices=""/><msg @l="435" char_id="-1" frame_id="-1" name=""   text="然后隔着内裤将指尖压进了花瓣般的唇间。" voices=""/><msg @l="437" char_id="0" frame_id="-1" name="美帆" text="『……呀……。』"   voices="miho00740"/><msg @l="439" char_id="-1" frame_id="-1" name=""   text="极度的恶心感让我眼中泛起泪花，拼命忍耐着。" voices=""/><msg @l="440" char_id="-1" frame_id="-1" name=""   text="但是，我越是忍耐，那挑逗私处的鲜活指尖触感就越是透过一层薄布清晰地传递过来。" voices=""/><msg @l="441" char_id="-1" frame_id="-1" name="" text="咕唔。" voices=""/><msg @l="443" char_id="0" frame_id="-1" name="美帆" text="『呃！』"   voices="miho00750"/><msg @l="445" char_id="-1" frame_id="-1" name=""   text="痴汉用手指拉起我的内裤，制造出一个能伸入手指的空间。" voices=""/><msg @l="446" char_id="-1" frame_id="-1" name=""   text="如果此刻没有裙子的遮挡，我粉色的私密入口就会暴露在周围人面前。" voices=""/><msg @l="448" char_id="-1" frame_id="-1" name="痴汉"   text="『呵呵呵，今天我要直接好好享用一番。』" voices=""/><msg @l="450" char_id="-1" frame_id="-1" name=""   text="就在我惊愕之际，痴汉迅速将手指伸进内裤里，直接触碰到了我鲑鱼粉色的阴唇。" voices=""/><msg @l="451" char_id="-1" frame_id="-1" name="" text="咕啾。" voices=""/><msg @l="453" char_id="0" frame_id="-1" name="美帆" text="『……唔……。』"   voices="miho09930"/><msg @l="455" char_id="-1" frame_id="-1" name=""   text="第一次被触碰私处的感觉……而且对方还是一个不知是谁的痴汉，更可怕的是这发生在公共电车上……。" voices=""/><msg @l="456" char_id="-1" frame_id="-1" name="" text="我变得非常悲伤……。"   voices=""/><msg @l="457" char_id="-1" frame_id="-1" name="" text="咕啾，姆啾。" voices=""/><msg @l="459" char_id="0" frame_id="-1" name="美帆" text="『不要……那里是……。』"   voices="miho00410"/><msg @l="461" char_id="-1" frame_id="-1" name=""   text="践踏着我这种心情，痴汉的手指随心所欲地沿着秘裂的缝隙摩擦上下。" voices=""/><msg @l="462" char_id="-1" frame_id="-1" name="" text="痴汉的手指执拗地玩弄着我的私处。"   voices=""/><msg @l="463" char_id="-1" frame_id="-1" name=""   text="如果这根手指突然插入我的秘穴中的话……。" voices=""/><msg @l="464" char_id="-1" frame_id="-1" name=""   text="这么想着，我瞬间就感到血色尽失。" voices=""/><msg @l="466" char_id="0" frame_id="-1" name="美帆"   text="『不行……果然，这种事我忍受不了！』" voices="miho01500"/><msg @l="468" char_id="-1" frame_id="-1" name="痴汉"   text="『忍受不了又能怎样呢？』" voices=""/><msg @l="470" char_id="-1" frame_id="-1" name="痴汉"   text="『你要出声吗？说我正在被人猥亵？』" voices=""/><msg @l="472" char_id="-1" frame_id="-1" name="痴汉"   text="『你做不到的。对人视线过度意识的你，不可能做出这种大胆的抵抗。』" voices=""/><msg @l="474" char_id="0" frame_id="-1" name="美帆"   text="『这种……与其被这样对待，我宁愿……』" voices="miho01510"/><msg @l="476" char_id="-1" frame_id="-1" name="痴汉" text="『呵呵，你打算怎么做呢？』"   voices=""/><clear @l="482" class="all"/><end_scene @l="485"/><eval @l="488" expr="f.localflag&#32;=&#32;0&#13;&#10;"/><goto @l="491" cond="!(f.痴漢flag&#32;==&#32;1)&#13;&#10;"   label="TempLabel_172"/><description @l="494" text="审判的时刻到了？"/><stopbgm @l="498" fadeout="1000"/><msg @l="500" char_id="-1" frame_id="-1" name="声音"   text="『到此为止如何，朽木教授。』" voices=""/><msg @l="510" char_id="-1" frame_id="-1" name="朽木" text="『呃啊！？』" voices=""/><msg @l="512" char_id="-1" frame_id="-1" name=""   text="人群中传来声音，紧接着我身后的男人发出痛苦的叫声。" voices=""/><msg @l="513" char_id="-1" frame_id="-1" name=""   text="同时，那只隔着内裤玩弄我私处的手被拔出，我慌忙整理被掀起的裙摆。" voices=""/><msg @l="515" char_id="-1" frame_id="-1" name="朽木" text="『放开！快放开我的手！！』"   voices=""/><msg @l="517" char_id="0" frame_id="-1" name="美帆" text="『朽木……教授？』"   voices="miho01520"/><msg @l="519" char_id="-1" frame_id="-1" name=""   text="当我战战兢兢地回头看时，站在我身后的不是什么陌生男子，而是在我专攻的研讨班担任讲师的朽木阳大教授。"   voices=""/><msg @l="520" char_id="-1" frame_id="-1" name=""   text="朽木教授的一只胳膊被扭到背后。" voices=""/><msg @l="521" char_id="-1" frame_id="-1" name=""   text="而扭住他手臂的，竟然是稻庭学长。" voices=""/><msg @l="523" char_id="-1" frame_id="-1" name="朽木"   text="『不，不是那样的……我什么都没做。』" voices=""/><msg @l="525" char_id="-1" frame_id="-1" name="朽木"   text="『你会相信我的，对吧？仲根同学。』" voices=""/><msg @l="527" char_id="-1" frame_id="-1" name=""   text="说着，朽木教授用近乎哀求的眼神注视着我。" voices=""/><msg @l="529" char_id="0" frame_id="-1" name="美帆"   text="『我，我……不知道………。』" voices="miho01530"/><msg @l="531" char_id="-1" frame_id="-1" name=""   text="我……无法给教授的话语一个明确的回答，只能移开视线。" voices=""/><msg @l="532" char_id="-1" frame_id="-1" name=""   text="老实说，我完全不知所措了。" voices=""/><msg @l="533" char_id="-1" frame_id="-1" name=""   text="我尊敬的教授竟然会对我实施猥亵行为……。" voices=""/><msg @l="535" char_id="-1" frame_id="-1" name="稻庭"   text="『言辞狡辩的话留到以后再好好听您解释吧，教授。』" voices=""/><msg @l="537" char_id="-1" frame_id="-1" name="稻庭"   text="『或者您更愿意在这里继续当着所有人的面做那些难堪的辩解？』" voices=""/><msg @l="539" char_id="-1" frame_id="-1" name="朽木" text="『咕……。』" voices=""/><msg @l="541" char_id="-1" frame_id="-1" name=""   text="听到那男子的话，朽木教授脸上浮现出一副像是咬到了苦虫般的表情。" voices=""/><msg @l="543" char_id="0" frame_id="-1" name="美帆" text="『……。』"   voices="miho01540"/><msg @l="545" char_id="-1" frame_id="-1" name=""   text="我只是无法相信这一切，只能呆呆地望着两人之间的对话，什么也做不了。" voices=""/><stopse @l="549" buf="3"/><clear @l="555" class="all"/><msgshow @l="557" show="true"/><wait_chgmv/><bg @l="562" src="bg07"/><bgm @l="566" src="bgm03" volume="1."/><msg @l="568" char_id="-1" frame_id="-1" name=""   text="朽木教授像是滑行一般地从到达大学校园的有轨电车上下了车。" voices=""/><msg @l="569" char_id="-1" frame_id="-1" name=""   text="稻庭学长紧跟其后也下了车，我也跟着他们下了车。" voices=""/><msg @l="570" char_id="-1" frame_id="-1" name=""   text="同样下车的学生们好奇地看着我们，一边窃窃私语一边离开。" voices=""/><msg @l="571" char_id="-1" frame_id="-1" name=""   text="而我……只能深深地低着头，默默承受着这一切。" voices=""/><msg @l="573" char_id="1" frame_id="-1" name="玲" text="『美帆……还有，稻庭先生？』"   voices=""/><msg @l="575" char_id="0" frame_id="-1" name="美帆" text="『啊……。』" voices=""/><char @l="579" id="rei" pos="auto" src="rei014"/><msg @l="581" char_id="-1" frame_id="-1" name=""   text="在大部分乘客都下车后，我们在车内走散的白石学姐也下了车。" voices=""/><msg @l="582" char_id="-1" frame_id="-1" name=""   text="看她下车晚了一些，恐怕是在车内找我了吧。" voices=""/><msg @l="584" char_id="1" frame_id="-1" name="玲" text="『发生什么事了吗？』" voices=""/><msg @l="586" char_id="0" frame_id="-1" name="美帆"   text="『学姐……能不能请您在前面一点的地方等我？』" voices=""/><msg @l="588" char_id="0" frame_id="-1" name="美帆" text="『我马上……就去找您。』"   voices=""/><msg @l="590" char_id="1" frame_id="-1" name="玲" text="『………。』" voices=""/><msg @l="592" char_id="-1" frame_id="-1" name=""   text="学姐听了我的话后，依次看向稻庭学长和朽木教授。" voices=""/><msg @l="593" char_id="-1" frame_id="-1" name=""   text="然后……仿佛察觉到了什么似的轻轻点了点头。" voices=""/><char @l="597" id="rei" pos="auto" src="rei010"/><msg @l="599" char_id="1" frame_id="-1" name="玲"   text="『我知道了……我在工学部校舍前等你。』" voices=""/><clear @l="603" class="char"/><msg @l="605" char_id="-1" frame_id="-1" name=""   text="说完这句话，学姐最后看了一眼稻庭学长，然后离开了。" voices=""/><msg @l="607" char_id="-1" frame_id="-1" name="朽木" text="『……咕，差不多该放开我了吧！』"   voices=""/><char @l="611" id="kutsu" pos="right" src="kutsu010"/><char @l="615" id="inaba" pos="left" src="inaba017"/><msg @l="617" char_id="-1" frame_id="-1" name="稻庭"   text="『教授，您最好清楚认识自己的立场。』" voices=""/><msg @l="619" char_id="-1" frame_id="-1" name="稻庭"   text="『您刚才对自己的学生实施了猥亵行为。没有自觉比行为本身更为严重。』" voices=""/><char @l="622" id="kutsu" pos="right" src="kutsu014"/><msg @l="624" char_id="-1" frame_id="-1" name="朽木" text="『你这家伙……是大四的稻庭，对吧。』"   voices=""/><msg @l="626" char_id="-1" frame_id="-1" name="稻庭" text="『您倒是知道得很清楚啊。』"   voices=""/><char @l="629" id="kutsu" pos="right" src="kutsu010"/><msg @l="631" char_id="-1" frame_id="-1" name="朽木"   text="『当然知道，你可是校园里的名人啊。』" voices=""/><msg @l="633" char_id="-1" frame_id="-1" name="稻庭"   text="『虽然我没上过教授的课，但您的大名我可是经常有所耳闻。』" voices=""/><msg @l="635" char_id="-1" frame_id="-1" name="稻庭"   text="『说是有个对学生实施猥亵行为的恶劣教授，就是这样。』" voices=""/><char @l="639" id="kutsu" pos="right" src="kutsu014"/><msg @l="641" char_id="-1" frame_id="-1" name="朽木" text="『别、别胡说八道！』"   voices=""/><msg @l="643" char_id="-1" frame_id="-1" name="稻庭"   text="『是胡说吗？那么今天对仲根同学所做的行为，您打算如何辩解呢？』" voices=""/><msg @l="645" char_id="-1" frame_id="-1" name="朽木"   text="『我、我只是……发现仲根同学遭遇了痴汉，正想伸手帮她而已。』" voices=""/><msg @l="647" char_id="-1" frame_id="-1" name="朽木"   text="『怎么可能……会做出痴汉行为。』" voices=""/><msg @l="649" char_id="-1" frame_id="-1" name="稻庭"   text="『嗯，这真相如何她应该很清楚才对。』" voices=""/><char @l="653" id="miho" pos="right" src="miho114"/><msg @l="655" char_id="0" frame_id="-1" name="美帆" text="『诶……？』" voices=""/><char @l="659" id="inaba" pos="left" src="inaba010"/><msg @l="661" char_id="-1" frame_id="-1" name="稻庭"   text="『你想控告他对你实施痴汉行为吗？』" voices=""/><msg @l="663" char_id="0" frame_id="-1" name="美帆" text="『控告……？』" voices=""/><msg @l="665" char_id="-1" frame_id="-1" name="稻庭"   text="『是的，痴汉可是严重的犯罪行为。』" voices=""/><msg @l="667" char_id="-1" frame_id="-1" name="稻庭"   text="『如果你有意愿的话，可以提出告诉。只要有确凿证据，就能作为刑事案件……』" voices=""/><char @l="670" id="kutsu" pos="right" src="kutsu014"/><msg @l="672" char_id="-1" frame_id="-1" name="朽木"   text="『等、请等一下……如果要联系警察那也行。』" voices=""/><msg @l="674" char_id="-1" frame_id="-1" name="朽木"   text="『但是，一上来就告诉是不是太过分了……。』" voices=""/><char @l="678" id="inaba" pos="left" src="inaba017"/><msg @l="680" char_id="-1" frame_id="-1" name="稻庭"   text="『我听说传闻中的教授在警察那里也有人脉呢。』" voices=""/><msg @l="682" char_id="-1" frame_id="-1" name="稻庭"   text="『而且，对罪行的判断还是交给检察官比较好吧。』" voices=""/><char @l="686" id="kutsu" pos="right" src="kutsu018"/><msg @l="688" char_id="-1" frame_id="-1" name="朽木" text="『……。』" voices=""/><char @l="691" id="miho" pos="left" src="miho115"/><msg @l="693" char_id="-1" frame_id="-1" name="" text="朽木教授默默地瞪着我。"   voices=""/><msg @l="694" char_id="-1" frame_id="-1" name=""   text="大概是在说“别告诉”的意思吧。" voices=""/><msg @l="695" char_id="-1" frame_id="-1" name="" text="真是讨厌的……眼神。" voices=""/><msg @l="697" char_id="-1" frame_id="-1" name="稻庭"   text="『怎么办？要告他吗？』" voices=""/><msg @l="702" async="true" char_id="-1" frame_id="-1" name=""   text="起诉朽木教授……？" voices=""/><select @l="703"><menu @l="707" label="TempLabel_173" text="起诉"/><menu @l="710" label="TempLabel_175" text="不起诉"/></select><goto @l="715" label="TempLabel_174"/><label @l="717" id="TempLabel_173"/><eval @l="719" expr="f.localflag&#32;=&#32;0&#13;&#10;"/><goto @l="720" label="TempLabel_174"/><label @l="722" id="TempLabel_175"/><eval @l="724" expr="f.localflag&#32;=&#32;1&#13;&#10;"/><goto @l="725" label="TempLabel_174"/><label @l="727" id="TempLabel_174"/><goto @l="734" label="TempLabel_176"/><label @l="738" id="TempLabel_176"/><goto @l="739" cond="(f.localflag)&#32;!=&#32;(0)&#13;&#10;"   label="TempLabel_177"/><msg @l="742" char_id="0" frame_id="-1" name="美帆" text="『我……要起诉。』"   voices=""/><char @l="745" id="kutsu" pos="right" src="kutsu014"/><msg @l="747" char_id="-1" frame_id="-1" name="朽木"   text="『什……仲根君，你是认真的吗！？』" voices=""/><msg @l="749" char_id="0" frame_id="-1" name="美帆"   text="『我是认真的……这几天我真的一直生活在恐惧中。』" voices=""/><msg @l="751" char_id="0" frame_id="-1" name="美帆"   text="『就这样不了了之……我做不到。』" voices=""/><clear @l="754" class="char"/><char @l="756" id="inaba" pos="left" src="inaba010"/><char @l="758" id="miho" pos="right" src="miho115"/><msg @l="760" char_id="-1" frame_id="-1" name="稻庭"   text="『好的，那我认识一位律师，我可以介绍给你。』" voices=""/><msg @l="762" char_id="-1" frame_id="-1" name="稻庭"   text="『他会耐心解释你不明白的事情，而且最重要的是值得信赖。』" voices=""/><char @l="765" id="kutsu" pos="right" src="kutsu014"/><msg @l="767" char_id="-1" frame_id="-1" name="朽木" text="『稻庭……你多管闲事！』"   voices=""/><char @l="770" id="inaba" pos="left" src="inaba017"/><msg @l="772" char_id="-1" frame_id="-1" name="稻庭"   text="『哎呀，教授……请不要说些输不起的话。』" voices=""/><msg @l="774" char_id="-1" frame_id="-1" name="稻庭"   text="『她是说，她想要按照自己所经历的恐惧，给你以报复。』" voices=""/><msg @l="776" char_id="-1" frame_id="-1" name="稻庭"   text="『我只是在帮她达成这一点而已。』" voices=""/><char @l="779" id="miho" pos="right" src="miho115"/><msg @l="781" char_id="0" frame_id="-1" name="美帆" text="『报复什么的……怎么会。』"   voices=""/><msg @l="783" char_id="0" frame_id="-1" name="美帆"   text="『我只是，希望这种事不要再发生了……就是这样。』" voices=""/><char @l="786" id="inaba" pos="left" src="inaba010"/><msg @l="788" char_id="-1" frame_id="-1" name="稻庭"   text="『你完全没必要感到愧疚哦？』" voices=""/><msg @l="790" char_id="-1" frame_id="-1" name="稻庭"   text="『犯罪的人在适当的地方接受审判，这在现代社会是常识。』" voices=""/><msg @l="792" char_id="0" frame_id="-1" name="美帆"   text="『但是，我并不是出于报复的想法才起诉的……』" voices=""/><msg @l="794" char_id="-1" frame_id="-1" name="稻庭"   text="『啊……是我的表述不当。』" voices=""/><msg @l="796" char_id="-1" frame_id="-1" name="稻庭"   text="『不过，真没想到你居然会真的说要起诉。』" voices=""/><msg @l="798" char_id="0" frame_id="-1" name="美帆"   text="『啊……这是什么意思……？』" voices=""/><msg @l="800" char_id="-1" frame_id="-1" name="稻庭" text="『不，没什么，你不用在意。』"   voices=""/><msg @l="802" char_id="-1" frame_id="-1" name=""   text="稻庭学长露出了亲切的微笑。" voices=""/><msg @l="803" char_id="-1" frame_id="-1" name=""   text="那是前几天在我和朋友面前展现的那种完美笑容。" voices=""/><msg @l="805" char_id="-1" frame_id="-1" name="稻庭"   text="『那么，这是我一位熟人的名片。』" voices=""/><msg @l="807" char_id="-1" frame_id="-1" name=""   text="说着，稻庭学长从手册中取出一张名片，递给了我。" voices=""/><msg @l="808" char_id="-1" frame_id="-1" name=""   text="虽然我很疑惑他为什么在这种场合随身携带这个，但我只能老实地接过他递来的名片。"   voices=""/><msg @l="810" char_id="-1" frame_id="-1" name="稻庭"   text="『如果说是我介绍的，他应该会好好对待你的。』" voices=""/><msg @l="812" char_id="0" frame_id="-1" name="美帆"   text="『啊，好的…………谢谢您。』" voices=""/><msg @l="814" char_id="-1" frame_id="-1" name="稻庭"   text="『那我先走了，你没问题吧？』" voices=""/><msg @l="816" char_id="0" frame_id="-1" name="美帆" text="『……嗯。』" voices=""/><msg @l="818" char_id="-1" frame_id="-1" name="稻庭" text="『那么，加油哦。』"   voices=""/><clear @l="822" class="char"/><char @l="824" id="miho" pos="auto" src="miho015"/><msg @l="827" char_id="-1" frame_id="-1" name=""   text="稻庭学长就像之前的热心都是谎言或玩笑一样，轻描淡写地说完这句话就离开了那里。" voices=""/><msg @l="828" char_id="-1" frame_id="-1" name="" text="简直就像……失去了兴趣的孩子一样。"   voices=""/><clear @l="831" class="char"/><char @l="833" id="miho" pos="left" src="miho015"/><char @l="835" id="kutsu" pos="right" src="kutsu010"/><msg @l="837" char_id="-1" frame_id="-1" name="朽木"   text="『仲根同学……能不能重新考虑一下？』" voices=""/><msg @l="839" char_id="-1" frame_id="-1" name=""   text="目送稻庭学长的背影后，朽木教授抓住机会凑了过来。" voices=""/><msg @l="840" char_id="-1" frame_id="-1" name=""   text="那种过分亲昵的态度，现在让我感到异常恶心。" voices=""/><char @l="843" id="miho" pos="left" src="miho115"/><msg @l="845" char_id="0" frame_id="-1" name="美帆"   text="『考、考虑什么……我只是在做理所当然的事情。』" voices=""/><msg @l="847" char_id="0" frame_id="-1" name="美帆"   text="『……为了今后不再有像我这样遭遇的孩子。』" voices=""/><clear @l="851" layer="miho"/><msg @l="853" char_id="-1" frame_id="-1" name=""   text="说完，我转身背对朽木教授，朝校舍走去。" voices=""/><msg @l="854" char_id="-1" frame_id="-1" name=""   text="我感觉如果继续与他当面交谈下去，不知不觉中事情就会变得含糊不清。" voices=""/><clear @l="857" class="char"/><char @l="859" id="kutsu" pos="auto" src="kutsu014"/><msg @l="861" char_id="-1" frame_id="-1" name="朽木" text="『喂，仲根同学！』"   voices=""/><msg @l="863" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="865" char_id="-1" frame_id="-1" name=""   text="为了逃离从背后传来的教授的声音，我头也不回地快步向校舍走去。" voices=""/><eval @l="868" expr="f.訴えるflag&#32;+=&#32;1&#13;&#10;"/><goto @l="872" label="EventLabel_28"/><goto @l="874" label="TempLabel_178"/><label @l="878" id="TempLabel_177"/><goto @l="879" cond="(f.localflag)&#32;!=&#32;(1)&#13;&#10;"   label="TempLabel_179"/><msg @l="882" char_id="0" frame_id="-1" name="美帆" text="『……还是算了。』"   voices=""/><msg @l="884" char_id="0" frame_id="-1" name="美帆"   text="『我也没有确凿的证据……而且。』" voices=""/><msg @l="886" char_id="-1" frame_id="-1" name=""   text="如果起诉的话，那就相当于公开宣传我被猥亵了一样。" voices=""/><msg @l="887" char_id="-1" frame_id="-1" name=""   text="如果变成那样的话，我会因为羞耻而无法出门。" voices=""/><msg @l="889" char_id="-1" frame_id="-1" name="稻庭" text="『而且？』" voices=""/><msg @l="891" char_id="0" frame_id="-1" name="美帆" text="『不，不……没什么。』"   voices=""/><msg @l="893" char_id="0" frame_id="-1" name="美帆"   text="『总之，我不会起诉教授的。』" voices=""/><char @l="897" id="kutsu" pos="right" src="kutsu010"/><msg @l="899" char_id="-1" frame_id="-1" name="朽木"   text="『哦，我就知道仲根同学能理解我。』" voices=""/><msg @l="901" char_id="-1" frame_id="-1" name="" text="朽木教授这样说着握住了我的手。"   voices=""/><msg @l="902" char_id="-1" frame_id="-1" name=""   text="我……半是甩开似地把手抽了回来。" voices=""/><msg @l="904" char_id="0" frame_id="-1" name="美帆" text="『请不要误会！』"   voices=""/><msg @l="906" char_id="0" frame_id="-1" name="美帆"   text="『我……既没有相信教授也没有原谅教授。』" voices=""/><msg @l="908" char_id="0" frame_id="-1" name="美帆"   text="『只是，觉得不应该轻易做那种事……仅此而已。』" voices=""/><char @l="911" id="kutsu" pos="right" src="kutsu014"/><msg @l="913" char_id="-1" frame_id="-1" name="朽木"   text="『你、你在说什么啊……你也认为我是个痴汉吗……。』" voices=""/><msg @l="915" char_id="-1" frame_id="-1" name="稻庭"   text="『教授……她是说愿意把这次的事情当作没发生过，作为交换希望教授能够改过自新啊。』" voices=""/><msg @l="917" char_id="-1" frame_id="-1" name="稻庭" text="『您不明白吗？』"   voices=""/><msg @l="919" char_id="-1" frame_id="-1" name="朽木"   text="『什么改过自新，我本来就没犯什么罪……。』" voices=""/><char @l="922" id="inaba" pos="left" src="inaba017"/><msg @l="924" char_id="-1" frame_id="-1" name="稻庭" text="『教授！』" voices=""/><msg @l="926" char_id="-1" frame_id="-1" name=""   text="稻庭学长打断了教授的话，厉声喝道。" voices=""/><msg @l="927" char_id="-1" frame_id="-1" name="" text="这让教授和我都吃了一惊。"   voices=""/><char @l="930" id="inaba" pos="left" src="inaba010"/><msg @l="932" char_id="-1" frame_id="-1" name="稻庭"   text="『失去一种恶劣的爱好和毁掉自己的人生，您应该很清楚哪个才是更明智的选择吧？』"   voices=""/><msg @l="934" char_id="-1" frame_id="-1" name=""   text="稻庭说这话时脸上虽然挂着平和的笑容，但却带有一种深不可测的威压。" voices=""/><char @l="937" id="kutsu" pos="right" src="kutsu014"/><msg @l="939" char_id="-1" frame_id="-1" name="朽木" text="『咕、呜呜……。』"   voices=""/><msg @l="941" char_id="-1" frame_id="-1" name="稻庭"   text="『明白了就赶紧离开比较好哦。』" voices=""/><msg @l="943" char_id="-1" frame_id="-1" name="稻庭" text="『趁她还没改变主意之前。』"   voices=""/><msg @l="945" char_id="-1" frame_id="-1" name="朽木" text="『可恶！』" voices=""/><char @l="950" id="miho" pos="right" src="miho015"/><msg @l="953" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="955" char_id="-1" frame_id="-1" name=""   text="我怀着复杂的心情，目送离去的教授的背影。" voices=""/><msg @l="956" char_id="-1" frame_id="-1" name=""   text="由于他曾是我半尊敬的教授……这打击确实不小。" voices=""/><msg @l="958" char_id="-1" frame_id="-1" name="稻庭" text="『那样处理真的好吗？』"   voices=""/><msg @l="960" char_id="0" frame_id="-1" name="美帆"   text="『那样就好了……说真的，我也没有勇气和行动力去起诉别人。』" voices=""/><msg @l="962" char_id="-1" frame_id="-1" name="稻庭"   text="『不必那么贬低自己。』" voices=""/><msg @l="964" char_id="-1" frame_id="-1" name="稻庭"   text="『你用你自己的方式惩罚了他……就是这样而已。』" voices=""/><msg @l="966" char_id="0" frame_id="-1" name="美帆" text="『……是。』" voices=""/><msg @l="968" char_id="-1" frame_id="-1" name="稻庭"   text="『希望这样你就不会再遭遇痴汉了。』" voices=""/><clear @l="972" layer="inaba"/><msg @l="974" char_id="-1" frame_id="-1" name=""   text="稻庭学长说完这话笑了笑，一边挥手一边朝校舍方向走去。" voices=""/><msg @l="976" char_id="0" frame_id="-1" name="美帆" text="『…………。』" voices=""/><char @l="979" id="miho" pos="auto" src="miho116"/><msg @l="981" char_id="0" frame_id="-1" name="美帆" text="(幸好学长来救我了……)"   voices=""/><msg @l="983" char_id="0" frame_id="-1" name="美帆"   text="(朽木教授是个痴汉这件事……虽然很震惊……但也挺高兴的)" voices=""/><char @l="986" id="miho" pos="auto" src="miho014"/><msg @l="988" char_id="0" frame_id="-1" name="美帆" text="(啊，不过……)" voices=""/><msg @l="990" char_id="0" frame_id="-1" name="美帆"   text="(稻庭学长是怎么知道我遭遇了痴汉的呢)" voices=""/><goto @l="993" label="EventLabel_28"/><goto @l="995" label="TempLabel_178"/><label @l="997" id="TempLabel_179"/><label @l="998" id="TempLabel_178"/><goto @l="1002" label="TempLabel_180"/><label @l="1003" id="TempLabel_172"/><goto @l="1004" cond="!(f.痴漢flag&#32;==&#32;0)&#13;&#10;"   label="TempLabel_181"/><description @l="1008" text="审判之时？"/><msg @l="1010" char_id="1" frame_id="-1" name="声音" text="『哎呀，应该这样做。』"   voices="rei00130"/><msg @l="1012" char_id="-1" frame_id="-1" name=""   text="伴随着熟悉的声音，一只女性的手臂伸了过来，随即用力拍开了那只已经侵入裙子里面的痴汉的手。" voices=""/><stopbgm @l="1016" fadeout="1000"/><msg @l="1018" char_id="-1" frame_id="-1" name="痴汉"   text="『你，你是谁……你干什么！』" voices=""/><msg @l="1020" char_id="1" frame_id="-1" name="声音"   text="『哎呀……倒是您在干什么呢，朽木教授？』" voices="rei00140"/><msg @l="1022" char_id="0" frame_id="-1" name="美帆" text="『诶……？』"   voices="miho01550"/><msg @l="1032" char_id="-1" frame_id="-1" name=""   text="突然听到了意料之外的名字，我慌忙转过身去。" voices=""/><msg @l="1033" char_id="-1" frame_id="-1" name="" text="在我身后有两个人。"   voices=""/><msg @l="1034" char_id="-1" frame_id="-1" name=""   text="一个是白石学姐，她正抓住痴汉的手并扭转着。" voices=""/><msg @l="1035" char_id="-1" frame_id="-1" name=""   text="而另一个……实施痴汉行为的男子，竟然是我专业研讨班的讲师朽木阳大教授。" voices=""/><msg @l="1037" char_id="0" frame_id="-1" name="美帆"   text="『为什么……朽木教授会……？』" voices="miho01560"/><msg @l="1039" char_id="-1" frame_id="-1" name="朽木"   text="『不，不是这样的……仲根同学，请不要误会。』" voices=""/><msg @l="1041" char_id="-1" frame_id="-1" name=""   text="当我转身与他四目相对时，朽木教授像是抓住救命稻草般凑近我，开始编织辩解的话语。" voices=""/><msg @l="1042" char_id="-1" frame_id="-1" name=""   text="我已经搞不清状况了，只能尽力避开教授的视线。" voices=""/><msg @l="1044" char_id="1" frame_id="-1" name="玲" text="『什么叫请不要误会啊。』"   voices="rei00150"/><msg @l="1046" char_id="1" frame_id="-1" name="玲"   text="『在现行犯被抓个正着的情况下还要辩解，真是难看至极！』" voices="rei00160"/><msg @l="1048" char_id="-1" frame_id="-1" name="朽木" text="『唔呃呃呃……』"   voices=""/><msg @l="1050" char_id="1" frame_id="-1" name="玲"   text="『总之，等下车后我会好好听听您的解释。』" voices="rei00170"/><msg @l="1052" char_id="1" frame_id="-1" name="玲" text="『教授……请做好心理准备哦。』"   voices="rei00180"/><msg @l="1054" char_id="-1" frame_id="-1" name=""   text="说这话时白石学姐脸上虽然浮现出一丝微笑，但她的眼睛却丝毫没有笑意。" voices=""/><stopse @l="1058" buf="3"/><clear @l="1064" class="all"/><msgshow @l="1066" show="true"/><wait_chgmv/><bg @l="1070" src="bg07"/><bgm @l="1074" src="bgm03" volume="1."/><msg @l="1076" char_id="-1" frame_id="-1" name=""   text="有轨电车到达了校园内的车站。" voices=""/><msg @l="1077" char_id="-1" frame_id="-1" name=""   text="在如潮水般涌出的学生人流中，白石学姐和被她持续扭着手臂的朽木教授一起滑出了车厢。"   voices=""/><msg @l="1078" char_id="-1" frame_id="-1" name=""   text="我也跟在两人身后的位置下了车。" voices=""/><msg @l="1079" char_id="-1" frame_id="-1" name=""   text="同车的学生们投来好奇的目光，各处不断有人在窃窃私语。" voices=""/><msg @l="1080" char_id="-1" frame_id="-1" name=""   text="我只能深深低着头，竭力躲避那些视线……只能拼命地熬过这一刻。" voices=""/><char @l="1084" id="kutsu" pos="right" src="kutsu014"/><msg @l="1086" char_id="-1" frame_id="-1" name="朽木"   text="『呃……差不多可以放开我了吧。』" voices=""/><msg @l="1088" char_id="-1" frame_id="-1" name=""   text="说完这话，朽木教授强行挣脱了被扭住的手。" voices=""/><char @l="1092" id="rei" pos="left" src="rei027"/><msg @l="1094" char_id="1" frame_id="-1" name="玲"   text="『哎呀，真是气势汹汹呢……教授。』" voices=""/><msg @l="1096" char_id="1" frame_id="-1" name="玲"   text="『如果您再表现得谦恭一点的话，或许还有被宽恕的可能呢。』" voices=""/><char @l="1099" id="kutsu" pos="right" src="kutsu014"/><msg @l="1101" char_id="-1" frame_id="-1" name="朽木" text="『什么宽恕，荒谬至极。』"   voices=""/><msg @l="1103" char_id="-1" frame_id="-1" name="朽木"   text="『在公众面前被扭住手臂，谁还能保持谦恭。』" voices=""/><msg @l="1105" char_id="1" frame_id="-1" name="玲"   text="『那么请问是谁在公众面前实施了猥亵行为呢？』" voices=""/><char @l="1108" id="kutsu" pos="right" src="kutsu018"/><msg @l="1110" char_id="-1" frame_id="-1" name="朽木" text="『哼……你们没有证据吧。』"   voices=""/><msg @l="1112" char_id="1" frame_id="-1" name="玲"   text="『有美帆这个受害者，还有我这个目击者，作为证据我认为已经足够了，不是吗？』" voices=""/><msg @l="1114" char_id="-1" frame_id="-1" name="朽木"   text="『目击证言也可能是虚假的，这点你们拿不出证据。就像你抓住我的手也可能是个误会。』"   voices=""/><char @l="1117" id="rei" pos="left" src="rei017"/><msg @l="1119" char_id="1" frame_id="-1" name="玲" text="『……。』" voices=""/><char @l="1122" id="kutsu" pos="right" src="kutsu010"/><msg @l="1124" char_id="-1" frame_id="-1" name="朽木"   text="『只要现场没有警察在场，就算你和仲根同学说了什么，我也不会被追究责任的。』" voices=""/><msg @l="1126" char_id="1" frame_id="-1" name="玲" text="『确实可能如此呢。』"   voices=""/><msg @l="1128" char_id="1" frame_id="-1" name="玲"   text="『不过，要审判教授的手段还有其他方式。』" voices=""/><char @l="1131" id="rei" pos="left" src="rei027"/><msg @l="1133" char_id="1" frame_id="-1" name="玲"   text="『比如……提出诉讼，这也是可能的吧。』" voices=""/><char @l="1136" id="kutsu" pos="right" src="kutsu014"/><msg @l="1138" char_id="-1" frame_id="-1" name="朽木"   text="『荒唐……仅仅因为猥亵就提出诉讼！』" voices=""/><char @l="1141" id="rei" pos="left" src="rei017"/><msg @l="1143" char_id="1" frame_id="-1" name="玲" text="『仅仅因为猥亵，是吗。』"   voices=""/><msg @l="1145" char_id="1" frame_id="-1" name="玲"   text="『正是因为有您这样的人，像她这样的受害者才会不断增加啊。』" voices=""/><char @l="1148" id="rei" pos="left" src="rei010"/><msg @l="1150" char_id="-1" frame_id="-1" name="" text="就这样学姐看着我。"   voices=""/><msg @l="1151" char_id="-1" frame_id="-1" name=""   text="那不是看朽木教授时的冷笑，而是带着温暖的眼神。" voices=""/><msg @l="1153" char_id="1" frame_id="-1" name="玲" text="『来吧，美帆……接下来就看你的了。』"   voices=""/><char @l="1157" id="miho" pos="right" src="miho015"/><msg @l="1159" char_id="0" frame_id="-1" name="美帆"   text="『啊……什么叫做看我了？』" voices=""/><msg @l="1161" char_id="1" frame_id="-1" name="玲"   text="『是否起诉他，这个决定就看你自己了。』" voices=""/><char @l="1165" id="miho" pos="right" src="miho115"/><msg @l="1167" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="1169" char_id="1" frame_id="-1" name="玲"   text="『幸运的是，我参加的社团里有人认识律师，如果有不懂的事情，随时可以咨询。』" voices=""/><msg @l="1171" char_id="1" frame_id="-1" name="玲" text="『怎么样……要起诉教授吗？』"   voices=""/><msg @l="1176" async="true" char_id="-1" frame_id="-1" name=""   text="起诉朽木教授……？" voices=""/><select @l="1177"><menu @l="1180" label="TempLabel_182" text="起诉"/><menu @l="1182" label="TempLabel_184" text="不起诉"/></select><goto @l="1186" label="TempLabel_183"/><label @l="1188" id="TempLabel_182"/><eval @l="1190" expr="f.localflag&#32;=&#32;0&#13;&#10;"/><goto @l="1191" label="TempLabel_183"/><label @l="1193" id="TempLabel_184"/><eval @l="1195" expr="f.localflag&#32;=&#32;1&#13;&#10;"/><goto @l="1196" label="TempLabel_183"/><label @l="1198" id="TempLabel_183"/><goto @l="1205" label="TempLabel_185"/><label @l="1209" id="TempLabel_185"/><goto @l="1210" cond="(f.localflag)&#32;!=&#32;(0)&#13;&#10;"   label="TempLabel_186"/><msg @l="1213" char_id="0" frame_id="-1" name="美帆"   text="『那个……我，想要提起诉讼。』" voices=""/><msg @l="1215" char_id="-1" frame_id="-1" name=""   text="我像是从喉咙深处挤出来似的，编织出这句话。" voices=""/><msg @l="1216" char_id="-1" frame_id="-1" name=""   text="我无法让自己经历过的恐惧和厌恶感就这样不了了之。" voices=""/><msg @l="1217" char_id="-1" frame_id="-1" name="" text="只是……这是发自内心的回答。"   voices=""/><char @l="1221" id="kutsu" pos="right" src="kutsu014"/><msg @l="1223" char_id="-1" frame_id="-1" name="朽木"   text="『愚蠢，起诉需要大量的时间和金钱。』" voices=""/><msg @l="1225" char_id="-1" frame_id="-1" name="朽木"   text="『你一个学生，真以为这是随随便便就能做到的事吗？』" voices=""/><char @l="1228" id="miho" pos="left" src="miho015"/><msg @l="1230" char_id="0" frame_id="-1" name="美帆"   text="『这个……也许是这样没错……。』" voices=""/><char @l="1233" id="miho" pos="left" src="miho115"/><msg @l="1235" char_id="0" frame_id="-1" name="美帆"   text="『但是，如果我的起诉能让遭遇类似经历的人减少哪怕一点，我认为这也不是徒劳的……。』"   voices=""/><char @l="1238" id="kutsu" pos="right" src="kutsu018"/><msg @l="1240" char_id="-1" frame_id="-1" name="朽木" text="『……哼，真是伟大的伪善啊。』"   voices=""/><char @l="1244" id="miho" pos="left" src="miho014"/><msg @l="1246" char_id="0" frame_id="-1" name="美帆"   text="『伪善什么的，怎么会……我……。』" voices=""/><char @l="1250" id="rei" pos="left" src="rei010"/><msg @l="1252" char_id="1" frame_id="-1" name="玲"   text="『美帆……没关系，你说的是对的。』" voices=""/><msg @l="1254" char_id="1" frame_id="-1" name="玲"   text="『明天社团有个会议，到时候我会和认识律师的那位谈谈，请他帮忙引荐一下。』"   voices=""/><msg @l="1256" char_id="-1" frame_id="-1" name=""   text="就这样，白石学姐轻轻搂住了我的肩膀。" voices=""/><msg @l="1257" char_id="-1" frame_id="-1" name=""   text="我…拼命忍住快要流出的眼泪。" voices=""/><char @l="1261" id="rei" pos="left" src="rei017"/><msg @l="1263" char_id="1" frame_id="-1" name="玲"   text="『那么…朽木教授，我想这件事迟早会被大学方面知道的。』" voices=""/><msg @l="1265" char_id="1" frame_id="-1" name="玲"   text="『比起现在挖苦别人，您还是先考虑一下今后该如何自处比较好吧？』" voices=""/><msg @l="1267" char_id="-1" frame_id="-1" name="朽木" text="『啧…』" voices=""/><clear @l="1271" layer="rei"/><char @l="1273" id="rei" pos="right" src="rei017"/><char @l="1275" id="miho" pos="left" src="miho115"/><msg @l="1278" char_id="-1" frame_id="-1" name=""   text="仿佛被白石学姐的话击败一般，朽木教授转身快步离开，朝校舍方向走去。" voices=""/><char @l="1282" id="rei" pos="right" src="rei020"/><msg @l="1284" char_id="1" frame_id="-1" name="玲"   text="『呼…真是的，真有个麻烦的教授啊。』" voices=""/><char @l="1288" id="miho" pos="left" src="miho115"/><msg @l="1290" char_id="0" frame_id="-1" name="美帆"   text="『学姐…那个，对不起…』" voices=""/><msg @l="1292" char_id="1" frame_id="-1" name="玲" text="『你根本没必要道歉。』"   voices=""/><msg @l="1294" char_id="1" frame_id="-1" name="玲"   text="『相反，应该道歉的是我才对。』" voices=""/><char @l="1297" id="miho" pos="left" src="miho014"/><msg @l="1299" char_id="0" frame_id="-1" name="美帆" text="『诶……为什么呢？』"   voices=""/><msg @l="1301" char_id="1" frame_id="-1" name="玲"   text="『你遭遇痴汉，今天不是第一次吧？』" voices=""/><char @l="1304" id="miho" pos="left" src="miho015"/><msg @l="1306" char_id="0" frame_id="-1" name="美帆" text="『……是的。』" voices=""/><char @l="1310" id="rei" pos="right" src="rei125"/><msg @l="1312" char_id="1" frame_id="-1" name="玲"   text="『对不起，我没有察觉到。』" voices=""/><msg @l="1314" char_id="1" frame_id="-1" name="玲"   text="『我真是个失职的室友和学姐。』" voices=""/><char @l="1318" id="miho" pos="left" src="miho114"/><msg @l="1320" char_id="0" frame_id="-1" name="美帆"   text="『不会的……是我不好，没能说出口。』" voices=""/><char @l="1324" id="miho" pos="left" src="miho116"/><msg @l="1326" char_id="0" frame_id="-1" name="美帆"   text="『因为这个反而给学姐添了那么多麻烦……。』" voices=""/><char @l="1330" id="rei" pos="right" src="rei020"/><msg @l="1332" char_id="1" frame_id="-1" name="玲"   text="『我根本没觉得麻烦，你放心吧。』" voices=""/><char @l="1335" id="rei" pos="right" src="rei021"/><msg @l="1337" char_id="1" frame_id="-1" name="玲"   text="『我喜欢你这一点。』" voices=""/><char @l="1341" id="miho" pos="left" src="miho113"/><msg @l="1343" char_id="0" frame_id="-1" name="美帆" text="『学姐……。』" voices=""/><char @l="1346" id="rei" pos="right" src="rei120"/><msg @l="1348" char_id="1" frame_id="-1" name="玲"   text="『但是，不要什么都一个人扛着哦？』" voices=""/><msg @l="1350" char_id="1" frame_id="-1" name="玲"   text="『等到崩溃了之后，就来不及了。』" voices=""/><char @l="1353" id="miho" pos="left" src="miho111"/><msg @l="1355" char_id="0" frame_id="-1" name="美帆" text="『嗯，谢谢您。』"   voices=""/><eval @l="1358" expr="f.訴えるflag&#32;+=&#32;1&#13;&#10;"/><stopbgm @l="1362" fadeout="1000"/><goto @l="1365" label="EventLabel_28"/><goto @l="1367" label="TempLabel_187"/><label @l="1371" id="TempLabel_186"/><goto @l="1372" cond="(f.localflag)&#32;!=&#32;(1)&#13;&#10;"   label="TempLabel_188"/><msg @l="1375" char_id="0" frame_id="-1" name="美帆"   text="『……那个，我不会再那样了……。』" voices=""/><msg @l="1377" char_id="-1" frame_id="-1" name=""   text="我思考了一会儿后，鼓起勇气说出了那句话。" voices=""/><msg @l="1378" char_id="-1" frame_id="-1" name=""   text="指控犯罪的人……这或许是个简单的图式。" voices=""/><msg @l="1379" char_id="-1" frame_id="-1" name=""   text="但是，假如我起诉朽木教授会怎样呢？" voices=""/><msg @l="1380" char_id="-1" frame_id="-1" name=""   text="他可能……会背负一生都无法消除的“社会伤痕”。" voices=""/><msg @l="1381" char_id="-1" frame_id="-1" name=""   text="虽然可以说这是犯罪者应得的正当代价……但这样做恐怕也无法抹去我所遭受的厌恶感。"   voices=""/><msg @l="1382" char_id="-1" frame_id="-1" name=""   text="这种报复行为又有什么意义呢……。" voices=""/><msg @l="1383" char_id="-1" frame_id="-1" name=""   text="以因果报应之名行使正义什么的，我……。" voices=""/><msg @l="1385" char_id="0" frame_id="-1" name="美帆"   text="『我认为这不是能轻易做出的决定，如果朽木教授能够保证今后不再做这种事……那我就满足了。』"   voices=""/><char @l="1389" id="kutsu" pos="right" src="kutsu010"/><msg @l="1391" char_id="-1" frame_id="-1" name="朽木" text="『真、真的吗？』"   voices=""/><msg @l="1393" char_id="-1" frame_id="-1" name="朽木" text="『你真的不会起诉……是吗？』"   voices=""/><msg @l="1395" char_id="0" frame_id="-1" name="美帆"   text="『是的……只要教授认罪，并且保证不会再犯。』" voices=""/><msg @l="1397" char_id="-1" frame_id="-1" name="朽木"   text="『哈、哈哈……我明白了。』" voices=""/><msg @l="1399" char_id="-1" frame_id="-1" name="朽木"   text="『放心吧，我保证不会再做这种事了。』" voices=""/><char @l="1403" id="rei" pos="left" src="rei027"/><msg @l="1405" char_id="1" frame_id="-1" name="玲"   text="『……哎呀，态度和刚才完全不同了呢。』" voices=""/><char @l="1408" id="kutsu" pos="right" src="kutsu014"/><msg @l="1410" char_id="-1" frame_id="-1" name="朽木"   text="『吵、吵死了……总之我会保证，这样可以了吧？』" voices=""/><char @l="1413" id="rei" pos="left" src="rei010"/><msg @l="1415" char_id="1" frame_id="-1" name="玲" text="『你真的认为这样就够了吗……？』"   voices=""/><char @l="1419" id="miho" pos="right" src="miho116"/><msg @l="1421" char_id="0" frame_id="-1" name="美帆" text="『是的……我对此很满意。』"   voices=""/><char @l="1424" id="rei" pos="left" src="rei120"/><msg @l="1426" char_id="1" frame_id="-1" name="玲" text="『这样啊……』" voices=""/><msg @l="1428" char_id="1" frame_id="-1" name="玲"   text="『既然你这么说，我也不会强求。』" voices=""/><char @l="1431" id="rei" pos="left" src="rei117"/><msg @l="1433" char_id="1" frame_id="-1" name="玲"   text="『只要教授能遵守承诺就好，对吧。』" voices=""/><msg @l="1435" char_id="-1" frame_id="-1" name=""   text="说着，学姐投向朽木教授的目光犀利如箭，仿佛要将他刺穿。" voices=""/><char @l="1439" id="kutsu" pos="right" src="kutsu014"/><msg @l="1441" char_id="-1" frame_id="-1" name="朽木"   text="『那、那么……我还有讲义要准备，先告辞了。』" voices=""/><char @l="1445" id="miho" pos="right" src="miho116"/><msg @l="1447" char_id="-1" frame_id="-1" name=""   text="朽木教授像是要躲避白石学姐的目光，匆忙离开了现场。" voices=""/><msg @l="1448" char_id="-1" frame_id="-1" name=""   text="注视着他背影的学姐表情有些不甘心，甚至可以说是带着几分厌恶。" voices=""/><char @l="1451" id="rei" pos="left" src="rei010"/><msg @l="1453" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><char @l="1456" id="miho" pos="right" src="miho115"/><msg @l="1458" char_id="0" frame_id="-1" name="美帆" text="『对不起……。』"   voices=""/><msg @l="1460" char_id="1" frame_id="-1" name="玲" text="『你没必要道歉吧？』"   voices=""/><msg @l="1462" char_id="0" frame_id="-1" name="美帆" text="『也许……是这样。』"   voices=""/><msg @l="1464" char_id="-1" frame_id="-1" name=""   text="不管怎样，我确实辜负了学姐的好意。" voices=""/><msg @l="1465" char_id="-1" frame_id="-1" name=""   text="想到这里……我开始怀疑自己的判断是否正确。" voices=""/><msg @l="1467" char_id="1" frame_id="-1" name="玲" text="『……。』" voices=""/><char @l="1470" id="rei" pos="left" src="rei125"/><msg @l="1472" char_id="1" frame_id="-1" name="玲"   text="『我能理解你的心情。我也不是想看到他被惩罚而感到高兴。』" voices=""/><char @l="1475" id="rei" pos="left" src="rei015"/><msg @l="1477" char_id="1" frame_id="-1" name="玲"   text="『但是……我只希望你明白，这世上有很多人，除非亲身体会到罪行的后果，否则他们会一直重复同样的错误。』"   voices=""/><char @l="1480" id="miho" pos="right" src="miho115"/><msg @l="1482" char_id="0" frame_id="-1" name="美帆" text="『是的……。』" voices=""/><char @l="1485" id="rei" pos="left" src="rei128"/><msg @l="1487" char_id="1" frame_id="-1" name="玲" text="『人啊，真是复杂呢。』"   voices=""/><msg @l="1489" char_id="-1" frame_id="-1" name=""   text="学姐说着，略带寂寞地笑了笑。" voices=""/><stopbgm @l="1493" fadeout="1000"/><goto @l="1496" label="EventLabel_28"/><goto @l="1498" label="TempLabel_187"/><label @l="1500" id="TempLabel_188"/><label @l="1501" id="TempLabel_187"/><label @l="1504" id="TempLabel_181"/><label @l="1505" id="TempLabel_180"/><goto @l="1510" label="TempLabel_189"/><label @l="1511" id="TempLabel_171"/><msg @l="1515" char_id="-1" frame_id="-1" name=""   text="手指在裙子边缘蠕动，色狼的手伸进了我的裙子里。" voices=""/><msg @l="1517" char_id="0" frame_id="-1" name="美帆" text="『啊……。』"   voices="miho01570"/><msg @l="1519" char_id="-1" frame_id="-1" name=""   text="我慌忙想用手按住裙子，但已经来不及了。" voices=""/><msg @l="1520" char_id="-1" frame_id="-1" name=""   text="色狼的手隔着内裤抚摸着我的臀部，肆意揉捏着。" voices=""/><msg @l="1522" char_id="0" frame_id="-1" name="美帆"   text="『……不……请住手………。』" voices="miho01580"/><msg @l="1524" char_id="-1" frame_id="-1" name="痴汉"   text="『呵呵，不要说违心的话哦。』" voices=""/><msg @l="1526" char_id="0" frame_id="-1" name="美帆"   text="『不是那样的……我真的很讨厌这样。』" voices="miho01590"/><msg @l="1528" char_id="-1" frame_id="-1" name="痴汉"   text="『那么，你可以大声呼喊或者拼命反抗啊。』" voices=""/><msg @l="1530" char_id="-1" frame_id="-1" name="痴汉"   text="『周围有这么多人，说不定会有人注意到并来帮你呢？』" voices=""/><msg @l="1532" char_id="0" frame_id="-1" name="美帆" text="『……那个……是……。』"   voices="miho01600"/><msg @l="1534" char_id="-1" frame_id="-1" name=""   text="是的……如果真的想摆脱色狼的手，完全可以不顾羞耻和体面大声呼喊。" voices=""/><msg @l="1535" char_id="-1" frame_id="-1" name="" text="但我做不到。"   voices=""/><msg @l="1536" char_id="-1" frame_id="-1" name=""   text="比起被色狼玩弄身体，我更害怕周围陌生乘客知道“我被人猥亵了”这个事实，那种恐惧要强烈数倍……。"   voices=""/><msg @l="1538" char_id="-1" frame_id="-1" name="痴汉" text="『呵呵……。』"   voices=""/><msg @l="1540" char_id="-1" frame_id="-1" name=""   text="看着我无法回答的样子，色狼低声笑了起来。" voices=""/><msg @l="1541" char_id="-1" frame_id="-1" name="" text="滑溜。" voices=""/><msg @l="1542" char_id="-1" frame_id="-1" name=""   text="原本隔着内裤揉捏臀部的手指，现在钻进了我洁白的大腿之间。" voices=""/><msg @l="1543" char_id="-1" frame_id="-1" name="" text="他的手指如爬行般沿着大腿悄悄上移。"   voices=""/><msg @l="1544" char_id="-1" frame_id="-1" name=""   text="色狼的手就像尺蠖虫在爬行一样，不断蠕动。" voices=""/><msg @l="1546" char_id="0" frame_id="-1" name="美帆" text="『……唔……。』"   voices="miho01490"/><msg @l="1548" char_id="-1" frame_id="-1" name=""   text="不知是因为羞耻而冒出的汗水，还是沉醉于这种刺激的色狼的汗水——" voices=""/><msg @l="1549" char_id="-1" frame_id="-1" name=""   text="那种黏腻的触感无论如何忍耐，我的声音都快要不自觉地漏出来。" voices=""/><msg @l="1550" char_id="-1" frame_id="-1" name=""   text="然后，他的指尖终于到达了内裤的底部。" voices=""/><msg @l="1552" char_id="0" frame_id="-1" name="美帆" text="『……啊……。』"   voices="miho00680"/><msg @l="1554" char_id="-1" frame_id="-1" name=""   text="裙子被掀起，从倾斜的裙摆下面，我的白色内裤肯定完全暴露在外。" voices=""/><msg @l="1555" char_id="-1" frame_id="-1" name=""   text="想象着自己那羞耻的模样，我从脸颊到耳朵都变得通红。" voices=""/><wait_chgmv/><ev @l="1558" src="ev-005ax3y2"/><msg @l="1560" char_id="-1" frame_id="-1" name=""   text="似乎是在享受我这副样子，色狼的手指直接摩擦起内裤的底部。" voices=""/><msg @l="1562" char_id="0" frame_id="-1" name="美帆" text="『嘶！』"   voices="miho01610"/><msg @l="1564" char_id="-1" frame_id="-1" name=""   text="这突如其来的举动，让我不由得发出了声音。" voices=""/><msg @l="1565" char_id="-1" frame_id="-1" name=""   text="就在附近的学生投来了疑惑的目光。" voices=""/><msg @l="1566" char_id="-1" frame_id="-1" name=""   text="我尽力压抑住声音，低着头试图避开周围的视线，但恐怕已经有几个人注意到我正在被色狼骚扰。"   voices=""/><msg @l="1568" char_id="-1" frame_id="-1" name="痴汉"   text="『来吧，现在是机会，要不要试着求救看看？』" voices=""/><msg @l="1570" char_id="-1" frame_id="-1" name=""   text="色狼愉快地笑着说道，不顾我的感受，隔着内裤拨开我私处的柔软肉瓣，将手指挤压进去。" voices=""/><msg @l="1572" char_id="0" frame_id="-1" name="美帆" text="『呃……。』"   voices="miho00400"/><msg @l="1574" char_id="-1" frame_id="-1" name=""   text="这种羞辱让我眼皮内侧感受到一阵刺痛，像是有电流窜过的难受感觉。" voices=""/><msg @l="1576" char_id="0" frame_id="-1" name="美帆" text="『……唔……。』"   voices="miho01620"/><msg @l="1578" char_id="-1" frame_id="-1" name="痴汉"   text="『很好，今天就来试试你能忍受几根手指进入吧。』" voices=""/><msg @l="1580" char_id="-1" frame_id="-1" name=""   text="色狼看着这样的我，满意地笑着，隔着内裤插入的手指拨开我的女性花瓣，一边向更深处抚摸一边挤压进来。"   voices=""/><msg @l="1582" char_id="0" frame_id="-1" name="美帆" text="『……呃啊……。』"   voices="miho00430"/><msg @l="1584" char_id="-1" frame_id="-1" name=""   text="我紧绷臀部，试图收紧臀缝，但这对阻挡入侵者根本没有任何作用。" voices=""/><msg @l="1586" char_id="-1" frame_id="-1" name="痴汉" text="『好了……先试试两根。』"   voices=""/><msg @l="1588" char_id="-1" frame_id="-1" name=""   text="在我的私处，两个指尖，食指和中指正在蠕动。" voices=""/><msg @l="1590" char_id="-1" frame_id="-1" name="" text="咕叽。" voices=""/><msg @l="1592" char_id="0" frame_id="-1" name="美帆" text="『呃！』"   voices="miho00750"/><msg @l="1594" char_id="-1" frame_id="-1" name=""   text="轻易地侵入了还是处女状态的紧绷双唇。" voices=""/><msg @l="1595" char_id="-1" frame_id="-1" name=""   text="因为隔着内裤，手指甚至没有插入第一个关节，但我那还未经历过男人的秘门已经感到一阵尖锐的疼痛。" voices=""/><msg @l="1597" char_id="0" frame_id="-1" name="美帆" text="『……！？』"   voices="miho09970"/><msg @l="1599" char_id="-1" frame_id="-1" name=""   text="然而色狼对我的感受毫不关心，用两根手指挑弄着我的缝隙。" voices=""/><msg @l="1600" char_id="-1" frame_id="-1" name="" text="咕啾。" voices=""/><msg @l="1601" char_id="-1" frame_id="-1" name=""   text="此时此刻，我感到有什么东西从秘处深处渗出，让我的脊背不禁颤栗起来。" voices=""/><msg @l="1602" char_id="-1" frame_id="-1" name=""   text="色狼牢牢按住我颤抖的腰部，已经隔着内裤插入的两根手指撑开私处的嫩肉，又插入了第三根手指——无名指。"   voices=""/><msg @l="1603" char_id="-1" frame_id="-1" name="" text="咕啾，咕啾。"   voices=""/><msg @l="1605" char_id="0" frame_id="-1" name="美帆" text="『……呀……啊啊……。』"   voices="miho01630"/><msg @l="1607" char_id="-1" frame_id="-1" name="痴汉"   text="『第三根……你还要继续撒谎吗？』" voices=""/><msg @l="1609" char_id="0" frame_id="-1" name="美帆" text="『谎言……什么的……。』"   voices="miho01640"/><msg @l="1611" char_id="-1" frame_id="-1" name="痴汉"   text="『那么，为什么你不寻求帮助呢？连续三天被性骚扰却不反抗，不觉得奇怪吗？』" voices=""/><msg @l="1613" char_id="0" frame_id="-1" name="美帆" text="『呃……那是……。』"   voices="miho01650"/><msg @l="1615" char_id="-1" frame_id="-1" name="痴汉"   text="『只要呼救，马上就能得到帮助。但你却不愿依靠这个方法。』" voices=""/><msg @l="1617" char_id="-1" frame_id="-1" name="痴汉"   text="『也就是说，你已经接受了这种状况。』" voices=""/><msg @l="1619" char_id="-1" frame_id="-1" name="痴汉"   text="『不……或许说你很享受这种状况更为准确吧？』" voices=""/><msg @l="1621" char_id="0" frame_id="-1" name="美帆" text="『那种事……。』"   voices="miho01660"/><msg @l="1623" char_id="-1" frame_id="-1" name="痴汉"   text="『呵呵，你能这样否认也只是时间问题罢了。』" voices=""/><msg @l="1625" char_id="-1" frame_id="-1" name=""   text="痴汉的手指伸向了裂缝上方的突起。" voices=""/><msg @l="1626" char_id="-1" frame_id="-1" name=""   text="指尖缠绕着已经开始略微变硬的突起，粗暴地弹拨着。" voices=""/><msg @l="1627" char_id="-1" frame_id="-1" name="" text="啪。" voices=""/><msg @l="1629" char_id="0" frame_id="-1" name="美帆" text="『嗯啊！！』"   voices="miho01670"/><msg @l="1631" char_id="-1" frame_id="-1" name=""   text="像小梅一样敏感的突起仍包裹在皮下，却像是生气般鼓起一个小包，挺立着。" voices=""/><msg @l="1633" char_id="0" frame_id="-1" name="美帆" text="『那里……不行……。』"   voices="miho01680"/><msg @l="1635" char_id="-1" frame_id="-1" name="痴汉"   text="『哪里不行……如果不清楚地说出来，我可不明白啊。』" voices=""/><msg @l="1637" char_id="0" frame_id="-1" name="美帆"   text="『清楚地说……就是你现在正在触摸的地方……。』" voices="miho01690"/><msg @l="1639" char_id="-1" frame_id="-1" name="痴汉" text="『这里怎么了呢？』"   voices=""/><msg @l="1641" char_id="-1" frame_id="-1" name="" text="咕噜、咕噜、咕噜。"   voices=""/><msg @l="1642" char_id="-1" frame_id="-1" name=""   text="被指腹玩弄着的红色花蕾突然被捏住。" voices=""/><msg @l="1644" char_id="0" frame_id="-1" name="美帆" text="『不行，住手……嗯啊！！』"   voices="miho01700"/><msg @l="1646" char_id="-1" frame_id="-1" name=""   text="每当那纤细如按钮般的突起被指尖来回搓弄，电流般的开关就被打开，腰部瘫软，几乎要瘫坐在电车地板上。"   voices=""/><msg @l="1647" char_id="-1" frame_id="-1" name=""   text="即使拼命闭紧嘴巴，声音还是不由自主地漏了出来。" voices=""/><msg @l="1649" char_id="-1" frame_id="-1" name="痴汉"   text="『嘴上说着要停下，但你的声音却变得尖细了呢？』" voices=""/><msg @l="1651" char_id="0" frame_id="-1" name="美帆" text="『怎么会……啊啊！』"   voices="miho01710"/><msg @l="1653" char_id="-1" frame_id="-1" name=""   text="每当痴汉的手指转动那个小小的开关，腰就像通过电流一样颤抖起来。" voices=""/><msg @l="1654" char_id="-1" frame_id="-1" name=""   text="明显与厌恶感不同的“某种感觉”……正在膨胀。" voices=""/><msg @l="1655" char_id="-1" frame_id="-1" name="" text="身体……发热了。" voices=""/><msg @l="1657" char_id="0" frame_id="-1" name="美帆" text="(啊……不行……要溢出来了)"   voices="miho01720"/><msg @l="1659" char_id="-1" frame_id="-1" name="" text="咕叽。" voices=""/><msg @l="1660" char_id="-1" frame_id="-1" name="" text="从那里深处涌出炽热的液体。"   voices=""/><msg @l="1662" char_id="0" frame_id="-1" name="美帆" text="『不要……那里是……』"   voices="miho00410"/><msg @l="1664" char_id="-1" frame_id="-1" name=""   text="即使在头脑中不断地想着“讨厌”，却无法停止。" voices=""/><msg @l="1666" char_id="-1" frame_id="-1" name="痴汉"   text="『哦呀，这是汗水吗，还是爱液呢……你的内裤好像湿了哦？』" voices=""/><msg @l="1668" char_id="0" frame_id="-1" name="美帆"   text="『不要啊……请不要说出来……』" voices="miho01730"/><msg @l="1670" char_id="-1" frame_id="-1" name=""   text="内裤中弥漫着神圣蜜液的香气，溢出的蜜液像露水一样几乎要滴落下来。" voices=""/><msg @l="1672" char_id="-1" frame_id="-1" name="痴汉" text="『哈哈，这真不错。』"   voices=""/><msg @l="1674" char_id="-1" frame_id="-1" name="痴汉"   text="『被陌生痴汉玩弄私密部位就湿成这样，你真是个了不起的变态啊。』" voices=""/><msg @l="1676" char_id="0" frame_id="-1" name="美帆"   text="『呜呜……不是的，不是这样的……』" voices="miho01740"/><msg @l="1678" char_id="-1" frame_id="-1" name="痴汉"   text="『现在说什么都晚了。被痴汉骚扰就把内裤弄湿，这样的辩解没有说服力。』" voices=""/><msg @l="1680" char_id="-1" frame_id="-1" name="痴汉"   text="『在公众面前湿成这样，真是没救了。』" voices=""/><msg @l="1682" char_id="-1" frame_id="-1" name=""   text="痴汉用食指挑起内裤，将手指伸进了里面。" voices=""/><msg @l="1683" char_id="-1" frame_id="-1" name="" text="咕啾，咕啾。" voices=""/><msg @l="1685" char_id="0" frame_id="-1" name="美帆" text="『……呀……』"   voices="miho00740"/><msg @l="1687" char_id="-1" frame_id="-1" name=""   text="伸进内裤的手指触碰到我的那里……越来越多溢出的蜜液正热烈地滴落着。" voices=""/><msg @l="1688" char_id="-1" frame_id="-1" name=""   text="痴汉并不满足于仅仅将手指伸进内裤，他用两根手指直接按照自己的欲望揉弄搓摸着私密处的肉缝。" voices=""/><msg @l="1690" char_id="-1" frame_id="-1" name="痴汉"   text="『我本以为你只是有受虐的素质，没想到竟是如此淫乱。』" voices=""/><msg @l="1692" char_id="0" frame_id="-1" name="美帆"   text="『啊……说我淫乱什么的……………嗯啊！』" voices="miho01750"/><msg @l="1694" char_id="-1" frame_id="-1" name=""   text="就在我想要说出否认的话语的瞬间，痴汉伸进内裤里的手指掰开了阴唇，将手指第一关节插入了粘膜延展的肉径中。"   voices=""/><msg @l="1695" char_id="-1" frame_id="-1" name="" text="咕啾。" voices=""/><msg @l="1697" char_id="0" frame_id="-1" name="美帆" text="『嗯啊！』"   voices="miho00450"/><msg @l="1699" char_id="-1" frame_id="-1" name=""   text="仅仅因为被插入手指的触感，我就失去了言语能力……全身脱力。" voices=""/><msg @l="1701" char_id="-1" frame_id="-1" name="痴汉"   text="『我想此时的否认已经毫无意义了。』" voices=""/><msg @l="1703" char_id="-1" frame_id="-1" name=""   text="低声笑着，痴汉更进一步地在秘缝中移动手指，像是在品味蜜壁的触感般翻搅着。" voices=""/><msg @l="1704" char_id="-1" frame_id="-1" name="" text="咕啾，咕啾。"   voices=""/><msg @l="1706" char_id="0" frame_id="-1" name="美帆" text="『………啊……。』"   voices="miho00840"/><msg @l="1708" char_id="-1" frame_id="-1" name=""   text="随着这样的动作，一种既不是汗水又不同于其他液体的东西从私密孔洞中渗出。" voices=""/><msg @l="1709" char_id="-1" frame_id="-1" name=""   text="每次当未插入阴道的另一根手指尖恶意地弹拨玩弄着女性的敏感核心时，我的身体违背抗拒的内心，变得炽热而敏感。"   voices=""/><msg @l="1711" char_id="0" frame_id="-1" name="美帆" text="『嗯嗯～……。』"   voices="miho01760"/><msg @l="1713" char_id="-1" frame_id="-1" name="痴汉"   text="『怎么了？我的手指让你这么舒服吗？』" voices=""/><msg @l="1715" char_id="-1" frame_id="-1" name=""   text="那沿着花瓣内侧滑动的手指，像是要将所有蜜液搅拌在一起般尽情玩弄着。" voices=""/><msg @l="1717" char_id="0" frame_id="-1" name="美帆" text="『不，不是……啊啊！』"   voices="miho01770"/><msg @l="1719" char_id="-1" frame_id="-1" name="" text="咕啾～。" voices=""/><msg @l="1720" char_id="-1" frame_id="-1" name=""   text="突然，原本只插入第一关节的手指猛地插到了第二关节。" voices=""/><msg @l="1722" char_id="0" frame_id="-1" name="美帆" text="『……啊……。』"   voices="miho00430"/><msg @l="1724" char_id="-1" frame_id="-1" name=""   text="那一瞬间，一种既像疼痛又像麻痹的“某种感觉”在下腹部阵阵扩散开来。" voices=""/><msg @l="1725" char_id="0" frame_id="-1" name="美帆"   text="(这样的事……不行………什么也……思考不了了……)" voices="miho01780"/><msg @l="1726" char_id="-1" frame_id="-1" name="痴汉"   text="『很舒服吧，我的手指被你的蜜液弄得湿漉漉的。』" voices=""/><msg @l="1728" char_id="-1" frame_id="-1" name="" text="咕啾、咕啾、咕啾。"   voices=""/><msg @l="1729" char_id="-1" frame_id="-1" name=""   text="痴汉一边这样说着，一边用插入到第二关节的手指在秘门内搅动，用指腹沿着蜜壁滑动着。" voices=""/><msg @l="1730" char_id="-1" frame_id="-1" name=""   text="这时，粘稠的花液仿佛要缠绕在插入的手指上般溢了出来。" voices=""/><msg @l="1731" char_id="0" frame_id="-1" name="美帆" text="『嗯呜……嗯……。』"   voices="miho05110"/><msg @l="1733" char_id="-1" frame_id="-1" name="痴汉"   text="『这才是你的本性啊。你其实是个被陌生痴汉玩弄就会让下面湿得一塌糊涂的淫乱女人。』" voices=""/><msg @l="1735" char_id="0" frame_id="-1" name="美帆"   text="『哈啊，哈啊……嗯嗯……嗯啊啊……。』" voices="miho01790"/><msg @l="1737" char_id="-1" frame_id="-1" name=""   text="我的身体已经热到连否定的话都无法说出口，什么都思考不了了。" voices=""/><msg @l="1739" char_id="0" frame_id="-1" name="美帆" text="『嗯，嗯嗯……嗯啊啊。』"   voices="miho10940"/><msg @l="1741" char_id="-1" frame_id="-1" name=""   text="干渴的喉咙发出咕咚一声，然后呼出一口气。" voices=""/><msg @l="1742" char_id="-1" frame_id="-1" name=""   text="只是任凭下腹部的麻痹感……反复地急促喘息着。" voices=""/><msg @l="1743" char_id="-1" frame_id="-1" name=""   text="对于现在完全不再抵抗的我，痴汉随心所欲地进行着凌辱。" voices=""/><msg @l="1745" char_id="-1" frame_id="-1" name="痴汉"   text="『来吧，就这样登上顶峰吧。』" voices=""/><msg @l="1747" char_id="-1" frame_id="-1" name="痴汉"   text="『在被众多人包围的车厢里淫荡地高潮，对于淫乱的你来说再合适不过了。』" voices=""/><msg @l="1749" char_id="-1" frame_id="-1" name=""   text="就这样，当痴汉的指尖用力拧动那小小的核心，用指腹抚摸着粘液都能拉出丝的湿润蜜壁的顶部的瞬间———。"   voices=""/><msg @l="1750" char_id="-1" frame_id="-1" name="" text="有什么在我体内爆发了。"   voices=""/><msg @l="1752" char_id="0" frame_id="-1" name="美帆" text="『嗯嗯啊啊啊啊！！』"   voices="miho01800"/><flash @l="1755" count="4" fade="100" image="white"/><msg @l="1757" char_id="-1" frame_id="-1" name=""   text="子宫附近变得滚烫，眼前一片雪白。" voices=""/><msg @l="1758" char_id="-1" frame_id="-1" name=""   text="腰部不由自主地向上弹起，一种类似疼痛的尖锐感觉沿着脊柱蔓延，大量的蜜液从那里止不住地溢出。"   voices=""/><clear @l="1764" class="all"/><msg @l="1766" char_id="-1" frame_id="-1" name="痴汉" text="『呵呵，真是精彩的高潮啊。』"   voices=""/><msg @l="1768" char_id="-1" frame_id="-1" name="" text="痴汉在我耳边淫秽地笑着。"   voices=""/><msg @l="1770" char_id="-1" frame_id="-1" name="痴汉"   text="『今后，我会继续调教你，让你适应这个城市───。』" voices=""/><msg @l="1771" char_id="0" frame_id="-1" name="美帆" text="『……啊啊……。』"   voices="miho01810"/><msg @l="1773" char_id="-1" frame_id="-1" name="" text="站不住了……。"   voices=""/><msg @l="1774" char_id="-1" frame_id="-1" name=""   text="就在这么想的瞬间，我像是把身体交给了痴汉一样倒了下去，在远去的意识中，朦胧地听着痴汉的声音……。" voices=""/><msg @l="1775" char_id="-1" frame_id="-1" name=""   text="最后记得的是朽木教授扭曲的笑容……。" voices=""/><stopse @l="1779" buf="3"/><stopbgm @l="1783" fadeout="1000"/><clear @l="1789" class="all"/><end_scene @l="1792"/><msgshow @l="1795" show="true"/><call @l="1799" target="EventLabel_39@ending01"/><return @l="1800" value="0&#13;&#10;"/><label @l="1802" id="TempLabel_189"/><label @l="1808" id="EventLabel_28"/><clear @l="1815" class="all"/><msgshow @l="1817" show="true"/><goto @l="1820" cond="!(f.訴えるflag&#32;==&#32;1)&#13;&#10;"   label="TempLabel_190"/><se @l="1825" buf="1" src="チャイム" volume="1."/><wait_chgmv/><bg @l="1829" src="bg08m2"/><bgm @l="1833" src="bgm04" volume="1."/><msg @l="1835" char_id="-1" frame_id="-1" name=""   text="第二节课结束的铃声响起，站在讲台上的讲师离开后，安静的讲堂突然变得嘈杂起来。" voices=""/><msg @l="1836" char_id="-1" frame_id="-1" name=""   text="或许是因为接下来是午休时间，大家的表情都很明朗。" voices=""/><msg @l="1838" char_id="0" frame_id="-1" name="美帆" text="『……哈。』" voices=""/><msg @l="1840" char_id="-1" frame_id="-1" name=""   text="我为了听讲而将视线落在笔记本上，轻轻地叹了口气。" voices=""/><msg @l="1841" char_id="-1" frame_id="-1" name=""   text="打开的笔记本上几乎没有写任何字。" voices=""/><msg @l="1842" char_id="-1" frame_id="-1" name=""   text="只有一些既不像文字也不像图画的莫名其妙的涂鸦。" voices=""/><msg @l="1844" char_id="0" frame_id="-1" name="美帆" text="(完全……没法集中精神听讲座啊)"   voices=""/><msg @l="1846" char_id="-1" frame_id="-1" name=""   text="整个讲课时间，今早的那件事一直在我脑海中挥之不去。" voices=""/><msg @l="1847" char_id="-1" frame_id="-1" name=""   text="我一直尊敬的朽木教授居然是连日来的痴汉犯人，到现在我都无法相信。" voices=""/><msg @l="1849" char_id="0" frame_id="-1" name="美帆"   text="(但是，我还是决定起诉教授了……)" voices=""/><msg @l="1851" char_id="0" frame_id="-1" name="美帆" text="(真的……那样做好吗)"   voices=""/><msg @l="1853" char_id="-1" frame_id="-1" name=""   text="对自己做出的判断没有信心……这是我的坏习惯。" voices=""/><msg @l="1854" char_id="-1" frame_id="-1" name="" text="教授犯了罪，所以要为罪行负责。"   voices=""/><msg @l="1855" char_id="-1" frame_id="-1" name=""   text="朽木教授可能会遭受社会上的伤害，但如果通过我的起诉他能够悔罪反省，那他就不会再继续犯罪，也不会有下一个受害者出现。"   voices=""/><msg @l="1856" char_id="-1" frame_id="-1" name="" text="我认为我的判断没有错。"   voices=""/><msg @l="1857" char_id="-1" frame_id="-1" name=""   text="但是……总有一种难以言表的不安残留……" voices=""/><msg @l="1859" char_id="0" frame_id="-1" name="美帆"   text="(……或许……只是我太爱担心了……………)" voices=""/><msg @l="1861" char_id="-1" frame_id="-1" name="男孩" text="『喂……你是仲根吗？』"   voices=""/><char @l="1865" id="miho" pos="auto" src="miho014"/><msg @l="1867" char_id="0" frame_id="-1" name="美帆" text="『啊……是的，我是。』"   voices=""/><msg @l="1869" char_id="-1" frame_id="-1" name="男孩"   text="『教授在走廊那边找你呢。』" voices=""/><char @l="1872" id="miho" pos="auto" src="miho010"/><msg @l="1874" char_id="0" frame_id="-1" name="美帆"   text="『教授？ 啊，好的……谢谢你。』" voices=""/><clear @l="1878" class="char"/><msg @l="1880" char_id="-1" frame_id="-1" name=""   text="于是我对那个男孩点了点头，匆忙地把摊开的笔记塞进包里，走出了走廊。" voices=""/><stopbgm @l="1884" fadeout="1000"/><wait_chgmv/><bg @l="1888" src="bg09"/><bgm @l="1892" src="bgm02" volume="1."/><msg @l="1894" char_id="-1" frame_id="-1" name="学生A" text="『午饭怎么办～？』"   voices=""/><msg @l="1896" char_id="-1" frame_id="-1" name="学生B" text="『我准备去吃牛肉盖饭，你呢？』"   voices=""/><msg @l="1898" char_id="-1" frame_id="-1" name="学生C"   text="『这个时间，拐角处的便利店估计已经被扫空了吧。』" voices=""/><char @l="1902" id="miho" pos="auto" src="miho010"/><msg @l="1904" char_id="-1" frame_id="-1" name=""   text="由于上午的课程已经结束，走廊上一片嘈杂。" voices=""/><msg @l="1905" char_id="-1" frame_id="-1" name=""   text="在这样的环境中，我东张西望地四处张望，寻找“教授”的身影。" voices=""/><msg @l="1906" char_id="-1" frame_id="-1" name="" text="会是哪位教授呢？" voices=""/><msg @l="1907" char_id="-1" frame_id="-1" name=""   text="不久，我的目光发现了走廊墙边站着的一个西装背影。" voices=""/><msg @l="1909" char_id="0" frame_id="-1" name="美帆"   text="『那个……听说您找我？』" voices=""/><msg @l="1911" char_id="-1" frame_id="-1" name="教授" text="『啊。我一直在等你。』"   voices=""/><msg @l="1913" char_id="-1" frame_id="-1" name=""   text="看到那个转过身来的人的脸，我不由自主地发出了惊讶的声音。" voices=""/><clear @l="1916" class="char"/><char @l="1918" id="miho" pos="left" src="miho014"/><char @l="1921" id="kutsu" pos="right" src="kutsu010"/><bgm @l="1925" src="bgm03" volume="1."/><msg @l="1927" char_id="0" frame_id="-1" name="美帆" text="『朽木教授！』" voices=""/><msg @l="1929" char_id="-1" frame_id="-1" name="朽木"   text="『哎呀哎呀，请不要露出那么明显厌恶的表情啊。』" voices=""/><msg @l="1931" char_id="-1" frame_id="-1" name="朽木"   text="『我一直想和你好好谈一次。』" voices=""/><char @l="1935" id="miho" pos="left" src="miho115"/><msg @l="1937" char_id="0" frame_id="-1" name="美帆"   text="『我觉得……我们没什么好谈的。』" voices=""/><msg @l="1939" char_id="-1" frame_id="-1" name="朽木"   text="『请不要这么冷淡嘛。我也是在反省的啊？』" voices=""/><msg @l="1941" char_id="0" frame_id="-1" name="美帆"   text="『……所以您是想让我重新考虑起诉的事吗？』" voices=""/><msg @l="1943" char_id="-1" frame_id="-1" name="朽木"   text="『你的言辞真是尖锐啊。我只是说想和你谈谈而已哦？』" voices=""/><msg @l="1945" char_id="0" frame_id="-1" name="美帆"   text="『在这个时机想和我谈话，无论怎么想都只能理解为是这方面的内容。』" voices=""/><msg @l="1947" char_id="-1" frame_id="-1" name="朽木"   text="『真是败给你了，你这么固执的话就无法进行对话了。』" voices=""/><char @l="1950" id="miho" pos="left" src="miho015"/><msg @l="1952" char_id="0" frame_id="-1" name="美帆"   text="『我不认为这是能通过对话解决的问题。』" voices=""/><msg @l="1954" char_id="0" frame_id="-1" name="美帆"   text="『所以……我才决定起诉的。』" voices=""/><msg @l="1956" char_id="-1" frame_id="-1" name=""   text="我半是在自言自语地对自己说道。" voices=""/><msg @l="1958" char_id="-1" frame_id="-1" name="朽木"   text="『原来如此，看来我是被相当讨厌了啊……那么换个话题吧。』" voices=""/><char @l="1962" id="miho" pos="left" src="miho115"/><msg @l="1964" char_id="0" frame_id="-1" name="美帆" text="『……？』" voices=""/><msg @l="1966" char_id="-1" frame_id="-1" name="朽木"   text="『你的父亲……如果没记错的话叫仲根启三吧。其实，我听到了一些不太好的传闻。』" voices=""/><bgm @l="1969" src="bgm15" volume="1."/><char @l="1973" id="miho" pos="left" src="miho015"/><msg @l="1975" char_id="0" frame_id="-1" name="美帆"   text="『爸爸……父，父亲怎么了？您想说什么？』" voices=""/><msg @l="1977" char_id="-1" frame_id="-1" name="朽木"   text="『哦？不是说不想和我对话吗？』" voices=""/><msg @l="1979" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><char @l="1982" id="kutsu" pos="right" src="kutsu018"/><msg @l="1984" char_id="-1" frame_id="-1" name="朽木"   text="『你那不甘心的表情也很不错呢。』" voices=""/><msg @l="1986" char_id="0" frame_id="-1" name="美帆" text="『请不要说奇怪的话！』"   voices=""/><char @l="1989" id="kutsu" pos="right" src="kutsu010"/><msg @l="1991" char_id="-1" frame_id="-1" name="朽木" text="『哎呀……失礼了。』"   voices=""/><msg @l="1993" char_id="-1" frame_id="-1" name="朽木"   text="『怎么样，有点想听我说话了吗？』" voices=""/><char @l="1997" id="miho" pos="left" src="miho115"/><msg @l="1999" char_id="0" frame_id="-1" name="美帆" text="『……那、那个。』"   voices=""/><msg @l="2001" char_id="-1" frame_id="-1" name="朽木"   text="『嘛，即使是亲人，说到底也只是个父亲罢了。』" voices=""/><msg @l="2003" char_id="-1" frame_id="-1" name="朽木"   text="『对于正值年华的女儿来说，是无关紧要的存在，是这样吗？』" voices=""/><char @l="2006" id="miho" pos="left" src="miho015"/><msg @l="2008" char_id="0" frame_id="-1" name="美帆"   text="『怎么会……对我来说父亲是……无可替代的亲人。他很重要……。所以，请不要这样说……。』"   voices=""/><msg @l="2010" char_id="0" frame_id="-1" name="美帆"   text="『……我明白了，我会听您说的。』" voices=""/><char @l="2013" id="kutsu" pos="right" src="kutsu018"/><msg @l="2015" char_id="-1" frame_id="-1" name="朽木"   text="『很好，那就跟我来吧。』" voices=""/><clear @l="2019" class="char"/><char @l="2021" id="miho" pos="auto" src="miho115"/><msg @l="2023" char_id="-1" frame_id="-1" name=""   text="就这样，朽木教授带头快步走了起来。" voices=""/><msg @l="2024" char_id="-1" frame_id="-1" name=""   text="前进的方向是教授的研究室……目的地应该就是那里吧。" voices=""/><msg @l="2026" char_id="0" frame_id="-1" name="美帆" text="『………。』" voices=""/><msg @l="2028" char_id="0" frame_id="-1" name="美帆" text="(……爸爸……)"   voices=""/><clear @l="2032" class="char"/><msg @l="2034" char_id="-1" frame_id="-1" name=""   text="我跟随着走在前方的朽木教授的背影，恍惚回想着自南总町校区以来一直未曾见过的父亲的样子。"   voices=""/><clear @l="2040" class="all"/><msg @l="2042" char_id="-1" frame_id="-1" name="朽木" text="『请不必客气，进来吧。』"   voices=""/><msg @l="2044" char_id="0" frame_id="-1" name="美帆" text="『……好的。』" voices=""/><wait_chgmv/><bg @l="2048" src="bg12"/><description @l="2051" text="断罪的代价"/><msg @l="2053" char_id="-1" frame_id="-1" name=""   text="我被带进了朽木教授平时常驻的教授室。" voices=""/><msg @l="2054" char_id="-1" frame_id="-1" name=""   text="这是一间与教室风格截然不同的豪华装修房间。" voices=""/><char @l="2058" id="kutsu" pos="auto" src="kutsu010"/><msg @l="2060" char_id="-1" frame_id="-1" name="朽木"   text="『先坐下吧，要不要我泡杯咖啡？』" voices=""/><clear @l="2063" class="char"/><char @l="2065" id="kutsu" pos="right" src="kutsu010"/><char @l="2068" id="miho" pos="left" src="miho115"/><msg @l="2070" char_id="0" frame_id="-1" name="美帆" text="『不……不用麻烦了。』"   voices=""/><char @l="2073" id="miho" pos="left" src="miho015"/><msg @l="2075" char_id="0" frame_id="-1" name="美帆"   text="『比起这个，您说的父亲的不好的传闻是什么？』" voices=""/><msg @l="2077" char_id="-1" frame_id="-1" name="朽木"   text="『你还真是出乎意料地急性子啊……事情都是有顺序的。』" voices=""/><msg @l="2079" char_id="-1" frame_id="-1" name="朽木"   text="『在谈论你父亲之前，让我们先解决另一个问题吧。』" voices=""/><msg @l="2081" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="2083" char_id="0" frame_id="-1" name="美帆" text="『是关于……起诉的事吧？』"   voices=""/><char @l="2086" id="kutsu" pos="right" src="kutsu018"/><msg @l="2088" char_id="-1" frame_id="-1" name="朽木" text="『除此之外还有什么呢？』"   voices=""/><msg @l="2090" char_id="-1" frame_id="-1" name=""   text="朽木教授说这话时故作轻松，脸上浮现出令人不快的笑容。" voices=""/><msg @l="2091" char_id="-1" frame_id="-1" name=""   text="不……也许只是现在的我才会这样觉得。" voices=""/><char @l="2094" id="kutsu" pos="right" src="kutsu010"/><msg @l="2096" char_id="-1" frame_id="-1" name="朽木"   text="『我想你应该明白……起诉这种事情是相当麻烦的。』" voices=""/><msg @l="2098" char_id="-1" frame_id="-1" name="朽木"   text="『它需要大量时间和精力，而你所能获得的最大成果不过是证明我的罪行而已。』" voices=""/><msg @l="2100" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="2102" char_id="-1" frame_id="-1" name="朽木"   text="『我呢，并不希望你为了这种无聊的事情而浪费你宝贵的时间。』" voices=""/><msg @l="2104" char_id="-1" frame_id="-1" name="朽木"   text="『我已经在反省了。我保证不会再做痴汉行为了。』" voices=""/><msg @l="2106" char_id="0" frame_id="-1" name="美帆"   text="『你……认为我会相信这种话吗？』" voices=""/><msg @l="2108" char_id="-1" frame_id="-1" name="朽木" text="『如果你不相信的话，我会很困扰啊。』"   voices=""/><msg @l="2110" char_id="-1" frame_id="-1" name="朽木"   text="『否则，我就不得不采取一些额外措施了。』" voices=""/><msg @l="2112" char_id="0" frame_id="-1" name="美帆" text="『……这是什么意思？』"   voices=""/><msg @l="2114" char_id="-1" frame_id="-1" name="朽木"   text="『谁知道呢。比起这个，不如让我听听你的回答吧。』" voices=""/><msg @l="2116" char_id="0" frame_id="-1" name="美帆" text="『我……。』" voices=""/><char @l="2119" id="miho" pos="left" src="miho115"/><msg @l="2121" char_id="0" frame_id="-1" name="美帆"   text="『我不会改变主意的。』" voices=""/><msg @l="2123" char_id="-1" frame_id="-1" name="朽木" text="『哦？』" voices=""/><msg @l="2125" char_id="0" frame_id="-1" name="美帆"   text="『首先，我从教授的话里感觉不到任何诚意……。』" voices=""/><msg @l="2127" char_id="0" frame_id="-1" name="美帆"   text="『这种轻易许下的承诺……我无法相信。』" voices=""/><msg @l="2129" char_id="-1" frame_id="-1" name="朽木"   text="『原来如此。既然你这么固执，那也没办法了。』" voices=""/><msg @l="2131" char_id="-1" frame_id="-1" name="朽木"   text="『那么，暂且搁置这个话题，我们来谈谈你父亲的事吧。』" voices=""/><msg @l="2133" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="2135" char_id="-1" frame_id="-1" name="朽木"   text="『仲根同学，你知道你父亲工作的大黑制药公司向这所大学的药学部提出了研究委托的事吗？』" voices=""/><char @l="2138" id="miho" pos="left" src="miho114"/><msg @l="2140" char_id="0" frame_id="-1" name="美帆"   text="『啊，是这样吗……我不知道。』" voices=""/><msg @l="2142" char_id="-1" frame_id="-1" name="朽木"   text="『哦，那么你当然也不知道负责这项研究委托总括工作的正是你父亲了。』" voices=""/><char @l="2145" id="miho" pos="left" src="miho115"/><msg @l="2147" char_id="0" frame_id="-1" name="美帆" text="『……是的。』" voices=""/><msg @l="2149" char_id="-1" frame_id="-1" name="朽木"   text="『他工作的公司正处于经营困难的状态，据说不久后将进行大规模的裁员。』" voices=""/><bgm @l="2153" src="bgm09" volume="1."/><char @l="2157" id="miho" pos="left" src="miho114"/><msg @l="2159" char_id="0" frame_id="-1" name="美帆"   text="『裁员……也就是说，要进行企业重组吗？』" voices=""/><msg @l="2161" char_id="-1" frame_id="-1" name="朽木"   text="『嗯，坦白说就是这样吧。』" voices=""/><msg @l="2163" char_id="-1" frame_id="-1" name="朽木"   text="『据说裁员的对象主要是各研究设施的管理人员。』" voices=""/><char @l="2166" id="miho" pos="left" src="miho115"/><msg @l="2168" char_id="0" frame_id="-1" name="美帆" text="『怎么会……』"   voices=""/><msg @l="2170" char_id="0" frame_id="-1" name="美帆"   text="『那就是说父亲是裁员的候选人吗！？』" voices=""/><msg @l="2172" char_id="-1" frame_id="-1" name="朽木"   text="『不是候选人，是已经确定了。我是直接从人事部门的人那里听说的。』" voices=""/><msg @l="2174" char_id="-1" frame_id="-1" name="朽木"   text="『你父亲年纪也相当大了，如果这时候被裁员的话，再就业会很困难吧。』" voices=""/><msg @l="2176" char_id="-1" frame_id="-1" name="朽木"   text="『更何况是研究职位，恐怕是绝望的。』" voices=""/><msg @l="2178" char_id="0" frame_id="-1" name="美帆" text="『……』" voices=""/><msg @l="2180" char_id="-1" frame_id="-1" name="朽木" text="『不过，也不必那么沮丧。』"   voices=""/><msg @l="2182" char_id="-1" frame_id="-1" name="朽木"   text="『实际上我在药学部那边有点关系，在那边的研究室多增加一个位置……这并不是什么难事。』"   voices=""/><msg @l="2184" char_id="0" frame_id="-1" name="美帆"   text="『那就是说，您会帮我父亲介绍再就业吗？』" voices=""/><msg @l="2186" char_id="-1" frame_id="-1" name="朽木" text="『嗯，差不多是这个意思。』"   voices=""/><msg @l="2188" char_id="0" frame_id="-1" name="美帆"   text="『那么……您是说要用帮父亲再就业作为交换条件吗？』" voices=""/><msg @l="2190" char_id="-1" frame_id="-1" name="朽木" text="『很遗憾，并不是这样。』"   voices=""/><char @l="2194" id="miho" pos="left" src="miho114"/><msg @l="2196" char_id="0" frame_id="-1" name="美帆" text="『啊……？』" voices=""/><msg @l="2198" char_id="-1" frame_id="-1" name="朽木"   text="『选择权在你手上。当然，如果你想起诉的话尽管去做。』" voices=""/><msg @l="2200" char_id="-1" frame_id="-1" name="朽木" text="『我不会逃避也不会躲藏。』"   voices=""/><msg @l="2202" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="2204" char_id="-1" frame_id="-1" name="朽木"   text="『审判不是那么容易结案的。』" voices=""/><msg @l="2206" char_id="-1" frame_id="-1" name="朽木"   text="『特别是像痴汉这种难以确定犯人和提供证据的案件，有时甚至连起诉都不会被受理。即使受理了成为诉讼，受困扰的反而会是仲根同学。』"   voices=""/><char @l="2209" id="miho" pos="left" src="miho115"/><msg @l="2211" char_id="0" frame_id="-1" name="美帆"   text="『请、请不要胡说八道……。』" voices=""/><char @l="2214" id="kutsu" pos="right" src="kutsu018"/><msg @l="2216" char_id="-1" frame_id="-1" name="朽木"   text="『是不是胡说八道，真的上了法庭就知道了。呵呵呵……你不了解审判是怎么回事。你知道上了法庭会被问些什么吗？』"   voices=""/><char @l="2219" id="miho" pos="left" src="miho114"/><msg @l="2221" char_id="0" frame_id="-1" name="美帆" text="『啊……？』" voices=""/><msg @l="2223" char_id="-1" frame_id="-1" name="朽木"   text="『你在电车上是如何被猥亵的？胸部被摸了几次？乳头被捏了吗？臀部被抓了吗？隔着内裤用手指触碰私处……。』"   voices=""/><char @l="2226" id="miho" pos="left" src="miho115"/><msg @l="2228" char_id="0" frame_id="-1" name="美帆" text="『够、够了，请住手！！』"   voices=""/><msg @l="2230" char_id="-1" frame_id="-1" name="朽木"   text="『呵呵呵，就这样在众多旁听者面前被问及羞耻的事情的同时，你父亲可能会失业，你的家人可能会流落街头呢。』"   voices=""/><msg @l="2232" char_id="-1" frame_id="-1" name="朽木"   text="『等审判结束时，你会绝望地发现自己已经失去了所有珍贵的东西。』" voices=""/><msg @l="2234" char_id="0" frame_id="-1" name="美帆" text="『那种事……是骗人的！』"   voices=""/><msg @l="2236" char_id="-1" frame_id="-1" name="朽木" text="『对我说也没用。』"   voices=""/><msg @l="2238" char_id="-1" frame_id="-1" name="朽木"   text="『因为是你导致了这种局面，仲根同学。』" voices=""/><msg @l="2240" char_id="-1" frame_id="-1" name="朽木"   text="『虽说你是受了多余的指点，但作为一名学生，你却挥舞着'告诉'这样的不稳妥词语。』" voices=""/><msg @l="2242" char_id="0" frame_id="-1" name="美帆" text="『怎么会……』"   voices=""/><clear @l="2245" layer="kutsu"/><char @l="2247" id="kutsu" pos="auto" src="kutsu010"/><msg @l="2249" char_id="-1" frame_id="-1" name="朽木"   text="『不过……我也不是无情的人。』" voices=""/><msg @l="2251" char_id="-1" frame_id="-1" name="朽木"   text="『我是在说，取决于你的态度，我可以拯救你的父亲哦？』" voices=""/><msg @l="2253" char_id="0" frame_id="-1" name="美帆" text="『这、这是什么意思……？』"   voices=""/><msg @l="2255" char_id="-1" frame_id="-1" name="朽木" text="『我想你自己也明白吧。』"   voices=""/><msg @l="2257" char_id="-1" frame_id="-1" name=""   text="就这样，朽木教授向我靠近。" voices=""/><msg @l="2258" char_id="-1" frame_id="-1" name=""   text="我下意识地后退想拉开距离，但他的手臂比我更快地搂住我的腰，将我拉近。" voices=""/><stopbgm @l="2262" fadeout="1000"/><clear @l="2265" class="char"/><char @l="2268" id="miho" pos="center" src="miho014f" y="-80"/><bgm @l="2272" src="bgm15" volume="1."/><msg @l="2274" char_id="0" frame_id="-1" name="美帆" text="『呀……』" voices=""/><char @l="2277" id="miho" pos="center" src="miho015f" y="-80"/><msg @l="2279" char_id="0" frame_id="-1" name="美帆" text="『请、请放开我！』"   voices=""/><msg @l="2281" char_id="-1" frame_id="-1" name="朽木" text="『哎呀……即使反抗也没关系吗？』"   voices=""/><msg @l="2283" char_id="-1" frame_id="-1" name="朽木"   text="『难道不想让我救你父亲吗？』" voices=""/><msg @l="2285" char_id="0" frame_id="-1" name="美帆" text="『……！』" voices=""/><begin_trans @l="2289" time="500"/><layer @l="2290" id="cutin_f" src="game_window_cutin" x="20" y="20"   z="-1001"/><layer @l="2291" id="cutin" src="cut001" x="32" y="32" z="-1000"/><end_trans @l="2292"/><msg @l="2294" char_id="-1" frame_id="-1" name=""   text="伴随着阴险的笑容，朽木教授的手滑进了我的裙子里。" voices=""/><msg @l="2295" char_id="-1" frame_id="-1" name=""   text="那黏腻缠绕的指尖动作，无疑与连日来的痴汉如出一辙。" voices=""/><msg @l="2297" char_id="-1" frame_id="-1" name="朽木"   text="『怎么样，这不是控告我的绝佳机会吗？』" voices=""/><msg @l="2299" char_id="-1" frame_id="-1" name="朽木"   text="『现在应该能获得起诉我的决定性证据吧？』" voices=""/><msg @l="2301" char_id="0" frame_id="-1" name="美帆" text="『这、这种事……太卑鄙了。』"   voices=""/><msg @l="2303" char_id="-1" frame_id="-1" name="朽木"   text="『如果你这么想，大可以放弃你父亲。』" voices=""/><msg @l="2305" char_id="-1" frame_id="-1" name="朽木"   text="『当然了，如果你放弃他，谁知道他绝望之下会做出什么行为呢。』" voices=""/><char @l="2308" id="miho" pos="center" src="miho115f" y="-80"/><msg @l="2310" char_id="0" frame_id="-1" name="美帆" text="『……唔……。』"   voices=""/><msg @l="2312" char_id="-1" frame_id="-1" name=""   text="朽木教授的话足以夺走我所有的抵抗心理。" voices=""/><msg @l="2313" char_id="-1" frame_id="-1" name=""   text="如果把工作视为生存意义的认真父亲被裁员，甚至找不到再就业的机会……那就等同于被社会宣告为不需要的人。"   voices=""/><msg @l="2314" char_id="-1" frame_id="-1" name="" text="那样的话，父亲会变成什么样呢。"   voices=""/><msg @l="2315" char_id="-1" frame_id="-1" name=""   text="为了家人，那个曾经实现我所有愿望的温柔父亲，我不想看到他失望绝望、失去生存意志的样子……。" voices=""/><msg @l="2316" char_id="-1" frame_id="-1" name=""   text="我不能仅仅为了自己一个人而让大家都不幸……。" voices=""/><msg @l="2318" char_id="0" frame_id="-1" name="美帆" text="(这种事……虽然讨厌……)"   voices=""/><msg @l="2320" char_id="-1" frame_id="-1" name=""   text="如果我顺从了，父亲和家人就能得救。" voices=""/><msg @l="2321" char_id="-1" frame_id="-1" name=""   text="这么想着……我什么都说不出来了。" voices=""/><char @l="2323" id="miho" pos="center" src="miho015f" y="-80"/><msg @l="2324" char_id="-1" frame_id="-1" name="朽木"   text="『呵呵呵，看来你已经明白自己的立场了。』" voices=""/><msg @l="2326" char_id="-1" frame_id="-1" name="朽木"   text="『像这样沉默地颤抖着，才最适合你。』" voices=""/><begin_trans @l="2330" time="500"/><layer @l="2331" id="cutin_f" src="game_window_cutin" x="20" y="20"   z="-1001"/><layer @l="2332" id="cutin" src="cut001b" x="32" y="32" z="-1000"/><end_trans @l="2333"/><msg @l="2335" char_id="-1" frame_id="-1" name=""   text="朽木教授一只手将我的腰拉近，另一只手隔着内裤摩擦着我的那里。" voices=""/><msg @l="2336" char_id="-1" frame_id="-1" name=""   text="可能是因为不像在电车里有被人看见的危险，朽木教授大胆地把我的裙子掀到腰部，用手指隔着薄薄的布料抚摸私处，不断给予刺激。"   voices=""/><msg @l="2338" char_id="0" frame_id="-1" name="美帆" text="『……唔嗯。』" voices=""/><msg @l="2340" char_id="-1" frame_id="-1" name="朽木"   text="『哎呀哎呀，在这种情况下被玩弄竟然有感觉了吗？』" voices=""/><msg @l="2342" char_id="0" frame_id="-1" name="美帆" text="『才没有……不是这样！』"   voices=""/><msg @l="2344" char_id="-1" frame_id="-1" name="朽木"   text="『哦？这样抵抗真的好吗？』" voices=""/><msg @l="2346" char_id="-1" frame_id="-1" name="" text="咕啾，咕啾。" voices=""/><msg @l="2347" char_id="-1" frame_id="-1" name=""   text="在私处摸索的手指像是要打开缝隙般蠕动着，手指用力捻转着那突起的部分。" voices=""/><msg @l="2349" char_id="0" frame_id="-1" name="美帆" text="『啊……。』" voices=""/><msg @l="2351" char_id="0" frame_id="-1" name="美帆"   text="『我、我有感觉了……被朽木教授的手指……有感觉了……。』" voices=""/><msg @l="2353" char_id="-1" frame_id="-1" name="朽木" text="『哈哈，那太好了。』"   voices=""/><msg @l="2355" char_id="-1" frame_id="-1" name="朽木"   text="『那么我必须让你更加愉悦才行啊。』" voices=""/><msg @l="2357" char_id="-1" frame_id="-1" name="" text="咕溜，咕溜。" voices=""/><msg @l="2358" char_id="-1" frame_id="-1" name=""   text="教授一边用指尖拨弄着捏起的突起，一边用指腹玩弄着丰满柔软的肉，笑了起来。" voices=""/><msg @l="2360" char_id="0" frame_id="-1" name="美帆" text="『嗯……。』" voices=""/><msg @l="2362" char_id="-1" frame_id="-1" name=""   text="连抵抗的话语都被禁止的我，只能哭泣着将身体交给教授的指尖，拼命吞咽着不自觉溢出的叹息。"   voices=""/><msg @l="2363" char_id="-1" frame_id="-1" name=""   text="身体可以屈服但心灵绝不妥协……怀抱着这样悲伤的想法。" voices=""/><msg @l="2365" char_id="0" frame_id="-1" name="美帆" text="『嗯嗯……嗯，哈……。』"   voices=""/><msg @l="2367" char_id="-1" frame_id="-1" name="" text="咕溜，咕溜。" voices=""/><msg @l="2368" char_id="-1" frame_id="-1" name=""   text="每当指尖隔着内衣挑逗变硬的突起，我都拼命压抑住即将不由自主漏出的抵抗话语。" voices=""/><msg @l="2370" char_id="0" frame_id="-1" name="美帆"   text="『啊……嗯，唔……呜呜呜。』" voices=""/><msg @l="2372" char_id="-1" frame_id="-1" name="" text="揉，揉，揉。"   voices=""/><msg @l="2373" char_id="-1" frame_id="-1" name=""   text="朽木教授仿佛在享受我的反应，加快了玩弄私处的手指动作。" voices=""/><msg @l="2374" char_id="-1" frame_id="-1" name=""   text="每当教授的手指摩擦那里时，我都会本能地扭动身体，试图从他的手中逃脱。" voices=""/><msg @l="2376" char_id="-1" frame_id="-1" name="朽木"   text="『哦，这应该被视为抵抗吗？』" voices=""/><msg @l="2378" char_id="-1" frame_id="-1" name=""   text="他在我耳边低语，愉快地扭曲着嘴角。" voices=""/><msg @l="2380" char_id="0" frame_id="-1" name="美帆"   text="『不，不是的……没有抵抗……。』" voices=""/><msg @l="2382" char_id="-1" frame_id="-1" name="朽木" text="『我想也是。』"   voices=""/><msg @l="2384" char_id="-1" frame_id="-1" name="朽木"   text="『毕竟，你的抵抗会导致你全家人离散。』" voices=""/><msg @l="2386" char_id="-1" frame_id="-1" name="朽木" text="『不可能有抵抗。』"   voices=""/><msg @l="2388" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="2390" char_id="-1" frame_id="-1" name=""   text="我被他的话语一步步逼入绝境。" voices=""/><msg @l="2391" char_id="-1" frame_id="-1" name=""   text="明明知道这一点，我却什么都做不了。" voices=""/><msg @l="2392" char_id="-1" frame_id="-1" name=""   text="除了毫无抵抗地任他玩弄之外……。" voices=""/><msg @l="2394" char_id="-1" frame_id="-1" name="朽木"   text="『这样吧。让我确认一下你的意志如何？』" voices=""/><msg @l="2396" char_id="0" frame_id="-1" name="美帆" text="『意志……吗？』"   voices=""/><msg @l="2398" char_id="-1" frame_id="-1" name="朽木"   text="『不管你嘴上怎么说不抵抗，你的身体却在试图逃离我。』" voices=""/><msg @l="2400" char_id="-1" frame_id="-1" name="朽木"   text="『这样的话，难道不是让人难以信任吗？』" voices=""/><msg @l="2402" char_id="0" frame_id="-1" name="美帆"   text="『这、这是……但是……该怎么做……。』" voices=""/><msg @l="2404" char_id="-1" frame_id="-1" name="朽木" text="『嗯……。』" voices=""/><msg @l="2406" char_id="-1" frame_id="-1" name="朽木"   text="『那么，让你来说一段誓言如何？』" voices=""/><msg @l="2408" char_id="0" frame_id="-1" name="美帆" text="『誓言……？』"   voices=""/><msg @l="2410" char_id="-1" frame_id="-1" name="朽木"   text="『是的。完成我和你之间契约的誓言。』" voices=""/><msg @l="2412" char_id="-1" frame_id="-1" name="朽木"   text="『只要你遵守这个，我就全力支持你父亲。』" voices=""/><msg @l="2414" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="2416" char_id="-1" frame_id="-1" name="朽木"   text="『怎么样？我觉得这不是个坏提议吧。』" voices=""/><msg @l="2418" char_id="-1" frame_id="-1" name=""   text="随着这番话，朽木教授嘴角邪恶地扭曲着，一边揉弄着无法抵抗的私处，一边突然将一根手指伸进内裤里直接触碰起来。"   voices=""/><begin_trans @l="2421" time="500"/><layer @l="2422" id="cutin_f" src="game_window_cutin" x="20" y="20"   z="-1001"/><layer @l="2423" id="cutin" src="cut001a" x="32" y="32" z="-1000"/><end_trans @l="2424"/><msg @l="2425" char_id="-1" frame_id="-1" name="" text="咕啾。" voices=""/><msg @l="2427" char_id="0" frame_id="-1" name="美帆" text="『啊……！』" voices=""/><msg @l="2429" char_id="-1" frame_id="-1" name=""   text="当朽木教授看到我惊讶的表情时，他脸上浮现出一丝意味深长的笑容，仿佛他掌握着我父亲的全部命运，这让我不禁感到一阵寒意。"   voices=""/><msg @l="2433" char_id="-1" frame_id="-1" name=""   text="而后朽木教授更进一步，将手伸进我的内裤里，直接触碰着私处和耻毛。" voices=""/><msg @l="2434" char_id="-1" frame_id="-1" name="" text="咕啾，沙沙。"   voices=""/><msg @l="2436" char_id="0" frame_id="-1" name="美帆" text="『啊啊…！』" voices=""/><msg @l="2438" char_id="-1" frame_id="-1" name="朽木"   text="『嗯？还是说你更愿意看到你的家人流落街头？』" voices=""/><msg @l="2440" char_id="0" frame_id="-1" name="美帆" text="『我…我知道了。』"   voices=""/><msg @l="2442" char_id="0" frame_id="-1" name="美帆" text="『我会好好说的…。』"   voices=""/><msg @l="2444" char_id="-1" frame_id="-1" name="朽木" text="『很好。』" voices=""/><msg @l="2446" char_id="-1" frame_id="-1" name="朽木"   text="『那么，请跟着我接下来说的话。』" voices=""/><msg @l="2448" char_id="0" frame_id="-1" name="美帆" text="『…是。』" voices=""/><msg @l="2450" char_id="-1" frame_id="-1" name="朽木"   text="『「我绝不会对任何事情违抗。」』" voices=""/><msg @l="2452" char_id="0" frame_id="-1" name="美帆"   text="『我……绝不会对任何事情……违抗……。』" voices=""/><msg @l="2454" char_id="-1" frame_id="-1" name="朽木"   text="『「无论在什么情况下，我都发誓会保持顺从。」』" voices=""/><msg @l="2456" char_id="0" frame_id="-1" name="美帆"   text="『无论……在什么情况下，我都发誓……会保持……顺从……。』" voices=""/><msg @l="2458" char_id="-1" frame_id="-1" name="朽木" text="『「我将献上我的心和身体。」』"   voices=""/><msg @l="2460" char_id="0" frame_id="-1" name="美帆" text="『我、我的心……和身体…………。』"   voices=""/><msg @l="2462" char_id="-1" frame_id="-1" name="" text="……………。" voices=""/><msg @l="2463" char_id="-1" frame_id="-1" name="" text="话说不下去了。" voices=""/><msg @l="2464" char_id="-1" frame_id="-1" name=""   text="我感觉如果把后面的话说出来，就好像会失去一切似的。" voices=""/><msg @l="2465" char_id="-1" frame_id="-1" name=""   text="虽然嘴唇动了好几次……但声音就是发不出来。" voices=""/><msg @l="2467" char_id="-1" frame_id="-1" name="朽木"   text="『怎么了，如果你无法念完誓言，我们就不得不让你父亲走上破产的道路，作为合同违约的后果呢？』"   voices=""/><msg @l="2469" char_id="0" frame_id="-1" name="美帆" text="『可、可是……。』"   voices=""/><msg @l="2471" char_id="0" frame_id="-1" name="美帆"   text="『这种事……我、我不能答应……………。』" voices=""/><msg @l="2473" char_id="-1" frame_id="-1" name="朽木" text="『那就没办法了啊。』"   voices=""/><msg @l="2475" char_id="-1" frame_id="-1" name="朽木"   text="『这样的话，你父亲将会收到公司的无情通告。』" voices=""/><msg @l="2477" char_id="0" frame_id="-1" name="美帆" text="『这样……。』" voices=""/><msg @l="2479" char_id="-1" frame_id="-1" name="朽木" text="『真是可悲啊。』"   voices=""/><msg @l="2481" char_id="-1" frame_id="-1" name="朽木"   text="『被效力多年的公司抛弃，又被自己的女儿抛弃，如果是我的话，一定会绝望的。』" voices=""/><msg @l="2483" char_id="0" frame_id="-1" name="美帆" text="『怎么会……但是………。』"   voices=""/><msg @l="2485" char_id="-1" frame_id="-1" name="朽木"   text="『他还没到退休年龄，却要靠微薄的退职金和国家发放的几个月失业补贴，度过之后漫长的晚年生活。』"   voices=""/><msg @l="2487" char_id="-1" frame_id="-1" name="朽木"   text="『如果是我的话，可能会在途中就变得自暴自弃吧。』" voices=""/><msg @l="2489" char_id="-1" frame_id="-1" name="朽木"   text="『最后甚至可能会自杀也说不定……。』" voices=""/><msg @l="2491" char_id="0" frame_id="-1" name="美帆"   text="『怎么会……父亲不是那么短视的人！』" voices=""/><msg @l="2493" char_id="-1" frame_id="-1" name="朽木" text="『哦？那要不要试一试呢？』"   voices=""/><msg @l="2495" char_id="-1" frame_id="-1" name="朽木"   text="『看看一个被逼到极限状态的人，能在多大程度上不变得短视，能如何面对绝望。』" voices=""/><msg @l="2497" char_id="-1" frame_id="-1" name="" text="沙沙，沙沙。" voices=""/><msg @l="2498" char_id="-1" frame_id="-1" name=""   text="朽木教授一边说着，一边将手伸进内裤，执拗地活动着，触摸着她的阴毛。" voices=""/><msg @l="2499" char_id="-1" frame_id="-1" name="" text="咕啾，咕啾。"   voices=""/><msg @l="2500" char_id="-1" frame_id="-1" name=""   text="他将另一根手指伸向秘部的嫩肉，直接挑逗起来。" voices=""/><msg @l="2501" char_id="-1" frame_id="-1" name=""   text="每当嫩肉被撑开玩弄，前所未有的刺激就贯穿全身。" voices=""/><msg @l="2503" char_id="0" frame_id="-1" name="美帆" text="『嗯嗯……。』"   voices=""/><msg @l="2505" char_id="-1" frame_id="-1" name="朽木"   text="『怎么样，看着家庭这样崩溃是很痛苦的吧？』" voices=""/><msg @l="2507" char_id="-1" frame_id="-1" name="朽木"   text="『哎，你只要一个人为了家人牺牲自己就好了。这样的话全家人都能得救。』" voices=""/><msg @l="2509" char_id="-1" frame_id="-1" name="朽木"   text="『国家和公司，都不会保护你的家人。』" voices=""/><msg @l="2511" char_id="-1" frame_id="-1" name="朽木"   text="『但是我可以救你的家人，救你的父亲。』" voices=""/><msg @l="2513" char_id="-1" frame_id="-1" name="朽木" text="『答案不是很明显吗？』"   voices=""/><msg @l="2515" char_id="-1" frame_id="-1" name=""   text="朽木教授嘴角微微扭曲，浮现出一丝下流的笑容。" voices=""/><msg @l="2516" char_id="-1" frame_id="-1" name=""   text="我自认为已经十分理解那些话背后隐藏的含义。" voices=""/><msg @l="2517" char_id="-1" frame_id="-1" name=""   text="但是，我没有勇气去拒绝“那个”。" voices=""/><msg @l="2518" char_id="-1" frame_id="-1" name="" text="不是没有勇气反抗朽木教授。"   voices=""/><msg @l="2519" char_id="-1" frame_id="-1" name=""   text="我缺乏勇气，即使要用父亲的人生作为筹码，也无法说出对错的话语……" voices=""/><msg @l="2521" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><stopbgm @l="2525" fadeout="1000"/><clear @l="2531" class="all"/><msg @l="2533" char_id="0" frame_id="-1" name="美帆"   text="『我……心灵……身体……一切，都献给您。』" voices=""/><msg @l="2535" char_id="-1" frame_id="-1" name=""   text="随着誓言的说出，朽木教授那在私处摸索的手指插入了我的秘处。" voices=""/><msg @l="2536" char_id="-1" frame_id="-1" name=""   text="此刻，我内心深处应当守护的“某样东西”碎裂了……" voices=""/><clear @l="2542" class="all"/><eval @l="2545" expr="f.朽木ルートflag&#32;=&#32;1&#13;&#10;"/><call @l="2550" target="EventLabel_100@root_kutuki01"/><return @l="2551" value="0&#13;&#10;"/><goto @l="2554" label="TempLabel_203"/><label @l="2555" id="TempLabel_190"/><wait_chgmv/><bg @l="2561" src="bg03b"/><bgm @l="2565" src="bgm05" volume="1."/><char @l="2569" id="miho" pos="auto" src="miho031"/><description @l="2572" text="回归的日常"/><eval @l="2574" expr="f.numDay=3&#13;&#10;"/><msg @l="2576" char_id="0" frame_id="-1" name="美帆" text="『多谢款待。』"   voices=""/><msg @l="2578" char_id="1" frame_id="-1" name="玲" text="『嗯，不客气。』"   voices=""/><msg @l="2580" char_id="-1" frame_id="-1" name=""   text="吃完白石学姐亲手做的牛肉炖菜后，我把两个空盘子叠放在厨房的水槽里。" voices=""/><msg @l="2582" char_id="0" frame_id="-1" name="美帆" text="『学姐，真不愧是您啊。』"   voices=""/><msg @l="2584" char_id="0" frame_id="-1" name="美帆"   text="『明明需要准备考试资料，却还在这种零碎时间做这么精细的料理。』" voices=""/><clear @l="2587" class="char"/><char @l="2589" id="miho" pos="left" src="miho031"/><char @l="2591" id="rei" pos="right" src="rei030"/><msg @l="2593" char_id="1" frame_id="-1" name="玲" text="『哎呀，没有那么夸张啦。』"   voices=""/><msg @l="2595" char_id="1" frame_id="-1" name="玲"   text="『虽然前期准备有点麻烦，但基本上是放着就能完成的料理啊。』" voices=""/><char @l="2598" id="rei" pos="right" src="rei031"/><msg @l="2600" char_id="1" frame_id="-1" name="玲"   text="『反过来说，正因为是在做其他事的间隙才能做的东西，不是吗？』" voices=""/><char @l="2603" id="miho" pos="left" src="miho133"/><msg @l="2605" char_id="0" frame_id="-1" name="美帆" text="『嗯～，是这样吗？』"   voices=""/><msg @l="2607" char_id="-1" frame_id="-1" name=""   text="我以前也只尝试过一次做俄式炖牛肉。" voices=""/><msg @l="2608" char_id="-1" frame_id="-1" name=""   text="那道菜和牛肉炖菜一样需要很长时间，我记得，我为此被困在厨房里整整半天。" voices=""/><msg @l="2609" char_id="-1" frame_id="-1" name=""   text="这种差距果然是因为我天生的不灵巧吧。" voices=""/><char @l="2612" id="miho" pos="left" src="miho131"/><msg @l="2614" char_id="0" frame_id="-1" name="美帆" text="『我去泡咖啡。』"   voices=""/><msg @l="2616" char_id="1" frame_id="-1" name="玲" text="『拜托啦。』" voices=""/><msg @l="2618" char_id="-1" frame_id="-1" name=""   text="在洗餐具的空隙，把容器装进咖啡机里。" voices=""/><msg @l="2619" char_id="-1" frame_id="-1" name=""   text="稍等片刻，芳香的咖啡香气开始飘散时，我已经将所有晚餐用的餐具洗完了。" voices=""/><clear @l="2622" class="char"/><char @l="2626" id="miho" pos="auto" src="miho030"/><msg @l="2628" char_id="0" frame_id="-1" name="美帆" text="『咖啡，让你久等了。』"   voices=""/><clear @l="2631" class="char"/><char @l="2633" id="miho" pos="left" src="miho030"/><char @l="2636" id="rei" pos="right" src="rei031"/><msg @l="2638" char_id="1" frame_id="-1" name="玲" text="『谢谢。』" voices=""/><msg @l="2640" char_id="1" frame_id="-1" name="玲" text="『嗯～……好香啊。』"   voices=""/><msg @l="2642" char_id="-1" frame_id="-1" name=""   text="学姐将脸凑近杯子，深深地吸入咖啡的香气。" voices=""/><msg @l="2643" char_id="-1" frame_id="-1" name=""   text="过去用速溶咖啡的时候还没什么感觉，但最近我常常意识到，咖啡以香气为生命这句话确实是不争的事实。"   voices=""/><msg @l="2644" char_id="-1" frame_id="-1" name=""   text="咖啡最重要的是第一口，之后的部分是为了享受那余韵而存在的。" voices=""/><msg @l="2645" char_id="-1" frame_id="-1" name=""   text="不过，很多时候也能在那余韵中感受到安心……" voices=""/><char @l="2649" id="miho" pos="left" src="miho136"/><msg @l="2651" char_id="0" frame_id="-1" name="美帆" text="『……呼。』" voices=""/><char @l="2654" id="rei" pos="right" src="rei030"/><msg @l="2656" char_id="1" frame_id="-1" name="玲" text="『……。』" voices=""/><msg @l="2658" char_id="1" frame_id="-1" name="玲" text="『你好像有点累了。』"   voices=""/><char @l="2662" id="miho" pos="left" src="miho034"/><msg @l="2664" char_id="0" frame_id="-1" name="美帆" text="『是这样吗？』" voices=""/><char @l="2668" id="miho" pos="left" src="miho136"/><msg @l="2670" char_id="0" frame_id="-1" name="美帆" text="『……也是呢。』"   voices=""/><msg @l="2672" char_id="-1" frame_id="-1" name="" text="白天发生了那么多事。"   voices=""/><msg @l="2673" char_id="-1" frame_id="-1" name="" text="说不累那是骗人的。"   voices=""/><goto @l="2676" cond="!(f.痴漢flag&#32;==&#32;1)&#13;&#10;"   label="TempLabel_204"/><msg @l="2679" char_id="1" frame_id="-1" name="玲" text="『是因为早上的事……？』" voices=""/><msg @l="2681" char_id="0" frame_id="-1" name="美帆" text="『……是的。』" voices=""/><msg @l="2683" char_id="-1" frame_id="-1" name=""   text="那场骚动之后……虽然和白石学姐会合了，但因为要赶第一节课，还没怎么说上话就分开了。"   voices=""/><msg @l="2684" char_id="-1" frame_id="-1" name=""   text="学姐应该不知道我为什么会和朽木教授以及稻庭学长在一起。" voices=""/><msg @l="2686" char_id="1" frame_id="-1" name="玲"   text="『你好像和稻庭先生认识……发生什么事了？』" voices=""/><char @l="2689" id="miho" pos="left" src="miho034"/><msg @l="2691" char_id="0" frame_id="-1" name="美帆"   text="『啊，是的……我……最近一直遭遇痴汉。』" voices=""/><char @l="2694" id="miho" pos="left" src="miho136"/><msg @l="2696" char_id="0" frame_id="-1" name="美帆"   text="『然后……今天，碰巧得到了稻庭学长的帮助。』" voices=""/><char @l="2699" id="rei" pos="right" src="rei034"/><msg @l="2701" char_id="1" frame_id="-1" name="玲" text="『痴汉，难道说……是朽木教授？』"   voices=""/><char @l="2704" id="miho" pos="left" src="miho135"/><msg @l="2706" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="2708" char_id="-1" frame_id="-1" name="" text="我沉默着轻轻点了点头。"   voices=""/><msg @l="2709" char_id="-1" frame_id="-1" name=""   text="朽木教授居然是痴汉的真凶，就连我自己到现在都不愿相信。" voices=""/><char @l="2712" id="rei" pos="right" src="rei030"/><msg @l="2714" char_id="1" frame_id="-1" name="玲" text="『这样啊……。』" voices=""/><msg @l="2716" char_id="1" frame_id="-1" name="玲"   text="『让你别灰心……这种话也很勉强吧。』" voices=""/><char @l="2719" id="miho" pos="left" src="miho036"/><msg @l="2721" char_id="0" frame_id="-1" name="美帆" text="『啊，不过……我已经没事了。』"   voices=""/><msg @l="2723" char_id="0" frame_id="-1" name="美帆"   text="『虽然有点震惊，但还是挺过来了……。』" voices=""/><msg @l="2725" char_id="1" frame_id="-1" name="玲" text="『你没勉强自己吧？』" voices=""/><char @l="2728" id="miho" pos="left" src="miho034"/><msg @l="2730" char_id="0" frame_id="-1" name="美帆" text="『没有那种事……。』"   voices=""/><char @l="2733" id="miho" pos="left" src="miho136"/><char @l="2735" id="rei" pos="right" src="rei031"/><msg @l="2737" char_id="1" frame_id="-1" name="玲"   text="『既然有稻庭学长帮忙，我想应该不要紧，但有什么事的话不要客气，尽管来找我商量。』" voices=""/><msg @l="2739" char_id="1" frame_id="-1" name="玲"   text="『我想……我不会什么也做不了的。』" voices=""/><msg @l="2741" char_id="0" frame_id="-1" name="美帆" text="『谢谢您。』"   voices=""/><msg @l="2743" char_id="0" frame_id="-1" name="美帆"   text="『学姐……我真的没事了。』" voices=""/><char @l="2746" id="rei" pos="right" src="rei030"/><msg @l="2748" char_id="1" frame_id="-1" name="玲" text="『叫我玲就好了……。』"   voices=""/><char @l="2751" id="miho" pos="left" src="miho134"/><msg @l="2753" char_id="0" frame_id="-1" name="美帆" text="『诶？』" voices=""/><msg @l="2755" char_id="1" frame_id="-1" name="玲"   text="『都已经一个月了，还叫我学姐……感觉太见外了，你直接叫我名字就好。』" voices=""/><msg @l="2757" char_id="1" frame_id="-1" name="玲"   text="『我很喜欢你，就像有了个可爱的妹妹一样……』" voices=""/><char @l="2760" id="miho" pos="left" src="miho133"/><msg @l="2762" char_id="0" frame_id="-1" name="美帆" text="『玲……桑，这样可以吗……』"   voices=""/><msg @l="2764" char_id="-1" frame_id="-1" name=""   text="面对学姐突如其来的话语，我有些困惑，但感觉像是有了一个温柔的姐姐，心里莫名有些痒痒的感觉，脸颊不由得发热起来。"   voices=""/><char @l="2767" id="rei" pos="right" src="rei031"/><msg @l="2769" char_id="1" frame_id="-1" name="玲" text="『就是这样。』" voices=""/><msg @l="2771" char_id="-1" frame_id="-1" name=""   text="白石学姐……玲桑这样说着，温柔地笑了。" voices=""/><char @l="2774" id="rei" pos="right" src="rei030"/><msg @l="2776" char_id="1" frame_id="-1" name="玲"   text="『但是，正因如此，我希望你早上发现问题的时候就能跟我商量。』" voices=""/><msg @l="2778" char_id="0" frame_id="-1" name="美帆"   text="『对不起……果然还是觉得很害羞。』" voices=""/><msg @l="2780" char_id="1" frame_id="-1" name="玲"   text="『嗯，我能理解你的心情……』" voices=""/><char @l="2783" id="miho" pos="left" src="miho135"/><msg @l="2785" char_id="0" frame_id="-1" name="美帆" text="『对不起……。』"   voices=""/><char @l="2788" id="rei" pos="right" src="rei031"/><msg @l="2790" char_id="1" frame_id="-1" name="玲"   text="『没事……反正问题已经解决了，就这样吧。』" voices=""/><msg @l="2792" char_id="-1" frame_id="-1" name="" text="说完，玲姐灿烂地笑了。"   voices=""/><msg @l="2793" char_id="-1" frame_id="-1" name=""   text="老实说，我心里有很多事情困扰着，但她的笑容让我感到了一丝安慰。" voices=""/><msg @l="2794" char_id="-1" frame_id="-1" name=""   text="现在的我，连从心底笑出来的气力都……不太够呢。" voices=""/><char @l="2797" id="miho" pos="left" src="miho034"/><msg @l="2799" char_id="0" frame_id="-1" name="美帆" text="『话说回来……』"   voices=""/><msg @l="2801" char_id="0" frame_id="-1" name="美帆"   text="『您对稻庭学长很了解呢？』" voices=""/><char @l="2804" id="rei" pos="right" src="rei030"/><msg @l="2806" char_id="1" frame_id="-1" name="玲"   text="『啊。稻庭和我是同期，而且在同一个社团。』" voices=""/><msg @l="2808" char_id="1" frame_id="-1" name="玲"   text="『你知道吗？他是网球社的社长。』" voices=""/><char @l="2811" id="miho" pos="left" src="miho030"/><msg @l="2813" char_id="0" frame_id="-1" name="美帆" text="『啊，是的……』"   voices=""/><msg @l="2815" char_id="-1" frame_id="-1" name=""   text="记得之前上课认识的朋友也说过类似的事情。" voices=""/><msg @l="2817" char_id="1" frame_id="-1" name="玲"   text="『我也参加了网球社，所以就是这样。』" voices=""/><char @l="2820" id="miho" pos="left" src="miho031"/><msg @l="2822" char_id="0" frame_id="-1" name="美帆" text="『哦～，网球啊。』"   voices=""/><msg @l="2824" char_id="0" frame_id="-1" name="美帆" text="『很适合玲姐您呢。』"   voices=""/><char @l="2827" id="rei" pos="right" src="rei031"/><msg @l="2829" char_id="1" frame_id="-1" name="玲"   text="『我不知道是否适合，但确实让我生活充实。』" voices=""/><char @l="2832" id="rei" pos="right" src="rei030"/><msg @l="2834" char_id="1" frame_id="-1" name="玲"   text="『你有计划加入什么社团吗？』" voices=""/><char @l="2837" id="miho" pos="left" src="miho030"/><msg @l="2839" char_id="0" frame_id="-1" name="美帆" text="『没有特别的计划······』"   voices=""/><char @l="2842" id="miho" pos="left" src="miho031"/><msg @l="2844" char_id="0" frame_id="-1" name="美帆" text="『网球什么的······看起来很有趣呢。』"   voices=""/><char @l="2847" id="rei" pos="right" src="rei031"/><msg @l="2849" char_id="1" frame_id="-1" name="玲"   text="『呵呵····你是对网球感兴趣呢，还是对稻庭学长感兴趣？』" voices=""/><char @l="2852" id="miho" pos="left" src="miho034"/><msg @l="2854" char_id="0" frame_id="-1" name="美帆"   text="『啊····不、不是那样的。』" voices=""/><char @l="2857" id="miho" pos="left" src="miho133"/><msg @l="2859" char_id="0" frame_id="-1" name="美帆"   text="『我只是觉得网球也不错····就只是这样而已！』" voices=""/><msg @l="2861" char_id="1" frame_id="-1" name="玲"   text="『你这么激动地否认反而更可疑了～。』" voices=""/><msg @l="2863" char_id="0" frame_id="-1" name="美帆" text="『不、不是那样的……。』"   voices=""/><char @l="2866" id="miho" pos="left" src="miho031"/><msg @l="2868" char_id="0" frame_id="-1" name="美帆"   text="『比起这个，学姐您怎么样呢？』" voices=""/><char @l="2871" id="rei" pos="right" src="rei034"/><msg @l="2873" char_id="1" frame_id="-1" name="玲" text="『啊，我……？』" voices=""/><msg @l="2875" char_id="0" frame_id="-1" name="美帆"   text="『您不是很推崇稻庭学长吗？』" voices=""/><char @l="2878" id="rei" pos="right" src="rei031"/><msg @l="2880" char_id="1" frame_id="-1" name="玲" text="『我喜欢他。』"   voices=""/><char @l="2883" id="miho" pos="left" src="miho034"/><msg @l="2885" char_id="0" frame_id="-1" name="美帆" text="『哇……。』" voices=""/><msg @l="2887" char_id="0" frame_id="-1" name="美帆"   text="『玲姐，您真是直接呢……。』" voices=""/><char @l="2890" id="rei" pos="right" src="rei030"/><msg @l="2892" char_id="1" frame_id="-1" name="玲" text="『嗯，可能是性格吧。』"   voices=""/><msg @l="2894" char_id="1" frame_id="-1" name="玲"   text="『我不太擅长隐藏感情。』" voices=""/><char @l="2897" id="miho" pos="left" src="miho030"/><msg @l="2899" char_id="0" frame_id="-1" name="美帆"   text="『但是，这样不会很辛苦吗？』" voices=""/><msg @l="2901" char_id="1" frame_id="-1" name="玲" text="『辛苦是什么意思？』" voices=""/><char @l="2904" id="miho" pos="left" src="miho130"/><msg @l="2906" char_id="0" frame_id="-1" name="美帆"   text="『比如被人传闲话……或者自己的感情被对方知道了之类的。』" voices=""/><char @l="2909" id="rei" pos="right" src="rei031"/><msg @l="2911" char_id="1" frame_id="-1" name="玲" text="『不在意那些传闻就好了。』"   voices=""/><msg @l="2913" char_id="1" frame_id="-1" name="玲"   text="『而且，让对方知道自己的心意真的是件那么糟糕的事吗？』" voices=""/><char @l="2916" id="miho" pos="left" src="miho136"/><msg @l="2918" char_id="0" frame_id="-1" name="美帆"   text="『也不是……觉得糟糕……。』" voices=""/><char @l="2921" id="rei" pos="right" src="rei030"/><msg @l="2923" char_id="1" frame_id="-1" name="玲"   text="『如果不把自己的心情传达给对方，什么都不会开始。』" voices=""/><msg @l="2925" char_id="1" frame_id="-1" name="玲"   text="『无论好坏，一直隐藏自己的想法是很辛苦的事情。』" voices=""/><msg @l="2927" char_id="1" frame_id="-1" name="玲"   text="『既然都要承受辛苦，与其用来隐藏内心，不如用来为达成心愿而努力，不是吗？』"   voices=""/><msg @l="2929" char_id="1" frame_id="-1" name="玲"   text="『当然，我也不认为只是一味地毫无思考地往前冲就是全部。』" voices=""/><char @l="2932" id="miho" pos="left" src="miho034"/><msg @l="2934" char_id="0" frame_id="-1" name="美帆" text="『好厉害……玲姐真是成熟呢。』"   voices=""/><msg @l="2936" char_id="1" frame_id="-1" name="玲"   text="『大人和孩子，其实没有那么大的差别哦。』" voices=""/><msg @l="2938" char_id="1" frame_id="-1" name="玲"   text="『有没有自觉，我觉得只是这点区别而已。』" voices=""/><char @l="2941" id="rei" pos="right" src="rei031"/><msg @l="2943" char_id="-1" frame_id="-1" name=""   text="这样笑着的学姐，在我看来比我成熟多了。" voices=""/><char @l="2946" id="miho" pos="left" src="miho131"/><msg @l="2948" char_id="0" frame_id="-1" name="美帆" text="『表白什么的……您做过吗？』"   voices=""/><char @l="2951" id="rei" pos="right" src="rei030"/><msg @l="2953" char_id="1" frame_id="-1" name="玲" text="『当然做过啊。』"   voices=""/><msg @l="2955" char_id="1" frame_id="-1" name="玲" text="『不过，被拒绝了。』"   voices=""/><char @l="2958" id="miho" pos="left" src="miho134"/><msg @l="2960" char_id="0" frame_id="-1" name="美帆" text="『诶，被拒绝了吗！？』"   voices=""/><char @l="2963" id="rei" pos="right" src="rei034"/><msg @l="2965" char_id="1" frame_id="-1" name="玲" text="『怎么了？觉得很意外？』"   voices=""/><char @l="2968" id="miho" pos="left" src="miho136"/><msg @l="2970" char_id="0" frame_id="-1" name="美帆" text="『与其说意外……该怎么说呢。』"   voices=""/><msg @l="2972" char_id="0" frame_id="-1" name="美帆"   text="『玲姐不仅头脑好，还很漂亮……身材也很棒。』" voices=""/><msg @l="2974" char_id="0" frame_id="-1" name="美帆" text="『我就是在想，为什么会被拒绝呢。』"   voices=""/><char @l="2977" id="rei" pos="right" src="rei030"/><msg @l="2979" char_id="1" frame_id="-1" name="玲"   text="『哎，这倒是我想问的问题呢。』" voices=""/><msg @l="2981" char_id="1" frame_id="-1" name="玲"   text="『那个人好像每天都在拒绝表白呢？』" voices=""/><char @l="2984" id="miho" pos="left" src="miho034"/><msg @l="2986" char_id="0" frame_id="-1" name="美帆" text="『是这样吗？』"   voices=""/><msg @l="2988" char_id="1" frame_id="-1" name="玲" text="『真假与否当然不清楚。』"   voices=""/><msg @l="2990" char_id="1" frame_id="-1" name="玲"   text="『毕竟传言说，他心里已经有了喜欢的人，或者是有父母之间定下的婚约者之类的。』" voices=""/><char @l="2993" id="miho" pos="left" src="miho036"/><msg @l="2995" char_id="0" frame_id="-1" name="美帆" text="『啊哈哈……』" voices=""/><msg @l="2997" char_id="1" frame_id="-1" name="玲"   text="『无论如何，只要他还是单身，机会就还有很多。』" voices=""/><char @l="3000" id="rei" pos="right" src="rei031"/><msg @l="3002" char_id="1" frame_id="-1" name="玲"   text="『反而，从现在开始才是作为女人决胜的时刻呢。』" voices=""/><msg @l="3004" char_id="0" frame_id="-1" name="美帆" text="『玲姐……真坚强啊。』"   voices=""/><msg @l="3006" char_id="1" frame_id="-1" name="玲"   text="『呵呵，我就把这当作赞美收下了。』" voices=""/><msg @l="3008" char_id="-1" frame_id="-1" name=""   text="说完，玲小姐微微一笑，一口气喝完了杯子里的东西。" voices=""/><msg @l="3009" char_id="-1" frame_id="-1" name=""   text="舌头怕烫的我……只能静静地等待杯中的饮料慢慢变凉。" voices=""/><goto @l="3012" label="TempLabel_205"/><label @l="3013" id="TempLabel_204"/><char @l="3018" id="rei" pos="right" src="rei030"/><msg @l="3020" char_id="1" frame_id="-1" name="玲" text="『关于今早的事。』" voices=""/><char @l="3023" id="miho" pos="left" src="miho136"/><msg @l="3025" char_id="0" frame_id="-1" name="美帆" text="『……。』" voices=""/><msg @l="3027" char_id="1" frame_id="-1" name="玲"   text="『我不是你，所以不能完全理解你伤心的感受……』" voices=""/><msg @l="3029" char_id="1" frame_id="-1" name="玲"   text="『不过，一直纠结于已经解决的事情可不好哦。』" voices=""/><msg @l="3031" char_id="0" frame_id="-1" name="美帆" text="『这个……我明白的。』"   voices=""/><msg @l="3033" char_id="0" frame_id="-1" name="美帆"   text="『只是有点不安而已。』" voices=""/><msg @l="3035" char_id="0" frame_id="-1" name="美帆"   text="『那样做真的好吗，真的没问题吗……这样的疑问。』" voices=""/><msg @l="3037" char_id="1" frame_id="-1" name="玲" text="『……是啊。』" voices=""/><char @l="3040" id="rei" pos="right" src="rei031"/><msg @l="3042" char_id="1" frame_id="-1" name="玲"   text="『如果你不安的话，明天要不要再一起坐电车？』" voices=""/><char @l="3045" id="miho" pos="left" src="miho034"/><msg @l="3047" char_id="0" frame_id="-1" name="美帆" text="『啊……』" voices=""/><msg @l="3049" char_id="1" frame_id="-1" name="玲"   text="『就算是一天，两天，或者一周，只要能消除你的不安，这点代价并不算什么。』" voices=""/><msg @l="3051" char_id="0" frame_id="-1" name="美帆"   text="『这、这怎么行……学姐您肯定很忙的。』" voices=""/><char @l="3054" id="rei" pos="right" src="rei030"/><msg @l="3056" char_id="1" frame_id="-1" name="玲" text="『叫我玲就可以了哦……』"   voices=""/><char @l="3059" id="miho" pos="left" src="miho134"/><msg @l="3062" char_id="0" frame_id="-1" name="美帆" text="『诶？』" voices=""/><msg @l="3064" char_id="1" frame_id="-1" name="玲"   text="『都已经一个月了，还叫我学姐……感觉太见外了，你直接叫我名字就好。』" voices=""/><msg @l="3066" char_id="1" frame_id="-1" name="玲"   text="『我很喜欢你，就像有了个可爱的妹妹一样……』" voices=""/><char @l="3069" id="miho" pos="left" src="miho133"/><msg @l="3071" char_id="0" frame_id="-1" name="美帆" text="『玲……桑，这样可以吗……』"   voices=""/><msg @l="3073" char_id="-1" frame_id="-1" name=""   text="面对学姐突然的话语，我有些困惑，但感觉像是有了一位温柔的姐姐，莫名有种心痒痒的感觉，脸颊不禁热了起来。"   voices=""/><char @l="3076" id="rei" pos="right" src="rei031"/><msg @l="3078" char_id="1" frame_id="-1" name="玲" text="『是啊。』" voices=""/><msg @l="3080" char_id="-1" frame_id="-1" name=""   text="白石学姐……不，玲姐温柔地笑着说道。" voices=""/><char @l="3083" id="rei" pos="right" src="rei030"/><msg @l="3085" char_id="1" frame_id="-1" name="玲"   text="『不过，正因如此，如果可以的话，我希望你今早就能跟我商量一下。』" voices=""/><msg @l="3087" char_id="0" frame_id="-1" name="美帆"   text="『对不起……还是觉得很难为情。』" voices=""/><msg @l="3089" char_id="1" frame_id="-1" name="玲"   text="『嗯，我能理解你的心情，但是……』" voices=""/><char @l="3092" id="miho" pos="left" src="miho135"/><msg @l="3094" char_id="0" frame_id="-1" name="美帆" text="『对不起……』"   voices=""/><msg @l="3096" char_id="1" frame_id="-1" name="玲"   text="『呵呵。不过，既然你这么想，那就尽快调整心态，消除不安吧。』" voices=""/><msg @l="3098" char_id="1" frame_id="-1" name="玲" text="『你的心情才是最重要的。』"   voices=""/><char @l="3101" id="miho" pos="left" src="miho036"/><msg @l="3103" char_id="0" frame_id="-1" name="美帆" text="『嗯……谢谢您。』"   voices=""/><char @l="3106" id="miho" pos="left" src="miho136"/><msg @l="3108" char_id="0" frame_id="-1" name="美帆"   text="『我知道。我理智上明白，但是……』" voices=""/><msg @l="3110" char_id="1" frame_id="-1" name="玲" text="『嗯……不要勉强自己。』"   voices=""/><msg @l="3112" char_id="1" frame_id="-1" name="玲"   text="『慢慢来，按照自己的节奏整理心情。』" voices=""/><char @l="3115" id="miho" pos="left" src="miho035"/><msg @l="3117" char_id="0" frame_id="-1" name="美帆" text="『玲姐……』" voices=""/><msg @l="3119" char_id="1" frame_id="-1" name="玲"   text="『只是，不要依赖我的话当借口哦。』" voices=""/><msg @l="3121" char_id="1" frame_id="-1" name="玲"   text="『对自己严格，对他人温柔……这是人际交往的基本原则。』" voices=""/><char @l="3124" id="miho" pos="left" src="miho030"/><msg @l="3126" char_id="0" frame_id="-1" name="美帆" text="『是、是的。』" voices=""/><msg @l="3128" char_id="-1" frame_id="-1" name=""   text="面对玲姐那让我分不清是鼓励还是说教的话语，我带着困惑的表情点了点头。" voices=""/><msg @l="3129" char_id="-1" frame_id="-1" name="" text="不过，我能理解玲姐的话。"   voices=""/><msg @l="3130" char_id="-1" frame_id="-1" name=""   text="利用鼓励的话语作为借口逃避，是最卑鄙的行为。" voices=""/><msg @l="3131" char_id="-1" frame_id="-1" name=""   text="或许直到现在，我一直都是这样逃避的。" voices=""/><msg @l="3132" char_id="-1" frame_id="-1" name=""   text="但是，从今以后……自从来到南总町，我就决定要改变。" voices=""/><msg @l="3133" char_id="-1" frame_id="-1" name=""   text="要对自己诚实，对自己严格……还要变得积极主动。" voices=""/><char @l="3136" id="miho" pos="left" src="miho033"/><msg @l="3138" char_id="0" frame_id="-1" name="美帆" text="『玲姐……』"   voices=""/><msg @l="3140" char_id="1" frame_id="-1" name="玲" text="『嗯？』" voices=""/><msg @l="3142" char_id="0" frame_id="-1" name="美帆"   text="『玲姐在这种时候一般是怎么放松心情的呢？』" voices=""/><msg @l="3144" char_id="1" frame_id="-1" name="玲" text="『这个嘛……』" voices=""/><char @l="3147" id="rei" pos="right" src="rei031"/><msg @l="3149" char_id="1" frame_id="-1" name="玲"   text="『我的话……应该是活动身体吧。』" voices=""/><msg @l="3151" char_id="0" frame_id="-1" name="美帆" text="『运动……吗？』"   voices=""/><char @l="3154" id="miho" pos="left" src="miho034"/><msg @l="3156" char_id="1" frame_id="-1" name="玲"   text="『对。游泳也好跑步也好，什么都可以……总之就是动起来。』" voices=""/><char @l="3159" id="rei" pos="right" src="rei030"/><msg @l="3161" char_id="1" frame_id="-1" name="玲"   text="『一直思考的话，就会越来越把自己封闭起来。』" voices=""/><char @l="3164" id="miho" pos="left" src="miho030"/><msg @l="3166" char_id="0" frame_id="-1" name="美帆" text="『动起来……』" voices=""/><msg @l="3168" char_id="1" frame_id="-1" name="玲"   text="『对了……要不要来我的社团看看？』" voices=""/><msg @l="3170" char_id="0" frame_id="-1" name="美帆"   text="『说起来学姐是加入了社团的吧。』" voices=""/><msg @l="3172" char_id="0" frame_id="-1" name="美帆" text="『是体育类的吗？』"   voices=""/><msg @l="3174" char_id="1" frame_id="-1" name="玲"   text="『我没说过吗？我加入的是网球社。』" voices=""/><msg @l="3176" char_id="1" frame_id="-1" name="玲"   text="『现在这个时期，应该还可以体验社团活动吧。』" voices=""/><char @l="3179" id="miho" pos="left" src="miho034"/><msg @l="3181" char_id="0" frame_id="-1" name="美帆" text="『啊，说到网球社……』"   voices=""/><char @l="3184" id="miho" pos="left" src="miho031"/><msg @l="3186" char_id="0" frame_id="-1" name="美帆"   text="『前几天我跟网球社的会长聊过天呢。』" voices=""/><msg @l="3188" char_id="1" frame_id="-1" name="玲" text="『哎呀，你认识稻庭吗？』"   voices=""/><msg @l="3190" char_id="0" frame_id="-1" name="美帆"   text="『谈不上认识啦……』" voices=""/><msg @l="3192" char_id="0" frame_id="-1" name="美帆"   text="『只是我一个上同样课的朋友好像是稻庭学长的大粉丝，我只是跟他一起站着聊了几句而已。』" voices=""/><msg @l="3194" char_id="1" frame_id="-1" name="玲"   text="『嗯～，看来他还是一如既往地让很多女孩子为他着迷呢。』" voices=""/><char @l="3197" id="miho" pos="left" src="miho030"/><msg @l="3199" char_id="0" frame_id="-1" name="美帆" text="『是这样吗？』"   voices=""/><msg @l="3201" char_id="1" frame_id="-1" name="玲"   text="『是啊。而且他本人还毫无自觉，真是让人头疼。』" voices=""/><msg @l="3203" char_id="0" frame_id="-1" name="美帆"   text="『嗯……为什么玲学姐会感到头疼呢？』" voices=""/><char @l="3206" id="rei" pos="right" src="rei031"/><msg @l="3208" char_id="1" frame_id="-1" name="玲"   text="『啊……我喜欢稻庭先生。』" voices=""/><char @l="3211" id="miho" pos="left" src="miho034"/><msg @l="3213" char_id="0" frame_id="-1" name="美帆"   text="『诶……，没必要说得这么直白吧……。』" voices=""/><char @l="3216" id="rei" pos="right" src="rei030"/><msg @l="3218" char_id="1" frame_id="-1" name="玲" text="『很奇怪吗？』"   voices=""/><char @l="3221" id="miho" pos="left" src="miho130"/><msg @l="3223" char_id="0" frame_id="-1" name="美帆"   text="『也不是……奇怪……。』" voices=""/><char @l="3226" id="miho" pos="left" src="miho031"/><msg @l="3228" char_id="0" frame_id="-1" name="美帆"   text="『那个，有点……吃惊。』" voices=""/><char @l="3231" id="rei" pos="right" src="rei031"/><msg @l="3233" char_id="1" frame_id="-1" name="玲"   text="『我不太擅长隐藏自己的心情。』" voices=""/><char @l="3236" id="miho" pos="left" src="miho131"/><msg @l="3238" char_id="0" frame_id="-1" name="美帆" text="『告白之类的……您做过吗？』"   voices=""/><char @l="3241" id="rei" pos="right" src="rei030"/><msg @l="3243" char_id="1" frame_id="-1" name="玲" text="『当然做过啊。』"   voices=""/><msg @l="3245" char_id="1" frame_id="-1" name="玲" text="『不过，被拒绝了。』"   voices=""/><char @l="3248" id="miho" pos="left" src="miho134"/><msg @l="3250" char_id="0" frame_id="-1" name="美帆" text="『诶，居然被拒绝了！？』"   voices=""/><char @l="3253" id="rei" pos="right" src="rei034"/><msg @l="3255" char_id="1" frame_id="-1" name="玲" text="『怎么了？这么意外吗？』"   voices=""/><char @l="3258" id="miho" pos="left" src="miho136"/><msg @l="3260" char_id="0" frame_id="-1" name="美帆" text="『与其说意外……该怎么说呢。』"   voices=""/><msg @l="3262" char_id="0" frame_id="-1" name="美帆"   text="『玲学姐又聪明又漂亮……身材也很好。』" voices=""/><msg @l="3264" char_id="0" frame_id="-1" name="美帆" text="『想不通为什么会被拒绝呢。』"   voices=""/><char @l="3267" id="rei" pos="right" src="rei030"/><msg @l="3269" char_id="1" frame_id="-1" name="玲"   text="『哎呀，这正是我想问的呢。』" voices=""/><msg @l="3271" char_id="1" frame_id="-1" name="玲"   text="『据说他每天都在拒绝别人的告白呢？』" voices=""/><char @l="3274" id="miho" pos="left" src="miho034"/><msg @l="3276" char_id="0" frame_id="-1" name="美帆" text="『是这样吗？』"   voices=""/><msg @l="3278" char_id="1" frame_id="-1" name="玲" text="『真假当然不得而知。』"   voices=""/><msg @l="3280" char_id="1" frame_id="-1" name="玲"   text="『毕竟传闻说他心里已经有了喜欢的人，或者父母已经给他定了婚约者之类的。』" voices=""/><char @l="3283" id="miho" pos="left" src="miho036"/><msg @l="3285" char_id="0" frame_id="-1" name="美帆" text="『啊哈哈……』" voices=""/><msg @l="3287" char_id="1" frame_id="-1" name="玲"   text="『无论如何，只要他还是单身，就还有机会。』" voices=""/><char @l="3290" id="rei" pos="right" src="rei031"/><msg @l="3292" char_id="1" frame_id="-1" name="玲"   text="『反而，从现在开始才是作为女人真正的较量呢。』" voices=""/><msg @l="3294" char_id="0" frame_id="-1" name="美帆" text="『玲学姐……真坚强啊。』"   voices=""/><msg @l="3296" char_id="1" frame_id="-1" name="玲"   text="『呵呵，我就当作是夸奖收下了。』" voices=""/><msg @l="3298" char_id="-1" frame_id="-1" name=""   text="说完，玲学姐微微一笑，一口气喝完了杯子里的饮料。" voices=""/><msg @l="3299" char_id="-1" frame_id="-1" name=""   text="而我这个怕烫的人……只能慢悠悠地等着杯中的饮料冷却下来。" voices=""/><label @l="3302" id="TempLabel_205"/><label @l="3306" id="TempLabel_203"/><stopbgm @l="3311" fadeout="1000"/><clear @l="3317" class="all"/><call @l="3322" target="EventLabel_29@common_root04"/><return @l="3323" value="0&#13;&#10;"/></code></xscript>																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																								