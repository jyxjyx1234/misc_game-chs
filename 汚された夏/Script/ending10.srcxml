<?xml version="1.0" encoding="utf-8"?>
<xscript>
	<debug editor="&quot;C:\Program&#32;Files&#32;(x86)\sakura\sakura.exe&quot;&#32;&quot;%src%&quot;&#32;-Y=%line%"
	   src="D:\シロップ\町ぐるみの罠＋汚された夏セット版\汚された夏\完成データ\汚された夏\script\text\ending10.txt"/>
	<code>
		<label @l="12" id="EventLabel_48"/>
		<description @l="16" text="研究室のペット"/>
		<eval @l="18" expr="f.numDay=0&#13;&#10;"/>
		<msgshow @l="20" show="true"/>
		<bgm @l="26" src="bgm03" volume="1."/>
		<msg @l="28" char_id="-1" frame_id="-1" name=""
		   text="教授室で白濁まみれになるまで輪姦された後――" voices=""/>
		<msg @l="29" char_id="-1" frame_id="-1" name=""
		   text="美帆はその時撮られた写真を元に犯した学生達に毎日呼び出され身体を求められるようになった。" voices=""/>
		<wait_chgmv/>
		<bg @l="32" src="bg15a"/>
		<char @l="34" id="miho" pos="center" src="miho105f" y="-80"/>
		<msg @l="35" char_id="-1" frame_id="-1" name="" text="トイレに呼び出されて犯され――"
		   voices=""/>
		<wait_chgmv/>
		<bg @l="38" src="bg09b"/>
		<msg @l="39" char_id="-1" frame_id="-1" name="" text="図書室の書庫でフェラさせられ――"
		   voices=""/>
		<wait_chgmv/>
		<bg @l="42" src="bg08a"/>
		<msg @l="43" char_id="-1" frame_id="-1" name=""
		   text="バイブを入れさせたまま授業を受けさせられ――" voices=""/>
		<wait_chgmv/>
		<bg @l="45" src="bg07b"/>
		<msg @l="46" char_id="-1" frame_id="-1" name="" text="美帆は大学内のあらゆるところで嬲られた。"
		   voices=""/>
		<wait_chgmv/>
		<bg @l="48" src="bg09c"/>
		<msg @l="49" char_id="-1" frame_id="-1" name=""
		   text="さらに学生達は美帆に下着を着けさせない上凄く短いスカートを履くように命令したり、透ける服を着せるなど過激な服装をさせることまで強要し始めた。"
		   voices=""/>
		<wait_chgmv/>
		<bg @l="52" src="black"/>
		<clear @l="54" class="char"/>
		<char @l="56" id="miho" pos="auto" src="miho105"/>
		<msg @l="58" char_id="-1" frame_id="-1" name=""
		   text="そのうち今まではあまり目立たなかった美帆が男子学生の間で“犯せる”と話題になり、脅して犯す男子学生が日増しに増えていく。"
		   voices=""/>
		<msg @l="59" char_id="-1" frame_id="-1" name=""
		   text="元々顔もかわいいし体つきもかなり良いので注目され始めると、大学内で知らない人がいなくなる位広まっていった――" voices=""/>
		<clear @l="67" class="all"/>
		<wait_chgmv/>
		<bg @l="70" src="bg12b"/>
		<msg @l="72" char_id="-1" frame_id="-1" name=""
		   text="するとそれまで美帆が凌辱されるのを黙って見ていた朽木教授が、急に美帆を自分の研究室に研究助手として配属させる。" voices=""/>
		<msg @l="73" char_id="-1" frame_id="-1" name=""
		   text="実際は美帆を朽木研究室専用の慰み者用ペットとする為だった。" voices=""/>
		<msg @l="74" char_id="-1" frame_id="-1" name=""
		   text="実は各研究室には一人ずつ専用ペットが置く制度があり、そのペットは研究室に所属している生徒が良い成績を修めると自由に出来る。"
		   voices=""/>
		<msg @l="75" char_id="-1" frame_id="-1" name=""
		   text="つまりそのペットの人気が高いと優秀な学生がその研究室に集まり評価が高まる、という学生と研究室それぞれに相乗効果をもたらす為に作られた制度だったのだ。"
		   voices=""/>
		<msg @l="76" char_id="-1" frame_id="-1" name=""
		   text="そうして各研究室が競い合い優秀な生徒を増やす事が、この大学そのものの評価を上げることにも繋がる。" voices=""/>
		<wait_chgmv/>
		<bg @l="79" src="bg23a"/>
		<stopbgm @l="81" fadeout="1000"/>
		<msg @l="83" char_id="-1" frame_id="-1" name=""
		   text="これは南総町で進められていた計画‥‥町全体を巨大な性欲処理場に変えそれを餌に繁栄させるというものだった。" voices=""/>
		<msg @l="84" char_id="-1" frame_id="-1" name=""
		   text="企業の社員及び多額のお金を払って引っ越してきた人は無料で性的サービスが受けられるようになっていたが、大学に通う学生には適用されていなかった。"
		   voices=""/>
		<msg @l="85" char_id="-1" frame_id="-1" name=""
		   text="だが町としては大学の知名度を上げることが経済発展に繋がるので、性欲処理場という制度を有効に使い、優秀な学生を育てる仕組みを作った――それが“ペット”のシステムだった。"
		   voices=""/>
		<msg @l="88" char_id="-1" frame_id="-1" name=""
		   text="････そうして美帆も町の仕組みに組み込まれたのである････" voices=""/>
		<msg @l="92" char_id="-1" frame_id="-1" name="" text="―――そして数週間後。" voices=""/>
		<clear @l="99" class="all"/>
		<msgshow @l="102" show="true"/>
		<bgm @l="105" src="bgm14" volume="1."/>
		<wait_chgmv/>
		<bg @l="109" src="bg09a"/>
		<se @l="113" buf="1" src="ノック" volume="1."/>
		<msg @l="115" char_id="-1" frame_id="-1" name="学生Ａ" text="『‥‥‥‥。』" voices=""/>
		<msg @l="117" char_id="-1" frame_id="-1" name="学生Ｂ" text="『‥‥‥‥。』" voices=""/>
		<msg @l="119" char_id="-1" frame_id="-1" name=""
		   text="二人の男子学生が、朽木教授の部屋の扉をノックする。" voices=""/>
		<msg @l="121" char_id="-1" frame_id="-1" name="声" text="『入りたまえ。』" voices=""/>
		<msg @l="123" char_id="-1" frame_id="-1" name="学生たち" text="『失礼します。』"
		   voices=""/>
		<clear @l="129" class="all"/>
		<label @l="132" id="event_scene25"/>
		<msg @l="135" char_id="-1" frame_id="-1" name="学生" text="『お、いたいた‥‥。』"
		   voices=""/>
		<msg @l="137" char_id="-1" frame_id="-1" name=""
		   text="教授室へ入ってすぐ、男子学生は鼻腔をくすぐるような甘い「女の匂い」を発している“ペット”を見つける。" voices=""/>
		<msg @l="139" char_id="-1" frame_id="-1" name="学生"
		   text="『いい子にしていたかなー、メス犬ちゃん。君に会うために勉強頑張ったんだよ。』" voices=""/>
		<msg @l="141" char_id="-1" frame_id="-1" name="朽木" text="『ふふっ、今日は君たちかね。』"
		   voices=""/>
		<msg @l="143" char_id="-1" frame_id="-1" name="学生"
		   text="『ええ、昨日の試験で“Ａ”を取ったので“ペット”で遊んでいいですよね。』" voices=""/>
		<msg @l="145" char_id="-1" frame_id="-1" name="朽木"
		   text="『ああ、たっぷっり嬲ってやりたまえ。丁度今躾をしてる途中で浣腸をしてやった所だよ。』" voices=""/>
		<msg @l="147" char_id="-1" frame_id="-1" name="学生"
		   text="『ほんとっすか！俺ア●ル苛めるの大好きなんスよ。』" voices=""/>
		<msg @l="149" char_id="-1" frame_id="-1" name=""
		   text="そう言って二人の学生は部屋の隅でうずくまってお尻を振って悶えている「ペット」を見る。" voices=""/>
		<label @l="153" id="chart_line52"/>
		<wait_chgmv/>
		<ev @l="157" src="ev-025"/>
		<bgm @l="161" src="bgm14" volume="1."/>
		<msg @l="163" char_id="0" frame_id="-1" name="美帆"
		   text="『んふぅ‥‥ん、んんっ‥‥‥‥‥ん、んくっっ。』" voices="miho12070"/>
		<msg @l="165" char_id="-1" frame_id="-1" name=""
		   text="部屋の隅に繋がれた一匹のメス犬――それは朽木研究室の研究助手として配属された仲根美帆だった。" voices=""/>
		<msg @l="166" char_id="-1" frame_id="-1" name=""
		   text="美帆は革のベルトで全身を縛りあげる拘束衣を着けられ、瑞々しい肌を圧迫するように乳房を絞り出されていた。手首も後ろ側で拘束される為一切の抵抗が出来ないようになって被虐感を増している。"
		   voices=""/>
		<msg @l="168" char_id="0" frame_id="-1" name="美帆"
		   text="『んっ、んんっ‥‥‥‥んふぅ‥‥‥‥‥。』" voices="miho12080"/>
		<msg @l="170" char_id="-1" frame_id="-1" name=""
		   text="美帆が浣腸され便意をもよおしたお尻を振って何か言いたげな感じで切なげな声を漏らす。" voices=""/>
		<msg @l="171" char_id="-1" frame_id="-1" name=""
		   text="だがその口にはセシュター（玉付口枷）が着けられ言葉をしゃべることも許されず、よだれを垂れ流すだけだった。" voices=""/>
		<msg @l="173" char_id="-1" frame_id="-1" name="学生"
		   text="『へへっ、いやらしくお尻をふりやがって。そんなにアヌ●を弄って欲しければたっぷり可愛がってやるよ。』" voices=""/>
		<msg @l="175" char_id="-1" frame_id="-1" name=""
		   text="学生はそう言うと、浣腸した後栓をする為アヌ●に突き立てられている尻尾を掴んで責めるように動かし始める。" voices=""/>
		<msg @l="177" char_id="0" frame_id="-1" name="美帆"
		   text="『んぅっ‥‥‥ん、んぁぁっ‥‥‥‥‥。』" voices="miho12090"/>
		<msg @l="179" char_id="-1" frame_id="-1" name="学生"
		   text="『ここが気持ちいいかよっ、メス犬が！』" voices=""/>
		<msg @l="181" char_id="-1" frame_id="-1" name=""
		   text="学生が嬉しそうにアヌ●を責め立てると、美帆はどんどん便意がもよおして来て苦しそうに声を上げる。" voices=""/>
		<msg @l="183" char_id="0" frame_id="-1" name="美帆"
		   text="『んふぅ‥‥ん、んんっ‥‥‥‥‥ん、んくっっ。』" voices="miho12070"/>
		<msg @l="185" char_id="-1" frame_id="-1" name=""
		   text="しかし、尻尾の栓をされている為排泄する事も漏らす事も許されないので、美帆は苦悶の表情で身を捩る。" voices=""/>
		<msg @l="187" char_id="-1" frame_id="-1" name="朽木"
		   text="『ふふっ、相変わらずいやらしい身体だな美帆君。アヌ●を責められてこんなにも乳首を立たせるなんて。』" voices=""/>
		<msg @l="189" char_id="-1" frame_id="-1" name=""
		   text="朽木は隆起して敏感になっている乳首をつまみ上げ嬉しそうに言う。" voices=""/>
		<msg @l="191" char_id="0" frame_id="-1" name="美帆"
		   text="『んふぅ‥‥ん、んんっ‥‥‥‥‥ん、んくっっ。』" voices="miho12070"/>
		<msg @l="193" char_id="-1" frame_id="-1" name="学生"
		   text="『朽木教授、もうやっちゃってイイっスよね。』" voices=""/>
		<msg @l="195" char_id="-1" frame_id="-1" name="朽木"
		   text="『もちろんだ。今日一日は君の好きなように嬲るといい。浣腸好きな君の為にたっぷりとグリセリン溶液も用意してあるからね。』"
		   voices=""/>
		<msg @l="197" char_id="-1" frame_id="-1" name=""
		   text="朽木の言葉に従い、学生が嬉々とした表情を見せる。" voices=""/>
		<msg @l="199" char_id="-1" frame_id="-1" name="学生"
		   text="『ホントっすか！じゃあまずマ●コにぶち込んで一発抜いてからアヌスにもぶち込んでやるよ。』" voices=""/>
		<msg @l="201" char_id="-1" frame_id="-1" name=""
		   text="学生は楽しげな表情でそう言って、ズボンのチャックを下ろして硬く張り詰めた肉棒を曝け出す。" voices=""/>
		<msg @l="203" char_id="0" frame_id="-1" name="美帆"
		   text="『んふっ‥‥‥んっ、んんっ‥‥‥‥‥。』" voices="miho12100"/>
		<msg @l="205" char_id="-1" frame_id="-1" name=""
		   text="彼らの怒張した男根を見ると、メス犬は弱々しく身体を震わせる。" voices=""/>
		<msg @l="207" char_id="-1" frame_id="-1" name="学生"
		   text="『さーて、俺の肉マラをたっぷりと味わいな。』" voices=""/>
		<msg @l="209" char_id="0" frame_id="-1" name="美帆" text="『ん、んんっ‥‥。』"
		   voices="miho12110"/>
		<msg @l="211" char_id="-1" frame_id="-1" name=""
		   text="学生は美帆の細腰を掴み、肉砲を肉裂にあてがいずぶずぶと埋め込んでいく。" voices=""/>
		<msg @l="212" char_id="-1" frame_id="-1" name=""
		   text="その挿入される感覚に美帆はビクッとお尻を震わせる。今は何をされてもその振動が下腹部の排泄欲のうねりに響くのであった。"
		   voices=""/>
		<msg @l="214" char_id="0" frame_id="-1" name="美帆"
		   text="『んふぅ‥‥ん、んんっ‥‥‥‥‥ん、んくっっ。』" voices="miho12070"/>
		<msg @l="216" char_id="-1" frame_id="-1" name="学生"
		   text="『おお、相変わらずきっついな‥‥オマエのここは。』" voices=""/>
		<msg @l="218" char_id="0" frame_id="-1" name="美帆"
		   text="『んんっ‥‥‥んっ、ふ、んむぅっ‥‥‥‥‥。』" voices="miho12120"/>
		<msg @l="220" char_id="-1" frame_id="-1" name=""
		   text="美帆は性器を咥えた瞬間から、ひときわ高い声を出し身体を硬直させたようにピンとさせる。しかし、学生は美帆の反応を楽しむかのように肉棒を充血した秘部の奥へと突き入れる。"
		   voices=""/>
		<msg @l="222" char_id="0" frame_id="-1" name="美帆"
		   text="『んぅっ‥‥‥ん、んぁぁっ‥‥‥‥‥。』" voices="miho12090"/>
		<msg @l="224" char_id="-1" frame_id="-1" name="学生Ａ"
		   text="『ほら、もっとケツを振ってマ○コを締め付けないといつまでもウ●コさせてやらないぞ。』" voices=""/>
		<msg @l="226" char_id="-1" frame_id="-1" name=""
		   text="学生はアヌ●に突き立てられた尻尾型のアナルストッパーを手で乱暴に掻き回しながらピストン運動を続ける。美帆はアヌ●と秘裂を同時に激しく嬲られ、込みあがる便意で目がチカチカするほどおかしくなっていた。"
		   voices=""/>
		<msg @l="228" char_id="0" frame_id="-1" name="美帆"
		   text="『ん、んあっ‥‥‥ん‥‥‥‥んふっ‥‥‥くぅっ‥‥‥‥‥。』" voices="miho12130"/>
		<msg @l="229" char_id="-1" frame_id="-1" name="学生"
		   text="『おおっ、良い締りだ。もうすぐ、もうすぐ出すぞ！』" voices=""/>
		<msg @l="231" char_id="0" frame_id="-1" name="美帆" text="『ん、んんっ‥‥。』"
		   voices="miho12110"/>
		<msg @l="233" char_id="-1" frame_id="-1" name=""
		   text="学生は再び腰を掴みスパートをかける。すると秘裂の中に進入している肉棒が吸い付くような膣肉をゴリゴリと摩擦し、カリのエラで蜜汁を秘口へとかきだされぐちゅぐちゅという音が室内に響きわたる。"
		   voices=""/>
		<msg @l="234" char_id="-1" frame_id="-1" name=""
		   text="美帆は激しい抽送に脳天まで衝撃が走り、くびりだされた乳房をプルプルとゆらして裸体を激しく弾ませる。" voices=""/>
		<msg @l="236" char_id="0" frame_id="-1" name="美帆"
		   text="『んっ、んんっ‥‥‥んっ‥‥‥‥んふぅっ‥‥‥‥‥。』" voices="miho12140"/>
		<msg @l="238" char_id="-1" frame_id="-1" name=""
		   text="学生は射精をぎりぎりまで我慢していたが、美帆の絡みつく肉壁と締め付けに限界を超えた快楽を感じついに白濁液を噴射させる。"
		   voices=""/>
		<msg @l="240" char_id="-1" frame_id="-1" name="学生"
		   text="『お、身体に身体中にぶっかけてやる！おお、おおうっ！』" voices=""/>
		<msg @l="242" char_id="0" frame_id="-1" name="美帆"
		   text="『ん、んあっ‥‥‥ん‥‥‥‥んふっ‥‥‥くぅっ‥‥‥‥‥。』" voices="miho12130"/>
		<flash @l="245" count="4" fade="100" image="white"/>
		<msg @l="247" char_id="0" frame_id="-1" name="美帆" text="『ん、んんっ‥‥。』"
		   voices="miho12110"/>
		<wait_chgmv/>
		<ev @l="251" src="ev-025z1"/>
		<msg @l="253" char_id="-1" frame_id="-1" name="" text="どぴゅぴゅぴゅぴゅぴゅぴゅぴゅぴゅ！"
		   voices=""/>
		<msg @l="255" char_id="-1" frame_id="-1" name=""
		   text="いつ止まるともしれない大量の精液が美帆のピンク色に染まった身体中に注がれ白濁色に染め直す。" voices=""/>
		<msg @l="256" char_id="-1" frame_id="-1" name=""
		   text="美帆は目を白黒させ、今まで感じた事のないようなオルガスムスを感じていた。" voices=""/>
		<msg @l="257" char_id="0" frame_id="-1" name="美帆"
		   text="『んぅっ‥‥‥ん、んぁぁっ‥‥‥‥‥。』" voices="miho12090"/>
		<msg @l="258" char_id="0" frame_id="-1" name="美帆" text="『んっ‥‥。』"
		   voices="miho12150"/>
		<msg @l="260" char_id="-1" frame_id="-1" name=""
		   text="学生は目もうつろになり放心状態にある美帆に近づき、おもむろに尻尾型のアナルストッパーを抜く。" voices=""/>
		<clear @l="266" class="all"/>
		<msg @l="268" char_id="0" frame_id="-1" name="美帆" text="『ん、んんっ‥‥。』"
		   voices="miho12110"/>
		<msg @l="270" char_id="-1" frame_id="-1" name="学生"
		   text="『へへっ、さぁ思う存分ウン●を撒き散らしな。』" voices=""/>
		<msg @l="272" char_id="0" frame_id="-1" name="美帆"
		   text="『んっ、んんっ‥‥‥んっ‥‥‥‥んふぅっ‥‥‥‥‥。』" voices="miho12140"/>
		<msg @l="274" char_id="-1" frame_id="-1" name=""
		   text="学生の言葉に美帆は羞恥に顔を歪ませ哀願の表情になる。しかし学生はそれを無視しギラギラした目で肛門を視姦する。" voices=""/>
		<msg @l="275" char_id="-1" frame_id="-1" name=""
		   text="美帆は排泄を見られまいと必死に我慢するが、学生はニヤリと笑うと下腹部に強い衝撃を与えた。" voices=""/>
		<msg @l="276" char_id="-1" frame_id="-1" name=""
		   text="すると、ピンクの菊の皺が伸びきって肛門が隆起し、悪臭を放ちながら噴射が始まる。" voices=""/>
		<msg @l="278" char_id="0" frame_id="-1" name="美帆"
		   text="『ん、んあっ‥‥‥ん‥‥‥‥んふっ‥‥‥くぅっ‥‥‥‥‥。』" voices="miho12130"/>
		<msg @l="279" char_id="0" frame_id="-1" name="美帆"
		   text="『んぅっ‥‥‥ん、んぁぁっ‥‥‥‥‥。』" voices="miho12090"/>
		<msg @l="280" char_id="0" frame_id="-1" name="美帆" text="『んんっっ！』"
		   voices="miho10930"/>
		<msg @l="281" char_id="0" frame_id="-1" name="美帆" text="『んん――――っ！！』"
		   voices="miho11030"/>
		<msg @l="283" char_id="-1" frame_id="-1" name="" text="ブビュルルルルルルルルルルルルル！"
		   voices=""/>
		<msg @l="285" char_id="-1" frame_id="-1" name=""
		   text="美帆はその瞬間気が狂ったかのような嗚咽をもらしながら、悪臭を放つ淫魔を逆流させる。" voices=""/>
		<msg @l="286" char_id="-1" frame_id="-1" name=""
		   text="そして逆流が終わると気が遠くなり身体から力が抜けていくのを感じた。" voices=""/>
		<msg @l="288" char_id="-1" frame_id="-1" name=""
		   text="しかし、学生は排泄行為に興奮し加虐欲を高めると、バケツに入れた水を持ってきて美帆のアヌスを洗いながら嬉しそうに言うのだった。"
		   voices=""/>
		<msg @l="290" char_id="-1" frame_id="-1" name="学生"
		   text="『さぁ、アヌスに入れてまたヒィヒィ言わせてやるぜ。』" voices=""/>
		<msg @l="292" char_id="-1" frame_id="-1" name=""
		   text="朽木教授は“研究室の宝である美帆”が調教されるその光景を嬉しそうに眺めているのであった――。" voices=""/>
		<stopbgm @l="296" fadeout="1000"/>
		<clear @l="302" class="all"/>
		<end_scene @l="305"/>
		<eval @l="309" expr="s.flagGallery=1&#13;&#10;"/>
		<eval @l="311" expr="s.event25flag=1&#13;&#10;"/>
		<eval @l="315"
		   expr="f.bEx&#32;=&#32;s.event20flag&#32;&amp;&amp;&#32;s.event23flag&#32;&amp;&amp;&#32;s.event25flag&#32;&amp;&amp;&#32;s.event30flag&#32;&amp;&amp;&#32;s.event31flag&#32;&amp;&amp;&#32;s.event32flag&#32;&amp;&amp;&#32;s.event33flag&#32;&amp;&amp;&#32;s.event35flag&#32;&amp;&amp;&#32;s.event37flag&#32;&amp;&amp;&#32;s.event38flag&#32;&amp;&amp;&#32;s.event60flag&#13;&#10;"/>
		<goto @l="317" cond="!(f.bEx)&#13;&#10;" label="TempLabel_196"/>
		<eval @l="319" expr="s.exRootFlag=1&#13;&#10;"/>
		<label @l="320" id="TempLabel_196"/>
		<ending @l="322"/>
		<goto @l="324" cond="!(f.bEx)&#13;&#10;" label="TempLabel_197"/>
		<wait_chgmv/>
		<bg @l="328" src="newroot"/>
		<wait @l="330" time="5000"/>
		<wait_chgmv/>
		<bg @l="332" src="black"/>
		<label @l="335" id="TempLabel_197"/>
		<return @l="339" value=""/>
	</code>
</xscript>
