<?xml version="1.0" encoding="utf-8"?>
<xscript>
	<debug editor="&quot;C:\Program&#32;Files&#32;(x86)\sakura\sakura.exe&quot;&#32;&quot;%src%&quot;&#32;-Y=%line%"
	   src="D:\シロップ\町ぐるみの罠＋汚された夏セット版\汚された夏\完成データ\汚された夏\script\text\ending12.txt"/>
	<code>
		<label @l="12" id="EventLabel_50"/>
		<description @l="16" text="テニス部共用ペット"/>
		<eval @l="18" expr="f.numDay=0&#13;&#10;"/>
		<label @l="21" id="event_scene75"/>
		<wait_chgmv/>
		<bg @l="25" src="bg13m1"/>
		<bgm @l="29" src="bgm03" volume="1."/>
		<char @l="33" id="miho" pos="auto" src="miho050"/>
		<msg @l="35" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』"
		   voices="miho12270"/>
		<msg @l="37" char_id="-1" frame_id="-1" name="" text="―――数週間後。" voices=""/>
		<msg @l="38" char_id="-1" frame_id="-1" name="" text="私は今日もテニスコートを訪れていた。"
		   voices=""/>
		<msg @l="39" char_id="-1" frame_id="-1" name=""
		   text="あれから私は、ほぼ毎日のようにテニスサークルの活動に参加している。" voices=""/>
		<msg @l="40" char_id="-1" frame_id="-1" name="" text="最初は脅迫めいた呼び出しにすぎなかった。"
		   voices=""/>
		<msg @l="41" char_id="-1" frame_id="-1" name=""
		   text="男子会員の面々に犯された私は、その時の事実を公表されたくなければという名目で、翌日もその翌々日も部室に呼びつけられて輪姦された。"
		   voices=""/>
		<msg @l="42" char_id="-1" frame_id="-1" name=""
		   text="そのたびに私は深い絶頂を身体に刻み付けられ‥‥また、身体のいたる所を凌辱され汚された。" voices=""/>
		<msg @l="43" char_id="-1" frame_id="-1" name="" text="もう‥‥どうでもよくなっていた。"
		   voices=""/>
		<msg @l="44" char_id="-1" frame_id="-1" name="" text="身体に与えられる悦楽が。"
		   voices=""/>
		<msg @l="45" char_id="-1" frame_id="-1" name="" text="心に与えられる絶望が。" voices=""/>
		<msg @l="46" char_id="-1" frame_id="-1" name="" text="私の全てを麻痺させてしまっている。"
		   voices=""/>
		<msg @l="48" char_id="-1" frame_id="-1" name="男子会員"
		   text="『よお、今日もちゃんと来たみたいだなヒヒヒヒ‥‥。』" voices=""/>
		<char @l="52" id="miho" pos="auto" src="miho053"/>
		<msg @l="54" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』"
		   voices="miho12280"/>
		<msg @l="56" char_id="-1" frame_id="-1" name="男子会員"
		   text="『ククククク‥‥んで？&#32;命令は守ってきたんだろうな？』" voices=""/>
		<msg @l="58" char_id="0" frame_id="-1" name="美帆" text="『ちゃんと‥‥守ってます。』"
		   voices="miho12290"/>
		<msg @l="60" char_id="-1" frame_id="-1" name="" text="そう言って私はわずかに太腿を摺り寄せる。"
		   voices=""/>
		<stopbgm @l="64" fadeout="1000"/>
		<clear @l="70" class="all"/>
		<msgshow @l="72" show="true"/>
		<label @l="75" id="chart_line63"/>
		<wait_chgmv/>
		<ev @l="79" src="ev-043y1y2y3z1"/>
		<bgm @l="83" src="bgm14" volume="1."/>
		<msg @l="85" char_id="-1" frame_id="-1" name="" text="私の秘部にはバイブが挿入されていた。"
		   voices=""/>
		<msg @l="86" char_id="-1" frame_id="-1" name=""
		   text="そうして挿入したバイブの上から下着を履き‥‥ここまできたのだ。" voices=""/>
		<msg @l="87" char_id="-1" frame_id="-1" name=""
		   text="大勢の人たちが行き来する所を、何もなかったかのように‥‥。" voices=""/>
		<msg @l="89" char_id="-1" frame_id="-1" name="男子会員"
		   text="『本当に命令を守っているかどうか確かめてやろうヒヒヒヒヒ。』" voices=""/>
		<msg @l="91" char_id="-1" frame_id="-1" name=""
		   text="そう言って昨日、私にバイブを手渡した男子サークル員の彼がポケットの中に手を入れて何やらゴソゴソと弄る。" voices=""/>
		<msg @l="92" char_id="-1" frame_id="-1" name="" text="次の瞬間。" voices=""/>
		<msg @l="93" char_id="-1" frame_id="-1" name="" text="ヴヴヴヴヴヴヴヴヴヴヴヴヴヴッ‥‥。"
		   voices=""/>
		<msg @l="95" char_id="0" frame_id="-1" name="美帆" text="『んっ‥‥。』"
		   voices="miho12300"/>
		<msg @l="97" char_id="-1" frame_id="-1" name=""
		   text="私の秘部を押し広げているバイブが低い音を立てて振動を始める。" voices=""/>
		<msg @l="98" char_id="-1" frame_id="-1" name=""
		   text="彼がポケットの中に潜ませていたバイブのスイッチを入れたのだ。" voices=""/>
		<msg @l="103" char_id="0" frame_id="-1" name="美帆" text="『あ、ああっ‥‥。』"
		   voices="miho12310"/>
		<msg @l="105" char_id="-1" frame_id="-1" name=""
		   text="バイブの振動によって奥に溜まっていた蜜が溢れ出してくる。" voices=""/>
		<msg @l="106" char_id="-1" frame_id="-1" name=""
		   text="白昼堂々とバイブを挿入して歩いているという背徳感だけで、私の胎内は既にドロドロになってしまっていた。" voices=""/>
		<msg @l="107" char_id="-1" frame_id="-1" name=""
		   text="テニスコートのあちこちでは、バイブのスイッチを持っている彼と同じように、にやけた笑みを浮かべて見つめている男子部員の姿が見られる。"
		   voices=""/>
		<msg @l="108" char_id="-1" frame_id="-1" name=""
		   text="‥‥そして、侮蔑と軽蔑の表情を浮かべた女性部員たち。" voices=""/>
		<msg @l="110" char_id="0" frame_id="-1" name="美帆"
		   text="『ああっ‥‥‥‥いっぱい、溢れてきちゃいます。』" voices="miho12320"/>
		<msg @l="112" char_id="-1" frame_id="-1" name="男子会員" text="『ふーん。』" voices=""/>
		<msg @l="114" char_id="-1" frame_id="-1" name="男子会員"
		   text="『でも、そのままじゃ本当にバイブが入ってるのか解らないなー、クククク。』" voices=""/>
		<msg @l="116" char_id="0" frame_id="-1" name="美帆" text="『そんな‥‥本当に入っています。』"
		   voices="miho12330"/>
		<msg @l="118" char_id="-1" frame_id="-1" name="男子会員"
		   text="『ヒヒヒヒ、お前が嘘を吐いていないという証拠は何処にもない。違うか？』" voices=""/>
		<msg @l="120" char_id="0" frame_id="-1" name="美帆" text="『それは‥‥。』"
		   voices="miho12340"/>
		<msg @l="122" char_id="-1" frame_id="-1" name="" text="ヴヴヴヴヴヴヴヴヴヴヴヴヴヴッ‥‥。"
		   voices=""/>
		<msg @l="123" char_id="-1" frame_id="-1" name=""
		   text="私たちの交わす会話の合間にもバイブは低い音を立てて振動している。" voices=""/>
		<msg @l="124" char_id="-1" frame_id="-1" name=""
		   text="無論、彼にその振動音が届いていないハズがない。" voices=""/>
		<msg @l="126" char_id="-1" frame_id="-1" name="男子会員"
		   text="『じゃあそこでスカートを捲り上げて、パンツも脱いでマ○コに刺さったバイブを見せてみな。』" voices=""/>
		<msg @l="128" char_id="0" frame_id="-1" name="美帆" text="『そんな‥‥‥。』"
		   voices="miho10060"/>
		<msg @l="130" char_id="-1" frame_id="-1" name=""
		   text="男子会員達のいう事に従順になったとはいえ、女子会員に見せるのはやはり恥ずかしいし、さらに今はサークルの人以外の人もコート外から見てるので流石に“はい”とは言えなかった。"
		   voices=""/>
		<msg @l="132" char_id="-1" frame_id="-1" name="男子会員"
		   text="『なんだ、反抗的だなー。まぁいいや。それなら今から特打ち100球の特訓に耐えられたら、バイブ入れているところを見せなくても信じてやるよ。』"
		   voices=""/>
		<msg @l="134" char_id="-1" frame_id="-1" name=""
		   text="男子会員はニヤリと笑いながら妥協案を出してきた。" voices=""/>
		<msg @l="136" char_id="0" frame_id="-1" name="美帆" text="『え‥‥‥。』"
		   voices="miho10200"/>
		<msg @l="138" char_id="-1" frame_id="-1" name=""
		   text="美帆は男子会員の言葉に表情を曇らせる。それもそのはずで、バイブを入れているのでただ立っているだけでも刺激が辛いのに、このままで練習をしてしまったらどうなってしまうか分からない。"
		   voices=""/>
		<msg @l="140" char_id="-1" frame_id="-1" name="男子会員"
		   text="『なんだよー。どっちも嫌だって言うんじゃねぇだろーなー。それなら今ココで輪姦（まわ）すぞ。』" voices=""/>
		<msg @l="142" char_id="-1" frame_id="-1" name=""
		   text="男はそう言って軽く手を上げると、練習をしていた男子部員の何人かがそれに気付いてこちらに向かって歩いてくる。" voices=""/>
		<msg @l="144" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』"
		   voices="miho12350"/>
		<msg @l="146" char_id="-1" frame_id="-1" name="男子会員" text="『どうするんだよ。やるのかよ？』"
		   voices=""/>
		<msg @l="148" char_id="-1" frame_id="-1" name=""
		   text="美帆は僅かに逡巡した後、切なげな表情を浮かべ頷くのだった。" voices=""/>
		<msg @l="150" char_id="0" frame_id="-1" name="美帆" text="『‥‥はい。』"
		   voices="miho12360"/>
		<clear @l="156" class="all"/>
		<msgshow @l="158" show="true"/>
		<wait_chgmv/>
		<ev @l="160" src="ev-043y1y2y3z1"/>
		<msg @l="162" char_id="-1" frame_id="-1" name="男子会員"
		   text="『おらー！ボールに追いついてねぇぞー！！早く追いかけろよー！！』" voices=""/>
		<msg @l="164" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥っ‥‥‥。』"
		   voices="miho09930"/>
		<msg @l="166" char_id="-1" frame_id="-1"
		   name="男子会員は美帆を走らせるように、ボールを取れそうで取れないところに打つ。"
		   text="美帆も一生懸命追うが、やはりバイブを付けているのでボールに集中できず、打ち返すどころかボールに追いつく事も出来ない。"
		   voices=""/>
		<msg @l="168" char_id="-1" frame_id="-1" name="男子会員" text="『ほらほら！左だよ左――！！！』"
		   voices=""/>
		<msg @l="170" char_id="0" frame_id="-1" name="美帆" text="『‥‥！？』"
		   voices="miho10040"/>
		<msg @l="172" char_id="-1" frame_id="-1" name="男子会員" text="『今度は右だよ右――！！！』"
		   voices=""/>
		<msg @l="174" char_id="0" frame_id="-1" name="美帆" text="『んくっ‥‥。』"
		   voices="miho09910"/>
		<msg @l="176" char_id="-1" frame_id="-1" name="男子会員"
		   text="『ほらっ、前だ前――！一球も取れてねぇぞ――！！！』" voices=""/>
		<msg @l="178" char_id="0" frame_id="-1" name="美帆" text="『ん、あくっ‥‥。』"
		   voices="miho09920"/>
		<msg @l="180" char_id="-1" frame_id="-1" name=""
		   text="そうして美帆がボールを追っていると、バイブを入れている秘裂から水音が漏れ出す。" voices=""/>
		<msg @l="182" char_id="-1" frame_id="-1" name="" text="くちゅ" voices=""/>
		<msg @l="183" char_id="-1" frame_id="-1" name="" text="くちゅくちゅ" voices=""/>
		<msg @l="185" char_id="-1" frame_id="-1" name="男子会員"
		   text="『なんだー！オマエ練習しているくせにオマ○コ濡らしてやがるのかー！！この変態がー！！！』" voices=""/>
		<msg @l="187" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥っ‥‥‥。』"
		   voices="miho09930"/>
		<msg @l="189" char_id="-1" frame_id="-1" name="男子会員"
		   text="『ほらー！後ろにいったぞー！！これは打てよなー！！！』" voices=""/>
		<msg @l="191" char_id="-1" frame_id="-1" name=""
		   text="美帆はボールを打ち返そうと懸命に追いかける――そしてボールを捉え打とうとした瞬間･･････" voices=""/>
		<msg @l="193" char_id="-1" frame_id="-1" name=""
		   text="男子会員はニヤリと笑うと、バイブの振動を最強にした！" voices=""/>
		<msg @l="195" char_id="-1" frame_id="-1" name="" text="ブルルルルルルルルルルルルルルルルルル"
		   voices=""/>
		<msg @l="197" char_id="0" frame_id="-1" name="美帆" text="『‥‥！？』"
		   voices="miho10040"/>
		<msg @l="199" char_id="0" frame_id="-1" name="美帆" text="『んんっっ！』"
		   voices="miho09990"/>
		<flash @l="203" count="4" fade="100" image="white"/>
		<wait_chgmv/>
		<ev @l="207" src="ev-043x1y1y2y3z2"/>
		<msg @l="209" char_id="0" frame_id="-1" name="美帆" text="『んっ、ああああっ！！』"
		   voices="miho10440"/>
		<msg @l="211" char_id="-1" frame_id="-1" name=""
		   text="美帆はボールを打とうと下腹に力を入れた瞬間にバイブのスイッチを入れられたので振動をまともに感じてしまい、いってしまう･･････。"
		   voices=""/>
		<msg @l="212" char_id="-1" frame_id="-1" name="" text="そしてそのままお漏らしをしてしまった。"
		   voices=""/>
		<flash @l="216" count="4" fade="100" image="white"/>
		<msg @l="218" char_id="-1" frame_id="-1" name="" text="ぷしゃぁぁぁぁぁぁぁぁぁぁぁぁぁぁ"
		   voices=""/>
		<msg @l="220" char_id="0" frame_id="-1" name="美帆" text="『ん、あああああああっ！！』"
		   voices="miho11040"/>
		<clear @l="226" class="all"/>
		<wait_chgmv/>
		<bg @l="230" src="bg13m1"/>
		<msg @l="232" char_id="-1" frame_id="-1" name="男子会員"
		   text="『あーあ、こいついっちまった上に小便もらしやがったよ。汚ねーな。』" voices=""/>
		<msg @l="234" char_id="-1" frame_id="-1" name=""
		   text="口ではそう言いながらも、男子会員はニヤニヤと嬉しそうな笑みを浮かべて美帆に近づいてくる。" voices=""/>
		<msg @l="236" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』"
		   voices="miho09900"/>
		<msg @l="238" char_id="-1" frame_id="-1" name="男子会員"
		   text="『これじゃぁ練習は続けられねぇな。････おい、お前たち。』" voices=""/>
		<msg @l="240" char_id="-1" frame_id="-1" name=""
		   text="男はそう言うと、ギラギラした視線で美帆を見ている男子会員達を呼び寄せる。" voices=""/>
		<msg @l="241" char_id="-1" frame_id="-1" name="男子会員"
		   text="『こいつを部室に運んでくれ。練習中にお漏らしなんかしやがったから、たっぷりお仕置きしてやらねぇとな。』" voices=""/>
		<msg @l="243" char_id="-1" frame_id="-1" name=""
		   text="そうして美帆は両脇を抱えられ部室に連れて行かれる。" voices=""/>
		<msg @l="245" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』"
		   voices="miho09900"/>
		<msg @l="247" char_id="-1" frame_id="-1" name=""
		   text="連れて行かれながら、美帆の表情はどこか嬉しそうだった。" voices=""/>
		<msg @l="248" char_id="-1" frame_id="-1" name=""
		   text="今日もまた‥‥この身体に大量の精を注いでもらうのを待ち望んでいたかのように････。" voices=""/>
		<clear @l="254" class="all"/>
		<end_scene @l="257"/>
		<label @l="259" id="event_scene38"/>
		<goto @l="261" cond="!(f.flagInExtraMode&#32;&gt;&#32;100)&#13;&#10;"
		   label="TempLabel_317"/>
		<bgm @l="263" src="bgm14" volume="1."/>
		<label @l="264" id="TempLabel_317"/>
		<msgshow @l="267" show="true"/>
		<label @l="271" id="chart_line64"/>
		<msg @l="273" char_id="-1" frame_id="-1" name="" text="ビリビリビリビリビリッ"
		   voices=""/>
		<msg @l="275" char_id="0" frame_id="-1" name="美帆" text="『ひぅっ！！』"
		   voices="miho10100"/>
		<msg @l="277" char_id="-1" frame_id="-1" name=""
		   text="男子会員は美帆を部室に連れ込むと、いつも美帆を犯す時のようにテニスウェアを切り裂いた。" voices=""/>
		<msg @l="278" char_id="-1" frame_id="-1" name=""
		   text="そして美帆の秘裂に押し込まれていたバイブを乱暴に取り除く。するとバイブを取られた秘部からは淫らな水音が響いた。" voices=""/>
		<msg @l="280" char_id="-1" frame_id="-1" name="" text="ぬちゃ" voices=""/>
		<msg @l="282" char_id="0" frame_id="-1" name="美帆" text="『んんっ‥‥‥あ、あああっ‥‥‥‥。』"
		   voices="miho10330"/>
		<msg @l="284" char_id="-1" frame_id="-1" name="男子会員"
		   text="『へへっ、もう濡れ濡れだな。これなら直ぐにでも入れてやれるぜ。』" voices=""/>
		<msg @l="285" char_id="-1" frame_id="-1" name=""
		   text="そう言うと美帆の秘裂の唇を男子会員の熱く固い肉棒が貫く。" voices=""/>
		<wait_chgmv/>
		<ev @l="289" src="ev-038"/>
		<msg @l="291" char_id="0" frame_id="-1" name="美帆" text="『ああっ‥‥。』"
		   voices="miho12370"/>
		<msg @l="293" char_id="-1" frame_id="-1" name=""
		   text="男は、大きく引き裂かれるテニスウェアの上から柔らかい乳房の形を歪めるほど思い切り揉む‥‥‥。" voices=""/>
		<msg @l="295" char_id="0" frame_id="-1" name="美帆" text="『んんっっ！』"
		   voices="miho10930"/>
		<msg @l="297" char_id="-1" frame_id="-1" name="男子会員"
		   text="『そら、気絶するまでたっぷり犯してやるぜ。』" voices=""/>
		<msg @l="299" char_id="-1" frame_id="-1" name=""
		   text="会員の彼はそう言っていきなり激しく腰をたたきつける。" voices=""/>
		<msg @l="300" char_id="-1" frame_id="-1" name=""
		   text="そのたびに淫汁でグチュグチュと濡れた私の秘部からは淫猥な水音が立ち、彼のモノを奥深くまでつつみ込むように咥え込んでいく。"
		   voices=""/>
		<msg @l="301" char_id="-1" frame_id="-1" name=""
		   text="最初はテニスウェアを切り裂かれる度に恐怖を覚えたが、今は切り裂かれる事でゾクゾクと快感を覚える。" voices=""/>
		<msg @l="302" char_id="-1" frame_id="-1" name=""
		   text="彼らもまた‥‥ウェアを切り裂く度に、女を屈服させている気持ちを増幅させていた。" voices=""/>
		<msg @l="304" char_id="-1" frame_id="-1" name="男子会員"
		   text="『へへっ‥‥もうこんなに硬くしてるのかよ。』" voices=""/>
		<msg @l="306" char_id="-1" frame_id="-1" name="" text="男の手が胸に伸びる。" voices=""/>
		<msg @l="307" char_id="-1" frame_id="-1" name=""
		   text="硬く勃起した乳首をつまみ、強く引っ張られると甘い痺れが私の身体を駆け巡る。" voices=""/>
		<msg @l="309" char_id="0" frame_id="-1" name="美帆" text="『んっ‥‥あっ、あふっっ！』"
		   voices="miho12380"/>
		<msg @l="311" char_id="-1" frame_id="-1" name="男子会員"
		   text="『ヒヒヒヒヒ‥‥相変らずいい感度してんじゃねーか。』" voices=""/>
		<msg @l="313" char_id="0" frame_id="-1" name="美帆"
		   text="『ああっ‥‥んっ、んんっ‥‥‥‥‥そんなこと‥‥‥‥‥。』" voices="miho12390"/>
		<msg @l="315" char_id="-1" frame_id="-1" name="男子会員"
		   text="『何いまさら純情ぶってんだよ、オマエが淫乱なことくらいとっくにバレてんだぜ。』" voices=""/>
		<msg @l="317" char_id="-1" frame_id="-1" name=""
		   text="そうして男は秘部に手を伸ばし、淫汁でグチュグチュになった膣内をかきまわす。" voices=""/>
		<msg @l="319" char_id="0" frame_id="-1" name="美帆"
		   text="『ん、ああっ、それダメ‥‥‥んっ、んんっっ！！』" voices="miho12400"/>
		<msg @l="321" char_id="-1" frame_id="-1" name="男子会員"
		   text="『何がダメなんだよ、言ってみな。』" voices=""/>
		<msg @l="323" char_id="0" frame_id="-1" name="美帆"
		   text="『そこ、摘んだら‥‥‥‥あっ‥‥ああっ‥‥きちゃう、んんっ！！』" voices="miho12410"/>
		<msg @l="325" char_id="-1" frame_id="-1" name=""
		   text="執拗にクリ○リスを転がされるたび、私は大きく腰を震わせて何度も身体を震わせる。" voices=""/>
		<msg @l="326" char_id="-1" frame_id="-1" name=""
		   text="結合部からは大量の蜜がヂュプヂュプと溢れ出し‥‥男根に絡み付いて、テラテラと光っていた。" voices=""/>
		<msg @l="328" char_id="-1" frame_id="-1" name="男子会員"
		   text="『すげ、奥がキュンキュン締め付けてきやがる。』" voices=""/>
		<msg @l="330" char_id="-1" frame_id="-1" name="男子会員"
		   text="『もうすぐイクんだろ？&#32;イクならちゃんとそう言えよ。』" voices=""/>
		<msg @l="332" char_id="0" frame_id="-1" name="美帆"
		   text="『んぅっ‥‥‥あっ、んあっ‥‥‥‥いいっん‥‥はいっ‥‥‥んんんんっっ‥‥。』" voices="miho12420"/>
		<msg @l="334" char_id="0" frame_id="-1" name="美帆"
		   text="『いきます‥‥‥もう、いくっ‥‥‥‥いく、いくいくっ‥‥いっちゃいますぅ‥‥。』" voices="miho12430"/>
		<msg @l="336" char_id="-1" frame_id="-1" name=""
		   text="クリ○リスを摘み上げられ胎内奥深くにある敏感な場所を先端で突き上げられながら、私は言われるままに迫りつつある絶頂を告げる。"
		   voices=""/>
		<msg @l="338" char_id="-1" frame_id="-1" name="男子会員"
		   text="『ヒヒヒヒ‥‥‥いいぜ‥‥イけよ、思いっきりな。』" voices=""/>
		<msg @l="340" char_id="-1" frame_id="-1" name="" text="男の指がクリ○リスを強く捻りあげる。"
		   voices=""/>
		<msg @l="342" char_id="0" frame_id="-1" name="美帆" text="『ひぅ――――！？』"
		   voices="miho12440"/>
		<msg @l="344" char_id="-1" frame_id="-1" name="" text="激しい痺れが身体中を駆け抜けていく。"
		   voices=""/>
		<msg @l="345" char_id="-1" frame_id="-1" name=""
		   text="痛みを多分に含んだそれは、甘い痺れを伴う強烈な刺激となって私を襲う。" voices=""/>
		<msg @l="347" char_id="0" frame_id="-1" name="美帆"
		   text="『いくいくいくっいくいくいくっっ‥‥‥‥ん、ああああああっひああああああん！！！』" voices="miho12450"/>
		<msg @l="349" char_id="-1" frame_id="-1" name="男子会員" text="『くぅぅっ！！』"
		   voices=""/>
		<flash @l="353" count="4" fade="100" image="white"/>
		<wait_chgmv/>
		<ev @l="357" src="ev-038x1z1"/>
		<msg @l="359" char_id="0" frame_id="-1" name="美帆"
		   text="『んんっ‥‥‥あっ‥‥‥ふぅ‥‥‥ふぁぁ‥‥‥。』" voices="miho12460"/>
		<msg @l="361" char_id="-1" frame_id="-1" name=""
		   text="熱い液体が一度胎内の奥底へ注ぎ込まれた後、男根が引き抜かれて大量の精液が私の身体へ撒き散らされる。" voices=""/>
		<msg @l="362" char_id="-1" frame_id="-1" name=""
		   text="白濁色の液体は私の肌を焦がし、それからテニスウェアに染み込んでいく。" voices=""/>
		<msg @l="364" char_id="-1" frame_id="-1" name="男子学生"
		   text="『ケケケケ‥‥よーし、次のヤツいいぜ。』" voices=""/>
		<msg @l="366" char_id="-1" frame_id="-1" name=""
		   text="射精が終わると、男はそう言って部室の外に向かって声をかける。" voices=""/>
		<msg @l="367" char_id="-1" frame_id="-1" name=""
		   text="部室の外にはおそらく‥‥テニスコートから着いてきた男子部員たちが列を成しているのだろう。" voices=""/>
		<stopbgm @l="371" fadeout="1000"/>
		<clear @l="377" class="all"/>
		<msg @l="379" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥ふふ‥‥‥ふ‥‥‥‥‥。』"
		   voices="miho12470"/>
		<msg @l="381" char_id="-1" frame_id="-1" name=""
		   text="私は絶頂の余韻に心を震わせながら‥‥力なく笑う。" voices=""/>
		<msg @l="382" char_id="-1" frame_id="-1" name=""
		   text="もう‥‥二度と訪れない平穏な毎日を、思い‥‥そして失ったものの大きさを感じながら‥‥‥。" voices=""/>
		<clear @l="388" class="all"/>
		<wait @l="390" time="2000"/>
		<end_scene @l="392"/>
		<goto @l="395" cond="!(s.exRootFlag)&#13;&#10;" label="TempLabel_318"/>
		<call @l="398" target="EventLabel_56@ex_ending02"/>
		<return @l="399" value="0&#13;&#10;"/>
		<label @l="401" id="TempLabel_318"/>
		<eval @l="406" expr="s.flagGallery=1&#13;&#10;"/>
		<eval @l="408" expr="s.event38flag=1&#13;&#10;"/>
		<eval @l="412"
		   expr="f.bEx&#32;=&#32;s.event20flag&#32;&amp;&amp;&#32;s.event23flag&#32;&amp;&amp;&#32;s.event25flag&#32;&amp;&amp;&#32;s.event30flag&#32;&amp;&amp;&#32;s.event31flag&#32;&amp;&amp;&#32;s.event32flag&#32;&amp;&amp;&#32;s.event33flag&#32;&amp;&amp;&#32;s.event35flag&#32;&amp;&amp;&#32;s.event37flag&#32;&amp;&amp;&#32;s.event38flag&#32;&amp;&amp;&#32;s.event60flag&#13;&#10;"/>
		<goto @l="414" cond="!(f.bEx)&#13;&#10;" label="TempLabel_319"/>
		<eval @l="416" expr="s.exRootFlag=1&#13;&#10;"/>
		<label @l="417" id="TempLabel_319"/>
		<ending @l="419"/>
		<goto @l="421" cond="!(f.bEx)&#13;&#10;" label="TempLabel_320"/>
		<wait_chgmv/>
		<bg @l="425" src="newroot"/>
		<wait @l="427" time="5000"/>
		<wait_chgmv/>
		<bg @l="429" src="black"/>
		<label @l="432" id="TempLabel_320"/>
		<return @l="436" value=""/>
	</code>
</xscript>
