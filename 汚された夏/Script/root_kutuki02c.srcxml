<?xml version="1.0" encoding="utf-8"?>
<xscript>
	<debug editor="&quot;C:\Program&#32;Files&#32;(x86)\sakura\sakura.exe&quot;&#32;&quot;%src%&quot;&#32;-Y=%line%"
	   src="D:\シロップ\町ぐるみの罠＋汚された夏セット版\汚された夏\完成データ\汚された夏\script\text\root_kutuki02c.txt"/>
	<code>
		<label @l="10" id="EventLabel_113"/>
		<description @l="13" text="契約の日々・１日目"/>
		<eval @l="15" expr="f.numDay=5&#13;&#10;"/>
		<msgshow @l="17" show="false"/>
		<wait_chgmv/>
		<bg @l="19" src="day05" time="2000"/>
		<wait @l="21" time="500"/>
		<wait_chgmv/>
		<bg @l="23" src="black" time="2000"/>
		<msgshow @l="25" show="true"/>
		<wait_chgmv/>
		<bg @l="28" src="bg21m1"/>
		<bgm @l="31" src="bgm03" volume="1."/>
		<char @l="34" id="miho" pos="auto" src="miho116"/>
		<msg @l="36" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="38" char_id="-1" frame_id="-1" name=""
		   text="昼を少し過ぎた頃‥‥私はいつもの停留所で電車に乗り込もうとしていた。" voices=""/>
		<msg @l="39" char_id="-1" frame_id="-1" name=""
		   text="今日は講義が三限目だけなので、こんな遅い時間からでもＯＫだ。" voices=""/>
		<msg @l="41" char_id="0" frame_id="-1" name="美帆" text="(今日は‥‥大丈夫だよね？)"
		   voices=""/>
		<msg @l="43" char_id="-1" frame_id="-1" name=""
		   text="私はそして、警戒するように周囲をぐるりと見回してみる。" voices=""/>
		<msg @l="44" char_id="-1" frame_id="-1" name="" text="とりあえず‥‥それらしい姿は見つからない。"
		   voices=""/>
		<msg @l="45" char_id="-1" frame_id="-1" name=""
		   text="無論、私が警戒しているのは朽木教授‥‥である。" voices=""/>
		<msg @l="47" char_id="0" frame_id="-1" name="美帆"
		   text="(さすがにこんな時間までは狙ってこないか‥‥)" voices=""/>
		<clear @l="50" class="all"/>
		<label @l="53" id="event_scene73"/>
		<msg @l="55" char_id="-1" frame_id="-1" name="" text="私は定期を取り出しながら電車に乗り込む。"
		   voices=""/>
		<msg @l="56" char_id="-1" frame_id="-1" name=""
		   text="そうしていつもの壁際が空いている事を確認すると、そこへ身体を滑り込ませるように立った。" voices=""/>
		<se @l="59" buf="3" loop="true" src="電車走行中" volume="1."/>
		<label @l="62" id="chart_line42"/>
		<wait_chgmv/>
		<ev @l="65" src="ev-005"/>
		<msg @l="67" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』"
		   voices="miho07530"/>
		<msg @l="69" char_id="-1" frame_id="-1" name=""
		   text="電車が走り出してからしばらく、私はぼんやりと窓の外を見つめていた。" voices=""/>
		<msg @l="70" char_id="-1" frame_id="-1" name=""
		   text="けれどその無為で幸福な時間も‥‥長く続く事は無かった。" voices=""/>
		<stopbgm @l="73" fadeout="1000"/>
		<description @l="76" text="見知らぬ痴漢"/>
		<msg @l="78" char_id="0" frame_id="-1" name="美帆" text="(え‥‥うそ‥‥‥)"
		   voices="miho07540"/>
		<msg @l="80" char_id="-1" frame_id="-1" name=""
		   text="スカート越しに感じる確かな違和感が、瞬く間に血の気を引かせる。" voices=""/>
		<bgm @l="83" src="bgm15" volume="1."/>
		<msg @l="85" char_id="0" frame_id="-1" name="美帆" text="(こんな‥‥‥時間なのに‥‥‥‥‥)"
		   voices="miho07550"/>
		<msg @l="87" char_id="-1" frame_id="-1" name="" text="私は深くうつむいて、ぎゅっと下唇を噛む。"
		   voices=""/>
		<msg @l="88" char_id="-1" frame_id="-1" name="" text="いつの間に紛れ込んだのだろう。"
		   voices=""/>
		<msg @l="89" char_id="-1" frame_id="-1" name="" text="それとも‥‥待ち伏せしていたのだろうか。"
		   voices=""/>
		<msg @l="90" char_id="-1" frame_id="-1" name=""
		   text="どちらにせよ、真昼の満員電車でこんな風に堂々と痴漢行為を働くなんて朽木教授以外に考えられない。" voices=""/>
		<msg @l="92" char_id="0" frame_id="-1" name="美帆" text="(ど、どうしよう‥‥)"
		   voices="miho07560"/>
		<msg @l="94" char_id="-1" frame_id="-1" name=""
		   text="スカートの上からお尻を撫でられるたび、嫌悪感で背中が総毛立つ。" voices=""/>
		<msg @l="95" char_id="-1" frame_id="-1" name="" text="けれど‥‥私は逆らう事ができない。"
		   voices=""/>
		<msg @l="96" char_id="-1" frame_id="-1" name=""
		   text="私が逆らえば、父が‥‥‥家族が破滅してしまうのだ。" voices=""/>
		<msg @l="98" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』"
		   voices="miho07570"/>
		<msg @l="100" char_id="-1" frame_id="-1" name="痴漢" text="『‥‥‥‥。』" voices=""/>
		<msg @l="102" char_id="-1" frame_id="-1" name=""
		   text="彼の手が、ゆっくりとスカートの中に入り込んでくる。" voices=""/>
		<wait_chgmv/>
		<ev @l="105" src="ev-005bx2y4"/>
		<msg @l="107" char_id="-1" frame_id="-1" name=""
		   text="それでも私は抗う事が出来ず、ただじっとしている事しか出来ない。" voices=""/>
		<msg @l="109" char_id="0" frame_id="-1" name="美帆" text="『あ‥‥。』"
		   voices="miho07580"/>
		<msg @l="111" char_id="-1" frame_id="-1" name=""
		   text="スカートの中に侵入してすぐ、指先がパンティ越しに割れ目を擦り上げてくる。" voices=""/>
		<msg @l="112" char_id="-1" frame_id="-1" name=""
		   text="その柔らかさを愉しむかのように、下着の上から秘部のスリットをなぞり、指先を前後に蠢かせる。" voices=""/>
		<msg @l="114" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥っ‥‥。』"
		   voices="miho01490"/>
		<msg @l="116" char_id="-1" frame_id="-1" name="" text="ゴツゴツとした指の感触が‥‥少し痛い。"
		   voices=""/>
		<msg @l="118" char_id="-1" frame_id="-1" name="痴漢" text="『‥‥‥‥。』" voices=""/>
		<wait_chgmv/>
		<ev @l="121" src="ev-005bx2y3"/>
		<bgm @l="124" src="bgm14" volume="1."/>
		<msg @l="126" char_id="-1" frame_id="-1" name=""
		   text="もう一方の手が、服の上から純白のブラに包まれた胸の形をゆがめるように揉みしだいてくる。" voices=""/>
		<msg @l="128" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』"
		   voices="miho09880"/>
		<msg @l="130" char_id="-1" frame_id="-1" name=""
		   text="私が特に抵抗しない事を確認すると、さらにもう一方の手で秘所の谷間を指で大胆に撫でまわす。" voices=""/>
		<msg @l="131" char_id="-1" frame_id="-1" name=""
		   text="ただ‥‥昨日迄の触り方と違和感があるような気がしてならない。" voices=""/>
		<msg @l="132" char_id="-1" frame_id="-1" name="" text="‥‥何と無くそう思った。"
		   voices=""/>
		<msg @l="134" char_id="0" frame_id="-1" name="美帆" text="(私が抵抗できないからって‥‥‥)"
		   voices="miho07590"/>
		<msg @l="136" char_id="-1" frame_id="-1" name=""
		   text="痴漢は服の上から胸の柔らかな曲線に沿って円を描くように撫で回し、さらに下からすくい上げ、上下に揺さぶり、若さの弾力を弄んだ。"
		   voices=""/>
		<msg @l="138" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥ゃぁ‥‥。』"
		   voices="miho00740"/>
		<msg @l="140" char_id="-1" frame_id="-1" name=""
		   text="私は胸の上を延々と這いずり回る手の感触に、ふっくらとした唇を前歯で噛み耐えた。" voices=""/>
		<msg @l="142" char_id="-1" frame_id="-1" name="痴漢" text="『‥‥‥‥。』" voices=""/>
		<msg @l="144" char_id="-1" frame_id="-1" name="" text="胸から手が離れる。" voices=""/>
		<msg @l="145" char_id="-1" frame_id="-1" name=""
		   text="胸をさわるのを飽きたのかと思って安堵の息を吐いたその瞬間、服の隙間から指先が侵入し、ブラジャーの上から乳房の丸みを確かめるように手に力を入れて揉み始めた。"
		   voices=""/>
		<msg @l="147" char_id="0" frame_id="-1" name="美帆" text="『んっ‥‥。』"
		   voices="miho07600"/>
		<msg @l="149" char_id="-1" frame_id="-1" name="痴漢" text="『‥‥‥‥。』" voices=""/>
		<msg @l="151" char_id="-1" frame_id="-1" name=""
		   text="痴漢の手はブラの感触を暫く愉しむと、今度は背中へ移動しシャツの上からホックをはずしにかかった。" voices=""/>
		<msg @l="153" char_id="0" frame_id="-1" name="美帆" text="『あ‥‥。』"
		   voices="miho11000"/>
		<msg @l="155" char_id="-1" frame_id="-1" name=""
		   text="そして、いとも簡単にブラジャーのホックがはずされ、若さで張りのある乳房はその強い弾力を解き放たれたようにフルンと揺れ、カップがずれ落ちる。"
		   voices=""/>
		<msg @l="156" char_id="-1" frame_id="-1" name=""
		   text="そして、また服の隙間から指先を入れて直接乳房を揉み回される。" voices=""/>
		<msg @l="158" char_id="0" frame_id="-1" name="美帆"
		   text="(やだ‥‥‥乳首、転がさないで‥‥‥‥)" voices="miho07610"/>
		<msg @l="160" char_id="-1" frame_id="-1" name=""
		   text="コリコリと二本の指で乳首を転がされるたび、心とは裏腹に喉奥から湧き上がる声がもれてしまう。" voices=""/>
		<msg @l="162" char_id="0" frame_id="-1" name="美帆" text="『うっうっうっ～～～。』"
		   voices="miho07620"/>
		<msg @l="164" char_id="-1" frame_id="-1" name="痴漢" text="『‥‥‥‥。』" voices=""/>
		<msg @l="166" char_id="-1" frame_id="-1" name=""
		   text="さらに今度は二本の指で小粒の豆を摘んで指腹で摩擦した。" voices=""/>
		<msg @l="167" char_id="-1" frame_id="-1" name=""
		   text="グミのような柔らかさであった乳首は、みるみるうちに充血して尖り、淫らな芯が通ってきた。" voices=""/>
		<msg @l="169" char_id="0" frame_id="-1" name="美帆" text="『んはっ‥‥‥ん、んんっ！』"
		   voices="miho10960"/>
		<msg @l="171" char_id="-1" frame_id="-1" name=""
		   text="彼の手は胸を揉みしだく一方で、秘裂を擦り上げていた指はいちはやくクリ○リスの場所を見つけ出しては集中的に弄んでくる。"
		   voices=""/>
		<msg @l="172" char_id="-1" frame_id="-1" name=""
		   text="指を突起に当て、芯に直接振動を加えるように、小刻みなバイブレーションをした。" voices=""/>
		<msg @l="174" char_id="0" frame_id="-1" name="美帆" text="『んんっ‥‥‥くっ‥‥‥‥‥。』"
		   voices="miho07630"/>
		<msg @l="176" char_id="-1" frame_id="-1" name="" text="私の口からわずかに吐息が漏れる。"
		   voices=""/>
		<msg @l="177" char_id="-1" frame_id="-1" name=""
		   text="彼に気付かせまいと必死に堪えていたのに、執拗な愛撫にどうしても身体が反応してしまった。" voices=""/>
		<msg @l="179" char_id="-1" frame_id="-1" name="痴漢" text="『‥‥‥‥。』" voices=""/>
		<msg @l="181" char_id="-1" frame_id="-1" name="" text="私の耳元で微かな笑みが漏れた。"
		   voices=""/>
		<msg @l="182" char_id="-1" frame_id="-1" name=""
		   text="それを合図に私の身体をいじくっていた指の動きが止まったかと思うといきなり私の上着をつかんだ。" voices=""/>
		<wait_chgmv/>
		<ev @l="185" src="ev-005bx3x5"/>
		<msg @l="187" char_id="0" frame_id="-1" name="美帆" text="(え‥‥なにを‥‥‥)"
		   voices="miho07640"/>
		<msg @l="189" char_id="-1" frame_id="-1" name=""
		   text="彼は手馴れた動きで私の上着をたくし上げ、胸や下着を露出させる。" voices=""/>
		<msg @l="190" char_id="-1" frame_id="-1" name=""
		   text="抗おうと思う暇もないほど‥‥彼の動き手馴れていた。" voices=""/>
		<msg @l="191" char_id="-1" frame_id="-1" name=""
		   text="露になった白い肌は、官能的で彼の情欲をかきたてるに充分であった。" voices=""/>
		<msg @l="193" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』"
		   voices="miho07650"/>
		<msg @l="195" char_id="-1" frame_id="-1" name=""
		   text="思わず抵抗をしそうになるが、私はぐっと耐える。" voices=""/>
		<msg @l="196" char_id="-1" frame_id="-1" name=""
		   text="私が抵抗をすれば処女を捧げてまで守った父や家族の未来が壊れてしまうかもしれないのだ。" voices=""/>
		<msg @l="197" char_id="-1" frame_id="-1" name=""
		   text="それだけは‥‥何があっても避けなくてはならない。" voices=""/>
		<msg @l="199" char_id="-1" frame_id="-1" name="痴漢" text="『‥‥‥‥。』" voices=""/>
		<msg @l="201" char_id="-1" frame_id="-1" name="" text="また‥‥私の耳元で彼が笑った。"
		   voices=""/>
		<msg @l="202" char_id="-1" frame_id="-1" name="" text="熱い吐息がうなじに吹きかけられる。"
		   voices=""/>
		<msg @l="204" char_id="0" frame_id="-1" name="美帆" text="『んっっ！』"
		   voices="miho00450"/>
		<msg @l="206" char_id="-1" frame_id="-1" name=""
		   text="そうして、首筋を舐める位、顔を近づけ私の匂いをかぎながら指は下着の上からクリ○リスをいじくり続ける。" voices=""/>
		<msg @l="208" char_id="0" frame_id="-1" name="美帆" text="『んっ‥‥くぅっ‥‥‥‥。』"
		   voices="miho07660"/>
		<msg @l="210" char_id="-1" frame_id="-1" name=""
		   text="執拗に与えられるクリ○リスへの刺激に、少しずつ腰の辺りが痺れてくる。" voices=""/>
		<msg @l="211" char_id="-1" frame_id="-1" name=""
		   text="指のバイブレーションはさらに振動を増し、理不尽な快楽は声に変わりそうになる。" voices=""/>
		<msg @l="213" char_id="0" frame_id="-1" name="美帆"
		   text="(ダメ‥‥こんな状態で声なんか出したら‥‥‥‥)" voices="miho07670"/>
		<msg @l="215" char_id="0" frame_id="-1" name="美帆"
		   text="(周りの人に‥‥‥み、見られちゃう‥‥‥‥)" voices="miho07680"/>
		<msg @l="217" char_id="-1" frame_id="-1" name="" text="私は懸命に声を押し殺そうとする。"
		   voices=""/>
		<msg @l="218" char_id="-1" frame_id="-1" name=""
		   text="けれど‥‥そんな私の反応を愉しむかのように、身体中をまさぐる手はさらに激しく乳首や女芯といった敏感な所ばかりを執拗に擦り上げてくるのだ。"
		   voices=""/>
		<msg @l="219" char_id="-1" frame_id="-1" name=""
		   text="それでもしばらくはじっと押し黙り堪え続けていた私も‥‥。" voices=""/>
		<msg @l="221" char_id="0" frame_id="-1" name="美帆" text="『あっ‥‥んくっ‥‥‥。』"
		   voices="miho07690"/>
		<msg @l="223" char_id="-1" frame_id="-1" name=""
		   text="クリ○リスをいじっていた指が、女陰の上側を擦り伸ばし入口を広げたかと思うと、一気に秘密の肉洞に差し込まれた。" voices=""/>
		<msg @l="225" char_id="0" frame_id="-1" name="美帆" text="『ひぅっ！！』"
		   voices="miho10100"/>
		<msg @l="227" char_id="-1" frame_id="-1" name=""
		   text="その瞬間、思わず堪えていた声を漏らしてしまった。" voices=""/>
		<msg @l="229" char_id="0" frame_id="-1" name="美帆"
		   text="(やっ‥‥いまの、気付かれなかったよね‥‥‥‥？)" voices="miho07700"/>
		<msg @l="231" char_id="-1" frame_id="-1" name=""
		   text="私は慌てて手で口をおおい、深くうつむいて顔を隠す。" voices=""/>
		<msg @l="232" char_id="-1" frame_id="-1" name=""
		   text="胸とショーツを丸出しにされたままだったが、恥ずかしくて顔を上げてられなかった。" voices=""/>
		<msg @l="234" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』"
		   voices="miho10340"/>
		<msg @l="236" char_id="-1" frame_id="-1" name="痴漢" text="『‥‥‥‥。』" voices=""/>
		<msg @l="238" char_id="-1" frame_id="-1" name=""
		   text="そうして私が周囲の視線に怯えている事などお構いなしに、彼は白く美しい半球形の乳房を変形するくらい揉みしだき、グニュグニュと蜜壺を指でかきまわす。"
		   voices=""/>
		<msg @l="240" char_id="0" frame_id="-1" name="美帆" text="(も‥‥やだ、はやく着いてよ‥‥‥‥)"
		   voices="miho07710"/>
		<msg @l="242" char_id="-1" frame_id="-1" name=""
		   text="懇願するように窓の外を見るが‥‥電車はまだ半分くらいを過ぎた程度だ。" voices=""/>
		<msg @l="243" char_id="-1" frame_id="-1" name=""
		   text="つまりあと十五分はこの状態が続くことになる。" voices=""/>
		<msg @l="245" char_id="0" frame_id="-1" name="美帆"
		   text="(こんなの‥‥‥ダメ‥‥耐えられないよ‥‥‥‥‥)" voices="miho07720"/>
		<msg @l="247" char_id="-1" frame_id="-1" name=""
		   text="わずかに諦めの気持ちが芽生えた瞬間、下腹部の辺りから熱いモノが滲み出していく。" voices=""/>
		<msg @l="248" char_id="-1" frame_id="-1" name=""
		   text="その熱い淫靡な汁は私の胎内を伝い、ゆっくりと割れ目から外へ溢れ出た。" voices=""/>
		<msg @l="250" char_id="0" frame_id="-1" name="美帆" text="『‥‥！？』"
		   voices="miho10040"/>
		<msg @l="252" char_id="-1" frame_id="-1" name=""
		   text="雫は太股にも伝わり落ち、まるでナメクジが這ったような足跡を残した。" voices=""/>
		<msg @l="253" char_id="-1" frame_id="-1" name=""
		   text="やがて‥‥秘部を擦り上げる彼の指にヌチャヌチャとからみつき、いやらしい音をたてはじめた。" voices=""/>
		<msg @l="255" char_id="0" frame_id="-1" name="美帆" text="『んくっ‥‥。』"
		   voices="miho09910"/>
		<msg @l="257" char_id="-1" frame_id="-1" name="痴漢" text="『おっ‥‥‥‥。』"
		   voices=""/>
		<msg @l="259" char_id="-1" frame_id="-1" name="" text="耳元で、驚くような声が聞こえた。"
		   voices=""/>
		<msg @l="260" char_id="-1" frame_id="-1" name="" text="何かが違う。" voices=""/>
		<msg @l="261" char_id="-1" frame_id="-1" name="" text="朽木教授ならばこんなことで驚くだろうか？"
		   voices=""/>
		<msg @l="262" char_id="-1" frame_id="-1" name="" text="冷静に考えれば、そう思えたのだが"
		   voices=""/>
		<msg @l="263" char_id="-1" frame_id="-1" name=""
		   text="このときは、彼の指が秘所をかきまわす感触に思考能力は無くなっていた。" voices=""/>
		<msg @l="265" char_id="0" frame_id="-1" name="美帆" text="『んんっ、んっ‥‥‥あふっ‥‥‥‥。』"
		   voices="miho07730"/>
		<msg @l="267" char_id="-1" frame_id="-1" name=""
		   text="声を押し殺そうと思っているのに、私の口からは熱い吐息と共にどこか切なげな声が漏れていた。" voices=""/>
		<msg @l="268" char_id="-1" frame_id="-1" name=""
		   text="女唇の肉ヒダを擦られ、かき回され、くちゅくちゅという淫らな音が‥‥周囲に響く。" voices=""/>
		<msg @l="270" char_id="0" frame_id="-1" name="美帆"
		   text="『あっ‥‥ああ‥‥‥‥‥も、ダメぇ‥‥‥‥‥。』" voices="miho07740"/>
		<msg @l="272" char_id="-1" frame_id="-1" name="" text="頭の芯が痺れ、意識が飛びそうになる。"
		   voices=""/>
		<msg @l="273" char_id="-1" frame_id="-1" name=""
		   text="まるで催眠術にでもかかったように、理性は蜜汁とともに溶けて流れていく。" voices=""/>
		<msg @l="274" char_id="-1" frame_id="-1" name=""
		   text="ビチャビチャになった蜜壺に、二本の指を根元まで押し込まれたその瞬間‥‥。" voices=""/>
		<msg @l="276" char_id="0" frame_id="-1" name="美帆" text="『ん、くぅぅぅっ！！』"
		   voices="miho07750"/>
		<flash @l="279" count="4" fade="100" image="white"/>
		<wait_chgmv/>
		<ev @l="282" src="ev-005bx3y5z2"/>
		<msg @l="284" char_id="-1" frame_id="-1" name=""
		   text="視界がフラッシュバックするような強烈な絶頂が‥‥私の身体を襲った。" voices=""/>
		<msg @l="285" char_id="-1" frame_id="-1" name=""
		   text="そうして甘い悦楽に震える私の膣からは大量の蜜が吹き出し、太腿まで垂れ落ちてくる。" voices=""/>
		<msg @l="287" char_id="-1" frame_id="-1" name="痴漢"
		   text="『すげえな‥‥痴漢されてイっちまったのかよ。』" voices=""/>
		<msg @l="289" char_id="0" frame_id="-1" name="美帆" text="『え‥‥。』"
		   voices="miho07760"/>
		<msg @l="291" char_id="-1" frame_id="-1" name=""
		   text="ふと耳元で囁かれた聞き慣れない声に驚き、私は肩越しに振り返る。" voices=""/>
		<msg @l="292" char_id="-1" frame_id="-1" name=""
		   text="‥‥と、そこには朽木教授でなく見知らぬ男性がいた。" voices=""/>
		<msg @l="293" char_id="-1" frame_id="-1" name=""
		   text="彼は私をいやらしい笑みで一瞥すると、指先にねっとりと絡みつき糸をひいた蜜を見せつける。" voices=""/>
		<msg @l="295" char_id="-1" frame_id="-1" name="痴漢"
		   text="『へへっ、アンタ思った以上の淫乱みたいだな。』" voices=""/>
		<msg @l="297" char_id="0" frame_id="-1" name="美帆" text="『そんな、こと‥‥。』"
		   voices="miho07770"/>
		<msg @l="299" char_id="-1" frame_id="-1" name="痴漢"
		   text="『こんなに糸をひく程濡らしといて、今更なに言ってやがる。』" voices=""/>
		<msg @l="301" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』"
		   voices="miho07780"/>
		<msg @l="303" char_id="-1" frame_id="-1" name=""
		   text="私は彼の言葉から逃れるように一歩壁際に寄ろうとする。" voices=""/>
		<msg @l="304" char_id="-1" frame_id="-1" name=""
		   text="相手が朽木教授でなければ逃げても問題はない‥‥そう思った。" voices=""/>
		<msg @l="305" char_id="-1" frame_id="-1" name=""
		   text="けれどその瞬間‥‥私の身体に複数の手が絡みついてそれを阻む。" voices=""/>
		<msg @l="307" char_id="0" frame_id="-1" name="美帆" text="『え‥‥！？』"
		   voices="miho07790"/>
		<wait_chgmv/>
		<ev @l="310" src="ev-005bx3y5z2"/>
		<msg @l="312" char_id="0" frame_id="-1" name="美帆" text="(うそ‥‥‥なにこれ‥‥‥‥‥‥)"
		   voices="miho07800"/>
		<msg @l="314" char_id="-1" frame_id="-1" name=""
		   text="後ろにいる男の手だけではなく、四方から手が伸びてきて私の胸を、腰を、股間を、足を、お尻を、嬲り始める。" voices=""/>
		<msg @l="316" char_id="-1" frame_id="-1" name="痴漢"
		   text="『みんな、アンタがイクところ見て興奮してるんだぜ。』" voices=""/>
		<msg @l="318" char_id="-1" frame_id="-1" name="痴漢"
		   text="『見てみろよ‥‥ズボンに手ぇ突っ込んで、しごいてる奴もいるぜ？』" voices=""/>
		<msg @l="319" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』"
		   voices="miho07810"/>
		<msg @l="321" char_id="-1" frame_id="-1" name=""
		   text="思わず、言われた方を見ると‥‥確かにズボンのポケットに入れられた手が股間のあたりでモゾモゾと動いている。" voices=""/>
		<msg @l="323" char_id="0" frame_id="-1" name="美帆"
		   text="(う、うそ‥‥こんなところで‥‥‥‥？)" voices="miho07820"/>
		<msg @l="325" char_id="-1" frame_id="-1" name="痴漢"
		   text="そーいう俺も、実はもうビンビンでさ。アンタ触ってよ。" voices=""/>
		<msg @l="327" char_id="0" frame_id="-1" name="美帆" text="『い、いやですっ‥‥。』"
		   voices="miho07830"/>
		<msg @l="329" char_id="-1" frame_id="-1" name="痴漢"
		   text="『なんだよ、自分だけイって満足ってのかよ。』" voices=""/>
		<msg @l="331" char_id="0" frame_id="-1" name="美帆" text="『そ、そういうわけじゃ‥‥。』"
		   voices="miho07840"/>
		<stopbgm @l="334" fadeout="1000"/>
		<clear @l="337" class="all"/>
		<msg @l="339" char_id="-1" frame_id="-1" name="アナウンス"
		   text="『次は終点‥‥大学前、大学前です。』" voices=""/>
		<msg @l="341" char_id="-1" frame_id="-1" name="アナウンス"
		   text="『手荷物のお忘れ物などありませんようご注意ください。』" voices=""/>
		<msg @l="343" char_id="-1" frame_id="-1" name=""
		   text="車内に、聞き慣れたアナウンスが流れてくる。" voices=""/>
		<msg @l="344" char_id="-1" frame_id="-1" name=""
		   text="それを合図にして車内は騒然となり、私へと伸びていた複数の手も身体から離れていく。" voices=""/>
		<msg @l="346" char_id="-1" frame_id="-1" name="痴漢" text="『チッ‥‥もうちょっとなのによっ。』"
		   voices=""/>
		<msg @l="348" char_id="-1" frame_id="-1" name=""
		   text="私の背後にいた彼も、短く舌打ちすると急いでその場から離れていく。" voices=""/>
		<msg @l="350" char_id="0" frame_id="-1" name="美帆" text="(た、助かった‥‥)"
		   voices="miho07850"/>
		<msg @l="352" char_id="-1" frame_id="-1" name=""
		   text="安堵のため息を吐いて、私は慌ててまくられてしまっていた服を整える。" voices=""/>
		<msg @l="353" char_id="-1" frame_id="-1" name=""
		   text="それから電車が到着するまでの間ずっと、複数の粘つくような視線を感じていた。" voices=""/>
		<stopse @l="356" buf="3"/>
		<clear @l="359" class="all"/>
		<end_scene @l="362"/>
		<msgshow @l="365" show="true"/>
		<wait_chgmv/>
		<bg @l="368" src="bg09"/>
		<bgm @l="371" src="bgm03" volume="1."/>
		<char @l="374" id="miho" pos="auto" src="miho115"/>
		<description @l="377" text="契約の日々・１日目"/>
		<eval @l="379" expr="f.numDay=5&#13;&#10;"/>
		<msg @l="381" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="383" char_id="-1" frame_id="-1" name=""
		   text="本日の講義が終わった直後、私は停留所へ向かって足早に歩いていた。" voices=""/>
		<msg @l="385" char_id="0" frame_id="-1" name="美帆"
		   text="(ちょっとスカートの中がスースーする‥‥‥)" voices=""/>
		<msg @l="387" char_id="0" frame_id="-1" name="美帆"
		   text="(やっぱり換えの下着、どこかで買ってくればよかったかな)" voices=""/>
		<msg @l="389" char_id="-1" frame_id="-1" name=""
		   text="そう‥‥家から履いてきた下着は電車の中で濡らしてしまった為、構内のトイレで脱いで捨ててしまった。" voices=""/>
		<msg @l="390" char_id="-1" frame_id="-1" name=""
		   text="何も捨てることはないかとも思ったけれど、そのままの状態でバッグの中にしまうわけにもいかなくて‥‥散々迷ったあげく捨てたのだった。"
		   voices=""/>
		<msg @l="392" char_id="0" frame_id="-1" name="美帆"
		   text="(あれ‥‥すごく気に入っていたやつなのに‥‥‥‥ほんと最悪‥‥)" voices=""/>
		<msg @l="394" char_id="-1" frame_id="-1" name=""
		   text="そんな事を思いながら帰路を急いでいると、廊下の先に今一番出会いたくない人の姿を見つけてしまった。" voices=""/>
		<clear @l="397" class="char"/>
		<char @l="399" id="miho" pos="left" src="miho015"/>
		<char @l="401" id="kutsu" pos="right" src="kutsu010"/>
		<msg @l="403" char_id="-1" frame_id="-1" name="朽木" text="『おや、仲根クンじゃないか。』"
		   voices=""/>
		<msg @l="405" char_id="0" frame_id="-1" name="美帆" text="『朽木‥‥教授‥‥‥。』"
		   voices=""/>
		<msg @l="407" char_id="-1" frame_id="-1" name="朽木"
		   text="『なんだ、随分と元気がないのではないのかね？』" voices=""/>
		<char @l="410" id="miho" pos="left" src="miho115"/>
		<msg @l="412" char_id="0" frame_id="-1" name="美帆"
		   text="『そ、そうですか？&#32;私はいつもこんな感じですけど。』" voices=""/>
		<char @l="415" id="kutsu" pos="right" src="kutsu018"/>
		<msg @l="417" char_id="-1" frame_id="-1" name="朽木" text="『ほう、いつもと同じね‥‥‥。』"
		   voices=""/>
		<msg @l="419" char_id="-1" frame_id="-1" name=""
		   text="教授はそう言って、わずかに口の端をつり上げる。" voices=""/>
		<msg @l="420" char_id="-1" frame_id="-1" name=""
		   text="まるで‥‥何か知っているとでも言いたげだ。" voices=""/>
		<msg @l="422" char_id="0" frame_id="-1" name="美帆" text="『そ、それでは‥‥私はこれで‥‥‥。』"
		   voices=""/>
		<clear @l="425" layer="miho"/>
		<msg @l="427" char_id="-1" frame_id="-1" name="朽木" text="『あぁ、一つ聞かせてくれ‥‥‥。』"
		   voices=""/>
		<char @l="430" id="miho" pos="left" src="miho015"/>
		<msg @l="432" char_id="0" frame_id="-1" name="美帆" text="『な、なんでしょうか‥‥？』"
		   voices=""/>
		<msg @l="434" char_id="-1" frame_id="-1" name="朽木"
		   text="『見知らぬ男にいじくられてイクというのは君にとっていつもの事なのかね？』" voices=""/>
		<bgm @l="436" src="bgm15" volume="1."/>
		<char @l="439" id="miho" pos="left" src="miho114"/>
		<msg @l="441" char_id="0" frame_id="-1" name="美帆" text="『‥‥！！』" voices=""/>
		<char @l="444" id="miho" pos="left" src="miho115"/>
		<msg @l="446" char_id="0" frame_id="-1" name="美帆"
		   text="『まさか‥‥、教授があの人達を‥‥‥‥。』" voices=""/>
		<char @l="449" id="kutsu" pos="right" src="kutsu010"/>
		<msg @l="451" char_id="-1" frame_id="-1" name="朽木"
		   text="『キミが私のモノになることを拒んだので、もしかすると様々な男に蹂躙されるのが好みかと思いセッティングしてあげたのだよ。』"
		   voices=""/>
		<msg @l="453" char_id="0" frame_id="-1" name="美帆" text="『そんなっ‥‥。』" voices=""/>
		<msg @l="455" char_id="-1" frame_id="-1" name="朽木"
		   text="『彼らは痴漢常習者だからな。キミも充分に愉しめたのではないのかね？』" voices=""/>
		<msg @l="457" char_id="0" frame_id="-1" name="美帆" text="『愉しんでなんか‥‥いません。』"
		   voices=""/>
		<clear @l="460" layer="kutsu"/>
		<char @l="462" id="kutsu" pos="auto" src="kutsu010"/>
		<msg @l="464" char_id="-1" frame_id="-1" name="朽木"
		   text="『ほう、やはり私の指先の方が良いという事か。』" voices=""/>
		<msg @l="466" char_id="0" frame_id="-1" name="美帆" text="『べ、別にそういうわけじゃ‥‥。』"
		   voices=""/>
		<msg @l="468" char_id="-1" frame_id="-1" name="朽木" text="『くくっ、嘘は良くないな。』"
		   voices=""/>
		<msg @l="470" char_id="0" frame_id="-1" name="美帆" text="『え‥‥きゃあっ！？』"
		   voices=""/>
		<clear @l="473" class="char"/>
		<char @l="476" id="miho" pos="center" src="miho114f" y="-80"/>
		<msg @l="478" char_id="-1" frame_id="-1" name=""
		   text="突然、教授の腕が私の腰に伸びたかと思うと強引に引き寄せられる。" voices=""/>
		<msg @l="480" char_id="0" frame_id="-1" name="美帆" text="『な、なにを‥‥。』"
		   voices=""/>
		<msg @l="482" char_id="-1" frame_id="-1" name="朽木"
		   text="『私が確認してあげようじゃないか。キミの身体がどちらの指を望んでいるかをな。』" voices=""/>
		<msg @l="484" char_id="-1" frame_id="-1" name=""
		   text="そう言って、教授は私のスカートの中へと指先を滑り込ませる。" voices=""/>
		<msg @l="485" char_id="-1" frame_id="-1" name=""
		   text="タイミング悪く下着をはいていない‥‥その部分へ、である。" voices=""/>
		<char @l="488" id="miho" pos="center" src="miho015f" y="-80"/>
		<msg @l="490" char_id="0" frame_id="-1" name="美帆" text="『え‥‥あ、ダメですっ！』"
		   voices=""/>
		<begin_trans @l="493" time="500"/>
		<layer @l="494" id="cutin_f" src="game_window_cutin" x="20" y="20" z="-1001"/>
		<layer @l="495" id="cutin" src="cut003a" x="32" y="32" z="-1000"/>
		<end_trans @l="496"/>
		<msg @l="498" char_id="-1" frame_id="-1" name="" text="くちゅっ。" voices=""/>
		<msg @l="500" char_id="-1" frame_id="-1" name="朽木"
		   text="『おやぁ？&#32;これはどういうことかな？』" voices=""/>
		<msg @l="502" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥っ‥‥。』" voices=""/>
		<msg @l="504" char_id="-1" frame_id="-1" name=""
		   text="本来そこを覆っているハズの下着が無いことに、教授が喜色の声をあげる。" voices=""/>
		<msg @l="506" char_id="0" frame_id="-1" name="美帆" text="『こ、これはっ‥‥。』"
		   voices=""/>
		<msg @l="508" char_id="-1" frame_id="-1" name="朽木"
		   text="『なるほど、下着を履けないほどに濡らしてしまった‥‥ということだな。』" voices=""/>
		<msg @l="510" char_id="0" frame_id="-1" name="美帆" text="『うぁ‥‥い、言わないでください。』"
		   voices=""/>
		<msg @l="512" char_id="-1" frame_id="-1" name="朽木"
		   text="『知らない男に痴漢され感じるとはとんだ変態だな。』" voices=""/>
		<msg @l="514" char_id="-1" frame_id="-1" name="" text="くちゅ、ぐちゅ。" voices=""/>
		<msg @l="515" char_id="-1" frame_id="-1" name=""
		   text="朽木はそう言いながら秘部に指を突き入れ胎内をかきまわす。" voices=""/>
		<msg @l="517" char_id="0" frame_id="-1" name="美帆" text="『うぅ‥‥‥。』" voices=""/>
		<msg @l="519" char_id="-1" frame_id="-1" name="朽木"
		   text="『それで、濡らしてしまった下着はどうしたのかね？んん？』" voices=""/>
		<msg @l="521" char_id="0" frame_id="-1" name="美帆" text="『す‥‥捨てました。』"
		   voices=""/>
		<msg @l="523" char_id="-1" frame_id="-1" name="朽木"
		   text="『勿体無いことをする。キミの下着なら金を払ってでも欲しいという男が幾らでもいるというのになあ。』" voices=""/>
		<msg @l="525" char_id="0" frame_id="-1" name="美帆"
		   text="『そ、そんな人たちに売るくらいなら‥‥‥‥捨てた方がマシです。』" voices=""/>
		<msg @l="527" char_id="-1" frame_id="-1" name="朽木"
		   text="『ふん、まだ心だけは清らかに、という事か。』" voices=""/>
		<msg @l="529" char_id="-1" frame_id="-1" name="朽木"
		   text="『まぁ、いい。とりあえず私の命令を聞いてもらうことにしようか。』" voices=""/>
		<msg @l="531" char_id="0" frame_id="-1" name="美帆" text="『め、命令‥‥‥ですか。』"
		   voices=""/>
		<msg @l="533" char_id="-1" frame_id="-1" name="朽木"
		   text="『そうだ。来週の月曜、キミは確か一限目から講義があるハズだな？』" voices=""/>
		<msg @l="535" char_id="0" frame_id="-1" name="美帆" text="『そう‥‥‥ですけど。』"
		   voices=""/>
		<msg @l="537" char_id="-1" frame_id="-1" name="朽木"
		   text="『その日は下着をつけずに家を出たまえ。』" voices=""/>
		<msg @l="539" char_id="0" frame_id="-1" name="美帆" text="『えっ‥‥！？』" voices=""/>
		<msg @l="541" char_id="-1" frame_id="-1" name="朽木" text="『簡単なことだろう？』"
		   voices=""/>
		<msg @l="543" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="545" char_id="-1" frame_id="-1" name="朽木"
		   text="『これを守らなければ‥‥わかっているな？』" voices=""/>
		<msg @l="547" char_id="0" frame_id="-1" name="美帆" text="『････は･･････はい。』"
		   voices=""/>
		<msg @l="549" char_id="-1" frame_id="-1" name="朽木" text="『では‥‥楽しみにしているよ。』"
		   voices=""/>
		<begin_trans @l="552" time="500"/>
		<clear @l="553" layer="cutin_f"/>
		<clear @l="554" layer="cutin"/>
		<end_trans @l="555"/>
		<clear @l="557" class="char"/>
		<char @l="560" id="miho" pos="auto" src="miho115"/>
		<msg @l="562" char_id="-1" frame_id="-1" name=""
		   text="そう言って、教授はスカートの中から手を引き抜き‥‥踵を返す。" voices=""/>
		<msg @l="563" char_id="-1" frame_id="-1" name=""
		   text="私はそうして立ち去る彼の背中を‥‥悔し涙をうかべ、睨みつけていた。" voices=""/>
		<stopbgm @l="566" fadeout="1000"/>
		<clear @l="569" class="all"/>
		<call @l="572" target="EventLabel_122@root_kutuki03c"/>
		<return @l="573" value="0&#13;&#10;"/>
	</code>
</xscript>
