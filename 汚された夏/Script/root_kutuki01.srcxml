<?xml version="1.0" encoding="utf-8"?>
<xscript>
	<debug editor="&quot;C:\Program&#32;Files&#32;(x86)\sakura\sakura.exe&quot;&#32;&quot;%src%&quot;&#32;-Y=%line%"
	   src="D:\シロップ\町ぐるみの罠＋汚された夏セット版\汚された夏\完成データ\汚された夏\script\text\root_kutuki01.txt"/>
	<code>
		<label @l="10" id="EventLabel_100"/>
		<description @l="13" text="憂鬱な契約"/>
		<eval @l="15" expr="f.numDay=4&#13;&#10;"/>
		<msgshow @l="17" show="false"/>
		<wait_chgmv/>
		<bg @l="19" src="day04" time="2000"/>
		<wait @l="21" time="500"/>
		<wait_chgmv/>
		<bg @l="23" src="black" time="2000"/>
		<msgshow @l="25" show="true"/>
		<wait_chgmv/>
		<bg @l="28" src="bg21m1"/>
		<bgm @l="31" src="bgm03" volume="1."/>
		<char @l="34" id="miho" pos="auto" src="miho115"/>
		<msg @l="36" char_id="0" frame_id="-1" name="美帆" text="『‥‥はぁ。』" voices=""/>
		<msg @l="38" char_id="-1" frame_id="-1" name=""
		   text="私は、停留所に入ってきた路面電車を見てわずかに溜息を漏らす。" voices=""/>
		<msg @l="39" char_id="-1" frame_id="-1" name="" text="憂鬱な朝だった‥‥。" voices=""/>
		<msg @l="40" char_id="-1" frame_id="-1" name=""
		   text="昨日‥‥朽木教授から父の事を聞かされた私は、その真偽を確かめようと夕食の後に電話をした。" voices=""/>
		<msg @l="41" char_id="-1" frame_id="-1" name=""
		   text="とはいえ「お父さんはリストラされるの？」なんて聞ける訳がない。" voices=""/>
		<msg @l="42" char_id="-1" frame_id="-1" name=""
		   text="仕方なく、世間話を交えながらそれとなく最近変わった事がないかを聞いたのだけれど‥‥あまり上手く聞けなかった。" voices=""/>
		<msg @l="43" char_id="-1" frame_id="-1" name=""
		   text="殆ど普通の世間話で終始して、最後の方なんて知らない土地での大学生活頑張りなさいなんて激励されてしまったくらいだ。" voices=""/>
		<clear @l="46" class="all"/>
		<msg @l="48" char_id="0" frame_id="-1" name="美帆"
		   text="(ねえ、お父さん‥‥‥私が頑張れば大丈夫なのかな‥‥‥‥)" voices=""/>
		<msg @l="50" char_id="0" frame_id="-1" name="美帆" text="(‥‥‥‥‥本当に‥‥‥)"
		   voices=""/>
		<msg @l="52" char_id="-1" frame_id="-1" name=""
		   text="心の中で泣き言をつぶやきながら、私は前の人に続いて電車へと乗り込む。" voices=""/>
		<msg @l="53" char_id="-1" frame_id="-1" name=""
		   text="大学直通の始発電車は相変らず混んでいて、憂鬱な気持ちに一層の拍車をかけた。" voices=""/>
		<se @l="56" buf="3" loop="true" src="電車走行中" volume="1."/>
		<wait_chgmv/>
		<ev @l="59" src="ev-005"/>
		<msg @l="61" char_id="0" frame_id="-1" name="美帆" text="(はぁ‥‥)"
		   voices="miho06250"/>
		<msg @l="63" char_id="0" frame_id="-1" name="美帆"
		   text="(どうしてこんな事になっちゃったのかな‥‥‥)" voices="miho06260"/>
		<msg @l="65" char_id="-1" frame_id="-1" name=""
		   text="壁際に身を寄せた私は、一人憂鬱な表情で外の景色を眺める。" voices=""/>
		<msg @l="66" char_id="-1" frame_id="-1" name=""
		   text="思い返されるのは昨日交わした朽木教授との会話ばかりだ。" voices=""/>
		<msg @l="68" char_id="0" frame_id="-1" name="美帆" text="(お父さんがリストラされる‥‥なんて)"
		   voices="miho06270"/>
		<msg @l="70" char_id="0" frame_id="-1" name="美帆" text="(そんなの、信じたくないけど‥‥‥)"
		   voices="miho06280"/>
		<msg @l="72" char_id="-1" frame_id="-1" name=""
		   text="不況が続いているせいで、多くの会社でリストラが増えている、という話を何度かテレビのニュースで見たことがある。" voices=""/>
		<msg @l="73" char_id="-1" frame_id="-1" name=""
		   text="けれど、それが父にふりかかってくるまで‥‥実感はしていなかった。" voices=""/>
		<msg @l="74" char_id="-1" frame_id="-1" name=""
		   text="正直‥‥他人事のように思っていたのだけれど。" voices=""/>
		<msg @l="75" char_id="-1" frame_id="-1" name=""
		   text="でもそれは、自分たちの家庭に降りかかってきてしまった。" voices=""/>
		<msg @l="76" char_id="-1" frame_id="-1" name="" text="だから‥‥私は朽木教授の言葉に従ったのだ。"
		   voices=""/>
		<msg @l="78" char_id="0" frame_id="-1" name="美帆" text="(あんなこと‥‥)"
		   voices="miho06290"/>
		<msg @l="80" char_id="0" frame_id="-1" name="美帆"
		   text="(あんな約束なんかしちゃって‥‥わたし‥‥‥)" voices="miho06300"/>
		<msg @l="82" char_id="-1" frame_id="-1" name=""
		   text="彼がどのような目的であの約束をしたのか‥‥想像はできる。" voices=""/>
		<msg @l="83" char_id="-1" frame_id="-1" name=""
		   text="ただ‥‥だからといって私には言いなりになるしか道はない。" voices=""/>
		<msg @l="84" char_id="-1" frame_id="-1" name=""
		   text="そうするより他に‥‥父を救う方法がないのだから。" voices=""/>
		<msg @l="86" char_id="0" frame_id="-1" name="美帆" text="(あ‥‥)"
		   voices="miho06310"/>
		<wait_chgmv/>
		<ev @l="89" src="ev-005ax1"/>
		<stopbgm @l="92" fadeout="1000"/>
		<description @l="95" text="初めての絶頂"/>
		<msg @l="97" char_id="-1" frame_id="-1" name=""
		   text="ふと‥‥お尻の辺りで、もぞもぞと人の手が動く。" voices=""/>
		<msg @l="99" char_id="0" frame_id="-1" name="美帆" text="(痴漢‥‥ま、まさか‥‥‥？)"
		   voices="miho06320"/>
		<msg @l="101" char_id="-1" frame_id="-1" name=""
		   text="私はわずかに身体をよじって、真後ろに立っている乗客を見る。" voices=""/>
		<bgm @l="104" src="bgm15" volume="1."/>
		<msg @l="106" char_id="0" frame_id="-1" name="美帆" text="『朽木‥‥教授。』"
		   voices="miho06330"/>
		<msg @l="108" char_id="-1" frame_id="-1" name="朽木" text="『やあ、朝から会うとは奇遇だねぇ。』"
		   voices=""/>
		<msg @l="110" char_id="-1" frame_id="-1" name=""
		   text="朽木教授は楽しげに口元を歪めると、私の耳元へ囁きかける。" voices=""/>
		<msg @l="111" char_id="-1" frame_id="-1" name=""
		   text="偶然なんかじゃないくせに‥‥そう思ったけれど、言葉には出来ない。" voices=""/>
		<msg @l="113" char_id="-1" frame_id="-1" name="朽木"
		   text="『そう不服そうな顔をしないでくれたまえ。思わずお父上を見捨てたくなってしまうじゃないか。』" voices=""/>
		<msg @l="115" char_id="0" frame_id="-1" name="美帆" text="『‥‥！』"
		   voices="miho06340"/>
		<msg @l="117" char_id="-1" frame_id="-1" name="朽木" text="『くく‥‥良い顔だ、とてもそそる。』"
		   voices=""/>
		<msg @l="119" char_id="-1" frame_id="-1" name="" text="教授は心底嬉しそうに笑う。"
		   voices=""/>
		<msg @l="121" char_id="-1" frame_id="-1" name="朽木"
		   text="『どれ、私が恥辱と屈辱の間で揺れる快感をじっくり教えてあげる事にしよう。』" voices=""/>
		<wait_chgmv/>
		<ev @l="124" src="ev-005ax2y1"/>
		<msg @l="126" char_id="-1" frame_id="-1" name=""
		   text="そう言って、朽木教授は片方の手で私の胸をムンズと鷲づかみにする。" voices=""/>
		<msg @l="127" char_id="-1" frame_id="-1" name=""
		   text="突然のことに、身体がピクッと反応してしまう。" voices=""/>
		<msg @l="129" char_id="0" frame_id="-1" name="美帆" text="『んっ‥‥。』"
		   voices="miho06350"/>
		<msg @l="131" char_id="-1" frame_id="-1" name=""
		   text="私は思わず身をよじって抵抗しようとしてしまう。" voices=""/>
		<msg @l="132" char_id="-1" frame_id="-1" name="" text="けれどそれも一瞬のことで‥‥。"
		   voices=""/>
		<msg @l="133" char_id="-1" frame_id="-1" name=""
		   text="すぐに朽木教授の言葉を思い出し、大人しく身を任せる。" voices=""/>
		<msg @l="135" char_id="-1" frame_id="-1" name="朽木"
		   text="『くくく、キミが私との約束を覚えていてくれて良かった。』" voices=""/>
		<msg @l="137" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』"
		   voices="miho06360"/>
		<msg @l="139" char_id="0" frame_id="-1" name="美帆"
		   text="『本当に、約束は守っていただけますか？』" voices="miho06370"/>
		<msg @l="141" char_id="0" frame_id="-1" name="美帆" text="『父を‥‥助けてくださるって。』"
		   voices="miho06380"/>
		<msg @l="143" char_id="-1" frame_id="-1" name="朽木" text="『もちろんだとも。』"
		   voices=""/>
		<msg @l="145" char_id="-1" frame_id="-1" name="朽木"
		   text="『友人の研究室に空きがあることも昨晩の内に確認した。』" voices=""/>
		<msg @l="147" char_id="-1" frame_id="-1" name="朽木"
		   text="『キミがそうして従順でいれば悪いようにはしない。』" voices=""/>
		<msg @l="149" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』"
		   voices="miho06390"/>
		<msg @l="151" char_id="-1" frame_id="-1" name=""
		   text="口元を大きく歪めて笑うと、朽木教授は形のいい胸の弾力を楽しむかのように手の平を押し付けて揉みまわす。" voices=""/>
		<msg @l="152" char_id="-1" frame_id="-1" name=""
		   text="荒々しいまさぐりを、交互に豊満な胸に注いでいく。" voices=""/>
		<msg @l="154" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥ぅぁ‥‥。』"
		   voices="miho00430"/>
		<msg @l="156" char_id="-1" frame_id="-1" name="朽木"
		   text="『私以外に今まで、どれくらいの男に揉まれたのだ？』" voices=""/>
		<msg @l="158" char_id="-1" frame_id="-1" name=""
		   text="朽木教授はまるで、手に入れた宝物が素晴らしいものであることを確認するように胸を揉みしだく。" voices=""/>
		<msg @l="160" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』"
		   voices="miho01450"/>
		<msg @l="162" char_id="-1" frame_id="-1" name=""
		   text="私はそれに対して屈辱を感じ、答えることもできない。" voices=""/>
		<msg @l="164" char_id="-1" frame_id="-1" name="朽木"
		   text="『答えないなら、この胸は私の好きなようにさせてもらうよ。』" voices=""/>
		<msg @l="166" char_id="-1" frame_id="-1" name=""
		   text="ニタッと不気味に笑い、器用に背中のブラホックを外しにかかった。" voices=""/>
		<msg @l="167" char_id="-1" frame_id="-1" name=""
		   text="ぷつんっ、見事にホックは外れ、シャツの中でブラジャーが下がり、乳房がプルンと震えて踊りだした。" voices=""/>
		<msg @l="169" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥っ‥‥‥。』"
		   voices="miho09930"/>
		<msg @l="171" char_id="-1" frame_id="-1" name=""
		   text="見事なまでの胸丘は形も申し分なく、若さゆえの張りか乳首がツンと誇らしげに隆起し、シャツの上からも形がくっきりと現れた。"
		   voices=""/>
		<msg @l="173" char_id="0" frame_id="-1" name="美帆" text="『あっ‥‥。』"
		   voices="miho06460"/>
		<msg @l="175" char_id="-1" frame_id="-1" name=""
		   text="私はその事態に気づいたが、抵抗する術も持たず、為されるがままであった。" voices=""/>
		<msg @l="176" char_id="-1" frame_id="-1" name=""
		   text="しかし、朽木教授のもう一方の手の指先が太腿を撫でた瞬間、私は思わず腰を引いてしまいそうになる‥‥。" voices=""/>
		<msg @l="178" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』"
		   voices="miho09880"/>
		<msg @l="180" char_id="-1" frame_id="-1" name=""
		   text="しかし、今度はなんとか逃げる事無く我慢する事ができた。" voices=""/>
		<msg @l="182" char_id="-1" frame_id="-1" name="朽木"
		   text="『そうそう、逃げてしまわないように十分注意することだ。』" voices=""/>
		<msg @l="184" char_id="-1" frame_id="-1" name="朽木"
		   text="『私の気まぐれでキミの父親が破滅するのだからなぁ。』" voices=""/>
		<msg @l="186" char_id="0" frame_id="-1" name="美帆"
		   text="『それはもうわかりましたから‥‥怖い事を言わないで下さい。』" voices="miho06400"/>
		<msg @l="187" char_id="-1" frame_id="-1" name="朽木" text="『おや、これは失礼。』"
		   voices=""/>
		<msg @l="189" char_id="-1" frame_id="-1" name="朽木"
		   text="『確かに無粋な話でせっかくの楽しい時間をつまらなくする事はないな。』" voices=""/>
		<msg @l="191" char_id="-1" frame_id="-1" name=""
		   text="教授は胸に這わせる手を止めようとはしない。さらに激しくなる胸への愛撫で、我慢しようとしても、つい身体をすくめてしまう。"
		   voices=""/>
		<msg @l="193" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥ぅぁ‥‥。』"
		   voices="miho00430"/>
		<msg @l="195" char_id="-1" frame_id="-1" name=""
		   text="豊満な胸はゴムマリを揉んでいるかのような弾力を教授の掌に返してくる。" voices=""/>
		<msg @l="196" char_id="-1" frame_id="-1" name=""
		   text="その行為に答えるように、白い丘に息づく紅色の苺は疼きたつ。" voices=""/>
		<msg @l="198" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥ゃ‥‥ぁぁ‥‥‥。』"
		   voices="miho01630"/>
		<msg @l="200" char_id="-1" frame_id="-1" name="朽木"
		   text="『これが、じかに触っているならば、どれだけいい感触か。想像しただけでも愉しいものだよ。』" voices=""/>
		<msg @l="202" char_id="0" frame_id="-1" name="美帆" text="『んんっ‥‥。』"
		   voices="miho06410"/>
		<msg @l="204" char_id="-1" frame_id="-1" name="" text="教授は次の目標の攻略に移る。"
		   voices=""/>
		<msg @l="205" char_id="-1" frame_id="-1" name=""
		   text="脚を撫で回していた指先が、太腿の内側へ入り込んできた。" voices=""/>
		<msg @l="206" char_id="-1" frame_id="-1" name=""
		   text="吸いつくような柔らかい肌の感触を確かめるかのように、敏感な内腿を朽木教授の指先が這い回る。" voices=""/>
		<msg @l="208" char_id="0" frame_id="-1" name="美帆" text="『やっ‥‥んんっ。』"
		   voices="miho06420"/>
		<msg @l="210" char_id="-1" frame_id="-1" name=""
		   text="秘部に近い内腿を焦らすようにゆっくりと撫でながら、朽木教授は楽しげに私の反応をうかがっている。" voices=""/>
		<msg @l="212" char_id="-1" frame_id="-1" name="朽木"
		   text="『キミは敏感で良い。反応が男を誘ってるようだよ。』" voices=""/>
		<msg @l="214" char_id="0" frame_id="-1" name="美帆" text="『そんなことっ‥‥んっ‥‥‥。』"
		   voices="miho06430"/>
		<msg @l="216" char_id="-1" frame_id="-1" name=""
		   text="指先が敏感な内腿部分を這いずり回る度に、蟲が登ってきているような感じがし、ゾゾッとする寒気がし背中が震える。" voices=""/>
		<msg @l="217" char_id="-1" frame_id="-1" name=""
		   text="けれど、父の一件で弱味を握られている私は、彼の手を払い退けることもこの場から逃げ出すことも出来ない。" voices=""/>
		<msg @l="219" char_id="0" frame_id="-1" name="美帆"
		   text="(‥‥大学に着くまでの我慢だから‥‥‥‥)" voices="miho06440"/>
		<msg @l="221" char_id="-1" frame_id="-1" name="朽木"
		   text="『くくっ、脚が震えているじゃあないかね。』" voices=""/>
		<msg @l="223" char_id="-1" frame_id="-1" name=""
		   text="私の耳元‥‥彼の吐息を感じられるほどすぐ近くで、教授が囁く。" voices=""/>
		<msg @l="225" char_id="0" frame_id="-1" name="美帆" text="『ふ、震えてなんか‥‥。』"
		   voices="miho06450"/>
		<msg @l="227" char_id="-1" frame_id="-1" name="朽木"
		   text="『フフ、強がらなくても良い‥‥すぐにこの震えを、快感に変えてやろう。』" voices=""/>
		<msg @l="229" char_id="-1" frame_id="-1" name=""
		   text="笑いながら、朽木教授は内腿に這わせていた指を一気に股間へと進め、パンティの上から蜜壺をこねあげてくる。" voices=""/>
		<wait_chgmv/>
		<ev @l="232" src="ev-005ax3y2"/>
		<msg @l="234" char_id="-1" frame_id="-1" name="" text="さわっ。" voices=""/>
		<msg @l="236" char_id="0" frame_id="-1" name="美帆" text="『あっ‥‥。』"
		   voices="miho06460"/>
		<msg @l="238" char_id="-1" frame_id="-1" name="" text="私はビクッと肢体を震わせる。"
		   voices=""/>
		<msg @l="240" char_id="-1" frame_id="-1" name="朽木"
		   text="『期待していたかね？&#32;ここをいじくってもらうことを。』" voices=""/>
		<msg @l="242" char_id="0" frame_id="-1" name="美帆" text="『期待なんて‥‥してません。』"
		   voices="miho06470"/>
		<msg @l="244" char_id="-1" frame_id="-1" name="朽木"
		   text="『フフフ、いつまでそんな事を言っていられるかな。』" voices=""/>
		<msg @l="246" char_id="-1" frame_id="-1" name="" text="くにゅ、くにゅ。" voices=""/>
		<msg @l="248" char_id="0" frame_id="-1" name="美帆" text="『んっ‥‥！』"
		   voices="miho06480"/>
		<msg @l="250" char_id="-1" frame_id="-1" name=""
		   text="秘裂へあてがわれた指先が、下着の上から割れ目を撫でまわす。" voices=""/>
		<msg @l="251" char_id="-1" frame_id="-1" name=""
		   text="ふっくらと膨れた熟脂肪が恥辱から汗をふき、下着の中はしっとりと湿った。" voices=""/>
		<wait_chgmv/>
		<ev @l="254" src="ev-005ax2y1"/>
		<msg @l="256" char_id="-1" frame_id="-1" name=""
		   text="胸部では乳房を撫で上げながら、首筋へ鼻息があたるほどに頭を近づけてきて、舌を這わせてきた。" voices=""/>
		<msg @l="257" char_id="-1" frame_id="-1" name="" text="つっ。" voices=""/>
		<msg @l="259" char_id="0" frame_id="-1" name="美帆" text="『んんっ‥‥。』"
		   voices="miho06490"/>
		<msg @l="261" char_id="-1" frame_id="-1" name=""
		   text="私は思わず身を強張らせるが、抵抗することは許されない。" voices=""/>
		<msg @l="262" char_id="-1" frame_id="-1" name=""
		   text="教授は耳の中へ唾液を練りこみ、耳の中をベトベトに汚していく。" voices=""/>
		<msg @l="264" char_id="-1" frame_id="-1" name="朽木"
		   text="『クク、こういう部分もキミは好きなようじゃないか。』" voices=""/>
		<msg @l="266" char_id="-1" frame_id="-1" name=""
		   text="下劣な言葉を発する教授の口元からは、私の耳へ続く卑猥な唾液の吊橋を作り上げた。" voices=""/>
		<msg @l="267" char_id="-1" frame_id="-1" name=""
		   text="服の上から無遠慮に豊かな乳房を揉みまわしている朽木教授の手を、ただ切なげに見守ることしか出来ない。" voices=""/>
		<msg @l="268" char_id="-1" frame_id="-1" name="" text="もみ、むにゅっ、もみ。"
		   voices=""/>
		<msg @l="270" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥ぁっ‥‥。』"
		   voices="miho00840"/>
		<msg @l="272" char_id="-1" frame_id="-1" name="朽木"
		   text="『素晴らしい身体だ。このままここで犯したくなる。』" voices=""/>
		<msg @l="274" char_id="0" frame_id="-1" name="美帆" text="『いやっ‥‥そ、それだけはっ‥‥‥。』"
		   voices="miho06500"/>
		<msg @l="276" char_id="-1" frame_id="-1" name="朽木" text="『おや、私に逆らってもよいのかね？』"
		   voices=""/>
		<msg @l="278" char_id="0" frame_id="-1" name="美帆"
		   text="『お、お願いします‥‥それだけは‥‥‥‥許してください。』" voices="miho06510"/>
		<msg @l="280" char_id="-1" frame_id="-1" name="朽木"
		   text="『ふむ‥‥まあ、今日のところはいいだろう。』" voices=""/>
		<msg @l="282" char_id="-1" frame_id="-1" name="朽木"
		   text="『今は服の上からキミの身体を堪能するコトにしようか。』" voices=""/>
		<wait_chgmv/>
		<ev @l="285" src="ev-005ax3y2"/>
		<msg @l="287" char_id="-1" frame_id="-1" name="" text="しゅるっ。" voices=""/>
		<msg @l="288" char_id="-1" frame_id="-1" name=""
		   text="朽木教授はそう言うと、激しく下着の上から女唇の割れ目を擦り、女陰の形を確かめるように揉む。" voices=""/>
		<msg @l="289" char_id="-1" frame_id="-1" name="" text="くにゅ、むにゅっ。" voices=""/>
		<msg @l="291" char_id="0" frame_id="-1" name="美帆" text="『んっっ！』"
		   voices="miho00450"/>
		<msg @l="293" char_id="-1" frame_id="-1" name="" text="強すぎず、弱すぎず‥‥。"
		   voices=""/>
		<msg @l="294" char_id="-1" frame_id="-1" name=""
		   text="絶妙なタッチで秘所を擦り上げてくる指先の動きは、徐々に気持ちの悪さ以外の「何か」をわき出させる。" voices=""/>
		<msg @l="296" char_id="0" frame_id="-1" name="美帆" text="『んんっ‥‥や、あっ‥‥‥。』"
		   voices="miho06520"/>
		<msg @l="298" char_id="-1" frame_id="-1" name=""
		   text="自分の身体の変化に‥‥私は戸惑い、甘美な声を漏らす。" voices=""/>
		<msg @l="299" char_id="-1" frame_id="-1" name=""
		   text="じわり‥‥と、秘穴の奥から透明な猥液が滲み出していく。" voices=""/>
		<msg @l="301" char_id="-1" frame_id="-1" name="朽木" text="『おや‥‥腰が震えているのかな？』"
		   voices=""/>
		<msg @l="303" char_id="0" frame_id="-1" name="美帆" text="『‥‥！』"
		   voices="miho06530"/>
		<msg @l="305" char_id="-1" frame_id="-1" name="朽木"
		   text="『ここが‥‥感じ始めてきているのではないのかね？』" voices=""/>
		<msg @l="307" char_id="0" frame_id="-1" name="美帆"
		   text="『そんなっ‥‥こと、ありません‥‥‥。』" voices="miho06540"/>
		<msg @l="309" char_id="-1" frame_id="-1" name="朽木"
		   text="『くくっ、では何故私の指がここをなぞり上げるたびに‥‥キミの腰はこんなにも震えてしまっているのだろうねえ？』" voices=""/>
		<msg @l="311" char_id="0" frame_id="-1" name="美帆"
		   text="『き、気持ちが悪いからです‥‥‥こんなことされて‥‥‥‥感じるハズありません。』" voices="miho06550"/>
		<msg @l="313" char_id="-1" frame_id="-1" name="朽木"
		   text="『なるほど、ではここも気持ち悪いかな？』" voices=""/>
		<msg @l="315" char_id="-1" frame_id="-1" name="" text="くりっ。" voices=""/>
		<msg @l="316" char_id="-1" frame_id="-1" name=""
		   text="朽木教授はそう言って、秘部の上側にある突起を‥‥下着の上から摘む。" voices=""/>
		<msg @l="318" char_id="0" frame_id="-1" name="美帆" text="『ひっ‥‥！？』"
		   voices="miho06560"/>
		<msg @l="320" char_id="-1" frame_id="-1" name="朽木"
		   text="『まだ次の駅まで時間はたっぷりある‥‥存分に、愉しませてもらうよ。』" voices=""/>
		<wait_chgmv/>
		<ev @l="323" src="ev-005ax3y2"/>
		<msg @l="325" char_id="-1" frame_id="-1" name=""
		   text="囁くように私の耳元へ語りかけると、彼は下着の上から摘んだグミのような固さの実をコリコリと転がし始めた。" voices=""/>
		<wait_chgmv/>
		<ev @l="328" src="ev-005ax2y1"/>
		<msg @l="330" char_id="-1" frame_id="-1" name="" text="もみ、もみ。" voices=""/>
		<msg @l="331" char_id="-1" frame_id="-1" name=""
		   text="もう一方の手は柔丘の丸みを確かめるように指を動かし、グニャリと胸の形を変えるように揉みまわす。" voices=""/>
		<msg @l="332" char_id="-1" frame_id="-1" name="" text="くり、くり。" voices=""/>
		<msg @l="333" char_id="-1" frame_id="-1" name=""
		   text="たわわな胸を揉む手の指で、探し当てた乳首を挟むようにぐりぐりと転がす。" voices=""/>
		<msg @l="335" char_id="0" frame_id="-1" name="美帆" text="『んんっ‥‥んっ、んっ！』"
		   voices="miho06570"/>
		<msg @l="337" char_id="-1" frame_id="-1" name=""
		   text="自然と漏れてきてしまう震える声を私は手すりを強く握ることで必死に押し殺す。" voices=""/>
		<msg @l="338" char_id="-1" frame_id="-1" name="" text="誰かが気づくかもしれない。"
		   voices=""/>
		<msg @l="339" char_id="-1" frame_id="-1" name="" text="誰かに見られてしまうかもしれない。"
		   voices=""/>
		<msg @l="341" char_id="0" frame_id="-1" name="美帆" text="『んっ‥‥くぅっ‥‥‥‥。』"
		   voices="miho06580"/>
		<msg @l="343" char_id="-1" frame_id="-1" name="朽木"
		   text="『必死だな。誰かに見られるかもしれないという心配が、いま一歩素直に感じることを拒絶させてしまっているといった所か。』"
		   voices=""/>
		<msg @l="345" char_id="0" frame_id="-1" name="美帆"
		   text="『わ、私は別に‥‥感じてなんかっ‥‥‥。』" voices="miho06590"/>
		<wait_chgmv/>
		<ev @l="348" src="ev-005ax3y2z2"/>
		<msg @l="350" char_id="-1" frame_id="-1" name="" text="くちゅっ。" voices=""/>
		<msg @l="352" char_id="0" frame_id="-1" name="美帆" text="『んっっ！！』"
		   voices="miho01670"/>
		<msg @l="354" char_id="-1" frame_id="-1" name="朽木"
		   text="『くくっ、下着の上からでもここがしっとりと湿ってきているのにか？』" voices=""/>
		<msg @l="356" char_id="0" frame_id="-1" name="美帆" text="『そ、それはっ‥‥。』"
		   voices="miho06600"/>
		<msg @l="358" char_id="-1" frame_id="-1" name="朽木"
		   text="『それともキミは感じてもいないのにここを濡らすのかな？』" voices=""/>
		<msg @l="360" char_id="-1" frame_id="-1" name=""
		   text="そうして朽木教授は下着の上から、二枚の壁をかきわけるように指先を割れ目へ押し込む。" voices=""/>
		<msg @l="361" char_id="-1" frame_id="-1" name="" text="くちゅ、くちゅ。" voices=""/>
		<msg @l="363" char_id="0" frame_id="-1" name="美帆" text="『んんっ！！』"
		   voices="miho06610"/>
		<msg @l="365" char_id="-1" frame_id="-1" name=""
		   text="ちゅく‥‥という淫靡な水音がして、熟れた内奥に溢れていた湧水が下着に染み出し、滲んでいくのが自分でもわかる気がした。"
		   voices=""/>
		<msg @l="367" char_id="-1" frame_id="-1" name="朽木" text="『もう大洪水じゃないか。』"
		   voices=""/>
		<msg @l="369" char_id="-1" frame_id="-1" name=""
		   text="蜜でテラテラと淫靡に濡れた指先を私の眼前で糸をひかせてみせ、教授はニヤリと笑う。" voices=""/>
		<msg @l="370" char_id="-1" frame_id="-1" name=""
		   text="それを見た私は恥ずかしさで顔を真っ赤にする。" voices=""/>
		<msg @l="372" char_id="-1" frame_id="-1" name="朽木" text="『それに、良い事を教えてやろうか。』"
		   voices=""/>
		<msg @l="374" char_id="-1" frame_id="-1" name="朽木"
		   text="『誰かに見られるかもしれない‥‥というキミの考えは正しい、既に何名かが私たちの痴漢プレイに気付き、先ほどからずっと見ているよ。』"
		   voices=""/>
		<msg @l="376" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥っ‥‥。』"
		   voices="miho06620"/>
		<msg @l="378" char_id="-1" frame_id="-1" name=""
		   text="彼の言葉に私はハッとして視線を周囲に巡らせると‥‥確かに、近くにいる男性の何人かがこちらをチラチラと見ていた。" voices=""/>
		<msg @l="380" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥～～っ‥‥‥。』"
		   voices="miho06630"/>
		<msg @l="382" char_id="-1" frame_id="-1" name=""
		   text="私は思わず言葉を失い、視線をそらすように深くうつむく。" voices=""/>
		<msg @l="383" char_id="-1" frame_id="-1" name="" text="逃げ出したかった。" voices=""/>
		<msg @l="384" char_id="-1" frame_id="-1" name=""
		   text="今すぐこの場所から走って逃げ出してしまいたかった。" voices=""/>
		<msg @l="385" char_id="-1" frame_id="-1" name=""
		   text="けれど、そうした事ができるわけも無く‥‥。" voices=""/>
		<msg @l="386" char_id="-1" frame_id="-1" name="" text="くちゅ、くちゅ、くちゅ。"
		   voices=""/>
		<msg @l="387" char_id="-1" frame_id="-1" name="" text="朽木教授の執拗な痴漢は未だ続いていた。"
		   voices=""/>
		<msg @l="389" char_id="0" frame_id="-1" name="美帆" text="(見られ‥‥ちゃった)"
		   voices="miho06640"/>
		<msg @l="391" char_id="0" frame_id="-1" name="美帆"
		   text="(痴漢されて濡らしちゃってるとこ、知らない人達に見られちゃったよ‥‥‥)" voices="miho06650"/>
		<msg @l="393" char_id="-1" frame_id="-1" name="" text="そう思った瞬間、頭の中が真っ白になった。"
		   voices=""/>
		<msg @l="394" char_id="-1" frame_id="-1" name=""
		   text="身体に絶え間なく加えられる刺激が、その隙に付け込むように‥‥私の心を支配していく。" voices=""/>
		<msg @l="396" char_id="-1" frame_id="-1" name="朽木"
		   text="『おや、キミのここがヒクついてきているぞ？』" voices=""/>
		<msg @l="398" char_id="-1" frame_id="-1" name="" text="教授は私の変化を見逃さなかった。"
		   voices=""/>
		<msg @l="399" char_id="-1" frame_id="-1" name="" text="くりっ。" voices=""/>
		<msg @l="401" char_id="0" frame_id="-1" name="美帆" text="『そんなっ‥‥‥んぁっっ！』"
		   voices="miho01710"/>
		<msg @l="403" char_id="-1" frame_id="-1" name=""
		   text="耐えられない恥ずかしさの淫涙で濡れた下着の上からぽってりとした割れ目とクリ○リスを擦り上げると、さらに女の精がグチュッと溢れ出して来てしまう。"
		   voices=""/>
		<msg @l="405" char_id="0" frame_id="-1" name="美帆" text="『んぅっ‥‥やっ‥‥‥。』"
		   voices="miho06660"/>
		<msg @l="407" char_id="-1" frame_id="-1" name="朽木"
		   text="『そうか、仲根クンは見られていると知って感じてしまったのだな。』" voices=""/>
		<msg @l="409" char_id="0" frame_id="-1" name="美帆" text="『ち、違いますっ‥‥‥。』"
		   voices="miho06670"/>
		<msg @l="411" char_id="-1" frame_id="-1" name="朽木"
		   text="『くくっ‥‥では、これは何なのかね？』" voices=""/>
		<msg @l="413" char_id="0" frame_id="-1" name="美帆" text="『あ‥‥ダメっ！』"
		   voices="miho06680"/>
		<msg @l="415" char_id="-1" frame_id="-1" name="" text="ぐちゅっ。" voices=""/>
		<msg @l="416" char_id="-1" frame_id="-1" name=""
		   text="教授の指が下着の隙間から侵入し、ねっとりとした泉で潤った割れ目をじかに撫であげる。" voices=""/>
		<msg @l="417" char_id="-1" frame_id="-1" name=""
		   text="指先で花液が溢れ出している花弁のまわりの花びらを押し開くと‥‥奥からは更に大量の蜜が溢れ出してくる。" voices=""/>
		<msg @l="418" char_id="-1" frame_id="-1" name="" text="ぐちゅ、ぐちょ。" voices=""/>
		<msg @l="420" char_id="0" frame_id="-1" name="美帆" text="(うぁ‥‥ダメ‥‥‥溢れてきちゃう)"
		   voices="miho01720"/>
		<msg @l="422" char_id="-1" frame_id="-1" name="朽木"
		   text="『こんなに濡らしてしまって‥‥ビチャビチャといやらしい音をたてて‥‥‥‥キミは本当悪い娘だな。』" voices=""/>
		<msg @l="424" char_id="0" frame_id="-1" name="美帆" text="『‥‥ぅぁ‥‥‥。』"
		   voices="miho06690"/>
		<msg @l="426" char_id="-1" frame_id="-1" name=""
		   text="私は言葉にならない悩ましい声を漏らし、耳元に添えられた教授の口から逃げるように顔を背ける。" voices=""/>
		<msg @l="428" char_id="-1" frame_id="-1" name="朽木"
		   text="『キミがどれほど否定したところで、身体は正直だよ。』" voices=""/>
		<msg @l="430" char_id="-1" frame_id="-1" name="" text="ずちゅっ。" voices=""/>
		<msg @l="432" char_id="0" frame_id="-1" name="美帆" text="『そんなっ‥‥‥んぁっっ！』"
		   voices="miho01710"/>
		<msg @l="434" char_id="-1" frame_id="-1" name=""
		   text="そう言って、彼は尚も快液で潤った割れ目の中へ、いやらしい音と共に指を入れる。" voices=""/>
		<msg @l="435" char_id="-1" frame_id="-1" name=""
		   text="壺口へ挿入した指先が蠢くたびに、ちゅくちゅくといういやらしい水音が鳴り、その水音さえも近くの乗客に聞かれていると思うと‥‥私は腰が砕けそうになった。"
		   voices=""/>
		<msg @l="437" char_id="0" frame_id="-1" name="美帆" text="『んっ、あっ‥‥‥ああっ‥‥‥‥。』"
		   voices="miho06700"/>
		<msg @l="439" char_id="-1" frame_id="-1" name=""
		   text="秘部内を指先で掻き混ぜられクリ○リスを転がされるたび、下腹部の辺りがジワジワと熱くなってくる。" voices=""/>
		<msg @l="440" char_id="-1" frame_id="-1" name=""
		   text="私はそれに抗うことも出来ず‥‥ただ、身を任せる。" voices=""/>
		<msg @l="441" char_id="-1" frame_id="-1" name="" text="ちゅく、ちゅく、ちゅく、ちゅく。"
		   voices=""/>
		<msg @l="443" char_id="0" frame_id="-1" name="美帆" text="『あふっ‥‥んっ、んんっ‥‥‥‥。』"
		   voices="miho06710"/>
		<msg @l="445" char_id="-1" frame_id="-1" name=""
		   text="押し殺そうと思っているのに、自然と声が漏れてしまう。" voices=""/>
		<msg @l="446" char_id="-1" frame_id="-1" name=""
		   text="そうして漏れる私の声に呼応するように淫らな中心部に入れた指を激しく抜き差しする。" voices=""/>
		<msg @l="447" char_id="-1" frame_id="-1" name=""
		   text="ぐちゅ、ぐちゅ、ぐちゅ、ぐちゅ、ぐちゅ、ぐちゅ。" voices=""/>
		<msg @l="449" char_id="0" frame_id="-1" name="美帆"
		   text="『ダメ、ダメぇ‥‥‥そんなにしたら、んくっ‥‥‥。』" voices="miho06720"/>
		<msg @l="451" char_id="-1" frame_id="-1" name="朽木" text="『そんなにしたら、何かね？』"
		   voices=""/>
		<msg @l="453" char_id="-1" frame_id="-1" name="" text="耳元で朽木教授の声がした。"
		   voices=""/>
		<msg @l="454" char_id="-1" frame_id="-1" name=""
		   text="声と共にオジさん特有の臭い吐息が掛かり、私は思わず背筋を仰け反らせて震えた。" voices=""/>
		<msg @l="456" char_id="0" frame_id="-1" name="美帆"
		   text="『へ、変になっちゃう‥‥‥それ以上したら、おかしくなっちゃいますっ‥‥‥。』" voices="miho06730"/>
		<msg @l="458" char_id="-1" frame_id="-1" name="朽木"
		   text="『くくっ‥‥いいぞ、そのまま達してしまうといい。』" voices=""/>
		<msg @l="460" char_id="-1" frame_id="-1" name=""
		   text="ぐちゅっ、ぐちゅっ、ぐちゅっ、ぐちゅっ、ぐちゅっ、ぐちゅっ。" voices=""/>
		<msg @l="462" char_id="0" frame_id="-1" name="美帆"
		   text="『そんなっ‥‥‥あっ、んんっ‥‥‥ああっ‥‥‥‥‥。』" voices="miho06740"/>
		<msg @l="464" char_id="-1" frame_id="-1" name=""
		   text="私は微かに残った理性で懸命に絶頂への加速を止めようとする。" voices=""/>
		<msg @l="465" char_id="-1" frame_id="-1" name=""
		   text="こんな電車の中でイってしまったら‥‥そんな事になったら‥‥‥。" voices=""/>
		<msg @l="466" char_id="-1" frame_id="-1" name=""
		   text="その思いが膨らむほどに、絶頂への欲求が高まり‥‥私を痺れさせる。" voices=""/>
		<msg @l="468" char_id="-1" frame_id="-1" name="朽木" text="『これでも‥‥我慢出来るかね？』"
		   voices=""/>
		<msg @l="470" char_id="-1" frame_id="-1" name="" text="くりっ、くりっ。" voices=""/>
		<msg @l="472" char_id="0" frame_id="-1" name="美帆" text="『んんんっ！？』"
		   voices="miho06750"/>
		<msg @l="474" char_id="-1" frame_id="-1" name=""
		   text="教授の指が、直接クリ○リスを激しく転がし始める。" voices=""/>
		<msg @l="475" char_id="-1" frame_id="-1" name=""
		   text="熱く硬く勃起した小さな尖塔を指の腹で擦り、爪弾き、押し潰す。" voices=""/>
		<msg @l="476" char_id="-1" frame_id="-1" name="" text="ぐりっ。" voices=""/>
		<msg @l="477" char_id="-1" frame_id="-1" name=""
		   text="その瞬間‥‥残った理性など軽く消し飛ぶほどの絶頂が、私を襲った。" voices=""/>
		<msg @l="479" char_id="0" frame_id="-1" name="美帆" text="『んっ‥‥んんんっ！！！』"
		   voices="miho06760"/>
		<msg @l="481" char_id="-1" frame_id="-1" name=""
		   text="理性が消し飛ぶ瞬間、私は自分の腕で口をふさいで強く洋服を噛む。" voices=""/>
		<msg @l="483" char_id="0" frame_id="-1" name="美帆"
		   text="(―――いく、いくいくいくいくっ‥‥‥いっちゃ、んんっ！！)" voices="miho06770"/>
		<flash @l="486" count="4" fade="100" image="white"/>
		<msg @l="488" char_id="0" frame_id="-1" name="美帆"
		   text="『んっ‥‥‥っ‥‥‥‥‥んっっ‥‥‥‥‥‥‥。』" voices="miho06780"/>
		<msg @l="490" char_id="-1" frame_id="-1" name=""
		   text="深く‥‥そして強い絶頂が私の身体を駆け抜けていく。" voices=""/>
		<msg @l="491" char_id="-1" frame_id="-1" name=""
		   text="小波のような戦慄が大きくなり、視界が真っ白になり、立っているのもやっとといった感じで‥‥手すりにしがみついた。" voices=""/>
		<msg @l="493" char_id="0" frame_id="-1" name="美帆"
		   text="『はっ‥‥んぁっ‥‥‥‥はぁ‥‥はぁ‥‥‥‥‥。』" voices="miho06790"/>
		<msg @l="495" char_id="-1" frame_id="-1" name="朽木" text="『イったようだな。』"
		   voices=""/>
		<msg @l="497" char_id="-1" frame_id="-1" name=""
		   text="絶頂の余韻と脱力感に震えている私の腰を抱き寄せながら、教授が笑う。" voices=""/>
		<clear @l="500" class="all"/>
		<label @l="503" id="event_scene09"/>
		<msg @l="505" char_id="-1" frame_id="-1" name="朽木"
		   text="『では、次は私のモノをお願いするとしようか。』" voices=""/>
		<msg @l="507" char_id="0" frame_id="-1" name="美帆" text="『え‥‥。』"
		   voices="miho06800"/>
		<label @l="510" id="chart_line8"/>
		<wait_chgmv/>
		<ev @l="513" src="ev-009a"/>
		<msg @l="515" char_id="-1" frame_id="-1" name=""
		   text="教授はズボンのチャックを下ろすと、既に硬く勃起している肉棒を恥ずかしげもなく晒す。" voices=""/>
		<msg @l="516" char_id="-1" frame_id="-1" name=""
		   text="チャックから飛び出したソレはヘソの下につくほど直立した。" voices=""/>
		<msg @l="517" char_id="-1" frame_id="-1" name=""
		   text="そうして私の手を取ると、そそり勃ったペニスにかぶせるように押し付けてきた。" voices=""/>
		<msg @l="519" char_id="0" frame_id="-1" name="美帆" text="『うぁ‥‥。』"
		   voices="miho06810"/>
		<msg @l="521" char_id="-1" frame_id="-1" name=""
		   text="手のひらに触れた男根はとても熱く、なにより硬い。" voices=""/>
		<msg @l="522" char_id="-1" frame_id="-1" name=""
		   text="思えば、こんな風になった男の人のモノを触るのは‥‥初めてだ。" voices=""/>
		<msg @l="523" char_id="-1" frame_id="-1" name=""
		   text="びくびく脈をうち、凶悪な赤銅色をした肉棒は太い血管が這い回っている。" voices=""/>
		<msg @l="524" char_id="-1" frame_id="-1" name="" text="凄く熱く、私の手のひらに伝わってくる。"
		   voices=""/>
		<msg @l="525" char_id="-1" frame_id="-1" name=""
		   text="手に伝わってくる感触は、グロテスクで気持ちが悪かった。" voices=""/>
		<msg @l="527" char_id="-1" frame_id="-1" name="朽木" text="『さあ、しごいてもらおうか。』"
		   voices=""/>
		<msg @l="529" char_id="0" frame_id="-1" name="美帆" text="『え、でも‥‥こんな所で‥‥。』"
		   voices="miho06820"/>
		<msg @l="531" char_id="-1" frame_id="-1" name="朽木" text="『しごいてもらえるよね････。』"
		   voices=""/>
		<msg @l="533" char_id="-1" frame_id="-1" name="" text="朽木は有無を言わさない表情で美帆を見る。"
		   voices=""/>
		<msg @l="535" char_id="0" frame_id="-1" name="美帆" text="『う‥‥わ、わかりました。』"
		   voices="miho06830"/>
		<msg @l="537" char_id="-1" frame_id="-1" name="" text="ゆっくりと‥‥手のひらで肉棒を包みこむ。"
		   voices=""/>
		<msg @l="539" char_id="0" frame_id="-1" name="美帆"
		   text="(なにこれ‥‥‥凄い、脈打ってる‥‥‥)" voices="miho06840"/>
		<msg @l="541" char_id="-1" frame_id="-1" name=""
		   text="手のひらの中で脈打つ凶悪な生き物に驚きながらも、私は教授に言われた通りにそれをしごき始める。" voices=""/>
		<msg @l="543" char_id="-1" frame_id="-1" name="朽木"
		   text="『おお、そうだ‥‥柔らかい手が堪らないな。』" voices=""/>
		<msg @l="545" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥っ‥‥。』"
		   voices="miho06850"/>
		<msg @l="547" char_id="-1" frame_id="-1" name=""
		   text="教授の言葉に‥‥私は自分の頬が一気に紅潮していくのがわかった。" voices=""/>
		<msg @l="548" char_id="-1" frame_id="-1" name=""
		   text="痴漢されているならまだしも、こんな電車の中で男の人のモノを握っているなんて‥‥‥。" voices=""/>
		<msg @l="550" char_id="-1" frame_id="-1" name="朽木"
		   text="『もっと指先を絡めて、しっかりとしごかねば私は満足しないぞ。』" voices=""/>
		<msg @l="552" char_id="0" frame_id="-1" name="美帆" text="『は‥‥はい‥‥‥。』"
		   voices="miho06860"/>
		<msg @l="554" char_id="-1" frame_id="-1" name=""
		   text="言われるまま、私は硬く怒張した肉棒に指先を絡めて、ゆっくりと上下にしごいていく。" voices=""/>
		<msg @l="555" char_id="-1" frame_id="-1" name=""
		   text="熱く‥‥そして硬い男根のいびつな形に添って、私は指を動かした。" voices=""/>
		<msg @l="557" char_id="-1" frame_id="-1" name="朽木"
		   text="『いいぞ、キミはなかなか素質があるな。』" voices=""/>
		<msg @l="559" char_id="0" frame_id="-1" name="美帆" text="『そんなの‥‥嬉しくないです。』"
		   voices="miho06870"/>
		<msg @l="561" char_id="-1" frame_id="-1" name="朽木"
		   text="『いずれ、自分から進んで欲しがるようになる。』" voices=""/>
		<msg @l="563" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』"
		   voices="miho06880"/>
		<msg @l="565" char_id="-1" frame_id="-1" name=""
		   text="教授の言葉に私は眉をひそめて、肉棒をしごく手の動きに集中する。" voices=""/>
		<msg @l="566" char_id="-1" frame_id="-1" name=""
		   text="自分がこんな行為を進んでやるようになるとは到底思えない。" voices=""/>
		<msg @l="567" char_id="-1" frame_id="-1" name=""
		   text="けれど‥‥きっと朽木教授は、私にそうなることを求めるだろう。" voices=""/>
		<msg @l="568" char_id="-1" frame_id="-1" name=""
		   text="ならば私は、言う通りにしなければいけない。形だけでも。" voices=""/>
		<msg @l="569" char_id="-1" frame_id="-1" name="" text="父のために‥‥家族を守るために。"
		   voices=""/>
		<msg @l="571" char_id="0" frame_id="-1" name="美帆" text="『はっ‥‥はっ‥‥‥。』"
		   voices="miho06890"/>
		<msg @l="573" char_id="-1" frame_id="-1" name=""
		   text="気付けば私の口からは荒い吐息が漏れていた。" voices=""/>
		<msg @l="574" char_id="-1" frame_id="-1" name=""
		   text="額には‥‥いつしか玉のような汗が浮かんでいる。" voices=""/>
		<msg @l="575" char_id="-1" frame_id="-1" name=""
		   text="先端の‥‥亀頭の付け根の部分に親指と人差し指でつくったリングで添えてしごく。" voices=""/>
		<msg @l="577" char_id="0" frame_id="-1" name="美帆" text="『んんっ‥‥んっ‥‥‥。』"
		   voices="miho06900"/>
		<msg @l="579" char_id="-1" frame_id="-1" name="朽木"
		   text="『ああ‥‥いいぞ、そのまま強くしごき続けていろ。』" voices=""/>
		<msg @l="581" char_id="-1" frame_id="-1" name=""
		   text="教授は先から淫汁をダラダラと零し、肉棒をしごき上げる私の動きに合わせて息を荒げる。" voices=""/>
		<msg @l="582" char_id="-1" frame_id="-1" name=""
		   text="指先と手のひらにはそれまで以上に激しい脈動を感じ、心なしか陰茎の大きさと硬さが増しているような気がした。" voices=""/>
		<msg @l="583" char_id="-1" frame_id="-1" name=""
		   text="グチュグチュと粘りつく淫汁が指のリングで肉柱をしごきあげるたびに、淫猥な音を社内に響かせる。" voices=""/>
		<msg @l="585" char_id="-1" frame_id="-1" name="朽木" text="『くっ‥‥いくぞっ！』"
		   voices=""/>
		<msg @l="587" char_id="0" frame_id="-1" name="美帆" text="『え‥‥！？』"
		   voices="miho06910"/>
		<msg @l="590" async="true" char_id="-1" frame_id="-1" name=""
		   text="どこに出す‥‥？" voices=""/>
		<select @l="591">
			<menu @l="594" label="EventLabel_101" text="手のひら"/>
			<menu @l="597" label="EventLabel_102" text="スカート"/>
		</select>
		<label @l="603" id="EventLabel_101"/>
		<flash @l="606" count="4" fade="100" image="white"/>
		<wait_chgmv/>
		<ev @l="608" src="ev-009ax1z1"/>
		<msg @l="610" char_id="0" frame_id="-1" name="美帆" text="『きゃっ！？』"
		   voices="miho06920"/>
		<msg @l="612" char_id="-1" frame_id="-1" name=""
		   text="教授は男幹を握らせていた私の手のひらで先端部分を覆うと、大きく腰を震わせて手のひらの中へ熱い白濁をびゅるびゅると撒き散らす。"
		   voices=""/>
		<msg @l="614" char_id="0" frame_id="-1" name="美帆" text="『うあ‥‥‥これ、精液‥‥‥？』"
		   voices="miho06930"/>
		<msg @l="616" char_id="-1" frame_id="-1" name=""
		   text="手のひらに撒き散らされた淫欲のエネルギーを、私は困惑の表情で眺める。" voices=""/>
		<msg @l="617" char_id="-1" frame_id="-1" name=""
		   text="熱い‥‥そして粘ついた白濁色の熱い汁が、手のひらを伝ってゆっくりと床へ白い糸を引きながら零れ落ちていった。" voices=""/>
		<goto @l="620" label="EventLabel_103"/>
		<label @l="624" id="EventLabel_102"/>
		<msg @l="626" char_id="-1" frame_id="-1" name=""
		   text="私の手の上から、朽木教授が手をかぶせてごしごしと黒光りする砲身をこする。" voices=""/>
		<msg @l="627" char_id="-1" frame_id="-1" name=""
		   text="そうして発射する直前に‥‥教授は砲口を私の太腿の辺りに向けた。" voices=""/>
		<flash @l="630" count="4" fade="100" image="white"/>
		<wait_chgmv/>
		<ev @l="633" src="ev-009by1z2"/>
		<msg @l="635" char_id="0" frame_id="-1" name="美帆" text="『あ‥‥。』"
		   voices="miho06940"/>
		<msg @l="637" char_id="-1" frame_id="-1" name=""
		   text="肉棒の先端から何かが飛び出したかと思うと、それは私のスカートへと撒き散らされる。" voices=""/>
		<msg @l="639" char_id="0" frame_id="-1" name="美帆"
		   text="(な、何これ‥‥‥もしかして‥‥‥‥精液‥‥？)" voices="miho06950"/>
		<msg @l="641" char_id="-1" frame_id="-1" name=""
		   text="スカートに撒き散らされた熱い飛沫を、私は困惑の表情で眺める。" voices=""/>
		<msg @l="642" char_id="-1" frame_id="-1" name=""
		   text="初めて見る男性の欲液は話に聞いていたのと同じく白濁色で、私はしばらく放心したようにそれを見つめていた。" voices=""/>
		<label @l="645" id="EventLabel_103"/>
		<stopbgm @l="648" fadeout="1000"/>
		<clear @l="651" class="all"/>
		<msg @l="653" char_id="-1" frame_id="-1" name="アナウンス"
		   text="『次は終点‥‥大学前、大学前です。』" voices=""/>
		<msg @l="655" char_id="-1" frame_id="-1" name="アナウンス"
		   text="『手荷物のお忘れ物などありませんようご注意ください。』" voices=""/>
		<stopse @l="658" buf="3"/>
		<msg @l="660" char_id="-1" frame_id="-1" name=""
		   text="車内アナウンスが流れ、電車がわずかに減速し始める。" voices=""/>
		<msg @l="661" char_id="-1" frame_id="-1" name=""
		   text="それにあわせて車内は降車の準備で慌しくなり、気付けば私の背後にいたハズの朽木教授の姿がなくなっていた。" voices=""/>
		<msg @l="663" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』"
		   voices="miho06960"/>
		<msg @l="665" char_id="0" frame_id="-1" name="美帆" text="(こんなこと‥‥ずっと続くのかな)"
		   voices="miho06970"/>
		<msg @l="667" char_id="-1" frame_id="-1" name=""
		   text="私は呆然としたまま撒き散らされた精液もそのままに、立ちつくしていた。" voices=""/>
		<clear @l="670" class="all"/>
		<end_scene @l="673"/>
		<msgshow @l="676" show="true"/>
		<wait_chgmv/>
		<bg @l="679" src="bg09"/>
		<bgm @l="682" src="bgm03" volume="1."/>
		<char @l="685" id="miho" pos="auto" src="miho115"/>
		<msg @l="687" char_id="0" frame_id="-1" name="美帆" text="『はぁ‥‥。』" voices=""/>
		<msg @l="689" char_id="-1" frame_id="-1" name="女友達"
		   text="『まーたタメ息吐いてる。アンタ今日ちょっと辛気臭いよ？』" voices=""/>
		<char @l="692" id="miho" pos="auto" src="miho016"/>
		<msg @l="694" char_id="0" frame_id="-1" name="美帆" text="『え‥‥あ、ごめん。』"
		   voices=""/>
		<msg @l="696" char_id="-1" frame_id="-1" name=""
		   text="二限目が終わって昼食を取り終えた後―――。" voices=""/>
		<msg @l="697" char_id="-1" frame_id="-1" name=""
		   text="私は講義友達の女の子と二人で、残った時間をどう過ごそうかと話をしながら廊下を歩いていた。" voices=""/>
		<msg @l="698" char_id="-1" frame_id="-1" name=""
		   text="ただ、気付くと私はため息を漏らしているらしく‥‥その度に講義友達の子に「辛気臭い」だの「鬱陶しい」だのと言われてしまっている。"
		   voices=""/>
		<msg @l="700" char_id="0" frame_id="-1" name="美帆" text="『ちょっとね‥‥疲れてるのかも。』"
		   voices=""/>
		<msg @l="702" char_id="-1" frame_id="-1" name="女友達" text="『なーにが疲れてるかも、よ。』"
		   voices=""/>
		<msg @l="704" char_id="-1" frame_id="-1" name="女友達"
		   text="『私たちは若者よ？&#32;ヤングマンよ？』" voices=""/>
		<msg @l="706" char_id="0" frame_id="-1" name="美帆"
		   text="『どちらかというとヤングウーマンだと思うけど‥‥。』" voices=""/>
		<msg @l="708" char_id="-1" frame_id="-1" name="女友達"
		   text="『あら、突っ込みを入れる元気はあるじゃないの？』" voices=""/>
		<msg @l="710" char_id="-1" frame_id="-1" name="女友達"
		   text="『アンタもあたしもまだ現役バリバリ、華の乙女なんだから、疲れたどーとかいってないで元気を出す！』" voices=""/>
		<char @l="713" id="miho" pos="auto" src="miho011"/>
		<msg @l="715" char_id="0" frame_id="-1" name="美帆" text="『あはは‥‥‥うん、そうだね。』"
		   voices=""/>
		<bgm @l="718" src="bgm04" volume="1."/>
		<msg @l="720" char_id="-1" frame_id="-1" name="女友達" text="『うむ、わかれば良いのだよ。』"
		   voices=""/>
		<msg @l="722" char_id="-1" frame_id="-1" name="" text="そう言って彼女は大きく胸を張って見せる。"
		   voices=""/>
		<msg @l="723" char_id="-1" frame_id="-1" name=""
		   text="彼女なりに‥‥元気づけてくれているのかもしれない。" voices=""/>
		<msg @l="725" char_id="0" frame_id="-1" name="美帆"
		   text="『さて、それじゃあこれからどう‥‥‥。』" voices=""/>
		<stopbgm @l="728" fadeout="1000"/>
		<clear @l="730" class="char"/>
		<char @l="732" id="miho" pos="center" src="miho014f" y="-80"/>
		<msg @l="734" char_id="-1" frame_id="-1" name="" text="不意に言葉が止まる。" voices=""/>
		<msg @l="735" char_id="-1" frame_id="-1" name="" text="視界の端に入った‥‥ひとつの人影。"
		   voices=""/>
		<msg @l="736" char_id="-1" frame_id="-1" name=""
		   text="その人影はこちらに背中を向けて立っているけれど、私にはそれが誰なのかすぐにわかった。" voices=""/>
		<bgm @l="739" src="bgm15" volume="1."/>
		<char @l="742" id="miho" pos="center" src="miho115f" y="-80"/>
		<msg @l="744" char_id="0" frame_id="-1" name="美帆" text="『朽木‥‥教授‥‥‥』"
		   voices=""/>
		<msg @l="746" char_id="-1" frame_id="-1" name="女友達" text="『なになに、どーしたの？』"
		   voices=""/>
		<clear @l="749" class="char"/>
		<char @l="751" id="miho" pos="auto" src="miho016"/>
		<msg @l="753" char_id="0" frame_id="-1" name="美帆"
		   text="『あ、ううん‥‥ちょっと急用を思い出して。』" voices=""/>
		<msg @l="755" char_id="-1" frame_id="-1" name="女友達" text="『急用？&#32;なにそれ？』"
		   voices=""/>
		<msg @l="757" char_id="0" frame_id="-1" name="美帆"
		   text="『えっと、大したことじゃないから‥‥悪いけど先に教室行ってて。』" voices=""/>
		<msg @l="759" char_id="-1" frame_id="-1" name="女友達"
		   text="『教室っても、次の講義が始まるまであと３０分もあるし‥‥。』" voices=""/>
		<msg @l="761" char_id="-1" frame_id="-1" name="女友達"
		   text="『あ、なんならあたしもついてって‥‥。』" voices=""/>
		<char @l="764" id="miho" pos="auto" src="miho115"/>
		<msg @l="766" char_id="0" frame_id="-1" name="美帆" text="『ダメっ！！』" voices=""/>
		<msg @l="768" char_id="-1" frame_id="-1" name="女友達" text="『え‥‥。』" voices=""/>
		<char @l="771" id="miho" pos="auto" src="miho016"/>
		<msg @l="773" char_id="0" frame_id="-1" name="美帆" text="『あ‥‥ご、ごめん。』"
		   voices=""/>
		<msg @l="775" char_id="0" frame_id="-1" name="美帆"
		   text="『ほんと、何でもないから‥‥‥‥お願い‥‥先に行ってて。』" voices=""/>
		<msg @l="777" char_id="-1" frame_id="-1" name="女友達"
		   text="『わ、わかった‥‥んじゃまた後で。』" voices=""/>
		<msg @l="779" char_id="-1" frame_id="-1" name=""
		   text="私の剣幕におされるように、講義友達の子は足早に去っていく。" voices=""/>
		<msg @l="780" char_id="-1" frame_id="-1" name=""
		   text="それもそうだろう‥‥彼女の前であんな風に大きい声を出したのは、初めての事だ。" voices=""/>
		<msg @l="782" char_id="-1" frame_id="-1" name="声"
		   text="『心配してくれる友人に、キミは酷い事をするな。』" voices=""/>
		<msg @l="784" char_id="-1" frame_id="-1" name=""
		   text="講義友達の子が立ち去るのを確認した後、例の人影がそう言ってこちらを振り返る。" voices=""/>
		<clear @l="787" class="char"/>
		<char @l="789" id="miho" pos="left" src="miho115"/>
		<char @l="791" id="kutsu" pos="right" src="kutsu010"/>
		<msg @l="793" char_id="-1" frame_id="-1" name="朽木"
		   text="『あんな事をして、後で気まずくなってしまうのではないのかね？』" voices=""/>
		<msg @l="795" char_id="0" frame_id="-1" name="美帆" text="『‥‥彼女はきっと、解ってくれます。』"
		   voices=""/>
		<msg @l="797" char_id="-1" frame_id="-1" name="朽木"
		   text="『フフフ、それは失礼。熱い友情の絆で結ばれているというわけか。』" voices=""/>
		<msg @l="799" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<char @l="802" id="miho" pos="left" src="miho015"/>
		<msg @l="804" char_id="0" frame_id="-1" name="美帆"
		   text="『そんなことより‥‥待ち伏せなんて止めてください。迷惑です。』" voices=""/>
		<char @l="807" id="kutsu" pos="right" src="kutsu018"/>
		<msg @l="809" char_id="-1" frame_id="-1" name="朽木"
		   text="『迷惑？&#32;キミにそんな口を利ける権利があると思っているのかね？』" voices=""/>
		<char @l="812" id="miho" pos="left" src="miho115"/>
		<msg @l="814" char_id="0" frame_id="-1" name="美帆"
		   text="『そ、それはっ‥‥朝のこと‥‥‥受け入れているじゃないですか。』" voices=""/>
		<msg @l="816" char_id="-1" frame_id="-1" name="朽木" text="『ああ、あんなモノは序の口だよ。』"
		   voices=""/>
		<msg @l="818" char_id="-1" frame_id="-1" name="朽木"
		   text="『あの程度で終わると思ったら大間違いだ。』" voices=""/>
		<char @l="821" id="miho" pos="left" src="miho114"/>
		<msg @l="823" char_id="0" frame_id="-1" name="美帆" text="『そんなっ！』" voices=""/>
		<char @l="826" id="kutsu" pos="right" src="kutsu010"/>
		<msg @l="828" char_id="-1" frame_id="-1" name="朽木"
		   text="『キミは自分が口にした契約の言葉を忘れたのかね？』" voices=""/>
		<char @l="831" id="miho" pos="left" src="miho115"/>
		<msg @l="833" char_id="0" frame_id="-1" name="美帆" text="『忘れてなんかいません‥‥でもっ。』"
		   voices=""/>
		<msg @l="835" char_id="-1" frame_id="-1" name="朽木"
		   text="『なんなら、この場で大声をあげて確認させても構わないが？』" voices=""/>
		<char @l="838" id="miho" pos="left" src="miho015"/>
		<msg @l="840" char_id="0" frame_id="-1" name="美帆"
		   text="『や、やめてくださいっ‥‥‥お願いします。』" voices=""/>
		<char @l="843" id="kutsu" pos="right" src="kutsu018"/>
		<msg @l="845" char_id="-1" frame_id="-1" name="朽木"
		   text="『くくっ‥‥キミは本当にいい目をする。』" voices=""/>
		<msg @l="847" char_id="-1" frame_id="-1" name="朽木"
		   text="『キミのそのすがりつくような目を見ているだけで、私のモノはいきり勃ってしまうよ。』" voices=""/>
		<clear @l="850" layer="kutsu"/>
		<char @l="852" id="kutsu" pos="auto" src="kutsu018"/>
		<msg @l="854" char_id="-1" frame_id="-1" name=""
		   text="そう言って、教授は私の手を取りズボンの股間へと押し付けてくる。" voices=""/>
		<msg @l="855" char_id="-1" frame_id="-1" name=""
		   text="確かに‥‥教授のそこはズボンの上からでも解るほど硬く膨張していた。" voices=""/>
		<msg @l="857" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥っ‥‥。』" voices=""/>
		<clear @l="860" class="char"/>
		<char @l="862" id="kutsu" pos="right" src="kutsu010"/>
		<msg @l="864" char_id="-1" frame_id="-1" name="朽木"
		   text="『そうだ‥‥仲根クン、これから教授室まで来たまえ。』" voices=""/>
		<msg @l="866" char_id="-1" frame_id="-1" name="朽木"
		   text="『こいつで、たっぷり可愛がってあげようじゃないか。』" voices=""/>
		<msg @l="868" char_id="0" frame_id="-1" name="美帆"
		   text="『そ、そんな‥‥‥だって、朝に‥‥‥。』" voices=""/>
		<msg @l="870" char_id="-1" frame_id="-1" name="朽木"
		   text="『生憎、私は一度くらいで満足できるほど老いてはいないのだよ。』" voices=""/>
		<msg @l="872" char_id="-1" frame_id="-1" name="朽木" text="『さあ‥‥早くついてきたまえ。』"
		   voices=""/>
		<clear @l="875" layer="kutsu"/>
		<msg @l="877" char_id="-1" frame_id="-1" name=""
		   text="教授はそして、私の腰に手を回して教授室のある校舎へ歩き出そうとする。" voices=""/>
		<msg @l="881" async="true" char_id="-1" frame_id="-1" name=""
		   text="朽木の誘いに‥‥？" voices=""/>
		<select @l="882">
			<menu @l="885" label="EventLabel_104" text="従う"/>
			<menu @l="888" label="EventLabel_110" text="拒む"/>
		</select>
		<label @l="895" id="EventLabel_104"/>
		<clear @l="898" class="char"/>
		<char @l="900" id="miho" pos="auto" src="miho115"/>
		<msg @l="902" char_id="0" frame_id="-1" name="美帆" text="『‥‥わかりました。』"
		   voices=""/>
		<msg @l="904" char_id="-1" frame_id="-1" name=""
		   text="教授の言葉に頷いて、私はゆっくりと歩き始める。" voices=""/>
		<msg @l="905" char_id="-1" frame_id="-1" name="" text="これから何をされるのか‥‥わかっていた。"
		   voices=""/>
		<msg @l="906" char_id="-1" frame_id="-1" name="" text="それでも‥‥。" voices=""/>
		<msg @l="907" char_id="-1" frame_id="-1" name=""
		   text="それでも私は‥‥朽木教授に言葉に逆らうわけにはいかない。" voices=""/>
		<msg @l="909" char_id="0" frame_id="-1" name="美帆" text="(お父さん‥‥私‥‥‥‥耐えるから)"
		   voices=""/>
		<msg @l="911" char_id="0" frame_id="-1" name="美帆"
		   text="(何があっても‥‥‥ちゃんと、耐えてみせるから‥‥‥)" voices=""/>
		<msg @l="913" char_id="-1" frame_id="-1" name=""
		   text="‥‥自分に言い聞かせるように私はつぶやいていた。" voices=""/>
		<stopbgm @l="916" fadeout="1000"/>
		<clear @l="919" class="all"/>
		<bgm @l="922" src="bgm09" volume="1."/>
		<msg @l="924" char_id="-1" frame_id="-1" name="朽木" text="『さあ、遠慮なく入りたまえ。』"
		   voices=""/>
		<msg @l="926" char_id="0" frame_id="-1" name="美帆" text="『‥‥はい。』" voices=""/>
		<wait_chgmv/>
		<bg @l="929" src="bg12"/>
		<char @l="932" id="miho" pos="left" src="miho015"/>
		<char @l="935" id="kutsu" pos="right" src="kutsu010"/>
		<msg @l="937" char_id="-1" frame_id="-1" name="" text="教授室に通される。" voices=""/>
		<msg @l="938" char_id="-1" frame_id="-1" name=""
		   text="朽木教授は先に私を部屋の中に入れると、後ろ手で扉を閉めて鍵をかける。" voices=""/>
		<msg @l="940" char_id="0" frame_id="-1" name="美帆" text="『あ、あの‥‥な、何をするんですか？』"
		   voices=""/>
		<char @l="943" id="kutsu" pos="right" src="kutsu018"/>
		<msg @l="945" char_id="-1" frame_id="-1" name="朽木"
		   text="『ククク、今日は特別可愛い君の為に個人指導をしてあげようというのだよ、仲根くん。』" voices=""/>
		<char @l="948" id="miho" pos="left" src="miho115"/>
		<msg @l="950" char_id="0" frame_id="-1" name="美帆"
		   text="『お、お願いです‥‥ゆ、許してください‥‥‥。』" voices=""/>
		<msg @l="952" char_id="-1" frame_id="-1" name="朽木"
		   text="『許す？何を許すというのだね？私は君がして欲しいというからしてあげるのだよ、違うかね？クククク。』" voices=""/>
		<msg @l="954" char_id="0" frame_id="-1" name="美帆" text="『そ、そんな‥‥。』"
		   voices=""/>
		<char @l="957" id="kutsu" pos="right" src="kutsu010"/>
		<msg @l="959" char_id="-1" frame_id="-1" name="朽木" text="『違うのかね？』" voices=""/>
		<char @l="962" id="miho" pos="left" src="miho015"/>
		<msg @l="964" char_id="0" frame_id="-1" name="美帆" text="『‥‥は、はい‥‥‥そう‥です‥‥。』"
		   voices=""/>
		<char @l="967" id="kutsu" pos="right" src="kutsu018"/>
		<msg @l="969" char_id="-1" frame_id="-1" name="朽木"
		   text="『じゃあ、身体を調べて欲しいということだったな。早速服を脱ぎたまえ。』" voices=""/>
		<char @l="972" id="miho" pos="left" src="miho115"/>
		<msg @l="974" char_id="0" frame_id="-1" name="美帆"
		   text="『えっ、ふ、服を‥脱ぐんですか‥‥‥？』" voices=""/>
		<msg @l="976" char_id="-1" frame_id="-1" name="朽木"
		   text="『何度も言わせる気かね？私は構わないのだよ、君がどんなに困ることになってもな。』" voices=""/>
		<msg @l="978" char_id="0" frame_id="-1" name="美帆" text="『はい‥わかりました‥‥。』"
		   voices=""/>
		<clear @l="981" class="char"/>
		<msg @l="983" char_id="-1" frame_id="-1" name=""
		   text="私は覚悟を決めるように大きく深呼吸をすると、ブラウスのボタンに震える指先をかけて一つずつ外していく。" voices=""/>
		<msg @l="984" char_id="-1" frame_id="-1" name="" text="諦めていた。" voices=""/>
		<msg @l="985" char_id="-1" frame_id="-1" name="" text="父を、家族を救う為に仕方のないことだと。"
		   voices=""/>
		<msg @l="986" char_id="-1" frame_id="-1" name=""
		   text="が悔しさから唇を噛み締め、涙ぐんでしまう。" voices=""/>
		<msg @l="987" char_id="-1" frame_id="-1" name=""
		   text="私はゆっくりと、胸のボタンをひとつひとつ外していった。" voices=""/>
		<char @l="990" id="miho" pos="auto" src="miho185"/>
		<msg @l="992" char_id="0" frame_id="-1" name="美帆" text="『こ、これでいいですか‥‥？』"
		   voices=""/>
		<clear @l="995" class="char"/>
		<char @l="997" id="miho" pos="left" src="miho185"/>
		<char @l="999" id="kutsu" pos="right" src="kutsu018"/>
		<msg @l="1000" char_id="-1" frame_id="-1" name="朽木"
		   text="『君の下着姿を見るのはこれが初めてだな。ククク、それじゃあ下着も脱いでもらおうか。』" voices=""/>
		<msg @l="1002" char_id="0" frame_id="-1" name="美帆" text="『‥‥わかりました‥‥。』"
		   voices=""/>
		<clear @l="1005" class="char"/>
		<msg @l="1007" char_id="-1" frame_id="-1" name=""
		   text="私は諦めの思いを胸に抱きながらゆっくりとブラジャーのホックを外し、ソファの上に脱ぎ捨てる。まだ誰にも見られたことのない胸が、いやらしい笑みをうかべる朽木教授の前に晒される。"
		   voices=""/>
		<msg @l="1009" char_id="-1" frame_id="-1" name="朽木" text="『手で隠そうとしてはダメだ。』"
		   voices=""/>
		<msg @l="1011" char_id="0" frame_id="-1" name="美帆"
		   text="『は、はいっ‥‥すみません‥‥‥‥。』" voices=""/>
		<msg @l="1013" char_id="-1" frame_id="-1" name=""
		   text="教授の言葉に肩を震わせ‥‥あらわになった胸もそのままに、ゆっくりとショーツを下ろしていく。" voices=""/>
		<char @l="1016" id="miho" pos="auto" src="miho105"/>
		<msg @l="1018" char_id="0" frame_id="-1" name="美帆" text="『ぜ、全部‥‥脱ぎ終わりました。』"
		   voices=""/>
		<msg @l="1020" char_id="-1" frame_id="-1" name=""
		   text="胸と股間に朽木教授のまとわりつくような視線を感じる。私は恥ずかしさのあまり顔を背け、涙の溢れてくる目をギュッとつぶって耐える。"
		   voices=""/>
		<msg @l="1022" char_id="-1" frame_id="-1" name="朽木"
		   text="『よろしい、それでは机の上に横になりたまえ。』" voices=""/>
		<clear @l="1025" class="all"/>
		<msg @l="1027" char_id="-1" frame_id="-1" name="朽木"
		   text="『おっと、その前に一つ備えを作っておこうか。』" voices=""/>
		<msg @l="1029" char_id="-1" frame_id="-1" name=""
		   text="そう言って教授は机の上に横たわった私の両腕を掴むと、棚からロープを手繰り寄せてグルグルと縛り始める。" voices=""/>
		<msg @l="1031" char_id="0" frame_id="-1" name="美帆" text="『やっ‥‥な、何をするんですか？』"
		   voices=""/>
		<msg @l="1033" char_id="-1" frame_id="-1" name="朽木" text="『暴れぬように縛り付けておく。』"
		   voices=""/>
		<msg @l="1035" char_id="0" frame_id="-1" name="美帆"
		   text="『こっ、こんな、無理やりみたいにっ‥‥‥。』" voices=""/>
		<msg @l="1037" char_id="-1" frame_id="-1" name="朽木"
		   text="『無理やりな訳がないだろう？もちろんたっぷり優しくするつもりだがね‥‥まあ、備えのようなモノだよ。』" voices=""/>
		<msg @l="1039" char_id="-1" frame_id="-1" name="朽木"
		   text="『キミが暴れさえしなければ、それで済む問題だ。』" voices=""/>
		<msg @l="1041" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="1043" char_id="-1" frame_id="-1" name=""
		   text="もしかしたら私は、とんでもない間違いをおかしてしまったんじゃないだろうか‥‥。" voices=""/>
		<msg @l="1044" char_id="-1" frame_id="-1" name=""
		   text="強い絶望感と頭が真っ白になるほどの恥ずかしさで私は、まともな思考が出来なくなっていたのかもしれない。理由は何にせよ、密室で朽木教授の前に無防備に拘束されている今では、全てが手遅れだった‥‥。"
		   voices=""/>
		<label @l="1047" id="event_scene08"/>
		<bgm @l="1050" src="bgm14" volume="1."/>
		<label @l="1053" id="chart_line41"/>
		<wait_chgmv/>
		<ev @l="1056" src="ev-008a"/>
		<description @l="1059" text="散らされる純潔"/>
		<msg @l="1061" char_id="0" frame_id="-1" name="美帆" text="『んんっ‥‥。』"
		   voices="miho06980"/>
		<msg @l="1063" char_id="-1" frame_id="-1" name=""
		   text="教授の両手が、直接、弾みそうな弾力を持つ乳房を触ってくる。大きく手のひらで左右の乳房を掴み、二本の指の腹でピンクの色を持つ乳首を押し込まれると嫌悪感に身体を強張らせる。"
		   voices=""/>
		<msg @l="1065" char_id="-1" frame_id="-1" name="朽木"
		   text="『なかなかいい形のおっぱいをしてるじゃないか。』" voices=""/>
		<msg @l="1067" char_id="-1" frame_id="-1" name=""
		   text="その膨らみは水密桃（すいみつとう）のようにみずみずしく、その感触に朽木は満足気であった。" voices=""/>
		<msg @l="1068" char_id="0" frame_id="-1" name="美帆"
		   text="『んっ‥‥あっ、んんっ‥‥‥あ、ああっ‥‥‥‥。』" voices="miho07000"/>
		<msg @l="1070" char_id="-1" frame_id="-1" name=""
		   text="胸の先っちょに電気を流されたような刺激を感じ、たまらず身悶える。教授は身を乗り出して乳房を戯奔（ぎほん）し、硬くなりかけている乳首に吸い付いてきた。"
		   voices=""/>
		<msg @l="1072" char_id="0" frame_id="-1" name="美帆"
		   text="『ああっ‥‥はっ、はっ、はっ‥‥‥‥‥ん、あくっ‥‥‥。』" voices="miho07010"/>
		<msg @l="1074" char_id="-1" frame_id="-1" name=""
		   text="その反応を上目遣いで見ながら、左手で豊か過ぎるほどの白い球体の上にある紅い実を親指の腹でこね、もう片方の乳首を舌で転がしてくる。"
		   voices=""/>
		<msg @l="1076" char_id="0" frame_id="-1" name="美帆" text="『ん、あああっ！？』"
		   voices="miho10070"/>
		<msg @l="1078" char_id="-1" frame_id="-1" name=""
		   text="私は抵抗したいのだが、その行動とは裏腹の身体はブルッと震えた。" voices=""/>
		<msg @l="1080" char_id="-1" frame_id="-1" name="朽木"
		   text="『美味だな。このようなご馳走にありつけるとは‥‥』" voices=""/>
		<msg @l="1082" char_id="-1" frame_id="-1" name=""
		   text="教授は乳房を汚すようにべっとりと唾液を塗しこんだ。" voices=""/>
		<msg @l="1084" char_id="0" frame_id="-1" name="美帆" text="『ひぅっ！！』"
		   voices="miho10100"/>
		<msg @l="1086" char_id="-1" frame_id="-1" name=""
		   text="次第に乳首は硬く突起し、舌で攻められるたびに私の身体が波打つ。" voices=""/>
		<msg @l="1088" char_id="-1" frame_id="-1" name="朽木"
		   text="『フフフ、じゃあ次は君の陰部をじっくりと観察してあげよう。』" voices=""/>
		<msg @l="1090" char_id="-1" frame_id="-1" name=""
		   text="教授は閉じていた私の膝に手をかけ、無理やり足が左右に大きく広げられる。教授のねっとりとした視線を秘部に浴びて、私の全身は恥ずかしさで真っ赤になる。"
		   voices=""/>
		<msg @l="1092" char_id="0" frame_id="-1" name="美帆" text="『や、ああああっっ。』"
		   voices="miho10240"/>
		<msg @l="1094" char_id="-1" frame_id="-1" name="朽木"
		   text="『うむ、キレイな色をしてるじゃないか。キミはもしかして処女かね？』" voices=""/>
		<msg @l="1096" char_id="-1" frame_id="-1" name=""
		   text="いやらしい笑みを浮かべた教授は、指を割れ目に沿って滑らせてきた。" voices=""/>
		<msg @l="1097" char_id="-1" frame_id="-1" name=""
		   text="悩殺的な下肢に手を這わせると、下半身を熟視する。" voices=""/>
		<msg @l="1099" char_id="0" frame_id="-1" name="美帆"
		   text="『や、ああっ‥‥‥言わないでくださいっ‥‥‥‥ん、んんっ。』" voices="miho07020"/>
		<msg @l="1100" char_id="-1" frame_id="-1" name="朽木"
		   text="『ほう！？これはいい、本当に処女かね。上玉を手に入れてしまったな。』" voices=""/>
		<msg @l="1102" char_id="-1" frame_id="-1" name=""
		   text="教授の顔は内腿を通過し、脚のつけねまできた。そして、私の秘部に顔を押し付けると、恍惚感に浸りながら、秘められた香りを吸引した。"
		   voices=""/>
		<msg @l="1103" char_id="-1" frame_id="-1" name=""
		   text="淫欲の香りを鼻腔が刺激し、その官能に浸る朽木教授の顔はニタッいやらしく笑みをつくる。" voices=""/>
		<msg @l="1105" char_id="-1" frame_id="-1" name="朽木"
		   text="『いやらしい匂いを発するね。キミは処女にしては淫乱な女だな。』" voices=""/>
		<msg @l="1107" char_id="0" frame_id="-1" name="美帆" text="『そん‥‥な‥‥‥。』"
		   voices="miho10220"/>
		<msg @l="1109" char_id="-1" frame_id="-1" name=""
		   text="教授は恥辱の言葉を私に向けた後、柔らかな肉溝の中に舌をぐいぐいと捻じ込んで来た。" voices=""/>
		<msg @l="1110" char_id="-1" frame_id="-1" name=""
		   text="嬲るように動く舌は恥部を戯弄して、ねっとりとしつこく愛撫する。" voices=""/>
		<msg @l="1112" char_id="0" frame_id="-1" name="美帆"
		   text="『んっ‥‥あっ、んんっ‥‥‥あ、ああっ‥‥‥‥。』" voices="miho07000"/>
		<msg @l="1114" char_id="-1" frame_id="-1" name=""
		   text="私はビクンと腰を跳ね上げ、妖しいうねりを朽木教授に見せ付ける。" voices=""/>
		<msg @l="1115" char_id="-1" frame_id="-1" name=""
		   text="今や花唇は溢れんばかりの蜜でべっとりとぬめっていた。" voices=""/>
		<msg @l="1116" char_id="-1" frame_id="-1" name=""
		   text="教授は興味をしめすように指も動員し、蜜壺を覗き込んだ。" voices=""/>
		<msg @l="1117" char_id="-1" frame_id="-1" name=""
		   text="ぽってりした秘所を左右から揉み割れ目に沿って指を滑らせた後、その指先がクリ○リスを摘み上げる。" voices=""/>
		<msg @l="1119" char_id="0" frame_id="-1" name="美帆" text="『ひっっ！！』"
		   voices="miho00780"/>
		<msg @l="1121" char_id="-1" frame_id="-1" name=""
		   text="朽木教授は一方で割れ目をかきわけ蜜口に指を差し込み、もう一方では執拗にクリ○リスを指で摘みコリコリと転がした。" voices=""/>
		<msg @l="1122" char_id="-1" frame_id="-1" name=""
		   text="秘裂を荒々しく蹂躙される度に鈍い痛みにも似た摩擦感が私の下腹部を襲い、痛みが引いた後にはじんわりと熱を帯びたような痺れが残る。"
		   voices=""/>
		<msg @l="1124" char_id="-1" frame_id="-1" name="朽木"
		   text="『君は処女でありながら痴漢をされてあんなによがっていたのかね。まったくいやらしい娘だな。ククククク。』" voices=""/>
		<msg @l="1126" char_id="0" frame_id="-1" name="美帆"
		   text="『あ‥‥あれはっ、んっ‥‥‥やあっ‥‥‥‥。』" voices="miho06990"/>
		<msg @l="1128" char_id="-1" frame_id="-1" name=""
		   text="秘唇を掻き混ぜる指先の動きとグチュグチュという淫汁の音から逃げるように、私は唇を噛んで恥ずかしさを懸命に堪えた。" voices=""/>
		<msg @l="1130" char_id="0" frame_id="-1" name="美帆"
		   text="『んんっ‥‥ん、んっ‥‥‥‥ああっ‥‥‥‥。』" voices="miho07030"/>
		<msg @l="1132" char_id="-1" frame_id="-1" name="朽木"
		   text="『少しずついやらしい汁が溢れてきたぞ。』" voices=""/>
		<msg @l="1134" char_id="-1" frame_id="-1" name=""
		   text="足を大きく開かされ、無防備となった芯芽を捏ねられ、花溝の入り口を掻き混ぜられる。" voices=""/>
		<msg @l="1135" char_id="-1" frame_id="-1" name=""
		   text="私はギシギシと机を揺らしながら身悶え続けていた。" voices=""/>
		<msg @l="1136" char_id="-1" frame_id="-1" name=""
		   text="彼の挿入した指先が秘壁をこすり上げるように、かきまぜると、少しずつ私を愉悦の中へと蕩けさせていく。" voices=""/>
		<msg @l="1138" char_id="-1" frame_id="-1" name="朽木"
		   text="『どれ、これだけ濡らしていれば少しは痛みも和らぐだろう。』" voices=""/>
		<msg @l="1140" char_id="-1" frame_id="-1" name=""
		   text="教授はそう言って、トロトロと淫汁の滲み出す割れ目を指先で開くと、ぬちゃっという音がする。" voices=""/>
		<msg @l="1141" char_id="-1" frame_id="-1" name=""
		   text="私のそこは、それまでの執拗な愛撫でぐちゃぐちゃになっていた。" voices=""/>
		<msg @l="1143" char_id="0" frame_id="-1" name="美帆"
		   text="『はっ‥‥はっ‥‥‥‥んっ、ああっ‥‥‥‥。』" voices="miho07040"/>
		<msg @l="1145" char_id="-1" frame_id="-1" name="朽木"
		   text="『私のペニスで開通式といこう。光栄に思いたまえ。』" voices=""/>
		<msg @l="1147" char_id="-1" frame_id="-1" name="" text="入り口に、肉棒の先端が押し付けられる。"
		   voices=""/>
		<msg @l="1149" char_id="0" frame_id="-1" name="美帆" text="『ひぃ――――。』"
		   voices="miho04860"/>
		<msg @l="1151" char_id="-1" frame_id="-1" name=""
		   text="しばらくソレは、溢れ出す蜜を絡み付けるように、割れ目のヒダを上下に掻き混ぜてから、ゆっくりと私の中に侵入してきた。"
		   voices=""/>
		<msg @l="1153" char_id="0" frame_id="-1" name="美帆" text="『うあﾞっ！！！』"
		   voices="miho07050"/>
		<msg @l="1155" char_id="-1" frame_id="-1" name="" text="秘割を、異物が引き裂いた。"
		   voices=""/>
		<msg @l="1157" char_id="0" frame_id="-1" name="美帆" text="『い、ああああああああああっ！！！』"
		   voices="miho04870"/>
		<msg @l="1159" char_id="-1" frame_id="-1" name=""
		   text="プツプツと何かが千切れていく感じがして、鈍い、身体に杭を打ちこまれたような痛みが全身をかけめぐる。" voices=""/>
		<msg @l="1161" char_id="-1" frame_id="-1" name="朽木"
		   text="『ゆっくりと深呼吸をしながら力を抜きたまえ。私のモノはまだ半分も入ってはいないぞ？』" voices=""/>
		<msg @l="1163" char_id="0" frame_id="-1" name="美帆" text="『あﾞっ‥‥‥ぐ、あああっ！！』"
		   voices="miho07060"/>
		<msg @l="1165" char_id="-1" frame_id="-1" name=""
		   text="この痛みがまだ倍以上も続くのかと思うと、意識が遠退きそうだった。" voices=""/>
		<msg @l="1166" char_id="-1" frame_id="-1" name="" text="痛い‥‥なんてものじゃない。"
		   voices=""/>
		<msg @l="1167" char_id="-1" frame_id="-1" name=""
		   text="膣内を無理やり引き裂かれているという感触と灼熱の激痛は、他に例えようがないものだった。" voices=""/>
		<msg @l="1169" char_id="-1" frame_id="-1" name="朽木" text="『おお‥‥もうすぐ‥‥最後まで。』"
		   voices=""/>
		<msg @l="1171" char_id="-1" frame_id="-1" name="" text="わずかに上擦った声で教授が言う。"
		   voices=""/>
		<msg @l="1172" char_id="-1" frame_id="-1" name="" text="私の秘孔は余程狭いのだろう。"
		   voices=""/>
		<msg @l="1173" char_id="-1" frame_id="-1" name=""
		   text="朽木の欲望は私の胎内の奥まで入って来られずにいた。" voices=""/>
		<msg @l="1175" char_id="0" frame_id="-1" name="美帆"
		   text="『ふ‥‥あっ、んぐっ‥‥‥‥‥はっ、はっ、はっ‥‥‥‥‥んはぁーっ！！！』" voices="miho07070"/>
		<msg @l="1177" char_id="-1" frame_id="-1" name=""
		   text="朽木教授が全体重をかけ、私の身体の奥深くへ熱いものが到達した。" voices=""/>
		<msg @l="1178" char_id="-1" frame_id="-1" name=""
		   text="それが教授の肉茎であると気付くのに‥‥少しだけ時間が必要だった。" voices=""/>
		<msg @l="1179" char_id="-1" frame_id="-1" name=""
		   text="その瞬間、私は痛みと始めての感覚で意識が飛びそうになる。" voices=""/>
		<msg @l="1181" char_id="0" frame_id="-1" name="美帆"
		   text="『い、いやっ‥‥‥やめ、あああっ！！』" voices="miho05050"/>
		<msg @l="1183" char_id="-1" frame_id="-1" name="朽木"
		   text="『全部入った、これでキミも大人の女性の仲間入りだ。』" voices=""/>
		<msg @l="1185" char_id="-1" frame_id="-1" name=""
		   text="教授は揶揄するように言って、口元を緩やかに歪めてみせる。" voices=""/>
		<msg @l="1186" char_id="-1" frame_id="-1" name=""
		   text="私は‥‥彼の話に答える余裕はなく、ただ荒い呼吸を繰り返しては感じている痛みをやわらげようとしていた。" voices=""/>
		<msg @l="1188" char_id="-1" frame_id="-1" name="朽木"
		   text="『さて‥‥では、処女の胎内をたっぷり堪能させて戴こうか。』" voices=""/>
		<msg @l="1190" char_id="0" frame_id="-1" name="美帆"
		   text="『う‥‥あっ‥‥‥は、はいっ‥‥‥‥‥‥。』" voices="miho07080"/>
		<msg @l="1192" char_id="-1" frame_id="-1" name=""
		   text="私の呼吸が落ち着くのを待ってから、教授は様子を見るようにゆっくりと腰を律動させる。" voices=""/>
		<msg @l="1194" char_id="0" frame_id="-1" name="美帆"
		   text="『ひっ‥‥いたっ‥‥あ、んぐっ‥‥‥んんっ‥‥‥。』" voices="miho07090"/>
		<msg @l="1196" char_id="-1" frame_id="-1" name="" text="膣で、膨れ上がった欲望が蠢きはじめる。"
		   voices=""/>
		<msg @l="1197" char_id="-1" frame_id="-1" name=""
		   text="十分に淫汁で潤っている為、肉棒で肉壁を引きずられるような痛みは思ったほどなかったけれど、それでも秘所に侵入している巨大な「違和感」が私の膣中を占領し押し広げては擦り上げていた。"
		   voices=""/>
		<msg @l="1198" char_id="-1" frame_id="-1" name=""
		   text="そこにはわずかな愉悦もなく‥‥ただ、息苦しさと鋭い痛みしかない。" voices=""/>
		<msg @l="1200" char_id="0" frame_id="-1" name="美帆"
		   text="『んっ、あﾞあﾞっ‥‥‥や、あぐっ‥‥‥やめっ‥‥‥‥んんっ！』" voices="miho04980"/>
		<msg @l="1202" char_id="-1" frame_id="-1" name="朽木"
		   text="『やはり痛みが勝ってしまうようだな‥‥‥。』" voices=""/>
		<msg @l="1204" char_id="-1" frame_id="-1" name="朽木"
		   text="『では、キミはこちらで愉しませてあげることにしようか。』" voices=""/>
		<msg @l="1206" char_id="-1" frame_id="-1" name=""
		   text="教授はそう言って私を貫いたまま、クリ○リスを転がしはじめる。" voices=""/>
		<msg @l="1208" char_id="0" frame_id="-1" name="美帆" text="『んっ、ああっ‥‥！！』"
		   voices="miho07100"/>
		<msg @l="1210" char_id="-1" frame_id="-1" name=""
		   text="私のそこは、蜜壺を貫かれていることでより一層熱く敏感になっていた。" voices=""/>
		<msg @l="1211" char_id="-1" frame_id="-1" name=""
		   text="教授の指先がその熱い花芯を軽く転がすだけで、私の身体には貫かれる前の甘い痺れが再び戻ってくる。" voices=""/>
		<msg @l="1213" char_id="-1" frame_id="-1" name="朽木"
		   text="『もう少し調教を積まなければ膣内で感じる事も出来ぬだろうからな、せめてこうしてキミも愉しませてやろう。』" voices=""/>
		<msg @l="1215" char_id="0" frame_id="-1" name="美帆"
		   text="『んんっ、んっ‥‥‥あっ‥‥‥ああっ！！！』" voices="miho07110"/>
		<msg @l="1217" char_id="-1" frame_id="-1" name=""
		   text="ゆっくりと腰を動かしながら、教授は蜜壺よりグチュグチュと漏れ出す蜜汁を指先に絡めて潤滑油にして‥‥硬く勃起した紅い肉芽を激しく擦り上げる。"
		   voices=""/>
		<msg @l="1218" char_id="-1" frame_id="-1" name=""
		   text="陰穴を押し広げる圧迫感と、引き裂かれた傷口を擦られる鈍い痛みが、その甘い痺れと混じって思考をおかしくしていく。" voices=""/>
		<msg @l="1220" char_id="0" frame_id="-1" name="美帆"
		   text="『あ、んんっ‥‥‥んっ‥‥‥はっ、んくっ！！』" voices="miho07120"/>
		<msg @l="1222" char_id="-1" frame_id="-1" name="朽木"
		   text="『くくっ、感じているようだな‥‥‥それでは私も愉しませてもらおうか。』" voices=""/>
		<msg @l="1224" char_id="-1" frame_id="-1" name=""
		   text="教授はそう言うと、肉壁を擦り上げる陰茎の律動を速くする。" voices=""/>
		<msg @l="1225" char_id="-1" frame_id="-1" name=""
		   text="私の身体はピンと伸びきり、脚線に力が漲った。" voices=""/>
		<msg @l="1227" char_id="0" frame_id="-1" name="美帆" text="『ひぅっ！！』"
		   voices="miho10100"/>
		<msg @l="1229" char_id="-1" frame_id="-1" name="朽木"
		   text="『キミの膣内は最高だ。初めてだというのに私のモノに肉ヒダが絡み付いて搾り取ろうとしてくるよ。』" voices=""/>
		<msg @l="1231" char_id="-1" frame_id="-1" name=""
		   text="息を弾ませながら、教授が私の耳元に囁きかける。" voices=""/>
		<msg @l="1232" char_id="-1" frame_id="-1" name=""
		   text="けれど、その言葉を私が意識するよりも早く、耳たぶにねっとりとした舌が這わされる刺激で私は感じてしまい、ゾクゾクと背中を反らす。"
		   voices=""/>
		<msg @l="1234" char_id="0" frame_id="-1" name="美帆"
		   text="『ああっ‥‥あっ、あっ‥‥‥‥ン、あふっ‥‥‥やっ、きもちぃ‥‥！？』" voices="miho07130"/>
		<msg @l="1236" char_id="0" frame_id="-1" name="美帆"
		   text="『あ、あああっ‥‥‥い、くぅ‥‥やぁ‥‥ダメ、もうっ‥‥わか‥‥らない‥‥んんっ！』" voices="miho07140"/>
		<msg @l="1238" char_id="-1" frame_id="-1" name="朽木"
		   text="『フフフ‥‥おかしくなってきたか‥‥‥ではとどめをさしてやろう。』" voices=""/>
		<msg @l="1240" char_id="-1" frame_id="-1" name=""
		   text="私が熱に浮かされるように限界を告げると、教授はいやらしい笑みを浮かべて速射砲のように腰の律動を加速させた。" voices=""/>
		<msg @l="1241" char_id="-1" frame_id="-1" name=""
		   text="強く早く突き上げられることによって身体が大きく上下に揺れ、その度に私の乗った机がギシギシと軋みをあげる。" voices=""/>
		<msg @l="1242" char_id="-1" frame_id="-1" name=""
		   text="けれど‥‥それすらも私の耳には届いておらず、痛みと愉悦の混じった奇妙な痺れの中で、訪れる絶頂の波に身をゆだねる。" voices=""/>
		<msg @l="1244" char_id="0" frame_id="-1" name="美帆"
		   text="『んあっ、あっ‥‥‥ダメぇ‥‥‥‥‥ん、あああっ‥‥‥おかしく‥‥‥なっちゃうっ‥‥‥！！』" voices="miho07150"/>
		<msg @l="1246" char_id="-1" frame_id="-1" name="朽木" text="『限界だ‥‥出すぞ！！』"
		   voices=""/>
		<msg @l="1249" async="true" char_id="-1" frame_id="-1" name=""
		   text="どこに出す‥‥？" voices=""/>
		<select @l="1250">
			<menu @l="1253" label="EventLabel_105" text="中に出す"/>
			<menu @l="1256" label="EventLabel_106" text="外に出す"/>
		</select>
		<label @l="1262" id="EventLabel_105"/>
		<msg @l="1264" char_id="-1" frame_id="-1" name="朽木"
		   text="『くっ‥‥このまま、膣内に注いでやる。』" voices=""/>
		<wait_chgmv/>
		<ev @l="1267" src="ev-008ax1"/>
		<msg @l="1269" char_id="0" frame_id="-1" name="美帆" text="『え‥‥！？』"
		   voices="miho07160"/>
		<msg @l="1271" char_id="-1" frame_id="-1" name=""
		   text="ふと、愉悦の合間に届いた信じ難い言葉に、私は一瞬にして現実に立ち戻る。" voices=""/>
		<msg @l="1273" char_id="0" frame_id="-1" name="美帆"
		   text="『ダメ‥‥‥それだけは‥‥それだけは許してくださいっ‥‥‥赤ちゃん‥‥できちゃうっっ！』" voices="miho07170"/>
		<msg @l="1275" char_id="-1" frame_id="-1" name="朽木" text="『くっ、もう遅い‥‥‥よっ！』"
		   voices=""/>
		<msg @l="1277" char_id="0" frame_id="-1" name="美帆" text="『いやああああああっ！！』"
		   voices="miho07180"/>
		<flash @l="1280" count="4" fade="100" image="white"/>
		<wait_chgmv/>
		<ev @l="1283" src="ev-008ax2z1"/>
		<msg @l="1285" char_id="-1" frame_id="-1" name=""
		   text="びゅるびゅるびゅるびゅる、と注ぎ込まれる、熱い液体。" voices=""/>
		<msg @l="1286" char_id="-1" frame_id="-1" name=""
		   text="煮えたぎる白濁液を子宮の奥深くに浴びせかけた。" voices=""/>
		<msg @l="1288" char_id="0" frame_id="-1" name="美帆"
		   text="『あっ‥‥‥ああ‥‥‥‥いっぱい‥‥流れ込んで、来てる‥‥‥。』" voices="miho07190"/>
		<msg @l="1290" char_id="0" frame_id="-1" name="美帆"
		   text="『こんなに出されたら‥‥‥赤ちゃん‥‥‥できちゃう‥‥‥‥‥。』" voices="miho07200"/>
		<msg @l="1292" char_id="-1" frame_id="-1" name="" text="またひとつ、私の中で何かが壊れた。"
		   voices=""/>
		<msg @l="1293" char_id="-1" frame_id="-1" name="" text="大切なもの。" voices=""/>
		<msg @l="1294" char_id="-1" frame_id="-1" name=""
		   text="‥‥朽木教授は‥‥‥平気で踏みにじっていった。" voices=""/>
		<goto @l="1297" label="EventLabel_107"/>
		<label @l="1300" id="EventLabel_106"/>
		<msg @l="1302" char_id="0" frame_id="-1" name="美帆"
		   text="『いっ‥‥ああっ、あっ、あっ‥‥‥‥いく、いくいくっ、ああっ！』" voices="miho07210"/>
		<msg @l="1304" char_id="-1" frame_id="-1" name="朽木"
		   text="『記念すべき処女喪失を祝って、ドロドロに汚してあげよう。』" voices=""/>
		<msg @l="1306" char_id="-1" frame_id="-1" name=""
		   text="そう言って教授はから肉棒を引き抜くと、私のお腹の上でそれを握りなおして激しくしごき上げる。" voices=""/>
		<msg @l="1308" char_id="-1" frame_id="-1" name="朽木" text="『くっっ！』" voices=""/>
		<flash @l="1311" count="4" fade="100" image="white"/>
		<wait_chgmv/>
		<ev @l="1314" src="ev-008ax2z2"/>
		<msg @l="1316" char_id="-1" frame_id="-1" name=""
		   text="教授が短く声をあげて腰を震わせると、熱棒の先端から熱く白い飛沫が私の身体に降り注ぐ。" voices=""/>
		<msg @l="1318" char_id="0" frame_id="-1" name="美帆"
		   text="『んっ‥‥‥あっ‥‥‥‥‥んくっ‥‥‥‥‥‥。』" voices="miho07220"/>
		<msg @l="1320" char_id="-1" frame_id="-1" name=""
		   text="絶頂の余韻に身体を震わせながら、私は襲いくる絶望感に呆然としていた。" voices=""/>
		<msg @l="1321" char_id="-1" frame_id="-1" name=""
		   text="処女を蹂躙された‥‥そんな思いが今さらになって重くのしかかる。" voices=""/>
		<msg @l="1323" char_id="-1" frame_id="-1" name="朽木"
		   text="『キミの身体は最高だ。精液にまみれて震える姿も実に艶かしい。』" voices=""/>
		<msg @l="1325" char_id="-1" frame_id="-1" name=""
		   text="教授はそう言って、私のお腹の上に撒き散らされた白濁液の一滴を指先ですくい上げると‥‥私の口元へとそれを運ぶ。" voices=""/>
		<msg @l="1327" char_id="-1" frame_id="-1" name="朽木" text="『さあ‥‥舐めたまえ。』"
		   voices=""/>
		<msg @l="1329" char_id="-1" frame_id="-1" name=""
		   text="口元に感じる精液の感触に、私は微かに眉をひそめる。" voices=""/>
		<msg @l="1330" char_id="-1" frame_id="-1" name="" text="もう‥‥私に拒絶の道は残されていない。"
		   voices=""/>
		<msg @l="1331" char_id="-1" frame_id="-1" name=""
		   text="どれほど拒んだ所で、私にはもう守るべきものがない。" voices=""/>
		<msg @l="1333" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』"
		   voices="miho07230"/>
		<msg @l="1335" char_id="-1" frame_id="-1" name=""
		   text="私は‥‥少しずつ遠退いていく意識の中で、朽木教授の指をゆっくりと口に含んだ。" voices=""/>
		<label @l="1338" id="EventLabel_107"/>
		<stopbgm @l="1341" fadeout="1000"/>
		<clear @l="1344" class="all"/>
		<end_scene @l="1347"/>
		<msgshow @l="1350" show="true"/>
		<wait_chgmv/>
		<bg @l="1353" src="bg12"/>
		<bgm @l="1356" src="bgm03" volume="1."/>
		<description @l="1359" text="散らされたあと"/>
		<msg @l="1361" char_id="0" frame_id="-1" name="美帆" text="『んっ‥‥。』" voices=""/>
		<msg @l="1363" char_id="0" frame_id="-1" name="美帆" text="『あれ‥‥わたし‥‥‥？』"
		   voices=""/>
		<char @l="1366" id="kutsu" pos="left" src="kutsu010"/>
		<msg @l="1368" char_id="-1" frame_id="-1" name="朽木" text="『目が覚めたようだな。』"
		   voices=""/>
		<char @l="1371" id="miho" pos="right" src="miho005"/>
		<msg @l="1373" char_id="0" frame_id="-1" name="美帆" text="『教授‥‥私、どうして‥‥‥。』"
		   voices=""/>
		<msg @l="1375" char_id="-1" frame_id="-1" name="朽木"
		   text="『キミは気を失っていたのだよ。破瓜の痛みと達したショックでな。』" voices=""/>
		<msg @l="1377" char_id="0" frame_id="-1" name="美帆" text="『気を‥‥そうか、私‥‥‥。』"
		   voices=""/>
		<msg @l="1379" char_id="-1" frame_id="-1" name="朽木"
		   text="『それよりも、早く衣服を身に付けてはどうかね？』" voices=""/>
		<msg @l="1381" char_id="-1" frame_id="-1" name="朽木"
		   text="『キミがその格好では部屋の鍵が開けられぬのだよ。』" voices=""/>
		<char @l="1384" id="miho" pos="right" src="miho105"/>
		<msg @l="1386" char_id="0" frame_id="-1" name="美帆" text="『え‥‥あ、ああっ！？』"
		   voices=""/>
		<clear @l="1389" class="char"/>
		<char @l="1391" id="kutsu" pos="auto" src="kutsu010"/>
		<msg @l="1394" char_id="-1" frame_id="-1" name=""
		   text="私はようやく自分が全裸である事に気付き、慌ててその場に座り込む。" voices=""/>
		<msg @l="1396" char_id="-1" frame_id="-1" name="朽木" text="『もうじき四限目の講義が始まる。』"
		   voices=""/>
		<msg @l="1398" char_id="-1" frame_id="-1" name="朽木"
		   text="『私も行かなくてはならぬからな、早く身支度を整えて帰りたまえ。』" voices=""/>
		<msg @l="1400" char_id="0" frame_id="-1" name="美帆" text="『は、はいっ‥‥。』"
		   voices=""/>
		<msg @l="1402" char_id="-1" frame_id="-1" name=""
		   text="ソファの上に脱ぎ捨てた服へと手を伸ばし、急いでそれを身に付けていく。" voices=""/>
		<msg @l="1404" char_id="-1" frame_id="-1" name="朽木" text="『‥‥‥‥。』" voices=""/>
		<msg @l="1406" char_id="-1" frame_id="-1" name="朽木"
		   text="『そのままでいい‥‥私の質問にひとつ答えてくれたまえ。』" voices=""/>
		<clear @l="1409" class="char"/>
		<char @l="1411" id="kutsu" pos="left" src="kutsu010"/>
		<char @l="1413" id="miho" pos="right" src="miho115"/>
		<msg @l="1415" char_id="0" frame_id="-1" name="美帆" text="『‥‥？』" voices=""/>
		<bgm @l="1418" src="bgm15" volume="1."/>
		<msg @l="1420" char_id="-1" frame_id="-1" name="朽木"
		   text="『私の元で、専属的にその身体を提供する気はないかね？』" voices=""/>
		<char @l="1423" id="miho" pos="right" src="miho015"/>
		<msg @l="1425" char_id="0" frame_id="-1" name="美帆"
		   text="『え‥‥それって、どういう意味ですか？』" voices=""/>
		<msg @l="1427" char_id="-1" frame_id="-1" name="朽木" text="『キミは最高の身体を持っている。』"
		   voices=""/>
		<msg @l="1429" char_id="-1" frame_id="-1" name="朽木"
		   text="『キミが私の専属になってくれれば‥‥そう、仲根啓三氏のバックアップだけでなくキミ自身の将来についても私が世話をしようじゃないか。』"
		   voices=""/>
		<msg @l="1431" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="1433" char_id="-1" frame_id="-1" name="朽木"
		   text="『キミの父が定年退職をするまで、あと１０年余り。』" voices=""/>
		<msg @l="1435" char_id="-1" frame_id="-1" name="朽木"
		   text="『その間、キミは父の身を案じながら私の言葉に怯え続けたいか？』" voices=""/>
		<char @l="1438" id="miho" pos="right" src="miho115"/>
		<msg @l="1440" char_id="0" frame_id="-1" name="美帆" text="『それはっ‥‥。』"
		   voices=""/>
		<msg @l="1442" char_id="-1" frame_id="-1" name="朽木"
		   text="『だが、キミが私の元へ専属的に仕えるというのであれば今以上の待遇を約束しようじゃないか。』" voices=""/>
		<msg @l="1444" char_id="0" frame_id="-1" name="美帆"
		   text="『でも‥‥‥それって、つまり私は教授の‥‥‥‥。』" voices=""/>
		<msg @l="1446" char_id="-1" frame_id="-1" name="朽木" text="『愛人になるということだ。』"
		   voices=""/>
		<msg @l="1448" char_id="0" frame_id="-1" name="美帆" text="『そんなのっ‥‥。』"
		   voices=""/>
		<msg @l="1450" char_id="-1" frame_id="-1" name="朽木" text="『選びたまえ。』"
		   voices=""/>
		<msg @l="1452" char_id="-1" frame_id="-1" name="朽木"
		   text="『心まで私の為に尽くすか‥‥それとも恐怖に怯えながら、身体のみを差し出す日々を送るか。』" voices=""/>
		<msg @l="1454" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="1457" async="true" char_id="-1" frame_id="-1" name=""
		   text="朽木の専属奴隷に‥‥？" voices=""/>
		<select @l="1458">
			<menu @l="1461" label="EventLabel_108" text="なる"/>
			<menu @l="1464" label="EventLabel_109" text="ならない"/>
		</select>
		<label @l="1470" id="EventLabel_108"/>
		<char @l="1473" id="miho" pos="right" src="miho015"/>
		<msg @l="1475" char_id="0" frame_id="-1" name="美帆"
		   text="『わ‥‥わかりました、教授の愛人に‥‥‥‥させてください。』" voices=""/>
		<msg @l="1477" char_id="-1" frame_id="-1" name="朽木"
		   text="『くくっ、キミならば必ずそう言ってくれると信じていたよ。』" voices=""/>
		<msg @l="1479" char_id="-1" frame_id="-1" name="朽木"
		   text="『では講義に行きたまえ。その身体を抱きたくなったら‥‥キミの携帯電話へメールを送ることにでもしようか。』" voices=""/>
		<char @l="1482" id="miho" pos="right" src="miho115"/>
		<msg @l="1484" char_id="0" frame_id="-1" name="美帆" text="『はい‥‥。』" voices=""/>
		<clear @l="1487" class="all"/>
		<msg @l="1489" char_id="-1" frame_id="-1" name=""
		   text="そうして私は悲痛な面持ちで教授室を後にする。" voices=""/>
		<msg @l="1490" char_id="-1" frame_id="-1" name="" text="こうするしかない。" voices=""/>
		<msg @l="1491" char_id="-1" frame_id="-1" name=""
		   text="もう‥‥自分には何も失うものは無いのだからと、言い聞かせながら。" voices=""/>
		<stopbgm @l="1494" fadeout="1000"/>
		<clear @l="1497" class="all"/>
		<call @l="1500" target="EventLabel_111@root_kutuki02a"/>
		<return @l="1501" value="0&#13;&#10;"/>
		<label @l="1505" id="EventLabel_109"/>
		<char @l="1508" id="miho" pos="right" src="miho015"/>
		<msg @l="1510" char_id="0" frame_id="-1" name="美帆" text="『それは‥‥できません。』"
		   voices=""/>
		<char @l="1513" id="kutsu" pos="left" src="kutsu014"/>
		<msg @l="1515" char_id="-1" frame_id="-1" name="朽木"
		   text="『何故だ？&#32;キミの心一つで無為な恐怖から解放されるのだぞ？』" voices=""/>
		<msg @l="1517" char_id="0" frame_id="-1" name="美帆"
		   text="『教授と交わした契約については、これからもちゃんと守ります。』" voices=""/>
		<msg @l="1519" char_id="0" frame_id="-1" name="美帆"
		   text="『でも、私は‥‥心まで奴隷にはなりません。』" voices=""/>
		<char @l="1522" id="kutsu" pos="left" src="kutsu010"/>
		<msg @l="1524" char_id="-1" frame_id="-1" name="朽木"
		   text="『ふん、そのくだらぬプライドが後悔を生む事になるぞ。』" voices=""/>
		<msg @l="1526" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="1528" char_id="-1" frame_id="-1" name="朽木"
		   text="『まあいい‥‥ならばさっさと講義へ行きたまえ。』" voices=""/>
		<msg @l="1530" char_id="-1" frame_id="-1" name="朽木"
		   text="『自分の選択の愚かさを、日々の恐怖で思い知るが良い。』" voices=""/>
		<char @l="1533" id="miho" pos="right" src="miho115"/>
		<msg @l="1535" char_id="0" frame_id="-1" name="美帆" text="『失礼‥‥します。』"
		   voices=""/>
		<clear @l="1538" class="all"/>
		<msg @l="1540" char_id="-1" frame_id="-1" name=""
		   text="私は、心に突き刺さる彼の言葉に恐怖を感じながら教授室を後にする。" voices=""/>
		<msg @l="1541" char_id="-1" frame_id="-1" name=""
		   text="私が守りたいのは父の事で、その為に身体を捧げている。" voices=""/>
		<msg @l="1542" char_id="-1" frame_id="-1" name=""
		   text="だが、心まで捧げたくはなかった。捧げてしまったら守ってるものが何か分からなくなってしまうような気がしたから‥‥‥。"
		   voices=""/>
		<stopbgm @l="1545" fadeout="1000"/>
		<clear @l="1548" class="all"/>
		<call @l="1551" target="EventLabel_113@root_kutuki02c"/>
		<return @l="1552" value="0&#13;&#10;"/>
		<label @l="1556" id="EventLabel_110"/>
		<msg @l="1558" char_id="0" frame_id="-1" name="美帆"
		   text="『わ、私っ‥‥やっぱりこんなの従えませんっ！』" voices=""/>
		<msg @l="1560" char_id="-1" frame_id="-1" name="" text="それはもう衝動に近かった。"
		   voices=""/>
		<msg @l="1561" char_id="-1" frame_id="-1" name=""
		   text="私は腰に回された教授の手を振り払うようにし、二歩三歩と後ろに下がって距離をあける。" voices=""/>
		<char @l="1564" id="kutsu" pos="auto" src="kutsu014"/>
		<msg @l="1566" char_id="-1" frame_id="-1" name="朽木"
		   text="『くっ‥‥キミは、自分が何をしたのかわかっているのかね！？』" voices=""/>
		<msg @l="1568" char_id="-1" frame_id="-1" name="朽木"
		   text="『私に従わなければ、キミの父親は‥‥キミの家族は間違いなく破滅するのだぞ！？』" voices=""/>
		<clear @l="1571" class="char"/>
		<char @l="1573" id="kutsu" pos="left" src="kutsu014"/>
		<char @l="1575" id="miho" pos="right" src="miho115"/>
		<msg @l="1577" char_id="0" frame_id="-1" name="美帆"
		   text="『そんなのやっぱり信じられませんっ！』" voices=""/>
		<msg @l="1579" char_id="0" frame_id="-1" name="美帆"
		   text="『父がリストラされるって話だって、お父さんは何も言ってなかったし‥‥。』" voices=""/>
		<char @l="1581" id="kutsu" pos="left" src="kutsu010"/>
		<msg @l="1583" char_id="-1" frame_id="-1" name="朽木"
		   text="『わざわざ自分の娘を不安にさせるような事を言う親など、いるものか。』" voices=""/>
		<msg @l="1585" char_id="-1" frame_id="-1" name="朽木"
		   text="『今ならまだ許してやる。私の言うことを聞きたまえ。』" voices=""/>
		<msg @l="1587" char_id="-1" frame_id="-1" name=""
		   text="教授はそう言って手を伸ばすと、一歩、また一歩と距離を縮める。" voices=""/>
		<char @l="1590" id="miho" pos="right" src="miho015"/>
		<msg @l="1592" char_id="0" frame_id="-1" name="美帆" text="『来ないでくださいっ！』"
		   voices=""/>
		<msg @l="1594" char_id="0" frame_id="-1" name="美帆"
		   text="『これ以上私に近づいたら、悲鳴をあげますよ。』" voices=""/>
		<char @l="1597" id="kutsu" pos="left" src="kutsu014"/>
		<msg @l="1599" char_id="-1" frame_id="-1" name="朽木" text="『‥‥なんだと？』"
		   voices=""/>
		<msg @l="1601" char_id="0" frame_id="-1" name="美帆"
		   text="『今ここで私が悲鳴をあげてある事無いこと証言すれば‥‥教授はこの大学にいられなくなるんじゃないですか？』" voices=""/>
		<msg @l="1603" char_id="-1" frame_id="-1" name="朽木"
		   text="『私を脅迫するつもりかね？&#32;この私を！？』" voices=""/>
		<msg @l="1605" char_id="0" frame_id="-1" name="美帆" text="『そんなことっ‥‥。』"
		   voices=""/>
		<msg @l="1607" char_id="0" frame_id="-1" name="美帆"
		   text="『私はただ、こんな馬鹿な真似はやめて欲しいだけなんです。』" voices=""/>
		<msg @l="1609" char_id="0" frame_id="-1" name="美帆" text="『こんなこと‥‥間違ってますっ！』"
		   voices=""/>
		<char @l="1612" id="kutsu" pos="left" src="kutsu018"/>
		<msg @l="1614" char_id="-1" frame_id="-1" name="朽木"
		   text="『馬鹿な真似？&#32;間違ってる？』" voices=""/>
		<msg @l="1616" char_id="-1" frame_id="-1" name="朽木"
		   text="『くくっ‥‥キミはこの町のことを知らないからそんなことを言っていられるのだよ。』" voices=""/>
		<msg @l="1618" char_id="0" frame_id="-1" name="美帆" text="『それ‥‥どういう意味ですか？』"
		   voices=""/>
		<char @l="1621" id="kutsu" pos="left" src="kutsu010"/>
		<msg @l="1623" char_id="-1" frame_id="-1" name="朽木" text="『ふん、さあな。』"
		   voices=""/>
		<msg @l="1625" char_id="-1" frame_id="-1" name="朽木"
		   text="『まあいい。キミがそういう態度を取るのなら私にも考えがある。』" voices=""/>
		<char @l="1628" id="miho" pos="right" src="miho115"/>
		<msg @l="1630" char_id="0" frame_id="-1" name="美帆"
		   text="『お、脅したって無駄です‥‥父は例えリストラされたって自分の力でなんとかするくらいの事、できるはずです。』" voices=""/>
		<msg @l="1632" char_id="-1" frame_id="-1" name="朽木"
		   text="『くくっ、楽しみにしていることだ。』" voices=""/>
		<msg @l="1634" char_id="-1" frame_id="-1" name="朽木"
		   text="『キミはきっと‥‥近いうちに私の元へ許しを請いに来る事になる。』" voices=""/>
		<clear @l="1637" layer="kutsu"/>
		<msg @l="1639" char_id="-1" frame_id="-1" name=""
		   text="捨て台詞のようにそう言うと、朽木教授は踵を返して去っていく。" voices=""/>
		<msg @l="1641" char_id="0" frame_id="-1" name="美帆" text="(あ、あんなの‥‥嘘にきまっている)"
		   voices=""/>
		<msg @l="1643" char_id="0" frame_id="-1" name="美帆"
		   text="(お父さんは、あんな人に頼らなくたって‥‥大丈夫なんだから)" voices=""/>
		<msg @l="1645" char_id="-1" frame_id="-1" name=""
		   text="立ち去る教授の背中を睨みつけながら、私は自分に言い聞かせるようにつぶやいていた。" voices=""/>
		<stopbgm @l="1648" fadeout="1000"/>
		<clear @l="1651" class="all"/>
		<msgshow @l="1653" show="true"/>
		<wait_chgmv/>
		<bg @l="1656" src="bg01b"/>
		<bgm @l="1659" src="bgm03" volume="1."/>
		<msg @l="1661" char_id="0" frame_id="-1" name="美帆" text="『え‥‥それ、どういうこと？』"
		   voices=""/>
		<char @l="1664" id="miho" pos="auto" src="miho034"/>
		<msg @l="1666" char_id="-1" frame_id="-1" name=""
		   text="夜、夕食を終えた私は心配になって実家に電話をかけていた。" voices=""/>
		<msg @l="1667" char_id="-1" frame_id="-1" name=""
		   text="どうやら父は不在のようで、電話口に出たのは妹の亜季奈だった。" voices=""/>
		<msg @l="1669" char_id="2" frame_id="-1" name="亜季奈"
		   text="『だから、お父さん‥‥お仕事出来なくなっちゃったって‥‥‥。』" voices=""/>
		<msg @l="1671" char_id="0" frame_id="-1" name="美帆"
		   text="『そんな、お父さんはただリストラで辞めさせられたんじゃないの？』" voices=""/>
		<msg @l="1673" char_id="2" frame_id="-1" name="亜季奈"
		   text="『ううん‥‥お父さん、オウリョウとかっていうのをしてたみたい。』" voices=""/>
		<msg @l="1675" char_id="0" frame_id="-1" name="美帆"
		   text="『え、横領って‥‥お父さんが会社のお金を使い込んだってこと！？』" voices=""/>
		<msg @l="1677" char_id="-1" frame_id="-1" name=""
		   text="私の言葉に亜季奈は細々と「そうみたい」と、答えを返す。" voices=""/>
		<char @l="1680" id="miho" pos="auto" src="miho035"/>
		<msg @l="1682" char_id="0" frame_id="-1" name="美帆"
		   text="『でもそんなことって‥‥お父さんはなんて言ってるの？』" voices=""/>
		<msg @l="1684" char_id="2" frame_id="-1" name="亜季奈"
		   text="『よく解らない‥‥お父さんは会社で警察の人に捕まって、今は取調べ中だって言ってた。』" voices=""/>
		<char @l="1687" id="miho" pos="auto" src="miho135"/>
		<msg @l="1689" char_id="0" frame_id="-1" name="美帆" text="『そんなっ‥‥。』"
		   voices=""/>
		<msg @l="1691" char_id="-1" frame_id="-1" name="" text="まさしく最悪な状態だった。"
		   voices=""/>
		<msg @l="1692" char_id="-1" frame_id="-1" name=""
		   text="父がリストラされる事については、既に何日も前から知らされていたことらしかった。" voices=""/>
		<msg @l="1693" char_id="-1" frame_id="-1" name=""
		   text="けれど、それが今日の午後になっていきなり諸経費の横領だとかいう話になり、瞬く間に警察沙汰になってしまったらしい。" voices=""/>
		<msg @l="1694" char_id="-1" frame_id="-1" name=""
		   text="明らかに‥‥人為的なモノを感じずにはいられない。" voices=""/>
		<msg @l="1696" char_id="0" frame_id="-1" name="美帆" text="(これも‥‥全部私のせいなの？)"
		   voices=""/>
		<msg @l="1698" char_id="0" frame_id="-1" name="美帆"
		   text="(私が、朽木教授との約束を破ったりしたから‥‥！？)" voices=""/>
		<msg @l="1700" char_id="2" frame_id="-1" name="亜季奈" text="『お姉ちゃん‥‥？』"
		   voices=""/>
		<char @l="1703" id="miho" pos="auto" src="miho035"/>
		<msg @l="1705" char_id="0" frame_id="-1" name="美帆" text="『あ、うん‥‥ごめんなさい。』"
		   voices=""/>
		<msg @l="1707" char_id="2" frame_id="-1" name="亜季奈"
		   text="『お姉ちゃん、お父さんは悪くないよね？&#32;何もしてないよね？』" voices=""/>
		<char @l="1710" id="miho" pos="auto" src="miho036"/>
		<msg @l="1712" char_id="0" frame_id="-1" name="美帆" text="『‥‥うん、大丈夫。』"
		   voices=""/>
		<msg @l="1714" char_id="0" frame_id="-1" name="美帆"
		   text="『お父さん、絶対に戻ってくるから‥‥亜季奈は心配しないで。』" voices=""/>
		<msg @l="1716" char_id="2" frame_id="-1" name="亜季奈" text="『うん‥‥。』" voices=""/>
		<msg @l="1718" char_id="-1" frame_id="-1" name=""
		   text="亜季奈は涙声でそう言って、電話口で何度も鼻をすする。" voices=""/>
		<msg @l="1719" char_id="-1" frame_id="-1" name=""
		   text="父親が犯罪者扱いされそうになっているんだもの‥‥泣きたくもなる。" voices=""/>
		<char @l="1722" id="miho" pos="auto" src="miho135"/>
		<msg @l="1724" char_id="0" frame_id="-1" name="美帆" text="(‥‥もう、迷わない)"
		   voices=""/>
		<msg @l="1726" char_id="0" frame_id="-1" name="美帆"
		   text="(私はどうなってもいい‥‥‥だから、お父さんたちを助けなきゃ)" voices=""/>
		<msg @l="1728" char_id="-1" frame_id="-1" name=""
		   text="私は電話口ですすり泣いている亜季奈を慰めながら、そっと心に誓っていた。" voices=""/>
		<stopbgm @l="1731" fadeout="1000"/>
		<clear @l="1734" class="all"/>
		<call @l="1738" target="EventLabel_112@root_kutuki02b"/>
		<return @l="1739" value="0&#13;&#10;"/>
	</code>
</xscript>
