<?xml version="1.0" encoding="utf-8"?>
<xscript>
	<debug editor="&quot;C:\Program&#32;Files&#32;(x86)\sakura\sakura.exe&quot;&#32;&quot;%src%&quot;&#32;-Y=%line%"
	   src="D:\シロップ\町ぐるみの罠＋汚された夏セット版\汚された夏\完成データ\汚された夏\script\text\root_akina_c_ev02.txt"/>
	<code>
		<label @l="12" id="EventLabel_86"/>
		<description @l="16" text="絶望の日"/>
		<goto @l="19" cond="!(f.留学生に抵抗したflag&#32;==&#32;1)&#13;&#10;"
		   label="TempLabel_226"/>
		<eval @l="23" expr="f.numDay=12&#13;&#10;"/>
		<msgshow @l="25" show="false"/>
		<wait_chgmv/>
		<bg @l="27" src="day12" time="2000"/>
		<wait @l="29" time="500"/>
		<wait_chgmv/>
		<bg @l="31" src="black" time="2000"/>
		<msgshow @l="33" show="true"/>
		<goto @l="36" label="TempLabel_227"/>
		<label @l="37" id="TempLabel_226"/>
		<eval @l="41" expr="f.numDay=13&#13;&#10;"/>
		<msgshow @l="43" show="false"/>
		<wait_chgmv/>
		<bg @l="45" src="day13" time="2000"/>
		<wait @l="47" time="500"/>
		<wait_chgmv/>
		<bg @l="49" src="black" time="2000"/>
		<msgshow @l="51" show="true"/>
		<label @l="54" id="TempLabel_227"/>
		<wait_chgmv/>
		<bg @l="59" src="bg01"/>
		<bgm @l="63" src="bgm03" volume="1."/>
		<msg @l="65" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="67" char_id="-1" frame_id="-1" name="" text="朝‥‥は、もうとっくに過ぎてしまった。"
		   voices=""/>
		<msg @l="68" char_id="-1" frame_id="-1" name=""
		   text="部屋にあるデジタル時計は１３時５５分を教えてくれた。" voices=""/>
		<msg @l="69" char_id="-1" frame_id="-1" name=""
		   text="私は‥‥ベッドに横たわったまま、天井を見つめていた。" voices=""/>
		<msg @l="70" char_id="-1" frame_id="-1" name=""
		   text="あの悪夢のような出来事から一晩がたった‥‥。" voices=""/>
		<msg @l="72" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="74" char_id="-1" frame_id="-1" name="" text="何も、考えられなかった。"
		   voices=""/>
		<msg @l="75" char_id="-1" frame_id="-1" name="" text="いや‥‥何も考えたくなかった。"
		   voices=""/>
		<msg @l="76" char_id="-1" frame_id="-1" name="" text="忘れてしまいたい。" voices=""/>
		<msg @l="77" char_id="-1" frame_id="-1" name="" text="すべて、無かったことにしてしまいたかった。"
		   voices=""/>
		<msg @l="78" char_id="-1" frame_id="-1" name=""
		   text="身体を汚されている間も、その後も‥‥何度となく。" voices=""/>
		<msg @l="79" char_id="-1" frame_id="-1" name="" text="でも、事実は決して変わってはくれない。"
		   voices=""/>
		<msg @l="81" char_id="1" frame_id="-1" name="声" text="『美帆‥‥お昼はどうするの？』"
		   voices=""/>
		<msg @l="83" char_id="-1" frame_id="-1" name="" text="扉の向こうから玲さんの声が聞こえてきた。"
		   voices=""/>
		<msg @l="84" char_id="-1" frame_id="-1" name=""
		   text="いつも通りの声‥‥玲さんは私の身に何が起きたかなんて知らない。" voices=""/>
		<msg @l="85" char_id="-1" frame_id="-1" name=""
		   text="昨日、途中で意識を失った私は深夜誰もいない更衣室で目を覚ました。" voices=""/>
		<msg @l="86" char_id="-1" frame_id="-1" name=""
		   text="シャワーを浴びて‥‥声も無く泣いて‥‥‥‥帰ってきた。" voices=""/>
		<msg @l="87" char_id="-1" frame_id="-1" name=""
		   text="気付かれないようにこっそりと部屋に戻って‥‥。" voices=""/>
		<msg @l="88" char_id="-1" frame_id="-1" name="" text="それから私はずっと部屋にひきこもってる。"
		   voices=""/>
		<msg @l="90" char_id="1" frame_id="-1" name="玲" text="『まだ寝てるの？』" voices=""/>
		<msg @l="92" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="94" char_id="1" frame_id="-1" name="玲" text="『授業‥‥今日はなかったの？』"
		   voices=""/>
		<msg @l="96" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="98" char_id="1" frame_id="-1" name="玲"
		   text="『何があったかはわからないけど、とにかくゴハンくらい食べなさい。』" voices=""/>
		<msg @l="100" char_id="1" frame_id="-1" name="玲"
		   text="『あなた‥‥昨日から何も食べてないんでしょ？』" voices=""/>
		<msg @l="102" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="104" char_id="1" frame_id="-1" name="玲" text="『‥‥美帆、やっぱり寝てるの？』"
		   voices=""/>
		<msg @l="106" char_id="0" frame_id="-1" name="美帆" text="『‥‥といて‥‥‥。』"
		   voices=""/>
		<msg @l="108" char_id="1" frame_id="-1" name="玲" text="『え‥‥？』" voices=""/>
		<msg @l="110" char_id="0" frame_id="-1" name="美帆"
		   text="『ほっといてください！&#32;‥‥お願いします‥‥。』" voices=""/>
		<msg @l="112" char_id="1" frame_id="-1" name="玲" text="『美帆‥‥。』" voices=""/>
		<msg @l="114" char_id="0" frame_id="-1" name="美帆"
		   text="『何も話したくないし、何も食べたくないんですっ‥‥‥だから。』" voices=""/>
		<msg @l="116" char_id="1" frame_id="-1" name="玲"
		   text="『そう、わかった‥‥‥ごめんなさい、何も聞かないわ。』" voices=""/>
		<msg @l="118" char_id="1" frame_id="-1" name="玲"
		   text="『お昼ゴハン‥‥パスタだけど、机の上に置いておくから。』" voices=""/>
		<msg @l="120" char_id="1" frame_id="-1" name="玲" text="『お腹すいたら食べて。それじゃ。』"
		   voices=""/>
		<se @l="124" buf="1" src="遠ざかっていく足音_室内" volume="1."/>
		<msg @l="126" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="128" char_id="0" frame_id="-1" name="美帆"
		   text="『‥‥‥‥うっ‥‥‥うぅっ‥‥‥‥‥。』" voices=""/>
		<msg @l="130" char_id="-1" frame_id="-1" name=""
		   text="遠ざかっていく足音を聞きながら、私は枕に顔を埋めて泣いた。" voices=""/>
		<msg @l="131" char_id="-1" frame_id="-1" name="" text="声を聞かせてはいけない。"
		   voices=""/>
		<msg @l="132" char_id="-1" frame_id="-1" name="" text="玲さんを巻き込んではいけない。"
		   voices=""/>
		<msg @l="133" char_id="-1" frame_id="-1" name=""
		   text="そう思いながら‥‥必死に、声を押し殺して―――。" voices=""/>
		<stopbgm @l="137" fadeout="1000"/>
		<se @l="141" buf="3" loop="true" src="着メロ2" volume="1."/>
		<msg @l="143" char_id="0" frame_id="-1" name="美帆" text="『‥‥！！』" voices=""/>
		<msg @l="145" char_id="-1" frame_id="-1" name="" text="突然の電子音に、私は思わず肩を震わせる。"
		   voices=""/>
		<msg @l="146" char_id="-1" frame_id="-1" name="" text="嫌な‥‥予感がした。" voices=""/>
		<msg @l="148" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="150" char_id="-1" frame_id="-1" name=""
		   text="バッグの中に入りっぱなしになっている携帯電話を取り出して、恐る恐るディスプレイを見る。" voices=""/>
		<msg @l="151" char_id="-1" frame_id="-1" name="" text="発信元は――――。" voices=""/>
		<se @l="155" buf="3" loop="true" src="心臓" volume="1."/>
		<msg @l="157" char_id="-1" frame_id="-1" name="" text="ナカネ&#32;アキナ&#32;ケイタイ"
		   voices=""/>
		<stopse @l="161" buf="3"/>
		<msg @l="163" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="165" char_id="-1" frame_id="-1" name="" text="息が出来なかった。" voices=""/>
		<msg @l="166" char_id="-1" frame_id="-1" name=""
		   text="携帯電話を持っている手がひとりでに震える。" voices=""/>
		<msg @l="167" char_id="-1" frame_id="-1" name="" text="亜季奈には―――知られていけない。"
		   voices=""/>
		<msg @l="168" char_id="-1" frame_id="-1" name=""
		   text="何としても亜季奈だけは巻き込んではいけない。" voices=""/>
		<msg @l="169" char_id="-1" frame_id="-1" name="" text="普通に電話にでなければ‥‥。"
		   voices=""/>
		<stopse @l="173" buf="3"/>
		<char @l="177" id="miho" pos="auto" src="miho136"/>
		<msg @l="179" char_id="0" frame_id="-1" name="美帆" text="『はい‥‥。』" voices=""/>
		<msg @l="181" char_id="2" frame_id="-1" name="声" text="『‥‥‥‥。』" voices=""/>
		<char @l="185" id="miho" pos="auto" src="miho134"/>
		<msg @l="187" char_id="0" frame_id="-1" name="美帆" text="『亜季奈‥‥ねえ、亜季奈なんでしょ？』"
		   voices=""/>
		<msg @l="189" char_id="2" frame_id="-1" name="亜季奈"
		   text="『ぐすっ‥‥‥うっ‥‥お姉ちゃん‥‥‥‥。』" voices=""/>
		<msg @l="191" char_id="0" frame_id="-1" name="美帆"
		   text="『亜季奈っ‥‥あなたいまどこにいるの？』" voices=""/>
		<msg @l="193" char_id="2" frame_id="-1" name="亜季奈" text="『プールに‥‥いる。』"
		   voices=""/>
		<msg @l="195" char_id="0" frame_id="-1" name="美帆" text="『まさか、何かされてるの‥‥？』"
		   voices=""/>
		<msg @l="197" char_id="2" frame_id="-1" name="亜季奈"
		   text="『私は‥‥されてない‥‥‥‥けど、お姉ちゃんっ‥‥‥‥。』" voices=""/>
		<msg @l="199" char_id="2" frame_id="-1" name="亜季奈"
		   text="『お姉ちゃんが来ないと‥‥‥ひどいこと‥‥‥するって‥‥‥。』" voices=""/>
		<char @l="203" id="miho" pos="auto" src="miho135"/>
		<msg @l="205" char_id="0" frame_id="-1" name="美帆"
		   text="『あの人が‥‥‥渡部先生がそういったのね？』" voices=""/>
		<msg @l="207" char_id="2" frame_id="-1" name="亜季奈" text="『うん‥‥。』" voices=""/>
		<msg @l="209" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="211" char_id="2" frame_id="-1" name="亜季奈"
		   text="『どうしよう‥‥お姉ちゃん、私‥‥‥どうしようっ‥‥‥。』" voices=""/>
		<msg @l="213" char_id="2" frame_id="-1" name="亜季奈" text="『ひぐっ‥‥。』" voices=""/>
		<msg @l="215" char_id="0" frame_id="-1" name="美帆" text="『すぐに‥‥。』" voices=""/>
		<char @l="219" id="miho" pos="auto" src="miho035"/>
		<msg @l="221" char_id="0" frame_id="-1" name="美帆"
		   text="『すぐに行くから、渡部先生にそう伝えて。』" voices=""/>
		<msg @l="223" char_id="2" frame_id="-1" name="亜季奈" text="『お姉ちゃん‥‥。』"
		   voices=""/>
		<msg @l="225" char_id="0" frame_id="-1" name="美帆"
		   text="『大丈夫‥‥‥絶対、助けるから‥‥‥。』" voices=""/>
		<msg @l="227" char_id="-1" frame_id="-1" name="" text="亜季奈だけは、必ず助けなければ‥‥。"
		   voices=""/>
		<msg @l="228" char_id="-1" frame_id="-1" name="" text="例え‥‥私がどんな目にあっても。"
		   voices=""/>
		<stopbgm @l="232" fadeout="1000"/>
		<clear @l="238" class="all"/>
		<wait_chgmv/>
		<bg @l="242" src="bg10"/>
		<bgm @l="246" src="bgm10" volume="1."/>
		<char @l="250" id="watab" pos="auto" src="watabe010"/>
		<msg @l="252" char_id="-1" frame_id="-1" name="渡部" text="『よお、遅かったなぁ。』"
		   voices=""/>
		<msg @l="254" char_id="-1" frame_id="-1" name=""
		   text="そういって私を迎えた渡部先生の表情は何処か勝ち誇っていて、満足げだった。" voices=""/>
		<msg @l="255" char_id="-1" frame_id="-1" name="" text="‥‥亜季奈は、いない。"
		   voices=""/>
		<clear @l="258" class="char"/>
		<char @l="260" id="watab" pos="left" src="watabe010"/>
		<char @l="263" id="miho" pos="right" src="miho114"/>
		<msg @l="265" char_id="0" frame_id="-1" name="美帆"
		   text="『あの子は‥‥亜季奈はどこですかっ！？』" voices=""/>
		<msg @l="267" char_id="-1" frame_id="-1" name="渡部"
		   text="『ああ、アイツなら更衣室にいるんじゃないか？』" voices=""/>
		<msg @l="269" char_id="0" frame_id="-1" name="美帆" text="『‥‥！？』" voices=""/>
		<msg @l="271" char_id="0" frame_id="-1" name="美帆"
		   text="『また、亜季奈に何かしたんですかっ！？』" voices=""/>
		<msg @l="273" char_id="-1" frame_id="-1" name="渡部"
		   text="『そんなに心配なら見に行ってみたらどうだ？』" voices=""/>
		<char @l="275" id="miho" pos="right" src="miho015"/>
		<msg @l="277" char_id="0" frame_id="-1" name="美帆" text="『くっ‥‥！！』" voices=""/>
		<clear @l="283" class="all"/>
		<wait_chgmv/>
		<bg @l="287" src="bg11"/>
		<char @l="291" id="miho" pos="auto" src="miho114"/>
		<msg @l="293" char_id="0" frame_id="-1" name="美帆" text="『亜季奈っ！！』" voices=""/>
		<clear @l="296" class="char"/>
		<char @l="298" id="miho" pos="left" src="miho114"/>
		<char @l="301" id="akina" pos="right" src="akina054"/>
		<msg @l="303" char_id="2" frame_id="-1" name="亜季奈" text="『お姉ちゃんっ！！！』"
		   voices=""/>
		<msg @l="305" char_id="0" frame_id="-1" name="美帆"
		   text="『大丈夫？&#32;酷いことされてない！？』" voices=""/>
		<char @l="309" id="akina" pos="right" src="akina055"/>
		<msg @l="311" char_id="2" frame_id="-1" name="亜季奈"
		   text="『う、うん‥‥私は大丈夫だけど‥‥‥‥。』" voices=""/>
		<char @l="315" id="watab" pos="right" src="watabe010"/>
		<msg @l="317" char_id="-1" frame_id="-1" name="渡部"
		   text="『自分の身を呈してでも妹を助けたい‥‥か。』" voices=""/>
		<msg @l="319" char_id="-1" frame_id="-1" name="渡部"
		   text="『いやいや、姉妹愛というのは素晴らしいもんだな。』" voices=""/>
		<char @l="322" id="miho" pos="left" src="miho015"/>
		<msg @l="324" char_id="0" frame_id="-1" name="美帆"
		   text="『アナタは、そうやって簡単に人の心を踏みにじって‥‥‥。』" voices=""/>
		<msg @l="326" char_id="0" frame_id="-1" name="美帆"
		   text="『恥ずかしいとは思わないんですかっ‥‥！？』" voices=""/>
		<msg @l="328" char_id="-1" frame_id="-1" name="渡部"
		   text="『生憎そういった考えは持ち合わせていなくてね。』" voices=""/>
		<char @l="332" id="akina" pos="right" src="akina055"/>
		<msg @l="334" char_id="2" frame_id="-1" name="亜季奈" text="『お姉ちゃん‥‥わたし‥‥‥。』"
		   voices=""/>
		<char @l="338" id="miho" pos="left" src="miho010"/>
		<msg @l="340" char_id="0" frame_id="-1" name="美帆"
		   text="『亜季奈は先に帰りなさい‥‥ここは、私に任せて。』" voices=""/>
		<msg @l="342" char_id="2" frame_id="-1" name="亜季奈" text="『でも‥‥。』" voices=""/>
		<char @l="345" id="miho" pos="left" src="miho116"/>
		<msg @l="347" char_id="0" frame_id="-1" name="美帆" text="『いいから、任せて‥‥‥‥ね？』"
		   voices=""/>
		<msg @l="349" char_id="2" frame_id="-1" name="亜季奈" text="『う、うん‥‥。』"
		   voices=""/>
		<clear @l="353" layer="akina"/>
		<msg @l="355" char_id="-1" frame_id="-1" name=""
		   text="そうして亜季奈は渡部先生の様子を伺うように、更衣室を出て行く。" voices=""/>
		<msg @l="356" char_id="-1" frame_id="-1" name=""
		   text="渡部先生はそれを横目で姿を追っただけで‥‥特に固執はして無いようだ。" voices=""/>
		<char @l="363" id="watab" pos="right" src="watabe010"/>
		<msg @l="365" char_id="0" frame_id="-1" name="美帆" text="『それで‥‥今日は私に何の用ですか？』"
		   voices=""/>
		<msg @l="367" char_id="-1" frame_id="-1" name="渡部"
		   text="『ふん、水泳部のコーチをプールに呼んですることは一つだろ？』" voices=""/>
		<msg @l="369" char_id="0" frame_id="-1" name="美帆" text="『‥‥信じられません。』"
		   voices=""/>
		<msg @l="371" char_id="-1" frame_id="-1" name="渡部"
		   text="『信じられなければ、オマエの妹に代わりに相手をしてもらうだけだな。』" voices=""/>
		<char @l="375" id="miho" pos="left" src="miho114"/>
		<msg @l="377" char_id="0" frame_id="-1" name="美帆" text="『‥‥！！』" voices=""/>
		<msg @l="379" char_id="-1" frame_id="-1" name="渡部"
		   text="『何せ合宿が終わった後でも、オマエの妹は俺の目と鼻の先に居る訳だからな。』" voices=""/>
		<msg @l="381" char_id="-1" frame_id="-1" name="渡部"
		   text="『その気になればいつでも‥‥というワケだ。』" voices=""/>
		<char @l="385" id="miho" pos="left" src="miho115"/>
		<msg @l="387" char_id="0" frame_id="-1" name="美帆" text="『くっ‥‥。』" voices=""/>
		<msg @l="389" char_id="-1" frame_id="-1" name="渡部"
		   text="『俺は別にどっちでもいいんだぜ‥‥。』" voices=""/>
		<msg @l="391" char_id="-1" frame_id="-1" name="渡部" text="『どうする？』" voices=""/>
		<char @l="393" id="miho" pos="left" src="miho015"/>
		<msg @l="394" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="396" char_id="0" frame_id="-1" name="美帆"
		   text="『解りました‥‥私が言う事を聞けば、妹には絶対に手を出さないと約束してもらえますか？』" voices=""/>
		<msg @l="398" char_id="-1" frame_id="-1" name="渡部" text="『それはオマエの態度次第だな。』"
		   voices=""/>
		<char @l="400" id="miho" pos="left" src="miho115"/>
		<msg @l="401" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<stopbgm @l="405" fadeout="1000"/>
		<clear @l="411" class="all"/>
		<msgshow @l="413" show="true"/>
		<wait_chgmv/>
		<bg @l="417" src="bg10"/>
		<bgm @l="421" src="bgm02" volume="1."/>
		<char @l="425" id="miho" pos="auto" src="miho060"/>
		<msg @l="427" char_id="0" frame_id="-1" name="美帆"
		   text="『ハイ、もっと腕を伸ばして‥‥‥肩の力を抜いてください。』" voices=""/>
		<msg @l="429" char_id="0" frame_id="-1" name="美帆"
		   text="『自分でテンポを作ってタイミングよくブレスを入れると、バランスを崩す事も少なくなりますから。』" voices=""/>
		<msg @l="431" char_id="-1" frame_id="-1" name="水泳部の子" text="『はい、わかりましたっ。』"
		   voices=""/>
		<char @l="435" id="miho" pos="auto" src="miho061"/>
		<msg @l="437" char_id="0" frame_id="-1" name="美帆" text="『がんばって。』" voices=""/>
		<msg @l="439" char_id="-1" frame_id="-1" name="水泳部の子" text="『ありがとうございます！』"
		   voices=""/>
		<msg @l="441" char_id="-1" frame_id="-1" name=""
		   text="私は‥‥いつも通りの風景を作ろうとしていた。" voices=""/>
		<msg @l="442" char_id="-1" frame_id="-1" name=""
		   text="昨日の出来事は悪い夢だったのだと、自分に言い聞かせるようにしていた。" voices=""/>
		<msg @l="443" char_id="-1" frame_id="-1" name="" text="でも、ここには亜季奈がいない。"
		   voices=""/>
		<msg @l="444" char_id="-1" frame_id="-1" name=""
		   text="あの子はもう‥‥二度と、ここに戻ってくるコトはないだろう。" voices=""/>
		<msg @l="445" char_id="-1" frame_id="-1" name=""
		   text="もしかしたら水泳自体を捨てるかもしれない。" voices=""/>
		<msg @l="446" char_id="-1" frame_id="-1" name="" text="三年前の私と同じように‥‥。"
		   voices=""/>
		<clear @l="449" class="char"/>
		<char @l="451" id="miho" pos="auto" src="miho060"/>
		<stopbgm @l="457" fadeout="1000"/>
		<msg @l="459" char_id="-1" frame_id="-1" name="渡部"
		   text="『どうした、何をぼうっとしてるんだ‥‥コーチ。』" voices=""/>
		<char @l="463" id="miho" pos="auto" src="miho165"/>
		<msg @l="465" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<bgm @l="469" src="bgm10" volume="1."/>
		<msg @l="471" char_id="-1" frame_id="-1" name=""
		   text="気付けば、私の背後には渡部先生がにじり寄ってきていた。" voices=""/>
		<msg @l="472" char_id="-1" frame_id="-1" name="" text="何が目的かなんて‥‥確かめるまでも無い。"
		   voices=""/>
		<msg @l="473" char_id="-1" frame_id="-1" name="" text="また、私の身体を貪りにきたのだろう。"
		   voices=""/>
		<char @l="477" id="miho" pos="auto" src="miho166"/>
		<msg @l="479" char_id="0" frame_id="-1" name="美帆" text="『‥‥私は言われた通りにしてます。』"
		   voices=""/>
		<msg @l="482" char_id="-1" frame_id="-1" name="渡部"
		   text="『そう邪険にしなくてもいいじゃないか。』" voices=""/>
		<msg @l="484" char_id="-1" frame_id="-1" name="渡部"
		   text="『顧問とコーチの親睦を深める為のスキンシップでもどうかと思っただけさ。くっくっく。』" voices=""/>
		<clear @l="487" class="char"/>
		<char @l="490" id="miho" pos="center" src="miho165f" y="-80"/>
		<begin_trans @l="494" time="500"/>
		<layer @l="495" id="cutin_f" src="game_window_cutin" x="20" y="20" z="-1001"/>
		<layer @l="496" id="cutin" src="cut004" x="32" y="32" z="-1000"/>
		<end_trans @l="497"/>
		<msg @l="499" char_id="-1" frame_id="-1" name=""
		   text="そう言って、渡部先生は水着の上から私のお尻を撫ではじめる。" voices=""/>
		<msg @l="501" char_id="-1" frame_id="-1" name="渡部"
		   text="『それとも‥‥こういうスキンシップは嫌いだったかな？』" voices=""/>
		<msg @l="503" char_id="-1" frame_id="-1" name=""
		   text="渡部先生は私の耳元でささやきながら、口元を邪悪に歪める。" voices=""/>
		<msg @l="504" char_id="-1" frame_id="-1" name=""
		   text="私が嫌といえば‥‥その矛先は亜季奈に向くのだ。" voices=""/>
		<msg @l="505" char_id="-1" frame_id="-1" name="" text="選択の余地など最初から無い。"
		   voices=""/>
		<msg @l="507" char_id="0" frame_id="-1" name="美帆"
		   text="『スキンシップでも何でも好きにしてください‥‥。』" voices="miho02660"/>
		<msg @l="509" char_id="0" frame_id="-1" name="美帆"
		   text="『ただ‥‥皆に分からないようにお願いします。』" voices="miho02670"/>
		<msg @l="511" char_id="-1" frame_id="-1" name="渡部" text="『それはお前しだいだな。』"
		   voices=""/>
		<msg @l="513" char_id="-1" frame_id="-1" name="渡部"
		   text="『せいぜい部員たちにバレないように‥‥ごまかしてみるんだな。』" voices=""/>
		<msg @l="515" char_id="-1" frame_id="-1" name=""
		   text="そうして、渡部先生は楽しげにお尻をこねまわすように揉み始める。" voices=""/>
		<msg @l="516" char_id="-1" frame_id="-1" name=""
		   text="さらに人差し指と中指を内腿の中に滑り込ませようとしていた。" voices=""/>
		<char @l="519" id="miho" pos="center" src="miho166f" y="-80"/>
		<msg @l="520" char_id="0" frame_id="-1" name="美帆"
		   text="(気にしちゃダメ、いまは練習に集中しないと‥‥)" voices="miho02680"/>
		<msg @l="522" char_id="-1" frame_id="-1" name=""
		   text="平静を装い、私は再び隣のコースを泳いでいる子へと視線を戻そうとする。" voices=""/>
		<msg @l="523" char_id="-1" frame_id="-1" name=""
		   text="けれど‥‥そうして装った平静も次の渡部先生の行動で崩れざるをえなかった。" voices=""/>
		<char @l="527" id="miho" pos="center" src="miho064f" y="-80"/>
		<msg @l="529" char_id="0" frame_id="-1" name="美帆" text="『え‥‥。』"
		   voices="miho02690"/>
		<msg @l="531" char_id="-1" frame_id="-1" name=""
		   text="渡部先生の手が水着を止めている結び目へと伸び、それを解こうとする。" voices=""/>
		<msg @l="533" char_id="0" frame_id="-1" name="美帆" text="『や‥‥な、なにをっ！？』"
		   voices="miho02700"/>
		<msg @l="535" char_id="-1" frame_id="-1" name="渡部"
		   text="『ほら、どうした‥‥俺のコトは気にせず指導を続けたらどうだ。』" voices=""/>
		<msg @l="537" char_id="-1" frame_id="-1" name=""
		   text="ニヤニヤと楽しげな笑みをその口元に浮かべながらつぶやき、渡部先生はやはり水着の結び目を弄り続ける。" voices=""/>
		<char @l="540" id="miho" pos="center" src="miho164f" y="-80"/>
		<msg @l="541" char_id="0" frame_id="-1" name="美帆" text="『あ‥‥。』"
		   voices="miho02710"/>
		<begin_trans @l="545" time="500"/>
		<layer @l="546" id="cutin_f" src="game_window_cutin" x="20" y="20" z="-1001"/>
		<layer @l="547" id="cutin" src="cut003" x="32" y="32" z="-1000"/>
		<end_trans @l="548"/>
		<msg @l="550" char_id="-1" frame_id="-1" name=""
		   text="パレオが外れ、その下にあるパンツもまたズリおろされてしまう。" voices=""/>
		<msg @l="551" char_id="-1" frame_id="-1" name=""
		   text="下半身を覆っていた小さな布がなくなっただけで、途端に太股の間を流れていく水の感触がリアルになる。" voices=""/>
		<char @l="555" id="miho" pos="center" src="miho065f" y="-80"/>
		<msg @l="557" char_id="0" frame_id="-1" name="美帆"
		   text="『やめてください‥‥水泳部の子にみつかってしまいます。』" voices="miho02720"/>
		<msg @l="559" char_id="-1" frame_id="-1" name="渡部"
		   text="『解っているんだったら隠せよ。見つかって困るのはお前だろ？』" voices=""/>
		<msg @l="561" char_id="-1" frame_id="-1" name="渡部"
		   text="『バレないようにせいぜい頑張るんだな。』" voices=""/>
		<char @l="565" id="miho" pos="center" src="miho164f" y="-80"/>
		<msg @l="567" char_id="0" frame_id="-1" name="美帆" text="『そんなっ‥‥！！』"
		   voices="miho02730"/>
		<msg @l="569" char_id="-1" frame_id="-1" name="水泳部の子Ｂ"
		   text="『あの‥‥美帆コーチ、どうかしたんですか？』" voices=""/>
		<char @l="573" id="miho" pos="center" src="miho163f" y="-80"/>
		<msg @l="575" char_id="0" frame_id="-1" name="美帆"
		   text="『え‥‥あ、いえ‥‥‥なんでもないですよ。』" voices="miho02740"/>
		<msg @l="577" char_id="-1" frame_id="-1" name="水泳部の子Ｂ"
		   text="『でも、なんだか顔が赤いですけど？』" voices=""/>
		<msg @l="579" char_id="0" frame_id="-1" name="美帆" text="『そ、そんなことないです‥‥。』"
		   voices="miho02750"/>
		<msg @l="581" char_id="-1" frame_id="-1" name="水泳部の子Ｂ" text="『そうですか？』"
		   voices=""/>
		<char @l="583" id="miho" pos="center" src="miho165f" y="-80"/>
		<msg @l="584" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』"
		   voices="miho02760"/>
		<msg @l="586" char_id="-1" frame_id="-1" name=""
		   text="そうしたやり取りが交わされてる間も、水面下では渡部先生の指先が、露になった私の秘部に押し込まれる。" voices=""/>
		<msg @l="587" char_id="-1" frame_id="-1" name=""
		   text="水の冷たい感触とゴツゴツした指から伝わる熱のアンバランスさが‥‥妙な刺激をアソコに与えていた。" voices=""/>
		<char @l="591" id="miho" pos="center" src="miho164f" y="-80"/>
		<msg @l="593" char_id="0" frame_id="-1" name="美帆" text="『んっ‥‥。』"
		   voices="miho02770"/>
		<msg @l="595" char_id="-1" frame_id="-1"
		   name="膣口付近をなぞるように這い回っていた指が、割れ目奥深くへと侵入してきた。" text="思わず声を漏らしてしまう。"
		   voices=""/>
		<msg @l="596" char_id="-1" frame_id="-1" name=""
		   text="声を掛けて来た水泳部の子は、不思議そうにそんな私を見つめていた。" voices=""/>
		<msg @l="597" char_id="-1" frame_id="-1" name=""
		   text="苦笑を浮かべて「なんでもないですよ」と答えると‥‥再び練習に戻っていった。" voices=""/>
		<msg @l="599" char_id="-1" frame_id="-1" name="渡部"
		   text="『おいおい、今のは危なかったんじゃないか？』" voices=""/>
		<char @l="602" id="miho" pos="center" src="miho163f" y="-80"/>
		<msg @l="604" char_id="0" frame_id="-1" name="美帆"
		   text="『それはアナタがっ‥‥‥いやっ‥‥んんっ‥‥‥‥。』" voices="miho02780"/>
		<msg @l="606" char_id="-1" frame_id="-1" name=""
		   text="渡部先生は挿入した人差し指に加え中指を秘部に入れ、指の腹で秘壁を撫でまわす。" voices=""/>
		<msg @l="608" char_id="-1" frame_id="-1" name="渡部"
		   text="『ほら‥‥俺がどうしたって‥‥‥‥？』" voices=""/>
		<char @l="612" id="miho" pos="center" src="miho166f" y="-80"/>
		<msg @l="614" char_id="0" frame_id="-1" name="美帆"
		   text="『なんでもありません‥‥‥練習、続けなくてよろしいんですか？』" voices="miho02790"/>
		<msg @l="616" char_id="-1" frame_id="-1" name="渡部" text="『練習ならお前が教えればいいだろ？』"
		   voices=""/>
		<msg @l="618" char_id="-1" frame_id="-1" name="渡部"
		   text="『俺はお前のアソコを貪ってるが、気にせずやれよ。』" voices=""/>
		<char @l="620" id="miho" pos="center" src="miho163f" y="-80"/>
		<msg @l="621" char_id="0" frame_id="-1" name="美帆" text="『あっ‥‥んんっ。』"
		   voices="miho02800"/>
		<msg @l="623" char_id="-1" frame_id="-1" name=""
		   text="秘部へ挿入した渡部先生の指が割れ目を押し広げてさらに奥へと侵入してくる。" voices=""/>
		<msg @l="624" char_id="-1" frame_id="-1" name=""
		   text="広げられた膣口にプールの水が入り込み、水と一緒に胎内を指でかき混ぜられる。" voices=""/>
		<msg @l="626" char_id="0" frame_id="-1" name="美帆"
		   text="(んんっ‥‥いやっ‥‥‥でも‥‥抵抗してもこの人を喜ばせるだけだし‥‥‥‥)" voices="miho02810"/>
		<char @l="629" id="miho" pos="center" src="miho060f" y="-80"/>
		<msg @l="630" char_id="0" frame_id="-1" name="美帆"
		   text="(ここは、何でもないフリをして我慢するしかないのかな‥‥‥)" voices="miho02820"/>
		<msg @l="632" char_id="-1" frame_id="-1" name=""
		   text="蠢いている渡部先生の指に意識を取られぬよう、再び隣のコースへ視線を戻す。" voices=""/>
		<msg @l="633" char_id="-1" frame_id="-1" name=""
		   text="しばらく私の指示が出ていなかったせいか、みんな思い思いのスタイルで練習を続けているようだ。" voices=""/>
		<msg @l="635" char_id="-1" frame_id="-1" name="渡部"
		   text="『ほう‥‥我慢しようというわけだな。』" voices=""/>
		<msg @l="637" char_id="-1" frame_id="-1" name=""
		   text="私の意図を見抜いた渡部先生は、何かを思いついたようにいやらしい笑みを浮かべる。" voices=""/>
		<msg @l="638" char_id="-1" frame_id="-1" name=""
		   text="突き入れた指をゆっくり抜き、さらに奥へ押しこむという事を繰り返しだした。" voices=""/>
		<char @l="642" id="miho" pos="center" src="miho164f" y="-80"/>
		<msg @l="644" char_id="0" frame_id="-1" name="美帆" text="『あっ‥‥んんっ！！』"
		   voices="miho02830"/>
		<msg @l="646" char_id="-1" frame_id="-1" name=""
		   text="突然の刺激に私は不意に声を漏らしてしまう。" voices=""/>
		<msg @l="647" char_id="-1" frame_id="-1" name=""
		   text="幸い‥‥近くに水泳部の子はおらず、聞かれはしなかったようだ。" voices=""/>
		<char @l="651" id="miho" pos="center" src="miho166f" y="-80"/>
		<msg @l="653" char_id="0" frame_id="-1" name="美帆"
		   text="『もう、やめてください‥‥お願いします‥‥‥。』" voices="miho02840"/>
		<msg @l="655" char_id="0" frame_id="-1" name="美帆"
		   text="『こんなことされていては‥‥んくっ、練習に集中できません。』" voices="miho02850"/>
		<msg @l="657" char_id="-1" frame_id="-1" name="渡部"
		   text="『出来ませんじゃなくて、するんだよ。』" voices=""/>
		<char @l="659" id="miho" pos="center" src="miho065f" y="-80"/>
		<msg @l="660" char_id="0" frame_id="-1" name="美帆" text="『そんなっ。』"
		   voices="miho02860"/>
		<msg @l="662" char_id="-1" frame_id="-1" name="渡部"
		   text="『それに、この程度で音を上げてちゃコイツには堪えられないぞ。』" voices=""/>
		<char @l="664" id="miho" pos="center" src="miho064f" y="-80"/>
		<msg @l="665" char_id="0" frame_id="-1" name="美帆" text="『え‥‥。』"
		   voices="miho02870"/>
		<begin_trans @l="669" time="500"/>
		<clear @l="670" layer="cutin_f"/>
		<clear @l="671" layer="cutin"/>
		<end_trans @l="672"/>
		<msg @l="674" char_id="-1" frame_id="-1" name=""
		   text="弄っていた指が不意に引き抜かれ、代わりと言わんばかりに熱く硬いモノが秘部へ押し付けられる。" voices=""/>
		<msg @l="675" char_id="-1" frame_id="-1" name=""
		   text="忘れるハズも無い‥‥それは、昨日私の身体を貫いた肉棒だ。" voices=""/>
		<char @l="679" id="miho" pos="center" src="miho164f" y="-80"/>
		<msg @l="681" char_id="0" frame_id="-1" name="美帆" text="『うそ‥‥正気ですかっ！？』"
		   voices="miho02880"/>
		<msg @l="683" char_id="-1" frame_id="-1" name="渡部"
		   text="『正気か狂気かでいえば、俺はとっくに後者なんだよ。』" voices=""/>
		<msg @l="685" char_id="-1" frame_id="-1" name="渡部"
		   text="『三年前‥‥オマエを襲おうとした、あの時からな！』" voices=""/>
		<label @l="688" id="event_scene18"/>
		<label @l="692" id="chart_line24"/>
		<wait_chgmv/>
		<ev @l="696" src="ev-018"/>
		<description @l="699" text="水中挿入"/>
		<bgm @l="703" src="bgm14" volume="1."/>
		<msg @l="705" char_id="0" frame_id="-1" name="美帆" text="『んんっ‥‥！！』"
		   voices="miho02890"/>
		<msg @l="707" char_id="-1" frame_id="-1" name=""
		   text="秘貝を押し割り、硬く屹立したモノがズブズブズブッと奥深くへと突き入れられる。" voices=""/>
		<msg @l="708" char_id="-1" frame_id="-1" name=""
		   text="プールの水で冷やされた身体に突き入れられたそれは、熱く焼かれた鉄棒のようで、冷たい肉壁をジュッ、ジュッと融かしながら動き回る。"
		   voices=""/>
		<msg @l="710" char_id="-1" frame_id="-1" name="渡部"
		   text="『水で冷えたマ○コというのも具合が変わって面白いな。』" voices=""/>
		<msg @l="712" char_id="0" frame_id="-1" name="美帆"
		   text="『やあっ‥‥ん、んんっ‥‥‥‥こんなところでっ‥‥‥‥‥。』" voices="miho02900"/>
		<msg @l="714" char_id="-1" frame_id="-1" name="渡部"
		   text="『こんな所だから、こんな状況だからこそ燃えるんだろ？』" voices=""/>
		<msg @l="716" char_id="-1" frame_id="-1" name="渡部"
		   text="『そら‥‥しっかり指導してやらないと、そろそろ周りの連中が不審がってきてるんじゃないか？』" voices=""/>
		<msg @l="718" char_id="0" frame_id="-1" name="美帆" text="『そ、そんなっ‥‥‥んぁ‥‥‥‥‥。』"
		   voices="miho02910"/>
		<msg @l="720" char_id="-1" frame_id="-1" name=""
		   text="確かに‥‥こちらを不審げな表情で見ている子が何人も居る。" voices=""/>
		<msg @l="721" char_id="-1" frame_id="-1" name="" text="次の指示が出されない。"
		   voices=""/>
		<msg @l="722" char_id="-1" frame_id="-1" name="" text="顧問と妙に密着している。"
		   voices=""/>
		<msg @l="723" char_id="-1" frame_id="-1" name="" text="様子がおかしい。" voices=""/>
		<msg @l="724" char_id="-1" frame_id="-1" name="" text="そんな感じに見えるのだろう。"
		   voices=""/>
		<msg @l="726" char_id="0" frame_id="-1" name="美帆"
		   text="『み、みんな‥‥とりあえず自由に泳いでいてください。』" voices="miho02920"/>
		<msg @l="728" char_id="0" frame_id="-1" name="美帆"
		   text="『気になる所があれば、個人的に‥‥んんっ‥‥指導しますから。』" voices="miho02930"/>
		<msg @l="730" char_id="-1" frame_id="-1" name="水泳部の子たち" text="『はーい。』"
		   voices=""/>
		<msg @l="732" char_id="-1" frame_id="-1" name=""
		   text="とっさに‥‥私は適当な指示を出してその場をやり過ごす。" voices=""/>
		<msg @l="733" char_id="-1" frame_id="-1" name=""
		   text="殆ど「自由行動」に近い指示にも関わらず、水泳部の子たちは改めて競泳コースを泳ぎ始める。" voices=""/>
		<msg @l="735" char_id="-1" frame_id="-1" name="渡部" text="『ふん‥‥上手く逃げたな。』"
		   voices=""/>
		<msg @l="737" char_id="-1" frame_id="-1" name="渡部"
		   text="『だが、その程度で安心するのはまだ早いぞ？』" voices=""/>
		<msg @l="739" char_id="-1" frame_id="-1" name=""
		   text="渡部先生はそう言ってゆっくりと腰を押し付け、熱棒を深々と突き入れてくる。" voices=""/>
		<msg @l="740" char_id="-1" frame_id="-1" name=""
		   text="亀頭の先端が、ヒダをかき分けながら侵入してくるのがわかった。" voices=""/>
		<msg @l="742" char_id="0" frame_id="-1" name="美帆" text="『あっ‥‥。』"
		   voices="miho02940"/>
		<msg @l="744" char_id="-1" frame_id="-1" name=""
		   text="やがて‥‥侵入してきていた肉棒が最奥へ到達する。" voices=""/>
		<msg @l="745" char_id="-1" frame_id="-1" name=""
		   text="先端が奥の壁を押し上げ、身体はそれに反応するようにカッと熱くなる。" voices=""/>
		<msg @l="747" char_id="-1" frame_id="-1" name="渡部" text="『お、ナカが急に熱くなってきたな？』"
		   voices=""/>
		<msg @l="749" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥っ‥‥。』"
		   voices="miho02950"/>
		<msg @l="751" char_id="-1" frame_id="-1" name=""
		   text="自分でもわかるほど、身体の奥が熱くなっていた。" voices=""/>
		<msg @l="752" char_id="-1" frame_id="-1" name=""
		   text="嫌なのに‥‥嫌なハズなのに‥‥‥否応なく身体が反応してしまう。" voices=""/>
		<msg @l="754" char_id="0" frame_id="-1" name="美帆"
		   text="(もしかして、これも昨日使われたクスリのせい‥‥‥？)" voices="miho02960"/>
		<msg @l="756" char_id="0" frame_id="-1" name="美帆"
		   text="(それとも‥‥渡部先生の言う通り、こんな状況だから反応してる？)" voices="miho02970"/>
		<msg @l="758" char_id="-1" frame_id="-1" name="渡部"
		   text="『そら、どうした‥‥マ○コの中がプールの水以外のモノで濡れてきてるんじゃないか？』" voices=""/>
		<msg @l="760" char_id="-1" frame_id="-1" name="渡部"
		   text="『この白く濁ったのはプールの水じゃないよなぁ、あぁ？』" voices=""/>
		<msg @l="762" char_id="0" frame_id="-1" name="美帆"
		   text="『そんな、意地悪なこと‥‥‥言わないで‥‥下さい‥‥んんっ！』" voices="miho02980"/>
		<msg @l="764" char_id="0" frame_id="-1" name="美帆"
		   text="『うぁ‥‥ダメ‥‥‥動かないでっ‥‥‥‥。』" voices="miho02990"/>
		<msg @l="766" char_id="-1" frame_id="-1" name=""
		   text="鋭くえぐったカリの部分が胎内の壁を擦り上げ、淫壁全体で感じる硬い剛直の感触に私は腰を震わせる。" voices=""/>
		<msg @l="768" char_id="-1" frame_id="-1" name="渡部"
		   text="『動いてるのは俺だけじゃないと思うがな？』" voices=""/>
		<msg @l="770" char_id="0" frame_id="-1" name="美帆" text="『え‥‥。』"
		   voices="miho03000"/>
		<msg @l="772" char_id="-1" frame_id="-1" name="渡部"
		   text="『オマエの腰が、俺の動きに合わせてゆらゆら動いているぞ？』" voices=""/>
		<msg @l="774" char_id="0" frame_id="-1" name="美帆" text="『そんなっ‥‥こと‥‥‥‥。』"
		   voices="miho03010"/>
		<msg @l="776" char_id="-1" frame_id="-1" name="渡部"
		   text="『そんな事あるんだよ、この淫乱がっ‥‥そらっ！』" voices=""/>
		<msg @l="778" char_id="0" frame_id="-1" name="美帆" text="『んぅ‥‥あっ、あっ、んんっ‥‥‥。』"
		   voices="miho03020"/>
		<msg @l="780" char_id="-1" frame_id="-1" name=""
		   text="否定の言葉が、暴れまわる肉棒によってかき乱される。" voices=""/>
		<msg @l="781" char_id="-1" frame_id="-1" name="" text="自分の身体なのに自由が効かない‥‥。"
		   voices=""/>
		<msg @l="782" char_id="-1" frame_id="-1" name=""
		   text="腰が意に反して動いてしまい、また淫汁が溢れ出してきてしまう。" voices=""/>
		<msg @l="784" char_id="-1" frame_id="-1" name="渡部"
		   text="『見ろ、あのプールサイドに居るヤツ‥‥コッチを見てるぞ。』" voices=""/>
		<msg @l="786" char_id="0" frame_id="-1" name="美帆" text="『‥‥！？』"
		   voices="miho03030"/>
		<msg @l="788" char_id="-1" frame_id="-1" name=""
		   text="渡部がアゴで指した先には水泳部の子がいて、じっとこちらを見ていた。" voices=""/>
		<msg @l="789" char_id="-1" frame_id="-1" name=""
		   text="なにやら顔を真っ赤にして、モジモジと‥‥。" voices=""/>
		<msg @l="791" char_id="0" frame_id="-1" name="美帆"
		   text="(うそ‥‥なんか‥‥‥‥お腹の辺りでゴソゴソ手、動かしてる)" voices="miho03040"/>
		<msg @l="793" char_id="0" frame_id="-1" name="美帆"
		   text="(あれって‥‥‥ひ、ひとりでしてるの‥‥‥‥‥？)" voices="miho03050"/>
		<msg @l="795" char_id="-1" frame_id="-1" name="渡部"
		   text="『なんだアイツ、俺たちのコトに気付いてコキ始めやがったか。』" voices=""/>
		<msg @l="797" char_id="0" frame_id="-1" name="美帆" text="『え‥‥。』"
		   voices="miho03060"/>
		<msg @l="799" char_id="-1" frame_id="-1" name="渡部"
		   text="『解らないか？&#32;オマエが犯されるのをオカズにして一人でオナってんだよ。』" voices=""/>
		<msg @l="801" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』"
		   voices="miho03070"/>
		<msg @l="803" char_id="-1" frame_id="-1" name=""
		   text="私はもう一度、ちらりとプールサイドを見る。" voices=""/>
		<msg @l="805" char_id="-1" frame_id="-1" name="水泳部の子" text="『‥‥‥っ‥‥。』"
		   voices=""/>
		<msg @l="807" char_id="-1" frame_id="-1" name=""
		   text="両膝を抱えて座って‥‥フトモモの間でモゾモゾと手が動いている。" voices=""/>
		<msg @l="808" char_id="-1" frame_id="-1" name=""
		   text="時々キョロキョロと周囲を見て人目を気にしているが、動きは止まらない。" voices=""/>
		<msg @l="810" char_id="0" frame_id="-1" name="美帆"
		   text="(うあ‥‥‥なんか、変な感じがする‥‥‥‥)" voices="miho03080"/>
		<msg @l="812" char_id="0" frame_id="-1" name="美帆"
		   text="(あんな真っ赤になって‥‥‥私の身体を見て、私が犯されてるのを見て一生懸命‥‥‥動かしてる‥‥‥)"
		   voices="miho03090"/>
		<msg @l="814" char_id="-1" frame_id="-1" name="渡部"
		   text="『よかったなぁ、女冥利につきるってやつじゃないか？』" voices=""/>
		<msg @l="816" char_id="0" frame_id="-1" name="美帆" text="『なっ‥‥そ、そんなこと‥‥‥‥。』"
		   voices="miho03100"/>
		<msg @l="818" char_id="-1" frame_id="-1" name="渡部"
		   text="『そら、エロい顔をしっかり見せ付けてイカせてやれよ‥‥コーチ。』" voices=""/>
		<msg @l="820" char_id="0" frame_id="-1" name="美帆" text="『んぁっ！？』"
		   voices="miho03110"/>
		<msg @l="822" char_id="-1" frame_id="-1" name=""
		   text="渡部先生は楽しげにそういうと、腰のストロークに激しさを加える。" voices=""/>
		<msg @l="823" char_id="-1" frame_id="-1" name=""
		   text="そうして秘肉を太くて長い剛直が行き来するたび、太く膨らんだ先端のエラ部分が熱くなった内側の壁をゴリゴリと擦り上げていく。"
		   voices=""/>
		<msg @l="825" char_id="0" frame_id="-1" name="美帆"
		   text="『んん‥‥あっ、あっ、あっ‥‥‥‥んくっ‥‥‥。』" voices="miho03120"/>
		<msg @l="827" char_id="0" frame_id="-1" name="美帆"
		   text="『んぁっっ‥‥‥ダメ‥‥‥‥こんな、見られてるのにっ‥‥‥‥。』" voices="miho03130"/>
		<msg @l="829" char_id="-1" frame_id="-1" name="渡部"
		   text="『その割に、オマエのここは咥え込んで離そうとしないじゃないか？』" voices=""/>
		<msg @l="831" char_id="-1" frame_id="-1" name="" text="腰が引かれ、緩々と男根が抜けていく。"
		   voices=""/>
		<msg @l="832" char_id="-1" frame_id="-1" name=""
		   text="すると、私の意思とは関係なく内側のヒダがそれに絡み付いてしまう。" voices=""/>
		<msg @l="833" char_id="-1" frame_id="-1" name=""
		   text="引き抜かれるのが名残惜しいかのように‥‥。" voices=""/>
		<msg @l="835" char_id="0" frame_id="-1" name="美帆" text="『そ、そんなっ‥‥これは‥‥‥‥。』"
		   voices="miho03140"/>
		<msg @l="837" char_id="-1" frame_id="-1" name="渡部"
		   text="『見られて感じてる変態なんだよ、オマエはな。』" voices=""/>
		<msg @l="839" char_id="0" frame_id="-1" name="美帆" text="『そんなっ‥‥‥ん、ふぁぁっ！？』"
		   voices="miho03150"/>
		<msg @l="841" char_id="-1" frame_id="-1" name=""
		   text="再び、怒張の先端が奥深くまで突き立てられる。" voices=""/>
		<msg @l="842" char_id="-1" frame_id="-1" name=""
		   text="身体の芯から沸いてくるような熱と痺れが‥‥止められない。" voices=""/>
		<msg @l="843" char_id="-1" frame_id="-1" name=""
		   text="私と渡部先生の周りでは泳いでもいないのに水しぶきが不自然に立つが、それすら気にもかけず互いに腰を動かす。" voices=""/>
		<msg @l="845" char_id="0" frame_id="-1" name="美帆"
		   text="『んっ‥‥んっ、んっ、んっ‥‥‥‥んくっ‥‥‥‥。』" voices="miho03160"/>
		<msg @l="847" char_id="0" frame_id="-1" name="美帆"
		   text="『あふっ‥‥‥んっ、んんっ‥‥いやぁ‥‥‥‥いやぁ‥‥‥‥。』" voices="miho03170"/>
		<msg @l="849" char_id="-1" frame_id="-1" name="渡部"
		   text="『いいぞ、そのまま昇れ‥‥‥アイツもそろそろ限界みたいだぞ。』" voices=""/>
		<msg @l="851" char_id="-1" frame_id="-1" name="水泳部の子" text="『‥‥‥っ‥‥。』"
		   voices=""/>
		<msg @l="853" char_id="-1" frame_id="-1" name=""
		   text="プールサイドの子は、もう周りの目を気にする余裕もないほど懸命になって自分のモノを擦り上げていた。" voices=""/>
		<msg @l="854" char_id="-1" frame_id="-1" name=""
		   text="水着の上からでも‥‥硬く屹立したモノの形が見て取れる。" voices=""/>
		<msg @l="855" char_id="-1" frame_id="-1" name="" text="私はゴクリと唾液を飲み込む。"
		   voices=""/>
		<msg @l="857" char_id="0" frame_id="-1" name="美帆" text="『んんっ‥‥。』"
		   voices="miho03180"/>
		<msg @l="860" char_id="0" frame_id="-1" name="美帆"
		   text="『んっ、ああっ‥‥‥ダメ‥‥‥ダメ‥‥‥‥‥。』" voices="miho03190"/>
		<msg @l="862" char_id="0" frame_id="-1" name="美帆"
		   text="『もう‥‥‥ダメっ‥‥‥私、わたしっ‥‥‥‥。』" voices="miho03200"/>
		<msg @l="864" char_id="-1" frame_id="-1" name="渡部"
		   text="『よし‥‥俺もこのまま子宮にぶちまけてやる。』" voices=""/>
		<msg @l="866" char_id="0" frame_id="-1" name="美帆"
		   text="『や、ダメっ‥‥‥膣内はっ‥‥‥‥‥。』" voices="miho03210"/>
		<msg @l="868" char_id="-1" frame_id="-1" name="" text="私は思わず声を荒げてしまう。"
		   voices=""/>
		<msg @l="869" char_id="-1" frame_id="-1" name=""
		   text="その瞬間‥‥驚いたように顔をあげたプールサイドの子と、目が合う。" voices=""/>
		<msg @l="871" char_id="-1" frame_id="-1" name="水泳部の子" text="『‥‥！？』"
		   voices=""/>
		<msg @l="873" char_id="0" frame_id="-1" name="美帆" text="『あっ‥‥いや、見ないでっ！！』"
		   voices="miho03220"/>
		<msg @l="875" char_id="0" frame_id="-1" name="美帆"
		   text="『んっ、あっ‥‥‥いっ、あ、ああっ‥‥‥‥んあああああっ！！』" voices="miho03230"/>
		<flash @l="879" count="4" fade="100" image="white"/>
		<msg @l="881" char_id="-1" frame_id="-1" name=""
		   text="私は‥‥襲い掛かる絶頂に思わず声を上げてしまう。" voices=""/>
		<msg @l="882" char_id="-1" frame_id="-1" name=""
		   text="それと同時に、子宮口へと熱い液体が注ぎ込まれた。" voices=""/>
		<msg @l="883" char_id="-1" frame_id="-1" name="" text="ドクドク‥‥ドクドクと‥‥‥。"
		   voices=""/>
		<msg @l="885" char_id="0" frame_id="-1" name="美帆"
		   text="『あ、ああっ‥‥‥いっぱい‥‥‥‥出ちゃってる‥‥‥‥‥‥。』" voices="miho03240"/>
		<msg @l="887" char_id="-1" frame_id="-1" name=""
		   text="はき散らされる熱い精子に涙をにじませながら、私はプールサイドで自慰にふけっていた男の子を見る。" voices=""/>
		<msg @l="889" char_id="-1" frame_id="-1" name="水泳部の子"
		   text="『はっ‥‥はっ‥‥はっ‥‥！！』" voices=""/>
		<msg @l="891" char_id="-1" frame_id="-1" name=""
		   text="プールサイドの子は‥‥水着の端から白濁色の液体をにじませていた。" voices=""/>
		<msg @l="892" char_id="-1" frame_id="-1" name=""
		   text="私の絶頂と同時に、達してしまったようだ‥‥。" voices=""/>
		<msg @l="894" char_id="-1" frame_id="-1" name="渡部"
		   text="『見られてイクとはな‥‥そういうのがお好みってわけだ、はははっ。』" voices=""/>
		<wait_chgmv/>
		<ev @l="898" src="ev-018x1z1"/>
		<msg @l="900" char_id="0" frame_id="-1" name="美帆" text="『んんっ‥‥。』"
		   voices="miho03250"/>
		<msg @l="902" char_id="-1" frame_id="-1" name=""
		   text="私の耳元でささやきながら渡部先生が満足げに肉塊を引き抜く。" voices=""/>
		<msg @l="903" char_id="-1" frame_id="-1" name=""
		   text="秘口から溢れ出した精液がプールの水に混ざり‥‥汚く濁らせた。" voices=""/>
		<clear @l="909" class="all"/>
		<end_scene @l="912"/>
		<msg @l="914" char_id="-1" frame_id="-1" name="水泳部の子Ａ"
		   text="『お、おい‥‥今なんかすげえエロい声あげたのって‥‥‥。』" voices=""/>
		<msg @l="916" char_id="-1" frame_id="-1" name="水泳部の子Ｂ"
		   text="『マジかよ、仲根のねーちゃんと渡部がプールの中で本番やってたみたいだぜ？』" voices=""/>
		<msg @l="918" char_id="-1" frame_id="-1" name="水泳部の子Ｃ"
		   text="『うそぉ‥‥もうプールに入れないじゃない！』" voices=""/>
		<msg @l="920" char_id="-1" frame_id="-1" name="" text="どこからか声が聞こえてくる。"
		   voices=""/>
		<msg @l="921" char_id="-1" frame_id="-1" name="" text="歓喜の声。" voices=""/>
		<msg @l="922" char_id="-1" frame_id="-1" name="" text="侮蔑の声。" voices=""/>
		<msg @l="923" char_id="-1" frame_id="-1" name="" text="好色な声。" voices=""/>
		<msg @l="924" char_id="-1" frame_id="-1" name=""
		   text="薄ぼんやりとした意識の彼方で聞きながら、心の奥底で何かが音を立てて崩れていくのを感じていた‥‥。" voices=""/>
		<stopbgm @l="928" fadeout="1000"/>
		<clear @l="934" class="all"/>
		<call @l="938" target="EventLabel_40@ending02"/>
		<return @l="939" value="0&#13;&#10;"/>
		<return @l="942" value=""/>
	</code>
</xscript>
