<?xml version="1.0" encoding="utf-8"?>
<xscript>
	<debug editor="&quot;C:\Program&#32;Files&#32;(x86)\sakura\sakura.exe&quot;&#32;&quot;%src%&quot;&#32;-Y=%line%"
	   src="D:\シロップ\町ぐるみの罠＋汚された夏セット版\汚された夏\完成データ\汚された夏\script\text\ending11.txt"/>
	<code>
		<label @l="12" id="EventLabel_49"/>
		<label @l="15" id="event_scene35"/>
		<description @l="19" text="稲庭専属奴隷"/>
		<eval @l="21" expr="f.numDay=0&#13;&#10;"/>
		<wait_chgmv/>
		<bg @l="25" src="bg07"/>
		<bgm @l="29" src="bgm03" volume="1."/>
		<msg @l="31" char_id="-1" frame_id="-1" name="" text="―――数週間後。" voices=""/>
		<msg @l="32" char_id="-1" frame_id="-1" name=""
		   text="大学構内から稲庭俊明の姿が消え、彼に好意を寄せていた女性たちが騒動となったのは一週間ほど前のことである。" voices=""/>
		<msg @l="33" char_id="-1" frame_id="-1" name=""
		   text="いまでは長期の休学だとか外国の大学へ編入しただとか、ありそうも無いような噂が飛び交ってこそいるものの、失踪直後ほどは騒がれなくなった。"
		   voices=""/>
		<msg @l="34" char_id="-1" frame_id="-1" name=""
		   text="偶像というものは皆の目にとまっているからこそ崇拝できるのであり、目前からなくなってしまえば意外とその効力が無くなるのも早い。"
		   voices=""/>
		<msg @l="35" char_id="-1" frame_id="-1" name="" text="‥‥そういうものだ。" voices=""/>
		<wait_chgmv/>
		<bg @l="39" src="bg13"/>
		<msg @l="41" char_id="-1" frame_id="-1" name=""
		   text="そして‥‥彼女たちの間に巻き起こった「稲庭俊明失踪」の裏側で、さらに二名の学生が大学構内から消えている事に気付いたのは何人いただろう。"
		   voices=""/>
		<msg @l="42" char_id="-1" frame_id="-1" name="" text="一人は白石玲。" voices=""/>
		<msg @l="43" char_id="-1" frame_id="-1" name="" text="彼女は噂によれば大学を辞めたのだという。"
		   voices=""/>
		<msg @l="44" char_id="-1" frame_id="-1" name=""
		   text="その真偽は定かではないが‥‥彼女たちの住んでいたマンションが引き払われている事がその噂をより真実に近づけている。" voices=""/>
		<msg @l="45" char_id="-1" frame_id="-1" name=""
		   text="ただ、その後連絡が取れない事を知っている数少ない人間だけが安否を気づかっている。" voices=""/>
		<wait_chgmv/>
		<bg @l="49" src="bg14"/>
		<msg @l="51" char_id="-1" frame_id="-1" name="" text="そしてもう一人の失踪者、仲根美帆。"
		   voices=""/>
		<msg @l="52" char_id="-1" frame_id="-1" name="" text="彼女は‥‥ここにいた。" voices=""/>
		<msg @l="53" char_id="-1" frame_id="-1" name=""
		   text="テニスサークルに割り当てられた部室に吊るされた、哀れな人形。" voices=""/>
		<msg @l="54" char_id="-1" frame_id="-1" name="" text="それがいまの「彼女」である。"
		   voices=""/>
		<msg @l="55" char_id="-1" frame_id="-1" name=""
		   text="さらに‥‥彼女の傍らには常に一人の男が、肌を重ねている。" voices=""/>
		<stopbgm @l="59" fadeout="1000"/>
		<label @l="63" id="chart_line60"/>
		<wait_chgmv/>
		<ev @l="67" src="ev-035"/>
		<bgm @l="71" src="bgm14" volume="1."/>
		<msg @l="73" char_id="-1" frame_id="-1" name="稲庭"
		   text="『はぁ、はぁ、はぁ‥‥‥‥ふ、くふっ‥‥‥あ、あはははははっ！』" voices=""/>
		<msg @l="75" char_id="0" frame_id="-1" name="美帆"
		   text="『あ、あああっ‥‥‥ひう、あっ、あっ、んんんっ！！』" voices="miho12160"/>
		<msg @l="77" char_id="-1" frame_id="-1" name=""
		   text="大学構内から姿を消したと思われていた二人は、昼夜を問わずこの部室で交わりあっていた。" voices=""/>
		<msg @l="78" char_id="-1" frame_id="-1" name=""
		   text="すぐ近くに二人が居ながら誰もその存在に気付かない理由は、この辺りを管理しているのが用務員の熊野だからということにある。"
		   voices=""/>
		<msg @l="79" char_id="-1" frame_id="-1" name=""
		   text="また‥‥薬によりテニスサークルの男子会員の殆どを手駒とした熊野は巧みに記憶操作を行い、隠蔽していた。" voices=""/>
		<msg @l="81" char_id="0" frame_id="-1" name="美帆"
		   text="『ひぁっ‥‥あっ、ああっ‥‥‥ん、んふっ、あああっ。』" voices="miho12170"/>
		<msg @l="83" char_id="-1" frame_id="-1" name=""
		   text="稲庭の肉棒が秘部を貫くたび、美帆の口からは甘い吐息が漏れた。" voices=""/>
		<msg @l="84" char_id="-1" frame_id="-1" name=""
		   text="彼女の身体には既に常軌を逸した量の精液が絡みついている。" voices=""/>
		<msg @l="85" char_id="-1" frame_id="-1" name="" text="全て‥‥稲庭のモノからまき散らされたもの。"
		   voices=""/>
		<msg @l="87" char_id="-1" frame_id="-1" name="稲庭"
		   text="『ああ、ああああっ‥‥‥ぼくのマ○コ‥‥‥ぼく、ぼくの、ふははっ！』" voices=""/>
		<msg @l="89" char_id="-1" frame_id="-1" name=""
		   text="激しく男根を突き上げるたび、稲庭の口からは意味不明な言葉が漏れる。" voices=""/>
		<msg @l="90" char_id="-1" frame_id="-1" name="" text="目は血走り‥‥焦点があっていない。"
		   voices=""/>
		<msg @l="91" char_id="-1" frame_id="-1" name="" text="恐らく「何か」を違えてしまったのだろう。"
		   voices=""/>
		<msg @l="93" char_id="0" frame_id="-1" name="美帆"
		   text="『あっ、あっ、あっ‥‥‥い、ああっ‥‥‥ん、んんんっ！』" voices="miho12180"/>
		<msg @l="95" char_id="0" frame_id="-1" name="美帆"
		   text="『ふぁぁっ‥‥‥あぅ、んっ、んっ‥‥‥‥ん‥‥そこ、そこぉっ！』" voices="miho12190"/>
		<msg @l="97" char_id="-1" frame_id="-1" name=""
		   text="肉杭の先端が子宮口を突き上げると、びくびくと腰を震わせながら美帆が蕩けたような声をあげる。" voices=""/>
		<msg @l="98" char_id="-1" frame_id="-1" name=""
		   text="そうしてその声に反応するように稲庭は更に腰を叩きつけ、美帆の敏感な所を突き上げ、擦りあげていく。" voices=""/>
		<msg @l="100" char_id="0" frame_id="-1" name="美帆"
		   text="『いい、いいのっ‥‥‥突いて、もっと奥まで突き上げてっ！！』" voices="miho12200"/>
		<msg @l="102" char_id="-1" frame_id="-1" name="稲庭"
		   text="『ふ、あははっ‥‥‥いいよ、いい、いいマ○コ、ひひひ、ふはははっ！！』" voices=""/>
		<msg @l="104" char_id="0" frame_id="-1" name="美帆"
		   text="『んああっ‥‥あっ、ダメっ‥‥‥‥くる、来るッ‥‥‥ああっ！』" voices="miho12210"/>
		<msg @l="106" char_id="-1" frame_id="-1" name="稲庭"
		   text="『あ、あははっ‥‥あはっ‥‥マ○コマ○コ‥‥はっ、はっ、はっ、ふはっ！』" voices=""/>
		<msg @l="108" char_id="-1" frame_id="-1" name=""
		   text="まるで美帆の限界にあわせるかの如く、がくがくと稲庭が狂ったように腰を突き上げる。" voices=""/>
		<msg @l="109" char_id="-1" frame_id="-1" name=""
		   text="しかし‥‥その瞳は決して美帆を見てはいない。" voices=""/>
		<msg @l="111" char_id="0" frame_id="-1" name="美帆"
		   text="『いく、いくいくいくっ‥‥‥‥‥あっ‥‥んんんんんっ！！！』" voices="miho12220"/>
		<msg @l="113" char_id="-1" frame_id="-1" name="稲庭" text="『ふぉっ！く、ああああああっ！！』"
		   voices=""/>
		<flash @l="117" count="4" fade="100" image="white"/>
		<msg @l="119" char_id="-1" frame_id="-1" name=""
		   text="射精にあわせて、美帆の身体が激しく波打つ。" voices=""/>
		<msg @l="120" char_id="-1" frame_id="-1" name=""
		   text="稲庭はそれに構わず腰を深く突き入れると、尚も射精を続けた。" voices=""/>
		<msg @l="122" char_id="0" frame_id="-1" name="美帆" text="『んうっ！！』"
		   voices="miho12230"/>
		<wait_chgmv/>
		<ev @l="126" src="ev-035z1"/>
		<msg @l="128" char_id="-1" frame_id="-1" name=""
		   text="美帆の身体が大きく揺れて、膣内から熱棒が引き抜かれる。" voices=""/>
		<msg @l="129" char_id="-1" frame_id="-1" name=""
		   text="それでもまだ稲庭のモノは射精を続け‥‥美帆の身体を更に白くドロドロに汚していく。" voices=""/>
		<msg @l="131" char_id="0" frame_id="-1" name="美帆" text="『あ、ああ‥‥。』"
		   voices="miho12240"/>
		<msg @l="133" char_id="-1" frame_id="-1" name="" text="絶頂の余韻に美帆が身体を震わせる。"
		   voices=""/>
		<msg @l="134" char_id="-1" frame_id="-1" name=""
		   text="こぽこぽ、という音を立てて膣内から精液が溢れ出して‥‥‥床へ零れ落ちた。" voices=""/>
		<msg @l="135" char_id="-1" frame_id="-1" name=""
		   text="部屋の暗闇からそんな二人の姿を見つめている赤い目があった。" voices=""/>
		<msg @l="136" char_id="-1" frame_id="-1" name="" text="熊野である‥‥。" voices=""/>
		<msg @l="138" char_id="-1" frame_id="-1" name="熊野" text="『ククククク、いいデータが取れた。』"
		   voices=""/>
		<msg @l="140" char_id="-1" frame_id="-1" name="熊野"
		   text="『おかげで勃起薬の方はすぐにでも実用化できそうだが、こいつらには‥‥もう少し頑張ってもらわないとな。』" voices=""/>
		<msg @l="142" char_id="-1" frame_id="-1" name="" text="そう言うと熊野は闇に溶け込んで消えた。"
		   voices=""/>
		<clear @l="148" class="all"/>
		<msg @l="150" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』"
		   voices="miho12250"/>
		<msg @l="152" char_id="-1" frame_id="-1" name="稲庭" text="『‥‥‥‥ふひっ、ひひひっ。』"
		   voices=""/>
		<msg @l="154" char_id="0" frame_id="-1" name="美帆" text="『あ、んんっ‥‥。』"
		   voices="miho12260"/>
		<msg @l="156" char_id="-1" frame_id="-1" name="稲庭" text="『ふぉっ‥‥。』" voices=""/>
		<msg @l="158" char_id="-1" frame_id="-1" name=""
		   text="そうして‥‥充分な休息の時間もないまま、どちらからともなく再び身体を絡めて快楽を貪り始める。" voices=""/>
		<msg @l="159" char_id="-1" frame_id="-1" name=""
		   text="まるで、それが唯一の存在証明のごとく‥‥。" voices=""/>
		<stopbgm @l="163" fadeout="1000"/>
		<clear @l="169" class="all"/>
		<end_scene @l="172"/>
		<eval @l="176" expr="s.flagGallery=1&#13;&#10;"/>
		<eval @l="178" expr="s.event35flag=1&#13;&#10;"/>
		<eval @l="183"
		   expr="f.bEx&#32;=&#32;s.event20flag&#32;&amp;&amp;&#32;s.event23flag&#32;&amp;&amp;&#32;s.event25flag&#32;&amp;&amp;&#32;s.event30flag&#32;&amp;&amp;&#32;s.event31flag&#32;&amp;&amp;&#32;s.event32flag&#32;&amp;&amp;&#32;s.event33flag&#32;&amp;&amp;&#32;s.event35flag&#32;&amp;&amp;&#32;s.event37flag&#32;&amp;&amp;&#32;s.event38flag&#32;&amp;&amp;&#32;s.event60flag&#13;&#10;"/>
		<goto @l="185" cond="!(f.bEx)&#13;&#10;" label="TempLabel_301"/>
		<eval @l="187" expr="s.exRootFlag=1&#13;&#10;"/>
		<label @l="188" id="TempLabel_301"/>
		<ending @l="190"/>
		<goto @l="192" cond="!(f.bEx)&#13;&#10;" label="TempLabel_302"/>
		<wait_chgmv/>
		<bg @l="196" src="newroot"/>
		<wait @l="198" time="5000"/>
		<wait_chgmv/>
		<bg @l="200" src="black"/>
		<label @l="203" id="TempLabel_302"/>
		<return @l="207" value=""/>
	</code>
</xscript>
