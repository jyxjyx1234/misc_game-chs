<?xml version="1.0" encoding="utf-8"?>
<xscript>
	<debug editor="&quot;C:\Program&#32;Files&#32;(x86)\sakura\sakura.exe&quot;&#32;&quot;%src%&quot;&#32;-Y=%line%"
	   src="D:\シロップ\町ぐるみの罠＋汚された夏セット版\汚された夏\完成データ\汚された夏\script\text\common_root03.txt"/>
	<code>
		<label @l="17" id="EventLabel_27"/>
		<description @l="21" text="憂鬱な日常"/>
		<eval @l="23" expr="f.numDay=3&#13;&#10;"/>
		<msgshow @l="25" show="false"/>
		<wait_chgmv/>
		<bg @l="27" src="day03" time="2000"/>
		<wait @l="29" time="500"/>
		<wait_chgmv/>
		<bg @l="31" src="black" time="2000"/>
		<msgshow @l="33" show="true"/>
		<wait_chgmv/>
		<bg @l="38" src="bg18m1"/>
		<bgm @l="42" src="bgm02" volume="1."/>
		<char @l="46" id="rei" pos="left" src="rei015"/>
		<char @l="50" id="miho" pos="right" src="miho010"/>
		<msg @l="52" char_id="1" frame_id="-1" name="玲" text="『朝早くって‥‥苦手なのよね。』"
		   voices=""/>
		<msg @l="54" char_id="-1" frame_id="-1" name=""
		   text="駅前ロータリーにたどり着いた辺りで、先輩がボソリと漏らす。" voices=""/>
		<msg @l="55" char_id="-1" frame_id="-1" name=""
		   text="お昼までに戻って来たいという白石先輩の意向で、私たちは路線電車の始発に合わせて家を出た。" voices=""/>
		<msg @l="56" char_id="-1" frame_id="-1" name=""
		   text="Ｊ○の始発電車よりは随分遅いとはいえ、一限目の講義を取っていない学生たちには十分『早朝』の電車と言えるかもしれない。"
		   voices=""/>
		<msg @l="58" char_id="0" frame_id="-1" name="美帆"
		   text="『だから先輩、一限の講義はあんまり取ってないんですね。』" voices=""/>
		<char @l="62" id="rei" pos="left" src="rei010"/>
		<msg @l="64" char_id="1" frame_id="-1" name="玲" text="『そういうこと。』" voices=""/>
		<msg @l="66" char_id="1" frame_id="-1" name="玲"
		   text="『必修科目は三年のうちにほとんど取っちゃったからっていうのもあるけどね。』" voices=""/>
		<char @l="70" id="miho" pos="right" src="miho014"/>
		<msg @l="72" char_id="0" frame_id="-1" name="美帆"
		   text="『え‥‥三年のうちにって、そんな事したら朝から夜まで講義で埋まっちゃうんじゃ‥‥？』" voices=""/>
		<msg @l="74" char_id="-1" frame_id="-1" name=""
		   text="三年のうちに必修の単位を取っておけば確かに四年生で楽になるが、そんな事をしたら毎日が大学と家の往復だけで終わってしまう。"
		   voices=""/>
		<msg @l="76" char_id="1" frame_id="-1" name="玲"
		   text="『そうね‥‥まあ、週に五日くらいはそういう日もあったかしら？』" voices=""/>
		<char @l="80" id="miho" pos="right" src="miho016"/>
		<msg @l="82" char_id="0" frame_id="-1" name="美帆" text="『それ、毎日って言うんですよ‥‥。』"
		   voices=""/>
		<char @l="86" id="rei" pos="left" src="rei011"/>
		<msg @l="88" char_id="1" frame_id="-1" name="玲" text="『そうとも言うわね。』" voices=""/>
		<msg @l="90" char_id="-1" frame_id="-1" name="" text="白石先輩はそう言って爽やかに笑う。"
		   voices=""/>
		<msg @l="91" char_id="-1" frame_id="-1" name=""
		   text="その表情からは一片の苦労も感じさせないのだから凄い。" voices=""/>
		<msg @l="93" char_id="1" frame_id="-1" name="玲" text="『あ‥‥電車、もう来てるみたいよ？』"
		   voices=""/>
		<clear @l="97" layer="rei"/>
		<char @l="101" id="miho" pos="right" src="miho014"/>
		<msg @l="103" char_id="0" frame_id="-1" name="美帆" text="『あ、先輩っ‥‥。』"
		   voices=""/>
		<char @l="107" id="miho" pos="right" src="miho010"/>
		<msg @l="109" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="111" char_id="0" frame_id="-1" name="美帆" text="(今日は痴漢に遭わないと良いな‥‥)"
		   voices=""/>
		<stopbgm @l="114" fadeout="1000"/>
		<clear @l="120" class="all"/>
		<label @l="123" id="event_scene05_3"/>
		<bgm @l="126" src="bgm07" volume="1."/>
		<msg @l="128" char_id="-1" frame_id="-1" name="アナウンス"
		   text="『えー、大変混み合っております‥‥。』" voices=""/>
		<msg @l="130" char_id="-1" frame_id="-1" name="アナウンス"
		   text="『途中で立ち止まらず車内中ほどまでお進みください。』" voices=""/>
		<msg @l="132" char_id="-1" frame_id="-1" name=""
		   text="停留所に出来た列の最後尾に並んで待つこと五分弱。" voices=""/>
		<msg @l="133" char_id="-1" frame_id="-1" name=""
		   text="私と先輩は人の流れに従うように車内へと飲み込まれていく。" voices=""/>
		<msg @l="135" char_id="0" frame_id="-1" name="美帆" text="『結構混んでますね‥‥。』"
		   voices="miho01100"/>
		<msg @l="137" char_id="1" frame_id="-1" name="玲" text="『そうね‥‥。』"
		   voices="rei00090"/>
		<msg @l="139" char_id="1" frame_id="-1" name="玲"
		   text="『この場所じゃ、大学まで座ってゆっくりとっていうのは絶望的かしら。』" voices="rei00100"/>
		<msg @l="141" char_id="-1" frame_id="-1" name=""
		   text="そう言って先輩が苦笑してみせ、私もまたそれにならうように苦笑をする。" voices=""/>
		<msg @l="142" char_id="-1" frame_id="-1" name=""
		   text="始発にも関わらず車内は妙に混雑しており、座るどころか自分の立ち位置を確保するのもひと苦労だ。" voices=""/>
		<msg @l="144" char_id="1" frame_id="-1" name="玲" text="『そっち‥‥壁際、空いてるわよ。』"
		   voices="rei00110"/>
		<msg @l="146" char_id="0" frame_id="-1" name="美帆" text="『あ、はい‥‥。』"
		   voices="miho01110"/>
		<msg @l="148" char_id="-1" frame_id="-1" name=""
		   text="私は先輩に言われるまま、壁際に出来ていた空間に身体を滑り込ませる。" voices=""/>
		<msg @l="149" char_id="-1" frame_id="-1" name=""
		   text="そうして先輩が隣へくるのをしばらく待っていたが、幾ら待ってみてもその気配は一向に訪れない。" voices=""/>
		<msg @l="150" char_id="-1" frame_id="-1" name=""
		   text="それどころか、私の隣には見ず知らずの男の人が割り込んでくる。" voices=""/>
		<msg @l="152" char_id="0" frame_id="-1" name="美帆" text="『先輩‥‥？』"
		   voices="miho01120"/>
		<msg @l="154" char_id="-1" frame_id="-1" name=""
		   text="人垣の隙間から見失った先輩の姿を探していると、少し離れた場所に押し込まれてしまった彼女と目が合う。" voices=""/>
		<msg @l="156" char_id="1" frame_id="-1" name="玲" text="『ごめーん‥‥ちょっと離れちゃった。』"
		   voices="rei00120"/>
		<msg @l="158" char_id="-1" frame_id="-1" name=""
		   text="先輩は済まなそうな表情を浮かべ、肩の辺りでひらひらと手を振る。" voices=""/>
		<msg @l="159" char_id="-1" frame_id="-1" name=""
		   text="一度こうなってしまったら、合流するのはちょっと難しい。" voices=""/>
		<eval @l="162" expr="s.event5flag=2&#13;&#10;"/>
		<wait_chgmv/>
		<ev @l="166" src="ev-005"/>
		<se @l="170" buf="3" loop="true" src="電車走行中" volume="1."/>
		<msg @l="172" char_id="0" frame_id="-1" name="美帆"
		   text="(はぁ‥‥結局こうなっちゃうのか‥‥‥)" voices="miho01130"/>
		<msg @l="174" char_id="-1" frame_id="-1" name=""
		   text="私は壁際の空間で手すりにしがみつきながら、短くため息をつく。" voices=""/>
		<msg @l="175" char_id="-1" frame_id="-1" name="" text="結局‥‥また、一人になってしまった。"
		   voices=""/>
		<msg @l="177" char_id="0" frame_id="-1" name="美帆"
		   text="(でも、同じ電車に先輩が乗ってるってだけで全然違うかな)" voices="miho01140"/>
		<msg @l="179" char_id="0" frame_id="-1" name="美帆" text="(精神的にも楽だし‥‥それに)"
		   voices="miho01150"/>
		<msg @l="181" char_id="-1" frame_id="-1" name=""
		   text="それに‥‥何かあった場合、先輩に助けを求める事もできる。" voices=""/>
		<msg @l="183" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』"
		   voices="miho01160"/>
		<msg @l="185" char_id="0" frame_id="-1" name="美帆" text="(何でそんな風に考えちゃうかな‥‥私)"
		   voices="miho01170"/>
		<msg @l="187" char_id="0" frame_id="-1" name="美帆" text="(最初から何も無い方が良いのに)"
		   voices="miho01180"/>
		<msg @l="189" char_id="-1" frame_id="-1" name=""
		   text="普段はここまでネガティブ思考ではないのだけれど。" voices=""/>
		<msg @l="190" char_id="-1" frame_id="-1" name=""
		   text="思考が後ろ向きになってしまうのはここ二日間痴漢に遭っていることが尾を引いているせいなのだろう。" voices=""/>
		<msg @l="191" char_id="-1" frame_id="-1" name=""
		   text="もしかすると今日も、と余計な恐怖を感じてしまう。" voices=""/>
		<goto @l="194" cond="!(f.痴漢flag&#32;==&#32;2)&#13;&#10;"
		   label="TempLabel_162"/>
		<msg @l="197" char_id="0" frame_id="-1" name="美帆"
		   text="(あの痴漢は私を狙ってる‥‥‥んだよね)" voices="miho01190"/>
		<msg @l="199" char_id="0" frame_id="-1" name="美帆"
		   text="(だとしたら、今日も狙われてるかもしれない‥‥‥)" voices="miho01200"/>
		<msg @l="201" char_id="0" frame_id="-1" name="美帆" text="(今日も‥‥)"
		   voices="miho01210"/>
		<goto @l="204" label="TempLabel_163"/>
		<label @l="205" id="TempLabel_162"/>
		<goto @l="206" cond="!(f.名前を知られてるflag&#32;==&#32;1)&#13;&#10;"
		   label="TempLabel_164"/>
		<msg @l="210" char_id="0" frame_id="-1" name="美帆" text="(あの痴漢は私の名前を知ってた‥‥)"
		   voices="miho01220"/>
		<msg @l="212" char_id="0" frame_id="-1" name="美帆"
		   text="(それってつまり、初めから私を狙って痴漢した‥‥‥？)" voices="miho01230"/>
		<msg @l="214" char_id="0" frame_id="-1" name="美帆" text="(でも‥‥‥そんな事って‥‥‥‥‥)"
		   voices="miho01240"/>
		<goto @l="218" label="TempLabel_163"/>
		<label @l="219" id="TempLabel_164"/>
		<goto @l="220"
		   cond="!((f.痴漢flag&#32;==&#32;1)&#32;&amp;&#32;(f.名前を知られてるflag&#32;==&#32;0))&#13;&#10;"
		   label="TempLabel_165"/>
		<msg @l="224" char_id="0" frame_id="-1" name="美帆" text="(そういえば‥‥)"
		   voices="miho01250"/>
		<msg @l="226" char_id="0" frame_id="-1" name="美帆"
		   text="(この前の痴漢‥‥‥続きがどうとか言ってた‥‥‥‥)" voices="miho01260"/>
		<msg @l="228" char_id="0" frame_id="-1" name="美帆"
		   text="(あ‥‥‥‥‥もしかすると、昨日の痴漢も？)" voices="miho01270"/>
		<goto @l="231" label="TempLabel_163"/>
		<label @l="232" id="TempLabel_165"/>
		<goto @l="233" cond="!(f.痴漢flag&#32;==&#32;0)&#13;&#10;"
		   label="TempLabel_166"/>
		<msg @l="237" char_id="0" frame_id="-1" name="美帆"
		   text="(幾らなんでもそんなに偶然は続かないハズだよ‥‥)" voices="miho01280"/>
		<msg @l="239" char_id="0" frame_id="-1" name="美帆"
		   text="(私ばっかりなんて‥‥‥そんなこと‥‥‥‥‥)" voices="miho01290"/>
		<msg @l="241" char_id="0" frame_id="-1" name="美帆" text="(あるハズ無い‥‥‥‥よね‥‥‥)"
		   voices="miho01300"/>
		<label @l="244" id="TempLabel_166"/>
		<label @l="245" id="TempLabel_163"/>
		<msg @l="248" char_id="-1" frame_id="-1" name=""
		   text="気付けば、私はおどおどした視線で周囲の人間を見渡していた。" voices=""/>
		<msg @l="249" char_id="-1" frame_id="-1" name=""
		   text="視界に映る誰しもが痴漢のように思えてくる。" voices=""/>
		<msg @l="250" char_id="-1" frame_id="-1" name=""
		   text="とはいえ、周りから見ればそうして落ち着き無い私の方がよほど不審に映っているのかもしれない。" voices=""/>
		<clear @l="256" class="all"/>
		<msg @l="259" char_id="0" frame_id="-1" name="美帆" text="(少し落ち着こう‥‥)"
		   voices="miho01310"/>
		<msg @l="261" char_id="0" frame_id="-1" name="美帆"
		   text="(先輩も居るんだし、大丈夫‥‥‥‥‥‥だと思わなきゃ)" voices="miho01320"/>
		<msg @l="263" char_id="-1" frame_id="-1" name=""
		   text="私は自分の肩越しに、人ごみの中へ紛れてしまった先輩の姿を探す。" voices=""/>
		<msg @l="264" char_id="-1" frame_id="-1" name=""
		   text="探す、といっても半身を捻るのでさえ困難なのである。" voices=""/>
		<msg @l="265" char_id="-1" frame_id="-1" name=""
		   text="せいぜい乗客の隙間から先輩の居た辺りを覗き込むのが精一杯だ。" voices=""/>
		<msg @l="267" char_id="0" frame_id="-1" name="美帆" text="(先輩‥‥何処に居るのかな‥‥‥‥？)"
		   voices="miho01330"/>
		<msg @l="269" char_id="-1" frame_id="-1" name=""
		   text="先ほど先輩の姿があった辺りに視線を送ってみるが、人垣には切れ目どころかわずかな隙間さえなく、結局‥‥先輩の姿を見つけることは出来なかった。"
		   voices=""/>
		<wait_chgmv/>
		<ev @l="273" src="ev-005"/>
		<msg @l="275" char_id="0" frame_id="-1" name="美帆"
		   text="(やっぱり、乗る時に離れ離れになったのがマズかったなぁ)" voices="miho01340"/>
		<msg @l="277" char_id="0" frame_id="-1" name="美帆"
		   text="(こんな事なら最初からもっとちゃんと‥‥‥‥‥って、あれ？)" voices="miho01350"/>
		<stopbgm @l="281" fadeout="1000"/>
		<msg @l="283" char_id="-1" frame_id="-1" name="" text="ふと、お尻の辺りに違和感を覚える。"
		   voices=""/>
		<msg @l="284" char_id="-1" frame_id="-1" name=""
		   text="スカート越しにもぞもぞと蠢くそれは――――――痴漢の手だった！" voices=""/>
		<bgm @l="288" src="bgm15" volume="1."/>
		<wait_chgmv/>
		<ev @l="292" src="ev-005ax1"/>
		<description @l="295" text="痴漢は三度訪れる"/>
		<msg @l="297" char_id="0" frame_id="-1" name="美帆" text="(ひッ――――――――！？)"
		   voices="miho01360"/>
		<msg @l="299" char_id="-1" frame_id="-1" name="" text="やっぱり狙われた‥‥そう、思った。"
		   voices=""/>
		<msg @l="301" char_id="0" frame_id="-1" name="美帆"
		   text="(と、とにかく落ち着いて‥‥先輩に助けを‥‥‥‥)" voices="miho01370"/>
		<msg @l="303" char_id="-1" frame_id="-1" name="" text="そう思って振り向こうとした。"
		   voices=""/>
		<msg @l="304" char_id="-1" frame_id="-1" name=""
		   text="けれど、振り向こうとした私の肩を痴漢の手が強くつかむ。" voices=""/>
		<msg @l="305" char_id="-1" frame_id="-1" name=""
		   text="痛い、と思ったが恐怖で声が出ず、私は肩をつかんでいる手を見るのが精一杯だった。" voices=""/>
		<msg @l="306" char_id="-1" frame_id="-1" name=""
		   text="その手は、私の華奢な肩の感触を楽しむように、ぐにぐにと指をうごめかせている。" voices=""/>
		<msg @l="308" char_id="-1" frame_id="-1" name="痴漢" text="『また会えたな、仲根美帆クン。』"
		   voices=""/>
		<goto @l="312"
		   cond="!((f.名前を知られてるflag&#32;==&#32;0)&#32;&amp;&#32;(f.痴漢flag&#32;==&#32;0))&#13;&#10;"
		   label="TempLabel_167"/>
		<msg @l="314" char_id="0" frame_id="-1" name="美帆"
		   text="『え‥‥どうして私の名前、知ってるんですかっ。』" voices="miho01380"/>
		<msg @l="316" char_id="-1" frame_id="-1" name="痴漢"
		   text="『まさかキミは、３日も連続で痴漢をされていて偶然だとでも思っていたのかね？』" voices=""/>
		<msg @l="318" char_id="0" frame_id="-1" name="美帆"
		   text="『そんなっ‥‥それじゃあ昨日も一昨日もアナタが‥‥‥‥‥！？』" voices="miho01390"/>
		<msg @l="320" char_id="-1" frame_id="-1" name="痴漢"
		   text="『くく‥‥当たり前だろう。今頃気付いたのかい。』" voices=""/>
		<msg @l="322" char_id="-1" frame_id="-1" name="痴漢"
		   text="『それとも別々の３人の男に、かわるがわる痴漢をされたかったのかな。』" voices=""/>
		<msg @l="324" char_id="-1" frame_id="-1" name="痴漢"
		   text="『なんなら、隣の乗客に声をかけてやろうか？だが私が楽しませてもらった後で良ければな‥‥。』" voices=""/>
		<msg @l="326" char_id="0" frame_id="-1" name="美帆"
		   text="『どうしてこんな事‥‥どうして、私なんかを‥‥‥‥。』" voices="miho01400"/>
		<msg @l="328" char_id="-1" frame_id="-1" name="痴漢" text="『さて、どうしてだろうねえ。』"
		   voices=""/>
		<goto @l="332" label="TempLabel_168"/>
		<label @l="333" id="TempLabel_167"/>
		<goto @l="334"
		   cond="!((f.名前を知られてるflag&#32;==&#32;0)&#32;&amp;&#32;(f.痴漢flag&#32;&gt;=&#32;1))&#13;&#10;"
		   label="TempLabel_169"/>
		<msg @l="337" char_id="0" frame_id="-1" name="美帆"
		   text="『なっ‥‥‥どうして私の名前をアナタが‥‥‥‥‥‥。』" voices="miho01410"/>
		<msg @l="339" char_id="-1" frame_id="-1" name="痴漢"
		   text="『くく‥‥キミは、私が名前も知らない相手に３日も連続で痴漢をしていたとでも思っていたのかね？』" voices=""/>
		<msg @l="341" char_id="-1" frame_id="-1" name="痴漢"
		   text="『今は名前しか知らないが、こうやって毎日電車の中で君の身体をまさぐっていれば、君の全て‥‥そう、隅々まで分かるようになる。』"
		   voices=""/>
		<msg @l="343" char_id="0" frame_id="-1" name="美帆" text="『ご、誤魔化さないでくださいっ。』"
		   voices="miho01420"/>
		<msg @l="345" char_id="-1" frame_id="-1" name=""
		   text="私は小声で、それでも出来る限り怒ったように言う。" voices=""/>
		<msg @l="346" char_id="-1" frame_id="-1" name=""
		   text="とはいえ私の声は余りにも迫力に欠けていた。" voices=""/>
		<msg @l="348" char_id="-1" frame_id="-1" name="痴漢"
		   text="『おやおや、温厚な娘ほど怒らせると怖いというのは本当だな。』" voices=""/>
		<msg @l="350" char_id="-1" frame_id="-1" name="痴漢"
		   text="『しかしキミが案ずるべきは私がいかにしてキミの名を知ったのかではなく、この状況からいかにして脱するか、ではないのかね？』"
		   voices=""/>
		<msg @l="352" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』"
		   voices="miho01430"/>
		<goto @l="355" label="TempLabel_168"/>
		<label @l="356" id="TempLabel_169"/>
		<goto @l="357" cond="!(f.名前を知られてるflag&#32;==&#32;1)&#13;&#10;"
		   label="TempLabel_170"/>
		<msg @l="360" char_id="0" frame_id="-1" name="美帆"
		   text="『アナタはっ‥‥‥‥‥また‥‥ですか‥‥‥‥。』" voices="miho01440"/>
		<msg @l="362" char_id="-1" frame_id="-1" name="痴漢"
		   text="『いいな、その怒った時の表情が良い。』" voices=""/>
		<msg @l="364" char_id="-1" frame_id="-1" name="痴漢"
		   text="『それに‥‥昨日の様子では嫌がっていないようにも見えたがね？』" voices=""/>
		<msg @l="366" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』"
		   voices="miho01450"/>
		<msg @l="368" char_id="-1" frame_id="-1" name="痴漢"
		   text="『くく、まあいい。そうして上の口をつぐんだところで下の口から本心を聞き出すだけの事なのだがね。』" voices=""/>
		<msg @l="370" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥‥っ‥‥‥。』"
		   voices="miho01460"/>
		<msg @l="372" char_id="-1" frame_id="-1" name="痴漢" text="『さて‥‥今日こそ逃がさないよ。』"
		   voices=""/>
		<label @l="375" id="TempLabel_170"/>
		<label @l="376" id="TempLabel_168"/>
		<goto @l="380" cond="!(f.痴漢flag&#32;&lt;=&#32;1)&#13;&#10;"
		   label="TempLabel_171"/>
		<msg @l="382" char_id="-1" frame_id="-1" name="" text="するっ。" voices=""/>
		<wait_chgmv/>
		<ev @l="386" src="ev-005ax3y2"/>
		<msg @l="388" char_id="-1" frame_id="-1" name=""
		   text="痴漢の手がゆっくりとスカートを少したくしあげ、中へと侵入してくる。" voices=""/>
		<msg @l="389" char_id="-1" frame_id="-1" name="" text="さわ、さわ。" voices=""/>
		<msg @l="391" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥っ‥‥‥。』"
		   voices="miho09930"/>
		<msg @l="393" char_id="-1" frame_id="-1" name=""
		   text="ざらざらとした手の感触が、白い太股を撫で上げるたびに気持ち悪くなり腰を引いてしまう。" voices=""/>
		<msg @l="394" char_id="-1" frame_id="-1" name=""
		   text="すると腰を引いたことによってお尻を痴漢に向けて突き出してしまうことになり、痴漢は私のお尻を鷲づかみにしてきた。" voices=""/>
		<msg @l="396" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥ぅぁ‥‥。』"
		   voices="miho00430"/>
		<msg @l="398" char_id="-1" frame_id="-1" name=""
		   text="もう一方の手では私を逃さないようにと、桃のようななめらかな腰をつかむ。" voices=""/>
		<msg @l="399" char_id="-1" frame_id="-1" name=""
		   text="そうして逃げられなくなったところで、下着の上から痴漢の手がアソコに触れてきた。" voices=""/>
		<msg @l="401" char_id="0" frame_id="-1" name="美帆" text="『いや、やめてください‥‥。』"
		   voices="miho01470"/>
		<msg @l="403" char_id="-1" frame_id="-1" name=""
		   text="私は身をよじり、痴漢の手から逃れようとする。" voices=""/>
		<msg @l="405" char_id="-1" frame_id="-1" name="痴漢"
		   text="『おや、そんな風に抵抗しても良いのかな？』" voices=""/>
		<msg @l="407" char_id="-1" frame_id="-1" name="痴漢"
		   text="『騒ぎを大きくして困るのはキミの方ではないのかね？』" voices=""/>
		<msg @l="409" char_id="0" frame_id="-1" name="美帆" text="『そ、それは‥‥。』"
		   voices="miho01480"/>
		<msg @l="411" char_id="-1" frame_id="-1" name="痴漢"
		   text="『くく‥‥乗客に痴漢されている所を目撃され、妙な噂をたてられたくなければ黙って居る事だ。』" voices=""/>
		<msg @l="413" char_id="-1" frame_id="-1" name=""
		   text="痴漢はそう言って、下着の上から秘部の中へ指を入れようと花のふくらみを思わす柔肉を広げ、空いている指で掻き分けるようにいじってくる。"
		   voices=""/>
		<msg @l="415" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』"
		   voices="miho09880"/>
		<msg @l="417" char_id="-1" frame_id="-1" name=""
		   text="そして、閉じ合わさった肉びらの中に籠もっている薄っすらとした蜜をパンティに染み込ませた。" voices=""/>
		<msg @l="419" char_id="-1" frame_id="-1" name="痴漢"
		   text="『ここが車輌内でなければ、キミの馥郁（ふくいく）な香りを愉しむところだが‥‥。』" voices=""/>
		<msg @l="421" char_id="-1" frame_id="-1" name=""
		   text="痴漢は胸いっぱいにその場の空気を吸い込んだ。" voices=""/>
		<msg @l="422" char_id="-1" frame_id="-1" name=""
		   text="この中に漂う微量な聖蜜の香りを嗅ぎ取ろうとする。" voices=""/>
		<msg @l="423" char_id="-1" frame_id="-1" name=""
		   text="何とか進入を拒もうと脚をぎゅっと閉じようとするが、痴漢は片足を私の足の間に強引に入れてきて私は股を開かされてしまう。"
		   voices=""/>
		<msg @l="424" char_id="-1" frame_id="-1" name=""
		   text="私の脚は恥じらいと恐怖が重なり、ガクガクと震え上がる。" voices=""/>
		<msg @l="426" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥っ‥‥。』"
		   voices="miho01490"/>
		<msg @l="428" char_id="-1" frame_id="-1" name="痴漢"
		   text="『そうだ、いいぞ‥‥‥そうして黙っていれば良い。』" voices=""/>
		<msg @l="430" char_id="-1" frame_id="-1" name=""
		   text="怯えた脚をこじ開けていく快感に酔いしれ、語りかける。" voices=""/>
		<msg @l="432" char_id="-1" frame_id="-1" name="痴漢"
		   text="『キミの此処が、すぐにぐちょぐちょになって、気持ち良くなる。』" voices=""/>
		<msg @l="434" char_id="-1" frame_id="-1" name=""
		   text="痴漢はそう言うと身体を密着させて来ながら、無抵抗に開けられた股間へ無遠慮に手を差し入れてくる。" voices=""/>
		<msg @l="435" char_id="-1" frame_id="-1" name=""
		   text="そして下着越しに指先を花唇へと押し込んできた。" voices=""/>
		<msg @l="437" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥ゃぁ‥‥。』"
		   voices="miho00740"/>
		<msg @l="439" char_id="-1" frame_id="-1" name=""
		   text="あまりの気持ち悪さに、私は目に涙を浮かべ必死に耐える。" voices=""/>
		<msg @l="440" char_id="-1" frame_id="-1" name=""
		   text="だが、耐えれば耐えるほど秘部を嬲る生々しい指先の感触が、布一枚を通してはっきりと伝わってきてしまう。" voices=""/>
		<msg @l="441" char_id="-1" frame_id="-1" name="" text="ぐいっ。" voices=""/>
		<msg @l="443" char_id="0" frame_id="-1" name="美帆" text="『ひっ！』"
		   voices="miho00750"/>
		<msg @l="445" char_id="-1" frame_id="-1" name=""
		   text="痴漢は指で私のパンティを引っ張って持ち上げ、指を入れるスペースを作る。" voices=""/>
		<msg @l="446" char_id="-1" frame_id="-1" name=""
		   text="これでスカートがなければ、周囲にピンク色の進入路が露になるところだ。" voices=""/>
		<msg @l="448" char_id="-1" frame_id="-1" name="痴漢"
		   text="『フフフ、今日はじかにじっくりと堪能させてもらうよ。』" voices=""/>
		<msg @l="450" char_id="-1" frame_id="-1" name=""
		   text="私が驚いている内に、痴漢はすばやく指をパンティの中に進入させ、じかにサーモンピンクの陰唇を触ってきた。" voices=""/>
		<msg @l="451" char_id="-1" frame_id="-1" name="" text="くにゅっ。" voices=""/>
		<msg @l="453" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥っ‥‥‥。』"
		   voices="miho09930"/>
		<msg @l="455" char_id="-1" frame_id="-1" name=""
		   text="初めて秘部を触られる感触‥‥それが、誰とも分からない痴漢で、しかも公共の電車内だなんて‥‥。" voices=""/>
		<msg @l="456" char_id="-1" frame_id="-1" name="" text="私は、凄く悲しくなった‥‥。"
		   voices=""/>
		<msg @l="457" char_id="-1" frame_id="-1" name="" text="くにゅっ、むにゅっ。" voices=""/>
		<msg @l="459" char_id="0" frame_id="-1" name="美帆" text="『やだ‥‥そこは‥‥‥。』"
		   voices="miho00410"/>
		<msg @l="461" char_id="-1" frame_id="-1" name=""
		   text="そんな私の気持ちを踏みにじるように、痴漢の指は欲望の赴くまま、秘烈の割れ目に沿ってこすり上げていく。" voices=""/>
		<msg @l="462" char_id="-1" frame_id="-1" name="" text="執拗に秘部を嬲る痴漢の指。"
		   voices=""/>
		<msg @l="463" char_id="-1" frame_id="-1" name=""
		   text="この指がもし、秘穴の中に突き入れられたら‥‥。" voices=""/>
		<msg @l="464" char_id="-1" frame_id="-1" name=""
		   text="そう考えると一瞬にして血の気が失せていく。" voices=""/>
		<msg @l="466" char_id="0" frame_id="-1" name="美帆"
		   text="『ダメ‥‥やっぱり、こんなの耐えられませんっ。』" voices="miho01500"/>
		<msg @l="468" char_id="-1" frame_id="-1" name="痴漢"
		   text="『耐えられないからなんだというのかね？』" voices=""/>
		<msg @l="470" char_id="-1" frame_id="-1" name="痴漢"
		   text="『声をあげるか？&#32;私は痴漢をされていますと？』" voices=""/>
		<msg @l="472" char_id="-1" frame_id="-1" name="痴漢"
		   text="『キミには無理だ。人の目を過剰に意識しすぎるキミにはそんな大胆な抵抗など出来るハズがない。』" voices=""/>
		<msg @l="474" char_id="0" frame_id="-1" name="美帆"
		   text="『そんな‥‥こんな事されるくらいなら、私はっ。』" voices="miho01510"/>
		<msg @l="476" char_id="-1" frame_id="-1" name="痴漢" text="『くく、どうするというのだね？』"
		   voices=""/>
		<clear @l="482" class="all"/>
		<end_scene @l="485"/>
		<eval @l="488" expr="f.localflag&#32;=&#32;0&#13;&#10;"/>
		<goto @l="491" cond="!(f.痴漢flag&#32;==&#32;1)&#13;&#10;"
		   label="TempLabel_172"/>
		<description @l="494" text="断罪の時？"/>
		<stopbgm @l="498" fadeout="1000"/>
		<msg @l="500" char_id="-1" frame_id="-1" name="声"
		   text="『そこまでにしたらどうです、朽木教授。』" voices=""/>
		<msg @l="510" char_id="-1" frame_id="-1" name="朽木" text="『ぐぉっ！？』" voices=""/>
		<msg @l="512" char_id="-1" frame_id="-1" name=""
		   text="人垣の中から声がしたかと思うと、私の背後に居た男が苦悶の声をあげる。" voices=""/>
		<msg @l="513" char_id="-1" frame_id="-1" name=""
		   text="それと同時に下着の上からアソコを弄んでいた手が引き抜かれ、私は慌てて捲りあげられていたスカートの裾を直す。" voices=""/>
		<msg @l="515" char_id="-1" frame_id="-1" name="朽木" text="『離せっ、この手を離さんかっ！！』"
		   voices=""/>
		<msg @l="517" char_id="0" frame_id="-1" name="美帆" text="『朽木‥‥‥教授？』"
		   voices="miho01520"/>
		<msg @l="519" char_id="-1" frame_id="-1" name=""
		   text="恐る恐る振り返った私の背後に居たのは見ず知らずの男などではなく、私が専攻しているゼミの講師をしている朽木陽大教授だった。"
		   voices=""/>
		<msg @l="520" char_id="-1" frame_id="-1" name=""
		   text="朽木教授は、片腕を背中の辺りで捻り上げられている。" voices=""/>
		<msg @l="521" char_id="-1" frame_id="-1" name=""
		   text="そして‥‥その手を捻り上げていたのは誰であろう稲庭先輩だった。" voices=""/>
		<msg @l="523" char_id="-1" frame_id="-1" name="朽木"
		   text="『ち、違うんだ‥‥私は何もしていない。』" voices=""/>
		<msg @l="525" char_id="-1" frame_id="-1" name="朽木"
		   text="『キミならば信じてくれるだろう？&#32;仲根クン。』" voices=""/>
		<msg @l="527" char_id="-1" frame_id="-1" name=""
		   text="そう言って、朽木教授はすがり付くような視線を私に注ぐ。" voices=""/>
		<msg @l="529" char_id="0" frame_id="-1" name="美帆"
		   text="『わ、私‥‥‥‥わかりません‥‥‥‥‥‥。』" voices="miho01530"/>
		<msg @l="531" char_id="-1" frame_id="-1" name=""
		   text="私は‥‥教授の言葉に明確な答えを返す事が出来ないまま、視線を逸らす。" voices=""/>
		<msg @l="532" char_id="-1" frame_id="-1" name=""
		   text="正直なところ、私には何がなんだかわからなくなっていた。" voices=""/>
		<msg @l="533" char_id="-1" frame_id="-1" name=""
		   text="尊敬していた教授が私を狙って痴漢行為を働くなんて‥‥。" voices=""/>
		<msg @l="535" char_id="-1" frame_id="-1" name="稲庭"
		   text="『言い訳は後でたっぷり聞かせてもらいましょうか、教授。』" voices=""/>
		<msg @l="537" char_id="-1" frame_id="-1" name="稲庭"
		   text="『それともこの場で全員に聞こえるように見苦しい弁解を続ける方がよろしいですか？』" voices=""/>
		<msg @l="539" char_id="-1" frame_id="-1" name="朽木" text="『くっ‥‥。』" voices=""/>
		<msg @l="541" char_id="-1" frame_id="-1" name=""
		   text="男の言葉に朽木教授は苦虫を噛み潰したような表情を浮かべる。" voices=""/>
		<msg @l="543" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』"
		   voices="miho01540"/>
		<msg @l="545" char_id="-1" frame_id="-1" name=""
		   text="私はとにかくその事だけが信じられなくて、ただ茫然と二人のやり取りを眺めている事しか出来なかった。" voices=""/>
		<stopse @l="549" buf="3"/>
		<clear @l="555" class="all"/>
		<msgshow @l="557" show="true"/>
		<wait_chgmv/>
		<bg @l="562" src="bg07"/>
		<bgm @l="566" src="bgm03" volume="1."/>
		<msg @l="568" char_id="-1" frame_id="-1" name=""
		   text="大学キャンパス内へとたどり着いた路面電車から、滑りだすように朽木教授が降りて行く。" voices=""/>
		<msg @l="569" char_id="-1" frame_id="-1" name=""
		   text="その後を追うように稲庭先輩が降り、私もそれにならうように降りた。" voices=""/>
		<msg @l="570" char_id="-1" frame_id="-1" name=""
		   text="同じく電車を降りて行く学生たちは物珍しそうに私たちの姿を見ては、なにやら囁きあいながら立ち去っていく。" voices=""/>
		<msg @l="571" char_id="-1" frame_id="-1" name=""
		   text="私は‥‥‥深くうつむいたままそれをやり過ごす事しか出来なかった。" voices=""/>
		<msg @l="573" char_id="1" frame_id="-1" name="玲" text="『美帆‥‥‥それに、稲庭さん？』"
		   voices=""/>
		<msg @l="575" char_id="0" frame_id="-1" name="美帆" text="『あ‥‥。』" voices=""/>
		<char @l="579" id="rei" pos="auto" src="rei014"/>
		<msg @l="581" char_id="-1" frame_id="-1" name=""
		   text="乗客の大半が降りた頃、車内ではぐれたきりだった白石先輩が降りてくる。" voices=""/>
		<msg @l="582" char_id="-1" frame_id="-1" name=""
		   text="降りてくるのが遅かったところを見ると、恐らく車内で私のことを探してくれていたのだろう。" voices=""/>
		<msg @l="584" char_id="1" frame_id="-1" name="玲" text="『なにかあったの？』" voices=""/>
		<msg @l="586" char_id="0" frame_id="-1" name="美帆"
		   text="『先輩‥‥少し行った所で待っていてくださいませんか？』" voices=""/>
		<msg @l="588" char_id="0" frame_id="-1" name="美帆" text="『すぐに私も‥‥行きますから。』"
		   voices=""/>
		<msg @l="590" char_id="1" frame_id="-1" name="玲" text="『‥‥‥‥。』" voices=""/>
		<msg @l="592" char_id="-1" frame_id="-1" name=""
		   text="先輩は私の言葉を聞いた後、稲庭先輩と朽木教授を順番に見る。" voices=""/>
		<msg @l="593" char_id="-1" frame_id="-1" name=""
		   text="そうして‥‥何かを察したかのように小さく頷いた。" voices=""/>
		<char @l="597" id="rei" pos="auto" src="rei010"/>
		<msg @l="599" char_id="1" frame_id="-1" name="玲"
		   text="『わかったわ‥‥工学部の校舎前で待ってるわね。』" voices=""/>
		<clear @l="603" class="char"/>
		<msg @l="605" char_id="-1" frame_id="-1" name=""
		   text="そう言って、先輩は最後に稲庭先輩の顔を見てから立ち去った。" voices=""/>
		<msg @l="607" char_id="-1" frame_id="-1" name="朽木" text="『‥‥くっ、いい加減に離さんかっ！』"
		   voices=""/>
		<char @l="611" id="kutsu" pos="right" src="kutsu010"/>
		<char @l="615" id="inaba" pos="left" src="inaba017"/>
		<msg @l="617" char_id="-1" frame_id="-1" name="稲庭"
		   text="『教授、自分の立場をきちんと認識した方が良いですよ。』" voices=""/>
		<msg @l="619" char_id="-1" frame_id="-1" name="稲庭"
		   text="『アナタは自分の教え子に痴漢行為を働いていた。自覚が無いのは行為そのものよりも重大な問題ですよ。』" voices=""/>
		<char @l="622" id="kutsu" pos="right" src="kutsu014"/>
		<msg @l="624" char_id="-1" frame_id="-1" name="朽木" text="『キサマ‥‥四年の稲庭、だな。』"
		   voices=""/>
		<msg @l="626" char_id="-1" frame_id="-1" name="稲庭" text="『良くご存知ですね。』"
		   voices=""/>
		<char @l="629" id="kutsu" pos="right" src="kutsu010"/>
		<msg @l="631" char_id="-1" frame_id="-1" name="朽木"
		   text="『知っているさ、キャンパス内の有名人だからな。』" voices=""/>
		<msg @l="633" char_id="-1" frame_id="-1" name="稲庭"
		   text="『僕も、教授の講義に出た事はありませんが、そのご高名は常々耳にさせて戴いていますよ。』" voices=""/>
		<msg @l="635" char_id="-1" frame_id="-1" name="稲庭"
		   text="『教え子に痴漢行為を働く悪辣な教授がいる、とね。』" voices=""/>
		<char @l="639" id="kutsu" pos="right" src="kutsu014"/>
		<msg @l="641" char_id="-1" frame_id="-1" name="朽木" text="『な‥‥でたらめを言うなっ！』"
		   voices=""/>
		<msg @l="643" char_id="-1" frame_id="-1" name="稲庭"
		   text="『でたらめですか。それでは今日こうして仲根さんに働いた行為についてはどのように弁明されるおつもりです？』" voices=""/>
		<msg @l="645" char_id="-1" frame_id="-1" name="朽木"
		   text="『わ、私は‥‥仲根クンが痴漢に遭っている所を発見して助けてやろうと手を伸ばしていただけだっ。』" voices=""/>
		<msg @l="647" char_id="-1" frame_id="-1" name="朽木"
		   text="『痴漢行為など‥‥‥するわけがなかろう。』" voices=""/>
		<msg @l="649" char_id="-1" frame_id="-1" name="稲庭"
		   text="『さて、その真偽については彼女がよくご存知なハズだ。』" voices=""/>
		<char @l="653" id="miho" pos="right" src="miho114"/>
		<msg @l="655" char_id="0" frame_id="-1" name="美帆" text="『え‥‥？』" voices=""/>
		<char @l="659" id="inaba" pos="left" src="inaba010"/>
		<msg @l="661" char_id="-1" frame_id="-1" name="稲庭"
		   text="『キミは、彼に痴漢されたことを訴えるかい？』" voices=""/>
		<msg @l="663" char_id="0" frame_id="-1" name="美帆" text="『訴える‥‥？』" voices=""/>
		<msg @l="665" char_id="-1" frame_id="-1" name="稲庭"
		   text="『そうだ、痴漢というのは立派な犯罪だからね。』" voices=""/>
		<msg @l="667" char_id="-1" frame_id="-1" name="稲庭"
		   text="『キミにその気があるなら告訴をするといい。確証があれば刑事事件として‥‥。』" voices=""/>
		<char @l="670" id="kutsu" pos="right" src="kutsu014"/>
		<msg @l="672" char_id="-1" frame_id="-1" name="朽木"
		   text="『ま、待ちたまえ‥‥警察に連絡するというのならそれもよかろう。』" voices=""/>
		<msg @l="674" char_id="-1" frame_id="-1" name="朽木"
		   text="『だが、いきなり告訴というのはやりすぎでは‥‥。』" voices=""/>
		<char @l="678" id="inaba" pos="left" src="inaba017"/>
		<msg @l="680" char_id="-1" frame_id="-1" name="稲庭"
		   text="『噂の教授は警察にもコネがあるという話を聞いていますよ。』" voices=""/>
		<msg @l="682" char_id="-1" frame_id="-1" name="稲庭"
		   text="『それに、罪に対する判断は検察にお願いした方が良いですからね。』" voices=""/>
		<char @l="686" id="kutsu" pos="right" src="kutsu018"/>
		<msg @l="688" char_id="-1" frame_id="-1" name="朽木" text="『‥‥‥‥。』" voices=""/>
		<char @l="691" id="miho" pos="left" src="miho115"/>
		<msg @l="693" char_id="-1" frame_id="-1" name="" text="朽木教授は、無言で私を睨み付けてくる。"
		   voices=""/>
		<msg @l="694" char_id="-1" frame_id="-1" name=""
		   text="恐らく「告訴なんてやめろ」という意味なのだろう。" voices=""/>
		<msg @l="695" char_id="-1" frame_id="-1" name="" text="嫌な‥‥視線だ。" voices=""/>
		<msg @l="697" char_id="-1" frame_id="-1" name="稲庭"
		   text="『どうする？&#32;彼を告訴するかい？』" voices=""/>
		<msg @l="702" async="true" char_id="-1" frame_id="-1" name=""
		   text="朽木教授を訴える‥‥？" voices=""/>
		<select @l="703">
			<menu @l="707" label="TempLabel_173" text="訴える"/>
			<menu @l="710" label="TempLabel_175" text="訴えない"/>
		</select>
		<goto @l="715" label="TempLabel_174"/>
		<label @l="717" id="TempLabel_173"/>
		<eval @l="719" expr="f.localflag&#32;=&#32;0&#13;&#10;"/>
		<goto @l="720" label="TempLabel_174"/>
		<label @l="722" id="TempLabel_175"/>
		<eval @l="724" expr="f.localflag&#32;=&#32;1&#13;&#10;"/>
		<goto @l="725" label="TempLabel_174"/>
		<label @l="727" id="TempLabel_174"/>
		<goto @l="734" label="TempLabel_176"/>
		<label @l="738" id="TempLabel_176"/>
		<goto @l="739" cond="(f.localflag)&#32;!=&#32;(0)&#13;&#10;"
		   label="TempLabel_177"/>
		<msg @l="742" char_id="0" frame_id="-1" name="美帆" text="『私、訴えます‥‥。』"
		   voices=""/>
		<char @l="745" id="kutsu" pos="right" src="kutsu014"/>
		<msg @l="747" char_id="-1" frame_id="-1" name="朽木"
		   text="『なっ‥‥仲根クン、本気なのかねっ！？』" voices=""/>
		<msg @l="749" char_id="0" frame_id="-1" name="美帆"
		   text="『本気ですっ‥‥私、この数日間は本当に怖い思いをしたんです。』" voices=""/>
		<msg @l="751" char_id="0" frame_id="-1" name="美帆"
		   text="『そのままになんて‥‥‥‥出来ません。』" voices=""/>
		<clear @l="754" class="char"/>
		<char @l="756" id="inaba" pos="left" src="inaba010"/>
		<char @l="758" id="miho" pos="right" src="miho115"/>
		<msg @l="760" char_id="-1" frame_id="-1" name="稲庭"
		   text="『オーケー、それじゃあ知り合いに弁護士がいるからその人を紹介してあげよう。』" voices=""/>
		<msg @l="762" char_id="-1" frame_id="-1" name="稲庭"
		   text="『解らないことも親切に教えてくれる人だし、何より信用できる。』" voices=""/>
		<char @l="765" id="kutsu" pos="right" src="kutsu014"/>
		<msg @l="767" char_id="-1" frame_id="-1" name="朽木" text="『稲庭‥‥‥余計な真似をっ！』"
		   voices=""/>
		<char @l="770" id="inaba" pos="left" src="inaba017"/>
		<msg @l="772" char_id="-1" frame_id="-1" name="稲庭"
		   text="『おや、教授‥‥‥往生際の悪い事を言わないでください。』" voices=""/>
		<msg @l="774" char_id="-1" frame_id="-1" name="稲庭"
		   text="『彼女は自分が恐怖を味わった分、アナタに報復をしたいと言っているんです。』" voices=""/>
		<msg @l="776" char_id="-1" frame_id="-1" name="稲庭"
		   text="『僕はその手助けをしてあげるまでですよ。』" voices=""/>
		<char @l="779" id="miho" pos="right" src="miho115"/>
		<msg @l="781" char_id="0" frame_id="-1" name="美帆" text="『報復だなんて‥‥‥そんなっ。』"
		   voices=""/>
		<msg @l="783" char_id="0" frame_id="-1" name="美帆"
		   text="『私はただ、もう二度とこんな事がないようにって‥‥‥それで。』" voices=""/>
		<char @l="786" id="inaba" pos="left" src="inaba010"/>
		<msg @l="788" char_id="-1" frame_id="-1" name="稲庭"
		   text="『別にキミが罪悪感を覚えるようなことではないんだよ？』" voices=""/>
		<msg @l="790" char_id="-1" frame_id="-1" name="稲庭"
		   text="『罪を犯した者はしかるべき所で裁かれる、それがこの現代における常識なんだからね。』" voices=""/>
		<msg @l="792" char_id="0" frame_id="-1" name="美帆"
		   text="『でも、私は別に報復だなんて考えで訴えるわけでは‥‥。』" voices=""/>
		<msg @l="794" char_id="-1" frame_id="-1" name="稲庭"
		   text="『ああ‥‥それは僕の言い方が悪かった。』" voices=""/>
		<msg @l="796" char_id="-1" frame_id="-1" name="稲庭"
		   text="『まあ、まさか本当に訴えるなんて言い出すとは思わなかったけれどね。』" voices=""/>
		<msg @l="798" char_id="0" frame_id="-1" name="美帆"
		   text="『え‥‥‥それって、どういう意味ですか‥‥‥‥？』" voices=""/>
		<msg @l="800" char_id="-1" frame_id="-1" name="稲庭" text="『いや、別に気にしないでいい。』"
		   voices=""/>
		<msg @l="802" char_id="-1" frame_id="-1" name=""
		   text="そうして稲庭先輩は人懐っこい笑みを浮かべてみせる。" voices=""/>
		<msg @l="803" char_id="-1" frame_id="-1" name=""
		   text="先日私と友達の前で見せた、あの完璧な笑みを。" voices=""/>
		<msg @l="805" char_id="-1" frame_id="-1" name="稲庭"
		   text="『それじゃあこれ、僕の知人の名刺だから。』" voices=""/>
		<msg @l="807" char_id="-1" frame_id="-1" name=""
		   text="そう言って稲庭先輩は手帳の中から名刺を一枚取り出し、私に差し出す。" voices=""/>
		<msg @l="808" char_id="-1" frame_id="-1" name=""
		   text="どうして彼がそれをこの場でもっていたのか疑問に思ったけれど、私は差し出されたそれをただ素直に受け取るしかなかった。"
		   voices=""/>
		<msg @l="810" char_id="-1" frame_id="-1" name="稲庭"
		   text="『僕からの紹介だといえば良くしてくれるハズだよ。』" voices=""/>
		<msg @l="812" char_id="0" frame_id="-1" name="美帆"
		   text="『あ、はい‥‥‥‥‥ありがとうございます。』" voices=""/>
		<msg @l="814" char_id="-1" frame_id="-1" name="稲庭"
		   text="『それじゃあ僕は行くけど、大丈夫かな？』" voices=""/>
		<msg @l="816" char_id="0" frame_id="-1" name="美帆" text="『‥‥はい。』" voices=""/>
		<msg @l="818" char_id="-1" frame_id="-1" name="稲庭" text="『じゃ、がんばってね。』"
		   voices=""/>
		<clear @l="822" class="char"/>
		<char @l="824" id="miho" pos="auto" src="miho015"/>
		<msg @l="827" char_id="-1" frame_id="-1" name=""
		   text="これまでの熱心さが嘘か冗談だったかのように、稲庭先輩はさらりと言い放つとその場から立ち去ってしまう。" voices=""/>
		<msg @l="828" char_id="-1" frame_id="-1" name="" text="まるで‥‥‥興味を無くした子供のように。"
		   voices=""/>
		<clear @l="831" class="char"/>
		<char @l="833" id="miho" pos="left" src="miho015"/>
		<char @l="835" id="kutsu" pos="right" src="kutsu010"/>
		<msg @l="837" char_id="-1" frame_id="-1" name="朽木"
		   text="『仲根クン‥‥考え直してはくれないか？』" voices=""/>
		<msg @l="839" char_id="-1" frame_id="-1" name=""
		   text="稲庭先輩の背中を見送った後、朽木教授は好機とばかりに擦り寄ってくる。" voices=""/>
		<msg @l="840" char_id="-1" frame_id="-1" name=""
		   text="その馴れ馴れしさが、今は無性に気持ち悪かった。" voices=""/>
		<char @l="843" id="miho" pos="left" src="miho115"/>
		<msg @l="845" char_id="0" frame_id="-1" name="美帆"
		   text="『か、考え直すも何も‥‥‥私は当然のことをするだけです。』" voices=""/>
		<msg @l="847" char_id="0" frame_id="-1" name="美帆"
		   text="『‥‥今後、私みたいな思いをする子が出ないように。』" voices=""/>
		<clear @l="851" layer="miho"/>
		<msg @l="853" char_id="-1" frame_id="-1" name=""
		   text="そうして私は朽木教授に背を向け、校舎へ向かって歩き出す。" voices=""/>
		<msg @l="854" char_id="-1" frame_id="-1" name=""
		   text="このまま彼と正面きって話をしていると、いつの間にかうやむやな事にされてしまいそうな気がしたからだ。" voices=""/>
		<clear @l="857" class="char"/>
		<char @l="859" id="kutsu" pos="auto" src="kutsu014"/>
		<msg @l="861" char_id="-1" frame_id="-1" name="朽木" text="『おい、仲根クンっ！』"
		   voices=""/>
		<msg @l="863" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="865" char_id="-1" frame_id="-1" name=""
		   text="背後から聞こえる教授の声から逃れるように、私は一度も振り返ることなく足早に校舎へ向かっていった。" voices=""/>
		<eval @l="868" expr="f.訴えるflag&#32;+=&#32;1&#13;&#10;"/>
		<goto @l="872" label="EventLabel_28"/>
		<goto @l="874" label="TempLabel_178"/>
		<label @l="878" id="TempLabel_177"/>
		<goto @l="879" cond="(f.localflag)&#32;!=&#32;(1)&#13;&#10;"
		   label="TempLabel_179"/>
		<msg @l="882" char_id="0" frame_id="-1" name="美帆" text="『‥‥やめておきます。』"
		   voices=""/>
		<msg @l="884" char_id="0" frame_id="-1" name="美帆"
		   text="『はっきりと確証があるわけじゃありませんし‥‥‥それに。』" voices=""/>
		<msg @l="886" char_id="-1" frame_id="-1" name=""
		   text="告訴なんてしたら、それこそ痴漢されていました、と公に宣伝するようなものだ。" voices=""/>
		<msg @l="887" char_id="-1" frame_id="-1" name=""
		   text="そんな事になってしまっては恥ずかしくて、外を出歩けなくなってしまう。" voices=""/>
		<msg @l="889" char_id="-1" frame_id="-1" name="稲庭" text="『それに？』" voices=""/>
		<msg @l="891" char_id="0" frame_id="-1" name="美帆" text="『い、いえ‥‥‥なんでもありません。』"
		   voices=""/>
		<msg @l="893" char_id="0" frame_id="-1" name="美帆"
		   text="『とにかく、私は教授を訴えたりはしません。』" voices=""/>
		<char @l="897" id="kutsu" pos="right" src="kutsu010"/>
		<msg @l="899" char_id="-1" frame_id="-1" name="朽木"
		   text="『おお、仲根クンならば解ってくれると思っていたよ。』" voices=""/>
		<msg @l="901" char_id="-1" frame_id="-1" name="" text="朽木教授はそう言って私の手を握る。"
		   voices=""/>
		<msg @l="902" char_id="-1" frame_id="-1" name=""
		   text="私は‥‥半ば振り払うようにしてその手を引き戻す。" voices=""/>
		<msg @l="904" char_id="0" frame_id="-1" name="美帆" text="『勘違いしないでくださいっ。』"
		   voices=""/>
		<msg @l="906" char_id="0" frame_id="-1" name="美帆"
		   text="『私は‥‥教授を信じたわけでも許したわけでもないです。』" voices=""/>
		<msg @l="908" char_id="0" frame_id="-1" name="美帆"
		   text="『ただ、安易にそういう事をしない方がいいって‥‥思っただけです。』" voices=""/>
		<char @l="911" id="kutsu" pos="right" src="kutsu014"/>
		<msg @l="913" char_id="-1" frame_id="-1" name="朽木"
		   text="『な、何を言っているのかね‥‥キミも私を痴漢だと思って‥‥‥。』" voices=""/>
		<msg @l="915" char_id="-1" frame_id="-1" name="稲庭"
		   text="『教授‥‥彼女は今回の事をなかった事にする代わりに教授に更正をして欲しいと言っているんですよ。』" voices=""/>
		<msg @l="917" char_id="-1" frame_id="-1" name="稲庭" text="『それがわかりませんか？』"
		   voices=""/>
		<msg @l="919" char_id="-1" frame_id="-1" name="朽木"
		   text="『何が更正だっ、私は元より罪など犯してなど‥‥‥。』" voices=""/>
		<char @l="922" id="inaba" pos="left" src="inaba017"/>
		<msg @l="924" char_id="-1" frame_id="-1" name="稲庭" text="『教授！』" voices=""/>
		<msg @l="926" char_id="-1" frame_id="-1" name=""
		   text="教授の言葉を遮るように、稲庭先輩が一喝をする。" voices=""/>
		<msg @l="927" char_id="-1" frame_id="-1" name="" text="これには教授も、そして私も驚いた。"
		   voices=""/>
		<char @l="930" id="inaba" pos="left" src="inaba010"/>
		<msg @l="932" char_id="-1" frame_id="-1" name="稲庭"
		   text="『悪辣な趣味を一つ失うのと人生を踏み外してしまう事、どちらがより得策な措置であるかはご自分がよく知っているのではありませんか？』"
		   voices=""/>
		<msg @l="934" char_id="-1" frame_id="-1" name=""
		   text="そう言う稲庭の顔は穏やかな笑顔ではあったが、底知れぬ威圧感も兼ね合わせていた。" voices=""/>
		<char @l="937" id="kutsu" pos="right" src="kutsu014"/>
		<msg @l="939" char_id="-1" frame_id="-1" name="朽木" text="『ぐ、ぬぬ‥‥。』"
		   voices=""/>
		<msg @l="941" char_id="-1" frame_id="-1" name="稲庭"
		   text="『解ったら早く立ち去った方がいいですよ。』" voices=""/>
		<msg @l="943" char_id="-1" frame_id="-1" name="稲庭" text="『彼女の気が変わってしまう前にね。』"
		   voices=""/>
		<msg @l="945" char_id="-1" frame_id="-1" name="朽木" text="『くそっ！』" voices=""/>
		<char @l="950" id="miho" pos="right" src="miho015"/>
		<msg @l="953" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="955" char_id="-1" frame_id="-1" name=""
		   text="私は複雑な気持ちで、立ち去る教授の背中を見送る。" voices=""/>
		<msg @l="956" char_id="-1" frame_id="-1" name=""
		   text="半ば尊敬していた教授だっただけに‥‥ショックは大きい。" voices=""/>
		<msg @l="958" char_id="-1" frame_id="-1" name="稲庭" text="『本当にあれで良かったのかい？』"
		   voices=""/>
		<msg @l="960" char_id="0" frame_id="-1" name="美帆"
		   text="『あれで良いんです‥‥というか、私には誰かを訴えるような勇気も行動力もないですよ。』" voices=""/>
		<msg @l="962" char_id="-1" frame_id="-1" name="稲庭"
		   text="『そこまで自分を卑下しなくてもいい。』" voices=""/>
		<msg @l="964" char_id="-1" frame_id="-1" name="稲庭"
		   text="『キミはキミのやり方で、彼を処罰した‥‥それだけだよ。』" voices=""/>
		<msg @l="966" char_id="0" frame_id="-1" name="美帆" text="『‥‥はい。』" voices=""/>
		<msg @l="968" char_id="-1" frame_id="-1" name="稲庭"
		   text="『これで、痴漢に遭わなくなるといいな。』" voices=""/>
		<clear @l="972" layer="inaba"/>
		<msg @l="974" char_id="-1" frame_id="-1" name=""
		   text="そう言って笑うと、稲庭先輩は手を振りながら校舎の方へ歩いて行く。" voices=""/>
		<msg @l="976" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥‥。』" voices=""/>
		<char @l="979" id="miho" pos="auto" src="miho116"/>
		<msg @l="981" char_id="0" frame_id="-1" name="美帆" text="(先輩が助けてくれてよかった‥‥)"
		   voices=""/>
		<msg @l="983" char_id="0" frame_id="-1" name="美帆"
		   text="(朽木教授が痴漢だったのは‥‥‥ショックだったけど‥‥嬉しかった)" voices=""/>
		<char @l="986" id="miho" pos="auto" src="miho014"/>
		<msg @l="988" char_id="0" frame_id="-1" name="美帆" text="(あっ、でも‥‥)" voices=""/>
		<msg @l="990" char_id="0" frame_id="-1" name="美帆"
		   text="(稲庭先輩はどうして私が痴漢に遭ってたこと、解ったのかな)" voices=""/>
		<goto @l="993" label="EventLabel_28"/>
		<goto @l="995" label="TempLabel_178"/>
		<label @l="997" id="TempLabel_179"/>
		<label @l="998" id="TempLabel_178"/>
		<goto @l="1002" label="TempLabel_180"/>
		<label @l="1003" id="TempLabel_172"/>
		<goto @l="1004" cond="!(f.痴漢flag&#32;==&#32;0)&#13;&#10;"
		   label="TempLabel_181"/>
		<description @l="1008" text="断罪の時？"/>
		<msg @l="1010" char_id="1" frame_id="-1" name="声" text="『あら、こうするのよ。』"
		   voices="rei00130"/>
		<msg @l="1012" char_id="-1" frame_id="-1" name=""
		   text="聞き慣れた声と共に女性の腕が伸びてきたかと思うと、スカートの中に侵入していた痴漢の手を勢いよく払い除ける。" voices=""/>
		<stopbgm @l="1016" fadeout="1000"/>
		<msg @l="1018" char_id="-1" frame_id="-1" name="痴漢"
		   text="『な、なんだお前は‥‥‥何をするっ！』" voices=""/>
		<msg @l="1020" char_id="1" frame_id="-1" name="声"
		   text="『あら‥‥アナタこそ何をしているのかしらね、朽木教授？』" voices="rei00140"/>
		<msg @l="1022" char_id="0" frame_id="-1" name="美帆" text="『え‥‥？』"
		   voices="miho01550"/>
		<msg @l="1032" char_id="-1" frame_id="-1" name=""
		   text="突然思ってもいなかった名前を言われ、私は慌てて振り返る。" voices=""/>
		<msg @l="1033" char_id="-1" frame_id="-1" name="" text="私の背後には二人の人物がいた。"
		   voices=""/>
		<msg @l="1034" char_id="-1" frame_id="-1" name=""
		   text="一人は、痴漢をしていた男の手をつかんで捻りあげている白石先輩。" voices=""/>
		<msg @l="1035" char_id="-1" frame_id="-1" name=""
		   text="そしてもう一人‥‥痴漢行為を働いていた男は、私が専攻しているゼミの講師である朽木陽大教授だった。" voices=""/>
		<msg @l="1037" char_id="0" frame_id="-1" name="美帆"
		   text="『どうして‥‥‥朽木教授が‥‥‥‥‥？』" voices="miho01560"/>
		<msg @l="1039" char_id="-1" frame_id="-1" name="朽木"
		   text="『ち、違うんだ‥‥仲根クン、誤解しないでくれたまえ。』" voices=""/>
		<msg @l="1041" char_id="-1" frame_id="-1" name=""
		   text="振り返った私と視線がぶつかると、朽木教授はすがり付くように身を寄せて弁明の言葉をつむぎはじめる。" voices=""/>
		<msg @l="1042" char_id="-1" frame_id="-1" name=""
		   text="私はもう何がなんだか解らなくて、教授から顔を逸らすので精一杯だった。" voices=""/>
		<msg @l="1044" char_id="1" frame_id="-1" name="玲" text="『何が誤解しないでくれたまえ、です。』"
		   voices="rei00150"/>
		<msg @l="1046" char_id="1" frame_id="-1" name="玲"
		   text="『現行犯を押さえられた上での言い訳なんて、見苦しいだけですよ！』" voices="rei00160"/>
		<msg @l="1048" char_id="-1" frame_id="-1" name="朽木" text="『ぐぬぬぬ‥‥。』"
		   voices=""/>
		<msg @l="1050" char_id="1" frame_id="-1" name="玲"
		   text="『とにかく、お話は電車を降りてからじっくりと聞かせて戴きます。』" voices="rei00170"/>
		<msg @l="1052" char_id="1" frame_id="-1" name="玲" text="『教授‥‥覚悟なさってくださいね。』"
		   voices="rei00180"/>
		<msg @l="1054" char_id="-1" frame_id="-1" name=""
		   text="そうして微かな笑みを浮かべた白石先輩の瞳は、少しも笑っていなかった。" voices=""/>
		<stopse @l="1058" buf="3"/>
		<clear @l="1064" class="all"/>
		<msgshow @l="1066" show="true"/>
		<wait_chgmv/>
		<bg @l="1070" src="bg07"/>
		<bgm @l="1074" src="bgm03" volume="1."/>
		<msg @l="1076" char_id="-1" frame_id="-1" name=""
		   text="キャンパス内にある停留所へと、路面電車が到着する。" voices=""/>
		<msg @l="1077" char_id="-1" frame_id="-1" name=""
		   text="溢れるように降りて行く学生の流れに揉まれながら、白石先輩と、その彼女に腕を捻られたままの朽木教授が車外へと滑り出していく。"
		   voices=""/>
		<msg @l="1078" char_id="-1" frame_id="-1" name=""
		   text="私も、二人の背中を追うような形で車外へ降りた。" voices=""/>
		<msg @l="1079" char_id="-1" frame_id="-1" name=""
		   text="一緒の電車に乗っていた学生たちからは好奇の視線が注がれ、その所々ではひっきりなしに何かを囁かれている。" voices=""/>
		<msg @l="1080" char_id="-1" frame_id="-1" name=""
		   text="私はそうした視線から逃れるように深くうつむいたまま‥‥懸命にやり過ごすことしか出来なかった。" voices=""/>
		<char @l="1084" id="kutsu" pos="right" src="kutsu014"/>
		<msg @l="1086" char_id="-1" frame_id="-1" name="朽木"
		   text="『くっ‥‥いい加減に離してくれたまえ。』" voices=""/>
		<msg @l="1088" char_id="-1" frame_id="-1" name=""
		   text="そう言って、朽木教授は捻りあげられていた手を強引に引き離す。" voices=""/>
		<char @l="1092" id="rei" pos="left" src="rei027"/>
		<msg @l="1094" char_id="1" frame_id="-1" name="玲"
		   text="『あら、随分と威勢がよろしいですのね‥‥教授。』" voices=""/>
		<msg @l="1096" char_id="1" frame_id="-1" name="玲"
		   text="『もう少ししおらしくなさっていれば、情けのかけようもあるかもしれませんのに。』" voices=""/>
		<char @l="1099" id="kutsu" pos="right" src="kutsu014"/>
		<msg @l="1101" char_id="-1" frame_id="-1" name="朽木" text="『何が情けだ、バカバカしい。』"
		   voices=""/>
		<msg @l="1103" char_id="-1" frame_id="-1" name="朽木"
		   text="『公衆の面前で腕を捻り上げられてしおらしくなど出来るものか。』" voices=""/>
		<msg @l="1105" char_id="1" frame_id="-1" name="玲"
		   text="『その公衆の面前で痴漢行為を働いていたのはどなたでしょうね？』" voices=""/>
		<char @l="1108" id="kutsu" pos="right" src="kutsu018"/>
		<msg @l="1110" char_id="-1" frame_id="-1" name="朽木" text="『ふん‥‥証拠があるまい。』"
		   voices=""/>
		<msg @l="1112" char_id="1" frame_id="-1" name="玲"
		   text="『美帆という被害者が居て私という目撃者が居るのですから、証拠としては十分だと思いますけど？』" voices=""/>
		<msg @l="1114" char_id="-1" frame_id="-1" name="朽木"
		   text="『その目撃証言とて嘘偽りではないという証拠はどこにもあるまい。こうしてつかんでいる私の手とて間違いという可能性もある。』"
		   voices=""/>
		<char @l="1117" id="rei" pos="left" src="rei017"/>
		<msg @l="1119" char_id="1" frame_id="-1" name="玲" text="『‥‥‥‥。』" voices=""/>
		<char @l="1122" id="kutsu" pos="right" src="kutsu010"/>
		<msg @l="1124" char_id="-1" frame_id="-1" name="朽木"
		   text="『この場に警察関係者が居合わせたわけでもない以上、キミや仲根クンが何を主張したところで、罪には問われんよ。』" voices=""/>
		<msg @l="1126" char_id="1" frame_id="-1" name="玲" text="『確かにそうかもしれませんわね。』"
		   voices=""/>
		<msg @l="1128" char_id="1" frame_id="-1" name="玲"
		   text="『けれど、教授を裁く手立てなら他にもありますわ。』" voices=""/>
		<char @l="1131" id="rei" pos="left" src="rei027"/>
		<msg @l="1133" char_id="1" frame_id="-1" name="玲"
		   text="『例えば‥‥告訴、ということも可能ですわね。』" voices=""/>
		<char @l="1136" id="kutsu" pos="right" src="kutsu014"/>
		<msg @l="1138" char_id="-1" frame_id="-1" name="朽木"
		   text="『バカな‥‥痴漢ごときで告訴など！』" voices=""/>
		<char @l="1141" id="rei" pos="left" src="rei017"/>
		<msg @l="1143" char_id="1" frame_id="-1" name="玲" text="『痴漢ごとき、ですか。』"
		   voices=""/>
		<msg @l="1145" char_id="1" frame_id="-1" name="玲"
		   text="『教授のような方がいらっしゃるから、彼女のような被害者が減らないのですよ。』" voices=""/>
		<char @l="1148" id="rei" pos="left" src="rei010"/>
		<msg @l="1150" char_id="-1" frame_id="-1" name="" text="そうして先輩は私を見る。"
		   voices=""/>
		<msg @l="1151" char_id="-1" frame_id="-1" name=""
		   text="朽木教授を見る時のような冷たい笑顔とは違う、暖かい眼差しで。" voices=""/>
		<msg @l="1153" char_id="1" frame_id="-1" name="玲" text="『さあ、美帆‥‥あとはアナタ次第よ。』"
		   voices=""/>
		<char @l="1157" id="miho" pos="right" src="miho015"/>
		<msg @l="1159" char_id="0" frame_id="-1" name="美帆"
		   text="『え‥‥私次第って、どういうことですか？』" voices=""/>
		<msg @l="1161" char_id="1" frame_id="-1" name="玲"
		   text="『彼を告訴するかしないか、それを決めるのはアナタ次第ってことよ。』" voices=""/>
		<char @l="1165" id="miho" pos="right" src="miho115"/>
		<msg @l="1167" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="1169" char_id="1" frame_id="-1" name="玲"
		   text="『幸い私が参加しているサークルには弁護士に知り合いがいる方がいるから、解らない事があれば何でも相談に乗れるわ。』" voices=""/>
		<msg @l="1171" char_id="1" frame_id="-1" name="玲" text="『どう‥‥教授を告訴するかしら？』"
		   voices=""/>
		<msg @l="1176" async="true" char_id="-1" frame_id="-1" name=""
		   text="朽木教授を訴える‥‥？" voices=""/>
		<select @l="1177">
			<menu @l="1180" label="TempLabel_182" text="訴える"/>
			<menu @l="1182" label="TempLabel_184" text="訴えない"/>
		</select>
		<goto @l="1186" label="TempLabel_183"/>
		<label @l="1188" id="TempLabel_182"/>
		<eval @l="1190" expr="f.localflag&#32;=&#32;0&#13;&#10;"/>
		<goto @l="1191" label="TempLabel_183"/>
		<label @l="1193" id="TempLabel_184"/>
		<eval @l="1195" expr="f.localflag&#32;=&#32;1&#13;&#10;"/>
		<goto @l="1196" label="TempLabel_183"/>
		<label @l="1198" id="TempLabel_183"/>
		<goto @l="1205" label="TempLabel_185"/>
		<label @l="1209" id="TempLabel_185"/>
		<goto @l="1210" cond="(f.localflag)&#32;!=&#32;(0)&#13;&#10;"
		   label="TempLabel_186"/>
		<msg @l="1213" char_id="0" frame_id="-1" name="美帆"
		   text="『あの‥‥私、告訴したいと思います。』" voices=""/>
		<msg @l="1215" char_id="-1" frame_id="-1" name=""
		   text="私は、喉の奥から搾り出すようにして言葉をつむぐ。" voices=""/>
		<msg @l="1216" char_id="-1" frame_id="-1" name=""
		   text="自分が味わった恐怖や嫌悪感、それをそのままにしておく事は出来ない。" voices=""/>
		<msg @l="1217" char_id="-1" frame_id="-1" name="" text="ただ‥‥その一心からの答えだった。"
		   voices=""/>
		<char @l="1221" id="kutsu" pos="right" src="kutsu014"/>
		<msg @l="1223" char_id="-1" frame_id="-1" name="朽木"
		   text="『バカなっ、告訴には多大な時間と金が掛かるのだぞ。』" voices=""/>
		<msg @l="1225" char_id="-1" frame_id="-1" name="朽木"
		   text="『学生のキミがおいそれと出来るような事だと思っているのかね？』" voices=""/>
		<char @l="1228" id="miho" pos="left" src="miho015"/>
		<msg @l="1230" char_id="0" frame_id="-1" name="美帆"
		   text="『それは‥‥そうかもしれませんけど‥‥‥‥。』" voices=""/>
		<char @l="1233" id="miho" pos="left" src="miho115"/>
		<msg @l="1235" char_id="0" frame_id="-1" name="美帆"
		   text="『でも、私が告訴することで同じような思いをする子が少しでも居なくなるのなら、無駄なことではないと思いますから‥‥。』"
		   voices=""/>
		<char @l="1238" id="kutsu" pos="right" src="kutsu018"/>
		<msg @l="1240" char_id="-1" frame_id="-1" name="朽木" text="『‥‥ふん、大した偽善だな。』"
		   voices=""/>
		<char @l="1244" id="miho" pos="left" src="miho014"/>
		<msg @l="1246" char_id="0" frame_id="-1" name="美帆"
		   text="『偽善なんて、そんな‥‥‥‥私はっ‥‥‥‥。』" voices=""/>
		<char @l="1250" id="rei" pos="left" src="rei010"/>
		<msg @l="1252" char_id="1" frame_id="-1" name="玲"
		   text="『美帆‥‥大丈夫、アナタの言っていることは正しいわ。』" voices=""/>
		<msg @l="1254" char_id="1" frame_id="-1" name="玲"
		   text="『明日サークルのミーティングがあるから、その時にでも弁護士に知り合いがいる方に話をして、協力してもらえるように取り次いで貰いましょう。』"
		   voices=""/>
		<msg @l="1256" char_id="-1" frame_id="-1" name=""
		   text="そうして白石先輩は私の肩をそっと抱き寄せてくれた。" voices=""/>
		<msg @l="1257" char_id="-1" frame_id="-1" name=""
		   text="私は‥‥泣きそうになるのを堪えるのに、一所懸命だった。" voices=""/>
		<char @l="1261" id="rei" pos="left" src="rei017"/>
		<msg @l="1263" char_id="1" frame_id="-1" name="玲"
		   text="『さて‥‥朽木教授、この事はいずれ大学側にも知れると思います。』" voices=""/>
		<msg @l="1265" char_id="1" frame_id="-1" name="玲"
		   text="『今は皮肉をぶつけるよりも先に、今後の身の振り方を考えた方がよろしいですわよ？』" voices=""/>
		<msg @l="1267" char_id="-1" frame_id="-1" name="朽木" text="『くっ‥‥。』" voices=""/>
		<clear @l="1271" layer="rei"/>
		<char @l="1273" id="rei" pos="right" src="rei017"/>
		<char @l="1275" id="miho" pos="left" src="miho115"/>
		<msg @l="1278" char_id="-1" frame_id="-1" name=""
		   text="白石先輩の言葉に打ちのめされたかのように、朽木教授は踵を返して校舎の方へと足早に立ち去っていった。" voices=""/>
		<char @l="1282" id="rei" pos="right" src="rei020"/>
		<msg @l="1284" char_id="1" frame_id="-1" name="玲"
		   text="『ふぅ‥‥まったく、困った教授がいたものね。』" voices=""/>
		<char @l="1288" id="miho" pos="left" src="miho115"/>
		<msg @l="1290" char_id="0" frame_id="-1" name="美帆"
		   text="『先輩‥‥‥あの、すみませんでした‥‥‥‥‥。』" voices=""/>
		<msg @l="1292" char_id="1" frame_id="-1" name="玲" text="『別にアナタが謝る必要なんてないわ。』"
		   voices=""/>
		<msg @l="1294" char_id="1" frame_id="-1" name="玲"
		   text="『むしろ、謝らなくてはいけないのは私の方ね。』" voices=""/>
		<char @l="1297" id="miho" pos="left" src="miho014"/>
		<msg @l="1299" char_id="0" frame_id="-1" name="美帆" text="『え‥‥どうしてですか？』"
		   voices=""/>
		<msg @l="1301" char_id="1" frame_id="-1" name="玲"
		   text="『痴漢に遭ったの、今日が初めてじゃないんでしょう？』" voices=""/>
		<char @l="1304" id="miho" pos="left" src="miho015"/>
		<msg @l="1306" char_id="0" frame_id="-1" name="美帆" text="『‥‥はい。』" voices=""/>
		<char @l="1310" id="rei" pos="right" src="rei125"/>
		<msg @l="1312" char_id="1" frame_id="-1" name="玲"
		   text="『ごめんなさい、気付いてあげられなくて。』" voices=""/>
		<msg @l="1314" char_id="1" frame_id="-1" name="玲"
		   text="『私、ルームメイトとしても先輩としても失格だわ。』" voices=""/>
		<char @l="1318" id="miho" pos="left" src="miho114"/>
		<msg @l="1320" char_id="0" frame_id="-1" name="美帆"
		   text="『そんなっ‥‥言い出せなかった私が悪いんです。』" voices=""/>
		<char @l="1324" id="miho" pos="left" src="miho116"/>
		<msg @l="1326" char_id="0" frame_id="-1" name="美帆"
		   text="『その所為で先輩に迷惑ばかりかけちゃって‥‥‥。』" voices=""/>
		<char @l="1330" id="rei" pos="right" src="rei020"/>
		<msg @l="1332" char_id="1" frame_id="-1" name="玲"
		   text="『私は迷惑なんて思ってないから安心して。』" voices=""/>
		<char @l="1335" id="rei" pos="right" src="rei021"/>
		<msg @l="1337" char_id="1" frame_id="-1" name="玲"
		   text="『アナタのそういうところ、私は好きよ。』" voices=""/>
		<char @l="1341" id="miho" pos="left" src="miho113"/>
		<msg @l="1343" char_id="0" frame_id="-1" name="美帆" text="『先輩‥‥。』" voices=""/>
		<char @l="1346" id="rei" pos="right" src="rei120"/>
		<msg @l="1348" char_id="1" frame_id="-1" name="玲"
		   text="『でも、一人で何でも背負い込もうとしてはダメよ？』" voices=""/>
		<msg @l="1350" char_id="1" frame_id="-1" name="玲"
		   text="『潰れちゃった後じゃ、遅いんだからね。』" voices=""/>
		<char @l="1353" id="miho" pos="left" src="miho111"/>
		<msg @l="1355" char_id="0" frame_id="-1" name="美帆" text="『はい、ありがとうございます。』"
		   voices=""/>
		<eval @l="1358" expr="f.訴えるflag&#32;+=&#32;1&#13;&#10;"/>
		<stopbgm @l="1362" fadeout="1000"/>
		<goto @l="1365" label="EventLabel_28"/>
		<goto @l="1367" label="TempLabel_187"/>
		<label @l="1371" id="TempLabel_186"/>
		<goto @l="1372" cond="(f.localflag)&#32;!=&#32;(1)&#13;&#10;"
		   label="TempLabel_188"/>
		<msg @l="1375" char_id="0" frame_id="-1" name="美帆"
		   text="『‥‥あの、そういうのはやめます‥‥‥‥。』" voices=""/>
		<msg @l="1377" char_id="-1" frame_id="-1" name=""
		   text="私はしばらく考えた後、思い切ってその言葉を発した。" voices=""/>
		<msg @l="1378" char_id="-1" frame_id="-1" name=""
		   text="罪を犯した人を告発する‥‥それは簡単な図式なのかもしれない。" voices=""/>
		<msg @l="1379" char_id="-1" frame_id="-1" name=""
		   text="けれど、仮に私が朽木教授を告訴したらどうなるだろう？" voices=""/>
		<msg @l="1380" char_id="-1" frame_id="-1" name=""
		   text="彼は多分‥‥一生消えない「社会的な傷」を負う事になるだろう。" voices=""/>
		<msg @l="1381" char_id="-1" frame_id="-1" name=""
		   text="それが罪を犯した者への正当な代償だといってしまえばそれまでかもしれないけれど‥‥そうしたことで私の受けた嫌悪が拭われる事は多分ない。"
		   voices=""/>
		<msg @l="1382" char_id="-1" frame_id="-1" name=""
		   text="そんな腹いせ行為に何の意味があるのだろう‥‥。" voices=""/>
		<msg @l="1383" char_id="-1" frame_id="-1" name=""
		   text="正義という名の因果応報なんて、私は‥‥。" voices=""/>
		<msg @l="1385" char_id="0" frame_id="-1" name="美帆"
		   text="『そんな軽々しく出来ることでもないと思いますし、私は朽木教授が今後こういう事をしないって約束してくれれば‥‥それで良いですから。』"
		   voices=""/>
		<char @l="1389" id="kutsu" pos="right" src="kutsu010"/>
		<msg @l="1391" char_id="-1" frame_id="-1" name="朽木" text="『ほ、本当かね？』"
		   voices=""/>
		<msg @l="1393" char_id="-1" frame_id="-1" name="朽木" text="『本当に告訴はしない‥‥のだな？』"
		   voices=""/>
		<msg @l="1395" char_id="0" frame_id="-1" name="美帆"
		   text="『はい‥‥教授が罪を認めて、二度としないと約束してくれるなら。』" voices=""/>
		<msg @l="1397" char_id="-1" frame_id="-1" name="朽木"
		   text="『は、ははっ‥‥わかっているとも。』" voices=""/>
		<msg @l="1399" char_id="-1" frame_id="-1" name="朽木"
		   text="『安心したまえ、二度とこんな事はしないと約束しよう。』" voices=""/>
		<char @l="1403" id="rei" pos="left" src="rei027"/>
		<msg @l="1405" char_id="1" frame_id="-1" name="玲"
		   text="『‥‥あら、先ほどとは一変しましたわね。』" voices=""/>
		<char @l="1408" id="kutsu" pos="right" src="kutsu014"/>
		<msg @l="1410" char_id="-1" frame_id="-1" name="朽木"
		   text="『う、うるさいっ‥‥とにかく約束はする、これで良かろう？』" voices=""/>
		<char @l="1413" id="rei" pos="left" src="rei010"/>
		<msg @l="1415" char_id="1" frame_id="-1" name="玲" text="『本当にそれで良いのね‥‥？』"
		   voices=""/>
		<char @l="1419" id="miho" pos="right" src="miho116"/>
		<msg @l="1421" char_id="0" frame_id="-1" name="美帆" text="『はい‥‥私はそれで良いです。』"
		   voices=""/>
		<char @l="1424" id="rei" pos="left" src="rei120"/>
		<msg @l="1426" char_id="1" frame_id="-1" name="玲" text="『そう‥‥。』" voices=""/>
		<msg @l="1428" char_id="1" frame_id="-1" name="玲"
		   text="『アナタがそう言うのなら、私も無理に勧める気は無いわ。』" voices=""/>
		<char @l="1431" id="rei" pos="left" src="rei117"/>
		<msg @l="1433" char_id="1" frame_id="-1" name="玲"
		   text="『教授が約束さえ守ってくださるのでしたら、ね。』" voices=""/>
		<msg @l="1435" char_id="-1" frame_id="-1" name=""
		   text="言葉と共に、先輩は鋭く射抜くような視線を朽木教授に向ける。" voices=""/>
		<char @l="1439" id="kutsu" pos="right" src="kutsu014"/>
		<msg @l="1441" char_id="-1" frame_id="-1" name="朽木"
		   text="『で、では‥‥私は講義の準備があるので失礼させてもらうよ。』" voices=""/>
		<char @l="1445" id="miho" pos="right" src="miho116"/>
		<msg @l="1447" char_id="-1" frame_id="-1" name=""
		   text="白石先輩の視線から逃げるように、朽木教授はその場を立ち去る。" voices=""/>
		<msg @l="1448" char_id="-1" frame_id="-1" name=""
		   text="その背中を見つめる先輩の表情は何処か煮え切らないといった様子で、ともすれば忌々しげといった感じだ。" voices=""/>
		<char @l="1451" id="rei" pos="left" src="rei010"/>
		<msg @l="1453" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<char @l="1456" id="miho" pos="right" src="miho115"/>
		<msg @l="1458" char_id="0" frame_id="-1" name="美帆" text="『ごめんなさい‥‥。』"
		   voices=""/>
		<msg @l="1460" char_id="1" frame_id="-1" name="玲" text="『アナタが謝ることではないでしょう？』"
		   voices=""/>
		<msg @l="1462" char_id="0" frame_id="-1" name="美帆" text="『そう‥‥かもしれませんけど。』"
		   voices=""/>
		<msg @l="1464" char_id="-1" frame_id="-1" name=""
		   text="何にせよ私が先輩の好意を無にしたことに違いは無い。" voices=""/>
		<msg @l="1465" char_id="-1" frame_id="-1" name=""
		   text="そう思うと‥‥今更ながら自分の判断が正しかったかどうか解らなくなる。" voices=""/>
		<msg @l="1467" char_id="1" frame_id="-1" name="玲" text="『‥‥‥‥。』" voices=""/>
		<char @l="1470" id="rei" pos="left" src="rei125"/>
		<msg @l="1472" char_id="1" frame_id="-1" name="玲"
		   text="『アナタの気持ちは解るわ。別に私だって彼が断罪される姿を見て喜びたいわけじゃない。』" voices=""/>
		<char @l="1475" id="rei" pos="left" src="rei015"/>
		<msg @l="1477" char_id="1" frame_id="-1" name="玲"
		   text="『でもね‥‥世の中には身をもって罪を罪だと実感しない限り、同じ過ちを繰り返す人が大勢存在してるって事だけ、わかって欲しいの。』"
		   voices=""/>
		<char @l="1480" id="miho" pos="right" src="miho115"/>
		<msg @l="1482" char_id="0" frame_id="-1" name="美帆" text="『はい‥‥。』" voices=""/>
		<char @l="1485" id="rei" pos="left" src="rei128"/>
		<msg @l="1487" char_id="1" frame_id="-1" name="玲" text="『人って、難しいわね。』"
		   voices=""/>
		<msg @l="1489" char_id="-1" frame_id="-1" name=""
		   text="先輩はそう言って少しだけ寂しそうに笑った。" voices=""/>
		<stopbgm @l="1493" fadeout="1000"/>
		<goto @l="1496" label="EventLabel_28"/>
		<goto @l="1498" label="TempLabel_187"/>
		<label @l="1500" id="TempLabel_188"/>
		<label @l="1501" id="TempLabel_187"/>
		<label @l="1504" id="TempLabel_181"/>
		<label @l="1505" id="TempLabel_180"/>
		<goto @l="1510" label="TempLabel_189"/>
		<label @l="1511" id="TempLabel_171"/>
		<msg @l="1515" char_id="-1" frame_id="-1" name=""
		   text="もぞもぞと指先が蠢き、スカートの裾から痴漢の手が入り込んでくる。" voices=""/>
		<msg @l="1517" char_id="0" frame_id="-1" name="美帆" text="『あっ‥‥。』"
		   voices="miho01570"/>
		<msg @l="1519" char_id="-1" frame_id="-1" name=""
		   text="私は慌ててスカートを手で押えようとするが、間に合わない。" voices=""/>
		<msg @l="1520" char_id="-1" frame_id="-1" name=""
		   text="痴漢の手は下着の上からお尻を撫であげ、捏ねまわしてくる。" voices=""/>
		<msg @l="1522" char_id="0" frame_id="-1" name="美帆"
		   text="『‥‥‥いや‥‥‥やめてください‥‥‥‥。』" voices="miho01580"/>
		<msg @l="1524" char_id="-1" frame_id="-1" name="痴漢"
		   text="『くく、心にも無い事を言うものではないな。』" voices=""/>
		<msg @l="1526" char_id="0" frame_id="-1" name="美帆"
		   text="『そんな事‥‥‥私は本当に嫌なんです。』" voices="miho01590"/>
		<msg @l="1528" char_id="-1" frame_id="-1" name="痴漢"
		   text="『ならば、声をあげるなり必死に抵抗するなりするが良い。』" voices=""/>
		<msg @l="1530" char_id="-1" frame_id="-1" name="痴漢"
		   text="『周囲にこれだけ人がいるのだ、誰かは気付いて助けてくれるかもしれんぞ？』" voices=""/>
		<msg @l="1532" char_id="0" frame_id="-1" name="美帆" text="『‥‥それ‥‥は‥‥‥。』"
		   voices="miho01600"/>
		<msg @l="1534" char_id="-1" frame_id="-1" name=""
		   text="そう‥‥どうしても痴漢の手から逃れたいと思うのならば、恥も外聞も捨てて大声をあげてしまえばいいのだ。" voices=""/>
		<msg @l="1535" char_id="-1" frame_id="-1" name="" text="けれど私にはそれが出来ない。"
		   voices=""/>
		<msg @l="1536" char_id="-1" frame_id="-1" name=""
		   text="痴漢に身体を弄ばれるよりも、周囲の知らない乗客に「痴漢をされていた」という事実を知られてしまうことの方が何倍も怖いから‥‥。"
		   voices=""/>
		<msg @l="1538" char_id="-1" frame_id="-1" name="痴漢" text="『くくっ‥‥。』"
		   voices=""/>
		<msg @l="1540" char_id="-1" frame_id="-1" name=""
		   text="答えに窮している私を見て、痴漢が低く笑う。" voices=""/>
		<msg @l="1541" char_id="-1" frame_id="-1" name="" text="するっ。" voices=""/>
		<msg @l="1542" char_id="-1" frame_id="-1" name=""
		   text="下着の上からお尻を捏ね回していた指先が、白い太腿の間に割って入り込んできた。" voices=""/>
		<msg @l="1543" char_id="-1" frame_id="-1" name="" text="スルスルと這うように太股を上ってくる。"
		   voices=""/>
		<msg @l="1544" char_id="-1" frame_id="-1" name=""
		   text="まるで、尺取虫が這うように、痴漢の手は蠢く。" voices=""/>
		<msg @l="1546" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥っ‥‥。』"
		   voices="miho01490"/>
		<msg @l="1548" char_id="-1" frame_id="-1" name=""
		   text="恥ずかしさのあまり噴出す自分の汗なのか、それともこのスリルに酔いしれる痴漢の汗なのか――" voices=""/>
		<msg @l="1549" char_id="-1" frame_id="-1" name=""
		   text="ねっとりと粘りつく感触にいくら堪えようとしても、つい声が洩れそうになる。" voices=""/>
		<msg @l="1550" char_id="-1" frame_id="-1" name=""
		   text="そして、ついに指先はパンティの船底へ辿り着いた。" voices=""/>
		<msg @l="1552" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥ぁ‥‥。』"
		   voices="miho00680"/>
		<msg @l="1554" char_id="-1" frame_id="-1" name=""
		   text="スカートは捲り上げられ、斜めになったスカートの裾からは白いパンティが丸見えになっているに違いない。" voices=""/>
		<msg @l="1555" char_id="-1" frame_id="-1" name=""
		   text="その恥ずかしい自分の姿を想像すると、頬から耳まで真っ赤になった。" voices=""/>
		<wait_chgmv/>
		<ev @l="1558" src="ev-005ax3y2"/>
		<msg @l="1560" char_id="-1" frame_id="-1" name=""
		   text="その様を愉しむかのように、痴漢の指は船底部分を直接擦りあげてきた。" voices=""/>
		<msg @l="1562" char_id="0" frame_id="-1" name="美帆" text="『ひっっっ！』"
		   voices="miho01610"/>
		<msg @l="1564" char_id="-1" frame_id="-1" name=""
		   text="突然の事に、私は思わず声をあげてしまう。" voices=""/>
		<msg @l="1565" char_id="-1" frame_id="-1" name=""
		   text="すぐ近くにいた学生の不思議そうな視線がこちらへ注がれる。" voices=""/>
		<msg @l="1566" char_id="-1" frame_id="-1" name=""
		   text="私は何とか声を押し殺し、下を向いて周囲の視線をやり過ごそうとするが何人かには痴漢をされている事を気付かれてしまったかもしれない。"
		   voices=""/>
		<msg @l="1568" char_id="-1" frame_id="-1" name="痴漢"
		   text="『さあ、チャンスだぞ、助けを求めてみてはどうかね？』" voices=""/>
		<msg @l="1570" char_id="-1" frame_id="-1" name=""
		   text="痴漢はそう言って愉しげに笑うと、私の気も知らずにパンティの上から秘部の柔肉を掻き分け指を押し込んでくる。" voices=""/>
		<msg @l="1572" char_id="0" frame_id="-1" name="美帆" text="『くっ‥‥。』"
		   voices="miho00400"/>
		<msg @l="1574" char_id="-1" frame_id="-1" name=""
		   text="その恥辱に瞼の裏がパチパチと放電する嫌な感触が走った。" voices=""/>
		<msg @l="1576" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥っ‥‥。』"
		   voices="miho01620"/>
		<msg @l="1578" char_id="-1" frame_id="-1" name="痴漢"
		   text="『いいぞ、今日は何本の指を入れられて耐えられるか試してみようか。』" voices=""/>
		<msg @l="1580" char_id="-1" frame_id="-1" name=""
		   text="痴漢はそんな私を見て満足げに笑うと、パンティの上から差し込んだ指で女唇を掻き分け、奥へ奥へと撫で上げながら押し込んできた。"
		   voices=""/>
		<msg @l="1582" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥ぅぁ‥‥。』"
		   voices="miho00430"/>
		<msg @l="1584" char_id="-1" frame_id="-1" name=""
		   text="お尻にキュッと力を入れ谷間を狭めるが、侵入者の防御には全くならない。" voices=""/>
		<msg @l="1586" char_id="-1" frame_id="-1" name="痴漢" text="『さて‥‥まず、２本。』"
		   voices=""/>
		<msg @l="1588" char_id="-1" frame_id="-1" name=""
		   text="私の秘所で２本の指先、人差し指と中指が蠢く。" voices=""/>
		<msg @l="1590" char_id="-1" frame_id="-1" name="" text="ぐにゅっ。" voices=""/>
		<msg @l="1592" char_id="0" frame_id="-1" name="美帆" text="『ひっ！』"
		   voices="miho00750"/>
		<msg @l="1594" char_id="-1" frame_id="-1" name=""
		   text="バージンでまだ固い二枚の女唇にやすやすと食い込む。" voices=""/>
		<msg @l="1595" char_id="-1" frame_id="-1" name=""
		   text="下着越しなので、指の第一関節も入っていないけれど、まだ男の人を知らない私の秘門は鋭い痛みを感じていた。" voices=""/>
		<msg @l="1597" char_id="0" frame_id="-1" name="美帆" text="『‥‥！？』"
		   voices="miho09970"/>
		<msg @l="1599" char_id="-1" frame_id="-1" name=""
		   text="だけど痴漢は私の気持ちなど知らず、２本の指で割れ目を掻きあげる。" voices=""/>
		<msg @l="1600" char_id="-1" frame_id="-1" name="" text="くちゅ。" voices=""/>
		<msg @l="1601" char_id="-1" frame_id="-1" name=""
		   text="この時私は、秘の奥からじわっと染み出してくる何かに、背筋をゾクゾクと震え上がらせていた。" voices=""/>
		<msg @l="1602" char_id="-1" frame_id="-1" name=""
		   text="痴漢は私の震える腰をしっかりと抑えながら、既に下着越しに入れている２本の指で秘所の柔肉を開き、３本目となる薬指を入れてきた。"
		   voices=""/>
		<msg @l="1603" char_id="-1" frame_id="-1" name="" text="ぐにゅっ、ぐにゅっ。"
		   voices=""/>
		<msg @l="1605" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥ゃ‥‥ぁぁ‥‥‥。』"
		   voices="miho01630"/>
		<msg @l="1607" char_id="-1" frame_id="-1" name="痴漢"
		   text="『３本目‥‥まだ嘘を吐き続ける気かね？』" voices=""/>
		<msg @l="1609" char_id="0" frame_id="-1" name="美帆" text="『嘘‥‥‥なんてっ‥‥‥‥。』"
		   voices="miho01640"/>
		<msg @l="1611" char_id="-1" frame_id="-1" name="痴漢"
		   text="『ならば、何故キミは助けを求めようとはしないのだろうな？３日間も連続で痴漢をされていながら変ではないかな？』" voices=""/>
		<msg @l="1613" char_id="0" frame_id="-1" name="美帆" text="『え‥‥それは‥‥‥。』"
		   voices="miho01650"/>
		<msg @l="1615" char_id="-1" frame_id="-1" name="痴漢"
		   text="『助けを求めればすぐにでも助けてもらえるかもしれない。しかしキミはそれに頼ろうとはしない。』" voices=""/>
		<msg @l="1617" char_id="-1" frame_id="-1" name="痴漢"
		   text="『つまりキミはこの状況を受け入れているというわけだ。』" voices=""/>
		<msg @l="1619" char_id="-1" frame_id="-1" name="痴漢"
		   text="『いや‥‥むしろ愉しんでいると言った方が正確かな？』" voices=""/>
		<msg @l="1621" char_id="0" frame_id="-1" name="美帆" text="『そんなこと‥‥。』"
		   voices="miho01660"/>
		<msg @l="1623" char_id="-1" frame_id="-1" name="痴漢"
		   text="『くく、そうして否定していられるのも時間の問題だ。』" voices=""/>
		<msg @l="1625" char_id="-1" frame_id="-1" name=""
		   text="痴漢の指が、割れ目の上側にある突起へと伸びる。" voices=""/>
		<msg @l="1626" char_id="-1" frame_id="-1" name=""
		   text="わずかに硬くなり始めていた突起に指先が絡みつき、乱暴に爪弾かれる。" voices=""/>
		<msg @l="1627" char_id="-1" frame_id="-1" name="" text="くりっ。" voices=""/>
		<msg @l="1629" char_id="0" frame_id="-1" name="美帆" text="『んっっ！！』"
		   voices="miho01670"/>
		<msg @l="1631" char_id="-1" frame_id="-1" name=""
		   text="小梅ほどの敏感な突起が皮かぶりのまま、怒ったようにぷくっと膨らみを帯びて、屹立している。" voices=""/>
		<msg @l="1633" char_id="0" frame_id="-1" name="美帆" text="『そこ‥‥‥ダメですっ‥‥‥‥‥。』"
		   voices="miho01680"/>
		<msg @l="1635" char_id="-1" frame_id="-1" name="痴漢"
		   text="『何処がダメなのか‥‥ハッキリと言われなければ解らんな。』" voices=""/>
		<msg @l="1637" char_id="0" frame_id="-1" name="美帆"
		   text="『ハッキリって‥‥‥いま、触ってるところです‥‥‥‥‥。』" voices="miho01690"/>
		<msg @l="1639" char_id="-1" frame_id="-1" name="痴漢" text="『此処がどうかしたのかな？』"
		   voices=""/>
		<msg @l="1641" char_id="-1" frame_id="-1" name="" text="くりっ、くりっ、くりっ。"
		   voices=""/>
		<msg @l="1642" char_id="-1" frame_id="-1" name=""
		   text="指の腹で弄ばれていた、赤い花の芽が突然摘み上げられる。" voices=""/>
		<msg @l="1644" char_id="0" frame_id="-1" name="美帆" text="『ダメ、やめて‥‥‥‥んんっ！！』"
		   voices="miho01700"/>
		<msg @l="1646" char_id="-1" frame_id="-1" name=""
		   text="コリコリと指先で心細いボタンのような突起を転がされるたびに、電流のスイッチが入り腰が砕け電車の床の上に座り込んでしまいそうになる。"
		   voices=""/>
		<msg @l="1647" char_id="-1" frame_id="-1" name=""
		   text="一生懸命つぐんでいる口からも、思わず声が漏れてしまう。" voices=""/>
		<msg @l="1649" char_id="-1" frame_id="-1" name="痴漢"
		   text="『やめろという割には、声が上擦っているようだがね？』" voices=""/>
		<msg @l="1651" char_id="0" frame_id="-1" name="美帆" text="『そんなっ‥‥‥んぁっっ！』"
		   voices="miho01710"/>
		<msg @l="1653" char_id="-1" frame_id="-1" name=""
		   text="痴漢の指がさらに小さなスイッチを転がすたびに、びりびりと電気が走ったように腰が震えてしまう。" voices=""/>
		<msg @l="1654" char_id="-1" frame_id="-1" name=""
		   text="あきらかに嫌悪感とは違う「何か」が‥‥膨らんでいく。" voices=""/>
		<msg @l="1655" char_id="-1" frame_id="-1" name="" text="身体が‥‥熱い。" voices=""/>
		<msg @l="1657" char_id="0" frame_id="-1" name="美帆" text="(うぁ‥‥ダメ‥‥‥溢れてきちゃう)"
		   voices="miho01720"/>
		<msg @l="1659" char_id="-1" frame_id="-1" name="" text="ぐちゅっ。" voices=""/>
		<msg @l="1660" char_id="-1" frame_id="-1" name="" text="アソコの奥から熱い液体が溢れてくる。"
		   voices=""/>
		<msg @l="1662" char_id="0" frame_id="-1" name="美帆" text="『やだ‥‥そこは‥‥‥。』"
		   voices="miho00410"/>
		<msg @l="1664" char_id="-1" frame_id="-1" name=""
		   text="幾ら頭で「嫌だ」と思っていても、止めることが出来ない。" voices=""/>
		<msg @l="1666" char_id="-1" frame_id="-1" name="痴漢"
		   text="『おや、これは汗かな、それとも淫汁かな‥‥下着が湿ってきているようだね？』" voices=""/>
		<msg @l="1668" char_id="0" frame_id="-1" name="美帆"
		   text="『いやぁ‥‥言わないでください‥‥‥‥。』" voices="miho01730"/>
		<msg @l="1670" char_id="-1" frame_id="-1" name=""
		   text="パンティの中には聖蜜の香りが充満し、溢れてくる蜜は露のように零れ落ちそうだ。" voices=""/>
		<msg @l="1672" char_id="-1" frame_id="-1" name="痴漢" text="『ハハッ、これは良い。』"
		   voices=""/>
		<msg @l="1674" char_id="-1" frame_id="-1" name="痴漢"
		   text="『見ず知らずの痴漢に秘部をいじくられて濡らしているとは、キミは大した変態だな。』" voices=""/>
		<msg @l="1676" char_id="0" frame_id="-1" name="美帆"
		   text="『うぅ‥‥そんな、違うんです‥‥‥‥。』" voices="miho01740"/>
		<msg @l="1678" char_id="-1" frame_id="-1" name="痴漢"
		   text="『何をいまさら。痴漢されて下着を濡らしているようでは説得力がないな。』" voices=""/>
		<msg @l="1680" char_id="-1" frame_id="-1" name="痴漢"
		   text="『公衆の面前でこれだけ濡らしていれば世話はない。』" voices=""/>
		<msg @l="1682" char_id="-1" frame_id="-1" name=""
		   text="そうして痴漢は人差し指で下着を持ち上げ、中へ指を差し込んでくる。" voices=""/>
		<msg @l="1683" char_id="-1" frame_id="-1" name="" text="くちゅ、くちゅ。" voices=""/>
		<msg @l="1685" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥ゃぁ‥‥。』"
		   voices="miho00740"/>
		<msg @l="1687" char_id="-1" frame_id="-1" name=""
		   text="下着の中に入った指で触れた私のそこは‥‥ますます溢れ出した蜜が熱く滴っていた。" voices=""/>
		<msg @l="1688" char_id="-1" frame_id="-1" name=""
		   text="痴漢は下着の中に指を入れただけでは満足せず、２本の指で秘部の肉路を直接欲望のままに揉んでまさぐってきた。" voices=""/>
		<msg @l="1690" char_id="-1" frame_id="-1" name="痴漢"
		   text="『キミにはマゾの素質があると思っていたが、まさかこれほどの淫乱だとは思ってもみなかったな。』" voices=""/>
		<msg @l="1692" char_id="0" frame_id="-1" name="美帆"
		   text="『いっ‥‥淫乱だなんて‥‥‥‥‥んんっ！』" voices="miho01750"/>
		<msg @l="1694" char_id="-1" frame_id="-1" name=""
		   text="否定の言葉をつむごうとした瞬間、下着の中に入っている痴漢の指が陰唇を開き、粘膜の広がる肉路へ第１関節まで差し込んできた。"
		   voices=""/>
		<msg @l="1695" char_id="-1" frame_id="-1" name="" text="ぐちゅっ。" voices=""/>
		<msg @l="1697" char_id="0" frame_id="-1" name="美帆" text="『んっっ！』"
		   voices="miho00450"/>
		<msg @l="1699" char_id="-1" frame_id="-1" name=""
		   text="私は差し込まれた指の感触だけで言葉を失い‥‥脱力してしまう。" voices=""/>
		<msg @l="1701" char_id="-1" frame_id="-1" name="痴漢"
		   text="『いまさら否定など無意味だと思うがね。』" voices=""/>
		<msg @l="1703" char_id="-1" frame_id="-1" name=""
		   text="そうして低く笑うと、痴漢は更に秘裂の中に入れた指を動かして蜜壁の感触を味わうようにいじくり回す。" voices=""/>
		<msg @l="1704" char_id="-1" frame_id="-1" name="" text="ぐちゅっ、ぐちゅっ。"
		   voices=""/>
		<msg @l="1706" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥ぁっ‥‥。』"
		   voices="miho00840"/>
		<msg @l="1708" char_id="-1" frame_id="-1" name=""
		   text="そうすると汗とも違う液体ともとれるものが秘孔からにじみ出してくる。" voices=""/>
		<msg @l="1709" char_id="-1" frame_id="-1" name=""
		   text="膣に差し込んでいない別の指先が女芯を執拗に爪弾きもてあそばれるたびに、抗う心とは裏腹に身体は熱く敏感になっていた。"
		   voices=""/>
		<msg @l="1711" char_id="0" frame_id="-1" name="美帆" text="『んんっ‥‥。』"
		   voices="miho01760"/>
		<msg @l="1713" char_id="-1" frame_id="-1" name="痴漢"
		   text="『どうした？&#32;私の指がそんなに気持ち良いかね？』" voices=""/>
		<msg @l="1715" char_id="-1" frame_id="-1" name=""
		   text="花びらの内側をなぞり上げる指はすべての蜜を掻き混ぜるように弄り尽くす。" voices=""/>
		<msg @l="1717" char_id="0" frame_id="-1" name="美帆" text="『ち、ちが‥‥‥んぁぁっ！』"
		   voices="miho01770"/>
		<msg @l="1719" char_id="-1" frame_id="-1" name="" text="ぐちゅぅぅ。" voices=""/>
		<msg @l="1720" char_id="-1" frame_id="-1" name=""
		   text="突然、第一間接まで入れられていた指が第２間接まで突っ込まれる。" voices=""/>
		<msg @l="1722" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥ぅぁ‥‥。』"
		   voices="miho00430"/>
		<msg @l="1724" char_id="-1" frame_id="-1" name=""
		   text="その瞬間痛みとも痺れともつかない「何か」が下腹部の辺りでじーんと広がる。" voices=""/>
		<msg @l="1725" char_id="0" frame_id="-1" name="美帆"
		   text="(こんなの‥‥ダメ‥‥‥‥‥何も‥‥‥考えられなくなる‥‥‥)" voices="miho01780"/>
		<msg @l="1726" char_id="-1" frame_id="-1" name="痴漢"
		   text="『感じるだろう、私の指がキミの蜜でぐちょぐちょだ。』" voices=""/>
		<msg @l="1728" char_id="-1" frame_id="-1" name="" text="ぐちゅっ、ぐちゅっ、ぐちゅっ。"
		   voices=""/>
		<msg @l="1729" char_id="-1" frame_id="-1" name=""
		   text="痴漢はそう言って、第２関節まで差し込んだ指で、秘門の中をかき回し、指の腹で蜜壁をなぞり上げてくる。" voices=""/>
		<msg @l="1730" char_id="-1" frame_id="-1" name=""
		   text="そうすると差し込まれた指に絡みつくように粘っこい花液があふれ出してきた。" voices=""/>
		<msg @l="1731" char_id="0" frame_id="-1" name="美帆" text="『んふっ‥‥‥んっ‥‥‥‥‥。』"
		   voices="miho05110"/>
		<msg @l="1733" char_id="-1" frame_id="-1" name="痴漢"
		   text="『これがキミの本性だよ。キミは見ず知らずの痴漢にいじくられてアソコをドロドロに濡らしてしまう淫乱女だったのだ。』" voices=""/>
		<msg @l="1735" char_id="0" frame_id="-1" name="美帆"
		   text="『はぁっ、はぁ‥‥‥んんっ‥‥‥‥んぁぁ‥‥‥‥。』" voices="miho01790"/>
		<msg @l="1737" char_id="-1" frame_id="-1" name=""
		   text="もう、私の口からは否定の言葉さえも発せないほど体が熱くなり何も考えられなくなる。" voices=""/>
		<msg @l="1739" char_id="0" frame_id="-1" name="美帆" text="『ん、んんっ‥‥‥んぁぁっ。』"
		   voices="miho10940"/>
		<msg @l="1741" char_id="-1" frame_id="-1" name=""
		   text="カラカラに乾いた喉をゴクリと鳴らし、息を吐く。" voices=""/>
		<msg @l="1742" char_id="-1" frame_id="-1" name=""
		   text="ただ下腹部の痺れに身を任せて‥‥熱い呼吸を繰り返していた。" voices=""/>
		<msg @l="1743" char_id="-1" frame_id="-1" name=""
		   text="いまや全く抵抗しなくなった私を、痴漢は欲望の赴くままに凌辱する。" voices=""/>
		<msg @l="1745" char_id="-1" frame_id="-1" name="痴漢"
		   text="『そら、このまま昇りつめてしまうといい。』" voices=""/>
		<msg @l="1747" char_id="-1" frame_id="-1" name="痴漢"
		   text="『大勢に囲まれた車内ではしたなく達するのが、淫乱のキミには何よりもお似合いだ。』" voices=""/>
		<msg @l="1749" char_id="-1" frame_id="-1" name=""
		   text="そうして、痴漢の指先が小さな芯を強く捻りあげ、糸をひくほどに湧水が粘りついた蜜壁の天井部分を指の腹で撫で上げられた瞬間―――。"
		   voices=""/>
		<msg @l="1750" char_id="-1" frame_id="-1" name="" text="何かが私の中ではじけた。"
		   voices=""/>
		<msg @l="1752" char_id="0" frame_id="-1" name="美帆" text="『んんっっっっ！！』"
		   voices="miho01800"/>
		<flash @l="1755" count="4" fade="100" image="white"/>
		<msg @l="1757" char_id="-1" frame_id="-1" name=""
		   text="子宮の辺りが熱くなり、目の前が真っ白になった。" voices=""/>
		<msg @l="1758" char_id="-1" frame_id="-1" name=""
		   text="自分では止められないほどに腰が跳ね上がり、痛みに似た鋭い感覚が背骨を抜け、アソコからは大量の蜜が止め処なく溢れ出てくる。"
		   voices=""/>
		<clear @l="1764" class="all"/>
		<msg @l="1766" char_id="-1" frame_id="-1" name="痴漢" text="『くく、見事な達し方だったぞ。』"
		   voices=""/>
		<msg @l="1768" char_id="-1" frame_id="-1" name="" text="私の耳元で痴漢がいやらしく笑う。"
		   voices=""/>
		<msg @l="1770" char_id="-1" frame_id="-1" name="痴漢"
		   text="『これからも、私がこの町にふさわしいように調教してやる───。』" voices=""/>
		<msg @l="1771" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥ぁぁ‥‥。』"
		   voices="miho01810"/>
		<msg @l="1773" char_id="-1" frame_id="-1" name="" text="立っていられない‥‥。"
		   voices=""/>
		<msg @l="1774" char_id="-1" frame_id="-1" name=""
		   text="そう思った瞬間、私は痴漢に身体を預けるように倒れこみ、遠ざかる意識の中で、痴漢の声をぼんやりと聞いていた‥‥‥。" voices=""/>
		<msg @l="1775" char_id="-1" frame_id="-1" name=""
		   text="最後に覚えているのは朽木教授の歪んだ笑顔だった‥‥‥。" voices=""/>
		<stopse @l="1779" buf="3"/>
		<stopbgm @l="1783" fadeout="1000"/>
		<clear @l="1789" class="all"/>
		<end_scene @l="1792"/>
		<msgshow @l="1795" show="true"/>
		<call @l="1799" target="EventLabel_39@ending01"/>
		<return @l="1800" value="0&#13;&#10;"/>
		<label @l="1802" id="TempLabel_189"/>
		<label @l="1808" id="EventLabel_28"/>
		<clear @l="1815" class="all"/>
		<msgshow @l="1817" show="true"/>
		<goto @l="1820" cond="!(f.訴えるflag&#32;==&#32;1)&#13;&#10;"
		   label="TempLabel_190"/>
		<se @l="1825" buf="1" src="チャイム" volume="1."/>
		<wait_chgmv/>
		<bg @l="1829" src="bg08m2"/>
		<bgm @l="1833" src="bgm04" volume="1."/>
		<msg @l="1835" char_id="-1" frame_id="-1" name=""
		   text="二限目終了のチャイムが鳴り教壇に立っていた講師が立ち去ると、静かだった講堂がにわかに騒がしくなる。" voices=""/>
		<msg @l="1836" char_id="-1" frame_id="-1" name=""
		   text="これから昼休みだという事もあってか、皆の表情は明るい。" voices=""/>
		<msg @l="1838" char_id="0" frame_id="-1" name="美帆" text="『‥‥はぁ。』" voices=""/>
		<msg @l="1840" char_id="-1" frame_id="-1" name=""
		   text="私は、講義の為にノートに視線を落として微かにため息をつく。" voices=""/>
		<msg @l="1841" char_id="-1" frame_id="-1" name=""
		   text="開いたノートには殆ど文字は書いていない。" voices=""/>
		<msg @l="1842" char_id="-1" frame_id="-1" name=""
		   text="ただ文字とも絵とも取れない意味不明な落書きが、幾つかあるだけ。" voices=""/>
		<msg @l="1844" char_id="0" frame_id="-1" name="美帆" text="(全然‥‥講義に集中出来なかったな)"
		   voices=""/>
		<msg @l="1846" char_id="-1" frame_id="-1" name=""
		   text="講義の時間中ずっと、今朝の一件が脳裏にちらついていた。" voices=""/>
		<msg @l="1847" char_id="-1" frame_id="-1" name=""
		   text="尊敬していた朽木教授が連日の痴漢の犯人だったなんて、今でも信じられない。" voices=""/>
		<msg @l="1849" char_id="0" frame_id="-1" name="美帆"
		   text="(でも、私は教授を告訴することにした‥‥)" voices=""/>
		<msg @l="1851" char_id="0" frame_id="-1" name="美帆" text="(ほんとに‥‥あれで良かったのかな)"
		   voices=""/>
		<msg @l="1853" char_id="-1" frame_id="-1" name=""
		   text="自分の下した判断に自信が持てない‥‥私の悪い癖だ。" voices=""/>
		<msg @l="1854" char_id="-1" frame_id="-1" name="" text="教授は罪を犯した、だから罪を問われる。"
		   voices=""/>
		<msg @l="1855" char_id="-1" frame_id="-1" name=""
		   text="朽木教授は社会的な傷を負うかも知れないけれど、私が告訴する事で罪を悔いて反省してくれれば、彼が更なる罪を重ねる事もないし次の被害者が出る事もない。"
		   voices=""/>
		<msg @l="1856" char_id="-1" frame_id="-1" name="" text="私の判断は、間違っていないと思う。"
		   voices=""/>
		<msg @l="1857" char_id="-1" frame_id="-1" name=""
		   text="なのに‥‥どうしても言い知れない不安が残る‥‥。" voices=""/>
		<msg @l="1859" char_id="0" frame_id="-1" name="美帆"
		   text="(‥‥‥私が心配性なだけ‥‥なのかな‥‥‥‥)" voices=""/>
		<msg @l="1861" char_id="-1" frame_id="-1" name="男の子" text="『よぉ‥‥あんた、仲根さん？』"
		   voices=""/>
		<char @l="1865" id="miho" pos="auto" src="miho014"/>
		<msg @l="1867" char_id="0" frame_id="-1" name="美帆" text="『え‥‥あ、そうですけど。』"
		   voices=""/>
		<msg @l="1869" char_id="-1" frame_id="-1" name="男の子"
		   text="『廊下んところで教授が呼んでるぜ。』" voices=""/>
		<char @l="1872" id="miho" pos="auto" src="miho010"/>
		<msg @l="1874" char_id="0" frame_id="-1" name="美帆"
		   text="『教授？&#32;あ、はい‥‥ありがとうございます。』" voices=""/>
		<clear @l="1878" class="char"/>
		<msg @l="1880" char_id="-1" frame_id="-1" name=""
		   text="そうして私は男の子にペコリと頭を下げると、慌てて広げていたノートをカバンに押し込んで廊下に出る。" voices=""/>
		<stopbgm @l="1884" fadeout="1000"/>
		<wait_chgmv/>
		<bg @l="1888" src="bg09"/>
		<bgm @l="1892" src="bgm02" volume="1."/>
		<msg @l="1894" char_id="-1" frame_id="-1" name="学生Ａ" text="『昼メシ、どーするー？』"
		   voices=""/>
		<msg @l="1896" char_id="-1" frame_id="-1" name="学生Ｂ" text="『俺、牛丼屋行くけど？』"
		   voices=""/>
		<msg @l="1898" char_id="-1" frame_id="-1" name="学生Ｃ"
		   text="『この時間じゃ、角のコンビニ全滅っぽいしなぁ。』" voices=""/>
		<char @l="1902" id="miho" pos="auto" src="miho010"/>
		<msg @l="1904" char_id="-1" frame_id="-1" name=""
		   text="午前の授業が終了した事もあって、廊下は騒然としている。" voices=""/>
		<msg @l="1905" char_id="-1" frame_id="-1" name=""
		   text="そんな中、私はキョロキョロと視線を泳がせて「教授」の姿を探す。" voices=""/>
		<msg @l="1906" char_id="-1" frame_id="-1" name="" text="どの教授だろう？" voices=""/>
		<msg @l="1907" char_id="-1" frame_id="-1" name=""
		   text="やがて私の視線は、廊下の壁際に佇んでいるスーツの背中を見つけた。" voices=""/>
		<msg @l="1909" char_id="0" frame_id="-1" name="美帆"
		   text="『あの‥‥呼ばれてるって聞いたんですけど。』" voices=""/>
		<msg @l="1911" char_id="-1" frame_id="-1" name="教授" text="『おお。待っていたよ。』"
		   voices=""/>
		<msg @l="1913" char_id="-1" frame_id="-1" name=""
		   text="そうして振り返った人の顔を見た私は、思わず驚きの声を上げてしまう。" voices=""/>
		<clear @l="1916" class="char"/>
		<char @l="1918" id="miho" pos="left" src="miho014"/>
		<char @l="1921" id="kutsu" pos="right" src="kutsu010"/>
		<bgm @l="1925" src="bgm03" volume="1."/>
		<msg @l="1927" char_id="0" frame_id="-1" name="美帆" text="『朽木教授！』" voices=""/>
		<msg @l="1929" char_id="-1" frame_id="-1" name="朽木"
		   text="『おやおや、露骨に嫌そうな表情をしないで貰いたいな。』" voices=""/>
		<msg @l="1931" char_id="-1" frame_id="-1" name="朽木"
		   text="『私は一度、キミとちゃんと話をしたいと思ってね。』" voices=""/>
		<char @l="1935" id="miho" pos="left" src="miho115"/>
		<msg @l="1937" char_id="0" frame_id="-1" name="美帆"
		   text="『お話することなんて‥‥無いと思いますけど。』" voices=""/>
		<msg @l="1939" char_id="-1" frame_id="-1" name="朽木"
		   text="『そう無下にしないでくれたまえ。私だって反省しているのだよ？』" voices=""/>
		<msg @l="1941" char_id="0" frame_id="-1" name="美帆"
		   text="『‥‥だから告訴について考え直せとおっしゃるんですか？』" voices=""/>
		<msg @l="1943" char_id="-1" frame_id="-1" name="朽木"
		   text="『言葉が刺々しいな。私は話がしたいと言っただけだよ？』" voices=""/>
		<msg @l="1945" char_id="0" frame_id="-1" name="美帆"
		   text="『このタイミングで話をされたいだなんて、どう考えてもそういった内容だとしか思えません。』" voices=""/>
		<msg @l="1947" char_id="-1" frame_id="-1" name="朽木"
		   text="『参ったな、そうかたくなになられてしまうと話し合いにならない。』" voices=""/>
		<char @l="1950" id="miho" pos="left" src="miho015"/>
		<msg @l="1952" char_id="0" frame_id="-1" name="美帆"
		   text="『私は話し合いで解決する問題だと思っていません。』" voices=""/>
		<msg @l="1954" char_id="0" frame_id="-1" name="美帆"
		   text="『だから‥‥告訴することにしたんです。』" voices=""/>
		<msg @l="1956" char_id="-1" frame_id="-1" name=""
		   text="私は半ば自分に言い聞かせるように、そうつぶやいた。" voices=""/>
		<msg @l="1958" char_id="-1" frame_id="-1" name="朽木"
		   text="『なるほど、随分と嫌われたものだな‥‥では話を変えようか。』" voices=""/>
		<char @l="1962" id="miho" pos="left" src="miho115"/>
		<msg @l="1964" char_id="0" frame_id="-1" name="美帆" text="『‥‥？』" voices=""/>
		<msg @l="1966" char_id="-1" frame_id="-1" name="朽木"
		   text="『キミの父親‥‥確か仲根啓三氏と言ったね。実は、良くない噂を聞いてね。』" voices=""/>
		<bgm @l="1969" src="bgm15" volume="1."/>
		<char @l="1973" id="miho" pos="left" src="miho015"/>
		<msg @l="1975" char_id="0" frame_id="-1" name="美帆"
		   text="『お父さ‥‥‥ち、父がどうしたって言うんですか？』" voices=""/>
		<msg @l="1977" char_id="-1" frame_id="-1" name="朽木"
		   text="『おや、話し合いをする気は無かったのではないのかね？』" voices=""/>
		<msg @l="1979" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<char @l="1982" id="kutsu" pos="right" src="kutsu018"/>
		<msg @l="1984" char_id="-1" frame_id="-1" name="朽木"
		   text="『悔しそうな表情も良いな、キミは。』" voices=""/>
		<msg @l="1986" char_id="0" frame_id="-1" name="美帆" text="『変なこと言わないでくださいっ。』"
		   voices=""/>
		<char @l="1989" id="kutsu" pos="right" src="kutsu010"/>
		<msg @l="1991" char_id="-1" frame_id="-1" name="朽木" text="『おっと‥‥これは失敬。』"
		   voices=""/>
		<msg @l="1993" char_id="-1" frame_id="-1" name="朽木"
		   text="『どうだね、少しは話しを聞く気になったかな？』" voices=""/>
		<char @l="1997" id="miho" pos="left" src="miho115"/>
		<msg @l="1999" char_id="0" frame_id="-1" name="美帆" text="『‥‥そ、それは。』"
		   voices=""/>
		<msg @l="2001" char_id="-1" frame_id="-1" name="朽木"
		   text="『まあ、身内とはいえ所詮は男親だ。』" voices=""/>
		<msg @l="2003" char_id="-1" frame_id="-1" name="朽木"
		   text="『年頃の娘にとってはどうでもいい存在、というわけかな？』" voices=""/>
		<char @l="2006" id="miho" pos="left" src="miho015"/>
		<msg @l="2008" char_id="0" frame_id="-1" name="美帆"
		   text="『そんなことっ‥‥‥‥私にとってお父さんは‥‥かけがいのない肉親です。大切なんです‥‥。だから、そんなことはおっしゃらないで下さい‥‥。』"
		   voices=""/>
		<msg @l="2010" char_id="0" frame_id="-1" name="美帆"
		   text="『‥‥わかりました、お話を伺います。』" voices=""/>
		<char @l="2013" id="kutsu" pos="right" src="kutsu018"/>
		<msg @l="2015" char_id="-1" frame_id="-1" name="朽木"
		   text="『よろしい、それではついてきたまえ。』" voices=""/>
		<clear @l="2019" class="char"/>
		<char @l="2021" id="miho" pos="auto" src="miho115"/>
		<msg @l="2023" char_id="-1" frame_id="-1" name=""
		   text="そうして、朽木教授は先導するようにスタスタと歩いて行く。" voices=""/>
		<msg @l="2024" char_id="-1" frame_id="-1" name=""
		   text="向かっている方向には教授の研究室があるから‥‥目的地はそこだろう。" voices=""/>
		<msg @l="2026" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="2028" char_id="0" frame_id="-1" name="美帆" text="(‥‥お父さん‥‥‥)"
		   voices=""/>
		<clear @l="2032" class="char"/>
		<msg @l="2034" char_id="-1" frame_id="-1" name=""
		   text="私は先を歩く朽木教授の背中を追いかけながら、南総町キャンパスに来てから一度も会っていない父の姿をぼんやりと思い返していた。"
		   voices=""/>
		<clear @l="2040" class="all"/>
		<msg @l="2042" char_id="-1" frame_id="-1" name="朽木" text="『遠慮なく入りたまえ。』"
		   voices=""/>
		<msg @l="2044" char_id="0" frame_id="-1" name="美帆" text="『‥‥はい。』" voices=""/>
		<wait_chgmv/>
		<bg @l="2048" src="bg12"/>
		<description @l="2051" text="断罪の代償"/>
		<msg @l="2053" char_id="-1" frame_id="-1" name=""
		   text="朽木教授が普段常駐している教授室へと通される。" voices=""/>
		<msg @l="2054" char_id="-1" frame_id="-1" name=""
		   text="教室とは一風違った、豪華な内装の部屋だ。" voices=""/>
		<char @l="2058" id="kutsu" pos="auto" src="kutsu010"/>
		<msg @l="2060" char_id="-1" frame_id="-1" name="朽木"
		   text="『とりあえず座りたまえ、コーヒーでも淹れようか。』" voices=""/>
		<clear @l="2063" class="char"/>
		<char @l="2065" id="kutsu" pos="right" src="kutsu010"/>
		<char @l="2068" id="miho" pos="left" src="miho115"/>
		<msg @l="2070" char_id="0" frame_id="-1" name="美帆" text="『いえ‥‥お構いなく。』"
		   voices=""/>
		<char @l="2073" id="miho" pos="left" src="miho015"/>
		<msg @l="2075" char_id="0" frame_id="-1" name="美帆"
		   text="『それより、父の良くない噂って何なんですか？』" voices=""/>
		<msg @l="2077" char_id="-1" frame_id="-1" name="朽木"
		   text="『キミは意外とせっかちだなぁ‥‥物事には順序というものがある。』" voices=""/>
		<msg @l="2079" char_id="-1" frame_id="-1" name="朽木"
		   text="『君の父親の話をする前に、別の問題から解決させてもらおうか。』" voices=""/>
		<msg @l="2081" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="2083" char_id="0" frame_id="-1" name="美帆" text="『告訴の‥‥ことですよね？』"
		   voices=""/>
		<char @l="2086" id="kutsu" pos="right" src="kutsu018"/>
		<msg @l="2088" char_id="-1" frame_id="-1" name="朽木" text="『それ以外に何かあるかね？』"
		   voices=""/>
		<msg @l="2090" char_id="-1" frame_id="-1" name=""
		   text="おどけたようにそう言って、朽木教授はいやらしい笑みを浮かべて見せる。" voices=""/>
		<msg @l="2091" char_id="-1" frame_id="-1" name=""
		   text="いや‥‥今の私には、そう見えてしまうだけなのかもしれない。" voices=""/>
		<char @l="2094" id="kutsu" pos="right" src="kutsu010"/>
		<msg @l="2096" char_id="-1" frame_id="-1" name="朽木"
		   text="『解っているとは思うが‥‥告訴というのは色々と面倒なのだよ。』" voices=""/>
		<msg @l="2098" char_id="-1" frame_id="-1" name="朽木"
		   text="『時間と手間を求められる割にそこから得られる最大の結果は、私の罪を立証するというだけに過ぎない。』" voices=""/>
		<msg @l="2100" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="2102" char_id="-1" frame_id="-1" name="朽木"
		   text="『私はね、そんなくだらないことの為にキミの貴重な時間を浪費して欲しくは無いのだよ。』" voices=""/>
		<msg @l="2104" char_id="-1" frame_id="-1" name="朽木"
		   text="『反省ならしている。もう二度と痴漢行為などしないと約束しよう。』" voices=""/>
		<msg @l="2106" char_id="0" frame_id="-1" name="美帆"
		   text="『私が‥‥その言葉を信用すると思っているんですか？』" voices=""/>
		<msg @l="2108" char_id="-1" frame_id="-1" name="朽木" text="『信用してくれなくては困るな。』"
		   voices=""/>
		<msg @l="2110" char_id="-1" frame_id="-1" name="朽木"
		   text="『そうでないと、私も余計な手を回さなければならなくなるのでね。』" voices=""/>
		<msg @l="2112" char_id="0" frame_id="-1" name="美帆" text="『‥‥どういう意味でしょうか？』"
		   voices=""/>
		<msg @l="2114" char_id="-1" frame_id="-1" name="朽木"
		   text="『さてね。それよりもキミの答えを聞かせてもらおうか。』" voices=""/>
		<msg @l="2116" char_id="0" frame_id="-1" name="美帆" text="『私は‥‥。』" voices=""/>
		<char @l="2119" id="miho" pos="left" src="miho115"/>
		<msg @l="2121" char_id="0" frame_id="-1" name="美帆"
		   text="『私は、考え直したりなんかしません。』" voices=""/>
		<msg @l="2123" char_id="-1" frame_id="-1" name="朽木" text="『ほう？』" voices=""/>
		<msg @l="2125" char_id="0" frame_id="-1" name="美帆"
		   text="『第一、教授の言葉には誠意が感じられません‥‥。』" voices=""/>
		<msg @l="2127" char_id="0" frame_id="-1" name="美帆"
		   text="『そんな軽々しくおっしゃられる約束なんて‥‥信じられません。』" voices=""/>
		<msg @l="2129" char_id="-1" frame_id="-1" name="朽木"
		   text="『なるほど。そこまでかたくなになられてしまっては仕方がないな。』" voices=""/>
		<msg @l="2131" char_id="-1" frame_id="-1" name="朽木"
		   text="『では、この話はいったん保留にして、君の父親の話をしようか。』" voices=""/>
		<msg @l="2133" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="2135" char_id="-1" frame_id="-1" name="朽木"
		   text="『仲根クン、父親の勤めている大黒製薬という会社がこの大学の薬学部へ研究依頼をしているという話は知っているかね？』" voices=""/>
		<char @l="2138" id="miho" pos="left" src="miho114"/>
		<msg @l="2140" char_id="0" frame_id="-1" name="美帆"
		   text="『え、そうなんですか‥‥知りませんでした。』" voices=""/>
		<msg @l="2142" char_id="-1" frame_id="-1" name="朽木"
		   text="『ほう、それではその研究依頼の総括をしているのが父親であるということも当然知らないわけだな。』" voices=""/>
		<char @l="2145" id="miho" pos="left" src="miho115"/>
		<msg @l="2147" char_id="0" frame_id="-1" name="美帆" text="『‥‥はい。』" voices=""/>
		<msg @l="2149" char_id="-1" frame_id="-1" name="朽木"
		   text="『彼の勤めている会社は経営が難しい状態にあってねぇ、近々、大々的な雇用カットが行われるらしいのだよ。』" voices=""/>
		<bgm @l="2153" src="bgm09" volume="1."/>
		<char @l="2157" id="miho" pos="left" src="miho114"/>
		<msg @l="2159" char_id="0" frame_id="-1" name="美帆"
		   text="『雇用カットって‥‥‥つまり、リストラってことですか？』" voices=""/>
		<msg @l="2161" char_id="-1" frame_id="-1" name="朽木"
		   text="『まあ、有体に言えばそうなるかな。』" voices=""/>
		<msg @l="2163" char_id="-1" frame_id="-1" name="朽木"
		   text="『そして雇用カットの対象としてあげられているのが、各研究施設の管理職たちなのだそうだ。』" voices=""/>
		<char @l="2166" id="miho" pos="left" src="miho115"/>
		<msg @l="2168" char_id="0" frame_id="-1" name="美帆" text="『そんなっ‥‥。』"
		   voices=""/>
		<msg @l="2170" char_id="0" frame_id="-1" name="美帆"
		   text="『それじゃあ父は、リストラ候補ってことですか！？』" voices=""/>
		<msg @l="2172" char_id="-1" frame_id="-1" name="朽木"
		   text="『候補ではない、決まっている。直接人事の人間から聞いたからな。』" voices=""/>
		<msg @l="2174" char_id="-1" frame_id="-1" name="朽木"
		   text="『お父さんも随分高齢のようだからな、ここでリストラなどという事になったら再就職は困難だろうな。』" voices=""/>
		<msg @l="2176" char_id="-1" frame_id="-1" name="朽木"
		   text="『まして研究職など、絶望的に違いない。』" voices=""/>
		<msg @l="2178" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="2180" char_id="-1" frame_id="-1" name="朽木" text="『まあ、そう落胆しなくても良い。』"
		   voices=""/>
		<msg @l="2182" char_id="-1" frame_id="-1" name="朽木"
		   text="『実は薬学部の方にちょっとしたコネがあってね、そちらの研究室にある椅子を一つ増やしてもらうことくらい‥‥そう難しい事ではないのだよ。』"
		   voices=""/>
		<msg @l="2184" char_id="0" frame_id="-1" name="美帆"
		   text="『それってつまり、父の再就職を斡旋してくださるという事ですか？』" voices=""/>
		<msg @l="2186" char_id="-1" frame_id="-1" name="朽木" text="『まあ、似たようなものだ。』"
		   voices=""/>
		<msg @l="2188" char_id="0" frame_id="-1" name="美帆"
		   text="『それで‥‥父の再就職を斡旋する代わりに、という事ですか。』" voices=""/>
		<msg @l="2190" char_id="-1" frame_id="-1" name="朽木" text="『残念ながらそれは違うな。』"
		   voices=""/>
		<char @l="2194" id="miho" pos="left" src="miho114"/>
		<msg @l="2196" char_id="0" frame_id="-1" name="美帆" text="『え‥‥？』" voices=""/>
		<msg @l="2198" char_id="-1" frame_id="-1" name="朽木"
		   text="『どちらを選ぶかは君次第だよ。もちろん、告訴したければするといい。』" voices=""/>
		<msg @l="2200" char_id="-1" frame_id="-1" name="朽木" text="『私は逃げも隠れもせんよ。』"
		   voices=""/>
		<msg @l="2202" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="2204" char_id="-1" frame_id="-1" name="朽木"
		   text="『裁判というのはそう簡単に結審するものではないのだよ。』" voices=""/>
		<msg @l="2206" char_id="-1" frame_id="-1" name="朽木"
		   text="『特に痴漢などという犯人の特定と証拠の提示が困難な場合は、そもそも告訴が受理されない事もある。もし受理されたとして裁判になっても、困るのはむしろ仲根クンのほうだよ。』"
		   voices=""/>
		<char @l="2209" id="miho" pos="left" src="miho115"/>
		<msg @l="2211" char_id="0" frame_id="-1" name="美帆"
		   text="『で、でたらめを言わないでください‥‥。』" voices=""/>
		<char @l="2214" id="kutsu" pos="right" src="kutsu018"/>
		<msg @l="2216" char_id="-1" frame_id="-1" name="朽木"
		   text="『でたらめかどうかは、実際に裁判になれば分かる。ふふふ‥‥君は裁判というものが分かっていないのだよ。裁判になったら何を聞かれると思う？』"
		   voices=""/>
		<char @l="2219" id="miho" pos="left" src="miho114"/>
		<msg @l="2221" char_id="0" frame_id="-1" name="美帆" text="『え‥‥？』" voices=""/>
		<msg @l="2223" char_id="-1" frame_id="-1" name="朽木"
		   text="『君は電車の中でどう痴漢されたのか？胸を何回もまれたのか？乳首をつままれたのか？お尻をもまれたのか？パンツごしに指で陰部を‥‥。』"
		   voices=""/>
		<char @l="2226" id="miho" pos="left" src="miho115"/>
		<msg @l="2228" char_id="0" frame_id="-1" name="美帆" text="『も、もう、やめてください！！』"
		   voices=""/>
		<msg @l="2230" char_id="-1" frame_id="-1" name="朽木"
		   text="『ふふふ、そうやって多くの傍聴者の前で恥ずかしいことを聞かれている間に、君のお父さんが職を失い、キミの家族が路頭に迷うことになるかもしれんな。』"
		   voices=""/>
		<msg @l="2232" char_id="-1" frame_id="-1" name="朽木"
		   text="『裁判が終わった頃、大切なものを全て無くなっていることに絶望するといい。』" voices=""/>
		<msg @l="2234" char_id="0" frame_id="-1" name="美帆" text="『そんなこと‥‥嘘ですっ。』"
		   voices=""/>
		<msg @l="2236" char_id="-1" frame_id="-1" name="朽木" text="『私に言っても無駄だよ。』"
		   voices=""/>
		<msg @l="2238" char_id="-1" frame_id="-1" name="朽木"
		   text="『キミが原因でこうなってしまったのだからね、仲根クン。』" voices=""/>
		<msg @l="2240" char_id="-1" frame_id="-1" name="朽木"
		   text="『余計な入れ知恵をされたからとはいえ、学生の分際で告訴などという不穏な言葉を振りかざしたキミのね。』" voices=""/>
		<msg @l="2242" char_id="0" frame_id="-1" name="美帆" text="『そんなっ‥‥。』"
		   voices=""/>
		<clear @l="2245" layer="kutsu"/>
		<char @l="2247" id="kutsu" pos="auto" src="kutsu010"/>
		<msg @l="2249" char_id="-1" frame_id="-1" name="朽木"
		   text="『だが‥‥私とて無情な人間ではない。』" voices=""/>
		<msg @l="2251" char_id="-1" frame_id="-1" name="朽木"
		   text="『キミの態度次第ではお父さんを救ってあげようと言っているのだよ？』" voices=""/>
		<msg @l="2253" char_id="0" frame_id="-1" name="美帆" text="『ど、どういう事ですか‥‥？』"
		   voices=""/>
		<msg @l="2255" char_id="-1" frame_id="-1" name="朽木" text="『キミにも解っていると思うがね。』"
		   voices=""/>
		<msg @l="2257" char_id="-1" frame_id="-1" name=""
		   text="そうして朽木教授が私の傍らへと歩み寄ってくる。" voices=""/>
		<msg @l="2258" char_id="-1" frame_id="-1" name=""
		   text="私は思わず後退って距離を取ろうとするが、それよりも早く彼の腕が腰に回されて引き寄せられてしまう。" voices=""/>
		<stopbgm @l="2262" fadeout="1000"/>
		<clear @l="2265" class="char"/>
		<char @l="2268" id="miho" pos="center" src="miho014f" y="-80"/>
		<bgm @l="2272" src="bgm15" volume="1."/>
		<msg @l="2274" char_id="0" frame_id="-1" name="美帆" text="『きゃっ‥‥。』" voices=""/>
		<char @l="2277" id="miho" pos="center" src="miho015f" y="-80"/>
		<msg @l="2279" char_id="0" frame_id="-1" name="美帆" text="『は、離してください！』"
		   voices=""/>
		<msg @l="2281" char_id="-1" frame_id="-1" name="朽木" text="『おや‥‥抵抗しても良いのかな？』"
		   voices=""/>
		<msg @l="2283" char_id="-1" frame_id="-1" name="朽木"
		   text="『お父さんを救ってやりたいとは思わんのかね？』" voices=""/>
		<msg @l="2285" char_id="0" frame_id="-1" name="美帆" text="『‥‥！』" voices=""/>
		<begin_trans @l="2289" time="500"/>
		<layer @l="2290" id="cutin_f" src="game_window_cutin" x="20" y="20"
		   z="-1001"/>
		<layer @l="2291" id="cutin" src="cut001" x="32" y="32" z="-1000"/>
		<end_trans @l="2292"/>
		<msg @l="2294" char_id="-1" frame_id="-1" name=""
		   text="不敵な笑みと共に、朽木教授の手がスカートの中へ滑り込んでくる。" voices=""/>
		<msg @l="2295" char_id="-1" frame_id="-1" name=""
		   text="ねっとりと絡みつくような指先の動きは、紛れも無く連日の痴漢と同じだ。" voices=""/>
		<msg @l="2297" char_id="-1" frame_id="-1" name="朽木"
		   text="『どうだね、今度こそ私を告訴するチャンスではないかな？』" voices=""/>
		<msg @l="2299" char_id="-1" frame_id="-1" name="朽木"
		   text="『今なら告訴する為の決定的証拠を得られるのではないかね？』" voices=""/>
		<msg @l="2301" char_id="0" frame_id="-1" name="美帆" text="『こ、こんなの‥‥卑怯ですっ。』"
		   voices=""/>
		<msg @l="2303" char_id="-1" frame_id="-1" name="朽木"
		   text="『そう思うのならば父親を見捨てればよかろう。』" voices=""/>
		<msg @l="2305" char_id="-1" frame_id="-1" name="朽木"
		   text="『もっとも、見捨てれば絶望してどんな行動に出てしまうことやらなあ。』" voices=""/>
		<char @l="2308" id="miho" pos="center" src="miho115f" y="-80"/>
		<msg @l="2310" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥っ‥‥。』"
		   voices=""/>
		<msg @l="2312" char_id="-1" frame_id="-1" name=""
		   text="朽木教授の言葉は私の抵抗心を奪うのに十分だった。" voices=""/>
		<msg @l="2313" char_id="-1" frame_id="-1" name=""
		   text="仕事が生き甲斐のような真面目な父がリストラされ、再就職先さえも見付からなかったら‥‥それは社会から不要宣告されたのと同じようなものだ。"
		   voices=""/>
		<msg @l="2314" char_id="-1" frame_id="-1" name="" text="そうなれば父はどうなってしまうだろう。"
		   voices=""/>
		<msg @l="2315" char_id="-1" frame_id="-1" name=""
		   text="家族の為に、どんな希望も叶えてくれたあの優しいお父さんが、落胆し生きる気力を無くす姿は見たくない‥‥。" voices=""/>
		<msg @l="2316" char_id="-1" frame_id="-1" name=""
		   text="私一人の為にみんなを不幸にするわけにはいかない‥‥。" voices=""/>
		<msg @l="2318" char_id="0" frame_id="-1" name="美帆" text="(こんなの‥‥嫌だけど‥‥‥)"
		   voices=""/>
		<msg @l="2320" char_id="-1" frame_id="-1" name=""
		   text="自分が言いなりになれば、父が、家族が救われる。" voices=""/>
		<msg @l="2321" char_id="-1" frame_id="-1" name=""
		   text="そう思うと‥‥何も言えなくなってしまった。" voices=""/>
		<char @l="2323" id="miho" pos="center" src="miho015f" y="-80"/>
		<msg @l="2324" char_id="-1" frame_id="-1" name="朽木"
		   text="『くくく、どうやら自分の立場というものが解ったようだな。』" voices=""/>
		<msg @l="2326" char_id="-1" frame_id="-1" name="朽木"
		   text="『そうして黙って震えているのがキミには一番お似合いだ。』" voices=""/>
		<begin_trans @l="2330" time="500"/>
		<layer @l="2331" id="cutin_f" src="game_window_cutin" x="20" y="20"
		   z="-1001"/>
		<layer @l="2332" id="cutin" src="cut001b" x="32" y="32" z="-1000"/>
		<end_trans @l="2333"/>
		<msg @l="2335" char_id="-1" frame_id="-1" name=""
		   text="朽木教授は片手で私の腰を引き寄せるようにし、もう片方の手で下着の上からアソコを擦りあげてくる。" voices=""/>
		<msg @l="2336" char_id="-1" frame_id="-1" name=""
		   text="電車内とは違い誰かに見られる危険は無いせいか、朽木教授は大胆にスカートを腰まで捲り上げ、指を使って薄い布越しの上から秘部を撫で回し、刺激を与えてくる。"
		   voices=""/>
		<msg @l="2338" char_id="0" frame_id="-1" name="美帆" text="『‥‥んんっ。』" voices=""/>
		<msg @l="2340" char_id="-1" frame_id="-1" name="朽木"
		   text="『おやおや、こんな状況で弄ばれて感じてしまっているのかな。』" voices=""/>
		<msg @l="2342" char_id="0" frame_id="-1" name="美帆" text="『そんな‥‥違いますっ。』"
		   voices=""/>
		<msg @l="2344" char_id="-1" frame_id="-1" name="朽木"
		   text="『ほう、そんな風に抗ってもよいのかね？』" voices=""/>
		<msg @l="2346" char_id="-1" frame_id="-1" name="" text="くにゅ、くにゅ。" voices=""/>
		<msg @l="2347" char_id="-1" frame_id="-1" name=""
		   text="秘部をまさぐっている指は秘部の割れ目を開くように蠢き、指で突起を強く捻り上げてくる。" voices=""/>
		<msg @l="2349" char_id="0" frame_id="-1" name="美帆" text="『ひっ‥‥。』" voices=""/>
		<msg @l="2351" char_id="0" frame_id="-1" name="美帆"
		   text="『か、感じています‥‥‥朽木教授の指で‥‥‥‥感じています‥‥‥。』" voices=""/>
		<msg @l="2353" char_id="-1" frame_id="-1" name="朽木" text="『ハハッ、それは良かった。』"
		   voices=""/>
		<msg @l="2355" char_id="-1" frame_id="-1" name="朽木"
		   text="『ならばもっと悦ばせてやらないとなぁ。』" voices=""/>
		<msg @l="2357" char_id="-1" frame_id="-1" name="" text="くりっ、くりっ。" voices=""/>
		<msg @l="2358" char_id="-1" frame_id="-1" name=""
		   text="摘み上げていた突起を指先で転がし、ぽってりとした柔肉を指の腹でいじりながら、教授は笑う。" voices=""/>
		<msg @l="2360" char_id="0" frame_id="-1" name="美帆" text="『んっ‥‥。』" voices=""/>
		<msg @l="2362" char_id="-1" frame_id="-1" name=""
		   text="抵抗の言葉さえも禁じられた私は、泣く泣く教授の指先にその身を任せ、無意識に溢れてしまう吐息を必死で飲み込んでいた。"
		   voices=""/>
		<msg @l="2363" char_id="-1" frame_id="-1" name=""
		   text="身体は許しても心までは許さない‥‥そんな悲しい思いを抱いて。" voices=""/>
		<msg @l="2365" char_id="0" frame_id="-1" name="美帆" text="『んんっ‥‥ん、はぁっ‥‥‥。』"
		   voices=""/>
		<msg @l="2367" char_id="-1" frame_id="-1" name="" text="くりっ、くりっ。" voices=""/>
		<msg @l="2368" char_id="-1" frame_id="-1" name=""
		   text="指先が下着の上から硬くなった突起をくすぐるたび、思わず漏れそうになる抵抗の言葉を懸命に押し殺す。" voices=""/>
		<msg @l="2370" char_id="0" frame_id="-1" name="美帆"
		   text="『いっ‥‥あ、んくっ‥‥‥んんんっ。』" voices=""/>
		<msg @l="2372" char_id="-1" frame_id="-1" name="" text="くにゅ、くにゅ、くにゅ。"
		   voices=""/>
		<msg @l="2373" char_id="-1" frame_id="-1" name=""
		   text="朽木教授は私の反応を楽しむかのように、秘部をいじくる指の動きを速める。" voices=""/>
		<msg @l="2374" char_id="-1" frame_id="-1" name=""
		   text="教授の指がアソコを擦り上げるたびに、私は反射的に身体をよじってその手から逃れようとしてしまう。" voices=""/>
		<msg @l="2376" char_id="-1" frame_id="-1" name="朽木"
		   text="『おや、これは抵抗と見なした方が良いのかな？』" voices=""/>
		<msg @l="2378" char_id="-1" frame_id="-1" name=""
		   text="私の耳元で囁くと、彼は楽しげに口元を歪めてみせる。" voices=""/>
		<msg @l="2380" char_id="0" frame_id="-1" name="美帆"
		   text="『ち、違います‥‥抵抗なんて‥‥‥‥。』" voices=""/>
		<msg @l="2382" char_id="-1" frame_id="-1" name="朽木" text="『そうだろうなぁ。』"
		   voices=""/>
		<msg @l="2384" char_id="-1" frame_id="-1" name="朽木"
		   text="『何せ、キミの抵抗が一家離散を決定付けるようなものだ。』" voices=""/>
		<msg @l="2386" char_id="-1" frame_id="-1" name="朽木" text="『抵抗など出来るハズがない。』"
		   voices=""/>
		<msg @l="2388" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="2390" char_id="-1" frame_id="-1" name=""
		   text="彼の言葉によって、私は少しずつ追い込まれていく。" voices=""/>
		<msg @l="2391" char_id="-1" frame_id="-1" name=""
		   text="それが解っていながら、私にはどうする事も出来ない。" voices=""/>
		<msg @l="2392" char_id="-1" frame_id="-1" name=""
		   text="ただ、無抵抗のまま彼に弄ばれる以外は‥‥。" voices=""/>
		<msg @l="2394" char_id="-1" frame_id="-1" name="朽木"
		   text="『そうだな。キミの意思を確認させてもらおうじゃないか。』" voices=""/>
		<msg @l="2396" char_id="0" frame_id="-1" name="美帆" text="『意思‥‥ですか？』"
		   voices=""/>
		<msg @l="2398" char_id="-1" frame_id="-1" name="朽木"
		   text="『幾ら言葉で抵抗しないと言ったところで、キミの身体は私から逃れようとしている。』" voices=""/>
		<msg @l="2400" char_id="-1" frame_id="-1" name="朽木"
		   text="『これでは信用が出来ないというものではないかね？』" voices=""/>
		<msg @l="2402" char_id="0" frame_id="-1" name="美帆"
		   text="『そ、それは‥‥‥でも‥‥どうすれば‥‥‥‥。』" voices=""/>
		<msg @l="2404" char_id="-1" frame_id="-1" name="朽木" text="『ふむ‥‥。』" voices=""/>
		<msg @l="2406" char_id="-1" frame_id="-1" name="朽木"
		   text="『では、キミには誓いの言葉をつむいでもらおうか。』" voices=""/>
		<msg @l="2408" char_id="0" frame_id="-1" name="美帆" text="『誓いの言葉‥‥？』"
		   voices=""/>
		<msg @l="2410" char_id="-1" frame_id="-1" name="朽木"
		   text="『そう。私とキミの契約を完了する為の誓いの言葉だ。』" voices=""/>
		<msg @l="2412" char_id="-1" frame_id="-1" name="朽木"
		   text="『それさえ守っていれば、私はお父さんを全面的にバックアップしようじゃないか。』" voices=""/>
		<msg @l="2414" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="2416" char_id="-1" frame_id="-1" name="朽木"
		   text="『どうだね？&#32;決して悪い話ではないと思うがなぁ。』" voices=""/>
		<msg @l="2418" char_id="-1" frame_id="-1" name=""
		   text="言葉と共に、朽木教授は口の端を邪悪に歪めながら、抵抗出来ない秘部をぐにぐにといじくったかと思うと、急にパンツの中に指を一本いれて直接秘部を触ってきた。"
		   voices=""/>
		<begin_trans @l="2421" time="500"/>
		<layer @l="2422" id="cutin_f" src="game_window_cutin" x="20" y="20"
		   z="-1001"/>
		<layer @l="2423" id="cutin" src="cut001a" x="32" y="32" z="-1000"/>
		<end_trans @l="2424"/>
		<msg @l="2425" char_id="-1" frame_id="-1" name="" text="くちゅっ。" voices=""/>
		<msg @l="2427" char_id="0" frame_id="-1" name="美帆" text="『ひっ‥‥！』" voices=""/>
		<msg @l="2429" char_id="-1" frame_id="-1" name=""
		   text="朽木教授は私の驚いた表情を見ると、まるで彼自身が父の命運全てを握っているような含みのある笑みを浮かべ、私は思わず寒気を感じてしまう。"
		   voices=""/>
		<msg @l="2433" char_id="-1" frame_id="-1" name=""
		   text="そして朽木教授は更に、パンツの中に手を突っ込んできて、直接秘部と恥毛に触れてきた。" voices=""/>
		<msg @l="2434" char_id="-1" frame_id="-1" name="" text="くちゅっ、しゅりっ。"
		   voices=""/>
		<msg @l="2436" char_id="0" frame_id="-1" name="美帆" text="『ああっ‥‥！』" voices=""/>
		<msg @l="2438" char_id="-1" frame_id="-1" name="朽木"
		   text="『んんー？それともキミは、路頭に迷う家族を見る方が良いのかな？』" voices=""/>
		<msg @l="2440" char_id="0" frame_id="-1" name="美帆" text="『わ‥‥わかりました。』"
		   voices=""/>
		<msg @l="2442" char_id="0" frame_id="-1" name="美帆" text="『ちゃんと言いますから‥‥。』"
		   voices=""/>
		<msg @l="2444" char_id="-1" frame_id="-1" name="朽木" text="『よろしい。』" voices=""/>
		<msg @l="2446" char_id="-1" frame_id="-1" name="朽木"
		   text="『では、これから私が言うことに続きたまえ。』" voices=""/>
		<msg @l="2448" char_id="0" frame_id="-1" name="美帆" text="『‥‥はい。』" voices=""/>
		<msg @l="2450" char_id="-1" frame_id="-1" name="朽木"
		   text="『「私はどんなことにも決して逆らいません。」』" voices=""/>
		<msg @l="2452" char_id="0" frame_id="-1" name="美帆"
		   text="『私は‥‥どんなことにも決して‥‥逆らいません‥‥。』" voices=""/>
		<msg @l="2454" char_id="-1" frame_id="-1" name="朽木"
		   text="『「どんな場合でも、従順であると誓います。」』" voices=""/>
		<msg @l="2456" char_id="0" frame_id="-1" name="美帆"
		   text="『どんな‥‥場合でも、従順であると‥‥誓い‥‥ます‥‥。』" voices=""/>
		<msg @l="2458" char_id="-1" frame_id="-1" name="朽木" text="『「心も身体も全て捧げます。」』"
		   voices=""/>
		<msg @l="2460" char_id="0" frame_id="-1" name="美帆" text="『こ、心も‥‥からだも‥‥‥‥。』"
		   voices=""/>
		<msg @l="2462" char_id="-1" frame_id="-1" name="" text="‥‥‥‥。" voices=""/>
		<msg @l="2463" char_id="-1" frame_id="-1" name="" text="言葉が続かない。" voices=""/>
		<msg @l="2464" char_id="-1" frame_id="-1" name=""
		   text="この先をつむいでしまうと、全てを失ってしまいそうで。" voices=""/>
		<msg @l="2465" char_id="-1" frame_id="-1" name=""
		   text="何度も唇を動かしてはみるものの‥‥声は出て来ない。" voices=""/>
		<msg @l="2467" char_id="-1" frame_id="-1" name="朽木"
		   text="『どうした、誓いの言葉がつむげないのならば、契約不履行としてお父さんには破滅の道を歩んでもらわねばならなくなるのだがねぇ？』"
		   voices=""/>
		<msg @l="2469" char_id="0" frame_id="-1" name="美帆" text="『で、でも‥‥。』"
		   voices=""/>
		<msg @l="2471" char_id="0" frame_id="-1" name="美帆"
		   text="『こんなこと‥‥‥私、約束出来ないです‥‥‥‥‥。』" voices=""/>
		<msg @l="2473" char_id="-1" frame_id="-1" name="朽木" text="『ならば仕方が無いなぁ。』"
		   voices=""/>
		<msg @l="2475" char_id="-1" frame_id="-1" name="朽木"
		   text="『では、お父さんには会社から非情な通告が下されるだけだ。』" voices=""/>
		<msg @l="2477" char_id="0" frame_id="-1" name="美帆" text="『それは‥‥。』" voices=""/>
		<msg @l="2479" char_id="-1" frame_id="-1" name="朽木" text="『しかし哀れなモノだな。』"
		   voices=""/>
		<msg @l="2481" char_id="-1" frame_id="-1" name="朽木"
		   text="『長年尽くしてきた会社に見放され、そして自分の娘にも見放されたとなれば、私だったら絶望するよ。』" voices=""/>
		<msg @l="2483" char_id="0" frame_id="-1" name="美帆" text="『そんな‥‥でも‥‥‥。』"
		   voices=""/>
		<msg @l="2485" char_id="-1" frame_id="-1" name="朽木"
		   text="『まだ定年前だ、わずかばかりの退職金と国から支給される数ヶ月分の失業手当てで、これからの長い老後を過ごさなければならぬワケだ。』"
		   voices=""/>
		<msg @l="2487" char_id="-1" frame_id="-1" name="朽木"
		   text="『私ならば途中で自暴自棄にでもなるやもしれないがねぇ。』" voices=""/>
		<msg @l="2489" char_id="-1" frame_id="-1" name="朽木"
		   text="『果ては自殺でもしてしまうかな‥‥。』" voices=""/>
		<msg @l="2491" char_id="0" frame_id="-1" name="美帆"
		   text="『そんなっ‥‥父はそこまで短絡的な人じゃありませんっ。』" voices=""/>
		<msg @l="2493" char_id="-1" frame_id="-1" name="朽木" text="『ほう、ならば試してみるかね？』"
		   voices=""/>
		<msg @l="2495" char_id="-1" frame_id="-1" name="朽木"
		   text="『追い詰められ極限状態に陥った人間が、どこまで短絡的にならず絶望と向きあえることが出来るのかをなぁ。』" voices=""/>
		<msg @l="2497" char_id="-1" frame_id="-1" name="" text="しゅり、しゅり。" voices=""/>
		<msg @l="2498" char_id="-1" frame_id="-1" name=""
		   text="朽木教授はそう言いながら、パンツの中に入れた手を執拗に動かし、恥毛を触っている。" voices=""/>
		<msg @l="2499" char_id="-1" frame_id="-1" name="" text="くにゅっ、くちゅっ。"
		   voices=""/>
		<msg @l="2500" char_id="-1" frame_id="-1" name=""
		   text="別の指を秘部の柔肉へと伸ばし、直に嬲ってくる。" voices=""/>
		<msg @l="2501" char_id="-1" frame_id="-1" name=""
		   text="柔肉を広げいじくられる度に、今までに感じたことのない刺激が身体を走り抜ける。" voices=""/>
		<msg @l="2503" char_id="0" frame_id="-1" name="美帆" text="『んんっ‥‥‥‥。』"
		   voices=""/>
		<msg @l="2505" char_id="-1" frame_id="-1" name="朽木"
		   text="『どうだね、そんな風に壊れていく家庭を見るのはツライだろう？』" voices=""/>
		<msg @l="2507" char_id="-1" frame_id="-1" name="朽木"
		   text="『なに、キミ一人が家族の為にその身を差し出せばいい。そうすれば家族全員が助かるのだ。』" voices=""/>
		<msg @l="2509" char_id="-1" frame_id="-1" name="朽木"
		   text="『国や会社は、キミの家族を守ってくれない。』" voices=""/>
		<msg @l="2511" char_id="-1" frame_id="-1" name="朽木"
		   text="『だが私はキミの家族を、お父さんを救う事が出来るのだよ。』" voices=""/>
		<msg @l="2513" char_id="-1" frame_id="-1" name="朽木" text="『答えは明白ではないのかな？』"
		   voices=""/>
		<msg @l="2515" char_id="-1" frame_id="-1" name=""
		   text="口元を緩やかに歪め、朽木教授が下卑た笑みを浮かべる。" voices=""/>
		<msg @l="2516" char_id="-1" frame_id="-1" name=""
		   text="その言葉の裏側に何があるのかは十二分に理解しているつもりだった。" voices=""/>
		<msg @l="2517" char_id="-1" frame_id="-1" name=""
		   text="けれど、私には「それ」を跳ね除けるだけの勇気が無い。" voices=""/>
		<msg @l="2518" char_id="-1" frame_id="-1" name="" text="朽木教授に逆らう勇気ではなくて。"
		   voices=""/>
		<msg @l="2519" char_id="-1" frame_id="-1" name=""
		   text="父の人生を天秤に掛けてでも間違っていることは間違っていると言う勇気が‥‥。" voices=""/>
		<msg @l="2521" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<stopbgm @l="2525" fadeout="1000"/>
		<clear @l="2531" class="all"/>
		<msg @l="2533" char_id="0" frame_id="-1" name="美帆"
		   text="『こ‥‥心も‥‥‥身体も‥‥‥‥‥全て、捧げます。』" voices=""/>
		<msg @l="2535" char_id="-1" frame_id="-1" name=""
		   text="誓いの言葉を言うと同時に、秘部をまさぐっていた朽木教授の指が秘部の中に差し込まれる。" voices=""/>
		<msg @l="2536" char_id="-1" frame_id="-1" name=""
		   text="この時、私の中で守るべき「何か」が壊れた‥‥。" voices=""/>
		<clear @l="2542" class="all"/>
		<eval @l="2545" expr="f.朽木ルートflag&#32;=&#32;1&#13;&#10;"/>
		<call @l="2550" target="EventLabel_100@root_kutuki01"/>
		<return @l="2551" value="0&#13;&#10;"/>
		<goto @l="2554" label="TempLabel_203"/>
		<label @l="2555" id="TempLabel_190"/>
		<wait_chgmv/>
		<bg @l="2561" src="bg03b"/>
		<bgm @l="2565" src="bgm05" volume="1."/>
		<char @l="2569" id="miho" pos="auto" src="miho031"/>
		<description @l="2572" text="舞い戻った日常"/>
		<eval @l="2574" expr="f.numDay=3&#13;&#10;"/>
		<msg @l="2576" char_id="0" frame_id="-1" name="美帆" text="『ごちそうさまです。』"
		   voices=""/>
		<msg @l="2578" char_id="1" frame_id="-1" name="玲" text="『はい、お粗末さま。』"
		   voices=""/>
		<msg @l="2580" char_id="-1" frame_id="-1" name=""
		   text="白石先輩お手製のビーフシチューを食べ終え、私は空になった二人分のお皿をキッチンの流しへ重ねて置く。" voices=""/>
		<msg @l="2582" char_id="0" frame_id="-1" name="美帆" text="『先輩、さすがですね。』"
		   voices=""/>
		<msg @l="2584" char_id="0" frame_id="-1" name="美帆"
		   text="『試験の資料を作らなきゃいけないのに、その片手間でこんなに手の込んだもの作っちゃうなんて。』" voices=""/>
		<clear @l="2587" class="char"/>
		<char @l="2589" id="miho" pos="left" src="miho031"/>
		<char @l="2591" id="rei" pos="right" src="rei030"/>
		<msg @l="2593" char_id="1" frame_id="-1" name="玲" text="『あら、そんなことないわよ。』"
		   voices=""/>
		<msg @l="2595" char_id="1" frame_id="-1" name="玲"
		   text="『仕込みはちょっと面倒だけど、基本的に放置すればいい料理だもの。』" voices=""/>
		<char @l="2598" id="rei" pos="right" src="rei031"/>
		<msg @l="2600" char_id="1" frame_id="-1" name="玲"
		   text="『逆に、何かの片手間だからこそできるモノだと思うけど？』" voices=""/>
		<char @l="2603" id="miho" pos="left" src="miho133"/>
		<msg @l="2605" char_id="0" frame_id="-1" name="美帆" text="『ん～、そんなものですか？』"
		   voices=""/>
		<msg @l="2607" char_id="-1" frame_id="-1" name=""
		   text="私も、以前に一度だけストロガノフにチャレンジしたことがある。" voices=""/>
		<msg @l="2608" char_id="-1" frame_id="-1" name=""
		   text="あれもビーフシチュー並みに時間のかかる料理だが、確か、私は半日ほどそれだけの為に拘束されるコトになった。" voices=""/>
		<msg @l="2609" char_id="-1" frame_id="-1" name=""
		   text="この差はやはり、私の天性的な不器用さにあるのだろうか。" voices=""/>
		<char @l="2612" id="miho" pos="left" src="miho131"/>
		<msg @l="2614" char_id="0" frame_id="-1" name="美帆" text="『コーヒー、いれますね。』"
		   voices=""/>
		<msg @l="2616" char_id="1" frame_id="-1" name="玲" text="『おねがーい。』" voices=""/>
		<msg @l="2618" char_id="-1" frame_id="-1" name=""
		   text="食器を洗う合間、コーヒーメーカーに容器をセットする。" voices=""/>
		<msg @l="2619" char_id="-1" frame_id="-1" name=""
		   text="少しの間を置いて香ばしいコーヒーの香りが漂い始めた頃、夕食に使った食器の全てを洗い終えていた。" voices=""/>
		<clear @l="2622" class="char"/>
		<char @l="2626" id="miho" pos="auto" src="miho030"/>
		<msg @l="2628" char_id="0" frame_id="-1" name="美帆" text="『コーヒー、お待たせしました。』"
		   voices=""/>
		<clear @l="2631" class="char"/>
		<char @l="2633" id="miho" pos="left" src="miho030"/>
		<char @l="2636" id="rei" pos="right" src="rei031"/>
		<msg @l="2638" char_id="1" frame_id="-1" name="玲" text="『ありがと。』" voices=""/>
		<msg @l="2640" char_id="1" frame_id="-1" name="玲" text="『ん～‥‥いい香りね。』"
		   voices=""/>
		<msg @l="2642" char_id="-1" frame_id="-1" name=""
		   text="先輩はカップに顔を寄せて、胸いっぱいにコーヒーの香りを吸い込む。" voices=""/>
		<msg @l="2643" char_id="-1" frame_id="-1" name=""
		   text="インスタントを使っていた頃は良く解らなかったけれど、コーヒーは香りが命だという言葉は紛れも無い事実なのだと最近になってよく思う。"
		   voices=""/>
		<msg @l="2644" char_id="-1" frame_id="-1" name=""
		   text="コーヒーは最初の一口目が肝心なのであって、残りは余韻を楽しむ為のものだ。" voices=""/>
		<msg @l="2645" char_id="-1" frame_id="-1" name=""
		   text="もっとも、その余韻に安心を感じる場合も多々あるのだけれど‥‥。" voices=""/>
		<char @l="2649" id="miho" pos="left" src="miho136"/>
		<msg @l="2651" char_id="0" frame_id="-1" name="美帆" text="『‥‥ふぅ。』" voices=""/>
		<char @l="2654" id="rei" pos="right" src="rei030"/>
		<msg @l="2656" char_id="1" frame_id="-1" name="玲" text="『‥‥‥‥。』" voices=""/>
		<msg @l="2658" char_id="1" frame_id="-1" name="玲" text="『少し、疲れてるみたいね。』"
		   voices=""/>
		<char @l="2662" id="miho" pos="left" src="miho034"/>
		<msg @l="2664" char_id="0" frame_id="-1" name="美帆" text="『そうですか？』" voices=""/>
		<char @l="2668" id="miho" pos="left" src="miho136"/>
		<msg @l="2670" char_id="0" frame_id="-1" name="美帆" text="『‥‥そうですね。』"
		   voices=""/>
		<msg @l="2672" char_id="-1" frame_id="-1" name="" text="昼間、あれだけのことがあったのだ。"
		   voices=""/>
		<msg @l="2673" char_id="-1" frame_id="-1" name="" text="疲れてないと言えば嘘になる。"
		   voices=""/>
		<goto @l="2676" cond="!(f.痴漢flag&#32;==&#32;1)&#13;&#10;"
		   label="TempLabel_204"/>
		<msg @l="2679" char_id="1" frame_id="-1" name="玲" text="『朝のこと‥‥？』" voices=""/>
		<msg @l="2681" char_id="0" frame_id="-1" name="美帆" text="『‥‥はい。』" voices=""/>
		<msg @l="2683" char_id="-1" frame_id="-1" name=""
		   text="あの騒ぎの後‥‥白石先輩と合流はしたものの、一限目の講義に遅れるということで大した話もしないうちに別れてしまった。"
		   voices=""/>
		<msg @l="2684" char_id="-1" frame_id="-1" name=""
		   text="先輩はどうして私が朽木教授や稲庭先輩と一緒に居たのか知らないはずだ。" voices=""/>
		<msg @l="2686" char_id="1" frame_id="-1" name="玲"
		   text="『稲庭さんと知り合いだったみたいだけど‥‥何があったの？』" voices=""/>
		<char @l="2689" id="miho" pos="left" src="miho034"/>
		<msg @l="2691" char_id="0" frame_id="-1" name="美帆"
		   text="『あ、はい‥‥私‥‥‥最近ずっと痴漢に遭っていて。』" voices=""/>
		<char @l="2694" id="miho" pos="left" src="miho136"/>
		<msg @l="2696" char_id="0" frame_id="-1" name="美帆"
		   text="『それで‥‥今日、偶然稲庭先輩に助けてもらったんです。』" voices=""/>
		<char @l="2699" id="rei" pos="right" src="rei034"/>
		<msg @l="2701" char_id="1" frame_id="-1" name="玲" text="『痴漢って、まさか‥‥朽木教授が？』"
		   voices=""/>
		<char @l="2704" id="miho" pos="left" src="miho135"/>
		<msg @l="2706" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="2708" char_id="-1" frame_id="-1" name="" text="私は無言で小さく頷く。"
		   voices=""/>
		<msg @l="2709" char_id="-1" frame_id="-1" name=""
		   text="朽木教授が痴漢の正体だったなんて、私自身今でも信じたくない。" voices=""/>
		<char @l="2712" id="rei" pos="right" src="rei030"/>
		<msg @l="2714" char_id="1" frame_id="-1" name="玲" text="『そう‥‥。』" voices=""/>
		<msg @l="2716" char_id="1" frame_id="-1" name="玲"
		   text="『気落ちしないで‥‥っていうのも無理な話よね。』" voices=""/>
		<char @l="2719" id="miho" pos="left" src="miho036"/>
		<msg @l="2721" char_id="0" frame_id="-1" name="美帆" text="『あ、でも‥‥もう大丈夫です。』"
		   voices=""/>
		<msg @l="2723" char_id="0" frame_id="-1" name="美帆"
		   text="『少しショックでしたけど、なんとか‥‥。』" voices=""/>
		<msg @l="2725" char_id="1" frame_id="-1" name="玲" text="『無理してない？』" voices=""/>
		<char @l="2728" id="miho" pos="left" src="miho034"/>
		<msg @l="2730" char_id="0" frame_id="-1" name="美帆" text="『そんなこと‥‥。』"
		   voices=""/>
		<char @l="2733" id="miho" pos="left" src="miho136"/>
		<char @l="2735" id="rei" pos="right" src="rei031"/>
		<msg @l="2737" char_id="1" frame_id="-1" name="玲"
		   text="『稲庭さんが助けてくれたのなら安心だとは思うけど、何かあったら遠慮せずに相談して。』" voices=""/>
		<msg @l="2739" char_id="1" frame_id="-1" name="玲"
		   text="『何も出来ないなんてことは‥‥無いと思うから。』" voices=""/>
		<msg @l="2741" char_id="0" frame_id="-1" name="美帆" text="『ありがとうございます。』"
		   voices=""/>
		<msg @l="2743" char_id="0" frame_id="-1" name="美帆"
		   text="『先輩‥‥私、本当に大丈夫ですから。』" voices=""/>
		<char @l="2746" id="rei" pos="right" src="rei030"/>
		<msg @l="2748" char_id="1" frame_id="-1" name="玲" text="『玲、でいいわよ‥‥。』"
		   voices=""/>
		<char @l="2751" id="miho" pos="left" src="miho134"/>
		<msg @l="2753" char_id="0" frame_id="-1" name="美帆" text="『え？』" voices=""/>
		<msg @l="2755" char_id="1" frame_id="-1" name="玲"
		   text="『もう一ヶ月になるのに先輩‥‥は他人行儀かなと思ってね、名前で呼んでくれて構わないわよ。』" voices=""/>
		<msg @l="2757" char_id="1" frame_id="-1" name="玲"
		   text="『私はあなたの事、かわいい妹が出来たみたいで気に入ってるし‥‥。』" voices=""/>
		<char @l="2760" id="miho" pos="left" src="miho133"/>
		<msg @l="2762" char_id="0" frame_id="-1" name="美帆" text="『玲‥‥さん、ですか‥‥。』"
		   voices=""/>
		<msg @l="2764" char_id="-1" frame_id="-1" name=""
		   text="突然の先輩の言葉に、私はちょっと戸惑ったけど、優しいお姉さんが出来たみたいで、なんだかくすぐったい気持ちになって、頬が熱くなってしまった。"
		   voices=""/>
		<char @l="2767" id="rei" pos="right" src="rei031"/>
		<msg @l="2769" char_id="1" frame_id="-1" name="玲" text="『そうよ。』" voices=""/>
		<msg @l="2771" char_id="-1" frame_id="-1" name=""
		   text="そう言って白石先輩‥‥玲さんは優しく笑った。" voices=""/>
		<char @l="2774" id="rei" pos="right" src="rei030"/>
		<msg @l="2776" char_id="1" frame_id="-1" name="玲"
		   text="『でも、だからこそ、出来れば今朝の時点で、相談して欲しかったかな。』" voices=""/>
		<msg @l="2778" char_id="0" frame_id="-1" name="美帆"
		   text="『すみません‥‥やっぱり、恥ずかしくて。』" voices=""/>
		<msg @l="2780" char_id="1" frame_id="-1" name="玲"
		   text="『そうね、その気持ちもわかるけど‥‥。』" voices=""/>
		<char @l="2783" id="miho" pos="left" src="miho135"/>
		<msg @l="2785" char_id="0" frame_id="-1" name="美帆" text="『ごめんなさい‥‥。』"
		   voices=""/>
		<char @l="2788" id="rei" pos="right" src="rei031"/>
		<msg @l="2790" char_id="1" frame_id="-1" name="玲"
		   text="『ううん‥‥とにかく解決したのだから、良しとしないとね。』" voices=""/>
		<msg @l="2792" char_id="-1" frame_id="-1" name="" text="そうして玲さんはにっこりと笑う。"
		   voices=""/>
		<msg @l="2793" char_id="-1" frame_id="-1" name=""
		   text="正直色々なコトが引っかかっていた私は、その笑顔に救われた。" voices=""/>
		<msg @l="2794" char_id="-1" frame_id="-1" name=""
		   text="今はとにかく、心から笑えるだけの気力も‥‥足りないくらいだから。" voices=""/>
		<char @l="2797" id="miho" pos="left" src="miho034"/>
		<msg @l="2799" char_id="0" frame_id="-1" name="美帆" text="『そういえば‥‥。』"
		   voices=""/>
		<msg @l="2801" char_id="0" frame_id="-1" name="美帆"
		   text="『稲庭先輩のこと、良く知っていらっしゃるんですね？』" voices=""/>
		<char @l="2804" id="rei" pos="right" src="rei030"/>
		<msg @l="2806" char_id="1" frame_id="-1" name="玲"
		   text="『ああ。稲庭さんとは同期だしサークルが同じなのよ。』" voices=""/>
		<msg @l="2808" char_id="1" frame_id="-1" name="玲"
		   text="『知ってるでしょ？&#32;彼、テニスサークルの会長なの。』" voices=""/>
		<char @l="2811" id="miho" pos="left" src="miho030"/>
		<msg @l="2813" char_id="0" frame_id="-1" name="美帆" text="『あ、はい‥‥。』"
		   voices=""/>
		<msg @l="2815" char_id="-1" frame_id="-1" name=""
		   text="確か、前に講義友達の子がそんな感じのコトを言っていた。" voices=""/>
		<msg @l="2817" char_id="1" frame_id="-1" name="玲"
		   text="『私もテニスサークルに参加しているから、それで。』" voices=""/>
		<char @l="2820" id="miho" pos="left" src="miho031"/>
		<msg @l="2822" char_id="0" frame_id="-1" name="美帆" text="『へー、テニスですか。』"
		   voices=""/>
		<msg @l="2824" char_id="0" frame_id="-1" name="美帆" text="『玲さんならお似合いですね。』"
		   voices=""/>
		<char @l="2827" id="rei" pos="right" src="rei031"/>
		<msg @l="2829" char_id="1" frame_id="-1" name="玲"
		   text="『似合うかどうかは解らないけど、充実はしてるわよ。』" voices=""/>
		<char @l="2832" id="rei" pos="right" src="rei030"/>
		<msg @l="2834" char_id="1" frame_id="-1" name="玲"
		   text="『アナタも、何処かサークルに入る予定とかはないの？』" voices=""/>
		<char @l="2837" id="miho" pos="left" src="miho030"/>
		<msg @l="2839" char_id="0" frame_id="-1" name="美帆" text="『特に予定はないですけど‥‥。』"
		   voices=""/>
		<char @l="2842" id="miho" pos="left" src="miho031"/>
		<msg @l="2844" char_id="0" frame_id="-1" name="美帆" text="『テニスとか‥‥楽しそうですね。』"
		   voices=""/>
		<char @l="2847" id="rei" pos="right" src="rei031"/>
		<msg @l="2849" char_id="1" frame_id="-1" name="玲"
		   text="『ふふ‥‥興味があるのはテニスかしら、それとも稲庭さん？』" voices=""/>
		<char @l="2852" id="miho" pos="left" src="miho034"/>
		<msg @l="2854" char_id="0" frame_id="-1" name="美帆"
		   text="『えっ‥‥そ、そんなんじゃないですよ。』" voices=""/>
		<char @l="2857" id="miho" pos="left" src="miho133"/>
		<msg @l="2859" char_id="0" frame_id="-1" name="美帆"
		   text="『私はただ、テニスも良いかなって‥‥それだけですから！』" voices=""/>
		<msg @l="2861" char_id="1" frame_id="-1" name="玲"
		   text="『ムキになって否定する所がアヤシイわね～。』" voices=""/>
		<msg @l="2863" char_id="0" frame_id="-1" name="美帆" text="『ち、違いますって‥‥。』"
		   voices=""/>
		<char @l="2866" id="miho" pos="left" src="miho031"/>
		<msg @l="2868" char_id="0" frame_id="-1" name="美帆"
		   text="『そんなことより先輩はどうなんです？』" voices=""/>
		<char @l="2871" id="rei" pos="right" src="rei034"/>
		<msg @l="2873" char_id="1" frame_id="-1" name="玲" text="『え、私‥‥？』" voices=""/>
		<msg @l="2875" char_id="0" frame_id="-1" name="美帆"
		   text="『稲庭先輩のこと、ずいぶん持ち上げてるじゃないですか？』" voices=""/>
		<char @l="2878" id="rei" pos="right" src="rei031"/>
		<msg @l="2880" char_id="1" frame_id="-1" name="玲" text="『私は彼のことが好きよ。』"
		   voices=""/>
		<char @l="2883" id="miho" pos="left" src="miho034"/>
		<msg @l="2885" char_id="0" frame_id="-1" name="美帆" text="『わ‥‥。』" voices=""/>
		<msg @l="2887" char_id="0" frame_id="-1" name="美帆"
		   text="『玲さん、ハッキリしてるんですね‥‥。』" voices=""/>
		<char @l="2890" id="rei" pos="right" src="rei030"/>
		<msg @l="2892" char_id="1" frame_id="-1" name="玲" text="『まあ、性格かな。』"
		   voices=""/>
		<msg @l="2894" char_id="1" frame_id="-1" name="玲"
		   text="『隠すのって、あんまり得意じゃないのよ。』" voices=""/>
		<char @l="2897" id="miho" pos="left" src="miho030"/>
		<msg @l="2899" char_id="0" frame_id="-1" name="美帆"
		   text="『でも、それって大変じゃないですか？』" voices=""/>
		<msg @l="2901" char_id="1" frame_id="-1" name="玲" text="『大変って？』" voices=""/>
		<char @l="2904" id="miho" pos="left" src="miho130"/>
		<msg @l="2906" char_id="0" frame_id="-1" name="美帆"
		   text="『噂になったり‥‥相手に自分の気持ちが伝わっちゃったりとか。』" voices=""/>
		<char @l="2909" id="rei" pos="right" src="rei031"/>
		<msg @l="2911" char_id="1" frame_id="-1" name="玲" text="『噂なんて気にしなければ良いわ。』"
		   voices=""/>
		<msg @l="2913" char_id="1" frame_id="-1" name="玲"
		   text="『それに、相手に気持ちが伝わるのってそんなに悪いコトなのかしら？』" voices=""/>
		<char @l="2916" id="miho" pos="left" src="miho136"/>
		<msg @l="2918" char_id="0" frame_id="-1" name="美帆"
		   text="『別に‥‥悪いとは思いませんけど‥‥‥。』" voices=""/>
		<char @l="2921" id="rei" pos="right" src="rei030"/>
		<msg @l="2923" char_id="1" frame_id="-1" name="玲"
		   text="『自分の気持ちを相手に伝えなければ何も始まらないわ。』" voices=""/>
		<msg @l="2925" char_id="1" frame_id="-1" name="玲"
		   text="『良くも悪くも、自分が思っていることを隠し通すのは大変なことよ。』" voices=""/>
		<msg @l="2927" char_id="1" frame_id="-1" name="玲"
		   text="『どうせ大変な思いをするのなら、それを自分の内側に隠すことにじゃなくて、その思いの先へ到達する為にしたいじゃない？』"
		   voices=""/>
		<msg @l="2929" char_id="1" frame_id="-1" name="玲"
		   text="『もちろん、何も考えずに突き進むだけが全てじゃないと思うけどね。』" voices=""/>
		<char @l="2932" id="miho" pos="left" src="miho034"/>
		<msg @l="2934" char_id="0" frame_id="-1" name="美帆" text="『凄い‥‥玲さんて大人ですね。』"
		   voices=""/>
		<msg @l="2936" char_id="1" frame_id="-1" name="玲"
		   text="『大人とか子供とかって、そんなに大差は無いわよ。』" voices=""/>
		<msg @l="2938" char_id="1" frame_id="-1" name="玲"
		   text="『自覚があるか無いか、それだけの違いだと思うわ。』" voices=""/>
		<char @l="2941" id="rei" pos="right" src="rei031"/>
		<msg @l="2943" char_id="-1" frame_id="-1" name=""
		   text="そうして笑う先輩は、私なんかよりずっと大人に思えた。" voices=""/>
		<char @l="2946" id="miho" pos="left" src="miho131"/>
		<msg @l="2948" char_id="0" frame_id="-1" name="美帆" text="『告白とかって‥‥したんですか？』"
		   voices=""/>
		<char @l="2951" id="rei" pos="right" src="rei030"/>
		<msg @l="2953" char_id="1" frame_id="-1" name="玲" text="『もちろんしたわよ。』"
		   voices=""/>
		<msg @l="2955" char_id="1" frame_id="-1" name="玲" text="『でも、ふられちゃった。』"
		   voices=""/>
		<char @l="2958" id="miho" pos="left" src="miho134"/>
		<msg @l="2960" char_id="0" frame_id="-1" name="美帆" text="『え、ふられちゃったんですかっ！？』"
		   voices=""/>
		<char @l="2963" id="rei" pos="right" src="rei034"/>
		<msg @l="2965" char_id="1" frame_id="-1" name="玲" text="『なあに？&#32;そんなに意外？』"
		   voices=""/>
		<char @l="2968" id="miho" pos="left" src="miho136"/>
		<msg @l="2970" char_id="0" frame_id="-1" name="美帆" text="『意外っていうか‥‥なんというか。』"
		   voices=""/>
		<msg @l="2972" char_id="0" frame_id="-1" name="美帆"
		   text="『玲さん、頭も良いし美人だし‥‥‥スタイルもいいですし。』" voices=""/>
		<msg @l="2974" char_id="0" frame_id="-1" name="美帆" text="『どうしてふっちゃうのかなって。』"
		   voices=""/>
		<char @l="2977" id="rei" pos="right" src="rei030"/>
		<msg @l="2979" char_id="1" frame_id="-1" name="玲"
		   text="『さあ、それはこっちが聞きたいくらいだけどね。』" voices=""/>
		<msg @l="2981" char_id="1" frame_id="-1" name="玲"
		   text="『彼、毎日のように告白されては断り続けてるみたいよ？』" voices=""/>
		<char @l="2984" id="miho" pos="left" src="miho034"/>
		<msg @l="2986" char_id="0" frame_id="-1" name="美帆" text="『そうなんですか？』"
		   voices=""/>
		<msg @l="2988" char_id="1" frame_id="-1" name="玲" text="『真偽のほどはもちろん不明よ。』"
		   voices=""/>
		<msg @l="2990" char_id="1" frame_id="-1" name="玲"
		   text="『なにせ噂では、心に決めた人が居るとか親同士の決めた婚約者いるからとか言われてるくらいだもの。』" voices=""/>
		<char @l="2993" id="miho" pos="left" src="miho036"/>
		<msg @l="2995" char_id="0" frame_id="-1" name="美帆" text="『あはは‥‥。』" voices=""/>
		<msg @l="2997" char_id="1" frame_id="-1" name="玲"
		   text="『どちらにせよ彼がフリーで居る以上、チャンスはまだまだあるわ。』" voices=""/>
		<char @l="3000" id="rei" pos="right" src="rei031"/>
		<msg @l="3002" char_id="1" frame_id="-1" name="玲"
		   text="『むしろ、ここからが女としての勝負どころね。』" voices=""/>
		<msg @l="3004" char_id="0" frame_id="-1" name="美帆" text="『玲さん‥‥タフですね。』"
		   voices=""/>
		<msg @l="3006" char_id="1" frame_id="-1" name="玲"
		   text="『ふふ、誉め言葉として受け取っておくわよ。』" voices=""/>
		<msg @l="3008" char_id="-1" frame_id="-1" name=""
		   text="そうして玲さんはにっこりと微笑んで、カップの中身を一気にあおる。" voices=""/>
		<msg @l="3009" char_id="-1" frame_id="-1" name=""
		   text="猫舌な私は‥‥カップの中身が冷めるのを、ただ緩々と待ち続けていた。" voices=""/>
		<goto @l="3012" label="TempLabel_205"/>
		<label @l="3013" id="TempLabel_204"/>
		<char @l="3018" id="rei" pos="right" src="rei030"/>
		<msg @l="3020" char_id="1" frame_id="-1" name="玲" text="『今朝のコトね。』" voices=""/>
		<char @l="3023" id="miho" pos="left" src="miho136"/>
		<msg @l="3025" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="3027" char_id="1" frame_id="-1" name="玲"
		   text="『私はアナタじゃないから辛かった気持ちの全部は解らない‥‥。』" voices=""/>
		<msg @l="3029" char_id="1" frame_id="-1" name="玲"
		   text="『でも、解決したことを何時までも引きずるのは良くないわよ。』" voices=""/>
		<msg @l="3031" char_id="0" frame_id="-1" name="美帆" text="『それは‥‥わかってます。』"
		   voices=""/>
		<msg @l="3033" char_id="0" frame_id="-1" name="美帆"
		   text="『ただちょっと、不安なだけなんです。』" voices=""/>
		<msg @l="3035" char_id="0" frame_id="-1" name="美帆"
		   text="『あれで良かったのかな、本当に大丈夫なのかな‥‥って。』" voices=""/>
		<msg @l="3037" char_id="1" frame_id="-1" name="玲" text="『‥‥そうね。』" voices=""/>
		<char @l="3040" id="rei" pos="right" src="rei031"/>
		<msg @l="3042" char_id="1" frame_id="-1" name="玲"
		   text="『不安なら明日も一緒の電車に乗りましょうか？』" voices=""/>
		<char @l="3045" id="miho" pos="left" src="miho034"/>
		<msg @l="3047" char_id="0" frame_id="-1" name="美帆" text="『え‥‥。』" voices=""/>
		<msg @l="3049" char_id="1" frame_id="-1" name="玲"
		   text="『一日でも二日でも一週間でも、それで不安が消えるなら安いものよ。』" voices=""/>
		<msg @l="3051" char_id="0" frame_id="-1" name="美帆"
		   text="『そ、そんなっ‥‥先輩だって忙しいのに。』" voices=""/>
		<char @l="3054" id="rei" pos="right" src="rei030"/>
		<msg @l="3056" char_id="1" frame_id="-1" name="玲" text="『玲、でいいわよ‥‥。』"
		   voices=""/>
		<char @l="3059" id="miho" pos="left" src="miho134"/>
		<msg @l="3062" char_id="0" frame_id="-1" name="美帆" text="『え？』" voices=""/>
		<msg @l="3064" char_id="1" frame_id="-1" name="玲"
		   text="『もう一ヶ月になるのに先輩‥‥は他人行儀かなと思ってね、名前で呼んでくれて構わないわよ。』" voices=""/>
		<msg @l="3066" char_id="1" frame_id="-1" name="玲"
		   text="『私はあなたの事、かわいい妹が出来たみたいで気に入ってるし‥‥。』" voices=""/>
		<char @l="3069" id="miho" pos="left" src="miho133"/>
		<msg @l="3071" char_id="0" frame_id="-1" name="美帆" text="『玲‥‥さん、ですか‥‥。』"
		   voices=""/>
		<msg @l="3073" char_id="-1" frame_id="-1" name=""
		   text="突然の先輩の言葉に、私はちょっと戸惑ったけど、優しいお姉さんが出来たみたいで、なんだかくすぐったい気持ちになって、頬が熱くなってしまった。"
		   voices=""/>
		<char @l="3076" id="rei" pos="right" src="rei031"/>
		<msg @l="3078" char_id="1" frame_id="-1" name="玲" text="『そうよ。』" voices=""/>
		<msg @l="3080" char_id="-1" frame_id="-1" name=""
		   text="そう言って白石先輩‥‥玲さんは優しく笑った。" voices=""/>
		<char @l="3083" id="rei" pos="right" src="rei030"/>
		<msg @l="3085" char_id="1" frame_id="-1" name="玲"
		   text="『でも、だからこそ、出来れば今朝の時点で、相談して欲しかったかな。』" voices=""/>
		<msg @l="3087" char_id="0" frame_id="-1" name="美帆"
		   text="『すみません‥‥やっぱり、恥ずかしくて。』" voices=""/>
		<msg @l="3089" char_id="1" frame_id="-1" name="玲"
		   text="『そうね、その気持ちもわかるけど‥‥。』" voices=""/>
		<char @l="3092" id="miho" pos="left" src="miho135"/>
		<msg @l="3094" char_id="0" frame_id="-1" name="美帆" text="『ごめんなさい‥‥。』"
		   voices=""/>
		<msg @l="3096" char_id="1" frame_id="-1" name="玲"
		   text="『ふふ。でも、そう思うなら、早く不安が無くなるように気持ちを切りかえることね。』" voices=""/>
		<msg @l="3098" char_id="1" frame_id="-1" name="玲" text="『アナタの気持ちが一番大切なのよ。』"
		   voices=""/>
		<char @l="3101" id="miho" pos="left" src="miho036"/>
		<msg @l="3103" char_id="0" frame_id="-1" name="美帆" text="『はい‥‥ありがとうございます。』"
		   voices=""/>
		<char @l="3106" id="miho" pos="left" src="miho136"/>
		<msg @l="3108" char_id="0" frame_id="-1" name="美帆"
		   text="『解ってるんです。頭では解ってるんですけど‥‥。』" voices=""/>
		<msg @l="3110" char_id="1" frame_id="-1" name="玲" text="『ん‥‥無理はしなくていいから。』"
		   voices=""/>
		<msg @l="3112" char_id="1" frame_id="-1" name="玲"
		   text="『少しずつ、自分のペースで気持ちを整理して。』" voices=""/>
		<char @l="3115" id="miho" pos="left" src="miho035"/>
		<msg @l="3117" char_id="0" frame_id="-1" name="美帆" text="『玲さん‥‥。』" voices=""/>
		<msg @l="3119" char_id="1" frame_id="-1" name="玲"
		   text="『ただ、私の言葉に甘えたりはしないでね。』" voices=""/>
		<msg @l="3121" char_id="1" frame_id="-1" name="玲"
		   text="『自分に厳しく、他人に優しく‥‥これが人付き合いの基本よ。』" voices=""/>
		<char @l="3124" id="miho" pos="left" src="miho030"/>
		<msg @l="3126" char_id="0" frame_id="-1" name="美帆" text="『は、はい。』" voices=""/>
		<msg @l="3128" char_id="-1" frame_id="-1" name=""
		   text="励まされているのか説教をされてるのか良く解らない玲さんの言葉に、私は困惑の表情で頷いてみせる。" voices=""/>
		<msg @l="3129" char_id="-1" frame_id="-1" name="" text="けれど、玲さんの言葉は理解できる。"
		   voices=""/>
		<msg @l="3130" char_id="-1" frame_id="-1" name=""
		   text="励ましの言葉を逆手に取って逃避に使うような真似は、一番卑怯だ。" voices=""/>
		<msg @l="3131" char_id="-1" frame_id="-1" name=""
		   text="これまでの私はそうして逃げていたかもしれない。" voices=""/>
		<msg @l="3132" char_id="-1" frame_id="-1" name=""
		   text="でも、今度からは‥‥この南総町に来てからは変わると決めた。" voices=""/>
		<msg @l="3133" char_id="-1" frame_id="-1" name=""
		   text="自分に誠実に、自分に厳しく‥‥そして積極的になると。" voices=""/>
		<char @l="3136" id="miho" pos="left" src="miho033"/>
		<msg @l="3138" char_id="0" frame_id="-1" name="美帆" text="『玲さんは‥‥。』"
		   voices=""/>
		<msg @l="3140" char_id="1" frame_id="-1" name="玲" text="『ん？』" voices=""/>
		<msg @l="3142" char_id="0" frame_id="-1" name="美帆"
		   text="『玲さんは、こういう時どんな風に気晴らししたりするんですか？』" voices=""/>
		<msg @l="3144" char_id="1" frame_id="-1" name="玲" text="『そうね‥‥。』" voices=""/>
		<char @l="3147" id="rei" pos="right" src="rei031"/>
		<msg @l="3149" char_id="1" frame_id="-1" name="玲"
		   text="『私の場合‥‥身体を動かす、かしらね。』" voices=""/>
		<msg @l="3151" char_id="0" frame_id="-1" name="美帆" text="『スポーツ‥‥ですか？』"
		   voices=""/>
		<char @l="3154" id="miho" pos="left" src="miho034"/>
		<msg @l="3156" char_id="1" frame_id="-1" name="玲"
		   text="『そう。泳ぐのでも走るのでも何でも良いけど‥‥とにかく動くの。』" voices=""/>
		<char @l="3159" id="rei" pos="right" src="rei030"/>
		<msg @l="3161" char_id="1" frame_id="-1" name="玲"
		   text="『考えてばっかりじゃ、どんどん内側へこもっちゃうから。』" voices=""/>
		<char @l="3164" id="miho" pos="left" src="miho030"/>
		<msg @l="3166" char_id="0" frame_id="-1" name="美帆" text="『動く‥‥。』" voices=""/>
		<msg @l="3168" char_id="1" frame_id="-1" name="玲"
		   text="『そうね‥‥私のサークルに顔を出してみる？』" voices=""/>
		<msg @l="3170" char_id="0" frame_id="-1" name="美帆"
		   text="『そういえば先輩、サークルに入っているんですよね。』" voices=""/>
		<msg @l="3172" char_id="0" frame_id="-1" name="美帆" text="『スポーツ系なんですか？』"
		   voices=""/>
		<msg @l="3174" char_id="1" frame_id="-1" name="玲"
		   text="『言ってなかったかしら？&#32;私、テニスサークルに入ってるのよ。』" voices=""/>
		<msg @l="3176" char_id="1" frame_id="-1" name="玲"
		   text="『今の時期なら、まだサークル体験も出来るんじゃないかしら。』" voices=""/>
		<char @l="3179" id="miho" pos="left" src="miho034"/>
		<msg @l="3181" char_id="0" frame_id="-1" name="美帆" text="『あ、テニスサークルといえば‥‥。』"
		   voices=""/>
		<char @l="3184" id="miho" pos="left" src="miho031"/>
		<msg @l="3186" char_id="0" frame_id="-1" name="美帆"
		   text="『この前、テニスサークルの会長さんとお話しましたよ。』" voices=""/>
		<msg @l="3188" char_id="1" frame_id="-1" name="玲" text="『あら、稲庭さんのこと知っているの？』"
		   voices=""/>
		<msg @l="3190" char_id="0" frame_id="-1" name="美帆"
		   text="『知ってる‥‥って程じゃないですけど。』" voices=""/>
		<msg @l="3192" char_id="0" frame_id="-1" name="美帆"
		   text="『同じ講義取ってる友達が稲庭先輩の大ファンみたいで、一緒に立ち話をしただけですよ。』" voices=""/>
		<msg @l="3194" char_id="1" frame_id="-1" name="玲"
		   text="『ふーん、相変わらず多くの女の子を熱狂させてるのね。』" voices=""/>
		<char @l="3197" id="miho" pos="left" src="miho030"/>
		<msg @l="3199" char_id="0" frame_id="-1" name="美帆" text="『そうなんですか？』"
		   voices=""/>
		<msg @l="3201" char_id="1" frame_id="-1" name="玲"
		   text="『そ。おまけに本人には自覚なしだから、困ったものだわ。』" voices=""/>
		<msg @l="3203" char_id="0" frame_id="-1" name="美帆"
		   text="『んー‥‥どうして玲さんが困るんですか？』" voices=""/>
		<char @l="3206" id="rei" pos="right" src="rei031"/>
		<msg @l="3208" char_id="1" frame_id="-1" name="玲"
		   text="『ああ‥‥私、稲庭さんのことが好きなの。』" voices=""/>
		<char @l="3211" id="miho" pos="left" src="miho034"/>
		<msg @l="3213" char_id="0" frame_id="-1" name="美帆"
		   text="『えっ‥‥、何もそんなハッキリと‥‥‥。』" voices=""/>
		<char @l="3216" id="rei" pos="right" src="rei030"/>
		<msg @l="3218" char_id="1" frame_id="-1" name="玲" text="『おかしいかしら？』"
		   voices=""/>
		<char @l="3221" id="miho" pos="left" src="miho130"/>
		<msg @l="3223" char_id="0" frame_id="-1" name="美帆"
		   text="『おかしくは‥‥ないですけど‥‥‥。』" voices=""/>
		<char @l="3226" id="miho" pos="left" src="miho031"/>
		<msg @l="3228" char_id="0" frame_id="-1" name="美帆"
		   text="『その、ちょっと‥‥‥‥驚きました。』" voices=""/>
		<char @l="3231" id="rei" pos="right" src="rei031"/>
		<msg @l="3233" char_id="1" frame_id="-1" name="玲"
		   text="『私、気持ちを隠しておくのって苦手だから。』" voices=""/>
		<char @l="3236" id="miho" pos="left" src="miho131"/>
		<msg @l="3238" char_id="0" frame_id="-1" name="美帆" text="『告白とかって‥‥したんですか？』"
		   voices=""/>
		<char @l="3241" id="rei" pos="right" src="rei030"/>
		<msg @l="3243" char_id="1" frame_id="-1" name="玲" text="『もちろんしたわよ。』"
		   voices=""/>
		<msg @l="3245" char_id="1" frame_id="-1" name="玲" text="『でも、ふられちゃった。』"
		   voices=""/>
		<char @l="3248" id="miho" pos="left" src="miho134"/>
		<msg @l="3250" char_id="0" frame_id="-1" name="美帆" text="『え、ふられちゃったんですかっ！？』"
		   voices=""/>
		<char @l="3253" id="rei" pos="right" src="rei034"/>
		<msg @l="3255" char_id="1" frame_id="-1" name="玲" text="『なあに？&#32;そんなに意外？』"
		   voices=""/>
		<char @l="3258" id="miho" pos="left" src="miho136"/>
		<msg @l="3260" char_id="0" frame_id="-1" name="美帆" text="『意外っていうか‥‥なんというか。』"
		   voices=""/>
		<msg @l="3262" char_id="0" frame_id="-1" name="美帆"
		   text="『玲さん、頭も良いし美人だし‥‥‥スタイルもいいですし。』" voices=""/>
		<msg @l="3264" char_id="0" frame_id="-1" name="美帆" text="『どうしてふっちゃうのかなって。』"
		   voices=""/>
		<char @l="3267" id="rei" pos="right" src="rei030"/>
		<msg @l="3269" char_id="1" frame_id="-1" name="玲"
		   text="『さあ、それはコッチが聞きたいくらいだけどね。』" voices=""/>
		<msg @l="3271" char_id="1" frame_id="-1" name="玲"
		   text="『彼、毎日のように告白されては断り続けてるみたいよ？』" voices=""/>
		<char @l="3274" id="miho" pos="left" src="miho034"/>
		<msg @l="3276" char_id="0" frame_id="-1" name="美帆" text="『そうなんですか？』"
		   voices=""/>
		<msg @l="3278" char_id="1" frame_id="-1" name="玲" text="『真偽のほどはもちろん不明よ。』"
		   voices=""/>
		<msg @l="3280" char_id="1" frame_id="-1" name="玲"
		   text="『なにせ噂では、心に決めた人が居るとか親同士の決めた婚約者いるからとか言われてるくらいだもの。』" voices=""/>
		<char @l="3283" id="miho" pos="left" src="miho036"/>
		<msg @l="3285" char_id="0" frame_id="-1" name="美帆" text="『あはは‥‥。』" voices=""/>
		<msg @l="3287" char_id="1" frame_id="-1" name="玲"
		   text="『どちらにせよ彼がフリーで居る以上、チャンスはまだまだあるわ。』" voices=""/>
		<char @l="3290" id="rei" pos="right" src="rei031"/>
		<msg @l="3292" char_id="1" frame_id="-1" name="玲"
		   text="『むしろ、ここからが女としての勝負どころね。』" voices=""/>
		<msg @l="3294" char_id="0" frame_id="-1" name="美帆" text="『玲さん‥‥タフですね。』"
		   voices=""/>
		<msg @l="3296" char_id="1" frame_id="-1" name="玲"
		   text="『ふふ、誉め言葉として受け取っておくわよ。』" voices=""/>
		<msg @l="3298" char_id="-1" frame_id="-1" name=""
		   text="そうして玲さんはにっこりと微笑んで、カップの中身を一気にあおる。" voices=""/>
		<msg @l="3299" char_id="-1" frame_id="-1" name=""
		   text="猫舌な私は‥‥カップの中身が冷めるのを、ただ緩々と待ち続けていた。" voices=""/>
		<label @l="3302" id="TempLabel_205"/>
		<label @l="3306" id="TempLabel_203"/>
		<stopbgm @l="3311" fadeout="1000"/>
		<clear @l="3317" class="all"/>
		<call @l="3322" target="EventLabel_29@common_root04"/>
		<return @l="3323" value="0&#13;&#10;"/>
	</code>
</xscript>
