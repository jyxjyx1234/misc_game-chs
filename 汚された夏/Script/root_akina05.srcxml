<?xml version="1.0" encoding="utf-8"?>
<xscript>
	<debug editor="&quot;C:\Program&#32;Files&#32;(x86)\sakura\sakura.exe&quot;&#32;&quot;%src%&quot;&#32;-Y=%line%"
	   src="D:\シロップ\町ぐるみの罠＋汚された夏セット版\汚された夏\完成データ\汚された夏\script\text\root_akina05.txt"/>
	<code>
		<label @l="14" id="EventLabel_80"/>
		<description @l="18" text="水泳コーチ・５日目"/>
		<eval @l="20" expr="f.numDay=12&#13;&#10;"/>
		<msgshow @l="22" show="false"/>
		<wait_chgmv/>
		<bg @l="24" src="day12" time="2000"/>
		<wait @l="26" time="500"/>
		<wait_chgmv/>
		<bg @l="28" src="black" time="2000"/>
		<msgshow @l="30" show="true"/>
		<goto @l="34" cond="!(f.留学生に抵抗したflag&#32;!=&#32;0)&#13;&#10;"
		   label="TempLabel_232"/>
		<goto @l="36" label="EventLabel_81"/>
		<label @l="37" id="TempLabel_232"/>
		<wait_chgmv/>
		<bg @l="41" src="bg03"/>
		<bgm @l="45" src="bgm03" volume="1."/>
		<char @l="49" id="miho" pos="auto" src="miho114"/>
		<msg @l="51" char_id="0" frame_id="-1" name="美帆" text="『いまから‥‥ですか？』"
		   voices=""/>
		<msg @l="53" char_id="-1" frame_id="-1" name="" text="朝早く、大学から部屋に電話があった。"
		   voices=""/>
		<msg @l="54" char_id="-1" frame_id="-1" name="" text="相手は渡部先生‥‥あの人だ。"
		   voices=""/>
		<msg @l="56" char_id="-1" frame_id="-1" name="渡部" text="『そうだ。なるべく早い方がいいな。』"
		   voices=""/>
		<msg @l="58" char_id="0" frame_id="-1" name="美帆" text="『どうして私が‥‥‥‥。』"
		   voices=""/>
		<msg @l="60" char_id="-1" frame_id="-1" name="渡部"
		   text="『お前の為だと思ってわざわざ電話までしてやってるんだ。』" voices=""/>
		<char @l="64" id="miho" pos="auto" src="miho015"/>
		<msg @l="66" char_id="0" frame_id="-1" name="美帆" text="『どういうこと‥‥ですか？』"
		   voices=""/>
		<msg @l="68" char_id="-1" frame_id="-1" name="渡部" text="『来ればわかる。』" voices=""/>
		<char @l="72" id="miho" pos="auto" src="miho115"/>
		<msg @l="74" char_id="0" frame_id="-1" name="美帆"
		   text="『それだけじゃわかりません。それに講義だって‥‥‥。』" voices=""/>
		<msg @l="76" char_id="-1" frame_id="-1" name="渡部"
		   text="『妹は‥‥大事にするべきだと思うがな。』" voices=""/>
		<msg @l="78" char_id="0" frame_id="-1" name="美帆" text="『え‥‥！？』" voices=""/>
		<msg @l="80" char_id="0" frame_id="-1" name="美帆" text="『妹が、亜季奈がなんなんですかっ！？』"
		   voices=""/>
		<se @l="84" buf="1" src="通話が切れた後の音" volume="1."/>
		<msg @l="86" char_id="0" frame_id="-1" name="美帆" text="『あっ‥‥。』" voices=""/>
		<msg @l="88" char_id="-1" frame_id="-1" name="" text="一方的に通話を切られてしまった。"
		   voices=""/>
		<msg @l="89" char_id="-1" frame_id="-1" name="" text="亜季奈が‥‥どうしたというのだろうか。"
		   voices=""/>
		<stopse @l="92" buf="1"/>
		<clear @l="95" class="char"/>
		<char @l="97" id="miho" pos="left" src="miho015"/>
		<char @l="100" id="rei" pos="right" src="rei030"/>
		<msg @l="102" char_id="1" frame_id="-1" name="玲" text="『なに‥‥でんわ？』" voices=""/>
		<msg @l="104" char_id="-1" frame_id="-1" name="" text="私の声で起こしてしまったのだろう。"
		   voices=""/>
		<msg @l="105" char_id="-1" frame_id="-1" name=""
		   text="目をこすりながら玲さんが部屋から出てくる。" voices=""/>
		<msg @l="107" char_id="0" frame_id="-1" name="美帆"
		   text="『ごめんなさい‥‥私、すぐに出かけます。』" voices=""/>
		<char @l="111" id="rei" pos="right" src="rei034"/>
		<msg @l="113" char_id="1" frame_id="-1" name="玲" text="『え、あ‥‥ちょっと！？』"
		   voices=""/>
		<clear @l="117" layer="miho"/>
		<msg @l="119" char_id="1" frame_id="-1" name="玲" text="『‥‥‥‥。』" voices=""/>
		<char @l="123" id="rei" pos="right" src="rei030"/>
		<msg @l="125" char_id="1" frame_id="-1" name="玲" text="『‥‥なんなの？』" voices=""/>
		<clear @l="131" class="all"/>
		<wait_chgmv/>
		<bg @l="135" src="bg07"/>
		<char @l="139" id="miho" pos="auto" src="miho115"/>
		<msg @l="141" char_id="0" frame_id="-1" name="美帆" text="『ハァ、ハァ‥‥。』"
		   voices=""/>
		<msg @l="143" char_id="-1" frame_id="-1" name=""
		   text="早朝‥‥というには少し遅い頃、私はようやくキャンパスに到着した。" voices=""/>
		<msg @l="144" char_id="-1" frame_id="-1" name=""
		   text="停留所からここまで全力で走っただけで、息がもうあがっている。" voices=""/>
		<msg @l="146" char_id="0" frame_id="-1" name="美帆" text="(亜季奈‥‥)" voices=""/>
		<clear @l="152" class="all"/>
		<wait_chgmv/>
		<bg @l="156" src="bg09"/>
		<char @l="160" id="miho" pos="auto" src="miho115"/>
		<msg @l="162" char_id="0" frame_id="-1" name="美帆" text="『プールが‥‥こんなに遠いなんて。』"
		   voices=""/>
		<msg @l="164" char_id="-1" frame_id="-1" name=""
		   text="普段はあまり感じなかったけれど、この大学は微妙に広い。" voices=""/>
		<msg @l="165" char_id="-1" frame_id="-1" name=""
		   text="校舎から校舎への移動がこんなに大変だなんて、昨日までは思いもしなかった。" voices=""/>
		<msg @l="167" char_id="0" frame_id="-1" name="美帆"
		   text="(どうして私、こんなに焦ってるのかな‥‥‥)" voices=""/>
		<msg @l="169" char_id="-1" frame_id="-1" name=""
		   text="渡部先生に、なるべく早く来た方がいいと言われたからだろうか。" voices=""/>
		<msg @l="170" char_id="-1" frame_id="-1" name="" text="いや‥‥そうじゃない。"
		   voices=""/>
		<msg @l="171" char_id="-1" frame_id="-1" name="" text="胸騒ぎがするのだ。" voices=""/>
		<msg @l="172" char_id="-1" frame_id="-1" name=""
		   text="早く、早くと‥‥何かが私を急かしているように。" voices=""/>
		<msg @l="173" char_id="-1" frame_id="-1" name="" text="何かが‥‥。" voices=""/>
		<msg @l="175" char_id="0" frame_id="-1" name="美帆"
		   text="(亜季奈‥‥大丈夫だよね、無事だよね‥‥‥！？)" voices=""/>
		<clear @l="181" class="all"/>
		<wait_chgmv/>
		<bg @l="185" src="bg10"/>
		<char @l="189" id="miho" pos="auto" src="miho115"/>
		<msg @l="191" char_id="0" frame_id="-1" name="美帆" text="『ハァ‥‥ハァ‥‥‥ハァ‥‥‥‥。』"
		   voices=""/>
		<msg @l="193" char_id="0" frame_id="-1" name="美帆" text="『あ、亜季奈‥‥‥亜季奈‥‥‥っ！？』"
		   voices=""/>
		<stopbgm @l="197" fadeout="1000"/>
		<msg @l="199" char_id="-1" frame_id="-1" name="" text="誰もいない。" voices=""/>
		<msg @l="200" char_id="-1" frame_id="-1" name="" text="渡部先生はプールに来いといっていたのに。"
		   voices=""/>
		<msg @l="201" char_id="-1" frame_id="-1" name="" text="もしかして、だまされた‥‥？"
		   voices=""/>
		<msg @l="202" char_id="-1" frame_id="-1" name="" text="だますとしても、何の為に？"
		   voices=""/>
		<msg @l="205" char_id="0" frame_id="-1" name="美帆"
		   text="『なんで誰もいないのよ‥‥‥なんで‥‥‥‥。』" voices=""/>
		<msg @l="207" char_id="2" frame_id="-1" name="声" text="『‥‥‥ぁっ‥‥‥ぅぁっ‥‥‥‥。』"
		   voices="akina00760"/>
		<msg @l="209" char_id="0" frame_id="-1" name="美帆" text="『亜季奈っ！？』"
		   voices="miho04410"/>
		<clear @l="216" class="all"/>
		<label @l="219" id="event_scene48"/>
		<msg @l="221" char_id="-1" frame_id="-1" name=""
		   text="微かに届く声を頼りに、プールサイドを駆け出した。" voices=""/>
		<msg @l="222" char_id="-1" frame_id="-1" name="" text="声は‥‥女子更衣室の方から聞こえてくる。"
		   voices=""/>
		<msg @l="224" char_id="0" frame_id="-1" name="美帆" text="『亜季奈っ！！』"
		   voices="miho04420"/>
		<label @l="228" id="chart_line22"/>
		<wait_chgmv/>
		<ev @l="232" src="ev-048"/>
		<description @l="235" text="幼きイケニエ"/>
		<bgm @l="239" src="bgm13" volume="1."/>
		<msg @l="242" char_id="-1" frame_id="-1" name="渡部" text="『よお‥‥遅かったな、仲根。』"
		   voices=""/>
		<msg @l="244" char_id="-1" frame_id="-1" name="渡部"
		   text="『悪いが先に始めさせてもらってるぞ。』" voices=""/>
		<msg @l="246" char_id="0" frame_id="-1" name="美帆" text="『あき‥‥な‥‥‥。』"
		   voices="miho04430"/>
		<msg @l="248" char_id="-1" frame_id="-1" name=""
		   text="更衣室に駆け込んですぐ、惨劇が私の視界に飛び込んでくる。" voices=""/>
		<msg @l="249" char_id="-1" frame_id="-1" name=""
		   text="渡部先生の上で揺れている、水着姿の亜季奈‥‥。" voices=""/>
		<msg @l="251" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んっ、んんっ‥‥‥やあ‥‥お姉ちゃん、見ないで‥‥‥。』" voices="akina00770"/>
		<msg @l="253" char_id="-1" frame_id="-1" name="" text="渡部先生の上で亜季奈が顔を背ける。"
		   voices=""/>
		<msg @l="254" char_id="-1" frame_id="-1" name="" text="これは‥‥どういうことだろうか。"
		   voices=""/>
		<msg @l="255" char_id="-1" frame_id="-1" name="" text="強姦されている？" voices=""/>
		<msg @l="256" char_id="-1" frame_id="-1" name="" text="なんで亜季奈は抵抗してないの？"
		   voices=""/>
		<msg @l="257" char_id="-1" frame_id="-1" name="" text="渡部先生の暴力に怯えているのだろうか？"
		   voices=""/>
		<msg @l="258" char_id="-1" frame_id="-1" name="" text="それとも‥‥。" voices=""/>
		<msg @l="260" char_id="-1" frame_id="-1" name="渡部" text="『ん？&#32;勘違いするなよ。』"
		   voices=""/>
		<msg @l="262" char_id="-1" frame_id="-1" name="渡部"
		   text="『俺と亜季奈は合意の上でセックスしてるんだ。つまりこれは強姦じゃなくて和姦ってヤツだ。』" voices=""/>
		<msg @l="264" char_id="0" frame_id="-1" name="美帆" text="『そんなっ‥‥亜季奈、どうしてっ！？』"
		   voices="miho04440"/>
		<msg @l="266" char_id="2" frame_id="-1" name="亜季奈"
		   text="『私‥‥センセイのことが好きなんだもん。』" voices="akina00780"/>
		<msg @l="268" char_id="2" frame_id="-1" name="亜季奈"
		   text="『なのに、お姉ちゃんがダメなんていうから‥‥だからっ。』" voices="akina00790"/>
		<msg @l="270" char_id="0" frame_id="-1" name="美帆" text="『だからってこんな事‥‥。』"
		   voices="miho04450"/>
		<msg @l="272" char_id="2" frame_id="-1" name="亜季奈"
		   text="『もう子供じゃないもん、私だってこれくらい‥‥平気なんだもん！』" voices="akina00800"/>
		<msg @l="274" char_id="-1" frame_id="-1" name=""
		   text="そう言うと亜季奈は自分で腰を動かし、渡部先生の肉棒を飲み込んでみせる。" voices=""/>
		<msg @l="276" char_id="-1" frame_id="-1" name="渡部"
		   text="『お、お、おおっ‥‥いいぞ、小さいマ○コがさらに締め付けてきていい具合だ。』" voices=""/>
		<msg @l="278" char_id="0" frame_id="-1" name="美帆" text="『なんてこと‥‥。』"
		   voices="miho04460"/>
		<msg @l="280" char_id="-1" frame_id="-1" name="渡部"
		   text="『ほら、お姉ちゃんにしっかりイクところを見てもらえよ。』" voices=""/>
		<msg @l="282" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んんっ‥‥あ、ああっ‥‥‥‥ダメ‥‥奥は、ダメっ‥‥狭すぎるっ！』" voices="akina00810"/>
		<msg @l="284" char_id="-1" frame_id="-1" name=""
		   text="不器用に腰を動かしていた亜季奈の下から、渡部先生が激しく突き上げる。" voices=""/>
		<msg @l="285" char_id="-1" frame_id="-1" name=""
		   text="亜季奈の小さな身体は突き上げられる度に、大きく跳ねる。" voices=""/>
		<msg @l="287" char_id="0" frame_id="-1" name="美帆" text="『あ、ああ‥‥‥あ‥‥‥‥。』"
		   voices="miho04470"/>
		<msg @l="289" char_id="-1" frame_id="-1" name=""
		   text="私は‥‥瞬きすることも出来ず、ただ亜季奈の痴態を見つめていた。" voices=""/>
		<msg @l="290" char_id="-1" frame_id="-1" name=""
		   text="何か言葉を紡ごうとしても、喉の奥からは乾いた吐息が漏れるだけだった。" voices=""/>
		<msg @l="291" char_id="-1" frame_id="-1" name="" text="大切な何かを‥‥失ってしまった気がした。"
		   voices=""/>
		<msg @l="293" char_id="-1" frame_id="-1" name="渡部"
		   text="『そら、ここが良いんだろ‥‥しっかり突き上げてやるぞ。』" voices=""/>
		<msg @l="295" char_id="2" frame_id="-1" name="亜季奈"
		   text="『ふあっ‥‥ダメ、そこ‥‥‥センセっ‥‥んああぁっ！！』" voices="akina00820"/>
		<msg @l="297" char_id="2" frame_id="-1" name="亜季奈"
		   text="『そこばっかりされたら‥‥‥‥私、わたしっ‥‥んんっ！！』" voices="akina00830"/>
		<msg @l="299" char_id="-1" frame_id="-1" name="渡部"
		   text="『まだイクなよ‥‥たっぷり我慢して、盛大にイクところをお姉ちゃんに見てもらうんだろ？』" voices=""/>
		<msg @l="301" char_id="2" frame_id="-1" name="亜季奈"
		   text="『だけど‥‥‥んんっ、だけどぉ‥‥‥ン、んんっ‥‥‥。』" voices="akina00840"/>
		<msg @l="303" char_id="2" frame_id="-1" name="亜季奈"
		   text="『あ、あ、あ、あ、ああっ‥‥‥ダメぇ‥‥我慢できなくなるよぉ！』" voices="akina00850"/>
		<msg @l="305" char_id="-1" frame_id="-1" name="渡部"
		   text="『さすがに‥‥コイツの効き目はすごいもんだな。』" voices=""/>
		<msg @l="307" char_id="-1" frame_id="-1" name=""
		   text="渡部先生は自分のすぐ脇に転がっているものを見てほくそ笑む。" voices=""/>
		<msg @l="309" char_id="-1" frame_id="-1" name="" text="つられて視線を移すと空の注射器があった。"
		   voices=""/>
		<msg @l="311" char_id="0" frame_id="-1" name="美帆" text="『それ‥‥注射器‥‥‥？』"
		   voices="miho04480"/>
		<msg @l="313" char_id="0" frame_id="-1" name="美帆"
		   text="『アナタっ‥‥亜季奈に何をしたのっ！？』" voices="miho04490"/>
		<msg @l="315" char_id="-1" frame_id="-1" name="渡部"
		   text="『特製の性感増幅剤をな、注射してやったんだよ。』" voices=""/>
		<msg @l="317" char_id="-1" frame_id="-1" name="渡部"
		   text="『効き目のほどは‥‥御覧の通りというワケだ。』" voices=""/>
		<msg @l="319" char_id="0" frame_id="-1" name="美帆" text="『そんなっ‥‥。』"
		   voices="miho04500"/>
		<msg @l="321" char_id="-1" frame_id="-1" name="渡部"
		   text="『さすがに、昨日まで処女だった女を一晩でここまで仕込むには、薬の力に頼らんと出来んからな。』" voices=""/>
		<msg @l="323" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んぁぁっ‥‥ダメ、ダメぇ‥‥‥きちゃうよぉ‥‥‥‥。』" voices="akina00860"/>
		<msg @l="325" char_id="-1" frame_id="-1" name="" text="もう、私など見えていないのだろう‥‥。"
		   voices=""/>
		<msg @l="326" char_id="-1" frame_id="-1" name=""
		   text="亜季奈は渡部先生の上でいやらしく腰を振りながら、甘く喘いでいる。" voices=""/>
		<msg @l="328" char_id="-1" frame_id="-1" name="渡部"
		   text="『お、いいぞ‥‥そのまましっかり締め付けてろよ。』" voices=""/>
		<msg @l="330" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んふっ‥‥あっ、あっ、ああっ‥‥‥いい‥‥‥いいよぉ‥‥‥。』" voices="akina00870"/>
		<msg @l="332" char_id="2" frame_id="-1" name="亜季奈"
		   text="『ああっ‥‥もうダメ‥‥‥もう、がまんできないよぉ‥‥‥‥。』" voices="akina00880"/>
		<msg @l="334" char_id="-1" frame_id="-1" name="渡部"
		   text="『仕方ねえな‥‥いま、イカせてやるよ。』" voices=""/>
		<msg @l="336" char_id="-1" frame_id="-1" name=""
		   text="そう言って、渡部先生は亜季奈の腰をギュッとつかむと激しく突き上げ始めた。" voices=""/>
		<msg @l="337" char_id="-1" frame_id="-1" name=""
		   text="亜季奈の小さな性器が渡部先生のモノで大きく拡張される。" voices=""/>
		<msg @l="338" char_id="-1" frame_id="-1" name=""
		   text="結合部の隙間から、大量の愛液と白い精液が攪拌された泡が溢れ出ていた。" voices=""/>
		<msg @l="340" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んっ、んっ、んっ、んっ、んっ‥‥んんっ！！』" voices="akina00890"/>
		<msg @l="342" char_id="2" frame_id="-1" name="亜季奈"
		   text="『いいっ‥‥いいよぉ‥‥‥‥きてぇ‥‥‥もっと奥まで来てぇ！！』" voices="akina00900"/>
		<msg @l="344" char_id="-1" frame_id="-1" name="渡部"
		   text="『いくぞっ‥‥一番奥に出してやるよっ！！』" voices=""/>
		<msg @l="346" char_id="0" frame_id="-1" name="美帆"
		   text="『え、出すって‥‥‥そんなっ‥‥‥‥。』" voices="miho04510"/>
		<msg @l="348" char_id="-1" frame_id="-1" name=""
		   text="恐ろしい言葉を聞き、慌てて止めに入ろうとするが、亜季奈の次の言葉を聞いて止まってしまう。" voices=""/>
		<msg @l="350" char_id="2" frame_id="-1" name="亜季奈"
		   text="『あふっ、おく、奥に出してっ‥‥んんっ‥‥‥‥来る、来ちゃう！！』" voices="akina00910"/>
		<msg @l="352" char_id="-1" frame_id="-1" name="渡部"
		   text="『そうだ‥‥イケッ！&#32;俺に貫かれながら、盛大にイッてる所を実の姉に見られてな！』" voices=""/>
		<msg @l="354" char_id="2" frame_id="-1" name="亜季奈"
		   text="『いく‥‥いっちゃ‥‥‥‥う、んんっ‥‥‥‥ふぁぁぁっ！！』" voices="akina00920"/>
		<flash @l="357" count="4" fade="100" image="white"/>
		<wait_chgmv/>
		<ev @l="360" src="ev-048x1z1"/>
		<msg @l="362" char_id="2" frame_id="-1" name="亜季奈" text="『んんんっ！！！』"
		   voices="akina00930"/>
		<msg @l="364" char_id="-1" frame_id="-1" name="" text="亜季奈が絶頂に昇り詰めた次の瞬間。"
		   voices=""/>
		<msg @l="365" char_id="-1" frame_id="-1" name=""
		   text="渡部先生が低い声を漏らして腰を密着させる。" voices=""/>
		<msg @l="366" char_id="-1" frame_id="-1" name=""
		   text="腰を震わせた後、二人の結合部から、膣内に収まりきらなかった白濁色の精子がドロリと溢れ出していた。" voices=""/>
		<stopbgm @l="370" fadeout="1000"/>
		<clear @l="374" class="ev"/>
		<end_scene @l="377"/>
		<wait_chgmv/>
		<bg @l="381" src="bg11"/>
		<bgm @l="385" src="bgm10" volume="1."/>
		<char @l="389" id="miho" pos="auto" src="miho015"/>
		<msg @l="391" char_id="0" frame_id="-1" name="美帆"
		   text="『あきな‥‥ごめんね、ごめんね‥‥‥。』" voices=""/>
		<msg @l="393" char_id="-1" frame_id="-1" name=""
		   text="絶頂に震えている亜季奈に‥‥私はそっとつぶやく。" voices=""/>
		<msg @l="394" char_id="-1" frame_id="-1" name=""
		   text="例えそれがもう亜季奈の心に届かない言葉だとしても‥‥。" voices=""/>
		<msg @l="395" char_id="-1" frame_id="-1" name=""
		   text="二度と‥‥取り返しのつかない事なのだとしても。" voices=""/>
		<clear @l="398" class="char"/>
		<char @l="400" id="miho" pos="left" src="miho015"/>
		<char @l="403" id="watab" pos="right" src="watabe010"/>
		<msg @l="405" char_id="-1" frame_id="-1" name="渡部"
		   text="『さて、前菜はこんなもんでいいだろ。』" voices=""/>
		<char @l="408" id="watab" pos="right" src="watabe012"/>
		<msg @l="410" char_id="-1" frame_id="-1" name="渡部"
		   text="『そろそろメインディッシュをいただかないとな。』" voices=""/>
		<msg @l="412" char_id="-1" frame_id="-1" name="" text="渡部先生が私へにじり寄ってくる。"
		   voices=""/>
		<char @l="416" id="miho" pos="left" src="miho015"/>
		<msg @l="418" char_id="0" frame_id="-1" name="美帆" text="『え‥‥な、なにを？』"
		   voices=""/>
		<char @l="421" id="watab" pos="right" src="watabe014"/>
		<msg @l="423" char_id="-1" frame_id="-1" name="渡部"
		   text="『いまさらカマトトぶっても遅いんだよ。』" voices=""/>
		<msg @l="425" char_id="-1" frame_id="-1" name="渡部"
		   text="『ここまでやってオマエだけ逃がすと思ってたのか？』" voices=""/>
		<msg @l="427" char_id="0" frame_id="-1" name="美帆"
		   text="『だってアナタは亜季奈を‥‥合意でってコトは‥‥恋人同士なんじゃないんですか。』" voices=""/>
		<char @l="430" id="watab" pos="right" src="watabe017"/>
		<msg @l="432" char_id="-1" frame_id="-1" name="渡部"
		   text="『馬鹿かオマエは。あんな小娘で誰が満足するかよ。』" voices=""/>
		<msg @l="434" char_id="-1" frame_id="-1" name="渡部"
		   text="『おまけに合意のセックスすりゃ恋人同士か？&#32;笑わせるな。』" voices=""/>
		<char @l="438" id="miho" pos="left" src="miho015"/>
		<msg @l="440" char_id="0" frame_id="-1" name="美帆"
		   text="『そんな‥‥女の子を何だと思ってるんですか！？』" voices=""/>
		<char @l="443" id="watab" pos="right" src="watabe017"/>
		<msg @l="445" char_id="-1" frame_id="-1" name="渡部"
		   text="『うだうだウルせぇんだよ！そんなことどうでもいいから、まずはコイツを着な。』" voices=""/>
		<msg @l="447" char_id="-1" frame_id="-1" name=""
		   text="渡部先生はそう言うと、私の水着を投げて渡してきた。" voices=""/>
		<char @l="450" id="miho" pos="left" src="miho115"/>
		<msg @l="452" char_id="0" frame_id="-1" name="美帆" text="『ど、どういうことですか！？』"
		   voices=""/>
		<msg @l="456" char_id="-1" frame_id="-1" name="渡部"
		   text="『いちいち質問が多い奴だな。オマエに選択肢はねぇんだよ。それを早く着ないと、大切な妹が大変な事になるぜ。』" voices=""/>
		<char @l="459" id="miho" pos="left" src="miho015"/>
		<msg @l="461" char_id="0" frame_id="-1" name="美帆"
		   text="『こ、これ以上何をするつもりなんですか！？』" voices=""/>
		<char @l="464" id="watab" pos="right" src="watabe012"/>
		<msg @l="466" char_id="-1" frame_id="-1" name="渡部"
		   text="『そうだなぁ、オマエが言う事を聞かなければ亜季奈を薬漬けにしてどっかの国に売っぱらっちまおうかなー。』" voices=""/>
		<msg @l="468" char_id="0" frame_id="-1" name="美帆" text="『そ、そんな････』"
		   voices=""/>
		<char @l="471" id="watab" pos="right" src="watabe017"/>
		<msg @l="473" char_id="-1" frame_id="-1" name="渡部"
		   text="『それが嫌なら、さっさとそれを着ろよ！』" voices=""/>
		<char @l="476" id="miho" pos="left" src="miho115"/>
		<msg @l="478" char_id="0" frame_id="-1" name="美帆" text="『････っ･･････。』"
		   voices=""/>
		<char @l="481" id="watab" pos="right" src="watabe010"/>
		<msg @l="483" char_id="-1" frame_id="-1" name="渡部"
		   text="『あぁ、逃げようとしても無駄だぜ。そんなことしたらすぐ捕まえて姉妹薬漬けにして一緒に売っぱらっちまうからなー。』" voices=""/>
		<msg @l="485" char_id="0" frame_id="-1" name="美帆" text="『･･････････。』"
		   voices=""/>
		<char @l="488" id="watab" pos="right" src="watabe017"/>
		<msg @l="490" char_id="-1" frame_id="-1" name="渡部" text="『どうするんだー！あー！？』"
		   voices=""/>
		<char @l="493" id="miho" pos="left" src="miho015"/>
		<msg @l="495" char_id="0" frame_id="-1" name="美帆" text="『わ････わかりました。』"
		   voices=""/>
		<char @l="498" id="watab" pos="right" src="watabe012"/>
		<msg @l="500" char_id="-1" frame_id="-1" name="渡部"
		   text="『最初からそう素直になってればいーんだよ。』" voices=""/>
		<msg @l="502" char_id="-1" frame_id="-1" name="" text="渡部先生は私の言葉に嬉しそうに笑った。"
		   voices=""/>
		<msg @l="503" char_id="-1" frame_id="-1" name=""
		   text="私はとにかく今は渡部先生の言葉に従ってるふりをして、逃げる機会を見つけようと思った。" voices=""/>
		<msg @l="504" char_id="-1" frame_id="-1" name=""
		   text="ここから逃げ出して人を呼んでくれば亜季奈も助けられるはずと信じて。" voices=""/>
		<clear @l="507" class="char"/>
		<clear @l="513" class="all"/>
		<msgshow @l="515" show="true"/>
		<wait_chgmv/>
		<bg @l="517" src="bg11"/>
		<char @l="520" id="miho" pos="left" src="miho165"/>
		<char @l="522" id="watab" pos="right" src="watabe012"/>
		<msg @l="524" char_id="0" frame_id="-1" name="美帆" text="『き････着替え終わりました。』"
		   voices=""/>
		<msg @l="526" char_id="-1" frame_id="-1" name=""
		   text="私は無理やり渡部先生の前で着替えさせられる。" voices=""/>
		<msg @l="527" char_id="-1" frame_id="-1" name=""
		   text="それでも何とか着替え、顔を真っ赤にし涙目になりながら着替えが終わった事を告げた。" voices=""/>
		<msg @l="529" char_id="-1" frame_id="-1" name="渡部"
		   text="『へへっ、やっぱり俺が狙っていただけあっていい身体してやがるぜ。" voices=""/>
		<msg @l="531" char_id="-1" frame_id="-1" name="渡部"
		   text="『ほら見ろよ。俺のコイツはもうこんなにビンビンになってるぜ。』" voices=""/>
		<msg @l="533" char_id="-1" frame_id="-1" name=""
		   text="そう言って渡部先生はズボンを下ろし、既に硬さを取り戻した自分の剛直を指差す。" voices=""/>
		<char @l="536" id="miho" pos="left" src="miho065"/>
		<msg @l="538" char_id="0" frame_id="-1" name="美帆" text="『くっ‥‥。』" voices=""/>
		<clear @l="542" layer="miho"/>
		<msg @l="544" char_id="-1" frame_id="-1" name=""
		   text="ズボンを下ろした今がチャンス。あの格好では追いかけてこれない‥‥そう思った私は、身を翻してドアへと走る。" voices=""/>
		<msg @l="545" char_id="-1" frame_id="-1" name=""
		   text="私の方がドアには近いのだから、このまま逃げ切れるハズだ。" voices=""/>
		<msg @l="546" char_id="-1" frame_id="-1" name="" text="‥‥そう思った。" voices=""/>
		<msg @l="548" char_id="-1" frame_id="-1" name="用務員"
		   text="『申し訳ないのですが、逃げてもらっては困るんですよ。』" voices=""/>
		<char @l="551" id="kuma" pos="right" src="kuma010"/>
		<char @l="554" id="miho" pos="left" src="miho165"/>
		<msg @l="556" char_id="0" frame_id="-1" name="美帆" text="『え‥‥。』" voices=""/>
		<msg @l="558" char_id="-1" frame_id="-1" name="留学生" text="『ミホサーン、コンニチーハ。』"
		   voices=""/>
		<msg @l="560" char_id="0" frame_id="-1" name="美帆"
		   text="『な、なんですか‥‥アナタたち‥‥‥‥。』" voices=""/>
		<msg @l="562" char_id="-1" frame_id="-1" name="用務員"
		   text="『私はここの用務員をしております、熊野といいます。』" voices=""/>
		<msg @l="564" char_id="-1" frame_id="-1" name="留学生"
		   text="『アシスタントノ、「ボビー」デース。』" voices=""/>
		<char @l="567" id="miho" pos="left" src="miho065"/>
		<msg @l="569" char_id="0" frame_id="-1" name="美帆"
		   text="『そうじゃなくて‥‥‥なんで、こんなところに‥‥‥‥。』" voices=""/>
		<char @l="573" id="watab" pos="right" src="watabe017"/>
		<msg @l="575" char_id="-1" frame_id="-1" name="渡部"
		   text="『ふん、逃げられると思っていたのか‥‥甘い奴だな。』" voices=""/>
		<msg @l="577" char_id="0" frame_id="-1" name="美帆" text="『まさか、最初から････。』"
		   voices=""/>
		<msg @l="579" char_id="-1" frame_id="-1" name="渡部"
		   text="『そうだよ。オマエには散々煮え湯を飲まされていたからな。オマエを犯しまくる為に呼んだんだよ。』" voices=""/>
		<msg @l="581" char_id="-1" frame_id="-1" name="留学生" text="『イエース、レッツプレーイ。』"
		   voices=""/>
		<char @l="585" id="kuma" pos="right" src="kuma010"/>
		<msg @l="587" char_id="-1" frame_id="-1" name="熊野"
		   text="『私たちはずっと、この時を待っていたのですからね。』" voices=""/>
		<msg @l="589" char_id="0" frame_id="-1" name="美帆" text="『そん‥‥な‥‥‥。』"
		   voices=""/>
		<char @l="593" id="watab" pos="right" src="watabe010"/>
		<msg @l="595" char_id="-1" frame_id="-1" name="渡部"
		   text="『なあに、安心していいぞ。痛い思いをしなくてもいいように‥‥魔法をかけてやるからな。』" voices=""/>
		<msg @l="597" char_id="0" frame_id="-1" name="美帆" text="『え‥‥なに‥‥‥魔法？』"
		   voices=""/>
		<msg @l="599" char_id="-1" frame_id="-1" name="熊野"
		   text="『もっとも、魔法といっても現代化学が生んだシロモノですがね。』" voices=""/>
		<flash @l="602" count="4" fade="100" image="white"/>
		<msg @l="604" char_id="0" frame_id="-1" name="美帆" text="『‥‥！？』" voices=""/>
		<msg @l="606" char_id="-1" frame_id="-1" name="" text="突然、首筋に鈍い痛みが走る。"
		   voices=""/>
		<msg @l="607" char_id="-1" frame_id="-1" name=""
		   text="次いで何かが身体の内側に流れ込んでくるような熱い感触。" voices=""/>
		<msg @l="608" char_id="-1" frame_id="-1" name=""
		   text="慌てて飛び退き振り向くと‥‥渡部先生の手には注射器が握られていた。" voices=""/>
		<char @l="611" id="miho" pos="left" src="miho164"/>
		<msg @l="613" char_id="0" frame_id="-1" name="美帆"
		   text="『何を‥‥いま、何を注射したんですかっ！？』" voices=""/>
		<msg @l="615" char_id="-1" frame_id="-1" name="渡部" text="『言っただろ、魔法だよ。』"
		   voices=""/>
		<char @l="619" id="miho" pos="left" src="miho065"/>
		<msg @l="621" char_id="0" frame_id="-1" name="美帆"
		   text="『そんな、茶化さない‥‥‥‥でっ‥‥‥‥‥。』" voices=""/>
		<stopbgm @l="625" fadeout="1000"/>
		<clear @l="631" class="all"/>
		<msg @l="633" char_id="0" frame_id="-1" name="美帆" text="(あれ‥‥？)" voices=""/>
		<msg @l="635" char_id="-1" frame_id="-1" name="" text="突然‥‥視界が暗くなる。"
		   voices=""/>
		<msg @l="636" char_id="-1" frame_id="-1" name=""
		   text="例えるなら、貧血で意識を失う寸前に似ているかもしれない。" voices=""/>
		<msg @l="637" char_id="-1" frame_id="-1" name="" text="自分ではどうにもならない意識の混濁‥‥。"
		   voices=""/>
		<msg @l="638" char_id="-1" frame_id="-1" name="" text="そして‥‥。" voices=""/>
		<msg @l="639" char_id="-1" frame_id="-1" name=""
		   text="私の意識は緩やかに闇の中へと‥‥落ちていった。" voices=""/>
		<clear @l="645" class="all"/>
		<msgshow @l="647" show="true"/>
		<label @l="651" id="chart_line23"/>
		<call @l="655" target="EventLabel_82@root_akina_c_ev01"/>
		<return @l="656" value="0&#13;&#10;"/>
		<label @l="660" id="EventLabel_81"/>
		<wait_chgmv/>
		<bg @l="664" src="bg07"/>
		<bgm @l="668" src="bgm02" volume="1."/>
		<char @l="672" id="miho" pos="auto" src="miho110"/>
		<msg @l="674" char_id="-1" frame_id="-1" name="" text="亜季奈に忠告をしそびれた翌日のこと。"
		   voices=""/>
		<msg @l="675" char_id="-1" frame_id="-1" name=""
		   text="私は、朝一番の電車に乗って大学に来ていた。" voices=""/>
		<msg @l="676" char_id="-1" frame_id="-1" name=""
		   text="今日の講義は三限だけなのだけれど、一刻も早く亜季奈に、きのう渡部先生が言っていたコトを伝えたくて‥‥。" voices=""/>
		<msg @l="677" char_id="-1" frame_id="-1" name="" text="それで急いでやってきたというワケだ。"
		   voices=""/>
		<msg @l="679" char_id="0" frame_id="-1" name="美帆" text="(亜季奈‥‥まだ宿舎にいるかな‥‥‥)"
		   voices=""/>
		<clear @l="685" class="all"/>
		<msg @l="687" char_id="-1" frame_id="-1" name=""
		   text="裏庭を通り、駐車場の脇にある宿舎を目指して歩く。" voices=""/>
		<msg @l="688" char_id="-1" frame_id="-1" name=""
		   text="何となくの場所は分っていても、いざ実際に向かうとなると勝手が違う。" voices=""/>
		<msg @l="690" char_id="0" frame_id="-1" name="美帆" text="(駐車場を横切ればすぐなのね‥‥)"
		   voices=""/>
		<msg @l="692" char_id="-1" frame_id="-1" name=""
		   text="裏庭から続いている階段を下りて駐車場を横切ると、すぐ目前に大きな和風家屋が建っていた。" voices=""/>
		<msg @l="694" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="696" char_id="0" frame_id="-1" name="美帆" text="(呼び鈴は‥‥ないか････)"
		   voices=""/>
		<se @l="700" buf="1" src="扉を開ける音_引き戸" volume="1."/>
		<msg @l="702" char_id="0" frame_id="-1" name="美帆" text="『ごめんくださーい。』"
		   voices=""/>
		<msg @l="704" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="706" char_id="0" frame_id="-1" name="美帆" text="『‥‥･･誰も出ないか･･。』"
		   voices=""/>
		<msg @l="708" char_id="-1" frame_id="-1" name=""
		   text="玄関を開けて声をかけるが、出てくる気配は無い。" voices=""/>
		<wait_chgmv/>
		<bg @l="712" src="bg20"/>
		<char @l="716" id="miho" pos="auto" src="miho110"/>
		<msg @l="718" char_id="0" frame_id="-1" name="美帆" text="『あの、誰かいませんかー？』"
		   voices=""/>
		<msg @l="720" char_id="-1" frame_id="-1" name=""
		   text="仕方なく‥‥失礼とは思いながらも中に入って声をかけてみる。" voices=""/>
		<msg @l="721" char_id="-1" frame_id="-1" name=""
		   text="もしかすると、私の声が届いていないのかもしれない。" voices=""/>
		<msg @l="723" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="725" char_id="0" frame_id="-1" name="美帆"
		   text="(誰も居ない‥‥もしかして、みんなもうプールなのかな？)" voices=""/>
		<wait_chgmv/>
		<bg @l="729" src="bg20"/>
		<char @l="733" id="miho" pos="auto" src="miho110"/>
		<msg @l="735" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="737" char_id="-1" frame_id="-1" name="声" text="『こちらに何のご用ですかな？』"
		   voices=""/>
		<char @l="741" id="miho" pos="auto" src="miho014"/>
		<msg @l="743" char_id="0" frame_id="-1" name="美帆" text="『ひッ！？』" voices=""/>
		<msg @l="745" char_id="-1" frame_id="-1" name=""
		   text="後ろから突然声をかけられ、私は思わず悲鳴を上げそうになる。" voices=""/>
		<msg @l="747" char_id="-1" frame_id="-1" name="声" text="『おっと‥‥どうしました？』"
		   voices=""/>
		<msg @l="749" char_id="-1" frame_id="-1" name="" text="が、声は聞き覚えのあるものだった。"
		   voices=""/>
		<clear @l="752" class="char"/>
		<char @l="754" id="miho" pos="left" src="miho010"/>
		<char @l="757" id="kuma" pos="right" src="kuma010"/>
		<msg @l="759" char_id="0" frame_id="-1" name="美帆" text="『あ‥‥用務員さん。』"
		   voices=""/>
		<msg @l="761" char_id="-1" frame_id="-1" name=""
		   text="振り返った先に居たのは、用務員さんだった。" voices=""/>
		<msg @l="762" char_id="-1" frame_id="-1" name=""
		   text="そういえば昨日電話した時に出たのも用務員さんだったし、この建物を管理しているようなコトを言っていた。" voices=""/>
		<msg @l="763" char_id="-1" frame_id="-1" name=""
		   text="普段から‥‥ここに出入りしているのだろう。" voices=""/>
		<char @l="767" id="miho" pos="left" src="miho016"/>
		<msg @l="769" char_id="0" frame_id="-1" name="美帆"
		   text="『す、すみませんっ‥‥声をかけても出て来られなかったので、てっきり私の声が聞こえてないのかと思って、勝手に上がっちゃって‥‥‥。』"
		   voices=""/>
		<msg @l="771" char_id="-1" frame_id="-1" name="熊野" text="『別にかまいませんよ。』"
		   voices=""/>
		<msg @l="773" char_id="-1" frame_id="-1" name="熊野" text="『貴女は‥‥昨日の電話の人ですね？』"
		   voices=""/>
		<char @l="777" id="miho" pos="left" src="miho014"/>
		<msg @l="779" char_id="0" frame_id="-1" name="美帆" text="『え‥‥あ、はいっ。』"
		   voices=""/>
		<char @l="783" id="miho" pos="left" src="miho016"/>
		<msg @l="785" char_id="0" frame_id="-1" name="美帆"
		   text="『昨晩はいきなりの電話で失礼しました‥‥。』" voices=""/>
		<msg @l="787" char_id="-1" frame_id="-1" name="熊野"
		   text="『いえいえ、こちらこそ何の役にも立ちませんで。』" voices=""/>
		<msg @l="789" char_id="-1" frame_id="-1" name="熊野"
		   text="『それで‥‥今日はどんなご用向きですかな？』" voices=""/>
		<char @l="793" id="miho" pos="left" src="miho014"/>
		<msg @l="795" char_id="0" frame_id="-1" name="美帆"
		   text="『あ、そうだ！&#32;合宿に来ている子たちはどこへ行ったんですか？』" voices=""/>
		<msg @l="797" char_id="-1" frame_id="-1" name="熊野"
		   text="『ああ、あの子たちなら今ごろ大学の周りを走ってるハズですよ。』" voices=""/>
		<msg @l="799" char_id="-1" frame_id="-1" name="熊野"
		   text="『この時間は、いつもそうしているようですから。』" voices=""/>
		<char @l="803" id="miho" pos="left" src="miho010"/>
		<msg @l="805" char_id="0" frame_id="-1" name="美帆" text="『そっか‥‥筋トレ中なんですね。』"
		   voices=""/>
		<msg @l="807" char_id="-1" frame_id="-1" name=""
		   text="そういえば‥‥亜季奈たちがプールで泳いでいる以外の時間をどう過ごしているのか、いま初めて知った気がする。" voices=""/>
		<msg @l="808" char_id="-1" frame_id="-1" name=""
		   text="自分も現役の頃はそうしていたし、当たり前といえば当たり前なのだが。" voices=""/>
		<msg @l="810" char_id="0" frame_id="-1" name="美帆" text="『午前中はずっと外なんですか？』"
		   voices=""/>
		<msg @l="812" char_id="-1" frame_id="-1" name="熊野"
		   text="『さて‥‥詳しいコトまでは分かりませんけど、お昼に一度戻ってくる以外はずっと外に出ているようですよ。』" voices=""/>
		<msg @l="814" char_id="0" frame_id="-1" name="美帆" text="『そうですか‥‥。』"
		   voices=""/>
		<msg @l="816" char_id="0" frame_id="-1" name="美帆"
		   text="(やっぱり、午後の練習が始まる前の方が確実かな)" voices=""/>
		<msg @l="818" char_id="-1" frame_id="-1" name="熊野"
		   text="『何か伝言がありましたら、言付かりましょうか？』" voices=""/>
		<char @l="822" id="miho" pos="left" src="miho016"/>
		<msg @l="824" char_id="0" frame_id="-1" name="美帆"
		   text="『あ、いえ‥‥また後で会いに来ますから、大丈夫です。』" voices=""/>
		<msg @l="826" char_id="-1" frame_id="-1" name="熊野" text="『そうですか。』" voices=""/>
		<msg @l="828" char_id="0" frame_id="-1" name="美帆"
		   text="『いきなりお邪魔してすみませんでした。』" voices=""/>
		<msg @l="830" char_id="-1" frame_id="-1" name="熊野" text="『いえいえ。』" voices=""/>
		<clear @l="836" class="all"/>
		<wait_chgmv/>
		<bg @l="840" src="bg07"/>
		<char @l="844" id="miho" pos="auto" src="miho110"/>
		<msg @l="846" char_id="-1" frame_id="-1" name="" text="裏庭を経て、キャンパスへと戻ってくる。"
		   voices=""/>
		<msg @l="847" char_id="-1" frame_id="-1" name=""
		   text="何の収穫もなく‥‥ただ時間を浪費してしまったという感じだ。" voices=""/>
		<msg @l="848" char_id="-1" frame_id="-1" name=""
		   text="闇雲に学内を歩き回っていても、亜季奈に会える確率は低いだろう。" voices=""/>
		<msg @l="849" char_id="-1" frame_id="-1" name="" text="プールでの練習時間に行けば確実に会える。"
		   voices=""/>
		<msg @l="850" char_id="-1" frame_id="-1" name=""
		   text="私はそう考え、それまで講義に出て時間をつぶそうと思った。" voices=""/>
		<msg @l="852" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="854" char_id="0" frame_id="-1" name="美帆"
		   text="『亜季奈･･････どの辺にいるのかな･･････。』" voices=""/>
		<msg @l="856" char_id="-1" frame_id="-1" name=""
		   text="学内のどこかにいる亜季奈に思いを馳せて呟いた････。" voices=""/>
		<stopbgm @l="860" fadeout="1000"/>
		<clear @l="866" class="all"/>
		<msgshow @l="868" show="true"/>
		<wait_chgmv/>
		<bg @l="872" src="bg10m1"/>
		<bgm @l="876" src="bgm03" volume="1."/>
		<char @l="880" id="miho" pos="auto" src="miho166"/>
		<msg @l="882" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="884" char_id="-1" frame_id="-1" name=""
		   text="講義を終えた私は急いで室内プールへと赴いたが‥‥遅かった。" voices=""/>
		<msg @l="885" char_id="-1" frame_id="-1" name=""
		   text="水泳部の子たちは既に練習を始めていたし、なにより‥‥。" voices=""/>
		<msg @l="893" char_id="-1" frame_id="-1" name=""
		   text="プールのコース一つ貸し切り状態で、亜季奈と渡部先生が練習をしていた。" voices=""/>
		<msg @l="894" char_id="-1" frame_id="-1" name=""
		   text="二人とも常に一緒で‥‥ともすればべったりという表現が一番それらしい。" voices=""/>
		<msg @l="895" char_id="-1" frame_id="-1" name="" text="‥‥これでは忠告とかいう以前の問題だ。"
		   voices=""/>
		<msg @l="897" char_id="0" frame_id="-1" name="美帆" text="(亜季奈‥‥その人はダメなのよ‥‥‥)"
		   voices=""/>
		<msg @l="899" char_id="-1" frame_id="-1" name=""
		   text="私は何とか亜季奈が一人になるタイミングを狙うのだが、こちらもコーチをしに来ているという手前、どうしても自由が少ない。"
		   voices=""/>
		<msg @l="900" char_id="-1" frame_id="-1" name=""
		   text="ちょうど良く亜季奈が一人になったと思うと、決まって泳ぎを見て欲しいと言われ、私のほうが身動きの出来ない状況になってしまう。"
		   voices=""/>
		<msg @l="902" char_id="0" frame_id="-1" name="美帆" text="(亜季奈‥‥)" voices=""/>
		<clear @l="912" class="char"/>
		<msg @l="917" char_id="-1" frame_id="-1" name="渡部"
		   text="『ほら、お前のお姉ちゃんが心配そうにコッチを見てるぞ？』" voices=""/>
		<msg @l="919" char_id="2" frame_id="-1" name="亜季奈" text="『うん‥‥。』" voices=""/>
		<msg @l="921" char_id="-1" frame_id="-1" name="渡部" text="『どうした、行ってやったらどうだ？』"
		   voices=""/>
		<msg @l="923" char_id="2" frame_id="-1" name="亜季奈"
		   text="『‥‥そんな‥‥‥センセイ、意地悪しないで‥‥‥。』" voices=""/>
		<msg @l="925" char_id="-1" frame_id="-1" name="渡部"
		   text="『意地悪？&#32;何の事だか解らんなあ？』" voices=""/>
		<msg @l="927" char_id="-1" frame_id="-1" name=""
		   text="そうして口元を歪めながら、渡部の手は水中で亜季奈の秘部を弄っていた。" voices=""/>
		<msg @l="928" char_id="-1" frame_id="-1" name=""
		   text="亜季奈は頬を桜色に染めて‥‥指先の動きに腰を震わせている。" voices=""/>
		<msg @l="930" char_id="-1" frame_id="-1" name="渡部"
		   text="『昨日のアレがそんなに良かったのか、亜季奈？』" voices=""/>
		<msg @l="932" char_id="2" frame_id="-1" name="亜季奈"
		   text="『うん‥‥センセイ、すごいんだもん。』" voices=""/>
		<msg @l="934" char_id="2" frame_id="-1" name="亜季奈"
		   text="『エッチがあんなに気持ち良いなんて‥‥知らなかったよ。』" voices=""/>
		<msg @l="936" char_id="-1" frame_id="-1" name="渡部"
		   text="『そうか。なら、もっと気持ち良くなりたいか？』" voices=""/>
		<msg @l="938" char_id="2" frame_id="-1" name="亜季奈"
		   text="『なりたい‥‥もっともっと、気持ち良くなりたい。』" voices=""/>
		<msg @l="940" char_id="-1" frame_id="-1" name=""
		   text="そう言って渡部を見る亜季奈の瞳は、既に熱く潤んでいた。" voices=""/>
		<msg @l="941" char_id="-1" frame_id="-1" name=""
		   text="水着の上から淫核を擦り上げられる度、口元からは絶えず熱のこもった吐息が漏れ‥‥口腔の中では物欲しげに舌先が震えている。"
		   voices=""/>
		<msg @l="943" char_id="-1" frame_id="-1" name="渡部"
		   text="『よし‥‥なら、そこのコースロープに背中をつけろ。』" voices=""/>
		<msg @l="945" char_id="2" frame_id="-1" name="亜季奈" text="『なにするの‥‥？』"
		   voices=""/>
		<msg @l="947" char_id="-1" frame_id="-1" name="渡部"
		   text="『気持ちよくして欲しいんだろ？&#32;黙って言うことを聞きな。』" voices=""/>
		<msg @l="949" char_id="2" frame_id="-1" name="亜季奈" text="『う、うん‥‥。』"
		   voices=""/>
		<clear @l="955" class="all"/>
		<label @l="958" id="event_scene21"/>
		<label @l="962" id="chart_line16"/>
		<wait_chgmv/>
		<ev @l="966" src="ev-021"/>
		<description @l="969" text="秘密の交わり"/>
		<bgm @l="973" src="bgm10" volume="1."/>
		<msg @l="975" char_id="2" frame_id="-1" name="亜季奈" text="『んんっ‥‥。』"
		   voices="akina00940"/>
		<msg @l="977" char_id="-1" frame_id="-1" name=""
		   text="コースロープにもたれ掛かり、愛撫で開いた秘裂に肉棒を突き入れられる亜季奈。" voices=""/>
		<msg @l="978" char_id="-1" frame_id="-1" name=""
		   text="その表情は困惑に彩られており、周囲の視線に怯えて見える。" voices=""/>
		<msg @l="980" char_id="-1" frame_id="-1" name="渡部"
		   text="『怖いか？&#32;お姉ちゃんにみつかったらどうしようってな。』" voices=""/>
		<msg @l="982" char_id="2" frame_id="-1" name="亜季奈"
		   text="『いやぁ‥‥お姉ちゃんには見られたくないよっ。』" voices="akina00950"/>
		<msg @l="984" char_id="-1" frame_id="-1" name="渡部"
		   text="『ほう、ならそれ以外には見られてもいいワケだ？』" voices=""/>
		<msg @l="986" char_id="2" frame_id="-1" name="亜季奈"
		   text="『べ、別にそう言うわけじゃ‥‥ん、ああっ！！』" voices="akina00960"/>
		<msg @l="988" char_id="-1" frame_id="-1" name=""
		   text="亜季奈の言葉をさえぎるように、渡部が腰を動かして膣肉をかき混ぜる。" voices=""/>
		<msg @l="990" char_id="2" frame_id="-1" name="亜季奈"
		   text="『あ、んくっ‥‥‥まだ‥‥ちょっと痛いかも‥‥‥‥‥。』" voices="akina00970"/>
		<msg @l="992" char_id="-1" frame_id="-1" name="渡部"
		   text="『お前は淫乱だからな、こうやっているうちにすぐに馴染んで良くなる。』" voices=""/>
		<msg @l="994" char_id="2" frame_id="-1" name="亜季奈"
		   text="『い、淫乱なんかじゃないもんっ‥‥‥。』" voices="akina00980"/>
		<msg @l="996" char_id="-1" frame_id="-1" name="渡部"
		   text="『その割に、お前のココは痛いくらいに締め付けてくるけどな？』" voices=""/>
		<msg @l="998" char_id="2" frame_id="-1" name="亜季奈"
		   text="『それはっ‥‥‥んんっ‥‥‥あ、いやっ‥‥‥‥。』" voices="akina00990"/>
		<msg @l="1000" char_id="-1" frame_id="-1" name=""
		   text="渡部の指先が、広く押し割られた割れ目の上側にある突起をひねる。" voices=""/>
		<msg @l="1001" char_id="-1" frame_id="-1" name=""
		   text="それだけで亜季奈の膣内には大量の蜜がにじみ出し、熱くなった。" voices=""/>
		<msg @l="1003" char_id="2" frame_id="-1" name="亜季奈"
		   text="『やあ‥‥そこ、弱いからっ‥‥‥‥んっ、んんっ‥‥ダメぇ‥‥。』" voices="akina01000"/>
		<msg @l="1005" char_id="-1" frame_id="-1" name="渡部"
		   text="『なんだ、気持ちよくして欲しいんだろ？』" voices=""/>
		<msg @l="1007" char_id="2" frame_id="-1" name="亜季奈"
		   text="『で、でもっ‥‥‥んくっ、こんな所じゃ‥‥‥‥ふあっ！』" voices="akina01010"/>
		<msg @l="1009" char_id="-1" frame_id="-1" name="渡部"
		   text="『安心しろ、お姉ちゃんは連中の指導でてんてこ舞いだよ。』" voices=""/>
		<msg @l="1011" char_id="-1" frame_id="-1" name="渡部"
		   text="『あと三十分はこっちを見てる暇もないハズだ。』" voices=""/>
		<msg @l="1013" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んっ‥‥けど、声っ‥‥‥出したら、バレちゃうよぉ‥‥‥。』" voices="akina01020"/>
		<msg @l="1015" char_id="-1" frame_id="-1" name="渡部" text="『なら、声を出さなけりゃ良い。』"
		   voices=""/>
		<msg @l="1017" char_id="2" frame_id="-1" name="亜季奈"
		   text="『そんなっ‥‥‥んっ、あっ、あっ、ああっ！！』" voices="akina01030"/>
		<msg @l="1019" char_id="-1" frame_id="-1" name=""
		   text="渡部が腰の律動を早めると、亜季奈の小さな身体はそれに突き動かされてゆらゆらと揺れる。" voices=""/>
		<msg @l="1020" char_id="-1" frame_id="-1" name=""
		   text="水の浮力で体全体が浮き上がるようになり、渡部の男根に意識が集中してしまう。" voices=""/>
		<msg @l="1021" char_id="-1" frame_id="-1" name="" text="二人を中心にして、プールに小波が立つ。"
		   voices=""/>
		<msg @l="1023" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んんっ‥‥センセイの‥‥‥んっ、すごく熱い‥‥‥‥。』" voices="akina01040"/>
		<msg @l="1025" char_id="-1" frame_id="-1" name="渡部"
		   text="『好きなんだろ？&#32;この熱いのが。』" voices=""/>
		<msg @l="1027" char_id="2" frame_id="-1" name="亜季奈"
		   text="『う、うんっ‥‥‥熱くておっきくて硬いおち○ちん、大好きっ。』" voices="akina01050"/>
		<msg @l="1029" char_id="-1" frame_id="-1" name="渡部" text="『やっぱお前は淫乱だな、亜季奈。』"
		   voices=""/>
		<msg @l="1031" char_id="2" frame_id="-1" name="亜季奈"
		   text="『うあっ‥‥んっ、んっ、んっ‥‥‥やあっ、届いちゃってるよっ。』" voices="akina01060"/>
		<msg @l="1033" char_id="2" frame_id="-1" name="亜季奈"
		   text="『奥まで熱いのがきて‥‥んっ、ああっ‥‥‥ジンジンする‥‥‥。』" voices="akina01070"/>
		<msg @l="1035" char_id="-1" frame_id="-1" name="渡部"
		   text="『おう、こっちも締まりがよくて‥‥‥搾り取られそうだ。』" voices=""/>
		<msg @l="1037" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んぁっ‥‥また、おち○ちんがおっきくなったよっ？』" voices="akina01080"/>
		<msg @l="1039" char_id="-1" frame_id="-1" name="渡部"
		   text="『ああ、このまま中に出してやるからな。』" voices=""/>
		<msg @l="1041" char_id="2" frame_id="-1" name="亜季奈"
		   text="『いいよっ‥‥来てぇ‥‥‥センセイの熱いミルク、たくさん注いで欲しい‥‥‥。』" voices="akina01090"/>
		<msg @l="1043" char_id="-1" frame_id="-1" name="渡部" text="『ハハッ、言うようになったな。』"
		   voices=""/>
		<msg @l="1045" char_id="-1" frame_id="-1" name="渡部"
		   text="『いいぞ‥‥オマエの一番奥に、子宮に注いでやる。』" voices=""/>
		<msg @l="1047" char_id="-1" frame_id="-1" name=""
		   text="そうして、渡部は腰を突き込み、亜季奈の蜜芯の奥深くへと剛棒を押し込む。" voices=""/>
		<msg @l="1048" char_id="-1" frame_id="-1" name="" text="渡部のモノが全て亜季奈の中に消える。"
		   voices=""/>
		<msg @l="1049" char_id="-1" frame_id="-1" name=""
		   text="膣道より長い渡部の剛直は、亜季奈の内臓を押し上げていた。" voices=""/>
		<msg @l="1051" char_id="2" frame_id="-1" name="亜季奈"
		   text="『あふっ‥‥んぅ、あっ、あっ、あっ、んくっ！！』" voices="akina01100"/>
		<msg @l="1053" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んっ、ああっ‥‥‥おく‥‥‥‥届いてっ‥‥‥‥んんっ！！！』" voices="akina01110"/>
		<flash @l="1057" count="4" fade="100" image="white"/>
		<wait_chgmv/>
		<ev @l="1061" src="ev-021x1"/>
		<msg @l="1063" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んんっ‥‥‥すごい、流れ込んでくるよぉ‥‥‥‥。』" voices="akina01120"/>
		<msg @l="1065" char_id="-1" frame_id="-1" name=""
		   text="亜季奈の膣内に注ぎ込まれた精液が溢れ出し、プールの水を汚す。" voices=""/>
		<msg @l="1066" char_id="-1" frame_id="-1" name=""
		   text="それも、排水溝へと流れていく水に紛れてすぐに姿を消すのだろう。" voices=""/>
		<msg @l="1068" char_id="-1" frame_id="-1" name="渡部"
		   text="『どうだ、オマエの大好きなミルクの味は？』" voices=""/>
		<msg @l="1070" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んっ‥‥‥熱くて、気持ち良い‥‥‥‥。』" voices="akina01130"/>
		<msg @l="1072" char_id="-1" frame_id="-1" name="渡部" text="『そりゃ良かった。』"
		   voices=""/>
		<clear @l="1078" class="all"/>
		<end_scene @l="1081"/>
		<wait_chgmv/>
		<bg @l="1085" src="bg10m1"/>
		<char @l="1089" id="akina" pos="auto" src="akina165"/>
		<msg @l="1094" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んっ‥‥なんか、染み出してきちゃいそう。』" voices=""/>
		<msg @l="1096" char_id="-1" frame_id="-1" name="渡部" text="『途中でこぼしてバレるなよ。』"
		   voices=""/>
		<msg @l="1098" char_id="2" frame_id="-1" name="亜季奈" text="『う、うん‥‥。』"
		   voices=""/>
		<msg @l="1100" char_id="-1" frame_id="-1" name="渡部"
		   text="『おっと‥‥オマエのお姉ちゃんがスゴイ形相で睨んでやがる。』" voices=""/>
		<msg @l="1102" char_id="-1" frame_id="-1" name="渡部"
		   text="『俺は他の連中を見てくるから、オマエは適当にシャワーでも浴びて来い。』" voices=""/>
		<char @l="1105" id="akina" pos="auto" src="akina060"/>
		<msg @l="1107" char_id="2" frame_id="-1" name="亜季奈"
		   text="『わかった‥‥お姉ちゃんには、なんて言えばいいの？』" voices=""/>
		<msg @l="1109" char_id="-1" frame_id="-1" name="渡部"
		   text="『これからも気持ちよくして欲しければ、何も言うな。』" voices=""/>
		<msg @l="1111" char_id="2" frame_id="-1" name="亜季奈"
		   text="『‥‥うん、気持ちよくして欲しい。』" voices=""/>
		<msg @l="1113" char_id="-1" frame_id="-1" name="渡部"
		   text="『なら、上手く誤魔化しておけ‥‥それが出来たらまた後で可愛がってやる。』" voices=""/>
		<char @l="1117" id="akina" pos="auto" src="akina061"/>
		<msg @l="1119" char_id="2" frame_id="-1" name="亜季奈"
		   text="『ほんと？&#32;約束だからね！？』" voices=""/>
		<msg @l="1121" char_id="-1" frame_id="-1" name="渡部" text="『ああ、約束だ。』"
		   voices=""/>
		<msg @l="1123" char_id="2" frame_id="-1" name="亜季奈"
		   text="『うん！&#32;ちゃんとごまかしておく！』" voices=""/>
		<msg @l="1125" char_id="-1" frame_id="-1" name="渡部" text="『ああ、上手くやれよ。』"
		   voices=""/>
		<msg @l="1130" char_id="-1" frame_id="-1" name=""
		   text="そうして渡部はわざとらしく美帆を一瞥した後、部員たちが泳いでいる反対側のコースに向かって歩いていく。" voices=""/>
		<msg @l="1131" char_id="-1" frame_id="-1" name=""
		   text="美帆は‥‥立ち去る渡部を睨みつけながらも、指導を頼まれる合間を縫うようにして亜季奈の居るプールサイドへと歩み寄ってきた。"
		   voices=""/>
		<bgm @l="1135" src="bgm03" volume="1."/>
		<clear @l="1138" class="char"/>
		<char @l="1140" id="akina" pos="left" src="akina060"/>
		<char @l="1143" id="miho" pos="right" src="miho160"/>
		<msg @l="1145" char_id="0" frame_id="-1" name="美帆" text="『ちょっと話があるんだけど、いい？』"
		   voices=""/>
		<msg @l="1147" char_id="2" frame_id="-1" name="亜季奈" text="『‥‥‥‥。』" voices=""/>
		<msg @l="1149" char_id="0" frame_id="-1" name="美帆" text="『亜季奈‥‥？』" voices=""/>
		<char @l="1153" id="akina" pos="left" src="akina067"/>
		<msg @l="1155" char_id="2" frame_id="-1" name="亜季奈"
		   text="『ごめん、お姉ちゃん‥‥いまちょっと話をする気分じゃないんだ。』" voices=""/>
		<msg @l="1157" char_id="0" frame_id="-1" name="美帆" text="『すぐに済むから、お願い‥‥。』"
		   voices=""/>
		<msg @l="1159" char_id="2" frame_id="-1" name="亜季奈" text="『また今度にしてくれないかな。』"
		   voices=""/>
		<char @l="1162" id="akina" pos="left" src="akina164"/>
		<msg @l="1164" char_id="2" frame_id="-1" name="亜季奈" text="『あっ！？』" voices=""/>
		<char @l="1167" id="miho" pos="right" src="miho064"/>
		<msg @l="1169" char_id="0" frame_id="-1" name="美帆" text="『ど、どうしたの亜季奈？』"
		   voices=""/>
		<char @l="1172" id="akina" pos="left" src="akina065"/>
		<msg @l="1174" char_id="-1" frame_id="-1" name=""
		   text="亜季奈の膣口から先ほど射精された精液が垂れ、水着の股の部分に触れる。" voices=""/>
		<char @l="1177" id="akina" pos="left" src="akina061"/>
		<msg @l="1179" char_id="2" frame_id="-1" name="亜季奈"
		   text="『な、なんでもないよ‥‥なんでも。』" voices=""/>
		<char @l="1182" id="miho" pos="right" src="miho066"/>
		<msg @l="1184" char_id="0" frame_id="-1" name="美帆"
		   text="『でもなんか顔が赤いし‥‥一緒に医務室に行く？』" voices=""/>
		<msg @l="1186" char_id="-1" frame_id="-1" name=""
		   text="表情では平静を装いながら、必死に膣に力を入れ入り口を締めようとする亜季奈。" voices=""/>
		<msg @l="1187" char_id="-1" frame_id="-1" name=""
		   text="しかし、無情にも最初の一滴が内腿から染み出てきた。" voices=""/>
		<msg @l="1188" char_id="-1" frame_id="-1" name=""
		   text="競泳用水着の恥丘に、うっすらと白いシミが滲む。" voices=""/>
		<char @l="1191" id="akina" pos="left" src="akina164"/>
		<msg @l="1193" char_id="2" frame_id="-1" name="亜季奈" text="『はうっ！？』" voices=""/>
		<char @l="1196" id="miho" pos="right" src="miho164"/>
		<msg @l="1198" char_id="0" frame_id="-1" name="美帆" text="『あ、亜季奈、大丈夫っ？』"
		   voices=""/>
		<char @l="1202" id="akina" pos="left" src="akina067"/>
		<msg @l="1204" char_id="2" frame_id="-1" name="亜季奈" text="『な、なんでもないったら！』"
		   voices=""/>
		<char @l="1207" id="miho" pos="right" src="miho065"/>
		<msg @l="1209" char_id="0" frame_id="-1" name="美帆" text="『‥‥っ！！』" voices=""/>
		<msg @l="1211" char_id="2" frame_id="-1" name="亜季奈" text="『‥‥‥‥。』" voices=""/>
		<msg @l="1213" char_id="2" frame_id="-1" name="亜季奈"
		   text="『私、汗かいちゃったからシャワー浴びてくるっ！‥‥じゃあね。』" voices=""/>
		<clear @l="1217" layer="akina"/>
		<char @l="1221" id="miho" pos="right" src="miho064"/>
		<msg @l="1223" char_id="0" frame_id="-1" name="美帆" text="『あ、亜季奈っ‥‥？』"
		   voices=""/>
		<msg @l="1225" char_id="-1" frame_id="-1" name=""
		   text="一方的に話を切り上げて更衣室へと向かう亜季奈。" voices=""/>
		<msg @l="1226" char_id="-1" frame_id="-1" name=""
		   text="美帆は引きとめようと手を伸ばすが、肩に手を置く勇気が無い。" voices=""/>
		<msg @l="1227" char_id="-1" frame_id="-1" name="" text="亜季奈はそのまま向こうへ行った。"
		   voices=""/>
		<char @l="1231" id="miho" pos="right" src="miho166"/>
		<msg @l="1233" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="1235" char_id="-1" frame_id="-1" name=""
		   text="室内プールを去っていく亜季奈の背中を、美帆は一人寂しげな表情を浮かべて見詰めていた‥‥。" voices=""/>
		<clear @l="1241" class="all"/>
		<wait_chgmv/>
		<bg @l="1245" src="bg07b"/>
		<char @l="1249" id="miho" pos="auto" src="miho116"/>
		<msg @l="1251" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="1253" char_id="-1" frame_id="-1" name=""
		   text="室内プールのある体育館の前で、私は亜季奈が出てくるのを待っていた。" voices=""/>
		<msg @l="1254" char_id="-1" frame_id="-1" name=""
		   text="プールサイドでは理由も解らないうちに避けられてしまったけれど、だからといってそのまま放っておくコトなんて出来ない。"
		   voices=""/>
		<msg @l="1255" char_id="-1" frame_id="-1" name=""
		   text="もしかしたら渡部先生に脅迫されて‥‥という可能性もありえるのだ。" voices=""/>
		<msg @l="1257" char_id="0" frame_id="-1" name="美帆"
		   text="(さっきのは‥‥もしかして機嫌が悪かっただけかもしれないし)" voices=""/>
		<msg @l="1259" char_id="0" frame_id="-1" name="美帆"
		   text="(ちゃんと順番に理由を話せば、亜季奈だってわかってくれるよね)" voices=""/>
		<msg @l="1261" char_id="-1" frame_id="-1" name=""
		   text="私は半ば自分に言い聞かせるように、心の中で呟く。" voices=""/>
		<msg @l="1262" char_id="-1" frame_id="-1" name=""
		   text="さっきの亜季奈の態度は‥‥あからさまに私を避けていた。" voices=""/>
		<msg @l="1263" char_id="-1" frame_id="-1" name=""
		   text="それも含めてキッチリ話をつけないと･･････。" voices=""/>
		<clear @l="1267" class="char"/>
		<msg @l="1269" char_id="0" frame_id="-1" name="美帆" text="(それにしても‥‥亜季奈、遅いな)"
		   voices=""/>
		<msg @l="1271" char_id="-1" frame_id="-1" name=""
		   text="結局、シャワーを浴びるといって室内プールを出て行ったまま亜季奈は戻ってこなかった。" voices=""/>
		<msg @l="1272" char_id="-1" frame_id="-1" name=""
		   text="もしかしたら先に宿舎へ戻ったのかと思ったけれど‥‥亜季奈が普段から使っているロッカーにはしっかりと鍵が掛かっていたから中に居ることは確かだ。"
		   voices=""/>
		<char @l="1276" id="akina" pos="auto" src="akina010"/>
		<msg @l="1278" char_id="2" frame_id="-1" name="亜季奈" text="『‥‥‥‥。』" voices=""/>
		<msg @l="1280" char_id="0" frame_id="-1" name="美帆" text="『あ、亜季奈っ。』"
		   voices=""/>
		<clear @l="1283" class="char"/>
		<char @l="1285" id="akina" pos="left" src="akina010"/>
		<char @l="1288" id="miho" pos="right" src="miho111"/>
		<msg @l="1290" char_id="-1" frame_id="-1" name="" text="体育館の入り口から亜季奈が出てくる。"
		   voices=""/>
		<msg @l="1291" char_id="-1" frame_id="-1" name=""
		   text="私は声をかけながら駆け寄り、隣に並んだ。" voices=""/>
		<msg @l="1293" char_id="0" frame_id="-1" name="美帆"
		   text="『遅かったね、途中まで一緒に帰ろうよ。』" voices=""/>
		<char @l="1297" id="akina" pos="left" src="akina014"/>
		<msg @l="1299" char_id="2" frame_id="-1" name="亜季奈" text="『‥‥なんで待ってたの？』"
		   voices=""/>
		<char @l="1303" id="miho" pos="right" src="miho011"/>
		<msg @l="1305" char_id="0" frame_id="-1" name="美帆"
		   text="『え、なんでって‥‥いつもそうしてるじゃない。』" voices=""/>
		<msg @l="1307" char_id="2" frame_id="-1" name="亜季奈" text="『‥‥‥‥。』" voices=""/>
		<char @l="1311" id="akina" pos="left" src="akina017"/>
		<msg @l="1313" char_id="2" frame_id="-1" name="亜季奈"
		   text="『今日は誰とも話したくないから‥‥一人で帰ってよ。』" voices=""/>
		<char @l="1317" id="miho" pos="right" src="miho116"/>
		<msg @l="1319" char_id="0" frame_id="-1" name="美帆"
		   text="『でもっ‥‥私････亜季奈に話があるから‥‥‥。』" voices=""/>
		<char @l="1323" id="akina" pos="left" src="akina117"/>
		<msg @l="1326" char_id="2" frame_id="-1" name="亜季奈" text="『私は話したくない。』"
		   voices=""/>
		<msg @l="1328" char_id="0" frame_id="-1" name="美帆" text="『そんな‥‥。』" voices=""/>
		<msg @l="1330" char_id="2" frame_id="-1" name="亜季奈"
		   text="『それにお姉ちゃん‥‥ちょっと私に構い過ぎだよ。』" voices=""/>
		<char @l="1334" id="miho" pos="right" src="miho014"/>
		<msg @l="1336" char_id="0" frame_id="-1" name="美帆" text="『え‥‥それ、どういう意味？』"
		   voices=""/>
		<msg @l="1338" char_id="2" frame_id="-1" name="亜季奈"
		   text="『私、もう子供じゃないんだから‥‥あんまり構わないでくれる？』" voices=""/>
		<clear @l="1342" layer="akina"/>
		<clear @l="1345" class="char"/>
		<char @l="1348" id="miho" pos="right" src="miho114"/>
		<msg @l="1350" char_id="0" frame_id="-1" name="美帆" text="『あ、ちょっと‥‥亜季奈！？』"
		   voices=""/>
		<msg @l="1352" char_id="-1" frame_id="-1" name=""
		   text="亜季奈はそう言って一人でスタスタと歩いていく。" voices=""/>
		<msg @l="1353" char_id="-1" frame_id="-1" name=""
		   text="私は追いかけて良いのかが判らず、その背中を見送るだけだった。" voices=""/>
		<char @l="1357" id="miho" pos="right" src="miho115"/>
		<msg @l="1359" char_id="0" frame_id="-1" name="美帆" text="『どうして‥‥。』"
		   voices=""/>
		<msg @l="1361" char_id="-1" frame_id="-1" name=""
		   text="そうしてつぶやいた疑問の言葉は亜季奈に届く事は無く‥‥。" voices=""/>
		<msg @l="1362" char_id="-1" frame_id="-1" name=""
		   text="二人の間を阻む深い夜の闇に溶け･･････そして消えていった･･････････。" voices=""/>
		<stopbgm @l="1366" fadeout="1000"/>
		<clear @l="1372" class="all"/>
		<label @l="1375" id="event_scene22"/>
		<msgshow @l="1378" show="true"/>
		<wait_chgmv/>
		<bg @l="1382" src="bg19b"/>
		<bgm @l="1386" src="bgm10" volume="1."/>
		<msg @l="1388" char_id="2" frame_id="-1" name="声"
		   text="『あふっ‥‥‥んっ‥‥‥んっ‥‥‥ああっ‥‥‥‥‥‥。』" voices="akina01310"/>
		<msg @l="1390" char_id="-1" frame_id="-1" name="" text="―――深夜。" voices=""/>
		<msg @l="1391" char_id="-1" frame_id="-1" name=""
		   text="水泳部の宿舎の一室から、艶やかな喘ぎが漏れていた。" voices=""/>
		<msg @l="1392" char_id="-1" frame_id="-1" name=""
		   text="灯りが消え、宿舎が深い闇の中に沈んでしまったその中で、その部屋の灯りだけは‥‥闇にあらがうように煌々と点っていた。"
		   voices=""/>
		<char @l="1396" id="watab" pos="auto" src="watabe010"/>
		<msg @l="1398" char_id="-1" frame_id="-1" name="渡部"
		   text="『よぉ‥‥早速始めてるみたいだな。』" voices=""/>
		<msg @l="1400" char_id="-1" frame_id="-1" name=""
		   text="深夜の見回りを終えて、渡部が部屋に戻ってくる。" voices=""/>
		<msg @l="1402" char_id="-1" frame_id="-1" name="留学生"
		   text="『オオーッ！オッオッ、オアァーッ！』" voices=""/>
		<clear @l="1405" class="char"/>
		<char @l="1407" id="watab" pos="left" src="watabe010"/>
		<char @l="1410" id="kuma" pos="right" src="kuma010"/>
		<msg @l="1412" char_id="-1" frame_id="-1" name="熊野"
		   text="『私はアナタが戻るのを待つつもりだったんですけどね。彼がどうしても我慢できないというものですから。』" voices=""/>
		<char @l="1415" id="watab" pos="left" src="watabe012"/>
		<msg @l="1417" char_id="-1" frame_id="-1" name="渡部"
		   text="『ま、そいつの相手はそれくらいでちょうど良いんじゃないか？』" voices=""/>
		<char @l="1420" id="kuma" pos="right" src="kuma012"/>
		<msg @l="1422" char_id="-1" frame_id="-1" name="熊野" text="『ですなぁ。』" voices=""/>
		<label @l="1426" id="chart_line18"/>
		<wait_chgmv/>
		<ev @l="1430" src="ev-022y1"/>
		<description @l="1433" text="亜季奈、輪姦"/>
		<msg @l="1435" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んぁっ‥‥んっ、んっ、んっ‥‥‥‥あふっ！！』" voices="akina01320"/>
		<msg @l="1437" char_id="-1" frame_id="-1" name="" text="どれくらいの時間が経ったのか。"
		   voices=""/>
		<msg @l="1438" char_id="-1" frame_id="-1" name=""
		   text="部屋の中では、留学生が亜季奈を、ただひたすらに犯し続けていた。" voices=""/>
		<msg @l="1439" char_id="-1" frame_id="-1" name=""
		   text="既に何度も絶頂に押し上げられており、その表情は恍惚と嫌悪がない交ぜになったような、複雑なものだ。" voices=""/>
		<msg @l="1441" char_id="2" frame_id="-1" name="亜季奈"
		   text="『センセイ‥‥私やっぱり、センセイ以外の人なんてやだよぉ‥‥。』" voices="akina01330"/>
		<msg @l="1443" char_id="-1" frame_id="-1" name="渡部"
		   text="『その割に、しっかり感じてるみたいじゃないか。』" voices=""/>
		<msg @l="1445" char_id="2" frame_id="-1" name="亜季奈"
		   text="『ち、ちがうもん‥‥こんなの‥‥‥‥わたし‥‥‥ん、ああっ！！』" voices="akina01340"/>
		<msg @l="1447" char_id="-1" frame_id="-1" name=""
		   text="亜季奈が否定の言葉を紡ごうとしたその瞬間‥‥蜜壺をかき混ぜていたモノが強く擦り上げ、それは切なげな吐息へと成り代わる。"
		   voices=""/>
		<msg @l="1448" char_id="-1" frame_id="-1" name=""
		   text="渡部はそれを満足そうに見詰めて、口の端を邪悪に歪めた。" voices=""/>
		<msg @l="1450" char_id="-1" frame_id="-1" name="渡部" text="『ほう、どこが違うんだ？』"
		   voices=""/>
		<msg @l="1452" char_id="2" frame_id="-1" name="亜季奈"
		   text="『こ、これはっ‥‥んっ、んんっ‥‥‥‥ふっ‥‥ああっ‥‥‥。』" voices="akina01350"/>
		<msg @l="1454" char_id="-1" frame_id="-1" name=""
		   text="言い訳を紡ごうとする度に敏感な場所を突き上げられ、どうしても言葉が最後まで続かない。" voices=""/>
		<msg @l="1455" char_id="-1" frame_id="-1" name=""
		   text="抵抗をしようにも自分の身体を支えるだけで精一杯で、留学生が腰を突き上げると、小さな身体が不安定に揺さぶられてしまい、それ以上はとても無理だった。"
		   voices=""/>
		<clear @l="1459" class="ev"/>
		<wait_chgmv/>
		<bg @l="1463" src="bg19b"/>
		<char @l="1467" id="watab" pos="left" src="watabe010"/>
		<char @l="1471" id="kuma" pos="right" src="kuma010"/>
		<msg @l="1473" char_id="-1" frame_id="-1" name="渡部" text="『開発の方は順調みたいだな？』"
		   voices=""/>
		<msg @l="1475" char_id="-1" frame_id="-1" name="熊野"
		   text="『そうですねぇ‥‥まだ、心の方に抵抗が見られますが。』" voices=""/>
		<msg @l="1477" char_id="-1" frame_id="-1" name="渡部"
		   text="『あの調子なら、それもすぐに無くなるだろうな。』" voices=""/>
		<msg @l="1479" char_id="-1" frame_id="-1" name="熊野"
		   text="『ええ、手を回して黒人を手配した甲斐があったというものです。』" voices=""/>
		<msg @l="1481" char_id="-1" frame_id="-1" name="熊野"
		   text="『まあ、実験はひとまず成功ということでよろしいですかな。』" voices=""/>
		<msg @l="1483" char_id="-1" frame_id="-1" name="渡部"
		   text="『ああ‥‥本命は逃したが、しばらくはコイツで色々出来るだろう。』" voices=""/>
		<msg @l="1485" char_id="-1" frame_id="-1" name=""
		   text="渡部はわずかに目を細め、不本意な相手に犯され苦悶と快楽に悶えている亜季奈を見やる。" voices=""/>
		<msg @l="1486" char_id="-1" frame_id="-1" name=""
		   text="その表情には、何処か冷めた笑みが浮かんでいた。" voices=""/>
		<wait_chgmv/>
		<ev @l="1490" src="ev-022y1"/>
		<msg @l="1492" char_id="-1" frame_id="-1" name="留学生"
		   text="『オォウ、プッシー、マ○コ、カミング、カミング。』" voices=""/>
		<msg @l="1494" char_id="-1" frame_id="-1" name="渡部"
		   text="『黒人の黒チ○ポでよがり狂いやがって、こうなっちゃもうガバガバで使いモンになんねえかな？』" voices=""/>
		<msg @l="1496" char_id="2" frame_id="-1" name="亜季奈"
		   text="『やぁぁ‥‥そんなことっ‥‥‥んんっ‥‥‥‥あっ、んぁぁっ。』" voices="akina01360"/>
		<msg @l="1498" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んっ、んっ、んっ、あくっ‥‥‥そんな奥までっ‥‥ん、ふぁっ！』" voices="akina01370"/>
		<msg @l="1500" char_id="-1" frame_id="-1" name=""
		   text="否定の言葉などまったく気にかける様子もなく、留学生は貪るように腰を律動させ、溢れんばかりの蜜で潤った膣穴を味わっている。"
		   voices=""/>
		<msg @l="1501" char_id="-1" frame_id="-1" name=""
		   text="そうして蜜壷をかき混ぜられるたびに亜季奈の疼きは否応なく膨らみ、しまいにはゆらゆらと自分から腰を揺すり始めた。" voices=""/>
		<msg @l="1503" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んぅ‥‥あふっ‥‥‥‥んっ‥‥んっ‥‥‥‥ああっ‥‥‥‥。』" voices="akina01380"/>
		<msg @l="1505" char_id="2" frame_id="-1" name="亜季奈"
		   text="『ダメぇ‥‥‥こんな‥‥んくっ、気持ちいい‥‥なんてっ‥‥‥。』" voices="akina01390"/>
		<msg @l="1507" char_id="-1" frame_id="-1" name=""
		   text="行為に対する否定の心とは裏腹に、膣壁を擦り上げる肉砲が生み出す熱と痺れは徐々に膨らんでいく。" voices=""/>
		<msg @l="1508" char_id="-1" frame_id="-1" name=""
		   text="亜季奈は自分ではどうにもならない悦楽に戸惑い、瞳からは涙が溢れる。" voices=""/>
		<msg @l="1510" char_id="-1" frame_id="-1" name="渡部" text="『もう一押しが必要みたいだな。』"
		   voices=""/>
		<msg @l="1512" char_id="-1" frame_id="-1" name="熊野"
		   text="『では、それではそろそろ私達も混ざることにしましょうか。』" voices=""/>
		<msg @l="1514" char_id="-1" frame_id="-1" name="渡部"
		   text="『ああ‥‥立派なメス犬に仕込んでやらなくちゃな。』" voices=""/>
		<msg @l="1516" char_id="-1" frame_id="-1" name="熊野"
		   text="『ちょうど代議士の福池先生が新しいペットをご所望でしたからねぇ。これでようやくこの町のプロジェクトもスムーズに進むというものです。』"
		   voices=""/>
		<msg @l="1518" char_id="-1" frame_id="-1" name="渡部"
		   text="『ああ、あの人は飽きるのが早いから‥‥せっかく仕込んだ女を一日で返されたときは流石にカチンと来たよな。』" voices=""/>
		<msg @l="1520" char_id="-1" frame_id="-1" name="熊野" text="『ふう、ですなあ。』"
		   voices=""/>
		<msg @l="1522" char_id="-1" frame_id="-1" name=""
		   text="熊野は愚痴ともぼやきとも取れる言葉を紡ぎながら、留学生に犯されている亜季奈の前に膝をついて、ズボンのベルトに手をかける。"
		   voices=""/>
		<msg @l="1523" char_id="-1" frame_id="-1" name=""
		   text="そうして既に硬く屹立した肉槍を彼女の眼前にさらすと、口の端を大きく歪めてその先端を口元へ押し付けた。" voices=""/>
		<wait_chgmv/>
		<ev @l="1527" src="ev-022x1y1y3"/>
		<msg @l="1529" char_id="2" frame_id="-1" name="亜季奈" text="『んむぅっ！？』"
		   voices="akina01400"/>
		<msg @l="1531" char_id="-1" frame_id="-1" name="熊野"
		   text="『さあ、私のモノを唇と舌でしっかりしゃぶってくださいね。』" voices=""/>
		<msg @l="1533" char_id="-1" frame_id="-1" name=""
		   text="亜季奈の口腔に、肉槍の切っ先が突き入れられる。" voices=""/>
		<msg @l="1534" char_id="-1" frame_id="-1" name=""
		   text="とはいえ‥‥膣穴をかき混ぜられるだけで、もう精一杯の亜季奈である。" voices=""/>
		<msg @l="1535" char_id="-1" frame_id="-1" name=""
		   text="当然、口腔内に突き入れられたモノの相手などマトモに出来るハズも無い。" voices=""/>
		<msg @l="1537" char_id="2" frame_id="-1" name="亜季奈" text="『んぐっ‥‥んっ、んんっ！！』"
		   voices="akina01410"/>
		<msg @l="1539" char_id="-1" frame_id="-1" name=""
		   text="口腔内で暴れる肉茎に、亜季奈は目を白黒させながら喘いでいる。" voices=""/>
		<msg @l="1540" char_id="-1" frame_id="-1" name="" text="つい先日まで処女だったのだ。"
		   voices=""/>
		<msg @l="1541" char_id="-1" frame_id="-1" name=""
		   text="男のモノに奉仕する為の知識も技術も、無いに等しい。" voices=""/>
		<msg @l="1543" char_id="-1" frame_id="-1" name="熊野"
		   text="『やり方が解らないんですか？&#32;仕方ありませんねぇ。』" voices=""/>
		<msg @l="1545" char_id="-1" frame_id="-1" name=""
		   text="ぼやくようにそう言って、熊野が丁寧に口腔で奉仕するやり方を指導する。" voices=""/>
		<msg @l="1546" char_id="-1" frame_id="-1" name=""
		   text="やれ含んだ先端に唾液をまぶせだの、舌先を使って亀頭の継ぎ目と裏側の筋を丹念に舐りあげろ、といった細やかな指示がしばらく続いていた。"
		   voices=""/>
		<msg @l="1547" char_id="-1" frame_id="-1" name=""
		   text="亜季奈はそれを涙目で聞きながら、何処か怯えた表情で熊野を見ている。" voices=""/>
		<msg @l="1549" char_id="2" frame_id="-1" name="亜季奈" text="『‥‥‥‥。』"
		   voices="akina01420"/>
		<msg @l="1551" char_id="-1" frame_id="-1" name=""
		   text="それから、亜季奈は助けを求めるように顔をあげて部屋の一点を見た。" voices=""/>
		<msg @l="1552" char_id="-1" frame_id="-1" name=""
		   text="その視線の先には渡部がいて‥‥睨みを利かせている。" voices=""/>
		<msg @l="1554" char_id="-1" frame_id="-1" name="渡部" text="『‥‥‥‥。』" voices=""/>
		<msg @l="1556" char_id="-1" frame_id="-1" name=""
		   text="渡部は、助けを乞うような亜季奈の視線をはね退けてアゴ先で続きを促す。" voices=""/>
		<msg @l="1557" char_id="-1" frame_id="-1" name=""
		   text="亜季奈はそれを見て一瞬、絶望的な表情を浮かべて見せるが、すぐに諦めたように口腔内のそれへ奉仕を始めた。" voices=""/>
		<msg @l="1559" char_id="2" frame_id="-1" name="亜季奈" text="『んっ‥‥‥ちゅむっ。』"
		   voices="akina01430"/>
		<msg @l="1561" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んぐっ、ちゅぷ、ちゅぷ‥‥‥んはっ‥‥‥。』" voices="akina01440"/>
		<msg @l="1563" char_id="-1" frame_id="-1" name=""
		   text="習ったばかりの奉仕を口腔内のそれに施す亜季奈。" voices=""/>
		<msg @l="1564" char_id="-1" frame_id="-1" name="" text="ただ、その舌技は当然のように拙ない。"
		   voices=""/>
		<msg @l="1566" char_id="-1" frame_id="-1" name="熊野"
		   text="『もっとしっかり奉仕してもらえませんと、また無理やり動かすコトになってしまうのですがねぇ。』" voices=""/>
		<msg @l="1568" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んんっ‥‥んっ、れろ、れろ‥‥‥んむぅ、んっ、ちゅぷっ。』" voices="akina01450"/>
		<msg @l="1570" char_id="-1" frame_id="-1" name=""
		   text="初めてのフェラの時、喉奥を突き破らんばかりに押し込まれたのが、よほど苦痛だったのだろう。" voices=""/>
		<msg @l="1571" char_id="-1" frame_id="-1" name=""
		   text="亜季奈は熊野の言葉を聞くと、怯えた表情を浮かべて口腔内のそれへ丹念に舌先を這わせ始める。" voices=""/>
		<msg @l="1573" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んふぅ‥‥んっ‥‥んっ‥‥んっ‥‥‥‥んぷっ‥‥‥ちゅるっ。』" voices="akina01460"/>
		<msg @l="1575" char_id="2" frame_id="-1" name="亜季奈"
		   text="『ん、ふあっ‥‥‥こ、こんな感じでいいですか‥‥‥‥？』" voices="akina01470"/>
		<msg @l="1577" char_id="-1" frame_id="-1" name="熊野"
		   text="『そう、いい感じですよ‥‥‥続けてください。』" voices=""/>
		<msg @l="1579" char_id="2" frame_id="-1" name="亜季奈"
		   text="『は、はい‥‥あむ‥‥‥‥ちゅぷ、ちゅっ‥‥‥ん、ちゅぷぷっ。』" voices="akina01480"/>
		<msg @l="1581" char_id="2" frame_id="-1" name="亜季奈"
		   text="『ん、んぐっ‥‥んぷ、んぷ、んぷっ‥‥‥ちゅぷっ‥‥‥んはっ。』" voices="akina01490"/>
		<msg @l="1583" char_id="-1" frame_id="-1" name=""
		   text="喉奥を突かれるコトに対する恐怖心からか、それとも渡部に対する愛情を貫こうという意思をもってされるがままに従っているのだろうか‥‥。"
		   voices=""/>
		<msg @l="1584" char_id="-1" frame_id="-1" name=""
		   text="亜季奈は熊野の様子を伺いながら懸命に肉棒をしゃぶりあげる。" voices=""/>
		<msg @l="1586" char_id="2" frame_id="-1" name="亜季奈"
		   text="『えと‥‥‥ここの‥‥くびれてるところを舐めるんですよね？』" voices="akina01500"/>
		<msg @l="1588" char_id="-1" frame_id="-1" name="熊野"
		   text="『そうですそうです、しっかりやってくださいねぇ。』" voices=""/>
		<msg @l="1590" char_id="2" frame_id="-1" name="亜季奈"
		   text="『はい‥‥‥あ、んむっ‥‥‥ちゅろ‥‥‥ちゅろ‥‥‥。』" voices="akina01510"/>
		<msg @l="1592" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んふっ‥‥んぷっ‥‥‥ちゅむっ、ちゅぱっ‥‥‥‥じゅるるっ。』" voices="akina01520"/>
		<msg @l="1594" char_id="-1" frame_id="-1" name=""
		   text="拙かった舌の動きも熊野に指導されながら続けるうちに少しずつ動きがよくなり、心なしか亜季奈の奉仕も積極的なモノになっていく。"
		   voices=""/>
		<msg @l="1596" char_id="-1" frame_id="-1" name="留学生" text="『ガアアァッ、オアーッ！』"
		   voices=""/>
		<msg @l="1598" char_id="-1" frame_id="-1" name="留学生" text="『ファーック！ファーック！』"
		   voices=""/>
		<msg @l="1600" char_id="-1" frame_id="-1" name=""
		   text="亜季奈が熱心に奉仕を続けているのに疎外感を覚えたのか、子宮口を貫いていた留学生が唐突に腰の動きを早める。" voices=""/>
		<msg @l="1602" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んぶっ‥‥んっんっんっ‥‥‥んぐっ‥‥‥んふぁっっ！！』" voices="akina01530"/>
		<msg @l="1604" char_id="-1" frame_id="-1" name=""
		   text="口腔内を陰茎で塞がれたままの激しい律動に、亜季奈が熱い吐息を漏らす。" voices=""/>
		<msg @l="1605" char_id="-1" frame_id="-1" name=""
		   text="息苦しさと押し寄せる熱い疼きに表情を歪ませ、両目に溜まっていた涙が律動に合わせて零れ落ちていく。" voices=""/>
		<msg @l="1607" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んぁぁっ‥‥んっ、んんっ‥‥‥んぷっ‥‥んっ‥‥んんぅ！！』" voices="akina01540"/>
		<msg @l="1609" char_id="2" frame_id="-1" name="亜季奈"
		   text="『あぷっ、んくっ‥‥‥んっ‥‥んぐぅっ‥‥‥‥ちゅぷっっ！！』" voices="akina01550"/>
		<msg @l="1611" char_id="-1" frame_id="-1" name=""
		   text="ゆらゆらと律動に身体を揺らされながらも、亜季奈は口に含まされた肉棒を吐き出そうとはしない。" voices=""/>
		<msg @l="1612" char_id="-1" frame_id="-1" name=""
		   text="あくまでも命じられたことに忠実であろうとしているのか、それとも。" voices=""/>
		<msg @l="1613" char_id="-1" frame_id="-1" name=""
		   text="‥‥既に、新たな快楽を覚えてしまったのだろうか。" voices=""/>
		<msg @l="1615" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んっ、んっ、んっ‥‥んふっ‥‥‥はふっ、んっ、んむぅっ‥‥。』" voices="akina01560"/>
		<msg @l="1617" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んぷっ‥‥ちゅむっ‥‥ちゅぷぷっ‥‥ん、んぷっ‥‥‥んぐっ。』" voices="akina01570"/>
		<msg @l="1619" char_id="-1" frame_id="-1" name="渡部" text="『ふん‥‥器用なもんだな。』"
		   voices=""/>
		<msg @l="1621" char_id="-1" frame_id="-1" name="渡部"
		   text="『どうだ亜季奈、これはこれで良いもんだろ？』" voices=""/>
		<msg @l="1623" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んぷっ‥‥ふはっ‥‥‥‥‥んっ‥‥は、はい‥‥‥‥。』" voices="akina01580"/>
		<msg @l="1625" char_id="2" frame_id="-1" name="亜季奈"
		   text="『き、気持ち‥‥‥んんっ‥‥‥いいですっ‥‥‥あ、んくっっ！！』" voices="akina01590"/>
		<msg @l="1627" char_id="-1" frame_id="-1" name=""
		   text="亜季奈はやるせない表情を浮かべたまま答える。" voices=""/>
		<msg @l="1628" char_id="-1" frame_id="-1" name="" text="それが本心かどうかなどは関係ない。"
		   voices=""/>
		<msg @l="1629" char_id="-1" frame_id="-1" name=""
		   text="痴態を晒せば晒すほど渡部が満足するというなら、そうするしかない。" voices=""/>
		<msg @l="1630" char_id="-1" frame_id="-1" name="" text="もう後戻りは出来ないのだ。"
		   voices=""/>
		<msg @l="1632" char_id="-1" frame_id="-1" name="渡部"
		   text="『いいんだったらその二人をイカせてみろ。』" voices=""/>
		<msg @l="1634" char_id="-1" frame_id="-1" name="渡部"
		   text="『そうしたら今度は俺がオマエのマ○コをかき混ぜてやる。』" voices=""/>
		<msg @l="1636" char_id="2" frame_id="-1" name="亜季奈"
		   text="『は、はいっ‥‥‥あむっ‥‥んっ、んぐっ‥‥‥ちゅぷぷっ！！』" voices="akina01600"/>
		<msg @l="1638" char_id="-1" frame_id="-1" name="熊野"
		   text="『おおっ‥‥急に吸い付きがよくなりましたよ？』" voices=""/>
		<msg @l="1640" char_id="-1" frame_id="-1" name="留学生"
		   text="『オ、オオオオッ！オーマイガッ、マイガッ！！』" voices=""/>
		<msg @l="1642" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んんっ‥‥んむぅ‥‥んふっ‥‥‥んっ、んっ、んんっ‥‥‥。』" voices="akina01610"/>
		<msg @l="1644" char_id="2" frame_id="-1" name="亜季奈"
		   text="『ちゅむっ‥‥‥んぅ、んむっ‥‥‥んぐ‥‥んっ‥‥んはっっ！！』" voices="akina01620"/>
		<msg @l="1646" char_id="-1" frame_id="-1" name=""
		   text="部屋中に、肉体のぶつかり合う音と亜季奈の身体より発せられる淫猥な水音の数々響き渡る。" voices=""/>
		<msg @l="1647" char_id="-1" frame_id="-1" name=""
		   text="溢れ返った熱い蜜が極太肉にかき混ぜられる音。" voices=""/>
		<msg @l="1648" char_id="-1" frame_id="-1" name=""
		   text="口に溜められた唾液が肉柱にまぶされる音。" voices=""/>
		<msg @l="1650" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んぅぅっ‥‥んはっ‥‥‥‥ねぇ、まだ出ないの‥‥‥？』" voices="akina01630"/>
		<msg @l="1652" char_id="2" frame_id="-1" name="亜季奈"
		   text="『早く出してっ‥‥はやくっ‥‥‥んっ、んぐっ‥‥‥じゅるるっ！』" voices="akina01640"/>
		<msg @l="1654" char_id="-1" frame_id="-1" name="" text="一刻も早く渡部と交わりたいのだろう。"
		   voices=""/>
		<msg @l="1655" char_id="-1" frame_id="-1" name=""
		   text="亜季奈は射精をせかす言葉を紡ぎ、目前の肉柱へ激しく吸い付く。" voices=""/>
		<msg @l="1657" char_id="-1" frame_id="-1" name="熊野"
		   text="『おお、おおおっ‥‥いいですよ、もうすぐ出してあげますからね。』" voices=""/>
		<msg @l="1659" char_id="-1" frame_id="-1" name="留学生" text="『ハオオォウッ！オォウッ！』"
		   voices=""/>
		<msg @l="1661" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んっ、んっ、んっ、んっ‥‥‥んぐっ‥‥‥はふっ、んぷっ！！』" voices="akina01650"/>
		<msg @l="1663" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んぐっ‥‥んぷっ、んぷっ‥‥‥‥んちゅっ、ちゅぷぷぷっ！！』" voices="akina01660"/>
		<msg @l="1665" char_id="-1" frame_id="-1" name="熊野" text="『い、いきますよっ。』"
		   voices=""/>
		<msg @l="1667" char_id="-1" frame_id="-1" name="留学生" text="『オオウッ！フウウウッ！！』"
		   voices=""/>
		<wait_chgmv/>
		<ev @l="1671" src="ev-022x1y1y3z1z4"/>
		<msg @l="1673" char_id="2" frame_id="-1" name="亜季奈" text="『んぷっっ！！』"
		   voices="akina01670"/>
		<msg @l="1675" char_id="-1" frame_id="-1" name=""
		   text="亜季奈の口腔と膣内に、大量の精液が注ぎ込まれる。" voices=""/>
		<msg @l="1676" char_id="-1" frame_id="-1" name=""
		   text="留学生は声にならない声を漏らしながら何度も腰を密着させ、子宮口の更に奥、子宮へと熱い液体を流し込んでいる。" voices=""/>
		<msg @l="1678" char_id="2" frame_id="-1" name="亜季奈" text="『んぐっ‥‥‥んふっ！！』"
		   voices="akina01680"/>
		<msg @l="1680" char_id="-1" frame_id="-1" name=""
		   text="そうして下腹部に注がれている熱い精液に尻を震わせながら、一方で喉奥へ吐き出される精液に驚いて、慌てて口腔から肉注を抜こうとする。"
		   voices=""/>
		<msg @l="1682" char_id="-1" frame_id="-1" name="熊野"
		   text="『おっと‥‥吐き出してはダメですよ、ちゃんと飲んでくださいね。』" voices=""/>
		<msg @l="1684" char_id="-1" frame_id="-1" name=""
		   text="熊野の手が亜季奈の頭を押さえつけてしまい、肉棒を吐き出す事が出来なくなってしまう。" voices=""/>
		<msg @l="1686" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んっ‥‥‥んんっ‥‥‥‥んんっ‥‥‥‥‥‥。』" voices="akina01690"/>
		<msg @l="1688" char_id="-1" frame_id="-1" name=""
		   text="精液を飲むことには抵抗があるのか、亜季奈は吐き出される精液を口腔内に溜めている。" voices=""/>
		<msg @l="1689" char_id="-1" frame_id="-1" name=""
		   text="ただ、熊野が吐き出す精液の量は亜季奈には多すぎたらしく、すぐに限界がきて口の端からダラダラと白濁色の液体がこぼれ出す。"
		   voices=""/>
		<msg @l="1691" char_id="-1" frame_id="-1" name="熊野"
		   text="『仕方ありませんねぇ‥‥残りは顔にかけてあげましょう。』" voices=""/>
		<msg @l="1693" char_id="2" frame_id="-1" name="亜季奈" text="『んんっ！！』"
		   voices="akina01700"/>
		<msg @l="1695" char_id="-1" frame_id="-1" name=""
		   text="口腔から引き抜かれた肉棒は、まだ足りぬと言わんばかりに数度跳ね上がり、亜季奈の顔へ大量の白濁をまぶしていく。" voices=""/>
		<msg @l="1697" char_id="2" frame_id="-1" name="亜季奈" text="『んぅっ‥‥‥んんー‥‥‥‥‥。』"
		   voices="akina01710"/>
		<msg @l="1699" char_id="-1" frame_id="-1" name="" text="問題は、口腔に溜められた精液である。"
		   voices=""/>
		<msg @l="1700" char_id="-1" frame_id="-1" name=""
		   text="亜季奈は精液の生臭い匂いに眉をしかめながら、やはり指示を仰ぐように渡部へと視線を投げる。" voices=""/>
		<msg @l="1702" char_id="-1" frame_id="-1" name="渡部"
		   text="『さっき言われただろ？&#32;出された精液はちゃんと飲み込めよ。』" voices=""/>
		<msg @l="1704" char_id="2" frame_id="-1" name="亜季奈" text="『んっ‥‥。』"
		   voices="akina01720"/>
		<msg @l="1706" char_id="-1" frame_id="-1" name=""
		   text="渡部の冷たい言葉に絶望的な表情を浮かべ、オロオロしながら虚空を見詰める。" voices=""/>
		<msg @l="1707" char_id="-1" frame_id="-1" name=""
		   text="けれど、幾ら考えをめぐらせたところで‥‥答えは決まっている。" voices=""/>
		<msg @l="1709" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んっ‥‥‥んぐっ‥‥‥んくっ、んくっ、んくっ‥‥‥‥。』" voices="akina01730"/>
		<msg @l="1711" char_id="-1" frame_id="-1" name=""
		   text="亜季奈は諦めの表情を浮かべ、口腔内の精液を飲み下していく。" voices=""/>
		<msg @l="1712" char_id="-1" frame_id="-1" name=""
		   text="ただ‥‥やはり飲み易くはないのだろう、亜季奈はしばらく口内のそれと格闘するように喉を鳴らしていた。" voices=""/>
		<clear @l="1718" class="all"/>
		<wait_chgmv/>
		<bg @l="1722" src="bg19b"/>
		<msg @l="1724" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んっ、んっ、んっ‥‥‥んはっ‥‥‥んっ‥‥‥んぐっ‥‥‥。』" voices="akina01740"/>
		<msg @l="1726" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んくっ‥‥‥んはっ‥‥‥‥‥はぁっ‥‥‥はぁ‥‥‥‥。』" voices="akina01750"/>
		<char @l="1730" id="watab" pos="auto" src="watabe010"/>
		<msg @l="1732" char_id="-1" frame_id="-1" name="渡部" text="『どうだ、ちゃんと飲み込んだか？』"
		   voices=""/>
		<msg @l="1734" char_id="2" frame_id="-1" name="亜季奈"
		   text="『はい‥‥‥全部、飲みました‥‥‥。』" voices="akina01760"/>
		<msg @l="1736" char_id="-1" frame_id="-1" name=""
		   text="そう言って亜季奈は荒い息を吐き、口を開いて中を見せる。" voices=""/>
		<msg @l="1738" char_id="-1" frame_id="-1" name="渡部"
		   text="『それで、上の口から飲むミルクは美味かったか？』" voices=""/>
		<msg @l="1740" char_id="2" frame_id="-1" name="亜季奈" text="『え‥‥そ、それは‥‥‥。』"
		   voices="akina01770"/>
		<msg @l="1742" char_id="-1" frame_id="-1" name="渡部" text="『美味かったか？』"
		   voices=""/>
		<msg @l="1744" char_id="2" frame_id="-1" name="亜季奈" text="『‥‥はい。』"
		   voices="akina01780"/>
		<msg @l="1746" char_id="2" frame_id="-1" name="亜季奈"
		   text="『お口に出してもらったミルク‥‥美味しかった‥‥‥‥です。』" voices="akina01790"/>
		<msg @l="1748" char_id="-1" frame_id="-1" name="渡部" text="『よし、いい子だ。』"
		   voices=""/>
		<msg @l="1750" char_id="-1" frame_id="-1" name="渡部"
		   text="『それじゃあ約束通りマ○コをかき混ぜてやる。』" voices=""/>
		<msg @l="1752" char_id="2" frame_id="-1" name="亜季奈" text="『うんっ‥‥センセイ、来てぇ。』"
		   voices="akina01800"/>
		<msg @l="1754" char_id="-1" frame_id="-1" name=""
		   text="嬉しそうに亜季奈は再び畳の上で四つんばいになり、誘うように尻を揺らす。" voices=""/>
		<msg @l="1756" char_id="-1" frame_id="-1" name="留学生" text="『オーウ、プリーズプリーズ』"
		   voices=""/>
		<msg @l="1758" char_id="-1" frame_id="-1" name=""
		   text="留学生が亜季奈の眼前に、隆起した逸物を突き出す。" voices=""/>
		<msg @l="1760" char_id="2" frame_id="-1" name="亜季奈"
		   text="『え‥‥いま、出したばっかりなのに‥‥‥。』" voices="akina01810"/>
		<msg @l="1762" char_id="-1" frame_id="-1" name="留学生" text="『ノープロブレム。』"
		   voices=""/>
		<msg @l="1764" char_id="2" frame_id="-1" name="亜季奈"
		   text="『そんな‥‥せっかくセンセイと出来るのに‥‥‥。』" voices="akina01820"/>
		<msg @l="1766" char_id="-1" frame_id="-1" name="渡部"
		   text="『まあそう言わずに口でやってやれ。』" voices=""/>
		<msg @l="1768" char_id="-1" frame_id="-1" name="渡部"
		   text="『そいつは俺が呼んだゲストなんだ、最大限にもてなすのが礼儀ってものだろ？』" voices=""/>
		<msg @l="1770" char_id="2" frame_id="-1" name="亜季奈"
		   text="『ん‥‥センセイがそう言うなら、別にいいけど‥‥‥。』" voices="akina01830"/>
		<msg @l="1772" char_id="-1" frame_id="-1" name="留学生" text="『オウ、オーラルセックス！』"
		   voices=""/>
		<wait_chgmv/>
		<ev @l="1776" src="ev-022y2y4z1z4"/>
		<msg @l="1778" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んっ、ああっ‥‥‥センセイのおち○ちん‥‥入ってくるよぉ。』" voices="akina01840"/>
		<msg @l="1780" char_id="-1" frame_id="-1" name="渡部"
		   text="『他人の精液でぐちょぐちょのマ○コっていうのがちょっと気に入らないがな、まあたまにはこういうのもいいだろ。』" voices=""/>
		<msg @l="1782" char_id="-1" frame_id="-1" name=""
		   text="渡部はそう言って肉襞の具合を確かめるようにグイグイと腰を押し付ける。" voices=""/>
		<msg @l="1784" char_id="2" frame_id="-1" name="亜季奈"
		   text="『ふあっ‥‥そんな、グリグリしたらすぐにイっちゃうっ‥‥。』" voices="akina01850"/>
		<msg @l="1786" char_id="-1" frame_id="-1" name="渡部"
		   text="『気にせず何度でもイケばいいだろ。』" voices=""/>
		<msg @l="1788" char_id="2" frame_id="-1" name="亜季奈"
		   text="『そんなっ‥‥んっ、んんっ‥‥‥あっあっあっあっ、んぅっ！！』" voices="akina01860"/>
		<msg @l="1790" char_id="-1" frame_id="-1" name=""
		   text="そうして否定の言葉を紡ぎながらも、亜季奈は渡部の腰の動きに合わせてゆらゆらと腰を揺すっている。" voices=""/>
		<msg @l="1791" char_id="-1" frame_id="-1" name=""
		   text="前の二人に犯されていた時よりも、その動きは明らかに積極的だ。" voices=""/>
		<msg @l="1793" char_id="-1" frame_id="-1" name="留学生" text="『オーゥ、チューチューカムカム』"
		   voices=""/>
		<msg @l="1795" char_id="-1" frame_id="-1" name=""
		   text="渡部のモノにかき混ぜられ快感に表情を歪ませている亜季奈の口元に、留学生の肌を更にドス黒くしたような巨竿が差し出される。"
		   voices=""/>
		<msg @l="1796" char_id="-1" frame_id="-1" name=""
		   text="今さっき射精しているというのに、留学生のそれは精を吐き出す前以上の角度と硬度で屹立していた。" voices=""/>
		<msg @l="1798" char_id="2" frame_id="-1" name="亜季奈" text="『う、うん‥‥。』"
		   voices="akina01870"/>
		<msg @l="1800" char_id="2" frame_id="-1" name="亜季奈"
		   text="『あむっ‥‥んっ、んぐっ‥‥‥ちゅぷっ。』" voices="akina01880"/>
		<msg @l="1802" char_id="-1" frame_id="-1" name=""
		   text="亜季奈は一瞬、嫌悪の表情を浮かべてそれを見やり、仕方なくといった感じで口腔内へと飲み込んでいく。" voices=""/>
		<msg @l="1804" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んっ‥‥んぷっ‥‥‥ちゅぷ‥‥‥ンっ、ちゅぷぷっ‥‥‥‥。』" voices="akina01890"/>
		<msg @l="1806" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んぐ、んっ、んっ、んっ‥‥‥ちゅむ‥‥‥ん、んぐっ‥‥‥‥。』" voices="akina01900"/>
		<msg @l="1808" char_id="-1" frame_id="-1" name=""
		   text="深く、浅く‥‥亜季奈は肉竿を咥え吐き出す。" voices=""/>
		<msg @l="1809" char_id="-1" frame_id="-1" name=""
		   text="熊野の逸物を咥えていた時よりも、いくらか手馴れていた。" voices=""/>
		<msg @l="1810" char_id="-1" frame_id="-1" name=""
		   text="ただそれは技術の向上というよりも感情の麻痺の所為と、言った方がそれらしい。" voices=""/>
		<msg @l="1812" char_id="-1" frame_id="-1" name="渡部"
		   text="『もっとだ、もっと丹念に舐めてやれ。』" voices=""/>
		<msg @l="1814" char_id="-1" frame_id="-1" name=""
		   text="亜季奈の肉穴をゆっくりと擦り上げながら、渡部が楽しげに笑う。" voices=""/>
		<msg @l="1816" char_id="2" frame_id="-1" name="亜季奈" text="『んはっ‥‥は、はい‥‥‥。』"
		   voices="akina01910"/>
		<msg @l="1818" char_id="2" frame_id="-1" name="亜季奈"
		   text="『ちゅぷっ、んっ、んっ、んっ‥‥‥んふぅ‥‥‥ん、ちゅぷぷっ。』" voices="akina01920"/>
		<msg @l="1820" char_id="-1" frame_id="-1" name=""
		   text="渡部の言葉に従うように、亜季奈は肉竿全体をゆっくりと丹念にしゃぶる。" voices=""/>
		<msg @l="1821" char_id="-1" frame_id="-1" name=""
		   text="追い立てるような激しさは無いが、ねっとり絡みつく感じが巧妙である。" voices=""/>
		<msg @l="1823" char_id="-1" frame_id="-1" name="留学生"
		   text="『オォオ、ソー、ナーイス‥‥オォウッ。』" voices=""/>
		<msg @l="1825" char_id="-1" frame_id="-1" name="渡部" text="『よかったな、亜季奈。』"
		   voices=""/>
		<msg @l="1827" char_id="-1" frame_id="-1" name="渡部"
		   text="『褒めてもらったぶん、しっかり奉仕してやるんだぞ？』" voices=""/>
		<msg @l="1829" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んふぅ‥‥‥んっ‥‥んむっ‥‥ちゅぷ、ちゅぷ、ちゅぷ‥‥‥。』" voices="akina01930"/>
		<msg @l="1831" char_id="-1" frame_id="-1" name=""
		   text="留学生に褒められた時は全くの無反応だった亜季奈も、渡部の言葉には嬉しそうに喉を鳴らして見せる。" voices=""/>
		<msg @l="1833" char_id="-1" frame_id="-1" name="渡部"
		   text="『いいぞ、その調子でしゃぶってろよ。』" voices=""/>
		<msg @l="1835" char_id="-1" frame_id="-1" name=""
		   text="怒張にしゃぶりつく亜季奈を満足げに眺めながら、渡部は腰の律動を強く激しいものへと変えた。" voices=""/>
		<msg @l="1836" char_id="-1" frame_id="-1" name=""
		   text="途端に亜季奈の蜜壺からは熱い淫液がじわりと染み出して、日に焼けた細いフトモモを伝い落ちていく。" voices=""/>
		<msg @l="1838" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んんっ‥‥んっ、んっ、んっ、んぅぅっ！！』" voices="akina01940"/>
		<msg @l="1840" char_id="2" frame_id="-1" name="亜季奈"
		   text="『ふはっ、んっ‥‥んぐっ‥‥‥んぷっ、んぷっ‥‥んぐぅぅっ！！』" voices="akina01950"/>
		<msg @l="1842" char_id="-1" frame_id="-1" name=""
		   text="渡部の律動に合わせて亜季奈の小さな身体がゆらゆらと前後に揺れると、前へ押し出された亜季奈は半ば強制的に剛棒を喉の奥深くまで飲み込む、謂わばディープスロートされられているコトになる。"
		   voices=""/>
		<msg @l="1844" char_id="-1" frame_id="-1" name="留学生"
		   text="『オッ、オアオッ‥‥オホッ、ホオォッ。』" voices=""/>
		<msg @l="1846" char_id="-1" frame_id="-1" name=""
		   text="よほど、この半強制的なディープスロートが気に入ったのだろう。" voices=""/>
		<msg @l="1847" char_id="-1" frame_id="-1" name=""
		   text="肉柱の先端が喉奥の壁を擦り上げるたび、留学生は腰を震わせながら歓喜の声を漏らしている。" voices=""/>
		<msg @l="1849" char_id="-1" frame_id="-1" name="渡部"
		   text="『今日だけでフェラチオとディープスロートはマスターか、さすが淫乱なメス犬なだけあってレベルが違うな。』" voices=""/>
		<msg @l="1851" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んっ、んんっ‥‥‥わ、わたし‥‥そんなんじゃないもんっ。』" voices="akina01960"/>
		<msg @l="1854" char_id="-1" frame_id="-1" name="渡部"
		   text="『いや、オマエは淫乱なメス犬だよ‥‥‥そうだろっ！？』" voices=""/>
		<msg @l="1856" char_id="2" frame_id="-1" name="亜季奈" text="『んっ、ぷあっっ！？』"
		   voices="akina01970"/>
		<msg @l="1858" char_id="-1" frame_id="-1" name=""
		   text="渡部が強く腰を突き入れた瞬間、亜季奈は咥えていた肉塊を吐き出して全身を震わせる。" voices=""/>
		<msg @l="1859" char_id="-1" frame_id="-1" name=""
		   text="たったひと突きで、達してしまったようだ。" voices=""/>
		<msg @l="1861" char_id="-1" frame_id="-1" name="渡部"
		   text="『どうだ、これだけでイッちまうヤツは淫乱なメス犬じゃないのか？』" voices=""/>
		<msg @l="1863" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んふぅ‥‥やぁ‥‥‥ちがう‥‥ちがうもんっ‥‥‥‥。』" voices="akina01980"/>
		<msg @l="1865" char_id="2" frame_id="-1" name="亜季奈"
		   text="『これはセンセイだから、センセイのおち○ちんだからだもん‥‥。』" voices="akina01990"/>
		<msg @l="1867" char_id="-1" frame_id="-1" name="渡部" text="『ほう、そりゃあ残念だ。』"
		   voices=""/>
		<msg @l="1869" char_id="-1" frame_id="-1" name="渡部"
		   text="『俺はな、誰のチ○ポを突っ込まれても平気でヨガリ狂うような淫乱なメス犬が大好きなんだよ。』" voices=""/>
		<msg @l="1871" char_id="-1" frame_id="-1" name=""
		   text="そう言って、渡部は膣内に突き入れていた怒張を引き抜こうとする。" voices=""/>
		<msg @l="1873" char_id="2" frame_id="-1" name="亜季奈" text="『あっ‥‥やだ、抜いちゃダメっ！』"
		   voices="akina02000"/>
		<msg @l="1875" char_id="-1" frame_id="-1" name="渡部"
		   text="『オマエは淫乱なメス犬じゃないんだろ？』" voices=""/>
		<msg @l="1877" char_id="-1" frame_id="-1" name="渡部"
		   text="『だったらこれ以上ヤってやる意味はない。俺は愛だの恋だの騒ぐようなお子様には興味がないんだよ。』" voices=""/>
		<msg @l="1879" char_id="-1" frame_id="-1" name=""
		   text="渡部はそして、亜季奈の秘裂から完全に肉棒を抜いてしまう。" voices=""/>
		<msg @l="1881" char_id="2" frame_id="-1" name="亜季奈"
		   text="『そ、そんなっ‥‥わたしは‥‥‥‥‥。』" voices="akina02010"/>
		<msg @l="1883" char_id="-1" frame_id="-1" name="渡部" text="『わたしは？&#32;なんだ？』"
		   voices=""/>
		<msg @l="1885" char_id="-1" frame_id="-1" name=""
		   text="耳元で囁きながら、渡部は秘部の入り口を亀頭の先端でなぞっている。" voices=""/>
		<msg @l="1886" char_id="-1" frame_id="-1" name=""
		   text="亜季奈は腰を突き出して何とかそれを秘貝で食べようとするが、その都度、渡部が腰を引いて逃げる為に焦らされるだけである。"
		   voices=""/>
		<msg @l="1888" char_id="2" frame_id="-1" name="亜季奈" text="『‥‥‥‥。』"
		   voices="akina02020"/>
		<msg @l="1890" char_id="-1" frame_id="-1" name="渡部"
		   text="『どうした？&#32;コイツは淫乱なメス犬専用だ。ソイツにしか突っ込んでやらないぞ？』" voices=""/>
		<msg @l="1892" char_id="2" frame_id="-1" name="亜季奈" text="『わたしは‥‥。』"
		   voices="akina02030"/>
		<msg @l="1894" char_id="2" frame_id="-1" name="亜季奈"
		   text="『わたしは‥‥‥淫乱な、メス犬‥‥‥‥です。』" voices="akina02040"/>
		<msg @l="1896" char_id="-1" frame_id="-1" name="渡部"
		   text="『ほう、オマエは誰のチ○ポを突っ込まれてもヨガリ狂うような淫乱なんだな？』" voices=""/>
		<msg @l="1898" char_id="2" frame_id="-1" name="亜季奈"
		   text="『は、はい‥‥私は誰のおち○ちんを入れられても感じちゃう淫乱です。』" voices="akina02050"/>
		<msg @l="1900" char_id="-1" frame_id="-1" name="渡部"
		   text="『俺以外のチ○ポでも平気で咥え込む、メス犬なワケだ？』" voices=""/>
		<msg @l="1902" char_id="2" frame_id="-1" name="亜季奈" text="『そう‥‥です‥‥‥‥。』"
		   voices="akina02060"/>
		<msg @l="1904" char_id="2" frame_id="-1" name="亜季奈"
		   text="『私は、誰のおち○ちんでも平気で咥え込むメス犬です‥‥。』" voices="akina02070"/>
		<msg @l="1906" char_id="2" frame_id="-1" name="亜季奈"
		   text="『だから、はやくおち○ちん‥‥入れてください。』" voices="akina02080"/>
		<msg @l="1908" char_id="2" frame_id="-1" name="亜季奈"
		   text="『もう我慢できないんです‥‥奥まで、硬いおち○ちん入れてくださいっ！！』" voices="akina02090"/>
		<msg @l="1910" char_id="-1" frame_id="-1" name="渡部"
		   text="『ハハッ、それでこそ俺の見込んだ女だよ！』" voices=""/>
		<msg @l="1912" char_id="2" frame_id="-1" name="亜季奈" text="『んぁぁっ！！』"
		   voices="akina02100"/>
		<msg @l="1914" char_id="-1" frame_id="-1" name=""
		   text="一気に、硬い肉茎が亜季奈の秘所を貫いた。" voices=""/>
		<msg @l="1915" char_id="-1" frame_id="-1" name=""
		   text="亜季奈はそうして膣肉が押し広げられる感触に歓喜の声をあげ、大きく腰を震わせる。" voices=""/>
		<msg @l="1917" char_id="-1" frame_id="-1" name="渡部"
		   text="『いいぞ、メス犬はメス犬らしく腰を振って喘ぎまくれ。』" voices=""/>
		<msg @l="1919" char_id="2" frame_id="-1" name="亜季奈"
		   text="『は、はいっ‥‥‥あっ、あっ、あっ、んんっ、んあっ！！』" voices="akina02110"/>
		<msg @l="1921" char_id="-1" frame_id="-1" name="留学生" text="『オォッ、オッ、オアアッ。』"
		   voices=""/>
		<msg @l="1923" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んぶっ‥‥んぐっ‥‥‥‥んっ、んんっ‥‥‥じゅるるっ！！』" voices="akina02120"/>
		<msg @l="1925" char_id="-1" frame_id="-1" name=""
		   text="淫膣を暴れまわる肉筒に躰を震わせながらも、亜季奈は口に突き入れられた先端へ舌先を絡みつけて吸う。" voices=""/>
		<msg @l="1927" char_id="-1" frame_id="-1" name="熊野" text="『‥‥堕ちましたな。』"
		   voices=""/>
		<msg @l="1929" char_id="-1" frame_id="-1" name=""
		   text="肉茎の先端に吸い付く亜季奈の姿を見て、熊野が微かに漏らす。" voices=""/>
		<msg @l="1930" char_id="-1" frame_id="-1" name=""
		   text="しかし‥‥その言葉も既に亜季奈の心には届いてはいない。" voices=""/>
		<msg @l="1932" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んっ、んっ、んっ‥‥‥んふっ‥‥んふっ‥‥んぐぅっ‥‥‥。』" voices="akina02130"/>
		<msg @l="1934" char_id="2" frame_id="-1" name="亜季奈"
		   text="『ちゅぷ、ちゅぷ、ちゅぷ‥‥‥んっ‥‥んぷっ‥‥‥‥んはっ！！』" voices="akina02140"/>
		<msg @l="1936" char_id="-1" frame_id="-1" name="渡部"
		   text="『よーし、このまま一番奥に射精してやるからな。』" voices=""/>
		<msg @l="1938" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んっ、んんっ、んぐっ‥‥‥んはっ‥‥‥。』" voices="akina02150"/>
		<msg @l="1940" char_id="2" frame_id="-1" name="亜季奈"
		   text="『ああっ‥‥あっ‥‥私も、イッちゃ‥‥‥んっ、んぐっ！！』" voices="akina02160"/>
		<msg @l="1942" char_id="-1" frame_id="-1" name="留学生"
		   text="『オウッ、アッ、アオッ、ドリンクドリンク』" voices=""/>
		<msg @l="1944" char_id="-1" frame_id="-1" name=""
		   text="亜季奈の頭をがっしりと押さえつけ、留学生が激しく腰を叩きつける。" voices=""/>
		<msg @l="1945" char_id="-1" frame_id="-1" name=""
		   text="苦しげに眉根を細めながらも亜季奈はそれを喉奥で受け止め、押し寄せる愉悦の波に腰を震わせていた。" voices=""/>
		<msg @l="1947" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んぐっ‥‥んふっ、んっ、んっ、んっ、んんっ！！』" voices="akina02170"/>
		<msg @l="1949" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んぁぁっ‥‥らめっ‥‥‥いっひゃふ、んふっ、ん、んぐぅっ！！』" voices="akina02180"/>
		<msg @l="1951" char_id="-1" frame_id="-1" name="渡部" text="『いくぞっ！！』"
		   voices=""/>
		<msg @l="1953" char_id="-1" frame_id="-1" name="留学生"
		   text="『ンォアッ！オアッ、オアアアアアァッ！！』" voices=""/>
		<msg @l="1955" char_id="2" frame_id="-1" name="亜季奈" text="『んっ、んんんんんっ！！！』"
		   voices="akina02190"/>
		<flash @l="1959" count="4" fade="100" image="white"/>
		<wait_chgmv/>
		<ev @l="1964" src="ev-022x1y2y4z1z4z2z5"/>
		<msg @l="1966" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んぅっ‥‥んっ、んぐっ‥‥‥‥んくっ‥‥‥んくっ‥‥‥‥。』" voices="akina02200"/>
		<msg @l="1968" char_id="-1" frame_id="-1" name=""
		   text="喉奥に吐き出された大量の樹液を、命令されるまでもなく飲み下していく亜季奈。" voices=""/>
		<msg @l="1969" char_id="-1" frame_id="-1" name="" text="その動作には迷いがない。"
		   voices=""/>
		<msg @l="1971" char_id="-1" frame_id="-1" name="渡部"
		   text="『おおう、搾り取られそうだぜ‥‥。』" voices=""/>
		<msg @l="1973" char_id="-1" frame_id="-1" name=""
		   text="亜季奈の小さな子宮に熱い精を注ぎ込みながら、キュウキュウと肉棒を締め付けてくる膣壁の淫猥な動きに、渡部が楽しげに口元を歪める。"
		   voices=""/>
		<msg @l="1983" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んっ‥‥‥ぷあっ‥‥‥はぁ、はぁ、はぁ、はぁ‥‥‥‥。』" voices="akina02210"/>
		<msg @l="1985" char_id="-1" frame_id="-1" name=""
		   text="搾り取った精液のすべてを飲み下し終えた亜季奈は気だるげに肉塊の先端を吐き出し、肩を揺らしながら荒い呼吸を繰り返している。"
		   voices=""/>
		<msg @l="1986" char_id="-1" frame_id="-1" name=""
		   text="その瞳はどこか虚ろで‥‥微かにくすんでいた。" voices=""/>
		<msg @l="1988" char_id="-1" frame_id="-1" name="渡部"
		   text="『亜季奈、口で抜いた後はキッチリ奥に残ってるモンまで吸い出すのがメス犬の役目だぞ？』" voices=""/>
		<msg @l="1990" char_id="2" frame_id="-1" name="亜季奈"
		   text="『ん、ふぁい‥‥‥あむっ‥‥んっ、ちゅぷ‥‥ちゅぷぷ‥‥‥‥。』" voices="akina02220"/>
		<msg @l="1992" char_id="-1" frame_id="-1" name=""
		   text="再び、亜季奈は眼前で半萎えになっている黒い肉茎を咥え込む。" voices=""/>
		<msg @l="1993" char_id="-1" frame_id="-1" name=""
		   text="肉棒をピチャピチャとしゃぶりながら、奥に残された精を緩やかにチュウチュウと吸い上げていく。" voices=""/>
		<msg @l="1995" char_id="-1" frame_id="-1" name="留学生" text="『オ、オォオッ、ノ、ノーッ。』"
		   voices=""/>
		<msg @l="1997" char_id="-1" frame_id="-1" name="渡部"
		   text="『遠慮するな。また、こいつを使って抜けばいい。』" voices=""/>
		<msg @l="1999" char_id="-1" frame_id="-1" name="渡部"
		   text="『な、そうだろ？&#32;メス犬。』" voices=""/>
		<msg @l="2001" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んはっ‥‥はい、わたしは淫乱なメス犬です‥‥‥‥。』" voices="akina02230"/>
		<msg @l="2003" char_id="2" frame_id="-1" name="亜季奈"
		   text="『私の身体に‥‥たくさん熱いミルクをご馳走してください。』" voices="akina02240"/>
		<msg @l="2005" char_id="-1" frame_id="-1" name="留学生" text="『オーゥ、イエエェス！』"
		   voices=""/>
		<msg @l="2007" char_id="2" frame_id="-1" name="亜季奈" text="『んんっ！！』"
		   voices="akina02250"/>
		<msg @l="2009" char_id="-1" frame_id="-1" name=""
		   text="留学生はそう言うと、亜季奈のバックに回り込み、既に硬く屹立している巨砲を突き入れる。" voices=""/>
		<msg @l="2010" char_id="-1" frame_id="-1" name=""
		   text="亜季奈は精液が溢れ出している秘裂で受け止め、熱のこもった吐息を漏らす。" voices=""/>
		<msg @l="2012" char_id="-1" frame_id="-1" name="渡部"
		   text="『アンタも混じったらどうだ？&#32;まだイケるんだろ？』" voices=""/>
		<msg @l="2014" char_id="-1" frame_id="-1" name="熊野"
		   text="『そうですな‥‥では、もう一度上の口に飲ませてあげましょうか。』" voices=""/>
		<wait_chgmv/>
		<ev @l="2018" src="ev-022x1y1y3z1z4z2z5"/>
		<msg @l="2020" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んぷっ‥‥んっ、んぐっ‥‥‥んっ、んっ、んっ、んぁぁっ！！』" voices="akina02260"/>
		<msg @l="2022" char_id="-1" frame_id="-1" name=""
		   text="三度、亜季奈の口腔と秘部は硬い肉塊によって塞がれる。" voices=""/>
		<msg @l="2023" char_id="-1" frame_id="-1" name=""
		   text="相変わらず嫌悪に歪んだ表情が痛々しくもあり、けれどその表情とは裏腹の積極的な舌使いと腰の動きにわずかな滑稽さを感じたりもする。"
		   voices=""/>
		<msg @l="2024" char_id="-1" frame_id="-1" name=""
		   text="渡部は二人の男に犯されながら悶える亜季奈を見詰めながら、それでも本当に手に入れたかった女を緩々と思い出していた。" voices=""/>
		<msg @l="2026" char_id="-1" frame_id="-1" name="渡部"
		   text="『最高に後悔させてやる‥‥この俺から逃げたコトをな。』" voices=""/>
		<msg @l="2028" char_id="-1" frame_id="-1" name=""
		   text="誰に言うでもなく呟いて、蔑んだ瞳を亜季奈に向ける。" voices=""/>
		<msg @l="2030" char_id="2" frame_id="-1" name="亜季奈"
		   text="『あぁぁっ‥‥んぷっ、ちゅぷ、ちゅるっ‥‥‥ン、んぐぅっ！！』" voices="akina02270"/>
		<msg @l="2032" char_id="2" frame_id="-1" name="亜季奈"
		   text="『はふっ‥‥んぷっ、んぷっ、んぷっ、じゅるるるるっ！！』" voices="akina02280"/>
		<msg @l="2034" char_id="-1" frame_id="-1" name=""
		   text="膣内をかき混ぜる巨棒の動きに合わせて腰をくねらせ、口に突き入れられた逸物に舌を絡み付ける。" voices=""/>
		<msg @l="2035" char_id="-1" frame_id="-1" name=""
		   text="黒く巨大な肉塊に小さな膣を掻き混ぜられ、肉棒の先端からにじみ出す先走りを啜っては飲み下していく。" voices=""/>
		<msg @l="2036" char_id="-1" frame_id="-1" name=""
		   text="淫乱なメス犬が‥‥ソコには出来上がっていた。" voices=""/>
		<msg @l="2038" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んふぅっ‥‥んっ、あふっ‥‥‥あっ、あっ、あっ、んくっ！！』" voices="akina02290"/>
		<msg @l="2040" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んぷっ、んっ、んっ‥‥‥あっ‥‥らめぇ、いっひゃうよぉっ！！』" voices="akina02300"/>
		<msg @l="2042" char_id="-1" frame_id="-1" name="熊野"
		   text="『さあ、お口の中に出してあげますからねぇ。』" voices=""/>
		<msg @l="2044" char_id="-1" frame_id="-1" name="留学生" text="『オゥッ、ジーザス！』"
		   voices=""/>
		<msg @l="2046" char_id="2" frame_id="-1" name="亜季奈"
		   text="『あふっ、んっ、んっ、んっ、ふぁっ‥‥‥んっ、ちゅるるるっ！！』" voices="akina02310"/>
		<msg @l="2048" char_id="-1" frame_id="-1" name="熊野" text="『くっ！！』" voices=""/>
		<msg @l="2050" char_id="-1" frame_id="-1" name="留学生" text="『アオォォ、オァアッ！！』"
		   voices=""/>
		<flash @l="2054" count="4" fade="100" image="white"/>
		<wait_chgmv/>
		<ev @l="2058" src="ev-022x1y1y3z1z4z2z5z3z6"/>
		<msg @l="2060" char_id="2" frame_id="-1" name="亜季奈" text="『んむぅぅっ！！』"
		   voices="akina02320"/>
		<msg @l="2062" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んぅっ‥‥んっ、んんっ‥‥‥‥んぐっ、んく、んくっ‥‥‥。』" voices="akina02330"/>
		<msg @l="2064" char_id="-1" frame_id="-1" name="" text="口と子宮へ三度目の精液が放たれる。"
		   voices=""/>
		<msg @l="2065" char_id="-1" frame_id="-1" name=""
		   text="亜季奈は表情に見せる嫌悪とは何処か違った感情で、ゆっくりと味わうように飲み下してゆく。" voices=""/>
		<msg @l="2067" char_id="2" frame_id="-1" name="亜季奈"
		   text="『あふっ‥‥んっ、はふっ‥‥‥んぷ、ちゅぷっ‥‥ちゅるるっ。』" voices="akina02340"/>
		<msg @l="2069" char_id="-1" frame_id="-1" name=""
		   text="吐き出された精液すべてを飲み下し終え、誰に言われるでもなく尿道に残された子種も吸いとる。" voices=""/>
		<msg @l="2070" char_id="-1" frame_id="-1" name=""
		   text="飲み残しが無くなると、やがて床にこぼれた大量の精液に舌を這わせて啜り始める。" voices=""/>
		<msg @l="2071" char_id="-1" frame_id="-1" name="" text="本物の犬の様に‥‥‥。"
		   voices=""/>
		<clear @l="2077" class="all"/>
		<end_scene @l="2080"/>
		<wait_chgmv/>
		<bg @l="2084" src="bg20b"/>
		<char @l="2088" id="watab" pos="auto" src="watabe010"/>
		<msg @l="2090" char_id="-1" frame_id="-1" name="渡部" text="『よかったな、亜季奈。』"
		   voices=""/>
		<msg @l="2092" char_id="-1" frame_id="-1" name="渡部"
		   text="『これでオマエも立派なメス犬の仲間入りだ。』" voices=""/>
		<msg @l="2094" char_id="-1" frame_id="-1" name=""
		   text="誰に言うでもなく、渡部が吐き捨てるように言葉を紡ぐ。" voices=""/>
		<msg @l="2095" char_id="-1" frame_id="-1" name=""
		   text="渡部の背後からは、四度目の亜季奈の嬌声が聞こえてきていた。" voices=""/>
		<msg @l="2096" char_id="-1" frame_id="-1" name=""
		   text="留学生の精力は尽きることが無く、熊野も飽きずに口を使い続けている。" voices=""/>
		<msg @l="2097" char_id="-1" frame_id="-1" name=""
		   text="夜が明けるまで、亜季奈は後何回、精を浴びる事になるのか‥‥‥。" voices=""/>
		<stopbgm @l="2102" fadeout="1000"/>
		<clear @l="2108" class="all"/>
		<call @l="2112" target="EventLabel_42@ending04"/>
		<return @l="2113" value="0&#13;&#10;"/>
		<return @l="2119" value=""/>
	</code>
</xscript>
