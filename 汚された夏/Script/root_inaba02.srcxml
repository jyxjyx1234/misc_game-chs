<?xml version="1.0" encoding="utf-8"?>
<xscript>
	<debug editor="&quot;C:\Program&#32;Files&#32;(x86)\sakura\sakura.exe&quot;&#32;&quot;%src%&quot;&#32;-Y=%line%"
	   src="D:\シロップ\町ぐるみの罠＋汚された夏セット版\汚された夏\完成データ\汚された夏\script\text\root_inaba02.txt"/>
	<code>
		<label @l="12" id="EventLabel_91"/>
		<description @l="15" text="テニスサークル入会・３日目"/>
		<eval @l="17" expr="f.numDay=9&#13;&#10;"/>
		<msgshow @l="19" show="false"/>
		<wait_chgmv/>
		<bg @l="21" src="day09" time="2000"/>
		<wait @l="23" time="500"/>
		<wait_chgmv/>
		<bg @l="25" src="black" time="2000"/>
		<msgshow @l="27" show="true"/>
		<wait_chgmv/>
		<bg @l="30" src="bg03"/>
		<bgm @l="32" src="bgm02" volume="1."/>
		<char @l="34" id="miho" pos="left" src="miho030"/>
		<char @l="36" id="rei" pos="right" src="rei035"/>
		<msg @l="38" char_id="1" frame_id="-1" name="玲" text="『おはよー‥‥。』" voices=""/>
		<char @l="41" id="miho" pos="left" src="miho031"/>
		<msg @l="43" char_id="0" frame_id="-1" name="美帆" text="『あ、おはようございます。』"
		   voices=""/>
		<msg @l="45" char_id="-1" frame_id="-1" name=""
		   text="寝惚け眼を擦りつつ部屋から出てきた玲さんに、私はキッチンの中からいつもより早めの朝の挨拶を返した。" voices=""/>
		<char @l="48" id="miho" pos="left" src="miho030"/>
		<msg @l="50" char_id="0" frame_id="-1" name="美帆" text="『今日は早いんですね？』"
		   voices=""/>
		<msg @l="52" char_id="1" frame_id="-1" name="玲"
		   text="『昨日ね‥‥うちの教授から突然電話がかかってきてね。』" voices=""/>
		<msg @l="54" char_id="0" frame_id="-1" name="美帆" text="『あれからですか？』" voices=""/>
		<msg @l="56" char_id="1" frame_id="-1" name="玲"
		   text="『この忙しい時期に、教授が手伝いに来てくれって言うから早出なのよ。』" voices=""/>
		<msg @l="58" char_id="1" frame_id="-1" name="玲"
		   text="『まったく‥‥就職活動中だって事を考えて欲しいわね。』" voices=""/>
		<char @l="61" id="miho" pos="left" src="miho036"/>
		<msg @l="63" char_id="0" frame_id="-1" name="美帆" text="『それは大変ですね。』"
		   voices=""/>
		<msg @l="65" char_id="1" frame_id="-1" name="玲" text="『ほんとよ‥‥。』" voices=""/>
		<clear @l="68" layer="rei"/>
		<msg @l="70" char_id="-1" frame_id="-1" name="" text="玲さんは気だるそうにソファへ腰掛ける。"
		   voices=""/>
		<msg @l="71" char_id="-1" frame_id="-1" name=""
		   text="テレビのリモコンに手を伸ばし‥‥電源をつける。" voices=""/>
		<msg @l="72" char_id="-1" frame_id="-1" name=""
		   text="テレビ画面には早朝にやっている「めざめテレビ」が映っていた。" voices=""/>
		<char @l="75" id="miho" pos="left" src="miho130"/>
		<msg @l="77" char_id="0" frame_id="-1" name="美帆"
		   text="『はい、眠気覚ましのコーヒーです。ちょっと濃いかもしれないですけど。』" voices=""/>
		<char @l="80" id="rei" pos="right" src="rei031"/>
		<msg @l="82" char_id="1" frame_id="-1" name="玲" text="『ありがと。』" voices=""/>
		<msg @l="84" char_id="-1" frame_id="-1" name=""
		   text="寝惚けた笑顔を浮かべながら玲さんは、湯気の立ったコーヒーをひとくち口へと運んだ。" voices=""/>
		<char @l="87" id="rei" pos="right" src="rei030"/>
		<msg @l="89" char_id="1" frame_id="-1" name="玲"
		   text="『んー‥‥この味が、眠気のとれない頭に効くわ。』" voices=""/>
		<char @l="92" id="miho" pos="left" src="miho131"/>
		<msg @l="94" char_id="0" frame_id="-1" name="美帆" text="『ふふ、良かったです。』"
		   voices=""/>
		<clear @l="97" class="char"/>
		<char @l="99" id="rei" pos="auto" src="rei030"/>
		<msg @l="101" char_id="0" frame_id="-1" name="美帆"
		   text="『あ、そういえば‥‥‥玲さん、今日は来れないんですか？』" voices=""/>
		<msg @l="103" char_id="-1" frame_id="-1" name=""
		   text="私はキッチンに戻り、コーンスープの鍋をかき混ぜながら声をかけた。" voices=""/>
		<char @l="106" id="rei" pos="auto" src="rei034"/>
		<msg @l="108" char_id="1" frame_id="-1" name="玲" text="『今日？&#32;何かあったかしら？』"
		   voices=""/>
		<msg @l="110" char_id="0" frame_id="-1" name="美帆"
		   text="『知らないんですか？&#32;テニスサークルで新入生歓迎会があるって話を。』" voices=""/>
		<msg @l="112" char_id="1" frame_id="-1" name="玲" text="『えっ？聞いてないわよ、そんなこと。』"
		   voices=""/>
		<msg @l="114" char_id="0" frame_id="-1" name="美帆" text="『そうなんですか？』"
		   voices=""/>
		<char @l="117" id="rei" pos="auto" src="rei030"/>
		<msg @l="119" char_id="1" frame_id="-1" name="玲"
		   text="『う～ん、最近就職活動でテンパッちゃってるから聞き逃したのかもね。』" voices=""/>
		<msg @l="121" char_id="1" frame_id="-1" name="玲" text="『で、アナタは出るつもり？』"
		   voices=""/>
		<msg @l="123" char_id="0" frame_id="-1" name="美帆"
		   text="『はい。折角、新入生歓迎会を開いてくれたのに、新入部員である私が参加しないのは失礼かなって？‥‥』" voices=""/>
		<msg @l="125" char_id="1" frame_id="-1" name="玲"
		   text="『とかいって、ほんとは稲庭さん目当てなんでしょう。』" voices=""/>
		<msg @l="127" char_id="0" frame_id="-1" name="美帆"
		   text="『そ、そそそっ、そんなことないですよっ！』" voices=""/>
		<char @l="130" id="rei" pos="auto" src="rei031"/>
		<msg @l="132" char_id="1" frame_id="-1" name="玲"
		   text="『ハイハイ、解りやすいリアクションをありがとう。』" voices=""/>
		<msg @l="134" char_id="0" frame_id="-1" name="美帆" text="『うぅ‥‥。』" voices=""/>
		<msg @l="136" char_id="1" frame_id="-1" name="玲"
		   text="『さーて、それじゃあ恋敵のアナタに負けない為にも、私もその歓迎会には顔を出しておかなくっちゃ。』" voices=""/>
		<char @l="139" id="rei" pos="auto" src="rei030"/>
		<msg @l="141" char_id="1" frame_id="-1" name="玲"
		   text="『あっ、でも遅れると思うから、それまで稲庭さんには手を出さないでおいてね。』" voices=""/>
		<clear @l="144" class="char"/>
		<char @l="146" id="miho" pos="auto" src="miho136"/>
		<msg @l="148" char_id="0" frame_id="-1" name="美帆" text="『玲さん‥‥。』" voices=""/>
		<msg @l="150" char_id="-1" frame_id="-1" name=""
		   text="視線はテレビ画面に映っているワイドショーに向けたまま、玲さんはそう言って‥‥たぶん寂しげに笑った。" voices=""/>
		<stopbgm @l="153" fadeout="1000"/>
		<clear @l="156" class="all"/>
		<msgshow @l="158" show="true"/>
		<wait_chgmv/>
		<bg @l="161" src="bg13m1"/>
		<bgm @l="164" src="bgm06" volume="1."/>
		<char @l="167" id="inaba" pos="auto" src="inaba050"/>
		<msg @l="169" char_id="-1" frame_id="-1" name="稲庭"
		   text="『それでは、これより新入生歓迎のテニス大会を行います。』" voices=""/>
		<msg @l="171" char_id="-1" frame_id="-1" name="" text="午後二時を少し回った頃‥‥。"
		   voices=""/>
		<msg @l="172" char_id="-1" frame_id="-1" name="" text="テニスコートに声が響き渡っている。"
		   voices=""/>
		<msg @l="173" char_id="-1" frame_id="-1" name=""
		   text="軽い昼食会兼ビンゴ大会で部員同士親睦を深めた後、いよいよ本日のメインイベントであるテニス大会が行われる事になった。"
		   voices=""/>
		<msg @l="174" char_id="-1" frame_id="-1" name=""
		   text="司会役である稲庭先輩の周囲には私を含めた新入会員一同が並び、その後ろには先輩会員の人たちがずらりと並んでいる。" voices=""/>
		<msg @l="175" char_id="-1" frame_id="-1" name=""
		   text="ただ、先輩会員達の中に玲さんの姿は見えなかった。" voices=""/>
		<msg @l="177" char_id="0" frame_id="1" name="美帆" text="（遅れるって言ってたっけ）"
		   voices=""/>
		<msg @l="179" char_id="-1" frame_id="-1" name=""
		   text="どこかほっとしている自分に気づき、ちょっとだけ嫌な気分になった。" voices=""/>
		<msg @l="181" char_id="-1" frame_id="-1" name="稲庭"
		   text="『今回参加の新入生は全員で三十六人ですので、二つの会場にわけてそれぞれ試合を行いたいと思います。』" voices=""/>
		<msg @l="183" char_id="-1" frame_id="-1" name="稲庭"
		   text="『親睦を深める為の試合ですので、あまり気負わずに楽しんでいってください。』" voices=""/>
		<msg @l="185" char_id="-1" frame_id="-1" name=""
		   text="稲庭先輩の指示で、先輩部員の人達が対戦相手と試合場所の書かれた用紙を新入生たちに一人ずつ手渡していく。" voices=""/>
		<msg @l="186" char_id="-1" frame_id="-1" name=""
		   text="それを受け取って内容を確認すると‥‥私の試合は第二会場で行われるらしい。" voices=""/>
		<clear @l="188" class="char"/>
		<msg @l="190" char_id="-1" frame_id="-1" name="女子会員Ａ"
		   text="『案内してあげるわ。さあ、行きましょう。』" voices=""/>
		<msg @l="192" char_id="-1" frame_id="-1" name=""
		   text="昼食会で仲良くなった女子の先輩たちに連れられて第二会場へと向かう。" voices=""/>
		<msg @l="193" char_id="-1" frame_id="-1" name=""
		   text="歩いている間、私にしては珍しくほぼ初対面だというのに話がはずむ。" voices=""/>
		<clear @l="196" class="all"/>
		<char @l="199" id="miho" pos="auto" src="miho051"/>
		<msg @l="201" char_id="0" frame_id="1" name="美帆"
		   text="『稲庭先輩ってやっぱりスゴイです。大学のサークルのビンゴ大会であれだけ沢山のスポンサーがついちゃうんですもの。』" voices=""/>
		<msg @l="203" char_id="-1" frame_id="-1" name="女子会員Ｂ"
		   text="『そうよね、そのバッグなんてヴィドンの新作でしょ？都内のショップにだってまだほとんど入ってきてないわよ。』" voices=""/>
		<msg @l="205" char_id="0" frame_id="1" name="美帆" text="『あ、わかります？』" voices=""/>
		<clear @l="208" class="char"/>
		<msg @l="210" char_id="-1" frame_id="-1" name=""
		   text="昼食会ではテレビで見たことのある一流シェフが腕をふるい、ビンゴ大会では大黒グループをはじめとする大企業が賞品を提供する。"
		   voices=""/>
		<msg @l="211" char_id="-1" frame_id="-1" name=""
		   text="有名ブランドのバッグが当たったせいもあるのだろうか、生まれてはじめて経験する華やかな世界に私はすっかり舞い上がっていた。"
		   voices=""/>
		<msg @l="213" char_id="-1" frame_id="-1" name="女子会員Ｃ" text="『さあ、着いたわよ。』"
		   voices=""/>
		<wait_chgmv/>
		<bg @l="216" src="bg13"/>
		<char @l="219" id="miho" pos="auto" src="miho050"/>
		<msg @l="221" char_id="-1" frame_id="-1" name=""
		   text="先輩達に案内され、テニス部のサブグラウンドでもある第二会場へ足を踏み入れる。" voices=""/>
		<msg @l="222" char_id="-1" frame_id="-1" name=""
		   text="早速用紙に書かれたとおりの場所で準備を始めるが、このときはじめてあるおかしな点に気づいた。" voices=""/>
		<msg @l="223" char_id="-1" frame_id="-1" name=""
		   text="男子生徒が一人もいないのだ。先輩も同級生も。" voices=""/>
		<msg @l="224" char_id="-1" frame_id="-1" name=""
		   text="そうこうしているうちに女子のリーダー格らしき人‥‥さっきまで一緒に雑談していた人だ‥‥がグラウンドの中央にやって来た。"
		   voices=""/>
		<msg @l="226" char_id="-1" frame_id="-1" name="女子会員Ａ"
		   text="『それじゃあテニス部恒例の脱衣テニスを始めまーす。』" voices=""/>
		<stopbgm @l="229" fadeout="1000"/>
		<char @l="231" id="miho" pos="auto" src="miho054"/>
		<msg @l="233" char_id="0" frame_id="1" name="美帆" text="『えっ？』" voices=""/>
		<msg @l="235" char_id="-1" frame_id="-1" name="" text="私は一瞬自分の耳を疑った。"
		   voices=""/>
		<msg @l="236" char_id="-1" frame_id="-1" name=""
		   text="「脱衣テニス」‥‥彼女はそう言ったのだろうか。" voices=""/>
		<msg @l="238" char_id="-1" frame_id="-1" name="女子会員Ａ"
		   text="『ちなみに勝者にはなんと、会長の稲庭さん主催の二次会に参加出来まーす。』" voices=""/>
		<bgm @l="241" src="bgm09" volume="1."/>
		<msg @l="243" char_id="0" frame_id="1" name="美帆"
		   text="『そ、そうじゃなくって、どういう事なんですか？』" voices=""/>
		<msg @l="245" char_id="-1" frame_id="-1" name="女子会員Ａ"
		   text="『野球拳ってあるでしょ？ジャンケンで負けるたびに一枚ずつ服を脱いでいくってやつ。あれのテニス版ね。』" voices=""/>
		<msg @l="247" char_id="-1" frame_id="-1" name="女子会員Ａ"
		   text="『ポイントを取られるごとに上着、スカート、ブラジャー、パンティーと服を脱いでもらい、４ポイント、つまり１ゲーム取られたら負けになります。ちなみに、枚数が合わなくなるのでスコートの着用は認めません。』"
		   voices=""/>
		<char @l="250" id="miho" pos="auto" src="miho056"/>
		<msg @l="252" char_id="0" frame_id="1" name="美帆" text="『そういう事じゃなくて‥‥。』"
		   voices=""/>
		<msg @l="254" char_id="-1" frame_id="-1" name="女子会員Ａ"
		   text="『そのために女子同士、男子同士で場所を分けてあるの。女の子同士なら裸になっても恥ずかしくないでしょ？』" voices=""/>
		<msg @l="256" char_id="0" frame_id="1" name="美帆" text="『でも、ここ外だし。』"
		   voices=""/>
		<msg @l="258" char_id="-1" frame_id="-1" name="女子会員Ａ"
		   text="『ここは周囲から離れている上にテニス部の貸切だし、部員から見張りも出してるから絶対大丈夫、ねっ？』" voices=""/>
		<msg @l="260" char_id="0" frame_id="1" name="美帆" text="『でも‥‥。』" voices=""/>
		<msg @l="262" char_id="-1" frame_id="-1" name="女子会員Ａ"
		   text="『これはね、ここのキャンパスに移ってくる前から十何年も受け継がれている部の伝統行事なの。それをあなた一人のわがままでぶち壊すつもり？』"
		   voices=""/>
		<msg @l="264" char_id="-1" frame_id="-1" name=""
		   text="一瞬険しくなった彼女の声にハッと我に返って周りを見ると、同級生達は既にいつでも試合が出来る体勢のままジッと私のほうを見ていた。"
		   voices=""/>
		<msg @l="265" char_id="-1" frame_id="-1" name=""
		   text="さっきの雑談の流れのまま思わず話しかけてしまったが、冷静に考えると私一人が食って掛かるような形になってしまっている。"
		   voices=""/>
		<msg @l="267" char_id="-1" frame_id="-1" name="同級生Ａ" text="『いつまで待たせる気かしら。』"
		   voices=""/>
		<msg @l="269" char_id="-1" frame_id="-1" name="同級生Ｂ"
		   text="『先輩が大丈夫だって言ってんじゃん。』" voices=""/>
		<msg @l="271" char_id="-1" frame_id="-1" name="同級生Ｃ"
		   text="『いまさら恥ずかしがるようなトシでもないでしょうに。』" voices=""/>
		<msg @l="273" char_id="-1" frame_id="-1" name="同級生Ｄ"
		   text="『一人でカマトトぶっちゃってさ、恥ずかしいやつぅ。』" voices=""/>
		<msg @l="275" char_id="-1" frame_id="-1" name=""
		   text="最初は私と一緒に不安な声をあげていた子たちが、聞こえるようなひそひそ声でじわじわと私を追い詰める。" voices=""/>
		<msg @l="276" char_id="-1" frame_id="-1" name=""
		   text="さすがにこの状況に流されないで拒否できるほど私は強くない。" voices=""/>
		<msg @l="277" char_id="-1" frame_id="-1" name=""
		   text="大丈夫、これだけ立派なサークルがやることだもの、それに稲庭先輩も許可しているんだし。" voices=""/>
		<msg @l="278" char_id="-1" frame_id="-1" name="" text="大丈夫、女の子だけなんだし、大丈夫‥‥。"
		   voices=""/>
		<msg @l="279" char_id="-1" frame_id="-1" name=""
		   text="自分に言い聞かせるように心の中で大丈夫を連呼する。" voices=""/>
		<char @l="282" id="miho" pos="auto" src="miho055"/>
		<stopbgm @l="285" fadeout="1000"/>
		<msg @l="287" char_id="0" frame_id="1" name="美帆" text="『‥‥わかりました。』"
		   voices=""/>
		<bgm @l="290" src="bgm06" volume="1."/>
		<msg @l="292" char_id="-1" frame_id="-1" name="女子会員Ａ"
		   text="『それじゃあ、はじめましょうか。対戦相手はみんなのテニス歴や練習内容を見て決定したから実力差はさほど無い筈よ、がんばって。』"
		   voices=""/>
		<msg @l="294" char_id="-1" frame_id="-1" name="" text="私は覚悟を決めてコート中央に向かう。"
		   voices=""/>
		<msg @l="296" char_id="-1" frame_id="-1" name="女の子" text="『よろしくおねがいしまぁす。』"
		   voices=""/>
		<char @l="299" id="miho" pos="auto" src="miho056"/>
		<msg @l="301" char_id="0" frame_id="1" name="美帆" text="『よ、よろしく‥‥。』"
		   voices=""/>
		<msg @l="303" char_id="-1" frame_id="-1" name=""
		   text="私の相手は、新入部員の中でも目立ってどんくさい女の子だった。" voices=""/>
		<msg @l="304" char_id="-1" frame_id="-1" name=""
		   text="悪いけど、これなら私でもなんとかなるかも‥‥。" voices=""/>
		<stopbgm @l="307" fadeout="1000"/>
		<clear @l="310" class="all"/>
		<msg @l="312" char_id="-1" frame_id="-1" name="女子会員Ｂ"
		   text="『オーバーサーブは‥‥二人ともまだ無理だから、双方ともアンダーサーブで構わないわね？』" voices=""/>
		<msg @l="314" char_id="0" frame_id="1" name="美帆" text="『はい‥‥それでお願いします。』"
		   voices=""/>
		<msg @l="316" char_id="-1" frame_id="-1" name="女子会員Ｂ"
		   text="『今回は１ゲームマッチなので、１ポイント毎にサーブ権を交代する変則ルールとします。』" voices=""/>
		<msg @l="318" char_id="-1" frame_id="-1" name="女子会員Ｂ"
		   text="『それじゃあ、鈴木さんからのサーブでゲーム開始しましょう』" voices=""/>
		<msg @l="320" char_id="-1" frame_id="-1" name="鈴木" text="『はぁい。』" voices=""/>
		<label @l="323" id="event_scene43"/>
		<label @l="326" id="chart_line9"/>
		<wait_chgmv/>
		<ev @l="328" src="ev-043y1y2y3"/>
		<description @l="330" text="脱衣テニス勝負"/>
		<bgm @l="333" src="bgm14" volume="1."/>
		<msg @l="335" char_id="-1" frame_id="-1" name=""
		   text="私はラケットを構え、ネットを挟んで対峙した女の子‥‥鈴木さんを見る。" voices=""/>
		<msg @l="337" char_id="-1" frame_id="-1" name="鈴木"
		   text="『ほあぁ‥‥サーブってどうにも苦手なんですよぉ。』" voices=""/>
		<msg @l="339" char_id="0" frame_id="1" name="美帆" text="『‥‥‥‥。』"
		   voices="miho05250"/>
		<msg @l="341" char_id="-1" frame_id="-1" name=""
		   text="鈴木さんは私よりも一回りほど小柄で、いつも眠そうな顔をしている子だ。" voices=""/>
		<msg @l="342" char_id="-1" frame_id="-1" name=""
		   text="稲庭先輩目当てで入部した新入部員の例に漏れず、およそ球技とは無縁の生活を送ってきたらしい。" voices=""/>
		<msg @l="343" char_id="-1" frame_id="-1" name=""
		   text="私も球技はあまり得意ではないが、過去に水泳で鍛えたので体力には多少の自信はある。" voices=""/>
		<msg @l="344" char_id="-1" frame_id="-1" name="" text="大丈夫‥‥いける。" voices=""/>
		<msg @l="346" char_id="-1" frame_id="-1" name="女子会員Ｂ"
		   text="『試合開始は私がホイッスルを鳴らすから、それを合図に試合を始めるように。』" voices=""/>
		<msg @l="348" char_id="-1" frame_id="-1" name="鈴木" text="『わかりましたぁ。』"
		   voices=""/>
		<msg @l="350" char_id="0" frame_id="1" name="美帆" text="『‥‥‥‥。』"
		   voices="miho05260"/>
		<msg @l="352" char_id="-1" frame_id="-1" name="" text="一刻も早く試合を終わらせたい。"
		   voices=""/>
		<msg @l="353" char_id="-1" frame_id="-1" name=""
		   text="ストレートで試合に勝ちさえすれば脱がなくていいし、稲庭先輩と二次会が‥‥。" voices=""/>
		<msg @l="355" char_id="0" frame_id="1" name="美帆" text="(先輩‥‥‥‥私‥‥‥)"
		   voices="miho05270"/>
		<msg @l="357" char_id="-1" frame_id="-1" name=""
		   text="私はぐっと唇を噛み締め、雑念を払うように深呼吸をする。" voices=""/>
		<msg @l="358" char_id="-1" frame_id="-1" name=""
		   text="そんなに現実は甘くは無い、集中しなければ。" voices=""/>
		<clear @l="361" class="all"/>
		<wait_chgmv/>
		<bg @l="363" src="bg13"/>
		<stopbgm @l="365" fadeout="1000"/>
		<se @l="368" buf="1" src="ホイッスル（テニス場）" volume="1."/>
		<bgm @l="370" src="bgm17" volume="1."/>
		<msg @l="372" char_id="0" frame_id="1" name="美帆" text="『‥‥！！』"
		   voices="miho05290"/>
		<msg @l="374" char_id="-1" frame_id="-1" name="" text="―――試合が始まった。"
		   voices=""/>
		<msg @l="375" char_id="-1" frame_id="-1" name=""
		   text="鈴木さんは手にしていたボールを軽く上に放り上げると‥‥。" voices=""/>
		<se @l="378" buf="1" src="テニスボール打つ音" volume="1."/>
		<msg @l="380" char_id="-1" frame_id="-1" name="" text="落ちてきた所をラケットで打つ。"
		   voices=""/>
		<se @l="383" buf="1" src="ホイッスル（テニス場）" volume="1."/>
		<msg @l="385" char_id="0" frame_id="1" name="美帆" text="『あっ‥‥！？』"
		   voices="miho05300"/>
		<msg @l="387" char_id="-1" frame_id="-1" name="" text="それは一瞬だった。" voices=""/>
		<msg @l="388" char_id="-1" frame_id="-1" name=""
		   text="気付けば‥‥鈴木さんの打ったボールは私の後ろの方で既に転がっていた。" voices=""/>
		<msg @l="390" char_id="-1" frame_id="-1" name="鈴木" text="『おおっ！？』" voices=""/>
		<msg @l="392" char_id="-1" frame_id="-1" name=""
		   text="打った鈴木さんも驚くくらいの強烈なサーブがコートに突き刺さり、一枚も脱がずに済ませるという考えはのっけから崩れ去った。"
		   voices=""/>
		<msg @l="394" char_id="-1" frame_id="-1" name="女子会員Ｂ" text="『ポイント、鈴木。０－１５』"
		   voices=""/>
		<msg @l="396" char_id="-1" frame_id="-1" name="" text="審判が無感情な声で言う。"
		   voices=""/>
		<msg @l="398" char_id="-1" frame_id="-1" name="女子会員Ｃ"
		   text="『１ポイント取られちゃったね。』" voices=""/>
		<msg @l="400" char_id="-1" frame_id="-1" name=""
		   text="女子の先輩がいやらしい笑いを浮かべながら、私の近くに寄ってくる。" voices=""/>
		<msg @l="401" char_id="-1" frame_id="-1" name="" text="そして、ゆっくりと手を差し出した。"
		   voices=""/>
		<msg @l="403" char_id="0" frame_id="1" name="美帆" text="『‥‥‥‥。』"
		   voices="miho05310"/>
		<msg @l="405" char_id="-1" frame_id="-1" name="" text="ポイント‥‥失点。" voices=""/>
		<msg @l="406" char_id="-1" frame_id="-1" name=""
		   text="つまり、服を一枚脱いでよこせということなのだろう。" voices=""/>
		<wait_chgmv/>
		<ev @l="409" src="ev-043y1y2y3"/>
		<wait_chgmv/>
		<ev @l="412" src="ev-043y2y3"/>
		<msg @l="414" char_id="-1" frame_id="-1" name="" text="約束なのだから‥‥仕方が無い。"
		   voices=""/>
		<msg @l="415" char_id="-1" frame_id="-1" name=""
		   text="私はテニスウェアの上を脱いで、それを女子の先輩に渡す。" voices=""/>
		<msg @l="416" char_id="-1" frame_id="-1" name="" text="次は私のサーブの番だ。"
		   voices=""/>
		<msg @l="417" char_id="-1" frame_id="-1" name="" text="ここで失点を取り返さなければ‥‥。"
		   voices=""/>
		<msg @l="419" char_id="-1" frame_id="-1" name=""
		   text="私は深呼吸すると、相手のコートを見ながらどこにサーブを落とそうか考える。" voices=""/>
		<msg @l="420" char_id="-1" frame_id="-1" name=""
		   text="鈴木さんはコートの真ん中ではなく、明らかに右寄りに立っていた。" voices=""/>
		<msg @l="421" char_id="-1" frame_id="-1" name=""
		   text="どう見てもこちらから見て右側のスペースが開いている。" voices=""/>
		<msg @l="423" char_id="0" frame_id="1" name="美帆" text="(右‥‥？)"
		   voices="miho05330"/>
		<msg @l="425" char_id="-1" frame_id="-1" name=""
		   text="なるべく右側にボールを落とすことを意識しつつ、サーブの体勢に入った。" voices=""/>
		<msg @l="426" char_id="-1" frame_id="-1" name=""
		   text="ボールを空中高く放り投げ、力を入れすぎないように意識して下からラケットを振り上げる。" voices=""/>
		<msg @l="427" char_id="-1" frame_id="-1" name=""
		   text="だが、ボールはラケットの中心ではなくフレームに近い部分に当たり、私の手首に強い衝撃を伝えてくる。" voices=""/>
		<msg @l="429" char_id="0" frame_id="1" name="美帆" text="『くっ‥‥。』"
		   voices="miho05320"/>
		<msg @l="431" char_id="-1" frame_id="-1" name=""
		   text="鈍い感触とともに、ボールはあさっての方向へ飛んでいった。" voices=""/>
		<msg @l="433" char_id="0" frame_id="1" name="美帆" text="(うそ、反対っ！？)"
		   voices="miho05340"/>
		<msg @l="435" char_id="-1" frame_id="-1" name=""
		   text="ボールはちょうど鈴木さんの正面に飛んでいき、彼女がとっさにラケットを出すとあっさりと私のコートに戻ってきた。" voices=""/>
		<msg @l="436" char_id="-1" frame_id="-1" name=""
		   text="私は体勢を立て直し、慌てて戻ろうとする‥‥‥。" voices=""/>
		<msg @l="437" char_id="-1" frame_id="-1" name="" text="けれど、間に合わなかった。"
		   voices=""/>
		<se @l="440" buf="1" src="ホイッスル（テニス場）" volume="1."/>
		<msg @l="442" char_id="-1" frame_id="-1" name=""
		   text="ボールはネットからそう離れてない場所に落ち、私の足元にコロコロと転がってきた。" voices=""/>
		<msg @l="444" char_id="0" frame_id="1" name="美帆" text="『くっ‥‥。』"
		   voices="miho05320"/>
		<msg @l="446" char_id="-1" frame_id="-1" name="女子会員Ｂ" text="『ポイント、鈴木。０－３０』"
		   voices=""/>
		<msg @l="448" char_id="-1" frame_id="-1" name="女子会員Ｃ"
		   text="『残念‥‥またポイントを取られちゃったね。』" voices=""/>
		<msg @l="450" char_id="0" frame_id="1" name="美帆" text="『‥‥‥‥。』"
		   voices="miho05350"/>
		<msg @l="452" char_id="-1" frame_id="-1" name="女子会員Ｃ"
		   text="『さあ、次はスカートを脱いで。』" voices=""/>
		<msg @l="454" char_id="-1" frame_id="-1" name=""
		   text="スカートに手をかけながらも、恥ずかしくて私はなかなか脱ぐことができなかった。" voices=""/>
		<msg @l="456" char_id="-1" frame_id="-1" name="女子会員Ｃ"
		   text="『脱げないの？&#32;なら私が脱がしてあげようか？』" voices=""/>
		<msg @l="458" char_id="-1" frame_id="-1" name=""
		   text="女子の先輩はそう言ってにやにやしながら近づいてくる。" voices=""/>
		<msg @l="460" char_id="0" frame_id="1" name="美帆" text="『じ、自分で脱ぎます！』"
		   voices="miho05360"/>
		<wait_chgmv/>
		<ev @l="463" src="ev-043y3"/>
		<msg @l="465" char_id="-1" frame_id="-1" name=""
		   text="彼女の態度に何か怪しいものを感じた私は、意を決してスカートを脱いだ。" voices=""/>
		<msg @l="467" char_id="-1" frame_id="-1" name="女子会員Ｃ"
		   text="『あら、パンツにしみが‥‥。これって汗？それとも‥‥。』" voices=""/>
		<msg @l="468" char_id="0" frame_id="1" name="美帆" text="『な‥‥何をっ！』"
		   voices="miho05370"/>
		<msg @l="470" char_id="-1" frame_id="-1" name="女子会員Ｂ"
		   text="『仲根さん、まだ試合中よ、早くコートに戻って！』" voices=""/>
		<msg @l="472" char_id="-1" frame_id="-1" name="" text="審判が私の抗議を強引にさえぎる。"
		   voices=""/>
		<msg @l="473" char_id="-1" frame_id="-1" name="" text="早く終わってほしい‥‥。"
		   voices=""/>
		<msg @l="474" char_id="-1" frame_id="-1" name=""
		   text="私は下着姿のまま、とぼとぼとコート中央に戻った。" voices=""/>
		<clear @l="477" class="all"/>
		<wait_chgmv/>
		<ev @l="480" src="ev-043"/>
		<msg @l="482" char_id="-1" frame_id="-1" name=""
		   text="あれから、私たちは一進一退の攻防を繰り返していた。" voices=""/>
		<msg @l="483" char_id="-1" frame_id="-1" name=""
		   text="正確には下手な初心者同士がミスで自滅しあうという泥仕合が続き、同点（デュース）からどうしても２ポイント差をつけられないまま、お互いにパンツ一枚の格好でずるずると時間だけが経過していた。"
		   voices=""/>
		<msg @l="485" char_id="-1" frame_id="-1" name="女子会員Ｂ" text="『デュース。』"
		   voices=""/>
		<msg @l="487" char_id="-1" frame_id="-1" name=""
		   text="鈴木さんのサーブが私のはるか頭上を超えて行き、勝負はまた振り出しに戻った。" voices=""/>
		<msg @l="488" char_id="-1" frame_id="-1" name=""
		   text="既に決着が着いて控え室に戻ってしまったのか、このグラウンドで脱衣テニスをしているのは私達だけになっていた。" voices=""/>
		<msg @l="489" char_id="-1" frame_id="-1" name=""
		   text="気づくと周囲にはなぜか男子部員達がいて、女子のギャラリーに混じってこちらをジィッと見ている。" voices=""/>
		<msg @l="490" char_id="-1" frame_id="-1" name=""
		   text="私は審判に疑問をぶつけるが、時間がかかったのが悪いと全く取り合ってくれない。" voices=""/>
		<msg @l="492" char_id="-1" frame_id="-1" name="女子会員Ｂ"
		   text="『ここで止めたら両者失格よ。ここまでがんばった鈴木さんの努力を無駄にするつもり？』" voices=""/>
		<msg @l="494" char_id="-1" frame_id="-1" name=""
		   text="私はコートの向こうを見ると、鈴木さんもまたパンツ一枚の格好で周囲からの好奇の視線に耐えていた。" voices=""/>
		<msg @l="495" char_id="-1" frame_id="-1" name=""
		   text="彼女も稲庭先輩の二次会に参加したくて頑張ってるんだ‥‥。" voices=""/>
		<msg @l="496" char_id="-1" frame_id="-1" name=""
		   text="私一人の意思ではもはや止める事は出来なかった。" voices=""/>
		<msg @l="498" char_id="0" frame_id="1" name="美帆" text="『つ、続けます。』"
		   voices="miho05380"/>
		<msg @l="500" char_id="-1" frame_id="-1" name="女子会員Ｂ"
		   text="『それじゃあ、次は仲根さんがサーブね。』" voices=""/>
		<msg @l="502" char_id="-1" frame_id="-1" name="女子会員Ｂ"
		   text="『このままだとらちが開かないから、次にポイントを取った方の勝ちにします。それでいいわね。』" voices=""/>
		<msg @l="504" char_id="0" frame_id="1" name="美帆" text="『は、はいっ。』"
		   voices="miho05390"/>
		<msg @l="506" char_id="-1" frame_id="-1" name="鈴木" text="『お、おっけーですぅ。』"
		   voices=""/>
		<msg @l="508" char_id="-1" frame_id="-1" name="" text="これでやっと勝負から開放される。"
		   voices=""/>
		<msg @l="509" char_id="-1" frame_id="-1" name=""
		   text="私はサーブを打つためにライン際まで引き返した。" voices=""/>
		<msg @l="511" char_id="-1" frame_id="-1" name="男子会員Ａ"
		   text="『おおっ、きれいなおっぱいしてるじゃん。』" voices=""/>
		<msg @l="513" char_id="-1" frame_id="-1" name="男子会員Ｂ"
		   text="『サイズも大きすぎず、小さすぎずで‥‥たまりませんなぁ。』" voices=""/>
		<msg @l="515" char_id="-1" frame_id="-1" name="男子会員Ｃ"
		   text="『さきっちょのサクランボちゃんもきれいなピンク色で、むしゃぶりつきてえよ。』" voices=""/>
		<msg @l="517" char_id="-1" frame_id="-1" name=""
		   text="後方では、ベンチに座った男子部員達が私の晒された胸を見ながら口々に好き勝手なことを言い合っている。" voices=""/>
		<msg @l="518" char_id="-1" frame_id="-1" name=""
		   text="私は羞恥に体を震わせながらも、右手にボールを持ちラケットを構えた。" voices=""/>
		<msg @l="520" char_id="-1" frame_id="-1" name="" text="くちゃっ‥‥。" voices=""/>
		<stopbgm @l="523" fadeout="1000"/>
		<msg @l="525" char_id="0" frame_id="1" name="美帆" text="(え‥‥)"
		   voices="miho00210"/>
		<bgm @l="528" src="bgm13" volume="1."/>
		<msg @l="530" char_id="-1" frame_id="-1" name=""
		   text="彼らから胸を隠すように体を軽くひねった瞬間、股間からねっとりした水音が聞こえた。" voices=""/>
		<msg @l="532" char_id="-1" frame_id="-1" name="男子会員Ａ" text="『お、おい今のって‥‥。』"
		   voices=""/>
		<msg @l="534" char_id="0" frame_id="1" name="美帆" text="(まさか‥‥気付かれちゃった‥‥！？)"
		   voices="miho07420"/>
		<msg @l="536" char_id="-1" frame_id="-1" name="男子会員Ｂ" text="『ああ‥‥。』"
		   voices=""/>
		<msg @l="538" char_id="-1" frame_id="-1" name=""
		   text="男子の先輩の一人がうなずくと、慌てて他の男子達に伝令に行く。" voices=""/>
		<msg @l="539" char_id="-1" frame_id="-1" name=""
		   text="あっという間に、私の後には大勢の男子達が陣取っていた。" voices=""/>
		<msg @l="541" char_id="0" frame_id="1" name="美帆" text="『え‥‥なに？』"
		   voices="miho00350"/>
		<msg @l="543" char_id="-1" frame_id="-1" name="男子会員Ｃ"
		   text="『いいからいいから、試合を続けて。』" voices=""/>
		<msg @l="545" char_id="-1" frame_id="-1" name=""
		   text="私はサーブの予備動作のため、前かがみの体勢になる。" voices=""/>
		<msg @l="547" char_id="-1" frame_id="-1" name="男子会員Ｄ"
		   text="『おっ‥‥おおーっ！すげえ、本当に濡れてるよ。』" voices=""/>
		<msg @l="549" char_id="0" frame_id="1" name="美帆" text="『‥‥‥やっ！！』"
		   voices="miho00370"/>
		<msg @l="551" char_id="-1" frame_id="-1" name=""
		   text="私は思わず跳ね起き、あわてておしりの方へ手を回して隠そうとする。" voices=""/>
		<msg @l="552" char_id="-1" frame_id="-1" name=""
		   text="そうすると今度はパンツの中がぐちゃりとさっきよりもはっきりわかるくらい大きな音を立てた。" voices=""/>
		<msg @l="554" char_id="-1" frame_id="-1" name="男子会員Ｆ"
		   text="『うわっ、エロい音。みんなに見られて興奮してるんだな。』" voices=""/>
		<msg @l="555" char_id="0" frame_id="1" name="美帆" text="(わたし‥‥感じてるの‥‥‥‥？)"
		   voices="miho07930"/>
		<msg @l="557" char_id="-1" frame_id="-1" name=""
		   text="異常な状況に反応してしまっているという恐怖が別の痺れる様な感覚を呼び覚まし、膝がガクガクと震える。" voices=""/>
		<msg @l="558" char_id="-1" frame_id="-1" name=""
		   text="外で裸になって、それを見られてあそこを濡らしているなんて‥‥。" voices=""/>
		<stopbgm @l="561" fadeout="1000"/>
		<wait_chgmv/>
		<bg @l="564" src="bg13"/>
		<msg @l="566" char_id="-1" frame_id="-1" name="女子会員Ｂ"
		   text="『仲根さん、はやくサーブをはじめてちょうだい！』" voices=""/>
		<msg @l="568" char_id="-1" frame_id="-1" name="" text="審判の声に、私は我に返った。"
		   voices=""/>
		<msg @l="569" char_id="-1" frame_id="-1" name=""
		   text="私の醜態を見かねて助け舟を出してくれたのだろうか。" voices=""/>
		<msg @l="570" char_id="-1" frame_id="-1" name=""
		   text="とにかく、勝とうが負けようがこのサーブさえ打てばこの異常な状況から開放されるのだ。" voices=""/>
		<msg @l="571" char_id="-1" frame_id="-1" name=""
		   text="私はボールを持ちなおすと、具合を確かめるようにぎゅっと握った。" voices=""/>
		<msg @l="573" char_id="0" frame_id="1" name="美帆" text="『‥‥‥‥。』"
		   voices="miho05400"/>
		<msg @l="575" char_id="0" frame_id="1" name="美帆"
		   text="(壁に向かって打ってるつもりでやろう‥‥)" voices="miho05410"/>
		<msg @l="577" char_id="0" frame_id="1" name="美帆" text="(そうすれば‥‥‥怖くない)"
		   voices="miho05420"/>
		<msg @l="579" char_id="-1" frame_id="-1" name=""
		   text="深呼吸をしながらそう自分に言い聞かせて、私はボールを軽く放る。" voices=""/>
		<msg @l="580" char_id="-1" frame_id="-1" name="" text="そして‥‥。" voices=""/>
		<bgm @l="583" src="bgm17" volume="1."/>
		<msg @l="585" char_id="0" frame_id="1" name="美帆" text="『はっ‥‥！』"
		   voices="miho05430"/>
		<se @l="588" buf="1" src="テニスボール打つ音" volume="1."/>
		<msg @l="590" char_id="-1" frame_id="-1" name="" text="ラケットがボールを弾く。"
		   voices=""/>
		<msg @l="591" char_id="-1" frame_id="-1" name=""
		   text="それは珍しく真っ直ぐに飛んで‥‥鈴木さんのコートの中へと落ちた。" voices=""/>
		<msg @l="592" char_id="-1" frame_id="-1" name=""
		   text="彼女は必死にボールの元へと駆け寄り、なんとかボールを打ち返そうとする。" voices=""/>
		<goto @l="595" cond="!(f.稲庭コーチflag&#32;==&#32;1)&#13;&#10;"
		   label="TempLabel_246"/>
		<goto @l="598" label="EventLabel_92"/>
		<goto @l="601" label="TempLabel_247"/>
		<label @l="602" id="TempLabel_246"/>
		<msg @l="607" async="true" char_id="-1" frame_id="-1" name=""
		   text="ボールを追う先は‥‥？" voices=""/>
		<select @l="608">
			<menu @l="612" label="EventLabel_92" text="右へ"/>
			<menu @l="615" label="EventLabel_95" text="左へ"/>
		</select>
		<label @l="623" id="TempLabel_247"/>
		<label @l="627" id="EventLabel_92"/>
		<msg @l="629" char_id="0" frame_id="1" name="美帆" text="(こっちね‥‥！)"
		   voices="miho05440"/>
		<msg @l="631" char_id="-1" frame_id="-1" name="" text="私は咄嗟に右に走った。"
		   voices=""/>
		<msg @l="633" char_id="-1" frame_id="-1" name="鈴木" text="『たあっ‥‥！』" voices=""/>
		<se @l="636" buf="1" src="テニスボール打つ音" volume="1."/>
		<msg @l="638" char_id="-1" frame_id="-1" name=""
		   text="十分な体勢で打てなかったからか、球威はあまりない。" voices=""/>
		<msg @l="639" char_id="-1" frame_id="-1" name=""
		   text="そして、丁度私の目の前にボールが落ちてきた。" voices=""/>
		<goto @l="642" cond="!(f.稲庭コーチflag&#32;==&#32;1)&#13;&#10;"
		   label="TempLabel_248"/>
		<msg @l="644" char_id="0" frame_id="1" name="美帆"
		   text="(昨日やったみたいに、ラケットの真芯で捉える―――)" voices="miho05450"/>
		<label @l="647" id="TempLabel_248"/>
		<msg @l="650" char_id="0" frame_id="1" name="美帆" text="『はっ‥‥！』"
		   voices="miho05460"/>
		<msg @l="652" char_id="-1" frame_id="-1" name=""
		   text="脇を締めて、ラケットを真っ直ぐに振りぬいた。" voices=""/>
		<se @l="655" buf="1" src="テニスボール打つ音" volume="1."/>
		<msg @l="657" char_id="-1" frame_id="-1" name=""
		   text="軽快な音と共にボールは鈴木さんのいるコートへと返された。" voices=""/>
		<msg @l="658" char_id="-1" frame_id="-1" name=""
		   text="打ち返した時点で力を使い果たしたのか彼女は身動きひとつ出来ない。" voices=""/>
		<msg @l="659" char_id="-1" frame_id="-1" name="" text="そして‥‥。" voices=""/>
		<se @l="662" buf="1" src="ホイッスル（テニス場）" volume="1."/>
		<stopbgm @l="665" fadeout="1000"/>
		<msg @l="667" char_id="-1" frame_id="-1" name="女子会員Ｂ" text="『ゲームウォンバイ、仲根。』"
		   voices=""/>
		<msg @l="669" char_id="-1" frame_id="-1" name="" text="審判の声が‥‥‥テニスコートに響いた。"
		   voices=""/>
		<msg @l="670" char_id="-1" frame_id="-1" name=""
		   text="私が渾身の力をこめたボールは、力を失いネットへとコロコロと転がっている。" voices=""/>
		<msg @l="671" char_id="0" frame_id="1" name="美帆" text="『え‥‥？』"
		   voices="miho05470"/>
		<msg @l="673" char_id="-1" frame_id="-1" name="" text="私には何が起きたのかよく解らなかった。"
		   voices=""/>
		<bgm @l="676" src="bgm05" volume="1."/>
		<msg @l="678" char_id="-1" frame_id="-1" name="女子会員Ｂ" text="『仲根さん、あなたの勝ちよ。』"
		   voices=""/>
		<msg @l="680" char_id="0" frame_id="1" name="美帆" text="『私の‥‥勝ち？』"
		   voices="miho05480"/>
		<msg @l="682" char_id="-1" frame_id="-1" name="女子会員Ｂ"
		   text="『そうよ、あなたが勝ったのよ。』" voices=""/>
		<msg @l="684" char_id="0" frame_id="1" name="美帆" text="『ほんとうに‥‥‥ですか？』"
		   voices="miho05490"/>
		<msg @l="686" char_id="-1" frame_id="-1" name="女子会員Ｂ" text="『ええ。』" voices=""/>
		<msg @l="688" char_id="-1" frame_id="-1" name=""
		   text="私は急いで脱いだまま放置されていたブラジャーとテニスウェアを身に着けた。" voices=""/>
		<msg @l="689" char_id="-1" frame_id="-1" name="女子会員Ａ"
		   text="『それでは以上を持ちまして、新入生歓迎会を終了します。』" voices=""/>
		<clear @l="692" class="all"/>
		<end_scene @l="695"/>
		<bgm @l="698" src="bgm02" volume="1."/>
		<msg @l="701" char_id="-1" frame_id="-1" name="女子会員Ａ"
		   text="『おめでとう、仲根さん。それじゃあ早速二次会の会場へ行きましょうか。』" voices=""/>
		<msg @l="703" char_id="-1" frame_id="-1" name=""
		   text="イベントが終了して一息ついていると、女子の先輩が声をかけてきた。" voices=""/>
		<msg @l="705" char_id="0" frame_id="1" name="美帆" text="『えっ、もうですか？』"
		   voices=""/>
		<msg @l="707" char_id="-1" frame_id="-1" name="女子会員Ａ"
		   text="『そうよ、会場の都合があるからもう行かなくちゃいけないの。試合で時間がかかりすぎちゃったから、結構押しちゃってるのよね。』"
		   voices=""/>
		<msg @l="709" char_id="0" frame_id="1" name="美帆" text="『すみません。』" voices=""/>
		<msg @l="711" char_id="-1" frame_id="-1" name="女子会員Ａ"
		   text="『気にしなくていいわよ。それより、ドレスとかは向こうで用意出来るから荷物だけ持って正門前に行っててちょうだい。車、出してあげる。』"
		   voices=""/>
		<msg @l="713" char_id="0" frame_id="1" name="美帆" text="『わかりました。‥‥あっ！』"
		   voices=""/>
		<msg @l="715" char_id="-1" frame_id="-1" name="女子会員Ａ" text="『どうしたの？』"
		   voices=""/>
		<msg @l="717" char_id="0" frame_id="1" name="美帆"
		   text="『あ、あの‥‥おトイレ行ってきていいですか？』" voices=""/>
		<msg @l="719" char_id="-1" frame_id="-1" name="女子会員Ａ" text="『‥‥‥‥早くね。』"
		   voices=""/>
		<stopbgm @l="723" fadeout="1000"/>
		<clear @l="726" class="all"/>
		<msg @l="728" char_id="-1" frame_id="-1" name="" text="･･････････。"
		   voices=""/>
		<se @l="731" buf="1" src="おしっこ" volume="1."/>
		<msg @l="733" char_id="-1" frame_id="-1" name="" text="ちょろちょろちょろ‥‥。"
		   voices=""/>
		<msg @l="735" char_id="-1" frame_id="-1" name="" text="私は一人残って用をたしていた。"
		   voices=""/>
		<msg @l="737" char_id="0" frame_id="1" name="美帆"
		   text="（ああ、私ってなんて間が悪いんだろう。あの人、絶対にあきれてるよね。）" voices=""/>
		<msg @l="739" char_id="-1" frame_id="-1" name=""
		   text="テニス勝負の後、緊張の糸がほどけたせいからか急に尿意をもよおしていた。" voices=""/>
		<msg @l="740" char_id="-1" frame_id="-1" name=""
		   text="我慢出来ない事も無かったが、車に乗っている途中でトイレに行きたくなる事を考えると、ここで済ませておいた方が良いと思ったのだ。"
		   voices=""/>
		<msg @l="742" char_id="0" frame_id="1" name="美帆"
		   text="（場所は聞いてあるし、あとからタクシーで行けばいいよね。）" voices=""/>
		<msg @l="744" char_id="-1" frame_id="-1" name="" text="そう考えているうちに、最後まで終わった。"
		   voices=""/>
		<msg @l="745" char_id="-1" frame_id="-1" name=""
		   text="ティッシュを秘部に当て、残った雫をふき取る。" voices=""/>
		<msg @l="747" char_id="-1" frame_id="-1" name="" text="くちゅっ。" voices=""/>
		<msg @l="749" char_id="0" frame_id="1" name="美帆" text="『んふっ。』" voices=""/>
		<msg @l="751" char_id="-1" frame_id="-1" name=""
		   text="ティッシュを離すと、秘唇との間に一筋の白い糸がかかる。" voices=""/>
		<msg @l="753" char_id="0" frame_id="1" name="美帆" text="（やっぱり、すごく濡れちゃってる。）"
		   voices=""/>
		<msg @l="755" char_id="0" frame_id="1" name="美帆"
		   text="（私、見られて感じちゃったのかな････。）" voices=""/>
		<clear @l="758" class="all"/>
		<msg @l="760" char_id="-1" frame_id="-1" name="" text="････････････････。"
		   voices=""/>
		<msg @l="761" char_id="-1" frame_id="-1" name="" text="････････。" voices=""/>
		<wait_chgmv/>
		<bg @l="764" src="bg07"/>
		<char @l="767" id="miho" pos="auto" src="miho020"/>
		<bgm @l="770" src="bgm02" volume="1."/>
		<msg @l="772" char_id="-1" frame_id="-1" name=""
		   text="用を足した後、結局遅刻には変わりないので私服に着替えてしまった。" voices=""/>
		<msg @l="774" char_id="0" frame_id="1" name="美帆"
		   text="（なんとなく行きづらいな‥‥、でもキャンセルしたらまずいよね。）" voices=""/>
		<msg @l="776" char_id="-1" frame_id="-1" name="声" text="『‥‥っ！！』" voices=""/>
		<msg @l="778" char_id="-1" frame_id="-1" name="" text="突然遠くから女の人の声が耳に入ってきた。"
		   voices=""/>
		<msg @l="780" char_id="0" frame_id="1" name="美帆"
		   text="（あれは‥‥玲さんの声だ。玲さん、来てたんだ。）" voices=""/>
		<msg @l="782" char_id="-1" frame_id="-1" name=""
		   text="どことなく孤独感を覚えていた私は急に玲さんに会いたくなり、声がする方へと歩き始めた。" voices=""/>
		<msg @l="783" char_id="-1" frame_id="-1" name=""
		   text="どうやら普段使っているテニスコートにいるらしい。" voices=""/>
		<clear @l="786" class="all"/>
		<bgm @l="789" src="bgm13" volume="1."/>
		<wait_chgmv/>
		<bg @l="792" src="bg13"/>
		<msg @l="794" char_id="0" frame_id="1" name="美帆" text="『玲さん‥‥ええっ！？』"
		   voices=""/>
		<char @l="797" id="miho" pos="auto" src="miho124"/>
		<msg @l="799" char_id="-1" frame_id="-1" name=""
		   text="私は目の前で行われている光景が理解できなかった。" voices=""/>
		<msg @l="800" char_id="-1" frame_id="-1" name="" text="玲さんが‥‥犯されている？"
		   voices=""/>
		<msg @l="801" char_id="-1" frame_id="-1" name=""
		   text="恐怖のあまり引き返そうとすると、目の前に見知った顔が現れた。" voices=""/>
		<clear @l="804" class="char"/>
		<char @l="807" id="inaba" pos="auto" src="inaba050"/>
		<msg @l="809" char_id="-1" frame_id="-1" name="稲庭" text="『仲根くん？』" voices=""/>
		<msg @l="811" char_id="0" frame_id="1" name="美帆"
		   text="『い、稲庭先輩、玲さんがっ！玲さんがっ！』" voices=""/>
		<stopbgm @l="814" fadeout="1000"/>
		<flash @l="817" count="4" fade="100" image="white"/>
		<se @l="819" buf="1" src="箱を蹴ってる" volume="1."/>
		<shake @l="821" amp="10" class="all" cycle="30" duration="500" type="random"/>
		<msg @l="823" char_id="-1" frame_id="-1" name="" text="ドゴッ！" voices=""/>
		<msg @l="825" char_id="0" frame_id="1" name="美帆" text="『うっ。』" voices=""/>
		<msg @l="827" char_id="-1" frame_id="-1" name=""
		   text="次の瞬間私は全身に強烈な衝撃を受け、気を失った。" voices=""/>
		<clear @l="830" class="char"/>
		<clear @l="833" class="all"/>
		<char @l="836" id="inaba" pos="auto" src="inaba058f"/>
		<msg @l="838" char_id="-1" frame_id="-1" name="稲庭" text="『‥‥‥‥。』" voices=""/>
		<msg @l="840" char_id="-1" frame_id="-1" name=""
		   text="まぶたが落ちる前に一瞬見えた先輩の顔は今まで見た事のない恐ろしい表情をしていた。" voices=""/>
		<clear @l="844" class="all"/>
		<msgshow @l="846" show="true"/>
		<wait_chgmv/>
		<bg @l="848" src="bg13"/>
		<bgm @l="851" src="bgm03" volume="1."/>
		<msg @l="853" char_id="0" frame_id="1" name="美帆" text="『ん‥‥。』" voices=""/>
		<msg @l="855" char_id="-1" frame_id="-1" name=""
		   text="ふと、大勢の人が騒いでいる声で目が醒めた。" voices=""/>
		<msg @l="856" char_id="-1" frame_id="-1" name=""
		   text="辺りを見渡すとそこはテニスコートで‥‥私は自分がどうしてここに居るのかを思い出そうとした。" voices=""/>
		<flash @l="859" count="4" fade="100" image="white"/>
		<msg @l="861" char_id="0" frame_id="1" name="美帆" text="(うあっ‥‥‥頭いたい‥‥‥‥‥‥)"
		   voices=""/>
		<msg @l="863" char_id="-1" frame_id="-1" name=""
		   text="記憶を思い返そうとすると、ひどい偏頭痛がした。" voices=""/>
		<msg @l="864" char_id="-1" frame_id="-1" name=""
		   text="こめかみの辺りが鼓動にあわせてズキズキと痛む。" voices=""/>
		<msg @l="866" char_id="-1" frame_id="-1" name="男子会員Ｂ"
		   text="『おい、なにトロトロやってんだよっ！&#32;ケケケ！！』" voices=""/>
		<msg @l="868" char_id="-1" frame_id="-1" name="男子会員Ｃ"
		   text="『クククク、早く終わらせちまえよなー。』" voices=""/>
		<msg @l="870" char_id="0" frame_id="1" name="美帆" text="(あ‥‥‥人の声‥‥‥‥‥なんだろ)"
		   voices=""/>
		<msg @l="872" char_id="-1" frame_id="-1" name=""
		   text="私は偏頭痛に耐えながら身体をゆっくりと起こす。" voices=""/>
		<msg @l="873" char_id="-1" frame_id="-1" name=""
		   text="テニスコートの一角に人だかりが出来ていた。" voices=""/>
		<msg @l="874" char_id="-1" frame_id="-1" name=""
		   text="ここから見えるのは男子部員と思しき人たちの背中ばかりで、その人だかりの中心がどうなっているかまではわからない。" voices=""/>
		<msg @l="876" char_id="0" frame_id="1" name="美帆" text="(立てる‥‥‥かな？)"
		   voices=""/>
		<msg @l="878" char_id="-1" frame_id="-1" name="" text="足に力を入れてみる。" voices=""/>
		<msg @l="879" char_id="-1" frame_id="-1" name=""
		   text="ふらつくけれど‥‥なんとか立つことが出来た。" voices=""/>
		<char @l="882" id="miho" pos="auto" src="miho016"/>
		<msg @l="884" char_id="0" frame_id="1" name="美帆" text="『あの‥‥何をしてるんですか？』"
		   voices=""/>
		<msg @l="886" char_id="-1" frame_id="-1" name="男子会員Ｄ"
		   text="『ん？&#32;ああ、もう一人が起きたみたいだぜ。クククク。』" voices=""/>
		<msg @l="888" char_id="-1" frame_id="-1" name="男子会員Ｅ"
		   text="『お、これで一気に捌ける量が増えるじゃん。ケケケケケ。』" voices=""/>
		<msg @l="889" char_id="-1" frame_id="-1" name="男子会員Ｆ"
		   text="『バーカ、手を出すなって言われてんだろ？』" voices=""/>
		<char @l="892" id="miho" pos="auto" src="miho116"/>
		<msg @l="894" char_id="0" frame_id="1" name="美帆" text="『え、あの‥‥‥何のお話ですか？』"
		   voices=""/>
		<msg @l="896" char_id="-1" frame_id="-1" name="男子会員Ｂ"
		   text="『へへ、気になるならアンタも一緒に見てろよ。クククク‥‥楽しいぜー。』" voices=""/>
		<char @l="899" id="miho" pos="auto" src="miho114"/>
		<msg @l="901" char_id="0" frame_id="1" name="美帆" text="『‥‥？』" voices=""/>
		<stopbgm @l="904" fadeout="1000"/>
		<clear @l="907" class="all"/>
		<label @l="910" id="event_scene15"/>
		<msg @l="912" char_id="-1" frame_id="-1" name=""
		   text="人だかりから男子部員の一人が場所をあけて、代わりに私を押し込めた。" voices=""/>
		<msg @l="915" char_id="0" frame_id="1" name="美帆" text="『な、なにを‥‥‥‥え！？』"
		   voices=""/>
		<label @l="918" id="chart_line53"/>
		<wait_chgmv/>
		<ev @l="920" src="ev-015_1"/>
		<description @l="922" text="悲しい勝利"/>
		<bgm @l="925" src="bgm14" volume="1."/>
		<msg @l="927" char_id="1" frame_id="-1" name="玲"
		   text="『んんぅっ‥‥んっ、んんっ‥‥‥ん‥‥‥‥‥ちゅぷっ‥‥‥‥。』" voices="rei00260"/>
		<msg @l="929" char_id="-1" frame_id="-1" name=""
		   text="人だかりの真ん中で‥‥玲さんが男の人のモノを咥えていた。" voices=""/>
		<msg @l="930" char_id="-1" frame_id="-1" name=""
		   text="硬く屹立した肉棒の先端を口内に含み、ちゅぷちゅぷと淫猥な水音を立てながらしゃぶっている。" voices=""/>
		<msg @l="932" char_id="0" frame_id="1" name="美帆" text="『せ、せんぱ‥‥‥‥んぐっ！？』"
		   voices="miho05140"/>
		<msg @l="934" char_id="-1" frame_id="-1" name=""
		   text="私が声をかけようとした瞬間、すぐ近くにいた男子部員の手が私の口を強引にふさいだ。" voices=""/>
		<msg @l="936" char_id="-1" frame_id="-1" name="男子会員Ｅ"
		   text="『やっと素直にしゃぶりはじめたんだから、余計な邪魔しないで黙って見てやがれよぉ、クカカカカ。』" voices=""/>
		<msg @l="938" char_id="-1" frame_id="-1" name="男子会員Ｄ"
		   text="『ケケケケそうそう‥‥アンタもクールで強気な彼女が殴られて強引にしゃぶらされるのを見るよりはいいだろ？』" voices=""/>
		<msg @l="940" char_id="0" frame_id="1" name="美帆" text="『‥‥‥‥。』"
		   voices="miho05150"/>
		<msg @l="942" char_id="-1" frame_id="-1" name=""
		   text="耳元へ囁きかけながら見せる狂気に、私は押し黙ってしまった。" voices=""/>
		<msg @l="944" char_id="1" frame_id="-1" name="玲"
		   text="『んぷっ‥‥んぅ、ちゅぷ‥‥‥‥んぷっ、んぷっ、んぷっ、んぷっ。』" voices="rei00270"/>
		<msg @l="946" char_id="-1" frame_id="-1" name="男子会員Ａ"
		   text="『おお、いいぜぇ‥‥‥結構上手いじゃねーかよぉー。』" voices=""/>
		<msg @l="948" char_id="1" frame_id="-1" name="玲"
		   text="『ん、んんっ‥‥‥んっ‥‥‥‥んぐ、ちゅぷ、ちゅぷ‥‥‥‥‥。』" voices="rei00280"/>
		<msg @l="950" char_id="-1" frame_id="-1" name=""
		   text="諦めか、それとも脅迫された結果か‥‥玲さんは渋々といった表情を浮かべながら、口内のそれをじゅぷじゅぷと音をたてて愛撫していた。"
		   voices=""/>
		<msg @l="952" char_id="1" frame_id="-1" name="玲"
		   text="『んんっ‥‥‥んう、んっ、んんっ‥‥‥‥‥ちゅぷ、ちゅるるっ。』" voices="rei00290"/>
		<msg @l="954" char_id="-1" frame_id="-1" name="男子会員Ａ"
		   text="『うひょー！&#32;すげ、いまの吸うヤツいい感じだな。』" voices=""/>
		<msg @l="956" char_id="-1" frame_id="-1" name=""
		   text="玲さんに咥えさせている男はそう言って腰を震わせた。" voices=""/>
		<msg @l="957" char_id="-1" frame_id="-1" name=""
		   text="‥‥吸うのをもっとしろ、ということらしい。" voices=""/>
		<msg @l="959" char_id="1" frame_id="-1" name="玲"
		   text="『ちゅぷ‥‥‥‥ん、んぐっ‥‥‥んっ‥‥‥‥‥ちゅぷ、ちゅぷぷっ。』" voices="rei00300"/>
		<msg @l="961" char_id="-1" frame_id="-1" name=""
		   text="けれど‥‥玲さんは男の意図がわかっていないらしく、吸い上げずに唇と舌を使ってぴちゃぴちゃと先端部分を舐めまわしていた。"
		   voices=""/>
		<msg @l="963" char_id="-1" frame_id="-1" name="男子会員Ａ"
		   text="『んだよ、吸えつってんだろーが。』" voices=""/>
		<msg @l="965" char_id="-1" frame_id="-1" name=""
		   text="男が腰を強く突き上げ、肉棒の先端で玲さんの喉を突いた。" voices=""/>
		<msg @l="967" char_id="1" frame_id="-1" name="玲"
		   text="『んぐっ‥‥‥んっ、んんんっ‥‥‥‥！！』" voices="rei00310"/>
		<msg @l="969" char_id="-1" frame_id="-1" name="男子会員Ａ"
		   text="『オマエがフェラチオでここにいる全員イカせりゃ終わるんだからよぉー、ケケケケ。』" voices=""/>
		<msg @l="971" char_id="-1" frame_id="-1" name="男子会員Ａ"
		   text="『一秒でも早く終わりたきゃ素直にしゃぶるんだなぁー。』" voices=""/>
		<msg @l="973" char_id="1" frame_id="-1" name="玲"
		   text="『あふっ‥‥ん、じゅぷ‥‥‥‥じゅ、ちゅるるるるっ‥‥‥‥‥。』" voices="rei00320"/>
		<msg @l="975" char_id="-1" frame_id="-1" name="男子会員Ａ"
		   text="『そうそう、そうやって素直にしてりゃ‥‥いいんだよークククク。』" voices=""/>
		<msg @l="977" char_id="0" frame_id="1" name="美帆" text="『なっ‥‥。』"
		   voices="miho05170"/>
		<msg @l="979" char_id="0" frame_id="1" name="美帆"
		   text="(ここにいる全員って‥‥‥一体、何人いると思ってるの！？)" voices="miho05180"/>
		<msg @l="981" char_id="-1" frame_id="-1" name="" text="ざっと見ただけで十人以上はいるだろうか。"
		   voices=""/>
		<msg @l="982" char_id="-1" frame_id="-1" name=""
		   text="彼ら全員のモノを口でするなんて‥‥酷すぎる。" voices=""/>
		<msg @l="984" char_id="0" frame_id="1" name="美帆" text="(黙って見てるしかないの‥‥‥‥？)"
		   voices="miho05190"/>
		<msg @l="986" char_id="-1" frame_id="-1" name=""
		   text="周りを見渡すが、テニス部の生徒ばかりで助けを求められそうな大人がいない。" voices=""/>
		<msg @l="987" char_id="0" frame_id="1" name="美帆" text="(‥‥稲庭先輩もいない‥‥‥‥)"
		   voices="miho05210"/>
		<msg @l="989" char_id="-1" frame_id="-1" name=""
		   text="ふいに気を失う直前に見た先輩の顔が脳裏に浮かぶ。" voices=""/>
		<msg @l="990" char_id="-1" frame_id="-1" name=""
		   text="あの時見たのは本当に稲庭先輩だったのか、混乱している頭では判断しきれなかった。" voices=""/>
		<msg @l="991" char_id="-1" frame_id="-1" name=""
		   text="それでも、今頼れるのは稲庭先輩しかいない。" voices=""/>
		<msg @l="992" char_id="-1" frame_id="-1" name=""
		   text="それに、玲さんをこのままにしておくわけにもいかない。" voices=""/>
		<msg @l="994" char_id="0" frame_id="1" name="美帆" text="(どうすれば‥‥‥いいの？)"
		   voices="miho05230"/>
		<msg @l="996" char_id="1" frame_id="-1" name="玲"
		   text="『んぷっ、んぷっ‥‥‥‥んぐ、ちゅぷ‥‥‥ン、ちゅぷぷぷっ。』" voices="rei00330"/>
		<msg @l="998" char_id="-1" frame_id="-1" name="男子会員Ａ"
		   text="『クククク‥‥いいぜぇ、だんだん良くなって来たぞぉ‥‥。』" voices=""/>
		<msg @l="1000" char_id="1" frame_id="-1" name="玲"
		   text="『ちゅむ‥‥‥ん、んんっ‥‥‥んぷっ‥‥ちゅぷ、ちゅぷ、ちゅぷっ。』" voices="rei00340"/>
		<msg @l="1002" char_id="-1" frame_id="-1" name="男子会員Ａ"
		   text="『さ、先っちょ吸ってくれっ！』" voices=""/>
		<msg @l="1004" char_id="1" frame_id="-1" name="玲"
		   text="『んんっ‥‥‥ちゅ、ちゅるる‥‥‥ちゅるるるるるるっ！』" voices="rei00350"/>
		<msg @l="1006" char_id="-1" frame_id="-1" name="男子会員Ａ" text="『うおおっ！』"
		   voices=""/>
		<flash @l="1009" count="4" fade="100" image="white"/>
		<wait_chgmv/>
		<ev @l="1011" src="ev-015_2"/>
		<msg @l="1013" char_id="1" frame_id="-1" name="玲" text="『んぶっっ！？』"
		   voices="rei00360"/>
		<msg @l="1015" char_id="-1" frame_id="-1" name=""
		   text="咥えさせていた男の人の腰が震え、玲さんが苦しげに目を閉じる。" voices=""/>
		<msg @l="1016" char_id="-1" frame_id="-1" name=""
		   text="男の人のを咥えている彼女の口端から、口の中に入りきらない精液が溢れ出した。" voices=""/>
		<wait_chgmv/>
		<ev @l="1019" src="ev-015_3"/>
		<msg @l="1021" char_id="-1" frame_id="-1" name="男子会員Ａ" text="『飲め！！』"
		   voices=""/>
		<msg @l="1023" char_id="1" frame_id="-1" name="玲" text="『んむぅぅぅ！？』"
		   voices="rei00370"/>
		<msg @l="1025" char_id="-1" frame_id="-1" name="男子会員Ａ"
		   text="『吐き出したらやり直しだからなぁー！』" voices=""/>
		<msg @l="1027" char_id="1" frame_id="-1" name="玲" text="『‥‥‥‥。』"
		   voices="rei00380"/>
		<msg @l="1029" char_id="1" frame_id="-1" name="玲"
		   text="『んっ‥‥んぐっ‥‥‥んくっ、んくっ‥‥‥‥んくっ‥‥‥‥‥。』" voices="rei00390"/>
		<msg @l="1031" char_id="-1" frame_id="-1" name=""
		   text="玲さんの喉が鳴り、口中の精液を飲み下していった。" voices=""/>
		<msg @l="1032" char_id="-1" frame_id="-1" name=""
		   text="余程量が多いのだろう‥‥何度も何度もコクッコクッという音をさせている。目尻には涙を浮かべながら。" voices=""/>
		<clear @l="1035" class="all"/>
		<msg @l="1037" char_id="-1" frame_id="-1" name="男子会員Ｂ"
		   text="『次、俺の番だかんなー。ケケケケケ。』" voices=""/>
		<msg @l="1039" char_id="-1" frame_id="-1" name=""
		   text="それまで咥えさせていた男が彼女の口からペニスを引き抜くと、すぐに次の男が玲さんの前に座って屹立した肉棒を彼女の口内に突きつけた。"
		   voices=""/>
		<msg @l="1041" char_id="1" frame_id="-1" name="玲" text="『んっ‥‥あ、んむぅ。』"
		   voices="rei00400"/>
		<msg @l="1043" char_id="-1" frame_id="-1" name=""
		   text="玲さんはわずかなためらいの後、挿入された男根に舌を絡ませていった。" voices=""/>
		<clear @l="1046" class="all"/>
		<msgshow @l="1048" show="true"/>
		<wait_chgmv/>
		<ev @l="1051" src="ev-015_2"/>
		<msg @l="1053" char_id="-1" frame_id="-1" name="男子会員Ｂ"
		   text="『ちゃんと唇締めていやらしい音をたてながらしごいてくれよー。ヒヒヒヒ。』" voices=""/>
		<msg @l="1055" char_id="1" frame_id="-1" name="玲"
		   text="『ん、ちゅぷ‥‥‥んっ、んんっ‥‥‥じゅぱ‥‥‥ぴちゅ‥‥。』" voices="rei00410"/>
		<msg @l="1057" char_id="-1" frame_id="-1" name=""
		   text="男の指示に従って、玲さんはきゅっと唇をすぼめて頭を前後に振る。" voices=""/>
		<msg @l="1058" char_id="-1" frame_id="-1" name=""
		   text="まだ充分に唾液がまぶされていない所為か、ソレが行き来するたびに彼女の唇が肉にくっつくように大きく引っぱられている。"
		   voices=""/>
		<msg @l="1060" char_id="1" frame_id="-1" name="玲"
		   text="『んぅ‥‥んっ、ちゅぷ‥‥‥んぐ、んっ、んんっ‥‥‥‥。』" voices="rei00420"/>
		<msg @l="1062" char_id="-1" frame_id="-1" name="男子会員Ｂ"
		   text="『もっと、口の中に唾液溜めてお前のオマ○コみたいにびちょびちょにしろよー。ヒヒヒヒヒヒ‥‥。』" voices=""/>
		<msg @l="1064" char_id="1" frame_id="-1" name="玲" text="『んっ‥‥。』"
		   voices="rei00430"/>
		<msg @l="1066" char_id="-1" frame_id="-1" name=""
		   text="男の指示で、彼女は口を動かすのを止めた。" voices=""/>
		<msg @l="1067" char_id="-1" frame_id="-1" name=""
		   text="くやしさの為か目尻に涙を浮かべながらも、男根をくわえたまま口内に唾液を溜め、ソレにたっぷりとまぶし、また頭を前後に振りはじめる。"
		   voices=""/>
		<msg @l="1069" char_id="1" frame_id="-1" name="玲"
		   text="『んっ‥‥んんっ‥‥ちゅぷっ‥‥ちゅぷぷっ‥‥‥‥ん、んぅぅっ。』" voices="rei00440"/>
		<msg @l="1071" char_id="-1" frame_id="-1" name=""
		   text="先ほどまでよりも、もっといやらしい、じゅぷじゅぷという水音を立てながら、玲さんは唇と舌で男のモノをしごいていく。" voices=""/>
		<msg @l="1072" char_id="-1" frame_id="-1" name=""
		   text="口の端からは先ほど出された精液と唾液が混じったものが溢れ出し、彼女の太ももへと零れ落ちていった。" voices=""/>
		<msg @l="1074" char_id="-1" frame_id="-1" name="男子会員Ｂ"
		   text="『そうそう‥‥ヘヘヘ‥‥うはぁ、いいぜー。』" voices=""/>
		<msg @l="1076" char_id="-1" frame_id="-1" name="男子会員Ｂ"
		   text="『その、裏筋のところ重点的に‥‥‥うおお！』" voices=""/>
		<msg @l="1078" char_id="-1" frame_id="-1" name=""
		   text="舌が男根の裏側を舐め上げ、カリを舌先で刺激すると男が気持ちよさそうな声を漏らす。玲さんはまるで人形のように‥‥‥命令されるままに肉棒をしゃぶっていた。"
		   voices=""/>
		<msg @l="1080" char_id="1" frame_id="-1" name="玲"
		   text="『ちゅぷちゅぷちゅぷ‥‥‥んっ、ちゅむっ‥‥‥‥‥んふぅっ。』" voices="rei00450"/>
		<msg @l="1082" char_id="1" frame_id="-1" name="玲"
		   text="『ちゅ、ちゅぷっ‥‥‥んぐっ、んっ、んっ、んんっ‥‥‥‥ちゅるる。』" voices="rei00460"/>
		<wait_chgmv/>
		<ev @l="1085" src="ev-015_4"/>
		<msg @l="1087" char_id="-1" frame_id="-1" name="男子会員Ｃ"
		   text="『あああ‥‥まだかよぉー、早くしろよぉー。』" voices=""/>
		<msg @l="1089" char_id="-1" frame_id="-1" name=""
		   text="横から、順番待ちをしている男が自分の肉棒をしごきながら急かしだした。" voices=""/>
		<msg @l="1090" char_id="-1" frame_id="-1" name=""
		   text="既に鈴口からは先走り汁が出ており、ビクビクと脈を打っていた。" voices=""/>
		<msg @l="1092" char_id="-1" frame_id="-1" name="男子会員Ｂ"
		   text="『ヒヒヒヒヒ、もう少し待てって‥‥‥今いいとこなんだからよぉー。』" voices=""/>
		<msg @l="1094" char_id="-1" frame_id="-1" name=""
		   text="そう言うと、咥えさせている男は玲さんの頭をつかみ、激しく前後に動かした。" voices=""/>
		<msg @l="1096" char_id="1" frame_id="-1" name="玲"
		   text="『ちゅぷ‥‥ちゅ、んぐっ‥‥‥んっ、んっ、んんっ‥‥‥‥‥。』" voices="rei00470"/>
		<msg @l="1098" char_id="-1" frame_id="-1" name="男子会員Ｃ"
		   text="『はぁ‥‥はぁ‥‥はぁ‥‥‥。』" voices=""/>
		<msg @l="1100" char_id="-1" frame_id="-1" name="男子会員Ｃ"
		   text="『も、もう我慢出来ねぇよぉー‥‥‥顔にかけてやるう！』" voices=""/>
		<msg @l="1102" char_id="-1" frame_id="-1" name="男子会員Ｂ" text="『あ、おい‥‥！』"
		   voices=""/>
		<flash @l="1105" count="4" fade="100" image="white"/>
		<wait_chgmv/>
		<ev @l="1108" src="ev-015_5"/>
		<msg @l="1110" char_id="1" frame_id="-1" name="玲" text="『んんぅ！？』"
		   voices="rei00480"/>
		<msg @l="1112" char_id="-1" frame_id="-1" name=""
		   text="横から、玲さんの顔に白濁色をした液体が大量にぶちまけられ、彼女の綺麗な顔をドロドロに汚していく。" voices=""/>
		<msg @l="1114" char_id="-1" frame_id="-1" name="男子会員Ｂ"
		   text="『あーあ、ドロドロじゃねーかよ。』" voices=""/>
		<msg @l="1116" char_id="-1" frame_id="-1" name="男子会員Ｃ"
		   text="『ヒヒヒヒヒ、いーだろー、こいつの綺麗な顔、前々からドロドロにしてやりたかったんだよぉー。』" voices=""/>
		<msg @l="1118" char_id="-1" frame_id="-1" name="男子会員Ｂ"
		   text="『俺が出してからにしろってんだよぉー。折角、あの美人で有名な白石の、端正な顔を見ながらフェラってもらってたのに、テメエの汚ねぇ精液で見えねぇじゃなえかっ！！』"
		   voices=""/>
		<msg @l="1120" char_id="-1" frame_id="-1" name="男子会員Ｃ"
		   text="『ヒヒヒヒヒ、まぁまぁ。俺は顔射が好きなんだよ。他のやつらもこいつの顔に掛けちゃおうぜ。』" voices=""/>
		<msg @l="1122" char_id="-1" frame_id="-1" name="男子会員Ｄ"
		   text="『お、俺もっ‥‥もーすぐ出るぞ‥‥‥‥あ、ああああ！』" voices=""/>
		<flash @l="1125" count="4" fade="100" image="white"/>
		<wait_chgmv/>
		<ev @l="1128" src="ev-015_6"/>
		<msg @l="1130" char_id="1" frame_id="-1" name="玲" text="『んんっ‥‥む、ちゅぷ‥‥‥‥。』"
		   voices="rei00490"/>
		<msg @l="1132" char_id="-1" frame_id="-1" name=""
		   text="男達は、頭を振ってイヤイヤしている玲さんに対し、その熱い飛沫を解き放った。" voices=""/>
		<msg @l="1134" char_id="-1" frame_id="-1" name="男子会員Ｂ"
		   text="『お？‥これはこれでエロいな‥‥ククククク‥‥。』" voices=""/>
		<msg @l="1136" char_id="-1" frame_id="-1" name="男子会員Ｃ"
		   text="『だろ？精液パックってやつだ。ヒヒヒヒヒ。』" voices=""/>
		<msg @l="1138" char_id="-1" frame_id="-1" name="男子会員Ｂ"
		   text="『よかったなーおい！&#32;顔中から精液をしみこませてもらえるんだからよぉー！！』" voices=""/>
		<msg @l="1140" char_id="-1" frame_id="-1" name=""
		   text="そう言ってくわえさせている男は、白濁で汚れた彼女の顔を眺めながら、喉奥を突き上げるように腰を動かした。" voices=""/>
		<msg @l="1142" char_id="-1" frame_id="-1" name="男子会員Ｂ"
		   text="『よーし、そのまま口全体を使ってろよぉー！！』" voices=""/>
		<msg @l="1144" char_id="1" frame_id="-1" name="玲"
		   text="『んっ、んんっ！&#32;‥‥んぐっ、ちゅぷっ、ちゅぷっ、ちゅぷぷっ‥‥。』" voices="rei00500"/>
		<msg @l="1146" char_id="-1" frame_id="-1" name=""
		   text="彼女の口内を蹂躙するように、男が激しく腰を振る。" voices=""/>
		<msg @l="1147" char_id="-1" frame_id="-1" name="" text="玲さんは、それを必死で受け止めていた。"
		   voices=""/>
		<msg @l="1149" char_id="-1" frame_id="-1" name="男子会員Ｂ"
		   text="『く、ああっ‥‥イクぜ、ちゃんと飲めよっ！！』" voices=""/>
		<msg @l="1151" char_id="1" frame_id="-1" name="玲"
		   text="『んんっ、ちゅぷ、ちゅぷっ‥‥‥んっ‥‥んんっ、じゅ、ちゅるるっ！』" voices="rei00510"/>
		<msg @l="1153" char_id="-1" frame_id="-1" name="男子会員Ｂ" text="『くぅぅっ！』"
		   voices=""/>
		<flash @l="1156" count="4" fade="100" image="white"/>
		<wait_chgmv/>
		<ev @l="1159" src="ev-015_7"/>
		<msg @l="1161" char_id="1" frame_id="-1" name="玲"
		   text="『んんっ‥‥んっ‥‥‥んぐっ‥‥んく、んくっ‥‥‥‥‥んくっ。』" voices="rei00520"/>
		<msg @l="1163" char_id="-1" frame_id="-1" name=""
		   text="いきなりのことに驚きながらも、口内にはきだされた精液を飲み下していく。" voices=""/>
		<msg @l="1165" char_id="1" frame_id="-1" name="玲"
		   text="『んっ‥‥‥‥んくっ‥‥んくっ‥‥‥んくっ‥‥‥‥‥ん、んふぅ。』" voices="rei00540"/>
		<msg @l="1167" char_id="-1" frame_id="-1" name="男子会員Ｂ"
		   text="『う、うわ‥‥‥吸い取られるっ‥‥‥‥‥。』" voices=""/>
		<msg @l="1169" char_id="-1" frame_id="-1" name=""
		   text="口内で射精が終わった後も、彼女は肉棒に吸い付いているようだった。" voices=""/>
		<msg @l="1171" char_id="0" frame_id="1" name="美帆" text="『‥‥‥‥。』"
		   voices="miho05240"/>
		<stopbgm @l="1174" fadeout="1000"/>
		<clear @l="1177" class="all"/>
		<wait_chgmv/>
		<bg @l="1180" src="bg13"/>
		<bgm @l="1183" src="bgm03" volume="1."/>
		<msg @l="1185" char_id="-1" frame_id="-1" name="" text="もう‥‥見ていられなかった。"
		   voices=""/>
		<msg @l="1186" char_id="-1" frame_id="-1" name=""
		   text="その後も、男たちは欲望の限りを玲さんにぶつけている。" voices=""/>
		<msg @l="1187" char_id="-1" frame_id="-1" name=""
		   text="彼女はそれでも黙々と男たちに従い‥‥奉仕を続けていた。" voices=""/>
		<end_scene @l="1190"/>
		<char @l="1193" id="miho" pos="auto" src="miho015"/>
		<msg @l="1195" char_id="0" frame_id="1" name="美帆"
		   text="(こんなのおかしい‥‥‥間違ってるよ‥‥‥‥‥)" voices=""/>
		<se @l="1198" buf="1" src="テニスコートをしきるフェンスの扉" volume="1."/>
		<msg @l="1200" char_id="-1" frame_id="-1" name="男子会員Ａ" text="『あっ、会長！』"
		   voices=""/>
		<msg @l="1202" char_id="-1" frame_id="-1" name="" text="私はとっさにコートの出入り口を見た。"
		   voices=""/>
		<msg @l="1203" char_id="-1" frame_id="-1" name="" text="稲庭先輩だ。" voices=""/>
		<clear @l="1206" class="char"/>
		<char @l="1208" id="miho" pos="right" src="miho115"/>
		<char @l="1210" id="inaba" pos="left" src="inaba050"/>
		<msg @l="1212" char_id="0" frame_id="1" name="美帆" text="『せ、先輩！』" voices=""/>
		<msg @l="1214" char_id="-1" frame_id="-1" name=""
		   text="他の部員達を強引に押しのけ、稲庭先輩の前に駆け寄る。" voices=""/>
		<msg @l="1215" char_id="-1" frame_id="-1" name="" text="先輩は私の肩を優しく掴む。"
		   voices=""/>
		<msg @l="1217" char_id="-1" frame_id="-1" name="稲庭" text="『落ち着いて、仲根くん。』"
		   voices=""/>
		<msg @l="1219" char_id="-1" frame_id="-1" name=""
		   text="目の前に立っていたのは紛れも無く、いつもの稲庭先輩だった。" voices=""/>
		<char @l="1222" id="miho" pos="right" src="miho015"/>
		<msg @l="1224" char_id="0" frame_id="1" name="美帆"
		   text="『れ、玲さん‥‥白石先輩が、みんなにひどいことをされてっ、そ、それからっ。』" voices=""/>
		<clear @l="1227" class="char"/>
		<char @l="1229" id="inaba" pos="auto" src="inaba050"/>
		<msg @l="1231" char_id="-1" frame_id="-1" name="稲庭" text="『玲‥‥。』" voices=""/>
		<msg @l="1233" char_id="1" frame_id="-1" name="玲"
		   text="『ごほっ‥‥い、稲庭さん、これは一体‥‥。』" voices=""/>
		<msg @l="1235" char_id="-1" frame_id="-1" name=""
		   text="玲さんが口から精液を吐き出しながらよろよろと立ち上がる。" voices=""/>
		<msg @l="1237" char_id="-1" frame_id="-1" name="稲庭"
		   text="『玲、まさかこんな事になるなんて。』" voices=""/>
		<msg @l="1239" char_id="1" frame_id="-1" name="玲" text="『稲庭さん‥‥。』" voices=""/>
		<stopbgm @l="1243" fadeout="1000"/>
		<char @l="1246" id="inaba" pos="auto" src="inaba058"/>
		<msg @l="1248" char_id="-1" frame_id="-1" name="稲庭"
		   text="『余計な事に首を突っ込まなければこんな目に合わずに済んだのにな。』" voices=""/>
		<msg @l="1251" char_id="-1" frame_id="-1" name=""
		   text="一瞬稲庭先輩の目が怪しく光り、凶悪な表情に変わる。" voices=""/>
		<msg @l="1252" char_id="-1" frame_id="-1" name=""
		   text="それは‥‥さっき見たものと全く同じだった。" voices=""/>
		<bgm @l="1256" src="bgm13" volume="1."/>
		<flash @l="1259" count="4" fade="100" image="white"/>
		<se @l="1261" buf="1" src="箱を蹴ってる" volume="1."/>
		<shake @l="1263" amp="10" class="all" cycle="30" duration="500"
		   type="random"/>
		<msg @l="1265" char_id="-1" frame_id="-1" name="" text="ドゴッ！" voices=""/>
		<msg @l="1267" char_id="1" frame_id="-1" name="玲" text="『おええぇっ！』" voices=""/>
		<msg @l="1269" char_id="-1" frame_id="-1" name=""
		   text="稲庭先輩の蹴りが玲さんの鳩尾辺りに入り、はじき飛ばされた玲さんは胃液と精液を吐き出しながら地面に転がる。" voices=""/>
		<clear @l="1272" class="char"/>
		<char @l="1274" id="miho" pos="right" src="miho115"/>
		<char @l="1276" id="inaba" pos="left" src="inaba058"/>
		<msg @l="1278" char_id="0" frame_id="1" name="美帆"
		   text="『れ、玲さんっ！？稲庭先輩、何をするんですか！』" voices=""/>
		<msg @l="1280" char_id="-1" frame_id="-1" name="稲庭"
		   text="『玲くんがいけないんだよ！裏のサークル活動を見てしまった君が！』" voices=""/>
		<char @l="1283" id="miho" pos="right" src="miho015"/>
		<msg @l="1285" char_id="0" frame_id="1" name="美帆"
		   text="『そ、それって一体どういう事なんですか？』" voices=""/>
		<msg @l="1287" char_id="-1" frame_id="-1" name="声" text="『おやおや、これはいけませんねぇ。』"
		   voices=""/>
		<msg @l="1289" char_id="-1" frame_id="-1" name="稲庭" text="『熊野‥‥さん。』"
		   voices=""/>
		<clear @l="1292" class="char"/>
		<char @l="1294" id="kuma" pos="auto" src="kuma012"/>
		<msg @l="1296" char_id="-1" frame_id="-1" name=""
		   text="私が驚いて後を見ると、用務員さん‥‥熊野さんというらしい‥‥が立っていた。" voices=""/>
		<clear @l="1298" class="char"/>
		<char @l="1300" id="kuma" pos="right" src="kuma012"/>
		<char @l="1302" id="inaba" pos="left" src="inaba057"/>
		<msg @l="1304" char_id="-1" frame_id="-1" name=""
		   text="熊野さんは錠剤数個を稲庭先輩に手渡し、先輩はそれを一気に飲み込む。" voices=""/>
		<msg @l="1305" char_id="-1" frame_id="-1" name=""
		   text="しばらくするとさっきまで息の荒かった先輩がすっかり落ち着きを取り戻し、気がつけばいつもの表情に戻っていた。" voices=""/>
		<stopbgm @l="1308" fadeout="1000"/>
		<clear @l="1311" class="char"/>
		<char @l="1313" id="inaba" pos="auto" src="inaba050"/>
		<msg @l="1315" char_id="0" frame_id="1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<bgm @l="1318" src="bgm16" volume="1."/>
		<msg @l="1320" char_id="-1" frame_id="-1" name="稲庭"
		   text="『いつかはバレる日がくるかもしれないとは思っていたが‥‥、仲根くんが玲のルームメイトだという事を忘れていた僕のミスだ。』"
		   voices=""/>
		<clear @l="1323" class="char"/>
		<char @l="1325" id="inaba" pos="left" src="inaba050"/>
		<char @l="1327" id="miho" pos="right" src="miho115"/>
		<msg @l="1329" char_id="0" frame_id="1" name="美帆"
		   text="『裏のサークル活動って何なんですか稲庭先輩。』" voices=""/>
		<msg @l="1331" char_id="-1" frame_id="-1" name="稲庭" text="『話せば長くなる‥‥。』"
		   voices=""/>
		<msg @l="1333" char_id="0" frame_id="1" name="美帆" text="『構いません！』" voices=""/>
		<char @l="1336" id="kuma" pos="left" src="kuma012"/>
		<msg @l="1338" char_id="-1" frame_id="-1" name="熊野"
		   text="『立ったままというのもなんですから、そこに座ってショーでも見ながらお話したらどうでしょうか。』" voices=""/>
		<char @l="1341" id="miho" pos="right" src="miho015"/>
		<msg @l="1343" char_id="0" frame_id="1" name="美帆" text="『ショー？』" voices=""/>
		<char @l="1346" id="inaba" pos="left" src="inaba050"/>
		<msg @l="1348" char_id="-1" frame_id="-1" name="稲庭" text="『そうだな、そうしよう。』"
		   voices=""/>
		<clear @l="1351" class="char"/>
		<wait @l="1353" time="600"/>
		<msg @l="1355" char_id="-1" frame_id="-1" name=""
		   text="そう言って稲庭が合図をすると、会員達が部室棟から裸の女の子達を連れてきた。" voices=""/>
		<msg @l="1357" char_id="-1" frame_id="-1" name="男子会員Ａ"
		   text="『会長、はじめちゃっていいスか？』" voices=""/>
		<msg @l="1359" char_id="-1" frame_id="-1" name=""
		   text="よく見ると、つれてこられた子達は全員脱衣テニスで負けた子達だった。" voices=""/>
		<msg @l="1360" char_id="-1" frame_id="-1" name=""
		   text="その中には当然、私と対戦した鈴木さんの姿もあった。" voices=""/>
		<msg @l="1361" char_id="-1" frame_id="-1" name=""
		   text="気絶している鈴木さんの太腿は、血の筋がうっすらとついている。" voices=""/>
		<msg @l="1363" char_id="-1" frame_id="-1" name="男子会員Ｂ"
		   text="『ククク、会長、どうでしたか彼女らのお味は？』" voices=""/>
		<char @l="1366" id="inaba" pos="auto" src="inaba050"/>
		<msg @l="1368" char_id="-1" frame_id="-1" name="稲庭"
		   text="『どうもこうも、バージンが三人しかいないんじゃ話にならないな。』" voices=""/>
		<msg @l="1370" char_id="-1" frame_id="-1" name="男子会員Ｃ" text="『なげかわしい事です。』"
		   voices=""/>
		<msg @l="1372" char_id="-1" frame_id="-1" name="稲庭"
		   text="『これがゆとり教育の弊害ってやつさ。』" voices=""/>
		<msg @l="1374" char_id="-1" frame_id="-1" name="男子会員Ｄ"
		   text="『さすが会長、学がありますねぇ。』" voices=""/>
		<msg @l="1376" char_id="-1" frame_id="-1" name=""
		   text="そう言いながら、男子達は地面にうずくまっている女子達の周りを囲み始める。" voices=""/>
		<msg @l="1377" char_id="-1" frame_id="-1" name="男子会員Ｅ"
		   text="『おめぇらは敗者だからな、俺達の肉ラケットで罰を与えてやる。』" voices=""/>
		<msg @l="1379" char_id="-1" frame_id="-1" name=""
		   text="先輩は私を後ろから抱きかかえたままベンチに腰をおろし、一緒にその様子を見るように促した。" voices=""/>
		<clear @l="1382" class="char"/>
		<char @l="1385" id="inaba" pos="left" src="inaba050"/>
		<char @l="1387" id="miho" pos="right" src="miho115"/>
		<msg @l="1389" char_id="0" frame_id="1" name="美帆" text="『やめてくださいっ！』"
		   voices=""/>
		<msg @l="1391" char_id="-1" frame_id="-1" name=""
		   text="稲庭先輩は、目をそむけようとした私のあごを掴み無理やり女の子達の方へ向けさせる。" voices=""/>
		<msg @l="1392" char_id="-1" frame_id="-1" name=""
		   text="抵抗したら首を折られるのではと思うくらいの力でがっしりと固定された私は、抵抗する気力が無くなりかけていた。" voices=""/>
		<stopbgm @l="1395" fadeout="1000"/>
		<msg @l="1397" char_id="-1" frame_id="-1" name="稲庭"
		   text="『僕が子供の頃、体が弱かったというのは以前話したよね。』" voices=""/>
		<char @l="1400" id="miho" pos="right" src="miho114"/>
		<bgm @l="1403" src="bgm09" volume="1."/>
		<msg @l="1405" char_id="0" frame_id="1" name="美帆" text="『は、はい‥‥。』" voices=""/>
		<msg @l="1407" char_id="-1" frame_id="-1" name=""
		   text="予想外の出だしに、私は一瞬呆気に取られる。" voices=""/>
		<msg @l="1408" char_id="-1" frame_id="-1" name="" text="この人は何を話す気なのだろう。"
		   voices=""/>
		<msg @l="1410" char_id="-1" frame_id="-1" name="稲庭"
		   text="『そこで静養をかねてこの町‥‥当時は村だったかな‥‥にあったウチの別荘にやって来たんだけど、回復する見込みは全くと言っていい程無かった。』"
		   voices=""/>
		<msg @l="1412" char_id="-1" frame_id="-1" name="稲庭"
		   text="『そんなある日、この町にあった大黒製薬の研究所からある新薬の被験者にならないかという話があったんだ。』" voices=""/>
		<clear @l="1415" class="all"/>
		<msg @l="1417" char_id="-1" frame_id="-1" name="" text="大黒製薬の事はよく知っている。"
		   voices=""/>
		<msg @l="1418" char_id="-1" frame_id="-1" name=""
		   text="大企業だからという事もあるが、父の勤め先だからというのが一番の理由だ。" voices=""/>
		<msg @l="1419" char_id="-1" frame_id="-1" name=""
		   text="父も研究所勤務だが、この町に研究所があったなんて話は聞いたことが無い。" voices=""/>
		<msg @l="1420" char_id="-1" frame_id="-1" name="" text="引越しの時にも何も言われなかった。"
		   voices=""/>
		<wait_chgmv/>
		<bg @l="1424" src="bg13"/>
		<char @l="1427" id="inaba" pos="left" src="inaba050"/>
		<char @l="1429" id="miho" pos="right" src="miho115"/>
		<msg @l="1432" char_id="-1" frame_id="-1" name="稲庭"
		   text="『藁にもすがりたかった両親はこの話に飛びつき、その結果、僕の体は奇跡的に回復した。』" voices=""/>
		<msg @l="1434" char_id="-1" frame_id="-1" name="稲庭"
		   text="『ただ、その薬には副作用があった。ひとつは服用を続けなければならない事、もう一つは‥‥自分の感情のコントロールが利きにくくなる事、特に性欲のね。』"
		   voices=""/>
		<char @l="1437" id="miho" pos="right" src="miho015"/>
		<msg @l="1439" char_id="0" frame_id="1" name="美帆" text="『それでこんな事を‥‥。』"
		   voices=""/>
		<msg @l="1441" char_id="-1" frame_id="-1" name="稲庭"
		   text="『感情のコントロールは訓練できても、性欲を抑えるのは困難だった。だが、レイプサークルなら女の供給は簡単に出来るし、セックスしまくっても誰も疑問に思わない。』"
		   voices=""/>
		<msg @l="1443" char_id="0" frame_id="1" name="美帆" text="『そ、そんな事のために‥‥。』"
		   voices=""/>
		<char @l="1446" id="kuma" pos="right" src="kuma012"/>
		<msg @l="1448" char_id="-1" frame_id="-1" name="熊野"
		   text="『もちろんそれだけではございませんよ。』" voices=""/>
		<msg @l="1450" char_id="-1" frame_id="-1" name="" text="突然、熊野さんが口を挟んできた。"
		   voices=""/>
		<msg @l="1452" char_id="-1" frame_id="-1" name="稲庭"
		   text="『熊野さんは僕が被験者になった時に研究所にいた担当の人でね、今もこうやって薬を提供してくれているんだ。』" voices=""/>
		<msg @l="1454" char_id="-1" frame_id="-1" name="" text="このひとが‥‥？" voices=""/>
		<msg @l="1455" char_id="-1" frame_id="-1" name=""
		   text="でも、なんでそんな人が大学で用務員なんてしているんだろう。" voices=""/>
		<msg @l="1457" char_id="-1" frame_id="-1" name="熊野"
		   text="『あなた‥‥製薬会社がいまだに実現出来ていない薬ってなんだかわかりますか？』" voices=""/>
		<clear @l="1460" class="char"/>
		<char @l="1463" id="kuma" pos="left" src="kuma012"/>
		<char @l="1465" id="miho" pos="right" src="miho115"/>
		<msg @l="1467" char_id="0" frame_id="1" name="美帆" text="『えっ？ガンの特効薬とか‥‥。』"
		   voices=""/>
		<msg @l="1469" char_id="-1" frame_id="-1" name="熊野"
		   text="『絶対検査にひっかからないドーピング剤と安全確実な勃起薬です。これらを他社に先駆けて実現出来れば巨万の富を生む事は確実。その為に稲庭さんに手伝ってもらってるのですよ。』"
		   voices=""/>
		<char @l="1472" id="miho" pos="right" src="miho114"/>
		<msg @l="1474" char_id="0" frame_id="1" name="美帆" text="『それと稲庭先輩がどういう‥‥はっ！』"
		   voices=""/>
		<msg @l="1476" char_id="-1" frame_id="-1" name="熊野"
		   text="『そうです、稲庭さんは両方の条件を持った数少ない成功例なのです。』" voices=""/>
		<char @l="1479" id="inaba" pos="left" src="inaba050"/>
		<msg @l="1481" char_id="-1" frame_id="-1" name="稲庭"
		   text="『ただ、完全なものにするにはたくさんのデータがいる。そこで、テニスサークルをレイプサークルに作り変え、改変された薬を部員達に精力剤だ、ドラッグだと言って服用させた。』"
		   voices=""/>
		<msg @l="1483" char_id="-1" frame_id="-1" name="稲庭" text="『結果は‥‥今、見てのとおりだ。』"
		   voices=""/>
		<msg @l="1485" char_id="-1" frame_id="-1" name=""
		   text="まわりを見渡すと男子達が一心不乱に女子を犯していた。" voices=""/>
		<msg @l="1486" char_id="-1" frame_id="-1" name=""
		   text="何回射精しても萎える事もなく、いつ果てるとも知れぬレイプショーが目の前で繰り広げられていた。" voices=""/>
		<char @l="1489" id="miho" pos="right" src="miho015"/>
		<msg @l="1491" char_id="0" frame_id="1" name="美帆"
		   text="『あぁ‥‥。じゃ、じゃあ、玲さんはどうなんですか？玲さんは今日始めてこの事を知りました。なぜなんです？稲庭先輩は玲さんの事が好きだから‥‥だから手も出さずに今までいたんじゃないんですか？』"
		   voices=""/>
		<msg @l="1493" char_id="-1" frame_id="-1" name="" text="私は必死に稲庭先輩に問いかける。"
		   voices=""/>
		<msg @l="1494" char_id="-1" frame_id="-1" name=""
		   text="これだけのレイプサークルで、玲さんのような美人が毒牙にかからないわけがない。" voices=""/>
		<msg @l="1495" char_id="-1" frame_id="-1" name=""
		   text="先輩はベンチから立ち上がり、玲さんに近づいていく。" voices=""/>
		<clear @l="1498" class="char"/>
		<char @l="1500" id="inaba" pos="left" src="inaba050"/>
		<char @l="1502" id="rei" pos="right" src="rei055"/>
		<msg @l="1504" char_id="1" frame_id="-1" name="玲" text="『稲庭さん‥‥。』" voices=""/>
		<msg @l="1506" char_id="-1" frame_id="-1" name="稲庭"
		   text="『確かに‥‥玲は大学入学時から美人で目立った存在だった。しかし、彼女のように正義感の強い女性を仲間に引き込むのはリスクが大きい。結局、教師受けが良く同性に信用のある彼女は表のテニス部の広告塔にしか使えなかったのさ。』"
		   voices=""/>
		<char @l="1509" id="miho" pos="left" src="miho015"/>
		<msg @l="1511" char_id="0" frame_id="1" name="美帆" text="『そ、そんな‥‥そんな事って。』"
		   voices=""/>
		<char @l="1514" id="inaba" pos="right" src="inaba050"/>
		<msg @l="1516" char_id="-1" frame_id="-1" name="稲庭"
		   text="『それにね、僕は処女の子宮でしか満足出来ない‥‥つまり、玲のような穢れた女には興味がないんだ。』" voices=""/>
		<msg @l="1518" char_id="1" frame_id="-1" name="玲" text="『‥‥っ！？』" voices=""/>
		<msg @l="1520" char_id="-1" frame_id="-1" name="" text="玲さんが思わず下を向く。"
		   voices=""/>
		<msg @l="1521" char_id="-1" frame_id="-1" name=""
		   text="髪の毛で表情はわからないが、地面に涙の雫が滴り落ちている。" voices=""/>
		<clear @l="1524" class="char"/>
		<msg @l="1526" char_id="-1" frame_id="-1" name="男子会員Ｅ"
		   text="『会長、そろそろ向かわないと二次会が‥‥。』" voices=""/>
		<msg @l="1528" char_id="-1" frame_id="-1" name=""
		   text="突然、男子の一人がやってきて稲庭先輩に耳打ちする。" voices=""/>
		<clear @l="1531" class="char"/>
		<char @l="1533" id="inaba" pos="center" src="inaba050f" y="-80"/>
		<msg @l="1535" char_id="-1" frame_id="-1" name="稲庭" text="『おいおい、察しろよ副会長。』"
		   voices=""/>
		<msg @l="1537" char_id="-1" frame_id="-1" name=""
		   text="先輩は小指を立てたまま右腕を前に突き出し、副会長の方をジロッと見る。" voices=""/>
		<msg @l="1538" char_id="-1" frame_id="-1" name="" text="表情は笑顔だが、目は全く笑っていない。"
		   voices=""/>
		<msg @l="1540" char_id="-1" frame_id="-1" name="男子会員Ｅ"
		   text="『‥‥しっ、失礼しましたっ！』" voices=""/>
		<msg @l="1542" char_id="-1" frame_id="-1" name=""
		   text="副会長は先輩と私の両方に目を配ると、何かを察したように走り去って行った。" voices=""/>
		<clear @l="1544" class="char"/>
		<char @l="1546" id="inaba" pos="auto" src="inaba050"/>
		<msg @l="1548" char_id="-1" frame_id="-1" name="稲庭"
		   text="『今の僕にとっては二次会より目の前にいる君の方が大事だからね。』" voices=""/>
		<clear @l="1551" class="char"/>
		<char @l="1553" id="inaba" pos="left" src="inaba050"/>
		<char @l="1555" id="miho" pos="right" src="miho114"/>
		<msg @l="1557" char_id="0" frame_id="1" name="美帆" text="『えっ？』" voices=""/>
		<msg @l="1559" char_id="0" frame_id="1" name="美帆" text="（そ、それってどういう‥‥事？）"
		   voices=""/>
		<stopbgm @l="1562" fadeout="1000"/>
		<msg @l="1564" char_id="-1" frame_id="-1" name="稲庭"
		   text="『僕の欲望はね‥‥君のような極上の処女肉を喰らわないと満足出来ないんだよ、仲根美帆くん。』" voices=""/>
		<msg @l="1566" char_id="0" frame_id="1" name="美帆" text="『ええっ！？』" voices=""/>
		<bgm @l="1569" src="bgm08" volume="1."/>
		<msg @l="1571" char_id="-1" frame_id="-1" name="" text="私は声が出なかった。"
		   voices=""/>
		<msg @l="1572" char_id="-1" frame_id="-1" name=""
		   text="なんで、どうしてこの人は私が処女だって事を知ってるんだろう。" voices=""/>
		<msg @l="1574" char_id="-1" frame_id="-1" name="稲庭"
		   text="『不思議そうだね‥‥何百人と処女を散らしてきた僕には、処女かどうか見分ける事なんて簡単な事なのさ。』" voices=""/>
		<msg @l="1576" char_id="-1" frame_id="-1" name="稲庭"
		   text="『あの時、朽木教授に痴漢されている姿を目撃した日から、君の躰を狙っていた。それが、今日やっとかなう‥‥。』" voices=""/>
		<char @l="1579" id="miho" pos="right" src="miho115"/>
		<msg @l="1581" char_id="0" frame_id="1" name="美帆"
		   text="『そんな、思い通りになんてさせません。』" voices=""/>
		<msg @l="1583" char_id="-1" frame_id="-1" name="稲庭"
		   text="『そうか、なら代わりに玲にしてもらうしかないな。』" voices=""/>
		<msg @l="1585" char_id="0" frame_id="1" name="美帆"
		   text="『でも、処女じゃないと満足出来ないんじゃ‥‥。』" voices=""/>
		<clear @l="1588" class="char"/>
		<char @l="1590" id="inaba" pos="center" src="inaba050f" y="-80"/>
		<msg @l="1592" char_id="-1" frame_id="-1" name="稲庭"
		   text="『確かに。だから僕は‥‥玲の喉のバージンを貰う事にしたよ。』" voices=""/>
		<msg @l="1594" char_id="-1" frame_id="-1" name=""
		   text="先輩はうずくまっていた玲さんの首をつかんで持ち上げ、喉の奥に自らの肉棒を強引に押し込んだ。" voices=""/>
		<wait_chgmv/>
		<ev @l="1597" src="ev-015_1"/>
		<msg @l="1599" char_id="1" frame_id="-1" name="玲" text="『んぐっ！？‥‥んんんーっ！！』"
		   voices=""/>
		<bgm @l="1602" src="bgm14" volume="1."/>
		<msg @l="1604" char_id="-1" frame_id="-1" name="稲庭"
		   text="『もっとたくさん空気を取り込むように喉の奥を広げるんだっ！』" voices=""/>
		<msg @l="1606" char_id="1" frame_id="-1" name="玲" text="『んごっ！あがっ、おごおぉっ！』"
		   voices=""/>
		<msg @l="1608" char_id="-1" frame_id="-1" name="稲庭"
		   text="『おおっ‥‥これが玲の喉の奥の感触か！処女の膣肉の次に最高だ！』" voices=""/>
		<msg @l="1610" char_id="0" frame_id="1" name="美帆" text="『や、やめてーっ！』"
		   voices=""/>
		<msg @l="1612" char_id="-1" frame_id="-1" name=""
		   text="私は必死に叫ぶが、稲庭先輩は全くこちらに目もくれず、玲さんの喉を犯している。" voices=""/>
		<msg @l="1614" char_id="1" frame_id="-1" name="玲" text="『おあっ！がっ、あぁっ！』"
		   voices=""/>
		<msg @l="1616" char_id="-1" frame_id="-1" name="稲庭"
		   text="『そうだ、声を出すたびにお前のノドチ○コが僕のチ○コの先をぴたぴた叩いて気持ちいいぞ！』" voices=""/>
		<msg @l="1618" char_id="-1" frame_id="-1" name=""
		   text="玲さんに全くお構いなしで先輩は容赦なく喉の感触を楽しんでいる。" voices=""/>
		<msg @l="1619" char_id="-1" frame_id="-1" name=""
		   text="全く想像した事もなかった異常な性行為を目の当たりにし、私の足はがくがくと震えていた。" voices=""/>
		<stopbgm @l="1622" fadeout="1000"/>
		<clear @l="1625" class="all"/>
		<end_scene @l="1628"/>
		<wait_chgmv/>
		<bg @l="1631" src="bg13"/>
		<bgm @l="1634" src="bgm03" volume="1."/>
		<char @l="1638" id="miho" pos="auto" src="miho115"/>
		<msg @l="1641" char_id="0" frame_id="1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="1643" char_id="-1" frame_id="-1" name="" text="どうしたらいいの‥‥。"
		   voices=""/>
		<msg @l="1644" char_id="-1" frame_id="-1" name=""
		   text="このままじゃ‥‥このままじゃ玲さんが死んでしまう！" voices=""/>
		<goto @l="1647" cond="!(f.稲庭コーチflag&#32;==&#32;1)&#13;&#10;"
		   label="TempLabel_249"/>
		<msg @l="1651" async="true" char_id="-1" frame_id="-1" name=""
		   text="玲さんを助ける‥‥？" voices=""/>
		<select @l="1652">
			<menu @l="1656" label="EventLabel_93" text="助ける"/>
			<menu @l="1659" label="EventLabel_94" text="助けない"/>
		</select>
		<goto @l="1667" label="TempLabel_250"/>
		<label @l="1668" id="TempLabel_249"/>
		<goto @l="1674" label="EventLabel_94"/>
		<label @l="1677" id="TempLabel_250"/>
		<label @l="1681" id="EventLabel_93"/>
		<stopbgm @l="1686" fadeout="1000"/>
		<char @l="1689" id="miho" pos="auto" src="miho015"/>
		<msg @l="1691" char_id="0" frame_id="1" name="美帆" text="『私が‥‥玲さんの代わりになります。』"
		   voices=""/>
		<msg @l="1693" char_id="-1" frame_id="-1" name="稲庭" text="『何？』" voices=""/>
		<bgm @l="1697" src="bgm07" volume="1."/>
		<msg @l="1699" char_id="1" frame_id="-1" name="玲" text="『ごほっ！美帆‥‥？』"
		   voices=""/>
		<msg @l="1701" char_id="0" frame_id="1" name="美帆"
		   text="『私が玲さんの代わりにあなたの相手をします。だから、これ以上非道い事をしないでください！』" voices=""/>
		<stopbgm @l="1704" fadeout="1000"/>
		<clear @l="1707" class="char"/>
		<char @l="1709" id="inaba" pos="center" src="inaba050f" y="-80"/>
		<msg @l="1711" char_id="-1" frame_id="-1" name="稲庭" text="『その言葉を待っていたよ。』"
		   voices=""/>
		<msg @l="1713" char_id="-1" frame_id="-1" name=""
		   text="熱心に玲さんの喉を犯していた稲庭先輩が突然首だけをこちらに向ける。" voices=""/>
		<clear @l="1716" class="char"/>
		<char @l="1718" id="miho" pos="auto" src="miho015"/>
		<msg @l="1720" char_id="0" frame_id="1" name="美帆" text="『ど、どういう事ですか。』"
		   voices=""/>
		<bgm @l="1723" src="bgm09" volume="1."/>
		<msg @l="1725" char_id="-1" frame_id="-1" name="稲庭"
		   text="『僕は女性を無理やり犯すような真似は嫌いでね。君から言い出してくれるのを待っていたんだよ。』" voices=""/>
		<char @l="1728" id="miho" pos="auto" src="miho115"/>
		<msg @l="1730" char_id="0" frame_id="1" name="美帆"
		   text="『そんなっ‥‥よくそんな事をぬけぬけと。』" voices=""/>
		<msg @l="1732" char_id="-1" frame_id="-1" name="稲庭"
		   text="『ああ、玲の事を言ってるのかい？彼女は僕に抱かれてもいいとまで言ったんだよ、つまり無理やりじゃないという事さ。』" voices=""/>
		<msg @l="1734" char_id="1" frame_id="-1" name="玲" text="『んんーっ！』" voices=""/>
		<msg @l="1736" char_id="-1" frame_id="-1" name=""
		   text="稲庭先輩が玲さんの頭をつかみ、前後に激しく動かす。" voices=""/>
		<msg @l="1737" char_id="-1" frame_id="-1" name=""
		   text="肉棒の先端が喉の奥にごつごつと当たり、玲さんは苦しげにうめいた。" voices=""/>
		<msg @l="1739" char_id="0" frame_id="1" name="美帆" text="『やめてっ！』" voices=""/>
		<msg @l="1741" char_id="-1" frame_id="-1" name="稲庭"
		   text="『それはつまり、君は僕の事が好きで、僕に犯されたい‥‥そういう事でいいんだね？』" voices=""/>
		<msg @l="1743" char_id="-1" frame_id="-1" name=""
		   text="確かに以前は、稲庭先輩の事は好きだったと思う。" voices=""/>
		<msg @l="1744" char_id="-1" frame_id="-1" name=""
		   text="しかし今、目の前にいるのは稲庭先輩の顔をした悪魔なのだ。" voices=""/>
		<msg @l="1745" char_id="-1" frame_id="-1" name=""
		   text="そんな男に自ら望んで犯されなければならない屈辱に、私は一瞬顔をそむけた。" voices=""/>
		<msg @l="1746" char_id="-1" frame_id="-1" name="稲庭" text="『ちがうのかい？』"
		   voices=""/>
		<msg @l="1748" char_id="-1" frame_id="-1" name=""
		   text="そう優しく語りかけながら、稲庭先輩は玲さんの鼻の穴を塞ぐ。" voices=""/>
		<msg @l="1749" char_id="-1" frame_id="-1" name=""
		   text="口と鼻の両方をふさがれ、玲さんは体中を震わせて痙攣した。" voices=""/>
		<msg @l="1750" char_id="-1" frame_id="-1" name=""
		   text="しかし、男の力に勝てるわけは無く、もがけばもがくほど体中から酸素が無くなっていく。" voices=""/>
		<msg @l="1752" char_id="-1" frame_id="-1" name="稲庭"
		   text="『ああ‥‥いいよ玲、息が出来なくて口の中全体が張り付いてくる感触がたまらない。』" voices=""/>
		<char @l="1755" id="miho" pos="auto" src="miho015"/>
		<msg @l="1757" char_id="0" frame_id="1" name="美帆"
		   text="『やめてっ！やめてください！犯されたいです！あなたに犯されたいです！』" voices=""/>
		<msg @l="1759" char_id="-1" frame_id="-1" name=""
		   text="稲庭先輩は玲の鼻の穴を開放し、玲さんは鼻の穴と目の端から涙を流しながらげほげほと深呼吸をする。" voices=""/>
		<clear @l="1762" class="char"/>
		<char @l="1764" id="inaba" pos="center" src="inaba050f" y="-80"/>
		<msg @l="1766" char_id="-1" frame_id="-1" name="稲庭" text="『つまり、僕に処女を捧げたいと？』"
		   voices=""/>
		<clear @l="1769" class="char"/>
		<char @l="1771" id="miho" pos="auto" src="miho015"/>
		<msg @l="1773" char_id="0" frame_id="1" name="美帆" text="『は、はい‥‥捧げます。』"
		   voices=""/>
		<clear @l="1776" class="char"/>
		<char @l="1778" id="inaba" pos="center" src="inaba050f" y="-80"/>
		<msg @l="1780" char_id="-1" frame_id="-1" name="稲庭"
		   text="『僕のモノで処女膜をブチ抜かれたいと？』" voices=""/>
		<clear @l="1783" class="char"/>
		<char @l="1785" id="miho" pos="auto" src="miho015"/>
		<msg @l="1787" char_id="0" frame_id="1" name="美帆"
		   text="『‥‥はい、私の処女膜を‥‥破って‥‥ください。』" voices=""/>
		<msg @l="1789" char_id="1" frame_id="-1" name="玲" text="『美帆、バカな事言わないで！美帆っ！』"
		   voices=""/>
		<char @l="1792" id="miho" pos="auto" src="miho115"/>
		<stopbgm @l="1795" fadeout="1000"/>
		<msg @l="1797" char_id="0" frame_id="1" name="美帆" text="『玲さん‥‥。』" voices=""/>
		<bgm @l="1800" src="bgm07" volume="1."/>
		<msg @l="1802" char_id="0" frame_id="1" name="美帆"
		   text="『玲さん‥‥妹の話してくれましたよね。私も、玲さんの事が、だんだん本当のお姉さんみたいに思えてきて、だからこういう時には助けなくちゃって思って‥‥。』"
		   voices=""/>
		<char @l="1805" id="miho" pos="auto" src="miho116"/>
		<msg @l="1807" char_id="0" frame_id="1" name="美帆" text="『私なら‥‥大丈夫だから。』"
		   voices=""/>
		<msg @l="1809" char_id="-1" frame_id="-1" name=""
		   text="私はそう言って玲さんに微笑んで見せたが、おそらく上手く笑えなかったと思う‥‥。" voices=""/>
		<msg @l="1811" char_id="1" frame_id="-1" name="玲" text="『美帆‥‥。』" voices=""/>
		<stopbgm @l="1814" fadeout="1000"/>
		<clear @l="1817" class="char"/>
		<msg @l="1819" char_id="-1" frame_id="-1" name="稲庭" text="『玲、君はもう用なしだ。』"
		   voices=""/>
		<bgm @l="1822" src="bgm13" volume="1."/>
		<msg @l="1824" char_id="-1" frame_id="-1" name=""
		   text="そう言うと稲庭先輩は玲さんを乱暴に引き剥がすと、私のほうへ向かって歩いてきた。" voices=""/>
		<msg @l="1825" char_id="-1" frame_id="-1" name=""
		   text="先輩が錠剤を何錠もまとめてボリボリと噛み砕くと、さっき以上に全身の筋肉が隆起し、股間の盛り上がりが更に力を増した。"
		   voices=""/>
		<char @l="1828" id="inaba" pos="center" src="inaba058f" y="-80"/>
		<msg @l="1830" char_id="-1" frame_id="-1" name="稲庭"
		   text="『あはははは！仲根くん、非処女の口ま○こで汚れてしまった僕のモノのを君の処女ま○こで清めてくれ！』" voices=""/>
		<clear @l="1833" class="char"/>
		<char @l="1835" id="miho" pos="auto" src="miho015"/>
		<msg @l="1837" char_id="0" frame_id="1" name="美帆" text="『ひ、ひいっ！』" voices=""/>
		<clear @l="1840" class="char"/>
		<msg @l="1842" char_id="-1" frame_id="-1" name=""
		   text="覚悟を決めたとはいえ、狂気に歪んだ先輩の瞳を直視した私は全身の力が抜け、その場にへたりこんだ。" voices=""/>
		<char @l="1845" id="inaba" pos="center" src="inaba058f" y="-80"/>
		<msg @l="1847" char_id="-1" frame_id="-1" name="稲庭"
		   text="『いいっ！その表情！その仕草！その肉体！僕の求めていたものが今、目の前にあるんだ！』" voices=""/>
		<msg @l="1849" char_id="-1" frame_id="-1" name="稲庭" text="『あははははははっ！』"
		   voices=""/>
		<stopbgm @l="1852" fadeout="1000"/>
		<clear @l="1855" class="all"/>
		<wait_chgmv/>
		<bg @l="1859" src="bg13"/>
		<flash @l="1864" count="4" fade="100" image="white"/>
		<se @l="1866" buf="1" src="刃物刺す音1" volume="1."/>
		<shake @l="1868" amp="10" class="all" cycle="30" duration="100"
		   type="random"/>
		<msg @l="1870" char_id="-1" frame_id="-1" name="稲庭" text="『な‥‥‥に？』"
		   voices=""/>
		<wait_chgmv/>
		<bg @l="1874" src="bg13"/>
		<bgm @l="1879" src="bgm15" volume="1."/>
		<msg @l="1881" char_id="-1" frame_id="-1" name=""
		   text="ちょうど稲庭先輩が背後を向けたその瞬間、不意をついた一撃がそのわき腹へと突き刺ささっていた。それは木を切る時に使う大きなはさみで、ほぼ柄の近くまで先輩の体を貫いている。"
		   voices=""/>
		<char @l="1884" id="miho" pos="auto" src="miho015"/>
		<msg @l="1886" char_id="0" frame_id="1" name="美帆" text="『玲さんっ！？』" voices=""/>
		<msg @l="1888" char_id="1" frame_id="-1" name="玲" text="『早く逃げて！』" voices=""/>
		<clear @l="1891" class="char"/>
		<msg @l="1893" char_id="-1" frame_id="-1" name=""
		   text="私は玲さんの一喝に後押しされるように、その場から駆け出す。" voices=""/>
		<msg @l="1894" char_id="-1" frame_id="-1" name=""
		   text="コートを仕切るフェンスの扉をくぐって外へと急いだ。" voices=""/>
		<msg @l="1895" char_id="-1" frame_id="-1" name=""
		   text="振り返ると稲庭先輩の脇からはドクドクと心臓の動きに合わせて血が噴き出している。" voices=""/>
		<msg @l="1896" char_id="-1" frame_id="-1" name=""
		   text="おそらく助からないと思われる程の傷だった‥‥。" voices=""/>
		<char @l="1899" id="kuma" pos="auto" src="kuma017"/>
		<msg @l="1901" char_id="-1" frame_id="-1" name="熊野"
		   text="『こっ、このアマぁ！よくも大切な実験体を！！』" voices=""/>
		<flash @l="1904" count="4" fade="100" image="white"/>
		<shake @l="1906" amp="10" class="all" cycle="30" duration="100"
		   type="random"/>
		<se @l="1908" buf="1" src="ムチの音" volume="1."/>
		<msg @l="1910" char_id="-1" frame_id="-1" name="" text="バシッ！！" voices=""/>
		<flash @l="1913" count="4" fade="100" image="white"/>
		<msg @l="1915" char_id="1" frame_id="-1" name="玲" text="『ぐふっ！？』" voices=""/>
		<msg @l="1917" char_id="-1" frame_id="-1" name=""
		   text="熊野が逆上し顔をなぎ払うようにはたくと、玲さんは崩れるように倒れこんだ。" voices=""/>
		<char @l="1919" id="miho" pos="auto" src="miho115"/>
		<msg @l="1921" char_id="0" frame_id="1" name="美帆" text="『玲さーん！！』" voices=""/>
		<char @l="1924" id="rei" pos="auto" src="rei055"/>
		<msg @l="1926" char_id="1" frame_id="-1" name="玲" text="『‥‥‥‥。』" voices=""/>
		<char @l="1929" id="miho" pos="auto" src="miho114"/>
		<msg @l="1931" char_id="0" frame_id="1" name="美帆" text="『玲さんっ！！』" voices=""/>
		<char @l="1934" id="rei" pos="auto" src="rei055"/>
		<stopbgm @l="1937" fadeout="1000"/>
		<msg @l="1939" char_id="1" frame_id="-1" name="玲" text="『美帆‥‥ごめんね。』"
		   voices=""/>
		<char @l="1942" id="miho" pos="auto" src="miho015"/>
		<msg @l="1944" char_id="0" frame_id="1" name="美帆" text="『玲‥さん‥‥？』" voices=""/>
		<bgm @l="1947" src="bgm18" volume="1."/>
		<msg @l="1949" char_id="1" frame_id="-1" name="玲"
		   text="『彼の事が好きだったから‥‥大事な事が何も見えてなかった。』" voices=""/>
		<msg @l="1951" char_id="1" frame_id="-1" name="玲" text="『巻き込んじゃって‥‥ごめんね。』"
		   voices=""/>
		<char @l="1954" id="miho" pos="auto" src="miho115"/>
		<msg @l="1956" char_id="0" frame_id="1" name="美帆" text="『玲さん‥‥ううっ、玲さん。』"
		   voices=""/>
		<char @l="1959" id="rei" pos="auto" src="rei057"/>
		<shake @l="1961" amp="10" class="all" cycle="30" duration="100"
		   type="random"/>
		<msg @l="1963" char_id="1" frame_id="-1" name="玲" text="『走りなさい！！美帆！！！』"
		   voices=""/>
		<msg @l="1965" char_id="-1" frame_id="-1" name=""
		   text="私は玲さんの一喝に、出口へと走りだした。" voices=""/>
		<wait @l="1968" time="600"/>
		<char @l="1970" id="miho" pos="auto" src="miho014"/>
		<msg @l="1972" char_id="0" frame_id="1" name="美帆" text="『玲さんっ！？』" voices=""/>
		<clear @l="1975" class="all"/>
		<se @l="1977" buf="1" src="部室のドア閉まる" volume="1."/>
		<msg @l="1979" char_id="-1" frame_id="-1" name="" text="私が、音に気付き振り返ると―――。"
		   voices=""/>
		<se @l="1982" buf="1" src="鍵を掛ける音" volume="1."/>
		<msg @l="1984" char_id="-1" frame_id="-1" name=""
		   text="玲さんが扉についている南京錠で鍵をし、鍵を投げ捨てる。" voices=""/>
		<msg @l="1986" char_id="1" frame_id="-1" name="玲"
		   text="『ここは私が食い止めるから‥‥‥アナタは逃げなさい。』" voices=""/>
		<msg @l="1988" char_id="0" frame_id="1" name="美帆"
		   text="『玲さん、ダメ‥‥そんなのダメですよっ！！』" voices=""/>
		<msg @l="1990" char_id="1" frame_id="-1" name="玲" text="『早く逃げなさいっ！！』"
		   voices=""/>
		<msg @l="1992" char_id="0" frame_id="1" name="美帆" text="『でもっ！！！』" voices=""/>
		<msg @l="1994" char_id="1" frame_id="-1" name="玲" text="『美帆─────。』"
		   voices=""/>
		<msg @l="1996" char_id="1" frame_id="-1" name="玲"
		   text="『私を姉のようだと思うなら‥‥言う事を聞いて。』" voices=""/>
		<msg @l="1998" char_id="1" frame_id="-1" name="玲"
		   text="『お姉ちゃんからの、最後の‥‥‥‥お願いよ。』" voices=""/>
		<msg @l="2000" char_id="1" frame_id="-1" name="玲"
		   text="『行きなさい‥‥そして必ず、逃げ延びて‥‥。』" voices=""/>
		<stopbgm @l="2003" fadeout="1000"/>
		<msg @l="2005" char_id="1" frame_id="-1" name="玲" text="『かわいい私の妹‥‥美帆。』"
		   voices=""/>
		<msg @l="2007" char_id="0" frame_id="1" name="美帆" text="『くっ‥‥。』" voices=""/>
		<msg @l="2009" char_id="-1" frame_id="-1" name="" text="私は‥‥思いっきり駆け出していた。"
		   voices=""/>
		<msg @l="2010" char_id="-1" frame_id="-1" name="" text="何処をどう走ったかなんて覚えていない。"
		   voices=""/>
		<msg @l="2011" char_id="-1" frame_id="-1" name=""
		   text="とにかく少しでも早く‥‥遠くに逃げようと、懸命に走った。" voices=""/>
		<msg @l="2012" char_id="-1" frame_id="-1" name="" text="それが‥‥玲さんの願いだから。"
		   voices=""/>
		<msg @l="2014" char_id="0" frame_id="1" name="美帆"
		   text="(こんな‥‥‥こんなのって‥‥‥‥‥‥‥‥玲さんっ！！)" voices=""/>
		<call @l="2018" target="EventLabel_146@root_tureend01"/>
		<return @l="2019" value="0&#13;&#10;"/>
		<label @l="2023" id="EventLabel_94"/>
		<char @l="2027" id="miho" pos="auto" src="miho015"/>
		<msg @l="2029" char_id="0" frame_id="1" name="美帆"
		   text="(どうすればいいの‥‥どうすれば‥‥‥‥。)" voices=""/>
		<clear @l="2032" class="char"/>
		<msg @l="2034" char_id="-1" frame_id="-1" name=""
		   text="私は‥‥すっかり怯えた目で玲さんと稲庭先輩の行為を見ていた。" voices=""/>
		<msg @l="2035" char_id="-1" frame_id="-1" name=""
		   text="射精し終わると、先輩はこっちへと向かってきた。" voices=""/>
		<msg @l="2036" char_id="-1" frame_id="-1" name=""
		   text="その目は‥‥怪しい光を放ったままだった。" voices=""/>
		<char @l="2039" id="inaba" pos="left" src="inaba050"/>
		<msg @l="2041" char_id="-1" frame_id="-1" name="稲庭"
		   text="『さぁ、仲根くん！まずはテニスウェアに着がえてもらおうか。』" voices=""/>
		<msg @l="2043" char_id="-1" frame_id="-1" name=""
		   text="稲庭先輩はそう言うと、テニスウェアを投げて渡してきた。" voices=""/>
		<char @l="2046" id="miho" pos="right" src="miho015"/>
		<msg @l="2048" char_id="0" frame_id="1" name="美帆" text="『え！？どういうことですか！？』"
		   voices=""/>
		<msg @l="2050" char_id="-1" frame_id="-1" name="稲庭"
		   text="『拒んでもいいんだよ。玲がもっと酷い目にあっても良いのならね。』" voices=""/>
		<msg @l="2052" char_id="0" frame_id="1" name="美帆"
		   text="『こ、これ以上何をするつもりなんですか！？』" voices=""/>
		<msg @l="2055" char_id="-1" frame_id="-1" name="稲庭"
		   text="『さぁねぇー。処女でない女は、僕にとっては必要のない“廃棄物”だから････。どうなるかは気分次第かな。』" voices=""/>
		<msg @l="2057" char_id="-1" frame_id="-1" name=""
		   text="稲庭先輩はそう言いながら残虐そうな笑みを浮かべていた。" voices=""/>
		<char @l="2060" id="miho" pos="right" src="miho115"/>
		<msg @l="2062" char_id="0" frame_id="1" name="美帆" text="『そ、そんな････』"
		   voices=""/>
		<msg @l="2064" char_id="-1" frame_id="-1" name="稲庭"
		   text="『どうする？着る？それとも････。』" voices=""/>
		<msg @l="2066" char_id="0" frame_id="1" name="美帆" text="『････っ･･････。』"
		   voices=""/>
		<msg @l="2068" char_id="0" frame_id="1" name="美帆"
		   text="（このままでは玲さんが殺されちゃうかもしれない････何とか時間をかせがないと････。）" voices=""/>
		<char @l="2071" id="miho" pos="right" src="miho015"/>
		<msg @l="2073" char_id="0" frame_id="1" name="美帆"
		   text="『な、なんでテニスウェアなんですか！？』" voices=""/>
		<msg @l="2075" char_id="-1" frame_id="-1" name="稲庭"
		   text="『決まっているだろう。僕は処女のテニスウェア姿が好きなのさ。』" voices=""/>
		<msg @l="2076" char_id="-1" frame_id="-1" name="稲庭"
		   text="『僕はその為に、わざわざテニスサークルを作ったんだからね････。だから仲根くんにも僕に犯される時はテニスウェアを着ていてほしいんだよ。』"
		   voices=""/>
		<msg @l="2078" char_id="-1" frame_id="-1" name=""
		   text="稲庭先輩はそう言うと舌なめずりをしながら私に近づいてきた。" voices=""/>
		<char @l="2081" id="miho" pos="right" src="miho115"/>
		<msg @l="2083" char_id="0" frame_id="1" name="美帆"
		   text="（駄目････これ以上引き伸ばせない････。もう着替えるしか････。）" voices=""/>
		<msg @l="2085" char_id="0" frame_id="1" name="美帆" text="『わ････わかりました。』"
		   voices=""/>
		<msg @l="2087" char_id="-1" frame_id="-1" name="稲庭"
		   text="『ふふ、仲根くんはいい子だねー。さぁ、早く着替えるんだ。』" voices=""/>
		<msg @l="2089" char_id="0" frame_id="1" name="美帆" text="『･･････････。』"
		   voices=""/>
		<msg @l="2091" char_id="-1" frame_id="-1" name="" text="稲庭先輩は私の言葉に嬉しそうに笑う。"
		   voices=""/>
		<msg @l="2092" char_id="-1" frame_id="-1" name=""
		   text="とにかく私はゆっくり着替え、その間に誰かがコートの側を通って助けてくれる事に僅かな望みを託したのだった。" voices=""/>
		<clear @l="2095" class="char"/>
		<clear @l="2101" class="all"/>
		<wait_chgmv/>
		<bg @l="2104" src="bg13"/>
		<char @l="2107" id="miho" pos="right" src="miho055"/>
		<msg @l="2109" char_id="0" frame_id="1" name="美帆" text="『き････着替え終わりました。』"
		   voices=""/>
		<msg @l="2111" char_id="-1" frame_id="-1" name=""
		   text="ゆっくりと着替えたが結局は誰もコートのそばを通る事はなく、僅かな希望もなくなってしまったのだった。" voices=""/>
		<msg @l="2112" char_id="-1" frame_id="-1" name=""
		   text="稲庭先輩は着替えを上から下まで舐めるように視姦しながら見ていたが、終わると興奮を抑えられない様子で近づいてきた。" voices=""/>
		<char @l="2115" id="inaba" pos="left" src="inaba057"/>
		<msg @l="2117" char_id="-1" frame_id="-1" name="稲庭"
		   text="『はっ、はははっ、さぁキミの処女を頂こうか！』" voices=""/>
		<msg @l="2119" char_id="0" frame_id="1" name="美帆" text="『ひっ････････！』"
		   voices=""/>
		<msg @l="2121" char_id="-1" frame_id="-1" name=""
		   text="私は僅かに後ずさる。そしてその瞬間玲さんが稲庭先輩の前に立ちふさがった。" voices=""/>
		<char @l="2124" id="inaba" pos="left" src="inaba050"/>
		<msg @l="2126" char_id="-1" frame_id="-1" name="稲庭" text="『ん････？』"
		   voices=""/>
		<char @l="2129" id="rei" pos="right" src="rei055"/>
		<msg @l="2131" char_id="1" frame_id="-1" name="玲"
		   text="『お願い、美帆だけは許してあげて稲庭さんっ！』" voices=""/>
		<char @l="2134" id="inaba" pos="left" src="inaba057"/>
		<msg @l="2136" char_id="-1" frame_id="-1" name="稲庭" text="『うるさいっ！』"
		   voices=""/>
		<msg @l="2138" char_id="-1" frame_id="-1" name=""
		   text="すがるようにズボンをつかみ、引き止めようとする玲さんを稲庭先輩の腕が払い退ける。" voices=""/>
		<flash @l="2141" count="4" fade="100" image="white"/>
		<se @l="2143" buf="1" src="箱を蹴ってる" volume="1."/>
		<shake @l="2145" amp="10" class="all" cycle="30" duration="100"
		   type="random"/>
		<clear @l="2149" layer="rei"/>
		<se @l="2152" buf="1" src="人とぶつかる音" volume="1."/>
		<msg @l="2154" char_id="-1" frame_id="-1" name=""
		   text="彼女は突き飛ばされ、そのままフェンスへと背中を激しくぶつけた。" voices=""/>
		<msg @l="2156" char_id="1" frame_id="-1" name="玲" text="『いなば‥‥さ‥ん？』"
		   voices=""/>
		<msg @l="2158" char_id="-1" frame_id="-1" name="稲庭" text="『邪魔だ。』" voices=""/>
		<msg @l="2160" char_id="1" frame_id="-1" name="玲" text="『‥‥！？』" voices=""/>
		<msg @l="2162" char_id="-1" frame_id="-1" name=""
		   text="稲庭先輩の言葉に、玲さんは両目を見開いて硬直する。" voices=""/>
		<msg @l="2163" char_id="-1" frame_id="-1" name=""
		   text="それほどまでに‥‥ショックの大きな言葉だった。" voices=""/>
		<clear @l="2166" class="char"/>
		<char @l="2168" id="inaba" pos="auto" src="inaba050"/>
		<msg @l="2170" char_id="-1" frame_id="-1" name="稲庭" text="『‥‥‥‥。』" voices=""/>
		<msg @l="2172" char_id="-1" frame_id="-1" name=""
		   text="そうして稲庭先輩は嬉々とした足どりで、私の元へ寄って来た。" voices=""/>
		<clear @l="2175" class="char"/>
		<char @l="2177" id="inaba" pos="left" src="inaba050"/>
		<char @l="2179" id="miho" pos="right" src="miho055"/>
		<msg @l="2181" char_id="0" frame_id="1" name="美帆" text="『稲庭先輩‥‥‥？』"
		   voices=""/>
		<msg @l="2183" char_id="-1" frame_id="-1" name="稲庭" text="『みつけた‥‥。』"
		   voices=""/>
		<char @l="2186" id="inaba" pos="left" src="inaba058"/>
		<msg @l="2188" char_id="-1" frame_id="-1" name="稲庭"
		   text="『は、はははっ、見つけた‥‥‥僕の探していたモノを見つけたっ！』" voices=""/>
		<clear @l="2191" class="char"/>
		<msg @l="2193" char_id="-1" frame_id="-1" name=""
		   text="稲庭先輩はそう言って、突然私に抱きついてきた。" voices=""/>
		<char @l="2196" id="miho" pos="auto" src="miho054"/>
		<msg @l="2198" char_id="0" frame_id="1" name="美帆" text="『え‥‥な、なにを！？』"
		   voices=""/>
		<se @l="2201" buf="1" src="人とぶつかる音軽め" volume="1."/>
		<msg @l="2202" char_id="-1" frame_id="-1" name="" text="ビシッ" voices=""/>
		<msg @l="2204" char_id="-1" frame_id="-1" name=""
		   text="最後まで言い終わる前に稲庭先輩が私の首筋を手刀でたたいた。私は―――意識がどんどんと深くなっていった。" voices=""/>
		<stopbgm @l="2207" fadeout="1000"/>
		<clear @l="2211" class="all"/>
		<msgshow @l="2213" show="true"/>
		<msg @l="2215" char_id="0" frame_id="1" name="美帆" text="『ん、んんっ‥‥。』"
		   voices=""/>
		<msg @l="2217" char_id="-1" frame_id="-1" name="" text="何か近くで声が聞こえる‥‥。"
		   voices=""/>
		<msg @l="2218" char_id="-1" frame_id="-1" name="" text="一体何の声だろう‥‥。"
		   voices=""/>
		<msg @l="2220" char_id="-1" frame_id="-1" name="稲庭" text="『‥‥‥つけた‥‥‥。』"
		   voices=""/>
		<msg @l="2222" char_id="-1" frame_id="-1" name="稲庭" text="『‥‥見つ‥けた‥‥‥。』"
		   voices=""/>
		<msg @l="2224" char_id="-1" frame_id="-1" name="" text="ん‥‥この声、稲庭先輩‥‥‥。"
		   voices=""/>
		<msg @l="2225" char_id="-1" frame_id="-1" name="" text="見つけたって‥‥‥何を‥‥‥‥‥。"
		   voices=""/>
		<msg @l="2226" char_id="-1" frame_id="-1" name="" text="え‥‥稲庭先輩‥‥‥！！"
		   voices=""/>
		<msg @l="2227" char_id="-1" frame_id="-1" name="" text="なんでここに？" voices=""/>
		<msg @l="2228" char_id="-1" frame_id="-1" name="" text="そう思った瞬間目が覚めた。"
		   voices=""/>
		<msg @l="2229" char_id="-1" frame_id="-1" name="" text="そして目を開くと―――。"
		   voices=""/>
		<wait_chgmv/>
		<bg @l="2233" src="bg14a"/>
		<msg @l="2235" char_id="-1" frame_id="-1" name="稲庭"
		   text="『ついにみつけた。もう離さない‥‥‥‥これは僕のモノだっ！！』" voices=""/>
		<msg @l="2237" char_id="0" frame_id="1" name="美帆" text="『え！？&#32;きゃああっ！？』"
		   voices=""/>
		<eval @l="2240" expr="f.稲庭ルート即席flag&#32;=&#32;1&#13;&#10;"/>
		<label @l="2244" id="chart_line58"/>
		<call @l="2248" target="EventLabel_98@root_inaba_c_ev01"/>
		<return @l="2249" value="0&#13;&#10;"/>
		<clear @l="2253" class="all"/>
		<wait_chgmv/>
		<bg @l="2258" src="bg13"/>
		<bgm @l="2261" src="bgm03" volume="1."/>
		<msg @l="2263" char_id="0" frame_id="1" name="美帆" text="『ん‥‥。』" voices=""/>
		<msg @l="2265" char_id="0" frame_id="1" name="美帆" text="『あれ‥‥‥わたし‥‥‥‥。』"
		   voices=""/>
		<msg @l="2267" char_id="-1" frame_id="-1" name="" text="目覚めた場所は‥‥部室の中だった。"
		   voices=""/>
		<msg @l="2268" char_id="-1" frame_id="-1" name=""
		   text="先ほどまでの出来事はすべて夢だったのかと、安堵のため息を吐こうとしたその時、私の視界に力なく横たわっている稲庭先輩の姿が映った。"
		   voices=""/>
		<bgm @l="2272" src="bgm17" volume="1."/>
		<msg @l="2274" char_id="0" frame_id="1" name="美帆" text="『せ、せんぱいっ！？』"
		   voices=""/>
		<msg @l="2276" char_id="-1" frame_id="-1" name=""
		   text="私は身を起こして、先輩の傍に、にじり寄ろうとする。" voices=""/>
		<msg @l="2277" char_id="-1" frame_id="-1" name="" text="その瞬間、下腹部に鈍い痛みを感じた。"
		   voices=""/>
		<msg @l="2278" char_id="-1" frame_id="-1" name=""
		   text="痛みの場所を見ると‥‥私の股間から太腿にかけて赤黒い血がべっとりとついていた。" voices=""/>
		<msg @l="2279" char_id="-1" frame_id="-1" name="" text="やはり‥‥夢などではなかった。"
		   voices=""/>
		<msg @l="2281" char_id="0" frame_id="1" name="美帆"
		   text="『先輩、大丈夫ですかっ‥‥‥稲庭先輩っ！』" voices=""/>
		<msg @l="2283" char_id="-1" frame_id="-1" name="稲庭" text="『‥‥‥‥‥‥‥‥。』"
		   voices=""/>
		<msg @l="2285" char_id="-1" frame_id="-1" name=""
		   text="稲庭先輩は私の呼びかけにも全く反応する気配は無い。" voices=""/>
		<msg @l="2286" char_id="-1" frame_id="-1" name=""
		   text="先輩が服用していたという薬が、原因なのだろうか？" voices=""/>
		<char @l="2290" id="kuma" pos="auto" src="kuma010"/>
		<msg @l="2292" char_id="-1" frame_id="-1" name="熊野"
		   text="『先ほど己をあれだけ乱暴に犯した男の心配とは、まったく見上げたお人好しだな。』" voices=""/>
		<msg @l="2294" char_id="-1" frame_id="-1" name="" text="熊野さんが突然現れた。"
		   voices=""/>
		<msg @l="2295" char_id="-1" frame_id="-1" name=""
		   text="先ほどとは口調ががらっと変わり、そのせいか全体の雰囲気も粗暴なものに感じる。" voices=""/>
		<msg @l="2297" char_id="0" frame_id="1" name="美帆"
		   text="『彼は‥‥‥先輩もある意味被害者です。』" voices=""/>
		<msg @l="2299" char_id="-1" frame_id="-1" name="熊野"
		   text="『たいした偽善だな。この男はお前の知らない所で、数々の女を陥れる片棒を担いだ。いくら薬の副作用から来た事とはいえ、許される事ではない。』"
		   voices=""/>
		<msg @l="2301" char_id="-1" frame_id="-1" name="熊野"
		   text="『まあ、このまま死んだ方がお前達には都合がいいんじゃないのか。』" voices=""/>
		<msg @l="2303" char_id="0" frame_id="1" name="美帆"
		   text="『ま‥‥‥まさか‥‥‥稲庭先輩‥‥‥死‥‥‥。』" voices=""/>
		<msg @l="2305" char_id="-1" frame_id="-1" name="熊野"
		   text="『安心しろ、仮死状態になっているだけだ‥‥薬の反動でな。こいつが言ってただろ？薬をのみつづけないとこうなっちまうのさ。』"
		   voices=""/>
		<msg @l="2307" char_id="-1" frame_id="-1" name="熊野"
		   text="『今まで欠かすことは無かったのに、今回に限ってお前を犯すのに夢中で忘れちまった‥‥たいした肉体だよ。』" voices=""/>
		<msg @l="2309" char_id="-1" frame_id="-1" name=""
		   text="ニヤニヤと笑いながら、熊野は私の裸を舐めるように見る。" voices=""/>
		<msg @l="2311" char_id="0" frame_id="1" name="美帆"
		   text="『なっ‥‥何を言ってるんですか！？&#32;そんな‥‥‥。』" voices=""/>
		<msg @l="2313" char_id="-1" frame_id="-1" name="熊野"
		   text="『まあ‥‥本当かどうかはすぐにわかる。』" voices=""/>
		<msg @l="2315" char_id="-1" frame_id="-1" name=""
		   text="熊野がそう言って片手を上げると、部室の外に待機していた男子部員たちがわらわらと部室内に入ってくる。" voices=""/>
		<msg @l="2316" char_id="-1" frame_id="-1" name=""
		   text="先ほどまで玲さんに奉仕をさせていた彼らだ。" voices=""/>
		<msg @l="2317" char_id="-1" frame_id="-1" name=""
		   text="そういえば‥‥‥部室の中に、玲さんの姿が見当たらない。" voices=""/>
		<msg @l="2319" char_id="0" frame_id="1" name="美帆" text="『な‥‥なにを‥‥‥？』"
		   voices=""/>
		<msg @l="2321" char_id="-1" frame_id="-1" name="熊野"
		   text="『いままで何百人と処女を食ってきた稲庭が見込んだだけあって、お前は素晴らしい肉体を持っている。』" voices=""/>
		<msg @l="2323" char_id="-1" frame_id="-1" name="熊野"
		   text="『そこで‥‥この町の仕組みに則ってお前を最高の”町の女性”にする為に調教しようと思う。』" voices=""/>
		<msg @l="2325" char_id="0" frame_id="1" name="美帆"
		   text="『町の仕組み‥‥‥調教って‥‥‥‥‥？』" voices=""/>
		<msg @l="2327" char_id="-1" frame_id="-1" name="熊野"
		   text="『質問が多いな‥‥‥お前はもう何処にも逃げられない。黙って私に従えば痛い目に合わずに済む。』" voices=""/>
		<msg @l="2329" char_id="0" frame_id="1" name="美帆" text="『そ、そんな‥‥‥。』"
		   voices=""/>
		<msg @l="2331" char_id="-1" frame_id="-1" name="熊野"
		   text="『そうそう‥‥この者たちには稲庭の薬を改良した新薬を飲ませてある。』" voices=""/>
		<msg @l="2333" char_id="0" frame_id="1" name="美帆" text="『ひっ‥‥！！』" voices=""/>
		<msg @l="2335" char_id="-1" frame_id="-1" name=""
		   text="よく見ると、男子部員の彼らはみな一様に表情が虚ろだ。" voices=""/>
		<msg @l="2337" char_id="-1" frame_id="-1" name="熊野"
		   text="『白石とかいう女にしゃぶらせている時もこいつら少しおかしかっただろ？&#32;その新薬の影響だ。』" voices=""/>
		<msg @l="2339" char_id="-1" frame_id="-1" name="熊野"
		   text="『この新薬は稲庭のとは違い、セックス用に調整されている。』" voices=""/>
		<msg @l="2341" char_id="-1" frame_id="-1" name="熊野"
		   text="『肉体は強化されないが、そのかわり精液に媚薬成分が含まれるようになる特別製だ。安心して犯されるがいい。』" voices=""/>
		<msg @l="2343" char_id="0" frame_id="1" name="美帆" text="『そんな‥‥‥きゃあっ！？』"
		   voices=""/>
		<msg @l="2345" char_id="-1" frame_id="-1" name="男子会員Ａ" text="『‥‥‥‥。』"
		   voices=""/>
		<msg @l="2347" char_id="-1" frame_id="-1" name="男子会員Ｂ" text="『‥‥‥‥。』"
		   voices=""/>
		<msg @l="2349" char_id="-1" frame_id="-1" name=""
		   text="私の手を、それぞれ両脇から男子サークル員二人が掴む。" voices=""/>
		<msg @l="2351" char_id="-1" frame_id="-1" name="熊野"
		   text="『ああ、言い忘れていたが、彼らは薬によって覚醒したばかりなので性欲は普通の人間の数十倍だ。たっぷりと嬲ってもらうといい。』"
		   voices=""/>
		<msg @l="2353" char_id="0" frame_id="1" name="美帆" text="『ひっ‥‥。』" voices=""/>
		<msg @l="2355" char_id="0" frame_id="1" name="美帆"
		   text="『いやああああああああああああっ！！！』" voices=""/>
		<clear @l="2361" class="all"/>
		<call @l="2364" target="EventLabel_99@root_inaba_c_ev02"/>
		<call @l="2367" target="EventLabel_49@ending11"/>
		<return @l="2368" value="0&#13;&#10;"/>
		<label @l="2373" id="EventLabel_95"/>
		<msg @l="2375" char_id="0" frame_id="1" name="美帆" text="(このコースなら左のハズっ！)"
		   voices="miho05500"/>
		<msg @l="2377" char_id="-1" frame_id="-1" name=""
		   text="私はボールの打ち返されると予測される方に向かって走り始める。" voices=""/>
		<msg @l="2379" char_id="-1" frame_id="-1" name="鈴木" text="『やっ！！』" voices=""/>
		<se @l="2383" buf="1" src="テニスボール打つ音" volume="1."/>
		<msg @l="2385" char_id="-1" frame_id="-1" name=""
		   text="十分な体勢で打てなかったからか、球威はあまりない。" voices=""/>
		<msg @l="2387" char_id="-1" frame_id="-1" name=""
		   text="しかし‥‥打ち返されたボールは私の予測とは違う方向に飛んでいく。" voices=""/>
		<msg @l="2389" char_id="0" frame_id="1" name="美帆" text="『なっ‥‥？』"
		   voices="miho05040"/>
		<msg @l="2391" char_id="-1" frame_id="-1" name=""
		   text="慌ててボールを追いかけてラケットを伸ばすが、私の前を通り過ぎていった。" voices=""/>
		<msg @l="2393" char_id="0" frame_id="1" name="美帆" text="『うあ‥‥。』"
		   voices="miho05520"/>
		<se @l="2397" buf="1" src="ホイッスル（テニス場）" volume="1."/>
		<msg @l="2399" char_id="-1" frame_id="-1" name="女子会員Ｂ" text="『マッチウォンバイ、鈴木。』"
		   voices=""/>
		<msg @l="2401" char_id="-1" frame_id="-1" name="" text="審判の無情な声がコートに響いた。"
		   voices=""/>
		<msg @l="2403" char_id="0" frame_id="1" name="美帆" text="『あ、ああ‥‥。』"
		   voices="miho05560"/>
		<msg @l="2405" char_id="-1" frame_id="-1" name="" text="震えた声と共に私はその場にうずくまる。"
		   voices=""/>
		<msg @l="2406" char_id="-1" frame_id="-1" name="" text="負けた。" voices=""/>
		<msg @l="2407" char_id="-1" frame_id="-1" name="" text="私は‥‥負けてしまった。"
		   voices=""/>
		<msg @l="2408" char_id="-1" frame_id="-1" name=""
		   text="ルール通りなら私はこれからパンツを脱がなければならない。" voices=""/>
		<msg @l="2409" char_id="-1" frame_id="-1" name="" text="どうしよう‥‥。" voices=""/>
		<stopbgm @l="2412" fadeout="1000"/>
		<msg @l="2414" char_id="-1" frame_id="-1" name="女子会員Ａ"
		   text="『以上を持ちまして、新入生歓迎会を終了します。』" voices=""/>
		<msg @l="2416" char_id="0" frame_id="1" name="美帆" text="『えっ？』"
		   voices="miho10030"/>
		<msg @l="2418" char_id="-1" frame_id="-1" name="" text="女子の先輩が突然終了を宣言する。"
		   voices=""/>
		<msg @l="2419" char_id="-1" frame_id="-1" name="" text="これって一体‥‥。" voices=""/>
		<msg @l="2421" char_id="-1" frame_id="-1" name="男子会員Ｂ" text="『おい、どういう事だよ！』"
		   voices=""/>
		<msg @l="2423" char_id="-1" frame_id="-1" name="女子会員Ａ"
		   text="『試合が予想外に長引いちゃったから、さっさと二次会に行かなきゃならないのよ。』" voices=""/>
		<msg @l="2425" char_id="-1" frame_id="-1" name="女子会員Ａ"
		   text="『あなたたちも早くした方がいいんじゃない？校舎の人払いだっていつまでもしておけないんだから。』" voices=""/>
		<msg @l="2427" char_id="-1" frame_id="-1" name="男子会員Ｂ"
		   text="『そ、それもそうだな‥‥おい君、早く服を着たまえ。』" voices=""/>
		<msg @l="2429" char_id="0" frame_id="1" name="美帆" text="『えっ？』"
		   voices="miho10030"/>
		<msg @l="2431" char_id="-1" frame_id="-1" name=""
		   text="あまりの事に私はきょとんとしてしまうが、何にせよ服を着ていいと言われた以上はさっさと身に着けた方が良さそうだ。" voices=""/>
		<bgm @l="2434" src="bgm02" volume="1."/>
		<wait_chgmv/>
		<bg @l="2437" src="bg13"/>
		<char @l="2440" id="miho" pos="auto" src="miho050"/>
		<msg @l="2442" char_id="-1" frame_id="-1" name="男子会員Ｃ"
		   text="『さっきは惜しかったな。残念ながら稲庭会長はいないけど、負けた連中だけ集めた残念会を今からやるからこっちに来いよ。』"
		   voices=""/>
		<msg @l="2444" char_id="0" frame_id="1" name="美帆" text="『は、はい？』"
		   voices="miho12760"/>
		<clear @l="2451" class="all"/>
		<msg @l="2453" char_id="-1" frame_id="-1" name=""
		   text="強引な男子会員に腕を引かれ、私はメイングラウンドの方へと連れて行かれる。二次会に行けなかったのは残念だったが、ダメだった子にもきちんとフォローをするというのが稲庭先輩の方針なのだろう。"
		   voices=""/>
		<msg @l="2455" char_id="-1" frame_id="-1" name="男子会員Ｃ" text="『さあ、着いたぜ。』"
		   voices=""/>
		<msg @l="2457" char_id="0" frame_id="1" name="美帆" text="『えっ‥‥ええっ！？』"
		   voices=""/>
		<msg @l="2459" char_id="-1" frame_id="-1" name=""
		   text="私は目の前で行われている光景に言葉を失った。" voices=""/>
		<stopbgm @l="2463" fadeout="1000"/>
		<end_scene @l="2466"/>
		<call @l="2470" target="EventLabel_96@root_inaba03"/>
		<return @l="2471" value="0&#13;&#10;"/>
		<return @l="2474" value=""/>
	</code>
</xscript>
