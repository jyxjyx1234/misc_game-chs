<?xml version="1.0" encoding="utf-8"?>
<xscript>
	<debug editor="&quot;C:\Program&#32;Files&#32;(x86)\sakura\sakura.exe&quot;&#32;&quot;%src%&quot;&#32;-Y=%line%"
	   src="D:\シロップ\町ぐるみの罠＋汚された夏セット版\汚された夏\完成データ\汚された夏\script\text\ending04.txt"/>
	<code>
		<label @l="12" id="EventLabel_42"/>
		<description @l="16" text="性処理用ペット亜季奈"/>
		<eval @l="18" expr="f.numDay=0&#13;&#10;"/>
		<wait_chgmv/>
		<bg @l="22" src="bg07"/>
		<bgm @l="26" src="bgm03" volume="1."/>
		<char @l="30" id="miho" pos="auto" src="miho116"/>
		<msg @l="32" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』"
		   voices="miho11490"/>
		<msg @l="34" char_id="-1" frame_id="-1" name=""
		   text="亜季奈との軽い衝突があってから既に一週間が経っていた。" voices=""/>
		<msg @l="35" char_id="-1" frame_id="-1" name=""
		   text="あの件があった翌日‥‥室内プールを訪れた私を待っていたのは、今日限りでコーチの役目を解任するという渡部の言葉だった。"
		   voices=""/>
		<msg @l="36" char_id="-1" frame_id="-1" name="" text="説明は何も無い。" voices=""/>
		<msg @l="37" char_id="-1" frame_id="-1" name=""
		   text="ただ、もう必要なくなったとだけ言われ、話を打ち切られた。" voices=""/>
		<msg @l="38" char_id="-1" frame_id="-1" name=""
		   text="もちろん私は亜季奈に聞いてみたが、結果はあの日と同じ、避けられてしまった。" voices=""/>
		<msg @l="39" char_id="-1" frame_id="-1" name=""
		   text="そして‥‥水泳部の合宿期間が終わりを告げた。" voices=""/>
		<msg @l="40" char_id="-1" frame_id="-1" name="" text="結局、私は亜季奈に何も言えないままだった。"
		   voices=""/>
		<msg @l="42" char_id="0" frame_id="-1" name="美帆" text="(亜季奈‥‥私、単なるお節介だったの？)"
		   voices="miho11500"/>
		<msg @l="44" char_id="0" frame_id="-1" name="美帆" text="(本当に迷惑でしか‥‥なかったの？)"
		   voices="miho11510"/>
		<msg @l="46" char_id="-1" frame_id="-1" name=""
		   text="亜季奈たちが使っていた宿舎へと通じる道に立ち、心ので問いかける。" voices=""/>
		<msg @l="47" char_id="-1" frame_id="-1" name=""
		   text="けれど、もう亜季奈はあの宿舎へは戻ってこない。" voices=""/>
		<msg @l="48" char_id="-1" frame_id="-1" name="" text="そして‥‥私の元へも。" voices=""/>
		<stopbgm @l="52" fadeout="1000"/>
		<clear @l="58" class="all"/>
		<label @l="61" id="event_scene23"/>
		<msg @l="63" char_id="-1" frame_id="-1" name="" text="―――放課後・教室" voices=""/>
		<label @l="67" id="chart_line19"/>
		<wait_chgmv/>
		<ev @l="71" src="ev-023"/>
		<bgm @l="75" src="bgm14" volume="1."/>
		<msg @l="77" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んふっ‥‥すごぉい、もうカチカチだね。』" voices="akina03870"/>
		<msg @l="79" char_id="-1" frame_id="-1" name=""
		   text="夕暮れ時、教室の片隅で制服姿の亜季奈が、咥えていた肉棒から口を離す。" voices=""/>
		<msg @l="80" char_id="-1" frame_id="-1" name=""
		   text="一度放出し軟らかくなった陰茎が、再び力を取り戻したのを確かめると、嬉しそうに亜季奈が笑う。" voices=""/>
		<msg @l="81" char_id="-1" frame_id="-1" name=""
		   text="眼前には、脈打つ肉棒さらけ出す、二人の男子が並んでいる。" voices=""/>
		<msg @l="82" char_id="-1" frame_id="-1" name=""
		   text="彼女の口元からは、先ほど飲んだ白濁液の残りが垂れていた。" voices=""/>
		<msg @l="83" char_id="-1" frame_id="-1" name=""
		   text="あの日から‥‥メス犬宣言をしたあの日から、亜季奈は毎日の様に精液を求めるようになった。" voices=""/>
		<msg @l="84" char_id="-1" frame_id="-1" name=""
		   text="私はメス犬だからミルクを飲む。淫棒から噴出すミルクを飲むのが当たり前だという様に。" voices=""/>
		<msg @l="85" char_id="-1" frame_id="-1" name=""
		   text="それが今の亜季奈の‥‥メス犬の行動原理であった。" voices=""/>
		<msg @l="86" char_id="-1" frame_id="-1" name=""
		   text="水泳部員達との狂宴が始まる前のウォーミングアップとして、放課後の教室が使われていた。" voices=""/>
		<msg @l="88" char_id="-1" frame_id="-1" name="水泳部の子Ａ"
		   text="『おうよ。ご希望通りにまだまだ出せるぜ。』" voices=""/>
		<msg @l="90" char_id="-1" frame_id="-1" name="水泳部の子Ｂ"
		   text="『俺なんか、お前が沢山飲みたいっていうから、ここ３日くらいオナニーしないで溜めてたんだぜ。』" voices=""/>
		<msg @l="92" char_id="-1" frame_id="-1" name=""
		   text="それを聞いた亜季奈が愛おしそうに陰嚢を優しく揉みしだく。" voices=""/>
		<msg @l="94" char_id="2" frame_id="-1" name="亜季奈"
		   text="『じゃあ、この中に熱いミルクがいっぱい詰まってるんだぁ。』" voices="akina03880"/>
		<msg @l="96" char_id="-1" frame_id="-1" name="水泳部の子Ｂ"
		   text="『ミルクっていうより、練乳かな？&#32;量もタップリだぜ。』" voices=""/>
		<msg @l="98" char_id="-1" frame_id="-1" name=""
		   text="まだ出していない方が自信たっぷりに肉棒を上下に振る。" voices=""/>
		<msg @l="99" char_id="-1" frame_id="-1" name=""
		   text="それを聞いた亜季奈の顔が輝き、パクッと陰嚢を頬張った。" voices=""/>
		<msg @l="101" char_id="-1" frame_id="-1" name="水泳部の子Ａ"
		   text="『うお‥‥いきなりフクロからかよ。』" voices=""/>
		<msg @l="103" char_id="-1" frame_id="-1" name=""
		   text="モゴモゴと顎を動かし、腔内では舌が玉を転がしていた。" voices=""/>
		<msg @l="105" char_id="-1" frame_id="-1" name="水泳部の子Ｂ"
		   text="『さすが、毎日チ○ポしゃぶってるだけのことはあるよな。タマの扱い方が巧いよ。』" voices=""/>
		<msg @l="107" char_id="2" frame_id="-1" name="亜季奈"
		   text="『毎日じゃないよぉ‥‥クラブがある日だけだもん。』" voices="akina03890"/>
		<msg @l="109" char_id="-1" frame_id="-1" name=""
		   text="亜季奈は咥えるのを止め、心外だと言わんばかりの顔で否定する。" voices=""/>
		<msg @l="111" char_id="-1" frame_id="-1" name="水泳部の子Ａ"
		   text="『どうせクラブの無い日は渡部のモノをしゃぶってんだろ？" voices=""/>
		<msg @l="113" char_id="2" frame_id="-1" name="亜季奈" text="『それはそうだけどぉ‥‥。』"
		   voices="akina03900"/>
		<msg @l="115" char_id="-1" frame_id="-1" name="水泳部の子Ｂ"
		   text="『じゃあ、やっぱ毎日じゃねーかよ。』" voices=""/>
		<msg @l="117" char_id="-1" frame_id="-1" name=""
		   text="亜季奈は抗議しようとしたが、図星をいわれ言い返せない。" voices=""/>
		<msg @l="119" char_id="2" frame_id="-1" name="亜季奈" text="『むー‥‥。』"
		   voices="akina03910"/>
		<msg @l="121" char_id="-1" frame_id="-1" name=""
		   text="しょうがなく拗ねたように唇を尖らせ、頬を膨らませる。" voices=""/>
		<msg @l="123" char_id="2" frame_id="-1" name="亜季奈"
		   text="『だってぇ‥‥これ、大好きなんだも～ん。』" voices="akina03920"/>
		<msg @l="125" char_id="-1" frame_id="-1" name="" text="亜季奈は開き直って逸物に頬擦りをする。"
		   voices=""/>
		<msg @l="126" char_id="-1" frame_id="-1" name=""
		   text="うっとりと目を細め、先端をペロリと舐め上げる。" voices=""/>
		<msg @l="128" char_id="-1" frame_id="-1" name="水泳部の子Ａ"
		   text="『へへっ‥‥物欲しそうな顔しやがって。』" voices=""/>
		<msg @l="130" char_id="-1" frame_id="-1" name="水泳部の子Ｂ"
		   text="『遠慮しないで、好きなだけ飲んでくれよ。』" voices=""/>
		<msg @l="132" char_id="2" frame_id="-1" name="亜季奈"
		   text="『ん、れろっ‥‥‥言われなくても、しゃぶっちゃうも～ん。』" voices="akina03930"/>
		<msg @l="134" char_id="-1" frame_id="-1" name=""
		   text="子供っぽい返事をすると、亜季奈は片方の男根を一気に喉奥まで飲み込んむ。" voices=""/>
		<msg @l="135" char_id="-1" frame_id="-1" name=""
		   text="それから唇をすぼめて竿を締め付け、早いピッチで頭を振り始める。" voices=""/>
		<msg @l="137" char_id="2" frame_id="-1" name="亜季奈"
		   text="『あむ‥‥んぐっ‥‥‥んちゅっ、ちゅぷっ、ちゅぷっ、ちゅぷっ！』" voices="akina03940"/>
		<msg @l="139" char_id="-1" frame_id="-1" name=""
		   text="時折、刺激が単調にならないように左右に捻りを加えるのも忘れない。" voices=""/>
		<msg @l="141" char_id="-1" frame_id="-1" name="水泳部の子Ｂ"
		   text="『おわっ、ちょっ‥‥いきなりすぎだって！！』" voices=""/>
		<msg @l="143" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んはっ‥‥だって、好きなだけしゃぶっていいって言ったよ？』" voices="akina03950"/>
		<msg @l="145" char_id="-1" frame_id="-1" name="水泳部の子Ｂ"
		   text="『だからって、すぐに出しちまったら勿体無いだろ？&#32;せっかく溜めてきたんだから少しは楽しませてくれよな。』" voices=""/>
		<msg @l="147" char_id="2" frame_id="-1" name="亜季奈" text="『んもぉ‥‥注文が多いんだからぁ。』"
		   voices="akina03960"/>
		<msg @l="149" char_id="-1" frame_id="-1" name="水泳部の子Ａ"
		   text="『いいじゃん、どうせ一発で終わるつもりはねぇんだろ。』" voices=""/>
		<msg @l="151" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んふふ～‥‥それじゃ、こんな感じでどうかなぁ？』" voices="akina03970"/>
		<msg @l="153" char_id="-1" frame_id="-1" name=""
		   text="楽しげにそう言うと、亜季奈は再び亀頭を咥え込む。" voices=""/>
		<msg @l="155" char_id="2" frame_id="-1" name="亜季奈"
		   text="『あ～む‥‥ちゅぷちゅぷちゅぷ‥‥‥‥‥ちゅ、ちゅるるるっ。』" voices="akina03980"/>
		<msg @l="157" char_id="-1" frame_id="-1" name=""
		   text="舌を貼り付けるように亀頭吸い、筋裏を優しくマッサージする。" voices=""/>
		<msg @l="159" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んぐ、んちゅっ、ちゅぷ、ちゅぷ、ちゅぷっ‥‥‥んぷぁっ！』" voices="akina03990"/>
		<msg @l="161" char_id="-1" frame_id="-1" name=""
		   text="含んだ肉茎を弄ぶように、亜季奈は溜まってきた唾液を使い、緩々と鈴口に絡み付けながらしゃぶっていく。" voices=""/>
		<msg @l="162" char_id="-1" frame_id="-1" name=""
		   text="唇の隙間からの汁音と息遣いが教室を淫靡な世界に変えていった。" voices=""/>
		<msg @l="164" char_id="-1" frame_id="-1" name="水泳部の子Ａ"
		   text="『そうそう‥‥それいいな‥‥すげえ気持ちイイ。』" voices=""/>
		<msg @l="166" char_id="-1" frame_id="-1" name=""
		   text="猥唇が窄まり肉茎を締め付け、唾液の中を泳ぐ舌先が鈴口に入り込もうとする。" voices=""/>
		<msg @l="167" char_id="-1" frame_id="-1" name=""
		   text="ぬめりが鈴口から出てくると、のたうつ舌は唾液と先走りを攪拌し始める。" voices=""/>
		<msg @l="168" char_id="-1" frame_id="-1" name=""
		   text="唾液に苦味が付くと、亜季奈はおいしそうに喉を鳴らして飲み込んだ。" voices=""/>
		<msg @l="170" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んふぅ‥‥あふっ‥‥んぐ、んぷ、んぷっ‥‥‥ぷあっ。』" voices="akina04000"/>
		<msg @l="172" char_id="2" frame_id="-1" name="亜季奈"
		   text="『すごーい、こんなガチガチになって‥‥んふっ‥‥れろ、れろ。』" voices="akina04010"/>
		<msg @l="174" char_id="-1" frame_id="-1" name=""
		   text="染み出す先走りを勿体無いと言わんばかりに舌で掬い取る。" voices=""/>
		<msg @l="176" char_id="-1" frame_id="-1" name="水泳部の子Ａ"
		   text="『な、なあ‥‥そろそろこっちもやってくれよ。』" voices=""/>
		<msg @l="178" char_id="-1" frame_id="-1" name="" text="亜季奈に２射目の充填を要求する。"
		   voices=""/>
		<msg @l="180" char_id="2" frame_id="-1" name="亜季奈" text="『はーい。』"
		   voices="akina04020"/>
		<msg @l="182" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んぷっ‥‥‥んっ、ちゅぷ、ちゅぷ、んぐっ‥‥‥ちゅるるっ。』" voices="akina04030"/>
		<msg @l="184" char_id="-1" frame_id="-1" name=""
		   text="しゃぶっていたモノから口を離し、もう一方に控えていた肉棒を先程と同じように咥え込む。" voices=""/>
		<msg @l="185" char_id="-1" frame_id="-1" name=""
		   text="今度は最初からゆっくりと慈しむように舌を絡めながら、唇と口に溜めた唾液で愛撫していく。" voices=""/>
		<msg @l="187" char_id="-1" frame_id="-1" name="水泳部の子Ａ"
		   text="『おおっ‥‥すげえ、やっぱオマエ最高だぜ！』" voices=""/>
		<msg @l="189" char_id="2" frame_id="-1" name="亜季奈" text="『ぷあっ‥‥そんなに気持ち良い？』"
		   voices="akina04040"/>
		<msg @l="191" char_id="-1" frame_id="-1" name=""
		   text="亜季奈が瞳を潤ませ頬を染めながら嬉しそうに聞いてくる。" voices=""/>
		<msg @l="193" char_id="-1" frame_id="-1" name="水泳部の子Ａ"
		   text="『文句なし！&#32;毎日しゃぶって欲しいくらいだよ。』" voices=""/>
		<msg @l="195" char_id="2" frame_id="-1" name="亜季奈"
		   text="『えへへっ‥‥嬉しいから、サービスしちゃうっ！』" voices="akina04050"/>
		<msg @l="197" char_id="2" frame_id="-1" name="亜季奈"
		   text="『ん～‥‥んむっ‥‥んっ、んぷ、んぷっ‥‥んっ、んむぅっ。』" voices="akina04060"/>
		<msg @l="199" char_id="-1" frame_id="-1" name=""
		   text="深く長いストロークで、肉柱を深々と飲み込んでいく亜季奈。" voices=""/>
		<msg @l="200" char_id="-1" frame_id="-1" name=""
		   text="口内では収まりきらず、先端は喉奥まで達する。" voices=""/>
		<msg @l="201" char_id="-1" frame_id="-1" name=""
		   text="咽頭で亀頭の到着を感じると、喉を動かし、緩やかに粘膜で包み込む。" voices=""/>
		<msg @l="203" char_id="-1" frame_id="-1" name="水泳部の子Ａ"
		   text="『うあっ‥‥これ、ディープスロートってやつだろ？』" voices=""/>
		<msg @l="205" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んぐっ‥‥‥‥‥ンンッ‥‥んむっ‥‥ぷあっ！！』" voices="akina04070"/>
		<msg @l="207" char_id="2" frame_id="-1" name="亜季奈" text="『はふっ‥‥‥どう、気持ち良い？』"
		   voices="akina04080"/>
		<msg @l="209" char_id="-1" frame_id="-1" name="水泳部の子Ａ"
		   text="『おう、すげえ‥‥マジすげえよ。』" voices=""/>
		<msg @l="211" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んふふっ‥‥‥でも、サービスはここで終了だよ。』" voices="akina04090"/>
		<msg @l="213" char_id="2" frame_id="-1" name="亜季奈"
		   text="『私‥‥そろそろ、ミルク飲みたくなっちゃった。』" voices="akina04100"/>
		<msg @l="215" char_id="-1" frame_id="-1" name=""
		   text="亜季奈は人差し指を唇にあて、上目遣いに精液をおねだりする。" voices=""/>
		<msg @l="217" char_id="-1" frame_id="-1" name="水泳部の子Ａ"
		   text="『ああ、たっぷり飲ませてやるよ。』" voices=""/>
		<msg @l="219" char_id="-1" frame_id="-1" name="水泳部の子Ｂ"
		   text="『その代わり、シッカリ搾り取ってくれよな。』" voices=""/>
		<msg @l="221" char_id="2" frame_id="-1" name="亜季奈"
		   text="『うん、いっぱい搾り取っちゃうからね♪』" voices="akina04110"/>
		<msg @l="223" char_id="-1" frame_id="-1" name=""
		   text="お預けタイムが終わり、亜季奈の顔に満面の笑みが浮かぶ。" voices=""/>
		<msg @l="224" char_id="-1" frame_id="-1" name=""
		   text="そして元気よく肉棒にしゃぶりつくいてゆく。" voices=""/>
		<msg @l="226" char_id="2" frame_id="-1" name="亜季奈"
		   text="『あむっ‥‥んぐっ、ちゅぷ、ちゅぷ、ちゅぷ‥‥ちゅるるるっ。』" voices="akina04120"/>
		<msg @l="228" char_id="-1" frame_id="-1" name=""
		   text="先端を咥え直すと、亜季奈は小さな唇と口を駆使して彼らを責め立てる。" voices=""/>
		<msg @l="229" char_id="-1" frame_id="-1" name=""
		   text="舌先を使ってエラを舐め上げた後、唇をすぼめて亀頭全体を締め付ける。" voices=""/>
		<msg @l="231" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んぷっ‥‥んぷっ‥‥んぷっ‥‥‥ちゅぷっ‥‥んぅ、ちゅぱっ。』" voices="akina04130"/>
		<msg @l="233" char_id="2" frame_id="-1" name="亜季奈"
		   text="『えへ‥‥おち○ちんの先っちょから、苦いの出てきたぁ。』" voices="akina04140"/>
		<msg @l="235" char_id="-1" frame_id="-1" name="水泳部の子Ａ"
		   text="『お、おう‥‥じっくり味わえよ。』" voices=""/>
		<msg @l="237" char_id="2" frame_id="-1" name="亜季奈"
		   text="『はぁ～い‥‥あむ、んっ‥‥ちゅう‥‥ちゅるっ、んぷ、んぷっ！』" voices="akina04150"/>
		<msg @l="239" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んぐっ、んむんむ‥‥ちゅぷ‥‥ちゅぷ、ちゅぷ、ちゅぷっ！！』" voices="akina04160"/>
		<msg @l="241" char_id="-1" frame_id="-1" name=""
		   text="口の端から泡立った白い液を垂らしながら、淫猥な水音を立てて肉竿を舐め上げる。" voices=""/>
		<msg @l="243" char_id="-1" frame_id="-1" name="水泳部の子Ｂ"
		   text="『ほらほら、しゃぶらないチ○ポは手でしごいてね。』" voices=""/>
		<msg @l="245" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んぅっ‥‥んふっ、んっ、んっ、んっ‥‥‥‥‥ン、ちゅるるっ。』" voices="akina04170"/>
		<msg @l="247" char_id="-1" frame_id="-1" name="" text="亜季奈の手首をつかみ、自分の肉棒に導く。"
		   voices=""/>
		<msg @l="248" char_id="-1" frame_id="-1" name=""
		   text="亜季奈は肉柱に指先を絡めると、人差し指を曲げて鈴口をいじり始めた。" voices=""/>
		<msg @l="249" char_id="-1" frame_id="-1" name=""
		   text="先程から出続けている先走りを潤滑油にしてクチュクチュとすり上げていく。" voices=""/>
		<msg @l="250" char_id="-1" frame_id="-1" name=""
		   text="もちろん、口腔で亀頭を吸いあげるのも忘れていない。" voices=""/>
		<msg @l="252" char_id="-1" frame_id="-1" name="水泳部の子Ａ" text="『やべ‥‥も、出そう。』"
		   voices=""/>
		<msg @l="254" char_id="2" frame_id="-1" name="亜季奈" text="『んはっ‥‥じゃ、今度はこっち♪』"
		   voices="akina04180"/>
		<msg @l="256" char_id="-1" frame_id="-1" name=""
		   text="咥えている方が達しそうになると、亜季奈は意地悪く囁き、手でしごいていた肉竿に口を付ける。" voices=""/>
		<msg @l="257" char_id="-1" frame_id="-1" name=""
		   text="口を離した方のモノにはやはり指先を絡み付け、萎えない様に、だがイカないぐらいの微妙な刺激を絶えず与え続けている。" voices=""/>
		<msg @l="258" char_id="-1" frame_id="-1" name="" text="亜季奈は同時の射精を望んでいるようだ。"
		   voices=""/>
		<msg @l="260" char_id="2" frame_id="-1" name="亜季奈"
		   text="『れろ‥‥ン、んぐっ‥‥‥ちゅむっ、んぷ、んぷ、んぷ、んはっ。』" voices="akina04190"/>
		<msg @l="262" char_id="2" frame_id="-1" name="亜季奈"
		   text="『ン、れろれろれろれろ‥‥ちゅぷっ、んっ‥‥‥ちゅるるるっ。』" voices="akina04200"/>
		<msg @l="264" char_id="-1" frame_id="-1" name="水泳部の子Ｂ"
		   text="『うおっ、裏筋‥弱いんだよ。そこばっか‥‥っ！！』" voices=""/>
		<msg @l="266" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んはっ‥‥えへへ～、たまらなくなっちゃうでしょぉ？』" voices="akina04210"/>
		<msg @l="268" char_id="2" frame_id="-1" name="亜季奈"
		   text="『でも、もっとたまらなくしてあげちゃうからねぇ～。』" voices="akina04220"/>
		<msg @l="270" char_id="-1" frame_id="-1" name=""
		   text="亜季奈はイタズラっぽくそう言うと、先端部分を咥え直し、唇をキュッと締め付け‥‥亀頭の部分だけを何度も往復するように頭を前後に動かす。"
		   voices=""/>
		<msg @l="272" char_id="2" frame_id="-1" name="亜季奈"
		   text="『あふ、ンっ‥‥ちゅぷ、ちゅぷ、ちゅぷ、ちゅぷ、ちゅぷ。』" voices="akina04230"/>
		<msg @l="274" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んんっ‥‥んぷっ、んぷっ、んぷっ‥‥‥‥ン、ちゅぱっ！！』" voices="akina04240"/>
		<msg @l="276" char_id="-1" frame_id="-1" name="水泳部の子Ｂ"
		   text="『それ、す、凄過ぎるって‥‥‥‥うあっ！！』" voices=""/>
		<msg @l="278" char_id="-1" frame_id="-1" name=""
		   text="男の一人が情けない声をあげて腰を震わせる。" voices=""/>
		<msg @l="279" char_id="-1" frame_id="-1" name="" text="もう限界なのだろう。" voices=""/>
		<msg @l="281" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んふぅ‥‥いいよぉ、出して‥‥‥んちゅっ‥‥‥‥。』" voices="akina04250"/>
		<msg @l="283" char_id="2" frame_id="-1" name="亜季奈"
		   text="『このまま‥‥ン、私のお口とお顔にいっぱいミルク出してぇ。』" voices="akina04260"/>
		<msg @l="285" char_id="-1" frame_id="-1" name="" text="艶やかな声をあげて射精をねだる。"
		   voices=""/>
		<msg @l="286" char_id="-1" frame_id="-1" name=""
		   text="亜季奈は３日かけてじっくり熟成させた精液を飲んでみたいのだろう、そちらを再び飲み込み直して一層激しくしゃぶり立てる。"
		   voices=""/>
		<msg @l="288" char_id="2" frame_id="-1" name="亜季奈"
		   text="『ちゅぱっ‥‥ン、ふっ‥‥んぷっ、んぷっ、んぷっ、んぷっ！』" voices="akina04270"/>
		<msg @l="290" char_id="2" frame_id="-1" name="亜季奈"
		   text="『ちゅぷ、ちゅぷ、ちゅぷ、ちゅぷ、ちゅぷ‥‥ン、ちゅるるっ！！』" voices="akina04280"/>
		<msg @l="292" char_id="-1" frame_id="-1" name="水泳部の子Ａ" text="『く、いくぞっ！！』"
		   voices=""/>
		<msg @l="294" char_id="-1" frame_id="-1" name="水泳部の子Ｂ" text="『おお‥‥で、出るっ！！』"
		   voices=""/>
		<flash @l="298" count="4" fade="100" image="white"/>
		<wait_chgmv/>
		<ev @l="302" src="ev-023z1"/>
		<msg @l="304" char_id="2" frame_id="-1" name="亜季奈" text="『んぅぅぅっ！！』"
		   voices="akina04290"/>
		<msg @l="306" char_id="-1" frame_id="-1" name="" text="男たち二人が同時に腰を震わせる。"
		   voices=""/>
		<msg @l="307" char_id="-1" frame_id="-1" name=""
		   text="一人が口腔へ、一人が顔めがけて熱い白濁色の液体を吐き出す。" voices=""/>
		<msg @l="309" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んぷっ‥‥んっ、んっ‥‥‥‥んんっ‥‥‥‥‥。』" voices="akina04300"/>
		<msg @l="311" char_id="-1" frame_id="-1" name=""
		   text="亜季奈は３日溜め込んだ濃い精液を喉奥で受け止める。" voices=""/>
		<msg @l="312" char_id="-1" frame_id="-1" name=""
		   text="固形に近い精液に喉を叩かれる感触に体を振るわせる。" voices=""/>
		<msg @l="313" char_id="-1" frame_id="-1" name=""
		   text="口腔内の精液を舌でかき集め、喉にこびりついたものと一緒に飲み下してゆく。" voices=""/>
		<msg @l="315" char_id="-1" frame_id="-1" name="水泳部の子Ａ"
		   text="『残ってるのもちゃんと吸ってくれるよな？』" voices=""/>
		<msg @l="317" char_id="-1" frame_id="-1" name="水泳部の子Ｂ"
		   text="『そうそう、フェラの後の掃除は基本だぜ。』" voices=""/>
		<msg @l="319" char_id="2" frame_id="-1" name="亜季奈"
		   text="『もぉ、言われなくてもわかってますよーだ。』" voices="akina04310"/>
		<msg @l="321" char_id="2" frame_id="-1" name="亜季奈"
		   text="『あむ‥‥んぐっ‥‥‥ちゅぷ、ちゅぷ‥‥‥ン、ちゅぷぷぷっ。』" voices="akina04320"/>
		<msg @l="323" char_id="-1" frame_id="-1" name=""
		   text="射精を終えてパクパクとしている鈴口に唇を寄せ、精液の残滓を啜り取っていく。" voices=""/>
		<msg @l="324" char_id="-1" frame_id="-1" name="" text="‥‥‥‥‥‥‥" voices=""/>
		<msg @l="325" char_id="-1" frame_id="-1" name="" text="‥‥‥‥‥" voices=""/>
		<msg @l="326" char_id="-1" frame_id="-1" name="" text="‥‥‥" voices=""/>
		<msg @l="327" char_id="-1" frame_id="-1" name="" text="‥" voices=""/>
		<msg @l="329" char_id="-1" frame_id="-1" name=""
		   text="精子を全て吸い終わっても、亜季奈はお替りを求めているかのように、舐めるのを止めない。" voices=""/>
		<msg @l="331" char_id="-1" frame_id="-1" name="水泳部の子Ａ"
		   text="『しっかし、お前ほんとしゃぶるの好きだよな。』" voices=""/>
		<msg @l="333" char_id="-1" frame_id="-1" name="水泳部の子Ｂ"
		   text="『ああ‥‥さすが渡部のペットだな。』" voices=""/>
		<msg @l="335" char_id="2" frame_id="-1" name="亜季奈"
		   text="『ぷあっ‥‥‥違うよ、私はセンセイのペットなんかじゃないよ。』" voices="akina04330"/>
		<msg @l="337" char_id="-1" frame_id="-1" name="水泳部の子Ａ" text="『え‥‥？』"
		   voices=""/>
		<msg @l="339" char_id="2" frame_id="-1" name="亜季奈" text="『だって‥‥。』"
		   voices="akina04340"/>
		<stopbgm @l="343" fadeout="1000"/>
		<clear @l="349" class="all"/>
		<msg @l="351" char_id="2" frame_id="-1" name="亜季奈"
		   text="『だって私は、水泳部みんなのペットなんだもん。』" voices="akina04350"/>
		<msg @l="353" char_id="-1" frame_id="-1" name="" text="もう一回飲ませて貰ったら、部活に行こう。"
		   voices=""/>
		<msg @l="354" char_id="-1" frame_id="-1" name=""
		   text="みんな、亜季奈のお腹をイッパイにしてくれるまで飲ませてくれる。" voices=""/>
		<msg @l="355" char_id="-1" frame_id="-1" name=""
		   text="お口も、アソコも、お尻も、イッパイになって溢れるまで‥‥。" voices=""/>
		<msg @l="357" char_id="-1" frame_id="-1" name=""
		   text="笑う亜季奈の瞳は‥‥至福に満ち溢れていた‥‥‥‥。" voices=""/>
		<clear @l="363" class="all"/>
		<end_scene @l="366"/>
		<eval @l="370" expr="s.flagGallery=1&#13;&#10;"/>
		<eval @l="372" expr="s.event23flag=1&#13;&#10;"/>
		<eval @l="376"
		   expr="f.bEx&#32;=&#32;s.event20flag&#32;&amp;&amp;&#32;s.event23flag&#32;&amp;&amp;&#32;s.event25flag&#32;&amp;&amp;&#32;s.event30flag&#32;&amp;&amp;&#32;s.event31flag&#32;&amp;&amp;&#32;s.event32flag&#32;&amp;&amp;&#32;s.event33flag&#32;&amp;&amp;&#32;s.event35flag&#32;&amp;&amp;&#32;s.event37flag&#32;&amp;&amp;&#32;s.event38flag&#32;&amp;&amp;&#32;s.event60flag&#13;&#10;"/>
		<goto @l="378" cond="!(f.bEx)&#13;&#10;" label="TempLabel_233"/>
		<eval @l="380" expr="s.exRootFlag=1&#13;&#10;"/>
		<label @l="381" id="TempLabel_233"/>
		<ending @l="383"/>
		<goto @l="385" cond="!(f.bEx)&#13;&#10;" label="TempLabel_234"/>
		<wait_chgmv/>
		<bg @l="389" src="newroot"/>
		<wait @l="391" time="5000"/>
		<wait_chgmv/>
		<bg @l="393" src="black"/>
		<label @l="396" id="TempLabel_234"/>
		<return @l="400" value=""/>
	</code>
</xscript>
