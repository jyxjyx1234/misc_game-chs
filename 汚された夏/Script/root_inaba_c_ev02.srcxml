<?xml version="1.0" encoding="utf-8"?>
<xscript>
	<debug editor="&quot;C:\Program&#32;Files&#32;(x86)\sakura\sakura.exe&quot;&#32;&quot;%src%&quot;&#32;-Y=%line%"
	   src="D:\シロップ\町ぐるみの罠＋汚された夏セット版\汚された夏\完成データ\汚された夏\script\text\root_inaba_c_ev02.txt"/>
	<code>
		<label @l="13" id="EventLabel_99"/>
		<label @l="16" id="event_scene39"/>
		<bgm @l="20" src="bgm13" volume="1."/>
		<msg @l="23" char_id="-1" frame_id="-1" name="" text="男たちが一斉に私の身体に圧し掛かってきた。"
		   voices=""/>
		<msg @l="24" char_id="-1" frame_id="-1" name=""
		   text="彼らは服が破かれ剥き出しになった私の乳房を掴み、こねまわし、乳首へ唇を寄せて吸い付いてくる。" voices=""/>
		<msg @l="25" char_id="-1" frame_id="-1" name=""
		   text="そうして‥‥男の一人が先ほど貫かれたばかりの私の秘部へ顔を寄せて太腿や秘部にこびりついた血の跡をこそぎ落とすように舐め始めた。"
		   voices=""/>
		<msg @l="27" char_id="0" frame_id="-1" name="美帆"
		   text="『いやああっ‥‥やだ、やめてくださいっ！』" voices="miho04950"/>
		<msg @l="29" char_id="-1" frame_id="-1" name=""
		   text="私はボロボロになった身体を引きずって懸命に彼らの手から逃れようとする。" voices=""/>
		<msg @l="30" char_id="-1" frame_id="-1" name=""
		   text="けれどそんな私の抵抗などまったく意に介さないがごとく、彼らは私の手足をそれぞれ押さえつけて身動きを封じると‥‥構わず身体中を舐めまわし始めた。"
		   voices=""/>
		<msg @l="32" char_id="-1" frame_id="-1" name="熊野" text="『しっかりと注いでやれよ。』"
		   voices=""/>
		<msg @l="34" char_id="-1" frame_id="-1" name=""
		   text="熊野がそう言うと、秘部を舐めていた男が硬くなった怒張の先端を私へと押し当ててきた。" voices=""/>
		<label @l="38" id="chart_line61"/>
		<wait_chgmv/>
		<ev @l="42" src="ev-039y1"/>
		<description @l="45" text="テニスサークル大輪姦"/>
		<msg @l="47" char_id="0" frame_id="-1" name="美帆" text="『やっ‥‥あ、あああっ！』"
		   voices="miho04960"/>
		<msg @l="49" char_id="-1" frame_id="-1" name=""
		   text="男の先端が割れ目を押し開き、私の中へと侵入してくる。" voices=""/>
		<msg @l="50" char_id="-1" frame_id="-1" name=""
		   text="つい先ほど犯されたばかりの傷を亀頭が擦り上げ、痛みが走る。" voices=""/>
		<msg @l="52" char_id="0" frame_id="-1" name="美帆"
		   text="『んあﾞっ‥‥あっ‥‥‥いやっ、あﾞっ、あぐっっ！』" voices="miho04970"/>
		<msg @l="54" char_id="-1" frame_id="-1" name="男子会員Ａ"
		   text="『はぁ、はぁ、はぁ‥‥‥うお、うおおおっ‥‥‥。』" voices=""/>
		<msg @l="56" char_id="-1" frame_id="-1" name=""
		   text="苦痛の声を漏らす私とは裏腹に‥‥蜜口を貫いている男子会員の彼は獣のように吠えながら恍惚とした表情を浮かべて懸命に腰をたたきつけた。"
		   voices=""/>
		<msg @l="57" char_id="-1" frame_id="-1" name=""
		   text="その度に、先ほど注がれた先輩の精液と私の股間から流れている血が混ざり合ったピンク色の液体が結合部から漏れ出していく。"
		   voices=""/>
		<msg @l="59" char_id="0" frame_id="-1" name="美帆"
		   text="『んっ、あﾞあﾞっ‥‥‥や、あぐっ‥‥‥やめっ‥‥‥‥んんっ！』" voices="miho04980"/>
		<msg @l="61" char_id="-1" frame_id="-1" name=""
		   text="破瓜の傷を擦られる痛みに加えて、潤っていない秘部の敏感な場所を突き上げられた私は苦痛に身体を痙攣させながら身悶える。"
		   voices=""/>
		<msg @l="63" char_id="-1" frame_id="-1" name="男子会員Ｂ" text="『クククク‥‥。』"
		   voices=""/>
		<msg @l="65" char_id="-1" frame_id="-1" name="男子会員Ｃ" text="『ヒヒヒヒヒ‥‥。』"
		   voices=""/>
		<msg @l="67" char_id="-1" frame_id="-1" name="" text="ふと、視界の隅で何かが動いていた。"
		   voices=""/>
		<msg @l="68" char_id="-1" frame_id="-1" name=""
		   text="気になってそちらへ視線をやると、男子会員達が虚ろな表情を浮かべて自分のモノをしごいている。" voices=""/>
		<msg @l="70" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』"
		   voices="miho04990"/>
		<msg @l="72" char_id="-1" frame_id="-1" name=""
		   text="私はしばし圧倒されるようにその様子を眺めていた。" voices=""/>
		<msg @l="73" char_id="-1" frame_id="-1" name=""
		   text="彼らは手馴れた感じで自分の肉塊を握り締め、時折擦るスピードを変えたり握り直したりしながら、硬く屹立した逸物をしごき上げている。"
		   voices=""/>
		<msg @l="74" char_id="-1" frame_id="-1" name=""
		   text="そして‥‥彼らの視線はみな一様に私の局部へ向けられていた。" voices=""/>
		<msg @l="76" char_id="0" frame_id="-1" name="美帆"
		   text="(みんな私のアソコを見て想像してるんだ‥‥‥)" voices="miho05000"/>
		<msg @l="78" char_id="0" frame_id="-1" name="美帆"
		   text="(アソコに入れて‥‥‥ＳＥＸするのを想像してるんだ)" voices="miho05010"/>
		<msg @l="80" char_id="-1" frame_id="-1" name=""
		   text="そんな思いに駆られて、途端に惨めな気持ちになった。" voices=""/>
		<msg @l="81" char_id="-1" frame_id="-1" name=""
		   text="きっと彼らは熊野に利用されているだけなのだろうけれど‥‥。" voices=""/>
		<msg @l="83" char_id="0" frame_id="-1" name="美帆"
		   text="『んっ、んんっ‥‥‥あﾞっ‥‥んぐっ、いっ、あﾞあﾞあﾞっ！！』" voices="miho05020"/>
		<msg @l="85" char_id="-1" frame_id="-1" name=""
		   text="肌と肌が激しくぶつかり合うほど、強く激しく秘部を突き上げられた。" voices=""/>
		<msg @l="86" char_id="-1" frame_id="-1" name=""
		   text="その度に走る痛みに耐えながら私は、それ以外に何か不思議な感覚が身体の奥底から湧いてきているのを感じていた。" voices=""/>
		<msg @l="88" char_id="-1" frame_id="-1" name="男子会員Ａ" text="『‥‥‥‥。』"
		   voices=""/>
		<msg @l="90" char_id="-1" frame_id="-1" name=""
		   text="私の膣内を擦っていた彼が、不意に私の片足を持ち上げ、突き上げる場所を変える。" voices=""/>
		<msg @l="91" char_id="-1" frame_id="-1" name=""
		   text="その瞬間‥‥‥熱い痺れが私の背中を駆け抜けていった。" voices=""/>
		<msg @l="93" char_id="0" frame_id="-1" name="美帆" text="『ああっ‥‥‥ん、んくっっ！？』"
		   voices="miho05030"/>
		<msg @l="95" char_id="-1" frame_id="-1" name=""
		   text="突き上げる場所が変わった事でひと突きごとに‥‥その痺れが徐々に大きく広がっていくのが解る。" voices=""/>
		<msg @l="97" char_id="-1" frame_id="-1" name="熊野"
		   text="『ああ、もう一つ言い忘れてたことがあったな。』" voices=""/>
		<msg @l="99" char_id="-1" frame_id="-1" name="熊野"
		   text="『こいつらの唾液や先走り汁といった体液にも媚薬成分が含まれている。』" voices=""/>
		<msg @l="101" char_id="0" frame_id="-1" name="美帆" text="『なっ‥‥？』"
		   voices="miho05040"/>
		<msg @l="103" char_id="-1" frame_id="-1" name="熊野"
		   text="『つまり、そろそろ催淫効果が効き始めたという事だ。』" voices=""/>
		<msg @l="105" char_id="-1" frame_id="-1" name=""
		   text="私の漏らす声に僅かな熱が含まれ始めたことに気付いたのか、熊野はそう言って楽しげに笑う。" voices=""/>
		<msg @l="106" char_id="-1" frame_id="-1" name="" text="催淫効果‥‥。" voices=""/>
		<msg @l="107" char_id="-1" frame_id="-1" name=""
		   text="私も目の前の男達のようになってしまうということ‥‥‥だろうか。" voices=""/>
		<msg @l="109" char_id="0" frame_id="-1" name="美帆" text="『い、いやっ‥‥‥やめ、あああっ！！』"
		   voices="miho05050"/>
		<msg @l="111" char_id="-1" frame_id="-1" name=""
		   text="私は慌てて胎内に突き入れられた肉棒を引き抜こうとする。" voices=""/>
		<msg @l="112" char_id="-1" frame_id="-1" name=""
		   text="しかし‥‥腰をうちつけられる度に、全身に震えるほどの痺れが襲いソレを抜くことをためらってしまった。" voices=""/>
		<msg @l="114" char_id="0" frame_id="-1" name="美帆" text="『あ、ああああっ！？』"
		   voices="miho05060"/>
		<msg @l="116" char_id="-1" frame_id="-1" name="熊野"
		   text="『ちょっとばかり、気づくのが遅かったみたいだな。』" voices=""/>
		<msg @l="118" char_id="-1" frame_id="-1" name="" text="彼の言う通り、もう‥‥遅かったようだ。"
		   voices=""/>
		<msg @l="119" char_id="-1" frame_id="-1" name=""
		   text="私は、下半身から生まれる甘い熱に飲み込まれそうになっていた。" voices=""/>
		<msg @l="120" char_id="-1" frame_id="-1" name=""
		   text="いつしか痛みはかき消えて、その代わりに視界がフラッシュバックするほどの激しい快楽が広がっては消えていく。" voices=""/>
		<msg @l="122" char_id="0" frame_id="-1" name="美帆"
		   text="『んんっ‥‥あっ‥‥‥ああっ‥‥‥‥ん、あふっ！』" voices="miho05070"/>
		<msg @l="124" char_id="-1" frame_id="-1" name=""
		   text="熱い怒張が私の秘所をグチュグチュと貫くたび、私は腰を震わせてそれを受け止めた。" voices=""/>
		<msg @l="125" char_id="-1" frame_id="-1" name=""
		   text="身体の奥深くからは自然と大量の蜜が溢れ出し‥‥‥淫靡な水音を立てている。" voices=""/>
		<msg @l="127" char_id="-1" frame_id="-1" name="男子会員Ｂ" text="『はぁ、はぁ、はぁ‥‥。』"
		   voices=""/>
		<msg @l="129" char_id="-1" frame_id="-1" name="男子会員Ｃ" text="『ふっ‥‥‥くぅっ‥‥‥。』"
		   voices=""/>
		<msg @l="131" char_id="-1" frame_id="-1" name=""
		   text="白く泡立つ結合部を眺めながら、周囲の男子部員たちも自分のモノをしごく速度を増していった。" voices=""/>
		<msg @l="133" char_id="0" frame_id="-1" name="美帆"
		   text="『あ、ああっ‥‥‥ダメ、こんなのっ‥‥‥あっ、あっ、あああっ！』" voices="miho05080"/>
		<msg @l="135" char_id="0" frame_id="-1" name="美帆"
		   text="『んうっ‥‥ああ、いくっ‥‥‥いく、いくいくいくっっ‥‥‥。』" voices="miho05090"/>
		<msg @l="137" char_id="-1" frame_id="-1" name="男子会員Ａ" text="『く、ああっ‥‥。』"
		   voices=""/>
		<msg @l="139" char_id="-1" frame_id="-1" name="男子会員Ｂ" text="『うっっっ！！』"
		   voices=""/>
		<msg @l="141" char_id="-1" frame_id="-1" name="男子会員Ｃ" text="『ああっ！！』"
		   voices=""/>
		<flash @l="145" count="4" fade="100" image="white"/>
		<wait_chgmv/>
		<ev @l="149" src="ev-039x1y1z1"/>
		<msg @l="151" char_id="0" frame_id="-1" name="美帆" text="『んんんっっ！！！』"
		   voices="miho05100"/>
		<msg @l="153" char_id="-1" frame_id="-1" name=""
		   text="大量の精液が‥‥私の膣内と身体中に撒き散らされた。" voices=""/>
		<msg @l="154" char_id="-1" frame_id="-1" name=""
		   text="白濁色をした欲望のツユが私の顔といわず胸といわずお腹といわず、躰中を白くドロドロに染めあげていった。" voices=""/>
		<msg @l="156" char_id="0" frame_id="-1" name="美帆" text="『んふっ‥‥‥んっ‥‥‥‥‥。』"
		   voices="miho05110"/>
		<msg @l="158" char_id="-1" frame_id="-1" name=""
		   text="私は熱く青臭い液体に全身を汚されながらも、絶頂の愉悦に身体を震わせて熱い吐息を漏らした。" voices=""/>
		<msg @l="159" char_id="-1" frame_id="-1" name="" text="けれど、それで終わりではない。"
		   voices=""/>
		<msg @l="160" char_id="-1" frame_id="-1" name=""
		   text="肌を伝う‥‥そして、躰の奥底に注がれた精液が私の全身に更なる熱を灯して再び甘い快楽の中へと堕としていった。" voices=""/>
		<msg @l="162" char_id="0" frame_id="-1" name="美帆" text="『んんっ‥‥。』"
		   voices="miho05120"/>
		<msg @l="164" char_id="-1" frame_id="-1" name=""
		   text="そうして私は‥‥次のペニスをゆっくりと受け入れる。" voices=""/>
		<clear @l="170" class="all"/>
		<wait_chgmv/>
		<bg @l="173" src="bg14b"/>
		<msg @l="175" char_id="0" frame_id="-1" name="美帆" text="『あ、ああっ‥‥んふぅぅっ‥‥‥。』"
		   voices="miho05130"/>
		<msg @l="177" char_id="-1" frame_id="-1" name="" text="部室の中に美帆の甘い声が響き渡る。"
		   voices=""/>
		<msg @l="178" char_id="-1" frame_id="-1" name=""
		   text="もはや‥‥彼女の中には抵抗心も嫌悪感も生じる事は無かった。" voices=""/>
		<msg @l="179" char_id="-1" frame_id="-1" name=""
		   text="肉の与える快美に酔いしれ‥そして堕ちる―――。" voices=""/>
		<msg @l="180" char_id="-1" frame_id="-1" name="" text="それが彼女の行く末―――であった。"
		   voices=""/>
		<stopbgm @l="184" fadeout="1000"/>
		<clear @l="190" class="all"/>
		<wait @l="192" time="2000"/>
		<end_scene @l="195"/>
		<return @l="198" value=""/>
		<return @l="202" value=""/>
	</code>
</xscript>
