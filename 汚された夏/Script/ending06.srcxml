<?xml version="1.0" encoding="utf-8"?>
<xscript>
	<debug editor="&quot;C:\Program&#32;Files&#32;(x86)\sakura\sakura.exe&quot;&#32;&quot;%src%&quot;&#32;-Y=%line%"
	   src="D:\シロップ\町ぐるみの罠＋汚された夏セット版\汚された夏\完成データ\汚された夏\script\text\ending06.txt"/>
	<code>
		<label @l="12" id="EventLabel_44"/>
		<description @l="16" text="狂ったシステム"/>
		<eval @l="18" expr="f.numDay=0&#13;&#10;"/>
		<wait_chgmv/>
		<bg @l="22" src="bg03a"/>
		<bgm @l="26" src="bgm03" volume="1."/>
		<char @l="30" id="miho" pos="auto" src="miho125"/>
		<msg @l="32" char_id="0" frame_id="-1" name="美帆" text="『‥‥先輩、結局帰って来なかったな。』"
		   voices="miho11580"/>
		<msg @l="34" char_id="-1" frame_id="-1" name="" text="あれから半年が過ぎた。" voices=""/>
		<msg @l="35" char_id="-1" frame_id="-1" name="" text="先輩は一度も家には帰って来なかった。"
		   voices=""/>
		<msg @l="36" char_id="-1" frame_id="-1" name=""
		   text="携帯電話に何度も連絡してみたが、圏外で繋がらなかった。" voices=""/>
		<msg @l="37" char_id="-1" frame_id="-1" name=""
		   text="所属しているサークルに問い合わせても誰も知らないと言われ････。" voices=""/>
		<msg @l="38" char_id="-1" frame_id="-1" name=""
		   text="大学にかけあったが、全単位をとってあるので大学側としては特に問題としない、むしろ卒業前の長期旅行にでも行っているのでしょうと言われる始末だった。"
		   voices=""/>
		<msg @l="39" char_id="-1" frame_id="-1" name=""
		   text="心当たりのある場所には何度も足を運んだがどうしても見つからず、最終的に警察を頼ったのだ。しかし――" voices=""/>
		<msg @l="41" char_id="-1" frame_id="-1" name="警察"
		   text="『この町は仕組み上、行方不明者が出る事はありえません。あなたの勘違いでしょう。』" voices=""/>
		<msg @l="43" char_id="-1" frame_id="-1" name=""
		   text="と、良く分からない理由で門前払いをされてしまったのだった。" voices=""/>
		<msg @l="44" char_id="-1" frame_id="-1" name="" text="‥‥それでも私は玲先輩を探し続けた。"
		   voices=""/>
		<msg @l="45" char_id="-1" frame_id="-1" name=""
		   text="あの時････玲さんと最後に会ったあの時････引き止めていれば････。" voices=""/>
		<msg @l="47" char_id="-1" frame_id="-1" name=""
		   text="自分のことよりも、辛そうな感じだった玲さんの事をもっと考えてあげれば･･。" voices=""/>
		<msg @l="49" char_id="-1" frame_id="-1" name=""
		   text="そしてもしもう一度会う事ができたなら、玲さんにひと言伝えたかった。" voices=""/>
		<msg @l="51" char_id="-1" frame_id="-1" name=""
		   text="“悩み事があったら私に相談してください。････だって私、玲さんのこと家族だと思っていますから････力になりたいんです。”"
		   voices=""/>
		<msg @l="53" char_id="-1" frame_id="-1" name="" text="しかし‥‥叶うことはなかった。"
		   voices=""/>
		<msg @l="55" char_id="0" frame_id="-1" name="美帆" text="『荷物、これが最後‥‥かな。』"
		   voices="miho11590"/>
		<msg @l="57" char_id="-1" frame_id="-1" name=""
		   text="私はずっと愛用していたカバンをソファの上から拾い上げて、つぶやく。" voices=""/>
		<msg @l="58" char_id="-1" frame_id="-1" name=""
		   text="他の荷物はつい先ほど引越し業者の人に運び出してもらったところだ。" voices=""/>
		<msg @l="59" char_id="-1" frame_id="-1" name="" text="私は大学を辞め‥‥実家に戻ることにした。"
		   voices=""/>
		<msg @l="60" char_id="-1" frame_id="-1" name=""
		   text="もうこれ以上玲さんを一人で待ち続ける自信がなかった。" voices=""/>
		<msg @l="61" char_id="-1" frame_id="-1" name=""
		   text="ここにいると毎日玲さんがいなくなったことを思い出して胸が張り裂けそうになる。" voices=""/>
		<msg @l="62" char_id="-1" frame_id="-1" name=""
		   text="一人で抱え込むのがあまりにも辛くなってその事を父に相談したら、知り合いの警察本庁の人間に頼んで捜してくれるから、心配せずに実家に戻って来るように言ってきたのだった。"
		   voices=""/>
		<msg @l="63" char_id="-1" frame_id="-1" name="" text="私は涙を流しながら父の言うとおりにした。"
		   voices=""/>
		<msg @l="64" char_id="-1" frame_id="-1" name=""
		   text="どうして、こんな事になってしまったのだろう････" voices=""/>
		<msg @l="65" char_id="-1" frame_id="-1" name=""
		   text="よく解らないが、全てはこの町が狂っているせいのような気がしたのだった―。" voices=""/>
		<msg @l="67" char_id="-1" frame_id="-1" name="引越し業者"
		   text="『それでは、我々はそろそろ出発しますので。』" voices=""/>
		<char @l="71" id="miho" pos="auto" src="miho025"/>
		<msg @l="73" char_id="0" frame_id="-1" name="美帆" text="『はい‥‥お願いします。』"
		   voices="miho11600"/>
		<msg @l="75" char_id="-1" frame_id="-1" name=""
		   text="私が返事をすると業者の人は荷物を持って、部屋を出て行く。" voices=""/>
		<msg @l="76" char_id="-1" frame_id="-1" name=""
		   text="マンションの下では引越し用のトラックが待機していて、このまま荷物を実家へと送り届けてくれる手筈になっている。" voices=""/>
		<char @l="80" id="miho" pos="auto" src="miho125"/>
		<msg @l="82" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』"
		   voices="miho11610"/>
		<char @l="86" id="miho" pos="auto" src="miho115"/>
		<msg @l="88" char_id="0" frame_id="-1" name="美帆" text="『これ‥‥置いていきますね、先輩。』"
		   voices="miho11620"/>
		<msg @l="90" char_id="-1" frame_id="-1" name=""
		   text="手にしていた愛用のバッグをソファに置き、私も部屋を後にする。" voices=""/>
		<msg @l="91" char_id="-1" frame_id="-1" name=""
		   text="一番大切にしていたバッグ。このバッグを玲さんが見てくれれば、私が玲さんをずっと待っていた気持ちが伝わると思っての事だった。"
		   voices=""/>
		<char @l="95" id="miho" pos="auto" src="miho015"/>
		<msg @l="97" char_id="0" frame_id="-1" name="美帆" text="『‥‥さようなら。』"
		   voices="miho11630"/>
		<clear @l="101" class="char"/>
		<msg @l="103" char_id="-1" frame_id="-1" name=""
		   text="最後にひと言だけつぶやいて、私もまた‥‥部屋を出た。" voices=""/>
		<stopbgm @l="107" fadeout="1000"/>
		<clear @l="113" class="all"/>
		<msgshow @l="116" show="true"/>
		<msg @l="117" char_id="-1" frame_id="-1" name=""
		   text="美帆がこの町を去る際に感じていた不安感――それはあたっていた。" voices=""/>
		<msg @l="118" char_id="-1" frame_id="-1" name=""
		   text="実はこの南総町ではある計画が進められていた‥‥それは、町全体を巨大な性欲処理場に変えるという非道なものだった。" voices=""/>
		<msg @l="119" char_id="-1" frame_id="-1" name=""
		   text="誘致されてきた企業は社員証さえ見せれば無料で性的サービスが受けられるようになり、その見返りに企業は地元に多大な経済効果をもたらすのだ。"
		   voices=""/>
		<msg @l="120" char_id="-1" frame_id="-1" name=""
		   text="既に多数の大企業が進出を決定し、町のあらゆる商店や住宅で女性たちが夜の顔を持つようになっていった‥‥。" voices=""/>
		<msg @l="121" char_id="-1" frame_id="-1" name=""
		   text="そして、玲もこの計画に取り込まれてしまっていたのだ。" voices=""/>
		<msg @l="122" char_id="-1" frame_id="-1" name=""
		   text="しかもこの計画の中心人物の一人だったのが大黒満彦であった為、大黒の復讐により玲はただの夜の顔を持たせられるのではなく、もっと凄惨な役を与えられてしまったのだった――――。"
		   voices=""/>
		<wait_chgmv/>
		<bg @l="126" src="bg17hm1"/>
		<bgm @l="130" src="bgm03" volume="1."/>
		<msg @l="132" char_id="-1" frame_id="-1" name="" text="―――同日・大黒建設オフィス。"
		   voices=""/>
		<msg @l="134" char_id="-1" frame_id="-1" name="男子社員Ａ" text="『ん～、やっと昼休みか。』"
		   voices=""/>
		<msg @l="136" char_id="-1" frame_id="-1" name="男子社員Ａ"
		   text="『昼間は時間が経つのが遅くて嫌になるな。』" voices=""/>
		<msg @l="138" char_id="-1" frame_id="-1" name="男子社員Ｂ"
		   text="『コッチの仕事は退屈だからなぁ‥‥。』" voices=""/>
		<msg @l="140" char_id="-1" frame_id="-1" name="" text="人材派遣部で交わされる普段通りの会話。"
		   voices=""/>
		<msg @l="141" char_id="-1" frame_id="-1" name=""
		   text="昼間の彼らにはどうでもいいような事務作業ばかりが回される為、彼らのやる気も後退していくばかりだった。" voices=""/>
		<msg @l="143" char_id="-1" frame_id="-1" name="男子社員Ａ"
		   text="『こんな時はやっぱ、便所でも行ってさっぱりするか！』" voices=""/>
		<msg @l="145" char_id="-1" frame_id="-1" name="男子社員Ｂ"
		   text="『あー、ダメダメ。便所使いたいなら昼休み入ってすぐ行かねーと、順番待ちしてる間に休みの時間が終わっちまうよ。』" voices=""/>
		<msg @l="147" char_id="-1" frame_id="-1" name="男子社員Ａ"
		   text="『マジかよ‥‥ったく、俺たちの便所なのにな。』" voices=""/>
		<msg @l="149" char_id="-1" frame_id="-1" name=""
		   text="その昼行灯で有名な人材派遣部に、新たな「便所」が出来たことは、既に他部署へも知れ渡っていた。" voices=""/>
		<msg @l="150" char_id="-1" frame_id="-1" name=""
		   text="それ以来、人材派遣部オフィスのある階の男子便所は、昼休みや終業時間後になると人が殺到して、長蛇の列が出来てしまっている。"
		   voices=""/>
		<msg @l="151" char_id="-1" frame_id="-1" name=""
		   text="これもひとえに便器の質が良い為だ‥‥というのが社員の間での評判である。" voices=""/>
		<stopbgm @l="155" fadeout="1000"/>
		<clear @l="161" class="all"/>
		<label @l="164" id="event_scene30"/>
		<msgshow @l="167" show="true"/>
		<msg @l="169" char_id="-1" frame_id="-1" name="男子社員" text="『う、おおおっ！』"
		   voices=""/>
		<msg @l="171" char_id="-1" frame_id="-1" name="" text="男子便所の中に、短い咆哮がこだまする。"
		   voices=""/>
		<msg @l="172" char_id="-1" frame_id="-1" name=""
		   text="それと同時に「便所」を使用していた男の腰がぶるりと震え、便器の中に大量の白濁色をした液体が排泄された。" voices=""/>
		<label @l="176" id="chart_line32"/>
		<wait_chgmv/>
		<ev @l="180" src="ev-030"/>
		<bgm @l="184" src="bgm14" volume="1."/>
		<msg @l="186" char_id="1" frame_id="-1" name="玲" text="『んふぅ‥‥。』"
		   voices="rei02610"/>
		<msg @l="188" char_id="-1" frame_id="-1" name=""
		   text="膣内に大量の精液を排出され、玲がわずかに息を吐く。" voices=""/>
		<msg @l="189" char_id="-1" frame_id="-1" name=""
		   text="トイレの一角に両手両足を縛り付けられて転がされたままで、もう何日も過ごしていた。" voices=""/>
		<msg @l="190" char_id="-1" frame_id="-1" name=""
		   text="「ヒラ社員専用便所」‥‥それが玲に与えられた職種だった。" voices=""/>
		<msg @l="191" char_id="-1" frame_id="-1" name=""
		   text="いかに南総町とはいえ、大企業である大黒グループが相手となると、社員全員の性欲を処理しきれない。" voices=""/>
		<msg @l="192" char_id="-1" frame_id="-1" name=""
		   text="そこで維持費を折半するという形で社内に平社員専用の便所が設置されるようになったのだ。" voices=""/>
		<msg @l="193" char_id="-1" frame_id="-1" name="" text="便所の片隅の分娩台。" voices=""/>
		<msg @l="194" char_id="-1" frame_id="-1" name=""
		   text="妊婦でもない玲が固定され、大きく足を開かされて膣口を晒す。" voices=""/>
		<msg @l="195" char_id="-1" frame_id="-1" name=""
		   text="口にはギャグボールをはめられ、満足に声を出すことも出来ない。" voices=""/>
		<msg @l="196" char_id="-1" frame_id="-1" name=""
		   text="身体には黒いリバイバー（菱形ボンテージ）を装着され、白く艶やかな肌を淫靡に彩る。さらに大量の精液が絡みつき、独特の異臭を放っていた。"
		   voices=""/>
		<msg @l="197" char_id="-1" frame_id="-1" name=""
		   text="終業時間が過ぎ、社員がすべてが帰宅すると、ホースで水を掛けられて便器の清掃が行われる。" voices=""/>
		<msg @l="198" char_id="-1" frame_id="-1" name=""
		   text="それまでは排泄物にまみれたままでいるしかない。" voices=""/>
		<msg @l="200" char_id="-1" frame_id="-1" name=""
		   text="そうやって玲は‥‥‥毎日犯され続けている‥‥‥‥‥‥。" voices=""/>
		<msg @l="202" char_id="-1" frame_id="-1" name="" text="ドクドクドクドクドク" voices=""/>
		<msg @l="204" char_id="-1" frame_id="-1" name="男子社員" text="『‥‥‥ふぅ。』"
		   voices=""/>
		<msg @l="206" char_id="-1" frame_id="-1" name=""
		   text="煮えたぎる大量の白濁液をヒクヒクと震える淫らな蜜壷の中へ放出し、男子社員は満足そうに一息をついた。" voices=""/>
		<msg @l="207" char_id="-1" frame_id="-1" name=""
		   text="するとすぐ後ろに並んでいた男が非難の声をあげる。" voices=""/>
		<msg @l="210" char_id="-1" frame_id="-1" name="ベテラン社員"
		   text="『おいおい、後ろがいるってのに中出しかよ。』" voices=""/>
		<msg @l="212" char_id="-1" frame_id="-1" name="男子社員"
		   text="『別にいーだろ、便器なんだろ。何処に出しても自由じゃんか。』" voices=""/>
		<msg @l="214" char_id="-1" frame_id="-1" name="男子社員Ｅ"
		   text="『ちぇ‥‥今日はザーメンまみれの便器で我慢かよ。おい、次お前の番だぜ、時間無いから早くしろよ。』" voices=""/>
		<msg @l="216" char_id="-1" frame_id="-1" name="新入社員" text="『え、ええ････。』"
		   voices=""/>
		<msg @l="218" char_id="-1" frame_id="-1" name="ベテラン社員"
		   text="『ん、どうした？もしかして見ているだけで出ちゃったか？』" voices=""/>
		<msg @l="220" char_id="-1" frame_id="-1" name="新入社員"
		   text="『ち、違いますよ！なんかこの子････うちの大学にいた女の子に良く似ているんですよねー････。』" voices=""/>
		<msg @l="222" char_id="-1" frame_id="-1" name="ベテラン社員"
		   text="『へー、じゃあもしかするとこの女お前の大学の女かもよ？』" voices=""/>
		<msg @l="223" char_id="-1" frame_id="-1" name="新入社員"
		   text="『そ、それはないっスよー。うちの大学にいた子はミスキャンパスにも選ばれた美女ですよ。そんな子がこんな便所の仕事するわけないっスよ。今頃どっかの金持ちと結婚してるんじゃないっスかねー。』"
		   voices=""/>
		<msg @l="225" char_id="-1" frame_id="-1" name="ベテラン社員"
		   text="『ふーん、まぁ全然知らない女を犯すより知っている女に似たやつを犯す方がもえるからいいんじゃねーの。』" voices=""/>
		<msg @l="227" char_id="-1" frame_id="-1" name="新入社員"
		   text="『そ、そうっスよねー。じゃぁ憧れのミスキャンパス“玲さん”だと思って思いっきり犯させてもらいますよ。』" voices=""/>
		<msg @l="229" char_id="1" frame_id="-1" name="玲" text="『‥‥‥っ‥‥。』"
		   voices="rei02550"/>
		<msg @l="231" char_id="-1" frame_id="-1" name=""
		   text="その言葉を聞いた瞬間、玲は身体をビクッと震わせる。“ミスキャンパス”････その言葉を聞いたのはどのくらい前だっただろうか････。まだ、私が“私”でいられた頃････。しかしそんな考えも新入社員が秘裂を弄る感触ですぐに飛んでしまう。"
		   voices=""/>
		<msg @l="233" char_id="1" frame_id="-1" name="玲" text="『んふぅ‥‥。』"
		   voices="rei02610"/>
		<msg @l="235" char_id="-1" frame_id="-1" name="新入社員"
		   text="『へへっ、じゃぁキツイ一発をお見舞いしてやるからね。心して受け入れろよ、この便所女！』" voices=""/>
		<msg @l="237" char_id="-1" frame_id="-1" name=""
		   text="そう言いながら、凶悪な肉幹を玲の秘部にあてがう。それは毒々しいまでに鉛色をした肉の傘が猛り狂う程開いていて、ミミズのような太い血管を浮かべていた。"
		   voices=""/>
		<msg @l="238" char_id="-1" frame_id="-1" name=""
		   text="新入社員はググっと体重を乗せると、ピンクの秘裂の唇を割ってドス黒い肉棒を飲み込ませていった。" voices=""/>
		<msg @l="240" char_id="1" frame_id="-1" name="玲" text="『‥‥‥ぁっ‥‥。』"
		   voices="rei02590"/>
		<msg @l="242" char_id="-1" frame_id="-1" name=""
		   text="太い男根が胎内を行き来するたび、肉ヒダを引き摺られるような激しい摩擦感が玲の身体を襲い、脳をピリピリと襲撃してくる。"
		   voices=""/>
		<msg @l="244" char_id="1" frame_id="-1" name="玲" text="『んっ‥‥んぅぅっ‥‥‥。』"
		   voices="rei02620"/>
		<msg @l="246" char_id="-1" frame_id="-1" name="新入社員"
		   text="『なんだこの便器女のマン○、ガバガバじゃん。やっぱりあの“玲さん”とはぜってー違うな。』" voices=""/>
		<msg @l="248" char_id="-1" frame_id="-1" name=""
		   text="腰を激しくグラインドさせながら玲をなじる新入社員。だが玲には、その言葉は既に届かなくなっていた。" voices=""/>
		<msg @l="249" char_id="-1" frame_id="-1" name=""
		   text="ぶちゅぶちゅと下品な水音を立てながら、玲の秘部からは先ほどの男が排泄した白濁色の液体が溢れ出してくる。" voices=""/>
		<msg @l="251" char_id="1" frame_id="-1" name="玲"
		   text="『あぁぁ‥‥あっ‥‥‥んぁぁっ‥‥‥‥。』" voices="rei02630"/>
		<msg @l="253" char_id="-1" frame_id="-1" name=""
		   text="くぐもった声で喘ぎながら、玲はそのしなだれた身体を時折ヒクつかせる。" voices=""/>
		<msg @l="254" char_id="-1" frame_id="-1" name=""
		   text="その度に男根を咥え込んだ「便器」がきゅうっと締めつけ、排泄行為により一層の加速を掛けている。" voices=""/>
		<msg @l="255" char_id="-1" frame_id="-1" name="" text="無意識の奉仕‥‥とでもいうべきだろうか。"
		   voices=""/>
		<msg @l="257" char_id="-1" frame_id="-1" name="ベテラン社員"
		   text="『おい、いつまでかかってるんだよ。早くしてくれないと時間が足りなくなるぜ。』" voices=""/>
		<msg @l="259" char_id="-1" frame_id="-1" name="新入社員" text="『わ、わかってまスって。』"
		   voices=""/>
		<msg @l="261" char_id="-1" frame_id="-1" name=""
		   text="公共の便器である為、その使用には常に迅速さが要求される。" voices=""/>
		<msg @l="262" char_id="-1" frame_id="-1" name=""
		   text="何せ、一時間しかない昼休みに三十人からの人間が押し寄せるのだ。" voices=""/>
		<msg @l="263" char_id="-1" frame_id="-1" name=""
		   text="一人が二分で排泄したとしても、やっと全員にまわるかどうかの人数である。" voices=""/>
		<msg @l="265" char_id="-1" frame_id="-1" name="ベテラン社員"
		   text="『あー、もういい、自分でしごかせてもらうぜ。』" voices=""/>
		<msg @l="267" char_id="-1" frame_id="-1" name="男子社員Ａ"
		   text="『俺も‥‥出せずに昼休みが終わったら、午後の仕事が手につかなくなっちまうからな。』" voices=""/>
		<msg @l="269" char_id="-1" frame_id="-1" name=""
		   text="時間切れを予感した男たちが次々に男子便所の中に押し入っては、便器に向かってそれぞれの肉棒をしごきたてる。" voices=""/>
		<msg @l="271" char_id="1" frame_id="-1" name="玲" text="『んぅ‥‥‥あふぅ‥‥‥‥。』"
		   voices="rei02640"/>
		<msg @l="273" char_id="-1" frame_id="-1" name=""
		   text="玲はぼんやりとその光景を眺め、甘く喉を鳴らす。" voices=""/>
		<msg @l="274" char_id="-1" frame_id="-1" name=""
		   text="それが放たれる精液に対する期待の声なのか、それとも自らの身体を使わずして排泄してくれる男たちに対する喜びのモノかはわからない。"
		   voices=""/>
		<msg @l="275" char_id="-1" frame_id="-1" name=""
		   text="ただ、その甘い声が男たちの排泄感をより高めたことだけは確かである。" voices=""/>
		<msg @l="277" char_id="-1" frame_id="-1" name="ベテラン社員" text="『い、いくぞっ！』"
		   voices=""/>
		<msg @l="279" char_id="-1" frame_id="-1" name="男子社員Ａ"
		   text="『こっちも、顔にかけてやるからな。』" voices=""/>
		<msg @l="281" char_id="-1" frame_id="-1" name="新入社員"
		   text="『お、俺も出るっス！！中にたっぷりと注ぎ込んでやるっス！』" voices=""/>
		<flash @l="285" count="4" fade="100" image="white"/>
		<wait_chgmv/>
		<ev @l="289" src="ev-030z1"/>
		<msg @l="291" char_id="1" frame_id="-1" name="玲" text="『んんっ‥‥ん、んふぅ‥‥‥。』"
		   voices="rei02650"/>
		<msg @l="293" char_id="-1" frame_id="-1" name=""
		   text="一斉に、白濁色の排泄物が玲の身体をドロドロに汚していく。" voices=""/>
		<msg @l="294" char_id="-1" frame_id="-1" name=""
		   text="そして何回目か数える事も出来ない大量のザーメンを淫らな蜜壷に注ぎ込まれた。" voices=""/>
		<msg @l="295" char_id="-1" frame_id="-1" name=""
		   text="玲は身体をわずかにけいれんさせてそれを受け止め、熱い吐息を漏らす。すると秘裂から、ゴポッという音と共に蜜壷に収まりきらない精液が逆流してきたのだった。"
		   voices=""/>
		<msg @l="297" char_id="-1" frame_id="-1" name="新入社員"
		   text="『ふぃー、すっきりしたっス。でもやっぱり近くで見れば見るほど似てるんですよねー、この便所女。』" voices=""/>
		<msg @l="299" char_id="-1" frame_id="-1" name="ベテラン社員"
		   text="『くそっ‥‥お前はいいよなー。ミスキャンパスに似た女と犯れたから興奮もしたし満足だろうけどよ。････明日はもっと早く来なくちゃダメだな。』"
		   voices=""/>
		<msg @l="300" char_id="-1" frame_id="-1" name="新入社員"
		   text="『す、すいません。今度はもっと早く射しますんで。』" voices=""/>
		<msg @l="302" char_id="-1" frame_id="-1" name="ベテラン社員"
		   text="『頼むぜ、若いの。それから今度は人気のない便所に行けよ。お前まだ新人なんだからよ。』" voices=""/>
		<msg @l="304" char_id="-1" frame_id="-1" name="新入社員"
		   text="『わ、分かりましたって。････あっ、そういやさっき聞いたんスけど、課長なんかケーキ屋のお姉ちゃんに毎晩ヌイて貰ってるって言ってたっスよ‥‥うらやましいっスねー。』"
		   voices=""/>
		<msg @l="306" char_id="-1" frame_id="-1" name="ベテラン社員"
		   text="『あの子がねぇ‥‥、まだ小さい時から知ってるけど凄く可愛いんだよなー。こっちに回ってくる事はねぇからな････。まあ俺達のような下っ端は便器で我慢してろって事だな。』"
		   voices=""/>
		<msg @l="308" char_id="-1" frame_id="-1" name=""
		   text="便器に放った男たちは口々につぶやきながらその場所を後にする。" voices=""/>
		<msg @l="309" char_id="-1" frame_id="-1" name="" text="誰一人として便器に気づかう者はいない。"
		   voices=""/>
		<msg @l="310" char_id="-1" frame_id="-1" name=""
		   text="それが‥‥今の玲にとって、最高の愉悦だということを知っているから。" voices=""/>
		<stopbgm @l="314" fadeout="1000"/>
		<clear @l="320" class="all"/>
		<end_scene @l="323"/>
		<eval @l="327" expr="s.flagGallery=1&#13;&#10;"/>
		<eval @l="329" expr="s.event30flag=1&#13;&#10;"/>
		<eval @l="333"
		   expr="f.bEx&#32;=&#32;s.event20flag&#32;&amp;&amp;&#32;s.event23flag&#32;&amp;&amp;&#32;s.event25flag&#32;&amp;&amp;&#32;s.event30flag&#32;&amp;&amp;&#32;s.event31flag&#32;&amp;&amp;&#32;s.event32flag&#32;&amp;&amp;&#32;s.event33flag&#32;&amp;&amp;&#32;s.event35flag&#32;&amp;&amp;&#32;s.event37flag&#32;&amp;&amp;&#32;s.event38flag&#32;&amp;&amp;&#32;s.event60flag&#13;&#10;"/>
		<goto @l="335" cond="!(f.bEx)&#13;&#10;" label="TempLabel_243"/>
		<eval @l="337" expr="s.exRootFlag=1&#13;&#10;"/>
		<label @l="338" id="TempLabel_243"/>
		<ending @l="340"/>
		<goto @l="342" cond="!(f.bEx)&#13;&#10;" label="TempLabel_244"/>
		<wait_chgmv/>
		<bg @l="346" src="newroot"/>
		<wait @l="348" time="5000"/>
		<wait_chgmv/>
		<bg @l="350" src="black"/>
		<label @l="353" id="TempLabel_244"/>
		<return @l="357" value=""/>
	</code>
</xscript>
