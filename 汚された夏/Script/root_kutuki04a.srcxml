<?xml version="1.0" encoding="utf-8"?>
<xscript>
	<debug editor="&quot;C:\Program&#32;Files&#32;(x86)\sakura\sakura.exe&quot;&#32;&quot;%src%&quot;&#32;-Y=%line%"
	   src="D:\シロップ\町ぐるみの罠＋汚された夏セット版\汚された夏\完成データ\汚された夏\script\text\root_kutuki04a.txt"/>
	<code>
		<label @l="10" id="EventLabel_123"/>
		<description @l="14" text="朽木の奴隷・３日目"/>
		<eval @l="16" expr="f.numDay=9&#13;&#10;"/>
		<msgshow @l="18" show="false"/>
		<wait_chgmv/>
		<bg @l="20" src="day09" time="2000"/>
		<wait @l="22" time="500"/>
		<wait_chgmv/>
		<bg @l="24" src="black" time="2000"/>
		<msgshow @l="26" show="true"/>
		<wait_chgmv/>
		<bg @l="29" src="bg08m1"/>
		<bgm @l="32" src="bgm02" volume="1."/>
		<msg @l="34" char_id="-1" frame_id="-1" name="朽木"
		   text="『では、これから先週行ったテストを返却する。』" voices=""/>
		<msg @l="36" char_id="-1" frame_id="-1" name=""
		   text="静かな講堂に、朽木教授のどこか高圧的な声が響き渡る。" voices=""/>
		<msg @l="37" char_id="-1" frame_id="-1" name=""
		   text="彼の受け持つ考古学が‥‥本日最後の講義だった。" voices=""/>
		<msg @l="39" char_id="-1" frame_id="-1" name="朽木"
		   text="『名前を呼ばれた者から前へ取りに来ること。』" voices=""/>
		<msg @l="41" char_id="-1" frame_id="-1" name="学生Ａ" text="『ういーす。』" voices=""/>
		<msg @l="43" char_id="-1" frame_id="-1" name="学生Ｂ" text="『あー‥‥悪夢だ、悪夢の到来だ。』"
		   voices=""/>
		<msg @l="45" char_id="-1" frame_id="-1" name="学生Ｃ"
		   text="『‥‥嘘、先週テストなんてやったのかよ。』" voices=""/>
		<msg @l="47" char_id="-1" frame_id="-1" name="" text="教室のあちこちで様々な言葉が漏らされる。"
		   voices=""/>
		<msg @l="49" char_id="0" frame_id="-1" name="美帆"
		   text="(そういえば私、テスト受けてないんだっけ‥‥)" voices=""/>
		<msg @l="51" char_id="-1" frame_id="-1" name=""
		   text="教壇に立つ朽木教授の姿を見ながら、私はそんなことを考えていた。" voices=""/>
		<msg @l="52" char_id="-1" frame_id="-1" name=""
		   text="テストのあったあの時、私は彼の足元にある教壇の裏側にこもっていた。" voices=""/>
		<msg @l="53" char_id="-1" frame_id="-1" name=""
		   text="皆が普通にテストを受けているその時に‥‥私は。" voices=""/>
		<msg @l="55" char_id="0" frame_id="-1" name="美帆"
		   text="(考えるのは止そう‥‥そんな事思い出しても何にもならないよね)" voices=""/>
		<msg @l="57" char_id="-1" frame_id="-1" name="朽木" text="『北原。』" voices=""/>
		<msg @l="59" char_id="-1" frame_id="-1" name="北原" text="『はーい。』" voices=""/>
		<msg @l="61" char_id="-1" frame_id="-1" name=""
		   text="一人また一人と、テスト用紙を返却していく朽木教授。" voices=""/>
		<stopbgm @l="64" fadeout="1000"/>
		<msg @l="66" char_id="0" frame_id="-1" name="美帆" text="(あれ‥‥？)" voices=""/>
		<msg @l="68" char_id="-1" frame_id="-1" name=""
		   text="ふと、私はテスト用紙を返却している朽木教授が時折その用紙を受け取りに来た学生へ何か耳打のようなことをしている事に気付く。"
		   voices=""/>
		<msg @l="69" char_id="-1" frame_id="-1" name=""
		   text="それも決まって、テストの結果が良い人たちに対して‥‥である。" voices=""/>
		<msg @l="71" char_id="0" frame_id="-1" name="美帆" text="(なに‥‥してるんだろう？)"
		   voices=""/>
		<msg @l="73" char_id="-1" frame_id="-1" name=""
		   text="その後も、数人に一人の割合で教授は耳打のような事をしていた。" voices=""/>
		<msg @l="74" char_id="-1" frame_id="-1" name=""
		   text="しかもよくよく見ていると、相手はみな男子ばかりだ。" voices=""/>
		<msg @l="76" char_id="0" frame_id="-1" name="美帆" text="(激励してるわけじゃ‥‥ないよね)"
		   voices=""/>
		<msg @l="78" char_id="0" frame_id="-1" name="美帆"
		   text="(仮に激励するんだったらテストが悪かった人にするだろうし)" voices=""/>
		<msg @l="80" char_id="0" frame_id="-1" name="美帆"
		   text="(だとすると‥‥点数の良かった人を褒めてるのかな？)" voices=""/>
		<msg @l="82" char_id="-1" frame_id="-1" name="朽木" text="『仲根。』" voices=""/>
		<msg @l="84" char_id="0" frame_id="-1" name="美帆"
		   text="(今回のテスト、女の子はみんな点数が悪かったのかな‥‥)" voices=""/>
		<msg @l="86" char_id="-1" frame_id="-1" name="朽木"
		   text="『仲根美帆クン、今日は欠席しているのかね？』" voices=""/>
		<char @l="89" id="miho" pos="auto" src="miho114"/>
		<msg @l="91" char_id="0" frame_id="-1" name="美帆" text="『え‥‥あ、はいっ！？』"
		   voices=""/>
		<msg @l="93" char_id="-1" frame_id="-1" name=""
		   text="教授が自分の名前を呼んでいることに気付き、私は慌てて立ち上がる。" voices=""/>
		<msg @l="95" char_id="-1" frame_id="-1" name="朽木"
		   text="『早くテスト用紙を受け取りに来たまえ。』" voices=""/>
		<msg @l="97" char_id="0" frame_id="-1" name="美帆" text="『は、はいっ。』" voices=""/>
		<clear @l="100" class="char"/>
		<bgm @l="103" src="bgm03" volume="1."/>
		<msg @l="105" char_id="0" frame_id="-1" name="美帆"
		   text="(私‥‥テスト受けてないのに‥‥‥‥‥なんで？)" voices=""/>
		<msg @l="107" char_id="-1" frame_id="-1" name=""
		   text="内心そう思いながらも、口に出して言うわけにもいかず‥‥‥私は慌てて教壇前へ駆け寄る。" voices=""/>
		<msg @l="109" char_id="-1" frame_id="-1" name="朽木" text="『受け取りたまえ。』"
		   voices=""/>
		<msg @l="111" char_id="-1" frame_id="-1" name=""
		   text="教壇の前に立つと、無愛想にそう言って教授がテスト用紙を手渡す。" voices=""/>
		<msg @l="113" char_id="0" frame_id="-1" name="美帆" text="(え‥‥満点？)" voices=""/>
		<msg @l="115" char_id="-1" frame_id="-1" name=""
		   text="渡されたテスト用紙にはきちんと答えが書き込まれていて、ご丁寧に私の名前まで明記されている。" voices=""/>
		<msg @l="116" char_id="-1" frame_id="-1" name=""
		   text="ただ‥‥その字は明らかに私のモノじゃない。" voices=""/>
		<msg @l="118" char_id="-1" frame_id="-1" name="朽木" text="『これが、キミの奉仕への評価だ。』"
		   voices=""/>
		<msg @l="120" char_id="0" frame_id="-1" name="美帆" text="『あ‥‥。』" voices=""/>
		<msg @l="122" char_id="-1" frame_id="-1" name=""
		   text="つまりそれは、先週のテストの最中に私が教壇裏で行っていた、口での奉仕の事を指して言っているのだろう。" voices=""/>
		<bgm @l="125" src="bgm09" volume="1."/>
		<msg @l="127" char_id="-1" frame_id="-1" name="朽木"
		   text="『それから‥‥‥この時間が終わったら私の部屋へ来たまえ。』" voices=""/>
		<msg @l="129" char_id="-1" frame_id="-1" name="朽木"
		   text="『素晴らしい余興をキミの為に用意している。』" voices=""/>
		<msg @l="131" char_id="0" frame_id="-1" name="美帆" text="『‥‥！？』" voices=""/>
		<msg @l="133" char_id="-1" frame_id="-1" name=""
		   text="耳元に囁かれた言葉に、私は思わず血の気が引いた。" voices=""/>
		<msg @l="134" char_id="-1" frame_id="-1" name=""
		   text="まさかこんな場所で、それも口頭でそんな事を言われるとは思わなかった。" voices=""/>
		<msg @l="136" char_id="-1" frame_id="-1" name="朽木" text="『返事はどうした。』"
		   voices=""/>
		<msg @l="138" char_id="0" frame_id="-1" name="美帆" text="『わ‥‥わかりました。』"
		   voices=""/>
		<msg @l="140" char_id="-1" frame_id="-1" name="朽木" text="『よろしい。では席に戻りたまえ。』"
		   voices=""/>
		<msg @l="142" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<clear @l="145" class="all"/>
		<msg @l="147" char_id="-1" frame_id="-1" name="朽木" text="『野村。』" voices=""/>
		<msg @l="149" char_id="-1" frame_id="-1" name=""
		   text="踵を返して自分の席へ戻っていく私の背後から、次の学生を呼ぶ教授の声が響く。" voices=""/>
		<msg @l="150" char_id="-1" frame_id="-1" name="" text="けれど私の耳にそれは届いてはおらず‥‥。"
		   voices=""/>
		<msg @l="151" char_id="-1" frame_id="-1" name=""
		   text="周囲の人々に先ほどのやり取りを聞かれてはいないかということばかりに気をとられていた。" voices=""/>
		<msg @l="153" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="155" char_id="-1" frame_id="-1" name="" text="だから、私は気付かなかった。"
		   voices=""/>
		<msg @l="156" char_id="-1" frame_id="-1" name=""
		   text="私の次に訪れた、テスト結果が優良であった男子の耳元へ「講義が終わったら教授室へ来たまえ」と彼が囁きかけていた事を。"
		   voices=""/>
		<stopbgm @l="159" fadeout="1000"/>
		<clear @l="162" class="all"/>
		<msgshow @l="164" show="true"/>
		<wait_chgmv/>
		<bg @l="167" src="bg09"/>
		<bgm @l="170" src="bgm03" volume="1."/>
		<char @l="173" id="miho" pos="auto" src="miho116"/>
		<msg @l="175" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="177" char_id="-1" frame_id="-1" name="" text="講義が終わってから二十分ほど経った頃。"
		   voices=""/>
		<msg @l="178" char_id="-1" frame_id="-1" name=""
		   text="私は廊下脇に備え付けられたベンチに座って、教授室を訪れるタイミングを伺っていた。" voices=""/>
		<msg @l="179" char_id="-1" frame_id="-1" name=""
		   text="人通りの激しい中、彼の教授室を訪れるのは気が進まなかった。" voices=""/>
		<msg @l="181" char_id="0" frame_id="-1" name="美帆"
		   text="(それにしても‥‥さっきの、一体何だったんだろう)" voices=""/>
		<msg @l="183" char_id="-1" frame_id="-1" name=""
		   text="私を呼び出すならばメールで充分なハズなのに、わざわざ誰かに聞かれるかもしれないというあの場で、何故耳打ちをしたんだろう。"
		   voices=""/>
		<msg @l="185" char_id="0" frame_id="-1" name="美帆" text="(いやがらせ‥‥とか？)"
		   voices=""/>
		<msg @l="187" char_id="-1" frame_id="-1" name="" text="その可能性は十二分に考えられる。"
		   voices=""/>
		<msg @l="188" char_id="-1" frame_id="-1" name=""
		   text="彼は、自分の楽しみの為ならば多少のリスクなど無関係に遂行するだろう。" voices=""/>
		<msg @l="189" char_id="-1" frame_id="-1" name=""
		   text="というよりむしろ、そうでもなければ痴漢行為に手を染めたりしないハズだ。" voices=""/>
		<msg @l="191" char_id="0" frame_id="-1" name="美帆"
		   text="(あ、そういえば私以外の人にも耳打してたっけ‥‥)" voices=""/>
		<msg @l="193" char_id="0" frame_id="-1" name="美帆"
		   text="(でも、私以外はみんな男の子だったし‥‥‥関係ないのかな)" voices=""/>
		<msg @l="195" char_id="0" frame_id="-1" name="美帆"
		   text="(まさか‥‥他の人を呼んだりなんてことは、ないだろうし)" voices=""/>
		<msg @l="197" char_id="-1" frame_id="-1" name=""
		   text="そんなことを考ながら‥‥自販機で買ったミルクティに口をつける。" voices=""/>
		<msg @l="199" char_id="0" frame_id="-1" name="美帆"
		   text="(そろそろ人も少なくなってきたし‥‥いいかな)" voices=""/>
		<msg @l="201" char_id="-1" frame_id="-1" name=""
		   text="缶を自販機横のゴミ箱に捨てて、私は教授室に向かって歩く。" voices=""/>
		<msg @l="202" char_id="-1" frame_id="-1" name=""
		   text="その先に‥‥大きな絶望が待っているとも知らずに。" voices=""/>
		<clear @l="205" class="all"/>
		<wait_chgmv/>
		<bg @l="208" src="bg12"/>
		<bgm @l="211" src="bgm15" volume="1."/>
		<char @l="214" id="miho" pos="auto" src="miho015"/>
		<msg @l="216" char_id="0" frame_id="-1" name="美帆" text="『これは‥‥どういうことですか。』"
		   voices=""/>
		<clear @l="219" class="char"/>
		<char @l="221" id="miho" pos="right" src="miho015"/>
		<char @l="223" id="kutsu" pos="left" src="kutsu010"/>
		<msg @l="225" char_id="-1" frame_id="-1" name="朽木"
		   text="『言っただろう、素晴らしい余興を用意していると。』" voices=""/>
		<msg @l="227" char_id="-1" frame_id="-1" name="朽木" text="『これがその余興だよ。』"
		   voices=""/>
		<msg @l="229" char_id="-1" frame_id="-1" name=""
		   text="そう言って、教授は部屋の壁際に並んだ男子学生たちを見る。" voices=""/>
		<msg @l="230" char_id="-1" frame_id="-1" name=""
		   text="先ほどの講義で‥‥教授が耳打ちをしていた人たちだ。" voices=""/>
		<msg @l="231" char_id="-1" frame_id="-1" name=""
		   text="みな、どこか不思議そうな表情で私と教授のやり取りを見ている。" voices=""/>
		<msg @l="232" char_id="-1" frame_id="-1" name="" text="事情を聞かされていないのだろう。"
		   voices=""/>
		<char @l="235" id="miho" pos="right" src="miho115"/>
		<msg @l="237" char_id="0" frame_id="-1" name="美帆" text="『余興ってそんなっ！』"
		   voices=""/>
		<msg @l="239" char_id="-1" frame_id="-1" name="朽木" text="『仲根クン‥‥。』"
		   voices=""/>
		<msg @l="241" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<clear @l="244" layer="kutsu"/>
		<char @l="246" id="kutsu" pos="auto" src="kutsu018"/>
		<msg @l="248" char_id="-1" frame_id="-1" name="朽木"
		   text="『キミは私の言う通りにしていれば良い、そうだろう？』" voices=""/>
		<msg @l="250" char_id="0" frame_id="-1" name="美帆" text="『‥‥はい。』" voices=""/>
		<msg @l="252" char_id="-1" frame_id="-1" name="朽木" text="『では大人しく言う通りにしたまえ。』"
		   voices=""/>
		<msg @l="254" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<char @l="258" id="kutsu" pos="auto" src="kutsu010"/>
		<msg @l="260" char_id="-1" frame_id="-1" name="朽木"
		   text="『さて‥‥諸君、お待たせして申し訳ない。』" voices=""/>
		<msg @l="262" char_id="-1" frame_id="-1" name="朽木"
		   text="『今日キミたちをここへ招いたのは他でもない、成績優秀者であるキミたちに「褒賞」を与える為だ。』" voices=""/>
		<msg @l="264" char_id="-1" frame_id="-1" name="学生Ａ" text="『褒賞‥‥ですか？』"
		   voices=""/>
		<msg @l="266" char_id="-1" frame_id="-1" name="学生Ｂ" text="『金一封とか？』"
		   voices=""/>
		<msg @l="268" char_id="-1" frame_id="-1" name="学生Ｃ"
		   text="『どうせノートとボールペンだって。』" voices=""/>
		<msg @l="270" char_id="-1" frame_id="-1" name="学生Ｄ" text="『ま、そんなもんかもね。』"
		   voices=""/>
		<msg @l="272" char_id="-1" frame_id="-1" name="朽木"
		   text="『くくっ、キミたちが思っているよりもずっと素晴らしい褒賞だよ。』" voices=""/>
		<msg @l="274" char_id="-1" frame_id="-1" name="朽木" text="『仲根クン。』" voices=""/>
		<clear @l="277" class="char"/>
		<char @l="279" id="kutsu" pos="auto" src="kutsu010"/>
		<char @l="281" id="miho" pos="right" src="miho015"/>
		<msg @l="283" char_id="0" frame_id="-1" name="美帆" text="『‥‥はい。』" voices=""/>
		<msg @l="285" char_id="-1" frame_id="-1" name="朽木"
		   text="『服を脱いでそこの机にうつぶせになりたまえ。』" voices=""/>
		<msg @l="287" char_id="0" frame_id="-1" name="美帆" text="『わかり‥‥ました。』"
		   voices=""/>
		<clear @l="290" layer="miho"/>
		<msg @l="292" char_id="-1" frame_id="-1" name="学生Ａ" text="『え‥‥？』" voices=""/>
		<msg @l="294" char_id="-1" frame_id="-1" name=""
		   text="男子たちが教授の言葉に驚きどよめいているのを横目に、私は彼の命じるままに服を脱いでいく。" voices=""/>
		<char @l="297" id="kutsu" pos="auto" src="kutsu018"/>
		<char @l="299" id="miho" pos="right" src="miho185"/>
		<msg @l="301" char_id="0" frame_id="-1" name="美帆" text="『これでいいですか‥‥？』"
		   voices=""/>
		<msg @l="303" char_id="-1" frame_id="-1" name="朽木" text="『下着も全部だ。』"
		   voices=""/>
		<msg @l="305" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥はい‥‥。』"
		   voices=""/>
		<clear @l="308" layer="miho"/>
		<msg @l="310" char_id="-1" frame_id="-1" name="学生Ｂ" text="『‥‥‥‥。』" voices=""/>
		<msg @l="312" char_id="-1" frame_id="-1" name="学生Ｃ" text="『‥‥‥‥。』" voices=""/>
		<msg @l="314" char_id="-1" frame_id="-1" name=""
		   text="私の指がブラジャーのホックに掛かると、男子学生の何人かがゴクリと喉を鳴らしながら胸を凝視する。" voices=""/>
		<msg @l="316" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="318" char_id="-1" frame_id="-1" name=""
		   text="その痛いほどの視線を浴びながら‥‥私はそれをゆっくりと外していく。" voices=""/>
		<msg @l="320" char_id="-1" frame_id="-1" name="学生Ｂ" text="『おおっ！』" voices=""/>
		<msg @l="322" char_id="-1" frame_id="-1" name="学生Ｃ" text="『すげ‥‥ほんとに脱いじまった。』"
		   voices=""/>
		<msg @l="324" char_id="-1" frame_id="-1" name="" text="小さく、歓喜の声があがる。"
		   voices=""/>
		<msg @l="325" char_id="-1" frame_id="-1" name=""
		   text="私は思わずその場から逃げ出したい衝動に駆られるが、教授の視線がそれをも許してくれない。" voices=""/>
		<msg @l="327" char_id="0" frame_id="-1" name="美帆" text="『‥‥っ‥。』" voices=""/>
		<msg @l="329" char_id="-1" frame_id="-1" name=""
		   text="私は覚悟を決めたように、一気にショーツを下ろし‥‥脱ぎ捨てる。" voices=""/>
		<msg @l="330" char_id="-1" frame_id="-1" name=""
		   text="そして、のろのろと机の上にうつぶせに横たわった。" voices=""/>
		<msg @l="331" char_id="-1" frame_id="-1" name="" text="ここまで来て‥‥後戻りなんて許されない。"
		   voices=""/>
		<char @l="334" id="miho" pos="right" src="miho105"/>
		<char @l="336" id="kutsu" pos="auto" src="kutsu010"/>
		<msg @l="338" char_id="-1" frame_id="-1" name="朽木"
		   text="『これが私からの褒賞だ、彼女の事を好きに犯してくれたまえ。』" voices=""/>
		<msg @l="340" char_id="-1" frame_id="-1" name="学生Ａ"
		   text="『犯すって‥‥‥ほ、ほんとに‥‥‥‥。』" voices=""/>
		<msg @l="342" char_id="-1" frame_id="-1" name="学生Ｂ" text="『い、いいんですかっ！？』"
		   voices=""/>
		<msg @l="344" char_id="-1" frame_id="-1" name="学生Ｃ" text="『なんかの企画とか‥‥‥ですか？』"
		   voices=""/>
		<msg @l="346" char_id="-1" frame_id="-1" name="朽木"
		   text="『言っただろう、これはキミたちに対する褒賞だ。』" voices=""/>
		<msg @l="348" char_id="-1" frame_id="-1" name="朽木"
		   text="『何も心配する事無く‥‥好きに貪って良いのだよ。』" voices=""/>
		<msg @l="350" char_id="-1" frame_id="-1" name="学生Ｄ" text="『で、でも‥‥。』"
		   voices=""/>
		<msg @l="352" char_id="-1" frame_id="-1" name="学生Ｅ" text="『そんなこと言われてもな‥‥。』"
		   voices=""/>
		<msg @l="354" char_id="-1" frame_id="-1" name=""
		   text="ざわざわとどよめくだけで、学生達は一向にその場から動こうとしない。" voices=""/>
		<msg @l="355" char_id="-1" frame_id="-1" name=""
		   text="みな‥‥いま一歩という所でためらっているようだ。" voices=""/>
		<msg @l="357" char_id="-1" frame_id="-1" name="朽木"
		   text="『よかろう。キミたちの猜疑心も解らぬでもないからな。』" voices=""/>
		<msg @l="359" char_id="-1" frame_id="-1" name="朽木"
		   text="『ならばここはひとつ‥‥仲根クン、キミの口からお願いしたらどうかな。』" voices=""/>
		<char @l="362" id="miho" pos="right" src="miho104"/>
		<msg @l="364" char_id="0" frame_id="-1" name="美帆" text="『え‥‥。』" voices=""/>
		<msg @l="366" char_id="-1" frame_id="-1" name=""
		   text="全てを成り行きに任せてしまおうと半ば諦めていたのに、突然そんな事を言われて困惑する。" voices=""/>
		<msg @l="368" char_id="-1" frame_id="-1" name="朽木"
		   text="『どうした、キミには彼らの努力に対する、ねぎらいの気持ちというモノはないのかね？』" voices=""/>
		<msg @l="370" char_id="-1" frame_id="-1" name="朽木"
		   text="『さあ、キミのお口とおま○こを使って奉仕してあげなさい。』" voices=""/>
		<char @l="373" id="miho" pos="right" src="miho005"/>
		<msg @l="375" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="377" char_id="-1" frame_id="-1" name="" text="教授の視線が私を追い詰める。"
		   voices=""/>
		<msg @l="378" char_id="-1" frame_id="-1" name="" text="拒絶という選択はない。"
		   voices=""/>
		<msg @l="379" char_id="-1" frame_id="-1" name=""
		   text="私はもう‥‥彼の言うままにするしかないのだ。" voices=""/>
		<clear @l="382" class="all"/>
		<msg @l="384" char_id="0" frame_id="-1" name="美帆"
		   text="『み、みなさん‥‥‥私のお口とおま○こを、好きに使って‥‥‥‥ください。』" voices=""/>
		<msg @l="386" char_id="0" frame_id="-1" name="美帆"
		   text="『‥‥‥‥私の身体で‥‥‥気持ち良くなって‥‥‥‥‥。』" voices=""/>
		<msg @l="388" char_id="-1" frame_id="-1" name="学生Ａ" text="『ほ、本気なんだ‥‥。』"
		   voices=""/>
		<msg @l="390" char_id="-1" frame_id="-1" name="学生Ｂ" text="『仲根があー言ってるんだしな？』"
		   voices=""/>
		<msg @l="392" char_id="-1" frame_id="-1" name="学生Ｃ" text="『犯らなくちゃ損‥‥だよな？』"
		   voices=""/>
		<msg @l="394" char_id="-1" frame_id="-1" name=""
		   text="私の言葉を皮切りにして、男子達を押し留めていたためらいという枷が外れていく。" voices=""/>
		<msg @l="395" char_id="-1" frame_id="-1" name="" text="もう、止められない。" voices=""/>
		<msg @l="396" char_id="-1" frame_id="-1" name="" text="もう‥‥戻れない。" voices=""/>
		<msg @l="398" char_id="-1" frame_id="-1" name="朽木"
		   text="『と、その前に仲根クンにはこれを‥‥。』" voices=""/>
		<msg @l="400" char_id="-1" frame_id="-1" name=""
		   text="そう言って彼はうつぶせに横たわっていた私の両手を背中で拘束する。" voices=""/>
		<msg @l="402" char_id="0" frame_id="-1" name="美帆" text="『うあっ‥‥。』" voices=""/>
		<msg @l="404" char_id="0" frame_id="-1" name="美帆" text="(また‥‥こんな‥‥‥‥)"
		   voices=""/>
		<msg @l="406" char_id="-1" frame_id="-1" name="朽木"
		   text="『さて、後はキミたちの好きにしたまえ。』" voices=""/>
		<msg @l="408" char_id="-1" frame_id="-1" name="朽木" text="『ただし‥‥中出しは厳禁だ。』"
		   voices=""/>
		<msg @l="410" char_id="-1" frame_id="-1" name="学生たち" text="『はいっ！』" voices=""/>
		<msg @l="412" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<clear @l="415" class="all"/>
		<label @l="418" id="event_scene13"/>
		<msgshow @l="421" show="true"/>
		<label @l="424" id="chart_line51"/>
		<wait_chgmv/>
		<ev @l="427" src="ev-013y1"/>
		<description @l="430" text="ご褒美奉仕"/>
		<bgm @l="433" src="bgm14" volume="1."/>
		<msg @l="435" char_id="-1" frame_id="-1" name="学生Ａ"
		   text="『え、えっと‥‥じゃあ僕から‥‥‥。』" voices=""/>
		<msg @l="437" char_id="-1" frame_id="-1" name=""
		   text="内気そうな男の子が、そう言って私の背中に圧し掛かるようにして胸を揉みしだいてくる。" voices=""/>
		<msg @l="438" char_id="-1" frame_id="-1" name=""
		   text="背中に荒い息が吐きかけられる。私が全裸の上に拘束され、机に横たわっているのを見ているだけで、その男の子はすっかり興奮しているようだ。"
		   voices=""/>
		<msg @l="440" char_id="-1" frame_id="-1" name="学生Ａ"
		   text="『すっすごい柔らかいよ。きっ気持ち良い？ねえっ気持ち良いかい？』" voices=""/>
		<msg @l="441" char_id="-1" frame_id="-1" name=""
		   text="興奮して舞い上がっているらしく、乱暴に胸をグニョグニョと強く揉んでくる。その力があまりに強くて、水風船のような胸が破裂しそうな鈍い痛みを感じる。"
		   voices=""/>
		<msg @l="442" char_id="-1" frame_id="-1" name=""
		   text="それでもお構いなしに乳房を揉みたくられる。二つの膨らみが掻き回される。" voices=""/>
		<msg @l="443" char_id="-1" frame_id="-1" name=""
		   text="つい先日まで平和な日常の一部だったはずの、教授室。朽木教授とほんの少し言葉を交わしたことのある男の子数名に、今、私は視姦されながら、獣のように興奮した男の子に凌辱されている。"
		   voices=""/>
		<msg @l="444" char_id="-1" frame_id="-1" name=""
		   text="その状況と、白磁色の胸に加えられる強い刺激で、思わずめまいを感じる。" voices=""/>
		<msg @l="445" char_id="-1" frame_id="-1" name="" text="何もかもから逃げたくなる。"
		   voices=""/>
		<msg @l="446" char_id="-1" frame_id="-1" name=""
		   text="身体にほんの少しだけ残っていた抵抗力も、徐々に弱まっていった。" voices=""/>
		<msg @l="448" char_id="0" frame_id="-1" name="美帆" text="『んぁ‥‥んんっ‥‥‥。』"
		   voices="miho08410"/>
		<msg @l="450" char_id="-1" frame_id="-1" name=""
		   text="鼻息を荒くした男の子はツンと上を向く乳首に目をやった。" voices=""/>
		<msg @l="451" char_id="-1" frame_id="-1" name=""
		   text="興奮して熱くなった指がピンクのさくらんぼのような乳首を探り当て、ひねりあげる。私は思わず声を漏らしてしまう。" voices=""/>
		<msg @l="452" char_id="-1" frame_id="-1" name=""
		   text="意思とは裏腹に、グミのような柔らかさだった乳首は固く尖っていく。" voices=""/>
		<msg @l="454" char_id="-1" frame_id="-1" name="学生Ｂ"
		   text="『すげえ‥‥こいつ、マジで感じてるんじゃないか？』" voices=""/>
		<msg @l="456" char_id="-1" frame_id="-1" name="学生Ｃ"
		   text="『あんな事言うくらいだからな、淫乱なんだろ。』" voices=""/>
		<msg @l="458" char_id="-1" frame_id="-1" name="学生Ｄ"
		   text="『俺、マジもんの淫乱って初めて見たー。』" voices=""/>
		<msg @l="460" char_id="-1" frame_id="-1" name="学生Ａ"
		   text="『乳首がすっごい固くなってるよ、僕の手で感じてるのかい？僕の手は気持ち良いんだね！』" voices=""/>
		<msg @l="462" char_id="0" frame_id="-1" name="美帆" text="『んっ‥‥。』"
		   voices="miho08420"/>
		<msg @l="464" char_id="-1" frame_id="-1" name=""
		   text="男子達が漏らす言葉に絶望を覚えながら‥‥現実から目を逸らすように、背中へ圧し掛かっている学生の愛撫に身を任せる。" voices=""/>
		<msg @l="465" char_id="-1" frame_id="-1" name=""
		   text="頭の中を支配するものが、次第に甘いものに代わっていく‥‥。私の身体はこんな責めにあっていながら、感じていた。" voices=""/>
		<msg @l="467" char_id="-1" frame_id="-1" name="学生Ａ"
		   text="『女の子の肌ってっこんなにスベスベしているんだね。すごいよっ！』" voices=""/>
		<msg @l="469" char_id="-1" frame_id="-1" name="学生Ｃ" text="『オメー、童貞だろ？』"
		   voices=""/>
		<msg @l="471" char_id="-1" frame_id="-1" name=""
		   text="私の乳首を捏ねくる男の子の言動をからかうようにまわりの男子達がゲラゲラ笑う。その嘲笑の中、私は辱めを受け続ける。" voices=""/>
		<msg @l="474" char_id="-1" frame_id="-1" name="学生Ａ"
		   text="『み、見たいよ。仲根さんのおま○こ‥‥。見てみたいよ‥‥。』" voices=""/>
		<msg @l="476" char_id="-1" frame_id="-1" name=""
		   text="男の子は卑猥な言葉を発しながら、オモチャを買ってもらえない子供のように駄々をこねるような仕草をする。" voices=""/>
		<msg @l="478" char_id="-1" frame_id="-1" name="学生Ｄ"
		   text="『はやく、見てみろよー。すげー、ピンク色だぜ。』" voices=""/>
		<msg @l="480" char_id="-1" frame_id="-1" name="" text="別の男子がけしかける。"
		   voices=""/>
		<msg @l="481" char_id="-1" frame_id="-1" name=""
		   text="私は一瞬、脚を閉じようとするが男の子の腕力は強く、こんもり膨らむ秘密の丘を凝視される。" voices=""/>
		<msg @l="483" char_id="0" frame_id="-1" name="美帆" text="『あ、ああっ‥‥。』"
		   voices="miho10130"/>
		<msg @l="485" char_id="-1" frame_id="-1" name="学生Ａ"
		   text="『す、すごいっ！仲根さんのおま○この匂いがプンプン香ってくる‥‥。』" voices=""/>
		<msg @l="487" char_id="-1" frame_id="-1" name=""
		   text="男の子は鼻を鳴らし恍惚感に浸っていた。私は恥ずかしい場所を見られ、彼が鼻を鳴らすたび身体が火照り、身体の芯が溶けていくようであった。"
		   voices=""/>
		<msg @l="488" char_id="-1" frame_id="-1" name=""
		   text="そして、秘裂を指で擦り、一番過敏な部分をはぞりあげた。" voices=""/>
		<msg @l="490" char_id="0" frame_id="-1" name="美帆" text="『んっ、んっ‥‥‥あっ、んくっっ！』"
		   voices="miho10150"/>
		<msg @l="492" char_id="-1" frame_id="-1" name=""
		   text="私は抑えがたい欲情が次から次へと湧き出し、淫らに下半身が躍動する。その光景は男の子の獣欲に火をつけた。" voices=""/>
		<msg @l="495" char_id="-1" frame_id="-1" name="学生Ａ"
		   text="『もっもう僕我慢出来ないよ‥‥。え、えっと‥‥‥入れて‥‥‥‥‥いいかな。』" voices=""/>
		<msg @l="497" char_id="-1" frame_id="-1" name="朽木" text="『‥‥‥‥。』" voices=""/>
		<msg @l="499" char_id="-1" frame_id="-1" name=""
		   text="誰に聞くでもなく内気そうな彼が言うと、代弁者のように朽木教授が頷く。" voices=""/>
		<msg @l="500" char_id="-1" frame_id="-1" name=""
		   text="そして教授の許諾を得た彼もまた、まるでそれが自分の意志であるかのように満足げな表情をして私の膣内へ硬化した若い肉棒を一気に突き入れてくる。"
		   voices=""/>
		<msg @l="502" char_id="0" frame_id="-1" name="美帆" text="『ん、ああっ‥‥。』"
		   voices="miho08430"/>
		<msg @l="504" char_id="-1" frame_id="-1" name=""
		   text="挿入の瞬間、押し割られた割れ目の奥から大量の蜜がグチュリと溢れ出す。" voices=""/>
		<msg @l="505" char_id="-1" frame_id="-1" name=""
		   text="私の身体は‥‥こんな風に大勢に晒されているというのに、グチュグチュに濡れてしまっていた‥‥‥。" voices=""/>
		<msg @l="507" char_id="-1" frame_id="-1" name="学生Ａ"
		   text="『す、すごい‥‥ぐちょぐちょだ。うっ‥うぁぁっ。きっ気持ち良いよっ！』" voices=""/>
		<msg @l="509" char_id="-1" frame_id="-1" name="学生Ｃ" text="『そんだけ、好きモンってワケだ。』"
		   voices=""/>
		<msg @l="511" char_id="-1" frame_id="-1" name="学生Ｅ"
		   text="『よーするに、遠慮は要らないってことだよな？』" voices=""/>
		<msg @l="513" char_id="-1" frame_id="-1" name="" text="揶揄か、それとも歓喜か。"
		   voices=""/>
		<msg @l="514" char_id="-1" frame_id="-1" name=""
		   text="どちらにせよ周囲の男子たちの言葉は私という存在を堕としていく。" voices=""/>
		<msg @l="516" char_id="-1" frame_id="-1" name="朽木" text="『‥‥‥‥。』" voices=""/>
		<msg @l="518" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』"
		   voices="miho08440"/>
		<msg @l="520" char_id="-1" frame_id="-1" name="" text="教授と目があった。" voices=""/>
		<msg @l="521" char_id="-1" frame_id="-1" name="" text="彼は、満足げに口元を歪ませている。"
		   voices=""/>
		<msg @l="523" char_id="0" frame_id="-1" name="美帆" text="『んんっ‥‥あ、ああっ‥‥‥‥。』"
		   voices="miho08450"/>
		<msg @l="525" char_id="-1" frame_id="-1" name=""
		   text="私の上に圧し掛かった彼が自分勝手に腰を使うたび、硬くなった先端が私の奥深くを掻き混ぜて子宮の痺れを誘う。" voices=""/>
		<msg @l="526" char_id="-1" frame_id="-1" name=""
		   text="上半身を責めている手も、休みなく胸を揉み続ける。" voices=""/>
		<msg @l="527" char_id="-1" frame_id="-1" name=""
		   text="もう彼は狂ったように私の身体を貪ってくる。" voices=""/>
		<msg @l="529" char_id="-1" frame_id="-1" name="学生Ａ"
		   text="『うわ、うわ、すごい‥‥‥吸い付いてくるよっ！？』" voices=""/>
		<msg @l="531" char_id="-1" frame_id="-1" name="" text="本当にまだ童貞だったのだろう。"
		   voices=""/>
		<msg @l="532" char_id="-1" frame_id="-1" name=""
		   text="彼は私の胎内の肉ヒダの感触を楽しみながら、歓喜の声をあげている。" voices=""/>
		<msg @l="534" char_id="-1" frame_id="-1" name="朽木"
		   text="『それは仲根クンが感じている証拠だ。もっと感じさせれば、そのぶん、陰部の具合も良くなってくる。』" voices=""/>
		<msg @l="536" char_id="-1" frame_id="-1" name="学生Ａ"
		   text="『か、感じてるんだっ‥‥僕のモノで感じてるんだっ！？』" voices=""/>
		<msg @l="538" char_id="0" frame_id="-1" name="美帆" text="『あ、んああっ‥‥‥ん、んんっ！』"
		   voices="miho08460"/>
		<msg @l="540" char_id="-1" frame_id="-1" name=""
		   text="更に激しく亀頭で子宮をノックされ、私は思わず腰をピクピクと震わせる。" voices=""/>
		<msg @l="541" char_id="-1" frame_id="-1" name=""
		   text="腰の動かし方、先端の擦り上げる場所、律動の激しさ。" voices=""/>
		<msg @l="542" char_id="-1" frame_id="-1" name=""
		   text="そのどれもが朽木教授とは違っていて‥‥私は異なる快感を覚えてしまう。" voices=""/>
		<msg @l="543" char_id="-1" frame_id="-1" name=""
		   text="‥‥もう、意識は快楽で塗り潰されている‥‥。" voices=""/>
		<msg @l="545" char_id="0" frame_id="-1" name="美帆" text="(ダメ‥‥なんか、すごい‥‥‥‥)"
		   voices="miho08470"/>
		<msg @l="547" char_id="0" frame_id="-1" name="美帆"
		   text="(こんなの‥‥‥‥あ、もうっ‥‥‥‥‥！？)" voices="miho08480"/>
		<msg @l="549" char_id="0" frame_id="-1" name="美帆"
		   text="んんっ、んっ、あっ‥‥‥んんんんんっ！！" voices="miho08490"/>
		<msg @l="551" char_id="-1" frame_id="-1" name=""
		   text="びくり、びくりと私の子宮で肉ヒダがうごめく。" voices=""/>
		<msg @l="552" char_id="-1" frame_id="-1" name=""
		   text="頭の芯が蕩けるような痺れが‥‥一気に広がり、意識が飛ぶ。" voices=""/>
		<msg @l="554" char_id="-1" frame_id="-1" name="学生Ａ"
		   text="『うあっ‥‥なんか、急に中が締め付けてきたっ。』" voices=""/>
		<msg @l="556" char_id="-1" frame_id="-1" name="朽木"
		   text="『おや、仲根クンはもう達してしまったようだな。』" voices=""/>
		<msg @l="558" char_id="-1" frame_id="-1" name="学生Ａ" text="『え‥‥もうイっちゃったの？』"
		   voices=""/>
		<msg @l="560" char_id="0" frame_id="-1" name="美帆"
		   text="『んんっ‥‥はっ‥‥はっ‥‥‥‥‥ん、ああっ‥‥‥‥。』" voices="miho08500"/>
		<msg @l="562" char_id="-1" frame_id="-1" name=""
		   text="絶頂の余韻に、私は目を潤ませながら荒い息を吐く。" voices=""/>
		<msg @l="564" char_id="-1" frame_id="-1" name="学生Ａ"
		   text="『僕‥‥まだ出してないんだけど‥‥‥。』" voices=""/>
		<msg @l="566" char_id="-1" frame_id="-1" name="朽木"
		   text="『構う事は無い。そのまま続けたまえ。』" voices=""/>
		<msg @l="568" char_id="0" frame_id="-1" name="美帆"
		   text="『え、ちょっと待ってください、少し休ませて‥‥‥‥んああっ！』" voices="miho08510"/>
		<msg @l="570" char_id="-1" frame_id="-1" name=""
		   text="私の言葉を聞こうともせず、再び収縮する蜜壺を肉柱が擦り始める。" voices=""/>
		<msg @l="571" char_id="-1" frame_id="-1" name=""
		   text="達した為に、より敏感になっていた膣壁をゴリゴリと肉棒が擦り上げると、また絶頂の波がおしよせ甘い痺れを呼ぶ。" voices=""/>
		<msg @l="573" char_id="0" frame_id="-1" name="美帆"
		   text="『い、ああっ‥‥あっ‥‥あっ‥‥‥‥んっ、あふっ！！』" voices="miho08520"/>
		<msg @l="575" char_id="-1" frame_id="-1" name=""
		   text="絶頂に達したことで大量に蜜が溢れ出したのか、律動のたびにぐちゅぐちゅという淫靡な音が響き渡っていた。" voices=""/>
		<msg @l="577" char_id="-1" frame_id="-1" name="学生Ａ"
		   text="『あ、ああっ‥‥ぼく‥‥‥僕もそろそろ‥‥‥‥。』" voices=""/>
		<msg @l="579" char_id="-1" frame_id="-1" name="学生Ｂ"
		   text="『おい、どーせ中に出せねーんだし、みんな同じ場所にぶっかけようぜ。』" voices=""/>
		<msg @l="581" char_id="-1" frame_id="-1" name=""
		   text="いきなり顔のすぐ横から聞こえた声に、はっとなり、そちらに目をやる。" voices=""/>
		<msg @l="582" char_id="-1" frame_id="-1" name=""
		   text="すると他の男子たちも、我慢出来ずに、それぞれが自分のモノを手でしごき始めていた。" voices=""/>
		<msg @l="584" char_id="-1" frame_id="-1" name="学生Ｃ"
		   text="『オマエ、ぶっかけモノ好きだもんなー。』" voices=""/>
		<msg @l="586" char_id="-1" frame_id="-1" name="学生Ｂ"
		   text="『うっせぇ‥‥それより、どこにぶっかけたいよ？』" voices=""/>
		<msg @l="588" char_id="-1" frame_id="-1" name="学生Ｅ" text="『やっぱ顔だろ。』"
		   voices=""/>
		<msg @l="590" char_id="-1" frame_id="-1" name="学生Ｄ"
		   text="『いや、背中の上ってのもアリじゃね？』" voices=""/>
		<msg @l="592" char_id="-1" frame_id="-1" name="学生Ｃ" text="『‥‥渋いな。』"
		   voices=""/>
		<msg @l="594" char_id="-1" frame_id="-1" name="学生Ｄ" text="『いいだろ、好きなんだから。』"
		   voices=""/>
		<msg @l="596" char_id="-1" frame_id="-1" name="学生Ｂ" text="『オマエはどっちがいいよ？』"
		   voices=""/>
		<msg @l="598" char_id="-1" frame_id="-1" name="学生Ａ" text="『え‥‥ぼ、ぼく‥‥‥？』"
		   voices=""/>
		<msg @l="600" char_id="-1" frame_id="-1" name="学生Ｂ"
		   text="『ま、一番手はオマエだし、オマエ決めちまえ。』" voices=""/>
		<msg @l="602" char_id="-1" frame_id="-1" name="学生Ａ" text="『え、えっと‥‥僕は‥‥‥。』"
		   voices=""/>
		<msg @l="605" async="true" char_id="-1" frame_id="-1" name=""
		   text="どこに出す‥‥？" voices=""/>
		<select @l="606">
			<menu @l="609" label="TempLabel_191" text="顔に"/>
			<menu @l="611" label="TempLabel_193" text="背中に"/>
		</select>
		<goto @l="615" label="TempLabel_192"/>
		<label @l="617" id="TempLabel_191"/>
		<eval @l="619" expr="f.ご褒美奉仕flag&#32;=&#32;1&#13;&#10;"/>
		<goto @l="620" label="TempLabel_192"/>
		<label @l="622" id="TempLabel_193"/>
		<eval @l="624" expr="f.ご褒美奉仕flag&#32;=&#32;2&#13;&#10;"/>
		<goto @l="625" label="TempLabel_192"/>
		<label @l="627" id="TempLabel_192"/>
		<label @l="630" id="EventLabel_124"/>
		<goto @l="633" cond="!(f.ご褒美奉仕flag&#32;==&#32;1)&#13;&#10;"
		   label="TempLabel_194"/>
		<msg @l="635" char_id="-1" frame_id="-1" name="学生Ａ" text="『じゃ、じゃあ顔に‥‥。』"
		   voices=""/>
		<msg @l="637" char_id="-1" frame_id="-1" name="学生Ｂ"
		   text="『うし。んじゃみんなで顔ドロドロにしてやろーぜ。』" voices=""/>
		<msg @l="639" char_id="-1" frame_id="-1" name="学生Ｅ" text="『とーぜんだろ。』"
		   voices=""/>
		<msg @l="641" char_id="-1" frame_id="-1" name="学生Ｄ"
		   text="『ま、そういうことなら顔でもいいや。』" voices=""/>
		<msg @l="643" char_id="-1" frame_id="-1" name="学生Ｃ"
		   text="『‥‥どっちでもいいんじゃねーかよ。』" voices=""/>
		<wait_chgmv/>
		<ev @l="646" src="ev-013y1y2"/>
		<msg @l="648" char_id="-1" frame_id="-1" name=""
		   text="激しく下半身を責めていたものが引き抜かれる。" voices=""/>
		<msg @l="649" char_id="-1" frame_id="-1" name=""
		   text="ぐったりとした私の前に皆の性器が並び、一斉に、強く、それぞれの手でしごき始めた。" voices=""/>
		<msg @l="651" char_id="-1" frame_id="-1" name="学生Ａ"
		   text="『そ、それじゃ‥‥‥いくよ、いくよっ！！』" voices=""/>
		<msg @l="653" char_id="0" frame_id="-1" name="美帆"
		   text="『んっ、んっ、んっ‥‥あっ、んくっ‥‥‥‥‥あ、ああっ！』" voices="miho08530"/>
		<msg @l="655" char_id="-1" frame_id="-1" name="学生Ａ" text="『んんっ！』" voices=""/>
		<flash @l="658" count="4" fade="100" image="white"/>
		<wait_chgmv/>
		<ev @l="661" src="ev-013x2y2z1z2"/>
		<msg @l="663" char_id="0" frame_id="-1" name="美帆" text="『んっ‥‥。』"
		   voices="miho08540"/>
		<msg @l="665" char_id="-1" frame_id="-1" name=""
		   text="顔から胸にかけて、大量の精液が撒き散らされる。" voices=""/>
		<msg @l="666" char_id="-1" frame_id="-1" name=""
		   text="勢いあまって、結局身体中に白いものが吐きかけられる。" voices=""/>
		<msg @l="667" char_id="-1" frame_id="-1" name="" text="熱い精液が頬を流れて落ちていく‥‥。"
		   voices=""/>
		<msg @l="669" char_id="-1" frame_id="-1" name="学生Ａ"
		   text="『はぁ、はぁ‥‥‥ごめん‥‥いっぱい出ちゃった。』" voices=""/>
		<msg @l="671" char_id="-1" frame_id="-1" name="学生Ｂ"
		   text="『んっ、んぁっ。こっ、こっちも出るぜ！』" voices=""/>
		<msg @l="673" char_id="-1" frame_id="-1" name="学生Ｃ" text="『おっ、おぉぅっ、お、俺もっ！！』"
		   voices=""/>
		<flash @l="676" count="4" fade="100" image="white"/>
		<wait_chgmv/>
		<ev @l="678" src="ev-013x2y2z4z5"/>
		<msg @l="680" char_id="-1" frame_id="-1" name="" text="次々に精液が顔へと吐き出される。"
		   voices=""/>
		<msg @l="681" char_id="-1" frame_id="-1" name=""
		   text="粘性のねっとりとしたものが身体を伝い落ちていく。" voices=""/>
		<msg @l="682" char_id="-1" frame_id="-1" name=""
		   text="降り注いでいた熱い雨がやみ、ゆっくりと目を開ける。" voices=""/>
		<msg @l="683" char_id="-1" frame_id="-1" name=""
		   text="周りに目を配ると、それぞれの男根を握った男たちが、いやらしい笑みを浮かべていた。" voices=""/>
		<msg @l="684" char_id="-1" frame_id="-1" name=""
		   text="どの肉棒も萎える様子は無く、むしろ精液にまみれた私を見て更に興奮しているかのようだった‥‥。" voices=""/>
		<msg @l="685" char_id="-1" frame_id="-1" name="" text="朽木教授が隅でにたにたと笑っている。"
		   voices=""/>
		<msg @l="686" char_id="-1" frame_id="-1" name="" text="逃げたい。" voices=""/>
		<msg @l="687" char_id="-1" frame_id="-1" name=""
		   text="しかし私は拘束されていて、自由に動くことすらままならない。" voices=""/>
		<msg @l="688" char_id="-1" frame_id="-1" name=""
		   text="そんな私の気持ちを知ってか知らずか、男たちは出したばかりだというのに、欲望の捌け口を求めて下半身へと殺到する。" voices=""/>
		<msg @l="690" char_id="-1" frame_id="-1" name="学生Ｂ" text="『さっさと次、いかせてもらうぜ。』"
		   voices=""/>
		<msg @l="692" char_id="-1" frame_id="-1" name="学生Ｃ" text="『おう。』" voices=""/>
		<clear @l="695" class="all"/>
		<wait_chgmv/>
		<ev @l="698" src="ev-013x2y3z1z2z3"/>
		<msg @l="700" char_id="0" frame_id="-1" name="美帆" text="『あ、んうっ‥‥。』"
		   voices="miho08560"/>
		<msg @l="702" char_id="-1" frame_id="-1" name="" text="再び、私の秘裂に男根が突き入れられる。"
		   voices=""/>
		<msg @l="703" char_id="-1" frame_id="-1" name=""
		   text="先ほど貫いていたモノよりも今度の肉棒はより大きくて、入り口を押し広げられる感触に私は思わず身体をわななかせた。" voices=""/>
		<msg @l="704" char_id="-1" frame_id="-1" name=""
		   text="意識は再び下半身から湧き上がる悦楽に塗り潰されていく‥‥。" voices=""/>
		<msg @l="706" char_id="-1" frame_id="-1" name="学生Ｂ" text="『すっすげ‥‥結構締まるな。』"
		   voices=""/>
		<msg @l="708" char_id="0" frame_id="-1" name="美帆"
		   text="『んっ、ああっ‥‥‥すご‥‥‥‥‥おっきくて、あああっ！！』" voices="miho08570"/>
		<msg @l="709" char_id="-1" frame_id="-1" name="学生Ｂ"
		   text="『おう、コイツにはちょっと自信あるぜ。』" voices=""/>
		<msg @l="711" char_id="-1" frame_id="-1" name=""
		   text="二人目の彼はそう言って腰を強く突き出して、奥深くまで肉塊を押し込む。" voices=""/>
		<msg @l="712" char_id="-1" frame_id="-1" name=""
		   text="今までよりもはるかに強い刺激が身体の奥に広がっていく。" voices=""/>
		<msg @l="713" char_id="-1" frame_id="-1" name=""
		   text="もう声を我慢することも出来ない。勝手に口があえぎ声を発している。" voices=""/>
		<msg @l="715" char_id="0" frame_id="-1" name="美帆"
		   text="『んあっ、あっ、あっ‥‥‥ダメ、おくっ‥‥‥‥ああっ！！』" voices="miho08580"/>
		<msg @l="717" char_id="-1" frame_id="-1" name="学生Ｂ"
		   text="『へへっ‥‥喜んでもらえて光栄だね。』" voices=""/>
		<msg @l="719" char_id="-1" frame_id="-1" name="学生Ｂ"
		   text="『こっちも、たっぷりと愉しませてもらうからなー。』" voices=""/>
		<msg @l="721" char_id="0" frame_id="-1" name="美帆"
		   text="『あっ‥‥んっ、んんっ‥‥‥‥ああっ‥‥‥‥‥。』" voices="miho08590"/>
		<msg @l="723" char_id="-1" frame_id="-1" name=""
		   text="深く、浅く、私の胎内を押し広げながら肉棒が行き来する。" voices=""/>
		<msg @l="724" char_id="-1" frame_id="-1" name=""
		   text="太い欲望を受け入れるたびに私の奥底からは大量の蜜が滲み、押し出されるように結合部からグチュグチュと溢れ出していく。"
		   voices=""/>
		<msg @l="726" char_id="-1" frame_id="-1" name="学生Ｄ" text="『あー、俺、もう我慢できねーわ。』"
		   voices=""/>
		<msg @l="728" char_id="-1" frame_id="-1" name=""
		   text="順番待ちをしていた学生の一人がそう言うと、硬くいきり勃った陰茎を私の顔の前に突きつけてしごき始めた。" voices=""/>
		<msg @l="730" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』"
		   voices="miho08600"/>
		<msg @l="732" char_id="0" frame_id="-1" name="美帆"
		   text="(すごい‥‥あんなに大きくなって‥‥‥‥‥)" voices="miho08610"/>
		<msg @l="734" char_id="-1" frame_id="-1" name="学生Ｃ"
		   text="『なんだよ、堪え性の無いやつだな。』" voices=""/>
		<msg @l="736" char_id="-1" frame_id="-1" name="学生Ｂ"
		   text="『ま、何でもありって方向でやろーや。』" voices=""/>
		<msg @l="738" char_id="-1" frame_id="-1" name="学生Ｄ"
		   text="『おう。言われなくてもそうするつもりだ。』" voices=""/>
		<msg @l="740" char_id="0" frame_id="-1" name="美帆"
		   text="『んんっ‥‥んっ、んんっ‥‥‥あふっ‥‥‥‥ああっ‥‥‥‥。』" voices="miho08620"/>
		<msg @l="742" char_id="-1" frame_id="-1" name=""
		   text="私もまた、彼らの向ける欲望に絡め取られるように熱い吐息を漏らす。" voices=""/>
		<msg @l="743" char_id="-1" frame_id="-1" name=""
		   text="この部屋を支配している空気に飲み込まれようとしている。" voices=""/>
		<msg @l="744" char_id="-1" frame_id="-1" name="" text="‥‥、‥‥もう‥‥どうでも良い‥‥。"
		   voices=""/>
		<msg @l="746" char_id="0" frame_id="-1" name="美帆"
		   text="『んふぅっ‥‥あっ、ああっ‥‥‥‥‥ん、ちゅろっ。』" voices="miho08630"/>
		<msg @l="748" char_id="-1" frame_id="-1" name="学生Ｄ" text="『うおっ！？』" voices=""/>
		<msg @l="750" char_id="-1" frame_id="-1" name=""
		   text="私は眼前でしごきたてられている肉塊の先端に舌を伸ばし、舐め上げる。" voices=""/>
		<msg @l="751" char_id="-1" frame_id="-1" name=""
		   text="その瞬間、自分のモノをしごいていた彼は腰を小刻みに震わせる。" voices=""/>
		<msg @l="753" char_id="-1" frame_id="-1" name="学生Ｄ"
		   text="『も、もう一回‥‥今のやってくれよ。』" voices=""/>
		<msg @l="755" char_id="0" frame_id="-1" name="美帆"
		   text="『んんっ‥‥‥んっ‥‥‥‥‥あふ、んっ‥‥‥‥ちゅろっ。』" voices="miho08640"/>
		<msg @l="757" char_id="-1" frame_id="-1" name="学生Ｄ"
		   text="『いいぜっ‥‥‥すげ、気持ち良いわ。』" voices=""/>
		<msg @l="759" char_id="-1" frame_id="-1" name="学生Ｄ"
		   text="『俺、根元のところしごいてっからさ‥‥先っぽ咥えてくれよ。』" voices=""/>
		<msg @l="761" char_id="0" frame_id="-1" name="美帆"
		   text="『あ、んふっ‥‥‥ん、むぅ‥‥‥‥‥‥ちゅぷ、ちゅぷぷっ。』" voices="miho08650"/>
		<msg @l="762" char_id="-1" frame_id="-1" name=""
		   text="鼻先に押し付けられた亀頭を口内に咥え込み、舌を絡める。" voices=""/>
		<msg @l="764" char_id="0" frame_id="-1" name="美帆"
		   text="『んっ、ちゅぷ、ちゅぷ、ちゅぷっ‥‥‥んん、むっ、んああっ。』" voices="miho08660"/>
		<msg @l="766" char_id="-1" frame_id="-1" name=""
		   text="子宮を突き上げるリズムに従って私は唇と舌を動かして、口内の肉柱をしゃぶり立てた。" voices=""/>
		<msg @l="768" char_id="-1" frame_id="-1" name="学生Ｂ"
		   text="『なかなか、良い雰囲気になってきたじゃねーの。』" voices=""/>
		<msg @l="770" char_id="-1" frame_id="-1" name="学生Ｄ"
		   text="『輪姦ってのは‥‥やっぱこうじゃなきゃな。』" voices=""/>
		<msg @l="772" char_id="0" frame_id="-1" name="美帆"
		   text="『んふっ、んっ、あむぅっ‥‥‥んぐっ‥‥ちゅぱっっ。』" voices="miho08670"/>
		<msg @l="774" char_id="-1" frame_id="-1" name=""
		   text="秘部を押し広げ子宮口まで貫かれる感触に腰を震わせながら、口内のモノを唇でしごく‥‥。" voices=""/>
		<msg @l="776" char_id="0" frame_id="-1" name="美帆"
		   text="『ああっ、あっ、あっ‥‥‥んふぅ‥‥んぐ、ちゅぷ、ちゅぷぷっ。』" voices="miho08680"/>
		<msg @l="778" char_id="-1" frame_id="-1" name="" text="二度目の絶頂が近づいてくる。"
		   voices=""/>
		<msg @l="779" char_id="-1" frame_id="-1" name=""
		   text="私は懸命に口内のそれに舌をじゅぷじゅぷと這わせながら、すぐ間際まで迫った甘い痺れに身体を震わせる。" voices=""/>
		<msg @l="781" char_id="-1" frame_id="-1" name="学生Ｄ" text="『い、いくぞっ！』"
		   voices=""/>
		<msg @l="783" char_id="-1" frame_id="-1" name=""
		   text="私の口内で舐られていた肉棒が震え、みずからしごいていた彼が唸る。" voices=""/>
		<flash @l="786" count="4" fade="100" image="white"/>
		<msg @l="788" char_id="0" frame_id="-1" name="美帆" text="『ぷあっ。』"
		   voices="miho08690"/>
		<msg @l="790" char_id="-1" frame_id="-1" name=""
		   text="口内から引き抜かれた瞬間、大量の精液が私の顔と胸に飛び散る。" voices=""/>
		<msg @l="792" char_id="-1" frame_id="-1" name="学生Ｄ" text="『ふー、最高だぜ。』"
		   voices=""/>
		<msg @l="794" char_id="-1" frame_id="-1" name="学生Ｂ"
		   text="『よっしゃ、俺もすぐに出してやるからなっ！』" voices=""/>
		<msg @l="796" char_id="0" frame_id="-1" name="美帆"
		   text="『んああっ‥‥あっ、んくっ‥‥‥‥ああっ！』" voices="miho08710"/>
		<msg @l="798" char_id="-1" frame_id="-1" name=""
		   text="ラストスパートとでも言わんばかりに、秘部を犯している彼が腰の動きを早めてくる。" voices=""/>
		<msg @l="800" char_id="0" frame_id="-1" name="美帆"
		   text="『ダメぇ‥‥‥‥そんな、したらっ‥‥‥‥ん、んぅっっ！！』" voices="miho08720"/>
		<msg @l="802" char_id="-1" frame_id="-1" name="学生Ｂ" text="『そら、もう一回イっちまえよ！！』"
		   voices=""/>
		<msg @l="804" char_id="0" frame_id="-1" name="美帆"
		   text="『ああ、あああっ‥‥‥や、ああっ‥‥‥‥いく、いくいくっ！！』" voices="miho08730"/>
		<msg @l="806" char_id="-1" frame_id="-1" name="学生Ｂ" text="『だ、出すぞっ！！』"
		   voices=""/>
		<msg @l="808" char_id="0" frame_id="-1" name="美帆"
		   text="『ひぁっ‥‥あっ、いくっ‥‥‥あ、ああ、んんんんっ！！！』" voices="miho08740"/>
		<flash @l="811" count="4" fade="100" image="white"/>
		<wait_chgmv/>
		<ev @l="814" src="ev-013x2y3z4z5z6"/>
		<msg @l="816" char_id="0" frame_id="-1" name="美帆" text="『んんっ！！』"
		   voices="miho08750"/>
		<msg @l="818" char_id="-1" frame_id="-1" name=""
		   text="三度目の精液が私の顔に降り注ぎ、顔中を白濁まみれにした。" voices=""/>
		<msg @l="819" char_id="-1" frame_id="-1" name=""
		   text="溺れてしまいそう‥‥と感じる程、顔に感じる精液の熱さと青臭さに思わずうっとりとなってしまった。" voices=""/>
		<msg @l="821" char_id="-1" frame_id="-1" name="学生Ｂ"
		   text="『へへ‥‥いい面になったじゃねーかよ。』" voices=""/>
		<msg @l="823" char_id="-1" frame_id="-1" name=""
		   text="先端から染み出した精液の残滓を私の頬になすりつけながら、先ほどまで秘部を犯していた彼が言う。" voices=""/>
		<msg @l="825" char_id="0" frame_id="-1" name="美帆" text="『ん、ああ‥‥。』"
		   voices="miho08760"/>
		<msg @l="827" char_id="-1" frame_id="-1" name=""
		   text="私はそんな彼の言葉に答えることもできず‥‥絶頂の余韻と精液の熱さに身体を震わせていた。" voices=""/>
		<msg @l="828" char_id="-1" frame_id="-1" name=""
		   text="あるのはただ身体中に残る甘い感覚だけ‥‥、‥‥‥意識が‥‥もうろうとしていく‥‥‥。" voices=""/>
		<goto @l="832" label="TempLabel_195"/>
		<label @l="833" id="TempLabel_194"/>
		<msg @l="838" char_id="-1" frame_id="-1" name="学生Ａ"
		   text="『えっと‥‥‥せ、背中が良いかな。』" voices=""/>
		<msg @l="840" char_id="-1" frame_id="-1" name="学生Ｄ" text="『ああ、やっぱ背中だよな！』"
		   voices=""/>
		<msg @l="842" char_id="-1" frame_id="-1" name="学生Ｂ" text="『うっせ、騒ぐな。』"
		   voices=""/>
		<msg @l="844" char_id="-1" frame_id="-1" name="学生Ｂ"
		   text="『それじゃ、みんなで身体にぶっかけてドロドロに汚してやろーぜ。』" voices=""/>
		<msg @l="845" char_id="-1" frame_id="-1" name="学生Ｅ"
		   text="『ちぇ‥‥顔射のロマンが‥‥‥‥。』" voices=""/>
		<msg @l="847" char_id="-1" frame_id="-1" name="学生Ａ"
		   text="『そ、それじゃ‥‥‥いくよ、いくよっ！！』" voices=""/>
		<msg @l="849" char_id="-1" frame_id="-1" name=""
		   text="激しく下半身を責めていたものが引き抜かれる。" voices=""/>
		<msg @l="850" char_id="-1" frame_id="-1" name=""
		   text="ぐったりとした私を取り囲むように、皆が並び、一斉に、強く、それぞれの手でしごき始めた。" voices=""/>
		<msg @l="852" char_id="0" frame_id="-1" name="美帆"
		   text="『んっ、んっ、んっ‥‥あっ、んくっ‥‥‥‥‥あ、ああっ！』" voices="miho08530"/>
		<msg @l="854" char_id="-1" frame_id="-1" name="学生Ａ" text="『んんっ！』" voices=""/>
		<flash @l="857" count="4" fade="100" image="white"/>
		<wait_chgmv/>
		<ev @l="860" src="ev-013x1y1z1"/>
		<msg @l="862" char_id="0" frame_id="-1" name="美帆" text="『あっ‥‥‥んんっ‥‥‥‥‥‥。』"
		   voices="miho08550"/>
		<msg @l="864" char_id="-1" frame_id="-1" name="" text="背中の上に大量の白濁液が注がれる。"
		   voices=""/>
		<msg @l="865" char_id="-1" frame_id="-1" name=""
		   text="肌を焦がすような熱い感触に私はわずかに身悶え、腰を震わせる。" voices=""/>
		<msg @l="867" char_id="-1" frame_id="-1" name="学生Ａ"
		   text="『はぁ、はぁ‥‥‥ごめん‥‥いっぱい出ちゃった。』" voices=""/>
		<msg @l="869" char_id="-1" frame_id="-1" name="学生Ｄ"
		   text="『気にすんなって。ぶっかけもんはそんくらいじゃないと。』" voices=""/>
		<msg @l="871" char_id="-1" frame_id="-1" name="学生Ｂ"
		   text="『んっ、んぁっ。こっ、こっちも出るぜ！』" voices=""/>
		<msg @l="873" char_id="-1" frame_id="-1" name="学生Ｃ" text="『おっ、おぉぅっ、お、俺もっ！！』"
		   voices=""/>
		<flash @l="876" count="4" fade="100" image="white"/>
		<wait_chgmv/>
		<ev @l="879" src="ev-013x2y1z4"/>
		<msg @l="881" char_id="-1" frame_id="-1" name=""
		   text="休む間も無く、今度は顔に精液が浴びせられる。" voices=""/>
		<msg @l="882" char_id="-1" frame_id="-1" name=""
		   text="熱くねっとりとしたものが顔を伝い落ちていく。" voices=""/>
		<msg @l="884" char_id="-1" frame_id="-1" name="学生Ｄ"
		   text="『おいっ！背中に出すっつったろうがよ！』" voices=""/>
		<msg @l="886" char_id="-1" frame_id="-1" name="学生Ｂ"
		   text="『いいじゃねえかよ。細かいことは気にすんなよ、なぁ。』" voices=""/>
		<msg @l="888" char_id="-1" frame_id="-1" name="学生Ａ"
		   text="『僕、手にかかっちゃったよ‥‥‥。』" voices=""/>
		<msg @l="890" char_id="-1" frame_id="-1" name="" text="男たちはそう言ってケラケラと笑っている。"
		   voices=""/>
		<msg @l="891" char_id="-1" frame_id="-1" name=""
		   text="周りに目を配ると、それぞれの男根を握った男たちが、いやらしい笑みを浮かべていた。" voices=""/>
		<msg @l="892" char_id="-1" frame_id="-1" name=""
		   text="どの肉棒も萎える様子は無く、むしろ精液にまみれた私を見て更に興奮しているかのようだった‥‥。" voices=""/>
		<msg @l="893" char_id="-1" frame_id="-1" name="" text="朽木教授が隅でにたにたと笑っている。"
		   voices=""/>
		<msg @l="894" char_id="-1" frame_id="-1" name="" text="逃げたい。" voices=""/>
		<msg @l="895" char_id="-1" frame_id="-1" name=""
		   text="しかし私は拘束されていて、自由に動くことすらままならない。" voices=""/>
		<msg @l="896" char_id="-1" frame_id="-1" name=""
		   text="そんな私の気持ちを知ってか知らずか、男たちは出したばかりだというのに、欲望の捌け口を求めて下半身へと殺到する。" voices=""/>
		<msg @l="898" char_id="-1" frame_id="-1" name="学生Ｂ" text="『さっさと次、いかせてもらうぜ。』"
		   voices=""/>
		<msg @l="900" char_id="-1" frame_id="-1" name="学生Ｃ" text="『おう。』" voices=""/>
		<clear @l="903" class="all"/>
		<wait_chgmv/>
		<ev @l="906" src="ev-013x2y3z1z2z3"/>
		<msg @l="908" char_id="0" frame_id="-1" name="美帆" text="『あ、んうっ‥‥。』"
		   voices="miho08560"/>
		<msg @l="910" char_id="-1" frame_id="-1" name="" text="再び、私の胎内に男根が突き入れられる。"
		   voices=""/>
		<msg @l="911" char_id="-1" frame_id="-1" name=""
		   text="先ほど貫いていたモノよりも今度の肉棒はより大きくて、入り口を押し広げられる感触に私は思わず身体をわななかせた。" voices=""/>
		<msg @l="912" char_id="-1" frame_id="-1" name=""
		   text="意識は再び下半身から湧き上がる悦楽に塗り潰されていく‥‥。" voices=""/>
		<msg @l="914" char_id="-1" frame_id="-1" name="学生Ｂ" text="『すげ‥‥結構締まるな。』"
		   voices=""/>
		<msg @l="916" char_id="0" frame_id="-1" name="美帆"
		   text="『んっ、ああっ‥‥‥すご‥‥‥‥‥おっきくて、あああっ！！』" voices="miho08570"/>
		<msg @l="917" char_id="-1" frame_id="-1" name="学生Ｂ"
		   text="『おう、コイツにはちょっと自信あるぜ。』" voices=""/>
		<msg @l="919" char_id="-1" frame_id="-1" name=""
		   text="二人目の彼はそう言って腰を強く突き出して、奥深くまで肉塊を押し込む。" voices=""/>
		<msg @l="920" char_id="-1" frame_id="-1" name=""
		   text="今までよりもはるかに強い刺激が身体の奥に広がっていく。" voices=""/>
		<msg @l="921" char_id="-1" frame_id="-1" name=""
		   text="もう声を我慢することも出来ない。勝手に口があえぎ声を発している。" voices=""/>
		<msg @l="923" char_id="0" frame_id="-1" name="美帆"
		   text="『んあっ、あっ、あっ‥‥‥ダメ、おくっ‥‥‥‥ああっ！！』" voices="miho08580"/>
		<msg @l="925" char_id="-1" frame_id="-1" name="学生Ｂ"
		   text="『へへっ‥‥喜んでもらえて光栄だね。』" voices=""/>
		<msg @l="927" char_id="-1" frame_id="-1" name="学生Ｂ"
		   text="『こっちも、たっぷりと愉しませてもらうからなー。』" voices=""/>
		<msg @l="929" char_id="0" frame_id="-1" name="美帆"
		   text="『あっ‥‥んっ、んんっ‥‥‥‥ああっ‥‥‥‥‥。』" voices="miho08590"/>
		<msg @l="931" char_id="-1" frame_id="-1" name=""
		   text="深く、浅く、私の胎内を押し広げながら肉棒が行き来する。" voices=""/>
		<msg @l="932" char_id="-1" frame_id="-1" name=""
		   text="太い欲望を受け入れるたびに私の奥底からは大量の蜜が滲み、押し出されるように結合部からグチュグチュと溢れ出していく。"
		   voices=""/>
		<msg @l="934" char_id="-1" frame_id="-1" name="学生Ｄ" text="『あー、俺、もう我慢できねーわ。』"
		   voices=""/>
		<msg @l="936" char_id="-1" frame_id="-1" name=""
		   text="順番待ちをしていた学生の一人がそう言うと、硬くいきり勃った陰茎を私の顔の前に突きつけてしごき始める。" voices=""/>
		<msg @l="938" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』"
		   voices="miho08600"/>
		<msg @l="940" char_id="0" frame_id="-1" name="美帆"
		   text="(すごい‥‥あんなに大きくなって‥‥‥‥‥)" voices="miho08610"/>
		<msg @l="942" char_id="-1" frame_id="-1" name="学生Ｃ"
		   text="『なんだよ、堪え性の無いやつだな。』" voices=""/>
		<msg @l="944" char_id="-1" frame_id="-1" name="学生Ｂ"
		   text="『ま、何でもありって方向でやろーや。』" voices=""/>
		<msg @l="946" char_id="-1" frame_id="-1" name="学生Ｄ"
		   text="『おう。言われなくてもそうするつもりだ。』" voices=""/>
		<msg @l="948" char_id="0" frame_id="-1" name="美帆"
		   text="『んんっ‥‥んっ、んんっ‥‥‥あふっ‥‥‥‥ああっ‥‥‥‥。』" voices="miho08620"/>
		<msg @l="950" char_id="-1" frame_id="-1" name=""
		   text="私もまた、彼らの向ける欲望に絡め取られるように熱い吐息を漏らす。" voices=""/>
		<msg @l="951" char_id="-1" frame_id="-1" name=""
		   text="この部屋を支配している空気に飲み込まれようとしている。" voices=""/>
		<msg @l="952" char_id="-1" frame_id="-1" name="" text="‥‥、‥‥もう‥‥どうでも良い‥‥。"
		   voices=""/>
		<msg @l="954" char_id="0" frame_id="-1" name="美帆"
		   text="『んふぅっ‥‥あっ、ああっ‥‥‥‥‥ん、ちゅろっ。』" voices="miho08630"/>
		<msg @l="956" char_id="-1" frame_id="-1" name="学生Ｄ" text="『うおっ！？』" voices=""/>
		<msg @l="958" char_id="-1" frame_id="-1" name=""
		   text="私は眼前でしごきたてられている肉塊の先端に舌を伸ばし、舐め上げる。" voices=""/>
		<msg @l="959" char_id="-1" frame_id="-1" name=""
		   text="その瞬間、自分のモノをしごいていた彼は腰を小刻みに震わせる。" voices=""/>
		<msg @l="961" char_id="-1" frame_id="-1" name="学生Ｄ"
		   text="『も、もう一回‥‥今のやってくれよ。』" voices=""/>
		<msg @l="963" char_id="0" frame_id="-1" name="美帆"
		   text="『んんっ‥‥‥んっ‥‥‥‥‥あふ、んっ‥‥‥‥ちゅろっ。』" voices="miho08640"/>
		<msg @l="965" char_id="-1" frame_id="-1" name="学生Ｄ"
		   text="『いいぜっ‥‥‥すげ、気持ちいいわ。』" voices=""/>
		<msg @l="967" char_id="-1" frame_id="-1" name="学生Ｄ"
		   text="『俺、根元のところしごいてっからさ‥‥先っぽ咥えてくれよ。』" voices=""/>
		<msg @l="969" char_id="0" frame_id="-1" name="美帆"
		   text="『あ、んふっ‥‥‥ん、むぅ‥‥‥‥‥‥ちゅぷ、ちゅぷぷっ。』" voices="miho08650"/>
		<msg @l="970" char_id="-1" frame_id="-1" name=""
		   text="鼻先に押し付けられた亀頭を口内に咥え込み、舌を絡める。" voices=""/>
		<msg @l="972" char_id="0" frame_id="-1" name="美帆"
		   text="『んっ、ちゅぷ、ちゅぷ、ちゅぷっ‥‥‥んん、むっ、んああっ。』" voices="miho08660"/>
		<msg @l="974" char_id="-1" frame_id="-1" name=""
		   text="子宮を突き上げるリズムに従って私は唇と舌を動かして、口内の肉柱をしゃぶり立てた。" voices=""/>
		<msg @l="976" char_id="-1" frame_id="-1" name="学生Ｂ"
		   text="『なかなか、良い雰囲気になってきたじゃねーの。』" voices=""/>
		<msg @l="978" char_id="-1" frame_id="-1" name="学生Ｄ"
		   text="『輪姦ってのは‥‥やっぱこうじゃなきゃな。』" voices=""/>
		<msg @l="980" char_id="0" frame_id="-1" name="美帆"
		   text="『んふっ、んっ、あむぅっ‥‥‥んぐっ‥‥ちゅぱっっ。』" voices="miho08670"/>
		<msg @l="982" char_id="-1" frame_id="-1" name=""
		   text="秘部を押し広げ子宮口まで貫かれる感触に腰を震わせながら、口内のモノを唇でしごく‥‥。" voices=""/>
		<msg @l="984" char_id="0" frame_id="-1" name="美帆"
		   text="『ああっ、あっ、あっ‥‥‥んふぅ‥‥んぐ、ちゅぷ、ちゅぷぷっ。』" voices="miho08680"/>
		<msg @l="986" char_id="-1" frame_id="-1" name="" text="二度目の絶頂が近づいてくる。"
		   voices=""/>
		<msg @l="987" char_id="-1" frame_id="-1" name=""
		   text="私は懸命に口内のそれに舌をじゅぷじゅぷと這わせながら、すぐ間際まで迫った甘い痺れに身体を震わせる。" voices=""/>
		<msg @l="989" char_id="-1" frame_id="-1" name="学生Ｄ" text="『い、いくぞっ！』"
		   voices=""/>
		<msg @l="991" char_id="-1" frame_id="-1" name=""
		   text="私の口内で舐られていた肉棒が震え、みずからしごいていた彼が唸る。" voices=""/>
		<flash @l="994" count="4" fade="100" image="white"/>
		<msg @l="996" char_id="0" frame_id="-1" name="美帆" text="『んはっ‥‥。』"
		   voices="miho08700"/>
		<msg @l="998" char_id="-1" frame_id="-1" name=""
		   text="達する瞬間、自分でしごいていた彼は口内に含んでいた肉茎を引き抜くと私に向かって大量の精液をはき出す。" voices=""/>
		<msg @l="1000" char_id="-1" frame_id="-1" name="学生Ｄ"
		   text="『くぉぉ、やっぱ出すんなら背中だよなっ！！』" voices=""/>
		<msg @l="1002" char_id="-1" frame_id="-1" name="学生Ｂ"
		   text="『よっしゃ、俺もすぐに出してやるからなっ！』" voices=""/>
		<msg @l="1004" char_id="0" frame_id="-1" name="美帆"
		   text="『んああっ‥‥あっ、んくっ‥‥‥‥ああっ！』" voices="miho08710"/>
		<msg @l="1006" char_id="-1" frame_id="-1" name=""
		   text="ラストスパートとでも言わんばかりに、秘部を犯している彼が腰の動きを早めてくる。" voices=""/>
		<msg @l="1008" char_id="0" frame_id="-1" name="美帆"
		   text="『ダメぇ‥‥‥‥そんな、したらっ‥‥‥‥ん、んぅっっ！！』" voices="miho08720"/>
		<msg @l="1010" char_id="-1" frame_id="-1" name="学生Ｂ"
		   text="『そら、もう一回イっちまえよ！！』" voices=""/>
		<msg @l="1012" char_id="0" frame_id="-1" name="美帆"
		   text="『ああ、あああっ‥‥‥や、ああっ‥‥‥‥いく、いくいくっ！！』" voices="miho08730"/>
		<msg @l="1014" char_id="-1" frame_id="-1" name="学生Ｂ" text="『だ、出すぞっ！！』"
		   voices=""/>
		<msg @l="1016" char_id="0" frame_id="-1" name="美帆"
		   text="『ひぁっ‥‥あっ、いくっ‥‥‥あ、ああ、んんんんっ！！！』" voices="miho08740"/>
		<flash @l="1019" count="4" fade="100" image="white"/>
		<wait_chgmv/>
		<ev @l="1022" src="ev-013x2y3z4z5z6"/>
		<msg @l="1024" char_id="0" frame_id="-1" name="美帆" text="『ああっ‥‥。』"
		   voices="miho08770"/>
		<msg @l="1026" char_id="-1" frame_id="-1" name=""
		   text="絶頂に震えている背中へ、三度目の白濁液が注がれる。" voices=""/>
		<msg @l="1027" char_id="-1" frame_id="-1" name=""
		   text="背中には精液の水たまりができ、腰のラインから流れ落ちた精液は‥‥机を汚していた。" voices=""/>
		<msg @l="1029" char_id="-1" frame_id="-1" name="学生Ｂ"
		   text="『精液まみれのほーが、アンタ可愛いぜ。』" voices=""/>
		<msg @l="1031" char_id="-1" frame_id="-1" name=""
		   text="精液を吐き出し終えた彼はそう言うと、背中に溜まったそれの雫を指先に絡めて私の口元へ運ぶ。" voices=""/>
		<msg @l="1033" char_id="0" frame_id="-1" name="美帆"
		   text="『んふっ‥‥‥ん、ちゅるっ‥‥‥‥。』" voices="miho08780"/>
		<msg @l="1035" char_id="-1" frame_id="-1" name=""
		   text="私はそれをためらうことなくしゃぶり‥‥いとおしそうに飲み下していた。" voices=""/>
		<msg @l="1036" char_id="-1" frame_id="-1" name=""
		   text="今、私の中にあるのはただ身体中に残る甘い感覚だけ‥‥、‥‥‥意識が‥‥もうろうとしていく‥‥‥。" voices=""/>
		<label @l="1039" id="TempLabel_195"/>
		<clear @l="1046" class="all"/>
		<end_scene @l="1049"/>
		<wait_chgmv/>
		<bg @l="1053" src="bg12"/>
		<msg @l="1055" char_id="-1" frame_id="-1" name="学生Ｃ"
		   text="『そんじゃ、次は俺がいかせてもらうかな。』" voices=""/>
		<msg @l="1057" char_id="-1" frame_id="-1" name="学生Ｅ" text="『俺のは口でやってくれよ。』"
		   voices=""/>
		<msg @l="1059" char_id="0" frame_id="-1" name="美帆"
		   text="『んっ‥‥あっ‥‥‥‥んぐっ、ちゅぷ、ちゅるるっ。』" voices="miho08790"/>
		<msg @l="1061" char_id="-1" frame_id="-1" name=""
		   text="私は言われるままに差し出された肉棒を咥え、秘部に突き入れられた肉杭をきゅうっと締め付ける。" voices=""/>
		<char @l="1065" id="kutsu" pos="auto" src="kutsu018"/>
		<msg @l="1067" char_id="-1" frame_id="-1" name="朽木" text="『‥‥‥‥。』" voices=""/>
		<msg @l="1069" char_id="-1" frame_id="-1" name=""
		   text="そうして美帆が学生たちに犯されている様を、朽木はわずかに離れた所から楽しげな表情を浮かべて黙々と眺めていた。" voices=""/>
		<msg @l="1071" char_id="-1" frame_id="-1" name="朽木"
		   text="『素晴らしい‥‥‥実に素晴らしいよ、キミは。』" voices=""/>
		<msg @l="1073" char_id="-1" frame_id="-1" name=""
		   text="彼はぼそりとつぶやいて‥‥愛しげに美帆を見ていた。" voices=""/>
		<stopbgm @l="1077" fadeout="1000"/>
		<clear @l="1083" class="all"/>
		<call @l="1089" target="EventLabel_48@ending10"/>
		<return @l="1090" value="0&#13;&#10;"/>
	</code>
</xscript>
