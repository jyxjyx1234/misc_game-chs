<?xml version="1.0" encoding="utf-8"?>
<xscript>
	<debug editor="&quot;C:\Program&#32;Files&#32;(x86)\sakura\sakura.exe&quot;&#32;&quot;%src%&quot;&#32;-Y=%line%"
	   src="D:\シロップ\町ぐるみの罠＋汚された夏セット版\汚された夏\完成データ\汚された夏\script\text\root_tureend02.txt"/>
	<code>
		<label @l="13" id="EventLabel_149"/>
		<eval @l="16" expr="f.numDay=0&#13;&#10;"/>
		<msg @l="18" char_id="-1" frame_id="-1" name="" text="‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥。"
		   voices=""/>
		<msg @l="19" char_id="-1" frame_id="-1" name="" text="‥‥‥‥‥‥‥‥‥‥‥‥。"
		   voices=""/>
		<msg @l="20" char_id="-1" frame_id="-1" name="" text="‥‥‥‥‥‥‥‥。" voices=""/>
		<msg @l="21" char_id="-1" frame_id="-1" name="" page_feed="true"
		   text="‥‥‥‥。" voices=""/>
		<bgm @l="26" src="bgm19" volume="1."/>
		<page @l="29" fade="300"/>
		<wait_chgmv/>
		<bg @l="32" src="bg15a"/>
		<char @l="34" id="shiny" pos="auto" src="shinya010"/>
		<description @l="37" text="？？？"/>
		<eval @l="39" expr="f.numDay=0&#13;&#10;"/>
		<msg @l="41" char_id="-1" frame_id="-1" name="" text="\n:『遂に動いたか‥‥。』"
		   voices=""/>
		<msg @l="43" char_id="-1" frame_id="-1" name=""
		   text="\n:\n:黄昏に塗られたキャンパスの一角で、浅間真弥がポツリとつぶやく。" voices=""/>
		<msg @l="44" char_id="-1" frame_id="-1" name="" text="視線の先にはテニスコート―――。"
		   voices=""/>
		<msg @l="45" char_id="-1" frame_id="-1" name=""
		   text="真弥はコートを眺めながら僅かに目を細め、そして‥‥‥口の端を歪めた。" voices=""/>
		<msg @l="47" char_id="-1" frame_id="-1" name="" text="\n:『これで‥‥決着がつく‥‥‥。』"
		   voices=""/>
		<msg @l="49" char_id="-1" frame_id="-1" name="" page_feed="true"
		   text="\n:&#32;\n:真弥はゆっくりと歩き始めた。" voices=""/>
		<clear @l="52" class="all"/>
		<page @l="55" fade="300"/>
		<wait_chgmv/>
		<ev @l="58" src="ev-058"/>
		<msg @l="60" char_id="-1" frame_id="-1" name="" text="『‥‥‥‥。』" voices=""/>
		<msg @l="62" char_id="-1" frame_id="-1" name=""
		   text="\n:路面電車の停留所付近で‥‥奈那子が美帆を待っていた。" voices=""/>
		<msg @l="63" char_id="-1" frame_id="-1" name=""
		   text="兄、真弥からは特定の人間と親密な関係を持つなと念を押されている。" voices=""/>
		<msg @l="64" char_id="-1" frame_id="-1" name=""
		   text="けれど‥‥奈那子は、美帆をその他大勢の人間と同様に思うことは出来なかった。" voices=""/>
		<msg @l="65" char_id="-1" frame_id="-1" name=""
		   text="何故、美帆に特別な感情を抱いているのかは奈那子自身も良く解ってはいない。" voices=""/>
		<msg @l="66" char_id="-1" frame_id="-1" name=""
		   text="ただ、奈那子が自分から「友達になりたい」と思ったのは美帆が、初めての事だ。" voices=""/>
		<msg @l="67" char_id="-1" frame_id="-1" name=""
		   text="それを承諾してくれたのもやはり美帆が初めてである。" voices=""/>
		<msg @l="68" char_id="-1" frame_id="-1" name="" page_feed="true"
		   text="\n:奈那子は美帆が大好きだった。" voices=""/>
		<clear @l="71" class="all"/>
		<page @l="73" fade="300"/>
		<msg @l="75" char_id="-1" frame_id="-1" name="" page_feed="true"
		   text="真弥との会話を思い出す─────。" voices=""/>
		<clear @l="78" class="all"/>
		<page @l="80" fade="300"/>
		<msg @l="82" char_id="-1" frame_id="-1" name="" text="《奈那子‥‥》" voices=""/>
		<msg @l="84" char_id="-1" frame_id="-1" name="" text="\n:《‥‥‥‥》" voices=""/>
		<msg @l="86" char_id="-1" frame_id="-1" name=""
		   text="\n:《これから俺は決着をつけに行く。‥‥‥ここは危険だ、お前は安全な所に控えていろ》" voices=""/>
		<msg @l="88" char_id="-1" frame_id="-1" name="" text="\n:《危険‥‥？》" voices=""/>
		<msg @l="90" char_id="-1" frame_id="-1" name="" text="\n:《先程、目標の一人を探し当てた》"
		   voices=""/>
		<msg @l="92" char_id="-1" frame_id="-1" name=""
		   text="《もう既にこの町は‥‥‥取り返しのつかない事になっている‥‥》" voices=""/>
		<msg @l="94" char_id="-1" frame_id="-1" name="" text="\n:《美帆が‥‥‥狙われているの？》"
		   voices=""/>
		<msg @l="96" char_id="-1" frame_id="-1" name="" text="\n:《‥‥‥‥》" voices=""/>
		<msg @l="98" char_id="-1" frame_id="-1" name="" text="\n:《そうなんだね‥‥》"
		   voices=""/>
		<msg @l="100" char_id="-1" frame_id="-1" name="" text="《お願い、美帆を助けてあげて‥‥兄様》"
		   voices="nanako00260"/>
		<msg @l="102" char_id="-1" frame_id="-1" name=""
		   text="\n:《奈那子、俺は人助けの為に奴等を追っている訳では‥‥‥》" voices=""/>
		<msg @l="104" char_id="-1" frame_id="-1" name="" text="\n:\n:《兄様‥‥‥お願い》"
		   voices=""/>
		<msg @l="106" char_id="-1" frame_id="-1" name="" text="\n:《‥‥‥‥》" voices=""/>
		<msg @l="108" char_id="-1" frame_id="-1" name="" text="《抜け道が‥‥‥大学裏手の丘にある》"
		   voices=""/>
		<msg @l="110" char_id="-1" frame_id="-1" name=""
		   text="《それを辿ればこの町から抜け出ることが出来る筈だ》" voices=""/>
		<msg @l="112" char_id="-1" frame_id="-1" name="" text="《その娘を連れて先に抜け道へ行け‥‥‥》"
		   voices=""/>
		<msg @l="114" char_id="-1" frame_id="-1" name="" text="\n:《兄様‥‥ありがとう》"
		   voices=""/>
		<msg @l="116" char_id="-1" frame_id="-1" name=""
		   text="\n:《他人への干渉はこれで最後だ、良いな？》" voices=""/>
		<msg @l="118" char_id="-1" frame_id="-1" name="" page_feed="true"
		   text="\n:《はい‥‥》" voices=""/>
		<clear @l="121" class="all"/>
		<page @l="123" fade="300"/>
		<wait_chgmv/>
		<ev @l="126" src="ev-058"/>
		<msg @l="128" char_id="-1" frame_id="-1" name=""
		   text="\n:────兄様は美帆を助けてくれるって言ってた‥‥。" voices=""/>
		<msg @l="129" char_id="-1" frame_id="-1" name="" text="‥‥兄様の事も心配だけど‥‥‥。"
		   voices=""/>
		<msg @l="130" char_id="-1" frame_id="-1" name=""
		   text="‥‥今は、美帆を抜け道に連れていかなきゃ。" voices=""/>
		<msg @l="132" char_id="-1" frame_id="-1" name="" text="\n:\n:『‥‥‥‥。』"
		   voices=""/>
		<msg @l="134" char_id="-1" frame_id="-1" name="" text="\n:『美帆‥‥。』" voices=""/>
		<msg @l="136" char_id="-1" frame_id="-1" name=""
		   text="\n:奈那子は徐々に近付いて来る美帆の気配に気付き、呟いた。" voices=""/>
		<msg @l="137" char_id="-1" frame_id="-1" name="" page_feed="true"
		   text="そして‥‥祈るように瞳を伏せて、彼女の来るのを待っていた。" voices=""/>
		<clear @l="140" class="all"/>
		<page @l="142" fade="300"/>
		<wait_chgmv/>
		<bg @l="145" src="bg15a"/>
		<se @l="148" buf="3" loop="true" src="心臓" volume="1."/>
		<msg @l="150" char_id="-1" frame_id="-1" name="" text="──どくん" voices=""/>
		<msg @l="151" char_id="-1" frame_id="-1" name="" text="どくんどくん" voices=""/>
		<msg @l="152" char_id="-1" frame_id="-1" name="" text="どくんどくんどくん" voices=""/>
		<msg @l="153" char_id="-1" frame_id="-1" name="" page_feed="true"
		   text="ドクン！" voices=""/>
		<stopse @l="156" buf="3"/>
		<page @l="159" fade="300"/>
		<msg @l="161" char_id="-1" frame_id="-1" name="" text="『‥‥‥ハァ‥‥ハァ‥‥‥‥。』"
		   voices=""/>
		<msg @l="163" char_id="-1" frame_id="-1" name=""
		   text="\n:否応無く身体を駆け巡っていた暴力的な快楽が、徐々に治まる。" voices=""/>
		<msg @l="164" char_id="-1" frame_id="-1" name=""
		   text="多少高ぶる感覚を押さえ込みながら、奈那子は荒い呼吸を繰り返し立ち上がった。" voices=""/>
		<char @l="167" id="nanak" pos="auto" src="nanako015"/>
		<msg @l="169" char_id="-1" frame_id="-1" name=""
		   text="熊野に射たれた薬によって自由を奪われていたのは、どれくらいの間だったのだろう‥‥。" voices=""/>
		<msg @l="170" char_id="-1" frame_id="-1" name=""
		   text="良くは解らないが熊野に打たれた薬の効果が切れたようだ‥‥。" voices=""/>
		<msg @l="172" char_id="-1" frame_id="-1" name="" text="次第に頭もハッキリしてきた。"
		   voices=""/>
		<msg @l="173" char_id="-1" frame_id="-1" name="" text="美帆の安否が気になり、辺りを探ってみる。"
		   voices=""/>
		<msg @l="175" char_id="-1" frame_id="-1" name=""
		   text="\n:『美帆‥‥。無事逃げれたかな‥‥‥。』" voices=""/>
		<msg @l="177" char_id="-1" frame_id="-1" name="" page_feed="true"
		   text="\n:美帆はどうなったろうか。" voices=""/>
		<page @l="180" fade="300"/>
		<msg @l="182" char_id="-1" frame_id="-1" name="" text="‥‥‥。" voices=""/>
		<msg @l="183" char_id="-1" frame_id="-1" name="" text="\n:‥‥‥兄様‥‥、美帆‥‥‥。"
		   voices=""/>
		<clear @l="186" class="char"/>
		<msg @l="188" char_id="-1" frame_id="-1" name=""
		   text="\n:南総町を取り囲む山々の尾根に没する太陽を見つめ、奈那子は何かを決意するように歩み始める。" voices=""/>
		<msg @l="189" char_id="-1" frame_id="-1" name="" page_feed="true"
		   text="\n:\n:\n:奈那子にしては珍しく‥‥‥険しい表情を浮かべながら―――。" voices=""/>
		<stopbgm @l="192" fadeout="1000"/>
		<clear @l="195" class="all"/>
		<page @l="197" fade="300"/>
		<wait_chgmv/>
		<bg @l="200" src="bg22_3"/>
		<char @l="202" id="shiny" pos="left" src="shinya010"/>
		<char @l="204" id="kuma" pos="right" src="kuma018"/>
		<bgm @l="207" src="bgm21" volume="1."/>
		<msg @l="209" char_id="-1" frame_id="-1" name=""
		   text="廃道の出口にて‥‥浅間真弥と熊野兵吉が対峙していた。" voices=""/>
		<msg @l="210" char_id="-1" frame_id="-1" name=""
		   text="真弥は普段通りの仏頂面で、廃道出口を塞ぐ形でその中央に立ちはだかっている。" voices=""/>
		<msg @l="211" char_id="-1" frame_id="-1" name=""
		   text="熊野はそんな真弥を憎々しげに睨み付け、苛立ちをぶつけていた。" voices=""/>
		<msg @l="213" char_id="-1" frame_id="-1" name=""
		   text="\n:『旧大黒製薬研究所通路‥‥この通路が使えるようになっていたとはな‥‥道理で警察が見つけられないわけだ。』" voices=""/>
		<msg @l="215" char_id="-1" frame_id="-1" name=""
		   text="\n:『ここを知っているとは貴様、一体何者だ。』" voices=""/>
		<msg @l="217" char_id="-1" frame_id="-1" name="" text="\n:『‥‥‥‥。』" voices=""/>
		<msg @l="219" char_id="-1" frame_id="-1" name=""
		   text="\n:『其処を退け‥‥‥あの女を逃がしてしまうではないか！』" voices=""/>
		<msg @l="221" char_id="-1" frame_id="-1" name="" text="\n:『‥‥‥‥。』" voices=""/>
		<msg @l="223" char_id="-1" frame_id="-1" name="" text="\n:真弥は熊野の言葉に応じない。"
		   voices=""/>
		<msg @l="225" char_id="-1" frame_id="-1" name=""
		   text="\n:『さっきの小娘といい、貴様といい、邪魔ばかり入る。急に厄日にでもなってしまったみたいだな！&#32;クソッ！』"
		   voices=""/>
		<char @l="228" id="shiny" pos="left" src="shinya017"/>
		<msg @l="230" char_id="-1" frame_id="-1" name=""
		   text="\n:『ああ‥‥確かにお前にとっては厄日だ‥‥。俺に会ってしまったのだからな‥‥。』" voices=""/>
		<msg @l="232" char_id="-1" frame_id="-1" name=""
		   text="\n:『貴様ぁ！&#32;ふざけるなっ！！』" voices=""/>
		<msg @l="234" char_id="-1" frame_id="-1" name=""
		   text="\n:叫ぶや否や、熊野は真弥に飛びかかろうと構える。" voices=""/>
		<msg @l="236" char_id="-1" frame_id="-1" name="" page_feed="true"
		   text="\n:\n:――その瞬間。" voices=""/>
		<stopbgm @l="239" fadeout="1000"/>
		<page @l="242" fade="300"/>
		<clear @l="244" class="char"/>
		<char @l="246" id="shiny" pos="center" src="shinya017f" y="-80"/>
		<wait @l="248" time="1000"/>
		<se @l="250" buf="1" src="心臓" volume="1."/>
		<char @l="252" id="shiny" pos="center" src="shinya018f" y="-80"/>
		<msg @l="254" char_id="-1" frame_id="-1" name="" text="真弥の双眸が真紅に染まる。"
		   voices=""/>
		<msg @l="255" char_id="-1" frame_id="-1" name=""
		   text="変化に気付いた熊野は驚きのあまり動きを止めた。" voices=""/>
		<bgm @l="258" src="bgm21" volume="1."/>
		<clear @l="261" class="char"/>
		<char @l="263" id="kuma" pos="auto" src="kuma018"/>
		<msg @l="265" char_id="-1" frame_id="-1" name=""
		   text="\n:『なっ！！&#32;貴様‥‥まさか‥‥。』" voices=""/>
		<clear @l="268" class="char"/>
		<char @l="270" id="shiny" pos="left" src="shinya018"/>
		<char @l="272" id="kuma" pos="right" src="kuma018"/>
		<msg @l="274" char_id="-1" frame_id="-1" name="" text="\n:『知っているならば話が早い‥‥。』"
		   voices=""/>
		<msg @l="276" char_id="-1" frame_id="-1" name=""
		   text="\n:そう言うと真弥は体中に殺気をみなぎらせた。" voices=""/>
		<msg @l="278" char_id="-1" frame_id="-1" name=""
		   text="\n:『ま、待てっ！！何故だ？！&#32;あの薬があれば何もかも思いのままではないか？』" voices=""/>
		<msg @l="280" char_id="-1" frame_id="-1" name="" text="\n:『‥‥‥‥。』" voices=""/>
		<msg @l="282" char_id="-1" frame_id="-1" name=""
		   text="\n:『お前だって服用しているんだろう？それだったら、その素晴らしさが解らぬ訳ではあるまい！？』" voices=""/>
		<msg @l="284" char_id="-1" frame_id="-1" name="" text="\n:『‥‥‥‥。』" voices=""/>
		<msg @l="286" char_id="-1" frame_id="-1" name=""
		   text="\n:激昂する熊野とは対照的に、真弥の表情は微動だにしない。" voices=""/>
		<msg @l="288" char_id="-1" frame_id="-1" name=""
		   text="\n:『我々は特別な存在だ、それが凡庸な人間達を操って何が悪い！』" voices=""/>
		<msg @l="290" char_id="-1" frame_id="-1" name=""
		   text="\n:『‥‥‥‥‥‥言いたい事は‥‥‥それだけか‥‥。』" voices=""/>
		<msg @l="292" char_id="-1" frame_id="-1" name=""
		   text="\n:熊野の話を聞いていた真弥が静かに言い放つ。" voices=""/>
		<msg @l="294" char_id="-1" frame_id="-1" name=""
		   text="\n:『あの薬の痕跡は―――残さず葬る、それが俺の復讐だ。』" voices=""/>
		<msg @l="296" char_id="-1" frame_id="-1" name="" page_feed="true"
		   text="\n:『チッ！&#32;ならば返りうちにしてくれるわっ！』" voices=""/>
		<clear @l="299" class="all"/>
		<page @l="301" fade="300"/>
		<bgm @l="303" src="bgm13" volume="1."/>
		<msg @l="305" char_id="-1" frame_id="-1" name="" text="瞬間、熊野は地面を蹴り、跳ぶ。"
		   voices=""/>
		<msg @l="306" char_id="-1" frame_id="-1" name=""
		   text="老いているはずの熊野からは想像も出来ない、力強く、しなやかな跳躍であった。熊野に勝利を確信させるほどのタイミングと角度だった―――筈だった。"
		   voices=""/>
		<flash @l="309" count="4" fade="100" image="white"/>
		<msg @l="311" char_id="-1" frame_id="-1" name="" text="\n:『なっ？！』" voices=""/>
		<msg @l="313" char_id="-1" frame_id="-1" name=""
		   text="\n:だが、吹き飛ばされたのは熊野の方だった。" voices=""/>
		<msg @l="314" char_id="-1" frame_id="-1" name=""
		   text="横薙ぎに振るった真弥の腕は熊野をいとも容易く捉え、そのまま生い立つ大木の幹へと叩き付けたのだ。" voices=""/>
		<se @l="317" buf="1" src="刃物刺す音4" volume="1."/>
		<flash @l="319" count="4" fade="100" image="white"/>
		<msg @l="321" char_id="-1" frame_id="-1" name="" text="\n:『ぐおっ！！！』"
		   voices=""/>
		<msg @l="323" char_id="-1" frame_id="-1" name=""
		   text="\n:背中から大木に激突し、熊野が短く唸る。" voices=""/>
		<msg @l="324" char_id="-1" frame_id="-1" name="" page_feed="true"
		   text="真弥は憐れむような視線を熊野に注ぎながら、ゆっくりと彼に歩み寄った。" voices=""/>
		<page @l="327" fade="300"/>
		<wait_chgmv/>
		<bg @l="329" src="bg23a"/>
		<bgm @l="332" src="bgm12" volume="1."/>
		<char @l="335" id="shiny" pos="auto" src="shinya018"/>
		<msg @l="337" char_id="-1" frame_id="-1" name="" text="『‥‥‥‥。』" voices=""/>
		<char @l="340" id="kuma" pos="center" src="kuma018"/>
		<msg @l="342" char_id="-1" frame_id="-1" name=""
		   text="\n:『ま、待て‥‥くっ、くそっなんて力だ！？』" voices=""/>
		<clear @l="345" class="char"/>
		<char @l="347" id="shiny" pos="left" src="shinya018"/>
		<char @l="349" id="kuma" pos="right" src="kuma018"/>
		<msg @l="351" char_id="-1" frame_id="-1" name="" text="\n:『お前に勝ち目は無い、諦めろ。』"
		   voices=""/>
		<msg @l="353" char_id="-1" frame_id="-1" name=""
		   text="\n:『畜生っ何故だ！？何故、邪魔をする！お前とて俺達と同類だろうが！！』" voices=""/>
		<msg @l="355" char_id="-1" frame_id="-1" name="" text="\n:『お前達などと一緒にするな。』"
		   voices=""/>
		<msg @l="357" char_id="-1" frame_id="-1" name=""
		   text="\n:『なんだと！！くそっ。俺はやっとこの街をここまで育て上げたんだ。それがフイになるのを黙って見過ごせるか！！』"
		   voices=""/>
		<msg @l="359" char_id="-1" frame_id="-1" name="" text="\n:『この歪んだ性欲処理場がか？』"
		   voices=""/>
		<msg @l="361" char_id="-1" frame_id="-1" name=""
		   text="\n:&#32;&#32;『歪んだ？違うな、これがこの町‥‥いや村の本来の姿なのだ。』" voices=""/>
		<msg @l="363" char_id="-1" frame_id="-1" name=""
		   text="\n:&#32;&#32;『なんだと‥‥？』" voices=""/>
		<msg @l="365" char_id="-1" frame_id="-1" name=""
		   text="\n:&#32;&#32;『二十年以上前、この南総村には、大黒製薬の研究所があった。表向きは栄養剤やプロテインなどを開発していたが、真の目的は究極の肉体を持った超人を作り出す事だった。当然、軍事目的でな。』"
		   voices=""/>
		<msg @l="367" char_id="-1" frame_id="-1" name=""
		   text="\n:&#32;&#32;『そして、多くの失敗作を経てある一つの完成形へと到達した。』" voices=""/>
		<msg @l="369" char_id="-1" frame_id="-1" name="" text="\n:『それが稲庭俊明に投与した薬か。』"
		   voices=""/>
		<msg @l="371" char_id="-1" frame_id="-1" name=""
		   text="\n:&#32;&#32;『そうだ。強靭な肉体と強い闘争本能、実験は成功に思えた。副産物として性欲を高める媚薬効果も確認された。しかし、実用化する為には莫大な数の実験をこなす必要があったのだ。』"
		   voices=""/>
		<msg @l="373" char_id="-1" frame_id="-1" name=""
		   text="\n:&#32;&#32;『その中でも特に性衝動をコントロールする事は困難を極め、専用の実験施設が必要という結論が導き出された。』"
		   voices=""/>
		<msg @l="375" char_id="-1" frame_id="-1" name=""
		   text="\n:&#32;&#32;『そうして生まれたのが町自体を性欲処理場に変えるという計画か‥‥馬鹿げている。』" voices=""/>
		<msg @l="377" char_id="-1" frame_id="-1" name=""
		   text="\n:&#32;&#32;『そう思うか？しかし廃村の危機に怯えていた村の連中はあっさり承諾し、政治家への根回しも予想以上にスムーズに行われた。これがどういう事かわかるか？』"
		   voices=""/>
		<msg @l="379" char_id="-1" frame_id="-1" name=""
		   text="\n:&#32;&#32;『‥‥‥‥‥。』" voices=""/>
		<msg @l="381" char_id="-1" frame_id="-1" name=""
		   text="\n:&#32;&#32;『理想郷だよ。』" voices=""/>
		<msg @l="383" char_id="-1" frame_id="-1" name="" text="\n:&#32;&#32;『なにっ！？』"
		   voices=""/>
		<msg @l="385" char_id="-1" frame_id="-1" name=""
		   text="\n:&#32;&#32;『政治家や企業の連中にとっては性のリゾート地、村の連中にとっては莫大な富を生む金の卵。そして我々には町自体が無限のデータをもたらす実験場となるのだ。』"
		   voices=""/>
		<msg @l="387" char_id="-1" frame_id="-1" name=""
		   text="\n:&#32;&#32;『すでに初期段階のテストも終了し、これから本格的に計画が動き出す事になっている。当然多くの企業や住人達が移り住んで来る事になる。』"
		   voices=""/>
		<msg @l="389" char_id="-1" frame_id="-1" name="" text="\n:『‥‥‥‥。』" voices=""/>
		<msg @l="391" char_id="-1" frame_id="-1" name=""
		   text="\n:『お前にこれまでの苦労が解るか？この町を無闇に潰してしまったら町の人間達の生活はどうなる？お前は一体何が望みなんだ？』"
		   voices=""/>
		<msg @l="393" char_id="-1" frame_id="-1" name=""
		   text="\n:『この薬は素晴らしいが、まだまだ副作用がある。しかし俺と手を組めばその解決方法もじき見つかるようになるんだ。悪い話ではないだろう、な？』"
		   voices=""/>
		<msg @l="395" char_id="-1" frame_id="-1" name="" text="\n:熊野は媚びた笑みを真弥に送る。"
		   voices=""/>
		<msg @l="396" char_id="-1" frame_id="-1" name="" text="が、受け取った真弥の表情は変わらない。"
		   voices=""/>
		<msg @l="397" char_id="-1" frame_id="-1" name="" text="代わりに拒絶の言葉を返す。"
		   voices=""/>
		<msg @l="399" char_id="-1" frame_id="-1" name=""
		   text="\n:『確かに俺も貴様と同じ種の力を持っている。しかし‥‥‥お前とは根本的に違う所がある。』" voices=""/>
		<msg @l="401" char_id="-1" frame_id="-1" name=""
		   text="\n:『？！&#32;違うところ‥‥だと‥‥』" voices=""/>
		<stopbgm @l="404" fadeout="1000"/>
		<msg @l="406" char_id="-1" frame_id="-1" name="" text="\n:『俺の力は生まれ持ったものだ。』"
		   voices=""/>
		<msg @l="408" char_id="-1" frame_id="-1" name="" text="\n:『な、に‥‥？！』"
		   voices=""/>
		<msg @l="410" char_id="-1" frame_id="-1" name=""
		   text="\n:『俺の母親の名前は浅間真那。聞き覚えがあるだろう！！』" voices=""/>
		<msg @l="412" char_id="-1" frame_id="-1" name="" page_feed="true"
		   text="\n:&#32;&#32;『ま、まさかっ‥‥。』" voices=""/>
		<page @l="415" fade="300"/>
		<bgm @l="417" src="bgm18" volume="1."/>
		<msg @l="419" char_id="-1" frame_id="-1" name=""
		   text="\n:『俺は、貴様達に殺された浅間真那の息子、浅間真弥だ。』" voices=""/>
		<msg @l="421" char_id="-1" frame_id="-1" name=""
		   text="\n:『待て、待ってくれ。確かに俺はあの時、浅間を被験者として研究をしていた。しかし、あれは事故だ‥‥事故だったんだよ。』"
		   voices=""/>
		<msg @l="423" char_id="-1" frame_id="-1" name=""
		   text="\n:『哀れだな‥‥‥お前達の犯した罪の調べはついている。』" voices=""/>
		<msg @l="425" char_id="-1" frame_id="-1" name=""
		   text="\n:&#32;&#32;『お前達が平行して進めていたプロジェクト‥‥「強化された母体による超人の誕生」についてな。』"
		   voices=""/>
		<msg @l="427" char_id="-1" frame_id="-1" name=""
		   text="\n:&#32;&#32;『なっ‥‥、どこでそれを！まさか！？』" voices=""/>
		<msg @l="429" char_id="-1" frame_id="-1" name=""
		   text="\n:&#32;&#32;『そうだ、俺自身が計画の生き証人だ。』" voices=""/>
		<msg @l="431" char_id="-1" frame_id="-1" name=""
		   text="\n:&#32;&#32;『薬物による外部からの強化ではなく、あらかじめ薬で強化された母体に子供を生ませ、生まれながらに超人的肉体を持った人間を作るという計画。その第一号がこの俺だ。』"
		   voices=""/>
		<msg @l="433" char_id="-1" frame_id="-1" name=""
		   text="\n:『では貴様まさか‥‥大黒蔵之介の！？』" voices=""/>
		<msg @l="435" char_id="-1" frame_id="-1" name=""
		   text="\n:&#32;&#32;『その名前を俺の前で言うな！』" voices=""/>
		<msg @l="437" char_id="-1" frame_id="-1" name=""
		   text="\n:&#32;&#32;『母さんは、アイツの事を盲目的に愛していた。この研究が大黒グループの‥‥ひいては蔵之介の為になるなら、自分はどうなっても構わない。母さんはいつも俺達兄妹に話していた。だが、あの男はそれにつけこんで、母さんの事を、実験体を生むだけの人形に変えてしまったんだ！！』"
		   voices=""/>
		<msg @l="439" char_id="-1" frame_id="-1" name="" page_feed="true"
		   text="\n:&#32;&#32;『しかし、実験は全て失敗に終わった筈だ！生まれてきた子供は、普通の子供と大差が無く、浅間は度重なる強化に耐え切れず実験中の事故で死んだ。その後、当時の研究員のほとんどは何者かによって殺されてしまったのだからな。』"
		   voices=""/>
		<stopbgm @l="443" fadeout="1000"/>
		<page @l="445" fade="300"/>
		<msg @l="447" char_id="-1" frame_id="-1" name=""
		   text="\n:&#32;&#32;『実験は成功していた。』" voices=""/>
		<msg @l="449" char_id="-1" frame_id="-1" name=""
		   text="\n:&#32;&#32;『なんだと！？』" voices=""/>
		<bgm @l="452" src="bgm12" volume="1."/>
		<msg @l="455" char_id="-1" frame_id="-1" name=""
		   text="\n:&#32;&#32;『稲庭への実験でわかっていると思うが、力の発現と感情には大きな関連がある。』" voices=""/>
		<msg @l="457" char_id="-1" frame_id="-1" name=""
		   text="\n:&#32;&#32;『それがどうしたというのだ‥‥まさか！』" voices=""/>
		<msg @l="459" char_id="-1" frame_id="-1" name=""
		   text="\n:&#32;&#32;『そうだ、俺は突然、自分に秘められた力が目覚めたのだ。母さんが殺されるのを偶然見てしまったあの時に！』"
		   voices=""/>
		<msg @l="461" char_id="-1" frame_id="-1" name=""
		   text="\n:&#32;&#32;『俺の目的は大黒製薬、そして大黒グループ。俺の復讐の相手は超人などという馬鹿げた目的の為に弱者を踏みにじるお前のような連中全てだ！！！』"
		   voices=""/>
		<msg @l="463" char_id="-1" frame_id="-1" name="" text="\n:『！！！！！！』"
		   voices=""/>
		<msg @l="465" char_id="-1" frame_id="-1" name=""
		   text="\n:『‥‥‥‥お前達は葬る‥‥残らずな。それが俺の復讐だ。』" voices=""/>
		<msg @l="467" char_id="-1" frame_id="-1" name="" text="\n:『‥‥‥‥‥‥‥。』"
		   voices=""/>
		<msg @l="469" char_id="-1" frame_id="-1" name=""
		   text="\n:熊野が、苦虫を噛み潰したような表情を浮かべる。" voices=""/>
		<msg @l="470" char_id="-1" frame_id="-1" name=""
		   text="真弥の目的が自分自身とあっては、戦いを避けることは不可能だった。" voices=""/>
		<msg @l="471" char_id="-1" frame_id="-1" name=""
		   text="自分と真弥。能力は圧倒的に真弥のほうが上だ。" voices=""/>
		<msg @l="473" char_id="-1" frame_id="-1" name=""
		   text="\n:───何とか隙を見つけられないかと周囲を窺い、視線が廃道の出口に差し掛かったところで、熊野はニヤリと笑った。"
		   voices=""/>
		<msg @l="475" char_id="-1" frame_id="-1" name=""
		   text="\n:熊野は真弥に向かって走り出し、真弥が身構えると同時に強く地面を蹴る。" voices=""/>
		<msg @l="477" char_id="-1" frame_id="-1" name="" page_feed="true"
		   text="真弥の頭上を飛び越え廃道の出口付近へと着地をし、そこに身を潜めていた人影へと手を伸ばした。" voices=""/>
		<stopbgm @l="480" fadeout="1000"/>
		<clear @l="483" class="char"/>
		<page @l="485" fade="300"/>
		<char @l="487" id="nanak" pos="auto" src="nanako014"/>
		<char @l="489" id="kuma" pos="left" src="kuma018"/>
		<msg @l="491" char_id="-1" frame_id="-1" name="" text="『あっ‥‥。』" voices=""/>
		<msg @l="493" char_id="-1" frame_id="-1" name="" text="\n:『動くな小娘、それと貴様もな。』"
		   voices=""/>
		<msg @l="495" char_id="-1" frame_id="-1" name=""
		   text="\n:熊野は奈那子の後ろに回り、首に手をかけ言い放つ。" voices=""/>
		<char @l="498" id="nanak" pos="auto" src="nanako015"/>
		<char @l="500" id="kuma" pos="auto" src="kuma018"/>
		<bgm @l="502" src="bgm13" volume="1."/>
		<msg @l="504" char_id="-1" frame_id="-1" name="" text="\n:『奈那子っ！？』"
		   voices=""/>
		<msg @l="506" char_id="-1" frame_id="-1" name="" text="\n:『ごめんなさい‥‥兄様。』"
		   voices=""/>
		<msg @l="508" char_id="-1" frame_id="-1" name=""
		   text="\n:『ふはははっ、詰めが甘いな。浅間の坊主！！』" voices=""/>
		<msg @l="510" char_id="-1" frame_id="-1" name="" text="\n:真弥が熊野に向かい距離を詰める。"
		   voices=""/>
		<msg @l="512" char_id="-1" frame_id="-1" name="" text="熊野は奈那子の身体を‥‥‥盾にする。"
		   voices=""/>
		<msg @l="514" char_id="-1" frame_id="-1" name=""
		   text="\n:『ん～？&#32;迂闊に動けばこの小娘を殺すぞ。』" voices=""/>
		<msg @l="516" char_id="-1" frame_id="-1" name="" text="\n:『くっ‥‥姑息な。』"
		   voices=""/>
		<msg @l="518" char_id="-1" frame_id="-1" name=""
		   text="\n:『この小娘が貴様の妹とはなぁ。俺にとっては好都合だ。』" voices=""/>
		<msg @l="520" char_id="-1" frame_id="-1" name=""
		   text="\n:奈那子を盾に取られている為、動きが止まってしまった真弥に向かって、熊野は横腹に強烈な一撃を加える。" voices=""/>
		<se @l="524" buf="1" src="箱を蹴ってる" volume="1."/>
		<flash @l="526" count="4" fade="100" image="white"/>
		<msg @l="528" char_id="-1" frame_id="-1" name="" text="\n:『ぐわぁぁぁぁぁっ！！』"
		   voices=""/>
		<msg @l="530" char_id="-1" frame_id="-1" name=""
		   text="\n:まともに食らった真弥の片腹が大きく揺さ振られる。途端に真弥の口から大量の血が吐き出された。" voices=""/>
		<msg @l="532" char_id="-1" frame_id="-1" name="" text="\n:『げはぁっっ！！』"
		   voices=""/>
		<msg @l="534" char_id="-1" frame_id="-1" name="" text="\n:『兄様────っ！』"
		   voices=""/>
		<msg @l="536" char_id="-1" frame_id="-1" name=""
		   text="\n:熊野の手が緩んだ隙をついて奈那子が真弥の元に駆け寄った。" voices=""/>
		<msg @l="537" char_id="-1" frame_id="-1" name="" page_feed="true"
		   text="脇腹をえぐられたような苦痛に真弥は顔を歪める。歯を食いしばり、なんとか身を起こした。" voices=""/>
		<label @l="540" id="chart_line62"/>
		<wait_chgmv/>
		<ev @l="543" src="ev-066"/>
		<page @l="545" fade="300"/>
		<msg @l="547" char_id="-1" frame_id="-1" name=""
		   text="『奈那子！無事か‥‥。お前は下がっていろ！』" voices=""/>
		<msg @l="549" char_id="-1" frame_id="-1" name=""
		   text="\n:『良く動けるものだ、流石だな。だが妹の方はどうかな？&#32;貴様に隙あらば妹の首の骨、一瞬で折る事くらいは出来るぞ。』"
		   voices=""/>
		<msg @l="551" char_id="-1" frame_id="-1" name=""
		   text="\n:そう言うと熊野は猛然と二人に襲い掛かった。正確に言えば奈那子に向かってである。" voices=""/>
		<msg @l="552" char_id="-1" frame_id="-1" name=""
		   text="当然、真弥は奈那子を庇い、その身の全てで熊野の拳を受ける。" voices=""/>
		<msg @l="553" char_id="-1" frame_id="-1" name=""
		   text="熊野の思惑通り、真弥からの反撃は無かった。" voices=""/>
		<msg @l="554" char_id="-1" frame_id="-1" name=""
		   text="反撃に転ずるとしても、確実に熊野の動きを止めることが可能でなければ奈那子に危害が及ぶ。真弥にはその賭けに乗ることは出来なかった。"
		   voices=""/>
		<msg @l="558" char_id="-1" frame_id="-1" name="" text="\n:『そらそらそらそらそらっ！』"
		   voices=""/>
		<se @l="562" buf="0" src="刃物刺す音3" volume="1."/>
		<flash @l="564" count="4" fade="100" image="white"/>
		<msg @l="566" char_id="-1" frame_id="-1" name="" text="\n:『ぐっ、がっ！』"
		   voices=""/>
		<se @l="570" buf="1" src="刃物刺す音1" volume="1."/>
		<flash @l="572" count="4" fade="100" image="white"/>
		<wait @l="574" time="300"/>
		<se @l="576" buf="1" src="刃物刺す音4" volume="1."/>
		<flash @l="578" count="4" fade="100" image="white"/>
		<wait @l="580" time="300"/>
		<se @l="582" buf="1" src="刃物刺す音3" volume="1."/>
		<flash @l="584" count="4" fade="100" image="white"/>
		<wait @l="586" time="300"/>
		<se @l="588" buf="1" src="刃物刺す音1" volume="1."/>
		<flash @l="590" count="4" fade="100" image="white"/>
		<msg @l="593" char_id="-1" frame_id="-1" name="" text="\n:一方的に真弥が傷ついてゆく。"
		   voices=""/>
		<msg @l="594" char_id="-1" frame_id="-1" name=""
		   text="熊野は傷ついた真弥に対し、脚を大きく振りかぶり、渾身の力で蹴り飛ばした。" voices=""/>
		<se @l="596" buf="1" src="箱を蹴ってる" volume="1."/>
		<shake @l="598" amp="10" class="all" cycle="30" duration="1000"
		   type="random"/>
		<msg @l="600" char_id="-1" frame_id="-1" name="" page_feed="true"
		   text="真弥は吹き飛び、地面に叩きつけられた。呻き声を上げ、うずくまっている。" voices=""/>
		<page @l="603" fade="300"/>
		<msg @l="605" char_id="-1" frame_id="-1" name=""
		   text="\n:『アーッハッハッ！&#32;貴様の復讐もここまでか？』" voices=""/>
		<msg @l="607" char_id="-1" frame_id="-1" name=""
		   text="\n:あざ笑う熊野に対して、今の真弥は成す術を持たなかった。" voices=""/>
		<msg @l="608" char_id="-1" frame_id="-1" name=""
		   text="そんな真弥に熊野は余裕の言葉を叩き付ける。" voices=""/>
		<msg @l="610" char_id="-1" frame_id="-1" name=""
		   text="\n:『貴様は役に立たぬが、妹は役立つぞ。なかなか良い体をしているからな、こいつも町の慰み者の仲間入りだ！！ガハハハハッ！！』"
		   voices=""/>
		<msg @l="612" char_id="-1" frame_id="-1" name=""
		   text="\n:『な‥‥奈那子‥‥‥‥に、逃げろ‥‥‥‥』" voices=""/>
		<msg @l="614" char_id="-1" frame_id="-1" name="" text="\n:『‥‥‥‥‥‥』"
		   voices=""/>
		<msg @l="616" char_id="-1" frame_id="-1" name="" text="\n:『は、早く‥‥逃げろ‥‥』"
		   voices=""/>
		<msg @l="618" char_id="-1" frame_id="-1" name="" text="\n:『妹は物分りがいいようだな。』"
		   voices=""/>
		<msg @l="620" char_id="-1" frame_id="-1" name="" text="\n:『‥‥‥‥‥‥』"
		   voices=""/>
		<msg @l="622" char_id="-1" frame_id="-1" name="" text="\n:『な、奈那子‥‥？』"
		   voices=""/>
		<msg @l="624" char_id="-1" frame_id="-1" name="" page_feed="true"
		   text="\n:『時間が押している。どれ、役立たずの貴様には死んでもらおうか！』" voices=""/>
		<page @l="627" fade="300"/>
		<clear @l="629" class="all"/>
		<se @l="631" buf="3" loop="true" src="心臓" volume="1."/>
		<stopbgm @l="633" fadeout="1000"/>
		<flash @l="636" count="4" fade="100" image="white"/>
		<wait @l="638" time="300"/>
		<msg @l="640" char_id="-1" frame_id="-1" name="" text="\n:ドクン" voices=""/>
		<flash @l="643" count="4" fade="100" image="white"/>
		<wait @l="645" time="300"/>
		<msg @l="647" char_id="-1" frame_id="-1" name="" text="ドクンドクン" voices=""/>
		<flash @l="650" count="4" fade="100" image="white"/>
		<wait @l="652" time="300"/>
		<msg @l="654" char_id="-1" frame_id="-1" name="" text="\n:『‥‥‥ない‥‥。』"
		   voices=""/>
		<msg @l="656" char_id="-1" frame_id="-1" name=""
		   text="\n:それまで真弥の傍で呆然と座っていた奈那子の唇が、不意に動いた。" voices=""/>
		<msg @l="658" char_id="-1" frame_id="-1" name="" text="\n:『‥‥なに？』" voices=""/>
		<msg @l="660" char_id="-1" frame_id="-1" name="" page_feed="true"
		   text="\n:『な‥‥奈那子‥‥‥！？』" voices=""/>
		<page @l="663" fade="300"/>
		<label @l="666" id="chart_line70"/>
		<wait_chgmv/>
		<ev @l="669" src="ev-004"/>
		<msgshow @l="671" show="true"/>
		<msg @l="673" char_id="-1" frame_id="-1" name="" text="『‥‥せない‥‥。』" voices=""/>
		<msg @l="675" char_id="-1" frame_id="-1" name=""
		   text="\n:『ふん、諦めが良いと思ったのだがな‥‥‥小娘。』" voices=""/>
		<msg @l="677" char_id="-1" frame_id="-1" name=""
		   text="\n:『赦せない‥‥‥兄さんを、美帆を傷つける人は‥‥。』" voices=""/>
		<stopse @l="680" buf="3"/>
		<msg @l="682" char_id="-1" frame_id="-1" name="" page_feed="true"
		   text="\n:普段の奈那子とは違う、凛とした声色が風に乗って草木をざわつかせる。" voices=""/>
		<page @l="684" fade="300"/>
		<wait_chgmv/>
		<ev @l="686" src="ev-004x1"/>
		<bgm @l="688" src="bgm17" volume="1."/>
		<msg @l="690" char_id="-1" frame_id="-1" name="" page_feed="true"
		   text="\n:『ゆ・る・せ・な・い・！！』" voices=""/>
		<page @l="693" fade="300"/>
		<msg @l="695" char_id="-1" frame_id="-1" name=""
		   text="\n:『奈那子‥‥‥まさか覚醒した‥‥のか？』" voices=""/>
		<msg @l="697" char_id="-1" frame_id="-1" name="" page_feed="true"
		   text="\n:『っ？！&#32;覚醒‥だと‥‥‥まさか‥‥‥‥！？』" voices=""/>
		<page @l="700" fade="300"/>
		<clear @l="702" class="all"/>
		<msg @l="704" char_id="-1" frame_id="-1" name="" page_feed="true"
		   text="\n:\n:\n:\n:\n:\n:\n:『‥‥アナタ‥‥‥殺す。』" voices=""/>
		<page @l="707" fade="300"/>
		<wait_chgmv/>
		<bg @l="710" src="bg23a"/>
		<char @l="712" id="nanak" pos="auto" src="nanako118"/>
		<msg @l="714" char_id="-1" frame_id="-1" name="" text="ゆらり、と奈那子が熊野に近づく。"
		   voices=""/>
		<msg @l="715" char_id="-1" frame_id="-1" name="" text="先ほどまでの弱々しい雰囲気は微塵も無い。"
		   voices=""/>
		<msg @l="716" char_id="-1" frame_id="-1" name=""
		   text="ただ、圧倒的な気迫と怒りが‥‥空気を震わせていた。" voices=""/>
		<clear @l="719" class="char"/>
		<char @l="721" id="nanak" pos="left" src="nanako118"/>
		<char @l="723" id="kuma" pos="right" src="kuma018"/>
		<msg @l="725" char_id="-1" frame_id="-1" name=""
		   text="\n:『‥‥なぁっ。なっなにぃ！！この小娘もか！！だが、捻じ伏せてくれるわっ！』" voices=""/>
		<clear @l="728" layer="kuma"/>
		<msg @l="730" char_id="-1" frame_id="-1" name=""
		   text="\n:僅かな気後れを隠すように、熊野が吠えながら奈那子へと殴りかかった。" voices=""/>
		<msg @l="732" char_id="-1" frame_id="-1" name=""
		   text="\n:『小娘ぇぇぇぇぇぇぇぇぇぇぇっ！！！』" voices=""/>
		<msg @l="734" char_id="-1" frame_id="-1" name="" page_feed="true"
		   text="\n:『‥‥‥‥。』" voices=""/>
		<clear @l="737" class="all"/>
		<flash @l="740" count="4" fade="100" image="white"/>
		<se @l="742" buf="1" src="刃物刺す音1" volume="1."/>
		<page @l="744" fade="300"/>
		<msg @l="747" char_id="-1" frame_id="-1" name="" text="\n:熊野の拳が頬を奈那子を捉える。"
		   voices=""/>
		<msg @l="748" char_id="-1" frame_id="-1" name="" page_feed="true"
		   text="\n:\n:\n:否―――捉えたように見えた。" voices=""/>
		<page @l="751" fade="300"/>
		<label @l="754" id="chart_line71"/>
		<wait_chgmv/>
		<ev @l="757" src="ev-063"/>
		<msg @l="759" char_id="-1" frame_id="-1" name="" text="『な、んだと‥‥‥？』"
		   voices=""/>
		<msg @l="761" char_id="-1" frame_id="-1" name=""
		   text="\n:熊野の拳が奈那子の背後にあった木の幹へと叩き込まれる。" voices=""/>
		<msg @l="762" char_id="-1" frame_id="-1" name=""
		   text="木の幹が大きくへしゃぎ、拳がめり込んでいた。" voices=""/>
		<wait @l="764" time="300"/>
		<msg @l="766" char_id="-1" frame_id="-1" name="" text="\n:『アナタ‥‥‥遅い。』"
		   voices=""/>
		<msg @l="768" char_id="-1" frame_id="-1" name="" text="\n:『‥‥！？』" voices=""/>
		<wait_chgmv/>
		<ev @l="771" src="ev-063a"/>
		<msg @l="773" char_id="-1" frame_id="-1" name="" text="\n:熊野の背後に突如、奈那子が現れる。"
		   voices=""/>
		<msg @l="774" char_id="-1" frame_id="-1" name=""
		   text="拳が捉えたかと思われたその瞬間、消えたと思わせる速度で熊野の背後へと回り込んでいたのだ。" voices=""/>
		<msg @l="775" char_id="-1" frame_id="-1" name=""
		   text="背中に伝わる重圧で、熊野には奈那子が背後に廻り込んだことが解かった。" voices=""/>
		<msg @l="777" char_id="-1" frame_id="-1" name="" text="\n:『ば、馬鹿なっ‥‥！？』"
		   voices=""/>
		<msg @l="779" char_id="-1" frame_id="-1" name=""
		   text="\n:が、膨れ上がる重圧に後ろを振り向くことが出来ない。" voices=""/>
		<msg @l="780" char_id="-1" frame_id="-1" name="" page_feed="true"
		   text="一瞬でも気をそらせば、首から上が無くなってしまう。" voices=""/>
		<page @l="782" fade="300"/>
		<msg @l="784" char_id="-1" frame_id="-1" name=""
		   text="\n:『よせっ―――奈那子！&#32;血で汚れるのは俺だけでいいんだっ！お前まで、復讐に手を染める事はない‥‥‥。』"
		   voices=""/>
		<msg @l="786" char_id="-1" frame_id="-1" name="" page_feed="true"
		   text="\n:『兄さん‥‥ごめんなさい。でも、この人だけはどうしても許せない。母さんの仇。兄さんを傷つけ、そして美帆を悲しませる。』"
		   voices=""/>
		<page @l="789" fade="300"/>
		<msg @l="791" char_id="-1" frame_id="-1" name="" page_feed="true"
		   text="\n:『好きな人を、愛する人を奪うアナタは‥‥‥‥私が殺す。』" voices=""/>
		<clear @l="794" class="all"/>
		<stopbgm @l="796" fadeout="1000"/>
		<page @l="798" fade="300"/>
		<msg @l="801" char_id="-1" frame_id="-1" name=""
		   text="\n:奈那子が言い切った瞬間、熊野は跳んだ。" voices=""/>
		<msg @l="802" char_id="-1" frame_id="-1" name=""
		   text="動いても動かなくても、おおよその結果は見えている。" voices=""/>
		<msg @l="803" char_id="-1" frame_id="-1" name=""
		   text="ならば僅かでも可能性が‥‥熊野の生存本能がそれを後押しした。" voices=""/>
		<se @l="806" buf="1" src="刃物刺す音4" volume="1."/>
		<flash @l="808" count="4" fade="100" image="white"/>
		<msg @l="810" char_id="-1" frame_id="-1" name=""
		   text="\n:\n:&#32;&#32;────しかし、熊野の体が地面から１０センチ浮くまでの時間で奈那子は距離を詰め、熊野の首を消し飛ばしていた。"
		   voices=""/>
		<msg @l="812" char_id="-1" frame_id="-1" name=""
		   text="\n:奈那子は腕を薙いだ姿勢のまま、指先から熊野の血を滴らせる。" voices=""/>
		<msg @l="813" char_id="-1" frame_id="-1" name="" page_feed="true"
		   text="真弥は‥‥それを何処か寂しげな表情で見詰めていた。" voices=""/>
		<clear @l="817" class="all"/>
		<page @l="819" fade="300"/>
		<wait @l="821" time="1000"/>
		<bgm @l="823" src="bgm20" volume="1."/>
		<label @l="826" id="chart_line72"/>
		<wait_chgmv/>
		<ev @l="829" src="ev-053y1y2"/>
		<msg @l="831" char_id="-1" frame_id="-1" name="" text="『‥‥‥‥。』" voices=""/>
		<msg @l="833" char_id="-1" frame_id="-1" name="" text="\n:『‥‥‥‥。』"
		   voices="nanako00390"/>
		<msg @l="835" char_id="-1" frame_id="-1" name=""
		   text="\n:二人は町から離れた空き地から、南総町を眺めていた。" voices=""/>
		<msg @l="836" char_id="-1" frame_id="-1" name=""
		   text="この町を作った熊野が消えた事により、この南総町はどの様に変わっていくのだろうか。" voices=""/>
		<msg @l="837" char_id="-1" frame_id="-1" name=""
		   text="少なからず、彼に荷担し甘い蜜を啜っていた者にとって、住み辛い町になる事は間違いないだろう。" voices=""/>
		<msg @l="838" char_id="-1" frame_id="-1" name=""
		   text="ただ‥‥それでも熊野の残した爪痕は大きい。" voices=""/>
		<msg @l="839" char_id="-1" frame_id="-1" name="" page_feed="true"
		   text="南総町が正常な町として機能するまでには、かなりの時間が必要となるだろう。" voices=""/>
		<page @l="841" fade="300"/>
		<msg @l="843" char_id="-1" frame_id="-1" name=""
		   text="\n:『兄さん‥‥また、別の町に行くの？』" voices="nanako00400"/>
		<msg @l="845" char_id="-1" frame_id="-1" name=""
		   text="\n:『ああ。ここでの復讐は終わったからな。』" voices=""/>
		<msg @l="847" char_id="-1" frame_id="-1" name="" text="\n:『そう‥‥。』"
		   voices="nanako00410"/>
		<msg @l="849" char_id="-1" frame_id="-1" name="" text="\n:『寂しいのか？』"
		   voices=""/>
		<msg @l="851" char_id="-1" frame_id="-1" name="" page_feed="true"
		   text="\n:『うん‥‥少しだけ。』" voices="nanako00420"/>
		<page @l="854" fade="300"/>
		<msg @l="856" char_id="-1" frame_id="-1" name="" text="\n:奈那子はそう言って僅かに俯く。"
		   voices=""/>
		<msg @l="857" char_id="-1" frame_id="-1" name=""
		   text="熊野に一撃を与えた後、奈那子は糸が切れた人形のように気を失ってしまい‥‥目が覚めると、それまでの出来事を覚えていなかった。"
		   voices=""/>
		<msg @l="859" char_id="-1" frame_id="-1" name=""
		   text="\n:『奈那子‥‥‥お前、あの時‥‥‥‥。』" voices=""/>
		<msg @l="861" char_id="-1" frame_id="-1" name="" text="\n:『あの時ってなに？』"
		   voices="nanako00430"/>
		<msg @l="863" char_id="-1" frame_id="-1" name="" text="\n:『いや‥‥‥なんでもない。』"
		   voices=""/>
		<msg @l="865" char_id="-1" frame_id="-1" name="" text="\n:『ふふ、変な兄さん。』"
		   voices="nanako00440"/>
		<msg @l="867" char_id="-1" frame_id="-1" name=""
		   text="\n:あの時の出来事を覚えているのかいないのか、そんな事は些細なことなのだ、と真弥は改めて思う。" voices=""/>
		<msg @l="868" char_id="-1" frame_id="-1" name=""
		   text="ただ、あの日以来、彼女は真弥を「兄さん」と呼ぶようになった。" voices=""/>
		<msg @l="869" char_id="-1" frame_id="-1" name=""
		   text="だが、それも真弥にとってはどうでもよかった。" voices=""/>
		<msg @l="870" char_id="-1" frame_id="-1" name="" page_feed="true"
		   text="\n:ただ、奈那子が‥傍にいてくれればそれだけで‥‥。" voices=""/>
		<stopbgm @l="873" fadeout="1000"/>
		<clear @l="876" class="all"/>
		<page @l="878" fade="300"/>
		<wait @l="880" time="2000"/>
		<msg @l="886" char_id="-1" frame_id="-1" name="" page_feed="true"
		   text="―――数ヵ月後。" voices=""/>
		<page @l="889" fade="300"/>
		<msg @l="891" char_id="-1" frame_id="-1" name=""
		   text="―――あの南総町の一件から、数ヶ月余りが過ぎていた。" voices=""/>
		<msg @l="892" char_id="-1" frame_id="-1" name=""
		   text="奈那子は真弥との旅の中で何度か戦いを体験し、「人とは異なる力」に目覚めていた。そして今日もある都市の闇に溶け込み、二人は復讐の旅をしている――――。"
		   voices=""/>
		<label @l="896" id="chart_line74"/>
		<wait_chgmv/>
		<ev @l="900" src="ev-064"/>
		<bgm @l="904" src="bgm11" volume="1."/>
		<msg @l="906" char_id="-1" frame_id="-1" name=""
		   text="\n:&#32;&#32;『身体の調子はどうだ‥‥奈那子。』" voices=""/>
		<msg @l="908" char_id="-1" frame_id="-1" name=""
		   text="\n:&#32;&#32;『大丈夫、悪くないよ。』" voices="nanako00000"/>
		<msg @l="910" char_id="-1" frame_id="-1" name=""
		   text="\n:&#32;&#32;鉄塔の最上階近くで、奈那子と真弥が夜の町を眺めている。" voices=""/>
		<msg @l="911" char_id="-1" frame_id="-1" name=""
		   text="奈那子の瞳は赤く染まっており‥‥「人とは異なる者」として覚醒していることが解った。" voices=""/>
		<msg @l="912" char_id="-1" frame_id="-1" name=""
		   text="\n:&#32;&#32;あの日から、奈那子は時折「力」を覚醒するようになった。" voices=""/>
		<msg @l="913" char_id="-1" frame_id="-1" name=""
		   text="奈那子の感覚は鋭く、真弥の何十倍もの感性を持っていた。" voices=""/>
		<msg @l="915" char_id="-1" frame_id="-1" name="" page_feed="true"
		   text="\n:&#32;&#32;ただ、真弥は復讐を終える度に、いつもの奈那子が消えるような気がして、その度に真弥は先のような言葉をかけては‥‥‥彼女を心配していた。"
		   voices=""/>
		<page @l="918" fade="300"/>
		<msg @l="920" char_id="-1" frame_id="-1" name="" page_feed="true"
		   text="「力」に飲み込まれぬように‥‥。" voices=""/>
		<page @l="923" fade="300"/>
		<msg @l="925" char_id="-1" frame_id="-1" name=""
		   text="\n:&#32;&#32;『にいさん‥‥‥あっち、何か感じる。』" voices="nanako00010"/>
		<msg @l="927" char_id="-1" frame_id="-1" name=""
		   text="\n:&#32;&#32;『奈那子‥‥。』" voices=""/>
		<msg @l="929" char_id="-1" frame_id="-1" name="" text="\n:&#32;&#32;『‥‥？』"
		   voices=""/>
		<msg @l="931" char_id="-1" frame_id="-1" name=""
		   text="\n:&#32;&#32;『いや、なんでもない‥‥さあ、行こうか。』" voices=""/>
		<clear @l="937" class="all"/>
		<msg @l="939" char_id="-1" frame_id="-1" name=""
		   text="\n:&#32;&#32;奈那子の言葉を受けて、真弥が夜の空を跳ぶ。" voices=""/>
		<msg @l="940" char_id="-1" frame_id="-1" name="" page_feed="true"
		   text="そうして真弥の後を追うように、奈那子もその身を夜の空に投げ出した。" voices=""/>
		<page @l="942" fade="300"/>
		<msg @l="944" char_id="-1" frame_id="-1" name="" page_feed="true"
		   text="彼らの復讐の日々は‥‥未だどこかで続いている―――。" voices=""/>
		<stopbgm @l="948" fadeout="1000"/>
		<page @l="952" fade="300"/>
		<msgshow @l="954" show="false"/>
		<wait @l="956" time="2000"/>
		<description @l="970" text="再会"/>
		<eval @l="972" expr="f.numDay=0&#13;&#10;"/>
		<page @l="975" fade="300"/>
		<wait @l="977" time="3000"/>
		<msg @l="979" char_id="-1" frame_id="-1" name="" page_feed="true"
		   text="\n:\n:\n:\n:\n:\n:\n:―――そして、再会。" voices=""/>
		<page @l="982" fade="300"/>
		<label @l="984" id="chart_line75"/>
		<wait_chgmv/>
		<ev @l="987" src="ev-065"/>
		<bgm @l="990" src="bgm11" volume="1."/>
		<msg @l="992" char_id="-1" frame_id="-1" name=""
		   text="\n:&#32;&#32;『本当に‥‥これっきりだからな。』" voices=""/>
		<msg @l="994" char_id="-1" frame_id="-1" name=""
		   text="\n:&#32;&#32;『うん、わかってるよ‥‥‥にいさん。』" voices="nanako00020"/>
		<msg @l="996" char_id="-1" frame_id="-1" name=""
		   text="\n:&#32;&#32;閉口した真弥の表情とは裏腹に、奈那子は満面の笑みを浮かべている。" voices=""/>
		<msg @l="997" char_id="-1" frame_id="-1" name=""
		   text="美帆のいる場所が解った‥‥それを最初に教えてくれたのは、他でもない真弥だった。" voices=""/>
		<msg @l="998" char_id="-1" frame_id="-1" name=""
		   text="奈那子が時折寂しそうにしているのを見て‥‥気をつかったのだ。" voices=""/>
		<msg @l="1000" char_id="-1" frame_id="-1" name=""
		   text="\n:&#32;&#32;『しかし‥‥‥別に俺まで一緒に来ることは無いと思うが‥。』" voices=""/>
		<msg @l="1002" char_id="-1" frame_id="-1" name=""
		   text="\n:&#32;&#32;『ダメだよ。よく考えたらにいさんのこと、美帆にちゃ～んと紹介してないもん。』"
		   voices="nanako00030"/>
		<msg @l="1004" char_id="-1" frame_id="-1" name=""
		   text="\n:&#32;&#32;『紹介なんて必要ない‥‥俺のような人間とは関わらない方が彼女にはいいんだぞ。』" voices=""/>
		<msg @l="1006" char_id="-1" frame_id="-1" name=""
		   text="\n:&#32;&#32;『ぷぅ～、だ～め～。』" voices="nanako00040"/>
		<msg @l="1008" char_id="-1" frame_id="-1" name=""
		   text="\n:&#32;&#32;『‥‥‥‥。』" voices=""/>
		<msg @l="1010" char_id="-1" frame_id="-1" name=""
		   text="\n:&#32;&#32;奈那子の言葉に真弥は口をつぐみ、やれやれといった表情を浮かべる。" voices=""/>
		<msg @l="1011" char_id="-1" frame_id="-1" name="" page_feed="true"
		   text="普段は聞き分けの良い奈那子も、いざ美帆のことになると、まったく真弥の言うことを聞こうとしない。" voices=""/>
		<page @l="1014" fade="300"/>
		<msg @l="1016" char_id="-1" frame_id="-1" name=""
		   text="ただ‥‥そんな奈那子のわがままが聞けるのも、真弥にとってはわずかな喜びとなっていることは否めなかった。" voices=""/>
		<msg @l="1017" char_id="-1" frame_id="-1" name="" page_feed="true"
		   text="\n:&#32;&#32;「人とは異なる者」と「人」‥‥そんな小さな差異で全てを捨ててしまうのは、やはり辛い。" voices=""/>
		<page @l="1020" fade="300"/>
		<msg @l="1022" char_id="-1" frame_id="-1" name=""
		   text="\n:&#32;&#32;あの事件以来、奈那子は急速に覚醒しつつあった。" voices=""/>
		<msg @l="1023" char_id="-1" frame_id="-1" name=""
		   text="このままいけば近いうちに「人とは異なる者」として完全に目覚める日が来るだろう。" voices=""/>
		<msg @l="1024" char_id="-1" frame_id="-1" name=""
		   text="\n:それは、同時に内なる破壊衝動との、孤独な闘いのはじまりを意味する。" voices=""/>
		<msg @l="1025" char_id="-1" frame_id="-1" name="" page_feed="true"
		   text="\n:&#32;&#32;最悪の場合、自らの手で最愛の妹を葬らねばならない‥‥という事もありえるのだ。" voices=""/>
		<page @l="1028" fade="300"/>
		<msg @l="1030" char_id="-1" frame_id="-1" name=""
		   text="\n:&#32;&#32;だが、しかし‥‥。" voices=""/>
		<msg @l="1031" char_id="-1" frame_id="-1" name=""
		   text="それまではせめて人並みの友情を味あわせてやりたい。" voices=""/>
		<msg @l="1032" char_id="-1" frame_id="-1" name=""
		   text="それに、あの美帆という少女はどことなく亡き母を思わせる雰囲気がある。" voices=""/>
		<msg @l="1034" char_id="-1" frame_id="-1" name=""
		   text="\n:&#32;&#32;『会いたいのは奈那子だけじゃないのかもな‥‥。』" voices=""/>
		<msg @l="1036" char_id="-1" frame_id="-1" name="" page_feed="true"
		   text="\n:&#32;&#32;そう言って真弥は西の空を見上げた。" voices=""/>
		<clear @l="1040" class="all"/>
		<page @l="1042" fade="300"/>
		<msg @l="1044" char_id="-1" frame_id="-1" name="" text="どれくらい時間が流れたのだろう―――。"
		   voices=""/>
		<msg @l="1045" char_id="-1" frame_id="-1" name="" page_feed="true"
		   text="日はすっかり落ちかけ、オレンジ色の夕焼けがあたりを包んでいる。" voices=""/>
		<page @l="1048" fade="300"/>
		<char @l="1050" id="shiny" pos="left" src="shinya010"/>
		<msg @l="1052" char_id="-1" frame_id="-1" name="" text="\n:&#32;&#32;『奈那子。』"
		   voices=""/>
		<char @l="1055" id="nanak" pos="right" src="nanako019"/>
		<msg @l="1057" char_id="-1" frame_id="-1" name="" text="\n:&#32;&#32;『うん？』"
		   voices="nanako00050"/>
		<msg @l="1059" char_id="-1" frame_id="-1" name=""
		   text="\n:&#32;&#32;真弥は何も言わず、黙って道の先を見るように顎先を動かす。" voices=""/>
		<stopbgm @l="1063" fadeout="1000"/>
		<char @l="1066" id="nanak" pos="right" src="nanako014"/>
		<msg @l="1068" char_id="-1" frame_id="-1" name="" text="\n:&#32;&#32;『あっ！』"
		   voices="nanako00060"/>
		<msg @l="1070" char_id="-1" frame_id="-1" name=""
		   text="\n:&#32;&#32;道の先には美帆の姿があった。" voices=""/>
		<msg @l="1071" char_id="-1" frame_id="-1" name=""
		   text="\n:&#32;&#32;最後に会ったのは数ヶ月前の、あの日―――。" voices=""/>
		<msg @l="1072" char_id="-1" frame_id="-1" name="" page_feed="true"
		   text="廃道へと彼女を導いた以来である。" voices=""/>
		<clear @l="1078" class="all"/>
		<page @l="1080" fade="300"/>
		<label @l="1084" id="chart_line76"/>
		<wait_chgmv/>
		<ev @l="1088" src="ev-060"/>
		<bgm @l="1092" src="bgm02" volume="1."/>
		<msg @l="1094" char_id="-1" frame_id="-1" name="" text="『美帆っ！！』"
		   voices="nanako00070"/>
		<msg @l="1096" char_id="-1" frame_id="-1" name=""
		   text="\n:&#32;&#32;『え、奈那子‥‥‥ちゃん！？』" voices="miho13520"/>
		<msg @l="1098" char_id="-1" frame_id="-1" name=""
		   text="\n:&#32;&#32;奈那子は美帆に駆け寄り、いきなり抱きつく。" voices=""/>
		<msg @l="1099" char_id="-1" frame_id="-1" name="" page_feed="true"
		   text="美帆は、そんな奈那子を受け止めながら‥‥驚きの表情を浮かべていた。" voices=""/>
		<page @l="1102" fade="300"/>
		<msg @l="1104" char_id="-1" frame_id="-1" name=""
		   text="\n:&#32;&#32;『こんな日が‥‥いつまでも続けばいいのにな。』" voices=""/>
		<msg @l="1106" char_id="-1" frame_id="-1" name=""
		   text="\n:&#32;&#32;二人をぼんやりと眺めながら‥‥真弥がぽつりとつぶやいた。" voices=""/>
		<msg @l="1107" char_id="-1" frame_id="-1" name="" page_feed="true"
		   text="寂しさと、優しさの混じった複雑な表情を浮かべながら‥‥。" voices=""/>
		<stopbgm @l="1111" fadeout="1000"/>
		<clear @l="1115" class="all"/>
		<page @l="1118" fade="300"/>
		<msg @l="1122" char_id="-1" frame_id="-1" name="" page_feed="true"
		   text="\n:狂気の街から、無事に逃れることが出来た彼女の人生が‥‥そして、これからの自分たちの人生が‥‥つつましやかに続く事を祈って―――。"
		   voices=""/>
		<page @l="1130" fade="300"/>
		<clear @l="1132" class="char"/>
		<msgshow @l="1134" show="false"/>
		<wait_chgmv/>
		<bg @l="1136" src="white" time="3000"/>
		<clear @l="1138" class="ev"/>
		<wait_chgmv/>
		<bg @l="1140" src="white"/>
		<wait @l="1142" time="6000"/>
		<eval @l="1145" expr="s.event60flag=1&#13;&#10;"/>
		<eval @l="1148"
		   expr="f.bEx&#32;=&#32;s.event20flag&#32;&amp;&amp;&#32;s.event23flag&#32;&amp;&amp;&#32;s.event25flag&#32;&amp;&amp;&#32;s.event30flag&#32;&amp;&amp;&#32;s.event31flag&#32;&amp;&amp;&#32;s.event32flag&#32;&amp;&amp;&#32;s.event33flag&#32;&amp;&amp;&#32;s.event35flag&#32;&amp;&amp;&#32;s.event37flag&#32;&amp;&amp;&#32;s.event38flag&#32;&amp;&amp;&#32;s.event60flag&#13;&#10;"/>
		<goto @l="1150" cond="!(f.bEx)&#13;&#10;" label="TempLabel_324"/>
		<eval @l="1152" expr="s.exRootFlag=1&#13;&#10;"/>
		<label @l="1153" id="TempLabel_324"/>
		<call @l="1155" target="EventLabel_155@staffroom"/>
		<goto @l="1157" cond="!(f.bEx)&#13;&#10;" label="TempLabel_325"/>
		<wait_chgmv/>
		<bg @l="1161" src="newroot"/>
		<wait @l="1163" time="5000"/>
		<wait_chgmv/>
		<bg @l="1165" src="black"/>
		<label @l="1168" id="TempLabel_325"/>
		<return @l="1174" value=""/>
	</code>
</xscript>
