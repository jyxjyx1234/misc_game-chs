<?xml version="1.0" encoding="utf-8"?>
<xscript>
	<debug editor="&quot;C:\Program&#32;Files&#32;(x86)\sakura\sakura.exe&quot;&#32;&quot;%src%&quot;&#32;-Y=%line%"
	   src="D:\シロップ\町ぐるみの罠＋汚された夏セット版\汚された夏\完成データ\汚された夏\script\text\ending09.txt"/>
	<code>
		<label @l="12" id="EventLabel_47"/>
		<description @l="16" text="消える自我(ココロ)"/>
		<eval @l="18" expr="f.numDay=0&#13;&#10;"/>
		<bgm @l="21" src="bgm14" volume="1."/>
		<msg @l="23" char_id="-1" frame_id="-1" name=""
		   text="――電車内で乗客たちに輪姦調教された後、美帆はその時乗車していた乗客達から毎日指定の電車に乗るように呼び出されるようになった。"
		   voices=""/>
		<msg @l="24" char_id="-1" frame_id="-1" name=""
		   text="その電車は痴漢好きの男達しか乗っていない痴漢車両と化していて、美帆は乗車するたびに輪姦され凌辱の限りを尽くされる。"
		   voices=""/>
		<msg @l="25" char_id="-1" frame_id="-1" name=""
		   text="そして何十人もの男達の精液を膣内に、身体中に浴びせられいつも白濁液まみれにされていた。" voices=""/>
		<stopbgm @l="29" fadeout="1000"/>
		<clear @l="35" class="all"/>
		<msgshow @l="37" show="true"/>
		<wait_chgmv/>
		<bg @l="41" src="bg18a"/>
		<char @l="47" id="miho" pos="auto" src="miho120"/>
		<msg @l="49" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』"
		   voices="miho11970"/>
		<msg @l="51" char_id="-1" frame_id="-1" name="" text="―――数週間後。" voices=""/>
		<msg @l="52" char_id="-1" frame_id="-1" name=""
		   text="美帆は何処か吹っ切れたような気持ちで駅前を歩いていた。" voices=""/>
		<msg @l="53" char_id="-1" frame_id="-1" name=""
		   text="大学帰り、いつもの用に帰りの電車に乗るため停留所へと向かう。" voices=""/>
		<msg @l="54" char_id="-1" frame_id="-1" name=""
		   text="だが、美帆はもう誰に脅されて呼び出されているわけではなかった。" voices=""/>
		<msg @l="55" char_id="-1" frame_id="-1" name=""
		   text="多数の人間に輪姦される快楽が忘れなくて････自ら痴漢されたくて向かっていたのだった。" voices=""/>
		<clear @l="62" class="all"/>
		<msgshow @l="64" show="true"/>
		<label @l="67" id="event_scene33"/>
		<bgm @l="71" src="bgm04" volume="1."/>
		<msg @l="73" char_id="-1" frame_id="-1" name=""
		   text="電車に乗ると早速近くの乗客手を伸ばしてきて私のお尻を触ってくる。" voices=""/>
		<msg @l="75" char_id="-1" frame_id="-1" name="学生" text="『お、お姉さんのお尻柔らかいね。』"
		   voices=""/>
		<msg @l="77" char_id="-1" frame_id="-1" name=""
		   text="乗客である学生は美帆に抱きつきながら両手で撫で回してくる。" voices=""/>
		<msg @l="79" char_id="0" frame_id="-1" name="美帆"
		   text="『あっ、ちょっと待って。服脱ぐから････』" voices=""/>
		<msg @l="81" char_id="-1" frame_id="-1" name=""
		   text="だが、私は触られるだけではもう満足せず衆人環視の中で公共の場で凌辱される事でしか快感を覚えなくなっていたので、自ら服を脱ぎ始めた。"
		   voices=""/>
		<msg @l="83" char_id="0" frame_id="-1" name="美帆"
		   text="『私、電車の中で裸になって犯されないと感じないの････。』" voices=""/>
		<msg @l="85" char_id="-1" frame_id="-1" name=""
		   text="美帆はそう言うと裸になって窓に手をつけお尻を突き出す。" voices=""/>
		<msg @l="87" char_id="0" frame_id="-1" name="美帆"
		   text="『お姉さんのココに、あなたの立派なオ●ンチンを入れて。』" voices=""/>
		<msg @l="89" char_id="-1" frame_id="-1" name="" text="美帆は指で秘部を拡げ悩ましげな声で言う。"
		   voices=""/>
		<msg @l="91" char_id="-1" frame_id="-1" name="学生"
		   text="『うわぁ、夢みたいだ。電車の中でこんな可愛いお姉さんとＨ出来るなんて。』" voices=""/>
		<msg @l="93" char_id="-1" frame_id="-1" name=""
		   text="そう言うと学生は、美帆の小柄な身体を背中から抱きしめ、ほっそりとした腰を掴み肉棒を秘裂に埋めていく。" voices=""/>
		<se @l="97" buf="3" loop="true" src="電車走行中" volume="1."/>
		<label @l="101" id="chart_line49"/>
		<wait_chgmv/>
		<ev @l="105" src="ev-033"/>
		<msg @l="108" char_id="0" frame_id="-1" name="美帆" text="『んっ‥‥ああっ‥‥‥‥。』"
		   voices="miho11990"/>
		<msg @l="110" char_id="-1" frame_id="-1" name=""
		   text="学生は美帆の熱く潤った膣内を肉棒で激しく掻き混ぜる。すると強大な肉茎に貫かれ押し拡げられた秘裂からは、ぐちゅぐちゅといやらしい水音が響いてきた。"
		   voices=""/>
		<msg @l="112" char_id="0" frame_id="-1" name="美帆" text="『ん、んんっ‥‥‥んぁぁっ。』"
		   voices="miho10940"/>
		<msg @l="114" char_id="-1" frame_id="-1" name="学生"
		   text="『うぉぉ、凄いよお姉さん。繋がっている部分が泡だってお姉さんのいやらしい汁があふれてくるよ。』" voices=""/>
		<msg @l="116" char_id="-1" frame_id="-1" name=""
		   text="私の中に男根を突き入れている男子学生が、周りをはばからず歓喜の声をあげる。" voices=""/>
		<msg @l="117" char_id="-1" frame_id="-1" name=""
		   text="他の乗客達は美帆の犯される様を見て、早く自分の順番が来ないかと順番待ちをしている。" voices=""/>
		<msg @l="118" char_id="-1" frame_id="-1" name=""
		   text="また二人の痴態を見て、待ちきれない乗客は私の身体中を触ったり、自分のモノを美帆の火照った肌に押し付けてきたりしていた。"
		   voices=""/>
		<msg @l="120" char_id="0" frame_id="-1" name="美帆"
		   text="『ああっ‥‥ん、あっ、ああっ‥‥‥‥ん、あふっ！』" voices="miho12000"/>
		<msg @l="122" char_id="-1" frame_id="-1" name=""
		   text="学生は抽送する度に秘裂が赤くめくれあがる結合部を見ると、さらに興奮し腰を大きくグラインドさせ子宮口を突き上げる。" voices=""/>
		<msg @l="124" char_id="0" frame_id="-1" name="美帆" text="『あっ、あっ、あっ‥‥んんっ‥‥‥。』"
		   voices="miho11010"/>
		<msg @l="126" char_id="0" frame_id="-1" name="美帆"
		   text="『いっ‥‥ああ、あああっっ‥‥‥んくっ。』" voices="miho11020"/>
		<msg @l="128" char_id="-1" frame_id="1" name="学生"
		   text="（年上のお姉さんが、僕の挿入で感じている。）" voices=""/>
		<msg @l="130" char_id="-1" frame_id="-1" name=""
		   text="学生は美帆の反応を見てそう思うと、もっと感じさせたくなり美帆の白い肌を舐めまわして、いきなり背中にキスをして舌を這わせた。"
		   voices=""/>
		<msg @l="132" char_id="0" frame_id="-1" name="美帆" text="『んんっっ！』"
		   voices="miho10930"/>
		<msg @l="134" char_id="0" frame_id="-1" name="美帆" text="『ん、んんっ‥‥‥んぁぁっ。』"
		   voices="miho10940"/>
		<msg @l="136" char_id="-1" frame_id="1" name="学生"
		   text="（うわっ、凄く締め付けてきた！も、もう我慢できない）" voices=""/>
		<msg @l="138" char_id="-1" frame_id="-1" name="学生"
		   text="『ね、ねぇおねぇさん‥‥中に出してもいい？』" voices=""/>
		<msg @l="140" char_id="0" frame_id="-1" name="美帆"
		   text="『出してぇー、いっぱい濃いのを中にだしてぇー‥‥‥‥。』" voices="miho12010"/>
		<msg @l="142" char_id="-1" frame_id="-1" name="学生" text="『出すよ、お姉さんの中に出すよ！！』"
		   voices=""/>
		<msg @l="144" char_id="0" frame_id="-1" name="美帆"
		   text="『んんっ、んっ、んっ‥‥‥んっ‥‥‥ああっ！』" voices="miho12020"/>
		<msg @l="146" char_id="-1" frame_id="-1" name="学生"
		   text="『ああ、ああっ‥‥‥も、もう限界っ！』" voices=""/>
		<msg @l="148" char_id="-1" frame_id="-1" name=""
		   text="情けない声をあげて、激しく腰を打ち付けてくる学生。" voices=""/>
		<msg @l="149" char_id="-1" frame_id="-1" name=""
		   text="脚がガクガクと振るえて‥‥今にも射精してしまいそうだ。" voices=""/>
		<msg @l="151" char_id="0" frame_id="-1" name="美帆"
		   text="『ん、んんっ‥‥‥んっ‥‥‥あふっ‥‥‥‥‥ん、ああああっ！』" voices="miho12030"/>
		<msg @l="153" char_id="-1" frame_id="-1" name=""
		   text="美帆もまた‥‥一滴でも多く精液をしぼりとろうと肉壁で肉棒をギュッと締めつける。" voices=""/>
		<msg @l="155" char_id="-1" frame_id="-1" name="学生" text="『く、ああっ！』" voices=""/>
		<msg @l="157" char_id="0" frame_id="-1" name="美帆" text="『んん――――っ！！』"
		   voices="miho11030"/>
		<flash @l="161" count="4" fade="100" image="white"/>
		<wait_chgmv/>
		<ev @l="165" src="ev-033x1"/>
		<msg @l="167" char_id="0" frame_id="-1" name="美帆" text="『ん、あああああああっ！！』"
		   voices="miho11040"/>
		<msg @l="169" char_id="0" frame_id="-1" name="美帆"
		   text="『んっ、あっ、ああっ‥‥‥‥んんっ‥‥‥‥‥‥。』" voices="miho12040"/>
		<msg @l="171" char_id="-1" frame_id="-1" name=""
		   text="膣内にドク、ドク、ドク、ドク、ドクと、熱い樹液が流れ込んでくる。その熱い精液の感触に、美帆は肉体を震わせ絶頂し恍惚とした表情で荒い息をつく。"
		   voices=""/>
		<msg @l="173" char_id="-1" frame_id="-1" name="学生"
		   text="『お、お姉さんもイっちゃったんだ‥‥。俺嬉しいよ。』" voices=""/>
		<msg @l="175" char_id="-1" frame_id="-1" name=""
		   text="ビクビクと身体を震わせている美帆を見て‥‥学生が嬉しそうに言う。" voices=""/>
		<clear @l="181" class="all"/>
		<msg @l="183" char_id="0" frame_id="-1" name="美帆" text="『んふ‥‥‥また、痴漢してね。』"
		   voices="miho12050"/>
		<msg @l="185" char_id="-1" frame_id="-1" name=""
		   text="美帆は絶頂の余韻に浸りながら、ささやくように言う。" voices=""/>
		<msg @l="186" char_id="-1" frame_id="-1" name=""
		   text="学生は美帆の言葉を聞いて嬉しそうに何かを言ったみたいだが、美帆にその言葉は届かなかった。" voices=""/>
		<msg @l="187" char_id="-1" frame_id="-1" name=""
		   text="既に次の男が美帆の胸を揉み乳首を舐めながら、自分の肉棒を入れようとしていた。" voices=""/>
		<msg @l="189" char_id="0" frame_id="-1" name="美帆"
		   text="(あはっ‥‥‥あと十五分‥‥‥何人、中にだしてくれるのかな)" voices="miho12060"/>
		<msg @l="191" char_id="-1" frame_id="-1" name=""
		   text="そうやって美帆は通学中の電車でのプレイを愉しんでいた。" voices=""/>
		<msg @l="192" char_id="-1" frame_id="-1" name="" text="これから卒業するまでずっと････"
		   voices=""/>
		<stopse @l="197" buf="3"/>
		<stopbgm @l="201" fadeout="1000"/>
		<clear @l="207" class="all"/>
		<end_scene @l="210"/>
		<eval @l="214" expr="s.flagGallery=1&#13;&#10;"/>
		<eval @l="216" expr="s.event33flag=1&#13;&#10;"/>
		<eval @l="220"
		   expr="f.bEx&#32;=&#32;s.event20flag&#32;&amp;&amp;&#32;s.event23flag&#32;&amp;&amp;&#32;s.event25flag&#32;&amp;&amp;&#32;s.event30flag&#32;&amp;&amp;&#32;s.event31flag&#32;&amp;&amp;&#32;s.event32flag&#32;&amp;&amp;&#32;s.event33flag&#32;&amp;&amp;&#32;s.event35flag&#32;&amp;&amp;&#32;s.event37flag&#32;&amp;&amp;&#32;s.event38flag&#32;&amp;&amp;&#32;s.event60flag&#13;&#10;"/>
		<goto @l="222" cond="!(f.bEx)&#13;&#10;" label="TempLabel_201"/>
		<eval @l="224" expr="s.exRootFlag=1&#13;&#10;"/>
		<label @l="225" id="TempLabel_201"/>
		<ending @l="227"/>
		<goto @l="229" cond="!(f.bEx)&#13;&#10;" label="TempLabel_202"/>
		<wait_chgmv/>
		<bg @l="233" src="newroot"/>
		<wait @l="235" time="5000"/>
		<wait_chgmv/>
		<bg @l="237" src="black"/>
		<label @l="240" id="TempLabel_202"/>
		<return @l="244" value=""/>
	</code>
</xscript>
