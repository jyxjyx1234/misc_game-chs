<?xml version="1.0" encoding="utf-8"?>
<xscript>
	<debug editor="&quot;C:\Program&#32;Files&#32;(x86)\sakura\sakura.exe&quot;&#32;&quot;%src%&quot;&#32;-Y=%line%"
	   src="D:\シロップ\町ぐるみの罠＋汚された夏セット版\汚された夏\完成データ\汚された夏\script\text\ending01.txt"/>
	<code>
		<label @l="10" id="EventLabel_39"/>
		<description @l="13" text="街の娼婦"/>
		<eval @l="15" expr="f.numDay=0&#13;&#10;"/>
		<wait_chgmv/>
		<bg @l="19" src="bg04"/>
		<bgm @l="23" src="bgm03" volume="1."/>
		<msg @l="25" char_id="-1" frame_id="-1" name=""
		   text="――電車内での朽木教授の恥辱･･････美帆の頭の中は真っ白になり、その場で気を失い崩れ落ちた。" voices=""/>
		<msg @l="26" char_id="-1" frame_id="-1" name=""
		   text="目覚めたとき、美帆は朽木教授の部屋へ連れこまれていた。そして、電車内の悪夢は場所を移し続けられる。" voices=""/>
		<msg @l="27" char_id="-1" frame_id="-1" name=""
		   text="朽木教授の部屋に監禁され、男を喜ばせる為のありとあらゆるテクニックを仕込まれ、今や雌奴隷へと調教されてしまった。" voices=""/>
		<msg @l="28" char_id="-1" frame_id="-1" name="" text="そして一ヵ月後―――。" voices=""/>
		<msg @l="29" char_id="-1" frame_id="-1" name=""
		   text="解放された美帆は、朽木教授より自分の住まいでイメクラまがいの“仕事”を営み、客を取るように命令を受けたのであった。いくら雌奴隷にされたとはいえ客を取るのは抵抗がある。"
		   voices=""/>
		<msg @l="30" char_id="-1" frame_id="-1" name=""
		   text="が、調教を受けた際に教授によって撮影された淫らな画像を脅迫のネタとして持たれた以上、抵抗する術を失った。" voices=""/>
		<msg @l="31" char_id="-1" frame_id="-1" name=""
		   text="いや･･････堕ちた美帆には最初から抵抗するつもりなどなかったのかもしれない。" voices=""/>
		<msg @l="32" char_id="-1" frame_id="-1" name=""
		   text="しかし、朽木教授の指示、この“仕事”には･･････からくりがあった" voices=""/>
		<wait_chgmv/>
		<bg @l="35" src="bg23a"/>
		<msg @l="39" char_id="-1" frame_id="-1" name=""
		   text="実はこの南総町では、人口減少と経済悪化の問題を解決する為に、町全体を巨大な性欲処理場に変えるという計画が進められていた。"
		   voices=""/>
		<msg @l="40" char_id="-1" frame_id="-1" name=""
		   text="この計画により、誘致されてきた企業は社員証さえ見せれば無料で性的サービスが受けられる。その見返りとして企業は地元に多大な経済効果をもたらすのだ。"
		   voices=""/>
		<msg @l="41" char_id="-1" frame_id="-1" name=""
		   text="既に多数の大企業が進出を決定し、町のあらゆる商店や住宅で女性たちが夜の顔を持つようになっていった‥‥。" voices=""/>
		<msg @l="42" char_id="-1" frame_id="-1" name=""
		   text="美帆も自分では知らないがその一人として組み込まれた――" voices=""/>
		<msg @l="43" char_id="-1" frame_id="-1" name=""
		   text="もちろん、美帆は何が起きているか知る由もなかった。" voices=""/>
		<msg @l="46" char_id="-1" frame_id="-1" name="" text="そしてあれから数ヶ月‥‥。"
		   voices=""/>
		<msg @l="47" char_id="-1" frame_id="-1" name=""
		   text="私は朽木教授の言うとおりお客を取らされていた。" voices=""/>
		<wait_chgmv/>
		<bg @l="51" src="bg05"/>
		<se @l="55" buf="1" src="呼び鈴_壁越しでくぐもってる" volume="1."/>
		<msg @l="57" char_id="-1" frame_id="-1" name="" text="部屋の呼び鈴が鳴る。" voices=""/>
		<msg @l="58" char_id="-1" frame_id="-1" name="" text="また私の身体を求めてお客が来たようだ。"
		   voices=""/>
		<msg @l="59" char_id="-1" frame_id="-1" name=""
		   text="玲さんは‥‥今日は企業の説明会だとか言って３０分程前に出かけてしまったばかりだ。おそらく夕方までは戻らないだろう。もちろん玲さんにはこの仕事を隠している。"
		   voices=""/>
		<msg @l="60" char_id="-1" frame_id="-1" name=""
		   text="朽木教授には、お客を取る時は玲さんがいない時間にしてもらっていた。" voices=""/>
		<msg @l="61" char_id="-1" frame_id="-1" name=""
		   text="自分の部屋にお客を入れ、いつも寝ているベッドの上で“仕事”を行うにはかなりの抵抗があった。" voices=""/>
		<msg @l="62" char_id="-1" frame_id="-1" name=""
		   text="しかし、美帆の自宅の方が恋人同士のようで萌えるというお客からのリクエストも強く、必ず大半の客が自室を希望した。" voices=""/>
		<msg @l="65" char_id="0" frame_id="-1" name="美帆" text="『‥‥どうぞ。』"
		   voices="miho10790"/>
		<msg @l="68" char_id="-1" frame_id="-1" name="" text="私は玄関へお客を出迎えにいく。"
		   voices=""/>
		<wait_chgmv/>
		<bg @l="72" src="bg03"/>
		<char @l="76" id="miho" pos="auto" src="miho110"/>
		<msg @l="78" char_id="0" frame_id="-1" name="美帆" text="『いらっしゃいませ。』"
		   voices="miho10800"/>
		<msg @l="80" char_id="-1" frame_id="-1" name="客" text="『へへ、美帆ちゃん。今日も来たよっ。』"
		   voices=""/>
		<msg @l="82" char_id="-1" frame_id="-1" name=""
		   text="リビングに、これからお客となる男の人を招き入れる。" voices=""/>
		<msg @l="83" char_id="-1" frame_id="-1" name="" text="週に３回は来る、常連の人であった。"
		   voices=""/>
		<msg @l="84" char_id="-1" frame_id="-1" name=""
		   text="４０代後半のサラリーマンで、頭が禿げ上がり牛乳瓶の底のようなメガネをかけているパッとしない男の人だった。" voices=""/>
		<msg @l="85" char_id="-1" frame_id="-1" name=""
		   text="大学に通う電車内での、朽木教授による痴漢現場を見ていたらしく、その時に目をつけたらしい。" voices=""/>
		<msg @l="87" char_id="0" frame_id="-1" name="美帆"
		   text="『あの、ここではなんですので‥‥部屋の方へどうぞ。』" voices="miho10810"/>
		<msg @l="89" char_id="-1" frame_id="-1" name="客"
		   text="『玄関で裸エプロンを着せる幼妻プレイもいいんだけど‥‥今日は別のシチュエーションでやりたいので部屋に行こうかー。』"
		   voices=""/>
		<msg @l="91" char_id="0" frame_id="-1" name="美帆" text="『‥‥はい。』"
		   voices="miho10820"/>
		<wait_chgmv/>
		<bg @l="95" src="bg01"/>
		<char @l="99" id="miho" pos="auto" src="miho110"/>
		<msg @l="101" char_id="0" frame_id="-1" name="美帆" text="『今日はどれをお使いになりますか？』"
		   voices="miho10830"/>
		<msg @l="103" char_id="-1" frame_id="-1" name=""
		   text="私はクローゼットを開き、お客に衣装を見せる。" voices=""/>
		<msg @l="104" char_id="-1" frame_id="-1" name=""
		   text="クローゼットの中には私の「仕事着」が全て綺麗に並べてあった。" voices=""/>
		<msg @l="106" char_id="-1" frame_id="-1" name="客"
		   text="『今日さー、学校の横を通ったら運動会をやっていたんだけどねー、ブルマ姿の女の子がいっぱいいたんだよ。もうその姿をみたらブルマ姿の女の子を犯したくなっっちゃて！』"
		   voices=""/>
		<msg @l="108" char_id="-1" frame_id="-1" name="客" text="『だから、今日はブルマで宜しくね。』"
		   voices=""/>
		<msg @l="110" char_id="0" frame_id="-1" name="美帆" text="『かしこまりました。』"
		   voices="miho10840"/>
		<clear @l="114" class="char"/>
		<char @l="117" id="miho" pos="auto" src="miho186"/>
		<msg @l="119" char_id="-1" frame_id="-1" name=""
		   text="私はクローゼットの中から体操服とブルマを取り出し、お客が見ている目の前でゆっくりとそれに着替える。" voices=""/>
		<msg @l="121" char_id="-1" frame_id="-1" name="客"
		   text="『何度見てもいいなぁ、美帆ちゃんの身体は。すぐにでもむしゃぶりつきたくなるね。』" voices=""/>
		<clear @l="124" class="char"/>
		<char @l="127" id="miho" pos="auto" src="miho106"/>
		<msg @l="129" char_id="-1" frame_id="-1" name=""
		   text="着替えをしている所は見られ慣れているはずなのに、お客が食い入るように視姦してくると恥ずかしくなる。" voices=""/>
		<msg @l="130" char_id="-1" frame_id="-1" name=""
		   text="そして視られているだけで‥‥私のアソコからは大量の蜜が溢れだしてきた。" voices=""/>
		<msg @l="132" char_id="-1" frame_id="-1" name="" text="くちゅっ" voices=""/>
		<clear @l="135" class="char"/>
		<msg @l="137" char_id="0" frame_id="-1" name="美帆" text="『あの‥‥着替え終わりました。』"
		   voices="miho10850"/>
		<msg @l="139" char_id="-1" frame_id="-1" name="客"
		   text="『よしよし、それじゃあベッドに横になって！』" voices=""/>
		<clear @l="145" class="all"/>
		<label @l="148" id="event_scene27"/>
		<msg @l="150" char_id="-1" frame_id="-1" name=""
		   text="そうして彼は、体操服姿に着替えた私をベッドへと押し倒す。" voices=""/>
		<msg @l="151" char_id="-1" frame_id="-1" name=""
		   text="ここに好んで来るお客は、皆一様に「犯したい」人たちだ。" voices=""/>
		<msg @l="152" char_id="-1" frame_id="-1" name=""
		   text="だから、私はただ相手のすることに身を任せていればいい。" voices=""/>
		<msg @l="153" char_id="-1" frame_id="-1" name="" text="心を開く必要は無い。" voices=""/>
		<msg @l="154" char_id="-1" frame_id="-1" name=""
		   text="黙って身体を開いていれば‥‥喜んでもらえるのだから‥‥。" voices=""/>
		<label @l="158" id="chart_line5"/>
		<wait_chgmv/>
		<ev @l="162" src="ev-027"/>
		<bgm @l="166" src="bgm14" volume="1."/>
		<msg @l="168" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』"
		   voices="miho10860"/>
		<msg @l="170" char_id="-1" frame_id="-1" name=""
		   text="体操服姿のまま、私は大きく脚を広げさせられる。" voices=""/>
		<msg @l="171" char_id="-1" frame_id="-1" name=""
		   text="ブルマ越しにアソコへ熱い視線を感じて‥‥私は微かに吐息を漏らす。" voices=""/>
		<msg @l="172" char_id="-1" frame_id="-1" name=""
		   text="すでにみつめられるだけで、私は甘美な感覚を受け、身体が疼くのであった。" voices=""/>
		<msg @l="174" char_id="-1" frame_id="-1" name="客"
		   text="『美帆ちゃんのブルマ姿、いいね！可愛いねぇ！！』" voices=""/>
		<msg @l="176" char_id="-1" frame_id="-1" name=""
		   text="私のアソコへ息が掛かるほど間近まで顔を近づけて、彼が言う。" voices=""/>
		<msg @l="177" char_id="-1" frame_id="-1" name=""
		   text="そうしている間も、指先は絶えず太腿をクネクネと這いずりまわっていた。" voices=""/>
		<msg @l="179" char_id="0" frame_id="-1" name="美帆" text="『ありがとう‥‥ございます。』"
		   voices="miho10870"/>
		<msg @l="181" char_id="-1" frame_id="-1" name=""
		   text="背筋を駆け巡るゾクゾクとした感覚に身体を震わせながら、私は彼のなすがままに身体を預けることにする。" voices=""/>
		<msg @l="182" char_id="-1" frame_id="-1" name=""
		   text="ますます蜜壺には、湧き出すがように粘っこい液が溢れかえった。" voices=""/>
		<msg @l="184" char_id="-1" frame_id="-1" name="客"
		   text="『ふふっ、美帆ちゃんのココ熱いよ。それに動いている。』" voices=""/>
		<msg @l="186" char_id="-1" frame_id="-1" name=""
		   text="そういいながらお客はブルマの布地越しに、下の形を確認するように指をあてがい少しずつ力を加えてくる。さらに指を動かしてくると私の秘所からは湿り気を帯びてくる。"
		   voices=""/>
		<msg @l="188" char_id="0" frame_id="-1" name="美帆" text="『んっ‥‥‥ああっ‥‥‥‥‥‥。』"
		   voices="miho10190"/>
		<msg @l="190" char_id="-1" frame_id="-1" name="客"
		   text="『美帆ちゃんはエッチだなー。ココをちょっと弄っただけでこんなに濡らすなんて。』" voices=""/>
		<msg @l="192" char_id="0" frame_id="-1" name="美帆" text="『そん‥‥な‥‥‥。』"
		   voices="miho10220"/>
		<msg @l="194" char_id="-1" frame_id="-1" name="客"
		   text="『否定したってこんなになってたら説得力ないなー。』" voices=""/>
		<msg @l="196" char_id="-1" frame_id="-1" name=""
		   text="お客は卑猥な言葉をかけながら私の秘穴をなぞり、ふっくらとした女唇を撫でまわす。" voices=""/>
		<msg @l="197" char_id="-1" frame_id="-1" name=""
		   text="秘裂へグイグイと指を押し込み、恥部の戯奔に拍車をかける。" voices=""/>
		<msg @l="198" char_id="-1" frame_id="-1" name="" text="その度に私の腰は小刻みに痙攣する。"
		   voices=""/>
		<msg @l="200" char_id="-1" frame_id="-1" name="客"
		   text="『美帆ちゃん、そろそろいつもみたいにしてもいいかい？』" voices=""/>
		<msg @l="202" char_id="-1" frame_id="-1" name=""
		   text="そう言って、彼はブルマのアソコの部分を指先で摘み上げる。" voices=""/>
		<msg @l="204" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥ぅぁ‥‥。』"
		   voices="miho00430"/>
		<msg @l="206" char_id="0" frame_id="-1" name="美帆" text="『えっと‥‥机の上にありますから。』"
		   voices="miho10880"/>
		<msg @l="208" char_id="-1" frame_id="-1" name="客" text="『おお、今日は準備がいいねぇ。』"
		   voices=""/>
		<msg @l="210" char_id="-1" frame_id="-1" name=""
		   text="彼は机の上に目当てのモノを見つけると、嬉しそうに手を伸ばした。" voices=""/>
		<wait_chgmv/>
		<ev @l="214" src="ev-027y1"/>
		<msg @l="216" char_id="-1" frame_id="-1" name="客"
		   text="『これこれ‥‥やっぱこれを使わないとね。』" voices=""/>
		<msg @l="218" char_id="-1" frame_id="-1" name=""
		   text="彼は机の上からハサミを手繰り寄せ、先端の刃をブルマにあてがう。" voices=""/>
		<msg @l="219" char_id="-1" frame_id="-1" name=""
		   text="最近のお気に入りなのだろうか‥‥彼と「する」時は、いつもこうだ。" voices=""/>
		<msg @l="221" char_id="-1" frame_id="-1" name="客" text="『それじゃ、じっとしててね。』"
		   voices=""/>
		<msg @l="223" char_id="-1" frame_id="-1" name=""
		   text="彼はそう言って、摘み上げたブルマをハサミで切り取っていく。" voices=""/>
		<msg @l="224" char_id="-1" frame_id="-1" name=""
		   text="最初は驚いたのだが、今となっては恐怖感もさほどない。" voices=""/>
		<msg @l="225" char_id="-1" frame_id="-1" name=""
		   text="逆に、そうして徐々に晒されていく事への興奮の方が大きいくらいだ。" voices=""/>
		<msg @l="227" char_id="-1" frame_id="-1" name="" text="ジョリ、ジョリ、ジョリ‥‥‥。"
		   voices=""/>
		<wait_chgmv/>
		<ev @l="231" src="ev-027y2"/>
		<msg @l="233" char_id="0" frame_id="-1" name="美帆" text="『ん‥‥。』"
		   voices="miho10890"/>
		<msg @l="235" char_id="-1" frame_id="-1" name=""
		   text="ブルマと下着が綺麗に切り抜かれ、私の秘丘が彼の眼前に晒される。" voices=""/>
		<msg @l="236" char_id="-1" frame_id="-1" name=""
		   text="それに伴って、彼の視線もより一層鋭く絡み付いてきた。" voices=""/>
		<msg @l="238" char_id="-1" frame_id="-1" name="客"
		   text="『おやおや、美帆ちゃん、もう濡らしちゃってるのかい？』" voices=""/>
		<msg @l="240" char_id="-1" frame_id="-1" name="客"
		   text="『これなら何にもしなくても入っちゃうかもなぁ。』" voices=""/>
		<msg @l="242" char_id="0" frame_id="-1" name="美帆" text="『そんな‥‥言わないで下さい。』"
		   voices="miho10900"/>
		<msg @l="244" char_id="-1" frame_id="-1" name="客"
		   text="『その割に、ここなんか糸引いちゃってるじゃないか。』" voices=""/>
		<msg @l="246" char_id="-1" frame_id="-1" name=""
		   text="お客は嬉しそうに私の蜜口から指を引き抜くと、親指と人差し指にかかる粘っこい淫靡な吊橋を見せつける。" voices=""/>
		<msg @l="248" char_id="0" frame_id="-1" name="美帆" text="『そ、それは‥‥。』"
		   voices="miho10910"/>
		<msg @l="250" char_id="0" frame_id="-1" name="美帆" text="『んんっ‥‥！』"
		   voices="miho10230"/>
		<msg @l="252" char_id="-1" frame_id="-1" name="客"
		   text="『恥ずかしがる振りしたって、おじさんは騙されないぞ。』" voices=""/>
		<msg @l="254" char_id="-1" frame_id="-1" name="客"
		   text="『美帆ちゃんが言葉責めに弱い事くらい、お見通しだからねぇ。』" voices=""/>
		<msg @l="256" char_id="0" frame_id="-1" name="美帆" text="『‥‥苛めないでください。』"
		   voices="miho10920"/>
		<msg @l="258" char_id="-1" frame_id="-1" name="客"
		   text="『ハハっ、それじゃあそろそろお待ちかねのメインディッシュを戴くとしようか。』" voices=""/>
		<msg @l="260" char_id="-1" frame_id="-1" name=""
		   text="そうして彼は、太く硬くなった男幹を一気に深くまで突き入れてきた。" voices=""/>
		<msg @l="262" char_id="0" frame_id="-1" name="美帆" text="『んんっっ！』"
		   voices="miho10930"/>
		<msg @l="264" char_id="-1" frame_id="-1" name=""
		   text="狭い膣内を肉棒が無遠慮に柔壁を押し割り、突き進んでいく。" voices=""/>
		<msg @l="265" char_id="-1" frame_id="-1" name=""
		   text="お客は蜜壺の狭さと蕩けた肉の感触に酔いしれる。" voices=""/>
		<msg @l="267" char_id="-1" frame_id="-1" name="客"
		   text="『相変らず美帆ちゃんのここは絶品だなぁ。』" voices=""/>
		<msg @l="269" char_id="-1" frame_id="-1" name=""
		   text="彼は嬉しそうにそう言って、無遠慮に腰を振り始める。" voices=""/>
		<msg @l="271" char_id="0" frame_id="-1" name="美帆" text="『ん、んんっ‥‥‥んぁぁっ。』"
		   voices="miho10940"/>
		<msg @l="273" char_id="0" frame_id="-1" name="美帆"
		   text="『すごい‥‥‥おっきい‥‥‥‥‥‥ですっ。』" voices="miho10950"/>
		<msg @l="275" char_id="0" frame_id="-1" name="美帆" text="『んっ‥‥‥ああっ‥‥‥‥‥‥。』"
		   voices="miho10190"/>
		<msg @l="277" char_id="-1" frame_id="-1" name="客" text="『そうだろうそうだろう。』"
		   voices=""/>
		<msg @l="279" char_id="-1" frame_id="-1" name="客"
		   text="『美帆ちゃんのアソコがおじさんのモノでギチギチに広がって、今にも裂けちゃいそうだよ。』" voices=""/>
		<msg @l="281" char_id="-1" frame_id="-1" name=""
		   text="ブルマの切れ目をじっとりと眺めながら、男が嬉しそうに言う。" voices=""/>
		<msg @l="282" char_id="-1" frame_id="-1" name=""
		   text="それは気遣いの言葉などではもちろんなくて‥‥。" voices=""/>
		<msg @l="283" char_id="-1" frame_id="-1" name=""
		   text="言葉によって、私の羞恥心を煽っているのだ。" voices=""/>
		<msg @l="285" char_id="0" frame_id="-1" name="美帆" text="『んはっ‥‥‥ん、んんっ！』"
		   voices="miho10960"/>
		<msg @l="287" char_id="-1" frame_id="-1" name=""
		   text="怒張したモノが胎内奥深くまで貫くたび、私の意識は深く暗い場所へと堕ちていく。" voices=""/>
		<msg @l="288" char_id="-1" frame_id="-1" name="" text="けれど、足りない‥‥。"
		   voices=""/>
		<msg @l="289" char_id="-1" frame_id="-1" name=""
		   text="私の意識はあともう一歩のところで理性という檻にしがみ付いていた。" voices=""/>
		<msg @l="291" char_id="0" frame_id="-1" name="美帆" text="『んふぅ‥‥‥‥んっ‥‥あふっ。』"
		   voices="miho10970"/>
		<msg @l="293" char_id="-1" frame_id="-1" name="客"
		   text="『おやおや、美帆ちゃんはいやらしい声を出すなぁ。』" voices=""/>
		<msg @l="295" char_id="-1" frame_id="-1" name="客"
		   text="『そんなに物足りなさそうな声を出されちゃ、おじさんもっと頑張らなくちゃいけないじゃないか。』" voices=""/>
		<msg @l="297" char_id="-1" frame_id="-1" name=""
		   text="私の「物足りなさ」に気付いた彼は、そう言って腰の律動を早める。" voices=""/>
		<msg @l="298" char_id="-1" frame_id="-1" name=""
		   text="これまで以上に早く深く、男根が私の肉壁を掻き混ぜていく。" voices=""/>
		<msg @l="299" char_id="-1" frame_id="-1" name=""
		   text="速射砲のように打ち込む肉杭は狭い膣を壊すように激しく食い込んでいく。" voices=""/>
		<msg @l="301" char_id="0" frame_id="-1" name="美帆" text="『ん、ん、ん、んんっ！』"
		   voices="miho10980"/>
		<msg @l="303" char_id="0" frame_id="-1" name="美帆"
		   text="『んぁぁっ‥‥‥んくっ‥‥深い、ですっ。』" voices="miho10990"/>
		<msg @l="305" char_id="-1" frame_id="-1" name=""
		   text="子宮の奥まで響くほどの律動に、私は熱い吐息を漏らす。" voices=""/>
		<msg @l="306" char_id="-1" frame_id="-1" name=""
		   text="猥褻に腰をくねらせて、先端を秘穴の最奥へと誘いながら‥‥。" voices=""/>
		<msg @l="307" char_id="-1" frame_id="-1" name=""
		   text="私はそれでも達する事の出来ないもどかしさに、身体を震わせた。" voices=""/>
		<msg @l="309" char_id="-1" frame_id="-1" name="声"
		   text="『‥‥達する事が出来ずもどかしそうだな、美帆。』" voices=""/>
		<msg @l="311" char_id="0" frame_id="-1" name="美帆" text="『あ‥‥。』"
		   voices="miho11000"/>
		<msg @l="313" char_id="-1" frame_id="-1" name=""
		   text="耳の奥に忍ばせていたワイヤレスのイヤホンから聞き慣れた声が届く。" voices=""/>
		<msg @l="315" char_id="-1" frame_id="-1" name="声"
		   text="『良い知らせをしてやろう。今、白石クンがマンションのエレベーターに乗って部屋に戻っているところだ。』" voices=""/>
		<msg @l="317" char_id="0" frame_id="-1" name="美帆" text="『え‥‥‥。』"
		   voices="miho10200"/>
		<msg @l="319" char_id="-1" frame_id="-1" name="声"
		   text="『早くお客をイカせないと白石クンは部屋に戻ってくる。キミが客を取っていることがばれてしまうぞ。』" voices=""/>
		<msg @l="321" char_id="0" frame_id="-1" name="美帆" text="『そんな‥‥‥ん、あぐっ！？』"
		   voices="miho10300"/>
		<msg @l="323" char_id="-1" frame_id="-1" name=""
		   text="その声を聞いただけで私の蜜壷からはさらに花液が溢れ出し、貫いている肉柱をきゅうきゅうと締め付けてしまう。" voices=""/>
		<msg @l="325" char_id="-1" frame_id="-1" name="客"
		   text="『おおっ‥‥急に締め付けがキツくなったね。』" voices=""/>
		<msg @l="327" char_id="-1" frame_id="-1" name="客" text="『これじゃ、すぐに出ちゃうよっ。』"
		   voices=""/>
		<msg @l="329" char_id="-1" frame_id="-1" name=""
		   text="嬉しそうにそう言って、彼はさらに強く激しく媚肉を掻き混ぜる。" voices=""/>
		<msg @l="330" char_id="-1" frame_id="-1" name=""
		   text="私を貫いている肉杭は律動するたびにビクビクと脈打ち、脈打つ毎にさらに硬く太くなっていく。" voices=""/>
		<msg @l="332" char_id="0" frame_id="-1" name="美帆" text="『あっ、あっ、あっ‥‥んんっ‥‥‥。』"
		   voices="miho11010"/>
		<msg @l="334" char_id="0" frame_id="1" name="美帆"
		   text="（は、早くイって･･そうしないと玲さんが帰ってきちゃう････みられちゃう････）" voices=""/>
		<msg @l="336" char_id="0" frame_id="1" name="美帆"
		   text="『いっ‥‥ああ、あああっっ‥‥‥んくっ。』" voices="miho11020"/>
		<msg @l="338" char_id="0" frame_id="1" name="美帆"
		   text="『あああっ、あっ‥‥‥あっ、あっ、あっ‥‥‥んっ、んんっ！！』" voices="miho10420"/>
		<msg @l="340" char_id="-1" frame_id="-1" name="声"
		   text="『ククク‥‥、さあ、どうする？白石クンが今、部屋の前で鍵を開けているぞ‥‥。』" voices=""/>
		<se @l="343" buf="1" src="鍵を開ける音" volume="1."/>
		<msg @l="345" char_id="0" frame_id="1" name="美帆" text="『そんな‥‥‥ん、あぐっ！？』"
		   voices="miho10300"/>
		<se @l="348" buf="1" src="扉を開ける音_金属" volume="1."/>
		<msg @l="350" char_id="0" frame_id="1" name="美帆"
		   text="『い、いやっ‥‥‥‥‥あっ‥‥んんっっ！！』" voices="miho10270"/>
		<msg @l="352" char_id="-1" frame_id="-1" name="客" text="『美帆ちゃん、いくよ、いくよっ！？』"
		   voices=""/>
		<msg @l="354" char_id="0" frame_id="1" name="美帆" text="『んん――――っ！！』"
		   voices="miho11030"/>
		<msg @l="356" char_id="-1" frame_id="-1" name="客" text="『出すようぅっ！』" voices=""/>
		<msg @l="358" char_id="0" frame_id="1" name="美帆" text="『あ、あああっ！！！』"
		   voices="miho10540"/>
		<msg @l="360" char_id="0" frame_id="1" name="美帆" text="『ん、あああああああっ！！』"
		   voices="miho11040"/>
		<flash @l="364" count="4" fade="100" image="white"/>
		<wait_chgmv/>
		<ev @l="368" src="ev-027y2z1"/>
		<msg @l="370" char_id="-1" frame_id="-1" name=""
		   text="膣内奥深くへ、大量の熱い欲液が注ぎ込まれる。" voices=""/>
		<msg @l="371" char_id="-1" frame_id="-1" name=""
		   text="それは瞬く間に私の狭い胎内を満たして‥‥結合部分からドロリと白濁液が溢れ出す。" voices=""/>
		<msg @l="373" char_id="0" frame_id="1" name="美帆" text="『はぁ‥‥はぁ‥‥‥はぁ‥‥‥‥。』"
		   voices="miho11050"/>
		<msg @l="375" char_id="-1" frame_id="-1" name="客"
		   text="『いやあ、美帆ちゃんのアソコがあんまり気持ちいいから中にいっぱい出しちゃったよ～。』" voices=""/>
		<msg @l="377" char_id="-1" frame_id="-1" name=""
		   text="私の中へたっぷりと淫欲の汁を注いだ後、彼はそう言って満足気に笑う。" voices=""/>
		<clear @l="383" class="all"/>
		<msg @l="385" char_id="-1" frame_id="-1" name="声"
		   text="『見事な達し方だったな‥‥でも早くその男を追い出したほうが良いんじゃないかね？白石クンが部屋に入ってくるぞ。』" voices=""/>
		<se @l="388" buf="3" loop="true" src="廊下を歩く音2" volume="1."/>
		<msg @l="390" char_id="0" frame_id="1" name="美帆" text="『はっ‥‥‥‥！』" voices=""/>
		<msg @l="392" char_id="-1" frame_id="-1" name="客" text="『ん？』" voices=""/>
		<msg @l="394" char_id="0" frame_id="1" name="美帆" text="『お願いします‥‥早く着替えて。』"
		   voices=""/>
		<msg @l="396" char_id="-1" frame_id="-1" name="客" text="『どうしたんだい‥‥そんなに慌てて。』"
		   voices=""/>
		<msg @l="398" char_id="0" frame_id="1" name="美帆"
		   text="（足音が聞こえてくる、玲さんが来ちゃう！）" voices=""/>
		<msg @l="400" char_id="0" frame_id="1" name="美帆" text="『お願い、早く！』" voices=""/>
		<msg @l="402" char_id="-1" frame_id="-1" name="客" text="『いいじゃないか、もう一回しようよ。』"
		   voices=""/>
		<msg @l="404" char_id="-1" frame_id="-1" name="" text="そういって私の身体に抱きついてくる。"
		   voices=""/>
		<msg @l="406" char_id="0" frame_id="1" name="美帆"
		   text="『あ、ああっ‥‥んっ‥‥‥‥ダメ‥‥‥これ以上は、んんっ！』" voices=""/>
		<msg @l="408" char_id="1" frame_id="-1" name="玲"
		   text="『美帆ー。ちょっと忘れ物しちゃったんだけどー』" voices=""/>
		<msg @l="410" char_id="0" frame_id="1" name="美帆"
		   text="（いやっ、来ないで玲さん････こんな姿見られたら････私、私････）" voices=""/>
		<msg @l="412" char_id="1" frame_id="-1" name="玲" text="『私の手帳見なかったー。あれ、美帆ー？』"
		   voices=""/>
		<stopse @l="416" buf="3"/>
		<msg @l="418" char_id="-1" frame_id="-1" name=""
		   text="そして、私の扉の前で足音がとまり‥‥ドアノブが回る――" voices=""/>
		<msg @l="420" char_id="1" frame_id="-1" name="玲" text="『美帆ー、いるの？入るわよー。』"
		   voices=""/>
		<se @l="423" buf="1" src="ノック2" volume="1."/>
		<msg @l="425" char_id="0" frame_id="1" name="美帆" text="『‥‥‥ゃぁ‥‥。』"
		   voices="miho00740"/>
		<se @l="428" buf="1" src="部室のドア開ける" volume="1."/>
		<msg @l="430" char_id="-1" frame_id="-1" name="" text="ガチャ" voices=""/>
		<msg @l="432" char_id="0" frame_id="1" name="美帆" text="『いやっ、いやああああああああっ！！』"
		   voices="miho10750"/>
		<stopbgm @l="436" fadeout="1000"/>
		<clear @l="442" class="all"/>
		<end_scene @l="445"/>
	</code>
</xscript>
