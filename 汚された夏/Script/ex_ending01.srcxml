<?xml version="1.0" encoding="utf-8"?>
<xscript>
	<debug editor="&quot;C:\Program&#32;Files&#32;(x86)\sakura\sakura.exe&quot;&#32;&quot;%src%&quot;&#32;-Y=%line%"
	   src="D:\シロップ\町ぐるみの罠＋汚された夏セット版\汚された夏\完成データ\汚された夏\script\text\ex_ending01.txt"/>
	<code>
		<label @l="12" id="EventLabel_55"/>
		<label @l="17" id="event_scene62"/>
		<msg @l="19" char_id="-1" frame_id="-1" name="" text="‥‥‥‥‥‥‥‥‥‥‥‥。"
		   voices=""/>
		<msg @l="20" char_id="-1" frame_id="-1" name="" text="‥‥‥‥‥‥‥‥。" voices=""/>
		<msg @l="21" char_id="-1" frame_id="-1" name="" text="‥‥‥‥。" voices=""/>
		<bgm @l="25" src="bgm21" volume="1."/>
		<msg @l="27" char_id="0" frame_id="-1" name="美帆"
		   text="『あﾞ、あﾞあﾞ‥‥‥あﾞ‥‥‥‥‥‥。』" voices="miho04940"/>
		<msg @l="29" char_id="0" frame_id="-1" name="美帆"
		   text="『んあﾞっ‥‥あっ‥‥‥いやっ、あﾞっ、あぐっっ！』" voices="miho04970"/>
		<msg @l="31" char_id="0" frame_id="-1" name="美帆"
		   text="『あ、ああっ‥‥あっ、んぐっ、あﾞっ、あﾞっ、あﾞっ、あﾞっ！！！』" voices="miho04920"/>
		<msg @l="33" char_id="0" frame_id="-1" name="美帆" text="『い、ああああああああああっ！！！』"
		   voices="miho04870"/>
		<msg @l="35" char_id="-1" frame_id="-1" name=""
		   text="美帆は声を上げて身体を震わせる････いったい幾度目の絶頂だろう。どれだけ犯せば気が済むのだろう････。" voices=""/>
		<msg @l="36" char_id="-1" frame_id="-1" name="" text="‥‥‥‥。" voices=""/>
		<msg @l="37" char_id="-1" frame_id="-1" name="" text="‥‥‥‥‥‥‥‥。" voices=""/>
		<msg @l="38" char_id="-1" frame_id="-1" name="" text="あれから１０ヶ月の時が流れていた。"
		   voices=""/>
		<msg @l="39" char_id="-1" frame_id="-1" name=""
		   text="逃げ出した美帆は捕らえられ、自宅に荒縄で監禁拘束されてから、熊野に来る日も来る日も犯され続けた。" voices=""/>
		<msg @l="40" char_id="-1" frame_id="-1" name=""
		   text="ついに美帆は子を孕まされ‥‥植え付けられたその子は既に臨月間際まで育つ。" voices=""/>
		<msg @l="41" char_id="-1" frame_id="-1" name=""
		   text="それからと言うもの、罰を与えるような責めを続けていた熊野が、美帆に自分の欲望を叩きつけるように犯すようになった。" voices=""/>
		<msg @l="42" char_id="-1" frame_id="-1" name=""
		   text="････そして眠る時と、食事をする時以外はずっと犯され続け････" voices=""/>
		<msg @l="43" char_id="-1" frame_id="-1" name=""
		   text="その唇からはもうずっと言葉は発することなく――。" voices=""/>
		<msg @l="44" char_id="-1" frame_id="-1" name=""
		   text="美帆の瞳にはもう光が感じられなくなっていた――。" voices=""/>
		<wait_chgmv/>
		<bg @l="48" src="bg01c"/>
		<char @l="51" id="kuma" pos="center" src="kuma018f" y="-80"/>
		<msg @l="53" char_id="-1" frame_id="-1" name="熊野" text="『ハァ、ハァ、ハァ、ハァ････。』"
		   voices=""/>
		<msg @l="55" char_id="-1" frame_id="-1" name="熊野" text="『ふぅ･･気を失ったか‥‥。』"
		   voices=""/>
		<msg @l="57" char_id="-1" frame_id="-1" name="" text="熊野が、吐き捨てるように言い捨てる。"
		   voices=""/>
		<msg @l="59" char_id="-1" frame_id="-1" name="熊野"
		   text="『しかしなぜか妊婦はいい････。何度犯しても何度犯しても、犯し足りない･･。一生ハメていても満足できないぜ！』" voices=""/>
		<msg @l="61" char_id="-1" frame_id="-1" name=""
		   text="熊野の肉棒は既に今夜だけで１０回も射精しているのにも関わらず、いまだびくびくと脈を打ち、天に向かってそそり立っている。"
		   voices=""/>
		<msg @l="63" char_id="-1" frame_id="-1" name=""
		   text="熊野は自分でも気づかないうちに、異常なほどまでに妊婦に対して欲情をしていた。" voices=""/>
		<msg @l="65" char_id="-1" frame_id="-1" name="熊野"
		   text="『また勃ってきたぜ･･。もう一回ぶち込んでやる！』" voices=""/>
		<msg @l="67" char_id="-1" frame_id="-1" name=""
		   text="そう吐き捨てると熊野はゆっくりと美帆に近づきながら、薬を取り出しぼりぼりと食う。" voices=""/>
		<msg @l="68" char_id="-1" frame_id="-1" name=""
		   text="すると熊野の目は赤く光り、身体が一回り大きく膨張し衣服が裂ける。" voices=""/>
		<flash @l="71" count="4" fade="100" image="white"/>
		<se @l="73" buf="1" src="ムチの音" volume="1."/>
		<flash @l="76" count="4" fade="100" image="white"/>
		<msg @l="77" char_id="-1" frame_id="-1" name="" text="ビリビリビリッ" voices=""/>
		<msg @l="79" char_id="-1" frame_id="-1" name="熊野"
		   text="『くく‥‥くくくっ、はははっはははっ！また、犯してやるぞ！&#32;たっぷりとな！』" voices=""/>
		<clear @l="83" class="char"/>
		<clear @l="90" class="all"/>
		<label @l="94" id="chart_line69"/>
		<wait_chgmv/>
		<ev @l="98" src="ev-062"/>
		<msg @l="100" char_id="-1" frame_id="-1" name="" text="ずぶずぶずぶずぶずぶ" voices=""/>
		<msg @l="102" char_id="-1" frame_id="-1" name="熊野"
		   text="『なんだ、既に中は大洪水だな！お腹の中の子供が知ったらビックリするだろうよ。』" voices=""/>
		<msg @l="104" char_id="0" frame_id="-1" name="美帆" text="『ん、ん、ん、んんっ！』"
		   voices="miho10980"/>
		<msg @l="106" char_id="0" frame_id="-1" name="美帆"
		   text="『んあﾞっ‥‥あっ‥‥‥いやっ、あﾞっ、あぐっっ！』" voices="miho04970"/>
		<msg @l="108" char_id="-1" frame_id="-1" name="熊野" text="『ふん、もう俺の声も聞こえねぇか。』"
		   voices=""/>
		<msg @l="110" char_id="-1" frame_id="-1" name="熊野"
		   text="『まぁ、いいか。その代わり俺がたっぷり子供を可愛がってやるよ！！』" voices=""/>
		<msg @l="112" char_id="-1" frame_id="-1" name=""
		   text="熊野はそう言うと、腰を激しく突き上げながら美帆の大きく膨れた腹に向かって叫ぶ。" voices=""/>
		<msg @l="114" char_id="-1" frame_id="-1" name="熊野"
		   text="『おう！調子はどうだ？‥‥今日も元気に暴れているか？』" voices=""/>
		<msg @l="116" char_id="-1" frame_id="-1" name="熊野"
		   text="『これだけ俺の精液をぶっかけてもらったら、さぞかしザーメン好きな子になるだろうよ。』" voices=""/>
		<msg @l="118" char_id="-1" frame_id="-1" name="熊野"
		   text="『どうやらお前は女の子らしいからな！生まれたら母子どんぶりで俺が調教してこの町にあう立派なメス豚に育ててやるぜ！！』"
		   voices=""/>
		<msg @l="120" char_id="-1" frame_id="-1" name=""
		   text="熊野は美帆の腹に言い放った言葉が現実になった事を想像し、さらに肉棒を淫欲に硬くさせ、濡れそぼる秘穴をこすりたてて蜜の音を部屋中に響かせる。"
		   voices=""/>
		<msg @l="122" char_id="-1" frame_id="-1" name="" text="グチュ、グチュ、グチュ、グチュ、グチュ"
		   voices=""/>
		<msg @l="124" char_id="0" frame_id="-1" name="美帆" text="『ん、あああっ！？』"
		   voices="miho10070"/>
		<msg @l="126" char_id="0" frame_id="-1" name="美帆"
		   text="『んっ、んんっ‥‥‥あﾞっ‥‥んぐっ、いっ、あﾞあﾞあﾞっ！！』" voices="miho05020"/>
		<msg @l="127" char_id="-1" frame_id="-1" name=""
		   text="既に美帆は下腹部と淫裂に感じる刺激しか感じず、ただ熊野の抽送に身を委ねるだけだった。" voices=""/>
		<msg @l="129" char_id="0" frame_id="-1" name="美帆"
		   text="『い、ああっ‥‥あﾞ‥‥あﾞ‥‥‥‥‥あぐっっ！！』" voices="miho04880"/>
		<msg @l="131" char_id="-1" frame_id="-1" name=""
		   text="熊野の肉棒が子宮に届き、コツコツとノックすると苦しそうな息を漏らす。" voices=""/>
		<msg @l="132" char_id="-1" frame_id="-1" name=""
		   text="けれど‥‥その朦朧とした表情には微塵の変化も訪れない。" voices=""/>
		<msg @l="134" char_id="-1" frame_id="-1" name="熊野"
		   text="『くくくっ、こうして気を違えてしまって幾日か‥‥こうしているとあの女との日々を思い出す。』" voices=""/>
		<msg @l="136" char_id="-1" frame_id="-1" name=""
		   text="熊野はせせら笑うように言い、腰を打ちつけるスピードを早める。" voices=""/>
		<msg @l="137" char_id="-1" frame_id="-1" name=""
		   text="そうして突き上げられるたびに美帆の身体はガクガクと力なく揺れ動いていた。" voices=""/>
		<msg @l="138" char_id="0" frame_id="-1" name="美帆" text="『うあっ！！？』"
		   voices="miho04930"/>
		<msg @l="140" char_id="0" frame_id="-1" name="美帆"
		   text="『んぐっ‥‥‥あ、あ、ああっ‥‥‥あっ‥‥‥‥‥。』" voices="miho10350"/>
		<msg @l="142" char_id="0" frame_id="-1" name="美帆"
		   text="『ああっ、あっ‥‥‥‥ふあっ‥‥ああっ‥‥あひっ‥‥ふぁぁっ‥‥‥。』" voices="miho10370"/>
		<msg @l="144" char_id="-1" frame_id="-1" name=""
		   text="熊野はストロークを早めると快楽が増し、太茎を膣内の一番奥を突き破るかのように秘裂を突き上げた。" voices=""/>
		<msg @l="145" char_id="-1" frame_id="-1" name=""
		   text="すると大きく膨らんだ腹の内側では己が存在を誇示するかのように子が暴れ出した。" voices=""/>
		<msg @l="147" char_id="-1" frame_id="-1" name="熊野"
		   text="『そうか、この刺激が嬉しいか！？くくく‥‥与えた薬のせいか、子供まで激しく暴れておるわ。』" voices=""/>
		<msg @l="149" char_id="-1" frame_id="-1" name="熊野"
		   text="『慌てずとも、すぐにくれてやるぞ‥‥‥たっぷりとな。』" voices=""/>
		<msg @l="151" char_id="-1" frame_id="-1" name=""
		   text="熊野は膨らんだ美帆の腹を撫でながらより一層興奮して肉棒を硬く大きくさせ、さらに律動を早める。" voices=""/>
		<msg @l="152" char_id="-1" frame_id="-1" name=""
		   text="薬により柔軟性を増した膣内は硬度を増した熊野の逸物をやすやすと飲み込んで包んでいく。" voices=""/>
		<msg @l="154" char_id="0" frame_id="-1" name="美帆" text="『んっ、ああああっ！！』"
		   voices="miho10440"/>
		<msg @l="156" char_id="0" frame_id="-1" name="美帆"
		   text="『ああっ、あっ‥‥‥‥ふあっ‥‥ああっ‥‥あひっ‥‥ふぁぁっ‥‥‥。』" voices="miho10370"/>
		<msg @l="158" char_id="0" frame_id="-1" name="美帆"
		   text="『んんっ‥‥‥あっ、ああっ‥‥‥‥‥い、あ、あふっ‥‥‥‥。』" voices="miho10380"/>
		<msg @l="160" char_id="0" frame_id="-1" name="美帆"
		   text="『あっ‥‥ああっ‥‥‥‥あ、あ、あ‥‥‥‥ん、ふああっ！』" voices="miho10390"/>
		<msg @l="162" char_id="-1" frame_id="-1" name="熊野"
		   text="『やはり妊婦の胎内はいい、小娘とは違って熟れた果実のような味わいがある。』" voices=""/>
		<msg @l="164" char_id="-1" frame_id="-1" name=""
		   text="そう言うと子宮口へ亀頭を押し当て、むりやり押し開きながら子宮へ肉棒を侵入させる。" voices=""/>
		<msg @l="165" char_id="-1" frame_id="-1" name=""
		   text="瞬間的に羊水があふれ出すが、肉茎をある程度押し込むと子宮口がびっちりとはまり、一滴も漏らす事は無くなった。" voices=""/>
		<msg @l="167" char_id="0" frame_id="-1" name="美帆" text="『あ、あああっ！！！』"
		   voices="miho10540"/>
		<msg @l="169" char_id="0" frame_id="-1" name="美帆"
		   text="『い、ああっ‥‥あﾞ‥‥あﾞ‥‥‥‥‥あぐっっ！！』" voices="miho04880"/>
		<msg @l="171" char_id="-1" frame_id="-1" name="" text="美帆の表情が険しく歪む。"
		   voices=""/>
		<msg @l="172" char_id="-1" frame_id="-1" name=""
		   text="薬により拡張されたとはいえ、本来ある筈がない刺激に耐え難い苦痛が美帆を襲っていた。" voices=""/>
		<msg @l="174" char_id="-1" frame_id="-1" name="熊野" text="『どうれ、どこにいるのかな？』"
		   voices=""/>
		<msg @l="176" char_id="-1" frame_id="-1" name="熊野"
		   text="『子供に俺のもの凄く濃いザーメンをぶっかけてやるぞ！！』" voices=""/>
		<msg @l="178" char_id="0" frame_id="-1" name="美帆"
		   text="『んあﾞっ‥‥あっ‥‥‥いやっ、あﾞっ、あぐっっ！』" voices="miho04970"/>
		<msg @l="180" char_id="0" frame_id="-1" name="美帆"
		   text="『んっ、んんっ‥‥‥あﾞっ‥‥んぐっ、いっ、あﾞあﾞあﾞっ！！』" voices="miho05020"/>
		<msg @l="181" char_id="-1" frame_id="-1" name=""
		   text="熊野は口元を吊り上げて笑い、激しく肉棒を押し込んでいく。" voices=""/>
		<msg @l="182" char_id="-1" frame_id="-1" name=""
		   text="そして―――先端が何かに当たったその瞬間、熊野はぶるりと腰を震わせて大量の精液を放った。" voices=""/>
		<flash @l="186" count="4" fade="100" image="white"/>
		<msg @l="188" char_id="0" frame_id="-1" name="美帆" text="『んんんっっ！！！』"
		   voices="miho05100"/>
		<flash @l="192" count="4" fade="100" image="white"/>
		<flash @l="195" count="4" fade="100" image="white"/>
		<msg @l="197" char_id="0" frame_id="-1" name="美帆" text="『い、ああああああああああっ！！！』"
		   voices="miho04870"/>
		<msg @l="199" char_id="-1" frame_id="-1" name=""
		   text="子宮に染み込む精の感触と、それを嬉々としてすすっているであろう腹の子のそれに美帆が狂ったような声を漏らして震える。"
		   voices=""/>
		<msg @l="201" char_id="-1" frame_id="-1" name="熊野"
		   text="『くく‥‥いいぞ、この調子でどんどん注いでやるからな‥‥真奈。』" voices=""/>
		<msg @l="203" char_id="-1" frame_id="-1" name=""
		   text="熊野は美帆ではない、別の名前を呼んでいた････。" voices=""/>
		<msg @l="204" char_id="-1" frame_id="-1" name=""
		   text="だが、美帆の耳には熊野の言葉は届かず･･････。" voices=""/>
		<msg @l="205" char_id="-1" frame_id="-1" name=""
		   text="美帆はもう全てがどうでも良くなっていた････････。" voices=""/>
		<msg @l="207" char_id="-1" frame_id="-1" name=""
		   text="満足げな表情を浮かべながら、熊野は精を放った直後にも関わらず再び腰を律動させていく。" voices=""/>
		<msg @l="209" char_id="0" frame_id="-1" name="美帆"
		   text="『あﾞ、あﾞあﾞ‥‥‥あﾞ‥‥‥‥‥‥。』" voices="miho04940"/>
		<msg @l="211" char_id="-1" frame_id="-1" name=""
		   text="美帆はそれをなすがままに受け止め、拠り所のない吐息を漏らし続けていた。" voices=""/>
		<msg @l="213" char_id="-1" frame_id="-1" name=""
		   text="これからも永遠に続くであろう責め苦に身を委ねて････。" voices=""/>
		<stopbgm @l="217" fadeout="1000"/>
		<clear @l="223" class="all"/>
		<wait @l="225" time="2000"/>
		<end_scene @l="230"/>
		<eval @l="233" expr="s.flagGallery=1&#13;&#10;"/>
		<eval @l="235" expr="s.event62flag=1&#13;&#10;"/>
		<call @l="238" target="EventLabel_154@staffroom"/>
		<return @l="239" value="0&#13;&#10;"/>
		<return @l="242" value=""/>
	</code>
</xscript>
