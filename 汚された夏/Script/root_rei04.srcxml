<?xml version="1.0" encoding="utf-8"?>
<xscript>
	<debug editor="&quot;C:\Program&#32;Files&#32;(x86)\sakura\sakura.exe&quot;&#32;&quot;%src%&quot;&#32;-Y=%line%"
	   src="D:\シロップ\町ぐるみの罠＋汚された夏セット版\汚された夏\完成データ\汚された夏\script\text\root_rei04.txt"/>
	<code>
		<label @l="12" id="EventLabel_133"/>
		<description @l="16" text="ルームメイトの憂鬱・４日目"/>
		<eval @l="18" expr="f.numDay=10&#13;&#10;"/>
		<msgshow @l="20" show="false"/>
		<wait_chgmv/>
		<bg @l="22" src="day10" time="2000"/>
		<wait @l="24" time="500"/>
		<wait_chgmv/>
		<bg @l="26" src="black" time="2000"/>
		<msgshow @l="28" show="true"/>
		<wait_chgmv/>
		<bg @l="32" src="bg03"/>
		<bgm @l="36" src="bgm07" volume="1."/>
		<char @l="40" id="miho" pos="auto" src="miho116"/>
		<msg @l="42" char_id="0" frame_id="-1" name="美帆" text="『それじゃ、いってきます。』"
		   voices=""/>
		<msg @l="44" char_id="1" frame_id="-1" name="玲" text="『ええ、いってらっしゃい。』"
		   voices=""/>
		<clear @l="48" class="char"/>
		<char @l="51" id="rei" pos="auto" src="rei035"/>
		<msg @l="53" char_id="-1" frame_id="-1" name=""
		   text="朝‥‥玲はいつものように美帆の見送りをする。" voices=""/>
		<msg @l="55" char_id="-1" frame_id="-1" name=""
		   text="けれど、美帆が立ち去った後‥‥その顔に浮かんでいるのはいつものねむそうな朝の笑みではなく。" voices=""/>
		<msg @l="56" char_id="-1" frame_id="-1" name="" text="複雑な表情をしていた。" voices=""/>
		<msg @l="57" char_id="-1" frame_id="-1" name=""
		   text="昨日朽木に言われた「交換条件」が、玲の頭をかすめては消えていく。" voices=""/>
		<msg @l="59" char_id="1" frame_id="-1" name="玲" text="『‥‥どうすればいいの？』"
		   voices=""/>
		<msg @l="61" char_id="1" frame_id="-1" name="玲" text="『‥‥でも、これしかないじゃない。』"
		   voices=""/>
		<msg @l="63" char_id="-1" frame_id="-1" name=""
		   text="自分を無理やり納得させるかのように、必死で朽木との「交換条件」を正当化させた。" voices=""/>
		<msg @l="64" char_id="-1" frame_id="-1" name=""
		   text="今日、これから美帆の身に何が起こるのか‥‥何となく予想は出来た。" voices=""/>
		<msg @l="65" char_id="-1" frame_id="-1" name=""
		   text="それでも今の玲にとっては、これからの自分の将来も大切であった。" voices=""/>
		<msg @l="66" char_id="-1" frame_id="-1" name=""
		   text="揺れ動く心の天秤の最後の決め手になったのは、美帆が自分に黙って大黒建設を受けていたこと。自分に黙って稲庭と親しそうにしていたこと。"
		   voices=""/>
		<msg @l="68" char_id="-1" frame_id="-1" name=""
		   text="自分が信じていたかわいい妹に先に裏切られた―――。" voices=""/>
		<msg @l="70" char_id="-1" frame_id="-1" name=""
		   text="ならば、自分も良いではないか？‥‥再び玲は、自分に言い聞かせた。" voices=""/>
		<msg @l="71" char_id="-1" frame_id="-1" name=""
		   text="それが自分を慕う後輩を奈落へ突き落とす行為だとしても‥‥。" voices=""/>
		<stopbgm @l="75" fadeout="1000"/>
		<clear @l="81" class="all"/>
		<msgshow @l="83" show="true"/>
		<wait_chgmv/>
		<bg @l="87" src="bg12"/>
		<bgm @l="91" src="bgm03" volume="1."/>
		<char @l="95" id="rei" pos="auto" src="rei015"/>
		<msg @l="97" char_id="1" frame_id="-1" name="玲" text="『‥‥‥‥。』" voices=""/>
		<msg @l="98" char_id="-1" frame_id="-1" name=""
		   text="１２時３０分を少し回った頃、玲は朽木の教授室を訪れていた。" voices=""/>
		<msg @l="99" char_id="-1" frame_id="-1" name=""
		   text="キャンパス内で美帆に出会ってしまわないように、講義の始まっている時間を選んでタクシーを使った。" voices=""/>
		<msg @l="100" char_id="-1" frame_id="-1" name=""
		   text="この時間に朽木が教授室にいることも、昨日の段階で聞いていた事だ。" voices=""/>
		<clear @l="103" class="char"/>
		<char @l="105" id="rei" pos="left" src="rei015"/>
		<char @l="108" id="kutsu" pos="right" src="kutsu010"/>
		<bgm @l="112" src="bgm15" volume="1."/>
		<msg @l="114" char_id="-1" frame_id="-1" name=""
		   text="朽木は約束の品を心待ちにしていたかのように、いやらしい笑みを浮かべ玲に問いかける。" voices=""/>
		<msg @l="116" char_id="-1" frame_id="-1" name="朽木"
		   text="『それで、昨日言ったものは用意してもらえたのかね？』" voices=""/>
		<char @l="120" id="rei" pos="left" src="rei025"/>
		<msg @l="122" char_id="1" frame_id="-1" name="玲"
		   text="『はい‥‥さすがに昨日の今日で合鍵を作るのには無理がありましたので、スペアキーを持ってきました‥‥。』" voices=""/>
		<msg @l="124" char_id="-1" frame_id="-1" name=""
		   text="玲はカバンの中からスペアキーを取り出して朽木に手渡す。" voices=""/>
		<msg @l="125" char_id="-1" frame_id="-1" name=""
		   text="美帆と玲が住んでいる、あの部屋の鍵である。" voices=""/>
		<msg @l="127" char_id="-1" frame_id="-1" name="朽木"
		   text="『それは結構。ではこちらの写真と推薦状を持っていきたまえ。』" voices=""/>
		<msg @l="129" char_id="-1" frame_id="-1" name=""
		   text="鍵を受け取った朽木は、それと交換するように机の引出しからＡ４サイズの書類封筒を取り出して玲の前に差し出す。" voices=""/>
		<char @l="133" id="rei" pos="left" src="rei014"/>
		<msg @l="135" char_id="1" frame_id="-1" name="玲" text="『‥‥！』" voices=""/>
		<msg @l="137" char_id="-1" frame_id="-1" name=""
		   text="玲はそれを奪うように受け取り、慌てて書類封筒の中身を確かめた。" voices=""/>
		<msg @l="138" char_id="-1" frame_id="-1" name=""
		   text="それは間違いなく大黒建設で隠し撮られた恥辱写真と、大黒建設宛の玲の推薦状であった。" voices=""/>
		<char @l="141" id="kutsu" pos="right" src="kutsu018"/>
		<msg @l="143" char_id="-1" frame_id="-1" name="朽木"
		   text="『くくっ‥‥それほど疑わずとも、約束した写真と正式な推薦状だよ。』" voices=""/>
		<char @l="146" id="rei" pos="left" src="rei125"/>
		<msg @l="148" char_id="1" frame_id="-1" name="玲" text="『‥‥‥‥。』" voices=""/>
		<char @l="152" id="rei" pos="left" src="rei015"/>
		<msg @l="154" char_id="1" frame_id="-1" name="玲"
		   text="『写真と推薦状‥‥確かに受け取りました‥‥。』" voices=""/>
		<char @l="157" id="kutsu" pos="right" src="kutsu010"/>
		<msg @l="159" char_id="-1" frame_id="-1" name="朽木"
		   text="『しかし、あの後輩思いだったキミが、本当にこの交換条件に乗ってくれるとは思わなかったよ。』" voices=""/>
		<msg @l="161" char_id="1" frame_id="-1" name="玲" text="『‥‥‥‥。』" voices=""/>
		<msg @l="163" char_id="-1" frame_id="-1" name="朽木"
		   text="『てっきり待ちぼうけを食わされると思っていたが‥‥まあ、人間、誰しも自分が第一というわけだ。』" voices=""/>
		<char @l="166" id="rei" pos="left" src="rei115"/>
		<msg @l="168" char_id="1" frame_id="-1" name="玲" text="『‥‥‥‥‥‥。』" voices=""/>
		<msg @l="170" char_id="-1" frame_id="-1" name=""
		   text="もちろん、玲にはこの「交換条件」に大きな後ろめたさがあった。" voices=""/>
		<msg @l="171" char_id="-1" frame_id="-1" name="" text="朽木の言葉に玲の表情が曇る。"
		   voices=""/>
		<msg @l="172" char_id="-1" frame_id="-1" name=""
		   text="けれど、既に取り返しがつかない所まで来てしまっていた。" voices=""/>
		<char @l="175" id="rei" pos="left" src="rei017"/>
		<msg @l="177" char_id="1" frame_id="-1" name="玲"
		   text="『‥‥美帆に何をするつもりなんですか‥‥‥。』" voices=""/>
		<msg @l="179" char_id="-1" frame_id="-1" name=""
		   text="敢えてこれから起こるであろう、おぞましき内容を確かめるかのように朽木へ質問をした。" voices=""/>
		<msg @l="181" char_id="-1" frame_id="-1" name="朽木"
		   text="『くくくっ、後輩を売ったキミに知る必要があるのかね？』" voices=""/>
		<msg @l="183" char_id="-1" frame_id="-1" name=""
		   text="意地悪く返答する朽木の言葉が玲の胸を突き刺す。" voices=""/>
		<char @l="186" id="rei" pos="left" src="rei125"/>
		<msg @l="188" char_id="1" frame_id="-1" name="玲" text="『くっ････････。』"
		   voices=""/>
		<char @l="191" id="kutsu" pos="right" src="kutsu018"/>
		<msg @l="193" char_id="-1" frame_id="-1" name="朽木"
		   text="『まあ、私は目的のものが手に入ったからそれで構わないがね。』" voices=""/>
		<msg @l="195" char_id="1" frame_id="-1" name="玲" text="『‥‥‥‥。』" voices=""/>
		<msg @l="197" char_id="-1" frame_id="-1" name="朽木"
		   text="『さて‥‥キミはそろそろ立ち去った方が良い時間だな。』" voices=""/>
		<msg @l="199" char_id="-1" frame_id="-1" name="" text="朽木が時計を指し示す。"
		   voices=""/>
		<msg @l="200" char_id="-1" frame_id="-1" name=""
		   text="確かに‥‥そろそろ二限が終わってしまう時間だった。" voices=""/>
		<char @l="203" id="rei" pos="left" src="rei015"/>
		<msg @l="205" char_id="1" frame_id="-1" name="玲"
		   text="『それでは‥‥私は、予定の時間まで外に出ていますから‥‥。』" voices=""/>
		<msg @l="207" char_id="-1" frame_id="-1" name="朽木"
		   text="『そうしてくれたまえ。彼女に不信感を与えたくないのならな。』" voices=""/>
		<msg @l="209" char_id="1" frame_id="-1" name="玲" text="『‥‥‥‥。』" voices=""/>
		<msg @l="211" char_id="1" frame_id="-1" name="玲" text="『‥‥失礼しました。』"
		   voices=""/>
		<clear @l="215" layer="rei"/>
		<msg @l="217" char_id="-1" frame_id="-1" name=""
		   text="そうして‥‥玲は逃げるように教授室から立ち去っていった。" voices=""/>
		<msg @l="218" char_id="-1" frame_id="-1" name=""
		   text="自分のしていることの重大さから、少しでも目をそむけたいのだろう。" voices=""/>
		<clear @l="221" layer="kutsu"/>
		<char @l="223" id="kutsu" pos="center" src="kutsu010f" y="-80"/>
		<msg @l="225" char_id="-1" frame_id="-1" name="朽木" text="『‥‥‥‥。』" voices=""/>
		<msg @l="227" char_id="-1" frame_id="-1" name="朽木"
		   text="『くくっ、白石玲‥‥意外と簡単に堕ちたモノだ。』" voices=""/>
		<char @l="230" id="kutsu" pos="center" src="kutsu018f" y="-80"/>
		<msg @l="232" char_id="-1" frame_id="-1" name="朽木"
		   text="『いや、大黒の根回しが上手くいったといった方がいいかな。今回はあいつに感謝するか。』" voices=""/>
		<msg @l="234" char_id="-1" frame_id="-1" name=""
		   text="玲が立ち去った後、部屋に一人残された朽木が、指先でスペアキーを弄びながら誰に言うでもなくつぶやいた。" voices=""/>
		<msg @l="236" char_id="-1" frame_id="-1" name=""
		   text="大黒建設の支社長、大黒満彦と朽木は旧知の知人であり‥‥同じ町のプロジェクトに荷担している同志でもある。" voices=""/>
		<msg @l="237" char_id="-1" frame_id="-1" name=""
		   text="朽木が持っている「人脈」の半分以上を大黒が顔つなぎしていることは、裏の世界では有名な話であった。" voices=""/>
		<msg @l="238" char_id="-1" frame_id="-1" name=""
		   text="もちろん、大黒建設内で隠し撮られた写真も、玲や美帆を飲み込もうとするプロジェクトが仕掛けた小さな罠にすぎない。" voices=""/>
		<clear @l="241" class="char"/>
		<msg @l="243" char_id="-1" frame_id="-1" name="朽木"
		   text="『くくっ‥‥まあ、せいぜい特権を使わせてもらうとしよう。』" voices=""/>
		<msg @l="245" char_id="-1" frame_id="-1" name="朽木" text="『この私と、南総町の為にな。』"
		   voices=""/>
		<stopbgm @l="249" fadeout="1000"/>
		<clear @l="255" class="all"/>
		<msgshow @l="257" show="true"/>
		<se @l="261" buf="1" src="チャイム" volume="1."/>
		<msg @l="263" char_id="-1" frame_id="-1" name=""
		   text="教授室を出て、キャンパスへと続く渡り廊下を歩いている所で、二限目の終了を示すチャイムが鳴った。" voices=""/>
		<msg @l="264" char_id="-1" frame_id="-1" name=""
		   text="時間どおりに終わった教室からは学生たちが溢れ出てきて、大学内はつい数分前まで続いていた静寂とは一転した喧騒に包まれていった。"
		   voices=""/>
		<wait_chgmv/>
		<bg @l="268" src="bg15"/>
		<bgm @l="272" src="bgm11" volume="1."/>
		<char @l="276" id="rei" pos="auto" src="rei015"/>
		<msg @l="278" char_id="1" frame_id="-1" name="玲" text="『‥‥‥‥。』" voices=""/>
		<msg @l="280" char_id="-1" frame_id="-1" name=""
		   text="玲がキャンパスに到着する頃には、すっかり騒然としたいつもの風景が出来上がっていた。" voices=""/>
		<msg @l="281" char_id="-1" frame_id="-1" name=""
		   text="二限と三限の間には昼食休みが入るから、この時間は余計にあわただしい。" voices=""/>
		<msg @l="283" char_id="1" frame_id="-1" name="玲" text="『これから‥‥どうしようかしら‥‥。』"
		   voices=""/>
		<msg @l="285" char_id="-1" frame_id="-1" name=""
		   text="憂鬱な表情を浮かべながら、玲はキャンパスを歩いている。" voices=""/>
		<msg @l="286" char_id="-1" frame_id="-1" name=""
		   text="いつもの玲ならばキャンパス内を歩くすべての男が振り向くほどの愛らしい笑顔を見せているのだが、いまやすっかりと明るさを失っていた。"
		   voices=""/>
		<msg @l="287" char_id="-1" frame_id="-1" name=""
		   text="向かう先は‥‥とりあえず正門前にある停留所だ。" voices=""/>
		<msg @l="288" char_id="-1" frame_id="-1" name=""
		   text="とはいえ‥‥いまから朽木と約束をした時間までは、とりあえずどこかで時間を潰さなくてはならない。" voices=""/>
		<msg @l="290" char_id="1" frame_id="-1" name="玲" text="『‥‥‥‥。』" voices=""/>
		<msg @l="292" char_id="-1" frame_id="-1" name=""
		   text="ふと、思い立ったように玲はカバンから携帯電話を取り出す。" voices=""/>
		<msg @l="293" char_id="-1" frame_id="-1" name=""
		   text="そうして電話帳の中から、つい先日登録したばかりの「大黒建設」を検索して通話ボタンを押す。" voices=""/>
		<msg @l="294" char_id="-1" frame_id="-1" name=""
		   text="とりあえず推薦状を手に入れられたことだけでも大黒社長に伝えて、この陰鬱な気分を和らげたいと思ったのだ。" voices=""/>
		<msg @l="295" char_id="-1" frame_id="-1" name=""
		   text="それに、以前、大黒から聞いた美帆との最終選考も頭に引っかかる。" voices=""/>
		<msg @l="296" char_id="-1" frame_id="-1" name=""
		   text="‥‥それほどに、今の玲は追い込まれていた。" voices=""/>
		<char @l="299" id="rei" pos="auto" src="rei025"/>
		<se @l="303" buf="3" loop="true" src="発信音" volume="1."/>
		<stopse @l="307" buf="3"/>
		<msg @l="309" char_id="-1" frame_id="-1" name="受付嬢"
		   text="『はい、大黒建設南総町支社でございます。』" voices=""/>
		<msg @l="311" char_id="-1" frame_id="-1" name=""
		   text="数回の呼び出し音の後、丁寧な対応をした女性の声が、電話口から聞こえてくる。" voices=""/>
		<msg @l="313" char_id="1" frame_id="-1" name="玲"
		   text="『あの、先日面接にお伺いしました白石と申しますが‥‥。』" voices=""/>
		<msg @l="315" char_id="-1" frame_id="-1" name="受付嬢"
		   text="『はい、存じ上げております。本日はどのようなご用件でしょうか？』" voices=""/>
		<msg @l="317" char_id="1" frame_id="-1" name="玲"
		   text="『先日の面接で用意をするようにといわれました、推薦状が準備できたのですが、いつ頃お渡しすれば良いのかわかりませんでしたので‥‥。』"
		   voices=""/>
		<msg @l="319" char_id="-1" frame_id="-1" name="受付嬢"
		   text="『わかりました、では担当の者へ問い合わせますので、少々お待ちください。』" voices=""/>
		<msg @l="321" char_id="1" frame_id="-1" name="玲" text="『‥‥はい。』" voices=""/>
		<se @l="325" buf="3" loop="true" src="保留音" volume="1."/>
		<msg @l="327" char_id="-1" frame_id="-1" name=""
		   text="マニュアルのような応対の後、電話口からどこかで耳にした事がある曲名が保留音として流れてくる。" voices=""/>
		<msg @l="329" char_id="1" frame_id="-1" name="玲" text="『‥‥‥‥。』" voices=""/>
		<stopse @l="333" buf="3"/>
		<msg @l="335" char_id="-1" frame_id="-1" name="受付嬢" text="『お待たせ致しました。』"
		   voices=""/>
		<msg @l="337" char_id="-1" frame_id="-1" name="受付嬢"
		   text="『本日１５時よりお時間を作っても良いとのことですが、如何でしょうか？』" voices=""/>
		<char @l="340" id="rei" pos="auto" src="rei024"/>
		<msg @l="342" char_id="1" frame_id="-1" name="玲" text="『今日ですか‥‥。』" voices=""/>
		<msg @l="344" char_id="-1" frame_id="-1" name="受付嬢"
		   text="『ご都合が宜しくなければ、また後日ということで、こちらよりご連絡致しますが。』" voices=""/>
		<char @l="347" id="rei" pos="auto" src="rei025"/>
		<msg @l="349" char_id="1" frame_id="-1" name="玲" text="『‥‥‥‥。』" voices=""/>
		<msg @l="351" char_id="1" frame_id="-1" name="玲"
		   text="『いえ‥‥本日、１５時でお願いできますか？』" voices=""/>
		<msg @l="353" char_id="-1" frame_id="-1" name="受付嬢"
		   text="『畏まりました、それではお待ちしております。』" voices=""/>
		<se @l="357" buf="1" src="携帯ボタン押下音" volume="1."/>
		<char @l="360" id="rei" pos="auto" src="rei125"/>
		<msg @l="362" char_id="1" frame_id="-1" name="玲" text="『‥‥‥‥。』" voices=""/>
		<msg @l="364" char_id="-1" frame_id="-1" name=""
		   text="玲は通話の切れた携帯電話を見詰め、微かに安堵の表情を浮かべた。" voices=""/>
		<msg @l="365" char_id="-1" frame_id="-1" name=""
		   text="急な話ではあるが、これによって潰さなければならない時間の幾らかが無条件で費やせるというのならば、玲にとっては願ってもない事だ。"
		   voices=""/>
		<msg @l="366" char_id="-1" frame_id="-1" name=""
		   text="さらに推薦状を渡す事が出来れば、憧れの大黒建設への内定、そして憧れの稲庭と同期入社という夢に近づくのだ。" voices=""/>
		<stopbgm @l="370" fadeout="1000"/>
		<clear @l="376" class="all"/>
		<msgshow @l="378" show="true"/>
		<wait_chgmv/>
		<bg @l="382" src="bg17m1"/>
		<bgm @l="386" src="bgm09" volume="1."/>
		<char @l="390" id="ookur" pos="auto" src="ookuro010"/>
		<msg @l="392" char_id="-1" frame_id="-1" name="大黒"
		   text="『これはこれは、よくおいでくださいました。』" voices=""/>
		<msg @l="394" char_id="-1" frame_id="-1" name=""
		   text="駅前で軽く時間を潰した後、約束の時間の１０分前に大黒建設へと到着した。" voices=""/>
		<msg @l="395" char_id="-1" frame_id="-1" name=""
		   text="それから受付嬢に案内された待合室で２０分ほど待たされた後、かっぷくのよい身体を揺らしながら大黒が現れた。" voices=""/>
		<clear @l="398" class="char"/>
		<char @l="400" id="ookur" pos="left" src="ookuro010"/>
		<char @l="403" id="rei" pos="right" src="rei015"/>
		<msg @l="405" char_id="1" frame_id="-1" name="玲"
		   text="『いえ‥‥こちらこそ、いきなりの電話で失礼致しました。』" voices=""/>
		<msg @l="407" char_id="-1" frame_id="-1" name="大黒"
		   text="『別に構いませんよ。就職活動中の学生さんというのは、一つでも内定をもらえるまでは不安で仕方が無いものですからねぇ。』"
		   voices=""/>
		<msg @l="409" char_id="-1" frame_id="-1" name="大黒"
		   text="『玲さんのように門戸の狭い職種を選ばれている方は、特に。』" voices=""/>
		<msg @l="411" char_id="1" frame_id="-1" name="玲" text="『‥‥ええ、そうですね。』"
		   voices=""/>
		<msg @l="413" char_id="-1" frame_id="-1" name=""
		   text="大黒の言葉に、玲は僅かに曇った表情のまま適当な答えを返す。" voices=""/>
		<msg @l="415" char_id="-1" frame_id="-1" name="大黒"
		   text="『では、とりあえず推薦状の方を受け取っておきましょうか。』" voices=""/>
		<msg @l="417" char_id="1" frame_id="-1" name="玲" text="『あ、はい‥‥これです。』"
		   voices=""/>
		<msg @l="419" char_id="-1" frame_id="-1" name=""
		   text="つい数時間前に朽木より受け取ったばかりの推薦状を大黒に渡す。" voices=""/>
		<msg @l="420" char_id="-1" frame_id="-1" name=""
		   text="そのＡ４サイズの紙切れ一枚の為に‥‥玲はプライドと大切な人を捨てたのだ。" voices=""/>
		<msg @l="421" char_id="-1" frame_id="-1" name=""
		   text="否‥‥その紙切れがもたらす「自分の未来」を手に入れる為、と言うべきか。" voices=""/>
		<msg @l="423" char_id="-1" frame_id="-1" name="大黒" text="『確かに受け取りました。』"
		   voices=""/>
		<msg @l="425" char_id="1" frame_id="-1" name="玲"
		   text="『あの‥‥それで、内定は戴けるんですよね？』" voices=""/>
		<msg @l="427" char_id="-1" frame_id="-1" name="大黒"
		   text="『詳細な結果につきましては先日の検査が終了してからでないとお話できませんので、その点についてはご了承ください。』" voices=""/>
		<char @l="430" id="rei" pos="right" src="rei125"/>
		<msg @l="432" char_id="1" frame_id="-1" name="玲" text="『そう‥‥ですか。』" voices=""/>
		<msg @l="434" char_id="-1" frame_id="-1" name="" text="玲はその言葉に下唇を噛み締める。"
		   voices=""/>
		<msg @l="435" char_id="-1" frame_id="-1" name=""
		   text="美帆を裏切ってまで手に入れようとする未来。確約されるまで、もどかしく感じるのも当然であった。" voices=""/>
		<char @l="438" id="ookur" pos="left" src="ookuro014"/>
		<msg @l="440" char_id="-1" frame_id="-1" name="大黒" text="『何か不都合でもおありですか？』"
		   voices=""/>
		<char @l="443" id="rei" pos="right" src="rei015"/>
		<msg @l="445" char_id="1" frame_id="-1" name="玲"
		   text="『不都合‥‥というワケではないんですけど、ただ‥‥‥。』" voices=""/>
		<msg @l="447" char_id="1" frame_id="-1" name="玲"
		   text="『出来れば早く結果を‥‥‥内定を貰って安心したいんです。』" voices=""/>
		<char @l="450" id="ookur" pos="left" src="ookuro010"/>
		<msg @l="452" char_id="-1" frame_id="-1" name="大黒"
		   text="『ふむ、何か切羽詰った事情がおありのようですね。』" voices=""/>
		<char @l="455" id="rei" pos="right" src="rei115"/>
		<msg @l="457" char_id="1" frame_id="-1" name="玲" text="『‥‥‥‥。』" voices=""/>
		<msg @l="459" char_id="-1" frame_id="-1" name=""
		   text="大黒の言葉に、玲は恐らく生まれて初めて「すがるような視線」を投げた。" voices=""/>
		<char @l="462" id="ookur" pos="left" src="ookuro010"/>
		<msg @l="464" char_id="-1" frame_id="-1" name="大黒"
		   text="『ではこうしましょう。アナタにはとりあえず弊社の別部署への仮内定を与えておいて、大学卒業時に希望部署へ移動するのです。』"
		   voices=""/>
		<char @l="467" id="rei" pos="right" src="rei014"/>
		<msg @l="469" char_id="1" frame_id="-1" name="玲" text="『そんな事が‥‥できるんですか？』"
		   voices=""/>
		<msg @l="471" char_id="-1" frame_id="-1" name="大黒"
		   text="『実は近年稀に見る不況をかんがみまして、新入社員の方々の支援のために新しい制度を導入したのです。』" voices=""/>
		<msg @l="473" char_id="-1" frame_id="-1" name="大黒"
		   text="『さらに女性社員の方に活躍してもらう、特別な部署を設けたいと思っていたのですよ。』" voices=""/>
		<msg @l="475" char_id="-1" frame_id="-1" name="大黒"
		   text="『前例はありませんが‥‥なに、上手くいきますよ。』" voices=""/>
		<msg @l="477" char_id="-1" frame_id="-1" name=""
		   text="言葉の後、大黒は満面の笑みを浮かべてみせる。" voices=""/>
		<char @l="480" id="rei" pos="right" src="rei115"/>
		<msg @l="482" char_id="1" frame_id="-1" name="玲"
		   text="『そういうことでしたら、是非お願いします。』" voices=""/>
		<msg @l="484" char_id="-1" frame_id="-1" name="大黒"
		   text="『あなたの通われている大学にいる、稲庭くんでしたっけ？彼も今回の制度で、すでに仮入社してますよ。』" voices=""/>
		<char @l="487" id="rei" pos="right" src="rei114"/>
		<msg @l="489" char_id="1" frame_id="-1" name="玲" text="『え！そうなんですか？』"
		   voices=""/>
		<msg @l="491" char_id="-1" frame_id="-1" name="大黒"
		   text="『ええ、白石さんもぜひ頑張ってください。』" voices=""/>
		<char @l="494" id="rei" pos="right" src="rei015"/>
		<msg @l="496" char_id="1" frame_id="-1" name="玲"
		   text="『私‥‥どんなことでも精一杯取り組みますから！よろしくお願いします！』" voices=""/>
		<msg @l="498" char_id="-1" frame_id="-1" name=""
		   text="どのようなことも受け入れる‥‥そんな心構えを見せ、玲は強く言い放った。" voices=""/>
		<msg @l="500" char_id="-1" frame_id="-1" name="大黒"
		   text="『そう言って戴けるとこちらとしてもありがたいですね。』" voices=""/>
		<msg @l="502" char_id="-1" frame_id="-1" name="大黒"
		   text="『では、これからまた簡単な適性検査を行いたいと思うのですが‥‥お時間の方はよろしいですか？』" voices=""/>
		<char @l="505" id="rei" pos="right" src="rei110"/>
		<msg @l="507" char_id="1" frame_id="-1" name="玲" text="『はい、大丈夫です。』"
		   voices=""/>
		<msg @l="509" char_id="-1" frame_id="-1" name=""
		   text="玲にとっては、今日ほど時間の浪費がありがたい日はない。" voices=""/>
		<msg @l="510" char_id="-1" frame_id="-1" name=""
		   text="その上、夢へと一歩近づいたことに今までの憂鬱な気分は消し飛び、ぱあっと明るい表情へと変わっていった。" voices=""/>
		<msg @l="512" char_id="-1" frame_id="-1" name="大黒"
		   text="『よかった。それではご案内致しますのでついてきてください。』" voices=""/>
		<char @l="515" id="rei" pos="right" src="rei120"/>
		<msg @l="517" char_id="1" frame_id="-1" name="玲" text="『お願いします。』" voices=""/>
		<clear @l="521" layer="ookur"/>
		<clear @l="524" layer="rei"/>
		<msg @l="526" char_id="-1" frame_id="-1" name=""
		   text="先ず大黒が歩き出し、玲がその背中を追って歩く。" voices=""/>
		<msg @l="527" char_id="-1" frame_id="-1" name=""
		   text="二人の会話を聞いていた社員たちが、何処か楽しげに笑っている。" voices=""/>
		<msg @l="528" char_id="-1" frame_id="-1" name="" text="また一人‥‥。" voices=""/>
		<msg @l="529" char_id="-1" frame_id="-1" name="" text="誰かがそんな事を小さくもらした。"
		   voices=""/>
		<msg @l="530" char_id="-1" frame_id="-1" name=""
		   text="けれど、その言葉が玲の耳に届く事は‥‥なかった―――。" voices=""/>
		<stopbgm @l="534" fadeout="1000"/>
		<clear @l="540" class="all"/>
		<msgshow @l="542" show="true"/>
		<wait_chgmv/>
		<bg @l="546" src="bg03a"/>
		<bgm @l="550" src="bgm04" volume="1."/>
		<char @l="554" id="miho" pos="auto" src="miho010"/>
		<msg @l="556" char_id="0" frame_id="-1" name="美帆" text="『ただいまぁ。』" voices=""/>
		<msg @l="558" char_id="-1" frame_id="-1" name="" text="―――夕暮れ時。" voices=""/>
		<msg @l="559" char_id="-1" frame_id="-1" name=""
		   text="私は１日の疲れを心身に抱えて家に戻ってきた。" voices=""/>
		<char @l="563" id="miho" pos="auto" src="miho014"/>
		<msg @l="565" char_id="0" frame_id="-1" name="美帆" text="『あれ‥‥玲さん、いないんですか？』"
		   voices=""/>
		<msg @l="567" char_id="-1" frame_id="-1" name=""
		   text="手にしていた買い物袋を、リビングテーブルの上に置いて、私は見当たらない玲さんの姿を探して回った。" voices=""/>
		<msg @l="568" char_id="-1" frame_id="-1" name=""
		   text="リビングはもちろん、キッチン、トイレ、お風呂場、玲さんの部屋‥‥。" voices=""/>
		<msg @l="569" char_id="-1" frame_id="-1" name=""
		   text="とりあえずひと通り探してみたけれど、やはり玲さんの姿は何処にも無い。" voices=""/>
		<char @l="573" id="miho" pos="auto" src="miho110"/>
		<msg @l="575" char_id="0" frame_id="-1" name="美帆"
		   text="『おかしいな‥‥いつもなら帰っててもおかしくない時間なのに。』" voices=""/>
		<msg @l="577" char_id="-1" frame_id="-1" name=""
		   text="そうつぶやいてから、私はふと昨日の事を思い出す。" voices=""/>
		<msg @l="579" char_id="0" frame_id="-1" name="美帆" text="『就職活動、大変なのかな‥‥。』"
		   voices=""/>
		<msg @l="581" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<char @l="585" id="miho" pos="auto" src="miho010"/>
		<msg @l="587" char_id="0" frame_id="-1" name="美帆" text="『ゴハンの用意‥‥先にしておこっと。』"
		   voices=""/>
		<char @l="590" id="miho" pos="auto" src="miho011"/>
		<msg @l="592" char_id="0" frame_id="-1" name="美帆"
		   text="『疲れている玲さんが元気になるように、今日は美帆ちゃん特製のスタミナご飯なのだ。』" voices=""/>
		<msg @l="594" char_id="-1" frame_id="-1" name=""
		   text="誰も居ない家の中で、私は一人明るく振舞った。" voices=""/>
		<msg @l="596" char_id="-1" frame_id="-1" name=""
		   text="自分を元気づけようと言った台詞だが、ちょっと子供っぽい事に気付き、急に恥ずかしくなって周りを見渡してしまった。" voices=""/>
		<char @l="599" id="miho" pos="auto" src="miho113"/>
		<msg @l="601" char_id="0" frame_id="-1" name="美帆" text="『誰も見てなくてよかった。』"
		   voices=""/>
		<msg @l="603" char_id="-1" frame_id="-1" name="" text="頬を赤らめながら、私は大きく息を吐いた。"
		   voices=""/>
		<stopbgm @l="608" fadeout="1000"/>
		<clear @l="614" class="all"/>
		<msgshow @l="616" show="true"/>
		<wait_chgmv/>
		<bg @l="620" src="bg03b"/>
		<bgm @l="624" src="bgm03" volume="1."/>
		<char @l="628" id="miho" pos="auto" src="miho136"/>
		<msg @l="630" char_id="0" frame_id="-1" name="美帆"
		   text="『ゴハン‥‥すっかり冷めちゃったなぁ。』" voices=""/>
		<msg @l="632" char_id="-1" frame_id="-1" name=""
		   text="夕飯の支度を終えてから、もうどれくらい経っただろうか。" voices=""/>
		<msg @l="633" char_id="-1" frame_id="-1" name=""
		   text="リビングの時計は２１時を少し過ぎた辺りを指している。" voices=""/>
		<msg @l="634" char_id="-1" frame_id="-1" name=""
		   text="いつもは１９時頃が夕食の時間になっているから、そうすると２時間以上経っていることになる‥‥。" voices=""/>
		<msg @l="635" char_id="-1" frame_id="-1" name="" text="私はそんなことをぼんやり考えていた。"
		   voices=""/>
		<msg @l="636" char_id="-1" frame_id="-1" name=""
		   text="ちなみに私自身は散々迷った挙句、空腹に勝てず、つい先ほど食事を済ませてしまい部屋着に着替えたところだ。" voices=""/>
		<msg @l="637" char_id="-1" frame_id="-1" name=""
		   text="いつまでも帰ってこない玲さんに待ちくたびれて、再び部屋に戻ろうと思ったが‥‥一度リビングのソファに座ったら、今度は立ち上がるのがおっくうになってしまった。"
		   voices=""/>
		<msg @l="639" char_id="0" frame_id="-1" name="美帆"
		   text="『玲さんも遅くなるなら、そう言ってくれればいいのにな‥‥。』" voices=""/>
		<msg @l="641" char_id="-1" frame_id="-1" name=""
		   text="一人分だけ食器を片付けるのも何となく面倒になって、私はしばらく暇を持て余すようにテレビを見ていた。" voices=""/>
		<msg @l="643" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="645" char_id="-1" frame_id="-1" name=""
		   text="ＣＭが入るたびにキッチンにコーヒーを入れに立ったり、トイレにいってみたりしながら１時間くらい過ごした頃‥‥。" voices=""/>
		<stopbgm @l="649" fadeout="1000"/>
		<se @l="653" buf="1" src="鍵を開ける音" volume="1."/>
		<char @l="657" id="miho" pos="auto" src="miho134"/>
		<msg @l="659" char_id="0" frame_id="-1" name="美帆" text="『あ‥‥帰ってきたかな？』"
		   voices=""/>
		<bgm @l="663" src="bgm02" volume="1."/>
		<msg @l="665" char_id="-1" frame_id="-1" name="" text="玄関の方で鍵を開ける音がした。"
		   voices=""/>
		<msg @l="666" char_id="-1" frame_id="-1" name=""
		   text="時計を見ると、既に２２時を大きく回ろうとしている。" voices=""/>
		<char @l="670" id="miho" pos="auto" src="miho031"/>
		<msg @l="672" char_id="0" frame_id="-1" name="美帆" text="『もう、玲さん遅かったですね。』"
		   voices=""/>
		<msg @l="674" char_id="-1" frame_id="-1" name=""
		   text="私は、近づいてくる足音に声を掛けながら振り返った。" voices=""/>
		<msg @l="675" char_id="-1" frame_id="-1" name=""
		   text="何の疑いもなく‥‥振り返った先には必ず玲さんがいるものと思っていた。" voices=""/>
		<stopbgm @l="679" fadeout="1000"/>
		<msg @l="681" char_id="-1" frame_id="-1" name="" text="けれど‥‥。" voices=""/>
		<char @l="685" id="kutsu" pos="auto" src="kutsu010"/>
		<bgm @l="689" src="bgm15" volume="1."/>
		<msg @l="691" char_id="-1" frame_id="-1" name="朽木"
		   text="『やあ、仲根クン‥‥こう改めて言葉を交わすのは久しぶりかな？』" voices=""/>
		<msg @l="693" char_id="-1" frame_id="-1" name=""
		   text="‥‥リビングの入り口に立っていたのは、玲さんではなく朽木教授だった。" voices=""/>
		<msg @l="694" char_id="-1" frame_id="-1" name=""
		   text="痴漢の一件より意識的に会うのを避けていたから、そういう意味では確かに久しぶりだろうか。" voices=""/>
		<msg @l="695" char_id="-1" frame_id="-1" name=""
		   text="‥‥ただ、よもや久々の対面がこんな形になるとは思ってもいなかった。" voices=""/>
		<clear @l="698" class="char"/>
		<char @l="700" id="kutsu" pos="right" src="kutsu010"/>
		<char @l="703" id="miho" pos="left" src="miho034"/>
		<msg @l="705" char_id="0" frame_id="-1" name="美帆" text="『どうして朽木教授がここに！？』"
		   voices=""/>
		<msg @l="707" char_id="0" frame_id="-1" name="美帆"
		   text="『玄関には鍵がかかってたハズじゃ‥‥‥‥あっ。』" voices=""/>
		<char @l="710" id="miho" pos="left" src="miho134"/>
		<msg @l="712" char_id="-1" frame_id="-1" name=""
		   text="そこで、美帆は朽木の手に握られている「それ」を見つける。" voices=""/>
		<msg @l="713" char_id="-1" frame_id="-1" name="" text="見慣れた形の金属片―――。"
		   voices=""/>
		<msg @l="714" char_id="-1" frame_id="-1" name=""
		   text="それは遠目にもこのマンションで使われている鍵だとすぐに解った。" voices=""/>
		<msg @l="716" char_id="0" frame_id="-1" name="美帆" text="『何でそれを教授が‥‥。』"
		   voices=""/>
		<char @l="719" id="kutsu" pos="right" src="kutsu018"/>
		<msg @l="721" char_id="-1" frame_id="-1" name="朽木"
		   text="『そんな事はどうでも良かろう。それよりも今は、もう少し別な心配をした方が良いのではないかね？』" voices=""/>
		<char @l="724" id="miho" pos="left" src="miho034"/>
		<msg @l="726" char_id="0" frame_id="-1" name="美帆" text="『え‥‥？』" voices=""/>
		<msg @l="728" char_id="-1" frame_id="-1" name="朽木"
		   text="『解らないか？&#32;今この場所には、男と女が一人ずつだけなのだよ。』" voices=""/>
		<char @l="731" id="miho" pos="left" src="miho035"/>
		<msg @l="733" char_id="0" frame_id="-1" name="美帆" text="『どういう‥‥意味ですか。』"
		   voices=""/>
		<msg @l="735" char_id="-1" frame_id="-1" name="朽木"
		   text="『電車の中の続きをしようということだよ。』" voices=""/>
		<clear @l="739" layer="kutsu"/>
		<msg @l="741" char_id="-1" frame_id="-1" name="" text="朽木教授が早足で私の方へ歩み寄ってきた。"
		   voices=""/>
		<char @l="744" id="miho" pos="left" src="miho034"/>
		<msg @l="746" char_id="0" frame_id="-1" name="美帆" text="『‥‥！？』" voices=""/>
		<clear @l="750" layer="miho"/>
		<msg @l="752" char_id="-1" frame_id="-1" name=""
		   text="そこでようやく彼の意図に気付いた私は、慌てて教授との距離を取ろうとする‥‥。" voices=""/>
		<msg @l="753" char_id="-1" frame_id="-1" name="" text="しかし、気付くのが少し遅かった‥‥。"
		   voices=""/>
		<char @l="756" id="miho" pos="left" src="miho035"/>
		<char @l="758" id="kutsu" pos="auto" src="kutsu018"/>
		<msg @l="760" char_id="0" frame_id="-1" name="美帆" text="『あっ‥‥！？』" voices=""/>
		<msg @l="762" char_id="-1" frame_id="-1" name=""
		   text="走り出そうとした瞬間、朽木教授に腕を捕まれ私は壁に押し付けられた。" voices=""/>
		<msg @l="763" char_id="-1" frame_id="-1" name=""
		   text="そうして‥‥自分の身体と壁で私を挟むように、教授が覆い被さってきた。" voices=""/>
		<clear @l="766" class="char"/>
		<char @l="768" id="miho" pos="center" src="miho035f" y="-80"/>
		<msg @l="770" char_id="-1" frame_id="-1" name="朽木" text="『ククク、捕まえた。』"
		   voices=""/>
		<msg @l="772" char_id="0" frame_id="-1" name="美帆" text="『きゃ‥‥いや、離してくださいっ！！』"
		   voices=""/>
		<msg @l="774" char_id="-1" frame_id="-1" name="朽木" text="『ククク、かわいいねぇ。』"
		   voices=""/>
		<msg @l="776" char_id="0" frame_id="-1" name="美帆"
		   text="『いや、助けてっ‥‥玲さんっ‥‥‥玲さんっ！！』" voices=""/>
		<msg @l="778" char_id="-1" frame_id="-1" name="朽木"
		   text="『幾ら助けを呼んでも彼女は来ない。絶対にな。』" voices=""/>
		<char @l="781" id="miho" pos="center" src="miho034f" y="-80"/>
		<msg @l="783" char_id="0" frame_id="-1" name="美帆"
		   text="『そんな‥‥‥‥あ、まさか玲さんにもこんなことをっ！？』" voices=""/>
		<msg @l="785" char_id="-1" frame_id="-1" name="朽木" text="『さて、どうかな。』"
		   voices=""/>
		<char @l="788" id="miho" pos="center" src="miho035f" y="-80"/>
		<msg @l="790" char_id="0" frame_id="-1" name="美帆" text="『‥‥ヒドイことをしたんですね。』"
		   voices=""/>
		<msg @l="792" char_id="-1" frame_id="-1" name="朽木" text="『直接聞いてみたらどうかね。』"
		   voices=""/>
		<msg @l="794" char_id="-1" frame_id="-1" name=""
		   text="教授は口元を歪めると、服の上から私の胸を乱暴に揉みしだいた。" voices=""/>
		<char @l="797" id="miho" pos="center" src="miho135f" y="-80"/>
		<msg @l="799" char_id="0" frame_id="-1" name="美帆"
		   text="『やっ、いやぁぁ‥‥やめて、やめてくださいっ！！』" voices=""/>
		<msg @l="801" char_id="-1" frame_id="-1" name="朽木"
		   text="『諦めたまえ、このマンションは防音も完璧‥‥キミが幾ら騒いだところで誰もこの事に気付きはしない。』" voices=""/>
		<char @l="804" id="miho" pos="center" src="miho035f" y="-80"/>
		<msg @l="806" char_id="0" frame_id="-1" name="美帆"
		   text="『そんなの嘘ですっ‥‥‥誰か、誰か助けてっ！！』" voices=""/>
		<msg @l="808" char_id="-1" frame_id="-1" name="朽木" text="『無駄だといっただろう。』"
		   voices=""/>
		<msg @l="810" char_id="-1" frame_id="-1" name=""
		   text="彼は嘲笑うように吐き捨てると、胸を揉みしだいていた手をショートパンツの中へもぐりこませてきた。" voices=""/>
		<begin_trans @l="814" time="500"/>
		<layer @l="815" id="cutin_f" src="game_window_cutin" x="20" y="20" z="-1001"/>
		<layer @l="816" id="cutin" src="cut001b" x="32" y="32" z="-1000"/>
		<end_trans @l="817"/>
		<msg @l="819" char_id="-1" frame_id="-1" name=""
		   text="硬い指先が‥‥下着越しの秘部へと添えられる。" voices=""/>
		<msg @l="820" char_id="-1" frame_id="-1" name="" text="さわっ、さわっ。" voices=""/>
		<msg @l="822" char_id="0" frame_id="-1" name="美帆" text="『やっ、いやぁぁぁぁぁっっ！！』"
		   voices=""/>
		<msg @l="824" char_id="-1" frame_id="-1" name=""
		   text="朽木教授の指先が下着の上から花唇をなぞり上げた瞬間、私は渾身の力を込めて精一杯に悲鳴をあげた。" voices=""/>
		<msg @l="826" char_id="-1" frame_id="-1" name="朽木"
		   text="『くく‥‥‥、電車の中では下着越しにしか触ってあげられなかったからね。今日は君のココをたっぷりと味合わせてもらうよ。』"
		   voices=""/>
		<msg @l="828" char_id="-1" frame_id="-1" name=""
		   text="そう言うと、手を下着の中にまで入れてきた。" voices=""/>
		<begin_trans @l="831" time="500"/>
		<layer @l="832" id="cutin_f" src="game_window_cutin" x="20" y="20" z="-1001"/>
		<layer @l="833" id="cutin" src="cut001a" x="32" y="32" z="-1000"/>
		<end_trans @l="834"/>
		<msg @l="836" char_id="-1" frame_id="-1" name="" text="くにゅ。" voices=""/>
		<msg @l="838" char_id="0" frame_id="-1" name="美帆" text="『いっ、やぁぁぁぁぁぁぁっ！』"
		   voices=""/>
		<clear @l="841" class="char"/>
		<begin_trans @l="843" time="500"/>
		<clear @l="844" layer="cutin_f"/>
		<clear @l="845" layer="cutin"/>
		<end_trans @l="846"/>
		<se @l="850" buf="1" src="人とぶつかる音" volume="1."/>
		<msg @l="851" char_id="-1" frame_id="-1" name="" text="ドン！" voices=""/>
		<msg @l="853" char_id="-1" frame_id="-1" name=""
		   text="私は悲鳴を上げながら思い切り朽木教授を突き飛ばし、自分の部屋へと走り出した。" voices=""/>
		<char @l="856" id="kutsu" pos="center" src="kutsu010f" y="-80"/>
		<msg @l="858" char_id="-1" frame_id="-1" name="朽木" text="『ふぅ‥‥物分りの悪い子だな。』"
		   voices=""/>
		<msg @l="860" char_id="-1" frame_id="-1" name=""
		   text="私の上げた悲鳴に対し、朽木教授は露骨に嫌味を吐き捨てて、後を追ってきた。" voices=""/>
		<clear @l="866" class="all"/>
		<msgshow @l="868" show="true"/>
		<wait_chgmv/>
		<bg @l="872" src="bg01b"/>
		<char @l="874" id="miho" pos="auto" src="miho135"/>
		<msg @l="876" char_id="-1" frame_id="-1" name=""
		   text="私は息を切らせながら、自分の部屋のドアノブを内側から押さえていた。" voices=""/>
		<msg @l="878" char_id="0" frame_id="1" name="美帆" text="（どうして、どうしてこんな事に‥‥‥）"
		   voices=""/>
		<msg @l="881" char_id="-1" frame_id="-1" name="" text="がちゃ、がちゃ。" voices=""/>
		<char @l="884" id="miho" pos="auto" src="miho134"/>
		<msg @l="886" char_id="0" frame_id="1" name="美帆" text="『ひっ‥‥‥！』" voices=""/>
		<msg @l="888" char_id="-1" frame_id="-1" name="朽木"
		   text="『仲根クン、そんなに怖がらなくても良いじゃないか。安心したまえ。気持ちよくさせてあげるよ。きっと君も病み付きになる‥‥‥。』"
		   voices=""/>
		<char @l="891" id="miho" pos="auto" src="miho035"/>
		<msg @l="893" char_id="0" frame_id="1" name="美帆" text="『お願いです！もう帰ってください！！』"
		   voices=""/>
		<msg @l="895" char_id="-1" frame_id="-1" name="朽木"
		   text="『そうはいかんよ。せっかく招待していただいたのだからね。』" voices=""/>
		<char @l="898" id="miho" pos="auto" src="miho034"/>
		<msg @l="900" char_id="0" frame_id="1" name="美帆" text="『え‥‥‥？』" voices=""/>
		<msg @l="902" char_id="-1" frame_id="-1" name=""
		   text="その言葉に、一瞬気をとられた私は、ドアを押さえる力を緩めてしまった。" voices=""/>
		<msg @l="903" char_id="-1" frame_id="-1" name=""
		   text="もちろん、教授はその一瞬を見逃さず、ドアを思い切り押して部屋の中に入ってきてしまった。" voices=""/>
		<se @l="907" buf="1" src="人とぶつかる音" volume="1."/>
		<shake @l="911" amp="10" class="all" cycle="30" duration="1000"
		   type="random"/>
		<msg @l="913" char_id="-1" frame_id="-1" name="" text="ドン！" voices=""/>
		<char @l="916" id="miho" pos="auto" src="miho134"/>
		<msg @l="918" char_id="0" frame_id="1" name="美帆" text="『きゃっ！！』" voices=""/>
		<clear @l="921" class="char"/>
		<msg @l="923" char_id="-1" frame_id="-1" name=""
		   text="私は思い切り開け放たれたドアの勢いで、床に倒れてしまった。" voices=""/>
		<msg @l="925" char_id="-1" frame_id="-1" name="朽木"
		   text="『男をじらすのが女のたしなみ、と言われたりするが、じらせすぎはいかんなぁ。』" voices=""/>
		<char @l="928" id="miho" pos="center" src="miho035f" y="-80"/>
		<msg @l="930" char_id="-1" frame_id="-1" name="" text="ゆっくりと、朽木教授は私に近づいてくる。"
		   voices=""/>
		<msg @l="931" char_id="-1" frame_id="-1" name=""
		   text="私は何とか逃げようと、倒れながらも後ずさる。" voices=""/>
		<msg @l="932" char_id="-1" frame_id="-1" name=""
		   text="しかし、そんなに広くない部屋で逃げる場所もなく、簡単に部屋の隅に追い詰められてしまった。" voices=""/>
		<msg @l="933" char_id="-1" frame_id="-1" name=""
		   text="そして、朽木教授はポケットから長方形の‥‥例えるなら少し大きな携帯電話のような「何か」を取り出して私の首元に押し付けた。"
		   voices=""/>
		<char @l="936" id="miho" pos="center" src="miho034f" y="-80"/>
		<msg @l="938" char_id="0" frame_id="1" name="美帆" text="『え‥‥？』" voices=""/>
		<msg @l="940" char_id="-1" frame_id="-1" name="朽木" text="『おしおきだ。』" voices=""/>
		<msg @l="942" char_id="-1" frame_id="-1" name=""
		   text="そう言って、朽木教授は手にしていた長方形のそれを指先で操作した。" voices=""/>
		<msg @l="943" char_id="-1" frame_id="-1" name="" text="瞬間―――。" voices=""/>
		<se @l="947" buf="1" src="ムチの音" volume="1."/>
		<flash @l="951" count="4" fade="100" image="white"/>
		<char @l="954" id="miho" pos="center" src="miho134f" y="-80"/>
		<msg @l="956" char_id="0" frame_id="1" name="美帆" text="『うあっ！？』" voices=""/>
		<msg @l="958" char_id="-1" frame_id="-1" name=""
		   text="ものすごい音が耳元でしたかと思うと、首筋の辺りから全身に刺すような痛みが駆け抜けていった。" voices=""/>
		<char @l="961" id="miho" pos="center" src="miho035f" y="-80"/>
		<msg @l="963" char_id="0" frame_id="1" name="美帆" text="『なに‥‥いまの‥‥‥？』"
		   voices=""/>
		<msg @l="965" char_id="-1" frame_id="-1" name=""
		   text="首筋に当てられた「それ」を見ようと頭を動かした瞬間、眩暈がした。" voices=""/>
		<msg @l="966" char_id="-1" frame_id="-1" name=""
		   text="刺すような痛みは一瞬で消え、代わりに妙な痺れが全身を襲っている。" voices=""/>
		<msg @l="968" char_id="-1" frame_id="-1" name="朽木"
		   text="『これはスタンガンといってね、こんな風に相手を無力にする為のものなのだよ。』" voices=""/>
		<msg @l="970" char_id="-1" frame_id="-1" name=""
		   text="嘲るように言い放ち、教授が手に持った機械を私の眼前に晒して見せる。" voices=""/>
		<msg @l="972" char_id="0" frame_id="1" name="美帆" text="『そ‥‥‥んな‥‥‥。』"
		   voices=""/>
		<clear @l="975" class="char"/>
		<msg @l="977" char_id="-1" frame_id="-1" name=""
		   text="私の身体は自身の意思に反して、一気に力が抜け落ち床に崩れ落ちた。" voices=""/>
		<msg @l="979" char_id="-1" frame_id="-1" name="" text="意識が遠退き、目の前が真っ暗になる。"
		   voices=""/>
		<clear @l="982" class="all"/>
		<wait_chgmv/>
		<bg @l="984" src="bg01b"/>
		<msg @l="986" char_id="-1" frame_id="-1" name="朽木"
		   text="『なに、電流も電圧も大して高くない既製品だ‥‥しばらくは意識が朦朧とするかも知れぬが、後遺症などは残らないから安心してくれたまえ。』"
		   voices=""/>
		<clear @l="989" class="all"/>
		<wait_chgmv/>
		<bg @l="991" src="bg01b"/>
		<msg @l="993" char_id="-1" frame_id="-1" name=""
		   text="ニヤニヤとした表情を浮かべて、朽木教授がなにやらうんちくを並べていた。" voices=""/>
		<msg @l="994" char_id="-1" frame_id="-1" name=""
		   text="私はそれをどこか遠くから聞こえてくる話のように聞きながら‥‥ゆっくりと意識を手放していった。" voices=""/>
		<stopbgm @l="998" fadeout="1000"/>
		<clear @l="1004" class="all"/>
		<msgshow @l="1006" show="true"/>
		<wait_chgmv/>
		<bg @l="1010" src="bg01b"/>
		<msg @l="1012" char_id="0" frame_id="1" name="美帆" text="『んっ‥‥。』" voices=""/>
		<msg @l="1014" char_id="-1" frame_id="-1" name=""
		   text="僅かな頭痛と共に目が覚めると、そこには見慣れた天井があった。" voices=""/>
		<msg @l="1016" char_id="0" frame_id="1" name="美帆"
		   text="『ここ、私の部屋‥‥‥‥あれ‥‥わたし‥‥‥。』" voices=""/>
		<char @l="1020" id="kutsu" pos="center" src="kutsu010f" y="-80"/>
		<bgm @l="1024" src="bgm15" volume="1."/>
		<msg @l="1026" char_id="-1" frame_id="-1" name="朽木" text="『お目覚めのようだね、仲根クン。』"
		   voices=""/>
		<msg @l="1028" char_id="-1" frame_id="-1" name=""
		   text="視界いっぱいに、朽木教授の顔が迫ってくる。" voices=""/>
		<msg @l="1029" char_id="-1" frame_id="-1" name=""
		   text="私は‥‥朽木教授に圧し掛かられる形で、ベッドの上に寝かされていた。" voices=""/>
		<msg @l="1031" char_id="0" frame_id="1" name="美帆"
		   text="『え‥‥朽木教授‥‥‥‥‥どうして‥‥‥あっ！？』" voices=""/>
		<msg @l="1033" char_id="-1" frame_id="-1" name=""
		   text="つい先ほどの出来事を思い出し、私は慌てて身体を起こそうとする。" voices=""/>
		<msg @l="1034" char_id="-1" frame_id="-1" name=""
		   text="‥‥が、身体を動かそうとすると、頭が朦朧としてそれどころじゃない。" voices=""/>
		<msg @l="1036" char_id="-1" frame_id="-1" name="朽木"
		   text="『キミは今、軽い脳しんとう状態なのだよ‥‥悪いことは言わないから、大人しくしていることだな。』" voices=""/>
		<char @l="1039" id="kutsu" pos="center" src="kutsu018f" y="-80"/>
		<msg @l="1041" char_id="-1" frame_id="-1" name="朽木"
		   text="『それに今、キミに逃げられてはせっかくこれまで念入りにしてきた前戯が無駄になってしまうのでね。』" voices=""/>
		<msg @l="1043" char_id="-1" frame_id="-1" name="" text="教授がニタリと笑った。"
		   voices=""/>
		<msg @l="1045" char_id="0" frame_id="1" name="美帆"
		   text="『ゼンギって‥‥‥‥‥え、きゃっ！！私どうして裸なんですかっ！？』" voices=""/>
		<msg @l="1047" char_id="-1" frame_id="-1" name=""
		   text="私はようやく、自分が衣服を脱がされてしまっている事に気付いた。" voices=""/>
		<msg @l="1049" char_id="0" frame_id="1" name="美帆" text="『いや‥‥見ないでくださいっ！！』"
		   voices=""/>
		<msg @l="1051" char_id="-1" frame_id="-1" name="朽木"
		   text="『何を今さら、キミが気を失っている間に、全身くまなく拝ませて舐めさせてもらったよ。』" voices=""/>
		<clear @l="1054" class="char"/>
		<msg @l="1056" char_id="-1" frame_id="-1" name=""
		   text="朽木教授はそう言いながらも、さらに彼女の穢れを知らぬ柔肌を舐め尽くそうと程よい弾力のある乳房に舌を這わせた。" voices=""/>
		<msg @l="1057" char_id="-1" frame_id="-1" name=""
		   text="どうやら、彼女が気を失っていた間の行為ではまだまだ物足りないようだ。" voices=""/>
		<char @l="1060" id="miho" pos="center" src="miho105f" y="-80"/>
		<msg @l="1062" char_id="0" frame_id="1" name="美帆" text="『いやああっ‥‥やめてっ。』"
		   voices=""/>
		<msg @l="1064" char_id="-1" frame_id="-1" name=""
		   text="私の悲痛の叫びをよそに、教授が右の乳房を吸いたてた。" voices=""/>
		<msg @l="1066" char_id="-1" frame_id="-1" name="" text="指は私の陰唇をチロチロといじくりだす。"
		   voices=""/>
		<begin_trans @l="1069" time="500"/>
		<layer @l="1070" id="cutin_f" src="game_window_cutin" x="20" y="20"
		   z="-1001"/>
		<layer @l="1071" id="cutin" src="cut003a" x="32" y="32" z="-1000"/>
		<end_trans @l="1072"/>
		<char @l="1075" id="miho" pos="center" src="miho005f" y="-80"/>
		<msg @l="1077" char_id="0" frame_id="1" name="美帆" text="『あっ‥‥いやっ。』"
		   voices=""/>
		<msg @l="1079" char_id="-1" frame_id="-1" name=""
		   text="いきなり他人に秘部を触れられて、私の躰がビクンと揺れた。" voices=""/>
		<msg @l="1080" char_id="-1" frame_id="-1" name=""
		   text="教授の舌は私の乳首をなぶり続け、膨らみが増したのを確認すると満足したのか、さらに乳頭を薙ぎ伏せ、押し捏ねた。" voices=""/>
		<msg @l="1082" char_id="-1" frame_id="-1" name="朽木"
		   text="『キミの躰は触れるのが畏れ多いほど美しい。』" voices=""/>
		<msg @l="1084" char_id="-1" frame_id="-1" name=""
		   text="教授の指も舌同様、さらにしつこく私の肉芯を捏ねりだし、肉路の花びらをなぞり始めた。" voices=""/>
		<char @l="1087" id="miho" pos="center" src="miho105f" y="-80"/>
		<msg @l="1089" char_id="0" frame_id="1" name="美帆" text="『あうっ‥‥いやっ、こんなのいやっ！』"
		   voices=""/>
		<msg @l="1091" char_id="-1" frame_id="-1" name=""
		   text="私の抵抗の声を聞きながら、朽木教授は乳首を甘噛みして弄ぶ。" voices=""/>
		<msg @l="1092" char_id="-1" frame_id="-1" name=""
		   text="充分にその感触を味わった後は、今度は大事な秘部へと口をつけた。" voices=""/>
		<begin_trans @l="1095" time="500"/>
		<layer @l="1096" id="cutin_f" src="game_window_cutin" x="20" y="20"
		   z="-1001"/>
		<layer @l="1097" id="cutin" src="cut003" x="32" y="32" z="-1000"/>
		<end_trans @l="1098"/>
		<char @l="1100" id="miho" pos="center" src="miho005f" y="-80"/>
		<msg @l="1102" char_id="0" frame_id="1" name="美帆" text="『ああっ‥‥！』" voices=""/>
		<msg @l="1104" char_id="-1" frame_id="-1" name=""
		   text="まだ、男の人を知らない私にとってはたまらない恥辱だ。喉奥で呻きながら身悶えをしたが、教授は赦してはくれなかった。" voices=""/>
		<msg @l="1105" char_id="-1" frame_id="-1" name=""
		   text="彼はその動きを凝視しながら、もっとも敏感なクリ○リスを直接、舌で刺激した。" voices=""/>
		<char @l="1108" id="miho" pos="center" src="miho004f" y="-80"/>
		<msg @l="1110" char_id="0" frame_id="1" name="美帆" text="『ひっ、ひやっ！』" voices=""/>
		<msg @l="1112" char_id="-1" frame_id="-1" name=""
		   text="全身に電流が流れるように、私の躰は小刻みに震えた。教授はその反応を見ると、さらにクチャクチャと蜜を舌で弾かせて、クンニを続けた。"
		   voices=""/>
		<char @l="1115" id="miho" pos="center" src="miho005f" y="-80"/>
		<msg @l="1117" char_id="0" frame_id="1" name="美帆"
		   text="『やああっ‥‥こんなの、ひどいです‥‥‥ひどすぎますっ。』" voices=""/>
		<begin_trans @l="1120" time="500"/>
		<clear @l="1121" layer="cutin_f"/>
		<clear @l="1122" layer="cutin"/>
		<end_trans @l="1123"/>
		<char @l="1125" id="kutsu" pos="center" src="kutsu018f" y="-80"/>
		<msg @l="1127" char_id="-1" frame_id="-1" name="朽木"
		   text="『残念だが、ひどいことをされるのはこれからだよ。』" voices=""/>
		<char @l="1130" id="miho" pos="center" src="miho004f" y="-80"/>
		<msg @l="1132" char_id="0" frame_id="1" name="美帆" text="『え‥‥？』" voices=""/>
		<msg @l="1134" char_id="-1" frame_id="-1" name=""
		   text="僅かな含み笑いと共に、朽木教授はズボンのチャックを下ろし、その内側から硬く屹立したグロテスクな生き物を私に見せつけるように取り出した。"
		   voices=""/>
		<msg @l="1135" char_id="-1" frame_id="-1" name=""
		   text="そして、その生き物を私の秘所へあてがうと、狙いを定めるように何度か往復させた。" voices=""/>
		<msg @l="1137" char_id="0" frame_id="1" name="美帆" text="『‥‥！？』" voices=""/>
		<char @l="1140" id="kutsu" pos="center" src="kutsu010f" y="-80"/>
		<msg @l="1142" char_id="-1" frame_id="-1" name="朽木"
		   text="『キミの瑞々しい躰を味合わせてもらっていたからね、私のモノはもうこんなになってしまったよ。』" voices=""/>
		<msg @l="1144" char_id="-1" frame_id="-1" name=""
		   text="そして教授は私の大事な所へといきり立った肉棒の先端を押し付けてきた。" voices=""/>
		<clear @l="1147" class="char"/>
		<char @l="1149" id="miho" pos="left" src="miho105"/>
		<char @l="1151" id="kutsu" pos="right" src="kutsu010"/>
		<msg @l="1153" char_id="0" frame_id="1" name="美帆"
		   text="『いやああ‥‥‥やだっ、やめてくださいっ！！』" voices=""/>
		<msg @l="1155" char_id="0" frame_id="1" name="美帆"
		   text="『わ、わたし‥‥初めてなんです‥‥‥‥お願いです！！』" voices=""/>
		<char @l="1158" id="kutsu" pos="right" src="kutsu018"/>
		<msg @l="1160" char_id="-1" frame_id="-1" name="朽木"
		   text="『くくっ、キミが処女であることくらい秘部をたっぷり嬲らせてもらったので知ってるよ。』" voices=""/>
		<msg @l="1162" char_id="-1" frame_id="-1" name="朽木"
		   text="『だが、だからどうしたというのかね？』" voices=""/>
		<char @l="1165" id="miho" pos="left" src="miho005"/>
		<msg @l="1167" char_id="0" frame_id="1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<char @l="1170" id="kutsu" pos="right" src="kutsu010"/>
		<msg @l="1172" char_id="-1" frame_id="-1" name="朽木"
		   text="『せめて初めては好きな人に、などという幻想は捨ててしまった方がいいのだよ‥‥特にこの南総町という場所ではね。』" voices=""/>
		<char @l="1175" id="miho" pos="left" src="miho105"/>
		<msg @l="1177" char_id="0" frame_id="1" name="美帆" text="『それ、どういう意味ですか‥‥？』"
		   voices=""/>
		<msg @l="1179" char_id="-1" frame_id="-1" name="朽木"
		   text="『さて‥‥電車の件以来、お預けが長すぎたので少しお喋りが過ぎてしまったようだ。』" voices=""/>
		<msg @l="1181" char_id="-1" frame_id="-1" name=""
		   text="教授は悪びれもせずそう言うと、醜怪な肉幹の先端を使って秘裂の割れ目を再び、上下になぞり始めた。" voices=""/>
		<char @l="1184" id="miho" pos="left" src="miho005"/>
		<msg @l="1186" char_id="0" frame_id="1" name="美帆" text="『んんっ‥‥。』" voices=""/>
		<msg @l="1188" char_id="-1" frame_id="-1" name=""
		   text="さんざ弄られしまったからだろう、私のソコは敏感になっているらしく、先端で擦り上げられるたびにピリピリとした痺れが、頭から抜けていった。"
		   voices=""/>
		<char @l="1191" id="kutsu" pos="right" src="kutsu018"/>
		<msg @l="1193" char_id="-1" frame_id="-1" name="朽木"
		   text="『処女にしては大した濡れ具合だ、これなら十分にこの町でもやっていけるというものだ。』" voices=""/>
		<msg @l="1195" char_id="0" frame_id="1" name="美帆"
		   text="『‥‥やぁ‥‥いやっ‥‥やめて下さい‥‥。』" voices=""/>
		<msg @l="1197" char_id="-1" frame_id="-1" name=""
		   text="教授はまた町のことについて囁くと、私の感触を味わうように何度も先端で割れ目を擦り上げては淫靡な水音を響かせた。" voices=""/>
		<clear @l="1203" class="all"/>
		<label @l="1206" id="event_scene46"/>
		<msg @l="1208" char_id="-1" frame_id="-1" name="朽木"
		   text="『くくく、それでは‥‥待ちわびた開通式を始めようか。』" voices=""/>
		<msg @l="1210" char_id="0" frame_id="1" name="美帆" text="『‥‥！！』" voices=""/>
		<msg @l="1212" char_id="-1" frame_id="-1" name=""
		   text="教授が喜色に満ちた声と共に、腰をぐいと押し付けてくる。" voices=""/>
		<msg @l="1213" char_id="-1" frame_id="-1" name=""
		   text="その瞬間―――身体を真っぷたつに裂かれるような痛みが、私の下腹部を駆け抜けた。" voices=""/>
		<label @l="1217" id="chart_line29"/>
		<wait_chgmv/>
		<ev @l="1221" src="ev-046"/>
		<description @l="1224" text="望まない取り引きＢ"/>
		<bgm @l="1228" src="bgm14" volume="1."/>
		<msg @l="1230" char_id="0" frame_id="1" name="美帆" text="『んあっっ！！』"
		   voices="miho10590"/>
		<msg @l="1232" char_id="-1" frame_id="-1" name=""
		   text="ズブズブと膣奥深く埋め込まれた、教授の淫棒は私の処女膜を破り、一気に子宮までその先端をもぐらせた。" voices=""/>
		<msg @l="1233" char_id="-1" frame_id="-1" name=""
		   text="メリメリと裂かれた激痛から、私は身悶え絶叫した。" voices=""/>
		<msg @l="1235" char_id="-1" frame_id="-1" name="朽木"
		   text="『おお、さすが処女なだけあって‥‥‥きついな。』" voices=""/>
		<msg @l="1237" char_id="-1" frame_id="-1" name=""
		   text="熱く硬いモノを身体の奥へと差し込まれ、強い衝撃にたまらず私は、躰をのけ反らした。引き裂かれる痛みに息を飲み、下腹部から全身に襲ってくる痛みと嫌悪に耐えた。"
		   voices=""/>
		<msg @l="1239" char_id="-1" frame_id="-1" name=""
		   text="教授は突き入れた胎内の具合を確かめるように腰を前後に揺すり、喜々として肉棒を出し入れした。" voices=""/>
		<msg @l="1241" char_id="0" frame_id="1" name="美帆"
		   text="『うあﾞっ‥‥‥や、動かないでっ‥‥いたっ‥‥いたいっっ‥‥。』" voices="miho10600"/>
		<msg @l="1243" char_id="-1" frame_id="-1" name=""
		   text="彼が腰を動かすと、突き入れた肉柱が引き裂かれたばかりの私の秘所を擦りつける。‥‥そこに生まれる激痛は脳天まで突きぬけ、私は、哀虐の呻きを洩らした。"
		   voices=""/>
		<msg @l="1245" char_id="-1" frame_id="-1" name="朽木"
		   text="『なに、この締め付けならばすぐに終わる。ククク、それにすぐ馴れて、よがるようになる。』" voices=""/>
		<msg @l="1247" char_id="-1" frame_id="-1" name=""
		   text="教授は無責任に笑い、腰をつかんで、スライドに力を入れた。" voices=""/>
		<msg @l="1248" char_id="-1" frame_id="-1" name=""
		   text="そのたびに、彼の亀頭で胎内の肉壁を引きずられるような感触と、息もできない痛みが襲ってきた。" voices=""/>
		<msg @l="1250" char_id="0" frame_id="1" name="美帆"
		   text="『あﾞっ、あﾞっ、あﾞっ‥‥いやぁぁ‥‥いたっ‥‥ん、あぐっ！！』" voices="miho10610"/>
		<msg @l="1252" char_id="0" frame_id="1" name="美帆"
		   text="『うあっ‥‥んっ、んっ、んっ‥‥いたいっ‥‥やめっ、動かさないでくださいっ！！』" voices="miho10620"/>
		<msg @l="1254" char_id="-1" frame_id="-1" name="朽木"
		   text="『馬鹿なことをいう娘だ。これほど具合のいい膣内に入れているのに、腰を動かさないなど愚かしい。』" voices=""/>
		<msg @l="1256" char_id="0" frame_id="1" name="美帆"
		   text="『そんなこと‥‥‥んあﾞっ‥‥‥私にはかんけいなっ‥‥んん‥‥いたいっ‥‥いたっ‥‥ああっ！！』"
		   voices="miho10630"/>
		<msg @l="1258" char_id="0" frame_id="1" name="美帆"
		   text="『いっ‥‥あっ、んぐっ‥‥‥そこ‥‥いっ、あﾞあﾞっ！！』" voices="miho10640"/>
		<msg @l="1260" char_id="-1" frame_id="-1" name=""
		   text="‥‥肉の槍とも呼べる凶器によって引き裂かれた私の膣内を、教授が擦り上げる痛みにより、初めて男の人を受け入れた私の秘所は絶え間ない痙攣を起こしていた。"
		   voices=""/>
		<msg @l="1262" char_id="-1" frame_id="-1" name="朽木"
		   text="『いいぞ、いいっ‥‥キミの膣内は実に具合がいい。』" voices=""/>
		<msg @l="1264" char_id="-1" frame_id="-1" name=""
		   text="淫欲に酔いしれた教授の腰のスピードが更に上がる。膣中を壮絶な勢いでこねくり抉り、肉棒を出し入れした。" voices=""/>
		<msg @l="1266" char_id="-1" frame_id="-1" name="朽木"
		   text="『私のモノに吸い付くように絡み付いて、抜こうとするごとに締め付けてくる。ククク、これで処女だったというのだから将来が楽しみだ。』"
		   voices=""/>
		<msg @l="1268" char_id="-1" frame_id="-1" name=""
		   text="興奮しているのか、教授が絶賛の言葉を並べ立てながら腰を振り続けた。" voices=""/>
		<msg @l="1270" char_id="0" frame_id="1" name="美帆"
		   text="『あﾞっ、あﾞっ、あﾞっ‥‥いやぁぁ‥‥いたっ‥‥ん、あぐっ！！』" voices="miho10610"/>
		<msg @l="1272" char_id="-1" frame_id="-1" name=""
		   text="確かに私の意思に反して、下腹部の痛みの為、力を入れると秘部を締めることになり、彼の肉棒を締めつける結果になっていた。"
		   voices=""/>
		<msg @l="1274" char_id="0" frame_id="1" name="美帆"
		   text="『んんっ‥‥んっ、んっ、んっ、んあﾞっ！！』" voices="miho10650"/>
		<msg @l="1276" char_id="0" frame_id="1" name="美帆"
		   text="『いあっ、そんなに強く‥‥‥‥おしつけないでっ‥‥‥‥。』" voices="miho10660"/>
		<msg @l="1278" char_id="-1" frame_id="-1" name=""
		   text="気がつくと部屋の中で、ピチュ、グチュ、ネチュといういやらしい音が響いていた。教授の肉棒が秘部を抜き差しするたびに、蜜汁がいやらしい音色を奏でているのだ。"
		   voices=""/>
		<msg @l="1279" char_id="-1" frame_id="-1" name=""
		   text="私は胎内で感じる事を拒否したが、朽木教授相手でさえ、順応しようとする身体をうらめしく思った。" voices=""/>
		<msg @l="1281" char_id="0" frame_id="1" name="美帆"
		   text="『んっ、んんっ‥‥‥あﾞっ、あﾞっ、あﾞっ、んぐっ！！』" voices="miho10670"/>
		<msg @l="1283" char_id="0" frame_id="1" name="美帆"
		   text="『あくっ‥‥んっ、んぁっ‥‥‥‥ダメっ‥‥ダメぇっ！！』" voices="miho10680"/>
		<msg @l="1285" char_id="-1" frame_id="-1" name=""
		   text="私はさらに胎内奥深くを掻き混ぜようとする彼の男根から逃げるように、ベッドの上へ上へと身体をずらしながら逃げようとした。"
		   voices=""/>
		<msg @l="1286" char_id="-1" frame_id="-1" name=""
		   text="けれど、教授はそうして逃げる私の腰をしっかりと固定して、逆にそれまで以上の強いストロークで、私の奥深くへと擦り上げていった。"
		   voices=""/>
		<msg @l="1287" char_id="-1" frame_id="-1" name=""
		   text="湧き出す蜜と破爪の血をかき出し、さらにいやらしい音が部屋中にこだまする。" voices=""/>
		<msg @l="1289" char_id="0" frame_id="1" name="美帆" text="『うあﾞっっ！！！』"
		   voices="miho10690"/>
		<msg @l="1291" char_id="0" frame_id="1" name="美帆"
		   text="『あﾞっ、あﾞっ、あﾞっ、あﾞっ、あﾞっ、あﾞあﾞっっ！！』" voices="miho10700"/>
		<msg @l="1293" char_id="-1" frame_id="-1" name=""
		   text="胎内で暴れまわっていた彼が、私の子宮口を突き上げるたび、目の前が真っ白になる。" voices=""/>
		<msg @l="1294" char_id="-1" frame_id="-1" name=""
		   text="痛みも、苦しみも‥‥いつのまにか麻痺したかのようにぼやけていて‥‥。" voices=""/>
		<msg @l="1295" char_id="-1" frame_id="-1" name=""
		   text="私はズンと突かれる度に溢れ出す熱い「何か」に翻弄されるまま、嗚咽とも喘ぎとも取れないような声を漏らして身体を揺らしていた。"
		   voices=""/>
		<msg @l="1297" char_id="0" frame_id="1" name="美帆"
		   text="『んんっ、あっ、あっ、あっ‥‥‥んっ、あぐっ！！』" voices="miho10710"/>
		<msg @l="1299" char_id="-1" frame_id="-1" name="朽木"
		   text="『どうだい、仲根クン‥‥私のモノをたっぷり味わい、良くなってきたようだね。』" voices=""/>
		<msg @l="1301" char_id="0" frame_id="1" name="美帆"
		   text="『うあﾞっ、んっ‥‥‥んっ、んっ、んっ、んんっ！！』" voices="miho10720"/>
		<msg @l="1303" char_id="-1" frame_id="-1" name="朽木"
		   text="『くっ‥‥よし、そろそろ出してやるからな。』" voices=""/>
		<msg @l="1305" char_id="-1" frame_id="-1" name=""
		   text="吠えるように言い放った教授の言葉を境に、秘所を蹂躙していた彼の肉棒がひときわ大きく硬くなった。" voices=""/>
		<msg @l="1309" async="true" char_id="-1" frame_id="-1" name="" text="どこに出す？"
		   voices=""/>
		<select @l="1310">
			<menu @l="1314" label="EventLabel_134" text="中に出す"/>
			<menu @l="1317" label="EventLabel_135" text="外に出す"/>
		</select>
		<label @l="1327" id="EventLabel_134"/>
		<msg @l="1330" char_id="-1" frame_id="-1" name="朽木"
		   text="『いくぞ、せっかくの貫通式だからな‥‥最後は膣中に出してやろう。』" voices=""/>
		<msg @l="1332" char_id="0" frame_id="1" name="美帆" text="『え‥‥！？』"
		   voices="miho10730"/>
		<msg @l="1334" char_id="-1" frame_id="-1" name=""
		   text="かすれた意識の中、不意に何かが私を覚醒させた。" voices=""/>
		<msg @l="1336" char_id="0" frame_id="1" name="美帆"
		   text="『いやっ‥‥ダメです、中には出さないでっ‥‥！！』" voices="miho10740"/>
		<msg @l="1338" char_id="-1" frame_id="-1" name="朽木"
		   text="『くくっ、もう遅い‥‥子宮から溢れるほどたっぷりと出してやるぞ。』" voices=""/>
		<msg @l="1340" char_id="0" frame_id="1" name="美帆" text="『いやっ、いやああああああああっ！！』"
		   voices="miho10750"/>
		<flash @l="1344" count="4" fade="100" image="white"/>
		<wait_chgmv/>
		<ev @l="1348" src="ev-046x1z1"/>
		<msg @l="1350" char_id="0" frame_id="1" name="美帆"
		   text="『あっ‥‥うあっ‥‥‥‥‥中に‥‥熱いのが‥‥‥‥。』" voices="miho10760"/>
		<msg @l="1352" char_id="-1" frame_id="-1" name=""
		   text="奥深くまで突き入れられていた肉の楔が大きく脈動したかと思うと、熱く煮えたぎった白濁液が勢いよくドクッドクッと大量に吐き出された。"
		   voices=""/>
		<msg @l="1354" char_id="-1" frame_id="-1" name="朽木"
		   text="『おおっ‥‥キミの膣内が射精に合わせて収縮しているぞ？』" voices=""/>
		<msg @l="1356" char_id="-1" frame_id="-1" name=""
		   text="教授は、私の膣内に放出した会心の射精に、満悦の笑みを浮かべていた。" voices=""/>
		<msg @l="1358" char_id="-1" frame_id="-1" name="朽木"
		   text="『これでは、私の方が搾り取られているみたいだな。』" voices=""/>
		<msg @l="1360" char_id="-1" frame_id="-1" name=""
		   text="いつまでも私の胎内で射精を続けながら、教授が歓喜の声を上げていた。" voices=""/>
		<msg @l="1361" char_id="-1" frame_id="-1" name=""
		   text="そうした彼の言葉がぼんやりとした意識をかすめていく中、私は膣内に溢れる熱い液体が、彼との結合部より逆流していく感触に深い絶望を感じていた。"
		   voices=""/>
		<goto @l="1364" label="EventLabel_136"/>
		<label @l="1368" id="EventLabel_135"/>
		<msg @l="1371" char_id="-1" frame_id="-1" name="朽木"
		   text="『キミも私とともに絶頂へ達したまえ。』" voices=""/>
		<msg @l="1373" char_id="-1" frame_id="-1" name=""
		   text="教授は深く突き入れた肉の楔を私から引き抜くと、淫欲な甘美に顔を歪めながら、長方形状のものを私の秘部にあてがう。" voices=""/>
		<msg @l="1374" char_id="-1" frame_id="-1" name=""
		   text="私はそのものにハッと恐怖を感じ、股間の方を凝視した。それは私を苦痛とともに気絶させたスタンガンだ。" voices=""/>
		<msg @l="1376" char_id="0" frame_id="1" name="美帆" text="『ひぃ――――。』"
		   voices="miho04860"/>
		<msg @l="1378" char_id="-1" frame_id="-1" name="" text="私は恐怖で顔が引き攣る。"
		   voices=""/>
		<msg @l="1380" char_id="-1" frame_id="-1" name="朽木" text="『さあ、イッてしまうんだ。』"
		   voices=""/>
		<se @l="1384" buf="1" src="ムチの音" volume="1."/>
		<flash @l="1388" count="4" fade="100" image="white"/>
		<msg @l="1390" char_id="0" frame_id="1" name="美帆" text="『い、ああああああああああっ！！！』"
		   voices="miho04870"/>
		<msg @l="1392" char_id="-1" frame_id="-1" name=""
		   text="私の身体の下肢は病的なほどの痙攣を起こし、ピーンと伸びきって硬直した。" voices=""/>
		<msg @l="1393" char_id="-1" frame_id="-1" name=""
		   text="脳天を突き破るような楔が打ちこめられ、頭の中は真っ白となる。" voices=""/>
		<se @l="1397" buf="1" src="おしっこ2" volume="1."/>
		<msg @l="1399" char_id="-1" frame_id="-1" name=""
		   text="下半身の力を全く感じなくなり、尿道からは淫靡な水音を放ちながら、小水が流れ出す。" voices=""/>
		<msg @l="1401" char_id="-1" frame_id="-1" name="朽木"
		   text="『ああ‥‥いい光景だ。このままキミの白い肌を汚してやろう。』" voices=""/>
		<msg @l="1403" char_id="-1" frame_id="-1" name=""
		   text="教授は恍惚な表情をして、そそり立つ肉棒の先端をお腹に向けて自分の手でしごきあげた。" voices=""/>
		<stopse @l="1407" buf="3"/>
		<msg @l="1409" char_id="-1" frame_id="-1" name="朽木" text="『いくぞっ！』" voices=""/>
		<flash @l="1413" count="4" fade="100" image="white"/>
		<wait_chgmv/>
		<ev @l="1417" src="ev-046x2z2"/>
		<msg @l="1419" char_id="0" frame_id="1" name="美帆" text="『んんっ‥‥。』"
		   voices="miho10770"/>
		<msg @l="1421" char_id="-1" frame_id="-1" name=""
		   text="肉槍の矛先から白濁色の液体が吐き出され、私の身体に降り注ぐ。" voices=""/>
		<msg @l="1423" char_id="-1" frame_id="-1" name="朽木"
		   text="『くくっ‥‥やはりキミは精液で汚されている姿が良く似合う。』" voices=""/>
		<msg @l="1425" char_id="-1" frame_id="-1" name=""
		   text="彼は煮えたぎった欲望のミルクを最後の一滴まで搾り出すと、満悦の笑みを浮かべた。" voices=""/>
		<msg @l="1427" char_id="0" frame_id="1" name="美帆" text="『せいえき‥‥‥これが‥‥‥‥。』"
		   voices="miho10780"/>
		<msg @l="1429" char_id="-1" frame_id="-1" name=""
		   text="私は荒い深呼吸を繰り返しながら、自分のほてった身体を汚した白濁色の液体を呆然と眺めた。" voices=""/>
		<msg @l="1430" char_id="-1" frame_id="-1" name=""
		   text="そしてただ‥‥深い悲しみの中、意識が遠のく‥‥。" voices=""/>
		<label @l="1434" id="EventLabel_136"/>
		<stopbgm @l="1438" fadeout="1000"/>
		<clear @l="1444" class="all"/>
		<end_scene @l="1447"/>
		<msgshow @l="1450" show="true"/>
		<wait_chgmv/>
		<bg @l="1454" src="bg01b"/>
		<bgm @l="1458" src="bgm03" volume="1."/>
		<msg @l="1460" char_id="0" frame_id="1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="1462" char_id="-1" frame_id="-1" name=""
		   text="朽木教授に蹂躙された後、私は呆然としながら床の上に倒れていた。" voices=""/>
		<msg @l="1463" char_id="-1" frame_id="-1" name=""
		   text="裸のままだったが、大切なものを失ってしまった絶望感で、それすら気にならなかった。" voices=""/>
		<char @l="1467" id="kutsu" pos="auto" src="kutsu010"/>
		<msg @l="1469" char_id="-1" frame_id="-1" name="朽木"
		   text="『ククク、さすが私が狙った躰だけのことはあった。』" voices=""/>
		<msg @l="1471" char_id="-1" frame_id="-1" name="朽木" text="『仲根クン、キミは最高だったよ。』"
		   voices=""/>
		<clear @l="1474" class="char"/>
		<char @l="1476" id="kutsu" pos="left" src="kutsu010"/>
		<char @l="1479" id="miho" pos="right" src="miho105"/>
		<msg @l="1481" char_id="0" frame_id="1" name="美帆"
		   text="『そんなこと言われても‥‥嬉しくなんかありません。』" voices=""/>
		<msg @l="1483" char_id="-1" frame_id="-1" name="朽木" text="『おや、それは心外だな。』"
		   voices=""/>
		<char @l="1486" id="kutsu" pos="left" src="kutsu018"/>
		<msg @l="1488" char_id="-1" frame_id="-1" name="朽木"
		   text="『キミも‥‥感じていたんじゃないか？』" voices=""/>
		<char @l="1492" id="miho" pos="right" src="miho104"/>
		<msg @l="1494" char_id="0" frame_id="1" name="美帆" text="『なっ‥‥！？』" voices=""/>
		<char @l="1497" id="miho" pos="right" src="miho105"/>
		<msg @l="1499" char_id="0" frame_id="1" name="美帆" text="『か、感じてなんか‥‥‥。』"
		   voices=""/>
		<msg @l="1501" char_id="0" frame_id="1" name="美帆"
		   text="『それより‥‥そんな風に落ち着いていてもいいんですか？』" voices=""/>
		<char @l="1504" id="kutsu" pos="left" src="kutsu010"/>
		<msg @l="1506" char_id="-1" frame_id="-1" name="朽木" text="『何故かね？』" voices=""/>
		<msg @l="1508" char_id="0" frame_id="1" name="美帆"
		   text="『このまま私が「犯された」といって警察に通報したら、教授は立派な犯罪者なんですよ。』" voices=""/>
		<char @l="1511" id="kutsu" pos="left" src="kutsu018"/>
		<msg @l="1513" char_id="-1" frame_id="-1" name="朽木" text="『何だ、そんなことか。』"
		   voices=""/>
		<char @l="1516" id="miho" pos="right" src="miho104"/>
		<msg @l="1518" char_id="0" frame_id="1" name="美帆" text="『そんなことかって‥‥。』"
		   voices=""/>
		<char @l="1521" id="kutsu" pos="left" src="kutsu010"/>
		<msg @l="1524" char_id="-1" frame_id="-1" name="朽木" text="『通報したければしたまえ。』"
		   voices=""/>
		<char @l="1528" id="miho" pos="right" src="miho105"/>
		<msg @l="1530" char_id="0" frame_id="1" name="美帆" text="『えっ！？』" voices=""/>
		<msg @l="1532" char_id="-1" frame_id="-1" name=""
		   text="私はカバンの中から携帯電話を取り出した。" voices=""/>
		<msg @l="1534" char_id="-1" frame_id="-1" name="朽木"
		   text="『君は知らないだろうが、この南総町で「痴漢」や「強姦」で警察に掛け合ったとしても、誰も聞いてくれはしないぞ。』" voices=""/>
		<char @l="1538" id="miho" pos="right" src="miho005"/>
		<msg @l="1540" char_id="0" frame_id="1" name="美帆"
		   text="『‥‥どうなっても、知りませんからねっ！？』" voices=""/>
		<msg @l="1542" char_id="-1" frame_id="-1" name=""
		   text="余りな朽木教授の態度に、私はカッとなって１１０番をコールする。" voices=""/>
		<msg @l="1543" char_id="-1" frame_id="-1" name=""
		   text="別に彼を犯罪者にしようというつもりはなかった。" voices=""/>
		<msg @l="1544" char_id="-1" frame_id="-1" name=""
		   text="ただ‥‥自分がどれほどの傷を相手に与えたのかを自覚して、それが仮に衝動的な過ちだというのであればせめて心から謝って欲しかったのだ。"
		   voices=""/>
		<msg @l="1545" char_id="-1" frame_id="-1" name="" text="それだけだったのに‥‥。"
		   voices=""/>
		<char @l="1549" id="miho" pos="right" src="miho105"/>
		<se @l="1553" buf="3" loop="true" src="発信音" volume="1."/>
		<msg @l="1555" char_id="-1" frame_id="-1" name="" text="トゥルルルル、トゥルルルル‥‥。"
		   voices=""/>
		<msg @l="1556" char_id="-1" frame_id="-1" name=""
		   text="一回、二回と呼び出し音が電話口から帰ってくる。" voices=""/>
		<msg @l="1558" char_id="0" frame_id="1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="1560" char_id="-1" frame_id="-1" name=""
		   text="私はそれを聞きながら‥‥それでも朽木教授が謝罪したらすぐに通話を切れるようにと、親指を通話切りボタンへとかけていた。"
		   voices=""/>
		<char @l="1563" id="kutsu" pos="left" src="kutsu018"/>
		<msg @l="1565" char_id="-1" frame_id="-1" name="朽木" text="『くくっ。』" voices=""/>
		<msg @l="1567" char_id="-1" frame_id="-1" name=""
		   text="けれど、私の思いとは裏腹に‥‥彼はただ口元に薄い笑みを貼り付けたまま、コールされている電話が繋がるのを黙って見ていた。"
		   voices=""/>
		<stopse @l="1571" buf="3"/>
		<msg @l="1573" char_id="-1" frame_id="-1" name="署員"
		   text="『はい、南総警察署です‥‥事故ですか？&#32;事件ですか？』" voices=""/>
		<msg @l="1575" char_id="0" frame_id="1" name="美帆" text="『あ、えっと‥‥‥‥事件です。』"
		   voices=""/>
		<msg @l="1577" char_id="-1" frame_id="-1" name="署員"
		   text="『落ち着いて、正確に現在の状況をお知らせください。』" voices=""/>
		<msg @l="1579" char_id="0" frame_id="1" name="美帆" text="『は、はい‥‥。』" voices=""/>
		<msg @l="1581" char_id="0" frame_id="1" name="美帆"
		   text="『わたし‥‥いま、ご、ごうかん‥‥‥‥レイプされました。』" voices=""/>
		<msg @l="1583" char_id="-1" frame_id="-1" name="署員"
		   text="『ん？おかしいですね。この町では婦女暴行の事件は今まで一件も起きていませんし、これからも起きないんですよ。』" voices=""/>
		<char @l="1587" id="miho" pos="right" src="miho104"/>
		<msg @l="1589" char_id="0" frame_id="1" name="美帆" text="『えっ！？どうしてですか？』"
		   voices=""/>
		<msg @l="1591" char_id="-1" frame_id="-1" name="署員"
		   text="『この町は「そういう風に作られているので」あなたの言うような事が起こるはずがありません。』" voices=""/>
		<msg @l="1593" char_id="-1" frame_id="-1" name="署員" text="『あなたの勘違いでしょう。』"
		   voices=""/>
		<char @l="1596" id="miho" pos="right" src="miho004"/>
		<msg @l="1598" char_id="0" frame_id="1" name="美帆" text="『そんなっ！！』" voices=""/>
		<msg @l="1600" char_id="-1" frame_id="-1" name=""
		   text="余りにもぞんざいな対応に、私はさらに喰って掛かろうとする。" voices=""/>
		<msg @l="1601" char_id="-1" frame_id="-1" name=""
		   text="しかし‥‥それは電話が一方的に切られるという形で終了した。" voices=""/>
		<se @l="1605" buf="1" src="携帯ボタン押下音" volume="1."/>
		<char @l="1608" id="miho" pos="right" src="miho105"/>
		<msg @l="1610" char_id="0" frame_id="1" name="美帆" text="『あっ‥‥。』" voices=""/>
		<msg @l="1612" char_id="-1" frame_id="-1" name="朽木"
		   text="『ククク、だから無駄だといったろう？&#32;これで理由がわかったかね？』" voices=""/>
		<char @l="1615" id="miho" pos="right" src="miho005"/>
		<msg @l="1617" char_id="0" frame_id="1" name="美帆" text="『こんなこと‥‥嘘ですっ！！』"
		   voices=""/>
		<char @l="1620" id="kutsu" pos="left" src="kutsu010"/>
		<msg @l="1622" char_id="-1" frame_id="-1" name="朽木"
		   text="『嘘ではないよ、紛れも無い現実だ。』" voices=""/>
		<msg @l="1624" char_id="-1" frame_id="-1" name="朽木"
		   text="『ただ‥‥この南総町だけで通用する、非常に狭い現実だがね。』" voices=""/>
		<char @l="1627" id="miho" pos="right" src="miho105"/>
		<msg @l="1629" char_id="0" frame_id="1" name="美帆" text="『‥‥一体、どういう意味なんですか？』"
		   voices=""/>
		<msg @l="1631" char_id="-1" frame_id="-1" name="朽木"
		   text="『そんなことを気にする暇があったら、自分のルームメイトの身でも案じていた方が良いと思うがね。』" voices=""/>
		<char @l="1634" id="miho" pos="right" src="miho104"/>
		<msg @l="1636" char_id="0" frame_id="1" name="美帆" text="『え‥‥？』" voices=""/>
		<msg @l="1638" char_id="-1" frame_id="-1" name="朽木"
		   text="『といっても‥‥もう、手遅れかもしれんがな。』" voices=""/>
		<msg @l="1640" char_id="-1" frame_id="-1" name=""
		   text="独り言のように呟き、朽木教授は腕時計を見る。" voices=""/>
		<msg @l="1641" char_id="-1" frame_id="-1" name=""
		   text="私も携帯電話の時計に視線をやると‥‥既に２３時近かった。" voices=""/>
		<char @l="1644" id="miho" pos="right" src="miho105"/>
		<msg @l="1646" char_id="0" frame_id="1" name="美帆"
		   text="『手遅れって‥‥‥玲さんに、彼女に何をしたんですか！？』" voices=""/>
		<char @l="1649" id="kutsu" pos="left" src="kutsu018"/>
		<msg @l="1651" char_id="-1" frame_id="-1" name="朽木" text="『私は何もしていないよ。』"
		   voices=""/>
		<msg @l="1653" char_id="0" frame_id="1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="1655" char_id="-1" frame_id="-1" name="朽木"
		   text="『第一、私はこうしてキミと一緒にいたのだよ？』" voices=""/>
		<msg @l="1657" char_id="-1" frame_id="-1" name="朽木"
		   text="『その私が彼女に何が出来るというんだね。』" voices=""/>
		<msg @l="1659" char_id="0" frame_id="1" name="美帆" text="『それは‥‥。』" voices=""/>
		<char @l="1662" id="kutsu" pos="left" src="kutsu010"/>
		<msg @l="1664" char_id="-1" frame_id="-1" name="朽木"
		   text="『さあ、わかったのなら今日のことは忘れて寝てしまうことだ。』" voices=""/>
		<msg @l="1666" char_id="-1" frame_id="-1" name="朽木"
		   text="『もっとも‥‥私は今日のことを忘れはしないがね。ククク、また君の身体を抱きたくなったら来させてもらうよ。』" voices=""/>
		<clear @l="1670" layer="kutsu"/>
		<msg @l="1672" char_id="-1" frame_id="-1" name=""
		   text="いやらしい表情を浮かべると、教授は私の部屋から出て行こうとする。" voices=""/>
		<msg @l="1674" char_id="0" frame_id="1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="1678" async="true" char_id="-1" frame_id="-1" name=""
		   text="立ち去ろうとする朽木を‥‥？" voices=""/>
		<select @l="1679">
			<menu @l="1683" label="EventLabel_137" text="引き止める"/>
			<menu @l="1686" label="EventLabel_141" text="引き止めない"/>
		</select>
		<label @l="1695" id="EventLabel_137"/>
		<char @l="1699" id="miho" pos="right" src="miho005"/>
		<msg @l="1701" char_id="0" frame_id="1" name="美帆" text="『待ってくださいっ！！』"
		   voices=""/>
		<char @l="1705" id="kutsu" pos="left" src="kutsu010"/>
		<msg @l="1707" char_id="-1" frame_id="-1" name="朽木" text="『‥‥‥‥。』" voices=""/>
		<msg @l="1709" char_id="-1" frame_id="-1" name=""
		   text="制止の言葉に、朽木教授は足を止めて振り返った。" voices=""/>
		<msg @l="1711" char_id="0" frame_id="1" name="美帆"
		   text="『町のことはもう聞きません‥‥でも、せめて玲さんのことだけは教えてもらえませんか。』" voices=""/>
		<msg @l="1713" char_id="-1" frame_id="-1" name="朽木"
		   text="『キミが知ってどうなるものでもあるまい。』" voices=""/>
		<msg @l="1715" char_id="0" frame_id="1" name="美帆"
		   text="『もう手遅れかもしれないなんて‥‥そんなこと聞いて、黙って知らないふりはできません。』" voices=""/>
		<char @l="1719" id="miho" pos="right" src="miho105"/>
		<msg @l="1721" char_id="0" frame_id="1" name="美帆"
		   text="『出来ることなら、私は玲さんの力になりたい‥‥。』" voices=""/>
		<msg @l="1723" char_id="-1" frame_id="-1" name="朽木" text="『ククク、無理だな。』"
		   voices=""/>
		<msg @l="1725" char_id="0" frame_id="1" name="美帆" text="『そう‥‥かもしれません。』"
		   voices=""/>
		<msg @l="1727" char_id="0" frame_id="1" name="美帆"
		   text="『でも、それでも私は玲さんの力になりたいんです。』" voices=""/>
		<msg @l="1729" char_id="-1" frame_id="-1" name="朽木" text="『‥‥‥‥。』" voices=""/>
		<char @l="1733" id="miho" pos="right" src="miho005"/>
		<msg @l="1735" char_id="0" frame_id="1" name="美帆"
		   text="『教授‥‥教えてください、玲さんは今何処にいるんですか！？』" voices=""/>
		<char @l="1738" id="kutsu" pos="left" src="kutsu018"/>
		<msg @l="1740" char_id="-1" frame_id="-1" name="朽木"
		   text="『･･････出来れば大黒にばかり美味しいところを持っていかれたくはないのだが･･････今回はアイツの手引きで上手くいったわけだし、処女も頂けたし････まぁ、良しとするか。』"
		   voices=""/>
		<char @l="1744" id="miho" pos="right" src="miho105"/>
		<msg @l="1746" char_id="0" frame_id="1" name="美帆" text="『それって‥‥どういう意味ですか？』"
		   voices=""/>
		<msg @l="1748" char_id="-1" frame_id="-1" name="朽木" text="『いや、こちらの話だ‥‥。』"
		   voices=""/>
		<msg @l="1750" char_id="-1" frame_id="-1" name=""
		   text="教授は何処かつまらなそうな表情を浮かべて、私を見た。" voices=""/>
		<msg @l="1752" char_id="-1" frame_id="-1" name="朽木"
		   text="『よかろう、キミがそこまで言うのなら教えよう‥‥。』" voices=""/>
		<char @l="1755" id="kutsu" pos="left" src="kutsu010"/>
		<msg @l="1757" char_id="-1" frame_id="-1" name="朽木"
		   text="『彼女なら今ごろ、駅前にある大黒建設のオフィスで実地研修を受けさせられている頃だろう。』" voices=""/>
		<char @l="1760" id="miho" pos="right" src="miho104"/>
		<msg @l="1762" char_id="0" frame_id="1" name="美帆"
		   text="『実地研修って‥‥こんな時間までですか！？』" voices=""/>
		<msg @l="1764" char_id="-1" frame_id="-1" name="朽木"
		   text="『あの会社に時間は関係ない‥‥いや、正確に言うならあの会社には夜に仕事が多い清掃部署が存在していてね。』" voices=""/>
		<msg @l="1766" char_id="-1" frame_id="-1" name="朽木"
		   text="『彼女は今頃、その部署へ配属される為の研修を受けさせられているハズだよ。』" voices=""/>
		<char @l="1769" id="miho" pos="right" src="miho105"/>
		<msg @l="1771" char_id="0" frame_id="1" name="美帆"
		   text="『清掃の部署‥‥社内の掃除係ということですか？』" voices=""/>
		<char @l="1774" id="kutsu" pos="left" src="kutsu018"/>
		<msg @l="1776" char_id="-1" frame_id="-1" name="朽木"
		   text="『ククッ、キミは何処までもおめでたいな。』" voices=""/>
		<char @l="1780" id="miho" pos="right" src="miho004"/>
		<msg @l="1782" char_id="0" frame_id="1" name="美帆" text="『え‥‥違うんですか？』"
		   voices=""/>
		<msg @l="1784" char_id="-1" frame_id="-1" name="朽木"
		   text="『掃除係というのは確かにあっているが、キミの思い描いているものとは内容が違うのだよ。』" voices=""/>
		<char @l="1787" id="miho" pos="right" src="miho005"/>
		<msg @l="1789" char_id="0" frame_id="1" name="美帆" text="『‥‥？』" voices=""/>
		<msg @l="1791" char_id="-1" frame_id="-1" name="朽木" text="『男性社員の性欲処理係だよ。』"
		   voices=""/>
		<char @l="1794" id="miho" pos="right" src="miho104"/>
		<msg @l="1796" char_id="0" frame_id="1" name="美帆"
		   text="『性欲処理って‥‥‥え？あの‥‥‥エッチなことをする？』" voices=""/>
		<char @l="1799" id="kutsu" pos="left" src="kutsu010"/>
		<msg @l="1801" char_id="-1" frame_id="-1" name="朽木"
		   text="『そうだ。大黒建設は男性社員のストレスを発散させ、仕事の能力を上げる為に性欲処理部を設けてあるのだよ。』" voices=""/>
		<msg @l="1803" char_id="0" frame_id="1" name="美帆"
		   text="『え？まさか、会社内にそんな部署が‥‥。』" voices=""/>
		<msg @l="1805" char_id="-1" frame_id="-1" name="朽木"
		   text="『あるんだよ。あの大黒建設にはね。』" voices=""/>
		<char @l="1809" id="miho" pos="right" src="miho005"/>
		<msg @l="1811" char_id="0" frame_id="1" name="美帆" text="『それじゃあ玲さんは‥‥。』"
		   voices=""/>
		<msg @l="1813" char_id="-1" frame_id="-1" name="朽木"
		   text="『清掃部に入る為のテストを受けている真っ最中、というわけだ。』" voices=""/>
		<char @l="1817" id="miho" pos="right" src="miho105"/>
		<msg @l="1819" char_id="0" frame_id="1" name="美帆"
		   text="『ひどい‥‥どうしてそんなことに‥‥‥。』" voices=""/>
		<msg @l="1821" char_id="-1" frame_id="-1" name="朽木"
		   text="『ククク、さてね。まぁ彼女に取っては何故、入社するかというよりも、既に入社するという事しか考えられなくなっているのではないのかな？』"
		   voices=""/>
		<msg @l="1823" char_id="0" frame_id="1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<char @l="1826" id="kutsu" pos="left" src="kutsu018"/>
		<msg @l="1828" char_id="-1" frame_id="-1" name="朽木"
		   text="『とにかく私は確かにキミの質問に答えた。これで満足かね？』" voices=""/>
		<msg @l="1830" char_id="-1" frame_id="-1" name=""
		   text="私が朽木教授の言葉に何も言えないでいると、彼は一方的に話をやめ、部屋から出ていった。" voices=""/>
		<clear @l="1834" class="char"/>
		<stopbgm @l="1838" fadeout="1000"/>
		<clear @l="1844" class="all"/>
		<msgshow @l="1846" show="true"/>
		<wait_chgmv/>
		<bg @l="1850" src="bg17"/>
		<bgm @l="1854" src="bgm09" volume="1."/>
		<char @l="1858" id="ookur" pos="left" src="ookuro010"/>
		<char @l="1861" id="rei" pos="right" src="rei010"/>
		<msg @l="1863" char_id="-1" frame_id="-1" name="" text="―――数時間前。" voices=""/>
		<msg @l="1864" char_id="-1" frame_id="-1" name=""
		   text="階違いにあるオフィスの入り口で、玲を引き連れた大黒が立ち止まる。" voices=""/>
		<msg @l="1865" char_id="-1" frame_id="-1" name=""
		   text="そこは表向き「人材派遣部」と呼ばれている部署である。" voices=""/>
		<msg @l="1866" char_id="-1" frame_id="-1" name="" text="この部署の主だった業務は―――。"
		   voices=""/>
		<msg @l="1867" char_id="-1" frame_id="-1" name=""
		   text="第一に社内掃除係として、男性社員の慰みものになること。" voices=""/>
		<msg @l="1868" char_id="-1" frame_id="-1" name=""
		   text="第二に企業間接待係として、身体を使い営業すること。" voices=""/>
		<msg @l="1869" char_id="-1" frame_id="-1" name=""
		   text="第三に町の女達を慰みものにする為のプロジェクトに手を貸すことだった。" voices=""/>
		<msg @l="1871" char_id="-1" frame_id="-1" name=""
		   text="無論‥‥ここがそのような場所であることは、玲には伝えられていない。" voices=""/>
		<msg @l="1873" char_id="1" frame_id="-1" name="玲" text="『こちらで適性検査をなさるんですか？』"
		   voices=""/>
		<msg @l="1875" char_id="-1" frame_id="-1" name="大黒"
		   text="『そうです。いま担当の者を呼びますので少々お待ちください。』" voices=""/>
		<clear @l="1879" layer="ookur"/>
		<msg @l="1881" char_id="-1" frame_id="-1" name=""
		   text="大黒はオフィス中程にある席に近寄ると、パソコンのモニターを仏頂面で眺めていた男性社員の肩を叩いてから声をかけた。" voices=""/>
		<msg @l="1882" char_id="-1" frame_id="-1" name=""
		   text="仏頂面をした男子社員はしばらく大黒の話を黙って聞いた後、不意に顔をあげて遠巻きに玲を眺めてから頷いた。" voices=""/>
		<msg @l="1883" char_id="-1" frame_id="-1" name=""
		   text="恐らく自分のことを紹介しているのだろう‥‥と、玲は思う。" voices=""/>
		<char @l="1887" id="ookur" pos="left" src="ookuro010"/>
		<msg @l="1889" char_id="-1" frame_id="-1" name="大黒" text="『失礼、お待たせしました。』"
		   voices=""/>
		<msg @l="1891" char_id="-1" frame_id="-1" name="大黒"
		   text="『こちらが、今から白石さんの適性検査を行う真島（まじま）くんです。』" voices=""/>
		<msg @l="1893" char_id="1" frame_id="-1" name="玲" text="『はじめまして、白石玲といいます。』"
		   voices=""/>
		<msg @l="1895" char_id="-1" frame_id="-1" name="真島" text="『どうも‥‥。』"
		   voices=""/>
		<msg @l="1897" char_id="-1" frame_id="-1" name=""
		   text="真島、と紹介された彼は、私の言葉に首を竦めながら短く答える。" voices=""/>
		<msg @l="1898" char_id="-1" frame_id="-1" name=""
		   text="やる気が無いのかそれともこれが彼の基本動作なのか、判断し難い。" voices=""/>
		<msg @l="1900" char_id="-1" frame_id="-1" name="大黒"
		   text="『それじゃ、いつものように頼むよ？』" voices=""/>
		<msg @l="1902" char_id="-1" frame_id="-1" name="真島" text="『うい。』" voices=""/>
		<msg @l="1904" char_id="-1" frame_id="-1" name=""
		   text="自分の雇い主である大黒にさえ、ぞんざいな返事を返すと、真島はオフィスの方を振り返って顎先を動かした。" voices=""/>
		<msg @l="1905" char_id="-1" frame_id="-1" name=""
		   text="すると、静かに座っていた社員のうち二人が無言のまま立ち上がってこちらへと小走りに駆け寄ってくる。" voices=""/>
		<msg @l="1907" char_id="-1" frame_id="-1" name="真島"
		   text="『オマエら、暴れないように押さえとけ。』" voices=""/>
		<msg @l="1909" char_id="-1" frame_id="-1" name="男子社員Ａ" text="『はい。』"
		   voices=""/>
		<msg @l="1911" char_id="-1" frame_id="-1" name="男子社員Ｂ" text="『わかりました。』"
		   voices=""/>
		<msg @l="1913" char_id="-1" frame_id="-1" name=""
		   text="二人の男子社員は真島の指示に頷くと、玲の左右に立って肩を掴む。" voices=""/>
		<char @l="1917" id="rei" pos="right" src="rei014"/>
		<msg @l="1919" char_id="1" frame_id="-1" name="玲" text="『え‥‥な、なんですか？』"
		   voices=""/>
		<msg @l="1921" char_id="-1" frame_id="-1" name="大黒" text="『ああ、心配しないでください。』"
		   voices=""/>
		<msg @l="1923" char_id="-1" frame_id="-1" name="大黒"
		   text="『こちらの指示通りにしてくだされば、彼らはアナタに危害を加えたりはしませんから。』" voices=""/>
		<clear @l="1927" class="char"/>
		<char @l="1929" id="rei" pos="auto" src="rei128"/>
		<msg @l="1931" char_id="1" frame_id="-1" name="玲" text="『はあ‥‥。』" voices=""/>
		<msg @l="1933" char_id="-1" frame_id="-1" name=""
		   text="危害を加える、という言葉の意味がわからなくて玲は間の抜けた声を出す。" voices=""/>
		<msg @l="1934" char_id="-1" frame_id="-1" name=""
		   text="ようするに大黒の言葉には「指示に従わなければ危害を加える」という意図が含まれていたのだが、玲はそれに気付いていない。"
		   voices=""/>
		<msg @l="1936" char_id="-1" frame_id="-1" name="真島"
		   text="『アンタ‥‥白石さんだっけか、まず一つ目の検査からだ。』" voices=""/>
		<char @l="1939" id="rei" pos="auto" src="rei010"/>
		<msg @l="1941" char_id="1" frame_id="-1" name="玲"
		   text="『あ、はい‥‥何をすればいいんでしょうか？』" voices=""/>
		<msg @l="1943" char_id="-1" frame_id="-1" name="真島" text="『俺のチ○ポをしゃぶってくれ。』"
		   voices=""/>
		<stopbgm @l="1947" fadeout="1000"/>
		<msg @l="1949" char_id="1" frame_id="-1" name="玲" text="『‥‥‥‥。』" voices=""/>
		<msg @l="1951" char_id="-1" frame_id="-1" name="" text="一瞬‥‥玲の中で時間が止まった。"
		   voices=""/>
		<msg @l="1952" char_id="-1" frame_id="-1" name=""
		   text="先の大黒の言葉の時にも増して、それの意味が解らない‥‥という表情だ。" voices=""/>
		<msg @l="1954" char_id="-1" frame_id="-1" name="真島"
		   text="『聞こえなかったのか？&#32;フェラチオしろって言ってるんだよ。』" voices=""/>
		<bgm @l="1958" src="bgm17" volume="1."/>
		<char @l="1960" id="rei" pos="auto" src="rei014"/>
		<msg @l="1962" char_id="-1" frame_id="-1" name=""
		   text="真島は苛立たしげに眉をひそめると、玲の肩に手をかけて力任せに彼女を床へ座らせた。" voices=""/>
		<msg @l="1963" char_id="-1" frame_id="-1" name=""
		   text="玲の目の前にはちょうど真島の股間が位置するような形になり、それを見計らったかのように彼はチャックを下ろしてイチモツを彼女の眼前に晒した。"
		   voices=""/>
		<char @l="1967" id="rei" pos="auto" src="rei017"/>
		<msg @l="1969" char_id="1" frame_id="-1" name="玲"
		   text="『いやっ‥‥な、なにをするんですかっ！』" voices=""/>
		<msg @l="1971" char_id="-1" frame_id="-1" name="真島"
		   text="『馬鹿かオマエは？&#32;フェラチオしろって言っただろ。』" voices=""/>
		<msg @l="1973" char_id="1" frame_id="-1" name="玲"
		   text="『だから、どうして私がそんなことをしなければならないんですか！？』" voices=""/>
		<msg @l="1975" char_id="-1" frame_id="-1" name="真島"
		   text="『オマエやっぱり馬鹿だろ。それが検査だからに決まってるじゃないか。』" voices=""/>
		<msg @l="1977" char_id="1" frame_id="-1" name="玲"
		   text="『人のことを気軽に馬鹿なんて言わないでください！』" voices=""/>
		<msg @l="1979" char_id="1" frame_id="-1" name="玲"
		   text="『それに、そんな事が適性検査なハズが‥‥。』" voices=""/>
		<msg @l="1981" char_id="-1" frame_id="-1" name="大黒" text="『あるんですよ。』"
		   voices=""/>
		<msg @l="1983" char_id="-1" frame_id="-1" name=""
		   text="玲がすべてを言うより早く、大黒が満面の笑みのまま答えた。" voices=""/>
		<msg @l="1985" char_id="-1" frame_id="-1" name="大黒"
		   text="『彼の言っていることは冗談ではなく事実です。入社内定のためにどうしても必要な検査ですから従ってください。』" voices=""/>
		<char @l="1988" id="rei" pos="auto" src="rei015"/>
		<msg @l="1990" char_id="1" frame_id="-1" name="玲"
		   text="『そんな‥‥幾らなんでも従えませんっ。』" voices=""/>
		<msg @l="1992" char_id="-1" frame_id="-1" name="大黒"
		   text="『おや、どんなことでも精一杯取り組むのではなかったのですか？』" voices=""/>
		<msg @l="1994" char_id="1" frame_id="-1" name="玲"
		   text="『内容によります。それにこんな検査どうして必要なの‥‥。』" voices=""/>
		<msg @l="1996" char_id="-1" frame_id="-1" name="" text="玲の言葉を遮るように大黒の言葉が続く。"
		   voices=""/>
		<msg @l="1998" char_id="-1" frame_id="-1" name="大黒"
		   text="『適性検査を拒否するとは困ったものですね。あなたの通う大学は優秀だからこそ、今回の制度で優先して仮入社させているのに残念なことです。』"
		   voices=""/>
		<msg @l="2000" char_id="-1" frame_id="-1" name="大黒"
		   text="『こうなりますと、すでに内定している稲庭くんも考慮する必要がありますね。』" voices=""/>
		<char @l="2003" id="rei" pos="auto" src="rei014"/>
		<msg @l="2005" char_id="1" frame_id="-1" name="玲" text="『！！』" voices=""/>
		<char @l="2008" id="rei" pos="auto" src="rei015"/>
		<msg @l="2010" char_id="1" frame_id="-1" name="玲" text="『い・稲庭さんには関係ない‥‥。』"
		   voices=""/>
		<msg @l="2012" char_id="-1" frame_id="-1" name="真島"
		   text="『いちいちうるせーんだよ、メス豚。』" voices=""/>
		<msg @l="2014" char_id="-1" frame_id="-1" name="真島"
		   text="『オマエは黙って飼い主のチ○ポをしゃぶってりゃいいんだよ。』" voices=""/>
		<label @l="2017" id="event_scene07"/>
		<goto @l="2019" cond="!(f.flagInExtraMode&#32;&gt;&#32;100)&#13;&#10;"
		   label="TempLabel_238"/>
		<bgm @l="2021" src="bgm17" volume="1."/>
		<label @l="2022" id="TempLabel_238"/>
		<label @l="2026" id="chart_line30"/>
		<wait_chgmv/>
		<ev @l="2030" src="ev-007bx1"/>
		<description @l="2033" text="二次面接Ａ"/>
		<msg @l="2035" char_id="1" frame_id="-1" name="玲" text="『んんぅっっ！？』"
		   voices="rei01590"/>
		<msg @l="2037" char_id="-1" frame_id="-1" name=""
		   text="反論をしようとしていた玲の口に、真島の太い男根が押し込まれた。" voices=""/>
		<msg @l="2038" char_id="-1" frame_id="-1" name=""
		   text="まだ殆ど硬度を得ていなかった彼の肉棒は、玲が苦悶の声を上げて目尻に涙を浮かばせ拒絶の為に舌を動かしてしまうたびに、口の中で硬く太くなっていく。"
		   voices=""/>
		<msg @l="2040" char_id="-1" frame_id="-1" name="大黒"
		   text="『彼は相手を心身共にいたぶるサディスティックなプレイをすることが大好きでね。』" voices=""/>
		<msg @l="2042" char_id="-1" frame_id="-1" name="大黒"
		   text="『最近の女の子達はすぐにわめくので、この部署に配属させる為には彼くらいの屈伏させるプレイが丁度良いのですよ。ただあまりにも逆らうと怖いですよ？』"
		   voices=""/>
		<msg @l="2044" char_id="1" frame_id="-1" name="玲" text="『‥‥‥‥。』"
		   voices="rei01600"/>
		<msg @l="2046" char_id="-1" frame_id="-1" name=""
		   text="大黒の言葉に、玲の表情が明らかに曇った。" voices=""/>
		<msg @l="2047" char_id="-1" frame_id="-1" name=""
		   text="もちろん大黒の言うそれが本当か嘘かはわからない。" voices=""/>
		<msg @l="2048" char_id="-1" frame_id="-1" name=""
		   text="とはいえ‥‥玲は真島の態度にそれが嘘でないことを感じとっていた。" voices=""/>
		<msg @l="2050" char_id="-1" frame_id="-1" name="真島"
		   text="『大黒さんからの忠告を無駄にすんなよ？&#32;メス豚。』" voices=""/>
		<msg @l="2052" char_id="-1" frame_id="-1" name=""
		   text="真島は相変わらずやる気の無い表情で言うと、玲の頭を押さえつけてグイグイと腰を押し付けた。" voices=""/>
		<msg @l="2053" char_id="-1" frame_id="-1" name=""
		   text="当然、押し付けられた分だけ玲の口腔内に突き入れられている肉柱が収まるべき場所を探して喉奥へともぐりこんでいくことになる。"
		   voices=""/>
		<msg @l="2055" char_id="1" frame_id="-1" name="玲" text="『んっ、んんっ！！』"
		   voices="rei01610"/>
		<msg @l="2057" char_id="-1" frame_id="-1" name=""
		   text="喉の奥に真島の太いものが詰まり声を出して玲がもがく。" voices=""/>
		<msg @l="2059" char_id="-1" frame_id="-1" name="真島"
		   text="『アホみたいに唸ってんじゃねーよ、豚。』" voices=""/>
		<msg @l="2061" char_id="-1" frame_id="-1" name="真島"
		   text="『俺はしゃぶれって言ったんだよ、もう忘れたのかっ！？』" voices=""/>
		<msg @l="2063" char_id="1" frame_id="-1" name="玲" text="『んん―――――ッ！！』"
		   voices="rei01620"/>
		<wait_chgmv/>
		<bg @l="2067" src="bg17am1"/>
		<msg @l="2069" char_id="1" frame_id="-1" name="玲" text="『ゲホッ‥‥ごほ、ごほっ‥‥‥‥！！』"
		   voices="rei01630"/>
		<msg @l="2071" char_id="-1" frame_id="-1" name=""
		   text="真島がどなったと同時に腰を深く押し込んだ瞬間、肉槍の矛先が喉奥を激しく突き上げて玲が咳き込む。" voices=""/>
		<msg @l="2073" char_id="-1" frame_id="-1" name="真島"
		   text="『おい、なに勝手に吐き出してんだよっ！！』" voices=""/>
		<msg @l="2075" char_id="1" frame_id="-1" name="玲"
		   text="『ゴホッゴホッ‥‥ば、馬鹿言わないで‥‥‥。』" voices="rei01640"/>
		<msg @l="2077" char_id="1" frame_id="-1" name="玲"
		   text="『アナタが‥‥んっ、無理やり腰を押し付けたりするからでしょっ！』" voices="rei01650"/>
		<msg @l="2079" char_id="-1" frame_id="-1" name="真島"
		   text="『無理やりされたくなきゃ、言われた通りちゃんとしゃぶれ。』" voices=""/>
		<msg @l="2081" char_id="-1" frame_id="-1" name="真島"
		   text="『それが出来なきゃ、吐こうが窒息しようがオマエの喉が破れるまで突き上げてやるぞ。』" voices=""/>
		<msg @l="2083" char_id="1" frame_id="-1" name="玲" text="『‥‥‥‥。』"
		   voices="rei01660"/>
		<msg @l="2085" char_id="-1" frame_id="-1" name="大黒"
		   text="『だから言ったでしょう？&#32;彼に逆らうと本当に怖いんですよ。』" voices=""/>
		<msg @l="2087" char_id="-1" frame_id="-1" name=""
		   text="玲の恐怖を煽るように大黒がその耳元へ囁いた。" voices=""/>
		<msg @l="2088" char_id="-1" frame_id="-1" name=""
		   text="もちろん、その表情はいつも通りの笑顔である。" voices=""/>
		<msg @l="2090" char_id="-1" frame_id="-1" name="真島"
		   text="『俺は寛大だからな、もう一度だけチャンスをやる。』" voices=""/>
		<msg @l="2092" char_id="-1" frame_id="-1" name="真島"
		   text="『もしそれで命令通りにしゃぶれなかったら‥‥わかってるな？』" voices=""/>
		<msg @l="2094" char_id="1" frame_id="-1" name="玲" text="『‥‥‥‥。』"
		   voices="rei01670"/>
		<msg @l="2096" char_id="-1" frame_id="-1" name=""
		   text="真島の脅迫めいた言葉に‥‥玲は小さく震えた。" voices=""/>
		<msg @l="2097" char_id="-1" frame_id="-1" name=""
		   text="ここで変に逆らっても何一つ良いことがないことくらい、これまでのやり取りで十分に分かっていた。" voices=""/>
		<msg @l="2098" char_id="-1" frame_id="-1" name=""
		   text="ましてや、自分の責任で稲庭の内定が取り消されるようなことになれば‥‥。今は耐えるしかないと決心した。" voices=""/>
		<wait_chgmv/>
		<ev @l="2102" src="ev-007ax1"/>
		<msg @l="2104" char_id="-1" frame_id="-1" name="真島" text="『まずは先っぽを舌でしゃぶれ。』"
		   voices=""/>
		<msg @l="2106" char_id="1" frame_id="-1" name="玲"
		   text="『は、はい‥‥んっ‥‥‥れろ‥‥れろ‥‥‥‥。』" voices="rei01680"/>
		<msg @l="2108" char_id="-1" frame_id="-1" name=""
		   text="素直に‥‥というには少々ぎこちない感じで、玲はピンクの舌をチロッと出して真島の征服欲を満たそうとする砲身の先端をペロペロと舐め始めた。"
		   voices=""/>
		<msg @l="2109" char_id="-1" frame_id="-1" name=""
		   text="玲は処女でこそないものの、けっして性経験が豊富なわけではない。特に、男に奉仕するという行為に対してはまだまだ未熟であった。"
		   voices=""/>
		<msg @l="2111" char_id="-1" frame_id="-1" name=""
		   text="もちろん雑誌やらなにやらでフェラチオという行為は知っていたし、興味本位でアダルトビデオを見たこともあるから大体どういうことをすればいいのかも何となくならわかる。"
		   voices=""/>
		<msg @l="2112" char_id="-1" frame_id="-1" name="" text="けれど、それだけだ。"
		   voices=""/>
		<msg @l="2114" char_id="1" frame_id="-1" name="玲"
		   text="『んっ、れろ、れろ‥‥‥んぅっ‥‥‥‥はふっ、んっ‥‥‥‥。』" voices="rei01690"/>
		<msg @l="2116" char_id="-1" frame_id="-1" name="真島"
		   text="『ただ舐めてりゃいいってもんじゃねーんだよ。』" voices=""/>
		<msg @l="2118" char_id="-1" frame_id="-1" name="真島"
		   text="『オレのチ○ポをベトベトにするまで、しっかり唾液でまぶして、ぴちゃぴちゃ音を立てながら聴覚で相手を興奮させんだよ‥‥そんなこともわからないのかオメーは。』"
		   voices=""/>
		<msg @l="2120" char_id="1" frame_id="-1" name="玲" text="『くっ‥‥。』"
		   voices="rei01700"/>
		<msg @l="2122" char_id="-1" frame_id="-1" name=""
		   text="玲は一瞬悔しげな表情を浮かべるが、真島の冷たい視線に一抹の恐怖を覚えてすぐに言われた通りのことをした。" voices=""/>
		<msg @l="2124" char_id="1" frame_id="-1" name="玲"
		   text="『ん‥‥んふ‥‥‥ちゅろ、ちゅろ‥‥‥。』" voices="rei01710"/>
		<msg @l="2126" char_id="-1" frame_id="-1" name=""
		   text="口内に唾液を溜めて、それを舌に絡めてから亀頭の先端を舐める。" voices=""/>
		<msg @l="2127" char_id="-1" frame_id="-1" name=""
		   text="塗りつけるように肉幹を唾液で濡らした後、それを押し広げるように舌を這わせていく。" voices=""/>
		<msg @l="2128" char_id="-1" frame_id="-1" name=""
		   text="真島のソレはしゃぶられる快楽に太いミミズのような血管を浮かべるほど怒張し、ベトベトに濡れテカテカと卑猥にてらついていた。"
		   voices=""/>
		<msg @l="2130" char_id="-1" frame_id="-1" name="真島"
		   text="『よし、次はカリの裏側を嘗め回せ。』" voices=""/>
		<msg @l="2132" char_id="1" frame_id="-1" name="玲"
		   text="『んっ、れろ、れろ‥‥‥んぅっ‥‥‥‥はふっ、んっ‥‥‥‥。』" voices="rei01690"/>
		<msg @l="2134" char_id="-1" frame_id="-1" name=""
		   text="玲は真島の下品で醜悪な肉棒に嫌悪感を持ちつつ、舌を這わせる。" voices=""/>
		<msg @l="2136" char_id="-1" frame_id="-1" name="真島"
		   text="『バカヤロウ！舌先を使ってレロレロと舐めるんだよ！』" voices=""/>
		<msg @l="2138" char_id="-1" frame_id="-1" name=""
		   text="真島は勃起した己の分身でビンタをするように玲の頬をペチペチと叩く。" voices=""/>
		<msg @l="2140" char_id="1" frame_id="-1" name="玲" text="『くっ‥‥。』"
		   voices="rei01700"/>
		<msg @l="2142" char_id="-1" frame_id="-1" name=""
		   text="この屈辱に、玲はこみあげてくるものを耐えながら、カリの裏側へ重点的に舌を動かした。" voices=""/>
		<msg @l="2144" char_id="-1" frame_id="-1" name="真島"
		   text="『チ○ポに唾液をまぶし終わったら、次は袋だ。』" voices=""/>
		<msg @l="2146" char_id="1" frame_id="-1" name="玲" text="『‥‥ふぁい。』"
		   voices="rei01720"/>
		<msg @l="2148" char_id="1" frame_id="-1" name="玲"
		   text="『ん、あふっ‥‥んっ‥‥‥んむっ‥‥ちゅろ‥‥ぴちゃ、ぴちゃ。』" voices="rei01730"/>
		<msg @l="2150" char_id="-1" frame_id="-1" name=""
		   text="玲は言われるままに卑猥な長針の下に、振り子のように揺れながらぶら下がっている陰嚢へと唇を寄せると、先ほどと同じように唾液を塗した舌先でそれらを舐め上げる。"
		   voices=""/>
		<msg @l="2151" char_id="-1" frame_id="-1" name=""
		   text="もちろんそんな場所を舐めるのは初めてのことで、玲は陰嚢の冷んやりとした感触と不快な構造に気持ち悪く感じながらも何とかそれをしゃぶっていた。"
		   voices=""/>
		<msg @l="2152" char_id="-1" frame_id="-1" name=""
		   text="何ともいえない性臭が玲の鼻腔を刺激した。" voices=""/>
		<msg @l="2154" char_id="-1" frame_id="-1" name="真島"
		   text="『よし、次は俺が良いっつーまで好きにしゃぶれ。』" voices=""/>
		<msg @l="2156" char_id="-1" frame_id="-1" name="真島"
		   text="『袋でもカリでもサオでもどこでもいい。俺が感じると思うところを舌先と唇を使って奉仕しろ。』" voices=""/>
		<msg @l="2158" char_id="1" frame_id="-1" name="玲" text="『‥‥わかりました。』"
		   voices="rei01740"/>
		<msg @l="2160" char_id="-1" frame_id="-1" name=""
		   text="そう、短く答えると‥‥玲はしばらく無言のまま逡巡してからゆっくりと肉砲の先端部分に舌先を這わせ始める。" voices=""/>
		<msg @l="2162" char_id="1" frame_id="-1" name="玲"
		   text="『ん、んっ‥‥んちゅっ‥‥‥んぁ‥‥‥‥ぴちゃ‥‥‥‥。』" voices="rei01750"/>
		<msg @l="2164" char_id="1" frame_id="-1" name="玲"
		   text="『ちゅろ‥‥ちゅろ‥‥‥ん、んふっ‥‥‥‥れろれろれろれろっ。』" voices="rei01760"/>
		<msg @l="2166" char_id="-1" frame_id="-1" name=""
		   text="つたない知識の中、玲は何とか真島を満足させようと、懸命に舌先を使っては肉柱の先端部分をしゃぶり続ける。" voices=""/>
		<msg @l="2167" char_id="-1" frame_id="-1" name=""
		   text="あの屈辱的な肉棒のビンタを受けまいと必死で舐め続けるのだ。" voices=""/>
		<msg @l="2168" char_id="-1" frame_id="-1" name=""
		   text="けれど真島はそんな玲の奉仕に声一つあげることなく黙って見つめている。" voices=""/>
		<msg @l="2169" char_id="-1" frame_id="-1" name=""
		   text="その為、本当に気持ちよくさせているのかどうかわからなくなってしまう。" voices=""/>
		<msg @l="2171" char_id="1" frame_id="-1" name="玲"
		   text="『んぅ‥‥ん、ちゅぷ‥‥‥れろ、れろ‥‥‥‥ん、ちゅろっ‥‥‥。』" voices="rei01770"/>
		<msg @l="2173" char_id="1" frame_id="-1" name="玲"
		   text="『れろ、れろ‥‥‥んはっ‥‥‥ん、ん、ん‥‥‥‥ぴちゃ、ぴちゃ。』" voices="rei01780"/>
		<msg @l="2175" char_id="-1" frame_id="-1" name=""
		   text="疑心暗鬼のまま玲は考え得る限りの場所を舐めまわす。" voices=""/>
		<msg @l="2176" char_id="-1" frame_id="-1" name=""
		   text="亀頭部にキスを浴びせたり、舌の先でレロレロと露口を舐め、カリの部分を舌で舐めまわし続けた。" voices=""/>
		<msg @l="2177" char_id="-1" frame_id="-1" name=""
		   text="舐めている合間、真島の表情を伺ったりもするのだが、彼は先ほどと変わらぬ無表情である。" voices=""/>
		<msg @l="2179" char_id="-1" frame_id="-1" name="真島" text="『よし、舐めるのはもういい。』"
		   voices=""/>
		<msg @l="2181" char_id="1" frame_id="-1" name="玲" text="『んっ‥‥。』"
		   voices="rei01790"/>
		<msg @l="2183" char_id="-1" frame_id="-1" name=""
		   text="口の端から零れ落ちていた唾液を拭い取り、玲が安堵の息を吐く。" voices=""/>
		<msg @l="2184" char_id="-1" frame_id="-1" name="" text="しかしその安堵も長くは続かない。"
		   voices=""/>
		<msg @l="2186" char_id="-1" frame_id="-1" name="真島" text="『次は咥えろ。出来るだけ深くだ。』"
		   voices=""/>
		<msg @l="2188" char_id="1" frame_id="-1" name="玲" text="『‥‥‥‥。』"
		   voices="rei01800"/>
		<msg @l="2190" char_id="-1" frame_id="-1" name=""
		   text="つい先ほどまでの奉仕など、何でもなかったかのように、真島が言う。" voices=""/>
		<msg @l="2191" char_id="-1" frame_id="-1" name="" text="無論、玲はこれに従うしかなかった。"
		   voices=""/>
		<wait_chgmv/>
		<ev @l="2195" src="ev-007bx1"/>
		<msg @l="2197" char_id="1" frame_id="-1" name="玲" text="『んぐっ‥‥ん、んんっ‥‥‥。』"
		   voices="rei01810"/>
		<msg @l="2199" char_id="-1" frame_id="-1" name=""
		   text="ゆっくりと、今度は玲自身の意志で、先ほどの奉仕により唾液で黒光りする砲身を口腔深くへと咥え込んでいった。" voices=""/>
		<msg @l="2200" char_id="-1" frame_id="-1" name=""
		   text="硬く屹立した肉塊は先端部分だけでも玲の口腔内の殆どを圧迫し、とてもそのすべてを咥え込めそうには無い。" voices=""/>
		<msg @l="2202" char_id="-1" frame_id="-1" name="真島"
		   text="『口の中だけじゃ俺のチ○ポは収まらねーよ。』" voices=""/>
		<msg @l="2204" char_id="-1" frame_id="-1" name="真島"
		   text="『深く咥えるときは喉を開いて、飲み込むようにするんだよ。』" voices=""/>
		<msg @l="2206" char_id="1" frame_id="-1" name="玲" text="『‥‥‥‥。』"
		   voices="rei01820"/>
		<msg @l="2208" char_id="-1" frame_id="-1" name=""
		   text="技術の無い玲を罵倒するように、冷ややかな声で真島が吐き捨てた。" voices=""/>
		<msg @l="2209" char_id="-1" frame_id="-1" name=""
		   text="玲はそれにわずかな怒りを覚えながらも、逆らうことは許されず、ただ言われるがままに醜悪なる異形の塊を飲み込んでいく。"
		   voices=""/>
		<msg @l="2211" char_id="1" frame_id="-1" name="玲"
		   text="『んっ‥‥‥んぐっ、んﾞんﾞっ‥‥‥‥。』" voices="rei01830"/>
		<msg @l="2213" char_id="-1" frame_id="-1" name=""
		   text="はき出しそうになりながらも、玲は必死に口腔内の肉柱を喉奥へと導く。" voices=""/>
		<msg @l="2214" char_id="-1" frame_id="-1" name=""
		   text="けれど彼女は何度やっても先端が喉奥の壁に擦りつけられる苦しさに、堪えることが出来ず、真島の男幹すべてを咥え込むには至らない。"
		   voices=""/>
		<msg @l="2216" char_id="-1" frame_id="-1" name="真島" text="『‥‥使えねーメス豚だな。』"
		   voices=""/>
		<msg @l="2218" char_id="-1" frame_id="-1" name="真島"
		   text="『ディープスロートはヤメだ‥‥そのままフェラチオでイかせてみろ。』" voices=""/>
		<msg @l="2220" char_id="1" frame_id="-1" name="玲" text="『‥‥‥‥。』"
		   voices="rei01840"/>
		<msg @l="2222" char_id="-1" frame_id="-1" name=""
		   text="真島は苛立たしげにそう言って玲を睨みつけるが、そう言われたところでどうすれば良いのか彼女には解らない。" voices=""/>
		<msg @l="2224" char_id="-1" frame_id="-1" name="真島"
		   text="『なんだ、フェラチオもできねーのか‥‥‥ほんっとクズだな。』" voices=""/>
		<msg @l="2226" char_id="-1" frame_id="-1" name="真島"
		   text="『いいか‥‥フェラチオってのはこうするんだよ。』" voices=""/>
		<msg @l="2228" char_id="-1" frame_id="-1" name=""
		   text="煩わしそうにそう言うと、真島は玲の頭をがっしりと掴んで前後に揺する。" voices=""/>
		<msg @l="2230" char_id="1" frame_id="-1" name="玲" text="『んんんんッ！？』"
		   voices="rei01850"/>
		<msg @l="2232" char_id="-1" frame_id="-1" name=""
		   text="突然のことに玲は目を白黒させて唸るが、真島はそんなことになど気にも留めず激しく頭を振らせた。" voices=""/>
		<msg @l="2233" char_id="-1" frame_id="-1" name=""
		   text="逃げられないよう玲の頭をガッチリと持って、蜜壺に突き入れるように玲の口を犯していく。" voices=""/>
		<msg @l="2235" char_id="1" frame_id="-1" name="玲" text="『んっ、んっ、んっ、んっ、んぅっ！！』"
		   voices="rei01860"/>
		<msg @l="2237" char_id="1" frame_id="-1" name="玲"
		   text="『んぐっ、んんっ、んぷっ、んぷっ、んぷっ‥‥‥‥ん、んぐっっ！！』" voices="rei01870"/>
		<msg @l="2239" char_id="-1" frame_id="-1" name=""
		   text="さすがの真島もディープスロートが無理だとわかっている以上、あまり深く肉根を突き入れようとはしない。" voices=""/>
		<msg @l="2240" char_id="-1" frame_id="-1" name=""
		   text="相手を壊すことで有名なサディストも、いちおう加減という言葉は知っているようだ。" voices=""/>
		<msg @l="2242" char_id="1" frame_id="-1" name="玲"
		   text="『んんっ、んっ、んっ‥‥‥んんっっ！！』" voices="rei01880"/>
		<msg @l="2244" char_id="-1" frame_id="-1" name=""
		   text="しかし、その激しさに玲の口端からはいやらしく涎れが垂れ流れる。" voices=""/>
		<msg @l="2246" char_id="-1" frame_id="-1" name="真島"
		   text="『わかったか？&#32;こうやって頭を動かしながら舌を絡めるんだよ。』" voices=""/>
		<msg @l="2248" char_id="-1" frame_id="-1" name="真島"
		   text="『ったく、フェラチオくらいその辺のガキだってやれるぜ。』" voices=""/>
		<msg @l="2250" char_id="-1" frame_id="-1" name=""
		   text="しばらくイラマチオを続けたあと、真島は悪態をついて手の動きを止めた。" voices=""/>
		<msg @l="2251" char_id="-1" frame_id="-1" name=""
		   text="玲は両目に涙を溜めながら、ゆっくりと先ほどまでの動きを追従するように頭を振り始めた。" voices=""/>
		<wait_chgmv/>
		<ev @l="2255" src="ev-007by2"/>
		<msg @l="2257" char_id="1" frame_id="-1" name="玲"
		   text="『んっ、んぷっ‥‥んっ、んっ、んっ‥‥‥。』" voices="rei01890"/>
		<msg @l="2259" char_id="-1" frame_id="-1" name=""
		   text="熱棒を咥え込んだまま、頭を前後に振って唇でサオの部分を扱いて行く。" voices=""/>
		<msg @l="2260" char_id="-1" frame_id="-1" name=""
		   text="真島がそうしたような無遠慮さはさすがにないが、それでも初心者にしては随分と男を喜ばせる奉仕になっていた。ましてや玲のような美人の口を犯す眺めは快楽の極みだろう。"
		   voices=""/>
		<msg @l="2262" char_id="-1" frame_id="-1" name="真島"
		   text="『そうやって頭を振りながら、唾液を溜めて舌を絡めな。』" voices=""/>
		<msg @l="2264" char_id="-1" frame_id="-1" name="真島"
		   text="『あと、先端を吸うのも忘れるんじゃねーぞ。』" voices=""/>
		<msg @l="2266" char_id="1" frame_id="-1" name="玲"
		   text="『ふぁい‥‥ん、じゅぷ‥‥‥ちゅぷ‥‥‥ん、んんっ‥‥‥ちゅぱ。』" voices="rei01900"/>
		<msg @l="2268" char_id="-1" frame_id="-1" name=""
		   text="じゅぶじゅぶと聞こえてくるいやらしい音と玲の咥えた苦しそうな嗚咽が混ざる。" voices=""/>
		<msg @l="2270" char_id="1" frame_id="-1" name="玲"
		   text="『んぐっ、ちゅぷ、ちゅぷ、ちゅぷっ‥‥んっ‥‥‥ちゅるるるっ。』" voices="rei01910"/>
		<msg @l="2272" char_id="-1" frame_id="-1" name=""
		   text="真島に言われるまま、玲は唾液をいっぱい溜め込んだ口内でさらに音を立てながら巨竿の先端を口から出し入れする。" voices=""/>
		<msg @l="2273" char_id="-1" frame_id="-1" name=""
		   text="時折歯が肉胴に当たると、真島はものすごい形相で玲を睨みつけて太腿の辺りをつま先でけり上げてくる。" voices=""/>
		<msg @l="2274" char_id="-1" frame_id="-1" name=""
		   text="そのたびに玲は萎縮し‥‥より従順になっていった。" voices=""/>
		<msg @l="2276" char_id="1" frame_id="-1" name="玲"
		   text="『ちゅぱっ、んふっ‥‥ちゅぷちゅぷちゅぷ‥‥‥ん、んん‥‥‥。』" voices="rei01920"/>
		<msg @l="2278" char_id="1" frame_id="-1" name="玲"
		   text="『んっ、んっ、んっ‥‥‥ぢゅるるっ‥‥ん、んふっ‥‥‥ちゅばっ！』" voices="rei01930"/>
		<msg @l="2280" char_id="-1" frame_id="-1" name=""
		   text="どれくらい、そうした奉仕が続いただろうか。" voices=""/>
		<msg @l="2281" char_id="-1" frame_id="-1" name=""
		   text="玲の拙い技術ではなかなか真島を最後までイカせることが出来ない。" voices=""/>
		<msg @l="2282" char_id="-1" frame_id="-1" name=""
		   text="アゴが疲れ、口の端からは絶えず白く泡だった唾液の筋がだらだらとたれ落ちていた。" voices=""/>
		<msg @l="2284" char_id="-1" frame_id="-1" name="真島" text="『‥‥じれってーな。』"
		   voices=""/>
		<msg @l="2286" char_id="-1" frame_id="-1" name="真島"
		   text="『もう頭は動かさなくていーから、先っぽだけ咥えてカリの裏側でもしゃぶってろ。』" voices=""/>
		<msg @l="2288" char_id="-1" frame_id="-1" name="真島"
		   text="『あと、お留守になっている手を使うんだよ。』" voices=""/>
		<msg @l="2290" char_id="-1" frame_id="-1" name=""
		   text="真島は鬱陶しげに言い放ち、玲の手に自分の手を重ね、剛直した分身の根元をしごかせた。玲のすらりとした指先がぎこちなくスライドする。"
		   voices=""/>
		<msg @l="2292" char_id="1" frame_id="-1" name="玲"
		   text="『ちゅぷっ‥‥んっ、んちゅ、ちゅろ、ちゅろ、ちゅろ、ちゅろ‥‥‥。』" voices="rei01940"/>
		<msg @l="2294" char_id="1" frame_id="-1" name="玲"
		   text="『んぷっ、んっ‥‥ちゅぷ、ちゅぷ、ちゅぷ‥‥‥ん、ちゅるるるっ。』" voices="rei01950"/>
		<msg @l="2296" char_id="-1" frame_id="-1" name=""
		   text="玲は言われた通り先端部分だけを咥え込むと、唇と舌を使ってカリ首の裏側へと執拗にしゃぶりついた。" voices=""/>
		<msg @l="2297" char_id="-1" frame_id="-1" name=""
		   text="頭を振りながら舌を絡めるよりも幾らか楽なこともあってか、それまで以上に激しい動きで舐めあげ、次第に繊細な指先もリズムよく肉棒を擦り始めた。"
		   voices=""/>
		<msg @l="2299" char_id="-1" frame_id="-1" name="真島"
		   text="『いい感じだ。そのまましゃぶってろよ。』" voices=""/>
		<msg @l="2301" char_id="-1" frame_id="-1" name="" text="初めて、真島が褒め言葉を口にする。"
		   voices=""/>
		<msg @l="2302" char_id="-1" frame_id="-1" name=""
		   text="これまで散々自分を小馬鹿にしていた相手に、わずかでも認められたことが嬉しかったのか、玲の奉仕は一層の熱を帯び、口のまわりをビチャビチャにして搾り取らんばかりにしゃぶりつく。"
		   voices=""/>
		<msg @l="2304" char_id="1" frame_id="-1" name="玲"
		   text="『ちゅろ、んぷっ‥‥ちゅぷ、ちゅぷ、ちゅぷ、ちゅぷ、ちゅぷっ。』" voices="rei01960"/>
		<msg @l="2306" char_id="1" frame_id="-1" name="玲" text="『んっ、ぢゅるるるるるるっ！！』"
		   voices="rei01970"/>
		<msg @l="2308" char_id="-1" frame_id="-1" name="真島" text="『よーし‥‥出すぞ。』"
		   voices=""/>
		<msg @l="2312" async="true" char_id="-1" frame_id="-1" name=""
		   text="どこに出す‥‥？" voices=""/>
		<select @l="2313">
			<menu @l="2317" label="EventLabel_138" text="口に出す"/>
			<menu @l="2320" label="EventLabel_139" text="顔にかける"/>
		</select>
		<label @l="2329" id="EventLabel_138"/>
		<msg @l="2331" char_id="-1" frame_id="-1" name="真島" text="『しっかり咥えてろっ！』"
		   voices=""/>
		<msg @l="2333" char_id="1" frame_id="-1" name="玲" text="『んむぅ！？』"
		   voices="rei01980"/>
		<flash @l="2337" count="4" fade="100" image="white"/>
		<wait_chgmv/>
		<ev @l="2341" src="ev-007az1"/>
		<msg @l="2343" char_id="1" frame_id="-1" name="玲" text="『んっ、んんんんんっ！？』"
		   voices="rei01990"/>
		<msg @l="2345" char_id="-1" frame_id="-1" name=""
		   text="真島の言葉のすぐ後、口内へ大量の熱い白濁色の液が注ぎ込まれた。" voices=""/>
		<msg @l="2346" char_id="-1" frame_id="-1" name=""
		   text="玲はそれに驚き、慌ててを吐き出そうとするが‥‥頭を押さえつけられていて離れることが出来ない。" voices=""/>
		<msg @l="2347" char_id="-1" frame_id="-1" name=""
		   text="むっとするほどの濃い性臭が漂う生温かい液体が口の中いっぱいに満たされる。" voices=""/>
		<msg @l="2349" char_id="-1" frame_id="-1" name="真島"
		   text="『吐き出すなよ‥‥一滴残らず飲み込め。』" voices=""/>
		<msg @l="2351" char_id="1" frame_id="-1" name="玲" text="『んんー！？』"
		   voices="rei02000"/>
		<msg @l="2353" char_id="-1" frame_id="-1" name="真島" text="『飲め。』" voices=""/>
		<msg @l="2355" char_id="1" frame_id="-1" name="玲" text="『‥‥‥‥。』"
		   voices="rei02010"/>
		<msg @l="2357" char_id="1" frame_id="-1" name="玲"
		   text="『んっ‥‥‥‥んくっ‥‥‥んくっ、んくっ‥‥ゴクッゴクッゴクッ‥‥。』" voices="rei02020"/>
		<msg @l="2359" char_id="-1" frame_id="-1" name=""
		   text="一瞬の躊躇後、玲は苦悶の表情を浮かべながらも真島の視線に追いやられるようにして口内に溜まった汚濁の液体をごくっと喉を鳴らして飲み下していった。"
		   voices=""/>
		<msg @l="2360" char_id="-1" frame_id="-1" name=""
		   text="男の濃い原液が玲の喉もとを通過していく。" voices=""/>
		<msg @l="2361" char_id="-1" frame_id="-1" name="" text="‥‥けれど、それも束の間。"
		   voices=""/>
		<clear @l="2367" class="all"/>
		<msg @l="2372" char_id="1" frame_id="-1" name="玲"
		   text="『んぐっ！？&#32;ゲホッ、ゴホゴホッ‥‥ケホッ！！』" voices="rei02030"/>
		<msg @l="2374" char_id="-1" frame_id="-1" name=""
		   text="どろどろの糊のような男の汁が喉に絡みつき、激しく咳き込む玲。" voices=""/>
		<msg @l="2375" char_id="-1" frame_id="-1" name=""
		   text="精液を飲むということ自体が初めてなのだから、無理もない。" voices=""/>
		<msg @l="2377" char_id="-1" frame_id="-1" name="真島"
		   text="『一滴残らず飲めっつったろーが！！』" voices=""/>
		<msg @l="2379" char_id="-1" frame_id="-1" name=""
		   text="吐き出すように咳き込んでいる玲に、真島が一喝する。" voices=""/>
		<msg @l="2380" char_id="-1" frame_id="-1" name=""
		   text="実際‥‥飲み込めといわれた真島の煮えたぎった欲望の大半は、床上に吐き出されていた。" voices=""/>
		<msg @l="2382" char_id="1" frame_id="-1" name="玲" text="『ごめんなさい‥‥‥‥‥飲めません。』"
		   voices="rei02040"/>
		<msg @l="2384" char_id="-1" frame_id="-1" name="真島"
		   text="『チッ‥‥ザーメンも飲めねークズ豚に価値なんかあるかよ。』" voices=""/>
		<msg @l="2386" char_id="1" frame_id="-1" name="玲" text="『そんな‥‥。』"
		   voices="rei02050"/>
		<goto @l="2389" label="EventLabel_140"/>
		<label @l="2393" id="EventLabel_139"/>
		<msg @l="2395" char_id="-1" frame_id="-1" name="真島" text="『顔で受け止めろよっ！』"
		   voices=""/>
		<msg @l="2397" char_id="1" frame_id="-1" name="玲" text="『ぷあっ！？』"
		   voices="rei02060"/>
		<flash @l="2401" count="4" fade="100" image="white"/>
		<wait_chgmv/>
		<ev @l="2405" src="ev-007bz1"/>
		<msg @l="2407" char_id="-1" frame_id="-1" name=""
		   text="玲の口から発射直前の肉ロケットが引き抜かれた瞬間、先端から大量の白濁色をした精液が吐き出される。" voices=""/>
		<msg @l="2408" char_id="-1" frame_id="-1" name=""
		   text="それは次々と玲の顔に降り注ぎ、美しい頬や愛らしい唇を白く染め上げていった。" voices=""/>
		<msg @l="2410" char_id="-1" frame_id="-1" name="真島"
		   text="『ふぅ‥‥顔に出されたザーメンは、指ですくって飲み込め。』" voices=""/>
		<msg @l="2412" char_id="-1" frame_id="-1" name="真島" text="『一滴も残すんじゃねーぞ。』"
		   voices=""/>
		<msg @l="2414" char_id="1" frame_id="-1" name="玲" text="『え‥‥。』"
		   voices="rei02070"/>
		<msg @l="2416" char_id="-1" frame_id="-1" name="真島"
		   text="『え、じゃねーんだよ。言われたことはさっさとやれ！』" voices=""/>
		<msg @l="2418" char_id="1" frame_id="-1" name="玲" text="『は、はいっ。』"
		   voices="rei02080"/>
		<msg @l="2420" char_id="1" frame_id="-1" name="玲"
		   text="『んっ‥‥‥んくっ‥‥ぴちゃ‥‥ぴちゃ‥‥‥‥。』" voices="rei02090"/>
		<msg @l="2422" char_id="-1" frame_id="-1" name=""
		   text="真島の一喝に肩を震わせると、玲は頬やまぶたの上に吐き出された淫欲の粘液を、指先ですくい取っては口の中へと運んでいった。"
		   voices=""/>
		<msg @l="2423" char_id="-1" frame_id="-1" name=""
		   text="口腔内へ運び込んだ精液のむわっとした生臭さに眉をひそめながら、懸命にそれを飲み下そうとする。" voices=""/>
		<msg @l="2424" char_id="-1" frame_id="-1" name="" text="‥‥が、それも長くは続かなかった。"
		   voices=""/>
		<clear @l="2430" class="all"/>
		<msg @l="2435" char_id="1" frame_id="-1" name="玲"
		   text="『んっ‥‥んくっ、んくっ‥‥‥‥‥んっ‥‥んぐっ！？』" voices="rei02100"/>
		<msg @l="2437" char_id="1" frame_id="-1" name="玲"
		   text="『ゴホッ‥‥ケホッ、ンっ、ゴホゴホッ‥‥‥。』" voices="rei02110"/>
		<msg @l="2439" char_id="-1" frame_id="-1" name=""
		   text="幾度目かに運び込んだ淫汁を飲み下そうとした瞬間、玲はむせて激しく咳き込んでしまう。" voices=""/>
		<msg @l="2440" char_id="-1" frame_id="-1" name=""
		   text="彼女にしてみれば今日初めて男の原液というモノを口にしたのだから、むっとするほどの濃い性臭や生温かさに拒否的な反応が出たとしても無理はない。"
		   voices=""/>
		<msg @l="2442" char_id="-1" frame_id="-1" name="真島" text="『こら、誰が吐き出せっつったよ！』"
		   voices=""/>
		<msg @l="2444" char_id="-1" frame_id="-1" name=""
		   text="飲み下すことが出来ず床にこぼれ落ちていく白い滴を見て、真島が激しく声を張り上げた。" voices=""/>
		<msg @l="2446" char_id="1" frame_id="-1" name="玲"
		   text="『ごめんなさい‥‥‥こんな、無理です‥‥‥。』" voices="rei02120"/>
		<msg @l="2448" char_id="-1" frame_id="-1" name="真島"
		   text="『ザーメンの処理も出来ねーのかよ、クズ女が！』" voices=""/>
		<msg @l="2450" char_id="1" frame_id="-1" name="玲" text="『そんな、ひどい‥‥。』"
		   voices="rei02130"/>
		<label @l="2454" id="EventLabel_140"/>
		<end_scene @l="2457"/>
		<stopbgm @l="2461" fadeout="1000"/>
		<wait_chgmv/>
		<bg @l="2465" src="bg17"/>
		<char @l="2469" id="ookur" pos="auto" src="ookuro010"/>
		<bgm @l="2473" src="bgm09" volume="1."/>
		<msg @l="2476" char_id="-1" frame_id="-1" name="大黒"
		   text="『まあまあ、彼女はまだ研修段階ですからね。』" voices=""/>
		<msg @l="2478" char_id="-1" frame_id="-1" name=""
		   text="汚物でも見るように、玲を見下している真島をいなすように、大黒がいつもの笑顔を浮かべたまま口を挟んできた。" voices=""/>
		<msg @l="2479" char_id="-1" frame_id="-1" name=""
		   text="けれど‥‥次に続いた大黒の言葉に、玲はやはり愕然とさせられた。" voices=""/>
		<msg @l="2481" char_id="-1" frame_id="-1" name="大黒"
		   text="『真島くんのご指導があれば、そのうち自分からおねだりをするようになりますよ。』" voices=""/>
		<clear @l="2484" class="char"/>
		<char @l="2486" id="ookur" pos="left" src="ookuro010"/>
		<char @l="2489" id="rei" pos="right" src="rei015"/>
		<msg @l="2491" char_id="1" frame_id="-1" name="玲" text="『‥‥！？』" voices=""/>
		<msg @l="2493" char_id="-1" frame_id="-1" name=""
		   text="大黒は「期待していますよ」と続けて、真島の肩を叩く。" voices=""/>
		<msg @l="2494" char_id="-1" frame_id="-1" name=""
		   text="玲は信じられないといった表情で大黒を見るが、やはり彼は満面の笑顔を浮かべて「次の検査もがんばってくださいね」などと無責任な言葉を言った。"
		   voices=""/>
		<msg @l="2496" char_id="-1" frame_id="-1" name="真島"
		   text="『よかったな、メス豚、大黒さんが寛大でよ。』" voices=""/>
		<msg @l="2498" char_id="-1" frame_id="-1" name="真島" text="『とりあえず一つ目は合格だとよ。』"
		   voices=""/>
		<msg @l="2500" char_id="-1" frame_id="-1" name=""
		   text="真島は蔑んだ表情で、吐き捨てるように言った。" voices=""/>
		<msg @l="2501" char_id="-1" frame_id="-1" name=""
		   text="どこまでも、玲の尊厳を踏みにじり続けるつもりなのだろう。" voices=""/>
		<msg @l="2503" char_id="-1" frame_id="-1" name="大黒"
		   text="『いやあ、彼はあんな風に言っていますが、初めてで真島くんをイかせられる女の子はなかなかいませんよ。』" voices=""/>
		<msg @l="2505" char_id="-1" frame_id="-1" name="大黒"
		   text="『玲さんには期待していますから、この調子でお願いしますよ。』" voices=""/>
		<msg @l="2507" char_id="1" frame_id="-1" name="玲" text="『‥‥‥‥。』" voices=""/>
		<msg @l="2509" char_id="-1" frame_id="-1" name="" text="大黒は玲の耳元でそっと囁くように言う。"
		   voices=""/>
		<msg @l="2510" char_id="-1" frame_id="-1" name=""
		   text="いちおう褒めているつもりなのだろうが、当然ながら玲の表情には一片の喜びも浮かんで来るはずもなかった。" voices=""/>
		<msg @l="2512" char_id="-1" frame_id="-1" name="真島"
		   text="『さーて、それじゃあさっさと次の検査にいくぞ。』" voices=""/>
		<msg @l="2514" char_id="-1" frame_id="-1" name="真島" text="『オマエら‥‥アレの準備をしろ。』"
		   voices=""/>
		<msg @l="2516" char_id="-1" frame_id="-1" name="男子社員Ａ"
		   text="『アレですね。わかりました。』" voices=""/>
		<msg @l="2518" char_id="-1" frame_id="-1" name="男子社員Ｂ"
		   text="『では、自分はチェックリストをプリントアウトしてきます。』" voices=""/>
		<msg @l="2520" char_id="-1" frame_id="-1" name=""
		   text="真島が指示を出すと、部下とおぼしき二人の男子社員が忙しそうに検査の準備をし始めた。" voices=""/>
		<msg @l="2521" char_id="-1" frame_id="-1" name=""
		   text="一人はオフィス入り口の隅に置かれた、スチロール板のようなモノで出来たボックスを運び、もう一人は自分のパソコンから何かを印刷している。"
		   voices=""/>
		<char @l="2525" id="rei" pos="right" src="rei014"/>
		<msg @l="2527" char_id="1" frame_id="-1" name="玲" text="『‥‥なにをするんですか？』"
		   voices=""/>
		<msg @l="2529" char_id="-1" frame_id="-1" name=""
		   text="それまで真島を警戒するように口を噤んでいた玲が、忙しそうに準備をしている男子社員二人の様子を見ポツリと疑問の言葉を口にする。"
		   voices=""/>
		<msg @l="2531" char_id="-1" frame_id="-1" name="真島" text="『すぐに解る。クソ豚は黙ってろ。』"
		   voices=""/>
		<char @l="2535" id="rei" pos="right" src="rei017"/>
		<msg @l="2537" char_id="1" frame_id="-1" name="玲" text="『‥‥‥‥。』" voices=""/>
		<msg @l="2539" char_id="-1" frame_id="-1" name=""
		   text="身も蓋もない返答に玲は憤りの表情を浮かべるが、それも真島にしてみれば見慣れた表情でしかない。" voices=""/>
		<msg @l="2540" char_id="-1" frame_id="-1" name=""
		   text="ここに配属される誰しもが、最初はこうして無意味に抗い続けるのだ。" voices=""/>
		<msg @l="2541" char_id="-1" frame_id="-1" name=""
		   text="しかしそんな彼女たちの行き着くところはみな、同じである。" voices=""/>
		<wait_chgmv/>
		<bg @l="2544" src="bg17h1"/>
		<msg @l="2546" char_id="-1" frame_id="-1" name="真島" text="『そら、準備が出来たぜ。』"
		   voices=""/>
		<msg @l="2548" char_id="-1" frame_id="-1" name=""
		   text="男子社員の一人が用意した箱のような物を指差して、真島が気だるげに言った。" voices=""/>
		<char @l="2552" id="rei" pos="right" src="rei014"/>
		<msg @l="2554" char_id="1" frame_id="-1" name="玲" text="『‥‥これは？』" voices=""/>
		<msg @l="2556" char_id="-1" frame_id="-1" name="大黒"
		   text="『ああ、これは弊社で開発しています次世代の断熱素材です。』" voices=""/>
		<msg @l="2558" char_id="-1" frame_id="-1" name="大黒"
		   text="『新築はもちろん、リフォームや増改築にも適した、軽くて丈夫な素材作りがこの製品の基本設計およびコンセプトになります。』"
		   voices=""/>
		<msg @l="2560" char_id="-1" frame_id="-1" name="真島"
		   text="『オマエには、これからこの断熱材の耐久テストをしてもらう。』" voices=""/>
		<msg @l="2562" char_id="1" frame_id="-1" name="玲" text="『え‥‥？』" voices=""/>
		<msg @l="2564" char_id="-1" frame_id="-1" name=""
		   text="玲は思わず、真島の言葉に間の抜けた声を漏らす。" voices=""/>
		<msg @l="2565" char_id="-1" frame_id="-1" name="" text="それもそうだろう。" voices=""/>
		<msg @l="2566" char_id="-1" frame_id="-1" name=""
		   text="これまでおおよそ建築とも建設とも無関係にしか思えなかった不条理な検査ばかりだったのに比べて、突然の「それらしい」検査内容である。"
		   voices=""/>
		<msg @l="2568" char_id="-1" frame_id="-1" name="真島" text="『なんだ、不服なのか？』"
		   voices=""/>
		<char @l="2572" id="rei" pos="right" src="rei115"/>
		<msg @l="2574" char_id="1" frame_id="-1" name="玲" text="『い、いえ‥‥不服なんかありません。』"
		   voices=""/>
		<msg @l="2576" char_id="1" frame_id="-1" name="玲"
		   text="『ただ‥‥その次世代の断熱材って、まだ未発表のモノですよね？』" voices=""/>
		<msg @l="2578" char_id="-1" frame_id="-1" name="大黒"
		   text="『そうですね。まだ実験段階ですから。』" voices=""/>
		<char @l="2581" id="rei" pos="right" src="rei114"/>
		<msg @l="2583" char_id="1" frame_id="-1" name="玲"
		   text="『そのテストを‥‥私がしてもいいんですか？』" voices=""/>
		<msg @l="2585" char_id="1" frame_id="-1" name="玲"
		   text="『普通、こうしたものは企業秘密になるのでは？』" voices=""/>
		<msg @l="2587" char_id="-1" frame_id="-1" name="大黒"
		   text="『新製品のテスターは一人でも多い方が良いですからね。』" voices=""/>
		<msg @l="2589" char_id="-1" frame_id="-1" name="大黒"
		   text="『それに、試行錯誤している段階にこそ、色々な人の意見を積極的に取り入れるべきかと思いますし。』" voices=""/>
		<char @l="2593" id="rei" pos="right" src="rei110"/>
		<msg @l="2595" char_id="1" frame_id="-1" name="玲"
		   text="『なるほど‥‥確かに、おっしゃる通りだと思います。』" voices=""/>
		<msg @l="2597" char_id="-1" frame_id="-1" name=""
		   text="予想外の展開に、玲の折れていた心はたちまち潤いを得た。" voices=""/>
		<msg @l="2598" char_id="-1" frame_id="-1" name=""
		   text="ようやく自分の専門分野への話題になった。" voices=""/>
		<msg @l="2599" char_id="-1" frame_id="-1" name=""
		   text="そのことが、これまで萎縮する一方だった彼女を元気にさせている。" voices=""/>
		<msg @l="2601" char_id="-1" frame_id="-1" name="真島"
		   text="『ぐだぐだ言ってねーで、オマエはコイツを持ってそこの穴から頭を突っ込みな。』" voices=""/>
		<char @l="2605" id="rei" pos="right" src="rei115"/>
		<msg @l="2607" char_id="1" frame_id="-1" name="玲" text="『あっ、はい‥‥。』"
		   voices=""/>
		<msg @l="2609" char_id="-1" frame_id="-1" name=""
		   text="玲は真島からＡ４サイズの用紙を一枚と、ボールペンを渡される。" voices=""/>
		<msg @l="2610" char_id="-1" frame_id="-1" name=""
		   text="その用紙には１～５の項目が書かれており、それぞれに対して５段階のチェック欄が設けられていた。" voices=""/>
		<msg @l="2611" char_id="-1" frame_id="-1" name="" text="いわゆるアンケート用紙のようなモノだ。"
		   voices=""/>
		<msg @l="2613" char_id="-1" frame_id="-1" name="真島"
		   text="『これからその用紙に書いてある順にテストをする。オマエは箱の中で順番にチェックをつけていけばいい。』" voices=""/>
		<msg @l="2615" char_id="1" frame_id="-1" name="玲"
		   text="『どうして中でチェックをしなければいけないんですか‥‥？』" voices=""/>
		<msg @l="2617" char_id="-1" frame_id="-1" name="大黒"
		   text="『玲さんには実際に断熱材を使用した部屋を想定した、内部からのチェックをして戴きたいのです。』" voices=""/>
		<msg @l="2619" char_id="-1" frame_id="-1" name="大黒"
		   text="『テスト素材が小さな箱型というのに関しましては、試作段階で素材の大量生産が出来ないといった関係からですので、ご了承ください。』"
		   voices=""/>
		<char @l="2622" id="rei" pos="right" src="rei110"/>
		<msg @l="2624" char_id="1" frame_id="-1" name="玲"
		   text="『そうですか‥‥そういうことでしたら、協力させていただきます。』" voices=""/>
		<clear @l="2628" class="char"/>
		<clear @l="2630" class="all"/>
		<msg @l="2632" char_id="-1" frame_id="-1" name=""
		   text="玲は大黒の言葉に頷いて、断熱材で出来た箱の側面に開いている穴から上半身を突き入れた。" voices=""/>
		<msg @l="2633" char_id="-1" frame_id="-1" name=""
		   text="箱の四辺が余り大きく作られていない為、全身は入らない。" voices=""/>
		<msg @l="2634" char_id="-1" frame_id="-1" name=""
		   text="腰骨の辺りまで進むと、反対側の壁に突き当たってしまう感じだ。" voices=""/>
		<msg @l="2635" char_id="-1" frame_id="-1" name=""
		   text="要するに、外から見ると下半身だけを箱の中から突き出したような形になってしまっているということである。" voices=""/>
		<msg @l="2637" char_id="-1" frame_id="-1" name="真島" text="『俺の声が聞こえるか？』"
		   voices=""/>
		<char @l="2640" id="rei" pos="center" src="rei014f" y="-80"/>
		<msg @l="2642" char_id="1" frame_id="-1" name="玲" text="『あ、はい。』" voices=""/>
		<msg @l="2644" char_id="-1" frame_id="-1" name="" text="箱の中に、真島の声が大きく反響する。"
		   voices=""/>
		<msg @l="2645" char_id="-1" frame_id="-1" name=""
		   text="声が余りにもクリアなので不思議に思って見回して見ると、箱の天井に小さなスピーカが設置されていた。" voices=""/>
		<msg @l="2647" char_id="-1" frame_id="-1" name="真島"
		   text="『その断熱材には防音効果もあるから、俺の声は箱の中のスピーカを通して聞こえるようになってるハズだ。』" voices=""/>
		<msg @l="2649" char_id="-1" frame_id="-1" name="真島"
		   text="『オマエの声もマイクを通じて俺のイヤホンに帰ってくるようになってるから、はっきり喋らねーと聞こえねーからな。』" voices=""/>
		<msg @l="2651" char_id="-1" frame_id="-1" name=""
		   text="そう言って真島は耳につけた無線のイヤホンを指先で弾いた。" voices=""/>
		<char @l="2654" id="rei" pos="center" src="rei010f" y="-80"/>
		<msg @l="2656" char_id="1" frame_id="-1" name="玲" text="『わかりました。』" voices=""/>
		<msg @l="2658" char_id="-1" frame_id="-1" name="真島"
		   text="『そんじゃ、最初の項目から順番にチェックしていけ。』" voices=""/>
		<msg @l="2660" char_id="1" frame_id="-1" name="玲" text="『はい。』" voices=""/>
		<msg @l="2662" char_id="-1" frame_id="-1" name=""
		   text="箱の中にはご丁寧にも、豆電球を使ったライトがあり、玲はそれを灯してから手元の用紙に書かれた項目を眺めていく。" voices=""/>
		<msg @l="2663" char_id="-1" frame_id="-1" name=""
		   text="用紙に書かれた項目は上から順番に、熱透過、防音、耐衝撃、耐震、耐水の５つで構成されている。" voices=""/>
		<msg @l="2665" char_id="1" frame_id="-1" name="玲" text="『まず熱透過チェックからですね。』"
		   voices=""/>
		<msg @l="2667" char_id="-1" frame_id="-1" name="真島"
		   text="『最初にスーツからおっぱいをくびり出せ！』" voices=""/>
		<char @l="2670" id="rei" pos="center" src="rei014f" y="-80"/>
		<msg @l="2672" char_id="1" frame_id="-1" name="玲" text="『え‥‥？』" voices=""/>
		<msg @l="2674" char_id="-1" frame_id="-1" name="真島"
		   text="『いちいちうるせーなー。室内は人肌だと、どの位の湿度を感じるか確認しなきゃいけねーんだよ。』" voices=""/>
		<msg @l="2676" char_id="-1" frame_id="-1" name="真島"
		   text="『誰にも見られねえんだから、おっぱい早く出せよ！！』" voices=""/>
		<char @l="2679" id="rei" pos="center" src="rei015f" y="-80"/>
		<msg @l="2681" char_id="1" frame_id="-1" name="玲" text="『わ、わかりました。』"
		   voices=""/>
		<msg @l="2683" char_id="-1" frame_id="-1" name=""
		   text="玲は腑に落ちなかったが、確かに誰にも見られるわけではないので、スーツの間から豊かな膨らみを出して湿度チェックをした。"
		   voices=""/>
		<char @l="2686" id="rei" pos="center" src="rei185f" y="-80"/>
		<msg @l="2688" char_id="1" frame_id="-1" name="玲"
		   text="『次に、防音のチェックですが‥‥これはどうしましょう？』" voices=""/>
		<msg @l="2690" char_id="-1" frame_id="-1" name="真島"
		   text="『箱の中のマイクを切るから、オマエは中でこれから自分の身に起きることを解説してろ。』" voices=""/>
		<char @l="2693" id="rei" pos="center" src="rei184f" y="-80"/>
		<msg @l="2695" char_id="1" frame_id="-1" name="玲" text="『え‥‥？』" voices=""/>
		<msg @l="2697" char_id="-1" frame_id="-1" name=""
		   text="スピーカ越しの言葉に玲が疑問を投げかけるよりも早く、箱の外へ露出している下半身を何かがさわりはじめる。" voices=""/>
		<msg @l="2698" char_id="-1" frame_id="-1" name="" text="真島が玲の尻を撫でているのだ。"
		   voices=""/>
		<char @l="2701" id="rei" pos="center" src="rei187f" y="-80"/>
		<msg @l="2703" char_id="1" frame_id="-1" name="玲"
		   text="『ちょっと‥‥やだ、やめてくださいっ！』" voices=""/>
		<msg @l="2705" char_id="-1" frame_id="-1" name=""
		   text="玲は腰をもぞもぞと揺らして抵抗をするが、箱の中に設置されたマイクがオフにされている為、その言葉はくぐもってしか外に聞こえない。"
		   voices=""/>
		<msg @l="2707" char_id="-1" frame_id="-1" name="真島"
		   text="『よく聞こえねーぞ、大声で解説しろ。』" voices=""/>
		<msg @l="2709" char_id="-1" frame_id="-1" name=""
		   text="スピーカからはハッキリと真島の声が聞こえてくる。" voices=""/>
		<msg @l="2710" char_id="-1" frame_id="-1" name=""
		   text="オフにされたのは内部から外部へ音を伝えるマイクだけのようだ。" voices=""/>
		<msg @l="2712" char_id="1" frame_id="-1" name="玲" text="『で、でもっ‥‥。』"
		   voices=""/>
		<msg @l="2714" char_id="-1" frame_id="-1" name="真島"
		   text="『ああ？&#32;聞こえねーっていってんだろ！？』" voices=""/>
		<char @l="2717" id="rei" pos="center" src="rei185f" y="-80"/>
		<msg @l="2719" char_id="1" frame_id="-1" name="玲" text="『‥‥‥‥。』" voices=""/>
		<msg @l="2721" char_id="-1" frame_id="-1" name=""
		   text="玲はようやく、この検査が先ほどまで行われていたそれらと同レベルのモノであるということを悟った。" voices=""/>
		<msg @l="2722" char_id="-1" frame_id="-1" name=""
		   text="ようするにここで玲がきちんと解説をしなければ‥‥やはり内定はもらえないというワケなのだろう。" voices=""/>
		<msg @l="2724" char_id="1" frame_id="-1" name="玲" text="『‥‥お尻を。』" voices=""/>
		<msg @l="2726" char_id="-1" frame_id="-1" name="真島" text="『なんだって？』"
		   voices=""/>
		<msg @l="2728" char_id="1" frame_id="-1" name="玲" text="『お‥‥お尻を撫でられてますっ！』"
		   voices=""/>
		<msg @l="2730" char_id="-1" frame_id="-1" name="真島" text="『ほー、それから？』"
		   voices=""/>
		<msg @l="2732" char_id="-1" frame_id="-1" name=""
		   text="玲のくぐもった声を聞いて真島がニヤリと笑い、玲の美しいラインを持つ白い尻を撫でていた手を、今度はムチッとした太腿の間へと滑り込ませていった。"
		   voices=""/>
		<msg @l="2734" char_id="1" frame_id="-1" name="玲" text="『太腿を‥‥撫でられました。』"
		   voices=""/>
		<msg @l="2736" char_id="-1" frame_id="-1" name="真島" text="『よーし、じゃあ次はどうだ。』"
		   voices=""/>
		<msg @l="2738" char_id="-1" frame_id="-1" name=""
		   text="ツルリと太腿を撫でていた手でスカートをたくし上げ、下着の上から瑞々しい尻肉を揉みしだく。" voices=""/>
		<msg @l="2740" char_id="1" frame_id="-1" name="玲" text="『んっ‥‥お、お尻を揉まれています。』"
		   voices=""/>
		<msg @l="2742" char_id="-1" frame_id="-1" name="真島" text="『単に揉んでるだけじゃねーだろ？』"
		   voices=""/>
		<msg @l="2744" char_id="1" frame_id="-1" name="玲"
		   text="『は、はいっ‥‥下着の上から、揉まれています。』" voices=""/>
		<msg @l="2746" char_id="-1" frame_id="-1" name="真島"
		   text="『じゃあ次で最後だ‥‥これはどうだ？』" voices=""/>
		<msg @l="2748" char_id="-1" frame_id="-1" name=""
		   text="いやらしい表情を浮かべながら、真島は下着の上から秘部を撫であげた。" voices=""/>
		<begin_trans @l="2752" time="500"/>
		<layer @l="2753" id="cutin_f" src="game_window_cutin" x="20" y="20"
		   z="-1001"/>
		<layer @l="2754" id="cutin" src="cut005b" x="32" y="32" z="-1000"/>
		<end_trans @l="2755"/>
		<msg @l="2757" char_id="1" frame_id="-1" name="玲" text="『‥‥！！』" voices=""/>
		<msg @l="2759" char_id="-1" frame_id="-1" name=""
		   text="真島の指が粘っこく媚肉を撫で上げた瞬間、玲は腰を大きく揺らして息を飲む。" voices=""/>
		<msg @l="2761" char_id="-1" frame_id="-1" name="真島"
		   text="『どうした？&#32;はやく答えろよ。』" voices=""/>
		<msg @l="2763" char_id="1" frame_id="-1" name="玲"
		   text="『し、下着の上から‥‥‥‥‥を‥‥触られています。』" voices=""/>
		<msg @l="2765" char_id="-1" frame_id="-1" name="真島"
		   text="『ああ？&#32;どこを触られてるって！？』" voices=""/>
		<msg @l="2767" char_id="1" frame_id="-1" name="玲" text="『‥‥‥‥。』" voices=""/>
		<msg @l="2769" char_id="-1" frame_id="-1" name="真島"
		   text="『ほら、なに黙ってんだよメス豚っ！』" voices=""/>
		<msg @l="2771" char_id="-1" frame_id="-1" name="真島"
		   text="『ちゃんとオマ○コを撫でまわされてますって言うんだよっ！！』" voices=""/>
		<msg @l="2773" char_id="1" frame_id="-1" name="玲" text="『くっ‥‥。』" voices=""/>
		<msg @l="2775" char_id="1" frame_id="-1" name="玲"
		   text="『お、おま‥‥こ‥‥‥を‥‥‥‥撫でられてます。』" voices=""/>
		<msg @l="2777" char_id="-1" frame_id="-1" name="真島"
		   text="『聞こえねーっていってんだろーがっ！！』" voices=""/>
		<msg @l="2779" char_id="1" frame_id="-1" name="玲"
		   text="『お、おま○こを‥‥撫でられてますっ。』" voices=""/>
		<msg @l="2781" char_id="-1" frame_id="-1" name="真島" text="『もう一回だ！』"
		   voices=""/>
		<char @l="2784" id="rei" pos="center" src="rei187f" y="-80"/>
		<msg @l="2786" char_id="1" frame_id="-1" name="玲" text="『おま○こを撫でられてますっ！』"
		   voices=""/>
		<msg @l="2788" char_id="-1" frame_id="-1" name="真島"
		   text="『よし、いいだろう。防音のところをチェックしとけよ。』" voices=""/>
		<char @l="2791" id="rei" pos="center" src="rei185f" y="-80"/>
		<begin_trans @l="2793" time="500"/>
		<clear @l="2794" layer="cutin_f"/>
		<clear @l="2795" layer="cutin"/>
		<end_trans @l="2796"/>
		<msg @l="2798" char_id="1" frame_id="-1" name="玲" text="『‥‥はい。』" voices=""/>
		<msg @l="2801" char_id="-1" frame_id="-1" name=""
		   text="そう言うと、真島はスピーカーのスイッチを入れなおした。" voices=""/>
		<msg @l="2802" char_id="-1" frame_id="-1" name=""
		   text="大声で卑猥な台詞を言わせる為のテストだった事に気付いた玲は、悔しさと恥ずかしさで気が狂いそうになっていた。" voices=""/>
		<msg @l="2804" char_id="-1" frame_id="-1" name=""
		   text="玲は恥辱と屈辱とが混ざりあった顔で頬を真っ赤にしながらも、律儀に手元の用紙にあるチェック欄を埋めていった。" voices=""/>
		<msg @l="2806" char_id="-1" frame_id="-1" name="真島" text="『次は耐衝撃のチェックだな。』"
		   voices=""/>
		<msg @l="2808" char_id="-1" frame_id="-1" name=""
		   text="スピーカから楽しげな真島の声が聞こえてきた。" voices=""/>
		<msg @l="2809" char_id="-1" frame_id="-1" name=""
		   text="玲はその余りにも喜々とした声に恐怖を感じ、口内のつばを飲む。" voices=""/>
		<msg @l="2811" char_id="-1" frame_id="-1" name="真島" text="『いくぜ？』" voices=""/>
		<char @l="2814" id="rei" pos="center" src="rei184f" y="-80"/>
		<msg @l="2816" char_id="1" frame_id="-1" name="玲" text="『‥‥！？』" voices=""/>
		<se @l="2820" buf="1" src="箱を蹴ってる" volume="1."/>
		<shake @l="2824" amp="10" class="all" cycle="30" duration="1000"
		   type="random"/>
		<msg @l="2826" char_id="-1" frame_id="-1" name=""
		   text="箱の左側から鈍い音と共に衝撃が伝わってきた。" voices=""/>
		<msg @l="2827" char_id="-1" frame_id="-1" name="" text="真島が耐熱材の側面に蹴りを入れたのだ。"
		   voices=""/>
		<char @l="2830" id="rei" pos="center" src="rei187f" y="-80"/>
		<msg @l="2832" char_id="1" frame_id="-1" name="玲" text="『な、何をしてるんですかっ！？』"
		   voices=""/>
		<msg @l="2834" char_id="-1" frame_id="-1" name="真島"
		   text="『何って、耐衝撃のテストじゃねーかよ。』" voices=""/>
		<char @l="2837" id="rei" pos="center" src="rei184f" y="-80"/>
		<msg @l="2839" char_id="1" frame_id="-1" name="玲"
		   text="『だ、だからってこんなの‥‥‥‥きゃっ！？』" voices=""/>
		<se @l="2843" buf="1" src="箱を蹴ってる" volume="1."/>
		<shake @l="2847" amp="10" class="all" cycle="30" duration="1000"
		   type="random"/>
		<msg @l="2849" char_id="-1" frame_id="-1" name="" text="再び、真島が蹴りを入れる。"
		   voices=""/>
		<msg @l="2850" char_id="-1" frame_id="-1" name=""
		   text="壁自体から伝わってくる衝撃はそうでもないが、なにぶん箱全体の面積と質量が小さいので横殴りの衝撃で傾きそうになる。" voices=""/>
		<char @l="2853" id="rei" pos="center" src="rei185f" y="-80"/>
		<msg @l="2855" char_id="1" frame_id="-1" name="玲"
		   text="『こ、こんなの‥‥正確なデータが取れるわけ‥‥‥‥‥ひっ！？』" voices=""/>
		<se @l="2859" buf="1" src="箱を蹴ってる" volume="1."/>
		<shake @l="2863" amp="10" class="all" cycle="30" duration="1000"
		   type="random"/>
		<msg @l="2865" char_id="-1" frame_id="-1" name=""
		   text="玲の言葉を遮るように、三度目の蹴りが入れられる。" voices=""/>
		<msg @l="2866" char_id="-1" frame_id="-1" name=""
		   text="断熱材の内側にいる玲からは解らないが、真島は箱に蹴りを入れるたびに恍惚とした笑みを浮かべていた。" voices=""/>
		<msg @l="2867" char_id="-1" frame_id="-1" name=""
		   text="ゲラゲラと笑いながら断熱材を蹴りつける真島に恐怖し、玲はただ息を飲んでその凶行が過ぎ去ってくれるのを祈っていた。" voices=""/>
		<msg @l="2869" char_id="-1" frame_id="-1" name="大黒"
		   text="『真島くん、楽しむのも結構だがその辺にしなさい。』" voices=""/>
		<msg @l="2871" char_id="-1" frame_id="-1" name="大黒"
		   text="『彼女が恐怖のあまり言葉を失ってしまっていますよ。』" voices=""/>
		<msg @l="2873" char_id="-1" frame_id="-1" name="真島" text="『ああ‥‥そうっスね。』"
		   voices=""/>
		<msg @l="2875" char_id="-1" frame_id="-1" name="真島"
		   text="『すんません、ちょっと興奮し過ぎましたわ。』" voices=""/>
		<msg @l="2877" char_id="1" frame_id="-1" name="玲" text="『‥‥‥‥。』" voices=""/>
		<msg @l="2879" char_id="-1" frame_id="-1" name=""
		   text="大黒と真島のそんなやり取りが、スピーカ越しに玲へと届いた。" voices=""/>
		<msg @l="2880" char_id="-1" frame_id="-1" name=""
		   text="玲の両目には‥‥大粒の涙が浮かんでいた。" voices=""/>
		<msg @l="2882" char_id="-1" frame_id="-1" name="真島"
		   text="『ちっ、耐衝撃チェックはこれで終わりかよ。』" voices=""/>
		<msg @l="2884" char_id="-1" frame_id="-1" name="真島" text="『んじゃ、次は耐震チェックだな。』"
		   voices=""/>
		<msg @l="2886" char_id="-1" frame_id="-1" name=""
		   text="意気揚々と言いながら、真島は玲の美尻をゆっくりと撫ではじめた。" voices=""/>
		<msg @l="2887" char_id="-1" frame_id="-1" name=""
		   text="そうしてしばらく下着越しに桃の実のような臀部の感触を味わった後、おもむろにその下着をずり下ろしてしまう。" voices=""/>
		<begin_trans @l="2890" time="500"/>
		<layer @l="2891" id="cutin_f" src="game_window_cutin" x="20" y="20"
		   z="-1001"/>
		<layer @l="2892" id="cutin" src="cut007" x="32" y="32" z="-1000"/>
		<end_trans @l="2893"/>
		<msg @l="2895" char_id="1" frame_id="-1" name="玲" text="『え‥‥な、なにをっ‥‥！？』"
		   voices=""/>
		<msg @l="2897" char_id="-1" frame_id="-1" name="真島"
		   text="『何って、もちろん耐震チェックに決まってんだろ？』" voices=""/>
		<begin_trans @l="2900" time="500"/>
		<layer @l="2901" id="cutin_f" src="game_window_cutin" x="20" y="20"
		   z="-1001"/>
		<layer @l="2902" id="cutin" src="cut007a" x="32" y="32" z="-1000"/>
		<end_trans @l="2903"/>
		<msg @l="2905" char_id="-1" frame_id="-1" name=""
		   text="真島はやはり楽しげに答えると、露になった秘裂へ指を差し込んだ。" voices=""/>
		<msg @l="2906" char_id="-1" frame_id="-1" name=""
		   text="玲のそこはいつの間にか奥より染み出した蜜で潤っており、割れ目を掻き分けた真島の指を瞬く間にビシャビシャと濡らしてしまう。"
		   voices=""/>
		<msg @l="2908" char_id="-1" frame_id="-1" name="真島"
		   text="『なんだあ？&#32;もうドロドロじゃねーかよ。』" voices=""/>
		<msg @l="2910" char_id="-1" frame_id="-1" name=""
		   text="玲の肉びらから香ってくる聖蜜の匂いを嗅ぎながら、真島はいやらしく問いかけた。" voices=""/>
		<msg @l="2912" char_id="-1" frame_id="-1" name="真島"
		   text="『オマエもしかして苛められると燃えちゃうマゾか？』" voices=""/>
		<msg @l="2914" char_id="-1" frame_id="-1" name="真島"
		   text="『それともさっきの蹴りにビビってオモラシでもしちゃいまちたかー？』" voices=""/>
		<msg @l="2916" char_id="-1" frame_id="-1" name=""
		   text="嗜虐的な笑みを浮かべて、真島が大声で言う。" voices=""/>
		<msg @l="2917" char_id="-1" frame_id="-1" name=""
		   text="それと同時にオフィスの各所からクスクスと女性社員の笑い声が聞こえた。" voices=""/>
		<msg @l="2919" char_id="1" frame_id="-1" name="玲" text="『そんなこと‥‥あ、ありませんっ。』"
		   voices=""/>
		<msg @l="2921" char_id="-1" frame_id="-1" name="真島"
		   text="『なにいい子ぶりっ子してんだよ、このメス豚がぁっ！』" voices=""/>
		<msg @l="2923" char_id="-1" frame_id="-1" name=""
		   text="真島は玲を辱める言葉を吐きながら、ピンクの肉壁をかき分けて、指でチロチロと女唇をいじっていた。" voices=""/>
		<msg @l="2925" char_id="-1" frame_id="-1" name="真島"
		   text="『いまさら弁解したってテメェがマ○コをドロドロにしてることに変わりはねーんだよ。』" voices=""/>
		<msg @l="2927" char_id="-1" frame_id="-1" name=""
		   text="玲の肉芯を指でさらにしつこく捏ねくり始める。" voices=""/>
		<msg @l="2929" char_id="1" frame_id="-1" name="玲" text="『いやぁ‥‥違うんです、これはっ。』"
		   voices=""/>
		<msg @l="2931" char_id="-1" frame_id="-1" name=""
		   text="玲は懸命に弁解しようとするが、真島に指で秘芯を触れられるたびにビクンと躰を跳ね上げた。" voices=""/>
		<msg @l="2932" char_id="-1" frame_id="-1" name=""
		   text="当然ながら真島が、弁明など聞く耳などを持っているワケがない。" voices=""/>
		<begin_trans @l="2935" time="500"/>
		<clear @l="2936" layer="cutin_f"/>
		<clear @l="2937" layer="cutin"/>
		<end_trans @l="2938"/>
		<clear @l="2940" class="char"/>
		<msg @l="2942" char_id="-1" frame_id="-1" name="真島"
		   text="『うるせーよ。淫乱マゾのメス豚ちゃんはマ○コにチ○ポ突っ込まれてアンアン喘いでればそれでいーんだよっ！』" voices=""/>
		<msg @l="2944" char_id="-1" frame_id="-1" name=""
		   text="嘲笑の表情と共に、真島が吐き捨て、玲のアソコへ肉棒を押し当てた。" voices=""/>
		<msg @l="2946" char_id="-1" frame_id="-1" name="真島"
		   text="『いいっスか？大黒さん、コイツの汚ねぇマ○コを俺ので消毒しとかないと、大黒さんに悪いっスから』" voices=""/>
		<msg @l="2948" char_id="-1" frame_id="-1" name="大黒"
		   text="『ええ、本当なら私が、玲さんを貫きたいのですが、穢れた玲さんの陰部で病気でもうつされてはたまりませんからね。』" voices=""/>
		<msg @l="2950" char_id="1" frame_id="-1" name="玲" text="『なっ！？』" voices=""/>
		<msg @l="2952" char_id="-1" frame_id="-1" name=""
		   text="穢れた？‥‥病気ですって！？‥‥あまりにも屈辱的な言葉だった。" voices=""/>
		<msg @l="2953" char_id="-1" frame_id="-1" name=""
		   text="幼い頃から、周りに「かわいい」「美しい」と言われるのが当たり前だった玲にとっては、この上ない侮辱の言葉だった。" voices=""/>
		<msg @l="2955" char_id="-1" frame_id="-1" name="" text="心が折れそうになる―――。"
		   voices=""/>
		<msg @l="2956" char_id="-1" frame_id="-1" name=""
		   text="涙で歪んだ美しい顔には、もう以前の誇り高さが感じられなかった。" voices=""/>
		<label @l="2959" id="event_scene40"/>
		<label @l="2963" id="chart_line33"/>
		<wait_chgmv/>
		<ev @l="2967" src="ev-040"/>
		<description @l="2970" text="二次面接Ｂ"/>
		<bgm @l="2974" src="bgm13" volume="1."/>
		<msg @l="2976" char_id="-1" frame_id="-1" name="真島"
		   text="『お前の大好きなチ○ポだ！！メス豚ぁ！！！！』" voices=""/>
		<msg @l="2978" char_id="1" frame_id="-1" name="玲" text="『んあああっ！！？』"
		   voices="rei02140"/>
		<msg @l="2980" char_id="-1" frame_id="-1" name=""
		   text="一気に肉槍を突き入れられ、玲が苦しげな声を漏らして腰を震わせる。" voices=""/>
		<msg @l="2982" char_id="-1" frame_id="-1" name="真島"
		   text="『くあー、なんだこれ。奥までぐちょぐちょだぜ？』" voices=""/>
		<msg @l="2984" char_id="-1" frame_id="-1" name="真島"
		   text="『やっぱオマエ、淫乱マゾのメス豚ケッテー。』" voices=""/>
		<msg @l="2986" char_id="-1" frame_id="-1" name=""
		   text="そう言って、真島は何の遠慮もなくガンガンと腰を振って玲の秘裂を肉砲で蹂躙する。" voices=""/>
		<msg @l="2987" char_id="-1" frame_id="-1" name=""
		   text="肉欲の幹が奥深くまで突き入れられるたびに、玲の身体と共に耐熱材の箱もギシギシと軋みながら揺れていた。" voices=""/>
		<msg @l="2989" char_id="1" frame_id="-1" name="玲"
		   text="『んんっ‥‥いや、いきなりそんな激しくなんてっ‥‥‥』" voices="rei02150"/>
		<msg @l="2991" char_id="-1" frame_id="-1" name=""
		   text="呼吸を弾ませながら、箱の内側で玲が悲痛な声を漏らす。" voices=""/>
		<msg @l="2992" char_id="-1" frame_id="-1" name=""
		   text="とはいえ‥‥その呼吸には確かな熱が篭っており、声も僅かに震えていた。" voices=""/>
		<msg @l="2994" char_id="-1" frame_id="-1" name="真島"
		   text="『おっと、確かにメス豚ちゃんの言うとーり。』" voices=""/>
		<msg @l="2996" char_id="-1" frame_id="-1" name="真島"
		   text="『いきなり激しくしたんじゃ、耐震チェックなんて出来ねーよな。』" voices=""/>
		<msg @l="2998" char_id="-1" frame_id="-1" name=""
		   text="わざとらしくそう言うと、真島は突然腰の動きをぴたりと止める。" voices=""/>
		<msg @l="3000" char_id="-1" frame_id="-1" name="真島"
		   text="『それじゃあ改めて耐震チェック‥‥まずは震度１からだぜ。』" voices=""/>
		<msg @l="3002" char_id="-1" frame_id="-1" name=""
		   text="先ほどまでの激しい腰使いとは裏腹に、ゆっくりとした動きで玲の膣内の肉壁を亀頭のカリでひっかくように掻き混ぜていく。"
		   voices=""/>
		<msg @l="3003" char_id="-1" frame_id="-1" name=""
		   text="激しさを失った代わりにストロークの長さと腰の動きは念入りで、ゆっくりと先端が抜け落ちるほどに引き抜かれたかと思うと、同じく１ミリずつ入れるような速度で奥深くまで時間をかけて突き入れる。"
		   voices=""/>
		<msg @l="3004" char_id="-1" frame_id="-1" name=""
		   text="この程度の律動では断熱材は殆ど揺れる事はなく、当然軋むこともない。" voices=""/>
		<msg @l="3005" char_id="-1" frame_id="-1" name=""
		   text="つまり‥‥腰のピストンの激しさを震度になぞらえている、というわけだ。" voices=""/>
		<msg @l="3007" char_id="1" frame_id="-1" name="玲" text="『んっ‥‥。』"
		   voices="rei02160"/>
		<msg @l="3009" char_id="-1" frame_id="-1" name=""
		   text="ゆっくりと秘所を太い剛棒で掻き混ぜられる感触に、玲は小さく身体を震わせながら、かすかに鼻に掛かった声を漏らす。" voices=""/>
		<msg @l="3010" char_id="-1" frame_id="-1" name=""
		   text="力任せに擦り上げられないことにより、意志に反して蜜壷が肉棒の形を感じる、その動きに玲は戸惑いと恥ずかしさを覚えていた。"
		   voices=""/>
		<msg @l="3012" char_id="-1" frame_id="-1" name="真島"
		   text="『ま、震度１なんてこんなもんだな。』" voices=""/>
		<msg @l="3014" char_id="-1" frame_id="-1" name="真島"
		   text="『それじゃあ続いて震度２、いくぜ。』" voices=""/>
		<msg @l="3016" char_id="-1" frame_id="-1" name=""
		   text="言葉と同時に、腰を打ちつける速度が僅かにあがっていく。" voices=""/>
		<msg @l="3017" char_id="-1" frame_id="-1" name=""
		   text="先ほどよりもわずかに早い‥‥けれどまだ何処か焦らしているような動きで、玲の胎内が緩やかに肉筒で掻き混ぜられた。" voices=""/>
		<msg @l="3019" char_id="1" frame_id="-1" name="玲" text="『んんっ‥‥あっ‥‥‥。』"
		   voices="rei02170"/>
		<msg @l="3021" char_id="-1" frame_id="-1" name=""
		   text="ゆっくりとした真島の動きにあわせて、玲の口からは切なげな声が漏れる。" voices=""/>
		<msg @l="3022" char_id="-1" frame_id="-1" name=""
		   text="ともすればそれは激しい動きを誘っているようにも聞こえた。" voices=""/>
		<msg @l="3024" char_id="-1" frame_id="-1" name="真島" text="『いいだろ、こーいうの？』"
		   voices=""/>
		<msg @l="3026" char_id="-1" frame_id="-1" name="真島"
		   text="『最初に思いっきり動いてやったのはな、そーやって痛いくらいにつっこんでからの方が敏感になって焦らされるのが辛くなるってワケ。』"
		   voices=""/>
		<msg @l="3028" char_id="-1" frame_id="-1" name="真島"
		   text="『特にオマエみてーな淫乱マゾにはたまらねーだろ？』" voices=""/>
		<msg @l="3030" char_id="1" frame_id="-1" name="玲"
		   text="『そ、そんなことっ‥‥ん、あふっ‥‥‥。』" voices="rei02180"/>
		<msg @l="3032" char_id="1" frame_id="-1" name="玲"
		   text="『いやぁ‥‥そこっ、擦らないで‥‥‥‥ん、んんっ！』" voices="rei02190"/>
		<msg @l="3034" char_id="-1" frame_id="-1" name="真島"
		   text="『モノ欲しそーな声して、なにが擦らないでーだよ。』" voices=""/>
		<msg @l="3036" char_id="-1" frame_id="-1" name="真島"
		   text="『ホントはもっと激しく犯して欲しいんだろ？&#32;でもダメだぜ。』" voices=""/>
		<msg @l="3038" char_id="-1" frame_id="-1" name=""
		   text="真島はからかうように笑いながら、それでもゆっくりとした速度で腰を動かし続ける。" voices=""/>
		<msg @l="3040" char_id="1" frame_id="-1" name="玲"
		   text="『んぁぁっ‥‥んっ、んっ、んぁっ‥‥‥。』" voices="rei02200"/>
		<msg @l="3042" char_id="1" frame_id="-1" name="玲"
		   text="『あんっ‥‥‥んふっ‥‥‥んぁっ、いやぁ‥‥‥‥‥。』" voices="rei02210"/>
		<msg @l="3044" char_id="-1" frame_id="-1" name=""
		   text="ゆっくりと動く真島の腰に合わせて、玲の美尻が左右に揺すられる。" voices=""/>
		<msg @l="3045" char_id="-1" frame_id="-1" name=""
		   text="それが秘裂を貫いているモノから逃れようとしての動きか、それとも真島が言うように激しく犯して欲しいという意思の表れなのかは玲自身にもわからない。"
		   voices=""/>
		<msg @l="3047" char_id="-1" frame_id="-1" name="真島"
		   text="『おいおい、もう腰が動いちまってるぞ。』" voices=""/>
		<msg @l="3049" char_id="-1" frame_id="-1" name="真島"
		   text="『震度２でこれじゃ、先が思いやられるなあ？』" voices=""/>
		<msg @l="3051" char_id="-1" frame_id="-1" name=""
		   text="真島はその腰のうねりを見て満足し、玲の白い双臀を楽しげに揉み上げながら愉悦の笑みを浮かべた。" voices=""/>
		<msg @l="3053" char_id="1" frame_id="-1" name="玲"
		   text="『んぅっ‥‥‥‥ちが、んっ‥‥‥ああっ‥‥‥。』" voices="rei02220"/>
		<msg @l="3055" char_id="-1" frame_id="-1" name="真島"
		   text="『腰振りながらじゃ何言っても説得力ねーんだよ、メス豚。』" voices=""/>
		<msg @l="3057" char_id="-1" frame_id="-1" name="真島"
		   text="『そら‥‥次は震度３だ、そろそろキツクなってくるぜっ。』" voices=""/>
		<shake @l="3061" amp="10" class="all" cycle="30" duration="1000"
		   type="random"/>
		<msg @l="3063" char_id="1" frame_id="-1" name="玲" text="『んぁぁっ！！』"
		   voices="rei02230"/>
		<msg @l="3065" char_id="-1" frame_id="-1" name=""
		   text="さらにピストンの速度を早め、真島は男根の先端をそれまで以上に深く強く子宮口まで押し込んでいった。" voices=""/>
		<msg @l="3067" char_id="1" frame_id="-1" name="玲" text="『あふっ、んっ、んっ‥‥んんっ！』"
		   voices="rei02240"/>
		<msg @l="3069" char_id="-1" frame_id="-1" name=""
		   text="断熱材の箱をギシギシと軋ませながら、玲の身体が前後に揺らされる。" voices=""/>
		<msg @l="3070" char_id="-1" frame_id="-1" name=""
		   text="真実、それが震度３の揺れかどうかはともかく‥‥断熱材で作られた四角い小部屋はその前後運動にもビクともせず形を保っていた。"
		   voices=""/>
		<msg @l="3072" char_id="-1" frame_id="-1" name="真島"
		   text="『そら、しっかりチェックしてるかあ！？』" voices=""/>
		<msg @l="3074" char_id="1" frame_id="-1" name="玲"
		   text="『んんっ‥‥んっ‥‥んっ‥‥‥‥ふぁぁっ！！』" voices="rei02250"/>
		<msg @l="3076" char_id="-1" frame_id="-1" name="真島"
		   text="『ハハッ、もうそれどころじゃねーってワケだ！？』" voices=""/>
		<msg @l="3078" char_id="-1" frame_id="-1" name=""
		   text="真島がいう所の「震度」が上がるたび、玲は拒絶の言葉を紡ぐ余裕もないほどに熱く声を荒げた。" voices=""/>
		<msg @l="3079" char_id="-1" frame_id="-1" name=""
		   text="玲の秘部からはグチュグチュと淫汁が溢れ出し、真島の肉棒は泡だった淫汁にまみれ卑猥にテラテラと濡れていた。" voices=""/>
		<msg @l="3081" char_id="-1" frame_id="-1" name="真島" text="『震度４だっ！』"
		   voices=""/>
		<shake @l="3085" amp="10" class="all" cycle="30" duration="1000"
		   type="random"/>
		<msg @l="3087" char_id="-1" frame_id="-1" name=""
		   text="真島は狂犬のように叫ぶと、玲の尻へ無遠慮に腰を叩きつけて子宮口を壊す勢いで秘門へ肉砲を突き入れていく。" voices=""/>
		<msg @l="3088" char_id="-1" frame_id="-1" name=""
		   text="それはもう震度４などで済むような振動ではなかったが、真島にしても玲にしてもそんなことは既にどうでもよくなっていた。苦痛と快美感が入り乱れていく。"
		   voices=""/>
		<msg @l="3090" char_id="1" frame_id="-1" name="玲"
		   text="『んああっ、あっ、あっ、あっ、あふっ！！』" voices="rei02260"/>
		<msg @l="3092" char_id="-1" frame_id="-1" name=""
		   text="激しく軋む断熱材の箱と共に、玲の上げる吐息も大きく激しくなる。" voices=""/>
		<msg @l="3093" char_id="-1" frame_id="-1" name=""
		   text="その愛らしい唇からは、ただ甘い喘ぎだけが絶えず漏れ続けた。" voices=""/>
		<msg @l="3095" char_id="-1" frame_id="-1" name="真島"
		   text="『いいぜぇ、ムチもロープも使ってねーのにいい具合だ。』" voices=""/>
		<msg @l="3097" char_id="-1" frame_id="-1" name="真島"
		   text="『ゾクゾクするくらいマ○コからメス豚の匂いが漂ってくるぜ。』" voices=""/>
		<msg @l="3099" char_id="-1" frame_id="-1" name=""
		   text="真島は玲の花弁から発する、粘っこい花液の蜜の香りを嗅ぎながら、さらに下品な笑みを浮かべた。" voices=""/>
		<msg @l="3101" char_id="1" frame_id="-1" name="玲"
		   text="『んはっ、ああっ‥‥‥んっ、んっ、んっ、あふっ！！』" voices="rei02270"/>
		<msg @l="3103" char_id="1" frame_id="-1" name="玲"
		   text="『ああっ‥‥んっ、あふっ‥‥‥あっ、あっ、んぁぁっ！！』" voices="rei02280"/>
		<msg @l="3105" char_id="-1" frame_id="-1" name=""
		   text="切羽詰った声をあげて、玲は電気が流れたかのようにピクンとその白く美しい肢体を大きくのけぞらせた。" voices=""/>
		<msg @l="3106" char_id="-1" frame_id="-1" name=""
		   text="吐息も、躰も、膣内も‥‥彼女のすべてが「限界」を告げていた。" voices=""/>
		<msg @l="3108" char_id="-1" frame_id="-1" name="真島" text="『くっ‥‥情けねーが俺も限界だ。』"
		   voices=""/>
		<msg @l="3110" char_id="-1" frame_id="-1" name="真島"
		   text="『耐震チェック終了‥‥このまま耐水チェックといこうかっ！』" voices=""/>
		<msg @l="3112" char_id="1" frame_id="-1" name="玲"
		   text="『あっ、あっ、あっ、あっ‥‥ダメっ、ダメっ‥‥‥く、ああっ！！』" voices="rei02290"/>
		<msg @l="3114" char_id="1" frame_id="-1" name="玲"
		   text="『もっ‥‥んぁ、いくっ‥‥‥いっちゃ‥‥‥‥‥‥‥んんんっ！！』" voices="rei02300"/>
		<msg @l="3116" char_id="-1" frame_id="-1" name="真島" text="『いくぜっ！』" voices=""/>
		<msg @l="3118" char_id="1" frame_id="-1" name="玲" text="『ん、ああああああああっ！！！』"
		   voices="rei02310"/>
		<flash @l="3122" count="4" fade="100" image="white"/>
		<wait_chgmv/>
		<ev @l="3126" src="ev-040z1"/>
		<msg @l="3128" char_id="-1" frame_id="-1" name=""
		   text="昇り詰める瞬間‥‥真島は玲の花唇から猛る穂先を引き抜いて何度か自分でしごき上げると、白く丸い尻の上へ大量の白濁液を撒き散らした。"
		   voices=""/>
		<msg @l="3130" char_id="1" frame_id="-1" name="玲" text="『んっ‥‥あぁ‥‥‥‥。』"
		   voices="rei02320"/>
		<msg @l="3132" char_id="-1" frame_id="-1" name=""
		   text="ピンク色に紅潮した肌を汚し落ちていく熱い飛沫の感触に、玲が腰をぴくぴくと震わせる。" voices=""/>
		<msg @l="3134" char_id="1" frame_id="-1" name="玲"
		   text="『はぁ‥‥はぁ‥‥はぁ‥‥‥んっ‥‥‥あっ‥‥‥‥。』" voices="rei02330"/>
		<msg @l="3136" char_id="-1" frame_id="-1" name=""
		   text="断熱材によって囲われた箱の中で微かな息苦しさを感じながら‥‥。" voices=""/>
		<msg @l="3137" char_id="-1" frame_id="-1" name=""
		   text="玲は、絶頂の余韻に軽い痙攣をしながら熱い吐息を吐いていた。" voices=""/>
		<stopbgm @l="3141" fadeout="1000"/>
		<clear @l="3147" class="all"/>
		<end_scene @l="3150"/>
		<wait_chgmv/>
		<bg @l="3154" src="bg17h1"/>
		<bgm @l="3158" src="bgm09" volume="1."/>
		<char @l="3162" id="ookur" pos="auto" src="ookuro010"/>
		<msg @l="3164" char_id="-1" frame_id="-1" name="大黒" text="『おつかれさまです。』"
		   voices=""/>
		<msg @l="3166" char_id="-1" frame_id="-1" name="大黒"
		   text="『最後のチェックがあやふやになってしまいましたが、検査の結果はおおむね良好です。』" voices=""/>
		<msg @l="3168" char_id="-1" frame_id="-1" name=""
		   text="玲の白くツヤツヤとした尻に欲望の体液を撒き散らした真島へ、大黒がねぎらいの言葉をかける。" voices=""/>
		<msg @l="3169" char_id="-1" frame_id="-1" name=""
		   text="真島はそれにニヒルな笑みを浮かべて返しながら、モノをしまっている。" voices=""/>
		<msg @l="3171" char_id="-1" frame_id="-1" name="真島"
		   text="『コイツはなかなか上玉ですよ。さすが大黒さんが見込んだ女だ。』" voices=""/>
		<msg @l="3173" char_id="-1" frame_id="-1" name="真島"
		   text="『俺に任せてもらえれば二週間‥‥いや、１０日でチ○ポとザーメンが大好物の完璧なマゾ奴隷に仕上げてみせますがね。』" voices=""/>
		<msg @l="3175" char_id="-1" frame_id="-1" name=""
		   text="箱の中へ続いているマイクのスイッチを切ってから、真島が言う。" voices=""/>
		<msg @l="3176" char_id="-1" frame_id="-1" name=""
		   text="耳につけたイヤホンからは、箱の中で絶頂の余韻に浸っている玲の熱い吐息が聞こえてきた。" voices=""/>
		<msg @l="3178" char_id="-1" frame_id="-1" name="大黒"
		   text="『なるほど。では是非お願いしましょうか。』" voices=""/>
		<msg @l="3180" char_id="-1" frame_id="-1" name="大黒"
		   text="『彼女にはこの上ない屈辱と淫欲を刷り込んでください。』" voices=""/>
		<msg @l="3182" char_id="-1" frame_id="-1" name="真島" text="『ええ、わかってます。』"
		   voices=""/>
		<msg @l="3184" char_id="-1" frame_id="-1" name="大黒"
		   text="『それから、他の女は代わりなどいくらでもいますが、玲さんだけは特別ですので、くれぐれも壊してしまわないように。』" voices=""/>
		<msg @l="3186" char_id="-1" frame_id="-1" name="真島" text="『ええ、了解ッス。』"
		   voices=""/>
		<msg @l="3188" char_id="-1" frame_id="-1" name="大黒"
		   text="『あの誇り高かった玲さんが、堕ちていくのを見るのがこの上ない喜びなのですから。』" voices=""/>
		<msg @l="3190" char_id="-1" frame_id="-1" name="真島"
		   text="『大黒さんの望む形にキッチリ仕上げますヨ。』" voices=""/>
		<msg @l="3192" char_id="-1" frame_id="-1" name="真島"
		   text="『泣きながらチ○ポほしいとねだるブタにさせますから。』" voices=""/>
		<msg @l="3194" char_id="-1" frame_id="-1" name=""
		   text="真島は嗜虐的な笑みを浮かべると、無様に箱から伸びた玲の下半身を、侮蔑のそれをたっぷり含んだ視線で舐めるように見つめていた。"
		   voices=""/>
		<stopbgm @l="3198" fadeout="1000"/>
		<clear @l="3204" class="all"/>
		<label @l="3207" id="event_scene52"/>
		<label @l="3211" id="chart_line34"/>
		<wait_chgmv/>
		<bg @l="3215" src="bg17b"/>
		<msg @l="3217" char_id="-1" frame_id="-1" name="" text="―――同日・深夜。" voices=""/>
		<msg @l="3218" char_id="-1" frame_id="-1" name=""
		   text="終電時間が差し迫り社員のほとんどが帰った後も、社内で有名である「人材派遣部」のオフィスには電気が灯り続けていた。" voices=""/>
		<msg @l="3219" char_id="-1" frame_id="-1" name=""
		   text="オフィスには数名の男たちだけが残っている。" voices=""/>
		<bgm @l="3223" src="bgm14" volume="1."/>
		<wait_chgmv/>
		<ev @l="3227" src="ev-052y1y3"/>
		<description @l="3229" text="二次試験Ｃ"/>
		<msg @l="3231" char_id="1" frame_id="-1" name="声" text="『んっ、ふぁぁっ！！』"
		   voices="rei02340"/>
		<msg @l="3233" char_id="-1" frame_id="-1" name="" text="甘い声がオフィス内に響き渡る。"
		   voices=""/>
		<msg @l="3235" char_id="-1" frame_id="-1" name="男子社員Ａ"
		   text="『おい、まだ終わらないのかよっ。』" voices=""/>
		<msg @l="3237" char_id="-1" frame_id="-1" name="男子社員Ｂ"
		   text="『まあ待て‥‥もうちょいだからさ。』" voices=""/>
		<msg @l="3239" char_id="-1" frame_id="-1" name=""
		   text="オフィスの一角に出来た人だかりから苛立ちの声があがり、もう一方ではそれをなだめる。" voices=""/>
		<msg @l="3240" char_id="-1" frame_id="-1" name=""
		   text="その様子はこの「人材派遣部」では、時折見られる光景だった。" voices=""/>
		<msg @l="3241" char_id="-1" frame_id="-1" name=""
		   text="真島の命令で任意数名の男子社員だけが選出され、残業を行う。" voices=""/>
		<msg @l="3242" char_id="-1" frame_id="-1" name=""
		   text="そう‥‥これは「人材派遣部」の新人教育の一環なのだ。" voices=""/>
		<msg @l="3244" char_id="1" frame_id="-1" name="玲" text="『んんっ‥‥あっ、んくっ‥‥‥。』"
		   voices="rei02350"/>
		<msg @l="3246" char_id="-1" frame_id="-1" name=""
		   text="机をどけて作られたスペースに、玲が寝かされていた。" voices=""/>
		<msg @l="3247" char_id="-1" frame_id="-1" name=""
		   text="露にされた秘所とふたつのわななく乳房を、人材派遣部の男子社員が犯している。" voices=""/>
		<msg @l="3249" char_id="-1" frame_id="-1" name="男子社員Ｂ"
		   text="『そら、そらそらそらっ！&#32;もっと締め付けろよっ！』" voices=""/>
		<msg @l="3251" char_id="-1" frame_id="-1" name="男子社員Ｃ"
		   text="『うおおっ‥‥こいつのパイズリ最高だぞ。』" voices=""/>
		<msg @l="3253" char_id="1" frame_id="-1" name="玲"
		   text="『いやぁ‥‥んっ‥‥んっ‥‥‥‥そんな強く、んぁぁっっ！！』" voices="rei02360"/>
		<msg @l="3255" char_id="-1" frame_id="-1" name=""
		   text="男たちの好き勝手に躰を蹂躙されながらも、玲は自分で乳房を揉みこみ、肉棒を左右から適度な強さで押し上げる。巨乳がクッッションのように弾み、そのふくらみは心地よいやわらかさであった。"
		   voices=""/>
		<msg @l="3256" char_id="-1" frame_id="-1" name=""
		   text="心とは裏腹に‥‥ゾクゾクッとした熱い戦慄が背筋を駆け抜けていく。" voices=""/>
		<clear @l="3259" class="ev"/>
		<wait_chgmv/>
		<bg @l="3263" src="bg17b"/>
		<char @l="3267" id="ookur" pos="auto" src="ookuro010"/>
		<msg @l="3269" char_id="-1" frame_id="-1" name="大黒" text="『様子はどうですか？』"
		   voices=""/>
		<msg @l="3271" char_id="-1" frame_id="-1" name=""
		   text="人だかりの一角から玲の様子を眺めながら、大黒が言う。" voices=""/>
		<msg @l="3272" char_id="-1" frame_id="-1" name=""
		   text="帰り際という風にも見えないから、玲の様子でも見に来たのだろう。" voices=""/>
		<msg @l="3274" char_id="-1" frame_id="-1" name="真島"
		   text="『ああ、大黒さん‥‥結構いい調子っスよ。』" voices=""/>
		<msg @l="3276" char_id="-1" frame_id="-1" name="真島"
		   text="『最初は抵抗してましたがね、ちょっと強引に突っ込ませてやったらあんなですよ。』" voices=""/>
		<msg @l="3278" char_id="-1" frame_id="-1" name="大黒" text="『薬は使っていないのですか？』"
		   voices=""/>
		<msg @l="3280" char_id="-1" frame_id="-1" name="真島"
		   text="『使わなくてもいけますよ。それとも使った方がいいですかね？』" voices=""/>
		<msg @l="3282" char_id="-1" frame_id="-1" name="大黒"
		   text="『いえ、使わずに仕込めるのならそれに越したことはありません。』" voices=""/>
		<msg @l="3284" char_id="-1" frame_id="-1" name="大黒"
		   text="『玲さんが堕るのはかまいませんが、壊れるのは‥‥少しね。』" voices=""/>
		<msg @l="3286" char_id="-1" frame_id="-1" name="真島"
		   text="『それよりどうです、大黒さんもそろそろやっていきますか？』" voices=""/>
		<msg @l="3288" char_id="-1" frame_id="-1" name="大黒"
		   text="『そうですね。出来れば、私は遠慮したいのですが‥‥。』" voices=""/>
		<msg @l="3290" char_id="-1" frame_id="-1" name="真島"
		   text="『えっ、マジですか？あの大黒さんが！？どっか体調でも悪いんスか？』" voices=""/>
		<msg @l="3292" char_id="-1" frame_id="-1" name="大黒"
		   text="『いえいえ、そうではないのですよ。実は、ここにいる玲さんは、私の高校時代のマドンナでしてね、何度彼女を想像して射精したことか‥‥。』"
		   voices=""/>
		<msg @l="3294" char_id="-1" frame_id="-1" name="大黒"
		   text="『もし、すぐに果ててしまったら社員の皆さんに、社長としての示しが‥‥ね。』" voices=""/>
		<msg @l="3296" char_id="-1" frame_id="-1" name="真島"
		   text="『そうだったんスか、でも大丈夫っスよ、いつもコイツら大黒さんのすげぇとこ見てますから。』" voices=""/>
		<msg @l="3298" char_id="-1" frame_id="-1" name="大黒"
		   text="『それでは、お言葉に甘えまして、皆さんが落ち着いたら戴きましょう。』" voices=""/>
		<wait_chgmv/>
		<ev @l="3302" src="ev-052y1y3"/>
		<msg @l="3304" char_id="1" frame_id="-1" name="玲" text="『んんっ、んっ、んっ‥‥ああっ！！』"
		   voices="rei02370"/>
		<msg @l="3306" char_id="-1" frame_id="-1" name=""
		   text="大黒たちの会話をよそに、男たちは相変わらず貪るように玲の躰を犯し続けていた。" voices=""/>
		<msg @l="3307" char_id="-1" frame_id="-1" name=""
		   text="一人はグチュグチュと音を立てながら肉槍で熱い秘穴を貫き、もう一人は美しく揺れるたわわな肉乳に巨根を挟んでその感触を楽しんでいる。"
		   voices=""/>
		<msg @l="3309" char_id="-1" frame_id="-1" name="男子社員Ｂ"
		   text="『きたきたきたっ‥‥よーし、いくぞ、いくぞっ！』" voices=""/>
		<msg @l="3311" char_id="-1" frame_id="-1" name="男子社員Ｃ"
		   text="『こっちも、顔にたっぷりとかけてやるからな！』" voices=""/>
		<msg @l="3313" char_id="-1" frame_id="-1" name=""
		   text="玲の躰に覆い被さっていた二人が、ラストスパートとばかりに同時に腰を激しくたたきつける。極限までピストンが速くなる。"
		   voices=""/>
		<msg @l="3315" char_id="1" frame_id="-1" name="玲"
		   text="『んああっ、ダメっ、んっ‥‥ああああっ！！』" voices="rei02380"/>
		<flash @l="3319" count="4" fade="100" image="white"/>
		<wait_chgmv/>
		<ev @l="3323" src="ev-052x1y1y3z1z4"/>
		<msg @l="3325" char_id="1" frame_id="-1" name="玲"
		   text="『あっ、ああっ‥‥熱いの‥‥‥こんなに出てる‥‥‥‥‥。』" voices="rei02390"/>
		<msg @l="3327" char_id="-1" frame_id="-1" name=""
		   text="桃色に紅潮した美しい顔と蜜壺にたっぷりと注がれた熱い欲望の粘液に、玲は躰をけいれんさせながら切なげな声を漏らす。" voices=""/>
		<msg @l="3329" char_id="-1" frame_id="-1" name="男子社員Ｂ"
		   text="『へへっ‥‥たっぷり注いでやったぜ。』" voices=""/>
		<msg @l="3331" char_id="-1" frame_id="-1" name="男子社員Ｃ" text="『顔も胸も真っ白だな。』"
		   voices=""/>
		<msg @l="3333" char_id="-1" frame_id="-1" name=""
		   text="余韻に浸るように玲の躰に放った二人が口元を歪ませて笑った。" voices=""/>
		<msg @l="3334" char_id="-1" frame_id="-1" name=""
		   text="完全に「仕事」であることなど忘れてしまっているという顔だ。" voices=""/>
		<clear @l="3337" class="ev"/>
		<wait_chgmv/>
		<bg @l="3340" src="bg17b"/>
		<msg @l="3342" char_id="-1" frame_id="-1" name="真島"
		   text="『そら、終わったらさっさと代わりな。』" voices=""/>
		<msg @l="3344" char_id="-1" frame_id="-1" name="真島"
		   text="『大黒さんが直々に味見をするそーだぜ。』" voices=""/>
		<char @l="3348" id="ookur" pos="auto" src="ookuro010"/>
		<msg @l="3350" char_id="-1" frame_id="-1" name="大黒"
		   text="『すみませんね、順番を乱してしまいまして。』" voices=""/>
		<msg @l="3352" char_id="-1" frame_id="-1" name="男子社員Ｂ"
		   text="『いえいえ、社長あっての人材派遣部ですから。』" voices=""/>
		<msg @l="3354" char_id="-1" frame_id="-1" name="男子社員Ｃ"
		   text="『まったくですよ。順番なんて気にせず、いくらでも好きに使ってください。』" voices=""/>
		<msg @l="3356" char_id="-1" frame_id="-1" name=""
		   text="男子社員の二人はそう言って玲の躰から離れ、大黒に場所を譲った。" voices=""/>
		<msg @l="3358" char_id="-1" frame_id="-1" name="真島"
		   text="『大黒さん、胸とマ○コ‥‥どっちを使いますか？』" voices=""/>
		<msg @l="3360" char_id="-1" frame_id="-1" name="大黒"
		   text="『そうですねぇ‥‥では、パイズリを試してみましょうか。』" voices=""/>
		<msg @l="3362" char_id="-1" frame_id="-1" name="男子社員Ａ" text="『あ、あのぉ‥‥。』"
		   voices=""/>
		<msg @l="3364" char_id="-1" frame_id="-1" name="真島" text="『あん？』" voices=""/>
		<msg @l="3366" char_id="-1" frame_id="-1" name=""
		   text="大黒と真島の会話を聞きつけて、人だかりの中で順番待ちをしていた男子社員の一人がにじり寄ってくる。" voices=""/>
		<msg @l="3368" char_id="-1" frame_id="-1" name="真島" text="『なんだ、てめー？』"
		   voices=""/>
		<msg @l="3370" char_id="-1" frame_id="-1" name="男子社員Ａ"
		   text="『あの、自分はこの次の順番になってるんですが‥‥。』" voices=""/>
		<msg @l="3372" char_id="-1" frame_id="-1" name="男子社員Ａ"
		   text="『社長が胸でなさるんでしたら、自分はアソコの方でご一緒してよろしいですか？』" voices=""/>
		<msg @l="3374" char_id="-1" frame_id="-1" name="真島"
		   text="『ああ？&#32;ふざけてんじゃねーぞ。』" voices=""/>
		<msg @l="3376" char_id="-1" frame_id="-1" name="真島"
		   text="『大黒さんが終わるまで大人しく待ってろ、チンカス野郎が！』" voices=""/>
		<msg @l="3378" char_id="-1" frame_id="-1" name="男子社員Ａ"
		   text="『ひっ‥‥す、すんませんっ！！』" voices=""/>
		<msg @l="3380" char_id="-1" frame_id="-1" name=""
		   text="真島に一喝され、その男子社員は肩をすくめて小さくなった。" voices=""/>
		<msg @l="3381" char_id="-1" frame_id="-1" name=""
		   text="ちなみに彼の所属部署は経理部であり、何処からか今日の新人教育を聞きつけて飛び入り参加した別部署の人間ゆえに「暗黙のルール」を知らないのだ。"
		   voices=""/>
		<msg @l="3383" char_id="-1" frame_id="-1" name="大黒" text="『まあまあ。』" voices=""/>
		<msg @l="3385" char_id="-1" frame_id="-1" name="大黒"
		   text="『真島くん、そう堅いことを言わないで彼にもご一緒してもらえばいいだけの話じゃないですか。』" voices=""/>
		<msg @l="3387" char_id="-1" frame_id="-1" name="真島" text="『ですが‥‥。』"
		   voices=""/>
		<msg @l="3389" char_id="-1" frame_id="-1" name="大黒"
		   text="『その方が、私もそそられますしね‥‥。』" voices=""/>
		<msg @l="3391" char_id="-1" frame_id="-1" name="真島"
		   text="『まあ、大黒さんがそういうなら別に構いませんがね‥‥。』" voices=""/>
		<msg @l="3393" char_id="-1" frame_id="-1" name="大黒"
		   text="『それでは、キミは彼女のアソコを犯してあげてください。』" voices=""/>
		<msg @l="3395" char_id="-1" frame_id="-1" name="男子社員Ａ"
		   text="『あ、ありがとうございますっ！』" voices=""/>
		<wait_chgmv/>
		<ev @l="3399" src="ev-052y2y4z1z4"/>
		<msg @l="3401" char_id="-1" frame_id="-1" name="大黒"
		   text="『しっかりと味見させて戴きますよ。』" voices=""/>
		<msg @l="3403" char_id="-1" frame_id="-1" name=""
		   text="心の中で大黒は嬉しさのあまり震えていた。高校時代、あの焦がれ続けた玲が今は、自分の言いなりのペットだからだ。" voices=""/>
		<msg @l="3405" char_id="-1" frame_id="-1" name=""
		   text="大黒が玲の上半身に陣取り、そのたわわな白い乳房をすくい寄せて出来た谷間へと自分の分身を押し込む。" voices=""/>
		<msg @l="3406" char_id="-1" frame_id="-1" name=""
		   text="マシュマロのように柔らかな肉の双山はそれでも確かな弾力で、狭間にできた谷へ突き入れられた肉杭を包み込んでいる。" voices=""/>
		<msg @l="3408" char_id="-1" frame_id="-1" name="大黒"
		   text="『ほほう、これは確かに素晴らしいですね。』" voices=""/>
		<msg @l="3410" char_id="-1" frame_id="-1" name=""
		   text="すべてを吸い付くすような肌の感触に大黒が歓喜の声をあげて笑う。" voices=""/>
		<msg @l="3412" char_id="1" frame_id="-1" name="玲" text="『‥‥‥‥。』"
		   voices="rei02400"/>
		<msg @l="3414" char_id="-1" frame_id="-1" name=""
		   text="玲はそんな大黒を見ることもなく‥‥ただ、何かを堪えるように天井を見詰めていた。" voices=""/>
		<msg @l="3415" char_id="-1" frame_id="-1" name="" text="ささやかな反抗なのだろう。"
		   voices=""/>
		<msg @l="3416" char_id="-1" frame_id="-1" name=""
		   text="けれどそうした玲の事など構う事無く、先ほどの男子社員が蜜液であふれた花のような秘門へ肉棒の先端を押し付け‥‥一気に奥までずぶずぶと挿入した。"
		   voices=""/>
		<msg @l="3418" char_id="1" frame_id="-1" name="玲" text="『あっ、んんっ！！』"
		   voices="rei02410"/>
		<msg @l="3420" char_id="-1" frame_id="-1" name=""
		   text="挿入の瞬間、余りにも乱暴に肉壁をこすり上げられる刺激に耐え切れなかったらしく、玲は思わず声をあげて身悶えてしまう。"
		   voices=""/>
		<msg @l="3422" char_id="-1" frame_id="-1" name="男子社員Ａ"
		   text="『うわ、すごいっ‥‥膣中が絡みついてくる！』" voices=""/>
		<msg @l="3424" char_id="-1" frame_id="-1" name=""
		   text="男は叫ぶようにして歓喜の声を上げながら、挿入したばかりの男根を激しく動かして玲の秘裂を蹂躙した。" voices=""/>
		<msg @l="3425" char_id="-1" frame_id="-1" name=""
		   text="余りにも深く激しいピストンを続ける為、結合部からは先ほどの男が放った精液がグチュグチュと溢れ出してきている。" voices=""/>
		<msg @l="3427" char_id="-1" frame_id="-1" name="大黒" text="『ハハッ、最初から飛ばしますね。』"
		   voices=""/>
		<msg @l="3429" char_id="-1" frame_id="-1" name="男子社員Ａ"
		   text="『す、すんません‥‥マ○コの中が気持ちよくって。』" voices=""/>
		<msg @l="3431" char_id="-1" frame_id="-1" name="大黒"
		   text="『いえいえ、ご遠慮なさらず存分に犯してあげてください。』" voices=""/>
		<msg @l="3433" char_id="-1" frame_id="-1" name=""
		   text="肩越しにそんな言葉を交わしながら、大黒は玲の豊かな乳房を丹念に揉みまわす。" voices=""/>
		<msg @l="3434" char_id="-1" frame_id="-1" name=""
		   text="手のひらから零れ落ちそうなほどの膨らみを揉みしだきながら、その谷間に突き入れた剛棒をゆっくりとしごき上げていった。"
		   voices=""/>
		<msg @l="3436" char_id="-1" frame_id="-1" name="大黒"
		   text="『いいですね、揉み応えも大きさも十分‥‥これほどパイズリに適した胸もそうそうないですよ。』" voices=""/>
		<msg @l="3438" char_id="1" frame_id="-1" name="玲"
		   text="『んぁっ‥‥やっ、ああっ‥‥‥んっ、んっ‥‥‥‥。』" voices="rei02420"/>
		<msg @l="3440" char_id="-1" frame_id="-1" name=""
		   text="熱く硬い欲棒が美しい双山の狭間を征服するかのように擦り上げていくたび、玲は嫌悪の表情を浮かべながらも甘美な吐息を漏らして身悶えた。"
		   voices=""/>
		<msg @l="3441" char_id="-1" frame_id="-1" name=""
		   text="犯されている‥‥という状況が、快美感に変わり彼女を興奮させているのだろうか。" voices=""/>
		<msg @l="3442" char_id="-1" frame_id="-1" name=""
		   text="それとも胸の谷間でさえも感じるほどに堕ちてしまったのか‥‥。" voices=""/>
		<msg @l="3444" char_id="-1" frame_id="-1" name="男子社員Ａ"
		   text="『お、なんか急に締まりが良くなってきたぞ？』" voices=""/>
		<msg @l="3446" char_id="-1" frame_id="-1" name="真島" text="『そりゃイク寸前ってことだぜ。』"
		   voices=""/>
		<msg @l="3448" char_id="-1" frame_id="-1" name="真島"
		   text="『試しに一番奥のとこを思いっきり突き上げてやんな。もっと締め付けてくるはずだ。』" voices=""/>
		<msg @l="3450" char_id="-1" frame_id="-1" name="男子社員Ａ" text="『は、はいっ！』"
		   voices=""/>
		<msg @l="3452" char_id="-1" frame_id="-1" name=""
		   text="真島に後押しされ、それまで玲のを犯していた男は、腰を深く落として肉幹の先端を膣の最奥‥‥子宮口の辺りを激しく突き上げた。"
		   voices=""/>
		<msg @l="3454" char_id="1" frame_id="-1" name="玲"
		   text="『んんっ、あっ‥‥‥ダメっ‥‥そこ、そんなに強く突き上げたらっ！！』" voices="rei02430"/>
		<msg @l="3456" char_id="-1" frame_id="-1" name=""
		   text="男の腰がパンパンと小気味よいリズムを立ててぶつかるたび、玲は腰を震わせながら喘いだ。" voices=""/>
		<msg @l="3457" char_id="-1" frame_id="-1" name="" text="どうやらソコが彼女の弱点らしい。"
		   voices=""/>
		<msg @l="3459" char_id="-1" frame_id="-1" name="男子社員Ａ"
		   text="『ほ、ほんとだっ‥‥奥を突き上げるたびに締め付けがキュッと強くなって、搾り取るみたいにうねってる！！』" voices=""/>
		<msg @l="3461" char_id="-1" frame_id="-1" name=""
		   text="膣内の変化に喜々として、男はさらに執拗に子宮口を狙って破るがごとく突き上げた。" voices=""/>
		<msg @l="3462" char_id="-1" frame_id="-1" name=""
		   text="テクニックとしては今一つかもしれないが、今の玲にとってはその単調さが逆に強い刺激となっていた。" voices=""/>
		<msg @l="3464" char_id="1" frame_id="-1" name="玲"
		   text="『あふっ‥‥んんっ‥‥んっ、んっ、んっ‥‥‥んぁぁぁっ！』" voices="rei02440"/>
		<msg @l="3466" char_id="1" frame_id="-1" name="玲"
		   text="『ダメぇ、そこっ‥‥んんっ‥‥‥‥そんな、突き上げないでっ‥‥‥。』" voices="rei02450"/>
		<msg @l="3468" char_id="-1" frame_id="-1" name=""
		   text="強く奥に打ち付けられる度に、グチュグチュといやらしい音を立て、秘芯からは白い蜜汁をはき出した。" voices=""/>
		<msg @l="3469" char_id="-1" frame_id="-1" name=""
		   text="玲は、真っ白な喉もとをさらして絶え間なく、あえぎ声を上げる。" voices=""/>
		<msg @l="3471" char_id="-1" frame_id="-1" name="大黒" text="『なかなか盛り上がっていますね。』"
		   voices=""/>
		<msg @l="3473" char_id="-1" frame_id="-1" name=""
		   text="ねっとりと吸いつくように美しい乳房を揉みしだいていた大黒は、そう言って本腰を入れるように、狭間の谷を左右から強く押し上げて肉茎をしごきあげた。"
		   voices=""/>
		<msg @l="3474" char_id="-1" frame_id="-1" name=""
		   text="小高い丘のような胸の間からは、玲のしっとりとした白い汗で、まるで秘部のようにクチュクチュといやらしい音がしていた。"
		   voices=""/>
		<msg @l="3476" char_id="-1" frame_id="-1" name="大黒"
		   text="『それじゃあ、私も頑張らせて戴きましょうか。』" voices=""/>
		<msg @l="3478" char_id="-1" frame_id="-1" name=""
		   text="誇り高く、何者も寄せ付けない凛とした美しさ‥‥それが今は自分の下で、すがる様に、ち○ぽをおねだりするブタに成り下がっている。"
		   voices=""/>
		<msg @l="3480" char_id="-1" frame_id="-1" name=""
		   text="何度、こういう光景を想像してオナニーをしたことだろう。" voices=""/>
		<msg @l="3481" char_id="-1" frame_id="-1" name=""
		   text="それが今、現実として目の前にある―――。" voices=""/>
		<msg @l="3482" char_id="-1" frame_id="-1" name=""
		   text="そう思うだけで、大黒は思わず射精してしまうほどの興奮を覚えた。" voices=""/>
		<msg @l="3484" char_id="1" frame_id="-1" name="玲" text="『んあっ、あっ、あっ、んんっ！！』"
		   voices="rei02460"/>
		<msg @l="3486" char_id="1" frame_id="-1" name="玲"
		   text="『んっ‥‥あっ、あっ、あっ、んくっ‥‥‥ああっ！！』" voices="rei02470"/>
		<msg @l="3488" char_id="-1" frame_id="-1" name=""
		   text="二つの異なる肉柱にそれぞれの速度で快美に蹂躙され、玲は徐々に甘い溜息を上げていった。" voices=""/>
		<msg @l="3489" char_id="-1" frame_id="-1" name=""
		   text="声は上擦り、気付けば花唇を犯す男の腰の動きにあわせてリズムよく自分の腰も動いていた。絶え間なく吐息を洩らし、下半身はふしだらなほどにくねり動く。"
		   voices=""/>
		<msg @l="3491" char_id="-1" frame_id="-1" name="男子社員Ａ"
		   text="『も、もう‥‥出ちゃいますっ！』" voices=""/>
		<msg @l="3493" char_id="-1" frame_id="-1" name=""
		   text="荒い呼吸を繰り返しながら、胎内を犯していた男が情けない声を漏らす。" voices=""/>
		<msg @l="3494" char_id="-1" frame_id="-1" name=""
		   text="なにやら腰がブルブルと震えている所から察するに、これまでは周囲を意識して我慢をしていたのだろう。" voices=""/>
		<msg @l="3496" char_id="-1" frame_id="-1" name="真島"
		   text="『いいぜぇ、そのままソイツの奥にたっぷりと注いでやんな。』" voices=""/>
		<msg @l="3498" char_id="-1" frame_id="-1" name="男子社員Ａ" text="『は、はひぃぃっ！』"
		   voices=""/>
		<msg @l="3500" char_id="-1" frame_id="-1" name=""
		   text="真島の言葉に力の抜けた返事を返し、男が思いっきり自身の先端を子宮に叩きつけ、それを破るように叩きつけた。" voices=""/>
		<msg @l="3503" char_id="-1" frame_id="-1" name="大黒" text="『おお、私もそろそろイきますよ。』"
		   voices=""/>
		<msg @l="3505" char_id="-1" frame_id="-1" name=""
		   text="柔らかい白桃のような胸の谷間で扱いていた男棒をヒクつかせながら、大黒が息を弾ませる。" voices=""/>
		<msg @l="3506" char_id="-1" frame_id="-1" name=""
		   text="そうして膨らみの先端で硬く突起した大粒のサクランボのような乳首を指先で摘み、強くねじり上げた。" voices=""/>
		<msg @l="3508" char_id="-1" frame_id="-1" name=""
		   text="あの玲さんが、媚びるような目で自分を見ている。高校時代とは完全に立場が逆だ。" voices=""/>
		<msg @l="3509" char_id="-1" frame_id="-1" name=""
		   text="昔、玲さんは自分の事を、まるで虫でも見るかのような嫌悪の表情で見ていた。" voices=""/>
		<msg @l="3510" char_id="-1" frame_id="-1" name=""
		   text="それが今はどうだ？「気持ちいいですか？もっと感じてください」と潤んだ瞳で訴えかけている。" voices=""/>
		<msg @l="3512" char_id="-1" frame_id="-1" name=""
		   text="女神を堕とす‥‥その行為に、大黒は今まで感じた事がない征服感で胸が一杯になった。" voices=""/>
		<msg @l="3514" char_id="1" frame_id="-1" name="玲"
		   text="『んぁっ‥‥んんっ、んっ、んっ、んっ、んっ！！』" voices="rei02480"/>
		<msg @l="3516" char_id="1" frame_id="-1" name="玲"
		   text="『あふっ、んっ‥‥‥んあっ‥‥ダメぇっ‥‥いっ、あっ、あああっ！！』" voices="rei02490"/>
		<msg @l="3518" char_id="-1" frame_id="-1" name=""
		   text="玲の躰が大きくピーンと跳ね上がり、硬直する。" voices=""/>
		<msg @l="3519" char_id="-1" frame_id="-1" name=""
		   text="‥‥二人よりも先に絶頂に達してしまったのだ。" voices=""/>
		<msg @l="3521" char_id="-1" frame_id="-1" name="男子社員Ａ"
		   text="『お、おおおっ、締まるぅっ！』" voices=""/>
		<msg @l="3523" char_id="-1" frame_id="-1" name="大黒"
		   text="『その美しいお顔にかけてあげますよっ！！玲さんっ！！』" voices=""/>
		<flash @l="3527" count="4" fade="100" image="white"/>
		<wait_chgmv/>
		<ev @l="3531" src="ev-052x1y2y4z1z4z2z5"/>
		<msg @l="3533" char_id="1" frame_id="-1" name="玲" text="『んんっ‥‥。』"
		   voices="rei02500"/>
		<msg @l="3535" char_id="-1" frame_id="-1" name=""
		   text="二人の放つ白濁の粘液を浴び、玲は絶頂の余韻に浸りながら熱い吐息を漏らした。" voices=""/>
		<msg @l="3537" char_id="-1" frame_id="-1" name="大黒"
		   text="『ふぅ、玲さんだと思うと気持ちが昂ぶり、少々出しすぎてしまいましたね。』" voices=""/>
		<msg @l="3539" char_id="-1" frame_id="-1" name=""
		   text="極楽の射精に満足した大黒はぶるぶるっと体を震わせながら、紅潮した柔らかな躰を欲液に犯された玲の顔を見、満足げに言う。"
		   voices=""/>
		<msg @l="3540" char_id="-1" frame_id="-1" name=""
		   text="玲はそれに言葉を返すことはなく‥‥ただ、荒い呼吸を繰り返している。" voices=""/>
		<msg @l="3542" char_id="-1" frame_id="-1" name="男子社員Ａ"
		   text="『あ、ああっ‥‥全部‥‥‥‥出しちゃいました。』" voices=""/>
		<msg @l="3544" char_id="-1" frame_id="-1" name=""
		   text="玲の子宮にまで突き上げるように腰を押し付けたまま、男はやはり情けない声を出した。男は子宮内にめがけて濃い白濁液を噴射させたのだ。"
		   voices=""/>
		<msg @l="3545" char_id="-1" frame_id="-1" name=""
		   text="達したことで興奮が引き、罪悪感でも沸いてきたのだろう。" voices=""/>
		<msg @l="3547" char_id="-1" frame_id="-1" name="真島"
		   text="『心配すんな、どーせみんな中出ししてるんだ。例えこいつが身ごもってもオマエが責任取らされる心配はねーよ。』" voices=""/>
		<msg @l="3549" char_id="-1" frame_id="-1" name="男子社員Ａ"
		   text="『そ、そうですよね‥‥‥よかった‥‥‥。』" voices=""/>
		<msg @l="3551" char_id="-1" frame_id="-1" name="真島" text="『んなこたぁどーでもいいんだよ。』"
		   voices=""/>
		<msg @l="3553" char_id="-1" frame_id="-1" name="真島"
		   text="『それよりオマエはいつまでも萎えたチ○ポ突っ込んでねーで、とっとと後ろのヤツと代われ。』" voices=""/>
		<msg @l="3555" char_id="-1" frame_id="-1" name="男子社員Ａ" text="『は、はいっ！』"
		   voices=""/>
		<stopbgm @l="3559" fadeout="1000"/>
		<clear @l="3563" class="char"/>
		<clear @l="3565" class="ev"/>
		<wait_chgmv/>
		<bg @l="3569" src="bg17b"/>
		<msg @l="3571" char_id="-1" frame_id="-1" name="男子社員Ａ" text="『し、失礼しましたっ！』"
		   voices=""/>
		<msg @l="3573" char_id="-1" frame_id="-1" name=""
		   text="玲の秘所を犯していた男子社員はそれだけを言うと、人材派遣部のオフィスから逃げるように立ち去っていった。" voices=""/>
		<char @l="3577" id="ookur" pos="auto" src="ookuro010"/>
		<bgm @l="3581" src="bgm09" volume="1."/>
		<msg @l="3583" char_id="-1" frame_id="-1" name="大黒"
		   text="『真島くん、あまり他の部署の方を苛めるものじゃないですよ。』" voices=""/>
		<msg @l="3585" char_id="-1" frame_id="-1" name="真島"
		   text="『あーいうヤツを見てると苛々するんですよ‥‥。』" voices=""/>
		<msg @l="3587" char_id="-1" frame_id="-1" name="大黒"
		   text="『ハハッ、君はあいかわらず怖いですねぇ。』" voices=""/>
		<msg @l="3589" char_id="-1" frame_id="-1" name=""
		   text="大黒は真島の言葉にいつものように笑って答える。" voices=""/>
		<msg @l="3591" char_id="-1" frame_id="-1" name="真島"
		   text="『そら、休む暇なんて与えないでガンガン犯せ。』" voices=""/>
		<msg @l="3593" char_id="-1" frame_id="-1" name="真島"
		   text="『勃たなくなるまで、徹底的にやってやれ。』" voices=""/>
		<msg @l="3595" char_id="-1" frame_id="-1" name="男子社員Ｄ" text="『ういっす！』"
		   voices=""/>
		<msg @l="3597" char_id="-1" frame_id="-1" name="男子社員Ｅ"
		   text="『まかせといてくださいよ、真島サン。』" voices=""/>
		<msg @l="3599" char_id="-1" frame_id="-1" name=""
		   text="真島の指示を受けて、予期していなかった大黒の飛び入り参加で、一時中断してしまっていた輪姦作業が再開する。" voices=""/>
		<msg @l="3601" char_id="-1" frame_id="-1" name="大黒" text="『さすが、みなさんお強いですね。』"
		   voices=""/>
		<msg @l="3603" char_id="-1" frame_id="-1" name="真島"
		   text="『これだけが生き甲斐の連中ですからね。』" voices=""/>
		<msg @l="3605" char_id="-1" frame_id="-1" name="真島"
		   text="『それより大黒さんはどうしますか。このまま朝までお付き合いして戴くのなら‥‥。』" voices=""/>
		<msg @l="3607" char_id="-1" frame_id="-1" name="大黒"
		   text="『ハハッ、醜態をさらしてしまう前に、帰らせてもらいます。』" voices=""/>
		<msg @l="3609" char_id="-1" frame_id="-1" name="大黒"
		   text="『もし、私が本気になったらどうなってしまうか、あなたもご存知でしょう？』" voices=""/>
		<msg @l="3610" char_id="-1" frame_id="-1" name="真島"
		   text="『ええ。大黒さんが本気だしたら、コイツがぶっ壊れちまいますから。』" voices=""/>
		<msg @l="3612" char_id="-1" frame_id="-1" name="大黒"
		   text="『それは、私も不本意ですので、今日の所は帰らせて戴きます。』" voices=""/>
		<msg @l="3614" char_id="-1" frame_id="-1" name="真島"
		   text="『そうっスか。まあ気が向いたらまた様子を見に来てください。』" voices=""/>
		<msg @l="3616" char_id="-1" frame_id="-1" name="真島"
		   text="『仕込みの成果をその身体で味わって戴きますから。』" voices=""/>
		<msg @l="3618" char_id="-1" frame_id="-1" name="大黒"
		   text="『ええ。期待していますよ。私の玲さんを、ただのメスにして下さい。』" voices=""/>
		<clear @l="3622" class="char"/>
		<msg @l="3624" char_id="-1" frame_id="-1" name=""
		   text="大黒は軽く片手を上げて、悠々と人材派遣部のオフィスを出て行く。" voices=""/>
		<msg @l="3625" char_id="-1" frame_id="-1" name=""
		   text="真島は去っていく大黒の背中を見ながら口の端をつり上げると、誰にも届かない小さな声で「大黒さん‥アンタやっぱ怖いワ」と呟いた。"
		   voices=""/>
		<stopbgm @l="3629" fadeout="1000"/>
		<clear @l="3635" class="all"/>
		<msgshow @l="3637" show="true"/>
		<wait_chgmv/>
		<bg @l="3641" src="bg17b"/>
		<msg @l="3643" char_id="-1" frame_id="-1" name="" text="一体、どれほどの時間が過ぎただろうか。"
		   voices=""/>
		<msg @l="3644" char_id="-1" frame_id="-1" name=""
		   text="人材派遣部オフィスの灯りはまだ消えていなかった。" voices=""/>
		<msg @l="3645" char_id="-1" frame_id="-1" name=""
		   text="否‥‥彼らの仕事が「夜」のうちに終わることなど、絶対にありえない。" voices=""/>
		<msg @l="3646" char_id="-1" frame_id="-1" name=""
		   text="一度「新人研修」を開始したならば、朝日が昇るまでは終わらない。" voices=""/>
		<wait_chgmv/>
		<ev @l="3650" src="ev-052x2y1y3z1z4z2z5"/>
		<bgm @l="3654" src="bgm14" volume="1."/>
		<msg @l="3656" char_id="1" frame_id="-1" name="玲"
		   text="『んぁっ‥‥あっ‥‥あっ‥‥あっ‥‥‥。』" voices="rei02510"/>
		<msg @l="3658" char_id="-1" frame_id="-1" name=""
		   text="表情に色濃い疲労のそれを浮かべながら、玲が弱々しく喘いでいる。" voices=""/>
		<msg @l="3659" char_id="-1" frame_id="-1" name=""
		   text="既に意識は朦朧としており、その瞳には生気がない。" voices=""/>
		<msg @l="3660" char_id="-1" frame_id="-1" name="" text="何度絶頂に達しただろう。"
		   voices=""/>
		<msg @l="3661" char_id="-1" frame_id="-1" name="" text="何度精液を胎内に注ぎ込まれただろう。"
		   voices=""/>
		<msg @l="3662" char_id="-1" frame_id="-1" name=""
		   text="子宮から口内から溢れ出る精液が、また新しく注がれる精液と混じる。" voices=""/>
		<msg @l="3663" char_id="-1" frame_id="-1" name=""
		   text="粘膜という粘膜から、彼女は男達の放つ青臭いソレを吸収させられた。" voices=""/>
		<msg @l="3664" char_id="-1" frame_id="-1" name=""
		   text="達するたび、精液を注ぎ込まれるたび‥‥彼女は確実に「堕ちて」いった――。" voices=""/>
		<msg @l="3666" char_id="-1" frame_id="-1" name="男子社員Ｄ" text="『いくぞっ！』"
		   voices=""/>
		<msg @l="3668" char_id="-1" frame_id="-1" name="男子社員Ｅ" text="『俺も‥‥で、出るっ！！』"
		   voices=""/>
		<msg @l="3670" char_id="1" frame_id="-1" name="玲" text="『んっ、あああっ！！』"
		   voices="rei02520"/>
		<flash @l="3674" count="4" fade="100" image="white"/>
		<wait_chgmv/>
		<ev @l="3678" src="ev-052x2y1y3z1z4z2z5z3z6"/>
		<msg @l="3680" char_id="-1" frame_id="-1" name=""
		   text="男たちの絶頂に伴い、玲もまた意志に反して、脳天を突き破るような衝撃を受け、下肢を痙攣させながら絶頂へと昇り詰めてしまう。"
		   voices=""/>
		<msg @l="3681" char_id="-1" frame_id="-1" name=""
		   text="秘門からは大量の欲液がドロリと溢れ出し、乳首とクリ○リスは痛いほどに硬く勃起してしまっていた。" voices=""/>
		<msg @l="3682" char_id="-1" frame_id="-1" name=""
		   text="己の意志ではどうにもならない疼きが、絶えず玲の身体を駆け巡っている。" voices=""/>
		<msg @l="3683" char_id="-1" frame_id="-1" name=""
		   text="内に秘めたセックスの欲望を目覚めさせ、悪魔に身を委ねたかのように。" voices=""/>
		<msg @l="3685" char_id="1" frame_id="-1" name="玲"
		   text="『はぁ‥‥はぁ‥‥はぁ‥‥‥‥んっ、あぁ‥‥‥‥。』" voices="rei02530"/>
		<msg @l="3687" char_id="-1" frame_id="-1" name="" text="もう止めることは出来ない‥‥。"
		   voices=""/>
		<msg @l="3688" char_id="-1" frame_id="-1" name=""
		   text="そこにあるのは躰の交わりが生み出す淫靡な肉欲だけ。" voices=""/>
		<msg @l="3689" char_id="-1" frame_id="-1" name=""
		   text="朦朧とした意識の中、玲は絶望と肉欲に身を震わせた。" voices=""/>
		<msg @l="3691" char_id="-1" frame_id="-1" name="真島" text="『よーし、次のヤツ。』"
		   voices=""/>
		<msg @l="3693" char_id="-1" frame_id="-1" name="" text="深夜のオフィスに無情な声が響き渡る。"
		   voices=""/>
		<msg @l="3694" char_id="-1" frame_id="-1" name=""
		   text="玲の秘口に何回目か分からない男根が差し込まれる。" voices=""/>
		<msg @l="3695" char_id="-1" frame_id="-1" name=""
		   text="まだ‥‥狂気の宴は始まったばかりであった。" voices=""/>
		<stopbgm @l="3699" fadeout="1000"/>
		<clear @l="3705" class="all"/>
		<end_scene @l="3708"/>
		<call @l="3712" target="EventLabel_142@root_rei05a"/>
		<return @l="3713" value="0&#13;&#10;"/>
		<label @l="3717" id="EventLabel_141"/>
		<msg @l="3719" char_id="0" frame_id="1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="3721" char_id="-1" frame_id="-1" name="" text="声が出なかった。" voices=""/>
		<msg @l="3722" char_id="-1" frame_id="-1" name=""
		   text="本当ならば、無理やりにでも引き止めて、玲さんの身に何が起きているのか聞き出さなければいけないのだろう。" voices=""/>
		<msg @l="3723" char_id="-1" frame_id="-1" name="" text="けれど‥‥私にはそれが出来なかった。"
		   voices=""/>
		<msg @l="3724" char_id="-1" frame_id="-1" name=""
		   text="自分の身におきた災難を受け止めるが精一杯で―――。" voices=""/>
		<msg @l="3725" char_id="-1" frame_id="-1" name=""
		   text="一人でに溢れ出してくる涙を、堪えもせず流しながら、立ち去る朽木教授の背中を無言で見送ることしか‥‥出来なかった。" voices=""/>
		<stopbgm @l="3729" fadeout="1000"/>
		<clear @l="3735" class="all"/>
		<msgshow @l="3738" show="false"/>
		<call @l="3742" target="EventLabel_143@root_rei05b"/>
		<return @l="3743" value="0&#13;&#10;"/>
		<return @l="3747" value=""/>
	</code>
</xscript>
