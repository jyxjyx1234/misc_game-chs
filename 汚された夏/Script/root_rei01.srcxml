<?xml version="1.0" encoding="utf-8"?>
<xscript>
	<debug editor="&quot;C:\Program&#32;Files&#32;(x86)\sakura\sakura.exe&quot;&#32;&quot;%src%&quot;&#32;-Y=%line%"
	   src="D:\シロップ\町ぐるみの罠＋汚された夏セット版\汚された夏\完成データ\汚された夏\script\text\root_rei01.txt"/>
	<code>
		<label @l="13" id="EventLabel_130"/>
		<description @l="17" text="ルームメイトの憂鬱・１日目"/>
		<eval @l="19" expr="f.numDay=5&#13;&#10;"/>
		<msgshow @l="21" show="false"/>
		<wait_chgmv/>
		<bg @l="23" src="day05" time="2000"/>
		<wait @l="25" time="500"/>
		<wait_chgmv/>
		<bg @l="27" src="black" time="2000"/>
		<msgshow @l="29" show="true"/>
		<wait_chgmv/>
		<bg @l="33" src="bg03"/>
		<bgm @l="37" src="bgm04" volume="1."/>
		<char @l="41" id="rei" pos="auto" src="rei010"/>
		<msg @l="43" char_id="1" frame_id="-1" name="玲" text="『ごちそうさま。』" voices=""/>
		<char @l="47" id="rei" pos="auto" src="rei011"/>
		<msg @l="49" char_id="1" frame_id="-1" name="玲"
		   text="『それじゃ、悪いんだけど、後片付けお願いできるかしら？』" voices=""/>
		<msg @l="51" char_id="-1" frame_id="-1" name=""
		   text="朝食後のコーヒーを飲み干して玲さんが立ち上がる。" voices=""/>
		<msg @l="52" char_id="-1" frame_id="-1" name=""
		   text="今日はどうしても一限の講義から出ないといけないらしい。" voices=""/>
		<msg @l="53" char_id="-1" frame_id="-1" name=""
		   text="その為、始発の電車に乗らないと間に合わないのである。" voices=""/>
		<clear @l="56" class="char"/>
		<char @l="59" id="rei" pos="left" src="rei010"/>
		<char @l="62" id="miho" pos="right" src="miho031"/>
		<msg @l="64" char_id="0" frame_id="-1" name="美帆"
		   text="『はい、私は三限だけですから気にせず行ってください。』" voices=""/>
		<char @l="67" id="rei" pos="left" src="rei111"/>
		<msg @l="69" char_id="1" frame_id="-1" name="玲"
		   text="『ふふ‥‥なんだかいつもと逆な感じでおもしろいわね。』" voices=""/>
		<char @l="72" id="miho" pos="right" src="miho033"/>
		<msg @l="74" char_id="0" frame_id="-1" name="美帆" text="『言われてみればそうですね。』"
		   voices=""/>
		<char @l="78" id="miho" pos="right" src="miho136"/>
		<msg @l="80" char_id="0" frame_id="-1" name="美帆"
		   text="『でも‥‥就職活動中も授業があるって大変ですね。』" voices=""/>
		<char @l="84" id="rei" pos="left" src="rei020"/>
		<msg @l="86" char_id="1" frame_id="-1" name="玲" text="『本当にね‥‥。』" voices=""/>
		<char @l="89" id="rei" pos="left" src="rei118"/>
		<msg @l="91" char_id="1" frame_id="-1" name="玲"
		   text="『出来れば三年までに全単位を取っときたかったのだけれど。』" voices=""/>
		<char @l="95" id="miho" pos="right" src="miho031"/>
		<msg @l="97" char_id="0" frame_id="-1" name="美帆"
		   text="『大変だと思いますけど、頑張ってください。』" voices=""/>
		<char @l="101" id="rei" pos="left" src="rei111"/>
		<msg @l="103" char_id="1" frame_id="-1" name="玲" text="『ありがと。』" voices=""/>
		<msg @l="105" char_id="-1" frame_id="-1" name=""
		   text="そう言うと先輩はウインクをして、外出して行った。" voices=""/>
		<stopbgm @l="109" fadeout="1000"/>
		<clear @l="115" class="all"/>
		<msgshow @l="117" show="true"/>
		<bgm @l="120" src="bgm02" volume="1."/>
		<wait_chgmv/>
		<bg @l="124" src="bg09"/>
		<char @l="128" id="miho" pos="auto" src="miho013"/>
		<msg @l="130" char_id="0" frame_id="-1" name="美帆"
		   text="『ん～、やっぱりお昼ご飯食べたあとの講義は眠くなっちゃうな～。』" voices=""/>
		<msg @l="132" char_id="-1" frame_id="-1" name=""
		   text="三限目の講義が終わり、友達と一緒に廊下を歩いていた。" voices=""/>
		<bgm @l="135" src="bgm06" volume="1."/>
		<msg @l="137" char_id="-1" frame_id="-1" name="女友達"
		   text="『何いってんのよ、アンタは重役登校だったからいいじゃない。』" voices=""/>
		<char @l="140" id="miho" pos="auto" src="miho010"/>
		<msg @l="142" char_id="-1" frame_id="-1" name="女友達"
		   text="『こっちは一限からだもん。もう眠くて眠くて‥‥‥。』" voices=""/>
		<char @l="145" id="miho" pos="auto" src="miho016"/>
		<msg @l="147" char_id="0" frame_id="-1" name="美帆"
		   text="『自分だって、三限からの時は‥‥‥‥って、あれ？』" voices=""/>
		<char @l="151" id="miho" pos="auto" src="miho114"/>
		<stopbgm @l="155" fadeout="1000"/>
		<msg @l="157" char_id="-1" frame_id="-1" name=""
		   text="廊下の一角に知った顔を見つけて、思わず立ち止まる。" voices=""/>
		<msg @l="159" char_id="-1" frame_id="-1" name="女友達" text="『なになに、どーしたの？』"
		   voices=""/>
		<char @l="162" id="miho" pos="auto" src="miho016"/>
		<msg @l="164" char_id="0" frame_id="-1" name="美帆"
		   text="『あ、うん‥‥あそこにいるの、玲さんだなーと思って。』" voices=""/>
		<msg @l="166" char_id="-1" frame_id="-1" name="女友達"
		   text="『玲？‥‥ああ、美帆のルームメイトね。』" voices=""/>
		<msg @l="168" char_id="-1" frame_id="-1" name="女友達"
		   text="『んー‥‥なんか、考古学の朽木教授と話してるみたいだけど。』" voices=""/>
		<char @l="172" id="miho" pos="auto" src="miho116"/>
		<msg @l="174" char_id="0" frame_id="-1" name="美帆" text="『うん‥‥そうみたい。』"
		   voices=""/>
		<clear @l="179" class="char"/>
		<clear @l="185" class="all"/>
		<msgshow @l="187" show="true"/>
		<wait_chgmv/>
		<bg @l="192" src="bg09"/>
		<char @l="196" id="rei" pos="left" src="rei017"/>
		<char @l="199" id="kutsu" pos="right" src="kutsu010"/>
		<bgm @l="203" src="bgm15" volume="1."/>
		<msg @l="205" char_id="1" frame_id="-1" name="玲" text="『それは‥‥どういう意味ですか？』"
		   voices=""/>
		<char @l="208" id="kutsu" pos="right" src="kutsu018"/>
		<msg @l="210" char_id="-1" frame_id="-1" name="朽木"
		   text="『どうもこうも無い、言葉のままだよ。』" voices=""/>
		<char @l="213" id="rei" pos="left" src="rei027"/>
		<msg @l="215" char_id="1" frame_id="-1" name="玲" text="『そんなの納得できません‥‥。』"
		   voices=""/>
		<msg @l="217" char_id="1" frame_id="-1" name="玲"
		   text="『どうして面接合否についてを、就職指導部でもない朽木教授が知っているんですか。』" voices=""/>
		<msg @l="219" char_id="-1" frame_id="-1" name="朽木"
		   text="『情報は必ずしも決まった人のみが知っているものではない、ということだ。』" voices=""/>
		<char @l="221" id="rei" pos="left" src="rei117"/>
		<msg @l="223" char_id="1" frame_id="-1" name="玲" text="『誤魔化さないでください。』"
		   voices=""/>
		<char @l="226" id="kutsu" pos="right" src="kutsu010"/>
		<msg @l="228" char_id="-1" frame_id="-1" name="朽木"
		   text="『別に誤魔化してなどいない。こう見えても私は交友関係が広いんでね。』" voices=""/>
		<msg @l="230" char_id="-1" frame_id="-1" name="朽木"
		   text="『様々な人脈を持っている。ただそれだけの話だよ。』" voices=""/>
		<char @l="233" id="rei" pos="left" src="rei127"/>
		<msg @l="235" char_id="1" frame_id="-1" name="玲"
		   text="『なるほど‥‥その人脈を使って、不正な取引をしているという訳ですか。』" voices=""/>
		<char @l="238" id="kutsu" pos="right" src="kutsu014"/>
		<msg @l="240" char_id="-1" frame_id="-1" name="朽木"
		   text="『それは聞き捨てならないな。私がいつ、それらの人脈を不正な取引に使用したというんだね？』" voices=""/>
		<char @l="243" id="rei" pos="left" src="rei017"/>
		<msg @l="245" char_id="1" frame_id="-1" name="玲"
		   text="『証拠はありません。けれどそうした噂が多く流れているのは事実です。』" voices=""/>
		<char @l="248" id="kutsu" pos="right" src="kutsu018"/>
		<msg @l="250" char_id="-1" frame_id="-1" name="朽木"
		   text="『噂を本気にして言いがかりとは‥‥、随分と底が浅いものだな。』" voices=""/>
		<char @l="253" id="rei" pos="left" src="rei027"/>
		<msg @l="255" char_id="1" frame_id="-1" name="玲"
		   text="『‥‥ですが、火の無いところに煙は立たないといいます。』" voices=""/>
		<char @l="258" id="kutsu" pos="right" src="kutsu010"/>
		<msg @l="260" char_id="-1" frame_id="-1" name="朽木"
		   text="『何に対しても羨望や嫉妬を感じる者は存在する。そうした者が噂をばらまいているのだろう。』" voices=""/>
		<char @l="263" id="rei" pos="left" src="rei017"/>
		<msg @l="265" char_id="1" frame_id="-1" name="玲"
		   text="『では、教授はどういった目的で私に面接の合否を伝えに来られたのですか？" voices=""/>
		<msg @l="267" char_id="-1" frame_id="-1" name="朽木"
		   text="『無論、単なる親切心で伝えただけに過ぎないよ。』" voices=""/>
		<char @l="270" id="kutsu" pos="right" src="kutsu018"/>
		<msg @l="272" char_id="-1" frame_id="-1" name="朽木"
		   text="『現に‥‥私が君にその情報に対する代償を請求したかね？』" voices=""/>
		<char @l="275" id="rei" pos="left" src="rei027"/>
		<msg @l="277" char_id="1" frame_id="-1" name="玲"
		   text="『確かに請求されていません。ですが教授の口ぶりからはただの親切心で教えて下さったとは思えませんでしたわ。』" voices=""/>
		<msg @l="279" char_id="-1" frame_id="-1" name="朽木"
		   text="『それはキミ個人の捉え方に問題があるのではないかね？』" voices=""/>
		<char @l="282" id="rei" pos="left" src="rei115"/>
		<msg @l="284" char_id="1" frame_id="-1" name="玲" text="『‥っ‥‥‥。』" voices=""/>
		<char @l="287" id="kutsu" pos="right" src="kutsu010"/>
		<msg @l="289" char_id="-1" frame_id="-1" name="朽木"
		   text="『この不景気な御時世に就職活動をする大変さは分からないでもないが、少しは心に余裕を持たせないと変な誤解をされるかもしれないよ。』"
		   voices=""/>
		<clear @l="292" layer="kutsu"/>
		<char @l="294" id="kutsu" pos="auto" src="kutsu018"/>
		<msg @l="296" char_id="-1" frame_id="-1" name="朽木"
		   text="『特にキミの様なタイプは敵を作り易いから、十分に気をつけた方が良いだろうな。』" voices=""/>
		<char @l="299" id="rei" pos="left" src="rei125"/>
		<msg @l="301" char_id="1" frame_id="-1" name="玲" text="『‥‥ご忠告‥‥感謝します。』"
		   voices=""/>
		<clear @l="305" class="char"/>
		<char @l="308" id="kutsu" pos="right" src="kutsu018"/>
		<msg @l="310" char_id="-1" frame_id="-1" name="朽木" text="『では、がんばりたまえよ。』"
		   voices=""/>
		<clear @l="314" layer="kutsu"/>
		<msg @l="316" char_id="-1" frame_id="-1" name=""
		   text="朽木教授はニヤニヤと笑いながら立ち去っていった。" voices=""/>
		<char @l="319" id="rei" pos="left" src="rei015"/>
		<msg @l="321" char_id="1" frame_id="-1" name="玲" text="『‥‥‥‥。』" voices=""/>
		<char @l="325" id="rei" pos="left" src="rei027"/>
		<msg @l="327" char_id="1" frame_id="-1" name="玲" text="『‥‥何が「がんばりたまえ」よ。』"
		   voices=""/>
		<msg @l="329" char_id="-1" frame_id="-1" name=""
		   text="その場に一人残された玲さんが悔しそうに呟く。" voices=""/>
		<msg @l="330" char_id="-1" frame_id="-1" name=""
		   text="‥‥その綺麗な顔には怒りの表情が浮かんでいた。" voices=""/>
		<stopbgm @l="334" fadeout="1000"/>
		<msg @l="336" char_id="0" frame_id="-1" name="美帆" text="『先輩‥‥。』" voices=""/>
		<bgm @l="340" src="bgm07" volume="1."/>
		<char @l="344" id="rei" pos="left" src="rei024"/>
		<msg @l="346" char_id="1" frame_id="-1" name="玲" text="『え‥‥？』" voices=""/>
		<char @l="350" id="miho" pos="right" src="miho116"/>
		<msg @l="352" char_id="1" frame_id="-1" name="玲" text="『美帆‥‥やだ、アナタ見てたのっ？』"
		   voices=""/>
		<char @l="356" id="miho" pos="right" src="miho016"/>
		<msg @l="358" char_id="0" frame_id="-1" name="美帆" text="『えっと、その‥‥‥不本意ながら。』"
		   voices=""/>
		<char @l="362" id="rei" pos="left" src="rei113"/>
		<msg @l="364" char_id="1" frame_id="-1" name="玲"
		   text="『それならもっと早く声を‥‥‥かけられないわよね、あの状況じゃ。』" voices=""/>
		<char @l="367" id="miho" pos="right" src="miho116"/>
		<msg @l="369" char_id="0" frame_id="-1" name="美帆" text="『はい‥‥。』" voices=""/>
		<msg @l="371" char_id="-1" frame_id="-1" name=""
		   text="しかし私には二人のやり取りに割って入るだけの勇気はなかった。" voices=""/>
		<char @l="375" id="rei" pos="left" src="rei123"/>
		<msg @l="377" char_id="1" frame_id="-1" name="玲" text="『変な所を見られちゃったわね。』"
		   voices=""/>
		<char @l="380" id="rei" pos="left" src="rei128"/>
		<msg @l="382" char_id="1" frame_id="-1" name="玲"
		   text="『どうもね‥‥あの朽木って教授だけは苦手なのよ。』" voices=""/>
		<char @l="386" id="miho" pos="right" src="miho014"/>
		<msg @l="388" char_id="0" frame_id="-1" name="美帆" text="『それは‥‥。』" voices=""/>
		<msg @l="390" char_id="-1" frame_id="-1" name=""
		   text="それは痴漢の件があったからですか‥‥、と訊こうとして言葉を飲む。" voices=""/>
		<msg @l="391" char_id="-1" frame_id="-1" name="" text="すぐ隣に友達がいるのを思い出したのだ。"
		   voices=""/>
		<char @l="395" id="rei" pos="left" src="rei021"/>
		<msg @l="397" char_id="1" frame_id="-1" name="玲" text="『いいえ、その事とは関係ないわよ。』"
		   voices=""/>
		<msg @l="399" char_id="-1" frame_id="-1" name=""
		   text="先輩は私が言いよどんだ事に気付いたらしく、そう言って笑う。" voices=""/>
		<char @l="402" id="miho" pos="right" src="miho010"/>
		<char @l="406" id="rei" pos="left" src="rei128"/>
		<msg @l="408" char_id="1" frame_id="-1" name="玲"
		   text="『ただなんとなく。‥‥強いて言えば生理的なモノかしら。』" voices=""/>
		<char @l="411" id="miho" pos="right" src="miho116"/>
		<msg @l="413" char_id="0" frame_id="-1" name="美帆" text="『そうですか‥‥。』"
		   voices=""/>
		<stopbgm @l="416" fadeout="1000"/>
		<msg @l="418" char_id="-1" frame_id="-1" name=""
		   text="玲さんは関係ないと言ってくれてはいるのだけれど、少なからずそれがマイナスの印象を与えているのは確かだと思う。" voices=""/>
		<msg @l="419" char_id="-1" frame_id="-1" name=""
		   text="そう考えると‥‥私が先程の言い争いのきっかけを作ったというコトになってしまうのではないだろうか？" voices=""/>
		<msg @l="420" char_id="-1" frame_id="-1" name="" text="なんとなく‥‥立つ瀬がない。"
		   voices=""/>
		<bgm @l="423" src="bgm06" volume="1."/>
		<msg @l="425" char_id="-1" frame_id="-1" name="女友達"
		   text="『あの～‥‥さっきから私だけ話が見えないんですけどぉ。』" voices=""/>
		<char @l="428" id="miho" pos="right" src="miho114"/>
		<msg @l="430" char_id="-1" frame_id="-1" name=""
		   text="妙に沈んでしまった私の様子を見かねてなのか、友達がひょっこりと顔をだして軽い調子で口をはさむ。" voices=""/>
		<msg @l="431" char_id="-1" frame_id="-1" name=""
		   text="いちおう‥‥気を遣ってくれたのかもしれない。" voices=""/>
		<char @l="435" id="rei" pos="left" src="rei014"/>
		<msg @l="437" char_id="1" frame_id="-1" name="玲" text="『あら、こちらは美帆のお友達？』"
		   voices=""/>
		<char @l="441" id="miho" pos="right" src="miho011"/>
		<msg @l="443" char_id="0" frame_id="-1" name="美帆"
		   text="『あ、はい‥‥同じ講義を取ってるんです。』" voices=""/>
		<char @l="447" id="rei" pos="left" src="rei021"/>
		<msg @l="449" char_id="1" frame_id="-1" name="玲" text="『ごめんなさいね、お邪魔しちゃって。』"
		   voices=""/>
		<msg @l="451" char_id="-1" frame_id="-1" name="女友達"
		   text="『いえいえ、全然気にしてませんから。』" voices=""/>
		<char @l="454" id="miho" pos="right" src="miho110"/>
		<char @l="457" id="rei" pos="left" src="rei111"/>
		<msg @l="459" char_id="1" frame_id="-1" name="玲" text="『そう、よかったわ。』"
		   voices=""/>
		<char @l="463" id="rei" pos="left" src="rei110"/>
		<msg @l="465" char_id="1" frame_id="-1" name="玲" text="『美帆は‥‥これから帰り？』"
		   voices=""/>
		<char @l="468" id="miho" pos="right" src="miho010"/>
		<msg @l="470" char_id="0" frame_id="-1" name="美帆" text="『はい。』" voices=""/>
		<char @l="473" id="rei" pos="left" src="rei121"/>
		<msg @l="475" char_id="1" frame_id="-1" name="玲"
		   text="『なら一緒にいきましょうか？&#32;夕飯の買い物も手伝って欲しいし。』" voices=""/>
		<char @l="478" id="miho" pos="right" src="miho011"/>
		<msg @l="480" char_id="0" frame_id="-1" name="美帆" text="『はい、行きます！』"
		   voices=""/>
		<char @l="483" id="rei" pos="left" src="rei110"/>
		<char @l="486" id="miho" pos="right" src="miho013"/>
		<msg @l="488" char_id="0" frame_id="-1" name="美帆" text="『えっと‥‥どうする？一緒に行く？』"
		   voices=""/>
		<msg @l="490" char_id="-1" frame_id="-1" name="" text="私はそう言って友達を見る。"
		   voices=""/>
		<msg @l="492" char_id="-1" frame_id="-1" name="女友達" text="『あ、私はまだ授業があるから。』"
		   voices=""/>
		<char @l="495" id="miho" pos="right" src="miho116"/>
		<msg @l="497" char_id="0" frame_id="-1" name="美帆" text="『そっか、それじゃあここで。』"
		   voices=""/>
		<msg @l="499" char_id="-1" frame_id="-1" name="女友達" text="『おうよ。また月曜日ね。』"
		   voices=""/>
		<char @l="502" id="miho" pos="right" src="miho111"/>
		<msg @l="504" char_id="0" frame_id="-1" name="美帆" text="『ばいばい。』" voices=""/>
		<msg @l="506" char_id="-1" frame_id="-1" name=""
		   text="友達は玲さんに軽く会釈し、教室に戻って行った。" voices=""/>
		<bgm @l="509" src="bgm07" volume="1."/>
		<char @l="513" id="rei" pos="left" src="rei011"/>
		<msg @l="515" char_id="1" frame_id="-1" name="玲" text="『お友達、なかなか良い子じゃない。』"
		   voices=""/>
		<char @l="518" id="miho" pos="right" src="miho016"/>
		<msg @l="520" char_id="0" frame_id="-1" name="美帆" text="『あはは‥‥すっごく強引ですけど。』"
		   voices=""/>
		<char @l="524" id="rei" pos="left" src="rei020"/>
		<msg @l="526" char_id="1" frame_id="-1" name="玲"
		   text="『美帆の友達は、そのくらいで丁度いいわよ。』" voices=""/>
		<char @l="530" id="miho" pos="right" src="miho116"/>
		<msg @l="532" char_id="0" frame_id="-1" name="美帆" text="『そうですかー？』" voices=""/>
		<msg @l="534" char_id="-1" frame_id="-1" name=""
		   text="私は苦笑を浮かべながら、玲さんの横に並んで歩き出す。" voices=""/>
		<char @l="538" id="rei" pos="left" src="rei111"/>
		<msg @l="540" char_id="1" frame_id="-1" name="玲" text="『そうよ。』" voices=""/>
		<msg @l="542" char_id="-1" frame_id="-1" name=""
		   text="玲さんは、頬を膨らませる私を見てくすくすと笑っていた。" voices=""/>
		<stopbgm @l="546" fadeout="1000"/>
		<clear @l="552" class="all"/>
		<msgshow @l="554" show="true"/>
		<wait_chgmv/>
		<bg @l="558" src="bg03b"/>
		<bgm @l="562" src="bgm05" volume="1."/>
		<char @l="566" id="rei" pos="left" src="rei114"/>
		<char @l="570" id="miho" pos="right" src="miho116"/>
		<msg @l="572" char_id="1" frame_id="-1" name="玲" text="『ただいまぁ。』" voices=""/>
		<msg @l="574" char_id="0" frame_id="-1" name="美帆" text="『ふぅ‥‥やっと着きましたね。』"
		   voices=""/>
		<msg @l="576" char_id="-1" frame_id="-1" name=""
		   text="私達は、両手にいっぱいの買い物袋を下げていた。" voices=""/>
		<msg @l="577" char_id="-1" frame_id="-1" name=""
		   text="夕飯の材料だけを買うつもりが、つい洋服やバッグなど色々と見て回ってしまい、結局余分なものまで買ってしまったのだった。"
		   voices=""/>
		<char @l="581" id="rei" pos="left" src="rei128"/>
		<msg @l="583" char_id="1" frame_id="-1" name="玲" text="『あ～‥‥肩、抜けるかと思ったわ。』"
		   voices=""/>
		<char @l="587" id="miho" pos="right" src="miho011"/>
		<msg @l="589" char_id="0" frame_id="-1" name="美帆"
		   text="『でも久々に、ウィンドウショッピングとかも出来て楽しかったです。』" voices=""/>
		<msg @l="591" char_id="-1" frame_id="-1" name=""
		   text="リビングに入ると、床に荷物を置いて一息ついた。" voices=""/>
		<char @l="595" id="miho" pos="right" src="miho111"/>
		<msg @l="597" char_id="0" frame_id="-1" name="美帆"
		   text="『とりあえず、コーヒーでもいれますね。』" voices=""/>
		<char @l="601" id="rei" pos="left" src="rei118"/>
		<msg @l="603" char_id="1" frame_id="-1" name="玲"
		   text="『そうね‥‥片付けは後にして、とりあえず休憩しましょう。』" voices=""/>
		<char @l="607" id="miho" pos="right" src="miho016"/>
		<msg @l="609" char_id="0" frame_id="-1" name="美帆" text="『はい。』" voices=""/>
		<clear @l="613" layer="miho"/>
		<clear @l="615" layer="rei"/>
		<msg @l="617" char_id="-1" frame_id="-1" name=""
		   text="私は苦笑を浮かべながら‥‥キッチンへと向かった。" voices=""/>
		<msg @l="618" char_id="-1" frame_id="-1" name=""
		   text="食器棚からコーヒーメーカーを取り出し、スイッチを入れた。" voices=""/>
		<msg @l="619" char_id="-1" frame_id="-1" name="" text="あとは出来上がるのを待つだけである。"
		   voices=""/>
		<char @l="623" id="rei" pos="left" src="rei123"/>
		<msg @l="625" char_id="0" frame_id="-1" name="美帆" text="『玲さん、いまセットしましたから～。』"
		   voices=""/>
		<msg @l="628" char_id="1" frame_id="-1" name="玲" text="『‥‥‥‥。』" voices=""/>
		<msg @l="630" char_id="0" frame_id="-1" name="美帆" text="『‥‥玲さん？』" voices=""/>
		<msg @l="632" char_id="-1" frame_id="-1" name=""
		   text="キッチンからリビングを覗くと、玲さんが郵便受けから持ってきた封筒をじっと見ていた。" voices=""/>
		<char @l="636" id="miho" pos="right" src="miho110"/>
		<msg @l="638" char_id="0" frame_id="-1" name="美帆" text="『玲さん、どうかしたんですか？』"
		   voices=""/>
		<char @l="642" id="rei" pos="left" src="rei124"/>
		<msg @l="644" char_id="1" frame_id="-1" name="玲" text="『あ、ごめんなさい。』"
		   voices=""/>
		<char @l="648" id="rei" pos="left" src="rei010"/>
		<msg @l="650" char_id="1" frame_id="-1" name="玲"
		   text="『昨日話してた大黒建設から、手紙が来てたの。』" voices=""/>
		<stopbgm @l="654" fadeout="1000"/>
		<char @l="657" id="miho" pos="right" src="miho014"/>
		<msg @l="659" char_id="0" frame_id="-1" name="美帆" text="『合否通知のですか？』"
		   voices=""/>
		<msg @l="661" char_id="1" frame_id="-1" name="玲" text="『たぶんね。』" voices=""/>
		<msg @l="663" char_id="-1" frame_id="-1" name=""
		   text="そう言って彼女は封筒を開け、中から紙を取り出した。" voices=""/>
		<char @l="667" id="miho" pos="right" src="miho116"/>
		<msg @l="669" char_id="0" frame_id="-1" name="美帆" text="『どうですか‥‥？』"
		   voices=""/>
		<msg @l="671" char_id="1" frame_id="-1" name="玲"
		   text="『えーと‥‥先日、弊社にて行いました筆記試験におきまして、合格しました事をお知らせ致します。』" voices=""/>
		<char @l="674" id="rei" pos="left" src="rei013"/>
		<msg @l="676" char_id="1" frame_id="-1" name="玲"
		   text="『つきましては面接を実施しますので、本書と同封されております証明書をご持参の上、ご来社下さい。』" voices=""/>
		<msg @l="678" char_id="1" frame_id="-1" name="玲" text="『‥‥だって。』" voices=""/>
		<bgm @l="682" src="bgm02" volume="1."/>
		<char @l="686" id="miho" pos="right" src="miho011"/>
		<msg @l="688" char_id="0" frame_id="-1" name="美帆" text="『すごい、合格ですよっ！』"
		   voices=""/>
		<char @l="692" id="rei" pos="left" src="rei021"/>
		<msg @l="694" char_id="1" frame_id="-1" name="玲" text="『ありがと。』" voices=""/>
		<char @l="698" id="rei" pos="left" src="rei118"/>
		<msg @l="700" char_id="1" frame_id="-1" name="玲"
		   text="『まぁ、まだ筆記試験だけだからね。大変なのはこれからよ。』" voices=""/>
		<char @l="703" id="miho" pos="right" src="miho111"/>
		<msg @l="705" char_id="0" frame_id="-1" name="美帆"
		   text="『でも、取り敢えずは一歩先に進むことができたましたね。』" voices=""/>
		<char @l="708" id="rei" pos="left" src="rei021"/>
		<msg @l="710" char_id="1" frame_id="-1" name="玲"
		   text="『そうね。そこは素直に喜んでもバチは当たらないかしら。』" voices=""/>
		<msg @l="712" char_id="0" frame_id="-1" name="美帆" text="『そうですよ。』" voices=""/>
		<char @l="715" id="miho" pos="right" src="miho011"/>
		<msg @l="717" char_id="0" frame_id="-1" name="美帆"
		   text="『じゃあ、今日はお祝いに私が腕によりをかけて美味しいご飯を作っちゃいますね。』" voices=""/>
		<char @l="721" id="rei" pos="left" src="rei111"/>
		<msg @l="723" char_id="1" frame_id="-1" name="玲" text="『あら、それじゃあ甘えちゃおうかしら。』"
		   voices=""/>
		<char @l="726" id="miho" pos="right" src="miho013"/>
		<msg @l="728" char_id="0" frame_id="-1" name="美帆" text="『まかせてください！』"
		   voices=""/>
		<stopbgm @l="732" fadeout="1000"/>
		<clear @l="738" class="all"/>
		<bgm @l="742" src="bgm05" volume="1."/>
		<wait_chgmv/>
		<bg @l="746" src="bg03b"/>
		<char @l="750" id="rei" pos="auto" src="rei031"/>
		<msg @l="752" char_id="1" frame_id="-1" name="玲" text="『ごちそうさま。』" voices=""/>
		<clear @l="755" class="char"/>
		<char @l="757" id="rei" pos="left" src="rei031"/>
		<char @l="760" id="miho" pos="right" src="miho031"/>
		<msg @l="762" char_id="0" frame_id="-1" name="美帆" text="『はい、お粗末さまでした。』"
		   voices=""/>
		<msg @l="764" char_id="-1" frame_id="-1" name=""
		   text="夕食が終わり、私は空いた皿をキッチンへ運んでいく。" voices=""/>
		<msg @l="765" char_id="-1" frame_id="-1" name=""
		   text="今日のメニューは美帆の特製オムレツと鶏肉のソテー、それからコンソメスープと生野菜サラダと‥‥お祝いにしては少し簡素な内容であっただろうか。"
		   voices=""/>
		<msg @l="766" char_id="-1" frame_id="-1" name=""
		   text="とはいえお祝いを前提に買ってきた材料ではなかったので、これでも精一杯がんばった方だと思う。" voices=""/>
		<char @l="770" id="miho" pos="right" src="miho034"/>
		<msg @l="772" char_id="0" frame_id="-1" name="美帆"
		   text="『そういえば、次の面接っていつなんですか？』" voices=""/>
		<char @l="775" id="rei" pos="left" src="rei030"/>
		<msg @l="777" char_id="1" frame_id="-1" name="玲" text="『月曜日のお昼からだそうよ。』"
		   voices=""/>
		<char @l="780" id="miho" pos="right" src="miho134"/>
		<msg @l="782" char_id="0" frame_id="-1" name="美帆" text="『ずいぶんと急なタイミングですね？』"
		   voices=""/>
		<char @l="786" id="rei" pos="left" src="rei031"/>
		<msg @l="788" char_id="1" frame_id="-1" name="玲"
		   text="『そうね‥‥でもまあ、何週間も待たされるよりはマシじゃないかしら。』" voices=""/>
		<char @l="792" id="miho" pos="right" src="miho031"/>
		<msg @l="794" char_id="0" frame_id="-1" name="美帆" text="『あはは‥‥それもそうですね。』"
		   voices=""/>
		<char @l="798" id="rei" pos="left" src="rei030"/>
		<msg @l="800" char_id="1" frame_id="-1" name="玲"
		   text="『大手の企業を相手にする場合なんていつもそんな感じよ。』" voices=""/>
		<char @l="803" id="rei" pos="left" src="rei031"/>
		<msg @l="805" char_id="1" frame_id="-1" name="玲"
		   text="『試験をしてから一週間足らずで返事が来るなんて早い方だわ。』" voices=""/>
		<char @l="809" id="miho" pos="right" src="miho031"/>
		<msg @l="811" char_id="0" frame_id="-1" name="美帆"
		   text="『それだけ期待されてるって事じゃないですか？』" voices=""/>
		<char @l="814" id="rei" pos="left" src="rei033"/>
		<msg @l="816" char_id="1" frame_id="-1" name="玲" text="『だとしたら嬉しいけど。』"
		   voices=""/>
		<char @l="819" id="rei" pos="left" src="rei030"/>
		<msg @l="821" char_id="1" frame_id="-1" name="玲"
		   text="『‥‥でも、結果自体はもっと前に出ていたみたいなのよね。』" voices=""/>
		<stopbgm @l="825" fadeout="1000"/>
		<char @l="829" id="miho" pos="right" src="miho034"/>
		<msg @l="831" char_id="0" frame_id="-1" name="美帆" text="『え‥‥？』" voices=""/>
		<char @l="835" id="rei" pos="left" src="rei031"/>
		<msg @l="837" char_id="1" frame_id="-1" name="玲" text="『あ、ううん‥‥なんでもないわ。』"
		   voices=""/>
		<char @l="841" id="rei" pos="left" src="rei030"/>
		<msg @l="843" char_id="1" frame_id="-1" name="玲"
		   text="『それより、お風呂入りたいんだけど‥‥先にいいかしら？』" voices=""/>
		<char @l="847" id="miho" pos="right" src="miho131"/>
		<msg @l="849" char_id="0" frame_id="-1" name="美帆"
		   text="『いいですよ。私は洗い物がありますから。』" voices=""/>
		<char @l="852" id="rei" pos="left" src="rei031"/>
		<msg @l="854" char_id="1" frame_id="-1" name="玲" text="『ありがと、それじゃあ先に頂くわね。』"
		   voices=""/>
		<clear @l="858" layer="rei"/>
		<msg @l="860" char_id="-1" frame_id="-1" name=""
		   text="そう言うと玲さんは自分の部屋に着替えをとりに向かった。" voices=""/>
		<char @l="864" id="miho" pos="right" src="miho034"/>
		<bgm @l="867" src="bgm03" volume="1."/>
		<msg @l="869" char_id="0" frame_id="-1" name="美帆" text="『あれ‥‥？』" voices=""/>
		<clear @l="873" layer="miho"/>
		<msg @l="875" char_id="-1" frame_id="-1" name=""
		   text="リビングテーブルの脇に何かが落ちていることに気付いて拾い上げる。" voices=""/>
		<msg @l="876" char_id="-1" frame_id="-1" name=""
		   text="それは先程見ていた、大黒建設の面接合否通知書だった。" voices=""/>
		<msg @l="877" char_id="-1" frame_id="-1" name=""
		   text="部屋に持っていく際に、中の手紙だけ落として行ってしまったようだ。" voices=""/>
		<msg @l="879" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="881" char_id="0" frame_id="-1" name="美帆"
		   text="『朽木教授と話してたのって‥‥やっぱりこれのことだったのかな。』" voices=""/>
		<msg @l="883" char_id="-1" frame_id="-1" name=""
		   text="私は、昼間大学の廊下で言い争いをしていた二人の会話を思い出す。" voices=""/>
		<msg @l="884" char_id="-1" frame_id="-1" name=""
		   text="情報がどうとか合否がどうとか、確かそんな事を話していた。" voices=""/>
		<msg @l="885" char_id="-1" frame_id="-1" name="" text="そして‥‥先ほどの先輩の呟き。"
		   voices=""/>
		<msg @l="886" char_id="-1" frame_id="-1" name=""
		   text="やはりあの時話していた内容は、この手紙に書かれている事についてなのではないかと思えてしまう。" voices=""/>
		<msg @l="888" char_id="0" frame_id="-1" name="美帆"
		   text="『なんて‥‥私が心配しても仕方ないことなのかな‥‥‥。』" voices=""/>
		<msg @l="890" char_id="-1" frame_id="-1" name=""
		   text="それに私が朽木教授に良くない感情を抱いているから、ネガティブな考えが浮かんでしまうだけで、本当は些細な事なのかもしれない。"
		   voices=""/>
		<char @l="893" id="miho" pos="auto" src="miho030"/>
		<msg @l="895" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<char @l="898" id="miho" pos="auto" src="miho036"/>
		<bgm @l="900" src="bgm02" volume="1."/>
		<msg @l="902" char_id="0" frame_id="-1" name="美帆"
		   text="『とりあえず‥‥今はこの子たちを片付けちゃわないと。』" voices=""/>
		<msg @l="904" char_id="-1" frame_id="-1" name=""
		   text="流しに並んだ食器を見ながら、私は自分に言い聞かせるようにつぶやいた。" voices=""/>
		<stopbgm @l="908" fadeout="1000"/>
		<clear @l="914" class="all"/>
		<call @l="918" target="EventLabel_131@root_rei02"/>
		<return @l="919" value="0&#13;&#10;"/>
		<return @l="923" value=""/>
	</code>
</xscript>
