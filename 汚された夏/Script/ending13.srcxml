<?xml version="1.0" encoding="utf-8"?>
<xscript>
	<debug editor="&quot;C:\Program&#32;Files&#32;(x86)\sakura\sakura.exe&quot;&#32;&quot;%src%&quot;&#32;-Y=%line%"
	   src="D:\シロップ\町ぐるみの罠＋汚された夏セット版\汚された夏\完成データ\汚された夏\script\text\ending13.txt"/>
	<code>
		<label @l="12" id="EventLabel_51"/>
		<description @l="16" text="そして‥‥"/>
		<eval @l="18" expr="f.numDay=0&#13;&#10;"/>
		<msg @l="20" char_id="-1" frame_id="-1" name="" text="‥‥‥‥‥‥‥‥‥‥‥‥‥‥。"
		   voices=""/>
		<msg @l="21" char_id="-1" frame_id="-1" name="" text="‥‥‥‥‥‥‥‥‥‥。" voices=""/>
		<msg @l="22" char_id="-1" frame_id="-1" name="" text="‥‥‥‥‥‥。" voices=""/>
		<label @l="26" id="chart_line73"/>
		<wait_chgmv/>
		<ev @l="30" src="ev-060"/>
		<bgm @l="35" src="bgm02" volume="1."/>
		<msg @l="37" char_id="0" frame_id="-1" name="美帆" text="『ん～～～‥‥‥‥あふっ。』"
		   voices="miho13380"/>
		<msg @l="39" char_id="-1" frame_id="-1" name=""
		   text="正門を出てメインストリートに出ると、私は小さく背伸びをする。" voices=""/>
		<msg @l="40" char_id="-1" frame_id="-1" name=""
		   text="今日は一限からずっと講義に出ずっぱりだったので、少し腰が痛い。" voices=""/>
		<msg @l="42" char_id="0" frame_id="-1" name="美帆"
		   text="『もう９月だっていうのに‥‥‥まだまだ暑いなぁ。』" voices="miho13390"/>
		<msg @l="44" char_id="-1" frame_id="-1" name=""
		   text="茜色に染まった通学路を歩きながら、私は西の空を仰ぐように見る。" voices=""/>
		<msg @l="45" char_id="-1" frame_id="-1" name=""
		   text="あの忌まわしい日々から‥‥既に３ヵ月が経っていた。" voices=""/>
		<msg @l="46" char_id="-1" frame_id="-1" name=""
		   text="南総町から無事に離れることの出来た私は、実家のある町に戻って近郊の私立大学へと編入手続きを取った。" voices=""/>
		<msg @l="47" char_id="-1" frame_id="-1" name=""
		   text="とはいえ夏休みを挟んでしまっていたので、実際に通いはじめたのはほんの二週間ほど前の話である。" voices=""/>
		<msg @l="48" char_id="-1" frame_id="-1" name=""
		   text="正直‥‥あの町から戻ってきてすぐの私は、何も手につかない状態だった。" voices=""/>
		<msg @l="49" char_id="-1" frame_id="-1" name=""
		   text="私の傷ついた心も、家族や妹の亜季奈の応援に後押しされるように次第に快復の一途をたどり‥‥今では支障なく日常の生活が送れるまでになっていた。"
		   voices=""/>
		<msg @l="51" char_id="0" frame_id="-1" name="美帆"
		   text="(そういえば‥‥‥玲さん、どうしてるかな？)" voices=""/>
		<msg @l="53" char_id="-1" frame_id="-1" name=""
		   text="新しい大学に編入が決まってすぐ、何度か玲さんに向けて手紙を出したのだけれど、一度だけしか返事は戻って来なかった。" voices=""/>
		<msg @l="54" char_id="-1" frame_id="-1" name=""
		   text="玲さんもまた、心の傷を癒す為に自分の内のトラウマと戦っているらしい。" voices=""/>
		<msg @l="55" char_id="-1" frame_id="-1" name=""
		   text="あの時、玲さんが身を呈して逃がしてくれなければ、私は今も南総町で苦難の日々を送っていたかもしれない。" voices=""/>
		<msg @l="56" char_id="-1" frame_id="-1" name=""
		   text="そう思うと‥‥幾ら感謝してもし足りないくらいである。" voices=""/>
		<msg @l="58" char_id="0" frame_id="-1" name="美帆"
		   text="『今日は‥‥寄り道せずに真っ直ぐ帰ろうかな。』" voices="miho13420"/>
		<msg @l="60" char_id="-1" frame_id="-1" name="女友達Ａ" text="『美帆～。』" voices=""/>
		<msg @l="62" char_id="-1" frame_id="-1" name="女友達Ｂ"
		   text="『これからパフェ食べにいくけど、美帆もどう？』" voices=""/>
		<msg @l="64" char_id="-1" frame_id="-1" name="" text="講義友達の子が私を見つけて声をかけてくる。"
		   voices=""/>
		<msg @l="65" char_id="-1" frame_id="-1" name=""
		   text="そう、なんとこの二週間で一気に二人も友達ができてしまった。" voices=""/>
		<msg @l="66" char_id="-1" frame_id="-1" name=""
		   text="人見知りな私にしてみれば快挙とも言えるスピードである。" voices=""/>
		<msg @l="68" char_id="-1" frame_id="-1" name="女友達Ａ"
		   text="『駅前の喫茶店がね、先取りで秋メニュー始めたんだって。』" voices=""/>
		<msg @l="70" char_id="-1" frame_id="-1" name="女友達Ｂ"
		   text="『マロンたっぷりのジャンボパフェだよぉ‥‥‥当然、美帆もいくでしょ？』" voices=""/>
		<msg @l="72" char_id="0" frame_id="-1" name="美帆" text="『ん～、そうだなぁ‥‥。』"
		   voices="miho13430"/>
		<msg @l="74" char_id="-1" frame_id="-1" name=""
		   text="迷ってるような言葉をつぶやきながら、実は私の心はもう決まっていた。" voices=""/>
		<msg @l="75" char_id="-1" frame_id="-1" name=""
		   text="つい先程まで早く帰ろうと考えていたんだけど、今の私はもう甘さ控えめのマロンパフェに舌鼓をうつことで頭がいっぱいになっている。"
		   voices=""/>
		<msg @l="77" char_id="0" frame_id="-1" name="美帆"
		   text="(帰りにショートケーキ買っていってあげよう)" voices="miho13440"/>
		<msg @l="79" char_id="0" frame_id="-1" name="美帆" text="(亜季奈‥‥きっと大喜びするだろうなぁ)"
		   voices="miho13450"/>
		<msg @l="81" char_id="-1" frame_id="-1" name=""
		   text="そうしてなんでもない日常が今日も明日も過ぎ去っていく。" voices=""/>
		<msg @l="82" char_id="-1" frame_id="-1" name=""
		   text="私は‥‥そんな緩やかな日々が戻ってきた事に、心からの笑みを浮かべずにはいられなかった――――。" voices=""/>
		<stopbgm @l="86" fadeout="1000"/>
		<begin_trans @l="92" time="500"/>
		<clear @l="93" layer="cutin_f"/>
		<clear @l="94" layer="cutin"/>
		<end_trans @l="95"/>
		<clear @l="97" class="char"/>
		<msgshow @l="99" show="false"/>
		<wait_chgmv/>
		<bg @l="101" src="white" time="10000"/>
		<clear @l="103" class="ev"/>
		<wait_chgmv/>
		<bg @l="105" src="white"/>
		<eval @l="124" expr="s.flagGallery=1&#13;&#10;"/>
		<eval @l="127" expr="f.b&#32;=&#32;(s.event60flag&#32;==&#32;0)&#13;&#10;"/>
		<eval @l="129" expr="s.event60flag=1&#13;&#10;"/>
		<ending @l="133"/>
		<goto @l="135" cond="!(f.b)&#13;&#10;" label="TempLabel_295"/>
		<wait_chgmv/>
		<bg @l="139" src="newroot"/>
		<wait @l="141" time="5000"/>
		<wait_chgmv/>
		<bg @l="143" src="black"/>
		<label @l="146" id="TempLabel_295"/>
		<return @l="150" value=""/>
	</code>
</xscript>
