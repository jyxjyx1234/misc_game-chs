<?xml version="1.0" encoding="utf-8"?>
<xscript>
	<debug editor="&quot;C:\Program&#32;Files&#32;(x86)\sakura\sakura.exe&quot;&#32;&quot;%src%&quot;&#32;-Y=%line%"
	   src="D:\シロップ\町ぐるみの罠＋汚された夏セット版\汚された夏\完成データ\汚された夏\script\text\root_kutuki05c.txt"/>
	<code>
		<label @l="10" id="EventLabel_129"/>
		<description @l="13" text="契約の日々・４日目"/>
		<eval @l="15" expr="f.numDay=10&#13;&#10;"/>
		<msgshow @l="17" show="false"/>
		<wait_chgmv/>
		<bg @l="19" src="day10" time="2000"/>
		<wait @l="21" time="500"/>
		<wait_chgmv/>
		<bg @l="23" src="black" time="2000"/>
		<msgshow @l="25" show="true"/>
		<bgm @l="28" src="bgm03" volume="1."/>
		<wait_chgmv/>
		<bg @l="31" src="bg05"/>
		<char @l="34" id="miho" pos="auto" src="miho116"/>
		<msg @l="36" char_id="0" frame_id="-1" name="美帆" text="『行って来ます‥‥。』"
		   voices=""/>
		<msg @l="38" char_id="-1" frame_id="-1" name=""
		   text="玄関の外から、部屋の奥に向かって小声で言葉をかける私。" voices=""/>
		<msg @l="39" char_id="-1" frame_id="-1" name="" text="それから静かに扉を閉めて‥‥‥鍵を掛ける。"
		   voices=""/>
		<msg @l="40" char_id="-1" frame_id="-1" name=""
		   text="寝るのが遅かったのだろうか、私が家を出る時間になっても先輩はまだ眠っていたから、仕方なく朝食の用意だけ済ませて出かけることにした。"
		   voices=""/>
		<msg @l="42" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="44" char_id="0" frame_id="-1" name="美帆" text="『‥‥きっと今日も。』"
		   voices=""/>
		<msg @l="46" char_id="-1" frame_id="-1" name="" text="閉めた扉を見つめながら私はそっとつぶやく。"
		   voices=""/>
		<msg @l="47" char_id="-1" frame_id="-1" name=""
		   text="電車に乗れば‥‥朽木教授が私の身体を貪る為に待っている。" voices=""/>
		<msg @l="48" char_id="-1" frame_id="-1" name=""
		   text="それがわかっているのに、私は今日もそこへ向かわなければならない。" voices=""/>
		<msg @l="49" char_id="-1" frame_id="-1" name="" text="父の為に‥‥家族を救う為に。"
		   voices=""/>
		<clear @l="52" class="all"/>
		<wait_chgmv/>
		<bg @l="55" src="bg18m1"/>
		<char @l="58" id="miho" pos="auto" src="miho116"/>
		<msg @l="60" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="62" char_id="-1" frame_id="-1" name=""
		   text="駅前に差し掛かり、人の流れに四苦八苦しながら停留所へ向かう。" voices=""/>
		<msg @l="64" char_id="0" frame_id="-1" name="美帆"
		   text="(電車、もう来てるみたい‥‥‥‥急がなきゃ)" voices=""/>
		<msg @l="66" char_id="-1" frame_id="-1" name="" text="私は足早に停留所へと向かった。"
		   voices=""/>
		<clear @l="69" class="all"/>
		<label @l="72" id="event_scene11"/>
		<se @l="75" buf="3" loop="true" src="電車走行中" volume="1."/>
		<wait_chgmv/>
		<ev @l="78" src="ev-005"/>
		<msg @l="80" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』"
		   voices="miho09860"/>
		<msg @l="82" char_id="-1" frame_id="-1" name="" text="いつもの時間、いつもの電車、いつもの場所。"
		   voices=""/>
		<msg @l="83" char_id="-1" frame_id="-1" name=""
		   text="見慣れたその空間に私は今日も身を寄せている。" voices=""/>
		<msg @l="84" char_id="-1" frame_id="-1" name="" text="何も変わらない毎日が欲しかった。"
		   voices=""/>
		<msg @l="85" char_id="-1" frame_id="-1" name="" text="何も変わらない退屈が欲しかった。"
		   voices=""/>
		<msg @l="86" char_id="-1" frame_id="-1" name=""
		   text="窓の外の過ぎ行く景色を眺めながら‥‥私は少しだけ思う。" voices=""/>
		<msg @l="88" char_id="0" frame_id="-1" name="美帆" text="(でも‥‥もう、戻れない)"
		   voices="miho09870"/>
		<msg @l="90" char_id="-1" frame_id="-1" name="声"
		   text="『キミは日を追うごとに良い顔をするようになるな。』" voices=""/>
		<msg @l="92" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』"
		   voices="miho09880"/>
		<msg @l="94" char_id="-1" frame_id="-1" name="" text="私はもうその言葉に驚かない。"
		   voices=""/>
		<msg @l="95" char_id="-1" frame_id="-1" name="" text="窓に‥‥教授の姿が映っていた。"
		   voices=""/>
		<wait_chgmv/>
		<ev @l="98" src="ev-005ax1"/>
		<msg @l="100" char_id="-1" frame_id="-1" name="朽木"
		   text="『憔悴しているようだな。ちゃんと眠っているかね？』" voices=""/>
		<msg @l="102" char_id="-1" frame_id="-1" name=""
		   text="おどけたように、教授は私の耳元へ囁きかけてくる。" voices=""/>
		<msg @l="103" char_id="-1" frame_id="-1" name="" text="ちゃんと眠っているか？"
		   voices=""/>
		<msg @l="104" char_id="-1" frame_id="-1" name=""
		   text="私の身体を嬲っているのに、よくそんな事を‥‥‥。" voices=""/>
		<msg @l="106" char_id="0" frame_id="-1" name="美帆" text="『アナタが‥‥‥‥そんな事を。』"
		   voices="miho09890"/>
		<msg @l="108" char_id="-1" frame_id="-1" name="朽木"
		   text="『それ程に辛いのならば私の愛人となりたまえ。心も身体も全て私に捧げたまえ。』" voices=""/>
		<msg @l="110" char_id="-1" frame_id="-1" name="朽木"
		   text="『そうすれば‥‥今のように苦しむ事も無くなるだろうに。』" voices=""/>
		<msg @l="112" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』"
		   voices="miho09900"/>
		<msg @l="114" char_id="-1" frame_id="-1" name="朽木"
		   text="『ふん、まぁいい。愛人にならぬと言うのであれば、その身体のみを好きなように嬲らせてもらおう。』" voices=""/>
		<bgm @l="118" src="bgm14" volume="1."/>
		<wait_chgmv/>
		<ev @l="121" src="ev-005ax3y2"/>
		<msg @l="123" char_id="-1" frame_id="-1" name=""
		   text="そうして、教授はスカートの裾から手を入れて割れ目に指先を這わせる。" voices=""/>
		<msg @l="124" char_id="-1" frame_id="-1" name="" text="心なしか‥‥彼は苛立っている。"
		   voices=""/>
		<msg @l="125" char_id="-1" frame_id="-1" name="" text="私が彼の言葉に従わないからだろうか？"
		   voices=""/>
		<msg @l="127" char_id="0" frame_id="-1" name="美帆" text="『んくっ‥‥。』"
		   voices="miho09910"/>
		<msg @l="129" char_id="-1" frame_id="-1" name=""
		   text="教授の指が下着の上からクリ○リスを擦りつける。" voices=""/>
		<msg @l="130" char_id="-1" frame_id="-1" name=""
		   text="これまでよりも幾らか乱暴な感じではあったけれど、その動きは毎日続けられる痴漢行為の感覚を思い出させた。" voices=""/>
		<msg @l="132" char_id="-1" frame_id="-1" name="朽木"
		   text="『さあ、私の前で歓喜の声をあげて泣きたまえ。』" voices=""/>
		<msg @l="134" char_id="-1" frame_id="-1" name="朽木"
		   text="『屈辱と愉悦の中で‥‥‥キミが守っている心とやらを壊してやる。』" voices=""/>
		<msg @l="136" char_id="0" frame_id="-1" name="美帆" text="『ん、あくっ‥‥。』"
		   voices="miho09920"/>
		<msg @l="138" char_id="-1" frame_id="-1" name=""
		   text="親指で紅い突起を爪弾きながら、残りの指が割れ目を擦り上げてくる。" voices=""/>
		<msg @l="140" char_id="-1" frame_id="-1" name="朽木"
		   text="『おや、キミのここはもう潤み始めたのではないかね？』" voices=""/>
		<msg @l="142" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥っ‥‥‥。』"
		   voices="miho09930"/>
		<msg @l="144" char_id="-1" frame_id="-1" name=""
		   text="閉じている肉びらを開き、コリコリと秘芯を転がしながら、教授は私の耳朶に歯を立てる。" voices=""/>
		<msg @l="145" char_id="-1" frame_id="-1" name=""
		   text="私のそこは朽木教授の言うとおり既に潤いを帯び始めている。" voices=""/>
		<msg @l="146" char_id="-1" frame_id="-1" name=""
		   text="そして‥‥彼のいじめるような言葉が、私の身体をさらに熱くしてゆく。" voices=""/>
		<msg @l="148" char_id="0" frame_id="-1" name="美帆"
		   text="(うそ‥‥‥こんなので、感じちゃうなんて‥‥‥‥‥‥)" voices="miho09940"/>
		<msg @l="150" char_id="-1" frame_id="-1" name=""
		   text="熱いモノが身体の奥から滲み出しているのがわかった。" voices=""/>
		<msg @l="151" char_id="-1" frame_id="-1" name=""
		   text="それは徐々に私の胎内を伝い落ちて‥‥‥下着に大きな染みを作る。" voices=""/>
		<msg @l="153" char_id="-1" frame_id="-1" name="朽木" text="『くくっ‥‥これはまた大量だな。』"
		   voices=""/>
		<msg @l="155" char_id="-1" frame_id="-1" name=""
		   text="卑猥な粘膜の糸をひいて指先に絡む蜜を私に見せつけながら、教授が笑う。" voices=""/>
		<msg @l="157" char_id="0" frame_id="-1" name="美帆"
		   text="(どうしてこんな‥‥‥、嫌なのに‥‥‥‥嫌なハズなのに)" voices="miho09950"/>
		<msg @l="159" char_id="-1" frame_id="-1" name=""
		   text="太腿にまで伝い落ちてくるほどの淫汁を秘部に感じながら、私は度重なる痴漢によって変わってしまった身体をうらめしく思っていた。"
		   voices=""/>
		<clear @l="162" class="all"/>
		<msg @l="164" char_id="-1" frame_id="-1" name="朽木"
		   text="『これだけ濡れていれば問題あるまい。』" voices=""/>
		<msg @l="166" char_id="-1" frame_id="-1" name=""
		   text="そう言って、教授はスカートの下で指先を蠢かせてショーツを強引に引き下ろす。" voices=""/>
		<msg @l="168" char_id="0" frame_id="-1" name="美帆" text="『え‥‥な、何を‥‥‥？』"
		   voices="miho09960"/>
		<msg @l="170" char_id="-1" frame_id="-1" name="朽木" text="『久々に味あわせてもらおうか。』"
		   voices=""/>
		<msg @l="172" char_id="0" frame_id="-1" name="美帆" text="『‥‥！？』"
		   voices="miho09970"/>
		<msg @l="174" char_id="-1" frame_id="-1" name=""
		   text="教授はそう言って私の腰を強く引き寄せると、いつの間にか露になっていた熱い塊を割れ目の入り口へ押し当てる。" voices=""/>
		<msg @l="175" char_id="-1" frame_id="-1" name=""
		   text="‥‥間違いなく、それは教授の勃起した肉棒である。" voices=""/>
		<msg @l="177" char_id="0" frame_id="-1" name="美帆" text="『ま、待ってください‥‥‥それはっ！』"
		   voices="miho09980"/>
		<msg @l="179" char_id="-1" frame_id="-1" name="朽木" text="『私が待つと思うかね？』"
		   voices=""/>
		<clear @l="182" class="all"/>
		<label @l="192" id="chart_line47"/>
		<wait_chgmv/>
		<ev @l="195" src="ev-011"/>
		<description @l="198" text="白濁色の洗礼"/>
		<msg @l="200" char_id="0" frame_id="-1" name="美帆" text="『んんっっ！』"
		   voices="miho09990"/>
		<msg @l="202" char_id="-1" frame_id="-1" name="" text="一気に‥‥教授のモノが私の胎内を貫いた。"
		   voices=""/>
		<msg @l="203" char_id="-1" frame_id="-1" name=""
		   text="膣内奥深くを無理やり押し広げて侵入してくるそれの感触に、私は思わず苦痛の声を漏らす。" voices=""/>
		<msg @l="205" char_id="-1" frame_id="-1" name="朽木"
		   text="『おおっ‥‥‥キミのここは相変わらず狭くキツイな。』" voices=""/>
		<msg @l="207" char_id="0" frame_id="-1" name="美帆"
		   text="『う、ああっ‥‥‥や‥‥‥あ、抜いてください‥‥‥‥‥。』" voices="miho10000"/>
		<msg @l="209" char_id="-1" frame_id="-1" name="朽木" text="『抜いてください？困った子だな。』"
		   voices=""/>
		<flash @l="212" count="4" fade="100" image="white"/>
		<se @l="215" buf="1" src="尻を叩く" volume="1."/>
		<msg @l="217" char_id="-1" frame_id="-1" name=""
		   text="朽木はいきなり私の臀部をパチンと平手打ちで叩いた。" voices=""/>
		<msg @l="218" char_id="-1" frame_id="-1" name="" text="小気味いい音が車内中に響く。"
		   voices=""/>
		<msg @l="220" char_id="0" frame_id="-1" name="美帆" text="『‥‥！？』"
		   voices="miho10040"/>
		<msg @l="222" char_id="-1" frame_id="-1" name="朽木"
		   text="『ククク‥‥。まわりに聞こえてしまうかもしれんよ。』" voices=""/>
		<flash @l="225" count="4" fade="100" image="white"/>
		<se @l="228" buf="1" src="尻を叩く" volume="1."/>
		<msg @l="230" char_id="-1" frame_id="-1" name="" text="パチン！" voices=""/>
		<msg @l="231" char_id="-1" frame_id="-1" name="" text="また、小気味いい音が響き渡る。"
		   voices=""/>
		<msg @l="232" char_id="-1" frame_id="-1" name=""
		   text="私は恥ずかしさと悔しさから、ぐっと前歯で唇を噛み、言葉を押し殺した。" voices=""/>
		<msg @l="234" char_id="-1" frame_id="-1" name="朽木" text="『それでいいんだよ。それで。』"
		   voices=""/>
		<msg @l="236" char_id="-1" frame_id="-1" name=""
		   text="満足したように教授は呟くと、私の大事な処女を奪った憎い教授の分身をズンズンと肉孔の中にめり込んでいく。" voices=""/>
		<msg @l="238" char_id="-1" frame_id="-1" name="朽木"
		   text="『なに、苦しいのは馴染むまでだ。すぐに気持ち良くなる。』" voices=""/>
		<msg @l="240" char_id="-1" frame_id="-1" name=""
		   text="教授はそう言って笑うと、ゆっくりと腰を前後に律動させる。" voices=""/>
		<msg @l="241" char_id="-1" frame_id="-1" name=""
		   text="身体の中をかき乱す鈍痛に、スベスベの白い肌からじわりと汗が噴き出てきた。" voices=""/>
		<msg @l="242" char_id="-1" frame_id="-1" name="朽木"
		   text="『おおっ‥‥‥キミのここは相変わらず狭くキツイな。』" voices=""/>
		<msg @l="244" char_id="0" frame_id="-1" name="美帆" text="『ん‥‥あくっ！』"
		   voices="miho10010"/>
		<msg @l="246" char_id="-1" frame_id="-1" name=""
		   text="太い男根が胎内を行き来するたび、肉ヒダを引き摺られるような激しい摩擦感が私の身体を襲う。" voices=""/>
		<msg @l="247" char_id="-1" frame_id="-1" name=""
		   text="そのたびに全神経を麻痺させるような激痛が脳をピリピリと襲撃してくる。" voices=""/>
		<msg @l="249" char_id="0" frame_id="-1" name="美帆"
		   text="『ま、待ってください‥‥‥もう少し優しく‥‥‥‥。』" voices="miho10020"/>
		<msg @l="251" char_id="-1" frame_id="-1" name="朽木"
		   text="『優しく？&#32;そんな事を言っている場合かね？』" voices=""/>
		<msg @l="253" char_id="0" frame_id="-1" name="美帆" text="『え‥‥。』"
		   voices="miho10030"/>
		<msg @l="255" char_id="-1" frame_id="-1" name="朽木"
		   text="『ほら、周囲を見たまえ‥‥皆キミの痴態を楽しげに見ているぞ。』" voices=""/>
		<msg @l="257" char_id="0" frame_id="-1" name="美帆" text="『‥‥！？』"
		   voices="miho10040"/>
		<msg @l="259" char_id="-1" frame_id="-1" name=""
		   text="彼の言葉に慌てて周囲を見回すと、確かに目に付く誰もが私と教授を見て楽しげに笑っている。" voices=""/>
		<msg @l="260" char_id="-1" frame_id="-1" name=""
		   text="それに‥‥気付けばこの車両には女性が一人もいない。" voices=""/>
		<msg @l="262" char_id="0" frame_id="-1" name="美帆" text="『ど、どうしてっ！？』"
		   voices="miho10050"/>
		<msg @l="264" char_id="-1" frame_id="-1" name="朽木" text="『みな、私の知人たちだよ。』"
		   voices=""/>
		<msg @l="266" char_id="-1" frame_id="-1" name="朽木"
		   text="『今日キミのことを車内で犯すと教えてやったら、参加したいとついて来たのだよ。』" voices=""/>
		<msg @l="268" char_id="0" frame_id="-1" name="美帆" text="『そんな‥‥‥。』"
		   voices="miho10060"/>
		<msg @l="270" char_id="-1" frame_id="-1" name="朽木"
		   text="『そら、皆が見ている前で存分に感じて見せたまえ。』" voices=""/>
		<msg @l="272" char_id="0" frame_id="-1" name="美帆" text="『ん、あああっ！？』"
		   voices="miho10070"/>
		<msg @l="274" char_id="-1" frame_id="-1" name=""
		   text="腰を美帆の真っ白なヒップに強引に打ちつけ、胎内の奥深くを串刺しにしながら、教授の指先が秘裂の上側に位置する紅い真珠を強く摘み上げる。"
		   voices=""/>
		<msg @l="275" char_id="-1" frame_id="-1" name=""
		   text="同時に二箇所を攻められる快楽は身体を貪るように包み込んでいく。" voices=""/>
		<msg @l="276" char_id="-1" frame_id="-1" name=""
		   text="その瞬間、私の身体には刺すような感覚と熱い痺れが駆け抜けていく。" voices=""/>
		<msg @l="278" char_id="-1" frame_id="-1" name="朽木"
		   text="『みなに見られてクリ○リスをこれほど勃起させているのだ。キミはすぐにこの町に必要不可欠な女性になる。』" voices=""/>
		<msg @l="280" char_id="0" frame_id="-1" name="美帆"
		   text="『あ、んぐっ‥‥‥この、町‥‥‥‥‥？』" voices="miho10080"/>
		<msg @l="282" char_id="-1" frame_id="-1" name="朽木"
		   text="『ふふ、キミが気にすることではない。』" voices=""/>
		<msg @l="284" char_id="-1" frame_id="-1" name="朽木"
		   text="『キミは喘いでいれば‥‥それで充分なのだよ。』" voices=""/>
		<msg @l="286" char_id="0" frame_id="-1" name="美帆"
		   text="『あ、ああっ‥‥‥く、ああっ‥‥‥‥‥おく、ダメですっ。』" voices="miho10090"/>
		<msg @l="288" char_id="-1" frame_id="-1" name=""
		   text="熱い先端が膣の奥深くを突き上げ子宮口をノックするたび、それまで感じていた苦しみの代わりに痺れるような愉悦が下腹部の辺りに広がっていく。"
		   voices=""/>
		<msg @l="290" char_id="-1" frame_id="-1" name="朽木" text="『ほう‥‥キミはここが弱いのだな。』"
		   voices=""/>
		<msg @l="292" char_id="0" frame_id="-1" name="美帆" text="『ひぅっ！！』"
		   voices="miho10100"/>
		<msg @l="294" char_id="-1" frame_id="-1" name=""
		   text="ずん、ずんと、亀頭が奥深くにある敏感な場所を突き上げてくる。" voices=""/>
		<msg @l="296" char_id="-1" frame_id="-1" name="朽木"
		   text="『くくっ‥‥その可愛い声をもっと彼らに聞かせてあげたまえ。』" voices=""/>
		<msg @l="298" char_id="0" frame_id="-1" name="美帆"
		   text="『んぅっ‥‥‥ダ、ダメです‥‥‥‥‥‥こんな、んんっ！』" voices="miho10110"/>
		<msg @l="300" char_id="-1" frame_id="-1" name=""
		   text="私は思わず飛んでしまいそうになる理性を懸命に繋ぎ止め、蜜壺を掻き混ぜる熱い責め棒から逃げようとする。" voices=""/>
		<msg @l="301" char_id="-1" frame_id="-1" name=""
		   text="けれど‥‥思いとは裏腹に膣内の肉ヒダは肉棒を逃さないようにと絡みつき、締め上げていた。" voices=""/>
		<msg @l="303" char_id="-1" frame_id="-1" name="朽木"
		   text="『おお、凄い締め付けだ。しかも肉ヒダがうねうねとうごめき、私のモノに絡みついてくるよ。』" voices=""/>
		<msg @l="305" char_id="0" frame_id="-1" name="美帆"
		   text="『そんなっ‥‥ずか‥‥しい‥‥ことを‥‥んんっ‥‥‥言わっ‥‥ん、あくっ！？』" voices="miho10120"/>
		<msg @l="307" char_id="-1" frame_id="-1" name=""
		   text="敏感な場所を強く突き上げられ、私は思わず腰を震わせてしまう。真っ白いヒップから肉棒が抜き差しされる度に、" voices=""/>
		<msg @l="308" char_id="-1" frame_id="-1" name=""
		   text="白い泡だった液体が秘部からグチュグチュとあふれて、床に水溜りを作ってゆく。" voices=""/>
		<msg @l="310" char_id="-1" frame_id="-1" name="朽木"
		   text="『どうだね、キミの身体はこんなにも悦んでいるぞ？』" voices=""/>
		<msg @l="312" char_id="0" frame_id="-1" name="美帆" text="『あ、ああっ‥‥。』"
		   voices="miho10130"/>
		<msg @l="314" char_id="-1" frame_id="-1" name="" text="身体が快感で震える。" voices=""/>
		<msg @l="315" char_id="-1" frame_id="-1" name=""
		   text="ひと突きごとに腰が痺れ、目の前が真っ白になっていき、全身が性感帯になったかのような錯覚をおこす。" voices=""/>
		<msg @l="317" char_id="0" frame_id="-1" name="美帆"
		   text="『あ、ああっ‥‥‥んっ‥‥‥‥‥あはっっ！！』" voices="miho10140"/>
		<msg @l="319" char_id="-1" frame_id="-1" name="朽木"
		   text="『おお、急に締め付けが強くなってきたな？』" voices=""/>
		<msg @l="321" char_id="-1" frame_id="-1" name=""
		   text="私の身体の変化に気付き、教授は更に強く腰をお尻に打ちつけてくる。" voices=""/>
		<msg @l="323" char_id="0" frame_id="-1" name="美帆" text="『んっ、んっ‥‥‥あっ、んくっっ！』"
		   voices="miho10150"/>
		<msg @l="325" char_id="0" frame_id="-1" name="美帆"
		   text="『ダメ、ダメぇっ‥‥‥んっ、んんっ‥‥‥‥あああっっ！』" voices="miho10160"/>
		<msg @l="327" char_id="-1" frame_id="-1" name=""
		   text="もう‥‥声を抑えようといった思考は無くなっていた。" voices=""/>
		<msg @l="328" char_id="-1" frame_id="-1" name=""
		   text="与えられる悦楽に喘ぎ、身体を震わせ、結合部からは大量の淫汁が滴り落ちる。" voices=""/>
		<msg @l="330" char_id="-1" frame_id="-1" name="朽木" text="『いいぞ、このまま達してしまえ！』"
		   voices=""/>
		<msg @l="332" char_id="0" frame_id="-1" name="美帆"
		   text="『あ‥‥ああっ‥‥‥ダメ、んっ、ダメぇぇ‥‥‥‥‥。』" voices="miho10170"/>
		<msg @l="334" char_id="-1" frame_id="-1" name="朽木" text="『私も‥‥‥子宮に出してやろう。』"
		   voices=""/>
		<msg @l="336" char_id="0" frame_id="-1" name="美帆"
		   text="『え？い、ああっ‥‥‥ああああああっ！！』" voices="miho10180"/>
		<flash @l="339" count="4" fade="100" image="white"/>
		<wait_chgmv/>
		<ev @l="342" src="ev-011x1z1"/>
		<msg @l="344" char_id="-1" frame_id="-1" name=""
		   text="甘い痺れが一瞬にして私の頭の中に広がっていく。" voices=""/>
		<msg @l="345" char_id="-1" frame_id="-1" name="" text="―――絶頂。" voices=""/>
		<msg @l="346" char_id="-1" frame_id="-1" name="" text="それが、私の理性を‥‥消してしまった。"
		   voices=""/>
		<clear @l="349" class="all"/>
		<end_scene @l="352"/>
		<msg @l="354" char_id="0" frame_id="-1" name="美帆" text="『んっ‥‥‥ああっ‥‥‥‥‥‥。』"
		   voices="miho10190"/>
		<msg @l="356" char_id="-1" frame_id="-1" name="" text="熱い液体が私の中に流れ込んでくる。"
		   voices=""/>
		<msg @l="357" char_id="-1" frame_id="-1" name=""
		   text="でも‥‥‥それさえも今は、何故か気持ちが良い。" voices=""/>
		<msg @l="358" char_id="-1" frame_id="-1" name=""
		   text="身体の内側を焼かれるような感覚が‥‥‥とても。" voices=""/>
		<label @l="361" id="event_scene34"/>
		<goto @l="363" cond="!(f.flagInExtraMode&#32;&gt;&#32;100)&#13;&#10;"
		   label="TempLabel_200"/>
		<bgm @l="365" src="bgm14" volume="1."/>
		<label @l="366" id="TempLabel_200"/>
		<msg @l="368" char_id="-1" frame_id="-1" name="朽木" text="『まだ終わりではないぞ。ククク‥‥』"
		   voices=""/>
		<msg @l="370" char_id="-1" frame_id="-1" name=""
		   text="そう言って教授はぐったりと脱力した私を抱え上げる。" voices=""/>
		<msg @l="371" char_id="-1" frame_id="-1" name=""
		   text="そうして強制的に立ち上がらされた私の両手を、それぞれ左右のつり革へ通す。" voices=""/>
		<msg @l="372" char_id="-1" frame_id="-1" name=""
		   text="まるで‥‥吊るされているような格好にされる。" voices=""/>
		<label @l="375" id="chart_line48"/>
		<wait_chgmv/>
		<ev @l="378" src="ev-034"/>
		<description @l="381" text="車内大輪姦"/>
		<msg @l="383" char_id="0" frame_id="-1" name="美帆" text="『え‥‥‥。』"
		   voices="miho10200"/>
		<msg @l="385" char_id="0" frame_id="-1" name="美帆" text="『なに‥‥を‥‥‥？』"
		   voices="miho10210"/>
		<msg @l="387" char_id="-1" frame_id="-1" name="朽木"
		   text="『彼らはキミを犯す為に来ているのでね。』" voices=""/>
		<msg @l="389" char_id="-1" frame_id="-1" name="会社員Ａ"
		   text="『いやあ、このような素晴らしい催しに呼んで頂けて、ありがたい限りですよ。』" voices=""/>
		<msg @l="391" char_id="-1" frame_id="-1" name="会社員Ｂ"
		   text="『まったく、朽木さんの手腕も磨きがかかる一方ですな。』" voices=""/>
		<msg @l="393" char_id="-1" frame_id="-1" name=""
		   text="周囲を取り囲んでいる男たちが口々にそんな事を言い、笑う。" voices=""/>
		<msg @l="395" char_id="-1" frame_id="-1" name="朽木"
		   text="『彼らはキミの為に会社まで休んで来てくれたのだ。たっぷり奉仕せねば申し訳なかろう？』" voices=""/>
		<msg @l="397" char_id="-1" frame_id="-1" name="朽木"
		   text="『もちろん私も１回位では満足しないからね。最低でも５回は犯してあげるよ。』" voices=""/>
		<msg @l="399" char_id="-1" frame_id="-1" name=""
		   text="そう言う朽木の肉棒は射精前よりも大きくなっているように見えた。" voices=""/>
		<msg @l="401" char_id="0" frame_id="-1" name="美帆" text="『そん‥‥な‥‥‥。』"
		   voices="miho10220"/>
		<msg @l="403" char_id="-1" frame_id="-1" name="" text="声が震えていた。" voices=""/>
		<msg @l="404" char_id="-1" frame_id="-1" name=""
		   text="それが恐怖によるものなのかそれとも絶頂の余韻なのか、私にも解らない。" voices=""/>
		<msg @l="406" char_id="-1" frame_id="-1" name="朽木"
		   text="『さぁ、輪姦パーティーを始めようか。』" voices=""/>
		<wait_chgmv/>
		<ev @l="409" src="ev-034y1"/>
		<msg @l="411" char_id="0" frame_id="-1" name="美帆" text="『んんっ‥‥！』"
		   voices="miho10230"/>
		<msg @l="413" char_id="-1" frame_id="-1" name=""
		   text="大量の精液を注ぎ込まれた秘部へ、再び朽木教授のモノが突き入れられる。" voices=""/>
		<msg @l="415" char_id="-1" frame_id="-1" name="" text="ずぶずぶずぶずぶずぶ" voices=""/>
		<msg @l="417" char_id="-1" frame_id="-1" name="朽木"
		   text="『おや、先程はよほど気持ち良かったのだな？キミの胎内はビクついているぞ？』" voices=""/>
		<msg @l="419" char_id="0" frame_id="-1" name="美帆" text="『や、ああああっっ。』"
		   voices="miho10240"/>
		<msg @l="421" char_id="-1" frame_id="-1" name=""
		   text="先の絶頂の余韻で震えている膣内を、教授は荒々しく突き上げてくる。" voices=""/>
		<msg @l="423" char_id="0" frame_id="-1" name="美帆" text="『ん、んんっ‥‥‥んぁぁっ。』"
		   voices="miho10940"/>
		<msg @l="425" char_id="-1" frame_id="-1" name=""
		   text="敏感になっているそこへ与えられる強い刺激と、蜜壺で出された白い欲液を肉棒でかきまわされる感触に、私は思わずビクビクと腰を震わせて身悶える。"
		   voices=""/>
		<msg @l="427" char_id="-1" frame_id="-1" name="会社員Ａ" text="『朽木さん、こちらの開発は？』"
		   voices=""/>
		<msg @l="429" char_id="-1" frame_id="-1" name="朽木"
		   text="『まだ手をつけていませんので‥‥どうぞ、初モノをお楽しみください。』" voices=""/>
		<msg @l="431" char_id="-1" frame_id="-1" name="会社員Ａ"
		   text="『おお、それはありがたいですな。』" voices=""/>
		<msg @l="433" char_id="-1" frame_id="-1" name=""
		   text="そうして何やらやり取りを交わした後、私の背後にいた男が指先をお尻の穴に這わせてくる。" voices=""/>
		<msg @l="435" char_id="0" frame_id="-1" name="美帆" text="『ひっ‥‥！？』"
		   voices="miho10250"/>
		<msg @l="437" char_id="-1" frame_id="-1" name="会社員Ａ"
		   text="『私は最近こちらが気に入っていてね。たっぷり愉しませてもらうよ。』" voices=""/>
		<msg @l="439" char_id="0" frame_id="-1" name="美帆"
		   text="『や、いやっ‥‥やめて‥‥そんな所‥‥‥触らないで‥‥‥‥‥。』" voices="miho10260"/>
		<msg @l="441" char_id="-1" frame_id="-1" name="会社員Ａ"
		   text="『何を言うんだい。しっかりとほぐさないと切れてしまうかもしれないからね‥‥念入りに可愛がってあげないとダメだろう？』"
		   voices=""/>
		<msg @l="443" char_id="0" frame_id="-1" name="美帆"
		   text="『い、いやっ‥‥‥‥‥あっ‥‥んんっっ！！』" voices="miho10270"/>
		<msg @l="445" char_id="-1" frame_id="-1" name="" text="お尻に、冷やりとした冷たい感触がした。"
		   voices=""/>
		<msg @l="446" char_id="-1" frame_id="-1" name=""
		   text="どうもそれは液体のようで‥‥しばらくお尻の回りに塗りたくられた後、ゆっくりと指先がお尻の穴に侵入してくる。" voices=""/>
		<msg @l="448" char_id="0" frame_id="-1" name="美帆"
		   text="『やあっ‥‥嫌です‥‥‥そこだけは‥‥許して下さい‥‥あっ‥‥んんっ‥‥‥抜いて、抜いてくださいっ！』"
		   voices="miho10280"/>
		<msg @l="450" char_id="-1" frame_id="-1" name="朽木"
		   text="『こら、仲根クン‥‥あまりわがままを言うものじゃない。』" voices=""/>
		<msg @l="452" char_id="-1" frame_id="-1" name="朽木"
		   text="『彼らは私の大切な知人なのだよ？&#32;私以上に丁寧に対応せねば失礼だぞ。』" voices=""/>
		<msg @l="454" char_id="0" frame_id="-1" name="美帆" text="『で、でもっ‥‥‥ん、んんっっ！！』"
		   voices="miho10290"/>
		<msg @l="456" char_id="-1" frame_id="-1" name=""
		   text="指先が白桃のようなお尻の中心にある菊の花をかき混ぜ始める。" voices=""/>
		<msg @l="457" char_id="-1" frame_id="-1" name=""
		   text="直腸の中でくいくいと指を動かされるたび、粘膜が擦られる感触に背筋が震える。" voices=""/>
		<msg @l="459" char_id="-1" frame_id="-1" name="会社員Ａ"
		   text="『今塗ったローションには性感の促進効果もあるからね、すぐに気持ち良くてたまらなくなるハズだよ。』" voices=""/>
		<msg @l="461" char_id="0" frame_id="-1" name="美帆" text="『そんな‥‥‥ん、あぐっ！？』"
		   voices="miho10300"/>
		<msg @l="463" char_id="-1" frame_id="-1" name="" text="指が‥‥二本になった。"
		   voices=""/>
		<msg @l="464" char_id="-1" frame_id="-1" name=""
		   text="内側からグリグリと動かし揉みほぐしながら、入口も指先で揉み込むように愛撫をされる。" voices=""/>
		<msg @l="466" char_id="0" frame_id="-1" name="美帆"
		   text="(うそ‥‥‥なんか、気持ちいい‥‥‥‥‥)" voices="miho10310"/>
		<msg @l="468" char_id="-1" frame_id="-1" name=""
		   text="最初は肛門全体がめり込んでいくが、そのうちに小さな口をポッと開け、大きな指を呑み込んでいく。" voices=""/>
		<msg @l="470" char_id="0" frame_id="-1" name="美帆"
		   text="(これ、ローションのせい‥‥‥‥‥なんだよね？)" voices="miho10320"/>
		<msg @l="472" char_id="-1" frame_id="-1" name=""
		   text="前を突かれる感覚と白桃のようなまろやかなお尻の穴をいじくられる刺激が重なって、少しずつ嫌悪感が薄らいでいく。" voices=""/>
		<msg @l="474" char_id="0" frame_id="-1" name="美帆" text="『ん、あくっ‥‥。』"
		   voices="miho09920"/>
		<msg @l="476" char_id="-1" frame_id="-1" name=""
		   text="代わりに秘部とは違った熱い痺れがソコに広がって、私は思わず身悶える。" voices=""/>
		<msg @l="478" char_id="-1" frame_id="-1" name="会社員Ａ"
		   text="『ふむ、すっかりほぐれてきたようだね。』" voices=""/>
		<msg @l="480" char_id="-1" frame_id="-1" name=""
		   text="指先で糸を結んだようなお尻の穴を広げながら、彼はニタリと笑う。" voices=""/>
		<msg @l="482" char_id="0" frame_id="-1" name="美帆" text="『んんっ‥‥‥あ、あああっ‥‥‥‥。』"
		   voices="miho10330"/>
		<msg @l="484" char_id="-1" frame_id="-1" name=""
		   text="お尻の穴を凌辱されているというのに、私は自分でも驚くほど腰を震わせて感じてしまっていた。" voices=""/>
		<msg @l="486" char_id="-1" frame_id="-1" name="朽木"
		   text="『そろそろ二本挿しといきましょうか。』" voices=""/>
		<msg @l="488" char_id="-1" frame_id="-1" name="会社員Ａ"
		   text="『そうですな。これなら問題なくいけるでしょう。』" voices=""/>
		<msg @l="490" char_id="-1" frame_id="-1" name=""
		   text="そう言って、私の背後にいる男は巨大で熱い塊を私のお尻に押し当てる。" voices=""/>
		<msg @l="492" char_id="0" frame_id="-1" name="美帆" text="『ひぅっ！！』"
		   voices="miho10100"/>
		<msg @l="494" char_id="-1" frame_id="-1" name="" text="思わず‥‥私は息を飲んでいた。"
		   voices=""/>
		<msg @l="495" char_id="-1" frame_id="-1" name=""
		   text="指でいじくられるだけで腰が痺れるほどなのだ‥‥。" voices=""/>
		<msg @l="496" char_id="-1" frame_id="-1" name=""
		   text="これに熱い太幹を挿入されてしまったら、私はどうなってしまうだろう？" voices=""/>
		<msg @l="498" char_id="-1" frame_id="-1" name="会社員Ａ"
		   text="『では、いきますよ‥‥力を抜いてくださいね。』" voices=""/>
		<wait_chgmv/>
		<ev @l="501" src="ev-034y1y3"/>
		<msg @l="503" char_id="0" frame_id="-1" name="美帆"
		   text="『んぐっ‥‥‥あ、あ、ああっ‥‥‥あっ‥‥‥‥‥。』" voices="miho10350"/>
		<msg @l="505" char_id="-1" frame_id="-1" name=""
		   text="ゆっくりと、熱いモノが私のお尻に入ってくる。" voices=""/>
		<msg @l="506" char_id="-1" frame_id="-1" name=""
		   text="充分にほぐされているからだろうか‥‥痛みは思ったほど感じない。" voices=""/>
		<msg @l="508" char_id="-1" frame_id="-1" name="会社員Ａ"
		   text="『ん、くっ‥‥‥さすがにキツイですね。』" voices=""/>
		<msg @l="510" char_id="0" frame_id="-1" name="美帆" text="『ん、あああっ！？』"
		   voices="miho10070"/>
		<msg @l="512" char_id="-1" frame_id="-1" name="朽木" text="『初モノの特権でしょうな。』"
		   voices=""/>
		<msg @l="514" char_id="-1" frame_id="-1" name="会社員Ａ" text="『いや、仰るとおりですな。』"
		   voices=""/>
		<msg @l="516" char_id="-1" frame_id="-1" name="会社員Ａ"
		   text="『我が社の娘は、最近どうも締まりが悪くてね。』" voices=""/>
		<msg @l="518" char_id="0" frame_id="-1" name="美帆"
		   text="『んぐっ‥‥‥あ、あ、ああっ‥‥‥あっ‥‥‥‥‥。』" voices="miho10350"/>
		<msg @l="520" char_id="-1" frame_id="-1" name="朽木"
		   text="『くくっ、では存分にお楽しみくださらなければ。』" voices=""/>
		<msg @l="522" char_id="-1" frame_id="-1" name="会社員Ａ" text="『ええ、そのつもりですよ。』"
		   voices=""/>
		<msg @l="524" char_id="-1" frame_id="-1" name=""
		   text="そうして二人は意気投合をすると、それぞれのスピードで腰を動かし責め立て始める。" voices=""/>
		<msg @l="526" char_id="0" frame_id="-1" name="美帆" text="『あ、ああっ‥‥‥あっ‥‥‥‥‥。』"
		   voices="miho10360"/>
		<msg @l="528" char_id="-1" frame_id="-1" name=""
		   text="股間を二本の男根が行き来するたび、えもいわれない感覚が身体の芯を突き抜けていった。" voices=""/>
		<msg @l="529" char_id="-1" frame_id="-1" name=""
		   text="頭を蕩けさせるような秘部の痺れと、じんわりと下腹部に広がるお尻の痺れが交互に私を責め立ててくる。" voices=""/>
		<msg @l="531" char_id="0" frame_id="-1" name="美帆"
		   text="『ああっ、あっ‥‥‥‥ふあっ‥‥ああっ‥‥あひっ‥‥ふぁぁっ‥‥‥。』" voices="miho10370"/>
		<msg @l="533" char_id="-1" frame_id="-1" name=""
		   text="膣内の肉棒が肉ヒダを引きずって抜かれる時、尻の責め棒は直腸まで押し込むように突き上げてくる。" voices=""/>
		<msg @l="534" char_id="-1" frame_id="-1" name=""
		   text="尻の肉棒が抜かれる時には、子宮めがけて熱の棒が子宮口まで突き上げてる。" voices=""/>
		<msg @l="535" char_id="-1" frame_id="-1" name=""
		   text="そうして美帆は休む間もなく常に突き上げ、責め立てられていた。" voices=""/>
		<msg @l="537" char_id="-1" frame_id="-1" name="会社員Ａ"
		   text="『お、おおっ‥‥‥素晴らしい締め付けだっ！』" voices=""/>
		<msg @l="539" char_id="-1" frame_id="-1" name="朽木"
		   text="『前の方も、後ろに呼応するようにビクビクとけいれんしていますよ。』" voices=""/>
		<msg @l="541" char_id="-1" frame_id="-1" name=""
		   text="それぞれの穴からグチュグチュという水音が響きわたる。" voices=""/>
		<msg @l="543" char_id="0" frame_id="-1" name="美帆"
		   text="『んんっ‥‥‥あっ、ああっ‥‥‥‥‥い、あ、あふっ‥‥‥‥。』" voices="miho10380"/>
		<msg @l="545" char_id="0" frame_id="-1" name="美帆"
		   text="『あっ‥‥ああっ‥‥‥‥あ、あ、あ‥‥‥‥ん、ふああっ！』" voices="miho10390"/>
		<msg @l="547" char_id="-1" frame_id="-1" name="会社員Ａ" text="『おお、凄いですな‥‥‥。』"
		   voices=""/>
		<msg @l="549" char_id="-1" frame_id="-1" name="会社員Ａ"
		   text="『朽木さんが突き上げるたびにこちらまで搾り取られそうになります。』" voices=""/>
		<msg @l="551" char_id="-1" frame_id="-1" name="朽木" text="『それが二穴責めの醍醐味ですよ。』"
		   voices=""/>
		<msg @l="553" char_id="-1" frame_id="-1" name=""
		   text="教授はそう言って、更に腰を強く突き上げて奥深くへ亀頭を潜りこませる。" voices=""/>
		<msg @l="555" char_id="0" frame_id="-1" name="美帆"
		   text="『んっ、んんっ‥‥‥ああっ‥‥ダメっ‥‥‥んうっ、ああっ！！』" voices="miho10400"/>
		<msg @l="557" char_id="-1" frame_id="-1" name="会社員Ａ" text="『私も、負けていられませんね。』"
		   voices=""/>
		<msg @l="559" char_id="-1" frame_id="-1" name=""
		   text="その激しい律動に感化されたのか、お尻を犯している彼も腰をぐいぐいと押し付けて、直腸から胃まで貫こうかという勢いで男根を突き立ててくる。"
		   voices=""/>
		<msg @l="561" char_id="0" frame_id="-1" name="美帆"
		   text="『ああ、ああああっ‥‥‥そんな深く‥‥‥ダメ、あっ、頭‥‥おかしく‥‥‥なっちゃうぅ‥‥‥んっ‥‥ああっ！！』"
		   voices="miho10410"/>
		<msg @l="563" char_id="-1" frame_id="-1" name="会社員Ａ"
		   text="『うおお、そんなに締め付けられたら‥‥。』" voices=""/>
		<msg @l="565" char_id="-1" frame_id="-1" name="朽木" text="『私も‥‥ご一緒致しましょうか。』"
		   voices=""/>
		<msg @l="567" char_id="-1" frame_id="-1" name=""
		   text="二人は目配せをすると、腰の動きをあわせるように律動を早めていく。" voices=""/>
		<msg @l="568" char_id="-1" frame_id="-1" name=""
		   text="そうして前と後ろ、同時に奥深くを擦り上げられたその瞬間‥‥‥。" voices=""/>
		<msg @l="570" char_id="0" frame_id="-1" name="美帆"
		   text="『あ、ああっ‥‥‥ダメ、こんなのっ‥‥‥あっ、あっ、あああっ！』" voices="miho05080"/>
		<msg @l="572" char_id="0" frame_id="-1" name="美帆"
		   text="『あああっ、あっ‥‥‥あっ、あっ、あっ‥‥‥んっ、んんっ！！』" voices="miho10420"/>
		<msg @l="574" char_id="-1" frame_id="-1" name=""
		   text="蕩けるような絶頂が引き止める間もなく駆け上ってくる。" voices=""/>
		<msg @l="576" char_id="0" frame_id="-1" name="美帆"
		   text="『あ‥‥ああっ‥‥‥ダメ、んっ、ダメぇぇ‥‥‥‥‥。』" voices="miho10170"/>
		<msg @l="578" char_id="0" frame_id="-1" name="美帆"
		   text="『い、くぅ‥‥‥いく‥‥‥‥いっちゃ、う、あっ、あああっ！！』" voices="miho10430"/>
		<msg @l="580" char_id="-1" frame_id="-1" name="会社員Ａ" text="『く、うううっ！』"
		   voices=""/>
		<msg @l="582" char_id="-1" frame_id="-1" name="朽木" text="『いきますよっ！』"
		   voices=""/>
		<flash @l="585" count="4" fade="100" image="white"/>
		<msg @l="587" char_id="0" frame_id="-1" name="美帆" text="『んっ、ああああっ！！』"
		   voices="miho10440"/>
		<flash @l="590" count="4" fade="100" image="white"/>
		<msg @l="592" char_id="-1" frame_id="-1" name=""
		   text="体内に熱い液体がビュルビュルと吐き出される。" voices=""/>
		<wait_chgmv/>
		<ev @l="595" src="ev-034x1y1y3z1"/>
		<msg @l="597" char_id="-1" frame_id="-1" name=""
		   text="びゅく、びゅくと２本の異物が脈動するたびに私は腰を大きく震わせて、身悶える。" voices=""/>
		<msg @l="600" char_id="0" frame_id="-1" name="美帆" text="『んっ‥‥。』"
		   voices="miho10450"/>
		<msg @l="602" char_id="0" frame_id="-1" name="美帆" text="『ん、んんっ‥‥‥んぁぁっ。』"
		   voices="miho10940"/>
		<msg @l="604" char_id="-1" frame_id="-1" name=""
		   text="犯していた二人は腰を震わせ、膣内だけでなく私の身体も白濁液で汚していく。" voices=""/>
		<msg @l="605" char_id="-1" frame_id="-1" name=""
		   text="熱い粘っこい液体は私の身体を無遠慮になめ回し‥‥肌の上を白く染め上げた。" voices=""/>
		<clear @l="608" class="all"/>
		<msg @l="610" char_id="-1" frame_id="-1" name="朽木"
		   text="『さあ、皆様も遠慮なく味わってください。』" voices=""/>
		<msg @l="612" char_id="-1" frame_id="-1" name=""
		   text="そう言って朽木はイチモツを引き抜くと、栓を解かれた精液が秘部からドロリと垂れてくる。" voices=""/>
		<msg @l="614" char_id="-1" frame_id="-1" name="会社員Ｄ"
		   text="『それじゃ、遠慮なく犯らせてもらいましょうかね。』" voices=""/>
		<msg @l="616" char_id="-1" frame_id="-1" name=""
		   text="次の男は美帆の男達の欲液まみれになった秘部を見て、いやらしい笑みを浮かべると、硬くなった肉棒の先端を精液でいっぱいの蜜口へ押し当ててくる。"
		   voices=""/>
		<msg @l="618" char_id="-1" frame_id="-1" name="会社員Ｅ"
		   text="『こっちも‥‥存分に使わせてもらいますよ。』" voices=""/>
		<msg @l="620" char_id="-1" frame_id="-1" name=""
		   text="後ろを犯していた男も順番待ちをしていた者と交代し、新たな侵略者が精液で汚れた菊座へと押し当てられた。" voices=""/>
		<wait_chgmv/>
		<ev @l="623" src="ev-034x1y2y4z1"/>
		<msg @l="625" char_id="0" frame_id="-1" name="美帆"
		   text="『もう‥‥ダメェ‥‥私‥‥二度もイっちゃったから‥‥‥身体が‥‥‥壊れちゃう‥‥‥。』" voices="miho10460"/>
		<msg @l="627" char_id="-1" frame_id="-1" name=""
		   text="だが男達は美帆の言葉など聞いてないのかのように欲望をつき入れる。" voices=""/>
		<msg @l="629" char_id="0" frame_id="-1" name="美帆" text="『あ、ああっ‥‥んっ‥‥‥‥あくっ！』"
		   voices="miho10470"/>
		<msg @l="631" char_id="-1" frame_id="-1" name=""
		   text="未だ絶頂の余韻が残る膣と直腸を奥深くまで貫かれ、私は震えた声を漏らしながら身悶える。" voices=""/>
		<msg @l="633" char_id="-1" frame_id="-1" name="会社員Ｄ"
		   text="『おお、精液と愛液でドロドロなのに締め付けがすごい。』" voices=""/>
		<msg @l="635" char_id="-1" frame_id="-1" name="会社員Ｅ"
		   text="『こちらは中のうねりと根元の締め付けが、なんとも素晴らしい。』" voices=""/>
		<msg @l="637" char_id="-1" frame_id="-1" name=""
		   text="口々に美帆を辱める事を言いながら、男たちは自分任せに強く腰を打ち付けてくる。" voices=""/>
		<msg @l="639" char_id="0" frame_id="-1" name="美帆"
		   text="『んんっ‥‥あっ‥‥ああっ‥‥あひっ‥‥‥ふぁっ‥‥んぅ、あふっっ！！』" voices="miho10480"/>
		<msg @l="641" char_id="-1" frame_id="-1" name=""
		   text="深く串刺しにされた膣内に白濁液を押し上げられた瞬間、私は子宮が犯される感じに支配されて大きく身体を震わせる。" voices=""/>
		<msg @l="642" char_id="-1" frame_id="-1" name=""
		   text="そうして震えている身体へ更に追い討ちをかけるように、お尻を貫いている熱い杭が体内の柔壁をズブズブと押し広げて進入してくる。"
		   voices=""/>
		<msg @l="644" char_id="0" frame_id="-1" name="美帆"
		   text="『あっ、ああっ‥‥んっ‥‥‥‥ああああっ！！』" voices="miho10490"/>
		<msg @l="646" char_id="-1" frame_id="-1" name=""
		   text="二つの欲望の塊がそれぞれの穴を凌辱し、それぞれを隔てた壁を両方から擦り上げる度、頭の中が真っ白になる。" voices=""/>
		<msg @l="647" char_id="-1" frame_id="-1" name="" text="周囲の視線は既にどうでも良くなっていた。"
		   voices=""/>
		<msg @l="649" char_id="-1" frame_id="-1" name="会社員Ｄ"
		   text="『この締め付けとウネリは‥‥‥クセになりそうですね。』" voices=""/>
		<msg @l="651" char_id="-1" frame_id="-1" name="会社員Ｅ"
		   text="『尻穴の感触も、柔らかくて締め付けがすごくて‥‥‥最高に具合が良いですよ。』" voices=""/>
		<msg @l="653" char_id="-1" frame_id="-1" name="会社員Ｄ"
		   text="『それに、この中で擦りあう感じがまた‥‥。』" voices=""/>
		<msg @l="655" char_id="-1" frame_id="-1" name=""
		   text="そう言って、お尻で律動をしている男の動きに合わせ、秘部を犯している男がゆっくりと腰をうねらせる。" voices=""/>
		<msg @l="657" char_id="-1" frame_id="-1" name="会社員Ｅ"
		   text="『薄い壁を隔てたこの感じは二穴責めならではというヤツですな。』" voices=""/>
		<msg @l="659" char_id="0" frame_id="-1" name="美帆"
		   text="『あ、あ、あっ‥‥ダメぇ、中でこすれてッ‥‥‥‥ん、ああっ！』" voices="miho10500"/>
		<msg @l="661" char_id="-1" frame_id="-1" name=""
		   text="前と後ろを貫く男根が意図的に擦りあわされ、私は腰を大きく震わせながら背を反らして身悶える。" voices=""/>
		<msg @l="662" char_id="-1" frame_id="-1" name=""
		   text="そうして私が腰を震わせるたびに、咥え込んだ二本のモノを激しく締め付けていることを、私は自覚していない。" voices=""/>
		<msg @l="663" char_id="-1" frame_id="-1" name=""
		   text="そうして男たちは私のその無意識な締め付けを味わう為に、何度も膣内と直腸内の渇望を擦り合わせて私を延々と責め立てる。"
		   voices=""/>
		<msg @l="665" char_id="0" frame_id="-1" name="美帆"
		   text="『ひっ‥‥‥あっ‥‥‥ああっ‥‥‥んっ、んっ、んっ‥‥‥らめぇ‥‥‥もう‥‥‥んんんっ！！』" voices="miho10510"/>
		<msg @l="667" char_id="0" frame_id="-1" name="美帆"
		   text="『ああっ‥‥‥ダメ‥‥‥‥また、いく‥‥‥いっちゃ、んんっっ！』" voices="miho10520"/>
		<msg @l="669" char_id="-1" frame_id="-1" name=""
		   text="私は再び絶頂へと急速に押し上げられていく。" voices=""/>
		<msg @l="670" char_id="-1" frame_id="-1" name=""
		   text="甘い痺れが身体中を駆け巡り、頭を、腰を、甘く蕩けさせていた。" voices=""/>
		<msg @l="672" char_id="-1" frame_id="-1" name="会社員Ｄ" text="『お、俺もそろそろいくぞっ！』"
		   voices=""/>
		<msg @l="674" char_id="-1" frame_id="-1" name="会社員Ｅ" text="『私もこれ以上は我慢が―――。』"
		   voices=""/>
		<msg @l="676" char_id="-1" frame_id="-1" name=""
		   text="男たち二人が私の言葉に続くように声を漏らし、腰をより激しく震わせる。" voices=""/>
		<msg @l="678" char_id="0" frame_id="-1" name="美帆"
		   text="『んんっ、あっ、あっ、あっ‥‥‥いく、あ、ああっ、んんんっ！！』" voices="miho10530"/>
		<msg @l="680" char_id="-1" frame_id="-1" name="会社員Ｄ" text="『くっっ！』" voices=""/>
		<msg @l="682" char_id="-1" frame_id="-1" name="会社員Ｅ" text="『し、締まるっ！』"
		   voices=""/>
		<msg @l="684" char_id="0" frame_id="-1" name="美帆"
		   text="『んうっ‥‥ああ、いくっ‥‥‥いく、いくいくいくっっ‥‥‥。』" voices="miho05090"/>
		<flash @l="687" count="4" fade="100" image="white"/>
		<msg @l="689" char_id="0" frame_id="-1" name="美帆" text="『ん、あああああああっ！！』"
		   voices="miho11040"/>
		<flash @l="692" count="4" fade="100" image="white"/>
		<wait_chgmv/>
		<ev @l="695" src="ev-034y2y4z1z2z4"/>
		<msg @l="697" char_id="-1" frame_id="-1" name=""
		   text="前と後ろへ再度大量の熱い液体を注ぎ込まれ、私は強く深い絶頂に飲まれて身体をビクッビクッと強く硬直させる。" voices=""/>
		<msg @l="698" char_id="-1" frame_id="-1" name=""
		   text="膣内に射精するだけでは止まらず、男達はさらに熱いほとばしりを私の身体めがけて放ってきた。" voices=""/>
		<msg @l="700" char_id="0" frame_id="-1" name="美帆"
		   text="『んっ、あっ、ああっ‥‥‥‥んんっ‥‥‥‥‥‥。』" voices="miho12040"/>
		<msg @l="702" char_id="-1" frame_id="-1" name=""
		   text="青臭い白濁液に全身をくまなく汚されている‥‥。" voices=""/>
		<msg @l="703" char_id="-1" frame_id="-1" name=""
		   text="けれど大量の白濁液が火照ったピンクの肌に絡みつく様は、私の汚された身体を妖艶にさせていた。" voices=""/>
		<clear @l="706" class="all"/>
		<msg @l="708" char_id="-1" frame_id="-1" name="会社員Ｄ" text="『おお、イってるイってる。』"
		   voices=""/>
		<msg @l="710" char_id="-1" frame_id="-1" name="会社員Ｅ"
		   text="『痛いくらい中のヒダが絡み付いて‥‥締め付けてきますね。』" voices=""/>
		<msg @l="712" char_id="-1" frame_id="-1" name=""
		   text="射精後も絶頂に震える胎内と体内の感触を味わうように、前と後ろの男が最後の1滴まで流し込むように容赦無く腰を動かし続ける。"
		   voices=""/>
		<msg @l="714" char_id="-1" frame_id="-1" name="会社員Ｊ"
		   text="『ほら、終わったらさっさとどけよ。』" voices=""/>
		<msg @l="716" char_id="-1" frame_id="-1" name="会社員Ｋ"
		   text="『こっちはもう‥もう爆発寸前なんだよっ！』" voices=""/>
		<wait_chgmv/>
		<ev @l="719" src="ev-034y1y3z1z2z4"/>
		<msg @l="721" char_id="-1" frame_id="-1" name=""
		   text="達した男たちを押し退け、次の男たちが爆発寸前になった肉棒を前と後ろへ滑り込ませる。" voices=""/>
		<msg @l="722" char_id="-1" frame_id="-1" name=""
		   text="それはもう身体を貪るとかいうレベルではなく。" voices=""/>
		<msg @l="723" char_id="-1" frame_id="-1" name=""
		   text="ただ、込み上げた精液を吐き出す場所を求めているだけに過ぎない。" voices=""/>
		<msg @l="725" char_id="0" frame_id="-1" name="美帆"
		   text="『あ、ああっ‥‥んっ‥‥‥‥ダメ‥‥‥これ以上は、んんっ！』" voices="miho10550"/>
		<msg @l="726" char_id="-1" frame_id="-1" name=""
		   text="私の言葉を遮るように男達は下からの突き上げると、秘裂を割って入ってきた肉棒が子宮口を突きあげる。" voices=""/>
		<msg @l="727" char_id="-1" frame_id="-1" name=""
		   text="その瞬間膣内に吐き出された大量の精液が秘部からビュルッと溢れ出し、太腿を伝って床に滴り落ちた。" voices=""/>
		<msg @l="729" char_id="0" frame_id="-1" name="美帆" text="『んっ、ああああっ！！』"
		   voices="miho10440"/>
		<msg @l="731" char_id="-1" frame_id="-1" name="会社員Ｊ"
		   text="『あーあ‥‥思いっきり突きいれたから吐き出しちゃっただろ。』" voices=""/>
		<msg @l="733" char_id="-1" frame_id="-1" name="会社員Ｋ"
		   text="『いいだろ、ずっと我慢していたんだからよ！それにこの後また何十人分ものザーメンをこのお腹に注ぎ込むんだからちょっとくらい出ちゃってもかまわねぇよ。』"
		   voices=""/>
		<msg @l="735" char_id="-1" frame_id="-1" name=""
		   text="そう言いながら男は私の下腹部をパチンパチンと叩く。" voices=""/>
		<msg @l="737" char_id="0" frame_id="-1" name="美帆" text="『ん、あくっ‥‥。』"
		   voices="miho09920"/>
		<msg @l="739" char_id="-1" frame_id="-1" name=""
		   text="秘部の方へ入れていた男が、そう言うと、更に激しく子宮を突き上げてくる。" voices=""/>
		<msg @l="740" char_id="-1" frame_id="-1" name=""
		   text="腰を微妙に動かし、私の膣中を色んな方向に暴れる。" voices=""/>
		<msg @l="742" char_id="0" frame_id="-1" name="美帆"
		   text="『あ、ああっ‥‥‥く、ああっ‥‥‥‥‥おく、ダメですっ。』" voices="miho10090"/>
		<msg @l="744" char_id="-1" frame_id="-1" name=""
		   text="広がった傘の部分が、時折、私の弱い部分を引っかき擦り上げた。" voices=""/>
		<msg @l="745" char_id="-1" frame_id="-1" name=""
		   text="傘に襞が巻き込まれ、滲み出る愛液が秘裂の隙間から掻き出される。" voices=""/>
		<msg @l="747" char_id="0" frame_id="-1" name="美帆"
		   text="『んっ、んんっ‥‥‥ああっ‥‥ダメっ‥‥‥んうっ、ああっ！！』" voices="miho10400"/>
		<msg @l="749" char_id="-1" frame_id="-1" name="会社員Ｋ" text="『おー、よがれよがれ。』"
		   voices=""/>
		<msg @l="751" char_id="-1" frame_id="-1" name=""
		   text="男達はストロークを早め菊座を責めたて、また熱くする。" voices=""/>
		<msg @l="752" char_id="-1" frame_id="-1" name=""
		   text="すると三度目のアナ○フ○ックのせいか排泄感が、こみ上げてくる。" voices=""/>
		<msg @l="754" char_id="0" frame_id="-1" name="美帆"
		   text="『あ‥‥ああっ‥‥‥ダメ、んっ、ダメぇぇ‥‥‥‥‥。』" voices="miho10170"/>
		<msg @l="756" char_id="-1" frame_id="-1" name=""
		   text="責めたてられる菊座の刺激に我慢をするが、私のお尻とサラリーマンの腰が密着すると、子宮が直腸から押し上げられ、目の奥がチカチカしてきた。"
		   voices=""/>
		<msg @l="758" char_id="0" frame_id="-1" name="美帆" text="『ん‥‥あくっ！』"
		   voices="miho10010"/>
		<msg @l="760" char_id="0" frame_id="-1" name="美帆"
		   text="『んぁぁっ‥‥あっ、んあっ‥‥‥んっ、んっ、んんっ！！』" voices="miho11170"/>
		<msg @l="762" char_id="0" frame_id="-1" name="美帆"
		   text="『あ、あ、あっ‥‥ダメぇ、中でこすれてッ‥‥‥‥ん、ああっ！』" voices="miho10500"/>
		<msg @l="764" char_id="-1" frame_id="-1" name="会社員Ｊ"
		   text="『おおっ！&#32;いい感じだ。‥‥壁一枚隔ててこっちまでゴリゴリ来るぜー。』" voices=""/>
		<msg @l="766" char_id="-1" frame_id="-1" name="会社員Ｋ"
		   text="『これぞ二穴責めの醍醐味だよなー。』" voices=""/>
		<msg @l="768" char_id="-1" frame_id="-1" name="会社員Ｋ"
		   text="『おい！オマ○コ壊れるほど突き上げてやろうぜ！』" voices=""/>
		<msg @l="770" char_id="-1" frame_id="-1" name="会社員Ｊ" text="『おうよっ。』"
		   voices=""/>
		<msg @l="772" char_id="-1" frame_id="-1" name=""
		   text="直腸に打ち込まれた剛直に、下からの肉棒が激しくぶつかる。" voices=""/>
		<msg @l="773" char_id="-1" frame_id="-1" name=""
		   text="陰茎に摘み上げられ膣壁がこすり合わせられる。" voices=""/>
		<msg @l="775" char_id="0" frame_id="-1" name="美帆"
		   text="『あ、ああっ‥‥んっ‥‥‥‥ダメ‥‥‥これ以上は、んんっ！』" voices="miho10550"/>
		<msg @l="776" char_id="0" frame_id="-1" name="美帆"
		   text="『ダメっ‥‥それ、後ろのと擦れちゃって‥‥‥‥ん、あぐっ！！』" voices="miho11180"/>
		<msg @l="778" char_id="0" frame_id="-1" name="美帆"
		   text="『ああ、ああああっ‥‥‥そんな深く‥‥‥ダメ、あっ、頭‥‥おかしく‥‥‥なっちゃうぅ‥‥‥んっ‥‥ああっ！！』"
		   voices="miho10410"/>
		<msg @l="780" char_id="-1" frame_id="-1" name="会社員Ｊ"
		   text="『この女、激しくしたら俺のチ○ポに絡み付けてきやがった。』" voices=""/>
		<msg @l="782" char_id="-1" frame_id="-1" name="会社員Ｋ"
		   text="『この売女！、メス犬！電車の中で力任せに輪姦されてよがるなんで変態じゃやねぇの！』" voices=""/>
		<msg @l="784" char_id="-1" frame_id="-1" name=""
		   text="そう言いながらも二人の男は私の身体の反応に興奮し、より激しく突き上げてきた。" voices=""/>
		<msg @l="786" char_id="0" frame_id="-1" name="美帆"
		   text="『んぁぁっ‥‥もぅ、やぁぁ‥‥ダメェェ‥‥‥‥。』" voices="miho10560"/>
		<msg @l="788" char_id="0" frame_id="-1" name="美帆"
		   text="『ああっ‥‥‥ダメ‥‥‥‥また、いく‥‥‥いっちゃ、んんっっ！』" voices="miho10520"/>
		<msg @l="790" char_id="-1" frame_id="-1" name="会社員Ｊ"
		   text="『お、俺もう出すぜっ！俺の濃いザーメンを受け止めてろよ。』" voices=""/>
		<msg @l="792" char_id="-1" frame_id="-1" name="会社員Ｋ"
		   text="『俺も、もう我慢できねぇっ！たっぷりと注ぎ込んでやるっ！』" voices=""/>
		<msg @l="794" char_id="0" frame_id="-1" name="美帆"
		   text="『んうっ‥‥ああ、いくっ‥‥‥いく、いくいくいくっっ‥‥‥。』" voices="miho05090"/>
		<msg @l="796" char_id="-1" frame_id="-1" name=""
		   text="男達が一斉に濃くてたまった精液を噴火させる。" voices=""/>
		<msg @l="798" char_id="-1" frame_id="-1" name="" text="びゅるるるるるるるるるるるるるるるるる"
		   voices=""/>
		<msg @l="800" char_id="0" frame_id="-1" name="美帆" text="『んんんっっ！！！』"
		   voices="miho05100"/>
		<flash @l="803" count="4" fade="100" image="white"/>
		<wait_chgmv/>
		<ev @l="806" src="ev-034y1y3z1z2z4z3z5"/>
		<msg @l="808" char_id="0" frame_id="-1" name="美帆" text="『い、ああああああああああっ！！！』"
		   voices="miho04870"/>
		<msg @l="810" char_id="-1" frame_id="-1" name=""
		   text="３度目となる熱くて白い溶岩が、私の肌を隠す程降り注いだのだった。" voices=""/>
		<clear @l="813" class="all"/>
		<wait @l="815" time="1000"/>
		<msg @l="817" char_id="-1" frame_id="-1" name="" text="その後―――" voices=""/>
		<msg @l="818" char_id="-1" frame_id="-1" name=""
		   text="次から次へと、男たちは私の身体へ白濁液を注いでいった。" voices=""/>
		<msg @l="819" char_id="-1" frame_id="-1" name=""
		   text="そしてまた別の男たちが、その精液にまみれた私の身体を弄ぶように、胸を責め、尻をかきむしっては再び肉棒を硬く勃起させていく。"
		   voices=""/>
		<msg @l="820" char_id="-1" frame_id="-1" name=""
		   text="膣とお尻のつぼみからは何度も吐き出された大量の男達の欲液が穴に入りきらずゴボゴボと逆流している。" voices=""/>
		<clear @l="823" class="all"/>
		<msg @l="825" char_id="-1" frame_id="-1" name=""
		   text="────どれくらいの時間が経っただろう･･････。" voices=""/>
		<msg @l="826" char_id="-1" frame_id="-1" name=""
		   text="────どれくらいの人に犯されたのだろう･･････。" voices=""/>
		<msg @l="827" char_id="-1" frame_id="-1" name=""
		   text="────どれくらいの精液を穴という穴にだされたのだろう･･････。" voices=""/>
		<msg @l="829" char_id="-1" frame_id="-1" name=""
		   text="私は朦朧として何も覚えていなかった･･････。" voices=""/>
		<wait_chgmv/>
		<ev @l="832" src="ev-034x1z1z2z4z3z5"/>
		<msg @l="834" char_id="-1" frame_id="-1" name="朽木"
		   text="『ククク‥‥。綺麗だ。綺麗だよ、美帆君。これからも毎日たっぷりと犯してあげるよ。』" voices=""/>
		<msg @l="836" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥ぅぁ‥‥。』"
		   voices="miho00430"/>
		<msg @l="838" char_id="-1" frame_id="-1" name="朽木" text="『さぁ、次はどなたにしますか？』"
		   voices=""/>
		<msg @l="840" char_id="-1" frame_id="-1" name="会社員Ｚ"
		   text="『やっと回ってきたぜ、次は俺だな。』" voices=""/>
		<msg @l="842" char_id="-1" frame_id="-1" name=""
		   text="そういうと、強面系の会社員は真珠入りの肉棒を取り出して美帆にあてがう。" voices=""/>
		<msg @l="844" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥ぁっ‥‥。』"
		   voices="miho00840"/>
		<msg @l="846" char_id="-1" frame_id="-1" name="朽木"
		   text="『ほほぅ、それを突き刺してあげれば仲根クンは気が狂うほどよがるのではないかな。』" voices=""/>
		<msg @l="848" char_id="-1" frame_id="-1" name="会社員Ｚ"
		   text="『へへっ、俺のを入れたら狂うどころか壊れちゃうかもしれないけどね。』" voices=""/>
		<msg @l="850" char_id="-1" frame_id="-1" name="朽木" text="『ふふっ、どうぞどうぞご自由に。』"
		   voices=""/>
		<msg @l="852" char_id="-1" frame_id="-1" name="会社員Ａ"
		   text="『じゃあ、俺も2回戦目に入るかな。この子可愛いから今日は最低10回やってやるぜ。』" voices=""/>
		<msg @l="854" char_id="-1" frame_id="-1" name=""
		   text="男達の卑猥な会話が交わされる中、絶頂の余韻に浸る美帆にその言葉は届く事はなかった。" voices=""/>
		<msg @l="856" char_id="0" frame_id="-1" name="美帆"
		   text="(‥‥もう‥‥どうなってもいい‥‥‥‥)" voices="miho10570"/>
		<msg @l="858" char_id="0" frame_id="-1" name="美帆"
		   text="(もう疲れちゃった‥‥‥‥疲れちゃったよ‥‥‥‥)" voices="miho10580"/>
		<msg @l="860" char_id="-1" frame_id="-1" name="" text="私は‥‥ゆっくりと、堕ちていく。"
		   voices=""/>
		<msg @l="862" char_id="-1" frame_id="-1" name=""
		   text="そして、新たな男達の肉棒が美帆に侵入してくるのだった―――" voices=""/>
		<clear @l="865" class="all"/>
		<stopse @l="868" buf="3"/>
		<wait_chgmv/>
		<bg @l="871" src="black"/>
		<end_scene @l="874"/>
		<wait @l="877" time="1500"/>
		<call @l="880" target="EventLabel_47@ending09"/>
		<return @l="881" value="0&#13;&#10;"/>
	</code>
</xscript>
