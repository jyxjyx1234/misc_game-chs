<?xml version="1.0" encoding="utf-8"?>
<xscript>
	<debug editor="&quot;C:\Program&#32;Files&#32;(x86)\sakura\sakura.exe&quot;&#32;&quot;%src%&quot;&#32;-Y=%line%"
	   src="D:\シロップ\町ぐるみの罠＋汚された夏セット版\汚された夏\完成データ\汚された夏\script\text\root_rei05b.txt"/>
	<code>
		<label @l="12" id="EventLabel_143"/>
		<description @l="16" text="ルームメイトの憂鬱・５日目(Ｂ)"/>
		<eval @l="18" expr="f.numDay=13&#13;&#10;"/>
		<msgshow @l="20" show="false"/>
		<wait_chgmv/>
		<bg @l="22" src="day13" time="2000"/>
		<wait @l="24" time="500"/>
		<wait_chgmv/>
		<bg @l="26" src="black" time="2000"/>
		<msgshow @l="28" show="true"/>
		<wait_chgmv/>
		<bg @l="32" src="bg01c"/>
		<bgm @l="36" src="bgm03" volume="1."/>
		<msg @l="38" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="40" char_id="-1" frame_id="-1" name="" text="あの夜から既に二日が経っていた。"
		   voices=""/>
		<msg @l="41" char_id="-1" frame_id="-1" name=""
		   text="朽木教授にレイプされて処女を失ったあの夜―――。" voices=""/>
		<msg @l="42" char_id="-1" frame_id="-1" name=""
		   text="理不尽な蹂躙をされながらも、私は結局、朽木教授を告発することが出来なかった。" voices=""/>
		<msg @l="43" char_id="-1" frame_id="-1" name=""
		   text="頼みの綱である警察にもマトモに取り合って貰えず、かといってそれ以外に頼るところなどなくて‥‥。" voices=""/>
		<msg @l="44" char_id="-1" frame_id="-1" name=""
		   text="私は部屋のヌイグルミにやつあたりをして、それから泣き続けた。" voices=""/>
		<msg @l="46" char_id="-1" frame_id="-1" name=""
		   text="何がいけなかったのか、どうして自分ばかりがこんな目に遭うのか。" voices=""/>
		<msg @l="47" char_id="-1" frame_id="-1" name=""
		   text="部屋で一人、呆然と壁や天井を眺めながら‥‥。" voices=""/>
		<msg @l="50" char_id="0" frame_id="-1" name="美帆" text="『玲さん‥‥どうしてるのかな？』"
		   voices=""/>
		<msg @l="52" char_id="-1" frame_id="-1" name="" text="かすれた声で私はつぶやいてみる。"
		   voices=""/>
		<msg @l="53" char_id="-1" frame_id="-1" name="" text="あれから、玲さんは帰ってこなかった。"
		   voices=""/>
		<msg @l="54" char_id="-1" frame_id="-1" name=""
		   text="もちろん私も一日中起きていたわけではないから、ひょっとしたら眠っているうちに帰ってきていたのかもしれないけれど‥‥‥。"
		   voices=""/>
		<msg @l="55" char_id="-1" frame_id="-1" name=""
		   text="やはり朽木教授が言うように、彼女の身に良くないことが起こっているのか。" voices=""/>
		<msg @l="56" char_id="-1" frame_id="-1" name="" text="それとも‥‥。" voices=""/>
		<wait_chgmv/>
		<bg @l="60" src="bg03c"/>
		<char @l="64" id="miho" pos="auto" src="miho136"/>
		<msg @l="66" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="68" char_id="-1" frame_id="-1" name=""
		   text="僅かな空腹感を覚え、のろのろと部屋を出てリビングに向かう。" voices=""/>
		<msg @l="69" char_id="-1" frame_id="-1" name=""
		   text="そういえば昨日の夜に少しだけ食事をして以来、何も食べていなかった。" voices=""/>
		<clear @l="73" class="char"/>
		<msg @l="75" char_id="-1" frame_id="-1" name=""
		   text="キッチンに入り、電気も点けず冷蔵庫の扉を開ける。" voices=""/>
		<msg @l="76" char_id="-1" frame_id="-1" name=""
		   text="買い物をしていないから、冷蔵庫の中身はガランとしていた。" voices=""/>
		<msg @l="77" char_id="-1" frame_id="-1" name=""
		   text="とりあえず卵でも焼こうかと思って、使いかけのパックに手を伸ばそうとしたその時‥‥。" voices=""/>
		<se @l="81" buf="1" src="扉を開ける音_木製" volume="1."/>
		<stopbgm @l="85" fadeout="1000"/>
		<char @l="89" id="miho" pos="auto" src="miho134"/>
		<msg @l="91" char_id="0" frame_id="-1" name="美帆" text="『‥‥！？』" voices=""/>
		<char @l="94" id="miho" pos="auto" src="miho135"/>
		<msg @l="96" char_id="-1" frame_id="-1" name=""
		   text="不意にリビングの扉の開く音が聞こえ、私は慌てて振り返る。" voices=""/>
		<msg @l="97" char_id="-1" frame_id="-1" name=""
		   text="あの夜の恐怖が蘇って足が小刻みに震えていた。" voices=""/>
		<char @l="101" id="rei" pos="auto" src="rei125"/>
		<bgm @l="105" src="bgm03" volume="1."/>
		<msg @l="107" char_id="1" frame_id="-1" name="玲" text="『‥‥‥‥。』" voices=""/>
		<msg @l="109" char_id="0" frame_id="-1" name="美帆" text="『あ‥‥玲さん‥‥。』"
		   voices=""/>
		<msg @l="111" char_id="-1" frame_id="-1" name=""
		   text="振り返った先に立っていたのは玲さんだった。" voices=""/>
		<msg @l="112" char_id="-1" frame_id="-1" name=""
		   text="二日ぶりに見る彼女はひどく憔悴しているようで、顔色が悪い。" voices=""/>
		<msg @l="114" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="116" char_id="-1" frame_id="-1" name="" text="言葉が続かなかった。" voices=""/>
		<msg @l="117" char_id="-1" frame_id="-1" name="" text="何を話せばいいのかが解らない。"
		   voices=""/>
		<msg @l="118" char_id="-1" frame_id="0" name="" text="「二日も帰らずどうしたんですか？」"
		   voices=""/>
		<msg @l="119" char_id="-1" frame_id="0" name=""
		   text="「何か大変なことになっていたりしませんでしたか？」" voices=""/>
		<msg @l="120" char_id="-1" frame_id="0" name="" text="「私、朽木教授にレイプされました‥‥。」"
		   voices=""/>
		<msg @l="121" char_id="-1" frame_id="-1" name="" text="どれもこれもしっくりこない。"
		   voices=""/>
		<msg @l="122" char_id="-1" frame_id="-1" name=""
		   text="つい数日前まで同じ場所で暮らしていたはずなのに、家族のように思えてきていたというのに。" voices=""/>
		<msg @l="123" char_id="-1" frame_id="-1" name=""
		   text="いつの間にか私たちを結んでいた絆は途切れていた‥‥。" voices=""/>
		<msg @l="125" char_id="1" frame_id="-1" name="玲" text="『‥‥着替えを取りに帰っただけ。』"
		   voices=""/>
		<msg @l="127" char_id="1" frame_id="-1" name="玲" text="『また、しばらく帰らなくなると思うわ。』"
		   voices=""/>
		<clear @l="131" class="char"/>
		<char @l="135" id="miho" pos="auto" src="miho034"/>
		<msg @l="137" char_id="0" frame_id="-1" name="美帆" text="『え‥‥？』" voices=""/>
		<msg @l="139" char_id="-1" frame_id="-1" name=""
		   text="彼女はそれだけを言うと、キッチンの入り口に立っている私の目の前を、そのまま通り過ぎて自分の部屋へと向かった。" voices=""/>
		<char @l="143" id="miho" pos="auto" src="miho135"/>
		<msg @l="145" char_id="0" frame_id="-1" name="美帆" text="(‥‥玲さん、やっぱり何かあったんだ)"
		   voices=""/>
		<msg @l="147" char_id="0" frame_id="-1" name="美帆"
		   text="(でも‥‥多分、それを聞いても私にはなにもできない‥‥‥)" voices=""/>
		<msg @l="149" char_id="0" frame_id="-1" name="美帆"
		   text="(過ぎた時間が戻らない限り‥‥なにも‥‥‥‥)" voices=""/>
		<char @l="153" id="rei" pos="auto" src="rei125"/>
		<msg @l="155" char_id="-1" frame_id="-1" name=""
		   text="部屋から出てきた玲さんは、大きなボストンバックを手にしていた。" voices=""/>
		<msg @l="156" char_id="-1" frame_id="-1" name=""
		   text="先ほど言っていた着替えが入っているのだろう。" voices=""/>
		<msg @l="158" char_id="1" frame_id="-1" name="玲" text="『‥‥‥‥。』" voices=""/>
		<clear @l="162" class="char"/>
		<msg @l="164" char_id="-1" frame_id="-1" name=""
		   text="玲さんは一瞬こちらを見て、そのまま玄関へ向かった。" voices=""/>
		<char @l="168" id="miho" pos="auto" src="miho135"/>
		<msg @l="172" async="true" char_id="-1" frame_id="-1" name=""
		   text="無言のまま立ち去ろうとする玲を‥‥？" voices=""/>
		<select @l="173">
			<menu @l="177" label="EventLabel_144" text="呼び止める"/>
			<menu @l="180" label="EventLabel_145" text="呼び止めない"/>
		</select>
		<label @l="189" id="EventLabel_144"/>
		<char @l="193" id="miho" pos="auto" src="miho035"/>
		<msg @l="195" char_id="0" frame_id="-1" name="美帆" text="『待ってくださいっ！』"
		   voices=""/>
		<msg @l="197" char_id="-1" frame_id="-1" name=""
		   text="それが余計なことなのだとわかっていながらも、私は思わず玲さんを呼び止めてしまっていた。" voices=""/>
		<msg @l="198" char_id="-1" frame_id="-1" name="" text="もちろん何か考えがあるわけではない。"
		   voices=""/>
		<msg @l="199" char_id="-1" frame_id="-1" name=""
		   text="ただ、このまま何もしなければ‥‥私たちの絆は完全に消えてしまう―――。" voices=""/>
		<msg @l="200" char_id="-1" frame_id="-1" name="" text="そう思った。" voices=""/>
		<clear @l="203" class="char"/>
		<char @l="205" id="miho" pos="left" src="miho035"/>
		<char @l="208" id="rei" pos="right" src="rei125"/>
		<msg @l="210" char_id="1" frame_id="-1" name="玲" text="『‥‥なに？』" voices=""/>
		<msg @l="212" char_id="-1" frame_id="-1" name=""
		   text="リビングの扉に手を掛けたまま、玲さんが振り返らず返事をする。" voices=""/>
		<msg @l="213" char_id="-1" frame_id="-1" name=""
		   text="その表情は苛立ち‥‥というよりも、寂しさに包まれていた。" voices=""/>
		<char @l="217" id="miho" pos="left" src="miho035"/>
		<msg @l="219" char_id="0" frame_id="-1" name="美帆" text="『玲さん‥‥帰ってきますよね？』"
		   voices=""/>
		<msg @l="221" char_id="0" frame_id="-1" name="美帆" text="『必ず、帰ってきますよね？』"
		   voices=""/>
		<msg @l="223" char_id="1" frame_id="-1" name="玲" text="『‥‥‥‥。』" voices=""/>
		<msg @l="225" char_id="1" frame_id="-1" name="玲" text="『‥‥わからない。』" voices=""/>
		<msg @l="227" char_id="1" frame_id="-1" name="玲"
		   text="『それに、アナタには関係のないことだわ‥‥。』" voices=""/>
		<char @l="231" id="miho" pos="left" src="miho034"/>
		<msg @l="233" char_id="0" frame_id="-1" name="美帆" text="『関係ないって‥‥そんなっ！』"
		   voices=""/>
		<char @l="236" id="miho" pos="left" src="miho035"/>
		<msg @l="238" char_id="0" frame_id="-1" name="美帆"
		   text="『私たち、ルームメイトですよね？&#32;そうですよね？』" voices=""/>
		<msg @l="240" char_id="1" frame_id="-1" name="玲" text="『‥‥だからなんだって言うのよ。』"
		   voices=""/>
		<char @l="243" id="rei" pos="right" src="rei017"/>
		<msg @l="245" char_id="1" frame_id="-1" name="玲"
		   text="『ルームメイトだから、同居人だからって何があるっていうの！』" voices=""/>
		<char @l="249" id="miho" pos="left" src="miho135"/>
		<msg @l="251" char_id="0" frame_id="-1" name="美帆" text="『あ‥‥。』" voices=""/>
		<char @l="254" id="rei" pos="right" src="rei125"/>
		<msg @l="256" char_id="1" frame_id="-1" name="玲"
		   text="『こんなの大学側が勝手に決めただけじゃない‥‥所詮は他人‥‥なのよ。』" voices=""/>
		<char @l="260" id="miho" pos="left" src="miho034"/>
		<msg @l="262" char_id="0" frame_id="-1" name="美帆"
		   text="『違うっ‥‥そんな‥‥他人なんかじゃ‥‥私は玲さんのこと‥‥。』" voices=""/>
		<char @l="266" id="rei" pos="right" src="rei017"/>
		<msg @l="268" char_id="1" frame_id="-1" name="玲" text="『綺麗事はやめてっ！！』"
		   voices=""/>
		<char @l="271" id="miho" pos="left" src="miho035"/>
		<msg @l="273" char_id="0" frame_id="-1" name="美帆" text="『‥‥！？』" voices=""/>
		<char @l="277" id="rei" pos="right" src="rei125"/>
		<msg @l="279" char_id="1" frame_id="-1" name="玲" text="『お願い‥‥。』" voices=""/>
		<msg @l="281" char_id="1" frame_id="-1" name="玲" text="『もう、私に関わらないで‥‥。』"
		   voices=""/>
		<clear @l="285" layer="rei"/>
		<char @l="288" id="miho" pos="left" src="miho134"/>
		<msg @l="290" char_id="0" frame_id="-1" name="美帆" text="『あっ‥‥。』" voices=""/>
		<msg @l="292" char_id="-1" frame_id="-1" name=""
		   text="玲さんは、すべてを振り払うように部屋を出て行った。" voices=""/>
		<msg @l="293" char_id="-1" frame_id="-1" name="" text="まるで‥‥私から逃げるように。"
		   voices=""/>
		<msg @l="295" char_id="0" frame_id="-1" name="美帆" text="『玲さんっ！』" voices=""/>
		<clear @l="301" class="all"/>
		<wait_chgmv/>
		<bg @l="305" src="bg05b"/>
		<char @l="309" id="miho" pos="auto" src="miho135"/>
		<msg @l="311" char_id="-1" frame_id="-1" name="" text="玲さんを追って外に出る。"
		   voices=""/>
		<msg @l="312" char_id="-1" frame_id="-1" name=""
		   text="それまで何度も外へ向けようとしていたのに動かなかった両足が、今は何でもなかったように動く。" voices=""/>
		<msg @l="313" char_id="-1" frame_id="-1" name="" text="どうしてかはわからない。"
		   voices=""/>
		<msg @l="314" char_id="-1" frame_id="-1" name=""
		   text="ただ、行かなくちゃいけない‥‥そう思った。" voices=""/>
		<msg @l="316" char_id="0" frame_id="-1" name="美帆" text="(玲さんは‥‥？)" voices=""/>
		<msg @l="318" char_id="-1" frame_id="-1" name="" text="廊下に彼女の姿は無い。"
		   voices=""/>
		<msg @l="319" char_id="-1" frame_id="-1" name=""
		   text="ハッとしてエレベータの前まで行くと、玲さんを乗せて一階に向けて動き始めたところだった。" voices=""/>
		<char @l="322" id="miho" pos="auto" src="miho035"/>
		<msg @l="324" char_id="0" frame_id="-1" name="美帆" text="『くっ‥‥。』" voices=""/>
		<clear @l="328" class="char"/>
		<msg @l="330" char_id="-1" frame_id="-1" name="" text="私はそのまま階段に向かって走り出す。"
		   voices=""/>
		<msg @l="331" char_id="-1" frame_id="-1" name=""
		   text="陸上競技全般に疎い私では、エレベータよりははるかに遅い。" voices=""/>
		<msg @l="332" char_id="-1" frame_id="-1" name=""
		   text="けれど、ただ黙って見ていることも諦めることも‥‥出来なかった。" voices=""/>
		<msg @l="334" char_id="0" frame_id="-1" name="美帆" text="『はぁ‥‥はぁ‥‥はぁ‥‥‥。』"
		   voices=""/>
		<msg @l="336" char_id="-1" frame_id="-1" name=""
		   text="階段を下り、荒い息を吐きながらマンションの出口をくぐる。" voices=""/>
		<msg @l="338" char_id="1" frame_id="-1" name="玲" text="『‥‥‥‥。』" voices=""/>
		<msg @l="340" char_id="-1" frame_id="-1" name=""
		   text="外に出た瞬間、僅かだけ玲さんの背中が見える。" voices=""/>
		<msg @l="341" char_id="-1" frame_id="-1" name="" text="どうやら駅の方に向かうつもりのようだ。"
		   voices=""/>
		<msg @l="343" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="345" char_id="0" frame_id="-1" name="美帆" text="(玲さん‥‥)" voices=""/>
		<msg @l="347" char_id="-1" frame_id="-1" name=""
		   text="私もまた‥‥玲さんの背中を追って、歩いていった。" voices=""/>
		<clear @l="353" class="all"/>
		<wait_chgmv/>
		<bg @l="357" src="bg18b"/>
		<char @l="361" id="rei" pos="auto" src="rei115"/>
		<msg @l="363" char_id="1" frame_id="-1" name="玲" text="『‥‥‥‥。』" voices=""/>
		<clear @l="367" class="char"/>
		<char @l="371" id="miho" pos="auto" src="miho135"/>
		<msg @l="373" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="375" char_id="-1" frame_id="-1" name="" text="駅前に着く。" voices=""/>
		<msg @l="376" char_id="-1" frame_id="-1" name=""
		   text="玲さんは何かに取り憑かれたように、夜の街中を黙々と歩いていた。" voices=""/>
		<msg @l="377" char_id="-1" frame_id="-1" name="" text="私もまた‥‥黙々とその背中を追っていた。"
		   voices=""/>
		<msg @l="379" char_id="0" frame_id="-1" name="美帆"
		   text="(こんな尾行みたいな真似‥‥ちょっと気が引けるけど)" voices=""/>
		<msg @l="381" char_id="0" frame_id="-1" name="美帆"
		   text="(でも、ここまで来たら引き返せない‥‥‥)" voices=""/>
		<msg @l="383" char_id="-1" frame_id="-1" name=""
		   text="私は僅かに息を弾ませながら、彼女の背中を見失わないように距離を保つ。" voices=""/>
		<msg @l="384" char_id="-1" frame_id="-1" name=""
		   text="夜中なので人通りも少なく、見つからないようにと余計に気をつけながら、後を追った。" voices=""/>
		<msg @l="386" char_id="1" frame_id="-1" name="玲" text="『‥‥‥‥。』" voices=""/>
		<msg @l="388" char_id="-1" frame_id="-1" name=""
		   text="玲さんは路線電車の線路を渡り、オフィス街へと入っていく。" voices=""/>
		<msg @l="389" char_id="-1" frame_id="-1" name=""
		   text="停留所は線路よりも手前にあるから、大学に向かうわけではないようだ。" voices=""/>
		<msg @l="391" char_id="0" frame_id="-1" name="美帆"
		   text="(こんな夜中にどこに行く気なんだろう？)" voices=""/>
		<msg @l="393" char_id="0" frame_id="-1" name="美帆"
		   text="(大学じゃないとすると‥‥‥‥‥あ、もしかして大黒建設に？)" voices=""/>
		<msg @l="395" char_id="-1" frame_id="-1" name=""
		   text="彼女の向かっているオフィス街には大黒建設の南総町支社がある。" voices=""/>
		<msg @l="396" char_id="-1" frame_id="-1" name=""
		   text="私の知る限り、この付近で玲さんが行く場所といえばそこくらいだ。" voices=""/>
		<msg @l="398" char_id="0" frame_id="-1" name="美帆"
		   text="(でも、こんな時間に大黒建設で何をするつもりなんだろう‥‥？)" voices=""/>
		<msg @l="400" char_id="-1" frame_id="-1" name=""
		   text="私は疑問を胸に‥‥人通りの少なくなったオフィス街を、玲さんの後をつけるように歩いていった。" voices=""/>
		<clear @l="406" class="all"/>
		<msg @l="408" char_id="1" frame_id="-1" name="玲" text="『‥‥‥‥。』" voices=""/>
		<msg @l="410" char_id="-1" frame_id="-1" name="" text="大黒建設社屋前で、玲さんが立ち止まる。"
		   voices=""/>
		<msg @l="411" char_id="-1" frame_id="-1" name=""
		   text="そうして‥‥彼女は周囲の様子をぐるりと見回した。" voices=""/>
		<msg @l="413" char_id="0" frame_id="-1" name="美帆" text="『‥‥！！』" voices=""/>
		<msg @l="415" char_id="-1" frame_id="-1" name="" text="私は慌てて手近な小道に入り、身を隠す。"
		   voices=""/>
		<msg @l="416" char_id="-1" frame_id="-1" name=""
		   text="後をつけられている事に気付いたという感じではなく、周囲に見知った人間がいないかどうかを警戒してるようだ。" voices=""/>
		<msg @l="417" char_id="-1" frame_id="-1" name=""
		   text="そうして、しばらく息を潜めるように身を隠していると‥‥。" voices=""/>
		<msg @l="418" char_id="-1" frame_id="-1" name=""
		   text="玲さんはそのまま大黒建設の中へと入っていった。" voices=""/>
		<msg @l="420" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="422" char_id="0" frame_id="-1" name="美帆" text="(やっぱり大黒建設に用があるんだ‥‥)"
		   voices=""/>
		<msg @l="424" char_id="0" frame_id="-1" name="美帆" text="(でも、どうして‥‥‥？)"
		   voices=""/>
		<msg @l="426" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="428" char_id="0" frame_id="-1" name="美帆"
		   text="(ううん‥‥考えてる場合じゃない、自分で確かめなくちゃ)" voices=""/>
		<msg @l="430" char_id="0" frame_id="-1" name="美帆"
		   text="(他人事なんかじゃないから‥‥絆は、ちゃんとあるから)" voices=""/>
		<msg @l="432" char_id="-1" frame_id="-1" name=""
		   text="自分に言い聞かせるように呟いて、私は彼女を追って大黒建設の中へと入っていった。" voices=""/>
		<se @l="436" buf="1" src="自動ドアの音" volume="1."/>
		<msg @l="438" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="440" char_id="-1" frame_id="-1" name=""
		   text="玲さんが、誰もいない受付の前を素通りしたのを見て、私も何も言わないで通ってみる。" voices=""/>
		<msg @l="441" char_id="-1" frame_id="-1" name=""
		   text="とりあえず彼女がエレベータに乗り込むのを見て、何階で止まるかを確かめてから隣のエレベータに乗った。" voices=""/>
		<wait_chgmv/>
		<bg @l="445" src="bg17bh1"/>
		<char @l="449" id="miho" pos="auto" src="miho135"/>
		<msg @l="451" char_id="0" frame_id="-1" name="美帆" text="(えっと‥‥)" voices=""/>
		<msg @l="453" char_id="-1" frame_id="-1" name=""
		   text="玲さんの降りた階で私も降りて、周囲の様子を伺いながらオフィスの入り口まで来る。" voices=""/>
		<msg @l="454" char_id="-1" frame_id="-1" name=""
		   text="エレベータを降りてからオフィス入り口までの廊下にはトイレと給湯室しかなくて、こちらへ来るしかなかった。" voices=""/>
		<msg @l="455" char_id="-1" frame_id="-1" name=""
		   text="オフィス入り口にあるプレートには「人材派遣部」と書かれていた。" voices=""/>
		<msg @l="457" char_id="0" frame_id="-1" name="美帆" text="(‥‥どこいっちゃったのかな)"
		   voices=""/>
		<msg @l="459" char_id="-1" frame_id="-1" name=""
		   text="私はオフィスの入り口にある壁際に身を寄せて、中を覗き見るような形で玲さんの姿を探そうとする。" voices=""/>
		<msg @l="460" char_id="-1" frame_id="-1" name=""
		   text="夜中の為、誰もオフィスにはいないといえ、さすがに堂々と探し回るわけには行かなかった。" voices=""/>
		<msg @l="461" char_id="-1" frame_id="-1" name=""
		   text="もし見回りの警備員や、残業している社員に見つかったら大変だ。" voices=""/>
		<msg @l="463" char_id="-1" frame_id="-1" name="声" text="『オマエ、そんなとこで何やってんだ？』"
		   voices=""/>
		<char @l="467" id="miho" pos="auto" src="miho134"/>
		<msg @l="469" char_id="0" frame_id="-1" name="美帆" text="『きゃっ‥‥！？』" voices=""/>
		<msg @l="471" char_id="-1" frame_id="-1" name=""
		   text="背後から声を掛けられ、私は思わず息を飲む。" voices=""/>
		<msg @l="472" char_id="-1" frame_id="-1" name=""
		   text="慌てて振り返ると‥‥目つきの鋭い強面の男性が私を睨んでいた。" voices=""/>
		<char @l="476" id="miho" pos="auto" src="miho035"/>
		<msg @l="478" char_id="0" frame_id="-1" name="美帆"
		   text="『あ、あの‥‥勝手に入ってしまってすみません。でも、私は別に怪しいものではなくてですね‥‥‥。』" voices=""/>
		<msg @l="480" char_id="-1" frame_id="-1" name="男子社員"
		   text="『怪しいヤツは大抵そーいうんだよ。』" voices=""/>
		<char @l="482" id="miho" pos="auto" src="miho036"/>
		<msg @l="483" char_id="0" frame_id="-1" name="美帆"
		   text="『うぅ‥‥それは、そうかもしれませんけど。』" voices=""/>
		<msg @l="485" char_id="0" frame_id="-1" name="美帆" text="『私は人を訪ねて来ただけで‥‥。』"
		   voices=""/>
		<msg @l="487" char_id="1" frame_id="-1" name="声" text="『‥‥美帆？』" voices=""/>
		<char @l="491" id="miho" pos="auto" src="miho034"/>
		<msg @l="493" char_id="0" frame_id="-1" name="美帆" text="『え‥‥。』" voices=""/>
		<clear @l="496" class="char"/>
		<char @l="498" id="miho" pos="left" src="miho034"/>
		<char @l="501" id="rei" pos="right" src="rei115"/>
		<bgm @l="505" src="bgm05" volume="1."/>
		<msg @l="507" char_id="-1" frame_id="-1" name="" text="オフィスの方から玲さんが駆け寄ってくる。"
		   voices=""/>
		<msg @l="508" char_id="-1" frame_id="-1" name="" text="‥‥相変わらず顔色が悪い。"
		   voices=""/>
		<char @l="510" id="miho" pos="left" src="miho035"/>
		<msg @l="511" char_id="0" frame_id="-1" name="美帆" text="『玲さんっ！』" voices=""/>
		<msg @l="513" char_id="1" frame_id="-1" name="玲"
		   text="『アナタ、どうしてこんなところに‥‥‥。』" voices=""/>
		<char @l="515" id="rei" pos="right" src="rei125"/>
		<msg @l="516" char_id="1" frame_id="-1" name="玲"
		   text="『‥‥もしかして、家からずっと尾行けてたの？』" voices=""/>
		<char @l="520" id="miho" pos="left" src="miho135"/>
		<msg @l="522" char_id="0" frame_id="-1" name="美帆" text="『‥‥はい。』" voices=""/>
		<msg @l="524" char_id="0" frame_id="-1" name="美帆"
		   text="『悪いとは思ったんですけど‥‥気付いたら身体が動いてて。』" voices=""/>
		<char @l="528" id="rei" pos="right" src="rei017"/>
		<msg @l="530" char_id="1" frame_id="-1" name="玲"
		   text="『どうして‥‥私、言ったハズよね？&#32;私には関わらない方がいいって。』" voices=""/>
		<char @l="533" id="rei" pos="right" src="rei115"/>
		<msg @l="534" char_id="1" frame_id="-1" name="玲"
		   text="『なのに、尾行なんて馬鹿な真似を‥‥‥しかもこんな所まで。』" voices=""/>
		<char @l="538" id="miho" pos="left" src="miho035"/>
		<msg @l="540" char_id="0" frame_id="-1" name="美帆"
		   text="『玲さんこそ、何であんなこと言って出て行くんですかっ！』" voices=""/>
		<char @l="542" id="miho" pos="left" src="miho135"/>
		<msg @l="543" char_id="0" frame_id="-1" name="美帆"
		   text="『あんな風に言われたって‥‥放っておけるワケないですよ。』" voices=""/>
		<char @l="547" id="rei" pos="right" src="rei125"/>
		<msg @l="549" char_id="1" frame_id="-1" name="玲" text="『美帆‥‥。』" voices=""/>
		<bgm @l="553" src="bgm03" volume="1."/>
		<msg @l="555" char_id="-1" frame_id="-1" name="男子社員"
		   text="『はいはい、そこまでにしてもらおうか。』" voices=""/>
		<msg @l="557" char_id="-1" frame_id="-1" name=""
		   text="それまでうんざりした表情を浮かべながら、私たちの会話を聞いていた目つきの鋭い強面な男性が、わざとらしいため息と共に割って入ってくる。"
		   voices=""/>
		<msg @l="559" char_id="-1" frame_id="-1" name="男子社員"
		   text="『感動の対面だかなんだか知らねーけどよ、こっちにしてみりゃテメーらの事情なんてどうでもいーんだよ。』" voices=""/>
		<char @l="563" id="miho" pos="left" src="miho035"/>
		<msg @l="565" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="567" char_id="1" frame_id="-1" name="玲" text="『‥‥‥‥。』" voices=""/>
		<msg @l="569" char_id="-1" frame_id="-1" name="男子社員"
		   text="『へっ、物分りがよくって助かるね。』" voices=""/>
		<msg @l="571" char_id="-1" frame_id="-1" name="男子社員"
		   text="『それで？&#32;そっちのアンタは一体誰なんだい？』" voices=""/>
		<char @l="575" id="miho" pos="left" src="miho034"/>
		<msg @l="577" char_id="0" frame_id="-1" name="美帆" text="『え、あの‥‥私は‥‥‥。』"
		   voices=""/>
		<msg @l="579" char_id="1" frame_id="-1" name="玲" text="『彼女は‥‥私の大学の後輩です。』"
		   voices=""/>
		<msg @l="581" char_id="-1" frame_id="-1" name="男子社員" text="『ほう、学生さんってわけだ。』"
		   voices=""/>
		<char @l="585" id="miho" pos="left" src="miho135"/>
		<msg @l="587" char_id="0" frame_id="-1" name="美帆" text="『は、はい‥‥。』" voices=""/>
		<msg @l="589" char_id="-1" frame_id="-1" name="男子社員" text="『‥‥‥‥。』"
		   voices=""/>
		<msg @l="591" char_id="-1" frame_id="-1" name=""
		   text="じっと‥‥彼が値踏みするような目で私を見つめてくる。" voices=""/>
		<msg @l="592" char_id="-1" frame_id="-1" name=""
		   text="特に腰のラインや胸元に、ねっとりと絡みつくようないやらしい視線を感じた。" voices=""/>
		<char @l="595" id="miho" pos="left" src="miho135"/>
		<msg @l="597" char_id="0" frame_id="-1" name="美帆" text="『え？‥‥な、なんですか。』"
		   voices=""/>
		<msg @l="599" char_id="-1" frame_id="-1" name="男子社員"
		   text="『アンタ、見込みあるな。ここの社員になんねーか？』" voices=""/>
		<char @l="602" id="miho" pos="left" src="miho034"/>
		<msg @l="604" char_id="0" frame_id="-1" name="美帆" text="『社員ですか‥‥？』"
		   voices=""/>
		<msg @l="606" char_id="-1" frame_id="-1" name="男子社員"
		   text="『そ、社員になって男性スタッフに色んな奉仕をするんだよ。』" voices=""/>
		<char @l="610" id="rei" pos="right" src="rei014"/>
		<msg @l="612" char_id="1" frame_id="-1" name="玲"
		   text="『ま、真島（まじま）さん‥‥そんな、彼女は‥‥‥‥。』" voices=""/>
		<msg @l="614" char_id="-1" frame_id="-1" name="真島"
		   text="『うるせーな、テメェはちょっと黙ってろや。』" voices=""/>
		<msg @l="616" char_id="1" frame_id="-1" name="玲" text="『あっ‥‥。』" voices=""/>
		<clear @l="620" class="char"/>
		<char @l="623" id="rei" pos="center" src="rei014f" y="-80"/>
		<msg @l="625" char_id="-1" frame_id="-1" name=""
		   text="真島と呼ばれた彼は、玲さんの腰に手を回して一気に引き寄せた。" voices=""/>
		<msg @l="626" char_id="-1" frame_id="-1" name=""
		   text="そのまま、彼女は私に背を向けるようにして、男の胸元へ押さえつけられた。" voices=""/>
		<msg @l="627" char_id="-1" frame_id="-1" name=""
		   text="ようするに‥‥正面同士で抱き合っている、という感じだ。" voices=""/>
		<msg @l="629" char_id="-1" frame_id="-1" name="真島" text="『声、出すんじゃねーぞ。』"
		   voices=""/>
		<begin_trans @l="633" time="500"/>
		<layer @l="634" id="cutin_f" src="game_window_cutin" x="20" y="20" z="-1001"/>
		<layer @l="635" id="cutin" src="cut005b" x="32" y="32" z="-1000"/>
		<end_trans @l="636"/>
		<char @l="639" id="rei" pos="center" src="rei015f" y="-80"/>
		<msg @l="641" char_id="1" frame_id="-1" name="玲" text="『いやっ‥‥。』" voices=""/>
		<msg @l="643" char_id="-1" frame_id="-1" name="真島" text="『いいからじっとしてな、メス豚。』"
		   voices=""/>
		<msg @l="645" char_id="1" frame_id="-1" name="玲" text="『‥‥‥‥。』" voices=""/>
		<msg @l="647" char_id="-1" frame_id="-1" name=""
		   text="彼が玲さんの耳元で何かを囁くと、彼女はそれに頷いて抵抗を止めた。" voices=""/>
		<msg @l="649" char_id="-1" frame_id="-1" name="真島"
		   text="『気持ちよくなりてーんだろ？ここを、ぐちゅぐちゅに濡らして欲しいんだろ？』" voices=""/>
		<msg @l="651" char_id="1" frame_id="-1" name="玲" text="『‥‥‥‥はい。』" voices=""/>
		<msg @l="653" char_id="-1" frame_id="-1" name=""
		   text="玲の返事と同時に、下着の中に真島の手が突っ込まれる。" voices=""/>
		<msg @l="654" char_id="-1" frame_id="-1" name="" text="ぐちゅ、ぐちゅ。" voices=""/>
		<msg @l="656" char_id="1" frame_id="-1" name="玲" text="『ん‥‥‥んん‥‥‥。』"
		   voices=""/>
		<msg @l="658" char_id="-1" frame_id="-1" name="真島"
		   text="『へへっ、もう濡らしてやがるこの変態女っ。そらっ、そらっ、気持ちいいだろうが。』" voices=""/>
		<msg @l="660" char_id="-1" frame_id="-1" name=""
		   text="玲さんは声で嬲られながら、指で秘所をかき混ぜられ、出し入れされている。" voices=""/>
		<msg @l="662" char_id="1" frame_id="-1" name="玲" text="『ん‥‥‥はぁっ‥‥‥。』"
		   voices=""/>
		<char @l="666" id="rei" pos="center" src="rei013f" y="-80"/>
		<msg @l="668" char_id="0" frame_id="-1" name="美帆" text="『玲さん‥‥？』" voices=""/>
		<msg @l="670" char_id="1" frame_id="-1" name="玲"
		   text="『な、何でもないのっ‥‥‥気にしないで。』" voices=""/>
		<msg @l="672" char_id="1" frame_id="-1" name="玲"
		   text="『私のことはいいから、早く帰りなさ‥‥‥‥あ、んんっ！』" voices=""/>
		<msg @l="674" char_id="-1" frame_id="-1" name=""
		   text="玲さんが何か言おうとすると腰を抱いていない方の彼の手が動き、彼女の言葉が途切れる。" voices=""/>
		<msg @l="675" char_id="-1" frame_id="-1" name=""
		   text="何かをしているのだろうということはわかるのだけれど、それがなんなのかは、私がいる場所からでは見えないのでわからない。"
		   voices=""/>
		<msg @l="676" char_id="-1" frame_id="-1" name=""
		   text="だが、かすかにクチュクチュという水音が聞こえている。" voices=""/>
		<msg @l="678" char_id="0" frame_id="-1" name="美帆" text="『れ、玲さん‥‥大丈夫ですか？』"
		   voices=""/>
		<char @l="682" id="rei" pos="center" src="rei013f" y="-80"/>
		<msg @l="684" char_id="1" frame_id="-1" name="玲"
		   text="『だ、大丈夫よ‥‥私のことは構わなくていいから。』" voices=""/>
		<msg @l="686" char_id="0" frame_id="-1" name="美帆" text="『でも‥‥。』" voices=""/>
		<msg @l="688" char_id="-1" frame_id="-1" name="真島"
		   text="『構うなってんだから、放っておけばいいんじゃねーの？』" voices=""/>
		<msg @l="690" char_id="-1" frame_id="-1" name="真島"
		   text="『ま、俺はバレちゃっても全然構わねーけど？後輩のねーちゃん、こっちに来てみるか？』" voices=""/>
		<msg @l="692" char_id="1" frame_id="-1" name="玲"
		   text="『ダメっ‥‥本当に、私は大丈夫だから。お願い‥‥‥来ちゃダメ‥‥‥‥‥‥。』" voices=""/>
		<msg @l="694" char_id="-1" frame_id="-1" name=""
		   text="玲さんは肩越しに私を振り返り、桜色に染まった顔で必死に訴えた。" voices=""/>
		<msg @l="696" char_id="0" frame_id="-1" name="美帆" text="『玲さん‥‥。』" voices=""/>
		<msg @l="698" char_id="-1" frame_id="-1" name=""
		   text="私は彼女に歩み寄ろうとするが、拒絶され近寄れない。" voices=""/>
		<msg @l="700" char_id="-1" frame_id="-1" name="真島"
		   text="『後輩は巻き込みたくないってか？まったく健気なもんだよな。』" voices=""/>
		<msg @l="702" char_id="-1" frame_id="-1" name="真島"
		   text="『だが、そーいうアホらしいくらい健気なところを見ると逆に苛めたくなっちまうのが俺ってヤツでね。』" voices=""/>
		<msg @l="704" char_id="-1" frame_id="-1" name=""
		   text="真島は口の端をつりあげ、人差し指と中指で秘部内の肉壁をこすり上げた。" voices=""/>
		<msg @l="705" char_id="-1" frame_id="-1" name="" text="その瞬間―――。" voices=""/>
		<clear @l="711" class="all"/>
		<msg @l="713" char_id="1" frame_id="-1" name="玲" text="『ん、あぁぁぁっ！！』"
		   voices=""/>
		<msg @l="716" char_id="-1" frame_id="-1" name="" text="ぷしゅぁーーーーーーーーっ！"
		   voices=""/>
		<wait_chgmv/>
		<bg @l="720" src="bg17bh1"/>
		<msg @l="722" char_id="-1" frame_id="-1" name=""
		   text="玲さんが大きな声をあげたと同時に水音が室内に響きわたった。" voices=""/>
		<msg @l="723" char_id="-1" frame_id="-1" name=""
		   text="びくびくと身体を揺らしながら、懸命にスカートの裾を押さえ、その場に座り込む。" voices=""/>
		<msg @l="724" char_id="-1" frame_id="-1" name=""
		   text="玲さんが座り込んだ所には大量の水をこぼしたようなシミがひろがっていった。" voices=""/>
		<char @l="728" id="miho" pos="auto" src="miho034"/>
		<msg @l="730" char_id="0" frame_id="-1" name="美帆" text="『れい‥‥さん？』" voices=""/>
		<msg @l="732" char_id="1" frame_id="-1" name="玲"
		   text="『い、ああっ‥‥‥みないで‥‥‥‥‥みないでぇっ‥‥‥‥。』" voices=""/>
		<msg @l="734" char_id="-1" frame_id="-1" name=""
		   text="声を震わせながら、玲さんが懸命に懇願をする。" voices=""/>
		<msg @l="735" char_id="-1" frame_id="-1" name=""
		   text="私は何がおきたのかわからないまま‥‥呆然とそんな玲さんを見つめていた。" voices=""/>
		<msg @l="737" char_id="-1" frame_id="-1" name="真島"
		   text="『アハハハハハハッ‥‥このメス豚、後輩の見ている前でマ○コ弄られて小便もらしちまいやがったっ！！』" voices=""/>
		<msg @l="739" char_id="-1" frame_id="-1" name="真島" text="『もう立派な淫乱マゾだな、おい。』"
		   voices=""/>
		<msg @l="741" char_id="1" frame_id="-1" name="玲" text="『イヤァァァァっ‥‥‥！』"
		   voices=""/>
		<msg @l="743" char_id="-1" frame_id="-1" name=""
		   text="玲さんは悲痛な声を上げながらも、幾度となく腰を揺すっている。" voices=""/>
		<msg @l="744" char_id="-1" frame_id="-1" name=""
		   text="それは放尿の余韻に震えているのではなく‥‥真島の侮蔑の言葉に反応しているようだった。" voices=""/>
		<msg @l="746" char_id="1" frame_id="-1" name="玲" text="『ダメぇ‥‥身体がおかしいのっ‥‥‥。』"
		   voices=""/>
		<msg @l="748" char_id="1" frame_id="-1" name="玲"
		   text="『蔑まれて、恥ずかしい姿を見られて‥‥‥私‥‥‥感じちゃってるのぉ‥‥‥。』" voices=""/>
		<msg @l="750" char_id="-1" frame_id="-1" name="真島"
		   text="『オマエは俺が仕込んでやった最高級品の淫乱マゾだからな。』" voices=""/>
		<msg @l="752" char_id="-1" frame_id="-1" name="真島"
		   text="『そのうち、言葉で罵られるだけでイケるようにしてやるぜ。』" voices=""/>
		<msg @l="754" char_id="1" frame_id="-1" name="玲"
		   text="『んっ、そんな‥‥‥わたし‥‥わたしぃぃぃ‥‥‥。』" voices=""/>
		<msg @l="756" char_id="-1" frame_id="-1" name=""
		   text="真島の言葉に玲さんは悲しげな表情を浮かべ、身体を震わせた。" voices=""/>
		<msg @l="757" char_id="-1" frame_id="-1" name=""
		   text="心では拒んでいるのに、身体は彼の言葉にしっかりと感じているのだ‥‥。" voices=""/>
		<char @l="761" id="miho" pos="auto" src="miho135"/>
		<msg @l="763" char_id="0" frame_id="-1" name="美帆" text="『くっ‥‥。』" voices=""/>
		<msg @l="765" char_id="-1" frame_id="-1" name=""
		   text="私はそうして床に座り込んで身悶えている彼女の姿を見て、怒りを感じていた。" voices=""/>
		<msg @l="766" char_id="-1" frame_id="-1" name=""
		   text="どうして玲さんがこんな目に会わなければならないのか。" voices=""/>
		<msg @l="768" char_id="-1" frame_id="-1" name="真島"
		   text="『とまあ、こーいう仕事をアンタにもやってもらいたいワケ。』" voices=""/>
		<char @l="772" id="miho" pos="auto" src="miho034"/>
		<msg @l="774" char_id="0" frame_id="-1" name="美帆"
		   text="『なっ！！ひどい‥‥こんなの、ひどすぎますっ。』" voices=""/>
		<msg @l="776" char_id="-1" frame_id="-1" name="真島"
		   text="『いいねぇ、その怒りに震える顔ってやつ。』" voices=""/>
		<msg @l="778" char_id="-1" frame_id="-1" name="真島"
		   text="『そのご清潔ぶった顔を、ザーメンでぐちゃぐちゃどろどろにしてやりたくなるね。』" voices=""/>
		<char @l="781" id="miho" pos="auto" src="miho035"/>
		<msg @l="783" char_id="0" frame_id="-1" name="美帆" text="『アナタはっ！』" voices=""/>
		<msg @l="785" char_id="-1" frame_id="-1" name="真島"
		   text="『へっ、そうやってせいぜい今のうちに恨んでおきな。』" voices=""/>
		<msg @l="787" char_id="-1" frame_id="-1" name="真島"
		   text="『その方が‥‥あとで屈辱感が何倍にもなるからな。』" voices=""/>
		<msg @l="789" char_id="-1" frame_id="-1" name=""
		   text="彼はそう言ってヘビのような笑みを浮かべると、オフィスの中に向かって軽く手を振ってみせた。" voices=""/>
		<msg @l="790" char_id="-1" frame_id="-1" name=""
		   text="‥‥と、すぐにスーツ姿の社員らしき人が何人も現れて私を取り囲んだ。" voices=""/>
		<msg @l="792" char_id="-1" frame_id="-1" name="真島" text="『連れて行きな。』"
		   voices=""/>
		<msg @l="794" char_id="-1" frame_id="-1" name="男子社員Ａ" text="『わかりました。』"
		   voices=""/>
		<msg @l="796" char_id="-1" frame_id="-1" name=""
		   text="スーツ姿の社員らしき人たちは、私を取り囲んだまま手首や腰を掴んで拘束すると、無理やりオフィスの奥へと連れて行こうとする。"
		   voices=""/>
		<char @l="800" id="miho" pos="auto" src="miho134"/>
		<msg @l="802" char_id="0" frame_id="-1" name="美帆"
		   text="『やだっ‥‥やめて、離してくださいっ！』" voices=""/>
		<msg @l="804" char_id="-1" frame_id="-1" name="真島" text="『あんまり暴れない方がいーぞ？』"
		   voices=""/>
		<msg @l="806" char_id="-1" frame_id="-1" name="真島"
		   text="『そーじゃねーと、そのまんま犯されるよりよっぽど悲惨な目にあっちまうぜ。』" voices=""/>
		<char @l="809" id="miho" pos="auto" src="miho135"/>
		<msg @l="811" char_id="0" frame_id="-1" name="美帆"
		   text="『そんなのっ‥‥暴れなかったからって、ひどい目にあわされない保証なんて何処にもないじゃないですかっ！』" voices=""/>
		<msg @l="813" char_id="-1" frame_id="-1" name="真島" text="『確かにオマエの言うとーりだ。』"
		   voices=""/>
		<msg @l="815" char_id="-1" frame_id="-1" name="真島"
		   text="『じゃあ暴れてみろよ。十二分に後悔させてやるからよ。』" voices=""/>
		<char @l="819" id="miho" pos="auto" src="miho035"/>
		<msg @l="821" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="823" char_id="-1" frame_id="-1" name="男子社員Ｂ"
		   text="『真島さんがせっかく忠告してくださってるんだ、手間かけさせるなよ。』" voices=""/>
		<msg @l="825" char_id="0" frame_id="-1" name="美帆"
		   text="『や‥‥いたっ、そんな強く引っ張らないでくださいっ。』" voices=""/>
		<char @l="829" id="miho" pos="auto" src="miho135"/>
		<msg @l="831" char_id="0" frame_id="-1" name="美帆" text="『自分で‥‥歩けますから。』"
		   voices=""/>
		<clear @l="835" class="char"/>
		<msg @l="837" char_id="-1" frame_id="-1" name=""
		   text="社員の人たちに誘導されながら、私はオフィスの奥へと歩いて行く。" voices=""/>
		<msg @l="839" char_id="1" frame_id="-1" name="玲" text="『‥‥‥‥。』" voices=""/>
		<msg @l="841" char_id="-1" frame_id="-1" name="" text="背中に‥‥玲さんの視線を感じながら。"
		   voices=""/>
		<clear @l="847" class="all"/>
		<wait_chgmv/>
		<bg @l="851" src="bg17b"/>
		<msg @l="853" char_id="-1" frame_id="-1" name="" text="‥‥‥‥。" voices=""/>
		<msg @l="854" char_id="-1" frame_id="-1" name=""
		   text="あれからずっと‥‥私はオフィスの一角にあるパーティションで区切られた会議スペースに軟禁されていた。" voices=""/>
		<msg @l="855" char_id="-1" frame_id="-1" name=""
		   text="狭い会議スペースには四人分の椅子と机、それから机の上にはパソコンが一台置かれている。" voices=""/>
		<msg @l="856" char_id="-1" frame_id="-1" name="" text="私は、ただ椅子の一つに座らされていた。"
		   voices=""/>
		<msg @l="858" char_id="0" frame_id="-1" name="美帆"
		   text="『‥‥いつまで座っていればいいんですか。』" voices=""/>
		<msg @l="860" char_id="-1" frame_id="-1" name=""
		   text="会議スペースの外にいる見張り役の男に、小声で問い掛ける。" voices=""/>
		<msg @l="861" char_id="-1" frame_id="-1" name=""
		   text="オフィスにある壁かけの時計は既に午前１時を指していた。" voices=""/>
		<msg @l="863" char_id="-1" frame_id="-1" name="男子社員Ａ"
		   text="『真島さんがいいって言うまでだ。』" voices=""/>
		<msg @l="865" char_id="0" frame_id="-1" name="美帆"
		   text="『‥‥その真島って人はいつ戻ってくるんですか。』" voices=""/>
		<msg @l="867" char_id="-1" frame_id="-1" name="男子社員Ａ" text="『そんなこと俺が知るか。』"
		   voices=""/>
		<msg @l="869" char_id="-1" frame_id="-1" name=""
		   text="先ほどから何度交わされたか解らない会話を、繰り返す。" voices=""/>
		<msg @l="870" char_id="-1" frame_id="-1" name=""
		   text="ここに軟禁されてから既に３時間ほど経っているだろうか。" voices=""/>
		<msg @l="871" char_id="-1" frame_id="-1" name=""
		   text="トイレに行く時も水を飲むときも、必ず見張り同伴で逃げ出す隙はなかった。" voices=""/>
		<msg @l="873" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="875" char_id="0" frame_id="-1" name="美帆" text="(玲さん‥‥どうしてるのかな‥‥‥)"
		   voices=""/>
		<msg @l="877" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥‥‥‥。』"
		   voices=""/>
		<msg @l="879" char_id="-1" frame_id="-1" name="男子社員Ａ" text="『おい。』" voices=""/>
		<msg @l="881" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="883" char_id="-1" frame_id="-1" name="男子社員Ａ" text="『おい、オマエっ！』"
		   voices=""/>
		<msg @l="885" char_id="0" frame_id="-1" name="美帆" text="『え‥‥あ、なんですか？』"
		   voices=""/>
		<msg @l="887" char_id="-1" frame_id="-1" name="男子社員Ａ"
		   text="『真島さんが戻ってきたぞ。それと社長もご一緒だ。』" voices=""/>
		<msg @l="889" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="891" char_id="0" frame_id="-1" name="美帆" text="(‥‥社長？)" voices=""/>
		<clear @l="897" class="all"/>
		<wait_chgmv/>
		<bg @l="901" src="bg17b"/>
		<bgm @l="905" src="bgm09" volume="1."/>
		<char @l="909" id="ookur" pos="auto" src="ookuro010"/>
		<msg @l="911" char_id="-1" frame_id="-1" name="社長" text="『お待たせしました。』"
		   voices=""/>
		<msg @l="913" char_id="-1" frame_id="-1" name="真島" text="『よっ、待たせたな。』"
		   voices=""/>
		<msg @l="915" char_id="0" frame_id="-1" name="美帆" text="(あ‥‥あの人‥‥‥)"
		   voices=""/>
		<msg @l="917" char_id="-1" frame_id="-1" name=""
		   text="真島と一緒に会議スペースに入ってきたのは、いつか私が、玲さんの書類を届けに来たときに会った男性だった。" voices=""/>
		<msg @l="919" char_id="0" frame_id="-1" name="美帆"
		   text="(なんで社長が個人の面接書類をわざわざ取りに来たんだろう‥‥)" voices=""/>
		<msg @l="921" char_id="0" frame_id="-1" name="美帆"
		   text="(ううん、それよりもどうしてこんな所に‥‥‥？)" voices=""/>
		<msg @l="923" char_id="-1" frame_id="-1" name="社長"
		   text="『真島くんから聞きましてね、新しい社員候補の子がいるからというので、商談を適当なところで切り上げて戻って来たのですが‥‥。』"
		   voices=""/>
		<msg @l="925" char_id="-1" frame_id="-1" name="社長" text="『ほう‥‥この子ですね。』"
		   voices=""/>
		<msg @l="927" char_id="-1" frame_id="-1" name=""
		   text="そこで「社長」と思しきかっぷくの良い男が、私のことを値踏みする。" voices=""/>
		<msg @l="928" char_id="-1" frame_id="-1" name=""
		   text="しばらく私を見つめた後‥‥以前に一度会ったことがあるのを思い出したらしく僅かに眉を動かした。" voices=""/>
		<msg @l="930" char_id="-1" frame_id="-1" name="社長"
		   text="『ああ、アナタは前に書類を届けに来た‥‥。』" voices=""/>
		<msg @l="932" char_id="-1" frame_id="-1" name="真島" text="『知り合いですか？』"
		   voices=""/>
		<msg @l="934" char_id="-1" frame_id="-1" name="社長"
		   text="『知り合いというほどではありませんが‥‥。なるほど、あのとき撒いた種がこうも早く実りましたか。』" voices=""/>
		<msg @l="936" char_id="-1" frame_id="-1" name="社長"
		   text="『貴方は来年の“お楽しみ”と思っていたのですが‥‥‥‥。』" voices=""/>
		<clear @l="939" class="char"/>
		<char @l="941" id="ookur" pos="left" src="ookuro010"/>
		<char @l="943" id="miho" pos="right" src="miho034"/>
		<msg @l="945" char_id="0" frame_id="-1" name="美帆" text="『え？‥‥なんのことですか。』"
		   voices=""/>
		<msg @l="947" char_id="-1" frame_id="-1" name="社長" text="『いえいえ、こちらの話です。』"
		   voices=""/>
		<msg @l="949" char_id="-1" frame_id="-1" name="社長"
		   text="『それよりも自己紹介をしていませんでしたね。私はこの大黒建設南総町支社の支社長をさせて戴いております、大黒満彦といいます。』"
		   voices=""/>
		<char @l="952" id="miho" pos="right" src="miho136"/>
		<msg @l="954" char_id="0" frame_id="-1" name="美帆" text="『はあ‥‥。』" voices=""/>
		<msg @l="956" char_id="-1" frame_id="-1" name=""
		   text="半ば拉致状態でこんな場所に軟禁しておいて、今さら自己紹介も何も無い。" voices=""/>
		<msg @l="957" char_id="-1" frame_id="-1" name=""
		   text="私はわずかな敵意を灯した視線で彼‥‥大黒を見た。" voices=""/>
		<msg @l="959" char_id="-1" frame_id="-1" name="大黒"
		   text="『おやおや、随分と嫌われてしまっているようですね。』" voices=""/>
		<msg @l="961" char_id="-1" frame_id="-1" name="真島"
		   text="『大黒さんにぶち込まれるのが遅くて待ちくたびれたんじゃないスか？』" voices=""/>
		<msg @l="963" char_id="-1" frame_id="-1" name="真島"
		   text="『きっちり相手してやりゃ‥‥すぐに懐きますよ。』" voices=""/>
		<msg @l="965" char_id="-1" frame_id="-1" name="大黒"
		   text="『なるほど。それではきちんとお相手しませんとねぇ。』" voices=""/>
		<msg @l="967" char_id="-1" frame_id="-1" name=""
		   text="まるでペットか何かの話でもしているかのようにそう言って、大黒と真島が互いに笑いあった。" voices=""/>
		<clear @l="973" class="all"/>
		<label @l="976" id="event_scene42"/>
		<msg @l="978" char_id="-1" frame_id="-1" name="真島" text="『そら、コッチに来いやっ！』"
		   voices=""/>
		<msg @l="980" char_id="0" frame_id="-1" name="美帆" text="『きゃっ！？』" voices=""/>
		<wait_chgmv/>
		<bg @l="984" src="bg17b"/>
		<msg @l="986" char_id="-1" frame_id="-1" name=""
		   text="パーティションに囲われた会議スペースからから出るようにと大黒が言うと、真島が乱暴に手を掴んで私を引っ張り出す。" voices=""/>
		<msg @l="987" char_id="-1" frame_id="-1" name=""
		   text="私はバランスを崩してよろけながら、通路の真ん中へと連れ出された。" voices=""/>
		<msg @l="989" char_id="-1" frame_id="-1" name="大黒" text="『真島くん、乱暴はよくないよ。』"
		   voices=""/>
		<msg @l="991" char_id="-1" frame_id="-1" name="真島"
		   text="『なーに、これもちょっとした演出ですよ。』" voices=""/>
		<msg @l="993" char_id="-1" frame_id="-1" name="真島"
		   text="『これくらいしなくちゃ気分がでねーっスからね。』" voices=""/>
		<msg @l="995" char_id="-1" frame_id="-1" name=""
		   text="真島はそう言って口の端を楽しげにつり上げると、私の服を乱暴にたくし上げた。" voices=""/>
		<char @l="998" id="miho" pos="center" src="miho035f" y="-80"/>
		<msg @l="1000" char_id="0" frame_id="-1" name="美帆" text="『きゃあっ‥‥や、やだっ！！』"
		   voices=""/>
		<msg @l="1002" char_id="-1" frame_id="-1" name="真島"
		   text="『おっと、暴れてもいいことなんか無いぜ。』" voices=""/>
		<msg @l="1004" char_id="-1" frame_id="-1" name="真島"
		   text="『殴られたくなきゃ大人しくしてるんだな。』" voices=""/>
		<msg @l="1006" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥っ‥‥。』"
		   voices=""/>
		<msg @l="1008" char_id="-1" frame_id="-1" name=""
		   text="手首を掴まれ、私は床に押し倒されてしまう。" voices=""/>
		<msg @l="1009" char_id="-1" frame_id="-1" name=""
		   text="抵抗をしようにも真島の力は物凄くて、はね退けようにも全く敵わない。" voices=""/>
		<msg @l="1011" char_id="-1" frame_id="-1" name="真島"
		   text="『さ‥‥大黒さん、しっかりキメちまってくださいよ。』" voices=""/>
		<msg @l="1013" char_id="-1" frame_id="-1" name="大黒"
		   text="『悪いですねえ。それでは喜んで戴くとしましょうか。』" voices=""/>
		<msg @l="1015" char_id="-1" frame_id="-1" name=""
		   text="嬉しそうに言うと、大黒が私の上に覆い被さってきた。" voices=""/>
		<msg @l="1016" char_id="-1" frame_id="-1" name=""
		   text="彼の下腹部にあるモノは既に硬く屹立しており、赤黒い先端が威嚇でもするようにヒクついていた。" voices=""/>
		<msg @l="1018" char_id="-1" frame_id="-1" name="真島"
		   text="『他の連中も、上の口なら好きにしてもいーぞ。』" voices=""/>
		<msg @l="1020" char_id="-1" frame_id="-1" name="男子社員Ａ" text="『おおっ！』"
		   voices=""/>
		<msg @l="1022" char_id="-1" frame_id="-1" name="男子社員Ｂ"
		   text="『さすが真島さん、よくわかってらっしゃる！』" voices=""/>
		<msg @l="1024" char_id="-1" frame_id="-1" name=""
		   text="真島の言葉に、オフィス中から歓喜の声があがった。" voices=""/>
		<msg @l="1025" char_id="-1" frame_id="-1" name=""
		   text="気付けば私の周りには男子社員の人たちが大勢集まってきており、みなが食い入るように私の身体を見つめていた。" voices=""/>
		<msg @l="1026" char_id="-1" frame_id="-1" name=""
		   text="中には‥‥私の身体を見ながら自分のモノをしごいている人もいる。" voices=""/>
		<char @l="1029" id="miho" pos="center" src="miho135f" y="-80"/>
		<msg @l="1031" char_id="0" frame_id="-1" name="美帆" text="『やっ‥‥いやぁぁ‥‥‥‥。』"
		   voices=""/>
		<msg @l="1033" char_id="-1" frame_id="-1" name="大黒"
		   text="『さて、たっぷりと味あわせて戴きますよ。』" voices=""/>
		<label @l="1037" id="chart_line31"/>
		<wait_chgmv/>
		<ev @l="1041" src="ev-042"/>
		<description @l="1044" text="二人目のイケニエ"/>
		<bgm @l="1048" src="bgm13" volume="1."/>
		<msg @l="1050" char_id="0" frame_id="-1" name="美帆" text="『んっ、あぐっ！！』"
		   voices="miho13050"/>
		<msg @l="1052" char_id="-1" frame_id="-1" name=""
		   text="まだ濡れてもいない胎内に、熱く硬い怒張が突き入れられた。" voices=""/>
		<msg @l="1053" char_id="-1" frame_id="-1" name=""
		   text="硬くピッタリ閉じていた秘部を押し開かれる圧迫感に私は苦悶の声を上げる。" voices=""/>
		<msg @l="1055" char_id="0" frame_id="-1" name="美帆" text="『ああっ‥‥あ、んんっ‥‥‥‥。』"
		   voices="miho13060"/>
		<msg @l="1057" char_id="-1" frame_id="-1" name=""
		   text="強い摩擦感にしばらく堪えていると、やがて怒張の先端が胎内の奥深くを突き上げて止まった。" voices=""/>
		<msg @l="1059" char_id="0" frame_id="-1" name="美帆"
		   text="『ハァ、ハァ、ハァ‥‥‥んっ‥‥‥。』" voices="miho13080"/>
		<msg @l="1061" char_id="-1" frame_id="-1" name=""
		   text="私は肩を揺らして荒い呼吸を繰り返しながら、秘部からこみ上げてくる鈍い痛みと熱に眉をしかめた。" voices=""/>
		<msg @l="1062" char_id="-1" frame_id="-1" name=""
		   text="数日前に蹂躙され引き裂かれた傷は既に治っていたが、貫かれることに慣れていない膣内は大黒の肉茎により圧迫され息をする事ができないほどだった。"
		   voices=""/>
		<msg @l="1064" char_id="-1" frame_id="-1" name="男子社員Ａ"
		   text="『ほらほら、休んでないでコッチも頼むよ。』" voices=""/>
		<msg @l="1066" char_id="0" frame_id="-1" name="美帆" text="『んんんっ！？』"
		   voices="miho13090"/>
		<msg @l="1068" char_id="-1" frame_id="-1" name=""
		   text="深呼吸の為に開いていた唇をわって、男の人の先端が押し込まれる。" voices=""/>
		<msg @l="1070" char_id="-1" frame_id="-1" name="男子社員Ａ"
		   text="『歯は立てないで、ちゃんとしゃぶってくれよな。』" voices=""/>
		<msg @l="1072" char_id="0" frame_id="-1" name="美帆" text="『んっ、んんー！！』"
		   voices="miho13100"/>
		<msg @l="1074" char_id="-1" frame_id="-1" name=""
		   text="私の口へ肉棒を押し込んだ彼は、ぐいぐいと腰を動かして、まるで秘部へ挿入しているかのように口内を擦り上げた。" voices=""/>
		<msg @l="1075" char_id="-1" frame_id="-1" name=""
		   text="息苦しさと拒絶感に私は唸り声を漏らして抵抗した。" voices=""/>
		<msg @l="1076" char_id="-1" frame_id="-1" name=""
		   text="しかし、口内を犯している彼はまったくお構いなしに猛烈なイラマチオを続けていた。" voices=""/>
		<msg @l="1078" char_id="-1" frame_id="-1" name="大黒"
		   text="『最初は苦しいでしょうが、我慢してくださいね。』" voices=""/>
		<msg @l="1080" char_id="-1" frame_id="-1" name="大黒" text="『すぐに病みつきになりますよ。』"
		   voices=""/>
		<msg @l="1082" char_id="-1" frame_id="-1" name=""
		   text="しばらく突き入れた男根を動かさずに膣内の感触を愉しんでいた大黒が、苦悶している私を楽しそうに見ながら笑った。" voices=""/>
		<msg @l="1083" char_id="-1" frame_id="-1" name="" text="‥‥狂っている。" voices=""/>
		<msg @l="1084" char_id="-1" frame_id="-1" name=""
		   text="そう思いながらも、口内を暴れまわる怒張の激しさに、その考えもすぐに飛んでしまった。" voices=""/>
		<msg @l="1086" char_id="-1" frame_id="-1" name="男子社員Ａ"
		   text="『ダメだなぁ、ちゃんと舌を動かしてしゃぶってよ。』" voices=""/>
		<msg @l="1088" char_id="0" frame_id="-1" name="美帆" text="『んぐっ‥‥んっ、んんっ！！』"
		   voices="miho13110"/>
		<msg @l="1090" char_id="0" frame_id="-1" name="美帆"
		   text="『んぷぅ、んっ‥‥‥ちゅぷっ、ちゅぱっ！』" voices="miho13120"/>
		<msg @l="1092" char_id="-1" frame_id="-1" name=""
		   text="激しく口内を掻き混ぜられる苦しさに堪えかねて、私は渋々と男の言う通りその先端へ舌を絡めてピチャピチャと舐めはじめた。"
		   voices=""/>
		<msg @l="1094" char_id="-1" frame_id="-1" name="男子社員Ａ" text="『そうそう、いい感じだよ。』"
		   voices=""/>
		<msg @l="1096" char_id="-1" frame_id="-1" name=""
		   text="私がようやく奉仕を始めたことで男は気を良くしたらしく、乱暴に動かしていた腰の動きを緩め、自身の先端に絡みつく舌の動きに身を任せる。"
		   voices=""/>
		<msg @l="1098" char_id="0" frame_id="-1" name="美帆"
		   text="『んむっ‥‥ちゅぷっ‥‥‥ちゅろ、ちゅろ‥‥‥‥。』" voices="miho13130"/>
		<msg @l="1100" char_id="-1" frame_id="-1" name=""
		   text="私は口の周りをだ液まみれにして、懸命に彼のを舐め続けた。" voices=""/>
		<msg @l="1101" char_id="-1" frame_id="-1" name=""
		   text="彼の機嫌を損ねれば口内の肉棒をのど奥まで突き入れられてしまう‥‥。" voices=""/>
		<msg @l="1102" char_id="-1" frame_id="-1" name=""
		   text="そんな恐怖に突き動かされ、私の奉仕には自然と熱が入っていった。" voices=""/>
		<msg @l="1104" char_id="0" frame_id="-1" name="美帆"
		   text="『んふ、んっ、んっ‥‥ちゅぷ‥‥ちゅぷぷ‥‥‥。』" voices="miho13140"/>
		<msg @l="1106" char_id="-1" frame_id="-1" name="男子社員Ａ"
		   text="『いいねぇ、その気になってきたみたいじゃない。』" voices=""/>
		<msg @l="1108" char_id="-1" frame_id="-1" name=""
		   text="私が積極的になったことが余程嬉しいのだろう。" voices=""/>
		<msg @l="1109" char_id="-1" frame_id="-1" name=""
		   text="口内を犯している彼はニヤニヤと笑いながら、私の頭を撫でた。" voices=""/>
		<msg @l="1111" char_id="0" frame_id="-1" name="美帆" text="『んっ‥‥。』"
		   voices="miho13150"/>
		<msg @l="1114" char_id="0" frame_id="1" name="美帆" text="（お願い････早く終わって････）"
		   voices="miho13160"/>
		<msg @l="1116" char_id="-1" frame_id="-1" name=""
		   text="一分でも早くこの苦しさから逃れようと、私はさらに、だ液にまみれた唇と舌を使って口内の怒張をしゃぶり続ける。" voices=""/>
		<msg @l="1118" char_id="-1" frame_id="-1" name="大黒"
		   text="『ほう、なかなか気分が出てきましたね。』" voices=""/>
		<msg @l="1120" char_id="-1" frame_id="-1" name="大黒"
		   text="『それではこちらも、愉しませて戴きましょうか。』" voices=""/>
		<msg @l="1122" char_id="0" frame_id="1" name="美帆" text="『ん――――ッ！！』"
		   voices="miho13170"/>
		<msg @l="1124" char_id="-1" frame_id="-1" name=""
		   text="それまで挿入したまま大して動く事無く、口内を犯されている私の様子を眺めていた大黒が、不意に腰をグラインドさせて秘部を激しく掻き混ぜ始めた。"
		   voices=""/>
		<msg @l="1126" char_id="0" frame_id="1" name="美帆"
		   text="(え‥‥うそ、あんまり苦しくない‥‥‥)" voices="miho13180"/>
		<msg @l="1128" char_id="-1" frame_id="-1" name=""
		   text="胎内を長く緩やかなストロークで擦り上げていくそれは、最初に挿入された時とはだいぶ違っていた。" voices=""/>
		<msg @l="1129" char_id="-1" frame_id="-1" name=""
		   text="痛みも苦しみも殆ど無く、ただ熱く硬い塊が膣内を撫でるように擦り上げていて、肉ヒダが男根にまとわりつく感じがした。" voices=""/>
		<msg @l="1130" char_id="-1" frame_id="-1" name=""
		   text="それがゆっくりと膨らんで‥‥腰の辺りを痺れさせる。" voices=""/>
		<msg @l="1132" char_id="0" frame_id="1" name="美帆" text="『んっ、んんっ‥‥‥あっ‥‥‥‥。』"
		   voices="miho13190"/>
		<msg @l="1134" char_id="-1" frame_id="-1" name="大黒"
		   text="『さあ、いい声で鳴いてくださいね。』" voices=""/>
		<msg @l="1136" char_id="-1" frame_id="-1" name=""
		   text="大黒はしてやったりといった表情を浮かべると、なおも亀頭とカリの部分で蜜壁をゆっくりと擦り上げていった。" voices=""/>
		<msg @l="1137" char_id="-1" frame_id="-1" name=""
		   text="その度に秘部からはじゅぷじゅぷという淫靡な水音が立ち、広いオフィス全体に響き渡る。" voices=""/>
		<msg @l="1139" char_id="0" frame_id="1" name="美帆"
		   text="(どうして‥‥私、あんなに濡れちゃってる‥‥‥‥)" voices="miho13200"/>
		<msg @l="1141" char_id="-1" frame_id="-1" name=""
		   text="自分でも不思議なほど溢れ出てしまう淫蜜に戸惑いながら、私はそれでも目の前の恐怖から逃れる為に懸命な奉仕を続けた。" voices=""/>
		<msg @l="1143" char_id="0" frame_id="1" name="美帆"
		   text="『んふっ‥‥ちゅぷ、ちゅっ‥‥‥んあっ、んっ、んっ、んっ。』" voices="miho13210"/>
		<msg @l="1145" char_id="-1" frame_id="-1" name="男子社員Ａ"
		   text="『いいぞ、そのまま先端部分を甘く吸って！』" voices=""/>
		<msg @l="1147" char_id="0" frame_id="1" name="美帆"
		   text="『んぁっ、ふぁい‥‥‥んっ、ちゅる‥‥んぷ‥‥‥ちゅるるるっ。』" voices="miho13220"/>
		<msg @l="1149" char_id="-1" frame_id="-1" name=""
		   text="言われるまま、私は先端を咥え込んで鈴口から出てる先走り汁を吸い上げる。" voices=""/>
		<msg @l="1151" char_id="-1" frame_id="-1" name="男子社員Ａ"
		   text="『お、おおっ‥‥いいぞ、いいぞぉ！』" voices=""/>
		<msg @l="1153" char_id="0" frame_id="1" name="美帆"
		   text="『んふっ‥‥んっ、んぷっ‥‥‥‥‥ン、ちゅぷぷっ。』" voices="miho13230"/>
		<msg @l="1155" char_id="0" frame_id="1" name="美帆"
		   text="『ちゅるっ‥‥はふっ‥‥‥ん、んんっ‥‥‥‥んっ、ちゅううっ！』" voices="miho13240"/>
		<msg @l="1157" char_id="-1" frame_id="-1" name="男子社員Ａ"
		   text="『うおお‥‥吸い取られそうだっ！』" voices=""/>
		<msg @l="1159" char_id="-1" frame_id="-1" name=""
		   text="カリの部分を舌先で舐めながら小刻みに吸い付くと、咥えさせている彼は腰をブルブルと震わせながら声を上げた。" voices=""/>
		<msg @l="1161" char_id="-1" frame_id="-1" name="大黒" text="『彼女のお口は絶品のようですね。』"
		   voices=""/>
		<msg @l="1163" char_id="-1" frame_id="-1" name="男子社員Ａ" text="『ええ、もう最高ですよ。』"
		   voices=""/>
		<msg @l="1165" char_id="-1" frame_id="-1" name="大黒"
		   text="『それはそれは‥‥こちらの具合もなかなかですよ？』" voices=""/>
		<msg @l="1167" char_id="0" frame_id="1" name="美帆" text="『んぁっ！！』"
		   voices="miho13250"/>
		<msg @l="1169" char_id="-1" frame_id="-1" name=""
		   text="それまで緩やかな律動を続けていた大黒の腰が、体重をかけ一気に深く落とされた。" voices=""/>
		<msg @l="1170" char_id="-1" frame_id="-1" name=""
		   text="そうして熱い怒張の先端が胎内の一番奥深い子宮へと潜り込み、かすかな愉悦が膨らみかけていた私の身体に確かな火を灯す。"
		   voices=""/>
		<msg @l="1172" char_id="0" frame_id="1" name="美帆"
		   text="『や、ああっ‥すごい･･‥奥まで‥‥‥‥届いて‥‥‥‥んぅっ！』" voices="miho13070"/>
		<msg @l="1174" char_id="0" frame_id="1" name="美帆"
		   text="『ひはぁっ‥‥んっ、あっ、あっ、あっ‥‥‥。』" voices="miho13260"/>
		<msg @l="1176" char_id="0" frame_id="1" name="美帆"
		   text="『あふっ、あっ、あっ、あっ、あっ‥‥‥んぁぁっ！！』" voices="miho13270"/>
		<msg @l="1178" char_id="-1" frame_id="-1" name=""
		   text="体重をかけたストロークにあわせて、私は自分でも驚くほど甘い声を漏らしていた。" voices=""/>
		<msg @l="1179" char_id="-1" frame_id="-1" name=""
		   text="肉棒が膣壁を擦り上げ子宮口をノックするたびに下腹部からじわじわと熱いモノが膨らんでくる。" voices=""/>
		<msg @l="1180" char_id="-1" frame_id="-1" name=""
		   text="それが、秘部から溢れ出すグチュグチュという音と共に頭の芯を痺れさせていった。" voices=""/>
		<msg @l="1182" char_id="-1" frame_id="-1" name="大黒"
		   text="『くっ‥‥そろそろ、いきますよっ！』" voices=""/>
		<msg @l="1184" char_id="-1" frame_id="-1" name=""
		   text="大黒が唸るように叫んだかと思うと、深い位置に押し込まれた肉筒がグワッと一際大きく開いて激しく胎内の肉ヒダを掻き混ぜる。"
		   voices=""/>
		<msg @l="1186" char_id="-1" frame_id="-1" name="男子社員Ａ"
		   text="『こ、こっちも‥‥‥出るぞっ！！』" voices=""/>
		<msg @l="1188" char_id="-1" frame_id="-1" name=""
		   text="私の口内を犯している男も、強烈なイラマチオを再開して、のどの奥まで犯し精液を注ぎこもうとする。" voices=""/>
		<msg @l="1190" char_id="0" frame_id="1" name="美帆"
		   text="『んむっ、んっ‥‥ちゅ、ちゅぷぷっ‥‥‥ちゅるるるっ！！』" voices="miho13280"/>
		<msg @l="1192" char_id="0" frame_id="1" name="美帆"
		   text="『ぷはっ、んあああっ‥‥‥ダメ‥‥‥くる‥‥‥来ちゃうっ！！』" voices="miho13290"/>
		<msg @l="1194" char_id="-1" frame_id="-1" name=""
		   text="私の中で膨らんだ熱いモノが、頭の痺れをより加速させていく。" voices=""/>
		<msg @l="1195" char_id="-1" frame_id="-1" name="" text="目の前が真っ白になる‥‥。"
		   voices=""/>
		<msg @l="1196" char_id="-1" frame_id="-1" name=""
		   text="ただ胎内を擦り上げている肉の感触だけが膣内から、口内からリアルに伝わってきて。" voices=""/>
		<msg @l="1197" char_id="-1" frame_id="-1" name="" text="やがて‥‥弾けた―――。"
		   voices=""/>
		<msg @l="1199" char_id="0" frame_id="1" name="美帆" text="『んっっ！！！』"
		   voices="miho13300"/>
		<flash @l="1203" count="4" fade="100" image="white"/>
		<wait_chgmv/>
		<ev @l="1207" src="ev-042x1z1"/>
		<msg @l="1209" char_id="0" frame_id="1" name="美帆" text="『ひっ、ひぁぁっ、んっ、んぁぁぁっ！』"
		   voices="miho13310"/>
		<msg @l="1211" char_id="-1" frame_id="-1" name=""
		   text="私が達したのと同時に、膣内と口内に大量の熱い液体が流れ込んできた。" voices=""/>
		<msg @l="1212" char_id="-1" frame_id="-1" name=""
		   text="そして、周囲の男たちが限界とばかりに自らしごいていたモノを私に向けると、一斉に白濁色の液体を私の身体に振り撒いた―――。"
		   voices=""/>
		<msg @l="1214" char_id="-1" frame_id="-1" name="男子社員Ａ"
		   text="『ほら、お口に出されたモノはしっかり飲まなきゃ。』" voices=""/>
		<msg @l="1216" char_id="0" frame_id="1" name="美帆" text="『‥‥‥‥。』"
		   voices="miho13320"/>
		<msg @l="1218" char_id="0" frame_id="1" name="美帆"
		   text="『んんっ‥‥んっ、んくっ、んくっ、んくっ‥‥‥‥。』" voices="miho13330"/>
		<msg @l="1220" char_id="-1" frame_id="-1" name=""
		   text="私は男の言うままに口内に溜まったの大量の精液を嚥下していった。" voices=""/>
		<msg @l="1221" char_id="-1" frame_id="-1" name=""
		   text="喉に絡みつくそれはとても飲みにくく、私は何度も喉を鳴らしてそれを体内へと流し込んでいった。" voices=""/>
		<msg @l="1223" char_id="-1" frame_id="-1" name="男子社員Ａ"
		   text="『奥にもまだ残ってるから、ちゃんと吸い出してね。』" voices=""/>
		<msg @l="1225" char_id="0" frame_id="1" name="美帆"
		   text="『んっ‥‥ふぁい‥‥ん、ちゅうううっ‥‥‥。』" voices="miho13340"/>
		<msg @l="1227" char_id="0" frame_id="1" name="美帆"
		   text="『ちゅぷ‥‥んぐっ、ちゅるるっ‥‥‥‥んはっ、ちゅ、ちゅうう。』" voices="miho13350"/>
		<msg @l="1229" char_id="-1" frame_id="-1" name=""
		   text="水の中をただよっているような気だるさに身を任せながら、私は口の中で萎え始めた怒張の鈴口から精液を吸い出す。" voices=""/>
		<msg @l="1230" char_id="-1" frame_id="-1" name=""
		   text="先端を吸うたびに先ほど放たれた液体の残滓が滲み出して、口内にまた苦い味が広がっていた。" voices=""/>
		<clear @l="1236" class="all"/>
		<wait_chgmv/>
		<bg @l="1240" src="bg17b"/>
		<msg @l="1242" char_id="-1" frame_id="-1" name="男子社員Ｂ"
		   text="『すげ、たまんねー‥‥俺も早く飲ませたいぜ。』" voices=""/>
		<msg @l="1244" char_id="-1" frame_id="-1" name="男子社員Ｃ"
		   text="『お、俺、パイズリしてもいいっすか？』" voices=""/>
		<msg @l="1246" char_id="-1" frame_id="-1" name="男子社員Ｄ"
		   text="『じゃあ俺は後ろの穴で‥‥。』" voices=""/>
		<msg @l="1248" char_id="-1" frame_id="-1" name=""
		   text="野次馬の如く周囲で私たちの行為を眺めていた男子社員一同が、次々と自分の欲望を口にしてはギラギラとした視線を注いできた。"
		   voices=""/>
		<msg @l="1250" char_id="-1" frame_id="-1" name="真島"
		   text="『心配すんな、ちゃーんと全員の相手をしてくれるからよ。』" voices=""/>
		<msg @l="1252" char_id="0" frame_id="1" name="美帆" text="『‥‥‥‥。』"
		   voices="miho13360"/>
		<msg @l="1254" char_id="-1" frame_id="-1" name=""
		   text="ぼんやりと霞みのかかった意識の中、私は真島の言葉を聞いた。" voices=""/>
		<clear @l="1260" class="all"/>
		<msg @l="1262" char_id="0" frame_id="1" name="美帆" text="(ああ‥‥まだ終わらないんだ)"
		   voices="miho13370"/>
		<msg @l="1264" char_id="-1" frame_id="-1" name=""
		   text="確かな絶望と言い知れない高揚感を胸に、私はゆっくりと目を閉じる。" voices=""/>
		<msg @l="1265" char_id="-1" frame_id="-1" name=""
		   text="‥‥何処まで受け入れれば楽になるだろう。" voices=""/>
		<msg @l="1266" char_id="-1" frame_id="-1" name=""
		   text="暗闇に閉ざされた世界の中、私はそんなことを考えていた―――。" voices=""/>
		<stopbgm @l="1270" fadeout="1000"/>
		<clear @l="1276" class="all"/>
		<end_scene @l="1279"/>
		<msgshow @l="1282" show="true"/>
		<call @l="1286" target="EventLabel_45@ending07"/>
		<return @l="1287" value="0&#13;&#10;"/>
		<label @l="1291" id="EventLabel_145"/>
		<msg @l="1293" char_id="0" frame_id="1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="1295" char_id="-1" frame_id="-1" name=""
		   text="私はかける言葉が見つからず‥‥黙って玲さんの背中を見送っていた。" voices=""/>
		<msg @l="1297" char_id="0" frame_id="1" name="美帆"
		   text="(無理だよ‥‥自分のコトでも精一杯なのに‥‥‥‥)" voices=""/>
		<msg @l="1299" char_id="-1" frame_id="-1" name="" text="大切な人を失っていく喪失感‥‥‥。"
		   voices=""/>
		<msg @l="1300" char_id="-1" frame_id="-1" name=""
		   text="でもどうすることも出来ない、無力な自分を知っているから。" voices=""/>
		<msg @l="1302" char_id="0" frame_id="1" name="美帆" text="(だから‥‥)" voices=""/>
		<msg @l="1304" char_id="-1" frame_id="-1" name=""
		   text="私は‥‥玲さんとの最後の絆さえも失ってしまった。" voices=""/>
		<clear @l="1310" class="all"/>
		<call @l="1314" target="EventLabel_44@ending06"/>
		<return @l="1315" value="0&#13;&#10;"/>
		<return @l="1318" value=""/>
	</code>
</xscript>
