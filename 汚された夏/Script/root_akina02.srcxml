<?xml version="1.0" encoding="utf-8"?>
<xscript>
	<debug editor="&quot;C:\Program&#32;Files&#32;(x86)\sakura\sakura.exe&quot;&#32;&quot;%src%&quot;&#32;-Y=%line%"
	   src="D:\シロップ\町ぐるみの罠＋汚された夏セット版\汚された夏\完成データ\汚された夏\script\text\root_akina02.txt"/>
	<code>
		<label @l="12" id="EventLabel_60"/>
		<description @l="15" text="水泳コーチ・２日目"/>
		<eval @l="17" expr="f.numDay=9&#13;&#10;"/>
		<msgshow @l="19" show="false"/>
		<wait_chgmv/>
		<bg @l="21" src="day09" time="2000"/>
		<wait @l="23" time="500"/>
		<wait_chgmv/>
		<bg @l="25" src="black" time="2000"/>
		<msgshow @l="27" show="true"/>
		<wait_chgmv/>
		<bg @l="30" src="bg08m2"/>
		<bgm @l="33" src="bgm02" volume="1."/>
		<char @l="36" id="miho" pos="auto" src="miho115"/>
		<msg @l="38" char_id="0" frame_id="-1" name="美帆"
		   text="『いたっ‥‥うあ、この格好でもダメなのね‥‥‥。』" voices=""/>
		<msg @l="40" char_id="-1" frame_id="-1" name=""
		   text="二限目の講義が終わってすぐ、私は席を立つだけで四苦八苦していた。" voices=""/>
		<msg @l="41" char_id="-1" frame_id="-1" name=""
		   text="‥‥身体のあちこちが痛くて、どうしてもぎこちない動作になってしまう。" voices=""/>
		<msg @l="43" char_id="-1" frame_id="-1" name="女友達" text="『なに、どうしたの？』"
		   voices=""/>
		<char @l="46" id="miho" pos="auto" src="miho016"/>
		<msg @l="48" char_id="0" frame_id="-1" name="美帆"
		   text="『あ、うん‥‥なんでもないの‥‥‥‥んぐっ。』" voices=""/>
		<msg @l="50" char_id="-1" frame_id="-1" name="女友達"
		   text="『なんでもないって‥‥とてもそうは見えないよ？』" voices=""/>
		<char @l="53" id="miho" pos="auto" src="miho015"/>
		<msg @l="55" char_id="0" frame_id="-1" name="美帆"
		   text="『ん‥‥ちょっと、筋肉痛でね‥‥‥イタタタ‥‥‥‥。』" voices=""/>
		<msg @l="57" char_id="-1" frame_id="-1" name="" text="上半身を左右に捻っただけで痛みが走る。"
		   voices=""/>
		<msg @l="59" char_id="-1" frame_id="-1" name="女友達" text="『筋肉痛って‥‥‥腰が？』"
		   voices=""/>
		<char @l="62" id="miho" pos="auto" src="miho016"/>
		<msg @l="64" char_id="0" frame_id="-1" name="美帆"
		   text="『ん、腰と腹筋と足の付け根が一番キツイ‥‥。』" voices=""/>
		<msg @l="66" char_id="0" frame_id="-1" name="美帆"
		   text="『久々にやったら、いきなりこれだもん‥‥私やっぱり運動不足かも。』" voices=""/>
		<msg @l="68" char_id="-1" frame_id="-1" name="女友達" text="『腰と腹筋と足の付け根‥‥‥ああ！』"
		   voices=""/>
		<char @l="71" id="miho" pos="auto" src="miho015"/>
		<msg @l="73" char_id="0" frame_id="-1" name="美帆"
		   text="『調子に乗って三本もやらなきゃよかったって‥‥後悔してるトコ。』" voices=""/>
		<msg @l="75" char_id="-1" frame_id="-1" name="女友達"
		   text="『三本も？！&#32;‥‥連続で？！』" voices=""/>
		<char @l="78" id="miho" pos="auto" src="miho016"/>
		<msg @l="81" char_id="0" frame_id="-1" name="美帆"
		   text="『うん‥‥それでも久しぶりだからって、減らした方なんだよ。』" voices=""/>
		<char @l="84" id="miho" pos="auto" src="miho015"/>
		<msg @l="86" char_id="0" frame_id="-1" name="美帆"
		   text="『昔だったら、十本でも余裕だったのに‥‥。』" voices=""/>
		<bgm @l="89" src="bgm06" volume="1."/>
		<msg @l="92" char_id="-1" frame_id="-1" name="女友達"
		   text="『十本で余裕だなんて！&#32;あんた見かけによらずスゴイのね～。』" voices=""/>
		<char @l="95" id="miho" pos="auto" src="miho010"/>
		<msg @l="97" char_id="0" frame_id="-1" name="美帆"
		   text="『よく言われるけど、長時間の場合は、いかに余計な体力を使わずに動くかっていうのがポイントなのよ。』" voices=""/>
		<msg @l="99" char_id="-1" frame_id="-1" name="女友達" text="『ふむふむ‥‥。』"
		   voices=""/>
		<char @l="102" id="miho" pos="auto" src="miho111"/>
		<msg @l="104" char_id="0" frame_id="-1" name="美帆"
		   text="『力を入れずに自然体で動く‥‥これが出来るだけでずいぶん長持ちするようになるわよ。』" voices=""/>
		<msg @l="106" char_id="-1" frame_id="-1" name="女友達" text="『へ、へぇ‥‥知らなかったわ。』"
		   voices=""/>
		<char @l="109" id="miho" pos="auto" src="miho011"/>
		<msg @l="111" char_id="0" frame_id="-1" name="美帆"
		   text="『あ、あと、ブレスのタイミングも大事ね。』" voices=""/>
		<msg @l="113" char_id="-1" frame_id="-1" name="女友達"
		   text="『ブレス‥‥ああ、呼吸法ってこと？』" voices=""/>
		<char @l="116" id="miho" pos="auto" src="miho010"/>
		<msg @l="118" char_id="0" frame_id="-1" name="美帆"
		   text="『そうそう、頻繁にブレスを入れると逆に疲れちゃうから、なるべく最小限に抑えた方がいいと思う。』" voices=""/>
		<msg @l="120" char_id="-1" frame_id="-1" name="女友達"
		   text="『なるほど‥‥呼吸はなるべく最小限、と。』" voices=""/>
		<msg @l="122" char_id="-1" frame_id="-1" name=""
		   text="ふと見ると、彼女は手帳を取り出して、いつの間にかメモを取り始めている。" voices=""/>
		<msg @l="123" char_id="-1" frame_id="-1" name=""
		   text="私にとっては当然のことでも、普通は知らない事なのだろう。" voices=""/>
		<char @l="126" id="miho" pos="auto" src="miho016"/>
		<msg @l="128" char_id="0" frame_id="-1" name="美帆"
		   text="『でも、さすがに３年もやってないと鈍っちゃうみたい。』" voices=""/>
		<msg @l="130" char_id="0" frame_id="-1" name="美帆"
		   text="『昔は自然にできてたことも、今では全然ダメだもん。』" voices=""/>
		<msg @l="132" char_id="-1" frame_id="-1" name="女友達"
		   text="『昔のあんたは‥‥相当スゴかったのね。』" voices=""/>
		<char @l="135" id="miho" pos="auto" src="miho010"/>
		<msg @l="137" char_id="0" frame_id="-1" name="美帆" text="『別にすごくはないと思うけど‥‥。』"
		   voices=""/>
		<msg @l="139" char_id="-1" frame_id="-1" name="女友達"
		   text="『いいえ、十分すごいわよ‥‥大人しいと思ってたあんたがそんなスペシャリストだなんて思ってなかったわ。』" voices=""/>
		<char @l="142" id="miho" pos="auto" src="miho016"/>
		<msg @l="144" char_id="0" frame_id="-1" name="美帆"
		   text="『大人しいとか大人しくないは、関係ないんじゃないかな？』" voices=""/>
		<msg @l="146" char_id="-1" frame_id="-1" name="女友達"
		   text="『そうね‥‥私もいま、そう実感したわ。』" voices=""/>
		<msg @l="148" char_id="-1" frame_id="-1" name="女友達"
		   text="『ありがとう、参考にさせてもらうから！』" voices=""/>
		<stopbgm @l="151" fadeout="1000"/>
		<char @l="154" id="miho" pos="auto" src="miho014"/>
		<msg @l="156" char_id="0" frame_id="-1" name="美帆"
		   text="『え、あ‥‥お昼どうするの‥‥‥‥って、いっちゃった。』" voices=""/>
		<char @l="159" id="miho" pos="auto" src="miho110"/>
		<msg @l="161" char_id="0" frame_id="-1" name="美帆"
		   text="『参考にさせてもらうって、彼女、始めるのかしら？‥‥‥水泳。』" voices=""/>
		<clear @l="164" class="all"/>
		<bgm @l="167" src="bgm02" volume="1."/>
		<wait_chgmv/>
		<bg @l="170" src="bg09"/>
		<char @l="173" id="miho" pos="auto" src="miho110"/>
		<msg @l="175" char_id="0" frame_id="-1" name="美帆" text="(お昼‥‥どうしようかなぁ)"
		   voices=""/>
		<msg @l="177" char_id="-1" frame_id="-1" name=""
		   text="別にアテがある訳じゃないけど、とりあえず廊下にだけは行ってみた。" voices=""/>
		<msg @l="178" char_id="-1" frame_id="-1" name=""
		   text="いつも一緒にお昼を食べてる友達の子も‥‥･･、" voices=""/>
		<msg @l="179" char_id="-1" frame_id="-1" name=""
		   text="それぞれにロッカーを後にしたまま、戻っては来ない。" voices=""/>
		<msg @l="181" char_id="0" frame_id="-1" name="美帆"
		   text="(教室で待ってても、戻ってくるとは限らないし‥‥)" voices=""/>
		<char @l="184" id="miho" pos="auto" src="miho010"/>
		<msg @l="186" char_id="0" frame_id="-1" name="美帆"
		   text="(仕方ない‥‥今日は一人で学食かな‥‥‥)" voices=""/>
		<clear @l="189" class="char"/>
		<char @l="192" id="miho" pos="auto" src="miho111"/>
		<msg @l="194" char_id="0" frame_id="-1" name="美帆" text="(今日のランチメニュー‥‥なにかな～)"
		   voices=""/>
		<msg @l="196" char_id="-1" frame_id="-1" name=""
		   text="ぼんやりとそんな事を考えながら、私は学食に向かって歩き出す。" voices=""/>
		<msg @l="197" char_id="-1" frame_id="-1" name=""
		   text="ここのランチメニューは安いわりに、デザートにはプリンとかヨーグルトが付いてたりして、結構、お気に入りなんだけど･･････、"
		   voices=""/>
		<msg @l="198" char_id="-1" frame_id="-1" name=""
		   text="ドンブリ系だけは苦手だったり･･････。" voices=""/>
		<msg @l="199" char_id="-1" frame_id="-1" name=""
		   text="ご飯の量が男の子基準で盛れてるから、私のお腹じゃ食べ切れないって事なんだけど。" voices=""/>
		<msg @l="200" char_id="-1" frame_id="-1" name=""
		   text="私はちっちゃな頃から出されたご飯を残すのが嫌いだから、食べ切れそうなとき以外は頼んだりしない。" voices=""/>
		<char @l="203" id="miho" pos="auto" src="miho016"/>
		<msg @l="205" char_id="0" frame_id="-1" name="美帆"
		   text="(‥‥昨日の練習くらいでこんな筋肉痛になってたんじゃ、とてもコーチどころじゃないよね‥‥‥)" voices=""/>
		<msg @l="207" char_id="0" frame_id="-1" name="美帆"
		   text="(３年前まではあのくらい平気だったんだけどなぁ‥‥)" voices=""/>
		<msg @l="209" char_id="-1" frame_id="-1" name=""
		   text="５０メートルを軽く三本流しただけで、腹筋と腰まわりがミシミシいっている。" voices=""/>
		<char @l="212" id="miho" pos="auto" src="miho110"/>
		<msg @l="214" char_id="0" frame_id="-1" name="美帆"
		   text="(帰ったら柔軟体操しなくちゃかなぁ‥‥)" voices=""/>
		<char @l="217" id="miho" pos="auto" src="miho114"/>
		<msg @l="219" char_id="0" frame_id="-1" name="美帆" text="(‥‥え？)" voices=""/>
		<stopbgm @l="222" fadeout="1000"/>
		<msg @l="224" char_id="-1" frame_id="-1" name=""
		   text="廊下の先を歩いている人物を見付け、足が動かなくなった。" voices=""/>
		<char @l="227" id="watab" pos="auto" src="watabe010"/>
		<msg @l="229" char_id="-1" frame_id="-1" name="ジャージの男"
		   text="『おや‥‥おお、仲根くんじゃないか！』" voices=""/>
		<clear @l="232" class="char"/>
		<char @l="234" id="watab" pos="left" src="watabe010"/>
		<char @l="236" id="miho" pos="right" src="miho114"/>
		<bgm @l="239" src="bgm15" volume="1."/>
		<msg @l="241" char_id="0" frame_id="-1" name="美帆"
		   text="『‥‥渡部（わたべ）‥‥先生‥‥‥‥。』" voices=""/>
		<msg @l="243" char_id="-1" frame_id="-1" name=""
		   text="いやに馴れ馴れしいその人物に、私は確かな見覚えがある‥‥。" voices=""/>
		<msg @l="244" char_id="-1" frame_id="-1" name="" text="いや‥‥･･。" voices=""/>
		<msg @l="245" char_id="-1" frame_id="0" name="" text="「･･････まだ忘れていなかった。」"
		   voices=""/>
		<msg @l="246" char_id="-1" frame_id="-1" name="" text="私から水泳を奪った‥‥･･、"
		   voices=""/>
		<msg @l="247" char_id="-1" frame_id="-1" name="" text="薄ら笑いを浮かべる男の顔を･･････。"
		   voices=""/>
		<char @l="250" id="miho" pos="right" src="miho015"/>
		<msg @l="252" char_id="0" frame_id="-1" name="美帆"
		   text="『どうしてっ！？&#32;どうしてアナタがこんな所にっ！？』" voices=""/>
		<msg @l="254" char_id="-1" frame_id="-1" name="渡部"
		   text="『なんだなんだ、どうしてとはまたご挨拶だな。』" voices=""/>
		<msg @l="256" char_id="0" frame_id="-1" name="美帆"
		   text="『････私は、どうしてアナタがこの大学にいるのかと聞いてるんです。』" voices=""/>
		<char @l="259" id="watab" pos="left" src="watabe012"/>
		<msg @l="261" char_id="-1" frame_id="-1" name="渡部"
		   text="『怖い顔しないでくれよ、せっかくの可愛い顔が台無しだ。』" voices=""/>
		<char @l="264" id="miho" pos="right" src="miho115"/>
		<msg @l="266" char_id="0" frame_id="-1" name="美帆" text="『答えて下さいっ！！』"
		   voices=""/>
		<char @l="269" id="watab" pos="left" src="watabe010"/>
		<msg @l="271" char_id="-1" frame_id="-1" name="渡部"
		   text="『ふん‥‥そりゃ、この大学に水泳部顧問として合宿しに来たからに決まってる。』" voices=""/>
		<char @l="274" id="miho" pos="right" src="miho014"/>
		<msg @l="276" char_id="0" frame_id="-1" name="美帆" text="『え？&#32;‥‥うそ‥‥‥。』"
		   voices=""/>
		<msg @l="278" char_id="-1" frame_id="-1" name="渡部" text="『嘘なもんか。』" voices=""/>
		<msg @l="280" char_id="-1" frame_id="-1" name="渡部"
		   text="『現に、オマエの妹を毎日見てやってるのは俺だ。』" voices=""/>
		<msg @l="282" char_id="0" frame_id="-1" name="美帆" text="『な―――――！？』"
		   voices=""/>
		<msg @l="284" char_id="0" frame_id="-1" name="美帆" text="『どうしてそんなっ‥‥。』"
		   voices=""/>
		<msg @l="286" char_id="-1" frame_id="-1" name="渡部"
		   text="『それが俺の仕事だからな、当たり前だろ？』" voices=""/>
		<char @l="289" id="miho" pos="right" src="miho015"/>
		<msg @l="291" char_id="0" frame_id="-1" name="美帆" text="『アナタは‥‥よくもそんなっ‥‥‥。』"
		   voices=""/>
		<char @l="294" id="miho" pos="right" src="miho115"/>
		<msg @l="296" char_id="0" frame_id="-1" name="美帆"
		   text="『３年前に自分が何をしたか、忘れたんですかっ！？』" voices=""/>
		<char @l="299" id="watab" pos="left" src="watabe014"/>
		<msg @l="301" char_id="-1" frame_id="-1" name="渡部"
		   text="『&#32;なぁんの事か････憶えがないなぁ･･････？』" voices=""/>
		<char @l="304" id="miho" pos="right" src="miho015"/>
		<msg @l="306" char_id="0" frame_id="-1" name="美帆" text="『―――――ッ！？』"
		   voices=""/>
		<se @l="309" buf="1" src="平手打ち" volume="1."/>
		<flash @l="311" count="4" fade="100" image="white"/>
		<char @l="314" id="watab" pos="left" src="watabe010"/>
		<msg @l="316" char_id="-1" frame_id="-1" name="渡部" text="『おっ‥‥とと。』"
		   voices=""/>
		<msg @l="318" char_id="-1" frame_id="-1" name="渡部"
		   text="『腰は入ってるみたいだが、痛くねぇぞ？･･お前さぁ･･カラダ鈍ってねぇか？』" voices=""/>
		<char @l="321" id="miho" pos="right" src="miho115"/>
		<msg @l="323" char_id="0" frame_id="-1" name="美帆"
		   text="『アナタはっ‥‥私の人生をめちゃくちゃにしておいて、まだそんな！！』" voices=""/>
		<char @l="326" id="watab" pos="left" src="watabe014"/>
		<msg @l="328" char_id="-1" frame_id="-1" name="渡部"
		   text="『人生をめちゃくちゃにした？&#32;俺が？&#32;おいおい勘違いしないでくれよ。』" voices=""/>
		<char @l="331" id="watab" pos="left" src="watabe010"/>
		<msg @l="333" char_id="-1" frame_id="-1" name="渡部"
		   text="『勝手に水泳を辞めたのはオマエだろ？&#32;俺の所為じゃない。』" voices=""/>
		<char @l="336" id="miho" pos="right" src="miho114"/>
		<msg @l="338" char_id="0" frame_id="-1" name="美帆"
		   text="『なっ‥‥自分が何をいってるのか、解ってるんですかっ！？』" voices=""/>
		<msg @l="340" char_id="-1" frame_id="-1" name="" text="私は･･････、" voices=""/>
		<msg @l="341" char_id="-1" frame_id="-1" name="" text="絶対、あの事件を忘れはしない。"
		   voices=""/>
		<msg @l="342" char_id="-1" frame_id="-1" name=""
		   text="この男の行為、それ自体は未遂だったとはいえ、心に大きな疵を負わせられた。" voices=""/>
		<msg @l="343" char_id="-1" frame_id="-1" name="" text="だから私は水泳を辞めた‥‥･･。"
		   voices=""/>
		<msg @l="344" char_id="-1" frame_id="-1" name=""
		   text="･･････信じていた人に、あんな形で裏切られて･･････。" voices=""/>
		<msg @l="345" char_id="-1" frame_id="-1" name="" text="それなのに‥‥。" voices=""/>
		<char @l="348" id="watab" pos="left" src="watabe012"/>
		<msg @l="350" char_id="-1" frame_id="-1" name="渡部"
		   text="『解ってるさ。俺は何もしちゃいねぇって････。』" voices=""/>
		<msg @l="352" char_id="-1" frame_id="-1" name="渡部"
		   text="『現にホレ････俺は罪に問われてないし、こうやって教師も続けてる。』" voices=""/>
		<msg @l="354" char_id="-1" frame_id="-1" name="渡部"
		   text="『俺が普通で、問題ナシって････これが何よりの証拠だろう？』" voices=""/>
		<char @l="357" id="miho" pos="right" src="miho015"/>
		<msg @l="359" char_id="0" frame_id="-1" name="美帆" text="『そんなバカな事っ‥‥。』"
		   voices=""/>
		<char @l="362" id="watab" pos="left" src="watabe014"/>
		<msg @l="364" char_id="-1" frame_id="-1" name="渡部"
		   text="『お前の言ってる意味は解らないが････、これは事実だ。』" voices=""/>
		<char @l="367" id="watab" pos="left" src="watabe010"/>
		<msg @l="369" char_id="-1" frame_id="-1" name="渡部"
		   text="『罪を犯せば当然捕まる。俺はどうだ？&#32;お咎めナシだろ？』" voices=""/>
		<msg @l="371" char_id="-1" frame_id="-1" name="渡部"
		   text="『要するに、俺は罪なんか犯してないんだよ。少なくとも････社会的には････な。』" voices=""/>
		<char @l="374" id="miho" pos="right" src="miho115"/>
		<msg @l="376" char_id="0" frame_id="-1" name="美帆" text="『それは――――っ！！』"
		   voices=""/>
		<msg @l="378" char_id="-1" frame_id="-1" name="" text="それは･･････、" voices=""/>
		<msg @l="379" char_id="-1" frame_id="-1" name="" text="それは、違う！" voices=""/>
		<msg @l="380" char_id="-1" frame_id="-1" name=""
		   text="あの事件が荼毘に伏されてるのは、事の次第を世間に公表しないよう、私が学校へ頼み込んだからに他ならない。" voices=""/>
		<msg @l="381" char_id="-1" frame_id="-1" name=""
		   text="しかも、私個人が誰にも事実を話さなかったのは･･････、" voices=""/>
		<msg @l="382" char_id="-1" frame_id="-1" name="" text="この男を赦しているからじゃないのに！"
		   voices=""/>
		<msg @l="384" char_id="-1" frame_id="-1" name="渡部"
		   text="『まあ、そういうワケだから仲良くやろうじゃないか。』" voices=""/>
		<char @l="387" id="watab" pos="left" src="watabe012"/>
		<msg @l="389" char_id="-1" frame_id="-1" name="渡部" text="『――――３年前みたいになぁ？』"
		   voices=""/>
		<char @l="392" id="miho" pos="right" src="miho114"/>
		<msg @l="394" char_id="0" frame_id="-1" name="美帆" text="『く‥‥近寄らないで下さいっ！！』"
		   voices=""/>
		<char @l="397" id="miho" pos="right" src="miho015"/>
		<msg @l="399" char_id="0" frame_id="-1" name="美帆" text="『アナタと仲良くする気はありません！』"
		   voices=""/>
		<char @l="402" id="watab" pos="left" src="watabe010"/>
		<msg @l="404" char_id="-1" frame_id="-1" name="渡部"
		   text="『ふん‥‥なら、妹はどうするつもりだ？』" voices=""/>
		<msg @l="406" char_id="-1" frame_id="-1" name="渡部"
		   text="『水泳合宿のコーチを頼まれたんじゃないのか？』" voices=""/>
		<char @l="409" id="miho" pos="right" src="miho116"/>
		<msg @l="411" char_id="0" frame_id="-1" name="美帆" text="『そ‥‥それはっ‥‥‥。』"
		   voices=""/>
		<msg @l="413" char_id="-1" frame_id="-1" name="" text="･･････そうだった‥‥･･。"
		   voices=""/>
		<msg @l="414" char_id="-1" frame_id="-1" name=""
		   text="亜季奈は顧問の先生に許可を取ったと言っていた。" voices=""/>
		<msg @l="415" char_id="-1" frame_id="-1" name=""
		   text="それは取りも直さず、この人の許可を取っっている‥‥というコトだ･･････。" voices=""/>
		<msg @l="416" char_id="-1" frame_id="-1" name=""
		   text="亜季奈が私をコーチにしたいと告げた時、この人は何を思っただろうか･･････。" voices=""/>
		<msg @l="417" char_id="-1" frame_id="-1" name="" text="きっと‥‥･･、" voices=""/>
		<msg @l="418" char_id="-1" frame_id="-1" name=""
		   text="きっと満面の笑みを浮かべて喜んでいたに違いない。" voices=""/>
		<msg @l="419" char_id="-1" frame_id="-1" name=""
		   text="あの時の私をめちゃくちゃにして･･････、" voices=""/>
		<msg @l="420" char_id="-1" frame_id="-1" name=""
		   text="罪の意識を微塵も感じていないこの人はきっと‥‥･･。" voices=""/>
		<msg @l="422" char_id="-1" frame_id="-1" name="渡部"
		   text="『････と、まぁそういうワケで････だ。』" voices=""/>
		<char @l="425" id="watab" pos="left" src="watabe012"/>
		<msg @l="427" char_id="-1" frame_id="-1" name="渡部"
		   text="『俺の可愛い教え子たちを鍛えて貰おうか？』" voices=""/>
		<char @l="430" id="miho" pos="right" src="miho115"/>
		<msg @l="432" char_id="0" frame_id="-1" name="美帆" text="『‥‥卑怯です。』" voices=""/>
		<char @l="435" id="watab" pos="left" src="watabe010"/>
		<msg @l="437" char_id="-1" frame_id="-1" name="渡部"
		   text="『卑怯？&#32;そりゃ日本語が間違ってるだろ？世渡りが上手いと言ってくれ。』" voices=""/>
		<char @l="440" id="miho" pos="right" src="miho015"/>
		<msg @l="442" char_id="0" frame_id="-1" name="美帆"
		   text="『くっ‥‥私は、アナタの為のコーチなんか････絶対にしません。』" voices=""/>
		<msg @l="444" char_id="0" frame_id="-1" name="美帆"
		   text="『亜季奈の‥‥‥妹の為にするんですっ！』" voices=""/>
		<msg @l="446" char_id="-1" frame_id="-1" name="渡部" text="『理由なんかどうだっていいさ。』"
		   voices=""/>
		<msg @l="448" char_id="-1" frame_id="-1" name="渡部"
		   text="『次の大会････ウチの部の誰かが優勝してくれりゃ、それでいいんだ。』" voices=""/>
		<msg @l="450" char_id="-1" frame_id="-1" name="渡部"
		   text="『そうすりゃ俺の株も上がりまくって‥‥今以上にウマイ思いが出来るだろ？』" voices=""/>
		<char @l="453" id="miho" pos="right" src="miho115"/>
		<msg @l="455" char_id="0" frame_id="-1" name="美帆" text="『最低‥‥です。』" voices=""/>
		<msg @l="457" char_id="-1" frame_id="-1" name="渡部" text="『くっくっくっくっくっ。』"
		   voices=""/>
		<clear @l="460" class="char"/>
		<char @l="462" id="miho" pos="auto" src="miho115"/>
		<msg @l="464" char_id="-1" frame_id="-1" name=""
		   text="渡部先生は心の底から楽しげに嗤って、私の脇を抜けていく。" voices=""/>
		<msg @l="466" char_id="0" frame_id="-1" name="美帆" text="(どうして‥‥)" voices=""/>
		<msg @l="468" char_id="0" frame_id="-1" name="美帆" text="(どうしてこんなっ！！)"
		   voices=""/>
		<msg @l="470" char_id="-1" frame_id="-1" name=""
		   text="衝撃と怒りで叫びたくなるのを何とか堪え、私は憎悪の視線を渡部へ注いだ。" voices=""/>
		<stopbgm @l="473" fadeout="1000"/>
		<clear @l="476" class="all"/>
		<wait_chgmv/>
		<bg @l="479" src="bg10m1"/>
		<bgm @l="482" src="bgm02" volume="1."/>
		<char @l="485" id="watab" pos="auto" src="watabe010"/>
		<msg @l="487" char_id="-1" frame_id="-1" name="渡部"
		   text="『･･････あー、そういうワケで一日遅れになった訳だが、今日からしっかりと指導に当たるつもりだから、覚悟しとけ！』"
		   voices=""/>
		<msg @l="489" char_id="-1" frame_id="-1" name="水泳部の子たち" text="『は、はいっ！』"
		   voices=""/>
		<msg @l="491" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="493" char_id="-1" frame_id="-1" name="渡部"
		   text="『尚、細かい実技指導に関しては、昨日と同じくこの仲根美帆くんが担当してくれるから、みんな頼りにしろよ。』" voices=""/>
		<clear @l="496" class="char"/>
		<char @l="498" id="miho" pos="left" src="miho166"/>
		<char @l="500" id="akina" pos="right" src="akina061"/>
		<msg @l="502" char_id="2" frame_id="-1" name="亜季奈" text="『お姉ちゃん、よろしくねっ。』"
		   voices=""/>
		<char @l="505" id="miho" pos="left" src="miho066"/>
		<msg @l="507" char_id="0" frame_id="-1" name="美帆" text="『‥‥う、うん。』" voices=""/>
		<char @l="510" id="akina" pos="right" src="akina064"/>
		<msg @l="512" char_id="2" frame_id="-1" name="亜季奈"
		   text="『あれ？&#32;‥‥なんか元気ないね？』" voices=""/>
		<char @l="515" id="miho" pos="left" src="miho066"/>
		<msg @l="517" char_id="0" frame_id="-1" name="美帆"
		   text="『そ、そんなことないわよ‥‥そんなこと‥‥‥。』" voices=""/>
		<char @l="520" id="akina" pos="right" src="akina161"/>
		<msg @l="522" char_id="2" frame_id="-1" name="亜季奈"
		   text="『そう？&#32;ならいいけど‥‥。』" voices=""/>
		<char @l="525" id="miho" pos="left" src="miho166"/>
		<msg @l="527" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="529" char_id="0" frame_id="-1" name="美帆"
		   text="(亜季奈‥‥あなた、何でこんな人のいる水泳部なんかに‥‥)" voices=""/>
		<msg @l="531" char_id="0" frame_id="-1" name="美帆" text="(ううん‥‥そうじゃない)"
		   voices=""/>
		<msg @l="533" char_id="0" frame_id="-1" name="美帆"
		   text="(そもそも、どうしてこの人が教師として復帰してるの？)" voices=""/>
		<msg @l="535" char_id="0" frame_id="-1" name="美帆"
		   text="(もう二度と‥‥教師は名乗れないだろう、って言われてたのに････)" voices=""/>
		<msg @l="537" char_id="2" frame_id="-1" name="亜季奈" text="『お姉ちゃん？』" voices=""/>
		<char @l="540" id="akina" pos="right" src="akina064"/>
		<msg @l="542" char_id="2" frame_id="-1" name="亜季奈" text="『お姉ちゃん、どうしたの？』"
		   voices=""/>
		<char @l="545" id="miho" pos="left" src="miho064"/>
		<msg @l="547" char_id="0" frame_id="-1" name="美帆" text="『え‥‥？』" voices=""/>
		<char @l="550" id="miho" pos="left" src="miho066"/>
		<msg @l="552" char_id="0" frame_id="-1" name="美帆"
		   text="『あ、ごめんね‥‥ちょっとぼうっとしてた････。』" voices=""/>
		<char @l="555" id="watab" pos="right" src="watabe014"/>
		<msg @l="557" char_id="-1" frame_id="-1" name="渡部"
		   text="『おいおい、コーチのキミがしっかりしてくれなきゃ困るなぁ。』" voices=""/>
		<char @l="560" id="miho" pos="left" src="miho166"/>
		<msg @l="562" char_id="0" frame_id="-1" name="美帆" text="『‥‥すみません。』"
		   voices=""/>
		<char @l="565" id="akina" pos="right" src="akina064"/>
		<msg @l="567" char_id="2" frame_id="-1" name="亜季奈" text="『お姉ちゃん‥‥本当に大丈夫？』"
		   voices=""/>
		<char @l="570" id="akina" pos="right" src="akina065"/>
		<msg @l="572" char_id="2" frame_id="-1" name="亜季奈" text="『もしかして体調悪いとか？』"
		   voices=""/>
		<char @l="575" id="miho" pos="left" src="miho066"/>
		<msg @l="577" char_id="0" frame_id="-1" name="美帆"
		   text="『大丈夫‥‥そんな事ないよ、全然平気。』" voices=""/>
		<char @l="580" id="akina" pos="right" src="akina060"/>
		<msg @l="582" char_id="2" frame_id="-1" name="亜季奈"
		   text="『そ？&#32;んじゃ、練習はじめよっか？』" voices=""/>
		<msg @l="584" char_id="0" frame_id="-1" name="美帆" text="『そ、そうね‥‥。』"
		   voices=""/>
		<char @l="587" id="miho" pos="left" src="miho166"/>
		<msg @l="589" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="591" char_id="0" frame_id="-1" name="美帆" text="(････しっかりしなくちゃ‥‥)"
		   voices=""/>
		<msg @l="593" char_id="0" frame_id="-1" name="美帆"
		   text="(････私が‥‥しっかりしなくちゃ･･････)" voices=""/>
		<clear @l="596" class="all"/>
		<wait_chgmv/>
		<bg @l="599" src="bg10m1"/>
		<char @l="602" id="miho" pos="auto" src="miho066"/>
		<msg @l="604" char_id="0" frame_id="-1" name="美帆"
		   text="『はい‥‥そこ、腕をもっと上げた方がいいです。』" voices=""/>
		<msg @l="606" char_id="0" frame_id="-1" name="美帆"
		   text="『あ、ブレスのタイミングが早すぎです‥‥。』" voices=""/>
		<char @l="609" id="miho" pos="auto" src="miho166"/>
		<msg @l="611" char_id="-1" frame_id="-1" name=""
		   text="私は競泳用コースの脇、プールサイドで泳ぎ方を指導していた。" voices=""/>
		<msg @l="612" char_id="-1" frame_id="-1" name=""
		   text="この方がプールに入って指導するより、皆の身体の浮き沈みが良く見えるから、できるだけこうしていたいとも思う。" voices=""/>
		<msg @l="613" char_id="-1" frame_id="-1" name="" text="･･‥‥でも･･････。"
		   voices=""/>
		<msg @l="615" char_id="-1" frame_id="-1" name="渡部" text="『‥‥‥‥。』" voices=""/>
		<msg @l="617" char_id="-1" frame_id="-1" name=""
		   text="なぜか、私の隣には渡部先生が立っている‥‥。" voices=""/>
		<msg @l="618" char_id="-1" frame_id="-1" name=""
		   text="ずっと隣に張り付いて、私の胸元や腰周りに、にやついて下卑な視線を送り続ける。" voices=""/>
		<char @l="621" id="miho" pos="auto" src="miho066"/>
		<msg @l="623" char_id="0" frame_id="-1" name="美帆"
		   text="『もっと身体を伸ばして‥‥腰が沈むのは力が入ってるからですよー。』" voices=""/>
		<msg @l="625" char_id="-1" frame_id="-1" name="渡部" text="『‥‥‥‥。』" voices=""/>
		<msg @l="627" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<char @l="630" id="miho" pos="auto" src="miho166"/>
		<msg @l="632" char_id="0" frame_id="-1" name="美帆"
		   text="(早く向こうに行ってくれないかしら･･････)" voices=""/>
		<msg @l="634" char_id="0" frame_id="-1" name="美帆"
		   text="(何も言わずに････ただじっと‥‥いやらしい目で私の身体ばっかり観ていないでよ‥‥)" voices=""/>
		<msg @l="636" char_id="-1" frame_id="-1" name="渡部" text="『‥‥どうした、指導しないのか？』"
		   voices=""/>
		<char @l="639" id="miho" pos="auto" src="miho064"/>
		<msg @l="641" char_id="0" frame_id="-1" name="美帆" text="『あ‥‥は、はい。』"
		   voices=""/>
		<char @l="644" id="miho" pos="auto" src="miho160"/>
		<msg @l="646" char_id="-1" frame_id="-1" name=""
		   text="再び、私は泳いでいる子の方へ視線を戻した。" voices=""/>
		<msg @l="647" char_id="-1" frame_id="-1" name="" text="この瞬間‥‥･･、" voices=""/>
		<msg @l="648" char_id="-1" frame_id="-1" name="" text="何かが私の腰をぞわりと撫でた。"
		   voices=""/>
		<stopbgm @l="651" fadeout="1000"/>
		<char @l="654" id="miho" pos="center" src="miho064f" y="-80"/>
		<begin_trans @l="656" time="500"/>
		<layer @l="657" id="cutin_f" src="game_window_cutin" x="20" y="20" z="-1001"/>
		<layer @l="658" id="cutin" src="cut004b" x="32" y="32" z="-1000"/>
		<end_trans @l="659"/>
		<msg @l="661" char_id="0" frame_id="-1" name="美帆" text="『！？････え‥‥？』"
		   voices=""/>
		<msg @l="663" char_id="-1" frame_id="-1" name=""
		   text="それは確かめるまでもない、渡部先生の手だ。" voices=""/>
		<bgm @l="666" src="bgm15" volume="1."/>
		<msg @l="668" char_id="-1" frame_id="-1" name="渡部"
		   text="『どうした？‥‥そのまま指導は続けろよ？』" voices=""/>
		<char @l="671" id="miho" pos="center" src="miho065f" y="-80"/>
		<msg @l="673" char_id="0" frame_id="-1" name="美帆" text="『や、やめ‥‥。』" voices=""/>
		<msg @l="675" char_id="-1" frame_id="-1" name="渡部"
		   text="『そうやって抵抗してると、妹に気付かれるんじゃないか？』" voices=""/>
		<msg @l="677" char_id="0" frame_id="-1" name="美帆" text="『‥‥！』" voices=""/>
		<clear @l="680" class="char"/>
		<char @l="683" id="akina" pos="right" src="akina161"/>
		<msg @l="685" char_id="-1" frame_id="-1" name=""
		   text="私は咄嗟に、プールサイドで休んでいる亜季奈を見る。" voices=""/>
		<msg @l="686" char_id="-1" frame_id="-1" name=""
		   text="亜季奈は近くにいる水泳部の子と話をしていて、私の方を見てはいない。" voices=""/>
		<clear @l="689" class="char"/>
		<char @l="692" id="miho" pos="center" src="miho065f" y="-80"/>
		<begin_trans @l="694" time="500"/>
		<layer @l="695" id="cutin_f" src="game_window_cutin" x="20" y="20" z="-1001"/>
		<layer @l="696" id="cutin" src="cut004" x="32" y="32" z="-1000"/>
		<end_trans @l="697"/>
		<msg @l="699" char_id="-1" frame_id="-1" name="渡部"
		   text="『良かったじゃないか？気付かれてなくて････。』" voices=""/>
		<msg @l="701" char_id="-1" frame_id="-1" name="渡部"
		   text="『俺とお前がさわりっこしてるのを、妹に知られちゃまずいからなぁ？』" voices=""/>
		<char @l="704" id="miho" pos="center" src="miho064f" y="-80"/>
		<msg @l="706" char_id="0" frame_id="-1" name="美帆"
		   text="『なっ！&#32;さ、さわりっこなんて、そんな事っ！&#32;これは････渡部先生が一方的に‥････。』" voices=""/>
		<char @l="709" id="miho" pos="center" src="miho065f" y="-80"/>
		<msg @l="711" char_id="0" frame_id="-1" name="美帆"
		   text="『そ、それに････先生だって、私にこんな事をしてるなんて誰かにバレたら‥‥今度こそ教師を辞めなければならなくなりますよ･･････？』"
		   voices=""/>
		<msg @l="713" char_id="-1" frame_id="-1" name="渡部"
		   text="『ああ、もしそうなったら今度は妹の方が大変なことになる、かもな。』" voices=""/>
		<msg @l="715" char_id="0" frame_id="-1" name="美帆" text="『え‥‥。』" voices=""/>
		<msg @l="717" char_id="-1" frame_id="-1" name="渡部"
		   text="『聞こえなかったらしいから、俺がもう一度言ってやろう。････今度は妹の方が大変な事になる････って言ったんだよ。』"
		   voices=""/>
		<msg @l="719" char_id="0" frame_id="-1" name="美帆"
		   text="『！？･･亜季奈ですって！？････どうして････亜季奈には関係ないっ！！』" voices=""/>
		<msg @l="721" char_id="-1" frame_id="-1" name="渡部" text="『俺にはあるんだよ。』"
		   voices=""/>
		<msg @l="723" char_id="-1" frame_id="-1" name="渡部"
		   text="『亜季奈が俺に犯されるかな？&#32;それとも妹が大事にしている水泳、辞めさせるか？････まぁ、俺はどっちだって構わねぇんだが･･････』"
		   voices=""/>
		<msg @l="725" char_id="-1" frame_id="-1" name="渡部"
		   text="『お前的には････どっちにしたって、大事なモンを失くすけどな？』" voices=""/>
		<msg @l="727" char_id="0" frame_id="-1" name="美帆" text="『そんなっ‥‥。』" voices=""/>
		<msg @l="729" char_id="-1" frame_id="-1" name="渡部"
		   text="『あぁ、出るとこ出たって、俺がこんな事を言ってたなんて証拠はねぇし、いつでもお前の妹如き、犯せるからな･･････。』"
		   voices=""/>
		<msg @l="731" char_id="-1" frame_id="-1" name="渡部"
		   text="『解ったろ？ハナっからお前に勝ち目なんてねぇんだよ。』" voices=""/>
		<msg @l="733" char_id="0" frame_id="-1" name="美帆" text="『････なっ････････』"
		   voices=""/>
		<msg @l="735" char_id="-1" frame_id="-1" name="渡部"
		   text="『あ？････なんだって？････良く聞こえねぇ』" voices=""/>
		<msg @l="737" char_id="0" frame_id="-1" name="美帆"
		   text="『････亜季奈にまで････そんな事･･････』" voices=""/>
		<msg @l="739" char_id="-1" frame_id="-1" name="渡部"
		   text="『････くくっ････妹には手を出さないでってか？････おーおー、良いお姉さんだねぇ･･････』" voices=""/>
		<msg @l="741" char_id="0" frame_id="-1" name="美帆"
		   text="『･･････あなたって人はっ･･････』" voices=""/>
		<msg @l="743" char_id="-1" frame_id="-1" name="渡部"
		   text="『ま、俺もオニじゃねぇから････、お前にも妹を守る方法････一つくらいはくれてやってもいいかなぁ･･････。』"
		   voices=""/>
		<msg @l="745" char_id="0" frame_id="-1" name="美帆" text="『な、なんですか？』"
		   voices=""/>
		<msg @l="747" char_id="-1" frame_id="-1" name="渡部"
		   text="『オマエが身代わりになりゃあいいじゃねぇか？････そうだ、それがいい。是非、そうしろ。』" voices=""/>
		<msg @l="749" char_id="-1" frame_id="-1" name="渡部"
		   text="『かわいい妹が俺の毒牙にかかるのは嫌なんだろ？････くくっ････これなら、カンタンでいいじゃねぇか。』" voices=""/>
		<msg @l="751" char_id="0" frame_id="-1" name="美帆" text="『くっ‥‥‥‥。』" voices=""/>
		<msg @l="754" char_id="-1" frame_id="-1" name="渡部"
		   text="『おいおい、なに噛んでるんだ？････俺の提案、解んなかったのか？････しょうがねぇなぁ･･解説つけてやるよ。俺はな？･･妹の代わりに、お前が俺の相手をすりゃあいいって言ってんだよ。』"
		   voices=""/>
		<msg @l="756" char_id="-1" frame_id="-1" name="" text="私の耳元に、生臭い吐息が感じられる。"
		   voices=""/>
		<msg @l="757" char_id="-1" frame_id="-1" name=""
		   text="渡部はねっとりと囁きながら、その汚らしい指先で、私の太股をねばつく様に撫で擦った。" voices=""/>
		<msg @l="758" char_id="-1" frame_id="-1" name=""
		   text="もう一方の渡部の手が、立ち尽くした私の腰へ這い回り、そのままゆっくり下降した。" voices=""/>
		<msg @l="759" char_id="-1" frame_id="-1" name=""
		   text="拡げられた五本の指が、身動きを忘れた私のお尻を揉みしだく。" voices=""/>
		<msg @l="760" char_id="-1" frame_id="-1" name=""
		   text="泥でも捏ね廻す様な渡部の動きが、お尻の肉を歪ませた。" voices=""/>
		<msg @l="761" char_id="-1" frame_id="-1" name="" text="そして‥‥･･、" voices=""/>
		<begin_trans @l="764" time="500"/>
		<layer @l="765" id="cutin_f" src="game_window_cutin" x="20" y="20" z="-1001"/>
		<layer @l="766" id="cutin" src="cut004b" x="32" y="32" z="-1000"/>
		<end_trans @l="767"/>
		<msg @l="769" char_id="0" frame_id="-1" name="美帆" text="『‥‥っ！！』" voices=""/>
		<msg @l="771" char_id="-1" frame_id="-1" name=""
		   text="芋虫みたいに太い指が‥‥お尻の谷間に沿って前へと回る。" voices=""/>
		<msg @l="772" char_id="-1" frame_id="-1" name=""
		   text="怖気を振るうその感触に、私は思わず肩を震わせて彼を睨むが‥‥･･、" voices=""/>
		<msg @l="773" char_id="-1" frame_id="-1" name=""
		   text="下卑た笑みを孕んだ渡部の視線が、そんな私の無言の抗議を跳ね返した。" voices=""/>
		<msg @l="775" char_id="-1" frame_id="-1" name="渡部"
		   text="『眼一杯、睨んでくれちゃって････妹がどうなっても構わねぇなら、そうしてろ。‥‥それが嫌なら････大人しくしてろ。』"
		   voices=""/>
		<char @l="778" id="miho" pos="center" src="miho165f" y="-80"/>
		<msg @l="780" char_id="0" frame_id="-1" name="美帆" text="(なんで‥‥どうして‥‥‥‥)"
		   voices=""/>
		<msg @l="782" char_id="0" frame_id="-1" name="美帆"
		   text="(忘れていたのに‥‥‥これじゃ３年前と‥‥･･)" voices=""/>
		<msg @l="784" char_id="-1" frame_id="-1" name="" text="･･････何も････できなかった。"
		   voices=""/>
		<msg @l="785" char_id="-1" frame_id="-1" name="" text="私が亜季奈を守らなければ‥‥･･、"
		   voices=""/>
		<msg @l="786" char_id="-1" frame_id="-1" name=""
		   text="今度はあの子が、あの時の私と同じ目に遭わされてしまう･･････。" voices=""/>
		<msg @l="787" char_id="-1" frame_id="-1" name="" text="それだけは･･････、"
		   voices=""/>
		<msg @l="789" char_id="-1" frame_id="-1" name="" text="それだけは、何があっても･･････。"
		   voices=""/>
		<msg @l="791" char_id="-1" frame_id="-1" name="水泳部の子Ａ"
		   text="『あの‥‥今のフォーム、どこかいけないところがありましたか？』" voices=""/>
		<char @l="794" id="miho" pos="center" src="miho064f" y="-80"/>
		<msg @l="796" char_id="0" frame_id="-1" name="美帆" text="『あっ！？････は、はい！』"
		   voices=""/>
		<msg @l="798" char_id="-1" frame_id="-1" name=""
		   text="不意に、泳いでいた子が私に話しかけてくる。" voices=""/>
		<msg @l="799" char_id="-1" frame_id="-1" name=""
		   text="咄嗟に離れようと身を捩ったが、私を撫で回している渡部の腕は離れない。" voices=""/>
		<char @l="802" id="miho" pos="center" src="miho165f" y="-80"/>
		<msg @l="804" char_id="0" frame_id="-1" name="美帆"
		   text="『ちょっと‥‥いやっ‥‥離してくださいっ。』" voices=""/>
		<msg @l="806" char_id="-1" frame_id="-1" name=""
		   text="私は水泳部の子に聞こえないよう、顔を背けて小さく言った。" voices=""/>
		<msg @l="807" char_id="-1" frame_id="-1" name=""
		   text="あまり彼女に見られていると、自分が何をされているのか知られてしまう。" voices=""/>
		<msg @l="809" char_id="-1" frame_id="-1" name="水泳部の子Ａ" text="『あの――？』"
		   voices=""/>
		<msg @l="811" char_id="-1" frame_id="-1" name="渡部"
		   text="『そら、ちゃんと教えてやらないと怪しまれるぞ？』" voices=""/>
		<msg @l="813" char_id="-1" frame_id="-1" name="渡部"
		   text="『優しい「お姉ちゃん」としては、妹の道を閉ざしたくはないだろ？』" voices=""/>
		<char @l="816" id="miho" pos="center" src="miho065f" y="-80"/>
		<msg @l="818" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="820" char_id="-1" frame_id="-1" name="水泳部の子Ａ" text="『あの、仲根先輩‥‥？』"
		   voices=""/>
		<char @l="823" id="miho" pos="center" src="miho066f" y="-80"/>
		<msg @l="825" char_id="0" frame_id="-1" name="美帆" text="『あ、ああ、ごめんなさい‥‥‥‥。』"
		   voices=""/>
		<msg @l="826" char_id="0" frame_id="-1" name="美帆"
		   text="『い、いまのは‥‥腕をもっとしっかり伸ばせば、もう少し‥‥‥‥んんっ！』" voices=""/>
		<char @l="829" id="miho" pos="center" src="miho065f" y="-80"/>
		<msg @l="831" char_id="-1" frame_id="-1" name=""
		   text="部員に気付かれる危険がここにあるにも関わらず、渡部は私を弄る掌を止めようとはしない。" voices=""/>
		<msg @l="832" char_id="-1" frame_id="-1" name=""
		   text="貼り付けた薄ら笑いもそのままに、水着の上から、私の秘部を擦り上げ続ける。" voices=""/>
		<msg @l="833" char_id="-1" frame_id="-1" name="" text="くにゅ、くにゅ。" voices=""/>
		<msg @l="835" char_id="0" frame_id="1" name="美帆"
		   text="（我慢しなきゃ‥‥‥知られてしまうわけにはいかない‥‥‥‥）" voices=""/>
		<msg @l="837" char_id="-1" frame_id="-1" name="水泳部の子Ａ"
		   text="『あのー、腕を伸ばせば良いんですか‥‥？』" voices=""/>
		<char @l="840" id="miho" pos="center" src="miho066f" y="-80"/>
		<msg @l="842" char_id="0" frame_id="1" name="美帆"
		   text="『え‥‥‥ええ。腕を‥‥‥伸ばせば‥‥‥‥んんっ‥‥‥‥‥‥早くなると思いますよ‥‥‥‥‥‥。』" voices=""/>
		<msg @l="844" char_id="0" frame_id="1" name="美帆"
		   text="『取り敢えず‥‥‥‥やってみましょう‥‥‥‥か‥‥‥。』" voices=""/>
		<msg @l="846" char_id="-1" frame_id="-1" name="水泳部の子Ａ"
		   text="『‥‥‥‥？&#32;はい、腕を伸ばす‥‥わかりました、やってみます。』" voices=""/>
		<msg @l="848" char_id="-1" frame_id="-1" name=""
		   text="私のアドバイスを復唱しながら、部員はコースに戻っていく。" voices=""/>
		<msg @l="849" char_id="-1" frame_id="-1" name=""
		   text="途中、一度だけ振り返って私を見たが、その視線には僅かな怪訝が感じられた。" voices=""/>
		<msg @l="851" char_id="-1" frame_id="-1" name="渡部" text="『さすが、的確なアドバイスだな。』"
		   voices=""/>
		<char @l="854" id="miho" pos="center" src="miho065f" y="-80"/>
		<msg @l="856" char_id="0" frame_id="1" name="美帆" text="『んんっ‥‥。』" voices=""/>
		<msg @l="858" char_id="-1" frame_id="-1" name=""
		   text="私へのご褒美とでも言わんばかりに、執拗に指を這わせてくる。" voices=""/>
		<msg @l="860" char_id="-1" frame_id="-1" name="" text="くりゅ、くりゅ、くりゅ。"
		   voices=""/>
		<msg @l="862" char_id="-1" frame_id="-1" name=""
		   text="敏感な部分を嬲られる嫌悪感に泣き出したくなる。" voices=""/>
		<msg @l="863" char_id="-1" frame_id="-1" name=""
		   text="出来る事なら、このまま悲鳴を上げてしまいたいが、それをすれば渡部は亜季奈をどう扱うか･･････。" voices=""/>
		<msg @l="864" char_id="-1" frame_id="-1" name=""
		   text="私は震えだす身体を諌めながら、練習中の部員達のフォームをチェックするふりを続けるしかなかった･･････。" voices=""/>
		<msg @l="866" char_id="-1" frame_id="-1" name="渡部"
		   text="『いいぞ、その調子でがんばれよ‥‥コーチ。』" voices=""/>
		<msg @l="868" char_id="0" frame_id="1" name="美帆" text="(なんでこうなっちゃうの‥‥‥？)"
		   voices=""/>
		<msg @l="870" char_id="0" frame_id="1" name="美帆"
		   text="(どうして････こんなこと･･････)" voices=""/>
		<msg @l="872" char_id="-1" frame_id="-1" name=""
		   text="答えなど出ないと解っていながら、それでも自問せずにはいられない。" voices=""/>
		<msg @l="873" char_id="-1" frame_id="-1" name=""
		   text="こうしているのが愚かしい事と解っていながら･･････、" voices=""/>
		<msg @l="874" char_id="-1" frame_id="-1" name="" text="渡部が自分を蹂躙するのを‥‥･･、"
		   voices=""/>
		<msg @l="875" char_id="-1" frame_id="-1" name=""
		   text="じっと黙って、立っている事しかできなかった･･････。" voices=""/>
		<msg @l="876" char_id="-1" frame_id="-1" name="" text="･･････。" voices=""/>
		<stopbgm @l="879" fadeout="1000"/>
		<clear @l="882" class="all"/>
		<wait_chgmv/>
		<bg @l="885" src="bg11"/>
		<bgm @l="888" src="bgm03" volume="1."/>
		<char @l="891" id="miho" pos="auto" src="miho166"/>
		<msg @l="893" char_id="0" frame_id="1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="895" char_id="-1" frame_id="-1" name=""
		   text="練習が終わり、水泳部の子たちはとうに着替えを終えていた。" voices=""/>
		<msg @l="896" char_id="-1" frame_id="-1" name=""
		   text="さっきまでは中から聞こえた嬌声も聞こえない。" voices=""/>
		<msg @l="897" char_id="-1" frame_id="-1" name=""
		   text="ひとり後片付けで遅くなった私は、ようやく更衣室に戻って来た。" voices=""/>
		<msg @l="899" char_id="0" frame_id="1" name="美帆"
		   text="(シャワー浴びるの‥‥ちょっと面倒だな‥‥‥‥)" voices=""/>
		<msg @l="901" char_id="-1" frame_id="-1" name=""
		   text="本当に･･････疲れていた･･････。" voices=""/>
		<msg @l="902" char_id="-1" frame_id="-1" name="" text="あの渡部が再び私の前に姿を現し‥‥･･、"
		   voices=""/>
		<msg @l="903" char_id="-1" frame_id="-1" name="" text="そして、体を嬲られた‥‥。"
		   voices=""/>
		<msg @l="904" char_id="-1" frame_id="-1" name=""
		   text="亜季奈を守る為とはいえ、抵抗する事もできず身体を触られ続けてしまった。" voices=""/>
		<msg @l="905" char_id="-1" frame_id="-1" name="" text="３年前もそうだった‥‥･･。"
		   voices=""/>
		<msg @l="906" char_id="-1" frame_id="-1" name=""
		   text="初めはスキンシップを装った、私への性的なイタズラから始まった。" voices=""/>
		<msg @l="907" char_id="-1" frame_id="-1" name="" text="それは徐々にエスカレートし‥‥･･、"
		   voices=""/>
		<msg @l="908" char_id="-1" frame_id="-1" name="" text="あの事件へと行き着いた･･････。"
		   voices=""/>
		<clear @l="911" class="char"/>
		<char @l="913" id="miho" pos="left" src="miho166"/>
		<char @l="915" id="akina" pos="right" src="akina014"/>
		<msg @l="917" char_id="2" frame_id="-1" name="亜季奈"
		   text="『あれ、お姉ちゃん‥‥まだ着替えてなかったの？』" voices=""/>
		<char @l="920" id="miho" pos="left" src="miho066"/>
		<msg @l="922" char_id="0" frame_id="1" name="美帆" text="『うん‥‥さっきまで後片付けしてて。』"
		   voices=""/>
		<char @l="925" id="akina" pos="right" src="akina015"/>
		<msg @l="927" char_id="2" frame_id="-1" name="亜季奈"
		   text="『ごめんね、そんな事までさせちゃって‥‥。』" voices=""/>
		<char @l="930" id="miho" pos="left" src="miho066"/>
		<msg @l="932" char_id="0" frame_id="1" name="美帆"
		   text="『いいんだってば････。ここでは亜季奈たちの方が主役だもんね？』" voices=""/>
		<msg @l="934" char_id="0" frame_id="1" name="美帆"
		   text="『私だって、みんなには気持ち良く頑張って欲しいから。』" voices=""/>
		<char @l="937" id="akina" pos="right" src="akina011"/>
		<msg @l="939" char_id="2" frame_id="-1" name="亜季奈"
		   text="『えへへ、ありがと。そんなおねえちゃん、大好きだよっ。』" voices=""/>
		<char @l="942" id="miho" pos="left" src="miho063"/>
		<msg @l="944" char_id="0" frame_id="1" name="美帆" text="『もうっ、亜季奈ってばぁ･･････。』"
		   voices=""/>
		<char @l="947" id="akina" pos="right" src="akina010"/>
		<msg @l="949" char_id="2" frame_id="-1" name="亜季奈"
		   text="『それよりさ、おねえちゃん‥‥ちょっと顔色悪いけど、大丈夫？』" voices=""/>
		<char @l="952" id="miho" pos="left" src="miho166"/>
		<msg @l="954" char_id="0" frame_id="1" name="美帆"
		   text="『ん‥‥大丈夫、少し････疲れただけだから。』" voices=""/>
		<char @l="957" id="akina" pos="right" src="akina111"/>
		<msg @l="959" char_id="2" frame_id="-1" name="亜季奈"
		   text="『そっか‥‥って、今日はこんな話ばっかりしてるね。』" voices=""/>
		<char @l="962" id="miho" pos="left" src="miho066"/>
		<msg @l="964" char_id="0" frame_id="1" name="美帆" text="『ふふ、そうだね。』" voices=""/>
		<char @l="967" id="akina" pos="right" src="akina011"/>
		<msg @l="969" char_id="2" frame_id="-1" name="亜季奈"
		   text="『それよりさ、早く着替えて外に出ようよ。』" voices=""/>
		<msg @l="971" char_id="2" frame_id="-1" name="亜季奈"
		   text="『なんかこの更衣室、冷房効きすぎてて寒いし。』" voices=""/>
		<char @l="974" id="miho" pos="left" src="miho060"/>
		<msg @l="976" char_id="0" frame_id="1" name="美帆"
		   text="『うん‥‥でも、私まだシャワー浴びてないから。』" voices=""/>
		<char @l="979" id="akina" pos="right" src="akina014"/>
		<msg @l="981" char_id="2" frame_id="-1" name="亜季奈" text="『え、そうなんだ？』"
		   voices=""/>
		<char @l="984" id="miho" pos="left" src="miho166"/>
		<msg @l="986" char_id="0" frame_id="1" name="美帆"
		   text="（････触られた感触が残ってて････気持ち悪いから･･････。私････こんなの身体に残して帰りたくないよ‥‥･･）"
		   voices=""/>
		<char @l="989" id="miho" pos="left" src="miho066"/>
		<msg @l="991" char_id="0" frame_id="1" name="美帆"
		   text="『･･････亜季奈、今日は先に戻ってていいよ。』" voices=""/>
		<char @l="994" id="akina" pos="right" src="akina010"/>
		<msg @l="996" char_id="2" frame_id="-1" name="亜季奈"
		   text="『そっか‥‥じゃ、悪いけどここの戸締りもお願いしていい？』" voices=""/>
		<msg @l="998" char_id="0" frame_id="1" name="美帆"
		   text="『はいはい、お客さんは気にせず帰っていいですよーだ。』" voices=""/>
		<char @l="1001" id="akina" pos="right" src="akina111"/>
		<msg @l="1003" char_id="2" frame_id="-1" name="亜季奈" text="『やった♪』" voices=""/>
		<msg @l="1005" char_id="2" frame_id="-1" name="亜季奈" text="『それじゃ、また明日ねっ！』"
		   voices=""/>
		<msg @l="1007" char_id="0" frame_id="1" name="美帆" text="『うん、気をつけてね？』"
		   voices=""/>
		<clear @l="1010" class="char"/>
		<char @l="1012" id="miho" pos="auto" src="miho166"/>
		<msg @l="1014" char_id="0" frame_id="1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="1016" char_id="0" frame_id="1" name="美帆" text="『気をつけてね‥‥か･･････。』"
		   voices=""/>
		<msg @l="1018" char_id="-1" frame_id="-1" name=""
		   text="元気良く更衣室を出て行く亜季奈の背中を見送りながら、私は小さく呟いた。" voices=""/>
		<msg @l="1019" char_id="-1" frame_id="-1" name=""
		   text="渡部の「つもり」を聞かされた以上･･････、" voices=""/>
		<msg @l="1020" char_id="-1" frame_id="-1" name=""
		   text="今さら「気をつけて」も何もないのに･･････。" voices=""/>
		<msg @l="1021" char_id="-1" frame_id="-1" name=""
		   text="とにかく亜季奈の身には、あの男の欲望が降り掛からないようにしなければ･･････。" voices=""/>
		<msg @l="1022" char_id="-1" frame_id="-1" name="" text="亜季奈を･･････、"
		   voices=""/>
		<msg @l="1023" char_id="-1" frame_id="-1" name=""
		   text="大切な妹を守れるのは、私しかいないのだから‥‥･･。" voices=""/>
		<char @l="1026" id="miho" pos="auto" src="miho165"/>
		<msg @l="1028" char_id="0" frame_id="1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="1030" char_id="0" frame_id="1" name="美帆"
		   text="(さっさとシャワーを浴びて、今日は帰ろう･･････)" voices=""/>
		<msg @l="1032" char_id="0" frame_id="1" name="美帆"
		   text="(それから、どうしなくちゃいけないかを考えなくちゃ‥‥･･)" voices=""/>
		<clear @l="1035" class="char"/>
		<label @l="1038" id="event_scene17"/>
		<msg @l="1040" char_id="-1" frame_id="-1" name=""
		   text="ロッカーからバスタオルを取り出して･･････、" voices=""/>
		<msg @l="1041" char_id="-1" frame_id="-1" name=""
		   text="シャワー室へ向かおうとしたその瞬間‥‥･･。" voices=""/>
		<bgm @l="1044" src="bgm13" volume="1."/>
		<msg @l="1046" char_id="-1" frame_id="-1" name="" text="突然、黒い影が覆い被さって‥‥･･、"
		   voices=""/>
		<msg @l="1047" char_id="-1" frame_id="-1" name=""
		   text="私は背後にあったロッカーに、無理やりに押し付けられてしまっていた。" voices=""/>
		<msg @l="1049" char_id="0" frame_id="1" name="美帆" text="『な、何を―――――！？&#32;』"
		   voices="miho03460"/>
		<msg @l="1051" char_id="-1" frame_id="-1" name="黒い影"
		   text="『おっと、大きな声は出さない方がいいな。』" voices=""/>
		<msg @l="1053" char_id="0" frame_id="1" name="美帆" text="『あ‥‥アナタはっ！！&#32;』"
		   voices="miho03470"/>
		<label @l="1056" id="chart_line11"/>
		<wait_chgmv/>
		<ev @l="1059" src="ev-017"/>
		<description @l="1062" text="悪夢再来"/>
		<msg @l="1064" char_id="-1" frame_id="-1" name="渡部"
		   text="『はは、初日から二人きりになれるとは思わなかったぜ？』" voices=""/>
		<msg @l="1066" char_id="-1" frame_id="-1" name="渡部"
		   text="『面白いくらい都合よく妹を追っ払うから、てっきり、隠れてたのがバレたかと思ってヒヤヒヤしたぞ。』" voices=""/>
		<msg @l="1068" char_id="0" frame_id="1" name="美帆"
		   text="『そんな‥‥知ってたら、一人になったりしませんっ。』" voices="miho03480"/>
		<msg @l="1070" char_id="-1" frame_id="-1" name="渡部" text="『そいつはどうだろうなぁ‥‥？』"
		   voices=""/>
		<msg @l="1072" char_id="-1" frame_id="-1" name="渡部"
		   text="『練習中にあれだけ念入りにさわってやったんだ。ホントは俺のモノをぶち込んで欲しくてたまらないんだろ？』" voices=""/>
		<msg @l="1074" char_id="0" frame_id="1" name="美帆"
		   text="『そ、そんなこと‥‥絶対、ありませんっ。』" voices="miho03490"/>
		<msg @l="1076" char_id="-1" frame_id="-1" name="渡部"
		   text="『女ってヤツは言ってる事と思っていることが違うからな。』" voices=""/>
		<msg @l="1078" char_id="-1" frame_id="-1" name="渡部"
		   text="『心配しなくても‥‥ちゃんと身体の方に聞いてやるよ。』" voices=""/>
		<msg @l="1080" char_id="-1" frame_id="-1" name=""
		   text="渡部の掌が水着の上から、私の胸を鷲掴みにした。" voices=""/>
		<msg @l="1081" char_id="-1" frame_id="-1" name=""
		   text="一度、手を放したかと思うと、今度は捏ねる様に膨らみを掬う。" voices=""/>
		<msg @l="1082" char_id="-1" frame_id="-1" name=""
		   text="先端部分を無骨な掌が撫で擦り、双乳が強弱をつけて揉みほぐされる。" voices=""/>
		<msg @l="1083" char_id="-1" frame_id="-1" name=""
		   text="気持ち悪さと恐怖が、一瞬で私の背筋を駆け上った。" voices=""/>
		<msg @l="1085" char_id="0" frame_id="1" name="美帆" text="『やだっ‥‥やめてくださいっ。』"
		   voices="miho03500"/>
		<msg @l="1087" char_id="-1" frame_id="-1" name="渡部"
		   text="『大人しくしろ、すぐに自分から欲しくなる‥‥‥コイツをな。』" voices=""/>
		<msg @l="1089" char_id="-1" frame_id="-1" name=""
		   text="太腿の辺りに、ゴリゴリと硬いモノが押し付けられる。" voices=""/>
		<msg @l="1091" char_id="0" frame_id="1" name="美帆" text="『ひ――――ッ！？』"
		   voices="miho03510"/>
		<msg @l="1093" char_id="-1" frame_id="-1" name="渡部"
		   text="『俺のはそこいらのガキどもと違って････ハンパじゃねぇぞ。』" voices=""/>
		<msg @l="1095" char_id="-1" frame_id="-1" name="渡部"
		   text="『しっかり奥まで届いてな、滅茶苦茶に中身をかき混ぜてやれるぜ。』" voices=""/>
		<msg @l="1097" char_id="0" frame_id="1" name="美帆"
		   text="『いやっ‥‥やだ、離してくださいッ！！』" voices="miho03520"/>
		<msg @l="1099" char_id="-1" frame_id="-1" name=""
		   text="私は渡部の手の中から逃げ出そうと、必死になって抵抗する。" voices=""/>
		<msg @l="1100" char_id="-1" frame_id="-1" name="" text="けれど、力ではどうしたって敵わない。"
		   voices=""/>
		<msg @l="1101" char_id="-1" frame_id="-1" name=""
		   text="闇雲に暴れてはみたが、腕一つ跳ね除ける事が出来なかった。" voices=""/>
		<msg @l="1103" char_id="-1" frame_id="-1" name="渡部"
		   text="『はははははははっ、やめとけって。無駄だよ、無駄っ！！』" voices=""/>
		<msg @l="1105" char_id="-1" frame_id="-1" name="渡部"
		   text="『お前ひとり暴れたところで････ヒネっちまうのは簡単なんだよ！』" voices=""/>
		<se @l="1108" buf="1" src="金属扉にモノを叩きつけた音" volume="1."/>
		<flash @l="1110" count="4" fade="100" image="white"/>
		<shake @l="1112" amp="10" class="all" cycle="30" duration="100"
		   type="random"/>
		<msg @l="1114" char_id="0" frame_id="1" name="美帆" text="『あぐっ。』"
		   voices="miho03530"/>
		<msg @l="1116" char_id="-1" frame_id="-1" name=""
		   text="勢いよく身体を押し込まれ、私は強かに頭を打ちつけた。" voices=""/>
		<msg @l="1117" char_id="-1" frame_id="-1" name=""
		   text="途端に意識がぐらりと揺れて、視界が真っ白に霞み始める" voices=""/>
		<msg @l="1118" char_id="-1" frame_id="-1" name=""
		   text="朦朧となった私から、渡部は左手で片足を抱え上げ、乱暴に水着を横にずらした。" voices=""/>
		<msg @l="1119" char_id="-1" frame_id="-1" name=""
		   text="空いた右手はもどかしそうにズボンを下ろし、早くも狂った様な隆起を見せる、グロテスクな肉棒を掴み出した。" voices=""/>
		<msg @l="1120" char_id="-1" frame_id="-1" name=""
		   text="耳元には、顔を背けたくなる臭気が篭った、喘ぐ渡部の呼気が吹きかけられる。" voices=""/>
		<msg @l="1121" char_id="-1" frame_id="-1" name=""
		   text="憑かれた様に行為を焦る渡部の呼吸と視線からは、私は獣の饐えた臭いしか感じなかった。" voices=""/>
		<msg @l="1122" char_id="-1" frame_id="-1" name="渡部"
		   text="『とっととイッパツ････ヤッちまうかな･･････』" voices=""/>
		<msg @l="1123" char_id="-1" frame_id="-1" name=""
		   text="野卑な笑みを浮かべた渡部の顔が、白く滲んだ私の脳裏に灼きついた。" voices=""/>
		<msg @l="1124" char_id="-1" frame_id="-1" name=""
		   text="吊り上がった口の端から、涎が粘つく糸を曳いている。" voices=""/>
		<msg @l="1125" char_id="-1" frame_id="-1" name=""
		   text="渡部は限界寸前まで膨れ上がった肉塊を秘裂に押し付け、委細構わず、内部への侵入準備を完了した。" voices=""/>
		<msg @l="1127" char_id="-1" frame_id="-1" name="" text="途端、恐怖で意識が鮮明になる。"
		   voices=""/>
		<msg @l="1129" char_id="0" frame_id="1" name="美帆"
		   text="（処女を奪われてしまう‥‥。好きな人に捧げようと思っていたのに‥‥。）" voices="miho03540"/>
		<msg @l="1131" char_id="0" frame_id="1" name="美帆" text="『いや‥‥いやっ‥‥いや！！』"
		   voices="miho03550"/>
		<msg @l="1133" char_id="0" frame_id="1" name="美帆"
		   text="『いやあああああああああああああああっ！！』" voices="miho03560"/>
		<msg @l="1135" char_id="-1" frame_id="-1" name="渡部"
		   text="『うるせぇッ！どうせ泣くなら、もっと絶望的に哭きやがれッ！！！』" voices=""/>
		<se @l="1139" buf="1" src="平手打ち" volume="1."/>
		<flash @l="1141" count="4" fade="100" image="white"/>
		<msg @l="1143" char_id="0" frame_id="1" name="美帆"
		   text="『あぐっ‥‥いやっ、助けて‥‥‥‥誰か助けてっ！！』" voices="miho03570"/>
		<msg @l="1145" char_id="-1" frame_id="-1" name="" text="頬に痺れる灼熱が疾り抜ける。"
		   voices=""/>
		<msg @l="1146" char_id="-1" frame_id="-1" name=""
		   text="苦痛が恐怖を煽り立て、悲鳴以外の絶叫すら、私は上げる事ができなかった。" voices=""/>
		<msg @l="1148" char_id="-1" frame_id="-1" name="渡部"
		   text="『ち‥‥くだらねぇな、オンナってのはよ！ピーピー、バカみてぇに騒ぎやがって････別の泣き方してみせろって言ってんだろうが･･････。』"
		   voices=""/>
		<msg @l="1149" char_id="-1" frame_id="-1" name=""
		   text="露骨に顔を顰めてみせる渡部の声は、言葉とは全く裏腹に、歓喜に弾んでいる様にすら感じられる。" voices=""/>
		<msg @l="1150" char_id="-1" frame_id="-1" name=""
		   text="私がどんな抵抗を見せたとしても、心の中では大喜びしているに違いない。" voices=""/>
		<msg @l="1151" char_id="-1" frame_id="-1" name=""
		   text="私がここにいる限り、渡部にとって、それは悦楽の一つに過ぎないのだと･･････、" voices=""/>
		<msg @l="1152" char_id="-1" frame_id="-1" name=""
		   text="なんとなくは、理解できてしまっていた･･････。" voices=""/>
		<msg @l="1154" char_id="-1" frame_id="-1" name="渡部"
		   text="『ま、グダグダ言っても始まんねぇか‥‥。ブチ込んじまえば騒がれるってなぁ、ジョーシキだしな･･････。』" voices=""/>
		<msg @l="1156" char_id="-1" frame_id="-1" name="渡部"
		   text="『知ってっか？俺としちゃ････それはそれで････いいモンなんだぜ？』" voices=""/>
		<msg @l="1158" char_id="-1" frame_id="-1" name=""
		   text="ドクドクと脈打つ汚怪な怒張が、水着の裾から秘裂へと近づく。" voices=""/>
		<msg @l="1159" char_id="-1" frame_id="-1" name=""
		   text="足を抱えられた今となっては、逃げ出す事など叶わなかった。" voices=""/>
		<msg @l="1160" char_id="-1" frame_id="-1" name=""
		   text="傘を拡げた様な張り出しを見せる先端が、ぬらぬらと光る粘液を溢す。" voices=""/>
		<msg @l="1161" char_id="-1" frame_id="-1" name=""
		   text="私の外側を徐々に押し割ってくるその部分から、渡部の鼓動と呼吸が伝わる気がして、身体と意識が引き攣っって来る。" voices=""/>
		<msg @l="1162" char_id="-1" frame_id="-1" name=""
		   text="誰の侵入をも許していない私の小さな入り口が、眼一杯の時間をかけて、強引に左右へと押し開かれた。" voices=""/>
		<msg @l="1163" char_id="-1" frame_id="-1" name=""
		   text="穢らわしい灼熱が私を割るが、しかし、すぐには内部に入って来ない。" voices=""/>
		<msg @l="1164" char_id="-1" frame_id="-1" name=""
		   text="渡部の獰猛そうな眉が一瞬曇り、何故か私への侵入を中断したのだ。" voices=""/>
		<msg @l="1166" char_id="-1" frame_id="1" name="渡部"
		   text="（ん？････コイツの････この感触････。成程ね････ホントに処女だったみてぇだ････。くくっ････こりゃあいいぜ････。初モノ、ムリヤリブチ壊しってなぁ････俺も中々、ツイてるぜ････。）"
		   voices=""/>
		<msg @l="1168" char_id="-1" frame_id="1" name="渡部"
		   text="（俺専用に膜が残っちまった事になるなぁ、このオンナ････。&#32;ははっ････こいつは最高だ！！！）" voices=""/>
		<msg @l="1170" char_id="-1" frame_id="-1" name=""
		   text="表情を正視に堪えない笑みで満たした渡部の顔が目の前に迫る。" voices=""/>
		<msg @l="1171" char_id="-1" frame_id="-1" name=""
		   text="ケダモノみたいな翳を張り付かせた渡部の汚らしい分身が、この時、再び私の中への前進を始めた。" voices=""/>
		<msg @l="1172" char_id="-1" frame_id="-1" name=""
		   text="頭まで抜ける引き攣れた様な違和感と、接点からも湧き上がってくる灼熱とに、私は呻き声を搾り出す。" voices=""/>
		<msg @l="1174" char_id="-1" frame_id="-1" name="渡部"
		   text="『さぁてっと、お前もこの歳で処女みてぇだし････、ここいらでガキからオンナになるのもいいんじゃねぇか？』" voices=""/>
		<msg @l="1175" char_id="-1" frame_id="-1" name="渡部"
		   text="『俺がサイコーのシチュエーションを組んでやるぜ？････そうだなぁ････こんなのはどうだ？』" voices=""/>
		<msg @l="1176" char_id="-1" frame_id="-1" name=""
		   text="渡部は自分自身を半分だけ私に押し込みながら、下卑た内容を歌でも謡ってるみたいに喋り出した。" voices=""/>
		<msg @l="1178" char_id="-1" frame_id="-1" name="渡部"
		   text="『････お前は&#32;３年前のまんま、ずーっと俺を待ってたっての･･････。』" voices=""/>
		<msg @l="1180" char_id="0" frame_id="1" name="美帆" text="（･･ゃ････）" voices=""/>
		<msg @l="1182" char_id="-1" frame_id="-1" name="渡部"
		   text="『んでもって････くくっ････待ち焦がれてた想い人に････今日、全部を捧げちゃってくれるってシナリオだ。』" voices=""/>
		<msg @l="1184" char_id="0" frame_id="1" name="美帆" text="（いや････）" voices=""/>
		<msg @l="1187" char_id="-1" frame_id="-1" name="渡部"
		   text="『････気に入ったろ？････実は俺も堪んなく感動してっから……ご希望通りに散らしてやるよッ！！！』" voices=""/>
		<msg @l="1189" char_id="0" frame_id="1" name="美帆"
		   text="『いやっ！&#32;いやぁぁぁぁぁぁ！！』" voices="miho03580"/>
		<clear @l="1192" class="all"/>
		<end_scene @l="1195"/>
		<bgm @l="1198" src="bgm12" volume="1."/>
		<msg @l="1200" char_id="-1" frame_id="-1" name="声" text="『そこまでにしておけ‥‥。』"
		   voices=""/>
		<msg @l="1202" char_id="-1" frame_id="-1" name="渡部" text="『な‥‥だ、誰だっ。』"
		   voices=""/>
		<wait_chgmv/>
		<bg @l="1205" src="bg11"/>
		<char @l="1208" id="shiny" pos="auto" src="shinya210"/>
		<msg @l="1210" char_id="-1" frame_id="-1" name=""
		   text="真っ暗に変わりかけた私の意識に、鉄みたいに硬い声が飛び込んでくる。" voices=""/>
		<msg @l="1211" char_id="-1" frame_id="-1" name=""
		   text="背けた顔をそっと戻すと、渡部の汚らしい肩越しに、見知った顔が覗いていた。" voices=""/>
		<msg @l="1212" char_id="-1" frame_id="-1" name="" text="‥‥･･あ････あの人･･････。"
		   voices=""/>
		<msg @l="1213" char_id="-1" frame_id="-1" name=""
		   text="･･････奈那子ちゃんの･･････お兄さん･･････。" voices=""/>
		<msg @l="1215" char_id="-1" frame_id="-1" name="奈那子の兄"
		   text="『奈那子がどうしてもと言うから来てみたが‥‥。』" voices=""/>
		<clear @l="1218" class="char"/>
		<char @l="1220" id="shiny" pos="left" src="shinya210"/>
		<char @l="1222" id="watab" pos="right" src="watabe014"/>
		<msg @l="1224" char_id="-1" frame_id="-1" name="渡部"
		   text="『お、オマエっ‥‥なんでこんな時間にっ。』" voices=""/>
		<msg @l="1225" char_id="-1" frame_id="-1" name="" text="渡部までが弾かれた様に振り返る。"
		   voices=""/>
		<msg @l="1226" char_id="-1" frame_id="-1" name=""
		   text="厭らしい渡部のにやけ顔が、一瞬で硬く凍りついた。" voices=""/>
		<msg @l="1227" char_id="-1" frame_id="-1" name=""
		   text="渡部が見せた表情の変化は、私ですら予想しなかったものだ。" voices=""/>
		<char @l="1230" id="watab" pos="right" src="watabe017"/>
		<msg @l="1232" char_id="-1" frame_id="-1" name="渡部"
		   text="『いや‥‥それよりもどうやって中に入った。鍵はどうした！』" voices=""/>
		<msg @l="1233" char_id="-1" frame_id="-1" name=""
		   text="怒気を孕んだ渡部の顔色は、見る間に赤から蒼へと変わっていく。" voices=""/>
		<msg @l="1234" char_id="-1" frame_id="-1" name=""
		   text="こんな事態は渡部自身、想像さえしていなかった結果だろう。" voices=""/>
		<msg @l="1236" char_id="-1" frame_id="-1" name="奈那子の兄"
		   text="『お前が自分で調べてみろ･･････』" voices=""/>
		<msg @l="1237" char_id="-1" frame_id="-1" name=""
		   text="噛み付きそうな勢いの渡部の罵声を正面から受けて、それでも奈那子ちゃんのお兄さんは、眉の一筋も動かさない。" voices=""/>
		<msg @l="1238" char_id="-1" frame_id="-1" name=""
		   text="肌で風でも感じるみたいに、動かぬ瞳が静謐を以って、猛る渡部を映している。" voices=""/>
		<msg @l="1240" char_id="-1" frame_id="-1" name="渡部" text="『このっ！！』" voices=""/>
		<msg @l="1242" char_id="-1" frame_id="-1" name=""
		   text="渡部は激昂に身を任せたのか、口の端から泡を飛ばして、奈那子ちゃんのお兄さんに殴りかかった。" voices=""/>
		<clear @l="1245" layer="watab"/>
		<msg @l="1248" char_id="-1" frame_id="-1" name="奈那子の兄" text="『‥‥‥‥。』"
		   voices=""/>
		<msg @l="1249" char_id="-1" frame_id="-1" name=""
		   text="床を踏み鳴らして飛び掛る渡部を避けようともせず‥‥･･、" voices=""/>
		<msg @l="1250" char_id="-1" frame_id="-1" name=""
		   text="奈那子ちゃんのお兄さんは、ほんの少しだけその右腕を動かした。" voices=""/>
		<msg @l="1251" char_id="-1" frame_id="-1" name="" text="そして――――。" voices=""/>
		<flash @l="1255" count="4" fade="100" image="white"/>
		<msg @l="1257" char_id="-1" frame_id="-1" name="渡部" text="『うぐああぁっ！？』"
		   voices=""/>
		<se @l="1260" buf="1" src="ベッドに倒れこむ音" volume="1."/>
		<msg @l="1262" char_id="-1" frame_id="-1" name=""
		   text="渡部の拳が、奈那子ちゃんのお兄さんを捕らえた瞬間･･････、" voices=""/>
		<msg @l="1263" char_id="-1" frame_id="-1" name=""
		   text="ビデオの逆回転のように、不自然な円弧を描いて、渡部の巨躯が宙に舞った。" voices=""/>
		<msg @l="1264" char_id="-1" frame_id="-1" name=""
		   text="昔、テレビで見た達人が使う合気道の技にも見えたが、目の前で起こったその事態は、とても同じものだとは思えない。" voices=""/>
		<char @l="1267" id="watab" pos="right" src="watabe014"/>
		<msg @l="1269" char_id="-1" frame_id="-1" name="渡部"
		   text="『な‥‥なんだ、今のは‥‥何を‥‥‥したんだっ！？』" voices=""/>
		<msg @l="1271" char_id="-1" frame_id="-1" name=""
		   text="派手な音を引き摺りながら転がった渡部が、頭を抑えながら立ち上がる。" voices=""/>
		<msg @l="1272" char_id="-1" frame_id="-1" name=""
		   text="外傷などは見えないが、背中から床へと落ちたそのダメージは、相当なモノだったに違いない。" voices=""/>
		<msg @l="1273" char_id="-1" frame_id="-1" name=""
		   text="踏ん張りながら身を起こしたその足元は、膝から下が笑っていた。" voices=""/>
		<msg @l="1275" char_id="-1" frame_id="-1" name="奈那子の兄" text="『‥‥‥。』"
		   voices=""/>
		<char @l="1278" id="watab" pos="right" src="watabe017"/>
		<msg @l="1280" char_id="-1" frame_id="-1" name="渡部" text="『くっ‥‥くそっ。』"
		   voices=""/>
		<msg @l="1282" char_id="-1" frame_id="-1" name="渡部"
		   text="『仲根‥‥俺から逃げたら‥‥‥‥解ってるなっ！？』" voices=""/>
		<msg @l="1284" char_id="0" frame_id="1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="1286" char_id="-1" frame_id="-1" name="渡部" text="『ちッ‥‥。』" voices=""/>
		<clear @l="1289" layer="watab"/>
		<msg @l="1291" char_id="-1" frame_id="-1" name=""
		   text="一瞬だけ怯えた様な表情を見せると、渡部は脱兎の如く更衣室の扉を駆け抜ける。" voices=""/>
		<msg @l="1292" char_id="-1" frame_id="-1" name=""
		   text="去り際の捨てゼリフにも似た渡部の声は、奈那子ちゃんのお兄さんの背中に当たって虚しく散った。" voices=""/>
		<bgm @l="1295" src="bgm03" volume="1."/>
		<char @l="1298" id="miho" pos="right" src="miho165"/>
		<msg @l="1300" char_id="0" frame_id="1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="1302" char_id="-1" frame_id="-1" name="奈那子の兄" text="『‥‥‥‥。』"
		   voices=""/>
		<msg @l="1304" char_id="0" frame_id="1" name="美帆"
		   text="『あの‥‥‥あ、ありがとうございます。』" voices=""/>
		<msg @l="1306" char_id="-1" frame_id="-1" name="奈那子の兄"
		   text="『･･････奈那子はお前に惹かれている･･････。』" voices=""/>
		<char @l="1309" id="miho" pos="right" src="miho064"/>
		<msg @l="1311" char_id="0" frame_id="1" name="美帆" text="『え‥‥？』" voices=""/>
		<clear @l="1314" class="char"/>
		<char @l="1316" id="miho" pos="auto" src="miho064"/>
		<msg @l="1319" char_id="-1" frame_id="-1" name="奈那子の兄"
		   text="『････俺も･･その理由までは解らんが･･････』" voices=""/>
		<msg @l="1320" char_id="-1" frame_id="-1" name=""
		   text="立った一言、そう言い残し、奈那子ちゃんのお兄さんも更衣室を抜けて行った。" voices=""/>
		<msg @l="1321" char_id="-1" frame_id="-1" name=""
		   text="現れた時と同じ様に、戻る背中も風みたいに瓢然と消える。" voices=""/>
		<msg @l="1322" char_id="-1" frame_id="-1" name=""
		   text="聞えない程の呟きは、誰に向けられていたものなのだろうか･･････。" voices=""/>
		<msg @l="1324" char_id="0" frame_id="1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<char @l="1327" id="miho" pos="auto" src="miho065"/>
		<msg @l="1329" char_id="0" frame_id="1" name="美帆"
		   text="『なんなのよ、もう‥‥わけ‥‥‥‥わかんないよ。』" voices=""/>
		<msg @l="1331" char_id="-1" frame_id="-1" name=""
		   text="総てに置き去られたまま、一人取り残されてしまった私は、その場にぺたりと座り込む。" voices=""/>
		<msg @l="1332" char_id="-1" frame_id="-1" name=""
		   text="暴力と絶望からは救われたと思う･･････。" voices=""/>
		<msg @l="1333" char_id="-1" frame_id="-1" name="" text="けれど･･････、"
		   voices=""/>
		<msg @l="1334" char_id="-1" frame_id="-1" name=""
		   text="何故か泣きたくなる程、気分は昏く沈んでいた･･････。" voices=""/>
		<stopbgm @l="1337" fadeout="1000"/>
		<clear @l="1340" class="all"/>
		<call @l="1343" target="EventLabel_61@root_akina03"/>
		<return @l="1344" value="0&#13;&#10;"/>
		<return @l="1347" value=""/>
	</code>
</xscript>
