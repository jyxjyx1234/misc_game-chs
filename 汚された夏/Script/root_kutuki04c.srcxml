<?xml version="1.0" encoding="utf-8"?>
<xscript>
	<debug editor="&quot;C:\Program&#32;Files&#32;(x86)\sakura\sakura.exe&quot;&#32;&quot;%src%&quot;&#32;-Y=%line%"
	   src="D:\シロップ\町ぐるみの罠＋汚された夏セット版\汚された夏\完成データ\汚された夏\script\text\root_kutuki04c.txt"/>
	<code>
		<label @l="10" id="EventLabel_125"/>
		<description @l="13" text="契約の日々・３日目"/>
		<eval @l="15" expr="f.numDay=9&#13;&#10;"/>
		<msgshow @l="17" show="false"/>
		<wait_chgmv/>
		<bg @l="19" src="day09" time="2000"/>
		<wait @l="21" time="500"/>
		<wait_chgmv/>
		<bg @l="23" src="black" time="2000"/>
		<msgshow @l="25" show="true"/>
		<wait_chgmv/>
		<bg @l="28" src="bg18m1"/>
		<bgm @l="31" src="bgm03" volume="1."/>
		<char @l="34" id="miho" pos="auto" src="miho115"/>
		<msg @l="36" char_id="0" frame_id="-1" name="美帆" text="『‥‥はぁ。』" voices=""/>
		<msg @l="38" char_id="-1" frame_id="-1" name="" text="思わず‥‥ため息が漏れる。"
		   voices=""/>
		<msg @l="39" char_id="-1" frame_id="-1" name="" text="朝、私は停留所に向かって駅前を歩いていた。"
		   voices=""/>
		<msg @l="40" char_id="-1" frame_id="-1" name="" text="今日は下着をつけてきている。"
		   voices=""/>
		<msg @l="41" char_id="-1" frame_id="-1" name=""
		   text="昨日は命令されなかったのだから、約束を破った事にはならないだろう。" voices=""/>
		<msg @l="43" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="45" char_id="-1" frame_id="-1" name="" text="足が重かった。" voices=""/>
		<msg @l="46" char_id="-1" frame_id="-1" name=""
		   text="電車に乗れば、また、間違いなく朽木教授が待ち伏せている。" voices=""/>
		<msg @l="47" char_id="-1" frame_id="-1" name=""
		   text="そして‥‥‥身体を貪られるような事が待っている。" voices=""/>
		<msg @l="49" char_id="0" frame_id="-1" name="美帆" text="(私は期待なんかしてない‥‥)"
		   voices=""/>
		<msg @l="51" char_id="0" frame_id="-1" name="美帆"
		   text="(絶対に‥‥期待なんかしてないんだから‥‥‥)" voices=""/>
		<msg @l="53" char_id="-1" frame_id="-1" name=""
		   text="自分に言い聞かせるようにして、迷いを振り払うように足早に停留所へ向かった。" voices=""/>
		<clear @l="56" class="all"/>
		<msgshow @l="58" show="true"/>
		<se @l="61" buf="3" loop="true" src="電車走行中" volume="1."/>
		<wait_chgmv/>
		<ev @l="64" src="ev-005"/>
		<msg @l="66" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』"
		   voices="miho08800"/>
		<msg @l="68" char_id="-1" frame_id="-1" name="" text="いつもの壁際に立つ。" voices=""/>
		<msg @l="69" char_id="-1" frame_id="-1" name=""
		   text="そうして手すりにつかまり、窓の外を流れる景色をぼんやり眺める。" voices=""/>
		<msg @l="70" char_id="-1" frame_id="-1" name=""
		   text="けれど‥‥私の意識は常に自分の背中へと向けられていた。" voices=""/>
		<msg @l="72" char_id="0" frame_id="-1" name="美帆"
		   text="(多分‥‥ううん、絶対に朽木教授はこの電車に乗ってる)" voices="miho08810"/>
		<msg @l="74" char_id="0" frame_id="-1" name="美帆"
		   text="(今もきっと、私のことを狙って‥‥‥‥見てるんだ)" voices="miho08820"/>
		<msg @l="76" char_id="-1" frame_id="-1" name=""
		   text="そう思った瞬間‥‥‥ふと、何かがぞくりと背筋を走った。" voices=""/>
		<msg @l="77" char_id="-1" frame_id="-1" name="" text="別に何かが触れたわけじゃない。"
		   voices=""/>
		<msg @l="78" char_id="-1" frame_id="-1" name="" text="これは恐らく‥‥‥視線だ。"
		   voices=""/>
		<msg @l="80" char_id="0" frame_id="-1" name="美帆"
		   text="(なんで、こんな‥‥‥‥私、本当に見られてる‥‥‥‥？)" voices="miho08830"/>
		<msg @l="82" char_id="0" frame_id="-1" name="美帆"
		   text="(それにこの感じ‥‥‥一人じゃない‥‥‥‥‥)" voices="miho08840"/>
		<msg @l="84" char_id="-1" frame_id="-1" name=""
		   text="背中に絡みつく視線が妙にはっきりと感じ取れた。" voices=""/>
		<msg @l="85" char_id="-1" frame_id="-1" name=""
		   text="それだけ、なめまわすに見られているということなのだろうか。" voices=""/>
		<msg @l="86" char_id="-1" frame_id="-1" name=""
		   text="私の頭には先週の出来事が‥‥複数の手が自分の身体を無遠慮に弄っていた、あの時の光景がはっきりと思い出されていた。" voices=""/>
		<msg @l="88" char_id="0" frame_id="-1" name="美帆" text="(あの時‥‥‥顔、覚えられて‥‥‥‥？)"
		   voices="miho08850"/>
		<msg @l="90" char_id="0" frame_id="-1" name="美帆" text="(それで、狙われてる‥‥‥？)"
		   voices="miho08860"/>
		<msg @l="92" char_id="-1" frame_id="-1" name="" text="恐怖が一気に膨らんでいく。"
		   voices=""/>
		<msg @l="93" char_id="-1" frame_id="-1" name=""
		   text="あの時、私の身体に伸びていた手は一つや二つなどではなかった。" voices=""/>
		<msg @l="94" char_id="-1" frame_id="-1" name=""
		   text="もし皆が示し合わせたようにこの電車に乗っているとしたら‥‥。" voices=""/>
		<msg @l="95" char_id="-1" frame_id="-1" name=""
		   text="そして、私のことを狙っているのだとしたら‥‥。" voices=""/>
		<msg @l="97" char_id="0" frame_id="-1" name="美帆"
		   text="(ど、どうしよう‥‥‥‥‥どうしたらいいの？)" voices="miho08870"/>
		<msg @l="99" char_id="0" frame_id="-1" name="美帆"
		   text="(あの時はタイミングよく大学に着いたから良かったけど‥‥‥)" voices="miho08880"/>
		<msg @l="101" char_id="-1" frame_id="-1" name=""
		   text="まだ、この電車は走り出して五分と経っていない。" voices=""/>
		<msg @l="102" char_id="-1" frame_id="-1" name=""
		   text="あと二十分以上もこの状態が続くのかと思うと寒気がする。" voices=""/>
		<msg @l="103" char_id="-1" frame_id="-1" name=""
		   text="いや‥‥むしろ、背中に視線を感じているだけであればまだいい。" voices=""/>
		<msg @l="104" char_id="-1" frame_id="-1" name="" text="この前のように手を伸ばされたら‥‥‥。"
		   voices=""/>
		<msg @l="106" char_id="-1" frame_id="-1" name="声"
		   text="『その怯えた表情がまたなんともそそられるな、キミは。』" voices=""/>
		<wait_chgmv/>
		<ev @l="109" src="ev-005ax1"/>
		<msg @l="111" char_id="0" frame_id="-1" name="美帆" text="『ひ‥‥！！』"
		   voices="miho08890"/>
		<msg @l="113" char_id="-1" frame_id="-1" name=""
		   text="いきなり耳元へ囁きかけられた声に、私は思わず悲鳴をあげてしまいそうになるほど驚いた。" voices=""/>
		<msg @l="114" char_id="-1" frame_id="-1" name="" text="確認するまでも無い、朽木教授だ。"
		   voices=""/>
		<msg @l="116" char_id="-1" frame_id="-1" name="朽木"
		   text="『どうだね、視線で犯されるという気分は？』" voices=""/>
		<msg @l="118" char_id="-1" frame_id="-1" name="朽木"
		   text="『先日の一件で皆キミのことを気に入ってしまってね。どうしてもというから登校時間を教えてあげたのだよ。』" voices=""/>
		<msg @l="120" char_id="0" frame_id="-1" name="美帆" text="『そ、そんな‥‥ヒドイ‥‥‥‥。』"
		   voices="miho08900"/>
		<msg @l="122" char_id="-1" frame_id="-1" name="朽木"
		   text="『安心したまえ、彼らは皆私の許可無く手を出したりしない。』" voices=""/>
		<msg @l="124" char_id="-1" frame_id="-1" name="朽木"
		   text="『キミは私の「慰み者」なのだからな。』" voices=""/>
		<msg @l="126" char_id="0" frame_id="-1" name="美帆" text="『慰み者‥‥だなんて。』"
		   voices="miho08910"/>
		<msg @l="128" char_id="-1" frame_id="-1" name="朽木"
		   text="『私の愛人になることを拒んだキミは、ただ性欲を満たすだけの「慰み者」という言葉が一番お似合いだと思うがね。』" voices=""/>
		<msg @l="130" char_id="0" frame_id="-1" name="美帆"
		   text="『弱味につけこんで‥‥‥‥いたぶって‥‥酷い‥‥。』" voices="miho08920"/>
		<msg @l="132" char_id="-1" frame_id="-1" name="朽木"
		   text="『それは褒め言葉として受け取っておこう。』" voices=""/>
		<msg @l="134" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』"
		   voices="miho08930"/>
		<msg @l="136" char_id="-1" frame_id="-1" name="朽木"
		   text="『さて、それでは今日も慰み者に性欲処理をしてもらおうか。』" voices=""/>
		<wait_chgmv/>
		<ev @l="139" src="ev-005ax2y1"/>
		<bgm @l="142" src="bgm14" volume="1."/>
		<msg @l="144" char_id="0" frame_id="-1" name="美帆" text="『んっ‥‥。』"
		   voices="miho08940"/>
		<msg @l="146" char_id="-1" frame_id="-1" name=""
		   text="服の上から、教授の手が私の胸を揉み、乳房を上へ持ち上げるように撫で回す。" voices=""/>
		<msg @l="147" char_id="-1" frame_id="-1" name="朽木"
		   text="『おや、今日は下着を着けてきているようだな。』" voices=""/>
		<msg @l="149" char_id="0" frame_id="-1" name="美帆"
		   text="『昨日は‥‥何も言われませんでしたから。』" voices="miho08950"/>
		<msg @l="151" char_id="-1" frame_id="-1" name="朽木" text="『なるほど、確かにその通りだ。』"
		   voices=""/>
		<msg @l="153" char_id="-1" frame_id="-1" name=""
		   text="教授はわざとらしく感心してみせると、胸を揉んでいる手に力を込め、５本の指でグニュグニュとこねる。" voices=""/>
		<msg @l="155" char_id="0" frame_id="-1" name="美帆" text="『あぐっ‥‥。』"
		   voices="miho08960"/>
		<msg @l="157" char_id="-1" frame_id="-1" name=""
		   text="胸をつぶされるような痛みが走り‥‥私は眉をひそめる。" voices=""/>
		<msg @l="159" char_id="-1" frame_id="-1" name="朽木"
		   text="『余りこしゃくな事は言わない方が良い。人生まで捨てたくなければな。』" voices=""/>
		<msg @l="161" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』"
		   voices="miho08970"/>
		<msg @l="163" char_id="-1" frame_id="-1" name="朽木"
		   text="『くくっ、そうだ‥‥そうして黙って震えているのがキミにはお似合いなのだよ。』" voices=""/>
		<msg @l="165" char_id="0" frame_id="-1" name="美帆" text="『くっ‥‥。』"
		   voices="miho08980"/>
		<msg @l="167" char_id="-1" frame_id="-1" name="朽木"
		   text="『悔しいかね？&#32;しかし本当の屈辱はこれからだぞ？』" voices=""/>
		<msg @l="169" char_id="-1" frame_id="-1" name=""
		   text="そう言って教授は私の肩に手を置くと、ぐいっと力を込める。" voices=""/>
		<msg @l="171" char_id="0" frame_id="-1" name="美帆" text="『え、何を‥‥？』"
		   voices="miho08990"/>
		<msg @l="173" char_id="-1" frame_id="-1" name="朽木"
		   text="『キミは黙って従っていれば良い。そうだろう？』" voices=""/>
		<msg @l="175" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』"
		   voices="miho09000"/>
		<clear @l="178" class="all"/>
		<label @l="181" id="event_scene10"/>
		<goto @l="183" cond="!(f.flagInExtraMode&#32;&gt;&#32;100)&#13;&#10;"
		   label="TempLabel_198"/>
		<bgm @l="185" src="bgm14" volume="1."/>
		<label @l="186" id="TempLabel_198"/>
		<label @l="189" id="chart_line45"/>
		<wait_chgmv/>
		<ev @l="192" src="ev-010a"/>
		<description @l="195" text="車内奉仕"/>
		<msg @l="197" char_id="-1" frame_id="-1" name="" text="私は‥‥強引に電車の床に座らされる。"
		   voices=""/>
		<msg @l="198" char_id="-1" frame_id="-1" name=""
		   text="冷やりとした床の感触がお尻に伝わって少し気持ちが悪かった。" voices=""/>
		<msg @l="200" char_id="-1" frame_id="-1" name="朽木"
		   text="『キミにはもう少し自分の立場というモノを教え込まねばならないな。』" voices=""/>
		<msg @l="202" char_id="0" frame_id="-1" name="美帆" text="『な、なにを‥‥。』"
		   voices="miho09010"/>
		<msg @l="204" char_id="-1" frame_id="-1" name=""
		   text="教授は口元をわずかにつり上げると、ズボンのチャックに指をかけてゆっくりと下ろしていく。" voices=""/>
		<wait_chgmv/>
		<ev @l="207" src="ev-010a"/>
		<msg @l="209" char_id="-1" frame_id="-1" name="朽木" text="『しゃぶりたまえ。』"
		   voices=""/>
		<msg @l="211" char_id="0" frame_id="-1" name="美帆" text="『え‥‥。』"
		   voices="miho09020"/>
		<msg @l="213" char_id="-1" frame_id="-1" name="朽木"
		   text="『私のモノをしゃぶりたまえ。キミの口で奉仕するのだ。』" voices=""/>
		<msg @l="215" char_id="0" frame_id="-1" name="美帆" text="『そんなことっ‥‥。』"
		   voices="miho09030"/>
		<msg @l="217" char_id="-1" frame_id="-1" name="朽木"
		   text="『出来なければキミの父親が破滅するだけだがね。』" voices=""/>
		<msg @l="219" char_id="0" frame_id="-1" name="美帆" text="『‥‥っ‥‥‥。』"
		   voices="miho09040"/>
		<msg @l="221" char_id="-1" frame_id="-1" name="朽木"
		   text="『言っただろう、立場というモノを教えてやると。』" voices=""/>
		<msg @l="223" char_id="0" frame_id="-1" name="美帆"
		   text="『でも‥‥‥周りに人がいるし‥‥‥‥‥。』" voices="miho09050"/>
		<msg @l="225" char_id="-1" frame_id="-1" name="朽木"
		   text="『私たちの周囲にいる人間は私の知り合いでね、その者たちが壁をしている限り他人に見られる心配は無いよ。』" voices=""/>
		<msg @l="227" char_id="0" frame_id="-1" name="美帆" text="『そんな‥‥‥。』"
		   voices="miho09060"/>
		<msg @l="229" char_id="-1" frame_id="-1" name="朽木"
		   text="『キミには拒否する権利などないのだ‥‥うだうだ言わず早く咥えたまえ。』" voices=""/>
		<msg @l="231" char_id="-1" frame_id="-1" name=""
		   text="そう言うと朽木教授は自分のモノを私の顔に近づける。" voices=""/>
		<msg @l="233" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』"
		   voices="miho09070"/>
		<msg @l="235" char_id="-1" frame_id="-1" name="" text="私は‥‥目を背ける。" voices=""/>
		<msg @l="236" char_id="-1" frame_id="-1" name=""
		   text="私は、そのあまりにも醜い欲の物体に嫌悪感が走った。" voices=""/>
		<msg @l="237" char_id="-1" frame_id="-1" name=""
		   text="ましてやこの股間に潜む悪魔に、自分の処女を奪われたのである。" voices=""/>
		<msg @l="239" char_id="-1" frame_id="-1" name="朽木"
		   text="『どうしたのだ？早く咥えないと父親がどうなっても知らんぞ････。』" voices=""/>
		<msg @l="241" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥っ‥‥。』"
		   voices="miho01620"/>
		<msg @l="243" char_id="-1" frame_id="-1" name="" text="考えるまでも無いことはわかっていた。"
		   voices=""/>
		<msg @l="244" char_id="-1" frame_id="-1" name=""
		   text="自分が彼に逆らえるような立場にないという事を。" voices=""/>
		<msg @l="246" char_id="0" frame_id="-1" name="美帆" text="『わかり‥‥ました‥‥‥‥。』"
		   voices="miho09080"/>
		<msg @l="248" char_id="-1" frame_id="-1" name=""
		   text="そして私は‥‥喉奥から搾り出すように、そう答えていた。" voices=""/>
		<clear @l="251" class="all"/>
		<msg @l="253" char_id="0" frame_id="-1" name="美帆" text="『ん‥‥。』"
		   voices="miho09090"/>
		<msg @l="255" char_id="-1" frame_id="-1" name="" text="思い切って舌先を伸ばしてチロっと舐める。"
		   voices=""/>
		<msg @l="256" char_id="-1" frame_id="-1" name=""
		   text="舌先が触れた瞬間‥‥感触が奇妙で、思わず舌を引っ込めてしまう。" voices=""/>
		<msg @l="257" char_id="-1" frame_id="-1" name=""
		   text="私は、そのあまりにも醜い欲の物体に嫌悪感が走った。" voices=""/>
		<msg @l="259" char_id="-1" frame_id="-1" name="朽木" text="『どうした？早く咥えたまえ。』"
		   voices=""/>
		<msg @l="261" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』"
		   voices="miho09100"/>
		<wait_chgmv/>
		<ev @l="264" src="ev-010bx1y1"/>
		<msg @l="266" char_id="0" frame_id="-1" name="美帆" text="『ん、ぐぅ‥‥‥。』"
		   voices="miho09110"/>
		<msg @l="268" char_id="-1" frame_id="-1" name="" text="意を決して、先端部分を口に含む。"
		   voices=""/>
		<msg @l="269" char_id="-1" frame_id="-1" name=""
		   text="幹の部分は柔らかな表面をしていて、先端は毒キノコのようにテラテラと光っている奇妙なモノが、私の口内の中へ滑り込んでくる。"
		   voices=""/>
		<msg @l="271" char_id="0" frame_id="-1" name="美帆" text="(うあ‥‥‥変な味‥‥‥‥‥)"
		   voices="miho09120"/>
		<msg @l="273" char_id="-1" frame_id="-1" name=""
		   text="先ず‥‥口内全体に広がる苦味のある独特な味に私は吐き気をもよおす。" voices=""/>
		<msg @l="274" char_id="-1" frame_id="-1" name="" text="それからツンと鼻腔を刺激する体臭‥‥。"
		   voices=""/>
		<msg @l="275" char_id="-1" frame_id="-1" name=""
		   text="私はその二つに表情を歪ませ、眉間にしわを寄せる。" voices=""/>
		<msg @l="277" char_id="-1" frame_id="-1" name="朽木" text="『私のモノは美味いだろう？』"
		   voices=""/>
		<msg @l="279" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』"
		   voices="miho09130"/>
		<msg @l="281" char_id="-1" frame_id="-1" name="朽木" text="『美味いだろう？』"
		   voices=""/>
		<msg @l="283" char_id="0" frame_id="-1" name="美帆" text="『お、おいしい‥‥‥です。』"
		   voices="miho09140//咥えながら"/>
		<msg @l="285" char_id="-1" frame_id="-1" name="朽木"
		   text="『それは結構。たっぷりと味わいたまえ。』" voices=""/>
		<msg @l="287" char_id="0" frame_id="-1" name="美帆" text="『んっ‥‥。』"
		   voices="miho09150"/>
		<msg @l="289" char_id="-1" frame_id="-1" name=""
		   text="私は彼の言葉に従うように、ゆっくりと口内の塊に舌を這わせる。" voices=""/>
		<msg @l="290" char_id="-1" frame_id="-1" name=""
		   text="しかし、口内の大半が教授のモノで占拠されてしまっていて思うように舌を動かすことが出来ない。" voices=""/>
		<msg @l="291" char_id="-1" frame_id="-1" name=""
		   text="こんな事をするのは初めてなのだから‥‥仕方がない‥‥‥‥。" voices=""/>
		<msg @l="293" char_id="-1" frame_id="-1" name="朽木" text="『なっておらんな。』"
		   voices=""/>
		<wait_chgmv/>
		<ev @l="296" src="ev-010a"/>
		<msg @l="298" char_id="0" frame_id="-1" name="美帆"
		   text="『んはっ‥‥そんなこと言われても‥‥‥‥。』" voices="miho09160"/>
		<msg @l="300" char_id="0" frame_id="-1" name="美帆"
		   text="『こんなことするの、初めてなんです‥‥‥‥。』" voices="miho09170"/>
		<msg @l="302" char_id="-1" frame_id="-1" name=""
		   text="経験のない私にとって、小尿をする器官を口に咥えるなんて行為は嫌悪感以外のなにものでもない。" voices=""/>
		<msg @l="304" char_id="-1" frame_id="-1" name="朽木"
		   text="『なるほど、そういえばキミはつい先日まで処女だったな。ククク‥‥。』" voices=""/>
		<msg @l="306" char_id="-1" frame_id="-1" name="" text="教授はそう言ってわざとらしく笑う。"
		   voices=""/>
		<msg @l="308" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』"
		   voices="miho09180"/>
		<msg @l="310" char_id="-1" frame_id="-1" name="朽木"
		   text="『私の言うように動きたまえ。男の悦ばせ方を教えてあげよう。』" voices=""/>
		<msg @l="312" char_id="0" frame_id="-1" name="美帆" text="『‥‥はい。』"
		   voices="miho09190"/>
		<msg @l="314" char_id="-1" frame_id="-1" name=""
		   text="私は彼の言葉に小さく答えた‥‥‥悲しさで目尻に涙がたまる。" voices=""/>
		<msg @l="315" char_id="-1" frame_id="-1" name="" text="大声で泣きたかった。" voices=""/>
		<msg @l="316" char_id="-1" frame_id="-1" name="" text="けれど、彼は泣いても許してなどくれない。"
		   voices=""/>
		<msg @l="317" char_id="-1" frame_id="-1" name=""
		   text="ただ朽木教授の言いなりになるしかないのだ。" voices=""/>
		<msg @l="319" char_id="-1" frame_id="-1" name="朽木"
		   text="『まず、先端部分を唇で咥え、舌先で唾液をまぶしたまえ。』" voices=""/>
		<msg @l="321" char_id="0" frame_id="-1" name="美帆" text="『こう、ですか‥‥？』"
		   voices="miho09200"/>
		<wait_chgmv/>
		<ev @l="324" src="ev-010bx1y1"/>
		<msg @l="326" char_id="0" frame_id="-1" name="美帆"
		   text="『んっ‥‥‥‥んむ‥‥‥‥れろ、れろ‥‥‥‥。』" voices="miho09210"/>
		<msg @l="328" char_id="-1" frame_id="-1" name=""
		   text="唇で肉茎を滑らせるように咥え、舌先を亀頭に這わせる。" voices=""/>
		<msg @l="329" char_id="-1" frame_id="-1" name=""
		   text="慣れない味と匂いにやはり嫌悪感が膨らんだが‥‥吐き出すわけにはいかず、懸命にしゃぶる。" voices=""/>
		<msg @l="331" char_id="-1" frame_id="-1" name="朽木"
		   text="『そうだ‥‥充分に唾液をまぶしたら唇を締め付けながら頭を前後に揺すり、肉棒全体に唾液を引き伸ばしていけ。』" voices=""/>
		<msg @l="333" char_id="0" frame_id="-1" name="美帆"
		   text="『ふ、ふぁい‥‥‥ん、んぐっ‥‥‥‥‥‥んっ‥‥んっ‥‥‥。』" voices="miho09220"/>
		<msg @l="335" char_id="-1" frame_id="-1" name=""
		   text="ぎこちなく‥‥私は唇を締め付けて頭を前後に振る。" voices=""/>
		<msg @l="337" char_id="0" frame_id="-1" name="美帆"
		   text="『んっ‥‥‥んむっ‥‥‥‥‥んぐっ、ん、んんっ‥‥‥‥‥。』" voices="miho09230"/>
		<wait_chgmv/>
		<ev @l="339" src="ev-010a"/>
		<msg @l="341" char_id="0" frame_id="-1" name="美帆"
		   text="『ゲホッ‥‥‥ゴホゴホッ‥‥‥‥‥う、あっ‥‥‥‥かはっ。』" voices="miho09240"/>
		<msg @l="342" char_id="-1" frame_id="-1" name=""
		   text="時折、加減を誤って喉の奥深くに亀頭が入り込んで‥‥むせてしまう。" voices=""/>
		<msg @l="343" char_id="-1" frame_id="-1" name=""
		   text="それでも教授は冷たい視線で私を見、すぐに男根を咥えなおさせる。" voices=""/>
		<wait_chgmv/>
		<ev @l="346" src="ev-010bx1y1"/>
		<msg @l="348" char_id="0" frame_id="-1" name="美帆" text="『んぐっ‥‥。』"
		   voices="miho09250"/>
		<msg @l="350" char_id="-1" frame_id="-1" name="朽木"
		   text="『深く頭を振るのができないなら、口内に唾液を溜めて浅く揺すりながら舌先で亀頭を舐れば喉奥を突くことはない。』" voices=""/>
		<msg @l="352" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』"
		   voices="miho09260"/>
		<msg @l="354" char_id="0" frame_id="-1" name="美帆" text="『んっ‥‥‥ん、んぷっ‥‥‥‥‥。』"
		   voices="miho09270"/>
		<msg @l="356" char_id="-1" frame_id="-1" name=""
		   text="言われるまま、私は口内に唾液を溜め込んで浅く頭を動かしてみる。" voices=""/>
		<msg @l="358" char_id="0" frame_id="-1" name="美帆"
		   text="『ん、んんっ‥‥‥‥ちゅぷ、んっ、んぐっ‥‥‥‥‥。』" voices="miho09280"/>
		<msg @l="360" char_id="-1" frame_id="-1" name=""
		   text="浅い律動を繰り返すたび、私の口元からはクチュクチュと水音が漏れる。" voices=""/>
		<msg @l="361" char_id="-1" frame_id="-1" name=""
		   text="その音が妙に淫靡で‥‥私は恥ずかしさに身を震わせた。" voices=""/>
		<msg @l="363" char_id="-1" frame_id="-1" name="朽木" text="『大分、さまになってきたようだな。』"
		   voices=""/>
		<msg @l="365" char_id="-1" frame_id="-1" name=""
		   text="教授が満足げに囁き、私の頭を押さえて自分の好きなように腰を振り始める。" voices=""/>
		<msg @l="367" char_id="0" frame_id="-1" name="美帆"
		   text="『んぐっ‥‥‥んっ、ちゅぷっ‥‥‥‥んっ‥‥んんっ‥‥‥‥。』" voices="miho09290"/>
		<msg @l="369" char_id="0" frame_id="-1" name="美帆" text="(なんで私‥‥‥‥)"
		   voices="miho09300"/>
		<msg @l="371" char_id="0" frame_id="-1" name="美帆"
		   text="(満員電車の中で‥‥‥人が周りにいっぱいいるのに、こんな)" voices="miho09310"/>
		<msg @l="373" char_id="-1" frame_id="-1" name="朽木"
		   text="『どうした、舌の動きが止まってしまっているぞ？』" voices=""/>
		<msg @l="375" char_id="0" frame_id="-1" name="美帆"
		   text="『んんっ‥‥‥ちゅぷ、ん、んぐっ‥‥‥ちゅぷぷっ。』" voices="miho09320"/>
		<msg @l="377" char_id="-1" frame_id="-1" name=""
		   text="頭を押さえつけられたまま‥‥私は懸命に舌を動かす。" voices=""/>
		<msg @l="378" char_id="-1" frame_id="-1" name=""
		   text="どこが感じるとか、どうすればいいとか‥‥そんな事は分からない。" voices=""/>
		<msg @l="379" char_id="-1" frame_id="-1" name=""
		   text="ただ眼前の苦痛から解放されたい一心で、私は唇でしごき、舌でビチャビチャと音を立てながら舐めまわす。" voices=""/>
		<msg @l="381" char_id="0" frame_id="-1" name="美帆"
		   text="『ちゅぷ‥‥‥んっ、んぷっ‥‥んぷっ‥‥‥‥んっ‥‥んふっ。』" voices="miho09330"/>
		<msg @l="383" char_id="0" frame_id="-1" name="美帆"
		   text="『んっ、んっ、んっ‥‥‥んぷっ‥‥ちゅ、んっ、ちゅぷぷ‥‥‥。』" voices="miho09340"/>
		<msg @l="385" char_id="-1" frame_id="-1" name="朽木"
		   text="『いいぞ、その調子で続けたまえ‥‥‥キミは飲み込みが早いな。』" voices=""/>
		<msg @l="387" char_id="-1" frame_id="-1" name=""
		   text="こんな事で褒められたところで少しも嬉しくはなかった。" voices=""/>
		<msg @l="389" char_id="0" frame_id="-1" name="美帆" text="『んんっ‥‥ン、ちゅぷっ。』"
		   voices="miho09350"/>
		<msg @l="391" char_id="-1" frame_id="-1" name="朽木"
		   text="『くっ‥‥そのまま、先端を吸いながら舌を動かしたまえ。』" voices=""/>
		<msg @l="393" char_id="0" frame_id="-1" name="美帆"
		   text="『んっ‥‥じゅぷっ、んんっ‥‥‥‥ちゅぷ、ちゅるるっ‥‥‥‥。』" voices="miho09360"/>
		<msg @l="395" char_id="0" frame_id="-1" name="美帆"
		   text="(うあ‥‥‥なんか、苦いのが出てきてる‥‥‥‥‥‥)" voices="miho09370"/>
		<msg @l="397" char_id="-1" frame_id="-1" name=""
		   text="私は口内に広がる奇妙な苦味に表情を歪ませながらも、懸命にチューチューと鈴口を吸い上げながら舌で肉茎を舐め上げる。" voices=""/>
		<msg @l="398" char_id="-1" frame_id="-1" name=""
		   text="その苦味のある液体が滲み出すようになってから、口内の熱棒は舌先で舐るたびにヒクヒクと脈打つようになり‥‥更に硬くなり体臭が増していった。"
		   voices=""/>
		<msg @l="400" char_id="0" frame_id="-1" name="美帆"
		   text="『んっ、んぐっ‥‥‥んぷっ‥‥んぷっ‥‥‥‥‥ん、ちゅるるっ。』" voices="miho09380"/>
		<msg @l="402" char_id="-1" frame_id="-1" name="朽木" text="『くっ‥‥。』" voices=""/>
		<msg @l="404" char_id="-1" frame_id="-1" name=""
		   text="私が軽く先端を吸い上げた瞬間、教授が小さく声を漏らして腰を震わせる。" voices=""/>
		<msg @l="407" async="true" char_id="-1" frame_id="-1" name=""
		   text="どこに出す‥‥？" voices=""/>
		<select @l="408">
			<menu @l="411" label="EventLabel_126" text="口に"/>
			<menu @l="414" label="EventLabel_127" text="顔に"/>
		</select>
		<label @l="420" id="EventLabel_126"/>
		<flash @l="423" count="4" fade="100" image="white"/>
		<wait_chgmv/>
		<ev @l="426" src="ev-010bx1y1z1"/>
		<msg @l="428" char_id="0" frame_id="-1" name="美帆" text="『んむぅっ！？』"
		   voices="miho09390"/>
		<msg @l="430" char_id="-1" frame_id="-1" name=""
		   text="突然びくりと肉棒全体が跳ね上がったかと思うと、口内に大量の熱水が注ぎ込まれる。" voices=""/>
		<msg @l="432" char_id="-1" frame_id="-1" name="朽木"
		   text="『こぼさぬようにしっかり唇を締めたまえ。』" voices=""/>
		<msg @l="434" char_id="0" frame_id="-1" name="美帆" text="『んん、んーっ！？』"
		   voices="miho09400"/>
		<msg @l="436" char_id="-1" frame_id="-1" name=""
		   text="頭を押さえつけられ口を離す事も出来ないまま、私の口の中には次々とその液体が流れ込んでくる。" voices=""/>
		<msg @l="437" char_id="-1" frame_id="-1" name=""
		   text="頭がくらくらするほど青臭いそれが精液であるという事は‥‥さすがの私にもすぐに想像がついた。" voices=""/>
		<msg @l="439" char_id="0" frame_id="-1" name="美帆"
		   text="(いや‥‥‥こんなの、口の中に出すなんて‥‥‥‥‥‥)" voices="miho09410"/>
		<msg @l="441" char_id="-1" frame_id="-1" name=""
		   text="口の中に溢れ返る液体に戸惑いと嫌悪を感じながら、私はそれでも命令されるまま懸命に唇を締め付けてそれをこぼしてしまわないようにする。"
		   voices=""/>
		<msg @l="443" char_id="0" frame_id="-1" name="美帆" text="『んっ‥‥‥んんっ‥‥‥‥‥‥。』"
		   voices="miho09420"/>
		<msg @l="445" char_id="-1" frame_id="-1" name=""
		   text="やがて‥‥肉棒の脈動が収まり、溢れ出す精液がようやく収まる。" voices=""/>
		<msg @l="446" char_id="-1" frame_id="-1" name=""
		   text="私はそれでも頭を押さえつけられたままで‥‥口内を溢れんばかりに満たしている精液を早く吐き出したくて喉を唸らせる。" voices=""/>
		<msg @l="448" char_id="-1" frame_id="-1" name="朽木" text="『飲み込め。』" voices=""/>
		<msg @l="450" char_id="0" frame_id="-1" name="美帆" text="『‥‥！？』"
		   voices="miho09430"/>
		<msg @l="452" char_id="-1" frame_id="-1" name="朽木"
		   text="『聞こえなかったのかね？&#32;すべて、飲み込みたまえ。』" voices=""/>
		<msg @l="454" char_id="0" frame_id="-1" name="美帆" text="『んんー！！』"
		   voices="miho09440"/>
		<msg @l="456" char_id="-1" frame_id="-1" name=""
		   text="私は咥えさせられたまま弱々しく首を横に振る。" voices=""/>
		<msg @l="458" char_id="-1" frame_id="-1" name="朽木"
		   text="『もう一度だけ言う、飲み込みたまえ。』" voices=""/>
		<msg @l="460" char_id="-1" frame_id="-1" name=""
		   text="朽木教授はまっすぐ私を見つめ、口元を邪悪に歪ませる。" voices=""/>
		<msg @l="462" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』"
		   voices="miho09450"/>
		<msg @l="464" char_id="0" frame_id="-1" name="美帆" text="『‥‥んくっ。』"
		   voices="miho09460"/>
		<msg @l="466" char_id="0" frame_id="-1" name="美帆"
		   text="『んくっ‥‥‥んっ、んくっ‥‥‥んくっ‥‥‥んくっ、んくっ‥‥‥。』" voices="miho09470"/>
		<msg @l="468" char_id="-1" frame_id="-1" name="" text="私は、懸命に口内のそれを飲み下していく。"
		   voices=""/>
		<msg @l="469" char_id="-1" frame_id="-1" name=""
		   text="粘つく精液は喉に絡んでとても飲みづらく、私は涙を浮かべ途中で何度も休みながら液体全てを体内へ送り込んでいった。" voices=""/>
		<goto @l="472" label="EventLabel_128"/>
		<label @l="476" id="EventLabel_127"/>
		<flash @l="479" count="4" fade="100" image="white"/>
		<wait_chgmv/>
		<ev @l="482" src="ev-010bx1y1z2"/>
		<msg @l="484" char_id="0" frame_id="-1" name="美帆" text="『んはっっ！？』"
		   voices="miho09480"/>
		<msg @l="486" char_id="-1" frame_id="-1" name=""
		   text="いきなり口腔から男根が引き抜かれたかと思うと、私のすぐ目の前で亀頭がひと際大きくなり、大量の白濁色をした液体が噴出して私の顔に撒き散らされる。"
		   voices=""/>
		<msg @l="488" char_id="0" frame_id="-1" name="美帆" text="『んんんっ！！』"
		   voices="miho09490"/>
		<msg @l="490" char_id="-1" frame_id="-1" name=""
		   text="私は思わず目をつむり、顔を背けようとする。" voices=""/>
		<msg @l="491" char_id="-1" frame_id="-1" name=""
		   text="が、頭をがっちりと押さえられていて逃げることが出来ない。" voices=""/>
		<msg @l="493" char_id="-1" frame_id="-1" name="朽木" text="『まだ終わっておらんよ。』"
		   voices=""/>
		<msg @l="495" char_id="-1" frame_id="-1" name=""
		   text="教授はそう言って先端を私の頬に押し当て、いまだ溢れてくる白濁色の液体をぬり付けてくる。" voices=""/>
		<msg @l="497" char_id="0" frame_id="-1" name="美帆" text="『うあ‥‥。』"
		   voices="miho09500"/>
		<msg @l="499" char_id="-1" frame_id="-1" name=""
		   text="頬にあたる先端の感触と顔に撒き散らされた青臭い精液の感触に、私は嫌悪の表情を浮かべて声を漏らす。" voices=""/>
		<msg @l="500" char_id="-1" frame_id="-1" name="" text="肉棒も、液体も‥‥凄く熱い。"
		   voices=""/>
		<msg @l="502" char_id="-1" frame_id="-1" name="朽木"
		   text="『くくっ、良い格好だ‥‥実に良く似合っているよ。』" voices=""/>
		<msg @l="504" char_id="-1" frame_id="-1" name=""
		   text="教授は白濁液まみれになった私を見下ろし、満足げに笑っている。" voices=""/>
		<msg @l="505" char_id="-1" frame_id="-1" name=""
		   text="私は、精液を顔につけたまま肩で激しい息をし、呆然としていた" voices=""/>
		<msg @l="507" char_id="0" frame_id="-1" name="美帆"
		   text="(また‥‥‥汚されちゃった‥‥‥‥‥‥)" voices="miho09510"/>
		<label @l="511" id="EventLabel_128"/>
		<clear @l="515" class="all"/>
		<end_scene @l="518"/>
		<label @l="520" id="event_scene51"/>
		<goto @l="522" cond="!(f.flagInExtraMode&#32;&gt;&#32;100)&#13;&#10;"
		   label="TempLabel_199"/>
		<bgm @l="524" src="bgm14" volume="1."/>
		<label @l="525" id="TempLabel_199"/>
		<msg @l="527" char_id="-1" frame_id="-1" name="朽木"
		   text="『いや、思った以上に素晴らしいおしゃぶりだった。』" voices=""/>
		<msg @l="529" char_id="-1" frame_id="-1" name=""
		   text="満足したモノをズボンの中へしまいながら、朽木教授が楽しげに言う。" voices=""/>
		<msg @l="531" char_id="-1" frame_id="-1" name="朽木"
		   text="『これほど素晴らしいおしゃぶりを私だけで味わうのは少々勿体無いな。』" voices=""/>
		<msg @l="533" char_id="-1" frame_id="-1" name="朽木"
		   text="『どれ、キミたちも彼女にしゃぶってもらいたまえ。』" voices=""/>
		<msg @l="535" char_id="0" frame_id="-1" name="美帆" text="『え‥‥。』"
		   voices="miho09520"/>
		<msg @l="537" char_id="-1" frame_id="-1" name=""
		   text="呆然としながらも立ち上がろうとすると、朽木教授の手が私の肩をつかみ、もう一度強引に座らせる。" voices=""/>
		<msg @l="539" char_id="-1" frame_id="-1" name="壁役の男Ａ" text="『え、いいんスか？』"
		   voices=""/>
		<msg @l="541" char_id="-1" frame_id="-1" name="壁役の男Ｂ" text="『是非ともお願いしますっ！』"
		   voices=""/>
		<msg @l="543" char_id="0" frame_id="-1" name="美帆" text="『そ、そんなっ‥‥‥。』"
		   voices="miho09530"/>
		<msg @l="545" char_id="-1" frame_id="-1" name="朽木"
		   text="『これも私と交わした契約のうちだ‥‥問題があるかね？』" voices=""/>
		<msg @l="547" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』"
		   voices="miho09540"/>
		<msg @l="549" char_id="0" frame_id="-1" name="美帆" text="『わかり‥‥ました。』"
		   voices="miho09550"/>
		<msg @l="551" char_id="-1" frame_id="-1" name=""
		   text="私は短く答え‥‥壁役の人たち二人がいそいそとズボンの内側から取り出した男根へ再び舌先を伸ばしていく。" voices=""/>
		<msg @l="553" char_id="-1" frame_id="-1" name="壁役の男Ａ" text="『おっと‥‥その前に。』"
		   voices=""/>
		<msg @l="555" char_id="0" frame_id="-1" name="美帆" text="『‥‥？』"
		   voices="miho09560"/>
		<msg @l="557" char_id="-1" frame_id="-1" name="壁役の男Ａ"
		   text="『もちっと気分を、出させてもらうぜ。』" voices=""/>
		<msg @l="559" char_id="-1" frame_id="-1" name=""
		   text="男はそう言ってブラウスの裾に手を伸ばすと、胸の辺りまで一気にたくし上げる。" voices=""/>
		<msg @l="561" char_id="0" frame_id="-1" name="美帆" text="『あ‥‥。』"
		   voices="miho09570"/>
		<msg @l="563" char_id="-1" frame_id="-1" name=""
		   text="私は短く声をあげるが‥‥抵抗することは許されない。" voices=""/>
		<msg @l="564" char_id="-1" frame_id="-1" name=""
		   text="そうして男はブラジャーもずらして胸を完全に露出させると、それを手のひらで揉みまわし始めた。" voices=""/>
		<msg @l="566" char_id="-1" frame_id="-1" name="壁役の男Ａ"
		   text="『俺達だけやってもらうのは悪いからな。お礼に俺達も揉んで気持ち良くしてやるよ。』" voices=""/>
		<msg @l="568" char_id="-1" frame_id="-1" name="壁役の男Ｂ"
		   text="『そんじゃ、しっかりしゃぶってくれよ。』" voices=""/>
		<msg @l="570" char_id="-1" frame_id="-1" name=""
		   text="男はそう言ってニヤリと笑うと‥‥私の口元へ先端を差し出す。" voices=""/>
		<msg @l="572" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』"
		   voices="miho09580"/>
		<msg @l="574" char_id="-1" frame_id="-1" name=""
		   text="私は改めて‥‥亀頭へと舌先を伸ばしていった。" voices=""/>
		<clear @l="577" class="all"/>
		<msgshow @l="580" show="true"/>
		<label @l="583" id="chart_line46"/>
		<wait_chgmv/>
		<ev @l="586" src="ev-051"/>
		<description @l="589" text="公然奉仕奴隷"/>
		<msg @l="591" char_id="0" frame_id="-1" name="美帆" text="『んふっ‥‥。』"
		   voices="miho09590"/>
		<msg @l="593" char_id="-1" frame_id="-1" name=""
		   text="吐息を漏らしながら、ゆっくりと先端を舌で舐め上げる。" voices=""/>
		<msg @l="594" char_id="-1" frame_id="-1" name=""
		   text="やはり独特の匂いと味がして嫌悪感が沸いたけれど、止めるわけにはいかない。" voices=""/>
		<msg @l="596" char_id="-1" frame_id="-1" name="壁役の男Ａ"
		   text="『へ、へへっ‥‥まさかしゃぶってもらえるなんてな。』" voices=""/>
		<msg @l="598" char_id="-1" frame_id="-1" name="壁役の男Ｂ"
		   text="『おう、壁冥利に尽きるってヤツ？』" voices=""/>
		<msg @l="600" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』"
		   voices="miho09600"/>
		<msg @l="602" char_id="-1" frame_id="-1" name=""
		   text="勝手な事を口々につぶやいて、ケラケラと笑う男たち。" voices=""/>
		<msg @l="603" char_id="-1" frame_id="-1" name=""
		   text="私は彼らの言いなりになるのに悲しみを感じながら、それでも逆らう事もできず舌先を動かし続ける。" voices=""/>
		<msg @l="605" char_id="0" frame_id="-1" name="美帆"
		   text="『んっ‥‥‥んんっ‥‥‥‥‥‥ちゅろ‥‥‥‥ちゅろ‥‥‥‥‥。』" voices="miho09610"/>
		<msg @l="607" char_id="-1" frame_id="-1" name=""
		   text="つい先ほど教えられたとおり、唾液をまぶし、唇で伸ばす。" voices=""/>
		<msg @l="609" char_id="-1" frame_id="-1" name="壁役の男Ａ"
		   text="『おお‥‥いいね、さすが朽木さんの直伝だ。』" voices=""/>
		<msg @l="611" char_id="-1" frame_id="-1" name="壁役の男Ｂ"
		   text="『そっち舐めてる間は、こっちは手でやってくれよ。』" voices=""/>
		<msg @l="613" char_id="-1" frame_id="-1" name=""
		   text="肉棒を握った手の上から男の手が添えられ、ごしごしと前後に動かされる。" voices=""/>
		<msg @l="614" char_id="-1" frame_id="-1" name=""
		   text="そうしてしばらくレクチャーするように動かした後、さあやってみろと言わんばかりに男は手を離した。" voices=""/>
		<msg @l="616" char_id="0" frame_id="-1" name="美帆" text="『んぅ‥‥。』"
		   voices="miho09620"/>
		<msg @l="618" char_id="-1" frame_id="-1" name=""
		   text="わずかな戸惑いを胸に、私はゆっくりと手を動かし始める。" voices=""/>
		<msg @l="620" char_id="-1" frame_id="-1" name="壁役の男Ｂ"
		   text="『そうそう、もうちょい強く握って。』" voices=""/>
		<msg @l="622" char_id="0" frame_id="-1" name="美帆" text="『んっ‥‥んっ‥‥‥。』"
		   voices="miho09630"/>
		<msg @l="624" char_id="-1" frame_id="-1" name=""
		   text="熱いモノを握っている手に力を入れて、しごく。" voices=""/>
		<msg @l="625" char_id="-1" frame_id="-1" name=""
		   text="先端部分の凹凸に引っかかる感じが‥‥何となく奇妙だ。" voices=""/>
		<msg @l="627" char_id="-1" frame_id="-1" name="壁役の男Ａ"
		   text="『ほら、手コキばっかに気を取られてないでしっかりしゃぶってくれよな。』" voices=""/>
		<msg @l="629" char_id="0" frame_id="-1" name="美帆"
		   text="『んんっ‥‥‥んっ‥‥‥‥ちゅぷ‥‥‥ンっ、ちゅぷぷっ。』" voices="miho09640"/>
		<msg @l="631" char_id="-1" frame_id="-1" name="壁役の男Ｂ"
		   text="『あー‥‥手が柔らかくて、サイコーだわ。』" voices=""/>
		<msg @l="633" char_id="-1" frame_id="-1" name="壁役の男Ａ"
		   text="『こっちも、舌の動きとか結構いい感じだぜ。とても、２回目とは思えねぇぜ。』" voices=""/>
		<msg @l="635" char_id="0" frame_id="-1" name="美帆"
		   text="『んぷっ、んぷっ、んぷっ‥‥‥‥ん、ちゅぷ、ちゅるるっ‥‥‥。』" voices="miho09650"/>
		<msg @l="637" char_id="-1" frame_id="-1" name="壁役の男Ａ"
		   text="『うおっ‥‥その、吸うヤツもっとやってくれよ。』" voices=""/>
		<msg @l="639" char_id="0" frame_id="-1" name="美帆"
		   text="『んっ‥‥‥じゅっ‥‥ちゅぷ、んっ‥‥‥ちゅるっ、ちゅるるる。』" voices="miho09660"/>
		<msg @l="641" char_id="-1" frame_id="-1" name="壁役の男Ａ" text="『そうそう、いいぜぇ‥‥。』"
		   voices=""/>
		<msg @l="643" char_id="-1" frame_id="-1" name=""
		   text="男たちに言われるまま、私は唇と舌で怒張したモノ全体を愛撫していく。" voices=""/>
		<msg @l="644" char_id="-1" frame_id="-1" name=""
		   text="つい先ほどまで知らなかった事を、今では駆使して、男を悦ばせている。" voices=""/>
		<msg @l="645" char_id="-1" frame_id="-1" name="" text="そう思うと‥‥悲しくなった。"
		   voices=""/>
		<msg @l="647" char_id="0" frame_id="-1" name="美帆"
		   text="『ん、んんっ‥‥‥ちゅぷっ、ちゅぷっ、ちゅぷっ‥‥‥‥。』" voices="miho09670"/>
		<msg @l="649" char_id="-1" frame_id="-1" name=""
		   text="男達が出来るだけ早くイクように、唇でギュッと挟みしごき上げ続ける。" voices=""/>
		<msg @l="651" char_id="-1" frame_id="-1" name="壁役の男Ｂ"
		   text="『今度はこっちもしゃぶってくれよ。』" voices=""/>
		<msg @l="653" char_id="-1" frame_id="-1" name=""
		   text="それまで手でしごかせていた男が、私の頬に先端をこすりつけて言う。" voices=""/>
		<msg @l="655" char_id="0" frame_id="-1" name="美帆" text="『んっ‥‥あ、むぅ。』"
		   voices="miho09680"/>
		<msg @l="657" char_id="0" frame_id="-1" name="美帆"
		   text="『んふっ‥‥‥ん、ちゅるっ‥‥‥‥‥ちゅぷ、ちゅぷぷっ。』" voices="miho09690"/>
		<msg @l="659" char_id="-1" frame_id="-1" name="" text="ためらいはなかった。" voices=""/>
		<msg @l="660" char_id="-1" frame_id="-1" name=""
		   text="私はこすりつけられた先端を咥え込み、ゆっくりと舌先を絡める。" voices=""/>
		<msg @l="662" char_id="0" frame_id="-1" name="美帆"
		   text="『ちゅ、ちゅぷっ‥‥‥ん、んぷっ‥‥‥ん、んぷっ‥‥‥‥。』" voices="miho09700"/>
		<msg @l="664" char_id="0" frame_id="-1" name="美帆"
		   text="『んぷっ‥‥‥ちゅぷ、ちゅぷ、ちゅぷ‥‥‥‥ん、ちゅるるっ。』" voices="miho09710"/>
		<msg @l="666" char_id="-1" frame_id="-1" name=""
		   text="そして‥‥それまでしていたのと同じように鈴口を吸い上げ、舌でカリの部分を舐めあげる。" voices=""/>
		<msg @l="668" char_id="-1" frame_id="-1" name="壁役の男Ｂ"
		   text="『へへっ、美味そうにしゃぶってるよ。』" voices=""/>
		<msg @l="670" char_id="-1" frame_id="-1" name="壁役の男Ａ"
		   text="『すっかり病み付きになったってか？』" voices=""/>
		<msg @l="672" char_id="-1" frame_id="-1" name=""
		   text="そう言いながら、最初に咥えさせた男が私の手を取って竿の部分をしごかせる。" voices=""/>
		<msg @l="673" char_id="-1" frame_id="-1" name=""
		   text="私の唾液がたっぷりと絡んだそれは、しごき上げるたびにジュクジュクといやらしい音を立てる。" voices=""/>
		<msg @l="675" char_id="-1" frame_id="-1" name="壁役の男Ａ"
		   text="『おおっ‥‥口の中も良かったけど、これはこれで。』" voices=""/>
		<msg @l="677" char_id="-1" frame_id="-1" name="壁役の男Ｂ"
		   text="『ああ。手コキもフェラチオも満点だな。』" voices=""/>
		<msg @l="679" char_id="-1" frame_id="-1" name="" text="陶酔しきった顔で、男たちが言う。"
		   voices=""/>
		<msg @l="680" char_id="-1" frame_id="-1" name=""
		   text="私はそんな彼らの言葉に耳を傾ける事無く、懸命にしゃぶりつく。" voices=""/>
		<msg @l="681" char_id="-1" frame_id="-1" name=""
		   text="彼らを果てさせなければ‥‥そんな思いだけが、私を動かしていた。" voices=""/>
		<msg @l="683" char_id="0" frame_id="-1" name="美帆"
		   text="『んむっ‥‥‥んっ、んんっ‥‥‥‥じゅぷ、ちゅぷぷぷっ。』" voices="miho09720"/>
		<msg @l="685" char_id="0" frame_id="-1" name="美帆"
		   text="『ちゅぷ、ちゅぷ、ちゅぷっ‥‥‥ん、んぐっ‥‥‥‥ちゅるるっ。』" voices="miho09730"/>
		<msg @l="687" char_id="-1" frame_id="-1" name="壁役の男Ｂ"
		   text="『ああ、その先っぽ咥えたまま舌動かすの続けてくれ。』" voices=""/>
		<msg @l="689" char_id="0" frame_id="-1" name="美帆"
		   text="『んんっ‥‥‥ちゅぷ、ちゅぷ、ちゅぷ、ちゅぷ、ちゅぷっ。』" voices="miho09740"/>
		<msg @l="691" char_id="0" frame_id="-1" name="美帆"
		   text="『ん、ちゅぷっ‥‥‥んっ‥‥‥ちゅるっ、んぷ、ちゅるるるっ。』" voices="miho09750"/>
		<msg @l="693" char_id="-1" frame_id="-1" name="壁役の男Ｂ"
		   text="『くあっ‥‥すげ、搾り取られそうだっ。』" voices=""/>
		<msg @l="695" char_id="-1" frame_id="-1" name="壁役の男Ａ"
		   text="『あー‥‥こっちもそろそろ、出そうだぜ。』" voices=""/>
		<msg @l="697" char_id="0" frame_id="-1" name="美帆"
		   text="『んうっ‥‥んっ、んっ、んっ‥‥‥‥んふ、んっ、ちゅぷぷっ。』" voices="miho09760"/>
		<msg @l="699" char_id="0" frame_id="-1" name="美帆"
		   text="『ん、ちゅぷ‥‥‥ちゅぷ、ちゅぷ、ちゅぷ、んんっ、ちゅるっ！！』" voices="miho09770"/>
		<msg @l="701" char_id="-1" frame_id="-1" name="壁役の男Ｂ" text="『くっ‥‥で、出るっ！！』"
		   voices=""/>
		<msg @l="703" char_id="-1" frame_id="-1" name="壁役の男Ａ" text="『い、いくぞっ！！』"
		   voices=""/>
		<flash @l="706" count="4" fade="100" image="white"/>
		<wait_chgmv/>
		<ev @l="709" src="ev-051z1"/>
		<msg @l="711" char_id="0" frame_id="-1" name="美帆" text="『んあっっ！！』"
		   voices="miho09780"/>
		<msg @l="713" char_id="-1" frame_id="-1" name=""
		   text="左右から、一斉に熱い精液を浴びせかけられる。" voices=""/>
		<msg @l="714" char_id="-1" frame_id="-1" name=""
		   text="勢いよく吐き出され‥‥私の顔を瞬く間に白くドロドロにしていく。" voices=""/>
		<msg @l="716" char_id="0" frame_id="-1" name="美帆" text="『はぁ‥‥はぁ‥‥はぁ‥‥‥。』"
		   voices="miho09790"/>
		<msg @l="718" char_id="-1" frame_id="-1" name="壁役の男Ａ"
		   text="『へへっ‥‥‥すげー、結構出たぜ。』" voices=""/>
		<msg @l="720" char_id="-1" frame_id="-1" name="壁役の男Ｂ"
		   text="『ああ、やっぱ可愛い子にしてもらうと違うな。』" voices=""/>
		<msg @l="722" char_id="-1" frame_id="-1" name="壁役の男Ａ"
		   text="『さーて、んじゃ最後にお掃除よろしくね。』" voices=""/>
		<msg @l="724" char_id="0" frame_id="-1" name="美帆" text="『え‥‥。』"
		   voices="miho09800"/>
		<msg @l="726" char_id="-1" frame_id="-1" name="壁役の男Ｂ"
		   text="『奥に残ってるのを吸い出すんだよ。当然だろ？』" voices=""/>
		<msg @l="728" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』"
		   voices="miho09810"/>
		<msg @l="730" char_id="-1" frame_id="-1" name="" text="私は戸惑いの表情で朽木教授を見る。"
		   voices=""/>
		<msg @l="732" char_id="-1" frame_id="-1" name="朽木" text="『彼らの言う通りにしたまえ。』"
		   voices=""/>
		<msg @l="734" char_id="0" frame_id="-1" name="美帆" text="『‥‥はい。』"
		   voices="miho09820"/>
		<msg @l="736" char_id="0" frame_id="-1" name="美帆"
		   text="『んっ‥‥‥んぷ、ちゅぷっ‥‥‥ちゅ、ちゅうううっ。』" voices="miho09830"/>
		<msg @l="738" char_id="-1" frame_id="-1" name=""
		   text="私は再び男たちの亀頭を咥えこみ、精液の残滓をすする。" voices=""/>
		<msg @l="739" char_id="-1" frame_id="-1" name=""
		   text="そうして‥‥口内に滲み出した汁を飲み下しいく。" voices=""/>
		<msg @l="741" char_id="0" frame_id="-1" name="美帆" text="(もう‥‥戻れないの‥‥‥‥？)"
		   voices="miho09840"/>
		<msg @l="743" char_id="0" frame_id="-1" name="美帆"
		   text="(元の生活には、楽しかった時には‥‥‥‥もう)" voices="miho09850"/>
		<msg @l="745" char_id="-1" frame_id="-1" name=""
		   text="喉に絡まる精液の感触にむせ返りそうになりながら、私はそれでも彼らの肉棒をしゃぶり続けていた。" voices=""/>
		<stopse @l="748" buf="3"/>
		<stopbgm @l="751" fadeout="1000"/>
		<clear @l="754" class="all"/>
		<end_scene @l="757"/>
		<msgshow @l="760" show="true"/>
		<wait_chgmv/>
		<bg @l="763" src="bg08m2"/>
		<bgm @l="766" src="bgm03" volume="1."/>
		<char @l="769" id="miho" pos="auto" src="miho116"/>
		<description @l="772" text="契約の日々・３日目"/>
		<msg @l="774" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="776" char_id="-1" frame_id="-1" name=""
		   text="一限目が終わり、休み時間に入ったのを確認して私は講堂に入る。" voices=""/>
		<msg @l="777" char_id="-1" frame_id="-1" name=""
		   text="あの後‥‥顔に浴びせられた精液をティッシュで拭った私は、人目につかないように構内のトイレに駆け込んでいた。" voices=""/>
		<msg @l="778" char_id="-1" frame_id="-1" name="" text="何度も顔を洗って、何度も口をゆすいだ。"
		   voices=""/>
		<msg @l="779" char_id="-1" frame_id="-1" name=""
		   text="髪についた精液がなかなか取れず‥‥ティッシュで拭い取った後、水で濡らしながら少しずつ少しずつこそぎ落としていくのが精一杯だった。"
		   voices=""/>
		<msg @l="780" char_id="-1" frame_id="-1" name=""
		   text="何せ水に濡らした途端に固まってしつこく張り付いてくるのだ。" voices=""/>
		<msg @l="781" char_id="-1" frame_id="-1" name=""
		   text="そうこうしているうちに‥‥結局、一限目は出れなくなってしまった。" voices=""/>
		<msg @l="783" char_id="-1" frame_id="-1" name="声" text="『あれ、美帆じゃない？』"
		   voices=""/>
		<char @l="786" id="miho" pos="auto" src="miho014"/>
		<msg @l="788" char_id="0" frame_id="-1" name="美帆" text="『あ‥‥。』" voices=""/>
		<msg @l="790" char_id="-1" frame_id="-1" name=""
		   text="席を立って振り向いた講義友達の子と、目が合う。" voices=""/>
		<msg @l="791" char_id="-1" frame_id="-1" name="" text="少しだけ‥‥後ろめたかった。"
		   voices=""/>
		<msg @l="793" char_id="-1" frame_id="-1" name="女友達" text="『なによ、今来たとこ？』"
		   voices=""/>
		<char @l="796" id="miho" pos="auto" src="miho016"/>
		<msg @l="798" char_id="0" frame_id="-1" name="美帆" text="『う、うん‥‥一限目サボっちゃった。』"
		   voices=""/>
		<msg @l="800" char_id="-1" frame_id="-1" name="女友達"
		   text="『アンタが講義サボるなんて珍しいね。』" voices=""/>
		<char @l="803" id="miho" pos="auto" src="miho116"/>
		<msg @l="805" char_id="0" frame_id="-1" name="美帆" text="『そ、そう？』" voices=""/>
		<msg @l="807" char_id="-1" frame_id="-1" name="女友達"
		   text="『そうだよ。マジメだけが取り得なのに。』" voices=""/>
		<char @l="810" id="miho" pos="auto" src="miho016"/>
		<msg @l="812" char_id="0" frame_id="-1" name="美帆" text="『それ‥‥ちょっと嬉しくないよ。』"
		   voices=""/>
		<msg @l="814" char_id="-1" frame_id="-1" name="女友達" text="『あははっ、ごめんごめん！』"
		   voices=""/>
		<msg @l="816" char_id="-1" frame_id="-1" name="" text="そう言って彼女はケラケラと笑う。"
		   voices=""/>
		<msg @l="817" char_id="-1" frame_id="-1" name="" text="私も‥‥それにつられて少し笑った。"
		   voices=""/>
		<msg @l="819" char_id="-1" frame_id="-1" name="女友達"
		   text="『ん？&#32;それ、どうしたの？』" voices=""/>
		<char @l="822" id="miho" pos="auto" src="miho116"/>
		<msg @l="824" char_id="0" frame_id="-1" name="美帆" text="『え、なに‥‥？』" voices=""/>
		<msg @l="826" char_id="-1" frame_id="-1" name="女友達" text="『髪、なんか濡れてない？』"
		   voices=""/>
		<stopbgm @l="829" fadeout="1000"/>
		<char @l="832" id="miho" pos="auto" src="miho114"/>
		<msg @l="834" char_id="0" frame_id="-1" name="美帆" text="『え‥‥。』" voices=""/>
		<msg @l="836" char_id="-1" frame_id="-1" name="" text="ドキっとした。" voices=""/>
		<msg @l="837" char_id="-1" frame_id="-1" name=""
		   text="充分に鏡で確認してきたけれど、それでもまだ精液がどこかに残っていないとも限らない。" voices=""/>
		<char @l="840" id="miho" pos="auto" src="miho115"/>
		<bgm @l="843" src="bgm09" volume="1."/>
		<msg @l="845" char_id="0" frame_id="-1" name="美帆" text="『な、なにか‥‥ついてる？』"
		   voices=""/>
		<msg @l="847" char_id="-1" frame_id="-1" name="女友達"
		   text="『何か、白い物‥‥‥‥って、何、どーしたの？』" voices=""/>
		<char @l="850" id="miho" pos="auto" src="miho015"/>
		<msg @l="852" char_id="0" frame_id="-1" name="美帆" text="『え、あ‥‥。』" voices=""/>
		<char @l="855" id="miho" pos="auto" src="miho016"/>
		<msg @l="857" char_id="0" frame_id="-1" name="美帆"
		   text="『来る途中でね、その‥‥‥ハトの‥‥‥‥‥。』" voices=""/>
		<msg @l="859" char_id="-1" frame_id="-1" name="" text="私はとっさに嘘をつく。"
		   voices=""/>
		<msg @l="861" char_id="-1" frame_id="-1" name="女友達"
		   text="『ああ！&#32;やられちゃったかぁ！&#32;校門入ったとこでしょ？』" voices=""/>
		<msg @l="863" char_id="0" frame_id="-1" name="美帆"
		   text="『う、うん‥‥あのハトがいっぱいいるところ。』" voices=""/>
		<msg @l="865" char_id="-1" frame_id="-1" name="女友達"
		   text="『私の彼もねー、あそこで一回爆撃されてんのよ。』" voices=""/>
		<msg @l="867" char_id="-1" frame_id="-1" name="女友達"
		   text="『運の悪いヤツとは思ってたけど‥‥災難だったわね。』" voices=""/>
		<msg @l="869" char_id="0" frame_id="-1" name="美帆"
		   text="『化粧室で落としてきたのに、まだついてたんだ、ちょっとまた行ってくる！』" voices=""/>
		<msg @l="870" char_id="-1" frame_id="-1" name="女友達" text="『一緒に行こうか？』"
		   voices=""/>
		<char @l="873" id="miho" pos="auto" src="miho115"/>
		<msg @l="875" char_id="0" frame_id="-1" name="美帆"
		   text="『いい！‥‥あ‥‥大丈夫‥‥‥‥すぐ戻ってくるから。』" voices=""/>
		<msg @l="877" char_id="-1" frame_id="-1" name=""
		   text="私は、私の大声でビックリしている講義友達を置いて走って教室を出て行った。" voices=""/>
		<msg @l="878" char_id="-1" frame_id="-1" name="" text="目に涙をためながら‥‥‥。"
		   voices=""/>
		<stopbgm @l="881" fadeout="1000"/>
		<clear @l="884" class="all"/>
		<call @l="887" target="EventLabel_129@root_kutuki05c"/>
		<return @l="888" value="0&#13;&#10;"/>
	</code>
</xscript>
