<?xml version="1.0" encoding="utf-8"?>
<xscript>
	<debug editor="&quot;C:\Program&#32;Files&#32;(x86)\sakura\sakura.exe&quot;&#32;&quot;%src%&quot;&#32;-Y=%line%"
	   src="D:\シロップ\町ぐるみの罠＋汚された夏セット版\汚された夏\完成データ\汚された夏\script\text\root_tureend01.txt"/>
	<code>
		<label @l="13" id="EventLabel_146"/>
		<bgm @l="16" src="bgm13" volume="1."/>
		<msg @l="19" char_id="-1" frame_id="-1" name="" text="‥‥‥‥‥‥‥‥‥‥‥‥。"
		   voices=""/>
		<msg @l="20" char_id="-1" frame_id="-1" name="" text="‥‥‥‥‥‥‥‥。" voices=""/>
		<msg @l="21" char_id="-1" frame_id="-1" name="" text="‥‥‥‥。" voices=""/>
		<wait_chgmv/>
		<bg @l="24" src="bg15a"/>
		<char @l="26" id="miho" pos="auto" src="miho115"/>
		<description @l="29" text="？？？"/>
		<msg @l="31" char_id="-1" frame_id="-1" name="" text="キャンパスに出た。" voices=""/>
		<msg @l="32" char_id="-1" frame_id="-1" name=""
		   text="テニスコートからは全力疾走しても１０分はかかる。" voices=""/>
		<msg @l="33" char_id="-1" frame_id="-1" name=""
		   text="立ち止まること無く走る自分だけが音を立てていた。" voices=""/>
		<msg @l="34" char_id="-1" frame_id="-1" name="" text="それ以外は音を失ったかのように佇んでいる。"
		   voices=""/>
		<msg @l="35" char_id="-1" frame_id="-1" name=""
		   text="不気味なほど人気を失ったキャンパスには、西からの斜光が並木の影を長く引かせていた。" voices=""/>
		<msg @l="36" char_id="-1" frame_id="-1" name=""
		   text="誰かにこの事を知らせなきゃ。早く助けを呼ばないと。私はその一心で走っていた‥‥‥。" voices=""/>
		<char @l="39" id="miho" pos="auto" src="miho015"/>
		<msg @l="42" char_id="0" frame_id="-1" name="美帆"
		   text="『‥‥‥ハァ‥‥ハァ‥‥ハァ‥‥ハァ‥‥‥。』" voices=""/>
		<msg @l="44" char_id="-1" frame_id="-1" name=""
		   text="呼吸ができないほど胸が苦しくなり、私は立ち止まり呼吸を繰り返し、息を整えた。" voices=""/>
		<msg @l="45" char_id="-1" frame_id="-1" name=""
		   text="一足早い夏の重い空気が肌にまとわりつき‥‥じわりと汗をにじませる。" voices=""/>
		<msg @l="47" char_id="0" frame_id="-1" name="美帆"
		   text="『ハァ‥‥‥ハァ‥‥‥ハァ‥‥‥‥‥‥‥ハァ‥‥‥‥‥。』" voices=""/>
		<msg @l="49" char_id="-1" frame_id="-1" name=""
		   text="ゆっくりと大きな呼吸を繰り返しながら後ろを振り返る。" voices=""/>
		<msg @l="50" char_id="-1" frame_id="-1" name="" text="‥‥追手はまだ追い付いていない。"
		   voices=""/>
		<msg @l="51" char_id="-1" frame_id="-1" name="" text="玲さんは‥‥無事‥‥だろうか‥‥。"
		   voices=""/>
		<msg @l="53" char_id="0" frame_id="-1" name="美帆" text="『玲さん‥‥。』" voices=""/>
		<msg @l="55" char_id="-1" frame_id="-1" name=""
		   text="私は微かにつぶやき‥‥思わずこぼれそうになる涙を堪える様に上を向く。" voices=""/>
		<msg @l="56" char_id="-1" frame_id="-1" name=""
		   text="私が泣いた所で玲さんたちは喜んではくれない。" voices=""/>
		<msg @l="57" char_id="-1" frame_id="-1" name=""
		   text="早く助けを呼んで、早く玲さんたちを助けに行かないと。" voices=""/>
		<char @l="60" id="miho" pos="auto" src="miho115"/>
		<msg @l="62" char_id="0" frame_id="-1" name="美帆"
		   text="(とにかく駅前まで出て、警察に駆け込もう)" voices=""/>
		<msg @l="64" char_id="0" frame_id="-1" name="美帆"
		   text="(玲さんは「逃げて」って言ってたけど‥‥)" voices=""/>
		<msg @l="66" char_id="0" frame_id="-1" name="美帆"
		   text="(絶対にイヤ‥‥大切な人を失いたくない‥‥)" voices=""/>
		<msg @l="68" char_id="0" frame_id="-1" name="美帆"
		   text="(待ってて‥‥‥必ず助けを呼んでくるから‥‥)" voices=""/>
		<msg @l="70" char_id="0" frame_id="-1" name="美帆" text="(待ってて‥‥‥‥‥‥‥‥)"
		   voices=""/>
		<clear @l="73" class="all"/>
		<msg @l="75" char_id="-1" frame_id="-1" name=""
		   text="大学を出る。停留所に向かって、また走り出す。" voices=""/>
		<msg @l="77" char_id="0" frame_id="-1" name="美帆" text="(少しでも早く‥‥)" voices=""/>
		<msg @l="79" char_id="0" frame_id="-1" name="美帆"
		   text="ハァ‥‥‥ハァ‥‥‥ハァ‥‥‥‥‥‥‥ハァ‥‥‥‥‥。" voices=""/>
		<msg @l="81" char_id="0" frame_id="-1" name="美帆" text="(少しでも‥‥)" voices=""/>
		<stopbgm @l="84" fadeout="1000"/>
		<msg @l="86" char_id="0" frame_id="-1" name="美帆" text="(‥‥あれ？)" voices=""/>
		<label @l="89" id="chart_line55"/>
		<wait_chgmv/>
		<ev @l="92" src="ev-058"/>
		<msg @l="94" char_id="-1" frame_id="-1" name=""
		   text="路面電車の停留所へと目を向けると、街中へと続く線路の途中にたたずむ見覚えのある影に気づく。" voices=""/>
		<msg @l="95" char_id="-1" frame_id="-1" name=""
		   text="黄昏色に染められた色素の薄い少女は、いつもと違う悲しみに満ちた表情を浮かべて足元へと視線を落としている。" voices=""/>
		<bgm @l="98" src="bgm16" volume="1."/>
		<msg @l="100" char_id="0" frame_id="-1" name="美帆" text="『奈那子‥‥ちゃん？』"
		   voices="miho13530"/>
		<wait_chgmv/>
		<ev @l="103" src="ev-058x1"/>
		<msg @l="105" char_id="3" frame_id="-1" name="奈那子" text="『美帆‥‥。』"
		   voices="nanako00080"/>
		<msg @l="107" char_id="3" frame_id="-1" name="奈那子" text="『ここにいれば逢えると思ってた。』"
		   voices="nanako00090"/>
		<msg @l="109" char_id="0" frame_id="-1" name="美帆" text="『え‥‥どうして‥‥‥。』"
		   voices="miho13540"/>
		<msg @l="111" char_id="3" frame_id="-1" name="奈那子"
		   text="『美帆はこの町に来るべきじゃなかった。』" voices="nanako00100"/>
		<msg @l="113" char_id="3" frame_id="-1" name="奈那子"
		   text="『ううん‥‥誰もここには来ちゃいけなかった。』" voices="nanako00110"/>
		<msg @l="115" char_id="0" frame_id="-1" name="美帆" text="『なにを‥‥。』"
		   voices="miho13550"/>
		<msg @l="117" char_id="-1" frame_id="-1" name=""
		   text="その意味が解らず問いかけようとしたが、言い澱む。" voices=""/>
		<msg @l="118" char_id="-1" frame_id="-1" name=""
		   text="微かに哀しみが漂う奈那子の瞳を見ると、聞いてはいけない様なことに思えたから。" voices=""/>
		<msg @l="120" char_id="3" frame_id="-1" name="奈那子" text="『逃げよう、美帆。』"
		   voices="nanako00120"/>
		<msg @l="122" char_id="0" frame_id="-1" name="美帆" text="『え‥‥。』"
		   voices="miho13560"/>
		<msg @l="124" char_id="3" frame_id="-1" name="奈那子"
		   text="『美帆はこの町にいるべきじゃない。だから奈那子が逃がしてあげる。』" voices="nanako00130"/>
		<msg @l="126" char_id="0" frame_id="-1" name="美帆"
		   text="『逃がしてあげるって‥‥‥でも、私は。』" voices="miho13570"/>
		<msg @l="128" char_id="-1" frame_id="-1" name=""
		   text="私を逃がす為にその身を挺してくれた玲さんを放っては行けない。" voices=""/>
		<msg @l="130" char_id="0" frame_id="-1" name="美帆"
		   text="『このまま逃げるなんて出来ない‥‥‥。』" voices="miho13580"/>
		<clear @l="133" class="all"/>
		<msg @l="135" char_id="3" frame_id="-1" name="奈那子"
		   text="『大丈夫。兄様がきっと助けてくれるから‥‥‥いこ、美帆。』" voices=""/>
		<msg @l="137" char_id="0" frame_id="-1" name="美帆" text="『あ、奈那子ちゃん‥‥！？』"
		   voices=""/>
		<msg @l="139" char_id="-1" frame_id="-1" name=""
		   text="奈那子ちゃんは返事を待たず、そう言い放って私の手を取る。" voices=""/>
		<msg @l="140" char_id="-1" frame_id="-1" name=""
		   text="私は‥‥手をつかんでいる奈那子ちゃんを見つめながら、どうすれば良いのか決め兼ねずに固まっていた。" voices=""/>
		<msg @l="142" char_id="0" frame_id="-1" name="美帆" text="『でも‥‥警察に知らせないと‥‥。』"
		   voices=""/>
		<msg @l="144" char_id="3" frame_id="-1" name="奈那子"
		   text="『警察は美帆の言うこと聞いてくれないよ‥‥ううん警察だけじゃない‥‥他のみんなも‥‥。』" voices=""/>
		<msg @l="146" char_id="0" frame_id="-1" name="美帆" text="『そんな‥‥‥‥。』"
		   voices=""/>
		<msg @l="148" char_id="3" frame_id="-1" name="奈那子"
		   text="『彼女はそれが分かっていて美帆を逃がしてくれたんだよ。大好きな美帆を守りたいから‥‥。』" voices=""/>
		<msg @l="150" char_id="0" frame_id="-1" name="美帆"
		   text="(逃がしてくれた‥‥私を守りたいから‥‥)" voices=""/>
		<msg @l="152" char_id="0" frame_id="-1" name="美帆" text="(それが‥‥玲さんの願い‥‥)"
		   voices=""/>
		<msg @l="154" char_id="0" frame_id="-1" name="美帆"
		   text="(玲さんが身を挺してまで逃がしてくれたことを‥‥)" voices=""/>
		<msg @l="156" char_id="0" frame_id="-1" name="美帆"
		   text="(そうだよね‥‥私がそれを無駄にしちゃいけない‥‥)" voices=""/>
		<msg @l="158" char_id="-1" frame_id="-1" name=""
		   text="私は自分に言い聞かせるようにつぶやいて、テニスコートのある方角へ視線を向ける。" voices=""/>
		<msg @l="159" char_id="-1" frame_id="-1" name=""
		   text="コートの先には全てを焼き尽くすように、朱に染まった太陽がその姿を誇示していた。" voices=""/>
		<stopbgm @l="162" fadeout="1000"/>
		<msg @l="164" char_id="-1" frame_id="-1" name="" text="‥‥‥‥‥‥‥‥‥‥‥‥。"
		   voices=""/>
		<msg @l="165" char_id="-1" frame_id="-1" name="" text="‥‥‥‥‥‥‥‥。" voices=""/>
		<msg @l="166" char_id="-1" frame_id="-1" name="" text="‥‥‥‥。" voices=""/>
		<bgm @l="169" src="bgm13" volume="1."/>
		<msg @l="171" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="173" char_id="3" frame_id="-1" name="奈那子" text="『‥‥‥‥。』" voices=""/>
		<msg @l="175" char_id="-1" frame_id="-1" name="" text="無言のまま私たちは走っていた。"
		   voices=""/>
		<msg @l="176" char_id="-1" frame_id="-1" name="" text="徐々に走る速度を上げる。"
		   voices=""/>
		<msg @l="177" char_id="-1" frame_id="-1" name="" text="ついには全力疾走となる。"
		   voices=""/>
		<msg @l="178" char_id="-1" frame_id="-1" name=""
		   text="私ももつれそうになる足を懸命に動かしながら走る。" voices=""/>
		<msg @l="179" char_id="-1" frame_id="-1" name="" text="ただ、行き先も知らずに走り抜けていく。"
		   voices=""/>
		<clear @l="182" class="all"/>
		<wait_chgmv/>
		<bg @l="185" src="bg15a"/>
		<char @l="187" id="miho" pos="left" src="miho115"/>
		<char @l="189" id="nanak" pos="right" src="nanako015"/>
		<msg @l="191" char_id="-1" frame_id="-1" name=""
		   text="抜け道のような所を通り抜けると、大学の裏庭に出た。" voices=""/>
		<msg @l="192" char_id="-1" frame_id="-1" name=""
		   text="陽が陰りを見せ始め、緋色に染まったその場所は、恐ろしいほど鮮やかで、何処か気味が悪い‥‥。" voices=""/>
		<msg @l="194" char_id="3" frame_id="-1" name="奈那子" text="『たしか、このへん‥‥‥。』"
		   voices=""/>
		<msg @l="196" char_id="-1" frame_id="-1" name=""
		   text="淡々とした声で奈那子ちゃんが呟いたその時、空気が歪む嫌な気配がした。" voices=""/>
		<shake @l="199" amp="10" class="all" cycle="30" duration="500" type="random"/>
		<msg @l="201" char_id="-1" frame_id="-1" name="" text="ゴウッ！" voices=""/>
		<msg @l="203" char_id="-1" frame_id="-1" name="" text="強風が声を立てて吹きつける。"
		   voices=""/>
		<msg @l="204" char_id="-1" frame_id="-1" name="" text="それに重ねて" voices=""/>
		<stopbgm @l="207" fadeout="1000"/>
		<clear @l="209" class="all"/>
		<msg @l="211" char_id="-1" frame_id="-1" name="" text="《おぉぉぉぉぉぉぉぉう》"
		   voices=""/>
		<msg @l="213" char_id="-1" frame_id="-1" name="" text="と、何かの遠吠えの様な音が聞こえた。"
		   voices=""/>
		<msg @l="214" char_id="-1" frame_id="-1" name="" text="狼‥‥？&#32;‥‥違う‥‥‥。"
		   voices=""/>
		<msg @l="215" char_id="-1" frame_id="-1" name=""
		   text="生きた心地がしない程の恐怖に、心臓の鼓動が早くなる。" voices=""/>
		<msg @l="216" char_id="-1" frame_id="-1" name="" text="林の合間に影だけが見える‥‥。"
		   voices=""/>
		<msg @l="217" char_id="-1" frame_id="-1" name="" text="影は‥‥獣ではなく‥‥人の姿‥‥。"
		   voices=""/>
		<msg @l="218" char_id="-1" frame_id="-1" name="" text="ただ‥‥目だけが紅く、揺らぎ光る‥‥。"
		   voices=""/>
		<msg @l="219" char_id="-1" frame_id="-1" name="" text="―――鬼！！" voices=""/>
		<msg @l="220" char_id="-1" frame_id="-1" name="" text="無意識に伝説上の化け物が浮かんだ。"
		   voices=""/>
		<bgm @l="223" src="bgm13" volume="1."/>
		<wait_chgmv/>
		<bg @l="225" src="bg15a"/>
		<char @l="227" id="miho" pos="left" src="miho115"/>
		<char @l="229" id="nanak" pos="right" src="nanako015"/>
		<msg @l="231" char_id="0" frame_id="-1" name="美帆" text="『な‥‥奈那子ちゃんっ！！』"
		   voices=""/>
		<msg @l="233" char_id="3" frame_id="-1" name="奈那子" text="『美帆！&#32;こっち！！』"
		   voices=""/>
		<clear @l="236" layer="nanak"/>
		<msg @l="238" char_id="-1" frame_id="-1" name=""
		   text="奈那子ちゃんはそう言って、再び走り始める。" voices=""/>
		<msg @l="239" char_id="-1" frame_id="-1" name=""
		   text="向かった先は‥‥校舎裏の先にある裏山の方角だ。" voices=""/>
		<msg @l="240" char_id="-1" frame_id="-1" name=""
		   text="理由も意味もわからず、純粋な恐怖に駆られ彼女の後を必死で着いて行く。" voices=""/>
		<msg @l="242" char_id="0" frame_id="-1" name="美帆" text="『くっ‥‥。』" voices=""/>
		<clear @l="245" layer="miho"/>
		<clear @l="248" class="all"/>
		<msg @l="250" char_id="0" frame_id="-1" name="美帆"
		   text="『ハァ‥‥‥ハァ‥‥‥ハァ‥‥‥‥‥‥‥ハァ‥‥‥‥‥。』" voices=""/>
		<msg @l="252" char_id="-1" frame_id="-1" name="" text="早鐘を打つように心臓が踊る。"
		   voices=""/>
		<msg @l="253" char_id="-1" frame_id="-1" name=""
		   text="もう、どれだけ走っているのすら分からない‥‥。" voices=""/>
		<msg @l="254" char_id="-1" frame_id="-1" name=""
		   text="ただ得体の知れない“何か――恐怖”から少しでも離れる為に走り続けた‥‥。" voices=""/>
		<msg @l="255" char_id="3" frame_id="-1" name="奈那子"
		   text="『丘の向こうに‥‥抜け道があるの。あそこからなら誰にも見つからずに外へ出られるから。』" voices=""/>
		<msg @l="257" char_id="-1" frame_id="-1" name=""
		   text="奈那子ちゃんが行き先を教えてくれたが、恐怖で一杯の頭に考える余裕はなかった。" voices=""/>
		<msg @l="259" char_id="3" frame_id="-1" name="奈那子" text="『見えた‥‥。』" voices=""/>
		<msg @l="261" char_id="-1" frame_id="-1" name=""
		   text="校舎を囲っていたブロック塀まで来て走りを止める。" voices=""/>
		<msg @l="262" char_id="-1" frame_id="-1" name=""
		   text="塀に沿って少し歩くと一箇所だけポッカリと入り口が開いていた。" voices=""/>
		<msg @l="263" char_id="-1" frame_id="-1" name=""
		   text="奈那子ちゃんは私の手を取ると、半ば強引に引っ張り込んだ。" voices=""/>
		<clear @l="266" class="all"/>
		<msgshow @l="268" show="true"/>
		<wait_chgmv/>
		<bg @l="271" src="bg22_1"/>
		<char @l="274" id="miho" pos="auto" src="miho114"/>
		<msg @l="276" char_id="0" frame_id="-1" name="美帆"
		   text="『こんな所に‥‥‥地下通路があったなんて‥‥‥。』" voices=""/>
		<msg @l="278" char_id="-1" frame_id="-1" name=""
		   text="入り口を潜ると不自然すぎるほど手の込んだ廃道が姿を見せた。" voices=""/>
		<msg @l="279" char_id="-1" frame_id="-1" name=""
		   text="石で出来た壁も最低限の採光用窓も、信じられないほど手が込んでいる。" voices=""/>
		<clear @l="282" class="char"/>
		<char @l="284" id="miho" pos="right" src="miho115"/>
		<char @l="286" id="nanak" pos="left" src="nanako017"/>
		<msg @l="288" char_id="3" frame_id="-1" name="奈那子" text="『‥‥‥美帆は先に行って。』"
		   voices=""/>
		<char @l="291" id="miho" pos="right" src="miho114"/>
		<msg @l="293" char_id="0" frame_id="-1" name="美帆" text="『え、奈那子ちゃんは‥‥？』"
		   voices=""/>
		<char @l="296" id="nanak" pos="left" src="nanako010"/>
		<msg @l="298" char_id="3" frame_id="-1" name="奈那子" text="『私はここで‥‥兄様を待ってる。』"
		   voices=""/>
		<char @l="301" id="miho" pos="right" src="miho015"/>
		<msg @l="303" char_id="0" frame_id="-1" name="美帆"
		   text="『そんな！&#32;一緒じゃないの！？』" voices=""/>
		<char @l="306" id="nanak" pos="left" src="nanako011"/>
		<msg @l="308" char_id="3" frame_id="-1" name="奈那子"
		   text="『兄様のやらなければいけない事が、まだ終わってない‥‥‥だから私は行けない。』" voices=""/>
		<msg @l="310" char_id="0" frame_id="-1" name="美帆"
		   text="『やらなければいけない事って‥‥そんな‥‥‥こんな所にいたら奈那子ちゃんだって！！』" voices=""/>
		<clear @l="313" class="char"/>
		<stopbgm @l="315" fadeout="1000"/>
		<wait @l="317" time="5000"/>
		<char @l="319" id="nanak" pos="center" src="nanako013f" y="-80"/>
		<msg @l="321" char_id="3" frame_id="-1" name="奈那子" text="『美帆――――。』"
		   voices=""/>
		<msg @l="323" char_id="-1" frame_id="-1" name=""
		   text="奈那子ちゃんの腕が背中に回され‥‥、きつく抱き締められた。" voices=""/>
		<msg @l="324" char_id="-1" frame_id="-1" name="" text="彼女の長い髪が私の頬をくすぐる‥‥‥。"
		   voices=""/>
		<bgm @l="327" src="bgm11" volume="1."/>
		<msg @l="329" char_id="3" frame_id="-1" name="奈那子" text="『願いを‥‥無駄にしないで。』"
		   voices=""/>
		<msg @l="331" char_id="0" frame_id="-1" name="美帆" text="『え‥‥。』" voices=""/>
		<msg @l="333" char_id="3" frame_id="-1" name="奈那子"
		   text="『美帆を逃がしてくれた人だけじゃない‥‥。私も‥‥‥美帆に助かって欲しいんだよ。』" voices=""/>
		<msg @l="335" char_id="3" frame_id="-1" name="奈那子"
		   text="『‥‥私‥‥美帆が友達になってくれて、とっても楽しかったよ‥‥‥。』" voices=""/>
		<msg @l="337" char_id="-1" frame_id="-1" name=""
		   text="奈那子ちゃんの瞳には、うっすらと涙が浮かんでいた。" voices=""/>
		<msg @l="339" char_id="0" frame_id="-1" name="美帆"
		   text="『わっ私だって‥‥嬉しかったよ‥‥。最初は‥‥ちょっと不思議なコだな‥‥って思ったけど‥‥‥。』" voices=""/>
		<msg @l="341" char_id="3" frame_id="-1" name="奈那子" text="『‥‥‥‥。』" voices=""/>
		<msg @l="343" char_id="-1" frame_id="-1" name=""
		   text="奈那子ちゃんは廃道の奥に向かって私の背をそっと押す。" voices=""/>
		<clear @l="346" class="char"/>
		<char @l="348" id="nanak" pos="auto" src="nanako013"/>
		<msg @l="350" char_id="0" frame_id="-1" name="美帆" text="『わたし‥‥。』" voices=""/>
		<msg @l="352" char_id="3" frame_id="-1" name="奈那子"
		   text="『行って。さよならは―――言わないから。』" voices=""/>
		<msg @l="354" char_id="0" frame_id="-1" name="美帆" text="『っ‥‥！！』" voices=""/>
		<msg @l="356" char_id="3" frame_id="-1" name="奈那子" text="『大丈夫。きっとまた会えるよ。』"
		   voices=""/>
		<msg @l="358" char_id="0" frame_id="-1" name="美帆" text="『奈那子ちゃん‥‥。』"
		   voices=""/>
		<char @l="361" id="nanak" pos="auto" src="nanako011"/>
		<msg @l="363" char_id="3" frame_id="-1" name="奈那子"
		   text="『だって、わたし美帆のこと大好きだもん。』" voices=""/>
		<msg @l="365" char_id="0" frame_id="-1" name="美帆"
		   text="『‥‥うん！&#32;絶対だからね！！&#32;また会おうね！』" voices=""/>
		<msg @l="367" char_id="3" frame_id="-1" name="奈那子" text="『うん。』" voices=""/>
		<clear @l="370" class="all"/>
		<msg @l="372" char_id="-1" frame_id="-1" name=""
		   text="私は‥‥彼女の返事を聞くと弾かれるように走り出した。" voices=""/>
		<msg @l="373" char_id="-1" frame_id="-1" name=""
		   text="体力の限界なんて、とうに過ぎていたが、玲さんと奈那子ちゃんに応える為、ただそれだけで足が動いていた。" voices=""/>
		<stopbgm @l="376" fadeout="1000"/>
		<clear @l="378" class="all"/>
		<msgshow @l="380" show="true"/>
		<msg @l="382" char_id="-1" frame_id="-1" name="" text="‥‥‥‥‥‥‥‥‥‥。"
		   voices=""/>
		<clear @l="385" class="all"/>
		<msgshow @l="387" show="true"/>
		<wait_chgmv/>
		<bg @l="390" src="bg15a"/>
		<char @l="392" id="kuma" pos="auto" src="kuma018f"/>
		<bgm @l="395" src="bgm17" volume="1."/>
		<msg @l="397" char_id="-1" frame_id="-1" name="熊野"
		   text="『チッ‥‥あいつらめ、思ったよりも逃げ足が速い。』" voices=""/>
		<msg @l="399" char_id="-1" frame_id="-1" name="熊野"
		   text="『警察も未だ見つけられんとはな‥‥相変わらず使えん連中だ。』" voices=""/>
		<msg @l="401" char_id="-1" frame_id="-1" name=""
		   text="言葉と共にゆっくりと上がった面貌に、明らかな苛立ちを滲ませる赤光の瞳。" voices=""/>
		<msg @l="402" char_id="-1" frame_id="-1" name=""
		   text="その視線の先に、不自然な程に背後の闇を覗かせて穿たれた黒い穴。" voices=""/>
		<msg @l="403" char_id="-1" frame_id="-1" name=""
		   text="先を認めた熊野の酷薄そうな口元に、侮蔑と懐疑の笑みが張り付いた。" voices=""/>
		<msg @l="405" char_id="-1" frame_id="1" name="熊野"
		   text="（ここは確か‥‥‥‥‥‥くだらん‥‥‥が‥‥‥面白い‥‥‥）" voices=""/>
		<msg @l="407" char_id="-1" frame_id="-1" name="熊野"
		   text="『あの白石とかいう女といい‥‥‥よく邪魔が入る。』" voices=""/>
		<msg @l="409" char_id="-1" frame_id="-1" name="熊野" text="『‥‥が、そう易々と逃がしはせん。』"
		   voices=""/>
		<clear @l="412" class="char"/>
		<char @l="414" id="kuma" pos="left" src="kuma018"/>
		<char @l="416" id="nanak" pos="right" src="nanako017"/>
		<msg @l="418" char_id="-1" frame_id="-1" name="熊野" text="『小娘。貴様、何者だ‥‥。』"
		   voices=""/>
		<msg @l="420" char_id="-1" frame_id="-1" name=""
		   text="熊野が歩を進めようとすると、彼の眼前へ奈那子が立ちはだかった。" voices=""/>
		<msg @l="421" char_id="-1" frame_id="-1" name="" text="美帆と別れた後‥‥戻ってきたのだ。"
		   voices=""/>
		<msg @l="423" char_id="3" frame_id="-1" name="奈那子" text="『‥‥‥‥。』" voices=""/>
		<msg @l="425" char_id="-1" frame_id="-1" name="熊野"
		   text="『ふむ、その様子だと俺を待ち構えていたのか‥‥。小娘、そこをどけ。』" voices=""/>
		<msg @l="427" char_id="-1" frame_id="-1" name="熊野"
		   text="『素直に退けば良し、命だけは助けてやろう。が、退かぬなら痛い目に会う‥‥程度では済まさぬぞ。』" voices=""/>
		<msg @l="429" char_id="3" frame_id="-1" name="奈那子" text="『美帆は‥‥‥渡さない。』"
		   voices=""/>
		<msg @l="431" char_id="-1" frame_id="-1" name="熊野"
		   text="『ふん。小娘ごときに何が出来るのだ。』" voices=""/>
		<msg @l="433" char_id="3" frame_id="-1" name="奈那子" text="『‥‥‥‥。』" voices=""/>
		<msg @l="435" char_id="-1" frame_id="-1" name="熊野"
		   text="『わかってないようだな、俺をその辺のオヤジと一緒にしていたとしたらそれは大きな間違いだぞ！』" voices=""/>
		<clear @l="438" class="char"/>
		<shake @l="441" amp="10" class="all" cycle="30" duration="500" type="random"/>
		<msg @l="443" char_id="-1" frame_id="-1" name=""
		   text="苛立ちをぶつける様に、熊野が大きく腕を横薙ぎに払った。" voices=""/>
		<msg @l="445" char_id="-1" frame_id="-1" name=""
		   text="大きく風がうねりを上げたかと思うと、先ほどまで奈那子の居た場所の空気がえぐり取られる。" voices=""/>
		<msg @l="446" char_id="-1" frame_id="-1" name=""
		   text="しかし奈那子も際どいところではあるものの、熊野の腕をかわしていた。" voices=""/>
		<char @l="449" id="kuma" pos="left" src="kuma018"/>
		<char @l="451" id="nanak" pos="right" src="nanako017"/>
		<msg @l="453" char_id="3" frame_id="-1" name="奈那子" text="『‥‥‥‥。』" voices=""/>
		<msg @l="455" char_id="-1" frame_id="-1" name="熊野"
		   text="『何処でかじった体術かは知らぬが、所詮は小娘。俺を相手にしたのが運の尽きだったな。』" voices=""/>
		<msg @l="457" char_id="-1" frame_id="-1" name=""
		   text="熊野の口元が邪悪に歪むと、赤光の瞳がより一層妖しく輝く。" voices=""/>
		<stopbgm @l="460" fadeout="1000"/>
		<clear @l="463" class="char"/>
		<char @l="465" id="nanak" pos="center" src="nanako014f" y="-80"/>
		<msg @l="467" char_id="3" frame_id="-1" name="奈那子" text="『えっ‥‥‥！？』"
		   voices=""/>
		<msg @l="469" char_id="-1" frame_id="-1" name=""
		   text="瞬間、奈那子が瞬きをした直後に、熊野の姿が消えた。" voices=""/>
		<msg @l="471" char_id="-1" frame_id="-1" name="熊野" text="『これまでだ。』" voices=""/>
		<msg @l="473" char_id="-1" frame_id="-1" name=""
		   text="突如として、背後から熊野の声が聞こえた。と、同時に首筋にちくりとした痛みが走った。" voices=""/>
		<char @l="476" id="nanak" pos="center" src="nanako015f" y="-80"/>
		<flash @l="478" count="4" fade="100" image="white"/>
		<msg @l="480" char_id="3" frame_id="-1" name="奈那子" text="『う、あっ‥‥。』"
		   voices=""/>
		<clear @l="483" class="char"/>
		<msg @l="485" char_id="-1" frame_id="-1" name=""
		   text="途端に、身体の力が抜け‥‥その場に倒れこんでしまう。" voices=""/>
		<shake @l="488" amp="10" class="all" cycle="30" duration="100" type="random"/>
		<se @l="490" buf="1" src="人とぶつかる音" volume="1."/>
		<clear @l="493" class="all"/>
		<label @l="496" id="event_scene69"/>
		<label @l="499" id="chart_line56"/>
		<wait_chgmv/>
		<ev @l="502" src="ev-069"/>
		<bgm @l="505" src="bgm10" volume="1."/>
		<msg @l="507" char_id="3" frame_id="-1" name="奈那子" text="『あ、あああっ‥‥！？』"
		   voices="nanako00160"/>
		<msg @l="509" char_id="-1" frame_id="-1" name="" text="ぞわり、と奈那子の中を何かが這いずる。"
		   voices=""/>
		<msg @l="510" char_id="-1" frame_id="-1" name=""
		   text="身体の芯から沸き出るような甘い鈍い痺れが、瞬く間に理性を蝕んでいく。" voices=""/>
		<msg @l="512" char_id="3" frame_id="-1" name="奈那子" text="『なに‥‥‥これ‥‥‥‥‥。』"
		   voices="nanako00170"/>
		<msg @l="514" char_id="-1" frame_id="-1" name="熊野"
		   text="『本来ならたっぷりと犯してやる所だが、今はあの娘の口封じの方が大事なのでな。』" voices=""/>
		<msg @l="516" char_id="3" frame_id="-1" name="奈那子" text="『んんっ‥‥‥ふ、ああっっ！』"
		   voices="nanako00180"/>
		<msg @l="518" char_id="-1" frame_id="-1" name="" text="熊野に奈那子は手を伸ばそうとした。"
		   voices=""/>
		<msg @l="519" char_id="-1" frame_id="-1" name=""
		   text="が、奈那子の意思とは裏腹に、手は胸を揉みしだき、下着越しに秘唇を擦っている。" voices=""/>
		<msg @l="520" char_id="-1" frame_id="-1" name=""
		   text="未知の感覚に翻弄される奈那子にとっては十分すぎる刺激だった。" voices=""/>
		<msg @l="521" char_id="-1" frame_id="-1" name=""
		   text="そこからより大きい快楽を求める様になるまでは、さほど時間を必要としなかった。" voices=""/>
		<msg @l="522" char_id="-1" frame_id="-1" name=""
		   text="服の上からでも判るほどに膨らんだ乳首を摘まみ上げ、秘唇の方も対象を淫核へと移る。" voices=""/>
		<msg @l="523" char_id="-1" frame_id="-1" name=""
		   text="指先が乳首を転がす度に甘く痺れ、押し潰された淫核の真下の秘唇からは蜜が溢れ出し薄布を湿らせる。" voices=""/>
		<msg @l="525" char_id="3" frame_id="-1" name="奈那子" text="『ああ‥‥‥あっ、あっ‥‥‥‥。』"
		   voices="nanako00190"/>
		<msg @l="527" char_id="-1" frame_id="-1" name=""
		   text="秘唇を擦り上げ、指先が淫核に触れる度に、奈那子は足を突っ張り、腰が宙を浮く。" voices=""/>
		<msg @l="528" char_id="-1" frame_id="-1" name=""
		   text="瞳は虚ろになり、半開きの口端からは涎が垂れる。" voices=""/>
		<msg @l="529" char_id="-1" frame_id="-1" name=""
		   text="止まることのない自分の指に翻弄され、頬を染め、熱い吐息を吐く。" voices=""/>
		<msg @l="531" char_id="-1" frame_id="-1" name="熊野"
		   text="『小娘は小娘らしくそこで自分を慰めていろ。』" voices=""/>
		<msg @l="533" char_id="-1" frame_id="-1" name="熊野"
		   text="『もう一人の娘を捕まえたら一緒に可愛がってやる。ククク。』" voices=""/>
		<msg @l="535" char_id="-1" frame_id="-1" name=""
		   text="熊野は奈那子をそのままに、廃道へと歩みを進める。" voices=""/>
		<clear @l="538" class="all"/>
		<msgshow @l="540" show="true"/>
		<msg @l="542" char_id="3" frame_id="-1" name="奈那子"
		   text="『んぅっ‥‥‥美‥‥帆‥‥‥‥‥逃げて‥‥‥‥‥。』" voices="nanako00200"/>
		<msg @l="544" char_id="-1" frame_id="-1" name=""
		   text="脳が蕩けていくのが分かっていても、逃れられない甘い痺れに身を委ねてしまう。" voices=""/>
		<msg @l="545" char_id="-1" frame_id="-1" name=""
		   text="そんな状態でも奈那子は美帆の名を呟いていた。" voices=""/>
		<msg @l="546" char_id="-1" frame_id="-1" name="" text="ただ‥‥美帆の無事を祈って‥‥。"
		   voices=""/>
		<clear @l="549" class="all"/>
		<stopbgm @l="551" fadeout="1000"/>
		<wait @l="553" time="1000"/>
		<end_scene @l="556"/>
		<wait_chgmv/>
		<bg @l="559" src="bg22_1"/>
		<char @l="561" id="miho" pos="auto" src="miho115"/>
		<bgm @l="563" src="bgm16" volume="1."/>
		<msg @l="565" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="567" char_id="-1" frame_id="-1" name=""
		   text="何処まで続くか分からない長い道を懸命に走り続けた。" voices=""/>
		<msg @l="568" char_id="-1" frame_id="-1" name=""
		   text="一歩足を踏み出すたびに埃が舞い上がるような場所である。" voices=""/>
		<msg @l="570" char_id="0" frame_id="-1" name="美帆" text="(奈那子ちゃん‥‥大丈夫かな)"
		   voices=""/>
		<msg @l="572" char_id="-1" frame_id="-1" name="" text="立ち止まり、いま来た道を振り返る。"
		   voices=""/>
		<msg @l="573" char_id="-1" frame_id="-1" name="" text="もう、かなり奥まで来てしまった。"
		   voices=""/>
		<msg @l="574" char_id="-1" frame_id="-1" name=""
		   text="今、戻ったとしても‥‥何が出来るのだろうか？" voices=""/>
		<msg @l="576" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="578" char_id="0" frame_id="-1" name="美帆"
		   text="(‥‥今はここから出ることだけ考えよう)" voices=""/>
		<msg @l="580" char_id="0" frame_id="-1" name="美帆"
		   text="(それが‥‥‥玲さんと、奈那子ちゃんの「願い」なら‥‥‥‥)" voices=""/>
		<clear @l="583" class="all"/>
		<wait_chgmv/>
		<bg @l="586" src="bg22_2"/>
		<msg @l="588" char_id="0" frame_id="-1" name="美帆" text="(‥‥道が二手に分かれてる)"
		   voices=""/>
		<msg @l="590" char_id="-1" frame_id="-1" name="" text="道の途中に壁が崩れて出来た脇道がある。"
		   voices=""/>
		<msg @l="591" char_id="-1" frame_id="-1" name="" text="一応‥‥その先にも道はありそうな感じだ。"
		   voices=""/>
		<wait_chgmv/>
		<bg @l="594" src="bg22_1"/>
		<msg @l="596" char_id="-1" frame_id="-1" name=""
		   text="脇道を入って暫く進むと、先程と同じ様相をした道が再び眼前に続く。" voices=""/>
		<msg @l="598" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<call @l="601" target="EventLabel_0@3drpg"/>
		<goto @l="604" cond="!(f._3d_exodus&#32;==&#32;0)&#13;&#10;"
		   label="TempLabel_293"/>
		<goto @l="607" label="EventLabel_147"/>
		<goto @l="610" label="TempLabel_294"/>
		<label @l="611" id="TempLabel_293"/>
		<goto @l="615" label="EventLabel_148"/>
		<label @l="618" id="TempLabel_294"/>
		<label @l="622" id="EventLabel_147"/>
		<wait_chgmv/>
		<bg @l="625" src="bg22_5"/>
		<msg @l="626" char_id="-1" frame_id="-1" name="人影" text="『‥‥‥‥。』" voices=""/>
		<stopbgm @l="629" fadeout="1000"/>
		<char @l="631" id="miho" pos="auto" src="miho114"/>
		<msg @l="633" char_id="0" frame_id="-1" name="美帆" text="『誰っ？！‥‥誰かそこにいるの！？』"
		   voices=""/>
		<clear @l="636" class="char"/>
		<char @l="638" id="miho" pos="left" src="miho014"/>
		<char @l="640" id="shiny" pos="right" src="shinya010"/>
		<msg @l="642" char_id="-1" frame_id="-1" name="真弥" text="『‥‥‥‥。』" voices=""/>
		<msg @l="644" char_id="0" frame_id="-1" name="美帆" text="『奈那子ちゃんの‥‥‥‥お兄さん。』"
		   voices=""/>
		<char @l="647" id="shiny" pos="right" src="shinya017"/>
		<bgm @l="649" src="bgm12" volume="1."/>
		<msg @l="651" char_id="-1" frame_id="-1" name="真弥" text="『お前か‥‥‥早く行け。』"
		   voices=""/>
		<char @l="654" id="miho" pos="left" src="miho115"/>
		<msg @l="656" char_id="0" frame_id="-1" name="美帆"
		   text="『あ、あのっ！‥‥わ、私を助ける為に奈那子ちゃんが残って！‥‥もしかしたら奈那子ちゃんが‥奈那子ちゃんが‥‥‥』" voices=""/>
		<char @l="659" id="shiny" pos="right" src="shinya010"/>
		<msg @l="661" char_id="-1" frame_id="-1" name="真弥" text="『‥‥‥‥。』" voices=""/>
		<char @l="664" id="miho" pos="left" src="miho015"/>
		<msg @l="666" char_id="0" frame_id="-1" name="美帆"
		   text="『ルームメートの先輩も私を助ける為に‥‥！』" voices=""/>
		<msg @l="668" char_id="0" frame_id="-1" name="美帆"
		   text="『お願いします！&#32;みんなを助けて下さい！&#32;助けを‥‥助けを呼んで下さい！！』" voices=""/>
		<char @l="671" id="shiny" pos="right" src="shinya017"/>
		<msg @l="673" char_id="-1" frame_id="-1" name="真弥"
		   text="『安心しろ‥‥‥‥奈那子は俺が守る。だが‥‥町の者達は既に因果に巻き込まれてしまった‥‥我らの所為だ‥‥‥すまん‥‥‥。』"
		   voices=""/>
		<msg @l="675" char_id="0" frame_id="-1" name="美帆" text="『奈那子ちゃんのお兄さん‥‥‥。』"
		   voices=""/>
		<char @l="678" id="shiny" pos="right" src="shinya010"/>
		<msg @l="680" char_id="-1" frame_id="-1" name="真弥" text="『‥‥‥‥。』" voices=""/>
		<msg @l="682" char_id="-1" frame_id="-1" name=""
		   text="ふと、奈那子ちゃんのお兄さんは私の肩越しに廃道を見据える。" voices=""/>
		<msg @l="683" char_id="-1" frame_id="-1" name=""
		   text="闇に続く道を‥‥いや、その先の目には映らない何かを見透かすように。" voices=""/>
		<msg @l="685" char_id="-1" frame_id="-1" name="真弥" text="『早く行け‥‥‥時間が無い。』"
		   voices=""/>
		<char @l="688" id="miho" pos="left" src="miho115"/>
		<msg @l="690" char_id="0" frame_id="-1" name="美帆" text="『でもっ！』" voices=""/>
		<char @l="693" id="shiny" pos="right" src="shinya210"/>
		<msg @l="695" char_id="-1" frame_id="-1" name="真弥" text="『‥‥‥‥‥くれ。』"
		   voices=""/>
		<msg @l="697" char_id="0" frame_id="-1" name="美帆" text="『？』" voices=""/>
		<msg @l="699" char_id="-1" frame_id="-1" name="真弥"
		   text="『‥‥‥出来れば‥‥これからも奈那子の友達でいてやってくれ‥‥‥頼む。』" voices=""/>
		<msg @l="700" char_id="0" frame_id="-1" name="美帆" text="『あ‥‥』" voices=""/>
		<msg @l="702" char_id="-1" frame_id="-1" name="真弥" text="『さあ、早く行け。』"
		   voices=""/>
		<msg @l="704" char_id="0" frame_id="-1" name="美帆" text="『‥‥！』" voices=""/>
		<clear @l="707" layer="miho"/>
		<msg @l="709" char_id="-1" frame_id="-1" name=""
		   text="奈那子ちゃんのお兄さんは私との話を打ち切るように私を押しのけ、廃道を睨む。" voices=""/>
		<msg @l="710" char_id="-1" frame_id="-1" name=""
		   text="その背に掛ける言葉が思い浮かばず、私は言葉に従った。" voices=""/>
		<clear @l="713" class="char"/>
		<wait_chgmv/>
		<bg @l="715" src="bg22_3"/>
		<char @l="717" id="miho" pos="auto" src="miho115"/>
		<msg @l="719" char_id="-1" frame_id="-1" name=""
		   text="暫く歩いていると、ようやく出口にたどり着いた。" voices=""/>
		<msg @l="721" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="723" char_id="0" frame_id="-1" name="美帆" text="(ここが出口‥‥)" voices=""/>
		<char @l="726" id="miho" pos="auto" src="miho015"/>
		<msg @l="728" char_id="0" frame_id="-1" name="美帆"
		   text="(ここを出れば南総町から逃げることが出来る‥‥‥)" voices=""/>
		<stopbgm @l="731" fadeout="1000"/>
		<msg @l="733" char_id="-1" frame_id="-1" name=""
		   text="ふらり、ふらりと‥‥私は光が差す出口へと向かって歩む。" voices=""/>
		<begin_trans @l="736" time="500"/>
		<clear @l="737" layer="cutin_f"/>
		<clear @l="738" layer="cutin"/>
		<end_trans @l="739"/>
		<clear @l="741" class="char"/>
		<msgshow @l="743" show="false"/>
		<wait_chgmv/>
		<bg @l="745" src="white" time="10000"/>
		<clear @l="747" class="ev"/>
		<begin_trans @l="750" time="500"/>
		<clear @l="751" layer="cutin_f"/>
		<clear @l="752" layer="cutin"/>
		<end_trans @l="753"/>
		<clear @l="755" class="char"/>
		<msgshow @l="757" show="false"/>
		<wait_chgmv/>
		<bg @l="759" src="white"/>
		<clear @l="761" class="ev"/>
		<msg @l="763" char_id="-1" frame_id="-1" name="" text="‥‥‥‥‥‥‥‥‥‥‥‥。"
		   voices=""/>
		<msg @l="764" char_id="-1" frame_id="-1" name="" text="‥‥‥‥‥‥‥‥。" voices=""/>
		<msg @l="765" char_id="-1" frame_id="-1" name="" text="‥‥‥‥。" voices=""/>
		<label @l="768" id="chart_line57"/>
		<wait_chgmv/>
		<ev @l="771" src="ev-053y1y2"/>
		<bgm @l="773" src="bgm20" volume="1."/>
		<msg @l="775" char_id="-1" frame_id="-1" name=""
		   text="夕陽に染まる南総町を二つの人影が見つめている。" voices=""/>
		<msg @l="776" char_id="-1" frame_id="-1" name=""
		   text="言葉を発することも無く佇む二人の間を、柔らかな風が撫でるように吹き抜けていく。" voices=""/>
		<msg @l="777" char_id="-1" frame_id="-1" name="" text="終わりを‥‥‥告げるように。"
		   voices=""/>
		<msg @l="780" char_id="-1" frame_id="-1" name="男" text="『‥‥‥‥。』" voices=""/>
		<wait_chgmv/>
		<ev @l="783" src="ev-053y1"/>
		<msg @l="785" char_id="3" frame_id="-1" name="女の子" text="『‥‥‥‥。』" voices=""/>
		<wait_chgmv/>
		<ev @l="789" src="ev-053"/>
		<begin_trans @l="792" time="500"/>
		<clear @l="793" layer="cutin_f"/>
		<clear @l="794" layer="cutin"/>
		<end_trans @l="795"/>
		<clear @l="797" class="char"/>
		<msgshow @l="799" show="false"/>
		<wait_chgmv/>
		<bg @l="801" src="white" time="3000"/>
		<clear @l="803" class="ev"/>
		<wait_chgmv/>
		<bg @l="805" src="white"/>
		<call @l="808" target="EventLabel_51@ending13"/>
		<return @l="809" value="0&#13;&#10;"/>
		<label @l="812" id="EventLabel_148"/>
		<char @l="815" id="miho" pos="auto" src="miho115"/>
		<bgm @l="818" src="bgm13" volume="1."/>
		<msg @l="820" char_id="-1" frame_id="-1" name="声"
		   text="『フハハハハッ！&#32;ようやく追いついたな！』" voices=""/>
		<msg @l="822" char_id="0" frame_id="-1" name="美帆" text="『ヒッ‥‥！』" voices=""/>
		<clear @l="825" class="char"/>
		<char @l="827" id="miho" pos="left" src="miho115"/>
		<char @l="829" id="kuma" pos="right" src="kuma018"/>
		<msg @l="831" char_id="-1" frame_id="-1" name="熊野"
		   text="『まったく‥‥手間をかけさせよって。』" voices=""/>
		<msg @l="833" char_id="-1" frame_id="-1" name=""
		   text="突如、黒い影が頭の上を越したかと思うと、目の前に紅い瞳を爛々と輝かせた熊野が立っていた。" voices=""/>
		<msg @l="834" char_id="-1" frame_id="-1" name=""
		   text="だが、いつもの熊野よりも一回り大きく感じとられた。" voices=""/>
		<msg @l="836" char_id="-1" frame_id="-1" name="熊野"
		   text="『この俺が薬まで使わねばならなくなるとはな‥‥本来なら、殺すところだぞ。』" voices=""/>
		<msg @l="837" char_id="0" frame_id="-1" name="美帆"
		   text="『そ、そんな‥‥‥もう追いついたなんて‥‥‥‥。』" voices=""/>
		<char @l="840" id="miho" pos="left" src="miho114"/>
		<msg @l="842" char_id="0" frame_id="-1" name="美帆" text="『な、奈那子ちゃんは‥‥‥彼女は！？』"
		   voices=""/>
		<msg @l="844" char_id="-1" frame_id="-1" name="熊野"
		   text="『ああ、あの小娘なら今頃は淫欲の虜となっているハズだ。』" voices=""/>
		<char @l="847" id="miho" pos="left" src="miho115"/>
		<msg @l="849" char_id="0" frame_id="-1" name="美帆" text="『え‥‥？。』" voices=""/>
		<msg @l="851" char_id="-1" frame_id="-1" name="熊野"
		   text="『少しはできるようだったが、所詮は小娘。半刻とせずに色狂いとなるのではないか？』" voices=""/>
		<char @l="854" id="miho" pos="left" src="miho015"/>
		<msg @l="856" char_id="0" frame_id="-1" name="美帆" text="『そんなっ‥‥。』" voices=""/>
		<msg @l="858" char_id="-1" frame_id="-1" name="熊野"
		   text="『安心しろ、お前もすぐにあの小娘と同じ世界へいざなってくれる。』" voices=""/>
		<msg @l="860" char_id="-1" frame_id="-1" name=""
		   text="そう言って熊野は一歩、また一歩とゆっくりと近づいて来る。" voices=""/>
		<msg @l="862" char_id="0" frame_id="-1" name="美帆"
		   text="『いやぁ‥‥‥こ、来ないで‥‥‥‥‥。』" voices=""/>
		<msg @l="864" char_id="-1" frame_id="-1" name="熊野" text="『ククッ‥‥観念するがいい。』"
		   voices=""/>
		<msg @l="866" char_id="0" frame_id="-1" name="美帆" text="『いやっ、いやああああああああっ！！』"
		   voices="miho10750"/>
		<clear @l="869" class="all"/>
		<stopbgm @l="871" fadeout="1000"/>
		<wait @l="873" time="6000"/>
		<msgshow @l="876" show="true"/>
		<call @l="880" target="EventLabel_55@ex_ending01"/>
		<return @l="881" value="0&#13;&#10;"/>
		<return @l="884" value=""/>
	</code>
</xscript>
