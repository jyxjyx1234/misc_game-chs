<?xml version="1.0" encoding="utf-8"?>
<xscript>
	<debug editor="&quot;C:\Program&#32;Files&#32;(x86)\sakura\sakura.exe&quot;&#32;&quot;%src%&quot;&#32;-Y=%line%"
	   src="D:\シロップ\町ぐるみの罠＋汚された夏セット版\汚された夏\完成データ\汚された夏\script\text\common_root02.txt"/>
	<code>
		<label @l="17" id="EventLabel_23"/>
		<description @l="21" text="日常生活"/>
		<eval @l="23" expr="f.numDay=2&#13;&#10;"/>
		<msgshow @l="25" show="false"/>
		<wait_chgmv/>
		<bg @l="27" src="day02" time="2000"/>
		<wait @l="29" time="500"/>
		<wait_chgmv/>
		<bg @l="31" src="black" time="2000"/>
		<msgshow @l="33" show="true"/>
		<wait_chgmv/>
		<bg @l="37" src="bg21m1"/>
		<bgm @l="41" src="bgm02" volume="1."/>
		<char @l="45" id="miho" pos="auto" src="miho110"/>
		<msg @l="47" char_id="-1" frame_id="-1" name="" text="―――朝。" voices=""/>
		<msg @l="48" char_id="-1" frame_id="-1" name=""
		   text="私は停留所にて、昨日よりも一本遅い電車へと乗り込もうとしていた。" voices=""/>
		<msg @l="49" char_id="-1" frame_id="-1" name="" text="もちろん痴漢に遭わないようにする為だ。"
		   voices=""/>
		<msg @l="51" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="53" char_id="-1" frame_id="-1" name=""
		   text="停留所には大学行きの電車を利用する学生たちで長蛇の列が出来ている。" voices=""/>
		<msg @l="54" char_id="-1" frame_id="-1" name=""
		   text="私はその長蛇の真ん中辺りで、乗り込む順番を延々と待たされていた。" voices=""/>
		<msg @l="56" char_id="0" frame_id="-1" name="美帆" text="(予想通り‥‥人、いっぱいだなぁ)"
		   voices=""/>
		<msg @l="58" char_id="-1" frame_id="-1" name="" text="これが一限目の講義に間に合う最後の電車だ。"
		   voices=""/>
		<msg @l="59" char_id="-1" frame_id="-1" name=""
		   text="今日は普段から使っている電車と比べて１．５倍くらいの人数が並んでいる。" voices=""/>
		<msg @l="60" char_id="-1" frame_id="-1" name=""
		   text="普段であれば絶対乗らないんだけど、痴漢に遭わないで済むと思えばまだマシだ。" voices=""/>
		<clear @l="66" class="all"/>
		<label @l="69" id="event_scene05_2"/>
		<msg @l="71" char_id="-1" frame_id="-1" name="アナウンス"
		   text="『えー、大変混み合っております‥‥。』" voices=""/>
		<msg @l="73" char_id="-1" frame_id="-1" name="アナウンス"
		   text="『途中で立ち止まらず車内中ほどまでお進みください。』" voices=""/>
		<msg @l="75" char_id="-1" frame_id="-1" name=""
		   text="ようやく行列が流れ、私も押し込まれるように車内へと乗り込んだ。" voices=""/>
		<msg @l="76" char_id="-1" frame_id="-1" name=""
		   text="同じ事を何度も繰り返している車内アナウンスが、流れ続ける。" voices=""/>
		<msg @l="78" char_id="0" frame_id="-1" name="美帆"
		   text="(と、とにかく何処か邪魔にならない所を探さなきゃ‥‥)" voices="miho00490"/>
		<msg @l="80" char_id="-1" frame_id="-1" name=""
		   text="人の海‥‥と言うほどではないけど、混雑している事に変わりはない。" voices=""/>
		<msg @l="81" char_id="-1" frame_id="-1" name=""
		   text="私は流れを止めてしまわないように奥へと身体を滑り込ませて行き、途中見つけた手すりに必死の思いでしがみついた‥‥。" voices=""/>
		<se @l="85" buf="3" loop="true" src="電車走行中" volume="1."/>
		<eval @l="88" expr="s.event5flag=1&#13;&#10;"/>
		<wait_chgmv/>
		<ev @l="92" src="ev-005"/>
		<bgm @l="94" src="bgm07" volume="1."/>
		<msg @l="96" char_id="0" frame_id="-1" name="美帆" text="『‥‥はぁ。』"
		   voices="miho00500"/>
		<msg @l="98" char_id="-1" frame_id="-1" name=""
		   text="電車が走り出してすぐ、私は深いため息をつく。" voices=""/>
		<msg @l="99" char_id="-1" frame_id="-1" name=""
		   text="ある程度の覚悟していたけど、やはりこの混雑はきつい。" voices=""/>
		<msg @l="101" char_id="0" frame_id="-1" name="美帆"
		   text="(一限から講義のある日は毎回この電車を使わなくちゃいけないかと思うと気が重いなぁ‥‥)" voices="miho00510"/>
		<msg @l="103" char_id="0" frame_id="-1" name="美帆"
		   text="(でも、それで痴漢から身を守れるなら楽なモノだって思わないと)" voices="miho00520"/>
		<msg @l="105" char_id="-1" frame_id="-1" name=""
		   text="重く圧し掛かる憂鬱を振り払うように、私は自分に言い聞かせる。" voices=""/>
		<msg @l="106" char_id="-1" frame_id="-1" name=""
		   text="そうでもしなくちゃ、この混雑の中で無事に生き残る自信が無い。" voices=""/>
		<msg @l="107" char_id="-1" frame_id="-1" name=""
		   text="いや‥‥満員電車ひとつで生き死にを語るのは大げさかな？と思うけれど、私にしてみればこの混雑ぶりは命に関わりそうな気がしてくる。"
		   voices=""/>
		<msg @l="108" char_id="-1" frame_id="-1" name=""
		   text="‥‥下手したらショック死とかするんじゃないかと思ってしまう。" voices=""/>
		<msg @l="110" char_id="0" frame_id="-1" name="美帆"
		   text="(なんて‥‥実際はそこまでじゃないだろうけど)" voices="miho00530"/>
		<msg @l="112" char_id="0" frame_id="-1" name="美帆"
		   text="(でも、そのくらい苦手なんだから仕方が無い――――きゃっ！)" voices="miho00540"/>
		<se @l="119" buf="1" src="電車の車輪が激しくこすれる音" volume="1."/>
		<msg @l="121" char_id="-1" frame_id="-1" name="" text="急カーブに差し掛かったのだろうか。"
		   voices=""/>
		<msg @l="122" char_id="-1" frame_id="-1" name=""
		   text="勢い良く車体が揺れて一瞬だけ車内がざわめく。" voices=""/>
		<msg @l="127" char_id="0" frame_id="-1" name="美帆"
		   text="(うあ‥‥ここ、いつも揺れるんだよね‥‥‥)" voices="miho00550"/>
		<msg @l="129" char_id="-1" frame_id="-1" name=""
		   text="車体が傾くたび、私は必死で手すりにつかまって耐え続けていた。" voices=""/>
		<msg @l="130" char_id="-1" frame_id="-1" name=""
		   text="揺れるたびに前後左右‥‥私の目の前は扉だから正確には後ろと左右に居る人の肩や荷物が無遠慮にぶつかってくる。" voices=""/>
		<msg @l="135" char_id="0" frame_id="-1" name="美帆"
		   text="(いたっ‥‥いたたっ‥‥‥‥もう、ちょっとは揺れに耐えてよ～)" voices="miho00560"/>
		<msg @l="140" char_id="-1" frame_id="-1" name=""
		   text="心の中で悲痛な叫びをあげながら、私は懸命に体勢を維持し続ける。" voices=""/>
		<stopbgm @l="144" fadeout="1000"/>
		<msg @l="146" char_id="0" frame_id="-1" name="美帆" text="(‥‥ん？)"
		   voices="miho00570"/>
		<msg @l="148" char_id="-1" frame_id="-1" name=""
		   text="腰のあたりに感じるふとした違和感に私は眉をひそめる。" voices=""/>
		<msg @l="149" char_id="-1" frame_id="-1" name=""
		   text="スカート越しに感じる、まるで這い回るような手の感触。" voices=""/>
		<bgm @l="153" src="bgm15" volume="1."/>
		<wait_chgmv/>
		<ev @l="157" src="ev-005ax1"/>
		<description @l="160" text="二度目の痴漢"/>
		<msg @l="162" char_id="0" frame_id="-1" name="美帆" text="(うそ‥‥‥なんでっ！？)"
		   voices="miho00580"/>
		<msg @l="164" char_id="-1" frame_id="-1" name="" text="余りの気味の悪さに思わず身体がこわばる。"
		   voices=""/>
		<msg @l="165" char_id="-1" frame_id="-1" name="" text="昨日と違う電車に乗ったのに‥‥。"
		   voices=""/>
		<msg @l="166" char_id="-1" frame_id="-1" name=""
		   text="相変わらず男性の方が多いとはいえ、昨日とは違い女性だって同じくらいはいるのに‥‥。" voices=""/>
		<msg @l="168" char_id="0" frame_id="-1" name="美帆"
		   text="(どうしてまた痴漢なんかに遭っちゃうのよ‥‥)" voices="miho00590"/>
		<msg @l="170" char_id="-1" frame_id="-1" name=""
		   text="白石先輩が言うように、私はやはり狙われやすいのだろうか‥‥？" voices=""/>
		<msg @l="174" async="true" char_id="-1" frame_id="-1" name=""
		   text="二度目の痴漢に、私は‥‥？" voices=""/>
		<select @l="175">
			<menu @l="179" label="EventLabel_24" text="抵抗する"/>
			<menu @l="182" label="EventLabel_25" text="我慢する"/>
		</select>
		<label @l="191" id="EventLabel_24"/>
		<msg @l="194" char_id="-1" frame_id="-1" name=""
		   text="いかに引っ込み思案な私でも、このまま黙って痴漢行為に身を委ねているつもりはない。" voices=""/>
		<msg @l="195" char_id="-1" frame_id="-1" name=""
		   text="何せ、痴漢を避ける為に、乗りたくない混雑した二本目の電車を選んだくらいなんだから。" voices=""/>
		<msg @l="196" char_id="-1" frame_id="-1" name=""
		   text="これで痴漢のなすがままになったら、何の為に電車を変えたか解らない。" voices=""/>
		<msg @l="198" char_id="0" frame_id="-1" name="美帆"
		   text="(とにかく腰の手をどうにかしないと‥‥)" voices="miho00600"/>
		<msg @l="200" char_id="-1" frame_id="-1" name=""
		   text="私はもぞもぞと身体をよじり、腰に這う痴漢の手をどうにか除けようとする。" voices=""/>
		<msg @l="201" char_id="-1" frame_id="-1" name=""
		   text="しかしその程度の抵抗は痴漢にとっては大した抵抗ではないようで、何とか引き剥がしたと思ってもすぐにまとわりついてくる。"
		   voices=""/>
		<msg @l="203" char_id="0" frame_id="-1" name="美帆" text="(もう‥‥はやくあきらめてよ‥‥‥)"
		   voices="miho00610"/>
		<msg @l="205" char_id="-1" frame_id="-1" name=""
		   text="私は必死で抵抗するけれど、痴漢は一向に諦めようとしてくれない。" voices=""/>
		<msg @l="206" char_id="-1" frame_id="-1" name=""
		   text="それどころか‥‥抵抗すればするほどに執拗さが増している気さえする。" voices=""/>
		<msg @l="208" char_id="0" frame_id="-1" name="美帆"
		   text="(うぅ、なんでこんな事に熱心になれるのかしら‥‥)" voices="miho00620"/>
		<msg @l="210" char_id="-1" frame_id="-1" name=""
		   text="もぞもぞと身をよじりながら、私は両目にうっすらと涙を溜める。" voices=""/>
		<msg @l="211" char_id="-1" frame_id="-1" name=""
		   text="痴漢の手は相変わらず私の腰を撫で回しており、ともすればお尻の方へ指先を伸ばす機会を伺っているかのようだ。" voices=""/>
		<msg @l="212" char_id="-1" frame_id="-1" name=""
		   text="かといって身体をよじる以上の抵抗が出来るわけでもなく、" voices=""/>
		<msg @l="213" char_id="-1" frame_id="-1" name=""
		   text="ましてこの混雑ぶりでは逃げ出すことも出来ない。" voices=""/>
		<msg @l="215" char_id="0" frame_id="-1" name="美帆" text="(この‥‥‥いい加減にしてっ)"
		   voices="miho00630"/>
		<msg @l="217" char_id="-1" frame_id="-1" name=""
		   text="あまりの混雑さと痴漢のしつこさに苛立ちが募ったその矢先、これ以上は我慢の限界とばかりに私は半ば強引に身体を捻って、痴漢の手を跳ね除けようとする。"
		   voices=""/>
		<msg @l="218" char_id="-1" frame_id="-1" name="" text="その瞬間――――。" voices=""/>
		<stopbgm @l="222" fadeout="1000"/>
		<msg @l="224" char_id="-1" frame_id="-1" name="痴漢" text="『ぐあっ。』" voices=""/>
		<msg @l="226" char_id="-1" frame_id="-1" name="" text="跳ね除けた時の角度が悪かったのだろう。"
		   voices=""/>
		<msg @l="227" char_id="-1" frame_id="-1" name=""
		   text="痴漢をしていた男の手が、私の腰に押されて隣の乗客が肩からかけていたバッグのキーホルダーへと引っかかった。" voices=""/>
		<msg @l="228" char_id="-1" frame_id="-1" name="" text="あれは‥‥かなり痛いハズだ。"
		   voices=""/>
		<msg @l="230" char_id="0" frame_id="-1" name="美帆" text="(‥‥ご、ごめんなさい‥‥‥‥)"
		   voices="miho00640"/>
		<msg @l="232" char_id="-1" frame_id="-1" name=""
		   text="私は心の中でそっと謝って、周囲の視線から逃れるように小さくなる。" voices=""/>
		<msg @l="233" char_id="-1" frame_id="-1" name=""
		   text="そうして大学につくまでの間‥‥結局、痴漢の手は伸びて来なかった。" voices=""/>
		<stopse @l="237" buf="3"/>
		<clear @l="242" class="all"/>
		<msgshow @l="244" show="true"/>
		<goto @l="247" label="EventLabel_26"/>
		<label @l="251" id="EventLabel_25"/>
		<msg @l="254" char_id="0" frame_id="-1" name="美帆"
		   text="(抵抗したくても‥‥これじゃ‥‥‥‥んっ、身動きとれない‥‥)" voices="miho00650"/>
		<msg @l="256" char_id="0" frame_id="-1" name="美帆"
		   text="(やっぱり‥‥我慢‥‥‥するしかないのかな‥‥‥‥‥)" voices="miho00660"/>
		<msg @l="258" char_id="-1" frame_id="-1" name="" text="今日は昨日にも増して車内が混雑している。"
		   voices=""/>
		<msg @l="259" char_id="-1" frame_id="-1" name=""
		   text="こんな中で抵抗しようにもせいぜい身をよじるので精一杯だ。" voices=""/>
		<msg @l="260" char_id="-1" frame_id="-1" name="" text="それに‥‥。" voices=""/>
		<msg @l="262" char_id="0" frame_id="-1" name="美帆"
		   text="(こんな満員の中で騒いだら、それこそ変な噂になっちゃう‥‥)" voices="miho00670"/>
		<msg @l="264" char_id="-1" frame_id="-1" name=""
		   text="私はぎゅっと目をつむり、腰を這いずり回る気持ちの悪さを懸命に我慢する。" voices=""/>
		<msg @l="266" char_id="-1" frame_id="-1" name="" text="むにゅ。" voices=""/>
		<msg @l="268" char_id="-1" frame_id="-1" name=""
		   text="痴漢は臀部の量感を愉しむかのように、持ち上げては下げて若さが持つ弾力を充分に堪能していた。" voices=""/>
		<msg @l="270" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』"
		   voices="miho00420"/>
		<wait_chgmv/>
		<ev @l="275" src="ev-005ax2y1"/>
		<msg @l="277" char_id="-1" frame_id="-1" name=""
		   text="そうして腰に蠢くムカデのような手に耐えているうち、それは胸の方まで這い昇って来て、ブラの上から胸をいきなり鷲づかみにした。"
		   voices=""/>
		<msg @l="279" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥っ‥‥‥。』"
		   voices="miho09930"/>
		<msg @l="281" char_id="-1" frame_id="-1" name=""
		   text="男を知らない処女の胸は、乱暴につかまれた痛みと、その蠢く生き物の気持ち悪さに、うっすらと汗ばむ。" voices=""/>
		<msg @l="282" char_id="-1" frame_id="-1" name=""
		   text="私はその恥辱な行為に息を殺して耐えることしか出来なかった。" voices=""/>
		<msg @l="283" char_id="-1" frame_id="-1" name=""
		   text="まだ電車は駅を出たばかりだから‥‥‥‥‥‥。" voices=""/>
		<msg @l="284" char_id="-1" frame_id="-1" name=""
		   text="あと３０分近くもこの気持ち悪さに耐えなければならないのかと思うと気が遠くなってくる。" voices=""/>
		<msg @l="285" char_id="-1" frame_id="-1" name="" text="さわ、さわ、さわ。" voices=""/>
		<msg @l="287" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥ぁ‥‥。』"
		   voices="miho00680"/>
		<msg @l="289" char_id="-1" frame_id="-1" name=""
		   text="痴漢はもう一方の手を鮮やかな双球で形成されたお尻の方へと動く。" voices=""/>
		<msg @l="290" char_id="-1" frame_id="-1" name=""
		   text="その瞬間、微かに恥ずかしい声を漏らしてしまい、私は頬から耳まで真っ赤になり、慌てて口を強く閉じた。" voices=""/>
		<goto @l="293" cond="!(f.痴漢flag&#32;==&#32;1)&#13;&#10;"
		   label="TempLabel_158"/>
		<msg @l="295" char_id="-1" frame_id="-1" name="痴漢"
		   text="『今日も無抵抗で通すつもりかね？&#32;殊勝なことだな。』" voices=""/>
		<msg @l="300" char_id="0" frame_id="-1" name="美帆" text="『‥‥！？』"
		   voices="miho00690"/>
		<msg @l="302" char_id="-1" frame_id="-1" name="" text="耳元に囁かれた不敵な声。"
		   voices=""/>
		<msg @l="303" char_id="-1" frame_id="-1" name=""
		   text="それは忘れもしない、昨日の痴漢の声と同じだった。" voices=""/>
		<msg @l="305" char_id="0" frame_id="-1" name="美帆" text="『な‥‥なんで‥‥‥‥？』"
		   voices="miho00700"/>
		<msg @l="307" char_id="-1" frame_id="-1" name="痴漢"
		   text="『続きを楽しみにしていろと、言わなかったかな‥‥？』" voices=""/>
		<msg @l="309" char_id="-1" frame_id="-1" name=""
		   text="痴漢は下品な投げかけをしながら、実りきった桃尻を撫で回していた指でパンティ生地を引き絞り、グイッと上に引き上げた。"
		   voices=""/>
		<msg @l="311" char_id="0" frame_id="-1" name="美帆" text="『んっ‥‥。』"
		   voices="miho10450"/>
		<msg @l="313" char_id="-1" frame_id="-1" name=""
		   text="フンドシのような１本の綱となったパンティが尻の谷間に食い込み、秘部を圧迫する。" voices=""/>
		<msg @l="314" char_id="-1" frame_id="-1" name="" text="その力により、女唇は見事に開ききった。"
		   voices=""/>
		<msg @l="316" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』"
		   voices="miho00420"/>
		<msg @l="318" char_id="-1" frame_id="-1" name="痴漢"
		   text="『くくくっ‥‥。下着が充分、陰部に食い込んでいるようだね。』" voices=""/>
		<msg @l="320" char_id="0" frame_id="-1" name="美帆" text="『‥‥！？』"
		   voices="miho00690"/>
		<wait_chgmv/>
		<ev @l="324" src="ev-005ax3y2"/>
		<msg @l="326" char_id="-1" frame_id="-1" name="" text="するっ。" voices=""/>
		<msg @l="327" char_id="-1" frame_id="-1" name=""
		   text="そう言って、痴漢はパンティを引き上げていた手をスカートの中へと潜り込ませる。" voices=""/>
		<msg @l="329" char_id="0" frame_id="-1" name="美帆" text="『くっ‥‥。』"
		   voices="miho00400"/>
		<msg @l="331" char_id="-1" frame_id="-1" name=""
		   text="まるで、自分にご褒美を与えるがように手を白い太股へ移動させた。" voices=""/>
		<msg @l="333" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』"
		   voices="miho00420"/>
		<msg @l="335" char_id="-1" frame_id="-1" name="" text="私はその感触に身体をビクッ、と震わせる。"
		   voices=""/>
		<msg @l="336" char_id="-1" frame_id="-1" name="" text="さわ、さわ、さわ。" voices=""/>
		<msg @l="338" char_id="-1" frame_id="-1" name="痴漢" text="『ふふっ、すべすべだな君の太股は。』"
		   voices=""/>
		<msg @l="341" char_id="-1" frame_id="-1" name=""
		   text="痴漢は恐怖に震える私の太股を、嬉しそうに上下にソロリソロリと撫でている。" voices=""/>
		<msg @l="342" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥ぅぁ‥‥。』"
		   voices="miho00430"/>
		<msg @l="344" char_id="-1" frame_id="-1" name="痴漢"
		   text="『ああっ‥‥、手に吸い付くようだ。素晴らしい‥‥。』" voices=""/>
		<msg @l="346" char_id="-1" frame_id="-1" name=""
		   text="痴漢が発する甘美の溜息をうなじに吹きかけられ、さらにドッと大粒の汗が浮かび上がった。" voices=""/>
		<msg @l="348" char_id="0" frame_id="-1" name="美帆" text="『や‥‥やめてください‥‥‥。』"
		   voices="miho00710"/>
		<msg @l="350" char_id="-1" frame_id="-1" name="痴漢"
		   text="『本当にやめて欲しいのかな。嫌なら大声をあげてみてはどうかね？" voices=""/>
		<msg @l="352" char_id="-1" frame_id="-1" name="" text="痴漢は、見透かしたようにそう言って笑う。"
		   voices=""/>
		<msg @l="354" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』"
		   voices="miho09880"/>
		<msg @l="356" char_id="-1" frame_id="-1" name=""
		   text="大声をあげれば確かに痴漢行為を中断させる事は出来るだろう。" voices=""/>
		<msg @l="357" char_id="-1" frame_id="-1" name=""
		   text="けれど、それでは他の乗客に自分が痴漢されている事を報せることになる。そして私の痴漢をされている恥ずかしい姿を見知らぬ人々の面前にさらけ出すことになってしまう。"
		   voices=""/>
		<msg @l="359" char_id="0" frame_id="-1" name="美帆" text="『大声なんて‥‥。』"
		   voices="miho00720"/>
		<msg @l="361" char_id="-1" frame_id="-1" name="痴漢"
		   text="『ほう、つまりキミは私のなすがままになるというわけだな。』" voices=""/>
		<msg @l="363" char_id="0" frame_id="-1" name="美帆" text="『そ、それは‥‥。』"
		   voices="miho00730"/>
		<msg @l="365" char_id="-1" frame_id="-1" name=""
		   text="もちろん痴漢のなすがままになるつもりなんてない。" voices=""/>
		<msg @l="366" char_id="-1" frame_id="-1" name=""
		   text="私はただ、痴漢をされていたと噂が立ってしまうこと、周りの大勢に恥ずかしい姿を見られてしまうことが嫌なだけだ。" voices=""/>
		<msg @l="367" char_id="-1" frame_id="-1" name="" text="なのに‥‥ハッキリと否定できない。"
		   voices=""/>
		<msg @l="368" char_id="-1" frame_id="-1" name=""
		   text="いまさら何を言ったところで、周囲の人に知られないよう痴漢行為に抵抗しない方を選んだという事実に何ら変わりはない‥‥。"
		   voices=""/>
		<msg @l="370" char_id="-1" frame_id="-1" name="痴漢"
		   text="『くくっ‥‥やはり、キミにはマゾの素質がある。』" voices=""/>
		<msg @l="372" char_id="-1" frame_id="-1" name=""
		   text="痴漢はなにやら一人で納得するようにつぶやくと、更に隙間なく身体を私へと密着させて、太股を撫で回していた手を内股に潜り込ませる。"
		   voices=""/>
		<msg @l="373" char_id="-1" frame_id="-1" name="" text="する、する、する。" voices=""/>
		<msg @l="375" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥っ‥‥‥。』"
		   voices="miho09930"/>
		<msg @l="377" char_id="-1" frame_id="-1" name=""
		   text="痴漢の人差し指と中指が太股の内側を上下に擦り始めた。" voices=""/>
		<msg @l="378" char_id="-1" frame_id="-1" name=""
		   text="白くみずみずしい内股の柔肌をなぞるように徐々に手を上にあげていく。" voices=""/>
		<msg @l="379" char_id="-1" frame_id="-1" name="" text="手を上に持って来ないで‥‥‥‥。"
		   voices=""/>
		<msg @l="380" char_id="-1" frame_id="-1" name=""
		   text="‥‥‥その願いもむなしく、下着の端に人差し指と中指が到達した。" voices=""/>
		<msg @l="381" char_id="-1" frame_id="-1" name="" text="ぎゅっっ。" voices=""/>
		<msg @l="382" char_id="-1" frame_id="-1" name=""
		   text="私は気持ち悪さに、手すりをつかむ力を一気に強める。" voices=""/>
		<msg @l="383" char_id="-1" frame_id="-1" name="" text="それでも、痴漢行為は続く。"
		   voices=""/>
		<msg @l="384" char_id="-1" frame_id="-1" name="" text="さわ、さわ。" voices=""/>
		<msg @l="386" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥ぅぁ‥‥。』"
		   voices="miho00430"/>
		<msg @l="388" char_id="-1" frame_id="-1" name=""
		   text="二本の指は先端でパンティラインをなぞりはじめた。そして次第に狙いを秘所へと移してくる。" voices=""/>
		<msg @l="389" char_id="-1" frame_id="-1" name=""
		   text="痴漢は一気に下着の中心に触れると、生地越しにアソコの割れ目に沿って指を這わせてきた。" voices=""/>
		<msg @l="391" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥ゃぁ‥‥。』"
		   voices="miho00740"/>
		<msg @l="393" char_id="-1" frame_id="-1" name=""
		   text="私はとっさに侵入を拒もうと足を強く閉じる。" voices=""/>
		<msg @l="394" char_id="-1" frame_id="-1" name=""
		   text="しかし痴漢は手を動かすのをやめようとはせず、むしろ「チャンス」とばかりにもう一方の手もスカートの中へと入れてきた。"
		   voices=""/>
		<msg @l="395" char_id="-1" frame_id="-1" name="" text="むにゅっ。" voices=""/>
		<msg @l="397" char_id="0" frame_id="-1" name="美帆" text="『んっっ！』"
		   voices="miho00450"/>
		<msg @l="399" char_id="-1" frame_id="-1" name=""
		   text="スカートに進入してきた手は、お尻のほうから割れ目に沿って、後ろの穴へと這わせてくる。" voices=""/>
		<msg @l="401" char_id="0" frame_id="-1" name="美帆" text="『ひっ！』"
		   voices="miho00750"/>
		<msg @l="403" char_id="-1" frame_id="-1" name=""
		   text="私は思わず息を飲み、侵入者を拒む為にお尻をぴったりと閉じる。" voices=""/>
		<msg @l="404" char_id="-1" frame_id="-1" name=""
		   text="しかし痴漢の指先は、柔らかい尻肉を力ずくで割るようにして突き進み、後ろの菊花をまさぐりいじり出す。途端に、背中に悪寒が走った。"
		   voices=""/>
		<msg @l="406" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥っ‥‥‥。』"
		   voices="miho09930"/>
		<msg @l="408" char_id="-1" frame_id="-1" name="痴漢"
		   text="『おやおや、ヒクヒクさせて‥‥こちらも随分と敏感なようだな。』" voices=""/>
		<msg @l="410" char_id="0" frame_id="-1" name="美帆" text="『ち、違いますっ。』"
		   voices="miho00760"/>
		<msg @l="412" char_id="-1" frame_id="-1" name="痴漢"
		   text="『どれ‥‥両方一緒に可愛がってやろうか。』" voices=""/>
		<msg @l="414" char_id="0" frame_id="-1" name="美帆" text="『え‥‥？』"
		   voices="miho00770"/>
		<msg @l="416" char_id="-1" frame_id="-1" name=""
		   text="左手で柔らかい尻肉をかき分け、糸をキュッと結んだかのような後ろのアヌスを指先でマッサージするように撫であげる。" voices=""/>
		<msg @l="417" char_id="-1" frame_id="-1" name=""
		   text="右手では、下着越しにアソコの突起へ強い刺激を与えるように爪弾く。" voices=""/>
		<msg @l="418" char_id="-1" frame_id="-1" name="" text="くりっくりっ。" voices=""/>
		<msg @l="420" char_id="0" frame_id="-1" name="美帆" text="『ひっっ！！』"
		   voices="miho00780"/>
		<msg @l="422" char_id="-1" frame_id="-1" name=""
		   text="再び―――私は息を飲んだ。前と後ろから手を差し入れられ、持ち上げられるような体勢で休む事なく刺激を与えられる。" voices=""/>
		<msg @l="423" char_id="-1" frame_id="-1" name=""
		   text="悪寒なのか不快感なのか快感なのか、自分でも良く解らない「何か」が勢い良く全身をビリビリと駆け抜けていく。" voices=""/>
		<msg @l="425" char_id="-1" frame_id="-1" name="痴漢"
		   text="『くく、腰が跳ねるほど気持ち良いか。』" voices=""/>
		<msg @l="427" char_id="0" frame_id="-1" name="美帆" text="『いや‥‥‥そんなことっ‥‥‥‥。』"
		   voices="miho00790"/>
		<msg @l="429" char_id="-1" frame_id="-1" name=""
		   text="ここで「違う」と言わなければいけないのは解ってる。" voices=""/>
		<msg @l="430" char_id="-1" frame_id="-1" name="" text="でも、言葉が出てこない。"
		   voices=""/>
		<msg @l="431" char_id="-1" frame_id="-1" name="" text="息が荒くなる。" voices=""/>
		<msg @l="432" char_id="-1" frame_id="-1" name=""
		   text="自分の身体のことなのに‥‥頭がぼうっとしてきてわからない。" voices=""/>
		<msg @l="434" char_id="-1" frame_id="-1" name="痴漢"
		   text="『さて、何が「そんなこと」なのかね？』" voices=""/>
		<msg @l="436" char_id="-1" frame_id="-1" name="" text="見透かされているのだろうか。"
		   voices=""/>
		<msg @l="437" char_id="-1" frame_id="-1" name=""
		   text="私の曖昧な心を見抜いたように、追求の言葉を浴びせられる。" voices=""/>
		<msg @l="438" char_id="-1" frame_id="-1" name="" text="触れないで欲しい。" voices=""/>
		<msg @l="439" char_id="-1" frame_id="-1" name="" text="そこには‥‥触れないで欲しいのに。"
		   voices=""/>
		<msg @l="441" char_id="0" frame_id="-1" name="美帆" text="『そ、それは‥‥。』"
		   voices="miho00800"/>
		<msg @l="443" char_id="-1" frame_id="-1" name="痴漢" text="『‥‥くくっ。』" voices=""/>
		<msg @l="445" char_id="-1" frame_id="-1" name=""
		   text="言葉に詰まり困惑している私の耳元へ、痴漢は顔を寄せてきて、中年独特の臭い息を吹きかけてくる。" voices=""/>
		<msg @l="446" char_id="-1" frame_id="-1" name=""
		   text="私は反射的に逃げようとするが、壁と痴漢の狭い空間に監禁され、ほとんど動くことが出来ない。" voices=""/>
		<msg @l="447" char_id="-1" frame_id="-1" name=""
		   text="痴漢は含みのある笑みを漏らすと、器用に指を動かして陰唇をつまんでは左右に開くようにいじくる。" voices=""/>
		<msg @l="448" char_id="-1" frame_id="-1" name="" text="むに、むに。" voices=""/>
		<msg @l="450" char_id="0" frame_id="-1" name="美帆" text="『んっ‥‥。』"
		   voices="miho10450"/>
		<msg @l="452" char_id="-1" frame_id="-1" name=""
		   text="余っている指先を蠢かせて、亀裂の上部に位置する小粒の真珠を円を描くように転がす。" voices=""/>
		<msg @l="454" char_id="0" frame_id="-1" name="美帆" text="『んっ‥‥。』"
		   voices="miho00810"/>
		<msg @l="456" char_id="-1" frame_id="-1" name=""
		   text="私は涙目になりながら思わず漏れそうになる声を必死に飲み込み、腰を震わせて耐えていた。" voices=""/>
		<msg @l="458" char_id="-1" frame_id="-1" name="痴漢" text="『キミのここは凄く柔らかいなー。』"
		   voices=""/>
		<msg @l="460" char_id="-1" frame_id="-1" name="" text="ぐにゅ、むにゅ、ぐにゅ。"
		   voices=""/>
		<msg @l="462" char_id="0" frame_id="-1" name="美帆" text="『やだ‥‥そこは‥‥‥。』"
		   voices="miho00410"/>
		<msg @l="464" char_id="-1" frame_id="-1" name=""
		   text="お尻に力を入れて必死に耐えようとするが、柔媚（じゅうび）な花弁を掻き分けられ狭い隘路（あいろ）に忍び込む痴漢の指先に言いようの無い感覚が腰の辺りでくすぶっては消える。"
		   voices=""/>
		<msg @l="465" char_id="-1" frame_id="-1" name=""
		   text="美帆の内股には汗が噴出し下着を湿らせていた。" voices=""/>
		<msg @l="467" char_id="-1" frame_id="-1" name="痴漢"
		   text="『そら、キミのここはもうこんなに硬くなっているな。』" voices=""/>
		<msg @l="469" char_id="-1" frame_id="-1" name="" text="くり、くり、くり。" voices=""/>
		<msg @l="471" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥ゃぁ‥‥。』"
		   voices="miho00740"/>
		<msg @l="473" char_id="-1" frame_id="-1" name=""
		   text="わざとらしくパンティの上から包皮にくるまれている肉芽を転がしながら、痴漢が耳元で囁く。" voices=""/>
		<msg @l="474" char_id="-1" frame_id="-1" name=""
		   text="確かに私のそこは‥‥自分でもびっくりするくらい硬起して敏感になっていた。" voices=""/>
		<msg @l="475" char_id="0" frame_id="-1" name="美帆"
		   text="(なんで‥‥気持ち悪いのに‥‥‥なんでこんなに‥‥‥)" voices="miho00820"/>
		<msg @l="477" char_id="0" frame_id="-1" name="美帆"
		   text="(‥‥‥‥‥ダメ‥‥‥こんなの‥‥‥立ってられない‥‥‥‥)" voices="miho00830"/>
		<msg @l="479" char_id="-1" frame_id="-1" name="" text="腰が痺れて足に力が入らない。"
		   voices=""/>
		<msg @l="480" char_id="-1" frame_id="-1" name=""
		   text="既にひとりでは立っていれないほど腰が震えて、不覚にも身体を痴漢に預けるような格好になってしまう。" voices=""/>
		<msg @l="482" char_id="-1" frame_id="-1" name="痴漢"
		   text="『どうした‥‥このままイっても良いのだぞ？』" voices=""/>
		<msg @l="484" char_id="-1" frame_id="-1" name=""
		   text="そもそも私は「イク」という事がどういうことなのかわからなかった。" voices=""/>
		<msg @l="485" char_id="-1" frame_id="-1" name="" text="自慰の経験は‥‥ある。"
		   voices=""/>
		<msg @l="486" char_id="-1" frame_id="-1" name=""
		   text="週に一度‥‥いや、頻度としてはもっと少ないかもしれない。" voices=""/>
		<msg @l="487" char_id="-1" frame_id="-1" name=""
		   text="ただ、何時も「イク」というところまで達する前に止めてしまう。" voices=""/>
		<msg @l="488" char_id="-1" frame_id="-1" name="" text="何となく怖かった。" voices=""/>
		<msg @l="489" char_id="-1" frame_id="-1" name=""
		   text="自分の知らない自分に対する恐怖とでもいうべきだろうか。" voices=""/>
		<msg @l="490" char_id="-1" frame_id="-1" name="" text="けれど‥‥。" voices=""/>
		<msg @l="491" char_id="-1" frame_id="-1" name=""
		   text="けれどその「恐怖」も「抵抗」もこの状況では全く効果を為さない。" voices=""/>
		<msg @l="492" char_id="-1" frame_id="-1" name=""
		   text="私はただ痴漢の為すがままに凌辱されていた。" voices=""/>
		<msg @l="494" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥ぁっ‥‥。』"
		   voices="miho00840"/>
		<msg @l="496" char_id="-1" frame_id="-1" name="" text="私は短く吐息を漏らす。"
		   voices=""/>
		<msg @l="497" char_id="-1" frame_id="-1" name=""
		   text="痴漢は膣のスポットを激烈に摩擦し、グニャッとスカートを歪ませ腰を押しつけてきた。" voices=""/>
		<msg @l="498" char_id="-1" frame_id="-1" name="" text="どく、どく、どく。" voices=""/>
		<msg @l="499" char_id="-1" frame_id="-1" name=""
		   text="お尻には脈打つ熱を持った棒のような感触が伝わってくる。" voices=""/>
		<msg @l="501" char_id="0" frame_id="-1" name="美帆" text="『んっっ！』"
		   voices="miho00450"/>
		<msg @l="503" char_id="-1" frame_id="-1" name=""
		   text="私もある程度の性知識はある。腰に当てられているモノが、充血し完全な勃起したペニスであることも頭で分かっていた。" voices=""/>
		<msg @l="504" char_id="-1" frame_id="-1" name=""
		   text="だがそんな考えも、女陰をいじくられる痴漢の指の動きでかき消される。" voices=""/>
		<msg @l="505" char_id="-1" frame_id="-1" name="" text="ぐにゅ、ぐにゅ、むにゅ。"
		   voices=""/>
		<msg @l="507" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥っ‥‥‥。』"
		   voices="miho09930"/>
		<msg @l="509" char_id="-1" frame_id="-1" name=""
		   text="秘豆をいじられたことによって熱を持った下半身の痺れが、少しずつ増してくる。" voices=""/>
		<msg @l="511" char_id="0" frame_id="-1" name="美帆"
		   text="(‥‥‥私‥‥痴漢されてイきそうになってる‥‥‥)" voices="miho00850"/>
		<msg @l="513" char_id="0" frame_id="-1" name="美帆"
		   text="(自分でしてる時も‥‥イったことなんてないのに‥‥‥‥)" voices="miho00860"/>
		<msg @l="515" char_id="0" frame_id="-1" name="美帆"
		   text="(‥‥‥‥‥なんか‥‥‥‥このまま‥‥‥‥‥‥)" voices="miho00870"/>
		<msg @l="517" char_id="-1" frame_id="-1" name=""
		   text="私は息を吐いた瞬間、思わず少しだけ身体の力を抜いてしまう。" voices=""/>
		<msg @l="518" char_id="-1" frame_id="-1" name=""
		   text="その瞬間、「どうでもいいや」‥‥そんな考えが脳裏をよぎる。" voices=""/>
		<msg @l="519" char_id="-1" frame_id="-1" name="" text="自暴自棄というのとは少し違う気がする。"
		   voices=""/>
		<msg @l="520" char_id="-1" frame_id="-1" name=""
		   text="ただ何処かへ向けて昇りつめていくような感覚だけがゆっくりと広がっていて。" voices=""/>
		<msg @l="521" char_id="-1" frame_id="-1" name=""
		   text="そうして昇りつめてしまえば楽なのだ‥‥という気持ちに囚われる。" voices=""/>
		<msg @l="522" char_id="-1" frame_id="-1" name=""
		   text="痴漢は力を抜いたその瞬間を逃さず、秘烈の中に指を進入させようとしてきた‥‥その瞬間―――。" voices=""/>
		<stopbgm @l="526" fadeout="1000"/>
		<clear @l="532" class="all"/>
		<msg @l="534" char_id="-1" frame_id="-1" name="アナウンス"
		   text="『次は終点‥‥大学前、大学前です。』" voices=""/>
		<msg @l="536" char_id="-1" frame_id="-1" name="アナウンス"
		   text="『手荷物のお忘れ物などありませんようご注意ください。』" voices=""/>
		<msg @l="538" char_id="0" frame_id="-1" name="美帆" text="『あ‥‥。』"
		   voices="miho00880"/>
		<msg @l="540" char_id="-1" frame_id="-1" name="" text="アナウンスが流れ、車内が騒然とし始める。"
		   voices=""/>
		<msg @l="541" char_id="-1" frame_id="-1" name=""
		   text="気付けば窓の外には大学の校舎が見えるところまで来ており、一分もせずに駅に到着するという所だった。" voices=""/>
		<msg @l="542" char_id="-1" frame_id="-1" name="" text="何かが‥‥一気に冷めていく。"
		   voices=""/>
		<msg @l="543" char_id="-1" frame_id="-1" name=""
		   text="映画に熱中している途中で見慣れたＣＭが流れた時のような、急に現実に引き戻されたような感覚だった。" voices=""/>
		<msg @l="545" char_id="-1" frame_id="-1" name="痴漢" text="『‥‥チッ。』" voices=""/>
		<msg @l="547" char_id="-1" frame_id="-1" name="" text="痴漢の露骨な舌打ちが聞こえた。"
		   voices=""/>
		<msg @l="548" char_id="-1" frame_id="-1" name=""
		   text="そうして、すっとスカートの中から痴漢の手が引き抜かれていく。" voices=""/>
		<msg @l="550" char_id="-1" frame_id="-1" name="痴漢"
		   text="『‥‥次はきちんとイかせてやるよ、仲根美帆クン。』" voices=""/>
		<msg @l="552" char_id="0" frame_id="-1" name="美帆" text="『え―――――ッ！？』"
		   voices="miho00890"/>
		<msg @l="554" char_id="-1" frame_id="-1" name=""
		   text="息が掛かるほど間近で痴漢が囁いて、次いで背後で人の動く気配がする。" voices=""/>
		<msg @l="555" char_id="-1" frame_id="-1" name="" text="おそらく‥‥逃げたのだろう。"
		   voices=""/>
		<eval @l="558" expr="f.名前を知られてるflag&#32;+=&#32;1&#13;&#10;"/>
		<clear @l="565" class="all"/>
		<msg @l="567" char_id="0" frame_id="-1" name="美帆" text="(‥‥‥どうして私の名前‥‥‥‥‥)"
		   voices="miho00900"/>
		<msg @l="569" char_id="0" frame_id="-1" name="美帆"
		   text="(‥‥‥やだ‥‥‥こわいよ‥‥‥‥‥‥)" voices="miho00910"/>
		<stopse @l="573" buf="3"/>
		<se @l="577" buf="1" src="電車停車" volume="1."/>
		<msg @l="579" char_id="-1" frame_id="-1" name=""
		   text="電車が止まり、次々と人々が降りて行く中‥‥。" voices=""/>
		<msg @l="580" char_id="-1" frame_id="-1" name=""
		   text="私は背筋の凍るような恐怖に‥‥打ち震えていた。" voices=""/>
		<eval @l="583" expr="f.痴漢flag&#32;+=&#32;1&#13;&#10;"/>
		<goto @l="586" label="TempLabel_159"/>
		<label @l="587" id="TempLabel_158"/>
		<msg @l="590" char_id="-1" frame_id="-1" name="痴漢" text="『おや、今日は抵抗しないのだな。』"
		   voices=""/>
		<msg @l="592" char_id="0" frame_id="-1" name="美帆" text="『‥‥！？』"
		   voices="miho00920"/>
		<msg @l="594" char_id="-1" frame_id="-1" name=""
		   text="突然、痴漢とおぼしき後ろの男が私の耳元へ囁きかけてくる。" voices=""/>
		<msg @l="595" char_id="-1" frame_id="-1" name=""
		   text="私は驚きの余り振り返ろうとするが、この混雑ぶりではそれさえも難しい。" voices=""/>
		<msg @l="596" char_id="-1" frame_id="-1" name=""
		   text="仕方なく首だけを回して後ろを見ようとするが、私の身長では後ろに立っている男の胸元からあご先くらいまでを伺うので精一杯だ。"
		   voices=""/>
		<msg @l="598" char_id="-1" frame_id="-1" name="痴漢"
		   text="『この混雑だ。余り暴れない方が得策だと思うがね。』" voices=""/>
		<msg @l="600" char_id="-1" frame_id="-1" name="" text="男が身体を屈めて私の耳元へと囁きかける。"
		   voices=""/>
		<msg @l="601" char_id="-1" frame_id="-1" name=""
		   text="その瞬間、うなじに中年特有の臭い息が吹きかけられ、その匂いから逃げようと身体を前に傾ける。" voices=""/>
		<msg @l="602" char_id="-1" frame_id="-1" name="" text="さわっ。" voices=""/>
		<msg @l="604" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥ぁっ‥‥。』"
		   voices="miho00840"/>
		<msg @l="606" char_id="-1" frame_id="-1" name=""
		   text="その瞬間、お尻を突き出す格好となってしまい、痴漢は突き出されたお尻を手のひらで撫でてきた。" voices=""/>
		<msg @l="607" char_id="-1" frame_id="-1" name=""
		   text="まるで臀部の量感を愉しむかのように、持ち上げては下げて若さが持つ弾力を充分に堪能している。" voices=""/>
		<msg @l="609" char_id="0" frame_id="-1" name="美帆"
		   text="『あなたは‥‥どうしてこんな事するんですか‥‥‥‥。』" voices="miho00930"/>
		<msg @l="611" char_id="-1" frame_id="-1" name="痴漢"
		   text="『君の身体が、私を誘っているからさ。』" voices=""/>
		<msg @l="613" char_id="0" frame_id="-1" name="美帆" text="『茶化さないでくださいっ。』"
		   voices="miho00940"/>
		<msg @l="615" char_id="-1" frame_id="-1" name=""
		   text="思わず言葉に力が入り、周囲の人々がこちらへ視線を向ける。" voices=""/>
		<msg @l="616" char_id="-1" frame_id="-1" name=""
		   text="私は慌てて口をつぐんでうつむくが‥‥それでもやはり視線が痛かった。" voices=""/>
		<msg @l="617" char_id="-1" frame_id="-1" name=""
		   text="もの凄く恥ずかしくなり、意思とは裏腹に顔が真っ赤になってしまう。" voices=""/>
		<msg @l="619" char_id="-1" frame_id="-1" name="痴漢"
		   text="『余り興奮しない方がいいのではないかね。痴漢されているのを知られたくないのだろう？』" voices=""/>
		<msg @l="621" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』"
		   voices="miho00950"/>
		<msg @l="623" char_id="-1" frame_id="-1" name=""
		   text="痴漢は私を黙らせると、実りきった桃尻を撫で回していた指でパンティ生地を引き絞り、グイッと上に引き上げた。" voices=""/>
		<msg @l="625" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥ゃぁ‥‥。』"
		   voices="miho00740"/>
		<msg @l="627" char_id="-1" frame_id="-1" name=""
		   text="フンドシのような１本の綱となったパンティが尻の谷間に食い込み、秘部を圧迫する。" voices=""/>
		<msg @l="628" char_id="-1" frame_id="-1" name="" text="その力により、女唇は見事に開ききった。"
		   voices=""/>
		<msg @l="630" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥っ‥‥。』"
		   voices="miho01620"/>
		<msg @l="632" char_id="-1" frame_id="-1" name="痴漢"
		   text="『そう、目立ちたくなければそうして押し黙っているべきだ。特にキミのような世間体に敏感な子はね。』" voices=""/>
		<msg @l="634" char_id="-1" frame_id="-1" name=""
		   text="そう言っていやらしく笑うと、お尻を撫でていた手をスカートの中へと滑り込ませてくる。" voices=""/>
		<wait_chgmv/>
		<ev @l="638" src="ev-005ax3y2"/>
		<msg @l="640" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥っ‥‥。』"
		   voices="miho00960"/>
		<msg @l="642" char_id="-1" frame_id="-1" name=""
		   text="私は思わず声を出しそうになって、慌てて言葉を飲み込んだ。" voices=""/>
		<msg @l="643" char_id="-1" frame_id="-1" name=""
		   text="ただでさえ先ほどの失敗で周囲の注意を引いてしまっているのに、ここで更に声など出したらそれこそ注目の的となる。" voices=""/>
		<msg @l="644" char_id="-1" frame_id="-1" name=""
		   text="痴漢をされてるのを知られるのは、どうしても避けたい。" voices=""/>
		<msg @l="645" char_id="-1" frame_id="-1" name=""
		   text="ましてその恥ずかしい状況を見ず知らずの大勢に目撃されるのはたまらなく嫌だ。" voices=""/>
		<msg @l="646" char_id="-1" frame_id="-1" name=""
		   text="そう考えると全く声が出なくなり、身体も身動きが取れなくなってしまう。" voices=""/>
		<msg @l="648" char_id="-1" frame_id="-1" name="痴漢" text="『くく‥‥賢明な判断だ。』"
		   voices=""/>
		<msg @l="650" char_id="-1" frame_id="-1" name="痴漢"
		   text="『しばらく大人しくしていれば「気持ち良く」してやる。』" voices=""/>
		<msg @l="652" char_id="-1" frame_id="-1" name="" text="さわ、さわ、さわ。" voices=""/>
		<msg @l="654" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥ぅぁ‥‥。』"
		   voices="miho00430"/>
		<msg @l="656" char_id="-1" frame_id="-1" name=""
		   text="痴漢はそう言って笑うと、人差し指と中指が太股の内側を上下に擦り始めた。" voices=""/>
		<msg @l="657" char_id="-1" frame_id="-1" name=""
		   text="白くみずみずしい内股の柔肌をなぞるように徐々に手を上にあげていく。" voices=""/>
		<msg @l="658" char_id="-1" frame_id="-1" name="" text="手を上に持って来ないで‥‥‥‥。"
		   voices=""/>
		<msg @l="659" char_id="-1" frame_id="-1" name=""
		   text="‥‥‥その願いもむなしく、下着の端に人差し指と中指が到達した。" voices=""/>
		<msg @l="660" char_id="-1" frame_id="-1" name="" text="むにゅっ。" voices=""/>
		<msg @l="662" char_id="0" frame_id="-1" name="美帆" text="『んっっ！』"
		   voices="miho00450"/>
		<msg @l="664" char_id="-1" frame_id="-1" name=""
		   text="指が下着に触れられた瞬間、私は腰を浮かすように逃げようとするが、痴漢の巧みな指先は私を逃がさまいと、指を一気に差し入れ、下着の上から直接秘部をこね回してきた。"
		   voices=""/>
		<msg @l="665" char_id="-1" frame_id="-1" name="" text="くにゅっ、むにゅっ。" voices=""/>
		<msg @l="667" char_id="0" frame_id="-1" name="美帆" text="『くっ‥‥。』"
		   voices="miho00400"/>
		<msg @l="669" char_id="-1" frame_id="-1" name=""
		   text="前と後ろからサンドイッチのような状態にされ、両手でねっとりと秘部を触られてしまっている。" voices=""/>
		<msg @l="671" char_id="0" frame_id="-1" name="美帆"
		   text="(‥‥‥どうしてこんな風になっちゃうの‥‥‥‥)" voices="miho00970"/>
		<msg @l="673" char_id="0" frame_id="-1" name="美帆"
		   text="(痴漢に遭わないように電車まで変えたのに‥‥)" voices="miho00980"/>
		<msg @l="675" char_id="-1" frame_id="-1" name=""
		   text="思えば、何故こうして自分ばかりが痴漢に狙われてしまうのだろう。" voices=""/>
		<msg @l="676" char_id="-1" frame_id="-1" name=""
		   text="幾ら極度の引っ込み思案という痴漢につけいれられやすい性格だからといって、こうも狙われてしまうものなのかな？" voices=""/>
		<msg @l="677" char_id="-1" frame_id="-1" name=""
		   text="私の身体が男好きする身体なのだろうか‥‥そんなのは嫌だ‥‥。" voices=""/>
		<msg @l="679" char_id="0" frame_id="-1" name="美帆"
		   text="(そういえばさっき「今日は抵抗しないのか」みたいな事‥‥言ってたよね？)" voices="miho00990"/>
		<msg @l="681" char_id="0" frame_id="-1" name="美帆"
		   text="(ということは‥‥私が昨日痴漢に遭って、しかも抵抗した事を知ってるっていう意味だよね？)" voices="miho01000"/>
		<msg @l="683" char_id="0" frame_id="-1" name="美帆" text="(‥‥‥それって‥‥まさか‥‥‥？)"
		   voices="miho01010"/>
		<msg @l="685" char_id="-1" frame_id="-1" name=""
		   text="ふと浮かんだ考えが奇妙な偶然と符合して、余計に背筋が寒くなった。" voices=""/>
		<msg @l="687" char_id="0" frame_id="-1" name="美帆" text="『‥‥昨日の痴漢‥‥‥‥なの？』"
		   voices="miho01020"/>
		<msg @l="689" char_id="-1" frame_id="-1" name="痴漢" text="『ふふっ、やっと分かったのかね。』"
		   voices=""/>
		<msg @l="691" char_id="-1" frame_id="-1" name=""
		   text="私のつぶやきに痴漢は満足げに答え、笑った。" voices=""/>
		<msg @l="692" char_id="-1" frame_id="-1" name=""
		   text="要するに車内の女性比率なんて最初から関係なかったのだ。" voices=""/>
		<msg @l="693" char_id="-1" frame_id="-1" name=""
		   text="痴漢は‥‥最初から私を狙っていたのだから。" voices=""/>
		<msg @l="695" char_id="0" frame_id="-1" name="美帆"
		   text="『どうして‥‥私が今日こっちの電車に乗るって解ったんですか。』" voices="miho01030"/>
		<msg @l="697" char_id="-1" frame_id="-1" name="痴漢"
		   text="『君の性格を考えれば昨日と同じ電車に乗りはしないと思ってね。ふふふっ、全く予想通りの行動をしてくれる。』" voices=""/>
		<msg @l="699" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』"
		   voices="miho01040"/>
		<msg @l="701" char_id="-1" frame_id="-1" name=""
		   text="確かに、痴漢に遭ったから電車を変えるなんて当たり前の事かもしれない。" voices=""/>
		<msg @l="702" char_id="-1" frame_id="-1" name=""
		   text="しかも一限に間に合う電車は二本しかないのだから、あてずっぽうに乗っても二回に一回は遭遇してしまう。" voices=""/>
		<msg @l="704" char_id="0" frame_id="-1" name="美帆"
		   text="『それなら‥‥どうして私がこの電車に乗る事、知ってるんですか。』" voices="miho01050"/>
		<msg @l="706" char_id="-1" frame_id="-1" name="痴漢"
		   text="『この次の電車では一限目に遅刻してしまうだろう、仲根美帆クン。』" voices=""/>
		<msg @l="707" char_id="0" frame_id="-1" name="美帆" text="『――――――ッ！？』"
		   voices="miho01060"/>
		<msg @l="709" char_id="0" frame_id="-1" name="美帆" text="『私のこと‥‥‥何で‥‥‥‥‥？』"
		   voices="miho01070"/>
		<msg @l="711" char_id="-1" frame_id="-1" name="痴漢"
		   text="『ほう、君は痴漢されている相手のことを知りたいのかね。それはもっと痴漢をして欲しい、身体を貪って欲しいということかな。』"
		   voices=""/>
		<msg @l="713" char_id="-1" frame_id="-1" name=""
		   text="そう言って痴漢は再び下着の上からお尻を鷲づかみにすると、お尻の割れ目に指を無理やりねじ込んできて、後ろから秘部をいじくろうとしてくる。"
		   voices=""/>
		<msg @l="714" char_id="-1" frame_id="-1" name=""
		   text="お尻に力を入れて必死に耐えようとするが、柔媚（じゅうび）な花弁を掻き分けられ狭い隘路（あいろ）に忍び込む痴漢の指先に言いようの無い感覚が腰の辺りでくすぶっては消える。"
		   voices=""/>
		<msg @l="715" char_id="-1" frame_id="-1" name=""
		   text="美帆の内股には汗が噴出し下着を湿らせていた。" voices=""/>
		<msg @l="717" char_id="0" frame_id="-1" name="美帆" text="『んんっっ！』"
		   voices="miho10930"/>
		<msg @l="719" char_id="-1" frame_id="-1" name=""
		   text="痴漢は膣のスポットを激烈に摩擦し、グニャッとスカートを歪ませ腰を押しつけてきた。" voices=""/>
		<msg @l="720" char_id="-1" frame_id="-1" name="" text="どく、どく、どく。" voices=""/>
		<msg @l="722" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥ぅぁ‥‥。』"
		   voices="miho00430"/>
		<msg @l="724" char_id="-1" frame_id="-1" name=""
		   text="お尻には脈打つ熱を持った棒のような感触が伝わってくる。" voices=""/>
		<msg @l="725" char_id="-1" frame_id="-1" name=""
		   text="私もある程度の性知識はある。腰に当てられているモノが、充血し完全な勃起したペニスであることも頭で分かっていた。" voices=""/>
		<msg @l="726" char_id="-1" frame_id="-1" name="" text="ぐにゅ、ぐにゅ、むにゅ。"
		   voices=""/>
		<msg @l="728" char_id="0" frame_id="-1" name="美帆" text="『ん、ん、ん、んんっ！』"
		   voices="miho10980"/>
		<msg @l="730" char_id="-1" frame_id="-1" name=""
		   text="だがそんな考えも、女陰をいじくられる痴漢の指の動きでかき消される。" voices=""/>
		<msg @l="731" char_id="-1" frame_id="-1" name=""
		   text="秘豆をいじられたことによって熱を持った下半身の痺れが、少しずつ増していく。" voices=""/>
		<msg @l="732" char_id="-1" frame_id="-1" name=""
		   text="私は女陰を嬲られる指の動きに、気持ちの悪さより恐怖の方を強く感じていた。" voices=""/>
		<msg @l="733" char_id="-1" frame_id="-1" name=""
		   text="‥‥涙目になり、歯の根が合わないような震えを押し殺しながら。" voices=""/>
		<msg @l="735" char_id="-1" frame_id="-1" name="アナウンス"
		   text="『次は終点‥‥大学前、大学前です。』" voices=""/>
		<msg @l="737" char_id="-1" frame_id="-1" name="アナウンス"
		   text="『手荷物のお忘れ物などありませんようご注意ください。』" voices=""/>
		<msg @l="739" char_id="-1" frame_id="-1" name="" text="聞き慣れたアナウンスが車内に流れる。"
		   voices=""/>
		<msg @l="740" char_id="-1" frame_id="-1" name=""
		   text="けれど、その聞き慣れたアナウンスも痴漢されているという恐怖を認識させてしまうだけに過ぎなかった。" voices=""/>
		<msg @l="742" char_id="-1" frame_id="-1" name="痴漢"
		   text="『おや‥‥もう少しで君のものを指でかき回してやれる所だったのだがな。』" voices=""/>
		<msg @l="744" char_id="-1" frame_id="-1" name="痴漢"
		   text="『まぁいい。お楽しみは、この次にするとしよう。』" voices=""/>
		<msg @l="746" char_id="-1" frame_id="-1" name=""
		   text="痴漢は恐怖に震えている私をせせら笑うように言って、秘部に這わせていた手をするりと引き抜く。" voices=""/>
		<msg @l="747" char_id="-1" frame_id="-1" name=""
		   text="そうして‥‥痴漢は人の流れに身を任せるように、離れていった。" voices=""/>
		<stopbgm @l="751" fadeout="1000"/>
		<clear @l="757" class="all"/>
		<msg @l="759" char_id="0" frame_id="-1" name="美帆" text="(‥‥‥‥どうしよう‥‥‥‥‥‥)"
		   voices="miho01080"/>
		<msg @l="761" char_id="0" frame_id="-1" name="美帆"
		   text="(‥‥‥私‥‥‥震えが止まらないよ‥‥‥‥)" voices="miho01090"/>
		<msg @l="763" char_id="-1" frame_id="-1" name=""
		   text="手すりにつかまったまま‥‥私は一人、肩を震わせていた。" voices=""/>
		<stopse @l="767" buf="3"/>
		<eval @l="770" expr="f.名前を知られてるflag&#32;+=&#32;1&#13;&#10;"/>
		<eval @l="772" expr="f.痴漢flag&#32;+=&#32;1&#13;&#10;"/>
		<label @l="776" id="TempLabel_159"/>
		<clear @l="783" class="all"/>
		<msgshow @l="785" show="true"/>
		<goto @l="788" label="EventLabel_26"/>
		<label @l="792" id="EventLabel_26"/>
		<end_scene @l="796"/>
		<wait_chgmv/>
		<bg @l="800" src="bg08m1"/>
		<description @l="803" text="日常へ差す影"/>
		<bgm @l="807" src="bgm03" volume="1."/>
		<msg @l="809" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="811" char_id="-1" frame_id="-1" name="" text="うわの空で講義を受けていた。"
		   voices=""/>
		<msg @l="812" char_id="-1" frame_id="-1" name="" text="ずっと朝の一件を考えていた。"
		   voices=""/>
		<msg @l="813" char_id="-1" frame_id="-1" name=""
		   text="どういうわけか痴漢が私個人を執拗に狙っているという事。" voices=""/>
		<goto @l="816" cond="!(f.名前を知られてるflag&#32;==&#32;1)&#13;&#10;"
		   label="TempLabel_160"/>
		<msg @l="818" char_id="-1" frame_id="-1" name=""
		   text="その痴漢に‥‥名前を知られてしまっているという事。" voices=""/>
		<label @l="821" id="TempLabel_160"/>
		<msg @l="824" char_id="-1" frame_id="-1" name=""
		   text="私個人を執拗に狙うというのは納得出来ないけど理解は出来る。" voices=""/>
		<msg @l="825" char_id="-1" frame_id="-1" name=""
		   text="白石先輩の言うように私は狙われ易い性格なのだろうし、一度目の痴漢で手ごたえを得てもう一度‥‥というのなら偶然居合わせたより解りやすい。"
		   voices=""/>
		<msg @l="827" char_id="0" frame_id="-1" name="美帆"
		   text="(もちろん‥‥そんなこと解っても全然うれしくないけど‥‥‥‥)" voices=""/>
		<goto @l="830" cond="!(f.名前を知られてるflag&#32;==&#32;1)&#13;&#10;"
		   label="TempLabel_161"/>
		<msg @l="832" char_id="-1" frame_id="-1" name=""
		   text="私の名前を知っているという理由も、痴漢が大学の関係者であれば納得がいく。" voices=""/>
		<label @l="836" id="TempLabel_161"/>
		<msg @l="839" char_id="-1" frame_id="-1" name="" text="それより、問題はむしろ――――。"
		   voices=""/>
		<msg @l="841" char_id="3" frame_id="-1" name="声" text="『‥‥難しい顔してる。』"
		   voices=""/>
		<stopbgm @l="845" fadeout="1000"/>
		<msg @l="847" char_id="0" frame_id="-1" name="美帆" text="『え‥‥？』" voices=""/>
		<msg @l="849" char_id="-1" frame_id="-1" name=""
		   text="いきなり声をかけられ、それまでの思考が一瞬にして吹き飛んだ。" voices=""/>
		<msg @l="850" char_id="-1" frame_id="-1" name=""
		   text="慌てて声の主を探そうと周囲を見回していると、少し離れたところから一人の女の子が特に身を隠すでもなく私の隣に席を移動してきた。"
		   voices=""/>
		<char @l="853" id="nanak" pos="center" src="nanako010"/>
		<msg @l="855" char_id="-1" frame_id="-1" name=""
		   text="長い髪の毛を頭の両脇で結んだちょっと色素の薄い女の子だ。" voices=""/>
		<msg @l="857" char_id="0" frame_id="-1" name="美帆" text="『あ‥‥あなたは‥‥‥‥。』"
		   voices=""/>
		<msg @l="859" char_id="-1" frame_id="-1" name=""
		   text="その色素の薄いツインテールの子には見覚えがあった。" voices=""/>
		<msg @l="860" char_id="-1" frame_id="-1" name=""
		   text="一ヶ月くらい前、私がこの南総町へ来た日に出会った不思議な女の子。" voices=""/>
		<msg @l="861" char_id="-1" frame_id="-1" name=""
		   text="私の心を的確に言い当てた‥‥あの、女の子だ。" voices=""/>
		<clear @l="864" class="char"/>
		<bgm @l="868" src="bgm11" volume="1."/>
		<msg @l="870" char_id="3" frame_id="-1" name="女の子" text="『元気‥‥‥じゃないみたいだね。』"
		   voices=""/>
		<msg @l="872" char_id="0" frame_id="-1" name="美帆" text="『‥‥うん。』" voices=""/>
		<msg @l="874" char_id="-1" frame_id="-1" name="" text="動揺と困惑を隠す事が出来なかった。"
		   voices=""/>
		<msg @l="875" char_id="-1" frame_id="-1" name=""
		   text="彼女は、あまりにもあっさりと私の内側へ踏み込んでくる。" voices=""/>
		<msg @l="876" char_id="-1" frame_id="-1" name="" text="この少女は一体なんなのだろう。"
		   voices=""/>
		<msg @l="877" char_id="-1" frame_id="-1" name="" text="どうしても警戒してしまう。"
		   voices=""/>
		<msg @l="879" char_id="3" frame_id="-1" name="女の子" text="『悩むと疲れちゃうよ。』"
		   voices=""/>
		<msg @l="881" char_id="3" frame_id="-1" name="女の子" text="『自分を苛めちゃ‥‥ダメだと思う。』"
		   voices=""/>
		<msg @l="883" char_id="0" frame_id="-1" name="美帆" text="『‥‥うん‥‥。』" voices=""/>
		<msg @l="885" char_id="-1" frame_id="-1" name=""
		   text="そう言いながらも、私は“でも痴漢に会ったら誰だって悩むわよ”と思っていた。" voices=""/>
		<msg @l="887" char_id="3" frame_id="-1" name="女の子" text="『ちかん？』" voices=""/>
		<msg @l="889" char_id="0" frame_id="-1" name="美帆" text="『え！？』" voices=""/>
		<msg @l="891" char_id="-1" frame_id="-1" name="" text="ぞくり、とする。" voices=""/>
		<msg @l="893" char_id="-1" frame_id="-1" name=""
		   text="はっ、と気がつくと周りの人が一斉にこちらを見ていた。" voices=""/>
		<msg @l="894" char_id="-1" frame_id="-1" name="" text="思わず大声を出してしまったようだ。"
		   voices=""/>
		<msg @l="896" char_id="0" frame_id="-1" name="美帆" text="『す、すみません‥‥。』"
		   voices=""/>
		<msg @l="898" char_id="-1" frame_id="-1" name="" text="私は謝りながらうつむいた。"
		   voices=""/>
		<msg @l="899" char_id="-1" frame_id="-1" name="" text="恥ずかしいよ‥‥うう‥‥‥。"
		   voices=""/>
		<msg @l="901" char_id="3" frame_id="-1" name="女の子" text="『大丈夫？』" voices=""/>
		<msg @l="903" char_id="0" frame_id="-1" name="美帆" text="『あ‥‥‥、ええ‥‥。』"
		   voices=""/>
		<msg @l="905" char_id="-1" frame_id="-1" name=""
		   text="‥‥この子はまるで私の心を見透かしているかのようだ。" voices=""/>
		<msg @l="906" char_id="-1" frame_id="-1" name=""
		   text="ただ、そこには微塵の悪意も感じられなかったが‥‥背筋が寒くなる違和感が残った。" voices=""/>
		<msg @l="908" char_id="0" frame_id="-1" name="美帆"
		   text="『‥‥そうやって、何でも言い当てちゃうんですね。』" voices=""/>
		<msg @l="910" char_id="3" frame_id="-1" name="女の子"
		   text="『違う‥‥感じるんだよ、なんとなく。』" voices=""/>
		<msg @l="912" char_id="0" frame_id="-1" name="美帆" text="『感じる‥‥？』" voices=""/>
		<msg @l="914" char_id="3" frame_id="-1" name="女の子" text="『そう。』" voices=""/>
		<msg @l="916" char_id="3" frame_id="-1" name="女の子"
		   text="『痛みとか悲しみとか辛さとか苦しみとか‥‥そういうの。』" voices=""/>
		<msg @l="918" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="920" char_id="0" frame_id="-1" name="美帆"
		   text="(別に、心を読まれてるワケじゃ‥‥ないんだ)" voices=""/>
		<msg @l="922" char_id="-1" frame_id="-1" name=""
		   text="そんな風に考えて、自分が彼女のどこか不思議なところを受け入れようとしている事に驚く。" voices=""/>
		<msg @l="924" char_id="0" frame_id="-1" name="美帆"
		   text="(現実味がないから‥‥ううん、彼女に悪意がないからなのかな)" voices=""/>
		<msg @l="926" char_id="3" frame_id="-1" name="女の子" text="『私は奈那子‥‥浅間奈那子。』"
		   voices=""/>
		<msg @l="928" char_id="0" frame_id="-1" name="美帆"
		   text="『え、あ‥‥‥‥私は仲根美帆‥‥です。』" voices=""/>
		<msg @l="930" char_id="3" frame_id="-1" name="奈那子" text="『よろしく、美帆。』"
		   voices=""/>
		<msg @l="932" char_id="0" frame_id="-1" name="美帆" text="『よ‥‥よろしく。』"
		   voices=""/>
		<clear @l="938" class="all"/>
		<msgshow @l="940" show="true"/>
		<wait_chgmv/>
		<bg @l="944" src="bg09"/>
		<char @l="948" id="miho" pos="left" src="miho116"/>
		<char @l="952" id="nanak" pos="right" src="nanako010"/>
		<msg @l="954" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="956" char_id="3" frame_id="-1" name="奈那子" text="『‥‥‥‥。』" voices=""/>
		<msg @l="958" char_id="-1" frame_id="-1" name=""
		   text="講義の後‥‥私たちは、肩を並べて廊下を歩いていた。" voices=""/>
		<msg @l="959" char_id="-1" frame_id="-1" name=""
		   text="今日はいつも講義で一緒になる友達が来ていなかった。" voices=""/>
		<msg @l="960" char_id="-1" frame_id="-1" name=""
		   text="偶然、私も彼女も次の講義が同じ校舎だった。" voices=""/>
		<msg @l="961" char_id="-1" frame_id="-1" name=""
		   text="だから、全ては運命の巡り合わせ‥‥なのかもしれない‥‥かな？" voices=""/>
		<msg @l="963" char_id="0" frame_id="-1" name="美帆" text="(ちょっと‥‥気まずいな‥‥‥‥)"
		   voices=""/>
		<msg @l="965" char_id="-1" frame_id="-1" name=""
		   text="運命のめぐり合わせ、と思っても素直に彼女を受け入れるのは‥‥何となく抵抗があった。" voices=""/>
		<msg @l="966" char_id="-1" frame_id="-1" name=""
		   text="浅間さんの接し方が馴れ馴れしく感じてしまうと言ってしまえばそれまでだ。" voices=""/>
		<msg @l="967" char_id="-1" frame_id="-1" name=""
		   text="けれど、友達の出来るきっかけなんて得てしてそんなものなのかもしれない。" voices=""/>
		<msg @l="968" char_id="-1" frame_id="-1" name=""
		   text="最近良く一緒にお話をする友達も、最初は不自然で馴れ馴れしかったような気がする。" voices=""/>
		<msg @l="969" char_id="-1" frame_id="-1" name=""
		   text="でも、それも時間をかけて付き合うことで、より「自然」になっていった。" voices=""/>
		<msg @l="971" char_id="0" frame_id="-1" name="美帆"
		   text="(私が人見知りし過ぎるだけなんだって、わかってる)" voices=""/>
		<msg @l="973" char_id="0" frame_id="-1" name="美帆" text="(‥‥‥‥でも‥‥今は‥‥‥‥‥)"
		   voices=""/>
		<msg @l="975" char_id="3" frame_id="-1" name="奈那子" text="『‥‥‥‥。』" voices=""/>
		<msg @l="977" char_id="3" frame_id="-1" name="奈那子"
		   text="『美帆は‥‥いつも悲しそうなんだね。』" voices=""/>
		<char @l="981" id="miho" pos="left" src="miho114"/>
		<msg @l="983" char_id="0" frame_id="-1" name="美帆" text="『え‥‥？』" voices=""/>
		<char @l="987" id="nanak" pos="right" src="nanako019"/>
		<msg @l="989" char_id="3" frame_id="-1" name="奈那子"
		   text="『キャンパスとか廊下とか‥‥私が見かけると、美帆は必ず悲しそうな顔をしてる。』" voices=""/>
		<msg @l="991" char_id="3" frame_id="-1" name="奈那子" text="『どうして‥‥？』"
		   voices=""/>
		<char @l="995" id="miho" pos="left" src="miho016"/>
		<msg @l="997" char_id="0" frame_id="-1" name="美帆"
		   text="『どうしてって‥‥言われても‥‥‥‥。』" voices=""/>
		<msg @l="999" char_id="-1" frame_id="-1" name="" text="そんな事、自分でも良く解らない。"
		   voices=""/>
		<msg @l="1000" char_id="-1" frame_id="-1" name=""
		   text="私はそんなにずっと悲しそうな顔をしているように見えるのかな‥‥？" voices=""/>
		<msg @l="1001" char_id="-1" frame_id="-1" name="" text="‥‥‥‥。" voices=""/>
		<char @l="1005" id="nanak" pos="right" src="nanako010"/>
		<msg @l="1007" char_id="3" frame_id="-1" name="奈那子"
		   text="『兄様が言ってた、笑うと幸せになれるって。』" voices=""/>
		<msg @l="1009" char_id="3" frame_id="-1" name="奈那子"
		   text="『逆に、悲しんでばかりいると‥‥本当に不幸になっちゃうんだよ。』" voices=""/>
		<char @l="1013" id="miho" pos="left" src="miho010"/>
		<msg @l="1015" char_id="0" frame_id="-1" name="美帆" text="『‥‥兄様‥‥？』"
		   voices=""/>
		<msg @l="1017" char_id="-1" frame_id="-1" name="" text="ふと一ヶ月前のことが思い返される。"
		   voices=""/>
		<msg @l="1018" char_id="-1" frame_id="-1" name=""
		   text="彼女と一緒に居た、無愛想で無口な男性が‥‥恐らく「兄様」なのだろう。" voices=""/>
		<msg @l="1020" char_id="3" frame_id="-1" name="奈那子" text="『美帆は笑った方が可愛いよ。』"
		   voices=""/>
		<char @l="1024" id="miho" pos="left" src="miho014"/>
		<msg @l="1026" char_id="0" frame_id="-1" name="美帆" text="『えっ‥‥。』" voices=""/>
		<char @l="1030" id="miho" pos="left" src="miho016"/>
		<msg @l="1032" char_id="0" frame_id="-1" name="美帆" text="『そ、そんなこと‥‥‥。』"
		   voices=""/>
		<char @l="1036" id="nanak" pos="right" src="nanako011"/>
		<msg @l="1038" char_id="3" frame_id="-1" name="奈那子" text="『うん、笑った方がいいよ。絶対。』"
		   voices=""/>
		<msg @l="1040" char_id="-1" frame_id="-1" name=""
		   text="浅間さんはもう一度そう言って、にっこりと笑った。" voices=""/>
		<char @l="1052" id="miho" pos="left" src="miho010"/>
		<char @l="1056" id="nanak" pos="right" src="nanako011"/>
		<msg @l="1058" char_id="3" frame_id="-1" name="奈那子" text="『私、こっち。』"
		   voices=""/>
		<msg @l="1060" char_id="-1" frame_id="-1" name=""
		   text="目的の校舎へとたどり着いて二つ目の曲がり角で、浅間さんが立ち止まる。" voices=""/>
		<msg @l="1061" char_id="-1" frame_id="-1" name=""
		   text="それまでも大した会話があるわけでもなく、私たちはただ肩を並べて歩いているだけだった。" voices=""/>
		<msg @l="1062" char_id="-1" frame_id="-1" name=""
		   text="けれど何故か浅間さんは楽しそうで、笑顔を絶やす事も無く‥‥。" voices=""/>
		<msg @l="1063" char_id="-1" frame_id="-1" name=""
		   text="それも、彼女の「兄様」が笑っていた方が良いと言ったからかな？" voices=""/>
		<char @l="1067" id="miho" pos="left" src="miho016"/>
		<msg @l="1069" char_id="0" frame_id="-1" name="美帆" text="『あ、はい‥‥それじゃあ。』"
		   voices=""/>
		<msg @l="1071" char_id="-1" frame_id="-1" name=""
		   text="私は少しだけ言葉に詰まり、それから無難な台詞を選んで答える。" voices=""/>
		<msg @l="1072" char_id="-1" frame_id="-1" name=""
		   text="またね‥‥というのはおかしい気がしたし、かといって笑顔で手を振るというのも私っぽくない気がしたからだ。" voices=""/>
		<char @l="1076" id="nanak" pos="right" src="nanako010"/>
		<msg @l="1078" char_id="3" frame_id="-1" name="奈那子" text="『‥‥‥‥。』" voices=""/>
		<msg @l="1080" char_id="0" frame_id="-1" name="美帆" text="『な、なんですか？』"
		   voices=""/>
		<msg @l="1082" char_id="-1" frame_id="-1" name=""
		   text="廊下の角で立ち止まったまま、浅間さんはじっと私を見つめている。" voices=""/>
		<msg @l="1083" char_id="-1" frame_id="-1" name=""
		   text="無難すぎる別れの言葉が逆に気に障ったのだろうか。" voices=""/>
		<msg @l="1084" char_id="-1" frame_id="-1" name="" text="それとも‥‥。" voices=""/>
		<msg @l="1086" char_id="3" frame_id="-1" name="奈那子" text="『美帆はいい子だね。』"
		   voices=""/>
		<char @l="1090" id="miho" pos="left" src="miho014"/>
		<msg @l="1092" char_id="0" frame_id="-1" name="美帆"
		   text="『え、それってどういう意味‥‥‥‥ですか？』" voices=""/>
		<char @l="1096" id="nanak" pos="right" src="nanako011"/>
		<msg @l="1098" char_id="3" frame_id="-1" name="奈那子" text="『言葉のまま、美帆はいい子だよ。』"
		   voices=""/>
		<char @l="1102" id="miho" pos="left" src="miho016"/>
		<msg @l="1104" char_id="0" frame_id="-1" name="美帆"
		   text="『いい子って‥‥‥そんなの‥‥‥‥‥。』" voices=""/>
		<char @l="1108" id="nanak" pos="right" src="nanako018"/>
		<msg @l="1110" char_id="3" frame_id="-1" name="奈那子" text="『誰もそう言ってはくれないの？』"
		   voices=""/>
		<msg @l="1112" char_id="0" frame_id="-1" name="美帆"
		   text="『い、言いませんよ‥‥そんな、子供じゃないんですから。』" voices=""/>
		<msg @l="1114" char_id="3" frame_id="-1" name="奈那子"
		   text="『子供じゃないと言っちゃダメなの？』" voices=""/>
		<msg @l="1116" char_id="0" frame_id="-1" name="美帆"
		   text="『それは‥‥‥そうですよ、いい子だなんて‥‥‥‥‥。』" voices=""/>
		<msg @l="1118" char_id="-1" frame_id="-1" name=""
		   text="この歳でそんな事を言われても、からかわれているとしか思えない。" voices=""/>
		<char @l="1122" id="nanak" pos="right" src="nanako011"/>
		<msg @l="1124" char_id="3" frame_id="-1" name="奈那子"
		   text="『兄様は言ってくれるよ、奈那子はいい子だなって。』" voices=""/>
		<char @l="1128" id="nanak" pos="right" src="nanako012"/>
		<msg @l="1130" char_id="3" frame_id="-1" name="奈那子"
		   text="『私は、兄様がそう言ってくれるのが一番嬉しいよ。』" voices=""/>
		<char @l="1134" id="nanak" pos="right" src="nanako018"/>
		<msg @l="1136" char_id="3" frame_id="-1" name="奈那子" text="『美帆は‥‥嬉しくないの？』"
		   voices=""/>
		<char @l="1140" id="miho" pos="left" src="miho110"/>
		<msg @l="1142" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="1144" char_id="-1" frame_id="-1" name=""
		   text="きっと、彼女のお兄さんは真の意味で「いい子」だと言っているのだろう。" voices=""/>
		<msg @l="1145" char_id="-1" frame_id="-1" name=""
		   text="だから彼女はこんなにも素直に喜べて、また素直に受け止められるのだ。" voices=""/>
		<msg @l="1146" char_id="-1" frame_id="-1" name="" text="私はどうだろう‥‥？"
		   voices=""/>
		<msg @l="1147" char_id="-1" frame_id="-1" name=""
		   text="「いい子」と言われて、素直に喜べるだろうか？" voices=""/>
		<msg @l="1149" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥私は‥‥‥‥。』"
		   voices=""/>
		<se @l="1153" buf="1" src="予鈴" volume="1."/>
		<char @l="1157" id="miho" pos="left" src="miho114"/>
		<msg @l="1159" char_id="0" frame_id="-1" name="美帆" text="『あ‥‥。』" voices=""/>
		<msg @l="1161" char_id="-1" frame_id="-1" name=""
		   text="タイミング悪く‥‥講義開始５分前を報せる予鈴が鳴る。" voices=""/>
		<msg @l="1162" char_id="-1" frame_id="-1" name=""
		   text="いや、返答に困っていた私にしてみればむしろ助け舟かも‥‥。" voices=""/>
		<char @l="1166" id="nanak" pos="right" src="nanako010"/>
		<msg @l="1168" char_id="3" frame_id="-1" name="奈那子" text="『もういかなきゃ。』"
		   voices=""/>
		<msg @l="1170" char_id="0" frame_id="-1" name="美帆" text="『浅間さん、私‥‥。』"
		   voices=""/>
		<char @l="1174" id="nanak" pos="right" src="nanako011"/>
		<msg @l="1176" char_id="3" frame_id="-1" name="奈那子"
		   text="『美帆は美帆のままでいいと思うよ。』" voices=""/>
		<char @l="1180" id="miho" pos="left" src="miho014"/>
		<msg @l="1182" char_id="0" frame_id="-1" name="美帆" text="『え‥‥？』" voices=""/>
		<msg @l="1184" char_id="3" frame_id="-1" name="奈那子" text="『大丈夫‥‥さみしくなんかない。』"
		   voices=""/>
		<char @l="1188" id="nanak" pos="right" src="nanako010"/>
		<msg @l="1190" char_id="3" frame_id="-1" name="奈那子"
		   text="『何が大切なのかは人それぞれ違うものなんだよ、美帆。』" voices=""/>
		<char @l="1194" id="nanak" pos="right" src="nanako011"/>
		<msg @l="1196" char_id="3" frame_id="-1" name="奈那子" text="『これも兄様の受け売りだけどね。』"
		   voices=""/>
		<clear @l="1200" layer="nanak"/>
		<msg @l="1202" char_id="-1" frame_id="-1" name=""
		   text="彼女はそう言って笑うと、講堂へ向かいスタスタと歩いて行く。" voices=""/>
		<msg @l="1204" char_id="0" frame_id="-1" name="美帆" text="『あっ‥‥浅間さんっ！』"
		   voices=""/>
		<msg @l="1206" char_id="-1" frame_id="-1" name=""
		   text="私は思わず引き止めの言葉を発し、手を伸ばしてしまう。" voices=""/>
		<msg @l="1207" char_id="-1" frame_id="-1" name=""
		   text="一ヶ月前と同じ‥‥引き止めた所でなにも出来はしないのに。" voices=""/>
		<char @l="1211" id="nanak" pos="right" src="nanako010"/>
		<msg @l="1213" char_id="3" frame_id="-1" name="奈那子" text="『奈那子、がいいな。』"
		   voices=""/>
		<msg @l="1215" char_id="0" frame_id="-1" name="美帆" text="『え‥‥。』" voices=""/>
		<char @l="1219" id="nanak" pos="right" src="nanako011"/>
		<msg @l="1221" char_id="3" frame_id="-1" name="奈那子"
		   text="『奈那子って呼んでくれた方が、私は嬉しいよ。』" voices=""/>
		<msg @l="1223" char_id="-1" frame_id="-1" name=""
		   text="浅間‥‥奈那子さんはそう言って振り返り、にっこりと笑う。" voices=""/>
		<clear @l="1227" layer="nanak"/>
		<msg @l="1229" char_id="-1" frame_id="-1" name="" text="そうして、講堂の中へと入っていった。"
		   voices=""/>
		<stopbgm @l="1233" fadeout="1000"/>
		<clear @l="1239" class="all"/>
		<msgshow @l="1241" show="true"/>
		<se @l="1245" buf="1" src="ノック2" volume="1."/>
		<msg @l="1247" char_id="0" frame_id="-1" name="美帆" text="『先輩、入りますよ。』"
		   voices=""/>
		<msg @l="1249" char_id="1" frame_id="-1" name="玲" text="『どうぞ。』" voices=""/>
		<se @l="1253" buf="1" src="扉を開ける音_木製" volume="1."/>
		<wait_chgmv/>
		<bg @l="1257" src="bg02b"/>
		<bgm @l="1261" src="bgm05" volume="1."/>
		<char @l="1265" id="miho" pos="auto" src="miho030"/>
		<msg @l="1267" char_id="0" frame_id="-1" name="美帆" text="『お風呂、あがりました。』"
		   voices=""/>
		<msg @l="1269" char_id="1" frame_id="-1" name="玲" text="『ありがとう、私もすぐに入るわ。』"
		   voices=""/>
		<msg @l="1271" char_id="-1" frame_id="-1" name=""
		   text="白石先輩は机に向かったまま、視線だけコチラに向けて答える。" voices=""/>
		<msg @l="1272" char_id="-1" frame_id="-1" name=""
		   text="机の上には書類の数々が並べられているから、レポートか何かの途中だろう。" voices=""/>
		<char @l="1276" id="miho" pos="auto" src="miho034"/>
		<msg @l="1278" char_id="0" frame_id="-1" name="美帆" text="『‥‥大変そうですね？』"
		   voices=""/>
		<msg @l="1280" char_id="1" frame_id="-1" name="玲"
		   text="『大変っていうよりも面倒ね‥‥時間ばっかり掛かって、単調で。』" voices=""/>
		<char @l="1284" id="miho" pos="auto" src="miho030"/>
		<msg @l="1286" char_id="0" frame_id="-1" name="美帆" text="『レポートですか？』"
		   voices=""/>
		<msg @l="1288" char_id="1" frame_id="-1" name="玲" text="『んっっ‥‥‥違うわよ。』"
		   voices=""/>
		<clear @l="1291" class="char"/>
		<char @l="1295" id="miho" pos="left" src="miho030"/>
		<char @l="1299" id="rei" pos="right" src="rei030"/>
		<msg @l="1301" char_id="1" frame_id="-1" name="玲"
		   text="『今週、大黒建設で試験があるって言ったでしょ？&#32;あれの準備よ。』" voices=""/>
		<msg @l="1303" char_id="-1" frame_id="-1" name=""
		   text="そう言って先輩は書類の一枚をコチラに向かってヒラヒラと揺らす。" voices=""/>
		<msg @l="1304" char_id="-1" frame_id="-1" name=""
		   text="書面には細かな文字がびっしりと並んでいた。" voices=""/>
		<msg @l="1306" char_id="0" frame_id="-1" name="美帆" text="『試験、いつなんですか？』"
		   voices=""/>
		<msg @l="1308" char_id="1" frame_id="-1" name="玲"
		   text="『明後日よ。明日はまだ他にも試験の準備があるから朝から事務局に行かなくちゃ。』" voices=""/>
		<char @l="1312" id="miho" pos="left" src="miho034"/>
		<msg @l="1314" char_id="0" frame_id="-1" name="美帆"
		   text="『あ‥‥それじゃあ明日は一緒の電車で行きませんか？』" voices=""/>
		<char @l="1318" id="rei" pos="right" src="rei034"/>
		<msg @l="1320" char_id="1" frame_id="-1" name="玲"
		   text="『え、アナタ‥‥明日は三限からでしょ？』" voices=""/>
		<msg @l="1322" char_id="1" frame_id="-1" name="玲"
		   text="『私、お昼には戻って来たいから結構早いわよ？』" voices=""/>
		<char @l="1326" id="miho" pos="left" src="miho036"/>
		<msg @l="1328" char_id="0" frame_id="-1" name="美帆"
		   text="『その‥‥できれば、一人で電車に乗りたくなくて。』" voices=""/>
		<char @l="1332" id="rei" pos="right" src="rei030"/>
		<msg @l="1334" char_id="1" frame_id="-1" name="玲" text="『どういうこと？』" voices=""/>
		<char @l="1337" id="miho" pos="left" src="miho136"/>
		<msg @l="1339" char_id="0" frame_id="-1" name="美帆" text="『それは‥‥。』" voices=""/>
		<msg @l="1341" char_id="-1" frame_id="-1" name=""
		   text="何気ない疑問の言葉に、私は思わずうつむいてしまう。" voices=""/>
		<msg @l="1342" char_id="-1" frame_id="-1" name=""
		   text="先輩のことは信頼しているし良い人だと思うけれど、一人で電車に乗りたくない理由が痴漢に遭うのが怖いからというのは‥‥ちょっと言い出し辛い。"
		   voices=""/>
		<char @l="1346" id="miho" pos="left" src="miho136"/>
		<msg @l="1348" char_id="0" frame_id="-1" name="美帆" text="『‥‥ごめんなさい。』"
		   voices=""/>
		<char @l="1352" id="rei" pos="right" src="rei031"/>
		<msg @l="1354" char_id="1" frame_id="-1" name="玲"
		   text="『まあ、言いにくいのなら無理に言う必要はないわ。』" voices=""/>
		<char @l="1358" id="rei" pos="right" src="rei030"/>
		<msg @l="1360" char_id="1" frame_id="-1" name="玲"
		   text="『ただ‥‥自分一人じゃどうにもならない時は遠慮なく相談してちょうだい。』" voices=""/>
		<msg @l="1361" char_id="1" frame_id="-1" name="玲"
		   text="『あまり力にはなれないかもしれないけど、一人で悩んで潰れちゃうよりマシだと思うから。』" voices=""/>
		<char @l="1365" id="miho" pos="left" src="miho130"/>
		<msg @l="1367" char_id="0" frame_id="-1" name="美帆" text="『ありがとうございます‥‥。』"
		   voices=""/>
		<msg @l="1369" char_id="0" frame_id="-1" name="美帆"
		   text="『でも‥‥その、一緒の電車に乗ってもらえるだけで十分ですから。』" voices=""/>
		<msg @l="1371" char_id="1" frame_id="-1" name="玲" text="『‥‥‥‥。』" voices=""/>
		<msg @l="1373" char_id="1" frame_id="-1" name="玲"
		   text="『なるほど、単なるホームシックってワケじゃなさそうね。』" voices=""/>
		<char @l="1377" id="miho" pos="left" src="miho136"/>
		<msg @l="1379" char_id="0" frame_id="-1" name="美帆"
		   text="『ごめんなさい‥‥理由も言わずにわがままばっかりで。』" voices=""/>
		<msg @l="1381" char_id="1" frame_id="-1" name="玲"
		   text="『別に良いわ、気にしてないわよ。明日は一緒に出ましょう。』" voices=""/>
		<char @l="1385" id="rei" pos="right" src="rei031"/>
		<msg @l="1387" char_id="1" frame_id="-1" name="玲"
		   text="『その代わり‥‥朝ゴハン、美味しいのをお願いね。』" voices=""/>
		<msg @l="1389" char_id="-1" frame_id="-1" name=""
		   text="そう言って、白石先輩はおどけた笑みを浮かべて見せた。" voices=""/>
		<char @l="1392" id="miho" pos="left" src="miho131"/>
		<msg @l="1394" char_id="0" frame_id="-1" name="美帆" text="『は、はい。』" voices=""/>
		<stopbgm @l="1398" fadeout="1000"/>
		<clear @l="1404" class="all"/>
		<call @l="1408" target="EventLabel_27@common_root03"/>
		<return @l="1409" value="0&#13;&#10;"/>
	</code>
</xscript>
