<?xml version="1.0" encoding="utf-8"?>
<xscript>
	<debug editor="&quot;C:\Program&#32;Files&#32;(x86)\sakura\sakura.exe&quot;&#32;&quot;%src%&quot;&#32;-Y=%line%"
	   src="D:\シロップ\町ぐるみの罠＋汚された夏セット版\汚された夏\完成データ\汚された夏\script\text\common_root01.txt"/>
	<code>
		<label @l="17" id="EventLabel_19"/>
		<description @l="22" text="始まりの日"/>
		<eval @l="24" expr="f.numDay=1&#13;&#10;"/>
		<msgshow @l="26" show="false"/>
		<wait_chgmv/>
		<bg @l="28" src="day01" time="2000"/>
		<wait @l="30" time="500"/>
		<wait_chgmv/>
		<bg @l="32" src="black" time="2000"/>
		<msgshow @l="34" show="true"/>
		<wait_chgmv/>
		<bg @l="38" src="bg03"/>
		<char @l="42" id="miho" pos="center" src="miho030"/>
		<bgm @l="46" src="bgm02" volume="1."/>
		<msg @l="48" char_id="0" frame_id="-1" name="美帆" text="『先輩、朝ゴハン出来ましたよー。』"
		   voices=""/>
		<msg @l="50" char_id="0" frame_id="-1" name="美帆"
		   text="『冷めちゃいますから、早目に食べて下さいねー。』" voices=""/>
		<msg @l="52" char_id="-1" frame_id="-1" name=""
		   text="私はキッチンからひょこっと頭だけを出して、リビングで『朝のズームアップ！』に見入っている白石先輩に声をかける。" voices=""/>
		<msg @l="53" char_id="-1" frame_id="-1" name="" text="あの、驚きの入居日から早くも一ヶ月余り。"
		   voices=""/>
		<msg @l="54" char_id="-1" frame_id="-1" name=""
		   text="少しずつこの同居生活にも慣れてきて、今ではそれなりに「自然体」での付き合いが出来るようになった‥‥気がしている。" voices=""/>
		<msg @l="56" char_id="1" frame_id="-1" name="玲"
		   text="『ありがと。置いておいてくれれば食べるわ。』" voices=""/>
		<msg @l="58" char_id="0" frame_id="-1" name="美帆" text="『「ズームアップ」‥‥楽しいですか？』"
		   voices=""/>
		<msg @l="60" char_id="1" frame_id="-1" name="玲"
		   text="『バラエティ的な要素が強いけど‥‥それなりに面白いわよ。』" voices=""/>
		<char @l="64" id="miho" pos="center" src="miho036"/>
		<msg @l="66" char_id="0" frame_id="-1" name="美帆"
		   text="『ふ～ん‥‥私には良くわかりませんけど‥‥。』" voices=""/>
		<clear @l="69" class="char"/>
		<char @l="71" id="miho" pos="left" src="miho036"/>
		<char @l="73" id="rei" pos="right" src="rei031"/>
		<msg @l="75" char_id="1" frame_id="-1" name="玲"
		   text="『まあ、主要なニュースもちゃんとやるし、時事ネタを押さえるにはお堅いニュースだけよりいいかなって。朝の占いも毎日欠かさないわよ～。』"
		   voices=""/>
		<msg @l="77" char_id="0" frame_id="-1" name="美帆" text="『うっ占いですか‥‥。当たりますか？』"
		   voices=""/>
		<char @l="80" id="rei" pos="right" src="rei030"/>
		<msg @l="82" char_id="1" frame_id="-1" name="玲" text="『気分の問題よ。』" voices=""/>
		<msg @l="84" char_id="-1" frame_id="-1" name=""
		   text="そう言って白石先輩はお皿の上からトーストを手に取り、口へと運ぶ。" voices=""/>
		<msg @l="85" char_id="-1" frame_id="-1" name=""
		   text="そんなに熱心には見てないと口では言いながらも、視線はテレビに向けられたまま集中している先輩を見ていると、なんだか可愛らしかった。"
		   voices=""/>
		<char @l="88" id="miho" pos="left" src="miho130"/>
		<msg @l="90" char_id="0" frame_id="-1" name="美帆"
		   text="『それじゃあ私、今日は一限からなんでシャワーお先です。』" voices=""/>
		<char @l="93" id="rei" pos="right" src="rei031"/>
		<msg @l="95" char_id="1" frame_id="-1" name="玲" text="『いいわよ。今日は私三限からだから。』"
		   voices=""/>
		<msg @l="97" char_id="0" frame_id="-1" name="美帆" text="『先輩、就職活動されないんですか？』"
		   voices=""/>
		<msg @l="99" char_id="1" frame_id="-1" name="玲"
		   text="『あら、こう見えてもちゃんと活動してるのよ？』" voices=""/>
		<msg @l="101" char_id="1" frame_id="-1" name="玲"
		   text="『今は採用試験待ちだからちょっと暇してるだけ。』" voices=""/>
		<msg @l="103" char_id="0" frame_id="-1" name="美帆"
		   text="『先輩、学科は建築ですよね？&#32;デザイナー志望ですか？』" voices=""/>
		<msg @l="105" char_id="1" frame_id="-1" name="玲"
		   text="『そうよ。この辺りで最大手の大黒（おおぐろ）建設が第一候補よ。』" voices=""/>
		<msg @l="107" char_id="0" frame_id="-1" name="美帆"
		   text="『大黒建設って、この南総町に大学を誘致する協力をした建設会社の？』" voices=""/>
		<msg @l="109" char_id="1" frame_id="-1" name="玲"
		   text="『ええ。今週ちょうど最初の試験があるのよ。まだ面接じゃなくて筆記とかレポートだけどね。』" voices=""/>
		<char @l="113" id="miho" pos="left" src="miho034"/>
		<msg @l="115" char_id="0" frame_id="-1" name="美帆" text="『わ、今週ってもうすぐですね。』"
		   voices=""/>
		<msg @l="117" char_id="1" frame_id="-1" name="玲"
		   text="『女子は戸口が狭いから、最初から気を引き締めていかないとね。やる気をアピールしておかないと、書類だけではじかれちゃうわよ。』"
		   voices=""/>
		<char @l="121" id="miho" pos="left" src="miho030"/>
		<msg @l="123" char_id="0" frame_id="-1" name="美帆" text="『そうなんですか‥‥大変なんですね。』"
		   voices=""/>
		<char @l="127" id="rei" pos="right" src="rei031"/>
		<msg @l="129" char_id="1" frame_id="-1" name="玲"
		   text="『あら、貴女も他人事みたいに思ってると来年苦労するわよ。』" voices=""/>
		<char @l="133" id="miho" pos="left" src="miho036"/>
		<msg @l="135" char_id="0" frame_id="-1" name="美帆"
		   text="『こ、怖い事言わないでくださいよ‥‥。』" voices=""/>
		<msg @l="137" char_id="1" frame_id="-1" name="玲"
		   text="『ふふ、冗談よ‥‥でも早目に動いておいた方が良いわね。』" voices=""/>
		<char @l="141" id="rei" pos="right" src="rei030"/>
		<msg @l="143" char_id="1" frame_id="-1" name="玲"
		   text="『特に早いうちに学科の教授とコネを作っておくと、後々が楽よ。』" voices=""/>
		<char @l="147" id="miho" pos="left" src="miho034"/>
		<msg @l="149" char_id="0" frame_id="-1" name="美帆" text="『コネ‥‥ですか。』"
		   voices=""/>
		<char @l="153" id="miho" pos="left" src="miho036"/>
		<msg @l="155" char_id="0" frame_id="-1" name="美帆" text="『私、そういうのって苦手です‥‥。』"
		   voices=""/>
		<msg @l="157" char_id="0" frame_id="-1" name="美帆"
		   text="『なんだか自分の力で勝負してないっていうか、ズルイっていうか。』" voices=""/>
		<msg @l="159" char_id="1" frame_id="-1" name="玲" text="『‥‥ふぅ。』" voices=""/>
		<msg @l="161" char_id="1" frame_id="-1" name="玲" text="『アナタはきっと真面目過ぎるのね。』"
		   voices=""/>
		<msg @l="163" char_id="1" frame_id="-1" name="玲"
		   text="『人間は正しい事だけではやっていけないと思った方が良いわよ。もう少し肩の力を抜いて気楽に生きてみなさいな。』" voices=""/>
		<msg @l="165" char_id="0" frame_id="-1" name="美帆" text="『よく‥‥解りません。』"
		   voices=""/>
		<msg @l="167" char_id="1" frame_id="-1" name="玲"
		   text="『そうね、すぐには解らなくても良いと思うわ。』" voices=""/>
		<msg @l="169" char_id="1" frame_id="-1" name="玲"
		   text="『ほら‥‥早くしないと遅刻しちゃうわよ。』" voices=""/>
		<char @l="173" id="miho" pos="left" src="miho034"/>
		<msg @l="175" char_id="0" frame_id="-1" name="美帆" text="『あ、はいっ‥‥。』"
		   voices=""/>
		<clear @l="179" layer="miho"/>
		<msg @l="181" char_id="1" frame_id="-1" name="玲" text="『‥‥‥‥‥。』" voices=""/>
		<msg @l="183" char_id="1" frame_id="-1" name="玲" text="『‥‥良いわね、初々しくて。』"
		   voices=""/>
		<clear @l="189" class="all"/>
		<msgshow @l="191" show="true"/>
		<wait_chgmv/>
		<bg @l="195" src="bg03"/>
		<char @l="199" id="miho" pos="auto" src="miho010"/>
		<msg @l="201" char_id="0" frame_id="-1" name="美帆" text="『じゃ、行って来ます。』"
		   voices=""/>
		<msg @l="203" char_id="-1" frame_id="-1" name=""
		   text="シャワーを浴び、身支度を整えた私はリビングに戻って外出の挨拶をする。" voices=""/>
		<msg @l="204" char_id="-1" frame_id="-1" name=""
		   text="実家ではずっとしていた事だから私としては普通なのだけれど、白石先輩には「相変わらず真面目ね」と言われてしまった。" voices=""/>
		<msg @l="205" char_id="-1" frame_id="-1" name=""
		   text="習慣付いてしまったものなので、私にとってはそれが自然なのだけれど。それって、真面目なのかな？" voices=""/>
		<clear @l="208" class="char"/>
		<char @l="210" id="miho" pos="left" src="miho010"/>
		<char @l="213" id="rei" pos="right" src="rei030"/>
		<msg @l="215" char_id="1" frame_id="-1" name="玲"
		   text="『気を付けて。最近電車内での痴漢が増えてるみたいだから。』" voices=""/>
		<char @l="219" id="miho" pos="left" src="miho016"/>
		<msg @l="221" char_id="0" frame_id="-1" name="美帆" text="『痴漢ですか‥‥嫌ですね。』"
		   voices=""/>
		<msg @l="223" char_id="1" frame_id="-1" name="玲"
		   text="『貴女みたいな可愛いくて大人しい子は一番危険なんだから。狙われないように注意しなさい。』" voices=""/>
		<msg @l="225" char_id="0" frame_id="-1" name="美帆"
		   text="『えっ‥‥でも私なんて地味だし‥‥‥。』" voices=""/>
		<msg @l="227" char_id="1" frame_id="-1" name="玲" text="『ふふ、とにかく気を付けなさい。』"
		   voices=""/>
		<msg @l="229" char_id="0" frame_id="-1" name="美帆" text="『が、頑張ります。』"
		   voices=""/>
		<clear @l="235" class="all"/>
		<msgshow @l="237" show="true"/>
		<msg @l="239" char_id="-1" frame_id="-1" name="" text="‥‥‥‥‥‥‥‥。" voices=""/>
		<wait_chgmv/>
		<bg @l="243" src="bg18m1"/>
		<char @l="247" id="miho" pos="auto" src="miho110"/>
		<msg @l="249" char_id="-1" frame_id="-1" name=""
		   text="一ヶ月前よりは多少慣れた足取りで、私は停留所を目指して歩いていた。" voices=""/>
		<msg @l="250" char_id="-1" frame_id="-1" name=""
		   text="停留所に近付くにつれて、同じ大学行きの電車に乗ろうとしている同年代の姿が増えてくる。" voices=""/>
		<msg @l="251" char_id="-1" frame_id="-1" name=""
		   text="人ごみの苦手な私は、通学ラッシュになることが解っていても電車に乗らなくちゃならないという状態が凄くつらい。" voices=""/>
		<msg @l="252" char_id="-1" frame_id="-1" name=""
		   text="前の学校では普通よりも何本か早い電車を使って登校していたものだけれど、一日の本数が極端に少ない区間電車ではしょうがない。"
		   voices=""/>
		<msg @l="253" char_id="-1" frame_id="-1" name=""
		   text="何せ今から乗ろうとしている電車がこの路線の始発なのだ。" voices=""/>
		<msg @l="254" char_id="-1" frame_id="-1" name=""
		   text="次の電車でもかろうじて一限には間に合うけれど、始発以上に混雑してしまう。" voices=""/>
		<msg @l="255" char_id="-1" frame_id="-1" name=""
		   text="地区毎に備えられた完全ローカルな電車だからこそ現状の本数でも問題ないのだろうが、もう少し利用者の事を考えて欲しい‥‥。"
		   voices=""/>
		<wait_chgmv/>
		<bg @l="259" src="bg21m1"/>
		<char @l="263" id="miho" pos="auto" src="miho116"/>
		<msg @l="265" char_id="0" frame_id="-1" name="美帆"
		   text="(はぁ‥‥これだけはどうしても憂鬱だなぁ)" voices=""/>
		<msg @l="267" char_id="-1" frame_id="-1" name=""
		   text="停留所に出来た電車待ち行列の最後尾へ並んですぐ、私は小さくため息をつく。" voices=""/>
		<msg @l="268" char_id="-1" frame_id="-1" name=""
		   text="するとすぐに電車が着て、行列は続々と電車の中へと流れていく。" voices=""/>
		<msg @l="269" char_id="-1" frame_id="-1" name=""
		   text="私もまた、後ろの人に急かされるように電車の中へと押し込まれていった。" voices=""/>
		<clear @l="275" class="all"/>
		<label @l="278" id="event_scene05_1"/>
		<msgshow @l="281" show="true"/>
		<se @l="285" buf="3" loop="true" src="電車走行中" volume="1."/>
		<msg @l="287" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』"
		   voices="miho00160"/>
		<label @l="291" id="chart_line3"/>
		<eval @l="294" expr="s.event5flag=0&#13;&#10;"/>
		<wait_chgmv/>
		<ev @l="298" src="ev-005"/>
		<msg @l="300" char_id="0" frame_id="-1" name="美帆" text="(人‥‥相変わらず多いなぁ)"
		   voices="miho00170"/>
		<msg @l="302" char_id="0" frame_id="-1" name="美帆"
		   text="(それに何だか最近、妙に男の人が多いのよね‥‥)" voices="miho00180"/>
		<msg @l="304" char_id="-1" frame_id="-1" name=""
		   text="ここ一週間くらい前からだろうか、車内の男女比率が少しずつ変化しているように感じ始めたのは。" voices=""/>
		<msg @l="305" char_id="-1" frame_id="-1" name=""
		   text="転入当初は同じくらいだったのが、一週間くらい前からなんだか男の人ばかりになっている気がする。" voices=""/>
		<msg @l="307" char_id="0" frame_id="-1" name="美帆"
		   text="(そういえば痴漢が出るって白石先輩言ってたし、皆それを警戒して電車の時間とか変えてるのかな‥‥)"
		   voices="miho00190"/>
		<msg @l="309" char_id="-1" frame_id="-1" name=""
		   text="だとしたら、私も明日から電車の時間を変えなければいけないだろうか。" voices=""/>
		<msg @l="310" char_id="-1" frame_id="-1" name=""
		   text="満員電車に乗るのはもちろん嫌だけれど、痴漢に遭うのは絶対に嫌だ。" voices=""/>
		<msg @l="312" char_id="0" frame_id="-1" name="美帆" text="(とりあえず様子を見て、かなぁ‥‥)"
		   voices="miho00200"/>
		<msg @l="314" char_id="-1" frame_id="-1" name=""
		   text="ぼんやりとそんな事を考えながら電車の振動に身を任せていると、ふとした瞬間から腰の辺りで何かが蠢いている事に気付く。"
		   voices=""/>
		<stopbgm @l="318" fadeout="1000"/>
		<wait_chgmv/>
		<ev @l="322" src="ev-005ax1"/>
		<description @l="325" text="痴漢遭遇"/>
		<msg @l="327" char_id="0" frame_id="-1" name="美帆" text="(え‥‥)"
		   voices="miho00210"/>
		<msg @l="329" char_id="-1" frame_id="-1" name=""
		   text="最初は後ろの人のカバンか何かが当たっているのかとも思ったけれど、どうもカバンにしては動きが奇妙だ。" voices=""/>
		<msg @l="330" char_id="-1" frame_id="-1" name=""
		   text="戸惑っているうちに、腰の辺りを撫でていたそれは少しずつ様子を伺うようにお尻の方へと移動していく。" voices=""/>
		<msg @l="332" char_id="0" frame_id="-1" name="美帆" text="(これって‥‥‥‥痴漢‥‥？？？)"
		   voices="miho00220"/>
		<bgm @l="336" src="bgm15" volume="1."/>
		<msg @l="338" char_id="0" frame_id="-1" name="美帆" text="(‥‥ど、どうしよう‥‥‥)"
		   voices="miho00230"/>
		<msg @l="340" char_id="-1" frame_id="-1" name=""
		   text="白石先輩には「痴漢に気をつけろ」と言われたばかりだけれど、こうして実際に痴漢と遭遇してしまった後で気を付けるも何も無い。"
		   voices=""/>
		<msg @l="341" char_id="-1" frame_id="-1" name=""
		   text="他の女性同様に、私も通学の時間帯をずらせば良かったのかもしれないが、今となってはそれも既に手遅れだ。" voices=""/>
		<msg @l="343" char_id="0" frame_id="-1" name="美帆" text="(と、とにかく何とかしないと‥‥)"
		   voices="miho00240"/>
		<msg @l="347" async="true" char_id="-1" frame_id="-1" name=""
		   text="痴漢に対して私は" voices=""/>
		<select @l="348">
			<menu @l="350" label="EventLabel_20" text="抵抗する"/>
			<menu @l="352" label="EventLabel_21" text="我慢する"/>
		</select>
		<label @l="359" id="EventLabel_20"/>
		<msg @l="362" char_id="0" frame_id="-1" name="美帆" text="『や、やめてください‥‥。』"
		   voices="miho00250"/>
		<msg @l="364" char_id="-1" frame_id="-1" name=""
		   text="私は小さく声を張り上げ身をよじり、お尻を撫でている痴漢の手から逃れようとする。" voices=""/>
		<msg @l="365" char_id="-1" frame_id="-1" name=""
		   text="悲鳴の一つでもあげれば良いのかもしれないけれど、そういう目立った行為にはどうしても拒否感が働いて、全く声が出せなくなってしまう。"
		   voices=""/>
		<msg @l="367" char_id="-1" frame_id="-1" name="痴漢" text="『‥‥‥‥。』" voices=""/>
		<msg @l="369" char_id="-1" frame_id="-1" name="" text="一瞬、私の耳元で痴漢が息を飲む。"
		   voices=""/>
		<msg @l="370" char_id="-1" frame_id="-1" name=""
		   text="もしかしたら怒らせてしまったのではないかと思って肩をすくませていると、お尻を撫でていた手はすっと離れて行った。" voices=""/>
		<msg @l="371" char_id="-1" frame_id="-1" name=""
		   text="良く解らないが、抵抗が効を奏したみたいだ。" voices=""/>
		<stopbgm @l="375" fadeout="1000"/>
		<msg @l="377" char_id="0" frame_id="-1" name="美帆" text="（‥‥良かった)"
		   voices="miho00260"/>
		<msg @l="379" char_id="-1" frame_id="-1" name=""
		   text="私は安堵のため息を漏らし、この電車が一刻も早く大学へ着く事だけを切々と祈っていた。" voices=""/>
		<clear @l="383" class="ev"/>
		<goto @l="386" label="EventLabel_22"/>
		<return @l="388" value=""/>
		<label @l="392" id="EventLabel_21"/>
		<msg @l="395" char_id="0" frame_id="-1" name="美帆"
		   text="(やめてくださいって言いたいけど、下手に騒ぐと周りの人に気付かれちゃうかもしれないし‥‥)" voices="miho00270"/>
		<msg @l="397" char_id="0" frame_id="-1" name="美帆"
		   text="（気付かれたら、痴漢されてるのが私だって皆に知られちゃう‥‥)" voices="miho00280"/>
		<msg @l="399" char_id="0" frame_id="-1" name="美帆"
		   text="(そんなことになったら‥‥‥私、恥ずかしくて電車に乗れないよ‥‥)" voices="miho00290"/>
		<wait_chgmv/>
		<ev @l="403" src="ev-005ax2y1"/>
		<msg @l="405" char_id="-1" frame_id="-1" name=""
		   text="痴漢は私が黙って耐えているのを確認すると、胸に手を伸ばしてきた。" voices=""/>
		<msg @l="406" char_id="-1" frame_id="-1" name=""
		   text="それは脇の下からなぞりあげてくると、純白のブラに包まれた私の胸に服の上からそえられる。" voices=""/>
		<msg @l="408" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥っ‥‥‥。』"
		   voices="miho09930"/>
		<msg @l="410" char_id="-1" frame_id="-1" name=""
		   text="私は一瞬身体をびくっと震わせるが、それ以上は抵抗できず押し黙ってしまう。" voices=""/>
		<msg @l="411" char_id="-1" frame_id="-1" name="" text="さわ、さわ、さわ。" voices=""/>
		<msg @l="412" char_id="-1" frame_id="-1" name=""
		   text="痴漢は胸の上に当てた手を、するっと擦るように動かし始める。" voices=""/>
		<msg @l="413" char_id="-1" frame_id="-1" name=""
		   text="服の上から胸の柔らかな曲線に沿って円を描くように撫で回し、さらに下からすくい上げ、上下に揺さぶるように揉んでくる。"
		   voices=""/>
		<msg @l="414" char_id="-1" frame_id="-1" name=""
		   text="私は胸の上を延々と這いずり回る蟲のような手の感触に、目をギュっとつぶって耐えた。" voices=""/>
		<msg @l="416" char_id="0" frame_id="-1" name="美帆"
		   text="(大学前の停留所まであと１５分だけ‥‥我慢すれば、良いよね？)" voices="miho00300"/>
		<msg @l="418" char_id="-1" frame_id="-1" name="" text="痴漢は怖い。" voices=""/>
		<msg @l="419" char_id="-1" frame_id="-1" name=""
		   text="けれど、自分が痴漢に遭っているという事を周囲の人間に知られるという事が、私にとってそれ以上に恥ずかしい。" voices=""/>
		<msg @l="420" char_id="-1" frame_id="-1" name="" text="だから私は痴漢のなすがままになっていた。"
		   voices=""/>
		<msg @l="421" char_id="-1" frame_id="-1" name="" text="すぐに諦めてくれる。そう信じながら。"
		   voices=""/>
		<msg @l="423" char_id="-1" frame_id="-1" name="痴漢" text="『くくっ‥‥。』" voices=""/>
		<msg @l="424" char_id="-1" frame_id="-1" name=""
		   text="胸を触り続けていた痴漢が、私の耳元でいやらしく笑う。" voices=""/>
		<msg @l="425" char_id="-1" frame_id="-1" name=""
		   text="そして、さらに行為をエスカレートしていく。" voices=""/>
		<msg @l="426" char_id="-1" frame_id="-1" name=""
		   text="乳首の上まで覆いかぶるブラのホックをはずしにかかったのだ。" voices=""/>
		<msg @l="428" char_id="0" frame_id="-1" name="美帆" text="『ひゃっ！』"
		   voices="miho10030"/>
		<msg @l="430" char_id="-1" frame_id="-1" name=""
		   text="私は抵抗することもできず、私の身体を這いずり回る蟲が背中へ移動しホックをはずしにかかったことに耐える以外なかった。"
		   voices=""/>
		<msg @l="431" char_id="-1" frame_id="-1" name=""
		   text="若さで張りのある乳房が戒めを解かれたようにフルンと揺れ、カップがずれ落ちる。" voices=""/>
		<msg @l="433" char_id="0" frame_id="-1" name="美帆" text="『‥‥！？』"
		   voices="miho09970"/>
		<msg @l="435" char_id="-1" frame_id="-1" name=""
		   text="それを待っていたかのように、痴漢の手は白い山の頂を攻めにかかる。" voices=""/>
		<msg @l="436" char_id="-1" frame_id="-1" name=""
		   text="頂上に生息する野苺をくりくりと捏ねくりまわし、白い山は蹂躙された。" voices=""/>
		<msg @l="438" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』"
		   voices="miho00420"/>
		<msg @l="440" char_id="-1" frame_id="-1" name=""
		   text="征服者はさらに、下半身の桃山のようなお尻へ侵略の魔の手を広げる。" voices=""/>
		<msg @l="441" char_id="-1" frame_id="-1" name=""
		   text="痴漢はもう片方の手で、スカートの上から柔らかな曲線美を描く臀部の肉を持ち上げるように揉んで、撫で回してきた。" voices=""/>
		<msg @l="443" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥っ‥‥‥。』"
		   voices="miho09930"/>
		<msg @l="445" char_id="-1" frame_id="-1" name=""
		   text="私はそれから逃れようと壁に身体を密着させるが、痴漢は獲物を逃すまいと首筋に息がかかるくらい密着してくる。" voices=""/>
		<msg @l="446" char_id="-1" frame_id="-1" name=""
		   text="痴漢は美帆を壁に押し付けると、お尻を執拗に触り続ける。" voices=""/>
		<msg @l="448" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』"
		   voices="miho00420"/>
		<msg @l="450" char_id="-1" frame_id="-1" name=""
		   text="その指先がお尻の割れ目を無理やり押し広げようと撫で上げるたびに、美帆の背筋に悪寒が走り首筋にじっとりと汗がにじんできた。"
		   voices=""/>
		<msg @l="452" char_id="0" frame_id="-1" name="美帆" text="(我慢、がまん‥‥)"
		   voices="miho00310"/>
		<msg @l="454" char_id="-1" frame_id="-1" name=""
		   text="しかしその我慢を嘲笑うように、今度はアナル部分をスカート上から無理矢理攻めてくる。" voices=""/>
		<msg @l="456" char_id="-1" frame_id="-1" name=""
		   text="ぐいぐい押してもスカートによって邪魔されるが、確実にアナルに狙いを定めていた。" voices=""/>
		<msg @l="459" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥っ‥‥‥。』"
		   voices="miho09930"/>
		<msg @l="461" char_id="-1" frame_id="-1" name="痴漢" text="『くくくっ‥‥。』"
		   voices=""/>
		<msg @l="463" char_id="-1" frame_id="-1" name=""
		   text="押し込んでは戻る感触をまるで楽しんでいるかのように、指を動かし刺激を与え続ける。" voices=""/>
		<msg @l="464" char_id="-1" frame_id="-1" name=""
		   text="気がつくとお尻を撫で回していた痴漢の手は少しずつお尻から太腿の辺りへと降りていっていた。" voices=""/>
		<msg @l="465" char_id="-1" frame_id="-1" name="" text="するっ。" voices=""/>
		<msg @l="466" char_id="-1" frame_id="-1" name=""
		   text="いきなり手がスカートをまくり上げ、裾から内側へ進入してきた。" voices=""/>
		<msg @l="468" char_id="0" frame_id="-1" name="美帆"
		   text="(うそ‥‥やだ、スカートの中まで触ってくるのっ！？)" voices="miho00320"/>
		<msg @l="470" char_id="-1" frame_id="-1" name=""
		   text="それまで私が漠然と頭で考えていた「痴漢」というものから、遠く掛け離れた大胆な行為に、私は思わずパニックを起こしそうになる。"
		   voices=""/>
		<msg @l="471" char_id="-1" frame_id="-1" name=""
		   text="今まで、痴漢に何回か遭ったことはあるけど、せいぜい太腿を二度三度撫でられたくらいだ。" voices=""/>
		<msg @l="472" char_id="-1" frame_id="-1" name=""
		   text="大学以前は女子校だったし、その時は半ば専用と化した路線バスを使っていた。" voices=""/>
		<msg @l="473" char_id="-1" frame_id="-1" name=""
		   text="東京のキャンパスに通っていた時もあまり混雑しない時間帯を選んで電車に乗っていたので、痴漢にはほとんど遭ったことが無かった。"
		   voices=""/>
		<msg @l="474" char_id="-1" frame_id="-1" name=""
		   text="けれど、今は男の人ばかりのこの電車に乗るしかない。" voices=""/>
		<msg @l="476" char_id="0" frame_id="-1" name="美帆" text="(ど、どうしよう‥‥こんなの‥‥‥‥)"
		   voices="miho00330"/>
		<msg @l="478" char_id="0" frame_id="-1" name="美帆"
		   text="(あと１０分以上も我慢し続けなきゃいけないなんて‥‥)" voices="miho00340"/>
		<msg @l="480" char_id="-1" frame_id="-1" name=""
		   text="私が手に汗をかきながら、手すりをぎゅっと握って我慢している間にも、痴漢の手はスカートの中の太股を直接撫で回していた。"
		   voices=""/>
		<msg @l="481" char_id="-1" frame_id="-1" name="" text="すり、すり、すり。" voices=""/>
		<msg @l="483" char_id="0" frame_id="-1" name="美帆" text="『‥‥！？』"
		   voices="miho09970"/>
		<msg @l="485" char_id="-1" frame_id="-1" name=""
		   text="私は太股を触れられる感触に身体をびくびくっと震わせる。" voices=""/>
		<msg @l="486" char_id="-1" frame_id="-1" name=""
		   text="じかに肌を触ってくる手の感触が、とにかく気持ち悪い。" voices=""/>
		<msg @l="487" char_id="-1" frame_id="-1" name=""
		   text="おまけに、何処からか妙に鋭い視線の様なものを感じる。" voices=""/>
		<msg @l="488" char_id="-1" frame_id="-1" name=""
		   text="もし他の乗客に、スカートをまくり上げられて痴漢をされているのを見られたら‥‥そう思うと恥ずかしくて表立った抵抗が出来なくなってしまった。"
		   voices=""/>
		<msg @l="490" char_id="-1" frame_id="-1" name="痴漢" text="『声を出すなよ。』"
		   voices=""/>
		<msg @l="492" char_id="0" frame_id="-1" name="美帆" text="(え‥‥なに？)"
		   voices="miho00350"/>
		<msg @l="494" char_id="-1" frame_id="-1" name=""
		   text="私の耳元で痴漢がぼそりと囁くと、これまで白くムチッとした太股を撫で回していた手がするりと内股に差し込まれる。" voices=""/>
		<msg @l="495" char_id="-1" frame_id="-1" name=""
		   text="内股に差し込まれた手は、そのまま内股を撫で回しながら足の付け根のあたりまで這うように昇っていく。" voices=""/>
		<msg @l="497" char_id="0" frame_id="-1" name="美帆" text="(や‥‥そこはだめっ)"
		   voices="miho00360"/>
		<msg @l="499" char_id="-1" frame_id="-1" name=""
		   text="直感的に危機を感じて、私は慌てて足を閉じて痴漢の手を太腿で挟み込む。" voices=""/>
		<msg @l="501" char_id="-1" frame_id="-1" name="痴漢"
		   text="『なんだ‥‥それで抵抗しているつもりかね？』" voices=""/>
		<wait_chgmv/>
		<ev @l="504" src="ev-005ax3y2"/>
		<msg @l="506" char_id="-1" frame_id="-1" name=""
		   text="再び、痴漢が耳元で囁くと‥‥太腿に挟まれていない手が下腹部の方へと回され、下着と太股の境界ラインをなぞりあげていく。"
		   voices=""/>
		<msg @l="508" char_id="0" frame_id="-1" name="美帆" text="『んっ‥‥。』"
		   voices="miho10450"/>
		<msg @l="510" char_id="-1" frame_id="-1" name=""
		   text="焦らすかのように何度もなぞった後、今度はパンティが食い込むラインを直接撫で上げた。" voices=""/>
		<msg @l="512" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥やっ！！』"
		   voices="miho00370"/>
		<msg @l="514" char_id="-1" frame_id="-1" name="" text="私は思わず短く声をあげてしまう。"
		   voices=""/>
		<msg @l="515" char_id="-1" frame_id="-1" name=""
		   text="それと同時に、周囲の人たちが一斉に私の方へ視線を向けた。" voices=""/>
		<msg @l="516" char_id="-1" frame_id="-1" name=""
		   text="痴漢されている事がバレちゃう―――私の恥ずかしい姿が見られちゃう―――そう思った瞬間力が抜けてしまい、太腿で挟んでいた痴漢の手が自由に開放され、すかさずお尻の方からもアソコを責めてくる。"
		   voices=""/>
		<msg @l="518" char_id="-1" frame_id="-1" name="痴漢" text="『声を出すなと言ったハズだ。』"
		   voices=""/>
		<msg @l="520" char_id="-1" frame_id="-1" name="痴漢"
		   text="『周りの人間に自分が痴漢されてる様子を見られたいのかね？』" voices=""/>
		<msg @l="522" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥っ‥‥。』"
		   voices="miho00380"/>
		<msg @l="524" char_id="-1" frame_id="-1" name="痴漢"
		   text="『そうだ、そうやって黙っていれば私が「気持ち良く」してやる。フフフフフ。』" voices=""/>
		<msg @l="526" char_id="-1" frame_id="-1" name="" text="痴漢はそう言ってイヤらしく笑った。"
		   voices=""/>
		<msg @l="527" char_id="-1" frame_id="-1" name=""
		   text="私は―――声を押し殺して耐えるより他になかった。" voices=""/>
		<msg @l="529" char_id="-1" frame_id="-1" name="痴漢"
		   text="『くく‥‥その可愛い顔が恐怖に怯えているのがたまらないな。』" voices=""/>
		<msg @l="531" char_id="-1" frame_id="-1" name="痴漢" text="『マゾの素質があるよ、キミは。』"
		   voices=""/>
		<msg @l="533" char_id="-1" frame_id="-1" name="" text="むにゅっ。" voices=""/>
		<msg @l="534" char_id="-1" frame_id="-1" name=""
		   text="痴漢は楽しげに笑いながら、今度は前後から伸ばされた両手で直接下着越しにねっとりと擦ってくる。" voices=""/>
		<msg @l="536" char_id="0" frame_id="-1" name="美帆" text="『んっ‥‥。』"
		   voices="miho10450"/>
		<msg @l="538" char_id="-1" frame_id="-1" name=""
		   text="私は身体を震わせながらも、秘部を守ろうと太股をぎゅっと締め付けて指の進入を拒もうとする。" voices=""/>
		<msg @l="539" char_id="-1" frame_id="-1" name=""
		   text="だけど、太股をどんなに締め付けようと、どうしても隙間が出来てしまい、痴漢の指は拒むものがないアソコへと近付く。" voices=""/>
		<msg @l="540" char_id="-1" frame_id="-1" name=""
		   text="そして遂に私の秘部へ到達したかと思うと、かたちを確かめるように自由にいたぶってきた。" voices=""/>
		<msg @l="541" char_id="-1" frame_id="-1" name="" text="ぐにゅ、むにゅ。" voices=""/>
		<msg @l="543" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』"
		   voices="miho10340"/>
		<msg @l="545" char_id="-1" frame_id="-1" name=""
		   text="痴漢は私のぽってりとした柔肉をなぞり上げ、侵略者である中指と人差し指は傍若無人にパンティの船底部分を船をこぐように擦り続ける。"
		   voices=""/>
		<msg @l="546" char_id="-1" frame_id="-1" name=""
		   text="私は抵抗しようにも身動きが取れず、じっと耐えるしかない。" voices=""/>
		<msg @l="547" char_id="-1" frame_id="-1" name=""
		   text="私は前から後ろから伸ばされた指を前後に動かされるたびに、気持ち悪さに背中を震わせた。" voices=""/>
		<msg @l="549" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥っ‥‥‥。』"
		   voices="miho09930"/>
		<msg @l="551" char_id="-1" frame_id="-1" name="痴漢"
		   text="『おや？なかなか良い反応をするじゃあないか‥‥自慰はしているのかね？』" voices=""/>
		<msg @l="553" char_id="0" frame_id="-1" name="美帆" text="『そんなの‥‥こ、答えられませんっ。』"
		   voices="miho00390"/>
		<msg @l="555" char_id="-1" frame_id="-1" name="痴漢"
		   text="『黙っていないと周りの人間に気付かれてしまうぞ？』" voices=""/>
		<msg @l="557" char_id="0" frame_id="-1" name="美帆" text="『くっ‥‥。』"
		   voices="miho00400"/>
		<msg @l="559" char_id="-1" frame_id="-1" name=""
		   text="いつの間にか痴漢のペースに巻き込まれているように思う。" voices=""/>
		<msg @l="560" char_id="-1" frame_id="-1" name=""
		   text="私がつけ込まれやすい性格だからなのか、それとも痴漢が巧みなのか。" voices=""/>
		<msg @l="561" char_id="-1" frame_id="-1" name="" text="どちらにせよこんな状況では逆らえない。"
		   voices=""/>
		<msg @l="563" char_id="-1" frame_id="-1" name="痴漢"
		   text="『それともキミはこちらの方が良いのかね？』" voices=""/>
		<msg @l="565" char_id="-1" frame_id="-1" name=""
		   text="痴漢はパンティの船底に当てていた小指の腹にクイッと持ち上げ、女陰の中心をグリグリと圧迫した。するとパンティが女唇の間に食い込まれる。"
		   voices=""/>
		<msg @l="567" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』"
		   voices="miho00420"/>
		<msg @l="569" char_id="-1" frame_id="-1" name=""
		   text="私は声にならない声を上げる。ぐっと耐えるうちに前歯が唇に食い込む。" voices=""/>
		<msg @l="570" char_id="-1" frame_id="-1" name=""
		   text="耐える私を無視するかのように、さらに中指と人差し指の二本が不遠慮に潜り込んできた。" voices=""/>
		<msg @l="571" char_id="-1" frame_id="-1" name=""
		   text="蠢く指先が女陰をいじりつくすと、第一関節を折り曲げ、その先端でふっくらとした女唇に引っかけ、蜜口を撫で上げた。" voices=""/>
		<msg @l="573" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥っ‥‥‥。』"
		   voices="miho09930"/>
		<msg @l="575" char_id="-1" frame_id="-1" name=""
		   text="誰にも触れられたこともない、男の人に見られたことのない蜜口が、今卑劣な痴漢に汚されているのだ。" voices=""/>
		<msg @l="577" char_id="-1" frame_id="-1" name="痴漢"
		   text="『誰にも触れられたことのない、ここはどうかな？』" voices=""/>
		<msg @l="579" char_id="-1" frame_id="-1" name=""
		   text="蜜口を撫でていた指の腹がスルリと前に滑った途端、上側にある突起へと添えられた。" voices=""/>
		<msg @l="581" char_id="0" frame_id="-1" name="美帆" text="『んっっ！』"
		   voices="miho00450"/>
		<msg @l="583" char_id="-1" frame_id="-1" name=""
		   text="ただ指が添えられただけなのに、身体中へ痛みに似た鋭い快感が走り、痙攣（けいれん）するように震え前のめりに倒れそうになる。"
		   voices=""/>
		<msg @l="585" char_id="0" frame_id="-1" name="美帆" text="『やだ‥‥そこは‥‥‥。』"
		   voices="miho00410"/>
		<msg @l="587" char_id="-1" frame_id="-1" name="痴漢" text="『そこは、何かな‥‥？』"
		   voices=""/>
		<msg @l="589" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』"
		   voices="miho00420"/>
		<msg @l="591" char_id="-1" frame_id="-1" name="痴漢"
		   text="『そうだ‥‥答えられないのならば黙っていたまえ。』" voices=""/>
		<msg @l="593" char_id="-1" frame_id="-1" name=""
		   text="痴漢はそうして、ゆっくりと突起を指の腹でくすぐるように転がし始める。" voices=""/>
		<msg @l="595" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥ぅぁ‥‥。』"
		   voices="miho00430"/>
		<msg @l="597" char_id="-1" frame_id="-1" name=""
		   text="声を出さないようにぎゅっと結んでいた口から、思わず吐息が漏れてしまう。" voices=""/>
		<msg @l="598" char_id="-1" frame_id="-1" name=""
		   text="痴漢の指が軽く突起を転がしただけで、腰が震えた。" voices=""/>
		<msg @l="600" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』"
		   voices="miho09900"/>
		<msg @l="602" char_id="-1" frame_id="-1" name=""
		   text="それが恐怖によるものなのかそれとも生理的な感覚なのかは解らない。" voices=""/>
		<msg @l="603" char_id="-1" frame_id="-1" name=""
		   text="ただ、痴漢に大切な部分を蹂躙されて身体が反応しているのは解った。" voices=""/>
		<msg @l="604" char_id="-1" frame_id="-1" name="" text="くりっ、くりっ。" voices=""/>
		<msg @l="606" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥っ‥‥‥。』"
		   voices="miho09930"/>
		<msg @l="608" char_id="-1" frame_id="-1" name=""
		   text="痴漢は私の反応が気に入ったのか、更に人差し指で突起をやや強く丹念にいじり続ける。" voices=""/>
		<msg @l="609" char_id="-1" frame_id="-1" name=""
		   text="私はクリ○リスを触られる度に、涙を浮かべ声を出さないように唇をかんで我慢していた。" voices=""/>
		<msg @l="611" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』"
		   voices="miho09880"/>
		<msg @l="613" char_id="-1" frame_id="-1" name="痴漢"
		   text="『下着の上からいじられただけで感じているのか？大した淫乱だな。ここが熱くなってきているじゃないか。』" voices=""/>
		<msg @l="615" char_id="0" frame_id="-1" name="美帆" text="『ちが‥‥違います。』"
		   voices="miho00440"/>
		<msg @l="617" char_id="-1" frame_id="-1" name="痴漢"
		   text="『さて、それが嘘か本当かはこちらの口に聞こうか。』" voices=""/>
		<msg @l="619" char_id="-1" frame_id="-1" name="" text="くりっ。" voices=""/>
		<msg @l="620" char_id="-1" frame_id="-1" name="" text="言葉と同時に、突起が強く爪弾かれる。"
		   voices=""/>
		<msg @l="622" char_id="0" frame_id="-1" name="美帆" text="『んっっ！』"
		   voices="miho00450"/>
		<msg @l="624" char_id="-1" frame_id="-1" name=""
		   text="私は、思わず漏れそうになった声を必死に押し殺す。" voices=""/>
		<msg @l="625" char_id="-1" frame_id="-1" name="" text="電流が‥‥走ったみたいだった。"
		   voices=""/>
		<msg @l="627" char_id="-1" frame_id="-1" name="痴漢" text="『キミは感度がいいな。』"
		   voices=""/>
		<msg @l="629" char_id="-1" frame_id="-1" name="痴漢"
		   text="『だが、ここに私のモノをぶち込まれれば‥‥もっと気持ち良くなる。』" voices=""/>
		<msg @l="631" char_id="-1" frame_id="-1" name=""
		   text="痴漢はそう言いながらアソコを指で撫で上げ、私のお尻に腰を擦り付けてきた。" voices=""/>
		<msg @l="632" char_id="-1" frame_id="-1" name=""
		   text="私はお尻に擦り付けられた熱く固い棒のような感触に、想像でしか知らない男の性器を思い浮かべ、とっさに後ろを振り返ろうとする。"
		   voices=""/>
		<msg @l="633" char_id="-1" frame_id="-1" name=""
		   text="振り返ろうとした瞬間、笑った痴漢の口元がわずかに視界に入る。" voices=""/>
		<msg @l="634" char_id="-1" frame_id="-1" name="" text="もう少しで痴漢の顔がわかると思った矢先。"
		   voices=""/>
		<msg @l="635" char_id="-1" frame_id="-1" name=""
		   text="電車が大きく揺れると同時に、視界から大きくそれてしまう。" voices=""/>
		<eval @l="639" expr="f.痴漢flag&#32;+=&#32;1&#13;&#10;"/>
		<stopbgm @l="643" fadeout="1000"/>
		<clear @l="649" class="all"/>
		<msgshow @l="651" show="true"/>
		<msg @l="653" char_id="-1" frame_id="-1" name="アナウンス"
		   text="『次は終点‥‥大学前、大学前です。』" voices=""/>
		<msg @l="655" char_id="-1" frame_id="-1" name="アナウンス"
		   text="『手荷物のお忘れ物などありませんようご注意ください。』" voices=""/>
		<msg @l="657" char_id="0" frame_id="-1" name="美帆" text="(た、助かった‥‥)"
		   voices="miho00460"/>
		<msg @l="659" char_id="-1" frame_id="-1" name=""
		   text="大きな揺れの後、車内に終点到着前のアナウンスが流れる。" voices=""/>
		<msg @l="660" char_id="-1" frame_id="-1" name="" text="窓の外には既に大学の建物がのぞいていた。"
		   voices=""/>
		<msg @l="662" char_id="-1" frame_id="-1" name="痴漢" text="『今日は時間切れのようだな。』"
		   voices=""/>
		<msg @l="664" char_id="-1" frame_id="-1" name="痴漢"
		   text="『残念だが、続きを楽しみにしていることだ。』" voices=""/>
		<msg @l="666" char_id="0" frame_id="-1" name="美帆" text="『だ、誰が続きなんかっ‥‥。』"
		   voices="miho00470"/>
		<msg @l="668" char_id="-1" frame_id="-1" name="痴漢" text="『くく‥‥。』" voices=""/>
		<msg @l="670" char_id="-1" frame_id="-1" name=""
		   text="痴漢の男はいつの間にかどこかへまぎれこんでしまう。" voices=""/>
		<msg @l="671" char_id="-1" frame_id="-1" name=""
		   text="私は痴漢の背中を一瞬だけ捉えるのがやっとで、結局その顔を確かめるまでには至らなかった。" voices=""/>
		<msg @l="673" char_id="0" frame_id="-1" name="美帆" text="(‥‥‥誰が‥‥続きなんか‥‥‥‥)"
		   voices="miho00480"/>
		<msg @l="675" char_id="-1" frame_id="-1" name=""
		   text="減速を始めた電車の中、私はわずかな「ゆらぎ」を否定するようにつぶやいていた。" voices=""/>
		<goto @l="678" label="EventLabel_22"/>
		<return @l="681" value=""/>
		<label @l="685" id="EventLabel_22"/>
		<end_scene @l="689"/>
		<stopse @l="693" buf="3"/>
		<wait_chgmv/>
		<bg @l="697" src="bg07"/>
		<bgm @l="701" src="bgm03" volume="1."/>
		<char @l="705" id="miho" pos="auto" src="miho015"/>
		<description @l="708" text="始まりの日"/>
		<msg @l="710" char_id="0" frame_id="-1" name="美帆" text="(うー‥‥ひどい目にあった)"
		   voices=""/>
		<msg @l="712" char_id="0" frame_id="-1" name="美帆"
		   text="(明日は絶対に次の電車に乗ろう‥‥絶対に)" voices=""/>
		<msg @l="714" char_id="-1" frame_id="-1" name=""
		   text="電車を降りてからずっと、私は両目に涙を溜めたまま歩いていた。" voices=""/>
		<msg @l="715" char_id="-1" frame_id="-1" name=""
		   text="なるべく誰かに見つからないようにうつむいてはいたけれど、泣いている事に気付いて不審に思った人も居たかもしれない。" voices=""/>
		<msg @l="717" char_id="-1" frame_id="-1" name="声" text="『やあ、どうかしたのかね？』"
		   voices=""/>
		<char @l="721" id="miho" pos="auto" src="miho014"/>
		<msg @l="723" char_id="0" frame_id="-1" name="美帆" text="『え‥‥。』" voices=""/>
		<clear @l="726" class="char"/>
		<char @l="728" id="miho" pos="left" src="miho014"/>
		<char @l="731" id="kutsu" pos="right" src="kutsu010"/>
		<msg @l="733" char_id="-1" frame_id="-1" name=""
		   text="突然の呼びかけに慌てて涙を拭いて振り返ると、考古学の講義を受け持っている朽木陽大（くつきようだい）教授が立っていた。"
		   voices=""/>
		<msg @l="734" char_id="-1" frame_id="-1" name=""
		   text="私の専攻も考古学だから何かと会う機会も多く、懇意にしてもらっている。" voices=""/>
		<msg @l="735" char_id="-1" frame_id="-1" name=""
		   text="今のところ、白石先輩のいう「コネ」の最有力候補‥‥なのかな。" voices=""/>
		<msg @l="737" char_id="0" frame_id="-1" name="美帆" text="『教授も同じ電車だったんですか？』"
		   voices=""/>
		<msg @l="739" char_id="-1" frame_id="-1" name="朽木"
		   text="『ああ。あの電車に仲根くんも乗っていたとは気付かなかったな。』" voices=""/>
		<msg @l="741" char_id="-1" frame_id="-1" name=""
		   text="そう言って朽木教授は何処か楽しげに口元を歪めた。" voices=""/>
		<msg @l="742" char_id="-1" frame_id="-1" name=""
		   text="私はその意味もわからないまま、あいまいに小首を傾げてみせる。" voices=""/>
		<char @l="746" id="kutsu" pos="right" src="kutsu014"/>
		<msg @l="748" char_id="-1" frame_id="-1" name="朽木"
		   text="『おや、仲根くん、少し両目が赤いようだが‥‥？』" voices=""/>
		<char @l="752" id="miho" pos="left" src="miho015"/>
		<msg @l="754" char_id="0" frame_id="-1" name="美帆" text="『あ、いえ‥‥なんでもないんです。』"
		   voices=""/>
		<msg @l="756" char_id="0" frame_id="-1" name="美帆"
		   text="『ちょっとホコリが入っちゃって、それで‥‥。』" voices=""/>
		<msg @l="758" char_id="-1" frame_id="-1" name=""
		   text="突然の突っ込みに驚いて、私はとっさに適当な嘘をつく。" voices=""/>
		<msg @l="759" char_id="-1" frame_id="-1" name=""
		   text="我ながら、ありふれていて気の利かない嘘だと思う。" voices=""/>
		<msg @l="760" char_id="-1" frame_id="-1" name=""
		   text="けれどまさか、痴漢に遭って泣いていました‥‥とは言えない。" voices=""/>
		<char @l="764" id="kutsu" pos="right" src="kutsu010"/>
		<msg @l="766" char_id="-1" frame_id="-1" name="朽木"
		   text="『ふむ。そろそろ転入してきて一ヶ月が経つ。気を緩めているとちょっとした事に足元をすくわれてしまうからな‥‥十分に注意した方がいい。』"
		   voices=""/>
		<msg @l="768" char_id="-1" frame_id="-1" name="朽木"
		   text="『キミには特に期待しているんだ、しっかりしてくれたまえよ。』" voices=""/>
		<char @l="772" id="miho" pos="left" src="miho116"/>
		<msg @l="774" char_id="0" frame_id="-1" name="美帆" text="『はい、ありがとうございます。』"
		   voices=""/>
		<clear @l="778" class="char"/>
		<char @l="780" id="miho" pos="auto" src="miho116"/>
		<msg @l="782" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="784" char_id="0" frame_id="-1" name="美帆" text="『足元をすくわれる‥‥かぁ。』"
		   voices=""/>
		<msg @l="786" char_id="0" frame_id="-1" name="美帆" text="『いきなりすくわれちゃったな、足元。』"
		   voices=""/>
		<msg @l="788" char_id="-1" frame_id="-1" name=""
		   text="立ち去る朽木教授の背中を見送りながら、私は小さくつぶやいていた。" voices=""/>
		<stopbgm @l="792" fadeout="1000"/>
		<clear @l="798" class="all"/>
		<msgshow @l="800" show="true"/>
		<wait_chgmv/>
		<bg @l="804" src="bg09"/>
		<bgm @l="808" src="bgm02" volume="1."/>
		<msg @l="810" char_id="0" frame_id="-1" name="美帆" text="『稲庭（いなば）先輩？』"
		   voices=""/>
		<msg @l="812" char_id="-1" frame_id="-1" name="女友達"
		   text="『そうそう。テニスサークルの会長ですっごく格好良いのよ！』" voices=""/>
		<msg @l="814" char_id="0" frame_id="-1" name="美帆"
		   text="『へー、テニスかぁ‥‥私は球技って全然ダメだからなぁ。』" voices=""/>
		<msg @l="816" char_id="-1" frame_id="-1" name="女友達"
		   text="『テニスなんて適当でいいんだって。サークルに入ってる女の子の９割くらいが稲庭先輩目当てなんだからさ！』" voices=""/>
		<msg @l="818" char_id="0" frame_id="-1" name="美帆"
		   text="『でも、サークルに入る以上はテニスが出来ないとダメだと思うよ。』" voices=""/>
		<msg @l="820" char_id="-1" frame_id="-1" name="女友達"
		   text="『もう、美帆は変に真面目なんだから～。』" voices=""/>
		<msg @l="822" char_id="-1" frame_id="-1" name=""
		   text="必修の講義が終了した後、その講義でよく一緒になる女の子と話をしながら廊下を歩くのがここ最近の習慣になっていた。" voices=""/>
		<msg @l="823" char_id="-1" frame_id="-1" name=""
		   text="転入一ヶ月目で友達が出来るなんて、私にしては珍しい。" voices=""/>
		<msg @l="824" char_id="-1" frame_id="-1" name=""
		   text="これもひとえに「何事も前向きに」という目標のおかげなのかな‥‥。" voices=""/>
		<msg @l="826" char_id="0" frame_id="-1" name="美帆"
		   text="『その稲庭先輩はともかく、私も何かサークルに入ろうかな。』" voices=""/>
		<msg @l="828" char_id="-1" frame_id="-1" name="女友達"
		   text="『お、あの稲庭先輩を「ともかく」呼ばわりか～！』" voices=""/>
		<msg @l="830" char_id="0" frame_id="-1" name="美帆"
		   text="『ごめんごめん、そういうつもりじゃないって。』" voices=""/>
		<msg @l="832" char_id="0" frame_id="-1" name="美帆" text="『私‥‥男の人とか苦手だから。』"
		   voices=""/>
		<msg @l="834" char_id="-1" frame_id="-1" name="女友達"
		   text="『え、美帆ってまさか同性愛なんちゃらってやつ？』" voices=""/>
		<msg @l="836" char_id="0" frame_id="-1" name="美帆" text="『それを言うなら同性愛嗜好、でしょ。』"
		   voices=""/>
		<msg @l="838" char_id="-1" frame_id="-1" name="女友達"
		   text="『あーそれそれ。同性愛なんちゃら。』" voices=""/>
		<msg @l="840" char_id="0" frame_id="-1" name="美帆" text="『結局なんちゃらなのね‥‥。』"
		   voices=""/>
		<msg @l="842" char_id="-1" frame_id="-1" name="女友達"
		   text="『で、美帆はそのなんちゃらなわけ？』" voices=""/>
		<msg @l="844" char_id="0" frame_id="-1" name="美帆"
		   text="『違うよ！&#32;別に私はそういうのじゃなくって‥‥単に苦手なだけ。』" voices=""/>
		<msg @l="846" char_id="-1" frame_id="-1" name="女友達" text="『よくわかんないなー。』"
		   voices=""/>
		<msg @l="848" char_id="0" frame_id="-1" name="美帆" text="『私も良く分かんない。』"
		   voices=""/>
		<msg @l="850" char_id="-1" frame_id="-1" name="女友達" text="『なによそれ～。』"
		   voices=""/>
		<clear @l="856" class="all"/>
		<msgshow @l="858" show="true"/>
		<msg @l="860" char_id="0" frame_id="-1" name="美帆" text="『あ‥‥。』" voices=""/>
		<msg @l="862" char_id="-1" frame_id="-1" name="女友達" text="『およ、どうしたの？』"
		   voices=""/>
		<wait_chgmv/>
		<bg @l="866" src="bg15"/>
		<char @l="870" id="inaba" pos="auto" src="inaba010"/>
		<msg @l="872" char_id="0" frame_id="-1" name="美帆" text="『珍しいなぁ‥‥裏庭に人が居るよ？』"
		   voices=""/>
		<msg @l="874" char_id="-1" frame_id="-1" name=""
		   text="会話が途切れた一瞬、なんとなく廊下の窓から校舎の裏側‥‥通称「裏庭」を見ると、普段は全く人気の無いその場所に珍しく人影があった。"
		   voices=""/>
		<msg @l="875" char_id="-1" frame_id="-1" name=""
		   text="若い‥‥かなり「格好良い」部類に入るだろう男の人だ。" voices=""/>
		<msg @l="877" char_id="-1" frame_id="-1" name="女友達"
		   text="『どれどれ愛の告白かぁ‥‥って、あれ、稲庭先輩じゃん！』" voices=""/>
		<msg @l="879" char_id="0" frame_id="-1" name="美帆" text="『へえ、あれが稲庭先輩なんだ。』"
		   voices=""/>
		<msg @l="881" char_id="-1" frame_id="-1" name="" text="確かに、噂になるだけのことはある。"
		   voices=""/>
		<msg @l="882" char_id="-1" frame_id="-1" name=""
		   text="あれだけ格好良い会長の居るサークルになら、それこそ彼を目当てに、女子がわんさかいることだろう。" voices=""/>
		<msg @l="884" char_id="-1" frame_id="-1" name="女友達"
		   text="『誰だ誰だー、あたしの稲庭先輩にコクろうってのは！』" voices=""/>
		<msg @l="886" char_id="0" frame_id="-1" name="美帆"
		   text="『あたしの稲庭先輩って‥‥それ、たぶん問題発言だよ？』" voices=""/>
		<msg @l="888" char_id="-1" frame_id="-1" name="女友達"
		   text="『私がどう思おうが私の勝手でしょ！』" voices=""/>
		<msg @l="890" char_id="0" frame_id="-1" name="美帆" text="『それはそうかもしれないけど‥‥。』"
		   voices=""/>
		<msg @l="892" char_id="-1" frame_id="-1" name="女友達" text="『くそー、見えないかなー！』"
		   voices=""/>
		<msg @l="894" char_id="0" frame_id="-1" name="美帆"
		   text="『ちょうど、木の陰に隠れちゃってるね。』" voices=""/>
		<clear @l="898" class="char"/>
		<msg @l="900" char_id="-1" frame_id="-1" name="女友達"
		   text="『あ‥‥稲庭先輩が校舎の中に入った！』" voices=""/>
		<wait_chgmv/>
		<bg @l="904" src="bg09"/>
		<msg @l="906" char_id="-1" frame_id="-1" name="女友達" text="『美帆、行くわよ！』"
		   voices=""/>
		<msg @l="908" char_id="0" frame_id="-1" name="美帆" text="『え、行くってどこに？』"
		   voices=""/>
		<msg @l="910" char_id="-1" frame_id="-1" name="女友達"
		   text="『もちろん、稲庭先輩を出迎えに行くのよ！』" voices=""/>
		<msg @l="912" char_id="0" frame_id="-1" name="美帆" text="『ちょ、ちょっと‥‥！？』"
		   voices=""/>
		<clear @l="918" class="all"/>
		<msgshow @l="920" show="true"/>
		<msg @l="922" char_id="-1" frame_id="-1" name=""
		   text="私は半ば引きずられる形で、校舎への裏口のある場所へと向かう。" voices=""/>
		<msg @l="923" char_id="-1" frame_id="-1" name=""
		   text="裏口といっても、外側の壁に両開きのガラス扉が一枚すえられているだけで特別に何か他の場所と変わりがあるわけじゃない。"
		   voices=""/>
		<msg @l="924" char_id="-1" frame_id="-1" name=""
		   text="強いて他との違いをあげるなら、誰も好んで裏庭なんて訪れたりはしないから、ほとんど人通りが無いという点くらいだろうか。"
		   voices=""/>
		<wait_chgmv/>
		<bg @l="928" src="bg09"/>
		<msg @l="930" char_id="0" frame_id="-1" name="美帆"
		   text="『ねえ‥‥やめようよ、稲庭先輩が迷惑するかもしれないよ。』" voices=""/>
		<msg @l="932" char_id="-1" frame_id="-1" name="女友達"
		   text="『何言ってるの、これはチャンスなのよ。』" voices=""/>
		<msg @l="934" char_id="0" frame_id="-1" name="美帆" text="『チャンスって‥‥何の？』"
		   voices=""/>
		<msg @l="936" char_id="-1" frame_id="-1" name="女友達"
		   text="『稲庭先輩を狙ってるライバルたちに一歩差をつける為のチャンスよ！』" voices=""/>
		<msg @l="938" char_id="0" frame_id="-1" name="美帆"
		   text="『差をつけるって、ただ会ってお話するだけじゃない‥‥。』" voices=""/>
		<msg @l="940" char_id="-1" frame_id="-1" name="女友達"
		   text="『その会って話をすることが大切なのよ！』" voices=""/>
		<msg @l="942" char_id="-1" frame_id="-1" name="女友達"
		   text="『稲庭先輩の脳細胞に私という存在をしっかりと刻み付けるの！』" voices=""/>
		<msg @l="944" char_id="0" frame_id="-1" name="美帆" text="『そ、そうなんだ‥‥。』"
		   voices=""/>
		<msg @l="946" char_id="-1" frame_id="-1" name="" text="その言い方ってちょっと怖い‥‥。"
		   voices=""/>
		<msg @l="948" char_id="-1" frame_id="-1" name="女友達" text="『あ‥‥稲庭先輩、来たわよっ！』"
		   voices=""/>
		<char @l="952" id="inaba" pos="auto" src="inaba010"/>
		<stopbgm @l="956" fadeout="1000"/>
		<bgm @l="959" src="bgm06" volume="1."/>
		<msg @l="961" char_id="-1" frame_id="-1" name="女友達" text="『稲庭先輩、こんにちはー♪』"
		   voices=""/>
		<msg @l="963" char_id="-1" frame_id="-1" name=""
		   text="稲庭先輩が裏庭へと続く扉を開けた瞬間、彼女はまるでセットされていた目覚まし時計のように駆け出すと、大きな声で人懐っこい挨拶をした。"
		   voices=""/>
		<msg @l="964" char_id="-1" frame_id="-1" name=""
		   text="しかも、普段の会話では使わない「余所行きの声」なのだから凄い。" voices=""/>
		<msg @l="965" char_id="-1" frame_id="-1" name=""
		   text="ちなみに「余所行きの声」は普段のそれよりも１オクターブ高い。" voices=""/>
		<msg @l="967" char_id="-1" frame_id="-1" name="稲庭"
		   text="『はは‥‥これはまた、ずいぶんと賑やかなお出迎えだね。』" voices=""/>
		<msg @l="969" char_id="-1" frame_id="-1" name="" text="そう言って、稲庭先輩はにっこりと笑った。"
		   voices=""/>
		<msg @l="970" char_id="-1" frame_id="-1" name=""
		   text="突然の出迎えにもあまり驚いた風はなく、余裕然としている。" voices=""/>
		<msg @l="971" char_id="-1" frame_id="-1" name=""
		   text="こういう事は稲庭先輩にとって日常茶飯事なのかもしれない。" voices=""/>
		<msg @l="973" char_id="-1" frame_id="-1" name="女友達"
		   text="『私、稲庭先輩と会えて感激ですー！』" voices=""/>
		<msg @l="975" char_id="-1" frame_id="-1" name="稲庭"
		   text="『あははは、テニスコートに来てくれれば毎日でも会えると思うよ。』" voices=""/>
		<msg @l="977" char_id="-1" frame_id="-1" name="女友達"
		   text="『それってサークルへのお誘いですかぁ～？』" voices=""/>
		<msg @l="979" char_id="-1" frame_id="-1" name="稲庭"
		   text="『そうだね。キミみたいに元気な女の子がサークルに入ってくれればきっと楽しいと思うよ。』" voices=""/>
		<msg @l="981" char_id="-1" frame_id="-1" name="女友達"
		   text="『やった、稲庭先輩の方から誘われるなんて‥‥感動です！』" voices=""/>
		<msg @l="983" char_id="-1" frame_id="-1" name="稲庭"
		   text="『今度テニスコートにサークル活動を見学に来るといい。僕が色々教えてあげるよ。』" voices=""/>
		<msg @l="985" char_id="-1" frame_id="-1" name="女友達" text="『ほんとですかー！？』"
		   voices=""/>
		<msg @l="987" char_id="-1" frame_id="-1" name="稲庭" text="『僕が嘘をつくと思うかい？』"
		   voices=""/>
		<msg @l="989" char_id="-1" frame_id="-1" name="女友達"
		   text="『思いません思いません、ぜっっったいに思いません！』" voices=""/>
		<msg @l="991" char_id="-1" frame_id="-1" name="稲庭"
		   text="『良かった、待ってるからいつでもおいで。』" voices=""/>
		<msg @l="993" char_id="-1" frame_id="-1" name="女友達"
		   text="『キャーーーーーー、稲庭先輩が私を待ってるだなんて！！』" voices=""/>
		<msg @l="995" char_id="-1" frame_id="-1" name=""
		   text="稲庭先輩の言葉に狂喜乱舞している友人を前に、私はいつ言葉を切り出していいものかと迷っているうちに、完全にタイミングを見失って一人黙り込んでいた。"
		   voices=""/>
		<msg @l="997" char_id="-1" frame_id="-1" name="女友達"
		   text="『と、私一人で浮かれててもしょうがないわね。』" voices=""/>
		<msg @l="999" char_id="-1" frame_id="-1" name="女友達"
		   text="『ほら‥‥美帆、せっかくだからアンタも挨拶くらいしときなさい。』" voices=""/>
		<msg @l="1001" char_id="-1" frame_id="-1" name="" text="ふと我に返ったのだろう。"
		   voices=""/>
		<msg @l="1002" char_id="-1" frame_id="-1" name=""
		   text="稲庭先輩の前で忙しく飛んだり跳ねたりしていた友人はくるりと振り返り、行き場を無くして立ち尽くしていた私にぴしゃりと言い放つ。"
		   voices=""/>
		<msg @l="1003" char_id="-1" frame_id="-1" name=""
		   text="誰のおかげでこんな宙ぶらりんになったのかと問いたかったけど、この際そんな事はどうでも良いに違いない。" voices=""/>
		<msg @l="1005" char_id="0" frame_id="-1" name="美帆" text="『えっ‥‥う、うん。』"
		   voices=""/>
		<msg @l="1007" char_id="0" frame_id="-1" name="美帆" text="『どうも‥‥こんにちは。』"
		   voices=""/>
		<msg @l="1009" char_id="-1" frame_id="-1" name=""
		   text="仕方なく私は彼女に言われるがまま挨拶をして、頭を下げる。" voices=""/>
		<msg @l="1010" char_id="-1" frame_id="-1" name=""
		   text="何ともタイミングの悪い、間の抜けた挨拶かも。と、自分でも思う。" voices=""/>
		<stopbgm @l="1014" fadeout="1000"/>
		<char @l="1018" id="inaba" pos="auto" src="inaba014"/>
		<msg @l="1020" char_id="-1" frame_id="-1" name="稲庭" text="『‥‥！』" voices=""/>
		<msg @l="1022" char_id="-1" frame_id="-1" name=""
		   text="彼女の肩越しに稲庭先輩と目が合った瞬間、どういうわけか初めて笑顔ではない表情を見せた。" voices=""/>
		<msg @l="1024" char_id="0" frame_id="-1" name="美帆" text="『あの‥‥どうかしました？』"
		   voices=""/>
		<char @l="1028" id="inaba" pos="auto" src="inaba010"/>
		<msg @l="1030" char_id="-1" frame_id="-1" name="稲庭" text="『いや‥‥なんでもないよ。』"
		   voices=""/>
		<msg @l="1032" char_id="-1" frame_id="-1" name=""
		   text="そう言って稲庭先輩はにっこりと笑みを浮かべてみせる。" voices=""/>
		<msg @l="1033" char_id="-1" frame_id="-1" name=""
		   text="先ほど一瞬だけみせた驚きの表情は欠片も残っていない、完璧な笑顔を。" voices=""/>
		<bgm @l="1036" src="bgm02" volume="1."/>
		<msg @l="1038" char_id="-1" frame_id="-1" name="稲庭"
		   text="『それより、キミたち転入生だよね？』" voices=""/>
		<msg @l="1040" char_id="-1" frame_id="-1" name="稲庭"
		   text="『よければ名前‥‥教えてもらえるかな？』" voices=""/>
		<msg @l="1042" char_id="0" frame_id="-1" name="美帆"
		   text="『あ、はい‥‥‥私は仲根美帆‥‥‥‥。』" voices=""/>
		<msg @l="1044" char_id="0" frame_id="-1" name="美帆"
		   text="『仲間の仲に根っこで仲根、美しいにマストの帆で美帆です。』" voices=""/>
		<msg @l="1046" char_id="-1" frame_id="-1" name="稲庭" text="『美帆ちゃんか‥‥良い名前だね。』"
		   voices=""/>
		<msg @l="1048" char_id="0" frame_id="-1" name="美帆"
		   text="『あ‥‥えっと、ありがとうございます。』" voices=""/>
		<msg @l="1050" char_id="-1" frame_id="-1" name="女友達"
		   text="『先輩先輩先輩、私の名前はですねーーーーっ！！』" voices=""/>
		<msg @l="1052" char_id="-1" frame_id="-1" name="稲庭"
		   text="『あはは、そんなに大きな声で言わなくてもちゃんと聞こえてるよ。』" voices=""/>
		<clear @l="1058" class="all"/>
		<msgshow @l="1060" show="true"/>
		<msg @l="1062" char_id="-1" frame_id="-1" name=""
		   text="ひと通りの自己紹介を終えた後、私たちは軽い世間話に花を咲かせていた。" voices=""/>
		<msg @l="1063" char_id="-1" frame_id="-1" name=""
		   text="もっとも、世間話といっても延々と続けられる彼女のマシンガントークを私と稲庭先輩がただ聞いていただけ‥‥というものではあったのだけれど。"
		   voices=""/>
		<wait_chgmv/>
		<bg @l="1067" src="bg09"/>
		<char @l="1071" id="inaba" pos="auto" src="inaba010"/>
		<msg @l="1073" char_id="-1" frame_id="-1" name="稲庭"
		   text="『それじゃあ僕はこの辺でお暇させてもらうよ。』" voices=""/>
		<msg @l="1075" char_id="-1" frame_id="-1" name="女友達"
		   text="『え、もう行っちゃうんですかぁ～。』" voices=""/>
		<msg @l="1077" char_id="-1" frame_id="-1" name="稲庭"
		   text="『これからサークルのミーティングだからね、会長の僕が出ないわけにはいかないだろ？』" voices=""/>
		<msg @l="1079" char_id="-1" frame_id="-1" name="女友達"
		   text="『それはそうですけど、残念です～。』" voices=""/>
		<msg @l="1081" char_id="-1" frame_id="-1" name=""
		   text="彼女はそういうと心底残念そうに表情を沈ませる。" voices=""/>
		<msg @l="1082" char_id="-1" frame_id="-1" name=""
		   text="まったく、うらやましいほど自分に素直な子だ。" voices=""/>
		<msg @l="1084" char_id="0" frame_id="-1" name="美帆"
		   text="『あの、いきなり引き止めてしまってすみませんでした。』" voices=""/>
		<msg @l="1086" char_id="-1" frame_id="-1" name="稲庭"
		   text="『気にしてないよ。それに僕もキミたちと話が出来て良かった。』" voices=""/>
		<msg @l="1088" char_id="-1" frame_id="-1" name=""
		   text="やはり一分の隙もない笑顔で稲庭先輩は言う。" voices=""/>
		<msg @l="1089" char_id="-1" frame_id="-1" name=""
		   text="言葉では「キミたち」と言っているのに、稲庭先輩の視線はずっと私だけに注がれていた‥‥ように思ってしまうのは自意識過剰なのかな‥‥。"
		   voices=""/>
		<msg @l="1091" char_id="0" frame_id="-1" name="美帆" text="『そうですか‥‥良かったです。』"
		   voices=""/>
		<msg @l="1093" char_id="-1" frame_id="-1" name="稲庭" text="『また、話が出来ると良いね。』"
		   voices=""/>
		<msg @l="1095" char_id="-1" frame_id="-1" name="女友達" text="『そうですね、是非！』"
		   voices=""/>
		<msg @l="1097" char_id="-1" frame_id="-1" name=""
		   text="私が何かを言うより早く「余所行きの声」がすぐ隣から響いてくる。" voices=""/>
		<msg @l="1098" char_id="-1" frame_id="-1" name="" text="しかも両目をキラキラと輝かせて、だ。"
		   voices=""/>
		<msg @l="1100" char_id="-1" frame_id="-1" name="稲庭" text="『あははは、それじゃ。』"
		   voices=""/>
		<clear @l="1104" class="char"/>
		<stopbgm @l="1107" fadeout="1000"/>
		<bgm @l="1109" src="bgm02" volume="1."/>
		<msg @l="1111" char_id="-1" frame_id="-1" name="女友達" text="『‥‥‥‥。』"
		   voices=""/>
		<msg @l="1113" char_id="-1" frame_id="-1" name="女友達"
		   text="『‥‥はあ、やっぱり稲庭先輩って格好良いわぁ～。』" voices=""/>
		<msg @l="1115" char_id="-1" frame_id="-1" name=""
		   text="稲庭先輩の背中が見えなくなるまで見送った後、陶酔した表情で言う。" voices=""/>
		<msg @l="1117" char_id="0" frame_id="-1" name="美帆"
		   text="『そうだね‥‥何か、少しだけ解ったような気がするかな。』" voices=""/>
		<msg @l="1119" char_id="-1" frame_id="-1" name="女友達"
		   text="『おやおや～、男の人は苦手なんじゃなかったのかね？』" voices=""/>
		<msg @l="1121" char_id="0" frame_id="-1" name="美帆" text="『そ、そういうのじゃないって‥‥。』"
		   voices=""/>
		<msg @l="1123" char_id="0" frame_id="-1" name="美帆"
		   text="『なんていうか、稲庭先輩ってちょっと不思議な感じがする。』" voices=""/>
		<msg @l="1125" char_id="0" frame_id="-1" name="美帆" text="『上手く‥‥言えないけど。』"
		   voices=""/>
		<msg @l="1127" char_id="-1" frame_id="-1" name="女友達"
		   text="『そうやって知らず知らず恋に落ちていくものなのよ。』" voices=""/>
		<msg @l="1129" char_id="0" frame_id="-1" name="美帆" text="『恋‥‥なのかなぁ。』"
		   voices=""/>
		<msg @l="1131" char_id="-1" frame_id="-1" name="女友達"
		   text="『こうしてまた、ライバルが一人また一人と増えていくんだわ！』" voices=""/>
		<msg @l="1133" char_id="-1" frame_id="-1" name="女友達"
		   text="『美帆、悪いけどアンタにだって譲らないからね！』" voices=""/>
		<msg @l="1135" char_id="0" frame_id="-1" name="美帆"
		   text="『もう、だからそういうのじゃないってば‥‥！』" voices=""/>
		<msg @l="1137" char_id="-1" frame_id="-1" name="女友達" text="『わかったわかった。』"
		   voices=""/>
		<msg @l="1139" char_id="-1" frame_id="-1" name="女友達"
		   text="『お子様な美帆にはまだ恋は早かったわね～。』" voices=""/>
		<msg @l="1141" char_id="0" frame_id="-1" name="美帆" text="『うぅ‥‥お子様じゃないもん。』"
		   voices=""/>
		<msg @l="1143" char_id="-1" frame_id="-1" name="女友達" text="『ほら、膨れてないで行くよっ！』"
		   voices=""/>
		<msg @l="1145" char_id="0" frame_id="-1" name="美帆" text="『あ、もうっ‥‥待ってよぉ！』"
		   voices=""/>
		<msg @l="1147" char_id="-1" frame_id="-1" name=""
		   text="スタスタと一人で歩き始めた友人を追って、私も小走りに駆け出す。" voices=""/>
		<clear @l="1153" class="all"/>
		<msg @l="1155" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="1157" char_id="0" frame_id="-1" name="美帆" text="『稲庭先輩‥‥かぁ。』"
		   voices=""/>
		<msg @l="1159" char_id="-1" frame_id="-1" name=""
		   text="先を行く友人の背中を追いかけながら、私は小さくつぶやく。" voices=""/>
		<msg @l="1160" char_id="-1" frame_id="-1" name="" text="やはり‥‥少しだけ不思議な感じがした。"
		   voices=""/>
		<stopbgm @l="1164" fadeout="1000"/>
		<clear @l="1170" class="all"/>
		<msgshow @l="1172" show="true"/>
		<stopbgm @l="1175" fadeout="1000"/>
		<wait_chgmv/>
		<bg @l="1179" src="bg01b"/>
		<msg @l="1182" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="1184" char_id="-1" frame_id="-1" name=""
		   text="白石先輩の作ったロールキャベツを二人で食べた後。" voices=""/>
		<msg @l="1185" char_id="-1" frame_id="-1" name=""
		   text="私は部屋に戻って課題の英訳を淡々とこなしていた。" voices=""/>
		<msg @l="1186" char_id="-1" frame_id="-1" name=""
		   text="解らない単語の意味を調べ、言葉として成立するように並び替えて繋げる。" voices=""/>
		<msg @l="1187" char_id="-1" frame_id="-1" name=""
		   text="多分これを続けたところで、課題的な「英訳」は上手くなっても英語それ自体はほとんど身につかないのだろうと思う。" voices=""/>
		<msg @l="1188" char_id="-1" frame_id="-1" name=""
		   text="むしろ単に文献を読むだけではなく現地に行ってしまった方が何倍も早い。" voices=""/>
		<msg @l="1189" char_id="-1" frame_id="-1" name=""
		   text="習うより慣れよという格言があるほどだし。" voices=""/>
		<msg @l="1190" char_id="-1" frame_id="-1" name=""
		   text="ふとそんな事が頭を過ぎて‥‥イヤになった。" voices=""/>
		<msg @l="1192" char_id="0" frame_id="-1" name="美帆" text="『‥‥ダメだなぁ、私。』"
		   voices=""/>
		<se @l="1196" buf="1" src="ベッドに倒れこむ音" volume="1."/>
		<bgm @l="1199" src="bgm03" volume="1."/>
		<msg @l="1201" char_id="-1" frame_id="-1" name="" text="ペンを置いてベッドに寝転がる。"
		   voices=""/>
		<msg @l="1202" char_id="-1" frame_id="-1" name=""
		   text="仰向けになって天井を眺めていると、何となくそこが自分だけの空間になったような錯覚に見舞われる。" voices=""/>
		<msg @l="1203" char_id="-1" frame_id="-1" name=""
		   text="ボーッとすると、嫌でも昼間の事を思い出しそうになってきた。" voices=""/>
		<msg @l="1204" char_id="-1" frame_id="-1" name=""
		   text="私は頭を振って、昼間の事を思い出さないように努力した。" voices=""/>
		<msg @l="1205" char_id="-1" frame_id="-1" name=""
		   text="しかし、考えないようにすればするほど、昼間の痴漢の事を思い出しそうになる‥‥。" voices=""/>
		<msg @l="1206" char_id="-1" frame_id="-1" name="" text="こういうとき、一人はダメだと思う。"
		   voices=""/>
		<msg @l="1207" char_id="-1" frame_id="-1" name="" text="何処までも気分が落ちていってしまう。"
		   voices=""/>
		<stopbgm @l="1211" fadeout="1000"/>
		<clear @l="1217" class="all"/>
		<msg @l="1219" char_id="0" frame_id="-1" name="美帆"
		   text="(先輩、まだリビングにいるといいな‥‥)" voices=""/>
		<msg @l="1221" char_id="-1" frame_id="-1" name="" text="私はゆっくりとベッドから起き上がった。"
		   voices=""/>
		<msg @l="1222" char_id="-1" frame_id="-1" name=""
		   text="先輩がリビングに居なかったらお風呂に入ってさっさと寝てしまおう。" voices=""/>
		<msg @l="1223" char_id="-1" frame_id="-1" name=""
		   text="そんな事を考えながら私は部屋を出て、廊下からリビングの扉を見る。" voices=""/>
		<msg @l="1224" char_id="-1" frame_id="-1" name="" text="リビングにはまだ灯りが点いていた。"
		   voices=""/>
		<wait_chgmv/>
		<bg @l="1228" src="bg03b"/>
		<wait @l="1231" time="100"/>
		<bgm @l="1235" src="bgm05" volume="1."/>
		<char @l="1240" id="miho" pos="auto" src="miho030"/>
		<msg @l="1242" char_id="0" frame_id="-1" name="美帆" text="『先輩、まだ起きてたんですね。』"
		   voices=""/>
		<clear @l="1245" class="char"/>
		<char @l="1248" id="miho" pos="left" src="miho030"/>
		<char @l="1251" id="rei" pos="right" src="rei030"/>
		<msg @l="1253" char_id="1" frame_id="-1" name="玲"
		   text="『アナタこそ、明日も一限からなんでしょう？』" voices=""/>
		<char @l="1257" id="miho" pos="left" src="miho036"/>
		<msg @l="1259" char_id="0" frame_id="-1" name="美帆"
		   text="『課題があって起きてたんです‥‥けど、ちょっと集中出来なくて。』" voices=""/>
		<msg @l="1261" char_id="1" frame_id="-1" name="玲" text="『そうね‥‥そういう時もあるわね。』"
		   voices=""/>
		<clear @l="1265" layer="rei"/>
		<msg @l="1267" char_id="1" frame_id="-1" name="玲" text="『コーヒーいれるけど、飲む？』"
		   voices=""/>
		<clear @l="1271" layer="miho"/>
		<msg @l="1273" char_id="0" frame_id="-1" name="美帆" text="『あ、私やりますよ。』"
		   voices=""/>
		<msg @l="1275" char_id="1" frame_id="-1" name="玲" text="『いいからアナタは座ってなさい。』"
		   voices=""/>
		<char @l="1279" id="miho" pos="auto" src="miho030"/>
		<msg @l="1281" char_id="-1" frame_id="-1" name=""
		   text="白石先輩は立ち上がろうとした私の肩に手を置いて制止すると、パタパタとスリッパの音を立てながらキッチンの中へ入っていく。"
		   voices=""/>
		<msg @l="1282" char_id="-1" frame_id="-1" name="" text="気を‥‥つかってくれたのかもしれない。"
		   voices=""/>
		<msg @l="1284" char_id="1" frame_id="-1" name="玲" text="『寝る前だから薄い方が良いわよね？』"
		   voices=""/>
		<msg @l="1286" char_id="0" frame_id="-1" name="美帆"
		   text="『そうですね‥‥それでお願いします。』" voices=""/>
		<msg @l="1288" char_id="1" frame_id="-1" name="玲" text="『おっけー。』" voices=""/>
		<msg @l="1290" char_id="-1" frame_id="-1" name=""
		   text="言葉の後、カチャカチャと食器のぶつかる音が聞こえてくる。" voices=""/>
		<msg @l="1292" char_id="1" frame_id="-1" name="玲" text="『お砂糖はいつも通り二つでいい？』"
		   voices=""/>
		<char @l="1296" id="miho" pos="auto" src="miho036"/>
		<msg @l="1298" char_id="0" frame_id="-1" name="美帆" text="『んと‥‥少し甘めでお願いします。』"
		   voices=""/>
		<msg @l="1300" char_id="1" frame_id="-1" name="玲" text="『太っちゃうわよ～。』"
		   voices=""/>
		<msg @l="1302" char_id="0" frame_id="-1" name="美帆" text="『今日だけ特別です。』"
		   voices=""/>
		<msg @l="1304" char_id="1" frame_id="-1" name="玲" text="『そう、それじゃあ三つにしておくわ。』"
		   voices=""/>
		<char @l="1308" id="miho" pos="auto" src="miho031"/>
		<msg @l="1310" char_id="0" frame_id="-1" name="美帆" text="『はい。』" voices=""/>
		<msg @l="1312" char_id="-1" frame_id="-1" name=""
		   text="そうしてしばらく沈黙のまま白石先輩はコーヒーを入れ、私はテレビに映っていた恋愛ドラマを特に見入るでもなくぼんやりと眺めていた。"
		   voices=""/>
		<char @l="1316" id="miho" pos="auto" src="miho030"/>
		<msg @l="1318" char_id="-1" frame_id="-1" name=""
		   text="ヒロインらしき女性が、主人公と楽しげに歩いていると、突然、その主人公の後輩という女性が出てきて‥‥" voices=""/>
		<msg @l="1319" char_id="-1" frame_id="-1" name=""
		   text="その主人公はその後輩の女性が好き‥‥みたいな事になっていた。" voices=""/>
		<wait @l="1322" time="100"/>
		<bgm @l="1325" src="bgm06" volume="1."/>
		<msg @l="1327" char_id="1" frame_id="-1" name="玲" text="『この子も、なにグズグズしてるのよ。』"
		   voices=""/>
		<msg @l="1329" char_id="-1" frame_id="-1" name=""
		   text="先輩が、ＴＶに向かって話しながら、私にコーヒ入りのカップを渡してくれた。" voices=""/>
		<msg @l="1330" char_id="-1" frame_id="-1" name=""
		   text="目はドラマに注いだまま、彼女は口にグラスを持っていった。" voices=""/>
		<msg @l="1332" char_id="-1" frame_id="-1" name=""
		   text="グラスにはビールがなみなみと注がれていた。" voices=""/>
		<msg @l="1333" char_id="-1" frame_id="-1" name=""
		   text="それを先輩は一気に煽ると再び、ＴＶに向かって話はじめた。" voices=""/>
		<msg @l="1335" char_id="1" frame_id="-1" name="玲"
		   text="『え？そこで、譲るのぉ？信じられない‥‥私なら絶対諦めないわ。』" voices=""/>
		<char @l="1339" id="miho" pos="auto" src="miho133"/>
		<msg @l="1341" char_id="0" frame_id="-1" name="美帆"
		   text="『先輩‥‥ひょっとして、酔ってますか？』" voices=""/>
		<msg @l="1343" char_id="-1" frame_id="-1" name=""
		   text="いつもの先輩のイメージとはちょっと違う、普通の女子大生っぽい彼女になっていた。" voices=""/>
		<msg @l="1345" char_id="1" frame_id="-1" name="玲"
		   text="『酔ってなんか、ないわよ！そんな事よりも譲る？普通！？』" voices=""/>
		<msg @l="1347" char_id="0" frame_id="-1" name="美帆"
		   text="『ドラマの話ですから、そんなに熱くならなくても。』" voices=""/>
		<msg @l="1349" char_id="1" frame_id="-1" name="玲"
		   text="『でもね、後から出てきた娘なんかに自分の好きな人譲る？』" voices=""/>
		<char @l="1353" id="miho" pos="auto" src="miho034"/>
		<msg @l="1355" char_id="0" frame_id="-1" name="美帆" text="『え‥‥？』" voices=""/>
		<msg @l="1357" char_id="-1" frame_id="-1" name=""
		   text="不意に聞かれ、私は戸惑った。現実のことなのか、ドラマ内のことなのか‥‥。" voices=""/>
		<clear @l="1360" class="char"/>
		<char @l="1364" id="rei" pos="right" src="rei033"/>
		<msg @l="1366" char_id="1" frame_id="-1" name="玲"
		   text="『私なら、誰が相手でも諦めないけどなぁ‥‥。』" voices=""/>
		<msg @l="1368" char_id="-1" frame_id="-1" name=""
		   text="そう言って、先輩は少し遠い目をした。‥‥おそらくこのドラマのヒロインと自分を重ね合わせているのだろう。" voices=""/>
		<char @l="1373" id="rei" pos="right" src="rei031"/>
		<msg @l="1375" char_id="1" frame_id="-1" name="玲" text="『美帆なら‥‥どう？諦める？』"
		   voices=""/>
		<char @l="1379" id="miho" pos="left" src="miho134"/>
		<msg @l="1381" char_id="0" frame_id="-1" name="美帆" text="『えぅ？‥わた‥し‥ですか？』"
		   voices=""/>
		<msg @l="1383" char_id="-1" frame_id="-1" name=""
		   text="またまた振られ、私は戸惑いを隠せなかった。" voices=""/>
		<char @l="1387" id="rei" pos="right" src="rei030"/>
		<msg @l="1389" char_id="1" frame_id="-1" name="玲"
		   text="『う～ん。美帆の性格なら、このヒロインと同じで諦めそうだなぁ。』" voices=""/>
		<msg @l="1391" char_id="-1" frame_id="-1" name=""
		   text="私の答えを待たずに、先輩は結論づけてしまったようだ。それはそれで困るのだが、ここはそれでよしとしよう。" voices=""/>
		<char @l="1395" id="miho" pos="left" src="miho033"/>
		<msg @l="1397" char_id="0" frame_id="-1" name="美帆"
		   text="『そ‥‥そですね。私も諦めちゃいます。』" voices=""/>
		<char @l="1401" id="rei" pos="right" src="rei037"/>
		<msg @l="1403" char_id="1" frame_id="-1" name="玲"
		   text="『だ・か・ら！そこがわからないのよねぇ。』" voices=""/>
		<msg @l="1405" char_id="1" frame_id="-1" name="玲"
		   text="『自分が好きな人なのよ！アイラブユーなのよ？！』" voices=""/>
		<char @l="1409" id="miho" pos="left" src="miho036"/>
		<msg @l="1411" char_id="0" frame_id="-1" name="美帆"
		   text="『先輩‥‥なんか、変なテンションなんですけど‥‥』" voices=""/>
		<char @l="1415" id="rei" pos="right" src="rei034"/>
		<msg @l="1417" char_id="1" frame_id="-1" name="玲"
		   text="『だって‥‥アナタが落ち込んでるから‥あっ！！』" voices=""/>
		<stopbgm @l="1421" fadeout="1000"/>
		<char @l="1425" id="miho" pos="left" src="miho131"/>
		<msg @l="1427" char_id="0" frame_id="-1" name="美帆" text="『ふふ‥‥。』" voices=""/>
		<msg @l="1429" char_id="-1" frame_id="-1" name=""
		   text="私は先輩が気をつかって励ましてくれている事に気づき、嬉しくてつい笑みがこぼれてしまった。" voices=""/>
		<char @l="1433" id="rei" pos="right" src="rei033"/>
		<bgm @l="1435" src="bgm05" volume="1."/>
		<msg @l="1438" char_id="1" frame_id="-1" name="玲"
		   text="『もう、柄にもない事するんじゃなかったわ。』" voices=""/>
		<char @l="1443" id="miho" pos="left" src="miho031"/>
		<msg @l="1445" char_id="0" frame_id="-1" name="美帆" text="『うふふ。ありがとうございます。』"
		   voices=""/>
		<msg @l="1447" char_id="-1" frame_id="-1" name=""
		   text="先輩が、恥ずかしそうにしながらグラスを口に運び残りのビールを飲んだ。" voices=""/>
		<msg @l="1448" char_id="-1" frame_id="-1" name=""
		   text="私も彼女にならうようにコーヒーを一口すすった。" voices=""/>
		<msg @l="1449" char_id="-1" frame_id="-1" name="" text="砂糖三つは想像以上に甘かった。"
		   voices=""/>
		<char @l="1453" id="miho" pos="left" src="miho136"/>
		<char @l="1457" id="rei" pos="right" src="rei031"/>
		<msg @l="1459" char_id="1" frame_id="-1" name="玲" text="『やっぱり二つがよかったかしら？』"
		   voices=""/>
		<char @l="1463" id="miho" pos="left" src="miho131"/>
		<msg @l="1465" char_id="0" frame_id="-1" name="美帆"
		   text="『いえ、このくらい甘い方が‥‥落ち着きます。』" voices=""/>
		<msg @l="1467" char_id="1" frame_id="-1" name="玲" text="『そんなものかしらね。』"
		   voices=""/>
		<msg @l="1469" char_id="-1" frame_id="-1" name=""
		   text="白石先輩はそう言って笑うと、再びテレビ画面へと視線をやる。" voices=""/>
		<msg @l="1470" char_id="-1" frame_id="-1" name="" text="彼女の優しさが、今はとても嬉しかった。"
		   voices=""/>
		<clear @l="1476" class="all"/>
		<wait_chgmv/>
		<bg @l="1480" src="bg03b"/>
		<char @l="1484" id="miho" pos="auto" src="miho030"/>
		<msg @l="1486" char_id="0" frame_id="-1" name="美帆" text="『私、お風呂入ってきます。』"
		   voices=""/>
		<msg @l="1488" char_id="0" frame_id="-1" name="美帆"
		   text="『そのまま寝ますから、電気消しちゃってください。』" voices=""/>
		<msg @l="1490" char_id="-1" frame_id="-1" name=""
		   text="甘いコーヒーを飲み終わり、私は立ち上がる。" voices=""/>
		<msg @l="1491" char_id="-1" frame_id="-1" name=""
		   text="ちょうど、ＴＶ番組もエンディングのテロップが流れていた。" voices=""/>
		<clear @l="1494" class="char"/>
		<char @l="1496" id="miho" pos="left" src="miho030"/>
		<char @l="1499" id="rei" pos="right" src="rei030"/>
		<msg @l="1501" char_id="1" frame_id="-1" name="玲" text="『課題はいいの？』" voices=""/>
		<msg @l="1503" char_id="0" frame_id="-1" name="美帆" text="『締め切りは今週一杯ですから。』"
		   voices=""/>
		<msg @l="1505" char_id="1" frame_id="-1" name="玲" text="『そう、がんばってね。』"
		   voices=""/>
		<char @l="1509" id="miho" pos="left" src="miho031"/>
		<msg @l="1511" char_id="0" frame_id="-1" name="美帆" text="『はい。ありがとうございます。』"
		   voices=""/>
		<msg @l="1513" char_id="1" frame_id="-1" name="玲" text="『‥‥‥‥。』" voices=""/>
		<msg @l="1515" char_id="1" frame_id="-1" name="玲" text="『ごめんなさいね。』"
		   voices=""/>
		<char @l="1519" id="miho" pos="left" src="miho030"/>
		<msg @l="1521" char_id="0" frame_id="-1" name="美帆" text="『はい‥‥？』" voices=""/>
		<msg @l="1523" char_id="1" frame_id="-1" name="玲" text="『あまり力になれなくて。』"
		   voices=""/>
		<msg @l="1525" char_id="0" frame_id="-1" name="美帆" text="『そんなことありませんよ。』"
		   voices=""/>
		<char @l="1529" id="miho" pos="left" src="miho031"/>
		<msg @l="1531" char_id="0" frame_id="-1" name="美帆" text="『コーヒー、美味しかったです。』"
		   voices=""/>
		<char @l="1535" id="rei" pos="right" src="rei031"/>
		<msg @l="1537" char_id="1" frame_id="-1" name="玲" text="『そう‥‥よかった。』"
		   voices=""/>
		<char @l="1541" id="miho" pos="left" src="miho131"/>
		<msg @l="1543" char_id="0" frame_id="-1" name="美帆" text="『それじゃ、おやすみなさい。』"
		   voices=""/>
		<stopbgm @l="1547" fadeout="1000"/>
		<clear @l="1553" class="all"/>
		<msgshow @l="1555" show="true"/>
		<msg @l="1557" char_id="-1" frame_id="-1" name=""
		   text="私はそして、熱いお風呂に入ってから布団の中へ潜り込んだ。" voices=""/>
		<msg @l="1558" char_id="-1" frame_id="-1" name=""
		   text="布団を頭までかぶってゆっくり目をつむると、すぐに睡魔が襲ってきて。" voices=""/>
		<msg @l="1559" char_id="-1" frame_id="-1" name=""
		   text="余計な事を考える間もなく私は深い眠りへと転がり落ちていく。" voices=""/>
		<msg @l="1561" char_id="1" frame_id="-1" name="声" text="『‥‥おやすみ。』" voices=""/>
		<msg @l="1563" char_id="-1" frame_id="-1" name=""
		   text="ふと、薄れいく意識の中で誰かの声を聞いた。" voices=""/>
		<msg @l="1564" char_id="-1" frame_id="-1" name=""
		   text="それはなぜか白石先輩のような、それでいてお母さんの声に似ているような優しい気がした。" voices=""/>
		<msgshow @l="1567" show="false"/>
		<call @l="1570" target="EventLabel_23@common_root02"/>
		<return @l="1571" value="0&#13;&#10;"/>
	</code>
</xscript>
