<?xml version="1.0" encoding="utf-8"?>
<xscript>
	<debug editor="&quot;C:\Program&#32;Files&#32;(x86)\sakura\sakura.exe&quot;&#32;&quot;%src%&quot;&#32;-Y=%line%"
	   src="D:\シロップ\町ぐるみの罠＋汚された夏セット版\汚された夏\完成データ\汚された夏\script\text\ending07.txt"/>
	<code>
		<label @l="13" id="EventLabel_45"/>
		<description @l="17" text="壊れた歯車"/>
		<eval @l="19" expr="f.numDay=0&#13;&#10;"/>
		<msg @l="21" char_id="-1" frame_id="-1" name=""
		   text="会社員達に輪姦された美帆と玲は、そのまま監禁され男を喜ばせる為のありとあらゆるテクニックを仕込まれる。" voices=""/>
		<msg @l="22" char_id="-1" frame_id="-1" name=""
		   text="二人は何十人もの男達の精液を膣内に、身体中に浴びせられいつも白濁液まみれにされ、とうとう雌奴隷へと調教されてしまった。"
		   voices=""/>
		<msg @l="24" char_id="-1" frame_id="-1" name="" text="それから一ヵ月後―――――"
		   voices=""/>
		<wait_chgmv/>
		<bg @l="28" src="bg17m1"/>
		<bgm @l="32" src="bgm03" volume="1."/>
		<msg @l="34" char_id="-1" frame_id="-1" name="" text="―――某日・大黒建設オフィス。"
		   voices=""/>
		<msg @l="35" char_id="-1" frame_id="-1" name=""
		   text="オフィスの時計が午前の業務時間終了を告げ、オフィスのあちこちから疲労を多分に含んだため息や、背伸びの声などが聞こえてくる。"
		   voices=""/>
		<msg @l="37" char_id="-1" frame_id="-1" name="男子社員Ａ"
		   text="『ん～‥‥やっと昼休みだな。じゃぁ俺、営業成績優秀賞をもらってくるわ。』" voices=""/>
		<msg @l="39" char_id="-1" frame_id="-1" name=""
		   text="それまでせわしなくキーボードを叩いていた男が背伸びをしながらつぶやき、待ち遠しかった時間の到来に顔を緩ませる。" voices=""/>
		<msg @l="41" char_id="-1" frame_id="-1" name="男子社員Ｂ"
		   text="『オマエ、また行けるのか？いいなぁー、俺も一度でいいから行ってみてぇよ。』" voices=""/>
		<msg @l="43" char_id="-1" frame_id="-1" name="" text="隣の男が弁当箱を広げながら言う。"
		   voices=""/>
		<msg @l="45" char_id="-1" frame_id="-1" name="男子社員Ａ"
		   text="『じゃぁ仕事頑張って賞をもらわないとね。俺はこの賞取る為に凄い努力したからなー。』" voices=""/>
		<msg @l="47" char_id="-1" frame_id="-1" name="男子社員Ｂ"
		   text="『はいはい分かったよ。頑張りますよ。で、今日はどっちにするんだよ？』" voices=""/>
		<msg @l="49" char_id="-1" frame_id="-1" name="男子社員Ａ"
		   text="『どっちにしようかなー。うっ、やべぇ！想像しただけで勃っちまった。』" voices=""/>
		<msg @l="51" char_id="-1" frame_id="-1" name="男子社員Ｂ"
		   text="『分かったよ、自慢してないで早く行って楽しんでこいよ。』" voices=""/>
		<msg @l="52" char_id="-1" frame_id="-1" name="男子社員Ａ"
		   text="『へへー、じゃぁ堪能してくるよ。』" voices=""/>
		<msg @l="54" char_id="-1" frame_id="-1" name="男子社員B"
		   text="『ははっ、嬉しそうに行きやがった･･････。』" voices=""/>
		<msg @l="56" char_id="-1" frame_id="-1" name="男子社員B"
		   text="『あれっ、オマエも確か特別賞を取ってなかったっけ？行かないの？』" voices=""/>
		<msg @l="58" char_id="-1" frame_id="-1" name="男子社員C"
		   text="『俺は別の娘なんだよねー。特別賞の場合は町の女の子のリストの中から好きな子を指名できるんだよ。だから今日は憧れのパン屋のあの子と‥‥うひっ。』"
		   voices=""/>
		<msg @l="60" char_id="-1" frame_id="-1" name="男子社員B"
		   text="『オマエもいいなぁ。うらやましぃー！』" voices=""/>
		<msg @l="62" char_id="-1" frame_id="-1" name="男子社員C" text="『じゃ、俺行ってくるわ。』"
		   voices=""/>
		<msg @l="64" char_id="-1" frame_id="-1" name=""
		   text="そうして、男は立ち上がりオフィスを出て行く。" voices=""/>
		<msg @l="65" char_id="-1" frame_id="-1" name=""
		   text="彼の他にも賞を取った社員は同様にオフィスを出て行く姿がちらほらとあり、みな向かう場所は同じのようである。" voices=""/>
		<msg @l="67" char_id="-1" frame_id="-1" name="男子社員Ｂ"
		   text="『俺も‥‥秘書課の子とやりてぇなぁー････。今月は仕事頑張るか････。』" voices=""/>
		<msg @l="69" char_id="-1" frame_id="-1" name=""
		   text="弁当を広げながら、取り残された男は残念そうにつぶやいていた。" voices=""/>
		<stopbgm @l="73" fadeout="1000"/>
		<clear @l="79" class="all"/>
		<label @l="82" id="event_scene32"/>
		<msgshow @l="85" show="true"/>
		<bgm @l="89" src="bgm14" volume="1."/>
		<msg @l="91" char_id="0" frame_id="-1" name="美帆" text="『ん、ああっ‥‥！！』"
		   voices="miho11640"/>
		<msg @l="93" char_id="-1" frame_id="-1" name=""
		   text="狭い空間に、私のあえぎ声が生々しく響き渡る。" voices=""/>
		<msg @l="94" char_id="-1" frame_id="-1" name=""
		   text="私は‥‥あれから毎日のように犯され続けていた。" voices=""/>
		<msg @l="95" char_id="-1" frame_id="-1" name=""
		   text="数十人という男たちが入れ替わり立ち代り私を犯し、果て、その度に私も望まない絶頂へと連れて行かれた。" voices=""/>
		<msg @l="96" char_id="-1" frame_id="-1" name="" text="幾日ほど過ぎた頃からだろう‥‥。"
		   voices=""/>
		<msg @l="97" char_id="-1" frame_id="-1" name=""
		   text="そうして蹂躙される毎日が苦痛では無くなったのは。" voices=""/>
		<msg @l="98" char_id="-1" frame_id="-1" name=""
		   text="次第に交わりを求めるような言葉を言うようになり、声には艶やかなあえぎが混じるようになった。" voices=""/>
		<msg @l="99" char_id="-1" frame_id="-1" name=""
		   text="その度に男たちは私を「メス豚」と罵倒しながら大量の精液を放つ。" voices=""/>
		<msg @l="101" char_id="-1" frame_id="-1" name="真島"
		   text="『そんじゃ、アンタは明日から便所になってもらうわ。』" voices=""/>
		<msg @l="103" char_id="-1" frame_id="-1" name=""
		   text="そんな簡単なひと言で、私は男たちの精液を受け止める「便所」になった。" voices=""/>
		<msg @l="104" char_id="-1" frame_id="-1" name="" text="日々蔑まれ、熱い精液を注がれる。"
		   voices=""/>
		<msg @l="105" char_id="-1" frame_id="-1" name=""
		   text="そんな恥辱にさえも脳を蕩けさせながら‥‥私はあえぎ声をあげている。" voices=""/>
		<msg @l="107" char_id="-1" frame_id="-1" name="真島"
		   text="『ただの便所じゃないぜぇ、社長も使うエリート専用の高級便所だからな。』" voices=""/>
		<label @l="111" id="chart_line39"/>
		<wait_chgmv/>
		<ev @l="115" src="ev-032"/>
		<msg @l="117" char_id="-1" frame_id="-1" name=""
		   text="大黒建設最上階フロアの一角にあるトイレのうちの一つが私の職場らしい。" voices=""/>
		<msg @l="118" char_id="-1" frame_id="-1" name=""
		   text="ここでは、良い成績を上げたものだけが使う事を許されるトイレだった。" voices=""/>
		<msg @l="119" char_id="-1" frame_id="-1" name=""
		   text="美帆は荒縄で身体中を縛り上げられ、柔肌に縄を食い込ませていた。さらに台座に固定され足を開かせられいつでも男達の肉棒を受け入れられるようにさせられていたのだ。"
		   voices=""/>
		<msg @l="120" char_id="-1" frame_id="-1" name=""
		   text="さすがに高級というだけあって身なりはいつも清潔に保たれていたが、食事に関しては週一回与えられる他は精液以外口にする事は許されなかった。"
		   voices=""/>
		<msg @l="122" char_id="1" frame_id="-1" name="玲" text="『んんっ‥‥あっ、んうっ！！』"
		   voices="rei02660"/>
		<msg @l="124" char_id="-1" frame_id="-1" name="" text="薄い壁越しに、別な嬌声が響いてくる。"
		   voices=""/>
		<msg @l="126" char_id="0" frame_id="-1" name="美帆" text="(ああ‥‥隣でも始まったんだ)"
		   voices="miho11650"/>
		<msg @l="128" char_id="-1" frame_id="-1" name=""
		   text="隣の便器の人‥‥えっと‥‥誰だったっけ‥‥。" voices=""/>
		<msg @l="129" char_id="-1" frame_id="-1" name=""
		   text="私は悦楽に蕩けた頭の片隅でぼんやりと考えるが、すぐにその思考が消える。" voices=""/>
		<msg @l="130" char_id="-1" frame_id="-1" name="" text="‥‥どうでもいい。" voices=""/>
		<msg @l="131" char_id="-1" frame_id="-1" name=""
		   text="いまは胎内をかき混ぜる熱い肉棒の感触に酔っていたかった。" voices=""/>
		<msg @l="133" char_id="-1" frame_id="-1" name=""
		   text="美帆の隣にいたのは身体をリバイバー（菱形ボンテージ）で、手はフラバ（手枷）で拘束されていた玲だった。" voices=""/>
		<msg @l="134" char_id="-1" frame_id="-1" name=""
		   text="玲は自ら男の肉棒を欲するかのように、男の上に腰を下ろすような格好で肉棒を秘裂に差し込んでいた。" voices=""/>
		<msg @l="136" char_id="0" frame_id="-1" name="美帆"
		   text="『んあっ‥‥奥まできて‥‥‥んっ、あふっ！』" voices="miho11660"/>
		<msg @l="138" char_id="-1" frame_id="-1" name=""
		   text="壁越しに聞こえてくる嬌声を意識するように、私のアソコを貫いていた熱棒が強く膣の奥を突き上げてきた。" voices=""/>
		<msg @l="139" char_id="-1" frame_id="-1" name=""
		   text="大きくエラの張った亀頭が奥深くのヒダを押し広げるたびに、痺れるような甘い快感が子宮に響く。" voices=""/>
		<msg @l="141" char_id="-1" frame_id="-1" name="男子社員D"
		   text="『すげっ‥‥さすがエリート専用便器、頑張っていい成績を取った甲斐があったぜ！うぉっ、搾り取られそうだっ！』" voices=""/>
		<msg @l="143" char_id="-1" frame_id="-1" name=""
		   text="男は上擦った声をあげながら、一心不乱に秘部をかき混ぜている。" voices=""/>
		<msg @l="144" char_id="-1" frame_id="-1" name=""
		   text="こうして私を犯すことが許されているのは一部の時間だけらしく、精液を注ぎに来る彼らはいつも無心で腰を振る。" voices=""/>
		<msg @l="145" char_id="-1" frame_id="-1" name=""
		   text="自分が放つことだけを優先し、便器の私になど微塵の気づかいもない。" voices=""/>
		<msg @l="146" char_id="-1" frame_id="-1" name=""
		   text="単純な排泄行為が、ただ延々と繰り返されるのみだ。" voices=""/>
		<msg @l="148" char_id="0" frame_id="-1" name="美帆"
		   text="『ああっ‥‥ンっ、あっ、あっ、あっ、んくっっ！』" voices="miho11670"/>
		<msg @l="150" char_id="0" frame_id="-1" name="美帆"
		   text="『奥っ、奥が擦れてっ‥‥‥ンっ、ああああっ！！！』" voices="miho11680"/>
		<flash @l="154" count="4" fade="100" image="white"/>
		<msg @l="156" char_id="0" frame_id="-1" name="美帆" text="『ん、あああああああっ！！』"
		   voices="miho11040"/>
		<msg @l="158" char_id="-1" frame_id="-1" name=""
		   text="激しい律動に突き上げられるように、私は達してしまう。" voices=""/>
		<msg @l="159" char_id="-1" frame_id="-1" name=""
		   text="それが今日何十回目の絶頂かはもう覚えてはいない。" voices=""/>
		<msg @l="160" char_id="-1" frame_id="-1" name=""
		   text="目の前がフラッシュアウトするように真っ白になったかと思うと、次いで鈍い痺れが後頭部の辺りから広がって何もかもをどうでも良くしてくれる。"
		   voices=""/>
		<msg @l="162" char_id="-1" frame_id="-1" name="男子社員D" text="『うおっ‥‥し、締まるっ！！』"
		   voices=""/>
		<msg @l="164" char_id="-1" frame_id="-1" name=""
		   text="絶頂の階段を駆け上る最中、けいれんするように収縮する膣壁の動きに導かれ、男もまた頂点に達して熱い液体を膣内に注ぎ込む。"
		   voices=""/>
		<msg @l="165" char_id="-1" frame_id="-1" name=""
		   text="腰を目一杯に押し付け、先端をなるべく一番奥深くへともぐりこませて。" voices=""/>
		<msg @l="166" char_id="-1" frame_id="-1" name=""
		   text="ともすれば子宮口を無理やり押し開き、吐き出す精液の全てをその奥へ流し込もうとするかのように。" voices=""/>
		<msg @l="168" char_id="0" frame_id="-1" name="美帆" text="『んっ‥‥。』"
		   voices="miho11690"/>
		<msg @l="170" char_id="-1" frame_id="-1" name=""
		   text="胎内奥深くが熱い液体で満たされる感触に、私の快楽は更に加速する。" voices=""/>
		<msg @l="171" char_id="-1" frame_id="-1" name=""
		   text="幾度となく繰り返される脈動と共に流し込まれる熱い液体が、収まりかけていた絶頂の波を再び呼び戻して私を蕩けさせた。" voices=""/>
		<msg @l="173" char_id="-1" frame_id="-1" name="男子社員D"
		   text="『すげ‥‥まだ絡み付いてきやがる。』" voices=""/>
		<msg @l="175" char_id="-1" frame_id="-1" name=""
		   text="精を放った男は私の身体を貫いたまま、ぶるりと腰を震わせる。" voices=""/>
		<msg @l="176" char_id="-1" frame_id="-1" name=""
		   text="幾度も押し寄せる絶頂の波にあわせてうねる膣壁の感触に、歓喜しているのだ。" voices=""/>
		<msg @l="178" char_id="-1" frame_id="-1" name="男子社員Ａ"
		   text="『おい、後がつかえてるんだぜ。』" voices=""/>
		<msg @l="180" char_id="-1" frame_id="-1" name="男子社員Ｄ" text="『チッ‥‥わかってるって。』"
		   voices=""/>
		<msg @l="182" char_id="-1" frame_id="-1" name=""
		   text="いつまでも「便器」の前から離れようとしない男に、その背後に並んでいた男が不満を言う。" voices=""/>
		<msg @l="183" char_id="-1" frame_id="-1" name=""
		   text="気付けばその狭い部屋のなかは幾人もの男で溢れ返っていて、皆が待ち遠しそうにこちらを見つめている。" voices=""/>
		<msg @l="185" char_id="0" frame_id="-1" name="美帆"
		   text="(あはっ‥‥あっちの人なんて、もう先走りでぬるぬるになってる)" voices="miho11700"/>
		<msg @l="187" char_id="0" frame_id="-1" name="美帆"
		   text="(向こうの人はまだ元気がない‥‥早く、硬くしてくれるといいな)" voices="miho11710"/>
		<msg @l="189" char_id="-1" frame_id="-1" name=""
		   text="意識がもうろうとするような悦楽の中で、私は排泄に訪れた男たちの股間を眺めては嬉しそうな表情を浮かべる。" voices=""/>
		<msg @l="190" char_id="-1" frame_id="-1" name="" text="まだ終わらない‥‥。" voices=""/>
		<msg @l="191" char_id="-1" frame_id="-1" name=""
		   text="この愉悦の時間がまだまだ続くのだと思うと、熱くなった身体の奥から大量の蜜が滲みだして秘部から溢れ出してしまっていた。"
		   voices=""/>
		<msg @l="193" char_id="-1" frame_id="-1" name="大黒" text="『おやおや、隣は激しいですねぇ。』"
		   voices=""/>
		<msg @l="195" char_id="-1" frame_id="-1" name="" text="薄い壁に阻まれたすぐ間近。"
		   voices=""/>
		<msg @l="196" char_id="-1" frame_id="-1" name=""
		   text="大黒は玲の胎内をゆっくりと行き来しながらぼそりとつぶやいた。" voices=""/>
		<msg @l="198" char_id="1" frame_id="-1" name="玲" text="『んぅっ‥‥ん、あぁぁ‥‥‥。』"
		   voices="rei02670"/>
		<msg @l="200" char_id="-1" frame_id="-1" name=""
		   text="玲はそんな大黒の半端な律動に不満げな声を漏らし、激しく犯して欲しいと言うように腰をくねらせる。" voices=""/>
		<msg @l="201" char_id="-1" frame_id="-1" name=""
		   text="そのゆっくりと行き来する動きだけで玲は既に三度も達してしまっているにもかかわらず、大黒はまだ一度も精を放っていない。"
		   voices=""/>
		<msg @l="203" char_id="1" frame_id="-1" name="玲"
		   text="『ああっ‥‥ねえ、お願い‥‥‥はやく出してぇ‥‥‥‥。』" voices="rei02680"/>
		<msg @l="205" char_id="-1" frame_id="-1" name=""
		   text="甘えるような、すねるような‥‥そんな声をあげて射精をねだる玲。" voices=""/>
		<msg @l="206" char_id="-1" frame_id="-1" name=""
		   text="ほんの数日前までは彼女が自ら射精を促すような言葉を口走るなど、全く考えられなかっただろう。" voices=""/>
		<msg @l="207" char_id="-1" frame_id="-1" name="" text="けれど‥‥それも過去のこと。"
		   voices=""/>
		<msg @l="208" char_id="-1" frame_id="-1" name=""
		   text="理性と尊厳を称えていた彼女の瞳は、今やただ犯されたいという感情が浮かんでいるだけである。" voices=""/>
		<msg @l="210" char_id="1" frame_id="-1" name="玲"
		   text="『お願いです‥‥熱くて濃い精液‥‥‥‥たくさん、奥にください。』" voices="rei02690"/>
		<msg @l="212" char_id="-1" frame_id="-1" name=""
		   text="腰を激しく揺らしながら、玲が声を震わせる。" voices=""/>
		<msg @l="213" char_id="-1" frame_id="-1" name=""
		   text="四度目の頂点が、すぐそこまで迫っているのだろう。" voices=""/>
		<msg @l="215" char_id="-1" frame_id="-1" name="大黒"
		   text="『ふふっ、あの美しく気高かった“玲さん”がそんな言葉を言うようになるとはね。』" voices=""/>
		<msg @l="217" char_id="-1" frame_id="-1" name="大黒"
		   text="『告白してくる男を片っ端から振っても人気のあった“玲さん”が今こんな事をしているなんて････同級生の誰もが想像していないでしょうね。』"
		   voices=""/>
		<msg @l="219" char_id="1" frame_id="-1" name="玲"
		   text="『ああっ‥‥んっ、あふっ‥‥‥あっ、あっ、んぁぁっ！！』" voices="rei02280"/>
		<msg @l="221" char_id="-1" frame_id="-1" name="大黒"
		   text="『ふふっ、もう私の言葉も分かりませんか････。』" voices=""/>
		<msg @l="223" char_id="-1" frame_id="-1" name=""
		   text="大黒はそうして、玲の蜜壷を下から激しく突き上げる。" voices=""/>
		<msg @l="225" char_id="1" frame_id="-1" name="玲"
		   text="『んあっ‥‥あっ‥‥‥んっ、んっ、んっ、ああっっいいっ！！』" voices="rei02700"/>
		<msg @l="227" char_id="-1" frame_id="-1" name=""
		   text="激しく突き上げられるたび、大きな乳房を揺らしながら甘いあえぎ声を上げる玲。" voices=""/>
		<msg @l="228" char_id="-1" frame_id="-1" name=""
		   text="表情を愉悦に蕩けさせ、だらしなく緩んだ口元からは唾液が垂れ落ちて筋を作っている。" voices=""/>
		<msg @l="230" char_id="-1" frame_id="-1" name="大黒"
		   text="『いい気味ですよ、玲さん。私の事を虫を見るような目で見ていた貴女が今は私の上にまたがってよがっているのですからね。』"
		   voices=""/>
		<msg @l="232" char_id="-1" frame_id="-1" name=""
		   text="大黒は下から突き上げるようにグラインドさせながら、秘芯を指で揉み弄る。すっかり充血した女芯は少し触られるだけで目がチカチカする程敏感になっていた。"
		   voices=""/>
		<msg @l="234" char_id="1" frame_id="-1" name="玲"
		   text="『んああっ、ダメっ、んっ‥‥ああああっ！！』" voices="rei02380"/>
		<msg @l="236" char_id="1" frame_id="-1" name="玲"
		   text="『ダメぇ、そこっ‥‥んんっ‥‥‥‥そんな、突き上げないでっ‥‥‥。』" voices="rei02450"/>
		<msg @l="238" char_id="-1" frame_id="-1" name="大黒"
		   text="『おお、奥を突き上げるたびに膣全体がきつく締め付けてきますよ？』" voices=""/>
		<msg @l="240" char_id="1" frame_id="-1" name="玲"
		   text="『もっ‥‥んぁ、いくっ‥‥‥いっちゃ‥‥‥‥‥‥‥んんんっ！！』" voices="rei02300"/>
		<msg @l="242" char_id="-1" frame_id="-1" name="大黒"
		   text="『もう、只の便所女ですね。じゃぁ便所にふさわしくたっぷりと精液を子宮に注ぎ込んであげますよ。』" voices=""/>
		<msg @l="244" char_id="-1" frame_id="-1" name=""
		   text="玲の耳元で恐ろしい事を言って、大黒が更に腰を強く突き上げる。" voices=""/>
		<msg @l="245" char_id="-1" frame_id="-1" name=""
		   text="結合部からは肉棒に押し出された蜜が大量に溢れ出し、床に黒い染みを幾つも作り上げている。" voices=""/>
		<msg @l="247" char_id="1" frame_id="-1" name="玲"
		   text="『あっ、あっ、あっ、あっ‥‥ダメっ、ダメっ‥‥‥く、ああっ！！』" voices="rei02290"/>
		<msg @l="249" char_id="-1" frame_id="-1" name=""
		   text="玲は狂ったようにあえぐ。それは中出しに対する拒絶なのか、こみ上げる絶頂感に対するものなのかは分からない。" voices=""/>
		<msg @l="250" char_id="-1" frame_id="-1" name=""
		   text="そして壁の向こうから、美帆の震える声が聞こえてきた。" voices=""/>
		<msg @l="252" char_id="0" frame_id="-1" name="美帆"
		   text="『あっ‥‥ああっ‥‥‥‥あ、あ、あ‥‥‥‥ん、ふああっ！』" voices="miho10390"/>
		<msg @l="254" char_id="0" frame_id="-1" name="美帆"
		   text="『あっ、あっ、あっ‥‥いくっ、いっちゃう‥‥‥‥あああっ！！』" voices="miho11720"/>
		<msg @l="256" char_id="-1" frame_id="-1" name=""
		   text="大黒はその声を聞くとニヤリと口元を歪め、隣に合わせるように腰の動きを更に早める。" voices=""/>
		<msg @l="257" char_id="-1" frame_id="-1" name="" text="‥‥終わりをあわせるつもりなのだろう。"
		   voices=""/>
		<msg @l="259" char_id="1" frame_id="-1" name="玲"
		   text="『んあああっ‥‥あっ、奥、ぐりぐりきてっ‥‥‥ん、ふあっっ！！』" voices="rei02710"/>
		<msg @l="261" char_id="0" frame_id="-1" name="美帆"
		   text="『んんっ、んっ、んっ、んっ、んっ‥‥‥ダメ、ダメぇっ！！』" voices="miho11730"/>
		<msg @l="263" char_id="0" frame_id="-1" name="美帆"
		   text="『ああ、ああああっ‥‥‥そんな深く‥‥‥ダメ、あっ、頭‥‥おかしく‥‥‥なっちゃうぅ‥‥‥んっ‥‥ああっ！！』"
		   voices="miho10410"/>
		<msg @l="265" char_id="-1" frame_id="-1" name=""
		   text="薄い壁を隔てて玲と美帆の声が高鳴り、響く。" voices=""/>
		<msg @l="266" char_id="-1" frame_id="-1" name=""
		   text="互いに互いのあえぎ声に刺激され、更なる興奮を呼んでいる。" voices=""/>
		<msg @l="268" char_id="-1" frame_id="-1" name="大黒"
		   text="『たっぷり出してあげますから‥‥そして虫を見るような目で見ていた私の子供を孕んでしまいなさい！』" voices=""/>
		<msg @l="270" char_id="1" frame_id="-1" name="玲"
		   text="『んああっ、ダメっ、んっ‥‥ああああっ！！』" voices="rei02380"/>
		<msg @l="272" char_id="1" frame_id="-1" name="玲"
		   text="『ああっ‥きてっ‥‥いく、いくいくいくっ‥‥‥あ、ああああああっ！！』" voices="rei02720"/>
		<msg @l="274" char_id="0" frame_id="-1" name="美帆"
		   text="『出してぇー、いっぱい濃いのを中にだしてぇー‥‥‥‥。』" voices="miho12010"/>
		<msg @l="276" char_id="0" frame_id="-1" name="美帆" text="『ん、あああああああっ！！』"
		   voices="miho11040"/>
		<flash @l="280" count="4" fade="100" image="white"/>
		<msg @l="282" char_id="0" frame_id="-1" name="美帆"
		   text="『いくぅ‥‥いくっ、ああっ‥でてるっ、‥‥いっぱいお腹の中ででてるよっっっ！‥‥あっ、あっ、んああっ！！！』"
		   voices="miho11740"/>
		<flash @l="286" count="4" fade="100" image="white"/>
		<wait_chgmv/>
		<ev @l="290" src="ev-032z1"/>
		<msg @l="292" char_id="-1" frame_id="-1" name="" text="―――二つのあえぎ声が重なり、弾ける。"
		   voices=""/>
		<msg @l="293" char_id="-1" frame_id="-1" name=""
		   text="玲と美帆の膣内にはそれぞれ大量の精液が注ぎ込まれ、引き抜かれた男根に絡みつくようにして溢れ出してくる。" voices=""/>
		<msg @l="295" char_id="1" frame_id="-1" name="玲"
		   text="『んっ‥‥あっ、あっ‥‥‥‥熱いのが‥‥‥流れ込んでくる‥‥‥‥。』" voices="rei01570"/>
		<msg @l="297" char_id="1" frame_id="-1" name="玲"
		   text="『んっ‥‥ああ‥‥精液‥‥‥いっぱい‥‥。』" voices="rei02730"/>
		<msg @l="299" char_id="-1" frame_id="-1" name=""
		   text="絶頂の余韻に震える玲の腰が大きく震え、結合部のわずかに上側から黄色い液体が漏れ出してくる。" voices=""/>
		<msg @l="301" char_id="-1" frame_id="-1" name="" text="ぷっしゃぁぁぁぁぁぁぁぁぁぁぁぁぁぁ"
		   voices=""/>
		<msg @l="303" char_id="-1" frame_id="-1" name=""
		   text="勢いよく漏れ出したそれは大黒の座る便器に収まる事無く、床の上に飛沫をあげて撒き散らされてしまう。" voices=""/>
		<msg @l="305" char_id="-1" frame_id="-1" name="大黒"
		   text="『おやおや、派手によがった上にオモラシですか‥‥。』" voices=""/>
		<msg @l="307" char_id="-1" frame_id="-1" name="大黒"
		   text="『まったく‥‥便器としての自覚が足りない証拠ですねぇ。』" voices=""/>
		<msg @l="309" char_id="-1" frame_id="-1" name="大黒"
		   text="『そうだ、いい事を思いつきましたよ。』" voices=""/>
		<msg @l="311" char_id="-1" frame_id="-1" name="大黒"
		   text="『今度同窓会のときにこの格好で行きましょう。そして憧れの目で見ていた同級生の前で今みたいに放尿しなさい。』" voices=""/>
		<msg @l="313" char_id="-1" frame_id="-1" name="大黒"
		   text="『････皆どういう顔をしますかね････楽しみですよ････ふふふっ。』" voices=""/>
		<msg @l="315" char_id="-1" frame_id="-1" name=""
		   text="大黒は楽しげに目を細めると、そう言って玲の首筋に舌を這わす。" voices=""/>
		<msg @l="316" char_id="-1" frame_id="-1" name=""
		   text="玲は‥‥大黒の言葉を聞きながらもうっとりとした表情のまま、いつまでも黄色い飛沫をほとばしらせていた。" voices=""/>
		<stopbgm @l="320" fadeout="1000"/>
		<clear @l="326" class="all"/>
		<end_scene @l="329"/>
		<eval @l="333" expr="s.flagGallery=1&#13;&#10;"/>
		<eval @l="335" expr="s.event32flag=1&#13;&#10;"/>
		<eval @l="339"
		   expr="f.bEx&#32;=&#32;s.event20flag&#32;&amp;&amp;&#32;s.event23flag&#32;&amp;&amp;&#32;s.event25flag&#32;&amp;&amp;&#32;s.event30flag&#32;&amp;&amp;&#32;s.event31flag&#32;&amp;&amp;&#32;s.event32flag&#32;&amp;&amp;&#32;s.event33flag&#32;&amp;&amp;&#32;s.event35flag&#32;&amp;&amp;&#32;s.event37flag&#32;&amp;&amp;&#32;s.event38flag&#32;&amp;&amp;&#32;s.event60flag&#13;&#10;"/>
		<goto @l="341" cond="!(f.bEx)&#13;&#10;" label="TempLabel_241"/>
		<eval @l="343" expr="s.exRootFlag=1&#13;&#10;"/>
		<label @l="344" id="TempLabel_241"/>
		<ending @l="346"/>
		<goto @l="348" cond="!(f.bEx)&#13;&#10;" label="TempLabel_242"/>
		<wait_chgmv/>
		<bg @l="352" src="newroot"/>
		<wait @l="354" time="5000"/>
		<wait_chgmv/>
		<bg @l="356" src="black"/>
		<label @l="359" id="TempLabel_242"/>
		<return @l="363" value=""/>
	</code>
</xscript>
