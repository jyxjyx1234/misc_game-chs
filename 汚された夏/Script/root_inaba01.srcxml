<?xml version="1.0" encoding="utf-8"?>
<xscript>
	<debug editor="&quot;C:\Program&#32;Files&#32;(x86)\sakura\sakura.exe&quot;&#32;&quot;%src%&quot;&#32;-Y=%line%"
	   src="D:\シロップ\町ぐるみの罠＋汚された夏セット版\汚された夏\完成データ\汚された夏\script\text\root_inaba01.txt"/>
	<code>
		<label @l="13" id="EventLabel_87"/>
		<description @l="17" text="テニスサークル入会・２日目"/>
		<eval @l="19" expr="f.numDay=8&#13;&#10;"/>
		<msgshow @l="21" show="false"/>
		<wait_chgmv/>
		<bg @l="23" src="day08" time="2000"/>
		<wait @l="25" time="500"/>
		<wait_chgmv/>
		<bg @l="27" src="black" time="2000"/>
		<msgshow @l="29" show="true"/>
		<wait_chgmv/>
		<bg @l="33" src="bg13m1"/>
		<bgm @l="37" src="bgm02" volume="1."/>
		<char @l="41" id="miho" pos="auto" src="miho050"/>
		<msg @l="43" char_id="0" frame_id="-1" name="美帆" text="『新入生歓迎のテニス大会、ですか？』"
		   voices=""/>
		<msg @l="45" char_id="-1" frame_id="-1" name="" text="月曜日の放課後。" voices=""/>
		<msg @l="46" char_id="-1" frame_id="-1" name=""
		   text="テニスサークルに顔を出した所、丁度近くを通りかかった男子部員に話を持ちかけられた。" voices=""/>
		<msg @l="48" char_id="-1" frame_id="-1" name="男子会員"
		   text="『そ、毎年恒例でね。明日やるんだよ。』" voices=""/>
		<msg @l="50" char_id="-1" frame_id="-1" name="男子会員"
		   text="『いちおう新入生の子はみんな出てもらうことになってるからそのつもりでいてよ。』" voices=""/>
		<char @l="54" id="miho" pos="auto" src="miho056"/>
		<msg @l="56" char_id="0" frame_id="-1" name="美帆"
		   text="『でも私、試合なんて出来ないと思いますよ？』" voices=""/>
		<msg @l="58" char_id="-1" frame_id="-1" name=""
		   text="ちなみに‥‥私はまだ充分にボールさえ打ち返せない。" voices=""/>
		<msg @l="60" char_id="-1" frame_id="-1" name="男子会員"
		   text="『大丈夫だって、遊びみたいなものだからさ。』" voices=""/>
		<msg @l="62" char_id="-1" frame_id="-1" name="男子会員"
		   text="『それに、テニス大会の前には昼食会とビンゴ大会があるから絶対楽しいよ。そっちがメインだって言うやつもいるくらいだし。』"
		   voices=""/>
		<char @l="66" id="miho" pos="auto" src="miho050"/>
		<msg @l="68" char_id="0" frame_id="-1" name="美帆" text="『それなら構いませんけど‥‥。』"
		   voices=""/>
		<msg @l="70" char_id="-1" frame_id="-1" name="男子会員"
		   text="『おっけ、んじゃ明日の正午にここ集合な。』" voices=""/>
		<msg @l="72" char_id="0" frame_id="-1" name="美帆" text="『わかりました。』" voices=""/>
		<msg @l="74" char_id="-1" frame_id="-1" name="男子会員" text="『そんじゃ練習、がんばってね。』"
		   voices=""/>
		<char @l="78" id="miho" pos="auto" src="miho051"/>
		<msg @l="80" char_id="0" frame_id="-1" name="美帆" text="『あ、はい‥‥ありがとうございます。』"
		   voices=""/>
		<msg @l="82" char_id="-1" frame_id="-1" name=""
		   text="そうして、男子部員は部室に向かって歩いていった。" voices=""/>
		<msg @l="83" char_id="-1" frame_id="-1" name="" text="今日はもう上がるつもりなのだろう。"
		   voices=""/>
		<char @l="87" id="miho" pos="auto" src="miho050"/>
		<msg @l="89" char_id="0" frame_id="-1" name="美帆" text="『‥‥テニス大会かぁ。』"
		   voices=""/>
		<msg @l="91" char_id="-1" frame_id="-1" name=""
		   text="私はつぶやいて、自分の握っているラケットを見る。" voices=""/>
		<msg @l="93" char_id="0" frame_id="-1" name="美帆"
		   text="(やっぱり‥‥ヘタな子より上手な子の方が印象はいいよね？)" voices=""/>
		<msg @l="95" char_id="-1" frame_id="-1" name=""
		   text="遊びみたいなものだと言われたけど、やはり試合をするからには人目につくし‥‥。" voices=""/>
		<msg @l="96" char_id="-1" frame_id="-1" name=""
		   text="そうなると、あまり格好悪いとこは見せられない‥‥‥。" voices=""/>
		<msg @l="98" char_id="0" frame_id="-1" name="美帆" text="(練習あるのみ、かな)"
		   voices=""/>
		<msg @l="100" char_id="-1" frame_id="-1" name=""
		   text="うんうんとうなずいて‥‥私は教えてもらった事を思い返しながら練習を始めた。" voices=""/>
		<clear @l="106" class="all"/>
		<wait_chgmv/>
		<bg @l="110" src="bg13m1"/>
		<msg @l="112" char_id="0" frame_id="-1" name="美帆" text="『はぁ‥‥はぁ‥‥‥。』"
		   voices=""/>
		<msg @l="114" char_id="-1" frame_id="-1" name=""
		   text="肩で息をしながら、私は手にしていたラケットの先を地面についてそれに軽く寄りかかる。" voices=""/>
		<msg @l="115" char_id="-1" frame_id="-1" name=""
		   text="三十分くらい、壁相手にラリーの練習をしていた。" voices=""/>
		<msg @l="116" char_id="-1" frame_id="-1" name=""
		   text="といってもボールを打ち返していたのは、ほんの10分かそこらで、残りは明後日の方向へ飛んでいってしまったボールを拾いにいく為に走り回っていた。"
		   voices=""/>
		<msg @l="118" char_id="0" frame_id="-1" name="美帆"
		   text="『はぁ‥‥‥全然、思った通りに飛ばないんだもんなぁ‥‥‥‥。』" voices=""/>
		<msg @l="120" char_id="-1" frame_id="-1" name=""
		   text="５メートルほど先に転がったボールをぷーっと口を膨らませて、見る。" voices=""/>
		<msg @l="121" char_id="-1" frame_id="-1" name=""
		   text="玲さんに教えて貰った通り両手でラケットを持って脇をしめながら真っ直ぐ腕を振っているつもりなのだが‥‥３球に１球位しかうまくいかない。"
		   voices=""/>
		<msg @l="123" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="125" char_id="0" frame_id="-1" name="美帆" text="『んー、ボールを変えてみようかな。』"
		   voices=""/>
		<char @l="129" id="miho" pos="auto" src="miho050"/>
		<msg @l="131" char_id="-1" frame_id="-1" name=""
		   text="ようやく息を整えた私は立ち上がると、ボールの入ったケースへと歩み寄った。" voices=""/>
		<char @l="135" id="miho" pos="auto" src="miho051"/>
		<msg @l="137" char_id="0" frame_id="-1" name="美帆" text="『というワケでキミは選手交代だよ。』"
		   voices=""/>
		<msg @l="139" char_id="-1" frame_id="-1" name=""
		   text="手にしていたボールをつんつんとつつきながら話しかけて、ケースの中に入れる。" voices=""/>
		<msg @l="140" char_id="-1" frame_id="-1" name="" text="その時‥‥。" voices=""/>
		<char @l="144" id="miho" pos="auto" src="miho050"/>
		<msg @l="146" char_id="0" frame_id="-1" name="美帆" text="『あれ、稲庭先輩だ。』"
		   voices=""/>
		<msg @l="148" char_id="-1" frame_id="-1" name=""
		   text="テニスコートの隅に、稲庭先輩の姿を見つける。" voices=""/>
		<msg @l="150" char_id="0" frame_id="-1" name="美帆" text="(そっか‥‥来てたんだ)"
		   voices=""/>
		<msg @l="152" char_id="-1" frame_id="-1" name="" text="私はしばらく稲庭先輩のことを眺める。"
		   voices=""/>
		<msg @l="153" char_id="-1" frame_id="-1" name=""
		   text="忙しそうなら声をかけるのは止めておこうと思い周りを見渡した。" voices=""/>
		<msg @l="154" char_id="-1" frame_id="-1" name=""
		   text="女の子の取り巻きの姿もない‥‥珍しく先輩の周りには誰もいなかった。" voices=""/>
		<msg @l="156" char_id="0" frame_id="-1" name="美帆" text="『先輩。』" voices=""/>
		<clear @l="159" class="char"/>
		<char @l="161" id="miho" pos="left" src="miho050"/>
		<char @l="164" id="inaba" pos="right" src="inaba050"/>
		<bgm @l="168" src="bgm07" volume="1."/>
		<msg @l="170" char_id="-1" frame_id="-1" name="稲庭" text="『やあ、今日も来てたんだね。』"
		   voices=""/>
		<msg @l="172" char_id="0" frame_id="-1" name="美帆"
		   text="『はい‥‥少しでも早く上達したいので。』" voices=""/>
		<msg @l="174" char_id="-1" frame_id="-1" name="稲庭" text="『向上心があるのはいいことだよ。』"
		   voices=""/>
		<msg @l="176" char_id="-1" frame_id="-1" name="稲庭"
		   text="『あ、そうだ‥‥‥明日の事はもう聞いたかな？』" voices=""/>
		<msg @l="178" char_id="0" frame_id="-1" name="美帆" text="『新入生歓迎のテニス大会ですか？』"
		   voices=""/>
		<msg @l="180" char_id="-1" frame_id="-1" name="稲庭" text="『そうそう。都合は大丈夫だった？』"
		   voices=""/>
		<msg @l="182" char_id="0" frame_id="-1" name="美帆"
		   text="『ええ、‥‥平日の午後って特に予定もありませんから。』" voices=""/>
		<msg @l="184" char_id="-1" frame_id="-1" name="稲庭" text="『友達と遊んだりはしないの？』"
		   voices=""/>
		<msg @l="186" char_id="0" frame_id="-1" name="美帆"
		   text="『時々お買い物に行ったりとかはしますけど、そういうのって大体土曜とか日曜なので‥‥。』" voices=""/>
		<msg @l="188" char_id="-1" frame_id="-1" name="稲庭"
		   text="『そっか。それじゃあデートに誘うなら平日の方がいいのかな？』" voices=""/>
		<char @l="192" id="miho" pos="left" src="miho054"/>
		<msg @l="194" char_id="0" frame_id="-1" name="美帆" text="『え‥‥！？』" voices=""/>
		<msg @l="196" char_id="0" frame_id="-1" name="美帆"
		   text="『で、デートに誘うって‥‥‥だ、誰が誰をですかっ！？』" voices=""/>
		<msg @l="198" char_id="-1" frame_id="-1" name="稲庭" text="『もちろん僕がキミを‥‥だけど？』"
		   voices=""/>
		<msg @l="200" char_id="0" frame_id="-1" name="美帆"
		   text="『な、なななななななっ‥‥‥何でですか？』" voices=""/>
		<msg @l="202" char_id="-1" frame_id="-1" name="稲庭"
		   text="『何でって‥‥‥僕がキミとデートしたいから、だけど？』" voices=""/>
		<msg @l="204" char_id="0" frame_id="-1" name="美帆"
		   text="『か、からかわないでください‥‥‥私なんかとデートしたって何にも楽しい事なんかないですよっ！？』" voices=""/>
		<msg @l="206" char_id="-1" frame_id="-1" name="稲庭"
		   text="『楽しいか楽しくないかは、実際にデートしてみないとわからないだろ。』" voices=""/>
		<char @l="210" id="miho" pos="left" src="miho053"/>
		<msg @l="212" char_id="0" frame_id="-1" name="美帆" text="『そ、それはそうですけど‥‥‥。』"
		   voices=""/>
		<msg @l="214" char_id="-1" frame_id="-1" name="稲庭"
		   text="『もしかして‥‥僕とデートするのはイヤかい？』" voices=""/>
		<msg @l="216" char_id="0" frame_id="-1" name="美帆"
		   text="『い、イヤなんかじゃないです‥‥‥でも。』" voices=""/>
		<msg @l="218" char_id="-1" frame_id="-1" name="稲庭" text="『でも？』" voices=""/>
		<char @l="222" id="miho" pos="left" src="miho050"/>
		<msg @l="224" char_id="0" frame_id="-1" name="美帆" text="『玲さんに‥‥‥悪いですから。』"
		   voices=""/>
		<msg @l="226" char_id="-1" frame_id="-1" name="稲庭"
		   text="『ああ、そうか‥‥キミは白石くんとルームメイトだったね。』" voices=""/>
		<msg @l="228" char_id="-1" frame_id="-1" name="稲庭"
		   text="『ということは、僕達の関係もある程度聞いていたりするのかな？』" voices=""/>
		<msg @l="230" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="232" char_id="-1" frame_id="-1" name="" text="私はそれに無言で頷く。"
		   voices=""/>
		<msg @l="233" char_id="-1" frame_id="-1" name="" text="自分の気持ちには気付いていた。"
		   voices=""/>
		<msg @l="234" char_id="-1" frame_id="-1" name=""
		   text="私は‥‥確かに稲庭先輩に惹かれはじめている。" voices=""/>
		<msg @l="235" char_id="-1" frame_id="-1" name=""
		   text="しかし、同時に、玲さんの気持ちを知っているのに、それを裏切っている事のようにも思える。" voices=""/>
		<msg @l="237" char_id="-1" frame_id="-1" name="稲庭"
		   text="『なるほど、それじゃあＹＥＳとは言えないか。』" voices=""/>
		<msg @l="239" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="241" char_id="-1" frame_id="-1" name="稲庭"
		   text="『それなら、デートの代わりに一緒に練習するっていうのはどう？』" voices=""/>
		<char @l="245" id="miho" pos="left" src="miho054"/>
		<msg @l="247" char_id="0" frame_id="-1" name="美帆" text="『え？』" voices=""/>
		<msg @l="249" char_id="-1" frame_id="-1" name="稲庭"
		   text="『一緒に練習するくらいなら、別に構わないだろう？』" voices=""/>
		<msg @l="251" char_id="0" frame_id="-1" name="美帆" text="『それは‥‥。』" voices=""/>
		<msg @l="255" async="true" char_id="-1" frame_id="-1" name=""
		   text="稲庭先輩と一緒に練習する‥‥？" voices=""/>
		<select @l="256">
			<menu @l="260" label="EventLabel_88" text="お願いする"/>
			<menu @l="263" label="EventLabel_89" text="断っておく"/>
		</select>
		<label @l="271" id="EventLabel_88"/>
		<char @l="275" id="miho" pos="left" src="miho053"/>
		<msg @l="277" char_id="0" frame_id="-1" name="美帆"
		   text="『あ、えっと‥‥‥先輩さえよろしければ。』" voices=""/>
		<msg @l="279" char_id="-1" frame_id="-1" name="稲庭" text="『僕はいつでもＯＫだよ。』"
		   voices=""/>
		<msg @l="281" char_id="0" frame_id="-1" name="美帆" text="『あの‥‥それじゃあ、お願いします。』"
		   voices=""/>
		<msg @l="283" char_id="-1" frame_id="-1" name="稲庭" text="『こちらこそ、よろしく。』"
		   voices=""/>
		<clear @l="289" class="all"/>
		<wait_chgmv/>
		<bg @l="293" src="bg13m2"/>
		<char @l="297" id="miho" pos="left" src="miho050"/>
		<msg @l="299" char_id="0" frame_id="-1" name="美帆" text="『こう‥‥やって、こうですか？』"
		   voices=""/>
		<char @l="305" id="inaba" pos="right" src="inaba050"/>
		<msg @l="307" char_id="-1" frame_id="-1" name="稲庭"
		   text="『そうそう、なるべく無駄な力は入れないようにして。』" voices=""/>
		<msg @l="309" char_id="0" frame_id="-1" name="美帆" text="『わ、わかりました。』"
		   voices=""/>
		<msg @l="311" char_id="-1" frame_id="-1" name=""
		   text="テニスコートの片隅で、私は稲庭先輩の付き添いの元でラケットを振る練習をしていた。" voices=""/>
		<msg @l="312" char_id="-1" frame_id="-1" name=""
		   text="稲庭先輩の出す指示はどれも的確で‥‥昨日、今日と幾ら練習しても中々ボールを真っ直ぐ飛ばせなかったのに一時間ほどで凄く上達した。"
		   voices=""/>
		<msg @l="314" char_id="-1" frame_id="-1" name="稲庭"
		   text="『基本的にボールを前に打ち返すためには、ラケットの真芯で捉えるのが一番いいんだ。』" voices=""/>
		<msg @l="316" char_id="-1" frame_id="-1" name="稲庭"
		   text="『特に力のない子はハンディキャップがあるから、より正確にラケットの芯を使わないとゲームで差が出ちゃうよ。』" voices=""/>
		<msg @l="318" char_id="0" frame_id="-1" name="美帆" text="『ふむふむ‥なるほど‥‥。』"
		   voices=""/>
		<msg @l="320" char_id="-1" frame_id="-1" name="稲庭"
		   text="『そして、ラケットの真芯でボールを捉えるにはボールが来た位置に対する身体の置き方が大切なんだよ。』" voices=""/>
		<msg @l="322" char_id="0" frame_id="-1" name="美帆" text="『ふむふむ。』" voices=""/>
		<msg @l="324" char_id="-1" frame_id="-1" name="稲庭"
		   text="『両手でラケットを握る場合は、余り左右を大きくカバーできないから、なるべくボールを正面に持ってくることが重要だね。』"
		   voices=""/>
		<msg @l="326" char_id="0" frame_id="-1" name="美帆" text="『ボールを正面に持ってくる‥‥。』"
		   voices=""/>
		<msg @l="328" char_id="-1" frame_id="-1" name="稲庭"
		   text="『そう、だから相手が打ったボールを素早く追いかけることが大事。』" voices=""/>
		<msg @l="330" char_id="-1" frame_id="-1" name="稲庭"
		   text="『試しに僕が向こうからボールを投げるから、打ってみて。』" voices=""/>
		<char @l="334" id="miho" pos="left" src="miho051"/>
		<msg @l="336" char_id="0" frame_id="-1" name="美帆" text="『はい！』" voices=""/>
		<msg @l="338" char_id="-1" frame_id="-1" name="稲庭" text="『がんばってね。』"
		   voices=""/>
		<clear @l="344" class="all"/>
		<wait_chgmv/>
		<bg @l="348" src="bg13a"/>
		<se @l="352" buf="1" src="テニスボール打つ音" volume="1."/>
		<msg @l="354" char_id="-1" frame_id="-1" name=""
		   text="ボールがラケットに当たった瞬間から、もう手応えが違った。" voices=""/>
		<msg @l="355" char_id="-1" frame_id="-1" name=""
		   text="それまではとても重く感じていたテニスボールが、その瞬間だけはまるで重さを感じる事無く、私は軽くラケットを振り抜いていた。"
		   voices=""/>
		<msg @l="356" char_id="-1" frame_id="-1" name=""
		   text="私の打ち返したボールは、稲庭先輩のいる方へと綺麗に返る。" voices=""/>
		<char @l="360" id="miho" pos="auto" src="miho051"/>
		<msg @l="362" char_id="0" frame_id="-1" name="美帆" text="『先輩、今の見ましたっ！？』"
		   voices=""/>
		<msg @l="364" char_id="-1" frame_id="-1" name=""
		   text="私は微かに息を荒げながら、嬉しさのあまり先輩へと駆け寄っていく。" voices=""/>
		<clear @l="367" class="char"/>
		<char @l="369" id="miho" pos="left" src="miho051"/>
		<char @l="372" id="inaba" pos="right" src="inaba050"/>
		<msg @l="374" char_id="-1" frame_id="-1" name="稲庭" text="『うん、今のはバッチリだったね。』"
		   voices=""/>
		<msg @l="376" char_id="-1" frame_id="-1" name="稲庭"
		   text="『手応え‥‥全然違ったんじゃないかな？』" voices=""/>
		<char @l="380" id="miho" pos="left" src="miho054"/>
		<msg @l="382" char_id="0" frame_id="-1" name="美帆"
		   text="『はい！&#32;ものすごくボールが軽いんです！』" voices=""/>
		<msg @l="384" char_id="-1" frame_id="-1" name="稲庭"
		   text="『それが真芯で捉えてるってことだよ。』" voices=""/>
		<msg @l="386" char_id="0" frame_id="-1" name="美帆" text="『今のが真芯‥‥。』"
		   voices=""/>
		<msg @l="388" char_id="-1" frame_id="-1" name="稲庭"
		   text="『これはテニスでも野球でもゴルフでも同じなんだけど、芯の部分が一番の力点なんだ。』" voices=""/>
		<msg @l="390" char_id="-1" frame_id="-1" name="稲庭"
		   text="『だから、真芯で捉えると余計な力を入れなくてもきちんと遠心力が加わってボールを飛ばしたり押し返したり出来るんだ。』"
		   voices=""/>
		<char @l="394" id="miho" pos="left" src="miho051"/>
		<msg @l="396" char_id="0" frame_id="-1" name="美帆" text="『先輩、教え方上手ですねっ。』"
		   voices=""/>
		<msg @l="398" char_id="-1" frame_id="-1" name="稲庭"
		   text="『フフ、ありがとう。それじゃあ、今の感じを覚えておいて。』" voices=""/>
		<msg @l="400" char_id="-1" frame_id="-1" name="稲庭"
		   text="『ボールを正面に捉えて真芯で打つ‥‥これが基本だからね。』" voices=""/>
		<msg @l="402" char_id="0" frame_id="-1" name="美帆" text="『はいっ！』" voices=""/>
		<msg @l="404" char_id="-1" frame_id="-1" name="稲庭"
		   text="『‥‥っと、もうそろそろ暗くなってきちゃったね。』" voices=""/>
		<char @l="408" id="miho" pos="left" src="miho050"/>
		<msg @l="410" char_id="0" frame_id="-1" name="美帆" text="『そういえば‥‥‥。』"
		   voices=""/>
		<msg @l="412" char_id="-1" frame_id="-1" name=""
		   text="先輩に言われてテニスコートを見渡すと、辺りは太陽が沈みかけ薄暗くなっていた。練習にあまりに熱中していたせいか、時間の経過にまったく気付いてはいなかった。"
		   voices=""/>
		<msg @l="414" char_id="-1" frame_id="-1" name="稲庭" text="『今日はここまでにしておこうか。』"
		   voices=""/>
		<char @l="418" id="miho" pos="left" src="miho054"/>
		<msg @l="420" char_id="0" frame_id="-1" name="美帆"
		   text="『え、でも‥‥せっかくコツを掴んだばっかりなのに‥‥‥。』" voices=""/>
		<msg @l="422" char_id="-1" frame_id="-1" name="稲庭"
		   text="『無理はよくないよ。それに明日は新歓があるんだから余計に疲れは取っておかないと。』" voices=""/>
		<char @l="426" id="miho" pos="left" src="miho050"/>
		<msg @l="428" char_id="0" frame_id="-1" name="美帆" text="『そう‥‥ですね。』"
		   voices=""/>
		<msg @l="430" char_id="0" frame_id="-1" name="美帆"
		   text="『わかりました、今日はここまでにして帰ります。』" voices=""/>
		<msg @l="432" char_id="-1" frame_id="-1" name="稲庭"
		   text="『もう、結構な時間だな‥‥よければ停留所まで送っていこうか？』" voices=""/>
		<char @l="436" id="miho" pos="left" src="miho053"/>
		<msg @l="438" char_id="0" frame_id="-1" name="美帆" text="『え、えっと‥‥いいんですか？』"
		   voices=""/>
		<msg @l="440" char_id="-1" frame_id="-1" name="稲庭" text="『もちろん僕は構わないよ。』"
		   voices=""/>
		<msg @l="442" char_id="-1" frame_id="-1" name="稲庭"
		   text="『幾ら大学構内といっても、この時間の一人歩きは危ないからね。』" voices=""/>
		<msg @l="444" char_id="0" frame_id="-1" name="美帆" text="『じゃ、じゃあ‥‥‥お願いします。』"
		   voices=""/>
		<msg @l="446" char_id="-1" frame_id="-1" name="稲庭"
		   text="『わかった。それなら着替え終わったらクラブ棟の前で。』" voices=""/>
		<msg @l="448" char_id="0" frame_id="-1" name="美帆" text="『は、はいっ！』" voices=""/>
		<stopbgm @l="452" fadeout="1000"/>
		<clear @l="458" class="all"/>
		<wait_chgmv/>
		<bg @l="462" src="bg14a"/>
		<bgm @l="466" src="bgm02" volume="1."/>
		<char @l="470" id="miho" pos="auto" src="miho053"/>
		<msg @l="472" char_id="0" frame_id="-1" name="美帆" text="『きゃーーーーーーーーーっ！！』"
		   voices=""/>
		<msg @l="474" char_id="0" frame_id="-1" name="美帆"
		   text="『どうしよう、どうしよう、どうしようっ！！』" voices=""/>
		<msg @l="476" char_id="-1" frame_id="-1" name=""
		   text="部室に戻ってきて後ろ手に扉を閉めた瞬間、私は顔を真っ赤に染めながら少し控え目に‥‥悲鳴をあげる。" voices=""/>
		<msg @l="478" char_id="0" frame_id="-1" name="美帆"
		   text="『なんかすごくいい感じだったよね‥‥だったよね？』" voices=""/>
		<msg @l="480" char_id="-1" frame_id="-1" name="" text="もちろん、部室の中には誰もいない。"
		   voices=""/>
		<msg @l="481" char_id="-1" frame_id="-1" name=""
		   text="というか他に誰か居たら‥‥きっと恥ずかしくて言えないだろう。" voices=""/>
		<msg @l="483" char_id="0" frame_id="-1" name="美帆"
		   text="『結果的にデートは断っちゃったけど‥‥逆に良かったかな。』" voices=""/>
		<msg @l="485" char_id="0" frame_id="-1" name="美帆"
		   text="『先輩とデートなんかしたら、きっと舞い上がって変な失敗ばっかりしちゃうだろうし‥‥。』" voices=""/>
		<msg @l="487" char_id="-1" frame_id="-1" name=""
		   text="そう言いながら‥‥ふと自分の中で玲さんへの遠慮が徐々に薄れていっていることに気が付いた。" voices=""/>
		<char @l="491" id="miho" pos="auto" src="miho050"/>
		<msg @l="493" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="495" char_id="0" frame_id="-1" name="美帆"
		   text="『私‥‥何、勝手に浮かれちゃってるんだろ。』" voices=""/>
		<msg @l="497" char_id="0" frame_id="-1" name="美帆"
		   text="『こんな、抜け駆けみたいなことして‥‥‥。』" voices=""/>
		<msg @l="499" char_id="-1" frame_id="-1" name="" text="けれど‥‥今は状況が違う。"
		   voices=""/>
		<msg @l="500" char_id="-1" frame_id="-1" name=""
		   text="私は、自分の気持ちに‥‥何となくではあるけれど気が付いた。" voices=""/>
		<msg @l="501" char_id="-1" frame_id="-1" name="" text="ならば問題はその先‥‥。"
		   voices=""/>
		<msg @l="502" char_id="-1" frame_id="-1" name="" text="私が、稲庭先輩に対してどう接するか‥‥。"
		   voices=""/>
		<msg @l="504" char_id="0" frame_id="-1" name="美帆"
		   text="『玲さんは私に自分の気持ちを教えてくれた‥‥。』" voices=""/>
		<msg @l="506" char_id="0" frame_id="-1" name="美帆"
		   text="『それなのに私がこんな風に何も言わずに先輩と仲良くしてるのって、やっぱりフェアじゃないよね‥‥‥。』" voices=""/>
		<msg @l="508" char_id="-1" frame_id="-1" name=""
		   text="小さくうなずいて‥‥荷物の入ったロッカーへと手を伸ばす。" voices=""/>
		<msg @l="509" char_id="-1" frame_id="-1" name=""
		   text="でも私が稲庭先輩を好きです、と言えば‥‥それはつまり、玲さんとライバルになってしまう。" voices=""/>
		<msg @l="510" char_id="-1" frame_id="0" name=""
		   text="「でも‥‥たとえアナタがライバルでも、私は負けないわよ」" voices=""/>
		<msg @l="511" char_id="-1" frame_id="-1" name="" text="不意に玲さんの言葉が脳裏を過ぎていった。"
		   voices=""/>
		<char @l="516" id="miho" pos="auto" src="miho055"/>
		<msg @l="518" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="520" char_id="-1" frame_id="-1" name=""
		   text="私はロッカーの中からカバンを手繰り寄せ‥‥‥胸にぎゅっと抱き寄せた。" voices=""/>
		<stopbgm @l="524" fadeout="1000"/>
		<clear @l="530" class="all"/>
		<wait_chgmv/>
		<bg @l="534" src="bg07b"/>
		<bgm @l="538" src="bgm07" volume="1."/>
		<char @l="542" id="miho" pos="auto" src="miho110"/>
		<msg @l="544" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="546" char_id="-1" frame_id="-1" name=""
		   text="クラブ棟の前についた頃にはすっかり暗くなってしまっていた。" voices=""/>
		<msg @l="547" char_id="-1" frame_id="-1" name=""
		   text="入り口近くの電灯に目をやると、その灯りの下に稲庭先輩の姿がある。" voices=""/>
		<msg @l="549" char_id="0" frame_id="-1" name="美帆" text="『お待たせしました。』"
		   voices=""/>
		<clear @l="552" class="char"/>
		<char @l="554" id="miho" pos="left" src="miho110"/>
		<char @l="557" id="inaba" pos="right" src="inaba010"/>
		<msg @l="559" char_id="-1" frame_id="-1" name="稲庭"
		   text="『大丈夫、全然待ってなんかいないよ。』" voices=""/>
		<msg @l="561" char_id="0" frame_id="-1" name="美帆" text="『そうですか‥‥良かったです。』"
		   voices=""/>
		<msg @l="563" char_id="-1" frame_id="-1" name="稲庭"
		   text="『ん？&#32;少し元気がないんじゃないかな？』" voices=""/>
		<char @l="568" id="miho" pos="left" src="miho113"/>
		<msg @l="570" char_id="0" frame_id="-1" name="美帆" text="『そんなこと‥‥ないですよ。』"
		   voices=""/>
		<msg @l="572" char_id="-1" frame_id="-1" name="稲庭"
		   text="『ちょっと疲れたのかもしれないね。今日はゆっくり休むといい。』" voices=""/>
		<msg @l="574" char_id="0" frame_id="-1" name="美帆"
		   text="『なんか私、同じこと言われてますね‥‥。』" voices=""/>
		<msg @l="576" char_id="-1" frame_id="-1" name="稲庭" text="『最初はみんなそんなものだよ。』"
		   voices=""/>
		<msg @l="578" char_id="-1" frame_id="-1" name="稲庭"
		   text="『自分の身体と相談しながら、ゆっくり楽しめばいいんだから。』" voices=""/>
		<char @l="582" id="miho" pos="left" src="miho010"/>
		<msg @l="584" char_id="0" frame_id="-1" name="美帆" text="『そうですね。』" voices=""/>
		<clear @l="590" class="all"/>
		<wait_chgmv/>
		<bg @l="594" src="bg07b"/>
		<char @l="598" id="miho" pos="left" src="miho010"/>
		<char @l="602" id="inaba" pos="right" src="inaba010"/>
		<msg @l="604" char_id="-1" frame_id="-1" name="" text="稲庭先輩と二人でキャンパスを歩く。"
		   voices=""/>
		<msg @l="605" char_id="-1" frame_id="-1" name=""
		   text="ほんの数日前までは想像も出来なかった状況だった。" voices=""/>
		<msg @l="607" char_id="-1" frame_id="-1" name="稲庭" text="『どう、少しはこの町に慣れた？』"
		   voices=""/>
		<msg @l="609" char_id="0" frame_id="-1" name="美帆"
		   text="『あ、はい‥‥何とか慣れてきたと思います。』" voices=""/>
		<msg @l="611" char_id="-1" frame_id="-1" name="稲庭" text="『それはよかった。』"
		   voices=""/>
		<msg @l="613" char_id="-1" frame_id="-1" name="稲庭"
		   text="『この町はかなり特殊な場所にあるから、合わない人は大変な思いをしているみたいなんだよ。』" voices=""/>
		<char @l="617" id="miho" pos="left" src="miho114"/>
		<msg @l="619" char_id="0" frame_id="-1" name="美帆" text="『大変‥‥ですか？』"
		   voices=""/>
		<msg @l="621" char_id="-1" frame_id="-1" name="稲庭"
		   text="『ほら、この町には基本的に娯楽が少ないだろ？』" voices=""/>
		<msg @l="623" char_id="-1" frame_id="-1" name="稲庭"
		   text="『ゲームセンターもカラオケも数があまり無いし、マイナーなＣＤや本なんか通販を使わないと手に入り難いからね。』" voices=""/>
		<char @l="627" id="miho" pos="left" src="miho011"/>
		<msg @l="629" char_id="0" frame_id="-1" name="美帆"
		   text="『そうですね‥‥隣町は遠いのでちょっと買いに行くって事ができませんよね。』" voices=""/>
		<msg @l="631" char_id="0" frame_id="-1" name="美帆"
		   text="『でも、私は困ってないので大丈夫です。』" voices=""/>
		<msg @l="633" char_id="-1" frame_id="-1" name="稲庭"
		   text="『そう？それなら、構わないんだけどね。』" voices=""/>
		<msg @l="635" char_id="-1" frame_id="-1" name="稲庭" text="『僕はこの町が好きだからね。』"
		   voices=""/>
		<char @l="640" id="miho" pos="left" src="miho010"/>
		<msg @l="642" char_id="0" frame_id="-1" name="美帆"
		   text="『この町が好きって、何か良い思い出でもあるんですか？』" voices=""/>
		<msg @l="644" char_id="-1" frame_id="-1" name="稲庭"
		   text="『ああ‥‥僕は生まれつき身体が弱くてね、日常生活を送るにも支障を来たすほどだったんだ。』" voices=""/>
		<msg @l="646" char_id="-1" frame_id="-1" name="稲庭"
		   text="『それがこの町に来てから‥‥‥快復したんだよ。』" voices=""/>
		<char @l="650" id="miho" pos="left" src="miho014"/>
		<msg @l="652" char_id="0" frame_id="-1" name="美帆"
		   text="『へえ‥‥身体が弱かったなんて、今の先輩からじゃ想像もつきませんね。』" voices=""/>
		<msg @l="654" char_id="-1" frame_id="-1" name="稲庭"
		   text="『医者には奇跡と言われた。僕も‥‥そう思ってる。』" voices=""/>
		<msg @l="656" char_id="-1" frame_id="-1" name="稲庭"
		   text="『それで‥‥運動できなかった子供の頃を少しでも取り戻せるようにと僕はテニスを始めたんだ。』" voices=""/>
		<char @l="660" id="miho" pos="left" src="miho110"/>
		<msg @l="662" char_id="0" frame_id="-1" name="美帆" text="『そう、だったんですか‥‥。』"
		   voices=""/>
		<clear @l="670" class="all"/>
		<wait_chgmv/>
		<bg @l="674" src="bg07b"/>
		<char @l="678" id="miho" pos="left" src="miho010"/>
		<char @l="682" id="inaba" pos="right" src="inaba010"/>
		<msg @l="684" char_id="-1" frame_id="-1" name="稲庭" text="『さて、僕はここまでかな。』"
		   voices=""/>
		<msg @l="686" char_id="-1" frame_id="-1" name=""
		   text="校門のすぐ近くまで到着し、稲庭先輩が立ち止まる。" voices=""/>
		<msg @l="688" char_id="0" frame_id="-1" name="美帆" text="『えっと‥‥‥先輩は？』"
		   voices=""/>
		<msg @l="690" char_id="-1" frame_id="-1" name="稲庭"
		   text="『僕は車だからね、駐車場に行かないと。』" voices=""/>
		<char @l="694" id="miho" pos="left" src="miho014"/>
		<msg @l="696" char_id="0" frame_id="-1" name="美帆"
		   text="『えっ‥‥駐車場って、通り過ぎてるじゃないですか！』" voices=""/>
		<msg @l="698" char_id="-1" frame_id="-1" name="稲庭"
		   text="『あはは、このくらいどうってこと無いよ。』" voices=""/>
		<msg @l="700" char_id="-1" frame_id="-1" name="稲庭"
		   text="『僕は男だからね、女性をエスコートするのは当然さ。』" voices=""/>
		<char @l="704" id="miho" pos="left" src="miho116"/>
		<msg @l="706" char_id="0" frame_id="-1" name="美帆"
		   text="『すみません‥‥ご迷惑ばかりおかけしてしまって‥‥‥‥。』" voices=""/>
		<msg @l="708" char_id="-1" frame_id="-1" name="稲庭"
		   text="『元はといえば僕が無理に練習に誘ったんだ、気にしないでいいよ。』" voices=""/>
		<msg @l="710" char_id="0" frame_id="-1" name="美帆" text="『でも‥‥。』" voices=""/>
		<msg @l="712" char_id="-1" frame_id="-1" name="稲庭" text="『いいからいいから。』"
		   voices=""/>
		<msg @l="714" char_id="-1" frame_id="-1" name="稲庭"
		   text="『それじゃ、明日の新歓テニス大会‥‥‥楽しみにしているよ。』" voices=""/>
		<char @l="718" id="miho" pos="left" src="miho011"/>
		<msg @l="720" char_id="0" frame_id="-1" name="美帆" text="『はい！頑張ります！！』"
		   voices=""/>
		<clear @l="724" layer="inaba"/>
		<msg @l="726" char_id="-1" frame_id="-1" name=""
		   text="私の返事に先輩は微笑むと、踵を返して駐車場に向かって歩いていった。" voices=""/>
		<char @l="730" id="miho" pos="left" src="miho011"/>
		<msg @l="732" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<char @l="736" id="miho" pos="left" src="miho110"/>
		<msg @l="738" char_id="0" frame_id="-1" name="美帆"
		   text="『稲庭先輩も‥‥色々あったんだなぁ‥‥。』" voices=""/>
		<msg @l="740" char_id="-1" frame_id="-1" name=""
		   text="立ち去る先輩の背中がみえなくなるまで見送った後、私はぼそりとつぶやいた。" voices=""/>
		<clear @l="745" class="all"/>
		<wait_chgmv/>
		<bg @l="749" src="bg03b"/>
		<bgm @l="752" src="bgm05" volume="1."/>
		<char @l="755" id="miho" pos="auto" src="miho030"/>
		<description @l="758" text="舞い戻った日常"/>
		<eval @l="760" expr="f.numDay=3&#13;&#10;"/>
		<msg @l="763" char_id="-1" frame_id="-1" name=""
		   text="玲さんお手製のスープスパを食べ終え、私は空になった二人分のお皿をキッチンの流しへ重ねて置く。" voices=""/>
		<char @l="766" id="rei" pos="auto" src="rei030"/>
		<msg @l="768" char_id="1" frame_id="-1" name="玲" text="『美帆、少し私とお話しない？』"
		   voices=""/>
		<char @l="771" id="miho" pos="auto" src="miho134"/>
		<msg @l="773" char_id="0" frame_id="-1" name="美帆" text="『は、はい、いいですけど。』"
		   voices=""/>
		<msg @l="775" char_id="-1" frame_id="-1" name=""
		   text="玲さんが珍しくまじめな顔で話かけてきたので、片付けもそこそこに私は玲さんの向かいのソファに腰掛ける。" voices=""/>
		<clear @l="777" class="char"/>
		<clear @l="783" class="all"/>
		<msgshow @l="785" show="true"/>
		<msg @l="787" char_id="-1" frame_id="-1" name=""
		   text="････････････････････････。" voices=""/>
		<msg @l="788" char_id="-1" frame_id="-1" name="" text="････････････････。"
		   voices=""/>
		<msg @l="789" char_id="-1" frame_id="-1" name="" text="････････。" voices=""/>
		<wait_chgmv/>
		<bg @l="792" src="bg03b"/>
		<char @l="794" id="rei" pos="left" src="rei030"/>
		<char @l="796" id="miho" pos="right" src="miho130"/>
		<msg @l="799" char_id="1" frame_id="-1" name="玲" text="『そっか‥‥美帆も稲庭さん目当て、か。』"
		   voices=""/>
		<char @l="802" id="miho" pos="right" src="miho035"/>
		<msg @l="804" char_id="0" frame_id="-1" name="美帆" text="『ご、ごめんなさい‥‥。』"
		   voices=""/>
		<char @l="807" id="rei" pos="left" src="rei031"/>
		<msg @l="809" char_id="1" frame_id="-1" name="玲" text="『謝らなくてもいいわよ。』"
		   voices=""/>
		<msg @l="811" char_id="1" frame_id="-1" name="玲" text="『端から見ればバレバレなんだから。』"
		   voices=""/>
		<char @l="814" id="miho" pos="right" src="miho133"/>
		<msg @l="816" char_id="0" frame_id="-1" name="美帆" text="『そ、それは‥‥。』"
		   voices=""/>
		<char @l="819" id="rei" pos="left" src="rei033"/>
		<msg @l="821" char_id="1" frame_id="-1" name="玲"
		   text="『それに私は‥‥例え稲庭さんが誰かを好きになったとしても‥‥私の彼に対する想いが揺らぐことはないもの。』" voices=""/>
		<char @l="824" id="rei" pos="left" src="rei031"/>
		<msg @l="826" char_id="1" frame_id="-1" name="玲"
		   text="『だから、アナタも遠慮なんてしないでいいわよ。』" voices=""/>
		<char @l="829" id="miho" pos="right" src="miho136"/>
		<msg @l="831" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="833" char_id="-1" frame_id="-1" name=""
		   text="玲さんはさらりと言って見せているが、それは本心なのだろうか？" voices=""/>
		<msg @l="834" char_id="-1" frame_id="0" name="" text="「遠慮なんてしないでいい。」"
		   voices=""/>
		<msg @l="835" char_id="-1" frame_id="-1" name=""
		   text="自分の愛する人に言い寄る女に対して、そんな寛大な態度が取れるものなのだろうか？" voices=""/>
		<msg @l="837" char_id="-1" frame_id="-1" name=""
		   text="自分の想いは叶わなくても‥‥それでも誰かを愛し続けていられる‥‥。" voices=""/>
		<msg @l="839" char_id="-1" frame_id="-1" name=""
		   text="私に‥そんな事が可能だろうか？と自問してしまう。" voices=""/>
		<msg @l="841" char_id="-1" frame_id="-1" name=""
		   text="もちろん、いつかはそれほどまでに愛する人が私にも出てくるのかもしれない。" voices=""/>
		<msg @l="842" char_id="-1" frame_id="-1" name="" text="でも、今はそんな人は思い浮かばなかった。"
		   voices=""/>
		<msg @l="844" char_id="-1" frame_id="-1" name=""
		   text="稲庭先輩に対する気持ちは‥‥愛というよりは憧れ‥‥という方が正しい表現だと思う。" voices=""/>
		<char @l="847" id="miho" pos="right" src="miho133"/>
		<msg @l="849" char_id="0" frame_id="-1" name="美帆" text="『なんで‥‥そんな事を言うんですか。』"
		   voices=""/>
		<char @l="852" id="rei" pos="left" src="rei030"/>
		<msg @l="854" char_id="1" frame_id="-1" name="玲" text="『妹だから‥‥かしらね。』"
		   voices=""/>
		<char @l="857" id="miho" pos="right" src="miho034"/>
		<msg @l="859" char_id="0" frame_id="-1" name="美帆" text="『えっ？』" voices=""/>
		<msg @l="861" char_id="1" frame_id="-1" name="玲"
		   text="『私には子供の頃、死産で生まれてこなかった妹がいたの。何の根拠も無いけど、美帆と一緒にいると妹の生まれ変わりみたいに思えてきてね‥‥嫌だったかしらこんな話。』"
		   voices=""/>
		<char @l="864" id="miho" pos="right" src="miho136"/>
		<msg @l="866" char_id="0" frame_id="-1" name="美帆" text="『いえ、そんな事。』"
		   voices=""/>
		<char @l="869" id="rei" pos="left" src="rei031"/>
		<msg @l="871" char_id="1" frame_id="-1" name="玲"
		   text="『それでね、妹には幸せになってほしい、好きな相手とは上手くいってほしいって思うの‥‥それが自分の好きな人だとしてもね。』"
		   voices=""/>
		<char @l="874" id="miho" pos="right" src="miho134"/>
		<msg @l="876" char_id="0" frame_id="-1" name="美帆" text="『わ、わたしもっ！』"
		   voices=""/>
		<char @l="879" id="rei" pos="left" src="rei034"/>
		<msg @l="881" char_id="1" frame_id="-1" name="玲" text="『え？』" voices=""/>
		<char @l="884" id="miho" pos="right" src="miho133"/>
		<msg @l="886" char_id="0" frame_id="-1" name="美帆"
		   text="『私も玲さんの事、本当のお姉さんのように思ってます。はじめてぶつかってからこの部屋でまた会って、こんなきれいな人と一緒の部屋に住めるなんてって思って、毎日他愛の無い話をしてそれが楽しくて‥‥だからっ。』"
		   voices=""/>
		<msg @l="888" char_id="0" frame_id="-1" name="美帆" text="『だから私も玲さんにっ‥‥。』"
		   voices=""/>
		<clear @l="891" layer="rei"/>
		<char @l="893" id="rei" pos="auto" src="rei031"/>
		<msg @l="895" char_id="1" frame_id="-1" name="玲" text="『美帆。』" voices=""/>
		<char @l="898" id="miho" pos="right" src="miho034"/>
		<msg @l="900" char_id="0" frame_id="-1" name="美帆" text="『えっ？』" voices=""/>
		<flash @l="903" count="4" fade="100" image="white"/>
		<msg @l="905" char_id="-1" frame_id="-1" name="" text="ビシッ！" voices=""/>
		<msg @l="907" char_id="0" frame_id="-1" name="美帆" text="『あいたっ！』" voices=""/>
		<msg @l="909" char_id="-1" frame_id="-1" name=""
		   text="玲さんの顔が突然アップで迫ってきたかと思うと、いきなりデコピンが飛んできた。" voices=""/>
		<char @l="912" id="miho" pos="right" src="miho035"/>
		<msg @l="914" char_id="0" frame_id="-1" name="美帆" text="『な、なにするんです玲さん。』"
		   voices=""/>
		<char @l="917" id="rei" pos="auto" src="rei030"/>
		<msg @l="919" char_id="1" frame_id="-1" name="玲"
		   text="『ライバルは私だけじゃないわよ、お互いに気を使ってる間にどこの馬の骨ともわからないような女に稲庭さんをさらわれたらどうするの？』"
		   voices=""/>
		<msg @l="921" char_id="0" frame_id="-1" name="美帆" text="『そ、それは‥‥。』"
		   voices=""/>
		<clear @l="924" class="char"/>
		<char @l="926" id="rei" pos="left" src="rei031"/>
		<msg @l="928" char_id="1" frame_id="-1" name="玲"
		   text="『私がダメでもあなたなら納得出来るわ、美帆。だからあなたも私に遠慮なんかしなくてもいいのよ。』" voices=""/>
		<char @l="931" id="rei" pos="left" src="rei033"/>
		<msg @l="933" char_id="1" frame_id="-1" name="玲"
		   text="『お互いにがんばりましょう、お姉ちゃんからのお願い。』" voices=""/>
		<clear @l="936" layer="rei"/>
		<msg @l="938" char_id="-1" frame_id="-1" name=""
		   text="そう微笑みながら言うと玲さんはサッと立ち上がり、自分の部屋に戻っていった。" voices=""/>
		<clear @l="941" class="char"/>
		<char @l="943" id="miho" pos="auto" src="miho033"/>
		<msg @l="945" char_id="0" frame_id="1" name="美帆" text="（玲さん、信じてもいいんですよね。）"
		   voices=""/>
		<eval @l="951" expr="f.稲庭コーチflag&#32;=&#32;1&#13;&#10;"/>
		<goto @l="954" label="EventLabel_90"/>
		<label @l="958" id="EventLabel_89"/>
		<char @l="962" id="miho" pos="left" src="miho056"/>
		<msg @l="964" char_id="0" frame_id="1" name="美帆"
		   text="『す、すみません‥‥‥やっぱり先輩に悪いので。』" voices=""/>
		<msg @l="966" char_id="-1" frame_id="-1" name="稲庭" text="『そうか‥‥‥残念だな。』"
		   voices=""/>
		<msg @l="968" char_id="0" frame_id="1" name="美帆" text="『すみません‥‥。』" voices=""/>
		<msg @l="970" char_id="-1" frame_id="-1" name="稲庭"
		   text="『いや、いいんだ‥‥それじゃあ何かあったら声を掛けてよ。』" voices=""/>
		<char @l="974" id="miho" pos="left" src="miho050"/>
		<msg @l="976" char_id="0" frame_id="1" name="美帆" text="『はい‥‥。』" voices=""/>
		<clear @l="980" layer="miho"/>
		<bgm @l="984" src="bgm02" volume="1."/>
		<msg @l="986" char_id="-1" frame_id="-1" name=""
		   text="先輩はいつもの笑みを浮かべると、立ち去った。" voices=""/>
		<msg @l="987" char_id="-1" frame_id="-1" name=""
		   text="もし、私が稲庭先輩のお誘いを断わったなんて知ったら‥‥自称稲庭先輩親衛隊である講義友達の子はなんと言うだろう？" voices=""/>
		<msg @l="988" char_id="-1" frame_id="-1" name=""
		   text="恐らく「この大馬鹿者！」と怒鳴りつけられるに違いない‥‥。" voices=""/>
		<clear @l="991" layer="miho"/>
		<msg @l="993" char_id="0" frame_id="1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="995" char_id="0" frame_id="1" name="美帆" text="(私‥‥やっぱりなんか宙ぶらりんだよ)"
		   voices=""/>
		<msg @l="997" char_id="-1" frame_id="-1" name=""
		   text="そうして去っていく稲庭先輩の背中を見つめながら、私は心の中でつぶやく。" voices=""/>
		<msg @l="998" char_id="-1" frame_id="-1" name=""
		   text="西の空に浮かぶ太陽が‥‥‥少し、眩しかった。" voices=""/>
		<clear @l="1006" class="all"/>
		<wait_chgmv/>
		<bg @l="1010" src="bg07b"/>
		<bgm @l="1014" src="bgm07" volume="1."/>
		<char @l="1018" id="miho" pos="auto" src="miho110"/>
		<msg @l="1020" char_id="0" frame_id="1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="1022" char_id="-1" frame_id="-1" name=""
		   text="クラブ棟を出た頃にはすっかり暗くなってしまっていた。" voices=""/>
		<msg @l="1023" char_id="-1" frame_id="-1" name=""
		   text="私は疲れきった身体を引きずるように停留所へ向かう。" voices=""/>
		<msg @l="1024" char_id="-1" frame_id="-1" name=""
		   text="入り口近くの電灯に目をやると、その灯りの下に稲庭先輩の姿がある。" voices=""/>
		<msg @l="1026" char_id="0" frame_id="1" name="美帆" text="『あっ、稲庭先輩。』"
		   voices=""/>
		<clear @l="1029" class="char"/>
		<char @l="1031" id="miho" pos="left" src="miho110"/>
		<char @l="1034" id="inaba" pos="right" src="inaba010"/>
		<msg @l="1036" char_id="-1" frame_id="-1" name="稲庭" text="『おや、仲根くん、今帰りかい？』"
		   voices=""/>
		<msg @l="1038" char_id="0" frame_id="1" name="美帆" text="『え‥‥ええ。』" voices=""/>
		<msg @l="1040" char_id="-1" frame_id="-1" name="稲庭"
		   text="『ん？&#32;少し元気がないんじゃないかな？』" voices=""/>
		<char @l="1045" id="miho" pos="left" src="miho113"/>
		<msg @l="1047" char_id="0" frame_id="1" name="美帆" text="『そんなこと‥‥ないですよ。』"
		   voices=""/>
		<msg @l="1049" char_id="-1" frame_id="-1" name="稲庭"
		   text="『ちょっと疲れたのかもしれないね。今日はゆっくり休むといい。』" voices=""/>
		<msg @l="1051" char_id="0" frame_id="1" name="美帆"
		   text="『なんか私、同じこと言われてますね‥‥。』" voices=""/>
		<msg @l="1053" char_id="-1" frame_id="-1" name="稲庭" text="『最初はみんなそんなものだよ。』"
		   voices=""/>
		<msg @l="1055" char_id="-1" frame_id="-1" name="稲庭"
		   text="『自分の身体と相談しながら、ゆっくり楽しめばいいんだから。』" voices=""/>
		<char @l="1059" id="miho" pos="left" src="miho010"/>
		<msg @l="1061" char_id="0" frame_id="1" name="美帆" text="『そうですね。』" voices=""/>
		<clear @l="1067" class="all"/>
		<wait_chgmv/>
		<bg @l="1071" src="bg07b"/>
		<char @l="1075" id="miho" pos="left" src="miho010"/>
		<char @l="1079" id="inaba" pos="right" src="inaba010"/>
		<msg @l="1081" char_id="-1" frame_id="-1" name="" text="稲庭先輩と二人でキャンパスを歩く。"
		   voices=""/>
		<msg @l="1082" char_id="-1" frame_id="-1" name=""
		   text="ほんの数日前までは想像も出来なかった状況だった。" voices=""/>
		<msg @l="1084" char_id="-1" frame_id="-1" name="稲庭" text="『どう、少しはこの町に慣れた？』"
		   voices=""/>
		<msg @l="1086" char_id="0" frame_id="1" name="美帆"
		   text="『あ、はい‥‥何とか慣れてきたと思います。』" voices=""/>
		<msg @l="1088" char_id="-1" frame_id="-1" name="稲庭" text="『それはよかった。』"
		   voices=""/>
		<msg @l="1090" char_id="-1" frame_id="-1" name="稲庭"
		   text="『この町はかなり特殊な場所にあるから、合わない人は大変な思いをしているみたいなんだよ。』" voices=""/>
		<char @l="1094" id="miho" pos="left" src="miho114"/>
		<msg @l="1096" char_id="0" frame_id="1" name="美帆" text="『大変‥‥ですか？』"
		   voices=""/>
		<msg @l="1098" char_id="-1" frame_id="-1" name="稲庭"
		   text="『ほら、この町には基本的に娯楽が少ないだろ？』" voices=""/>
		<msg @l="1100" char_id="-1" frame_id="-1" name="稲庭"
		   text="『ゲームセンターもカラオケも数があまり無いし、マイナーなＣＤや本なんか通販を使わないと手に入り難いからね。』" voices=""/>
		<char @l="1104" id="miho" pos="left" src="miho011"/>
		<msg @l="1106" char_id="0" frame_id="1" name="美帆"
		   text="『そうですね‥‥隣町は遠いのでちょっと買いに行くって事ができませんよね。』" voices=""/>
		<msg @l="1108" char_id="0" frame_id="1" name="美帆"
		   text="『でも、私は困ってないので大丈夫です。』" voices=""/>
		<msg @l="1110" char_id="-1" frame_id="-1" name="稲庭"
		   text="『そう？それなら、構わないんだけどね。』" voices=""/>
		<msg @l="1112" char_id="-1" frame_id="-1" name="稲庭" text="『僕はこの町が好きだからね。』"
		   voices=""/>
		<char @l="1117" id="miho" pos="left" src="miho010"/>
		<msg @l="1119" char_id="0" frame_id="1" name="美帆"
		   text="『この町が好きって、何か良い思い出でもあるんですか？』" voices=""/>
		<msg @l="1121" char_id="-1" frame_id="-1" name="稲庭"
		   text="『ああ‥‥僕は生まれつき身体が弱くてね、日常生活を送るにも支障を来たすほどだったんだ。』" voices=""/>
		<msg @l="1123" char_id="-1" frame_id="-1" name="稲庭"
		   text="『それがこの町に来てから‥‥‥快復したんだよ。』" voices=""/>
		<char @l="1127" id="miho" pos="left" src="miho014"/>
		<msg @l="1129" char_id="0" frame_id="1" name="美帆"
		   text="『へえ‥‥身体が弱かったなんて、今の先輩からじゃ想像もつきませんね。』" voices=""/>
		<msg @l="1131" char_id="-1" frame_id="-1" name="稲庭"
		   text="『医者には奇跡と言われた。僕も‥‥そう思ってる。』" voices=""/>
		<msg @l="1133" char_id="-1" frame_id="-1" name="稲庭"
		   text="『それで‥‥運動できなかった子供の頃を少しでも取り戻せるようにと僕はテニスを始めたんだ。』" voices=""/>
		<char @l="1137" id="miho" pos="left" src="miho110"/>
		<msg @l="1139" char_id="0" frame_id="1" name="美帆" text="『そう、だったんですか‥‥。』"
		   voices=""/>
		<clear @l="1147" class="all"/>
		<wait_chgmv/>
		<bg @l="1151" src="bg07b"/>
		<char @l="1155" id="miho" pos="left" src="miho010"/>
		<char @l="1159" id="inaba" pos="right" src="inaba010"/>
		<msg @l="1161" char_id="-1" frame_id="-1" name="稲庭" text="『さて、僕はここまでかな。』"
		   voices=""/>
		<msg @l="1163" char_id="-1" frame_id="-1" name=""
		   text="校門のすぐ近くまで到着し、稲庭先輩が立ち止まる。" voices=""/>
		<msg @l="1165" char_id="0" frame_id="1" name="美帆" text="『えっと‥‥‥先輩は？』"
		   voices=""/>
		<msg @l="1167" char_id="-1" frame_id="-1" name="稲庭"
		   text="『僕は車だからね、駐車場に行かないと。』" voices=""/>
		<msg @l="1169" char_id="-1" frame_id="-1" name=""
		   text="先輩は車のキーがついたキーホルダーを指先で弄ぶように見せる。" voices=""/>
		<char @l="1173" id="miho" pos="left" src="miho014"/>
		<msg @l="1175" char_id="0" frame_id="1" name="美帆"
		   text="『えっ‥‥駐車場って、通り過ぎてるじゃないですか！』" voices=""/>
		<msg @l="1177" char_id="-1" frame_id="-1" name="稲庭"
		   text="『あはは、このくらいどうってこと無いよ。』" voices=""/>
		<msg @l="1179" char_id="-1" frame_id="-1" name="稲庭"
		   text="『僕は男だからね、女性をエスコートするのは当然さ。』" voices=""/>
		<char @l="1183" id="miho" pos="left" src="miho116"/>
		<msg @l="1185" char_id="0" frame_id="1" name="美帆" text="『でも‥‥。』" voices=""/>
		<msg @l="1187" char_id="-1" frame_id="-1" name="稲庭" text="『いいからいいから。』"
		   voices=""/>
		<msg @l="1189" char_id="-1" frame_id="-1" name="稲庭"
		   text="『それじゃ、明日の新歓テニス大会‥‥‥楽しみにしているよ。』" voices=""/>
		<char @l="1193" id="miho" pos="left" src="miho011"/>
		<msg @l="1195" char_id="0" frame_id="1" name="美帆" text="『はい！頑張ります！！』"
		   voices=""/>
		<clear @l="1199" layer="inaba"/>
		<msg @l="1201" char_id="-1" frame_id="-1" name=""
		   text="私の返事に先輩は微笑むと、駐車場に向かって歩いていった。" voices=""/>
		<char @l="1205" id="miho" pos="left" src="miho011"/>
		<msg @l="1207" char_id="0" frame_id="1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<char @l="1211" id="miho" pos="left" src="miho110"/>
		<msg @l="1213" char_id="0" frame_id="1" name="美帆"
		   text="『稲庭先輩も‥‥色々あったんだなぁ‥‥。』" voices=""/>
		<msg @l="1215" char_id="-1" frame_id="-1" name=""
		   text="立ち去る先輩の背中がみえなくなるまで見送った後、私はぼそりとつぶやいた。" voices=""/>
		<label @l="1219" id="EventLabel_90"/>
		<stopbgm @l="1223" fadeout="1000"/>
		<clear @l="1229" class="all"/>
		<call @l="1233" target="EventLabel_91@root_inaba02"/>
		<return @l="1234" value="0&#13;&#10;"/>
		<return @l="1238" value=""/>
	</code>
</xscript>
