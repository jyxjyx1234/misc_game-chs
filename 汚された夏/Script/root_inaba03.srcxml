<?xml version="1.0" encoding="utf-8"?>
<xscript>
	<debug editor="&quot;C:\Program&#32;Files&#32;(x86)\sakura\sakura.exe&quot;&#32;&quot;%src%&quot;&#32;-Y=%line%"
	   src="D:\シロップ\町ぐるみの罠＋汚された夏セット版\汚された夏\完成データ\汚された夏\script\text\root_inaba03.txt"/>
	<code>
		<eval @l="11" expr="f.稲庭ルート即席02flag&#32;=&#32;0&#13;&#10;"/>
		<label @l="17" id="EventLabel_96"/>
		<eval @l="20" expr="f.稲庭ルート即席02flag&#32;=&#32;0&#13;&#10;"/>
		<description @l="23" text="テニスサークル入会・４日目"/>
		<msgshow @l="26" show="false"/>
		<wait @l="28" time="500"/>
		<wait_chgmv/>
		<bg @l="30" src="black" time="2000"/>
		<msgshow @l="32" show="true"/>
		<clear @l="35" class="all"/>
		<msg @l="37" char_id="-1" frame_id="-1" name=""
		   text="目の前では、テニスで負けて先に退場して行った筈の女子達が男子会員達に犯されていた。" voices=""/>
		<msg @l="39" char_id="-1" frame_id="-1" name="男子会員Ａ"
		   text="『お前らは敗者だ、だから俺達の肉ラケットで罰を与えてやる。』" voices=""/>
		<msg @l="41" char_id="-1" frame_id="-1" name=""
		   text="男子会員たちは、血走った目で女の子に群がっている。" voices=""/>
		<msg @l="42" char_id="-1" frame_id="-1" name=""
		   text="女の子達はほとんどがテニスウェアを破り取られていて、白昼の屋外だというのに全裸に近い様子で蹂躙されていた。" voices=""/>
		<msg @l="43" char_id="-1" frame_id="-1" name=""
		   text="もうかなりの人数に犯されたのか、無残にも身体はベトベトに汚されている。既に抵抗する気力も無いのか、男子達のなすがままになっていた。"
		   voices=""/>
		<msg @l="46" char_id="-1" frame_id="-1" name=""
		   text="目の前で繰り広げられている地獄絵図がいまだに信じられないでいた。" voices=""/>
		<msg @l="47" char_id="-1" frame_id="-1" name=""
		   text="数十分前までは平和なテニスサークルだと信じていたのに、今目の前にあるそれは、どう見てもレイプサークルそのものだ。" voices=""/>
		<wait_chgmv/>
		<bg @l="50" src="bg13"/>
		<msg @l="52" char_id="-1" frame_id="-1" name="声" text="『お前達、うまくやってるか？』"
		   voices=""/>
		<msg @l="54" char_id="-1" frame_id="-1" name="" text="突然、聞き覚えのある声がした。"
		   voices=""/>
		<msg @l="56" char_id="-1" frame_id="-1" name="男子会員Ｂ" text="『ちーっす、会長！』"
		   voices=""/>
		<bgm @l="59" src="bgm09" volume="1."/>
		<char @l="62" id="inaba" pos="auto" src="inaba050"/>
		<msg @l="64" char_id="-1" frame_id="-1" name="" text="それは、稲庭先輩だった。"
		   voices=""/>
		<msg @l="65" char_id="-1" frame_id="-1" name="" text="どうしてこんなところに‥‥。"
		   voices=""/>
		<msg @l="67" char_id="-1" frame_id="-1" name="稲庭" text="『ほら、いつもの薬だ。』"
		   voices=""/>
		<msg @l="69" char_id="-1" frame_id="-1" name="男子会員Ｃ"
		   text="『やった、新しいドラッグっスね。』" voices=""/>
		<msg @l="71" char_id="-1" frame_id="-1" name="男子会員Ｄ"
		   text="『バッカ、増強剤って呼べって言われてんだろ！』" voices=""/>
		<char @l="74" id="miho" pos="auto" src="miho054"/>
		<msg @l="76" char_id="0" frame_id="1" name="美帆"
		   text="（薬？‥‥ドラッグ？それってどういう事なの？）" voices=""/>
		<char @l="79" id="miho" pos="auto" src="miho055"/>
		<msg @l="81" char_id="0" frame_id="1" name="美帆"
		   text="『稲庭先輩、これって一体どういう事なんですか？』" voices=""/>
		<msg @l="83" char_id="-1" frame_id="-1" name=""
		   text="この状況で、会長が何も知らないとは到底思えない。" voices=""/>
		<msg @l="84" char_id="-1" frame_id="-1" name=""
		   text="しかし、何かの間違いであって欲しいとも思っていた。" voices=""/>
		<clear @l="87" class="char"/>
		<char @l="89" id="miho" pos="right" src="miho055"/>
		<char @l="91" id="inaba" pos="left" src="inaba050"/>
		<msg @l="94" char_id="-1" frame_id="-1" name="稲庭" text="『仲根くん‥‥。』" voices=""/>
		<msg @l="96" char_id="-1" frame_id="-1" name="稲庭"
		   text="『僕が子供の頃、体が弱かったというのは以前話したよね。』" voices=""/>
		<char @l="99" id="miho" pos="right" src="miho054"/>
		<msg @l="101" char_id="0" frame_id="1" name="美帆" text="『は、はい‥‥。』" voices=""/>
		<msg @l="103" char_id="-1" frame_id="-1" name=""
		   text="予想外の出だしに、私は一瞬呆気に取られる。" voices=""/>
		<msg @l="104" char_id="-1" frame_id="-1" name="" text="この人は何を話す気なのだろう。"
		   voices=""/>
		<msg @l="106" char_id="-1" frame_id="-1" name="稲庭"
		   text="『それで静養をかねてこの町‥‥当時は村だったかな‥‥にあったウチの別荘にやって来たんだけど、回復する見込みは全くと言っていい程無かった。』"
		   voices=""/>
		<msg @l="108" char_id="-1" frame_id="-1" name="稲庭"
		   text="『そんなある日、この町にあった大黒製薬の研究所からある新薬の被験者にならないかという話があったんだ。』" voices=""/>
		<msg @l="110" char_id="-1" frame_id="-1" name="" text="大黒製薬の事はよく知っている。"
		   voices=""/>
		<msg @l="111" char_id="-1" frame_id="-1" name=""
		   text="大企業だからという事もあるが、父の勤め先だからというのが一番の理由だ。" voices=""/>
		<msg @l="112" char_id="-1" frame_id="-1" name=""
		   text="父も研究所勤務だが、この町に研究所があったなんて話は聞いたことが無い。" voices=""/>
		<msg @l="113" char_id="-1" frame_id="-1" name="" text="引越しの時にも何も言われなかった。"
		   voices=""/>
		<msg @l="115" char_id="-1" frame_id="-1" name="稲庭"
		   text="『藁にもすがりたかった両親はこの話に飛びつき、その結果、僕の体は奇跡的に回復した。』" voices=""/>
		<msg @l="117" char_id="-1" frame_id="-1" name="稲庭"
		   text="『ただ、その薬には副作用があった。ひとつは服用を続けなければならない事、もう一つは‥‥自分の感情のコントロールが利きにくくなる事、特に性欲のね。』"
		   voices=""/>
		<char @l="120" id="miho" pos="right" src="miho055"/>
		<msg @l="122" char_id="0" frame_id="1" name="美帆" text="『それでこんな事を‥‥。』"
		   voices=""/>
		<msg @l="124" char_id="-1" frame_id="-1" name="稲庭"
		   text="『感情のコントロールは訓練できても、性欲を抑えるのは困難だった。だが、レイプサークルなら女の供給は簡単に出来るし、セックスしまくっても誰も疑問に思わない。』"
		   voices=""/>
		<msg @l="126" char_id="0" frame_id="1" name="美帆" text="『そ、そんな事のために‥‥。』"
		   voices=""/>
		<clear @l="129" class="char"/>
		<char @l="131" id="kuma" pos="auto" src="kuma012"/>
		<msg @l="133" char_id="-1" frame_id="-1" name="声"
		   text="『もちろんそれだけではございませんよ。』" voices=""/>
		<msg @l="135" char_id="-1" frame_id="-1" name="" text="突然用務員さんらしい人が口を挟んできた。"
		   voices=""/>
		<clear @l="138" class="char"/>
		<char @l="140" id="inaba" pos="right" src="inaba050"/>
		<char @l="142" id="kuma" pos="left" src="kuma012"/>
		<msg @l="145" char_id="-1" frame_id="-1" name="稲庭"
		   text="『こちらの熊野さんは僕が被験者になった時に研究所にいた担当の人でね、今もこうやって薬を提供してくれているんだ。』" voices=""/>
		<clear @l="148" class="char"/>
		<char @l="150" id="miho" pos="auto" src="miho055"/>
		<msg @l="152" char_id="-1" frame_id="-1" name="" text="このひとが‥‥？" voices=""/>
		<msg @l="153" char_id="-1" frame_id="-1" name=""
		   text="でも、なんでそんな人が大学で用務員なんてしているんだろう。" voices=""/>
		<clear @l="156" class="char"/>
		<char @l="158" id="miho" pos="right" src="miho055"/>
		<char @l="160" id="kuma" pos="left" src="kuma012"/>
		<msg @l="163" char_id="-1" frame_id="-1" name="熊野"
		   text="『あなた‥‥製薬会社がいまだに実現出来ていない薬ってなんだかわかりますか？』" voices=""/>
		<char @l="166" id="miho" pos="right" src="miho054"/>
		<msg @l="168" char_id="0" frame_id="1" name="美帆" text="『えっ？ガンの特効薬とか‥‥。』"
		   voices=""/>
		<msg @l="170" char_id="-1" frame_id="-1" name="熊野"
		   text="『絶対検査にひっかからないドーピング剤と安全確実な勃起薬です。これらを他社に先駆けて実現出来れば巨万の富を生む事は確実。その為に稲庭さんに手伝ってもらってるのですよ。』"
		   voices=""/>
		<msg @l="172" char_id="0" frame_id="1" name="美帆" text="『それと稲庭先輩がどういう‥‥はっ！』"
		   voices=""/>
		<msg @l="174" char_id="-1" frame_id="-1" name="熊野"
		   text="『そうです、稲庭さんは両方の条件を持った数少ない成功例なのです。』" voices=""/>
		<msg @l="176" char_id="-1" frame_id="-1" name="稲庭"
		   text="『ただ、完全なものにするにはたくさんのデータがいる。そこで、テニスサークルをレイプサークルに作り変え、改変された薬を部員達に精力剤だ、ドラッグだと言って服用させた。』"
		   voices=""/>
		<char @l="179" id="inaba" pos="left" src="inaba050"/>
		<msg @l="181" char_id="-1" frame_id="-1" name="稲庭" text="『結果は‥‥今、見てのとおりだ。』"
		   voices=""/>
		<clear @l="184" class="char"/>
		<msg @l="186" char_id="-1" frame_id="-1" name=""
		   text="まわりを見渡すと男子達が一心不乱に女子を犯していた。" voices=""/>
		<msg @l="187" char_id="-1" frame_id="-1" name=""
		   text="何回射精しても萎える事もなく、いつ果てるとも知れぬレイプショーが目の前で繰り広げられていた。" voices=""/>
		<char @l="190" id="miho" pos="auto" src="miho055"/>
		<msg @l="192" char_id="0" frame_id="1" name="美帆"
		   text="『あぁ‥‥。じゃ、じゃあ、玲さんはどうなんですか？玲さんはレイプサークルの事は何も言ってませんでした。なぜなんです？稲庭先輩は玲さんの事が好きだから‥‥だから手も出さずに今までいたんじゃないんですか？』"
		   voices=""/>
		<msg @l="194" char_id="-1" frame_id="-1" name="" text="私は必死に稲庭先輩に問いかける。"
		   voices=""/>
		<msg @l="195" char_id="-1" frame_id="-1" name=""
		   text="これだけのレイプサークルで、玲さんのような美人が毒牙にかからないわけがない。" voices=""/>
		<clear @l="198" class="char"/>
		<char @l="200" id="inaba" pos="left" src="inaba050"/>
		<char @l="202" id="miho" pos="right" src="miho055"/>
		<msg @l="205" char_id="-1" frame_id="-1" name="稲庭"
		   text="『確かに‥‥玲は大学入学時から美人で目立った存在だった。しかし、彼女のように正義感の強い女性を仲間に引き込むのはリスクが大きい。結局、教師受けが良く同性に信用のある彼女は表のテニス部の広告塔にしか使えなかったのさ。』"
		   voices=""/>
		<msg @l="207" char_id="0" frame_id="1" name="美帆" text="『そ、そんな‥‥そんな事って。』"
		   voices=""/>
		<msg @l="209" char_id="-1" frame_id="-1" name="稲庭"
		   text="『それにね、僕は処女の子宮でしか満足出来ない‥‥つまり、玲のような穢れた女には興味がないんだ。』" voices=""/>
		<msg @l="211" char_id="0" frame_id="1" name="美帆" text="『ひ、ひどい‥‥。』" voices=""/>
		<msg @l="213" char_id="-1" frame_id="-1" name="稲庭" text="『残念だが、事実を言っただけだ。』"
		   voices=""/>
		<msg @l="215" char_id="-1" frame_id="-1" name="男子会員Ｅ"
		   text="『会長、そろそろ向かわないと二次会が‥‥。』" voices=""/>
		<msg @l="217" char_id="-1" frame_id="-1" name=""
		   text="突然、男子の一人がやってきて稲庭先輩に耳打ちする。" voices=""/>
		<clear @l="220" class="char"/>
		<char @l="222" id="inaba" pos="center" src="inaba050f" y="-80"/>
		<msg @l="225" char_id="-1" frame_id="-1" name="稲庭" text="『おいおい、察しろよ副会長。』"
		   voices=""/>
		<msg @l="227" char_id="-1" frame_id="-1" name=""
		   text="先輩は小指を立てたまま右腕を前に突き出し、副会長の方をジロッと見る。" voices=""/>
		<msg @l="228" char_id="-1" frame_id="-1" name="" text="表情は笑顔だが、目は全く笑っていない。"
		   voices=""/>
		<msg @l="230" char_id="-1" frame_id="-1" name="男子会員Ｅ" text="『‥‥しっ、失礼しましたっ！』"
		   voices=""/>
		<msg @l="232" char_id="-1" frame_id="-1" name=""
		   text="副会長は先輩と私の両方に目を配ると、何かを察したように走り去って行った。" voices=""/>
		<clear @l="234" class="char"/>
		<char @l="236" id="inaba" pos="auto" src="inaba050"/>
		<msg @l="239" char_id="-1" frame_id="-1" name="稲庭"
		   text="『今の僕にとっては二次会より目の前にいる君の方が大事だからね。』" voices=""/>
		<clear @l="242" class="char"/>
		<char @l="244" id="inaba" pos="left" src="inaba050"/>
		<char @l="246" id="miho" pos="right" src="miho054"/>
		<msg @l="248" char_id="0" frame_id="1" name="美帆" text="『えっ？』" voices=""/>
		<msg @l="250" char_id="0" frame_id="1" name="美帆" text="（そ、それってどういう‥‥事？）"
		   voices=""/>
		<stopbgm @l="253" fadeout="1000"/>
		<msg @l="255" char_id="-1" frame_id="-1" name="稲庭"
		   text="『僕の欲望はね‥‥君のような極上の処女肉を喰らわないと満足出来ないんだよ、仲根美帆くん。』" voices=""/>
		<msg @l="257" char_id="0" frame_id="1" name="美帆" text="『ええっ！？』" voices=""/>
		<bgm @l="260" src="bgm08" volume="1."/>
		<msg @l="262" char_id="-1" frame_id="-1" name="" text="私は声が出なかった。" voices=""/>
		<msg @l="263" char_id="-1" frame_id="-1" name=""
		   text="なんで、どうしてこの人は私が処女だって事を知ってるんだろう。" voices=""/>
		<msg @l="265" char_id="-1" frame_id="-1" name="稲庭"
		   text="『不思議そうだね‥‥何百人と処女を散らしてきた僕には、処女かどうか見分ける事なんて簡単な事なのさ。』" voices=""/>
		<char @l="268" id="miho" pos="right" src="miho055"/>
		<msg @l="270" char_id="0" frame_id="1" name="美帆" text="『そんな‥‥許してください。』"
		   voices=""/>
		<msg @l="272" char_id="-1" frame_id="-1" name="稲庭"
		   text="『そうだな‥‥幸い今は薬の副作用もそれほど出ていない。別の意味で僕を満足させられたら開放してあげてもいい。』" voices=""/>
		<msg @l="274" char_id="0" frame_id="1" name="美帆" text="『どうすればいいんですか。』"
		   voices=""/>
		<clear @l="277" class="char"/>
		<char @l="279" id="inaba" pos="center" src="inaba050f" y="-80"/>
		<msg @l="281" char_id="-1" frame_id="-1" name="稲庭"
		   text="『ここにいる部員達を全員満足させるんだ、アソコのかわりに口を使ってね。』" voices=""/>
		<msg @l="283" char_id="-1" frame_id="-1" name=""
		   text="先輩の提案は、通常なら考えられないくらい無茶苦茶な話だった。" voices=""/>
		<msg @l="284" char_id="-1" frame_id="-1" name="" text="でも‥‥。" voices=""/>
		<stopbgm @l="287" fadeout="1000"/>
		<clear @l="290" class="char"/>
		<char @l="292" id="miho" pos="auto" src="miho055"/>
		<msg @l="294" char_id="0" frame_id="1" name="美帆" text="『わかりました、口で‥‥‥します。』"
		   voices=""/>
		<msg @l="296" char_id="-1" frame_id="-1" name="" text="私は咄嗟にそう言っていた。"
		   voices=""/>
		<msg @l="297" char_id="-1" frame_id="-1" name=""
		   text="こんなことで処女を失いたくないという一心からきた言葉だったのだが、よくよく考えてみれば口でするのだって初めてだ。" voices=""/>
		<msg @l="298" char_id="-1" frame_id="-1" name=""
		   text="なんにせよ‥‥‥初めては奪われてしまうことになる。" voices=""/>
		<msg @l="300" char_id="0" frame_id="1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="302" char_id="0" frame_id="1" name="美帆" text="(でも‥‥これで終わってくれれば)"
		   voices=""/>
		<clear @l="310" class="all"/>
		<label @l="313" id="event_scene16"/>
		<msgshow @l="316" show="true"/>
		<label @l="320" id="chart_line54"/>
		<wait_chgmv/>
		<ev @l="324" src="ev-016"/>
		<description @l="327" text="敗者の処刑"/>
		<bgm @l="331" src="bgm14" volume="1."/>
		<msg @l="333" char_id="-1" frame_id="-1" name=""
		   text="私は、初めて間近で見る、そのあまりにも醜い欲の物体に嫌悪感が走った。" voices=""/>
		<msg @l="335" char_id="0" frame_id="1" name="美帆" text="『んぐ‥‥。』"
		   voices="miho05680"/>
		<msg @l="337" char_id="-1" frame_id="-1" name=""
		   text="まだ、わずかに柔らかいそれを咥えた瞬間、口腔内にそれまで感じたことのない味と匂いが広がっていった。" voices=""/>
		<msg @l="338" char_id="-1" frame_id="-1" name=""
		   text="初めて咥えたそれに‥‥思わず吐き気がした。" voices=""/>
		<msg @l="339" char_id="-1" frame_id="-1" name=""
		   text="生臭いというか青臭いというか‥‥そんな匂いと味に戸惑いながら、私はソレの先端部分を完全に咥え込んだところで動きを止める。"
		   voices=""/>
		<msg @l="341" char_id="0" frame_id="1" name="美帆" text="『‥‥‥‥。』"
		   voices="miho05690"/>
		<msg @l="343" char_id="-1" frame_id="-1" name="男子会員Ａ" text="『なんだ、どーした？』"
		   voices=""/>
		<msg @l="345" char_id="0" frame_id="1" name="美帆"
		   text="『あの‥‥このあと、どうすれば良いんですか？』" voices="miho05700//咥えたまましゃべってます"/>
		<msg @l="347" char_id="-1" frame_id="-1" name="男子会員Ａ"
		   text="『あ？&#32;お前フェラチオ知らねーのかよ！？』" voices=""/>
		<msg @l="349" char_id="0" frame_id="1" name="美帆" text="『す、すみません‥‥。』"
		   voices="miho05710//咥えたまましゃべってます"/>
		<msg @l="351" char_id="-1" frame_id="-1" name="男子会員Ａ"
		   text="『んじゃ、教えてやるからシッカリしゃぶれよ。』" voices=""/>
		<msg @l="353" char_id="0" frame_id="1" name="美帆" text="『は、はいっ。』"
		   voices="miho05720"/>
		<msg @l="355" char_id="-1" frame_id="-1" name="男子会員Ａ"
		   text="『まずは舌を使ってぺろぺろ舐める。』" voices=""/>
		<msg @l="357" char_id="0" frame_id="1" name="美帆"
		   text="『んっ‥‥‥れろ、れろ‥‥‥‥れろ‥‥‥‥‥。』" voices="miho05730"/>
		<msg @l="359" char_id="-1" frame_id="-1" name=""
		   text="言われるまま、私は口の中で舌を動かして男根を舐める。" voices=""/>
		<msg @l="360" char_id="-1" frame_id="-1" name=""
		   text="舌先に触れたその感触がまた奇妙で‥‥私は思わず眉根をしかめた。" voices=""/>
		<msg @l="362" char_id="-1" frame_id="-1" name="男子会員Ａ"
		   text="『そのままツバを塗る感じで舐め続けろよ。』" voices=""/>
		<msg @l="364" char_id="0" frame_id="1" name="美帆"
		   text="『んぐ‥‥‥ん、ちゅ‥‥‥ちゅろ‥‥ちゅろ‥‥‥‥‥。』" voices="miho05740"/>
		<msg @l="366" char_id="-1" frame_id="-1" name=""
		   text="小尿をする器官を口に咥えるなんていい汚らしいとしか思えない。何度も込み上げてくる胃液を堪えながら、舐め続ける。" voices=""/>
		<msg @l="368" char_id="-1" frame_id="-1" name="男子会員Ａ"
		   text="『おう、イイ感じだ‥‥‥んじゃ次は先っぽを吸え。』" voices=""/>
		<msg @l="370" char_id="0" frame_id="1" name="美帆" text="『んっ‥‥。』"
		   voices="miho05750"/>
		<msg @l="372" char_id="-1" frame_id="-1" name=""
		   text="言われるまま、私は唇をすぼめて先っぽを吸い上げた。" voices=""/>
		<msg @l="374" char_id="-1" frame_id="-1" name="男子会員Ａ"
		   text="『あんまり強く吸いすぎても痛いだけだから、甘く吸いながら唇を締めたり緩めたりするんだよ。』" voices=""/>
		<msg @l="376" char_id="0" frame_id="1" name="美帆"
		   text="『ふっ‥‥ん、んんっ‥‥‥‥じゅっ‥‥んっ、ちゅるるっ。』" voices="miho05760"/>
		<msg @l="378" char_id="-1" frame_id="-1" name="男子会員Ａ" text="『お？今のはなかなかだな。』"
		   voices=""/>
		<msg @l="380" char_id="-1" frame_id="-1" name=""
		   text="喜ぶ彼の言葉を聞きながら、このようなことが気持ちいいと強要する男性は理不尽にしか思えなかった。" voices=""/>
		<msg @l="382" char_id="-1" frame_id="-1" name="男子会員Ａ"
		   text="『そんじゃ‥‥後は今みたいに甘く吸いながら頭を前後に振って唇でシゴきな。』" voices=""/>
		<msg @l="384" char_id="0" frame_id="1" name="美帆" text="『んっ‥‥ちゅぷ‥‥‥‥。』"
		   voices="miho05770"/>
		<msg @l="386" char_id="-1" frame_id="-1" name="" text="試しに一度、ゆっくりと頭を動かしてみる。"
		   voices=""/>
		<msg @l="387" char_id="-1" frame_id="-1" name=""
		   text="自分の口元から漏れてくる唾液の跳ねるような水音が妙に淫靡に聞こえて気恥ずかしくなる。" voices=""/>
		<msg @l="389" char_id="-1" frame_id="-1" name="男子会員Ａ"
		   text="『あんまり深くしなくていいぜ。喉の奥に当たるとえづいちまうからな。』" voices=""/>
		<msg @l="391" char_id="0" frame_id="1" name="美帆"
		   text="『ちゅぷ‥‥んっ、んぐっ‥‥‥ちゅぷ‥‥‥‥ちゅぷっ‥‥‥。』" voices="miho05780"/>
		<msg @l="393" char_id="-1" frame_id="-1" name="男子会員Ａ"
		   text="『そう‥‥そんな感じだ‥‥‥そのまま続けてくれ。』" voices=""/>
		<msg @l="395" char_id="-1" frame_id="-1" name=""
		   text="肉の塊はミミズのような血管を浮かし、ビクンビクンと脈うっている。" voices=""/>
		<msg @l="397" char_id="0" frame_id="1" name="美帆"
		   text="『んんっ‥‥‥んっ、ちゅぷ、ちゅぷ‥‥‥‥んぐ、ちゅぷっ。』" voices="miho05790"/>
		<msg @l="399" char_id="-1" frame_id="-1" name=""
		   text="私は教えてもらった通り、浅く先端の部分を唇でシゴきあげる。" voices=""/>
		<msg @l="400" char_id="-1" frame_id="-1" name=""
		   text="そうしているうちに口腔内のモノが徐々に硬く大きくなっていった。" voices=""/>
		<msg @l="402" char_id="0" frame_id="1" name="美帆"
		   text="『んっ‥‥ちゅむ、んんっ‥‥‥ちゅぷ、ちゅぷ、ちゅぷっ。』" voices="miho05800"/>
		<msg @l="404" char_id="-1" frame_id="-1" name="男子会員Ａ"
		   text="『いいぜ、そのまま歯は立てんなよ。』" voices=""/>
		<msg @l="406" char_id="0" frame_id="1" name="美帆"
		   text="『んふっ‥‥んん‥‥‥‥ちゅぷ、んっ‥‥‥んんっ‥‥‥‥‥。』" voices="miho05810"/>
		<msg @l="408" char_id="-1" frame_id="-1" name=""
		   text="大きく口を開け、歯が当たらないように唇と舌でソレをしゃぶっていく。" voices=""/>
		<msg @l="409" char_id="-1" frame_id="-1" name=""
		   text="先端の大きくくびれた部分に舌先が当たると、男は腰を震わせた。" voices=""/>
		<msg @l="411" char_id="0" frame_id="1" name="美帆" text="『んぅ‥‥？』"
		   voices="miho05820"/>
		<msg @l="413" char_id="-1" frame_id="-1" name="男子会員Ａ"
		   text="『そこ、男の感じるところだからな‥‥‥よく覚えとけよ！』" voices=""/>
		<msg @l="415" char_id="0" frame_id="1" name="美帆" text="『ふぁい‥‥ん、ちゅるっ。』"
		   voices="miho05830"/>
		<msg @l="417" char_id="0" frame_id="1" name="美帆"
		   text="『あふ、んっ‥‥‥んちゅ、ちゅる‥‥‥‥ん‥‥んぷっ‥‥‥。』" voices="miho05840"/>
		<msg @l="419" char_id="-1" frame_id="-1" name="" text="息苦しさで目の前がぼうっとした。"
		   voices=""/>
		<msg @l="420" char_id="-1" frame_id="-1" name=""
		   text="それでも、奉仕を止めるわけには行かず、私は少しでも早く彼が満足してくれるようにとしゃぶり続ける。" voices=""/>
		<msg @l="422" char_id="-1" frame_id="-1" name="男子会員Ａ"
		   text="『ああ、いいぜ‥‥‥そのまま先っぽを重点的に舐めてくれ。』" voices=""/>
		<msg @l="424" char_id="0" frame_id="1" name="美帆"
		   text="『ん、ちゅぷ‥‥‥じゅ‥‥ちゅる‥‥‥ちゅぷ、ちゅぷ、ちゅぷ。』" voices="miho05850"/>
		<msg @l="426" char_id="-1" frame_id="-1" name="男子会員Ａ" text="『くっ‥‥。』"
		   voices=""/>
		<msg @l="428" char_id="0" frame_id="1" name="美帆"
		   text="(うあ‥‥‥先っぽから何か出てきた‥‥‥‥‥‥)" voices="miho05860"/>
		<msg @l="430" char_id="-1" frame_id="-1" name=""
		   text="男が短く声を漏らして腰を震わせると、それに呼応するように彼の先端から透明な苦い汁が滲み出してくる。汚らわしさに身震いをしながらも私は、それを舐め続けた。"
		   voices=""/>
		<msg @l="432" char_id="-1" frame_id="-1" name="男子会員Ａ" text="『も、もうすぐイクぜ‥‥。』"
		   voices=""/>
		<msg @l="434" char_id="0" frame_id="1" name="美帆"
		   text="『んんっ‥‥‥ちゅぷ、んっ、ちゅぷ、ちゅぷ、ちゅぷっ‥‥‥。』" voices="miho05870"/>
		<msg @l="436" char_id="0" frame_id="1" name="美帆"
		   text="『ちゅるっ‥‥‥んぷ、んっ‥‥‥んぐっ‥‥‥じゅ、ちゅるるっ。』" voices="miho05880"/>
		<msg @l="438" char_id="-1" frame_id="-1" name="男子会員Ａ"
		   text="『くぅ‥‥だ、出すぞっ‥‥‥‥顔と口どっちがいい？』" voices=""/>
		<msg @l="442" async="true" char_id="-1" frame_id="-1" name=""
		   text="どこに出させる‥‥？" voices=""/>
		<select @l="443">
			<menu @l="447" label="TempLabel_304" text="顔"/>
			<menu @l="450" label="TempLabel_306" text="口"/>
		</select>
		<goto @l="455" label="TempLabel_305"/>
		<label @l="457" id="TempLabel_304"/>
		<eval @l="459" expr="f.稲庭ルート即席02flag&#32;=&#32;1&#13;&#10;"/>
		<goto @l="460" label="TempLabel_305"/>
		<label @l="462" id="TempLabel_306"/>
		<eval @l="464" expr="f.稲庭ルート即席02flag&#32;=&#32;2&#13;&#10;"/>
		<goto @l="465" label="TempLabel_305"/>
		<label @l="467" id="TempLabel_305"/>
		<label @l="471" id="EventLabel_97"/>
		<goto @l="474" cond="!(f.稲庭ルート即席02flag&#32;==&#32;1)&#13;&#10;"
		   label="TempLabel_307"/>
		<msg @l="476" char_id="0" frame_id="1" name="美帆" text="『そ、それじゃあ顔に‥‥。』"
		   voices="miho05890"/>
		<msg @l="478" char_id="-1" frame_id="-1" name=""
		   text="男の子が射精をする事は‥‥さすがの私も知識として持っている。" voices=""/>
		<msg @l="479" char_id="-1" frame_id="-1" name=""
		   text="しかし、精液を口腔で受け止めるというのにはさすがに抵抗を感じ、仕方なく私は「顔」と答えていた。" voices=""/>
		<msg @l="481" char_id="-1" frame_id="-1" name="男子会員Ａ"
		   text="『よーし、んじゃ顔にたっぷりぶっかけるぞ！』" voices=""/>
		<msg @l="483" char_id="0" frame_id="1" name="美帆" text="『は、はいっ。』"
		   voices="miho05900"/>
		<flash @l="487" count="4" fade="100" image="white"/>
		<wait_chgmv/>
		<ev @l="491" src="ev-016x1z1"/>
		<msg @l="493" char_id="0" frame_id="1" name="美帆" text="『んんっ！！！』"
		   voices="miho05910"/>
		<msg @l="495" char_id="-1" frame_id="-1" name=""
		   text="男の腰が震えると同時に、先端から大量の白濁色をした液体が噴出して私の顔を汚していった。生臭い臭いが鼻腔をツンと刺激し、私は身震いした。"
		   voices=""/>
		<msg @l="497" char_id="0" frame_id="1" name="美帆"
		   text="(すご‥‥‥こんなにいっぱい出るんだ‥‥‥‥‥)" voices="miho05920"/>
		<msg @l="499" char_id="-1" frame_id="-1" name=""
		   text="それが件の増強剤による効果かどうかは私には解らないが、次々と溢れ出てくるソレには確かに圧倒される。" voices=""/>
		<goto @l="502" label="TempLabel_308"/>
		<label @l="503" id="TempLabel_307"/>
		<msg @l="506" char_id="0" frame_id="1" name="美帆" text="『口に‥‥お願いします。』"
		   voices="miho05930"/>
		<msg @l="508" char_id="-1" frame_id="-1" name=""
		   text="テニスウェアを汚したくない一心で、私はそう答えていた。" voices=""/>
		<msg @l="509" char_id="-1" frame_id="-1" name=""
		   text="よく考えてみると、それは先端から溢れ出る精液を口で受け止めなければならないということになるのだが‥‥私がその事に気付いた時は既に遅かった。"
		   voices=""/>
		<msg @l="511" char_id="-1" frame_id="-1" name="男子会員Ａ"
		   text="『よし、それじゃあちゃんと咥えてろよ。』" voices=""/>
		<msg @l="513" char_id="0" frame_id="1" name="美帆" text="『んぐっ‥‥‥ん、んむぅっ。』"
		   voices="miho05940"/>
		<msg @l="515" char_id="-1" frame_id="-1" name="男子会員Ａ" text="『イ、イクぜっ！』"
		   voices=""/>
		<flash @l="519" count="4" fade="100" image="white"/>
		<wait_chgmv/>
		<ev @l="523" src="ev-016x1z4"/>
		<msg @l="525" char_id="0" frame_id="1" name="美帆" text="『んんっっ！！』"
		   voices="miho05950"/>
		<msg @l="527" char_id="-1" frame_id="-1" name=""
		   text="男の先端が一瞬膨らんだかと思うと、その先端から勢いよく熱い液体が噴出して口腔内へ注ぎ込まれた。" voices=""/>
		<msg @l="529" char_id="-1" frame_id="-1" name="男子会員Ａ"
		   text="『お、おおっ‥‥‥ちゃんと一適残らず飲み込めよ。』" voices=""/>
		<msg @l="531" char_id="0" frame_id="1" name="美帆"
		   text="『んっ、んんっ‥‥‥んっ‥‥‥‥んくっ‥‥‥んくっ‥‥‥‥。』" voices="miho05960"/>
		<msg @l="533" char_id="-1" frame_id="-1" name=""
		   text="抵抗はあったモノの、次々と噴出してくる精液に息が出来なくなり、耐え切れなくなった私は、喉をゴクリと鳴らしてその液体を流し込んでいった。"
		   voices=""/>
		<msg @l="534" char_id="-1" frame_id="-1" name=""
		   text="粘り気の強いそれは喉に絡みつく感じが嫌悪感を生んだ。思わず咳き込みそうになるのをぐっと堪える。" voices=""/>
		<msg @l="535" char_id="-1" frame_id="-1" name="" text="目からは涙が零れ落ちる。"
		   voices=""/>
		<msg @l="537" char_id="-1" frame_id="-1" name="男子会員Ａ"
		   text="『いいぜ、そのまま先っぽ吸って中に残ってるのもちゃんと飲むんだぜ。』" voices=""/>
		<msg @l="539" char_id="0" frame_id="1" name="美帆"
		   text="『んぐっ‥‥んぅ‥‥‥‥ちゅぷ‥‥‥んっ、ちゅるるるるるっ。』" voices="miho05970"/>
		<label @l="542" id="TempLabel_308"/>
		<clear @l="549" class="all"/>
		<msg @l="551" char_id="-1" frame_id="-1" name="男子会員Ａ"
		   text="『よーし、んじゃ次のやつに交代な。』" voices=""/>
		<msg @l="553" char_id="0" frame_id="1" name="美帆" text="『え‥‥もう、ですか？』"
		   voices="miho05980"/>
		<msg @l="555" char_id="0" frame_id="1" name="美帆" text="『少し、休ませてもらえませんか‥‥。』"
		   voices="miho05990"/>
		<msg @l="557" char_id="-1" frame_id="-1" name="男子会員Ａ"
		   text="『なに言ってんだよ、次々やらねーと日が暮れるぜ？』" voices=""/>
		<msg @l="559" char_id="0" frame_id="1" name="美帆" text="『‥‥‥‥。』"
		   voices="miho06000"/>
		<msg @l="561" char_id="-1" frame_id="-1" name="男子会員Ｂ"
		   text="『おら、さっさとどけって。次は俺の番なんだからよ！！』" voices=""/>
		<msg @l="563" char_id="-1" frame_id="-1" name="男子会員Ａ" text="『解ってるよ。』"
		   voices=""/>
		<msg @l="565" char_id="-1" frame_id="-1" name=""
		   text="言葉の無い私の事などはまったく気にもかけず、次の男が股間から性器を出し、私の眼前に差し出した。そして、それを私の顔に押し付けてくる。"
		   voices=""/>
		<msg @l="567" char_id="-1" frame_id="-1" name=""
		   text="陰茎の熱い感触が頬に伝わってきた。男はピタピタと振り子のように私の顔にソレを当てがい、早くしろと催促している。" voices=""/>
		<msg @l="568" char_id="-1" frame_id="-1" name=""
		   text="それから香る何ともいえない性臭に私は顔をしかめた。" voices=""/>
		<msg @l="570" char_id="-1" frame_id="-1" name=""
		   text="しかし、いくら私が懇願した所で、股間を大きく膨らましたこの男達は許してくれないだろう。そればかりか、私が変な態度を取ったら熊野の機嫌を損ね、ひいては玲さんに危害が及ぶかも知れない‥‥。それだけは避けたかった。"
		   voices=""/>
		<msg @l="572" char_id="-1" frame_id="-1" name=""
		   text="今はとにかく、この目の前にいる獣達のを奉仕し、そして熊野の満足のいく結果が出ることを望むしかない‥‥もう逃げるわけにはいかなかった。"
		   voices=""/>
		<msg @l="574" char_id="-1" frame_id="-1" name="男子会員Ｂ"
		   text="『さて‥‥ばっちりしゃぶってくれよ。』" voices=""/>
		<msg @l="576" char_id="0" frame_id="1" name="美帆" text="『‥‥はい。』"
		   voices="miho06010"/>
		<clear @l="582" class="all"/>
		<msgshow @l="584" show="true"/>
		<goto @l="587" cond="!(f.稲庭ルート即席02flag&#32;==&#32;1)&#13;&#10;"
		   label="TempLabel_309"/>
		<wait_chgmv/>
		<ev @l="591" src="ev-016x1z1"/>
		<goto @l="594" label="TempLabel_310"/>
		<label @l="595" id="TempLabel_309"/>
		<wait_chgmv/>
		<ev @l="600" src="ev-016x1z4"/>
		<label @l="603" id="TempLabel_310"/>
		<msg @l="606" char_id="0" frame_id="1" name="美帆" text="『ん、あむっ‥‥。』"
		   voices="miho06020"/>
		<msg @l="608" char_id="-1" frame_id="-1" name="男子会員Ｂ"
		   text="『おお、口ん中あったけぇ‥‥。』" voices=""/>
		<msg @l="610" char_id="-1" frame_id="-1" name=""
		   text="先端を咥えると、男は腰を震わせて歓喜の声を漏らす。" voices=""/>
		<msg @l="611" char_id="-1" frame_id="-1" name=""
		   text="私はそれを聞きながら‥‥複雑な心境で奉仕を始めた。" voices=""/>
		<msg @l="613" char_id="0" frame_id="1" name="美帆"
		   text="『んぷ‥‥んっ、んぐっ‥‥‥‥ちゅぷ、ちゅぷぷっ。』" voices="miho06030"/>
		<msg @l="615" char_id="-1" frame_id="-1" name=""
		   text="先端を口腔に含んで、舌先で唾液を塗っていく。" voices=""/>
		<msg @l="616" char_id="-1" frame_id="-1" name=""
		   text="教えられた通りのことをそのまま繰り返しているが、いくら我慢しても吐き気は止まらない。" voices=""/>
		<msg @l="618" char_id="-1" frame_id="-1" name="男子会員Ｂ"
		   text="『いいぜ、そのまま口の中に唾液溜めて頭動かしてみな。』" voices=""/>
		<msg @l="620" char_id="0" frame_id="1" name="美帆" text="『んむぅ‥‥んっ‥‥‥‥。』"
		   voices="miho06040"/>
		<msg @l="622" char_id="0" frame_id="1" name="美帆"
		   text="『んぐっ‥‥ちゅぷっ‥‥‥ちゅ、ちゅぷ‥‥‥‥ちゅぷぷぷっ。』" voices="miho06050"/>
		<msg @l="624" char_id="-1" frame_id="-1" name=""
		   text="口の中に唾液をいっぱいに溜めて、ゆっくりと頭を振る。" voices=""/>
		<msg @l="625" char_id="-1" frame_id="-1" name=""
		   text="こぼれそうになるそれを食い止めるため、唇を締め付けると、それに反応するように口腔内で怒張がひくんと跳ね上がった。" voices=""/>
		<msg @l="627" char_id="-1" frame_id="-1" name="男子会員Ｂ"
		   text="『そうそう‥‥いいよ、もっとやってくれ。』" voices=""/>
		<msg @l="629" char_id="0" frame_id="1" name="美帆"
		   text="『ちゅぷ‥‥んっ、んんっ‥‥‥んぷ、ちゅ、ちゅぷっ、ちゅぷっ。』" voices="miho06060"/>
		<msg @l="631" char_id="-1" frame_id="-1" name=""
		   text="頭を振り立てるたび、私の口元からは淫靡な水音が響く。" voices=""/>
		<msg @l="632" char_id="-1" frame_id="-1" name=""
		   text="それが恥ずかしくて仕方が無い私とは裏腹に咥えさせている男は満足げに口元を緩めていた。" voices=""/>
		<msg @l="634" char_id="0" frame_id="1" name="美帆"
		   text="『んぅ‥‥んっ、ちゅぷっ‥‥‥‥ちゅる、ちゅるるっ。』" voices="miho06070"/>
		<msg @l="636" char_id="0" frame_id="1" name="美帆"
		   text="『んっ、んっ、んっ‥‥‥‥ちゅぷ、んぅ‥‥‥‥‥んんんっ！』" voices="miho06080"/>
		<msg @l="638" char_id="-1" frame_id="-1" name="男子会員Ｂ"
		   text="『上手いぜ‥‥仲根‥‥オマエほんとに初めてか？』" voices=""/>
		<msg @l="640" char_id="0" frame_id="1" name="美帆" text="『んんぅっ‥‥。』"
		   voices="miho06090"/>
		<msg @l="642" char_id="-1" frame_id="-1" name=""
		   text="私は思わず口の動きを止めて首を縦に激しく振る。初めてじゃない‥なんて私にとっては信じられないくらい恥ずかしい言葉だった。"
		   voices=""/>
		<msg @l="644" char_id="-1" frame_id="-1" name="男子会員Ｂ"
		   text="『わかったから、そんなに怒るなって‥‥‥続けろよ。』" voices=""/>
		<msg @l="646" char_id="0" frame_id="1" name="美帆"
		   text="『ちゅむっ‥‥‥んっ、んぐっ‥‥‥んふっ、んっ、んっ、んっ。』" voices="miho06100"/>
		<msg @l="648" char_id="0" frame_id="1" name="美帆"
		   text="『ちゅぷ、ちゅぷ、ちゅぷ‥‥‥‥んぐ、ん、ちゅるるるっ。』" voices="miho06110"/>
		<msg @l="650" char_id="-1" frame_id="-1" name="男子会員Ｂ"
		   text="『くっ、すげー‥‥‥‥アンタ素質あるぜ？』" voices=""/>
		<msg @l="652" char_id="-1" frame_id="-1" name=""
		   text="こんな事に素質があっても全然嬉しくない。というより屈辱に近いものがある。" voices=""/>
		<msg @l="653" char_id="-1" frame_id="-1" name=""
		   text="恥辱に耐えながら私は、必死に男の肉棒をしゃぶった。" voices=""/>
		<msg @l="655" char_id="0" frame_id="1" name="美帆"
		   text="『んふっ、んっ、んっ‥‥‥ちゅぷっ‥‥‥じゅる、ちゅぷぷっ。』" voices="miho06120"/>
		<msg @l="657" char_id="-1" frame_id="-1" name=""
		   text="先端部分を甘く咥えなおし、敏感だとかいう先端の付け根を舐る。" voices=""/>
		<msg @l="659" char_id="-1" frame_id="-1" name="男子会員Ｂ"
		   text="『お、おおっ‥‥イイぜ仲根‥サイコーだ。お前の口はマ○コみたいですごくイイぜ。』" voices=""/>
		<msg @l="661" char_id="-1" frame_id="-1" name="男子会員Ｂ"
		   text="『口マ○コだな！仲根！！お前のあだ名は今日から「口マ○コ」だ！！ははっ‥‥っ』" voices=""/>
		<msg @l="663" char_id="0" frame_id="1" name="美帆" text="『んむぅ‥‥？』"
		   voices="miho06130"/>
		<msg @l="665" char_id="-1" frame_id="-1" name=""
		   text="とんでもないあだ名を付けられそうになり、私はイヤイヤをした。しかし、その行動がより男の性欲を掻きたてる事になるとは思いもよらなかった。"
		   voices=""/>
		<msg @l="667" char_id="-1" frame_id="-1" name="男子会員Ｂ"
		   text="『おおっ！イイぞ仲根っ！その顔がそそるなぁ。お前のかわいいお顔が俺のチ○ポで歪んでいるのが最高だっ。』" voices=""/>
		<msg @l="669" char_id="-1" frame_id="-1" name="男子会員Ｂ"
		   text="『それから、尿道も舐めろよ。俺は尿道を責められるのが好きなんだ』" voices=""/>
		<msg @l="671" char_id="-1" frame_id="-1" name=""
		   text="彼の好き好きなど私にはどうでもよかったが、ソコを舐めればこの苦しさから開放される‥と思った私は、渋々そこを舐める事にした。"
		   voices=""/>
		<msg @l="672" char_id="-1" frame_id="-1" name=""
		   text="しかし尿道がどこか解らない‥私は目で彼にどこがその場所なのかを聞いた。" voices=""/>
		<msg @l="674" char_id="-1" frame_id="-1" name="男子会員Ｂ"
		   text="『おっ！イイぜ。その上目使い。お前は本当に男のツボを知ってるなぁ‥エッチの才能あるぜ。』" voices=""/>
		<msg @l="676" char_id="-1" frame_id="-1" name=""
		   text="そんな才能なんかいらない‥と反論しようと思ったが、口は極太の肉で塞がれている。今しなくてはいけない事は、この男を早く射精させることだ‥と自分に言い聞かせ私は、再び目で彼に聞いてみた。"
		   voices=""/>
		<msg @l="678" char_id="-1" frame_id="-1" name="男子会員Ｂ"
		   text="『ああっ？尿道かぁ、それはな‥先っぽに穴が開いてんだろ？&#32;そこを舌先でチロチロとなめるんだ。』" voices=""/>
		<msg @l="680" char_id="0" frame_id="1" name="美帆"
		   text="『んっ‥‥んぅ、ちゅぷっ‥‥‥‥んむ、れろれろれろれろ。』" voices="miho06140"/>
		<msg @l="682" char_id="-1" frame_id="-1" name="男子会員Ｂ"
		   text="『く、それすげっ‥‥‥で、出るっ！！』" voices=""/>
		<flash @l="686" count="4" fade="100" image="white"/>
		<goto @l="689" cond="!(f.稲庭ルート即席02flag&#32;==&#32;1)&#13;&#10;"
		   label="TempLabel_311"/>
		<wait_chgmv/>
		<ev @l="693" src="ev-016x1z1z2"/>
		<msg @l="695" char_id="0" frame_id="1" name="美帆" text="『んはっっ！！』"
		   voices="miho06150"/>
		<msg @l="697" char_id="-1" frame_id="-1" name=""
		   text="男が腰を震わせ、私の口腔から肉棒を引き抜く。" voices=""/>
		<msg @l="698" char_id="-1" frame_id="-1" name=""
		   text="そうして自分で怒張を数回しごき上げると、大量の精液が噴出して私の顔を汚していった。" voices=""/>
		<goto @l="701" label="TempLabel_312"/>
		<label @l="702" id="TempLabel_311"/>
		<wait_chgmv/>
		<ev @l="707" src="ev-016z4z5"/>
		<msg @l="709" char_id="0" frame_id="1" name="美帆" text="『んむっっ！！』"
		   voices="miho06160"/>
		<msg @l="711" char_id="-1" frame_id="-1" name=""
		   text="肉棒の先端に這わせていた舌の上で、大量の精液が溢れ出す。" voices=""/>
		<msg @l="713" char_id="0" frame_id="1" name="美帆"
		   text="『んふっ‥‥んっ、んくっ‥‥‥んくっ‥‥‥‥ちゅぷ、ちゅぷぷ。』" voices="miho06170"/>
		<msg @l="715" char_id="-1" frame_id="-1" name=""
		   text="今度は注がれるそれに口腔を埋められてしまう前に、少しずつ喉奥へ運んで飲み下していった。生温かいモノがドロッと喉を通過する。眉に皺を寄せて、嘔吐感を我慢しながら飲み下した。"
		   voices=""/>
		<label @l="718" id="TempLabel_312"/>
		<clear @l="725" class="all"/>
		<msg @l="727" char_id="-1" frame_id="-1" name="男子会員Ｂ"
		   text="『ふぅ‥‥すげ、いっぱい出しちまったな。』" voices=""/>
		<msg @l="729" char_id="-1" frame_id="-1" name=""
		   text="そうしてすべての精液を出し終えると、咥えさせていた彼は早々に次の人と代わるべく立ちあがった。" voices=""/>
		<msg @l="730" char_id="-1" frame_id="-1" name=""
		   text="そして私は‥‥次に差し出された男根を口腔内へと素直に咥えこむしかなかった。" voices=""/>
		<clear @l="736" class="all"/>
		<msgshow @l="738" show="true"/>
		<goto @l="741" cond="!(f.稲庭ルート即席02flag&#32;==&#32;1)&#13;&#10;"
		   label="TempLabel_313"/>
		<wait_chgmv/>
		<ev @l="745" src="ev-016x1z1z2"/>
		<goto @l="748" label="TempLabel_314"/>
		<label @l="749" id="TempLabel_313"/>
		<wait_chgmv/>
		<ev @l="754" src="ev-016z4z5"/>
		<label @l="756" id="TempLabel_314"/>
		<msg @l="759" char_id="0" frame_id="1" name="美帆"
		   text="『ちゅぷ、んっ‥‥ちゅぷ、ちゅぷっ‥‥‥‥。』" voices="miho06180"/>
		<msg @l="761" char_id="-1" frame_id="-1" name="男子会員Ｃ"
		   text="『あ、ああっ‥‥いいよぉ‥‥‥‥。』" voices=""/>
		<msg @l="763" char_id="-1" frame_id="-1" name=""
		   text="口内で擦り上げられるたび、彼は腰を震わせて歓喜の声を漏らす。" voices=""/>
		<msg @l="764" char_id="-1" frame_id="-1" name=""
		   text="まだ咥えてからほんのわずかしか経っていないのに、彼のモノはもうガチガチである。" voices=""/>
		<msg @l="766" char_id="0" frame_id="1" name="美帆"
		   text="(うあ‥‥‥すご、もう出ちゃいそうになってる)" voices="miho06190"/>
		<msg @l="768" char_id="-1" frame_id="-1" name=""
		   text="私は彼の悦に拍車をかけるように、きゅっと唇を締めて先端のくびれを浅くしごき上げていった。" voices=""/>
		<msg @l="770" char_id="0" frame_id="1" name="美帆"
		   text="『んぷっ‥‥ん、ちゅぷっ‥‥‥ちゅぷ、ちゅぷ、ちゅぷっ。』" voices="miho06200"/>
		<msg @l="772" char_id="-1" frame_id="-1" name=""
		   text="アゴが疲れ、口の端からは絶えず白く泡だった唾液の筋がだらだらとたれ落ちていた。" voices=""/>
		<msg @l="774" char_id="-1" frame_id="-1" name="男子会員Ｃ"
		   text="『わ、わああっ‥‥‥そんなにされたらっ！』" voices=""/>
		<msg @l="776" char_id="0" frame_id="1" name="美帆"
		   text="『んっ‥‥‥んぐっ、ちゅぷ、ちゅぷぷっ、ちゅるるるっ。』" voices="miho06210"/>
		<msg @l="778" char_id="-1" frame_id="-1" name="男子会員Ｃ"
		   text="『あ、ああっ‥‥‥出ちゃう、出ちゃうよっ！』" voices=""/>
		<flash @l="782" count="4" fade="100" image="white"/>
		<goto @l="785" cond="!(f.稲庭ルート即席02flag&#32;==&#32;1)&#13;&#10;"
		   label="TempLabel_315"/>
		<wait_chgmv/>
		<ev @l="789" src="ev-016x1z1z2z3"/>
		<msg @l="791" char_id="0" frame_id="1" name="美帆" text="『ん、ふあっ！！』"
		   voices="miho06220"/>
		<msg @l="793" char_id="-1" frame_id="-1" name=""
		   text="私の顔に向けて男が射精をする。この男で3人目だ‥‥。" voices=""/>
		<msg @l="794" char_id="-1" frame_id="-1" name=""
		   text="もう私の顔は精液でドロドロで‥‥‥目を開けるのもやっとだった。" voices=""/>
		<msg @l="795" char_id="-1" frame_id="-1" name=""
		   text="その恥辱まみれな自分を思うと、涙が滲み出た。" voices=""/>
		<goto @l="798" label="TempLabel_316"/>
		<label @l="799" id="TempLabel_315"/>
		<wait_chgmv/>
		<ev @l="804" src="ev-016z4z5z6"/>
		<msg @l="806" char_id="0" frame_id="1" name="美帆"
		   text="『んんっ‥‥んっ‥‥‥‥‥んぐっ‥‥‥‥‥。』" voices="miho06230"/>
		<msg @l="808" char_id="0" frame_id="1" name="美帆"
		   text="『ちゅぷっ‥‥‥ちゅむ‥‥‥んっ、んんっ‥‥‥んく、んくっ。』" voices="miho06240"/>
		<msg @l="810" char_id="-1" frame_id="-1" name=""
		   text="射精の瞬間、私はきゅっと唇をすぼめてそれをうながす。" voices=""/>
		<msg @l="811" char_id="-1" frame_id="-1" name=""
		   text="そうして口腔に大量に流し込まれた精液を、ゆっくりと喉を鳴らして飲み下していった。汚濁の液体が喉を通過していくのを感じると涙が滲み出た。"
		   voices=""/>
		<label @l="814" id="TempLabel_316"/>
		<stopbgm @l="819" fadeout="1000"/>
		<clear @l="824" class="all"/>
		<end_scene @l="827"/>
		<wait_chgmv/>
		<bg @l="831" src="bg13a"/>
		<bgm @l="835" src="bgm15" volume="1."/>
		<char @l="838" id="miho" pos="auto" src="miho055"/>
		<msg @l="840" char_id="0" frame_id="1" name="美帆" text="『お、終わりました‥‥。』"
		   voices=""/>
		<msg @l="842" char_id="-1" frame_id="-1" name=""
		   text="長い長いフェラチオ奉仕が終わった時には既に日が傾いて夕方になっていた。" voices=""/>
		<msg @l="843" char_id="-1" frame_id="-1" name=""
		   text="私は大きく肩で息をしながら先輩の方を見た。" voices=""/>
		<msg @l="845" char_id="0" frame_id="1" name="美帆" text="『これで‥‥許してもらえますか？』"
		   voices=""/>
		<clear @l="848" class="char"/>
		<char @l="850" id="inaba" pos="left" src="inaba050"/>
		<char @l="852" id="miho" pos="right" src="miho055"/>
		<msg @l="854" char_id="-1" frame_id="-1" name="稲庭" text="『ああ、上出来だ。』"
		   voices=""/>
		<msg @l="856" char_id="-1" frame_id="-1" name=""
		   text="これで開放される‥‥私は疲労と安堵感の為、がくっと全身の力が抜けた。" voices=""/>
		<msg @l="858" char_id="-1" frame_id="-1" name="稲庭"
		   text="『仲根くん、最後に部室のほうへ寄ってくれないか？』" voices=""/>
		<msg @l="860" char_id="0" frame_id="1" name="美帆" text="『どういう事です？』" voices=""/>
		<msg @l="862" char_id="-1" frame_id="-1" name="稲庭"
		   text="『サークルの秘密を外部に漏らさないという誓約書を書いてもらいたいんだ。そのかわり僕も君に手出しをしないという誓約書を書く。』"
		   voices=""/>
		<msg @l="864" char_id="-1" frame_id="-1" name=""
		   text="安心しきっていた為か、私は稲庭先輩と一緒に部室へと向かう。" voices=""/>
		<msg @l="865" char_id="-1" frame_id="-1" name=""
		   text="まだ先輩のことを信じていたかったのだろうか、彼らがその気になればそんな紙切れなんて全く意味が無いのに‥‥。" voices=""/>
		<clear @l="872" class="all"/>
		<wait_chgmv/>
		<bg @l="875" src="bg14a"/>
		<char @l="878" id="inaba" pos="auto" src="inaba050"/>
		<msg @l="880" char_id="-1" frame_id="-1" name="稲庭" text="『さあ、入って。』"
		   voices=""/>
		<msg @l="882" char_id="-1" frame_id="-1" name="" text="先輩に促され、部室に入る。"
		   voices=""/>
		<msg @l="883" char_id="-1" frame_id="-1" name=""
		   text="見慣れた筈の部室なのに、なぜかまったく別の空間に感じられた。" voices=""/>
		<clear @l="886" class="char"/>
		<char @l="888" id="inaba" pos="center" src="inaba050f" y="-80"/>
		<stopbgm @l="890" fadeout="1000"/>
		<msg @l="893" char_id="-1" frame_id="-1" name="稲庭" text="『やっと二人きりになれたね。』"
		   voices=""/>
		<clear @l="896" class="char"/>
		<char @l="898" id="inaba" pos="left" src="inaba050"/>
		<char @l="900" id="miho" pos="right" src="miho054"/>
		<msg @l="902" char_id="0" frame_id="1" name="美帆" text="『はっ！？』" voices=""/>
		<bgm @l="905" src="bgm13" volume="1."/>
		<msg @l="907" char_id="-1" frame_id="-1" name=""
		   text="異様な雰囲気を感じた私はドアの方へ後ずさる‥‥しかし、鍵がかかっていて出られない！" voices=""/>
		<char @l="910" id="miho" pos="right" src="miho055"/>
		<msg @l="912" char_id="0" frame_id="1" name="美帆" text="『稲庭先輩、な、何を！？』"
		   voices=""/>
		<clear @l="915" class="char"/>
		<char @l="917" id="inaba" pos="center" src="inaba050f" y="-80"/>
		<msg @l="919" char_id="-1" frame_id="-1" name="稲庭" text="『ああ、すまない。』"
		   voices=""/>
		<stopbgm @l="922" fadeout="1000"/>
		<msg @l="924" char_id="-1" frame_id="-1" name="稲庭" text="『二人じゃなくて三人だった。』"
		   voices=""/>
		<clear @l="927" class="char"/>
		<se @l="930" buf="1" src="金属扉にモノを叩きつけた音" volume="1."/>
		<flash @l="932" count="4" fade="100" image="white"/>
		<shake @l="934" amp="10" class="all" cycle="30" duration="300" type="random"/>
		<msg @l="936" char_id="-1" frame_id="-1" name="" text="ドカッ！" voices=""/>
		<msg @l="938" char_id="-1" frame_id="-1" name="" text="そう言って先輩がいきなりロッカーを蹴る。"
		   voices=""/>
		<msg @l="939" char_id="-1" frame_id="-1" name=""
		   text="ロッカーのドアが開き、中に入っていた何かがこちらに倒れてきた。" voices=""/>
		<se @l="942" buf="1" src="人とぶつかる音" volume="1."/>
		<msg @l="944" char_id="-1" frame_id="-1" name="稲庭" text="『‥‥‥‥。』" voices=""/>
		<msg @l="946" char_id="0" frame_id="1" name="美帆" text="『玲さん！！』" voices=""/>
		<msg @l="949" char_id="-1" frame_id="-1" name=""
		   text="それは、両腕をロープで縛られ、口に猿轡をはめられた玲さんだった。" voices=""/>
		<msg @l="950" char_id="-1" frame_id="-1" name=""
		   text="私は転がされた玲さんの傍らに駆け寄り、半身を抱き起こす。" voices=""/>
		<msg @l="951" char_id="-1" frame_id="-1" name=""
		   text="かろうじて‥‥息をしているといった感じだ。" voices=""/>
		<bgm @l="954" src="bgm09" volume="1."/>
		<char @l="957" id="inaba" pos="auto" src="inaba050"/>
		<msg @l="959" char_id="-1" frame_id="-1" name="稲庭" text="『仲根くんが悪いんだよ。』"
		   voices=""/>
		<clear @l="962" class="char"/>
		<char @l="964" id="inaba" pos="left" src="inaba050"/>
		<char @l="966" id="miho" pos="right" src="miho055"/>
		<msg @l="968" char_id="0" frame_id="1" name="美帆"
		   text="『な、何をそんな！玲さんにこんな非道い事をしているのに。』" voices=""/>
		<msg @l="970" char_id="-1" frame_id="-1" name="稲庭"
		   text="『玲に今日の事を教えただろう？彼女、運悪くレイプの現場に鉢合わせちゃって、訴えるとか何とかうるさかったからね‥‥ちょっと大人しくしてもらったんだ。』"
		   voices=""/>
		<msg @l="972" char_id="-1" frame_id="-1" name="稲庭"
		   text="『僕は処女以外には割と遠慮が無いのでね‥‥多少手荒くなってしまったよ。』" voices=""/>
		<msg @l="973" char_id="-1" frame_id="-1" name=""
		   text="私が見た限り、手荒いで済む程度のけがとは到底思えなかった。" voices=""/>
		<msg @l="974" char_id="-1" frame_id="-1" name="" text="外傷よりも内臓や骨の方が心配だ。"
		   voices=""/>
		<msg @l="976" char_id="0" frame_id="1" name="美帆"
		   text="『私があなたの相手をします。だから、玲さんを助けてください！』" voices=""/>
		<clear @l="979" class="char"/>
		<char @l="981" id="inaba" pos="center" src="inaba050f" y="-80"/>
		<msg @l="983" char_id="-1" frame_id="-1" name="稲庭" text="『その言葉を待っていたよ。』"
		   voices=""/>
		<msg @l="985" char_id="-1" frame_id="-1" name="" text="稲庭先輩が突然首だけをこちらに向ける。"
		   voices=""/>
		<clear @l="988" class="char"/>
		<char @l="990" id="miho" pos="auto" src="miho055"/>
		<msg @l="992" char_id="0" frame_id="1" name="美帆" text="『ど、どういう事ですか。』"
		   voices=""/>
		<clear @l="995" class="char"/>
		<char @l="997" id="inaba" pos="left" src="inaba050"/>
		<char @l="999" id="miho" pos="right" src="miho055"/>
		<msg @l="1001" char_id="-1" frame_id="-1" name="稲庭"
		   text="『僕は女性を無理やり犯すような真似は嫌いでね。君から言い出してくれるのを待っていたんだよ。』" voices=""/>
		<msg @l="1003" char_id="0" frame_id="1" name="美帆"
		   text="『そんなっ‥‥よくそんな事をぬけぬけと。』" voices=""/>
		<msg @l="1005" char_id="-1" frame_id="-1" name="稲庭"
		   text="『でも、こうして君は自分から相手をすると言い出した。』" voices=""/>
		<msg @l="1007" char_id="0" frame_id="1" name="美帆" text="『くぅっ！』" voices=""/>
		<clear @l="1010" class="char"/>
		<char @l="1012" id="inaba" pos="center" src="inaba054f" y="-80"/>
		<msg @l="1014" char_id="-1" frame_id="-1" name="稲庭"
		   text="『まだ君は自分の立場がわかってないようだね。』" voices=""/>
		<msg @l="1016" char_id="-1" frame_id="-1" name=""
		   text="稲庭先輩が玲さんの腹部に足を置き、グリグリと動かす。" voices=""/>
		<msg @l="1017" char_id="-1" frame_id="-1" name=""
		   text="先輩の足の動きに合わせて玲さんは苦しげにうめいた。" voices=""/>
		<clear @l="1020" class="char"/>
		<char @l="1022" id="miho" pos="auto" src="miho055"/>
		<msg @l="1024" char_id="0" frame_id="1" name="美帆" text="『やめてっ！』" voices=""/>
		<clear @l="1027" class="char"/>
		<char @l="1029" id="inaba" pos="center" src="inaba050f" y="-80"/>
		<msg @l="1031" char_id="-1" frame_id="-1" name="稲庭"
		   text="『それはつまり、君は僕の事が好きで、僕に犯されたい‥‥そういう事でいいんだね？』" voices=""/>
		<msg @l="1033" char_id="-1" frame_id="-1" name=""
		   text="確かに以前は、稲庭先輩の事は好きだったと思う。" voices=""/>
		<msg @l="1034" char_id="-1" frame_id="-1" name=""
		   text="しかし今、目の前にいるのは稲庭先輩の顔をした悪魔なのだ。" voices=""/>
		<msg @l="1035" char_id="-1" frame_id="-1" name=""
		   text="そんな男に自ら望んで犯されなければならない屈辱に、私は一瞬顔をそむけた。" voices=""/>
		<char @l="1037" id="inaba" pos="center" src="inaba054f" y="-80"/>
		<msg @l="1039" char_id="-1" frame_id="-1" name="稲庭" text="『ちがうのかい？』"
		   voices=""/>
		<msg @l="1041" char_id="-1" frame_id="-1" name=""
		   text="そう優しく語りかけながら、稲庭先輩はつま先で玲さんのわき腹あたりを小刻みに突付いている。" voices=""/>
		<msg @l="1042" char_id="-1" frame_id="-1" name=""
		   text="アバラが折れているのか、玲さんは体中を震わせて痙攣した。" voices=""/>
		<msg @l="1044" char_id="1" frame_id="-1" name="玲" text="『うっ‥‥ううっ！』"
		   voices=""/>
		<clear @l="1047" class="char"/>
		<char @l="1049" id="miho" pos="auto" src="miho055"/>
		<msg @l="1051" char_id="0" frame_id="1" name="美帆"
		   text="『やめてっ！やめてください！犯されたいです！あなたに犯されたいです！』" voices=""/>
		<msg @l="1053" char_id="-1" frame_id="-1" name=""
		   text="それを聞いた稲庭先輩は玲さんから足を離す。" voices=""/>
		<msg @l="1054" char_id="-1" frame_id="-1" name=""
		   text="責め苦から開放された玲さんはぐったりしたまま荒い呼吸を繰り返している。" voices=""/>
		<clear @l="1057" class="char"/>
		<char @l="1059" id="inaba" pos="center" src="inaba050f" y="-80"/>
		<msg @l="1061" char_id="-1" frame_id="-1" name="稲庭" text="『つまり、僕に処女を捧げたいと？』"
		   voices=""/>
		<clear @l="1064" class="char"/>
		<char @l="1066" id="miho" pos="auto" src="miho055"/>
		<msg @l="1068" char_id="0" frame_id="1" name="美帆" text="『は、はい‥‥捧げます。』"
		   voices=""/>
		<clear @l="1071" class="char"/>
		<char @l="1073" id="inaba" pos="center" src="inaba050f" y="-80"/>
		<msg @l="1075" char_id="-1" frame_id="-1" name="稲庭"
		   text="『僕のモノで処女膜をブチ抜かれたいと？』" voices=""/>
		<clear @l="1078" class="char"/>
		<char @l="1080" id="miho" pos="auto" src="miho055"/>
		<msg @l="1082" char_id="0" frame_id="1" name="美帆"
		   text="『‥‥はい、私の処女膜を‥‥破って‥‥ください。』" voices=""/>
		<msg @l="1084" char_id="-1" frame_id="-1" name=""
		   text="先輩は満足したように口の端をゆがめると、足元の玲さんの方を向きじっと何かを観察していた。" voices=""/>
		<clear @l="1087" class="char"/>
		<char @l="1089" id="inaba" pos="center" src="inaba054f" y="-80"/>
		<msg @l="1091" char_id="-1" frame_id="-1" name="稲庭" text="『玲、君はもう用なしだ。』"
		   voices=""/>
		<msg @l="1093" char_id="-1" frame_id="-1" name=""
		   text="そう言うと稲庭先輩は足の裏で玲さんの身体を押し、乱暴に転がす。" voices=""/>
		<msg @l="1094" char_id="-1" frame_id="-1" name=""
		   text="先輩が錠剤を何錠もまとめてボリボリと噛み砕くと、さっき以上に全身の筋肉が隆起し、股間の盛り上がりが更に力を増した。"
		   voices=""/>
		<clear @l="1097" class="char"/>
		<char @l="1099" id="miho" pos="auto" src="miho055"/>
		<msg @l="1101" char_id="0" frame_id="1" name="美帆" text="『ひ、ひいっ！』" voices=""/>
		<clear @l="1104" class="char"/>
		<msg @l="1106" char_id="-1" frame_id="-1" name=""
		   text="覚悟を決めたとはいえ、狂気に歪んだ先輩の瞳を直視した私は全身の力が抜け、その場にへたりこんだ。" voices=""/>
		<char @l="1109" id="inaba" pos="center" src="inaba058f" y="-80"/>
		<msg @l="1111" char_id="-1" frame_id="-1" name="稲庭"
		   text="『いいっ！その表情！その仕草！その肉体！僕の求めていたものが今、目の前にあるんだ！』" voices=""/>
		<msg @l="1113" char_id="-1" frame_id="-1" name="稲庭" text="『あははははははっ！』"
		   voices=""/>
		<stopbgm @l="1117" fadeout="1000"/>
		<label @l="1121" id="chart_line77"/>
		<call @l="1125" target="EventLabel_98@root_inaba_c_ev01"/>
		<stopbgm @l="1129" fadeout="1000"/>
		<clear @l="1135" class="all"/>
		<wait_chgmv/>
		<bg @l="1139" src="bg14b"/>
		<msg @l="1141" char_id="0" frame_id="1" name="美帆" text="『ん‥‥。』" voices=""/>
		<msg @l="1143" char_id="0" frame_id="1" name="美帆" text="『あれ‥‥‥わたし‥‥‥‥。』"
		   voices=""/>
		<msg @l="1145" char_id="-1" frame_id="-1" name=""
		   text="遠退いていた意識が、ふとした瞬間に覚醒する。" voices=""/>
		<msg @l="1146" char_id="-1" frame_id="-1" name=""
		   text="視界に飛び込んできたのはテニスサークルの部室で‥‥。" voices=""/>
		<msg @l="1147" char_id="-1" frame_id="-1" name=""
		   text="ならば先ほどまでの出来事はすべて夢だったのかと思い、安堵のため息を吐こうとしたその時、私の視界に力なく横たわっている稲庭先輩の姿が映る。"
		   voices=""/>
		<bgm @l="1151" src="bgm15" volume="1."/>
		<msg @l="1153" char_id="0" frame_id="1" name="美帆" text="『せ、せんぱいっ！？』"
		   voices=""/>
		<msg @l="1155" char_id="-1" frame_id="-1" name=""
		   text="私は恐る恐る身を起こして、先輩の傍らににじり寄ろうとした。" voices=""/>
		<msg @l="1156" char_id="-1" frame_id="-1" name=""
		   text="しかし、それだけで身体が軋んで、とても立って歩くなんて事は出来そうになかった。" voices=""/>
		<msg @l="1157" char_id="-1" frame_id="-1" name=""
		   text="先ほど引き裂かれたそこを見ると‥‥破瓜の証である赤い血がしっかりと流れており、私の太ももへと筋を作っていた。" voices=""/>
		<msg @l="1158" char_id="-1" frame_id="-1" name=""
		   text="やはり‥‥夢などではなかったということだ。" voices=""/>
		<msg @l="1160" char_id="0" frame_id="1" name="美帆" text="『先輩、大丈夫ですかっ‥‥‥先輩っ！』"
		   voices=""/>
		<msg @l="1162" char_id="-1" frame_id="-1" name="稲庭" text="『ぅ‥‥あぁ‥ぁ‥‥。』"
		   voices=""/>
		<msg @l="1164" char_id="-1" frame_id="-1" name=""
		   text="稲庭先輩は私の呼びかけにも反応が無く、目を開く気配は無かった。" voices=""/>
		<msg @l="1165" char_id="-1" frame_id="-1" name="" text="例の薬が原因なのだろうか。"
		   voices=""/>
		<char @l="1168" id="kuma" pos="center" src="kuma017f" y="-80"/>
		<msg @l="1170" char_id="-1" frame_id="-1" name="熊野"
		   text="『先ほど己をあれだけ乱暴に犯した男の心配とは、まったく見上げたお人好しだな。』" voices=""/>
		<msg @l="1172" char_id="-1" frame_id="-1" name="" text="熊野さんが突然現れた。"
		   voices=""/>
		<msg @l="1173" char_id="-1" frame_id="-1" name=""
		   text="先ほどとは口調ががらっと変わり、そのせいか全体の雰囲気も粗暴なものに感じる。" voices=""/>
		<clear @l="1176" class="char"/>
		<char @l="1178" id="kuma" pos="auto" src="kuma012"/>
		<msg @l="1181" char_id="-1" frame_id="-1" name="熊野"
		   text="『たいした偽善だな。お前達にとっては、このまま死んでもらった方が都合がいいんじゃないのか。』" voices=""/>
		<clear @l="1184" class="char"/>
		<char @l="1186" id="kuma" pos="auto" src="kuma012"/>
		<msg @l="1190" char_id="0" frame_id="1" name="美帆"
		   text="『ま‥‥‥まさか‥‥‥稲庭先輩‥‥‥死‥‥‥。』" voices=""/>
		<msg @l="1192" char_id="-1" frame_id="-1" name="熊野"
		   text="『安心しろ、仮死状態になっているだけだ‥‥薬の反動でな。こいつが言ってただろ？薬をのみつづけないとこうなっちまうのさ。』"
		   voices=""/>
		<msg @l="1194" char_id="-1" frame_id="-1" name="熊野"
		   text="『今まで欠かすことは無かったのに、今回に限ってお前を犯すのに夢中で忘れちまった‥‥たいした肉体だよ。』" voices=""/>
		<msg @l="1196" char_id="-1" frame_id="-1" name=""
		   text="ニヤニヤと笑いながら、熊野は私の裸を舐めるように見る。" voices=""/>
		<msg @l="1199" char_id="0" frame_id="1" name="美帆"
		   text="『なっ‥‥何を言ってるんですか！？&#32;そんな‥‥‥。』" voices=""/>
		<msg @l="1201" char_id="-1" frame_id="-1" name="熊野"
		   text="『まあ‥‥本当かどうかはすぐにわかる。』" voices=""/>
		<msg @l="1203" char_id="-1" frame_id="-1" name=""
		   text="熊野がそう言って片手を上げると、部室の外に待機していた男子部員たちがわらわらと部室内に入ってくる。" voices=""/>
		<msg @l="1204" char_id="-1" frame_id="-1" name="" text="部室内には‥‥玲さんがいなかった。"
		   voices=""/>
		<msg @l="1207" char_id="0" frame_id="1" name="美帆" text="『な‥‥なにを‥‥‥？』"
		   voices=""/>
		<msg @l="1209" char_id="-1" frame_id="-1" name="熊野"
		   text="『いままで何百人と処女を食ってきた稲庭が見込んだだけあって、お前は素晴らしい肉体を持っている。』" voices=""/>
		<msg @l="1211" char_id="-1" frame_id="-1" name="熊野"
		   text="『そこで‥‥この町の仕組みに則ってお前を最高の”町の女性”にする為に調教しようと思う。』" voices=""/>
		<msg @l="1213" char_id="0" frame_id="1" name="美帆"
		   text="『町の仕組み‥‥‥調教って‥‥‥‥‥？』" voices=""/>
		<msg @l="1215" char_id="-1" frame_id="-1" name="熊野"
		   text="『質問が多いな‥‥‥お前はもう何処にも逃げられない。黙って私に従えば痛い目に合わずに済む。』" voices=""/>
		<msg @l="1217" char_id="0" frame_id="1" name="美帆" text="『そ、そんな‥‥‥。』"
		   voices=""/>
		<msg @l="1219" char_id="-1" frame_id="-1" name="熊野"
		   text="『そうそう‥‥この者たちには稲庭の薬を改良した新薬を飲ませてある。』" voices=""/>
		<msg @l="1221" char_id="0" frame_id="1" name="美帆" text="『ひっ‥‥！！』" voices=""/>
		<msg @l="1223" char_id="-1" frame_id="-1" name=""
		   text="よく見ると、男子部員の彼らはみな一様に表情が虚ろだ。" voices=""/>
		<msg @l="1225" char_id="-1" frame_id="-1" name="熊野"
		   text="『テニス部の女達を犯していた時もこいつら少しおかしかっただろ？&#32;その新薬の影響だ。』" voices=""/>
		<msg @l="1227" char_id="-1" frame_id="-1" name="熊野"
		   text="『この新薬は稲庭のとは違い、セックス用に調整されている。』" voices=""/>
		<msg @l="1229" char_id="-1" frame_id="-1" name="熊野"
		   text="『肉体は強化されないが、そのかわり精液に媚薬成分が含まれるようになる特別製だ。安心して犯されるがいい。』" voices=""/>
		<clear @l="1232" class="char"/>
		<msg @l="1234" char_id="0" frame_id="1" name="美帆" text="『そんな‥‥‥きゃあっ！？』"
		   voices=""/>
		<msg @l="1236" char_id="-1" frame_id="-1" name="男子会員Ａ" text="『‥‥‥‥。』"
		   voices=""/>
		<msg @l="1238" char_id="-1" frame_id="-1" name="男子会員Ｂ" text="『‥‥‥‥。』"
		   voices=""/>
		<msg @l="1240" char_id="-1" frame_id="-1" name=""
		   text="私の手を、それぞれ両脇から男子サークル員二人が掴む。" voices=""/>
		<msg @l="1242" char_id="-1" frame_id="-1" name="熊野"
		   text="『ああ、言い忘れていたが、彼らは薬によって覚醒したばかりなので性欲は普通の人間の数十倍だ。たっぷりと嬲ってもらうといい。』"
		   voices=""/>
		<msg @l="1244" char_id="0" frame_id="1" name="美帆" text="『ひっ‥‥。』" voices=""/>
		<msg @l="1246" char_id="0" frame_id="1" name="美帆"
		   text="『いやああああああああああああっ！！！』" voices=""/>
		<stopbgm @l="1250" fadeout="1000"/>
		<clear @l="1256" class="all"/>
		<call @l="1260" target="EventLabel_99@root_inaba_c_ev02"/>
		<call @l="1262" target="EventLabel_50@ending12"/>
		<return @l="1263" value="0&#13;&#10;"/>
		<return @l="1266" value=""/>
	</code>
</xscript>
