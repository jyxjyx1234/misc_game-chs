<?xml version="1.0" encoding="utf-8"?>
<xscript>
	<debug editor="&quot;C:\Program&#32;Files&#32;(x86)\sakura\sakura.exe&quot;&#32;&quot;%src%&quot;&#32;-Y=%line%"
	   src="D:\シロップ\町ぐるみの罠＋汚された夏セット版\汚された夏\完成データ\汚された夏\script\text\root_akina_c_ev01.txt"/>
	<code>
		<label @l="13" id="EventLabel_82"/>
		<label @l="16" id="event_scene50"/>
		<wait_chgmv/>
		<bg @l="20" src="bg11"/>
		<bgm @l="24" src="bgm10" volume="1."/>
		<description @l="27" text="過去の反芻"/>
		<msg @l="29" char_id="0" frame_id="-1" name="美帆" text="『んぁ‥‥いたっ‥‥‥。』"
		   voices="miho01820"/>
		<msg @l="31" char_id="-1" frame_id="-1" name="" text="下腹部から鋭い痛みが駆け上がる。"
		   voices=""/>
		<msg @l="32" char_id="-1" frame_id="-1" name=""
		   text="暗く沈んでいだ私の意識が、無理やりに明るい世界へと引き戻された。" voices=""/>
		<msg @l="33" char_id="-1" frame_id="-1" name="" text="割れ鐘を打ち鳴らすみたいな頭痛を感じる。"
		   voices=""/>
		<msg @l="34" char_id="-1" frame_id="-1" name="" text="それに‥‥･･、" voices=""/>
		<msg @l="35" char_id="-1" frame_id="-1" name="" text="身体の総てがやけに重い･･････。"
		   voices=""/>
		<msg @l="37" char_id="-1" frame_id="-1" name="声" text="『おや、お目覚めのようですな。』"
		   voices=""/>
		<msg @l="38" char_id="-1" frame_id="-1" name=""
		   text="喉の奥に痰が絡んでる様な粘ついた声･･････。" voices=""/>
		<msg @l="39" char_id="-1" frame_id="-1" name=""
		   text="どろんと濁った私の耳にも不快な声に、状況を確認しようと頭を巡らす。" voices=""/>
		<msg @l="41" char_id="0" frame_id="-1" name="美帆" text="『あれ‥‥わたし‥‥‥‥？』"
		   voices="miho01830"/>
		<msg @l="43" char_id="-1" frame_id="-1" name="声"
		   text="『騒がれるのは嫌だったのでね････、お休みのうちに、始めさせてもらったよ････。』" voices=""/>
		<msg @l="45" char_id="0" frame_id="-1" name="美帆" text="『え‥‥？』"
		   voices="miho01840"/>
		<wait_chgmv/>
		<ev @l="49" src="ev-050y1"/>
		<bgm @l="52" src="bgm14" volume="1."/>
		<msg @l="54" char_id="0" frame_id="-1" name="美帆" text="『あ、んくっ！？』"
		   voices="miho01850"/>
		<msg @l="56" char_id="-1" frame_id="-1" name=""
		   text="慌てて半身を起こしかけ、私は意識の覚醒を促した、あの下腹部の痛みの意味を知った。" voices=""/>
		<msg @l="57" char_id="-1" frame_id="-1" name="" text="私の身体の奥深くには‥‥･･、"
		   voices=""/>
		<msg @l="58" char_id="-1" frame_id="-1" name=""
		   text="渡部の凶暴な屹立が、深く穿たれているのだった･･････。" voices=""/>
		<msg @l="60" char_id="0" frame_id="-1" name="美帆"
		   text="『なにこれ、どうしてっ‥‥‥‥あぐっ！！』" voices="miho01860"/>
		<msg @l="62" char_id="-1" frame_id="-1" name="熊野"
		   text="『おやおや‥‥どこへ行かれる気ですか？』" voices=""/>
		<msg @l="64" char_id="-1" frame_id="-1" name=""
		   text="後ずさろうとした瞬間、熊野とかいう用務員が、私の身体を押さえつける。" voices=""/>
		<msg @l="65" char_id="-1" frame_id="-1" name=""
		   text="熊野は薄笑いを浮かべながらにも係わらず、私は身動ぎ一つ出来なくなった。" voices=""/>
		<msg @l="66" char_id="-1" frame_id="-1" name=""
		   text="後退を封じた力の強さは、見た目の脆弱な感じから、とても想像が及ばない。" voices=""/>
		<msg @l="68" char_id="0" frame_id="-1" name="美帆" text="『やっ‥‥は、離してくださいっ！』"
		   voices="miho01870"/>
		<msg @l="70" char_id="-1" frame_id="-1" name="渡部"
		   text="『なぁにを、ネンネちゃんみてぇにやってやがんだ？‥‥おめぇはもうオトコを知ってんだ････今さら逃げなくたっていいだろうが。』"
		   voices=""/>
		<msg @l="72" char_id="0" frame_id="-1" name="美帆" text="『そんな事っ‥‥‥んんっ！！』"
		   voices="miho01880"/>
		<msg @l="74" char_id="-1" frame_id="-1" name="" text="突然、渡部が激しく腰を打ち付けてくる。"
		   voices=""/>
		<msg @l="75" char_id="-1" frame_id="-1" name=""
		   text="私を抉る太い肉が、動きと共に深へと凶暴に打ち込まれる。" voices=""/>
		<msg @l="76" char_id="-1" frame_id="-1" name=""
		   text="刻まれたばかりの破瓜の傷が渡部の兇器に擦り上げられ、再び私を引き裂く様な激痛が襲った。" voices=""/>
		<msg @l="78" char_id="-1" frame_id="-1" name="渡部"
		   text="『三年越しの恋だったんだろ？‥‥すっかり待たせちまった分も、俺がちゃんと楽しませてやるから悦びなって･･････。』"
		   voices=""/>
		<msg @l="79" char_id="-1" frame_id="-1" name=""
		   text="自分勝手なストーリーを口にしながら、渡部は激しく私の身体を突き上げる。" voices=""/>
		<msg @l="81" char_id="0" frame_id="-1" name="美帆"
		   text="『んあっ‥‥ん、んんっ‥‥‥‥い、ああっ！！』" voices="miho01890"/>
		<msg @l="83" char_id="-1" frame_id="-1" name=""
		   text="そんな渡部が私の傷ついた胎内を掻き回す度、痛みと恥辱が身体の芯を熱く染める。" voices=""/>
		<msg @l="84" char_id="-1" frame_id="-1" name=""
		   text="どうにもできない屈辱の中、絶望とは決して一致しない奇妙な熱が、私の奥から湧き上がった。" voices=""/>
		<msg @l="85" char_id="-1" frame_id="-1" name=""
		   text="膣内の傷が、乱暴にされて熱を帯びて‥‥･･、" voices=""/>
		<msg @l="87" char_id="-1" frame_id="-1" name="" text="私は必死にそう思いながら･･････、"
		   voices=""/>
		<msg @l="88" char_id="-1" frame_id="-1" name=""
		   text="奇妙な火照りは、それと違っている事をも感じ始めた･･････。" voices=""/>
		<msg @l="90" char_id="0" frame_id="-1" name="美帆"
		   text="『いや‥‥なにこれ‥‥何か、変な感じがする‥‥‥‥。』" voices="miho01900"/>
		<msg @l="92" char_id="-1" frame_id="-1" name="熊野"
		   text="『ああ、やっと薬の効き目が出てきたのでしょうな。』" voices=""/>
		<msg @l="94" char_id="0" frame_id="-1" name="美帆" text="『くすりって‥‥まさかっ‥‥‥。』"
		   voices="miho01910"/>
		<msg @l="96" char_id="-1" frame_id="-1" name="渡部"
		   text="『くくっ････いいカンしてんな、お前････。想像どおりだよ、ご名答ってヤツだ。亜季奈だけじゃ不公平だろ？お前にもちゃんと使ってやったぜ？』"
		   voices=""/>
		<goto @l="99" cond="!(f.留学生に抵抗したflag&#32;==&#32;1)&#13;&#10;"
		   label="TempLabel_216"/>
		<msg @l="101" char_id="-1" frame_id="-1" name=""
		   text="感心でもしてるみたいな熊野の表情･･････。" voices=""/>
		<msg @l="102" char_id="-1" frame_id="-1" name=""
		   text="喜びでもしてるみたいな渡部の声色･･････。" voices=""/>
		<msg @l="103" char_id="-1" frame_id="-1" name=""
		   text="それで私は、自分に湧いた異様な高揚の正体を知った。" voices=""/>
		<msg @l="104" char_id="-1" frame_id="-1" name=""
		   text="私が感じる浮かされた熱さをもたらしているのは･･････、" voices=""/>
		<msg @l="105" char_id="-1" frame_id="-1" name=""
		   text="多分･･････、渡部が亜季奈に使ったという‥‥･･あの薬だ。" voices=""/>
		<msg @l="106" char_id="-1" frame_id="-1" name=""
		   text="亜季奈をあんな風にしてしまった狂気の産物が私にも‥‥･･。" voices=""/>
		<msg @l="110" char_id="-1" frame_id="-1" name="渡部"
		   text="『マク、ブチ破られてもイキまくれるって、高性能品だぞ？』" voices=""/>
		<msg @l="112" char_id="0" frame_id="-1" name="美帆" text="『そんなっ‥‥ヒドイ‥‥‥‥‥。』"
		   voices="miho01920"/>
		<msg @l="114" char_id="-1" frame_id="-1" name="渡部"
		   text="『日本語間違ってねぇか？････「嬉しい」って言えや。、お前だって痛ぇより気持ちいい方がいいだろ？感謝ってのはよ････できる時にちゃんとしとくのが、日本人の美徳だろうが････そうだろ？』"
		   voices=""/>
		<msg @l="115" char_id="-1" frame_id="-1" name=""
		   text="呆れ果てる事しかできない言葉を口にして、渡部は大仰にゲラゲラと嗤った。" voices=""/>
		<msg @l="117" char_id="-1" frame_id="-1" name="渡部"
		   text="『それによ････クスリなしじゃ、お前、苦しくってアワ吹いちまうぞ？俺はキッツイのがお好みなんでな。』" voices=""/>
		<msg @l="119" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』"
		   voices="miho01930"/>
		<goto @l="122" label="TempLabel_217"/>
		<label @l="123" id="TempLabel_216"/>
		<msg @l="126" char_id="-1" frame_id="-1" name="熊野"
		   text="『麻薬ではありませんから、ご安心なさい。』" voices=""/>
		<msg @l="127" char_id="-1" frame_id="-1" name=""
		   text="言葉を失っている私のそばで、熊野が厭味ったらしく、慇懃無礼に口を挟んだ。" voices=""/>
		<msg @l="129" char_id="-1" frame_id="-1" name="熊野"
		   text="『ある薬からの副産物ではあるのですが‥‥。････少々、効果が強すぎて商品としては、売り出せなかったというだけです。』"
		   voices=""/>
		<msg @l="131" char_id="0" frame_id="-1" name="美帆" text="『こんなことして‥‥ヒドイ‥‥。』"
		   voices="miho01940"/>
		<msg @l="133" char_id="-1" frame_id="-1" name="熊野"
		   text="『非道い？･･いや、酷い････ですか？別に構わないじゃありませんか‥‥。ここはそうした町なんですから････。あなただって、ここの住人になったのでしょう？････郷に入らば郷に従うのが、理性ある大人の遣り方ですよ？』"
		   voices=""/>
		<msg @l="135" char_id="0" frame_id="-1" name="美帆" text="『え‥‥。』"
		   voices="miho01950"/>
		<label @l="138" id="TempLabel_217"/>
		<msg @l="141" char_id="-1" frame_id="-1" name="渡部"
		   text="『まぁ、細かい話なんざ、どうだっていいじゃねぇか。‥‥何にしたって俺たちゃこうやって、互いのカラダを貪りまくれるカンケーなんだしよ････。』"
		   voices=""/>
		<msg @l="143" char_id="-1" frame_id="-1" name=""
		   text="熊野の笑みに面倒臭そうに眉を顰め、渡部は激しく腰を律動させる。" voices=""/>
		<msg @l="144" char_id="-1" frame_id="-1" name=""
		   text="私の頭に、一瞬、熊野の言葉が引っ掛かったが、渡部がもたらす獰猛な性が、それすら容易く押し流す。" voices=""/>
		<msg @l="145" char_id="-1" frame_id="-1" name=""
		   text="渡部に大きく押し拡げられ、為す術なく蹂躙されるその部分に、私の意識は集中した。" voices=""/>
		<msg @l="147" char_id="0" frame_id="-1" name="美帆"
		   text="『んぁっ、んっ、んっ、んっ‥‥‥んくっっ！！』" voices="miho01960"/>
		<msg @l="149" char_id="0" frame_id="-1" name="美帆"
		   text="(嫌なのに‥‥私‥‥‥‥‥こんなの嫌なのに、なんで‥‥‥‥‥)" voices="miho01970"/>
		<msg @l="151" char_id="-1" frame_id="-1" name=""
		   text="身体を内部から裂かれる様な、鋭い痛みが結合部の奥にぶり返す。" voices=""/>
		<msg @l="152" char_id="-1" frame_id="-1" name="" text="それなのに･･････、"
		   voices=""/>
		<msg @l="153" char_id="-1" frame_id="-1" name=""
		   text="痛みは渡部の律動の度に段々と薄れ‥‥･･、" voices=""/>
		<msg @l="154" char_id="-1" frame_id="-1" name="" text="うやむやになって行くような気がする。"
		   voices=""/>
		<msg @l="155" char_id="-1" frame_id="-1" name=""
		   text="深部を侵される痛み以外の「得体の知れない熱い何か」が、私の苦痛に取って代わる‥‥･･。" voices=""/>
		<msg @l="156" char_id="-1" frame_id="-1" name="" text="･･････悔しい･･････。"
		   voices=""/>
		<msg @l="157" char_id="-1" frame_id="-1" name=""
		   text="征服欲を剥き出しにする、渡部の野卑な情動が、私の芯を粘ついた桜に染め始める。" voices=""/>
		<msg @l="158" char_id="-1" frame_id="-1" name=""
		   text="蹂躙されてる筈なのに、意に反した反応さえも見せ始めた自分の身体に、吐き気を覚えて涙ぐんだ。" voices=""/>
		<msg @l="160" char_id="-1" frame_id="-1" name="渡部"
		   text="『流石に、さっきまで膜付きだっただけはあるじゃねぇか････。』" voices=""/>
		<msg @l="162" char_id="-1" frame_id="-1" name="渡部"
		   text="『突き込む度に････絡んでくるぞ？････お前にもこのぐちゃぐちゃって音････聞えんだろ？』" voices=""/>
		<msg @l="164" char_id="0" frame_id="-1" name="美帆"
		   text="『うぐっ‥‥や、やめてください‥‥‥こんな‥‥‥‥‥。』" voices="miho01980"/>
		<msg @l="166" char_id="0" frame_id="-1" name="美帆"
		   text="『んっ‥‥‥‥ふあっ‥‥あっ‥‥あっ‥‥あっ‥‥あぁっ‥‥‥。』" voices="miho01990"/>
		<msg @l="168" char_id="-1" frame_id="-1" name="渡部"
		   text="『うっひょー、いい声出して鳴くじゃねぇの。肉、抉る音とカブってっから最高だぜ？』" voices=""/>
		<msg @l="170" char_id="0" frame_id="-1" name="美帆"
		   text="『こ、これはっ‥‥‥薬のせいで‥‥‥‥‥私はべつにっ‥‥‥‥。』" voices="miho02000"/>
		<msg @l="172" char_id="-1" frame_id="-1" name="渡部"
		   text="『ははっ････絵に書いたみてぇなセリフだな。んだったら････サオに吸い付いてくる感触は何なんだ？････くくっ････今みてぇに俺に説明してくれよ？』"
		   voices=""/>
		<msg @l="174" char_id="0" frame_id="-1" name="美帆"
		   text="『いやっ！うあっ、あっ、あっ、ああっ‥‥‥んぐっ！！』" voices="miho02010"/>
		<msg @l="176" char_id="-1" frame_id="-1" name=""
		   text="全力で渡部の言葉と自分の惨めな反応を否定しようと頑張っているのに･･････、" voices=""/>
		<msg @l="177" char_id="-1" frame_id="-1" name=""
		   text="打ち付けられる腰に合わせて襲って来る、痺れる様な感覚の所為で、どんな考えもまとまらない。" voices=""/>
		<msg @l="178" char_id="-1" frame_id="-1" name=""
		   text="怒棒が奥を突く度に、私自身の女そのものが疼いてしまう。" voices=""/>
		<msg @l="179" char_id="-1" frame_id="-1" name=""
		   text="どれだけ頭を振って渡部の蹂躙を拒否しても、自分の性器が止め処ない水を湧き上がらせてしまうのが解った。" voices=""/>
		<msg @l="180" char_id="-1" frame_id="-1" name=""
		   text="欲望を隠しもしないその肉棒も、私の肉を執拗に求め続ける感覚があるのだ。" voices=""/>
		<msg @l="182" char_id="0" frame_id="-1" name="美帆"
		   text="(こんな‥‥こんなのって‥‥‥‥やだ‥‥‥わたし‥‥‥‥)" voices="miho02020"/>
		<msg @l="184" char_id="-1" frame_id="-1" name="渡部"
		   text="『その顔からすると、もう痛みはなくなったみたいだな。』" voices=""/>
		<msg @l="186" char_id="0" frame_id="-1" name="美帆" text="『‥‥！？』"
		   voices="miho02030"/>
		<msg @l="188" char_id="0" frame_id="-1" name="美帆"
		   text="『ち、違いますっ‥‥‥こんなの、痛いだけでっ‥‥‥‥。』" voices="miho02040"/>
		<msg @l="190" char_id="-1" frame_id="-1" name="渡部"
		   text="『ひんひん鳴いて、んな事言っても････全然、説得力なんかねぇんだよッ！』" voices=""/>
		<msg @l="191" char_id="-1" frame_id="-1" name=""
		   text="渡部の腰が、一際激しく私の胎内へと打ち込まれる。" voices=""/>
		<msg @l="192" char_id="-1" frame_id="-1" name=""
		   text="鉄棒でも押し込まれたみたいな衝撃が、私の下腹部から頭頂までを、突き抜ける。" voices=""/>
		<msg @l="193" char_id="-1" frame_id="-1" name=""
		   text="鈍痛にも似たその感触に、私は打たれた様に仰け反った。" voices=""/>
		<msg @l="195" char_id="0" frame_id="-1" name="美帆" text="『ん、ふぁぁっっ！！』"
		   voices="miho02050"/>
		<msg @l="197" char_id="-1" frame_id="-1" name=""
		   text="渡部が強く腰を押し込む度に、私は声を噛み殺そうと懸命に歯を食いしばった。" voices=""/>
		<msg @l="198" char_id="-1" frame_id="-1" name=""
		   text="そうする事で腹筋に力が入るのか、思惑に反して、私の膣は渡部を強く締め上げてしまう。" voices=""/>
		<msg @l="199" char_id="-1" frame_id="-1" name=""
		   text="いきみが肉棒を身体の奥まで引き込んでしまい、渡部の熱い先端が、私の最深部への侵入を果たした。" voices=""/>
		<msg @l="200" char_id="-1" frame_id="-1" name=""
		   text="そのまま渡部に子宮の門を突き上げられ‥‥･･、" voices=""/>
		<msg @l="201" char_id="-1" frame_id="-1" name="" text="私の全身が真っ白に灼ける･･････。"
		   voices=""/>
		<msg @l="203" char_id="-1" frame_id="-1" name="渡部"
		   text="『いいぞ、いいぞぉっ‥‥そのまま、しっかり締め付けろッ！』" voices=""/>
		<msg @l="205" char_id="0" frame_id="-1" name="美帆"
		   text="『んんっ‥‥‥はっ、はっ、はっ‥‥‥‥んぁぁっ！！』" voices="miho02060"/>
		<msg @l="207" char_id="0" frame_id="-1" name="美帆"
		   text="(嫌なのに‥‥こんなの‥‥‥‥‥いやなのに‥‥‥‥)" voices="miho02070"/>
		<msg @l="209" char_id="-1" frame_id="-1" name="留学生"
		   text="『オオォ、ディッキン！、ディックアウツッ！』" voices=""/>
		<msg @l="211" char_id="-1" frame_id="-1" name=""
		   text="頭の上では留学生が両目をぎらぎらと血走らせ、息を呑む程、膨張している肉棒を、狂った様に両手使って擦り上げていた。" voices=""/>
		<msg @l="213" char_id="-1" frame_id="-1" name="熊野"
		   text="『まったく、貴方は何をガッついているんです？････勝手に盛り上がらないで下さいよ？強制送還されたくなければ、私の言うとおりにして頂かなければ困ります。』"
		   voices=""/>
		<msg @l="215" char_id="-1" frame_id="-1" name="留学生" text="『ウゥウッ‥‥ウーッ。』"
		   voices=""/>
		<msg @l="217" char_id="-1" frame_id="-1" name="渡部"
		   text="『コイツのマ○コは想像したとおりの名器だから････、ま、オメェのイキリも解らんでもねぇがな。』" voices=""/>
		<msg @l="219" char_id="-1" frame_id="-1" name="渡部"
		   text="『ホレ、見えるか？俺のモノをこんな奥まで呑み込んじまって‥‥。あっついヒダヒダ････絡ませたまんま悦んでるぞッ！？』"
		   voices=""/>
		<msg @l="221" char_id="0" frame_id="-1" name="美帆"
		   text="『そんなことっ‥‥んくっ‥‥あっ、あっ、あっ‥‥‥‥。』" voices="miho02080"/>
		<msg @l="223" char_id="-1" frame_id="-1" name="渡部"
		   text="『ブツブツなんかカマしてねぇで、オメェもさっさと楽しんじまえよ。』" voices=""/>
		<msg @l="225" char_id="-1" frame_id="-1" name="渡部"
		   text="『どんなに嫌がって泣いたってなぁ････コッチは俺を嬉しそうに咥えてんだぞ？んなイヤイヤ態度は、嬉しがってる子宮に失礼ってモンじゃねぇか････歓んでやれってッ！』"
		   voices=""/>
		<msg @l="227" char_id="-1" frame_id="-1" name=""
		   text="渡部の腰のストロークが、限界を超えて速度を上げる。" voices=""/>
		<msg @l="228" char_id="-1" frame_id="-1" name=""
		   text="遠慮も呵責も一切持たないその注挿に、自分の一部がどんな姿を曝しているのか、考える事すら恐ろしくなる。" voices=""/>
		<msg @l="230" char_id="0" frame_id="-1" name="美帆"
		   text="『うあっ‥‥そんな、激しくしないでっ‥‥あっ‥‥ああっ‥‥‥。』" voices="miho02090"/>
		<msg @l="232" char_id="0" frame_id="-1" name="美帆"
		   text="『んっ、んっ‥‥あっ‥‥んくっっ‥‥‥ふぁぁっ！！』" voices="miho02100"/>
		<msg @l="234" char_id="-1" frame_id="-1" name="渡部"
		   text="『ははっ、子宮ん中まで感じてるんだろ？‥‥‥‥素直に感じてるって言ってくれよ！』" voices=""/>
		<msg @l="236" char_id="0" frame_id="-1" name="美帆"
		   text="『か、感じてなんか‥‥いませんっ‥‥‥。』" voices="miho02110"/>
		<msg @l="238" char_id="-1" frame_id="-1" name="渡部"
		   text="『バカか、テメェはッ！････びちゃびちゃって、こんなに汁っ気、撒き散らかしてやがるクセしやがって････んな訳ねぇだろッ！』"
		   voices=""/>
		<msg @l="240" char_id="-1" frame_id="-1" name=""
		   text="苛立ちも露な渡部の指が、私の一番敏感な肉芽を捻り上げる。" voices=""/>
		<msg @l="242" char_id="0" frame_id="-1" name="美帆" text="『あぐっ‥‥！？』"
		   voices="miho02120"/>
		<msg @l="244" char_id="-1" frame_id="-1" name=""
		   text="自分でも驚くほど硬く尖ったそこに疾った刺激･･････。" voices=""/>
		<msg @l="245" char_id="-1" frame_id="-1" name=""
		   text="麻痺する程の強烈な痛みと、それに相反する電撃的な白い刺激･･････。" voices=""/>
		<msg @l="246" char_id="-1" frame_id="-1" name=""
		   text="脳を染める閃光みたいな感覚は、私が最も恐れた筈の「それ」だった･･････。" voices=""/>
		<msg @l="248" char_id="-1" frame_id="-1" name="渡部"
		   text="『おひょー････ドロっと溢れ出してきやがった。くくくっ････だらしねぇ蛇口になっちまったなぁ？』" voices=""/>
		<msg @l="250" char_id="0" frame_id="-1" name="美帆"
		   text="『いやっ‥‥こんなの‥‥‥‥‥んぁっ、んっ、いやぁぁっ！』" voices="miho02130"/>
		<msg @l="252" char_id="-1" frame_id="-1" name=""
		   text="蹂躙のままに反応している自分の身体に、私は言いようのない嫌悪と恐怖を感じていた。" voices=""/>
		<msg @l="253" char_id="-1" frame_id="-1" name="" text="それなのに･･････、"
		   voices=""/>
		<msg @l="254" char_id="-1" frame_id="-1" name=""
		   text="どれほど嫌がって見せたところで、もう、自分では止められない･･････。" voices=""/>
		<msg @l="255" char_id="-1" frame_id="-1" name=""
		   text="クリ○リスを暴力的に弄られた途端、私の奥に溜まった粘つく蜜が、どうしようもないくらい、結合部を割って溢れ出した･･････。"
		   voices=""/>
		<msg @l="256" char_id="-1" frame_id="-1" name=""
		   text="渡部に突かれ、揺すられる度に、淫猥な水音を立て続けているその液体･･････、絶望すら感じる行為の中、私の意志でそれをどうこうする事は･･････、"
		   voices=""/>
		<msg @l="257" char_id="-1" frame_id="-1" name=""
		   text="･･････もう･･････できなくなっていた･･････。" voices=""/>
		<msg @l="259" char_id="0" frame_id="-1" name="美帆"
		   text="(どうしよう‥‥どうしよう‥‥‥‥‥どうしよう‥‥‥‥)" voices="miho02140"/>
		<msg @l="261" char_id="0" frame_id="-1" name="美帆"
		   text="(こんなのダメ‥‥ダメ‥‥‥‥もう、我慢できないっ‥‥‥‥)" voices="miho02150"/>
		<msg @l="263" char_id="-1" frame_id="-1" name="" text="カッと、お腹の奥底が爆発的に熱くなる。"
		   voices=""/>
		<msg @l="264" char_id="-1" frame_id="-1" name=""
		   text="ここまで私を煽り立てた、あのじんじんと刺す様な感触とはまるで違う、疼きを伴う灼熱の塊･･････。" voices=""/>
		<msg @l="265" char_id="-1" frame_id="-1" name="" text="焦がれるような‥‥･･、"
		   voices=""/>
		<msg @l="266" char_id="-1" frame_id="-1" name="" text="燃えるような･･････、"
		   voices=""/>
		<msg @l="267" char_id="-1" frame_id="-1" name="" text="･･････それは･･････、"
		   voices=""/>
		<msg @l="268" char_id="-1" frame_id="-1" name=""
		   text="「待ち侘びていた熱さ」だったのかも知れなかった･･････。" voices=""/>
		<msg @l="270" char_id="-1" frame_id="-1" name="渡部"
		   text="『よーし、いくぞぉ、いくぞぉ、いくぞぉ‥‥‥。』" voices=""/>
		<msg @l="274" async="true" char_id="-1" frame_id="-1" name=""
		   text="どこに出す‥‥？" voices=""/>
		<select @l="275">
			<menu @l="279" label="EventLabel_83" text="中に出す"/>
			<menu @l="282" label="EventLabel_84" text="外に出す"/>
		</select>
		<label @l="290" id="EventLabel_83"/>
		<msg @l="292" char_id="-1" frame_id="-1" name="渡部"
		   text="『おお、きたきたきたっ‥‥‥いくぞ、テメェの中へ流し込んで････子宮の奥まで････俺が････穢してやるからなッ！！』"
		   voices=""/>
		<msg @l="294" char_id="0" frame_id="-1" name="美帆"
		   text="『いやっ‥‥‥中はダメですっ‥‥‥やめてっっ！！』" voices="miho02160"/>
		<msg @l="296" char_id="-1" frame_id="-1" name="渡部"
		   text="『止める訳ねぇだろッ！うらっ････たっぷり子宮で味わっちまえッ！！！』" voices=""/>
		<msg @l="298" char_id="0" frame_id="-1" name="美帆" text="『うあっっ！？』"
		   voices="miho02170"/>
		<flash @l="301" count="4" fade="100" image="white"/>
		<wait_chgmv/>
		<ev @l="305" src="ev-050y1z1"/>
		<msg @l="307" char_id="-1" frame_id="-1" name="" text="熱い、熱い熱い熱い熱い熱い‥‥。"
		   voices=""/>
		<msg @l="308" char_id="-1" frame_id="-1" name="" text="私の中に･･････、"
		   voices=""/>
		<msg @l="309" char_id="-1" frame_id="-1" name="" text="私の奥に･･････、"
		   voices=""/>
		<msg @l="310" char_id="-1" frame_id="-1" name="" text="汚すぎる熱い液が弾けてる･･････。"
		   voices=""/>
		<msg @l="311" char_id="-1" frame_id="-1" name=""
		   text="柔肉を押し広げていた肉茎が、ビクビクと痙攣しながら跳ねる度に、次々と熱い液体が撃ち込まれ、私の内側を穢していく‥‥･･。"
		   voices=""/>
		<msg @l="313" char_id="-1" frame_id="-1" name="渡部"
		   text="『このまま一番奥に、全部出してやるっ！！』" voices=""/>
		<msg @l="315" char_id="-1" frame_id="-1" name=""
		   text="なおも汚液を吐き出しながら、渡部は怒棒をさらに奥深くへと押し込んでくる。" voices=""/>
		<msg @l="316" char_id="-1" frame_id="-1" name="" text="深くて熱い‥‥･･、" voices=""/>
		<msg @l="317" char_id="-1" frame_id="-1" name=""
		   text="私自身の･･････とても、とても深い処へ･･････。" voices=""/>
		<msg @l="318" char_id="-1" frame_id="-1" name=""
		   text="初めて迎えた牡の白濁液がもたらす刺激に、肉壁に包まれる内臓の全てが戦慄いた。" voices=""/>
		<msg @l="320" char_id="0" frame_id="-1" name="美帆"
		   text="『ダメ‥‥ダメっ‥‥‥来る、来ちゃうっ‥‥‥‥！？』" voices="miho02180"/>
		<msg @l="322" char_id="0" frame_id="-1" name="美帆"
		   text="『あ、ああっ‥‥‥あ‥‥ああ‥‥‥‥‥ん、ああああっ！！！』" voices="miho02190"/>
		<flash @l="326" count="4" fade="100" image="white"/>
		<msg @l="330" char_id="-1" frame_id="-1" name="" text="白い閃光が‥‥･･、" voices=""/>
		<msg @l="331" char_id="-1" frame_id="-1" name="" text="意識の奥底で瞬時に弾けた。"
		   voices=""/>
		<msg @l="332" char_id="-1" frame_id="-1" name="" text="視界までが真っ白に染まり･･････、"
		   voices=""/>
		<msg @l="333" char_id="-1" frame_id="-1" name="" text="自分自身も‥‥･･、" voices=""/>
		<msg @l="334" char_id="-1" frame_id="-1" name="" text="･･････世界から遠のく･･････。"
		   voices=""/>
		<msg @l="335" char_id="-1" frame_id="-1" name=""
		   text="貫かれたままの身体の奥から、沸騰している水音が聞えた気がした･･････。" voices=""/>
		<wait_chgmv/>
		<bg @l="339" src="bg11"/>
		<msg @l="341" char_id="-1" frame_id="-1" name="渡部"
		   text="『ハハッ！&#32;コイツ膣内射精されてイってやがるぞ。』" voices=""/>
		<msg @l="343" char_id="0" frame_id="-1" name="美帆" text="(これが‥‥‥イク‥‥‥‥‥？)"
		   voices="miho02200"/>
		<msg @l="345" char_id="0" frame_id="-1" name="美帆" text="(わたし‥‥イっちゃった‥‥‥‥？)"
		   voices="miho02210"/>
		<eval @l="348" expr="f.過去の反芻_中出しflag&#32;=&#32;1&#13;&#10;"/>
		<goto @l="352" label="EventLabel_85"/>
		<label @l="356" id="EventLabel_84"/>
		<msg @l="358" char_id="-1" frame_id="-1" name="渡部"
		   text="『俺の全部を････可愛い顔に････ブチ撒いてやるッ！！』" voices=""/>
		<msg @l="360" char_id="0" frame_id="-1" name="美帆"
		   text="『ふっ‥‥‥あっ、あっ、あっ‥‥‥‥。』" voices="miho02220"/>
		<msg @l="362" char_id="0" frame_id="-1" name="美帆"
		   text="『なにか‥‥来る‥‥来る‥‥‥‥来ちゃうっ‥‥‥‥！？』" voices="miho02230"/>
		<flash @l="366" count="4" fade="100" image="white"/>
		<wait_chgmv/>
		<ev @l="370" src="ev-050y1z4"/>
		<msg @l="372" char_id="0" frame_id="-1" name="美帆"
		   text="『んっ、んっ、んんっ、あぐっ‥‥‥ふあああっ！！』" voices="miho02240"/>
		<msg @l="374" char_id="-1" frame_id="-1" name=""
		   text="おぞましい臭気を孕んだ熱い液が、私の顔へと降りかかる。" voices=""/>
		<msg @l="375" char_id="-1" frame_id="-1" name=""
		   text="断続的に痙攣を続ける肉棒から吹き付けられるその液体が･･････、" voices=""/>
		<msg @l="376" char_id="-1" frame_id="-1" name="" text="私の頬を･･････、"
		   voices=""/>
		<msg @l="377" char_id="-1" frame_id="-1" name="" text="私の鼻を･･････、"
		   voices=""/>
		<msg @l="378" char_id="-1" frame_id="-1" name="" text="私の髪を蹂躙していく･･････。"
		   voices=""/>
		<msg @l="379" char_id="-1" frame_id="-1" name=""
		   text="渡部が吐き出す獣の欲望を篭めた白濁は、私の肌を穢しながら滑り落ち、床へと繋がる糸を曳いた･･････。" voices=""/>
		<msg @l="381" char_id="-1" frame_id="-1" name="渡部"
		   text="『ハハッ‥‥なんだ、コイツ････。顔にぶっかけられてイキやがったぞ。』" voices=""/>
		<msg @l="383" char_id="0" frame_id="-1" name="美帆" text="(い‥‥く‥‥‥‥？)"
		   voices="miho02250"/>
		<msg @l="385" char_id="0" frame_id="-1" name="美帆" text="(わたし‥‥‥イった‥‥‥の？)"
		   voices="miho02260"/>
		<label @l="388" id="EventLabel_85"/>
		<clear @l="393" class="all"/>
		<msg @l="395" char_id="-1" frame_id="-1" name="熊野"
		   text="『これはこれは、盛大に気を遣られましたね････。』" voices=""/>
		<msg @l="397" char_id="-1" frame_id="-1" name="留学生" text="『オオォ、オンナ、オンナ。』"
		   voices=""/>
		<msg @l="399" char_id="-1" frame_id="-1" name="熊野"
		   text="『では‥‥私の番ですか･･････。』" voices=""/>
		<msg @l="401" char_id="-1" frame_id="-1" name="留学生" text="『オォウッ‥‥ノーーーッ。』"
		   voices=""/>
		<msg @l="403" char_id="0" frame_id="-1" name="美帆" text="『つぎ‥‥‥わたしのばん‥‥‥‥‥？』"
		   voices="miho02270"/>
		<msg @l="405" char_id="-1" frame_id="-1" name="熊野"
		   text="『おや、彼だけでお終いだと思いましたか？』" voices=""/>
		<msg @l="407" char_id="0" frame_id="-1" name="美帆"
		   text="『だって‥‥‥わたし‥‥‥‥‥いま‥‥‥‥‥。』" voices="miho02280"/>
		<msg @l="409" char_id="0" frame_id="-1" name="美帆"
		   text="『いや‥‥もう‥‥‥‥いやです‥‥‥‥許して‥‥。』" voices="miho02290"/>
		<msg @l="411" char_id="-1" frame_id="-1" name="熊野"
		   text="『あれだけの艶姿を見せられては････ね････。私も所詮は男の一匹に過ぎません････。お預けされると、生殺しの様で辛いですねぇ･･････。』"
		   voices=""/>
		<msg @l="413" char_id="-1" frame_id="-1" name="熊野"
		   text="『それに‥‥アナタに味わって頂いているあの薬････。同じものを、私たちも使ってみたんですがね････？』" voices=""/>
		<msg @l="415" char_id="0" frame_id="-1" name="美帆" text="『え‥‥。』"
		   voices="miho02300"/>
		<msg @l="417" char_id="-1" frame_id="-1" name="熊野"
		   text="『あれには性感増幅の効能以外に････、性欲昂進の作用がありまして････。』" voices=""/>
		<msg @l="419" char_id="-1" frame_id="-1" name="熊野"
		   text="『貴女に解りやすく言いますと‥‥萎え知らず、という事ですかね････。』" voices=""/>
		<msg @l="421" char_id="-1" frame_id="-1" name=""
		   text="用務員‥‥熊野はそう言いながら、漸く身を起こした渡部の全身を睥睨する。" voices=""/>
		<msg @l="422" char_id="-1" frame_id="-1" name=""
		   text="私もそれを追って視線を向ける･･････。" voices=""/>
		<msg @l="423" char_id="-1" frame_id="-1" name=""
		   text="今しがた射精したばかりの下半身は、既に漲る程の硬い屹立を覗かせていた。" voices=""/>
		<msg @l="425" char_id="-1" frame_id="-1" name="熊野"
		   text="『まあ、薬の作用時間から考えて････十度も放てば治まるでしょうか････。』" voices=""/>
		<msg @l="427" char_id="-1" frame_id="-1" name="熊野"
		   text="『それまでは‥‥しっかりとお相手くださいな。』" voices=""/>
		<msg @l="429" char_id="0" frame_id="-1" name="美帆" text="『そんなっ‥‥！？』"
		   voices="miho02310"/>
		<bgm @l="432" src="bgm08" volume="1."/>
		<goto @l="435" cond="!(f.過去の反芻_中出しflag&#32;==&#32;1)&#13;&#10;"
		   label="TempLabel_218"/>
		<wait_chgmv/>
		<ev @l="439" src="ev-050y2z1"/>
		<goto @l="442" label="TempLabel_219"/>
		<label @l="443" id="TempLabel_218"/>
		<wait_chgmv/>
		<ev @l="448" src="ev-050y2z4"/>
		<label @l="451" id="TempLabel_219"/>
		<msg @l="454" char_id="0" frame_id="-1" name="美帆" text="『あぐっ‥‥。』"
		   voices="miho02320"/>
		<msg @l="456" char_id="-1" frame_id="-1" name=""
		   text="間を擱かず、熊野の硬く屹立した怒棒が、私の胎内を奥まで挿した。" voices=""/>
		<msg @l="457" char_id="-1" frame_id="-1" name=""
		   text="私が決して望んでいない、ただ、男の欲望に忠実で貪られるだけの惨めな交わり･･････。" voices=""/>
		<msg @l="458" char_id="-1" frame_id="-1" name="" text="･･････にも係わらず･･････、"
		   voices=""/>
		<msg @l="459" char_id="-1" frame_id="-1" name=""
		   text="意思に反して私の媚肉は勝手に疼き、気がつけば熊野の恕棒を締め上げていた･･････。" voices=""/>
		<msg @l="461" char_id="0" frame_id="-1" name="美帆"
		   text="『うあっ‥‥あっ、ああっ‥‥‥‥いやっ‥‥‥いやぁっ‥‥‥。』" voices="miho02330"/>
		<msg @l="463" char_id="-1" frame_id="-1" name=""
		   text="空虚な抵抗の言葉ばかりが、喉の奥から溢れ出る。" voices=""/>
		<msg @l="464" char_id="-1" frame_id="-1" name=""
		   text="逃げ出すだけの気力すら、もう、私には残っていない‥‥･･。" voices=""/>
		<msg @l="466" char_id="-1" frame_id="-1" name="熊野"
		   text="『ほう、これは確かに素晴らしい‥‥実に････良い具合です････。』" voices=""/>
		<msg @l="468" char_id="-1" frame_id="-1" name="熊野"
		   text="『これ程、私に絡み付いて‥‥心まで搾り取られそうですよ････。これなら彼が入れ込むのも解る話です。』" voices=""/>
		<msg @l="470" char_id="0" frame_id="-1" name="美帆" text="『彼‥‥？‥‥ん、ああっっ！！』"
		   voices="miho02340"/>
		<msg @l="472" char_id="-1" frame_id="-1" name=""
		   text="熊野が腰を打ち付けると、にちゃにちゃと私の水が泡立つ音･･････。" voices=""/>
		<msg @l="473" char_id="-1" frame_id="-1" name=""
		   text="外側の花弁までも巻き込んでいる秘部からは、ねっとりと粘った淫花の白蜜が溢れ出し･･････、" voices=""/>
		<msg @l="474" char_id="-1" frame_id="-1" name=""
		   text="激しい注挿行為に没頭している熊野の肉棒をぬめ光らせる。" voices=""/>
		<msg @l="476" char_id="0" frame_id="-1" name="美帆"
		   text="『んっ‥‥‥お願い、許して‥‥下さい‥‥あっ、あっ、ああっ‥‥‥‥。』" voices="miho02350"/>
		<msg @l="478" char_id="0" frame_id="-1" name="美帆"
		   text="(嫌なのに‥‥こんなの嫌なのに‥‥‥‥どうして‥‥‥‥)" voices="miho02360"/>
		<msg @l="480" char_id="-1" frame_id="-1" name=""
		   text="私の口からは、既に漫然と熱い喘ぎ声だけが吐き出されている。" voices=""/>
		<msg @l="481" char_id="-1" frame_id="-1" name=""
		   text="律動に合わせてかくかくと震える全身からは、汗と女の匂いが立ち昇っているんじゃないだろうか･･････。" voices=""/>
		<msg @l="483" char_id="-1" frame_id="-1" name="熊野"
		   text="『悦んで頂けている様で光栄ですよ、仲根美帆さん。』" voices=""/>
		<msg @l="486" char_id="0" frame_id="-1" name="美帆"
		   text="『んくっ、あっ、あっ、あぁっ‥‥‥‥ふ、ああっ‥‥‥‥。』" voices="miho02370"/>
		<msg @l="488" char_id="0" frame_id="-1" name="美帆"
		   text="『よろこんでなんか‥‥‥あ、ああっ‥‥いやぁ‥‥んああっ‥‥。』" voices="miho02380"/>
		<msg @l="490" char_id="-1" frame_id="-1" name="熊野"
		   text="『貴女の身体は正直ですから、恥かしがって言葉を濁す必要はありませんよ。』" voices=""/>
		<msg @l="492" char_id="-1" frame_id="-1" name="" text="私の入り口から続く女の芯へと‥‥･･、"
		   voices=""/>
		<msg @l="493" char_id="-1" frame_id="-1" name=""
		   text="猛り狂った肉棒が、何度も何度も往復している。" voices=""/>
		<msg @l="494" char_id="-1" frame_id="-1" name=""
		   text="秘肉を容赦なく抉られる度、ずちゃずちゃと濡れた粘着音が湧き上がる。" voices=""/>
		<msg @l="495" char_id="-1" frame_id="-1" name=""
		   text="熊野がその先端まで引き抜くと、私の身体の一番奥から溢れ出てくる掬える程の淫汁が、太股までもを熱く濡らした。" voices=""/>
		<msg @l="497" char_id="-1" frame_id="-1" name="熊野"
		   text="『如何です？････身体は正直に応えていると、貴女も解って頂けましたか？』" voices=""/>
		<msg @l="499" char_id="0" frame_id="-1" name="美帆"
		   text="『いやぁぁ‥‥ちがう‥‥ちがっ‥‥‥‥ん、ああっ！！』" voices="miho02390"/>
		<se @l="503" buf="1" src="心臓" volume="1."/>
		<msg @l="505" char_id="-1" frame_id="-1" name=""
		   text="･･････何かが私の耳元に囁いた気がする。" voices=""/>
		<msg @l="506" char_id="-1" frame_id="-1" name=""
		   text="･･････深淵からの呟きは、一体、誰のものだろう？" voices=""/>
		<msg @l="507" char_id="-1" frame_id="-1" name="" text="･･････自分の‥‥･･？"
		   voices=""/>
		<msg @l="508" char_id="-1" frame_id="-1" name="" text="･･････それとも‥‥･･？"
		   voices=""/>
		<msg @l="509" char_id="-1" frame_id="-1" name="" text="･･････でも、だめ･･････、"
		   voices=""/>
		<msg @l="510" char_id="-1" frame_id="-1" name=""
		   text="･･････私･･････もう何も･･････考えられないや‥‥･･。" voices=""/>
		<msg @l="511" char_id="-1" frame_id="-1" name=""
		   text="ひたすら弄ばれるだけの秘所は勝手に蠢き･･････、" voices=""/>
		<msg @l="512" char_id="-1" frame_id="-1" name="" text="子宮は彼等の欲望に震えて‥‥‥、"
		   voices=""/>
		<msg @l="513" char_id="-1" frame_id="-1" name="" text="･･････私を･･････、"
		   voices=""/>
		<msg @l="514" char_id="-1" frame_id="-1" name=""
		   text="･･････私の総てを･･････狂わせる･･････。" voices=""/>
		<msg @l="516" char_id="0" frame_id="-1" name="美帆"
		   text="『はっ、はっ、はっ‥‥‥ん、あふっ！！』" voices="miho02400"/>
		<msg @l="518" char_id="0" frame_id="-1" name="美帆"
		   text="『ダメ‥‥ダメぇ‥‥‥‥こんな‥‥‥‥‥こんなのぉっ！！！』" voices="miho02410"/>
		<msg @l="520" char_id="-1" frame_id="-1" name="熊野"
		   text="『限界もそう、遠くないようですね･･････。構いませんよ、そのまま達して下さっても･･････。』" voices=""/>
		<goto @l="524" cond="!(f.過去の反芻_中出しflag&#32;==&#32;1)&#13;&#10;"
		   label="TempLabel_220"/>
		<msg @l="526" char_id="-1" frame_id="-1" name="熊野"
		   text="『私も‥‥貴女の一番奥へと、注ぎ込んで差し上げますから････。』" voices=""/>
		<msg @l="528" char_id="0" frame_id="-1" name="美帆"
		   text="『あっやぁ‥‥子供が‥‥できちゃう‥‥んっ、んんっ‥‥‥‥ふぁぁっ‥‥‥。』" voices="miho02420"/>
		<msg @l="530" char_id="0" frame_id="-1" name="美帆"
		   text="『んっ‥‥あっ、あっ、あっ‥‥‥‥んっ、ああっ！！』" voices="miho02430"/>
		<msg @l="532" char_id="-1" frame_id="-1" name="熊野"
		   text="『是非、そうなさって下さい‥‥。私の子供を････貴女に孕んで頂いて････貴女に愛おしんで頂けたらと思いますよ。』"
		   voices=""/>
		<msg @l="534" char_id="0" frame_id="-1" name="美帆"
		   text="『んっ、んぅっ‥‥‥ン、ああっ‥‥‥‥。』" voices="miho02440"/>
		<msg @l="536" char_id="-1" frame_id="-1" name="熊野"
		   text="『‥‥では････たっぷり受け取って頂きましょうか････私の子種を･･････。』" voices=""/>
		<msg @l="538" char_id="-1" frame_id="-1" name=""
		   text="熊野はゆっくりと目を細め、腰を思い切り深く落とし込む。" voices=""/>
		<msg @l="539" char_id="-1" frame_id="-1" name=""
		   text="先端が硬く閉じられている一番奥へと侵入し‥‥･･、" voices=""/>
		<msg @l="540" char_id="-1" frame_id="-1" name="" text="大きく膨らんで一気に弾けた･･････。"
		   voices=""/>
		<msg @l="542" char_id="0" frame_id="-1" name="美帆" text="『え‥‥！？』"
		   voices="miho02450"/>
		<flash @l="546" count="4" fade="100" image="white"/>
		<wait_chgmv/>
		<ev @l="550" src="ev-050y2z1z2"/>
		<msg @l="552" char_id="0" frame_id="-1" name="美帆" text="『あっ、ああああっ‥‥！？』"
		   voices="miho02460"/>
		<msg @l="554" char_id="-1" frame_id="-1" name=""
		   text="どくどくと、熱い汚液が私の胎内に注がれる。" voices=""/>
		<msg @l="555" char_id="-1" frame_id="-1" name="" text="あぁ･･････熱い‥‥･･。"
		   voices=""/>
		<msg @l="556" char_id="-1" frame_id="-1" name="" text="熱い液が‥‥･･、" voices=""/>
		<msg @l="557" char_id="-1" frame_id="-1" name="" text="･･････また‥‥中に‥‥･･。"
		   voices=""/>
		<msg @l="559" char_id="-1" frame_id="-1" name="熊野"
		   text="『お待たせしましたね‥‥さあ、いいですよ。』" voices=""/>
		<msg @l="561" char_id="-1" frame_id="-1" name="留学生"
		   text="『オアォオ‥‥パ、パインズプッシー････。････ディッキン･･イッツアウツ･･････！』" voices=""/>
		<msg @l="563" char_id="0" frame_id="-1" name="美帆" text="『もう‥‥ダメ‥‥お願い‥‥‥‥。』"
		   voices="miho02510"/>
		<msg @l="565" char_id="-1" frame_id="-1" name=""
		   text="留学生の彼は私の力ない懇願事など、聞こえてさえいない様だった。" voices=""/>
		<msg @l="566" char_id="-1" frame_id="-1" name=""
		   text="私の声を聞くどころか、涙ぐんでる意味ですら通じているかどうかも分からない。" voices=""/>
		<msg @l="567" char_id="-1" frame_id="-1" name=""
		   text="留学生は熊野からの許可を得ると、なりふり構わず私の身体に被さった。" voices=""/>
		<bgm @l="570" src="bgm09" volume="1."/>
		<goto @l="574" label="TempLabel_221"/>
		<label @l="575" id="TempLabel_220"/>
		<msg @l="578" char_id="-1" frame_id="-1" name="熊野"
		   text="『そのかわいらしいお顔を‥‥汚してあげましょう。』" voices=""/>
		<msg @l="580" char_id="0" frame_id="-1" name="美帆"
		   text="『ふあっ‥‥あっ、ああっ‥‥‥ん、んくっ‥‥‥。』" voices="miho02470"/>
		<msg @l="582" char_id="0" frame_id="-1" name="美帆"
		   text="『あっ、あっ、あっ、あっ‥‥‥‥ふっ、あああっ！！』" voices="miho02480"/>
		<msg @l="584" char_id="-1" frame_id="-1" name="熊野"
		   text="『もう‥‥言葉は無意味なようですな。』" voices=""/>
		<msg @l="586" char_id="0" frame_id="-1" name="美帆"
		   text="『ンンっ‥‥はっ、はっ‥‥‥んあっ‥‥‥‥。』" voices="miho02490"/>
		<msg @l="588" char_id="-1" frame_id="-1" name="熊野"
		   text="『さて、その身体でしっかり受け止めてください。』" voices=""/>
		<msg @l="590" char_id="-1" frame_id="-1" name=""
		   text="熊野は何度も私の秘貝を貫いた後、満足したかの様に肉塊を抜いた。" voices=""/>
		<flash @l="594" count="4" fade="100" image="white"/>
		<wait_chgmv/>
		<ev @l="598" src="ev-050y2z4z5"/>
		<msg @l="600" char_id="-1" frame_id="-1" name=""
		   text="ビクビクと脈動を繰り返しながら白濁の液体が顔面に降り注がれるのを、私はぼんやりと見つめていた。" voices=""/>
		<msg @l="602" char_id="0" frame_id="-1" name="美帆" text="『ふっ‥‥ああ‥‥‥‥。』"
		   voices="miho02500"/>
		<msg @l="604" char_id="-1" frame_id="-1" name=""
		   text="おぞましい臭気を放つ男の液に肌を汚され、私は微かな吐息を漏らす。" voices=""/>
		<msg @l="606" char_id="-1" frame_id="-1" name="熊野"
		   text="『お待たせしましたね‥‥さあ、いいですよ。』" voices=""/>
		<msg @l="608" char_id="-1" frame_id="-1" name="留学生"
		   text="『オアォオ‥‥プ、プ、プッシー、マ○コ、マ○コ。』" voices=""/>
		<msg @l="610" char_id="0" frame_id="-1" name="美帆" text="『もう‥‥ダメ‥‥お願い‥‥‥‥。』"
		   voices="miho02510"/>
		<msg @l="612" char_id="-1" frame_id="-1" name=""
		   text="留学生の彼は私の言う事など全く聞いている様子はない。" voices=""/>
		<msg @l="613" char_id="-1" frame_id="-1" name=""
		   text="第一、私の言葉が通じているかさえ怪しかった。" voices=""/>
		<msg @l="614" char_id="-1" frame_id="-1" name=""
		   text="熊野の許可が得られると、留学生は熊野を押し退け、待ち兼ねたように私の身体に覆い被さった。" voices=""/>
		<bgm @l="617" src="bgm09" volume="1."/>
		<label @l="620" id="TempLabel_221"/>
		<goto @l="624" cond="!(f.過去の反芻_中出しflag&#32;==&#32;1)&#13;&#10;"
		   label="TempLabel_222"/>
		<wait_chgmv/>
		<ev @l="628" src="ev-050y3z1z2"/>
		<msg @l="630" char_id="0" frame_id="-1" name="美帆" text="『んんっっ！！』"
		   voices="miho02520"/>
		<msg @l="632" char_id="-1" frame_id="-1" name=""
		   text="留学生の黒光りする剛棒が深々と突き入れられると同時に、ぐちゃりと派手な水音が湧き立つ。" voices=""/>
		<msg @l="633" char_id="-1" frame_id="-1" name=""
		   text="渡部と熊野が私へと撃ち込んだ大量の精液が、どろりと淫汁に混じって溢れ出した。" voices=""/>
		<msg @l="634" char_id="-1" frame_id="-1" name=""
		   text="穢れた白濁の海の中を、グロテスクな黒い凶器が暴れ回っている事が感じられ･･････、" voices=""/>
		<msg @l="635" char_id="-1" frame_id="-1" name=""
		   text="･･････私は失神寸前の絶望感を味わっていた･･････。" voices=""/>
		<goto @l="638" label="TempLabel_223"/>
		<label @l="639" id="TempLabel_222"/>
		<wait_chgmv/>
		<ev @l="644" src="ev-050y3z4z5"/>
		<msg @l="646" char_id="0" frame_id="-1" name="美帆" text="『んんっっ！！』"
		   voices="miho02520"/>
		<label @l="649" id="TempLabel_223"/>
		<msg @l="652" char_id="-1" frame_id="-1" name="留学生"
		   text="『オウーッ、オッ、オンナ、オンナ。』" voices=""/>
		<msg @l="654" char_id="-1" frame_id="-1" name="渡部"
		   text="『おいおい‥‥すげぇな、マジもんのケダモノみてぇじゃねえか。』" voices=""/>
		<msg @l="656" char_id="-1" frame_id="-1" name="熊野"
		   text="『流石に、日本の女を犯す為に留学してきたと嘯いているだけはありますね。』" voices=""/>
		<msg @l="658" char_id="-1" frame_id="-1" name="留学生"
		   text="『オッ、オゥッ、オオォーーーゥッ。』" voices=""/>
		<msg @l="660" char_id="0" frame_id="-1" name="美帆" text="『んっっ！！』"
		   voices="miho02530"/>
		<msg @l="662" char_id="-1" frame_id="-1" name=""
		   text="気絶する程の激しく無遠慮な注挿が、私の脳を灼き尽くしている‥‥･･。" voices=""/>
		<msg @l="663" char_id="-1" frame_id="-1" name=""
		   text="子宮の内部まで送り込まれたかと錯覚しそうなその行為･･････。" voices=""/>
		<msg @l="664" char_id="-1" frame_id="-1" name=""
		   text="めちゃくちゃに腰を振り回す、その律動の激しさだけでなく･･････、" voices=""/>
		<msg @l="665" char_id="-1" frame_id="-1" name=""
		   text="恕棒の大きさも太さも、渡部や熊野とは比較にならない。" voices=""/>
		<msg @l="666" char_id="-1" frame_id="-1" name=""
		   text="長大な灼けた鉄杭に、内臓総てを突き壊される黒い恐怖が、私の口から苦悶の呻きを強要していた。" voices=""/>
		<msg @l="667" char_id="-1" frame_id="-1" name="" text="息が苦しい･･････。"
		   voices=""/>
		<msg @l="668" char_id="-1" frame_id="-1" name=""
		   text="身体の中身が上から下まで掻き回され、押し潰された私の肺が、空気を求めて喘鳴を上げる。" voices=""/>
		<msg @l="669" char_id="-1" frame_id="-1" name=""
		   text="心臓にまで直接的な振動が伝わり、今にも意識を失いそうになってしまう。" voices=""/>
		<msg @l="670" char_id="-1" frame_id="-1" name=""
		   text="それでも私の聖域だけは、そんな刺激にまで順応し、兇器と化した怒張に震える。" voices=""/>
		<msg @l="671" char_id="-1" frame_id="-1" name=""
		   text="蜜壁は既に限界まで拡がり、暴力をも子宮の奥へ迎えようと、肉の全部で歓喜と悦楽の戦慄きを上げる･･････。" voices=""/>
		<msg @l="673" char_id="0" frame_id="-1" name="美帆"
		   text="『んっ‥‥‥んんっ‥‥はっ、はっ、はっ‥‥‥‥んくっ！！』" voices="miho02540"/>
		<msg @l="675" char_id="0" frame_id="-1" name="美帆"
		   text="『ふあっ、あっ、んあっ‥‥‥あ‥‥‥‥ん、あふっっ！！』" voices="miho02550"/>
		<msg @l="677" char_id="-1" frame_id="-1" name="留学生"
		   text="『オッ、オウッ、オッ、マイガッ、マイガッーーーッド！』" voices=""/>
		<msg @l="679" char_id="-1" frame_id="-1" name=""
		   text="留学生は挿入を繰り返す態勢のままで上半身を前に倒し、私の耳元で浮かされた様な絶叫を上げる。" voices=""/>
		<msg @l="680" char_id="-1" frame_id="-1" name=""
		   text="映画なんかで聞き覚えのある、短く切り詰めたその単語が、私に吐き気を催す嫌悪感を植え付けた。" voices=""/>
		<msg @l="681" char_id="-1" frame_id="-1" name="" text="拒否の為の絶叫を上げたい･･････。"
		   voices=""/>
		<msg @l="682" char_id="-1" frame_id="-1" name=""
		   text="叫び続けて、この苦痛から逃れたい･･････。" voices=""/>
		<msg @l="683" char_id="-1" frame_id="-1" name=""
		   text="けれど、埋め込まれた黒い鉄の塊が、閉じられている子宮口を圧迫し、苦しさの余り声すら出せない‥‥･･。" voices=""/>
		<msg @l="684" char_id="-1" frame_id="-1" name=""
		   text="このまま子宮の中まで侵入されてしまいそうな恐怖を感じる･･････。" voices=""/>
		<msg @l="685" char_id="-1" frame_id="-1" name=""
		   text="噛み合わせた奥歯ががちがちと硬い音を立てている。" voices=""/>
		<msg @l="686" char_id="-1" frame_id="-1" name=""
		   text="私は生まれて始めて感じる種類の恐怖に、殆ど顔面蒼白になっていた。" voices=""/>
		<msg @l="688" char_id="-1" frame_id="-1" name="熊野"
		   text="『薬で性器の硬さも増してますから････、商売女でさえ、泣いて詫びる程の責め苦でしょう･･････。』" voices=""/>
		<msg @l="690" char_id="0" frame_id="-1" name="美帆"
		   text="『ふっ‥‥あっ‥‥‥‥ん、あぐっっ！！』" voices="miho02560"/>
		<msg @l="692" char_id="0" frame_id="-1" name="美帆" text="(わからない‥‥)"
		   voices="miho02570"/>
		<msg @l="694" char_id="0" frame_id="-1" name="美帆" text="(もう、なにもわからない‥‥‥)"
		   voices="miho02580"/>
		<msg @l="696" char_id="0" frame_id="-1" name="美帆"
		   text="(わたし‥‥なにをされてるんだろう‥‥‥‥わたし‥‥‥‥)" voices="miho02590"/>
		<msg @l="698" char_id="-1" frame_id="-1" name="留学生"
		   text="『オッ、オアオォッ‥‥カミング、カミング！』" voices=""/>
		<msg @l="700" char_id="-1" frame_id="-1" name="熊野"
		   text="『おや、もう限界のようですよ？････意外に普通の反応でしたね････』" voices=""/>
		<msg @l="702" char_id="-1" frame_id="-1" name="渡部"
		   text="『俺たちのを見てる間にセンズリこき過ぎたんだろ。』" voices=""/>
		<msg @l="704" char_id="-1" frame_id="-1" name="熊野"
		   text="『まあ、彼なら一度や二度の射精など････数のうちには入りませんがね？』" voices=""/>
		<msg @l="706" char_id="0" frame_id="-1" name="美帆"
		   text="『はっ‥‥‥あっ、うあっ‥‥‥‥‥ん、あくっ‥‥‥‥。』" voices="miho02600"/>
		<msg @l="708" char_id="0" frame_id="-1" name="美帆"
		   text="『あ、ああ‥‥‥あっ‥‥‥‥んんんっ！！』" voices="miho02610"/>
		<msg @l="710" char_id="-1" frame_id="-1" name="" text="狂ったように震える下半身･･････。"
		   voices=""/>
		<msg @l="711" char_id="-1" frame_id="-1" name="" text="脳天が痺れるような被虐感･･････。"
		   voices=""/>
		<msg @l="712" char_id="-1" frame_id="-1" name=""
		   text="身体の中身を引き摺り出される、倒錯的な快楽に襲われ、美帆の理性は完全に昏く崩壊した。" voices=""/>
		<goto @l="715" cond="!(f.過去の反芻_中出しflag&#32;==&#32;1)&#13;&#10;"
		   label="TempLabel_224"/>
		<msg @l="717" char_id="-1" frame_id="-1" name="留学生"
		   text="『オオウッ！&#32;オアァッ！オアアァーッ！！』" voices=""/>
		<flash @l="721" count="4" fade="100" image="white"/>
		<wait_chgmv/>
		<ev @l="725" src="ev-050y3z1z2z3"/>
		<msg @l="727" char_id="0" frame_id="-1" name="美帆"
		   text="『うぁ‥‥‥‥あ‥‥‥あぁ‥‥‥‥‥。』" voices="miho02620"/>
		<msg @l="729" char_id="-1" frame_id="-1" name="" text="胎内で黒い巨棒が大きく膨らみ‥････、"
		   voices=""/>
		<msg @l="730" char_id="-1" frame_id="-1" name=""
		   text="次いで尋常でない熱の篭った白い汚液が噴出する。" voices=""/>
		<msg @l="731" char_id="-1" frame_id="-1" name=""
		   text="膣の内部で暴れ狂うその液体が、奥底に眠る子宮口をも激しく叩いた。" voices=""/>
		<msg @l="732" char_id="-1" frame_id="-1" name=""
		   text="留学生は大量の精を放出すると、満足した様子で勢いよく肉棒を引き抜き、征服の歓喜を湛える絶叫を上げた。" voices=""/>
		<wait_chgmv/>
		<ev @l="735" src="ev-050z1z2z3"/>
		<shake @l="737" amp="10" class="all" cycle="30" duration="2000"
		   type="random"/>
		<msg @l="739" char_id="-1" frame_id="-1" name="留学生"
		   text="『ウォォォォォォォッッッッーーーーーー！！！！！』" voices=""/>
		<msg @l="743" char_id="-1" frame_id="-1" name=""
		   text="その叫び声が子宮を震わせ、私の全身を痙攣させる。" voices=""/>
		<goto @l="746" label="TempLabel_225"/>
		<label @l="747" id="TempLabel_224"/>
		<msg @l="750" char_id="-1" frame_id="-1" name="留学生"
		   text="『ウォーッ、オーッ、オオォオーーッ！！』" voices=""/>
		<msg @l="752" char_id="-1" frame_id="-1" name=""
		   text="達する瞬間、留学生は膣から勢い良く巨棒を引き抜いた。" voices=""/>
		<msg @l="753" char_id="-1" frame_id="-1" name=""
		   text="黒い巨根の先端が、私のお腹の上で狙いを定め‥‥･･、" voices=""/>
		<flash @l="757" count="4" fade="100" image="white"/>
		<wait_chgmv/>
		<ev @l="761" src="ev-050z4z5z6"/>
		<msg @l="763" char_id="0" frame_id="-1" name="美帆" text="『んっ‥‥。』"
		   voices="miho02630"/>
		<msg @l="765" char_id="-1" frame_id="-1" name=""
		   text="腰を突き出した彼の手が、反り返った肉茎を扱き上げる。" voices=""/>
		<msg @l="766" char_id="-1" frame_id="-1" name=""
		   text="刹那、びくんと痙攣したそこから噴出した精液が、びしゃびしゃと私の顔へと降り落ちる。" voices=""/>
		<msg @l="767" char_id="-1" frame_id="-1" name=""
		   text="私が浴びたその量は、渡部や熊野のそれをも遥かに超えて･･････、" voices=""/>
		<msg @l="768" char_id="-1" frame_id="-1" name=""
		   text="臭いも熱さも、私を暗黒の谷間に突き落とすには充分過ぎた･･････。" voices=""/>
		<label @l="771" id="TempLabel_225"/>
		<clear @l="778" class="all"/>
		<wait_chgmv/>
		<bg @l="782" src="bg11"/>
		<msg @l="784" char_id="0" frame_id="-1" name="美帆"
		   text="『‥‥‥‥‥‥ぁぁ‥‥‥‥ぅっ‥‥‥‥‥‥‥。』" voices="miho02640"/>
		<char @l="788" id="watab" pos="auto" src="watabe010"/>
		<msg @l="790" char_id="-1" frame_id="-1" name="渡部"
		   text="『くくっ････手のつけられねぇセックスバカだぜ、この野郎は････。』" voices=""/>
		<clear @l="793" class="char"/>
		<char @l="795" id="watab" pos="left" src="watabe010"/>
		<char @l="798" id="kuma" pos="right" src="kuma010"/>
		<msg @l="800" char_id="-1" frame_id="-1" name="熊野"
		   text="『まだまだ････終わりではありませんよ････。』" voices=""/>
		<msg @l="802" char_id="-1" frame_id="-1" name="熊野"
		   text="『････いえ‥‥これが始まり････と言うべきでしょうか？』" voices=""/>
		<msg @l="804" char_id="-1" frame_id="-1" name="渡部"
		   text="『ああ、そうさ‥‥そう言や････そうだな････。』" voices=""/>
		<msg @l="806" char_id="-1" frame_id="-1" name="留学生"
		   text="『ヘェイ、シュアー････オォウ、イヤァーッ。』" voices=""/>
		<msg @l="808" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』"
		   voices="miho02650"/>
		<msg @l="810" char_id="-1" frame_id="-1" name=""
		   text="留学生は、既に閉じる事さえ出来なくなった私の性器に、何度も自分の肉棒を埋め込んでくる･･････。" voices=""/>
		<msg @l="811" char_id="-1" frame_id="-1" name=""
		   text="何度も踏み躙られ、圧倒的な陵辱を繰り返されながら･･････、" voices=""/>
		<msg @l="812" char_id="-1" frame_id="-1" name=""
		   text="私は限りなく深い闇の底へと、自分の意識が墜ちるのを感じた･･････。" voices=""/>
		<stopbgm @l="816" fadeout="1000"/>
		<clear @l="822" class="all"/>
		<end_scene @l="825"/>
		<call @l="829" target="EventLabel_86@root_akina_c_ev02"/>
		<return @l="830" value="0&#13;&#10;"/>
		<return @l="833" value=""/>
	</code>
</xscript>
