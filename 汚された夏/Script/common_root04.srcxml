<?xml version="1.0" encoding="utf-8"?>
<xscript>
	<debug editor="&quot;C:\Program&#32;Files&#32;(x86)\sakura\sakura.exe&quot;&#32;&quot;%src%&quot;&#32;-Y=%line%"
	   src="D:\シロップ\町ぐるみの罠＋汚された夏セット版\汚された夏\完成データ\汚された夏\script\text\common_root04.txt"/>
	<code>
		<label @l="19" id="EventLabel_29"/>
		<description @l="22" text="稲庭からの誘い"/>
		<eval @l="24" expr="f.numDay=4&#13;&#10;"/>
		<msgshow @l="26" show="false"/>
		<wait_chgmv/>
		<bg @l="28" src="day04" time="2000"/>
		<wait @l="30" time="500"/>
		<wait_chgmv/>
		<bg @l="32" src="black" time="2000"/>
		<msgshow @l="34" show="true"/>
		<wait_chgmv/>
		<bg @l="38" src="bg07"/>
		<bgm @l="42" src="bgm02" volume="1."/>
		<char @l="46" id="miho" pos="right" src="miho010"/>
		<char @l="50" id="inaba" pos="left" src="inaba010"/>
		<msg @l="52" char_id="0" frame_id="-1" name="美帆" text="『サークルの見学会‥‥ですか？』"
		   voices=""/>
		<msg @l="54" char_id="-1" frame_id="-1" name=""
		   text="二限目の後、友達の女の子と二人で昼食のメニューを相談しながらキャンパスを歩いていた時のこと。" voices=""/>
		<msg @l="55" char_id="-1" frame_id="-1" name=""
		   text="偶然、稲庭先輩が私たちの姿を見つけて話し掛けて来たのが始まりだった。" voices=""/>
		<msg @l="57" char_id="-1" frame_id="-1" name="稲庭"
		   text="『そう、今日の四時半からテニスコートでやることになってね。』" voices=""/>
		<msg @l="59" char_id="0" frame_id="-1" name="美帆" text="『急なお話なんですね‥‥。』"
		   voices=""/>
		<msg @l="61" char_id="-1" frame_id="-1" name="稲庭"
		   text="『メンバーの一人が突然言い出してね。もちろん予定があれば断ってくれても構わないよ。』" voices=""/>
		<msg @l="63" char_id="-1" frame_id="-1" name="" text="そうして稲庭先輩はにっこりと微笑む。"
		   voices=""/>
		<msg @l="64" char_id="-1" frame_id="-1" name=""
		   text="例の‥‥驚くほど人懐っこい、全てを許してしまえるような笑みだ。" voices=""/>
		<char @l="68" id="miho" pos="right" src="miho013"/>
		<msg @l="70" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="72" char_id="0" frame_id="-1" name="美帆"
		   text="(玲さんが好きになる理由‥‥ちょっと解るかな)" voices=""/>
		<char @l="76" id="miho" pos="right" src="miho116"/>
		<msg @l="78" char_id="0" frame_id="-1" name="美帆" text="(でも、それ以上に‥‥なんか怖い‥‥)"
		   voices=""/>
		<msg @l="80" char_id="-1" frame_id="-1" name=""
		   text="‥‥稲庭先輩の笑みは、何処か完成しすぎている。" voices=""/>
		<msg @l="81" char_id="-1" frame_id="-1" name=""
		   text="でも何処かひどく儚い、作り物のような無機質さも感じさせる。" voices=""/>
		<msg @l="82" char_id="-1" frame_id="-1" name=""
		   text="もっとも、だからこそ多くの人が惹かれるのかもしれない。" voices=""/>
		<char @l="85" id="miho" pos="right" src="miho110"/>
		<msg @l="87" char_id="0" frame_id="-1" name="美帆" text="(私は‥‥どうだろう？)"
		   voices=""/>
		<msg @l="89" char_id="0" frame_id="-1" name="美帆"
		   text="(惹かれるものは‥‥あるかもしれないけど‥‥‥)" voices=""/>
		<char @l="92" id="inaba" pos="left" src="inaba014"/>
		<msg @l="94" char_id="-1" frame_id="-1" name="稲庭" text="『仲根くん‥‥？』" voices=""/>
		<char @l="98" id="miho" pos="right" src="miho014"/>
		<msg @l="100" char_id="0" frame_id="-1" name="美帆" text="『え、あ‥‥ごめんなさい。』"
		   voices=""/>
		<char @l="104" id="miho" pos="right" src="miho016"/>
		<msg @l="106" char_id="0" frame_id="-1" name="美帆" text="『少しぼうっとしちゃって‥‥。』"
		   voices=""/>
		<char @l="109" id="inaba" pos="left" src="inaba010"/>
		<msg @l="111" char_id="-1" frame_id="-1" name="稲庭" text="『いや、何でもないなら良いんだ。』"
		   voices=""/>
		<msg @l="113" char_id="-1" frame_id="-1" name="稲庭"
		   text="『もし悩むようなら、断ってくれていいんだよ？』" voices=""/>
		<char @l="117" id="miho" pos="right" src="miho110"/>
		<msg @l="119" char_id="0" frame_id="-1" name="美帆" text="『えっと‥‥。』" voices=""/>
		<msg @l="121" char_id="0" frame_id="-1" name="美帆"
		   text="『そうですね‥‥お話は嬉しいんですけど――――むぐっ！？』" voices=""/>
		<char @l="125" id="miho" pos="right" src="miho114"/>
		<msg @l="127" char_id="-1" frame_id="-1" name=""
		   text="私が適当な返答でその場をやり過ごそうとしたその時。" voices=""/>
		<msg @l="128" char_id="-1" frame_id="-1" name=""
		   text="それまで隣で稲庭先輩に見惚れていた友達の子が、私の口を無理やり塞いで割り込んでくる。" voices=""/>
		<msg @l="129" char_id="-1" frame_id="-1" name=""
		   text="普段から強引な子だという事は解っていたけれど、その強引さも稲庭先輩のことになると顕著だ。" voices=""/>
		<bgm @l="132" src="bgm06" volume="1."/>
		<msg @l="134" char_id="-1" frame_id="-1" name="女友達"
		   text="『何でもないです何でもないですっ！』" voices=""/>
		<msg @l="136" char_id="-1" frame_id="-1" name="女友達"
		   text="『いまこの子が言ったコトは、全然ちっともまったく気にしないでいいですからっ！！』" voices=""/>
		<char @l="139" id="miho" pos="right" src="miho115"/>
		<msg @l="141" char_id="0" frame_id="-1" name="美帆" text="『ひ、ひろひ‥‥。』"
		   voices=""/>
		<msg @l="144" char_id="-1" frame_id="-1" name="稲庭" text="『あはは、元気なんだね。』"
		   voices=""/>
		<msg @l="146" char_id="-1" frame_id="-1" name="女友達"
		   text="『はいっ、元気だけが取り得みたいなものですからっ！』" voices=""/>
		<msg @l="148" char_id="-1" frame_id="-1" name="稲庭" text="『そう、元気なのはいい事だよ。』"
		   voices=""/>
		<msg @l="150" char_id="-1" frame_id="-1" name="女友達"
		   text="『それじゃあ先輩は、元気な女の子って好きですかっ！？』" voices=""/>
		<msg @l="152" char_id="-1" frame_id="-1" name="稲庭"
		   text="『そうだねぇ‥‥元気な女の子も魅力的だと思うよ。』" voices=""/>
		<msg @l="154" char_id="-1" frame_id="-1" name="女友達"
		   text="『キャーーーーーーーーーーーーーーッ！！』" voices=""/>
		<msg @l="156" char_id="-1" frame_id="-1" name="女友達"
		   text="『ねえ美帆、聞いた、先輩は元気な女の子が好きだって！！』" voices=""/>
		<char @l="159" id="miho" pos="right" src="miho116"/>
		<msg @l="161" char_id="0" frame_id="-1" name="美帆"
		   text="『う、うん‥‥わはっははらへほほへへふへふはは‥‥‥。』" voices=""/>
		<msg @l="164" char_id="-1" frame_id="-1" name="女友達" text="『わっ‥‥ゴ、ゴメン‥‥‥。』"
		   voices=""/>
		<char @l="168" id="miho" pos="right" src="miho015"/>
		<msg @l="170" char_id="0" frame_id="-1" name="美帆" text="『もう‥‥ひどいよ。』"
		   voices=""/>
		<msg @l="172" char_id="-1" frame_id="-1" name="女友達" text="『だからゴメンって。』"
		   voices=""/>
		<msg @l="174" char_id="-1" frame_id="-1" name="稲庭"
		   text="『それで、サークルの見学会には来てもらえそうかな？』" voices=""/>
		<msg @l="176" char_id="-1" frame_id="-1" name="女友達"
		   text="『あははは‥‥‥もちろんですよ、私たちが稲庭先輩からのお誘いを断ったりするワケないじゃないですか！』" voices=""/>
		<char @l="179" id="miho" pos="right" src="miho016"/>
		<msg @l="181" char_id="0" frame_id="-1" name="美帆" text="(いつのまにか、私も含まれてるし‥‥)"
		   voices=""/>
		<msg @l="183" char_id="-1" frame_id="-1" name="稲庭"
		   text="『よかった‥‥こんな突発的な見学会だろう？』" voices=""/>
		<msg @l="185" char_id="-1" frame_id="-1" name="稲庭"
		   text="『最初はメンバーの思いつきだったけど、会長の僕が許可した以上は正式なイベントだからね。』" voices=""/>
		<msg @l="187" char_id="-1" frame_id="-1" name="稲庭"
		   text="『人が集まらなかったらどうしようって心配してたんだ。』" voices=""/>
		<msg @l="189" char_id="-1" frame_id="-1" name="女友達"
		   text="『サークルの会長さんって、大変なんですね。』" voices=""/>
		<msg @l="191" char_id="-1" frame_id="-1" name="稲庭"
		   text="『そうでもないよ。メンバーはみんなイイ人たちばかりだしね。』" voices=""/>
		<msg @l="193" char_id="-1" frame_id="-1" name="稲庭"
		   text="『いつも助けられてばかりで、申し訳ないくらいさ。』" voices=""/>
		<msg @l="195" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<char @l="199" id="miho" pos="right" src="miho010"/>
		<msg @l="201" char_id="0" frame_id="-1" name="美帆"
		   text="『あの、今日の見学会には、玲さ‥‥白石先輩は参加されるんですか？』" voices=""/>
		<msg @l="203" char_id="-1" frame_id="-1" name="稲庭"
		   text="『白石くんは就職活動で説明会に行かなくちゃいけないとかでね。残念だけど参加出来ないらしい。』" voices=""/>
		<msg @l="205" char_id="-1" frame_id="-1" name="稲庭"
		   text="『ああ‥‥そういえばキミは白石くんのルームメイトだったね。』" voices=""/>
		<char @l="208" id="miho" pos="right" src="miho014"/>
		<msg @l="210" char_id="0" frame_id="-1" name="美帆"
		   text="『あ、はい。白石先輩、私の話とかしてるんですか？』" voices=""/>
		<msg @l="212" char_id="-1" frame_id="-1" name="稲庭"
		   text="『少しだけね。大丈夫、プライベートなことは聞いてないよ。』" voices=""/>
		<msg @l="214" char_id="-1" frame_id="-1" name="稲庭" text="『そういうの、フェアじゃないだろ？』"
		   voices=""/>
		<char @l="217" id="miho" pos="right" src="miho110"/>
		<msg @l="219" char_id="0" frame_id="-1" name="美帆" text="『は、はい‥‥そうですね。』"
		   voices=""/>
		<msg @l="221" char_id="0" frame_id="-1" name="美帆"
		   text="(そっか‥‥玲さん、見学会には参加しないんだ‥‥‥)" voices=""/>
		<msg @l="223" char_id="-1" frame_id="-1" name="稲庭"
		   text="『それじゃあ、僕は他にも勧誘して回らなくちゃいけないから。』" voices=""/>
		<msg @l="225" char_id="-1" frame_id="-1" name="女友達" text="『はい、絶対に行きますからっ！』"
		   voices=""/>
		<msg @l="227" char_id="-1" frame_id="-1" name="稲庭" text="『うん、期待して待ってるよ。』"
		   voices=""/>
		<stopbgm @l="231" fadeout="1000"/>
		<clear @l="235" class="char"/>
		<bgm @l="239" src="bgm02" volume="1."/>
		<char @l="243" id="miho" pos="auto" src="miho010"/>
		<msg @l="246" char_id="-1" frame_id="-1" name="女友達" text="『‥‥‥‥。』" voices=""/>
		<msg @l="248" char_id="-1" frame_id="-1" name="女友達" text="『ん～～～～～～っ！！』"
		   voices=""/>
		<msg @l="250" char_id="-1" frame_id="-1" name="女友達"
		   text="『稲庭先輩、今日も素敵だったわっ！！』" voices=""/>
		<msg @l="252" char_id="-1" frame_id="-1" name=""
		   text="立ち去る稲庭先輩の背中をたっぷりと見送った後、それまで溜めていた「何か」を吐き出すように、彼女は両手を力一杯握りしめたまま絶叫する。"
		   voices=""/>
		<char @l="256" id="miho" pos="auto" src="miho016"/>
		<msg @l="258" char_id="0" frame_id="-1" name="美帆" text="『そ、そうだね‥‥。』"
		   voices=""/>
		<msg @l="260" char_id="-1" frame_id="-1" name=""
		   text="私は彼女の言葉にぎこちなく相槌を打つと、密かに苦笑をする。" voices=""/>
		<msg @l="261" char_id="-1" frame_id="-1" name=""
		   text="ここで稲庭先輩を変に褒めてしまうと、妙な勘繰りをされて際限のない質問攻撃に合うことは明白だ。" voices=""/>
		<msg @l="262" char_id="-1" frame_id="-1" name=""
		   text="かといって同意しなければしないで「どうして美帆には稲庭先輩の魅力が解らないのか」と、やはり説得攻撃にあってしまうのだろう。"
		   voices=""/>
		<msg @l="263" char_id="-1" frame_id="-1" name=""
		   text="どちらに転んでも攻撃が待っている以上、私は曖昧に微笑んでいる事しか出来ない。" voices=""/>
		<msg @l="265" char_id="-1" frame_id="-1" name="女友達"
		   text="『あ～、愛しの稲庭先輩‥‥‥その御勇姿を眺める事が出来るのでしたら例え身内の不幸があっても駆けつけますっ！！』" voices=""/>
		<msg @l="267" char_id="0" frame_id="-1" name="美帆"
		   text="『‥‥それはさすがにどうかなと思うけど。』" voices=""/>
		<msg @l="269" char_id="-1" frame_id="-1" name="女友達" text="『美帆！』" voices=""/>
		<char @l="273" id="miho" pos="auto" src="miho014"/>
		<msg @l="275" char_id="0" frame_id="-1" name="美帆" text="『は、はい。』" voices=""/>
		<msg @l="277" char_id="-1" frame_id="-1" name="女友達" text="『見学会、絶対に行くんだからね。』"
		   voices=""/>
		<msg @l="279" char_id="-1" frame_id="-1" name="女友達"
		   text="『美帆もきっちり予定空けといてよ！』" voices=""/>
		<char @l="283" id="miho" pos="auto" src="miho016"/>
		<msg @l="285" char_id="0" frame_id="-1" name="美帆"
		   text="『で、でも‥‥私は別に行くなんて一言もいってな‥‥‥。』" voices=""/>
		<msg @l="287" char_id="-1" frame_id="-1" name="女友達" text="『行くんだからね！』"
		   voices=""/>
		<char @l="290" id="miho" pos="auto" src="miho014"/>
		<msg @l="292" char_id="0" frame_id="-1" name="美帆" text="『は、はいっ。』" voices=""/>
		<msg @l="294" char_id="-1" frame_id="-1" name="女友達" text="『ん、よろしい。』"
		   voices=""/>
		<msg @l="296" char_id="-1" frame_id="-1" name="" text="そう言って、彼女は満足げに頷いてみせる。"
		   voices=""/>
		<msg @l="297" char_id="-1" frame_id="-1" name="" text="あまりにも強引過ぎていっそ潔い。"
		   voices=""/>
		<char @l="301" id="miho" pos="auto" src="miho110"/>
		<msg @l="303" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="305" char_id="0" frame_id="-1" name="美帆" text="(元気な女の子も魅力的‥‥かぁ)"
		   voices=""/>
		<msg @l="307" char_id="-1" frame_id="-1" name=""
		   text="何故か、私の頭にはその言葉が何度もリフレインしていた。" voices=""/>
		<stopbgm @l="311" fadeout="1000"/>
		<clear @l="317" class="all"/>
		<wait_chgmv/>
		<bg @l="321" src="bg09"/>
		<bgm @l="325" src="bgm02" volume="1."/>
		<char @l="329" id="miho" pos="auto" src="miho110"/>
		<msg @l="331" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="333" char_id="0" frame_id="-1" name="美帆" text="『遅いなぁ‥‥。』" voices=""/>
		<msg @l="335" char_id="-1" frame_id="-1" name=""
		   text="私は廊下で一人、待ちぼうけを食わされていた。" voices=""/>
		<msg @l="336" char_id="-1" frame_id="-1" name=""
		   text="四限目の講義が終わってから早くも十五分が経つ。" voices=""/>
		<msg @l="337" char_id="-1" frame_id="-1" name=""
		   text="もちろん待ち合わせをしているのは友達の子で、行く先は稲庭先輩率いるテニスサークルの見学会だ。" voices=""/>
		<msg @l="339" char_id="0" frame_id="-1" name="美帆"
		   text="(もう、約束の時間までそんなにないのに‥‥)" voices=""/>
		<msg @l="341" char_id="-1" frame_id="-1" name=""
		   text="四限目の講義はバラバラだったので、比較的テニスコートに近かった私の教室を待ち合わせ場所にしようと言い出したのは彼女だった。"
		   voices=""/>
		<msg @l="342" char_id="-1" frame_id="-1" name=""
		   text="だから、待ち合わせ場所を間違えているということはないハズだ。" voices=""/>
		<msg @l="343" char_id="-1" frame_id="-1" name="" text="なんとなく‥‥イヤな予感がした。"
		   voices=""/>
		<msg @l="345" char_id="0" frame_id="-1" name="美帆"
		   text="(私は‥‥あんまり乗り気じゃないのに‥‥)" voices=""/>
		<char @l="348" id="miho" pos="auto" src="miho113"/>
		<msg @l="350" char_id="0" frame_id="-1" name="美帆"
		   text="(こんな風に待たされたら、まるで私が期待してるみたいだよ‥‥)" voices=""/>
		<msg @l="352" char_id="-1" frame_id="-1" name=""
		   text="実際のところ、私は友達の子に押し流される形で付き合う事になったのであって、ことさらテニスサークルの見学会に行きたいというわけじゃない。"
		   voices=""/>
		<msg @l="353" char_id="-1" frame_id="-1" name=""
		   text="とはいえ、興味が全く無いと言えば嘘になる。" voices=""/>
		<msg @l="354" char_id="-1" frame_id="-1" name=""
		   text="純粋にテニスをやってみたいというのもあるし、稲庭先輩にも少しは‥‥。" voices=""/>
		<msg @l="355" char_id="-1" frame_id="-1" name=""
		   text="ただそれにしたって、元々こんなイレギュラー的な見学会に飛び入りで参加するつもりは全然無かった。" voices=""/>
		<msg @l="356" char_id="-1" frame_id="-1" name=""
		   text="テニスサークルに入りたければ率直に入会手続きをすればいいし、稲庭先輩に興味があって会いに行くというなら‥‥心構えをしてから会いに行きたい。"
		   voices=""/>
		<char @l="359" id="miho" pos="auto" src="miho116"/>
		<msg @l="361" char_id="-1" frame_id="-1" name="" text="けれど、今の私はそのどちらでもない。"
		   voices=""/>
		<msg @l="362" char_id="-1" frame_id="-1" name=""
		   text="何となくそういうことになってしまったからと、流されるような感じで見学会へ参加しようとしてる。" voices=""/>
		<msg @l="364" char_id="0" frame_id="-1" name="美帆" text="(‥‥そっか‥‥‥)"
		   voices=""/>
		<msg @l="366" char_id="0" frame_id="-1" name="美帆" text="(私、玲さんに遠慮してるんだ‥‥)"
		   voices=""/>
		<msg @l="368" char_id="0" frame_id="-1" name="美帆"
		   text="(玲さんが稲庭先輩のこと、好きだから‥‥)" voices=""/>
		<msg @l="370" char_id="0" frame_id="-1" name="美帆" text="(だから‥‥？)" voices=""/>
		<msg @l="372" char_id="-1" frame_id="-1" name="" text="自分の気持ちが良く解らない。"
		   voices=""/>
		<msg @l="373" char_id="-1" frame_id="-1" name=""
		   text="なぜ、自分がそうして遠慮をしてしまうのか‥‥。" voices=""/>
		<msg @l="374" char_id="-1" frame_id="-1" name="" text="漠然とした迷いがあるのは確かだ。"
		   voices=""/>
		<msg @l="375" char_id="-1" frame_id="-1" name=""
		   text="けれど、自分が何に迷っているのかが解らなかった。" voices=""/>
		<msg @l="377" char_id="0" frame_id="-1" name="美帆"
		   text="(でも、どうして私がそれに遠慮しちゃうんだろう‥‥？)" voices=""/>
		<msg @l="379" char_id="0" frame_id="-1" name="美帆"
		   text="(私は稲庭先輩のこと‥‥なんとも思ってないはずなのに)" voices=""/>
		<msg @l="381" char_id="-1" frame_id="-1" name="声" text="『美帆～～～。』" voices=""/>
		<char @l="385" id="miho" pos="auto" src="miho111"/>
		<msg @l="387" char_id="0" frame_id="-1" name="美帆" text="『あ‥‥。』" voices=""/>
		<msg @l="390" char_id="-1" frame_id="-1" name=""
		   text="廊下の向こう、テニスサークルのある部室棟とは反対の方向から友達の女の子が走ってくる。" voices=""/>
		<msg @l="391" char_id="-1" frame_id="-1" name=""
		   text="遅れたのを気にして急いで走ってくるのは良いとして、人の名前を大声で呼びながら手を振るのはちょっと恥ずかしい。" voices=""/>
		<char @l="395" id="miho" pos="auto" src="miho016"/>
		<msg @l="397" char_id="-1" frame_id="-1" name="" text="いや、ものすごく恥ずかしい‥‥。"
		   voices=""/>
		<msg @l="399" char_id="-1" frame_id="-1" name="女友達" text="『ごめーん、待たせちゃったね。』"
		   voices=""/>
		<msg @l="401" char_id="0" frame_id="-1" name="美帆"
		   text="『あ‥‥うん、ちょっと待っただけだから。』" voices=""/>
		<char @l="405" id="miho" pos="auto" src="miho010"/>
		<msg @l="407" char_id="0" frame_id="-1" name="美帆"
		   text="『それより、急いで行かないと見学会に間に合わないよ？』" voices=""/>
		<msg @l="409" char_id="-1" frame_id="-1" name="女友達" text="『あー、それなんだけど‥‥。』"
		   voices=""/>
		<msg @l="411" char_id="0" frame_id="-1" name="美帆" text="『ん？』" voices=""/>
		<msg @l="413" char_id="-1" frame_id="-1" name="女友達"
		   text="『えっと‥‥‥なんと言うべきか、その～。』" voices=""/>
		<bgm @l="416" src="bgm06" volume="1."/>
		<msg @l="418" char_id="-1" frame_id="-1" name="女友達" text="『ごめん！』" voices=""/>
		<char @l="422" id="miho" pos="auto" src="miho014"/>
		<msg @l="424" char_id="0" frame_id="-1" name="美帆" text="『い、いきなりどうしたの？』"
		   voices=""/>
		<msg @l="426" char_id="-1" frame_id="-1" name="女友達"
		   text="『テニスサークルの見学会、行けなくなっちゃった！！』" voices=""/>
		<msg @l="428" char_id="0" frame_id="-1" name="美帆" text="『え？&#32;どうして！？』"
		   voices=""/>
		<msg @l="430" char_id="-1" frame_id="-1" name="女友達"
		   text="『彼氏がね、どうしても今日会いたいんだって。』" voices=""/>
		<msg @l="432" char_id="0" frame_id="-1" name="美帆"
		   text="『彼氏って‥‥え、稲庭先輩のこと好きなんじゃないのっ！？』" voices=""/>
		<msg @l="434" char_id="-1" frame_id="-1" name="女友達"
		   text="『もちろん稲庭先輩のことは愛してるわよ～。』" voices=""/>
		<msg @l="436" char_id="-1" frame_id="-1" name="女友達"
		   text="『でもね、現実的な彼氏とはまた別。稲庭先輩に捧げてる愛はあくまでも崇拝の一環としてだもん。』" voices=""/>
		<char @l="440" id="miho" pos="auto" src="miho016"/>
		<msg @l="442" char_id="0" frame_id="-1" name="美帆" text="『それ‥‥ちょっとひどくない？』"
		   voices=""/>
		<msg @l="444" char_id="-1" frame_id="-1" name="女友達" text="『ひどくなんかないって！』"
		   voices=""/>
		<msg @l="446" char_id="-1" frame_id="-1" name="女友達"
		   text="『男の子だって、彼女がいてもアイドルのグラビアとか見てニヤニヤしたりするでしょ。それと一緒だよ。』" voices=""/>
		<msg @l="448" char_id="0" frame_id="-1" name="美帆" text="『‥‥ちょっと違う気がするけど。』"
		   voices=""/>
		<msg @l="450" char_id="-1" frame_id="-1" name="女友達"
		   text="『とにかく、そんなワケだから‥‥見学会には美帆だけで行ってきてよ。』" voices=""/>
		<char @l="454" id="miho" pos="auto" src="miho015"/>
		<msg @l="456" char_id="0" frame_id="-1" name="美帆"
		   text="『そんな‥‥一人でなんて行けないよぉ。』" voices=""/>
		<msg @l="458" char_id="-1" frame_id="-1" name="女友達"
		   text="『愛しの稲庭先輩とお近づきになれるかもしれない、またとないチャンスじゃん。』" voices=""/>
		<char @l="462" id="miho" pos="auto" src="miho016"/>
		<msg @l="464" char_id="0" frame_id="-1" name="美帆" text="『お、お近づきって‥‥。』"
		   voices=""/>
		<msg @l="466" char_id="-1" frame_id="-1" name="女友達"
		   text="『それじゃ、私のことも稲庭先輩にアピールしといてよね！』" voices=""/>
		<char @l="469" id="miho" pos="auto" src="miho114"/>
		<msg @l="471" char_id="0" frame_id="-1" name="美帆" text="『あ‥‥。』" voices=""/>
		<msg @l="473" char_id="-1" frame_id="-1" name=""
		   text="制止する間もなく、彼女は来た時の三倍くらいの速さで走り去ってしまう。" voices=""/>
		<msg @l="474" char_id="-1" frame_id="-1" name=""
		   text="嬉しそうに走り去っていく所を見ると、彼氏のことが凄く好きだという気持ちがわかる。" voices=""/>
		<bgm @l="477" src="bgm05" volume="1."/>
		<msg @l="479" char_id="-1" frame_id="-1" name=""
		   text="むしろテニスサークルの見学会よりも彼氏とのデートを取る辺り、その気持ちの優先順位は歴然なんだろう。" voices=""/>
		<msg @l="481" char_id="0" frame_id="-1" name="美帆"
		   text="『何だかんだ言っても彼氏が大事‥‥かぁ。』" voices=""/>
		<char @l="485" id="miho" pos="auto" src="miho116"/>
		<msg @l="487" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="489" char_id="0" frame_id="-1" name="美帆" text="(私は‥‥どうなのかな‥‥‥)"
		   voices=""/>
		<msg @l="491" char_id="0" frame_id="-1" name="美帆"
		   text="(今日このまま一人でテニスサークルの見学会に行ったら、なんだか玲さんの気持ちに悪い気がする‥‥)" voices=""/>
		<msg @l="493" char_id="0" frame_id="-1" name="美帆"
		   text="(でも、それとは関係なく‥‥興味はある)" voices=""/>
		<msg @l="495" char_id="0" frame_id="-1" name="美帆" text="(どうしたら良いのかな‥‥)"
		   voices=""/>
		<msg @l="499" async="true" char_id="-1" frame_id="-1" name=""
		   text="テニスサークルの見学会に‥‥？" voices=""/>
		<select @l="500">
			<menu @l="502" label="EventLabel_30" text="行く"/>
			<menu @l="504" label="EventLabel_33" text="行かない"/>
		</select>
		<label @l="510" id="EventLabel_30"/>
		<msg @l="512" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<char @l="515" id="miho" pos="auto" src="miho110"/>
		<msg @l="517" char_id="0" frame_id="-1" name="美帆"
		   text="(やっぱり興味もあるし‥‥行ってみようかな)" voices=""/>
		<msg @l="519" char_id="0" frame_id="-1" name="美帆"
		   text="(それに、見学会に行く位なら玲さんも気にしないよね？)" voices=""/>
		<eval @l="522" expr="f.サークル見学会flag&#32;=&#32;1&#13;&#10;"/>
		<clear @l="528" class="all"/>
		<bgm @l="531" src="bgm06" volume="1."/>
		<wait_chgmv/>
		<bg @l="535" src="bg13m1"/>
		<char @l="539" id="miho" pos="auto" src="miho014"/>
		<se @l="543" buf="1" src="ラケットでボールを打つ音" volume="1."/>
		<description @l="546" text="テニス見学会"/>
		<msg @l="548" char_id="0" frame_id="-1" name="美帆" text="『わぁ‥‥。』" voices=""/>
		<msg @l="550" char_id="-1" frame_id="-1" name=""
		   text="テニスコートまで足を運ぶと、テニスウェアに身を包んだサークルの人たちが私服の人を誘導するような感じでコート内を歩いていた。"
		   voices=""/>
		<msg @l="551" char_id="-1" frame_id="-1" name="" text="既に見学会は始まってしまっているようだ。"
		   voices=""/>
		<char @l="555" id="miho" pos="auto" src="miho116"/>
		<msg @l="557" char_id="0" frame_id="-1" name="美帆"
		   text="(どうしよう‥‥時間に遅れちゃったから、入り辛いな)" voices=""/>
		<msg @l="559" char_id="-1" frame_id="-1" name="声" text="『やあ、来てくれたんだね。』"
		   voices=""/>
		<clear @l="562" class="char"/>
		<char @l="565" id="miho" pos="right" src="miho113"/>
		<char @l="568" id="inaba" pos="left" src="inaba050"/>
		<msg @l="570" char_id="0" frame_id="-1" name="美帆" text="『あ、稲庭先輩‥‥。』"
		   voices=""/>
		<msg @l="572" char_id="0" frame_id="-1" name="美帆"
		   text="『すみません、時間に遅れてしまって‥‥‥。』" voices=""/>
		<msg @l="574" char_id="-1" frame_id="-1" name="稲庭"
		   text="『ついさっき始まったばかりだから、気にしなくてもいいよ。』" voices=""/>
		<msg @l="576" char_id="-1" frame_id="-1" name="稲庭"
		   text="『それに、これから僕が見学会の挨拶をする所なんだ。そこに紛れこんじゃえば遅れた事くらいなんてことないさ。』" voices=""/>
		<msg @l="578" char_id="0" frame_id="-1" name="美帆" text="『すみません‥‥。』"
		   voices=""/>
		<msg @l="580" char_id="-1" frame_id="-1" name="稲庭"
		   text="『おや、あの元気な女の子は一緒じゃないんだね？』" voices=""/>
		<msg @l="582" char_id="0" frame_id="-1" name="美帆"
		   text="『あ、はい。彼女、急に都合が悪くなっちゃいまして‥‥。』" voices=""/>
		<msg @l="584" char_id="-1" frame_id="-1" name="稲庭" text="『そうか、残念だけど仕方がないね。』"
		   voices=""/>
		<msg @l="586" char_id="0" frame_id="-1" name="美帆"
		   text="(稲庭先輩にアピールしておいてって言われたけど、何をどうアピールしたらいいのか解らないよ‥‥)" voices=""/>
		<msg @l="588" char_id="-1" frame_id="-1" name="稲庭"
		   text="『さて、それじゃあ僕たちも見学会に混ざろうか？』" voices=""/>
		<clear @l="592" layer="inaba"/>
		<char @l="595" id="miho" pos="right" src="miho111"/>
		<msg @l="597" char_id="0" frame_id="-1" name="美帆" text="『あ、はいっ。』" voices=""/>
		<clear @l="601" layer="miho"/>
		<msg @l="603" char_id="-1" frame_id="-1" name=""
		   text="先行している見学会の人たちに混ざるため、私は稲庭先輩と一緒にテニスコートの中を歩く。" voices=""/>
		<msg @l="604" char_id="-1" frame_id="-1" name=""
		   text="ただ、サークルの中でも稲庭先輩はかなり目立つらしく、私と二人並んで歩いているところを見て怪訝そうな表情を浮かべている人が何人もいた。"
		   voices=""/>
		<msg @l="605" char_id="-1" frame_id="-1" name=""
		   text="ちなみに怪訝そうな表情を浮かべている殆どが女性サークル員だったり稲庭先輩目当てと思しき見学会参加者だったりするから、余計に視線が痛い。"
		   voices=""/>
		<char @l="609" id="inaba" pos="left" src="inaba050"/>
		<char @l="612" id="miho" pos="right" src="miho116"/>
		<msg @l="614" char_id="-1" frame_id="-1" name="稲庭"
		   text="『みんな、僕たちのこと怪しんでるみたいだね。』" voices=""/>
		<msg @l="616" char_id="0" frame_id="-1" name="美帆" text="『え、あの‥‥ごめんなさい。』"
		   voices=""/>
		<msg @l="618" char_id="-1" frame_id="-1" name="稲庭" text="『どうして謝るんだい？』"
		   voices=""/>
		<msg @l="620" char_id="0" frame_id="-1" name="美帆"
		   text="『その‥‥私なんかのせいで変な誤解されると、迷惑ですよね。』" voices=""/>
		<msg @l="622" char_id="-1" frame_id="-1" name="稲庭"
		   text="『僕は、キミとなら誤解されても構わないけどね。』" voices=""/>
		<char @l="626" id="miho" pos="right" src="miho114"/>
		<msg @l="628" char_id="0" frame_id="-1" name="美帆" text="『えっ‥‥それってどういう‥‥‥‥。』"
		   voices=""/>
		<msg @l="630" char_id="-1" frame_id="-1" name="稲庭"
		   text="『ほら、急がないと次の場所に移っちゃうみたいだよ？』" voices=""/>
		<char @l="634" id="miho" pos="right" src="miho110"/>
		<msg @l="636" char_id="0" frame_id="-1" name="美帆" text="『あ‥‥はい。』" voices=""/>
		<msg @l="638" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="640" char_id="0" frame_id="-1" name="美帆"
		   text="(いまの稲庭先輩の言葉‥‥どういう意味だったのかな‥‥‥)" voices=""/>
		<clear @l="646" class="all"/>
		<wait_chgmv/>
		<bg @l="650" src="bg13m1"/>
		<char @l="654" id="inaba" pos="auto" src="inaba050"/>
		<msg @l="656" char_id="-1" frame_id="-1" name="稲庭"
		   text="『皆さん、このサークル見学会に来てくれてありがとうございます。』" voices=""/>
		<msg @l="658" char_id="-1" frame_id="-1" name="稲庭"
		   text="『僕が、このテニスサークルで会長をやっています、稲庭俊明（いなばとしあき）といいます。』" voices=""/>
		<msg @l="660" char_id="-1" frame_id="-1" name=""
		   text="そうして稲庭先輩がにっこり微笑むと、見学会参加者の中から一斉に黄色い声援があがる。" voices=""/>
		<msg @l="661" char_id="-1" frame_id="-1" name=""
		   text="参加者全体の約八割が女性で、その殆どがそんな状態だから、同じ見学会参加者の列にいる私は半ば圧倒されっぱなしだ。" voices=""/>
		<msg @l="663" char_id="0" frame_id="-1" name="美帆"
		   text="(噂通り‥‥稲庭先輩って、すごい人気なんだ)" voices=""/>
		<msg @l="665" char_id="-1" frame_id="-1" name="稲庭"
		   text="『あはは、参加してくれた人たちはみんな元気が良いみたいだね。』" voices=""/>
		<msg @l="667" char_id="-1" frame_id="-1" name="稲庭"
		   text="『その調子で今日の見学会を楽しいものに出来たら幸いです。』" voices=""/>
		<msg @l="669" char_id="-1" frame_id="-1" name="稲庭"
		   text="『皆さん、存分に当テニスサークルの活動内容を見学していってください。』" voices=""/>
		<msg @l="671" char_id="-1" frame_id="-1" name="サークル員"
		   text="『それではこれより当サークルの活動内容を説明致しますので、右手隅にありますＣコートにお集まりください。』" voices=""/>
		<msg @l="673" char_id="-1" frame_id="-1" name=""
		   text="稲庭先輩が見学会の挨拶を終えると、サークル員が参加者の誘導を始める。" voices=""/>
		<msg @l="674" char_id="-1" frame_id="-1" name=""
		   text="けれど、参加者の大半は先ほど挨拶を終えたばかりの稲庭先輩の元へ我先にと群がっていく。" voices=""/>
		<msg @l="676" char_id="-1" frame_id="-1" name="参加者Ａ"
		   text="『稲庭先輩、後でテニスについて色々教えてください！』" voices=""/>
		<msg @l="678" char_id="-1" frame_id="-1" name="参加者Ｂ"
		   text="『あ、ズルイ、私も先輩に色々と教えてもらいたいです！』" voices=""/>
		<msg @l="680" char_id="-1" frame_id="-1" name="参加者Ｃ"
		   text="『私、稲庭先輩の専属マネージャーになりたいです‥‥。』" voices=""/>
		<msg @l="682" char_id="-1" frame_id="-1" name="稲庭"
		   text="『あはは、気持ちは嬉しいけど今はサークル員の誘導に従ってね。』" voices=""/>
		<msg @l="684" char_id="-1" frame_id="-1" name="参加者Ａ・Ｂ・Ｃ" text="『はいっ！』"
		   voices=""/>
		<msg @l="686" char_id="-1" frame_id="-1" name=""
		   text="サークル員の誘導になど耳を貸そうともしなかった参加者たちが、稲庭先輩のひと言で素直にＣコートに歩き始める。" voices=""/>
		<msg @l="687" char_id="-1" frame_id="-1" name=""
		   text="参加者たちの熱意も凄いけれど、稲庭先輩のカリスマ性も驚くほどだ。" voices=""/>
		<msg @l="688" char_id="-1" frame_id="-1" name=""
		   text="これがアイドルの追っかけだった場合、たとえアイドル本人の言葉であってもひと言でファンを鎮めたり従わせたりは出来ないだろう。"
		   voices=""/>
		<msg @l="689" char_id="-1" frame_id="-1" name=""
		   text="むしろ、逆に熱狂したファンが押し寄せるかもしれない。" voices=""/>
		<msg @l="690" char_id="-1" frame_id="-1" name=""
		   text="私もアイドル本人から声をかけられたい、と。" voices=""/>
		<char @l="694" id="miho" pos="auto" src="miho010"/>
		<msg @l="696" char_id="0" frame_id="-1" name="美帆"
		   text="(何か凄いな‥‥先輩の一言で皆素直に従っちゃうんだ)" voices=""/>
		<msg @l="698" char_id="-1" frame_id="-1" name="サークル員" text="『どうかしましたか？』"
		   voices=""/>
		<char @l="702" id="miho" pos="auto" src="miho014"/>
		<msg @l="704" char_id="0" frame_id="-1" name="美帆" text="『え‥‥あ、はい？』"
		   voices=""/>
		<msg @l="706" char_id="-1" frame_id="-1" name="サークル員"
		   text="『サークル活動の説明はＣコートでしますから、移動してください。』" voices=""/>
		<char @l="710" id="miho" pos="auto" src="miho016"/>
		<msg @l="712" char_id="0" frame_id="-1" name="美帆" text="『す、すみませんっ。』"
		   voices=""/>
		<clear @l="718" class="all"/>
		<wait_chgmv/>
		<bg @l="722" src="bg13m1"/>
		<msg @l="724" char_id="-1" frame_id="-1" name="サークル員"
		   text="『では、これにて活動内容の説明を終わります。』" voices=""/>
		<msg @l="726" char_id="-1" frame_id="-1" name="サークル員"
		   text="『続いて体験活動としまして、実際にサークル員とテニスの簡易ゲームを行おうかと思います。』" voices=""/>
		<msg @l="728" char_id="-1" frame_id="-1" name="サークル員"
		   text="『テニス経験者はＡコートへ、未経験者はＢコートで軽い練習の後にゲームを行います。』" voices=""/>
		<char @l="732" id="miho" pos="auto" src="miho110"/>
		<msg @l="734" char_id="0" frame_id="-1" name="美帆" text="(私は未経験者だからＢコートね‥‥)"
		   voices=""/>
		<msg @l="736" char_id="-1" frame_id="-1" name=""
		   text="サークル員の誘導に従って、私はＢコートへ向かう。" voices=""/>
		<msg @l="737" char_id="-1" frame_id="-1" name=""
		   text="生まれてこれまで体育の授業くらいしか経験の無い私は、軽い練習があるとはいえいきなりゲームをするのは少々不安だ。" voices=""/>
		<msg @l="738" char_id="-1" frame_id="-1" name=""
		   text="勝ち負けよりも何より、ゲームになるかどうかさえ解らない。" voices=""/>
		<clear @l="741" class="char"/>
		<char @l="744" id="miho" pos="right" src="miho010"/>
		<char @l="747" id="inaba" pos="left" src="inaba050"/>
		<msg @l="749" char_id="-1" frame_id="-1" name="稲庭" text="『仲根くん。』" voices=""/>
		<char @l="753" id="miho" pos="right" src="miho111"/>
		<msg @l="755" char_id="0" frame_id="-1" name="美帆"
		   text="『あ、稲庭先輩‥‥先輩もＢコート担当なんですか？』" voices=""/>
		<msg @l="757" char_id="-1" frame_id="-1" name="稲庭"
		   text="『これでも一応サークル会長だからね、テニス未経験の人にレクチャーくらい出来なくちゃと思って。』" voices=""/>
		<char @l="761" id="miho" pos="right" src="miho016"/>
		<msg @l="763" char_id="0" frame_id="-1" name="美帆"
		   text="『普通、会長さん本人はそういうことしないと思いますけど。』" voices=""/>
		<msg @l="766" char_id="-1" frame_id="-1" name="稲庭"
		   text="『このサークルは、学年の上下関係に縛られないっていうのが活動方針なんだよ。』" voices=""/>
		<msg @l="768" char_id="-1" frame_id="-1" name="稲庭"
		   text="『体育会系みたいなのは、僕の性に合わないからね。』" voices=""/>
		<char @l="772" id="miho" pos="right" src="miho011"/>
		<msg @l="774" char_id="0" frame_id="-1" name="美帆"
		   text="『そうですか‥‥私も体育会系のノリはちょっと苦手なので、安心しました。』" voices=""/>
		<msg @l="776" char_id="-1" frame_id="-1" name="稲庭"
		   text="『それは良かった。僕はね、仲根くんみたいな大人しい子でも楽しく活動できるサークル作りを心がけているんだよ。』" voices=""/>
		<msg @l="778" char_id="-1" frame_id="-1" name="稲庭"
		   text="『だから、キミに気に入ってもらえると一番嬉しいな。』" voices=""/>
		<char @l="781" id="miho" pos="right" src="miho013"/>
		<msg @l="783" char_id="0" frame_id="-1" name="美帆"
		   text="『え････････そういうのって素敵ですね。』" voices=""/>
		<char @l="787" id="miho" pos="right" src="miho110"/>
		<msg @l="789" char_id="0" frame_id="-1" name="美帆"
		   text="『私、かなりの引っ込み思案で‥‥サークル活動って大変かなと思ってましたけど‥‥そういう人でも楽しめるような所があると嬉しいです。』"
		   voices=""/>
		<msg @l="791" char_id="-1" frame_id="-1" name="稲庭"
		   text="『うんうん、なかなかポイント高かったみたいだね。』" voices=""/>
		<msg @l="793" char_id="-1" frame_id="-1" name="参加者Ａ"
		   text="『稲庭センパーイ、ラケットの握り方が良く解らないんですけど～。』" voices=""/>
		<msg @l="795" char_id="-1" frame_id="-1" name="参加者Ｂ"
		   text="『稲庭先輩、腰の動きはこれで良いんですかぁ？』" voices=""/>
		<msg @l="797" char_id="-1" frame_id="-1" name="参加者Ｃ"
		   text="『‥‥ボールが真っ直ぐ飛びません、稲庭先輩。』" voices=""/>
		<msg @l="799" char_id="-1" frame_id="-1" name="稲庭"
		   text="『おっと‥‥残念だけどここまでみたいだね。』" voices=""/>
		<msg @l="801" char_id="0" frame_id="-1" name="美帆"
		   text="『いえ、私のことは気にせず彼女たちの所へ行ってあげて下さい。』" voices=""/>
		<msg @l="803" char_id="-1" frame_id="-1" name="稲庭"
		   text="『また時間が空いたら、こっちに来るから。』" voices=""/>
		<msg @l="805" char_id="0" frame_id="-1" name="美帆" text="『ありがとうございます。』"
		   voices=""/>
		<clear @l="809" class="char"/>
		<char @l="811" id="miho" pos="auto" src="miho010"/>
		<msg @l="813" char_id="-1" frame_id="-1" name="参加者Ａ"
		   text="『きゃ～、稲庭先輩が来てくれた～！』" voices=""/>
		<msg @l="815" char_id="-1" frame_id="-1" name="参加者Ｂ"
		   text="『先輩先輩、腰の動きなんですけどー。』" voices=""/>
		<msg @l="817" char_id="-1" frame_id="-1" name="参加者Ｃ" text="『ボールが‥‥。』"
		   voices=""/>
		<char @l="821" id="miho" pos="auto" src="miho016"/>
		<msg @l="823" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<char @l="828" id="miho" pos="auto" src="miho010"/>
		<msg @l="830" char_id="0" frame_id="-1" name="美帆" text="(稲庭先輩‥‥かぁ)"
		   voices=""/>
		<msg @l="832" char_id="0" frame_id="-1" name="美帆"
		   text="(最初は何となく近寄りがたい印象があったけど、こうして何度か話してみると案外そんな事ないかも‥‥)" voices=""/>
		<msg @l="834" char_id="0" frame_id="-1" name="美帆"
		   text="(サークルの活動も、思ったほど厳しくなさそうだし)" voices=""/>
		<msg @l="836" char_id="0" frame_id="-1" name="美帆"
		   text="(これなら授業の後にちょっと運動するくらいのつもりで、楽しめそうかな？)" voices=""/>
		<char @l="840" id="miho" pos="auto" src="miho013"/>
		<msg @l="842" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="844" char_id="-1" frame_id="-1" name=""
		   text="私は、コートの端で数人の女の子たち相手にフォームを教えている稲庭先輩の姿をそれとなく眺めてみる。" voices=""/>
		<msg @l="845" char_id="-1" frame_id="-1" name=""
		   text="容姿端麗で気さくな性格、それに優しいと三拍子揃った完璧な人。" voices=""/>
		<msg @l="846" char_id="-1" frame_id="-1" name=""
		   text="玲さんが稲庭先輩のことを好きになるのも、納得だと思う。" voices=""/>
		<char @l="850" id="miho" pos="auto" src="miho014"/>
		<msg @l="852" char_id="0" frame_id="-1" name="美帆" text="(‥‥はっ？)" voices=""/>
		<char @l="856" id="miho" pos="auto" src="miho116"/>
		<msg @l="858" char_id="0" frame_id="-1" name="美帆"
		   text="(もう‥‥私ったら、何ぼうっと稲庭先輩に見惚れてるんだか)" voices=""/>
		<msg @l="860" char_id="0" frame_id="-1" name="美帆"
		   text="(玲さんの気持ちは無視出来ないし、それに私には稲庭先輩は高嶺の花そのもの‥‥って、別に私は稲庭先輩のこと‥‥‥‥)"
		   voices=""/>
		<char @l="864" id="miho" pos="auto" src="miho013"/>
		<msg @l="866" char_id="0" frame_id="-1" name="美帆"
		   text="(稲庭先輩のこと、好きじゃない‥‥‥‥のに)" voices=""/>
		<msg @l="868" char_id="-1" frame_id="-1" name=""
		   text="くすぶり始めていた、もやもやした気持ちを振り払うように、私は心の中でボソリとつぶやいてみる。" voices=""/>
		<msg @l="869" char_id="-1" frame_id="-1" name="" text="少しだけ虚勢染みていて、心苦しい。"
		   voices=""/>
		<char @l="873" id="miho" pos="auto" src="miho016"/>
		<msg @l="875" char_id="0" frame_id="-1" name="美帆"
		   text="(ダメダメダメダメ、あんまり色々考えると深みにはまっちゃう)" voices=""/>
		<char @l="879" id="miho" pos="auto" src="miho110"/>
		<msg @l="881" char_id="0" frame_id="-1" name="美帆" text="(さて‥‥私も練習しよっと)"
		   voices=""/>
		<clear @l="887" class="all"/>
		<bgm @l="890" src="bgm02" volume="1."/>
		<wait_chgmv/>
		<bg @l="894" src="bg13m2"/>
		<msg @l="896" char_id="-1" frame_id="-1" name="サークル員"
		   text="『本日は皆さんお集まり戴き、ありがとうございました。』" voices=""/>
		<msg @l="898" char_id="-1" frame_id="-1" name="サークル員"
		   text="『これにて当サークルの見学会を終了致します。入会を希望される方は後ろに居りますサークル員から入会書をお受け取りください。』"
		   voices=""/>
		<char @l="902" id="miho" pos="auto" src="miho116"/>
		<msg @l="904" char_id="0" frame_id="-1" name="美帆" text="『‥‥ふぅ。』" voices=""/>
		<msg @l="906" char_id="-1" frame_id="-1" name=""
		   text="久々の運動によりずっしりと圧し掛かる疲労感に、私は思わず息を吐いた。" voices=""/>
		<msg @l="907" char_id="-1" frame_id="-1" name=""
		   text="大学生になってからというもの、運動らしい運動といえば、行き帰りに家と駅を往復するか、または広いキャンパスを移動の為に走り回る時くらいだ。"
		   voices=""/>
		<msg @l="908" char_id="-1" frame_id="-1" name=""
		   text="そんな私にとって、小一時間とはいえ連続的に身体を動かすというのは十分ハードなメニューだった。" voices=""/>
		<msg @l="909" char_id="-1" frame_id="-1" name=""
		   text="‥‥単なる運動不足だということはとりあえず棚にあげておいて‥‥。" voices=""/>
		<msg @l="911" char_id="0" frame_id="-1" name="美帆"
		   text="(えっと‥‥後は、サークル入会希望の場合は入会書を受け取るんだっけ？)" voices=""/>
		<msg @l="913" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="915" char_id="0" frame_id="-1" name="美帆" text="(どうしよう‥‥かな)"
		   voices=""/>
		<msg @l="919" async="true" char_id="-1" frame_id="-1" name=""
		   text="テニスサークルに入会する？" voices=""/>
		<select @l="920">
			<menu @l="922" label="EventLabel_31" text="入会する"/>
			<menu @l="924" label="EventLabel_32" text="入会しない"/>
		</select>
		<label @l="931" id="EventLabel_31"/>
		<char @l="936" id="miho" pos="auto" src="miho010"/>
		<msg @l="938" char_id="0" frame_id="-1" name="美帆"
		   text="(そうよね‥‥せっかく見学会に来たんだもん)" voices=""/>
		<msg @l="940" char_id="0" frame_id="-1" name="美帆"
		   text="(自分らしくないとかそういうこと考えずに、思い切って入会してみちゃうのもアリだよね‥‥？)" voices=""/>
		<clear @l="943" class="char"/>
		<char @l="945" id="miho" pos="right" src="miho010"/>
		<char @l="948" id="inaba" pos="left" src="inaba050"/>
		<msg @l="950" char_id="-1" frame_id="-1" name="稲庭"
		   text="『やあ、仲根くんも今日の見学会は楽しんでくれたかな？』" voices=""/>
		<char @l="954" id="miho" pos="right" src="miho113"/>
		<msg @l="956" char_id="0" frame_id="-1" name="美帆" text="『あ‥‥はい、楽しかったです。』"
		   voices=""/>
		<char @l="960" id="miho" pos="right" src="miho016"/>
		<msg @l="962" char_id="0" frame_id="-1" name="美帆" text="『ちょっと‥‥疲れちゃいましたけど。』"
		   voices=""/>
		<msg @l="964" char_id="-1" frame_id="-1" name="稲庭"
		   text="『あはは、大学生には基礎体力も大切だと思うよ。』" voices=""/>
		<char @l="968" id="miho" pos="right" src="miho015"/>
		<msg @l="970" char_id="0" frame_id="-1" name="美帆" text="『う‥‥今、痛感してます。』"
		   voices=""/>
		<msg @l="972" char_id="-1" frame_id="-1" name="稲庭"
		   text="『そうだね‥‥もし良ければ、サークルに入会してみたらどう？』" voices=""/>
		<msg @l="974" char_id="-1" frame_id="-1" name="稲庭"
		   text="『最初は多少疲れるかもしれないけど、しばらく続けていれば体力もつくと思うよ。』" voices=""/>
		<char @l="978" id="miho" pos="right" src="miho013"/>
		<msg @l="980" char_id="0" frame_id="-1" name="美帆"
		   text="『えっと‥‥実は、入会してみようかなって考えてたんです。』" voices=""/>
		<msg @l="982" char_id="-1" frame_id="-1" name="稲庭" text="『それは良かった！』"
		   voices=""/>
		<msg @l="984" char_id="-1" frame_id="-1" name="稲庭"
		   text="『その気があるなら是非入会して欲しいな。歓迎するよ。』" voices=""/>
		<char @l="988" id="miho" pos="right" src="miho116"/>
		<msg @l="990" char_id="0" frame_id="-1" name="美帆" text="『でも‥‥その、大丈夫でしょうか？』"
		   voices=""/>
		<msg @l="992" char_id="0" frame_id="-1" name="美帆"
		   text="『私、体力もないし‥‥足手まといになったりしませんか？』" voices=""/>
		<msg @l="994" char_id="-1" frame_id="-1" name="稲庭"
		   text="『さっきも少し言ったけど、ウチのサークルは強くなろうとか身体を鍛えようとかいう目的でやってるわけじゃないから。』" voices=""/>
		<msg @l="996" char_id="-1" frame_id="-1" name="稲庭"
		   text="『大丈夫、きっと楽しくやれると思うよ。』" voices=""/>
		<char @l="1000" id="miho" pos="right" src="miho111"/>
		<msg @l="1002" char_id="0" frame_id="-1" name="美帆" text="『ほんとですか？』"
		   voices=""/>
		<msg @l="1004" char_id="-1" frame_id="-1" name="稲庭" text="『ああ、僕が保証する。』"
		   voices=""/>
		<msg @l="1006" char_id="0" frame_id="-1" name="美帆"
		   text="『それじゃあ私、入会書もらってきます。』" voices=""/>
		<clear @l="1010" class="char"/>
		<msg @l="1012" char_id="-1" frame_id="-1" name=""
		   text="そうして稲庭先輩の後押しを得た私は、軽い足取りで入会書を貰いに行った。" voices=""/>
		<msg @l="1013" char_id="-1" frame_id="-1" name=""
		   text="運動部系のサークル活動に参加するのは、実に三年ぶりということになるだろうか。" voices=""/>
		<msg @l="1014" char_id="-1" frame_id="-1" name=""
		   text="大学受験をする一年くらい前まで、私は水泳部に入っていた。" voices=""/>
		<msg @l="1015" char_id="-1" frame_id="-1" name=""
		   text="運動全般が苦手な私も水泳だけは別で、それなりの記録も持っていたし、なによりも水泳そのものが楽しくて仕方なかった。" voices=""/>
		<msg @l="1016" char_id="-1" frame_id="-1" name=""
		   text="けれど‥‥高二の夏に起きたとある事件を境に水泳をやめてしまってから、私は自然と運動を心のどこかで避けていた。" voices=""/>
		<msg @l="1017" char_id="-1" frame_id="-1" name=""
		   text="ただそれも、これを機に感じなくなるのではないか。" voices=""/>
		<msg @l="1018" char_id="-1" frame_id="-1" name=""
		   text="ようやく過去のトラウマから解放されるのではないか。" voices=""/>
		<msg @l="1019" char_id="-1" frame_id="-1" name=""
		   text="そんな期待が、私を高揚させていた―――。" voices=""/>
		<eval @l="1022" expr="f.サークル見学会flag&#32;=&#32;2&#13;&#10;"/>
		<goto @l="1026" label="EventLabel_34"/>
		<label @l="1030" id="EventLabel_32"/>
		<msg @l="1033" char_id="0" frame_id="-1" name="美帆" text="(やっぱり‥‥やめておこうかな)"
		   voices=""/>
		<msg @l="1035" char_id="0" frame_id="-1" name="美帆"
		   text="(こういうの、私には向いてないと思うし‥‥)" voices=""/>
		<msg @l="1037" char_id="-1" frame_id="-1" name="" text="見学会自体はとても面白かったと思う。"
		   voices=""/>
		<msg @l="1038" char_id="-1" frame_id="-1" name=""
		   text="ただそれはあくまでも第三者として臨時的に参加したからであって、正式な会員になった後でも楽しめるのだとは限らない。" voices=""/>
		<clear @l="1041" class="char"/>
		<char @l="1043" id="miho" pos="right" src="miho116"/>
		<char @l="1046" id="inaba" pos="left" src="inaba050"/>
		<msg @l="1048" char_id="-1" frame_id="-1" name="稲庭" text="『お疲れのようだね、仲根くん。』"
		   voices=""/>
		<msg @l="1050" char_id="0" frame_id="-1" name="美帆"
		   text="『はい‥‥少し、私にはきつかったみたいです。』" voices=""/>
		<msg @l="1052" char_id="-1" frame_id="-1" name="稲庭"
		   text="『大学生ともなると進んで運動でもしない限り、身体を動かす機会なんてそうそうないからね。』" voices=""/>
		<msg @l="1054" char_id="-1" frame_id="-1" name="稲庭"
		   text="『そういう意味でこういうサークルに入るのは良い機会だと思うけど、どうかな？』" voices=""/>
		<msg @l="1056" char_id="0" frame_id="-1" name="美帆" text="『その、ごめんなさい‥‥。』"
		   voices=""/>
		<msg @l="1058" char_id="0" frame_id="-1" name="美帆"
		   text="『興味はあったんですけど‥‥私には、向いてないみたいです。』" voices=""/>
		<msg @l="1060" char_id="-1" frame_id="-1" name="稲庭"
		   text="『みんな最初はそんなものだよ。慣れないから向いていないのだと良く勘違いするものさ。』" voices=""/>
		<msg @l="1062" char_id="-1" frame_id="-1" name="稲庭"
		   text="『上手になる事が目的のサークルじゃないし、みんなで楽しく運動するくらいのつもりで構わないんだよ？』" voices=""/>
		<char @l="1065" id="miho" pos="right" src="miho016"/>
		<msg @l="1067" char_id="0" frame_id="-1" name="美帆"
		   text="『そう言って戴けるとありがたいです‥‥。』" voices=""/>
		<msg @l="1069" char_id="0" frame_id="-1" name="美帆"
		   text="『でも‥‥やっぱり‥‥‥‥ごめんなさい。』" voices=""/>
		<msg @l="1071" char_id="-1" frame_id="-1" name="稲庭" text="『そう‥‥。』" voices=""/>
		<bgm @l="1074" src="bgm03" volume="1."/>
		<msg @l="1076" char_id="-1" frame_id="-1" name="稲庭"
		   text="『キミなら解ってくれると思ったんだけど、残念だな。』" voices=""/>
		<msg @l="1078" char_id="-1" frame_id="-1" name=""
		   text="一瞬、稲庭先輩の語気に苛立ちのようなモノが含まれたような気がした。" voices=""/>
		<msg @l="1079" char_id="-1" frame_id="-1" name=""
		   text="それは、普段の彼から予想もつかないほど鋭く激しい感じで‥‥。" voices=""/>
		<msg @l="1080" char_id="-1" frame_id="-1" name=""
		   text="私は思わず背筋にゾクッとした寒いものを感じてしまう。" voices=""/>
		<char @l="1084" id="miho" pos="right" src="miho114"/>
		<msg @l="1086" char_id="0" frame_id="-1" name="美帆" text="『稲庭‥‥先輩‥‥‥？』"
		   voices=""/>
		<msg @l="1088" char_id="-1" frame_id="-1" name="稲庭" text="『いや、なんでもないんだ。』"
		   voices=""/>
		<msg @l="1090" char_id="-1" frame_id="-1" name="稲庭"
		   text="『それじゃあ僕はこれからサークルのミーティングがあるから。』" voices=""/>
		<char @l="1094" id="miho" pos="right" src="miho116"/>
		<msg @l="1096" char_id="0" frame_id="-1" name="美帆" text="『あ‥‥はい。』" voices=""/>
		<clear @l="1100" layer="inaba"/>
		<msg @l="1102" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="1104" char_id="0" frame_id="-1" name="美帆" text="『嫌われちゃった‥‥かな。』"
		   voices=""/>
		<msg @l="1106" char_id="-1" frame_id="-1" name=""
		   text="踵を返し、サークル棟へと向かう稲庭先輩の背中は‥‥とても冷たかった。" voices=""/>
		<goto @l="1109" label="EventLabel_34"/>
		<label @l="1113" id="EventLabel_33"/>
		<msg @l="1116" char_id="0" frame_id="-1" name="美帆" text="(見学会‥‥行くの止めようかな)"
		   voices=""/>
		<msg @l="1118" char_id="-1" frame_id="-1" name=""
		   text="考えてみれば無理に行こうと誘っていた友達が来なくなったのだから、私一人で見学会に行く必要は全くといって良いほど無い。"
		   voices=""/>
		<msg @l="1119" char_id="-1" frame_id="-1" name=""
		   text="まあ、無理やりだったとはいえ一度行くと約束してしまった手前、稲庭先輩に申し訳ないという気持ちはあるけれど‥‥。" voices=""/>
		<msg @l="1120" char_id="-1" frame_id="-1" name=""
		   text="それにしたって玲さんのことで変な負い目を感じているくらいだ。" voices=""/>
		<msg @l="1121" char_id="-1" frame_id="-1" name=""
		   text="いっそ、このまま帰ってしまった方が良いかもしれない。" voices=""/>
		<msg @l="1123" char_id="0" frame_id="-1" name="美帆" text="(‥‥ごめんなさい、稲庭先輩)"
		   voices=""/>
		<msg @l="1125" char_id="0" frame_id="-1" name="美帆"
		   text="(それから‥‥アピール出来なくてごめんね)" voices=""/>
		<msg @l="1127" char_id="-1" frame_id="-1" name=""
		   text="心の中で友人に謝りながら、私は停留所へと向かった‥‥。" voices=""/>
		<goto @l="1130" label="EventLabel_34"/>
		<label @l="1134" id="EventLabel_34"/>
		<msgshow @l="1137" show="false"/>
		<clear @l="1139" class="all"/>
		<stopbgm @l="1142" fadeout="1000"/>
		<wait_chgmv/>
		<bg @l="1150" src="bg03b"/>
		<msgshow @l="1153" show="true"/>
		<bgm @l="1157" src="bgm04" volume="1."/>
		<char @l="1161" id="miho" pos="auto" src="miho030"/>
		<description @l="1164" text="揺れ動くとき"/>
		<msg @l="1166" char_id="0" frame_id="-1" name="美帆" text="『お風呂、あがりました。』"
		   voices=""/>
		<msg @l="1168" char_id="1" frame_id="-1" name="玲"
		   text="『お風呂の火、そのままで良いわよ‥‥私もすぐに入るから。』" voices=""/>
		<char @l="1172" id="miho" pos="auto" src="miho031"/>
		<msg @l="1174" char_id="0" frame_id="-1" name="美帆" text="『そう思って点けておきました。』"
		   voices=""/>
		<msg @l="1176" char_id="1" frame_id="-1" name="玲" text="『ありがと。』" voices=""/>
		<msg @l="1178" char_id="-1" frame_id="-1" name=""
		   text="玲さんはテレビに視線を注いだまま、ひらひらと手を振る。" voices=""/>
		<msg @l="1179" char_id="-1" frame_id="-1" name="" text="一応『ありがとう」のサインらしい。"
		   voices=""/>
		<msg @l="1180" char_id="-1" frame_id="-1" name=""
		   text="テレビ画面には、トレンディドラマのクライマックスが流れていた。" voices=""/>
		<goto @l="1183" cond="!(f.サークル見学会flag&#32;&gt;=&#32;1)&#13;&#10;"
		   label="TempLabel_206"/>
		<clear @l="1187" class="char"/>
		<char @l="1189" id="miho" pos="left" src="miho030"/>
		<char @l="1192" id="rei" pos="right" src="rei030"/>
		<msg @l="1194" char_id="0" frame_id="-1" name="美帆"
		   text="『そういえば‥‥今日、玲さんが所属してるテニスサークルの見学会に行って来ましたよ。』" voices=""/>
		<msg @l="1196" char_id="1" frame_id="-1" name="玲"
		   text="『へえ、その見学会ってずいぶん急に決まったやつだと思ったけど‥‥参加者の勧誘してる暇なんてあったのね。』" voices=""/>
		<char @l="1200" id="miho" pos="left" src="miho036"/>
		<msg @l="1202" char_id="0" frame_id="-1" name="美帆"
		   text="『それが‥‥今日のお昼にいきなり誘われて。』" voices=""/>
		<char @l="1206" id="rei" pos="right" src="rei034"/>
		<msg @l="1208" char_id="1" frame_id="-1" name="玲"
		   text="『それで見学会に行くなんて、アナタ意外と行動力あるわねぇ。』" voices=""/>
		<msg @l="1210" char_id="0" frame_id="-1" name="美帆"
		   text="『いえ、あの‥‥誘われた時に一緒に居た友達がどうしても見学会に行くんだって聞かなくてそれで‥‥‥。』" voices=""/>
		<char @l="1214" id="rei" pos="right" src="rei030"/>
		<msg @l="1216" char_id="1" frame_id="-1" name="玲" text="『その友達って女の子でしょ？』"
		   voices=""/>
		<char @l="1220" id="miho" pos="left" src="miho030"/>
		<msg @l="1222" char_id="0" frame_id="-1" name="美帆"
		   text="『そうですけど‥‥なんで解ったんですか？』" voices=""/>
		<char @l="1226" id="rei" pos="right" src="rei031"/>
		<msg @l="1228" char_id="1" frame_id="-1" name="玲" text="『解るわよ、そのくらい。』"
		   voices=""/>
		<msg @l="1230" char_id="1" frame_id="-1" name="玲"
		   text="『その子、稲庭さん目当てで見学会に行きたがったんじゃないかしら？』" voices=""/>
		<char @l="1234" id="miho" pos="left" src="miho036"/>
		<msg @l="1236" char_id="0" frame_id="-1" name="美帆" text="『そ、そうです。』"
		   voices=""/>
		<char @l="1240" id="rei" pos="right" src="rei030"/>
		<msg @l="1242" char_id="1" frame_id="-1" name="玲"
		   text="『やっぱりね。そんな事だろうと思ったわよ。』" voices=""/>
		<msg @l="1244" char_id="1" frame_id="-1" name="玲"
		   text="『即席の見学会で参加者がちゃんと集まるかどうか不安だからって稲庭さんを担ぎ上げたのね。』" voices=""/>
		<char @l="1248" id="miho" pos="left" src="miho131"/>
		<msg @l="1250" char_id="0" frame_id="-1" name="美帆" text="『あはは‥‥。』" voices=""/>
		<msg @l="1252" char_id="1" frame_id="-1" name="玲" text="『それで、美帆は入会する事にしたの？』"
		   voices=""/>
		<char @l="1256" id="miho" pos="left" src="miho030"/>
		<msg @l="1258" char_id="0" frame_id="-1" name="美帆" text="『あ‥‥えっと。』"
		   voices=""/>
		<goto @l="1261" cond="!(f.サークル見学会flag&#32;==&#32;2)&#13;&#10;"
		   label="TempLabel_207"/>
		<char @l="1266" id="miho" pos="left" src="miho036"/>
		<msg @l="1268" char_id="0" frame_id="-1" name="美帆" text="『一応‥‥入会、してみました。』"
		   voices=""/>
		<msg @l="1270" char_id="1" frame_id="-1" name="玲"
		   text="『あら、昨日は乗り気じゃなかったみたいだと思ったけど？』" voices=""/>
		<msg @l="1272" char_id="0" frame_id="-1" name="美帆"
		   text="『私も、見学会に行くまでは乗り気じゃなかったんですけど‥‥実際にサークルの人たちと接していたら、思った以上に楽しくて。』"
		   voices=""/>
		<char @l="1276" id="rei" pos="right" src="rei031"/>
		<msg @l="1278" char_id="1" frame_id="-1" name="玲"
		   text="『そんな事言って、実はアナタも稲庭さん目当てだったりして。』" voices=""/>
		<char @l="1282" id="miho" pos="left" src="miho034"/>
		<msg @l="1284" char_id="0" frame_id="-1" name="美帆" text="『そ、そんなことないですよ。』"
		   voices=""/>
		<char @l="1287" id="miho" pos="left" src="miho133"/>
		<msg @l="1289" char_id="0" frame_id="-1" name="美帆"
		   text="『わ‥‥わわ、私は純粋にテニスに興味があって、それでっ‥‥‥。』" voices=""/>
		<char @l="1293" id="rei" pos="right" src="rei030"/>
		<msg @l="1295" char_id="1" frame_id="-1" name="玲"
		   text="『もう、そんなに慌てないで‥‥からかってるこっちがドキドキしちゃうわ。』" voices=""/>
		<char @l="1299" id="miho" pos="left" src="miho035"/>
		<msg @l="1301" char_id="0" frame_id="-1" name="美帆"
		   text="『うぅ‥‥だったら、からかわないでください‥‥‥。』" voices=""/>
		<char @l="1305" id="rei" pos="right" src="rei031"/>
		<msg @l="1307" char_id="1" frame_id="-1" name="玲" text="『ふふ、ごめんなさい。』"
		   voices=""/>
		<char @l="1311" id="rei" pos="right" src="rei030"/>
		<msg @l="1313" char_id="1" frame_id="-1" name="玲"
		   text="『でも‥‥たとえアナタがライバルでも、私は負けないわよ。』" voices=""/>
		<char @l="1317" id="rei" pos="right" src="rei030"/>
		<msg @l="1319" char_id="1" frame_id="-1" name="玲"
		   text="『何がなんでも、稲庭さんを振り向かせてみせるんだから。』" voices=""/>
		<char @l="1323" id="miho" pos="left" src="miho034"/>
		<msg @l="1325" char_id="0" frame_id="-1" name="美帆" text="『玲さん‥‥。』" voices=""/>
		<char @l="1329" id="rei" pos="right" src="rei030"/>
		<msg @l="1331" char_id="1" frame_id="-1" name="玲" text="『恋の力は凄いのよ。』"
		   voices=""/>
		<msg @l="1333" char_id="1" frame_id="-1" name="玲" text="『アナタも、覚悟しておきなさい。』"
		   voices=""/>
		<char @l="1337" id="miho" pos="left" src="miho130"/>
		<msg @l="1339" char_id="0" frame_id="-1" name="美帆" text="『は、はいっ。』" voices=""/>
		<goto @l="1342" label="TempLabel_208"/>
		<label @l="1343" id="TempLabel_207"/>
		<char @l="1349" id="miho" pos="left" src="miho036"/>
		<msg @l="1351" char_id="0" frame_id="-1" name="美帆" text="『入会は‥‥しませんでした。』"
		   voices=""/>
		<char @l="1355" id="rei" pos="right" src="rei034"/>
		<msg @l="1357" char_id="1" frame_id="-1" name="玲" text="『あら、どうして？』"
		   voices=""/>
		<msg @l="1359" char_id="0" frame_id="-1" name="美帆"
		   text="『どうっていう明確な理由はないんですけど‥‥。』" voices=""/>
		<msg @l="1361" char_id="0" frame_id="-1" name="美帆"
		   text="『運動系のサークルは‥‥やっぱり合わないような気がして。』" voices=""/>
		<char @l="1365" id="rei" pos="right" src="rei030"/>
		<msg @l="1367" char_id="1" frame_id="-1" name="玲"
		   text="『あんまりそういう堅苦しいことの無いサークルなんだけど‥‥まあ、見学会まで行って向かないって感じたのなら仕方ないわね。』"
		   voices=""/>
		<char @l="1371" id="miho" pos="left" src="miho136"/>
		<msg @l="1373" char_id="0" frame_id="-1" name="美帆" text="『‥‥すみません。』"
		   voices=""/>
		<msg @l="1375" char_id="1" frame_id="-1" name="玲" text="『私に謝る事は無いでしょ？』"
		   voices=""/>
		<msg @l="1377" char_id="0" frame_id="-1" name="美帆" text="『あ、はい‥‥すみません。』"
		   voices=""/>
		<char @l="1381" id="rei" pos="right" src="rei034"/>
		<msg @l="1383" char_id="1" frame_id="-1" name="玲" text="『また謝る。』" voices=""/>
		<char @l="1387" id="miho" pos="left" src="miho035"/>
		<msg @l="1389" char_id="0" frame_id="-1" name="美帆"
		   text="『うぅ‥‥もう、癖みたいなものなんです。』" voices=""/>
		<msg @l="1391" char_id="0" frame_id="-1" name="美帆"
		   text="『どうしてか、反射的に謝っちゃうんですよ‥‥。』" voices=""/>
		<char @l="1395" id="rei" pos="right" src="rei030"/>
		<msg @l="1397" char_id="1" frame_id="-1" name="玲" text="『ちょっと良くない癖かもね。』"
		   voices=""/>
		<msg @l="1399" char_id="0" frame_id="-1" name="美帆" text="『すみません‥‥。』"
		   voices=""/>
		<msg @l="1401" char_id="1" frame_id="-1" name="玲" text="『また。』" voices=""/>
		<char @l="1405" id="miho" pos="left" src="miho135"/>
		<msg @l="1407" char_id="0" frame_id="-1" name="美帆" text="『あう‥‥。』" voices=""/>
		<msg @l="1409" char_id="1" frame_id="-1" name="玲"
		   text="『確かに、その性格をなんとかしないとサークルどころじゃないわね。』" voices=""/>
		<msg @l="1411" char_id="0" frame_id="-1" name="美帆" text="『すみま‥‥‥あ、うぅぅ。』"
		   voices=""/>
		<char @l="1415" id="rei" pos="right" src="rei031"/>
		<msg @l="1417" char_id="1" frame_id="-1" name="玲"
		   text="『そうそう、そうやって少しずつ努力しなさい。』" voices=""/>
		<char @l="1421" id="rei" pos="right" src="rei030"/>
		<msg @l="1423" char_id="1" frame_id="-1" name="玲"
		   text="『人は幾らでも変わる事が出来るんだから、自分で「私はこうだ」なんて決め付けてないでどんどん変わる努力をしなくちゃね。』"
		   voices=""/>
		<msg @l="1425" char_id="0" frame_id="-1" name="美帆" text="『‥‥はい。』" voices=""/>
		<stopbgm @l="1428" fadeout="1000"/>
		<se @l="1432" buf="3" loop="true" src="着メロ2" volume="1."/>
		<char @l="1436" id="rei" pos="right" src="rei031"/>
		<msg @l="1438" char_id="1" frame_id="-1" name="玲"
		   text="『あら、こんな時間に電話なんて珍しいわね‥‥？』" voices=""/>
		<char @l="1442" id="miho" pos="left" src="miho034"/>
		<msg @l="1444" char_id="0" frame_id="-1" name="美帆"
		   text="『あ、私の携帯です‥‥ちょっと出て来ますね。』" voices=""/>
		<stopse @l="1448" buf="3"/>
		<stopbgm @l="1452" fadeout="1000"/>
		<clear @l="1457" class="all"/>
		<wait_chgmv/>
		<bg @l="1461" src="bg01b"/>
		<se @l="1465" buf="3" loop="true" src="着メロ2" volume="1."/>
		<char @l="1469" id="miho" pos="auto" src="miho030"/>
		<msg @l="1471" char_id="0" frame_id="-1" name="美帆" text="(んと‥‥携帯は‥‥‥あ、あった)"
		   voices=""/>
		<msg @l="1473" char_id="0" frame_id="-1" name="美帆" text="(相手は‥‥‥自宅から？)"
		   voices=""/>
		<stopse @l="1477" buf="3"/>
		<msg @l="1479" char_id="0" frame_id="-1" name="美帆" text="『はい、もしもし‥‥。』"
		   voices=""/>
		<msg @l="1481" char_id="2" frame_id="-1" name="声" text="『もしもし、お姉ちゃん？』"
		   voices=""/>
		<char @l="1485" id="miho" pos="auto" src="miho034"/>
		<msg @l="1487" char_id="0" frame_id="-1" name="美帆" text="『その声‥‥亜季奈？』"
		   voices=""/>
		<bgm @l="1491" src="bgm06" volume="1."/>
		<msg @l="1493" char_id="2" frame_id="-1" name="亜季奈" text="『ぴんぽーん、大正解。』"
		   voices=""/>
		<msg @l="1495" char_id="2" frame_id="-1" name="亜季奈" text="『賞品は妹優待券、一年分だよ～。』"
		   voices=""/>
		<char @l="1499" id="miho" pos="auto" src="miho036"/>
		<msg @l="1501" char_id="0" frame_id="-1" name="美帆" text="『何よその、妹優待券って‥‥。』"
		   voices=""/>
		<msg @l="1503" char_id="2" frame_id="-1" name="亜季奈"
		   text="『ほら、昔肩たたき券とかあげたでしょ？&#32;あれの私バージョン。』" voices=""/>
		<msg @l="1505" char_id="2" frame_id="-1" name="亜季奈"
		   text="『それを貰ったお姉ちゃんは私を優待しなくちゃいけません。』" voices=""/>
		<msg @l="1507" char_id="0" frame_id="-1" name="美帆" text="『そんなの要らないわよ‥‥。』"
		   voices=""/>
		<msg @l="1509" char_id="2" frame_id="-1" name="亜季奈" text="『ちぇ、遠慮しなくていいのに～。』"
		   voices=""/>
		<char @l="1513" id="miho" pos="auto" src="miho030"/>
		<msg @l="1515" char_id="0" frame_id="-1" name="美帆" text="『それより、いきなりどうしたの？』"
		   voices=""/>
		<char @l="1519" id="miho" pos="auto" src="miho036"/>
		<msg @l="1521" char_id="0" frame_id="-1" name="美帆"
		   text="『まさか、そんな事を言う為だけに電話したんじゃないわよね？』" voices=""/>
		<msg @l="1523" char_id="2" frame_id="-1" name="亜季奈" text="『違うよー。』" voices=""/>
		<msg @l="1525" char_id="2" frame_id="-1" name="亜季奈"
		   text="『今日はお姉ちゃんに、一生のお願いがあって電話したの！』" voices=""/>
		<char @l="1529" id="miho" pos="auto" src="miho034"/>
		<msg @l="1531" char_id="0" frame_id="-1" name="美帆" text="『一生のお願い‥‥？』"
		   voices=""/>
		<msg @l="1533" char_id="2" frame_id="-1" name="亜季奈" text="『そう、一生のお願い！』"
		   voices=""/>
		<char @l="1537" id="miho" pos="auto" src="miho036"/>
		<msg @l="1539" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="1541" char_id="-1" frame_id="-1" name=""
		   text="亜季奈の「一生のお願い」には、昔から何度も大変な思いをさせられている。" voices=""/>
		<msg @l="1542" char_id="-1" frame_id="-1" name=""
		   text="お母さんに黙って子犬を拾ってきた時や、どういうワケか亜季奈のクラスメイトの男の子とデートしなくてはならない状況になった事もあった。"
		   voices=""/>
		<msg @l="1543" char_id="-1" frame_id="-1" name=""
		   text="とにかく亜季奈の「一生のお願い」は、ロクな事がない。" voices=""/>
		<msg @l="1545" char_id="0" frame_id="-1" name="美帆"
		   text="『‥‥また、無茶なことじゃないでしょうね？』" voices=""/>
		<msg @l="1547" char_id="2" frame_id="-1" name="亜季奈" text="『無茶なんかじゃないよー。』"
		   voices=""/>
		<msg @l="1549" char_id="2" frame_id="-1" name="亜季奈"
		   text="『今度、コッチで水泳の大会があるの知ってるよね？』" voices=""/>
		<char @l="1553" id="miho" pos="auto" src="miho030"/>
		<msg @l="1555" char_id="0" frame_id="-1" name="美帆"
		   text="『え、ええ‥‥この時期には毎年やってるもんね。』" voices=""/>
		<msg @l="1557" char_id="-1" frame_id="-1" name="" text="亜季奈は今、水泳部に所属している‥‥。"
		   voices=""/>
		<msg @l="1558" char_id="-1" frame_id="-1" name=""
		   text="私も、何年か前までは亜季奈と同じ水泳部に在籍していた。" voices=""/>
		<msg @l="1559" char_id="-1" frame_id="-1" name=""
		   text="もっとも私が亜季奈と同い年の頃には、とっくに水泳部を辞めてしまっていたのだけれど‥‥。" voices=""/>
		<msg @l="1561" char_id="2" frame_id="-1" name="亜季奈"
		   text="『実は、その大会に向けて強化合宿することになったんだけど‥‥。』" voices=""/>
		<msg @l="1563" char_id="2" frame_id="-1" name="亜季奈"
		   text="『聞いて驚け！&#32;なんとその合宿先がお姉ちゃんの大学なの！』" voices=""/>
		<char @l="1567" id="miho" pos="auto" src="miho036"/>
		<msg @l="1569" char_id="0" frame_id="-1" name="美帆" text="『へ、へえ‥‥偶然ね。』"
		   voices=""/>
		<msg @l="1571" char_id="2" frame_id="-1" name="亜季奈"
		   text="『何よ～、リアクション薄すぎない！？』" voices=""/>
		<msg @l="1573" char_id="0" frame_id="-1" name="美帆"
		   text="『そ、そんなことないわよ‥‥いつも通りじゃない。』" voices=""/>
		<msg @l="1575" char_id="2" frame_id="-1" name="亜季奈" text="『もう、張り合いないなぁ。』"
		   voices=""/>
		<char @l="1579" id="miho" pos="auto" src="miho030"/>
		<msg @l="1581" char_id="0" frame_id="-1" name="美帆"
		   text="『けど‥‥それの何処が「一生のお願い」なの？』" voices=""/>
		<msg @l="1583" char_id="2" frame_id="-1" name="亜季奈" text="『一生のお願いはここから先。』"
		   voices=""/>
		<msg @l="1585" char_id="2" frame_id="-1" name="亜季奈"
		   text="『実はその強化合宿の時に、お姉ちゃんにコーチしてもらえないかと思って。』" voices=""/>
		<char @l="1589" id="miho" pos="auto" src="miho034"/>
		<msg @l="1591" char_id="0" frame_id="-1" name="美帆" text="『え‥‥。』" voices=""/>
		<msg @l="1593" char_id="2" frame_id="-1" name="亜季奈"
		   text="『ほら、昔のコトとはいえお姉ちゃんも記録保持者でしょ？』" voices=""/>
		<msg @l="1595" char_id="2" frame_id="-1" name="亜季奈"
		   text="『やっぱりそういう人が身近にいて教えてくれた方が、みんな記録も伸びると思うんだよね。』" voices=""/>
		<msg @l="1597" char_id="0" frame_id="-1" name="美帆"
		   text="『で、でも‥‥ウチの大学で合宿をするなら、当然水泳サークルとかが泳ぎを見てくれるんじゃないの？』" voices=""/>
		<msg @l="1599" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んー、一応そういう話にはなってるみたいだけど、お姉ちゃんのトコって別に水泳が強いワケでも大会入賞者が居るワケでもないでしょ？』"
		   voices=""/>
		<char @l="1603" id="miho" pos="auto" src="miho036"/>
		<msg @l="1605" char_id="0" frame_id="-1" name="美帆" text="『ま、まあ‥‥。』"
		   voices=""/>
		<msg @l="1607" char_id="-1" frame_id="-1" name=""
		   text="確かに、今の大学に入ってから水泳で賞を取ったという話は聞かない。" voices=""/>
		<msg @l="1608" char_id="-1" frame_id="-1" name=""
		   text="いや‥‥大学を選ぶ時、未練が湧かないようにとあえて水泳に力を入れていない所を選んだのだからそれで当然といえば当然だろう。"
		   voices=""/>
		<msg @l="1610" char_id="2" frame_id="-1" name="亜季奈"
		   text="『だから、助っ人としてお姉ちゃんが居ると心強いんだよ！』" voices=""/>
		<msg @l="1612" char_id="0" frame_id="-1" name="美帆"
		   text="『だけど‥‥そんなの、やっぱり無理だよ。』" voices=""/>
		<msg @l="1614" char_id="0" frame_id="-1" name="美帆"
		   text="『何の関係もない私がプールに居たら変に思われるだろうし‥‥あ、それに私、水泳を辞めた時に競泳用の水着とか捨てちゃったし。』"
		   voices=""/>
		<msg @l="1616" char_id="2" frame_id="-1" name="亜季奈"
		   text="『だいじょうぶだいじょうぶ、別に変になんか思われないよ。』" voices=""/>
		<msg @l="1618" char_id="2" frame_id="-1" name="亜季奈"
		   text="『それにお姉ちゃんはコーチなんだから、海とか外のプールとかに着てくような水着でおっけーだって。』" voices=""/>
		<msg @l="1620" char_id="0" frame_id="-1" name="美帆"
		   text="『もう、亜季奈はすぐそうやって適当なこと言うんだから‥‥。』" voices=""/>
		<msg @l="1622" char_id="2" frame_id="-1" name="亜季奈"
		   text="『ていうかね、実はもう水泳部の子たちに「私のお姉ちゃんがバッチリ、コーチしてくれるから安心して！」って‥‥‥言っちゃったんだよね。』"
		   voices=""/>
		<msg @l="1624" char_id="2" frame_id="-1" name="亜季奈"
		   text="『だから、何がなんでもお姉ちゃんにはコーチしてもらわないと困るの！』" voices=""/>
		<msg @l="1626" char_id="0" frame_id="-1" name="美帆" text="(‥‥なるほどね)"
		   voices=""/>
		<msg @l="1628" char_id="-1" frame_id="-1" name="" text="だから「一生のお願い」というわけだ。"
		   voices=""/>
		<msg @l="1629" char_id="-1" frame_id="-1" name=""
		   text="まったく‥‥予想通り無茶もいいところなお願いをするんだから。" voices=""/>
		<msg @l="1631" char_id="2" frame_id="-1" name="亜季奈"
		   text="『ね、お願いっ‥‥可愛い妹を助けると思って！』" voices=""/>
		<msg @l="1633" char_id="0" frame_id="-1" name="美帆"
		   text="『でも、私はもう水泳は辞めちゃったし‥‥。』" voices=""/>
		<msg @l="1635" char_id="0" frame_id="-1" name="美帆"
		   text="『もう三年以上も泳いでないんだよ？&#32;上手く教える自信ないよ。』" voices=""/>
		<msg @l="1637" char_id="2" frame_id="-1" name="亜季奈"
		   text="『お姉ちゃんなら大丈夫、私が保証しちゃう！』" voices=""/>
		<msg @l="1639" char_id="0" frame_id="-1" name="美帆"
		   text="『亜季奈に保証されても嬉しくない‥‥。』" voices=""/>
		<msg @l="1641" char_id="2" frame_id="-1" name="亜季奈"
		   text="『うぐ‥‥と、とにかく！&#32;合宿は来週の月曜からだから。』" voices=""/>
		<msg @l="1643" char_id="2" frame_id="-1" name="亜季奈"
		   text="『授業が終わったら室内プールまで絶対に来てよね！』" voices=""/>
		<char @l="1647" id="miho" pos="auto" src="miho034"/>
		<msg @l="1649" char_id="0" frame_id="-1" name="美帆"
		   text="『え、あ‥‥ちょっと、なに勝手に話を進めて‥‥‥。』" voices=""/>
		<msg @l="1651" char_id="2" frame_id="-1" name="亜季奈" text="『それじゃ、お願いだよっ！』"
		   voices=""/>
		<se @l="1655" buf="1" src="通話が切れた後の音" volume="1."/>
		<msg @l="1657" char_id="0" frame_id="-1" name="美帆"
		   text="『こら、亜季奈‥‥‥‥って、切れてる。』" voices=""/>
		<stopse @l="1661" buf="1"/>
		<bgm @l="1665" src="bgm02" volume="1."/>
		<char @l="1669" id="miho" pos="auto" src="miho136"/>
		<msg @l="1671" char_id="0" frame_id="-1" name="美帆"
		   text="『もう‥‥いつもいつも自分勝手なんだから‥‥‥。』" voices=""/>
		<msg @l="1673" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="1675" char_id="0" frame_id="-1" name="美帆" text="『水泳かぁ‥‥。』"
		   voices=""/>
		<msg @l="1677" char_id="0" frame_id="-1" name="美帆"
		   text="『私も‥‥あんな事がなければ、今でも続けてたのかな‥‥‥。』" voices=""/>
		<msg @l="1679" char_id="-1" frame_id="-1" name=""
		   text="とある事件をきっかけに、私は水泳を辞めてしまった。" voices=""/>
		<msg @l="1680" char_id="-1" frame_id="-1" name=""
		   text="身体の故障とか限界を感じてとか‥‥そういうありふれたものじゃない。" voices=""/>
		<msg @l="1681" char_id="-1" frame_id="-1" name="" text="あれは確かに「事件」だった。"
		   voices=""/>
		<msg @l="1682" char_id="-1" frame_id="-1" name=""
		   text="関係者各位の‥‥特に私の意思によって表沙汰にする事を避けて秘密裏に闇へと葬リ去った出来事。" voices=""/>
		<msg @l="1683" char_id="-1" frame_id="-1" name=""
		   text="けれどそれは、今も私の心に深い傷痕を残している。" voices=""/>
		<msg @l="1684" char_id="-1" frame_id="-1" name="" text="‥‥確実に。" voices=""/>
		<msg @l="1686" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<char @l="1690" id="miho" pos="auto" src="miho130"/>
		<msg @l="1692" char_id="0" frame_id="-1" name="美帆"
		   text="(でも‥‥当面の問題は、とりあえず火曜日に提出のレポートよね)" voices=""/>
		<msg @l="1694" char_id="-1" frame_id="-1" name=""
		   text="今日、必修の講義で出されたレポートのことを思い出す。" voices=""/>
		<msg @l="1695" char_id="-1" frame_id="-1" name=""
		   text="〆切りまで一週間もないというのがそもそもおかしいのだけれど、いまさら文句を言ったところで期日が延びるわけじゃない。"
		   voices=""/>
		<msg @l="1697" char_id="0" frame_id="-1" name="美帆"
		   text="(明日には図書館に行って資料を借りてきて、それから‥‥‥)" voices=""/>
		<char @l="1701" id="miho" pos="auto" src="miho136"/>
		<msg @l="1703" char_id="0" frame_id="-1" name="美帆"
		   text="(コーチなんてして‥‥‥‥レポート、間に合うのかな‥‥‥)" voices=""/>
		<stopbgm @l="1707" fadeout="1000"/>
		<clear @l="1712" class="all"/>
		<wait_chgmv/>
		<bg @l="1716" src="bg03b"/>
		<bgm @l="1720" src="bgm04" volume="1."/>
		<char @l="1724" id="miho" pos="left" src="miho030"/>
		<char @l="1727" id="rei" pos="right" src="rei030"/>
		<msg @l="1729" char_id="1" frame_id="-1" name="玲" text="『電話、盛り上がってたみたいね。』"
		   voices=""/>
		<msg @l="1731" char_id="1" frame_id="-1" name="玲" text="『大学のお友達？』" voices=""/>
		<char @l="1735" id="miho" pos="left" src="miho036"/>
		<msg @l="1737" char_id="0" frame_id="-1" name="美帆" text="『いえ、妹でした。』"
		   voices=""/>
		<stopbgm @l="1740" fadeout="1000"/>
		<char @l="1744" id="rei" pos="right" src="rei034"/>
		<msg @l="1746" char_id="1" frame_id="-1" name="玲" text="『･･････妹････。』"
		   voices=""/>
		<char @l="1749" id="miho" pos="left" src="miho034"/>
		<msg @l="1751" char_id="0" frame_id="-1" name="美帆"
		   text="『････玲さん？どうしたんですか？』" voices=""/>
		<char @l="1754" id="rei" pos="right" src="rei031"/>
		<msg @l="1756" char_id="1" frame_id="-1" name="玲"
		   text="『あっ････、なんでもないわ･･。それで妹さんどうしたの？』" voices=""/>
		<bgm @l="1759" src="bgm04" volume="1."/>
		<char @l="1761" id="miho" pos="left" src="miho036"/>
		<msg @l="1762" char_id="0" frame_id="-1" name="美帆"
		   text="『ええ････クラブ活動が楽しいらしくて、勉強の方はサッパリで困っているんですよ。』" voices=""/>
		<char @l="1766" id="rei" pos="right" src="rei030"/>
		<msg @l="1768" char_id="1" frame_id="-1" name="玲"
		   text="『勉強なんて必要な時にすれば良いのよ。それより妹かぁ、私は一人っ子だから羨ましいわ。』" voices=""/>
		<msg @l="1770" char_id="1" frame_id="-1" name="玲"
		   text="『私にも妹が居たら‥‥アナタみたいな感じなのかしらね？』" voices=""/>
		<char @l="1773" id="miho" pos="left" src="miho136"/>
		<msg @l="1775" char_id="0" frame_id="-1" name="美帆" text="『ちょっと違うと思いますよ。』"
		   voices=""/>
		<msg @l="1777" char_id="0" frame_id="-1" name="美帆"
		   text="『私と玲さんは一つしか違いませんし‥‥それに、亜季奈‥‥私の妹は私とは正反対の元気な子ですから。』" voices=""/>
		<char @l="1781" id="rei" pos="right" src="rei031"/>
		<msg @l="1783" char_id="1" frame_id="-1" name="玲"
		   text="『性格とか年の数はどうでもいいのよ、いわゆる気分の問題なんだから。』" voices=""/>
		<char @l="1786" id="miho" pos="left" src="miho036"/>
		<msg @l="1788" char_id="0" frame_id="-1" name="美帆" text="『んー、良くわからないですね‥‥。』"
		   voices=""/>
		<char @l="1792" id="miho" pos="left" src="miho030"/>
		<msg @l="1794" char_id="0" frame_id="-1" name="美帆"
		   text="『それで言うと、もし私にお姉さんが居たら‥‥玲さんみたいな感じになるのかな。』" voices=""/>
		<char @l="1798" id="miho" pos="left" src="miho036"/>
		<msg @l="1800" char_id="0" frame_id="-1" name="美帆"
		   text="『と言っても、ウチの妹は私に敬語なんか使いませんけど‥‥。』" voices=""/>
		<char @l="1804" id="rei" pos="right" src="rei030"/>
		<msg @l="1806" char_id="1" frame_id="-1" name="玲"
		   text="『ふふ、姉妹ってそんなモノなのかしらね。』" voices=""/>
		<eval @l="1809" expr="f.亜季奈ルート確定flag&#32;=&#32;1&#13;&#10;"/>
		<label @l="1813" id="TempLabel_208"/>
		<msg @l="1816" char_id="1" frame_id="-1" name="玲"
		   text="『それじゃ、私もお風呂に入ってくるわ。』" voices=""/>
		<char @l="1820" id="miho" pos="left" src="miho030"/>
		<msg @l="1822" char_id="0" frame_id="-1" name="美帆" text="『あ、はい。』" voices=""/>
		<msg @l="1824" char_id="0" frame_id="-1" name="美帆"
		   text="『私はこのまま寝ますから、テレビとか電気は消しておきますね。』" voices=""/>
		<char @l="1828" id="rei" pos="right" src="rei030"/>
		<msg @l="1830" char_id="1" frame_id="-1" name="玲" text="『よろしくね。』" voices=""/>
		<clear @l="1834" layer="rei"/>
		<msg @l="1836" char_id="0" frame_id="-1" name="美帆"
		   text="『それじゃあ電気を消してっと‥‥‥‥。』" voices=""/>
		<wait_chgmv/>
		<bg @l="1839" src="bg03c"/>
		<msg @l="1841" char_id="0" frame_id="1" name="美帆" text="（おやすみなさい・・・・。）"
		   voices=""/>
		<goto @l="1844" label="TempLabel_209"/>
		<label @l="1845" id="TempLabel_206"/>
		<goto @l="1846" cond="!(f.サークル見学会flag&#32;==&#32;0)&#13;&#10;"
		   label="TempLabel_210"/>
		<clear @l="1851" class="char"/>
		<char @l="1854" id="miho" pos="left" src="miho031"/>
		<msg @l="1856" char_id="0" frame_id="1" name="美帆"
		   text="『このドラマ、よく見てますよね‥‥面白いんですか？』" voices=""/>
		<char @l="1860" id="rei" pos="right" src="rei030"/>
		<msg @l="1862" char_id="1" frame_id="-1" name="玲"
		   text="『まあまあね。今話題のドラマらしいから見ておこうと思ってね。』" voices=""/>
		<char @l="1866" id="miho" pos="left" src="miho036"/>
		<msg @l="1868" char_id="0" frame_id="1" name="美帆"
		   text="『私には、ドラマってどれも同じように見えちゃうんですけど‥‥。』" voices=""/>
		<char @l="1872" id="miho" pos="left" src="miho031"/>
		<msg @l="1874" char_id="0" frame_id="1" name="美帆" text="『やっぱり良し悪しってあるんですか？』"
		   voices=""/>
		<char @l="1878" id="rei" pos="right" src="rei031"/>
		<msg @l="1880" char_id="1" frame_id="-1" name="玲"
		   text="『それはそうよ。モノによって監督や脚本も違えば役者だって違うもの。』" voices=""/>
		<char @l="1884" id="rei" pos="right" src="rei030"/>
		<msg @l="1886" char_id="1" frame_id="-1" name="玲"
		   text="『当然、個々によって評価はまちまちになるわ。』" voices=""/>
		<msg @l="1888" char_id="0" frame_id="1" name="美帆" text="『そんなものですか‥‥。』"
		   voices=""/>
		<msg @l="1890" char_id="1" frame_id="-1" name="玲"
		   text="『習うより慣れろよ。まずはどのシリーズでも良いから最初から最後まで見てみることね。』" voices=""/>
		<msg @l="1892" char_id="1" frame_id="-1" name="玲" text="『案外、気に入るドラマがあるかもよ？』"
		   voices=""/>
		<msg @l="1894" char_id="0" frame_id="1" name="美帆"
		   text="『私、テレビを見るよりは本を読むことのほうが好きなんですよ‥‥だからドラマを見なくなっちゃうんですよね。』" voices=""/>
		<char @l="1897" id="rei" pos="right" src="rei031"/>
		<msg @l="1899" char_id="1" frame_id="-1" name="玲"
		   text="『あら、良いんじゃない、読書。本当はテレビを見るより本を読んだほうが良いんだから。』" voices=""/>
		<char @l="1903" id="rei" pos="right" src="rei034"/>
		<msg @l="1905" char_id="1" frame_id="-1" name="玲"
		   text="『そういえば私‥‥最近は会社案内書くらいしか読んでないわ。』" voices=""/>
		<char @l="1909" id="miho" pos="left" src="miho036"/>
		<msg @l="1911" char_id="0" frame_id="1" name="美帆" text="『就職活動、大変そうですものね。』"
		   voices=""/>
		<char @l="1915" id="rei" pos="right" src="rei030"/>
		<msg @l="1917" char_id="1" frame_id="-1" name="玲"
		   text="『そうねぇ‥‥実はこのドラマを見ているのも、今人気のドラマだから見といたほうが良いかなと思って見ていたのよね。まぁ、今まで就職試験に関係があったことは無いけど‥‥。』"
		   voices=""/>
		<char @l="1920" id="miho" pos="left" src="miho031"/>
		<msg @l="1922" char_id="0" frame_id="1" name="美帆"
		   text="『うふふっ、残念でしたね。でもいつか役に立つときが来るかもしれませんよ？』" voices=""/>
		<char @l="1926" id="miho" pos="left" src="miho030"/>
		<msg @l="1928" char_id="0" frame_id="1" name="美帆"
		   text="『ところで就職試験ってどんな準備をしてるんですか？』" voices=""/>
		<char @l="1931" id="rei" pos="right" src="rei030"/>
		<msg @l="1933" char_id="1" frame_id="-1" name="玲"
		   text="『筆記試験の為に、大学の研修で作成したレポートと、私の場合はデザイン方面だからオリジナルの図面を幾つか持っていけばＯＫだと思うわ。』"
		   voices=""/>
		<msg @l="1935" char_id="0" frame_id="1" name="美帆" text="『実践的なんですね。』"
		   voices=""/>
		<msg @l="1937" char_id="1" frame_id="-1" name="玲"
		   text="『学歴でデザインは出来ないもの。だからと言って勉強もおろそかには出来ないけれどね。』" voices=""/>
		<char @l="1941" id="miho" pos="left" src="miho034"/>
		<msg @l="1943" char_id="0" frame_id="1" name="美帆" text="『そうなんですか‥‥？』"
		   voices=""/>
		<msg @l="1945" char_id="1" frame_id="-1" name="玲"
		   text="『建築デザインって仕事は、外見だけじゃなくて実用性や耐久性も考慮に入れた上で設計しなければいけないから‥‥物理計算が必須事項なのよ。』"
		   voices=""/>
		<msg @l="1947" char_id="1" frame_id="-1" name="玲"
		   text="『あと、無機の材料化学なんかも必要な場合があるわね。』" voices=""/>
		<msg @l="1949" char_id="0" frame_id="1" name="美帆"
		   text="『へえ‥‥色々求められるんですね、建築デザイナーって。』" voices=""/>
		<msg @l="1951" char_id="1" frame_id="-1" name="玲" text="『その分、やりがいはあると思うわよ。』"
		   voices=""/>
		<char @l="1955" id="miho" pos="left" src="miho031"/>
		<msg @l="1957" char_id="0" frame_id="1" name="美帆" text="『かっこいいです。』"
		   voices=""/>
		<char @l="1961" id="rei" pos="right" src="rei031"/>
		<msg @l="1963" char_id="1" frame_id="-1" name="玲"
		   text="『そういう褒め言葉は、内定が出てからかけてちょうだい。』" voices=""/>
		<char @l="1967" id="rei" pos="right" src="rei030"/>
		<msg @l="1969" char_id="1" frame_id="-1" name="玲"
		   text="『目指すだけなら誰でも出来る‥‥問題は、目指した場所に足をかけることが出来るかどうかよ。』" voices=""/>
		<char @l="1972" id="miho" pos="left" src="miho030"/>
		<msg @l="1974" char_id="0" frame_id="1" name="美帆" text="『そうですね。』" voices=""/>
		<char @l="1977" id="miho" pos="left" src="miho136"/>
		<msg @l="1979" char_id="0" frame_id="1" name="美帆"
		   text="『私の場合は、まだ目指すものも決められませんけど‥‥。』" voices=""/>
		<msg @l="1981" char_id="1" frame_id="-1" name="玲"
		   text="『ぼやぼやしてると、来年困る事になるわよ。』" voices=""/>
		<char @l="1985" id="miho" pos="left" src="miho036"/>
		<msg @l="1987" char_id="0" frame_id="1" name="美帆" text="『が、頑張ります。』"
		   voices=""/>
		<msg @l="1989" char_id="-1" frame_id="-1" name=""
		   text="そう言ってふとテレビに目をやると、どこかで見たことのあるような大きな木が映っているＣＭが流れていた。綺麗なピアノの旋律と雄大な樹木をバックに、色んな会社の名前が次々とスクロールしていく。"
		   voices=""/>
		<msg @l="1991" char_id="-1" frame_id="-1" name="ＣＭ"
		   text="『あなたの街の未来を約束する大黒グループ。大黒グループの提供でお送りしました───。』" voices=""/>
		<char @l="1994" id="miho" pos="left" src="miho134"/>
		<msg @l="1996" char_id="0" frame_id="1" name="美帆"
		   text="『あっ、もしかしてこれってちょうど玲さんが受ける大黒建設なんですか？』" voices=""/>
		<char @l="1999" id="rei" pos="right" src="rei031"/>
		<msg @l="2001" char_id="1" frame_id="-1" name="玲"
		   text="『そうよ。やっぱりこれから就職しようとしている会社がスポンサーのドラマは確実に押さえておかないとまずいでしょう？』"
		   voices=""/>
		<msg @l="2003" char_id="0" frame_id="1" name="美帆"
		   text="『大黒グループって、こんなに大きいところなんですね。』" voices=""/>
		<msg @l="2005" char_id="1" frame_id="-1" name="玲"
		   text="『そうね。実際、この町にしても大黒建設だけじゃなくて、色々な産業から大黒グループが協力してくれているおかげで、これだけ大きくなったようなものらしいわよ。』"
		   voices=""/>
		<char @l="2008" id="miho" pos="left" src="miho131"/>
		<msg @l="2010" char_id="0" frame_id="1" name="美帆"
		   text="『へぇ～。やっぱり玲さんは凄いですね。』" voices=""/>
		<char @l="2013" id="rei" pos="right" src="rei030"/>
		<msg @l="2015" char_id="1" frame_id="-1" name="玲"
		   text="『こらこら、まだ受けようとしているだけで、全然凄くないわよ。』" voices=""/>
		<msg @l="2017" char_id="0" frame_id="1" name="美帆"
		   text="『でもきっと玲さんなら大丈夫ですよ。私、応援します。』" voices=""/>
		<char @l="2020" id="rei" pos="right" src="rei031"/>
		<msg @l="2022" char_id="1" frame_id="-1" name="玲" text="『ふふ、ありがと。』"
		   voices=""/>
		<eval @l="2025" expr="f.玲ルート確定flag&#32;=&#32;1&#13;&#10;"/>
		<label @l="2028" id="TempLabel_210"/>
		<label @l="2029" id="TempLabel_209"/>
		<stopbgm @l="2034" fadeout="1000"/>
		<clear @l="2040" class="all"/>
		<goto @l="2046" cond="!(f.亜季奈ルート確定flag&#32;==&#32;1)&#13;&#10;"
		   label="TempLabel_211"/>
		<call @l="2049" target="EventLabel_59@root_akina01"/>
		<return @l="2050" value="0&#13;&#10;"/>
		<goto @l="2053" label="TempLabel_236"/>
		<label @l="2054" id="TempLabel_211"/>
		<goto @l="2055" cond="!(f.玲ルート確定flag&#32;==&#32;1)&#13;&#10;"
		   label="TempLabel_237"/>
		<call @l="2060" target="EventLabel_130@root_rei01"/>
		<return @l="2061" value="0&#13;&#10;"/>
		<goto @l="2064" label="TempLabel_236"/>
		<label @l="2065" id="TempLabel_237"/>
		<call @l="2070" target="EventLabel_35@common_root05"/>
		<return @l="2071" value="0&#13;&#10;"/>
		<label @l="2074" id="TempLabel_236"/>
		<return @l="2078" value=""/>
	</code>
</xscript>
