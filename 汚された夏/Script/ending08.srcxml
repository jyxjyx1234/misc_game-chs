<?xml version="1.0" encoding="utf-8"?>
<xscript>
	<debug editor="&quot;C:\Program&#32;Files&#32;(x86)\sakura\sakura.exe&quot;&#32;&quot;%src%&quot;&#32;-Y=%line%"
	   src="D:\シロップ\町ぐるみの罠＋汚された夏セット版\汚された夏\完成データ\汚された夏\script\text\ending08.txt"/>
	<code>
		<label @l="12" id="EventLabel_46"/>
		<description @l="16" text="高級ヘルス嬢、美帆"/>
		<eval @l="18" expr="f.numDay=0&#13;&#10;"/>
		<wait_chgmv/>
		<bg @l="24" src="bg18a"/>
		<msg @l="27" char_id="-1" frame_id="-1" name="" text="―――数ヵ月後" voices=""/>
		<char @l="31" id="miho" pos="auto" src="miho124"/>
		<bgm @l="35" src="bgm02" volume="1."/>
		<msg @l="37" char_id="0" frame_id="-1" name="美帆" text="『やば、遅れちゃうっ！』"
		   voices="miho11750"/>
		<char @l="40" id="miho" pos="auto" src="miho120"/>
		<msg @l="42" char_id="-1" frame_id="-1" name=""
		   text="私は遅刻しそうになりながら、仕事場に向かって急いでいた。" voices=""/>
		<msg @l="43" char_id="-1" frame_id="-1" name="" text="あれからもう、数ヶ月が過ぎている。"
		   voices=""/>
		<msg @l="44" char_id="-1" frame_id="-1" name=""
		   text="朽木教授の斡旋で仕事を始めた私は、家族の為にお金を稼ごうと一生懸命働き続けていた。" voices=""/>
		<wait_chgmv/>
		<bg @l="47" src="black"/>
		<clear @l="49" class="char"/>
		<msg @l="52" char_id="-1" frame_id="-1" name="" text="でも‥‥いつからだろう。"
		   voices=""/>
		<msg @l="53" char_id="-1" frame_id="-1" name=""
		   text="仕事をする事が楽しいと感じるようになってきたのは。" voices=""/>
		<msg @l="54" char_id="-1" frame_id="-1" name=""
		   text="最初は昼に大学へ通い夜は仕事場へ向かうという二重の生活をしていたが、段々と仕事ばかりするようになり‥‥いつしか大学に行かなくなっていた――"
		   voices=""/>
		<clear @l="61" class="all"/>
		<msgshow @l="63" show="true"/>
		<label @l="67" id="event_scene26"/>
		<msg @l="69" char_id="-1" frame_id="-1" name=""
		   text="そして今日も仕事場である、高級ホテルの中へ私は入ってゆく。" voices=""/>
		<msg @l="71" char_id="0" frame_id="-1" name="美帆" text="『おはようございまーす。』"
		   voices="miho11760"/>
		<msg @l="73" char_id="-1" frame_id="-1" name=""
		   text="ホテルの受付にいるお姉さんに元気よく挨拶をする。" voices=""/>
		<msg @l="74" char_id="-1" frame_id="-1" name=""
		   text="この仕事を始めてから、内気だった頃が嘘みたいに明るくなれた。" voices=""/>
		<msg @l="75" char_id="-1" frame_id="-1" name=""
		   text="それも今の仕事が天職だったからだと‥‥今では思っている。" voices=""/>
		<msg @l="77" char_id="-1" frame_id="-1" name="案内員"
		   text="『美帆ちゃん、早速ご指名入ってるから準備お願いねー。』" voices=""/>
		<msg @l="79" char_id="0" frame_id="-1" name="美帆" text="『はーい。』"
		   voices="miho11770"/>
		<msg @l="81" char_id="-1" frame_id="-1" name=""
		   text="この町で唯一営業を認められている高級ソープ。" voices=""/>
		<msg @l="82" char_id="-1" frame_id="-1" name="" text="それが今の私の職場である。"
		   voices=""/>
		<msg @l="83" char_id="-1" frame_id="-1" name=""
		   text="この職場に勤める時、私は朽木教授から初めてこの町の計画を聞かされた。" voices=""/>
		<stopbgm @l="85" fadeout="1000"/>
		<msg @l="87" char_id="-1" frame_id="-1" name=""
		   text="何故風俗店がこの町には一つしかないのか、しかも利用するお客は一切お金を払わなくて良いのか‥‥。" voices=""/>
		<wait_chgmv/>
		<bg @l="90" src="bg23a"/>
		<msg @l="92" char_id="-1" frame_id="-1" name=""
		   text="実はこの南総町では、町全体を巨大な性欲処理場に変えるという計画が進められていた。人口減少と町の経済悪化を一気に改善させる為の計画だった。"
		   voices=""/>
		<msg @l="93" char_id="-1" frame_id="-1" name=""
		   text="誘致されてきた企業は社員証さえ見せれば無料で性的サービスが受けられるようになり、その見返りに企業は地元に多大な経済効果をもたらすのだ。"
		   voices=""/>
		<msg @l="94" char_id="-1" frame_id="-1" name=""
		   text="既に多数の大企業が進出を決定し、町のあらゆる商店や住宅で女性たちが夜の顔を持つようになっていった‥‥。" voices=""/>
		<msg @l="95" char_id="-1" frame_id="-1" name="" text="だが、風俗という響きが好きな奴もいた。"
		   voices=""/>
		<msg @l="96" char_id="-1" frame_id="-1" name=""
		   text="そんな風俗好きな奴の為、料金を支払わずともプレイができるというシステムがこの店らしい――。" voices=""/>
		<wait_chgmv/>
		<bg @l="99" src="black"/>
		<msg @l="101" char_id="-1" frame_id="-1" name=""
		   text="でも今となっては、そんな理由はもうどうでも良かった。" voices=""/>
		<msg @l="102" char_id="-1" frame_id="-1" name=""
		   text="最初は身体を売るという行為に嫌悪感を感じていたけれど‥‥身体を重ねる事で幸せを感じるようになり、エッチをする事も好きになった。"
		   voices=""/>
		<msg @l="103" char_id="-1" frame_id="-1" name=""
		   text="今では恋人のようなラブラブプレイをさせてくれるという事で、美帆は人気ナンバーワンになっていた。" voices=""/>
		<clear @l="110" class="all"/>
		<msg @l="113" char_id="-1" frame_id="-1" name=""
		   text="そして今日も美帆目当ての常連のお客さんが来て美帆とエッチを始める。" voices=""/>
		<msg @l="114" char_id="-1" frame_id="-1" name=""
		   text="今日の美帆の衣装は相手の趣味に合わせて、胸の部分の布がなく乳房がむき出しになっているチャイナ服だった。" voices=""/>
		<bgm @l="118" src="bgm04" volume="1."/>
		<msg @l="120" char_id="0" frame_id="-1" name="美帆"
		   text="『風間のオジサマー、３日間も連絡なくて寂しかったですー。美帆とキスしてー。』" voices=""/>
		<msg @l="122" char_id="-1" frame_id="-1" name=""
		   text="美帆は小悪魔風に言うといきなり風間の唇を奪う。柔らかく滑らかな舌が風間の口の中を動き回る。" voices=""/>
		<msg @l="124" char_id="0" frame_id="-1" name="美帆" text="『んはっ‥‥‥ん、んんっ！』"
		   voices=""/>
		<msg @l="126" char_id="-1" frame_id="-1" name=""
		   text="････････風間は商社の社長で年齢は５０歳を超えていたが、高級ソープに寄った際、美帆を指名するとお気に入りになり、週に３回程度は通う常連であった････････"
		   voices=""/>
		<msg @l="128" char_id="-1" frame_id="-1" name=""
		   text="風間も美帆の動きにあわせるように舌を絡めて口の中の感触を味わう。" voices=""/>
		<msg @l="129" char_id="-1" frame_id="-1" name=""
		   text="美帆は風間の口内を隅々まで舐めまわすテクニックに、頬を赤らめながら唇を離す。" voices=""/>
		<msg @l="131" char_id="0" frame_id="-1" name="美帆"
		   text="『ぷはぁっ････風間のオジサマ、キスが上手ですぅ。』" voices=""/>
		<msg @l="133" char_id="-1" frame_id="-1" name="風間のオジサマ"
		   text="『美帆の唇こそ相変わらず美味しいね。』" voices=""/>
		<msg @l="135" char_id="-1" frame_id="-1" name=""
		   text="そう言って風間は美帆の唇をぺろっと舐め、顎から首筋にかけてキスをしたかと思うと鎖骨の窪みに舌を這わせる。" voices=""/>
		<msg @l="137" char_id="0" frame_id="-1" name="美帆" text="『むぅぅ、んはぁぁ。』"
		   voices=""/>
		<msg @l="139" char_id="0" frame_id="-1" name="美帆"
		   text="『はぁはぁはぁ、凄く嬉しいです。オジサマ、大好き。』" voices=""/>
		<msg @l="141" char_id="-1" frame_id="-1" name=""
		   text="美帆はしがみつく様に抱きつき、風間の耳に舌を這わせて舐め始める。そして泡のついた両手で風間の胸、腰を愛撫する。" voices=""/>
		<msg @l="142" char_id="-1" frame_id="-1" name=""
		   text="さらに自分の胸を風間の胸板に押し付け、乳房を使ってこすり洗ってあげるのであった。" voices=""/>
		<msg @l="143" char_id="-1" frame_id="-1" name=""
		   text="すると、美帆の愛撫に風間の股間の男根は天を突いてそそり立つ。" voices=""/>
		<msg @l="145" char_id="0" frame_id="-1" name="美帆"
		   text="『うわっ、やっぱりいつみてもオジサマのは凄く大きいですね。』" voices=""/>
		<msg @l="147" char_id="-1" frame_id="-1" name=""
		   text="美帆はうっとりとした目で見ながら、１０本の指で風間の肉棒を包み込み蠢かせる。" voices=""/>
		<msg @l="149" char_id="-1" frame_id="-1" name="風間のオジサマ"
		   text="『じゃぁ、まずは素股で気持ちよくさせてもらおうかな。』" voices=""/>
		<msg @l="150" char_id="0" frame_id="-1" name="美帆" text="『はい。オジサマ。』"
		   voices=""/>
		<msg @l="152" char_id="-1" frame_id="-1" name=""
		   text="そう言って美帆は風間のそそり立った肉棒を太腿で挟む。" voices=""/>
		<label @l="156" id="chart_line40"/>
		<wait_chgmv/>
		<ev @l="160" src="ev-026"/>
		<msg @l="163" char_id="0" frame_id="-1" name="美帆"
		   text="『すごい‥‥‥おっきい‥‥‥‥‥‥ですっ。』" voices="miho10950"/>
		<msg @l="165" char_id="-1" frame_id="-1" name=""
		   text="美帆は太腿とマン●に泡をたっぷりとつけた後、風間の肉棒を挟み込み秘部にこすり付けるようにして腰を動かし始める。" voices=""/>
		<msg @l="167" char_id="-1" frame_id="-1" name="風間のオジサマ"
		   text="『おおっ、そう、もっと擦り付けて。』" voices=""/>
		<msg @l="169" char_id="-1" frame_id="-1" name="" text="そう言って美帆の太腿をつかみ動かす。"
		   voices=""/>
		<msg @l="171" char_id="0" frame_id="-1" name="美帆" text="『んはっ‥‥‥ん、んんっ！』"
		   voices="miho10960"/>
		<msg @l="173" char_id="-1" frame_id="-1" name="風間のオジサマ"
		   text="『そうだ、そう。私のモノをキミのマン●で挟み込むようにして、そうだ。』。" voices=""/>
		<msg @l="175" char_id="0" frame_id="-1" name="美帆" text="『んふぅ‥‥‥‥んっ‥‥あふっ。』"
		   voices="miho10970"/>
		<msg @l="177" char_id="-1" frame_id="-1" name="風間のオジサマ" text="『いいぞ。』"
		   voices=""/>
		<msg @l="179" char_id="-1" frame_id="-1" name=""
		   text="美帆は秘部を擦る風間の肉棒の感触に身体中を快感が突き抜け、切なげに風間の手を取って自分の胸に押し当てる。風間は美帆の乳房にやさしく刺激を与えながら指では乳首に刺激を与える。"
		   voices=""/>
		<msg @l="181" char_id="0" frame_id="-1" name="美帆" text="『ん、ん、ん、んんっ！』"
		   voices="miho10980"/>
		<msg @l="183" char_id="-1" frame_id="-1" name="風間のオジサマ"
		   text="『美帆、凄く可愛いよ。愛してるよ。』" voices=""/>
		<msg @l="185" char_id="-1" frame_id="-1" name=""
		   text="そう言って風間は手で、太腿、腰、お尻、胸と優しいタッチで刺激を与えていく。" voices=""/>
		<msg @l="186" char_id="-1" frame_id="-1" name=""
		   text="美帆は風間の言葉と、手の愛撫、そして秘部と肉棒がこすれる感覚に酔いしれオルガスムスを迎える。" voices=""/>
		<msg @l="188" char_id="0" frame_id="-1" name="美帆"
		   text="『あっ‥‥ああ‥‥‥‥‥も、ダメぇ‥‥‥‥‥。』" voices="miho07740"/>
		<msg @l="190" char_id="0" frame_id="-1" name="美帆" text="『んん――――っ！！』"
		   voices="miho11030"/>
		<msg @l="192" char_id="0" frame_id="-1" name="美帆" text="『ん、あああああああっ！！』"
		   voices="miho11040"/>
		<flash @l="196" count="4" fade="100" image="white"/>
		<msg @l="198" char_id="-1" frame_id="-1" name="風間のオジサマ"
		   text="『ふふっ、気持ちよくてイッちゃったようだね。』" voices=""/>
		<msg @l="200" char_id="0" frame_id="-1" name="美帆" text="『あ‥‥。』"
		   voices="miho11000"/>
		<msg @l="202" char_id="-1" frame_id="-1" name="風間のオジサマ"
		   text="『でも、まだ終わりじゃないよ。私はまだイッていないからね。キミのココに私のものを自分から入れるんだ。私のことが好きだろう？』"
		   voices=""/>
		<msg @l="204" char_id="-1" frame_id="-1" name=""
		   text="そう言って風間は秘裂に指を這わせて挿入を促す。美帆はその言葉に頬を赤くし潤んだ目でコクリと頷くのだった。" voices=""/>
		<msg @l="206" char_id="0" frame_id="-1" name="美帆" text="『は、はい‥‥。』"
		   voices="miho12760"/>
		<msg @l="208" char_id="-1" frame_id="-1" name=""
		   text="そして美帆は肉棒を自分の秘部にあてがうようにしてゆっくりと膣内に沈めていく。" voices=""/>
		<wait_chgmv/>
		<ev @l="211" src="ev-026x1"/>
		<msg @l="213" char_id="0" frame_id="-1" name="美帆" text="『んん――――っ！！』"
		   voices="miho11030"/>
		<msg @l="215" char_id="-1" frame_id="-1" name="風間のオジサマ"
		   text="『どうだい？一番奥まで入ったかい？』" voices=""/>
		<msg @l="217" char_id="0" frame_id="-1" name="美帆"
		   text="『んぁぁっ‥‥‥んくっ‥‥深い、ですっ。』" voices="miho10990"/>
		<msg @l="219" char_id="-1" frame_id="-1" name="風間のオジサマ"
		   text="『ふふっ、じゃあ今度は私が気持ちよくなるように動いてみてごらん。』" voices=""/>
		<msg @l="221" char_id="0" frame_id="-1" name="美帆" text="『は、はい‥‥。』"
		   voices="miho12760"/>
		<msg @l="223" char_id="0" frame_id="-1" name="美帆"
		   text="『それじゃ、ゆっくり動きますからね‥‥。』" voices="miho11800"/>
		<msg @l="225" char_id="-1" frame_id="-1" name=""
		   text="私はチャイナドレスの裾を持ち上げて、結合部を見せるようにしてゆっくりと腰を動かし始める。" voices=""/>
		<msg @l="226" char_id="-1" frame_id="-1" name=""
		   text="つい先ほどまで素股をして刺激を受けていたアソコは既に蜜でトロトロになっていて、腰をくねらせ抽送するたびにチュプチュプと水音が鳴り響く。"
		   voices=""/>
		<msg @l="228" char_id="0" frame_id="-1" name="美帆"
		   text="『あはっ‥‥凄い、奥まで届いちゃって‥‥‥ん、ああっ大きいっっ。』" voices="miho11810"/>
		<msg @l="230" char_id="-1" frame_id="-1" name=""
		   text="秘部の肉ヒダで肉竿を絡め上げるように、美帆は腰を前後左右に動かして肉棒をじっくり味わう。" voices=""/>
		<msg @l="231" char_id="-1" frame_id="-1" name=""
		   text="今回の体位だと、少し腰を沈めるとすぐに子宮の奥に先端が突き当たってしまう。" voices=""/>
		<msg @l="233" char_id="-1" frame_id="-1" name="風間のオジサマ"
		   text="『美帆の膣、すごく柔らかくて‥‥‥いいよぉ。』" voices=""/>
		<msg @l="235" char_id="0" frame_id="-1" name="美帆"
		   text="『んんっ‥‥まだまだ、もっと良くなりますよ～。』" voices="miho11820"/>
		<msg @l="237" char_id="-1" frame_id="-1" name=""
		   text="そう言って美帆は腰をくねらせて脈打つペニスをより深くまで受け入れると、きゅうっとアソコに力を入れて締め付ける。" voices=""/>
		<msg @l="239" char_id="-1" frame_id="-1" name="風間のオジサマ"
		   text="『お、おおっ‥‥それ凄い、凄いぞ。肉ヒダが絡みついてくるみたいだ。また上手くなったね美帆。』" voices=""/>
		<msg @l="241" char_id="0" frame_id="-1" name="美帆"
		   text="『んふふっ‥‥‥んんっ、喜んでもらえて、良かったですっ。』" voices="miho11830"/>
		<msg @l="243" char_id="-1" frame_id="-1" name=""
		   text="美帆は風間の言葉に喜び、さらに肉棒をアソコで締め上げながらストロークを早めていく。" voices=""/>
		<msg @l="244" char_id="-1" frame_id="-1" name=""
		   text="風間はその動きに合わせるように美帆の膣壁のもっとも敏感な部分を亀頭で擦り上げていく。" voices=""/>
		<msg @l="246" char_id="0" frame_id="-1" name="美帆"
		   text="『いっ‥‥ああ、あああっっ‥‥‥んくっ。』" voices="miho11020"/>
		<msg @l="248" char_id="-1" frame_id="-1" name=""
		   text="風間は美帆の弱いところを熟知していた。自分が感じた時に美帆も一緒に感じるようにと時折敏感なところを責めたてる。" voices=""/>
		<msg @l="250" char_id="0" frame_id="-1" name="美帆"
		   text="『んぁぁっ‥‥‥んくっ‥‥深い、ですっ。』" voices="miho10990"/>
		<msg @l="252" char_id="-1" frame_id="-1" name="風間のオジサマ"
		   text="『まだだよ‥‥美帆、私より先にイっちゃ駄目だからね。』" voices=""/>
		<msg @l="254" char_id="0" frame_id="-1" name="美帆"
		   text="『あんっ‥‥意地悪しないで、イカせてくださいっ‥‥‥あふっ。』" voices="miho11850"/>
		<msg @l="256" char_id="-1" frame_id="-1" name="風間のオジサマ"
		   text="『じゃあ、私をもっと気持ちよくさせていっしょにいかせて見なさい。』" voices=""/>
		<msg @l="257" char_id="-1" frame_id="-1" name=""
		   text="その言葉に美帆は舌でぺろりと唇を舐めると小悪魔的な表情を浮かべた。" voices=""/>
		<msg @l="259" char_id="0" frame_id="-1" name="美帆"
		   text="『それじゃ、そろそろ本気でいきますよ～。』" voices="miho11860"/>
		<msg @l="262" char_id="-1" frame_id="-1" name=""
		   text="美帆はそれまでのラブラブ恋人モードから一変して、風間をイかせる為の本気モードへと動きを切り替える。" voices=""/>
		<msg @l="264" char_id="0" frame_id="-1" name="美帆" text="『ん、んんっ‥‥‥んぁぁっ。』"
		   voices="miho10940"/>
		<msg @l="266" char_id="0" frame_id="-1" name="美帆" text="『んっ、んっ、んんっ！』"
		   voices="miho11870"/>
		<msg @l="268" char_id="-1" frame_id="-1" name=""
		   text="私は陰茎を深く咥えこんだまより強く膣壁をきゅうっと締め付けると、風間の上で跳ねるように腰を動かしストロークを早める。"
		   voices=""/>
		<msg @l="269" char_id="-1" frame_id="-1" name=""
		   text="すると室内には腰を打ち付ける音とぐちゅぐちゅという卑猥な音がこだまし卑猥さを増した。" voices=""/>
		<msg @l="270" char_id="-1" frame_id="-1" name=""
		   text="美帆は風間を激しく責め立てながらも、先端を自分の弱い所に押し当てて一緒に絶頂をするようにコントロールするのも忘れていない。"
		   voices=""/>
		<msg @l="272" char_id="-1" frame_id="-1" name="風間のオジサマ"
		   text="『うおっ‥‥いいよ美帆、それ凄くいいぞ！』" voices=""/>
		<msg @l="274" char_id="0" frame_id="-1" name="美帆"
		   text="『ああっ‥‥私も、先っぽが奥に当たって、んんっ‥‥‥ふあっ！！』" voices="miho11880"/>
		<msg @l="276" char_id="-1" frame_id="-1" name="風間のオジサマ"
		   text="『美帆も気持ち良いか？私のモノは最高か？』" voices=""/>
		<msg @l="278" char_id="0" frame_id="-1" name="美帆"
		   text="『いいっ‥‥あっ、んんっ‥‥‥気持ち良いですっ、おち○ちん気持ち良いです。ん、あふっ！』" voices="miho11890"/>
		<msg @l="280" char_id="-1" frame_id="-1" name=""
		   text="私は空いた手で熱く火照った乳房を強く揉みしだき、その先端で一層熱くなっている乳首を指先で転がす。" voices=""/>
		<msg @l="281" char_id="-1" frame_id="-1" name=""
		   text="そうして自分で乳首をいじくるたびに私の子宮はビクビクとひとりでに痙攣し、更に激しく肉棒を締め付けていく。" voices=""/>
		<msg @l="283" char_id="-1" frame_id="-1" name="風間のオジサマ"
		   text="『そ‥‥そろそろだ‥‥‥もうイクぞ‥‥‥‥。』" voices=""/>
		<msg @l="285" char_id="-1" frame_id="-1" name=""
		   text="搾り取るような膣壁のうねりに悲鳴をあげるように、風間が震えた声をあげて腰を突き上げてくる。" voices=""/>
		<msg @l="287" char_id="0" frame_id="-1" name="美帆"
		   text="『んんっ、いっぱい‥‥‥中に出してくださいねっ‥‥んんっ‥‥ああっ！』" voices="miho11900"/>
		<msg @l="289" char_id="-1" frame_id="-1" name=""
		   text="美帆はそんな風間の声に反応して、スパートをかけるように一気に腰の動きを加速させていく。" voices=""/>
		<msg @l="291" char_id="0" frame_id="-1" name="美帆"
		   text="『あっ、あっ、あっ‥‥‥いいっ、あああっ！！』" voices="miho11910"/>
		<msg @l="293" char_id="0" frame_id="-1" name="美帆"
		   text="『い、いきますっ‥‥私も、いくっ‥‥‥いく、いくいくっ‥‥いっちゃうっっ！！』" voices="miho11920"/>
		<msg @l="295" char_id="-1" frame_id="-1" name="風間のオジサマ" text="『わ、私もイクぞ！！』"
		   voices=""/>
		<flash @l="299" count="4" fade="100" image="white"/>
		<msg @l="301" char_id="0" frame_id="-1" name="美帆"
		   text="『あっ、ああっ‥‥‥んっ、あああっ！！』" voices="miho11930"/>
		<msg @l="303" char_id="-1" frame_id="-1" name=""
		   text="キュウッと締め上げた瞬間、熱い樹液がドクドクドクと放出される。膣壁に染み渡る精液の熱さに、私は腰を震わせて絶頂に達した。"
		   voices=""/>
		<msg @l="304" char_id="-1" frame_id="-1" name=""
		   text="私は全身をその快楽に身を委ねてから‥‥ぐったりと風間の胸の上にもたれかかる。" voices=""/>
		<clear @l="310" class="all"/>
		<msg @l="312" char_id="0" frame_id="-1" name="美帆"
		   text="『はぁっ‥‥はぁっ‥‥はぁっ‥‥‥んっ、あふぅ‥‥‥‥。』" voices="miho11940"/>
		<msg @l="314" char_id="-1" frame_id="-1" name="風間のオジサマ"
		   text="『ふふっ、美帆は二度もイッちゃったね。』" voices=""/>
		<msg @l="316" char_id="0" frame_id="-1" name="美帆"
		   text="『んんっ‥‥‥だって、凄く気持ち良いから‥‥‥‥。』" voices="miho11950"/>
		<msg @l="318" char_id="-1" frame_id="-1" name=""
		   text="そう言って美帆は余韻に浸るように風間にキスをし愛おしむように唇を貪る。" voices=""/>
		<msg @l="319" char_id="-1" frame_id="-1" name="" text="美帆はこの瞬間幸せを感じていた。"
		   voices=""/>
		<msg @l="320" char_id="-1" frame_id="-1" name=""
		   text="今まで“幸せ”をあまり感じる事が出来なかったが、この仕事を通して人と身体を重ねる事で幸せを感じることが出来るようになったのだ。それが良いことなのか悪い事なのかは分からないけど、今はこの幸せに身を委ねていたかった――。"
		   voices=""/>
		<stopbgm @l="325" fadeout="1000"/>
		<clear @l="331" class="all"/>
		<end_scene @l="334"/>
		<return @l="340" value=""/>
	</code>
</xscript>
