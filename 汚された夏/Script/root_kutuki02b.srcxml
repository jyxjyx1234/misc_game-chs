<?xml version="1.0" encoding="utf-8"?>
<xscript>
	<debug editor="&quot;C:\Program&#32;Files&#32;(x86)\sakura\sakura.exe&quot;&#32;&quot;%src%&quot;&#32;-Y=%line%"
	   src="D:\シロップ\町ぐるみの罠＋汚された夏セット版\汚された夏\完成データ\汚された夏\script\text\root_kutuki02b.txt"/>
	<code>
		<label @l="13" id="EventLabel_112"/>
		<description @l="17" text="契約を拒んだ結果"/>
		<eval @l="19" expr="f.numDay=5&#13;&#10;"/>
		<msgshow @l="21" show="false"/>
		<wait_chgmv/>
		<bg @l="23" src="day05" time="2000"/>
		<wait @l="25" time="500"/>
		<wait_chgmv/>
		<bg @l="27" src="black" time="2000"/>
		<msgshow @l="29" show="true"/>
		<wait_chgmv/>
		<bg @l="32" src="bg09"/>
		<char @l="34" id="miho" pos="auto" src="miho115"/>
		<msg @l="36" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="38" char_id="-1" frame_id="-1" name=""
		   text="翌日の昼休み‥‥私は朽木教授の教授室の前に来ていた。" voices=""/>
		<msg @l="39" char_id="-1" frame_id="-1" name=""
		   text="目的はもちろん父の濡れ衣を晴らすため、である。" voices=""/>
		<se @l="42" buf="1" src="ノック" volume="1."/>
		<msg @l="44" char_id="0" frame_id="-1" name="美帆" text="『‥‥失礼します。』" voices=""/>
		<bgm @l="47" src="bgm03" volume="1."/>
		<wait_chgmv/>
		<bg @l="50" src="bg12"/>
		<char @l="52" id="miho" pos="auto" src="miho015"/>
		<msg @l="54" char_id="0" frame_id="-1" name="美帆" text="『教授、今日はお話があって伺いました。』"
		   voices=""/>
		<clear @l="57" class="char"/>
		<char @l="59" id="miho" pos="right" src="miho015"/>
		<char @l="61" id="kutsu" pos="left" src="kutsu010"/>
		<msg @l="63" char_id="-1" frame_id="-1" name="朽木" text="『ああ、キミか‥‥意外と早かったな。』"
		   voices=""/>
		<msg @l="65" char_id="-1" frame_id="-1" name="朽木"
		   text="『私はてっきりもう少し事が進んでから来るものかと思っていたよ。』" voices=""/>
		<char @l="68" id="miho" pos="right" src="miho115"/>
		<msg @l="70" char_id="0" frame_id="-1" name="美帆"
		   text="『やっぱり‥‥父の横領容疑は、教授が仕向けた事だったんですね。』" voices=""/>
		<msg @l="72" char_id="-1" frame_id="-1" name="朽木" text="『仕向けたというのは人聞きが悪いな。』"
		   voices=""/>
		<msg @l="74" char_id="-1" frame_id="-1" name="朽木"
		   text="『私は彼の罪を白日の元にさらす手助けをしてやっただけだよ。』" voices=""/>
		<msg @l="76" char_id="0" frame_id="-1" name="美帆"
		   text="『嘘です！&#32;父が横領なんてするハズありません！』" voices=""/>
		<char @l="79" id="kutsu" pos="left" src="kutsu018"/>
		<msg @l="81" char_id="-1" frame_id="-1" name="朽木"
		   text="『そうだな、彼自身はとても誠実で清廉潔白な男だ。』" voices=""/>
		<msg @l="83" char_id="-1" frame_id="-1" name="朽木"
		   text="『間違っても自分から会社の金を横領しようなどとは考えないだろうな。』" voices=""/>
		<char @l="86" id="miho" pos="right" src="miho114"/>
		<msg @l="88" char_id="0" frame_id="-1" name="美帆" text="『父を‥‥知っているんですか‥‥‥？』"
		   voices=""/>
		<msg @l="90" char_id="-1" frame_id="-1" name="朽木"
		   text="『ああ。彼の勤めている大黒製薬には一人友人がいてね。』" voices=""/>
		<char @l="93" id="miho" pos="right" src="miho015"/>
		<msg @l="95" char_id="0" frame_id="-1" name="美帆"
		   text="『なら、どうして父にそんな濡れ衣を着せたりするんですかっ！』" voices=""/>
		<char @l="98" id="kutsu" pos="left" src="kutsu010"/>
		<msg @l="100" char_id="-1" frame_id="-1" name="朽木"
		   text="『だから言っただろう、私は彼の罪を白日の元にさらしたに過ぎない。』" voices=""/>
		<msg @l="102" char_id="-1" frame_id="-1" name="朽木"
		   text="『彼はね、直属の部下の一人が五年間に渡って行い続けていた横領行為をすべて自分の責任として被ったのだよ。』" voices=""/>
		<char @l="105" id="miho" pos="right" src="miho014"/>
		<msg @l="107" char_id="0" frame_id="-1" name="美帆" text="『え‥‥。』" voices=""/>
		<char @l="110" id="kutsu" pos="left" src="kutsu018"/>
		<msg @l="112" char_id="-1" frame_id="-1" name="朽木"
		   text="『彼はとても誠実な男だ。だが今回はそれが仇となったようだな。』" voices=""/>
		<msg @l="114" char_id="-1" frame_id="-1" name="朽木"
		   text="『私は警察に情報をリークしたのではなく、彼自身に部下の横領行為についてを教えて差し上げたのだ。』" voices=""/>
		<msg @l="116" char_id="0" frame_id="-1" name="美帆" text="『それって‥‥どういうことですか？』"
		   voices=""/>
		<msg @l="118" char_id="-1" frame_id="-1" name="朽木"
		   text="『部下の責任は上司の責任だと彼はそう言っていたよ。横領に気付かなかった自分が悪いとね。』" voices=""/>
		<char @l="121" id="miho" pos="right" src="miho015"/>
		<msg @l="123" char_id="0" frame_id="-1" name="美帆"
		   text="『だからって‥‥何も父だけが罪を背負う必要なんてっ！』" voices=""/>
		<char @l="126" id="kutsu" pos="left" src="kutsu010"/>
		<msg @l="128" char_id="-1" frame_id="-1" name="朽木"
		   text="『さて、それは私の預かり知るところではないな。』" voices=""/>
		<msg @l="130" char_id="0" frame_id="-1" name="美帆"
		   text="『父の濡れ衣を晴らしてくださいっ‥‥そうすれば、今度こそ私は教授の言う事をなんでも聞きますから！』" voices=""/>
		<char @l="133" id="kutsu" pos="left" src="kutsu014"/>
		<msg @l="135" char_id="-1" frame_id="-1" name="朽木" text="『甘ったれるな！』"
		   voices=""/>
		<char @l="138" id="miho" pos="right" src="miho115"/>
		<msg @l="140" char_id="0" frame_id="-1" name="美帆" text="『っっっ！？』" voices=""/>
		<char @l="143" id="kutsu" pos="left" src="kutsu010"/>
		<msg @l="145" char_id="-1" frame_id="-1" name="朽木"
		   text="『キミは既に一度、自分の都合で契約を不履行にしているのだよ？』" voices=""/>
		<msg @l="147" char_id="-1" frame_id="-1" name="朽木"
		   text="『それを、更に自分の都合でもう一度契約の結び直しを要求するなど馬鹿げているとは思わんのかね！？』" voices=""/>
		<msg @l="149" char_id="0" frame_id="-1" name="美帆" text="『そんなっ‥‥私は‥‥‥。』"
		   voices=""/>
		<msg @l="151" char_id="-1" frame_id="-1" name="朽木"
		   text="『それにね、残念ながら警察を動かしてしまった以上は幾ら私といえども全てを白紙に戻す事は出来ない。』" voices=""/>
		<char @l="154" id="kutsu" pos="left" src="kutsu018"/>
		<msg @l="156" char_id="-1" frame_id="-1" name="朽木"
		   text="『例え仲根啓三氏が部下の横領をかばいだてしている事が明白になったとしても、会社としてはやはり彼を解雇しなければならないだろう。』"
		   voices=""/>
		<char @l="159" id="miho" pos="right" src="miho015"/>
		<msg @l="161" char_id="0" frame_id="-1" name="美帆"
		   text="『そ、そんなっ‥‥それじゃあ‥‥‥‥。』" voices=""/>
		<msg @l="163" char_id="-1" frame_id="-1" name="朽木"
		   text="『良くて失業、悪ければ前科持ちというわけだ。』" voices=""/>
		<char @l="166" id="miho" pos="right" src="miho115"/>
		<msg @l="168" char_id="0" frame_id="-1" name="美帆" text="『くっ‥‥ひどい‥‥‥。』"
		   voices=""/>
		<char @l="171" id="kutsu" pos="left" src="kutsu010"/>
		<msg @l="173" char_id="-1" frame_id="-1" name="朽木"
		   text="『ひどい？&#32;笑わせないでくれたまえ。』" voices=""/>
		<msg @l="175" char_id="-1" frame_id="-1" name="朽木"
		   text="『それもこれも、すべてはキミのせいだろう！』" voices=""/>
		<msg @l="177" char_id="0" frame_id="-1" name="美帆" text="『うっ‥‥‥うぅ‥‥‥‥‥‥。』"
		   voices=""/>
		<msg @l="179" char_id="-1" frame_id="-1" name="朽木"
		   text="『泣けばよいという問題ではないと思うがね？』" voices=""/>
		<msg @l="181" char_id="0" frame_id="-1" name="美帆"
		   text="『ど、どうすれば‥‥‥‥私は、どうすればいいんですかっ。』" voices=""/>
		<msg @l="183" char_id="0" frame_id="-1" name="美帆"
		   text="『どうすれば父を‥‥家族を、助けて‥‥‥‥ううっ‥‥‥。』" voices=""/>
		<clear @l="186" layer="miho"/>
		<msg @l="188" char_id="-1" frame_id="-1" name=""
		   text="私は、思わずその場に泣き崩れてしまっていた。" voices=""/>
		<msg @l="189" char_id="-1" frame_id="-1" name="" text="もう‥‥どうしていいのかわからなかった。"
		   voices=""/>
		<msg @l="191" char_id="-1" frame_id="-1" name="朽木" text="『‥‥‥‥。』" voices=""/>
		<msg @l="193" char_id="-1" frame_id="-1" name="朽木" text="『‥‥顔を上げたまえ。』"
		   voices=""/>
		<char @l="196" id="miho" pos="right" src="miho015"/>
		<msg @l="198" char_id="0" frame_id="-1" name="美帆" text="『うっ‥‥うぅっ‥‥‥。』"
		   voices=""/>
		<char @l="201" id="kutsu" pos="left" src="kutsu018"/>
		<bgm @l="204" src="bgm15" volume="1."/>
		<msg @l="206" char_id="-1" frame_id="-1" name="朽木"
		   text="『キミがそれほどまでに家族を助けたいのならば、一つ手を貸してあげようじゃないか。』" voices=""/>
		<char @l="209" id="miho" pos="right" src="miho114"/>
		<msg @l="211" char_id="0" frame_id="-1" name="美帆" text="『え‥‥ほ、ほんとうですかっ！？』"
		   voices=""/>
		<msg @l="213" char_id="-1" frame_id="-1" name="朽木"
		   text="『ああ。君の父については濡れ衣であると弁明するまでは力を貸す事も出来るだろうが‥‥残念ながら失業に関してはどうしようもない。』"
		   voices=""/>
		<msg @l="215" char_id="-1" frame_id="-1" name="朽木"
		   text="『彼の為に用意していた椅子は、もう既に他の人間に与えてしまったからな。』" voices=""/>
		<char @l="217" id="miho" pos="right" src="miho015"/>
		<msg @l="219" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="221" char_id="-1" frame_id="-1" name="朽木"
		   text="『だが、キミの家族の経済的な問題を解決する事は出来る。』" voices=""/>
		<char @l="224" id="miho" pos="right" src="miho115"/>
		<msg @l="226" char_id="0" frame_id="-1" name="美帆" text="『どう‥‥するんですか？』"
		   voices=""/>
		<char @l="229" id="kutsu" pos="left" src="kutsu010"/>
		<msg @l="231" char_id="-1" frame_id="-1" name="朽木"
		   text="『キミが働けば良い。大学に通いながら働くことのできる就職口を私が斡旋してあげよう。』" voices=""/>
		<msg @l="233" char_id="-1" frame_id="-1" name="朽木"
		   text="『そうしてキミの学費をすべて自分で負担すれば良い。奨学金が降りたとでも言っておけば家族も心配はしまい？』" voices=""/>
		<msg @l="235" char_id="-1" frame_id="-1" name="" text="そう言って、教授はニタリと笑う。"
		   voices=""/>
		<msg @l="236" char_id="-1" frame_id="-1" name=""
		   text="このとき、私は自分の些細な行動で家族の幸せを壊してしまったという罪悪感で一杯になっていたせいで何もかもが霞んでしまっていた。"
		   voices=""/>
		<msg @l="237" char_id="-1" frame_id="-1" name="" text="自暴自棄とでもいうべきだろうか。"
		   voices=""/>
		<msg @l="238" char_id="-1" frame_id="-1" name="" text="だから、気付かなかったのだ。"
		   voices=""/>
		<msg @l="239" char_id="-1" frame_id="-1" name=""
		   text="彼の笑みの裏側に‥‥邪悪なモノが潜んでいる事に。" voices=""/>
		<msg @l="240" char_id="-1" frame_id="-1" name="" text="そして‥‥。" voices=""/>
		<char @l="243" id="miho" pos="right" src="miho015"/>
		<msg @l="245" char_id="0" frame_id="-1" name="美帆" text="『はい‥‥お願いします。』"
		   voices=""/>
		<msg @l="247" char_id="-1" frame_id="-1" name="" text="私はゆっくりと、彼の言葉に頷いていた。"
		   voices=""/>
		<clear @l="253" class="all"/>
		<msgshow @l="255" show="true"/>
		<call @l="259" target="EventLabel_46@ending08"/>
		<return @l="260" value="0&#13;&#10;"/>
		<return @l="264" value=""/>
	</code>
</xscript>
