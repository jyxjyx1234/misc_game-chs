<?xml version="1.0" encoding="utf-8"?>
<xscript>
	<debug editor="&quot;C:\Program&#32;Files&#32;(x86)\sakura\sakura.exe&quot;&#32;&quot;%src%&quot;&#32;-Y=%line%"
	   src="D:\シロップ\町ぐるみの罠＋汚された夏セット版\汚された夏\完成データ\汚された夏\script\text\ex_ending02.txt"/>
	<code>
		<label @l="12" id="EventLabel_56"/>
		<msg @l="16" char_id="-1" frame_id="-1" name="" text="‥‥‥‥‥‥‥‥‥‥‥‥。"
		   voices=""/>
		<msg @l="17" char_id="-1" frame_id="-1" name="" text="‥‥‥‥‥‥‥‥。" voices=""/>
		<msg @l="18" char_id="-1" frame_id="-1" name="" text="‥‥‥‥。" voices=""/>
		<bgm @l="22" src="bgm04" volume="1."/>
		<wait_chgmv/>
		<bg @l="26" src="bg18a"/>
		<msg @l="28" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="30" char_id="-1" frame_id="-1" name=""
		   text="あれから1年近くが過ぎ‥‥春が訪れる。あと数日もすれば進級という時期まで季節も移り変わっていた。" voices=""/>
		<msg @l="31" char_id="-1" frame_id="-1" name=""
		   text="私はテニス部の人たちに調教されるうちに苛められる快感に目覚め、この“南総町の住人”としてずいぶんと馴染んできたように思う。"
		   voices=""/>
		<wait_chgmv/>
		<bg @l="34" src="black"/>
		<wait_chgmv/>
		<bg @l="36" src="bg23a"/>
		<msg @l="38" char_id="-1" frame_id="-1" name=""
		   text="―――実はこの“南総町”では、人口減少と経済悪化の問題を解決する為に、町全体を巨大な性欲処理場に変えるという計画が進められていた。"
		   voices=""/>
		<msg @l="39" char_id="-1" frame_id="-1" name=""
		   text="この計画により、誘致されてきた企業は社員証さえ見せれば無料で性的サービスが受けられる。その見返りとして企業は地元に多大な経済効果をもたらすのだ。"
		   voices=""/>
		<msg @l="40" char_id="-1" frame_id="-1" name=""
		   text="既に多数の大企業が進出を決定し、町のあらゆる商店や住宅で女性たちが夜の顔を持つようになっていった―――" voices=""/>
		<msg @l="42" char_id="-1" frame_id="-1" name=""
		   text="私は教えられるまでその事実に気づかなかったが、町中で衆人環視プレイをさせられた際、通りがかりの人は特に驚かずむしろ当たり前のように参加さえしてきたので実感するようになった。"
		   voices=""/>
		<msg @l="44" char_id="-1" frame_id="-1" name=""
		   text="私も最初は嫌がったが、調教されエッチをする喜びに目覚めると進んでこの町のシステムを受け入れるようになった――" voices=""/>
		<wait_chgmv/>
		<bg @l="47" src="black"/>
		<wait_chgmv/>
		<bg @l="49" src="bg18a"/>
		<msg @l="51" char_id="-1" frame_id="-1" name=""
		   text="それに‥‥私の周囲でも色々なことが変わってきていた。" voices=""/>
		<msg @l="52" char_id="-1" frame_id="-1" name=""
		   text="亜季奈が一度実家に戻ったが部活をしている際に部員とエッチしているところを教師に目撃され転校させられる。その時稲庭さんと熊野さんの取り計らいで亜季奈はこの町の学園に転校をしてきたのだった。"
		   voices=""/>
		<msg @l="53" char_id="-1" frame_id="-1" name=""
		   text="でも亜季奈の性格を考えると、わざと見つかったというよりはむしろ転校する為に見つかったような気もするが････。" voices=""/>
		<msg @l="54" char_id="-1" frame_id="-1" name=""
		   text="今では特別措置として学園に通う傍ら臨時コーチとして大学水泳部の人たちの為に“色々な事”を教えている。" voices=""/>
		<msg @l="55" char_id="-1" frame_id="-1" name=""
		   text="････いつもプールで出来るのは羨ましい････。" voices=""/>
		<msg @l="57" char_id="0" frame_id="1" name="美帆"
		   text="（今度お願いしてプール使わせてもらおうかな････）" voices=""/>
		<wait_chgmv/>
		<bg @l="59" src="black"/>
		<msg @l="60" char_id="-1" frame_id="-1" name=""
		   text="そうそう････忘れていたが亜季奈が住んでいる所は大学の合宿所で熊野さんと一緒に住んでいるらしい。" voices=""/>
		<msg @l="61" char_id="-1" frame_id="-1" name=""
		   text="一緒に住んで姉妹プレイでもどう、と誘ったのだけれど複数の男性に犯されたい願望があるらしく合宿所に住み込むことにしたみたい。残念･･････。"
		   voices=""/>
		<msg @l="62" char_id="-1" frame_id="-1" name=""
		   text="ん････そうだ確か渡部先生も一緒に移ってきたんだっけ。" voices=""/>
		<msg @l="64" char_id="0" frame_id="1" name="美帆"
		   text="（今頃プールで楽しくエッチしているかなー。）" voices=""/>
		<msg @l="66" char_id="-1" frame_id="-1" name="" text="････････････････････。"
		   voices=""/>
		<stopbgm @l="70" fadeout="1000"/>
		<clear @l="76" class="all"/>
		<msgshow @l="78" show="true"/>
		<bgm @l="82" src="bgm06" volume="1."/>
		<wait_chgmv/>
		<bg @l="87" src="bg10am1"/>
		<msg @l="89" char_id="2" frame_id="-1" name="亜季奈"
		   text="『はーい、それじゃあ今日もしっかりと練習しましょーね！』" voices=""/>
		<msg @l="91" char_id="-1" frame_id="-1" name=""
		   text="そう言って、亜季奈は渡部特製の水着姿でプールサイドに歩み出る。" voices=""/>
		<msg @l="92" char_id="-1" frame_id="-1" name=""
		   text="もっとも渡部特製といっても、水着の胸と股間の部分にある布地を綺麗にハサミで切り抜いて乳首とオマ●コを露出させたものだ。"
		   voices=""/>
		<msg @l="94" char_id="-1" frame_id="-1" name="水泳部員Ａ"
		   text="『おい見ろよ‥‥亜季奈ちゃん今日も濡れ濡れだぜ。』" voices=""/>
		<msg @l="96" char_id="-1" frame_id="-1" name="水泳部員Ｂ"
		   text="『まだ水に入ってないから水着濡れていないのに‥‥アソコから太腿にかけてマン汁がたれているぜ。』" voices=""/>
		<msg @l="98" char_id="-1" frame_id="-1" name=""
		   text="水泳部員たちは亜季奈のその格好を見てニヤニヤと嬉しそうに見ている。" voices=""/>
		<msg @l="99" char_id="-1" frame_id="-1" name=""
		   text="それでも亜季奈は平然とプールサイドを歩き、水泳部員たちの前で立ち止まる。" voices=""/>
		<msg @l="100" char_id="2" frame_id="-1" name="亜季奈"
		   text="『とりあえずウォームアップに２５ｍの自由形を３本、それが終わった人から順番に５０ｍのタイムを計っていくからね！もちろん今日も上位３番まで入った人はご褒美ありだよー。』"
		   voices=""/>
		<msg @l="102" char_id="-1" frame_id="-1" name=""
		   text="そう言うと亜季奈は水泳部員の側に立ちそっと股間を撫で上げる。" voices=""/>
		<msg @l="104" char_id="-1" frame_id="-1" name="水泳部員Ａ" text="『う、うぉっ。』"
		   voices=""/>
		<msg @l="106" char_id="2" frame_id="-1" name="亜季奈"
		   text="『えへっ、頑張ってね。これを突き刺してくれるの待ってるから。』" voices=""/>
		<msg @l="108" char_id="-1" frame_id="-1" name="水泳部員Ａ" text="『は、はいっ！』"
		   voices=""/>
		<msg @l="110" char_id="-1" frame_id="-1" name="水泳部員Ｂ" text="『ういっす！』"
		   voices=""/>
		<msg @l="112" char_id="-1" frame_id="-1" name=""
		   text="亜季奈は股間をパンパンにした彼らの姿を見ていると、肉棒に串刺しにされるのを想像してしまい、秘部より“くちゅっ”という淫らな音をさせていた。"
		   voices=""/>
		<stopbgm @l="115" fadeout="1000"/>
		<clear @l="121" class="all"/>
		<label @l="124" id="event_scene70"/>
		<se @l="127" buf="1" src="ホイッスル（室内プール）" volume="1."/>
		<msg @l="129" char_id="2" frame_id="-1" name="亜季奈" text="『はーい！おしまいだよー！』"
		   voices=""/>
		<msg @l="131" char_id="-1" frame_id="-1" name=""
		   text="亜季奈の吹くホイッスルの音と共に練習が終わる。" voices=""/>
		<msg @l="133" char_id="2" frame_id="-1" name="亜季奈"
		   text="『じゃあ、今日も成績が良かった順に3位までの人は残ってねー。後の人達は残って練習していてもいいし、ご褒美タイムを見ていってもいいからねー。』"
		   voices=""/>
		<msg @l="135" char_id="-1" frame_id="-1" name=""
		   text="亜季奈はそう言うと、成績の良かった3人は亜季奈を抱えてプールに飛び込む。" voices=""/>
		<se @l="138" buf="1" src="飛び込む音" volume="1."/>
		<msg @l="140" char_id="2" frame_id="-1" name="亜季奈"
		   text="『ぷはぁ！びっくりしたー！もうせっかちなんだからー。』" voices=""/>
		<bgm @l="143" src="bgm04" volume="1."/>
		<msg @l="145" char_id="-1" frame_id="-1" name=""
		   text="水の中から顔を出した亜季奈は頬を“ぷーっ”と膨らませて言う。しかし水泳部員は亜季奈の言葉などお構い無しに、オッパイやお尻を触り始める。"
		   voices=""/>
		<msg @l="147" char_id="-1" frame_id="-1" name="水泳部員Ｂ"
		   text="『おおーっ！やっぱり亜季奈ちゃんのオマ●コ柔らけーなー。』" voices=""/>
		<msg @l="149" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んんっ！もう、そんなに焦んなくたって好きなだけやらせてあげるからー。ほらココも触ってー。』" voices=""/>
		<msg @l="151" char_id="-1" frame_id="-1" name=""
		   text="亜季奈はそう言うと水泳部員の手を取って自分のオマ●コに触らせる。" voices=""/>
		<msg @l="153" char_id="2" frame_id="-1" name="亜季奈"
		   text="『ね。ココをぐちゅぐちゅに弄って、キミの馬のようなココで突き刺してー。』" voices=""/>
		<msg @l="154" char_id="-1" frame_id="-1" name="水泳部員Ａ"
		   text="『でもすぐに入れたら亜季奈ちゃんだけ何もしないで気持ちよくなれちゃうから、俺達と同じで少しお預けしちゃおうかなー。』"
		   voices=""/>
		<msg @l="156" char_id="-1" frame_id="-1" name=""
		   text="目配せをした水泳部員達はそう言うと、亜季奈の秘部に指を３本も入れてぐちゅぐちゅとかき回す。他の二人は乳首をつまんだり、キスして口の中に唾液を流し込んだりした。"
		   voices=""/>
		<msg @l="158" char_id="-1" frame_id="-1" name=""
		   text="亜季奈は三人の息があった愛撫に身体中を震わせて悶える。" voices=""/>
		<label @l="162" id="chart_line65"/>
		<wait_chgmv/>
		<ev @l="166" src="ev-070"/>
		<msg @l="168" char_id="2" frame_id="-1" name="亜季奈" text="『ん、ぷあっ‥‥。』"
		   voices="akina03850"/>
		<msg @l="170" char_id="2" frame_id="-1" name="亜季奈"
		   text="『ああっ‥‥もうダメ‥‥‥もう、がまんできないよぉ‥‥‥‥。』" voices="akina00880"/>
		<msg @l="172" char_id="-1" frame_id="-1" name=""
		   text="うっとりとした誘うような視線をすると、亜季奈は自ら水泳部員の男根を海パンから取り出し自ら秘裂に突き刺す。" voices=""/>
		<msg @l="174" char_id="-1" frame_id="-1" name="" text="じゅぷ、じゅぷ、じゅぷ、じゅぷ、じゅぷ"
		   voices=""/>
		<msg @l="176" char_id="-1" frame_id="-1" name=""
		   text="亜季奈の秘裂は既に濡れていたのと、プールの水がアソコに浸入した為水泳部員の馬並の巨根を難なく飲み込んでいく。" voices=""/>
		<msg @l="178" char_id="2" frame_id="-1" name="亜季奈" text="『んんんっ！！！』"
		   voices="akina00930"/>
		<msg @l="180" char_id="-1" frame_id="-1" name="水泳部員Ａ"
		   text="『うわーっ！亜季奈ちゃん、自分でオマ●コの中に入れちゃったよー。これじゃあ、俺が犯されたみたいだなー。』" voices=""/>
		<msg @l="182" char_id="-1" frame_id="-1" name="水泳部員Ｃ"
		   text="『おめぇー、いいなー。後で俺にも変われよ。』" voices=""/>
		<msg @l="184" char_id="-1" frame_id="-1" name="水泳部員Ｂ"
		   text="『じゃぁ、俺は待っている間お口でしゃぶってもらおうかな。』" voices=""/>
		<msg @l="186" char_id="-1" frame_id="-1" name="水泳部員Ｃ" text="『あっ、俺も俺もー。』"
		   voices=""/>
		<msg @l="188" char_id="2" frame_id="-1" name="亜季奈"
		   text="『ん、れろっ‥‥‥言われなくても、しゃぶっちゃうも～ん。』" voices="akina03930"/>
		<msg @l="190" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んふっ‥‥すごぉい、もうカチカチだね。』" voices="akina03870"/>
		<msg @l="192" char_id="-1" frame_id="-1" name=""
		   text="亜季奈と水泳部員達は他の部員が見ている中、いつものようにプールの中で４Ｐを始める。" voices=""/>
		<msg @l="193" char_id="-1" frame_id="-1" name=""
		   text="亜季奈の秘裂を貫いている部員は両足を抱え、水音をバシャバシャさせながら激しい抽送を繰り返す。" voices=""/>
		<msg @l="194" char_id="-1" frame_id="-1" name=""
		   text="他の二人の部員達は手で扱いてもらいながら、亜季奈の健康的な肌を貪っている。" voices=""/>
		<msg @l="196" char_id="-1" frame_id="-1" name="水泳部員Ａ"
		   text="『しかし、水が入ってくる感触は何度やっても気持ちよくて病み付きになるなー！』" voices=""/>
		<msg @l="198" char_id="2" frame_id="-1" name="亜季奈"
		   text="『ふああっ‥‥んぅ、あっ、あっ、あっ、ああっ！！』" voices="akina00450"/>
		<msg @l="200" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んふっ‥‥あっ、あっ、ああっ‥‥‥いい‥‥‥いいよぉ‥‥‥。』" voices="akina00870"/>
		<msg @l="202" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んぷっ‥‥んっ、ちゅぷ‥‥‥ンンっ‥‥‥れろ‥‥れろ‥‥‥。』" voices="akina03780"/>
		<msg @l="204" char_id="-1" frame_id="-1" name="水泳部員Ｂ"
		   text="『うはぁー、やっぱり亜季奈ちゃんはおしゃぶり上手いなー。』" voices=""/>
		<msg @l="206" char_id="-1" frame_id="-1" name="水泳部員Ｃ"
		   text="『そうだよなー、チ●ポ舐めている時の亜季奈ちゃんの顔俺も好きだなー。』" voices=""/>
		<msg @l="208" char_id="2" frame_id="-1" name="亜季奈"
		   text="『だってぇ‥‥これ、大好きなんだも～ん。』" voices="akina03920"/>
		<msg @l="210" char_id="-1" frame_id="-1" name=""
		   text="水泳部員達の言葉に亜季奈は嬉しくなりさらに激しくしゃぶる。" voices=""/>
		<msg @l="212" char_id="2" frame_id="-1" name="亜季奈"
		   text="『あ～む‥‥ちゅぷちゅぷちゅぷ‥‥‥‥‥ちゅ、ちゅるるるっ。』" voices="akina03980"/>
		<msg @l="214" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んぐ、んちゅっ、ちゅぷ、ちゅぷ、ちゅぷっ‥‥‥んぷぁっ！』" voices="akina03990"/>
		<msg @l="216" char_id="2" frame_id="-1" name="亜季奈"
		   text="『すごーい、こんなガチガチになって‥‥んふっ‥‥れろ、れろ。』" voices="akina04010"/>
		<msg @l="218" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んふぅ‥‥あふっ‥‥んぐ、んぷ、んぷっ‥‥‥ぷあっ。』" voices="akina04000"/>
		<msg @l="220" char_id="-1" frame_id="-1" name=""
		   text="いつの間にかプールの周りでは、亜季奈がご褒美している様子を見ようとたくさんの部員達が集まってみていた。中にはご褒美Ｓ●Ｘの様子を見ながらオ●ニーしている奴もいた。"
		   voices=""/>
		<msg @l="221" char_id="-1" frame_id="-1" name=""
		   text="皆、少しでも亜季奈がしている姿を拝もうと必死のようだ。" voices=""/>
		<msg @l="224" char_id="-1" frame_id="-1" name="水泳部員Ａ"
		   text="『うおお‥‥！？お、俺もう出そう！』" voices=""/>
		<msg @l="226" char_id="-1" frame_id="-1" name="水泳部員Ｂ" text="『俺も出ちまうっ！』"
		   voices=""/>
		<msg @l="228" char_id="-1" frame_id="-1" name=""
		   text="亜季奈にしゃぶらせてる部員達が我慢の限界に達した。" voices=""/>
		<msg @l="230" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んふぅ‥‥いいよぉ、出して‥‥‥んちゅっ‥‥‥‥。』" voices="akina04250"/>
		<msg @l="232" char_id="2" frame_id="-1" name="亜季奈"
		   text="『このまま‥‥ン、私のお口とお顔にいっぱいミルク出してぇ。』" voices="akina04260"/>
		<msg @l="234" char_id="-1" frame_id="-1" name="水泳部員Ａ"
		   text="『じゃあ、みんなで一斉に出そうぜ！』" voices=""/>
		<msg @l="236" char_id="-1" frame_id="-1" name=""
		   text="亜季奈の秘裂を貫いている部員が他の部員に言う。" voices=""/>
		<msg @l="238" char_id="2" frame_id="-1" name="亜季奈"
		   text="『いいっ‥‥いいよぉ‥‥‥‥きてぇ‥‥‥もっと奥まで来てぇ！！』" voices="akina00900"/>
		<msg @l="240" char_id="2" frame_id="-1" name="亜季奈"
		   text="『あふっ、おく、奥に出してっ‥‥んんっ‥‥‥‥来る、来ちゃう！！』" voices="akina00910"/>
		<msg @l="243" char_id="-1" frame_id="-1" name="水泳部員Ｂ" text="『で、出るっ！』"
		   voices=""/>
		<msg @l="245" char_id="-1" frame_id="-1" name="水泳部員Ｃ" text="『俺もっ！』"
		   voices=""/>
		<msg @l="247" char_id="-1" frame_id="-1" name="水泳部員Ａ"
		   text="『たっぷり中出ししてやるぜっ！！』" voices=""/>
		<msg @l="249" char_id="2" frame_id="-1" name="亜季奈" text="『んっ、あああああっ！！』"
		   voices="akina00340"/>
		<flash @l="253" count="4" fade="100" image="white"/>
		<msg @l="255" char_id="2" frame_id="-1" name="亜季奈"
		   text="『いく‥‥いっちゃ‥‥‥‥う、んんっ‥‥‥‥ふぁぁぁっ！！』" voices="akina00920"/>
		<flash @l="259" count="4" fade="100" image="white"/>
		<clear @l="265" class="all"/>
		<msg @l="267" char_id="-1" frame_id="-1" name="水泳部員Ａ"
		   text="『うはーっ、気持ちいいーっ！亜季奈ちゃんのオマ●コに搾り取られちゃったよー。』" voices=""/>
		<msg @l="269" char_id="-1" frame_id="-1" name="水泳部員Ｂ" text="『おい、次変われよなー。』"
		   voices=""/>
		<msg @l="271" char_id="-1" frame_id="-1" name="水泳部員Ｃ" text="『次は俺だってー！』"
		   voices=""/>
		<msg @l="273" char_id="-1" frame_id="-1" name="水泳部員Ａ"
		   text="『じゃあ、俺はア●ルにいれようっと』" voices=""/>
		<msg @l="275" char_id="2" frame_id="-1" name="亜季奈" text="『ひぃ――――――ッ！？』"
		   voices="akina00730"/>
		<msg @l="277" char_id="2" frame_id="-1" name="亜季奈"
		   text="『やあっ‥‥‥それ‥‥‥ダメ、いたっ‥‥いたいっっ‥‥んぐっ！！』" voices="akina00700"/>
		<msg @l="279" char_id="-1" frame_id="-1" name="水泳部員Ｃ"
		   text="『なんだ、亜季奈ちゃんア●ル初めてなんだ。じゃあア●ルバージン頂きー！』" voices=""/>
		<msg @l="281" char_id="-1" frame_id="-1" name="水泳部員Ｂ" text="『お、おまえだけずるいぞー！』"
		   voices=""/>
		<msg @l="283" char_id="-1" frame_id="-1" name="水泳部員Ｃ" text="『そ、そうだぞー！』"
		   voices=""/>
		<msg @l="285" char_id="-1" frame_id="-1" name=""
		   text="―――亜季奈はこうして毎日プールでＳ●Ｘ三昧の生活を送っているのであった―――" voices=""/>
		<clear @l="293" class="all"/>
		<end_scene @l="296"/>
		<msgshow @l="299" show="true"/>
		<bgm @l="303" src="bgm05" volume="1."/>
		<wait_chgmv/>
		<bg @l="307" src="bg18a"/>
		<msg @l="309" char_id="0" frame_id="1" name="美帆"
		   text="(ふふ‥‥亜季奈、ちゃんと水泳部のみんなにご奉仕してるかな)" voices=""/>
		<msg @l="311" char_id="-1" frame_id="-1" name=""
		   text="亜季奈の『働き』を夢想しながら、私は微かに笑う。" voices=""/>
		<msg @l="312" char_id="-1" frame_id="-1" name=""
		   text="あの子が南総町の住人として立派にご奉仕出来ているのなら、私も姉として安心である。" voices=""/>
		<msg @l="314" char_id="0" frame_id="1" name="美帆"
		   text="（やだ、プールで亜季奈がしているのを想像してたら濡れちゃった。）" voices=""/>
		<msg @l="316" char_id="0" frame_id="1" name="美帆" text="（誰かエッチをしてくれないかなー。）"
		   voices=""/>
		<msg @l="318" char_id="-1" frame_id="-1" name=""
		   text="そんな事を考えながらあたりを見回すと、リクルートスーツの女の子の姿が目に入る。" voices=""/>
		<msg @l="320" char_id="0" frame_id="1" name="美帆"
		   text="（そういえば、私も真面目に就職活動をしないと････）" voices=""/>
		<msg @l="322" char_id="-1" frame_id="-1" name=""
		   text="美帆はちょうど1年前に玲が就職活動していることを思い出していた。" voices=""/>
		<msg @l="324" char_id="0" frame_id="1" name="美帆"
		   text="（････玲さん、どうしているかな。この間電話で話した時は凄く生き生きしていたから楽しいＯＬライフを送っていると思うけど。）"
		   voices=""/>
		<msg @l="326" char_id="-1" frame_id="-1" name=""
		   text="私は大黒建設へと正式な入社が決定したという玲さんのことを思い出していた。" voices=""/>
		<msg @l="327" char_id="-1" frame_id="-1" name=""
		   text="大黒建設へ入社が決まってからというもの、社宅に入ってしまった為にいつも一緒というわけではないが、今でも時々連絡を取りあっている。"
		   voices=""/>
		<msg @l="328" char_id="-1" frame_id="-1" name=""
		   text="なんでも、入社早々にしていきなり大きな取り引きのプレゼン役に抜擢されたとか言っていた。" voices=""/>
		<msg @l="329" char_id="-1" frame_id="-1" name=""
		   text="玲さんなら、どんな仕事もおそらく簡単にこなしてしまうのだろう。" voices=""/>
		<msg @l="331" char_id="-1" frame_id="-1" name=""
		   text="そう言えばこの間の電話で玲先輩に大黒建設に来ないかと誘われた。" voices=""/>
		<msg @l="333" char_id="0" frame_id="1" name="美帆"
		   text="（大黒建設か････どうしようかなー、受けにいってみようかなー･･････）" voices=""/>
		<msg @l="335" char_id="-1" frame_id="-1" name=""
		   text="空を見上げながら美帆はそんな事を考えていた―――" voices=""/>
		<stopbgm @l="339" fadeout="1000"/>
		<clear @l="345" class="all"/>
		<msgshow @l="347" show="true"/>
		<msg @l="349" char_id="-1" frame_id="-1" name=""
		   text="･･････････････････････････････。" voices=""/>
		<msg @l="350" char_id="-1" frame_id="-1" name=""
		   text="････････････････････。" voices=""/>
		<msg @l="351" char_id="-1" frame_id="-1" name="" text="･･････････。"
		   voices=""/>
		<bgm @l="355" src="bgm07" volume="1."/>
		<wait_chgmv/>
		<bg @l="359" src="bg17a"/>
		<msg @l="361" char_id="-1" frame_id="-1" name="大黒"
		   text="『ではここからは我が社が誇る期待の新人、白石くんよりプレゼンをさせて戴きます。』" voices=""/>
		<msg @l="363" char_id="-1" frame_id="-1" name="" text="応接室の扉越しに大黒の声が響いている。"
		   voices=""/>
		<msg @l="364" char_id="-1" frame_id="-1" name=""
		   text="大黒建設にはいま国の官僚が訪れており、次の公共工事の受注プレゼンを見学しているところである。" voices=""/>
		<msg @l="365" char_id="-1" frame_id="-1" name=""
		   text="当然、公共工事の受注先に選ばれれば、大黒建設としては同業他社に対して大きくアドバンテージを得る事になる。" voices=""/>
		<clear @l="373" class="all"/>
		<label @l="376" id="event_scene68"/>
		<msg @l="379" char_id="1" frame_id="-1" name="玲"
		   text="『ただいまご紹介に預かりました、白石玲と申します‥‥以後お見知りおきください。』" voices=""/>
		<msg @l="381" char_id="-1" frame_id="-1" name=""
		   text="言葉と共に玲は優雅に立ち上がり、ゆっくりと応接室内の奥に設置されたプロジェクタスクリーンの前へと歩いて行く。" voices=""/>
		<label @l="385" id="chart_line66"/>
		<wait_chgmv/>
		<ev @l="389" src="ev-068"/>
		<msg @l="391" char_id="-1" frame_id="-1" name=""
		   text="薄暗い部屋の中、プロジェクタに照らされた光の前で玲が振り返ると訪れていた官僚達の口から「おお」という感嘆の言葉が漏らされる。"
		   voices=""/>
		<msg @l="392" char_id="-1" frame_id="-1" name=""
		   text="玲の着ているスーツは光りによって殆どが透け、その下に隠された肌がくっきりと浮かび上がっていた。" voices=""/>
		<msg @l="393" char_id="-1" frame_id="-1" name="" text="しかも‥‥玲は下着を身に付けていない。"
		   voices=""/>
		<msg @l="394" char_id="-1" frame_id="-1" name=""
		   text="胸の先端にある乳首も、腰のラインも、すべてが露になっていた。" voices=""/>
		<msg @l="396" char_id="1" frame_id="-1" name="玲"
		   text="『では、まずこちらの項目からご覧下さい。』" voices=""/>
		<msg @l="398" char_id="-1" frame_id="-1" name=""
		   text="玲は官僚達の視線に戸惑う事無く、平静にプレゼンを始める。" voices=""/>
		<msg @l="399" char_id="-1" frame_id="-1" name=""
		   text="しかし‥‥肝心の男たちは、玲の言葉に耳を傾けている余裕など微塵もありはしない。" voices=""/>
		<msg @l="400" char_id="-1" frame_id="-1" name=""
		   text="ただ、その視線だけが熱っぽく玲の肢体へと注がれている。" voices=""/>
		<msg @l="402" char_id="-1" frame_id="-1" name="官僚"
		   text="『は、はは‥‥噂には聞いていたがこれはこれは。』" voices=""/>
		<msg @l="404" char_id="-1" frame_id="-1" name="官僚" text="『たまりませんな‥‥。』"
		   voices=""/>
		<msg @l="406" char_id="-1" frame_id="-1" name=""
		   text="玲は官僚たちの熱い視線に、秘部から“くちゅ”と濡らした音を漏らす。" voices=""/>
		<msg @l="407" char_id="-1" frame_id="-1" name="" text="すると、官僚たちから歓声が上がる。"
		   voices=""/>
		<msg @l="409" char_id="-1" frame_id="-1" name="官僚"
		   text="『おおーっ、今いやらしい音が聞こえてきたぞー。』" voices=""/>
		<msg @l="411" char_id="-1" frame_id="-1" name="官僚"
		   text="『本当ですなー。これはプレゼンに凄く重要な音だと思うので近くに行かないと････。』" voices=""/>
		<msg @l="413" char_id="-1" frame_id="-1" name=""
		   text="そう言うとプレゼンが始まってから五分とせずに、男たちは席を立ち玲の周囲に集り始める。" voices=""/>
		<msg @l="414" char_id="-1" frame_id="-1" name=""
		   text="やがて見ているだけでは物足りなくなり、一人、また一人とスーツに隠された玲の身体へと手を伸ばして指先を絡め始めていた。"
		   voices=""/>
		<msg @l="416" char_id="1" frame_id="-1" name="玲"
		   text="『ふふ‥‥こちらが我が社のご用意致しましたサービスとなります。』" voices=""/>
		<msg @l="418" char_id="1" frame_id="-1" name="玲"
		   text="『たっぷりとご堪能戴きました上で、お仕事の件、よろしくお願いしますわね。』" voices=""/>
		<msg @l="420" char_id="-1" frame_id="-1" name=""
		   text="玲はそうして男たちに嬲られながらも、艶やかな笑みを浮かべ自ら腰を動かし秘部に男達の指を迎え入れていった。" voices=""/>
		<msg @l="422" char_id="-1" frame_id="-1" name="官僚"
		   text="『ふふふっ、このサービスはいいねー。他社よりも一歩リードしているよ。』" voices=""/>
		<msg @l="424" char_id="-1" frame_id="-1" name="官僚"
		   text="『んー、しかしねー、もう一押しが足らないかなー。』" voices=""/>
		<msg @l="426" char_id="-1" frame_id="-1" name=""
		   text="官僚たちは服の上から玲の胸を揉みしだき、乳首をつまんでひねりあげる。" voices=""/>
		<msg @l="428" char_id="1" frame_id="-1" name="玲" text="『ん、んんっ！！』" voices=""/>
		<msg @l="430" char_id="-1" frame_id="-1" name=""
		   text="さらにもう一人はタイトスカートの上から顔を下腹部に擦りつけ、手はスカートの中に入れて秘部をまさぐる。" voices=""/>
		<msg @l="432" char_id="1" frame_id="-1" name="玲"
		   text="『んんっ、いいですわー。我が社のサービスは皆様が今試されている通り使えば使うほど良さが出ますので、もっと使ってくださいね。』"
		   voices=""/>
		<msg @l="434" char_id="-1" frame_id="-1" name=""
		   text="玲はそう言うと空いた手で、胸を揉んでいる男の股間を撫で上げる。" voices=""/>
		<msg @l="436" char_id="-1" frame_id="-1" name="官僚"
		   text="『おおっ！キミはやる気に満ち溢れているなー。このサービスは質が高いよ。是非次をお願いしたいね。』" voices=""/>
		<msg @l="438" char_id="-1" frame_id="-1" name="官僚"
		   text="『いいですなー、私も考えていたところです。』" voices=""/>
		<msg @l="440" char_id="-1" frame_id="-1" name="官僚"
		   text="『大黒君、良いかな？次のサービスを試させてもらっても？』" voices=""/>
		<msg @l="442" char_id="-1" frame_id="-1" name="大黒"
		   text="『どうぞ、どうぞ。お好きなように試してくださいませ。どんなサービスも対応できるようになっています。フィ●ト●ァックでもね････。』"
		   voices=""/>
		<msg @l="444" char_id="-1" frame_id="-1" name="官僚" text="『おおっ！本当かね！？』"
		   voices=""/>
		<msg @l="446" char_id="-1" frame_id="-1" name="官僚"
		   text="『じゃぁ、早速試させてもらいましょうよ。』" voices=""/>
		<msg @l="448" char_id="-1" frame_id="-1" name="官僚" text="『そうしましょう、そうしましょう。』"
		   voices=""/>
		<msg @l="450" char_id="1" frame_id="-1" name="玲" text="『あっ････････。』"
		   voices=""/>
		<clear @l="456" class="all"/>
		<msg @l="458" char_id="-1" frame_id="-1" name=""
		   text="そう言うと官僚たちは玲を押し倒し服を破って脱がし犯し始める。" voices=""/>
		<msg @l="459" char_id="-1" frame_id="-1" name="" text="その姿を大黒は満足そうに見ていた。"
		   voices=""/>
		<msg @l="461" char_id="-1" frame_id="1" name="大黒"
		   text="（ふふっ、あのキャンパスクイーンの玲さんが仕事を取る為に身体を売るようになったか････。この姿が見たかったのですよ････この堕ちた姿がね。）"
		   voices=""/>
		<msg @l="462" char_id="-1" frame_id="1" name="大黒"
		   text="（そして虫を見るような目で見ていた私の会社の利益の為に働いてくれる････この大きな契約も取れそうだし････私は最高の気分ですよ。）"
		   voices=""/>
		<msg @l="463" char_id="-1" frame_id="1" name="大黒"
		   text="（これからも“色々”とお願いしますね･･････玲さん･･････）" voices=""/>
		<msg @l="465" char_id="-1" frame_id="-1" name=""
		   text="大黒は心の中で呟きながら玲が犯される様を見ていた･･････。" voices=""/>
		<stopbgm @l="470" fadeout="1000"/>
		<clear @l="476" class="all"/>
		<end_scene @l="479"/>
		<msgshow @l="482" show="true"/>
		<msg @l="484" char_id="0" frame_id="1" name="美帆"
		   text="（んー、玲さんと一緒に働くのも良いけど、私はどちらかというと外で羞恥プレイ的なエッチをたくさんしてくれる会社の方がいいんだけどなー。）"
		   voices=""/>
		<msg @l="486" char_id="-1" frame_id="-1" name=""
		   text="美帆は実は女子アナになって現地リポートでいろんな職種のたくさんの人と交尾したいと思って、ＴＶ局を受けていたのだ。" voices=""/>
		<msg @l="488" char_id="0" frame_id="1" name="美帆" text="（どうしよっかなー････）"
		   voices=""/>
		<msg @l="490" char_id="-1" frame_id="-1" name="？？？" text="『････････ん。』"
		   voices=""/>
		<msg @l="492" char_id="-1" frame_id="-1" name="？？？" text="『･･････ちゃん。』"
		   voices=""/>
		<msg @l="494" char_id="-1" frame_id="-1" name="？？？" text="『お姉ちゃん！』"
		   voices=""/>
		<msg @l="496" char_id="0" frame_id="1" name="美帆" text="『え‥‥。』" voices=""/>
		<bgm @l="500" src="bgm06" volume="1."/>
		<wait_chgmv/>
		<bg @l="504" src="bg18a"/>
		<char @l="508" id="akina" pos="auto" src="akina054"/>
		<msg @l="510" char_id="2" frame_id="-1" name="亜季奈" text="『え‥‥じゃないでしょ。』"
		   voices=""/>
		<msg @l="512" char_id="2" frame_id="-1" name="亜季奈"
		   text="『何度も呼んでるのに、全然気付か無いなんてひどいよ～。』" voices=""/>
		<msg @l="514" char_id="0" frame_id="1" name="美帆" text="『ごめん、ごめんー。』"
		   voices=""/>
		<msg @l="516" char_id="0" frame_id="1" name="美帆" text="『亜季奈、どこに行くの？』"
		   voices=""/>
		<char @l="520" id="akina" pos="auto" src="akina051"/>
		<msg @l="522" char_id="2" frame_id="-1" name="亜季奈"
		   text="『うんとね、今授業が終わったからまたプールに行ってＳ●Ｘしてくるの。』" voices=""/>
		<char @l="526" id="akina" pos="auto" src="akina150"/>
		<msg @l="528" char_id="2" frame_id="-1" name="亜季奈"
		   text="『それよりお姉ちゃん‥‥‥その格好。』" voices=""/>
		<msg @l="530" char_id="-1" frame_id="-1" name=""
		   text="そう言って亜季奈は上から下まで撫でるように私の服を見た。" voices=""/>
		<msg @l="531" char_id="-1" frame_id="-1" name=""
		   text="私が今着ている服は、身体のラインも肌もくっきりと透けてしまうほど薄い布地で造られたワンピースである。" voices=""/>
		<msg @l="532" char_id="-1" frame_id="-1" name=""
		   text="しかも下着をつけていないから、乳首も秘部を覆っている陰毛も薄っすらと透けてしまっている。" voices=""/>
		<msg @l="534" char_id="0" frame_id="1" name="美帆" text="『ふふ‥‥似合う？』" voices=""/>
		<char @l="538" id="akina" pos="auto" src="akina052"/>
		<msg @l="540" char_id="2" frame_id="-1" name="亜季奈" text="『お姉ちゃんえっち～、いいな～。』"
		   voices=""/>
		<msg @l="542" char_id="0" frame_id="1" name="美帆"
		   text="『そう言う亜季奈も、用意してもらえたんでしょ？』" voices=""/>
		<msg @l="544" char_id="-1" frame_id="-1" name=""
		   text="私は、亜季奈が大事そうに抱えている紙袋を見て笑う。" voices=""/>
		<msg @l="545" char_id="-1" frame_id="-1" name="" text="その紙袋はこの先にある洋裁店のものだ。"
		   voices=""/>
		<char @l="549" id="akina" pos="auto" src="akina151"/>
		<msg @l="551" char_id="2" frame_id="-1" name="亜季奈" text="『えへへ～、実はそうなんだ～。』"
		   voices=""/>
		<msg @l="553" char_id="-1" frame_id="-1" name=""
		   text="亜季奈は微かにはにかんで、紙袋からつい先ほど受け取ったばかりの新しい服を出して見せる。" voices=""/>
		<char @l="557" id="akina" pos="auto" src="akina051"/>
		<msg @l="559" char_id="2" frame_id="-1" name="亜季奈"
		   text="『ほら見て～、私の制服、透け透けだよー。』" voices=""/>
		<msg @l="561" char_id="0" frame_id="1" name="美帆" text="『透け透け服おそろいだね。』"
		   voices=""/>
		<msg @l="563" char_id="2" frame_id="-1" name="亜季奈" text="『うん。』" voices=""/>
		<bgm @l="566" src="bgm03" volume="1."/>
		<msg @l="568" char_id="-1" frame_id="-1" name="大学生"
		   text="『おっ、美帆じゃん。何してるんだよ？』" voices=""/>
		<msg @l="570" char_id="-1" frame_id="-1" name=""
		   text="新しい制服を抱えてはしゃぐ亜季奈の後ろから、美帆の同級生である三人組の男の子達が声をかけてくる。" voices=""/>
		<msg @l="572" char_id="0" frame_id="1" name="美帆"
		   text="『んっとね、今妹の亜季奈と話していたんだよ。』" voices=""/>
		<msg @l="574" char_id="2" frame_id="-1" name="亜季奈"
		   text="『へーそうなんだ。どれどれ････。』" voices=""/>
		<msg @l="576" char_id="-1" frame_id="-1" name=""
		   text="美帆の同級生はそういうと、亜季奈の身体を値踏みするように見る。" voices=""/>
		<msg @l="578" char_id="-1" frame_id="-1" name="大学生"
		   text="『へー、かわいいねー、亜季奈ちゃん。そこの公園行って犯ろうぜ。』" voices=""/>
		<char @l="582" id="akina" pos="auto" src="akina150"/>
		<msg @l="584" char_id="2" frame_id="-1" name="亜季奈"
		   text="『うん、いいよ、その代わりこの透け透け制服に着替えてからね。』" voices=""/>
		<msg @l="586" char_id="-1" frame_id="-1" name="大学生"
		   text="『おーっ、それいいねー、それじゃあ三人いっぺんにやってよ。』" voices=""/>
		<char @l="590" id="akina" pos="auto" src="akina152"/>
		<msg @l="592" char_id="2" frame_id="-1" name="亜季奈"
		   text="『ふふっ、いいよ。その代わり思いっきり激しくしてね。』" voices=""/>
		<clear @l="596" class="char"/>
		<msg @l="598" char_id="-1" frame_id="-1" name=""
		   text="そうして、亜季奈は男の子達三人に囲まれるようにして駅前の一角に作られた公園へと歩いて行った。" voices=""/>
		<msg @l="600" char_id="0" frame_id="1" name="美帆"
		   text="『ふふ‥‥すっかり、南総町の住人としてお勤め出来てるみたいね。』" voices=""/>
		<msg @l="602" char_id="-1" frame_id="-1" name=""
		   text="私は立ち去る亜季奈の背中を見つめながら、嬉しそうに見送る。" voices=""/>
		<clear @l="608" class="all"/>
		<label @l="611" id="event_scene72"/>
		<msgshow @l="614" show="true"/>
		<bgm @l="616" src="bgm07" volume="1."/>
		<label @l="620" id="chart_line67"/>
		<msg @l="622" char_id="2" frame_id="-1" name="亜季奈" text="『用意できたよー。』"
		   voices=""/>
		<msg @l="624" char_id="-1" frame_id="-1" name=""
		   text="そう言って、大学生達の前で透け透け制服に着替えた亜季奈がポーズをとる。" voices=""/>
		<msg @l="625" char_id="-1" frame_id="-1" name=""
		   text="着替える際、ブラジャーとパンツは脱いだままなので、夕日の逆光で身体が透けて乳首と秘部がうっすらと見えていた。" voices=""/>
		<msg @l="627" char_id="-1" frame_id="-1" name="大学生Ａ"
		   text="『おおーっ、待ってたぜー亜季奈ちゃん。』" voices=""/>
		<msg @l="629" char_id="-1" frame_id="-1" name="大学生Ｂ"
		   text="『美帆お姉ちゃんのデカ乳も犯しがいがあったけど、貧乳ろりっ子も美味しそうだなー。』" voices=""/>
		<msg @l="631" char_id="2" frame_id="-1" name="亜季奈"
		   text="『ぶー、今は貧乳だけど、いっぱい揉んでもらったら大きくなるもん。』" voices=""/>
		<msg @l="633" char_id="-1" frame_id="-1" name="大学生Ｃ"
		   text="『まぁまぁ、それより早くやろうぜ。大きくなるように揉んでやるからさ。』" voices=""/>
		<msg @l="635" char_id="2" frame_id="-1" name="亜季奈" text="『分かったよー。』"
		   voices=""/>
		<msg @l="637" char_id="2" frame_id="-1" name="亜季奈"
		   text="『ねぇ、じゃあそこで寝っころがってー。私、上になってみたいから。』" voices=""/>
		<msg @l="639" char_id="-1" frame_id="-1" name="大学生Ｃ"
		   text="『へへっ、じゃあ俺が下にならせてもらうぜ。』" voices=""/>
		<msg @l="641" char_id="-1" frame_id="-1" name=""
		   text="そう言うと大学生は横になってズボンから肉棒を出す。その肉棒はビクビクと脈を打ち天に向かってそそり立っていた。" voices=""/>
		<msg @l="643" char_id="2" frame_id="-1" name="亜季奈"
		   text="『すごーい。お兄さんの今まで見た中で一番おっきいねー。』" voices=""/>
		<msg @l="645" char_id="-1" frame_id="-1" name="大学生Ａ"
		   text="『ほら、感心している場合じゃないぜ。早く俺達のもしゃぶってくれよ。』" voices=""/>
		<msg @l="647" char_id="2" frame_id="-1" name="亜季奈" text="『あっ、ちょっと待ってー。』"
		   voices=""/>
		<wait_chgmv/>
		<ev @l="651" src="ev-072"/>
		<msg @l="653" char_id="-1" frame_id="-1" name=""
		   text="亜季奈はそう言うと、自分の秘部を指で開き腰を落として寝転がっている大学生の肉棒を入れていく。" voices=""/>
		<msg @l="655" char_id="-1" frame_id="-1" name="" text="ずぶずぶずぶずぶずぶずぶ"
		   voices=""/>
		<msg @l="657" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んーっ、す、すごくおっきいよーー！！』" voices=""/>
		<msg @l="659" char_id="-1" frame_id="-1" name=""
		   text="亜季奈の秘裂は想像できないほど大きく拡げられていた。" voices=""/>
		<msg @l="661" char_id="-1" frame_id="-1" name="大学生Ｂ"
		   text="『へへっ、しゃべる暇があったら俺のを咥えなよ。』" voices=""/>
		<msg @l="663" char_id="2" frame_id="-1" name="亜季奈"
		   text="『はぁ～い‥‥あむ、んっ‥‥ちゅう‥‥ちゅるっ、んぷ、んぷっ！』" voices=""/>
		<msg @l="665" char_id="-1" frame_id="-1" name="大学生Ｃ"
		   text="『ほら、腰も動かせよ。そうしねぇと気持ち良くなんねぇぞ。』" voices=""/>
		<msg @l="667" char_id="2" frame_id="-1" name="亜季奈"
		   text="『だけど‥‥‥んんっ、だけどぉ‥‥‥ん、んんっ‥‥‥。』" voices=""/>
		<msg @l="669" char_id="-1" frame_id="-1" name="大学生Ｃ"
		   text="『騎乗位は初めてみたいだね、亜季奈ちゃん。じゃあ今日は特別に手伝って上げるけど、あとで美帆おねえちゃんにちゃんと教わっておけよ。美帆おねえちゃんは上手いぞー。』"
		   voices=""/>
		<msg @l="671" char_id="-1" frame_id="-1" name=""
		   text="大学生はそう言うと激しく腰を動かし始め、下から亜季奈を突き上げる。" voices=""/>
		<msg @l="673" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んふっ‥‥あ、いい、そこもっと突き上げてぇ。』" voices=""/>
		<msg @l="675" char_id="2" frame_id="-1" name="亜季奈"
		   text="『いいっ‥‥いいよぉ‥‥‥‥きてぇ‥‥‥もっと奥まで来てぇ！！』" voices=""/>
		<msg @l="677" char_id="-1" frame_id="-1" name=""
		   text="自ら男の上に跨り腰を使いながら、亜季奈が艶やかな声をあげる。" voices=""/>
		<msg @l="678" char_id="-1" frame_id="-1" name=""
		   text="肌の透けた制服を振り乱し快楽を貪る姿は、その幼い容姿とは裏腹に艶やかだ。" voices=""/>
		<msg @l="680" char_id="-1" frame_id="-1" name="大学生Ａ"
		   text="『へへっ‥‥ちっちぇえマ○コがずっぽり咥え込んでるぜ。』" voices=""/>
		<msg @l="682" char_id="2" frame_id="-1" name="亜季奈"
		   text="『いやぁん、そんなこと言わないでぇ。』" voices=""/>
		<msg @l="684" char_id="-1" frame_id="-1" name="大学生Ｂ"
		   text="『んなこといって、自分から腰動かしてんじゃねーかよ。』" voices=""/>
		<msg @l="686" char_id="-1" frame_id="-1" name="大学生Ｃ" text="『ああ、大した淫乱だぜ。』"
		   voices=""/>
		<msg @l="688" char_id="2" frame_id="-1" name="亜季奈"
		   text="『だってぇ‥‥‥これ、好きなんだもん。』" voices=""/>
		<msg @l="690" char_id="-1" frame_id="-1" name=""
		   text="そう言って亜季奈は両手にはそれぞれ熱く勃起した男根を握り、うっとりとした表情で唇を寄せては口腔に含んでしゃぶりつく。"
		   voices=""/>
		<msg @l="692" char_id="2" frame_id="-1" name="亜季奈"
		   text="『あむ‥‥ん、ちゅぷっ‥‥‥んっ、んっ‥‥‥‥ちゅぷぷ。』" voices=""/>
		<msg @l="694" char_id="-1" frame_id="-1" name="" text="淫猥な水音を立てながらを舐め回す亜季奈。"
		   voices=""/>
		<msg @l="695" char_id="-1" frame_id="-1" name=""
		   text="歓喜に染まった表情が、底の知れない貪欲さを醸しだしている。" voices=""/>
		<msg @l="697" char_id="-1" frame_id="-1" name="大学生Ｂ" text="『いいぜぇ‥‥結構上手いな。』"
		   voices=""/>
		<msg @l="699" char_id="-1" frame_id="-1" name="大学生Ｂ"
		   text="『舌先が絡みついてきて‥‥‥くっ、搾り取られそうだ。ねぇちゃんより上手いんじゃねぇか？』" voices=""/>
		<msg @l="701" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んふふふっ‥‥ほんとに搾り取っちゃうからね。』" voices=""/>
		<msg @l="703" char_id="-1" frame_id="-1" name=""
		   text="わずかに目を細めながら、亜季奈が意地悪く笑う。" voices=""/>
		<msg @l="704" char_id="-1" frame_id="-1" name=""
		   text="そうして、口腔内に含んだ先端部分を舌先でねぶりながら吸い付いた。" voices=""/>
		<msg @l="706" char_id="-1" frame_id="-1" name="大学生Ｃ"
		   text="『へっ‥‥上の口ばっか楽しんでないでコッチもしっかり頼むぜ。』" voices=""/>
		<msg @l="708" char_id="2" frame_id="-1" name="亜季奈" text="『んああっ！』" voices=""/>
		<msg @l="710" char_id="-1" frame_id="-1" name="" text="男が腰を使って下から強く突き上げた。"
		   voices=""/>
		<msg @l="711" char_id="-1" frame_id="-1" name=""
		   text="そうして先端が子宮の入り口を突き上げると、亜季奈は蕩けた声を漏らしながら身悶える。" voices=""/>
		<msg @l="713" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んふぅ‥‥いまの‥‥‥‥もっとしてぇ。』" voices=""/>
		<msg @l="715" char_id="-1" frame_id="-1" name="大学生Ｃ"
		   text="『奥まで突いて欲しかったらしっかりマ○コ締め付けな。』" voices=""/>
		<msg @l="717" char_id="2" frame_id="-1" name="亜季奈"
		   text="『うん、締めるからっ‥‥‥オマ○コちゃんと締めるから、さっきみたいに一番奥のところ突き上げてぇ。』" voices=""/>
		<msg @l="719" char_id="-1" frame_id="-1" name="大学生Ｃ"
		   text="『そういう自分に素直なヤツ‥‥嫌いじゃないぜ。』" voices=""/>
		<msg @l="721" char_id="-1" frame_id="-1" name=""
		   text="男は口元を歪めてつぶやくと、再び腰を使って亜季奈の秘部を貫く。" voices=""/>
		<msg @l="723" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んあああっ‥‥あっ、いいっ‥‥‥いいよぉ、んんっ、ふあっ！』" voices=""/>
		<msg @l="725" char_id="-1" frame_id="-1" name="大学生Ｂ"
		   text="『ほら、上の口も頑張ってくれなきゃ困るぜ。』" voices=""/>
		<msg @l="727" char_id="-1" frame_id="-1" name="大学生Ａ"
		   text="『俺のモノもしっかりしごかないとな。』" voices=""/>
		<msg @l="729" char_id="2" frame_id="-1" name="亜季奈"
		   text="『うん、うんっ‥‥‥するからぁ‥‥‥‥‥んっ、んあああ！！』" voices=""/>
		<msg @l="731" char_id="-1" frame_id="-1" name=""
		   text="亜季奈は突き上げる快感に震えながら、口元に差し出された男根に舌先を伸ばしてねぶろうとする。" voices=""/>
		<msg @l="732" char_id="-1" frame_id="-1" name=""
		   text="が、それを邪魔するように下の男が秘部を激しく突き上げてきて上手くしゃぶることができない。" voices=""/>
		<msg @l="734" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んぁぁぁっ‥‥ダメぇ‥‥‥‥んっ、ちゃんとしゃぶれないよぉ。』" voices=""/>
		<msg @l="736" char_id="-1" frame_id="-1" name="大学生Ｂ"
		   text="『おうおう、必死に舌伸ばしてら。』" voices=""/>
		<msg @l="738" char_id="-1" frame_id="-1" name="大学生Ａ"
		   text="『根っからチ○ポ好きって事だろ。おねぇちゃんと同じだな！』" voices=""/>
		<msg @l="740" char_id="-1" frame_id="-1" name=""
		   text="下卑た笑みを浮かべながら、男たちが言葉を吐き捨てる。" voices=""/>
		<msg @l="741" char_id="-1" frame_id="-1" name=""
		   text="けれど、亜季奈はそんな言葉に構うこともなく‥‥ただ悦楽を貪るように腰をくねらせ続けていた。" voices=""/>
		<msg @l="743" char_id="-1" frame_id="-1" name="大学生Ｂ" text="『そろそろ出すぞ！』"
		   voices=""/>
		<msg @l="745" char_id="-1" frame_id="-1" name="大学生Ａ"
		   text="『こっちもだ、お前の顔にたっぷりとぶっかけてやるぜ！』" voices=""/>
		<msg @l="747" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んんっ‥‥出してぇ、私のお口とお顔にいっぱいミルク出してぇ。』" voices=""/>
		<msg @l="749" char_id="-1" frame_id="-1" name="大学生Ｃ"
		   text="『そら、このまま一番奥に出してやるからなっ！』" voices=""/>
		<msg @l="751" char_id="2" frame_id="-1" name="亜季奈" text="『うん、きて、来てぇぇ！！』"
		   voices=""/>
		<flash @l="755" count="4" fade="100" image="white"/>
		<msg @l="757" char_id="2" frame_id="-1" name="亜季奈"
		   text="『あふっ、おく、奥に出してっ‥‥んんっ‥‥‥‥来る、来ちゃう！！』" voices=""/>
		<flash @l="761" count="4" fade="100" image="white"/>
		<msg @l="763" char_id="-1" frame_id="-1" name="" text="蕩けた表情で亜季奈が叫ぶ。"
		   voices=""/>
		<msg @l="764" char_id="-1" frame_id="-1" name=""
		   text="花唇を貫いている男は満足げな表情を浮かべると、更に激しく腰を使って蜜の溢れる膣内を擦り上げていく。" voices=""/>
		<msg @l="765" char_id="-1" frame_id="-1" name="" text="いつまでも、いつまでも。"
		   voices=""/>
		<msg @l="766" char_id="-1" frame_id="-1" name=""
		   text="夕陽に照らされた公園からは、亜季奈の艶やかな声が響いていた。" voices=""/>
		<stopbgm @l="770" fadeout="1000"/>
		<clear @l="776" class="all"/>
		<end_scene @l="779"/>
		<msgshow @l="782" show="true"/>
		<msg @l="784" char_id="0" frame_id="1" name="美帆"
		   text="『ふふっ、亜季奈ったらあんなに感じじゃって････。』" voices=""/>
		<msg @l="786" char_id="0" frame_id="1" name="美帆"
		   text="『気持ちよさそう････。羨ましい････。』" voices=""/>
		<label @l="789" id="event_scene61"/>
		<wait_chgmv/>
		<bg @l="793" src="bg18a"/>
		<msg @l="795" char_id="0" frame_id="1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="797" char_id="0" frame_id="1" name="美帆" text="『そろそろ時間かしら‥‥？』"
		   voices=""/>
		<msg @l="799" char_id="-1" frame_id="-1" name=""
		   text="私は携帯電話のディスプレイを見て時間を確認すると、停留所へ向かう。" voices=""/>
		<msg @l="800" char_id="-1" frame_id="-1" name=""
		   text="途中、何人もの男の人に声をかけられたけれど、今は町のお勤めよりも先にやらなければならないことがあったので、また別の日にしてもらった。"
		   voices=""/>
		<se @l="804" buf="1" src="電車停止" volume="1."/>
		<stopse @l="808" buf="3"/>
		<msg @l="810" char_id="0" frame_id="1" name="美帆" text="『あ‥‥あの電車ね。』"
		   voices=""/>
		<msg @l="812" char_id="-1" frame_id="-1" name=""
		   text="外からの電車が到着し、中から大勢の人たちが降りてくる。" voices=""/>
		<msg @l="813" char_id="-1" frame_id="-1" name=""
		   text="みな、今年度より大学に転入してきた新入生たちだ。" voices=""/>
		<msg @l="814" char_id="-1" frame_id="-1" name=""
		   text="駅に電車が止まってしばらくすると、大きなバッグを肩にかけた女の子が降りてくる。" voices=""/>
		<msg @l="816" char_id="-1" frame_id="-1" name="女の子" text="『‥‥‥‥。』" voices=""/>
		<msg @l="818" char_id="0" frame_id="1" name="美帆" text="『ふふ、あの子ね。』" voices=""/>
		<msg @l="820" char_id="-1" frame_id="-1" name=""
		   text="そうして流れていく人混みの中、私は待ち人の姿を見つけた。" voices=""/>
		<msg @l="821" char_id="-1" frame_id="-1" name=""
		   text="あらかじめ受け取っていた顔写真と見比べてみる。" voices=""/>
		<msg @l="822" char_id="-1" frame_id="-1" name="" text="―――間違いない。" voices=""/>
		<msg @l="824" char_id="-1" frame_id="-1" name="女の子" text="『‥‥‥‥。』" voices=""/>
		<msg @l="826" char_id="-1" frame_id="-1" name=""
		   text="その女の子はキョロキョロと辺りを見回している。" voices=""/>
		<msg @l="827" char_id="-1" frame_id="-1" name=""
		   text="迎えに来る事になっている私を‥‥探しているのだろう。" voices=""/>
		<label @l="831" id="chart_line68"/>
		<wait_chgmv/>
		<ev @l="835" src="ev-061"/>
		<msg @l="837" char_id="0" frame_id="1" name="美帆" text="『ふふ‥‥初々しくて、可愛い。』"
		   voices="miho13470"/>
		<msg @l="839" char_id="-1" frame_id="-1" name=""
		   text="私は妖艶な笑みと共につぶやき、彼女の前へと歩み寄る。" voices=""/>
		<bgm @l="843" src="bgm16" volume="1."/>
		<msg @l="845" char_id="0" frame_id="1" name="美帆" text="『南総町へようこそ。』"
		   voices="miho13480"/>
		<msg @l="847" char_id="-1" frame_id="-1" name="女の子" text="『あ‥‥仲根さんですか？』"
		   voices=""/>
		<msg @l="849" char_id="-1" frame_id="-1" name=""
		   text="戸惑うようにこちらを見た新入生の子の前に立ち、私は妖艶な笑みを浮かべてみせる。" voices=""/>
		<msg @l="852" char_id="0" frame_id="1" name="美帆"
		   text="『あなた‥‥新しく３０７号室へ越してこられる方よね？』" voices=""/>
		<msg @l="854" char_id="-1" frame_id="-1" name="女の子" text="『え‥‥あ、はい。』"
		   voices=""/>
		<msg @l="856" char_id="0" frame_id="1" name="美帆"
		   text="『ええ、今日からアナタのルームメイトになる仲根美帆よ。よろしくね。』" voices="miho13490"/>
		<msg @l="858" char_id="-1" frame_id="-1" name="女の子" text="『よ、よろしくお願いします‥‥。』"
		   voices=""/>
		<msg @l="860" char_id="-1" frame_id="-1" name=""
		   text="彼女はそう言って、ぎこちなく笑おうとする。" voices=""/>
		<msg @l="861" char_id="-1" frame_id="-1" name=""
		   text="けれど、その笑みも私の衣服に視線が向けられた途端････驚き、それから顔を真っ赤にしてうつむいてしまう。" voices=""/>
		<msg @l="862" char_id="-1" frame_id="-1" name="" text="そんな仕草が初々しくて‥‥可愛い。"
		   voices=""/>
		<msg @l="864" char_id="0" frame_id="1" name="美帆" text="『ふふ。』"
		   voices="miho13500"/>
		<msg @l="866" char_id="-1" frame_id="-1" name=""
		   text="私は彼女の視線にわざと気付かないフリをして、話を続ける。" voices=""/>
		<msg @l="868" char_id="0" frame_id="1" name="美帆"
		   text="『この素晴らしい南総町へようこそ。あなたのように可愛ければ立派な南総町の住人として迎え入れられるわ。』"
		   voices="miho13510"/>
		<msg @l="870" char_id="-1" frame_id="-1" name=""
		   text="そう、可愛ければこの町で生きていくなんて簡単な事だ。" voices=""/>
		<msg @l="871" char_id="-1" frame_id="-1" name=""
		   text="あと彼女に必要なのは、導いてあげられる存在だけ‥‥。" voices=""/>
		<msg @l="872" char_id="-1" frame_id="-1" name=""
		   text="これから彼女の身に起こるであろう数々の官能的な出来事をうっすらと想像しながら、私は‥‥‥‥自分の秘部を濡らしていた。"
		   voices=""/>
		<msg @l="874" char_id="-1" frame_id="-1" name=""
		   text="これからの日々をそっと夢想しながら、私はもう一度同じ言葉を口にする。" voices=""/>
		<msg @l="876" char_id="0" frame_id="1" name="美帆" text="『南総町へようこそ。』"
		   voices="miho13480"/>
		<msg @l="878" char_id="-1" frame_id="-1" name="" text="そう、全てはこの町から始まる。"
		   voices=""/>
		<msg @l="879" char_id="-1" frame_id="-1" name="" text="今日この日から始まる。"
		   voices=""/>
		<msg @l="880" char_id="-1" frame_id="-1" name=""
		   text="きっと艶やかに彩られるであろう―――官能的な毎日が。" voices=""/>
		<stopbgm @l="884" fadeout="1000"/>
		<clear @l="890" class="all"/>
		<end_scene @l="893"/>
		<call @l="896" target="EventLabel_154@staffroom"/>
		<return @l="897" value="0&#13;&#10;"/>
		<return @l="900" value=""/>
	</code>
</xscript>
