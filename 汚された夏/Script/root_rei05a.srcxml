<?xml version="1.0" encoding="utf-8"?>
<xscript>
	<debug editor="&quot;C:\Program&#32;Files&#32;(x86)\sakura\sakura.exe&quot;&#32;&quot;%src%&quot;&#32;-Y=%line%"
	   src="D:\シロップ\町ぐるみの罠＋汚された夏セット版\汚された夏\完成データ\汚された夏\script\text\root_rei05a.txt"/>
	<code>
		<label @l="13" id="EventLabel_142"/>
		<description @l="17" text="ルームメイトの憂鬱・５日目(Ａ)"/>
		<eval @l="19" expr="f.numDay=11&#13;&#10;"/>
		<msgshow @l="21" show="false"/>
		<wait_chgmv/>
		<bg @l="23" src="day11" time="2000"/>
		<wait @l="25" time="500"/>
		<wait_chgmv/>
		<bg @l="27" src="black" time="2000"/>
		<msgshow @l="29" show="true"/>
		<wait_chgmv/>
		<bg @l="33" src="bg03"/>
		<bgm @l="37" src="bgm03" volume="1."/>
		<msg @l="39" char_id="0" frame_id="-1" name="美帆" text="『ん‥‥。』" voices=""/>
		<msg @l="41" char_id="-1" frame_id="-1" name=""
		   text="まぶたを通してチリチリと感じる朝日の眩しさと暑さに、私はわずかな不快感を覚えて目を覚ました。" voices=""/>
		<msg @l="42" char_id="-1" frame_id="-1" name=""
		   text="眉をしかめてゆっくりとまぶたを開くと‥‥見慣れている家具や間取りが視界に飛び込んできて私はいつものように身体を起こした。"
		   voices=""/>
		<char @l="46" id="miho" pos="auto" src="miho136"/>
		<msg @l="48" char_id="0" frame_id="-1" name="美帆" text="『あれ‥‥私？』" voices=""/>
		<msg @l="50" char_id="-1" frame_id="-1" name=""
		   text="どうやら私はリビングのソファで‥‥眠ってしまっていたようだ。" voices=""/>
		<char @l="54" id="miho" pos="auto" src="miho035"/>
		<msg @l="56" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="58" char_id="0" frame_id="-1" name="美帆"
		   text="『そっか‥‥玲さんの帰りを待ってて、それで‥‥‥‥。』" voices=""/>
		<msg @l="60" char_id="-1" frame_id="-1" name=""
		   text="昨日‥‥朽木教授が立ち去った後、とにかく何かしなくてはと思い、玲さんの帰りを待つ事に決めた。" voices=""/>
		<msg @l="61" char_id="-1" frame_id="-1" name=""
		   text="ただ、それも誰かに助けを求めたかっただけなのかもしれない。" voices=""/>
		<msg @l="62" char_id="-1" frame_id="-1" name=""
		   text="誰かに慰めてもらいたかっただけなのかもしれない。" voices=""/>
		<msg @l="63" char_id="-1" frame_id="-1" name=""
		   text="大丈夫だよ、汚れてなんかいないよと‥‥そう言って欲しくて―――。" voices=""/>
		<msg @l="64" char_id="-1" frame_id="-1" name=""
		   text="まだわずかに霞んでいる目をこすりながら、私は途切れてしまっていた記憶をたどった。" voices=""/>
		<msg @l="66" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="68" char_id="-1" frame_id="-1" name=""
		   text="テーブルの上にはラップしたままの夕飯が並んでいる。" voices=""/>
		<msg @l="69" char_id="-1" frame_id="-1" name="" text="玲さんは‥‥やはり帰ってこなかったのだ。"
		   voices=""/>
		<msg @l="71" char_id="0" frame_id="-1" name="美帆" text="『玲さん、どうして‥‥‥。』"
		   voices=""/>
		<char @l="75" id="miho" pos="auto" src="miho135"/>
		<msg @l="77" char_id="0" frame_id="-1" name="美帆" text="『どうして戻ってこないんですか‥‥‥。』"
		   voices=""/>
		<msg @l="79" char_id="-1" frame_id="-1" name=""
		   text="私は震える声でそれだけを発し‥‥少しだけ泣いた。" voices=""/>
		<msg @l="80" char_id="-1" frame_id="-1" name="" text="今はただとにかく玲さんに会いたくて‥‥。"
		   voices=""/>
		<msg @l="82" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥っ‥‥。』" voices=""/>
		<msg @l="84" char_id="-1" frame_id="-1" name=""
		   text="零れ落ちた涙が膝の上で硬く握った手の甲へと落ちる。" voices=""/>
		<msg @l="85" char_id="-1" frame_id="-1" name="" text="奪われた処女。" voices=""/>
		<msg @l="86" char_id="-1" frame_id="-1" name="" text="傷ついた身体。" voices=""/>
		<msg @l="87" char_id="-1" frame_id="-1" name="" text="汚された‥‥心。" voices=""/>
		<msg @l="88" char_id="-1" frame_id="-1" name=""
		   text="昨日まで当たり前に持っていたものが、たった一人の男によって壊され奪われてしまった。" voices=""/>
		<msg @l="89" char_id="-1" frame_id="-1" name="" text="それが何よりも悔しくて‥‥。"
		   voices=""/>
		<msg @l="91" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="93" char_id="0" frame_id="-1" name="美帆"
		   text="(ダメ‥‥泣いてても、どうにもならないよ)" voices=""/>
		<msg @l="95" char_id="0" frame_id="-1" name="美帆" text="(考えなきゃ‥‥)" voices=""/>
		<msg @l="97" char_id="0" frame_id="-1" name="美帆"
		   text="(自分に何が出来るのかをちゃんと考えて、それで行動しよう)" voices=""/>
		<clear @l="103" class="all"/>
		<se @l="107" buf="3" loop="true" src="水音2" volume="1."/>
		<msg @l="109" char_id="-1" frame_id="-1" name="" text="それから私はシャワーを浴びた。"
		   voices=""/>
		<msg @l="110" char_id="-1" frame_id="-1" name=""
		   text="涙も、悲しみも、溢れ出す血も、精液も‥‥全て洗い流してしまえばいい。" voices=""/>
		<msg @l="111" char_id="-1" frame_id="-1" name="" text="動けなくなってしまってからでは遅い。"
		   voices=""/>
		<msg @l="112" char_id="-1" frame_id="-1" name=""
		   text="進む道を見失うと、その場でうずくまって動けなくなる‥‥私の悪い癖だ。" voices=""/>
		<msg @l="113" char_id="-1" frame_id="-1" name=""
		   text="この町に来る時、それだけはやめようと思った。" voices=""/>
		<msg @l="114" char_id="-1" frame_id="-1" name="" text="積極性の無い自分を変えようと思った。"
		   voices=""/>
		<msg @l="115" char_id="-1" frame_id="-1" name=""
		   text="ここで立ち止まってしまったら、もう二度と先に進めないような気がした。" voices=""/>
		<msg @l="116" char_id="-1" frame_id="-1" name="" text="だから‥‥私は止まるわけにはいかない。"
		   voices=""/>
		<msg @l="117" char_id="-1" frame_id="-1" name="" text="玲さんのために、自分のために―――。"
		   voices=""/>
		<stopse @l="121" buf="3"/>
		<wait_chgmv/>
		<bg @l="125" src="bg03"/>
		<char @l="129" id="miho" pos="auto" src="miho126"/>
		<msg @l="131" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="133" char_id="0" frame_id="-1" name="美帆"
		   text="(行こう‥‥自分に出来ることが無いか、探す所から始めなきゃ)" voices=""/>
		<clear @l="139" class="all"/>
		<msgshow @l="141" show="true"/>
		<wait_chgmv/>
		<bg @l="145" src="bg16"/>
		<char @l="149" id="miho" pos="auto" src="miho126"/>
		<msg @l="151" char_id="0" frame_id="-1" name="美帆"
		   text="(‥‥何も考えずにここまで来ちゃったけど)" voices=""/>
		<msg @l="153" char_id="0" frame_id="-1" name="美帆"
		   text="(いきなりで‥‥玲さんに会わせてもらえるのかな)" voices=""/>
		<msg @l="155" char_id="-1" frame_id="-1" name=""
		   text="私は目の前の建物を見上げながら‥‥太陽のまぶしさに目を細める。" voices=""/>
		<msg @l="156" char_id="-1" frame_id="-1" name="" text="気付けば大黒建設の前まで来ていた。"
		   voices=""/>
		<msg @l="157" char_id="-1" frame_id="-1" name="" text="ただ、玲さんに会って話をしたいと思った。"
		   voices=""/>
		<clear @l="163" class="all"/>
		<se @l="167" buf="1" src="自動ドアの音" volume="1."/>
		<msg @l="169" char_id="-1" frame_id="-1" name=""
		   text="自動ドアをくぐり、真っ直ぐに受付へ向かう。" voices=""/>
		<wait_chgmv/>
		<bg @l="173" src="bg17m1"/>
		<char @l="176" id="miho" pos="center" src="miho025f" y="-80"/>
		<msg @l="178" char_id="0" frame_id="-1" name="美帆"
		   text="『あの、こちらに白石という方がいらっしゃると思うんですが呼び出して戴けますでしょうか？』" voices=""/>
		<msg @l="180" char_id="-1" frame_id="-1" name="受付嬢"
		   text="『白石ですね‥‥少々お待ちください。』" voices=""/>
		<msg @l="182" char_id="-1" frame_id="-1" name=""
		   text="事務的な口調でそう言って、受付嬢の彼女は手元のキーボードを叩く。" voices=""/>
		<msg @l="184" char_id="-1" frame_id="-1" name="受付嬢"
		   text="『申し訳ございません、弊社の社員に白石という者はおりませんが。』" voices=""/>
		<char @l="186" id="miho" pos="center" src="miho024f" y="-80"/>
		<msg @l="188" char_id="0" frame_id="-1" name="美帆"
		   text="『あ、えっと‥‥社員じゃなくてですね、先日から面接に伺っている者が居ると思うのですが。』" voices=""/>
		<msg @l="190" char_id="-1" frame_id="-1" name="受付嬢" text="『‥‥かしこまりました。』"
		   voices=""/>
		<msg @l="192" char_id="-1" frame_id="-1" name="受付嬢"
		   text="『ただいま担当の者を呼び出しますので、少々お待ちください。』" voices=""/>
		<char @l="195" id="miho" pos="center" src="miho025f" y="-80"/>
		<msg @l="197" char_id="0" frame_id="-1" name="美帆" text="『はい‥‥お願いします。』"
		   voices=""/>
		<msg @l="199" char_id="0" frame_id="-1" name="美帆"
		   text="(一瞬だけ表情が変わった‥‥やっぱり、何かあるんだ)" voices=""/>
		<msg @l="201" char_id="-1" frame_id="-1" name="受付嬢" text="『はい‥‥はい、わかりました。』"
		   voices=""/>
		<msg @l="203" char_id="-1" frame_id="-1" name="受付嬢" text="『では、そのように致します。』"
		   voices=""/>
		<msg @l="205" char_id="-1" frame_id="-1" name="" text="内線だろうか。" voices=""/>
		<msg @l="206" char_id="-1" frame_id="-1" name=""
		   text="電話口に向かってやはり事務的な口調で受け答えをしている彼女を見ながら、私はぼんやりと「朽木教授が言っていた事」を考えていた。"
		   voices=""/>
		<msg @l="207" char_id="-1" frame_id="-1" name="" text="「男性社員の性欲処理係」のこと。"
		   voices=""/>
		<msg @l="208" char_id="-1" frame_id="-1" name=""
		   text="そして‥‥玲さんがその「男性社員の性欲処理係」として、この大黒建設に軟禁されているのではないかということ。" voices=""/>
		<msg @l="210" char_id="-1" frame_id="-1" name="受付嬢"
		   text="『担当の方が会われるそうですので、ご案内致します。』" voices=""/>
		<msg @l="212" char_id="0" frame_id="-1" name="美帆" text="『あ‥‥はい。』" voices=""/>
		<clear @l="218" class="all"/>
		<msgshow @l="220" show="true"/>
		<wait_chgmv/>
		<bg @l="224" src="bg17m1"/>
		<msg @l="226" char_id="-1" frame_id="-1" name="受付嬢"
		   text="『すぐに担当の者が参りますので、こちらでお待ちください。』" voices=""/>
		<char @l="230" id="miho" pos="auto" src="miho126"/>
		<msg @l="232" char_id="0" frame_id="-1" name="美帆" text="『わかりました‥‥。』"
		   voices=""/>
		<msg @l="234" char_id="-1" frame_id="-1" name=""
		   text="数日前に訪れた、あのオフィスの入り口へと私を連れてくると、受付嬢の彼女は今来た廊下を一人で戻っていく。" voices=""/>
		<msg @l="235" char_id="-1" frame_id="-1" name=""
		   text="彼女はこの会社が裏側で何をしているのか知っているのだろうか。" voices=""/>
		<msg @l="236" char_id="-1" frame_id="-1" name=""
		   text="もしも知っているなら‥‥同じ女性として私がいま感じているような嫌悪感を抱いたりはしないのだろうか。" voices=""/>
		<msg @l="237" char_id="-1" frame_id="-1" name=""
		   text="玲さんが自ら望んでそんな仕事に従事するとは‥‥思えない。" voices=""/>
		<msg @l="238" char_id="-1" frame_id="-1" name="" text="だとすると、考えられるのは二つ‥‥。"
		   voices=""/>
		<msg @l="239" char_id="-1" frame_id="-1" name=""
		   text="脅迫されているか‥‥それとも騙されているかのどちらかだ。" voices=""/>
		<msg @l="241" char_id="0" frame_id="-1" name="美帆"
		   text="(悪いことをしてるってわかってもらえれば、玲さんを解放してもらえることくらいは出来るかもしれない)" voices=""/>
		<msg @l="243" char_id="-1" frame_id="-1" name="声" text="『お待たせ致しました。』"
		   voices=""/>
		<char @l="246" id="miho" pos="auto" src="miho024"/>
		<msg @l="248" char_id="0" frame_id="-1" name="美帆" text="『あ‥‥。』" voices=""/>
		<char @l="252" id="ookur" pos="auto" src="ookuro010"/>
		<bgm @l="256" src="bgm09" volume="1."/>
		<msg @l="258" char_id="-1" frame_id="-1" name=""
		   text="言葉と共に歩み寄ってくるかっぷくのよい男性には、見覚えがあった。" voices=""/>
		<msg @l="259" char_id="-1" frame_id="-1" name=""
		   text="以前、私が書類を届けに来た時に会った‥‥あの男性だ。" voices=""/>
		<msg @l="261" char_id="-1" frame_id="-1" name="スーツの男"
		   text="『ようこそお出でくださいました。』" voices=""/>
		<msg @l="263" char_id="-1" frame_id="-1" name="スーツの男"
		   text="『ご用件は受付の者から聞いております。私についてきてください。』" voices=""/>
		<clear @l="267" class="char"/>
		<char @l="271" id="miho" pos="auto" src="miho024"/>
		<msg @l="273" char_id="0" frame_id="-1" name="美帆" text="『え‥‥あ、あのっ！』"
		   voices=""/>
		<clear @l="276" class="char"/>
		<char @l="278" id="miho" pos="left" src="miho024"/>
		<char @l="281" id="ookur" pos="right" src="ookuro010"/>
		<msg @l="283" char_id="-1" frame_id="-1" name="スーツの男" text="『はい？』" voices=""/>
		<char @l="287" id="miho" pos="left" src="miho025"/>
		<msg @l="289" char_id="0" frame_id="-1" name="美帆"
		   text="『玲さんは‥‥白石さんはこちらにいるのですか？』" voices=""/>
		<msg @l="291" char_id="-1" frame_id="-1" name="スーツの男"
		   text="『それは、ついてきて戴ければわかることです。』" voices=""/>
		<msg @l="293" char_id="0" frame_id="-1" name="美帆" text="『‥‥いるんですね。』"
		   voices=""/>
		<msg @l="295" char_id="-1" frame_id="-1" name="スーツの男"
		   text="『そう急がずともすぐにわかる‥‥それではご不満ですか？』" voices=""/>
		<char @l="297" id="miho" pos="left" src="miho125"/>
		<msg @l="299" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="301" char_id="-1" frame_id="-1" name="スーツの男"
		   text="『なるほど、ご不満のようですね。』" voices=""/>
		<msg @l="303" char_id="-1" frame_id="-1" name="スーツの男"
		   text="『では率直に言いましょう‥‥彼女は確かにここにいますよ、仲根美帆さん。』" voices=""/>
		<char @l="307" id="miho" pos="left" src="miho024"/>
		<msg @l="309" char_id="0" frame_id="-1" name="美帆" text="『‥‥！？』" voices=""/>
		<msg @l="311" char_id="0" frame_id="-1" name="美帆" text="『ど、どうして私の名前を‥‥？』"
		   voices=""/>
		<msg @l="313" char_id="-1" frame_id="-1" name="スーツの男"
		   text="『さて‥‥どうしてでしょうねぇ。』" voices=""/>
		<clear @l="316" layer="ookur"/>
		<char @l="318" id="ookur" pos="auto" src="ookuro010"/>
		<msg @l="320" char_id="-1" frame_id="-1" name="スーツの男"
		   text="『それよりも、今は彼女に会いに行くのが先決ではありませんか？』" voices=""/>
		<char @l="324" id="miho" pos="left" src="miho125"/>
		<msg @l="326" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="328" char_id="-1" frame_id="-1" name=""
		   text="かっぷくのよい彼は、ひょうひょうとした口ぶりでそう言うと、美帆の腰に手を回してきた。" voices=""/>
		<msg @l="329" char_id="-1" frame_id="-1" name=""
		   text="腰を撫でる彼の手が気持ち悪く、美帆は身体をビクッとさせ手を払おうとする。" voices=""/>
		<msg @l="330" char_id="-1" frame_id="-1" name="スーツの男"
		   text="『あぁ、別に会いたくなければ帰ってもらって結構ですよ。』" voices=""/>
		<msg @l="331" char_id="-1" frame_id="-1" name=""
		   text="彼は勝ち誇ったかのような顔で言い、腰にまわした手をお尻に持ってくる。" voices=""/>
		<msg @l="333" char_id="0" frame_id="-1" name="美帆" text="『･･････････っ。』"
		   voices=""/>
		<msg @l="335" char_id="0" frame_id="-1" name="美帆"
		   text="(･･････今は、ついていくしかない‥‥のかな)" voices=""/>
		<msg @l="337" char_id="-1" frame_id="-1" name="大黒" text="『どうしますか？』"
		   voices=""/>
		<char @l="339" id="miho" pos="left" src="miho025"/>
		<msg @l="340" char_id="0" frame_id="-1" name="美帆" text="『･･････わ、わかりました。』"
		   voices=""/>
		<msg @l="342" char_id="-1" frame_id="-1" name=""
		   text="私は‥‥わずかに迷ったが、すぐに彼の言うとおりにしたのだった。" voices=""/>
		<clear @l="344" class="char"/>
		<clear @l="349" class="all"/>
		<wait_chgmv/>
		<bg @l="353" src="bg17h1"/>
		<char @l="357" id="ookur" pos="left" src="ookuro010"/>
		<msg @l="359" char_id="-1" frame_id="-1" name="スーツの男" text="『こちらへどうぞ。』"
		   voices=""/>
		<char @l="363" id="miho" pos="right" src="miho126"/>
		<msg @l="365" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="367" char_id="-1" frame_id="-1" name=""
		   text="オフィスを縦断し、一番奥にある会議スペースのような場所に通された。" voices=""/>
		<msg @l="368" char_id="-1" frame_id="-1" name=""
		   text="パーティションで区切られた所に事務机が一つと、それを囲うように椅子が四つ並べられている。" voices=""/>
		<msg @l="369" char_id="-1" frame_id="-1" name=""
		   text="机の上にはパソコンが置かれていて、壁際にある液晶モニタの画面には沢山のファイルが表示されていた。" voices=""/>
		<msg @l="371" char_id="-1" frame_id="-1" name="スーツの男"
		   text="『まず、こちらを見て戴きましょうか。』" voices=""/>
		<msg @l="373" char_id="-1" frame_id="-1" name=""
		   text="私を椅子に座らせると、スーツ姿の彼はそう言って、私の肩越しに机の上へと手を伸ばした。" voices=""/>
		<msg @l="374" char_id="-1" frame_id="-1" name=""
		   text="彼がマウスを動かすと、画面に新しい枠が表示される。" voices=""/>
		<msg @l="376" char_id="0" frame_id="-1" name="美帆" text="『あの‥‥これは？』"
		   voices=""/>
		<msg @l="378" char_id="-1" frame_id="-1" name="スーツの男" text="『見ていればわかりますよ。』"
		   voices=""/>
		<msg @l="380" char_id="0" frame_id="-1" name="美帆" text="『はあ‥‥。』" voices=""/>
		<msg @l="382" char_id="-1" frame_id="-1" name=""
		   text="言われた通り、私は画面上に新しく出来たその枠をじっと見つめる。" voices=""/>
		<msg @l="383" char_id="-1" frame_id="-1" name=""
		   text="とはいえ枠の中身は真っ黒なままで、見ていても何も‥‥。" voices=""/>
		<msg @l="385" char_id="1" frame_id="-1" name="声" text="『んっ‥‥ああっ‥‥‥。』"
		   voices=""/>
		<char @l="389" id="miho" pos="right" src="miho124"/>
		<msg @l="391" char_id="0" frame_id="-1" name="美帆" text="『‥‥！？』" voices=""/>
		<msg @l="393" char_id="-1" frame_id="-1" name=""
		   text="不意に、スピーカーから艶やかな声が聞こえてきた。" voices=""/>
		<msg @l="394" char_id="-1" frame_id="-1" name=""
		   text="それまで真っ暗だった枠の中に‥‥見るからにそれとわかる行為をしている裸の男女が鮮明に映し出されたのである。" voices=""/>
		<msg @l="396" char_id="0" frame_id="-1" name="美帆" text="『え‥‥‥これ、玲さん‥‥‥‥？』"
		   voices=""/>
		<msg @l="398" char_id="-1" frame_id="-1" name=""
		   text="枠の中に映っている裸の女性は、玲さんだった。" voices=""/>
		<msg @l="399" char_id="-1" frame_id="-1" name=""
		   text="複数の男たちに囲まれ、口や胸やアソコを乱暴に犯されている玲さんの姿が小さな枠の中に映し出されていた。" voices=""/>
		<msg @l="401" char_id="-1" frame_id="-1" name="スーツの男"
		   text="『どうです、綺麗に撮れているでしょう？』" voices=""/>
		<msg @l="403" char_id="-1" frame_id="-1" name="スーツの男"
		   text="『モザイク処理を施す前ですから、結合部までくっきりと見えますよ。』" voices=""/>
		<msg @l="405" char_id="-1" frame_id="-1" name="" text="スーツ姿の彼は楽しげに私の耳元で囁いた。"
		   voices=""/>
		<msg @l="406" char_id="-1" frame_id="-1" name=""
		   text="私は‥‥見てはいけないと思いながらも、画面から目が離せない。" voices=""/>
		<msg @l="408" char_id="-1" frame_id="-1" name="スーツの男"
		   text="『ちなみに、これは昨日録画したばかりのモノです。』" voices=""/>
		<msg @l="410" char_id="-1" frame_id="-1" name="スーツの男"
		   text="『本日の映像はまだ録画中ですので、もう少し待って戴ければお見せできますよ？』" voices=""/>
		<char @l="413" id="miho" pos="right" src="miho024"/>
		<msg @l="415" char_id="0" frame_id="-1" name="美帆" text="『本日って‥‥！？』"
		   voices=""/>
		<msg @l="417" char_id="-1" frame_id="-1" name=""
		   text="それはつまり、いま流れているような出来事が今もどこかで行われているということだ。" voices=""/>
		<msg @l="418" char_id="-1" frame_id="-1" name=""
		   text="この建物のどこかで、玲さんは今も男たちに蹂躙され続けている。" voices=""/>
		<msg @l="419" char_id="-1" frame_id="-1" name=""
		   text="そう思うと‥‥胸に刺すような痛みが走った。" voices=""/>
		<char @l="422" id="miho" pos="right" src="miho025"/>
		<msg @l="424" char_id="0" frame_id="-1" name="美帆" text="『ひどい‥‥どうしてこんな‥‥‥‥。』"
		   voices=""/>
		<msg @l="426" char_id="-1" frame_id="-1" name="スーツの男"
		   text="『ひどい？&#32;それは心外ですね。』" voices=""/>
		<msg @l="428" char_id="-1" frame_id="-1" name="スーツの男"
		   text="『彼女は弊社に就職を希望されていた、だからこうして弊社業務の一つをお任せしているのですよ。』" voices=""/>
		<msg @l="430" char_id="-1" frame_id="-1" name="スーツの男"
		   text="『といっても‥‥まだ研修段階ですけどね。』" voices=""/>
		<char @l="434" id="miho" pos="right" src="miho125"/>
		<msg @l="436" char_id="0" frame_id="-1" name="美帆" text="『それは‥‥。』" voices=""/>
		<msg @l="438" char_id="-1" frame_id="-1" name="スーツの男" text="『はい？』" voices=""/>
		<msg @l="440" char_id="0" frame_id="-1" name="美帆"
		   text="『それは‥‥玲さんが、彼女が自分から望んだことなんですか！？』" voices=""/>
		<msg @l="442" char_id="-1" frame_id="-1" name="スーツの男" text="『もちろんです。』"
		   voices=""/>
		<char @l="446" id="miho" pos="right" src="miho125"/>
		<msg @l="448" char_id="0" frame_id="-1" name="美帆"
		   text="『嘘です！&#32;玲さんは建築デザイナーになりたいって言ってました。』" voices=""/>
		<msg @l="450" char_id="0" frame_id="-1" name="美帆"
		   text="『それなのにこんな‥‥信じられません。』" voices=""/>
		<msg @l="452" char_id="-1" frame_id="-1" name=""
		   text="画面の中で犯されている玲さんの表情は、自ら望んだとは思えないほど苦痛に満ちている。" voices=""/>
		<msg @l="454" char_id="-1" frame_id="-1" name="スーツの男"
		   text="『困りましたね‥‥どのように説明すれば信じて戴けるのですか。』" voices=""/>
		<msg @l="456" char_id="0" frame_id="-1" name="美帆" text="『何を言われても信じられません。』"
		   voices=""/>
		<char @l="458" id="miho" pos="right" src="miho025"/>
		<msg @l="459" char_id="0" frame_id="-1" name="美帆"
		   text="『玲さんに‥‥玲さんに会わせてください！』" voices=""/>
		<msg @l="461" char_id="-1" frame_id="-1" name="スーツの男" text="『それはできません。』"
		   voices=""/>
		<msg @l="463" char_id="0" frame_id="-1" name="美帆" text="『どうしてですかっ！？』"
		   voices=""/>
		<msg @l="465" char_id="-1" frame_id="-1" name="スーツの男"
		   text="『彼女はいま研修の真っ最中ですからね。それに折角の決心がアナタと会うことで揺らいでしまっては困ります。』" voices=""/>
		<char @l="469" id="miho" pos="right" src="miho025"/>
		<msg @l="471" char_id="0" frame_id="-1" name="美帆" text="『それ、どういう意味ですか‥‥。』"
		   voices=""/>
		<msg @l="473" char_id="-1" frame_id="-1" name="スーツの男"
		   text="『さて‥‥お話はここまでにしましょうか。』" voices=""/>
		<msg @l="475" char_id="-1" frame_id="-1" name="スーツの男"
		   text="『真島君、彼女を拘束してください。』" voices=""/>
		<msg @l="477" char_id="-1" frame_id="-1" name=""
		   text="そう言ってスーツの男が口の端を歪めると、目つきの鋭い男性がパーティションで区切られたブースの中に入り込んできて私の手を掴む。"
		   voices=""/>
		<msg @l="478" char_id="-1" frame_id="-1" name=""
		   text="‥‥ずっと、ブースの外で私たちの様子を伺っていたのだろう。" voices=""/>
		<char @l="482" id="miho" pos="right" src="miho124"/>
		<msg @l="484" char_id="0" frame_id="-1" name="美帆" text="『やだ‥‥離してくださいっ！』"
		   voices=""/>
		<msg @l="486" char_id="-1" frame_id="-1" name="真島"
		   text="『おっと‥‥大人しくした方が懸命だぜ、お嬢ちゃん。』" voices=""/>
		<msg @l="488" char_id="-1" frame_id="-1" name="真島"
		   text="『俺は平等主義者でね、相手が男でも女でも言うことを聞かないヤツには一切手加減しないことにしてんだよ。』" voices=""/>
		<char @l="492" id="miho" pos="right" src="miho125"/>
		<msg @l="494" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="496" char_id="-1" frame_id="-1" name="真島"
		   text="『そうそう。大人しくしてりゃ痛い目に会うこともねーんだ。』" voices=""/>
		<msg @l="498" char_id="-1" frame_id="-1" name="真島"
		   text="『ま、俺は暴れてくれたほーが楽しくていいんだけどなあ？』" voices=""/>
		<msg @l="500" char_id="-1" frame_id="-1" name="スーツの男"
		   text="『真島君、彼女で遊んではダメですよ。』" voices=""/>
		<msg @l="502" char_id="-1" frame_id="-1" name="真島"
		   text="『へへっ、心配しなくても俺は大黒さんのお客人に手荒な事はしませんよ。』" voices=""/>
		<char @l="506" id="miho" pos="right" src="miho024"/>
		<msg @l="508" char_id="0" frame_id="-1" name="美帆" text="『え‥‥大黒って？』"
		   voices=""/>
		<msg @l="510" char_id="-1" frame_id="-1" name="スーツの男"
		   text="『ああ、自己紹介がまだでしたね。』" voices=""/>
		<msg @l="512" char_id="-1" frame_id="-1" name="大黒"
		   text="『私が大黒建設南総町支社の支社長、大黒満彦です。よろしくお見知りおきください。』" voices=""/>
		<char @l="516" id="miho" pos="right" src="miho025"/>
		<msg @l="518" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="520" char_id="-1" frame_id="-1" name="大黒"
		   text="『意外ですか？&#32;それとも驚きでしょうか。』" voices=""/>
		<msg @l="522" char_id="0" frame_id="-1" name="美帆"
		   text="『社長自らこんな事を‥‥狂ってます‥‥。』" voices=""/>
		<msg @l="524" char_id="-1" frame_id="-1" name="大黒"
		   text="『それは褒め言葉として受け取りましょう。』" voices=""/>
		<msg @l="526" char_id="-1" frame_id="-1" name="大黒"
		   text="『狂っていることが‥‥この町では正しいのですよ。』" voices=""/>
		<msg @l="528" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="530" char_id="0" frame_id="-1" name="美帆" text="『私をどうするつもりですか。』"
		   voices=""/>
		<msg @l="532" char_id="0" frame_id="-1" name="美帆"
		   text="『玲さんみたいに‥‥無理やり男の人たちの相手をさせるつもりですか。』" voices=""/>
		<msg @l="534" char_id="-1" frame_id="-1" name="大黒"
		   text="『そうですね‥‥玲さんを助けにきたアナタの勇気と心意気に免じて一つ賭けをしましょうか。』" voices=""/>
		<msg @l="536" char_id="0" frame_id="-1" name="美帆" text="『賭け‥‥ですか？』"
		   voices=""/>
		<msg @l="538" char_id="-1" frame_id="-1" name="大黒"
		   text="『ええ。アナタがその賭けに勝つことが出来れば、彼女に会わせて差し上げましょう。』" voices=""/>
		<msg @l="540" char_id="-1" frame_id="-1" name="大黒"
		   text="『その時に彼女が帰宅を望めば‥‥お二人とも帰って戴いて結構ですよ。』" voices=""/>
		<char @l="544" id="miho" pos="right" src="miho024"/>
		<msg @l="546" char_id="0" frame_id="-1" name="美帆" text="『え‥‥ほ、本当ですかっ！？』"
		   voices=""/>
		<msg @l="548" char_id="-1" frame_id="-1" name="大黒"
		   text="『信じる信じないはアナタの自由です。』" voices=""/>
		<char @l="552" id="miho" pos="right" src="miho125"/>
		<msg @l="554" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="556" char_id="-1" frame_id="-1" name=""
		   text="正直なところ‥‥この人の言葉は信じられない。" voices=""/>
		<msg @l="557" char_id="-1" frame_id="-1" name=""
		   text="でも、今は信じて従うしか‥‥玲さんを救う方法はない。" voices=""/>
		<msg @l="559" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<char @l="562" id="miho" pos="right" src="miho025"/>
		<msg @l="564" char_id="0" frame_id="-1" name="美帆" text="『わかりました‥‥信じます。』"
		   voices=""/>
		<msg @l="566" char_id="-1" frame_id="-1" name="大黒" text="『良いでしょう。』"
		   voices=""/>
		<msg @l="568" char_id="-1" frame_id="-1" name="大黒" text="『真島君、準備をお願いします。』"
		   voices=""/>
		<msg @l="570" char_id="-1" frame_id="-1" name="真島" text="『わかってますよ。』"
		   voices=""/>
		<msg @l="572" char_id="-1" frame_id="-1" name=""
		   text="真島と呼ばれた目つきの鋭い男はそう言っていやらしい笑みを浮かべ、私を一瞥してから、ブースを出て行く。" voices=""/>
		<msg @l="574" char_id="0" frame_id="-1" name="美帆"
		   text="『‥‥賭けって、何をすれば良いんですか？』" voices=""/>
		<msg @l="576" char_id="-1" frame_id="-1" name="大黒" text="『待っていればすぐにわかりますよ。』"
		   voices=""/>
		<msg @l="578" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<clear @l="584" class="all"/>
		<msgshow @l="586" show="true"/>
		<wait_chgmv/>
		<bg @l="590" src="bg17h1"/>
		<char @l="594" id="ookur" pos="left" src="ookuro010"/>
		<char @l="598" id="miho" pos="right" src="miho125"/>
		<msg @l="602" char_id="-1" frame_id="-1" name="真島" text="『準備が整いましたぜ。』"
		   voices=""/>
		<msg @l="604" char_id="-1" frame_id="-1" name="" text="五分ほど待たされただろうか。"
		   voices=""/>
		<msg @l="605" char_id="-1" frame_id="-1" name=""
		   text="大黒建設の社長と狭い空間で二人きりの‥‥息苦しい時間だった。" voices=""/>
		<msg @l="607" char_id="-1" frame_id="-1" name="大黒" text="『それでは、こちらへ来てください。』"
		   voices=""/>
		<msg @l="609" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="611" char_id="0" frame_id="-1" name="美帆" text="『‥‥はい。』" voices=""/>
		<clear @l="617" class="all"/>
		<msgshow @l="619" show="true"/>
		<wait_chgmv/>
		<bg @l="623" src="bg17"/>
		<char @l="627" id="ookur" pos="left" src="ookuro010"/>
		<char @l="631" id="miho" pos="right" src="miho126"/>
		<msg @l="633" char_id="-1" frame_id="-1" name=""
		   text="私が連れて来られたのは、妙に縦長の奇妙な部屋の前だった。" voices=""/>
		<msg @l="634" char_id="-1" frame_id="-1" name=""
		   text="応接室というには少し不似合いな‥‥不思議な部屋。" voices=""/>
		<msg @l="636" char_id="0" frame_id="-1" name="美帆" text="『あの‥‥一体、何をするんですか？』"
		   voices=""/>
		<msg @l="638" char_id="-1" frame_id="-1" name="大黒" text="『賭けです。』" voices=""/>
		<char @l="641" id="miho" pos="right" src="miho025"/>
		<msg @l="643" char_id="0" frame_id="-1" name="美帆" text="『それはわかってます。』"
		   voices=""/>
		<msg @l="645" char_id="0" frame_id="-1" name="美帆" text="『賭けの内容を‥‥教えてください。』"
		   voices=""/>
		<msg @l="647" char_id="-1" frame_id="-1" name="大黒" text="『真島君。』" voices=""/>
		<msg @l="649" char_id="-1" frame_id="-1" name="真島" text="『はい。』" voices=""/>
		<msg @l="651" char_id="-1" frame_id="-1" name="大黒" text="『彼女のお相手をお願いします。』"
		   voices=""/>
		<msg @l="653" char_id="-1" frame_id="-1" name="真島"
		   text="『俺でいいんですか？&#32;大黒さんのスゲェとこ、久々に見れると思ったのに。』" voices=""/>
		<msg @l="655" char_id="-1" frame_id="-1" name="大黒"
		   text="『私は隣で面接をしないといけないのでね‥‥こちらはお任せします。』" voices=""/>
		<msg @l="657" char_id="-1" frame_id="-1" name="大黒"
		   text="『ただし、賭けの範囲を逸脱して最後までやってしまっては駄目ですよ。』" voices=""/>
		<msg @l="659" char_id="-1" frame_id="-1" name="真島"
		   text="『なるほど‥‥‥‥。じゃあ、俺達もどっちが長く我慢できるか勝負ってやつっスね？』" voices=""/>
		<msg @l="661" char_id="-1" frame_id="-1" name="大黒" text="『どうです？最高の宴でしょう。』"
		   voices=""/>
		<msg @l="663" char_id="-1" frame_id="-1" name="真島"
		   text="『ええ。さすが大黒さん、エゲツねぇや。』" voices=""/>
		<char @l="667" id="miho" pos="right" src="miho024"/>
		<msg @l="669" char_id="0" frame_id="-1" name="美帆" text="『え‥‥あの、ちょっと？』"
		   voices=""/>
		<msg @l="671" char_id="-1" frame_id="-1" name=""
		   text="私の言葉など聞こえていないかのように、二人は勝手に話を進めてしまっている。" voices=""/>
		<msg @l="672" char_id="-1" frame_id="-1" name=""
		   text="相手とか、取っておくとか‥‥よく話が飲み込めない。" voices=""/>
		<msg @l="674" char_id="-1" frame_id="-1" name="大黒" text="『では、お願いしますよ。』"
		   voices=""/>
		<clear @l="678" class="char"/>
		<char @l="681" id="miho" pos="auto" src="miho024"/>
		<msg @l="683" char_id="0" frame_id="-1" name="美帆" text="『あっ‥‥。』" voices=""/>
		<msg @l="685" char_id="-1" frame_id="-1" name=""
		   text="何事も無かったかのように大黒が踵を返して隣の部屋へ行こうとした。" voices=""/>
		<msg @l="686" char_id="-1" frame_id="-1" name=""
		   text="賭けの内容もまだ聞いていないのに‥‥勝手にいなくなるなんてひどい。" voices=""/>
		<msg @l="687" char_id="-1" frame_id="-1" name=""
		   text="私にとっては玲さんを救うことが出来るかもしれない唯一の手段なのに。" voices=""/>
		<char @l="690" id="miho" pos="auto" src="miho025"/>
		<msg @l="692" char_id="0" frame_id="-1" name="美帆" text="『あの、賭けはどうするんですかっ！？』"
		   voices=""/>
		<msg @l="694" char_id="-1" frame_id="-1" name="大黒"
		   text="『賭けならばもう、はじまってますよ‥‥がんばってくださいね。』" voices=""/>
		<msg @l="696" char_id="-1" frame_id="-1" name="真島"
		   text="『ま、そーいうこった。よろしく頼むぜっ！』" voices=""/>
		<char @l="700" id="miho" pos="auto" src="miho124"/>
		<msg @l="702" char_id="0" frame_id="-1" name="美帆" text="『え‥‥きゃあっ！？』"
		   voices=""/>
		<stopbgm @l="706" fadeout="1000"/>
		<clear @l="712" class="all"/>
		<msgshow @l="714" show="true"/>
		<wait_chgmv/>
		<bg @l="718" src="bg17h1"/>
		<bgm @l="722" src="bgm15" volume="1."/>
		<msg @l="724" char_id="-1" frame_id="-1" name=""
		   text="突然、真島とかいう男が私を部屋の中へと押し倒す。" voices=""/>
		<msg @l="725" char_id="-1" frame_id="-1" name=""
		   text="とはいえ、こうなることを予想していなかったと言えば嘘になる。" voices=""/>
		<msg @l="726" char_id="-1" frame_id="-1" name="" text="覚悟は‥‥出来ていた。"
		   voices=""/>
		<char @l="730" id="miho" pos="center" src="miho005f" y="-80"/>
		<msg @l="732" char_id="0" frame_id="-1" name="美帆" text="『これが‥‥賭けの内容ですか。』"
		   voices=""/>
		<msg @l="734" char_id="-1" frame_id="-1" name="真島"
		   text="『ああ。俺をイかせることが出来ればあんたの勝ちだ。』" voices=""/>
		<char @l="737" id="miho" pos="center" src="miho004f" y="-80"/>
		<msg @l="739" char_id="0" frame_id="-1" name="美帆" text="『それって‥‥。』" voices=""/>
		<msg @l="741" char_id="-1" frame_id="-1" name="真島"
		   text="『簡単すぎるか？&#32;俺をその辺のオヤジと一緒にすんなよ。』" voices=""/>
		<char @l="744" id="miho" pos="center" src="miho005f" y="-80"/>
		<msg @l="746" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="748" char_id="-1" frame_id="-1" name="真島"
		   text="『でもまあ確かに、ただイかせるだけが条件じゃ簡単すぎるだろうからな‥‥あと二つだけ条件を付け足そうか。』" voices=""/>
		<msg @l="750" char_id="0" frame_id="-1" name="美帆" text="『二つも‥‥ですか。』"
		   voices=""/>
		<msg @l="752" char_id="-1" frame_id="-1" name="真島" text="『嫌ならやめてもいいんだぜ？』"
		   voices=""/>
		<msg @l="754" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="756" char_id="-1" frame_id="-1" name="" text="私は無言で頷く。" voices=""/>
		<msg @l="757" char_id="-1" frame_id="-1" name="" text="理不尽と思ったが‥‥それしか方法が無い。"
		   voices=""/>
		<msg @l="759" char_id="-1" frame_id="-1" name="真島" text="『じゃ、条件だ。』"
		   voices=""/>
		<msg @l="761" char_id="-1" frame_id="-1" name="真島"
		   text="『ひとつ目は１５分以内に俺をイかせる‥‥ふたつ目は、アンタは何もするな。』" voices=""/>
		<msg @l="763" char_id="0" frame_id="-1" name="美帆" text="『え‥‥何もするなって‥‥‥‥。』"
		   voices=""/>
		<msg @l="765" char_id="-1" frame_id="-1" name="真島"
		   text="『アンタは何もせず、俺がその気になるように工夫しろ。』" voices=""/>
		<char @l="768" id="miho" pos="center" src="miho105f" y="-80"/>
		<msg @l="770" char_id="0" frame_id="-1" name="美帆" text="『そんなの‥‥。』" voices=""/>
		<msg @l="772" char_id="-1" frame_id="-1" name="真島" text="『出来なきゃ賭けに負けるだけだ。』"
		   voices=""/>
		<msg @l="774" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="776" char_id="-1" frame_id="-1" name="真島" text="『どーだい、降りるなら今だぜ？』"
		   voices=""/>
		<char @l="779" id="miho" pos="center" src="miho005f" y="-80"/>
		<msg @l="781" char_id="0" frame_id="-1" name="美帆" text="『‥‥やります。』" voices=""/>
		<msg @l="783" char_id="-1" frame_id="-1" name="真島" text="『そりゃ結構。じゃあ早速始めるか。』"
		   voices=""/>
		<msg @l="785" char_id="0" frame_id="-1" name="美帆" text="『‥‥はい。』" voices=""/>
		<label @l="788" id="event_scene28"/>
		<label @l="792" id="chart_line35"/>
		<wait_chgmv/>
		<ev @l="796" src="ev-028"/>
		<description @l="799" text="悪意に満ちた取り引き"/>
		<bgm @l="803" src="bgm14" volume="1."/>
		<msg @l="805" char_id="0" frame_id="-1" name="美帆" text="『んっ‥‥。』"
		   voices="miho12480"/>
		<msg @l="807" char_id="-1" frame_id="-1" name=""
		   text="まだ殆ど硬さを得ていないモノが、私の胸の谷間に添えられる。" voices=""/>
		<msg @l="808" char_id="-1" frame_id="-1" name=""
		   text="賭けのルールに「何もするな」という条件が加えられてしまった以上、私は言われたとおり何もすることが出来ない。" voices=""/>
		<msg @l="809" char_id="-1" frame_id="-1" name=""
		   text="もし抵抗をしたりして賭けがなくなってしまっては元も子も無いのだ。" voices=""/>
		<msg @l="811" char_id="-1" frame_id="-1" name="真島"
		   text="『マ○コの方は使うなっていわれてるからな、かといって口でさせたんじゃつまらねーから‥‥あんたの柔らかそうな胸を使わせて貰う事にするぜ。』"
		   voices=""/>
		<msg @l="813" char_id="-1" frame_id="-1" name=""
		   text="そう言って真島は両手で私の胸をすくい上げると、谷間に添えたペニスを挟み込むように左右から寄せた。" voices=""/>
		<msg @l="815" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』"
		   voices="miho12490"/>
		<msg @l="817" char_id="-1" frame_id="-1" name="真島"
		   text="『そら、どーした？&#32;黙ってたんじゃ俺はイかねーぜ？』" voices=""/>
		<msg @l="819" char_id="0" frame_id="-1" name="美帆"
		   text="『でも、私‥‥‥どうしたらいいのかわからなくて‥‥‥‥‥。』" voices="miho12500"/>
		<msg @l="821" char_id="0" frame_id="-1" name="美帆"
		   text="『こんなこと‥‥‥したことないし‥‥‥‥。』" voices="miho12510"/>
		<msg @l="823" char_id="-1" frame_id="-1" name="真島"
		   text="『だったらずっと黙って１５分経つのを待ってな。勝負に負けてもいいんならな。』" voices=""/>
		<msg @l="825" char_id="0" frame_id="-1" name="美帆"
		   text="『ダメですっ‥‥それだけは絶対にダメなんです‥‥‥‥。』" voices="miho12520"/>
		<msg @l="827" char_id="0" frame_id="-1" name="美帆"
		   text="『お、教えてください‥‥‥私どうすれば‥‥‥‥。』" voices="miho12530"/>
		<msg @l="829" char_id="-1" frame_id="-1" name="真島"
		   text="『それを俺が教えちゃ勝負になんねーだろーが。』" voices=""/>
		<msg @l="831" char_id="0" frame_id="-1" name="美帆"
		   text="『でも‥‥‥こんなの、私っ‥‥‥‥‥。』" voices="miho12540"/>
		<msg @l="833" char_id="-1" frame_id="-1" name="" text="私は搾りだすように声を出す。"
		   voices=""/>
		<msg @l="834" char_id="-1" frame_id="-1" name="" text="情けなかった。" voices=""/>
		<msg @l="835" char_id="-1" frame_id="-1" name="" text="悔しかった。" voices=""/>
		<msg @l="836" char_id="-1" frame_id="-1" name=""
		   text="それでも私は‥‥賭けに勝たなくちゃいけない。" voices=""/>
		<msg @l="837" char_id="-1" frame_id="-1" name=""
		   text="例えそれが、男の人に射精させる方法を尋ねるなどという、恥辱に満ちた事だとしても。" voices=""/>
		<msg @l="839" char_id="0" frame_id="-1" name="美帆"
		   text="『お願いします‥‥せめて、どうすればいいのかだけでも教えてください。』" voices="miho12550"/>
		<msg @l="841" char_id="-1" frame_id="-1" name="真島" text="『チッ‥‥仕方ねーな。』"
		   voices=""/>
		<msg @l="843" char_id="-1" frame_id="-1" name=""
		   text="そんな私に、苛立ちの表情を向けると、真島は短く舌打ちをして言葉を吐き捨てた。" voices=""/>
		<msg @l="845" char_id="-1" frame_id="-1" name="真島"
		   text="『いいか？&#32;男ってのは感触だけじゃなく聴覚でも感じるんだ。』" voices=""/>
		<msg @l="847" char_id="-1" frame_id="-1" name="真島"
		   text="『だからオマエは、俺を興奮させるようなセリフを言って挑発しな。』" voices=""/>
		<msg @l="849" char_id="0" frame_id="-1" name="美帆" text="『ちょ、挑発って‥‥‥。』"
		   voices="miho12560"/>
		<msg @l="851" char_id="-1" frame_id="-1" name="真島"
		   text="『それが出来なきゃアンタの負けになる。そんだけだ。』" voices=""/>
		<msg @l="853" char_id="-1" frame_id="-1" name="真島" text="『‥‥せいぜい、愉しませてくれよ。』"
		   voices=""/>
		<msg @l="855" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』"
		   voices="miho12570"/>
		<msg @l="857" char_id="-1" frame_id="-1" name="" text="私は懸命に「挑発」のセリフを考える。"
		   voices=""/>
		<msg @l="858" char_id="-1" frame_id="-1" name=""
		   text="けれど、当然ながら何を言えば男の人が感じるかなんてわからない。" voices=""/>
		<msg @l="860" char_id="0" frame_id="-1" name="美帆" text="『あ、あの‥‥。』"
		   voices="miho12580"/>
		<msg @l="862" char_id="-1" frame_id="-1" name="真島" text="『なんだよ、また質問か？』"
		   voices=""/>
		<msg @l="864" char_id="-1" frame_id="-1" name="真島"
		   text="『ちったあ自分の頭で考えたらどーだ？』" voices=""/>
		<msg @l="866" char_id="0" frame_id="-1" name="美帆"
		   text="『お、おち○ちん‥‥おっぱいの間に挟むと、気持ちいいんですか？』" voices="miho12590"/>
		<msg @l="868" char_id="-1" frame_id="-1" name="真島"
		   text="『‥‥へへっ、わかってきたじゃねーか。』" voices=""/>
		<msg @l="870" char_id="-1" frame_id="-1" name="真島"
		   text="『ああ、アンタのこれは結構良い感じだぜ。』" voices=""/>
		<msg @l="872" char_id="0" frame_id="-1" name="美帆"
		   text="『そ、それじゃあ‥‥‥もっと気持ちよくなって‥‥‥‥ください。』" voices="miho12600"/>
		<msg @l="874" char_id="0" frame_id="-1" name="美帆"
		   text="『私のおっぱいで‥‥おち○ちん‥‥‥‥‥気持ちよくなって。』" voices="miho12610"/>
		<msg @l="876" char_id="-1" frame_id="-1" name=""
		   text="気恥ずかしさを押し殺しながら、私は必死にエッチな言葉を言った。" voices=""/>
		<msg @l="878" char_id="-1" frame_id="-1" name="真島"
		   text="『ふーん。まあ最初にしては上出来ってとこだな。』" voices=""/>
		<msg @l="880" char_id="-1" frame_id="-1" name="真島"
		   text="『ちったあその気にさせてもらったぜ。』" voices=""/>
		<msg @l="882" char_id="-1" frame_id="-1" name=""
		   text="そう言って、真島は私の乳房の谷間に挟み込んだ肉柱をゆっくりと動かし始めた。" voices=""/>
		<msg @l="883" char_id="-1" frame_id="-1" name=""
		   text="まったく硬度のなかった肉棒も、今では僅かに硬くなり始めていた。" voices=""/>
		<msg @l="885" char_id="0" frame_id="-1" name="美帆" text="(これで‥‥いいんだ)"
		   voices="miho12620"/>
		<msg @l="887" char_id="0" frame_id="-1" name="美帆"
		   text="(え、えっちな言葉をたくさん言えば‥‥男の人は嬉しいのかな)" voices="miho12630"/>
		<msg @l="889" char_id="-1" frame_id="-1" name=""
		   text="胸と胸の間を行き来する肉棒をそっと見‥‥私は更に卑猥な言葉を言う。" voices=""/>
		<msg @l="891" char_id="0" frame_id="-1" name="美帆"
		   text="『お、おち○ちんが‥‥私のおっぱいの間をいったりきたり、してます。』" voices="miho12640"/>
		<msg @l="893" char_id="0" frame_id="-1" name="美帆"
		   text="『先っぽの部分が‥‥‥‥出たり入ったり、して‥‥‥‥‥。』" voices="miho12650"/>
		<msg @l="895" char_id="0" frame_id="-1" name="美帆" text="『なんだかすごく、エッチです‥‥‥。』"
		   voices="miho12660"/>
		<msg @l="897" char_id="-1" frame_id="-1" name="真島" text="『あんた、パイズリは初めてかい？』"
		   voices=""/>
		<msg @l="899" char_id="0" frame_id="-1" name="美帆" text="『これ‥‥ぱいずりって言うんですか？』"
		   voices="miho12670"/>
		<msg @l="901" char_id="-1" frame_id="-1" name="真島"
		   text="『そーだ。アンタの形の良い胸だったら、みんな一度はお願いしたいと思ってみてるはずだぜ。』" voices=""/>
		<msg @l="903" char_id="-1" frame_id="-1" name="真島"
		   text="『口やマ○コでやってる時とチ○ポに伝わる感じがびみょーに違って、これはこれで結構やみつきになるぜ。』" voices=""/>
		<msg @l="905" char_id="-1" frame_id="-1" name=""
		   text="真島はそう言うと、ゆっくりと腰を振って、ゆさゆさと揺れるふくらみの間で男幹をしごき上げる。" voices=""/>
		<msg @l="906" char_id="-1" frame_id="-1" name=""
		   text="徐々に硬度を増していくそれは次第に熱を帯びて鉄杭のようになり、律動のたびに強く谷間を押し広げてきた。" voices=""/>
		<msg @l="908" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』"
		   voices="miho12680"/>
		<msg @l="910" char_id="-1" frame_id="-1" name=""
		   text="私は‥‥真島の亀頭がシュッシュッと胸をかきわけるように顔を出す様を、何処か熱に浮かされたように眺めていた。" voices=""/>
		<msg @l="911" char_id="-1" frame_id="-1" name=""
		   text="例え胸であれ、犯されていることが屈辱的であるのに変わりは無い。" voices=""/>
		<msg @l="912" char_id="-1" frame_id="-1" name=""
		   text="ただ、その屈辱的な思いの裏側に‥‥今まで感じたことのない快美な衝撃で躰が熱くなってくるのを感じた。" voices=""/>
		<msg @l="914" char_id="-1" frame_id="-1" name="真島" text="『アンタ‥‥目が潤んできてるぜ。』"
		   voices=""/>
		<msg @l="916" char_id="0" frame_id="-1" name="美帆" text="『え‥‥。』"
		   voices="miho12690"/>
		<msg @l="918" char_id="-1" frame_id="-1" name="真島"
		   text="『身体がコイツを欲しがってるんだろ？&#32;でも今はダメだぜ。』" voices=""/>
		<msg @l="920" char_id="-1" frame_id="-1" name=""
		   text="私の乳房の間から、ゆっくり出ては引っ込んでいく肉杭を指差し、真島が口元を歪めた。" voices=""/>
		<msg @l="922" char_id="0" frame_id="-1" name="美帆"
		   text="『そんな‥‥私は別に欲しがってなんかいませんっ。』" voices="miho12700"/>
		<msg @l="924" char_id="-1" frame_id="-1" name="真島"
		   text="『そうかい？&#32;こんなに乳首を勃たせてんのにな？』" voices=""/>
		<msg @l="926" char_id="-1" frame_id="-1" name=""
		   text="真島の指が、胸の先にある乳首を摘み上げる。" voices=""/>
		<msg @l="928" char_id="0" frame_id="-1" name="美帆" text="『んんっ！！』"
		   voices="miho12710"/>
		<msg @l="930" char_id="-1" frame_id="-1" name="" text="自分でも驚くほど、大きな声が漏れた。"
		   voices=""/>
		<msg @l="931" char_id="-1" frame_id="-1" name=""
		   text="乳首を軽くつままれただけなのに、鋭く、それでいて甘い刺激が一瞬にして身体中を駆け巡った。" voices=""/>
		<msg @l="933" char_id="0" frame_id="-1" name="美帆"
		   text="『やあっ‥‥あっ‥‥‥‥んんっ‥‥‥‥‥。』" voices="miho12720"/>
		<msg @l="935" char_id="-1" frame_id="-1" name="真島" text="『そらっ‥‥自分に素直になんな。』"
		   voices=""/>
		<msg @l="937" char_id="-1" frame_id="-1" name="真島"
		   text="『そーすりゃ、少しは男の扱い方も覚えられるぜ。』" voices=""/>
		<msg @l="939" char_id="0" frame_id="-1" name="美帆"
		   text="『んんっ‥‥そんなの‥‥‥私、わかりませんっ‥‥‥‥‥。』" voices="miho12730"/>
		<msg @l="941" char_id="-1" frame_id="-1" name="真島"
		   text="『わかんねーならせめてアンアン喘いでな。そーすりゃちっとは早くイクかもしんねーぞ。』" voices=""/>
		<msg @l="943" char_id="-1" frame_id="-1" name=""
		   text="そうして真島は楽しげに笑うと、プルプルと震える乳房を鷲掴みにし、" voices=""/>
		<msg @l="944" char_id="-1" frame_id="-1" name=""
		   text="硬くなった肉幹をゆっくりと動かして犯していった。" voices=""/>
		<msg @l="946" char_id="0" frame_id="-1" name="美帆"
		   text="(こうしてる間にも賭けの時間は過ぎていっちゃう‥‥)" voices="miho12740"/>
		<msg @l="948" char_id="0" frame_id="-1" name="美帆" text="(でも‥‥どうすれば‥‥‥‥)"
		   voices="miho12750"/>
		<msg @l="950" char_id="-1" frame_id="-1" name="真島"
		   text="『どうした？&#32;黙ったままじゃイクどころか萎えちまうぜ。』" voices=""/>
		<msg @l="952" char_id="0" frame_id="-1" name="美帆" text="『は、はい‥‥。』"
		   voices="miho12760"/>
		<msg @l="954" char_id="0" frame_id="-1" name="美帆"
		   text="『も、もっと‥‥おち○ちんで私のおっぱいを犯してください。』" voices="miho12770"/>
		<msg @l="956" char_id="0" frame_id="-1" name="美帆"
		   text="『私のおっぱいで‥‥‥はやく、イってください‥‥‥‥。』" voices="miho12780"/>
		<msg @l="958" char_id="-1" frame_id="-1" name=""
		   text="私は‥‥震える声でそれだけを言うのが精一杯だった。" voices=""/>
		<stopbgm @l="962" fadeout="1000"/>
		<clear @l="968" class="all"/>
		<msgshow @l="971" show="true"/>
		<wait_chgmv/>
		<bg @l="975" src="bg17h1"/>
		<char @l="979" id="ookur" pos="left" src="ookuro010"/>
		<char @l="983" id="rei" pos="right" src="rei115"/>
		<bgm @l="987" src="bgm09" volume="1."/>
		<msg @l="990" char_id="-1" frame_id="-1" name="大黒" text="『と、いうわけです。』"
		   voices=""/>
		<msg @l="992" char_id="-1" frame_id="-1" name=""
		   text="美帆が「賭け」をさせられている部屋の隣、マジックミラーになっている大きな鏡の前で大黒と玲がその様子を終始見ていた。"
		   voices=""/>
		<msg @l="993" char_id="-1" frame_id="-1" name="" text="音声は届いていない。" voices=""/>
		<msg @l="994" char_id="-1" frame_id="-1" name=""
		   text="ただガラス越しに二人の様子が見えているに過ぎない。" voices=""/>
		<msg @l="996" char_id="-1" frame_id="-1" name="大黒"
		   text="『彼女も、どうしても弊社への就職を目指されているとか‥‥。』" voices=""/>
		<msg @l="998" char_id="-1" frame_id="-1" name="大黒"
		   text="『採用枠の少なさについてお話したところ、彼女もまたどんな部署でも構わないと仰りましてね。』" voices=""/>
		<msg @l="1000" char_id="-1" frame_id="-1" name="大黒"
		   text="『仕方なく、アナタと同じようにテストを受けて戴いているのです。』" voices=""/>
		<msg @l="1002" char_id="1" frame_id="-1" name="玲" text="『どうして‥‥。』" voices=""/>
		<msg @l="1004" char_id="-1" frame_id="-1" name="" text="玲は焦った。" voices=""/>
		<msg @l="1005" char_id="-1" frame_id="-1" name=""
		   text="美帆は、自分が裏切った事に対し、その仕返しとして今回の仮内定を取り消そうとしている。そのために、このような辱められるテストにも挑んでいるのではないかと‥‥。"
		   voices=""/>
		<msg @l="1006" char_id="-1" frame_id="-1" name=""
		   text="もちろん、大黒と朽木が二人を堕とし込むために仕掛けた罠とも知らずに―――。" voices=""/>
		<msg @l="1008" char_id="-1" frame_id="-1" name="大黒"
		   text="『玲さんの憤りも解りますが、企業としてはより良い人材を獲得する為の措置です。』" voices=""/>
		<msg @l="1010" char_id="-1" frame_id="-1" name="大黒" text="『何卒、ご理解ください‥‥。』"
		   voices=""/>
		<msg @l="1012" char_id="1" frame_id="-1" name="玲"
		   text="『仮に‥‥彼女がこのテストに合格したら、私はどうなるんですか！？』" voices=""/>
		<msg @l="1014" char_id="-1" frame_id="-1" name="大黒"
		   text="『その場合は、残念ですが、玲さんと弊社は関わりあえる運命ではなかったということになってしまいますね。』" voices=""/>
		<char @l="1017" id="rei" pos="right" src="rei117"/>
		<msg @l="1019" char_id="1" frame_id="-1" name="玲" text="『そんなっ！！』" voices=""/>
		<msg @l="1021" char_id="1" frame_id="-1" name="玲"
		   text="『それじゃあ、私がこれまでしてきたテストはなんだったんですか！？』" voices=""/>
		<msg @l="1023" char_id="-1" frame_id="-1" name=""
		   text="玲の脳裏には、今まで耐えてきた陵辱の数々が浮かび上がる。それはすべて、自分の夢である建築デザイナーになるため、そして、稲庭と同期入社を果たすため‥‥。"
		   voices=""/>
		<msg @l="1024" char_id="-1" frame_id="-1" name=""
		   text="すべてが崩れていく、そんな音が聞こえてきそうであった。" voices=""/>
		<msg @l="1026" char_id="-1" frame_id="-1" name="大黒"
		   text="『ふむ‥‥確かにアナタの仰る通りです。』" voices=""/>
		<msg @l="1028" char_id="-1" frame_id="-1" name="大黒"
		   text="『ですから、ここで一つチャンスをあげようかと思っているのです。』" voices=""/>
		<char @l="1031" id="rei" pos="right" src="rei115"/>
		<msg @l="1033" char_id="1" frame_id="-1" name="玲" text="『チャンス、ですか？』"
		   voices=""/>
		<msg @l="1035" char_id="-1" frame_id="-1" name="大黒"
		   text="『ええ‥‥仲根さんが真島君をイかせるよりも早くアナタが私をイかせることができれば、彼女の合格如何に関わらず採用しましょう。』"
		   voices=""/>
		<msg @l="1037" char_id="-1" frame_id="-1" name="大黒"
		   text="『もちろんこのチャンスに乗る乗らないはアナタ次第です。』" voices=""/>
		<msg @l="1039" char_id="-1" frame_id="-1" name="大黒"
		   text="『これまでの苦労を台無しにしても構わないと仰るのなら、このまま彼女の合否を見届けていれば良いでしょう。』" voices=""/>
		<msg @l="1041" char_id="1" frame_id="-1" name="玲" text="『‥‥‥‥。』" voices=""/>
		<msg @l="1043" char_id="-1" frame_id="-1" name="大黒"
		   text="『どうしますか？&#32;早くしないとテストが終わってしまいますよ。』" voices=""/>
		<char @l="1046" id="rei" pos="right" src="rei113"/>
		<msg @l="1048" char_id="1" frame_id="-1" name="玲" text="『や、やりますっ‥‥。』"
		   voices=""/>
		<msg @l="1050" char_id="1" frame_id="-1" name="玲" text="『やらせてくださいっ！』"
		   voices=""/>
		<msg @l="1052" char_id="-1" frame_id="-1" name="" text="どす黒い罠にまんまと獲物は掛かった。"
		   voices=""/>
		<msg @l="1053" char_id="-1" frame_id="-1" name=""
		   text="今の玲には、冷静な判断力など持ち合わせていなかった。" voices=""/>
		<stopbgm @l="1057" fadeout="1000"/>
		<clear @l="1063" class="all"/>
		<label @l="1066" id="event_scene29"/>
		<label @l="1070" id="chart_line36"/>
		<wait_chgmv/>
		<ev @l="1074" src="ev-029a"/>
		<description @l="1077" text="すれ違う敵対心"/>
		<bgm @l="1081" src="bgm14" volume="1."/>
		<msg @l="1083" char_id="-1" frame_id="-1" name="大黒"
		   text="『そうです‥‥隣の彼女と同じように胸だけでお願いしますよ。』" voices=""/>
		<msg @l="1085" char_id="1" frame_id="-1" name="玲" text="『は、はい‥‥‥んっ、んんっ。』"
		   voices="rei02740"/>
		<msg @l="1087" char_id="-1" frame_id="-1" name=""
		   text="玲は大黒の足元にひざまづくと、ブラジャーカップを乱暴に押し下げた。ぷるん、と二つの大きな丸みがこぼれ落ちた。そして、彼の股間で力なくぶら下がっているモノをその大きな乳房で持ち上げて緩々と挟み込んだ。"
		   voices=""/>
		<msg @l="1089" char_id="1" frame_id="-1" name="玲" text="『ど、どうですか‥‥？』"
		   voices="rei02750"/>
		<msg @l="1091" char_id="-1" frame_id="-1" name="大黒" text="『おお、なかなか良い感じですよ。』"
		   voices=""/>
		<msg @l="1093" char_id="-1" frame_id="-1" name=""
		   text="二つのメロンのような大きさのある肉房にやんわりと押し潰されていた肉杭は、みるみるうちに硬度を増して熱い鉄柱に変化していく。"
		   voices=""/>
		<msg @l="1094" char_id="-1" frame_id="-1" name=""
		   text="やがて完全に屹立した男根は、玲の胸を押し退けるように、谷間の上側から亀頭を覗かせた。" voices=""/>
		<msg @l="1096" char_id="1" frame_id="-1" name="玲" text="『あ‥‥。』"
		   voices="rei02760"/>
		<msg @l="1098" char_id="-1" frame_id="-1" name="" text="玲がごくりと喉を鳴らす。"
		   voices=""/>
		<msg @l="1099" char_id="-1" frame_id="-1" name=""
		   text="すぐ間近でひくりひくりと脈打つ生き物に圧倒されたのだろう。すでに立派な大きさに成長し、ミミズのような太い血管を浮かべていた。"
		   voices=""/>
		<msg @l="1102" char_id="-1" frame_id="-1" name="大黒"
		   text="『さて、じっくり眺めている余裕はありませんよ？』" voices=""/>
		<msg @l="1104" char_id="1" frame_id="-1" name="玲" text="『あ、はいっ‥‥。』"
		   voices="rei02770"/>
		<msg @l="1106" char_id="-1" frame_id="-1" name=""
		   text="慌てて返事をすると、玲はゆっくりと身体を上下に揺すり始めた。" voices=""/>
		<msg @l="1107" char_id="-1" frame_id="-1" name=""
		   text="実り豊か果実を思わせる乳房に挟まれた肉柱は玲が身体を揺するたびに、たわわな肉の狭間でしごき上げられる。" voices=""/>
		<msg @l="1109" char_id="1" frame_id="-1" name="玲" text="『んっ、んっ‥‥‥。』"
		   voices="rei02780"/>
		<msg @l="1111" char_id="-1" frame_id="-1" name="大黒" text="『いいですよ、その調子です。』"
		   voices=""/>
		<msg @l="1113" char_id="-1" frame_id="-1" name=""
		   text="懸命に男根をしごきたてる玲を、大黒が満足げな声で激励する。" voices=""/>
		<msg @l="1115" char_id="1" frame_id="-1" name="玲" text="『んんっ‥‥ん、ああっ‥‥‥。』"
		   voices="rei02790"/>
		<msg @l="1117" char_id="-1" frame_id="-1" name=""
		   text="ただ擦り上げられることに不足を感じたのか、乳房に伸びた大黒の指が恥ずかしそうに息づくチェリーのような乳首を弄ぶように転がし始める。"
		   voices=""/>
		<msg @l="1118" char_id="-1" frame_id="-1" name=""
		   text="玲は敏感なそこを弄ばれる感触に吐息を漏らしながらも、決して肉棒を擦りあげる動作を止めようとはしない。" voices=""/>
		<msg @l="1120" char_id="-1" frame_id="-1" name="大黒"
		   text="『このハリのある艶やかな肌‥‥‥いいですよ、最高です。』" voices=""/>
		<msg @l="1122" char_id="1" frame_id="-1" name="玲"
		   text="『あっ‥‥んんっ‥‥‥‥あ、ありがとうございますっ。』" voices="rei02800"/>
		<msg @l="1124" char_id="-1" frame_id="-1" name=""
		   text="大黒の愛撫に身体を震わせて、玲が答える。それを聞いた大黒はクリクリと乳首を捏ねまわす。玲は腰をくねくねと動かし、いやらしく身悶えする。"
		   voices=""/>
		<msg @l="1125" char_id="-1" frame_id="-1" name=""
		   text="そして、大黒の期待に応えるように自分のふくらみで強く大黒の分身を包むようにして上下の運動を更に早めていく。" voices=""/>
		<msg @l="1127" char_id="-1" frame_id="-1" name="大黒" text="『おおおっ‥‥。』"
		   voices=""/>
		<msg @l="1129" char_id="-1" frame_id="-1" name=""
		   text="しっとりと汗で濡れた玲の胸は絖白い光沢を放ち、ゆっさゆっさと音を立てる。" voices=""/>
		<msg @l="1131" char_id="-1" frame_id="-1" name="大黒"
		   text="『そのまま‥‥先端をしゃぶってください。』" voices=""/>
		<msg @l="1133" char_id="1" frame_id="-1" name="玲"
		   text="『え‥‥でも、彼女と同じように胸だけって‥‥‥。』" voices="rei02810"/>
		<msg @l="1135" char_id="-1" frame_id="-1" name="大黒"
		   text="『私からのちょっとしたサービスですよ。すべてが仲根さんと公平ではこれまで頑張ってきたアナタに申し訳ありませんからね。』"
		   voices=""/>
		<msg @l="1137" char_id="1" frame_id="-1" name="玲" text="『そ、そういうことでしたら‥‥‥。』"
		   voices="rei02820"/>
		<wait_chgmv/>
		<ev @l="1141" src="ev-029bz1"/>
		<msg @l="1143" char_id="1" frame_id="-1" name="玲" text="『ん‥‥‥ちゅぷっ。』"
		   voices="rei02830"/>
		<msg @l="1145" char_id="-1" frame_id="-1" name=""
		   text="乳房を押し上げるようにしながら身体を沈め、肉幹の先端へ舌を伸ばす。" voices=""/>
		<msg @l="1146" char_id="-1" frame_id="-1" name=""
		   text="そうして亀頭に舌先が届くと、玲はチロチロと鈴口をなぞり上げるように舐めまわす。" voices=""/>
		<msg @l="1148" char_id="-1" frame_id="-1" name="大黒"
		   text="『くっ‥‥そう、その調子でお願いしますよ。』" voices=""/>
		<msg @l="1150" char_id="1" frame_id="-1" name="玲" text="『は、はい‥‥わかりました。』"
		   voices="rei02840"/>
		<msg @l="1152" char_id="1" frame_id="-1" name="玲"
		   text="『んんっ‥‥んっ、ちゅぷ‥‥‥‥れろっ‥‥れろっ‥‥‥‥。』" voices="rei02850"/>
		<msg @l="1154" char_id="-1" frame_id="-1" name=""
		   text="再び身体を上下に揺すりながら、曲線美をもつ谷間の上側に現れた亀頭に舌先を寄せてはぴちゃぴちゃと音をたてて舐めあげる。"
		   voices=""/>
		<msg @l="1156" char_id="1" frame_id="-1" name="玲"
		   text="『ちゅろっ‥‥んっ、んふっ‥‥‥‥ちゅっ‥‥ちゅむっ‥‥‥‥。』" voices="rei02860"/>
		<msg @l="1158" char_id="-1" frame_id="-1" name=""
		   text="淫らな水音をさせながら、胸と舌先での奉仕が続く。" voices=""/>
		<msg @l="1159" char_id="-1" frame_id="-1" name=""
		   text="先端より垂れ落ちた唾液が胸の谷間をびちゃびちゃに濡らし、乳房で擦り上げる時もちゅくちゅくと水音が立っている。" voices=""/>
		<msg @l="1161" char_id="-1" frame_id="-1" name="大黒"
		   text="『もっと急がなくては、隣の彼女に負けてしまいますよ？』" voices=""/>
		<msg @l="1163" char_id="1" frame_id="-1" name="玲" text="『‥‥！！』"
		   voices="rei02870"/>
		<msg @l="1165" char_id="1" frame_id="-1" name="玲"
		   text="『んんっ‥‥んっ、んっ‥‥‥‥ちゅろっ！！』" voices="rei02880"/>
		<msg @l="1167" char_id="-1" frame_id="-1" name=""
		   text="大黒の言葉に煽られ、玲の動きが速くなる。" voices=""/>
		<msg @l="1169" char_id="-1" frame_id="-1" name="大黒"
		   text="『‥‥さて、あちらはどうなっていますかねぇ。』" voices=""/>
		<msg @l="1171" char_id="-1" frame_id="-1" name=""
		   text="そうして慌てている玲の姿を横目に‥‥大黒はマジックミラーの向こう側へと視線を送る。" voices=""/>
		<msg @l="1172" char_id="-1" frame_id="-1" name=""
		   text="美帆にパイズリをさせている真島に目配せをするように････" voices=""/>
		<clear @l="1177" class="all"/>
		<wait_chgmv/>
		<ev @l="1181" src="ev-028"/>
		<msg @l="1183" char_id="0" frame_id="-1" name="美帆" text="『んんっ‥‥。』"
		   voices="miho12790"/>
		<msg @l="1185" char_id="-1" frame_id="-1" name=""
		   text="私は額に浮かぶ汗に眉を顰めながら、彼が喜ぶ言葉を懸命に探している。" voices=""/>
		<msg @l="1186" char_id="-1" frame_id="-1" name=""
		   text="あれからもう１０分くらいは経過しただろうか‥‥。" voices=""/>
		<msg @l="1187" char_id="-1" frame_id="-1" name=""
		   text="胸の谷間を犯している彼のモノは大きくそそりたっているものの、一向に射精する気配が無い。" voices=""/>
		<msg @l="1189" char_id="-1" frame_id="-1" name="真島" text="『そらそら、もう時間が無いぜ？』"
		   voices=""/>
		<msg @l="1191" char_id="0" frame_id="-1" name="美帆"
		   text="『お、お願いです‥‥早くイってください‥‥‥。』" voices="miho12800"/>
		<msg @l="1193" char_id="-1" frame_id="-1" name="真島"
		   text="『そんな芸の無いセリフじゃいけねーな。』" voices=""/>
		<msg @l="1195" char_id="0" frame_id="-1" name="美帆"
		   text="『そんなっ‥‥‥‥えっと、えっと‥‥‥‥。』" voices="miho12810"/>
		<msg @l="1197" char_id="-1" frame_id="-1" name="真島"
		   text="『どーした？&#32;俺にザーメンぶちまけて欲しいんだろ？』" voices=""/>
		<msg @l="1199" char_id="-1" frame_id="-1" name=""
		   text="そう言って、真島がニヤリと口元をつり上げた。" voices=""/>
		<msg @l="1201" char_id="0" frame_id="-1" name="美帆" text="『あ‥‥。』"
		   voices="miho12820"/>
		<msg @l="1203" char_id="0" frame_id="-1" name="美帆"
		   text="『ザ、ザーメンを‥‥‥ぶ‥‥‥ぶちまけてください‥‥‥‥。』" voices="miho12830"/>
		<msg @l="1205" char_id="0" frame_id="-1" name="美帆"
		   text="『私に‥‥‥たくさん‥‥‥‥‥ザーメンをかけてください。』" voices="miho12840"/>
		<msg @l="1207" char_id="-1" frame_id="-1" name=""
		   text="私は彼の言葉を借りて、挑発の言葉を言った。" voices=""/>
		<msg @l="1208" char_id="-1" frame_id="-1" name="" text="先ほどからずっとそう‥‥。"
		   voices=""/>
		<msg @l="1209" char_id="-1" frame_id="-1" name=""
		   text="性的な語彙を知らない私が窮すると、真島はわざと淫靡な言葉を投げる。" voices=""/>
		<msg @l="1210" char_id="-1" frame_id="-1" name=""
		   text="まるで、これを使ってみなと‥‥いわんばかりに。" voices=""/>
		<msg @l="1212" char_id="-1" frame_id="-1" name="真島"
		   text="『いいぜぇ、アンタの口から「ザーメン」なんて言葉が聞けるなんて最高だねぇ。』" voices=""/>
		<msg @l="1214" char_id="-1" frame_id="-1" name="真島"
		   text="『その調子で、普段は口にしねーよーなエロい言葉を頼むぜ。』" voices=""/>
		<msg @l="1216" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』"
		   voices="miho12850"/>
		<msg @l="1218" char_id="-1" frame_id="-1" name=""
		   text="真島は美帆にパイズリをさせながら大黒に合図を送る。" voices=""/>
		<clear @l="1223" class="all"/>
		<wait_chgmv/>
		<ev @l="1227" src="ev-029bz1"/>
		<msg @l="1229" char_id="-1" frame_id="-1" name="大黒" text="『‥‥‥‥。』" voices=""/>
		<msg @l="1231" char_id="-1" frame_id="-1" name="大黒"
		   text="『真島君の方も順調なようですね‥‥。』" voices=""/>
		<msg @l="1233" char_id="-1" frame_id="-1" name=""
		   text="大黒は耳にハメたワイヤレスのイヤホンの位置を、指先で直しながら言った。" voices=""/>
		<msg @l="1234" char_id="-1" frame_id="-1" name=""
		   text="そのイヤホンには隣の部屋の会話がすべて流れてきている。" voices=""/>
		<msg @l="1236" char_id="1" frame_id="-1" name="玲" text="『んぅ‥‥？』"
		   voices="rei02890"/>
		<msg @l="1238" char_id="-1" frame_id="-1" name=""
		   text="大黒の呟きに気付き、玲が奉仕の手を休めて上目遣いに彼を見た。" voices=""/>
		<msg @l="1240" char_id="-1" frame_id="-1" name="大黒"
		   text="『私のことは気にせず‥‥続けてください。』" voices=""/>
		<msg @l="1242" char_id="1" frame_id="-1" name="玲" text="『‥‥はい。』"
		   voices="rei02900"/>
		<msg @l="1244" char_id="-1" frame_id="-1" name="" text="玲はゆっくりと再開した。"
		   voices=""/>
		<msg @l="1246" char_id="1" frame_id="-1" name="玲"
		   text="『んっ‥‥ちゅぷ‥‥‥‥んんっ、れろっ‥‥‥‥。』" voices="rei02910"/>
		<msg @l="1248" char_id="1" frame_id="-1" name="玲"
		   text="『んっ、んっ、んっ‥‥‥れろっ‥‥‥んっ、ちゅるるるっ。』" voices="rei02920"/>
		<msg @l="1250" char_id="-1" frame_id="-1" name=""
		   text="ふくらみを弾ませながらの奉仕と、唾液を垂らしながら舌先での奉仕を、同時に行い、グチュグチュという淫らな音を立てて大黒の欲棒に刺激を与える。"
		   voices=""/>
		<msg @l="1252" char_id="-1" frame_id="-1" name="大黒"
		   text="『ああっ‥‥先端をもっと吸ってください。』" voices=""/>
		<msg @l="1254" char_id="1" frame_id="-1" name="玲"
		   text="『んっ‥‥ちゅぷ、ちゅうううううっ！！』" voices="rei02930"/>
		<msg @l="1256" char_id="-1" frame_id="-1" name=""
		   text="玲は柔らかい唇をきつく萎め、頬をへこませるほどに大黒を強く吸引した。" voices=""/>
		<msg @l="1257" char_id="-1" frame_id="-1" name="" text="彼の性を全て絞りとるような勢いだ。"
		   voices=""/>
		<msg @l="1259" char_id="-1" frame_id="-1" name="大黒" text="『お、おおっ‥‥いきますよっ！！』"
		   voices=""/>
		<flash @l="1263" count="4" fade="100" image="white"/>
		<wait_chgmv/>
		<ev @l="1267" src="ev-029ax1z1"/>
		<msg @l="1269" char_id="1" frame_id="-1" name="玲" text="『んはっっ！？』"
		   voices="rei02940"/>
		<msg @l="1271" char_id="-1" frame_id="-1" name=""
		   text="先端の鈴口から白い汚液を吸い出そうと啜っていた、玲の口元で勢いよくペニスがひときわ大きくなり、玲は反射的に顔を離した。"
		   voices=""/>
		<msg @l="1272" char_id="-1" frame_id="-1" name=""
		   text="顔を背けた瞬間、大量の熱いトロミが、玲の口元といわず胸といわず‥‥汚していく。" voices=""/>
		<msg @l="1274" char_id="1" frame_id="-1" name="玲"
		   text="『はぁ‥‥はぁ‥‥‥‥み、美帆は‥‥？』" voices="rei02950"/>
		<msg @l="1276" char_id="-1" frame_id="-1" name="大黒"
		   text="『さぁ、どうなっていますかな･･････。』" voices=""/>
		<clear @l="1281" class="all"/>
		<msg @l="1282" char_id="-1" frame_id="-1" name=""
		   text="その頃美帆はまだ真島をイカすことが出来ずにいた。" voices=""/>
		<wait_chgmv/>
		<ev @l="1286" src="ev-028"/>
		<msg @l="1288" char_id="-1" frame_id="-1" name=""
		   text="自信に満ちた言葉の通り、真島はいつまでも平然とした顔で私の胸を犯し続けている。" voices=""/>
		<msg @l="1289" char_id="-1" frame_id="-1" name=""
		   text="５分が過ぎ、１０分が過ぎ‥‥私の焦りは次第に大きく膨らんでいった。" voices=""/>
		<msg @l="1291" char_id="-1" frame_id="-1" name="真島"
		   text="『どーした、残り時間が少ないぜ、もうギブアップか？』" voices=""/>
		<msg @l="1293" char_id="0" frame_id="-1" name="美帆"
		   text="『お、お願いします‥‥精液、出してください。』" voices="miho12860"/>
		<msg @l="1295" char_id="0" frame_id="-1" name="美帆"
		   text="『おち○ちんの先から出る、いやらしい精液を私にかけてくださいっ！』" voices="miho12870"/>
		<msg @l="1297" char_id="-1" frame_id="-1" name=""
		   text="真島の興奮を煽るため、私は知りうるかぎりのいやらしい単語を並べ立てていた。" voices=""/>
		<msg @l="1299" char_id="-1" frame_id="-1" name="真島"
		   text="『いいぜぇっ‥‥もうすぐ、もうすぐ出そうだっ！』" voices=""/>
		<msg @l="1301" char_id="-1" frame_id="-1" name=""
		   text="ようやく‥‥真島が腰を震わせて限界の到来を告げる。" voices=""/>
		<msg @l="1302" char_id="-1" frame_id="-1" name=""
		   text="胸を鷲掴みに寄せている彼の手にも自然と力が入り、谷間を押し広げている肉幹もそれまで以上に硬く大きくなった。" voices=""/>
		<msg @l="1304" char_id="0" frame_id="-1" name="美帆" text="『お願い、早く出してくださいっ！！』"
		   voices="miho12880"/>
		<msg @l="1306" char_id="0" frame_id="-1" name="美帆"
		   text="『ザーメン‥‥ザーメンいっぱい、かけてくださいっ！！』" voices="miho12890"/>
		<msg @l="1308" char_id="-1" frame_id="-1" name=""
		   text="最後とばかりに、私はすすんでエッチな言葉を言う。" voices=""/>
		<msg @l="1309" char_id="-1" frame_id="-1" name="" text="もう‥‥羞恥心も何もなかった。"
		   voices=""/>
		<msg @l="1311" char_id="-1" frame_id="-1" name="真島"
		   text="『よーし、そんなに欲しけりゃくれてやるっ！！』" voices=""/>
		<flash @l="1315" count="4" fade="100" image="white"/>
		<wait_chgmv/>
		<ev @l="1319" src="ev-028x1z1"/>
		<msg @l="1321" char_id="0" frame_id="-1" name="美帆" text="『んんっ！！』"
		   voices="miho12900"/>
		<msg @l="1323" char_id="-1" frame_id="-1" name=""
		   text="胸の谷間で獰猛なペニスがビクンと大きく跳ね上がり、その口から吐き出されるように大量の白濁液を私の顔にめがけて噴射した。"
		   voices=""/>
		<msg @l="1324" char_id="-1" frame_id="-1" name=""
		   text="熱い液体が頬や額やまつげにまでねっとりと絡みつき‥‥零れ落ちた欲望のツユは床の上で水たまりができる程だった。" voices=""/>
		<clear @l="1333" class="all"/>
		<msg @l="1334" char_id="-1" frame_id="-1" name=""
		   text="玲は美帆の様子を確認すると、ホッとしたように言う。" voices=""/>
		<msg @l="1336" char_id="1" frame_id="-1" name="玲" text="『やった、私の方が早く――――。』"
		   voices="rei02960"/>
		<msg @l="1338" char_id="-1" frame_id="-1" name="大黒" text="『‥‥もう一度、お願いしますよ。』"
		   voices=""/>
		<msg @l="1340" char_id="1" frame_id="-1" name="玲" text="『えっ‥‥‥んむっっ！？』"
		   voices="rei02970"/>
		<wait_chgmv/>
		<ev @l="1344" src="ev-029ax1z1"/>
		<msg @l="1349" char_id="-1" frame_id="-1" name=""
		   text="隣の部屋の様子を伺っていた大黒が、不意に玲の頭を押さえつけて再び怒張の先端を美しい唇からわって口内に押し込んだ。" voices=""/>
		<msg @l="1350" char_id="-1" frame_id="-1" name=""
		   text="そうして‥‥戸惑っている玲に構う事無くみずから腰を動かしはじめる。" voices=""/>
		<msg @l="1352" char_id="1" frame_id="-1" name="玲" text="『ん、んぷっ‥‥。』"
		   voices="rei02980"/>
		<msg @l="1354" char_id="-1" frame_id="-1" name=""
		   text="ぬぷぬぷと肉槍は玲の口を犯し、喉の奥まで到達する。玲は喉奥の苦しさから嗚咽を洩らす。" voices=""/>
		<msg @l="1355" char_id="-1" frame_id="-1" name=""
		   text="顎が外れるような痛を感じ、上気した意識が朦朧としていく。" voices=""/>
		<msg @l="1357" char_id="1" frame_id="-1" name="玲" text="『ん、んぷっ‥‥。』"
		   voices="rei02980"/>
		<msg @l="1359" char_id="-1" frame_id="-1" name=""
		   text="大黒はまるで蜜壺に突きこむように玲の口を自身の獣で蹂躙した。" voices=""/>
		<msg @l="1360" char_id="-1" frame_id="-1" name=""
		   text="玲も次第に自分の口が秘裂になったような気がして、躰がジンと熱くなるのを感じていた。" voices=""/>
		<msg @l="1362" char_id="-1" frame_id="-1" name="大黒"
		   text="『んんっ‥‥く、いきますよっ！これはあなたがプライドを捨ててまで勝ったお祝いのザーメンです！』" voices=""/>
		<msg @l="1364" char_id="-1" frame_id="-1" name="大黒" text="『たっぷりとかぶってください！』"
		   voices=""/>
		<flash @l="1368" count="4" fade="100" image="white"/>
		<wait_chgmv/>
		<ev @l="1372" src="ev-029ax1z1z2"/>
		<msg @l="1374" char_id="-1" frame_id="-1" name=""
		   text="玲の口から肉槍を引き抜くと、矛先から猛烈な勢いで煮えたぎった粘液が発射される。" voices=""/>
		<msg @l="1375" char_id="-1" frame_id="-1" name=""
		   text="二度目とは思えないほど大量の濁液が無防備な玲の額と髪を汚していく。美しい頬も絹のような髪も白い欲望に汚された。" voices=""/>
		<msg @l="1377" char_id="1" frame_id="-1" name="玲" text="『んんっ‥‥。』"
		   voices="rei02990"/>
		<msg @l="1379" char_id="-1" frame_id="-1" name="大黒"
		   text="『いやいや、素晴らしい勝利でしたよ‥‥玲さん。』" voices=""/>
		<msg @l="1381" char_id="-1" frame_id="-1" name="大黒"
		   text="『しかも勝利のザーメンかけまでしてもらって良かったですね。』" voices=""/>
		<msg @l="1383" char_id="1" frame_id="-1" name="玲" text="『んっ‥‥あぁ‥‥‥‥。』"
		   voices="rei02320"/>
		<msg @l="1385" char_id="-1" frame_id="-1" name="大黒"
		   text="『ふふふっ、これでやっとアナタを弊社の立派な社員として迎え入れられます。』" voices=""/>
		<msg @l="1387" char_id="-1" frame_id="-1" name=""
		   text="大量の精液に塗れ、戸惑っている玲に大黒はそう言って‥‥ニタリと笑った。" voices=""/>
		<msg @l="1388" char_id="-1" frame_id="-1" name=""
		   text="その笑みは普段の人懐っこいものとは違い、とても邪悪なモノに映った。" voices=""/>
		<stopbgm @l="1392" fadeout="1000"/>
		<clear @l="1398" class="all"/>
		<end_scene @l="1401"/>
		<msgshow @l="1404" show="true"/>
		<wait_chgmv/>
		<bg @l="1408" src="bg17"/>
		<bgm @l="1412" src="bgm15" volume="1."/>
		<msg @l="1414" char_id="0" frame_id="-1" name="美帆" text="『じ、時間はっ‥‥。』"
		   voices=""/>
		<msg @l="1416" char_id="-1" frame_id="-1" name=""
		   text="真島の放った精液もそのままに、私は時間を確認すべく立ち上がる。" voices=""/>
		<se @l="1420" buf="1" src="時計のアラーム" volume="1."/>
		<msg @l="1422" char_id="-1" frame_id="-1" name=""
		   text="その瞬間‥‥真島の腕時計のアラームがけたたましく鳴り始めた。" voices=""/>
		<msg @l="1424" char_id="-1" frame_id="-1" name="真島" text="『これで１５分、と。』"
		   voices=""/>
		<msg @l="1426" char_id="-1" frame_id="-1" name="真島"
		   text="『よかったな‥‥賭けはアンタの勝ちだ。』" voices=""/>
		<stopse @l="1429" buf="1"/>
		<msg @l="1431" char_id="0" frame_id="-1" name="美帆" text="『そ、それじゃあっ。』"
		   voices=""/>
		<msg @l="1433" char_id="-1" frame_id="-1" name="真島"
		   text="『アンタの玲さんに会わせてやるよ。』" voices=""/>
		<msg @l="1435" char_id="-1" frame_id="-1" name="真島"
		   text="『その先は‥‥自分で確かめるこった。』" voices=""/>
		<msg @l="1437" char_id="0" frame_id="-1" name="美帆"
		   text="『玲さんは‥‥玲さんは何処にいるんですかっ！？』" voices=""/>
		<msg @l="1439" char_id="-1" frame_id="-1" name="大黒" text="『彼女ならここにいますよ。』"
		   voices=""/>
		<msg @l="1441" char_id="0" frame_id="-1" name="美帆" text="『え‥‥。』" voices=""/>
		<char @l="1445" id="ookur" pos="left" src="ookuro010"/>
		<char @l="1449" id="rei" pos="right" src="rei185"/>
		<msg @l="1451" char_id="-1" frame_id="-1" name=""
		   text="声のした方へ振り返ると‥‥確かに玲がそこにいた。" voices=""/>
		<msg @l="1452" char_id="-1" frame_id="-1" name=""
		   text="ほんの一日しか会っていないだけなのに、妙に懐かしい。" voices=""/>
		<msg @l="1454" char_id="1" frame_id="-1" name="玲" text="『美帆‥‥。』" voices=""/>
		<msg @l="1456" char_id="0" frame_id="-1" name="美帆" text="『れ、玲さんっ‥‥！！』"
		   voices=""/>
		<msg @l="1458" char_id="-1" frame_id="-1" name=""
		   text="私はそのまま玲さんの元へ駆け寄ろうとする。" voices=""/>
		<msg @l="1459" char_id="-1" frame_id="-1" name="" text="けれど‥‥。" voices=""/>
		<char @l="1463" id="rei" pos="right" src="rei187"/>
		<msg @l="1465" char_id="1" frame_id="-1" name="玲" text="『来ないでっ！！』" voices=""/>
		<char @l="1468" id="miho" pos="left" src="miho005"/>
		<msg @l="1470" char_id="0" frame_id="-1" name="美帆" text="『え‥‥れ、玲さん？』"
		   voices=""/>
		<msg @l="1472" char_id="1" frame_id="-1" name="玲"
		   text="『どうして‥‥私の夢を壊そうとするの！』" voices=""/>
		<msg @l="1474" char_id="1" frame_id="-1" name="玲"
		   text="『確かに私は‥‥私はあなたにひどいことをした。』" voices=""/>
		<msg @l="1476" char_id="1" frame_id="-1" name="玲"
		   text="『でも‥‥それは、最初にあなたが‥‥あなたが私の全てを壊そうとしたからよ！！』" voices=""/>
		<msg @l="1478" char_id="0" frame_id="-1" name="美帆" text="『玲さん‥‥何を言って‥‥‥‥？』"
		   voices=""/>
		<msg @l="1480" char_id="0" frame_id="-1" name="美帆"
		   text="『私、玲さんを助けたくて‥‥ここまで‥‥。』" voices=""/>
		<char @l="1484" id="rei" pos="right" src="rei184"/>
		<msg @l="1486" char_id="1" frame_id="-1" name="玲"
		   text="『えっ‥‥！？美帆、貴方この会社を受けに来てたんじゃ‥‥‥‥？』" voices=""/>
		<msg @l="1488" char_id="0" frame_id="-1" name="美帆"
		   text="『な、なにを言っているんですか、玲さん。私、玲さんを助けたいならと言われて、ここまで‥‥‥‥。』" voices=""/>
		<msg @l="1490" char_id="1" frame_id="-1" name="玲"
		   text="『じゃ、じゃぁ‥‥‥‥まさか、さっきのも‥‥‥‥。』" voices=""/>
		<char @l="1493" id="rei" pos="right" src="rei185"/>
		<msg @l="1495" char_id="-1" frame_id="-1" name="大黒"
		   text="『まあまあ、二人ともその辺で止しなさい。』" voices=""/>
		<msg @l="1497" char_id="-1" frame_id="-1" name="大黒"
		   text="『ここまで来てしまったんですから、どうにもなりませんよ？』" voices=""/>
		<msg @l="1499" char_id="-1" frame_id="-1" name="真島"
		   text="『そーいうこと。なんせアンタら二人にはこれから末ながーく、働いてもらわなくちゃならねーんだからな。』" voices=""/>
		<msg @l="1501" char_id="1" frame_id="-1" name="玲" text="『二人‥‥って？』" voices=""/>
		<msg @l="1503" char_id="-1" frame_id="-1" name="大黒"
		   text="『ああ、玲さんにもまだ言ってませんでしたね。』" voices=""/>
		<msg @l="1505" char_id="-1" frame_id="-1" name="大黒"
		   text="『実はこの会社の男性社員と現場作業員を合わせると４００人を超えましてね。丁度掃除係の女の子が少なくて困っていたので、お二人とも採用しようと思ったんですよ。』"
		   voices=""/>
		<char @l="1509" id="rei" pos="right" src="rei187"/>
		<msg @l="1511" char_id="1" frame_id="-1" name="玲"
		   text="『それじゃぁ、最初から私と美帆の両方を陥れようとしていたってことですか！！』" voices=""/>
		<msg @l="1513" char_id="-1" frame_id="-1" name="大黒"
		   text="『それはちがいますねー。私共は何一つしていませんよ。最初に就職したいと言ってきたのは貴方でしょう？』" voices=""/>
		<msg @l="1515" char_id="-1" frame_id="-1" name="大黒"
		   text="『つまり貴方は自ら“犯されたい”と言ってここに来たようなものなのですよ。』" voices=""/>
		<msg @l="1517" char_id="1" frame_id="-1" name="玲"
		   text="『なっ！わ、私は理想とする会社で理想とする仕事をしたくて、この会社を受けにきたんですっ！！』" voices=""/>
		<msg @l="1519" char_id="-1" frame_id="-1" name="大黒"
		   text="『じゃぁ、貴方は我が社の研究が足りなかったということですねー。入社するということがどういうことか分からなかったのですから‥‥‥‥。』"
		   voices=""/>
		<char @l="1522" id="rei" pos="right" src="rei185"/>
		<msg @l="1524" char_id="1" frame_id="-1" name="玲" text="『くっ‥‥‥‥‥‥。』"
		   voices=""/>
		<msg @l="1526" char_id="-1" frame_id="-1" name="大黒"
		   text="『ああ、もう一つ言わせてもらえば‥‥‥‥仲根さんは、貴方が陥れたのですよ。』" voices=""/>
		<char @l="1529" id="rei" pos="right" src="rei184"/>
		<msg @l="1531" char_id="1" frame_id="-1" name="玲" text="『なっ！』" voices=""/>
		<char @l="1534" id="miho" pos="left" src="miho104"/>
		<msg @l="1536" char_id="0" frame_id="-1" name="美帆" text="『えっ！？』" voices=""/>
		<msg @l="1538" char_id="-1" frame_id="-1" name="大黒"
		   text="『私が知らないと思っていたのですか？全ては朽木教授から聞いていますよ‥‥‥‥。』" voices=""/>
		<msg @l="1540" char_id="0" frame_id="-1" name="美帆" text="『ど、どういう事ですか！？』"
		   voices=""/>
		<char @l="1543" id="rei" pos="right" src="rei185"/>
		<msg @l="1545" char_id="1" frame_id="-1" name="玲" text="『いやっ、言わないでっ！』"
		   voices=""/>
		<msg @l="1547" char_id="-1" frame_id="-1" name="大黒"
		   text="『ふふふ‥‥‥‥、玲さん貴方は、仲根さんを慰み者にすることを条件に、弊社の内定を得ようとした。』" voices=""/>
		<msg @l="1549" char_id="-1" frame_id="-1" name="大黒"
		   text="『自分の安い夢を叶えるが為に、かわいい後輩を朽木教授に差し出した‥‥‥‥「犯してください」とね‥‥‥‥。』" voices=""/>
		<msg @l="1551" char_id="0" frame_id="-1" name="美帆" text="『えっ！？』" voices=""/>
		<msg @l="1553" char_id="0" frame_id="-1" name="美帆" text="『ま、まさか‥‥‥‥。』"
		   voices=""/>
		<msg @l="1555" char_id="0" frame_id="-1" name="美帆"
		   text="『そんな事嘘です！う、嘘ですよね‥‥‥‥玲さん‥‥‥‥？』" voices=""/>
		<msg @l="1557" char_id="1" frame_id="-1" name="玲" text="『‥‥‥‥‥‥‥‥‥‥‥‥‥‥。』"
		   voices=""/>
		<char @l="1560" id="miho" pos="left" src="miho105"/>
		<msg @l="1562" char_id="0" frame_id="-1" name="美帆" text="『れ、玲さん‥‥‥‥‥‥‥？』"
		   voices=""/>
		<msg @l="1564" char_id="-1" frame_id="-1" name="大黒" text="『ふふふ‥‥‥‥‥‥。』"
		   voices=""/>
		<msg @l="1566" char_id="-1" frame_id="-1" name="大黒"
		   text="『仲根さんは、気の毒ですねー、あなたの慕っている聡明な彼女がまさか、裏で手を引いていたなんて。』" voices=""/>
		<msg @l="1568" char_id="-1" frame_id="1" name="大黒"
		   text="（まぁ、そうなったのも私が仕掛けた罠のせいなんですけどね････しかし玲さんは自分のせいだと思っている。）" voices=""/>
		<msg @l="1570" char_id="-1" frame_id="1" name="大黒"
		   text="（いい気味ですよ････玲さん。貴女のような全てを持っている女性が、全てを失っていく様を見るのは････）" voices=""/>
		<msg @l="1572" char_id="-1" frame_id="1" name="大黒"
		   text="（全ては貴方が悪いのですよ････貴方がね････）" voices=""/>
		<msg @l="1574" char_id="-1" frame_id="-1" name="大黒"
		   text="『しかも折角、その彼女を助けにきたのに、一緒に犯されてしまうなんて。』" voices=""/>
		<msg @l="1576" char_id="1" frame_id="-1" name="玲" text="『うぅ‥‥‥‥うぅぅぅ‥‥‥‥。』"
		   voices=""/>
		<msg @l="1578" char_id="1" frame_id="-1" name="玲" text="『ごめん‥‥‥なさい‥‥‥。』"
		   voices=""/>
		<msg @l="1580" char_id="1" frame_id="-1" name="玲"
		   text="『ごめんね‥‥‥‥‥‥美帆‥‥‥‥‥‥。』" voices=""/>
		<msg @l="1582" char_id="1" frame_id="-1" name="玲"
		   text="『私が‥‥‥‥私が馬鹿だったから‥‥貴方を‥‥‥‥こんな目にあわせて‥‥‥‥しまうなんて‥‥‥‥。』" voices=""/>
		<msg @l="1584" char_id="0" frame_id="-1" name="美帆" text="『れ、玲さん‥‥‥‥‥‥。』"
		   voices=""/>
		<msg @l="1586" char_id="-1" frame_id="-1" name="大黒"
		   text="『さぁ、誤解が解けての、感動の対面はここまでですよ。』" voices=""/>
		<msg @l="1588" char_id="-1" frame_id="-1" name="大黒"
		   text="『真島君、二人を調教部屋に連れて行ってください。』" voices=""/>
		<char @l="1592" id="miho" pos="left" src="miho104"/>
		<msg @l="1594" char_id="0" frame_id="-1" name="美帆" text="『調教部屋って‥‥‥。』"
		   voices=""/>
		<msg @l="1596" char_id="-1" frame_id="-1" name="真島"
		   text="『ああ、便所の事だよ。特別製のな。お前ら掃除係になるんだから、男全員の精液をその身体全部で吸い取ってやるんだよ。』"
		   voices=""/>
		<msg @l="1598" char_id="1" frame_id="-1" name="玲"
		   text="『お、お願い！美帆だけは帰してあげて下さい‥‥‥‥。』" voices=""/>
		<msg @l="1600" char_id="1" frame_id="-1" name="玲"
		   text="『私はどうなってもかまいませんから‥‥‥‥。』" voices=""/>
		<msg @l="1602" char_id="-1" frame_id="-1" name="真島"
		   text="『駄目だね。お前達二人とも、この会社のために精液まみれになって、ぼろぼろになるまで、しっかりと働いてもらうからな。』"
		   voices=""/>
		<char @l="1606" id="rei" pos="right" src="rei185"/>
		<msg @l="1608" char_id="1" frame_id="-1" name="玲" text="『なっ‥‥。』" voices=""/>
		<char @l="1612" id="miho" pos="left" src="miho105"/>
		<msg @l="1614" char_id="0" frame_id="-1" name="美帆" text="『玲さん‥‥。』" voices=""/>
		<msg @l="1616" char_id="-1" frame_id="-1" name="真島"
		   text="『そうだなー、お前達みたいに元気のいいやつは、臭ーい“チ○ポ”の、濃い精液が溜まりまくっている現場のおやじ達の性欲処理係をやってもらうか！』"
		   voices=""/>
		<msg @l="1618" char_id="-1" frame_id="-1" name="真島"
		   text="『おやじ達のは、すっげーくせーからな！丁寧にマ○コと口を使って綺麗にしてやれよ！！』" voices=""/>
		<msg @l="1620" char_id="-1" frame_id="-1" name="真島"
		   text="『はっはっはっ、は―――っはっはっはっはっはっ！！！』" voices=""/>
		<char @l="1624" id="rei" pos="right" src="rei185"/>
		<char @l="1627" id="miho" pos="left" src="miho105"/>
		<msg @l="1629" char_id="1" frame_id="-1" name="玲" text="『うぅぅぅぅ‥‥‥‥。』"
		   voices=""/>
		<msg @l="1631" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="1633" char_id="-1" frame_id="-1" name=""
		   text="私と玲さんは、思わず顔を見合わせる‥‥。" voices=""/>
		<msg @l="1634" char_id="-1" frame_id="-1" name=""
		   text="けれど‥‥玲さんはすぐに顔を背け、目をそらしてしまった。" voices=""/>
		<msg @l="1635" char_id="-1" frame_id="-1" name="" text="この町は狂ってる。" voices=""/>
		<msg @l="1636" char_id="-1" frame_id="-1" name="" text="この町が‥‥私たちを狂わせている。"
		   voices=""/>
		<msg @l="1637" char_id="-1" frame_id="-1" name="" text="それに、もっと早く気付いていれば‥‥。"
		   voices=""/>
		<msg @l="1638" char_id="-1" frame_id="-1" name="" text="しかしもう‥‥‥‥遅かった‥‥‥‥。"
		   voices=""/>
		<stopbgm @l="1642" fadeout="1000"/>
		<clear @l="1648" class="all"/>
		<msgshow @l="1650" show="true"/>
		<wait_chgmv/>
		<bg @l="1654" src="bg17a"/>
		<bgm @l="1658" src="bgm03" volume="1."/>
		<msg @l="1660" char_id="-1" frame_id="-1" name="" text="―――三日後。" voices=""/>
		<msg @l="1661" char_id="-1" frame_id="-1" name=""
		   text="人材派遣部のオフィスはいつも通りの時間が続いていた。" voices=""/>
		<msg @l="1662" char_id="-1" frame_id="-1" name="" text="けれど、そこの主である真島の姿は無い。"
		   voices=""/>
		<msg @l="1663" char_id="-1" frame_id="-1" name=""
		   text="彼は今‥‥特別製のトイレにいた‥‥私達を調教する為に‥‥。" voices=""/>
		<clear @l="1669" class="all"/>
		<label @l="1672" id="event_scene56"/>
		<msg @l="1674" char_id="-1" frame_id="-1" name="真島"
		   text="『そら、終わったヤツはさっさとどけよっ！』" voices=""/>
		<msg @l="1676" char_id="-1" frame_id="-1" name=""
		   text="広大な大黒建設の敷地内にある小さな建物。" voices=""/>
		<msg @l="1677" char_id="-1" frame_id="-1" name=""
		   text="それは通称「作業員専用便所」と呼ばれる、作業現場の人達への肉体的ボーナスを支払う性欲処理便所だった。" voices=""/>
		<msg @l="1678" char_id="-1" frame_id="-1" name=""
		   text="その「便所」で、いま二匹のメス豚が仕事の真っ最中だった。" voices=""/>
		<label @l="1682" id="chart_line37"/>
		<wait_chgmv/>
		<ev @l="1686" src="ev-056"/>
		<description @l="1689" text="最終面接"/>
		<bgm @l="1693" src="bgm15" volume="1."/>
		<msg @l="1695" char_id="0" frame_id="-1" name="美帆" text="『んぶっ‥‥んっ、んんーーっ！』"
		   voices="miho12910"/>
		<msg @l="1697" char_id="1" frame_id="-1" name="玲"
		   text="『んんっ‥‥んぐっ‥‥‥んっ、んっ、んああっ！！』" voices="rei03000"/>
		<msg @l="1699" char_id="-1" frame_id="-1" name="" text="部屋の中に‥‥二人は吊るされていた。"
		   voices=""/>
		<msg @l="1700" char_id="-1" frame_id="-1" name=""
		   text="両腕を縄で固定され、その固定された縄の先は天井に続いている。" voices=""/>
		<msg @l="1701" char_id="-1" frame_id="-1" name=""
		   text="美帆と玲の二人を犯しているのは、みな薄汚い格好をした男ばかりで、殆どの人間が「大黒建設」と銘の打たれたツナギを着ていた。"
		   voices=""/>
		<msg @l="1702" char_id="-1" frame_id="-1" name=""
		   text="真島が作業現場からかき集めてきた、荒くれ男たちだ。" voices=""/>
		<msg @l="1703" char_id="-1" frame_id="-1" name="" text="つい先ほどまで作業をしていたのだろう。"
		   voices=""/>
		<msg @l="1704" char_id="-1" frame_id="-1" name=""
		   text="彼らは土埃や汗に塗れていて、例外なく鼻につくような男臭を放っていた。" voices=""/>
		<msg @l="1706" char_id="-1" frame_id="-1" name="真島"
		   text="『もたもたすんなっ‥‥しっかりこの男達のを奉仕するんだよ。』" voices=""/>
		<msg @l="1708" char_id="-1" frame_id="-1" name="" text="部屋の一角で真島が怒号を張り上げた。"
		   voices=""/>
		<msg @l="1709" char_id="-1" frame_id="-1" name=""
		   text="男たちは部屋の外にもまだ３０人以上いる。" voices=""/>
		<msg @l="1710" char_id="-1" frame_id="-1" name=""
		   text="短い昼休みのうちに何人の性欲を処理させられるか‥‥というのが、今日の仕事だ。" voices=""/>
		<msg @l="1712" char_id="0" frame_id="-1" name="美帆"
		   text="『んぐっ‥‥んっ、んんっ‥‥‥んはっ‥‥げほっ‥‥がはっ‥‥うっ、もういやぁ。』" voices="miho12920"/>
		<msg @l="1714" char_id="-1" frame_id="-1" name=""
		   text="口を犯していた異臭を放つ淫棒を無理やり吐き出し、美帆がすすり泣く。" voices=""/>
		<msg @l="1715" char_id="-1" frame_id="-1" name=""
		   text="鼻につく汗臭さと肉柱にこびりついた恥垢の気持ち悪さに、何度も吐きそうになり、屈辱の嗚咽を洩らした。" voices=""/>
		<msg @l="1717" char_id="-1" frame_id="-1" name="作業員Ａ"
		   text="『何だっ‥‥せかっくのボーナスなんだからよ、せめてきっちり満足させてくれなくちゃ割にあわねーぞっ！』" voices=""/>
		<msg @l="1719" char_id="0" frame_id="-1" name="美帆"
		   text="『むぐっ‥‥んぐっ‥‥‥んっ、んんんんんっ！！』" voices="miho12930"/>
		<msg @l="1721" char_id="-1" frame_id="-1" name=""
		   text="再び、美帆の愛らしい唇をわって、その口内へ恥垢まみれの汚らわしい男根が押し込まれた。" voices=""/>
		<msg @l="1722" char_id="-1" frame_id="-1" name=""
		   text="もう何日も風呂に入っていないのだろう‥‥既に幾らか唾液に溶けて流れているハズなのに、独特の異臭はいつまでたっても残ったままだ。"
		   voices=""/>
		<msg @l="1724" char_id="0" frame_id="-1" name="美帆"
		   text="『んぅっ‥‥んっ‥‥‥んぐっ‥‥‥ん、ンンっ！！』" voices="miho12940"/>
		<msg @l="1726" char_id="-1" frame_id="-1" name=""
		   text="美帆はだらしなく口をあけ、男が肉槍を突き入れるのに身を任せた。" voices=""/>
		<msg @l="1727" char_id="-1" frame_id="-1" name=""
		   text="そうして男が勝手に果てるのを‥‥期待しているのだろう。" voices=""/>
		<msg @l="1729" char_id="-1" frame_id="-1" name="真島"
		   text="『バカヤロウ！&#32;手ぇ抜かずにちゃんとしゃぶれ！！" voices=""/>
		<msg @l="1731" char_id="0" frame_id="-1" name="美帆"
		   text="『ふ、ふぁいっ‥‥‥‥んぐっ、ちゅぷっ‥‥‥うえっ‥‥‥。』" voices="miho12950"/>
		<msg @l="1733" char_id="-1" frame_id="-1" name=""
		   text="真島の一喝に怯えた表情を浮かべて、口内の屈強な肉のかたまりに舌を這わせからませる美帆。" voices=""/>
		<msg @l="1734" char_id="-1" frame_id="-1" name=""
		   text="しかし、舌先にダイレクトに感じる異臭と滑りにはどうしても慣れることができず、嘔吐感が続いた。" voices=""/>
		<msg @l="1736" char_id="-1" frame_id="-1" name="真島"
		   text="『てめーら、誰のお陰で雨風凌げる家に住んでると思ってんだ？』" voices=""/>
		<msg @l="1738" char_id="-1" frame_id="-1" name="真島"
		   text="『こういう土方作業で身体張ってる連中がいるからだろ！？』" voices=""/>
		<msg @l="1740" char_id="-1" frame_id="-1" name="作業員Ａ"
		   text="『そーだぜ。俺たち安い給料で毎日クタクタんなるまで働かされてるんだからよ。』" voices=""/>
		<msg @l="1742" char_id="-1" frame_id="-1" name="真島" text="『だ、そーだぜ。』"
		   voices=""/>
		<msg @l="1744" char_id="-1" frame_id="-1" name="真島"
		   text="『疲れた男たちを癒してやんのも、てめーらクソ豚の大事な仕事なんだから、サボらずきちっと奉仕しなっ！』" voices=""/>
		<msg @l="1746" char_id="0" frame_id="-1" name="美帆"
		   text="『うっ、ぐすっ‥‥‥んっ‥‥ちゅぷ‥‥‥ちゅ、ちゅぷぷぷっ。』" voices="miho12960"/>
		<msg @l="1748" char_id="-1" frame_id="-1" name="作業員Ａ"
		   text="『おおっ‥‥舌が絡みついてきて、蕩けそうだぁ。』" voices=""/>
		<msg @l="1750" char_id="-1" frame_id="-1" name=""
		   text="口内で動き回る小さな舌の感触に堪らなくなったのか、美帆のおちょぼ口を裂けんばかりに犯していた男が自分から激しく腰を振り始める。"
		   voices=""/>
		<msg @l="1752" char_id="0" frame_id="-1" name="美帆" text="『んむぅぅぅっ！？』"
		   voices="miho12970"/>
		<msg @l="1754" char_id="-1" frame_id="-1" name="真島"
		   text="『吐き出すな。ちゃんとリズムに会わせて唇を締めてしゃぶれ。』" voices=""/>
		<msg @l="1756" char_id="0" frame_id="-1" name="美帆"
		   text="『んんっ‥‥んぷっ、んぐっ‥‥‥んっ、んんっ。』" voices="miho12980"/>
		<msg @l="1758" char_id="-1" frame_id="-1" name=""
		   text="真島に言われるまま、美帆は唇の周りを唾液と腺液まみれにしながら口内の肉棒をグチュグチュと淫靡な音を立ててしごき上げていった。"
		   voices=""/>
		<msg @l="1759" char_id="-1" frame_id="-1" name=""
		   text="何度も吐き気がこみあげてくるが、男の腰のピストンは容赦ない。" voices=""/>
		<msg @l="1761" char_id="-1" frame_id="-1" name="作業員Ｂ"
		   text="『おー、あっちの子はえらく頑張ってンなー。』" voices=""/>
		<msg @l="1763" char_id="-1" frame_id="-1" name=""
		   text="玲の口内を犯していた男が、美帆と真島のやり取りを見て言葉を漏らした。" voices=""/>
		<msg @l="1764" char_id="-1" frame_id="-1" name=""
		   text="どうやら玲のおしゃぶりに不満があるようだ。" voices=""/>
		<msg @l="1766" char_id="-1" frame_id="-1" name="作業員Ｂ"
		   text="『こっちのねーちゃんも、もちっと気張ってもらわねーと。』" voices=""/>
		<msg @l="1768" char_id="1" frame_id="-1" name="玲" text="『ん、んんんっ！！』"
		   voices="rei03010"/>
		<msg @l="1770" char_id="-1" frame_id="-1" name=""
		   text="男は美帆がそうされているように、玲の口内奥深くまで入れようと激しく腰を振る。男はググッと喉奥へ無理やり、分身の肉塊を呑み込ませた。"
		   voices=""/>
		<msg @l="1771" char_id="-1" frame_id="-1" name=""
		   text="玲は涙目になりながら、何とかそれを受け止めてはいるが‥‥まったく舌を絡めようとしない。" voices=""/>
		<msg @l="1773" char_id="-1" frame_id="-1" name="作業員Ｂ"
		   text="『ほれ、ちゃんとしゃぶってくんねーと気持ちよくねーぞ。』" voices=""/>
		<msg @l="1775" char_id="1" frame_id="-1" name="玲"
		   text="『んはっ‥‥‥だ、誰がこんな汚いモノをっ！！』" voices="rei03020"/>
		<msg @l="1777" char_id="-1" frame_id="-1" name="作業員Ｂ" text="『なんだとぉ！！』"
		   voices=""/>
		<se @l="1781" buf="1" src="ムチの音" volume="1."/>
		<flash @l="1785" count="4" fade="100" image="white"/>
		<msg @l="1787" char_id="1" frame_id="-1" name="玲" text="『ひぐっ‥‥！！』"
		   voices="rei03030"/>
		<msg @l="1789" char_id="-1" frame_id="-1" name=""
		   text="玲に咥えさせていた作業員の男が、怒り出そうとしたその瞬間、玲の背中に向かって真島のムチが一閃した。" voices=""/>
		<msg @l="1791" char_id="-1" frame_id="-1" name="真島"
		   text="『おいブタ‥‥オマエ、まだ自分の立場がわかってねーのか？』" voices=""/>
		<msg @l="1793" char_id="1" frame_id="-1" name="玲" text="『‥‥‥‥』"
		   voices="rei03040"/>
		<msg @l="1795" char_id="-1" frame_id="-1" name="真島"
		   text="『ここにいる誰よりも、オマエたちメス豚のほーがよっぽど汚ねーんだよ。』" voices=""/>
		<msg @l="1797" char_id="-1" frame_id="-1" name="真島"
		   text="『その汚ねーオマエがしゃぶるもんは、誰の肉棒だろうと丁寧に隅々までしゃぶらなくちゃいけねーんだって‥‥しっかり教えたハズだよな！？』"
		   voices=""/>
		<se @l="1801" buf="1" src="ムチの音" volume="1."/>
		<flash @l="1805" count="4" fade="100" image="white"/>
		<msg @l="1807" char_id="1" frame_id="-1" name="玲" text="『うあﾞっ！！』"
		   voices="rei03050"/>
		<msg @l="1809" char_id="1" frame_id="-1" name="玲"
		   text="『や、やめてっ‥‥ちゃんとしゃぶるから‥‥‥‥もう打たないでっ！』" voices="rei03060"/>
		<msg @l="1811" char_id="-1" frame_id="-1" name="真島"
		   text="『馬鹿メスがぁ‥‥だったら最初からちゃんとやれっ！！』" voices=""/>
		<msg @l="1813" char_id="1" frame_id="-1" name="玲" text="『うぅ‥‥。』"
		   voices="rei03070"/>
		<msg @l="1815" char_id="-1" frame_id="-1" name="作業員Ｂ"
		   text="『んじゃ、改めてしっかりしゃぶってくれよ。』" voices=""/>
		<msg @l="1817" char_id="-1" frame_id="-1" name=""
		   text="男は己の肉杭を玲の頬に擦り付けて、悦楽の笑みを浮かべた。" voices=""/>
		<msg @l="1819" char_id="1" frame_id="-1" name="玲" text="『‥‥‥‥。』"
		   voices="rei03080"/>
		<msg @l="1821" char_id="1" frame_id="-1" name="玲"
		   text="『んぐっ‥‥‥‥んっ、ちゅぷ、ちゅ‥‥‥んぷっ、ちゅぷぷっ。』" voices="rei03090"/>
		<msg @l="1823" char_id="-1" frame_id="-1" name=""
		   text="仕方なく、という表情で玲が作業員の男幹を咥え込む。" voices=""/>
		<msg @l="1824" char_id="-1" frame_id="-1" name=""
		   text="やはり匂いと汚れが気になるのだろうか‥‥何度となくえづいては、男根を吐き出そうとしたが、その度に真島に睨まれて慌てて咥えなおした。"
		   voices=""/>
		<msg @l="1826" char_id="-1" frame_id="-1" name="真島"
		   text="『さーて、メス豚どもが従順になったところで‥‥オマエら盛大に犯しまくってくれやっ！』" voices=""/>
		<msg @l="1828" char_id="-1" frame_id="-1" name="作業員Ｃ"
		   text="『おおっ！&#32;まかせとけって！』" voices=""/>
		<msg @l="1830" char_id="-1" frame_id="-1" name="作業員Ｄ"
		   text="『言われなくたって、たっぷり犯ってやるぞ！』" voices=""/>
		<msg @l="1832" char_id="-1" frame_id="-1" name="作業員Ｅ"
		   text="『生の女なんて、何年ぶりかわかんねーしな！』" voices=""/>
		<msg @l="1834" char_id="-1" frame_id="-1" name=""
		   text="二人の周りを取り囲んでいる男たちが口々に言うと、貪るように身体中を犯し始めた。" voices=""/>
		<msg @l="1836" char_id="-1" frame_id="-1" name="作業員Ｃ"
		   text="『そら、ねーちゃん、もっとお○んこ締めねーとイケねーぞっ！』" voices=""/>
		<msg @l="1838" char_id="0" frame_id="-1" name="美帆"
		   text="『んぁぁっ‥‥は、はいっ‥‥‥んっ、んんっ‥‥‥あああっ。』" voices="miho12990"/>
		<msg @l="1840" char_id="-1" frame_id="-1" name=""
		   text="男に言われるまま、美帆は下腹部に力を入れて、秘穴を締め付けようとするのだが、鑢のように秘肉を掻き混ぜられる刺激が強くて上手く力が入らない。"
		   voices=""/>
		<msg @l="1842" char_id="-1" frame_id="-1" name="作業員Ｄ"
		   text="『こっちのねーちゃんは‥‥うっ、膣中が絡みついてくるぜ！』" voices=""/>
		<msg @l="1844" char_id="1" frame_id="-1" name="玲"
		   text="『んんっ‥‥やっ、そんな奥までっ‥‥‥んんっ、あっ、んくっ！！』" voices="rei03100"/>
		<msg @l="1846" char_id="-1" frame_id="-1" name=""
		   text="前と後ろからサンドイッチにされ逃げ場のない玲の蜜口は、男の強烈なピストンにより、グチュグチュと音をたてている。" voices=""/>
		<msg @l="1847" char_id="-1" frame_id="-1" name=""
		   text="男の開いた肉の傘は、玲の湧き出す蜜をかき出し、粘膜を削っていく。" voices=""/>
		<msg @l="1848" char_id="-1" frame_id="-1" name=""
		   text="玲の腰はそんな男の律動に合わせて、リズムよく、ひとりでに動いてしまい、まるで自分から子宮深くまで挿入させようとしているかのように、白いヒップを男の方に突き出すのだった。"
		   voices=""/>
		<msg @l="1850" char_id="-1" frame_id="-1" name="作業員Ｅ" text="『うっ、うううっ‥‥。』"
		   voices=""/>
		<msg @l="1852" char_id="-1" frame_id="-1" name=""
		   text="自分の番が待ちきれなくなったのか、順番待ちをしていた男が犯されている二人の姿を見ながら、自分で興奮した分身をしごき始める。"
		   voices=""/>
		<msg @l="1853" char_id="-1" frame_id="-1" name=""
		   text="よほど溜まっているのだろう、その先端からは大量の先走り汁が溢れ出してはこぼれ落ちていく。" voices=""/>
		<msg @l="1855" char_id="0" frame_id="-1" name="美帆"
		   text="『んぷっ、んっ、んっ、んっ、んむぅぅっ！！』" voices="miho13000"/>
		<msg @l="1857" char_id="1" frame_id="-1" name="玲"
		   text="『ちゅぷっ‥‥んっ、んんっ‥‥ぷあっ、あっ、んああっ！！』" voices="rei03110"/>
		<msg @l="1859" char_id="-1" frame_id="-1" name=""
		   text="秘部と口内で暴れる肉の獣に目を白黒させながら、二人はそれでもどこか喜びの混じった吐息を漏らしている。" voices=""/>
		<msg @l="1860" char_id="-1" frame_id="-1" name=""
		   text="そして、自ら舌を這わせ、下半身をみだらにくねり動かすのだった。" voices=""/>
		<msg @l="1861" char_id="-1" frame_id="-1" name=""
		   text="真島の調教のせいなのか、それとも元より二人にそうした資質があったのかはわからない。" voices=""/>
		<msg @l="1862" char_id="-1" frame_id="-1" name=""
		   text="ただ‥‥男たちの蹂躙によって、徐々にせりあがってくる愉悦の波が、彼女たちを本当の「メス」へと堕とそうとしていることだけは、紛れも無い事実だった。"
		   voices=""/>
		<msg @l="1864" char_id="0" frame_id="-1" name="美帆"
		   text="『んんっ‥‥‥らめぇ、そんなに突かれたら私っ‥‥んぅぅ！！』" voices="miho13010"/>
		<msg @l="1866" char_id="1" frame_id="-1" name="玲"
		   text="『んあっ‥‥あっ、ああっ‥‥‥も、ダメぇ‥‥‥んっ、あああっ！』" voices="rei03120"/>
		<msg @l="1868" char_id="-1" frame_id="-1" name=""
		   text="厭わしい肉棒が、美帆と玲の粘膜と摩擦を起こし、灼けつくようなうねりが、二人へ刺激を与える。もはや、淫蕩の虜となっていた。"
		   voices=""/>
		<msg @l="1870" char_id="-1" frame_id="-1" name="真島"
		   text="『メス豚どもがそろそろイクみたいだぞ。オマエらも濃いやつをたっぷりとご馳走してやれ。』" voices=""/>
		<msg @l="1872" char_id="-1" frame_id="-1" name=""
		   text="モブ&lt;作業員Ａ&gt;『よぉし‥‥出すぞぉ、俺のは濃いぞぉ‥‥本当に孕んじまうかもなーっ！！』" voices=""/>
		<msg @l="1874" char_id="-1" frame_id="-1" name="作業員Ｂ"
		   text="『口の中いっぱいにしてやるからなぁ‥‥全部ゴックンしろよぉ。』" voices=""/>
		<msg @l="1876" char_id="-1" frame_id="-1" name="作業員Ｃ"
		   text="『こっちも、子宮にぶっかけて、孕ませてやるっ！』" voices=""/>
		<msg @l="1878" char_id="-1" frame_id="-1" name="作業員Ｄ"
		   text="『おおっ‥‥い、いくぞ、いくぞっ！！』" voices=""/>
		<msg @l="1880" char_id="-1" frame_id="-1" name="作業員Ｅ" text="『お、おおおおおっ！』"
		   voices=""/>
		<msg @l="1882" char_id="0" frame_id="-1" name="美帆"
		   text="『んぷっ‥‥‥ん、ぷあっ‥‥中に‥‥ダメぇ、あんっ、赤ちゃんができちゃうーっ！』" voices="miho13020"/>
		<msg @l="1884" char_id="1" frame_id="-1" name="玲"
		   text="『んんんっ‥‥‥あんっ、きょ‥‥今日はキケン日なの‥‥あ、あかちゃんが‥‥‥い、あああああっ！！』"
		   voices="rei03130"/>
		<flash @l="1888" count="4" fade="100" image="white"/>
		<wait_chgmv/>
		<ev @l="1892" src="ev-056z1"/>
		<msg @l="1894" char_id="0" frame_id="-1" name="美帆"
		   text="『んぶぅっ‥‥‥んっ、んくっ‥‥んく、んく、んくっ‥‥‥。』" voices="miho13030"/>
		<msg @l="1896" char_id="1" frame_id="-1" name="玲"
		   text="『んんんんんっ‥‥んっ‥‥‥んぐっ‥‥‥‥んんっ‥‥‥‥んくっ。』" voices="rei03140"/>
		<msg @l="1898" char_id="-1" frame_id="-1" name=""
		   text="二人を犯していた男たちと、その周囲で自慰にふけっていた男たちが、一斉に大量の煮えたぎった欲望を撒き散らした。" voices=""/>
		<msg @l="1899" char_id="-1" frame_id="-1" name=""
		   text="顔に、口に、胸に、背中に、尻に、アソコに‥‥ありとあらゆる場所を、作業員達が溜め込んでいた熱い欲液で染められた。" voices=""/>
		<msg @l="1900" char_id="-1" frame_id="-1" name=""
		   text="発酵しているかのような濃い精液で塗りたぐられたメスたちの表情には、どこか愉悦の表情が浮かんでいた。" voices=""/>
		<msg @l="1902" char_id="-1" frame_id="-1" name="作業員Ａ"
		   text="『ふぃぃ、さて、後始末してくれや。』" voices=""/>
		<msg @l="1904" char_id="-1" frame_id="-1" name="作業員Ｂ"
		   text="『こっちも頼むぜ、ねーちゃん。』" voices=""/>
		<msg @l="1906" char_id="0" frame_id="-1" name="美帆"
		   text="『んあっ‥‥‥あむ、んっ‥‥くちゅ、ちゅぷ、ちゅぷ、ちゅぷっ。』" voices="miho13040"/>
		<msg @l="1908" char_id="1" frame_id="-1" name="玲"
		   text="『んふぅ‥‥‥んっ、ちゅううっ、ちゅうっ、ちゅぱっ‥‥‥ちゅるる。』" voices="rei03150"/>
		<msg @l="1910" char_id="-1" frame_id="-1" name=""
		   text="男たちに命じられるまま、二人は口内で放たれた大量の白濁の汚液を飲んだ後、精液とだ液まみれになり、卑猥なてかりを放つ肉柱に、再び舌を絡み付けて啜り始める。"
		   voices=""/>
		<msg @l="1911" char_id="-1" frame_id="-1" name=""
		   text="もう‥‥その瞳に嫌悪のそれは浮かんでいなかった。" voices=""/>
		<msg @l="1913" char_id="-1" frame_id="-1" name="作業員Ｆ"
		   text="『さぁ、次は俺達だ！まだ後ろが３０人もいるんだから、もたもたしてんじゃねぇよ！！』" voices=""/>
		<msg @l="1915" char_id="-1" frame_id="-1" name=""
		   text="メス豚として、烙印を押された二人の道は‥‥もう、決められていた―――。" voices=""/>
		<stopbgm @l="1919" fadeout="1000"/>
		<clear @l="1925" class="all"/>
		<end_scene @l="1928"/>
		<msgshow @l="1931" show="true"/>
		<call @l="1935" target="EventLabel_43@ending05"/>
		<return @l="1936" value="0&#13;&#10;"/>
		<return @l="1940" value=""/>
	</code>
</xscript>
