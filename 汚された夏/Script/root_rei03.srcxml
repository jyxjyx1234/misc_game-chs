<?xml version="1.0" encoding="utf-8"?>
<xscript>
	<debug editor="&quot;C:\Program&#32;Files&#32;(x86)\sakura\sakura.exe&quot;&#32;&quot;%src%&quot;&#32;-Y=%line%"
	   src="D:\シロップ\町ぐるみの罠＋汚された夏セット版\汚された夏\完成データ\汚された夏\script\text\root_rei03.txt"/>
	<code>
		<label @l="12" id="EventLabel_132"/>
		<description @l="16" text="ルームメイトの憂鬱・３日目"/>
		<eval @l="18" expr="f.numDay=9&#13;&#10;"/>
		<msgshow @l="20" show="false"/>
		<wait_chgmv/>
		<bg @l="22" src="day09" time="2000"/>
		<wait @l="24" time="500"/>
		<wait_chgmv/>
		<bg @l="26" src="black" time="2000"/>
		<msgshow @l="28" show="true"/>
		<wait_chgmv/>
		<bg @l="32" src="bg03"/>
		<bgm @l="36" src="bgm03" volume="1."/>
		<char @l="40" id="miho" pos="auto" src="miho116"/>
		<msg @l="42" char_id="0" frame_id="-1" name="美帆" text="『あの‥‥それじゃ、いってきます。』"
		   voices=""/>
		<msg @l="44" char_id="-1" frame_id="-1" name=""
		   text="朝食を終えた後、外出の準備をした私は、出る前に玲さんに挨拶をしてみる。" voices=""/>
		<char @l="48" id="rei" pos="auto" src="rei030"/>
		<msg @l="50" char_id="1" frame_id="-1" name="玲" text="『‥‥‥‥。』" voices=""/>
		<msg @l="52" char_id="-1" frame_id="-1" name="" text="けれど、やはり返事はしてもらえない。"
		   voices=""/>
		<msg @l="53" char_id="-1" frame_id="-1" name=""
		   text="気のせいなどではなく、私は確実に避けられていた。" voices=""/>
		<char @l="57" id="miho" pos="auto" src="miho115"/>
		<msg @l="59" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="61" char_id="0" frame_id="-1" name="美帆" text="『‥‥いってきます。』"
		   voices=""/>
		<clear @l="65" class="char"/>
		<msg @l="67" char_id="-1" frame_id="-1" name=""
		   text="もう一度‥‥私は自分に言い聞かせるように呟いて、家を出た。" voices=""/>
		<stopbgm @l="71" fadeout="1000"/>
		<clear @l="77" class="all"/>
		<wait_chgmv/>
		<bg @l="81" src="bg03"/>
		<bgm @l="85" src="bgm05" volume="1."/>
		<char @l="89" id="rei" pos="auto" src="rei035"/>
		<msg @l="91" char_id="1" frame_id="-1" name="玲" text="『‥‥‥‥。』" voices=""/>
		<msg @l="93" char_id="-1" frame_id="-1" name=""
		   text="美帆が家を出て行った後、玲は複雑な面持ちで玄関の方を見る。" voices=""/>
		<msg @l="94" char_id="-1" frame_id="-1" name=""
		   text="大人げない事をしているというのは、玲自身にもわかっていた。" voices=""/>
		<msg @l="95" char_id="-1" frame_id="-1" name=""
		   text="ただ‥‥どうしても普通に話をする事が出来ない。" voices=""/>
		<msg @l="97" char_id="1" frame_id="-1" name="玲" text="『どうしてなの、美帆‥‥。』"
		   voices=""/>
		<msg @l="99" char_id="1" frame_id="-1" name="玲"
		   text="『こんなに必死になってやっと辿り着いた所に‥‥どうしてあなたも。』" voices=""/>
		<msg @l="101" char_id="-1" frame_id="-1" name=""
		   text="美帆にぶつけるべき質問を‥‥玲は誰もいなくなったリビングで一人、口にした。" voices=""/>
		<msg @l="103" char_id="1" frame_id="-1" name="玲"
		   text="『人を出し抜くようなことをする娘ではないと思っていたのに‥‥‥‥あなたがわからなくなったわ‥‥美帆。』" voices=""/>
		<msg @l="105" char_id="-1" frame_id="-1" name=""
		   text="美帆に対しては、優しいお姉さんのようにありたい、玲は常々そう思っていた。" voices=""/>
		<msg @l="106" char_id="-1" frame_id="-1" name="" text="でも、もう‥‥優しくなれそうにない‥‥。"
		   voices=""/>
		<msg @l="108" char_id="1" frame_id="-1" name="玲" text="『‥‥‥‥。』" voices=""/>
		<msg @l="110" char_id="-1" frame_id="-1" name=""
		   text="冷たくなったコーヒーを喉奥へと流し込み、玲が立ち上がる。" voices=""/>
		<msg @l="111" char_id="-1" frame_id="-1" name="" text="美帆が家を出て３０分ほど経っていた。"
		   voices=""/>
		<msg @l="113" char_id="1" frame_id="-1" name="玲" text="『推薦状‥‥誰に貰えばいいのかな。』"
		   voices=""/>
		<stopbgm @l="117" fadeout="1000"/>
		<clear @l="123" class="all"/>
		<msgshow @l="125" show="true"/>
		<bgm @l="130" src="bgm07" volume="1."/>
		<msg @l="133" char_id="-1" frame_id="-1" name="指導員"
		   text="『就職活動に必要な推薦状の発行については、朽木陽大教授が一任されておりますので。』" voices=""/>
		<msg @l="135" char_id="-1" frame_id="-1" name=""
		   text="誰から貰う推薦状が一番良いのかを考えた結果、取り敢えず就職活動指導部を訪ねたのだが、先の言葉を言われてしまった。" voices=""/>
		<msg @l="137" char_id="1" frame_id="-1" name="玲"
		   text="『どうして朽木教授しか推薦状を発行できないのですか？』" voices=""/>
		<msg @l="139" char_id="1" frame_id="-1" name="玲"
		   text="『普通は、教授である方は皆発行ができると思うのですけど。』" voices=""/>
		<msg @l="141" char_id="-1" frame_id="-1" name=""
		   text="通常、推薦状は教授であれば誰でも発行できるが、教授の知名度等によって効力の差は出てきてしまう。" voices=""/>
		<msg @l="142" char_id="-1" frame_id="-1" name=""
		   text="しかし、この大学では朽木教授しか発行できないというのであった。" voices=""/>
		<msg @l="144" char_id="-1" frame_id="-1" name="指導員"
		   text="『さあ‥‥私は理由まではわかりませんので。』" voices=""/>
		<msg @l="146" char_id="1" frame_id="-1" name="玲" text="『‥‥そうですか。』" voices=""/>
		<msg @l="148" char_id="1" frame_id="-1" name="玲"
		   text="『すみません、ありがとうございました‥‥。』" voices=""/>
		<msg @l="150" char_id="-1" frame_id="-1" name="指導員" text="『いえ、それでは。』"
		   voices=""/>
		<stopbgm @l="154" fadeout="1000"/>
		<clear @l="160" class="all"/>
		<wait_chgmv/>
		<bg @l="164" src="bg09"/>
		<bgm @l="168" src="bgm03" volume="1."/>
		<char @l="172" id="rei" pos="auto" src="rei115"/>
		<msg @l="174" char_id="1" frame_id="-1" name="玲" text="『‥‥‥‥。』" voices=""/>
		<msg @l="176" char_id="-1" frame_id="-1" name="" text="―――憂鬱。" voices=""/>
		<msg @l="177" char_id="-1" frame_id="-1" name="" text="玲の表情からは明らかにそれが見て取れた。"
		   voices=""/>
		<msg @l="178" char_id="-1" frame_id="-1" name=""
		   text="無理もない‥‥よりにもよってあの朽木に推薦状を書いてもらうように頭を下げなくてはいけないのだ。" voices=""/>
		<msg @l="179" char_id="-1" frame_id="-1" name="" text="痴漢の常習犯である朽木教授に‥‥。"
		   voices=""/>
		<msg @l="181" char_id="1" frame_id="-1" name="玲" text="『‥‥考えてても仕方ない。』"
		   voices=""/>
		<msg @l="183" char_id="1" frame_id="-1" name="玲"
		   text="『とりあえず‥‥行ってみるしかないわね。』" voices=""/>
		<clear @l="189" class="all"/>
		<se @l="193" buf="1" src="ノック" volume="1."/>
		<msg @l="195" char_id="-1" frame_id="-1" name="声" text="『開いている。入ってきたまえ。』"
		   voices=""/>
		<msg @l="197" char_id="1" frame_id="-1" name="玲" text="『‥‥失礼します。』" voices=""/>
		<wait_chgmv/>
		<bg @l="201" src="bg12"/>
		<char @l="205" id="rei" pos="auto" src="rei123"/>
		<msg @l="207" char_id="1" frame_id="-1" name="玲" text="『突然すみません。』" voices=""/>
		<clear @l="210" class="char"/>
		<char @l="212" id="rei" pos="left" src="rei123"/>
		<char @l="215" id="kutsu" pos="right" src="kutsu010"/>
		<msg @l="217" char_id="-1" frame_id="-1" name="朽木" text="『おや‥‥これは、珍しい。』"
		   voices=""/>
		<msg @l="219" char_id="-1" frame_id="-1" name=""
		   text="入室してきた相手が玲だと知ると、朽木はそう言ってニタリと笑う。" voices=""/>
		<msg @l="220" char_id="-1" frame_id="-1" name=""
		   text="まるで、今日、彼女がこの場所に来ることを知っていたかのように。" voices=""/>
		<msg @l="222" char_id="1" frame_id="-1" name="玲"
		   text="『就職活動指導部へ推薦状の作成について問い合わせたら、朽木教授がご一任されていると伺いましたので。』" voices=""/>
		<msg @l="224" char_id="-1" frame_id="-1" name="朽木"
		   text="『ああ、企業に関する推薦状の発行は私が一任されている。』" voices=""/>
		<char @l="227" id="kutsu" pos="right" src="kutsu018"/>
		<char @l="229" id="rei" pos="left" src="rei125"/>
		<msg @l="232" char_id="-1" frame_id="-1" name="朽木"
		   text="『先日キミが疑問視した、独自の人脈を持っているのでね。』" voices=""/>
		<msg @l="234" char_id="-1" frame_id="-1" name="" text="朽木はヘビのような嫌な視線で玲を見る。"
		   voices=""/>
		<msg @l="235" char_id="-1" frame_id="-1" name=""
		   text="先日の件を、いまだに根に持っているようだ。" voices=""/>
		<msg @l="237" char_id="1" frame_id="-1" name="玲" text="『‥‥‥‥。』" voices=""/>
		<char @l="240" id="rei" pos="left" src="rei115"/>
		<msg @l="242" char_id="1" frame_id="-1" name="玲" text="『それで‥‥推薦状を戴きたいのですが。』"
		   voices=""/>
		<msg @l="244" char_id="-1" frame_id="-1" name="朽木"
		   text="『白石クンは、大黒グループへの就職を希望しているのだったね？』" voices=""/>
		<msg @l="246" char_id="1" frame_id="-1" name="玲" text="『‥‥はい。』" voices=""/>
		<msg @l="248" char_id="-1" frame_id="-1" name="朽木"
		   text="『そうか、あの大手の大黒グループにね‥‥。』" voices=""/>
		<msg @l="250" char_id="1" frame_id="-1" name="玲" text="『‥‥‥‥。』" voices=""/>
		<msg @l="252" char_id="1" frame_id="-1" name="玲" text="『‥‥何が言いたいのですか？』"
		   voices=""/>
		<msg @l="254" char_id="-1" frame_id="-1" name="朽木"
		   text="『なに‥‥最近は不況が続いているし、女性の就職は大変なのではないかと思ってね。』" voices=""/>
		<char @l="257" id="rei" pos="left" src="rei015"/>
		<msg @l="259" char_id="1" frame_id="-1" name="玲"
		   text="『ですから、こうして推薦状を頂きにきているのです。』" voices=""/>
		<msg @l="261" char_id="-1" frame_id="-1" name="朽木" text="『それは、そうだろう。』"
		   voices=""/>
		<msg @l="263" char_id="-1" frame_id="-1" name="朽木"
		   text="『それこそ推薦状でもなければ大企業に入るなんて夢のまた夢だ。』" voices=""/>
		<msg @l="265" char_id="1" frame_id="-1" name="玲" text="『‥‥‥‥。』" voices=""/>
		<char @l="268" id="kutsu" pos="right" src="kutsu018"/>
		<msg @l="270" char_id="-1" frame_id="-1" name="朽木"
		   text="『私の言っている意味がわからないかね？』" voices=""/>
		<msg @l="272" char_id="-1" frame_id="-1" name="朽木"
		   text="『つまり‥‥キミが大黒グループに就職できるかどうかは私次第と言っているんだよ。』" voices=""/>
		<char @l="276" id="rei" pos="left" src="rei025"/>
		<msg @l="278" char_id="1" frame_id="-1" name="玲"
		   text="『なっ‥‥それは、どういう意味ですかっ！？』" voices=""/>
		<msg @l="280" char_id="-1" frame_id="-1" name="朽木"
		   text="『君は賢くないなぁ‥‥聡明で有名な白石クンらしからぬ発言だ。』" voices=""/>
		<msg @l="282" char_id="-1" frame_id="-1" name="朽木"
		   text="『つまり、推薦状が欲しければ、私の好きなようにさせろ‥‥と言っているんだよ。』" voices=""/>
		<clear @l="286" class="char"/>
		<bgm @l="290" src="bgm15" volume="1."/>
		<char @l="294" id="rei" pos="center" src="rei014f" y="-80"/>
		<msg @l="296" char_id="1" frame_id="-1" name="玲" text="『あっ！？』" voices=""/>
		<msg @l="301" char_id="-1" frame_id="-1" name="" text="朽木が玲の腕を掴み、強く引き寄せる。"
		   voices=""/>
		<msg @l="302" char_id="-1" frame_id="-1" name=""
		   text="完全に不意を突かれた玲は抵抗する間もなく、朽木の胸元へと抱き寄せられてしまった。" voices=""/>
		<char @l="306" id="rei" pos="center" src="rei017f" y="-80"/>
		<msg @l="308" char_id="1" frame_id="-1" name="玲" text="『やだっ‥‥離してくださいっ！！』"
		   voices=""/>
		<msg @l="310" char_id="-1" frame_id="-1" name="朽木"
		   text="『どうした、推薦状が欲しいのだろう？』" voices=""/>
		<msg @l="312" char_id="-1" frame_id="-1" name="朽木"
		   text="『抵抗するのなら‥‥推薦状は無いものと思ったほうがいいな。』" voices=""/>
		<msg @l="314" char_id="1" frame_id="-1" name="玲" text="『卑怯ですっ！！』" voices=""/>
		<msg @l="316" char_id="-1" frame_id="-1" name="朽木" text="『だからどうしたのかね。』"
		   voices=""/>
		<msg @l="318" char_id="-1" frame_id="-1" name="朽木"
		   text="『推薦状がいらないなら、部屋から出て行けば良いだけなのだよ。』" voices=""/>
		<msg @l="320" char_id="-1" frame_id="-1" name="朽木" text="『選ぶ権利は君にあるのだよ。』"
		   voices=""/>
		<char @l="323" id="rei" pos="center" src="rei015f" y="-80"/>
		<msg @l="325" char_id="1" frame_id="-1" name="玲" text="『くっ‥‥アナタは外道だわ。』"
		   voices=""/>
		<msg @l="327" char_id="-1" frame_id="-1" name="朽木"
		   text="『ククク‥‥褒め言葉として受け取っておこう。』" voices=""/>
		<begin_trans @l="331" time="500"/>
		<layer @l="332" id="cutin_f" src="game_window_cutin" x="20" y="20" z="-1001"/>
		<layer @l="333" id="cutin" src="cut005b" x="32" y="32" z="-1000"/>
		<end_trans @l="334"/>
		<msg @l="336" char_id="-1" frame_id="-1" name=""
		   text="朽木はそう言うと、スカートの中に手をすべりこませ、下着の上から秘部をまさぐった。" voices=""/>
		<msg @l="337" char_id="-1" frame_id="-1" name="" text="さわっ、さわっ。" voices=""/>
		<msg @l="339" char_id="1" frame_id="-1" name="玲" text="『んんっ‥‥‥！』" voices=""/>
		<msg @l="341" char_id="-1" frame_id="-1" name=""
		   text="玲は身をよじって逃れようとする‥‥が、稲庭との同期入社の夢を考えると抵抗できない。" voices=""/>
		<msg @l="343" char_id="-1" frame_id="-1" name="朽木"
		   text="『そうそう、キミは何があっても推薦状が欲しい‥‥そうだろう？』" voices=""/>
		<msg @l="345" char_id="1" frame_id="-1" name="玲" text="『そ、それは‥‥。』" voices=""/>
		<msg @l="347" char_id="-1" frame_id="-1" name="朽木"
		   text="『なに、悪いようにはしない‥‥私の言うことに従っていれば必ず推薦状を用意しようじゃないか。』" voices=""/>
		<begin_trans @l="350" time="500"/>
		<layer @l="351" id="cutin_f" src="game_window_cutin" x="20" y="20" z="-1001"/>
		<layer @l="352" id="cutin" src="cut005a" x="32" y="32" z="-1000"/>
		<end_trans @l="353"/>
		<msg @l="355" char_id="-1" frame_id="-1" name=""
		   text="朽木は、するりとパンツの中に手を入れると、秘裂の割れ目に指を挿入してきた。" voices=""/>
		<msg @l="356" char_id="-1" frame_id="-1" name="" text="くにゅ、くにゅ、くにゅ。"
		   voices=""/>
		<msg @l="358" char_id="1" frame_id="-1" name="玲" text="『んっ‥‥‥‥！！』" voices=""/>
		<msg @l="360" char_id="-1" frame_id="-1" name="朽木"
		   text="『くく‥‥‥、そうだ、私に全てを任せなさい。』" voices=""/>
		<msg @l="362" char_id="-1" frame_id="-1" name=""
		   text="そう言いながら、肉路の天井にある微細の襞を指腹で擦り伸ばし、秘裂の上部に位置する紅色の真珠を転がし始めた。" voices=""/>
		<msg @l="364" char_id="-1" frame_id="-1" name="" text="くり、くり、くり。" voices=""/>
		<msg @l="366" char_id="1" frame_id="-1" name="玲" text="『あっ‥‥‥！』" voices=""/>
		<msg @l="368" char_id="-1" frame_id="-1" name="朽木"
		   text="『ん‥‥‥？なんだ、感じてしまったのかね。』" voices=""/>
		<msg @l="370" char_id="-1" frame_id="-1" name="朽木"
		   text="『嫌々ながらも、感じてしまうなんて、君は淫乱な女だな。』" voices=""/>
		<msg @l="372" char_id="1" frame_id="-1" name="玲" text="『そ、そんな事‥‥‥。』"
		   voices=""/>
		<msg @l="374" char_id="-1" frame_id="-1" name="朽木"
		   text="『まぁ、こんないい身体をしていたら、いくらでも男が寄ってくるだろう。男を手玉にとって、良い思いをしているんじゃないかね？』"
		   voices=""/>
		<msg @l="376" char_id="-1" frame_id="-1" name=""
		   text="朽木はにやにやと笑いながら、さらに指を秘肉にグイグイと圧迫する。" voices=""/>
		<msg @l="378" char_id="1" frame_id="-1" name="玲"
		   text="『わ‥‥‥私、そんな女じゃ‥‥‥んんっ‥‥‥！』" voices=""/>
		<msg @l="380" char_id="-1" frame_id="-1" name="朽木"
		   text="『くくく‥‥‥。では‥‥そろそろ君の味見をしてやろう。』" voices=""/>
		<msg @l="382" char_id="1" frame_id="-1" name="玲" text="『え！？』" voices=""/>
		<msg @l="384" char_id="-1" frame_id="-1" name="朽木"
		   text="『さあ、そっちの壁に手を着いて尻を向けるんだ。』" voices=""/>
		<msg @l="386" char_id="1" frame_id="-1" name="玲" text="『‥‥‥っ‥‥‥。』" voices=""/>
		<msg @l="388" char_id="-1" frame_id="-1" name="朽木"
		   text="『どうした？早くしないと推薦状を出してやらないがいいのかね？』" voices=""/>
		<msg @l="390" char_id="1" frame_id="-1" name="玲" text="『‥‥‥‥‥‥ゃ‥‥‥。』"
		   voices=""/>
		<msg @l="392" char_id="-1" frame_id="-1" name="朽木" text="『ん？』" voices=""/>
		<msg @l="394" char_id="1" frame_id="-1" name="玲" text="『やっぱり嫌です！』" voices=""/>
		<begin_trans @l="397" time="500"/>
		<clear @l="398" layer="cutin_f"/>
		<clear @l="399" layer="cutin"/>
		<end_trans @l="400"/>
		<msg @l="402" char_id="-1" frame_id="-1" name="朽木" text="『今更、何を言っているのかね。』"
		   voices=""/>
		<clear @l="405" class="char"/>
		<char @l="407" id="rei" pos="auto" src="rei015"/>
		<msg @l="409" char_id="1" frame_id="-1" name="玲"
		   text="『確かに、私は大黒グループに就職したい！でもそれは稲庭さんが好きだから、稲庭さんと一緒の会社に入りたいからです！』"
		   voices=""/>
		<msg @l="411" char_id="1" frame_id="-1" name="玲"
		   text="『でも、こんな事をして入社出来たとしても、私は稲庭さんと今までのように接することが出来なくなる。』" voices=""/>
		<msg @l="413" char_id="1" frame_id="-1" name="玲" text="『そうしたら全く意味がありません。』"
		   voices=""/>
		<msg @l="415" char_id="1" frame_id="-1" name="玲"
		   text="『だから私は、推薦状を頂かなくても結構です。それでは、失礼します！』" voices=""/>
		<msg @l="417" char_id="-1" frame_id="-1" name="朽木"
		   text="『･･････くくくく。君は予想通りの行動をするね。』" voices=""/>
		<msg @l="419" char_id="1" frame_id="-1" name="玲" text="『どういうことですか！？』"
		   voices=""/>
		<msg @l="421" char_id="-1" frame_id="-1" name="朽木"
		   text="『いやいや、君みたいに気位の高い女は、最後は必ず拒むと思っていたが、その通りにだったのでね。思わず笑ってしまっただけだよ。』"
		   voices=""/>
		<msg @l="423" char_id="1" frame_id="-1" name="玲"
		   text="『なっ！？･･････もう、どう思われようと結構ですが、とにかく私はこれで失礼致します。』" voices=""/>
		<msg @l="425" char_id="-1" frame_id="-1" name="朽木"
		   text="『まぁ、待ちたまえ白石クン。部屋から出る前にこの写真を見ていったらどうだね？』" voices=""/>
		<msg @l="427" char_id="1" frame_id="-1" name="玲" text="『･･････写真？』"
		   voices=""/>
		<clear @l="430" class="char"/>
		<char @l="432" id="rei" pos="center" src="rei015f" y="-80"/>
		<msg @l="434" char_id="1" frame_id="-1" name="玲" text="『････････････。』"
		   voices=""/>
		<msg @l="436" char_id="1" frame_id="-1" name="玲"
		   text="『こ、これは！どこでこんなものを手に入れたんですか！？』" voices=""/>
		<msg @l="438" char_id="-1" frame_id="-1" name=""
		   text="見せられた写真は、先日、大黒グループにて検査と称してセクハラ接待をさせられた時の物だった。" voices=""/>
		<msg @l="440" char_id="-1" frame_id="-1" name="朽木"
		   text="『よく撮れているだろう？ミスキャンパスにも選ばれた君がこんな事をしていたと、皆が知ったらどう思うだろうね？』" voices=""/>
		<msg @l="442" char_id="1" frame_id="-1" name="玲" text="『え！？』" voices=""/>
		<msg @l="444" char_id="-1" frame_id="-1" name="朽木"
		   text="『くくく‥‥この写真を焼き増しして、君の所属するテニスサークルにばら撒いてやろうか。そうすれば、君の大好きな稲庭くんにも見てもらえるだろう？』"
		   voices=""/>
		<msg @l="446" char_id="1" frame_id="-1" name="玲"
		   text="『そ、それだけはやめてください！そんな事をされたら私、生きて行けません！』" voices=""/>
		<msg @l="448" char_id="-1" frame_id="-1" name="朽木"
		   text="『･･････なら、分かっているね。壁に手を着いて尻を向けたまえ。』" voices=""/>
		<msg @l="450" char_id="1" frame_id="-1" name="玲" text="『そ、それは･･････。』"
		   voices=""/>
		<msg @l="452" char_id="-1" frame_id="-1" name="朽木"
		   text="『今、君が拒めば、この写真はキャンパス中にばら撒かれ、当然、稲庭くんにも知られてしまう。だが、私に抱かれれば、この写真は返して、さらに推薦状も渡そう。』"
		   voices=""/>
		<msg @l="453" char_id="-1" frame_id="-1" name="朽木"
		   text="『君にとっては良い話ずくめだと思うがね？』" voices=""/>
		<msg @l="455" char_id="-1" frame_id="-1" name=""
		   text="確かに全てを失うのであれば、今一度だけ我慢すればよいのかもしれない。が、それが嫌悪している朽木教授に抱かれるとなると当然ながら拒絶反応が出てしまう。"
		   voices=""/>
		<msg @l="457" char_id="-1" frame_id="-1" name="朽木"
		   text="『もう君が選ぶ道は一つしかないのだ。諦めたまえ。』" voices=""/>
		<msg @l="459" char_id="-1" frame_id="-1" name=""
		   text="そう言いながら、朽木は玲を壁の方に押し付けた。" voices=""/>
		<se @l="463" buf="1" src="人とぶつかる音" volume="1."/>
		<msg @l="465" char_id="-1" frame_id="-1" name="" text="ドンッ" voices=""/>
		<msg @l="467" char_id="1" frame_id="-1" name="玲" text="『きゃっ！』" voices=""/>
		<msg @l="469" char_id="-1" frame_id="-1" name=""
		   text="玲は朽木に押され、思わず壁に手をついてお尻を突き出すような格好をさせられる。" voices=""/>
		<msg @l="471" char_id="1" frame_id="-1" name="玲" text="『やっ！！』" voices=""/>
		<msg @l="473" char_id="-1" frame_id="-1" name="朽木"
		   text="『くくく‥‥もし、手を壁から離して動いたらこの写真をばら撒く。嫌ならじっとしていることだ。』" voices=""/>
		<msg @l="475" char_id="-1" frame_id="-1" name=""
		   text="その言葉に玲は身動きが取れなくなる。朽木に抱かれるなどおぞましいが、写真がばら撒かれるのはもっと嫌だ。" voices=""/>
		<clear @l="481" class="all"/>
		<msg @l="483" char_id="-1" frame_id="-1" name=""
		   text="玲が壁に手をつけたまま逆らわなくなったのを確認すると、朽木は、リクルートスーツの上から胸を掴み、ブラウスを脱がして胸をくびり出そうとする。"
		   voices=""/>
		<msg @l="485" char_id="1" frame_id="-1" name="玲" text="『いやぁっ！』" voices=""/>
		<msg @l="487" char_id="-1" frame_id="-1" name=""
		   text="玲は思わず壁から手を離して逃げようとするが、それを朽木が言葉で制した。" voices=""/>
		<msg @l="489" char_id="-1" frame_id="-1" name="朽木"
		   text="『動くなと言ったはずだがね。写真をばら撒かれたくなかったら大人しくしていることだ。』" voices=""/>
		<msg @l="491" char_id="1" frame_id="-1" name="玲" text="『ううっ！』" voices=""/>
		<msg @l="493" char_id="-1" frame_id="-1" name=""
		   text="朽木の言葉により玲の力が抜ける。すると朽木は慣れた手つきでブラウスのボタンを外し、黒いブラをずらして胸元から白い乳房をくびり出した。"
		   voices=""/>
		<msg @l="494" char_id="-1" frame_id="-1" name=""
		   text="露わにされてしまった玲の形のよい豊かな乳房は、綺麗なラインを描いていて、先端部分にはピンクのサクランボのような乳首がのっていた。"
		   voices=""/>
		<msg @l="496" char_id="1" frame_id="-1" name="玲" text="『あぁっ！』" voices=""/>
		<msg @l="498" char_id="-1" frame_id="-1" name="朽木"
		   text="『ふふっ、白石クンのオッパイはやはり大きいな。君がテニスをしている時、ウェアの下でこの大きいオッパイがプルンプルン揺れてるのを見る度、いつかこういう風に揉んでみたいと思っていたのだよ。』"
		   voices=""/>
		<msg @l="500" char_id="-1" frame_id="-1" name=""
		   text="朽木は欲望に目をギラつかせ、ムンズと掴んで揉みほぐす。" voices=""/>
		<msg @l="501" char_id="-1" frame_id="-1" name=""
		   text="そして、ツンと誇らしげに隆起する乳首を口に含んだかと思うと、赤ん坊のように強く吸いたてながら、舌先でチロチロと転がした。"
		   voices=""/>
		<msg @l="503" char_id="1" frame_id="-1" name="玲" text="『ああっ、んっ！』" voices=""/>
		<msg @l="505" char_id="-1" frame_id="-1" name="朽木"
		   text="『くくっ、なかなかの感度のようだな。』" voices=""/>
		<msg @l="507" char_id="-1" frame_id="-1" name=""
		   text="弾むような弾力を持つ乳房を揉みながら舌を転がし続けると、最初はグミのように柔らかかった乳首が、次第に充血して尖り、しっかりとみだらな芯となった。"
		   voices=""/>
		<msg @l="509" char_id="1" frame_id="-1" name="玲" text="『あうっ！』" voices=""/>
		<msg @l="511" char_id="-1" frame_id="-1" name=""
		   text="やがて胸を揉んでいる手が離れ、朽木は玲のお尻の前に回りこみ下着越しに秘裂を撫ではじめた。" voices=""/>
		<msg @l="513" char_id="1" frame_id="-1" name="玲" text="『いやっ！そこは駄目ですっ！！』"
		   voices=""/>
		<msg @l="515" char_id="-1" frame_id="-1" name=""
		   text="とっさに玲は足を閉じようとするが、逆に朽木は膝を掴んで拡げさせる。続いてタイトスカートを捲り上げ、巧みに黒いショーツを引き降ろして、股間を露わにさせた"
		   voices=""/>
		<msg @l="517" char_id="1" frame_id="-1" name="玲" text="『あっ、見ないで、見ないで下さい！！』"
		   voices=""/>
		<msg @l="519" char_id="-1" frame_id="-1" name=""
		   text="玲は恥ずかしさのあまり、目尻に涙を滲ませながら哀願する。" voices=""/>
		<msg @l="521" char_id="-1" frame_id="-1" name="朽木"
		   text="『これが、ミスキャンパスの陰部か･･････この割れ目の鮮やかなピンク色が綺麗だな。たまらん････ぷっくりと膨らんだクリト○スも上品な感じだよ。』"
		   voices=""/>
		<msg @l="523" char_id="-1" frame_id="-1" name=""
		   text="そう言うと、秘裂を割って指を差しこみ、クリト○スを触る。" voices=""/>
		<msg @l="525" char_id="1" frame_id="-1" name="玲" text="『いやぁ！そんな所、触らないでぇ！！』"
		   voices=""/>
		<msg @l="527" char_id="-1" frame_id="-1" name=""
		   text="玲は自分の性器を口に出して描写されたのと、秘部を嬲られる感触に恥ずかしさで顔を真っ赤にした。" voices=""/>
		<msg @l="529" char_id="-1" frame_id="-1" name="朽木" text="『おとなしくしないと、こうだよ。』"
		   voices=""/>
		<flash @l="532" count="4" fade="100" image="white"/>
		<se @l="535" buf="1" src="尻を叩く" volume="1."/>
		<msg @l="537" char_id="-1" frame_id="-1" name=""
		   text="突然、朽木は玲の臀部をパチンと平手打ちで叩く。" voices=""/>
		<msg @l="538" char_id="-1" frame_id="-1" name="" text="小気味いい音が教授室内に響いた。"
		   voices=""/>
		<msg @l="540" char_id="1" frame_id="-1" name="玲" text="『あっ！』" voices=""/>
		<msg @l="542" char_id="-1" frame_id="-1" name="朽木"
		   text="『ククク‥‥。外の廊下にも聞こえてしまうかもしれんよ。』" voices=""/>
		<flash @l="545" count="4" fade="100" image="white"/>
		<se @l="548" buf="1" src="尻を叩く" volume="1."/>
		<msg @l="550" char_id="-1" frame_id="-1" name=""
		   text="また、小気味いい音が響く。たしかに外に洩れてしまいそうだ。" voices=""/>
		<msg @l="552" char_id="1" frame_id="-1" name="玲" text="『や、やめてっ！おとなしくするからっ！』"
		   voices=""/>
		<msg @l="554" char_id="-1" frame_id="-1" name=""
		   text="朽木は玲がおとなしくなったのを確認すると、玲の股間に顔をうずめる。そして舌先で恥ずかしい割れ目を舐めあげ、クリトリスを吸い上げる。"
		   voices=""/>
		<msg @l="556" char_id="1" frame_id="-1" name="玲" text="『ひっ、ああっ！！』" voices=""/>
		<msg @l="558" char_id="-1" frame_id="-1" name=""
		   text="朽木は秘部に顔を押し付けると、恍惚感に浸りながら、秘められた香りを吸引した。" voices=""/>
		<msg @l="559" char_id="-1" frame_id="-1" name=""
		   text="淫欲の馥郁（ふくいく）な香りが朽木の理性を麻痺させるように、鼻腔を強く刺激した。" voices=""/>
		<msg @l="561" char_id="-1" frame_id="-1" name="朽木"
		   text="『いやらしい匂いだ。陰部の匂いがプンプンとするよ。』" voices=""/>
		<msg @l="563" char_id="-1" frame_id="-1" name=""
		   text="玲は恥辱の行為に頬から耳まで真っ赤にし、前歯で唇を噛んで堪える。" voices=""/>
		<msg @l="565" char_id="-1" frame_id="-1" name=""
		   text="朽木は舌の先に力を入れ、先を尖らし狭い蜜壺に挿入してくる。美味な酸味にピリッと舌先が麻痺した。" voices=""/>
		<msg @l="567" char_id="-1" frame_id="-1" name="朽木"
		   text="『そんなに我慢せず、快感に身を委ねて良いのだがね。どうせ犯されるのだから、白石クンも気持ちよくなったほうが良いだろう？』"
		   voices=""/>
		<msg @l="569" char_id="-1" frame_id="-1" name=""
		   text="朽木は秘裂を舌でべちょべちょにする程舐めた。しかし、蜜口からは愛液は中々染み出してこない。" voices=""/>
		<msg @l="571" char_id="1" frame_id="-1" name="玲"
		   text="『だ、誰があなたなんかの愛撫で気持ちよくなるもんですか！写真を返してもらう為に嫌々我慢しているんだから！正直気持ち悪いだけですっ！！』"
		   voices=""/>
		<msg @l="573" char_id="-1" frame_id="-1" name="朽木"
		   text="『そうか、君のことを思って言ってあげたんだがね。まぁ私は濡れていないオ○ンコに挿れるのも好きだから良いがね。』" voices=""/>
		<msg @l="575" char_id="-1" frame_id="-1" name=""
		   text="そう言って、朽木はズボンからペニスを出し、玲の秘裂に擦り付けた。" voices=""/>
		<msg @l="577" char_id="1" frame_id="-1" name="玲" text="『ひっ‥‥‥‥。』" voices=""/>
		<msg @l="579" char_id="-1" frame_id="-1" name=""
		   text="玲は秘部に触れた熱の感触に、壁に手をつけたまま振り返る。すると朽木の股間にそそり立つものが目に入り、再び恐怖心に襲われる。"
		   voices=""/>
		<msg @l="580" char_id="-1" frame_id="-1" name=""
		   text="しかし、写真をばら撒かれるのよりは‥‥とじっと耐える事にした。" voices=""/>
		<msg @l="582" char_id="-1" frame_id="-1" name="朽木"
		   text="『ふふっ、では味あわせてもらおうか。』" voices=""/>
		<msg @l="584" char_id="-1" frame_id="-1" name="" text="そして―――。" voices=""/>
		<msg @l="585" char_id="-1" frame_id="-1" name=""
		   text="朽木はまだ濡れてもいない秘裂に肉棒の先端を押し当てた。" voices=""/>
		<msg @l="587" char_id="1" frame_id="-1" name="玲" text="『ゃぁっ‥‥。』" voices=""/>
		<msg @l="589" char_id="-1" frame_id="-1" name="朽木" text="『もう、遅い。』" voices=""/>
		<msg @l="591" char_id="-1" frame_id="-1" name=""
		   text="そう言うと、朽木は逃げようとする玲の腰を掴み、肉棒を秘裂に突き刺した。" voices=""/>
		<stopbgm @l="595" fadeout="1000"/>
		<clear @l="601" class="all"/>
		<label @l="604" id="event_scene45"/>
		<msgshow @l="607" show="true"/>
		<label @l="611" id="chart_line28"/>
		<wait_chgmv/>
		<ev @l="615" src="ev-045"/>
		<description @l="618" text="望まない取り引きＡ"/>
		<bgm @l="622" src="bgm14" volume="1."/>
		<msg @l="624" char_id="1" frame_id="-1" name="玲" text="『んんっ‥‥いたっ！！』"
		   voices="rei01310"/>
		<msg @l="626" char_id="-1" frame_id="-1" name=""
		   text="挿入した瞬間、秘部が潤っていない為、玲の表情が苦痛に歪む。" voices=""/>
		<msg @l="628" char_id="1" frame_id="-1" name="玲"
		   text="『いぁっ‥‥いたっ！！もっと、ゆっくり‥‥‥‥。』" voices="rei01320"/>
		<msg @l="630" char_id="-1" frame_id="-1" name=""
		   text="秘部を駆け抜ける激痛に耐えかねるように、悔しげな表情のまま玲が懇願する。" voices=""/>
		<msg @l="632" char_id="-1" frame_id="-1" name="朽木"
		   text="『ふふっ、痛いのは濡れてないのだから当たり前だ。君が望んだことなのだからな。』" voices=""/>
		<msg @l="634" char_id="-1" frame_id="-1" name=""
		   text="朽木は邪悪な笑みを浮かべながら、潤っていない秘裂を肉の槍で抉じ開けた。" voices=""/>
		<msg @l="636" char_id="1" frame_id="-1" name="玲" text="『んあっっ！！いたっ‥‥いたいっっ』"
		   voices="rei01340"/>
		<msg @l="638" char_id="-1" frame_id="-1" name="朽木"
		   text="『でもどうしても、というならお願いの仕方があるだろう？もっとゆっくりしてください‥‥ではないのかね？』" voices=""/>
		<msg @l="640" char_id="1" frame_id="-1" name="玲" text="『‥‥‥‥。』"
		   voices="rei01330"/>
		<msg @l="642" char_id="-1" frame_id="-1" name=""
		   text="苦痛で玲の腰がまるで煽惑するようにくねり、朽木の欲望を増加させていく。" voices=""/>
		<msg @l="644" char_id="-1" frame_id="-1" name="朽木"
		   text="『私は別に構わんのだよ？&#32;このままでもな。』" voices=""/>
		<msg @l="646" char_id="-1" frame_id="-1" name=""
		   text="乾いた膣壁をペニスで擦り上げる度に、玲が悲痛な声を上げて悶える。" voices=""/>
		<msg @l="648" char_id="1" frame_id="-1" name="玲" text="『んあっっ！！いたっ‥‥いたいっっ。』"
		   voices="rei01340"/>
		<msg @l="650" char_id="-1" frame_id="-1" name="朽木"
		   text="『どうだね？&#32;この調子でかき回し続けてほしいかね？』" voices=""/>
		<msg @l="652" char_id="-1" frame_id="-1" name=""
		   text="朽木は肉棒をグイグイと突きこみ、子宮に打撃を加える。" voices=""/>
		<msg @l="654" char_id="1" frame_id="-1" name="玲"
		   text="『‥‥‥っくり‥‥して‥‥‥‥さい‥‥‥。』" voices="rei01350"/>
		<msg @l="656" char_id="-1" frame_id="-1" name="朽木"
		   text="『そんな小さな声では聞こえないのだがね？』" voices=""/>
		<msg @l="658" char_id="1" frame_id="-1" name="玲"
		   text="『くっ‥‥‥ゆっくり‥‥して‥‥‥ください‥‥‥‥。』" voices="rei01360"/>
		<msg @l="660" char_id="-1" frame_id="-1" name="朽木"
		   text="『ほう？よほど激しくして欲しいようだな。』" voices=""/>
		<msg @l="662" char_id="-1" frame_id="-1" name=""
		   text="意地悪く返すと、朽木の腰のピストン運動が早まり、猛烈な勢いで肉壁を摩擦した。玲の顔が苦痛に歪む。" voices=""/>
		<msg @l="664" char_id="1" frame_id="-1" name="玲"
		   text="『ゆ、ゆっくりしてくださいっ‥‥お願いします。』" voices="rei01370"/>
		<msg @l="666" char_id="-1" frame_id="-1" name="朽木"
		   text="『くくっ‥‥いいだろう、そうまで懇願されては仕方が無い。』" voices=""/>
		<msg @l="668" char_id="-1" frame_id="-1" name="朽木" text="『ゆっくりにしてあげよう。』"
		   voices=""/>
		<msg @l="670" char_id="-1" frame_id="-1" name=""
		   text="そう言うと、朽木は腰を引いてゆっくりとした抽送に変えた。" voices=""/>
		<msg @l="671" char_id="-1" frame_id="-1" name=""
		   text="玲はそれでも激痛が酷く、全身を串刺しにされたかのように体を硬直させていた。" voices=""/>
		<msg @l="673" char_id="-1" frame_id="-1" name="朽木"
		   text="『最初からそういう態度を取っていれば良いのだよ。』" voices=""/>
		<msg @l="675" char_id="-1" frame_id="-1" name="朽木"
		   text="『女というのは元々、男の性欲を処理し、癒すためにのみ存在するのだ。』" voices=""/>
		<msg @l="677" char_id="-1" frame_id="-1" name="朽木"
		   text="『女は男のもので貫かれ、よがっていれば良いのだよ！』" voices=""/>
		<msg @l="679" char_id="1" frame_id="-1" name="玲"
		   text="『‥‥アナタみたいな人が大勢いるから、社会はダメになるんです‥‥くっ‥‥。』" voices="rei01390"/>
		<msg @l="681" char_id="-1" frame_id="-1" name=""
		   text="勝手な講釈を口にして、男根で膣を擂粉木棒のように摩擦する。粘った蜜肉はうねりながら収縮した。" voices=""/>
		<msg @l="684" char_id="-1" frame_id="-1" name="朽木"
		   text="『くくっ、私の前で腰を振っている雌豚が何を言っても、説得力がないがね。』" voices=""/>
		<msg @l="685" char_id="1" frame_id="-1" name="玲" text="『んんっ‥‥いたっ‥‥。』"
		   voices="rei01400"/>
		<msg @l="687" char_id="-1" frame_id="-1" name=""
		   text="楽しげに言いながら、朽木は肉棒で子宮口をコンコンと突き上げ、徐々にピッチを上げながら秘所をかきまわした。" voices=""/>
		<msg @l="689" char_id="1" frame_id="-1" name="玲"
		   text="『んっ、あ‥‥んくっ‥‥いたっ‥‥いたぃっっ‥‥。』" voices="rei01410"/>
		<msg @l="691" char_id="-1" frame_id="-1" name=""
		   text="いまだ潤いの足りない肉壺を、男根がローリングを混ぜて何度も擦りあげていく。" voices=""/>
		<msg @l="692" char_id="-1" frame_id="-1" name=""
		   text="玲の控えめな桜色の花唇は、朽木の肉棒によって裂けそうなほど大きく拡げられていた。" voices=""/>
		<msg @l="694" char_id="1" frame_id="-1" name="玲"
		   text="『いぁっ‥‥んっ、んんっ‥‥いたっ‥‥。』" voices="rei01420"/>
		<msg @l="696" char_id="-1" frame_id="-1" name=""
		   text="苦悶の吐息を漏らしながら、玲は両目に涙をためて懸命に堪えている。" voices=""/>
		<msg @l="698" char_id="-1" frame_id="-1" name="朽木"
		   text="『早く濡らさないと痛い思いをし続けるのだがね。』" voices=""/>
		<msg @l="700" char_id="1" frame_id="-1" name="玲" text="『そんなこと、わかって‥‥‥んくっ！！』"
		   voices="rei01430"/>
		<msg @l="702" char_id="-1" frame_id="-1" name=""
		   text="反論をしようとした瞬間、朽木が玲の腰をぐっと引き寄せ突き上げた。" voices=""/>
		<msg @l="703" char_id="-1" frame_id="-1" name=""
		   text="玲は亀頭が子宮口にぶつかるのを感じ、ピリピリと電気ショックのような刺激に襲われる。" voices=""/>
		<msg @l="705" char_id="-1" frame_id="-1" name="朽木"
		   text="『どうした？もしかして感じたのかね？』" voices=""/>
		<msg @l="707" char_id="-1" frame_id="-1" name=""
		   text="朽木は玲の反応を見て、嬉しそうに腰を打ち続ける。" voices=""/>
		<msg @l="709" char_id="1" frame_id="-1" name="玲" text="『やっ‥‥んっ、んくっ‥‥‥‥。』"
		   voices="rei01440"/>
		<msg @l="711" char_id="-1" frame_id="-1" name=""
		   text="朽木が腰を押し付けるたび、玲は短い吐息を漏らして頭を揺らす。" voices=""/>
		<msg @l="712" char_id="-1" frame_id="-1" name=""
		   text="髪が汗で光る肌にはりつき、妖艶さをかもし出した。" voices=""/>
		<msg @l="713" char_id="-1" frame_id="-1" name=""
		   text="その姿を見た朽木はさらに興奮をし、敏感な部分を突き上げるように肉棒で秘裂を掻き回した。" voices=""/>
		<msg @l="715" char_id="1" frame_id="-1" name="玲"
		   text="『んぁっっ‥‥んっ、んっ、んっ‥‥‥‥。』" voices="rei01450"/>
		<msg @l="717" char_id="-1" frame_id="-1" name=""
		   text="息が詰まるような声を漏らしながら、玲は壁についた手に力を入れる。" voices=""/>
		<msg @l="718" char_id="-1" frame_id="-1" name=""
		   text="敏感な部分を攻められる度に、痛み以外の感覚が沸いてきて、声にも今までとは違う吐息が混じ始める。" voices=""/>
		<msg @l="720" char_id="-1" frame_id="-1" name="朽木"
		   text="『おやおや、ここが気持ちいいようだね？』" voices=""/>
		<msg @l="722" char_id="-1" frame_id="-1" name=""
		   text="必死に「それ」を隠そうとする玲を見透かすように、朽木が笑う。" voices=""/>
		<msg @l="724" char_id="1" frame_id="-1" name="玲" text="『ち、ちがっ‥‥んっ‥‥‥あぐっ！！』"
		   voices="rei01460"/>
		<msg @l="726" char_id="-1" frame_id="-1" name=""
		   text="否定の言葉は朽木の突き上げる腰の動きに遮られた。" voices=""/>
		<msg @l="727" char_id="-1" frame_id="-1" name=""
		   text="そうしていると、玲の花唇の中にはじんわりと蜜が滲み出してきた。" voices=""/>
		<msg @l="729" char_id="-1" frame_id="-1" name="朽木"
		   text="『くくっ‥‥キミの身体はこんなにも正直だがね？』" voices=""/>
		<msg @l="731" char_id="1" frame_id="-1" name="玲" text="『んぁぁっ！！』"
		   voices="rei01470"/>
		<msg @l="733" char_id="-1" frame_id="-1" name=""
		   text="蜜が滲み始めたのを合図に、教授室には玲の秘部から漏れるグチュグチュという淫らな水音が響き始めた。" voices=""/>
		<msg @l="735" char_id="-1" frame_id="-1" name="朽木"
		   text="『さて‥‥そろそろ、キミの膣内へ注がせてもらおう。』" voices=""/>
		<msg @l="737" char_id="1" frame_id="-1" name="玲" text="『え‥‥や、中はダメっ！！』"
		   voices="rei01480"/>
		<msg @l="739" char_id="-1" frame_id="-1" name="朽木"
		   text="『中に出してください、お願いします‥‥だろう？』" voices=""/>
		<msg @l="741" char_id="1" frame_id="-1" name="玲"
		   text="『いやあっ‥‥中は、中に出すのだけは許してっ！！』" voices="rei01490"/>
		<msg @l="743" char_id="-1" frame_id="-1" name="朽木"
		   text="『それは残念だ‥‥せっかくここまでしたというのに、膣内で受け止めることも出来ないのでは推薦状は用意できないな。』" voices=""/>
		<msg @l="745" char_id="1" frame_id="-1" name="玲"
		   text="『そんなっ‥‥んんっ、いやっ、んぁぁっ！！』" voices="rei01500"/>
		<msg @l="747" char_id="-1" frame_id="-1" name=""
		   text="朽木の激しいラストスパートに身体を揺さぶられながら、玲は悲痛な面持ちで声を漏らした。理性を破壊し、快楽に落とし込もうという態である。"
		   voices=""/>
		<msg @l="749" char_id="-1" frame_id="-1" name="朽木"
		   text="『さあどうするかね‥‥膣内か体外か、選ぶのはキミだが？』" voices=""/>
		<msg @l="751" char_id="-1" frame_id="-1" name=""
		   text="朽木はこれ見よがしに真っ白なヒップを平手で叩きながら、玲に言った。" voices=""/>
		<msg @l="752" char_id="-1" frame_id="-1" name=""
		   text="無論、そんな事を問うまでもなく朽木は子宮へと精をぶちまけるつもりである。" voices=""/>
		<msg @l="753" char_id="-1" frame_id="-1" name=""
		   text="ただ、それを当人の意思によって決めさせることで、どこまでも玲の自尊心を引き裂き堕とそうという魂胆なのだ。" voices=""/>
		<msg @l="755" char_id="1" frame_id="-1" name="玲" text="『んっ‥‥はぁ‥‥はぁ‥‥はぁ‥‥‥。』"
		   voices="rei01510"/>
		<msg @l="757" char_id="-1" frame_id="-1" name="朽木"
		   text="『さて‥‥膣内か体外か、キミの口からハッキリと聞きたいのだがね？』" voices=""/>
		<msg @l="759" char_id="1" frame_id="-1" name="玲" text="『‥‥‥‥。』"
		   voices="rei01520"/>
		<msg @l="761" char_id="1" frame_id="-1" name="玲" text="『‥‥に‥‥出してください。』"
		   voices="rei01530"/>
		<msg @l="763" char_id="-1" frame_id="-1" name="朽木"
		   text="『もっとハッキリ言いたまえ。推薦状が欲しいのだろう？』" voices=""/>
		<msg @l="765" char_id="1" frame_id="-1" name="玲"
		   text="『中にっ‥‥‥私の中に、朽木教授の熱い精液を注いで下さいっ！』" voices="rei01540"/>
		<msg @l="767" char_id="-1" frame_id="-1" name="朽木"
		   text="『くくっ、よかろう。そこまでお願いされてはしょうがない、キミの一番奥へ、たっぷりとぶちまけてやろう。』" voices=""/>
		<msg @l="769" char_id="1" frame_id="-1" name="玲" text="『あっ、あっ、あっ‥‥んぁぁっ！！』"
		   voices="rei01550"/>
		<msg @l="771" char_id="-1" frame_id="-1" name=""
		   text="朽木がズンと一際勢いをつけて肉壁を擦ると、亀頭が子宮口に届いたような気がした。" voices=""/>
		<msg @l="772" char_id="-1" frame_id="-1" name=""
		   text="玲もまたその動きに対し不本意ながらも膣内をキュッと締めていまい、熱い吐息を漏らしてしまう。" voices=""/>
		<msg @l="773" char_id="-1" frame_id="-1" name=""
		   text="朽木はピストン運動を強めて、速射砲のように肉柱を埋め込んでいく。" voices=""/>
		<msg @l="775" char_id="-1" frame_id="-1" name="朽木" text="『いくぞっ！！』" voices=""/>
		<msg @l="777" char_id="1" frame_id="-1" name="玲" text="『んっ、あああああっ！！』"
		   voices="rei01560"/>
		<flash @l="781" count="4" fade="100" image="white"/>
		<wait_chgmv/>
		<ev @l="785" src="ev-045z1"/>
		<msg @l="787" char_id="1" frame_id="-1" name="玲"
		   text="『んっ‥‥あっ、あっ‥‥‥‥熱いのが‥‥‥流れ込んでくる‥‥‥‥。』" voices="rei01570"/>
		<msg @l="789" char_id="-1" frame_id="-1" name=""
		   text="膣中へと注がれる熱い飛沫の感触に、玲は悲しげな声をあげ腰を震わせた。" voices=""/>
		<msg @l="791" char_id="1" frame_id="-1" name="玲" text="『んあっっ！！』"
		   voices="rei01580"/>
		<msg @l="793" char_id="-1" frame_id="-1" name="" text="幾度目かの脈動の時―――。"
		   voices=""/>
		<msg @l="794" char_id="-1" frame_id="-1" name=""
		   text="玲の腰が大きく跳ね上がり、射精を続けていた肉棒が秘部から抜け落ちてしまう。" voices=""/>
		<msg @l="795" char_id="-1" frame_id="-1" name=""
		   text="抜け落ちてもなお吐き出されるザーメンは、玲の白く丸い尻の上へと降り注いでいった。" voices=""/>
		<stopbgm @l="799" fadeout="1000"/>
		<clear @l="805" class="all"/>
		<end_scene @l="808"/>
		<wait_chgmv/>
		<bg @l="812" src="bg12"/>
		<bgm @l="816" src="bgm15" volume="1."/>
		<char @l="820" id="kutsu" pos="center" src="kutsu010f" y="-80"/>
		<description @l="823" text="ルームメイトの憂鬱・３日目"/>
		<msg @l="825" char_id="-1" frame_id="-1" name="朽木"
		   text="『くくくっ、たっぷりと堪能させてもらったよ。』" voices=""/>
		<msg @l="827" char_id="-1" frame_id="-1" name=""
		   text="玲の膣内から抜け落ちたモノを乱雑にティッシュで拭いながら、朽木が満足げな表情で言った。" voices=""/>
		<msg @l="829" char_id="1" frame_id="-1" name="玲"
		   text="『はぁ‥‥はぁ‥‥はぁ‥‥‥‥や、約束です、写真を‥‥返してください‥‥。』" voices=""/>
		<char @l="832" id="kutsu" pos="center" src="kutsu018f" y="-80"/>
		<msg @l="834" char_id="-1" frame_id="-1" name="朽木"
		   text="『約束？&#32;ハテなんのことだったかな？』" voices=""/>
		<msg @l="836" char_id="1" frame_id="-1" name="玲" text="『と、とぼけないでっ！』"
		   voices=""/>
		<msg @l="838" char_id="1" frame_id="-1" name="玲"
		   text="『こんな、中にまで出されたのに‥‥それなのにっ！？』" voices=""/>
		<msg @l="840" char_id="-1" frame_id="-1" name="朽木"
		   text="『だが、私が膣内出している途中で、君は私のものを抜いてしまったではないかね？』" voices=""/>
		<msg @l="842" char_id="-1" frame_id="-1" name="朽木"
		   text="『私は半分も君の子宮へ注げなかったのだよ？&#32;これは契約違反だ。』" voices=""/>
		<msg @l="844" char_id="1" frame_id="-1" name="玲" text="『そんなの、いいがかりですっ！！』"
		   voices=""/>
		<msg @l="846" char_id="-1" frame_id="-1" name="朽木"
		   text="『いいがかりも何もない‥‥キミの行為に対して、写真を返すかどうかの判断を下すのは私だ、違うかね？』" voices=""/>
		<msg @l="848" char_id="1" frame_id="-1" name="玲" text="『それはっ‥‥。』" voices=""/>
		<char @l="851" id="kutsu" pos="center" src="kutsu010f" y="-80"/>
		<msg @l="853" char_id="-1" frame_id="-1" name="朽木"
		   text="『キミは私との約束を破った。つまりこの話はご破算だ。』" voices=""/>
		<msg @l="855" char_id="-1" frame_id="-1" name="朽木"
		   text="『とはいえ私も鬼ではない。半分は膣内に出したという事にして推薦状だけは用意してあげよう。』" voices=""/>
		<msg @l="857" char_id="-1" frame_id="-1" name="朽木"
		   text="『だが、写真のことは諦めたまえ。明日にでも大学中にばら撒いておくよ。』" voices=""/>
		<clear @l="859" class="char"/>
		<char @l="861" id="rei" pos="auto" src="rei015"/>
		<msg @l="863" char_id="1" frame_id="-1" name="玲"
		   text="『ま、待ってくださいッ‥‥もう一度、もう一度しますからっ！！』" voices=""/>
		<clear @l="866" class="char"/>
		<char @l="868" id="kutsu" pos="left" src="kutsu010"/>
		<char @l="870" id="rei" pos="right" src="rei015"/>
		<msg @l="872" char_id="-1" frame_id="-1" name="朽木"
		   text="『もう遅いな。それに何度もチャンスがあったのでは約束の意味がない。』" voices=""/>
		<char @l="875" id="rei" pos="right" src="rei125"/>
		<msg @l="877" char_id="1" frame_id="-1" name="玲"
		   text="『そんな‥‥じゃあ、どうすればいいんですか‥‥‥。』" voices=""/>
		<msg @l="879" char_id="1" frame_id="-1" name="玲"
		   text="『あんな写真が出回ったら、わたし‥‥わたし‥‥‥。』" voices=""/>
		<msg @l="881" char_id="-1" frame_id="-1" name="朽木"
		   text="『ふむ‥‥そんなに写真を返して欲しいかね？』" voices=""/>
		<char @l="884" id="rei" pos="right" src="rei015"/>
		<msg @l="886" char_id="1" frame_id="-1" name="玲" text="『当たり前ですッ！！』"
		   voices=""/>
		<msg @l="888" char_id="1" frame_id="-1" name="玲"
		   text="『写真をばら撒かれたら‥‥稲庭さんに見られてたら、私は全てを失ってしまいます。』" voices=""/>
		<msg @l="890" char_id="-1" frame_id="-1" name="朽木"
		   text="『そうかね、ならもう一度だけチャンスをあげよう。』" voices=""/>
		<char @l="893" id="rei" pos="right" src="rei014"/>
		<msg @l="895" char_id="1" frame_id="-1" name="玲" text="『ほ、本当ですかっ！？』"
		   voices=""/>
		<char @l="899" id="kutsu" pos="left" src="kutsu018"/>
		<msg @l="901" char_id="-1" frame_id="-1" name="朽木"
		   text="『ああ‥‥今から言うことを手伝ってくれたら‥‥だがね。』" voices=""/>
		<msg @l="903" char_id="-1" frame_id="-1" name=""
		   text="そう言って朽木は爬虫類のような目で玲を見、ニタリと笑った。" voices=""/>
		<msg @l="904" char_id="-1" frame_id="-1" name=""
		   text="玲はそうした朽木の言葉に救いを見出して、安堵のため息をつく。" voices=""/>
		<msg @l="905" char_id="-1" frame_id="-1" name=""
		   text="自分がその狡猾な企みに利用されていることに‥‥気づかぬまま―――。" voices=""/>
		<stopbgm @l="909" fadeout="1000"/>
		<clear @l="915" class="all"/>
		<msgshow @l="917" show="true"/>
		<wait_chgmv/>
		<bg @l="921" src="bg03b"/>
		<bgm @l="925" src="bgm03" volume="1."/>
		<char @l="929" id="miho" pos="auto" src="miho136"/>
		<msg @l="931" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="933" char_id="-1" frame_id="-1" name=""
		   text="夜、まだ帰らない玲さんを待ちながら、私は一人リビングで夕食の用意をするべきかどうかと迷っていた。" voices=""/>
		<msg @l="934" char_id="-1" frame_id="-1" name="" text="今日の夕食当番は玲さんである。"
		   voices=""/>
		<msg @l="935" char_id="-1" frame_id="-1" name=""
		   text="帰りが遅いからといって勝手に夕食の用意をして、またギクシャクするのが嫌だった。" voices=""/>
		<msg @l="936" char_id="-1" frame_id="-1" name=""
		   text="とはいえ‥‥ただ何もせず玲さんが帰ってくるのを待っているだけ、というのもためらわれた。" voices=""/>
		<msg @l="938" char_id="0" frame_id="-1" name="美帆" text="(どうしようかなぁ‥‥)"
		   voices=""/>
		<char @l="942" id="rei" pos="auto" src="rei115"/>
		<bgm @l="946" src="bgm05" volume="1."/>
		<msg @l="948" char_id="1" frame_id="-1" name="玲" text="『ただいま。』" voices=""/>
		<clear @l="951" class="char"/>
		<char @l="953" id="rei" pos="left" src="rei115"/>
		<char @l="956" id="miho" pos="right" src="miho034"/>
		<msg @l="958" char_id="0" frame_id="-1" name="美帆" text="『あ‥‥お、おかえりなさい。』"
		   voices=""/>
		<char @l="961" id="miho" pos="right" src="miho136"/>
		<msg @l="963" char_id="-1" frame_id="-1" name=""
		   text="夜も遅くなって、ようやく玲さんが帰ってきた。" voices=""/>
		<msg @l="964" char_id="-1" frame_id="-1" name=""
		   text="私は朝と同じように探るような感じで、玲さんの様子を伺う。" voices=""/>
		<msg @l="965" char_id="-1" frame_id="-1" name=""
		   text="玲さんが朝より、少しでも不機嫌が直ってないかと期待しながら。" voices=""/>
		<char @l="969" id="rei" pos="left" src="rei125"/>
		<msg @l="971" char_id="1" frame_id="-1" name="玲" text="『････････････････。』"
		   voices=""/>
		<msg @l="973" char_id="-1" frame_id="-1" name=""
		   text="けれど、朝と同様やはり返事はしてもらえなかった。" voices=""/>
		<char @l="977" id="miho" pos="right" src="miho035"/>
		<msg @l="979" char_id="0" frame_id="-1" name="美帆" text="『あ････････。』"
		   voices=""/>
		<char @l="983" id="rei" pos="left" src="rei115"/>
		<msg @l="985" char_id="1" frame_id="-1" name="玲" text="『私、もう休むね‥‥‥‥。』"
		   voices=""/>
		<clear @l="988" layer="rei"/>
		<msg @l="989" char_id="-1" frame_id="-1" name=""
		   text="玲はそういうとすぐに自室に入ってしまった。" voices=""/>
		<msg @l="991" char_id="0" frame_id="-1" name="美帆" text="『お、おやすみなさい‥‥。』"
		   voices=""/>
		<msg @l="993" char_id="-1" frame_id="-1" name=""
		   text="でも、朝とは何か違う感じがする。玲さんの顔は、青白く酷く疲れているように見えた。" voices=""/>
		<clear @l="998" class="char"/>
		<stopbgm @l="1003" fadeout="1000"/>
		<clear @l="1009" class="all"/>
		<call @l="1013" target="EventLabel_133@root_rei04"/>
		<return @l="1014" value="0&#13;&#10;"/>
		<return @l="1017" value=""/>
	</code>
