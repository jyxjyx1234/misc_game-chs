<?xml version="1.0" encoding="utf-8"?>
<xscript>
	<debug editor="&quot;C:\Program&#32;Files&#32;(x86)\sakura\sakura.exe&quot;&#32;&quot;%src%&quot;&#32;-Y=%line%"
	   src="D:\シロップ\町ぐるみの罠＋汚された夏セット版\汚された夏\完成データ\汚された夏\script\text\root_akina03.txt"/>
	<code>
		<label @l="13" id="EventLabel_61"/>
		<description @l="16" text="水泳コーチ・３日目"/>
		<eval @l="18" expr="f.numDay=10&#13;&#10;"/>
		<msgshow @l="20" show="false"/>
		<wait_chgmv/>
		<bg @l="22" src="day10" time="2000"/>
		<wait @l="24" time="500"/>
		<wait_chgmv/>
		<bg @l="26" src="black" time="2000"/>
		<msgshow @l="28" show="true"/>
		<wait_chgmv/>
		<bg @l="31" src="bg08m1"/>
		<bgm @l="34" src="bgm03" volume="1."/>
		<msg @l="36" char_id="-1" frame_id="-1" name="" text="午後の必修授業‥‥。" voices=""/>
		<msg @l="37" char_id="-1" frame_id="-1" name=""
		   text="教壇では講師が教科書を片手に、授業をしている。" voices=""/>
		<msg @l="39" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="41" char_id="-1" frame_id="-1" name=""
		   text="私は筋肉痛とは違う理由で痛む身体に眉をひそめながら･･授業を聞いていた。" voices=""/>
		<msg @l="42" char_id="-1" frame_id="-1" name=""
		   text="どうして自分が‥‥と、投げやりになることも出来る。" voices=""/>
		<msg @l="43" char_id="-1" frame_id="-1" name=""
		   text="でも、それだけじゃ何の解決にもならないことも解っていた。" voices=""/>
		<msg @l="45" char_id="0" frame_id="-1" name="美帆" text="(このままじゃ三年前と一緒‥‥)"
		   voices=""/>
		<msg @l="47" char_id="0" frame_id="-1" name="美帆"
		   text="(人生を壊されて‥‥ボロボロになって、それで)" voices=""/>
		<msg @l="49" char_id="0" frame_id="-1" name="美帆" text="(私だけじゃない‥‥亜季奈も‥‥‥‥)"
		   voices=""/>
		<msg @l="51" char_id="-1" frame_id="-1" name=""
		   text="何故、亜季奈のいる水泳部に渡部先生が復帰できたのかはわからない。" voices=""/>
		<msg @l="52" char_id="-1" frame_id="-1" name="" text="裏取引があったのか････。"
		   voices=""/>
		<msg @l="53" char_id="-1" frame_id="-1" name=""
		   text="それとも････あの事件そのものが無かったことにされたのか････。" voices=""/>
		<msg @l="54" char_id="-1" frame_id="-1" name=""
		   text="どちらにせよ、渡部先生が復帰していることは紛れもない事実だ。" voices=""/>
		<msg @l="56" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="58" char_id="0" frame_id="-1" name="美帆"
		   text="(亜季奈だけは守らなきゃ‥‥何があっても････････)" voices=""/>
		<stopbgm @l="61" fadeout="1000"/>
		<clear @l="64" class="all"/>
		<wait_chgmv/>
		<bg @l="67" src="bg07"/>
		<bgm @l="70" src="bgm03" volume="1."/>
		<char @l="73" id="miho" pos="auto" src="miho115"/>
		<msg @l="75" char_id="-1" frame_id="-1" name=""
		   text="講義を終えて、私はあてもなく一人キャンパスを歩いていた。" voices=""/>
		<msg @l="76" char_id="-1" frame_id="-1" name=""
		   text="このまま真っ直ぐプールに向かうのはためらわれた。" voices=""/>
		<msg @l="77" char_id="-1" frame_id="-1" name="" text="けれど、逃げれば‥‥亜季奈が危ない。"
		   voices=""/>
		<msg @l="78" char_id="-1" frame_id="-1" name="" text="そんな葛藤の中、トボトボと歩いていた。"
		   voices=""/>
		<char @l="81" id="miho" pos="auto" src="miho114"/>
		<msg @l="83" char_id="0" frame_id="-1" name="美帆" text="『あ‥‥。』" voices=""/>
		<char @l="86" id="nanak" pos="auto" src="nanako019"/>
		<bgm @l="89" src="bgm11" volume="1."/>
		<msg @l="91" char_id="-1" frame_id="-1" name=""
		   text="キャンパスの片隅に置かれたベンチに、彼女は座っていた。" voices=""/>
		<msg @l="92" char_id="-1" frame_id="-1" name=""
		   text="色素の薄いツインテールの女の子、‥‥奈那子ちゃん。" voices=""/>
		<msg @l="93" char_id="-1" frame_id="-1" name=""
		   text="一人ベンチに座って、特に何をするでもなく呆然と‥‥空を見ていた。" voices=""/>
		<msg @l="95" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<char @l="98" id="nanak" pos="auto" src="nanako011"/>
		<msg @l="100" char_id="3" frame_id="-1" name="奈那子" text="『あ、美帆だ。』" voices=""/>
		<msg @l="102" char_id="-1" frame_id="-1" name=""
		   text="声を掛けようかどうか迷っていると、奈那子ちゃんの方が私のことに気づき、顔を上げる。" voices=""/>
		<msg @l="104" char_id="0" frame_id="-1" name="美帆" text="『こ、こんにちは。』"
		   voices=""/>
		<msg @l="106" char_id="0" frame_id="-1" name="美帆" text="『何‥‥してるの？』"
		   voices=""/>
		<char @l="109" id="nanak" pos="auto" src="nanako012"/>
		<msg @l="111" char_id="3" frame_id="-1" name="奈那子" text="『お昼寝。』" voices=""/>
		<msg @l="113" char_id="0" frame_id="-1" name="美帆" text="『こんなところで‥‥？』"
		   voices=""/>
		<char @l="116" id="nanak" pos="auto" src="nanako011"/>
		<msg @l="118" char_id="3" frame_id="-1" name="奈那子" text="『うん。』" voices=""/>
		<msg @l="120" char_id="0" frame_id="-1" name="美帆" text="『暑くない？』" voices=""/>
		<char @l="123" id="nanak" pos="auto" src="nanako012"/>
		<msg @l="125" char_id="3" frame_id="-1" name="奈那子"
		   text="『ここ、木の陰になってて涼しいよ‥‥それに今日は風もあるから。』" voices=""/>
		<msg @l="127" char_id="-1" frame_id="-1" name=""
		   text="奈那子ちゃんは気持ちよさそうに目を閉じる。" voices=""/>
		<msg @l="128" char_id="-1" frame_id="-1" name=""
		   text="確かに日差しは遮られ、たまに吹く風が適度に優しい。" voices=""/>
		<msg @l="130" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="132" char_id="0" frame_id="-1" name="美帆" text="『隣‥‥いい？』" voices=""/>
		<char @l="135" id="nanak" pos="auto" src="nanako019"/>
		<msg @l="137" char_id="3" frame_id="-1" name="奈那子" text="『‥‥‥‥。』" voices=""/>
		<msg @l="139" char_id="-1" frame_id="-1" name=""
		   text="奈那子ちゃんは不思議そうな表情で自分の隣を見る。" voices=""/>
		<char @l="142" id="nanak" pos="auto" src="nanako012"/>
		<msg @l="144" char_id="3" frame_id="-1" name="奈那子" text="『私に聞かなくても、空いてるよ？』"
		   voices=""/>
		<msg @l="146" char_id="0" frame_id="-1" name="美帆" text="『あ、あはは‥‥そうだね。』"
		   voices=""/>
		<msg @l="148" char_id="0" frame_id="-1" name="美帆"
		   text="(そういう意味で聞いたんじゃないんだけどな‥‥)" voices=""/>
		<clear @l="151" class="char"/>
		<char @l="153" id="nanak" pos="left" src="nanako010"/>
		<char @l="155" id="miho" pos="right" src="miho110"/>
		<msg @l="157" char_id="-1" frame_id="-1" name=""
		   text="ちょっとした‥‥というか、かなりのズレを感じながらベンチに座る。" voices=""/>
		<char @l="160" id="miho" pos="right" src="miho011"/>
		<msg @l="162" char_id="0" frame_id="-1" name="美帆" text="『んー‥‥風、気持ちいいな‥‥‥。』"
		   voices=""/>
		<msg @l="164" char_id="-1" frame_id="-1" name=""
		   text="私は指を組んで軽く背伸びをしながら‥‥ぽつりと呟く。" voices=""/>
		<msg @l="165" char_id="-1" frame_id="-1" name=""
		   text="連日の蒸し暑さを忘れてさせるぐらい、風が気持ちいい。" voices=""/>
		<msg @l="167" char_id="3" frame_id="-1" name="奈那子" text="『‥‥‥‥。』" voices=""/>
		<msg @l="169" char_id="3" frame_id="-1" name="奈那子" text="『昨日ね‥‥兄様に怒られたの。』"
		   voices=""/>
		<char @l="172" id="miho" pos="right" src="miho014"/>
		<msg @l="174" char_id="0" frame_id="-1" name="美帆" text="『え？』" voices=""/>
		<msg @l="176" char_id="3" frame_id="-1" name="奈那子"
		   text="『どうして奈那子は、美帆にこだわるんだ‥‥‥って。』" voices=""/>
		<char @l="179" id="miho" pos="right" src="miho114"/>
		<msg @l="181" char_id="0" frame_id="-1" name="美帆" text="『あ‥‥。』" voices=""/>
		<msg @l="183" char_id="-1" frame_id="-1" name=""
		   text="昨日、渡部先生に襲われそうになっていた私を助けてくれた時････。" voices=""/>
		<msg @l="184" char_id="-1" frame_id="-1" name=""
		   text="確か「奈那子がどうしても････」みたいな････ことを言っていた。" voices=""/>
		<char @l="187" id="nanak" pos="left" src="nanako017"/>
		<msg @l="189" char_id="3" frame_id="-1" name="奈那子"
		   text="『私‥‥兄様の都合で、よく転校とか繰り返してるから、お友達を作っちゃダメなんだって。』" voices=""/>
		<msg @l="191" char_id="3" frame_id="-1" name="奈那子"
		   text="『お別れが悲しくなっちゃうから‥‥ダメだって。』" voices=""/>
		<char @l="194" id="miho" pos="right" src="miho116"/>
		<msg @l="196" char_id="0" frame_id="-1" name="美帆" text="『そう‥‥なんだ。』"
		   voices=""/>
		<char @l="199" id="nanak" pos="left" src="nanako011"/>
		<msg @l="201" char_id="3" frame_id="-1" name="奈那子"
		   text="『でもね、私は美帆とお友達になりたい‥‥。』" voices=""/>
		<char @l="204" id="nanak" pos="left" src="nanako019"/>
		<msg @l="206" char_id="3" frame_id="-1" name="奈那子"
		   text="『美帆は‥‥‥なんか、放っておけないから。』" voices=""/>
		<msg @l="208" char_id="-1" frame_id="-1" name=""
		   text="奈那子ちゃんの言葉に、私はプクッと頬を膨らませて抗議する。" voices=""/>
		<char @l="211" id="miho" pos="right" src="miho016"/>
		<msg @l="213" char_id="0" frame_id="-1" name="美帆"
		   text="『‥‥それって、私が頼りないってこと‥‥？』" voices=""/>
		<char @l="216" id="nanak" pos="left" src="nanako012"/>
		<msg @l="218" char_id="3" frame_id="-1" name="奈那子" text="『うん。』" voices=""/>
		<char @l="221" id="miho" pos="right" src="miho015"/>
		<msg @l="223" char_id="0" frame_id="-1" name="美帆" text="『あう‥‥。』" voices=""/>
		<msg @l="225" char_id="-1" frame_id="-1" name=""
		   text="そこまで笑顔で肯定されると、何も言えなくなった。" voices=""/>
		<char @l="228" id="nanak" pos="left" src="nanako018"/>
		<msg @l="230" char_id="3" frame_id="-1" name="奈那子"
		   text="『私、これからも美帆とお話してもいい？』" voices=""/>
		<char @l="233" id="miho" pos="right" src="miho014"/>
		<msg @l="235" char_id="3" frame_id="-1" name="奈那子"
		   text="『兄様は怒るけど‥‥でも、私は美帆とお友達でいたい。』" voices=""/>
		<char @l="238" id="nanak" pos="left" src="nanako019"/>
		<msg @l="240" char_id="3" frame_id="-1" name="奈那子" text="『‥‥いい？』" voices=""/>
		<char @l="243" id="miho" pos="right" src="miho110"/>
		<msg @l="245" char_id="0" frame_id="-1" name="美帆" text="『お兄さん、いいの‥‥？』"
		   voices=""/>
		<char @l="248" id="nanak" pos="left" src="nanako011"/>
		<msg @l="250" char_id="3" frame_id="-1" name="奈那子" text="『ん‥‥。』" voices=""/>
		<msg @l="252" char_id="3" frame_id="-1" name="奈那子"
		   text="『兄様も本当はわかってると思う‥‥。』" voices=""/>
		<char @l="255" id="nanak" pos="left" src="nanako010"/>
		<msg @l="257" char_id="3" frame_id="-1" name="奈那子"
		   text="『一人はつらいって、わかってると思うから。』" voices=""/>
		<char @l="260" id="miho" pos="right" src="miho116"/>
		<msg @l="262" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="264" char_id="-1" frame_id="-1" name="" text="一人はつらい‥‥。" voices=""/>
		<msg @l="265" char_id="-1" frame_id="-1" name="" text="誰だって一人きりはつらい。"
		   voices=""/>
		<msg @l="266" char_id="-1" frame_id="-1" name=""
		   text="だから友達を作り、恋人にあこがれ、家族を守る‥‥のだと思う。" voices=""/>
		<char @l="269" id="nanak" pos="left" src="nanako018"/>
		<msg @l="271" char_id="3" frame_id="-1" name="奈那子"
		   text="『だから‥‥‥美帆、お友達でいていい？』" voices=""/>
		<char @l="274" id="miho" pos="right" src="miho111"/>
		<msg @l="276" char_id="0" frame_id="-1" name="美帆" text="『うん、よろしくね！』"
		   voices=""/>
		<char @l="279" id="nanak" pos="left" src="nanako011"/>
		<msg @l="281" char_id="3" frame_id="-1" name="奈那子" text="『ん、よかった。』"
		   voices=""/>
		<msg @l="283" char_id="-1" frame_id="-1" name="" text="そう言って奈那子ちゃんはにっこりと笑う。"
		   voices=""/>
		<char @l="286" id="nanak" pos="left" src="nanako014"/>
		<msg @l="288" char_id="3" frame_id="-1" name="奈那子" text="『あ‥‥兄様。』" voices=""/>
		<char @l="291" id="miho" pos="right" src="miho114"/>
		<msg @l="293" char_id="0" frame_id="-1" name="美帆" text="『え‥‥。』" voices=""/>
		<msg @l="295" char_id="-1" frame_id="-1" name=""
		   text="奈那子ちゃんの視線を追うと、確かにキャンパスの一角に‥‥お兄さんがいた。" voices=""/>
		<char @l="298" id="nanak" pos="left" src="nanako012"/>
		<msg @l="300" char_id="3" frame_id="-1" name="奈那子" text="『‥‥私、いかなきゃ。』"
		   voices=""/>
		<char @l="303" id="miho" pos="right" src="miho016"/>
		<msg @l="305" char_id="0" frame_id="-1" name="美帆" text="『う、うん。』" voices=""/>
		<clear @l="308" class="char"/>
		<char @l="310" id="miho" pos="auto" src="miho110"/>
		<msg @l="312" char_id="-1" frame_id="-1" name=""
		   text="そういって奈那子ちゃんはそそくさとベンチから立ち上がると、小走りにお兄さんの方へ駆け出していく。" voices=""/>
		<stopbgm @l="315" fadeout="1000"/>
		<bgm @l="318" src="bgm02" volume="1."/>
		<char @l="321" id="miho" pos="auto" src="miho010"/>
		<msg @l="323" char_id="-1" frame_id="-1" name="" text="････････････"
		   voices=""/>
		<msg @l="324" char_id="-1" frame_id="-1" name="" text="････････" voices=""/>
		<msg @l="325" char_id="-1" frame_id="-1" name="" text="････" voices=""/>
		<msg @l="327" char_id="0" frame_id="-1" name="美帆" text="『‥‥。』" voices=""/>
		<msg @l="329" char_id="0" frame_id="-1" name="美帆" text="『私も‥‥行かなきゃ。』"
		   voices=""/>
		<char @l="332" id="miho" pos="auto" src="miho110"/>
		<msg @l="334" char_id="-1" frame_id="-1" name="" text="私にも好きな人がいる。"
		   voices=""/>
		<msg @l="335" char_id="-1" frame_id="-1" name="" text="その人を‥‥守りたいから。"
		   voices=""/>
		<msg @l="337" char_id="0" frame_id="-1" name="美帆" text="(亜季奈‥‥‥私、がんばるから)"
		   voices=""/>
		<msg @l="339" char_id="0" frame_id="-1" name="美帆" text="(だから‥‥)" voices=""/>
		<stopbgm @l="342" fadeout="1000"/>
		<clear @l="345" class="all"/>
		<msgshow @l="347" show="true"/>
		<wait_chgmv/>
		<bg @l="350" src="bg11"/>
		<char @l="352" id="miho" pos="auto" src="miho015"/>
		<msg @l="354" char_id="0" frame_id="-1" name="美帆" text="『なにこれ‥‥。』" voices=""/>
		<bgm @l="357" src="bgm15" volume="1."/>
		<msg @l="359" char_id="-1" frame_id="-1" name="" text="がんばろうと思った。" voices=""/>
		<msg @l="360" char_id="-1" frame_id="-1" name=""
		   text="亜季奈の為に、少しくらいイタズラされても我慢しようと。" voices=""/>
		<msg @l="361" char_id="-1" frame_id="-1" name=""
		   text="でも‥‥幾らなんでもこんなことになるなんて。" voices=""/>
		<clear @l="364" class="all"/>
		<msg @l="366" char_id="-1" frame_id="-1" name=""
		   text="『キノウノコトデハナシガアリマスレンシュウゴココデアイマショウ』" voices=""/>
		<msg @l="367" char_id="-1" frame_id="-1" name=""
		   text="合宿が始まってから私が使っているロッカーの中に、四つ折りにされた紙が置かれていた。" voices=""/>
		<msg @l="368" char_id="-1" frame_id="-1" name=""
		   text="そして、その紙の内側に書かれていた文字が‥‥これだ。" voices=""/>
		<clear @l="371" class="all"/>
		<msgshow @l="373" show="true"/>
		<wait_chgmv/>
		<bg @l="376" src="bg11"/>
		<char @l="379" id="miho" pos="auto" src="miho015"/>
		<msg @l="381" char_id="0" frame_id="-1" name="美帆"
		   text="『昨日の事で話があります‥‥練習後、ここで会いましょう。』" voices=""/>
		<msg @l="383" char_id="-1" frame_id="-1" name="" text="紙に書かれていた内容を口に出して読む。"
		   voices=""/>
		<msg @l="384" char_id="-1" frame_id="-1" name=""
		   text="全部がカタカナだったから実感がわかなかったけど‥‥これは明らかに脅迫状だ。" voices=""/>
		<msg @l="385" char_id="-1" frame_id="-1" name=""
		   text="字はすべて左手で書いたみたいにぐにゃぐにゃで、何とか読める‥‥という感じだ。" voices=""/>
		<msg @l="386" char_id="-1" frame_id="-1" name=""
		   text="これがカタカナじゃなかったら、読めなかったかもしれない。" voices=""/>
		<msg @l="390" char_id="0" frame_id="-1" name="美帆" text="(どうしてこんな‥‥)"
		   voices=""/>
		<msg @l="392" char_id="0" frame_id="-1" name="美帆" text="(私ばっかり‥‥‥‥‥)"
		   voices=""/>
		<msg @l="394" char_id="-1" frame_id="-1" name="" text="････････････････"
		   voices=""/>
		<msg @l="395" char_id="-1" frame_id="-1" name=""
		   text="････････････････････････" voices=""/>
		<char @l="398" id="akina" pos="auto" src="akina064"/>
		<msg @l="400" char_id="2" frame_id="-1" name="亜季奈" text="『あれ、お姉ちゃん‥‥？』"
		   voices=""/>
		<stopbgm @l="403" fadeout="1000"/>
		<clear @l="406" class="char"/>
		<char @l="408" id="akina" pos="right" src="akina060"/>
		<char @l="410" id="miho" pos="left" src="miho014"/>
		<msg @l="412" char_id="0" frame_id="-1" name="美帆" text="『‥‥！』" voices=""/>
		<msg @l="414" char_id="0" frame_id="-1" name="美帆" text="『あ、亜季奈‥‥。』"
		   voices=""/>
		<msg @l="416" char_id="-1" frame_id="-1" name=""
		   text="突然の声に、私は慌てて紙を折りなおしてロッカーの奥にしまう。" voices=""/>
		<msg @l="417" char_id="-1" frame_id="-1" name="" text="亜季奈に見られる訳には‥‥。"
		   voices=""/>
		<bgm @l="420" src="bgm06" volume="1."/>
		<char @l="422" id="akina" pos="right" src="akina161"/>
		<msg @l="424" char_id="2" frame_id="-1" name="亜季奈"
		   text="『お姉ちゃん、いま来たとこ？&#32;遅かったね？』" voices=""/>
		<char @l="427" id="miho" pos="left" src="miho116"/>
		<msg @l="429" char_id="0" frame_id="-1" name="美帆" text="『あ、うん‥‥。』" voices=""/>
		<char @l="432" id="miho" pos="left" src="miho016"/>
		<msg @l="434" char_id="0" frame_id="-1" name="美帆" text="『授業‥‥ちょっと長引いちゃって。』"
		   voices=""/>
		<msg @l="436" char_id="-1" frame_id="-1" name="" text="嘘をつく。" voices=""/>
		<msg @l="437" char_id="-1" frame_id="-1" name=""
		   text="何でもない、ちょっとした取りつくろいの嘘‥‥。" voices=""/>
		<msg @l="438" char_id="-1" frame_id="-1" name="" text="･･････心が痛い････。"
		   voices=""/>
		<char @l="441" id="akina" pos="right" src="akina060"/>
		<msg @l="443" char_id="2" frame_id="-1" name="亜季奈"
		   text="『みんな、お姉ちゃんが来るの待ってるよ。』" voices=""/>
		<char @l="446" id="miho" pos="left" src="miho014"/>
		<msg @l="448" char_id="0" frame_id="-1" name="美帆" text="『そ、そうなの‥‥？』"
		   voices=""/>
		<char @l="451" id="akina" pos="right" src="akina061"/>
		<msg @l="453" char_id="2" frame_id="-1" name="亜季奈" text="『お姉ちゃん、人気者だよ～。』"
		   voices=""/>
		<char @l="456" id="akina" pos="right" src="akina062"/>
		<msg @l="458" char_id="2" frame_id="-1" name="亜季奈"
		   text="『教え方も的確だし‥‥水着もせくし～だし？』" voices=""/>
		<char @l="461" id="miho" pos="left" src="miho016"/>
		<msg @l="463" char_id="0" frame_id="-1" name="美帆" text="『亜季奈～！』" voices=""/>
		<char @l="466" id="akina" pos="right" src="akina161"/>
		<msg @l="468" char_id="2" frame_id="-1" name="亜季奈"
		   text="『えへへ～、じゃ、私はゴーグルの予備取りに来ただけだから。』" voices=""/>
		<clear @l="471" layer="miho"/>
		<char @l="474" id="miho" pos="left" src="miho010"/>
		<msg @l="476" char_id="0" frame_id="-1" name="美帆"
		   text="『ハイハイ、私も着替えてすぐに行くから。』" voices=""/>
		<msg @l="478" char_id="2" frame_id="-1" name="亜季奈" text="『待ってるよー。』"
		   voices=""/>
		<clear @l="481" class="char"/>
		<char @l="483" id="miho" pos="left" src="miho010"/>
		<msg @l="485" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<char @l="488" id="miho" pos="left" src="miho116"/>
		<msg @l="490" char_id="0" frame_id="-1" name="美帆" text="『早く着替えよ‥‥。』"
		   voices=""/>
		<stopbgm @l="493" fadeout="1000"/>
		<clear @l="497" class="all"/>
		<label @l="500" id="event_scene36"/>
		<wait_chgmv/>
		<bg @l="503" src="bg10m1"/>
		<bgm @l="506" src="bgm02" volume="1."/>
		<char @l="509" id="miho" pos="auto" src="miho060"/>
		<msg @l="511" char_id="0" frame_id="-1" name="美帆"
		   text="『いいですよ、その調子で力を抜いて‥‥。』" voices=""/>
		<msg @l="513" char_id="0" frame_id="-1" name="美帆"
		   text="『はい‥‥それじゃあ私の手拍子に合わせて、ブレスのタイミングを計ってください。』" voices=""/>
		<char @l="516" id="miho" pos="auto" src="miho166"/>
		<msg @l="518" char_id="-1" frame_id="-1" name="" text="‥‥いつもの練習をしていた。"
		   voices=""/>
		<msg @l="519" char_id="-1" frame_id="-1" name=""
		   text="亜季奈のいる水泳部の合宿が始まって三日目。" voices=""/>
		<msg @l="520" char_id="-1" frame_id="-1" name=""
		   text="また今日も、陵辱の水泳時間が始まる‥‥そう思っていた。" voices=""/>
		<msg @l="521" char_id="-1" frame_id="-1" name="" text="けれど今日は普通の練習が続いている。"
		   voices=""/>
		<msg @l="522" char_id="-1" frame_id="-1" name=""
		   text="今日は、顧問の渡部先生が来ていないからだ。" voices=""/>
		<msg @l="524" char_id="0" frame_id="-1" name="美帆" text="(どうして‥‥)" voices=""/>
		<msg @l="526" char_id="0" frame_id="-1" name="美帆"
		   text="(あんな手紙をロッカーに入れておきながら、どうしていないの？)" voices=""/>
		<msg @l="528" char_id="0" frame_id="-1" name="美帆"
		   text="(何を‥‥企んでいるのかしら‥‥‥‥？)" voices=""/>
		<msg @l="530" char_id="0" frame_id="-1" name="美帆"
		   text="(亜季奈も水泳部の子も、渡部先生が来てない理由‥‥知らないみたいだし)" voices=""/>
		<msg @l="532" char_id="-1" frame_id="-1" name=""
		   text="そんな事を思いながら、もう三時間は経っただろうか。" voices=""/>
		<msg @l="533" char_id="-1" frame_id="-1" name=""
		   text="渡部先生のイタズラを警戒してプールサイドから泳ぎのフォームを見ていたが、今日は大丈夫と思い、私は競泳用コースの隣に入った。"
		   voices=""/>
		<label @l="536" id="chart_line12"/>
		<wait_chgmv/>
		<ev @l="539" src="ev-036"/>
		<description @l="542" text="新たな凶手"/>
		<msg @l="544" char_id="0" frame_id="-1" name="美帆" text="(考えすぎ‥‥だったのかな)"
		   voices="miho03590"/>
		<msg @l="546" char_id="0" frame_id="-1" name="美帆"
		   text="(あの紙切れも、単なるイタズラだったのかもしれないし‥‥)" voices="miho03600"/>
		<msg @l="548" char_id="-1" frame_id="-1" name=""
		   text="単なるイタズラにしては‥‥内容が過激すぎる気がしなくもないけど。" voices=""/>
		<msg @l="550" char_id="0" frame_id="-1" name="美帆"
		   text="(でもまあ、渡部先生がいないなら怖がることもないかな‥‥)" voices="miho03610"/>
		<msg @l="552" char_id="0" frame_id="-1" name="美帆"
		   text="(まさか‥‥昨日みたいに隠れて見てるなんてこと、ないだろうし)" voices="miho03620"/>
		<msg @l="554" char_id="-1" frame_id="-1" name=""
		   text="周囲を見回してみるが、それらしい姿はない。" voices=""/>
		<msg @l="555" char_id="-1" frame_id="-1" name=""
		   text="目に入ってくるのは昨日から大学側のサークルに入会したとかいう留学生‥‥くらいなものだろう。" voices=""/>
		<msg @l="556" char_id="-1" frame_id="-1" name="" text="どこの国の人かはわからないけど‥‥。"
		   voices=""/>
		<msg @l="557" char_id="-1" frame_id="-1" name=""
		   text="肌が浅黒く、妙に陽気で、女の子と見るとなりふり構わず声を掛けまわっている。" voices=""/>
		<msg @l="559" char_id="0" frame_id="-1" name="美帆" text="(苦手だな‥‥ああいう人)"
		   voices="miho03630"/>
		<msg @l="561" char_id="0" frame_id="-1" name="美帆"
		   text="(って‥‥なんか、コッチに来るし‥‥‥)" voices="miho03640"/>
		<msg @l="564" char_id="-1" frame_id="-1" name="留学生" text="『オォウ、アナタベリーキュート。』"
		   voices=""/>
		<msg @l="566" char_id="0" frame_id="-1" name="美帆" text="『ど、どうも‥‥。』"
		   voices="miho03650"/>
		<msg @l="568" char_id="-1" frame_id="-1" name="留学生"
		   text="『ジャパニーズガール、ミンナプリティー。』" voices=""/>
		<msg @l="570" char_id="-1" frame_id="-1" name="留学生"
		   text="『ワタシ、ニホンノジョセイ、ダイスキ。』" voices=""/>
		<msg @l="572" char_id="0" frame_id="-1" name="美帆"
		   text="『そ、そうですか‥‥‥えと‥‥日本語お上手ですね。』" voices="miho03660"/>
		<msg @l="574" char_id="-1" frame_id="-1" name="留学生"
		   text="『センキュー！アリガト、ゴザイマース』" voices=""/>
		<msg @l="576" char_id="-1" frame_id="-1" name="留学生"
		   text="『ワタシ、ニホンゴ、イパイイパイ、ベンキョシタデース。』" voices=""/>
		<msg @l="578" char_id="0" frame_id="-1" name="美帆" text="『はあ‥‥。』"
		   voices="miho03670"/>
		<msg @l="580" char_id="-1" frame_id="-1" name="留学生"
		   text="『ユート、ステディーニ、ナリタイネ。』" voices=""/>
		<msg @l="582" char_id="0" frame_id="-1" name="美帆" text="『え、あ‥‥ちょっと。』"
		   voices="miho03680"/>
		<stopbgm @l="586" fadeout="1000"/>
		<wait_chgmv/>
		<ev @l="589" src="ev-036x2y1y2"/>
		<bgm @l="592" src="bgm15" volume="1."/>
		<msg @l="594" char_id="-1" frame_id="-1" name=""
		   text="留学生の彼は私の背後に来たかと思うと、両手を私の身体に伸ばしてくる。" voices=""/>
		<msg @l="596" char_id="0" frame_id="-1" name="美帆" text="『や‥‥なにをっ！？』"
		   voices="miho03690"/>
		<msg @l="598" char_id="-1" frame_id="-1" name="留学生"
		   text="『オーイエー、ジャパニーズ、ヤマトナデシコ。』" voices=""/>
		<msg @l="600" char_id="0" frame_id="-1" name="美帆"
		   text="『そんなこと‥‥やだ、やめてくださいっ‥‥‥。』" voices="miho03700"/>
		<msg @l="602" char_id="-1" frame_id="-1" name="留学生"
		   text="『ホワァーイ？&#32;ユー、コレ、ダイスキ。』" voices=""/>
		<msg @l="604" char_id="0" frame_id="-1" name="美帆" text="『え‥‥何を‥‥‥？』"
		   voices="miho03710"/>
		<msg @l="606" char_id="-1" frame_id="-1" name="留学生" text="『キノウノコト、ワタシミテタヨ。』"
		   voices=""/>
		<msg @l="608" char_id="0" frame_id="-1" name="美帆" text="『―――――ッ！？』"
		   voices="miho03720"/>
		<msg @l="610" char_id="-1" frame_id="-1" name=""
		   text="昨日‥‥私はここで渡部先生のイタズラに耐えながら指導をしていた。" voices=""/>
		<msg @l="611" char_id="-1" frame_id="-1" name="" text="その時の様子を‥‥見られた！？"
		   voices=""/>
		<msg @l="613" char_id="0" frame_id="-1" name="美帆"
		   text="『まさか‥‥ロッカーにあったあのメモ‥‥‥‥っ！？』" voices="miho03730"/>
		<msg @l="615" char_id="-1" frame_id="-1" name="留学生"
		   text="『イエース、ザッツラーイト。ミーカラノ、ラブレターネ。』" voices=""/>
		<msg @l="617" char_id="0" frame_id="-1" name="美帆" text="『ラ、ラブレターって‥‥。』"
		   voices="miho03740"/>
		<msg @l="619" char_id="-1" frame_id="-1" name="" text="絶対にこの人は意味を取り違えてる。"
		   voices=""/>
		<msg @l="621" char_id="0" frame_id="-1" name="美帆"
		   text="『あ、ああいうのはラブレターとは‥‥‥んんっ。』" voices="miho03750"/>
		<msg @l="623" char_id="-1" frame_id="-1" name=""
		   text="黒人留学生の手が水着の上から胸をわしづかみにして、強弱をつけて揉み続ける。" voices=""/>
		<msg @l="624" char_id="-1" frame_id="-1" name=""
		   text="もう片方の手はいつの間にか太股へ這わされ、止める暇もなくアソコへと伸びた。" voices=""/>
		<msg @l="626" char_id="-1" frame_id="-1" name="留学生"
		   text="『アナタ、チカンプレイ、ダイスキ、チカンハ、ニポンジンノ、グッドカルチャー。』" voices=""/>
		<msg @l="628" char_id="0" frame_id="-1" name="美帆"
		   text="『だから、ちが‥‥んんっ‥‥‥‥やだ、いやですっ。』" voices="miho03760"/>
		<msg @l="630" char_id="-1" frame_id="-1" name="留学生"
		   text="『オーケーイ、イヤヨイヤヨモ、スキノウチ、デスネ？』" voices=""/>
		<msg @l="632" char_id="0" frame_id="-1" name="美帆"
		   text="(ダメ‥‥この人、いちおう日本語は解ってるみたいだけど、意味とか全然理解してないよ‥‥)" voices="miho03770"/>
		<msg @l="634" char_id="0" frame_id="-1" name="美帆"
		   text="(どうしよう‥‥変に騒いでみんなから見られたくないけど‥‥‥)" voices="miho03780"/>
		<msg @l="638" async="true" char_id="-1" frame_id="-1" name=""
		   text="変な留学生に対して私は‥‥？" voices=""/>
		<select @l="639">
			<menu @l="643" label="EventLabel_62" text="抵抗する"/>
			<menu @l="646" label="EventLabel_63" text="大人しくしてる"/>
		</select>
		<label @l="654" id="EventLabel_62"/>
		<msg @l="656" char_id="0" frame_id="-1" name="美帆"
		   text="『やだっ‥‥お願いです、やめてくださいっ‥‥‥。』" voices="miho03790"/>
		<msg @l="658" char_id="-1" frame_id="-1" name="" text="私は必死の抵抗を試みる。"
		   voices=""/>
		<msg @l="659" char_id="-1" frame_id="-1" name=""
		   text="言葉でわかってもらえないなら、態度でわかってもらうしかない。" voices=""/>
		<msg @l="661" char_id="-1" frame_id="-1" name="留学生"
		   text="『ベリグー！ヤワラカイオパーイネー。』" voices=""/>
		<msg @l="663" char_id="0" frame_id="-1" name="美帆"
		   text="『もう‥‥嫌だって、言ってるじゃないですかっ！』" voices="miho03800"/>
		<clear @l="666" class="all"/>
		<se @l="669" buf="1" src="人とぶつかる音" volume="1."/>
		<flash @l="671" count="4" fade="100" image="white"/>
		<msg @l="673" char_id="-1" frame_id="-1" name="留学生" text="『アウチッ！？』"
		   voices=""/>
		<stopbgm @l="676" fadeout="1000"/>
		<msg @l="678" char_id="-1" frame_id="-1" name=""
		   text="勢い良く振り払おうとした瞬間、私の頭が彼のアゴに直撃する。" voices=""/>
		<msg @l="679" char_id="-1" frame_id="-1" name=""
		   text="そして‥‥彼はそのまま水の中へ沈んでいく。" voices=""/>
		<clear @l="682" class="all"/>
		<wait_chgmv/>
		<bg @l="685" src="bg10m1"/>
		<bgm @l="688" src="bgm06" volume="1."/>
		<char @l="691" id="miho" pos="auto" src="miho064"/>
		<msg @l="693" char_id="0" frame_id="-1" name="美帆" text="『わ、わわっ‥‥。』"
		   voices="miho03810"/>
		<clear @l="696" class="char"/>
		<char @l="698" id="miho" pos="left" src="miho065"/>
		<char @l="700" id="akina" pos="right" src="akina160"/>
		<char @l="703" id="akina" pos="right" src="akina164"/>
		<msg @l="705" char_id="2" frame_id="-1" name="亜季奈"
		   text="『お姉ちゃんどうしたの‥‥‥って、人が沈んでるよ！？』" voices="akina00170"/>
		<msg @l="708" char_id="0" frame_id="-1" name="美帆"
		   text="『い、いきなりこの人にからまれて‥‥抵抗したら‥‥‥アゴに頭が当たっちゃって‥‥‥‥。』" voices="miho03820"/>
		<msg @l="710" char_id="0" frame_id="-1" name="美帆" text="『ど、どど‥‥どうしよ～～。』"
		   voices="miho03830"/>
		<clear @l="713" layer="akina"/>
		<char @l="716" id="akina" pos="center" src="akina064f" y="-80"/>
		<msg @l="718" char_id="2" frame_id="-1" name="亜季奈"
		   text="『どうしようも何も、早く運ばなきゃ、おぼれちゃうよっ！』" voices="akina00180"/>
		<msg @l="720" char_id="0" frame_id="-1" name="美帆" text="『う、うんっ。』"
		   voices="miho03840"/>
		<clear @l="723" class="all"/>
		<end_scene @l="726"/>
		<wait_chgmv/>
		<bg @l="729" src="bg10m1"/>
		<bgm @l="732" src="bgm02" volume="1."/>
		<char @l="735" id="miho" pos="auto" src="miho160"/>
		<description @l="738" text="水泳コーチ・３日目"/>
		<msg @l="740" char_id="0" frame_id="-1" name="美帆" text="『‥‥ふぅ。』" voices=""/>
		<msg @l="742" char_id="-1" frame_id="-1" name=""
		   text="ドタバタ騒動がひと段落ついて、私は短く息を吐く。" voices=""/>
		<msg @l="743" char_id="-1" frame_id="-1" name=""
		   text="あの黒人留学生は、水泳部の男の子と大学側のサークルメンバーの手助けで男子更衣室へと運ばれていった。" voices=""/>
		<msg @l="744" char_id="-1" frame_id="-1" name=""
		   text="ありのままを話したので、特にこれといった問題になることもなかった。" voices=""/>
		<msg @l="745" char_id="-1" frame_id="-1" name=""
		   text="もちろん、昨日の事とか、ロッカーに入っていた紙切れについては一切触れる事無く、いきなり抱きついてきたという形に変えさせてもらったけど。"
		   voices=""/>
		<msg @l="746" char_id="-1" frame_id="-1" name=""
		   text="なんにせよ大学側のサークル‥‥特に女性のサークル員からお褒めの言葉を貰ったのが、ちょっとした励みになった。" voices=""/>
		<msg @l="747" char_id="-1" frame_id="-1" name=""
		   text="‥‥みんな、彼の行動が目に余っていたようだ。" voices=""/>
		<clear @l="750" class="char"/>
		<char @l="752" id="miho" pos="left" src="miho160"/>
		<char @l="754" id="akina" pos="right" src="akina062"/>
		<msg @l="756" char_id="2" frame_id="-1" name="亜季奈" text="『災難だったね、お姉ちゃん。』"
		   voices=""/>
		<char @l="759" id="miho" pos="left" src="miho066"/>
		<msg @l="761" char_id="0" frame_id="-1" name="美帆" text="『うん‥‥なんだか疲れちゃった。』"
		   voices=""/>
		<char @l="764" id="akina" pos="right" src="akina061"/>
		<msg @l="766" char_id="2" frame_id="-1" name="亜季奈" text="『あはは、おつかれさま。』"
		   voices=""/>
		<char @l="769" id="akina" pos="right" src="akina167"/>
		<msg @l="771" char_id="2" frame_id="-1" name="亜季奈" text="『でも、ひとつ解んないんだよね～。』"
		   voices=""/>
		<char @l="774" id="miho" pos="left" src="miho164"/>
		<msg @l="776" char_id="0" frame_id="-1" name="美帆" text="『なにが？』" voices=""/>
		<msg @l="778" char_id="2" frame_id="-1" name="亜季奈"
		   text="『あの人、運ばれてからずっと「ラブレター、ラブレター」なんてうわごと繰り返してたんだって。』" voices=""/>
		<char @l="781" id="akina" pos="right" src="akina162"/>
		<msg @l="783" char_id="2" frame_id="-1" name="亜季奈"
		   text="『お姉ちゃん、もしかしてあの人からラブレターなんて貰った？』" voices=""/>
		<char @l="786" id="miho" pos="left" src="miho066"/>
		<msg @l="788" char_id="0" frame_id="-1" name="美帆" text="『う、ううん‥‥知らないよ。』"
		   voices=""/>
		<char @l="791" id="akina" pos="right" src="akina061"/>
		<msg @l="793" char_id="2" frame_id="-1" name="亜季奈" text="『だよねぇ？』" voices=""/>
		<char @l="796" id="miho" pos="left" src="miho166"/>
		<msg @l="798" char_id="0" frame_id="-1" name="美帆"
		   text="(本気であれがラブレターだと思ってたのね‥‥あの黒人留学生)" voices=""/>
		<msg @l="800" char_id="-1" frame_id="-1" name=""
		   text="私は苦笑を浮かべながら、心の中で大きなため息をついた。" voices=""/>
		<eval @l="803" expr="f.留学生に抵抗したflag&#32;=&#32;1&#13;&#10;"/>
		<goto @l="806" label="EventLabel_64"/>
		<label @l="810" id="EventLabel_63"/>
		<bgm @l="813" src="bgm14" volume="1."/>
		<msg @l="815" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』"
		   voices="miho03850"/>
		<msg @l="817" char_id="0" frame_id="-1" name="美帆"
		   text="(抵抗して、昨日のこととかバラされたらマズイし‥‥‥)" voices="miho03860"/>
		<msg @l="819" char_id="0" frame_id="-1" name="美帆"
		   text="(黙って大人しくしておけば‥‥‥‥そのうち諦めてくれるよね)" voices="miho03870"/>
		<msg @l="821" char_id="-1" frame_id="-1" name=""
		   text="仕方なく‥‥黒人留学生の行うままに身を任せることにした。" voices=""/>
		<msg @l="822" char_id="-1" frame_id="-1" name=""
		   text="そうする事が良いとは思わないけれど、変に抵抗して黒人留学生を刺激して、変な事を口走られては大変なことになってしまうかもしれない。"
		   voices=""/>
		<msg @l="823" char_id="-1" frame_id="-1" name=""
		   text="だから、私は黒人留学生があきるのを待つことにした。" voices=""/>
		<msg @l="825" char_id="-1" frame_id="-1" name="留学生" text="『オーイエー！イイネ！』"
		   voices=""/>
		<msg @l="827" char_id="-1" frame_id="-1" name=""
		   text="私は抵抗することもできず、私の身体を這いずり回る手に耐える以外なかった。" voices=""/>
		<msg @l="828" char_id="-1" frame_id="-1" name=""
		   text="若さで張りのある乳房が水着越しに黒い手により蹂躙される。" voices=""/>
		<msg @l="830" char_id="0" frame_id="-1" name="美帆" text="『‥‥！？』"
		   voices="miho09970"/>
		<msg @l="832" char_id="-1" frame_id="-1" name="留学生" text="『グッジョーブ、グッジョーブ！』"
		   voices=""/>
		<msg @l="834" char_id="-1" frame_id="-1" name="" text="そして黒い手は白い山の頂を攻めてきた。"
		   voices=""/>
		<msg @l="835" char_id="-1" frame_id="-1" name=""
		   text="頂上に生息する野苺をくりくりと捏ねくりまわしてくる。" voices=""/>
		<msg @l="837" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』"
		   voices="miho00420"/>
		<msg @l="839" char_id="-1" frame_id="-1" name="留学生" text="『イイネ！イイネ！』"
		   voices=""/>
		<msg @l="841" char_id="-1" frame_id="-1" name=""
		   text="黒い手はさらに、下半身の桃山のようなお尻へ侵略の魔の手を広げる。" voices=""/>
		<msg @l="842" char_id="-1" frame_id="-1" name=""
		   text="留学生はもう片方の手で、水着の上から柔らかな曲線美を描く臀部の肉を持ち上げるように揉んで、撫で回してきた。" voices=""/>
		<msg @l="844" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥っ‥‥‥。』"
		   voices="miho09930"/>
		<msg @l="846" char_id="-1" frame_id="-1" name="留学生" text="『オゥ、グッジョーブ！』"
		   voices=""/>
		<msg @l="848" char_id="-1" frame_id="-1" name=""
		   text="留学生はお尻を触っていた黒い手を秘部にまわしこんできて、女陰の中心をグリグリと圧迫する。すると水着が女唇の間に食い込まれる。"
		   voices=""/>
		<msg @l="850" char_id="-1" frame_id="-1" name="" text="ぐにゅ、むにゅ。" voices=""/>
		<msg @l="852" char_id="0" frame_id="-1" name="美帆" text="『やだ‥‥そこは‥‥‥。』"
		   voices="miho00410"/>
		<msg @l="854" char_id="-1" frame_id="-1" name="留学生" text="『プッシー！プッシー！』"
		   voices=""/>
		<msg @l="856" char_id="-1" frame_id="-1" name=""
		   text="蜜口を撫でていた指の腹がスルリと前に滑った途端、上側にある突起へと添えられた。" voices=""/>
		<msg @l="858" char_id="0" frame_id="-1" name="美帆" text="『んっっ！』"
		   voices="miho00450"/>
		<msg @l="860" char_id="-1" frame_id="-1" name="留学生" text="『オォウ‥‥ナイスプッシー‥‥。』"
		   voices=""/>
		<msg @l="862" char_id="0" frame_id="-1" name="美帆" text="『あ、いやっ‥‥。』"
		   voices="miho03880"/>
		<msg @l="864" char_id="-1" frame_id="-1" name=""
		   text="黒人留学生の指が水着の上から強引に秘部に入り込み‥‥中指でバイブレーションを加えた。" voices=""/>
		<msg @l="865" char_id="-1" frame_id="-1" name=""
		   text="私はそれに身をよじって抵抗しようとするが、すぐにハッとなって固まる。" voices=""/>
		<msg @l="866" char_id="-1" frame_id="-1" name=""
		   text="抵抗してはいつまで終わらない‥‥放っておけば他の女の子の所にいくはずだ‥‥そう、自分に言い聞かせる。" voices=""/>
		<msg @l="868" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』"
		   voices="miho03890"/>
		<msg @l="870" char_id="-1" frame_id="-1" name="留学生" text="『ヘーイ、オープンオープン‥‥。』"
		   voices=""/>
		<msg @l="872" char_id="-1" frame_id="-1" name=""
		   text="そう言って彼はフトモモの間に腕を入れて‥‥足を開かせようとする。" voices=""/>
		<msg @l="874" char_id="0" frame_id="-1" name="美帆" text="『あ‥‥んんっ。』"
		   voices="miho03900"/>
		<msg @l="876" char_id="-1" frame_id="-1" name=""
		   text="私は‥‥さすがに逆らおうとして足に力を入れると、プールの底で足をすべらせ、はからずも足を開いて彼の手を受け入れる形になった。"
		   voices=""/>
		<msg @l="878" char_id="-1" frame_id="-1" name="留学生" text="『オーケーイ。ナイスデース‥‥。』"
		   voices=""/>
		<msg @l="880" char_id="0" frame_id="-1" name="美帆" text="『え、私は別に‥‥そんな。』"
		   voices="miho03910"/>
		<msg @l="882" char_id="-1" frame_id="-1" name="" text="くりっ。" voices=""/>
		<msg @l="883" char_id="-1" frame_id="-1" name="" text="言葉と同時に、突起が強く爪弾かれる。"
		   voices=""/>
		<msg @l="885" char_id="0" frame_id="-1" name="美帆" text="『んっっ！』"
		   voices="miho00450"/>
		<msg @l="887" char_id="-1" frame_id="-1" name=""
		   text="私は、思わず漏れそうになった声を必死に押し殺す。" voices=""/>
		<msg @l="888" char_id="-1" frame_id="-1" name="" text="電流が‥‥走ったみたいだった。"
		   voices=""/>
		<msg @l="890" char_id="-1" frame_id="-1" name="留学生" text="『ナーイス！プッシー！！』"
		   voices=""/>
		<msg @l="892" char_id="-1" frame_id="-1" name=""
		   text="留学生はそう言いながらアソコを指で撫で上げ、私のお尻に腰を擦り付けてきた。" voices=""/>
		<msg @l="893" char_id="-1" frame_id="-1" name="留学生"
		   text="『ミーノコックモ‥‥ナイスデースネー。』" voices=""/>
		<msg @l="895" char_id="0" frame_id="-1" name="美帆" text="『あ‥‥。』"
		   voices="miho03920"/>
		<msg @l="897" char_id="-1" frame_id="-1" name=""
		   text="黒い手は、私の手を取り、自分の股間へ押し付ける。" voices=""/>
		<msg @l="898" char_id="-1" frame_id="-1" name=""
		   text="黒人留学生のソコは‥‥驚くほど大きく硬くなっていた。" voices=""/>
		<msg @l="899" char_id="-1" frame_id="-1" name=""
		   text="男の人のモノを初めて触ったショックで、思わず手をひっこめる。" voices=""/>
		<msg @l="901" char_id="-1" frame_id="-1" name="留学生"
		   text="『オーウ、ココジャネクスト、ムリネ‥‥。』" voices=""/>
		<msg @l="903" char_id="0" frame_id="-1" name="美帆" text="『え‥‥それってどういう‥‥‥。』"
		   voices="miho03930"/>
		<msg @l="905" char_id="-1" frame_id="-1" name="留学生" text="『ヘイカモン、カモーン。』"
		   voices=""/>
		<msg @l="907" char_id="0" frame_id="-1" name="美帆" text="『あ、ちょっと‥‥‥。』"
		   voices="miho03940"/>
		<clear @l="910" class="all"/>
		<end_scene @l="913"/>
		<label @l="915" id="event_scene55"/>
		<msg @l="917" char_id="-1" frame_id="-1" name=""
		   text="鼻息のあらい黒人留学生に、強引にプールサイドへと引っ張り出される。" voices=""/>
		<msg @l="918" char_id="-1" frame_id="-1" name=""
		   text="周囲の人間が見ているからと何度言っても聞こうとはしない。" voices=""/>
		<msg @l="919" char_id="-1" frame_id="-1" name=""
		   text="黒人留学生の彼に手を引かれてプールを出て行く私の姿を、部員の人達はいぶかしみながら見ていた。" voices=""/>
		<msg @l="921" char_id="0" frame_id="-1" name="美帆"
		   text="(亜季奈は‥‥‥良かった、ちょうど泳いでるところね)" voices="miho03950"/>
		<msg @l="923" char_id="-1" frame_id="-1" name="" text="亜季奈に見られるのはマズイ。"
		   voices=""/>
		<msg @l="924" char_id="-1" frame_id="-1" name=""
		   text="亜季奈を巻き込んで、大変な目に合わせる訳にいかない。" voices=""/>
		<wait_chgmv/>
		<bg @l="927" src="bg11"/>
		<msg @l="929" char_id="-1" frame_id="-1" name="留学生" text="『ヘイ、ハリアーップ。』"
		   voices=""/>
		<char @l="932" id="miho" pos="auto" src="miho166"/>
		<msg @l="934" char_id="0" frame_id="-1" name="美帆" text="『あ‥‥。』"
		   voices="miho03960"/>
		<msg @l="936" char_id="-1" frame_id="-1" name=""
		   text="留学生の彼に手を引かれたまま、更衣室に連れて来られる。" voices=""/>
		<msg @l="938" char_id="-1" frame_id="-1" name="留学生" text="『ココナラＯＫネ。』"
		   voices=""/>
		<msg @l="940" char_id="0" frame_id="-1" name="美帆"
		   text="『あ、あの‥‥私‥‥‥別にそんなつもりじゃ‥‥‥。』" voices="miho03970"/>
		<msg @l="942" char_id="-1" frame_id="-1" name="留学生"
		   text="『エンリョハ、ノーサンキューヨ‥‥ハヤク、ミーノコックヲ、サワッテクダサーイ。』" voices=""/>
		<char @l="945" id="miho" pos="auto" src="miho164"/>
		<msg @l="947" char_id="0" frame_id="-1" name="美帆" text="『きゃっ！！』"
		   voices="miho03980"/>
		<msg @l="949" char_id="0" frame_id="-1" name="美帆"
		   text="(あれって‥‥‥‥おち○ちん、だよね？)" voices="miho03990"/>
		<msg @l="951" char_id="0" frame_id="-1" name="美帆"
		   text="(うそ‥‥‥あんなに大きいものなの‥‥‥？)" voices="miho04000"/>
		<msg @l="953" char_id="-1" frame_id="-1" name=""
		   text="躊躇なく水着をずらして、硬くなったそれを取り出す。" voices=""/>
		<msg @l="954" char_id="-1" frame_id="-1" name=""
		   text="もしかすると‥‥男の人のモノが硬くなっているのを直に見たのは、これが初めてかもしれない。" voices=""/>
		<msg @l="956" char_id="-1" frame_id="-1" name="留学生" text="『カモーン。』" voices=""/>
		<char @l="960" id="miho" pos="auto" src="miho165"/>
		<msg @l="962" char_id="0" frame_id="-1" name="美帆" text="『ちょっと‥‥やめっ！？&#32;』"
		   voices="miho04010"/>
		<clear @l="965" class="char"/>
		<msg @l="967" char_id="-1" frame_id="-1" name=""
		   text="腕を引かれ、床に横たわった彼の上に無理やり抱き寄せられる。" voices=""/>
		<msg @l="968" char_id="-1" frame_id="-1" name="" text="ただ‥‥普通に抱き合うのとは少し違う。"
		   voices=""/>
		<msg @l="969" char_id="-1" frame_id="-1" name=""
		   text="彼と私の頭の向きが逆さまになるように‥‥。" voices=""/>
		<msg @l="970" char_id="-1" frame_id="-1" name=""
		   text="‥‥目の前に、硬く屹立したモノが晒されていた。" voices=""/>
		<label @l="973" id="chart_line15"/>
		<wait_chgmv/>
		<ev @l="976" src="ev-055"/>
		<description @l="979" text="強制奉仕"/>
		<bgm @l="982" src="bgm14" volume="1."/>
		<msg @l="984" char_id="0" frame_id="-1" name="美帆" text="『んぐっっ！？&#32;』"
		   voices="miho04020"/>
		<msg @l="986" char_id="-1" frame_id="-1" name=""
		   text="硬いモノが強引に口の中に突き込まれたまま、動くことが出来なかった。" voices=""/>
		<msg @l="987" char_id="-1" frame_id="-1" name=""
		   text="吐き出そうにも肉棒があまりにも長い為、姿勢自体を変えなければ逃げるに逃げられない。" voices=""/>
		<msg @l="988" char_id="-1" frame_id="-1" name=""
		   text="身体を引こうとすると、腰が押し出され喉を突かれる。" voices=""/>
		<msg @l="989" char_id="-1" frame_id="-1" name=""
		   text="頭を肉棒で、腰を手で････２点を固定されていては、さすがに諦めるしかなかった。" voices=""/>
		<msg @l="991" char_id="0" frame_id="-1" name="美帆" text="『んんっ‥‥ん、んんーっ！』"
		   voices="miho04030"/>
		<msg @l="993" char_id="-1" frame_id="-1" name=""
		   text="口腔いっぱいにプールの‥‥塩素の味が広がっていく。" voices=""/>
		<msg @l="994" char_id="-1" frame_id="-1" name=""
		   text="不快感というよりも、息苦しいという方が今は大きい。" voices=""/>
		<msg @l="995" char_id="-1" frame_id="-1" name=""
		   text="とにかく大きくて、硬くて、深くて‥‥息が詰まりそうだ。" voices=""/>
		<msg @l="997" char_id="-1" frame_id="-1" name="留学生" text="『オォウ‥‥オォーウ』"
		   voices=""/>
		<msg @l="999" char_id="-1" frame_id="-1" name="留学生" text="『オウッ‥‥オオーッ！』"
		   voices=""/>
		<msg @l="1001" char_id="0" frame_id="-1" name="美帆" text="『んむぅっ！？』"
		   voices="miho04040"/>
		<msg @l="1003" char_id="-1" frame_id="-1" name=""
		   text="突然、口腔内に押し込まれていたモノが激しい律動をはじめる。" voices=""/>
		<msg @l="1004" char_id="-1" frame_id="-1" name=""
		   text="何事かと思って目を見開くと、彼が腰を動かして下から突き上げていた。" voices=""/>
		<msg @l="1006" char_id="0" frame_id="-1" name="美帆" text="『んんっ、んっ‥‥‥んぐぅ！！』"
		   voices="miho04050"/>
		<msg @l="1008" char_id="-1" frame_id="-1" name="" text="口の中を硬く屹立したモノが行き来する。"
		   voices=""/>
		<msg @l="1009" char_id="-1" frame_id="-1" name=""
		   text="喉の奥を突かれ、私は幾度となくそれを吐き出そうとする。" voices=""/>
		<msg @l="1011" char_id="-1" frame_id="-1" name="留学生" text="『ノーッ！』" voices=""/>
		<msg @l="1013" char_id="-1" frame_id="-1" name=""
		   text="快楽のせいなのか、既にカタコトの日本語すら怪しくなった彼が物凄い剣幕で怒り出す。" voices=""/>
		<msg @l="1014" char_id="-1" frame_id="-1" name=""
		   text="怖くなった私は、慌てて猛り狂った硬直を口に飲み込んだ。" voices=""/>
		<msg @l="1016" char_id="-1" frame_id="-1" name="留学生"
		   text="『オゥッ！&#32;オーケー、オーケー、プッシー‥‥マ○コマ○コ‥‥』" voices=""/>
		<msg @l="1018" char_id="0" frame_id="-1" name="美帆"
		   text="『ん、んんっ‥‥んぐ‥‥‥‥んんんんっ！！』" voices="miho04060"/>
		<msg @l="1020" char_id="-1" frame_id="-1" name=""
		   text="突然水着をずり下ろされ、彼の舌が秘裂の盛り上がりを舐め始めた。" voices=""/>
		<msg @l="1021" char_id="-1" frame_id="-1" name=""
		   text="ヌルヌルした感触が秘唇を這い回って気持ちが悪い。" voices=""/>
		<msg @l="1022" char_id="-1" frame_id="-1" name=""
		   text="快感よりも恐怖心からか、腰から下が痺れたように感覚が麻痺していった。" voices=""/>
		<msg @l="1024" char_id="0" frame_id="-1" name="美帆" text="『んぐっ、ん、ん、くはっ‥‥。』"
		   voices="miho04070"/>
		<msg @l="1026" char_id="0" frame_id="-1" name="美帆"
		   text="『んむぅぅっ‥‥んぐっ‥‥‥ふっ‥‥‥‥。』" voices="miho04080"/>
		<msg @l="1028" char_id="-1" frame_id="-1" name="" text="息が出来ない。" voices=""/>
		<msg @l="1029" char_id="-1" frame_id="-1" name="" text="アゴが‥‥痛い。" voices=""/>
		<msg @l="1030" char_id="-1" frame_id="-1" name=""
		   text="それでもこの苦しみから早く逃れる為なかば自発的に頭を前後に動かし、口いっぱいに膨れあがった怒張をしごきたてる。" voices=""/>
		<msg @l="1032" char_id="-1" frame_id="-1" name="留学生"
		   text="『オオッ、オォッ、オーマイガッ！』" voices=""/>
		<msg @l="1034" char_id="-1" frame_id="-1" name="" text="男が狂ったように声を上げている。"
		   voices=""/>
		<msg @l="1035" char_id="-1" frame_id="-1" name="" text="けれど、私にその言葉は届いていない。"
		   voices=""/>
		<msg @l="1037" char_id="0" frame_id="-1" name="美帆"
		   text="『んぶっ‥‥ん、んんっ‥‥‥んぐっ‥‥んぐぅっ！！』" voices="miho04090"/>
		<msg @l="1039" char_id="0" frame_id="-1" name="美帆"
		   text="『んっ、んんっ‥‥‥あぐっ‥‥‥‥んんんっ！！』" voices="miho04100"/>
		<msg @l="1041" char_id="-1" frame_id="-1" name="留学生" text="『オアーッ！ガアアァッ！！』"
		   voices=""/>
		<msg @l="1043" char_id="0" frame_id="-1" name="美帆" text="『んぶぅっ！？』"
		   voices="miho04110"/>
		<flash @l="1046" count="4" fade="100" image="white"/>
		<wait_chgmv/>
		<ev @l="1048" src="ev-055x1z1"/>
		<msg @l="1050" char_id="-1" frame_id="-1" name=""
		   text="突然、巨大な陰茎が大きく膨らんだかと思った矢先、溜まっていた何かが喉奥で爆発する。" voices=""/>
		<msg @l="1052" char_id="0" frame_id="-1" name="美帆"
		   text="『んぐっ‥‥‥んんっ‥‥‥‥‥ぷあっっ！！』" voices="miho04120"/>
		<msg @l="1054" char_id="-1" frame_id="-1" name="留学生"
		   text="『ノッ、ノーッ！ドリンク、ドリンク！』" voices=""/>
		<msg @l="1056" char_id="-1" frame_id="-1" name=""
		   text="こらえきれず口の端から漏らしそうになるが、それすら彼は許そうとせず、飲み込むことを強要する。" voices=""/>
		<msg @l="1058" char_id="0" frame_id="-1" name="美帆"
		   text="『かはっ‥‥‥げほっ‥‥ごほ、ごほっ！！』" voices="miho04130"/>
		<msg @l="1060" char_id="-1" frame_id="-1" name=""
		   text="息苦しさのあまり、無意識にゴクッゴクッと飲み込む。" voices=""/>
		<msg @l="1061" char_id="-1" frame_id="-1" name=""
		   text="放出が終わり、喉奥からゆっくりと肉棒が引かれる。" voices=""/>
		<msg @l="1062" char_id="-1" frame_id="-1" name=""
		   text="腰を押さえていた手が緩んだ瞬間、反射的に跳ね起き、それを吐き出して激しく咳き込む。" voices=""/>
		<msg @l="1063" char_id="-1" frame_id="-1" name=""
		   text="喉奥に流し込まれた熱い液体が口中からあふれ出す。" voices=""/>
		<msg @l="1065" char_id="0" frame_id="-1" name="美帆" text="『はぁ‥‥はぁ‥‥‥。』"
		   voices="miho04140"/>
		<msg @l="1067" char_id="-1" frame_id="-1" name=""
		   text="唇をぬぐう余裕もなく、ただ大きく深呼吸を繰り返していた。" voices=""/>
		<msg @l="1068" char_id="-1" frame_id="-1" name=""
		   text="息を吸い込むたびに、生臭い匂いで肺がいっぱいになる。" voices=""/>
		<clear @l="1074" class="all"/>
		<msg @l="1076" char_id="-1" frame_id="-1" name="留学生" text="『オッ、オォウ‥‥ベリグー。』"
		   voices=""/>
		<msg @l="1078" char_id="-1" frame_id="-1" name="留学生" text="『ファック、ファックネー。』"
		   voices=""/>
		<msg @l="1080" char_id="-1" frame_id="-1" name=""
		   text="留学生はそう言うと、美帆の秘部に凶悪な肉棒を突き入れてようとしてくる。" voices=""/>
		<msg @l="1082" char_id="0" frame_id="-1" name="美帆" text="『ゃぁ‥‥いゃぁ‥‥‥。』"
		   voices=""/>
		<stopbgm @l="1085" fadeout="1000"/>
		<se @l="1087" buf="1" src="扉を開ける音_金属" volume="1."/>
		<msg @l="1089" char_id="-1" frame_id="-1" name="女子部員Ａ" text="『タオル、タオルー。』"
		   voices=""/>
		<msg @l="1091" char_id="-1" frame_id="-1" name="女子部員Ｂ"
		   text="『早くしなさいよー、練習中なんだからー。』" voices=""/>
		<msg @l="1093" char_id="-1" frame_id="-1" name="留学生"
		   text="『オゥ、ザンネーン。ヒトハイッテキター。』" voices=""/>
		<msg @l="1095" char_id="-1" frame_id="-1" name="留学生" text="『ツヅーキ。ネクストタイム‥‥』"
		   voices=""/>
		<msg @l="1097" char_id="-1" frame_id="-1" name="留学生"
		   text="『ネクスト、ネクスト。タノシーミネ。』" voices=""/>
		<msg @l="1099" char_id="-1" frame_id="-1" name=""
		   text="そう言うと留学生は、入ってきた女子部員に見つからないように更衣室を後にした。" voices=""/>
		<clear @l="1102" class="all"/>
		<end_scene @l="1105"/>
		<wait_chgmv/>
		<bg @l="1108" src="bg11"/>
		<bgm @l="1111" src="bgm03" volume="1."/>
		<description @l="1114" text="水泳コーチ・３日目"/>
		<msg @l="1116" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="1118" char_id="-1" frame_id="-1" name=""
		   text="気付けば‥‥私は更衣室に一人残されていた。" voices=""/>
		<msg @l="1119" char_id="-1" frame_id="-1" name=""
		   text="先ほどまで私の喉を犯していた留学生はもういない。" voices=""/>
		<char @l="1122" id="miho" pos="auto" src="miho165"/>
		<msg @l="1124" char_id="0" frame_id="-1" name="美帆" text="『わたし‥‥。』" voices=""/>
		<msg @l="1126" char_id="-1" frame_id="-1" name="" text="我に返って身体を起こす。"
		   voices=""/>
		<msg @l="1127" char_id="-1" frame_id="-1" name=""
		   text="そこで、ようやく自分が床に倒れていたコトに気付いた。" voices=""/>
		<char @l="1130" id="miho" pos="auto" src="miho064"/>
		<msg @l="1132" char_id="0" frame_id="-1" name="美帆" text="『あ‥‥。』" voices=""/>
		<msg @l="1134" char_id="-1" frame_id="-1" name="" text="唇の端から何かが流れ落ちていく。"
		   voices=""/>
		<msg @l="1135" char_id="-1" frame_id="-1" name=""
		   text="指先ですくいとって見ると‥‥白く濁った液体、だった。" voices=""/>
		<char @l="1138" id="miho" pos="auto" src="miho065"/>
		<msg @l="1140" char_id="0" frame_id="-1" name="美帆"
		   text="『こ、これ‥‥おち○ちんの先から出たやつ‥‥‥。』" voices=""/>
		<msg @l="1142" char_id="0" frame_id="-1" name="美帆" text="『これが‥‥‥精液‥‥‥‥‥？』"
		   voices=""/>
		<msg @l="1144" char_id="-1" frame_id="-1" name=""
		   text="呆然と‥‥指に絡んでいるそれを見つめていた。" voices=""/>
		<msg @l="1145" char_id="-1" frame_id="-1" name=""
		   text="自分が何をされたのか、良くわかっていなかった。" voices=""/>
		<msg @l="1146" char_id="-1" frame_id="-1" name="" text="なんだかとても苦しくて‥‥辛くて。"
		   voices=""/>
		<msg @l="1147" char_id="-1" frame_id="-1" name=""
		   text="その後に残ったものがこの白濁色の液体‥‥。" voices=""/>
		<char @l="1150" id="miho" pos="auto" src="miho066"/>
		<msg @l="1152" char_id="0" frame_id="-1" name="美帆"
		   text="『そっか‥‥‥私‥‥汚されちゃったんだ‥‥‥。』" voices=""/>
		<msg @l="1154" char_id="-1" frame_id="-1" name=""
		   text="ぼんやりとつぶやいて、初めてその言葉の意味を悟る。" voices=""/>
		<msg @l="1156" char_id="0" frame_id="-1" name="美帆" text="『わたし‥‥。』" voices=""/>
		<char @l="1159" id="miho" pos="auto" src="miho165"/>
		<msg @l="1161" char_id="0" frame_id="-1" name="美帆" text="『わたしは‥‥‥う、うぅ‥‥‥‥。』"
		   voices=""/>
		<msg @l="1163" char_id="-1" frame_id="-1" name=""
		   text="誰もいない更衣室で、私は生臭い精液臭にまみれたまま、声を殺して泣いていた。" voices=""/>
		<stopbgm @l="1166" fadeout="1000"/>
		<clear @l="1169" class="all"/>
		<wait_chgmv/>
		<bg @l="1172" src="bg07b"/>
		<bgm @l="1175" src="bgm05" volume="1."/>
		<char @l="1178" id="akina" pos="auto" src="akina014"/>
		<msg @l="1180" char_id="2" frame_id="-1" name="亜季奈" text="『お姉ちゃん、ほんとに大丈夫？』"
		   voices=""/>
		<clear @l="1183" class="char"/>
		<char @l="1185" id="akina" pos="right" src="akina010"/>
		<char @l="1187" id="miho" pos="left" src="miho016"/>
		<msg @l="1189" char_id="0" frame_id="-1" name="美帆" text="『うん‥‥大丈夫。』"
		   voices=""/>
		<char @l="1192" id="miho" pos="left" src="miho116"/>
		<msg @l="1194" char_id="0" frame_id="-1" name="美帆"
		   text="『気にしないで、単なる貧血なんだから‥‥。』" voices=""/>
		<msg @l="1196" char_id="-1" frame_id="-1" name=""
		   text="あの後‥‥私は念入りにシャワーを浴びてからプールに戻った。" voices=""/>
		<msg @l="1197" char_id="-1" frame_id="-1" name=""
		   text="亜季奈には、貧血で気分が悪くなって更衣室で休んでいたと嘘をついて。" voices=""/>
		<char @l="1200" id="akina" pos="right" src="akina011"/>
		<msg @l="1202" char_id="2" frame_id="-1" name="亜季奈" text="『それならいいけどさ～。』"
		   voices=""/>
		<char @l="1205" id="akina" pos="right" src="akina115"/>
		<msg @l="1207" char_id="2" frame_id="-1" name="亜季奈"
		   text="『でも、びっくりしたよ‥‥お姉ちゃんてばいきなりいなくなったかと思ったら真っ青な顔して戻ってくるんだもん。』" voices=""/>
		<msg @l="1209" char_id="0" frame_id="-1" name="美帆" text="『心配かけてごめんね‥‥。』"
		   voices=""/>
		<char @l="1212" id="miho" pos="left" src="miho016"/>
		<msg @l="1214" char_id="0" frame_id="-1" name="美帆" text="『でも‥‥もう大丈夫だから。』"
		   voices=""/>
		<msg @l="1216" char_id="-1" frame_id="-1" name="" text="そうして私は僅かに微笑んでみせる。"
		   voices=""/>
		<msg @l="1217" char_id="-1" frame_id="-1" name="" text="上手く笑えたかどうか‥‥自信はない。"
		   voices=""/>
		<char @l="1220" id="akina" pos="right" src="akina011"/>
		<msg @l="1222" char_id="2" frame_id="-1" name="亜季奈"
		   text="『ん～、さっきより顔色はいいみたいだけど、無理しちゃダメだよ？』" voices=""/>
		<char @l="1225" id="miho" pos="left" src="miho110"/>
		<msg @l="1227" char_id="0" frame_id="-1" name="美帆" text="『わかってる‥‥ありがと。』"
		   voices=""/>
		<char @l="1230" id="akina" pos="right" src="akina111"/>
		<msg @l="1232" char_id="2" frame_id="-1" name="亜季奈" text="『えへへ～。』" voices=""/>
		<msg @l="1234" char_id="2" frame_id="-1" name="亜季奈"
		   text="『それじゃお姉ちゃん、また明日ね。』" voices=""/>
		<char @l="1237" id="miho" pos="left" src="miho016"/>
		<msg @l="1239" char_id="0" frame_id="-1" name="美帆" text="『うん、明日‥‥。』"
		   voices=""/>
		<clear @l="1242" layer="akina"/>
		<clear @l="1244" class="char"/>
		<char @l="1246" id="miho" pos="auto" src="miho115"/>
		<msg @l="1248" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="1250" char_id="0" frame_id="-1" name="美帆"
		   text="(また‥‥余計な嘘が増えちゃったな‥‥‥)" voices=""/>
		<label @l="1253" id="EventLabel_64"/>
		<stopbgm @l="1256" fadeout="1000"/>
		<clear @l="1259" class="all"/>
		<goto @l="1262" cond="!(f.留学生に抵抗したflag&#32;==&#32;1)&#13;&#10;"
		   label="TempLabel_214"/>
		<call @l="1266" target="EventLabel_65@root_akina04a"/>
		<return @l="1267" value="0&#13;&#10;"/>
		<goto @l="1269" label="TempLabel_235"/>
		<label @l="1270" id="TempLabel_214"/>
		<call @l="1275" target="EventLabel_79@root_akina04b"/>
		<return @l="1276" value="0&#13;&#10;"/>
		<label @l="1278" id="TempLabel_235"/>
		<return @l="1283" value=""/>
	</code>
</xscript>
