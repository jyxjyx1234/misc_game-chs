<?xml version="1.0" encoding="utf-8"?>
<xscript>
	<debug editor="&quot;C:\Program&#32;Files&#32;(x86)\sakura\sakura.exe&quot;&#32;&quot;%src%&quot;&#32;-Y=%line%"
	   src="D:\シロップ\町ぐるみの罠＋汚された夏セット版\汚された夏\完成データ\汚された夏\script\text\root_kutuki02a.txt"/>
	<code>
		<label @l="10" id="EventLabel_111"/>
		<description @l="15" text="朽木の奴隷・１日目"/>
		<eval @l="17" expr="f.numDay=5&#13;&#10;"/>
		<msgshow @l="19" show="false"/>
		<wait_chgmv/>
		<bg @l="21" src="day05" time="2000"/>
		<wait @l="23" time="500"/>
		<wait_chgmv/>
		<bg @l="25" src="black" time="2000"/>
		<msgshow @l="27" show="true"/>
		<wait_chgmv/>
		<bg @l="30" src="bg09"/>
		<bgm @l="33" src="bgm02" volume="1."/>
		<char @l="36" id="miho" pos="auto" src="miho010"/>
		<msg @l="38" char_id="-1" frame_id="-1" name="女友達" text="『さーて、今日は何食べようか？』"
		   voices=""/>
		<msg @l="40" char_id="-1" frame_id="-1" name=""
		   text="二限が終わり昼休みになると必ず交わされる、会話。" voices=""/>
		<msg @l="41" char_id="-1" frame_id="-1" name=""
		   text="それを今日もつぶやきながら、講義友達の子が大きく背伸びをする。" voices=""/>
		<char @l="44" id="miho" pos="auto" src="miho011"/>
		<msg @l="46" char_id="0" frame_id="-1" name="美帆"
		   text="『んー‥‥昨日は学食だったし、今日は外にでもいく？』" voices=""/>
		<msg @l="48" char_id="-1" frame_id="-1" name="女友達"
		   text="『坂の下んとこって、なんか新しいセット始めてなかったっけ？』" voices=""/>
		<char @l="51" id="miho" pos="auto" src="miho110"/>
		<msg @l="53" char_id="0" frame_id="-1" name="美帆"
		   text="『どうかなぁ‥‥最近行ってないからわかんない。』" voices=""/>
		<msg @l="55" char_id="-1" frame_id="-1" name="女友達" text="『んじゃ、久々に行ってみっかね？』"
		   voices=""/>
		<char @l="58" id="miho" pos="auto" src="miho111"/>
		<msg @l="60" char_id="0" frame_id="-1" name="美帆" text="『そうだね。』" voices=""/>
		<se @l="63" buf="1" src="携帯電話呼び出し音02（ループ）" volume="1."/>
		<stopbgm @l="66" fadeout="1000"/>
		<char @l="69" id="miho" pos="auto" src="miho014"/>
		<msg @l="71" char_id="0" frame_id="-1" name="美帆" text="『‥‥！』" voices=""/>
		<msg @l="73" char_id="-1" frame_id="-1" name=""
		   text="私たちが歩き出そうとしたその瞬間、バッグの中で携帯電話が鳴る。" voices=""/>
		<msg @l="74" char_id="-1" frame_id="-1" name=""
		   text="ただ、どうやらそれは「電話」ではなかったらしく二回ほど鳴ってすぐに着信音は切れてしまった。" voices=""/>
		<bgm @l="77" src="bgm02" volume="1."/>
		<msg @l="79" char_id="-1" frame_id="-1" name="女友達" text="『およ、ワン切り？』"
		   voices=""/>
		<char @l="82" id="miho" pos="auto" src="miho016"/>
		<msg @l="84" char_id="0" frame_id="-1" name="美帆"
		   text="『そ、そうかなぁ‥‥最近、こういうの減ったと思ったのに‥‥‥。』" voices=""/>
		<msg @l="86" char_id="-1" frame_id="-1" name=""
		   text="私は携帯電話を取り出して、ディスプレイを見る。" voices=""/>
		<msg @l="87" char_id="-1" frame_id="0" name="" text="「メール着信あり」" voices=""/>
		<msg @l="88" char_id="-1" frame_id="-1" name=""
		   text="ディスプレイに表示された文字を見て‥‥私は微かなめまいを感じた。" voices=""/>
		<bgm @l="91" src="bgm15" volume="1."/>
		<msg @l="93" char_id="-1" frame_id="-1" name="女友達" text="『どした？』" voices=""/>
		<msg @l="95" char_id="0" frame_id="-1" name="美帆"
		   text="『あ、うん‥‥ワン切りじゃなくてメールだったよ。』" voices=""/>
		<msg @l="97" char_id="-1" frame_id="-1" name="女友達" text="『なんだ～、メル友？』"
		   voices=""/>
		<msg @l="99" char_id="0" frame_id="-1" name="美帆" text="『ま、まあ‥‥そんな感じかな。』"
		   voices=""/>
		<msg @l="101" char_id="-1" frame_id="-1" name="女友達"
		   text="『このやろ～、いつの間に抜け駆けしたんだ～？』" voices=""/>
		<msg @l="103" char_id="0" frame_id="-1" name="美帆"
		   text="『そ、そんなんじゃないって‥‥‥そんなんじゃ。』" voices=""/>
		<msg @l="105" char_id="-1" frame_id="-1" name="女友達"
		   text="『ま、いーや。さっさと中身確かめなよ。』" voices=""/>
		<msg @l="107" char_id="-1" frame_id="-1" name="女友達"
		   text="『昼飯のお誘いだったら、一緒に行こって言えばいいしさ。』" voices=""/>
		<msg @l="109" char_id="0" frame_id="-1" name="美帆" text="『う、うん‥‥。』" voices=""/>
		<char @l="112" id="miho" pos="auto" src="miho110"/>
		<se @l="115" buf="1" src="携帯ボタン押下音" volume="1."/>
		<msg @l="117" char_id="-1" frame_id="-1" name=""
		   text="微かに息を飲み、着信したばかりのメールを表示してみる。" voices=""/>
		<msg @l="118" char_id="-1" frame_id="-1" name="" text="もしかしたら違うメールかもしれない。"
		   voices=""/>
		<msg @l="119" char_id="-1" frame_id="-1" name="" text="そんな期待を‥‥抱きながら。"
		   voices=""/>
		<msg @l="121" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<char @l="124" id="miho" pos="auto" src="miho116"/>
		<msg @l="126" char_id="0" frame_id="-1" name="美帆" text="『‥‥っ‥。』" voices=""/>
		<msg @l="128" char_id="-1" frame_id="-1" name="女友達" text="『どーだった？』"
		   voices=""/>
		<char @l="131" id="miho" pos="auto" src="miho016"/>
		<msg @l="133" char_id="0" frame_id="-1" name="美帆" text="『‥‥ごめん、私お昼パスする。』"
		   voices=""/>
		<msg @l="135" char_id="-1" frame_id="-1" name="女友達"
		   text="『なんだ、そんな急用なメールだったん？』" voices=""/>
		<msg @l="137" char_id="0" frame_id="-1" name="美帆"
		   text="『うん‥‥ちょっと、行かなくちゃいけなくなったから。』" voices=""/>
		<msg @l="139" char_id="-1" frame_id="-1" name="女友達" text="『行くって、どこに？』"
		   voices=""/>
		<msg @l="141" char_id="0" frame_id="-1" name="美帆" text="『ちょっと‥‥ね。』"
		   voices=""/>
		<msg @l="143" char_id="0" frame_id="-1" name="美帆"
		   text="『ゴメン、この埋め合わせは今度するから。』" voices=""/>
		<msg @l="145" char_id="-1" frame_id="-1" name="女友達"
		   text="『なんだよ、連れないやっちゃなー。』" voices=""/>
		<msg @l="147" char_id="0" frame_id="-1" name="美帆" text="『ほんとゴメン‥‥。』"
		   voices=""/>
		<msg @l="149" char_id="-1" frame_id="-1" name="女友達"
		   text="『ったく、今度ドーナツおごらすからなー。』" voices=""/>
		<msg @l="151" char_id="-1" frame_id="-1" name=""
		   text="そう言って笑いながら、講義友達の子が去っていく。" voices=""/>
		<msg @l="152" char_id="-1" frame_id="-1" name=""
		   text="私はその背中に手を振りながら‥‥もう一度、携帯電話のディスプレイに表示されたその文字に視線を走らせる。" voices=""/>
		<msg @l="153" char_id="-1" frame_id="0" name="" text="「件名：教授より」" voices=""/>
		<msg @l="154" char_id="-1" frame_id="0" name="" text="「本文：今すぐ教授室に来ること」"
		   voices=""/>
		<char @l="157" id="miho" pos="auto" src="miho116"/>
		<msg @l="159" char_id="0" frame_id="-1" name="美帆" text="『行かなくちゃ‥‥。』"
		   voices=""/>
		<msg @l="161" char_id="0" frame_id="-1" name="美帆" text="『そうだよね‥‥‥私、愛人だもんね。』"
		   voices=""/>
		<msg @l="163" char_id="-1" frame_id="-1" name="" text="私は‥‥ゆっくりと部屋へ歩き始めた。"
		   voices=""/>
		<stopbgm @l="166" fadeout="1000"/>
		<clear @l="169" class="all"/>
		<msgshow @l="171" show="true"/>
		<wait_chgmv/>
		<bg @l="174" src="bg12"/>
		<bgm @l="177" src="bgm03" volume="1."/>
		<char @l="180" id="miho" pos="auto" src="miho116"/>
		<msg @l="182" char_id="0" frame_id="-1" name="美帆" text="『‥‥次の講義で、ですか？』"
		   voices=""/>
		<clear @l="185" class="char"/>
		<char @l="187" id="miho" pos="right" src="miho116"/>
		<char @l="189" id="kutsu" pos="left" src="kutsu010"/>
		<msg @l="191" char_id="-1" frame_id="-1" name="朽木"
		   text="『ああ、キミは確か私の講義を受講していたハズだな？』" voices=""/>
		<msg @l="193" char_id="0" frame_id="-1" name="美帆" text="『はい‥‥そうですけど‥‥‥。』"
		   voices=""/>
		<msg @l="195" char_id="-1" frame_id="-1" name=""
		   text="メールでの呼び出しに応じて教授室へと赴いた私を待っていたのは、教授のお相手などではなくただの質問。" voices=""/>
		<msg @l="197" char_id="-1" frame_id="-1" name="朽木" text="『なに、ちょっとした確認だよ。』"
		   voices=""/>
		<msg @l="199" char_id="0" frame_id="-1" name="美帆" text="『はあ‥‥。』" voices=""/>
		<msg @l="201" char_id="-1" frame_id="-1" name="朽木"
		   text="『ああそれと‥‥少し耳を貸したまえ。』" voices=""/>
		<char @l="204" id="miho" pos="right" src="miho014"/>
		<msg @l="206" char_id="0" frame_id="-1" name="美帆" text="『え‥‥あ、はい‥‥。』"
		   voices=""/>
		<clear @l="209" class="char"/>
		<char @l="211" id="miho" pos="auto" src="miho116"/>
		<char @l="213" id="kutsu" pos="left" src="kutsu010"/>
		<msg @l="216" char_id="-1" frame_id="-1" name=""
		   text="私は言われた通り、朽木教授の傍らに寄って少し背伸びをする。" voices=""/>
		<msg @l="217" char_id="-1" frame_id="-1" name=""
		   text="そうしないと‥‥彼の口元に耳が届かないのだ。" voices=""/>
		<msg @l="219" char_id="-1" frame_id="-1" name="朽木"
		   text="『これから私が言うことをしっかり聞いて‥‥必ず守りたまえ。』" voices=""/>
		<msg @l="221" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<clear @l="224" class="all"/>
		<wait_chgmv/>
		<bg @l="227" src="bg12"/>
		<char @l="230" id="miho" pos="right" src="miho116"/>
		<char @l="233" id="kutsu" pos="left" src="kutsu010"/>
		<msg @l="235" char_id="-1" frame_id="-1" name="朽木" text="『‥‥以上だ、できるな？』"
		   voices=""/>
		<msg @l="237" char_id="0" frame_id="-1" name="美帆"
		   text="『はい‥‥出来ると思います、けど‥‥‥‥。』" voices=""/>
		<msg @l="239" char_id="-1" frame_id="-1" name="朽木" text="『ならば結構。』" voices=""/>
		<clear @l="242" class="char"/>
		<char @l="244" id="miho" pos="auto" src="miho116"/>
		<msg @l="246" char_id="-1" frame_id="-1" name=""
		   text="そっけなくそう言うと、教授はそのまま自分の椅子に腰を下ろしてしまう。" voices=""/>
		<msg @l="248" char_id="0" frame_id="-1" name="美帆"
		   text="『あ、あの‥‥それで私‥‥‥‥‥これからどうすればいいですか？』" voices=""/>
		<msg @l="250" char_id="-1" frame_id="-1" name="朽木" text="『ああ、今は戻っても構わんよ。』"
		   voices=""/>
		<msg @l="252" char_id="-1" frame_id="-1" name="朽木"
		   text="『但し、次の講義が始まる前に必ず指示どおりの場所に居たまえ。』" voices=""/>
		<char @l="255" id="miho" pos="auto" src="miho015"/>
		<msg @l="257" char_id="0" frame_id="-1" name="美帆" text="『は、はい‥‥‥失礼します。』"
		   voices=""/>
		<clear @l="260" class="all"/>
		<msgshow @l="262" show="true"/>
		<wait_chgmv/>
		<bg @l="265" src="bg09"/>
		<char @l="268" id="miho" pos="auto" src="miho116"/>
		<msg @l="270" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="272" char_id="-1" frame_id="-1" name=""
		   text="教授室を出た私は、朽木教授の指示の意味が分からず戸惑っていた。" voices=""/>
		<msg @l="274" char_id="0" frame_id="-1" name="美帆" text="『指示‥‥か。』" voices=""/>
		<msg @l="276" char_id="0" frame_id="-1" name="美帆"
		   text="『よくわからないけど‥‥‥とにかく言われた通りにしないと。』" voices=""/>
		<clear @l="279" class="char"/>
		<msg @l="281" char_id="-1" frame_id="-1" name=""
		   text="私は朽木教授から言われた場所へ向かっていった。" voices=""/>
		<stopbgm @l="284" fadeout="1000"/>
		<clear @l="287" class="all"/>
		<msgshow @l="289" show="true"/>
		<wait_chgmv/>
		<bg @l="292" src="bg08m1"/>
		<bgm @l="295" src="bgm02" volume="1."/>
		<msg @l="297" char_id="-1" frame_id="-1" name="朽木"
		   text="『えー、今日は抜き打ちでテストをする。』" voices=""/>
		<msg @l="299" char_id="-1" frame_id="-1" name="学生Ａ" text="『うそ、マジかよー！』"
		   voices=""/>
		<msg @l="301" char_id="-1" frame_id="-1" name="学生Ｂ"
		   text="『抜き打ちテストなんて、義務教育じゃねーんだからよ。』" voices=""/>
		<msg @l="303" char_id="-1" frame_id="-1" name="学生Ｃ"
		   text="『せんせー、これ、単位に関係あるんですか？』" voices=""/>
		<msg @l="305" char_id="-1" frame_id="-1" name=""
		   text="講堂に響いた朽木教授の「テスト」という言葉に対して、複数の学生たちが一斉にブーイングや疑問といったものを浴びせ掛ける。"
		   voices=""/>
		<msg @l="307" char_id="-1" frame_id="-1" name="朽木"
		   text="『もちろんこのテストが悪ければ単位に響く。しっかりやれよ。』" voices=""/>
		<msg @l="309" char_id="-1" frame_id="-1" name="学生Ａ" text="『げ、洒落になんねーよ。』"
		   voices=""/>
		<msg @l="311" char_id="-1" frame_id="-1" name="学生Ｂ"
		   text="『ただでさえレポートばっかなのによー。』" voices=""/>
		<msg @l="313" char_id="-1" frame_id="-1" name="朽木"
		   text="『教科書や資料は幾ら見ても構わん、ただしカンニングは厳禁だぞ。』" voices=""/>
		<msg @l="315" char_id="-1" frame_id="-1" name=""
		   text="学生たちのぼやきなどまったく意に介さないように、朽木教授は淡々とテストの説明を始める。" voices=""/>
		<msg @l="316" char_id="-1" frame_id="-1" name=""
		   text="次いで用意してあったテスト用紙を最前列の人間へと適当に渡すと、それを後ろの人間に流すように促してから‥‥自分は教壇のイスに座った。"
		   voices=""/>
		<bgm @l="319" src="bgm09" volume="1."/>
		<msg @l="321" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="323" char_id="-1" frame_id="-1" name=""
		   text="私は‥‥それを教壇の隙間から覗くような形で眺めている。" voices=""/>
		<msg @l="324" char_id="-1" frame_id="-1" name=""
		   text="そう、私はいまこの講堂にある‥‥教壇の中に身を潜めていた。" voices=""/>
		<msg @l="326" char_id="0" frame_id="-1" name="美帆"
		   text="(教授‥‥どうしてこんな所に私を‥‥‥‥？)" voices=""/>
		<msg @l="328" char_id="-1" frame_id="-1" name=""
		   text="講義が始まる１５分ほど前から‥‥私はまだ誰も来ていない講堂にそっと訪れて、この教壇の下へと身を隠していた。" voices=""/>
		<msg @l="329" char_id="-1" frame_id="-1" name=""
		   text="それが‥‥朽木教授が私に出した「指示」だった。" voices=""/>
		<msg @l="331" char_id="-1" frame_id="-1" name="朽木" text="『仲根クン‥‥聞こえるかね。』"
		   voices=""/>
		<msg @l="333" char_id="-1" frame_id="-1" name="" text="教授は教壇に肘を付いて、私に囁きかける。"
		   voices=""/>
		<msg @l="334" char_id="-1" frame_id="-1" name=""
		   text="広い講堂では‥‥その囁きは最前列の人にも届いていないようだ。" voices=""/>
		<msg @l="336" char_id="0" frame_id="-1" name="美帆" text="『はい‥‥聞こえています。』"
		   voices=""/>
		<msg @l="338" char_id="-1" frame_id="-1" name="朽木"
		   text="『安心したまえ、キミはテストを受けずとも単位をあげよう。』" voices=""/>
		<msg @l="340" char_id="-1" frame_id="-1" name="朽木"
		   text="『なんなら‥‥一度も講義に出なくともキミの単位は保証する。』" voices=""/>
		<msg @l="342" char_id="0" frame_id="-1" name="美帆"
		   text="『あ、ありがとうございます‥‥でも、どうしてこんなことを‥‥‥‥？』" voices=""/>
		<msg @l="344" char_id="-1" frame_id="-1" name="朽木"
		   text="『わからぬかね？&#32;こういうことだよ。』" voices=""/>
		<msg @l="346" char_id="-1" frame_id="-1" name=""
		   text="そう言って、教授はズボンのチャックに手をかけてゆっくりと下ろす。" voices=""/>
		<msg @l="347" char_id="-1" frame_id="-1" name="" text="私は‥‥目を背けた。" voices=""/>
		<msg @l="349" char_id="-1" frame_id="-1" name="朽木"
		   text="『キミの口で、私のモノをしゃぶってくれ。』" voices=""/>
		<msg @l="351" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="353" char_id="-1" frame_id="-1" name=""
		   text="私は、そのあまりにも醜い欲の物体に嫌悪感が走った。" voices=""/>
		<msg @l="354" char_id="-1" frame_id="-1" name=""
		   text="ましてやこの股間に潜む悪魔に、自分の処女を奪われたのである。" voices=""/>
		<msg @l="356" char_id="-1" frame_id="-1" name="朽木"
		   text="『どうした？&#32;キミは断らない、そうだろう？』" voices=""/>
		<msg @l="358" char_id="0" frame_id="-1" name="美帆" text="『････っ････。』"
		   voices=""/>
		<msg @l="360" char_id="-1" frame_id="-1" name=""
		   text="目の前の凶器に哀しみと疎ましさがこみあげてくる。" voices=""/>
		<msg @l="361" char_id="-1" frame_id="-1" name="" text="しかし、今の私には従うほかなかった。"
		   voices=""/>
		<msg @l="363" char_id="0" frame_id="-1" name="美帆" text="『････････はい。』"
		   voices=""/>
		<clear @l="366" class="all"/>
		<label @l="369" id="event_scene12"/>
		<msg @l="371" char_id="-1" frame_id="-1" name="朽木"
		   text="『つい昨日まで処女だったキミに経験があるとは思っていない。』" voices=""/>
		<msg @l="373" char_id="-1" frame_id="-1" name="朽木"
		   text="『上手くやろうなどと考えず私の言う通りにしなさい。』" voices=""/>
		<msg @l="375" char_id="0" frame_id="-1" name="美帆" text="『わかり‥‥ました。』"
		   voices=""/>
		<msg @l="377" char_id="-1" frame_id="-1" name=""
		   text="私はたどたどしく答えると、ズボンから垂れ下がったモノを‥‥ゆっくりと唇をすべらせ口に咥え込んで行く。" voices=""/>
		<label @l="380" id="chart_line43"/>
		<wait_chgmv/>
		<ev @l="383" src="ev-012"/>
		<description @l="386" text="教壇の下のペット"/>
		<eval @l="388" expr="f.numDay=5&#13;&#10;"/>
		<bgm @l="391" src="bgm14" volume="1."/>
		<msg @l="393" char_id="0" frame_id="-1" name="美帆" text="『んっ‥‥。』"
		   voices="miho07240"/>
		<msg @l="395" char_id="-1" frame_id="-1" name=""
		   text="初めて口内に咥えたそれに‥‥思わず吐き気がした。" voices=""/>
		<msg @l="397" char_id="-1" frame_id="-1" name="朽木" text="『では、まずは勃たせてもらおうか。』"
		   voices=""/>
		<msg @l="399" char_id="-1" frame_id="-1" name="朽木"
		   text="『咥えたまま唇と舌を動かして、しゃぶれば良い。』" voices=""/>
		<msg @l="401" char_id="0" frame_id="-1" name="美帆" text="『ふぁ‥‥い‥‥‥‥‥んっ‥‥‥。』"
		   voices="miho07250"/>
		<msg @l="403" char_id="-1" frame_id="-1" name=""
		   text="言われるまま、私はふにゃっとした柔らかな肉棒を口の中で転がす。" voices=""/>
		<msg @l="404" char_id="-1" frame_id="-1" name=""
		   text="そのような経験のない私には、小尿をする器官を口に咥えるなんておぞましい行為にしか思えない。" voices=""/>
		<msg @l="405" char_id="-1" frame_id="-1" name=""
		   text="このようなことが気持ちいいと強要する男性は理不尽にしか思えなかった。" voices=""/>
		<msg @l="407" char_id="0" frame_id="-1" name="美帆" text="『んんっ‥‥。』"
		   voices="miho07310"/>
		<msg @l="409" char_id="-1" frame_id="-1" name=""
		   text="そうしてしばらく唇と舌先でしゃぶっていると、それまで柔らかかった陰茎は次第に硬さと体積を増して、徐々に私の口内を圧迫するようになった。"
		   voices=""/>
		<msg @l="410" char_id="-1" frame_id="-1" name=""
		   text="ジワリジワリと頭をもたげ、見る間に硬直した。" voices=""/>
		<msg @l="412" char_id="0" frame_id="-1" name="美帆"
		   text="『ん、はっ‥‥‥あの‥‥‥‥大きく、なりました‥‥‥‥。』" voices="miho07260"/>
		<msg @l="414" char_id="-1" frame_id="-1" name=""
		   text="硬く膨張したそれを口内から吐き出して、私は大きく深呼吸をする。" voices=""/>
		<msg @l="415" char_id="-1" frame_id="-1" name=""
		   text="つい先ほどまで私の舌で舐られていた肉棒は唾液でてらてらと光り、心なしかヒクついているように見えた。" voices=""/>
		<msg @l="417" char_id="-1" frame_id="-1" name="朽木"
		   text="『そのまま、唇と舌を使ってしゃぶり続けたまえ。』" voices=""/>
		<msg @l="419" char_id="-1" frame_id="-1" name="朽木"
		   text="『唇で締め付けて上下に擦るのも忘れぬようにな。』" voices=""/>
		<msg @l="421" char_id="-1" frame_id="-1" name=""
		   text="呼吸を整える間もなく教授は次の指示を出して私の頭を肉茎に引き寄せる。" voices=""/>
		<msg @l="423" char_id="0" frame_id="-1" name="美帆"
		   text="『は‥‥はいっ‥‥‥‥あ、んんっ‥‥‥‥。』" voices="miho07270"/>
		<msg @l="425" char_id="-1" frame_id="-1" name=""
		   text="自分の身体を汚した悪魔を舐めるなんて‥‥頭では別のことを考えながら、しゃぶり続ける。" voices=""/>
		<msg @l="427" char_id="0" frame_id="-1" name="美帆"
		   text="『んむっ‥‥‥‥んっ‥‥んっ‥‥‥‥‥ちゅぷっ‥‥‥‥‥。』" voices="miho07280"/>
		<msg @l="428" char_id="-1" frame_id="-1" name=""
		   text="私は、ゆっくりと‥‥唾液に濡れたそれを再び口内へ咥え込んでいく。" voices=""/>
		<msg @l="429" char_id="-1" frame_id="-1" name=""
		   text="肉の塊は青太い血管を浮かし、ビクンビクンと脈うっている。" voices=""/>
		<msg @l="431" char_id="0" frame_id="-1" name="美帆" text="『んふっ‥‥‥んんっ‥‥‥‥。』"
		   voices="miho07290"/>
		<msg @l="433" char_id="-1" frame_id="-1" name=""
		   text="口内へ咥え込んだ肉棒を、私は懸命に舌先で奉仕する。" voices=""/>
		<msg @l="434" char_id="-1" frame_id="-1" name=""
		   text="とはいえ、何処が感じるかというのを知らない私はただ口内で舌を動かすだけで精一杯である。" voices=""/>
		<msg @l="436" char_id="-1" frame_id="-1" name="朽木"
		   text="『フフフ‥‥ペニスにキスをしても気持ちよくはならんぞ。』" voices=""/>
		<msg @l="438" char_id="-1" frame_id="-1" name="朽木"
		   text="『唾液をまぶしながら先端に舌を絡めたまえ。』" voices=""/>
		<msg @l="440" char_id="0" frame_id="-1" name="美帆"
		   text="『ちゅぷっ‥‥んっ‥‥‥んんっ‥‥‥‥んむっ‥‥‥‥。』" voices="miho07300"/>
		<msg @l="442" char_id="-1" frame_id="-1" name="朽木" text="『そう、そんな感じだ。』"
		   voices=""/>
		<msg @l="444" char_id="0" frame_id="-1" name="美帆" text="『んんっ‥‥。』"
		   voices="miho07310"/>
		<msg @l="446" char_id="-1" frame_id="-1" name=""
		   text="私は言われるまま亀頭に舌を絡めて唇を締め付ける。" voices=""/>
		<msg @l="447" char_id="-1" frame_id="-1" name=""
		   text="強靭な肉の先端部分を呑み込むような形となった。" voices=""/>
		<msg @l="449" char_id="0" frame_id="-1" name="美帆"
		   text="『んぷっ‥‥んっ、んんっ‥‥‥んぐっ‥‥‥ちゅぷっ‥‥‥。』" voices="miho07320"/>
		<msg @l="450" char_id="0" frame_id="-1" name="美帆"
		   text="『あふ‥‥‥んぐっ‥‥‥‥んっ、んっ、んっ‥‥‥‥。』" voices="miho07330"/>
		<msg @l="452" char_id="0" frame_id="-1" name="美帆"
		   text="『んん‥‥‥んぐっ、んっ‥‥‥‥んぷっ‥‥ちゅ、ちゅるるっ。』" voices="miho07340"/>
		<msg @l="454" char_id="-1" frame_id="-1" name=""
		   text="大きくそそり立った肉幹を中程まで飲み込んだ後、引き抜いて先端の鈴口を吸う。" voices=""/>
		<msg @l="455" char_id="-1" frame_id="-1" name="" text="息苦しさで目の前がぼうっとした。"
		   voices=""/>
		<msg @l="456" char_id="-1" frame_id="-1" name=""
		   text="それでも口内による奉仕を中断するわけには行かず、私は少しでも早く朽木教授が満足してくれるようにとしゃぶり続ける。" voices=""/>
		<msg @l="458" char_id="0" frame_id="-1" name="美帆"
		   text="『んっ、んっ、んっ‥‥‥んぷっ‥‥‥んふっ‥‥‥‥。』" voices="miho07350"/>
		<msg @l="460" char_id="-1" frame_id="-1" name=""
		   text="教授のソレは私の唇による胴茎への快美感のためか、太ミミズのような血管にますます淫血の流れが速くなる。" voices=""/>
		<msg @l="462" char_id="0" frame_id="-1" name="美帆"
		   text="『ちゅぷっ‥‥‥ちゅ、ぷ‥‥‥あふっ‥‥‥んっ、んんっ‥‥‥。』" voices="miho07360"/>
		<msg @l="464" char_id="-1" frame_id="-1" name=""
		   text="唇で肉棒をしごくたび、口の端から溢れ出した唾液がこぼれて筋を作る。" voices=""/>
		<msg @l="465" char_id="-1" frame_id="-1" name=""
		   text="私はそれをぬぐう事もなく‥‥ただ、黙々と唇をすべらせる。" voices=""/>
		<msg @l="467" char_id="-1" frame_id="-1" name="朽木"
		   text="『ああ‥‥いいぞ、もっと強く吸いながらしごき上げるのを忘れるな。』" voices=""/>
		<msg @l="469" char_id="0" frame_id="-1" name="美帆"
		   text="『んんっ、んっ‥‥‥んぐっ‥‥‥‥ちゅぷっ‥‥‥んぷっ‥‥‥。』" voices="miho07370"/>
		<msg @l="471" char_id="0" frame_id="-1" name="美帆"
		   text="『んぐっ‥‥ん、んくっ‥‥‥ちゅぷっ‥‥ちゅ、ちゅううっ。』" voices="miho07380"/>
		<msg @l="473" char_id="-1" frame_id="-1" name=""
		   text="そうして先端の鈴口を吸い上げた途端、不意に苦々しいモノが口内へ広がる。" voices=""/>
		<msg @l="475" char_id="0" frame_id="-1" name="美帆"
		   text="(うあ‥‥‥なんか、先っぽから出てきてる‥‥‥‥)" voices="miho07390"/>
		<msg @l="477" char_id="0" frame_id="-1" name="美帆" text="(これ、精液じゃ‥‥‥‥‥‥？)"
		   voices="miho07400"/>
		<msg @l="479" char_id="-1" frame_id="-1" name=""
		   text="男根の先端より滲み出した液体の感触に眉をひそめ、吐き出したくなる。" voices=""/>
		<msg @l="480" char_id="-1" frame_id="-1" name=""
		   text="私はそれを自分の唾液と共にゴクリと喉を鳴らして飲み下しながら、湿った唇で口内奉仕を続ける。" voices=""/>
		<msg @l="482" char_id="0" frame_id="-1" name="美帆" text="『んふっ‥‥‥んんっ‥‥‥‥。』"
		   voices="miho07290"/>
		<msg @l="484" char_id="-1" frame_id="-1" name=""
		   text="先汁の濃いのが口いっぱいに広がり嘔吐感がこみあげ、身震いする。それに耐えながら嚥下する。" voices=""/>
		<msg @l="486" char_id="-1" frame_id="-1" name="学生Ａ" text="『あの、センセー。』"
		   voices=""/>
		<msg @l="488" char_id="0" frame_id="-1" name="美帆" text="『‥‥！？』"
		   voices="miho07410"/>
		<msg @l="490" char_id="-1" frame_id="-1" name=""
		   text="それまで静かにテストを受けていた学生の一人が、突然声をあげた。" voices=""/>
		<msg @l="492" char_id="0" frame_id="-1" name="美帆" text="(まさか‥‥気付かれちゃった‥‥！？)"
		   voices="miho07420"/>
		<msg @l="494" char_id="-1" frame_id="-1" name=""
		   text="私は心臓が止まってしまいそうなほど驚き‥‥思わず奉仕を止めてしまう。" voices=""/>
		<msg @l="496" char_id="-1" frame_id="-1" name="朽木"
		   text="『誰も止めて良いとは言ってないと思うが‥‥？』" voices=""/>
		<msg @l="498" char_id="0" frame_id="-1" name="美帆" text="『んんっ‥‥。』"
		   voices="miho07430"/>
		<msg @l="500" char_id="-1" frame_id="-1" name=""
		   text="私はその言葉に言い訳をするように、肉棒を咥えたまま喉を鳴らして懇願の眼差しを教授に向ける。" voices=""/>
		<msg @l="501" char_id="-1" frame_id="-1" name=""
		   text="しかし‥‥教授はそんな私に冷静な視線を向けたまま‥‥。" voices=""/>
		<msg @l="503" char_id="-1" frame_id="-1" name="朽木" text="『‥‥続けたまえ。』"
		   voices=""/>
		<msg @l="505" char_id="-1" frame_id="-1" name="" text="といって、続きを促した。"
		   voices=""/>
		<msg @l="507" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』"
		   voices="miho07440"/>
		<msg @l="509" char_id="0" frame_id="-1" name="美帆" text="『んふっ‥‥ん、ちゅぱっ‥‥‥‥。』"
		   voices="miho07450"/>
		<msg @l="511" char_id="-1" frame_id="-1" name=""
		   text="仕方なく‥‥私はゆっくりと唇を動かして再び陰茎をしゃぶり始める。" voices=""/>
		<msg @l="512" char_id="-1" frame_id="-1" name="" text="ただ‥‥音を立てないように気を使って。"
		   voices=""/>
		<msg @l="514" char_id="-1" frame_id="-1" name="学生Ａ" text="『センセー？』" voices=""/>
		<msg @l="516" char_id="-1" frame_id="-1" name="朽木"
		   text="『聞こえている。テスト中になんだね？』" voices=""/>
		<msg @l="518" char_id="-1" frame_id="-1" name="学生Ａ"
		   text="『あの‥‥トイレ、行きたいんスけど。』" voices=""/>
		<msg @l="520" char_id="-1" frame_id="-1" name="朽木"
		   text="『では、答案を裏返しにして静かに出て行くと良い。』" voices=""/>
		<msg @l="522" char_id="-1" frame_id="-1" name="学生Ａ" text="『はーい。』" voices=""/>
		<msg @l="524" char_id="-1" frame_id="-1" name=""
		   text="そう言って、学生の一人が講堂を出て行くのが‥‥音でわかった。" voices=""/>
		<msg @l="525" char_id="-1" frame_id="-1" name=""
		   text="とにかく私たちのしている事に気付いたわけではなかっただけ‥‥良かった。" voices=""/>
		<msg @l="527" char_id="0" frame_id="-1" name="美帆"
		   text="『んふぅ‥‥んっ、んんっ‥‥‥‥ちゅ、ちゅぷぷっ。』" voices="miho07460"/>
		<msg @l="529" char_id="-1" frame_id="-1" name=""
		   text="一分、一秒でも早く彼を満足させなければ‥‥誰かに気づかれるかもしれない。" voices=""/>
		<msg @l="530" char_id="-1" frame_id="-1" name=""
		   text="私はそうした恐怖に駆られて懸命に頭を振り、舌先を絡み付け奥まで咥える。" voices=""/>
		<msg @l="532" char_id="-1" frame_id="-1" name="朽木" text="『くく‥‥いいぞ、その調子だ。』"
		   voices=""/>
		<msg @l="534" char_id="-1" frame_id="-1" name=""
		   text="頭上でニヤつく教授をよそに私は必死であった。" voices=""/>
		<msg @l="535" char_id="-1" frame_id="-1" name=""
		   text="唇をきつく窄め、必死に顔を前後に振り出す。" voices=""/>
		<msg @l="537" char_id="-1" frame_id="-1" name="朽木" text="『おぉぉぉぉ‥‥。』"
		   voices=""/>
		<msg @l="539" char_id="-1" frame_id="-1" name=""
		   text="さらに頬をへこます程に吸引し、さらに激しく顔を前後に揺する。その様はまるでキツツキだ。" voices=""/>
		<msg @l="541" char_id="0" frame_id="-1" name="美帆"
		   text="『んんっ、んっ‥‥‥んぐっ‥‥‥‥ちゅぷっ‥‥‥んぷっ‥‥‥。』" voices="miho07370"/>
		<msg @l="543" char_id="-1" frame_id="-1" name="朽木"
		   text="『そろそろ放ってやる‥‥全部、口で受け止めるのだぞ？』" voices=""/>
		<msg @l="545" char_id="0" frame_id="-1" name="美帆" text="『‥‥！？』"
		   voices="miho07470"/>
		<msg @l="547" char_id="-1" frame_id="-1" name="朽木" text="『く、いくぞ‥‥。』"
		   voices=""/>
		<flash @l="550" count="4" fade="100" image="white"/>
		<wait_chgmv/>
		<ev @l="553" src="ev-012x1z1"/>
		<msg @l="555" char_id="0" frame_id="-1" name="美帆" text="『んんっっっ！！』"
		   voices="miho07480"/>
		<msg @l="557" char_id="-1" frame_id="-1" name=""
		   text="唇の狭間で大きく男根がビクンと跳ね上がったかと思うと、熱い飛沫が勢いよくのどの奥へ向かって吐き出される。" voices=""/>
		<msg @l="558" char_id="-1" frame_id="-1" name=""
		   text="ひどく生臭く‥‥そして舌先や口内に絡みついてくる熱い液体に、私は戸惑いの表情で口内に溜めたままにしていた。" voices=""/>
		<msg @l="560" char_id="-1" frame_id="-1" name="朽木" text="『服を汚さぬ為だ‥‥全て飲み下せ。』"
		   voices=""/>
		<msg @l="562" char_id="0" frame_id="-1" name="美帆" text="『んんんっ！？』"
		   voices="miho07490"/>
		<msg @l="564" char_id="-1" frame_id="-1" name="朽木"
		   text="『どうした、今度こそ誰かが気付くかも知れぬぞ？』" voices=""/>
		<msg @l="566" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥っ‥‥。』"
		   voices="miho07500"/>
		<msg @l="568" char_id="0" frame_id="-1" name="美帆"
		   text="『んんっ‥‥‥ん、んくっ‥‥‥‥‥んくっ‥‥‥んくっ‥‥んくっ‥‥。』" voices="miho07510"/>
		<msg @l="570" char_id="-1" frame_id="-1" name=""
		   text="わずかなためらいの後‥‥私は口内に溜まった大量の精液を懸命に飲み下していく。" voices=""/>
		<msg @l="571" char_id="-1" frame_id="-1" name=""
		   text="粘り気の強いそれは飲み下すのがつらくて、喉に絡みつく感じが嫌悪感を生んだ。思わず咳き込みそうになるのをぐっと堪える。"
		   voices=""/>
		<msg @l="572" char_id="-1" frame_id="-1" name="" text="目からは涙が零れ落ちる。"
		   voices=""/>
		<msg @l="574" char_id="-1" frame_id="-1" name="朽木"
		   text="『さて‥‥口の中のモノを全て飲み下したら、先を吸って奥に残った精液もしっかりと吸い出したまえ。』" voices=""/>
		<msg @l="576" char_id="0" frame_id="-1" name="美帆"
		   text="『ん、んぐっ‥‥‥ふ、ふぁい‥‥‥‥‥‥んむ、ちゅうううっ。』" voices="miho07520"/>
		<msg @l="578" char_id="-1" frame_id="-1" name="朽木" text="『くくっ‥‥いい子だ。』"
		   voices=""/>
		<msg @l="580" char_id="-1" frame_id="-1" name=""
		   text="そうして精の残滓をすする私の姿を見、朽木教授は口元を大きくつり上げて愉悦の笑みを浮かべていた。" voices=""/>
		<stopbgm @l="583" fadeout="1000"/>
		<clear @l="586" class="all"/>
		<end_scene @l="589"/>
		<msgshow @l="592" show="true"/>
		<wait_chgmv/>
		<bg @l="595" src="bg08m1"/>
		<bgm @l="598" src="bgm03" volume="1."/>
		<se @l="601" buf="1" src="チャイム" volume="1."/>
		<description @l="604" text="朽木の奴隷・１日目"/>
		<msg @l="606" char_id="-1" frame_id="-1" name="朽木"
		   text="『それまで。みなテスト用紙を裏に向けて速やかに退出したまえ。』" voices=""/>
		<msg @l="608" char_id="-1" frame_id="-1" name="学生Ｂ" text="『あー‥‥もう、サイアクだ。』"
		   voices=""/>
		<msg @l="610" char_id="-1" frame_id="-1" name="学生Ｃ"
		   text="『ちくしょー、俺なんて半分も埋めらんなかったぜ。』" voices=""/>
		<msg @l="612" char_id="-1" frame_id="-1" name="学生Ｄ"
		   text="『大体、メシ喰ったあとにテストなんかずりーよなー。』" voices=""/>
		<msg @l="614" char_id="-1" frame_id="-1" name=""
		   text="テストを受けていた学生たちは、口々に感想やら文句やらをつぶやきながら講堂をでていく。" voices=""/>
		<wait_chgmv/>
		<bg @l="617" src="bg08"/>
		<msg @l="619" char_id="-1" frame_id="-1" name=""
		   text="そうして全ての学生が講堂から退出した後、朽木教授は教壇の前の椅子から立ち上がり、中に潜んでいた私に出てくるように合図をする。"
		   voices=""/>
		<char @l="622" id="miho" pos="left" src="miho115"/>
		<msg @l="624" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<char @l="627" id="kutsu" pos="right" src="kutsu010"/>
		<msg @l="629" char_id="-1" frame_id="-1" name="朽木"
		   text="『キミの奉仕は実に素晴らしかったよ、仲根クン。』" voices=""/>
		<msg @l="631" char_id="-1" frame_id="-1" name="朽木"
		   text="『とても初めてとは思えない奉仕ぶりだったな。』" voices=""/>
		<char @l="634" id="miho" pos="left" src="miho015"/>
		<msg @l="636" char_id="0" frame_id="-1" name="美帆"
		   text="『そんなっ‥‥わたし、あんなこと本当に初めてでっ‥‥‥‥。』" voices=""/>
		<msg @l="638" char_id="-1" frame_id="-1" name="朽木" text="『わかっている。褒めているのだよ。』"
		   voices=""/>
		<msg @l="640" char_id="0" frame_id="-1" name="美帆"
		   text="『こんなこと‥‥褒められても嬉しくないです‥‥‥‥。』" voices=""/>
		<msg @l="642" char_id="-1" frame_id="-1" name="朽木"
		   text="『キミにもいずれわかるときが来る、男に奉仕することの悦びがな。』" voices=""/>
		<char @l="645" id="miho" pos="left" src="miho115"/>
		<msg @l="647" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="649" char_id="-1" frame_id="-1" name=""
		   text="そう言って笑う朽木教授の視線にいたたまれなくなり顔を逸らした。" voices=""/>
		<stopbgm @l="652" fadeout="1000"/>
		<clear @l="655" class="all"/>
		<msgshow @l="657" show="true"/>
		<wait_chgmv/>
		<bg @l="660" src="bg07"/>
		<bgm @l="663" src="bgm07" volume="1."/>
		<char @l="666" id="miho" pos="auto" src="miho116"/>
		<msg @l="668" char_id="0" frame_id="-1" name="美帆" text="『はぁ‥‥。』" voices=""/>
		<msg @l="670" char_id="-1" frame_id="-1" name=""
		   text="一日の講義をすべて終えた私は、一人とぼとぼとキャンパスを歩いていた。" voices=""/>
		<msg @l="671" char_id="-1" frame_id="-1" name=""
		   text="本来ならば講義から解放されて楽しい時間なのだろうが、私の口から漏れるのは深いため息ばかりだ。" voices=""/>
		<msg @l="672" char_id="-1" frame_id="-1" name=""
		   text="それというのも全て‥‥朽木教授と交わした約束が私を憂鬱にさせているせいだ。" voices=""/>
		<msg @l="674" char_id="0" frame_id="-1" name="美帆"
		   text="(これまでは、家に帰れば朽木教授に会わなくてすんだ‥‥)" voices=""/>
		<msg @l="676" char_id="0" frame_id="-1" name="美帆" text="(でも‥‥今はもう違うんだよね)"
		   voices=""/>
		<msg @l="678" char_id="0" frame_id="-1" name="美帆"
		   text="(私、教授の‥‥愛人‥‥‥‥‥なんだもん)" voices=""/>
		<msg @l="680" char_id="-1" frame_id="-1" name=""
		   text="たぶん、彼は私が何処にいようと平気でメールを送ってくるだろう。" voices=""/>
		<msg @l="681" char_id="-1" frame_id="-1" name="" text="彼にはその権利があるのだ。"
		   voices=""/>
		<msg @l="683" char_id="0" frame_id="-1" name="美帆" text="『はぁ‥‥。』" voices=""/>
		<char @l="686" id="miho" pos="center" src="miho114f" y="-80"/>
		<msg @l="688" char_id="0" frame_id="-1" name="美帆" text="『あ‥‥。』" voices=""/>
		<stopbgm @l="691" fadeout="1000"/>
		<msg @l="693" char_id="-1" frame_id="-1" name=""
		   text="ふと、道の端にある見知った人影に気付いて‥‥私は立ち止まる。" voices=""/>
		<msg @l="694" char_id="-1" frame_id="-1" name=""
		   text="どこか遠くを眺めているらしく、彼は私に気付いた様子はない。" voices=""/>
		<char @l="697" id="shiny" pos="left" src="shinya210" z="100"/>
		<msg @l="699" char_id="0" frame_id="-1" name="美帆"
		   text="(あの人‥‥私がこの町に来た時の‥‥‥‥)" voices=""/>
		<msg @l="701" char_id="-1" frame_id="-1" name="" text="奈那子ちゃんが「兄様」と呼んでいた人だ。"
		   voices=""/>
		<msg @l="703" char_id="0" frame_id="-1" name="美帆" text="(何、してるのかな‥‥)"
		   voices=""/>
		<msg @l="705" char_id="0" frame_id="-1" name="美帆"
		   text="(奈那子ちゃんは‥‥‥いないみたいだけど‥‥‥‥)" voices=""/>
		<clear @l="708" class="char"/>
		<char @l="710" id="shiny" pos="auto" src="shinya210"/>
		<msg @l="712" char_id="-1" frame_id="-1" name="若い男" text="『‥‥‥‥。』" voices=""/>
		<msg @l="714" char_id="-1" frame_id="-1" name=""
		   text="彼は、じっと押し黙ったまま一点を見つめていた。" voices=""/>
		<msg @l="715" char_id="-1" frame_id="-1" name=""
		   text="こちらに背中を向けている為、どこを見ているのかはよくわからない。" voices=""/>
		<msg @l="716" char_id="-1" frame_id="-1" name=""
		   text="方角的には‥‥私たちが「裏庭」と呼んでいる辺りだろうか？" voices=""/>
		<msg @l="718" char_id="0" frame_id="-1" name="美帆"
		   text="(裏庭の方にあるのは‥‥駐車場と用務員室、くらいだよね)" voices=""/>
		<msg @l="720" char_id="0" frame_id="-1" name="美帆"
		   text="(用務員さんでも探してる‥‥‥って、そんなワケないか)" voices=""/>
		<clear @l="723" class="char"/>
		<msg @l="725" char_id="-1" frame_id="-1" name=""
		   text="周囲を軽く見回して、もう一度彼の方へ視線を戻す。" voices=""/>
		<msg @l="726" char_id="-1" frame_id="-1" name="" text="既に‥‥彼の姿はなくなっていた。"
		   voices=""/>
		<stopbgm @l="729" fadeout="1000"/>
		<clear @l="732" class="all"/>
		<call @l="735" target="EventLabel_114@root_kutuki03a"/>
		<return @l="736" value="0&#13;&#10;"/>
	</code>
</xscript>
