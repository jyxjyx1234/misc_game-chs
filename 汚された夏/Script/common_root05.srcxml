<?xml version="1.0" encoding="utf-8"?>
<xscript>
	<debug editor="&quot;C:\Program&#32;Files&#32;(x86)\sakura\sakura.exe&quot;&#32;&quot;%src%&quot;&#32;-Y=%line%"
	   src="D:\シロップ\町ぐるみの罠＋汚された夏セット版\汚された夏\完成データ\汚された夏\script\text\common_root05.txt"/>
	<code>
		<label @l="19" id="EventLabel_35"/>
		<description @l="23" text="充実する日常の切れ端"/>
		<eval @l="25" expr="f.numDay=5&#13;&#10;"/>
		<msgshow @l="27" show="false"/>
		<wait_chgmv/>
		<bg @l="29" src="day05" time="2000"/>
		<wait @l="31" time="500"/>
		<wait_chgmv/>
		<bg @l="33" src="black" time="2000"/>
		<msgshow @l="35" show="true"/>
		<wait_chgmv/>
		<bg @l="39" src="bg01"/>
		<bgm @l="43" src="bgm02" volume="1."/>
		<char @l="47" id="miho" pos="auto" src="miho010"/>
		<msg @l="49" char_id="0" frame_id="-1" name="美帆" text="『それじゃあ私、そろそろ出ますね。』"
		   voices=""/>
		<clear @l="52" class="char"/>
		<char @l="54" id="miho" pos="left" src="miho010"/>
		<char @l="57" id="rei" pos="right" src="rei034"/>
		<msg @l="59" char_id="1" frame_id="-1" name="玲" text="『あら、今日はのんびり登校なのね。』"
		   voices=""/>
		<msg @l="61" char_id="1" frame_id="-1" name="玲" text="『二限目には‥‥間に合わないと思うけど？』"
		   voices=""/>
		<msg @l="63" char_id="0" frame_id="-1" name="美帆" text="『今日の講義は三限だけですから。』"
		   voices=""/>
		<msg @l="65" char_id="1" frame_id="-1" name="玲" text="『三限にはまだ早くない？』"
		   voices=""/>
		<char @l="68" id="miho" pos="left" src="miho111"/>
		<msg @l="70" char_id="0" frame_id="-1" name="美帆"
		   text="『図書館でレポートの資料を探したいんです‥‥参考文献が専門書なので買うと高くついちゃって。』" voices=""/>
		<char @l="74" id="rei" pos="right" src="rei030"/>
		<msg @l="76" char_id="1" frame_id="-1" name="玲" text="『専攻が考古学っていうのも大変そうね。』"
		   voices=""/>
		<msg @l="78" char_id="0" frame_id="-1" name="美帆"
		   text="『そんなことないです。実は小さい頃に連れて行ってもらった古墳とか見て感動してから、いつか考古学の勉強をしたいな、と思っていたんですよ。』"
		   voices=""/>
		<msg @l="80" char_id="0" frame_id="-1" name="美帆"
		   text="『実際に携わってみたら古い文献を紐解いたり出来て、凄くわくわくしましたし、各地の出土品に触れることも出来るようになったので、楽しいですよ。』"
		   voices=""/>
		<msg @l="82" char_id="1" frame_id="-1" name="玲"
		   text="『楽しみながら勉強出来るというのは素晴らしいわね。』" voices=""/>
		<msg @l="84" char_id="0" frame_id="-1" name="美帆" text="『はい。』" voices=""/>
		<msg @l="86" char_id="1" frame_id="-1" name="玲"
		   text="『あ、そうそう‥‥アナタも今日からサークルに参加するのよね？』" voices=""/>
		<char @l="89" id="miho" pos="left" src="miho010"/>
		<msg @l="91" char_id="0" frame_id="-1" name="美帆"
		   text="『そのつもりですけど‥‥玲さん、今日も参加出来ないんですか？』" voices=""/>
		<msg @l="93" char_id="1" frame_id="-1" name="玲" text="『ううん、今日は行けると思うわ。』"
		   voices=""/>
		<char @l="97" id="rei" pos="right" src="rei031"/>
		<msg @l="99" char_id="1" frame_id="-1" name="玲" text="『久しぶりに稲庭さんにも会いたいし。』"
		   voices=""/>
		<msg @l="101" char_id="-1" frame_id="-1" name="" text="そうして玲さんは嬉しそうに微笑んだ。"
		   voices=""/>
		<msg @l="102" char_id="-1" frame_id="-1" name=""
		   text="本当に稲庭先輩のことが好きなんだと‥‥改めて実感する。" voices=""/>
		<msg @l="104" char_id="0" frame_id="-1" name="美帆"
		   text="『でも‥‥サークルがある日がメンバー主導で決まるのって、変わってますね。』" voices=""/>
		<msg @l="106" char_id="0" frame_id="-1" name="美帆"
		   text="『普通はサークルのある日って決まってるものですよね‥‥？』" voices=""/>
		<char @l="110" id="rei" pos="right" src="rei030"/>
		<msg @l="112" char_id="1" frame_id="-1" name="玲" text="『それがあのサークルの良い所よ。』"
		   voices=""/>
		<msg @l="114" char_id="1" frame_id="-1" name="玲"
		   text="『誰も参加を強制したりしないし、堅苦しいルールや規則もない。』" voices=""/>
		<msg @l="116" char_id="1" frame_id="-1" name="玲"
		   text="『それでも毎日最低限のメンバーが集まるのは稲庭さんのカリスマ性があるからこそだと思うけれどね。』" voices=""/>
		<char @l="119" id="miho" pos="left" src="miho111"/>
		<msg @l="121" char_id="0" frame_id="-1" name="美帆"
		   text="『そうですね、稲庭先輩は本当に凄いと思います。』" voices=""/>
		<msg @l="123" char_id="0" frame_id="-1" name="美帆"
		   text="『あんなにもてはやされているのに少しも気取った所がありませんし。』" voices=""/>
		<msg @l="125" char_id="1" frame_id="-1" name="玲"
		   text="『そうね‥‥でも、あの人の裏側には時々冷たいものがあるように思えるのよね‥‥。』" voices=""/>
		<msg @l="127" char_id="1" frame_id="-1" name="玲" text="『寂しさとは違う‥‥何かを感じるのよ。』"
		   voices=""/>
		<char @l="130" id="miho" pos="left" src="miho116"/>
		<msg @l="132" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="134" char_id="-1" frame_id="-1" name=""
		   text="玲さんのいう「冷たさ」は、私も微かに感じていたことだ。" voices=""/>
		<msg @l="135" char_id="-1" frame_id="-1" name=""
		   text="稲庭先輩の完璧な笑顔の裏側にある冷たい雰囲気。" voices=""/>
		<msg @l="136" char_id="-1" frame_id="-1" name=""
		   text="浮かべられる笑みが優しそうに見えれば見えるほど、その裏側には何か秘めれられたものがるような‥‥そんな感じがしている。"
		   voices=""/>
		<msg @l="137" char_id="-1" frame_id="-1" name=""
		   text="ただ、その「何か」が稲庭先輩のカリスマ性に磨きをかけているのもまた事実なのではないかと思う。" voices=""/>
		<char @l="141" id="rei" pos="right" src="rei034"/>
		<msg @l="143" char_id="1" frame_id="-1" name="玲"
		   text="『と、いけない‥‥こんな話をしてる余裕なんて無いんじゃない？』" voices=""/>
		<char @l="147" id="miho" pos="left" src="miho014"/>
		<msg @l="149" char_id="0" frame_id="-1" name="美帆"
		   text="『あ‥‥そうですね、次の電車を逃したらちょっと大変かも‥‥。』" voices=""/>
		<char @l="153" id="rei" pos="right" src="rei030"/>
		<msg @l="155" char_id="1" frame_id="-1" name="玲" text="『変に引き止めてしまってごめんなさい。』"
		   voices=""/>
		<char @l="159" id="miho" pos="left" src="miho110"/>
		<msg @l="161" char_id="0" frame_id="-1" name="美帆"
		   text="『いえ、良いんです‥‥それじゃあまたテニスコートで。』" voices=""/>
		<msg @l="163" char_id="1" frame_id="-1" name="玲" text="『ええ。行ってらっしゃい。』"
		   voices=""/>
		<char @l="166" id="miho" pos="left" src="miho111"/>
		<msg @l="168" char_id="0" frame_id="-1" name="美帆" text="『行ってきます。』" voices=""/>
		<clear @l="174" class="all"/>
		<msgshow @l="176" show="true"/>
		<wait_chgmv/>
		<bg @l="180" src="bg07"/>
		<char @l="184" id="miho" pos="auto" src="miho015"/>
		<bgm @l="188" src="bgm02" volume="1."/>
		<msg @l="191" char_id="0" frame_id="-1" name="美帆" text="(‥‥う、おも‥‥‥)"
		   voices=""/>
		<msg @l="193" char_id="-1" frame_id="-1" name=""
		   text="キャンパス内にある図書館で、レポートの参考文献を借りてきたその帰り。" voices=""/>
		<msg @l="194" char_id="-1" frame_id="-1" name=""
		   text="分厚い専門書を三冊ほど両手で抱えた私は、わずかによろめきながら三限目の講義がある教室へ向かっていた。" voices=""/>
		<msg @l="196" char_id="0" frame_id="-1" name="美帆"
		   text="(大きいカバン、持って来るんだったな‥‥)" voices=""/>
		<msg @l="198" char_id="0" frame_id="-1" name="美帆"
		   text="(重さよりも‥‥んしょっ‥‥‥持ち運び辛さが嫌な感じ‥‥)" voices=""/>
		<msg @l="200" char_id="-1" frame_id="-1" name=""
		   text="専門書というのはどうしてこう示し合わせたようにハードカバーのものばかりなのかな。" voices=""/>
		<msg @l="201" char_id="-1" frame_id="-1" name=""
		   text="確かにハードカバーの方が丈夫だというのは解るのだけれど‥‥。" voices=""/>
		<msg @l="202" char_id="-1" frame_id="-1" name=""
		   text="けれど、耐久性よりもまず扱い難い点を考えて欲しい‥‥。" voices=""/>
		<char @l="206" id="miho" pos="auto" src="miho110"/>
		<msg @l="208" char_id="0" frame_id="-1" name="美帆"
		   text="(なんて、愚痴を言ってても仕方ないか‥‥)" voices=""/>
		<msg @l="210" char_id="0" frame_id="-1" name="美帆"
		   text="(とにかくこれを教室まで運んで‥‥‥と)" voices=""/>
		<msg @l="213" char_id="3" frame_id="-1" name="女の子" text="『みほ‥‥‥。』" voices=""/>
		<char @l="217" id="miho" pos="auto" src="miho014"/>
		<msg @l="219" char_id="0" frame_id="-1" name="美帆" text="『え‥‥？』" voices=""/>
		<stopbgm @l="223" fadeout="1000"/>
		<se @l="227" buf="1" src="人とぶつかる音" volume="1."/>
		<char @l="231" id="miho" pos="auto" src="miho014"/>
		<msg @l="233" char_id="0" frame_id="-1" name="美帆" text="『きゃっ！？』" voices=""/>
		<msg @l="235" char_id="-1" frame_id="-1" name=""
		   text="ちょうど十字路に差し掛かったところで、後ろからいきなり誰かに抱きつかれた。" voices=""/>
		<msg @l="236" char_id="-1" frame_id="-1" name="" text="私は慌てて振り返り、その人を見る。"
		   voices=""/>
		<char @l="240" id="miho" pos="auto" src="miho016"/>
		<msg @l="242" char_id="0" frame_id="-1" name="美帆"
		   text="『あさ‥‥奈那子ちゃん‥‥‥‥だったんだ。』" voices=""/>
		<msg @l="243" char_id="-1" frame_id="-1" name=""
		   text="思わず「浅間さん」と呼びそうになって、慌てて言い直す。" voices=""/>
		<msg @l="245" char_id="-1" frame_id="-1" name=""
		   text="いきなり抱きついてきたのは奈那子ちゃんだった。" voices=""/>
		<clear @l="248" class="char"/>
		<char @l="252" id="nanak" pos="center" src="nanako011f" y="-80"/>
		<bgm @l="256" src="bgm06" volume="1."/>
		<msg @l="258" char_id="3" frame_id="-1" name="奈那子" text="『くんくんくん。』"
		   voices=""/>
		<msg @l="260" char_id="-1" frame_id="-1" name=""
		   text="奈那子ちゃんは抱きついたまま、突然、小さいお鼻を鳴らして、まるで子犬のように、私の匂いを嗅いできた。" voices=""/>
		<clear @l="263" class="char"/>
		<char @l="267" id="miho" pos="left" src="miho014"/>
		<char @l="269" id="nanak" pos="auto" src="nanako011"/>
		<msg @l="272" char_id="0" frame_id="-1" name="美帆"
		   text="『きゃっ！？‥‥奈那子ちゃん‥‥‥‥何を？』" voices=""/>
		<char @l="275" id="nanak" pos="auto" src="nanako012"/>
		<msg @l="277" char_id="3" frame_id="-1" name="奈那子"
		   text="『えへへ‥‥美帆ってなんか、とっても優しい匂いがするんだぁ。』" voices=""/>
		<char @l="281" id="miho" pos="left" src="miho013"/>
		<msg @l="283" char_id="0" frame_id="-1" name="美帆" text="『え？あぅ‥‥。』" voices=""/>
		<msg @l="285" char_id="-1" frame_id="-1" name=""
		   text="私は、突然の彼女の言動に、どぎまぎしながらも「優しい」と言われ照れてしまった。" voices=""/>
		<char @l="288" id="nanak" pos="auto" src="nanako013"/>
		<msg @l="290" char_id="3" frame_id="-1" name="奈那子"
		   text="『‥‥なんか、お母さんみたいで安心するよ‥‥。』" voices=""/>
		<msg @l="292" char_id="-1" frame_id="-1" name=""
		   text="そう言うと、彼女はまるで子猫みたいに喉をならし私になついてきた。" voices=""/>
		<char @l="297" id="miho" pos="left" src="miho113"/>
		<msg @l="299" char_id="0" frame_id="-1" name="美帆"
		   text="『やんっ‥‥奈那子ちゃん‥くすぐったいよ。』" voices=""/>
		<char @l="302" id="nanak" pos="auto" src="nanako012"/>
		<msg @l="304" char_id="3" frame_id="-1" name="奈那子" text="『美帆ぉ‥‥ごろごろ‥‥。』"
		   voices=""/>
		<msg @l="307" char_id="-1" frame_id="-1" name=""
		   text="甘えてくる彼女がとっても愛らしく感じた。ツインテールの髪からはお日様の匂いがする。" voices=""/>
		<msg @l="309" char_id="-1" frame_id="-1" name=""
		   text="なんとなく、私もいい気分になって彼女の頭をなでなでしていると、奈那子ちゃんはさらに、頬をすりすりしてきた。" voices=""/>
		<char @l="312" id="nanak" pos="auto" src="nanako013"/>
		<msg @l="314" char_id="3" frame_id="-1" name="奈那子"
		   text="『美帆ぉ‥‥ごろにゃん‥‥もっと頭なでてっ。なでてっ。』" voices=""/>
		<msg @l="316" char_id="0" frame_id="-1" name="美帆" text="『はいはい‥‥奈那子ちゃん。』"
		   voices=""/>
		<msg @l="318" char_id="-1" frame_id="-1" name=""
		   text="私もなんだか、お母さんになったような気分で、彼女の頭を何度も優しく撫でた。" voices=""/>
		<clear @l="320" class="char"/>
		<char @l="323" id="nanak" pos="right" src="nanako010"/>
		<char @l="325" id="miho" pos="left" src="miho113"/>
		<stopbgm @l="328" fadeout="1000"/>
		<msg @l="330" char_id="-1" frame_id="-1" name=""
		   text="さっきまで、猫なで声を上げていた奈那子ちゃんが、急に真顔になった。" voices=""/>
		<msg @l="332" char_id="-1" frame_id="-1" name="" text="厳しい顔つきで私の耳元にこう囁く。"
		   voices=""/>
		<msg @l="335" char_id="3" frame_id="-1" name="奈那子"
		   text="『美帆。早くこの町から出て行って。そうしないと、取り返しのつかない事になるよ。』" voices=""/>
		<char @l="340" id="miho" pos="left" src="miho014"/>
		<msg @l="343" char_id="0" frame_id="-1" name="美帆" text="『えっ？』" voices=""/>
		<msg @l="345" char_id="-1" frame_id="-1" name=""
		   text="突然の彼女の変化に驚き、私は奈那子ちゃんの顔を覗き込んだ。" voices=""/>
		<char @l="349" id="nanak" pos="right" src="nanako015"/>
		<bgm @l="351" src="bgm11" volume="1."/>
		<msg @l="353" char_id="3" frame_id="-1" name="奈那子"
		   text="『美帆は私にとって初めて出来た友達だから。だから、忠告‥‥早くこの町から‥‥。』" voices=""/>
		<msg @l="355" char_id="-1" frame_id="-1" name="" text="そこまで言いかけて、彼女は口を塞いだ。"
		   voices=""/>
		<msg @l="356" char_id="-1" frame_id="-1" name=""
		   text="続きを私が聞こうとした所で、人の気配を感じ、その方向を見た。" voices=""/>
		<msg @l="358" char_id="-1" frame_id="-1" name="声" text="『奈那子‥‥こんなところに居たのか。』"
		   voices=""/>
		<char @l="362" id="nanak" pos="right" src="nanako014"/>
		<msg @l="364" char_id="3" frame_id="-1" name="奈那子" text="『兄様っ。』" voices=""/>
		<clear @l="367" class="char"/>
		<char @l="369" id="nanak" pos="left" src="nanako014"/>
		<char @l="372" id="shiny" pos="right" src="shinya010"/>
		<msg @l="374" char_id="-1" frame_id="-1" name="奈那子の兄"
		   text="『奈那子、俺が戻るまで勝手に出歩いてはいけないとあれだけ言っておいただろう。』" voices=""/>
		<char @l="378" id="nanak" pos="left" src="nanako015"/>
		<msg @l="380" char_id="3" frame_id="-1" name="奈那子" text="『ごめんなさい‥‥兄様。』"
		   voices=""/>
		<msg @l="382" char_id="3" frame_id="-1" name="奈那子"
		   text="『でも、どうしても美帆に会いたくて‥‥。』" voices=""/>
		<msg @l="384" char_id="-1" frame_id="-1" name="奈那子の兄" text="『‥‥‥‥。』"
		   voices=""/>
		<clear @l="387" class="char"/>
		<char @l="390" id="shiny" pos="left" src="shinya010"/>
		<char @l="393" id="miho" pos="right" src="miho115"/>
		<msg @l="395" char_id="0" frame_id="-1" name="美帆"
		   text="『あの‥‥‥私、奈那子ちゃんと話を‥‥。』" voices=""/>
		<msg @l="397" char_id="-1" frame_id="-1" name=""
		   text="彼の只ならぬ雰囲気に、私は話しに割って入った。" voices=""/>
		<char @l="401" id="shiny" pos="left" src="shinya017"/>
		<msg @l="403" char_id="-1" frame_id="-1" name="奈那子の兄" text="『‥‥‥‥。』"
		   voices=""/>
		<msg @l="405" char_id="-1" frame_id="-1" name="奈那子の兄"
		   text="『今後、俺や奈那子と関わるな。それがお前の為だ‥‥。』" voices=""/>
		<char @l="409" id="shiny" pos="left" src="shinya210"/>
		<msg @l="411" char_id="-1" frame_id="-1" name="奈那子の兄"
		   text="『そうでなければ‥‥‥見たくないものを見る事になるぞ。』" voices=""/>
		<char @l="415" id="miho" pos="right" src="miho114"/>
		<msg @l="417" char_id="0" frame_id="-1" name="美帆" text="『え‥‥？』" voices=""/>
		<msg @l="419" char_id="-1" frame_id="-1" name="奈那子の兄" text="『奈那子‥‥来い。』"
		   voices=""/>
		<clear @l="423" class="char"/>
		<msg @l="425" char_id="3" frame_id="-1" name="奈那子" text="『あ、兄様‥‥。』"
		   voices=""/>
		<msg @l="427" char_id="-1" frame_id="-1" name=""
		   text="奈那子さんの「兄様」と思しき男性は、そうして踵を返すと大学の外へと続く道を足早に歩いて行いった。" voices=""/>
		<msg @l="428" char_id="-1" frame_id="-1" name=""
		   text="次いでそんな「兄様」の背中を追うように、奈那子ちゃんも駆け出した。" voices=""/>
		<char @l="432" id="miho" pos="auto" src="miho114"/>
		<msg @l="434" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="436" char_id="0" frame_id="-1" name="美帆" text="『見たくないものって‥‥‥。』"
		   voices=""/>
		<char @l="439" id="miho" pos="auto" src="miho116"/>
		<msg @l="441" char_id="0" frame_id="-1" name="美帆" text="『何のことなんだろう‥‥‥‥‥。』"
		   voices=""/>
		<msg @l="443" char_id="-1" frame_id="-1" name=""
		   text="私はその場に取り残され、色々と考えていた―――。" voices=""/>
		<stopbgm @l="447" fadeout="1000"/>
		<clear @l="453" class="all"/>
		<msgshow @l="455" show="true"/>
		<wait_chgmv/>
		<bg @l="459" src="bg13m1"/>
		<bgm @l="463" src="bgm02" volume="1."/>
		<msg @l="465" char_id="-1" frame_id="-1" name="" text="三限目が終わってすぐ‥‥。"
		   voices=""/>
		<msg @l="466" char_id="-1" frame_id="-1" name=""
		   text="こんな時間では誰も居ないだろうとテニスコートに来てみると、既にサークル員の何人かがゲームやら練習やらを始めていた。"
		   voices=""/>
		<char @l="470" id="miho" pos="auto" src="miho014"/>
		<msg @l="472" char_id="0" frame_id="-1" name="美帆"
		   text="(わ‥‥こんな早い時間でも人がいるんだ)" voices=""/>
		<msg @l="474" char_id="0" frame_id="-1" name="美帆"
		   text="(でも、玲さんはまだ来てないみたい‥‥)" voices=""/>
		<char @l="478" id="miho" pos="auto" src="miho116"/>
		<msg @l="480" char_id="0" frame_id="-1" name="美帆" text="(どうしよう‥‥困ったな‥‥‥)"
		   voices=""/>
		<msg @l="482" char_id="-1" frame_id="-1" name=""
		   text="いざテニスコートまで来たものの、何となく居場所が無い。" voices=""/>
		<msg @l="483" char_id="-1" frame_id="-1" name=""
		   text="活動日も内容もサークル員の自主性に任せるというだけあって、コート内にちらほら居るサークル員たちは、それぞれが思い思いのことをしている。"
		   voices=""/>
		<msg @l="484" char_id="-1" frame_id="-1" name=""
		   text="こういう時、知っている人が一人でも居るとずいぶん違うのだけれど‥‥。" voices=""/>
		<msg @l="485" char_id="-1" frame_id="-1" name=""
		   text="都合の悪いことに、稲庭先輩もコート内には見当たらなかった。" voices=""/>
		<msg @l="487" char_id="0" frame_id="-1" name="美帆"
		   text="(まあ‥‥そんな都合良くは行かないよね‥‥‥)" voices=""/>
		<msg @l="489" char_id="0" frame_id="-1" name="美帆"
		   text="(どうしたら良いか聞かないとダメ‥‥‥かな‥‥‥)" voices=""/>
		<char @l="492" id="miho" pos="auto" src="miho110"/>
		<msg @l="494" char_id="0" frame_id="-1" name="美帆"
		   text="『あの‥‥ちょっとお聞きしたいんですけど。』" voices=""/>
		<msg @l="496" char_id="-1" frame_id="-1" name="サークル員" text="『はい？』" voices=""/>
		<msg @l="498" char_id="-1" frame_id="-1" name=""
		   text="とりあえず、すぐ近くでボールの仕分け(？)をしているテニスウェア姿の男の子に話し掛けてみる。" voices=""/>
		<msg @l="500" char_id="0" frame_id="-1" name="美帆"
		   text="『私、昨日入会したばかりで、何をすれば良いとか良く分からないんですけど‥‥。』" voices=""/>
		<msg @l="502" char_id="-1" frame_id="-1" name="サークル員" text="『ああ、はいはい。』"
		   voices=""/>
		<msg @l="504" char_id="-1" frame_id="-1" name="サークル員"
		   text="『そうだな‥‥まず、着替えてきたら？』" voices=""/>
		<msg @l="506" char_id="-1" frame_id="-1" name="サークル員"
		   text="『サークル棟の場所はわかるだろ？&#32;そこにサークルの控え室と女子更衣室があるから。』" voices=""/>
		<char @l="509" id="miho" pos="auto" src="miho111"/>
		<msg @l="511" char_id="0" frame_id="-1" name="美帆" text="『えっと‥‥はい、解りました‥‥‥。』"
		   voices=""/>
		<msg @l="513" char_id="-1" frame_id="-1" name="サークル員" text="『‥‥‥‥。』"
		   voices=""/>
		<msg @l="515" char_id="-1" frame_id="-1" name="サークル員"
		   text="『あぁ、稲庭が来てなくて残念だったな。』" voices=""/>
		<char @l="518" id="miho" pos="auto" src="miho016"/>
		<msg @l="520" char_id="0" frame_id="-1" name="美帆"
		   text="『そ、そんなこと‥‥‥‥し、失礼します‥‥‥‥‥。』" voices=""/>
		<clear @l="526" class="all"/>
		<msg @l="528" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="530" char_id="0" frame_id="-1" name="美帆"
		   text="(やっぱり、私も稲庭先輩目当てで入会したと思われてるんだ‥‥)" voices=""/>
		<msg @l="532" char_id="0" frame_id="-1" name="美帆"
		   text="(でも‥‥‥絶対に違うとは言い切れない‥‥‥‥)" voices=""/>
		<msg @l="534" char_id="0" frame_id="-1" name="美帆"
		   text="(‥‥‥私‥‥‥どうしたいのかな‥‥‥‥‥)" voices=""/>
		<clear @l="540" class="all"/>
		<msgshow @l="542" show="true"/>
		<wait_chgmv/>
		<bg @l="546" src="bg14"/>
		<se @l="550" buf="1" src="部室のドア開ける" volume="1."/>
		<se @l="554" buf="1" src="部室のドア閉まる" volume="1."/>
		<char @l="558" id="miho" pos="auto" src="miho016"/>
		<msg @l="560" char_id="0" frame_id="-1" name="美帆" text="『お、お邪魔しま～す‥‥。』"
		   voices=""/>
		<msg @l="562" char_id="-1" frame_id="-1" name=""
		   text="サークル棟にあるテニスサークルの控え室を見つけて、中に入る。" voices=""/>
		<msg @l="563" char_id="-1" frame_id="-1" name=""
		   text="八畳くらいの小さな部屋の中にボールとかタオルなどが無造作に置かれていたりして、その辺はまさしく運動系サークルといった感じがした。"
		   voices=""/>
		<msg @l="564" char_id="-1" frame_id="-1" name=""
		   text="とはいえ女性比率の多いサークルだけあって、不潔という感は無い。" voices=""/>
		<char @l="568" id="miho" pos="auto" src="miho110"/>
		<msg @l="570" char_id="0" frame_id="-1" name="美帆"
		   text="(女子更衣室はあっち‥‥テニスウェアはこれを使えば良いのかな)" voices=""/>
		<msg @l="572" char_id="-1" frame_id="-1" name=""
		   text="部室の机の上にはビニール袋に包まれたテニスウェアの束が置いてあった。" voices=""/>
		<msg @l="573" char_id="-1" frame_id="-1" name=""
		   text="机の上にあるテニスウェアはどれも新品のようだから、恐らくどれでも好きなのを使って良いという事なんだろう。" voices=""/>
		<msg @l="575" char_id="0" frame_id="-1" name="美帆" text="(サイズ、大丈夫だと良いけど‥‥)"
		   voices=""/>
		<msg @l="577" char_id="-1" frame_id="-1" name=""
		   text="私は束の中からサイズの合いそうなモノを選んで取ると、同じサークル棟にある女子更衣室へと向かった‥‥。" voices=""/>
		<clear @l="583" class="all"/>
		<msgshow @l="585" show="true"/>
		<wait_chgmv/>
		<bg @l="589" src="bg13m1"/>
		<char @l="593" id="miho" pos="auto" src="miho050"/>
		<bgm @l="596" src="bgm06" volume="1."/>
		<msg @l="598" char_id="0" frame_id="-1" name="美帆" text="『あの‥‥着替えて来ました‥‥‥。』"
		   voices=""/>
		<msg @l="600" char_id="-1" frame_id="-1" name="サークル員"
		   text="『お、サイズはピッタリみたいだな。』" voices=""/>
		<msg @l="602" char_id="-1" frame_id="-1" name="サークル員"
		   text="『それに、なかなか似合ってるじゃないか‥‥。』" voices=""/>
		<msg @l="604" char_id="-1" frame_id="-1" name=""
		   text="男性部員の彼はそう言うと、私の全身を眺めた。" voices=""/>
		<char @l="608" id="miho" pos="auto" src="miho056"/>
		<msg @l="610" char_id="0" frame_id="-1" name="美帆"
		   text="(うぅ‥‥そんなにジロジロ見ないでくださいぃ‥‥‥‥)" voices=""/>
		<msg @l="612" char_id="-1" frame_id="-1" name=""
		   text="私が身をよじって恥ずかしがっていると、男性部員は私の仕草を見て嬉しそうに笑った。" voices=""/>
		<msg @l="614" char_id="-1" frame_id="-1" name="サークル員"
		   text="『新しい子は反応が新鮮でイイネ‥‥まあ、じきにそのテニスウェア姿にも慣れるよ。今は恥ずかしいかも知れないけどネ。』"
		   voices=""/>
		<msg @l="616" char_id="0" frame_id="-1" name="美帆" text="『あ‥‥はいぃ。』" voices=""/>
		<char @l="620" id="miho" pos="auto" src="miho050"/>
		<msg @l="622" char_id="0" frame_id="-1" name="美帆"
		   text="『え、えっと‥‥この後はどうしたら良いんでしょうか？』" voices=""/>
		<msg @l="624" char_id="-1" frame_id="-1" name="サークル員"
		   text="『そうだな‥‥キミ、テニス経験は無いんだろ？』" voices=""/>
		<msg @l="626" char_id="0" frame_id="-1" name="美帆" text="『あ、はい‥‥ありません。』"
		   voices=""/>
		<msg @l="628" char_id="-1" frame_id="-1" name="サークル員"
		   text="『それなら、最初はラケットの扱いに慣れるまであっちにある壁相手に壁打ちでもしてると良い。』" voices=""/>
		<msg @l="630" char_id="-1" frame_id="-1" name="サークル員"
		   text="『壁に向かってボールを打って、跳ねて戻って来たのを打ち返すんだ。』" voices=""/>
		<msg @l="632" char_id="0" frame_id="-1" name="美帆" text="『わ、わかりました。』"
		   voices=""/>
		<clear @l="636" class="char"/>
		<msg @l="638" char_id="-1" frame_id="-1" name=""
		   text="私は言われた通り、コートから少し離れたところにある丸いマークの描かれた壁を相手に練習をしてみる事にした。" voices=""/>
		<msg @l="639" char_id="-1" frame_id="-1" name=""
		   text="‥‥とはいえ、テニスに関して私は正真正銘の素人である。" voices=""/>
		<msg @l="640" char_id="-1" frame_id="-1" name=""
		   text="壁打ちどころか、まずラケットにボールを当てて真っ直ぐ壁に飛ばすという事すら上手く出来ない。" voices=""/>
		<msg @l="641" char_id="-1" frame_id="-1" name=""
		   text="私が打ったボールはなぜか右や左に大きく跳ね返り、壁に当たった後もあらぬ方向に飛んでいってしまった。" voices=""/>
		<msg @l="643" char_id="0" frame_id="-1" name="美帆"
		   text="(う、うーん‥‥なんで真っ直ぐ飛ばないの‥‥‥？)" voices=""/>
		<msg @l="645" char_id="-1" frame_id="-1" name=""
		   text="私はふと、コートの中でゲームをしている人達の動きを見てみる。" voices=""/>
		<msg @l="646" char_id="-1" frame_id="-1" name=""
		   text="彼らは軽い感じでラケットを振り、ボールを打ち返しているように見える。" voices=""/>
		<msg @l="647" char_id="-1" frame_id="-1" name=""
		   text="なのに‥‥同じようにやっても私の打ったボールはやはり明後日の方向へ飛んでいってしまう。" voices=""/>
		<msg @l="648" char_id="-1" frame_id="-1" name="" text="‥‥私やっぱり球技は苦手だなあ‥‥‥。"
		   voices=""/>
		<msg @l="650" char_id="1" frame_id="-1" name="声" text="『ふふ、一人で頑張ってるじゃない。』"
		   voices=""/>
		<char @l="654" id="miho" pos="auto" src="miho054"/>
		<msg @l="656" char_id="0" frame_id="-1" name="美帆" text="『え‥‥あ、玲さんっ！』"
		   voices=""/>
		<char @l="660" id="rei" pos="auto" src="rei051"/>
		<msg @l="662" char_id="-1" frame_id="-1" name=""
		   text="振り向くと、玲さんが楽しげな表情で私のテニスウェア姿を眺めていた。" voices=""/>
		<msg @l="664" char_id="1" frame_id="-1" name="玲" text="『なんか、初々しくて良いわね。』"
		   voices=""/>
		<clear @l="668" class="char"/>
		<char @l="670" id="rei" pos="left" src="rei050"/>
		<char @l="672" id="miho" pos="right" src="miho053"/>
		<msg @l="674" char_id="0" frame_id="-1" name="美帆" text="『うう‥‥言わないで下さい。』"
		   voices=""/>
		<msg @l="676" char_id="0" frame_id="-1" name="美帆"
		   text="『慣れない格好で、ものすごく恥ずかしいんですから‥‥。』" voices=""/>
		<char @l="680" id="rei" pos="left" src="rei051"/>
		<msg @l="682" char_id="1" frame_id="-1" name="玲" text="『ふふ、ごめんなさい。』"
		   voices=""/>
		<char @l="686" id="rei" pos="left" src="rei050"/>
		<msg @l="688" char_id="1" frame_id="-1" name="玲"
		   text="『それより‥‥ずいぶんと苦戦してたみたいね。』" voices=""/>
		<msg @l="690" char_id="1" frame_id="-1" name="玲"
		   text="『とりあえず、どうしてボールが真っ直ぐ飛ばないのか自分でも良く解らないってとこかしら？』" voices=""/>
		<char @l="694" id="miho" pos="right" src="miho056"/>
		<msg @l="696" char_id="0" frame_id="-1" name="美帆"
		   text="『はい‥‥見よう見真似でやってるつもりなんですけど‥‥‥。』" voices=""/>
		<msg @l="698" char_id="-1" frame_id="-1" name=""
		   text="そうして私は試しに何度かラケットを振ってみる。" voices=""/>
		<msg @l="700" char_id="1" frame_id="-1" name="玲" text="『ふむふむ‥‥。』" voices=""/>
		<msg @l="702" char_id="1" frame_id="-1" name="玲"
		   text="『グリップと脇が甘いのね。ボールを打つ直前でラケットが寝ちゃってるから真っ直ぐにボールが飛ばないのね。』" voices=""/>
		<char @l="706" id="miho" pos="right" src="miho054"/>
		<msg @l="708" char_id="0" frame_id="-1" name="美帆" text="『ぐりっぷ‥‥？』" voices=""/>
		<msg @l="710" char_id="1" frame_id="-1" name="玲" text="『ラケットの握り方のことよ。』"
		   voices=""/>
		<msg @l="712" char_id="1" frame_id="-1" name="玲"
		   text="『そうね。基本的なやつだと、ラケットを地面に置いて真上から普通に握った感じかしらね。』" voices=""/>
		<char @l="716" id="miho" pos="right" src="miho050"/>
		<msg @l="718" char_id="0" frame_id="-1" name="美帆" text="『こうですか？』" voices=""/>
		<msg @l="720" char_id="1" frame_id="-1" name="玲"
		   text="『そうそう。あぁ、あまり強く握っちゃダメよ。強過ぎず優し過ぎず‥‥。』" voices=""/>
		<msg @l="722" char_id="0" frame_id="-1" name="美帆" text="『こんな感じですか？』"
		   voices=""/>
		<char @l="725" id="rei" pos="left" src="rei051"/>
		<msg @l="727" char_id="1" frame_id="-1" name="玲"
		   text="『うーん。もうちょっと指を絡めるように‥‥そう。』" voices=""/>
		<msg @l="729" char_id="1" frame_id="-1" name="玲" text="『そして打つ時はギュッと強く握るのよ。』"
		   voices=""/>
		<msg @l="731" char_id="0" frame_id="-1" name="美帆" text="『こう‥‥ですか？』"
		   voices=""/>
		<char @l="734" id="rei" pos="left" src="rei054"/>
		<msg @l="736" char_id="1" frame_id="-1" name="玲" text="『そう‥‥‥って、貴方達何見てるのよ。』"
		   voices=""/>
		<msg @l="738" char_id="0" frame_id="-1" name="美帆" text="『え？』" voices=""/>
		<msg @l="740" char_id="-1" frame_id="-1" name=""
		   text="あわてて周りを見ると男性部員達が顔をにやけさせ、こちらを見ていた。" voices=""/>
		<msg @l="742" char_id="0" frame_id="-1" name="美帆" text="『あ、あの何でしょうか‥‥？』"
		   voices=""/>
		<msg @l="744" char_id="-1" frame_id="-1" name="サークル員"
		   text="『いやー、俺たちのも握ってもらいたいなー。』" voices=""/>
		<msg @l="746" char_id="-1" frame_id="-1" name="サークル員"
		   text="『そうそう、その白い指を絡めてぎゅっと握ってもらいたいよなー。』" voices=""/>
		<msg @l="748" char_id="0" frame_id="-1" name="美帆"
		   text="『え？私みたいな初心者でも良いんですか？』" voices=""/>
		<msg @l="750" char_id="-1" frame_id="-1" name="サークル員"
		   text="『へへっ、まだ下手なくらいのぎこちない方が燃えるから俺は好きだぜ！』" voices=""/>
		<char @l="753" id="rei" pos="left" src="rei057"/>
		<char @l="755" id="miho" pos="right" src="miho054"/>
		<msg @l="758" char_id="1" frame_id="-1" name="玲"
		   text="『もう！貴方達！！新入部員をからかうのは止めなさい！』" voices=""/>
		<msg @l="760" char_id="1" frame_id="-1" name="玲"
		   text="『あまり度が過ぎると稲庭さんに報告するわよ。』" voices=""/>
		<msg @l="762" char_id="-1" frame_id="-1" name="サークル員" text="『じょ、冗談だよー。なー。』"
		   voices=""/>
		<msg @l="764" char_id="-1" frame_id="-1" name="サークル員" text="『ああ、そうだよ。悪い悪い。』"
		   voices=""/>
		<msg @l="766" char_id="-1" frame_id="-1" name="サークル員"
		   text="『はいはい、向うに行きますよー、白石は怒ると怖いからなー。』" voices=""/>
		<msg @l="768" char_id="-1" frame_id="-1" name=""
		   text="そういうと部員たちはおのおの練習へと戻っていった。" voices=""/>
		<char @l="771" id="miho" pos="right" src="miho056"/>
		<msg @l="773" char_id="0" frame_id="-1" name="美帆" text="『あ、あの‥‥。何かあったんですか？』"
		   voices=""/>
		<char @l="776" id="rei" pos="left" src="rei050"/>
		<msg @l="778" char_id="1" frame_id="-1" name="玲"
		   text="『もう‥‥。ふぅ、美帆。貴方もう少し男がどういうものか学んだ方が良いわよ。』" voices=""/>
		<char @l="781" id="miho" pos="right" src="miho054"/>
		<msg @l="783" char_id="0" frame_id="-1" name="美帆" text="『はい？』" voices=""/>
		<char @l="786" id="rei" pos="left" src="rei051"/>
		<msg @l="788" char_id="1" frame_id="-1" name="玲" text="『まぁいいわ。練習続けましょう。』"
		   voices=""/>
		<char @l="791" id="miho" pos="right" src="miho051"/>
		<msg @l="793" char_id="0" frame_id="-1" name="美帆" text="『は、はい。』" voices=""/>
		<char @l="796" id="rei" pos="left" src="rei050"/>
		<msg @l="798" char_id="1" frame_id="-1" name="玲"
		   text="『じゃあ、さっきの続きね。さっき教えた握り方をしたら次は、手首じゃなくて腕全体と上半身を使って‥‥振る。』" voices=""/>
		<char @l="802" id="miho" pos="right" src="miho056"/>
		<msg @l="804" char_id="0" frame_id="-1" name="美帆"
		   text="『ん‥‥結構単純に見えて難しいですね？』" voices=""/>
		<char @l="808" id="rei" pos="left" src="rei051"/>
		<msg @l="810" char_id="1" frame_id="-1" name="玲"
		   text="『最初は慣れないと思うけど、練習しているうちに必ず良くなってくるわよ。』" voices=""/>
		<char @l="814" id="rei" pos="left" src="rei050"/>
		<msg @l="816" char_id="1" frame_id="-1" name="玲"
		   text="『とにかく、大切なのはまずグリップね。何事も初めが肝心って言うでしょう？常に正しいグリップを意識するのが重要よ。』"
		   voices=""/>
		<char @l="820" id="miho" pos="right" src="miho050"/>
		<msg @l="822" char_id="0" frame_id="-1" name="美帆"
		   text="『確かにそうですね。でもまだちょっとどんな風に振ったら良いかわからないです‥‥‥‥。』" voices=""/>
		<char @l="825" id="rei" pos="left" src="rei051"/>
		<msg @l="827" char_id="1" frame_id="-1" name="玲"
		   text="『まあ、百聞は一見にしかず‥‥とりあえず私が壁打ちをしてみせるから良く見ていて頂戴。』" voices=""/>
		<char @l="830" id="miho" pos="right" src="miho054"/>
		<msg @l="832" char_id="0" frame_id="-1" name="美帆" text="『は、はいっ。』" voices=""/>
		<clear @l="838" class="all"/>
		<msgshow @l="840" show="true"/>
		<bgm @l="843" src="bgm04" volume="1."/>
		<wait_chgmv/>
		<bg @l="847" src="bg13m2"/>
		<char @l="851" id="miho" pos="auto" src="miho056"/>
		<msg @l="853" char_id="0" frame_id="-1" name="美帆"
		   text="『‥‥テニスって思った以上に難しいですね。』" voices=""/>
		<msg @l="855" char_id="-1" frame_id="-1" name=""
		   text="玲さんの丁寧な指導を受けたにも関わらず、私は上達という言葉とは全く無縁かのようにボールを明後日の方向へ飛ばしてしまっていた。"
		   voices=""/>
		<msg @l="856" char_id="-1" frame_id="-1" name=""
		   text="玲さんに言われる通り、跳ね返って来るボールを正面に捉えて打ち返しているつもりなのだけれど‥‥どうにも上手く飛んでくれない。"
		   voices=""/>
		<clear @l="859" class="char"/>
		<char @l="861" id="miho" pos="left" src="miho056"/>
		<char @l="864" id="rei" pos="right" src="rei051"/>
		<msg @l="866" char_id="1" frame_id="-1" name="玲"
		   text="『まあ、皆すぐには上手くいかないものよ‥‥。』" voices=""/>
		<msg @l="868" char_id="1" frame_id="-1" name="玲"
		   text="『とにかく腰を据えて、慣れていく所から始めた方が良いと思うわ。』" voices=""/>
		<char @l="872" id="miho" pos="left" src="miho051"/>
		<msg @l="874" char_id="0" frame_id="-1" name="美帆" text="『はい‥‥頑張ります。』"
		   voices=""/>
		<clear @l="877" class="char"/>
		<char @l="881" id="inaba" pos="auto" src="inaba050"/>
		<msg @l="883" char_id="-1" frame_id="-1" name="稲庭" text="『やあ、早速来てくれたみたいだね。』"
		   voices=""/>
		<clear @l="886" class="char"/>
		<char @l="888" id="inaba" pos="left" src="inaba050"/>
		<char @l="890" id="miho" pos="right" src="miho051"/>
		<msg @l="892" char_id="0" frame_id="-1" name="美帆" text="『あ、稲庭先輩‥‥。』"
		   voices=""/>
		<msg @l="894" char_id="-1" frame_id="-1" name="稲庭"
		   text="『白石くんも、就職活動で忙しいのにサークル員の面倒まで見させちゃって悪いね。』" voices=""/>
		<char @l="898" id="rei" pos="right" src="rei050"/>
		<msg @l="900" char_id="1" frame_id="-1" name="玲" text="『良いのよ、私が好きでやってるだけよ。』"
		   voices=""/>
		<char @l="904" id="rei" pos="right" src="rei051"/>
		<msg @l="906" char_id="1" frame_id="-1" name="玲"
		   text="『それに稲庭さんのご多忙ぶりに比べたら、私なんてまだ暇な方だわ。』" voices=""/>
		<char @l="910" id="rei" pos="right" src="rei050"/>
		<msg @l="912" char_id="1" frame_id="-1" name="玲"
		   text="『聞いたわよ、次の大会に出場するつもりなんですって？』" voices=""/>
		<msg @l="914" char_id="-1" frame_id="-1" name="稲庭"
		   text="『相変らず耳が早いなぁ、白石くんは。』" voices=""/>
		<msg @l="916" char_id="1" frame_id="-1" name="玲"
		   text="『まったく‥‥卒業論文だけでも大変なのに、大会にも出場してたんじゃ身が持たないわよ。』" voices=""/>
		<msg @l="918" char_id="-1" frame_id="-1" name="稲庭"
		   text="『まあ、僕だって別に大会に固執してる訳ではないんだけど‥‥。』" voices=""/>
		<msg @l="920" char_id="-1" frame_id="-1" name="稲庭"
		   text="『周りがね、どうしても出場しろって言うんだよ。』" voices=""/>
		<msg @l="922" char_id="1" frame_id="-1" name="玲"
		   text="『それだけ期待されているんでしょうけどね、無理はしない方が良いと思うわよ。』" voices=""/>
		<msg @l="924" char_id="-1" frame_id="-1" name="稲庭"
		   text="『大丈夫、自分の身体のことは自分が一番良く解ってるよ。』" voices=""/>
		<char @l="928" id="rei" pos="right" src="rei051"/>
		<msg @l="930" char_id="1" frame_id="-1" name="玲" text="『だといいけどね‥‥。』"
		   voices=""/>
		<msg @l="932" char_id="-1" frame_id="-1" name="稲庭"
		   text="『それより、キミの方はどうなんだい？』" voices=""/>
		<msg @l="934" char_id="-1" frame_id="-1" name="稲庭"
		   text="『確か‥‥大黒建設の初めの試験がそろそろなんだろ？』" voices=""/>
		<char @l="938" id="rei" pos="right" src="rei050"/>
		<msg @l="940" char_id="1" frame_id="-1" name="玲"
		   text="『ええ、筆記試験は終わったから‥‥次は上手くすれば面接ね。』" voices=""/>
		<msg @l="942" char_id="-1" frame_id="-1" name="稲庭"
		   text="『そうか、ここからが本番だね。でも、まさか白石くんも僕が就職する会社と同じところを受けるとはね。もし一緒に内定したら、二人で大黒建設テニス部でも作ろうか？』"
		   voices=""/>
		<msg @l="944" char_id="1" frame_id="-1" name="玲"
		   text="『ふふっ、そうね。また一緒にテニスが出来るように頑張るわ。』" voices=""/>
		<char @l="947" id="miho" pos="center" src="miho054f" y="-80"/>
		<msg @l="949" char_id="0" frame_id="1" name="美帆"
		   text="（えっ？同じ会社‥‥。そうか、玲さんが受ける会社、稲庭先輩と一緒の会社なんだ‥‥。もしかして玲さん、稲庭先輩と同じ会社に入りたいから‥‥？）"
		   voices=""/>
		<stopbgm @l="953" fadeout="1000"/>
		<char @l="957" id="miho" pos="center" src="miho055f" y="-80"/>
		<bgm @l="961" src="bgm03" volume="1."/>
		<msg @l="963" char_id="0" frame_id="1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<description @l="973" text="揺れるココロ"/>
		<msg @l="975" char_id="0" frame_id="1" name="美帆" text="(なんか私‥‥居場所がないな‥‥‥)"
		   voices=""/>
		<msg @l="977" char_id="-1" frame_id="-1" name=""
		   text="私は、二人の先輩の間に挟まれる形で‥‥一人押し黙っていた。" voices=""/>
		<msg @l="978" char_id="-1" frame_id="-1" name=""
		   text="同学年で置かれている立場が似通っている為か、二人の会話には私の入る隙間がない気がした。" voices=""/>
		<msg @l="979" char_id="-1" frame_id="-1" name=""
		   text="就職活動のことやテニスサークルのことについても、私の知らない世界の話題ばかりだった。" voices=""/>
		<msg @l="980" char_id="-1" frame_id="-1" name=""
		   text="共通の話題がある二人の関係が凄くうらやましく感じた。" voices=""/>
		<msg @l="981" char_id="-1" frame_id="-1" name=""
		   text="その気持ちと一緒に、なぜかもの悲しい気持ちになってくる‥‥。" voices=""/>
		<msg @l="982" char_id="-1" frame_id="-1" name=""
		   text="何となく‥‥仲が良いと思っていた友達が、自分の前で他の友達との会話に華を咲かせているような感じに、似ているからなのだろうか？"
		   voices=""/>
		<msg @l="983" char_id="-1" frame_id="-1" name=""
		   text="自分の居場所を取られてしまったかのような喪失感。" voices=""/>
		<msg @l="984" char_id="-1" frame_id="-1" name=""
		   text="玲さんのことは、常日頃から尊敬しているし、稲庭先輩に対しても、優しくて良い先輩なのだと思えるようになった。" voices=""/>
		<msg @l="985" char_id="-1" frame_id="-1" name=""
		   text="その二人が自分を除いて仲良くしているコトに‥‥嫉妬しているのだろうか？" voices=""/>
		<msg @l="986" char_id="-1" frame_id="-1" name="" text="けれど、本当にそれだけなのだろうか‥‥。"
		   voices=""/>
		<msg @l="988" char_id="0" frame_id="1" name="美帆" text="(自分の気持ちがわからない‥‥)"
		   voices=""/>
		<msg @l="990" char_id="0" frame_id="1" name="美帆"
		   text="(他の誰でもない自分のことなのに‥‥どうして)" voices=""/>
		<msg @l="992" char_id="0" frame_id="1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="994" char_id="0" frame_id="1" name="美帆"
		   text="(私‥‥なんでこんな気持ちになるのかな‥‥‥)" voices=""/>
		<char @l="998" id="rei" pos="right" src="rei054" z="100"/>
		<msg @l="1000" char_id="1" frame_id="-1" name="玲" text="『美帆‥‥どうしたの、美帆？』"
		   voices=""/>
		<clear @l="1007" class="char"/>
		<bgm @l="1011" src="bgm02" volume="1."/>
		<char @l="1015" id="miho" pos="left" src="miho054"/>
		<msg @l="1018" char_id="0" frame_id="1" name="美帆" text="『え‥‥あ、はいっ？』"
		   voices=""/>
		<char @l="1021" id="rei" pos="right" src="rei050"/>
		<msg @l="1023" char_id="1" frame_id="-1" name="玲"
		   text="『大丈夫？&#32;ぼうっとしてたみたいだけど。』" voices=""/>
		<char @l="1027" id="miho" pos="left" src="miho056"/>
		<msg @l="1029" char_id="0" frame_id="1" name="美帆" text="『あ、はい‥‥なんでもないです。』"
		   voices=""/>
		<msg @l="1031" char_id="1" frame_id="-1" name="玲" text="『そう？』" voices=""/>
		<clear @l="1034" class="char"/>
		<char @l="1038" id="inaba" pos="left" src="inaba050"/>
		<char @l="1040" id="miho" pos="right" src="miho056"/>
		<msg @l="1042" char_id="-1" frame_id="-1" name="稲庭"
		   text="『入会してまだ初日だから、疲れたのかもしれないね。』" voices=""/>
		<msg @l="1044" char_id="0" frame_id="1" name="美帆"
		   text="『そうですね‥‥特に、何にもしてないはずなんですけど‥‥。』" voices=""/>
		<msg @l="1046" char_id="-1" frame_id="-1" name=""
		   text="正確には壁打ちをしていたのと、玲さんの指導を受けながらラケットの振り方を試していただけ‥‥だ。" voices=""/>
		<msg @l="1047" char_id="-1" frame_id="-1" name=""
		   text="こんなにも体力が落ちているとは思わなかった。" voices=""/>
		<msg @l="1049" char_id="-1" frame_id="-1" name="稲庭"
		   text="『無理をして身体を壊すと大変だ。今日はこの辺にして休んだ方が良いと思うよ。』" voices=""/>
		<msg @l="1051" char_id="-1" frame_id="-1" name="稲庭"
		   text="『白石くんも、今日は彼女の付き添いであがっていいから。』" voices=""/>
		<char @l="1055" id="rei" pos="right" src="rei050"/>
		<msg @l="1057" char_id="1" frame_id="-1" name="玲"
		   text="『そうね‥‥それじゃ、お言葉に甘えてそうさせてもらおうかしら。』" voices=""/>
		<char @l="1061" id="miho" pos="left" src="miho056"/>
		<msg @l="1063" char_id="0" frame_id="1" name="美帆" text="『すみません‥‥。』"
		   voices=""/>
		<msg @l="1065" char_id="1" frame_id="-1" name="玲"
		   text="『本当にすまないと思うなら、きっちり休んで疲れを取ること。』" voices=""/>
		<char @l="1068" id="rei" pos="right" src="rei051"/>
		<msg @l="1070" char_id="1" frame_id="-1" name="玲"
		   text="『しっかりと体調管理する事も大切なのよ？』" voices=""/>
		<char @l="1074" id="miho" pos="left" src="miho050"/>
		<msg @l="1076" char_id="0" frame_id="1" name="美帆" text="『は、はいっ。』" voices=""/>
		<char @l="1080" id="inaba" pos="left" src="inaba050"/>
		<msg @l="1082" char_id="-1" frame_id="-1" name="稲庭"
		   text="『それじゃあ僕は少し後輩たちとゲームでもして、それから帰るよ。』" voices=""/>
		<char @l="1086" id="rei" pos="right" src="rei051"/>
		<msg @l="1088" char_id="1" frame_id="-1" name="玲" text="『あんまり後輩のこと苛めちゃダメよ。』"
		   voices=""/>
		<msg @l="1090" char_id="-1" frame_id="-1" name="稲庭" text="『あはは、肝に命じておくよ。』"
		   voices=""/>
		<clear @l="1096" class="all"/>
		<msgshow @l="1098" show="true"/>
		<bgm @l="1101" src="bgm04" volume="1."/>
		<wait_chgmv/>
		<bg @l="1105" src="bg14a"/>
		<se @l="1109" buf="1" src="部室のドア開ける" volume="1."/>
		<se @l="1113" buf="1" src="部室のドア閉まる" volume="1."/>
		<char @l="1117" id="miho" pos="left" src="miho050"/>
		<char @l="1121" id="rei" pos="right" src="rei050"/>
		<msg @l="1123" char_id="1" frame_id="-1" name="玲" text="『‥‥ふぅ。』" voices=""/>
		<char @l="1127" id="rei" pos="right" src="rei051"/>
		<msg @l="1129" char_id="1" frame_id="-1" name="玲"
		   text="『さすがにこの時期ともなると、半袖でも暑いわね。』" voices=""/>
		<msg @l="1131" char_id="0" frame_id="1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<char @l="1135" id="rei" pos="right" src="rei050"/>
		<msg @l="1137" char_id="1" frame_id="-1" name="玲" text="『美帆‥‥？』" voices=""/>
		<char @l="1141" id="miho" pos="left" src="miho054"/>
		<msg @l="1143" char_id="0" frame_id="1" name="美帆"
		   text="『え‥‥‥あ、ああ‥‥はい、そうですね。』" voices=""/>
		<char @l="1147" id="rei" pos="right" src="rei054"/>
		<msg @l="1149" char_id="1" frame_id="-1" name="玲" text="『疲れ‥‥そんなにひどい？』"
		   voices=""/>
		<char @l="1153" id="miho" pos="left" src="miho056"/>
		<msg @l="1155" char_id="0" frame_id="1" name="美帆"
		   text="『あ、いえ‥‥少し身体が重い程度ですから。』" voices=""/>
		<char @l="1159" id="rei" pos="right" src="rei050"/>
		<msg @l="1161" char_id="1" frame_id="-1" name="玲"
		   text="『それじゃあ、とりあえずさっさと着替えて帰りましょうか。』" voices=""/>
		<msg @l="1163" char_id="1" frame_id="-1" name="玲"
		   text="『今日の夕食当番は私だし、腕によりをかけてスタミナのつくヤツを用意してあげるわよ。』" voices=""/>
		<char @l="1167" id="miho" pos="left" src="miho050"/>
		<msg @l="1169" char_id="0" frame_id="1" name="美帆"
		   text="『そんなこと言うと、過剰に期待しちゃいますよ？』" voices=""/>
		<char @l="1173" id="rei" pos="right" src="rei051"/>
		<msg @l="1175" char_id="1" frame_id="-1" name="玲"
		   text="『もちろん、バッチリ期待して良いわよ。』" voices=""/>
		<msg @l="1177" char_id="1" frame_id="-1" name="玲"
		   text="『特製スタミナ料理をたっぷりご馳走してあげるわ。』" voices=""/>
		<char @l="1181" id="miho" pos="left" src="miho051"/>
		<msg @l="1183" char_id="0" frame_id="1" name="美帆" text="『あはは‥‥。』" voices=""/>
		<stopbgm @l="1186" fadeout="1000"/>
		<se @l="1190" buf="3" loop="true" src="着メロ2" volume="1."/>
		<char @l="1194" id="miho" pos="left" src="miho054"/>
		<msg @l="1196" char_id="0" frame_id="1" name="美帆" text="『あ、電話‥‥私のかな？』"
		   voices=""/>
		<char @l="1200" id="rei" pos="right" src="rei050"/>
		<msg @l="1202" char_id="1" frame_id="-1" name="玲"
		   text="『あら、それじゃあ私は先に着替えに行ってるわよ？』" voices=""/>
		<char @l="1206" id="miho" pos="left" src="miho050"/>
		<msg @l="1208" char_id="0" frame_id="1" name="美帆" text="『はい。終わったら私も行きますから。』"
		   voices=""/>
		<msg @l="1210" char_id="1" frame_id="-1" name="玲" text="『ふふ、ごゆっくり。』"
		   voices=""/>
		<clear @l="1214" layer="rei"/>
		<msg @l="1216" char_id="-1" frame_id="-1" name=""
		   text="玲さんはそう言って意味ありげに笑うと、ロッカーから荷物と着替えを取り出して控え室の外へ出た。" voices=""/>
		<msg @l="1218" char_id="0" frame_id="1" name="美帆" text="『‥‥？』" voices=""/>
		<char @l="1222" id="miho" pos="left" src="miho054"/>
		<msg @l="1224" char_id="0" frame_id="1" name="美帆" text="『あっと‥‥電話、出なくちゃ。』"
		   voices=""/>
		<clear @l="1228" layer="miho"/>
		<msg @l="1230" char_id="-1" frame_id="-1" name=""
		   text="私は慌ててロッカーの中からカバンを引っ張り出し、携帯を取り出した。" voices=""/>
		<msg @l="1231" char_id="-1" frame_id="-1" name=""
		   text="携帯電話のディスプレイには、友達の名前が表示されていた。" voices=""/>
		<stopse @l="1235" buf="3"/>
		<se @l="1239" buf="1" src="携帯ボタン押下音" volume="1."/>
		<char @l="1243" id="miho" pos="auto" src="miho050"/>
		<msg @l="1245" char_id="0" frame_id="1" name="美帆" text="『もしもし、お待たせ～。』"
		   voices=""/>
		<bgm @l="1248" src="bgm06" volume="1."/>
		<msg @l="1250" char_id="-1" frame_id="-1" name="女友達" text="『美帆、聞いたよっ！！』"
		   voices=""/>
		<char @l="1254" id="miho" pos="auto" src="miho054"/>
		<msg @l="1256" char_id="0" frame_id="1" name="美帆"
		   text="『わっ、いきなり大きな声出してどうしたの‥‥？』" voices=""/>
		<msg @l="1258" char_id="-1" frame_id="-1" name="女友達"
		   text="『しらばっくれても無駄なんだから！』" voices=""/>
		<msg @l="1260" char_id="-1" frame_id="-1" name="女友達"
		   text="『あなた、テニスサークルに入会したんだって！？』" voices=""/>
		<char @l="1264" id="miho" pos="auto" src="miho054"/>
		<msg @l="1266" char_id="0" frame_id="1" name="美帆"
		   text="『あ‥‥そういえば、言ってなかったっけ？』" voices=""/>
		<msg @l="1268" char_id="-1" frame_id="-1" name="女友達" text="『ひと言も聞いてません！』"
		   voices=""/>
		<char @l="1272" id="miho" pos="auto" src="miho056"/>
		<msg @l="1274" char_id="0" frame_id="1" name="美帆" text="『ご、ごめん‥‥。』"
		   voices=""/>
		<msg @l="1276" char_id="0" frame_id="1" name="美帆"
		   text="『報告が遅れたのは悪いと思うけど‥‥でも、今日は取ってる講義が違ったから仕方ないじゃない。』" voices=""/>
		<msg @l="1278" char_id="-1" frame_id="-1" name="女友達"
		   text="『他のことなら許したかもだけど、稲庭先輩に関することでの抜け駆けは許さーーーん！』" voices=""/>
		<char @l="1282" id="miho" pos="auto" src="miho054"/>
		<msg @l="1284" char_id="0" frame_id="1" name="美帆"
		   text="『そんな‥‥別に抜け駆けなんてしてないよっ。』" voices=""/>
		<msg @l="1286" char_id="0" frame_id="1" name="美帆"
		   text="『大体、私は稲庭先輩のこと‥‥‥なんとも思ってないし。』" voices=""/>
		<msg @l="1288" char_id="-1" frame_id="-1" name="女友達" text="『なによ、その妙な間はっ。』"
		   voices=""/>
		<char @l="1292" id="miho" pos="auto" src="miho056"/>
		<msg @l="1294" char_id="0" frame_id="1" name="美帆" text="『な、なんでもないよ‥‥。』"
		   voices=""/>
		<msg @l="1296" char_id="-1" frame_id="-1" name="女友達" text="『はは～ん。』"
		   voices=""/>
		<msg @l="1298" char_id="0" frame_id="1" name="美帆" text="『な、なに‥‥？』" voices=""/>
		<msg @l="1300" char_id="-1" frame_id="-1" name="女友達" text="『あんた、稲庭先輩に惚れたな。』"
		   voices=""/>
		<char @l="1304" id="miho" pos="auto" src="miho054"/>
		<msg @l="1306" char_id="0" frame_id="1" name="美帆" text="『え‥‥。』" voices=""/>
		<msg @l="1308" char_id="-1" frame_id="-1" name="女友達"
		   text="『ついに美帆も稲庭先輩の魅力にメロメロなのねっ！』" voices=""/>
		<char @l="1312" id="miho" pos="auto" src="miho056"/>
		<msg @l="1314" char_id="0" frame_id="1" name="美帆" text="『め、メロメロって‥‥。』"
		   voices=""/>
		<msg @l="1316" char_id="0" frame_id="1" name="美帆" text="『別にそんなことない‥‥‥と思うよ。』"
		   voices=""/>
		<msg @l="1318" char_id="-1" frame_id="-1" name="女友達"
		   text="『ハッキリ否定しないところがアヤシイわ。』" voices=""/>
		<msg @l="1320" char_id="0" frame_id="1" name="美帆" text="『もう、からかわないでよ‥‥。』"
		   voices=""/>
		<msg @l="1322" char_id="-1" frame_id="-1" name="女友達" text="『からかってなんかないわよ。』"
		   voices=""/>
		<msg @l="1324" char_id="-1" frame_id="-1" name="女友達"
		   text="『昨日の見学会で美帆と稲庭先輩が楽しそうに話してたのを見たって子が、しっかりバッチリ居るんだからね。』" voices=""/>
		<msg @l="1326" char_id="0" frame_id="1" name="美帆" text="『うぅ‥‥。』" voices=""/>
		<msg @l="1328" char_id="-1" frame_id="-1" name=""
		   text="確かに‥‥そういう場面もあったかもしれない。" voices=""/>
		<msg @l="1329" char_id="-1" frame_id="-1" name=""
		   text="けれどそれは私がどうこうした訳ではなく、偶然、稲庭先輩と会って少し話をしたというだけの事だ。" voices=""/>
		<msg @l="1331" char_id="0" frame_id="1" name="美帆"
		   text="(といっても、やっぱり他の人から見れば仲良くしてたように見えちゃうんだろうな‥‥)" voices=""/>
		<msg @l="1333" char_id="-1" frame_id="-1" name=""
		   text="実際に、部員の人は私と稲庭先輩を結びつけて考えていた。" voices=""/>
		<msg @l="1334" char_id="-1" frame_id="-1" name=""
		   text="多感な年頃‥‥というには少し遅いかもしれないけれど、自然とそういう方面の話題に繋がってしまうのは仕方ない。" voices=""/>
		<msg @l="1335" char_id="-1" frame_id="-1" name=""
		   text="ただ‥‥それをこう「真」に受けられてしまうのは、どうにも不本意だ。" voices=""/>
		<msg @l="1336" char_id="-1" frame_id="-1" name=""
		   text="そう、私にとってそれは‥‥‥不本意でなくちゃならない。" voices=""/>
		<msg @l="1338" char_id="-1" frame_id="-1" name="女友達" text="『この、だんまりは卑怯だぞっ。』"
		   voices=""/>
		<char @l="1341" id="miho" pos="auto" src="miho054"/>
		<msg @l="1343" char_id="0" frame_id="1" name="美帆" text="『だんまりなんて‥‥。』"
		   voices=""/>
		<msg @l="1345" char_id="0" frame_id="1" name="美帆"
		   text="『それに私は、ルームメイトの先輩がいるからテニスサークルに入っただけで‥‥別に稲庭先輩目当てってワケじゃないよ。』"
		   voices=""/>
		<msg @l="1347" char_id="-1" frame_id="-1" name="女友達"
		   text="『じゃあなんでそのルームメイトの先輩じゃなくて、稲庭先輩と話なんてしちゃってるのよ。』" voices=""/>
		<char @l="1350" id="miho" pos="auto" src="miho056"/>
		<msg @l="1352" char_id="0" frame_id="1" name="美帆"
		   text="『それは‥‥見学会の日はルームメイトの先輩が来てなくて‥‥‥。』" voices=""/>
		<msg @l="1354" char_id="-1" frame_id="-1" name="女友達"
		   text="『ああ、そういえば稲庭先輩にお誘いされた時に何か言ってたわね。』" voices=""/>
		<msg @l="1356" char_id="-1" frame_id="-1" name="女友達" text="『確か、白石先輩とかって‥‥。』"
		   voices=""/>
		<msg @l="1358" char_id="0" frame_id="1" name="美帆" text="『そうそう、だから私は別に‥‥‥。』"
		   voices=""/>
		<msg @l="1360" char_id="-1" frame_id="-1" name="女友達" text="『あ、わかった。』"
		   voices=""/>
		<msg @l="1362" char_id="0" frame_id="1" name="美帆" text="『わ、わかったって‥‥何が？』"
		   voices=""/>
		<msg @l="1364" char_id="-1" frame_id="-1" name="女友達"
		   text="『あんた、その白石先輩に遠慮してるんでしょ？』" voices=""/>
		<char @l="1368" id="miho" pos="auto" src="miho054"/>
		<bgm @l="1371" src="bgm07" volume="1."/>
		<msg @l="1373" char_id="0" frame_id="1" name="美帆" text="『え‥‥。』" voices=""/>
		<msg @l="1375" char_id="-1" frame_id="-1" name="女友達"
		   text="『テニスサークルの白石玲っていえば、稲庭先輩と付き合ってるんじゃないかって噂の人じゃない。』" voices=""/>
		<msg @l="1377" char_id="0" frame_id="1" name="美帆" text="(‥‥そうなんだ)" voices=""/>
		<msg @l="1379" char_id="-1" frame_id="-1" name="女友達"
		   text="『だからあんた、自分も稲庭先輩のこと好きになったらルームメイトの先輩とライバルになるからって‥‥遠慮してるんでしょ。』"
		   voices=""/>
		<char @l="1382" id="miho" pos="auto" src="miho056"/>
		<msg @l="1384" char_id="0" frame_id="1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="1386" char_id="-1" frame_id="-1" name="" text="確かにその通りだった。"
		   voices=""/>
		<msg @l="1387" char_id="-1" frame_id="-1" name=""
		   text="これまで考えないようにと回避していたけれど、ようするに私は玲さんの気持ちに遠慮をして‥‥。" voices=""/>
		<msg @l="1388" char_id="-1" frame_id="-1" name=""
		   text="だから稲庭先輩の事も「何とも思ってない」のだと決め付けて考えていた。" voices=""/>
		<msg @l="1389" char_id="-1" frame_id="-1" name=""
		   text="そんな状態で自分の気持ちを探ってみたところで、モヤモヤとした煮え切らない思いしか浮かんでこないのは当然だったかもしれない‥‥。"
		   voices=""/>
		<msg @l="1391" char_id="-1" frame_id="-1" name="女友達"
		   text="『沈黙は肯定の意思表示だと思っていいのかな～？』" voices=""/>
		<char @l="1395" id="miho" pos="auto" src="miho054"/>
		<msg @l="1397" char_id="0" frame_id="1" name="美帆" text="『あ‥‥ま、待って。』"
		   voices=""/>
		<char @l="1400" id="miho" pos="auto" src="miho056"/>
		<msg @l="1402" char_id="0" frame_id="1" name="美帆"
		   text="『確かに‥‥少しは遠慮してる所もあるかもしれないけど‥‥‥。』" voices=""/>
		<msg @l="1404" char_id="0" frame_id="1" name="美帆"
		   text="『だからって私は別に‥‥そんな‥‥‥。』" voices=""/>
		<msg @l="1406" char_id="-1" frame_id="-1" name="女友達"
		   text="『じゃあ、その白石先輩に稲庭先輩のこと取られちゃっても良いんだ？』" voices=""/>
		<char @l="1410" id="miho" pos="auto" src="miho054"/>
		<msg @l="1412" char_id="0" frame_id="1" name="美帆" text="『とっ、取るって‥‥‥そんな。』"
		   voices=""/>
		<msg @l="1414" char_id="-1" frame_id="-1" name="女友達"
		   text="『要するにそういうことじゃない。』" voices=""/>
		<msg @l="1416" char_id="-1" frame_id="-1" name="女友達"
		   text="『美帆が遠慮して自分の気持ちに知らんぷりしてるうちに、稲庭先輩と白石先輩がくっついちゃったらどーすんのよ。』" voices=""/>
		<char @l="1420" id="miho" pos="auto" src="miho056"/>
		<msg @l="1422" char_id="0" frame_id="1" name="美帆"
		   text="『それはもちろん‥‥応援‥‥‥‥‥すると思うけど。』" voices=""/>
		<msg @l="1424" char_id="-1" frame_id="-1" name="女友達"
		   text="『あーもう、あんた、つくづくお人好しね！！』" voices=""/>
		<msg @l="1426" char_id="-1" frame_id="-1" name="女友達"
		   text="『それで良いの？&#32;あんたの気持ちはそれで納得するワケ！？』" voices=""/>
		<char @l="1429" id="miho" pos="auto" src="miho054"/>
		<msg @l="1431" char_id="0" frame_id="1" name="美帆" text="『私の気持ち‥‥？』"
		   voices=""/>
		<msg @l="1433" char_id="-1" frame_id="-1" name="女友達"
		   text="『そう！&#32;他人じゃなくてあんたの気持ちよっ！！』" voices=""/>
		<msg @l="1435" char_id="-1" frame_id="-1" name="女友達"
		   text="『ルームメイトの先輩がどうとか関係ない、肝心なのはあんた自身が稲庭先輩のことをどう思ってるかって事なんじゃない？』"
		   voices=""/>
		<msg @l="1437" char_id="-1" frame_id="-1" name=""
		   text="気づけばいつの間にか友達の子は白熱して、半ば恋愛相談をしているような口ぶりになっていた。" voices=""/>
		<msg @l="1438" char_id="-1" frame_id="-1" name=""
		   text="彼女としては私から本意を聞き出したい一心なのだろうけど‥‥。" voices=""/>
		<msg @l="1440" char_id="0" frame_id="1" name="美帆"
		   text="(そういえば私、玲さんの気持ちを聞いてから‥‥稲庭先輩に対して一歩下がって接してた気がする)" voices=""/>
		<msg @l="1442" char_id="0" frame_id="1" name="美帆"
		   text="(でもそれは別に私自身の気持ちとは全然関係なくて‥‥)" voices=""/>
		<msg @l="1444" char_id="0" frame_id="1" name="美帆"
		   text="(全部‥‥玲さんに遠慮してただけなんだ‥‥‥)" voices=""/>
		<msg @l="1446" char_id="0" frame_id="1" name="美帆"
		   text="(なら、私自身の気持ちはどうなんだろう‥‥？)" voices=""/>
		<msg @l="1448" char_id="0" frame_id="1" name="美帆" text="(私は‥‥)" voices=""/>
		<msg @l="1454" async="true" char_id="-1" frame_id="-1" name=""
		   text="私の気持ちは‥‥？" voices=""/>
		<select @l="1455">
			<menu @l="1457" label="EventLabel_36" text="稲庭先輩が好き"/>
			<menu @l="1459" label="EventLabel_37" text="玲さんを応援したい"/>
		</select>
		<label @l="1466" id="EventLabel_36"/>
		<description @l="1470" text="想いに気づくとき"/>
		<char @l="1473" id="miho" pos="auto" src="miho050"/>
		<msg @l="1475" char_id="0" frame_id="1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="1477" char_id="0" frame_id="1" name="美帆" text="『私‥‥そうなのかもしれない。』"
		   voices=""/>
		<msg @l="1479" char_id="-1" frame_id="-1" name="女友達" text="『うん？』" voices=""/>
		<msg @l="1481" char_id="0" frame_id="1" name="美帆" text="『稲庭先輩のこと‥‥‥私‥‥‥‥。』"
		   voices=""/>
		<se @l="1485" buf="1" src="ドアの向こうで物音_バッグを落とすような感じ" volume="1."/>
		<stopbgm @l="1488" fadeout="1000"/>
		<char @l="1492" id="miho" pos="auto" src="miho054"/>
		<msg @l="1494" char_id="0" frame_id="1" name="美帆"
		   text="『あ‥‥先輩、戻って来ちゃったみたい！』" voices=""/>
		<msg @l="1496" char_id="-1" frame_id="-1" name="女友達"
		   text="『え、あんた今、稲庭先輩と一緒なのっ！？』" voices=""/>
		<msg @l="1498" char_id="0" frame_id="1" name="美帆" text="『ち、違うよ‥‥ルームメイトの先輩。』"
		   voices=""/>
		<msg @l="1500" char_id="-1" frame_id="-1" name="女友達" text="『ああ、白石先輩か。』"
		   voices=""/>
		<msg @l="1502" char_id="0" frame_id="1" name="美帆" text="『それじゃあ、もう切るね。』"
		   voices=""/>
		<msg @l="1504" char_id="-1" frame_id="-1" name="女友達" text="『あ、ちょっとっ！』"
		   voices=""/>
		<msg @l="1506" char_id="0" frame_id="1" name="美帆" text="『また電話するから、ごめんっ。』"
		   voices=""/>
		<se @l="1510" buf="1" src="携帯ボタン押下音" volume="1."/>
		<char @l="1514" id="miho" pos="auto" src="miho050"/>
		<msg @l="1516" char_id="0" frame_id="1" name="美帆" text="『‥‥ふぅ。』" voices=""/>
		<se @l="1520" buf="1" src="部室のドア開ける" volume="1."/>
		<clear @l="1523" class="char"/>
		<char @l="1525" id="miho" pos="left" src="miho050"/>
		<char @l="1528" id="rei" pos="right" src="rei010"/>
		<bgm @l="1532" src="bgm02" volume="1."/>
		<msg @l="1534" char_id="1" frame_id="-1" name="玲" text="『‥‥どう、電話は終わった？』"
		   voices=""/>
		<msg @l="1536" char_id="-1" frame_id="-1" name=""
		   text="タイミングよく‥‥というかギリギリの所で、玲さんが控え室に入ってくる。" voices=""/>
		<char @l="1539" id="miho" pos="left" src="miho056"/>
		<msg @l="1541" char_id="0" frame_id="1" name="美帆"
		   text="『すみません‥‥なんか、長話になっちゃって。』" voices=""/>
		<msg @l="1543" char_id="1" frame_id="-1" name="玲" text="『みたいね。相手はお友達だったの？』"
		   voices=""/>
		<char @l="1547" id="miho" pos="left" src="miho054"/>
		<msg @l="1549" char_id="0" frame_id="1" name="美帆" text="『え、ああ‥‥そうですよ？』"
		   voices=""/>
		<msg @l="1551" char_id="1" frame_id="-1" name="玲" text="『そう、仲が良さそうでなによりね。』"
		   voices=""/>
		<msg @l="1553" char_id="1" frame_id="-1" name="玲" text="『それより‥‥早く着替えてきなさい。』"
		   voices=""/>
		<msg @l="1555" char_id="1" frame_id="-1" name="玲"
		   text="『最近この辺で不審な男がうろついてるって話、前にしたでしょ。日が暮れると危ないわよ。』" voices=""/>
		<char @l="1559" id="miho" pos="left" src="miho050"/>
		<msg @l="1561" char_id="0" frame_id="1" name="美帆" text="『あ、はいっ。』" voices=""/>
		<clear @l="1565" layer="miho"/>
		<msg @l="1567" char_id="-1" frame_id="-1" name=""
		   text="私は玲さんの言葉に後押しされるように控え室を出て行く。" voices=""/>
		<stopbgm @l="1571" fadeout="1000"/>
		<msg @l="1573" char_id="1" frame_id="-1" name="玲" text="『‥‥‥‥。』" voices=""/>
		<char @l="1576" id="rei" pos="right" src="rei015"/>
		<msg @l="1578" char_id="1" frame_id="-1" name="玲"
		   text="『美帆‥‥あなたも‥‥稲庭さんが‥‥。』" voices=""/>
		<msg @l="1580" char_id="-1" frame_id="-1" name=""
		   text="‥‥玲さんのつぶやきは、私には届かなかった。" voices=""/>
		<clear @l="1586" class="all"/>
		<msgshow @l="1588" show="true"/>
		<wait_chgmv/>
		<bg @l="1592" src="bg07b"/>
		<bgm @l="1596" src="bgm05" volume="1."/>
		<char @l="1600" id="rei" pos="auto" src="rei010"/>
		<msg @l="1602" char_id="1" frame_id="-1" name="玲"
		   text="『ずいぶん日も長くなったけど、まだ夏っていうには早いかしらね。』" voices=""/>
		<msg @l="1604" char_id="1" frame_id="-1" name="玲"
		   text="『この時間でも、こんな真っ暗だわ‥‥。』" voices=""/>
		<clear @l="1607" class="char"/>
		<char @l="1609" id="rei" pos="left" src="rei010"/>
		<char @l="1612" id="miho" pos="right" src="miho016"/>
		<msg @l="1614" char_id="0" frame_id="1" name="美帆"
		   text="『すみません‥‥すっかり遅くなっちゃって。』" voices=""/>
		<char @l="1618" id="rei" pos="left" src="rei010"/>
		<msg @l="1620" char_id="1" frame_id="-1" name="玲" text="『気にしてないわよ、そのことなら。』"
		   voices=""/>
		<msg @l="1622" char_id="0" frame_id="1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="1624" char_id="-1" frame_id="-1" name=""
		   text="なんとなく、玲さんの言葉にトゲのようなものを感じてしまう。" voices=""/>
		<msg @l="1625" char_id="-1" frame_id="-1" name=""
		   text="それは多分、私の中にやましい部分があるからだろう。" voices=""/>
		<msg @l="1626" char_id="-1" frame_id="-1" name=""
		   text="稲庭先輩の事が好きなのだと気付いてしまったが故の、後ろめたさだ。" voices=""/>
		<char @l="1630" id="rei" pos="left" src="rei011"/>
		<msg @l="1632" char_id="1" frame_id="-1" name="玲" text="『どうしたのよ、急に黙っちゃって。』"
		   voices=""/>
		<msg @l="1634" char_id="0" frame_id="1" name="美帆" text="『あ、いえ‥‥。』" voices=""/>
		<char @l="1638" id="miho" pos="right" src="miho010"/>
		<msg @l="1640" char_id="0" frame_id="1" name="美帆" text="『ここ‥‥夜になると寂しいですね。』"
		   voices=""/>
		<char @l="1644" id="rei" pos="left" src="rei010"/>
		<msg @l="1646" char_id="1" frame_id="-1" name="玲"
		   text="『そうね‥‥電灯の明かりはあるけど、この間隔じゃ足りないし。』" voices=""/>
		<msg @l="1648" char_id="1" frame_id="-1" name="玲"
		   text="『人の行き来も極端に減っちゃうから、余計に寂しいわね。』" voices=""/>
		<msg @l="1650" char_id="0" frame_id="1" name="美帆" text="『電車‥‥何時まででしたっけ？』"
		   voices=""/>
		<msg @l="1652" char_id="1" frame_id="-1" name="玲" text="『大丈夫、まだ２～３本はあるわよ。』"
		   voices=""/>
		<msg @l="1654" char_id="1" frame_id="-1" name="玲"
		   text="『ちょっと‥‥待つ事になるかもしれないけど。』" voices=""/>
		<char @l="1657" id="miho" pos="right" src="miho116"/>
		<msg @l="1659" char_id="0" frame_id="1" name="美帆" text="『‥‥すみません。』"
		   voices=""/>
		<msg @l="1661" char_id="1" frame_id="-1" name="玲"
		   text="『それにしても、日も落ちたっていうのに暑いわね。』" voices=""/>
		<msg @l="1663" char_id="1" frame_id="-1" name="玲"
		   text="『帰りにアイスでも買って行こうかしら。』" voices=""/>
		<char @l="1667" id="miho" pos="right" src="miho011"/>
		<msg @l="1669" char_id="0" frame_id="1" name="美帆" text="『あ、それ良いですね‥‥‥‥‥あれ？』"
		   voices=""/>
		<char @l="1673" id="miho" pos="right" src="miho114"/>
		<msg @l="1676" char_id="0" frame_id="1" name="美帆"
		   text="『あそこにいるの、稲庭先輩じゃないですか‥‥？』" voices=""/>
		<char @l="1680" id="rei" pos="left" src="rei024"/>
		<msg @l="1682" char_id="1" frame_id="-1" name="玲" text="『え‥‥稲庭さん？』"
		   voices=""/>
		<clear @l="1687" class="char"/>
		<stopbgm @l="1691" fadeout="1000"/>
		<char @l="1695" id="inaba" pos="auto" src="inaba017"/>
		<bgm @l="1699" src="bgm09" volume="1."/>
		<msg @l="1701" char_id="-1" frame_id="-1" name=""
		   text="稲庭先輩までは、少し距離があり、向こうはまだこちらに気付いていない。" voices=""/>
		<msg @l="1703" char_id="1" frame_id="-1" name="玲"
		   text="『稲庭さん‥‥こんな時間まで何をしているのかしら？』" voices=""/>
		<msg @l="1705" char_id="0" frame_id="1" name="美帆" text="『声、かけてみますか？』"
		   voices=""/>
		<msg @l="1708" char_id="1" frame_id="-1" name="玲"
		   text="『あら？なんか稲庭さん不機嫌そうだけど‥‥。彼の不機嫌そうな顔なんて、私見たことがないわ。』" voices=""/>
		<msg @l="1710" char_id="0" frame_id="1" name="美帆"
		   text="『え？‥‥玲さんでも見たことがないんですか？』" voices=""/>
		<clear @l="1715" class="char"/>
		<bgm @l="1719" src="bgm05" volume="1."/>
		<char @l="1724" id="rei" pos="left" src="rei014"/>
		<char @l="1726" id="miho" pos="right" src="miho014"/>
		<msg @l="1728" char_id="1" frame_id="-1" name="玲" text="『あ‥‥。』" voices=""/>
		<msg @l="1730" char_id="-1" frame_id="-1" name=""
		   text="稲庭先輩が電灯の下から移動してしまい、見えなくなってしまった。" voices=""/>
		<msg @l="1731" char_id="-1" frame_id="-1" name="" text="こちらに向かって来るような様子はない。"
		   voices=""/>
		<msg @l="1732" char_id="-1" frame_id="-1" name=""
		   text="校舎の向こうには駐車場があるから、そちらに向かったのだろうか。" voices=""/>
		<char @l="1735" id="miho" pos="right" src="miho114"/>
		<msg @l="1737" char_id="0" frame_id="1" name="美帆" text="『‥‥行っちゃいましたね。』"
		   voices=""/>
		<char @l="1741" id="rei" pos="left" src="rei010"/>
		<msg @l="1743" char_id="1" frame_id="-1" name="玲" text="『そうね。』" voices=""/>
		<char @l="1747" id="miho" pos="right" src="miho116"/>
		<msg @l="1749" char_id="0" frame_id="1" name="美帆" text="『追いかけたり‥‥しないんですか？』"
		   voices=""/>
		<msg @l="1751" char_id="1" frame_id="-1" name="玲" text="『どうして？』" voices=""/>
		<msg @l="1753" char_id="0" frame_id="1" name="美帆" text="『どうしてって‥‥。』"
		   voices=""/>
		<char @l="1757" id="rei" pos="left" src="rei110"/>
		<msg @l="1760" char_id="1" frame_id="-1" name="玲"
		   text="『あら、ずいぶん稲庭さんにご執心じゃない‥‥？』" voices=""/>
		<char @l="1763" id="miho" pos="right" src="miho014"/>
		<msg @l="1765" char_id="0" frame_id="1" name="美帆" text="『そ、そんなこと‥‥‥‥ないですよ。』"
		   voices=""/>
		<char @l="1769" id="rei" pos="left" src="rei128"/>
		<msg @l="1771" char_id="1" frame_id="-1" name="玲" text="『ふぅん‥‥‥ま、良いけどね。』"
		   voices=""/>
		<char @l="1775" id="miho" pos="right" src="miho114"/>
		<msg @l="1777" char_id="0" frame_id="1" name="美帆"
		   text="『あ、向こうの方から誰かこっちに来ますよ‥‥？』" voices=""/>
		<char @l="1781" id="rei" pos="left" src="rei010"/>
		<msg @l="1783" char_id="1" frame_id="-1" name="玲" text="『あれ‥‥ここの用務員だわ。』"
		   voices=""/>
		<char @l="1787" id="miho" pos="right" src="miho116"/>
		<msg @l="1789" char_id="0" frame_id="1" name="美帆" text="『用務員さん‥‥？』"
		   voices=""/>
		<clear @l="1794" class="char"/>
		<char @l="1798" id="kuma" pos="auto" src="kuma010"/>
		<stopbgm @l="1800" fadeout="1000"/>
		<msg @l="1802" char_id="-1" frame_id="-1" name="用務員"
		   text="『おや、こんな時間まで居残りとは大変ですねぇ。』" voices=""/>
		<msg @l="1804" char_id="0" frame_id="1" name="美帆" text="『あ、はい‥‥どうも。』"
		   voices=""/>
		<msg @l="1806" char_id="-1" frame_id="-1" name="用務員"
		   text="『最近は何かと物騒な噂が絶えませんのに、女性だけで歩かれるのはいささか心許ない。』" voices=""/>
		<msg @l="1808" char_id="-1" frame_id="-1" name="用務員"
		   text="『なんならワタクシが外の停留所までお送りしましょうか？』" voices=""/>
		<msg @l="1810" char_id="0" frame_id="1" name="美帆" text="『えっと‥‥。』" voices=""/>
		<msg @l="1812" char_id="1" frame_id="-1" name="玲"
		   text="『いいえ、ご心配には及びません。お気持ちだけ頂いておきますわ。』" voices=""/>
		<msg @l="1814" char_id="-1" frame_id="-1" name="用務員"
		   text="『これはこれは、余計な事でしたか。』" voices=""/>
		<msg @l="1816" char_id="-1" frame_id="-1" name="用務員"
		   text="『それでは‥‥十分にお気をつけてお帰りください。』" voices=""/>
		<clear @l="1820" class="char"/>
		<msg @l="1822" char_id="-1" frame_id="-1" name=""
		   text="用務員さんは卑屈な愛想笑いを浮かべながら、礼儀正しい言葉を並べると、踵を返して裏庭の方へと歩き始めた。" voices=""/>
		<msg @l="1823" char_id="-1" frame_id="-1" name=""
		   text="そういえば‥‥裏庭には用務員室があるのだった。" voices=""/>
		<char @l="1827" id="miho" pos="auto" src="miho014"/>
		<bgm @l="1829" src="bgm05" volume="1."/>
		<msg @l="1831" char_id="0" frame_id="1" name="美帆"
		   text="『私、用務員さんが居ること初めて知ったかも‥‥。』" voices=""/>
		<clear @l="1834" class="char"/>
		<char @l="1837" id="miho" pos="left" src="miho010"/>
		<char @l="1840" id="rei" pos="right" src="rei128"/>
		<msg @l="1842" char_id="1" frame_id="-1" name="玲" text="『‥‥‥‥。』" voices=""/>
		<msg @l="1844" char_id="1" frame_id="-1" name="玲"
		   text="『‥‥私、どうしてもあの人は好きになれないわ。』" voices=""/>
		<char @l="1848" id="miho" pos="left" src="miho014"/>
		<msg @l="1850" char_id="0" frame_id="1" name="美帆"
		   text="『玲さんがそんな事を言うなんて、珍しいですね。』" voices=""/>
		<char @l="1854" id="rei" pos="right" src="rei120"/>
		<msg @l="1856" char_id="1" frame_id="-1" name="玲"
		   text="『それは、私だって普通の人間ですもの‥‥付き合いやすい相手もいれば、どうしても嫌悪感が先行しちゃうような相手だって居るわよ。』"
		   voices=""/>
		<char @l="1860" id="miho" pos="left" src="miho016"/>
		<msg @l="1862" char_id="0" frame_id="1" name="美帆"
		   text="『あ、いえ‥‥別にそれが悪いとは言いませんよ。』" voices=""/>
		<char @l="1865" id="miho" pos="left" src="miho010"/>
		<msg @l="1867" char_id="0" frame_id="1" name="美帆"
		   text="『ただ、ちょっと意外に思っただけですから。』" voices=""/>
		<msg @l="1869" char_id="1" frame_id="-1" name="玲"
		   text="『私が誰かを嫌ったりするのって、そんなに意外かしら？』" voices=""/>
		<msg @l="1871" char_id="0" frame_id="1" name="美帆"
		   text="『そうですね‥‥玲さんは人当たりもいいし理解力もあるし、どんな人が相手でも問題なく付き合えるんじゃないかってイメージはありますよ。』"
		   voices=""/>
		<char @l="1875" id="rei" pos="right" src="rei020"/>
		<msg @l="1877" char_id="1" frame_id="-1" name="玲"
		   text="『そう‥‥そんな風に思ってくれること自体は嬉しいんだけどね。』" voices=""/>
		<msg @l="1879" char_id="0" frame_id="1" name="美帆" text="『何か嫌な経験でもあるんですか？』"
		   voices=""/>
		<msg @l="1881" char_id="1" frame_id="-1" name="玲"
		   text="『別に、何かあったわけじゃないのよ‥‥。』" voices=""/>
		<char @l="1885" id="rei" pos="right" src="rei128"/>
		<msg @l="1887" char_id="1" frame_id="-1" name="玲"
		   text="『ただどうしても‥‥あの人だけは生理的に受け付けないの。』" voices=""/>
		<char @l="1890" id="miho" pos="left" src="miho110"/>
		<msg @l="1892" char_id="0" frame_id="1" name="美帆"
		   text="『そういうことって、誰でもあるものなんですね‥‥。』" voices=""/>
		<char @l="1896" id="rei" pos="right" src="rei120"/>
		<msg @l="1898" char_id="1" frame_id="-1" name="玲"
		   text="『多分、嫌いな人なんて一人も居ないって場合の方が少ないんじゃないかしら。』" voices=""/>
		<msg @l="1900" char_id="1" frame_id="-1" name="玲"
		   text="『完璧な人間なんてそうそう居ないと思う‥‥。』" voices=""/>
		<char @l="1904" id="rei" pos="right" src="rei121"/>
		<msg @l="1906" char_id="1" frame_id="-1" name="玲"
		   text="『いいえ‥‥少なくとも私が完璧になれないから、自分だけではないと思い込みたいだけなのでしょうけどね。』" voices=""/>
		<msg @l="1908" char_id="-1" frame_id="-1" name=""
		   text="そうして玲さんは‥‥少しだけ寂しそうに笑った。" voices=""/>
		<eval @l="1911" expr="f.稲庭ルートflag&#32;=&#32;1&#13;&#10;"/>
		<goto @l="1915" label="EventLabel_38"/>
		<label @l="1919" id="EventLabel_37"/>
		<description @l="1923" text="想いに気づくとき"/>
		<bgm @l="1927" src="bgm02" volume="1."/>
		<msg @l="1929" char_id="0" frame_id="1" name="美帆" text="『‥‥そうじゃないと思う。』"
		   voices=""/>
		<msg @l="1931" char_id="-1" frame_id="-1" name="女友達" text="『え‥‥？』" voices=""/>
		<char @l="1935" id="miho" pos="auto" src="miho051"/>
		<msg @l="1937" char_id="0" frame_id="1" name="美帆"
		   text="『私が好きなのは、稲庭先輩じゃないよ。』" voices=""/>
		<msg @l="1939" char_id="0" frame_id="1" name="美帆"
		   text="『だって‥‥私が好きなのは玲さんの方だもん。』" voices=""/>
		<msg @l="1941" char_id="-1" frame_id="-1" name="女友達" text="『なにそれ、どういうこと‥‥？』"
		   voices=""/>
		<msg @l="1943" char_id="-1" frame_id="-1" name="女友達"
		   text="『もしかしてあんた‥‥そっち方面？』" voices=""/>
		<char @l="1947" id="miho" pos="auto" src="miho056"/>
		<msg @l="1949" char_id="0" frame_id="1" name="美帆" text="『ち、違うよっ。』" voices=""/>
		<char @l="1953" id="miho" pos="auto" src="miho050"/>
		<msg @l="1955" char_id="0" frame_id="1" name="美帆"
		   text="『私は玲さんのことすごく尊敬してるし‥‥憧れてる。』" voices=""/>
		<msg @l="1957" char_id="0" frame_id="1" name="美帆"
		   text="『その憧れが、稲庭先輩に感じてる好意よりもずっと上なの。』" voices=""/>
		<msg @l="1959" char_id="0" frame_id="1" name="美帆"
		   text="『だから私は稲庭先輩のことが好きな玲さんのことを、ちゃんと心から応援したい‥‥。』" voices=""/>
		<char @l="1962" id="miho" pos="auto" src="miho051"/>
		<msg @l="1964" char_id="0" frame_id="1" name="美帆" text="『それだけ。』" voices=""/>
		<msg @l="1966" char_id="-1" frame_id="-1" name="女友達"
		   text="『ぜんっっっぜん、わかんないわ‥‥あんたの理屈！！！』" voices=""/>
		<char @l="1969" id="miho" pos="auto" src="miho050"/>
		<msg @l="1971" char_id="0" frame_id="1" name="美帆"
		   text="『そうかなぁ‥‥すごくシンプルなつもりなんだけど‥‥‥。』" voices=""/>
		<msg @l="1973" char_id="-1" frame_id="-1" name="女友達"
		   text="『ま、でもこれでライバルが一人減ったのは確かだしね。』" voices=""/>
		<msg @l="1975" char_id="-1" frame_id="-1" name="女友達"
		   text="『今回だけは特別に、私に黙ってテニスサークルに入会した事は許してあげるとしよう！』" voices=""/>
		<char @l="1979" id="miho" pos="auto" src="miho056"/>
		<msg @l="1981" char_id="0" frame_id="1" name="美帆" text="『あ、ありがとう‥‥。』"
		   voices=""/>
		<msg @l="1983" char_id="-1" frame_id="-1" name="女友達"
		   text="『それじゃ、そろそろゴハンみたいだから切るね。』" voices=""/>
		<char @l="1987" id="miho" pos="auto" src="miho051"/>
		<msg @l="1989" char_id="0" frame_id="1" name="美帆" text="『うん、また月曜日。』"
		   voices=""/>
		<msg @l="1991" char_id="-1" frame_id="-1" name="女友達" text="『じゃあね～。』"
		   voices=""/>
		<se @l="1995" buf="1" src="携帯ボタン押下音" volume="1."/>
		<char @l="1999" id="miho" pos="auto" src="miho050"/>
		<msg @l="2001" char_id="0" frame_id="1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="2003" char_id="0" frame_id="1" name="美帆" text="『‥‥ありがと。』" voices=""/>
		<msg @l="2005" char_id="-1" frame_id="-1" name=""
		   text="私は、通話の切れた携帯電話を見て微かに微笑む。" voices=""/>
		<msg @l="2006" char_id="-1" frame_id="-1" name=""
		   text="思いがない自分の気持ちに気付かせてくれた友人への、そこはかとない感謝の気持ちを込めて。" voices=""/>
		<msg @l="2007" char_id="-1" frame_id="-1" name=""
		   text="そして、尊敬する先輩が恋敵とならずに済んだ事への安堵感を抱いて。" voices=""/>
		<stopbgm @l="2011" fadeout="1000"/>
		<clear @l="2016" class="all"/>
		<msgshow @l="2018" show="true"/>
		<wait_chgmv/>
		<bg @l="2022" src="bg01b"/>
		<bgm @l="2026" src="bgm04" volume="1."/>
		<char @l="2030" id="miho" pos="auto" src="miho030"/>
		<msg @l="2032" char_id="0" frame_id="1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="2034" char_id="-1" frame_id="-1" name=""
		   text="夕食後、私は部屋に戻ってレポート‥‥というかその大前提となる作業と懸命に格闘していた。" voices=""/>
		<msg @l="2035" char_id="-1" frame_id="-1" name=""
		   text="レポートに論証とその参考文献を載せるにしても、その元となっている参考文献が英語で書かれている以上はまず翻訳をしなければならない。"
		   voices=""/>
		<msg @l="2036" char_id="-1" frame_id="-1" name=""
		   text="そもそも、考古学という分野では、著名な専門書が英語で書かれたものが多い。" voices=""/>
		<msg @l="2037" char_id="-1" frame_id="-1" name=""
		   text="更にその英語で書かれている専門書も、元はフランス語やらドイツ語やらで書かれていたものを英訳しているので何とも複雑だ。"
		   voices=""/>
		<msg @l="2039" char_id="0" frame_id="1" name="美帆"
		   text="(レポート自体は楽しいのだけれど、いつもいつもこの和訳で足を引っ張られちゃうのよね‥‥)" voices=""/>
		<msg @l="2041" char_id="-1" frame_id="-1" name=""
		   text="そしてやはり今回も、和訳に一番時間を割かれている。" voices=""/>
		<msg @l="2042" char_id="-1" frame_id="-1" name=""
		   text="レポートの作成自体は一日もあれば十分なのだけれど。" voices=""/>
		<msg @l="2043" char_id="-1" frame_id="-1" name=""
		   text="ただ、論証となってる専門書のページ数がかなり多いので、提出が来週の火曜だということを考えるとギリギリな感じだ。" voices=""/>
		<msg @l="2045" char_id="0" frame_id="1" name="美帆"
		   text="(この調子じゃ、土日も訳に使わなきゃ間に合わないかも‥‥)" voices=""/>
		<stopbgm @l="2048" fadeout="1000"/>
		<se @l="2052" buf="3" loop="true" src="着メロ2" volume="1."/>
		<char @l="2056" id="miho" pos="auto" src="miho134"/>
		<msg @l="2058" char_id="0" frame_id="1" name="美帆" text="『あ‥‥。』" voices=""/>
		<msg @l="2060" char_id="0" frame_id="1" name="美帆" text="(電話‥‥自宅から？)"
		   voices=""/>
		<msg @l="2062" char_id="-1" frame_id="-1" name=""
		   text="カバンに入ったままだった携帯電話を取り出してディスプレイを見ると、そこには見慣れた自宅の番号が表示されていた。" voices=""/>
		<char @l="2068" id="miho" pos="auto" src="miho030"/>
		<stopse @l="2072" buf="3"/>
		<msg @l="2074" char_id="0" frame_id="1" name="美帆" text="はい、もしもし‥‥。"
		   voices=""/>
		<msg @l="2076" char_id="2" frame_id="-1" name="声" text="『もしもし、お姉ちゃん？』"
		   voices=""/>
		<char @l="2080" id="miho" pos="auto" src="miho034"/>
		<msg @l="2082" char_id="0" frame_id="1" name="美帆" text="『その声‥‥亜季奈？』"
		   voices=""/>
		<bgm @l="2086" src="bgm06" volume="1."/>
		<msg @l="2088" char_id="2" frame_id="-1" name="亜季奈" text="『ぴんぽーん、大正解。』"
		   voices=""/>
		<msg @l="2090" char_id="2" frame_id="-1" name="亜季奈" text="『賞品は妹優待券、一年分だよ～。』"
		   voices=""/>
		<char @l="2094" id="miho" pos="auto" src="miho036"/>
		<msg @l="2096" char_id="0" frame_id="1" name="美帆" text="『何よその、妹優待券って‥‥。』"
		   voices=""/>
		<msg @l="2098" char_id="2" frame_id="-1" name="亜季奈"
		   text="『ほら、昔肩たたき券とかあげたでしょ？&#32;あれの私バージョン。』" voices=""/>
		<msg @l="2100" char_id="2" frame_id="-1" name="亜季奈"
		   text="『それを貰ったお姉ちゃんは私を優待しなくちゃいけません。』" voices=""/>
		<msg @l="2102" char_id="0" frame_id="1" name="美帆" text="『そんなの要らないわよ‥‥。』"
		   voices=""/>
		<msg @l="2104" char_id="2" frame_id="-1" name="亜季奈" text="『ちぇ、遠慮しなくていいのに～。』"
		   voices=""/>
		<char @l="2108" id="miho" pos="auto" src="miho030"/>
		<msg @l="2110" char_id="0" frame_id="1" name="美帆" text="『それより、いきなりどうしたの？』"
		   voices=""/>
		<char @l="2114" id="miho" pos="auto" src="miho036"/>
		<msg @l="2116" char_id="0" frame_id="1" name="美帆"
		   text="『まさか、そんな事を言う為だけに電話したんじゃないわよね？』" voices=""/>
		<msg @l="2118" char_id="2" frame_id="-1" name="亜季奈" text="『違うよー。』" voices=""/>
		<msg @l="2120" char_id="2" frame_id="-1" name="亜季奈"
		   text="『今日はお姉ちゃんに、一生のお願いがあって電話したの！』" voices=""/>
		<char @l="2124" id="miho" pos="auto" src="miho034"/>
		<msg @l="2126" char_id="0" frame_id="1" name="美帆" text="『一生のお願い‥‥？』"
		   voices=""/>
		<msg @l="2128" char_id="2" frame_id="-1" name="亜季奈" text="『そう、一生のお願い！』"
		   voices=""/>
		<char @l="2132" id="miho" pos="auto" src="miho036"/>
		<msg @l="2134" char_id="0" frame_id="1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="2136" char_id="-1" frame_id="-1" name=""
		   text="亜季奈の「一生のお願い」には、昔から何度も大変な思いをさせられている。" voices=""/>
		<msg @l="2137" char_id="-1" frame_id="-1" name=""
		   text="お母さんに黙って子犬を拾ってきた時や、どういうワケか亜季奈のクラスメイトの男の子とデートしなくてはならない状況になった事もあった。"
		   voices=""/>
		<msg @l="2138" char_id="-1" frame_id="-1" name=""
		   text="とにかく亜季奈の「一生のお願い」は、ロクな事がない。" voices=""/>
		<msg @l="2140" char_id="0" frame_id="1" name="美帆"
		   text="『‥‥また、無茶なことじゃないでしょうね？』" voices=""/>
		<msg @l="2142" char_id="2" frame_id="-1" name="亜季奈" text="『無茶なんかじゃないよー。』"
		   voices=""/>
		<msg @l="2144" char_id="2" frame_id="-1" name="亜季奈"
		   text="『今度、コッチで水泳の大会があるの知ってるよね？』" voices=""/>
		<char @l="2148" id="miho" pos="auto" src="miho030"/>
		<msg @l="2150" char_id="0" frame_id="1" name="美帆"
		   text="『え、ええ‥‥この時期には毎年やってるもんね。』" voices=""/>
		<msg @l="2152" char_id="-1" frame_id="-1" name="" text="亜季奈は今、水泳部に所属している‥‥。"
		   voices=""/>
		<msg @l="2153" char_id="-1" frame_id="-1" name=""
		   text="私も、何年か前までは亜季奈と同じ水泳部に在籍していた。" voices=""/>
		<msg @l="2154" char_id="-1" frame_id="-1" name=""
		   text="もっとも私が亜季奈と同い年の頃には、とっくに水泳部を辞めてしまっていたのだけれど‥‥。" voices=""/>
		<msg @l="2156" char_id="2" frame_id="-1" name="亜季奈"
		   text="『実は、その大会に向けて強化合宿することになったんだけど‥‥。』" voices=""/>
		<msg @l="2158" char_id="2" frame_id="-1" name="亜季奈"
		   text="『聞いて驚け！&#32;なんとその合宿先がお姉ちゃんの大学なの！』" voices=""/>
		<char @l="2162" id="miho" pos="auto" src="miho036"/>
		<msg @l="2164" char_id="0" frame_id="1" name="美帆" text="『へ、へえ‥‥偶然ね。』"
		   voices=""/>
		<msg @l="2166" char_id="2" frame_id="-1" name="亜季奈"
		   text="『何よ～、リアクション薄すぎない！？』" voices=""/>
		<msg @l="2168" char_id="0" frame_id="1" name="美帆"
		   text="『そ、そんなことないわよ‥‥いつも通りじゃない。』" voices=""/>
		<msg @l="2170" char_id="2" frame_id="-1" name="亜季奈" text="『もう、張り合いないなぁ。』"
		   voices=""/>
		<char @l="2174" id="miho" pos="auto" src="miho030"/>
		<msg @l="2176" char_id="0" frame_id="1" name="美帆"
		   text="『けど‥‥それの何処が「一生のお願い」なの？』" voices=""/>
		<msg @l="2178" char_id="2" frame_id="-1" name="亜季奈" text="『一生のお願いはここから先。』"
		   voices=""/>
		<msg @l="2180" char_id="2" frame_id="-1" name="亜季奈"
		   text="『実はその強化合宿の時に、お姉ちゃんにコーチしてもらえないかと思って。』" voices=""/>
		<char @l="2184" id="miho" pos="auto" src="miho034"/>
		<msg @l="2186" char_id="0" frame_id="1" name="美帆" text="『え‥‥。』" voices=""/>
		<msg @l="2188" char_id="2" frame_id="-1" name="亜季奈"
		   text="『ほら、昔のコトとはいえお姉ちゃんも記録保持者でしょ？』" voices=""/>
		<msg @l="2190" char_id="2" frame_id="-1" name="亜季奈"
		   text="『やっぱりそういう人が身近にいて教えてくれた方が、みんな記録も伸びると思うんだよね。』" voices=""/>
		<msg @l="2192" char_id="0" frame_id="1" name="美帆"
		   text="『で、でも‥‥ウチの大学で合宿をするなら、当然水泳サークルとかが泳ぎを見てくれるんじゃないの？』" voices=""/>
		<msg @l="2194" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んー、一応そういう話にはなってるみたいだけど、お姉ちゃんのトコって別に水泳が強いワケでも大会入賞者が居るワケでもないでしょ？』"
		   voices=""/>
		<char @l="2198" id="miho" pos="auto" src="miho036"/>
		<msg @l="2200" char_id="0" frame_id="1" name="美帆" text="『ま、まあ‥‥。』" voices=""/>
		<msg @l="2202" char_id="-1" frame_id="-1" name=""
		   text="確かに、今の大学に入ってから水泳で賞を取ったという話は聞かない。" voices=""/>
		<msg @l="2203" char_id="-1" frame_id="-1" name=""
		   text="いや‥‥大学を選ぶ時、未練が湧かないようにとあえて水泳に力を入れていない所を選んだのだからそれで当然といえば当然だろう。"
		   voices=""/>
		<msg @l="2205" char_id="2" frame_id="-1" name="亜季奈"
		   text="『だから、助っ人としてお姉ちゃんが居ると心強いんだよ！』" voices=""/>
		<msg @l="2207" char_id="0" frame_id="1" name="美帆"
		   text="『だけど‥‥そんなの、やっぱり無理だよ。』" voices=""/>
		<msg @l="2209" char_id="0" frame_id="1" name="美帆"
		   text="『何の関係もない私がプールに居たら変に思われるだろうし‥‥あ、それに私、水泳を辞めた時に競泳用の水着とか捨てちゃったし。』"
		   voices=""/>
		<msg @l="2211" char_id="2" frame_id="-1" name="亜季奈"
		   text="『だいじょうぶだいじょうぶ、別に変になんか思われないよ。』" voices=""/>
		<msg @l="2213" char_id="2" frame_id="-1" name="亜季奈"
		   text="『それにお姉ちゃんはコーチなんだから、海とか外のプールとかに着てくような水着でおっけーだって。』" voices=""/>
		<msg @l="2215" char_id="0" frame_id="1" name="美帆"
		   text="『もう、亜季奈はすぐそうやって適当なこと言うんだから‥‥。』" voices=""/>
		<msg @l="2217" char_id="2" frame_id="-1" name="亜季奈"
		   text="『ていうかね、実はもう水泳部の子たちに「私のお姉ちゃんがバッチリコーチしてくれるから安心して！」って‥‥‥言っちゃったんだよね。』"
		   voices=""/>
		<msg @l="2219" char_id="2" frame_id="-1" name="亜季奈"
		   text="『だから、何がなんでもお姉ちゃんにはコーチしてもらわないと困るの！』" voices=""/>
		<msg @l="2221" char_id="0" frame_id="1" name="美帆" text="(‥‥なるほどね)" voices=""/>
		<msg @l="2223" char_id="-1" frame_id="-1" name="" text="だから「一生のお願い」というわけだ。"
		   voices=""/>
		<msg @l="2224" char_id="-1" frame_id="-1" name=""
		   text="まったく‥‥予想通り無茶もいいところなお願いをするんだから。" voices=""/>
		<msg @l="2226" char_id="2" frame_id="-1" name="亜季奈"
		   text="『ね、お願いっ‥‥可愛い妹を助けると思って！』" voices=""/>
		<msg @l="2228" char_id="0" frame_id="1" name="美帆"
		   text="『でも、私はもう水泳は辞めちゃったし‥‥。』" voices=""/>
		<msg @l="2230" char_id="0" frame_id="1" name="美帆"
		   text="『もう三年以上も泳いでないんだよ？&#32;上手く教える自信ないよ。』" voices=""/>
		<msg @l="2232" char_id="2" frame_id="-1" name="亜季奈"
		   text="『お姉ちゃんなら大丈夫、私が保証しちゃう！』" voices=""/>
		<msg @l="2234" char_id="0" frame_id="1" name="美帆"
		   text="『亜季奈に保証されても嬉しくない‥‥。』" voices=""/>
		<msg @l="2236" char_id="2" frame_id="-1" name="亜季奈"
		   text="『うぐ‥‥と、とにかく！&#32;合宿は来週の月曜からだから。』" voices=""/>
		<msg @l="2238" char_id="2" frame_id="-1" name="亜季奈"
		   text="『授業が終わったら室内プールまで絶対に来てよね！』" voices=""/>
		<char @l="2242" id="miho" pos="auto" src="miho034"/>
		<msg @l="2244" char_id="0" frame_id="1" name="美帆"
		   text="『え、あ‥‥ちょっと、なに勝手に話を進めて‥‥‥。』" voices=""/>
		<msg @l="2246" char_id="2" frame_id="-1" name="亜季奈" text="『それじゃ、お願いだよっ！』"
		   voices=""/>
		<se @l="2250" buf="1" src="通話が切れた後の音" volume="1."/>
		<msg @l="2252" char_id="0" frame_id="1" name="美帆"
		   text="『こら、亜季奈‥‥‥‥って、切れてる。』" voices=""/>
		<stopse @l="2256" buf="1"/>
		<bgm @l="2260" src="bgm02" volume="1."/>
		<char @l="2264" id="miho" pos="auto" src="miho136"/>
		<msg @l="2266" char_id="0" frame_id="1" name="美帆"
		   text="『もう‥‥いつもいつも自分勝手なんだから‥‥‥。』" voices=""/>
		<msg @l="2268" char_id="0" frame_id="1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="2270" char_id="0" frame_id="1" name="美帆" text="『水泳かぁ‥‥。』" voices=""/>
		<msg @l="2272" char_id="0" frame_id="1" name="美帆"
		   text="『私も‥‥あんな事がなければ、今でも続けてたのかな‥‥‥。』" voices=""/>
		<msg @l="2274" char_id="-1" frame_id="-1" name=""
		   text="とある事件をきっかけに、私は水泳を辞めてしまった。" voices=""/>
		<msg @l="2275" char_id="-1" frame_id="-1" name=""
		   text="身体の故障とか限界を感じてとか‥‥そういうありふれたものじゃない。" voices=""/>
		<msg @l="2276" char_id="-1" frame_id="-1" name="" text="あれは確かに「事件」だった。"
		   voices=""/>
		<msg @l="2277" char_id="-1" frame_id="-1" name=""
		   text="関係者各位の‥‥特に私の意思によって表沙汰にする事を避けて秘密裏に闇へと葬リ去った出来事。" voices=""/>
		<msg @l="2278" char_id="-1" frame_id="-1" name=""
		   text="けれどそれは、今も私の心に深い傷痕を残している。" voices=""/>
		<msg @l="2279" char_id="-1" frame_id="-1" name="" text="‥‥確実に。" voices=""/>
		<msg @l="2283" char_id="0" frame_id="1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<char @l="2286" id="miho" pos="auto" src="miho036"/>
		<msg @l="2288" char_id="0" frame_id="1" name="美帆"
		   text="(でも‥‥それより当面の問題はこのレポートが間に合うか、よね)" voices=""/>
		<msg @l="2290" char_id="-1" frame_id="-1" name=""
		   text="私は机の上に開かれた分厚い専門書を見て、深いため息をついた。" voices=""/>
		<eval @l="2293" expr="f.亜季奈ルートflag&#32;+=&#32;1&#13;&#10;"/>
		<label @l="2298" id="EventLabel_38"/>
		<stopbgm @l="2302" fadeout="1000"/>
		<clear @l="2308" class="all"/>
		<goto @l="2311" cond="!(f.稲庭ルートflag&#32;==&#32;1)&#13;&#10;"
		   label="TempLabel_245"/>
		<call @l="2315" target="EventLabel_87@root_inaba01"/>
		<return @l="2316" value="0&#13;&#10;"/>
		<goto @l="2319" label="TempLabel_321"/>
		<label @l="2320" id="TempLabel_245"/>
		<goto @l="2321" cond="!(f.亜季奈ルートflag&#32;==&#32;1)&#13;&#10;"
		   label="TempLabel_322"/>
		<call @l="2326" target="EventLabel_59@root_akina01"/>
		<return @l="2327" value="0&#13;&#10;"/>
		<label @l="2329" id="TempLabel_322"/>
		<label @l="2330" id="TempLabel_321"/>
		<return @l="2336" value=""/>
	</code>
</xscript>
