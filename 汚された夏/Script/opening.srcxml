<?xml version="1.0" encoding="utf-8"?>
<xscript>
	<debug editor="&quot;C:\Program&#32;Files&#32;(x86)\sakura\sakura.exe&quot;&#32;&quot;%src%&quot;&#32;-Y=%line%"
	   src="D:\シロップ\町ぐるみの罠＋汚された夏セット版\汚された夏\完成データ\汚された夏\script\text\opening.txt"/>
	<code>
		<label @l="6" id="EventLabel_57"/>
		<eval @l="10" expr="f.痴漢flag&#32;=&#32;0&#13;&#10;"/>
		<eval @l="12" expr="f.名前を知られてるflag&#32;=&#32;0&#13;&#10;"/>
		<eval @l="14" expr="f.訴えるflag&#32;=&#32;0&#13;&#10;"/>
		<eval @l="16" expr="f.サークル見学会flag&#32;=&#32;0&#13;&#10;"/>
		<eval @l="18" expr="f.亜季奈ルート確定flag&#32;=&#32;0&#13;&#10;"/>
		<eval @l="20" expr="f.玲ルート確定flag&#32;=&#32;0&#13;&#10;"/>
		<eval @l="22" expr="f.朽木ルートflag&#32;=&#32;0&#13;&#10;"/>
		<eval @l="24" expr="f.稲庭ルートflag&#32;=&#32;0&#13;&#10;"/>
		<eval @l="26" expr="f.稲庭ルート即席flag&#32;=&#32;0&#13;&#10;"/>
		<eval @l="28" expr="f.亜季奈ルートflag&#32;=&#32;0&#13;&#10;"/>
		<eval @l="30" expr="f.留学生に抵抗したflag&#32;=&#32;0&#13;&#10;"/>
		<eval @l="32" expr="f.水泳勝負flag&#32;=&#32;0&#13;&#10;"/>
		<eval @l="34" expr="f.過去の反芻_中出しflag&#32;=&#32;0&#13;&#10;"/>
		<eval @l="36" expr="f.ご褒美奉仕flag&#32;=&#32;0&#13;&#10;"/>
		<eval @l="38" expr="f.稲庭コーチflag&#32;=&#32;0&#13;&#10;"/>
		<eval @l="40" expr="f._3d_exodus&#32;=&#32;0&#13;&#10;"/>
		<label @l="46" id="EventLabel_58"/>
		<description @l="49" text="オープニング"/>
		<eval @l="51" expr="f.numDay=0&#13;&#10;"/>
		<msgshow @l="57" show="true"/>
		<goto @l="61" cond="!(s.opening_flag)&#13;&#10;" label="TempLabel_156"/>
		<msg @l="64" async="true" char_id="-1" frame_id="-1" name=""
		   text="オープニングを見ますか？" voices=""/>
		<select @l="65">
			<menu @l="67" text="見る"/>
			<menu @l="69" label="TempLabel_157" text="とばす"/>
		</select>
		<goto @l="72" label="TempLabel_323"/>
		<label @l="74" id="TempLabel_157"/>
		<call @l="76" target="EventLabel_19@common_root01"/>
		<return @l="77" value="0&#13;&#10;"/>
		<goto @l="78" label="TempLabel_323"/>
		<label @l="80" id="TempLabel_323"/>
		<label @l="82" id="TempLabel_156"/>
		<label @l="87" id="event_scene54"/>
		<msg @l="89" char_id="-1" frame_id="-1" name="女の声" text="『あふっ、んっ、んっ‥‥んんっ！』"
		   voices="rei02240"/>
		<msg @l="91" char_id="-1" frame_id="-1" name=""
		   text="薄い闇に包まれた汚い公衆便所の中から女の艶やかな声が聞こえてくる。" voices=""/>
		<msg @l="92" char_id="-1" frame_id="-1" name=""
		   text="そして‥‥声に追従するように響く、粘質を多分に含んだ淫猥な水音。" voices=""/>
		<msg @l="93" char_id="-1" frame_id="-1" name="" text="―――女が犯されている音。"
		   voices=""/>
		<wait_chgmv/>
		<ev @l="97" src="ev-054"/>
		<bgm @l="101" src="bgm08" volume="1."/>
		<msg @l="103" char_id="-1" frame_id="-1" name="女"
		   text="『んはっ、ああっ‥‥‥んっ、んっ、んっ、あふっ！！』" voices="rei02270"/>
		<msg @l="105" char_id="-1" frame_id="-1" name=""
		   text="胎内奥深くを肉棒で貫かれ、女は甘い嬌声を漏らして腰をがくがくと震わせた。" voices=""/>
		<msg @l="106" char_id="-1" frame_id="-1" name=""
		   text="男はほっそりとした女の腰を掴むと、白いお尻に叩きつけるようにさらに奥深くへと突き上げた。" voices=""/>
		<msg @l="108" char_id="-1" frame_id="-1" name="女"
		   text="『んんっ、あっ‥‥‥ダメっ‥‥そこ、そんなに強く突き上げたらっ！！』" voices="rei02430"/>
		<msg @l="110" char_id="-1" frame_id="-1" name="男"
		   text="『へへへっ、どうよ？子宮に届いている俺のチ○ポは？』" voices=""/>
		<msg @l="112" char_id="-1" frame_id="-1" name=""
		   text="蜜の滴る秘所を激しく掻き混ぜながら、男は下卑た笑みを浮かべた。" voices=""/>
		<msg @l="113" char_id="-1" frame_id="-1" name=""
		   text="そして、さらに激しく女の膣内を掻き混ぜる。" voices=""/>
		<msg @l="115" char_id="-1" frame_id="-1" name="女"
		   text="『いやぁ‥‥んっ‥‥んっ‥‥‥‥そんな強く、んぁぁっっ！！』" voices="rei02360"/>
		<msg @l="117" char_id="-1" frame_id="-1" name=""
		   text="全神経を麻痺させるような快感が、女を包み込み、彼女は甘く身悶えていた。" voices=""/>
		<msg @l="119" char_id="-1" frame_id="-1" name="男" text="『そら、スパートだ。』"
		   voices=""/>
		<msg @l="121" char_id="-1" frame_id="-1" name=""
		   text="吐き捨てるように言って、男が腰の律動を早めていった。" voices=""/>
		<msg @l="122" char_id="-1" frame_id="-1" name=""
		   text="濡れそぼる蜜所を男根が激しく行き来する度、大量の淫汁が床に溢れ落ちる。" voices=""/>
		<msg @l="124" char_id="-1" frame_id="-1" name="女" text="『んっ、ふぁぁっ！！』"
		   voices="rei02340"/>
		<msg @l="126" char_id="-1" frame_id="-1" name="女"
		   text="『もっ‥‥んぁ、いくっ‥‥‥いっちゃ‥‥‥‥‥‥‥んんんっ！！』" voices="rei02300"/>
		<msg @l="128" char_id="-1" frame_id="-1" name=""
		   text="女がしなやかな肢躰を折れんばかりにのけ反らせ、歓喜の声をあげて身体を震わせた。" voices=""/>
		<msg @l="129" char_id="-1" frame_id="-1" name=""
		   text="既に「恥じらい」などという言葉は彼女の頭には無かった。" voices=""/>
		<msg @l="130" char_id="-1" frame_id="-1" name=""
		   text="熱く熱を帯びた瞳はもう、己の居る場所でさえも正常に映してはいない。" voices=""/>
		<msg @l="131" char_id="-1" frame_id="-1" name=""
		   text="ただ与えられる快楽に酔いしれるだけのケモノと化していた‥‥‥。" voices=""/>
		<msg @l="133" char_id="-1" frame_id="-1" name="男"
		   text="『へっ‥‥膣にたっぷり俺の精子をぶちまけてやるからな！』" voices=""/>
		<msg @l="135" char_id="-1" frame_id="-1" name="男" text="『子宮の奥まで感じろよ！！いくぜっ！』"
		   voices=""/>
		<msg @l="137" char_id="-1" frame_id="-1" name="女"
		   text="『もっ‥‥んぁ、いくっ‥‥‥いっちゃ‥‥‥‥‥‥‥んんんっ！！』" voices="rei02300"/>
		<flash @l="141" count="4" fade="100" image="white"/>
		<wait_chgmv/>
		<ev @l="145" src="ev-054z1"/>
		<msg @l="147" char_id="-1" frame_id="-1" name=""
		   text="男が膣中奥深くへと熱い精を放った瞬間、女もまた絶頂へと辿り着いた。" voices=""/>
		<msg @l="148" char_id="-1" frame_id="-1" name=""
		   text="胎内に収まりきらなかった精液が女の脚を伝い落ち‥‥床を白く染める。" voices=""/>
		<msg @l="150" char_id="-1" frame_id="-1" name="女"
		   text="『んっ‥‥あっ、あっ‥‥‥‥熱いのが‥‥‥流れ込んでくる‥‥‥‥。』" voices="rei01570"/>
		<msg @l="152" char_id="-1" frame_id="-1" name="女"
		   text="『あっ、ああっ‥‥熱いの‥‥‥こんなに出てる‥‥‥‥‥。』" voices="rei02390"/>
		<msg @l="154" char_id="-1" frame_id="-1" name=""
		   text="女はそれを荒い吐息のまま見つめ、うっとりと目を細めた‥‥‥‥。" voices=""/>
		<stopbgm @l="158" fadeout="1000"/>
		<clear @l="164" class="all"/>
		<end_scene @l="167"/>
		<wait @l="170" time="1000"/>
		<msgshow @l="172" show="true"/>
		<msg @l="175" char_id="-1" frame_id="-1" name="" text="‥‥‥‥‥‥‥‥‥‥‥‥。"
		   voices=""/>
		<msg @l="176" char_id="-1" frame_id="-1" name="" text="‥‥‥‥‥‥‥‥。" voices=""/>
		<msg @l="177" char_id="-1" frame_id="-1" name="" text="‥‥‥‥。" voices=""/>
		<se @l="181" buf="3" loop="true" src="電車走行中" volume="1."/>
		<msg @l="183" char_id="-1" frame_id="-1" name=""
		   text="‥‥もう、どれくらいこうして揺られているだろう。" voices=""/>
		<msg @l="184" char_id="-1" frame_id="-1" name="" text="心地よい振動が妙に眠気を誘う。"
		   voices=""/>
		<msg @l="185" char_id="-1" frame_id="-1" name=""
		   text="時々浅い眠りに誘われては何か夢を見るのだけれど、ふと目が醒めた時にはそれがどんな内容だったのか覚えていない。" voices=""/>
		<msg @l="186" char_id="-1" frame_id="-1" name=""
		   text="大事なことか、どうでもよいことだったのか‥‥それを思い出そうと考えていると、また睡魔が私を襲ってくるのだった。" voices=""/>
		<msg @l="188" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="192" char_id="-1" frame_id="-1" name=""
		   text="ふと、私はまとわりつく眠気を払うように近くの窓から空を見上げた。" voices=""/>
		<msg @l="193" char_id="-1" frame_id="-1" name="" text="青々と晴れ渡った広い空が、妙に心地よい。"
		   voices=""/>
		<msg @l="195" char_id="0" frame_id="-1" name="美帆" text="(んー、いい景色‥‥)"
		   voices=""/>
		<msg @l="197" char_id="0" frame_id="-1" name="美帆"
		   text="(気のせいかな、東京よりも空が青い気がする)" voices=""/>
		<msg @l="199" char_id="0" frame_id="-1" name="美帆"
		   text="(そういえば‥‥ここって本当なら山の中なんだっけ？)" voices=""/>
		<msg @l="201" char_id="-1" frame_id="-1" name=""
		   text="私は思い出したようにカバンから案内用のパンフレットを取り出した。" voices=""/>
		<msg @l="202" char_id="-1" frame_id="-1" name=""
		   text="三つ折りにされたパンフレットには、今年から私が通う事になる分校とその分校がある『南総町（なんそうちょう）』についての紹介文が書かれているハズだ。"
		   voices=""/>
		<msg @l="204" char_id="0" frame_id="-1" name="美帆" text="(あった‥‥)" voices=""/>
		<msg @l="206" char_id="-1" frame_id="-1" name=""
		   text="紹介文の一節に『南総町』が作られるまでの経緯が、クレヨンで描かれた可愛らしい挿絵と共に物語形式でつづられていた。" voices=""/>
		<msg @l="207" char_id="-1" frame_id="-1" name=""
		   text="山々が連なっていた陸の孤島を切り開くことで生まれた『南総町』。" voices=""/>
		<msg @l="208" char_id="-1" frame_id="-1" name=""
		   text="周囲を小高い山に囲まれながら、都心さながらの機能を持った現代の町。" voices=""/>
		<msg @l="209" char_id="-1" frame_id="-1" name=""
		   text="天然と人工の両方を併せ持った理想郷というべき場所、なのだそうだ。" voices=""/>
		<msg @l="211" char_id="0" frame_id="-1" name="美帆"
		   text="(理想郷かぁ‥‥住みやすい所だといいな)" voices=""/>
		<msg @l="213" char_id="-1" frame_id="-1" name=""
		   text="町の機能実験とかで、私の通っている大学の分校が『南総町』に建てられたのは二年ほど前だっただろうか。" voices=""/>
		<msg @l="214" char_id="-1" frame_id="-1" name=""
		   text="それから、四年間のうち後半の二年間を『南総町』にある分校へ通うという規則が新たに追加されるようになった。" voices=""/>
		<msg @l="215" char_id="-1" frame_id="-1" name=""
		   text="今年の春で晴れて三年生となった私はそうして、理想郷である『南総町』へと通うことになったのである。" voices=""/>
		<msg @l="217" char_id="-1" frame_id="-1" name="アナウンス"
		   text="『次は終点―――南総町駅前、南総町駅前。』" voices=""/>
		<msg @l="219" char_id="0" frame_id="-1" name="美帆" text="(あ‥‥降りなくちゃ)"
		   voices=""/>
		<stopbgm @l="223" fadeout="1000"/>
		<stopse @l="227" buf="3"/>
		<clear @l="233" class="all"/>
		<wait_chgmv/>
		<bg @l="237" src="bg18m1"/>
		<se @l="241" buf="1" src="電車停車～発進" volume="1."/>
		<char @l="245" id="miho" pos="auto" src="miho010"/>
		<bgm @l="249" src="bgm02" volume="1."/>
		<msg @l="251" char_id="0" frame_id="-1" name="美帆" text="『‥‥ふぅ。』" voices=""/>
		<msg @l="253" char_id="-1" frame_id="-1" name=""
		   text="手にしていた荷物を足元において、私は小さく息を吐いた。" voices=""/>
		<msg @l="254" char_id="-1" frame_id="-1" name=""
		   text="路面電車に揺られて約一時間‥‥ようやく南総町の中央へと辿り着いた。" voices=""/>
		<msg @l="255" char_id="-1" frame_id="-1" name=""
		   text="とても山々に囲まれた場所にあるとは思えないほど、駅前の様相は都会然としていて賑やかだった。" voices=""/>
		<msg @l="257" char_id="0" frame_id="-1" name="美帆"
		   text="(えっと、とりあえず大学の方にいかないとダメなんだっけ？)" voices=""/>
		<wait_chgmv/>
		<bg @l="261" src="bg21"/>
		<char @l="265" id="miho" pos="auto" src="miho010"/>
		<msg @l="267" char_id="-1" frame_id="-1" name=""
		   text="一息ついてすぐ、私は足元の荷物を持ち、駅前に幾つか並んでいる路面電車の停留所の前から大学前行きのを探してそこへと並んだ。"
		   voices=""/>
		<msg @l="268" char_id="-1" frame_id="-1" name=""
		   text="新学期は来週頭からなのだけれど、移動手続きの書類を大学に提出しなければいけないとかで、構内の事務局へ出向くようにと言われていたのだ。"
		   voices=""/>
		<msg @l="269" char_id="-1" frame_id="-1" name=""
		   text="引っ越し作業に移動手続きと、今年の春休みは遊ぶ余裕なんてなさそうである。" voices=""/>
		<stopse @l="273" buf="3"/>
		<se @l="277" buf="1" src="電車停車" volume="1."/>
		<msg @l="281" char_id="-1" frame_id="-1" name=""
		   text="五分と待たず、停留所前に二両編成の路面電車が入ってくる。" voices=""/>
		<msg @l="282" char_id="-1" frame_id="-1" name=""
		   text="車体のデザインはアンティークっぽいが、作り自体は妙に真新しく感じられた。" voices=""/>
		<msg @l="283" char_id="-1" frame_id="-1" name=""
		   text="もしかすると外装は過去に走っていた路面電車のレプリカなのかもしれない。" voices=""/>
		<char @l="285" id="miho" pos="auto" src="miho110"/>
		<msg @l="286" char_id="0" frame_id="-1" name="美帆"
		   text="(手続きを済ませて、帰ってきたら部屋の片付け‥‥かな？)" voices=""/>
		<msg @l="288" char_id="-1" frame_id="-1" name=""
		   text="私は実家から南総町へと配送した荷物の中身をなんとなく思い出した。" voices=""/>
		<msg @l="289" char_id="-1" frame_id="-1" name=""
		   text="棚やベッドといった大物はあらかじめ引っ越し業者の人が運び込んでくれているから良いとして、後から送った小物類は自分でかたさなければならない。"
		   voices=""/>
		<msg @l="290" char_id="-1" frame_id="-1" name=""
		   text="衣服類や生活必需品は仕方が無いけれど、その他にも本やＣＤ、それから部屋を飾るタペストリやぬいぐるみも包んだ気がする。"
		   voices=""/>
		<char @l="292" id="miho" pos="auto" src="miho016"/>
		<msg @l="293" char_id="0" frame_id="-1" name="美帆"
		   text="(んー‥‥荷物の整理だけで休みが終わっちゃいそう)" voices=""/>
		<char @l="297" id="miho" pos="auto" src="miho110"/>
		<msg @l="299" char_id="-1" frame_id="-1" name=""
		   text="かすかなため息と共に、私は大学行きの路面電車へと乗り込んだ。" voices=""/>
		<clear @l="305" class="all"/>
		<msgshow @l="307" show="true"/>
		<msg @l="309" char_id="-1" frame_id="-1" name="アナウンス"
		   text="『次は終点‥‥大学前、大学前です。』" voices=""/>
		<msg @l="311" char_id="-1" frame_id="-1" name="アナウンス"
		   text="『手荷物のお忘れ物などありませんようご注意ください。』" voices=""/>
		<clear @l="317" class="all"/>
		<msgshow @l="319" show="true"/>
		<label @l="323" id="chart_line1"/>
		<wait_chgmv/>
		<ev @l="327" src="ev-001"/>
		<msg @l="329" char_id="0" frame_id="-1" name="美帆" text="『ん～‥‥風が気持ちいいなぁ。』"
		   voices="miho00000"/>
		<msg @l="331" char_id="-1" frame_id="-1" name=""
		   text="大学前の停留所から事務局へと続く道のりを、私はキャンパスの景色を楽しみながら歩いていた。" voices=""/>
		<msg @l="332" char_id="-1" frame_id="-1" name=""
		   text="初めて歩くキャンパスは当然ながら何もかもが目新しく、まるで自分が新入生になったかのような感覚になる。" voices=""/>
		<msg @l="334" char_id="0" frame_id="-1" name="美帆"
		   text="『素敵な出会い‥‥なんて、偶然に期待してるだけじゃダメなのかもしれないけど。』" voices="miho00010"/>
		<msg @l="339" char_id="0" frame_id="-1" name="美帆"
		   text="『やっぱり、ちょっとだけ期待しちゃうかな‥‥。』" voices="miho00020"/>
		<msg @l="341" char_id="-1" frame_id="-1" name=""
		   text="吹き抜けていく暖かな春風に目を細め、私は一人苦笑を浮かべる。" voices=""/>
		<msg @l="342" char_id="-1" frame_id="-1" name=""
		   text="自分が他人よりも奥手なのはよく解っていた。" voices=""/>
		<msg @l="343" char_id="-1" frame_id="-1" name=""
		   text="どうしても積極的になれない自分にいつもヤキモキしている。" voices=""/>
		<msg @l="344" char_id="-1" frame_id="-1" name=""
		   text="けれど、だからといって簡単に積極的な性格になれる訳でもなくて‥‥。" voices=""/>
		<msg @l="349" char_id="0" frame_id="-1" name="美帆"
		   text="『せっかく環境が変わるんだもん、チャンスだと思って変わる努力をしなくちゃダメだよね。』" voices="miho00030"/>
		<msg @l="351" char_id="-1" frame_id="-1" name=""
		   text="新しい生活、新しい環境‥‥この転入が何かのきっかけになればいい。" voices=""/>
		<msg @l="352" char_id="-1" frame_id="-1" name=""
		   text="すぐに自分の性格を変えるのは難しいけれど‥‥。" voices=""/>
		<msg @l="353" char_id="-1" frame_id="-1" name=""
		   text="新しい自分になろうと努力することは誰にでも出来るハズである。" voices=""/>
		<msg @l="354" char_id="-1" frame_id="-1" name="" text="私はただ、漠然とそんな事を考えていた。"
		   voices=""/>
		<wait_chgmv/>
		<ev @l="358" src="ev-001x2"/>
		<msg @l="360" char_id="0" frame_id="-1" name="美帆"
		   text="(‥‥って、何を一人でブツブツ言ってるんだか)" voices="miho00040"/>
		<msg @l="362" char_id="-1" frame_id="-1" name=""
		   text="ふと周囲を歩いている人たちの視線に気づいて、私は慌てて口を塞いだ。" voices=""/>
		<msg @l="363" char_id="-1" frame_id="-1" name=""
		   text="自然とこぼれだす「期待の笑み」が妙に気恥ずかしい。" voices=""/>
		<msg @l="365" char_id="0" frame_id="-1" name="美帆" text="(はやく事務局いこ‥‥)"
		   voices="miho00050"/>
		<msg @l="367" char_id="-1" frame_id="-1" name=""
		   text="私は熱くなった頬を隠すように、早足でキャンパスを歩いていった。" voices=""/>
		<clear @l="373" class="all"/>
		<msg @l="375" char_id="-1" frame_id="-1" name="事務員"
		   text="『それでは、講義の初日で構いませんので印鑑と保険証を持参してください。』" voices=""/>
		<msg @l="377" char_id="0" frame_id="-1" name="美帆" text="『はい、ありがとうございました。』"
		   voices=""/>
		<wait_chgmv/>
		<bg @l="381" src="bg07"/>
		<char @l="385" id="miho" pos="auto" src="miho010"/>
		<msg @l="387" char_id="-1" frame_id="-1" name=""
		   text="事務局で簡単な手続きを済ませた私は、校舎を出て再びキャンパスへと戻ってきた。" voices=""/>
		<char @l="391" id="miho" pos="auto" src="miho015"/>
		<msg @l="393" char_id="0" frame_id="-1" name="美帆"
		   text="(匂い‥‥落ちなかったらどうしよう‥‥)" voices=""/>
		<msg @l="395" char_id="-1" frame_id="-1" name=""
		   text="切実かつ率直な愚痴を呟いて、私は服に染み付いてしまったタバコの匂いに眉をひそめた。" voices=""/>
		<msg @l="396" char_id="-1" frame_id="-1" name=""
		   text="転入手続きそれ自体は、１０分とせず終了したのだけれど‥‥。" voices=""/>
		<msg @l="397" char_id="-1" frame_id="-1" name=""
		   text="構内にひとつしかない事務局は、転入手続きに訪れた同年代の学生たちで終始騒然としていて‥‥。" voices=""/>
		<msg @l="398" char_id="-1" frame_id="-1" name=""
		   text="しかもそこから溢れた学生の待機所に指定された食堂は、禁煙スペースと喫煙スペースの間に物理的な仕切りが存在していなかったのだ。"
		   voices=""/>
		<msg @l="399" char_id="-1" frame_id="-1" name=""
		   text="あいにく私はタバコの煙が苦手な人間なので、視界が曇るほどの煙で満たされた場所で、自分の順番を待ち続けるというのは非常に辛かった。"
		   voices=""/>
		<msg @l="401" char_id="0" frame_id="-1" name="美帆"
		   text="(もぅ‥‥どうして、受付期間を春休み最後の三日間とかじゃなくて春休みの最初からにしてくれないのかしら)" voices=""/>
		<msg @l="403" char_id="-1" frame_id="-1" name=""
		   text="未だに涙のにじむ両目をハンカチで押さえながら、私は再び愚痴をこぼした。" voices=""/>
		<msg @l="404" char_id="-1" frame_id="-1" name=""
		   text="予想されうる混雑を避ける為に、わざわざ受付初日を選んで来たというのに、その初日からしてこんな状態になるとは思ってもいなかった。"
		   voices=""/>
		<msg @l="406" char_id="0" frame_id="-1" name="美帆"
		   text="(なんて‥‥文句ばっかり言っててもしょうがないか)" voices=""/>
		<msg @l="408" char_id="0" frame_id="-1" name="美帆"
		   text="(無事に転入手続きが終わったんだから、良しとしなくちゃ)" voices=""/>
		<msg @l="410" char_id="-1" frame_id="-1" name=""
		   text="私はシワの寄っていた眉を指でマッサージをするように撫でて、心持ち緩める。" voices=""/>
		<msg @l="411" char_id="-1" frame_id="-1" name=""
		   text="何事も前向きに、というのがこの転入を機に打ち立てた私の目標だ。" voices=""/>
		<char @l="415" id="miho" pos="auto" src="miho011"/>
		<msg @l="417" char_id="0" frame_id="-1" name="美帆"
		   text="『うんうん、なんだか前向きになれるような気が‥‥。』" voices=""/>
		<msg @l="422" char_id="-1" frame_id="0" name="" text="「ぐぅぅぅ‥‥。」" voices=""/>
		<char @l="427" id="miho" pos="auto" src="miho013"/>
		<msg @l="429" char_id="0" frame_id="-1" name="美帆" text="(あう‥‥)" voices=""/>
		<msg @l="431" char_id="-1" frame_id="-1" name=""
		   text="不意にお腹の虫が騒ぎだして思わず赤面してしまう。" voices=""/>
		<msg @l="432" char_id="-1" frame_id="-1" name=""
		   text="時計を見ると、既に３時を大きく回ってしまっていた。" voices=""/>
		<msg @l="433" char_id="-1" frame_id="-1" name=""
		   text="お昼というには少し遅い時間になってしまったが、かといって夜まで我慢するには時間がありすぎる。" voices=""/>
		<char @l="437" id="miho" pos="auto" src="miho116"/>
		<msg @l="439" char_id="0" frame_id="-1" name="美帆"
		   text="(こんな事なら駅前で済ましてから来ればよかったかな‥‥)" voices=""/>
		<msg @l="441" char_id="-1" frame_id="-1" name=""
		   text="家に帰る途中で遅い昼食がてらウィンドウショッピング、という手もあるのだけれど、そうなると夕食までに荷物が片付かなくなってしまうし‥‥。"
		   voices=""/>
		<char @l="445" id="miho" pos="auto" src="miho016"/>
		<msg @l="447" char_id="0" frame_id="-1" name="美帆"
		   text="(って、ダメダメ‥‥まだ引っ越しの荷物も整理できてないのに)" voices=""/>
		<msg @l="449" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<char @l="453" id="miho" pos="auto" src="miho013"/>
		<msg @l="455" char_id="0" frame_id="-1" name="美帆"
		   text="(でも‥‥ちょっと見るだけなら、いいかな？)" voices=""/>
		<msg @l="457" char_id="-1" frame_id="-1" name=""
		   text="そうして「見るだけ」という条件で、さっきの決心が揺らいだそのすぐ後には、自分への転入祝いだとか、引っ越し祝いだとか、心機一転の為だとか、あれこれ理由をつけては、物を買うための大義名分がぐるぐると頭の中を巡っていた。"
		   voices=""/>
		<msg @l="459" char_id="-1" frame_id="-1" name="" text="‥‥でも、見に行っちゃおう。"
		   voices=""/>
		<char @l="462" id="miho" pos="auto" src="miho011"/>
		<msg @l="464" char_id="0" frame_id="-1" name="美帆"
		   text="(ふふっ‥‥そうと決まれば、駅前に急がなくちゃ)" voices=""/>
		<clear @l="470" class="all"/>
		<msg @l="472" char_id="-1" frame_id="-1" name=""
		   text="私は、停留所を目指してキャンパス内を軽い足取りで歩きだした。" voices=""/>
		<msg @l="474" char_id="0" frame_id="-1" name="美帆"
		   text="(んと、ここの角を曲がるんだっけ‥‥？)" voices=""/>
		<stopbgm @l="479" fadeout="1000"/>
		<wait_chgmv/>
		<bg @l="484" src="bg07"/>
		<char @l="488" id="rei" pos="auto" src="rei014"/>
		<msg @l="490" char_id="1" frame_id="-1" name="スーツの女性" text="『‥‥！』" voices=""/>
		<char @l="495" id="miho" pos="auto" src="miho114"/>
		<msg @l="497" char_id="0" frame_id="-1" name="美帆" text="『え‥‥？』" voices=""/>
		<se @l="501" buf="1" src="人とぶつかる音軽め" volume="1."/>
		<shake @l="505" amp="10" class="all" cycle="30" duration="600" type="random"/>
		<msg @l="507" char_id="0" frame_id="-1" name="美帆" text="『わわ！？』" voices=""/>
		<msg @l="509" char_id="1" frame_id="-1" name="スーツの女性" text="『あぶな‥‥！』"
		   voices=""/>
		<se @l="513" buf="1" src="人が倒れる音_軽め" volume="1."/>
		<shake @l="517" amp="10" class="all" cycle="30" duration="1000"
		   type="random"/>
		<clear @l="523" class="all"/>
		<msg @l="525" char_id="0" frame_id="-1" name="美帆" text="『いたたた‥‥。』"
		   voices="miho00060"/>
		<msg @l="527" char_id="-1" frame_id="-1" name=""
		   text="視界の前に突然現れたスーツ姿の女性とぶつかり、私はその場で派手に尻もちをついてしまった。" voices=""/>
		<label @l="531" id="chart_line2"/>
		<wait_chgmv/>
		<ev @l="535" src="ev-003"/>
		<bgm @l="539" src="bgm05" volume="1."/>
		<msg @l="541" char_id="1" frame_id="-1" name="スーツの女性" text="『‥‥大丈夫？』"
		   voices="rei00000"/>
		<msg @l="543" char_id="-1" frame_id="-1" name=""
		   text="転んだ私を心配するように、スーツの女性が覗き込んできた。" voices=""/>
		<msg @l="544" char_id="-1" frame_id="-1" name=""
		   text="長く綺麗な髪が風に揺れると、微かなフローラルの香りが漂ってくる。" voices=""/>
		<msg @l="546" char_id="0" frame_id="-1" name="美帆" text="(うわ‥‥すごく綺麗なひと‥‥‥)"
		   voices="miho00070"/>
		<msg @l="548" char_id="-1" frame_id="-1" name=""
		   text="私は思わず、眼前の女性に見惚れてしまった。" voices=""/>
		<msg @l="549" char_id="-1" frame_id="-1" name=""
		   text="冷静沈着、知的、大人‥‥そんな言葉がよく似合うひとだ。" voices=""/>
		<msg @l="551" char_id="0" frame_id="-1" name="美帆"
		   text="(四年生の人かな‥‥なんか、雰囲気とか全然違うものね)" voices="miho00080"/>
		<msg @l="553" char_id="1" frame_id="-1" name="スーツの女性" text="『‥‥‥‥。』"
		   voices="rei00010"/>
		<msg @l="555" char_id="1" frame_id="-1" name="スーツの女性" text="『貴女、本当に大丈夫？』"
		   voices="rei00020"/>
		<msg @l="557" char_id="0" frame_id="-1" name="美帆" text="『え？』"
		   voices="miho00090"/>
		<msg @l="559" char_id="1" frame_id="-1" name="スーツの女性"
		   text="『ぼうっとして‥‥具合でも悪いの？&#32;』" voices="rei00030"/>
		<msg @l="561" char_id="0" frame_id="-1" name="美帆" text="『い、いえっ‥‥違います！』"
		   voices="miho00100"/>
		<msg @l="563" char_id="0" frame_id="-1" name="美帆" text="『私はただ‥‥‥その、えっと‥‥‥。』"
		   voices="miho00110"/>
		<msg @l="565" char_id="-1" frame_id="-1" name="" text="私はそこで不意に言葉を失った。"
		   voices=""/>
		<msg @l="566" char_id="-1" frame_id="-1" name=""
		   text="「見惚れていました」なんて同性に言う台詞ではない気がするし、かといって咄嗟に気の利いた事も思いつかず、あわあわと焦るだけであった。"
		   voices=""/>
		<msg @l="568" char_id="1" frame_id="-1" name="スーツの女性" text="『私はただ‥‥？』"
		   voices="rei00040"/>
		<msg @l="570" char_id="0" frame_id="-1" name="美帆" text="『え‥‥あ、その‥‥‥。』"
		   voices="miho00120"/>
		<msg @l="572" char_id="0" frame_id="-1" name="美帆"
		   text="『‥‥ごめんなさい、少しぼうっとしてただけです。』" voices="miho00130"/>
		<msg @l="574" char_id="1" frame_id="-1" name="スーツの女性" text="『‥‥‥‥。』"
		   voices="rei00050"/>
		<msg @l="576" char_id="0" frame_id="-1" name="美帆" text="『‥‥ごめんなさい。』"
		   voices="miho00140"/>
		<msg @l="578" char_id="1" frame_id="-1" name="スーツの女性"
		   text="『別に良いわ、気にしてないわよ。』" voices="rei00070"/>
		<msg @l="580" char_id="1" frame_id="-1" name="スーツの女性" text="『ほら‥‥掴まって。』"
		   voices="rei00080"/>
		<clear @l="586" class="all"/>
		<msg @l="588" char_id="-1" frame_id="-1" name=""
		   text="スーツの女性は「やれやれ」といった表情を浮かべてみせると、私の手をおもむろに掴んで引き上げた。" voices=""/>
		<msg @l="590" char_id="0" frame_id="-1" name="美帆" text="『ご、ごめんなさいっ。』"
		   voices="miho00150"/>
		<msg @l="592" char_id="-1" frame_id="-1" name=""
		   text="私は、慌てて脇に転がっていたカバンを拾い上げ、半ば引きずられるような形で立ち上がった。" voices=""/>
		<wait_chgmv/>
		<bg @l="596" src="bg07"/>
		<char @l="600" id="miho" pos="left" src="miho015"/>
		<char @l="604" id="rei" pos="right" src="rei010"/>
		<msg @l="606" char_id="1" frame_id="-1" name="スーツの女性"
		   text="『どう？&#32;怪我はないかしら？』" voices=""/>
		<char @l="610" id="miho" pos="left" src="miho016"/>
		<msg @l="612" char_id="0" frame_id="-1" name="美帆" text="『えっと‥‥大丈夫だと思います。』"
		   voices=""/>
		<char @l="616" id="rei" pos="right" src="rei011"/>
		<msg @l="618" char_id="1" frame_id="-1" name="スーツの女性" text="『そう、よかった。』"
		   voices=""/>
		<char @l="622" id="miho" pos="left" src="miho010"/>
		<msg @l="624" char_id="0" frame_id="-1" name="美帆" text="『あの‥‥本当にすみませんでした。』"
		   voices=""/>
		<char @l="628" id="rei" pos="right" src="rei020"/>
		<msg @l="630" char_id="1" frame_id="-1" name="スーツの女性"
		   text="『結果オーライ、二人とも無事だったんだから良かったのじゃないかしら？』" voices=""/>
		<msg @l="632" char_id="-1" frame_id="-1" name=""
		   text="そういって、スーツの女性は少しおどけるようにウィンクをした。" voices=""/>
		<char @l="636" id="miho" pos="left" src="miho111"/>
		<msg @l="638" char_id="-1" frame_id="-1" name=""
		   text="その愛くるしい仕草が、彼女の凛とした外見とは妙にアンバランスで、私は思わず吹き出すように笑ってしまった。" voices=""/>
		<char @l="642" id="rei" pos="right" src="rei114"/>
		<msg @l="644" char_id="1" frame_id="-1" name="スーツの女性"
		   text="『あら‥‥いまの、そんなに可笑しかったかしら？』" voices=""/>
		<char @l="648" id="miho" pos="left" src="miho011"/>
		<msg @l="650" char_id="0" frame_id="-1" name="美帆"
		   text="『いえ、良いと思います。すごく親近感が持てました。』" voices=""/>
		<char @l="654" id="rei" pos="right" src="rei128"/>
		<msg @l="656" char_id="1" frame_id="-1" name="スーツの女性"
		   text="『んー、何となく腑に落ちないけど‥‥まあいいわ。』" voices=""/>
		<msg @l="658" char_id="-1" frame_id="-1" name=""
		   text="そう言って、スーツの女性は少しだけ困った顔をした。" voices=""/>
		<msg @l="659" char_id="-1" frame_id="-1" name=""
		   text="彼女は思ったほど堅い人‥‥というわけではないようだ。" voices=""/>
		<char @l="663" id="rei" pos="right" src="rei010"/>
		<msg @l="665" char_id="1" frame_id="-1" name="スーツの女性"
		   text="『そういえば貴女、今年度から南総町のキャンパスに移動してきた子でしょ？』" voices=""/>
		<char @l="669" id="miho" pos="left" src="miho010"/>
		<msg @l="671" char_id="0" frame_id="-1" name="美帆" text="『え、わかりますか？』"
		   voices=""/>
		<char @l="674" id="miho" pos="left" src="miho016"/>
		<msg @l="676" char_id="1" frame_id="-1" name="スーツの女性"
		   text="『見るからに不慣れって感じだもの、わかるわよ。』" voices=""/>
		<msg @l="678" char_id="0" frame_id="-1" name="美帆" text="『‥‥すみません。』"
		   voices=""/>
		<char @l="682" id="rei" pos="right" src="rei021"/>
		<msg @l="684" char_id="1" frame_id="-1" name="スーツの女性"
		   text="『謝ることはないわ。誰だって最初は不慣れなものよ。』" voices=""/>
		<char @l="688" id="rei" pos="right" src="rei010"/>
		<msg @l="690" char_id="1" frame_id="-1" name="スーツの女性"
		   text="『ただ‥‥そうね、ちょっと心配ではあるかしら。』" voices=""/>
		<char @l="694" id="miho" pos="left" src="miho014"/>
		<msg @l="696" char_id="0" frame_id="-1" name="美帆" text="『心配‥‥ですか？』"
		   voices=""/>
		<msg @l="698" char_id="1" frame_id="-1" name="スーツの女性" text="『‥‥‥‥。』"
		   voices=""/>
		<msg @l="700" char_id="1" frame_id="-1" name="スーツの女性"
		   text="『転入早々から不安にさせるような事を言いたくはないのだけれど‥‥最近この辺りで不審な男がよく目撃されてるの。』" voices=""/>
		<char @l="704" id="miho" pos="left" src="miho115"/>
		<msg @l="706" char_id="0" frame_id="-1" name="美帆" text="『不審な男‥‥ですか？』"
		   voices=""/>
		<msg @l="708" char_id="1" frame_id="-1" name="スーツの女性"
		   text="『ええ。夕方とか夜‥‥特に決まった時間ではないみたいだけれど、キャンパスに現れては無言でどこかをじっと見ているんですって。』"
		   voices=""/>
		<msg @l="710" char_id="1" frame_id="-1" name="スーツの女性"
		   text="『今のところ特に被害はないみたいだけど‥‥仮に変質者だった場合のことを考えると、注意しておくに越した事は無いと思うわ。』"
		   voices=""/>
		<char @l="714" id="miho" pos="left" src="miho010"/>
		<msg @l="716" char_id="0" frame_id="-1" name="美帆" text="『わかりました、注意します。』"
		   voices=""/>
		<clear @l="722" class="all"/>
		<msgshow @l="724" show="true"/>
		<wait_chgmv/>
		<bg @l="728" src="bg07"/>
		<char @l="732" id="miho" pos="left" src="miho010"/>
		<char @l="736" id="rei" pos="right" src="rei011"/>
		<msg @l="738" char_id="1" frame_id="-1" name="スーツの女性"
		   text="『それじゃ、私はこれからサークルだから。』" voices=""/>
		<char @l="742" id="miho" pos="left" src="miho113"/>
		<msg @l="744" char_id="0" frame_id="-1" name="美帆"
		   text="『えっと、色々ありがとうございました。』" voices=""/>
		<msg @l="746" char_id="1" frame_id="-1" name="スーツの女性" text="『これも何かの縁だと思うわ。』"
		   voices=""/>
		<char @l="750" id="rei" pos="right" src="rei111"/>
		<msg @l="752" char_id="1" frame_id="-1" name="スーツの女性"
		   text="『また今度、機会があったらお話しましょう。』" voices=""/>
		<clear @l="756" layer="rei"/>
		<msg @l="758" char_id="-1" frame_id="-1" name=""
		   text="スーツの女性はそういって微笑むと、しなやかな足取りで歩いて行った。" voices=""/>
		<msg @l="759" char_id="-1" frame_id="-1" name=""
		   text="その後ろ姿でさえもグラビアアイドルかファッションモデルのようで‥‥。" voices=""/>
		<msg @l="760" char_id="-1" frame_id="-1" name=""
		   text="その綺麗な姿に、私はやはりしばらく見とれてしまっていた。" voices=""/>
		<char @l="764" id="miho" pos="left" src="miho010"/>
		<msg @l="766" char_id="0" frame_id="-1" name="美帆"
		   text="(あ‥‥名前くらい、聞いておけばよかったかな)" voices=""/>
		<msg @l="768" char_id="-1" frame_id="-1" name=""
		   text="彼女の姿が見えなくなった後、私は再び停留所へと足を向けた。" voices=""/>
		<stopbgm @l="772" fadeout="1000"/>
		<clear @l="776" layer="miho"/>
		<clear @l="782" class="all"/>
		<msgshow @l="784" show="true"/>
		<msg @l="786" char_id="-1" frame_id="-1" name="" text="‥‥‥‥‥‥‥‥。" voices=""/>
		<msg @l="787" char_id="-1" frame_id="-1" name="" text="‥‥‥‥‥‥。" voices=""/>
		<msg @l="788" char_id="-1" frame_id="-1" name="" text="‥‥‥‥。" voices=""/>
		<wait_chgmv/>
		<bg @l="792" src="bg18m1"/>
		<bgm @l="796" src="bgm02" volume="1."/>
		<msg @l="798" char_id="0" frame_id="-1" name="美帆" text="(ふぅ‥‥やっと、駅前についた‥‥)"
		   voices=""/>
		<msg @l="800" char_id="0" frame_id="-1" name="美帆"
		   text="(ゴハンは‥‥お弁当でも買って帰ろうかな)" voices=""/>
		<msg @l="802" char_id="-1" frame_id="-1" name=""
		   text="そんな事を考えながら、私は駅前にある大手デパートへと歩きだす。" voices=""/>
		<msg @l="803" char_id="-1" frame_id="-1" name=""
		   text="慣れない道はやはり歩きづらくて、人の流れに翻弄されそうになってしまった。" voices=""/>
		<msg @l="804" char_id="-1" frame_id="-1" name=""
		   text="いや‥‥慣れた道を歩いても人の流れに巻き込まれることがあるかも‥‥。" voices=""/>
		<msg @l="805" char_id="-1" frame_id="-1" name=""
		   text="そう考えていた矢先‥‥‥目の前に人が飛び出した。" voices=""/>
		<char @l="809" id="miho" pos="auto" src="miho114"/>
		<msg @l="811" char_id="0" frame_id="-1" name="美帆" text="『え‥‥？』" voices=""/>
		<msg @l="813" char_id="-1" frame_id="0" name="" text="「ドン！」" voices=""/>
		<se @l="817" buf="1" src="人とぶつかる音軽め" volume="1."/>
		<shake @l="821" amp="10" class="all" cycle="30" duration="600" type="random"/>
		<msg @l="823" char_id="0" frame_id="-1" name="美帆" text="『キャッ！』" voices=""/>
		<msg @l="825" char_id="-1" frame_id="-1" name="通行人" text="『おう！どこ見て歩いてんだ！』"
		   voices=""/>
		<msg @l="827" char_id="0" frame_id="-1" name="美帆" text="『ご、ごめんなさい！』"
		   voices=""/>
		<msg @l="829" char_id="-1" frame_id="-1" name="通行人" text="『けっ！気をつけろよな！』"
		   voices=""/>
		<char @l="833" id="miho" pos="auto" src="miho015"/>
		<msg @l="835" char_id="0" frame_id="-1" name="美帆" text="『‥‥ごめんなさい‥‥』"
		   voices=""/>
		<msg @l="837" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥』" voices=""/>
		<clear @l="841" class="char"/>
		<msg @l="843" char_id="0" frame_id="-1" name="美帆"
		   text="(もう‥‥‥私ったら2度もぶつかるなんてドジよね‥‥‥)" voices=""/>
		<msg @l="845" char_id="0" frame_id="-1" name="美帆" text="(ふぅ‥‥‥)" voices=""/>
		<msg @l="847" char_id="0" frame_id="-1" name="美帆" text="(でも‥‥‥‥)" voices=""/>
		<msg @l="849" char_id="0" frame_id="-1" name="美帆"
		   text="(どうしても‥‥人の多いところって苦手なんだよね)" voices=""/>
		<msg @l="851" char_id="0" frame_id="-1" name="美帆" text="(今、ぶつかった人もそうだけど‥‥)"
		   voices=""/>
		<msg @l="853" char_id="0" frame_id="-1" name="美帆"
		   text="(なんだかみんな冷たくて、自分の事だけ考えてるみたいで‥‥)" voices=""/>
		<msg @l="855" char_id="0" frame_id="-1" name="美帆"
		   text="(そういうのってなんだか‥‥さみしいな)" voices=""/>
		<msg @l="857" char_id="-1" frame_id="-1" name=""
		   text="人の流れに疲れた私は、通りの端に身を寄せて深くため息を吐いた。" voices=""/>
		<msg @l="859" char_id="3" frame_id="-1" name="女の子" text="『‥‥‥‥。』" voices=""/>
		<msg @l="861" char_id="0" frame_id="-1" name="美帆" text="『‥‥？』" voices=""/>
		<msg @l="863" char_id="-1" frame_id="-1" name=""
		   text="ふと、人ごみの中から視線を感じてそちらを見ると、女の子が一人、無言でこちらを見つめていた。" voices=""/>
		<msg @l="864" char_id="-1" frame_id="-1" name=""
		   text="色素の薄い‥‥どこか存在感の無い不思議な少女―――。" voices=""/>
		<msg @l="865" char_id="-1" frame_id="-1" name="" text="その少女が、じっと「私」を見つめている。"
		   voices=""/>
		<msg @l="867" char_id="0" frame_id="-1" name="美帆" text="『‥‥私に何か用ですか？』"
		   voices=""/>
		<char @l="871" id="nanak" pos="auto" src="nanako015"/>
		<msg @l="873" char_id="3" frame_id="-1" name="女の子" text="『さみしくなんてないよ。』"
		   voices=""/>
		<stopbgm @l="877" fadeout="1000"/>
		<msg @l="879" char_id="0" frame_id="-1" name="美帆" text="『え‥‥？』" voices=""/>
		<bgm @l="883" src="bgm11" volume="1."/>
		<char @l="887" id="nanak" pos="auto" src="nanako010"/>
		<msg @l="889" char_id="3" frame_id="-1" name="女の子" text="『大丈夫、さみしくなんかないよ。』"
		   voices=""/>
		<msg @l="891" char_id="0" frame_id="-1" name="美帆"
		   text="『さみしくないって‥‥どういう‥‥‥。』" voices=""/>
		<msg @l="893" char_id="-1" frame_id="-1" name="" text="“さみしくないよ”" voices=""/>
		<msg @l="894" char_id="-1" frame_id="-1" name=""
		   text="思わず私は“ぞくり”と背筋が寒くなる‥‥。" voices=""/>
		<msg @l="895" char_id="-1" frame_id="-1" name=""
		   text="それは、つい先ほど私が考えていた心の声に対する返答のような気がして―――。" voices=""/>
		<msg @l="896" char_id="-1" frame_id="-1" name=""
		   text="心を読まれているかのようなその言葉に、私は思わず言葉を失くした。" voices=""/>
		<msg @l="898" char_id="3" frame_id="-1" name="女の子" text="『‥‥‥‥。』" voices=""/>
		<msg @l="900" char_id="-1" frame_id="-1" name="" text="―――沈黙。" voices=""/>
		<msg @l="901" char_id="-1" frame_id="-1" name="" text="少女はただじっと押し黙り、私を見た。"
		   voices=""/>
		<msg @l="902" char_id="-1" frame_id="-1" name=""
		   text="その視線はまるで私の心の中を覗き込むかのように‥‥。" voices=""/>
		<msg @l="904" char_id="0" frame_id="-1" name="美帆" text="『‥‥貴女は、もしかして‥‥‥。』"
		   voices=""/>
		<msg @l="906" char_id="-1" frame_id="-1" name=""
		   text="言いかけた直後、私は自分の仮定のばかばかしさにその続きを言うのを止めた。" voices=""/>
		<msg @l="907" char_id="-1" frame_id="-1" name=""
		   text="自分がたまたま不景気そうな顔をしていたと考えた方が余程つじつまが合うからだ。" voices=""/>
		<char @l="911" id="nanak" pos="auto" src="nanako018"/>
		<msg @l="913" char_id="3" frame_id="-1" name="女の子" text="『‥‥？』" voices=""/>
		<msg @l="915" char_id="-1" frame_id="-1" name="" text="少女は不思議そうに小首を傾げて見せる。"
		   voices=""/>
		<msg @l="916" char_id="-1" frame_id="-1" name=""
		   text="どちらかというと疑問に思っているのは私のほうなのだけれど‥‥。" voices=""/>
		<msg @l="918" char_id="-1" frame_id="-1" name="男の声" text="『―――奈那子。』"
		   voices=""/>
		<clear @l="921" class="char"/>
		<char @l="923" id="nanak" pos="left" src="nanako010"/>
		<char @l="926" id="shiny" pos="right" src="shinya210"/>
		<msg @l="928" char_id="-1" frame_id="-1" name="" text="いつの間に近づいたのだろう。"
		   voices=""/>
		<msg @l="929" char_id="-1" frame_id="-1" name=""
		   text="気づけば、少女の傍らには男の人が寄り添っていた。" voices=""/>
		<msg @l="930" char_id="-1" frame_id="-1" name=""
		   text="男の人はこちらに背を向けており、表情まではよくわからない。" voices=""/>
		<msg @l="931" char_id="-1" frame_id="-1" name=""
		   text="ただ‥‥ひどく殺伐とした雰囲気だけが切々と伝わってきた。" voices=""/>
		<msg @l="933" char_id="-1" frame_id="-1" name="若い男"
		   text="『奈那子、一人で先にいっては駄目だと言っただろう。』" voices=""/>
		<char @l="937" id="nanak" pos="left" src="nanako015"/>
		<msg @l="939" char_id="3" frame_id="-1" name="女の子"
		   text="『ごめんなさい‥‥なんだか、呼ばれた気がして。』" voices=""/>
		<msg @l="941" char_id="-1" frame_id="-1" name=""
		   text="ナナコと呼ばれた少女は、謝罪とも言い訳とも取れる言葉と共に、申し訳なさそうな表情をすると、その男の腕に両手をまわしてそっと抱きついた。"
		   voices=""/>
		<msg @l="942" char_id="-1" frame_id="-1" name=""
		   text="その一連の仕草があまりにも愛らしく、私は思わず、何十年か前に大流行していた「だっこちゃん人形」を連想してしまった。"
		   voices=""/>
		<char @l="946" id="nanak" pos="left" src="nanako018"/>
		<msg @l="948" char_id="3" frame_id="-1" name="女の子" text="『‥‥なぁに、それ？』"
		   voices=""/>
		<msg @l="950" char_id="0" frame_id="-1" name="美帆" text="『‥‥え！？』" voices=""/>
		<msg @l="952" char_id="-1" frame_id="-1" name="" text="「なに」とは一体どういう事なのだろう？"
		   voices=""/>
		<msg @l="953" char_id="-1" frame_id="-1" name=""
		   text="先ほどから一言も喋ってないというのに―――。" voices=""/>
		<msg @l="954" char_id="-1" frame_id="-1" name="" text="まさか‥‥。" voices=""/>
		<msg @l="956" char_id="-1" frame_id="-1" name="若い男" text="『‥‥‥‥。』" voices=""/>
		<msg @l="958" char_id="-1" frame_id="-1" name="若い男"
		   text="『‥‥俺たちの事は、あまり詮索しない方がいい。』" voices=""/>
		<msg @l="960" char_id="0" frame_id="-1" name="美帆" text="『え‥‥？』" voices=""/>
		<msg @l="962" char_id="-1" frame_id="-1" name="若い男" text="『奈那子、いくぞ。』"
		   voices=""/>
		<char @l="966" id="nanak" pos="left" src="nanako010"/>
		<msg @l="968" char_id="3" frame_id="-1" name="女の子" text="『はい‥‥兄様。』"
		   voices=""/>
		<clear @l="973" class="char"/>
		<msg @l="975" char_id="0" frame_id="-1" name="美帆" text="『あっ‥‥。』" voices=""/>
		<msg @l="977" char_id="-1" frame_id="-1" name=""
		   text="立ち去ろうとしている二人に向けて、私は咄嗟に手を伸ばした―――。" voices=""/>
		<msg @l="979" char_id="-1" frame_id="-1" name=""
		   text="しかし二人はあっという間に人ごみの中へと紛れてしまった。" voices=""/>
		<msg @l="981" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="983" char_id="0" frame_id="-1" name="美帆" text="『私は‥‥。』" voices=""/>
		<msg @l="985" char_id="0" frame_id="-1" name="美帆"
		   text="『私は‥‥あの人たちをこの場に引きとめて、どうしたかったんだろう？』" voices=""/>
		<msg @l="987" char_id="-1" frame_id="-1" name=""
		   text="人通りからわずかに離れたビルの壁際で、私は一人つぶやいた。" voices=""/>
		<msg @l="988" char_id="-1" frame_id="-1" name="" text="きっと彼らは何も答えてはくれない。"
		   voices=""/>
		<msg @l="989" char_id="-1" frame_id="-1" name=""
		   text="あの少女が私の心を読んでいるように感じた事も、あの二人に何処となく覚えた不思議な違和感についても‥‥。" voices=""/>
		<msg @l="991" char_id="0" frame_id="-1" name="美帆"
		   text="『‥‥忘れた方がいいのかな、やっぱり。』" voices=""/>
		<msg @l="993" char_id="-1" frame_id="-1" name=""
		   text="背中に感じる冷たいコンクリートの感触に眉をひそめながら、私は自分に言い聞かせるようにしてつぶやいた。" voices=""/>
		<stopbgm @l="997" fadeout="1000"/>
		<clear @l="1003" class="all"/>
		<msgshow @l="1005" show="true"/>
		<msg @l="1007" char_id="-1" frame_id="-1" name="" text="‥‥‥‥‥‥‥‥。" voices=""/>
		<msg @l="1008" char_id="-1" frame_id="-1" name="" text="‥‥‥‥‥‥。" voices=""/>
		<msg @l="1009" char_id="-1" frame_id="-1" name="" text="‥‥‥‥。" voices=""/>
		<wait_chgmv/>
		<bg @l="1013" src="bg04"/>
		<bgm @l="1017" src="bgm02" volume="1."/>
		<char @l="1021" id="miho" pos="auto" src="miho010"/>
		<msg @l="1023" char_id="0" frame_id="-1" name="美帆"
		   text="(やっとついた――‥‥駅から結構歩かなくちゃいけないのが欠点よね)" voices=""/>
		<msg @l="1025" char_id="-1" frame_id="-1" name=""
		   text="数日前に引越しを終えたばかりのマンションにたどり着いた私は、少しだけ乱れた呼吸を整えながら建物をゆっくりと見上げた。"
		   voices=""/>
		<msg @l="1026" char_id="-1" frame_id="-1" name=""
		   text="不思議な兄妹と会った後、デパートに寄るのを止めてそのまま帰ってきたのである。" voices=""/>
		<msg @l="1027" char_id="-1" frame_id="-1" name=""
		   text="何となく、ウィンドウショッピングに行くような気分ではなくなってしまったのだ。" voices=""/>
		<msg @l="1029" char_id="0" frame_id="-1" name="美帆"
		   text="(毒気に当てられたっていうか、少し身体が重い気がする‥‥)" voices=""/>
		<clear @l="1035" class="all"/>
		<msg @l="1040" char_id="-1" frame_id="-1" name=""
		   text="正面玄関の扉を開け、エレベーターのボタンを押す。" voices=""/>
		<se @l="1044" buf="1" src="エレベータが来る音" volume="1."/>
		<msg @l="1046" char_id="-1" frame_id="-1" name=""
		   text="ほどなくしてエレベーターが下りてきて、私はそれに乗り込んだ。" voices=""/>
		<msg @l="1048" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="1050" char_id="-1" frame_id="-1" name=""
		   text="馴染みの無い場所で乗るエレベーターというのは、何となく不慣れで怖い。" voices=""/>
		<msg @l="1051" char_id="-1" frame_id="-1" name=""
		   text="狭い空間に閉じ込められる事への不安感‥‥。" voices=""/>
		<msg @l="1053" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥ふぅ‥‥。』"
		   voices=""/>
		<msg @l="1055" char_id="-1" frame_id="-1" name=""
		   text="エレベーターの壁にもたれかかり、私は小さくため息を吐いた。" voices=""/>
		<msg @l="1056" char_id="-1" frame_id="-1" name=""
		   text="あの少女と会ってから、どうも調子がおかしい。" voices=""/>
		<msg @l="1057" char_id="-1" frame_id="-1" name=""
		   text="いや―――調子がおかしいのはむしろ「南総町」に訪れてから、だろうか。" voices=""/>
		<msg @l="1059" char_id="0" frame_id="-1" name="美帆" text="(やっぱり‥‥疲れてるんだ)"
		   voices=""/>
		<msg @l="1061" char_id="-1" frame_id="-1" name="" text="私はそのままゆっくりとまぶたを閉じる。"
		   voices=""/>
		<msg @l="1062" char_id="-1" frame_id="-1" name=""
		   text="そして‥‥モーターの出す振動に身を任せるようにして、目的階への到着をじっと待つ事にした。" voices=""/>
		<wait_chgmv/>
		<bg @l="1067" src="bg05"/>
		<msg @l="1069" char_id="-1" frame_id="-1" name=""
		   text="エレベーターを下りて、扉が並んだ廊下へと歩み出た。" voices=""/>
		<msg @l="1070" char_id="-1" frame_id="-1" name=""
		   text="昼間だとというのに、廊下には人の気配がまったくない。" voices=""/>
		<msg @l="1071" char_id="-1" frame_id="-1" name=""
		   text="説明会で聞いた話によると、このマンションは南総町キャンパスに通う学生を対象に賃貸している特別なものなので一般の入居者は皆無なのだそうだ。"
		   voices=""/>
		<msg @l="1072" char_id="-1" frame_id="-1" name=""
		   text="大学が地元建設会社の協力を得て行っている事らしく、食費を除く生活費と家賃に関してはすべて学費からまかなわれる仕組みになっている。"
		   voices=""/>
		<msg @l="1073" char_id="-1" frame_id="-1" name=""
		   text="ここ南総町にはそうした目的で建てられたマンション・アパートが幾つも存在しており、転入生はそこから自由に入居先を選択する事が出来るそうだ。"
		   voices=""/>
		<char @l="1077" id="miho" pos="auto" src="miho110"/>
		<msg @l="1079" char_id="0" frame_id="-1" name="美帆"
		   text="(春休みだから、みんな実家に帰ってるのかな？)" voices=""/>
		<msg @l="1081" char_id="-1" frame_id="-1" name=""
		   text="そんな事を思いながら、私は部屋のナンバーを確認しつつ廊下を歩いた。" voices=""/>
		<msg @l="1082" char_id="-1" frame_id="-1" name="" text="―――３０７号室" voices=""/>
		<msg @l="1083" char_id="-1" frame_id="-1" name=""
		   text="それが、これから私が生活をする為の部屋だ。" voices=""/>
		<msg @l="1085" char_id="0" frame_id="-1" name="美帆"
		   text="(たしか‥‥転入生には必ず先輩のルームメイトがつくのよね)" voices=""/>
		<char @l="1089" id="miho" pos="auto" src="miho116"/>
		<msg @l="1091" char_id="0" frame_id="-1" name="美帆" text="(上手くやっていけるかな‥‥)"
		   voices=""/>
		<msg @l="1093" char_id="-1" frame_id="-1" name=""
		   text="私はパンフレットに書かれていた一文を思い返し、僅かな不安を募らせた。" voices=""/>
		<msg @l="1094" char_id="-1" frame_id="-1" name=""
		   text="人見知りをする私は、新しく会う人と打ち解けるまでに時間がかかるほうだからだ。" voices=""/>
		<msg @l="1095" char_id="-1" frame_id="-1" name=""
		   text="そんな私が、初対面の人と最初から「円満な共同生活」を送れるようになるとは思えなかった。" voices=""/>
		<char @l="1099" id="miho" pos="auto" src="miho010"/>
		<msg @l="1101" char_id="0" frame_id="-1" name="美帆" text="(ダメダメ‥‥前向きにならなくちゃ)"
		   voices=""/>
		<clear @l="1105" class="char"/>
		<msg @l="1107" char_id="-1" frame_id="-1" name=""
		   text="プレッシャーに耐えるように、私は３０７号室と書かれた扉の前で立ち止まる。" voices=""/>
		<msg @l="1108" char_id="-1" frame_id="-1" name=""
		   text="扉の脇に備え付けられた世帯人のプレートには私の名前である『仲根&#32;美帆』の表札と、同居人になる『白石&#32;玲』という表札がつけられていた。"
		   voices=""/>
		<msg @l="1110" char_id="0" frame_id="-1" name="美帆"
		   text="(どうか、優しい人でありますように‥‥)" voices=""/>
		<se @l="1114" buf="1" src="呼び鈴_壁越しでくぐもってる" volume="1."/>
		<msg @l="1116" char_id="-1" frame_id="-1" name=""
		   text="願いとも祈りともつかない「思い」を胸に、私は呼び鈴のスイッチを押した。" voices=""/>
		<msg @l="1117" char_id="-1" frame_id="-1" name=""
		   text="扉越しに聞こえるかすかな電子音が、奇妙な緊張感を誘う。" voices=""/>
		<msg @l="1118" char_id="-1" frame_id="-1" name="" text="‥‥‥‥‥‥‥‥‥‥‥‥。"
		   voices=""/>
		<stopbgm @l="1121" fadeout="1000"/>
		<msg @l="1123" char_id="0" frame_id="-1" name="美帆" text="『‥‥あれ？』" voices=""/>
		<msg @l="1125" char_id="-1" frame_id="-1" name=""
		   text="呼び鈴を鳴らしてからたっぷり３０秒は待っただろうか。" voices=""/>
		<msg @l="1126" char_id="-1" frame_id="-1" name=""
		   text="扉が開くような気配も、まして部屋の中で人が動くような音もない。" voices=""/>
		<se @l="1130" buf="1" src="呼び鈴_壁越しでくぐもってる" volume="1."/>
		<msg @l="1132" char_id="-1" frame_id="-1" name=""
		   text="もう一度、呼び鈴のスイッチを押してしばらく待ってみた。" voices=""/>
		<msg @l="1133" char_id="-1" frame_id="-1" name=""
		   text="‥‥が、やはり内側より扉が開けられる気配はまったくない。" voices=""/>
		<msg @l="1135" char_id="0" frame_id="-1" name="美帆" text="(‥‥留守、なのかなぁ？)"
		   voices=""/>
		<msg @l="1137" char_id="-1" frame_id="-1" name=""
		   text="今日、私が部屋に入居してくるという事は、同居人である彼女には大学を通して事前に伝わっているハズである。" voices=""/>
		<msg @l="1138" char_id="-1" frame_id="-1" name=""
		   text="とはいえ、わざわざ転入生の出迎えの為だけに残っていなければならないということはない。" voices=""/>
		<msg @l="1139" char_id="-1" frame_id="-1" name="" text="せっかくの春休みである。"
		   voices=""/>
		<msg @l="1140" char_id="-1" frame_id="-1" name=""
		   text="彼女（白石さん）もまた、実家に帰って家族団欒で過ごしているのかもしれない。" voices=""/>
		<msg @l="1142" char_id="0" frame_id="-1" name="美帆" text="(えっと‥‥)" voices=""/>
		<msg @l="1144" char_id="0" frame_id="-1" name="美帆"
		   text="(少し気は引けるけど仕方ない‥‥よね？)" voices=""/>
		<clear @l="1150" class="all"/>
		<msg @l="1152" char_id="-1" frame_id="-1" name=""
		   text="ハンドバッグの中から茶封筒に入ったままの合鍵を取り出した。" voices=""/>
		<msg @l="1153" char_id="-1" frame_id="-1" name=""
		   text="鍵には質素なラベルが貼られていて、そこには「３０７」と書かれていた。" voices=""/>
		<se @l="1156" buf="1" src="鍵を開ける音" volume="1."/>
		<msg @l="1158" char_id="-1" frame_id="-1" name=""
		   text="取り出した合鍵を慣れない手つきで鍵穴に差し込みながら、私は苦笑した。" voices=""/>
		<msg @l="1159" char_id="-1" frame_id="-1" name="" text="今の私を第三者が見たらどう思うだろう。"
		   voices=""/>
		<msg @l="1160" char_id="-1" frame_id="-1" name="" text="不審者に見えないだろうか‥‥。"
		   voices=""/>
		<msg @l="1162" char_id="0" frame_id="-1" name="美帆" text="『えっと‥‥お邪魔しまーす。』"
		   voices=""/>
		<msg @l="1164" char_id="-1" frame_id="-1" name=""
		   text="私はわざとらしく声をかけながら扉を開けた。" voices=""/>
		<msg @l="1165" char_id="-1" frame_id="-1" name=""
		   text="そのわざとらしさがよけいに不審さを出している事に気づいて、一層恥ずかしくなったのは言うまでも無い‥‥。" voices=""/>
		<clear @l="1171" class="all"/>
		<wait_chgmv/>
		<bg @l="1175" src="bg03"/>
		<bgm @l="1179" src="bgm02" volume="1."/>
		<msg @l="1181" char_id="0" frame_id="-1" name="美帆" text="(わぁ‥‥すごく広いんだぁ)"
		   voices=""/>
		<msg @l="1183" char_id="-1" frame_id="-1" name=""
		   text="部屋に上がって真っ直ぐ進むとリビングに出た。" voices=""/>
		<msg @l="1184" char_id="-1" frame_id="-1" name=""
		   text="廊下の途中に三つ扉があったけれど、何の部屋かもわからない扉をいきなり開けるのもためらわれたので、とりあえず真っ直ぐ歩いてみたのだ。"
		   voices=""/>
		<msg @l="1186" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="1188" char_id="0" frame_id="-1" name="美帆"
		   text="(ここで私‥‥二年間、暮らすんだよね？)" voices=""/>
		<msg @l="1190" char_id="0" frame_id="-1" name="美帆"
		   text="(なんかそう考えるとわくわくしちゃうなぁ)" voices=""/>
		<msg @l="1192" char_id="-1" frame_id="-1" name=""
		   text="私はそこでようやく思い出したように、駅前からここまでずっと肩に掛けっ放しになっていたカバンをソファの上へと置いた。"
		   voices=""/>
		<msg @l="1193" char_id="-1" frame_id="-1" name=""
		   text="そうして自分もその隣にそっと腰を下ろして、深いため息を吐いた。" voices=""/>
		<bgm @l="1196" src="bgm07" volume="1."/>
		<msg @l="1198" char_id="0" frame_id="-1" name="美帆" text="(今日は色々あったなぁ‥‥)"
		   voices=""/>
		<msg @l="1200" char_id="0" frame_id="-1" name="美帆"
		   text="(ずっと電車に揺られて、タバコの煙が充満した食堂で待たされて)" voices=""/>
		<msg @l="1202" char_id="0" frame_id="-1" name="美帆"
		   text="(綺麗な人とぶつかって‥‥少しだけ笑って)" voices=""/>
		<msg @l="1204" char_id="0" frame_id="-1" name="美帆" text="(それから‥‥)" voices=""/>
		<msg @l="1206" char_id="0" frame_id="-1" name="美帆"
		   text="(それから‥‥ナナコ‥‥というあの女の子‥‥あの子は‥‥？)" voices=""/>
		<msg @l="1208" char_id="-1" frame_id="-1" name=""
		   text="色々と考えていると、疲れからか、眠気が急に襲ってきた‥‥。" voices=""/>
		<msg @l="1210" char_id="0" frame_id="-1" name="美帆" text="(ふぁぁ‥‥)" voices=""/>
		<msg @l="1213" char_id="-1" frame_id="-1" name=""
		   text="体が少し暖かくなってきて‥‥なんだか気持ちがいい。" voices=""/>
		<msg @l="1214" char_id="-1" frame_id="-1" name=""
		   text="――――私は‥‥深い眠りへと落ちていった。" voices=""/>
		<stopbgm @l="1218" fadeout="1000"/>
		<clear @l="1224" class="all"/>
		<msgshow @l="1226" show="true"/>
		<msg @l="1228" char_id="-1" frame_id="-1" name="" text="‥‥‥‥‥‥‥‥。" voices=""/>
		<msg @l="1229" char_id="-1" frame_id="-1" name="" text="‥‥‥‥‥‥。" voices=""/>
		<msg @l="1230" char_id="-1" frame_id="-1" name="" text="‥‥‥‥。" voices=""/>
		<msg @l="1232" char_id="0" frame_id="-1" name="美帆" text="『ん‥‥。』" voices=""/>
		<se @l="1236" buf="1" src="扉を開ける音_金属" volume="1."/>
		<msg @l="1238" char_id="0" frame_id="-1" name="美帆" text="『え‥‥？』" voices=""/>
		<msg @l="1240" char_id="-1" frame_id="-1" name="" text="不意に、玄関の方で扉の開く音がする。"
		   voices=""/>
		<msg @l="1241" char_id="-1" frame_id="-1" name=""
		   text="その音で目が覚めた私は、いつのまにかソファーで寝てしまっていた事に気付いた。辺りはすっかり暗くなっている。" voices=""/>
		<msg @l="1243" char_id="-1" frame_id="-1" name=""
		   text="当然ながら合鍵は同居者以外の者に渡される事は無いし、大学に無断で複製する事は規則で禁止されている筈だ。" voices=""/>
		<msg @l="1244" char_id="-1" frame_id="-1" name="" text="と、いうことは――――。"
		   voices=""/>
		<wait_chgmv/>
		<bg @l="1248" src="bg03c"/>
		<msg @l="1250" char_id="1" frame_id="-1" name="声" text="『あら‥‥誰かいるの？』"
		   voices=""/>
		<msg @l="1252" char_id="1" frame_id="-1" name="声"
		   text="『そういえば、同居の子が来るのって今日だったかしら‥‥？』" voices=""/>
		<msg @l="1254" char_id="-1" frame_id="-1" name="" text="玄関から聞き覚えのある声が届いていた。"
		   voices=""/>
		<msg @l="1256" char_id="0" frame_id="-1" name="美帆" text="(あれ‥‥この声、どこかで‥‥‥？)"
		   voices=""/>
		<msg @l="1258" char_id="-1" frame_id="-1" name=""
		   text="私は慌てて体を起こすと、部屋の電気をつけた。" voices=""/>
		<msg @l="1260" char_id="-1" frame_id="0" name="" text="「パチッ」" voices=""/>
		<wait_chgmv/>
		<bg @l="1264" src="bg03b"/>
		<msg @l="1266" char_id="-1" frame_id="-1" name=""
		   text="廊下からリビングへと続く扉を開けて現れたのは、私が昼間ぶつかってしまったスーツの女性だった。" voices=""/>
		<char @l="1270" id="rei" pos="auto" src="rei010"/>
		<bgm @l="1274" src="bgm05" volume="1."/>
		<msg @l="1276" char_id="1" frame_id="-1" name="スーツの女性"
		   text="『ごめんなさいね、留守にしてしまって。』" voices=""/>
		<msg @l="1278" char_id="1" frame_id="-1" name="スーツの女性"
		   text="『サークルのミーティングがどうしても外せなくて‥‥。』" voices=""/>
		<char @l="1282" id="rei" pos="auto" src="rei014"/>
		<msg @l="1284" char_id="1" frame_id="-1" name="玲" text="『あら‥‥貴女は‥‥‥。』"
		   voices=""/>
		<clear @l="1287" class="char"/>
		<char @l="1290" id="rei" pos="left" src="rei014"/>
		<char @l="1293" id="miho" pos="right" src="miho014"/>
		<msg @l="1295" char_id="0" frame_id="-1" name="美帆" text="『え‥‥‥アナタが白石玲‥‥先輩？』"
		   voices=""/>
		<char @l="1299" id="rei" pos="left" src="rei010"/>
		<msg @l="1301" char_id="1" frame_id="-1" name="玲"
		   text="『そうなの‥‥。この部屋に来る同居の子って貴女だったの。』" voices=""/>
		<char @l="1305" id="rei" pos="left" src="rei011"/>
		<msg @l="1307" char_id="1" frame_id="-1" name="玲" text="『これも何かの縁、かしらね？』"
		   voices=""/>
		<msg @l="1309" char_id="-1" frame_id="-1" name="" text="彼女はそうして嬉しそうに微笑んだ。"
		   voices=""/>
		<msg @l="1310" char_id="-1" frame_id="-1" name=""
		   text="まさか昼間の素敵な女性が同居人なんて思いもよらなくて、私は戸惑いと驚きで言葉が続かなかった。" voices=""/>
		<char @l="1314" id="rei" pos="left" src="rei110"/>
		<msg @l="1316" char_id="1" frame_id="-1" name="玲" text="『仲根美帆さん‥‥でいいのよね？』"
		   voices=""/>
		<char @l="1320" id="miho" pos="right" src="miho110"/>
		<msg @l="1322" char_id="0" frame_id="-1" name="美帆"
		   text="『あ、‥‥‥はい‥‥仲根です‥その節は色々と‥‥』" voices=""/>
		<msg @l="1324" char_id="1" frame_id="-1" name="玲"
		   text="『もう自己紹介は要らないと思うけど一応しておくわ。礼儀だものね。』" voices=""/>
		<char @l="1328" id="rei" pos="left" src="rei011"/>
		<msg @l="1330" char_id="1" frame_id="-1" name="玲"
		   text="『私は白石玲、この部屋での同居人よ‥‥これから一年間よろしく。』" voices=""/>
		<msg @l="1332" char_id="-1" frame_id="-1" name=""
		   text="彼女はそう言って、優しそうににっこりと笑いながら右手を差し出した。" voices=""/>
		<msg @l="1333" char_id="-1" frame_id="-1" name=""
		   text="私は嬉しさと戸惑いが入り混じった顔をしながら、彼女と握手をした。" voices=""/>
		<msg @l="1335" char_id="-1" frame_id="-1" name="" text="‥‥‥‥‥‥‥‥。" voices=""/>
		<msg @l="1336" char_id="-1" frame_id="-1" name="" text="‥‥‥‥‥‥。" voices=""/>
		<msg @l="1337" char_id="-1" frame_id="-1" name="" text="‥‥‥‥。" voices=""/>
		<stopbgm @l="1342" fadeout="1000"/>
		<eval @l="1346" expr="s.opening_flag=1&#13;&#10;"/>
		<clear @l="1352" class="all"/>
		<call @l="1356" target="EventLabel_19@common_root01"/>
		<return @l="1357" value="0&#13;&#10;"/>
	</code>
</xscript>
