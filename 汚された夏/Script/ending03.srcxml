<?xml version="1.0" encoding="utf-8"?>
<xscript>
	<debug editor="&quot;C:\Program&#32;Files&#32;(x86)\sakura\sakura.exe&quot;&#32;&quot;%src%&quot;&#32;-Y=%line%"
	   src="D:\シロップ\町ぐるみの罠＋汚された夏セット版\汚された夏\完成データ\汚された夏\script\text\ending03.txt"/>
	<code>
		<label @l="12" id="EventLabel_41"/>
		<description @l="16" text="姉妹プール奴隷"/>
		<eval @l="18" expr="f.numDay=0&#13;&#10;"/>
		<label @l="21" id="event_scene20"/>
		<wait_chgmv/>
		<bg @l="25" src="bg10b"/>
		<bgm @l="29" src="bgm03" volume="1."/>
		<msg @l="31" char_id="-1" frame_id="-1" name="" text="あれから‥‥何日が過ぎただろう。"
		   voices=""/>
		<msg @l="32" char_id="-1" frame_id="-1" name="" text="三日？" voices=""/>
		<msg @l="33" char_id="-1" frame_id="-1" name="" text="一週間？" voices=""/>
		<msg @l="34" char_id="-1" frame_id="-1" name="" text="それとも一ヶ月？" voices=""/>
		<msg @l="35" char_id="-1" frame_id="-1" name="" text="どの位経ったのすら分からない。"
		   voices=""/>
		<msg @l="36" char_id="-1" frame_id="-1" name=""
		   text="時間の感覚が曖昧で、現実味の無い日々が続いていた。" voices=""/>
		<msg @l="37" char_id="-1" frame_id="-1" name=""
		   text="あの日、亜季奈が渡部たちに陵辱された後‥‥私も彼らの慰みモノとして身体中を汚されてしまった‥‥。" voices=""/>
		<msg @l="38" char_id="-1" frame_id="-1" name=""
		   text="口も、アソコも、お尻も‥‥あらゆる場所を犯され、汚され、凌辱され尽くした。" voices=""/>
		<msg @l="39" char_id="-1" frame_id="-1" name=""
		   text="それでも警察に言うことも出来ず、私はただ耐え続けるしかなかった。" voices=""/>
		<msg @l="40" char_id="-1" frame_id="-1" name="" text="あの子の‥‥亜季奈の為に。"
		   voices=""/>
		<stopbgm @l="43" fadeout="1000"/>
		<bgm @l="46" src="bgm14" volume="1."/>
		<msg @l="48" char_id="0" frame_id="-1" name="美帆" text="『んっ‥‥ああっ‥‥‥‥。』"
		   voices="miho11330"/>
		<msg @l="50" char_id="-1" frame_id="-1" name=""
		   text="秘肉を押し割って挿入される感覚に、私は思わず声をあげた。" voices=""/>
		<msg @l="51" char_id="-1" frame_id="-1" name="" text="声が震えていて‥‥どこか物欲しげだ。"
		   voices=""/>
		<msg @l="53" char_id="-1" frame_id="-1" name="渡部"
		   text="『いいぜぇ‥‥相変わらずねーちゃんの方は良いマ○コしてるぜ。』" voices=""/>
		<msg @l="55" char_id="-1" frame_id="-1" name=""
		   text="渡部先生が私の膣肉の感触を味わうように、ゆっくりと抽送を開始する。" voices=""/>
		<msg @l="56" char_id="-1" frame_id="-1" name=""
		   text="勝手に秘孔が柔らかくそっと握るように肉棒を受け入れた。" voices=""/>
		<msg @l="58" char_id="-1" frame_id="-1" name="熊野"
		   text="『妹の方もマ○コがキュッキュッと締めつけてきてよいのですが、私は断然こちらですな。』" voices=""/>
		<msg @l="60" char_id="-1" frame_id="-1" name=""
		   text="そう言って、熊野が亜季奈の口に肉棒の先端を押し込む。" voices=""/>
		<msg @l="61" char_id="-1" frame_id="-1" name=""
		   text="腔内に熊野の味が広がると亜季奈は自ずと頭をグラインドさせ始めた。" voices=""/>
		<msg @l="62" char_id="-1" frame_id="-1" name=""
		   text="頬が窪むたびに淫猥な音が響き、唾液が肉傘に絡んでゆく。" voices=""/>
		<label @l="66" id="chart_line17"/>
		<wait_chgmv/>
		<ev @l="70" src="ev-020"/>
		<msg @l="72" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んぐっ‥‥んっ、ちゅぷ、ちゅぷ、ちゅぷっ‥‥‥‥。』" voices="akina03770"/>
		<msg @l="74" char_id="-1" frame_id="-1" name="熊野"
		   text="『うおっ‥‥いいですよ、教えたことをきちんと守ってますねぇ。』" voices=""/>
		<msg @l="76" char_id="-1" frame_id="-1" name=""
		   text="亜季奈はそれに答えることも表情を変えることもなく、無心で熊野に奉仕する。" voices=""/>
		<msg @l="78" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』"
		   voices="miho11340"/>
		<msg @l="80" char_id="-1" frame_id="-1" name="" text="私たちは水泳部の排泄係として飼われている。"
		   voices=""/>
		<msg @l="81" char_id="-1" frame_id="-1" name=""
		   text="亜季奈は‥‥あの日からそれまでのような明るい無邪気な笑みを浮かべることはなくなり、無心で男のモノに奉仕する人形になってしまった。"
		   voices=""/>
		<msg @l="82" char_id="-1" frame_id="-1" name=""
		   text="薬のせいではないかと渡部たちに掛け合ったが、取り合ってもくれなかった。" voices=""/>
		<msg @l="83" char_id="-1" frame_id="-1" name=""
		   text="‥‥‥私には何も‥‥何もすることが出来なかった‥‥‥‥‥‥‥‥。" voices=""/>
		<msg @l="85" char_id="-1" frame_id="-1" name="留学生" text="『オアォオッ、オ、オンナ、オンナ』"
		   voices=""/>
		<msg @l="87" char_id="-1" frame_id="-1" name="渡部"
		   text="『あれだけ出しまくったのに、まだ収まらねぇのかテメエは。そこで俺達のナニでも見ながら大人しくズリセンこいてやがれ！』"
		   voices=""/>
		<msg @l="89" char_id="-1" frame_id="-1" name="留学生" text="『ウウッ、オオォッ‥‥』"
		   voices=""/>
		<msg @l="91" char_id="-1" frame_id="-1" name=""
		   text="留学生は仕方ないといった風に、真っ黒な剛直をシゴキ始める。" voices=""/>
		<msg @l="92" char_id="-1" frame_id="-1" name=""
		   text="乱暴な摩擦により、更に硬度を増していく黒い凶器の姿は、私の視線を捕らえ、離さなかった。" voices=""/>
		<msg @l="93" char_id="-1" frame_id="-1" name="" text="あれがさっきまで子宮を突き上げていた。"
		   voices=""/>
		<msg @l="94" char_id="-1" frame_id="-1" name=""
		   text="彼のモノが全部を入れられた時は、口から内臓が出るかと思った。" voices=""/>
		<msg @l="95" char_id="-1" frame_id="-1" name=""
		   text="亀頭が子宮口に密着して、何度も子種を吐き出していた‥‥‥。" voices=""/>
		<msg @l="96" char_id="-1" frame_id="-1" name=""
		   text="出された瞬間の、激しく子宮を痺れさせる感覚が思い出される。" voices=""/>
		<msg @l="97" char_id="-1" frame_id="-1" name=""
		   text="そういえば、あれだけ出したのに、よっぽど濃かったのか？" voices=""/>
		<msg @l="98" char_id="-1" frame_id="-1" name="" text="それとももっと奥まで流れていったのか？"
		   voices=""/>
		<msg @l="99" char_id="-1" frame_id="-1" name=""
		   text="良くは判らないが、秘裂からは殆ど逆流してこなかった‥。" voices=""/>
		<msg @l="100" char_id="-1" frame_id="-1" name="" text="私、妊娠しちゃうのかな？"
		   voices=""/>
		<msg @l="101" char_id="-1" frame_id="-1" name=""
		   text="だが、今までも、タップリ出されていたし、避妊などされたことも無い。" voices=""/>
		<msg @l="102" char_id="-1" frame_id="-1" name=""
		   text="好きなだけ犯され、好きなだけ出された‥‥。" voices=""/>
		<msg @l="103" char_id="-1" frame_id="-1" name=""
		   text="妊娠のことを考えるなんて‥‥今更だと思う‥。" voices=""/>
		<msg @l="104" char_id="-1" frame_id="-1" name=""
		   text="そう考えると、急に留学生の、美帆の細腕ぐらいある凶器が愛おしく見えた。" voices=""/>
		<msg @l="105" char_id="-1" frame_id="-1" name=""
		   text="苦しかったけど‥‥また突いて欲しい‥‥またナカに注いで欲しい‥‥。" voices=""/>
		<msg @l="107" char_id="-1" frame_id="-1" name="" text="‥‥‥‥‥‥‥‥" voices=""/>
		<msg @l="108" char_id="-1" frame_id="-1" name="" text="‥‥‥‥‥‥" voices=""/>
		<msg @l="109" char_id="-1" frame_id="-1" name="" text="‥‥‥‥" voices=""/>
		<msg @l="111" char_id="-1" frame_id="-1" name=""
		   text="‥‥そして今は、留学生が出した精子を膣襞に刷り込むように、渡部先生が腰を回している。" voices=""/>
		<msg @l="113" char_id="-1" frame_id="-1" name="渡部"
		   text="『そらっ！&#32;‥‥ねーちゃんの方も呆けてないで、イイ声あげて鳴いてくれよな！』" voices=""/>
		<msg @l="115" char_id="0" frame_id="-1" name="美帆" text="『ん、ああっ‥‥。』"
		   voices="miho11350"/>
		<msg @l="117" char_id="-1" frame_id="-1" name=""
		   text="‥‥私の身体は熱い淫汁を溢れさせ、肉茎を求めてしまう。" voices=""/>
		<msg @l="118" char_id="-1" frame_id="-1" name="" text="‥‥ただ、男の肉茎を求めてしまう身体。"
		   voices=""/>
		<msg @l="119" char_id="-1" frame_id="-1" name=""
		   text="こんな事になるなんて、数ヶ月前の自分では、とても考え付かなかっただろう。" voices=""/>
		<msg @l="121" char_id="0" frame_id="-1" name="美帆"
		   text="『んんっ‥‥あふっ‥‥‥‥んっ、んっ、んっ、あああっ。』" voices="miho11360"/>
		<msg @l="123" char_id="0" frame_id="-1" name="美帆"
		   text="『あっ、ンふっ‥‥‥んっ‥‥‥あっ‥‥あっ‥‥‥‥んはぁっ。』" voices="miho11370"/>
		<msg @l="125" char_id="-1" frame_id="-1" name=""
		   text="淫茎が往復する度、襞がわななき震え、愛液は白く濁ってくる。" voices=""/>
		<msg @l="126" char_id="-1" frame_id="-1" name=""
		   text="グチュグチュと音を立てて膣肉が柔らかくほぐされてゆく。" voices=""/>
		<msg @l="128" char_id="-1" frame_id="-1" name="渡部"
		   text="『いいぜぇ‥‥中のヒダヒダが絡んできて、搾り取られそうだ。』" voices=""/>
		<msg @l="130" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んぷっ‥‥んっ、ちゅぷ‥‥‥ンンっ‥‥‥れろ‥‥れろ‥‥‥。』" voices="akina03780"/>
		<msg @l="132" char_id="-1" frame_id="-1" name="熊野"
		   text="『もっと、エラに唾液をまぶして‥‥そう、後、もう少し強く啜って。』" voices=""/>
		<msg @l="134" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んん～っ‥‥ちゅぱっ‥‥‥んふっ‥‥‥じゅぷっ、ちゅろろっ！』" voices="akina03790"/>
		<msg @l="136" char_id="-1" frame_id="-1" name="熊野"
		   text="『そうです、そうです‥‥フェラチオだけなら妹の方は姉を超えましたな。』" voices=""/>
		<msg @l="138" char_id="-1" frame_id="-1" name=""
		   text="熊野は亜季奈のフェラに感心したように、優しく頭を撫でる。" voices=""/>
		<msg @l="140" char_id="-1" frame_id="-1" name="渡部"
		   text="『そうか‥‥じゃあ、明日はそいつの口を使ってみるとするか。』" voices=""/>
		<msg @l="142" char_id="-1" frame_id="-1" name=""
		   text="私を突き上げながら、亜季奈のお尻を揉みしだく。" voices=""/>
		<msg @l="143" char_id="-1" frame_id="-1" name=""
		   text="熊野も上気する私の顔を覗き込み、イヤらしい笑みを浮かべる。" voices=""/>
		<msg @l="145" char_id="-1" frame_id="-1" name="熊野"
		   text="『私も久々に彼女の肉壷を味わってみたくなりましたよ。ですが今日はこちらを使いますよ。楽しみは明日に取っておく言うことで。』"
		   voices=""/>
		<msg @l="147" char_id="-1" frame_id="-1" name=""
		   text="他愛もない世間話かのように、私達を犯す話をする。" voices=""/>
		<msg @l="148" char_id="-1" frame_id="-1" name=""
		   text="突き入れられた肉棒がグチュグチュと激しく内側のヒダを擦り上げ、奥の子宮口をコツコツとノックする。" voices=""/>
		<msg @l="151" char_id="0" frame_id="-1" name="美帆"
		   text="『んっ、んっ、んっ、んっ‥‥‥あっ‥‥んくっ‥‥‥。』" voices="miho11380"/>
		<msg @l="153" char_id="0" frame_id="-1" name="美帆"
		   text="『ふかっ‥‥い、ああっ‥‥‥そこっ‥‥‥ダメですっ‥‥‥‥。』" voices="miho11390"/>
		<msg @l="155" char_id="-1" frame_id="-1" name=""
		   text="不意に暴れていた男根が、美帆のＧスポットを強く擦り上げる。" voices=""/>
		<msg @l="156" char_id="-1" frame_id="-1" name=""
		   text="我慢できずに私は身体中に走る官能のうねりに腰を震わせながら、甘い喘ぎを漏らす。" voices=""/>
		<msg @l="158" char_id="-1" frame_id="-1" name="渡部"
		   text="『ねーちゃんは相変わらずここが弱いんだよな？』" voices=""/>
		<msg @l="160" char_id="-1" frame_id="-1" name=""
		   text="Ｇスポットを的確に探り当て、狙い済ましたかのように同じ場所をカリでこすり、エラで引っ掻く。" voices=""/>
		<msg @l="161" char_id="-1" frame_id="-1" name="" text="一気に絶頂への波が私を揺さぶる。"
		   voices=""/>
		<msg @l="162" char_id="-1" frame_id="-1" name="" text="執拗な責めに、声を抑えることが出来ない。"
		   voices=""/>
		<msg @l="164" char_id="0" frame_id="-1" name="美帆"
		   text="『んぁぁっっ‥‥‥ダメっ、んっ‥‥‥あくっ！！』" voices="miho11400"/>
		<msg @l="166" char_id="0" frame_id="-1" name="美帆"
		   text="『ソコばっかりしたらっ‥‥すぐ、んんっ‥‥‥イっちゃいますっ。』" voices="miho11410"/>
		<msg @l="168" char_id="-1" frame_id="-1" name="熊野" text="『ダメだ、我慢しろ！』"
		   voices=""/>
		<msg @l="170" char_id="-1" frame_id="-1" name="渡部"
		   text="『俺はまだ出す気はねぇんだ。勝手にイキやがったら裸のまま外に放り出すぞ！』" voices=""/>
		<msg @l="172" char_id="0" frame_id="-1" name="美帆" text="『んんっ‥‥‥わ、わかりましたっ。』"
		   voices="miho11420"/>
		<msg @l="174" char_id="-1" frame_id="-1" name="" text="理不尽な命令だが、承諾する。"
		   voices=""/>
		<msg @l="175" char_id="-1" frame_id="-1" name="" text="そう答えるように教え込まれているからだ。"
		   voices=""/>
		<msg @l="177" char_id="2" frame_id="-1" name="亜季奈"
		   text="『あふっ‥‥‥んんっ、んっ‥‥‥じゅぷ、ちゅぷっ‥‥‥れろっ。』" voices="akina03800"/>
		<msg @l="179" char_id="2" frame_id="-1" name="亜季奈"
		   text="『ちゅぷ、ちゅぷ、ちゅぷ‥‥‥ンっ、んぷ、ちゅるるっ‥‥‥。』" voices="akina03810"/>
		<msg @l="181" char_id="-1" frame_id="-1" name="熊野"
		   text="『おお‥‥名残惜しいですが、そろそろ出してしまいますよ。』" voices=""/>
		<msg @l="184" char_id="-1" frame_id="-1" name="" text="亜季奈の動きが早くなっていた。"
		   voices=""/>
		<msg @l="185" char_id="-1" frame_id="-1" name=""
		   text="が、亜季奈の瞳は相変わらず焦点を捕らえていない。" voices=""/>
		<msg @l="186" char_id="-1" frame_id="-1" name=""
		   text="熊野の肉棒の微妙な変化に、躰が覚えている事を行っているだけのようだ。" voices=""/>
		<msg @l="188" char_id="-1" frame_id="-1" name="渡部" text="『他の連中ももう限界って感じだな。』"
		   voices=""/>
		<msg @l="190" char_id="-1" frame_id="-1" name="留学生" text="『オオッ、オォーッ！』"
		   voices=""/>
		<msg @l="192" char_id="-1" frame_id="-1" name=""
		   text="気が付けば、留学生以外にも、おあずけを食らっている水泳部員たちがまわりを取り囲み、私と亜季奈の痴態を見ながら激しくオナニーをしている。"
		   voices=""/>
		<msg @l="193" char_id="-1" frame_id="-1" name=""
		   text="いくつもの視線が体中のイヤラシイ部分に絡みつき、私達を視姦する。" voices=""/>
		<msg @l="194" char_id="-1" frame_id="-1" name=""
		   text="形の無い肉棒が私の口に、乳首に、臍に押し付けられ、入り込む。" voices=""/>
		<msg @l="195" char_id="-1" frame_id="-1" name=""
		   text="同様に亜季奈の脇の下、秘裂、菊口にも、視線が注がれる。" voices=""/>
		<msg @l="197" char_id="0" frame_id="-1" name="美帆"
		   text="『ふあっ‥‥んっ、んっ、んっ、んんっ‥‥‥‥‥ああっ！！』" voices="miho11430"/>
		<msg @l="199" char_id="2" frame_id="-1" name="亜季奈"
		   text="『ちゅろっ、ちゅぷ‥‥‥んぷ、んぷ、んぷっ‥‥‥‥じゅぷぷっ。』" voices="akina03820"/>
		<msg @l="201" char_id="-1" frame_id="-1" name=""
		   text="渡部先生は周囲のギャラリーに見せ付けるように執拗に私の弱い場所を責め立てる。" voices=""/>
		<msg @l="202" char_id="-1" frame_id="-1" name=""
		   text="連続した悦美に絶えられず、体が弓なりに反り返り、腰が宙に浮く。" voices=""/>
		<msg @l="204" char_id="0" frame_id="-1" name="美帆"
		   text="『んっ、んっ、んんっ‥‥‥ああっ‥‥んふっ‥‥あぁっ‥‥。』" voices="miho11440"/>
		<msg @l="206" char_id="-1" frame_id="-1" name="水泳部の子Ａ"
		   text="『お、なるほど‥‥あそこがＧスポットか‥‥。後でオレもやってみよっと。』" voices=""/>
		<msg @l="208" char_id="0" frame_id="-1" name="美帆"
		   text="『んくっ‥‥んっ、んあっ‥‥‥‥あふ‥‥んっ、んっ、ああっ！！』" voices="miho11450"/>
		<msg @l="210" char_id="-1" frame_id="-1" name="" text="我慢できず、軽くイッてしまう。"
		   voices=""/>
		<msg @l="211" char_id="-1" frame_id="-1" name=""
		   text="が、渡部先生は構わずＧスポットをエラで掻き続ける。" voices=""/>
		<msg @l="213" char_id="2" frame_id="-1" name="亜季奈"
		   text="『あむ‥‥ん、んぷっ‥‥ちゅぷ‥‥‥ちゅる、ちゅぷ、ちゅぷっ。』" voices="akina03830"/>
		<msg @l="215" char_id="-1" frame_id="-1" name="水泳部の子Ｂ"
		   text="『仲根のエロいフェラ顔‥‥。我慢できねぇ。』" voices=""/>
		<msg @l="217" char_id="-1" frame_id="-1" name=""
		   text="それが聞こえたのかどうかは分からないが、淫茎を啜る音がより大きくなる。" voices=""/>
		<msg @l="219" char_id="2" frame_id="-1" name="亜季奈"
		   text="『あふっ、んっ‥‥んく‥‥‥れろ‥‥ちゅ、ちゅるるるるっ！！』" voices="akina03840"/>
		<msg @l="221" char_id="-1" frame_id="-1" name=""
		   text="精液に咽喉を叩かれるのを期待してか、亜季奈の秘裂から淫蜜がゴプリと滴り、太腿を伝って小さな蜜溜りを形成した。" voices=""/>
		<msg @l="222" char_id="-1" frame_id="-1" name=""
		   text="淫猥な匂いを振りまく蜜溜が、亜季奈自身を痺れさせる。" voices=""/>
		<msg @l="223" char_id="-1" frame_id="-1" name=""
		   text="瞳が潤み始め、口腔は熊野の肉棒を熔かすかと思わせる位、熱くなっていた。" voices=""/>
		<msg @l="225" char_id="-1" frame_id="-1" name=""
		   text="どんどん熱くなる私達の周囲は淫臭で満ち、見ているだけの部員の子達までも狂わせていった。" voices=""/>
		<msg @l="227" char_id="-1" frame_id="-1" name="水泳部の子Ｃ"
		   text="『ダメだ、もう出そうだっ‥‥。』" voices=""/>
		<msg @l="229" char_id="-1" frame_id="-1" name="水泳部の子Ｄ"
		   text="『お、おうっ‥‥俺もかなりキてるぜぇ。』" voices=""/>
		<msg @l="231" char_id="-1" frame_id="-1" name="留学生" text="『ウォッ、オ、オオォーッ！』"
		   voices=""/>
		<msg @l="233" char_id="-1" frame_id="-1" name="熊野"
		   text="『そろそろですな。‥‥では、私の掛け声で、一斉に参りましょうか。』" voices=""/>
		<msg @l="235" char_id="-1" frame_id="-1" name="渡部"
		   text="『よぉし、二人とも聞いたな‥‥今からたっぷりとかけてやるっ！』" voices=""/>
		<msg @l="237" char_id="-1" frame_id="-1" name="渡部" text="『ぶっかけられてイッちまいな！！』"
		   voices=""/>
		<msg @l="239" char_id="-1" frame_id="-1" name="熊野" text="『では‥‥‥。』" voices=""/>
		<msg @l="241" char_id="-1" frame_id="-1" name=""
		   text="熊野の合図で、全員がラストスパートをかけ始める。" voices=""/>
		<msg @l="243" char_id="-1" frame_id="-1" name="熊野"
		   text="『‥‥‥‥‥‥‥‥‥せーの！&#32;それっ！！』" voices=""/>
		<flash @l="247" count="4" fade="100" image="white"/>
		<msg @l="249" char_id="-1" frame_id="-1" name=""
		   text="熊野の放出を皮切りに、私達に向けて腰が突き出される。" voices=""/>
		<msg @l="251" char_id="-1" frame_id="-1" name=""
		   text="どぷっ！&#32;ビュクッ！&#32;びゅくっ！&#32;ドクッ！&#32;どくっ！&#32;ドプッ！&#32;びゅくっ！"
		   voices=""/>
		<msg @l="253" char_id="-1" frame_id="-1" name=""
		   text="音が聞こえるぐらいの濃い塊のような白濁液が宙を飛ぶ。" voices=""/>
		<msg @l="255" char_id="0" frame_id="-1" name="美帆" text="『んんっ‥‥！！』"
		   voices="miho11460"/>
		<flash @l="259" count="4" fade="100" image="white"/>
		<msg @l="261" char_id="2" frame_id="-1" name="亜季奈" text="『ん、ぷあっ‥‥。』"
		   voices="akina03850"/>
		<wait_chgmv/>
		<ev @l="265" src="ev-020z1"/>
		<msg @l="267" char_id="0" frame_id="-1" name="美帆" text="『あっ‥‥ああっ‥‥‥‥‥。』"
		   voices="miho11470"/>
		<msg @l="269" char_id="-1" frame_id="-1" name=""
		   text="熱い液体が、亜季奈と私に降り掛かり、雪が積もったように私達の肌を覆い隠す。" voices=""/>
		<msg @l="270" char_id="-1" frame_id="-1" name=""
		   text="白濁液をかけられる度に、私の子宮は反応しキュンと収縮する。" voices=""/>
		<msg @l="272" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んっ‥‥‥んくっ‥‥‥‥‥はぁ、はぁ、はぁ‥‥‥‥。』" voices="akina03860"/>
		<msg @l="274" char_id="-1" frame_id="-1" name=""
		   text="亜季奈は、顔に注がれた匂い立つ子種を、目を閉じ舌を突き出して受け止める。" voices=""/>
		<msg @l="275" char_id="-1" frame_id="-1" name=""
		   text="瞼や頬に付いた精液は、指で掬われ、口に運ばれる。" voices=""/>
		<msg @l="276" char_id="-1" frame_id="-1" name=""
		   text="精液がこびりついた指が口に含まれ、ちゅぽん、と抜かれる。" voices=""/>
		<msg @l="277" char_id="-1" frame_id="-1" name=""
		   text="そして口一杯に溜まると、喉が動き胃に流し込まれた。" voices=""/>
		<msg @l="278" char_id="-1" frame_id="-1" name=""
		   text="ハァハァと小さな胸を上下させて呼吸を整え、また精液を集め始める。" voices=""/>
		<msg @l="279" char_id="-1" frame_id="-1" name=""
		   text="亜季奈は、喉に絡みつく精液の感触にウットリしていた‥‥‥。" voices=""/>
		<msg @l="281" char_id="-1" frame_id="-1" name=""
		   text="そんな亜季奈を横目で見、私も胸やお腹の上に溜まった精液を両手で掬い、唇を付けて精飲する‥‥‥‥‥‥。" voices=""/>
		<stopbgm @l="285" fadeout="1000"/>
		<clear @l="291" class="all"/>
		<msg @l="293" char_id="-1" frame_id="-1" name=""
		   text="少しでも亜季奈に、妹のいる場所へ近づく為に‥私も精液を嚥下し続けた‥‥。" voices=""/>
		<msg @l="294" char_id="-1" frame_id="-1" name=""
		   text="自分にかかったのを飲み切ったから、亜季奈の背中を白く染めている精液を飲んであげよう‥。" voices=""/>
		<msg @l="296" char_id="-1" frame_id="-1" name=""
		   text="お腹がもういっぱいだけど、飲んであげなきゃ‥‥。" voices=""/>
		<msg @l="298" char_id="-1" frame_id="-1" name="" text="亜季奈は小麦色の肌が似合うから‥‥‥‥。"
		   voices=""/>
		<msg @l="300" char_id="0" frame_id="-1" name="美帆"
		   text="『いつか‥‥私もそっちにいけるかな、亜季奈‥。』" voices="miho11480"/>
		<msg @l="302" char_id="-1" frame_id="-1" name=""
		   text="私は小さくつぶやいて‥‥亜季奈の背中に口を付けた‥‥‥‥‥‥‥‥‥‥。" voices=""/>
		<clear @l="308" class="all"/>
		<end_scene @l="311"/>
		<eval @l="315" expr="s.flagGallery=1&#13;&#10;"/>
		<eval @l="317" expr="s.event20flag=1&#13;&#10;"/>
		<eval @l="321"
		   expr="f.bEx&#32;=&#32;s.event20flag&#32;&amp;&amp;&#32;s.event23flag&#32;&amp;&amp;&#32;s.event25flag&#32;&amp;&amp;&#32;s.event30flag&#32;&amp;&amp;&#32;s.event31flag&#32;&amp;&amp;&#32;s.event32flag&#32;&amp;&amp;&#32;s.event33flag&#32;&amp;&amp;&#32;s.event35flag&#32;&amp;&amp;&#32;s.event37flag&#32;&amp;&amp;&#32;s.event38flag&#32;&amp;&amp;&#32;s.event60flag&#13;&#10;"/>
		<goto @l="323" cond="!(f.bEx)&#13;&#10;" label="TempLabel_230"/>
		<eval @l="325" expr="s.exRootFlag=1&#13;&#10;"/>
		<label @l="326" id="TempLabel_230"/>
		<ending @l="328"/>
		<goto @l="330" cond="!(f.bEx)&#13;&#10;" label="TempLabel_231"/>
		<wait_chgmv/>
		<bg @l="334" src="newroot"/>
		<wait @l="336" time="5000"/>
		<wait_chgmv/>
		<bg @l="338" src="black"/>
		<label @l="341" id="TempLabel_231"/>
		<return @l="345" value=""/>
	</code>
</xscript>
