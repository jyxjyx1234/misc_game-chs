<?xml version="1.0" encoding="utf-8"?>
<xscript>
	<debug editor="&quot;C:\Program&#32;Files&#32;(x86)\sakura\sakura.exe&quot;&#32;&quot;%src%&quot;&#32;-Y=%line%"
	   src="D:\シロップ\町ぐるみの罠＋汚された夏セット版\汚された夏\完成データ\汚された夏\script\text\ending05.txt"/>
	<code>
		<label @l="12" id="EventLabel_43"/>
		<description @l="16" text="作業現場の肉人形"/>
		<eval @l="18" expr="f.numDay=0&#13;&#10;"/>
		<label @l="21" id="event_scene31"/>
		<msg @l="25" char_id="-1" frame_id="-1" name=""
		   text="労働者達に輪姦された美帆と玲は、そのまま監禁され男を喜ばせる為のありとあらゆるテクニックを仕込まれ、今や雌奴隷へと調教される。"
		   voices=""/>
		<msg @l="26" char_id="-1" frame_id="-1" name=""
		   text="そして二人はそのままこの南総町で進められている計画‥‥町全体を巨大な性欲処理場に変えるという非道なものに無理やり参加させられていたのだった。"
		   voices=""/>
		<msg @l="27" char_id="-1" frame_id="-1" name=""
		   text="その計画とは、誘致されてきた企業は社員証さえ見せるだけで、性的サービスがタダで受けられるようになっており、その見返りに企業は地元に多大な利益を落とす契約だったが、二人の担当させられた仕事とは只の性的サービスというものではなかった････。"
		   voices=""/>
		<msg @l="29" char_id="-1" frame_id="-1" name="" text="その仕事に従事してから八ヵ月後―――。"
		   voices=""/>
		<bgm @l="33" src="bgm03" volume="1."/>
		<msg @l="35" char_id="-1" frame_id="-1" name="" text="―――大黒建設・建築現場"
		   voices=""/>
		<msg @l="36" char_id="-1" frame_id="-1" name=""
		   text="労働者たちにとって、安息とも言える昼食の時間が訪れていた。" voices=""/>
		<msg @l="37" char_id="-1" frame_id="-1" name=""
		   text="皆が埃だらけの作業から解放され、身体を休めながら飯を食らう。" voices=""/>
		<msg @l="38" char_id="-1" frame_id="-1" name="" text="何でもない日常。" voices=""/>
		<msg @l="39" char_id="-1" frame_id="-1" name="" text="いつも通りの毎日。" voices=""/>
		<msg @l="40" char_id="-1" frame_id="-1" name="" text="そんな時間が‥‥今日もまた刻まれている。"
		   voices=""/>
		<msg @l="42" char_id="-1" frame_id="-1" name="作業員Ａ"
		   text="『なんか催してきたな‥‥俺、便所行って来るわ。』" voices=""/>
		<msg @l="44" char_id="-1" frame_id="-1" name="作業員Ｂ"
		   text="『あ‥‥実は俺もこれから行くつもりだったんだべ。』" voices=""/>
		<msg @l="46" char_id="-1" frame_id="-1" name="作業員Ａ"
		   text="『なんだよ、オマエと連れションかぁ？』" voices=""/>
		<msg @l="48" char_id="-1" frame_id="-1" name="作業員Ｂ"
		   text="『別にいーだろ、便器は二つあんべ。』" voices=""/>
		<msg @l="50" char_id="-1" frame_id="-1" name="作業員Ａ" text="『ま、いーけどよー。』"
		   voices=""/>
		<msg @l="52" char_id="-1" frame_id="-1" name=""
		   text="建築現場の一角で交わされる他愛もない日常会話。" voices=""/>
		<msg @l="53" char_id="-1" frame_id="-1" name=""
		   text="だが、彼らの言葉の裏側には‥‥非日常が込められている。" voices=""/>
		<msg @l="54" char_id="-1" frame_id="-1" name=""
		   text="ひとつは「催した」というのが、尿意だけではないこと。" voices=""/>
		<msg @l="55" char_id="-1" frame_id="-1" name=""
		   text="そしてもうひとつは‥‥彼らの指している「便器」が物ではないことだ。" voices=""/>
		<stopbgm @l="59" fadeout="1000"/>
		<label @l="63" id="chart_line38"/>
		<wait_chgmv/>
		<ev @l="67" src="ev-031"/>
		<bgm @l="71" src="bgm14" volume="1."/>
		<msg @l="73" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』"
		   voices="miho11520"/>
		<msg @l="75" char_id="1" frame_id="-1" name="玲" text="『‥‥‥‥。』"
		   voices="rei02540"/>
		<msg @l="77" char_id="-1" frame_id="-1" name=""
		   text="二人の向かった先にあった「便器」は‥‥拘束具によって自由を奪われた玲と美帆だった。" voices=""/>
		<msg @l="78" char_id="-1" frame_id="-1" name=""
		   text="南総町での計画は順調ではあったが、開発を急ぐあまり、それを支える労働者への性的なケアが後回しになっていた。" voices=""/>
		<msg @l="79" char_id="-1" frame_id="-1" name=""
		   text="通常、ヘルスなどの風俗店がそれを行うのだが、誘致してくれる大企業のビルを最優先としている為に、小さな店などは当然、後回しになってしまっていた。"
		   voices=""/>
		<msg @l="80" char_id="-1" frame_id="-1" name=""
		   text="他の建設会社が名乗りを上げ建てようとしたが、大黒建設が取り仕切るこの町で、それは無理だった。" voices=""/>
		<msg @l="81" char_id="-1" frame_id="-1" name=""
		   text="多くの労働者を抱える大黒建設は役所との折衝の結果、応急的な処置として建設労働者用の性欲処理「便所」を、あちこちに設置することになったのだ。"
		   voices=""/>
		<msg @l="82" char_id="-1" frame_id="-1" name=""
		   text="そんな「便器」のひとつとして、美帆達が繋がれていた。" voices=""/>
		<msg @l="83" char_id="-1" frame_id="-1" name=""
		   text="彼女たちの身体には、小便や精液といった類が拭われることなくこびりついており、彼ら以外の作業員たちも使用しているのが分かる。"
		   voices=""/>
		<msg @l="84" char_id="-1" frame_id="-1" name=""
		   text="美帆の腹が異常に膨らんでいるのは、作業員達に犯され、中出しされ続けた結果、誰が父親ともわからぬ子供を孕んでしまったからだ‥‥。"
		   voices=""/>
		<msg @l="86" char_id="-1" frame_id="-1" name="作業員Ａ" text="『なんだよ、結構汚れてんな。』"
		   voices=""/>
		<msg @l="88" char_id="-1" frame_id="-1" name="作業員Ｂ" text="『ま、公共物だから仕方ねぇべ。』"
		   voices=""/>
		<msg @l="90" char_id="-1" frame_id="-1" name="作業員Ａ"
		   text="『そりゃそーだけどよ、もうちょっと後のヤツのことを考えて使って欲しいもんだよな。』" voices=""/>
		<msg @l="92" char_id="-1" frame_id="-1" name="" text="玲を眺めていた一人が小さな違和感に気付く。"
		   voices=""/>
		<msg @l="94" char_id="-1" frame_id="-1" name="作業員Ａ"
		   text="『お？&#32;点滴止まってるぞ。』" voices=""/>
		<msg @l="96" char_id="-1" frame_id="-1" name="作業員Ｂ" text="『ありゃ、本当だべ。』"
		   voices=""/>
		<msg @l="98" char_id="-1" frame_id="-1" name="作業員Ａ"
		   text="『前の奴、可哀想になって止めてしまったのか？&#32;ここから連れ出す勇気もねえのに中途半端なことしやがって。』" voices=""/>
		<msg @l="100" char_id="-1" frame_id="-1" name="作業員Ｂ"
		   text="『んだんだ、中途半端な情けは不要だべ。』" voices=""/>
		<msg @l="102" char_id="-1" frame_id="-1" name=""
		   text="玲の脇に、あからさまに普通ではない点滴がぶら下がっていた。" voices=""/>
		<msg @l="103" char_id="-1" frame_id="-1" name=""
		   text="吊るされている点滴の中身が所々黄ばんだ色が混じった精液だと判る。" voices=""/>
		<msg @l="104" char_id="-1" frame_id="-1" name=""
		   text="その根元のコックが「閉じる」になったままだった。" voices=""/>
		<msg @l="105" char_id="-1" frame_id="-1" name=""
		   text="点滴から伸びる太目のゴム管は、玲の秘裂へ潜り込んでいる。" voices=""/>
		<msg @l="106" char_id="-1" frame_id="-1" name=""
		   text="外からは見えないが、その先端は玲の子宮口と直結している。" voices=""/>
		<msg @l="107" char_id="-1" frame_id="-1" name=""
		   text="コックを捻れば、玲の子宮に少しずつ、誰のものとも付かない交じり合った精液が流れ込むようになっている。" voices=""/>
		<msg @l="109" char_id="-1" frame_id="-1" name="作業員Ａ" text="『いれるぞ～。』"
		   voices=""/>
		<msg @l="111" char_id="1" frame_id="-1" name="玲" text="『‥‥‥‥。』"
		   voices="rei02540"/>
		<msg @l="113" char_id="-1" frame_id="-1" name="" text="そう言って「開ける」に合わせる。"
		   voices=""/>
		<msg @l="114" char_id="-1" frame_id="-1" name=""
		   text="玲の子宮に一滴、また一滴と精液が流れていく。" voices=""/>
		<msg @l="116" char_id="-1" frame_id="-1" name="" text="トクトクトク" voices=""/>
		<msg @l="118" char_id="-1" frame_id="-1" name="作業員Ｂ"
		   text="『はやぐ孕まねぇどな。隣の便器が仲間ほしぐで寂しがってるがらの。』" voices=""/>
		<msg @l="120" char_id="-1" frame_id="-1" name="作業員Ａ"
		   text="『んだ。俺ら孕んだ女を犯す方がもえるけんの。』" voices=""/>
		<msg @l="122" char_id="-1" frame_id="-1" name="作業員Ｂ" text="『んだ、んだ。』"
		   voices=""/>
		<msg @l="124" char_id="-1" frame_id="-1" name=""
		   text="玲を覗き込んで、恐ろしい台詞を優しく語り掛ける。" voices=""/>
		<msg @l="126" char_id="-1" frame_id="-1" name="作業員Ａ" text="『そろそろ小便すっか。』"
		   voices=""/>
		<msg @l="128" char_id="-1" frame_id="-1" name="作業員Ｂ"
		   text="『んだの、俺ら用足しさ来たがらの。』" voices=""/>
		<msg @l="130" char_id="-1" frame_id="-1" name=""
		   text="作業員たちはそう言うと、拘束された美帆と玲に向かってズボンを下ろしてペニスを取り出す。" voices=""/>
		<wait_chgmv/>
		<ev @l="134" src="ev-031z1"/>
		<msg @l="136" char_id="-1" frame_id="-1" name=""
		   text="さも本当の「便器」に向かっているかのような顔で、二人の身体に小便を注いでいく。" voices=""/>
		<msg @l="137" char_id="-1" frame_id="-1" name="" text="こびりついた精液が多少、洗い流される。"
		   voices=""/>
		<msg @l="139" char_id="-1" frame_id="-1" name="作業員Ａ"
		   text="『あー‥‥この開放感がたまんねー。』" voices=""/>
		<msg @l="141" char_id="-1" frame_id="-1" name="作業員Ｂ"
		   text="『さすがは大黒建設の便器だ。ションベンの気持ち良さも違うべ。』" voices=""/>
		<msg @l="143" char_id="0" frame_id="-1" name="美帆" text="『んっ‥‥。』"
		   voices="miho11530"/>
		<msg @l="145" char_id="1" frame_id="-1" name="玲" text="『‥‥‥っ‥‥。』"
		   voices="rei02550"/>
		<msg @l="147" char_id="-1" frame_id="-1" name=""
		   text="美帆と玲は僅かに表情を曇らせるだけで、抵抗することなく黙って彼らの仕打ちに耐えている。" voices=""/>
		<msg @l="148" char_id="-1" frame_id="-1" name=""
		   text="無駄に抗ったとしても何一つ変わる事が無いと、徹底的に真島から刷り込まれた結果なのだろう。" voices=""/>
		<msg @l="150" char_id="-1" frame_id="-1" name="作業員Ａ"
		   text="『さーて、ションベンの次はやっぱこれだよな。』" voices=""/>
		<msg @l="152" char_id="-1" frame_id="-1" name=""
		   text="そう言って、作業員の一人が自分のモノをしごきはじめる。" voices=""/>
		<msg @l="154" char_id="-1" frame_id="-1" name="作業員Ｂ"
		   text="『見るだけってのがちょっと物足んねんども、こんげ汚れでっど触る気しねはげの。服、汚れっさげ。』" voices=""/>
		<msg @l="156" char_id="-1" frame_id="-1" name=""
		   text="もう一人も自分で肉棒をしごき上げながら、ゲラゲラと笑う。" voices=""/>
		<msg @l="158" char_id="0" frame_id="-1" name="美帆" text="『‥‥うぅ‥‥。』"
		   voices="miho11540"/>
		<msg @l="160" char_id="-1" frame_id="-1" name=""
		   text="男たちの非情な言葉に、美帆が悲しげな声を漏らす。" voices=""/>
		<msg @l="161" char_id="-1" frame_id="-1" name=""
		   text="けれど口腔にはめられた拘束具のせいで言葉にならない。" voices=""/>
		<msg @l="163" char_id="-1" frame_id="-1" name="作業員Ａ"
		   text="『見ろよ、こっちの便器のマ○コ、なんか濡れてんぜ？』" voices=""/>
		<msg @l="165" char_id="1" frame_id="-1" name="玲" text="『‥‥！！』"
		   voices="rei02560"/>
		<msg @l="167" char_id="-1" frame_id="-1" name=""
		   text="自らの肉棒をしごきながら、男の一人が玲の秘部を指差して言う。" voices=""/>
		<msg @l="168" char_id="-1" frame_id="-1" name=""
		   text="玲のそこは精液やら小便やらでぐちょぐちょになっているが、凝視してみると、それらとは別に半透明の雫が内側から滲んできている事がわかる。"
		   voices=""/>
		<msg @l="170" char_id="-1" frame_id="-1" name="作業員Ｂ"
		   text="『どれ？&#32;お、ほんとだべ‥‥便器が発情するどは、まっだぐ‥。』" voices=""/>
		<msg @l="172" char_id="-1" frame_id="-1" name="作業員Ａ"
		   text="『俺らのチ○ポみてハメて欲しがってんだろ。』" voices=""/>
		<msg @l="174" char_id="-1" frame_id="-1" name="作業員Ｂ" text="『便器のクセして生意気だべ。』"
		   voices=""/>
		<msg @l="176" char_id="1" frame_id="-1" name="玲" text="『くっ‥‥。』"
		   voices="rei02570"/>
		<msg @l="178" char_id="-1" frame_id="-1" name=""
		   text="好き放題言われても、玲はぐっと言葉をかみ殺し、耐え続ける。" voices=""/>
		<msg @l="179" char_id="-1" frame_id="-1" name="" text="便器は何があっても言葉を発しない。"
		   voices=""/>
		<msg @l="180" char_id="-1" frame_id="-1" name=""
		   text="それが、彼女たちに与えられた絶対のルールだからだ。" voices=""/>
		<msg @l="182" char_id="-1" frame_id="-1" name="作業員Ａ" text="『うっ‥‥来たぞぉ、来たぞぉ。』"
		   voices=""/>
		<msg @l="184" char_id="-1" frame_id="-1" name=""
		   text="硬くそそり勃った男根を激しくしごき上げながら、作業員の一人が上擦った声をあげる。" voices=""/>
		<msg @l="186" char_id="-1" frame_id="-1" name="作業員Ｂ"
		   text="『こっちも‥‥あど、ちょっとだべ。』" voices=""/>
		<msg @l="188" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』"
		   voices="miho11550"/>
		<msg @l="190" char_id="1" frame_id="-1" name="玲" text="『‥‥‥‥。』"
		   voices="rei02580"/>
		<msg @l="192" char_id="-1" frame_id="-1" name=""
		   text="男たちの言葉を聞いて、僅かに「便器」たちの瞳が潤む。" voices=""/>
		<msg @l="194" char_id="-1" frame_id="-1" name="作業員Ａ" text="『う、おおおっ！』"
		   voices=""/>
		<msg @l="196" char_id="-1" frame_id="-1" name="作業員Ｂ" text="『イグっっ！』"
		   voices=""/>
		<flash @l="200" count="4" fade="100" image="white"/>
		<wait_chgmv/>
		<ev @l="204" src="ev-031z2"/>
		<msg @l="206" char_id="0" frame_id="-1" name="美帆" text="『んぅ‥‥。』"
		   voices="miho11560"/>
		<msg @l="208" char_id="1" frame_id="-1" name="玲" text="『‥‥‥ぁっ‥‥。』"
		   voices="rei02590"/>
		<msg @l="210" char_id="-1" frame_id="-1" name=""
		   text="男たちの男根から吐き出される精液が、二つの便器に降り注ぐ。" voices=""/>
		<msg @l="211" char_id="-1" frame_id="-1" name=""
		   text="美帆と玲はわずかに熱のこもった吐息を漏らして‥‥それを黙って受け止める。" voices=""/>
		<msg @l="212" char_id="-1" frame_id="-1" name="作業員Ａ" text="『うーし、すっきりしたぁ。』"
		   voices=""/>
		<msg @l="214" char_id="-1" frame_id="-1" name="作業員Ｂ"
		   text="『これで午後の作業にも身が入るってもんだべな。』" voices=""/>
		<msg @l="216" char_id="-1" frame_id="-1" name=""
		   text="そう言って、男たちは萎えかけたペニスをしまうと二つの便器を後にする。" voices=""/>
		<msg @l="218" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』"
		   voices="miho11570"/>
		<msg @l="220" char_id="1" frame_id="-1" name="玲" text="『‥‥‥‥。』"
		   voices="rei02600"/>
		<msg @l="222" char_id="-1" frame_id="-1" name=""
		   text="この町の最下層に転落した彼女たちは、また自分たちへ排泄しにくる男を待ち続ける。" voices=""/>
		<msg @l="223" char_id="-1" frame_id="-1" name=""
		   text="それが自分たちの喜びであるのだと‥‥身体が覚えるまで‥‥ずっと‥‥‥‥。" voices=""/>
		<stopbgm @l="226" fadeout="1000"/>
		<clear @l="232" class="all"/>
		<msg @l="233" char_id="-1" frame_id="-1" name="" text="･･････････････。"
		   voices=""/>
		<msg @l="234" char_id="-1" frame_id="-1" name="" text="････････。" voices=""/>
		<msg @l="236" char_id="-1" frame_id="-1" name=""
		   text="その姿を大黒と真島は備え付けてあるモニターで見ていた。大黒は玲の姿を見て爬虫類のような笑みを浮かべる。" voices=""/>
		<msg @l="238" char_id="-1" frame_id="1" name="大黒"
		   text="（綺麗ですよ玲さん。あの美しく気高かったあなたが今や作業員達の便所に成り下がっているのですからね。）" voices=""/>
		<msg @l="240" char_id="-1" frame_id="1" name="大黒"
		   text="（玲さんが作業員の子を孕んだら最高でしょうね。早くみたいですよ。そしたらまた100人中出しをやって中の子供に栄養をあげますからね･･････くっくっくっくっ）"
		   voices=""/>
		<msg @l="242" char_id="-1" frame_id="-1" name=""
		   text="その様子を横で見ていた真島は苦笑いをしていた。" voices=""/>
		<msg @l="244" char_id="-1" frame_id="1" name="真島"
		   text="（へへっ････やっぱりおっかねぇな、大黒さんはよ････あんたらも大変な奴に目を付けられたもんだな。）" voices=""/>
		<msg @l="246" char_id="-1" frame_id="-1" name=""
		   text="そうして二人の男は家畜と成り下がった玲と美帆を蔑んだ目で見続けるのであった･･････。" voices=""/>
		<clear @l="253" class="all"/>
		<end_scene @l="256"/>
		<eval @l="260" expr="s.flagGallery=1&#13;&#10;"/>
		<eval @l="262" expr="s.event31flag=1&#13;&#10;"/>
		<eval @l="266"
