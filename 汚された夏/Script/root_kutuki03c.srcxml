<?xml version="1.0" encoding="utf-8"?>
<xscript>
	<debug editor="&quot;C:\Program&#32;Files&#32;(x86)\sakura\sakura.exe&quot;&#32;&quot;%src%&quot;&#32;-Y=%line%"
	   src="D:\シロップ\町ぐるみの罠＋汚された夏セット版\汚された夏\完成データ\汚された夏\script\text\root_kutuki03c.txt"/>
	<code>
		<label @l="10" id="EventLabel_122"/>
		<description @l="13" text="契約の日々・２日目"/>
		<eval @l="15" expr="f.numDay=8&#13;&#10;"/>
		<msgshow @l="17" show="false"/>
		<wait_chgmv/>
		<bg @l="19" src="day08" time="2000"/>
		<wait @l="21" time="500"/>
		<wait_chgmv/>
		<bg @l="23" src="black" time="2000"/>
		<msgshow @l="25" show="true"/>
		<wait_chgmv/>
		<bg @l="28" src="bg03"/>
		<bgm @l="31" src="bgm03" volume="1."/>
		<char @l="34" id="miho" pos="auto" src="miho126"/>
		<msg @l="36" char_id="0" frame_id="-1" name="美帆" text="『それじゃ‥‥いってきます。』"
		   voices=""/>
		<msg @l="38" char_id="-1" frame_id="-1" name=""
		   text="月曜の朝、いつものように支度を終えて玄関へ向かう。" voices=""/>
		<msg @l="39" char_id="-1" frame_id="-1" name=""
		   text="週末の二日間は、幸い朽木教授と遭うこともなく平穏に過ぎた。" voices=""/>
		<msg @l="40" char_id="-1" frame_id="-1" name=""
		   text="とはいえ彼に出会ってしまう恐怖に震えながら殆どの時間を部屋の中で過ごしていたのだから、遭遇しようがないといえばそれまでだ。"
		   voices=""/>
		<msg @l="41" char_id="-1" frame_id="-1" name=""
		   text="そして今日も、私の心には憂鬱という影が‥‥まとわりついていた。" voices=""/>
		<clear @l="44" class="char"/>
		<char @l="46" id="miho" pos="left" src="miho126"/>
		<char @l="48" id="rei" pos="right" src="rei030"/>
		<msg @l="50" char_id="1" frame_id="-1" name="玲" text="『あら、もうでかけるのね。』"
		   voices=""/>
		<msg @l="52" char_id="1" frame_id="-1" name="玲" text="『気をつけて行ってらっしゃい。』"
		   voices=""/>
		<msg @l="54" char_id="0" frame_id="-1" name="美帆" text="『はい‥‥。』" voices=""/>
		<clear @l="57" layer="miho"/>
		<msg @l="59" char_id="-1" frame_id="-1" name=""
		   text="短く返事をして、私はそのままリビングを後にしようとする。" voices=""/>
		<msg @l="61" char_id="1" frame_id="-1" name="玲" text="『‥‥‥‥。』" voices=""/>
		<char @l="64" id="rei" pos="right" src="rei034"/>
		<msg @l="66" char_id="1" frame_id="-1" name="玲" text="『美帆。』" voices=""/>
		<char @l="69" id="miho" pos="left" src="miho124"/>
		<msg @l="71" char_id="0" frame_id="-1" name="美帆" text="『え‥‥は、はい？』" voices=""/>
		<char @l="74" id="rei" pos="right" src="rei030"/>
		<msg @l="76" char_id="1" frame_id="-1" name="玲" text="『アナタ‥‥顔色悪いわよ？』"
		   voices=""/>
		<msg @l="78" char_id="1" frame_id="-1" name="玲" text="『体調、悪いんじゃない？』"
		   voices=""/>
		<char @l="81" id="miho" pos="left" src="miho026"/>
		<msg @l="83" char_id="0" frame_id="-1" name="美帆" text="『だ、大丈夫ですよ。』"
		   voices=""/>
		<msg @l="85" char_id="1" frame_id="-1" name="玲" text="『‥‥そう？&#32;ならいいけど。』"
		   voices=""/>
		<char @l="88" id="miho" pos="left" src="miho125"/>
		<msg @l="90" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="92" char_id="0" frame_id="-1" name="美帆" text="(言えるわけ‥‥ないよね)"
		   voices=""/>
		<msg @l="94" char_id="0" frame_id="-1" name="美帆"
		   text="(朽木教授の奴隷になって‥‥‥命令で‥‥‥下着、つけてないだなんて)" voices=""/>
		<char @l="97" id="rei" pos="right" src="rei034"/>
		<msg @l="99" char_id="1" frame_id="-1" name="玲" text="『なに？&#32;どうかした？』"
		   voices=""/>
		<char @l="102" id="miho" pos="left" src="miho026"/>
		<msg @l="104" char_id="0" frame_id="-1" name="美帆" text="『いえ‥‥なんでもないです。』"
		   voices=""/>
		<clear @l="107" layer="miho"/>
		<msg @l="109" char_id="0" frame_id="-1" name="美帆" text="『‥‥行って来ます。』"
		   voices=""/>
		<clear @l="112" class="all"/>
		<msgshow @l="114" show="true"/>
		<wait_chgmv/>
		<bg @l="117" src="bg21"/>
		<msg @l="119" char_id="-1" frame_id="-1" name=""
		   text="停留所につくと、ちょうど始発の電車が着た所だった。" voices=""/>
		<msg @l="120" char_id="-1" frame_id="-1" name=""
		   text="私は慌てて列を作っている人たちの最後尾へ、小走りで駆け寄る。" voices=""/>
		<char @l="123" id="miho" pos="auto" src="miho125"/>
		<msg @l="125" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="127" char_id="0" frame_id="-1" name="美帆" text="(うわ‥‥走ると胸がこすれる‥‥‥)"
		   voices=""/>
		<msg @l="129" char_id="-1" frame_id="-1" name="" text="下着をつけていないのだから、仕方が無い。"
		   voices=""/>
		<msg @l="130" char_id="-1" frame_id="-1" name=""
		   text="最後尾についた私は服の上から手で胸を押さえ‥‥わずかに息を吐く。" voices=""/>
		<msg @l="132" char_id="-1" frame_id="-1" name="男子学生" text="『‥‥‥‥。』"
		   voices=""/>
		<msg @l="134" char_id="-1" frame_id="-1" name=""
		   text="最後尾にいた男子学生が後ろを振り返り、私を見る。" voices=""/>
		<msg @l="135" char_id="-1" frame_id="-1" name=""
		   text="もしかして‥‥気付かれてしまったのだろうか。" voices=""/>
		<msg @l="137" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="139" char_id="-1" frame_id="-1" name="男子学生" text="『‥‥‥‥。』"
		   voices=""/>
		<msg @l="141" char_id="-1" frame_id="-1" name=""
		   text="男子学生の彼は私を一瞥すると、すぐに前を向きなおす。" voices=""/>
		<msg @l="142" char_id="-1" frame_id="-1" name=""
		   text="ただ、駆け寄ってきた私の足音が気になって‥‥ということだろう。" voices=""/>
		<char @l="145" id="miho" pos="auto" src="miho126"/>
		<msg @l="147" char_id="0" frame_id="-1" name="美帆"
		   text="(ほっ‥‥別に気付いたわけじゃなかったんだ)" voices=""/>
		<msg @l="149" char_id="0" frame_id="-1" name="美帆"
		   text="(そ、そうだよね‥‥いくら下着をつけてなくても服の上からじゃわからないだろうし)" voices=""/>
		<msg @l="151" char_id="0" frame_id="-1" name="美帆" text="(心配しすぎ‥‥かな)"
		   voices=""/>
		<msg @l="153" char_id="-1" frame_id="-1" name="" text="そんな事を思いながら、電車に乗り込んだ。"
		   voices=""/>
		<clear @l="156" class="all"/>
		<label @l="159" id="event_scene14"/>
		<se @l="162" buf="3" loop="true" src="電車走行中" volume="1."/>
		<msg @l="164" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="166" char_id="-1" frame_id="-1" name="" text="いつもいる場所が空いていなかった。"
		   voices=""/>
		<msg @l="167" char_id="-1" frame_id="-1" name=""
		   text="私は仕方なく適当なつり革に掴まって電車の揺れに身を任せた。" voices=""/>
		<msg @l="169" char_id="0" frame_id="-1" name="美帆"
		   text="(私、なんでこんなこと‥‥‥してるんだろ)" voices=""/>
		<msg @l="171" char_id="-1" frame_id="-1" name=""
		   text="スカートの裾に注意を払いながら、私は何度となく深いため息をつく。" voices=""/>
		<msg @l="172" char_id="-1" frame_id="-1" name=""
		   text="父を守る為、朽木教授の言う通りにしなければならないのは‥‥仕方ないことだと思っている。" voices=""/>
		<msg @l="173" char_id="-1" frame_id="-1" name="" text="けれど‥‥それはいつまで続くのだろう？"
		   voices=""/>
		<msg @l="174" char_id="-1" frame_id="-1" name=""
		   text="教授の言うように、父が定年退職するまでの十数年だろうか？" voices=""/>
		<msg @l="175" char_id="-1" frame_id="-1" name="" text="それとも‥‥。" voices=""/>
		<msg @l="177" char_id="0" frame_id="-1" name="美帆"
		   text="(ダメだ‥‥考えても、何にもならないよ)" voices=""/>
		<msg @l="179" char_id="0" frame_id="-1" name="美帆" text="(今は教授の言葉に従うしか‥‥‥ない)"
		   voices=""/>
		<msg @l="181" char_id="-1" frame_id="-1" name="" text="私の顔に諦めの表情が浮かぶ。"
		   voices=""/>
		<msg @l="183" char_id="-1" frame_id="-1" name="声" text="『実に清々しい朝だな。』"
		   voices=""/>
		<msg @l="185" char_id="0" frame_id="-1" name="美帆" text="『‥‥！！』" voices=""/>
		<msg @l="187" char_id="-1" frame_id="-1" name="" text="不意に、私の耳元へ囁きかけられる言葉。"
		   voices=""/>
		<msg @l="189" char_id="0" frame_id="-1" name="美帆" text="『‥‥教授‥‥‥。』"
		   voices=""/>
		<msg @l="191" char_id="-1" frame_id="-1" name="朽木"
		   text="『こうして電車内で会うのは久しぶりだな。』" voices=""/>
		<msg @l="193" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="195" char_id="-1" frame_id="-1" name="" text="出来ればもう二度と会いたくはなかった。"
		   voices=""/>
		<msg @l="197" char_id="-1" frame_id="-1" name="朽木"
		   text="『なるほど、歓迎の言葉をキミの口から聞くにはまだ時間が必要なようだ。』" voices=""/>
		<msg @l="199" char_id="0" frame_id="-1" name="美帆"
		   text="『どれだけ時間が経っても‥‥私は心までは売りません。』" voices=""/>
		<msg @l="201" char_id="-1" frame_id="-1" name="朽木" text="『フフ、まぁいい。』"
		   voices=""/>
		<msg @l="203" char_id="-1" frame_id="-1" name="朽木"
		   text="『さて‥‥今日はしっかり私の命令を守ってきたかね？』" voices=""/>
		<msg @l="205" char_id="0" frame_id="-1" name="美帆" text="『はい‥‥。』" voices=""/>
		<msg @l="207" char_id="-1" frame_id="-1" name="朽木" text="『本当かね？』" voices=""/>
		<msg @l="209" char_id="0" frame_id="-1" name="美帆" text="『ほ、本当です‥‥。』"
		   voices=""/>
		<msg @l="211" char_id="-1" frame_id="-1" name="朽木"
		   text="『ふむ。だが言葉だけでは信用できないな。』" voices=""/>
		<msg @l="213" char_id="-1" frame_id="-1" name="朽木" text="『‥‥確かめさせてもらおうか。』"
		   voices=""/>
		<msg @l="215" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥え、まさか！？』"
		   voices=""/>
		<msg @l="217" char_id="-1" frame_id="-1" name="朽木" text="『くくっ‥‥。』" voices=""/>
		<label @l="220" id="chart_line44"/>
		<wait_chgmv/>
		<ev @l="223" src="ev-014"/>
		<description @l="226" text="露出痴漢プレイ"/>
		<bgm @l="229" src="bgm14" volume="1."/>
		<msg @l="231" char_id="-1" frame_id="-1" name=""
		   text="教授の指先が服の裾を掴みまくりあげ、下着をつけていない私の胸と秘部を満員電車の中でむき出しにしてしまう。" voices=""/>
		<msg @l="233" char_id="0" frame_id="-1" name="美帆" text="『ああ‥‥。』"
		   voices="miho08220"/>
		<msg @l="235" char_id="-1" frame_id="-1" name=""
		   text="私は抵抗することも許されず、ただ、諦めの声をあげて朽木教授のされるがままになるしかなかった。" voices=""/>
		<msg @l="237" char_id="-1" frame_id="-1" name="朽木"
		   text="『おお、確かに命令を守っているようだな。』" voices=""/>
		<msg @l="239" char_id="0" frame_id="-1" name="美帆"
		   text="『め、命令を守っている事がわかったのなら‥‥手を離してください。』" voices="miho08230"/>
		<msg @l="241" char_id="0" frame_id="-1" name="美帆"
		   text="『こんなところ‥‥もし誰かに見つかったりしたら‥‥‥‥‥。』" voices="miho08240"/>
		<msg @l="243" char_id="-1" frame_id="-1" name=""
		   text="私の眼前の座席に座っている人たちはみな雑誌を読んだり眠ったりしているので、今の所こちらの様子には気付いていない。" voices=""/>
		<msg @l="244" char_id="-1" frame_id="-1" name=""
		   text="けれど‥‥こんな事を続けていれば、いつか必ず見られてしまう。" voices=""/>
		<msg @l="246" char_id="-1" frame_id="-1" name="朽木"
		   text="『いいではないか、皆に見てもらおう。』" voices=""/>
		<msg @l="248" char_id="-1" frame_id="-1" name=""
		   text="教授の指先で胸の膨らみをそっと、円を描くようになぞられる。" voices=""/>
		<msg @l="250" char_id="0" frame_id="-1" name="美帆" text="『そ、そんなっ――――。』"
		   voices="miho08250"/>
		<msg @l="252" char_id="-1" frame_id="-1" name=""
		   text="思わず声を荒げそうになって‥‥慌てて口をつぐむ。" voices=""/>
		<msg @l="253" char_id="-1" frame_id="-1" name=""
		   text="ここで私が声を出して、乗客に気付かれるわけにはいかない。" voices=""/>
		<msg @l="255" char_id="-1" frame_id="-1" name="朽木"
		   text="『くくっ‥‥そうして、黙っていたほうが君の為だ。』" voices=""/>
		<msg @l="257" char_id="-1" frame_id="-1" name=""
		   text="ゆっくりと‥‥朽木教授の指先が私の白い半球形の乳房をギュッとつかみ、形が変わるように揉みまわす。" voices=""/>
		<msg @l="258" char_id="-1" frame_id="-1" name=""
		   text="下着がないぶん、もう一方の手は簡単に秘裂の淫肉を割り蜜壺を嬲りあげる。" voices=""/>
		<msg @l="260" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』"
		   voices="miho08260"/>
		<msg @l="262" char_id="-1" frame_id="-1" name=""
		   text="私は‥‥声が出そうになるのを抑えながら、ただ言うなりになるしかなかった。" voices=""/>
		<msg @l="263" char_id="-1" frame_id="-1" name=""
		   text="いつ周囲の人間が私の姿に気付いてしまうかと‥‥怯えながら。" voices=""/>
		<msg @l="265" char_id="-1" frame_id="-1" name="朽木"
		   text="『おや‥‥少し、感じてきているのではないかね？』" voices=""/>
		<msg @l="267" char_id="0" frame_id="-1" name="美帆" text="『そ、そんなことっ‥‥‥ありません。』"
		   voices="miho08270"/>
		<msg @l="269" char_id="-1" frame_id="-1" name="朽木"
		   text="『その割に、随分と乳首が硬くなってきているように思うのだがね。』" voices=""/>
		<msg @l="271" char_id="-1" frame_id="-1" name=""
		   text="そう言って教授の指先がコリコリとグミのような乳首を転がして見せる。" voices=""/>
		<msg @l="272" char_id="-1" frame_id="-1" name=""
		   text="確かに‥‥私のそこはわずかに充血し勃起し始めていた。" voices=""/>
		<msg @l="274" char_id="0" frame_id="-1" name="美帆" text="『ち、違います‥‥それは‥‥‥‥。』"
		   voices="miho08280"/>
		<msg @l="276" char_id="-1" frame_id="-1" name="朽木" text="『それは？』" voices=""/>
		<msg @l="278" char_id="0" frame_id="-1" name="美帆" text="『う‥んっ‥。』"
		   voices="miho08290"/>
		<msg @l="280" char_id="-1" frame_id="-1" name="朽木" text="『どうした？&#32;違うのかね？』"
		   voices=""/>
		<msg @l="282" char_id="-1" frame_id="-1" name="朽木"
		   text="『下着をつけず人前でに陰部を晒して乳首を硬くしているのに、今さら何を言っているのかね？』" voices=""/>
		<msg @l="284" char_id="0" frame_id="-1" name="美帆" text="『い、言わないでください‥‥。』"
		   voices="miho08300"/>
		<msg @l="286" char_id="-1" frame_id="-1" name="朽木" text="『つまり、認めるという事だな。』"
		   voices=""/>
		<msg @l="288" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』"
		   voices="miho08310"/>
		<msg @l="290" char_id="-1" frame_id="-1" name="朽木" text="『くくっ、やはりな。』"
		   voices=""/>
		<msg @l="292" char_id="-1" frame_id="-1" name="朽木"
		   text="『父の為に身体を犠牲にしている健気な娘を演じているが、実は人前で陰部を晒しいじくられると感じる淫乱だったということか。』"
		   voices=""/>
		<msg @l="294" char_id="0" frame_id="-1" name="美帆"
		   text="『ち、ちがいます、私は別に淫乱なんかじゃ‥‥‥‥。』" voices="miho08320"/>
		<msg @l="296" char_id="-1" frame_id="-1" name="朽木"
		   text="『ならば‥‥これはどう説明するのかね？』" voices=""/>
		<msg @l="298" char_id="0" frame_id="-1" name="美帆" text="『んっ！！』"
		   voices="miho08330"/>
		<msg @l="300" char_id="-1" frame_id="-1" name=""
		   text="教授の３本指が膣内に突き入れられる。そして、蜜壺をグチュグチュとかきまわすように、指を出し入れさせる。" voices=""/>
		<msg @l="301" char_id="-1" frame_id="-1" name=""
		   text="ピストンは次第に早まり、媚肉を擦りあげてヌチャヌチャと蜜汁を弾く淫靡な音を車内にたてた。" voices=""/>
		<msg @l="303" char_id="0" frame_id="-1" name="美帆"
		   text="『ダメ、ダメぇっ‥‥‥んっ、んんっ‥‥‥‥あああっっ！』" voices="miho10160"/>
		<msg @l="305" char_id="-1" frame_id="-1" name=""
		   text="さらに空いている指の腹で包皮に包まれた秘芯を撫であげる。" voices=""/>
		<msg @l="307" char_id="-1" frame_id="-1" name="朽木"
		   text="『こちらも、随分と硬くなっているようだがね？』" voices=""/>
		<msg @l="309" char_id="0" frame_id="-1" name="美帆" text="『や、ああ‥‥。』"
		   voices="miho08340"/>
		<msg @l="311" char_id="-1" frame_id="-1" name=""
		   text="教授の指が肉びらを開くと、中に籠もっている百合の花に似た馥郁（ふくいく）な香りが匂いたち、教授の脳髄を刺激する。" voices=""/>
		<msg @l="313" char_id="-1" frame_id="-1" name="朽木"
		   text="『なんという匂いだ。淫乱の女から発する香りはこうも違うものか？』" voices=""/>
		<msg @l="315" char_id="0" frame_id="-1" name="美帆"
		   text="(違うのに‥‥私、淫乱なんかじゃないのに‥‥‥‥)" voices="miho08350"/>
		<msg @l="317" char_id="-1" frame_id="-1" name=""
		   text="すっかり蜜の香りに酔いしれた教授は、胸いっぱいに蜜なる馨香を吸引し、指の動きを激しくする。" voices=""/>
		<msg @l="318" char_id="-1" frame_id="-1" name=""
		   text="思いとは裏腹に、指先で弄ばれた秘芯は更に硬く大きくなっていく。" voices=""/>
		<msg @l="319" char_id="-1" frame_id="-1" name=""
		   text="ジンジンと鈍い痛みの混じった痺れが下腹部を襲い、子宮口からジワッと淫汁が溢れ、胎内を熱くする。" voices=""/>
		<stopbgm @l="322" fadeout="1000"/>
		<clear @l="325" class="all"/>
		<msg @l="327" char_id="-1" frame_id="-1" name="朽木"
		   text="『さて‥‥もういいだろう、服装を正したまえ。』" voices=""/>
		<msg @l="329" char_id="0" frame_id="-1" name="美帆" text="『え‥‥。』"
		   voices="miho08360"/>
		<msg @l="331" char_id="-1" frame_id="-1" name="朽木"
		   text="『私の命令を守っている事は確認出来たのだからな、もう良かろう。』" voices=""/>
		<msg @l="333" char_id="0" frame_id="-1" name="美帆" text="『でも、まだ‥‥。』"
		   voices="miho08370"/>
		<msg @l="335" char_id="-1" frame_id="-1" name="朽木" text="『まだ？』" voices=""/>
		<msg @l="337" char_id="0" frame_id="-1" name="美帆" text="『い、いえ‥‥なんでもありません。』"
		   voices="miho08380"/>
		<msg @l="339" char_id="-1" frame_id="-1" name=""
		   text="私はそして、いそいそとはだけられた服を直し始める。" voices=""/>
		<msg @l="341" char_id="0" frame_id="-1" name="美帆" text="(私‥‥‥‥期待してた？)"
		   voices="miho08390"/>
		<msg @l="343" char_id="0" frame_id="-1" name="美帆"
		   text="(最後までされること‥‥‥‥イかされること、期待してたの？)" voices="miho08400"/>
		<msg @l="345" char_id="-1" frame_id="-1" name=""
		   text="衣服を正しながら、私は自問するように心の中でつぶやいていた。" voices=""/>
		<stopse @l="348" buf="3"/>
		<clear @l="351" class="all"/>
		<end_scene @l="354"/>
		<call @l="357" target="EventLabel_125@root_kutuki04c"/>
		<return @l="358" value="0&#13;&#10;"/>
	</code>
</xscript>
