<?xml version="1.0" encoding="utf-8"?>
<xscript>
	<debug editor="&quot;C:\Program&#32;Files&#32;(x86)\sakura\sakura.exe&quot;&#32;&quot;%src%&quot;&#32;-Y=%line%"
	   src="D:\シロップ\町ぐるみの罠＋汚された夏セット版\汚された夏\完成データ\汚された夏\script\text\root_akina04a.txt"/>
	<code>
		<label @l="14" id="EventLabel_65"/>
		<description @l="17" text="水泳コーチ・４日目(Ａ)"/>
		<eval @l="19" expr="f.numDay=11&#13;&#10;"/>
		<msgshow @l="21" show="false"/>
		<wait_chgmv/>
		<bg @l="23" src="day11" time="2000"/>
		<wait @l="25" time="500"/>
		<wait_chgmv/>
		<bg @l="27" src="black" time="2000"/>
		<msgshow @l="29" show="true"/>
		<wait_chgmv/>
		<bg @l="32" src="bg03"/>
		<bgm @l="35" src="bgm02" volume="1."/>
		<char @l="38" id="miho" pos="auto" src="miho010"/>
		<msg @l="40" char_id="0" frame_id="-1" name="美帆" text="『ごちそうさまでした。』"
		   voices=""/>
		<clear @l="43" class="char"/>
		<char @l="45" id="miho" pos="left" src="miho010"/>
		<char @l="47" id="rei" pos="right" src="rei030"/>
		<msg @l="49" char_id="1" frame_id="-1" name="玲" text="『あら、もういいの？』" voices=""/>
		<char @l="52" id="miho" pos="left" src="miho016"/>
		<msg @l="54" char_id="0" frame_id="-1" name="美帆" text="『あ、はい‥‥ちょっと食欲がなくて。』"
		   voices=""/>
		<char @l="57" id="rei" pos="right" src="rei031"/>
		<msg @l="59" char_id="1" frame_id="-1" name="玲"
		   text="『朝食はしっかり食べないとダメよ。一日の基本なんだから。』" voices=""/>
		<msg @l="61" char_id="0" frame_id="-1" name="美帆"
		   text="『わかってはいるんですけど‥‥どうも、受け付けなくて。』" voices=""/>
		<char @l="64" id="rei" pos="right" src="rei030"/>
		<msg @l="66" char_id="1" frame_id="-1" name="玲" text="『そう‥‥まあ、無理はしないように。』"
		   voices=""/>
		<char @l="69" id="miho" pos="left" src="miho116"/>
		<msg @l="71" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="73" char_id="-1" frame_id="-1" name="" text="私だって出来れば無理なんかしたくない。"
		   voices=""/>
		<msg @l="74" char_id="-1" frame_id="-1" name="" text="でも‥‥。" voices=""/>
		<msg @l="76" char_id="1" frame_id="-1" name="玲" text="『美帆‥‥どうしたの？』"
		   voices=""/>
		<char @l="79" id="miho" pos="left" src="miho014"/>
		<msg @l="81" char_id="0" frame_id="-1" name="美帆" text="『え、あ‥‥なんでもないです。』"
		   voices=""/>
		<char @l="84" id="miho" pos="left" src="miho016"/>
		<msg @l="86" char_id="0" frame_id="-1" name="美帆" text="『それじゃあ私、そろそろ出ますね。』"
		   voices=""/>
		<msg @l="88" char_id="1" frame_id="-1" name="玲" text="『あ、うん。』" voices=""/>
		<msg @l="90" char_id="1" frame_id="-1" name="玲" text="『ん、がんばってね。』" voices=""/>
		<clear @l="93" class="all"/>
		<wait_chgmv/>
		<bg @l="96" src="bg09"/>
		<char @l="99" id="miho" pos="auto" src="miho014"/>
		<msg @l="101" char_id="0" frame_id="-1" name="美帆" text="『あれ‥‥？』" voices=""/>
		<msg @l="103" char_id="-1" frame_id="-1" name=""
		   text="二限目の講義が終わり、食堂へ向かう途中、廊下で見慣れた顔を見つけた。" voices=""/>
		<msg @l="105" char_id="2" frame_id="-1" name="女の子" text="『あ‥‥。』" voices=""/>
		<char @l="108" id="akina" pos="auto" src="akina057"/>
		<bgm @l="111" src="bgm06" volume="1."/>
		<msg @l="113" char_id="2" frame_id="-1" name="亜季奈"
		   text="『やば‥‥いきなりお姉ちゃんに見つかったっ！？』" voices=""/>
		<clear @l="116" class="char"/>
		<char @l="119" id="miho" pos="auto" src="miho014"/>
		<msg @l="121" char_id="0" frame_id="-1" name="美帆" text="『こら、亜季奈っ‥‥待ちなさい！』"
		   voices=""/>
		<msg @l="123" char_id="-1" frame_id="-1" name=""
		   text="私の姿を見て逃げ出そうとした亜季奈の襟首をつかんで引き止める。" voices=""/>
		<msg @l="125" char_id="2" frame_id="-1" name="亜季奈" text="『うにゃっ‥‥や、やっぱり？』"
		   voices=""/>
		<msg @l="127" char_id="0" frame_id="-1" name="美帆" text="『やっぱり。』" voices=""/>
		<clear @l="130" class="char"/>
		<char @l="132" id="miho" pos="left" src="miho010"/>
		<char @l="134" id="akina" pos="right" src="akina155"/>
		<msg @l="136" char_id="2" frame_id="-1" name="亜季奈"
		   text="『あーあ、こんなに早く見つかっちゃうなんて～。』" voices=""/>
		<char @l="139" id="miho" pos="left" src="miho014"/>
		<msg @l="141" char_id="0" frame_id="-1" name="美帆"
		   text="『もう‥‥だいたい、なんで亜季奈がこっちの校舎にいるの？』" voices=""/>
		<msg @l="143" char_id="0" frame_id="-1" name="美帆"
		   text="『合宿に来てる亜季奈たちは基本的に宿舎とプール以外、立ち入り禁止なはずでしょ？』" voices=""/>
		<msg @l="145" char_id="-1" frame_id="-1" name=""
		   text="誰も気に止めないが、大学構内は関係者以外立ち入り禁止になっている。" voices=""/>
		<char @l="148" id="akina" pos="right" src="akina051"/>
		<msg @l="150" char_id="2" frame_id="-1" name="亜季奈" text="『えへへ～。』" voices=""/>
		<msg @l="152" char_id="0" frame_id="-1" name="美帆" text="『えへへ～、じゃないわよ。』"
		   voices=""/>
		<msg @l="154" char_id="0" frame_id="-1" name="美帆"
		   text="『警備員さんに見つかったらつまみ出されちゃうわよ？』" voices=""/>
		<msg @l="156" char_id="2" frame_id="-1" name="亜季奈"
		   text="『大丈夫だって、その時は全速力で逃げるから。』" voices=""/>
		<char @l="159" id="miho" pos="left" src="miho116"/>
		<msg @l="161" char_id="0" frame_id="-1" name="美帆" text="『そういう問題じゃないでしょ‥‥。』"
		   voices=""/>
		<msg @l="163" char_id="0" frame_id="-1" name="美帆"
		   text="『大体、こんな所をうろうろしてるなんてどういうことなの？』" voices=""/>
		<char @l="166" id="akina" pos="right" src="akina157"/>
		<msg @l="168" char_id="2" frame_id="-1" name="亜季奈"
		   text="『うろうろしてるなんて、ひどいなぁ。』" voices=""/>
		<msg @l="170" char_id="2" frame_id="-1" name="亜季奈"
		   text="『私はいま、重要な作戦の任務遂行中なんだから。』" voices=""/>
		<char @l="173" id="miho" pos="left" src="miho010"/>
		<msg @l="175" char_id="0" frame_id="-1" name="美帆" text="『作戦？&#32;任務？』"
		   voices=""/>
		<char @l="178" id="akina" pos="right" src="akina051"/>
		<msg @l="180" char_id="2" frame_id="-1" name="亜季奈"
		   text="『うん。誰にも見つからずに食堂まで行き、プリンを入手してくるという、とても重大にして重要な任務の途中なのであります！』"
		   voices=""/>
		<msg @l="182" char_id="-1" frame_id="-1" name="" text="そう言って亜季奈は片手をおでこにかざす。"
		   voices=""/>
		<msg @l="183" char_id="-1" frame_id="-1" name="" text="敬礼‥‥しているつもりなのだろう。"
		   voices=""/>
		<char @l="186" id="miho" pos="left" src="miho014"/>
		<msg @l="188" char_id="0" frame_id="-1" name="美帆"
		   text="『え、プリンって‥‥‥食堂のはセットについているものだけで、単品では売ってないよ？』" voices=""/>
		<msg @l="190" char_id="-1" frame_id="-1" name=""
		   text="生協にもプリンはあるけど、数が少ないからすぐに売切れてしまう。" voices=""/>
		<msg @l="191" char_id="-1" frame_id="-1" name=""
		   text="だから私も、デザートつきのランチセットがお気に入りなのだ。" voices=""/>
		<char @l="194" id="akina" pos="right" src="akina054"/>
		<msg @l="196" char_id="2" frame_id="-1" name="亜季奈" text="『え、そうなの！？』"
		   voices=""/>
		<char @l="199" id="miho" pos="left" src="miho010"/>
		<msg @l="201" char_id="0" frame_id="-1" name="美帆"
		   text="『そうだよ。プリンはセットにしかつかないんだから。』" voices=""/>
		<char @l="204" id="akina" pos="right" src="akina154"/>
		<msg @l="206" char_id="2" frame_id="-1" name="亜季奈" text="『が～ん！！』" voices=""/>
		<char @l="209" id="akina" pos="right" src="akina055"/>
		<msg @l="211" char_id="2" frame_id="-1" name="亜季奈"
		   text="『せっかく、合宿所の寂しいゴハンに、ささやかな楽しみをつけようと思ってここまで来たのにぃ‥‥。』" voices=""/>
		<char @l="214" id="miho" pos="left" src="miho011"/>
		<msg @l="216" char_id="0" frame_id="-1" name="美帆" text="『ご愁傷様でした。』"
		   voices=""/>
		<msg @l="218" char_id="2" frame_id="-1" name="亜季奈" text="『むー‥‥。』" voices=""/>
		<char @l="221" id="miho" pos="left" src="miho111"/>
		<msg @l="223" char_id="0" frame_id="-1" name="美帆"
		   text="『ほら、そんな子供みたいにむくれてないで、大学の人が来る前に宿舎の方に戻りなさい。』" voices=""/>
		<msg @l="225" char_id="0" frame_id="-1" name="美帆" text="『捕まって、捕虜になるのは嫌でしょ？』"
		   voices=""/>
		<char @l="228" id="akina" pos="right" src="akina050"/>
		<msg @l="230" char_id="2" frame_id="-1" name="亜季奈" text="『‥‥ちぇ。』" voices=""/>
		<clear @l="233" layer="akina"/>
		<msg @l="235" char_id="-1" frame_id="-1" name=""
		   text="そうして亜季奈はがっくりと肩を落として宿舎の方に歩いていく。" voices=""/>
		<msg @l="236" char_id="-1" frame_id="-1" name="" text="よっぽどプリンが楽しみだったに違いない。"
		   voices=""/>
		<msg @l="238" char_id="0" frame_id="-1" name="美帆" text="(プリン‥‥か)" voices=""/>
		<clear @l="241" class="char"/>
		<char @l="243" id="miho" pos="auto" src="miho011"/>
		<msg @l="245" char_id="0" frame_id="-1" name="美帆"
		   text="(今日のセットはプリン付きのやつにしようかな)" voices=""/>
		<char @l="248" id="miho" pos="auto" src="miho110"/>
		<msg @l="250" char_id="0" frame_id="-1" name="美帆"
		   text="(後で持って行ってあげたら亜季奈、喜ぶかな‥‥)" voices=""/>
		<clear @l="253" class="char"/>
		<msg @l="255" char_id="-1" frame_id="-1" name=""
		   text="そんなことを考えながら、私も足早に食堂へ向かうコトにした。" voices=""/>
		<stopbgm @l="258" fadeout="1000"/>
		<clear @l="261" class="all"/>
		<msgshow @l="263" show="true"/>
		<wait_chgmv/>
		<bg @l="266" src="bg10"/>
		<bgm @l="269" src="bgm02" volume="1."/>
		<msg @l="271" char_id="-1" frame_id="-1" name=""
		   text="いつものように、私は憂鬱になりながら水泳部の練習に来ていた。" voices=""/>
		<msg @l="272" char_id="-1" frame_id="-1" name=""
		   text="今日もまたいたずらされるのだと思っていた。だが‥‥。" voices=""/>
		<char @l="275" id="miho" pos="auto" src="miho064"/>
		<msg @l="277" char_id="0" frame_id="-1" name="美帆" text="『水泳勝負‥‥ですか？』"
		   voices=""/>
		<clear @l="280" class="char"/>
		<char @l="282" id="miho" pos="left" src="miho064"/>
		<char @l="284" id="watab" pos="right" src="watabe010"/>
		<msg @l="286" char_id="-1" frame_id="-1" name="渡部"
		   text="『そうだ。大学側の水泳サークルから申し出があってな。』" voices=""/>
		<char @l="289" id="miho" pos="left" src="miho066"/>
		<msg @l="291" char_id="0" frame_id="-1" name="美帆" text="『はあ‥‥でも、どうしてそれを私に？』"
		   voices=""/>
		<msg @l="293" char_id="-1" frame_id="-1" name="渡部"
		   text="『サークルからの指名がオマエだったのだから仕方ないだろ。』" voices=""/>
		<msg @l="295" char_id="0" frame_id="-1" name="美帆" text="『指名って‥‥。』" voices=""/>
		<msg @l="297" char_id="-1" frame_id="-1" name="声" text="『オォウ、ミホサーン！』"
		   voices=""/>
		<char @l="300" id="miho" pos="left" src="miho064"/>
		<msg @l="302" char_id="0" frame_id="-1" name="美帆" text="『え‥‥こ、この声って！？』"
		   voices=""/>
		<msg @l="304" char_id="-1" frame_id="-1" name=""
		   text="聞き覚えのあるおかしなイントネーションに驚いて振り返ると、室内プールの入り口には数人の水泳サークル員を従えた例の留学生が立っていた。"
		   voices=""/>
		<msg @l="305" char_id="-1" frame_id="-1" name=""
		   text="ちなみに‥‥留学生の後ろに控えているサークル員たちはみな例外なく表情を引きつらせている。" voices=""/>
		<msg @l="306" char_id="-1" frame_id="-1" name="" text="彼の行動に、辟易しているのだろう。"
		   voices=""/>
		<msg @l="308" char_id="0" frame_id="-1" name="美帆"
		   text="『もしかして、私を指名した水泳サークルの人って‥‥彼ですか？』" voices=""/>
		<char @l="311" id="watab" pos="right" src="watabe014"/>
		<msg @l="313" char_id="-1" frame_id="-1" name="渡部"
		   text="『そうらしいな。オマエ何かしたのか？』" voices=""/>
		<char @l="316" id="miho" pos="left" src="miho066"/>
		<char @l="318" id="watab" pos="right" src="watabe010"/>
		<msg @l="320" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="322" char_id="-1" frame_id="-1" name=""
		   text="もしかして‥‥昨日のコトを根にもたれてしまったのだろうか？" voices=""/>
		<msg @l="324" char_id="-1" frame_id="-1" name="留学生" text="『キノウハ、シツレ、シマーシタ。』"
		   voices=""/>
		<msg @l="326" char_id="-1" frame_id="-1" name="留学生"
		   text="『キョウハ、セーセードードー、ショウブネ。』" voices=""/>
		<msg @l="328" char_id="0" frame_id="-1" name="美帆" text="『は、はあ‥‥。』" voices=""/>
		<msg @l="330" char_id="-1" frame_id="-1" name=""
		   text="どうして失礼なコトをすると、正々堂々と勝負しなきゃいけないのだろう。" voices=""/>
		<msg @l="331" char_id="-1" frame_id="-1" name=""
		   text="というよりも、失礼なコトをしたのだという自覚があっただけ驚きだ。" voices=""/>
		<msg @l="333" char_id="-1" frame_id="-1" name="渡部" text="『昨日‥‥何かあったのか？』"
		   voices=""/>
		<char @l="336" id="miho" pos="left" src="miho166"/>
		<msg @l="338" char_id="0" frame_id="-1" name="美帆"
		   text="『い、いえ‥‥何でもないんです‥‥‥。』" voices=""/>
		<char @l="341" id="miho" pos="left" src="miho060"/>
		<msg @l="343" char_id="0" frame_id="-1" name="美帆"
		   text="『それより、水泳勝負ってどうすればいいんですか？』" voices=""/>
		<msg @l="345" char_id="-1" frame_id="-1" name="留学生" text="『オウ！ＯＫデスカッ！？』"
		   voices=""/>
		<char @l="348" id="miho" pos="left" src="miho066"/>
		<msg @l="350" char_id="0" frame_id="-1" name="美帆" text="『え、ええ‥‥まあ。』"
		   voices=""/>
		<msg @l="352" char_id="-1" frame_id="-1" name=""
		   text="ここで彼の申し出を変に渋って、昨日の出来事についてアレコレ言い出されると困るし･･････。" voices=""/>
		<msg @l="353" char_id="-1" frame_id="-1" name=""
		   text="水泳勝負することで、昨日のことを綺麗さっぱりと水に流せるなら‥‥。" voices=""/>
		<msg @l="354" char_id="-1" frame_id="-1" name=""
		   text="経緯はともかくとして、それに越した事は無い。" voices=""/>
		<msg @l="355" char_id="-1" frame_id="-1" name="留学生"
		   text="『ルール、シンプルネ。ミートアナタデ、１００メータースイミング。ＯＫ？』" voices=""/>
		<msg @l="357" char_id="-1" frame_id="-1" name="留学生"
		   text="『ハヤク、ゴールスルガ、カチデス。』" voices=""/>
		<char @l="360" id="miho" pos="left" src="miho060"/>
		<msg @l="362" char_id="0" frame_id="-1" name="美帆"
		   text="『解りました‥‥１００メートルの自由形、ですね？』" voices=""/>
		<msg @l="364" char_id="-1" frame_id="-1" name="留学生" text="『イエス、イエース。』"
		   voices=""/>
		<char @l="367" id="akina" pos="right" src="akina060"/>
		<msg @l="369" char_id="2" frame_id="-1" name="亜季奈"
		   text="『何かよくわかんないけど････。そういうことなら私が審判しよっか？』" voices=""/>
		<msg @l="371" char_id="0" frame_id="-1" name="美帆" text="『うん、お願いしてもいい？』"
		   voices=""/>
		<msg @l="373" char_id="2" frame_id="-1" name="亜季奈" text="『おっけー。』" voices=""/>
		<char @l="376" id="akina" pos="right" src="akina062"/>
		<msg @l="378" char_id="2" frame_id="-1" name="亜季奈"
		   text="『実際、私も久しぶりにお姉ちゃんが本気で泳ぐとこ見たいし。』" voices=""/>
		<char @l="381" id="miho" pos="left" src="miho066"/>
		<msg @l="383" char_id="0" frame_id="-1" name="美帆" text="『もう‥‥。』" voices=""/>
		<char @l="386" id="watab" pos="right" src="watabe014"/>
		<msg @l="388" char_id="-1" frame_id="-1" name="渡部"
		   text="『練習時間は限られてるんだ‥‥手短にやってくれよ。』" voices=""/>
		<char @l="391" id="akina" pos="right" src="akina060"/>
		<msg @l="393" char_id="2" frame_id="-1" name="亜季奈" text="『は～い！』" voices=""/>
		<msg @l="395" char_id="-1" frame_id="-1" name="留学生" text="『シュァ！』" voices=""/>
		<msg @l="397" char_id="-1" frame_id="-1" name=""
		   text="渡部の言葉に、亜季奈と留学生が元気いっぱいに答える。" voices=""/>
		<msg @l="398" char_id="-1" frame_id="-1" name=""
		   text="いつの間にか当事者の私よりも亜季奈の方がその気になっているのが怖い。" voices=""/>
		<char @l="401" id="miho" pos="left" src="miho160"/>
		<msg @l="403" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="405" char_id="0" frame_id="-1" name="美帆" text="(水泳勝負か‥‥)" voices=""/>
		<msg @l="407" char_id="0" frame_id="-1" name="美帆"
		   text="(何事も無く終わってくれるといいけど‥‥)" voices=""/>
		<msg @l="409" char_id="-1" frame_id="-1" name=""
		   text="漠然と不安を感じて、私は小さなため息を吐いた。" voices=""/>
		<clear @l="412" class="all"/>
		<wait_chgmv/>
		<bg @l="415" src="bg10"/>
		<char @l="418" id="akina" pos="auto" src="akina060"/>
		<msg @l="420" char_id="2" frame_id="-1" name="亜季奈" text="『二人とも、準備はおっけーかな？』"
		   voices=""/>
		<msg @l="422" char_id="-1" frame_id="-1" name=""
		   text="飛び込み台の前に並んだ私と留学生の彼を交互に見て、亜季奈が問う。" voices=""/>
		<msg @l="423" char_id="-1" frame_id="-1" name=""
		   text="亜季奈は、首からヒモ付きホイッスル、両手にストップウォッチ、という準備万端な状態だ。" voices=""/>
		<char @l="426" id="miho" pos="auto" src="miho060"/>
		<msg @l="428" char_id="0" frame_id="-1" name="美帆" text="『う、うん‥‥大丈夫。』"
		   voices=""/>
		<msg @l="430" char_id="-1" frame_id="-1" name="留学生" text="『オーラーイッ。』"
		   voices=""/>
		<char @l="433" id="akina" pos="auto" src="akina060"/>
		<msg @l="435" char_id="2" frame_id="-1" name="亜季奈"
		   text="『二人とも飛び込み台の上に乗って～。』" voices=""/>
		<msg @l="437" char_id="2" frame_id="-1" name="亜季奈"
		   text="『スタートのホイッスルと同時に飛び込んでね。』" voices=""/>
		<msg @l="439" char_id="2" frame_id="-1" name="亜季奈"
		   text="『フライングとかゴールとか、細かい審査は私がやるから。』" voices=""/>
		<char @l="442" id="miho" pos="auto" src="miho060"/>
		<msg @l="444" char_id="0" frame_id="-1" name="美帆" text="『はい。』" voices=""/>
		<msg @l="446" char_id="-1" frame_id="-1" name="留学生" text="『オネガイシマース。』"
		   voices=""/>
		<char @l="449" id="akina" pos="auto" src="akina161"/>
		<msg @l="451" char_id="2" frame_id="-1" name="亜季奈" text="『よろしい。』" voices=""/>
		<msg @l="453" char_id="-1" frame_id="-1" name=""
		   text="亜季奈が頷き、ホイッスルの先端を口に咥えた。" voices=""/>
		<msg @l="454" char_id="-1" frame_id="-1" name=""
		   text="両手はストップウォッチのスタートボタンに添えられている。" voices=""/>
		<clear @l="457" class="char"/>
		<stopbgm @l="460" fadeout="1000"/>
		<msg @l="462" char_id="2" frame_id="-1" name="亜季奈" text="『ほへひゃ、いひひふいへ～。』"
		   voices=""/>
		<msg @l="464" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="466" char_id="-1" frame_id="-1" name="留学生" text="『‥‥‥‥。』" voices=""/>
		<msg @l="468" char_id="-1" frame_id="-1" name=""
		   text="私たちはそれぞれ自分のコースにある飛び込み台に立つ。" voices=""/>
		<msg @l="469" char_id="-1" frame_id="-1" name=""
		   text="飛び込み台の縁に足の指をかけ、ゆっくり‥‥前屈姿勢を取る。" voices=""/>
		<msg @l="470" char_id="-1" frame_id="-1" name=""
		   text="昔から何度も繰り返しているのに、どうしてもこの瞬間は緊張してしまう。" voices=""/>
		<msg @l="472" char_id="0" frame_id="-1" name="美帆"
		   text="(勝負するからには勝つつもりでがんばろう‥‥)" voices=""/>
		<msg @l="474" char_id="0" frame_id="-1" name="美帆"
		   text="(私にだって、経験者っていうプライドくらいはあるんだから)" voices=""/>
		<msg @l="476" char_id="-1" frame_id="-1" name=""
		   text="そうして私がわずかな決意を胸に抱いた、その瞬間――――。" voices=""/>
		<se @l="479" buf="1" src="ホイッスル（室内プール）" volume="1."/>
		<se @l="482" buf="1" src="飛び込む音" volume="1."/>
		<bgm @l="485" src="bgm17" volume="1."/>
		<msg @l="487" char_id="0" frame_id="-1" name="美帆" text="『‥‥！！』" voices=""/>
		<msg @l="489" char_id="-1" frame_id="-1" name=""
		   text="ホイッスルと同時に、私と留学生の彼はほぼ同時に飛び込んだ。" voices=""/>
		<msg @l="490" char_id="-1" frame_id="-1" name=""
		   text="一度水の中に入ってしまうと、周囲の世界から完全に隔絶される。" voices=""/>
		<msg @l="491" char_id="-1" frame_id="-1" name="" text="視界に広がっているのは一面の水。"
		   voices=""/>
		<msg @l="492" char_id="-1" frame_id="-1" name=""
		   text="聞こえるのは水の中をかき分け、進んでいく音。" voices=""/>
		<msg @l="493" char_id="-1" frame_id="-1" name="" text="そして‥‥鼓動がすぐ耳元で響いている。"
		   voices=""/>
		<msg @l="495" char_id="0" frame_id="-1" name="美帆" text="(まずは‥‥)" voices=""/>
		<msg @l="499" async="true" char_id="-1" frame_id="-1" name=""
		   text="飛び込み直後‥‥どうする？" voices=""/>
		<select @l="500">
			<menu @l="504" label="EventLabel_66" text="すぐに浮上して速攻をかける"/>
			<menu @l="507" label="EventLabel_67" text="しばらく潜水で進んで様子を見る"/>
		</select>
		<label @l="515" id="EventLabel_66"/>
		<msg @l="517" char_id="0" frame_id="-1" name="美帆" text="(すぐに浮上して速攻をかけよう‥‥！)"
		   voices=""/>
		<msg @l="519" char_id="-1" frame_id="-1" name=""
		   text="私は１０メートルも進まないうちに浮上して泳ぎ始める。" voices=""/>
		<msg @l="520" char_id="-1" frame_id="-1" name=""
		   text="幾ら過去に記録を持っていたことに慢心し、足元をすくわれるのは避けたい。" voices=""/>
		<goto @l="523" label="EventLabel_68"/>
		<label @l="527" id="EventLabel_67"/>
		<msg @l="529" char_id="0" frame_id="-1" name="美帆"
		   text="(そうね‥‥やっぱり基本通り、最初は飛び込みの力を殺さない程度に潜水して距離を稼ぎましょう)" voices=""/>
		<msg @l="531" char_id="-1" frame_id="-1" name=""
		   text="私は水中に潜ったまま、暫く様子を見ることにした。" voices=""/>
		<msg @l="532" char_id="-1" frame_id="-1" name=""
		   text="前半で無理をして無駄に体力を消耗すれば、こちらが不利になる。" voices=""/>
		<eval @l="535" expr="f.水泳勝負flag&#32;+=&#32;1&#13;&#10;"/>
		<label @l="539" id="EventLabel_68"/>
		<msg @l="541" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="543" char_id="-1" frame_id="-1" name=""
		   text="コースを半分ほど過ぎたあたりで、横一列に並んだ。" voices=""/>
		<msg @l="544" char_id="-1" frame_id="-1" name=""
		   text="普通、飛び込みから浮上までには身体的な能力差が出るものだが‥‥。" voices=""/>
		<msg @l="545" char_id="-1" frame_id="-1" name=""
		   text="脚力と瞬発力において、彼は余り優れてはいないみたいだ。" voices=""/>
		<msg @l="547" char_id="0" frame_id="-1" name="美帆" text="(さて‥‥勝負の本番はココから‥‥‥)"
		   voices=""/>
		<msg @l="549" char_id="0" frame_id="-1" name="美帆"
		   text="(昔を思い出して、自分の泳ぎをしなくちゃ)" voices=""/>
		<msg @l="551" char_id="0" frame_id="-1" name="美帆" text="(とりあえずフォームから‥‥‥)"
		   voices=""/>
		<msg @l="555" async="true" char_id="-1" frame_id="-1" name=""
		   text="泳ぎのフォームは‥‥？" voices=""/>
		<select @l="556">
			<menu @l="560" label="EventLabel_69" text="身体の力を抜いて腕を伸ばす"/>
			<menu @l="563" label="EventLabel_70" text="腕に力を込めて水を掻き分ける"/>
		</select>
		<label @l="571" id="EventLabel_69"/>
		<msg @l="573" char_id="0" frame_id="-1" name="美帆"
		   text="(腕の力を抜いて、しっかり伸ばして‥‥‥)" voices=""/>
		<msg @l="575" char_id="-1" frame_id="-1" name=""
		   text="余計な力を入れれば、反動で身体が沈み抵抗が増す。" voices=""/>
		<msg @l="576" char_id="-1" frame_id="-1" name="" text="結果、体力の消耗が早くなる。"
		   voices=""/>
		<msg @l="577" char_id="-1" frame_id="-1" name=""
		   text="水泳部を指導した時に言ったことを、自分に言い聞かせるよう、心の中で繰り返していた。" voices=""/>
		<msg @l="578" char_id="-1" frame_id="-1" name=""
		   text="変にあせってリキんでも‥‥力は発揮できない。" voices=""/>
		<msg @l="580" char_id="0" frame_id="-1" name="美帆" text="(これでペースが掴めるといいけど‥‥)"
		   voices=""/>
		<msg @l="582" char_id="-1" frame_id="-1" name=""
		   text="頭で理解していても、身体がついてくるかが問題だ。" voices=""/>
		<msg @l="583" char_id="-1" frame_id="-1" name="" text="三年というブランクは‥‥長い。"
		   voices=""/>
		<eval @l="586" expr="f.水泳勝負flag&#32;+=&#32;1&#13;&#10;"/>
		<goto @l="590" label="EventLabel_71"/>
		<label @l="593" id="EventLabel_70"/>
		<msg @l="595" char_id="0" frame_id="-1" name="美帆"
		   text="(ダメ‥‥早いうちに差をつけておかなきゃ‥‥‥)" voices=""/>
		<msg @l="597" char_id="-1" frame_id="-1" name=""
		   text="技術はともかく、根本的な体力差はやはり無視できない。" voices=""/>
		<msg @l="598" char_id="-1" frame_id="-1" name=""
		   text="そうなると後半で追い込まれてから慌てるよりも、前半で少しでも差を広げておきたいところだ。" voices=""/>
		<msg @l="599" char_id="-1" frame_id="-1" name="" text="けれど‥‥。" voices=""/>
		<msg @l="601" char_id="0" frame_id="-1" name="美帆"
		   text="(あれ‥‥‥思うように進んでくれない‥‥‥‥)" voices=""/>
		<msg @l="603" char_id="0" frame_id="-1" name="美帆"
		   text="(やっぱり、ブランクが長いのかな‥‥‥)" voices=""/>
		<msg @l="605" char_id="-1" frame_id="-1" name=""
		   text="力を込めて水をかいても思うように進まず、私の身体は大きく水の中に沈む。" voices=""/>
		<msg @l="606" char_id="-1" frame_id="-1" name=""
		   text="そうして水の中に沈むと当然ながら抵抗も大きくなって遅くなる。" voices=""/>
		<label @l="609" id="EventLabel_71"/>
		<msg @l="611" char_id="0" frame_id="-1" name="美帆" text="(ダメ‥‥並んだまま引き離せない)"
		   voices=""/>
		<msg @l="613" char_id="0" frame_id="-1" name="美帆" text="(意外と早い‥‥‥？)"
		   voices=""/>
		<msg @l="615" char_id="-1" frame_id="-1" name=""
		   text="ブレスの合間に隣のコースを伺うと、彼は食らいつくように私の位置からそう離れていない所にいた。" voices=""/>
		<msg @l="617" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="619" char_id="-1" frame_id="-1" name="" text="５０メートルの所でターンをする。"
		   voices=""/>
		<msg @l="620" char_id="-1" frame_id="-1" name=""
		   text="一瞬戸惑ったけれど‥‥身体が覚えているらしく、上手くいった。" voices=""/>
		<msg @l="621" char_id="-1" frame_id="-1" name=""
		   text="しかし、留学生の彼も私の少し後ろをぴったりと着いて来ている。" voices=""/>
		<msg @l="622" char_id="-1" frame_id="-1" name="" text="最後の５０メートル、ここからが正念場だ。"
		   voices=""/>
		<msg @l="626" async="true" char_id="-1" frame_id="-1" name=""
		   text="ラスト５０メートル‥‥どうする？" voices=""/>
		<select @l="627">
			<menu @l="631" label="EventLabel_72" text="ペースアップして相手を離す"/>
			<menu @l="634" label="EventLabel_73" text="あくまでもマイペースに泳ぐ"/>
		</select>
		<label @l="642" id="EventLabel_72"/>
		<msg @l="644" char_id="0" frame_id="-1" name="美帆"
		   text="(残り５０メートル‥‥一気に差をつけなくちゃ！)" voices=""/>
		<msg @l="646" char_id="-1" frame_id="-1" name=""
		   text="私はスパートをかけ、隣コースを泳いでいる留学生を一気に引き離そうとする。" voices=""/>
		<msg @l="647" char_id="-1" frame_id="-1" name=""
		   text="とはいえ、相手もスパートをかけているので最終的には体力勝負になる。" voices=""/>
		<msg @l="648" char_id="-1" frame_id="-1" name=""
		   text="このまま体力勝負を５０メートルかけ続けるとなると‥‥少々分が悪い。" voices=""/>
		<goto @l="651" label="EventLabel_74"/>
		<label @l="654" id="EventLabel_73"/>
		<msg @l="656" char_id="0" frame_id="-1" name="美帆"
		   text="(体力勝負では負けてしまう‥‥あくまでマイペースに、冷静に)" voices=""/>
		<msg @l="658" char_id="-1" frame_id="-1" name=""
		   text="何度も自分に言い聞かせながら、焦る気持ちを押さえ込む。" voices=""/>
		<msg @l="659" char_id="-1" frame_id="-1" name=""
		   text="無理にペースを上げたとしても体力が持たない。" voices=""/>
		<msg @l="660" char_id="-1" frame_id="-1" name="" text="だったら自分の泳ぎを続けるだけだ。"
		   voices=""/>
		<eval @l="663" expr="f.水泳勝負flag&#32;+=&#32;1&#13;&#10;"/>
		<label @l="667" id="EventLabel_74"/>
		<msg @l="669" char_id="-1" frame_id="-1" name="留学生" text="『‥‥‥‥。』" voices=""/>
		<msg @l="671" char_id="-1" frame_id="-1" name="" text="留学生の彼が‥‥わずかに前に出た。"
		   voices=""/>
		<msg @l="672" char_id="-1" frame_id="-1" name="" text="ラストスパートをかけたのだろう。"
		   voices=""/>
		<goto @l="675" cond="!(f.水泳勝負flag&#32;&gt;=&#32;2)&#13;&#10;"
		   label="TempLabel_215"/>
		<msg @l="677" char_id="0" frame_id="-1" name="美帆"
		   text="(大丈夫‥‥あのペースアップは、続かない)" voices=""/>
		<msg @l="679" char_id="-1" frame_id="-1" name="" text="私は確信を胸に泳ぎ続ける。"
		   voices=""/>
		<msg @l="680" char_id="-1" frame_id="-1" name=""
		   text="自分を信じ、あせらない事が昔のフォームを忠実に再現してくれているような気がした。" voices=""/>
		<msg @l="682" char_id="0" frame_id="-1" name="美帆" text="『はっ‥‥はっ‥‥はっ‥‥‥。』"
		   voices=""/>
		<msg @l="684" char_id="-1" frame_id="-1" name="" text="一定間隔で刻まれる自分の呼吸が心地よい。"
		   voices=""/>
		<msg @l="686" char_id="0" frame_id="-1" name="美帆" text="(大丈夫‥‥)" voices=""/>
		<msg @l="688" char_id="-1" frame_id="-1" name=""
		   text="もう一度、私は自分に言い聞かせるように心でささやく。" voices=""/>
		<msg @l="689" char_id="-1" frame_id="-1" name="" text="負ける気は、不思議としなかった。"
		   voices=""/>
		<msg @l="690" char_id="-1" frame_id="-1" name=""
		   text="残り４０メートル、３０メートル、２０メートル‥‥。" voices=""/>
		<msg @l="691" char_id="-1" frame_id="-1" name=""
		   text="そうして残り１５メートルという所で、変化は訪れた。" voices=""/>
		<msg @l="693" char_id="-1" frame_id="-1" name="留学生" text="『‥‥ッ‥‥。』"
		   voices=""/>
		<msg @l="695" char_id="-1" frame_id="-1" name=""
		   text="隣を泳ぐ留学生のペースが見るからに落ちた。" voices=""/>
		<msg @l="696" char_id="-1" frame_id="-1" name=""
		   text="足をつったか、それとも疲労が限界に達したのだろうか。" voices=""/>
		<msg @l="697" char_id="-1" frame_id="-1" name=""
		   text="わずかな差はあっという間に縮まり、そして･･････。" voices=""/>
		<se @l="700" buf="1" src="ホイッスル（室内プール）" volume="1."/>
		<msg @l="702" char_id="-1" frame_id="-1" name="" text="ピーーーーーーーーーーーーーーー！！"
		   voices=""/>
		<msg @l="703" char_id="-1" frame_id="-1" name="" text="ホイッスルが高らかに鳴らされる。"
		   voices=""/>
		<stopbgm @l="706" fadeout="1000"/>
		<char @l="709" id="akina" pos="auto" src="akina060"/>
		<msg @l="711" char_id="2" frame_id="-1" name="亜季奈" text="『１着、お姉ちゃんっ！！』"
		   voices=""/>
		<msg @l="713" char_id="-1" frame_id="-1" name="" text="プールサイドから亜季奈の声がする。"
		   voices=""/>
		<msg @l="714" char_id="-1" frame_id="-1" name=""
		   text="私はそれを聞きながら、天井を見つめ‥‥目を細めた。" voices=""/>
		<msg @l="716" char_id="-1" frame_id="-1" name="留学生" text="『ガッデーム！！』"
		   voices=""/>
		<msg @l="718" char_id="-1" frame_id="-1" name=""
		   text="隣のコースでは、留学生の彼がいつまでも悔しそうな声を上げていた。" voices=""/>
		<clear @l="722" class="all"/>
		<wait_chgmv/>
		<bg @l="725" src="bg10m1"/>
		<bgm @l="728" src="bgm06" volume="1."/>
		<char @l="731" id="akina" pos="auto" src="akina061"/>
		<msg @l="733" char_id="2" frame_id="-1" name="亜季奈" text="『お姉ちゃん、やったね♪』"
		   voices=""/>
		<msg @l="735" char_id="-1" frame_id="-1" name=""
		   text="コースからプールサイドにあがると、出迎えた亜季奈がそう言ってぶいサインをしてみせる。" voices=""/>
		<clear @l="738" class="char"/>
		<char @l="740" id="akina" pos="left" src="akina061"/>
		<char @l="742" id="miho" pos="right" src="miho060"/>
		<msg @l="744" char_id="0" frame_id="-1" name="美帆"
		   text="『偶然だよ。久しぶりだからかなり戸惑っちゃったし。』" voices=""/>
		<msg @l="746" char_id="2" frame_id="-1" name="亜季奈"
		   text="『またまた～、最後の１５メートルなんてすごかったもん。』" voices=""/>
		<char @l="749" id="akina" pos="left" src="akina062"/>
		<msg @l="751" char_id="2" frame_id="-1" name="亜季奈"
		   text="『これでブランク３年だっていうんだから、まさしく天才ですな。』" voices=""/>
		<msg @l="753" char_id="0" frame_id="-1" name="美帆"
		   text="『もう、おだてたって何も出ないんだからね。』" voices=""/>
		<char @l="756" id="akina" pos="left" src="akina161"/>
		<msg @l="758" char_id="2" frame_id="-1" name="亜季奈" text="『ちぇ、バレたか。』"
		   voices=""/>
		<char @l="761" id="miho" pos="right" src="miho061"/>
		<msg @l="763" char_id="0" frame_id="-1" name="美帆" text="『あたりまえです。』"
		   voices=""/>
		<char @l="766" id="akina" pos="left" src="akina060"/>
		<msg @l="768" char_id="-1" frame_id="-1" name="留学生" text="『‥‥‥‥。』" voices=""/>
		<char @l="771" id="miho" pos="right" src="miho060"/>
		<msg @l="773" char_id="0" frame_id="-1" name="美帆" text="『うぁ、えっと‥‥‥どうも。』"
		   voices=""/>
		<msg @l="775" char_id="-1" frame_id="-1" name=""
		   text="気づけば‥‥留学生の彼もプールサイドへとあがってきていた。" voices=""/>
		<msg @l="776" char_id="-1" frame_id="-1" name=""
		   text="浮かない顔をしている所をみると、負けるとは思っていなかったのだろう。" voices=""/>
		<msg @l="778" char_id="-1" frame_id="-1" name="留学生" text="『‥‥ワタシノ、カンパイデース。』"
		   voices=""/>
		<msg @l="780" char_id="-1" frame_id="-1" name="留学生"
		   text="『‥‥ユーノコトハ、アキラメマース。』" voices=""/>
		<char @l="783" id="miho" pos="right" src="miho066"/>
		<msg @l="785" char_id="0" frame_id="-1" name="美帆" text="『は、はあ‥‥。』" voices=""/>
		<msg @l="787" char_id="-1" frame_id="-1" name=""
		   text="そう言って、留学生の彼はトボトボと肩を落として歩いていく。" voices=""/>
		<char @l="790" id="akina" pos="left" src="akina060"/>
		<msg @l="792" char_id="2" frame_id="-1" name="亜季奈" text="『‥‥‥‥。』" voices=""/>
		<msg @l="794" char_id="2" frame_id="-1" name="亜季奈" text="『なんなの、あれ？』"
		   voices=""/>
		<char @l="797" id="miho" pos="right" src="miho060"/>
		<msg @l="799" char_id="0" frame_id="-1" name="美帆" text="『さ、さあ‥‥？』" voices=""/>
		<stopbgm @l="802" fadeout="1000"/>
		<clear @l="805" class="all"/>
		<msgshow @l="807" show="true"/>
		<goto @l="810" label="EventLabel_75"/>
		<label @l="812" id="TempLabel_215"/>
		<msg @l="815" char_id="0" frame_id="-1" name="美帆" text="(このままだと、追いつけない‥‥！？)"
		   voices=""/>
		<msg @l="817" char_id="-1" frame_id="-1" name="" text="唐突に私を焦りが襲う。"
		   voices=""/>
		<msg @l="818" char_id="-1" frame_id="-1" name=""
		   text="いくらブランクがあっても、こんな水泳勝負で負けるはずないのに。" voices=""/>
		<msg @l="820" char_id="0" frame_id="-1" name="美帆"
		   text="(あと３０メートルある‥‥これならっ！)" voices=""/>
		<msg @l="822" char_id="-1" frame_id="-1" name="" text="私は、腕のストロークを早めた。"
		   voices=""/>
		<msg @l="823" char_id="-1" frame_id="-1" name="" text="距離的にはまだ十分に追い抜ける。"
		   voices=""/>
		<msg @l="825" char_id="-1" frame_id="-1" name="留学生" text="『‥‥ッ‥‥。』"
		   voices=""/>
		<msg @l="827" char_id="-1" frame_id="-1" name=""
		   text="残り１５メートルというところで、急に彼のペースが落ちた。" voices=""/>
		<msg @l="828" char_id="-1" frame_id="-1" name="" text="私は思わず勝利を確信する。"
		   voices=""/>
		<msg @l="829" char_id="-1" frame_id="-1" name="" text="瞬間――――。" voices=""/>
		<msg @l="831" char_id="0" frame_id="-1" name="美帆" text="(え‥‥‥)" voices=""/>
		<msg @l="833" char_id="-1" frame_id="-1" name="" text="急に‥‥足が動かなくなった。"
		   voices=""/>
		<msg @l="834" char_id="-1" frame_id="-1" name=""
		   text="麻痺したように感覚が無くなった後、電気ショックでも与えられたかのような鋭い痛みがふくらはぎの辺りを駆け抜けていく。"
		   voices=""/>
		<msg @l="836" char_id="0" frame_id="-1" name="美帆" text="(つった‥‥！？)" voices=""/>
		<msg @l="838" char_id="-1" frame_id="-1" name="" text="急なスパートが原因だろうか。"
		   voices=""/>
		<msg @l="839" char_id="-1" frame_id="-1" name=""
		   text="それとも準備運動が十分に足りていなかったのか‥‥。" voices=""/>
		<msg @l="841" char_id="0" frame_id="-1" name="美帆"
		   text="(でも、あと１０メートルくらいならっ‥‥)" voices=""/>
		<msg @l="843" char_id="-1" frame_id="-1" name=""
		   text="この痛みを数秒我慢して進めばそれで済む距離である。" voices=""/>
		<msg @l="844" char_id="-1" frame_id="-1" name="" text="そうすれば勝てるかもしれない。"
		   voices=""/>
		<msg @l="845" char_id="-1" frame_id="-1" name="" text="‥‥その判断が間違っていた。"
		   voices=""/>
		<clear @l="848" class="all"/>
		<msg @l="850" char_id="0" frame_id="-1" name="美帆" text="(ダメ、沈むっ‥‥！？)"
		   voices=""/>
		<msg @l="852" char_id="-1" frame_id="-1" name=""
		   text="つった足をかばうように両腕だけで前に進もうとした結果、私は派手に姿勢を崩して沈んでしまう。" voices=""/>
		<msg @l="854" char_id="0" frame_id="-1" name="美帆"
		   text="(こんな‥‥‥ゴールは目の前なのにっ‥‥‥‥)" voices=""/>
		<msg @l="856" char_id="-1" frame_id="-1" name="" text="私は必死に水をかいて浮き上がろうとする。"
		   voices=""/>
		<msg @l="857" char_id="-1" frame_id="-1" name=""
		   text="けれどそんな私の努力とは裏腹に、もがけばもがくほど身体は沈んでいく。" voices=""/>
		<msg @l="858" char_id="-1" frame_id="-1" name="" text="息苦しい。" voices=""/>
		<msg @l="859" char_id="-1" frame_id="-1" name="" text="身体が酷く重い。" voices=""/>
		<msg @l="860" char_id="-1" frame_id="-1" name="" text="意識が‥‥遠くなっていく。"
		   voices=""/>
		<msg @l="862" char_id="0" frame_id="-1" name="美帆"
		   text="(わたし‥‥‥何でこんな事してるのかな‥‥‥‥)" voices=""/>
		<msg @l="864" char_id="-1" frame_id="-1" name=""
		   text="ゴーグル越しにゆらゆらと揺れる水面を見ていた私の意識は、ゆっくりと闇に落ちていった‥‥。" voices=""/>
		<stopbgm @l="867" fadeout="1000"/>
		<clear @l="870" class="all"/>
		<msgshow @l="873" show="true"/>
		<wait_chgmv/>
		<bg @l="876" src="bg10"/>
		<bgm @l="879" src="bgm03" volume="1."/>
		<msg @l="881" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="883" char_id="-1" frame_id="-1" name=""
		   text="プールサイドに、意識を失った美帆の身体が横たえられる。" voices=""/>
		<msg @l="884" char_id="-1" frame_id="-1" name=""
		   text="完全に気を失っているらしく、ぐったりとして動かない。" voices=""/>
		<msg @l="885" char_id="-1" frame_id="-1" name="" text="美帆のそばには‥‥渡部が付き添っていた。"
		   voices=""/>
		<char @l="888" id="akina" pos="auto" src="akina064"/>
		<msg @l="890" char_id="2" frame_id="-1" name="亜季奈" text="『お姉ちゃん、お姉ちゃんっ‥‥！？』"
		   voices=""/>
		<msg @l="892" char_id="-1" frame_id="-1" name="" text="人垣を押しのけて、亜季奈が駆け寄る。"
		   voices=""/>
		<char @l="895" id="akina" pos="auto" src="akina065"/>
		<msg @l="897" char_id="2" frame_id="-1" name="亜季奈"
		   text="『渡部センセイ‥‥お姉ちゃんは大丈夫なんですかっ！？』" voices=""/>
		<clear @l="900" class="char"/>
		<char @l="902" id="akina" pos="left" src="akina065"/>
		<char @l="904" id="watab" pos="right" src="watabe014"/>
		<msg @l="906" char_id="-1" frame_id="-1" name="渡部"
		   text="『足をつってるな‥‥現役でもないのに無理するからだ。』" voices=""/>
		<char @l="909" id="akina" pos="left" src="akina165"/>
		<msg @l="911" char_id="2" frame_id="-1" name="亜季奈"
		   text="『そんなことより、お姉ちゃんの容態はどうなんですかっ。』" voices=""/>
		<msg @l="913" char_id="-1" frame_id="-1" name="渡部" text="『ああ、そうだったそうだった。』"
		   voices=""/>
		<msg @l="915" char_id="-1" frame_id="-1" name="渡部"
		   text="『ふむ‥‥少し水を飲んでるみたいだな。』" voices=""/>
		<msg @l="917" char_id="-1" frame_id="-1" name="渡部"
		   text="『呼吸が弱い、肺に水が入っている可能性がある。』" voices=""/>
		<msg @l="919" char_id="2" frame_id="-1" name="亜季奈" text="『それって、危ないんですか‥‥？』"
		   voices=""/>
		<char @l="922" id="watab" pos="right" src="watabe014"/>
		<msg @l="924" char_id="-1" frame_id="-1" name="渡部"
		   text="『肺に水が入っているとすると、危険だな。』" voices=""/>
		<char @l="927" id="akina" pos="left" src="akina064"/>
		<msg @l="929" char_id="2" frame_id="-1" name="亜季奈" text="『そんなっ‥‥。』"
		   voices=""/>
		<msg @l="931" char_id="-1" frame_id="-1" name="渡部"
		   text="『そうだな‥‥これから仲根を更衣室へ運んで人工呼吸と人工マッサージをしてみる。』" voices=""/>
		<char @l="934" id="watab" pos="right" src="watabe014"/>
		<msg @l="936" char_id="-1" frame_id="-1" name="渡部"
		   text="『俺が指示するヤツ以外は全員練習に戻っていいぞ。』" voices=""/>
		<char @l="939" id="akina" pos="left" src="akina164"/>
		<msg @l="941" char_id="2" frame_id="-1" name="亜季奈" text="『わ、私も行きますっ。』"
		   voices=""/>
		<msg @l="943" char_id="-1" frame_id="-1" name="渡部" text="『オマエはダメだ。』"
		   voices=""/>
		<char @l="946" id="akina" pos="left" src="akina065"/>
		<msg @l="948" char_id="2" frame_id="-1" name="亜季奈" text="『どうしてですかっ！？』"
		   voices=""/>
		<msg @l="950" char_id="-1" frame_id="-1" name="渡部"
		   text="『肉親が応急処置の近くにいると落ち着いて対処できないだろ。』" voices=""/>
		<char @l="953" id="akina" pos="left" src="akina165"/>
		<msg @l="955" char_id="2" frame_id="-1" name="亜季奈" text="『‥‥‥‥。』" voices=""/>
		<char @l="958" id="watab" pos="right" src="watabe010"/>
		<msg @l="960" char_id="-1" frame_id="-1" name="渡部"
		   text="『心配するな、俺がオマエのお姉ちゃんを助けてやる。』" voices=""/>
		<msg @l="962" char_id="2" frame_id="-1" name="亜季奈" text="『‥‥はい。』" voices=""/>
		<msg @l="964" char_id="-1" frame_id="-1" name="渡部"
		   text="『そら、解ったらとっとと練習に戻れ。』" voices=""/>
		<msg @l="966" char_id="2" frame_id="-1" name="亜季奈" text="『わ、わかりました‥‥。』"
		   voices=""/>
		<char @l="969" id="akina" pos="auto" src="akina065"/>
		<msg @l="971" char_id="2" frame_id="-1" name="亜季奈"
		   text="『お姉ちゃん‥‥絶対に死んじゃダメだからねっ！！』" voices=""/>
		<msg @l="973" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<clear @l="976" class="char"/>
		<char @l="978" id="watab" pos="auto" src="watabe014"/>
		<msg @l="980" char_id="-1" frame_id="-1" name="渡部"
		   text="『よーし、それじゃあオマエとオマエだけ運ぶの手伝ってくれ。』" voices=""/>
		<msg @l="982" char_id="-1" frame_id="-1" name="留学生" text="『ワタシ、テツダウ。』"
		   voices=""/>
		<msg @l="984" char_id="-1" frame_id="-1" name=""
		   text="そう言って、黒人留学生が人垣から一歩前に出る。" voices=""/>
		<msg @l="985" char_id="-1" frame_id="-1" name=""
		   text="多少なりと‥‥責任を感じているのだろうか。" voices=""/>
		<msg @l="987" char_id="-1" frame_id="-1" name="渡部" text="『ふん‥‥まあいいだろう。』"
		   voices=""/>
		<msg @l="989" char_id="-1" frame_id="-1" name="渡部"
		   text="『それじゃあ、他のヤツは練習に戻っていいぞ。』" voices=""/>
		<msg @l="991" char_id="-1" frame_id="-1" name="水泳部の子たち" text="『わかりました‥‥。』"
		   voices=""/>
		<msg @l="993" char_id="-1" frame_id="-1" name=""
		   text="数名の水泳部員と渡部は室内プールからでて更衣室へ美帆を運んでいった。" voices=""/>
		<msg @l="994" char_id="-1" frame_id="-1" name=""
		   text="残された水泳サークルの人間たちは、黙ってそれを見送った。" voices=""/>
		<stopbgm @l="997" fadeout="1000"/>
		<msg @l="998" char_id="-1" frame_id="-1" name=""
		   text="溺れたのが美帆でなかったなら、亜季奈は渡部の言っていることがデタラメだということに気付いていただろう。" voices=""/>
		<msg @l="999" char_id="-1" frame_id="-1" name=""
		   text="弱いながらも息をしている美帆に人工呼吸は必要ではないし、そもそも人工マッサージなどという言葉はない。" voices=""/>
		<msg @l="1000" char_id="-1" frame_id="-1" name=""
		   text="肺に水が入ったとしても、少量ならば死には至らない。" voices=""/>
		<msg @l="1001" char_id="-1" frame_id="-1" name=""
		   text="適当な言葉で、一番邪魔な亜季奈は呈よく追い払われてしまったのだ。" voices=""/>
		<msg @l="1003" char_id="-1" frame_id="-1" name=""
		   text="そして、一人も女性の部員が手伝いに選ばれていないことには、誰も気付かなかった。" voices=""/>
		<clear @l="1006" class="all"/>
		<label @l="1009" id="event_scene24"/>
		<label @l="1012" id="chart_line14"/>
		<wait_chgmv/>
		<ev @l="1015" src="ev-024"/>
		<description @l="1018" text="混濁の陵辱"/>
		<bgm @l="1021" src="bgm15" volume="1."/>
		<msg @l="1023" char_id="-1" frame_id="-1" name="渡部" text="『さて、と。』" voices=""/>
		<msg @l="1025" char_id="-1" frame_id="-1" name=""
		   text="更衣室につくと、渡部は品定めをするように美帆の身体を見る。" voices=""/>
		<msg @l="1026" char_id="-1" frame_id="-1" name="" text="その口元には歪んだ笑みが浮かんでいる。"
		   voices=""/>
		<msg @l="1028" char_id="-1" frame_id="-1" name="水泳部の子Ａ"
		   text="『あの、センセイ‥‥俺たちどうすればいいんですか？』" voices=""/>
		<msg @l="1030" char_id="-1" frame_id="-1" name="水泳部の子Ｂ"
		   text="『応急処置なんて、やったことないですけど‥‥。』" voices=""/>
		<msg @l="1032" char_id="-1" frame_id="-1" name="留学生" text="『オォ‥‥ミホサーン‥‥。』"
		   voices=""/>
		<msg @l="1034" char_id="-1" frame_id="-1" name="渡部"
		   text="『ぷっ‥‥あははははっ、なんだ、お前らも信じたのか。』" voices=""/>
		<msg @l="1036" char_id="-1" frame_id="-1" name="水泳部の子Ａ" text="『え‥‥。』"
		   voices=""/>
		<msg @l="1038" char_id="-1" frame_id="-1" name="水泳部の子Ｂ"
		   text="『信じたって‥‥な、何がですか？』" voices=""/>
		<msg @l="1040" char_id="-1" frame_id="-1" name="渡部" text="『さっき俺が言ったコトを、だよ。』"
		   voices=""/>
		<msg @l="1042" char_id="-1" frame_id="-1" name="留学生" text="『‥‥？』" voices=""/>
		<msg @l="1044" char_id="-1" frame_id="-1" name="渡部" text="『ニブいやつらだな。』"
		   voices=""/>
		<msg @l="1046" char_id="-1" frame_id="-1" name="渡部"
		   text="『コイツは別に、俺がさっき言ったのは、全部デタラメってコトだ。』" voices=""/>
		<msg @l="1048" char_id="-1" frame_id="-1" name="水泳部の子Ｂ"
		   text="『え‥‥それじゃあ、なんで･･････』" voices=""/>
		<msg @l="1050" char_id="-1" frame_id="-1" name="渡部"
		   text="『あのな、こんないい女が目の前にいるんだぞ？』" voices=""/>
		<msg @l="1052" char_id="-1" frame_id="-1" name="渡部"
		   text="『チャンスだとは思わないのか‥‥男として。』" voices=""/>
		<msg @l="1054" char_id="-1" frame_id="-1" name="水泳部の子Ａ" text="『え、でもそれって‥‥。』"
		   voices=""/>
		<msg @l="1056" char_id="-1" frame_id="-1" name="水泳部の子Ｂ"
		   text="『犯罪‥‥じゃないッスか。』" voices=""/>
		<msg @l="1058" char_id="-1" frame_id="-1" name="渡部"
		   text="『心配するな‥‥ちょっとしたイタズラだ、大したことは無いさ。』" voices=""/>
		<msg @l="1060" char_id="-1" frame_id="-1" name="渡部"
		   text="『それに主犯格は俺だ。オマエたちは黙って俺の手伝いをしてくれりゃオイシイ思いもできるって訳だ。』" voices=""/>
		<msg @l="1062" char_id="-1" frame_id="-1" name="水泳部の子Ａ" text="『‥‥‥‥。』"
		   voices=""/>
		<msg @l="1064" char_id="-1" frame_id="-1" name="水泳部の子Ｂ" text="『‥‥‥‥。』"
		   voices=""/>
		<msg @l="1066" char_id="-1" frame_id="-1" name="渡部"
		   text="『迷ってるってツラだな‥‥だが、これを見ても迷ってられるか？』" voices=""/>
		<wait_chgmv/>
		<ev @l="1069" src="ev-024_1"/>
		<msg @l="1071" char_id="-1" frame_id="-1" name="水泳部の子Ａ" text="『おおおおおっ！？』"
		   voices=""/>
		<msg @l="1073" char_id="-1" frame_id="-1" name="水泳部の子Ｂ"
		   text="『す、すげぇ‥‥生乳だっ！』" voices=""/>
		<msg @l="1075" char_id="-1" frame_id="-1" name="留学生"
		   text="『オウ、ベリーベリープリティー。』" voices=""/>
		<msg @l="1077" char_id="-1" frame_id="-1" name="渡部" text="『どうだ、やる気になったか？』"
		   voices=""/>
		<msg @l="1079" char_id="-1" frame_id="-1" name="水泳部の子Ａ"
		   text="『それは‥‥でも、どうして俺たちなんスか？』" voices=""/>
		<msg @l="1081" char_id="-1" frame_id="-1" name="水泳部の子Ｂ"
		   text="『そ、そうですよ‥‥俺たちだけなんて‥‥‥‥。』" voices=""/>
		<msg @l="1083" char_id="-1" frame_id="-1" name="渡部"
		   text="『そりゃ、オマエらが練習中にこの女をチラチラ見てたからだよ。』" voices=""/>
		<msg @l="1085" char_id="-1" frame_id="-1" name="渡部"
		   text="『毎日、宿舎の便所でこの女をオカズにしてセンズリぶっこいてたんだろ？』" voices=""/>
		<msg @l="1087" char_id="-1" frame_id="-1" name="水泳部の子Ａ"
		   text="『そ、それは‥‥その‥‥‥。』" voices=""/>
		<msg @l="1089" char_id="-1" frame_id="-1" name="水泳部の子Ｂ"
		   text="『否定は‥‥しませんけど。』" voices=""/>
		<msg @l="1091" char_id="-1" frame_id="-1" name="渡部" text="『なら、迷う事なんてないだろ。』"
		   voices=""/>
		<msg @l="1093" char_id="-1" frame_id="-1" name="渡部" text="『遠慮せず‥‥触っていいんだぞ？』"
		   voices=""/>
		<msg @l="1095" char_id="-1" frame_id="-1" name="水泳部の子Ａ" text="『‥‥‥‥。』"
		   voices=""/>
		<msg @l="1097" char_id="-1" frame_id="-1" name="水泳部の子Ｂ" text="『‥‥‥‥。』"
		   voices=""/>
		<msg @l="1099" char_id="-1" frame_id="-1" name="渡部"
		   text="『もちろん、胸だけじゃなくてこっちもだ。』" voices=""/>
		<msg @l="1101" char_id="-1" frame_id="-1" name=""
		   text="渡部はそう言って水着の股間部分をつまみ、少しだけずらして見せる。" voices=""/>
		<wait_chgmv/>
		<ev @l="1104" src="ev-024_2"/>
		<msg @l="1106" char_id="-1" frame_id="-1" name="水泳部の子Ａ" text="『うおっ！！』"
		   voices=""/>
		<msg @l="1108" char_id="-1" frame_id="-1" name="水泳部の子Ｂ"
		   text="『な、ななっ‥‥生マ○コっ‥‥‥。』" voices=""/>
		<msg @l="1110" char_id="-1" frame_id="-1" name="留学生"
		   text="『オォウッ、ジャパニーズプッシー。』" voices=""/>
		<wait_chgmv/>
		<ev @l="1113" src="ev-024_1"/>
		<msg @l="1115" char_id="-1" frame_id="-1" name="渡部"
		   text="『そら、どうだ‥‥俺の言うことを聞くなら好きにしていいぞ？』" voices=""/>
		<msg @l="1117" char_id="-1" frame_id="-1" name="水泳部の子Ａ"
		   text="『き、聞きますっ‥‥何でも！』" voices=""/>
		<msg @l="1119" char_id="-1" frame_id="-1" name="水泳部の子Ｂ"
		   text="『お‥‥俺も、聞きますよっ。』" voices=""/>
		<msg @l="1121" char_id="-1" frame_id="-1" name="留学生" text="『オーケー、ワカタヨ。』"
		   voices=""/>
		<clear @l="1124" class="all"/>
		<wait_chgmv/>
		<bg @l="1127" src="bg11"/>
		<char @l="1130" id="watab" pos="auto" src="watabe010"/>
		<msg @l="1132" char_id="-1" frame_id="-1" name="渡部" text="『商談成立だな。』"
		   voices=""/>
		<msg @l="1134" char_id="-1" frame_id="-1" name="渡部"
		   text="『それじゃあたっぷりイジメてやっててくれ。』" voices=""/>
		<msg @l="1136" char_id="-1" frame_id="-1" name="水泳部の子Ａ" text="『え‥‥センセイは？』"
		   voices=""/>
		<msg @l="1138" char_id="-1" frame_id="-1" name="水泳部の子Ｂ"
		   text="『一緒に、やらないんですか？』" voices=""/>
		<char @l="1141" id="watab" pos="auto" src="watabe012"/>
		<msg @l="1142" char_id="-1" frame_id="-1" name="渡部"
		   text="『俺はちょっと野暮用があってな‥‥。』" voices=""/>
		<char @l="1145" id="watab" pos="auto" src="watabe014"/>
		<msg @l="1147" char_id="-1" frame_id="-1" name="渡部"
		   text="『それから、触ろうが何しようが構わないが絶対に本番だけはするんじゃないぞ。』" voices=""/>
		<msg @l="1149" char_id="-1" frame_id="-1" name="留学生" text="『ホンバン？』"
		   voices=""/>
		<msg @l="1151" char_id="-1" frame_id="-1" name="渡部" text="『セックスはするなってことだ。』"
		   voices=""/>
		<msg @l="1153" char_id="-1" frame_id="-1" name="留学生" text="『オゥ、ノーッ！』"
		   voices=""/>
		<msg @l="1155" char_id="-1" frame_id="-1" name="渡部"
		   text="『約束さえ守ってりゃ、後でちゃんと本番までやらせてやる。』" voices=""/>
		<char @l="1158" id="watab" pos="auto" src="watabe010"/>
		<msg @l="1160" char_id="-1" frame_id="-1" name="渡部" text="『わかったな？』"
		   voices=""/>
		<msg @l="1162" char_id="-1" frame_id="-1" name="留学生" text="『‥‥イエッサー。』"
		   voices=""/>
		<msg @l="1164" char_id="-1" frame_id="-1" name="渡部"
		   text="『それじゃ‥‥せいぜい、騒がれないようにやれよ。』" voices=""/>
		<clear @l="1167" class="char"/>
		<msg @l="1169" char_id="-1" frame_id="-1" name="" text="そう言って、渡部は更衣室を出て行く。"
		   voices=""/>
		<msg @l="1171" char_id="-1" frame_id="-1" name="水泳部の子Ａ"
		   text="『センセイ‥‥何しに行ったんだろうな？』" voices=""/>
		<msg @l="1173" char_id="-1" frame_id="-1" name="水泳部の子Ｂ"
		   text="『そんなこと、どうでもいいって。』" voices=""/>
		<msg @l="1175" char_id="-1" frame_id="-1" name="留学生" text="『ソウデース。』"
		   voices=""/>
		<msg @l="1177" char_id="-1" frame_id="-1" name="水泳部の子Ａ" text="『お、おう‥‥！』"
		   voices=""/>
		<clear @l="1180" class="all"/>
		<wait_chgmv/>
		<ev @l="1183" src="ev-024_1"/>
		<msg @l="1185" char_id="-1" frame_id="-1" name="水泳部の子Ａ"
		   text="『い、いいか‥‥それじゃあ下も外すぞ？』" voices=""/>
		<msg @l="1187" char_id="-1" frame_id="-1" name="水泳部の子Ｂ"
		   text="『もったいぶるなって‥‥急がないと、いつ目を覚ますかわかんないじゃんか。』" voices=""/>
		<msg @l="1189" char_id="-1" frame_id="-1" name="留学生" text="『ヘーイ、ハリアーップ。』"
		   voices=""/>
		<msg @l="1191" char_id="-1" frame_id="-1" name=""
		   text="留学生はそう言って、何の躊躇いもなく水着を脱がせていく。" voices=""/>
		<msg @l="1192" char_id="-1" frame_id="-1" name=""
		   text="一同の前に‥‥美帆のあられもない姿が惜しげもなく晒された。" voices=""/>
		<wait_chgmv/>
		<ev @l="1195" src="ev-024_2"/>
		<msg @l="1197" char_id="-1" frame_id="-1" name="留学生"
		   text="『オーウ、ミホサンノヌード、ベリーキュートアンドセクシー！』" voices=""/>
		<msg @l="1199" char_id="-1" frame_id="-1" name="水泳部の子Ａ" text="『‥‥‥‥。』"
		   voices=""/>
		<msg @l="1201" char_id="-1" frame_id="-1" name="水泳部の子Ｂ" text="『‥‥‥‥。』"
		   voices=""/>
		<msg @l="1203" char_id="-1" frame_id="-1" name="水泳部の子Ａ"
		   text="『も、もうがまんできねー！』" voices=""/>
		<msg @l="1205" char_id="-1" frame_id="-1" name="水泳部の子Ｂ"
		   text="『どうなったって知るかっ！』" voices=""/>
		<stopbgm @l="1208" fadeout="1000"/>
		<clear @l="1211" class="all"/>
		<msgshow @l="1213" show="true"/>
		<wait_chgmv/>
		<ev @l="1216" src="ev-024_3"/>
		<bgm @l="1219" src="bgm14" volume="1."/>
		<msg @l="1221" char_id="0" frame_id="-1" name="美帆" text="『んっ‥‥。』"
		   voices="miho04150"/>
		<msg @l="1223" char_id="-1" frame_id="-1" name=""
		   text="一斉に、男たちの手が美帆の胸やアソコへ絡み付く。" voices=""/>
		<msg @l="1224" char_id="-1" frame_id="-1" name=""
		   text="美帆の口からはわずかに吐息が漏らされるが‥‥気付く様子はない。" voices=""/>
		<msg @l="1226" char_id="-1" frame_id="-1" name="水泳部の子Ａ"
		   text="『うおー、おっぱいやわらけー。』" voices=""/>
		<msg @l="1228" char_id="-1" frame_id="-1" name="留学生" text="『マ○コ、マ○コ‥‥。』"
		   voices=""/>
		<msg @l="1230" char_id="-1" frame_id="-1" name="水泳部の子Ｂ"
		   text="『‥‥なんか俺、出遅れたんだけど。』" voices=""/>
		<msg @l="1232" char_id="-1" frame_id="-1" name="水泳部の子Ａ"
		   text="『適当にその辺でも撫でとけよ。』" voices=""/>
		<msg @l="1234" char_id="-1" frame_id="-1" name="水泳部の子Ｂ" text="『ちぇ‥‥。』"
		   voices=""/>
		<msg @l="1236" char_id="-1" frame_id="-1" name=""
		   text="そうして、三人の手が美帆の身体を好き勝手になぶりはじめた。" voices=""/>
		<msg @l="1237" char_id="-1" frame_id="-1" name=""
		   text="ふくよかな胸を揉み、フトモモをさすり、アソコの割れ目を撫でる。" voices=""/>
		<msg @l="1240" char_id="-1" frame_id="-1" name="水泳部の子Ａ"
		   text="『なんか乳首が硬くなってきたぞ？』" voices=""/>
		<msg @l="1242" char_id="-1" frame_id="-1" name="水泳部の子Ａ"
		   text="『気ぃ失ってても、感じるモンなのかな？』" voices=""/>
		<msg @l="1244" char_id="-1" frame_id="-1" name="水泳部の子Ｂ"
		   text="『朝勃ちみたいなもんじゃねーの？』" voices=""/>
		<msg @l="1246" char_id="-1" frame_id="-1" name="水泳部の子Ａ"
		   text="『ははっ、コリコリしてておもしれーな。』" voices=""/>
		<msg @l="1248" char_id="-1" frame_id="-1" name="留学生" text="『クリ○リス、クリ○リス‥‥。』"
		   voices=""/>
		<msg @l="1250" char_id="-1" frame_id="-1" name=""
		   text="相手の意識が無いだけに当然抵抗される事も無く、三人のイタズラ行為は時間が経つにつれて少しずつエスカレートして過激になっていく。"
		   voices=""/>
		<msg @l="1251" char_id="-1" frame_id="-1" name=""
		   text="恐る恐る触っていた胸のふくらみはいつしか無遠慮に揉みしだかれ、指先で転がしていた乳首には唇を寄せて吸い付き始めた。"
		   voices=""/>
		<msg @l="1252" char_id="-1" frame_id="-1" name=""
		   text="留学生などは、秘唇を指先で開いて胎内の様子を覗いている。" voices=""/>
		<msg @l="1253" char_id="-1" frame_id="-1" name=""
		   text="そうして一通り美帆の身体をなぶり尽くした頃、水泳部員の一人が我慢しきれなくなったように口を開く。" voices=""/>
		<msg @l="1255" char_id="-1" frame_id="-1" name="水泳部の子Ａ"
		   text="『な、なあ‥‥俺、チ○ポ握らせちゃってもいいかな？』" voices=""/>
		<msg @l="1257" char_id="-1" frame_id="-1" name="水泳部の子Ｂ" text="『あー、それいいな。』"
		   voices=""/>
		<msg @l="1259" char_id="-1" frame_id="-1" name="水泳部の子Ｂ"
		   text="『それじゃあ俺、チ○ポ咥えさせちゃおっと。』" voices=""/>
		<msg @l="1261" char_id="-1" frame_id="-1" name=""
		   text="そういって彼らは水着の中で既に屹立していたモノを取り出し、美帆の手や口元へとそれを添える。" voices=""/>
		<wait_chgmv/>
		<ev @l="1264" src="ev-024_4"/>
		<msg @l="1266" char_id="0" frame_id="-1" name="美帆" text="『んぁ‥‥‥む‥‥‥‥。』"
		   voices="miho04160"/>
		<msg @l="1268" char_id="-1" frame_id="-1" name=""
		   text="唇を押し割って、肉棒の先端が美帆の口腔へと突き入れられた。" voices=""/>
		<msg @l="1269" char_id="-1" frame_id="-1" name=""
		   text="さすがに息苦しいのだろう、美帆はわずかに眉根をひそめて吐息を漏らす。" voices=""/>
		<msg @l="1271" char_id="-1" frame_id="-1" name="水泳部の子Ｂ"
		   text="『おおおっ‥‥口ん中、すっげー気持ちいいぞ。』" voices=""/>
		<msg @l="1273" char_id="-1" frame_id="-1" name="水泳部の子Ａ"
		   text="『こっちも、握らせてるだけなのに全然違うぜ。』" voices=""/>
		<msg @l="1275" char_id="-1" frame_id="-1" name=""
		   text="美帆の身体を貪りながら、水泳部員の二人が歓喜の言葉をつむぐ。" voices=""/>
		<msg @l="1276" char_id="-1" frame_id="-1" name="" text="二人とも性的な経験が浅いのだろう。"
		   voices=""/>
		<msg @l="1277" char_id="-1" frame_id="-1" name=""
		   text="美帆の身体に押し付けているそれは既に、はちきれんばかりに大きく硬くなっていた。" voices=""/>
		<msg @l="1279" char_id="-1" frame_id="-1" name="留学生"
		   text="『オウ‥‥バージンラブジュース、デリーシャース。』" voices=""/>
		<msg @l="1281" char_id="-1" frame_id="-1" name=""
		   text="そうして暴走を続ける水泳部員たちとは裏腹に、留学生の彼は執拗なまでに美帆の秘部をなぶり続けている。" voices=""/>
		<msg @l="1282" char_id="-1" frame_id="-1" name=""
		   text="割れ目の形にそって長い舌を這わせ‥‥わずかに覗いている小さな突起を指の腹でコロコロと転がす。" voices=""/>
		<msg @l="1283" char_id="-1" frame_id="-1" name=""
		   text="秘唇からあふれ出る蜜液を残さず丹念にすすり取っていた。" voices=""/>
		<stopbgm @l="1286" fadeout="1000"/>
		<clear @l="1289" class="all"/>
		<end_scene @l="1292"/>
		<wait_chgmv/>
		<bg @l="1295" src="bg11"/>
		<bgm @l="1298" src="bgm10" volume="1."/>
		<char @l="1301" id="watab" pos="auto" src="watabe010"/>
		<msg @l="1303" char_id="-1" frame_id="-1" name="渡部" text="『おう、やってるな。』"
		   voices=""/>
		<msg @l="1305" char_id="-1" frame_id="-1" name="水泳部の子Ａ"
		   text="『うわ‥‥やべ、帰ってきちまった。』" voices=""/>
		<msg @l="1307" char_id="-1" frame_id="-1" name="水泳部の子Ｂ"
		   text="『くそ、まだイってねーよ‥‥‥。』" voices=""/>
		<msg @l="1309" char_id="-1" frame_id="-1" name="留学生" text="『‥‥モウ、リミットデスカ？』"
		   voices=""/>
		<char @l="1312" id="watab" pos="auto" src="watabe012"/>
		<msg @l="1314" char_id="-1" frame_id="-1" name="渡部"
		   text="『なんだ、オマエら我慢しきれなくなってしごいてやがったのか。』" voices=""/>
		<msg @l="1316" char_id="-1" frame_id="-1" name=""
		   text="美帆の手や口に押し付けている肉茎を見て、渡部が呆れたように笑う。" voices=""/>
		<msg @l="1318" char_id="-1" frame_id="-1" name="水泳部の子Ａ"
		   text="『で、でも‥‥約束どおり入れてないっスよ。』" voices=""/>
		<char @l="1321" id="watab" pos="auto" src="watabe017"/>
		<msg @l="1323" char_id="-1" frame_id="-1" name="渡部"
		   text="『当たり前だ。こいつの処女は俺の物だからな。』" voices=""/>
		<char @l="1326" id="watab" pos="auto" src="watabe014"/>
		<msg @l="1328" char_id="-1" frame_id="-1" name="渡部"
		   text="『そら‥‥後は俺に任せてオマエらは戻れ。』" voices=""/>
		<msg @l="1330" char_id="-1" frame_id="-1" name="水泳部の子Ｂ"
		   text="『え‥‥そんなっ、せっかくこれからだったのに。』" voices=""/>
		<msg @l="1332" char_id="-1" frame_id="-1" name="渡部"
		   text="『そうぼやくなよ‥‥ここで素直に言うこと聞いとけば、いい目が見れるかもしれなんぞ？』" voices=""/>
		<msg @l="1334" char_id="-1" frame_id="-1" name="水泳部の子Ａ" text="『それ、マジっすか？』"
		   voices=""/>
		<msg @l="1336" char_id="-1" frame_id="-1" name="水泳部の子Ｂ"
		   text="『そん時は‥‥さ、最後までやらせてくれますか？』" voices=""/>
		<char @l="1339" id="watab" pos="auto" src="watabe010"/>
		<msg @l="1341" char_id="-1" frame_id="-1" name="渡部" text="『まあ‥‥上手くいったらな。』"
		   voices=""/>
		<msg @l="1343" char_id="-1" frame_id="-1" name="渡部"
		   text="『解ってるだろうが、今日のコトは誰にも言うんじゃないぞ？』" voices=""/>
		<msg @l="1345" char_id="-1" frame_id="-1" name="水泳部の子Ａ"
		   text="『言いませんって‥‥こんな役得、他の連中に教えてやるかってんですよ。』" voices=""/>
		<msg @l="1347" char_id="-1" frame_id="-1" name="水泳部の子Ｂ"
		   text="『そーですよ、絶対、誰にも言わないっス。』" voices=""/>
		<msg @l="1349" char_id="-1" frame_id="-1" name="渡部" text="『おう、約束だからな。』"
		   voices=""/>
		<msg @l="1351" char_id="-1" frame_id="-1" name="水泳部の子Ａ" text="『わ、わかりましたっ。』"
		   voices=""/>
		<msg @l="1353" char_id="-1" frame_id="-1" name="水泳部の子Ｂ"
		   text="『それじゃ‥‥ほんと、今度は頼みますからね。』" voices=""/>
		<msg @l="1355" char_id="-1" frame_id="-1" name=""
		   text="そうして水泳部員の二人はそそくさと更衣室から立ち去る。" voices=""/>
		<msg @l="1357" char_id="-1" frame_id="-1" name="留学生" text="『‥‥‥‥。』"
		   voices=""/>
		<char @l="1360" id="watab" pos="auto" src="watabe014"/>
		<msg @l="1362" char_id="-1" frame_id="-1" name="渡部"
		   text="『なんだ、オマエも早く帰ったらどうだ？』" voices=""/>
		<msg @l="1364" char_id="-1" frame_id="-1" name="留学生"
		   text="『ワタシ、カノジョニ、ゾッコンラブ。』" voices=""/>
		<msg @l="1366" char_id="-1" frame_id="-1" name="留学生"
		   text="『ワタシ、ナカマ、ハイリタイデース。』" voices=""/>
		<char @l="1369" id="watab" pos="auto" src="watabe017"/>
		<msg @l="1371" char_id="-1" frame_id="-1" name="渡部" text="『仲間に入りたいだと？』"
		   voices=""/>
		<msg @l="1373" char_id="-1" frame_id="-1" name="留学生"
		   text="『アナタ、カノジョト、ステディーナカンケイ。』" voices=""/>
		<msg @l="1375" char_id="-1" frame_id="-1" name="留学生"
		   text="『ワタシモ、カノジョト、ステディーニナリタイネ。』" voices=""/>
		<char @l="1378" id="watab" pos="auto" src="watabe014"/>
		<msg @l="1380" char_id="-1" frame_id="-1" name="渡部"
		   text="『おい、こんな事言ってるがどうする‥‥熊野さんよ？』" voices=""/>
		<msg @l="1382" char_id="-1" frame_id="-1" name="声" text="『おやおや‥‥。』"
		   voices=""/>
		<clear @l="1385" class="char"/>
		<char @l="1387" id="watab" pos="left" src="watabe014"/>
		<char @l="1389" id="kuma" pos="right" src="kuma010"/>
		<msg @l="1391" char_id="-1" frame_id="-1" name="留学生"
		   text="『オウ？&#32;クマーノサン、イツノマニ‥‥。』" voices=""/>
		<msg @l="1393" char_id="-1" frame_id="-1" name=""
		   text="音も無く、渡部の背後からひょっこりと大学の用務員‥‥熊野が姿を現す。" voices=""/>
		<msg @l="1394" char_id="-1" frame_id="-1" name=""
		   text="巨漢である渡部の背後に隠れていたのだろうか。" voices=""/>
		<char @l="1397" id="watab" pos="left" src="watabe017"/>
		<msg @l="1399" char_id="-1" frame_id="-1" name="渡部"
		   text="『あんまり深いところまで首を突っ込むと、抜けれなくなるぞ？』" voices=""/>
		<msg @l="1401" char_id="-1" frame_id="-1" name=""
		   text="不思議そうな表情をしている留学生に、渡部が強面を寄せて凄んでみせる。" voices=""/>
		<msg @l="1402" char_id="-1" frame_id="-1" name=""
		   text="けれど‥‥留学生には彼の強面は通用していないようだ。" voices=""/>
		<msg @l="1404" char_id="-1" frame_id="-1" name="熊野" text="『ああ‥‥彼ならいいんです。』"
		   voices=""/>
		<msg @l="1406" char_id="-1" frame_id="-1" name="熊野"
		   text="『初期段階から部外者を増やして情報が漏洩する可能性が上がるのも困るのですが、我々の計画には彼のようなセックスモンスターも必要なんですよ。』"
		   voices=""/>
		<char @l="1409" id="watab" pos="left" src="watabe010"/>
		<msg @l="1411" char_id="-1" frame_id="-1" name="渡部"
		   text="『なんだ、あんたの仕込みか‥‥、なら早く言ってくれよな。』" voices=""/>
		<msg @l="1413" char_id="-1" frame_id="-1" name="留学生" text="『オオ、センキュー！』"
		   voices=""/>
		<char @l="1416" id="watab" pos="left" src="watabe017"/>
		<msg @l="1418" char_id="-1" frame_id="-1" name="渡部" text="『‥‥‥‥。』" voices=""/>
		<msg @l="1420" char_id="-1" frame_id="-1" name=""
		   text="オーバーアクションをして喜ぶ留学生を渡部が睨み付けるが、当の本人はその視線に全く気付いていない。" voices=""/>
		<char @l="1423" id="kuma" pos="right" src="kuma012"/>
		<msg @l="1425" char_id="-1" frame_id="-1" name="熊野" text="『それじゃ、始めますか。』"
		   voices=""/>
		<msg @l="1427" char_id="-1" frame_id="-1" name=""
		   text="そうして笑った熊野の口元には‥‥邪悪な笑みが浮かんでいた。" voices=""/>
		<stopbgm @l="1430" fadeout="1000"/>
		<clear @l="1433" class="all"/>
		<label @l="1436" id="chart_line20"/>
		<call @l="1439" target="EventLabel_82@root_akina_c_ev01"/>
		<return @l="1440" value="0&#13;&#10;"/>
		<label @l="1443" id="EventLabel_75"/>
		<wait_chgmv/>
		<bg @l="1446" src="bg11"/>
		<bgm @l="1449" src="bgm02" volume="1."/>
		<char @l="1452" id="miho" pos="auto" src="miho060"/>
		<msg @l="1454" char_id="0" frame_id="-1" name="美帆" text="『‥‥ふぅ。』" voices=""/>
		<clear @l="1457" class="char"/>
		<char @l="1459" id="miho" pos="left" src="miho060"/>
		<char @l="1461" id="akina" pos="right" src="akina010"/>
		<msg @l="1463" char_id="2" frame_id="-1" name="亜季奈"
		   text="『どうしたの、ため息なんて吐いちゃって。』" voices=""/>
		<char @l="1466" id="akina" pos="right" src="akina011"/>
		<msg @l="1468" char_id="2" frame_id="-1" name="亜季奈"
		   text="『あ、もしかして‥‥勝者ゆえのユウウツってヤツかな？』" voices=""/>
		<char @l="1471" id="akina" pos="right" src="akina010"/>
		<msg @l="1473" char_id="2" frame_id="-1" name="亜季奈"
		   text="『さっきは大奮闘だったからね、お姉ちゃん。』" voices=""/>
		<char @l="1476" id="miho" pos="left" src="miho066"/>
		<msg @l="1478" char_id="0" frame_id="-1" name="美帆" text="『もう、そんなんじゃないって‥‥。』"
		   voices=""/>
		<char @l="1481" id="miho" pos="left" src="miho060"/>
		<msg @l="1483" char_id="0" frame_id="-1" name="美帆" text="『ちょっと疲れちゃっただけ。』"
		   voices=""/>
		<msg @l="1485" char_id="2" frame_id="-1" name="亜季奈"
		   text="『久しぶりに全力で泳いだって感じ？』" voices=""/>
		<char @l="1488" id="miho" pos="left" src="miho066"/>
		<msg @l="1490" char_id="0" frame_id="-1" name="美帆"
		   text="『うん‥‥毎日練習してるわけでもないのに、いきなり１００メートルなんて泳ぐものじゃないわね。』" voices=""/>
		<msg @l="1492" char_id="0" frame_id="-1" name="美帆"
		   text="『もう、身体中ガクガクになっちゃった。』" voices=""/>
		<char @l="1495" id="akina" pos="right" src="akina011"/>
		<msg @l="1497" char_id="2" frame_id="-1" name="亜季奈"
		   text="『あはははっ、運動不足なんじゃない？』" voices=""/>
		<char @l="1500" id="miho" pos="left" src="miho160"/>
		<msg @l="1502" char_id="0" frame_id="-1" name="美帆" text="『そうかもね。』" voices=""/>
		<char @l="1505" id="akina" pos="right" src="akina010"/>
		<msg @l="1507" char_id="2" frame_id="-1" name="亜季奈"
		   text="『お姉ちゃん、シャワーは浴びたの？』" voices=""/>
		<char @l="1510" id="miho" pos="left" src="miho060"/>
		<msg @l="1512" char_id="0" frame_id="-1" name="美帆"
		   text="『うん。後は着替えるだけ‥‥外で待ってて？』" voices=""/>
		<char @l="1515" id="akina" pos="right" src="akina111"/>
		<msg @l="1517" char_id="2" frame_id="-1" name="亜季奈" text="『あいあいさー。』"
		   voices=""/>
		<clear @l="1520" layer="akina"/>
		<msg @l="1522" char_id="-1" frame_id="-1" name=""
		   text="亜季奈は、軽い返事と共に更衣室を出て行く。" voices=""/>
		<msg @l="1523" char_id="-1" frame_id="-1" name=""
		   text="終始ニコニコと顔を綻ばせている所をみると、私が水泳勝負に勝ったコトがよほど嬉しかったのだろう。" voices=""/>
		<msg @l="1525" char_id="0" frame_id="-1" name="美帆"
		   text="『水泳‥‥もう一回始めようかな‥‥‥。』" voices=""/>
		<msg @l="1527" char_id="-1" frame_id="-1" name="声"
		   text="『それはいい考えだ、ぜひそうしてもらいたいモノだな。』" voices=""/>
		<stopbgm @l="1530" fadeout="1000"/>
		<char @l="1533" id="miho" pos="left" src="miho064"/>
		<msg @l="1535" char_id="0" frame_id="-1" name="美帆" text="『え‥‥。』" voices=""/>
		<msg @l="1537" char_id="-1" frame_id="-1" name="" text="突然の声に驚き、声がした方を振り返る。"
		   voices=""/>
		<char @l="1540" id="watab" pos="right" src="watabe010"/>
		<bgm @l="1543" src="bgm10" volume="1."/>
		<msg @l="1545" char_id="-1" frame_id="-1" name=""
		   text="更衣室の入り口にはいつの間にか渡部先生がいた。" voices=""/>
		<msg @l="1546" char_id="-1" frame_id="-1" name=""
		   text="サークルが管理している合鍵を使って入ってきたのだろう。" voices=""/>
		<msg @l="1548" char_id="-1" frame_id="-1" name="渡部"
		   text="『三年のブランクはでかい‥‥さすがに現役とはいかないだろうが、コーチとしてならまだまだ十分にやっていけるだろう。』"
		   voices=""/>
		<msg @l="1550" char_id="-1" frame_id="-1" name="渡部"
		   text="『むしろ、俺としてはそっちの方がありがたいが。』" voices=""/>
		<char @l="1553" id="miho" pos="left" src="miho165"/>
		<msg @l="1555" char_id="0" frame_id="-1" name="美帆" text="『アナタ‥‥懲りない人ですね。』"
		   voices=""/>
		<msg @l="1557" char_id="-1" frame_id="-1" name="渡部"
		   text="『そう、露骨に嫌な顔をしないで貰いたいな。』" voices=""/>
		<msg @l="1559" char_id="0" frame_id="-1" name="美帆"
		   text="『いちおう、ここは女子更衣室のハズですけど？』" voices=""/>
		<char @l="1562" id="watab" pos="right" src="watabe012"/>
		<msg @l="1564" char_id="-1" frame_id="-1" name="渡部" text="『俺が気にするとでも思ったか？』"
		   voices=""/>
		<char @l="1567" id="miho" pos="left" src="miho065"/>
		<msg @l="1569" char_id="0" frame_id="-1" name="美帆" text="『私が、気にするんです。』"
		   voices=""/>
		<char @l="1572" id="watab" pos="right" src="watabe010"/>
		<msg @l="1574" char_id="-1" frame_id="-1" name="渡部"
		   text="『なら前みたいに大声でも出してみたらどうだ。』" voices=""/>
		<msg @l="1576" char_id="-1" frame_id="-1" name="渡部"
		   text="『下の出口のところに妹を待たせてるんだろ？&#32;心配して駆けつけてくるんじゃないか？』" voices=""/>
		<msg @l="1578" char_id="-1" frame_id="-1" name="" text="そうして渡部はニヤニヤと笑ってみせる。"
		   voices=""/>
		<msg @l="1579" char_id="-1" frame_id="-1" name=""
		   text="亜季奈が私の弱味であることを、この人は十分に理解しているのだ。" voices=""/>
		<char @l="1582" id="miho" pos="left" src="miho165"/>
		<msg @l="1584" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<char @l="1587" id="watab" pos="right" src="watabe012"/>
		<msg @l="1589" char_id="-1" frame_id="-1" name="渡部"
		   text="『まあ、外に人がいるこの状況で大声をあげられたら、さすがの俺も少々荒っぽい手段をとらないとな‥‥。』" voices=""/>
		<char @l="1592" id="watab" pos="right" src="watabe014"/>
		<msg @l="1594" char_id="-1" frame_id="-1" name="渡部"
		   text="『例えば‥‥駆けつけた妹を無理やり黙らせる、とかな？』" voices=""/>
		<msg @l="1596" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥それは脅迫ですか。』"
		   voices=""/>
		<msg @l="1598" char_id="-1" frame_id="-1" name="渡部" text="『好きに解釈してくれて結構だ。』"
		   voices=""/>
		<msg @l="1600" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥‥‥。』"
		   voices=""/>
		<char @l="1603" id="watab" pos="right" src="watabe010"/>
		<msg @l="1605" char_id="-1" frame_id="-1" name="渡部"
		   text="『まあ‥‥今日は平和的な話し合いというヤツをしてみようかと思ってな。』" voices=""/>
		<char @l="1608" id="miho" pos="left" src="miho065"/>
		<msg @l="1610" char_id="0" frame_id="-1" name="美帆" text="『平和的な話し合い‥‥ですか。』"
		   voices=""/>
		<msg @l="1612" char_id="0" frame_id="-1" name="美帆"
		   text="『少なくとも、着替え中の人間がいる更衣室でする事ではないと思います。』" voices=""/>
		<msg @l="1614" char_id="-1" frame_id="-1" name="渡部"
		   text="『まあそう言うな‥‥こういう時でも利用しないと二人でゆっくり話をするなんて出来ないからな。』" voices=""/>
		<msg @l="1616" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="1618" char_id="0" frame_id="-1" name="美帆"
		   text="『‥‥‥それで‥‥私に何の話があるというんですか。』" voices=""/>
		<msg @l="1620" char_id="-1" frame_id="-1" name="渡部"
		   text="『今日の水泳勝負を見ててな‥‥‥‥俺はどうしてもオマエが欲しくなった。』" voices=""/>
		<msg @l="1622" char_id="-1" frame_id="-1" name="渡部"
		   text="『どうだ、俺の下でウチ専属のコーチをやってみないか？』" voices=""/>
		<msg @l="1624" char_id="-1" frame_id="-1" name="渡部"
		   text="『もちろんタダとは言わない、金ならそれなりに出そう。』" voices=""/>
		<char @l="1627" id="miho" pos="left" src="miho164"/>
		<msg @l="1629" char_id="0" frame_id="-1" name="美帆" text="『なっ‥‥馬鹿にしないでください！』"
		   voices=""/>
		<msg @l="1631" char_id="0" frame_id="-1" name="美帆"
		   text="『私がそんな話を素直に受けると思ってるんですか？』" voices=""/>
		<msg @l="1633" char_id="-1" frame_id="-1" name="渡部" text="『受けないのか？』"
		   voices=""/>
		<msg @l="1635" char_id="0" frame_id="-1" name="美帆"
		   text="『当たり前ですっ‥‥自分が今までした事を考えて下さい！』" voices=""/>
		<msg @l="1637" char_id="-1" frame_id="-1" name="渡部"
		   text="『それじゃあ仕方がないな。この話はオマエではなく妹の方に持っていくことにしようか。』" voices=""/>
		<msg @l="1639" char_id="0" frame_id="-1" name="美帆" text="『え‥‥。』" voices=""/>
		<msg @l="1641" char_id="-1" frame_id="-1" name="渡部"
		   text="『ちょうど進学か就職かを選択しなくちゃならん時期だからな。少し良い条件を提示してやればうなずいてくれるだろう。』" voices=""/>
		<msg @l="1643" char_id="0" frame_id="-1" name="美帆"
		   text="『ま、待ってください‥‥あの子はまだ現役なんですよ？』" voices=""/>
		<msg @l="1645" char_id="0" frame_id="-1" name="美帆"
		   text="『それをコーチにするだなんて、あの子の意思はどうなるんですか？』" voices=""/>
		<msg @l="1647" char_id="-1" frame_id="-1" name="渡部"
		   text="『アイツの意思？&#32;そんなものは関係ないな。』" voices=""/>
		<char @l="1650" id="watab" pos="right" src="watabe017"/>
		<msg @l="1652" char_id="-1" frame_id="-1" name="渡部"
		   text="『俺が欲しいのは手足として働いてくれる忠実な水泳コーチであって、選手じゃないんだよ。』" voices=""/>
		<char @l="1655" id="miho" pos="left" src="miho164"/>
		<msg @l="1657" char_id="0" frame_id="-1" name="美帆"
		   text="『そんなのっ‥‥亜季奈だって納得するわけがありません！』" voices=""/>
		<char @l="1660" id="watab" pos="right" src="watabe010"/>
		<msg @l="1662" char_id="-1" frame_id="-1" name="渡部" text="『なーに、その辺は簡単さ。』"
		   voices=""/>
		<msg @l="1664" char_id="-1" frame_id="-1" name="渡部"
		   text="『アイツは俺に惚れてるようだからなあ、その辺を上手く利用してやれば簡単に落ちる。』" voices=""/>
		<char @l="1667" id="miho" pos="left" src="miho064"/>
		<msg @l="1669" char_id="0" frame_id="-1" name="美帆" text="『亜季奈がアナタのコトを‥‥？』"
		   voices=""/>
		<msg @l="1671" char_id="-1" frame_id="-1" name=""
		   text="確かに亜季奈はこの人を無条件で信頼しているような所があった。" voices=""/>
		<msg @l="1672" char_id="-1" frame_id="-1" name=""
		   text="でも、それは単に部活の顧問という事に対する尊敬なのだとばかり思っていたけれど‥‥。" voices=""/>
		<char @l="1675" id="miho" pos="left" src="miho165"/>
		<msg @l="1677" char_id="0" frame_id="-1" name="美帆"
		   text="『信じられません‥‥あの子が、亜季奈がアナタみたいな人を好きになるだなんて。』" voices=""/>
		<msg @l="1679" char_id="-1" frame_id="-1" name="渡部"
		   text="『おいおい、そりゃ自分の妹を悪く言ってるのと同じじゃないか？』" voices=""/>
		<char @l="1682" id="miho" pos="left" src="miho164"/>
		<msg @l="1684" char_id="0" frame_id="-1" name="美帆" text="『揚げ足を取らないで下さい！』"
		   voices=""/>
		<msg @l="1686" char_id="-1" frame_id="-1" name="渡部"
		   text="『それに、俺の方は別にアイツのコト何てなんとも思っちゃいない。』" voices=""/>
		<msg @l="1688" char_id="-1" frame_id="-1" name="渡部"
		   text="『俺が専属のコーチとして迎えたいのは‥‥オマエなんだからな？』" voices=""/>
		<char @l="1691" id="miho" pos="left" src="miho065"/>
		<msg @l="1693" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="1695" char_id="-1" frame_id="-1" name="渡部"
		   text="『オマエがここで受けてくれれば、俺は何も妹を無理に引きずり込んだりしなくても済むんだよ。』" voices=""/>
		<msg @l="1697" char_id="-1" frame_id="-1" name="渡部" text="『どうだ‥‥悪い話じゃないだろ？』"
		   voices=""/>
		<msg @l="1699" char_id="-1" frame_id="-1" name=""
		   text="渡部はそう言って口元をニタリと歪めて笑う。" voices=""/>
		<msg @l="1701" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<char @l="1704" id="miho" pos="left" src="miho165"/>
		<msg @l="1706" char_id="0" frame_id="-1" name="美帆" text="『ひとつ、聞いてもいいですか？』"
		   voices=""/>
		<msg @l="1708" char_id="-1" frame_id="-1" name="渡部" text="『なんだ？』" voices=""/>
		<msg @l="1710" char_id="0" frame_id="-1" name="美帆"
		   text="『私を専属のコーチにして‥‥それでどうするつもりですか。』" voices=""/>
		<msg @l="1712" char_id="-1" frame_id="-1" name="渡部"
		   text="『決まってるだろ？&#32;部員の連中を指導してもらうんだよ。』" voices=""/>
		<msg @l="1714" char_id="0" frame_id="-1" name="美帆" text="『本当にそれだけですか？』"
		   voices=""/>
		<msg @l="1716" char_id="0" frame_id="-1" name="美帆"
		   text="『また、三年前や先日の練習中のような事をするんじゃないですか？』" voices=""/>
		<char @l="1719" id="watab" pos="right" src="watabe017"/>
		<msg @l="1721" char_id="-1" frame_id="-1" name="渡部" text="『そうだとしたら何だ？』"
		   voices=""/>
		<char @l="1724" id="miho" pos="left" src="miho164"/>
		<msg @l="1726" char_id="0" frame_id="-1" name="美帆" text="『‥‥！？』" voices=""/>
		<msg @l="1728" char_id="-1" frame_id="-1" name="渡部"
		   text="『オマエがこの話を受けなければ妹の方に言う。内容なんてのにこだわってる余裕なんて無いぞ？』" voices=""/>
		<msg @l="1730" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<char @l="1733" id="watab" pos="right" src="watabe010"/>
		<msg @l="1735" char_id="-1" frame_id="-1" name="渡部"
		   text="『何度も言うが、悪い話じゃ無いと思うがな、オレにとってはな。』" voices=""/>
		<char @l="1738" id="miho" pos="left" src="miho165"/>
		<msg @l="1740" char_id="0" frame_id="-1" name="美帆" text="『出て行って‥‥。』"
		   voices=""/>
		<char @l="1743" id="watab" pos="right" src="watabe014"/>
		<msg @l="1745" char_id="-1" frame_id="-1" name="渡部" text="『ああ？』" voices=""/>
		<char @l="1748" id="miho" pos="left" src="miho065"/>
		<msg @l="1750" char_id="0" frame_id="-1" name="美帆"
		   text="『いますぐ、ここから出て行ってください。』" voices=""/>
		<msg @l="1752" char_id="-1" frame_id="-1" name="渡部"
		   text="『ほう、妹の方にすべて押し付けるつもりか。』" voices=""/>
		<char @l="1755" id="miho" pos="left" src="miho166"/>
		<msg @l="1757" char_id="0" frame_id="-1" name="美帆"
		   text="『違います‥‥私はあの子を信じています。』" voices=""/>
		<msg @l="1759" char_id="0" frame_id="-1" name="美帆"
		   text="『あの子が間違った道を選んだりしないって、信じてますから。』" voices=""/>
		<msg @l="1761" char_id="-1" frame_id="-1" name="渡部" text="『ふん‥‥交渉決裂だな。』"
		   voices=""/>
		<msg @l="1763" char_id="-1" frame_id="-1" name="渡部" text="『せいぜい後悔するといい。』"
		   voices=""/>
		<stopbgm @l="1766" fadeout="1000"/>
		<clear @l="1769" class="char"/>
		<char @l="1771" id="miho" pos="auto" src="miho166"/>
		<bgm @l="1774" src="bgm03" volume="1."/>
		<msg @l="1776" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<clear @l="1779" class="char"/>
		<msg @l="1781" char_id="-1" frame_id="-1" name=""
		   text="捨て台詞のような言葉を残して、渡部が更衣室を立ち去る。" voices=""/>
		<msg @l="1782" char_id="-1" frame_id="-1" name=""
		   text="立ち去る渡部先生の背中を見ながら‥‥そっと唇を噛んでいた。" voices=""/>
		<stopbgm @l="1785" fadeout="1000"/>
		<clear @l="1788" class="all"/>
		<wait_chgmv/>
		<bg @l="1791" src="bg07b"/>
		<bgm @l="1794" src="bgm05" volume="1."/>
		<char @l="1797" id="miho" pos="left" src="miho010"/>
		<msg @l="1799" char_id="0" frame_id="-1" name="美帆" text="『‥‥おまたせ。』"
		   voices=""/>
		<char @l="1802" id="akina" pos="right" src="akina017"/>
		<msg @l="1804" char_id="2" frame_id="-1" name="亜季奈" text="『お姉ちゃん、おそーい！』"
		   voices=""/>
		<msg @l="1806" char_id="-1" frame_id="-1" name=""
		   text="体育館を出てすぐのところで、亜季奈と合流する。" voices=""/>
		<msg @l="1807" char_id="-1" frame_id="-1" name=""
		   text="もしかしたら先に出て行った渡部先生に騙されて、いなくなっているのではないかとも考えたけれど‥‥こうして待っていてくれて良かった。"
		   voices=""/>
		<char @l="1810" id="miho" pos="left" src="miho016"/>
		<msg @l="1812" char_id="0" frame_id="-1" name="美帆"
		   text="『ごめん‥‥ちょっと渡部先生と話し込んでて‥‥‥。』" voices=""/>
		<char @l="1815" id="akina" pos="right" src="akina110"/>
		<msg @l="1817" char_id="2" frame_id="-1" name="亜季奈"
		   text="『ああ、そういえばさっきセンセイが出てったなぁ‥‥。』" voices=""/>
		<char @l="1820" id="miho" pos="left" src="miho014"/>
		<msg @l="1822" char_id="0" frame_id="-1" name="美帆" text="『えっ‥‥なにか言れたの？』"
		   voices=""/>
		<msg @l="1824" char_id="2" frame_id="-1" name="亜季奈" text="『ううん、別に？』"
		   voices=""/>
		<char @l="1827" id="miho" pos="left" src="miho110"/>
		<msg @l="1829" char_id="0" frame_id="-1" name="美帆" text="『そう‥‥なら、いいけど‥‥‥。』"
		   voices=""/>
		<msg @l="1831" char_id="0" frame_id="-1" name="美帆"
		   text="(あれはやっぱり私を脅迫する為の嘘だった‥‥？)" voices=""/>
		<msg @l="1833" char_id="0" frame_id="-1" name="美帆"
		   text="(でも、あんな簡単に引き下がったのはどうして‥‥)" voices=""/>
		<char @l="1836" id="akina" pos="right" src="akina010"/>
		<msg @l="1838" char_id="2" frame_id="-1" name="亜季奈" text="『お姉ちゃん？』"
		   voices=""/>
		<char @l="1841" id="miho" pos="left" src="miho016"/>
		<msg @l="1843" char_id="0" frame_id="-1" name="美帆"
		   text="『え、あ‥‥ううん、なんでもないの。』" voices=""/>
		<msg @l="1845" char_id="2" frame_id="-1" name="亜季奈" text="『‥‥？』" voices=""/>
		<clear @l="1848" class="all"/>
		<wait_chgmv/>
		<bg @l="1851" src="bg07b"/>
		<char @l="1854" id="miho" pos="left" src="miho010"/>
		<char @l="1857" id="akina" pos="right" src="akina010"/>
		<msg @l="1859" char_id="2" frame_id="-1" name="亜季奈" text="『それじゃ、私はこっちだから。』"
		   voices=""/>
		<msg @l="1861" char_id="0" frame_id="-1" name="美帆" text="『うん‥‥。』" voices=""/>
		<msg @l="1863" char_id="2" frame_id="-1" name="亜季奈"
		   text="『お姉ちゃん、なんかブルー入ってる？』" voices=""/>
		<char @l="1866" id="miho" pos="left" src="miho116"/>
		<msg @l="1868" char_id="0" frame_id="-1" name="美帆"
		   text="『え‥‥べ、別にそんなんじゃないから‥‥‥大丈夫だよ。』" voices=""/>
		<msg @l="1870" char_id="0" frame_id="-1" name="美帆"
		   text="(やっぱり、亜季奈に、ちゃんと断るように言っとくべきなのかな‥‥)" voices=""/>
		<msg @l="1872" char_id="0" frame_id="-1" name="美帆"
		   text="(でも‥‥いきなりそんな風に言うのも変だろうし‥‥‥)" voices=""/>
		<char @l="1875" id="akina" pos="right" src="akina117"/>
		<msg @l="1877" char_id="2" frame_id="-1" name="亜季奈"
		   text="『お姉ちゃん、やっぱりなんか変だよ？』" voices=""/>
		<char @l="1880" id="miho" pos="left" src="miho016"/>
		<msg @l="1882" char_id="0" frame_id="-1" name="美帆"
		   text="『そ、そうかな‥‥ちょっと疲れてるだけだと思う。』" voices=""/>
		<msg @l="1884" char_id="2" frame_id="-1" name="亜季奈" text="『ふぅん？』" voices=""/>
		<char @l="1887" id="akina" pos="right" src="akina011"/>
		<msg @l="1889" char_id="2" frame_id="-1" name="亜季奈"
		   text="『それじゃ、私はそろそろ宿舎の方に帰るね。』" voices=""/>
		<clear @l="1892" layer="akina"/>
		<char @l="1895" id="miho" pos="left" src="miho014"/>
		<msg @l="1897" char_id="0" frame_id="-1" name="美帆" text="『あ、待って！』" voices=""/>
		<char @l="1900" id="akina" pos="right" src="akina010"/>
		<msg @l="1902" char_id="2" frame_id="-1" name="亜季奈" text="『なに？』" voices=""/>
		<char @l="1905" id="miho" pos="left" src="miho016"/>
		<msg @l="1907" char_id="0" frame_id="-1" name="美帆" text="『う‥‥あ、えっと‥‥‥。』"
		   voices=""/>
		<msg @l="1909" char_id="-1" frame_id="-1" name=""
		   text="思わず引き止めてしまったけれど、いざ言うとなると、どんな風に切り出せば良いのか分からない。" voices=""/>
		<msg @l="1911" char_id="0" frame_id="-1" name="美帆"
		   text="『ごめん‥‥やっぱりなんでもない‥‥‥‥。』" voices=""/>
		<char @l="1914" id="akina" pos="right" src="akina014"/>
		<msg @l="1916" char_id="2" frame_id="-1" name="亜季奈"
		   text="『何それ、やっぱ何か悩んでたりするの？』" voices=""/>
		<msg @l="1918" char_id="0" frame_id="-1" name="美帆"
		   text="『う、ううん‥‥気にしないで、なんでもないから。』" voices=""/>
		<char @l="1921" id="akina" pos="right" src="akina010"/>
		<msg @l="1923" char_id="2" frame_id="-1" name="亜季奈"
		   text="『まあ、お姉ちゃんがそう言うなら気にしないけど‥‥。』" voices=""/>
		<msg @l="1925" char_id="2" frame_id="-1" name="亜季奈" text="『それじゃ、宿舎の方に戻るよ？』"
		   voices=""/>
		<msg @l="1927" char_id="0" frame_id="-1" name="美帆"
		   text="『あ、うん‥‥引き止めちゃってゴメンね。』" voices=""/>
		<char @l="1930" id="akina" pos="right" src="akina111"/>
		<msg @l="1932" char_id="2" frame_id="-1" name="亜季奈" text="『それじゃ、また明日ね。』"
		   voices=""/>
		<clear @l="1935" layer="akina"/>
		<msg @l="1937" char_id="-1" frame_id="-1" name=""
		   text="亜季奈はそう言って宿舎の方へ走っていく。" voices=""/>
		<char @l="1940" id="miho" pos="left" src="miho116"/>
		<msg @l="1942" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="1944" char_id="0" frame_id="-1" name="美帆" text="(私が信じないと‥‥‥ダメ、だよね)"
		   voices=""/>
		<stopbgm @l="1947" fadeout="1000"/>
		<clear @l="1950" class="all"/>
		<wait_chgmv/>
		<bg @l="1953" src="bg01b"/>
		<bgm @l="1956" src="bgm03" volume="1."/>
		<msg @l="1958" char_id="0" frame_id="-1" name="美帆" text="『‥‥はぁ。』" voices=""/>
		<msg @l="1960" char_id="-1" frame_id="-1" name=""
		   text="私は部屋のベッドに寝転がったまま小さなため息を吐く。" voices=""/>
		<msg @l="1961" char_id="-1" frame_id="-1" name=""
		   text="何をしていても頭に浮かんでくるのは亜季奈のコトばかり‥‥。" voices=""/>
		<msg @l="1962" char_id="-1" frame_id="-1" name=""
		   text="姉である私が亜季奈を信じてあげなくてどうすると思う半面で、どうしてもあの子のことが気にかかってしまう。" voices=""/>
		<msg @l="1963" char_id="-1" frame_id="-1" name=""
		   text="それもこれも‥‥渡部先生の残した最後の言葉の所為だ。" voices=""/>
		<msg @l="1965" char_id="0" frame_id="-1" name="美帆" text="『せいぜい後悔するといい‥‥か。』"
		   voices=""/>
		<msg @l="1967" char_id="-1" frame_id="-1" name=""
		   text="あれが単なる脅しの為の嘘だというのなら、それほど悩む事はない。" voices=""/>
		<msg @l="1968" char_id="-1" frame_id="-1" name="" text="ただ‥‥完全に嘘だと思えない。"
		   voices=""/>
		<msg @l="1969" char_id="-1" frame_id="-1" name="" text="なにせ相手はあの渡部先生だ‥‥。"
		   voices=""/>
		<msg @l="1970" char_id="-1" frame_id="-1" name=""
		   text="何かを企んでいると考えた方が‥‥良いのではないだろうか。" voices=""/>
		<msg @l="1972" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="1974" char_id="0" frame_id="-1" name="美帆"
		   text="(やっぱり、何かひと言くらいは伝えておかないと)" voices=""/>
		<msg @l="1976" char_id="0" frame_id="-1" name="美帆"
		   text="(信じるのと何もしないのは‥‥違うもんね！)" voices=""/>
		<msg @l="1978" char_id="-1" frame_id="-1" name="" text="私は部屋にある時計を見る。"
		   voices=""/>
		<msg @l="1979" char_id="-1" frame_id="-1" name="" text="もう十時を大きく回っていた。"
		   voices=""/>
		<msg @l="1981" char_id="0" frame_id="-1" name="美帆"
		   text="(電車はもうない‥‥タクシーなら、駅前で捕まるかな)" voices=""/>
		<msg @l="1983" char_id="0" frame_id="-1" name="美帆"
		   text="(それとも‥‥‥宿舎に電話をして、ひと言、言っておこうか)" voices=""/>
		<msg @l="1985" char_id="0" frame_id="-1" name="美帆" text="(どうしよう‥‥)"
		   voices=""/>
		<msg @l="1989" async="true" char_id="-1" frame_id="-1" name=""
		   text="亜季奈にどうアクセスする‥‥？" voices=""/>
		<select @l="1990">
			<menu @l="1994" label="EventLabel_76" text="宿舎へ電話する"/>
			<menu @l="1997" label="EventLabel_77" text="直接出向いて話す"/>
		</select>
		<label @l="2006" id="EventLabel_76"/>
		<char @l="2009" id="miho" pos="auto" src="miho130"/>
		<msg @l="2011" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="2013" char_id="-1" frame_id="-1" name=""
		   text="私は思い立ったようにベッドから立ち上がり、机の上の充電器にセットしてある携帯電話に手を伸ばす。" voices=""/>
		<msg @l="2014" char_id="-1" frame_id="-1" name=""
		   text="ひんやりとした感触が妙にリアルで、私は少しだけ気後れしてしまう。" voices=""/>
		<se @l="2017" buf="3" loop="true" src="発信音" volume="1."/>
		<msg @l="2019" char_id="-1" frame_id="-1" name=""
		   text="メモリーから亜季奈の携帯電話の番号を探して、コールする。" voices=""/>
		<msg @l="2021" char_id="-1" frame_id="-1" name="" text="トゥルルルル‥‥トゥルルルル‥‥。"
		   voices=""/>
		<char @l="2024" id="miho" pos="auto" src="miho034"/>
		<msg @l="2026" char_id="0" frame_id="-1" name="美帆" text="(‥‥コールしてるのに出ない‥‥‥)"
		   voices=""/>
		<msg @l="2028" char_id="-1" frame_id="-1" name=""
		   text="コールするということは、電源を切ってるわけでも電波が届いていないわけでもない。" voices=""/>
		<msg @l="2029" char_id="-1" frame_id="-1" name=""
		   text="だとすると、もう寝てしまったのだろうか‥‥？" voices=""/>
		<msg @l="2030" char_id="-1" frame_id="-1" name=""
		   text="いや‥‥さすがに運動系の合宿とはいえ、十時に就寝は早すぎる。" voices=""/>
		<stopse @l="2033" buf="3"/>
		<se @l="2036" buf="1" src="携帯ボタン押下音" volume="1."/>
		<char @l="2039" id="miho" pos="auto" src="miho136"/>
		<msg @l="2041" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="2043" char_id="0" frame_id="-1" name="美帆"
		   text="(なんだろう‥‥マナーモードにしてて気付いてない、とか？)" voices=""/>
		<msg @l="2045" char_id="-1" frame_id="-1" name=""
		   text="亜季奈が着信があったことに気付いて連絡をくれればいいが、そうでなければ何度電話をしても同じコトだ。" voices=""/>
		<char @l="2048" id="miho" pos="auto" src="miho134"/>
		<msg @l="2050" char_id="0" frame_id="-1" name="美帆"
		   text="『あっ‥‥確か宿舎の電話番号、聞いてたっけ。』" voices=""/>
		<msg @l="2052" char_id="-1" frame_id="-1" name=""
		   text="亜季奈から合宿のコーチを頼まれた時に確か、携帯が繋がらない時に、という事で宿舎備え付けの電話番号を聞いていたんだ。"
		   voices=""/>
		<msg @l="2053" char_id="-1" frame_id="-1" name=""
		   text="まさかこんな所で役に立つとは思っていなかったが。" voices=""/>
		<char @l="2056" id="miho" pos="auto" src="miho130"/>
		<se @l="2059" buf="3" loop="true" src="発信音" volume="1."/>
		<msg @l="2061" char_id="-1" frame_id="-1" name="" text="一回、二回、三回‥‥。"
		   voices=""/>
		<msg @l="2062" char_id="-1" frame_id="-1" name=""
		   text="コールの音が続くたび、妙な不安に襲われる。" voices=""/>
		<msg @l="2063" char_id="-1" frame_id="-1" name="" text="ありもしない想像を‥‥巡らせてしまう。"
		   voices=""/>
		<stopse @l="2066" buf="3"/>
		<msg @l="2068" char_id="-1" frame_id="-1" name="声"
		   text="『お待たせしました。学内設備管理を承っております、熊野と申します。』" voices=""/>
		<char @l="2071" id="miho" pos="auto" src="miho134"/>
		<msg @l="2073" char_id="0" frame_id="-1" name="美帆"
		   text="『あの‥‥私、仲根と申しますが‥‥‥。』" voices=""/>
		<msg @l="2075" char_id="0" frame_id="-1" name="美帆"
		   text="『合宿に来ている、妹、水泳部の仲根亜季奈に繋いで頂けませんか？』" voices=""/>
		<msg @l="2077" char_id="-1" frame_id="-1" name="熊野"
		   text="『仲根さんですね‥‥少々お待ち下さい。』" voices=""/>
		<char @l="2080" id="miho" pos="auto" src="miho136"/>
		<se @l="2083" buf="3" loop="true" src="保留音" volume="1."/>
		<msg @l="2085" char_id="-1" frame_id="-1" name="" text="電話口から、保留音が流れてくる。"
		   voices=""/>
		<msg @l="2086" char_id="-1" frame_id="-1" name=""
		   text="何処かで聞いた事のある穏やかな曲調も、焦った私の気持ちを落ち着かせてはくれない。" voices=""/>
		<msg @l="2087" char_id="-1" frame_id="-1" name="" text="‥‥‥‥‥‥‥‥。" voices=""/>
		<msg @l="2088" char_id="-1" frame_id="-1" name="" text="‥‥‥‥‥‥‥‥‥‥‥‥。"
		   voices=""/>
		<msg @l="2089" char_id="-1" frame_id="-1" name="" text="‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥。"
		   voices=""/>
		<msg @l="2090" char_id="-1" frame_id="-1" name=""
		   text="‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥。" voices=""/>
		<msg @l="2091" char_id="-1" frame_id="-1" name="" text="どれだけ待っただろう。"
		   voices=""/>
		<msg @l="2092" char_id="-1" frame_id="-1" name="" text="時間にしてみればほんの数分‥‥。"
		   voices=""/>
		<msg @l="2093" char_id="-1" frame_id="-1" name="" text="いや、一分も経っていないかもしれない。"
		   voices=""/>
		<msg @l="2094" char_id="-1" frame_id="-1" name=""
		   text="そうして、不安がピークになったその時‥‥。" voices=""/>
		<stopse @l="2097" buf="3"/>
		<msg @l="2099" char_id="-1" frame_id="-1" name="熊野" text="『すみません、お待たせしました。』"
		   voices=""/>
		<char @l="2102" id="miho" pos="auto" src="miho134"/>
		<msg @l="2104" char_id="0" frame_id="-1" name="美帆" text="『あの‥‥亜季奈は？』"
		   voices=""/>
		<msg @l="2106" char_id="-1" frame_id="-1" name="熊野"
		   text="『それが、合宿に来られています方々はもうお休みになっておりました。』" voices=""/>
		<msg @l="2108" char_id="-1" frame_id="-1" name="熊野"
		   text="『明日も朝が早いということで、顧問の先生からは起こさないようにと言われてしまいまして‥‥。』" voices=""/>
		<char @l="2111" id="miho" pos="auto" src="miho136"/>
		<msg @l="2113" char_id="0" frame_id="-1" name="美帆" text="『そうですか‥‥。』"
		   voices=""/>
		<msg @l="2115" char_id="-1" frame_id="-1" name="熊野" text="『申し訳ありませんね。』"
		   voices=""/>
		<msg @l="2117" char_id="0" frame_id="-1" name="美帆"
		   text="『い、いえ‥‥突然で、すみませんでした。』" voices=""/>
		<msg @l="2119" char_id="-1" frame_id="-1" name="熊野" text="『いえいえ、それでは。』"
		   voices=""/>
		<se @l="2122" buf="1" src="携帯ボタン押下音" volume="1."/>
		<msg @l="2124" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="2126" char_id="0" frame_id="-1" name="美帆" text="(そっか‥‥寝ちゃったのか)"
		   voices=""/>
		<msg @l="2128" char_id="0" frame_id="-1" name="美帆"
		   text="(明日、直接会って言うしかないのかな‥‥)" voices=""/>
		<goto @l="2131" label="EventLabel_78"/>
		<label @l="2135" id="EventLabel_77"/>
		<char @l="2138" id="miho" pos="auto" src="miho130"/>
		<msg @l="2140" char_id="0" frame_id="-1" name="美帆" text="『‥‥うん、行こう。』"
		   voices=""/>
		<msg @l="2142" char_id="0" frame_id="-1" name="美帆"
		   text="『こうやって悩んでても仕方ないもんね。』" voices=""/>
		<msg @l="2144" char_id="-1" frame_id="-1" name=""
		   text="何もせず考えているよりは動いた方が不安が少ないような気がする。" voices=""/>
		<clear @l="2147" class="all"/>
		<wait_chgmv/>
		<bg @l="2150" src="bg03b"/>
		<char @l="2153" id="miho" pos="auto" src="miho010"/>
		<msg @l="2155" char_id="0" frame_id="-1" name="美帆"
		   text="『あの‥‥私、ちょっと出かけてきます。』" voices=""/>
		<clear @l="2158" class="char"/>
		<char @l="2160" id="miho" pos="left" src="miho010"/>
		<char @l="2162" id="rei" pos="right" src="rei034"/>
		<msg @l="2164" char_id="1" frame_id="-1" name="玲" text="『え、今から？』" voices=""/>
		<msg @l="2166" char_id="0" frame_id="-1" name="美帆"
		   text="『はい。一時間か二時間くらいで戻ると思います。』" voices=""/>
		<char @l="2169" id="rei" pos="right" src="rei033"/>
		<msg @l="2171" char_id="1" frame_id="-1" name="玲" text="『あ、もしかして深夜の密会？』"
		   voices=""/>
		<char @l="2174" id="miho" pos="left" src="miho016"/>
		<msg @l="2176" char_id="0" frame_id="-1" name="美帆" text="『‥‥違います。』"
		   voices=""/>
		<char @l="2179" id="rei" pos="right" src="rei030"/>
		<msg @l="2181" char_id="1" frame_id="-1" name="玲"
		   text="『あら残念‥‥まあ、気をつけていってらっしゃい。』" voices=""/>
		<msg @l="2183" char_id="1" frame_id="-1" name="玲" text="『深夜の一人歩きは危険だからね。』"
		   voices=""/>
		<msg @l="2185" char_id="0" frame_id="-1" name="美帆" text="『はい‥‥。』" voices=""/>
		<clear @l="2188" class="all"/>
		<wait_chgmv/>
		<bg @l="2193" src="bg07b"/>
		<char @l="2196" id="miho" pos="auto" src="miho116"/>
		<msg @l="2198" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="2200" char_id="-1" frame_id="-1" name="" text="深夜のキャンパスはひと気が無く寂しい。"
		   voices=""/>
		<msg @l="2201" char_id="-1" frame_id="-1" name=""
		   text="正門前にある停留所から、無言のまま歩き続けていた。" voices=""/>
		<msg @l="2202" char_id="-1" frame_id="-1" name=""
		   text="水泳部の子たちが使っている宿舎までは正門から歩いて十分前後。" voices=""/>
		<msg @l="2203" char_id="-1" frame_id="-1" name=""
		   text="この近くもなく遠くもない距離が、逆にもどかしい。" voices=""/>
		<msg @l="2205" char_id="0" frame_id="-1" name="美帆" text="(亜季奈‥‥)" voices=""/>
		<clear @l="2208" class="all"/>
		<msg @l="2210" char_id="-1" frame_id="-1" name="" text="それらしい建物が見えてきた。"
		   voices=""/>
		<msg @l="2211" char_id="-1" frame_id="-1" name=""
		   text="元民宿というだけあって、古臭くてそれらしい外見をしている。" voices=""/>
		<se @l="2214" buf="1" src="扉を開ける音_引き戸" volume="1."/>
		<msg @l="2216" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="2218" char_id="0" frame_id="-1" name="美帆" text="『お、お邪魔しまーす。』"
		   voices=""/>
		<wait_chgmv/>
		<bg @l="2221" src="bg20b"/>
		<char @l="2224" id="miho" pos="auto" src="miho110"/>
		<msg @l="2226" char_id="-1" frame_id="-1" name="" text="中に入って廊下に出る。"
		   voices=""/>
		<msg @l="2227" char_id="-1" frame_id="-1" name=""
		   text="入り口のところで何度か声をかけたのだけれど、反応がない上に扉の鍵が開いていたので入ってきてしまった。" voices=""/>
		<msg @l="2229" char_id="0" frame_id="-1" name="美帆"
		   text="(とりあえず、宿舎についたのはいいけど‥‥)" voices=""/>
		<msg @l="2231" char_id="0" frame_id="-1" name="美帆"
		   text="(勝手に中に入ったコトがバレたら怒られるかな‥‥？)" voices=""/>
		<msg @l="2233" char_id="-1" frame_id="-1" name=""
		   text="うぐいす張り‥‥というわけではないのだろうけれど、老朽化した木製の廊下は歩くたびにキィキィと奇妙なきしみをあげる。"
		   voices=""/>
		<msg @l="2234" char_id="-1" frame_id="-1" name=""
		   text="廊下に並んでいる部屋には灯りが点いていない。" voices=""/>
		<msg @l="2235" char_id="-1" frame_id="-1" name=""
		   text="腕時計で時間を確認しようとしたけれど、ハッキリと読み取れないので諦めた。" voices=""/>
		<msg @l="2237" char_id="0" frame_id="-1" name="美帆" text="(亜季奈‥‥どこかな‥‥‥‥)"
		   voices=""/>
		<msg @l="2239" char_id="-1" frame_id="-1" name="" text="とりあえず廊下を歩いてみる。"
		   voices=""/>
		<msg @l="2240" char_id="-1" frame_id="-1" name="" text="部屋の数が意外と多いことに驚いた。"
		   voices=""/>
		<msg @l="2241" char_id="-1" frame_id="-1" name=""
		   text="左手に続いている部屋はどれも空き部屋で、人の気配がまったくしない。" voices=""/>
		<msg @l="2243" char_id="0" frame_id="-1" name="美帆" text="(あの扉の向こうなのかな‥‥)"
		   voices=""/>
		<clear @l="2246" class="all"/>
		<msg @l="2248" char_id="-1" frame_id="-1" name="" text="廊下の奥に見えている扉に向かってみる。"
		   voices=""/>
		<msg @l="2249" char_id="-1" frame_id="-1" name=""
		   text="木製の扉で、鍵は特についていないようだ。" voices=""/>
		<msg @l="2251" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<wait_chgmv/>
		<bg @l="2254" src="bg20b"/>
		<char @l="2257" id="miho" pos="auto" src="miho110"/>
		<msg @l="2259" char_id="-1" frame_id="-1" name=""
		   text="扉をくぐると、まったく同じ作りの廊下に出た。" voices=""/>
		<msg @l="2260" char_id="-1" frame_id="-1" name=""
		   text="どうやら横長の平屋になっているようで、同じような作りの建物が幾つも直列に連なっているようだ。" voices=""/>
		<msg @l="2262" char_id="0" frame_id="-1" name="美帆" text="(あ‥‥あそこ、灯りが漏れてる)"
		   voices=""/>
		<msg @l="2264" char_id="-1" frame_id="-1" name="" text="部屋の一つから灯りが漏れていた。"
		   voices=""/>
		<msg @l="2265" char_id="-1" frame_id="-1" name="" text="同じ並びの部屋はどれも人気がない。"
		   voices=""/>
		<msg @l="2267" char_id="0" frame_id="-1" name="美帆"
		   text="(亜季奈‥‥いきなり私が来て驚くかな)" voices=""/>
		<msg @l="2269" char_id="0" frame_id="-1" name="美帆"
		   text="(でもまあ、早く伝えておきたかったから‥‥仕方ないよね)" voices=""/>
		<stopbgm @l="2272" fadeout="1000"/>
		<clear @l="2276" class="all"/>
		<label @l="2279" id="event_scene19"/>
		<msg @l="2281" char_id="-1" frame_id="-1" name=""
		   text="とりあえず私は、しのび足で灯りの漏れている部屋に向かうコトにする。" voices=""/>
		<msg @l="2282" char_id="-1" frame_id="-1" name=""
		   text="気をつけて歩いてもキィキィという廊下のきしむ音はどうしようもない。" voices=""/>
		<msg @l="2284" char_id="0" frame_id="-1" name="美帆" text="(なんか私‥‥泥棒さんになった気分)"
		   voices=""/>
		<msg @l="2286" char_id="-1" frame_id="-1" name=""
		   text="一歩、また一歩と灯りの漏れた部屋へ近づいていく。" voices=""/>
		<msg @l="2287" char_id="-1" frame_id="-1" name=""
		   text="部屋からはわずかに人の声が聞こえてくる。" voices=""/>
		<msg @l="2288" char_id="-1" frame_id="-1" name="" text="まだ‥‥眠ってはいないようだ。"
		   voices=""/>
		<msg @l="2290" char_id="0" frame_id="-1" name="美帆"
		   text="(とりあえず、中に亜季奈がいるかどうか確かめて‥‥)" voices=""/>
		<msg @l="2292" char_id="0" frame_id="-1" name="美帆" text="(え‥‥なにこれ！？)"
		   voices=""/>
		<label @l="2295" id="chart_line13"/>
		<wait_chgmv/>
		<ev @l="2298" src="ev-019"/>
		<description @l="2301" text="綻んだ青い果実"/>
		<bgm @l="2304" src="bgm13" volume="1."/>
		<msg @l="2306" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んっ、んんっ‥‥あぐっ‥‥‥‥。』" voices="akina00190"/>
		<msg @l="2308" char_id="-1" frame_id="-1" name="渡部"
		   text="『おうおう、さすがハツモノ‥‥キュウキュウ締めてくるな。』" voices=""/>
		<msg @l="2310" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んぁっ‥‥やっ、ダメぇ‥‥そんな、動いちゃっ‥‥‥んんっ！』" voices="akina00200"/>
		<msg @l="2312" char_id="-1" frame_id="-1" name="留学生" text="『シャブル、モット。』"
		   voices=""/>
		<msg @l="2314" char_id="2" frame_id="-1" name="亜季奈"
		   text="『ふ、ふぁい‥‥‥んぐっ‥‥ちゅぷ‥‥‥‥ンっ、ちゅばっ！』" voices="akina00240"/>
		<msg @l="2316" char_id="-1" frame_id="-1" name="留学生" text="『オォーッ、オーッ！』"
		   voices=""/>
		<msg @l="2318" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んぐっ‥‥‥んっ‥‥‥んん～‥‥‥‥‥‥。』" voices="akina00230"/>
		<msg @l="2320" char_id="-1" frame_id="-1" name="熊野"
		   text="『ほらほら、手がお留守になってますよ。』" voices=""/>
		<msg @l="2322" char_id="2" frame_id="-1" name="亜季奈"
		   text="『うあ‥‥こ、こうですか‥‥‥？&#32;』" voices="akina00210"/>
		<msg @l="2324" char_id="-1" frame_id="-1" name="熊野"
		   text="『ちゃんと、力の加減を考えながら触って欲しいですねぇ。』" voices=""/>
		<msg @l="2326" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んっ、んっ‥‥あぐっ‥‥‥‥う、上手く出来ないよっ‥‥‥‥。』" voices="akina00220"/>
		<msg @l="2328" char_id="-1" frame_id="-1" name="熊野"
		   text="『出来ないじゃありません、やるんですよ。』" voices=""/>
		<msg @l="2330" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』"
		   voices="miho04170"/>
		<msg @l="2332" char_id="-1" frame_id="-1" name=""
		   text="部屋の中で起きている光景が余りにも非現実すぎて、私は言葉を失ったまま見入っていた。" voices=""/>
		<msg @l="2333" char_id="-1" frame_id="-1" name="" text="亜季奈は‥‥何をしているのだろう。"
		   voices=""/>
		<msg @l="2334" char_id="-1" frame_id="-1" name=""
		   text="渡部先生が、例の留学生が、用務員の熊野とかいう男が‥‥亜季奈を囲んで。" voices=""/>
		<msg @l="2335" char_id="-1" frame_id="-1" name="" text="なにを‥‥。" voices=""/>
		<msg @l="2337" char_id="2" frame_id="-1" name="亜季奈"
		   text="『ンぐっ、んんっ‥‥ふぁっ‥‥‥‥あっ、んああっ‥‥‥。』" voices="akina00250"/>
		<msg @l="2339" char_id="2" frame_id="-1" name="亜季奈"
		   text="『いやぁ‥‥あぐっ‥‥‥んっ、ああっっ！！』" voices="akina00260"/>
		<msg @l="2341" char_id="-1" frame_id="-1" name="渡部"
		   text="『そら、あんまり暴れるな‥‥そろそろ薬が効いて痛みもなくなる。』" voices=""/>
		<msg @l="2343" char_id="-1" frame_id="-1" name="渡部"
		   text="『そうしたら‥‥あっという間に天国まで連れてってやるからな。』" voices=""/>
		<msg @l="2345" char_id="-1" frame_id="-1" name="熊野"
		   text="『さすがに処女は効き目が出るまでに時間が掛かりますな。これは少し改良を施した方が良いかもしれませんねぇ。』" voices=""/>
		<msg @l="2347" char_id="-1" frame_id="-1" name="渡部"
		   text="『まあ、最初っから狂ってても面白くないしな。このくらいでちょうどイイんじゃないか？』" voices=""/>
		<msg @l="2349" char_id="-1" frame_id="-1" name="熊野"
		   text="『成る程、それではもう少しデータを採って検討しましょう。』" voices=""/>
		<msg @l="2351" char_id="0" frame_id="-1" name="美帆" text="(くすり‥‥？)"
		   voices="miho04180"/>
		<msg @l="2353" char_id="0" frame_id="-1" name="美帆"
		   text="(亜季奈が、変なクスリを使われて‥‥犯されてる？)" voices="miho04190"/>
		<msg @l="2355" char_id="0" frame_id="-1" name="美帆" text="(亜季奈が‥‥)"
		   voices="miho04200"/>
		<clear @l="2358" class="ev"/>
		<stopbgm @l="2361" fadeout="1000"/>
		<wait_chgmv/>
		<bg @l="2364" src="bg19b"/>
		<char @l="2367" id="miho" pos="auto" src="miho115"/>
		<msg @l="2369" char_id="0" frame_id="-1" name="美帆"
		   text="『あ、アナタたちっ‥‥何をしてるんですかっ！！&#32;』" voices="miho04210"/>
		<msg @l="2371" char_id="-1" frame_id="-1" name=""
		   text="ようやく自分を取り戻した私は、部屋の中へと怒鳴り込む。" voices=""/>
		<bgm @l="2374" src="bgm09" volume="1."/>
		<msg @l="2376" char_id="-1" frame_id="-1" name="渡部" text="『お‥‥？』" voices=""/>
		<msg @l="2378" char_id="-1" frame_id="-1" name="熊野"
		   text="『おやおや、これはまた意外なお客さんですね。』" voices=""/>
		<msg @l="2380" char_id="0" frame_id="-1" name="美帆"
		   text="『こんな、寄ってたかって亜季奈に乱暴するなんてっ‥‥。』" voices="miho04220"/>
		<msg @l="2382" char_id="0" frame_id="-1" name="美帆"
		   text="『しかもクスリを使ってだなんて‥‥！！』" voices="miho04230"/>
		<clear @l="2385" class="char"/>
		<char @l="2387" id="miho" pos="left" src="miho014"/>
		<char @l="2389" id="watab" pos="right" src="watabe010"/>
		<msg @l="2391" char_id="-1" frame_id="-1" name="渡部"
		   text="『なんだ、そんな事まで聞いちまったのか？』" voices=""/>
		<char @l="2394" id="kuma" pos="left" src="kuma010"/>
		<msg @l="2396" char_id="-1" frame_id="-1" name="熊野"
		   text="『これは‥‥素直にお帰り戴く訳にはいきませんねぇ。』" voices=""/>
		<msg @l="2398" char_id="-1" frame_id="-1" name="渡部"
		   text="『せっかく堕とした妹使って追い込んでやろうと思ってたのに、楽しみが一つ減っちまったな。』" voices=""/>
		<msg @l="2400" char_id="-1" frame_id="-1" name="留学生"
		   text="『オウッ、オ、オンナ‥‥オンナ。』" voices=""/>
		<char @l="2403" id="miho" pos="left" src="miho015"/>
		<msg @l="2405" char_id="0" frame_id="-1" name="美帆"
		   text="『アナタたちは、自分が何をしているか自覚していないんですか！？』" voices="miho04240"/>
		<msg @l="2407" char_id="0" frame_id="-1" name="美帆" text="『これは立派な犯罪ですよ！！』"
		   voices="miho04250"/>
		<char @l="2410" id="watab" pos="right" src="watabe014"/>
		<msg @l="2412" char_id="-1" frame_id="-1" name="渡部"
		   text="『足りないのはオマエの方じゃないのか？』" voices=""/>
		<msg @l="2414" char_id="-1" frame_id="-1" name="渡部"
		   text="『犯罪ってのはな、被害者が名乗りでなけりゃ成立しないんだよ。』" voices=""/>
		<msg @l="2416" char_id="0" frame_id="-1" name="美帆"
		   text="『そんなの‥‥私がこのまま警察に‥‥‥‥。』" voices="miho04260"/>
		<char @l="2419" id="watab" pos="right" src="watabe012"/>
		<msg @l="2421" char_id="-1" frame_id="-1" name="渡部"
		   text="『駆け込んで何を言う？&#32;妹がレイプされてましたって言うのか？』" voices=""/>
		<msg @l="2423" char_id="-1" frame_id="-1" name="渡部"
		   text="『自分の時、どうしたのか忘れたのか？』" voices=""/>
		<msg @l="2425" char_id="-1" frame_id="-1" name="渡部"
		   text="『自分がレイプされかけた事はダンマリでも、妹が犯られちまったら公表しちまう訳だ、妹の気持ちを考えずに。』" voices=""/>
		<char @l="2428" id="miho" pos="left" src="miho115"/>
		<msg @l="2430" char_id="0" frame_id="-1" name="美帆" text="『あ‥‥。』"
		   voices="miho04270"/>
		<msg @l="2432" char_id="-1" frame_id="-1" name="熊野"
		   text="『それは果たして得策でしょうかねぇ。』" voices=""/>
		<char @l="2435" id="kuma" pos="right" src="kuma010"/>
		<msg @l="2437" char_id="-1" frame_id="-1" name="熊野"
		   text="『確かに私たちは罪に問われるかもしれませんが、妹さんの人生も大きく狂わされてしまうのではないですか？』" voices=""/>
		<msg @l="2440" char_id="0" frame_id="-1" name="美帆" text="『そ、それは‥‥。』"
		   voices="miho04280"/>
		<msg @l="2442" char_id="-1" frame_id="-1" name="熊野"
		   text="『それに‥‥妹さんが被害者だという証言をするかどうかも、分らないじゃないですか。』" voices=""/>
		<msg @l="2444" char_id="0" frame_id="-1" name="美帆" text="『どういう意味ですか‥‥それ。』"
		   voices="miho04290"/>
		<msg @l="2446" char_id="-1" frame_id="-1" name="熊野"
		   text="『いえね、妹さんはあれでなかなか････楽しんでいるのではないかと。』" voices=""/>
		<char @l="2449" id="miho" pos="left" src="miho014"/>
		<msg @l="2451" char_id="0" frame_id="-1" name="美帆"
		   text="『それはっ‥‥アナタたちが変なクスリなんか使ったからです！』" voices="miho04300"/>
		<msg @l="2453" char_id="-1" frame_id="-1" name="熊野"
		   text="『ですが、暴行や強姦の場合はその本人の証言が一番重要なんです。』" voices=""/>
		<msg @l="2455" char_id="-1" frame_id="-1" name="熊野"
		   text="『本人が被害者であると証言しなかった場合は‥‥例えどんな状況であろうとも和姦なんですよ。』" voices=""/>
		<msg @l="2457" char_id="0" frame_id="-1" name="美帆" text="『そんなっ！！』"
		   voices="miho04310"/>
		<msg @l="2459" char_id="-1" frame_id="-1" name="熊野"
		   text="『でしたら、ご当人に聞いてみますか？』" voices=""/>
		<char @l="2462" id="miho" pos="left" src="miho015"/>
		<msg @l="2464" char_id="0" frame_id="-1" name="美帆" text="『くっ‥‥亜季奈、亜季奈ッ！！』"
		   voices="miho04320"/>
		<msg @l="2466" char_id="0" frame_id="-1" name="美帆"
		   text="『もう大丈夫‥‥私が助けにきたからねっ！？』" voices="miho04330"/>
		<msg @l="2468" char_id="2" frame_id="-1" name="亜季奈"
		   text="『はぁ‥‥はぁ‥‥はぁ‥‥‥‥‥お姉ちゃん‥‥‥？』" voices="akina00270"/>
		<msg @l="2470" char_id="0" frame_id="-1" name="美帆"
		   text="『そうだよ、お姉ちゃんだよ‥‥‥‥だから、もう帰ろう？&#32;』" voices="miho04340"/>
		<msg @l="2472" char_id="2" frame_id="-1" name="亜季奈"
		   text="『ダメ‥‥ダメだよ‥‥‥‥‥だって私、大好きなセンセイとやっとひとつになったんだもん。』" voices="akina00280"/>
		<stopbgm @l="2475" fadeout="1000"/>
		<clear @l="2477" class="char"/>
		<char @l="2479" id="miho" pos="auto" src="miho015"/>
		<msg @l="2481" char_id="0" frame_id="-1" name="美帆" text="『え‥‥？』"
		   voices="miho04350"/>
		<char @l="2484" id="miho" pos="auto" src="miho115"/>
		<msg @l="2486" char_id="0" frame_id="-1" name="美帆" text="『亜季奈‥‥アナタ、なにを‥‥‥。』"
		   voices="miho04360"/>
		<msg @l="2488" char_id="2" frame_id="-1" name="亜季奈"
		   text="『それにね、最初は痛かったけど‥‥なんだか今はムズムズするの。』" voices="akina00290"/>
		<msg @l="2490" char_id="2" frame_id="-1" name="亜季奈"
		   text="『アソコがね‥‥熱くて、ムズムズして‥‥‥‥たまらないの‥‥‥。』" voices="akina00300"/>
		<msg @l="2492" char_id="2" frame_id="-1" name="亜季奈"
		   text="『ねえ、センセイ‥‥‥私、もっとして欲しいよぉ。』" voices="akina00310"/>
		<clear @l="2495" class="char"/>
		<char @l="2497" id="watab" pos="auto" src="watabe010"/>
		<msg @l="2499" char_id="-1" frame_id="-1" name="渡部" text="『‥‥だとさ。』"
		   voices=""/>
		<clear @l="2502" class="char"/>
		<char @l="2504" id="watab" pos="right" src="watabe010"/>
		<char @l="2506" id="miho" pos="left" src="miho015"/>
		<msg @l="2509" char_id="0" frame_id="-1" name="美帆" text="『亜季奈‥‥。』"
		   voices="miho04370"/>
		<char @l="2512" id="kuma" pos="right" src="kuma010"/>
		<msg @l="2514" char_id="-1" frame_id="-1" name="熊野"
		   text="『では、邪魔なアナタにはとりあえずコレを打っておきましょうか。』" voices=""/>
		<flash @l="2517" count="4" fade="100" image="white"/>
		<char @l="2519" id="miho" pos="left" src="miho014"/>
		<msg @l="2521" char_id="0" frame_id="-1" name="美帆" text="『いたっ‥‥‥何、いまのっ！？』"
		   voices="miho04380"/>
		<msg @l="2523" char_id="-1" frame_id="-1" name="" text="首筋に鋭い痛みが走る。"
		   voices=""/>
		<char @l="2525" id="kuma" pos="right" src="kuma012"/>
		<msg @l="2526" char_id="-1" frame_id="-1" name=""
		   text="振り返ると、注射器を手にした熊野が口元を歪ませて立っていた。" voices=""/>
		<msg @l="2528" char_id="-1" frame_id="-1" name="熊野"
		   text="『安心してください、大したクスリじゃありません。』" voices=""/>
		<msg @l="2530" char_id="-1" frame_id="-1" name="熊野"
		   text="『弛緩剤といいましてね、全身に力が入らなくなるだけですから。』" voices=""/>
		<msg @l="2532" char_id="-1" frame_id="-1" name="熊野"
		   text="『ま、打ちすぎると呼吸まで止まっちゃいますがね。』" voices=""/>
		<msg @l="2534" char_id="-1" frame_id="-1" name="" text="そういって熊野は下卑た笑い声を上げる。"
		   voices=""/>
		<char @l="2537" id="miho" pos="left" src="miho015"/>
		<msg @l="2539" char_id="0" frame_id="-1" name="美帆" text="『あ‥‥ああ‥‥‥。』"
		   voices="miho04390"/>
		<clear @l="2542" class="char"/>
		<se @l="2545" buf="1" src="ベッドに倒れこむ音" volume="1."/>
		<char @l="2548" id="watab" pos="left" src="watabe010"/>
		<char @l="2550" id="kuma" pos="right" src="kuma010"/>
		<msg @l="2552" char_id="-1" frame_id="-1" name=""
		   text="薬の効果がもう現れたのか、それとも薬品を注入されたという精神的なショックによる症状なのだろうか。" voices=""/>
		<msg @l="2553" char_id="-1" frame_id="-1" name=""
		   text="私は手足に軽い痺れを感じてその場に座り込んでしまう。" voices=""/>
		<msg @l="2555" char_id="-1" frame_id="-1" name="渡部"
		   text="『まあ、そこで自分の妹が堕ちていく姿をみてるんだな。』" voices=""/>
		<msg @l="2557" char_id="-1" frame_id="-1" name=""
		   text="そう言って渡部先生は座り込んだ私を壁際に転がすと、硬く怒張した男根を誇らしげに眼前に晒す。" voices=""/>
		<msg @l="2559" char_id="2" frame_id="-1" name="亜季奈"
		   text="『センセイ‥‥早くそれで私のアソコを突いてぇ‥‥‥。』" voices="akina00320"/>
		<msg @l="2561" char_id="2" frame_id="-1" name="亜季奈"
		   text="『私、身体がおかしいの‥‥‥熱くて‥‥ムズムズして‥‥‥‥。』" voices="akina00330"/>
		<char @l="2564" id="watab" pos="left" src="watabe012"/>
		<msg @l="2566" char_id="-1" frame_id="-1" name="渡部"
		   text="『ああ、待ってろ‥‥すぐにイキっぱなしにしてやるからな。』" voices=""/>
		<clear @l="2569" class="all"/>
		<wait_chgmv/>
		<ev @l="2572" src="ev-019"/>
		<bgm @l="2575" src="bgm14" volume="1."/>
		<msg @l="2577" char_id="2" frame_id="-1" name="亜季奈" text="『んっ、あああああっ！！』"
		   voices="akina00340"/>
		<msg @l="2579" char_id="-1" frame_id="-1" name=""
		   text="渡部のモノが熱く潤った秘部を貫いた瞬間、亜季奈は震えた声をあげて腰を大きく跳ね上げる。" voices=""/>
		<msg @l="2581" char_id="-1" frame_id="-1" name="渡部"
		   text="『ははっ、突っ込んだだけでイキやがったか。』" voices=""/>
		<msg @l="2583" char_id="-1" frame_id="-1" name="熊野"
		   text="『我ながら‥‥大した効果ですな、この薬は。この薬があればこれからもここと同様の町を作れますねぇ』" voices=""/>
		<msg @l="2585" char_id="-1" frame_id="-1" name="渡部"
		   text="『処女でこの感度とは‥‥かなりの好きもんだなっ！』" voices=""/>
		<msg @l="2587" char_id="2" frame_id="-1" name="亜季奈"
		   text="『あっ、ああっ‥‥‥はっ‥‥‥あふっ‥‥‥‥んっ、あぐぅ！！』" voices="akina00350"/>
		<msg @l="2589" char_id="-1" frame_id="-1" name=""
		   text="幼い蕾の中を渡部の剛直が蹂躙し、ピタリと閉じていた筈の処女孔を押し広げていた。" voices=""/>
		<msg @l="2590" char_id="-1" frame_id="-1" name="" text="亜季奈はビクビクと腰を震わせて悶える。"
		   voices=""/>
		<msg @l="2591" char_id="-1" frame_id="-1" name=""
		   text="耐え難い痛みだというのに、亜季奈の肉壁はヒクヒクっと震え渡部の肉茎に絡みついていた。" voices=""/>
		<msg @l="2593" char_id="-1" frame_id="-1" name="留学生" text="『オーウ、プリーズプリーズ。』"
		   voices=""/>
		<msg @l="2595" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んあああっ‥‥あ、んぐっ‥‥‥ちゅぷ、ちゅむっ、あふっ！！』" voices="akina00360"/>
		<msg @l="2597" char_id="-1" frame_id="-1" name=""
		   text="口元に差し出された留学生のモノに、亜季奈が一心不乱にしゃぶりつく。" voices=""/>
		<msg @l="2598" char_id="-1" frame_id="-1" name=""
		   text="先端を唇で咥え、舌先で裏筋を執拗に舐めまわしながら吸う。" voices=""/>
		<msg @l="2600" char_id="-1" frame_id="-1" name="留学生" text="『オォォウ‥‥グゥーーーッド』"
		   voices=""/>
		<msg @l="2602" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んぷっ、んぷっ、んはっ‥‥‥ぴちゅ、ちゅぱっ‥‥‥んむぅ！』" voices="akina00370"/>
		<msg @l="2604" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んっ、んあっ‥‥‥はふっ、んはっ‥‥‥んっ‥‥ちゅるるっ！！』" voices="akina00380"/>
		<msg @l="2606" char_id="-1" frame_id="-1" name=""
		   text="褒められたことで気を良くしたのだろうか。" voices=""/>
		<msg @l="2607" char_id="-1" frame_id="-1" name=""
		   text="亜季奈は一層激しく肉棒の先端に吸い付き、舌を絡め始める。" voices=""/>
		<msg @l="2608" char_id="-1" frame_id="-1" name=""
		   text="カリの周囲を口をすぼめてしごきあげ、ピチャピチャといやらしい音を立てながら恥垢まで綺麗に舐めとる。" voices=""/>
		<msg @l="2610" char_id="-1" frame_id="-1" name="熊野"
		   text="『さて、もっと強くしごいて貰いましょうか』" voices=""/>
		<msg @l="2612" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んふっ‥‥んぅ‥‥‥‥‥んっ、ああっ‥‥‥‥すごく硬いよぉ。』" voices="akina00390"/>
		<msg @l="2614" char_id="2" frame_id="-1" name="亜季奈"
		   text="『おち○ちん‥‥硬くて、太くて‥‥‥‥んっ、熱い‥‥‥‥。』" voices="akina00400"/>
		<msg @l="2616" char_id="-1" frame_id="-1" name=""
		   text="手に握らされた肉棒を不器用に扱き上げながら、亜季奈はうわ言のように繰り返している。" voices=""/>
		<msg @l="2617" char_id="-1" frame_id="-1" name=""
		   text="虚ろな視線は手元の肉棒に固定され、力の入れ具合で変化する肉茎の変化を楽しんで観察しているようでもあった。" voices=""/>
		<msg @l="2619" char_id="-1" frame_id="-1" name="渡部"
		   text="『そら、熱くて硬いモノは手の中だけじゃないぞっ。』" voices=""/>
		<msg @l="2621" char_id="-1" frame_id="-1" name=""
		   text="手元の肉棒に見入っていた亜季奈を連れ戻すように、渡部が深く腰を押し付けて胎内の奥深くを先端でかき混ぜる。" voices=""/>
		<msg @l="2622" char_id="-1" frame_id="-1" name=""
		   text="更に奥にまで侵入してくる肉棒の刺激に反応するように、肉襞のあちこちから愛液が溢れ出す。" voices=""/>
		<msg @l="2624" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んあっ‥‥あふ‥‥んっ、んっ、んっ‥‥‥。』" voices="akina00410"/>
		<msg @l="2626" char_id="2" frame_id="-1" name="亜季奈"
		   text="『センセイ‥‥ダメ、深すぎっ‥‥‥‥ん、あああっ！！』" voices="akina00420"/>
		<msg @l="2628" char_id="-1" frame_id="-1" name="渡部"
		   text="『何が深すぎだよ、奥まで突っ込むだびに肉壁がヒクヒク震えて絡み付いてきてるぞ？』" voices=""/>
		<msg @l="2630" char_id="2" frame_id="-1" name="亜季奈"
		   text="『だってぇ‥‥‥んん、奥のところ突かれるとっ‥‥‥‥。』" voices="akina00430"/>
		<msg @l="2632" char_id="2" frame_id="-1" name="亜季奈"
		   text="『勝手に、そうなっちゃうんだもん‥‥‥んっ、んんっ！！』" voices="akina00440"/>
		<msg @l="2634" char_id="-1" frame_id="-1" name="渡部"
		   text="『なら、たっぷり奥を突き上げてやらなくちゃな！』" voices=""/>
		<msg @l="2636" char_id="2" frame_id="-1" name="亜季奈"
		   text="『ふああっ‥‥んぅ、あっ、あっ、あっ、ああっ！！』" voices="akina00450"/>
		<msg @l="2638" char_id="2" frame_id="-1" name="亜季奈"
		   text="『そんなにしたらっ‥‥んんっ‥‥‥ダメ、ダメぇっ‥‥‥‥。』" voices="akina00460"/>
		<msg @l="2640" char_id="-1" frame_id="-1" name="渡部"
		   text="『そらっ‥‥何がダメなんだ、言ってみろ。』" voices=""/>
		<msg @l="2642" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んぁっ‥‥‥来るっ、来ちゃうっ‥‥‥熱いの‥‥来ちゃうっ！！』" voices="akina00470"/>
		<msg @l="2644" char_id="-1" frame_id="-1" name="熊野"
		   text="『ほう、ではそれに合わせて全員で‥‥というのはどうです？』" voices=""/>
		<msg @l="2646" char_id="-1" frame_id="-1" name="留学生"
		   text="『オ、オオッ、オォウッ‥‥オーケイ』" voices=""/>
		<msg @l="2648" char_id="-1" frame_id="-1" name="渡部"
		   text="『よーし‥‥それじゃ、しっかり受け止めろよ。』" voices=""/>
		<msg @l="2650" char_id="-1" frame_id="-1" name=""
		   text="そうして渡部は激しく腰を律動させ、亜季奈の胎内をかき混ぜ始める。" voices=""/>
		<msg @l="2651" char_id="-1" frame_id="-1" name=""
		   text="腰を叩きつける度に、亜季奈の胎内からは大量の淫汁が溢れ出し、じゅぷじゅぷと淫猥な音を立てては太ももに零れ落ちていく。"
		   voices=""/>
		<msg @l="2653" char_id="-1" frame_id="-1" name="留学生"
		   text="『オ、オオッ‥‥オーマイガッ！！』" voices=""/>
		<msg @l="2655" char_id="-1" frame_id="-1" name=""
		   text="留学生もならうように、亜季奈の小さな口腔へ巨砲の先端を咥え込ませ、頭をつかんだまま容赦なく腰を激しく打ち込んでいく。"
		   voices=""/>
		<msg @l="2657" char_id="2" frame_id="-1" name="亜季奈"
		   text="『あふっ、んっ‥‥んぐっ‥‥‥んぷ、ちゅぷ、ちゅぷ、ちゅぷっ。』" voices="akina00480"/>
		<msg @l="2659" char_id="2" frame_id="-1" name="亜季奈"
		   text="『ンっ、ちゅぷ‥‥‥じゅぷ、ちゅぱっ、ちゅるるっ‥‥‥んはっ！』" voices="akina00490"/>
		<msg @l="2661" char_id="-1" frame_id="-1" name=""
		   text="亜季奈は突き込まれる巨砲の勢いに戸惑ったものの、すぐに舌先を絡め、唇で扱き上げる。" voices=""/>
		<msg @l="2663" char_id="-1" frame_id="-1" name="熊野"
		   text="『では、こちらも最後まで導いてもらいましょうか。』" voices=""/>
		<msg @l="2665" char_id="-1" frame_id="-1" name=""
		   text="小さな手にしごかせていた熊野は、そのぎこちなさにたまらなくなったのか、亜季奈の手の上に自分の手を被せて激しくしごいている。"
		   voices=""/>
		<msg @l="2667" char_id="2" frame_id="-1" name="亜季奈"
		   text="『ちゅぷっ‥‥んぷっ‥‥んぷっ‥‥‥‥ん、んはっっ。』" voices="akina00500"/>
		<msg @l="2669" char_id="2" frame_id="-1" name="亜季奈"
		   text="『ダメぇ‥‥‥もっ‥‥我慢できなっ‥‥‥い、あっ、んんっ！！』" voices="akina00510"/>
		<msg @l="2671" char_id="-1" frame_id="-1" name="渡部"
		   text="『よぉし、俺もそろそろいくぞ‥‥中にいっぱい出してやるからな。』" voices=""/>
		<msg @l="2673" char_id="-1" frame_id="-1" name="熊野" text="『私も‥‥もうすぐですからねぇ。』"
		   voices=""/>
		<msg @l="2675" char_id="-1" frame_id="-1" name="留学生" text="『オオーッ！オアアアァーッ』"
		   voices=""/>
		<msg @l="2677" char_id="2" frame_id="-1" name="亜季奈"
		   text="『ちゅううっ‥‥‥んぐっ、んぷっ、んぷっ‥‥‥ちゅむっっ！！』" voices="akina00520"/>
		<msg @l="2679" char_id="-1" frame_id="-1" name=""
		   text="男たちが口々に限界を訴え、息を弾ませる。" voices=""/>
		<msg @l="2680" char_id="-1" frame_id="-1" name=""
		   text="そうして男たちの限界を感じた亜季奈も‥‥それまでこらえ続けていた絶頂に身を委ねて腰を震わせた。" voices=""/>
		<msg @l="2682" char_id="2" frame_id="-1" name="亜季奈"
		   text="『ふはぁっ‥‥ダメぇ、来る、来ちゃうっ‥‥‥く、ああああっ！！』" voices="akina00530"/>
		<flash @l="2685" count="4" fade="100" image="white"/>
		<wait_chgmv/>
		<ev @l="2688" src="ev-019x1z1"/>
		<msg @l="2690" char_id="-1" frame_id="-1" name=""
		   text="一斉に白濁色の液体が放たれ、亜季奈の身体を白く汚していく。" voices=""/>
		<msg @l="2691" char_id="-1" frame_id="-1" name=""
		   text="渡部は亜季奈の胎内奥深くへ大量の精を打ち込み、熊野は亜季奈の口元へ肉棒を寄せていき精液を振り掛ける。" voices=""/>
		<msg @l="2692" char_id="-1" frame_id="-1" name=""
		   text="留学生は‥‥顔や胸、亜季奈の身体にこれでもかと言わんばかりに、大量の精液を撒き散らしている。" voices=""/>
		<msg @l="2694" char_id="-1" frame_id="-1" name="熊野"
		   text="『さあ、ちゃんと全部飲んでください。』" voices=""/>
		<msg @l="2696" char_id="-1" frame_id="-1" name="熊野"
		   text="『奥にも残っていますから‥‥吸い出すのも忘れてはいけませんよ。』" voices=""/>
		<msg @l="2698" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んぁっ‥‥‥ん、んくっ‥‥‥ちゅぷ‥‥んくっ、んくっ‥‥‥。』" voices="akina00540"/>
		<msg @l="2700" char_id="2" frame_id="-1" name="亜季奈"
		   text="『あふっ、んっ‥‥ちゅぷ‥‥‥んぷ‥‥んぷ‥‥‥‥‥んぐっ。』" voices="akina00550"/>
		<msg @l="2702" char_id="-1" frame_id="-1" name=""
		   text="亜季奈は命じられるままに口腔内の精液を飲み下し、さらには怒張の奥にある残滓までも吸い出していく。" voices=""/>
		<msg @l="2703" char_id="-1" frame_id="-1" name=""
		   text="既に亜季奈の表情に理性のカケラもなく‥‥。" voices=""/>
		<msg @l="2704" char_id="-1" frame_id="-1" name=""
		   text="ただ、命じられたことを淡々とこなすその姿は人形のようであった。" voices=""/>
		<stopbgm @l="2707" fadeout="1000"/>
		<clear @l="2710" class="all"/>
		<msg @l="2712" char_id="0" frame_id="-1" name="美帆" text="(亜季奈‥‥ごめんね‥‥‥‥)"
		   voices="miho04400"/>
		<msg @l="2714" char_id="-1" frame_id="-1" name=""
		   text="そうして汚される亜季奈の姿に耐え切れなくなった私は、震える瞼をゆっくりと閉じた。" voices=""/>
		<msg @l="2715" char_id="-1" frame_id="-1" name="" text="現実のすべてから‥‥目を背るように。"
		   voices=""/>
