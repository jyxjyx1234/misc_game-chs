<?xml version="1.0" encoding="utf-8"?>
<xscript>
	<debug editor="&quot;C:\Program&#32;Files&#32;(x86)\sakura\sakura.exe&quot;&#32;&quot;%src%&quot;&#32;-Y=%line%"
	   src="D:\シロップ\町ぐるみの罠＋汚された夏セット版\汚された夏\完成データ\汚された夏\script\text\ending02.txt"/>
	<code>
		<label @l="12" id="EventLabel_40"/>
		<description @l="16" text="水泳部の共用ペット"/>
		<eval @l="18" expr="f.numDay=0&#13;&#10;"/>
		<msg @l="22" char_id="-1" frame_id="-1" name="" text="それから‥‥。" voices=""/>
		<wait_chgmv/>
		<bg @l="26" src="bg10b"/>
		<msg @l="28" char_id="-1" frame_id="-1" name="" text="二日が経っていた。" voices=""/>
		<msg @l="29" char_id="-1" frame_id="-1" name="" text="私は、今も毎日のようにプールへ通っている。"
		   voices=""/>
		<msg @l="30" char_id="-1" frame_id="-1" name="" text="亜季奈のいない、あのプールへ。"
		   voices=""/>
		<char @l="34" id="watab" pos="left" src="watabe010"/>
		<char @l="37" id="miho" pos="right" src="miho060"/>
		<bgm @l="41" src="bgm10" volume="1."/>
		<msg @l="43" char_id="-1" frame_id="-1" name="渡部"
		   text="『よし、今日の練習はこの辺までにしておくか。』" voices=""/>
		<msg @l="45" char_id="-1" frame_id="-1" name=""
		   text="プール内に渡部の声が響き渡ると、それを待っていたかのように水泳部の男子全員が口元をニヤけさせて私のほうを見る。" voices=""/>
		<msg @l="46" char_id="-1" frame_id="-1" name=""
		   text="女の子達は皆、侮蔑や呆れた表情を浮かべてプールを出て行く。" voices=""/>
		<msg @l="47" char_id="-1" frame_id="-1" name="" text="それもそのハズだろう‥‥。"
		   voices=""/>
		<msg @l="48" char_id="-1" frame_id="-1" name=""
		   text="彼女達は、練習後に私たちが何をしているのか知っている。" voices=""/>
		<msg @l="49" char_id="-1" frame_id="-1" name="" text="普通の人なら、当然の反応だ。"
		   voices=""/>
		<msg @l="51" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』"
		   voices="miho11100"/>
		<msg @l="53" char_id="-1" frame_id="-1" name=""
		   text="部員の中には合宿に参加しなくなった子もいるし、何人かはこの馬鹿馬鹿しい行いに堪えかねて、水泳部を辞めてしまったという話も聞いた。"
		   voices=""/>
		<msg @l="54" char_id="-1" frame_id="-1" name=""
		   text="あの日、プールサイドで、私をオカズにして自慰にふけっていた子も‥‥聞くところによると水泳部を辞めてしまったらしい。"
		   voices=""/>
		<msg @l="55" char_id="-1" frame_id="-1" name=""
		   text="私に好意を抱いていたのだと、残った部員の誰かが言っていた。" voices=""/>
		<msg @l="56" char_id="-1" frame_id="-1" name=""
		   text="しかしそれも、今となってはどうでもいい事だ。" voices=""/>
		<msg @l="58" char_id="-1" frame_id="-1" name="渡部"
		   text="『今日も仲根コーチが、お前たちの疲れを癒してくれるからな。その分しっかり練習して記録を伸ばせよ。』" voices=""/>
		<msg @l="60" char_id="-1" frame_id="-1" name="水泳部の男子" text="『はい！』" voices=""/>
		<stopbgm @l="64" fadeout="1000"/>
		<clear @l="70" class="all"/>
		<label @l="73" id="event_scene37"/>
		<msgshow @l="76" show="true"/>
		<label @l="80" id="chart_line25"/>
		<wait_chgmv/>
		<ev @l="84" src="ev-037"/>
		<bgm @l="88" src="bgm14" volume="1."/>
		<msg @l="90" char_id="0" frame_id="-1" name="美帆"
		   text="『んっ‥‥んっ‥‥‥んぐっ‥‥‥‥‥ふぁっ。』" voices="miho11110"/>
		<msg @l="92" char_id="-1" frame_id="-1" name="" text="これで何回目になるだろう。"
		   voices=""/>
		<msg @l="93" char_id="-1" frame_id="-1" name=""
		   text="私は口腔内に放たれた生臭い液体を、命じられるまま飲み干していく。" voices=""/>
		<msg @l="94" char_id="-1" frame_id="-1" name=""
		   text="練習中は指導する側の私も、練習後は彼等に逆らう事が許されない。" voices=""/>
		<msg @l="96" char_id="-1" frame_id="-1" name="水泳部の子Ａ"
		   text="『ほら。休んでないで、次は僕の番だよ。』" voices=""/>
		<msg @l="98" char_id="0" frame_id="-1" name="美帆"
		   text="『はい‥‥‥あむっ‥‥‥‥ン、んぐっ‥‥‥‥‥。』" voices="miho11120"/>
		<msg @l="100" char_id="-1" frame_id="-1" name=""
		   text="口元に新しいモノが差し出されると、私は言われるままにそれを咥える。" voices=""/>
		<msg @l="101" char_id="-1" frame_id="-1" name=""
		   text="初めは鼻についていた塩素臭さも、喉奥に残っている精液のそれに比べれば、殆ど気にならない。" voices=""/>
		<msg @l="103" char_id="-1" frame_id="-1" name="水泳部の子Ｂ"
		   text="『なんだよ、せっかくいい感じで締めつけてたのに‥‥咥えさせたら気が散って緩くなっちゃったジャン。』" voices=""/>
		<msg @l="105" char_id="-1" frame_id="-1" name="水泳部の子Ａ"
		   text="『だったらお前もフェラチオしてもらえよ。こいつ最近やっと舌の使い方覚えてきてイイ感じだぜ？』" voices=""/>
		<msg @l="107" char_id="-1" frame_id="-1" name="渡部"
		   text="『お前らまだまだガキだな‥‥処女マ○コもよかったが、やっぱ男ならアナルだろ。この入り口の締め付け、たまんねえなぁ。』"
		   voices=""/>
		<msg @l="109" char_id="-1" frame_id="-1" name=""
		   text="私は口と秘裂、そしてお尻の穴までを使い奉仕していた。" voices=""/>
		<msg @l="110" char_id="-1" frame_id="-1" name=""
		   text="渡部先生は、お尻を好むようになり、最近はそっちの方ばかりを責め立てる。" voices=""/>
		<msg @l="111" char_id="-1" frame_id="-1" name=""
		   text="口々に卑猥な台詞を吐き掛けては、好き勝手に私の身体を蹂躙する。" voices=""/>
		<msg @l="112" char_id="-1" frame_id="-1" name=""
		   text="そのやり取りには罪悪感や同情といったモノが欠片も見当たらない。" voices=""/>
		<msg @l="114" char_id="0" frame_id="-1" name="美帆"
		   text="『ンンっ‥‥‥んむ、あふっ‥‥‥‥んっ、んっ、んむっ‥‥‥。』" voices="miho11130"/>
		<msg @l="115" char_id="-1" frame_id="-1" name=""
		   text="咥えさせていた子が、私の頭に添えていた手で私を乱暴に引き剥がす。" voices=""/>
		<msg @l="117" char_id="-1" frame_id="-1" name="水泳部の子Ａ"
		   text="『おいおいナマケてないでちゃんと舐めろよ。それになるべくピチャピチャ音立ててやらしく啜れって教えただろ？&#32;手は使うな、口と舌だけだ。』"
		   voices=""/>
		<msg @l="119" char_id="0" frame_id="-1" name="美帆"
		   text="『んはっ‥‥す、すみません‥‥‥‥んむ、んっ‥‥‥ちゅるっ。』" voices="miho11140"/>
		<msg @l="121" char_id="-1" frame_id="-1" name=""
		   text="慌てて亀頭を含み直し、舌を絡め鈴口を啜り上げる。" voices=""/>
		<msg @l="122" char_id="-1" frame_id="-1" name=""
		   text="唾液をカリの傘に集め、そして音が洩れるように口に隙間を作る。" voices=""/>
		<msg @l="123" char_id="-1" frame_id="-1" name="" text="言われた通りに音を立て、それを繰り返す。"
		   voices=""/>
		<msg @l="125" char_id="-1" frame_id="-1" name="水泳部の子Ｂ"
		   text="『うわ、指示こまけーでやんの。』" voices=""/>
		<msg @l="127" char_id="-1" frame_id="-1" name="水泳部の子Ａ"
		   text="『ばーか、調教すんならこのくらい当然だって。』" voices=""/>
		<msg @l="129" char_id="-1" frame_id="-1" name="渡部"
		   text="『はははっ、言うようになったな。先生はうれしいぞ。』" voices=""/>
		<msg @l="131" char_id="-1" frame_id="-1" name="水泳部の子Ａ"
		   text="『あ、ありがとうございます！』" voices=""/>
		<msg @l="133" char_id="0" frame_id="-1" name="美帆"
		   text="『ん、んんっ‥‥‥あふっ、んっ‥‥‥ちゅぶ、んぐ‥‥ちゅぱっ。』" voices="miho11150"/>
		<msg @l="135" char_id="-1" frame_id="-1" name=""
		   text="そんな会話を聞きながら、私は指示通りに頭を、腰を振り続けた。" voices=""/>
		<msg @l="137" char_id="0" frame_id="-1" name="美帆"
		   text="『んっ、んっ、んっ、んっ‥‥‥んはっ‥‥‥あっ、んんっ！！』" voices="miho11160"/>
		<msg @l="139" char_id="-1" frame_id="-1" name=""
		   text="不意の下からの突き上げが子宮口を突き、下腹部を甘い痺れが襲う。" voices=""/>
		<msg @l="140" char_id="-1" frame_id="-1" name="" text="思わず咥えていたモノを放してしまう。"
		   voices=""/>
		<msg @l="141" char_id="-1" frame_id="-1" name=""
		   text="溜め込んでいた唾液は口端から溢れ出し、下で突き上げる子の胸に滴り落ちる。" voices=""/>
		<msg @l="143" char_id="-1" frame_id="-1" name="水泳部の子Ａ"
		   text="『あ、おい‥‥あんまり激しく突くから吐き出しちゃっただろ。』" voices=""/>
		<msg @l="145" char_id="-1" frame_id="-1" name="水泳部の子Ｂ"
		   text="『お前の調教ごっこになんか付き合ってられっかよ。それより涎、垂らすなよ！&#32;キタネェだろうがっ！』" voices=""/>
		<msg @l="147" char_id="-1" frame_id="-1" name=""
		   text="秘部の方へ入れていた子が、そう言うと、更に激しく子宮を突き上げてくる。" voices=""/>
		<msg @l="148" char_id="-1" frame_id="-1" name=""
		   text="腰を微妙に動かし、私の膣中を色んな方向に暴れる。" voices=""/>
		<msg @l="149" char_id="-1" frame_id="-1" name=""
		   text="広がった傘の部分が、時折、私の弱い部分を引っかき擦り上げた。" voices=""/>
		<msg @l="150" char_id="-1" frame_id="-1" name=""
		   text="傘に襞が巻き込まれ、滲み出る愛液が秘裂の隙間から掻き出される。" voices=""/>
		<msg @l="152" char_id="0" frame_id="-1" name="美帆"
		   text="『んぁぁっ‥‥あっ、んあっ‥‥‥んっ、んっ、んんっ！！』" voices="miho11170"/>
		<msg @l="154" char_id="-1" frame_id="-1" name="水泳部の子Ｂ"
		   text="『おー、よがってるよがってる。』" voices=""/>
		<msg @l="156" char_id="-1" frame_id="-1" name=""
		   text="渡部先生のゆっくりな、そして長いストロークが菊座を熱くする。" voices=""/>
		<msg @l="157" char_id="-1" frame_id="-1" name="" text="排泄感と挿入感が、私を高ぶらせる。"
		   voices=""/>
		<msg @l="158" char_id="-1" frame_id="-1" name=""
		   text="私のお尻と渡部先生の腰が密着すると、子宮が直腸から押し上げられ、一瞬、息が詰まる。" voices=""/>
		<msg @l="160" char_id="-1" frame_id="-1" name="渡部"
		   text="『おおっ！&#32;いい感じだ。‥‥壁一枚隔ててこっちまでゴリゴリくるぜ。』" voices=""/>
		<msg @l="162" char_id="-1" frame_id="-1" name="水泳部の子Ｂ"
		   text="『これぞ二穴責めの醍醐味ってヤツですよね。』" voices=""/>
		<msg @l="164" char_id="-1" frame_id="-1" name="渡部"
		   text="『そうだ。それじゃあ仲根コーチに、俺達師弟コンビの凄さを味わってもらう事にするか。』" voices=""/>
		<msg @l="166" char_id="-1" frame_id="-1" name="水泳部の子Ｂ" text="『はいっ。』"
		   voices=""/>
		<msg @l="168" char_id="-1" frame_id="-1" name=""
		   text="直腸に打ち込まれた剛直に、下からの肉棒が激しくぶつかる。" voices=""/>
		<msg @l="169" char_id="-1" frame_id="-1" name=""
		   text="陰茎に摘み上げられ膣壁がこすり合わせられる。" voices=""/>
		<msg @l="170" char_id="-1" frame_id="-1" name=""
		   text="タイミングを合わせた交互の突き上げに、子宮が揺さぶられ、目の奥がチカチカとする。" voices=""/>
		<msg @l="172" char_id="0" frame_id="-1" name="美帆"
		   text="『ダメっ‥‥それ、後ろのと擦れちゃって‥‥‥‥ん、あぐっ！！』" voices="miho11180"/>
		<msg @l="174" char_id="-1" frame_id="-1" name=""
		   text="私の言葉を遮るように渡部先生の動きが激しくなった。" voices=""/>
		<msg @l="176" char_id="-1" frame_id="-1" name="渡部"
		   text="『仲根コーチ。よがってばかりじゃいつまでも終わらんぞ？』" voices=""/>
		<msg @l="178" char_id="-1" frame_id="-1" name=""
		   text="そう言いながら胸の先端を摘み上げる。乳首は事が始まる前から既に充血していた。" voices=""/>
		<msg @l="180" char_id="-1" frame_id="-1" name="渡部"
		   text="『乳首をボッキさせてるヒマがあるんだったら、マ○コとアナルを締め付けろっ！』" voices=""/>
		<msg @l="182" char_id="-1" frame_id="-1" name="水泳部の子Ｂ"
		   text="『せっかく早く終わるよう、僕はコーチに協力してるんですよ？&#32;それなのにコーチは一人だけ感じてるんですか？&#32;ひどいなぁ。』"
		   voices=""/>
		<msg @l="184" char_id="-1" frame_id="-1" name="渡部"
		   text="『全く、淫乱でだらしないコーチだな。もっと時間を掛けてちゃんと指導してやらねえとダメか？』" voices=""/>
		<msg @l="186" char_id="0" frame_id="-1" name="美帆"
		   text="『んっ、んんっ‥‥‥んぶっ‥‥‥‥‥ん、ちゅぶ、ちゅるるっ。』" voices="miho11190"/>
		<msg @l="188" char_id="-1" frame_id="-1" name="" text="渡部の言葉を聞いてゾッとした。"
		   voices=""/>
		<msg @l="189" char_id="-1" frame_id="-1" name=""
		   text="以前、指導という名目で、朝まで犯され続けたのだ。" voices=""/>
		<msg @l="190" char_id="-1" frame_id="-1" name=""
		   text="途中、気絶していたが、その間も犯されていた。" voices=""/>
		<msg @l="191" char_id="-1" frame_id="-1" name=""
		   text="目を覚ました時は、子宮もアナルもパンパンに満たされており、お腹を押されると音を立てて精液が噴き出した。" voices=""/>
		<msg @l="192" char_id="-1" frame_id="-1" name="" text="二度と体験したくない陰惨な記憶が蘇る。"
		   voices=""/>
		<msg @l="194" char_id="0" frame_id="-1" name="美帆"
		   text="『んふっ、はふっ‥‥‥んぐ‥‥んぷ、んぷ‥‥‥んはっ！！』" voices="miho11200"/>
		<msg @l="196" char_id="-1" frame_id="-1" name="水泳部の子Ａ"
		   text="『お、いいねぇ～、自分からしゃぶり始めた。そうそう、奉仕は自主的じゃないと。』" voices=""/>
		<msg @l="198" char_id="-1" frame_id="-1" name="水泳部の子Ｂ"
		   text="『こっちも、具合が急に良くなったよ。さすがコーチ、やれば出来るんじゃないですか。』" voices=""/>
		<msg @l="200" char_id="0" frame_id="-1" name="美帆"
		   text="『んむぅぅっ‥‥‥んっ、んぐっ‥‥‥はふっ、ちゅぷっ！』" voices="miho11210"/>
		<msg @l="202" char_id="-1" frame_id="-1" name="水泳部の子Ａ"
		   text="『どうです？&#32;美味いですか？&#32;僕のチ○ポは。』" voices=""/>
		<msg @l="204" char_id="0" frame_id="-1" name="美帆"
		   text="『ふぁっ‥‥ん、んんっ‥‥‥‥ちゅぷ、んっ‥‥んぷ、んぷっ！』" voices="miho11220"/>
		<msg @l="206" char_id="-1" frame_id="-1" name="渡部"
		   text="『チ○ポが美味すぎて、返事できねぇってか？&#32;ハハッ！』" voices=""/>
		<msg @l="208" char_id="-1" frame_id="-1" name=""
		   text="前と後ろの双方を激しく突き上げられながらも、私は口腔に含まされた陰茎の先端を必死に吸い上げる。" voices=""/>
		<msg @l="209" char_id="-1" frame_id="-1" name=""
		   text="喉奥まで咥え込み、喉を動かし締め付け、唇で陰嚢をはみつまむ。" voices=""/>
		<msg @l="211" char_id="-1" frame_id="-1" name=""
		   text="下半身は下腹部に力を込めて、膣とアナルを同時に締め上げる。" voices=""/>
		<msg @l="212" char_id="-1" frame_id="-1" name=""
		   text="返ってくる刺激が強くなるが、こうしないといつまでも責め続けられてしまう。" voices=""/>
		<msg @l="214" char_id="-1" frame_id="-1" name=""
		   text="この悪夢のような時間を終わらせる方法はただひとつ。" voices=""/>
		<msg @l="215" char_id="-1" frame_id="-1" name=""
		   text="やれる限りの方法で満足させ彼等を早くイカせること。" voices=""/>
		<msg @l="216" char_id="-1" frame_id="-1" name="" text="それしか方法は‥‥無いのだから‥‥。"
		   voices=""/>
		<msg @l="218" char_id="-1" frame_id="-1" name="水泳部の子Ａ"
		   text="『おお、すげぇ舌使い‥‥。も、もっと喉元まで、飲み込んで････。』" voices=""/>
		<msg @l="220" char_id="-1" frame_id="-1" name="渡部"
		   text="『こっちも、腰動かすたんびにケツ穴の肉が柔らかくなってイイ感じになってきたぞ。腸液もだいぶ馴染んできたみたいだしな。』"
		   voices=""/>
		<msg @l="222" char_id="-1" frame_id="-1" name="水泳部の子Ｂ"
		   text="『いいぜぇ、絡み付いてくるのが最高だ。』" voices=""/>
		<msg @l="224" char_id="0" frame_id="-1" name="美帆"
		   text="『んんっ‥‥んっ、んくっ‥‥‥はふっ‥‥‥ん、んぐっっ。』" voices="miho11230"/>
		<msg @l="226" char_id="0" frame_id="-1" name="美帆"
		   text="『はっ‥‥はっ‥‥‥‥あむっ‥‥‥んぐっ、ちゅぷ、ちゅぷぷっ！』" voices="miho11240"/>
		<msg @l="228" char_id="-1" frame_id="-1" name="水泳部の子Ａ"
		   text="『おおっ‥‥‥そろそろいくぞ、いくぞっ！？』" voices=""/>
		<msg @l="230" char_id="-1" frame_id="-1" name="水泳部の子Ｂ"
		   text="『お、俺も‥‥もうちょいで出そうだ。』" voices=""/>
		<msg @l="232" char_id="-1" frame_id="-1" name="渡部" text="『よぉし、全員で一斉に射精すぞ！』"
		   voices=""/>
		<msg @l="234" char_id="-1" frame_id="-1" name=""
		   text="喉の、襞の、腸壁の粘膜をこそげ落とそうとするようにエラが張り出す。" voices=""/>
		<msg @l="236" char_id="0" frame_id="-1" name="美帆"
		   text="『あふっ、んっ、んっ、んんっ‥‥‥あっ、んくっっ！！』" voices="miho11250"/>
		<msg @l="238" char_id="0" frame_id="-1" name="美帆"
		   text="『んぷっ‥‥ちゅぷ、んぐっ‥‥‥ン、んぷっ‥‥‥ちゅるるっ！』" voices="miho11260"/>
		<msg @l="240" char_id="-1" frame_id="-1" name="水泳部の子たち" text="『くっ‥‥！！』"
		   voices=""/>
		<msg @l="242" char_id="-1" frame_id="-1" name="渡部" text="『うおっ！！』" voices=""/>
		<wait_chgmv/>
		<ev @l="246" src="ev-037z1"/>
		<msg @l="248" char_id="0" frame_id="-1" name="美帆" text="『んぅっ‥‥！！』"
		   voices="miho11270"/>
		<msg @l="250" char_id="-1" frame_id="-1" name="" text="３人が私にしがみ付き、密着した。"
		   voices=""/>
		<msg @l="251" char_id="-1" frame_id="-1" name="" text="息を止めて食道に流し込む。"
		   voices=""/>
		<msg @l="252" char_id="-1" frame_id="-1" name=""
		   text="曲がっている直腸を真っ直ぐにしてＳ字結腸に吹き付けられる。" voices=""/>
		<msg @l="253" char_id="-1" frame_id="-1" name=""
		   text="子宮口にピッタリ張り付いた鈴口から直接、子宮を叩たかれる。" voices=""/>
		<msg @l="254" char_id="-1" frame_id="-1" name=""
		   text="一滴も漏らすまいと、私の限界まで入り込み、精液が侵入してくる。" voices=""/>
		<msg @l="255" char_id="-1" frame_id="-1" name="" text="と、私も同時に絶頂を迎えた。"
		   voices=""/>
		<msg @l="256" char_id="-1" frame_id="-1" name=""
		   text="頭の中が真っ白に、喉から、アナルから、子宮から広がる快感に････。" voices=""/>
		<msg @l="257" char_id="-1" frame_id="-1" name=""
		   text="流れ込む精液の熱さと量をそれぞれの場所で感じ、打ち震えながら････。" voices=""/>
		<msg @l="260" char_id="-1" frame_id="-1" name="水泳部の子Ａ"
		   text="『ほら‥‥全部飲んだらちゃんと綺麗にしろよな。』" voices=""/>
		<msg @l="262" char_id="-1" frame_id="-1" name="" text="私に休むことは許されない。"
		   voices=""/>
		<msg @l="263" char_id="-1" frame_id="-1" name="" text="すぐに次の奉仕を強要される。"
		   voices=""/>
		<msg @l="265" char_id="0" frame_id="-1" name="美帆"
		   text="『んっ‥‥んくっ‥‥‥‥はぁ‥‥‥はぁ‥‥‥‥‥はい‥‥‥‥。』" voices="miho11280"/>
		<msg @l="267" char_id="0" frame_id="-1" name="美帆"
		   text="『あふっ、んっ‥‥ちゅぷ‥‥‥れろ‥‥れろ‥‥‥ちゅるるっ。』" voices="miho11290"/>
		<msg @l="269" char_id="-1" frame_id="-1" name=""
		   text="私は肩で荒く呼吸を繰り返しながら、差し出された先端に再び吸い付く。" voices=""/>
		<msg @l="270" char_id="-1" frame_id="-1" name=""
		   text="そうして尿道に残った精の残滓まで綺麗に吸い尽くし‥‥飲み下した。" voices=""/>
		<msg @l="272" char_id="-1" frame_id="-1" name="渡部"
		   text="『それが終わったら、次は俺のを綺麗にしてくれ。なんせ、おまえのケツの中に入ってたからなぁ。』" voices=""/>
		<msg @l="274" char_id="-1" frame_id="-1" name="水泳部の子Ｂ" text="『俺のもね～。』"
		   voices=""/>
		<msg @l="276" char_id="-1" frame_id="-1" name=""
		   text="答えることなく、私はただ精子を舐め取り続けた･･････。" voices=""/>
		<stopbgm @l="280" fadeout="1000"/>
		<clear @l="284" class="ev"/>
		<wait_chgmv/>
		<bg @l="288" src="bg10b"/>
		<stopbgm @l="292" fadeout="1000"/>
		<msg @l="294" char_id="-1" frame_id="-1" name="水泳部の子Ａ"
		   text="『ふー、やっぱフェラは最高だな。』" voices=""/>
		<msg @l="296" char_id="-1" frame_id="-1" name="水泳部の子Ｂ"
		   text="『ばーか、マ○コに中出しこそ男のロマンだっての。』" voices=""/>
		<msg @l="298" char_id="-1" frame_id="-1" name="渡部"
		   text="『マ○コも良かったが、それ以上に尻穴がいい感じにこなれてきたな。』" voices=""/>
		<msg @l="300" char_id="-1" frame_id="-1" name=""
		   text="行為が終わると、それまで熱心に私の身体を犯していた水泳部の子たちと渡部先生は帰ってゆく。" voices=""/>
		<msg @l="301" char_id="-1" frame_id="-1" name=""
		   text="それから順番を待っていた次の子達が‥‥私の身体を貪る。" voices=""/>
		<msg @l="302" char_id="-1" frame_id="-1" name="" text="まだまだ部員はいる。" voices=""/>
		<msg @l="303" char_id="-1" frame_id="-1" name="" text="これが私の毎日。" voices=""/>
		<msg @l="304" char_id="-1" frame_id="-1" name="" text="これが私の日常。" voices=""/>
		<msg @l="305" char_id="-1" frame_id="-1" name="" text="私はもう‥‥戻れない。"
		   voices=""/>
		<msg @l="307" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』"
		   voices="miho11300"/>
		<msg @l="309" char_id="0" frame_id="-1" name="美帆" text="(亜季奈‥‥私、がんばるから‥‥‥)"
		   voices="miho11310"/>
		<msg @l="311" char_id="0" frame_id="-1" name="美帆" text="(まもって‥‥みせるから‥‥‥)"
		   voices="miho11320"/>
		<msg @l="313" char_id="-1" frame_id="-1" name=""
		   text="精液で汚れた秘部へ、ようやく閉じたアナルに、再び侵入してくる男根の感触に腰を震わせながら、私は心の中でつぶやいていた‥‥。"
		   voices=""/>
		<stopbgm @l="317" fadeout="1000"/>
		<clear @l="323" class="all"/>
		<end_scene @l="326"/>
		<eval @l="330" expr="s.flagGallery=1&#13;&#10;"/>
		<eval @l="332" expr="s.event37flag=1&#13;&#10;"/>
		<eval @l="336"
		   expr="f.bEx&#32;=&#32;s.event20flag&#32;&amp;&amp;&#32;s.event23flag&#32;&amp;&amp;&#32;s.event25flag&#32;&amp;&amp;&#32;s.event30flag&#32;&amp;&amp;&#32;s.event31flag&#32;&amp;&amp;&#32;s.event32flag&#32;&amp;&amp;&#32;s.event33flag&#32;&amp;&amp;&#32;s.event35flag&#32;&amp;&amp;&#32;s.event37flag&#32;&amp;&amp;&#32;s.event38flag&#32;&amp;&amp;&#32;s.event60flag&#13;&#10;"/>
		<goto @l="338" cond="!(f.bEx)&#13;&#10;" label="TempLabel_228"/>
		<eval @l="340" expr="s.exRootFlag=1&#13;&#10;"/>
		<label @l="341" id="TempLabel_228"/>
		<ending @l="343"/>
		<goto @l="345" cond="!(f.bEx)&#13;&#10;" label="TempLabel_229"/>
		<wait_chgmv/>
		<bg @l="349" src="newroot"/>
		<wait @l="351" time="5000"/>
		<wait_chgmv/>
		<bg @l="353" src="black"/>
		<label @l="356" id="TempLabel_229"/>
		<return @l="360" value=""/>
	</code>
</xscript>
