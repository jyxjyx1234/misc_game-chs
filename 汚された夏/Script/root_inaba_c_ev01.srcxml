<?xml version="1.0" encoding="utf-8"?>
<xscript>
	<debug editor="&quot;C:\Program&#32;Files&#32;(x86)\sakura\sakura.exe&quot;&#32;&quot;%src%&quot;&#32;-Y=%line%"
	   src="D:\シロップ\町ぐるみの罠＋汚された夏セット版\汚された夏\完成データ\汚された夏\script\text\root_inaba_c_ev01.txt"/>
	<code>
		<label @l="13" id="EventLabel_98"/>
		<label @l="16" id="event_scene44"/>
		<wait_chgmv/>
		<bg @l="19" src="bg14a"/>
		<bgm @l="23" src="bgm14" volume="1."/>
		<msg @l="25" char_id="-1" frame_id="-1" name=""
		   text="気が付くと、私は部室の床の上に押し倒されていた。稲庭先輩が私の上に覆い被さっており、着ていた服は胸元から引き裂かれて紙くずのようになっていた。"
		   voices=""/>
		<msg @l="27" char_id="-1" frame_id="-1" name="稲庭"
		   text="『あははは、すごいよ仲根くん！これだけ吸い付いてくる肌は並のバージンじゃ味わえないよ！』" voices=""/>
		<msg @l="29" char_id="-1" frame_id="-1" name=""
		   text="狂ったような声をあげて、稲庭先輩は私の身体を貪るように手を這わせている。" voices=""/>
		<msg @l="30" char_id="-1" frame_id="-1" name=""
		   text="力任せのそれは、愛情や快楽を微塵も感じさせることはなく‥‥痛みしかない。" voices=""/>
		<msg @l="32" char_id="0" frame_id="-1" name="美帆"
		   text="『稲庭先輩、目を覚ましてくださいッ‥‥！』" voices="miho04800"/>
		<msg @l="34" char_id="-1" frame_id="-1" name="稲庭" text="『最高だっ！最高だよ！』"
		   voices=""/>
		<msg @l="36" char_id="0" frame_id="-1" name="美帆"
		   text="『いやっ、先輩‥‥‥‥目を覚ましてください、先輩ッ！！』" voices="miho04810"/>
		<msg @l="38" char_id="-1" frame_id="-1" name="稲庭" text="『ふぅ‥‥ふぅ‥‥‥‥‥ふぅ‥‥‥。』"
		   voices=""/>
		<msg @l="40" char_id="-1" frame_id="-1" name=""
		   text="稲庭先輩は私の呼びかけになどまったく気付いていないかのように荒い呼吸を繰り返しながら私の乳房を揉んでいる。" voices=""/>
		<msg @l="42" char_id="0" frame_id="-1" name="美帆" text="『稲庭先輩‥‥。』"
		   voices="miho04820"/>
		<msg @l="44" char_id="-1" frame_id="-1" name=""
		   text="どうして私がこんな目にあわなければならないのか‥‥‥。" voices=""/>
		<msg @l="45" char_id="-1" frame_id="-1" name="" text="そう思うと‥‥涙が自然と溢れてきた。"
		   voices=""/>
		<goto @l="48" cond="!(f.稲庭ルート即席flag&#32;==&#32;1)&#13;&#10;"
		   label="TempLabel_299"/>
		<msg @l="50" char_id="-1" frame_id="-1" name=""
		   text="部屋の角では玲さんが、縛られ転がされた格好のまま泣いていた。" voices=""/>
		<msg @l="51" char_id="-1" frame_id="-1" name=""
		   text="視線の先には稲庭先輩がいて、彼の方を一心に見つめている。" voices=""/>
		<msg @l="53" char_id="-1" frame_id="-1" name="稲庭"
		   text="『乳首もきれいなピンク色だ！あはははっ！』" voices=""/>
		<msg @l="55" char_id="-1" frame_id="-1" name=""
		   text="しかし‥‥玲さんがいくら先輩の方を見ても何の興味も示さない。" voices=""/>
		<msg @l="56" char_id="-1" frame_id="-1" name=""
		   text="ただ嬉々として美帆の乳房をこねまわし、その先端の突起へ涎を垂らしながらむしゃぶりついている。" voices=""/>
		<msg @l="58" char_id="-1" frame_id="-1" name=""
		   text="先輩の舌は私の乳首をなぶり続け、膨らみが増したのを確認すると満足したのか、さらに乳頭を薙ぎ伏せ、押し捏ねた。" voices=""/>
		<msg @l="60" char_id="-1" frame_id="-1" name="稲庭" text="『おいしいっ、おいしいっ！』"
		   voices=""/>
		<msg @l="62" char_id="0" frame_id="-1" name="美帆"
		   text="『い、いやっ‥‥‥‥‥あっ‥‥んんっっ！！』" voices="miho10270"/>
		<msg @l="64" char_id="-1" frame_id="-1" name="" text="先輩は乳首を甘噛みして弄ぶ。"
		   voices=""/>
		<msg @l="65" char_id="-1" frame_id="-1" name=""
		   text="充分にその感触を味わった後は、今度は大事な秘部へと舌を這わせていく。" voices=""/>
		<msg @l="67" char_id="-1" frame_id="-1" name="稲庭" text="『あはははっ！マ○コもピンク色だ！』"
		   voices=""/>
		<msg @l="69" char_id="-1" frame_id="-1" name=""
		   text="まだ、男の人に初めて秘部を見られた私にとってはたまらない恥辱だ。喉奥で呻きながら身悶えをしたが、先輩は赦してはくれなかった。"
		   voices=""/>
		<msg @l="70" char_id="-1" frame_id="-1" name=""
		   text="先輩の舌はもっとも敏感なクリト○スを直接、刺激した。" voices=""/>
		<msg @l="72" char_id="0" frame_id="-1" name="美帆" text="『や、ああああっっ。』"
		   voices="miho10240"/>
		<msg @l="74" char_id="-1" frame_id="-1" name=""
		   text="私の秘部に顔を押し付けている先輩は恍惚感に浸りながら、秘められた香りを吸引した。" voices=""/>
		<msg @l="75" char_id="-1" frame_id="-1" name=""
		   text="淫欲の香りを鼻腔が刺激し、その官能に浸る先輩の顔は狂気じみていた。" voices=""/>
		<msg @l="77" char_id="-1" frame_id="-1" name="稲庭"
		   text="『処女マ○コの香りだ！やっぱり処女は違う。あはははっ！』" voices=""/>
		<msg @l="79" char_id="-1" frame_id="-1" name=""
		   text="獲物の匂いを嗅ぎまわる獣のように、先輩は鼻をクンクンと鳴らし続けた。" voices=""/>
		<label @l="82" id="TempLabel_299"/>
		<msg @l="85" char_id="-1" frame_id="-1" name="稲庭"
		   text="『さあ、約束どおり僕のモノで君の処女膜をブチ抜いてあげるよ！』" voices=""/>
		<msg @l="87" char_id="0" frame_id="-1" name="美帆" text="『え‥‥。』"
		   voices="miho04840"/>
		<msg @l="89" char_id="-1" frame_id="-1" name="稲庭" text="『ふ、ははっ!これでぼくのモノだ！』"
		   voices=""/>
		<msg @l="91" char_id="-1" frame_id="-1" name=""
		   text="熱に侵されたように叫びながら、稲庭先輩が大きく硬く屹立したソレを私の秘部へと押し当てる。" voices=""/>
		<msg @l="92" char_id="-1" frame_id="-1" name=""
		   text="下着はすでに‥‥跡形も無く破り捨てられてしまっていた。" voices=""/>
		<clear @l="94" class="char"/>
		<char @l="96" id="miho" pos="center" src="miho055f" y="-80"/>
		<msg @l="98" char_id="0" frame_id="-1" name="美帆"
		   text="『いや、せんぱい‥‥‥それだけは‥‥‥‥‥。』" voices="miho04850"/>
		<msg @l="100" char_id="-1" frame_id="-1" name="" text="せめて優しく、と思ったその刹那―――。"
		   voices=""/>
		<msg @l="101" char_id="-1" frame_id="-1" name=""
		   text="彼の熱い肉茎が一気に私の胎内へと突き入れられた。" voices=""/>
		<wait_chgmv/>
		<ev @l="105" src="ev-044"/>
		<description @l="108" text="処女喪失"/>
		<msg @l="110" char_id="0" frame_id="-1" name="美帆" text="『ひぃ――――。』"
		   voices="miho04860"/>
		<msg @l="112" char_id="-1" frame_id="-1" name=""
		   text="先輩のが処女膜を貫いた瞬間‥‥‥私は息を飲む。" voices=""/>
		<msg @l="113" char_id="-1" frame_id="-1" name="" text="そして‥‥‥激痛。" voices=""/>
		<msg @l="115" char_id="0" frame_id="-1" name="美帆" text="『い、ああああああああああっ！！！』"
		   voices="miho04870"/>
		<msg @l="117" char_id="-1" frame_id="-1" name=""
		   text="身体を真っ二つに引き裂かれるのではないかと思うような激痛が、私の全身を襲った。プツプツと何かが千切れていく感じがして、鈍い、身体に杭を打ちこまれたような痛みが全身をかけめぐる。"
		   voices=""/>
		<msg @l="119" char_id="-1" frame_id="-1" name="稲庭"
		   text="『は、ははははっ‥‥‥通った！仲根くんの処女マ○コに今、僕のモノが！』" voices=""/>
		<msg @l="121" char_id="-1" frame_id="-1" name=""
		   text="自らの肉塊で私の初めてを奪った先輩は、その膣内を無遠慮にかき混ぜている。" voices=""/>
		<msg @l="122" char_id="-1" frame_id="-1" name=""
		   text="結合部からは血の筋が垂れ落ち、床に黒く染みを作っていた。" voices=""/>
		<msg @l="124" char_id="0" frame_id="-1" name="美帆"
		   text="『い、ああっ‥‥あﾞ‥‥あﾞ‥‥‥‥‥あぐっっ！！』" voices="miho04880"/>
		<msg @l="126" char_id="-1" frame_id="-1" name=""
		   text="力強くペニスを蜜壺にたたきつけられるたび、私は意識が飛ぶような激痛を感じ表情を歪める。" voices=""/>
		<msg @l="127" char_id="-1" frame_id="-1" name=""
		   text="私のソコは殆ど潤ってはおらず‥‥破瓜の血が唯一の潤滑油となって先輩の硬く屹立した肉棒を受け入れただけだったからだ。"
		   voices=""/>
		<msg @l="129" char_id="0" frame_id="-1" name="美帆"
		   text="『ひっ‥‥いたっ‥‥あ、んぐっ‥‥‥んんっ‥‥‥。』" voices="miho07090"/>
		<msg @l="131" char_id="-1" frame_id="-1" name=""
		   text="蜜壺で、先輩の膨れ上がった欲望が蠢きはじめる。" voices=""/>
		<msg @l="132" char_id="-1" frame_id="-1" name=""
		   text="肉棒で肉壁を引きずられ、秘穴に侵入している巨大な獣が私の膣中を縦横無尽に擦り上げていた。" voices=""/>
		<msg @l="133" char_id="-1" frame_id="-1" name=""
		   text="そこにはわずかな愉悦もなく‥‥ただ、息苦しさと鋭い痛みしかない。" voices=""/>
		<msg @l="135" char_id="-1" frame_id="-1" name="稲庭"
		   text="『ふっ、くふっ‥‥‥‥は、ははっ‥‥‥‥ぼくの、ぼくの‥‥‥。』" voices=""/>
		<msg @l="137" char_id="-1" frame_id="-1" name=""
		   text="稲庭先輩はその顔を邪悪に歪め、何かに取り憑かれたように執拗に私を突き上げる。" voices=""/>
		<msg @l="138" char_id="-1" frame_id="-1" name=""
		   text="その度に私の身体はガクガクと人形のように揺れ‥‥‥軋む。" voices=""/>
		<msg @l="140" char_id="0" frame_id="-1" name="美帆"
		   text="『い、ああっ‥‥あﾞ‥‥あﾞ‥‥‥‥‥あぐっっ！！』" voices="miho04880"/>
		<msg @l="142" char_id="-1" frame_id="-1" name="" text="痛い‥‥なんてものじゃない。"
		   voices=""/>
		<msg @l="143" char_id="-1" frame_id="-1" name=""
		   text="膣内を無理やり引き裂かれているという感触と灼熱の激痛は、他に例えようがないものだった。" voices=""/>
		<msg @l="145" char_id="0" frame_id="-1" name="美帆"
		   text="(どうしてこんなことに‥‥‥なっちゃったのかな)" voices="miho04890"/>
		<msg @l="147" char_id="-1" frame_id="-1" name=""
		   text="この痛みがまだ倍以上も続くのかと思うと、意識が遠退きそうになる、そんな中、私は別のことを考えていた。" voices=""/>
		<msg @l="149" char_id="0" frame_id="-1" name="美帆"
		   text="(わたしが‥‥‥私が何も出来なかったから？)" voices="miho04900"/>
		<msg @l="151" char_id="0" frame_id="-1" name="美帆" text="(わたし‥‥が‥‥‥‥)"
		   voices="miho04910"/>
		<msg @l="153" char_id="-1" frame_id="-1" name=""
		   text="痛みで失いかけた意識を、次の痛みが呼び覚ます。" voices=""/>
		<msg @l="154" char_id="-1" frame_id="-1" name=""
		   text="そんな絶望的な連鎖に身体を犯されながら、私はなすがままになっていた。" voices=""/>
		<msg @l="156" char_id="-1" frame_id="-1" name="稲庭"
		   text="『く、ふっ‥‥‥い、くぞ‥‥‥‥いくぞ、いくぞいくぞいくぞ。』" voices=""/>
		<msg @l="158" char_id="0" frame_id="-1" name="美帆"
		   text="『あ、ああっ‥‥あっ、んぐっ、あﾞっ、あﾞっ、あﾞっ、あﾞっ！！！』" voices="miho04920"/>
		<msg @l="160" char_id="-1" frame_id="-1" name=""
		   text="稲庭の動きがさらに速くなる。熱く硬い先輩のモノが２、３回小刻みに痙攣した。" voices=""/>
		<msg @l="162" char_id="-1" frame_id="-1" name="稲庭" text="『お、おおおおおおっ！！』"
		   voices=""/>
		<flash @l="166" count="4" fade="100" image="white"/>
		<wait_chgmv/>
		<ev @l="170" src="ev-044x1z1"/>
		<msg @l="172" char_id="0" frame_id="-1" name="美帆" text="『うあっ！！？』"
		   voices="miho04930"/>
		<msg @l="174" char_id="-1" frame_id="-1" name=""
		   text="先輩の腰が大きく震え、私の中に熱い何かが注ぎ込まれた。" voices=""/>
		<msg @l="175" char_id="-1" frame_id="-1" name=""
		   text="それはあっという間に私の子宮や膣内を満たし、それでも入りきらずに秘部よりゴボゴボと逆流する。そして、さらに勢いよく外へと溢れ出していく。とても人間の出す量とは思えないほどの精液が私の全てを侵していった。"
		   voices=""/>
		<msg @l="177" char_id="-1" frame_id="-1" name="稲庭" text="『おおっ‥‥‥おおおおおおっ！！』"
		   voices=""/>
		<msg @l="179" char_id="-1" frame_id="-1" name=""
		   text="何度も、何度も‥‥秘裂に熱い液体を放ちながら先輩が吠える。" voices=""/>
		<msg @l="180" char_id="-1" frame_id="-1" name=""
		   text="その瞳には既に人間の理性など一切感じることは出来なかった。" voices=""/>
		<msg @l="181" char_id="-1" frame_id="-1" name=""
		   text="その様はまさに、沸き立つ欲望に付き動かされる獣のようであった。" voices=""/>
		<msg @l="183" char_id="0" frame_id="-1" name="美帆"
		   text="『あﾞ、あﾞあﾞ‥‥‥あﾞ‥‥‥‥‥‥。』" voices="miho04940"/>
		<msg @l="185" char_id="-1" frame_id="-1" name=""
		   text="膣中を満たす熱い液体に身体を震わせながら、私はそれまで何とか保ち続けていた意識がゆっくりと闇の中へ転がり落ちていくのを感じた。"
		   voices=""/>
		<msg @l="186" char_id="-1" frame_id="-1" name=""
		   text="そうして闇の中へ沈む意識の中で‥‥‥私は‥‥絶望を感じていた。" voices=""/>
		<clear @l="192" class="all"/>
		<wait @l="194" time="1000"/>
		<end_scene @l="197"/>
		<goto @l="200" cond="!(f.稲庭ルート即席flag&#32;==&#32;1)&#13;&#10;"
		   label="TempLabel_300"/>
		<call @l="204" target="EventLabel_49@ending11"/>
		<return @l="205" value="0&#13;&#10;"/>
		<goto @l="207" label="TempLabel_303"/>
		<label @l="208" id="TempLabel_300"/>
		<return @l="213" value=""/>
		<label @l="215" id="TempLabel_303"/>
		<return @l="220" value=""/>
	</code>
</xscript>
