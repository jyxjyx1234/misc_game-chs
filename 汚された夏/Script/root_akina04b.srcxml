<?xml version="1.0" encoding="utf-8"?>
<xscript>
	<debug editor="&quot;C:\Program&#32;Files&#32;(x86)\sakura\sakura.exe&quot;&#32;&quot;%src%&quot;&#32;-Y=%line%"
	   src="D:\シロップ\町ぐるみの罠＋汚された夏セット版\汚された夏\完成データ\汚された夏\script\text\root_akina04b.txt"/>
	<code>
		<label @l="12" id="EventLabel_79"/>
		<description @l="16" text="水泳コーチ・４日目(Ｂ)"/>
		<eval @l="18" expr="f.numDay=11&#13;&#10;"/>
		<msgshow @l="20" show="false"/>
		<wait_chgmv/>
		<bg @l="22" src="day11" time="2000"/>
		<wait @l="24" time="500"/>
		<wait_chgmv/>
		<bg @l="26" src="black" time="2000"/>
		<msgshow @l="28" show="true"/>
		<wait_chgmv/>
		<bg @l="32" src="bg09"/>
		<bgm @l="36" src="bgm10" volume="1."/>
		<char @l="40" id="miho" pos="auto" src="miho116"/>
		<msg @l="42" char_id="0" frame_id="-1" name="美帆" text="『それ‥‥どういう意味ですか。』"
		   voices=""/>
		<clear @l="45" class="char"/>
		<char @l="47" id="miho" pos="left" src="miho116"/>
		<char @l="49" id="watab" pos="right" src="watabe010"/>
		<msg @l="51" char_id="-1" frame_id="-1" name="渡部"
		   text="『どうもこうもない、俺は昨日の練習中に何をしていたのかと聞いているだけじゃないか。』" voices=""/>
		<msg @l="53" char_id="-1" frame_id="-1" name="渡部"
		   text="『それとも、顧問が自分の担当する部の練習内容を尋ねるのが、そんなにおかしいコトなのか？』" voices=""/>
		<msg @l="55" char_id="0" frame_id="1" name="美帆"
		   text="（そんなこと‥‥今までは聞きもしなかったのに）" voices=""/>
		<msg @l="57" char_id="-1" frame_id="-1" name=""
		   text="確かに‥‥渡部先生の言い分は理にかなってる。" voices=""/>
		<msg @l="58" char_id="-1" frame_id="-1" name=""
		   text="練習内容をコーチの私に聞くというのも、常識的に考えれば普通だ。" voices=""/>
		<msg @l="59" char_id="-1" frame_id="-1" name=""
		   text="でも、よりにもよってどうして「昨日のコト」なのだろう。" voices=""/>
		<msg @l="60" char_id="-1" frame_id="-1" name=""
		   text="私が汚されていた‥‥その時の練習内容を詳しく教えろだなんて。" voices=""/>
		<char @l="63" id="miho" pos="left" src="miho016"/>
		<msg @l="65" char_id="0" frame_id="1" name="美帆"
		   text="『私、昨日は練習の途中で気分が悪くなって‥‥練習を見れなかったんです。』" voices=""/>
		<msg @l="67" char_id="0" frame_id="1" name="美帆"
		   text="『だから‥‥昨日の練習内容を正確に報告することは出来ません。』" voices=""/>
		<msg @l="69" char_id="-1" frame_id="-1" name="渡部" text="『ほう、気分が悪くなってなあ‥‥？』"
		   voices=""/>
		<msg @l="71" char_id="0" frame_id="1" name="美帆" text="『な、なんですか‥‥。』"
		   voices=""/>
		<char @l="74" id="watab" pos="right" src="watabe012"/>
		<msg @l="76" char_id="-1" frame_id="-1" name="渡部"
		   text="『いや、俺が聞いている事実と食い違ってると思ってな。』" voices=""/>
		<msg @l="78" char_id="0" frame_id="1" name="美帆" text="『聞いて‥‥‥る？』" voices=""/>
		<char @l="82" id="miho" pos="left" src="miho114"/>
		<msg @l="84" char_id="0" frame_id="1" name="美帆" text="『どういうことですか！？』"
		   voices=""/>
		<msg @l="86" char_id="-1" frame_id="-1" name=""
		   text="まさか、亜季奈はすべてを知っていて、それで昨日のコトをすべて渡部先生に話して聞かせたとか‥‥‥？" voices=""/>
		<msg @l="87" char_id="-1" frame_id="-1" name="" text="いや‥‥それはないはず‥‥‥。"
		   voices=""/>
		<msg @l="88" char_id="-1" frame_id="-1" name=""
		   text="あの後、私がプールに戻った時の亜季奈の驚きようは尋常じゃなかった。" voices=""/>
		<char @l="91" id="watab" pos="right" src="watabe010"/>
		<msg @l="93" char_id="-1" frame_id="-1" name="渡部"
		   text="『昨日、お前たちが更衣室でしていたことを偶然見ていたものが居たんだよ。』" voices=""/>
		<msg @l="95" char_id="0" frame_id="1" name="美帆" text="『な‥‥。』" voices=""/>
		<msg @l="97" char_id="-1" frame_id="-1" name="" text="更衣室でしていたこと‥‥。"
		   voices=""/>
		<msg @l="98" char_id="-1" frame_id="-1" name=""
		   text="間違いなく、渡部先生が言っているのは私と留学生とのことだ。" voices=""/>
		<char @l="101" id="watab" pos="right" src="watabe012"/>
		<msg @l="103" char_id="-1" frame_id="-1" name="渡部"
		   text="『しかし驚いたもんだ‥‥俺があれだけ熱心に誘っても「嫌です」の一点張りで身体を許そうとしなかったオマエが、黒人相手だと即ＯＫとはな。』"
		   voices=""/>
		<char @l="106" id="miho" pos="left" src="miho014"/>
		<msg @l="108" char_id="0" frame_id="1" name="美帆" text="『そ、そんなんじゃありませんっ！』"
		   voices=""/>
		<msg @l="110" char_id="0" frame_id="1" name="美帆" text="『私は無理やりされて‥‥それでっ。』"
		   voices=""/>
		<char @l="113" id="watab" pos="right" src="watabe010"/>
		<msg @l="115" char_id="-1" frame_id="-1" name="渡部"
		   text="『無理やりされたにしては警察に行こうともせず、そのままプールの方へ戻ったそうじゃないか。』" voices=""/>
		<char @l="118" id="miho" pos="left" src="miho115"/>
		<msg @l="120" char_id="0" frame_id="1" name="美帆" text="『それは‥‥。』" voices=""/>
		<msg @l="122" char_id="0" frame_id="1" name="美帆"
		   text="『警察に行けば騒ぎが大きくなりますし、私が我慢すれば、亜季奈も水泳を続けられるから････････。』" voices=""/>
		<msg @l="124" char_id="-1" frame_id="-1" name="" text="しかも相手は留学生だ。"
		   voices=""/>
		<msg @l="125" char_id="-1" frame_id="-1" name=""
		   text="国際問題は大袈裟にしても、どんな騒ぎになるかなんて想像もつかない。" voices=""/>
		<msg @l="127" char_id="-1" frame_id="-1" name="渡部" text="『なるほど、大した心がけだな。』"
		   voices=""/>
		<msg @l="129" char_id="-1" frame_id="-1" name="渡部"
		   text="『だが‥‥本当にそんな理由で黙ることにしたんだろうかなぁ？』" voices=""/>
		<msg @l="131" char_id="0" frame_id="1" name="美帆" text="『‥‥？』" voices=""/>
		<msg @l="133" char_id="-1" frame_id="-1" name="渡部" text="『こうも考えられるだろ。』"
		   voices=""/>
		<char @l="136" id="watab" pos="right" src="watabe012"/>
		<msg @l="138" char_id="-1" frame_id="-1" name="渡部"
		   text="『妹のいる水泳部の合宿中に男が欲しくなった、さすがに本番はまずいからという理由でおしゃぶりだけで手を打った‥‥。』"
		   voices=""/>
		<char @l="141" id="miho" pos="left" src="miho014"/>
		<msg @l="143" char_id="0" frame_id="1" name="美帆"
		   text="『なっ！&#32;そんなデタラメ、ありえませんっ！』" voices=""/>
		<char @l="146" id="watab" pos="right" src="watabe010"/>
		<msg @l="148" char_id="-1" frame_id="-1" name="渡部" text="『そんな証拠がどこにある。』"
		   voices=""/>
		<msg @l="150" char_id="0" frame_id="1" name="美帆"
		   text="『証拠なんて‥‥当事者の私が違うと言っているんですよ！？』" voices=""/>
		<msg @l="152" char_id="-1" frame_id="-1" name="渡部" text="『嘘をついてない証拠は？』"
		   voices=""/>
		<char @l="155" id="miho" pos="left" src="miho115"/>
		<msg @l="157" char_id="0" frame_id="1" name="美帆" text="『証拠は‥‥‥‥ありませんけど。』"
		   voices=""/>
		<msg @l="159" char_id="0" frame_id="1" name="美帆"
		   text="『でも、そんなことを言ったら、いま渡部先生が言われたことだって、なんの証拠もない作り事じゃないですか。』" voices=""/>
		<char @l="162" id="watab" pos="right" src="watabe014"/>
		<msg @l="164" char_id="-1" frame_id="-1" name="渡部"
		   text="『作り事かそうじゃないかなんて関係ないんだよ。』" voices=""/>
		<msg @l="166" char_id="-1" frame_id="-1" name="渡部"
		   text="『世間の連中が事実をどんな風に解釈するかが大事なんだ。』" voices=""/>
		<char @l="169" id="miho" pos="left" src="miho015"/>
		<msg @l="172" char_id="0" frame_id="1" name="美帆" text="『なにを‥‥。』" voices=""/>
		<msg @l="174" char_id="-1" frame_id="-1" name="渡部"
		   text="『俺が昨日のコトを誰かに漏らしたらどうなる？』" voices=""/>
		<msg @l="176" char_id="-1" frame_id="-1" name="渡部"
		   text="『もちろん、さっき言った何の証拠もない作り事をだ。』" voices=""/>
		<msg @l="178" char_id="0" frame_id="1" name="美帆"
		   text="『そんなこと‥‥事実と違ってるんですから、誰も信じな‥･･‥‥、っ！！！』" voices=""/>
		<char @l="181" id="miho" pos="left" src="miho014"/>
		<char @l="184" id="watab" pos="right" src="watabe010"/>
		<msg @l="186" char_id="-1" frame_id="-1" name="渡部" text="『やっと気付いたようだな。』"
		   voices=""/>
		<msg @l="188" char_id="-1" frame_id="-1" name="渡部"
		   text="『誰も事実なんて知らないんだから、俺が何を脚色したって構わないんだよ。』" voices=""/>
		<msg @l="190" char_id="-1" frame_id="-1" name="渡部"
		   text="『しかも中身についてはあった事実そのままだから、オマエはどちらにせよ言い逃れは出来ない』。" voices=""/>
		<char @l="193" id="miho" pos="left" src="miho115"/>
		<msg @l="195" char_id="0" frame_id="1" name="美帆" text="『そんな‥‥。』" voices=""/>
		<char @l="198" id="watab" pos="right" src="watabe012"/>
		<msg @l="200" char_id="-1" frame_id="-1" name="渡部"
		   text="『解るか？&#32;オマエはただの好き者として見られるんだよ。』" voices=""/>
		<char @l="203" id="miho" pos="left" src="miho114"/>
		<msg @l="205" char_id="0" frame_id="1" name="美帆"
		   text="『で、でもっ‥‥事実関係のない話なんて噂にしかなりません。』" voices=""/>
		<msg @l="207" char_id="0" frame_id="1" name="美帆"
		   text="『私は恥くらいかくかもしれませんけど、そんなのは時間が解決してくれるハズですから。』" voices=""/>
		<char @l="210" id="miho" pos="left" src="miho116"/>
		<msg @l="212" char_id="-1" frame_id="-1" name=""
		   text="そうだ。私はもう一度汚れてしまっている身なのだ。" voices=""/>
		<msg @l="213" char_id="-1" frame_id="-1" name=""
		   text="世間体なんか、まして噂や風評なんて気にすることはない。" voices=""/>
		<msg @l="214" char_id="-1" frame_id="-1" name=""
		   text="私が今しなければならないのは亜季奈を守る事‥‥。" voices=""/>
		<msg @l="215" char_id="-1" frame_id="-1" name="" text="それだけだ。" voices=""/>
		<char @l="218" id="watab" pos="right" src="watabe014"/>
		<msg @l="220" char_id="-1" frame_id="-1" name="渡部" text="『‥‥‥‥。』" voices=""/>
		<msg @l="222" char_id="0" frame_id="1" name="美帆"
		   text="『そんな、脅迫みたいな方法で私が言うことを聞くと思ったら大間違いですっ。』" voices=""/>
		<char @l="225" id="miho" pos="left" src="miho015"/>
		<msg @l="227" char_id="0" frame_id="1" name="美帆"
		   text="『私はそんな脅迫には負けません‥‥亜季奈の為にも、絶対にっ！』" voices=""/>
		<char @l="231" id="miho" pos="left" src="miho116"/>
		<msg @l="233" char_id="0" frame_id="1" name="美帆" text="『‥‥失礼します。』" voices=""/>
		<clear @l="237" layer="miho"/>
		<stopbgm @l="241" fadeout="1000"/>
		<clear @l="244" class="char"/>
		<char @l="246" id="watab" pos="auto" src="watabe017"/>
		<msg @l="248" char_id="-1" frame_id="-1" name="渡部" text="『くそっ‥‥！！』"
		   voices=""/>
		<msg @l="250" char_id="-1" frame_id="-1" name="渡部"
		   text="『おい、どういうことだよ‥‥絶対に上手くいくんじゃなかったのか！？』" voices=""/>
		<msg @l="252" char_id="-1" frame_id="-1" name="人影" text="『まあ‥‥そう焦るな。』"
		   voices=""/>
		<msg @l="254" char_id="-1" frame_id="-1" name="人影"
		   text="『確かに失敗したのは誤算だったが、収穫はあった。』" voices=""/>
		<msg @l="256" char_id="-1" frame_id="-1" name="渡部" text="『ん？&#32;どういうことだ？』"
		   voices=""/>
		<msg @l="258" char_id="-1" frame_id="-1" name="人影"
		   text="『あの娘をあれほど気丈にしている元を、断ってやれば良い。』" voices=""/>
		<msg @l="260" char_id="-1" frame_id="-1" name="人影"
		   text="『何かを守ることで己を見出す人間は‥‥それで崩れる。』" voices=""/>
		<msg @l="262" char_id="-1" frame_id="-1" name="人影" text="『恐ろしいほどに、呆気なくな。』"
		   voices=""/>
		<clear @l="265" class="all"/>
		<wait_chgmv/>
		<bg @l="268" src="bg10m1"/>
		<bgm @l="271" src="bgm03" volume="1."/>
		<char @l="274" id="miho" pos="auto" src="miho166"/>
		<msg @l="276" char_id="0" frame_id="1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="278" char_id="-1" frame_id="-1" name="" text="練習の合間。" voices=""/>
		<msg @l="279" char_id="-1" frame_id="-1" name="" text="休憩時間。" voices=""/>
		<msg @l="280" char_id="-1" frame_id="-1" name=""
		   text="私はプールサイドに腰掛けて、ボーッと水面を見つめていた。" voices=""/>
		<msg @l="281" char_id="-1" frame_id="-1" name=""
		   text="誰かにすがりたくて、泣き出したくて‥‥でもそんな自分認められなくて。" voices=""/>
		<msg @l="283" char_id="2" frame_id="-1" name="声" text="『おね～ちゃん。』" voices=""/>
		<clear @l="286" class="char"/>
		<char @l="288" id="miho" pos="left" src="miho166"/>
		<char @l="290" id="akina" pos="right" src="akina070"/>
		<msg @l="292" char_id="2" frame_id="-1" name="亜季奈" text="『一人でなにたそがれちゃってるの？』"
		   voices=""/>
		<msg @l="294" char_id="0" frame_id="1" name="美帆" text="『亜季奈‥‥。』" voices=""/>
		<msg @l="296" char_id="0" frame_id="1" name="美帆"
		   text="『別に、たそがれてなんかないよ‥‥ちょっと考え事してるだけ。』" voices=""/>
		<char @l="299" id="akina" pos="right" src="akina071"/>
		<msg @l="301" char_id="2" frame_id="-1" name="亜季奈"
		   text="『それがたそがれてるってコトだと思うけどな、私。』" voices=""/>
		<msg @l="303" char_id="0" frame_id="1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<char @l="307" id="akina" pos="right" src="akina070"/>
		<msg @l="309" char_id="2" frame_id="-1" name="亜季奈" text="『何か、悩みでもあるの？』"
		   voices=""/>
		<msg @l="311" char_id="0" frame_id="1" name="美帆" text="『まあ‥‥似たようなものかな。』"
		   voices=""/>
		<msg @l="313" char_id="2" frame_id="-1" name="亜季奈" text="『ふぅん‥‥。』" voices=""/>
		<msg @l="315" char_id="0" frame_id="1" name="美帆" text="『亜季奈は‥‥ないの？』"
		   voices=""/>
		<msg @l="317" char_id="2" frame_id="-1" name="亜季奈" text="『ん？&#32;なにが？』"
		   voices=""/>
		<msg @l="319" char_id="0" frame_id="1" name="美帆"
		   text="『悩みとか‥‥‥迷ってる事とか、ないの？』" voices=""/>
		<msg @l="321" char_id="2" frame_id="-1" name="亜季奈"
		   text="『悩みかぁ‥‥私、基本的にあんまり悩まないからなぁ。』" voices=""/>
		<msg @l="323" char_id="-1" frame_id="-1" name="" text="小さい頃から見てきているからよく解る。"
		   voices=""/>
		<msg @l="324" char_id="-1" frame_id="-1" name=""
		   text="この子は悩んだり迷ったりする前に、まず動いてしまう。" voices=""/>
		<msg @l="325" char_id="-1" frame_id="-1" name=""
		   text="右か左を決める場面では、とりあえず直感的に選んだどちらかに向かって歩き始めてしまう。" voices=""/>
		<msg @l="326" char_id="-1" frame_id="-1" name=""
		   text="その後で失敗と気付いてもくよくよなんてしない。" voices=""/>
		<msg @l="327" char_id="-1" frame_id="-1" name=""
		   text="失敗は失敗としてさっさと片付けて、次へと向かってしまうのだ。" voices=""/>
		<msg @l="328" char_id="-1" frame_id="-1" name=""
		   text="そんな風な生き方の出来る亜季奈を、「羨ましい」と思ったことはこれまで何度もあった。" voices=""/>
		<char @l="331" id="miho" pos="left" src="miho066"/>
		<msg @l="333" char_id="0" frame_id="1" name="美帆" text="『いいなー、悩みが無いって。』"
		   voices=""/>
		<char @l="336" id="akina" pos="right" src="akina077"/>
		<bgm @l="338" src="bgm06" volume="1."/>
		<msg @l="340" char_id="2" frame_id="-1" name="亜季奈"
		   text="『あ、お姉ちゃんいま私のコト馬鹿にしたでしょ。』" voices=""/>
		<msg @l="342" char_id="0" frame_id="1" name="美帆"
		   text="『し、してないよ‥‥羨ましいな～と思ってるだけ。』" voices=""/>
		<msg @l="344" char_id="2" frame_id="-1" name="亜季奈" text="『やっぱり馬鹿にしてる～！』"
		   voices=""/>
		<msg @l="346" char_id="2" frame_id="-1" name="亜季奈"
		   text="『もう‥‥私にだってそれなりの悩み、あるんだから。』" voices=""/>
		<char @l="349" id="miho" pos="left" src="miho161"/>
		<msg @l="351" char_id="0" frame_id="1" name="美帆"
		   text="『どうせ、今日の晩ゴハンは何かな～とかでしょ。』" voices=""/>
		<char @l="354" id="akina" pos="right" src="akina177"/>
		<msg @l="356" char_id="2" frame_id="-1" name="亜季奈"
		   text="『違うよ！&#32;そんなんじゃなくて、もっとちゃんとした悩みだもん！』" voices=""/>
		<char @l="359" id="miho" pos="left" src="miho060"/>
		<msg @l="361" char_id="0" frame_id="1" name="美帆" text="『へえ、どんな悩み？』"
		   voices=""/>
		<char @l="364" id="akina" pos="right" src="akina070"/>
		<msg @l="366" char_id="2" frame_id="-1" name="亜季奈" text="『んとねぇ‥‥恋の悩み。』"
		   voices=""/>
		<char @l="369" id="miho" pos="left" src="miho164"/>
		<msg @l="371" char_id="0" frame_id="1" name="美帆" text="『うそっ！？』" voices=""/>
		<char @l="374" id="akina" pos="right" src="akina174"/>
		<msg @l="376" char_id="2" frame_id="-1" name="亜季奈"
		   text="『わ、お姉ちゃん、そのリアクションひどすぎ！！』" voices=""/>
		<char @l="379" id="miho" pos="left" src="miho066"/>
		<msg @l="381" char_id="0" frame_id="1" name="美帆" text="『え‥‥あ、ごめんごめん。』"
		   voices=""/>
		<msg @l="383" char_id="0" frame_id="1" name="美帆"
		   text="『まさか亜季奈の口から「恋」なんて言葉が出てくるとは、思わなかったから‥』‥。" voices=""/>
		<char @l="386" id="akina" pos="right" src="akina077"/>
		<msg @l="388" char_id="2" frame_id="-1" name="亜季奈"
		   text="『ぶぅ～、私だって女の子だよ、恋くらいするよ～！』" voices=""/>
		<msg @l="390" char_id="0" frame_id="1" name="美帆" text="『そっか‥‥うん、そうだよね。』"
		   voices=""/>
		<msg @l="392" char_id="0" frame_id="1" name="美帆"
		   text="『今のは私が悪かったです。ごめんなさい。』" voices=""/>
		<char @l="395" id="akina" pos="right" src="akina070"/>
		<msg @l="397" char_id="2" frame_id="-1" name="亜季奈" text="『うむ、わかればよろしい！』"
		   voices=""/>
		<char @l="400" id="miho" pos="left" src="miho060"/>
		<msg @l="402" char_id="0" frame_id="1" name="美帆" text="『それで‥‥相手は誰なの？』"
		   voices=""/>
		<char @l="405" id="akina" pos="right" src="akina071"/>
		<msg @l="407" char_id="2" frame_id="-1" name="亜季奈" text="『え～、それは言えないよぉ。』"
		   voices=""/>
		<char @l="410" id="miho" pos="left" src="miho061"/>
		<msg @l="412" char_id="0" frame_id="1" name="美帆"
		   text="『いいじゃない、教えてよ。同じ水泳部の男の子なの？』" voices=""/>
		<msg @l="414" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んー‥‥水泳部の中にはいるけど、ちょっと違うんだな～。』" voices=""/>
		<char @l="417" id="miho" pos="left" src="miho164"/>
		<msg @l="419" char_id="0" frame_id="1" name="美帆"
		   text="『ま、まさか‥‥相手が女の子とか‥‥‥‥？』" voices=""/>
		<char @l="422" id="akina" pos="right" src="akina177"/>
		<msg @l="424" char_id="2" frame_id="-1" name="亜季奈" text="『ちがう～！』" voices=""/>
		<char @l="427" id="miho" pos="left" src="miho060"/>
		<msg @l="429" char_id="0" frame_id="1" name="美帆" text="『なんだ‥‥‥じゃ、誰なのよ？』"
		   voices=""/>
		<char @l="432" id="akina" pos="right" src="akina070"/>
		<msg @l="434" char_id="2" frame_id="-1" name="亜季奈" text="『‥‥‥‥。』" voices=""/>
		<msg @l="436" char_id="0" frame_id="1" name="美帆"
		   text="『あ、そこまでしゃべっておいて言わないのはズルイわよ。』" voices=""/>
		<char @l="439" id="miho" pos="left" src="miho061"/>
		<msg @l="441" char_id="0" frame_id="1" name="美帆"
		   text="『ほらほら、お姉ちゃんに白状しちゃいなさ～い。』" voices=""/>
		<msg @l="443" char_id="2" frame_id="-1" name="亜季奈" text="『むむ‥‥。』" voices=""/>
		<msg @l="445" char_id="0" frame_id="1" name="美帆" text="『誰にも言わないから。』"
		   voices=""/>
		<msg @l="447" char_id="2" frame_id="-1" name="亜季奈" text="『むむむむ‥‥。』"
		   voices=""/>
		<char @l="450" id="miho" pos="left" src="miho161"/>
		<msg @l="452" char_id="0" frame_id="1" name="美帆"
		   text="『駅前の喫茶店にスペシャルジャンボパフェってのがあるんだけど･･‥‥おごっちゃおうかなぁ。』" voices=""/>
		<char @l="455" id="akina" pos="right" src="akina171"/>
		<msg @l="457" char_id="2" frame_id="-1" name="亜季奈" text="『ほんとにっ！？』"
		   voices=""/>
		<msg @l="459" char_id="0" frame_id="1" name="美帆" text="『嘘なんかつかないわよ。』"
		   voices=""/>
		<char @l="462" id="akina" pos="right" src="akina070"/>
		<msg @l="464" char_id="2" frame_id="-1" name="亜季奈"
		   text="『じゃあ、お姉ちゃんだけ特別だよ‥‥？』" voices=""/>
		<msg @l="466" char_id="0" frame_id="1" name="美帆"
		   text="『パフェおごるんだから、特別も何もないじゃない。』" voices=""/>
		<char @l="469" id="akina" pos="right" src="akina071"/>
		<msg @l="471" char_id="2" frame_id="-1" name="亜季奈"
		   text="『お姉ちゃんだから、パフェだけで教えちゃうんだよ。』" voices=""/>
		<char @l="474" id="miho" pos="left" src="miho060"/>
		<msg @l="476" char_id="0" frame_id="1" name="美帆"
		   text="『ハイハイ、ありがとう‥‥‥それで相手は誰なの？』" voices=""/>
		<char @l="479" id="akina" pos="right" src="akina070"/>
		<msg @l="481" char_id="2" frame_id="-1" name="亜季奈" text="『あのね‥‥‥耳、こっちに向けて。』"
		   voices=""/>
		<msg @l="483" char_id="0" frame_id="1" name="美帆" text="『なによ、誰も聞いてないわよ。』"
		   voices=""/>
		<msg @l="485" char_id="2" frame_id="-1" name="亜季奈" text="『そんなのわかんないでしょ！』"
		   voices=""/>
		<char @l="488" id="miho" pos="left" src="miho061"/>
		<msg @l="490" char_id="0" frame_id="1" name="美帆" text="(ふふ‥‥一人前に恥ずかしがっちゃって)"
		   voices=""/>
		<clear @l="493" class="char"/>
		<msg @l="495" char_id="0" frame_id="1" name="美帆" text="『それじゃあ‥‥‥はい、これでいい？』"
		   voices=""/>
		<msg @l="497" char_id="-1" frame_id="-1" name=""
		   text="私はわずかに微笑んで、亜季奈の口元に耳を寄せる。" voices=""/>
		<char @l="500" id="akina" pos="center" src="akina070f" y="-80"/>
		<msg @l="502" char_id="2" frame_id="-1" name="亜季奈" text="『あのね。』" voices=""/>
		<msg @l="504" char_id="2" frame_id="-1" name="亜季奈" text="『私が好きなのはね‥‥‥。』"
		   voices=""/>
		<msg @l="506" char_id="0" frame_id="1" name="美帆" text="『うんうん。』" voices=""/>
		<char @l="509" id="akina" pos="center" src="akina071f" y="-80"/>
		<msg @l="511" char_id="2" frame_id="-1" name="亜季奈" text="『ワタベセンセイだよ。』"
		   voices=""/>
		<stopbgm @l="514" fadeout="1000"/>
		<clear @l="517" class="char"/>
		<msg @l="519" char_id="0" frame_id="1" name="美帆" text="『え‥‥？』" voices=""/>
		<msg @l="521" char_id="0" frame_id="1" name="美帆" text="『いま‥‥なんて‥‥‥‥？』"
		   voices=""/>
		<msg @l="523" char_id="-1" frame_id="-1" name=""
		   text="この子は‥‥亜季奈はいま、誰が好きだといった？" voices=""/>
		<char @l="526" id="akina" pos="auto" src="akina077"/>
		<msg @l="528" char_id="2" frame_id="-1" name="亜季奈"
		   text="『えーっ、また言うの？&#32;お姉ちゃんのイジワルぅ！』" voices=""/>
		<msg @l="530" char_id="0" frame_id="1" name="美帆" text="『そんなんじゃ‥‥なくて‥‥‥‥。』"
		   voices=""/>
		<msg @l="532" char_id="0" frame_id="1" name="美帆" text="『お願い‥‥もう一回。』"
		   voices=""/>
		<char @l="535" id="akina" pos="auto" src="akina071"/>
		<msg @l="537" char_id="2" frame_id="-1" name="亜季奈"
		   text="『だから、渡部センセイだって‥‥‥水泳部顧問の。』" voices=""/>
		<bgm @l="540" src="bgm03" volume="1."/>
		<msg @l="542" char_id="-1" frame_id="-1" name="" text="ワタベセンセイ！！" voices=""/>
		<msg @l="543" char_id="-1" frame_id="-1" name="" text="今、亜季奈はそう言ったの！？"
		   voices=""/>
		<msg @l="544" char_id="-1" frame_id="-1" name="" text="渡部‥‥あの男の名前を？"
		   voices=""/>
		<msg @l="545" char_id="-1" frame_id="-1" name="" text="亜季奈が‥‥？" voices=""/>
		<clear @l="548" class="char"/>
		<char @l="550" id="miho" pos="left" src="miho165"/>
		<char @l="552" id="akina" pos="right" src="akina071"/>
		<msg @l="554" char_id="0" frame_id="1" name="美帆" text="『‥‥ダメ。』" voices=""/>
		<char @l="557" id="akina" pos="right" src="akina074"/>
		<msg @l="559" char_id="2" frame_id="-1" name="亜季奈" text="『え？』" voices=""/>
		<msg @l="561" char_id="0" frame_id="1" name="美帆" text="『それだけは‥‥ダメ。』"
		   voices=""/>
		<msg @l="563" char_id="0" frame_id="1" name="美帆"
		   text="『亜季奈、あの人だけは絶対に好きになっちゃダメ。』" voices=""/>
		<msg @l="565" char_id="2" frame_id="-1" name="亜季奈" text="『お、お姉ちゃん‥‥！？』"
		   voices=""/>
		<msg @l="567" char_id="0" frame_id="1" name="美帆"
		   text="『あの人だけは絶対にダメ！&#32;‥‥お願いだからお姉ちゃんの言う事を聞いて！』" voices=""/>
		<msg @l="569" char_id="2" frame_id="-1" name="亜季奈" text="『なんでそんなこというの？』"
		   voices=""/>
		<char @l="572" id="akina" pos="right" src="akina175"/>
		<msg @l="574" char_id="2" frame_id="-1" name="亜季奈"
		   text="『私が誰のコト好きでもお姉ちゃんには‥‥。』" voices=""/>
		<char @l="577" id="miho" pos="left" src="miho064"/>
		<msg @l="579" char_id="0" frame_id="1" name="美帆" text="『亜季奈っ！！』" voices=""/>
		<char @l="582" id="akina" pos="right" src="akina075"/>
		<msg @l="584" char_id="2" frame_id="-1" name="亜季奈"
		   text="『‥‥！？&#32;まさか、お姉ちゃん‥‥。』" voices=""/>
		<se @l="587" buf="1" src="ホイッスル（室内プール）" volume="1."/>
		<msg @l="589" char_id="-1" frame_id="-1" name="渡部の声" text="『休憩は終わりだー、集まれ。』"
		   voices=""/>
		<char @l="592" id="miho" pos="left" src="miho065"/>
		<msg @l="594" char_id="0" frame_id="1" name="美帆"
		   text="『お願い、わかって‥‥渡部先生には近づいちゃダメなの。』" voices=""/>
		<clear @l="597" layer="miho"/>
		<msg @l="599" char_id="2" frame_id="-1" name="亜季奈" text="『‥‥。』" voices=""/>
		<clear @l="602" layer="akina"/>
		<msg @l="604" char_id="-1" frame_id="-1" name=""
		   text="亜季奈はそれ以上言葉を続ける事無く、ただ悲しそうな表情で私を見る。" voices=""/>
		<msg @l="605" char_id="-1" frame_id="-1" name="" text="それだけ私の態度に‥‥驚いたのだろう。"
		   voices=""/>
		<msg @l="607" char_id="0" frame_id="1" name="美帆"
		   text="(絶対に、あの人にだけは近づいちゃダメなのよ‥‥‥)" voices=""/>
		<msg @l="609" char_id="-1" frame_id="-1" name=""
		   text="私は心の中でつぶやきながら‥‥再び、練習に戻る。" voices=""/>
		<msg @l="610" char_id="-1" frame_id="-1" name=""
		   text="渡部先生は‥‥私と目を合わそうとはしない。" voices=""/>
		<msg @l="611" char_id="-1" frame_id="-1" name=""
		   text="変なイタズラをされるより全然マシだけど‥‥その静けさが今は逆に怖い。" voices=""/>
		<msg @l="613" char_id="0" frame_id="1" name="美帆"
		   text="(あんな男に近づいたら‥‥亜季奈も、酷い目に合わされちゃう)" voices=""/>
		<msg @l="615" char_id="0" frame_id="1" name="美帆"
		   text="(お願い‥‥‥亜季奈‥‥‥‥‥‥わかって)" voices=""/>
		<msg @l="617" char_id="-1" frame_id="-1" name=""
		   text="亜季奈もまた‥‥私と目を合わせてはくれなかった。" voices=""/>
		<clear @l="620" class="all"/>
		<wait_chgmv/>
		<bg @l="622" src="bg07b"/>
		<char @l="625" id="miho" pos="left" src="miho116"/>
		<char @l="628" id="akina" pos="right" src="akina015"/>
		<msg @l="630" char_id="0" frame_id="1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="632" char_id="2" frame_id="-1" name="亜季奈" text="『‥‥‥‥。』" voices=""/>
		<msg @l="634" char_id="-1" frame_id="-1" name="" text="練習後の帰り道。" voices=""/>
		<msg @l="635" char_id="-1" frame_id="-1" name=""
		   text="私と亜季奈は言葉無くキャンパスを歩いていた。" voices=""/>
		<msg @l="636" char_id="-1" frame_id="-1" name="" text="気まずい‥‥･･。" voices=""/>
		<msg @l="637" char_id="-1" frame_id="-1" name="" text="･･････それはそうだろう。"
		   voices=""/>
		<msg @l="638" char_id="-1" frame_id="-1" name=""
		   text="妹が好きだという相手を････理由も告げずに否定したのだ。" voices=""/>
		<msg @l="640" char_id="2" frame_id="-1" name="亜季奈" text="『それじゃ‥‥‥私、こっちだから。』"
		   voices=""/>
		<msg @l="642" char_id="0" frame_id="1" name="美帆" text="『あ‥‥うん。』" voices=""/>
		<clear @l="645" layer="akina"/>
		<msg @l="647" char_id="-1" frame_id="-1" name="" text="宿舎と停留所の分かれ道。"
		   voices=""/>
		<msg @l="648" char_id="-1" frame_id="-1" name=""
		   text="亜季奈は顔も上げずにそういうと、何も言わず歩き始める。" voices=""/>
		<msg @l="649" char_id="-1" frame_id="-1" name=""
		   text="嫌われた‥‥というよりも、避けられているという感じである。" voices=""/>
		<msg @l="651" char_id="0" frame_id="1" name="美帆"
		   text="『こんなの‥‥亜季奈が無事でいてくれるなら････‥‥。』" voices=""/>
		<clear @l="654" layer="miho"/>
		<msg @l="656" char_id="-1" frame_id="-1" name=""
		   text="私は自分に言い聞かせるようにつぶやいて‥‥停留所へ続く道を歩く。" voices=""/>
		<msg @l="657" char_id="-1" frame_id="-1" name=""
		   text="それが、大きなすれ違いの始まりになるとも知らないで‥‥‥。" voices=""/>
		<stopbgm @l="660" fadeout="1000"/>
		<clear @l="663" class="all"/>
		<label @l="666" id="event_scene49"/>
		<msg @l="669" char_id="2" frame_id="-1" name="女の声"
		   text="『渡部先生はお姉ちゃんが好きですか？』" voices=""/>
		<msg @l="671" char_id="-1" frame_id="-1" name="男の声"
		   text="『お前の姉ちゃんには付き合って欲しいと言われた。』" voices=""/>
		<msg @l="673" char_id="2" frame_id="-1" name="女の声"
		   text="『わ、私だって渡部先生が好きです。お姉ちゃんよりも‥‥。』" voices=""/>
		<msg @l="675" char_id="-1" frame_id="-1" name="男の声"
		   text="『なら態度で見せてもらわないとなぁ。』" voices=""/>
		<msg @l="677" char_id="2" frame_id="-1" name="女の声" text="『態度‥‥？』" voices=""/>
		<msg @l="679" char_id="-1" frame_id="-1" name="男の声"
		   text="『お前の処女を俺のモノでぶち抜かせてくれれば信じてやる。』" voices=""/>
		<msg @l="681" char_id="2" frame_id="-1" name="女の声" text="『えっ‥‥そ、それは‥‥』"
		   voices=""/>
		<msg @l="683" char_id="-1" frame_id="-1" name="男の声"
		   text="『出来ねぇんなら帰れ。あいにくガキの戯言に付き合ってる暇はないんでな。』" voices=""/>
		<msg @l="685" char_id="2" frame_id="-1" name="女の声" text="『わ‥‥わかりました。』"
		   voices=""/>
		<msg @l="687" char_id="-1" frame_id="-1" name="男の声" text="『くくっ‥‥いいんだな？』"
		   voices=""/>
		<msg @l="689" char_id="2" frame_id="-1" name="女の声" text="『大丈夫です‥‥。』"
		   voices=""/>
		<msg @l="691" char_id="-1" frame_id="-1" name="" text="夜‥‥周囲の人間が寝静まった頃。"
		   voices=""/>
		<msg @l="692" char_id="-1" frame_id="-1" name=""
		   text="合宿所にある空き部屋の一つで、二人の人間が会話していた。" voices=""/>
		<msg @l="693" char_id="-1" frame_id="-1" name=""
		   text="誘ったのは女の方‥‥男は、終始いやらしい笑みを浮かべている。" voices=""/>
		<msg @l="695" char_id="2" frame_id="-1" name="女の声" text="『お姉ちゃんには‥‥負けないもん。』"
		   voices=""/>
		<msg @l="697" char_id="-1" frame_id="-1" name="男の声" text="『なら、来いよ。』"
		   voices=""/>
		<msg @l="699" char_id="2" frame_id="-1" name="女の声" text="『は、はい‥‥。』"
		   voices=""/>
		<wait_chgmv/>
		<bg @l="702" src="bg19b"/>
		<bgm @l="705" src="bgm10" volume="1."/>
		<char @l="708" id="watab" pos="auto" src="watabe010"/>
		<msg @l="710" char_id="-1" frame_id="-1" name="渡部" text="『いい格好だな。』"
		   voices=""/>
		<clear @l="713" class="char"/>
		<char @l="716" id="watab" pos="left" src="watabe010"/>
		<char @l="719" id="akina" pos="right" src="akina065"/>
		<msg @l="721" char_id="2" frame_id="-1" name="亜季奈"
		   text="『せ、せんせえ‥‥なんでこんな格好‥‥。』" voices=""/>
		<char @l="724" id="watab" pos="left" src="watabe014"/>
		<msg @l="726" char_id="-1" frame_id="-1" name="渡部" text="『俺が好きだからだ。』"
		   voices=""/>
		<msg @l="728" char_id="-1" frame_id="-1" name=""
		   text="深夜の合宿所で、亜季奈は部活の時間でもないのに水着を着せられていた。" voices=""/>
		<msg @l="729" char_id="-1" frame_id="-1" name=""
		   text="まだ乾き切っていない競泳水着の布地が、亜季奈の肌にぴったりと張り付く。" voices=""/>
		<msg @l="730" char_id="-1" frame_id="-1" name=""
		   text="かすかに残る塩素の臭いと、水気を含んだ冷たいナイロンの感触に、思わず眉をしかめる。" voices=""/>
		<msg @l="731" char_id="-1" frame_id="-1" name=""
		   text="が、渡部の注文とあっては露骨に嫌がることも出来ず、モジモジしながら渡部の表情を伺っていた。" voices=""/>
		<char @l="734" id="watab" pos="left" src="watabe012"/>
		<msg @l="736" char_id="-1" frame_id="-1" name="渡部"
		   text="『良く似合ってるぞ仲根、こうしているとお前の姉ちゃんを思い出すなぁ。』" voices=""/>
		<msg @l="738" char_id="2" frame_id="-1" name="亜季奈"
		   text="『お姉ちゃんの事は言わないでください。』" voices=""/>
		<char @l="741" id="watab" pos="left" src="watabe010"/>
		<msg @l="743" char_id="-1" frame_id="-1" name="渡部" text="『さあな。そいつはお前さん次第だ。』"
		   voices=""/>
		<char @l="746" id="akina" pos="right" src="akina064"/>
		<msg @l="748" char_id="-1" frame_id="-1" name=""
		   text="そう言って渡部は突然、亜季奈の唇を奪い、舌を絡ませる。" voices=""/>
		<msg @l="749" char_id="-1" frame_id="-1" name=""
		   text="予期せぬ事態に一瞬混乱するが、これが渡部とのファーストキスなのだと悟ると、ウットリしたように全身の力が抜けた。" voices=""/>
		<char @l="752" id="watab" pos="left" src="watabe017"/>
		<msg @l="754" char_id="-1" frame_id="-1" name="渡部"
		   text="『そうじゃねえ！&#32;ヌルいんだよ！』" voices=""/>
		<char @l="757" id="akina" pos="right" src="akina065"/>
		<msg @l="759" char_id="2" frame_id="-1" name="亜季奈" text="『んっ‥‥んんんっ！！』"
		   voices=""/>
		<msg @l="761" char_id="-1" frame_id="-1" name=""
		   text="亜季奈のキスに不満を感じた渡部は、苛立ちを隠そうともせず、強引に亜季奈の口膣内を蹂躙する。" voices=""/>
		<msg @l="763" char_id="-1" frame_id="-1" name="渡部"
		   text="『そらっ、もっと舌を突き出すんだよ！』" voices=""/>
		<char @l="766" id="akina" pos="right" src="akina165"/>
		<msg @l="768" char_id="2" frame_id="-1" name="亜季奈" text="『こっ‥‥こうれふかっ‥‥。』"
		   voices=""/>
		<msg @l="770" char_id="2" frame_id="-1" name="亜季奈" text="『んんんっ！んっ、んふぅーっ。』"
		   voices=""/>
		<msg @l="772" char_id="-1" frame_id="-1" name=""
		   text="餌を求める雛のように、その可愛らしいピンクの舌を限界まで伸ばす亜季奈。" voices=""/>
		<msg @l="773" char_id="-1" frame_id="-1" name=""
		   text="それに満足した渡部は、返事をする代わりに自らの舌をまきつけるように絡め、器用にしごいていく。" voices=""/>
		<msg @l="774" char_id="-1" frame_id="-1" name=""
		   text="やがて亜季奈もそれにならい、渡部の舌に絡めていった。" voices=""/>
		<char @l="777" id="watab" pos="left" src="watabe010"/>
		<msg @l="779" char_id="-1" frame_id="-1" name="渡部"
		   text="『よぉし、いい子だ。次は俺の唾液を飲めっ！』" voices=""/>
		<msg @l="781" char_id="2" frame_id="-1" name="亜季奈"
		   text="『あふぅっ、んんっ‥‥んっ、んっ、んっ。』" voices=""/>
		<char @l="784" id="akina" pos="right" src="akina164"/>
		<msg @l="786" char_id="-1" frame_id="-1" name=""
		   text="褒められたのが嬉しかったのか、渡部の口内に溜められた唾をゴクゴク飲み干していく。" voices=""/>
		<msg @l="787" char_id="-1" frame_id="-1" name=""
		   text="粘り気のある液体が喉を通る度に、亜季奈は躰の内側に熱いものを感じ、肩を震わせていた。" voices=""/>
		<msg @l="789" char_id="-1" frame_id="-1" name="渡部" text="『よし、そろそろやるか。』"
		   voices=""/>
		<msg @l="791" char_id="-1" frame_id="-1" name=""
		   text="そう言って渡部はズボンを脱ぎ始めると、股間の中央から天を衝くような肉棒が姿を現した。" voices=""/>
		<char @l="794" id="akina" pos="right" src="akina064"/>
		<msg @l="796" char_id="2" frame_id="-1" name="亜季奈" text="『ひっ！？』" voices=""/>
		<msg @l="798" char_id="-1" frame_id="-1" name="" text="グロテスクな剛棒に、思わず息を飲む。"
		   voices=""/>
		<char @l="801" id="watab" pos="left" src="watabe012"/>
		<msg @l="804" char_id="-1" frame_id="-1" name="渡部"
		   text="『驚く事ないだろう。お前を女にするありがたいモノだぞ。』" voices=""/>
		<char @l="807" id="akina" pos="right" src="akina065"/>
		<msg @l="809" char_id="2" frame_id="-1" name="亜季奈" text="『せ、せんせい、でもまだ‥‥。』"
		   voices=""/>
		<msg @l="811" char_id="-1" frame_id="-1" name=""
		   text="舌を絡めている間、渡部は両手で胸や股間を触り続けていたが、本格的な愛撫と比較したらまだまだ物足りない。" voices=""/>
		<msg @l="812" char_id="-1" frame_id="-1" name=""
		   text="それでも唾液を飲んで興奮したのか、亜季奈の花唇からはねっとりとした蜜液が漏れ出し、太股の間を伝っていた。" voices=""/>
		<char @l="815" id="watab" pos="left" src="watabe010"/>
		<msg @l="817" char_id="-1" frame_id="-1" name="渡部" text="『足りない分はこれで補ってやる。』"
		   voices=""/>
		<msg @l="819" char_id="-1" frame_id="-1" name=""
		   text="そう言って渡部はごつごつした手のひらに唾液をたっぷりとまぶし、亜季奈の股の間に塗りこんでいく。" voices=""/>
		<char @l="822" id="akina" pos="right" src="akina164"/>
		<msg @l="824" char_id="2" frame_id="-1" name="亜季奈" text="『ひゃっ。』" voices=""/>
		<char @l="827" id="akina" pos="right" src="akina065"/>
		<msg @l="829" char_id="2" frame_id="-1" name="亜季奈"
		   text="『せんせい、やさしく‥‥やさしくして‥‥。』" voices=""/>
		<char @l="832" id="watab" pos="left" src="watabe017"/>
		<msg @l="834" char_id="-1" frame_id="-1" name="渡部" text="『無理だな。』" voices=""/>
		<msg @l="836" char_id="-1" frame_id="-1" name=""
		   text="うわごとのようにお願いを繰り返す亜季奈に、渡部は冷たく言い放つ。" voices=""/>
		<msg @l="837" char_id="-1" frame_id="-1" name="" text="亜季奈の頬を涙が一筋流れた。"
		   voices=""/>
		<label @l="840" id="chart_line21"/>
		<wait_chgmv/>
		<ev @l="843" src="ev-049"/>
		<description @l="846" text="散らされる蕾"/>
		<bgm @l="849" src="bgm14" volume="1."/>
		<msg @l="851" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んっ‥‥‥あぐっっ‥‥いっ‥‥痛いっっ！！』" voices="akina00560"/>
		<msg @l="853" char_id="-1" frame_id="-1" name=""
		   text="女の狭い秘部を、鉄のように硬く屹立した剛直がみしみしと押し割っていく。" voices=""/>
		<msg @l="854" char_id="-1" frame_id="-1" name=""
		   text="初めてなのだろうそこは十分にほぐされたわけでもなく‥‥また男のモノを受け入れるだけの潤滑液も足りず、真っ赤にはれ上がってしまっている。"
		   voices=""/>
		<msg @l="855" char_id="-1" frame_id="-1" name=""
		   text="無理やり押し広げられた膣口と肉棒の間からは、処女の証でもある鮮血の筋が徐々に流れ落ちてきていた。" voices=""/>
		<msg @l="857" char_id="2" frame_id="-1" name="亜季奈"
		   text="『いっ‥‥う、んぐっっ‥‥痛いっ‥‥痛いよぉっ！！』" voices="akina00570"/>
		<msg @l="859" char_id="-1" frame_id="-1" name="渡部" text="『そら、これで全部だ。』"
		   voices=""/>
		<msg @l="861" char_id="-1" frame_id="-1" name=""
		   text="男は、女の細い身体を力まかせに抱き寄せながら満足げに言った。" voices=""/>
		<msg @l="862" char_id="-1" frame_id="-1" name="" text="微塵も‥‥気遣う様子がない。"
		   voices=""/>
		<msg @l="863" char_id="-1" frame_id="-1" name=""
		   text="ただ求めるままに幼さの残る肉体を抱きかかえ、下から肉のピストンを突き上げる。" voices=""/>
		<msg @l="864" char_id="-1" frame_id="-1" name=""
		   text="彼の脳裏には、目の前で息も絶え絶えに喘いでいるこの少女を利用した、ドス黒い計略が渦巻いていた。" voices=""/>
		<msg @l="866" char_id="2" frame_id="-1" name="亜季奈"
		   text="『はっ‥‥はっ、はっ‥‥いたっ‥‥ん、くぅっ！！』" voices="akina00580"/>
		<msg @l="868" char_id="2" frame_id="-1" name="亜季奈"
		   text="『へいき‥‥です‥‥‥‥続けてください‥‥‥‥。』" voices="akina00590"/>
		<msg @l="870" char_id="-1" frame_id="-1" name="渡部"
		   text="『言われなくてもそうするつもりだ。タップリ犯してやるぞ。』" voices=""/>
		<msg @l="872" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んんっっ‥‥痛っ‥‥痛い‥‥‥‥。』" voices="akina00600"/>
		<msg @l="874" char_id="-1" frame_id="-1" name=""
		   text="ギチギチと音を立てながら、女の花芯が押し広げられる。" voices=""/>
		<msg @l="875" char_id="-1" frame_id="-1" name=""
		   text="女の身体は男のそれに対して小さすぎる‥‥見るからに無理があるのだ。" voices=""/>
		<msg @l="877" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んっ、んんっ‥‥いたっ‥‥ふ、あぐっ‥‥いたいっ‥‥。』" voices="akina00610"/>
		<msg @l="879" char_id="2" frame_id="-1" name="亜季奈"
		   text="『はっ‥‥はっ‥‥‥んんっ‥‥‥くあっっ‥‥いたっ‥‥いたいよー‥‥！！』" voices="akina00620"/>
		<msg @l="881" char_id="-1" frame_id="-1" name=""
		   text="渡部が肉棒で最奥を突き上げ始めると、亜季奈は息苦しそうに息を吐いて喘ぐ。" voices=""/>
		<msg @l="882" char_id="-1" frame_id="-1" name=""
		   text="ゴリゴリと子宮口をえぐる度に、呼吸音とも喘ぎ声ともつかない吐息が、リズミカルに喉の奥から漏れた。" voices=""/>
		<msg @l="883" char_id="-1" frame_id="-1" name=""
		   text="次第に亜季奈の喘ぎは‥‥ただ、苦しげな呼吸を繰り返しているだけになっていた。" voices=""/>
		<msg @l="885" char_id="-1" frame_id="-1" name="渡部"
		   text="『いいぞ、小さいマ○コが俺の肉棒を痛いくらい締め付けてくるな。』" voices=""/>
		<msg @l="887" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んんっ‥‥んっ、んっ、んっ‥‥‥あぐっ‥‥‥。』" voices="akina00630"/>
		<msg @l="889" char_id="2" frame_id="-1" name="亜季奈"
		   text="『せんせ‥‥ぐ、ああっ‥‥‥‥苦し‥‥いたっ‥‥んはっ！！』" voices="akina00640"/>
		<msg @l="891" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んんっんっ‥‥、止めて‥‥‥‥ん、ふあぁっっ‥‥いたいっっ！！』" voices="akina00650"/>
		<msg @l="893" char_id="-1" frame_id="-1" name="渡部"
		   text="『おいおい、まだ突っ込んだばっかりだぞ‥‥音をあげるにはちょっとばかり早過ぎないか。』" voices=""/>
		<msg @l="895" char_id="2" frame_id="-1" name="亜季奈"
		   text="『で、でも‥‥‥センセイの‥‥‥大きすぎて‥‥‥‥‥。』" voices="akina00660"/>
		<msg @l="897" char_id="-1" frame_id="-1" name="渡部"
		   text="『うれしいこと言ってくれるじゃないか。俺のが大きいのかもしれないが、それ以上に仲根のマ○コが小さすぎるんだよ。』" voices=""/>
		<msg @l="899" char_id="-1" frame_id="-1" name="渡部"
		   text="『気持ちよくなりたかったら俺のモノに合わせてマ○コを広げろ、いいな。』" voices=""/>
		<msg @l="901" char_id="2" frame_id="-1" name="亜季奈"
		   text="『そん、なっ‥‥‥んっ‥‥ああっっ！！』" voices="akina00670"/>
		<msg @l="903" char_id="-1" frame_id="-1" name=""
		   text="再び、傷つき血のしたたる亜季奈の胎内を肉棒が圧迫する。" voices=""/>
		<msg @l="904" char_id="-1" frame_id="-1" name=""
		   text="亜季奈は処女を破られた部分を擦られるたびにビクビクと腰を震わせ、目に涙をため悲痛な吐息を漏らす。" voices=""/>
		<msg @l="905" char_id="-1" frame_id="-1" name=""
		   text="何故自分がそうしているのか、何がしたかったのか‥‥もう既に、痛みで考えられなくなってしまっていた。" voices=""/>
		<msg @l="907" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んぁっ‥‥‥んっ‥‥‥あ、んぐっ‥‥‥‥。』" voices="akina00680"/>
		<msg @l="909" char_id="-1" frame_id="-1" name="渡部" text="『力を抜け‥‥裂けてしまうぞ。』"
		   voices=""/>
		<msg @l="911" char_id="-1" frame_id="-1" name="渡部"
		   text="『ほら、クリ○リスを弄ってやる‥‥ココなら気持ちいいだろう？』" voices=""/>
		<msg @l="913" char_id="2" frame_id="-1" name="亜季奈"
		   text="『ふっ‥‥んっ、んんっ‥‥‥はっ‥‥はふっ‥‥‥。』" voices="akina00690"/>
		<msg @l="915" char_id="2" frame_id="-1" name="亜季奈"
		   text="『やあっ‥‥‥それ‥‥‥ダメ、いたっ‥‥いたいっっ‥‥んぐっ！！』" voices="akina00700"/>
		<msg @l="917" char_id="-1" frame_id="-1" name=""
		   text="渡部の指が秘部にある小突起を転がすたび、亜季奈の膣肉は深くまで打ち込まれた肉の楔を締め付けてしまう。" voices=""/>
		<msg @l="918" char_id="-1" frame_id="-1" name=""
		   text="そうして膣壁の肉襞が剛棒を締め付けると‥‥ただでさえ狭い膣内が異物を押し出そうという動きに変わってしまうのだ。" voices=""/>
		<msg @l="920" char_id="-1" frame_id="-1" name="渡部"
		   text="『何がダメだ、もう一回力を抜かないと‥‥奥までブチこめないだろうがっ！』" voices=""/>
		<msg @l="922" char_id="2" frame_id="-1" name="亜季奈"
		   text="『いた、いっ‥‥‥ん、ひっ‥‥あぐっ‥‥いたいよーっ！』" voices="akina00710"/>
		<msg @l="924" char_id="2" frame_id="-1" name="亜季奈"
		   text="『くっ‥‥あっ、ああっ‥‥‥んぐ‥‥‥‥あ、うぐっ！！』" voices="akina00720"/>
		<msg @l="926" char_id="-1" frame_id="-1" name="渡部"
		   text="『おら、小さな胸もたっぷり揉んでやる‥‥‥ん、いいぞ、もっと力を抜けっ！』" voices=""/>
		<msg @l="928" char_id="-1" frame_id="-1" name=""
		   text="そうして、渡部の手が亜季奈の肩をつかみ思いっきり体重をかけ、無理やり剛棒を一番奥まで突き刺す。" voices=""/>
		<msg @l="930" char_id="2" frame_id="-1" name="亜季奈" text="『ひぃ――――――ッ！？』"
		   voices="akina00730"/>
		<msg @l="932" char_id="2" frame_id="-1" name="亜季奈"
		   text="『うあっ‥‥‥あっ、ああああああああっ！！！』" voices="akina00740"/>
		<msg @l="934" char_id="-1" frame_id="-1" name=""
		   text="楽しげに言いながら、渡部は亜季奈の秘部におさまりきらない肉棒をさらに押し込むようにし、子宮口を無理やり突き上げ徐々にピッチを上げながら秘所をかきまわした。"
		   voices=""/>
		<msg @l="936" char_id="2" frame_id="-1" name="亜季奈"
		   text="『いっ‥‥う、んぐっっ‥‥痛いっ‥‥痛いよぉっ！！』" voices="akina00570"/>
		<msg @l="938" char_id="-1" frame_id="-1" name=""
		   text="亜季奈の控えめな桜色の花唇は、グロテスクな肉棒によって裂けそうなほど無残に大きく拡げられていた。" voices=""/>
		<msg @l="940" char_id="2" frame_id="-1" name="亜季奈"
		   text="『はっ‥‥はっ‥‥‥んんっ‥‥‥くあっっ‥‥いたっ‥‥いたいよー‥‥！！』" voices="akina00620"/>
		<msg @l="942" char_id="-1" frame_id="-1" name=""
		   text="渡部は亜季奈の反応を見て、残酷な笑みを浮かべ嬉しそうに腰を打ち続ける。" voices=""/>
		<msg @l="944" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んんっっ‥‥痛っ‥‥痛い‥‥‥‥。』" voices="akina00600"/>
		<msg @l="946" char_id="-1" frame_id="-1" name=""
		   text="合宿部屋には亜季奈の秘部から処女膜の破瓜により出血したクチュクチュという血の音が響く。" voices=""/>
		<msg @l="948" char_id="-1" frame_id="-1" name="渡部"
		   text="『へへっ‥‥オマエの苦しがっている顔を見ていたら俺も気持ちよくなってきたぜ。』" voices=""/>
		<msg @l="950" char_id="-1" frame_id="-1" name="渡部"
		   text="『オマエのちっちゃいオマ○コに俺のザーメンをたっぷり出してやるからな！』" voices=""/>
		<msg @l="951" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んんっんっ‥‥、止めて‥‥‥‥ん、ふあぁっっ‥‥いたいっっ！！』" voices="akina00650"/>
		<msg @l="953" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んんっ‥‥んっ、んっ、んっ‥‥‥あぐっ‥‥‥。』" voices="akina00630"/>
		<msg @l="955" char_id="2" frame_id="-1" name="亜季奈"
		   text="『うあっ‥‥‥あっ、ああああああああっ！！！』" voices="akina00740"/>
		<flash @l="959" count="4" fade="100" image="white"/>
		<wait_chgmv/>
		<ev @l="962" src="ev-049x1z1"/>
		<flash @l="966" count="4" fade="100" image="white"/>
		<msg @l="967" char_id="-1" frame_id="-1" name=""
		   text="室内に悲鳴まがいの絶叫が響き渡り、亜季奈が身体を強張らせてうち震えた。" voices=""/>
		<msg @l="968" char_id="-1" frame_id="-1" name=""
		   text="次の瞬間、亜季奈の子宮口‥‥奥深い場所で肉棒が爆ぜ、ほとばしった精液がたっぷりと注ぎ込まれる。" voices=""/>
		<msg @l="970" char_id="-1" frame_id="-1" name="渡部"
		   text="『へへ‥‥小さいマ○コだがいい具合だったぞ、亜季奈。』" voices=""/>
		<msg @l="972" char_id="2" frame_id="-1" name="亜季奈"
		   text="『うあっ‥‥‥あ‥‥‥ああ‥‥‥‥‥。』" voices="akina00750"/>
		<msg @l="974" char_id="-1" frame_id="-1" name=""
		   text="渡部のささやきに、亜季奈は言葉を返す事が出来ない。" voices=""/>
		<msg @l="975" char_id="-1" frame_id="-1" name=""
		   text="亜季奈の意識は膣内に吐き出された熱い精子と同様に白濁としていて、何を囁かれているのかも判らないのだ。" voices=""/>
		<msg @l="976" char_id="-1" frame_id="-1" name=""
		   text="そうしてしばらく渡部の上で打ち震えていた亜季奈は、やがてあやつり糸の切れた人形のようにゆっくりと倒れ込んだ‥‥。" voices=""/>
		<stopbgm @l="979" fadeout="1000"/>
		<clear @l="982" class="all"/>
		<wait_chgmv/>
		<bg @l="985" src="bg19b"/>
		<bgm @l="988" src="bgm10" volume="1."/>
		<msg @l="990" char_id="2" frame_id="-1" name="亜季奈" text="『‥‥‥すぅ‥‥‥すぅ‥‥‥‥。』"
		   voices=""/>
		<msg @l="992" char_id="-1" frame_id="-1" name="渡部" text="『ふぅ‥‥気絶したか。』"
		   voices=""/>
		<msg @l="994" char_id="-1" frame_id="-1" name=""
		   text="意識を失って倒れ込んだ亜季奈を床に転がして、渡部が立ち上がる。" voices=""/>
		<msg @l="995" char_id="-1" frame_id="-1" name=""
		   text="その目には何処か蔑んだモノを見るような色が浮かんでいた。" voices=""/>
		<msg @l="997" char_id="-1" frame_id="-1" name="渡部"
		   text="『まさかこいつの方から近づいてきてくれるとはな‥‥。』" voices=""/>
		<msg @l="999" char_id="-1" frame_id="-1" name="渡部"
		   text="『まあその分、手間が省けて助かったわけだが‥‥。』" voices=""/>
		<msg @l="1001" char_id="-1" frame_id="-1" name=""
		   text="渡部は部屋と外を仕切る障子に向かって、邪悪な笑みを浮かべる。" voices=""/>
		<msg @l="1003" char_id="-1" frame_id="-1" name="人影" text="『‥‥‥‥。』" voices=""/>
		<msg @l="1005" char_id="-1" frame_id="-1" name=""
		   text="障子に浮かんだ‥‥人影に向かって････････。" voices=""/>
		<stopbgm @l="1008" fadeout="1000"/>
		<clear @l="1011" class="all"/>
		<end_scene @l="1014"/>
		<call @l="1017" target="EventLabel_80@root_akina05"/>
		<return @l="1018" value="0&#13;&#10;"/>
		<return @l="1021" value=""/>
	</code>
</xscript>
