<?xml version="1.0" encoding="utf-8"?>
<xscript>
	<debug editor="&quot;C:\Program&#32;Files&#32;(x86)\sakura\sakura.exe&quot;&#32;&quot;%src%&quot;&#32;-Y=%line%"
	   src="D:\シロップ\町ぐるみの罠＋汚された夏セット版\汚された夏\完成データ\汚された夏\script\text\root_akina01.txt"/>
	<code>
		<label @l="13" id="EventLabel_59"/>
		<description @l="17" text="水泳コーチ・初日"/>
		<eval @l="19" expr="f.numDay=8&#13;&#10;"/>
		<msgshow @l="21" show="false"/>
		<wait_chgmv/>
		<bg @l="23" src="day08" time="2000"/>
		<wait @l="25" time="500"/>
		<wait_chgmv/>
		<bg @l="27" src="black" time="2000"/>
		<msgshow @l="29" show="true"/>
		<wait_chgmv/>
		<bg @l="33" src="bg03"/>
		<bgm @l="37" src="bgm04" volume="1."/>
		<char @l="41" id="miho" pos="left" src="miho035"/>
		<msg @l="43" char_id="0" frame_id="-1" name="美帆" text="『‥‥おはようございます。』"
		   voices=""/>
		<char @l="47" id="rei" pos="right" src="rei030"/>
		<msg @l="49" char_id="1" frame_id="-1" name="玲"
		   text="『ええ、おはよう‥‥‥‥って、どうしたの？』" voices=""/>
		<char @l="53" id="rei" pos="right" src="rei034"/>
		<msg @l="55" char_id="1" frame_id="-1" name="玲" text="『目、真っ赤よ？』" voices=""/>
		<msg @l="57" char_id="0" frame_id="-1" name="美帆"
		   text="『ちょっと、レポート‥‥‥を書くための和訳が終わらなくて。』" voices=""/>
		<char @l="61" id="rei" pos="right" src="rei030"/>
		<msg @l="63" char_id="1" frame_id="-1" name="玲" text="『徹夜？』" voices=""/>
		<char @l="66" id="miho" pos="left" src="miho135"/>
		<msg @l="68" char_id="0" frame_id="-1" name="美帆"
		   text="『いえ、いちおう３時間くらいは寝ましたけど‥‥普段はこんな無茶しないので結構つらいですー。』" voices=""/>
		<msg @l="70" char_id="1" frame_id="-1" name="玲" text="『普段はどのくらい寝てるの？』"
		   voices=""/>
		<msg @l="72" char_id="0" frame_id="-1" name="美帆"
		   text="『最低８時間は寝てますよ‥‥お休みの日は、別でお昼寝する事もありますし。』" voices=""/>
		<char @l="75" id="rei" pos="right" src="rei034"/>
		<msg @l="77" char_id="1" frame_id="-1" name="玲" text="『‥‥すごいわね。』" voices=""/>
		<msg @l="79" char_id="0" frame_id="-1" name="美帆"
		   text="『昔から睡眠時間が少ないとすぐに体調が悪くなるんですよ。』" voices=""/>
		<msg @l="81" char_id="0" frame_id="-1" name="美帆"
		   text="『無理しないように気をつけてはいるんですけど‥‥。』" voices=""/>
		<char @l="84" id="rei" pos="right" src="rei031"/>
		<msg @l="86" char_id="1" frame_id="-1" name="玲"
		   text="『それでもまあ、今回のような時に頑張って起きてるわけだ。』" voices=""/>
		<msg @l="88" char_id="1" frame_id="-1" name="玲"
		   text="『でも、どうしてそんな大変なスケジュールに？』" voices=""/>
		<char @l="91" id="rei" pos="right" src="rei030"/>
		<msg @l="93" char_id="1" frame_id="-1" name="玲"
		   text="『レポートの和訳ってそんなに無茶な量だったの？』" voices=""/>
		<char @l="96" id="miho" pos="left" src="miho035"/>
		<msg @l="98" char_id="0" frame_id="-1" name="美帆"
		   text="『レポートもそれなりに大変だったんですけど、一番の原因は「一生のお願い」のせいで‥‥。』" voices=""/>
		<char @l="101" id="rei" pos="right" src="rei034"/>
		<msg @l="103" char_id="1" frame_id="-1" name="玲" text="『一生のお願い‥‥？』"
		   voices=""/>
		<clear @l="109" class="all"/>
		<wait_chgmv/>
		<bg @l="113" src="bg03"/>
		<char @l="117" id="miho" pos="left" src="miho136"/>
		<char @l="121" id="rei" pos="right" src="rei034"/>
		<msg @l="123" char_id="1" frame_id="-1" name="玲" text="『‥‥なるほどね。』" voices=""/>
		<char @l="126" id="rei" pos="right" src="rei030"/>
		<msg @l="128" char_id="1" frame_id="-1" name="玲" text="『だから「一生のお願い」のせいなのね。』"
		   voices=""/>
		<msg @l="130" char_id="-1" frame_id="-1" name=""
		   text="私はボヤくような感じで、コトの経緯を先輩に話したのだった。" voices=""/>
		<msg @l="131" char_id="-1" frame_id="-1" name=""
		   text="ついでに、亜季奈がやらかした過去の「お願い」もこっそりと暴露しておいた。" voices=""/>
		<char @l="134" id="miho" pos="left" src="miho035"/>
		<msg @l="136" char_id="0" frame_id="-1" name="美帆"
		   text="『もう、昔からことあるごとに「一生のお願い」だからって無茶ばかり言うんですよー。』" voices=""/>
		<char @l="139" id="miho" pos="left" src="miho135"/>
		<msg @l="141" char_id="0" frame_id="-1" name="美帆"
		   text="『お願いを聞く方の身にもなって欲しいです‥‥。』" voices=""/>
		<char @l="144" id="rei" pos="right" src="rei031"/>
		<msg @l="146" char_id="1" frame_id="-1" name="玲"
		   text="『ふふっ、確かに一生のお願いを何度も使われちゃ、聞く方も大変よね。』" voices=""/>
		<char @l="149" id="rei" pos="right" src="rei030"/>
		<msg @l="151" char_id="1" frame_id="-1" name="玲"
		   text="『でも、それだけ頼りにされてるって証拠じゃない。』" voices=""/>
		<char @l="154" id="miho" pos="left" src="miho035"/>
		<msg @l="156" char_id="0" frame_id="-1" name="美帆"
		   text="『それは、そうかもしれませんけど‥‥。』" voices=""/>
		<char @l="160" id="rei" pos="right" src="rei031"/>
		<msg @l="162" char_id="1" frame_id="-1" name="玲" text="『がんばりなさい、お姉さん。』"
		   voices=""/>
		<msg @l="164" char_id="0" frame_id="-1" name="美帆" text="『うう‥‥複雑です、それ。』"
		   voices=""/>
		<goto @l="167" cond="!(f.サークル見学会flag&#32;==&#32;2)&#13;&#10;"
		   label="TempLabel_212"/>
		<char @l="171" id="rei" pos="right" src="rei034"/>
		<msg @l="173" char_id="1" frame_id="-1" name="玲"
		   text="『あ、でも、水泳合宿の方に行くのならサークルには出られないわね。』" voices=""/>
		<char @l="176" id="miho" pos="left" src="miho036"/>
		<msg @l="178" char_id="0" frame_id="-1" name="美帆"
		   text="『そうですね‥‥せっかく入ったんですけど、しばらくお休みです。』" voices=""/>
		<char @l="182" id="rei" pos="right" src="rei031"/>
		<msg @l="184" char_id="1" frame_id="-1" name="玲"
		   text="『いいわよ、稲庭さんには私の方から適当に伝えておくわ。』" voices=""/>
		<msg @l="186" char_id="1" frame_id="-1" name="玲"
		   text="『自由が「売り」みたいなサークルだけど、入会していきなりなんの説明もなく来なくなったら、さすがにみんな心配するでしょうしね。』"
		   voices=""/>
		<char @l="189" id="miho" pos="left" src="miho136"/>
		<msg @l="191" char_id="0" frame_id="-1" name="美帆" text="『すみません‥‥。』"
		   voices=""/>
		<goto @l="194" label="TempLabel_213"/>
		<label @l="195" id="TempLabel_212"/>
		<msg @l="198" char_id="1" frame_id="-1" name="玲" text="『ふふ。』" voices=""/>
		<char @l="202" id="miho" pos="left" src="miho035"/>
		<msg @l="204" char_id="0" frame_id="-1" name="美帆" text="『わ、笑わないで下さい‥‥。』"
		   voices=""/>
		<char @l="208" id="rei" pos="right" src="rei030"/>
		<msg @l="210" char_id="1" frame_id="-1" name="玲"
		   text="『ごめんなさい、別に悪気があった訳じゃないのよ。』" voices=""/>
		<msg @l="212" char_id="1" frame_id="-1" name="玲"
		   text="『どうこう言っても結局はお願いを聞いちゃうなんて、やっぱり妹思いなんだなぁって関心してただけ。』" voices=""/>
		<char @l="215" id="miho" pos="left" src="miho136"/>
		<msg @l="217" char_id="0" frame_id="-1" name="美帆"
		   text="『それは、あの子が断れないような状況でお願いするからで‥‥。』" voices=""/>
		<char @l="220" id="miho" pos="left" src="miho033"/>
		<msg @l="222" char_id="0" frame_id="-1" name="美帆"
		   text="『別に、妹だからって特別扱いしてるわけじゃ‥‥ないですよ。』" voices=""/>
		<char @l="225" id="rei" pos="right" src="rei031"/>
		<msg @l="227" char_id="1" frame_id="-1" name="玲" text="『あら、照れなくてもいいじゃない。』"
		   voices=""/>
		<char @l="230" id="rei" pos="right" src="rei030"/>
		<msg @l="232" char_id="1" frame_id="-1" name="玲"
		   text="『前にも言ったかもしれないけど、私って、一人っ子だからうらやましいのよ。』" voices=""/>
		<msg @l="234" char_id="1" frame_id="-1" name="玲"
		   text="『ワガママを言ってくれる妹も、ワガママを聞いてくれる姉もいないから。』" voices=""/>
		<char @l="237" id="miho" pos="left" src="miho030"/>
		<msg @l="239" char_id="0" frame_id="-1" name="美帆" text="『そういうものですか‥‥？』"
		   voices=""/>
		<char @l="243" id="rei" pos="right" src="rei031"/>
		<msg @l="245" char_id="1" frame_id="-1" name="玲" text="『そういうものよ。』" voices=""/>
		<label @l="248" id="TempLabel_213"/>
		<clear @l="255" class="all"/>
		<wait_chgmv/>
		<bg @l="259" src="bg09"/>
		<char @l="263" id="miho" pos="auto" src="miho110"/>
		<bgm @l="266" src="bgm02" volume="1."/>
		<msg @l="268" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="270" char_id="-1" frame_id="-1" name="" text="講義が終わってすぐ。" voices=""/>
		<msg @l="271" char_id="-1" frame_id="-1" name=""
		   text="私は仕方なく‥‥室内プールへ向かっていた。" voices=""/>
		<msg @l="272" char_id="-1" frame_id="-1" name=""
		   text="もちろん、亜季奈の「一生のお願い」を簡単に聞き入れるつもりではない。" voices=""/>
		<msg @l="273" char_id="-1" frame_id="-1" name=""
		   text="ただ、水泳合宿のコーチを受けるにしても断るにしても、一度会わなければ話にならないと‥‥思っただけ。" voices=""/>
		<msg @l="274" char_id="-1" frame_id="-1" name=""
		   text="‥‥･･結局、亜季奈に押し切られてしまうだろうけど。" voices=""/>
		<char @l="277" id="miho" pos="auto" src="miho016"/>
		<msg @l="279" char_id="0" frame_id="-1" name="美帆"
		   text="(そういえば････私、ここのプールに行くのって初めてだな･･‥‥)" voices=""/>
		<char @l="283" id="miho" pos="auto" src="miho116"/>
		<msg @l="285" char_id="0" frame_id="-1" name="美帆"
		   text="(････ていうか‥‥あれから一度も泳いでかったっけ･･････)" voices=""/>
		<msg @l="287" char_id="-1" frame_id="-1" name=""
		   text="私の心に浅からぬ傷を残した、あの事件のあった日からもう三年が経つ。" voices=""/>
		<msg @l="288" char_id="-1" frame_id="-1" name=""
		   text="公にする事を避けた甲斐あって、その後、事件について言及されたり噂になるということもなく･･････、" voices=""/>
		<msg @l="289" char_id="-1" frame_id="-1" name="" text="平穏な日々を過ごしてきた････。"
		   voices=""/>
		<msg @l="290" char_id="-1" frame_id="-1" name=""
		   text="‥‥だからといって事件そのものが消えてなくなった訳じゃない。" voices=""/>
		<msg @l="291" char_id="-1" frame_id="-1" name=""
		   text="私はそれが原因で水泳を辞め、以後、自分から泳がなくなった。" voices=""/>
		<msg @l="292" char_id="-1" frame_id="-1" name=""
		   text="泳いでいると････あの事件を思い出してしまいそうで‥‥。" voices=""/>
		<msg @l="293" char_id="-1" frame_id="-1" name=""
		   text="････だから･･プールや海といった場所には近付けないでいた。" voices=""/>
		<msg @l="295" char_id="0" frame_id="-1" name="美帆" text="(あれから三年‥‥か)"
		   voices=""/>
		<msg @l="297" char_id="0" frame_id="-1" name="美帆" text="(もう、そんなにたっちゃったんだ‥‥)"
		   voices=""/>
		<stopbgm @l="301" fadeout="1000"/>
		<clear @l="306" class="all"/>
		<msg @l="308" char_id="-1" frame_id="-1" name=""
		   text="意識していなかった時間の経過を感じた瞬間、フラッシュバックするように、当時の出来事が脳裏に浮かんできた。" voices=""/>
		<bgm @l="312" src="bgm03" volume="1."/>
		<msg @l="314" char_id="-1" frame_id="-1" name=""
		   text="水泳の練習が終わり、私は更衣室で着替えをしていた････。" voices=""/>
		<msg @l="315" char_id="-1" frame_id="-1" name=""
		   text="･･その私を後ろから抱き寄せる男の腕‥‥。" voices=""/>
		<msg @l="316" char_id="-1" frame_id="-1" name=""
		   text="突然の出来事に驚き、声を上げることさえ出来ない私。" voices=""/>
		<msg @l="317" char_id="-1" frame_id="-1" name=""
		   text="男の手が濡れた水着の上から胸を乱暴に揉み上げ‥‥。" voices=""/>
		<msg @l="318" char_id="-1" frame_id="-1" name=""
		   text="もう片方の手がやはり濡れた水着の上からアソコを擦りあげた‥‥。" voices=""/>
		<msg @l="319" char_id="-1" frame_id="-1" name="" text="その瞬間――。" voices=""/>
		<msg @l="320" char_id="-1" frame_id="-1" name=""
		   text="悲鳴と共に男の手から逃げ出し、更衣室を出た所で助けを呼んだ。" voices=""/>
		<msg @l="321" char_id="-1" frame_id="-1" name=""
		   text="これ以上はもう出ないくらい大きな声を出して、精一杯に･･････。" voices=""/>
		<msg @l="322" char_id="-1" frame_id="-1" name="" text="･･そして‥‥。" voices=""/>
		<msg @l="324" char_id="0" frame_id="-1" name="美帆" text="(あ‥‥)" voices=""/>
		<clear @l="330" class="all"/>
		<msgshow @l="332" show="true"/>
		<wait_chgmv/>
		<bg @l="336" src="bg09"/>
		<char @l="340" id="miho" pos="auto" src="miho114"/>
		<msg @l="342" char_id="0" frame_id="-1" name="美帆" text="(いつの間に‥‥)" voices=""/>
		<msg @l="344" char_id="-1" frame_id="-1" name=""
		   text="気が付けば室内プールのある体育館へ通じる渡り廊下に差し掛かっていた。" voices=""/>
		<msg @l="345" char_id="-1" frame_id="-1" name=""
		   text="この辺りは他の校舎へ通じていない所為か、人の行き来が少ない。" voices=""/>
		<char @l="349" id="miho" pos="auto" src="miho116"/>
		<msg @l="351" char_id="0" frame_id="-1" name="美帆" text="‥‥‥‥。" voices=""/>
		<msg @l="353" char_id="0" frame_id="-1" name="美帆"
		   text="(‥‥‥あの時のこと‥‥‥鮮明に覚えてる‥‥‥‥)" voices=""/>
		<msg @l="355" char_id="0" frame_id="-1" name="美帆"
		   text="(‥‥‥私‥‥‥やっぱり、忘れられないのかな‥‥‥‥)" voices=""/>
		<msg @l="357" char_id="-1" frame_id="-1" name=""
		   text="あの時、私を襲ったのは水泳部の顧問をしていた教師だった。" voices=""/>
		<msg @l="358" char_id="-1" frame_id="-1" name=""
		   text="事件が表ざたにならなかった事、未遂だった事が幸いして教員免許の停止だけは免れた････。" voices=""/>
		<msg @l="359" char_id="-1" frame_id="-1" name=""
		   text="･･という話を聞いたけれど、その後どうなったかまでは知らない。" voices=""/>
		<msg @l="360" char_id="-1" frame_id="-1" name=""
		   text="ただ、二度と教育者を名乗る事は出来ないだろうと‥‥皆は言っていた。" voices=""/>
		<char @l="363" id="miho" pos="auto" src="miho016"/>
		<msg @l="365" char_id="0" frame_id="-1" name="美帆" text="(･･ダメ‥‥ちゃんと忘れなきゃ)"
		   voices=""/>
		<stopbgm @l="369" fadeout="1000"/>
		<char @l="373" id="miho" pos="auto" src="miho110"/>
		<msg @l="375" char_id="0" frame_id="-1" name="美帆"
		   text="(いつまでも過去のことを気にしてても仕方ない･･‥‥よね)" voices=""/>
		<clear @l="381" class="all"/>
		<wait_chgmv/>
		<bg @l="385" src="bg10m1"/>
		<bgm @l="389" src="bgm02" volume="1."/>
		<char @l="393" id="miho" pos="auto" src="miho014"/>
		<msg @l="395" char_id="0" frame_id="-1" name="美帆" text="(‥‥へぇ、結構広いんだ)"
		   voices=""/>
		<msg @l="397" char_id="-1" frame_id="-1" name=""
		   text="体育館の三階にある室内プールへとやって来た。" voices=""/>
		<msg @l="398" char_id="-1" frame_id="-1" name=""
		   text="水泳にはあまり力を入れていない大学だと聞いてたが･･。" voices=""/>
		<msg @l="399" char_id="-1" frame_id="-1" name=""
		   text="設備だけは私の知っている限り最新式みたいだ。" voices=""/>
		<msg @l="401" char_id="0" frame_id="-1" name="美帆"
		   text="(新しい大学なんだから、設備が新しいのは当然だけど‥‥)" voices=""/>
		<char @l="404" id="miho" pos="auto" src="miho010"/>
		<msg @l="406" char_id="0" frame_id="-1" name="美帆" text="(なんか変な感じだなぁ‥‥)"
		   voices=""/>
		<char @l="410" id="miho" pos="auto" src="miho110"/>
		<msg @l="412" char_id="0" frame_id="-1" name="美帆"
		   text="(･･と、そうじゃなくて‥‥‥亜季奈はどこかな‥‥‥‥)" voices=""/>
		<msg @l="414" char_id="-1" frame_id="-1" name="" text="室内を見回してみる。" voices=""/>
		<msg @l="415" char_id="-1" frame_id="-1" name=""
		   text="プールサイドとプール内に数人、思い思いに練習している。" voices=""/>
		<msg @l="416" char_id="-1" frame_id="-1" name="" text="誰が水泳部で誰が部外者なのかを知らない。"
		   voices=""/>
		<msg @l="417" char_id="-1" frame_id="-1" name=""
		   text="どの子が亜季奈の学校から来た子なのかは判らない。" voices=""/>
		<char @l="421" id="miho" pos="auto" src="miho011"/>
		<msg @l="423" char_id="0" frame_id="-1" name="美帆"
		   text="(あ‥‥あの子、綺麗なフォームしてるなぁ)" voices=""/>
		<char @l="427" id="miho" pos="auto" src="miho110"/>
		<msg @l="429" char_id="0" frame_id="-1" name="美帆"
		   text="(もう少しブレスのタイミングを調節すればタイム伸びるかも‥‥)" voices=""/>
		<msg @l="431" char_id="-1" frame_id="-1" name="" text="タイムを計っている最中なのだろう。"
		   voices=""/>
		<msg @l="432" char_id="-1" frame_id="-1" name=""
		   text="５０メートルコースを黙々と往復している女の子が一人だけいる。" voices=""/>
		<msg @l="433" char_id="-1" frame_id="-1" name=""
		   text="プールサイドでストップウォッチを持っているのも水着姿の女の子だから、どうも亜季奈のいう「合宿」の練習で計測している訳ではなさそうだ。"
		   voices=""/>
		<msg @l="434" char_id="-1" frame_id="-1" name=""
		   text="とすると、大学の人間という事なのだろうか‥‥？" voices=""/>
		<char @l="437" id="miho" pos="auto" src="miho014"/>
		<msg @l="439" char_id="0" frame_id="-1" name="美帆"
		   text="(へえ、うちの大学にもあんな綺麗な泳ぎする子がいるんだ‥‥)" voices=""/>
		<char @l="442" id="miho" pos="auto" src="miho016"/>
		<msg @l="444" char_id="0" frame_id="-1" name="美帆"
		   text="(ああいう人がいるんだったら、私がコーチなんかしなくても問題ないと思うんだけどなぁ‥‥)" voices=""/>
		<msg @l="446" char_id="0" frame_id="-1" name="美帆"
		   text="(‥‥って、私がそう思ってても、亜季奈を説得しなくちゃ意味がないのよね)" voices=""/>
		<msg @l="448" char_id="0" frame_id="-1" name="美帆"
		   text="(とりあえず‥‥亜季奈が来るまで待ってた方がいいのかしら？)" voices=""/>
		<se @l="451" buf="1" src="ホイッスル（室内プール）" volume="1."/>
		<msg @l="453" char_id="-1" frame_id="-1" name=""
		   text="泳いでいた女の子が飛び込み台にタッチし、タイムを計っていた女の子がホイッスルを吹いて計測終了を報せる。" voices=""/>
		<char @l="456" id="miho" pos="auto" src="miho010"/>
		<msg @l="458" char_id="0" frame_id="-1" name="美帆" text="(計測、終わったみたいね)"
		   voices="miho03260"/>
		<msg @l="460" char_id="0" frame_id="-1" name="美帆"
		   text="(泳いでた子がキャップとゴーグルを取って‥‥え！？)" voices="miho03270"/>
		<char @l="463" id="miho" pos="auto" src="miho014"/>
		<bgm @l="466" src="bgm06" volume="1."/>
		<label @l="469" id="chart_line6"/>
		<wait_chgmv/>
		<ev @l="472" src="ev-002"/>
		<description @l="475" text="練習中の亜季奈"/>
		<msg @l="477" char_id="2" frame_id="-1" name="水着の女の子" text="『‥‥‥‥。』"
		   voices="akina00000"/>
		<msg @l="479" char_id="0" frame_id="-1" name="美帆" text="(うそ‥‥あれ、亜季奈じゃないっ)"
		   voices="miho03280"/>
		<msg @l="481" char_id="-1" frame_id="-1" name=""
		   text="キャップとゴーグルを取ってプールサイドに上がってきたのは･･亜季奈だった。" voices=""/>
		<msg @l="482" char_id="-1" frame_id="-1" name=""
		   text="亜季奈はこちらに気づいた様子もなく、先程までタイムを計っていた女の子と話をしながら水着の裾を直したりしている。" voices=""/>
		<msg @l="484" char_id="0" frame_id="-1" name="美帆"
		   text="(確か春の大会では優勝だったらしいけど‥‥。正直、あんなに綺麗なフォームしてるなんて思わなかった‥‥)"
		   voices="miho03290"/>
		<msg @l="486" char_id="0" frame_id="-1" name="美帆"
		   text="(私が水泳部だった頃は、時々、市民プールとかに行って泳ぎを見てあげてたけど‥‥あの頃なんかより全然上達してるから、わからなかったわ‥‥)"
		   voices="miho03300"/>
		<msg @l="488" char_id="0" frame_id="-1" name="美帆" text="『亜季奈っ。』"
		   voices="miho03310"/>
		<wait_chgmv/>
		<ev @l="491" src="ev-002x1"/>
		<msg @l="493" char_id="2" frame_id="-1" name="亜季奈" text="『ん‥‥？』"
		   voices="akina00010"/>
		<msg @l="495" char_id="-1" frame_id="-1" name=""
		   text="自分の名前を呼ぶ声に気付き、亜季奈が振り返る。" voices=""/>
		<msg @l="496" char_id="-1" frame_id="-1" name=""
		   text="けれど誰に呼ばれたのか分からないらしく、キョロキョロしている。" voices=""/>
		<msg @l="498" char_id="0" frame_id="-1" name="美帆" text="『亜季奈、こっちよ、こっち。』"
		   voices="miho03320"/>
		<wait_chgmv/>
		<ev @l="501" src="ev-002x2"/>
		<msg @l="503" char_id="2" frame_id="-1" name="亜季奈" text="『あ、お姉ちゃんっ！！』"
		   voices="akina00020"/>
		<msg @l="505" char_id="2" frame_id="-1" name="亜季奈" text="『来てくれたんだ！！』"
		   voices="akina00030"/>
		<msg @l="507" char_id="0" frame_id="-1" name="美帆"
		   text="『あんな風に電話を切られたら、行かないわけにはいかないでしょ～。』" voices="miho03330"/>
		<msg @l="509" char_id="2" frame_id="-1" name="亜季奈" text="『えへへへ、作戦成功～。』"
		   voices="akina00040"/>
		<msg @l="511" char_id="0" frame_id="-1" name="美帆" text="『もう‥‥。』"
		   voices="miho03340"/>
		<clear @l="514" class="all"/>
		<wait_chgmv/>
		<bg @l="517" src="bg10m1"/>
		<char @l="520" id="miho" pos="left" src="miho016"/>
		<char @l="523" id="akina" pos="right" src="akina161"/>
		<description @l="526" text="水泳コーチ・初日"/>
		<msg @l="528" char_id="2" frame_id="-1" name="亜季奈" text="『やほ。お姉ちゃん、久しぶりだね。』"
		   voices=""/>
		<msg @l="530" char_id="0" frame_id="-1" name="美帆" text="『何が「久しぶりだね」よ！』"
		   voices=""/>
		<char @l="533" id="miho" pos="left" src="miho116"/>
		<msg @l="535" char_id="0" frame_id="-1" name="美帆"
		   text="『珍しくそっちから電話してきたかと思ったら････。いきなり水泳合宿のコーチをしてだなんて‥‥。』" voices=""/>
		<char @l="538" id="akina" pos="right" src="akina062"/>
		<msg @l="540" char_id="2" frame_id="-1" name="亜季奈"
		   text="『まぁまぁ、細かいことは気にしないで。』" voices=""/>
		<char @l="543" id="miho" pos="left" src="miho014"/>
		<msg @l="545" char_id="0" frame_id="-1" name="美帆" text="『気にするわよ！』" voices=""/>
		<char @l="548" id="miho" pos="left" src="miho016"/>
		<msg @l="550" char_id="0" frame_id="-1" name="美帆"
		   text="『大体、なんで水泳合宿、ウチの大学なんかに来るのよ。』" voices=""/>
		<msg @l="552" char_id="0" frame_id="-1" name="美帆"
		   text="『亜季奈の通ってるとこ、別にウチの大学の付属って訳でもないでしょ？』" voices=""/>
		<char @l="555" id="akina" pos="right" src="akina160"/>
		<msg @l="557" char_id="2" frame_id="-1" name="亜季奈" text="『詳しい事は私にもわかんないよ～。』"
		   voices=""/>
		<msg @l="559" char_id="2" frame_id="-1" name="亜季奈"
		   text="『･･偶然、先生が見付けてきたのがお姉ちゃんの通ってる大学だったんだもん！』" voices=""/>
		<char @l="562" id="miho" pos="left" src="miho010"/>
		<msg @l="564" char_id="0" frame_id="-1" name="美帆" text="『そ、そうなんだ‥‥。』"
		   voices=""/>
		<char @l="567" id="miho" pos="left" src="miho116"/>
		<msg @l="569" char_id="0" frame_id="-1" name="美帆"
		   text="『でも、ウチに宿泊施設なんてあったかしら？』" voices=""/>
		<char @l="572" id="akina" pos="right" src="akina061"/>
		<msg @l="574" char_id="2" frame_id="-1" name="亜季奈"
		   text="『なんか、古っちいのがあるらしいよ？』" voices=""/>
		<char @l="577" id="akina" pos="right" src="akina060"/>
		<msg @l="579" char_id="2" frame_id="-1" name="亜季奈"
		   text="『元々あった旅館だかなんかを、取り壊さずにとっておいて、夏とかの合宿所にしてるんだって。』" voices=""/>
		<char @l="582" id="miho" pos="left" src="miho010"/>
		<msg @l="584" char_id="0" frame_id="-1" name="美帆" text="『ふぅん‥‥。』" voices=""/>
		<char @l="587" id="miho" pos="left" src="miho116"/>
		<msg @l="589" char_id="-1" frame_id="-1" name=""
		   text="私より亜季奈の方が大学内の事を知っているのは、チョット恥ずかしいかも‥‥。" voices=""/>
		<char @l="592" id="akina" pos="right" src="akina061"/>
		<msg @l="594" char_id="2" frame_id="-1" name="亜季奈"
		   text="『と、それよりもお姉ちゃん。早く着替えておいでよ？』" voices=""/>
		<char @l="597" id="akina" pos="right" src="akina162"/>
		<msg @l="599" char_id="2" frame_id="-1" name="亜季奈"
		   text="『プールサイドで一人だけ私服ってバカみたいだよ？』" voices=""/>
		<char @l="602" id="miho" pos="left" src="miho016"/>
		<msg @l="604" char_id="0" frame_id="-1" name="美帆" text="『バカで悪かったわね‥‥。』"
		   voices=""/>
		<char @l="607" id="miho" pos="left" src="miho110"/>
		<msg @l="609" char_id="0" frame_id="-1" name="美帆"
		   text="『それに私はまだコーチを引き受けるなんて、ひと言も‥‥。』" voices=""/>
		<char @l="612" id="akina" pos="right" src="akina061"/>
		<msg @l="614" char_id="2" frame_id="-1" name="亜季奈"
		   text="『ほらほら、そんなコトはいいからさっさと更衣室にいく！』" voices=""/>
		<char @l="617" id="akina" pos="right" src="akina062"/>
		<msg @l="619" char_id="2" frame_id="-1" name="亜季奈"
		   text="『どうせそのカバンの中に水着、入ってるんでしょ？』" voices=""/>
		<char @l="622" id="miho" pos="left" src="miho016"/>
		<msg @l="624" char_id="0" frame_id="-1" name="美帆" text="『うぅ‥‥それは‥‥‥‥。』"
		   voices=""/>
		<msg @l="626" char_id="-1" frame_id="-1" name="" text="確かに、カバンの中には水着が入っている。"
		   voices=""/>
		<msg @l="627" char_id="-1" frame_id="-1" name=""
		   text="去年の夏休み前に海に行くからと、友達と一緒に買いに行った水着だ。" voices=""/>
		<msg @l="628" char_id="-1" frame_id="-1" name=""
		   text="結局は海に行かなかったから‥‥新品同様なんだけど。" voices=""/>
		<char @l="631" id="akina" pos="right" src="akina161"/>
		<msg @l="633" char_id="2" frame_id="-1" name="亜季奈"
		   text="『ほーらー、いいから早く着替えてくる！』" voices=""/>
		<char @l="636" id="miho" pos="left" src="miho114"/>
		<msg @l="638" char_id="0" frame_id="-1" name="美帆" text="『わっ‥‥もう、押さないでよ。』"
		   voices=""/>
		<clear @l="641" class="all"/>
		<wait_chgmv/>
		<bg @l="644" src="bg11"/>
		<char @l="647" id="akina" pos="left" src="akina161"/>
		<msg @l="649" char_id="2" frame_id="-1" name="亜季奈" text="『はい、ここが更衣室だから。』"
		   voices=""/>
		<char @l="652" id="miho" pos="right" src="miho014"/>
		<msg @l="654" char_id="0" frame_id="-1" name="美帆"
		   text="『更衣室って‥‥亜季奈････あなたねぇ。』" voices=""/>
		<char @l="657" id="akina" pos="left" src="akina061"/>
		<msg @l="659" char_id="2" frame_id="-1" name="亜季奈" text="『お姉ちゃん、往生際が悪いよ？』"
		   voices=""/>
		<char @l="662" id="akina" pos="left" src="akina067"/>
		<msg @l="664" char_id="2" frame_id="-1" name="亜季奈"
		   text="『ここまで来たら黙ってコーチをする！&#32;ＯＫ？』" voices=""/>
		<char @l="667" id="miho" pos="right" src="miho016"/>
		<msg @l="669" char_id="0" frame_id="-1" name="美帆" text="『う‥‥。』" voices=""/>
		<char @l="672" id="akina" pos="left" src="akina161"/>
		<msg @l="674" char_id="2" frame_id="-1" name="亜季奈" text="『ＯＫ！？』" voices=""/>
		<msg @l="676" char_id="0" frame_id="-1" name="美帆" text="『お、おーけー‥‥。』"
		   voices=""/>
		<char @l="679" id="akina" pos="left" src="akina061"/>
		<msg @l="681" char_id="2" frame_id="-1" name="亜季奈" text="『はい、商談成立～♪』"
		   voices=""/>
		<msg @l="683" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<char @l="686" id="miho" pos="right" src="miho110"/>
		<msg @l="688" char_id="-1" frame_id="-1" name="" text="いつ「商」や「談」があったのか？"
		   voices=""/>
		<msg @l="689" char_id="-1" frame_id="-1" name="" text="ていうか、タチの悪い訪問販売に近い。"
		   voices=""/>
		<char @l="692" id="akina" pos="left" src="akina160"/>
		<msg @l="694" char_id="2" frame_id="-1" name="亜季奈"
		   text="『それじゃ、私はプールの方で待ってるから。』" voices=""/>
		<char @l="697" id="miho" pos="right" src="miho016"/>
		<msg @l="699" char_id="0" frame_id="-1" name="美帆" text="『う、うん。』" voices=""/>
		<char @l="702" id="akina" pos="left" src="akina060"/>
		<msg @l="704" char_id="2" frame_id="-1" name="亜季奈" text="『お姉ちゃん。』" voices=""/>
		<char @l="707" id="miho" pos="right" src="miho010"/>
		<msg @l="709" char_id="0" frame_id="-1" name="美帆" text="『なに？』" voices=""/>
		<char @l="712" id="akina" pos="left" src="akina162"/>
		<msg @l="714" char_id="2" frame_id="-1" name="亜季奈"
		   text="『逃げたら、お母さんに言いつけて、お小遣い減らしてもらうからね。』" voices=""/>
		<char @l="717" id="miho" pos="right" src="miho014"/>
		<msg @l="719" char_id="0" frame_id="-1" name="美帆" text="『なっ‥‥逃げないわよ！』"
		   voices=""/>
		<char @l="722" id="akina" pos="left" src="akina161"/>
		<msg @l="724" char_id="2" frame_id="-1" name="亜季奈" text="『あはははは～。』"
		   voices=""/>
		<stopbgm @l="727" fadeout="1000"/>
		<clear @l="730" class="char"/>
		<char @l="732" id="miho" pos="auto" src="miho016"/>
		<bgm @l="735" src="bgm02" volume="1."/>
		<msg @l="738" char_id="0" frame_id="-1" name="美帆" text="『‥‥もう。』" voices=""/>
		<msg @l="740" char_id="-1" frame_id="-1" name=""
		   text="更衣室を飛び出していく亜季奈の背中を、私はうらめし気に見ていた。" voices=""/>
		<msg @l="741" char_id="-1" frame_id="-1" name="" text="････‥‥。" voices=""/>
		<msg @l="742" char_id="-1" frame_id="-1" name=""
		   text="････････実は････今日持ってきた水着というのが‥‥その‥‥‥。" voices=""/>
		<msg @l="743" char_id="-1" frame_id="-1" name=""
		   text="結構‥‥‥というか、かなり大胆なデザインだったりする。" voices=""/>
		<char @l="746" id="miho" pos="auto" src="miho116"/>
		<msg @l="748" char_id="0" frame_id="-1" name="美帆"
		   text="『でも‥‥水着はこれしかないし････。』" voices=""/>
		<msg @l="750" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<char @l="753" id="miho" pos="auto" src="miho016"/>
		<msg @l="755" char_id="0" frame_id="-1" name="美帆" text="『･･････仕方ない‥‥か。』"
		   voices=""/>
		<msg @l="757" char_id="0" frame_id="-1" name="美帆" text="『とりあえず、着替えよ‥‥。』"
		   voices=""/>
		<clear @l="760" class="all"/>
		<wait_chgmv/>
		<bg @l="763" src="bg11"/>
		<char @l="766" id="miho" pos="auto" src="miho163"/>
		<msg @l="768" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="770" char_id="-1" frame_id="-1" name="" text="着替えてはみたはが‥‥。"
		   voices=""/>
		<msg @l="771" char_id="-1" frame_id="-1" name=""
		   text="その･･････なんというか‥‥かなり浮いてしまうような気がする。" voices=""/>
		<msg @l="772" char_id="-1" frame_id="-1" name=""
		   text="周囲の人間が競泳用の水着をつけている中、自分だけビキニというのもかなりどうかと思うし‥‥。" voices=""/>
		<msg @l="773" char_id="-1" frame_id="-1" name=""
		   text="････この色にしても目立つ事このうえないと思う。" voices=""/>
		<msg @l="775" char_id="0" frame_id="-1" name="美帆"
		   text="『でも‥‥そんなことじゃ、亜季奈は納得しないか‥‥‥。』" voices=""/>
		<char @l="778" id="miho" pos="auto" src="miho166"/>
		<msg @l="780" char_id="0" frame_id="-1" name="美帆" text="『‥‥行くしかないか‥‥。』"
		   voices=""/>
		<clear @l="783" class="all"/>
		<wait_chgmv/>
		<bg @l="786" src="bg10m1"/>
		<char @l="789" id="miho" pos="auto" src="miho166"/>
		<msg @l="791" char_id="0" frame_id="-1" name="美帆"
		   text="『あ、亜季奈‥‥着替えたけど‥‥‥‥。』" voices=""/>
		<char @l="794" id="miho" pos="auto" src="miho165"/>
		<msg @l="796" char_id="0" frame_id="-1" name="美帆" text="『この水着‥‥目立ちすぎるよね‥‥。』"
		   voices=""/>
		<clear @l="799" class="char"/>
		<char @l="801" id="miho" pos="left" src="miho166"/>
		<char @l="803" id="akina" pos="right" src="akina164"/>
		<bgm @l="806" src="bgm06" volume="1."/>
		<msg @l="808" char_id="2" frame_id="-1" name="亜季奈"
		   text="『わ！&#32;お姉ちゃんがビキニとは、大胆だね。』" voices=""/>
		<char @l="811" id="akina" pos="right" src="akina060"/>
		<msg @l="813" char_id="2" frame_id="-1" name="亜季奈"
		   text="『てっきりいつものワンピースだと思ったから、普通のヤツでおっけーだよって言ったんだけど‥‥まぁ、この際だからビキニでもいっか。』"
		   voices=""/>
		<char @l="816" id="akina" pos="right" src="akina062"/>
		<char @l="819" id="miho" pos="left" src="miho065"/>
		<msg @l="821" char_id="0" frame_id="-1" name="美帆" text="『うぅ‥‥全然よくない。』"
		   voices=""/>
		<msg @l="823" char_id="0" frame_id="-1" name="美帆"
		   text="『こうなるなら、ちゃんと競泳用のヤツを買ってきたのに‥‥。』" voices=""/>
		<char @l="826" id="akina" pos="right" src="akina160"/>
		<msg @l="828" char_id="2" frame_id="-1" name="亜季奈"
		   text="『でもお姉ちゃん、競泳用のヤツはもう着たくないって前に言ってたでしょ。』" voices=""/>
		<char @l="831" id="miho" pos="left" src="miho160"/>
		<msg @l="833" char_id="0" frame_id="-1" name="美帆"
		   text="『う‥‥うん、そうなんだけどね････。』" voices=""/>
		<char @l="836" id="akina" pos="right" src="akina060"/>
		<msg @l="838" char_id="2" frame_id="-1" name="亜季奈"
		   text="『確かに、コンマ何秒ってところを争う世界に疲れて、水泳やめちゃったお姉ちゃんの気持ちも解らなくはないけどさ‥‥。』"
		   voices=""/>
		<char @l="841" id="akina" pos="right" src="akina167"/>
		<msg @l="843" char_id="2" frame_id="-1" name="亜季奈"
		   text="『だからって何も水着まで嫌わなくてもいいじゃん。』" voices=""/>
		<char @l="846" id="miho" pos="left" src="miho166"/>
		<msg @l="848" char_id="0" frame_id="-1" name="美帆"
		   text="『それは‥‥自分でも‥そう‥思うんだけどね。』" voices=""/>
		<char @l="851" id="miho" pos="left" src="miho066"/>
		<msg @l="853" char_id="0" frame_id="-1" name="美帆" text="『でも、どうしても‥‥抵抗あるんだ。』"
		   voices=""/>
		<char @l="856" id="akina" pos="right" src="akina060"/>
		<msg @l="858" char_id="2" frame_id="-1" name="亜季奈" text="『ふーん････。』"
		   voices=""/>
		<msg @l="860" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="862" char_id="0" frame_id="-1" name="美帆"
		   text="(私が水泳をやめた本当の理由は‥‥亜季奈も知らない)" voices=""/>
		<msg @l="864" char_id="0" frame_id="-1" name="美帆"
		   text="(亜季奈には‥‥絶対に内緒にしておかないと‥)" voices=""/>
		<char @l="867" id="akina" pos="right" src="akina167"/>
		<msg @l="869" char_id="2" frame_id="-1" name="亜季奈"
		   text="『もう、そうやってふさぎ込んじゃうの悪い癖だよ。』" voices=""/>
		<char @l="872" id="akina" pos="right" src="akina062"/>
		<msg @l="874" char_id="2" frame_id="-1" name="亜季奈"
		   text="『いいじゃん、その水着。‥‥胸がおっきく見えるから、お姉ちゃんにしてはお色気十分でてるし。』" voices=""/>
		<char @l="877" id="miho" pos="left" src="miho164"/>
		<msg @l="879" char_id="0" frame_id="-1" name="美帆" text="『亜季奈っ！』" voices=""/>
		<char @l="882" id="akina" pos="right" src="akina161"/>
		<msg @l="884" char_id="2" frame_id="-1" name="亜季奈"
		   text="『あはははっ、お姉ちゃんが怒った～。』" voices=""/>
		<clear @l="887" layer="akina"/>
		<char @l="890" id="miho" pos="left" src="miho160"/>
		<msg @l="892" char_id="-1" frame_id="-1" name=""
		   text="亜季奈は私から逃げるようにプールサイドを駆けて行く。" voices=""/>
		<msg @l="893" char_id="-1" frame_id="-1" name=""
		   text="子犬のように走り回る亜季奈の姿は、見ていてとてもほほえましい。" voices=""/>
		<msg @l="895" char_id="0" frame_id="-1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="897" char_id="0" frame_id="-1" name="美帆" text="(早く忘れなくちゃ‥‥)"
		   voices=""/>
		<msg @l="899" char_id="0" frame_id="-1" name="美帆" text="(亜季奈も‥‥がんばってるんだもんね)"
		   voices=""/>
		<clear @l="902" class="all"/>
		<wait_chgmv/>
		<bg @l="905" src="bg10m1"/>
		<char @l="908" id="miho" pos="left" src="miho060"/>
		<char @l="911" id="akina" pos="right" src="akina161"/>
		<msg @l="913" char_id="0" frame_id="-1" name="美帆" text="『それで‥‥顧問の先生は？』"
		   voices=""/>
		<msg @l="915" char_id="-1" frame_id="-1" name=""
		   text="妹にコーチを頼まれたからとはいえ、本来なら私は部外者だ。" voices=""/>
		<msg @l="916" char_id="-1" frame_id="-1" name=""
		   text="とりあえず顧問の先生に事情を説明しようとプール内を見回して探してみたが、それらしい姿が見当たらなかった。" voices=""/>
		<char @l="919" id="akina" pos="right" src="akina064"/>
		<msg @l="921" char_id="2" frame_id="-1" name="亜季奈" text="『あ、今日は先生お休みだよ。』"
		   voices=""/>
		<char @l="924" id="miho" pos="left" src="miho064"/>
		<msg @l="926" char_id="0" frame_id="-1" name="美帆" text="『お休み？』" voices=""/>
		<char @l="929" id="miho" pos="left" src="miho160"/>
		<msg @l="931" char_id="-1" frame_id="-1" name=""
		   text="合宿初日から顧問が休みなんて‥‥そんなんで大丈夫なのかな？" voices=""/>
		<char @l="934" id="akina" pos="right" src="akina060"/>
		<msg @l="936" char_id="2" frame_id="-1" name="亜季奈"
		   text="『なんか、どうしても出なくちゃいけない会議があるんだって。』" voices=""/>
		<char @l="939" id="miho" pos="left" src="miho166"/>
		<msg @l="941" char_id="0" frame_id="-1" name="美帆" text="『会議‥‥ねぇ？』" voices=""/>
		<msg @l="943" char_id="-1" frame_id="-1" name=""
		   text="合宿の初日に顧問の先生がいないなんて変なの‥‥。" voices=""/>
		<msg @l="945" char_id="0" frame_id="-1" name="美帆"
		   text="(顧問の先生がそんなでも、亜季奈の実力は上がってるのね)" voices=""/>
		<char @l="948" id="miho" pos="left" src="miho060"/>
		<msg @l="950" char_id="0" frame_id="-1" name="美帆"
		   text="(よっぽど‥‥亜季奈のセンスがいいのかしら)" voices=""/>
		<msg @l="952" char_id="-1" frame_id="-1" name="" text="さっき見た亜季奈の泳ぎを思い出す。"
		   voices=""/>
		<msg @l="953" char_id="-1" frame_id="-1" name=""
		   text="全身をしっかりと伸ばし、ムダの無い速さだけを求めるフォームでありながら、楽しみながら泳いでいるのが伝わってきた。" voices=""/>
		<msg @l="954" char_id="-1" frame_id="-1" name=""
		   text="つまり、それだけ水泳が好きということなのだろう。" voices=""/>
		<msg @l="955" char_id="-1" frame_id="-1" name=""
		   text="なんというか、水泳が好きだった頃の私を思い出して‥‥すごくうらやましかった。" voices=""/>
		<char @l="958" id="akina" pos="right" src="akina064"/>
		<msg @l="960" char_id="2" frame_id="-1" name="亜季奈" text="『お姉ちゃん？』" voices=""/>
		<char @l="963" id="miho" pos="left" src="miho064"/>
		<msg @l="965" char_id="0" frame_id="-1" name="美帆" text="『え、あ‥‥ごめん。』"
		   voices=""/>
		<char @l="968" id="miho" pos="left" src="miho066"/>
		<msg @l="970" char_id="0" frame_id="-1" name="美帆" text="『少し考え事してた。』"
		   voices=""/>
		<char @l="973" id="akina" pos="right" src="akina161"/>
		<msg @l="975" char_id="2" frame_id="-1" name="亜季奈"
		   text="『もうっ‥‥ほんと、お姉ちゃんってばボケボケなんだから！』" voices=""/>
		<char @l="978" id="miho" pos="left" src="miho065"/>
		<msg @l="980" char_id="0" frame_id="-1" name="美帆" text="『ひ、ひどい‥‥。』"
		   voices=""/>
		<char @l="983" id="miho" pos="left" src="miho066"/>
		<msg @l="985" char_id="0" frame_id="-1" name="美帆" text="『えと‥‥とりあえずコーチする？』"
		   voices=""/>
		<char @l="988" id="akina" pos="right" src="akina161"/>
		<msg @l="990" char_id="2" frame_id="-1" name="亜季奈"
		   text="『それよりお姉ちゃん、みんなにお姉ちゃんのこと紹介するからコッチきて。』" voices=""/>
		<clear @l="993" layer="akina"/>
		<char @l="995" id="miho" pos="left" src="miho164"/>
		<msg @l="997" char_id="0" frame_id="-1" name="美帆"
		   text="『やだ、手を引っ張らないでよ‥‥‥ちょっと。』" voices=""/>
		<char @l="1000" id="akina" pos="right" src="akina161"/>
		<msg @l="1002" char_id="2" frame_id="-1" name="亜季奈" text="『早くはやく～。』"
		   voices=""/>
		<clear @l="1005" class="char"/>
		<clear @l="1008" class="all"/>
		<wait_chgmv/>
		<bg @l="1011" src="bg10m1"/>
		<char @l="1013" id="miho" pos="auto" src="miho160"/>
		<msg @l="1015" char_id="0" frame_id="-1" name="美帆"
		   text="『と、というわけで‥‥ただいま紹介を受けました仲根美帆です。』" voices=""/>
		<char @l="1018" id="miho" pos="auto" src="miho063"/>
		<msg @l="1020" char_id="0" frame_id="-1" name="美帆"
		   text="『みなさん、よろしくお願いします‥‥。』" voices=""/>
		<msg @l="1022" char_id="-1" frame_id="-1" name=""
		   text="プールサイドに集まった水泳部の子たちの前で、私は簡単な自己紹介をしてからペコリとおじぎをする。" voices=""/>
		<msg @l="1023" char_id="-1" frame_id="-1" name=""
		   text="合宿に来ている水泳部の子は、亜季奈を含めて十人。" voices=""/>
		<msg @l="1024" char_id="-1" frame_id="-1" name=""
		   text="多すぎず、少なすぎずといったところだろうか。" voices=""/>
		<msg @l="1026" char_id="-1" frame_id="-1" name="水泳部の子Ａ"
		   text="『へー、あれが亜季奈のお姉さんなんだ。』" voices=""/>
		<msg @l="1028" char_id="-1" frame_id="-1" name="水泳部の子Ｂ"
		   text="『亜季奈と違って、おとなしそうだね。』" voices=""/>
		<msg @l="1030" char_id="-1" frame_id="-1" name="水泳部の子Ｃ"
		   text="『でもでも、高校で記録もってたんでしょ？』" voices=""/>
		<msg @l="1032" char_id="0" frame_id="-1" name="美帆"
		   text="『あの‥‥もう三年も泳いでないので‥‥。たぶん実際に泳いで見せることは出来ないと思いますけど‥‥アドバイスくらいならできますから。』"
		   voices=""/>
		<msg @l="1034" char_id="-1" frame_id="-1" name="水泳部の子Ａ" text="『わかりましたー。』"
		   voices=""/>
		<msg @l="1036" char_id="-1" frame_id="-1" name="水泳部の子Ｂ"
		   text="『ねーねー、亜季奈～。お姉さんって前に言ってた、怒ると鬼みたくなる人なの？』" voices=""/>
		<msg @l="1038" char_id="2" frame_id="-1" name="亜季奈"
		   text="『そう！&#32;すっっっっごく怖いんだよ～。』" voices=""/>
		<char @l="1041" id="miho" pos="auto" src="miho064"/>
		<msg @l="1043" char_id="0" frame_id="-1" name="美帆"
		   text="『ちょっと！&#32;亜季奈！！&#32;ウソ教えないでよ～！！』" voices=""/>
		<clear @l="1046" class="char"/>
		<char @l="1048" id="miho" pos="left" src="miho164"/>
		<char @l="1050" id="akina" pos="right" src="akina161"/>
		<msg @l="1052" char_id="2" frame_id="-1" name="亜季奈"
		   text="『えー、と、ゆーわけで、泳ぎのフォームとかブレスのタイミングとか、見て欲しい人は順番にお姉ちゃんに言ってね～。』" voices=""/>
		<char @l="1055" id="miho" pos="left" src="miho065"/>
		<msg @l="1057" char_id="0" frame_id="1" name="美帆" text="（ううっ、ごまかされたぁ）"
		   voices=""/>
		<msg @l="1059" char_id="-1" frame_id="-1" name="水泳部の子たち" text="『はーい。』"
		   voices=""/>
		<msg @l="1061" char_id="-1" frame_id="-1" name=""
		   text="亜季奈の言葉に全員がそろって返事をし、練習に散っていった。" voices=""/>
		<char @l="1064" id="miho" pos="left" src="miho064"/>
		<msg @l="1066" char_id="0" frame_id="1" name="美帆" text="『へえ、素直なモノね。』"
		   voices=""/>
		<char @l="1069" id="akina" pos="right" src="akina061"/>
		<msg @l="1071" char_id="2" frame_id="-1" name="亜季奈"
		   text="『これも優秀な部長に秘められた人望の賜物ですよ。』" voices=""/>
		<char @l="1074" id="miho" pos="left" src="miho061"/>
		<msg @l="1076" char_id="0" frame_id="1" name="美帆" text="『単に亜季奈が上級生だからでしょ。』"
		   voices=""/>
		<char @l="1079" id="akina" pos="right" src="akina062"/>
		<msg @l="1081" char_id="2" frame_id="-1" name="亜季奈" text="『ちぇ、バレたか。』"
		   voices=""/>
		<msg @l="1083" char_id="0" frame_id="1" name="美帆" text="『バレバレよ。』" voices=""/>
		<char @l="1086" id="miho" pos="left" src="miho060"/>
		<msg @l="1088" char_id="0" frame_id="1" name="美帆"
		   text="『でも‥‥本当にこんな事やってていいの？』" voices=""/>
		<msg @l="1090" char_id="0" frame_id="1" name="美帆" text="『亜季奈も今年は受験生なのに。』"
		   voices=""/>
		<char @l="1093" id="akina" pos="right" src="akina060"/>
		<msg @l="1095" char_id="2" frame_id="-1" name="亜季奈"
		   text="『いちおう体育系のスポーツ推薦は狙ってるけど、もしかしたら進学はしないかも‥‥。』" voices=""/>
		<char @l="1098" id="miho" pos="left" src="miho064"/>
		<msg @l="1100" char_id="0" frame_id="1" name="美帆" text="『え、それじゃあどうするの？』"
		   voices=""/>
		<char @l="1103" id="akina" pos="right" src="akina061"/>
		<msg @l="1105" char_id="2" frame_id="-1" name="亜季奈"
		   text="『実業団テスト、受けてみようかなって。』" voices=""/>
		<char @l="1108" id="miho" pos="left" src="miho061"/>
		<msg @l="1110" char_id="0" frame_id="1" name="美帆" text="『わ！&#32;すごいじゃない！』"
		   voices=""/>
		<char @l="1113" id="akina" pos="right" src="akina161"/>
		<msg @l="1115" char_id="2" frame_id="-1" name="亜季奈"
		   text="『大げさだなぁ、テストなら誰でも受けられるよ。』" voices=""/>
		<char @l="1118" id="miho" pos="left" src="miho060"/>
		<msg @l="1120" char_id="0" frame_id="1" name="美帆"
		   text="『でも、実業団テストを受けてみようって思えるだけの実力‥‥ついたってことでしょ？』" voices=""/>
		<char @l="1123" id="akina" pos="right" src="akina060"/>
		<msg @l="1125" char_id="2" frame_id="-1" name="亜季奈"
		   text="『んー、ハッキリとした手ごたえがある訳じゃないよ。』" voices=""/>
		<msg @l="1127" char_id="2" frame_id="-1" name="亜季奈" text="『ただ、試してみたいだけ。』"
		   voices=""/>
		<msg @l="1129" char_id="2" frame_id="-1" name="亜季奈"
		   text="『ほんとに水泳だけでやってけるのか‥‥見極めたいなー、と思って。』" voices=""/>
		<msg @l="1131" char_id="0" frame_id="1" name="美帆" text="『‥‥そっか。』" voices=""/>
		<char @l="1134" id="miho" pos="left" src="miho061"/>
		<msg @l="1136" char_id="0" frame_id="1" name="美帆" text="『亜季奈‥‥がんばってるんだ。』"
		   voices=""/>
		<char @l="1139" id="akina" pos="right" src="akina062"/>
		<msg @l="1141" char_id="2" frame_id="-1" name="亜季奈"
		   text="『だ・か・ら‥‥そのガンバリを無駄にしない為にも、お姉ちゃんにはしっかりコーチをして貰わないとね。』" voices=""/>
		<msg @l="1143" char_id="0" frame_id="1" name="美帆"
		   text="『はいはい。タップリしごいてあげるから、覚悟しなさいね。』" voices=""/>
		<char @l="1146" id="akina" pos="right" src="akina161"/>
		<msg @l="1148" char_id="2" frame_id="-1" name="亜季奈" text="『えへへ、そーこなくっちゃ！』"
		   voices=""/>
		<stopbgm @l="1151" fadeout="1000"/>
		<clear @l="1154" class="all"/>
		<wait_chgmv/>
		<bg @l="1157" src="bg11"/>
		<bgm @l="1160" src="bgm02" volume="1."/>
		<msg @l="1163" char_id="-1" frame_id="-1" name="水泳部の子Ａ" text="『おつかれさまー。』"
		   voices=""/>
		<msg @l="1165" char_id="-1" frame_id="-1" name="水泳部の子Ｂ" text="『おつかれー。』"
		   voices=""/>
		<msg @l="1167" char_id="-1" frame_id="-1" name="水泳部の子Ｃ" text="『うー、お腹すいたー。』"
		   voices=""/>
		<char @l="1170" id="miho" pos="auto" src="miho166"/>
		<msg @l="1172" char_id="0" frame_id="1" name="美帆" text="『‥‥ふぅ。』" voices=""/>
		<msg @l="1174" char_id="-1" frame_id="-1" name=""
		   text="壁にかけられた時計が７時を少し回った頃、大学側の水泳サークルが全員帰るからという理由で、合宿に来ていた亜季奈たちも練習を終えることになった。"
		   voices=""/>
		<msg @l="1175" char_id="-1" frame_id="-1" name=""
		   text="亜季奈の顧問の先生が不在なので、鍵の管理が出来ないというのが理由である。" voices=""/>
		<clear @l="1178" class="char"/>
		<char @l="1180" id="miho" pos="left" src="miho166"/>
		<char @l="1182" id="akina" pos="right" src="akina161"/>
		<bgm @l="1185" src="bgm06" volume="1."/>
		<msg @l="1187" char_id="2" frame_id="-1" name="亜季奈" text="『お姉ちゃん、おつかれー。』"
		   voices=""/>
		<char @l="1190" id="miho" pos="left" src="miho061"/>
		<msg @l="1192" char_id="0" frame_id="1" name="美帆" text="『おつかれさまー。』"
		   voices=""/>
		<msg @l="1194" char_id="-1" frame_id="-1" name=""
		   text="ハンドタオルでくしゃくしゃと髪の毛を乱暴に拭きながら、水着姿の亜季奈が更衣室に入ってくる。" voices=""/>
		<msg @l="1195" char_id="-1" frame_id="-1" name="" text="シャワーを浴びていたのだろう。"
		   voices=""/>
		<char @l="1198" id="akina" pos="right" src="akina061"/>
		<msg @l="1200" char_id="2" frame_id="-1" name="亜季奈"
		   text="『ここ、ちゃんとお湯が出ていいねぇ。』" voices=""/>
		<char @l="1203" id="akina" pos="right" src="akina067"/>
		<msg @l="1205" char_id="2" frame_id="-1" name="亜季奈"
		   text="『うちのシャワー室、ときどき水になって大変なの。』" voices=""/>
		<char @l="1208" id="miho" pos="left" src="miho060"/>
		<msg @l="1210" char_id="0" frame_id="1" name="美帆" text="『私もここのシャワー室は初めて。』"
		   voices=""/>
		<char @l="1213" id="miho" pos="left" src="miho161"/>
		<msg @l="1215" char_id="0" frame_id="1" name="美帆"
		   text="『広いし、ちゃんと個室になってるのがいいね。』" voices=""/>
		<char @l="1218" id="akina" pos="right" src="akina162"/>
		<msg @l="1220" char_id="2" frame_id="-1" name="亜季奈"
		   text="『私は別に見られて困るようなトコロなんて無いから、どっちでもいいけどねぇ～。』" voices=""/>
		<char @l="1223" id="miho" pos="left" src="miho066"/>
		<msg @l="1225" char_id="0" frame_id="1" name="美帆" text="『な、なによ‥‥その目は‥‥‥‥。』"
		   voices=""/>
		<char @l="1228" id="akina" pos="right" src="akina062"/>
		<msg @l="1230" char_id="2" frame_id="-1" name="亜季奈"
		   text="『いいえ～、私もいつかお姉ちゃんみたいなプルンプルンになるのかな～、と思っただけですよ～。』" voices=""/>
		<char @l="1233" id="miho" pos="left" src="miho164"/>
		<msg @l="1235" char_id="0" frame_id="1" name="美帆" text="『なっ‥‥なに言ってるのよ、もうっ。』"
		   voices=""/>
		<char @l="1238" id="akina" pos="right" src="akina162"/>
		<msg @l="1240" char_id="2" frame_id="-1" name="亜季奈" text="『事実でしょ～。』"
		   voices=""/>
		<char @l="1243" id="miho" pos="left" src="miho066"/>
		<msg @l="1245" char_id="0" frame_id="1" name="美帆" text="『亜季奈っ！』" voices=""/>
		<msg @l="1247" char_id="2" frame_id="-1" name="亜季奈" text="『えへへ～。』" voices=""/>
		<clear @l="1250" class="all"/>
		<label @l="1253" id="chart_line10"/>
		<wait_chgmv/>
		<ev @l="1256" src="ev-057"/>
		<msg @l="1258" char_id="0" frame_id="1" name="美帆"
		   text="『でも、ほんと残念よね‥‥プールの使用が水泳サークルの活動時間中だけだなんて。&#32;』" voices="miho03350"/>
		<msg @l="1260" char_id="0" frame_id="1" name="美帆"
		   text="『これじゃあ合宿に来た意味、ないと思う。』" voices="miho03360"/>
		<msg @l="1262" char_id="2" frame_id="-1" name="亜季奈"
		   text="『仕方ないよ、鍵の貸し出しは顧問の先生がやらないとダメらしいから。』" voices="akina00050"/>
		<msg @l="1264" char_id="2" frame_id="-1" name="亜季奈"
		   text="『それに、初日でみんな緊張してたみたいだから、このくらいで丁度よかったと思うよ？』" voices="akina00060"/>
		<msg @l="1266" char_id="0" frame_id="1" name="美帆" text="『それはそうだけど。』"
		   voices="miho03370"/>
		<msg @l="1268" char_id="0" frame_id="1" name="美帆"
		   text="『まったく‥‥みんなのガンバリをなんだと思ってるのかしら。』" voices="miho03380"/>
		<msg @l="1270" char_id="2" frame_id="-1" name="亜季奈" text="『お、珍しく燃えちゃってますな？』"
		   voices="akina00070"/>
		<msg @l="1272" char_id="0" frame_id="1" name="美帆" text="『茶化さないでよ、もう。』"
		   voices="miho03390"/>
		<msg @l="1274" char_id="2" frame_id="-1" name="亜季奈"
		   text="『あははっ‥‥それより、お腹すいたー。』" voices="akina00080"/>
		<msg @l="1276" char_id="2" frame_id="-1" name="亜季奈"
		   text="『今日の夜ゴハンはどうしよっかな。』" voices="akina00090"/>
		<msg @l="1278" char_id="0" frame_id="1" name="美帆"
		   text="『お腹すいてるなら食べればいいじゃない？』" voices="miho03400"/>
		<msg @l="1280" char_id="2" frame_id="-1" name="亜季奈"
		   text="『そうじゃなくて‥‥夜ゴハンに何を食べようかなってこと。』" voices="akina00100"/>
		<msg @l="1282" char_id="2" frame_id="-1" name="亜季奈"
		   text="『自分たちのゴハンは自分たちで用意しなくちゃいけないから。』" voices="akina00110"/>
		<msg @l="1284" char_id="0" frame_id="1" name="美帆"
		   text="『合宿っていうか、キャンプみたいね‥‥それ。』" voices="miho03410"/>
		<msg @l="1286" char_id="2" frame_id="-1" name="亜季奈" text="『まあ、似たようなものかな。』"
		   voices="akina00120"/>
		<msg @l="1288" char_id="2" frame_id="-1" name="亜季奈"
		   text="『宿舎の方にガスも電気も来てるらしいから、あんまりサバイバルなことはしなくても良さそうだけど。』"
		   voices="akina00130"/>
		<msg @l="1290" char_id="0" frame_id="1" name="美帆" text="『んー、それならウチに食べにくる？』"
		   voices="miho03420"/>
		<msg @l="1292" char_id="0" frame_id="1" name="美帆"
		   text="『ルームメイトの先輩も一緒だけど、たぶん良いって言うと思うし。』" voices="miho03430"/>
		<msg @l="1294" char_id="2" frame_id="-1" name="亜季奈"
		   text="『ゴメン、みんな宿舎で食べると思うし、私だけそういうことするのはやっぱ気が引けちゃうよ。』" voices="akina00140"/>
		<msg @l="1296" char_id="0" frame_id="1" name="美帆" text="『そっか‥‥うん、そうだね。』"
		   voices="miho03440"/>
		<msg @l="1298" char_id="2" frame_id="-1" name="亜季奈"
		   text="『誘ってくれてありがと、お姉ちゃん。』" voices="akina00150"/>
		<msg @l="1300" char_id="0" frame_id="1" name="美帆" text="『がんばりなさいね。』"
		   voices="miho03450"/>
		<msg @l="1302" char_id="2" frame_id="-1" name="亜季奈" text="『うん！』"
		   voices="akina00160"/>
		<stopbgm @l="1305" fadeout="1000"/>
		<clear @l="1308" class="all"/>
		<wait_chgmv/>
		<bg @l="1311" src="bg07b"/>
		<char @l="1313" id="miho" pos="left" src="miho010"/>
		<char @l="1316" id="akina" pos="right" src="akina010"/>
		<bgm @l="1319" src="bgm05" volume="1."/>
		<msg @l="1321" char_id="-1" frame_id="-1" name=""
		   text="電車の停留所と亜季奈たちの宿舎がある方との、分かれ道へと差し掛かる。" voices=""/>
		<msg @l="1322" char_id="-1" frame_id="-1" name=""
		   text="亜季奈の話によると、宿舎というのは大学の裏庭を抜けた先にある駐車場の脇に建っているのだそうだ。" voices=""/>
		<msg @l="1324" char_id="0" frame_id="1" name="美帆" text="『それじゃ、私はこっちだから。』"
		   voices=""/>
		<char @l="1327" id="akina" pos="right" src="akina011"/>
		<msg @l="1329" char_id="2" frame_id="-1" name="亜季奈" text="『うん。明日もヨロシクね。』"
		   voices=""/>
		<msg @l="1331" char_id="0" frame_id="1" name="美帆"
		   text="『顧問の先生が来たら、私の事、話しておいてよ。』" voices=""/>
		<char @l="1334" id="akina" pos="right" src="akina010"/>
		<msg @l="1336" char_id="2" frame_id="-1" name="亜季奈"
		   text="『大丈夫だって、顧問の先生には、ちゃんと話してあるから。』" voices=""/>
		<char @l="1339" id="akina" pos="right" src="akina012"/>
		<msg @l="1341" char_id="2" frame_id="-1" name="亜季奈"
		   text="『先生、お姉ちゃんのこと大歓迎だって言ってたよ？』" voices=""/>
		<char @l="1344" id="miho" pos="left" src="miho016"/>
		<msg @l="1346" char_id="0" frame_id="1" name="美帆" text="『それならいいけど‥‥。』"
		   voices=""/>
		<char @l="1349" id="akina" pos="right" src="akina111"/>
		<msg @l="1351" char_id="2" frame_id="-1" name="亜季奈" text="『お姉ちゃんは心配性なんだよ。』"
		   voices=""/>
		<char @l="1354" id="akina" pos="right" src="akina010"/>
		<msg @l="1356" char_id="2" frame_id="-1" name="亜季奈"
		   text="『もっと気楽に生きないと疲れちゃうよ？』" voices=""/>
		<msg @l="1358" char_id="0" frame_id="1" name="美帆" text="『亜季奈が気楽すぎなのよ‥‥。』"
		   voices=""/>
		<msg @l="1360" char_id="-1" frame_id="-1" name="水泳部の子Ａ"
		   text="『亜季奈、早くおいでよ～。』" voices=""/>
		<msg @l="1362" char_id="-1" frame_id="-1" name="水泳部の子Ｂ"
		   text="『早くこないとゴハン抜きだよー。』" voices=""/>
		<msg @l="1364" char_id="-1" frame_id="-1" name=""
		   text="道の先で水泳部の子たちが手を振っている。" voices=""/>
		<msg @l="1365" char_id="-1" frame_id="-1" name=""
		   text="亜季奈の友達なのだろう‥‥ここまで来るのを待っていたようだ。" voices=""/>
		<char @l="1368" id="akina" pos="right" src="akina114"/>
		<msg @l="1370" char_id="2" frame_id="-1" name="亜季奈"
		   text="『わ、なんか酷いこと言われてるし！』" voices=""/>
		<char @l="1373" id="miho" pos="left" src="miho011"/>
		<msg @l="1375" char_id="0" frame_id="1" name="美帆" text="『ほら、はやく行ってあげないと。』"
		   voices=""/>
		<char @l="1378" id="akina" pos="right" src="akina011"/>
		<msg @l="1380" char_id="2" frame_id="-1" name="亜季奈"
		   text="『あ、うん！&#32;じゃあねっ！』" voices=""/>
		<clear @l="1383" class="char"/>
		<char @l="1385" id="miho" pos="auto" src="miho010"/>
		<msg @l="1387" char_id="-1" frame_id="-1" name=""
		   text="亜季奈は慌てて水泳部の子たちの元へと駆け寄っていく。" voices=""/>
		<msg @l="1388" char_id="-1" frame_id="-1" name=""
		   text="あれだけ泳いだ後だというのに、よく走れるものだと思う。" voices=""/>
		<msg @l="1390" char_id="2" frame_id="-1" name="亜季奈" text="『ごめーん、お待たせー。』"
		   voices=""/>
		<msg @l="1392" char_id="-1" frame_id="-1" name="水泳部の子Ｃ" text="『亜季奈‥‥元気だね。』"
		   voices=""/>
		<msg @l="1394" char_id="2" frame_id="-1" name="亜季奈"
		   text="『でも、お腹ぺこぺこで倒れる寸前だったりして‥‥。』" voices=""/>
		<msg @l="1396" char_id="-1" frame_id="-1" name="水泳部の子Ｂ" text="『あ、それ私もー。』"
		   voices=""/>
		<char @l="1399" id="miho" pos="auto" src="miho011"/>
		<msg @l="1401" char_id="0" frame_id="1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="1403" char_id="0" frame_id="1" name="美帆" text="(ふふ‥‥なかなか楽しそうじゃない)"
		   voices=""/>
		<se @l="1406" buf="1" src="腹の音" volume="1."/>
		<char @l="1409" id="miho" pos="auto" src="miho016"/>
		<msg @l="1411" char_id="0" frame_id="1" name="美帆" text="『‥‥うあ。』" voices=""/>
		<char @l="1414" id="miho" pos="auto" src="miho011"/>
		<msg @l="1416" char_id="0" frame_id="1" name="美帆" text="『私も‥‥早く帰ってゴハンにしよ。』"
		   voices=""/>
		<stopbgm @l="1419" fadeout="1000"/>
		<clear @l="1422" class="all"/>
		<call @l="1425" target="EventLabel_60@root_akina02"/>
		<return @l="1426" value="0&#13;&#10;"/>
		<return @l="1429" value=""/>
	</code>
</xscript>
