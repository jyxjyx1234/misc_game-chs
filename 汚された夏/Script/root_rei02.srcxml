<?xml version="1.0" encoding="utf-8"?>
<xscript>
	<debug editor="&quot;C:\Program&#32;Files&#32;(x86)\sakura\sakura.exe&quot;&#32;&quot;%src%&quot;&#32;-Y=%line%"
	   src="D:\シロップ\町ぐるみの罠＋汚された夏セット版\汚された夏\完成データ\汚された夏\script\text\root_rei02.txt"/>
	<code>
		<label @l="12" id="EventLabel_131"/>
		<description @l="16" text="ルームメイトの憂鬱・２日目"/>
		<eval @l="18" expr="f.numDay=8&#13;&#10;"/>
		<msgshow @l="20" show="false"/>
		<wait_chgmv/>
		<bg @l="22" src="day08" time="2000"/>
		<wait @l="24" time="500"/>
		<wait_chgmv/>
		<bg @l="26" src="black" time="2000"/>
		<msgshow @l="28" show="true"/>
		<wait_chgmv/>
		<bg @l="32" src="bg03"/>
		<bgm @l="36" src="bgm04" volume="1."/>
		<char @l="40" id="miho" pos="auto" src="miho120"/>
		<msg @l="42" char_id="0" frame_id="-1" name="美帆" text="『それじゃあ、行ってきます。』"
		   voices=""/>
		<clear @l="45" class="char"/>
		<msg @l="47" char_id="-1" frame_id="-1" name=""
		   text="誰もいないリビングに一応声をかけて外に出ようとする。" voices=""/>
		<msg @l="48" char_id="-1" frame_id="-1" name=""
		   text="すると、ドアが開く音がして起きたばかりの玲さんが入ってきた。" voices=""/>
		<msg @l="50" char_id="-1" frame_id="-1" name="" text="ガチャ" voices=""/>
		<char @l="53" id="rei" pos="center" src="rei185f" y="-80"/>
		<bgm @l="55" src="bgm06" volume="1."/>
		<msg @l="57" char_id="1" frame_id="-1" name="玲" text="『････おはよー････。』"
		   voices=""/>
		<msg @l="59" char_id="0" frame_id="-1" name="美帆" text="『････････････････』"
		   voices=""/>
		<msg @l="61" char_id="1" frame_id="-1" name="玲" text="『････････････････ん？』"
		   voices=""/>
		<msg @l="63" char_id="0" frame_id="-1" name="美帆" text="『なっ！』" voices=""/>
		<clear @l="66" class="char"/>
		<char @l="68" id="miho" pos="left" src="miho124"/>
		<char @l="71" id="rei" pos="right" src="rei185"/>
		<msg @l="75" char_id="0" frame_id="-1" name="美帆"
		   text="『れ、玲さん！？どうしたんですか、そんな格好をして！』" voices=""/>
		<msg @l="77" char_id="1" frame_id="-1" name="玲" text="『え‥‥何のこと？』" voices=""/>
		<msg @l="79" char_id="-1" frame_id="-1" name="" text="玲さんは、寝惚けまなこのまま答える。"
		   voices=""/>
		<char @l="82" id="miho" pos="left" src="miho024"/>
		<msg @l="84" char_id="0" frame_id="-1" name="美帆"
		   text="『その姿のことですよ！とにかく早く着替えてください！！』" voices=""/>
		<msg @l="86" char_id="1" frame_id="-1" name="玲"
		   text="『んー？･･下着姿の事？いいじゃない女同士なんだし･･。』" voices=""/>
		<char @l="89" id="miho" pos="left" src="miho026"/>
		<msg @l="91" char_id="0" frame_id="-1" name="美帆"
		   text="『あの、その、女同士とかそういう問題じゃないですよ！誰かに見られたらどうするんですか！？』" voices=""/>
		<char @l="94" id="rei" pos="right" src="rei188"/>
		<msg @l="96" char_id="1" frame_id="-1" name="玲"
		   text="『誰も見てないわよー、見ているのは美帆ちゃんだけよー。』" voices=""/>
		<clear @l="99" class="char"/>
		<char @l="101" id="rei" pos="center" src="rei181f" y="-80"/>
		<msg @l="103" char_id="1" frame_id="-1" name="玲" text="『美帆ちゃんなら触ってもいいわよー。』"
		   voices=""/>
		<clear @l="106" class="char"/>
		<char @l="109" id="miho" pos="left" src="miho123"/>
		<msg @l="111" char_id="0" frame_id="-1" name="美帆"
		   text="『あわわっ！勝手に人の手を胸に押し付けないで下さい！！玲さん、寝ぼけすぎです！？』" voices=""/>
		<char @l="114" id="rei" pos="right" src="rei181"/>
		<msg @l="116" char_id="1" frame_id="-1" name="玲" text="『結構大きいでしょう？』"
		   voices=""/>
		<char @l="119" id="miho" pos="left" src="miho026"/>
		<msg @l="121" char_id="0" frame_id="-1" name="美帆" text="『は、早く部屋に行きましょう！』"
		   voices=""/>
		<msg @l="123" char_id="-1" frame_id="-1" name=""
		   text="私は玲さんの手を取って、彼女を部屋に連れて行った。" voices=""/>
		<char @l="126" id="rei" pos="right" src="rei184"/>
		<msg @l="128" char_id="1" frame_id="-1" name="玲" text="『きゃっ！』" voices=""/>
		<clear @l="131" class="char"/>
		<clear @l="137" class="all"/>
		<msgshow @l="139" show="true"/>
		<wait_chgmv/>
		<bg @l="144" src="bg02"/>
		<char @l="147" id="miho" pos="center" src="miho026f" y="-80"/>
		<msg @l="150" char_id="0" frame_id="-1" name="美帆"
		   text="『と・に・か・く・着替えてきてくださいね！私はリビングにいますから。』" voices=""/>
		<clear @l="153" class="char"/>
		<char @l="155" id="rei" pos="auto" src="rei188"/>
		<msg @l="157" char_id="1" frame_id="-1" name="玲" text="『わかったわよぉー、ぶぅぶぅ。』"
		   voices=""/>
		<msg @l="159" char_id="-1" frame_id="-1" name="" text="まだ、玲さんは寝ぼけているみたいだった。"
		   voices=""/>
		<msg @l="160" char_id="-1" frame_id="-1" name=""
		   text="彼女のこんな子供っぽい一面が見れるなんて意外だった。" voices=""/>
		<clear @l="163" class="char"/>
		<stopbgm @l="166" fadeout="1000"/>
		<clear @l="172" class="all"/>
		<msgshow @l="174" show="true"/>
		<bgm @l="178" src="bgm05" volume="1."/>
		<wait_chgmv/>
		<bg @l="182" src="bg03"/>
		<char @l="185" id="miho" pos="auto" src="miho126"/>
		<msg @l="187" char_id="0" frame_id="-1" name="美帆"
		   text="『ふぅ････。玲さんたらビックリさせるんだから。』" voices=""/>
		<char @l="190" id="miho" pos="auto" src="miho023"/>
		<msg @l="192" char_id="0" frame_id="1" name="美帆"
		   text="（でも、玲さんのスタイル凄く良かったな････）" voices=""/>
		<char @l="195" id="miho" pos="auto" src="miho120"/>
		<msg @l="197" char_id="-1" frame_id="-1" name=""
		   text="私は自分の姿と先程見た、玲さんの姿とを比べる････" voices=""/>
		<char @l="200" id="miho" pos="auto" src="miho125"/>
		<msg @l="202" char_id="0" frame_id="1" name="美帆"
		   text="（うぅ････ダイエットしようかな････）" voices=""/>
		<bgm @l="206" src="bgm04" volume="1."/>
		<clear @l="208" class="char"/>
		<char @l="210" id="rei" pos="auto" src="rei030"/>
		<msg @l="212" char_id="1" frame_id="-1" name="玲" text="『着替えたわよ････。』"
		   voices=""/>
		<msg @l="214" char_id="-1" frame_id="-1" name=""
		   text="リビングに戻ってきた玲さんはいつものキャミソールに着替えていた。" voices=""/>
		<clear @l="217" class="char"/>
		<char @l="219" id="miho" pos="left" src="miho126"/>
		<char @l="221" id="rei" pos="right" src="rei030"/>
		<msg @l="223" char_id="0" frame_id="1" name="美帆"
		   text="『で、どうしてあんな格好をしていたんですか？』" voices=""/>
		<msg @l="225" char_id="1" frame_id="-1" name="玲"
		   text="『昨日お風呂から出た後、明け方までずっと本を読んでいたのよ････。』" voices=""/>
		<char @l="228" id="miho" pos="left" src="miho024"/>
		<msg @l="230" char_id="0" frame_id="1" name="美帆"
		   text="『お風呂上りからって･･だから、下着姿だったんですか？』" voices=""/>
		<char @l="233" id="rei" pos="right" src="rei031"/>
		<msg @l="235" char_id="1" frame_id="-1" name="玲"
		   text="『そうよ、その方が涼しくて気持ち良いでしょう。自分の部屋なら誰に見られるわけでもないし。』" voices=""/>
		<char @l="238" id="miho" pos="left" src="miho026"/>
		<msg @l="240" char_id="0" frame_id="1" name="美帆"
		   text="『自分の部屋であればいいんですけどね････。』" voices=""/>
		<char @l="243" id="rei" pos="right" src="rei033"/>
		<msg @l="245" char_id="1" frame_id="-1" name="玲"
		   text="『わかったわよ、これからは気をつけるわ。』" voices=""/>
		<char @l="249" id="miho" pos="left" src="miho020"/>
		<msg @l="251" char_id="0" frame_id="1" name="美帆"
		   text="『それで、何で明け方まで本を読んでいたんですか？』" voices=""/>
		<msg @l="253" char_id="-1" frame_id="-1" name=""
		   text="確か玲さんは余り本を読まないと言っていた。" voices=""/>
		<char @l="256" id="rei" pos="right" src="rei030"/>
		<msg @l="258" char_id="1" frame_id="-1" name="玲"
		   text="『‥‥自分でも柄じゃないとは思ったんだけど。』" voices=""/>
		<char @l="261" id="miho" pos="left" src="miho024"/>
		<msg @l="263" char_id="0" frame_id="1" name="美帆" text="『どうかしたんですか？』"
		   voices=""/>
		<char @l="266" id="rei" pos="right" src="rei033"/>
		<msg @l="268" char_id="1" frame_id="-1" name="玲" text="『その、笑わないで聞いてくれる？』"
		   voices=""/>
		<char @l="271" id="miho" pos="left" src="miho026"/>
		<msg @l="273" char_id="0" frame_id="1" name="美帆" text="『笑ったりしませんよ。』"
		   voices=""/>
		<char @l="276" id="rei" pos="right" src="rei031"/>
		<msg @l="278" char_id="1" frame_id="-1" name="玲" text="『面接の参考書を読んでいたの。』"
		   voices=""/>
		<char @l="281" id="miho" pos="left" src="miho024"/>
		<msg @l="283" char_id="0" frame_id="1" name="美帆"
		   text="『あ、そっか‥‥今日は面接の日でしたよね。』" voices=""/>
		<char @l="286" id="rei" pos="right" src="rei030"/>
		<msg @l="288" char_id="1" frame_id="-1" name="玲"
		   text="『そうなの。１１時に駅前にある大黒建設のビルであるのよ。』" voices=""/>
		<char @l="292" id="miho" pos="left" src="miho020"/>
		<msg @l="294" char_id="0" frame_id="1" name="美帆"
		   text="『大黒建設のビルって、駅前にあるんですね。』" voices=""/>
		<msg @l="296" char_id="1" frame_id="-1" name="玲"
		   text="『そうね･･････。でも、別に会社がどこにあってもいいのよ。』" voices=""/>
		<stopbgm @l="299" fadeout="1000"/>
		<char @l="301" id="miho" pos="left" src="miho024"/>
		<msg @l="303" char_id="0" frame_id="1" name="美帆" text="『え、そうなんですか？』"
		   voices=""/>
		<char @l="306" id="rei" pos="right" src="rei033"/>
		<msg @l="308" char_id="1" frame_id="-1" name="玲"
		   text="『･･････どうしても、大黒建設に入りたいの･･････。』" voices=""/>
		<char @l="311" id="miho" pos="left" src="miho126"/>
		<msg @l="313" char_id="0" frame_id="1" name="美帆"
		   text="『･･････何か、大黒建設に特別な思い入れがあるんですか？』" voices=""/>
		<char @l="316" id="rei" pos="right" src="rei030"/>
		<msg @l="318" char_id="1" frame_id="-1" name="玲"
		   text="『建築業に携わりたいというのもあるけど、それよりも･･････。』" voices=""/>
		<char @l="321" id="miho" pos="left" src="miho024"/>
		<msg @l="323" char_id="0" frame_id="1" name="美帆" text="『？』" voices=""/>
		<bgm @l="326" src="bgm07" volume="1."/>
		<msg @l="328" char_id="1" frame_id="-1" name="玲"
		   text="『･･････実は、稲庭さんが大黒建設に内定をもらっていて、入社することが決まっているのよ。』" voices=""/>
		<char @l="331" id="rei" pos="right" src="rei033"/>
		<msg @l="333" char_id="1" frame_id="-1" name="玲"
		   text="『私はどうしても稲庭さんと一緒の会社に行きたいの･･････。』" voices=""/>
		<char @l="336" id="miho" pos="left" src="miho120"/>
		<stopbgm @l="339" fadeout="1000"/>
		<msg @l="341" char_id="0" frame_id="1" name="美帆" text="『あ･･････』" voices=""/>
		<msg @l="343" char_id="0" frame_id="1" name="美帆"
		   text="（だから、徹夜するまで頑張っていたんだ････）" voices=""/>
		<char @l="347" id="rei" pos="right" src="rei031"/>
		<bgm @l="350" src="bgm04" volume="1."/>
		<msg @l="352" char_id="1" frame_id="-1" name="玲"
		   text="『ふふっ、女性っていうのは好きな人といつも一緒にいたいものよ。』" voices=""/>
		<char @l="356" id="miho" pos="left" src="miho026"/>
		<msg @l="358" char_id="0" frame_id="1" name="美帆"
		   text="『ん～、私にはちょっとまね出来ないかも‥‥。』" voices=""/>
		<char @l="361" id="rei" pos="right" src="rei030"/>
		<msg @l="363" char_id="1" frame_id="-1" name="玲"
		   text="『今は出来なくても、好きな人が出来ると自然にそうなるわよ。』" voices=""/>
		<char @l="367" id="rei" pos="right" src="rei031"/>
		<msg @l="369" char_id="1" frame_id="-1" name="玲"
		   text="『愛があれば、なんでも出来るし、頑張れるようになるわ。』" voices=""/>
		<msg @l="371" char_id="-1" frame_id="-1" name="" text="そういって玲さんは優しく笑った。"
		   voices=""/>
		<msg @l="373" char_id="0" frame_id="1" name="美帆" text="『‥‥べ、勉強になります。』"
		   voices=""/>
		<char @l="377" id="miho" pos="left" src="miho020"/>
		<char @l="379" id="rei" pos="right" src="rei030"/>
		<msg @l="381" char_id="0" frame_id="1" name="美帆"
		   text="『でも、それじゃあ余計に気合入りますよね。』" voices=""/>
		<char @l="385" id="rei" pos="right" src="rei031"/>
		<msg @l="387" char_id="1" frame_id="-1" name="玲"
		   text="『人生をかけた大本命だもの、絶対に内定もらうわ。』" voices=""/>
		<char @l="392" id="miho" pos="left" src="miho121"/>
		<msg @l="394" char_id="0" frame_id="1" name="美帆" text="『頑張ってくださいね！応援しています。』"
		   voices=""/>
		<msg @l="396" char_id="1" frame_id="-1" name="玲" text="『ありがと。』" voices=""/>
		<msg @l="398" char_id="0" frame_id="1" name="美帆" text="『それじゃあ私は大学に行きますね。』"
		   voices=""/>
		<msg @l="400" char_id="1" frame_id="-1" name="玲" text="『ええ、気をつけてね。』"
		   voices=""/>
		<stopbgm @l="403" fadeout="1000"/>
		<clear @l="405" class="char"/>
		<char @l="407" id="rei" pos="center" src="rei030f" y="-80"/>
		<msg @l="409" char_id="1" frame_id="-1" name="玲"
		   text="『さぁ、遅れないように用意しないと････。』" voices=""/>
		<se @l="413" buf="1" src="発信音" volume="1."/>
		<msg @l="414" char_id="-1" frame_id="-1" name=""
		   text="プルルルル、プルルルル、プルルルル、プルルルル" voices=""/>
		<char @l="417" id="rei" pos="center" src="rei034f" y="-80"/>
		<msg @l="419" char_id="1" frame_id="-1" name="玲" text="『あら、電話？』" voices=""/>
		<msg @l="420" char_id="1" frame_id="-1" name="玲"
		   text="『こんな朝早くにかかってくるなんて、誰かしら』" voices=""/>
		<stopse @l="424" buf="1"/>
		<msg @l="427" char_id="-1" frame_id="-1" name="" text="カチャ" voices=""/>
		<char @l="430" id="rei" pos="center" src="rei030f" y="-80"/>
		<msg @l="432" char_id="1" frame_id="-1" name="玲" text="『はい、もしもし』" voices=""/>
		<bgm @l="435" src="bgm14" volume="1."/>
		<msg @l="437" char_id="-1" frame_id="-1" name="女の人"
		   text="『私、大黒建設採用担当の、小倉と申しますが。』" voices=""/>
		<char @l="440" id="rei" pos="center" src="rei034f" y="-80"/>
		<msg @l="442" char_id="1" frame_id="-1" name="玲" text="『あっ、はい！私、白石です』"
		   voices=""/>
		<msg @l="444" char_id="-1" frame_id="-1" name="女の人"
		   text="『白石様ですね。本日予定しおります面接の件ですが、都合により時間を１１時から、１４時に変更をお願いしたいのですが。』"
		   voices=""/>
		<msg @l="446" char_id="1" frame_id="-1" name="玲" text="『変更････ですか？』"
		   voices=""/>
		<msg @l="448" char_id="-1" frame_id="-1" name="女の人"
		   text="『ええ。もし不都合でしたら、ご辞退されても宜しいですけど。』" voices=""/>
		<msg @l="450" char_id="1" frame_id="-1" name="玲"
		   text="『い、いえ！時間変更していただいても大丈夫です！！』" voices=""/>
		<char @l="453" id="rei" pos="center" src="rei031f" y="-80"/>
		<msg @l="455" char_id="1" frame_id="-1" name="玲"
		   text="『１４時に伺いますので、宜しくお願いいたします。』" voices=""/>
		<msg @l="457" char_id="-1" frame_id="-1" name="女の人"
		   text="『では、１４時にお待ちしておりますので。』" voices=""/>
		<stopbgm @l="460" fadeout="1000"/>
		<msg @l="463" char_id="-1" frame_id="-1" name="" text="プーッ、プーッ、プーッ"
		   voices=""/>
		<char @l="466" id="rei" pos="center" src="rei034f" y="-80"/>
		<msg @l="468" char_id="1" frame_id="-1" name="玲" text="『ふぅ･･････。』"
		   voices=""/>
		<char @l="471" id="rei" pos="center" src="rei030f" y="-80"/>
		<msg @l="473" char_id="1" frame_id="-1" name="玲"
		   text="『･･････変更････。こんな急に･･何故かしら･･････････。』" voices=""/>
		<stopbgm @l="477" fadeout="1000"/>
		<clear @l="479" class="char"/>
		<clear @l="485" class="all"/>
		<msgshow @l="487" show="true"/>
		<wait_chgmv/>
		<bg @l="491" src="bg05"/>
		<bgm @l="495" src="bgm04" volume="1."/>
		<char @l="499" id="miho" pos="auto" src="miho120"/>
		<msg @l="501" char_id="0" frame_id="1" name="美帆"
		   text="『玲さん、稲庭先輩が好きなんだ･･････。』" voices=""/>
		<char @l="504" id="miho" pos="auto" src="miho126"/>
		<msg @l="506" char_id="0" frame_id="1" name="美帆"
		   text="(美男美女って感じでお似合いだな。何でまだ付き合っていないのかな？)" voices=""/>
		<char @l="509" id="miho" pos="auto" src="miho026"/>
		<msg @l="511" char_id="0" frame_id="1" name="美帆"
		   text="『なんて、人の心配している場合じゃないよね。』" voices=""/>
		<char @l="514" id="miho" pos="auto" src="miho120"/>
		<msg @l="516" char_id="0" frame_id="1" name="美帆" text="『･･････。』" voices=""/>
		<char @l="519" id="miho" pos="auto" src="miho121"/>
		<msg @l="521" char_id="0" frame_id="1" name="美帆" text="『････私も彼氏が欲しいぞ、っと！』"
		   voices=""/>
		<msg @l="523" char_id="-1" frame_id="-1" name=""
		   text="澄み渡る青空を見上げながら、思わず叫んでしまった。" voices=""/>
		<stopbgm @l="528" fadeout="1000"/>
		<clear @l="534" class="all"/>
		<msgshow @l="536" show="true"/>
		<wait_chgmv/>
		<bg @l="540" src="bg18"/>
		<bgm @l="544" src="bgm02" volume="1."/>
		<char @l="548" id="rei" pos="auto" src="rei110"/>
		<msg @l="550" char_id="-1" frame_id="-1" name="" text="１３時４０分を少し回った頃。"
		   voices=""/>
		<msg @l="551" char_id="-1" frame_id="-1" name=""
		   text="玲は大黒建設のビルに向かって駅前の歩道を歩いていた。" voices=""/>
		<char @l="554" id="rei" pos="auto" src="rei125"/>
		<msg @l="556" char_id="1" frame_id="-1" name="玲" text="『‥‥さすがにちょっと緊張するわね。』"
		   voices=""/>
		<msg @l="558" char_id="-1" frame_id="-1" name=""
		   text="苦笑を浮かべながら、玲は大黒建設のビルがあるオフィス街へと足をはやめる。" voices=""/>
		<clear @l="564" class="all"/>
		<wait_chgmv/>
		<bg @l="568" src="bg16"/>
		<char @l="572" id="rei" pos="auto" src="rei113"/>
		<msg @l="574" char_id="1" frame_id="-1" name="玲" text="『‥‥ここね。』" voices=""/>
		<msg @l="576" char_id="-1" frame_id="-1" name=""
		   text="大黒建設のビルの前で、玲が高鳴る鼓動を抑えるように小さく呟く。" voices=""/>
		<msg @l="578" char_id="1" frame_id="-1" name="玲"
		   text="『１３時５０分‥‥面接が始まる１０分前か。』" voices=""/>
		<stopbgm @l="581" fadeout="1000"/>
		<msg @l="583" char_id="-1" frame_id="-1" name="稲庭" text="『あれ、玲じゃないか？』"
		   voices=""/>
		<char @l="586" id="rei" pos="auto" src="rei114"/>
		<msg @l="588" char_id="1" frame_id="-1" name="玲" text="『え！？』" voices=""/>
		<clear @l="591" class="char"/>
		<char @l="593" id="rei" pos="left" src="rei024"/>
		<char @l="595" id="inaba" pos="right" src="inaba010"/>
		<msg @l="597" char_id="1" frame_id="-1" name="玲" text="『稲庭さん！どうしたのこんな所で。』"
		   voices=""/>
		<msg @l="599" char_id="-1" frame_id="-1" name="稲庭"
		   text="『今日ここで内定者の研修があるので呼ばれたんだよ。』" voices=""/>
		<bgm @l="602" src="bgm05" volume="1."/>
		<msg @l="604" char_id="-1" frame_id="-1" name="稲庭" text="『それより、玲はなぜここに？』"
		   voices=""/>
		<char @l="607" id="rei" pos="left" src="rei021"/>
		<msg @l="609" char_id="1" frame_id="-1" name="玲" text="『私は面接なのよ。』" voices=""/>
		<msg @l="611" char_id="-1" frame_id="-1" name="稲庭"
		   text="『そうなのか。じゃあ頑張ってくれよ。君が内定を貰えれば卒業後も一緒にいられるからね。』" voices=""/>
		<msg @l="613" char_id="-1" frame_id="-1" name=""
		   text="稲庭は世の女性全てを、虜にするような爽やかな笑顔をしながら言う。" voices=""/>
		<char @l="616" id="rei" pos="left" src="rei013"/>
		<msg @l="618" char_id="1" frame_id="-1" name="玲" text="『え･･ええ！そうね！』"
		   voices=""/>
		<msg @l="620" char_id="-1" frame_id="-1" name="" text="稲庭の笑顔に頬を赤めて嬉しそうに頷く。"
		   voices=""/>
		<char @l="623" id="rei" pos="left" src="rei111"/>
		<msg @l="625" char_id="1" frame_id="-1" name="玲" text="『じゃぁ、行ってくるわね。』"
		   voices=""/>
		<msg @l="627" char_id="-1" frame_id="-1" name=""
		   text="玲は稲庭と別れ軽い足取りで面接会場へと向かった。" voices=""/>
		<stopbgm @l="631" fadeout="1000"/>
		<clear @l="637" class="all"/>
		<msgshow @l="639" show="true"/>
		<se @l="643" buf="1" src="自動ドアの音" volume="1."/>
		<msg @l="645" char_id="1" frame_id="-1" name="玲"
		   text="『あの、私、本日１４時より面接を受けさせて頂く予定の白石と申しますが。』" voices=""/>
		<msg @l="647" char_id="-1" frame_id="-1" name="受付嬢" text="『面接ですか････？』"
		   voices=""/>
		<msg @l="648" char_id="-1" frame_id="-1" name="受付嬢"
		   text="『本日の面接は１１時から以外は予定にないのですが････････。』" voices=""/>
		<msg @l="650" char_id="1" frame_id="-1" name="玲"
		   text="『え？で、でも本日の朝、面接の時間を変更したいと、御社より連絡を頂いたのですけど････。』" voices=""/>
		<msg @l="652" char_id="-1" frame_id="-1" name="受付嬢" text="『時間変更のご連絡ですか？』"
		   voices=""/>
		<msg @l="654" char_id="-1" frame_id="-1" name=""
		   text="受付嬢は、手元の来客予定表を見て確認をしている。" voices=""/>
		<msg @l="656" char_id="-1" frame_id="-1" name="受付嬢"
		   text="『ああ、朝電話させて頂いた方ですね。』" voices=""/>
		<msg @l="658" char_id="-1" frame_id="-1" name="受付嬢"
		   text="『人事に連絡しますので少々お待ちください。』" voices=""/>
		<msg @l="660" char_id="1" frame_id="-1" name="玲" text="『あ、はい。』" voices=""/>
		<msg @l="662" char_id="-1" frame_id="-1" name="" text="受付嬢が受話器を取る。"
		   voices=""/>
		<msg @l="664" char_id="-1" frame_id="-1" name="受付嬢"
		   text="『個人面接の方がいらっしゃいましたが。』" voices=""/>
		<msg @l="666" char_id="-1" frame_id="-1" name="受付嬢" text="『はい････はい････。』"
		   voices=""/>
		<msg @l="668" char_id="1" frame_id="1" name="玲" text="（････？個人面接････････？）"
		   voices=""/>
		<msg @l="669" char_id="-1" frame_id="1" name=""
		   text="（まだ一次面接なのに個人面接なの････？）" voices=""/>
		<msg @l="670" char_id="-1" frame_id="1" name=""
		   text="（この会社は、最終面接以外は集団面接じゃなかったかしら････）" voices=""/>
		<msg @l="671" char_id="-1" frame_id="-1" name="受付嬢"
		   text="『かしこまりました‥‥では、お連れ致します。』" voices=""/>
		<msg @l="673" char_id="-1" frame_id="-1" name=""
		   text="受付嬢は受話器を置くと、にっこりと微笑みながら言った。" voices=""/>
		<msg @l="675" char_id="-1" frame_id="-1" name="受付嬢"
		   text="『お待たせいたしました。これより応接室の方へご案内いたします。』" voices=""/>
		<msg @l="677" char_id="1" frame_id="1" name="玲" text="『はい！宜しくお願い致します。』"
		   voices=""/>
		<msg @l="679" char_id="1" frame_id="1" name="玲"
		   text="（････もしかしたら、期待されているのかも････）" voices=""/>
		<msg @l="681" char_id="1" frame_id="1" name="玲" text="（アピールするチャンスだわ！）"
		   voices=""/>
		<msg @l="683" char_id="1" frame_id="1" name="玲"
		   text="（････稲庭さんと同じ会社に入る為にも、絶対内定をもらわないと！）" voices=""/>
		<clear @l="689" class="all"/>
		<msgshow @l="691" show="true"/>
		<bgm @l="693" src="bgm21" volume="1."/>
		<wait_chgmv/>
		<bg @l="697" src="bg17m1"/>
		<msg @l="699" char_id="-1" frame_id="-1" name="受付嬢"
		   text="『突き当たりが、応接室になっております。』" voices=""/>
		<char @l="703" id="rei" pos="auto" src="rei011"/>
		<msg @l="705" char_id="1" frame_id="1" name="玲" text="『はい、ありがとうございます。』"
		   voices=""/>
		<msg @l="707" char_id="-1" frame_id="-1" name=""
		   text="受付嬢は会釈をすると、受付に戻っていった。" voices=""/>
		<char @l="710" id="rei" pos="auto" src="rei123"/>
		<msg @l="712" char_id="1" frame_id="1" name="玲" text="『‥‥突き当りが応接室だったわよね。』"
		   voices=""/>
		<msg @l="714" char_id="-1" frame_id="-1" name=""
		   text="緊張をほぐすように息を吐いて、応接室へ向かう。" voices=""/>
		<clear @l="718" class="char"/>
		<msg @l="720" char_id="-1" frame_id="-1" name=""
		   text="そうして歩いていく玲を‥‥オフィスの一角から、恰幅のよい男が見つめていた。" voices=""/>
		<stopbgm @l="724" fadeout="1000"/>
		<msg @l="726" char_id="-1" frame_id="-1" name="？？？" text="『‥‥‥‥。』" voices=""/>
		<msg @l="728" char_id="-1" frame_id="-1" name=""
		   text="その視線は、長い間待ち焦がれていた獲物を狙う欲望の視線だった。" voices=""/>
		<msg @l="729" char_id="-1" frame_id="-1" name=""
		   text="しかし、注がれていた玲は、全く気付かずに応接室に消えていく。欲望に目をギラつかせた男は、玲が応接室に入るとニヤリと笑い、自分も応接室へと足を向けるのだった。"
		   voices=""/>
		<clear @l="737" class="all"/>
		<label @l="740" id="event_scene06"/>
		<msgshow @l="743" show="true"/>
		<bgm @l="747" src="bgm03" volume="1."/>
		<label @l="751" id="chart_line7"/>
		<wait_chgmv/>
		<ev @l="755" src="ev-006a"/>
		<description @l="758" text="一次面接Ａ"/>
		<msg @l="760" char_id="-1" frame_id="-1" name=""
		   text="高級そうなスーツを着た二人の男が応接室へと入ってくる。男達は観察するかのように、しばらくの間玲をじろじろと見ていて、一言も発しようとしない。"
		   voices=""/>
		<msg @l="761" char_id="-1" frame_id="-1" name=""
		   text="そして長い沈黙の後、やっと最初の質問が始まる。" voices=""/>
		<msg @l="763" char_id="-1" frame_id="-1" name="面接官"
		   text="『では、先ず自己紹介からお願いしましょうか。』" voices=""/>
		<msg @l="765" char_id="1" frame_id="1" name="玲" text="『あ、はい。』"
		   voices="rei00760"/>
		<msg @l="767" char_id="1" frame_id="1" name="玲" text="『白石玲、現在大学４年生です。』"
		   voices="rei00770"/>
		<msg @l="769" char_id="-1" frame_id="-1" name="面接官"
		   text="『そうなると玲さんは来年の三月卒業ですよね？』" voices=""/>
		<msg @l="771" char_id="1" frame_id="1" name="玲" text="『そうです。』"
		   voices="rei00780"/>
		<msg @l="773" char_id="-1" frame_id="-1" name="面接官"
		   text="『では、弊社の新卒の女性採用に関してはご存知ですよね』" voices=""/>
		<msg @l="775" char_id="1" frame_id="1" name="玲" text="『あ、はい。』"
		   voices="rei00760"/>
		<msg @l="777" char_id="-1" frame_id="-1" name="面接官"
		   text="『なら話が早い。我が社では、女性社員は長い期間働ける方しか採用していないのですよ。』" voices=""/>
		<msg @l="779" char_id="-1" frame_id="-1" name="面接官"
		   text="『女性の方は、色々と問題が出ますからね。』" voices=""/>
		<msg @l="781" char_id="1" frame_id="1" name="玲" text="『問題‥‥ですか。』"
		   voices="rei00810"/>
		<msg @l="783" char_id="-1" frame_id="-1" name="面接官"
		   text="『そうです‥‥先ず第一に結婚して退社される方が非常に多い。』" voices=""/>
		<msg @l="785" char_id="-1" frame_id="-1" name="面接官"
		   text="『ノウハウを覚えこれから戦力に、と思った時にいなくなられてしまうと非常に困るのです。』" voices=""/>
		<msg @l="787" char_id="1" frame_id="1" name="玲" text="『なるほど‥‥。』"
		   voices="rei00820"/>
		<msg @l="789" char_id="-1" frame_id="-1" name="面接官"
		   text="『第二に、残業等を拒否したり現場に行くのも嫌う女性が多い。』" voices=""/>
		<msg @l="791" char_id="-1" frame_id="-1" name="面接官"
		   text="『まぁ、寿退社は仕方がないとしても、会社の仕事を拒否されては困るのですよ。』" voices=""/>
		<msg @l="793" char_id="1" frame_id="1" name="玲" text="『‥‥‥‥。』"
		   voices="rei00830"/>
		<msg @l="795" char_id="1" frame_id="1" name="玲"
		   text="『つまり、そうした問題を避けるために女性社員の雇用数を減らしているということですか？』" voices="rei00840"/>
		<msg @l="797" char_id="-1" frame_id="-1" name="面接官"
		   text="『そうです。それ以外にも不況のあおりを受けて、全体的に採用者の厳選もしています。』" voices=""/>
		<msg @l="798" char_id="-1" frame_id="-1" name="面接官"
		   text="『実際、我が社に採用試験を受けに来る女性の方は、今年も２０００名以上いらっしゃいますが、その中で採用させていただくのは僅か１名なのです』"
		   voices=""/>
		<msg @l="800" char_id="1" frame_id="1" name="玲"
		   text="『そうですか‥‥理解はできますけど、厳しいんですね。』" voices="rei00850"/>
		<msg @l="802" char_id="-1" frame_id="-1" name="面接官"
		   text="『ええ。我が社としても、入社していただく方には会社の将来を担ってほしいので、採用には気を遣っているのですよ。』" voices=""/>
		<msg @l="804" char_id="-1" frame_id="-1" name=""
		   text="そうしてかっぷくのいい面接官はおおげさに笑う。" voices=""/>
		<msg @l="805" char_id="-1" frame_id="-1" name=""
		   text="面接官が笑うと、ふかふかのソファでさえもギシギシと嫌な音を立てて軋んだ。" voices=""/>
		<msg @l="807" char_id="1" frame_id="1" name="玲"
		   text="『私は、例え結婚をしても退社をするつもりはありません。』" voices="rei00860"/>
		<msg @l="809" char_id="1" frame_id="1" name="玲"
		   text="『結婚自体も‥‥今は視野に入れてはいません。』" voices="rei00870"/>
		<msg @l="811" char_id="-1" frame_id="-1" name="面接官" text="『なるほど。』" voices=""/>
		<msg @l="813" char_id="-1" frame_id="-1" name=""
		   text="その瞬間、面接官は目の奥底に欲望の炎を灯しニヤリと笑う。" voices=""/>
		<bgm @l="816" src="bgm09" volume="1."/>
		<msg @l="818" char_id="-1" frame_id="-1" name="面接官"
		   text="『ですが‥‥女性というのは何かと心変わりが多いですからね。』" voices=""/>
		<msg @l="820" char_id="1" frame_id="1" name="玲" text="『はあ‥‥。』"
		   voices="rei00880"/>
		<msg @l="822" char_id="-1" frame_id="-1" name="面接官"
		   text="『しかしご心配なさらないで下さい。白石さんの熱意は筆記試験のレポートで拝見させて頂きました。』" voices=""/>
		<msg @l="824" char_id="-1" frame_id="-1" name="面接官"
		   text="『レポートから他の受験者にはない熱意を感じましたので、本日は白石さんだけ特別に個人面接にしたのです。』" voices=""/>
		<msg @l="826" char_id="-1" frame_id="-1" name="面接官"
		   text="『ただ、熱意だけでは我が社への適性が計れませんので、もし、どうしても我が社で働きたいとお思いでしたら、特別な採用試験を行っても良いのですが、如何致しますか？』"
		   voices=""/>
		<msg @l="828" char_id="1" frame_id="1" name="玲"
		   text="『はい、試験があるのでしたらぜひ受けさせてください。』" voices="rei00890"/>
		<msg @l="830" char_id="-1" frame_id="-1" name="面接官"
		   text="『分かりました。但し、この特別試験は、長期間働くことが出来るかどうか、会社の言う事に柔軟に対応出来るかどうか、を調べるものですので大変厳しいものになりますよ。』"
		   voices=""/>
		<msg @l="832" char_id="-1" frame_id="-1" name="面接官" text="『それでも、受けられますか？』"
		   voices=""/>
		<msg @l="834" char_id="1" frame_id="1" name="玲" text="『あ、はい。』"
		   voices="rei00760"/>
		<msg @l="836" char_id="-1" frame_id="-1" name="面接官"
		   text="『そうですか！&#32;ではこれからすぐにでも行いましょう。』" voices=""/>
		<msg @l="838" char_id="1" frame_id="1" name="玲" text="『え‥‥これからですか？』"
		   voices="rei00900"/>
		<msg @l="840" char_id="-1" frame_id="-1" name="面接官"
		   text="『あぁ、やめても良いですよ。こんなチャンスは二度とないですけどね』" voices=""/>
		<msg @l="842" char_id="1" frame_id="1" name="玲"
		   text="『いえ、そう言うわけではないんですが‥‥準備などしていませんし。』" voices="rei00910"/>
		<msg @l="844" char_id="-1" frame_id="-1" name="面接官"
		   text="『ああ、いえいえ。特に準備など必要ありません。』" voices=""/>
		<msg @l="846" char_id="-1" frame_id="-1" name="面接官"
		   text="『白石さんはそこに座っているだけで良いのですよ。』" voices=""/>
		<msg @l="848" char_id="1" frame_id="1" name="玲"
		   text="『はぁ、そういうことでしたら構いませんけど。』" voices="rei00920"/>
		<msg @l="850" char_id="-1" frame_id="-1" name="面接官" text="『では、早速始めましょうか。』"
		   voices=""/>
		<wait_chgmv/>
		<ev @l="854" src="ev-006b"/>
		<msg @l="856" char_id="-1" frame_id="-1" name=""
		   text="そう言ってかっぷくのいい面接官が玲の隣へと腰を下ろし、もう一人がソファの後ろ側に立つ。" voices=""/>
		<msg @l="858" char_id="1" frame_id="1" name="玲"
		   text="『あの‥‥実地検査をされるのではないんですか？』" voices="rei00930"/>
		<msg @l="860" char_id="-1" frame_id="-1" name="面接官" text="『ええ、これが実地検査ですよ？』"
		   voices=""/>
		<msg @l="862" char_id="1" frame_id="1" name="玲" text="『これが、ですか‥‥？』"
		   voices="rei00940"/>
		<msg @l="864" char_id="-1" frame_id="-1" name="面接官"
		   text="『そうです。最近の女性の中にはスキンシップ行為をセクハラと騒ぎ立てて社内のムードを壊す人もいますからね。』" voices=""/>
		<msg @l="866" char_id="-1" frame_id="-1" name="面接官"
		   text="『長く一緒に働く為には、スキンシップを受け入れてもらえる女性でないと困りますので、受け入れられるかどうかの我慢強さを検査させて戴きます。』"
		   voices=""/>
		<msg @l="868" char_id="1" frame_id="1" name="玲" text="『え、我慢強さって‥‥。』"
		   voices="rei00950"/>
		<wait_chgmv/>
		<ev @l="872" src="ev-006bx3y2"/>
		<msg @l="874" char_id="1" frame_id="1" name="玲" text="『あ、何を‥‥。』"
		   voices="rei00960"/>
		<msg @l="876" char_id="-1" frame_id="-1" name=""
		   text="面接官の手がタイトスカートから伸びた玲の白い太腿を撫でる。" voices=""/>
		<msg @l="877" char_id="-1" frame_id="-1" name=""
		   text="玲はそれを払い退けようとするが、すぐに手を止める。" voices=""/>
		<msg @l="878" char_id="-1" frame_id="-1" name=""
		   text="ここで心象の悪い行動を取れば、折角の特別面接がふいになってしまう。" voices=""/>
		<msg @l="879" char_id="-1" frame_id="-1" name=""
		   text="そしたら、稲庭と同じ会社に就職する夢が断たれる･･････。" voices=""/>
		<msg @l="881" char_id="-1" frame_id="-1" name="面接官"
		   text="『ふふ････。流石に“玲さん”だ。その我慢強さは昔から変わりませんね。』" voices=""/>
		<stopbgm @l="885" fadeout="1000"/>
		<wait_chgmv/>
		<ev @l="887" src="ev-006b"/>
		<msg @l="889" char_id="1" frame_id="1" name="玲" text="『え‥‥？』"
		   voices="rei01140"/>
		<msg @l="891" char_id="-1" frame_id="-1" name="面接官"
		   text="『その顔は、なぜ昔のことを知っているのか、と言う顔ですね。』" voices=""/>
		<msg @l="893" char_id="-1" frame_id="-1" name="大黒"
		   text="『ふふふ･･････あなたは覚えていないでしょうが、私は高校の時あなたと同級生だった大黒満彦（おおぐろみつひこ）ですよ。』"
		   voices=""/>
		<msg @l="895" char_id="1" frame_id="1" name="玲" text="『‥‥！？』"
		   voices="rei01010"/>
		<msg @l="897" char_id="-1" frame_id="-1" name="" text="玲は大黒の言葉にびっくりする。"
		   voices=""/>
		<msg @l="898" char_id="1" frame_id="1" name="玲" text="(お、大黒？誰････？）"
		   voices=""/>
		<msg @l="899" char_id="-1" frame_id="-1" name=""
		   text="必死で高校時代のことを思い出そうとする。しかし印象が薄かったのか、中々思い出せなかった。" voices=""/>
		<msg @l="901" char_id="1" frame_id="1" name="玲"
		   text="（でも同級生だったなら昔話に花を咲かせれば、面接が有利になるかも）" voices=""/>
		<msg @l="903" char_id="-1" frame_id="-1" name=""
		   text="玲は偶然を喜ぶがその期待は次の言葉であっさりと裏切られた。" voices=""/>
		<bgm @l="906" src="bgm15" volume="1."/>
		<msg @l="908" char_id="-1" frame_id="-1" name="大黒"
		   text="『玲さんは今も美しいですが、昔も綺麗でしたよね。私はそんなあなたに憧れて手紙を出したのですが･･････』" voices=""/>
		<msg @l="910" char_id="-1" frame_id="-1" name="大黒"
		   text="『見事に振られてしまいました･･････。しかも皆の目の前で手紙を読まれ･･････笑いものにもされました････すごく辛かったですよ。』"
		   voices=""/>
		<msg @l="912" char_id="1" frame_id="1" name="玲" text="『‥‥！？』"
		   voices="rei01010"/>
		<msg @l="914" char_id="1" frame_id="1" name="玲" text="『そ、それは‥‥。』"
		   voices="rei01070"/>
		<msg @l="916" char_id="-1" frame_id="-1" name=""
		   text="誤解です。と言おうと思ったが、大黒がそれを遮る。" voices=""/>
		<msg @l="918" char_id="-1" frame_id="-1" name="大黒"
		   text="『しかし、今は昔と立場が変わりました！昔はあなたが選ぶ側だった。しかし今は私が選ぶ側になったわけです。･･････世の中何があるか分からないものですね。』"
		   voices=""/>
		<msg @l="920" char_id="1" frame_id="1" name="玲" text="『‥‥‥‥。』"
		   voices="rei00980"/>
		<msg @l="922" char_id="-1" frame_id="-1" name=""
		   text="大黒は完全に誤解をしている。確かに高校の頃数多くのラブレターをもらった記憶はある。しかし、人に見せてさらし者にした記憶はないし、そんな事をするはずがない。"
		   voices=""/>
		<msg @l="923" char_id="-1" frame_id="-1" name=""
		   text="･･････しかし、玲はまだ大黒のことを思い出せずにいたので、はっきりと事情を説明することも出来ず、今は大黒の言葉に押し黙るしかなかった。"
		   voices=""/>
		<msg @l="925" char_id="-1" frame_id="-1" name="大黒"
		   text="『ああ、昔話が過ぎましたな。検査に戻りましょうか。』" voices=""/>
		<wait_chgmv/>
		<ev @l="928" src="ev-006bx3y2"/>
		<msg @l="930" char_id="-1" frame_id="-1" name=""
		   text="ニヤニヤと口元を歪ませながら、大黒は玲の膝から太腿にかけてねっとりと撫で回す。" voices=""/>
		<msg @l="932" char_id="1" frame_id="1" name="玲" text="『‥‥‥っ‥‥。』"
		   voices="rei00990"/>
		<msg @l="934" char_id="-1" frame_id="-1" name="大黒"
		   text="『しかし、玲さんの履歴書を見つけた時には驚きましたよ。まるで運命かと思いましたね。』" voices=""/>
		<msg @l="936" char_id="-1" frame_id="-1" name=""
		   text="大黒は嬉しそうに、白い足をべたべたと触ってくる。" voices=""/>
		<msg @l="937" char_id="-1" frame_id="-1" name=""
		   text="玲は大黒から貰ったラブレターの事は思い出せなかったが、言われたような事は誰にもした事が無いという自信はあった。" voices=""/>
		<msg @l="938" char_id="-1" frame_id="-1" name=""
		   text="だから面接が終わったら大黒さんに改めて会いに行き、誠心誠意説明すればきっと分かってくれるはずと信じていた。" voices=""/>
		<msg @l="939" char_id="-1" frame_id="-1" name=""
		   text="でないと、このまま誤解されたままでは面接にも落とされてしまう可能性が高い。だから今は何をされても耐え、早く面接が終わるようにと玲は祈っていた。"
		   voices=""/>
		<msg @l="941" char_id="-1" frame_id="-1" name=""
		   text="しかし、玲の思いを裏切るかのように、大黒はべたべたした手できめ細かな白い足をさわり続ける" voices=""/>
		<msg @l="943" char_id="-1" frame_id="-1" name="大黒"
		   text="『ふふふふ‥‥まさかこうやって“玲さん”の綺麗な足に触れる日が来るとは夢にも思っていませんでしたよ。』" voices=""/>
		<msg @l="945" char_id="1" frame_id="1" name="玲" text="『‥‥‥‥。』"
		   voices="rei01020"/>
		<msg @l="947" char_id="-1" frame_id="-1" name="大黒"
		   text="『玲さん。この肌を今までに何人の男達に触らせたのですか？』" voices=""/>
		<msg @l="949" char_id="1" frame_id="1" name="玲" text="『‥‥‥‥。』"
		   voices="rei01020"/>
		<msg @l="951" char_id="-1" frame_id="-1" name="" text="玲はとにかく黙って耐えるようにしていた。"
		   voices=""/>
		<wait_chgmv/>
		<ev @l="954" src="ev-006b"/>
		<msg @l="956" char_id="-1" frame_id="-1" name="大黒"
		   text="『んー、緊張しすぎて質問に答えられないようですね。まぁ、面接ではよくあることです。』" voices=""/>
		<msg @l="958" char_id="-1" frame_id="-1" name="大黒"
		   text="『普通はしないのですが、憧れの玲さんの為です。特別な緊張のほぐし方をしてあげましょう。』" voices=""/>
		<msg @l="960" char_id="1" frame_id="1" name="玲" text="『え‥‥？』"
		   voices="rei01140"/>
		<msg @l="962" char_id="-1" frame_id="-1" name="大黒"
		   text="『おい、高橋くん‥‥緊張をほぐす為に玲さんの胸を揉んであげたまえ。』" voices=""/>
		<wait_chgmv/>
		<ev @l="966" src="ev-006bx3y3"/>
		<msg @l="968" char_id="-1" frame_id="-1" name=""
		   text="そう大黒が言うと、玲の後ろにいた面接官が玲の乳房をわしづかみし、スーツの上から服の上からでも分かる大きな胸を揉み始める。"
		   voices=""/>
		<msg @l="970" char_id="1" frame_id="1" name="玲" text="『あ、何を‥‥。』"
		   voices="rei00960"/>
		<msg @l="972" char_id="-1" frame_id="-1" name="大黒"
		   text="『おぉ、早速緊張がほぐれて声が出せたじゃないですか。』" voices=""/>
		<msg @l="974" char_id="1" frame_id="1" name="玲" text="『‥‥‥っ‥‥。』"
		   voices="rei00990"/>
		<msg @l="976" char_id="-1" frame_id="-1" name="高橋"
		   text="『おい！大黒さんが気を遣ってくれたのにお礼も言えないのか！』" voices=""/>
		<msg @l="978" char_id="1" frame_id="1" name="玲" text="『‥‥‥‥。』"
		   voices="rei01020"/>
		<msg @l="980" char_id="1" frame_id="1" name="玲" text="『‥‥あ、ありがとうございます。』"
		   voices="rei01000"/>
		<msg @l="982" char_id="-1" frame_id="-1" name="大黒"
		   text="『ふふふ、玲さんにお礼を言われるとは。高校時代には想像すらできませんでしたよ。』" voices=""/>
		<msg @l="984" char_id="-1" frame_id="-1" name="大黒"
		   text="『さて、このまま検査を続けたいところですが、ここでおしまいにしましょう。』" voices=""/>
		<wait_chgmv/>
		<ev @l="987" src="ev-006b"/>
		<msg @l="989" char_id="1" frame_id="1" name="玲" text="『え‥‥？』"
		   voices="rei01140"/>
		<msg @l="991" char_id="1" frame_id="1" name="玲" text="『‥‥あ、ありがとうございます。』"
		   voices="rei01000"/>
		<stopbgm @l="995" fadeout="1000"/>
		<msg @l="997" char_id="-1" frame_id="-1" name=""
		   text="玲はやっとこのセクハラ面接から解放されると思い安堵のため息をつく。だが、ほっとしたのも束の間、大黒より非情な言葉が告げられた。"
		   voices=""/>
		<msg @l="999" char_id="-1" frame_id="-1" name="大黒"
		   text="『ですが、検査はこれだけではありませんよ。』" voices=""/>
		<msg @l="1001" char_id="1" frame_id="1" name="玲" text="『え‥‥？』"
		   voices="rei01140"/>
		<msg @l="1003" char_id="1" frame_id="1" name="玲" text="『‥‥まだ何かあるんですか？』"
		   voices="rei01030"/>
		<msg @l="1005" char_id="-1" frame_id="-1" name="大黒"
		   text="『今日は玲さんと私の再会を祝して、私自ら特別な検査を用意させて頂きました。』" voices=""/>
		<msg @l="1006" char_id="-1" frame_id="-1" name="大黒"
		   text="『今日の朝、急に面接時間の変更をさせたでしょう？あれは私の指示だったんですよ。玲さんをたっぷり検査する為に色々と準備をする時間が必要だったのでね。』"
		   voices=""/>
		<msg @l="1008" char_id="-1" frame_id="-1" name="大黒"
		   text="『玲さんは我が社の内定がどうしても欲しいのでしょう？だったら次の検査も、受けていかれたほうが良いですよ･･････。』"
		   voices=""/>
		<msg @l="1010" char_id="1" frame_id="1" name="玲" text="『‥‥‥‥。』"
		   voices="rei01020"/>
		<msg @l="1012" char_id="-1" frame_id="-1" name=""
		   text="玲は、大黒の言葉にドス黒いものを感じたが、今辞退したら確実に落とされると思った。そうなれば、稲庭と同じ会社で働くという夢は絶たれる。"
		   voices=""/>
		<msg @l="1013" char_id="-1" frame_id="-1" name=""
		   text="それに、大黒がこんなセクハラ面接をしてくるのも誤解のせいに違いないと信じていたので、誤解さえ解ければ普通の面接になると望みを持っていた。"
		   voices=""/>
		<msg @l="1014" char_id="-1" frame_id="-1" name=""
		   text="だから、あと少し我慢して誤解を解く機会を作ろう、そう思って検査を続けることにした。" voices=""/>
		<msg @l="1016" char_id="1" frame_id="1" name="玲" text="『‥‥分かりました。』"
		   voices="rei01740"/>
		<msg @l="1018" char_id="-1" frame_id="-1" name=""
		   text="だが玲はこの時、大黒の目の奥に光る復讐の炎の大きさに気づくことはできなかった。" voices=""/>
		<clear @l="1024" class="all"/>
		<end_scene @l="1027"/>
		<bgm @l="1029" src="bgm09" volume="1."/>
		<msg @l="1031" char_id="-1" frame_id="-1" name="" text="大黒と高橋はソファから立ち上がる。"
		   voices=""/>
		<msg @l="1033" char_id="-1" frame_id="-1" name="大黒" text="『では、次の検査を始めましょう。』"
		   voices=""/>
		<msg @l="1035" char_id="-1" frame_id="-1" name="大黒"
		   text="『早速ですが、服を脱いでください。』" voices=""/>
		<msg @l="1037" char_id="1" frame_id="1" name="玲" text="『‥‥え？』" voices=""/>
		<msg @l="1039" char_id="-1" frame_id="-1" name=""
		   text="玲は大黒の言葉の意味がわからず、思わず聞きなおしてしまう。" voices=""/>
		<msg @l="1041" char_id="-1" frame_id="-1" name="大黒"
		   text="『聞こえませんでしたか？服を脱いでください。』" voices=""/>
		<msg @l="1043" char_id="1" frame_id="1" name="玲"
		   text="『ど、どうしてそんな恥ずかしいことをしなくちゃいけないんですか！？』" voices=""/>
		<msg @l="1045" char_id="-1" frame_id="-1" name="大黒"
		   text="『恥ずかしいこと？勘違いをしてもらっては困りますね。これも立派な検査の一つなんですよ。』" voices=""/>
		<msg @l="1047" char_id="1" frame_id="1" name="玲" text="『こんな検査おかしいです‥‥‥‥。』"
		   voices=""/>
		<msg @l="1049" char_id="-1" frame_id="-1" name=""
		   text="玲は後で大黒に説明をしようと思っていたが、あまりの検査の内容に思わず言ってしまう。" voices=""/>
		<msg @l="1051" char_id="1" frame_id="1" name="玲"
		   text="『お願いですからもうやめて下さい。さっき、高校の頃、頂いた手紙を皆に見せたとおっしゃっていましたが、私そんな事をしていません。誤解です！』"
		   voices=""/>
		<msg @l="1053" char_id="1" frame_id="1" name="玲"
		   text="『お願いしますから、普通の面接に戻して下さい･･････。』" voices=""/>
		<msg @l="1055" char_id="-1" frame_id="-1" name="大黒"
		   text="『玲さんこそ何を誤解されているかは知りませんが、昔の事とこの検査の内容は何も関係ありませんよ。』" voices=""/>
		<msg @l="1057" char_id="-1" frame_id="-1" name=""
		   text="そう言いながらも、大黒は心の中で激しい怒りを覚えていた。" voices=""/>
		<msg @l="1058" char_id="-1" frame_id="-1" name=""
		   text="玲に取っては思い出せないほど、どうでも良いことだったのか････。" voices=""/>
		<msg @l="1059" char_id="-1" frame_id="-1" name=""
		   text="なら二度と自分のことを忘れないように、凌辱の限りを尽くしてやろうと決心するのであった。" voices=""/>
		<msg @l="1060" char_id="-1" frame_id="-1" name=""
		   text="だが、今すぐ犯してもそれでは面白くない。彼女自らが、恥ずべき行為を取らせるよう、自分から身体を提供するようにさせなければならない。"
		   voices=""/>
		<msg @l="1061" char_id="-1" frame_id="-1" name=""
		   text="その為には少しずつ検査のレベルを上げていく必要がある。大黒はそう考え、玲が納得するような返事を返すのだった。" voices=""/>
		<msg @l="1063" char_id="-1" frame_id="-1" name="大黒"
		   text="『いいですか････我が社では仕事をする際、男性だから、女性だからと差別をしたくないのですよ。』" voices=""/>
		<msg @l="1065" char_id="-1" frame_id="-1" name="大黒"
		   text="『つまり、平等に仕事をする為には、男だから、女だからという見方で仲間を見てはいけないのです。』" voices=""/>
		<msg @l="1067" char_id="1" frame_id="1" name="玲"
		   text="『それが、この検査と何の関係があるというんですか・・・』" voices=""/>
		<msg @l="1069" char_id="-1" frame_id="-1" name="大黒"
		   text="『玲さんは、着替えの際に同性の前では下着姿になっていても気にならないでしょう？』" voices=""/>
		<msg @l="1071" char_id="1" frame_id="1" name="玲"
		   text="『ええ・・・・それは、まぁ・・・・・・・・』" voices=""/>
		<msg @l="1073" char_id="-1" frame_id="-1" name="大黒"
		   text="『それと同じ事で、会社の男性を異性として見ず同性として思えるようになる為に、下着姿で社内を歩いてもらって周囲の視線に慣れて戴くのです。』"
		   voices=""/>
		<msg @l="1075" char_id="1" frame_id="1" name="玲" text="『そ、そんなこと無理です‥‥‥。』"
		   voices=""/>
		<msg @l="1077" char_id="-1" frame_id="-1" name="大黒"
		   text="『あぁ、無理にとはいいません。別にここで止めて頂いても良いのですよ。』" voices=""/>
		<msg @l="1079" char_id="-1" frame_id="-1" name="大黒"
		   text="『ただ、今やめたら検査はここでおしまいですので、我が社とはご縁がなかったということになりますけどね。』" voices=""/>
		<msg @l="1081" char_id="1" frame_id="1" name="玲"
		   text="『で、でも‥‥下着姿で歩くだなんて‥‥‥。』" voices=""/>
		<msg @l="1083" char_id="-1" frame_id="-1" name=""
		   text="例え検査をパスし大黒建設に入社出来たとしても、下着姿で社内を歩かされている所を多数の社員に見られでもしようものなら、入社後、必ず稲庭さんの耳にも入ってしまう。"
		   voices=""/>
		<msg @l="1084" char_id="-1" frame_id="-1" name=""
		   text="そんな事が知れようものなら、稲庭さんは軽蔑の目で私を見るかもしれない。それでは全てを失ってしまうのと同じだ。" voices=""/>
		<msg @l="1086" char_id="1" frame_id="1" name="玲"
		   text="『お願いです！他の事でしたら何でもやりますので別の検査に変えていただけませんでしょうか。私、絶対に御社で働きたいんです！』"
		   voices=""/>
		<msg @l="1088" char_id="-1" frame_id="-1" name="大黒"
		   text="『なるほど‥‥玲さんがそこまで言うのならしょうがない。』" voices=""/>
		<msg @l="1090" char_id="-1" frame_id="-1" name="大黒"
		   text="『では、こうしましょう。特別に検査レベルを下げるということでどうですか。』" voices=""/>
		<msg @l="1092" char_id="-1" frame_id="-1" name="大黒"
		   text="『もちろんそのぶん評価も下がりますが･･････。』" voices=""/>
		<msg @l="1094" char_id="-1" frame_id="-1" name=""
		   text="そう言って大黒は舐めるようなねっとりとした視線で玲を見る。" voices=""/>
		<msg @l="1096" char_id="1" frame_id="1" name="玲"
		   text="『け、検査レベルを下げると、どんな内容になるのですか‥‥』" voices=""/>
		<msg @l="1098" char_id="-1" frame_id="-1" name="大黒"
		   text="『検査内容は先程と同じで、社内を歩いていただき男性を異性と感じないように出来るかどうかを見させていただきます。』" voices=""/>
		<msg @l="1100" char_id="1" frame_id="1" name="玲"
		   text="『え！そ、それではさっきと同じでは‥‥‥‥。』" voices=""/>
		<msg @l="1102" char_id="-1" frame_id="-1" name="大黒"
		   text="『あぁ、もちろん先程とは衣服の指定が違います。スーツのままで結構ですよ。』" voices=""/>
		<msg @l="1104" char_id="1" frame_id="1" name="玲" text="『そ、そうですか･･････。』"
		   voices=""/>
		<msg @l="1106" char_id="-1" frame_id="-1" name=""
		   text="玲は大黒の言葉に、ほっと胸をなでおろす。しかし――" voices=""/>
		<msg @l="1108" char_id="-1" frame_id="-1" name="大黒"
		   text="『ただ‥‥今度は下着のみを脱いでもらいます。』" voices=""/>
		<msg @l="1110" char_id="1" frame_id="1" name="玲" text="『えっ！？』" voices=""/>
		<msg @l="1112" char_id="-1" frame_id="-1" name="大黒"
		   text="『それと、スーツの上着は脱いでいただいて上半身はブラウスのみになっていただくことになります。』" voices=""/>
		<msg @l="1114" char_id="1" frame_id="1" name="玲"
		   text="『そんなっ！ブラウスのみで下着を着けないなんて････透けて見えてしまいます‥‥！』" voices=""/>
		<msg @l="1116" char_id="-1" frame_id="-1" name="大黒"
		   text="『ですが、下着姿になるわけではないので普通にしていれば誰も気づきませんよ。』" voices=""/>
		<msg @l="1117" char_id="-1" frame_id="-1" name="大黒"
		   text="『後は、玲さんがどれだけ社員達を異性と意識せず普通にしていられるかです。』" voices=""/>
		<msg @l="1119" char_id="-1" frame_id="-1" name="大黒"
		   text="『服の下に下着をつけていないからって男達が見ていると自意識過剰になり、アソコをぐちゅぐちゅに濡らさなければ良いのですよ・・・』"
		   voices=""/>
		<msg @l="1121" char_id="1" frame_id="1" name="玲" text="『な･･････････！？』"
		   voices=""/>
		<msg @l="1123" char_id="-1" frame_id="-1" name="大黒"
		   text="『どうしますか？この検査も受けるのをやめますか？』" voices=""/>
		<msg @l="1125" char_id="1" frame_id="1" name="玲"
		   text="『････････････････････。』" voices=""/>
		<msg @l="1127" char_id="-1" frame_id="-1" name="" text="こんな検査受けたくない･･････。"
		   voices=""/>
		<msg @l="1128" char_id="-1" frame_id="-1" name=""
		   text="でも、もしこの検査も拒否したら、二度とこの会社に入る事はできない･･････。" voices=""/>
		<msg @l="1129" char_id="-1" frame_id="-1" name=""
		   text="そうしたら、稲庭さんと一緒にいれなくなる･･････。" voices=""/>
		<msg @l="1130" char_id="-1" frame_id="-1" name="" text="それだけは絶対にイヤだ･･････。"
		   voices=""/>
		<bgm @l="1133" src="bgm14" volume="1."/>
		<msg @l="1135" char_id="1" frame_id="1" name="玲" text="『‥‥わかりました。』"
		   voices=""/>
		<msg @l="1137" char_id="1" frame_id="1" name="玲" text="『その検査内容でお願いします。』"
		   voices=""/>
		<msg @l="1139" char_id="-1" frame_id="-1" name="大黒"
		   text="『よろしい。それでは私達は外で待っていますので、準備が出来たら出てきてください。』" voices=""/>
		<msg @l="1141" char_id="1" frame_id="1" name="玲" text="『‥‥はい。』" voices=""/>
		<stopbgm @l="1144" fadeout="1000"/>
		<clear @l="1150" class="all"/>
		<msgshow @l="1152" show="true"/>
		<wait_chgmv/>
		<bg @l="1156" src="bg17m1"/>
		<char @l="1160" id="ookur" pos="center" src="ookuro010f" y="-80"/>
		<msg @l="1162" char_id="-1" frame_id="-1" name="大黒"
		   text="『まさかあの美しく、誇り高い玲さんが、セクハラ面接を受け入れ抵抗をしないなんて‥‥‥‥。』" voices=""/>
		<msg @l="1164" char_id="-1" frame_id="-1" name="高橋"
		   text="『良かったですね、ぼっちゃん。昔の復讐が叶って。』" voices=""/>
		<msg @l="1166" char_id="-1" frame_id="-1" name="大黒"
		   text="『ぼっちゃんはやめろ、高橋！親父から職を引き継いだとはいえ、これでも社長なのだからな。』" voices=""/>
		<msg @l="1168" char_id="-1" frame_id="-1" name="高橋" text="『し、失礼しました。』"
		   voices=""/>
		<msg @l="1170" char_id="-1" frame_id="-1" name="高橋"
		   text="『し、しかし綺麗ですねー、あの白石という女。さすが大黒さんが見惚れただけのことはあります。そこら辺のアイドルよりも美人ですね。』"
		   voices=""/>
		<msg @l="1172" char_id="-1" frame_id="-1" name="大黒"
		   text="『当たり前です。玲さんは我々のマドンナだったのですから。････しかし、あの玲さんが身体を触られても我慢するとは････。』"
		   voices=""/>
		<msg @l="1174" char_id="-1" frame_id="-1" name="大黒"
		   text="『どうやら調査のとおり、稲庭という男が余程好きで、どうしても一緒の会社に入りたいようですね････。』" voices=""/>
		<msg @l="1176" char_id="-1" frame_id="-1" name="大黒"
		   text="『ですが許しませんよ、そんな事は･･････。』" voices=""/>
		<msg @l="1178" char_id="-1" frame_id="-1" name="大黒"
		   text="『大好きな人の前で、最大の恥辱を与える･･････。私と同じ目にあわせて上げますよ、玲さん。』" voices=""/>
		<msg @l="1180" char_id="-1" frame_id="-1" name="高橋"
		   text="『では、その稲庭という男を連れてきましょうか？』" voices=""/>
		<msg @l="1182" char_id="-1" frame_id="-1" name="大黒"
		   text="『いえ、楽しみは最後まで取っておきましょう。』" voices=""/>
		<msg @l="1184" char_id="-1" frame_id="-1" name="大黒"
		   text="『少しずつ堕ちて行くようにして、楽しまないとね･･････。』" voices=""/>
		<msg @l="1186" char_id="-1" frame_id="-1" name=""
		   text="応接室の前で、大黒はニヤニヤといやらしい笑みを浮かべていた。" voices=""/>
		<se @l="1190" buf="1" src="扉を開ける音_金属" volume="1."/>
		<msg @l="1192" char_id="-1" frame_id="-1" name="" text="ガチャ" voices=""/>
		<clear @l="1195" class="char"/>
		<char @l="1197" id="ookur" pos="auto" src="ookuro010"/>
		<bgm @l="1201" src="bgm14" volume="1."/>
		<msg @l="1203" char_id="1" frame_id="1" name="玲" text="『‥‥‥‥。』" voices=""/>
		<msg @l="1205" char_id="-1" frame_id="-1" name=""
		   text="扉が開き、中から嫌悪の表情を浮かべた玲が出てくる。" voices=""/>
		<msg @l="1207" char_id="-1" frame_id="-1" name="大黒" text="『準備ができたようですね。』"
		   voices=""/>
		<msg @l="1209" char_id="1" frame_id="1" name="玲" text="『‥‥はい。』" voices=""/>
		<msg @l="1211" char_id="-1" frame_id="-1" name=""
		   text="そうして玲は恥辱と屈辱が交じったような表情で小さく頷く。" voices=""/>
		<msg @l="1213" char_id="-1" frame_id="-1" name="大黒" text="『それではいきましょうか。』"
		   voices=""/>
		<msg @l="1215" char_id="1" frame_id="1" name="玲" text="『‥‥‥‥。』" voices=""/>
		<clear @l="1221" class="all"/>
		<label @l="1224" id="event_scene47"/>
		<label @l="1228" id="chart_line26"/>
		<wait_chgmv/>
		<ev @l="1232" src="ev-047a"/>
		<description @l="1235" text="一次面接Ｂ"/>
		<msg @l="1237" char_id="-1" frame_id="-1" name=""
		   text="大黒達は下着をつけていない玲を引き連れて、大勢の社員が働いているオフィスの中を歩き始める。" voices=""/>
		<msg @l="1238" char_id="-1" frame_id="-1" name=""
		   text="玲は胸が透けて見えているのではないかと羞恥に震えずっと下を向いている。" voices=""/>
		<msg @l="1239" char_id="-1" frame_id="-1" name=""
		   text="すると、最初は気づかなかったが、通り過ぎる社員の全員が大黒に対して礼儀正しく挨拶をしていく。" voices=""/>
		<msg @l="1241" char_id="1" frame_id="1" name="玲"
		   text="『‥‥あの、どうしてみんな礼をして行くんですか？』" voices="rei01050"/>
		<msg @l="1243" char_id="-1" frame_id="-1" name="大黒"
		   text="『ふふ、それだけ社員教育が行き届いているということですよ。』" voices=""/>
		<msg @l="1245" char_id="1" frame_id="1" name="玲" text="『‥‥？』"
		   voices="rei01060"/>
		<msg @l="1247" char_id="-1" frame_id="-1" name="大黒"
		   text="『それよりもどうです‥‥異性の視線を気にせず歩くことが出来そうですか？』" voices=""/>
		<msg @l="1249" char_id="1" frame_id="1" name="玲" text="『そ、それは‥‥。』"
		   voices="rei01070"/>
		<msg @l="1251" char_id="-1" frame_id="-1" name="大黒"
		   text="『まだ慣れないようですね。では恥ずかしくならないよう、少し手伝ってあげましょう。』" voices=""/>
		<msg @l="1253" char_id="1" frame_id="1" name="玲" text="『‥‥？』"
		   voices="rei01060"/>
		<msg @l="1255" char_id="-1" frame_id="-1" name="大黒"
		   text="『今通り過ぎていった彼は、玲さんが下着をつけていないことに気付いていたようですよ？』" voices=""/>
		<msg @l="1257" char_id="1" frame_id="1" name="玲" text="『‥‥！！』"
		   voices="rei01080"/>
		<msg @l="1259" char_id="-1" frame_id="-1" name=""
		   text="大黒の言葉に、玲は思わず両手で胸元を隠そうとする。" voices=""/>
		<msg @l="1260" char_id="-1" frame_id="-1" name=""
		   text="が、その手を高橋という面接官が掴み‥‥止められた。" voices=""/>
		<msg @l="1262" char_id="1" frame_id="1" name="玲" text="『あ、何を‥‥。』"
		   voices="rei00960"/>
		<msg @l="1264" char_id="-1" frame_id="-1" name="高橋"
		   text="『いまは検査の途中なんですから、手で隠そうなんて考えてはいけません。』" voices=""/>
		<msg @l="1266" char_id="1" frame_id="1" name="玲" text="『‥‥‥‥。』"
		   voices="rei01090"/>
		<msg @l="1268" char_id="-1" frame_id="-1" name="大黒"
		   text="『もう一度言いますが、この検査は玲さんが異性の視線を感じないように出来るかどうかを調てるのですから、身体を隠すなんてもってのほかです。』"
		   voices=""/>
		<msg @l="1270" char_id="-1" frame_id="-1" name="大黒"
		   text="『次に同じ事をやったら、不採用になってしまうので気をつけてくださいね。』" voices=""/>
		<msg @l="1272" char_id="1" frame_id="1" name="玲" text="『‥‥‥‥。』"
		   voices="rei01090"/>
		<msg @l="1274" char_id="1" frame_id="1" name="玲" text="『‥‥分かりました。』"
		   voices="rei01740"/>
		<msg @l="1276" char_id="-1" frame_id="-1" name="" text="大黒『では、検査を続けますよ』"
		   voices=""/>
		<msg @l="1278" char_id="-1" frame_id="-1" name=""
		   text="大黒は、ブラウスの下がノーブラで透けて見えそうな乳房を犯すように見る。" voices=""/>
		<msg @l="1280" char_id="-1" frame_id="-1" name="大黒"
		   text="『玲さんは昔よりも胸が大きくなったみたいですね。光のおかげでブラウスが透け、形のよさそうな乳房が丸見えだ。』" voices=""/>
		<msg @l="1282" char_id="1" frame_id="1" name="玲" text="『‥‥！！』"
		   voices="rei01080"/>
		<msg @l="1284" char_id="-1" frame_id="-1" name="大黒"
		   text="『そんなに、大きいと歩く度にゆさゆさと揺れるので乳首がこすれて痛くないですか？』" voices=""/>
		<msg @l="1286" char_id="1" frame_id="1" name="玲" text="『‥‥‥‥。』"
		   voices="rei01090"/>
		<msg @l="1288" char_id="-1" frame_id="-1" name="大黒"
		   text="『ん････、乳首が立ってきているのではないですか？ブラウスが膨らんでいますよ。』" voices=""/>
		<msg @l="1290" char_id="1" frame_id="1" name="玲" text="『‥‥‥っ‥‥。』"
		   voices="rei00990"/>
		<msg @l="1292" char_id="-1" frame_id="-1" name="大黒"
		   text="『んー、駄目ですねー。私の言葉くらいで恥ずかしがっているようでは。』" voices=""/>
		<msg @l="1294" char_id="-1" frame_id="-1" name="大黒"
		   text="『やはり隠しているから、恥ずかしくなるのです。』" voices=""/>
		<msg @l="1296" char_id="-1" frame_id="-1" name="大黒"
		   text="『いっそ、全部脱いだ方が恥ずかしくなくなるかもしれませんよ。』" voices=""/>
		<msg @l="1298" char_id="1" frame_id="1" name="玲" text="『そ、それは‥‥。』"
		   voices="rei01070"/>
		<msg @l="1300" char_id="-1" frame_id="-1" name="大黒"
		   text="『ふふふ。冗談ですよ冗談。でも習うより慣れろ、という言葉もありますからね。』" voices=""/>
		<msg @l="1301" char_id="-1" frame_id="-1" name="大黒"
		   text="『あなたの豊満な胸もシャツの中に入れられていたら窮屈かもしれないので、気が向いたらいつでも脱いでもらって構いませんよ。』"
		   voices=""/>
		<msg @l="1303" char_id="1" frame_id="1" name="玲" text="『‥‥‥っ‥‥。』"
		   voices="rei00990"/>
		<msg @l="1305" char_id="1" frame_id="1" name="玲"
		   text="（なんでこんな酷いことをされないといけないの････）" voices=""/>
		<msg @l="1307" char_id="-1" frame_id="-1" name="高橋"
		   text="『おい！目上の人にアドバイスされたらお礼をしろとさっきも言っただろう！』" voices=""/>
		<msg @l="1309" char_id="-1" frame_id="-1" name="高橋"
		   text="『挨拶も出来ない人間は、我が社の社員になる資格はない！』" voices=""/>
		<msg @l="1311" char_id="1" frame_id="1" name="玲" text="『‥‥‥‥。』"
		   voices="rei01090"/>
		<msg @l="1313" char_id="-1" frame_id="-1" name="高橋"
		   text="『どうした！早くお礼を言いたまえ。』" voices=""/>
		<msg @l="1315" char_id="1" frame_id="1" name="玲" text="『‥‥あ、ありがとうございます。』"
		   voices="rei01000"/>
		<msg @l="1317" char_id="-1" frame_id="-1" name="大黒"
		   text="『玲さんにとって記憶の片隅にもない私が、こんな淫らな言葉を言っているのに、それを喜んでもらえるとはね･･････ふふふ。』"
		   voices=""/>
		<msg @l="1319" char_id="-1" frame_id="-1" name="大黒"
		   text="『あの美人で聡明だった玲さんが、卑猥な言葉で喜ぶ変態な女になってしまってたとはショックですよ。』" voices=""/>
		<msg @l="1321" char_id="1" frame_id="1" name="玲" text="『‥‥‥っ‥‥。』"
		   voices="rei00990"/>
		<msg @l="1323" char_id="-1" frame_id="-1" name="大黒"
		   text="『やはり大きくなったおっぱいも、男達に揉まれて大きくなったんじゃないですか･･････。』" voices=""/>
		<msg @l="1325" char_id="-1" frame_id="-1" name="大黒"
		   text="『高校時代、体操服の下でゆれていたオッパイは今より一回りは小さかったのに、今じゃこんなに大きくなって････さぞかしたくさん揉まれて、乳首をちゅーちゅー吸われたんでしょうねー。』"
		   voices=""/>
		<msg @l="1327" char_id="1" frame_id="1" name="玲" text="『‥‥‥っ‥‥。』"
		   voices="rei00990"/>
		<msg @l="1329" char_id="-1" frame_id="-1" name=""
		   text="この後玲はオフィス内を連れ回されながら、大黒から辱めの言葉を受け続けるのだった。" voices=""/>
		<clear @l="1337" class="all"/>
		<msgshow @l="1339" show="true"/>
		<wait_chgmv/>
		<bg @l="1343" src="bg17m1"/>
		<msg @l="1346" char_id="-1" frame_id="-1" name=""
		   text="玲は、先程とは違うフロアを連れ回されていた。その際オフィスの廊下を通る社員達とすれ違う。" voices=""/>
		<wait_chgmv/>
		<ev @l="1350" src="ev-047a"/>
		<msg @l="1352" char_id="1" frame_id="1" name="玲" text="『‥‥‥‥。』"
		   voices="rei01100"/>
		<msg @l="1354" char_id="-1" frame_id="-1" name="" text="玲は悔しげな表情をしながら歩いていた。"
		   voices=""/>
		<msg @l="1355" char_id="-1" frame_id="-1" name=""
		   text="明らかに理不尽な要求と、それにあらがえない自分。" voices=""/>
		<msg @l="1356" char_id="-1" frame_id="-1" name=""
		   text="それでも、誤解を解きさえすれば普通の面接に戻れる。" voices=""/>
		<msg @l="1357" char_id="-1" frame_id="-1" name=""
		   text="そう思って、玲は恥辱の検査に耐えていた。" voices=""/>
		<msg @l="1358" char_id="-1" frame_id="-1" name=""
		   text="しかし、大黒の言葉責めはどんどんエスカレートしていき‥‥‥。" voices=""/>
		<msg @l="1360" char_id="-1" frame_id="-1" name="大黒"
		   text="『皆さんすれ違う度に、玲さんの胸を見ていきますね。』" voices=""/>
		<msg @l="1362" char_id="-1" frame_id="-1" name="大黒"
		   text="『まぁ、玲さんのような美人が、ノーブラでピンクの乳首を透けて見せていれば、誰もが気になりますからね。』" voices=""/>
		<msg @l="1364" char_id="1" frame_id="1" name="玲" text="『‥‥‥っ‥‥。』"
		   voices="rei00990"/>
		<msg @l="1366" char_id="-1" frame_id="-1" name="大黒"
		   text="『あぁ、もしかして男達に弄られすぎて、乳首は黒くなっちゃっているのかな？』" voices=""/>
		<msg @l="1368" char_id="-1" frame_id="-1" name=""
		   text="玲を一層辱めるようなことを言いながら、大黒はブラウスから見える白い胸の谷間に顔を近づける。" voices=""/>
		<msg @l="1370" char_id="1" frame_id="1" name="玲" text="『‥‥！！』"
		   voices="rei01110"/>
		<msg @l="1372" char_id="-1" frame_id="-1" name=""
		   text="玲は胸の谷間に大黒の生暖かい鼻息を感じた瞬間、反射的に後ずさった。" voices=""/>
		<msg @l="1373" char_id="-1" frame_id="-1" name="" text="その瞬間―――。" voices=""/>
		<msg @l="1375" char_id="-1" frame_id="-1" name="女性社員" text="『きゃっ！？』"
		   voices=""/>
		<msg @l="1377" char_id="1" frame_id="1" name="玲" text="『あっ‥‥。』"
		   voices="rei01120"/>
		<msg @l="1379" char_id="-1" frame_id="-1" name=""
		   text="玲はちょうど、すれ違おうとしていた女性社員とぶつかってしまった。" voices=""/>
		<msg @l="1381" char_id="-1" frame_id="-1" name="" text="ばしゃっ" voices=""/>
		<wait_chgmv/>
		<ev @l="1385" src="ev-047bx1z1"/>
		<stopbgm @l="1388" fadeout="1000"/>
		<msg @l="1390" char_id="1" frame_id="1" name="玲" text="『‥‥！？』"
		   voices="rei01150"/>
		<msg @l="1392" char_id="-1" frame_id="-1" name=""
		   text="運悪く女性社員が持っていたコップが弾かれ、水が玲の身体へとふりかかった。" voices=""/>
		<msg @l="1394" char_id="-1" frame_id="-1" name="女性社員" text="『ご、ごめんなさい‥‥！』"
		   voices=""/>
		<msg @l="1396" char_id="1" frame_id="1" name="玲"
		   text="『あ、いえ‥‥こちらこそすみませんでした。』" voices="rei01130"/>
		<msg @l="1398" char_id="-1" frame_id="-1" name="女性社員"
		   text="『でも、お洋服に水が‥‥‥‥あっ‥‥‥‥‥！』" voices=""/>
		<msg @l="1400" char_id="1" frame_id="1" name="玲" text="『え‥‥？』"
		   voices="rei01140"/>
		<msg @l="1402" char_id="-1" frame_id="-1" name="" text="女性社員の視線が玲の胸元で止まる。"
		   voices=""/>
		<msg @l="1403" char_id="-1" frame_id="-1" name="" text="その視線の先には、水に濡れたブラウス。"
		   voices=""/>
		<msg @l="1404" char_id="-1" frame_id="-1" name=""
		   text="そして‥‥濡れたブラウスが肌に張り付き下着をつけていない乳房が透けてまる見えだった。" voices=""/>
		<msg @l="1405" char_id="-1" frame_id="-1" name=""
		   text="気付けば、近くにいた社員達も透けた胸元をじっと見ていた。" voices=""/>
		<msg @l="1407" char_id="1" frame_id="1" name="玲" text="『‥‥！？』"
		   voices="rei01150"/>
		<wait_chgmv/>
		<ev @l="1411" src="ev-047bx1y1z1"/>
		<bgm @l="1413" src="bgm13" volume="1."/>
		<msg @l="1415" char_id="1" frame_id="1" name="玲" text="『きゃああっ！？』"
		   voices="rei01160"/>
		<msg @l="1417" char_id="-1" frame_id="-1" name=""
		   text="玲は顔を真っ赤にしながら胸元を手で隠し、短く悲鳴をあげる。" voices=""/>
		<msg @l="1419" char_id="-1" frame_id="-1" name="大黒"
		   text="『ほぉぅ！これが夢にまで見た玲さんの乳房････想像していた通りいい形をしている。乳首の色もピンク色だ。』" voices=""/>
		<msg @l="1421" char_id="-1" frame_id="-1" name=""
		   text="濡れたシャツに張り付き、透けた乳房を見て興奮した大黒は玲の胸元に張り付きそうになる程顔を近づける。" voices=""/>
		<msg @l="1422" char_id="-1" frame_id="-1" name=""
		   text="周りにいる社員達は、その騒ぎを聞きつけ玲の方に寄ってきた‥‥。" voices=""/>
		<msg @l="1424" char_id="-1" frame_id="-1" name="男性社員" text="『ん？なんだ、なんだ？』"
		   voices=""/>
		<msg @l="1426" char_id="-1" frame_id="-1" name=""
		   text="寄ってきた社員達は、玲の透けたブラウス姿を見ると最初は驚いた表情をしたが、すぐに軽蔑するような顔になる。" voices=""/>
		<msg @l="1428" char_id="-1" frame_id="-1" name="男性社員"
		   text="『なんだ、あの子下着つけてないぞ。』" voices=""/>
		<msg @l="1430" char_id="-1" frame_id="-1" name="男性社員"
		   text="『しかも乳首立たせてやがる、変態かよ。』" voices=""/>
		<msg @l="1432" char_id="-1" frame_id="-1" name="男性社員"
		   text="『誰だよー、会社に出張ヘルス嬢なんか呼んだ奴は。』" voices=""/>
		<msg @l="1434" char_id="-1" frame_id="-1" name=""
		   text="気がつくと１０人くらいに囲まれて、水に透けた上半身をじろじろと見られていた。玲は大勢に乳房を視姦され顔を真っ赤にした。"
		   voices=""/>
		<msg @l="1436" char_id="1" frame_id="1" name="玲" text="『み、みないでくださいっ‥‥。』"
		   voices="rei01170"/>
		<msg @l="1438" char_id="-1" frame_id="-1" name="大黒"
		   text="『何も隠す必要はないでしょう。今までその素晴らしいおっぱいで男達をたくさんたぶらかしてきたのですから。』" voices=""/>
		<msg @l="1440" char_id="1" frame_id="1" name="玲" text="『そんな‥‥。』"
		   voices="rei02050"/>
		<msg @l="1442" char_id="-1" frame_id="-1" name="大黒"
		   text="『折角ですから、社員みんなの共有物にしましょうか？』" voices=""/>
		<msg @l="1444" char_id="-1" frame_id="-1" name="" text="そう言って、大黒はにじり寄って来た。"
		   voices=""/>
		<msg @l="1446" char_id="1" frame_id="1" name="玲" text="『‥‥！？』"
		   voices="rei01150"/>
		<msg @l="1448" char_id="-1" frame_id="-1" name=""
		   text="胸を手で隠しながら、玲は後ずさる。すると、大黒は急に険しい顔で注意する。" voices=""/>
		<msg @l="1450" char_id="-1" frame_id="-1" name="大黒"
		   text="『玲さん、何度も言わせないで下さい。今も検査は継続中なのです。手で隠してはいけません。』" voices=""/>
		<wait_chgmv/>
		<ev @l="1453" src="ev-047bx1z1"/>
		<msg @l="1454" char_id="1" frame_id="1" name="玲" text="『きゃああっ！？』"
		   voices="rei01160"/>
		<msg @l="1456" char_id="-1" frame_id="-1" name=""
		   text="玲は胸を隠している手を大黒に掴まれ、濡れたシャツにはりつく乳房が露になり上半身は裸同然の姿になった。" voices=""/>
		<msg @l="1457" char_id="-1" frame_id="-1" name=""
		   text="玲は、あまりの恥ずかしさに、顔を赤くし悲鳴を上げる。" voices=""/>
		<msg @l="1459" char_id="-1" frame_id="-1" name="大黒"
		   text="『検査は最後までやり通さなければ、結果は出せませんからね。』" voices=""/>
		<msg @l="1461" char_id="1" frame_id="1" name="玲" text="『‥‥‥っ‥‥。』"
		   voices="rei00990"/>
		<msg @l="1463" char_id="-1" frame_id="-1" name=""
		   text="大黒は玲の手を引き、再び歩き出した。すると水をこぼした女性が大黒に話しかけてきた。" voices=""/>
		<stopbgm @l="1466" fadeout="1000"/>
		<msg @l="1468" char_id="-1" frame_id="-1" name="女性社員" text="『あ、あの・・・・』"
		   voices=""/>
		<msg @l="1470" char_id="-1" frame_id="-1" name="大黒"
		   text="『あぁ、君はもういい。下がってなさい。』" voices=""/>
		<msg @l="1472" char_id="-1" frame_id="-1" name="" text="そっけなく応える大黒。"
		   voices=""/>
		<msg @l="1474" char_id="-1" frame_id="-1" name="女性社員"
		   text="『は、はいっ‥‥‥申し訳ございませんでした。社長。』" voices=""/>
		<msg @l="1476" char_id="1" frame_id="1" name="玲" text="『え‥‥？』"
		   voices="rei01140"/>
		<clear @l="1482" class="all"/>
		<wait_chgmv/>
		<bg @l="1486" src="bg17m1"/>
		<char @l="1490" id="ookur" pos="center" src="ookuro010f" y="-80"/>
		<bgm @l="1493" src="bgm09" volume="1."/>
		<msg @l="1495" char_id="-1" frame_id="-1" name=""
		   text="女性は大黒に頭を下げ、その場から足早にいなくなった。" voices=""/>
		<msg @l="1497" char_id="-1" frame_id="-1" name="大黒"
		   text="『失礼致しました。さぁ、検査を続けましょう。』" voices=""/>
		<msg @l="1499" char_id="1" frame_id="1" name="玲"
		   text="『そ、それより、さっきの女性が言っていた社長っていうのは‥‥‥？』" voices=""/>
		<msg @l="1501" char_id="-1" frame_id="-1" name="大黒"
		   text="『ああ、そういえば言ってませんでしたね。』" voices=""/>
		<msg @l="1503" char_id="-1" frame_id="-1" name="大黒"
		   text="『実は親父がグループの会長なので、私が社長の職を譲り受けたのですよ。』" voices=""/>
		<msg @l="1505" char_id="1" frame_id="1" name="玲"
		   text="『え‥‥‥？大黒さん、あなた社長なんですか‥‥‥‥‥‥！？』" voices=""/>
		<msg @l="1507" char_id="-1" frame_id="-1" name="大黒" text="『そうですよ。』"
		   voices=""/>
		<msg @l="1509" char_id="-1" frame_id="-1" name="大黒"
		   text="『玲さんは運が良い。一次面接から、社長である私が面接をしてあげるのですから。』" voices=""/>
		<msg @l="1511" char_id="-1" frame_id="1" name="大黒"
		   text="（もっとも私の方が運が良いですけどね。手の届かない高嶺の花であった玲さんを自由に出来、昔の復讐が出来るのですから）"
		   voices=""/>
		<msg @l="1513" char_id="1" frame_id="1" name="玲" text="『‥‥‥‥‥‥‥。』" voices=""/>
		<msg @l="1515" char_id="-1" frame_id="-1" name="" text="玲は思わず言葉を失う。"
		   voices=""/>
		<msg @l="1516" char_id="-1" frame_id="-1" name="" text="大黒さんが社長･･････。"
		   voices=""/>
		<msg @l="1517" char_id="-1" frame_id="-1" name=""
		   text="しかも社長である大黒さんに誤解され恨まれている･･････。" voices=""/>
		<msg @l="1518" char_id="-1" frame_id="-1" name=""
		   text="このままでは内定をもらうどころか、どんな酷い扱いをされるか分からない。" voices=""/>
		<msg @l="1519" char_id="-1" frame_id="-1" name=""
		   text="早く誤解を解かないと･･････そう考えると玲はどんどん焦った。" voices=""/>
		<msg @l="1521" char_id="-1" frame_id="-1" name="大黒"
		   text="『さて‥‥そろそろ次のフロアに行きましょうか。玲さんはそのおっぱいをもっと見せびらかしていたいのでしょうが、他の検査もありますので。』"
		   voices=""/>
		<msg @l="1523" char_id="1" frame_id="1" name="玲" text="『え‥‥‥‥‥！？』" voices=""/>
		<msg @l="1525" char_id="-1" frame_id="-1" name="大黒" text="『さぁ、行きますよ。』"
		   voices=""/>
		<msg @l="1527" char_id="1" frame_id="1" name="玲"
		   text="『お、お願いです。ふ、服を変えさせてください。』" voices=""/>
		<msg @l="1529" char_id="1" frame_id="1" name="玲" text="『お願いですから‥‥‥‥‥‥。』"
		   voices=""/>
		<msg @l="1531" char_id="-1" frame_id="-1" name=""
		   text="顔を真っ赤にし、涙目になりながら懇願する玲。" voices=""/>
		<msg @l="1533" char_id="-1" frame_id="-1" name="大黒"
		   text="『あと３フロアまわれば終わります。それまで我慢しなさい。』" voices=""/>
		<msg @l="1535" char_id="1" frame_id="1" name="玲" text="『そ、そんな‥‥無理です‥‥。』"
		   voices=""/>
		<msg @l="1537" char_id="1" frame_id="1" name="玲"
		   text="『こんな姿を知らない人に見られるなんて････耐えられません。』" voices=""/>
		<msg @l="1539" char_id="-1" frame_id="-1" name="大黒"
		   text="『知らない人に見られるのが嫌なのですか？なら知っている人に見られるのは良いのですね？』" voices=""/>
		<msg @l="1541" char_id="1" frame_id="1" name="玲" text="『えっ！？』" voices=""/>
		<msg @l="1543" char_id="-1" frame_id="-1" name="大黒"
		   text="『内定を貰っている学生達が研修で上のフロアにいるのですよ。』" voices=""/>
		<msg @l="1545" char_id="1" frame_id="1" name="玲" text="（そっ、それって稲庭さん達の事！？）"
		   voices=""/>
		<msg @l="1547" char_id="-1" frame_id="-1" name="大黒"
		   text="『今からこのフロアに呼ぶので、同期になるかもしれない人達にその姿を見てもらってはどうですか？』" voices=""/>
		<msg @l="1549" char_id="1" frame_id="1" name="玲" text="『そ、そんな！？』" voices=""/>
		<msg @l="1551" char_id="-1" frame_id="-1" name="大黒"
		   text="『玲さんのその淫らな姿を見たら、どんな人でも大喜びするでしょうね。もちろん玲さんが好きな人なら、なおさらでしょうが。』"
		   voices=""/>
		<msg @l="1553" char_id="-1" frame_id="-1" name=""
		   text="もし稲庭さんを呼ばれ今の姿を見られでもしたら‥‥‥二度と顔を合わせられなくなる。そう考え玲は抵抗する力を失う。" voices=""/>
		<bgm @l="1556" src="bgm14" volume="1."/>
		<msg @l="1558" char_id="1" frame_id="1" name="玲"
		   text="『‥‥わ、わかりました。ここに置いていかないで下さい。』" voices=""/>
		<msg @l="1560" char_id="1" frame_id="1" name="玲"
		   text="『お好きなだけ検査を続けて下さい･･････。』" voices=""/>
		<msg @l="1562" char_id="-1" frame_id="-1" name="大黒"
		   text="『ふふ、最初からそういう態度でいればいいのですよ。』" voices=""/>
		<msg @l="1564" char_id="-1" frame_id="-1" name="大黒" text="『では検査を続けますよ。』"
		   voices=""/>
		<wait_chgmv/>
		<ev @l="1566" src="ev-047bx1z1"/>
		<msg @l="1568" char_id="-1" frame_id="-1" name="大黒"
		   text="『そしてこれが終わったらすぐ次の検査です。』" voices=""/>
		<msg @l="1570" char_id="1" frame_id="1" name="玲" text="『え‥‥？』"
		   voices="rei01140"/>
		<msg @l="1572" char_id="-1" frame_id="-1" name="大黒"
		   text="『まあまあ、とりあえず次のフロアをまわりましょう。ここに長くいて、もし上のフロアにいる知り合いが降りてきてその姿を見られたら嫌でしょう？』"
		   voices=""/>
		<msg @l="1574" char_id="1" frame_id="1" name="玲" text="『あっ‥‥！』"
		   voices="rei01120"/>
		<msg @l="1576" char_id="-1" frame_id="-1" name=""
		   text="大黒は話を中断し、半ば強引に玲の腕を取り歩き始める。" voices=""/>
		<wait_chgmv/>
		<ev @l="1580" src="ev-047az1"/>
		<msg @l="1582" char_id="-1" frame_id="-1" name=""
		   text="すると、ＯＬの二人が玲の姿を見てひそひそ話をしているのが聞こえてきた。" voices=""/>
		<msg @l="1584" char_id="-1" frame_id="-1" name="ＯＬ１" text="『やだぁ、なにあの子。露出狂？』"
		   voices=""/>
		<msg @l="1586" char_id="1" frame_id="1" name="玲" text="『‥‥！？』"
		   voices="rei01150"/>
		<msg @l="1588" char_id="-1" frame_id="-1" name="ＯＬ２"
		   text="『面接に来ているのに、あんな格好で来るなんて変態なんじゃない？』" voices=""/>
		<msg @l="1589" char_id="1" frame_id="1" name="玲" text="『‥‥‥‥。』"
		   voices="rei01100"/>
		<msg @l="1591" char_id="-1" frame_id="-1" name="ＯＬ１"
		   text="『違うわよー、男を漁りに来たのよ。』" voices=""/>
		<msg @l="1593" char_id="1" frame_id="1" name="玲" text="『‥‥‥っ‥‥。』"
		   voices="rei00990"/>
		<msg @l="1595" char_id="-1" frame_id="-1" name=""
		   text="玲はＯＬの話を聞き、羞恥で泣きそうになりながらも、濡れたブラウスそのままに、大黒に引っ張られていった‥‥。" voices=""/>
		<stopbgm @l="1599" fadeout="1000"/>
		<clear @l="1605" class="all"/>
		<end_scene @l="1608"/>
		<wait_chgmv/>
		<bg @l="1613" src="bg07"/>
		<msg @l="1615" char_id="-1" frame_id="-1" name="" text="その頃大学では――。"
		   voices=""/>
		<clear @l="1621" class="all"/>
		<wait_chgmv/>
		<bg @l="1625" src="bg08m2"/>
		<bgm @l="1629" src="bgm02" volume="1."/>
		<char @l="1633" id="miho" pos="auto" src="miho114"/>
		<msg @l="1635" char_id="0" frame_id="1" name="美帆" text="『‥‥あれ？』" voices=""/>
		<msg @l="1637" char_id="-1" frame_id="-1" name=""
		   text="講義が終わりノートをカバンにしまおうとした時、見慣れない紙が入っていることに気付く。" voices=""/>
		<msg @l="1638" char_id="-1" frame_id="-1" name=""
		   text="折りたたまれた紙を広げてみると、昨日リビングで拾ったあの合否通知書だった。" voices=""/>
		<msg @l="1640" char_id="0" frame_id="1" name="美帆"
		   text="『これ‥‥玲さんの合否通知書だ‥‥‥。』" voices=""/>
		<char @l="1643" id="miho" pos="auto" src="miho116"/>
		<msg @l="1645" char_id="0" frame_id="1" name="美帆"
		   text="『そっか、朝起きたら渡そうと思ってて‥‥そのまま持ってきちゃったんだ。』" voices=""/>
		<msg @l="1647" char_id="-1" frame_id="-1" name=""
		   text="間違えて持ってきてしまったものはしょうが無い。今日帰ったら玲さんに渡そう。" voices=""/>
		<msg @l="1648" char_id="-1" frame_id="-1" name=""
		   text="そう思って紙をしまおうとしたその時、その紙が二枚重ねになっていることに気付く。" voices=""/>
		<char @l="1651" id="miho" pos="auto" src="miho114"/>
		<msg @l="1653" char_id="0" frame_id="1" name="美帆" text="『あれ、もう一枚‥‥。』"
		   voices=""/>
		<stopbgm @l="1656" fadeout="1000"/>
		<msg @l="1658" char_id="0" frame_id="1" name="美帆" text="『えと‥‥合格証明書？』"
		   voices=""/>
		<msg @l="1660" char_id="-1" frame_id="-1" name=""
		   text="書面には、個人面接時の際には必ず持参するようにと書いてある。" voices=""/>
		<msg @l="1662" char_id="0" frame_id="1" name="美帆"
		   text="『これって‥‥今日の面接に必要な書類なんじゃ！？』" voices=""/>
		<char @l="1666" id="miho" pos="auto" src="miho115"/>
		<bgm @l="1668" src="bgm08" volume="1."/>
		<msg @l="1670" char_id="0" frame_id="1" name="美帆"
		   text="『私が持ってきちゃってたら‥‥‥ダメだよね‥‥‥‥。』" voices=""/>
		<msg @l="1672" char_id="-1" frame_id="-1" name=""
		   text="これが原因で玲さんが大黒建設に就職出来なかったら、大変な事である。" voices=""/>
		<msg @l="1673" char_id="-1" frame_id="-1" name=""
		   text="‥‥玲さんの夢を壊してしまうことになってしまう。" voices=""/>
		<msg @l="1674" char_id="-1" frame_id="-1" name=""
		   text="そう思うと、自分でも血の気が引いていくのがわかった。" voices=""/>
		<char @l="1678" id="miho" pos="auto" src="miho114"/>
		<msg @l="1680" char_id="0" frame_id="1" name="美帆" text="『と、とりあえず玲さんに電話‥‥。』"
		   voices=""/>
		<char @l="1683" id="miho" pos="center" src="miho116f" y="-80"/>
		<msg @l="1685" char_id="-1" frame_id="-1" name="" text="私は慌てて携帯電話で玲さんに連絡する。"
		   voices=""/>
		<msg @l="1686" char_id="-1" frame_id="-1" name=""
		   text="‥‥が、いつまでたってもコール音が鳴らない。" voices=""/>
		<msg @l="1687" char_id="-1" frame_id="-1" name="" text="やっと音が聞こえてきたかと思うと‥‥。"
		   voices=""/>
		<msg @l="1689" char_id="-1" frame_id="-1" name="アナウンス"
		   text="『‥‥現在、電波の届かないところに‥‥‥。』" voices=""/>
		<msg @l="1691" char_id="-1" frame_id="-1" name="" text="‥‥通話不能時の録音アナウンスだった。"
		   voices=""/>
		<se @l="1695" buf="1" src="携帯ボタン押下音" volume="1."/>
		<char @l="1699" id="miho" pos="center" src="miho115f" y="-80"/>
		<msg @l="1701" char_id="-1" frame_id="-1" name=""
		   text="電話を切って、ディスプレイの時計を見る。" voices=""/>
		<msg @l="1702" char_id="-1" frame_id="-1" name=""
		   text="今は面接中で電源を切ってしまっているのだろうか。" voices=""/>
		<msg @l="1704" char_id="0" frame_id="1" name="美帆" text="『‥‥どうしよう。』"
		   voices=""/>
		<msg @l="1706" char_id="-1" frame_id="-1" name=""
		   text="手に持った紙を見つめたまま、私は慌てふためいてしまった。" voices=""/>
		<msg @l="1708" char_id="0" frame_id="1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<char @l="1712" id="miho" pos="center" src="miho114f" y="-80"/>
		<msg @l="1714" char_id="0" frame_id="1" name="美帆" text="『あ、そうだ‥‥。』"
		   voices=""/>
		<msg @l="1716" char_id="0" frame_id="1" name="美帆"
		   text="『会社の方に電話して事情を説明すればわかってくれるかも。』" voices=""/>
		<char @l="1720" id="miho" pos="center" src="miho116f" y="-80"/>
		<se @l="1724" buf="1" src="携帯電話番号入力電子音" volume="1."/>
		<msg @l="1726" char_id="-1" frame_id="-1" name=""
		   text="私は手にしていた書面の一番下に書いてある大黒建設の番号を携帯電話に入力していく。" voices=""/>
		<se @l="1730" buf="3" loop="true" src="発信音" volume="1."/>
		<msg @l="1732" char_id="-1" frame_id="-1" name="" text="トゥルルルル、トゥルルルル‥‥。"
		   voices=""/>
		<msg @l="1733" char_id="-1" frame_id="-1" name=""
		   text="通話ボタンを押してすぐに呼び出し音が鳴り始める。" voices=""/>
		<stopse @l="1737" buf="3"/>
		<msg @l="1739" char_id="-1" frame_id="-1" name="受付嬢"
		   text="『はい、大黒建設南総町支社でございます。』" voices=""/>
		<char @l="1742" id="miho" pos="center" src="miho114f" y="-80"/>
		<msg @l="1744" char_id="0" frame_id="1" name="美帆" text="『あの‥‥実は‥‥‥‥。』"
		   voices=""/>
		<char @l="1747" id="miho" pos="center" src="miho115f" y="-80"/>
		<msg @l="1749" char_id="-1" frame_id="-1" name=""
		   text="私は緊張でしどろもどろになりながらも、自分がルームメイトで、間違って玲さんの合格証明書を持ってきてしまった事を説明する。"
		   voices=""/>
		<msg @l="1751" char_id="-1" frame_id="-1" name=""
		   text="受付のお姉さんはそれを黙って聞いた後、確認しますのでお待ちくださいと言って電話を保留にした。" voices=""/>
		<se @l="1755" buf="3" loop="true" src="保留音" volume="1."/>
		<char @l="1758" id="miho" pos="center" src="miho015f" y="-80"/>
		<msg @l="1760" char_id="0" frame_id="1" name="美帆" text="『‥‥‥‥‥。』" voices=""/>
		<msg @l="1762" char_id="-1" frame_id="-1" name=""
		   text="慌てているからだろうか、この僅かな待ち時間が妙に長く感じられた。" voices=""/>
		<msg @l="1763" char_id="-1" frame_id="-1" name=""
		   text="電話の向こうではどんな話になっているのだろう。" voices=""/>
		<msg @l="1764" char_id="-1" frame_id="-1" name=""
		   text="玲さんの面接に影響は出ていないだろうか、会社は事情を分かってくれるだろうか‥‥。そんな事ばかりが、ぐるぐると頭の中を巡ってしまう。"
		   voices=""/>
		<stopse @l="1768" buf="3"/>
		<msg @l="1770" char_id="-1" frame_id="-1" name="受付嬢" text="『お待たせ致しました。』"
		   voices=""/>
		<char @l="1773" id="miho" pos="center" src="miho114f" y="-80"/>
		<msg @l="1775" char_id="0" frame_id="1" name="美帆" text="『あ、はい‥‥。』" voices=""/>
		<msg @l="1777" char_id="-1" frame_id="-1" name="受付嬢"
		   text="『白石様の面接につきましては確認が取れましたが、やはり書類の方をご持参戴かないと正規な手続きが取れないようです。』"
		   voices=""/>
		<char @l="1780" id="miho" pos="center" src="miho115f" y="-80"/>
		<msg @l="1782" char_id="0" frame_id="1" name="美帆"
		   text="『もしかして、この書類がないと面接自体が受けられなかったりするんですか？』" voices=""/>
		<msg @l="1784" char_id="-1" frame_id="-1" name="受付嬢"
		   text="『そちらの書類はお帰りの際にお預かり致しますので、面接自体は行われます。』" voices=""/>
		<stopbgm @l="1787" fadeout="1000"/>
		<char @l="1789" id="miho" pos="center" src="miho111f" y="-80"/>
		<msg @l="1791" char_id="0" frame_id="1" name="美帆" text="『そうですか‥‥。』"
		   voices=""/>
		<char @l="1794" id="miho" pos="center" src="miho110f" y="-80"/>
		<msg @l="1796" char_id="-1" frame_id="-1" name="" text="その言葉を聞き、私はほっとした。"
		   voices=""/>
		<msg @l="1797" char_id="-1" frame_id="-1" name=""
		   text="そしてすぐに「書類を届ける」ことにした。" voices=""/>
		<msg @l="1798" char_id="-1" frame_id="-1" name=""
		   text="今向かうと、次の講義は欠席する事になるが、そんな事よりも玲さんの面接の方が大事だ。" voices=""/>
		<char @l="1801" id="miho" pos="center" src="miho116f" y="-80"/>
		<msg @l="1803" char_id="0" frame_id="1" name="美帆"
		   text="『すぐに、そちらに届けさせて頂きます。』" voices=""/>
		<msg @l="1805" char_id="-1" frame_id="-1" name="受付嬢"
		   text="『わかりました、お名前を伺ってよろしいですか？』" voices=""/>
		<char @l="1808" id="miho" pos="center" src="miho114f" y="-80"/>
		<msg @l="1810" char_id="0" frame_id="1" name="美帆" text="『あ、はい‥‥仲根といいます。』"
		   voices=""/>
		<msg @l="1812" char_id="-1" frame_id="-1" name="受付嬢"
		   text="『仲根様でございますね、お待ちしております。』" voices=""/>
		<se @l="1816" buf="1" src="携帯ボタン押下音" volume="1."/>
		<bgm @l="1819" src="bgm02" volume="1."/>
		<clear @l="1821" class="char"/>
		<char @l="1824" id="miho" pos="auto" src="miho116"/>
		<msg @l="1826" char_id="0" frame_id="1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="1828" char_id="0" frame_id="1" name="美帆"
		   text="『‥‥はあ、なんか大変なコトになっちゃったな。』" voices=""/>
		<msg @l="1830" char_id="-1" frame_id="-1" name=""
		   text="そうして私はもう一度ため息を吐いた後、荷物を持って早足で停留所へと向かった。" voices=""/>
		<stopbgm @l="1832" fadeout="1000"/>
		<clear @l="1838" class="all"/>
		<wait_chgmv/>
		<bg @l="1842" src="bg18m1"/>
		<char @l="1846" id="miho" pos="auto" src="miho126"/>
		<msg @l="1848" char_id="0" frame_id="1" name="美帆" text="(えっと‥‥)" voices=""/>
		<msg @l="1850" char_id="-1" frame_id="-1" name=""
		   text="大黒建設のビルを目指して急ぎオフィス街へ向かう。" voices=""/>
		<clear @l="1856" class="all"/>
		<wait_chgmv/>
		<bg @l="1860" src="bg16"/>
		<msg @l="1862" char_id="0" frame_id="1" name="美帆" text="(あった‥‥大黒建設)"
		   voices=""/>
		<char @l="1866" id="miho" pos="auto" src="miho024"/>
		<msg @l="1868" char_id="-1" frame_id="-1" name=""
		   text="私は大黒建設のビル前に立って、建物を見上げた。" voices=""/>
		<msg @l="1869" char_id="-1" frame_id="-1" name="" text="何階建てだろう‥‥ものすごく大きい。"
		   voices=""/>
		<char @l="1873" id="miho" pos="auto" src="miho124"/>
		<msg @l="1875" char_id="0" frame_id="1" name="美帆" text="(‥‥と、はやく渡しに行かないと)"
		   voices=""/>
		<clear @l="1881" class="all"/>
		<bgm @l="1884" src="bgm14" volume="1."/>
		<se @l="1887" buf="1" src="自動ドアの音" volume="1."/>
		<msg @l="1889" char_id="-1" frame_id="-1" name="" text="入り口を入ってすぐ、受付に歩み寄る。"
		   voices=""/>
		<msg @l="1891" char_id="0" frame_id="1" name="美帆"
		   text="『あの、先ほどお電話しました仲根ですけど‥‥。』" voices=""/>
		<msg @l="1893" char_id="-1" frame_id="-1" name="受付嬢"
		   text="『はい‥‥仲根様ですね‥‥‥‥‥。』" voices=""/>
		<msg @l="1895" char_id="-1" frame_id="-1" name=""
		   text="受付のお姉さんは来客表を見て確認している。" voices=""/>
		<msg @l="1897" char_id="-1" frame_id="-1" name="受付嬢" text="『承っております。』"
		   voices=""/>
		<msg @l="1899" char_id="-1" frame_id="-1" name="受付嬢"
		   text="『担当の者が直接受け取りたいとの事ですので、そちらまでご案内いたします。』" voices=""/>
		<msg @l="1901" char_id="0" frame_id="1" name="美帆" text="『は、はい‥‥。』" voices=""/>
		<msg @l="1903" char_id="0" frame_id="1" name="美帆" text="(間に合って良かった‥‥‥)"
		   voices=""/>
		<msg @l="1905" char_id="-1" frame_id="-1" name="受付嬢" text="『こちらへどうぞ。』"
		   voices=""/>
		<msg @l="1907" char_id="0" frame_id="1" name="美帆" text="『あ、はいっ‥‥。』"
		   voices=""/>
		<msg @l="1909" char_id="0" frame_id="1" name="美帆"
		   text="(玲さん‥‥面接うまくいっているといいな)" voices=""/>
		<clear @l="1915" class="all"/>
		<wait_chgmv/>
		<bg @l="1919" src="bg17m1"/>
		<char @l="1922" id="miho" pos="auto" src="miho120"/>
		<msg @l="1924" char_id="0" frame_id="1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="1926" char_id="-1" frame_id="-1" name=""
		   text="エレベータで７階まであがり、オフィスの一角に案内された。" voices=""/>
		<msg @l="1927" char_id="-1" frame_id="-1" name=""
		   text="当然ながら周囲には社員の人々がいて、忙しそうに働いていた。" voices=""/>
		<msg @l="1929" char_id="-1" frame_id="-1" name="受付嬢"
		   text="『こちらの部屋でお待ちください。』" voices=""/>
		<char @l="1932" id="miho" pos="auto" src="miho026"/>
		<msg @l="1933" char_id="0" frame_id="1" name="美帆" text="『わかりました。』" voices=""/>
		<clear @l="1937" class="char"/>
		<clear @l="1943" class="all"/>
		<msg @l="1945" char_id="0" frame_id="1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="1947" char_id="-1" frame_id="-1" name=""
		   text="入った部屋は、妙に奥行きのある長細い部屋だった。" voices=""/>
		<msg @l="1948" char_id="-1" frame_id="-1" name=""
		   text="おまけに片側の壁は一面に大きな鏡が張ってあって、落ち着かない。" voices=""/>
		<msg @l="1950" char_id="0" frame_id="1" name="美帆" text="(なんか変な部屋‥‥)"
		   voices=""/>
		<msg @l="1952" char_id="-1" frame_id="-1" name="" text="とりあえず椅子に座って待つことにした。"
		   voices=""/>
		<stopbgm @l="1956" fadeout="1000"/>
		<clear @l="1962" class="all"/>
		<msgshow @l="1964" show="true"/>
		<wait_chgmv/>
		<bg @l="1968" src="bg17m1"/>
		<bgm @l="1972" src="bgm09" volume="1."/>
		<char @l="1976" id="ookur" pos="auto" src="ookuro010"/>
		<msg @l="1978" char_id="-1" frame_id="-1" name="大黒"
		   text="『ほう‥‥あれがキミの言っていた子だね。』" voices=""/>
		<msg @l="1980" char_id="-1" frame_id="-1" name="大黒"
		   text="『玲さんとタイプは違うが、かわいい子ではないか。』" voices=""/>
		<msg @l="1982" char_id="-1" frame_id="-1" name=""
		   text="オフィスの隅で、大黒と受付嬢が話をしていた。" voices=""/>
		<msg @l="1983" char_id="-1" frame_id="-1" name=""
		   text="大黒の前にはパソコンが一台あり、モニタには部屋の中でちょこんと座っている美帆の姿が表示されていた。" voices=""/>
		<msg @l="1985" char_id="-1" frame_id="-1" name="受付嬢"
		   text="『ご指示の通り、まだ書類は受け取っておりません。』" voices=""/>
		<msg @l="1987" char_id="-1" frame_id="-1" name="大黒"
		   text="『ああ、あの子には悪いがしばらくあの部屋で待っていてもらうことにする。玲さんの面接に使えそうだからね。』" voices=""/>
		<msg @l="1989" char_id="-1" frame_id="-1" name="大黒"
		   text="『キミは飲み物でも出しておいてくれたまえ。』" voices=""/>
		<msg @l="1991" char_id="-1" frame_id="-1" name="受付嬢" text="『かしこまりました。』"
		   voices=""/>
		<stopbgm @l="1994" fadeout="1000"/>
		<clear @l="1996" class="char"/>
		<char @l="1998" id="ookur" pos="center" src="ookuro010f" y="-80"/>
		<msg @l="2000" char_id="-1" frame_id="1" name="大黒"
		   text="（しかし、玲さんのルームメイトか‥‥‥‥。いい所に来てくれた）" voices=""/>
		<msg @l="2002" char_id="-1" frame_id="1" name="大黒"
		   text="（玲さんに、たとえ身体を汚されても、我が社に入りたいという気持ちにさせるには、もうひとつ材料が足らなかったのだ）" voices=""/>
		<msg @l="2004" char_id="-1" frame_id="1" name="大黒"
		   text="（玲さんを辱められるのなら、使えるものは何でも使いますよ）" voices=""/>
		<msg @l="2006" char_id="-1" frame_id="-1" name="受付嬢"
		   text="『では、私は飲み物の用意をして参ります。』" voices=""/>
		<bgm @l="2009" src="bgm09" volume="1."/>
		<clear @l="2011" class="char"/>
		<char @l="2013" id="ookur" pos="auto" src="ookuro010"/>
		<msg @l="2015" char_id="-1" frame_id="-1" name="大黒" text="『上手くやれよ。』"
		   voices=""/>
		<msg @l="2017" char_id="-1" frame_id="-1" name=""
		   text="大黒は下品な笑みを浮かべて、下がろうとする受付嬢のお尻を撫でた。" voices=""/>
		<msg @l="2018" char_id="-1" frame_id="-1" name=""
		   text="受付嬢はそれに表情ひとつ変えず、給湯室へと向かっていった。" voices=""/>
		<msg @l="2020" char_id="-1" frame_id="-1" name="大黒"
		   text="『ふん、忠実なのは悪くないが少々面白みに欠けるな。』" voices=""/>
		<msg @l="2022" char_id="-1" frame_id="-1" name="高橋"
		   text="『社長‥‥お客様がいらっしゃいました。』" voices=""/>
		<msg @l="2024" char_id="-1" frame_id="-1" name="大黒"
		   text="『よーし、それじゃあ玲さんを呼んできてくれ。次の検査を始めようじゃないか。』" voices=""/>
		<msg @l="2026" char_id="-1" frame_id="-1" name="高橋" text="『畏まりました。』"
		   voices=""/>
		<clear @l="2032" class="all"/>
		<msg @l="2035" char_id="-1" frame_id="-1" name="大黒"
		   text="『やあ、玲さん‥‥準備ができたようですね？』" voices=""/>
		<msg @l="2037" char_id="-1" frame_id="-1" name="" text="応接室に、大黒が入ってきた。"
		   voices=""/>
		<msg @l="2038" char_id="-1" frame_id="-1" name=""
		   text="部屋の中にはスーツに着替える事を許された玲がソファに座っていた。" voices=""/>
		<msg @l="2040" char_id="-1" frame_id="-1" name=""
		   text="今日は検査が終わるまでブラウス姿でいさせられると思っていたのだが･･････。" voices=""/>
		<clear @l="2046" class="all"/>
		<msgshow @l="2048" show="true"/>
		<wait_chgmv/>
		<bg @l="2050" src="bg17m1"/>
		<msg @l="2052" char_id="-1" frame_id="-1" name="大黒"
		   text="『次の検査では元のリクルートスーツに着替えて、下着も着けていただいて良いですよ。』" voices=""/>
		<msg @l="2054" char_id="1" frame_id="1" name="玲"
		   text="『え‥‥本当ですか！？‥‥‥、あっ、有難うございます。』" voices=""/>
		<msg @l="2056" char_id="-1" frame_id="-1" name=""
		   text="裸にでもされるかと思っていたのだが、予想もしない大黒の言葉に少し安心する。" voices=""/>
		<msg @l="2057" char_id="-1" frame_id="-1" name=""
		   text="しかし安堵したのも束の間それが勘違いだった事をすぐに思い知らされた。" voices=""/>
		<msg @l="2059" char_id="-1" frame_id="-1" name="大黒"
		   text="『何せ、相手方はリクルートスーツがお好みらしいのでね。』" voices=""/>
		<msg @l="2061" char_id="1" frame_id="1" name="玲"
		   text="『えっ！？それってどういう意味ですか‥‥！？』" voices=""/>
		<msg @l="2063" char_id="-1" frame_id="-1" name="大黒" text="『すぐに分かりますよ。』"
		   voices=""/>
		<clear @l="2069" class="all"/>
		<msgshow @l="2071" show="true"/>
		<msg @l="2074" char_id="1" frame_id="1" name="玲" text="『‥‥‥‥。』" voices=""/>
		<msg @l="2076" char_id="1" frame_id="1" name="玲"
		   text="『あの‥‥次はどんな検査をするのですか？』" voices=""/>
		<msg @l="2078" char_id="-1" frame_id="-1" name="大黒" text="『接待ですよ、接待。』"
		   voices=""/>
		<msg @l="2080" char_id="1" frame_id="1" name="玲"
		   text="『接待‥？接待ってどういうことでしょうか？』" voices=""/>
		<msg @l="2082" char_id="-1" frame_id="-1" name="大黒"
		   text="『ああ、そういえば接待の内容を言っていませんでしたね。』" voices=""/>
		<msg @l="2084" char_id="-1" frame_id="-1" name=""
		   text="説明をしてないのを分かっていながら、大黒はわざとらしく言う。" voices=""/>
		<msg @l="2086" char_id="-1" frame_id="-1" name="大黒"
		   text="『今回の接待は実際の取引の場を用いて行います。ぜひとも交渉が成功するように良い接待をしてください。』" voices=""/>
		<msg @l="2088" char_id="1" frame_id="1" name="玲" text="『えっ‥‥そんな、無理ですっ！』"
		   voices=""/>
		<msg @l="2090" char_id="-1" frame_id="-1" name="大黒"
		   text="『いいですか玲さん。今までの検査結果が悪いので本来であれば次の検査に進めないのですよ。』" voices=""/>
		<msg @l="2092" char_id="-1" frame_id="-1" name="大黒"
		   text="『ですが、同級生のよしみで、もう一度だけチャンスをあげようと気を遣ってあげているのにその態度は何ですか！』" voices=""/>
		<msg @l="2094" char_id="1" frame_id="1" name="玲"
		   text="『でも、私、接待なんてしたことないのに‥‥‥‥‥。』" voices=""/>
		<msg @l="2096" char_id="-1" frame_id="-1" name="大黒"
		   text="『ふふふ‥‥‥安心してください、玲さん一人に交渉役をお任せさせるわけではありません。』" voices=""/>
		<msg @l="2098" char_id="1" frame_id="1" name="玲"
		   text="『そ、そうなんですか‥‥‥。良かった‥‥‥‥。』" voices=""/>
		<msg @l="2100" char_id="-1" frame_id="-1" name="" text="大黒の言葉を聞き、少しほっとする。"
		   voices=""/>
		<msg @l="2102" char_id="1" frame_id="1" name="玲"
		   text="『でも‥‥‥‥それじゃあ、私は何をすればいいんですか？』" voices=""/>
		<msg @l="2104" char_id="-1" frame_id="-1" name="大黒"
		   text="『玲さんにしか出来ない事をして、取引相手を喜ばせてあげるのですよ。』" voices=""/>
		<msg @l="2106" char_id="1" frame_id="1" name="玲" text="『え‥‥‥‥！？』" voices=""/>
		<msg @l="2108" char_id="-1" frame_id="-1" name="大黒"
		   text="『いいですか。どんなことがあっても絶対に拒んではいけません。接待が終わるまで従順でいるように‥‥‥‥‥検査に合格したければね。』"
		   voices=""/>
		<msg @l="2110" char_id="-1" frame_id="-1" name=""
		   text="そうして大黒はニヤリといやらしい笑みを浮かべた。" voices=""/>
		<stopbgm @l="2113" fadeout="1000"/>
		<clear @l="2119" class="all"/>
		<label @l="2122" id="event_scene41"/>
		<label @l="2126" id="chart_line27"/>
		<bgm @l="2129" src="bgm15" volume="1."/>
		<wait_chgmv/>
		<ev @l="2133" src="ev-041x1"/>
		<description @l="2136" text="一次面接Ｃ"/>
		<msg @l="2138" char_id="-1" frame_id="-1" name="建築デザイナー"
		   text="『いやあ、まさか本当にリクルートスーツ姿の娘を用意してもらえるとは思ってもいませんでしたなあ。』" voices=""/>
		<msg @l="2140" char_id="-1" frame_id="-1" name="大黒"
		   text="『いえいえ、あなたのような建築デザイナーにマンションのデザインをして頂けるのであれば、何でも叶えさせて頂きますよ。』"
		   voices=""/>
		<msg @l="2142" char_id="-1" frame_id="-1" name="建築デザイナー"
		   text="『ここまでして頂けるのであれば、私も頑張りましょう。』" voices=""/>
		<msg @l="2144" char_id="1" frame_id="1" name="玲" text="『‥‥‥‥。』"
		   voices="rei01180"/>
		<msg @l="2146" char_id="-1" frame_id="-1" name=""
		   text="二人が談笑する中、取引相手である建築デザイナーと大黒に挟まれる形で、玲はこの理不尽な状況を耐えていた。" voices=""/>
		<msg @l="2147" char_id="-1" frame_id="-1" name="" text="それもそのハズである。"
		   voices=""/>
		<msg @l="2148" char_id="-1" frame_id="-1" name=""
		   text="交渉に来た建築デザイナーは仕事の話をしながら、いきなりスーツの胸元に手をいれて胸を揉んでくる。" voices=""/>
		<msg @l="2149" char_id="-1" frame_id="-1" name=""
		   text="大黒に至っては玲に自分のものをしごかせ、太腿を撫でまわしていた。" voices=""/>
		<msg @l="2151" char_id="-1" frame_id="-1" name="建築デザイナー"
		   text="『それで、壁に使う素材はすべすべした感触の物を使いたいのですが‥‥‥。』" voices=""/>
		<msg @l="2153" char_id="-1" frame_id="-1" name="大黒"
		   text="『なるほど。では、この太腿のような、きめ細かい感じではどうでしょうか？』" voices=""/>
		<msg @l="2155" char_id="-1" frame_id="-1" name=""
		   text="そう言いながら、大黒はむき出しにされた玲の白い太腿を、撫でてくる。" voices=""/>
		<msg @l="2157" char_id="-1" frame_id="-1" name="" text="さわっ、さわっ" voices=""/>
		<msg @l="2159" char_id="-1" frame_id="-1" name="建築デザイナー"
		   text="『いいですね。では、リビングの電球の大きさは、このおっぱいくらいの大きさにしましょう。』" voices=""/>
		<msg @l="2161" char_id="-1" frame_id="-1" name=""
		   text="建築デザイナーは、鼻の下を伸ばしながら玲の乳房を揉みしだく。" voices=""/>
		<msg @l="2163" char_id="-1" frame_id="-1" name="" text="もみゅ、もみゅ" voices=""/>
		<msg @l="2165" char_id="-1" frame_id="-1" name="大黒"
		   text="『それだけ大きい電球であれば、部屋の中はさぞかし明るくなりますね。』" voices=""/>
		<msg @l="2167" char_id="-1" frame_id="-1" name="建築デザイナー" text="『もちろんですよ。』"
		   voices=""/>
		<msg @l="2169" char_id="-1" frame_id="-1" name=""
		   text="そう言って、二人は笑いながら玲の身体を貪っていた。" voices=""/>
		<msg @l="2171" char_id="1" frame_id="1" name="玲" text="『‥‥‥‥。』"
		   voices="rei01180"/>
		<msg @l="2173" char_id="-1" frame_id="-1" name=""
		   text="玲は知らない人にまで身体を嬲られ、恥ずかしさと辛さで泣きそうになった。" voices=""/>
		<msg @l="2174" char_id="1" frame_id="1" name="玲"
		   text="（どうして‥‥‥、どうして、こんな事までしなければならないの）" voices=""/>
		<msg @l="2176" char_id="1" frame_id="1" name="玲"
		   text="（稲庭さんと一緒の会社に入る為に、絶対に内定は欲しいけど‥‥‥）" voices=""/>
		<msg @l="2178" char_id="1" frame_id="1" name="玲"
		   text="（でも‥‥‥、稲庭さん以外の人に身体を触られるのはもう嫌‥‥‥）" voices=""/>
		<msg @l="2180" char_id="1" frame_id="1" name="玲"
		   text="（さっき、胸を触られたときはまだ服の上からだったけど‥‥‥）" voices=""/>
		<msg @l="2182" char_id="1" frame_id="1" name="玲"
		   text="（今は直に揉まれて、挙句の果てには男の人のものを握らされるなんて‥‥‥）" voices=""/>
		<msg @l="2183" char_id="-1" frame_id="-1" name="大黒"
		   text="『どうしました玲さん。こういう席では笑顔が基本ですよ？』" voices=""/>
		<msg @l="2185" char_id="-1" frame_id="-1" name=""
		   text="この理不尽な状況に我慢の限界を感じていた玲に、大黒が追い討ちをかけるように言った。" voices=""/>
		<msg @l="2187" char_id="1" frame_id="1" name="玲" text="『‥‥‥‥。』"
		   voices="rei01190"/>
		<msg @l="2189" char_id="-1" frame_id="-1" name=""
		   text="黙っている玲を見て、建築デザイナーが大黒に言葉をかける。" voices=""/>
		<msg @l="2191" char_id="-1" frame_id="-1" name="建築デザイナー"
		   text="『大黒さん、もしかして水周りの話題が出ていないのがお気に召さないのではないですか？』" voices=""/>
		<msg @l="2193" char_id="-1" frame_id="-1" name="大黒"
		   text="『水周りですか‥‥‥‥。あぁ！なるほど。確かに家の中で一番大事な水周りを忘れるところでした。』" voices=""/>
		<msg @l="2195" char_id="-1" frame_id="-1" name=""
		   text="大黒は、建築デザイナーの言葉を理解するといやらしい目つきで玲を見た。" voices=""/>
		<msg @l="2197" char_id="1" frame_id="1" name="玲" text="『え‥‥？』"
		   voices="rei01140"/>
		<msg @l="2199" char_id="-1" frame_id="-1" name=""
		   text="次の瞬間、大黒は太腿を撫でていた手を、秘部へ這わせた。" voices=""/>
		<msg @l="2201" char_id="1" frame_id="1" name="玲" text="『‥‥‥っ‥‥。』"
		   voices="rei00990"/>
		<msg @l="2203" char_id="-1" frame_id="-1" name=""
		   text="秘部を触られた玲は、我慢の限界に達した。" voices=""/>
		<msg @l="2205" char_id="1" frame_id="1" name="玲"
		   text="（こんな風俗嬢みたいな事をされる位なら、内定なんかいらない‥‥‥）" voices=""/>
		<msg @l="2207" char_id="-1" frame_id="-1" name=""
		   text="そう思って、立ち上がろうとしたその瞬間――。" voices=""/>
		<stopbgm @l="2210" fadeout="1000"/>
		<msg @l="2212" char_id="-1" frame_id="-1" name="大黒"
		   text="『まだ笑顔で接待が出来ませんか。仕方ありませんねぇ‥‥。』" voices=""/>
		<msg @l="2214" char_id="1" frame_id="1" name="玲" text="『‥‥？』"
		   voices="rei01060"/>
		<msg @l="2216" char_id="-1" frame_id="-1" name=""
		   text="そう言って、大黒がポケットの中から小さなリモコンを取り出した。" voices=""/>
		<msg @l="2218" char_id="-1" frame_id="-1" name="大黒"
		   text="『いいものを見せてあげますよ、玲さん。』" voices=""/>
		<msg @l="2220" char_id="1" frame_id="1" name="玲" text="『え‥‥？』"
		   voices="rei01140"/>
		<msg @l="2222" char_id="-1" frame_id="-1" name="建築デザイナー"
		   text="『どうしました、大黒さん？』" voices=""/>
		<bgm @l="2225" src="bgm09" volume="1."/>
		<msg @l="2227" char_id="-1" frame_id="-1" name="大黒"
		   text="『実はいま、こちらのお嬢さんは採用試験の途中でしてね。』" voices=""/>
		<msg @l="2229" char_id="-1" frame_id="-1" name="建築デザイナー" text="『ほう？』"
		   voices=""/>
		<msg @l="2231" char_id="-1" frame_id="-1" name="大黒"
		   text="『今年は有望な候補者２名の中から選ぼうかと思っているのですよ。』" voices=""/>
		<msg @l="2233" char_id="1" frame_id="1" name="玲" text="『‥‥！？』"
		   voices="rei01150"/>
		<msg @l="2235" char_id="1" frame_id="1" name="玲"
		   text="（２名！？‥‥‥ということは、最終選考まできているの？）" voices=""/>
		<msg @l="2237" char_id="1" frame_id="1" name="玲"
		   text="（もしかして、あと少し頑張れば稲庭さんと同じ会社に‥‥‥）" voices=""/>
		<msg @l="2239" char_id="-1" frame_id="-1" name="建築デザイナー"
		   text="『ほうほう、２人‥‥‥ですか。』" voices=""/>
		<msg @l="2241" char_id="-1" frame_id="-1" name="大黒"
		   text="『折角ですから‥‥隣の部屋に待機させているもう一人の候補者と、こちらのお嬢さんを見比べて、デザイナーとしての立場からどちらの子がいいかおっしゃって下さい。』"
		   voices=""/>
		<msg @l="2243" char_id="1" frame_id="1" name="玲" text="『えっ‥‥そんな、見比べるって。』"
		   voices="rei01210"/>
		<msg @l="2245" char_id="-1" frame_id="-1" name="大黒"
		   text="『デザインに一番重要なのは見た目です。他のことは特に関係ありませんね。』" voices=""/>
		<msg @l="2246" char_id="1" frame_id="1" name="玲" text="『か、関係ないって‥‥。』"
		   voices="rei01240"/>
		<msg @l="2248" char_id="-1" frame_id="-1" name="大黒"
		   text="『それに、玲さんは今、接待をする立場であって意見を言う立場ではないでしょう。』" voices=""/>
		<msg @l="2250" char_id="1" frame_id="1" name="玲" text="『‥‥‥‥。』"
		   voices="rei01250"/>
		<msg @l="2252" char_id="-1" frame_id="-1" name="大黒"
		   text="『ふふ、ではもう一人の子を見ていただきましょう。』" voices=""/>
		<stopbgm @l="2255" fadeout="1000"/>
		<clear @l="2261" class="all"/>
		<msg @l="2263" char_id="-1" frame_id="-1" name=""
		   text="そうして大黒は手にしていたリモコンを操作する。" voices=""/>
		<msg @l="2264" char_id="-1" frame_id="-1" name=""
		   text="すると‥‥ブラインドが音を立ててあがっていった。" voices=""/>
		<msg @l="2265" char_id="-1" frame_id="-1" name=""
		   text="その壁は一面ガラスに張りになっていて、隣の部屋が丸見えになっていた。" voices=""/>
		<bgm @l="2268" src="bgm15" volume="1."/>
		<msg @l="2270" char_id="1" frame_id="1" name="玲" text="『え‥‥美帆っ！？』"
		   voices="rei01260"/>
		<msg @l="2272" char_id="-1" frame_id="-1" name="" text="その部屋には‥‥美帆が座っていた。"
		   voices=""/>
		<msg @l="2274" char_id="1" frame_id="1" name="玲" text="『どうして‥‥？』"
		   voices="rei01270"/>
		<msg @l="2276" char_id="-1" frame_id="-1" name="" text="しかし美帆はこちらに気づく様子もない。"
		   voices=""/>
		<msg @l="2278" char_id="-1" frame_id="-1" name="大黒"
		   text="『このガラスはマジックミラーになっていましてね、向こうの部屋からはこちら側が見えないのですよ。』" voices=""/>
		<msg @l="2280" char_id="-1" frame_id="-1" name="建築デザイナー"
		   text="『おお、なかなか可愛らしいね。』" voices=""/>
		<msg @l="2282" char_id="-1" frame_id="-1" name="大黒" text="『比べてみて如何でしょうか？』"
		   voices=""/>
		<msg @l="2284" char_id="-1" frame_id="-1" name="建築デザイナー"
		   text="『いいですね、素材的には最高だ。』" voices=""/>
		<msg @l="2286" char_id="1" frame_id="1" name="玲" text="『‥‥‥‥。』"
		   voices="rei01280"/>
		<msg @l="2288" char_id="-1" frame_id="-1" name="大黒"
		   text="『なるほど、という事は玲さんよりも彼女の方が良いと言うことですか？』" voices=""/>
		<msg @l="2290" char_id="1" frame_id="1" name="玲" text="『‥‥‥っ‥‥。』"
		   voices="rei00990"/>
		<wait_chgmv/>
		<ev @l="2293" src="ev-041x1"/>
		<msg @l="2295" char_id="-1" frame_id="-1" name="大黒"
		   text="『さて‥‥どうしますか玲さん？最後の２名に選ばれたのに、このままですと残念ながら、内定を取れませんよ。』" voices=""/>
		<msg @l="2297" char_id="-1" frame_id="-1" name="" text="玲の中で、色々な感情が渦巻く。"
		   voices=""/>
		<msg @l="2298" char_id="-1" frame_id="-1" name="" text="どうして美帆がこんな所にいるの？"
		   voices=""/>
		<msg @l="2299" char_id="-1" frame_id="-1" name=""
		   text="美帆が大黒建設の最終選考に残っているってどういう事････？" voices=""/>
		<msg @l="2301" char_id="-1" frame_id="-1" name="大黒"
		   text="『どうしました？もっと自分をアピールしなくて良いのですか？それとも諦めますか？』" voices=""/>
		<msg @l="2303" char_id="1" frame_id="1" name="玲" text="『‥‥‥‥。』"
		   voices="rei01290"/>
		<msg @l="2305" char_id="-1" frame_id="-1" name=""
		   text="とにかく今は大黒達を満足させ、試験に落とされないようにしなければならない。美帆の事を確かめるのはその後････。" voices=""/>
		<msg @l="2306" char_id="-1" frame_id="-1" name=""
		   text="とにかく稲庭さんと一緒の会社に行けるように、今は我慢しよう。" voices=""/>
		<msg @l="2307" char_id="-1" frame_id="-1" name=""
		   text="ここまで我慢をしたのに、ここで諦めては、全てが無駄になってしまう。" voices=""/>
		<msg @l="2308" char_id="-1" frame_id="-1" name="" text="玲は決心した‥‥‥‥。"
		   voices=""/>
		<bgm @l="2311" src="bgm14" volume="1."/>
		<wait_chgmv/>
		<ev @l="2314" src="ev-041"/>
		<msg @l="2316" char_id="-1" frame_id="-1" name=""
		   text="玲の顔にぎこちない笑みが浮かぶ。それは紛れも無い営業スマイルだった。" voices=""/>
		<msg @l="2318" char_id="1" frame_id="1" name="玲"
		   text="『あの‥‥お取引の続き、なさってはどうですか？』" voices="rei01300"/>
		<msg @l="2320" char_id="-1" frame_id="-1" name="" text="僅かに震えた声で玲が言う。"
		   voices=""/>
		<msg @l="2321" char_id="-1" frame_id="-1" name=""
		   text="そうして、玲は大黒の肉棒に指を絡めて強弱をつけて擦り上げ始めた。その肉棒の扱い方は、先ほどの嫌々ながらの感じとはまるで違っていた。"
		   voices=""/>
		<msg @l="2322" char_id="-1" frame_id="-1" name=""
		   text="そんな玲を見て、二人は顔を見合わせニヤリと笑う。" voices=""/>
		<msg @l="2324" char_id="-1" frame_id="-1" name="大黒"
		   text="『ふふふ‥‥‥‥。では続けましょうか。』" voices=""/>
		<msg @l="2326" char_id="-1" frame_id="-1" name="建築デザイナー"
		   text="『そうですね、大黒さん‥‥‥‥。』" voices=""/>
		<wait_chgmv/>
		<ev @l="2329" src="ev-041x1"/>
		<msg @l="2331" char_id="-1" frame_id="-1" name="大黒"
		   text="『やはり、水周りはしっかりしないといけませんからね。水の出が悪いとお住まいになる方が大変ですので、しっかりと出るかどうか確認しないと。』"
		   voices=""/>
		<msg @l="2333" char_id="-1" frame_id="-1" name=""
		   text="そう言って、玲の秘部を下着越しに弄り続ける。" voices=""/>
		<msg @l="2335" char_id="-1" frame_id="-1" name="建築デザイナー"
		   text="『確かに水周りも大切ですが、このおっぱいがリクルートスーツからはみ出しているように、リビングの電球をむき出しにするのも重要だと思いますね。』"
		   voices=""/>
		<msg @l="2337" char_id="-1" frame_id="-1" name=""
		   text="建築デザイナーも、大黒に負けじと玲の胸が歪むくらい強く揉む。" voices=""/>
		<msg @l="2339" char_id="1" frame_id="1" name="玲" text="『‥‥‥っ‥‥。』"
		   voices="rei00990"/>
		<msg @l="2341" char_id="-1" frame_id="-1" name=""
		   text="あまりにも強く揉まれた為、白い胸は赤く腫れてしまう。" voices=""/>
		<msg @l="2342" char_id="-1" frame_id="-1" name=""
		   text="それでも、玲は自ら胸を突き出し、手では大黒のモノを熱心にしごき続けるのだった。" voices=""/>
		<stopbgm @l="2345" fadeout="1000"/>
		<clear @l="2351" class="all"/>
		<end_scene @l="2354"/>
		<bgm @l="2357" src="bgm09" volume="1."/>
		<wait_chgmv/>
		<bg @l="2360" src="bg17m1"/>
		<char @l="2364" id="ookur" pos="auto" src="ookuro010"/>
		<description @l="2367" text="ルームメイトの憂鬱・２日目"/>
		<msg @l="2369" char_id="-1" frame_id="-1" name="大黒" text="『本日はありがとうございました。』"
		   voices=""/>
		<msg @l="2371" char_id="-1" frame_id="-1" name="建築デザイナー"
		   text="『いえ、こちらこそ良いデザイン案が浮かび、充実した打ち合わせになりました。』" voices=""/>
		<msg @l="2373" char_id="-1" frame_id="-1" name=""
		   text="打ち合わせが終わり、大黒と建築デザイナーが話をしていた。" voices=""/>
		<msg @l="2375" char_id="-1" frame_id="-1" name="建築デザイナー"
		   text="『それでは私はこの辺で。後ほどデザイン案を送らせていただきます。』" voices=""/>
		<msg @l="2377" char_id="-1" frame_id="-1" name="大黒" text="『ええ、よろしくお願いします。』"
		   voices=""/>
		<msg @l="2379" char_id="-1" frame_id="-1" name="建築デザイナー" text="『では。』"
		   voices=""/>
		<msg @l="2381" char_id="-1" frame_id="-1" name=""
		   text="建築デザイナーは大黒に挨拶をし、部屋から出て行った。" voices=""/>
		<msg @l="2383" char_id="-1" frame_id="-1" name="大黒" text="『さて‥‥。』" voices=""/>
		<char @l="2387" id="rei" pos="auto" src="rei015"/>
		<msg @l="2389" char_id="1" frame_id="1" name="玲" text="『‥‥‥‥。』" voices=""/>
		<msg @l="2391" char_id="-1" frame_id="-1" name="大黒"
		   text="『本日はお疲れ様でした、とりあえず実地検査はこれにて終了とさせて戴きます。』" voices=""/>
		<msg @l="2393" char_id="1" frame_id="1" name="玲" text="『あの‥‥隣の部屋にいた子は？』"
		   voices=""/>
		<msg @l="2395" char_id="-1" frame_id="-1" name="大黒"
		   text="『ああ、ルームメイトの子でしたら帰りましたよ。』" voices=""/>
		<char @l="2398" id="rei" pos="auto" src="rei125"/>
		<msg @l="2400" char_id="1" frame_id="1" name="玲" text="『え！？なぜそれを！！』"
		   voices=""/>
		<msg @l="2402" char_id="-1" frame_id="-1" name="大黒"
		   text="『玲さんは、彼女が我が社を受けていることを知らなかったのですか？』" voices=""/>
		<char @l="2405" id="rei" pos="auto" src="rei115"/>
		<msg @l="2407" char_id="1" frame_id="1" name="玲"
		   text="『そんな‥‥！だって、美帆は、私よりも一年卒業が後なんですよ！面接が一緒の年度にはならないじゃないですか！？』" voices=""/>
		<msg @l="2409" char_id="-1" frame_id="-1" name="大黒"
		   text="『‥‥‥‥？玲さんは今回の通知をちゃんと読まれていますか？』" voices=""/>
		<char @l="2412" id="rei" pos="auto" src="rei125"/>
		<msg @l="2414" char_id="1" frame_id="1" name="玲" text="『え‥‥‥‥？』" voices=""/>
		<msg @l="2416" char_id="-1" frame_id="-1" name="大黒"
		   text="『今年度の女性の採用は、都合により来年と再来年の卒業者の中から一人にするという旨が書いてあったでしょう。』" voices=""/>
		<char @l="2419" id="rei" pos="auto" src="rei015"/>
		<msg @l="2421" char_id="1" frame_id="1" name="玲" text="『そ、そんなの知りません！？』"
		   voices=""/>
		<msg @l="2423" char_id="-1" frame_id="-1" name=""
		   text="そう言って、玲はカバンの中に入っているはずの通知を探す。" voices=""/>
		<char @l="2426" id="rei" pos="auto" src="rei115"/>
		<msg @l="2428" char_id="1" frame_id="1" name="玲" text="『あれ‥‥、無い‥‥‥‥。』"
		   voices=""/>
		<msg @l="2430" char_id="-1" frame_id="-1" name="大黒"
		   text="『あぁ、玲さんの合否通知は先ほどの仲根さんが持っていらっしゃいましたよ。』" voices=""/>
		<char @l="2433" id="rei" pos="auto" src="rei125"/>
		<msg @l="2435" char_id="1" frame_id="1" name="玲" text="『え‥‥！？』" voices=""/>
		<msg @l="2437" char_id="-1" frame_id="-1" name="大黒"
		   text="『何かおかしいですね。もしかして仲根さんは自分も大黒建設を受けているのを玲さんに隠したかったんじゃないですか？』" voices=""/>
		<msg @l="2439" char_id="-1" frame_id="-1" name="大黒" text="『その為に通知も隠したとか‥‥。』"
		   voices=""/>
		<stopbgm @l="2442" fadeout="1000"/>
		<char @l="2445" id="rei" pos="auto" src="rei115"/>
		<msg @l="2447" char_id="1" frame_id="1" name="玲" text="『ま、まさか‥‥‥‥？』"
		   voices=""/>
		<msg @l="2449" char_id="-1" frame_id="-1" name=""
		   text="もちろん、美帆と玲の二人が最終選考に残っていることも、ましてや美帆が大黒建設を受けていることも大黒の嘘である。" voices=""/>
		<msg @l="2450" char_id="-1" frame_id="-1" name="" text="玲を陥れる罠だった。"
		   voices=""/>
		<msg @l="2452" char_id="-1" frame_id="-1" name="大黒"
		   text="『では、私はこれから会議がありますので‥‥。』" voices=""/>
		<char @l="2455" id="rei" pos="auto" src="rei015"/>
		<msg @l="2457" char_id="1" frame_id="1" name="玲" text="『え！？あ、あの、検査の結果は‥‥。』"
		   voices=""/>
		<msg @l="2459" char_id="-1" frame_id="-1" name="大黒"
		   text="『結果ですか？接待中にあんな態度を取っていて、よく平気で聞けますね。』" voices=""/>
		<msg @l="2460" char_id="1" frame_id="1" name="玲" text="『え！？』" voices=""/>
		<msg @l="2462" char_id="-1" frame_id="-1" name="大黒" text="『正直、厳しいと思ってください。』"
		   voices=""/>
		<char @l="2465" id="rei" pos="auto" src="rei115"/>
		<msg @l="2467" char_id="1" frame_id="1" name="玲"
		   text="『そ、そんな！？あんなに奉仕したじゃないですか‥‥。』" voices=""/>
		<msg @l="2469" char_id="1" frame_id="1" name="玲"
		   text="『お願いします！どうしても私は御社に入りたいんです！』" voices=""/>
		<char @l="2472" id="rei" pos="auto" src="rei125"/>
		<msg @l="2474" char_id="1" frame_id="1" name="玲" text="『‥‥‥‥何でもしますから‥‥‥‥。』"
		   voices=""/>
		<msg @l="2476" char_id="-1" frame_id="1" name="大黒" text="（ふふふ‥‥もう一押しだな‥‥）"
		   voices=""/>
		<clear @l="2479" class="char"/>
		<bgm @l="2481" src="bgm09" volume="1."/>
		<char @l="2483" id="rei" pos="left" src="rei125"/>
		<char @l="2485" id="ookur" pos="auto" src="ookuro010"/>
		<msg @l="2487" char_id="-1" frame_id="-1" name="大黒"
		   text="『‥‥そうですね。そこまで言うのであれば、大学からの推薦状を貰ってきて下さい。』" voices=""/>
		<msg @l="2489" char_id="-1" frame_id="-1" name=""
		   text="そう言いながら、大黒は玲ににじり寄った。" voices=""/>
		<msg @l="2491" char_id="-1" frame_id="-1" name="大黒"
		   text="『そうすれば、大学が玲さんを一番評価している証にもなり、我が社としても次の面接を受けさせることが可能です。』" voices=""/>
		<clear @l="2494" class="char"/>
		<char @l="2497" id="rei" pos="left" src="rei115"/>
		<char @l="2499" id="ookur" pos="right" src="ookuro010"/>
		<msg @l="2501" char_id="1" frame_id="1" name="玲" text="『推薦状‥‥ですか。』"
		   voices=""/>
		<msg @l="2503" char_id="-1" frame_id="-1" name="大黒"
		   text="『それが無い場合は、仲根さんが内定を手にすることになるでしょう。』" voices=""/>
		<char @l="2507" id="rei" pos="left" src="rei015"/>
		<msg @l="2509" char_id="1" frame_id="1" name="玲"
		   text="『ま、待って下さい！必ず頂いてきますので！お願いします！！』" voices=""/>
		<msg @l="2511" char_id="-1" frame_id="-1" name="大黒"
		   text="『分かりました。では３日以内に、弊社にご持参ください。』" voices=""/>
		<char @l="2514" id="rei" pos="left" src="rei125"/>
		<msg @l="2516" char_id="1" frame_id="1" name="玲" text="『‥‥わかりました。』"
		   voices=""/>
		<clear @l="2520" class="char"/>
		<msg @l="2522" char_id="-1" frame_id="-1" name=""
		   text="玲は思いつめた表情をしながら部屋を出て行った。" voices=""/>
		<bgm @l="2525" src="bgm12" volume="1."/>
		<char @l="2527" id="ookur" pos="center" src="ookuro010f" y="-80"/>
		<msg @l="2529" char_id="-1" frame_id="-1" name="大黒" text="『もう少しだな････。』"
		   voices=""/>
		<msg @l="2531" char_id="-1" frame_id="-1" name="大黒"
		   text="『後はこの写真を朽木に渡して‥‥。』" voices=""/>
		<msg @l="2533" char_id="-1" frame_id="-1" name="大黒"
		   text="『ん？そうだ、さっきのルームメイトを使ってもう一押しするか。』" voices=""/>
		<msg @l="2535" char_id="-1" frame_id="-1" name=""
		   text="大黒は内線をかけると、会社見学に来た内定者を案内している担当を呼び出す。" voices=""/>
		<msg @l="2536" char_id="-1" frame_id="-1" name="大黒"
		   text="『あぁ、私だ。確か内定者の中に稲庭という奴がいたと思うのだが、正面入り口に行かせるんだ。急げよ。』" voices=""/>
		<msg @l="2538" char_id="-1" frame_id="-1" name="" text="用件だけ言うと内線を切る。"
		   voices=""/>
		<msg @l="2540" char_id="-1" frame_id="-1" name="大黒"
		   text="『自分の好きな男がライバルになるやもしれないルームメイトの子と一緒に、入社したい会社の前で談笑しているのをみたら、どういう気持ちになるかな‥‥その時の玲さんの顔を見るのが楽しみだよ。』"
		   voices=""/>
		<stopbgm @l="2544" fadeout="1000"/>
		<clear @l="2550" class="all"/>
		<wait_chgmv/>
		<bg @l="2554" src="bg16"/>
		<bgm @l="2558" src="bgm02" volume="1."/>
		<char @l="2562" id="miho" pos="auto" src="miho126"/>
		<msg @l="2564" char_id="0" frame_id="1" name="美帆" text="『ふぅ‥‥。』" voices=""/>
		<msg @l="2566" char_id="-1" frame_id="-1" name=""
		   text="無事に書類を渡し終えた私は、外に出て大きく息を吐いた。" voices=""/>
		<msg @l="2567" char_id="-1" frame_id="-1" name=""
		   text="結局、担当だと名乗る人が部屋を訪れたのは大分待たされた後だった。" voices=""/>
		<msg @l="2568" char_id="-1" frame_id="-1" name=""
		   text="かっぷくが良くて常に人懐っこい笑みを浮かべているその人は、持ってきた書類を渡した後もあれこれと話を続けてなかなか解放してくれなかった。"
		   voices=""/>
		<msg @l="2569" char_id="-1" frame_id="-1" name=""
		   text="ああいう人を粘着質‥‥というのだろうか。" voices=""/>
		<msg @l="2571" char_id="0" frame_id="1" name="美帆"
		   text="(でも無事玲さんの書類も届けられて‥‥良かった)" voices=""/>
		<msg @l="2573" char_id="-1" frame_id="-1" name=""
		   text="携帯電話を取り出して時計を見ると、既に１６時を回ってしまっていた。" voices=""/>
		<msg @l="2574" char_id="-1" frame_id="-1" name="" text="既に授業は終わってしまっている。"
		   voices=""/>
		<char @l="2577" id="miho" pos="auto" src="miho026"/>
		<msg @l="2579" char_id="0" frame_id="1" name="美帆"
		   text="(うん、今日はこのまま帰っちゃおう‥‥)" voices=""/>
		<msg @l="2581" char_id="-1" frame_id="-1" name="稲庭" text="『あれ？仲根くんじゃないか。』"
		   voices=""/>
		<clear @l="2585" class="char"/>
		<bgm @l="2587" src="bgm04" volume="1."/>
		<char @l="2589" id="miho" pos="right" src="miho124"/>
		<char @l="2591" id="inaba" pos="left" src="inaba010"/>
		<msg @l="2593" char_id="0" frame_id="1" name="美帆"
		   text="『あっ、稲庭先輩。こんな所でどうされたんですか？』" voices=""/>
		<msg @l="2595" char_id="-1" frame_id="-1" name="稲庭"
		   text="『僕は、この会社に来年から入社するので、今、研修で来ているんだよ。』" voices=""/>
		<msg @l="2597" char_id="-1" frame_id="-1" name="稲庭"
		   text="『それより、仲根くんこそ何をしているんだい？』" voices=""/>
		<char @l="2600" id="miho" pos="right" src="miho023"/>
		<msg @l="2602" char_id="0" frame_id="1" name="美帆"
		   text="『私は、面接を受けている玲さんに書類を届けにきたんです。』" voices=""/>
		<msg @l="2604" char_id="-1" frame_id="-1" name="稲庭"
		   text="『書類？もしかして面接に必要な書類を届けに来た女の子って仲根くんかい？』" voices=""/>
		<char @l="2606" id="miho" pos="right" src="miho024"/>
		<msg @l="2608" char_id="0" frame_id="1" name="美帆"
		   text="『え！？どうしてその事を知っているんですか？』" voices=""/>
		<msg @l="2610" char_id="-1" frame_id="-1" name="稲庭"
		   text="『実は会社の人から、書類を届けてくれた女の子に会社概要を渡して欲しいと言われたんだよ。』" voices=""/>
		<char @l="2613" id="miho" pos="right" src="miho120"/>
		<msg @l="2615" char_id="0" frame_id="1" name="美帆" text="『私にですか？』" voices=""/>
		<msg @l="2617" char_id="-1" frame_id="-1" name="稲庭" text="『うーん、そうじゃないかな？』"
		   voices=""/>
		<char @l="2620" id="miho" pos="right" src="miho026"/>
		<msg @l="2622" char_id="0" frame_id="1" name="美帆"
		   text="『でも、私就職活動は半年以上も先なのでまだ必要ないですけど‥‥。』" voices=""/>
		<msg @l="2624" char_id="-1" frame_id="-1" name="稲庭"
		   text="『まぁ、いいじゃないか。貰うだけ貰って何かの参考にすればいいよ。』" voices=""/>
		<char @l="2627" id="miho" pos="right" src="miho023"/>
		<msg @l="2629" char_id="0" frame_id="1" name="美帆"
		   text="『んー‥‥、そうですね。じゃあ頂いておきます。』" voices=""/>
		<msg @l="2631" char_id="-1" frame_id="-1" name="" text="美帆は笑顔で書類を受け取った。"
		   voices=""/>
		<stopbgm @l="2635" fadeout="1000"/>
		<clear @l="2641" class="all"/>
		<msgshow @l="2643" show="true"/>
		<msg @l="2645" char_id="-1" frame_id="-1" name=""
		   text="書類を受け渡す二人を遠くから見ている人物がいた。玲である。" voices=""/>
		<msg @l="2646" char_id="-1" frame_id="-1" name=""
		   text="玲は大黒から聞かされた、美帆が大黒建設入社試験を受けているという話を信じてないし、信じたくもないと思っていた。" voices=""/>
		<msg @l="2647" char_id="-1" frame_id="-1" name=""
		   text="美帆とルームメイトになって数ヶ月、今ではかわいい妹のような存在であり、少しは美帆の事を理解をしているつもりだった。"
		   voices=""/>
		<msg @l="2648" char_id="-1" frame_id="-1" name="" text="だが、その気持ちが揺らぐ‥‥。"
		   voices=""/>
		<msg @l="2649" char_id="-1" frame_id="-1" name=""
		   text="信じたくはないが、大黒の言っていた入社試験の話が本当のようにも思えてきた。" voices=""/>
		<msg @l="2650" char_id="-1" frame_id="-1" name=""
		   text="事実、研修中の稲庭から書類を受けとり、自分の知らない内容の会話に花を咲かせている‥‥。" voices=""/>
		<msg @l="2651" char_id="-1" frame_id="-1" name=""
		   text="美帆の事を信用したいのだが、考えれば考えるほど信じることが出来なくなっていた‥‥。" voices=""/>
		<stopbgm @l="2656" fadeout="1000"/>
		<clear @l="2662" class="all"/>
		<msgshow @l="2664" show="true"/>
		<wait_chgmv/>
		<bg @l="2669" src="bg03b"/>
		<bgm @l="2673" src="bgm03" volume="1."/>
		<msg @l="2675" char_id="0" frame_id="1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="2677" char_id="1" frame_id="1" name="玲" text="『‥‥‥‥。』" voices=""/>
		<msg @l="2679" char_id="-1" frame_id="-1" name="" text="夜―――静かな夕食が延々と続いていた。"
		   voices=""/>
		<char @l="2683" id="miho" pos="auto" src="miho036"/>
		<msg @l="2685" char_id="0" frame_id="1" name="美帆"
		   text="『えっと‥‥今日は少し味付けを変えてみたんですよ。』" voices=""/>
		<msg @l="2687" char_id="-1" frame_id="-1" name=""
		   text="妙な沈黙に耐えられなくなって、私は話のきっかけを探すように口を開いた。" voices=""/>
		<clear @l="2690" class="char"/>
		<char @l="2692" id="miho" pos="left" src="miho036"/>
		<char @l="2695" id="rei" pos="right" src="rei030"/>
		<msg @l="2697" char_id="1" frame_id="1" name="玲" text="『‥‥そうね。』" voices=""/>
		<msg @l="2699" char_id="-1" frame_id="-1" name=""
		   text="けれど、玲さんは素っ気なくそれだけを言うと黙々と箸を動かし続ける。" voices=""/>
		<char @l="2703" id="miho" pos="left" src="miho136"/>
		<msg @l="2705" char_id="0" frame_id="1" name="美帆" text="『‥‥‥‥。』" voices=""/>
		<msg @l="2707" char_id="1" frame_id="1" name="玲" text="『‥‥‥‥。』" voices=""/>
		<msg @l="2709" char_id="-1" frame_id="-1" name="" text="再び、食卓に重い雰囲気が漂う。"
		   voices=""/>
		<msg @l="2710" char_id="-1" frame_id="-1" name=""
		   text="この部屋に引っ越して来てから今日まで、こんなに気まずい雰囲気になったことは一度も無い。" voices=""/>
		<msg @l="2711" char_id="-1" frame_id="-1" name=""
		   text="玲さんは多少機嫌が悪い日でも、気を遣ってくれていたので、今日みたいな事は無かった。" voices=""/>
		<msg @l="2712" char_id="-1" frame_id="-1" name=""
		   text="その玲さんがこうして押し黙っていたのでは‥‥私も言葉を続けられなかった。" voices=""/>
		<msg @l="2714" char_id="1" frame_id="1" name="玲" text="『‥‥‥‥。』" voices=""/>
		<msg @l="2716" char_id="-1" frame_id="-1" name=""
		   text="しばらく黙々と食事を続けていた玲さんが、不意につぶやいた。" voices=""/>
		<stopbgm @l="2719" fadeout="1000"/>
		<msg @l="2721" char_id="1" frame_id="1" name="玲"
		   text="『････なんであの場所にいたの････。』" voices=""/>
		<char @l="2725" id="miho" pos="left" src="miho034"/>
		<msg @l="2727" char_id="0" frame_id="1" name="美帆" text="『え！？』" voices=""/>
		<msg @l="2729" char_id="0" frame_id="1" name="美帆" text="『････何か言いました？』"
		   voices=""/>
		<msg @l="2731" char_id="1" frame_id="1" name="玲" text="『‥‥‥‥。』" voices=""/>
		<char @l="2734" id="rei" pos="right" src="rei035"/>
		<msg @l="2736" char_id="1" frame_id="1" name="玲" text="『何でもないわ‥‥‥‥。』"
		   voices=""/>
		<msg @l="2738" char_id="1" frame_id="1" name="玲" text="『‥‥ごちそうさま。』"
		   voices=""/>
		<msg @l="2740" char_id="-1" frame_id="-1" name=""
		   text="私の言葉に答えることなく、玲さんは自分の食器を持って立ち上がった。" voices=""/>
		<msg @l="2742" char_id="0" frame_id="1" name="美帆" text="『あ、あの‥‥。』" voices=""/>
		<msg @l="2744" char_id="1" frame_id="1" name="玲"
		   text="『‥‥食器、後で洗うから流しに置いといてちょうだい。』" voices=""/>
		<clear @l="2748" layer="rei"/>
		<char @l="2752" id="miho" pos="left" src="miho135"/>
		<msg @l="2754" char_id="0" frame_id="1" name="美帆" text="『あっ‥‥。』" voices=""/>
		<msg @l="2756" char_id="-1" frame_id="-1" name=""
		   text="そうして玲さんは食器を流しに置くと、そのまま自分の部屋に戻ってしまった。" voices=""/>
		<msg @l="2757" char_id="-1" frame_id="-1" name="" text="‥‥私のことを避けているようだ。"
		   voices=""/>
		<char @l="2761" id="miho" pos="left" src="miho035"/>
		<msg @l="2763" char_id="0" frame_id="1" name="美帆" text="『玲さん‥‥。』" voices=""/>
		<msg @l="2765" char_id="-1" frame_id="-1" name=""
		   text="そうして私はリビングに一人残された‥‥。" voices=""/>
		<stopbgm @l="2769" fadeout="1000"/>
		<clear @l="2775" class="all"/>
		<call @l="2779" target="EventLabel_132@root_rei03"/>
		<return @l="2780" value="0&#13;&#10;"/>
		<return @l="2783" value=""/>
	</code>
</xscript>
