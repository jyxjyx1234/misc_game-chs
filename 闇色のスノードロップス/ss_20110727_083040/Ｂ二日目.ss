/*
●選択肢
大切な妹だ
分からない
*/
//●●選択分岐
if(@クリア済み == 1){
close
set_mwnd(2)
open
	c[0] = selbtn(
		"大切な妹だ",
		"分からない")
	system.debug_write_log(c[0])
	switch(c[0]){
		case(0) close
				set_mwnd(0)
				@悠依は大切な妹 = 1
				goto #yui_imouto
		case(1) close
				set_mwnd(0)
				@悠依のことが解らない = 1
				goto #yui_wakaranai
	}
}
else{
	@悠依は大切な妹 = 1
	goto #yui_imouto
}

