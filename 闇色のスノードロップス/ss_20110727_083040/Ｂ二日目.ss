/*
●選択肢。
初めて雪乃と会ったから、気疲れしちゃったのかな？
雪乃が苦手な訳じゃないだろうしruby("のど")咽喉rubyが渇いただけかな？
*/
//●●選択分岐
close
set_mwnd(2)
open

c[0] = selbtn(
	"雪乃と会って、気疲れしちゃったのかな？",
	"雪乃が苦手な訳じゃないよな？")
system.debug_write_log(c[0])
switch(c[0]){
	case(0) close
			set_mwnd(0)
			@二日目茜と帰宅 = 1
			goto #yui_kidukare
	case(1) close
			set_mwnd(0)
			@二日目雪乃と帰宅 = 1
			goto #yui_nodokawaku
}

