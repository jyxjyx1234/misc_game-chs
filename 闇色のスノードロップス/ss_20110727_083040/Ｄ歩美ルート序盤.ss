if(@クリア済み == 1){

	close
	set_mwnd(2)
	open

	c[0] = selbtn(
		"諭す",
		"見守る")
	system.debug_write_log(c[0])
	switch(c[0]){
		case(0) close
				set_mwnd(0)
				jump("Ｅ歩美トゥルー")
		case(1) close
				set_mwnd(0)
				jump("Ｆ歩美グッド")
	}
}
else{
	close
	set_mwnd(0)
	jump("Ｅ歩美トゥルー")
}

