//※※蹴りあげてる部分をフラッシュ

//★★普通にワイプさせた方がいいかな

frame_action_ch[0].start(600, "$screen_flush_loop")

command $screen_flush_loop(property $fa : frameaction)
{
	// フレームアクション専用のカウンタから現在の値を取得
	// 200ﾐﾘ秒でループさせるため、200 で割った余りを使います。
	l[0] = $fa.counter.get % 200

	// カウンタが 0～200 の間、ゲーム画面の明度を 0→255→0 に変化させる
	screen.bright = math.timetable(l[0], 0, 0, [0, 100, 255], [100, 200, 0])
}


