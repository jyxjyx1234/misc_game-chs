/*
●選択肢
今日子を選ぶ→今日子ＥＮＤ
雪乃を選ぶ→ハーレムＥＮＤ
*/
//●●選択分岐

close
set_mwnd(2)
open

c[0] = selbtn(
	"今日子を選ぶ",
	"雪乃を選ぶ")
system.debug_write_log(c[0])
switch(c[0]){
	case(0) close
			set_mwnd(0)
			jump("Ｋ今日子×雪乃今日子ＥＮＤ")
	case(1) close
			set_mwnd(0)
			jump("Ｌ今日子×雪乃ハーレムＥＮＤ")
}



