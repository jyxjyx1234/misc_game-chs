/*
●選択肢
雪乃の気持ちを察すると何も言えない。
言い返して悠依の見舞いに行く。
*/
//●●選択分岐
close
set_mwnd(2)
open

c[0] = selbtn(
	"雪乃の気持ちを察すると何も言えない",
	"言い返して悠依の見舞いに行く")
system.debug_write_log(c[0])
switch(c[0]){
	case(0) close
			set_mwnd(0)
			@雪乃を察する = 1
			goto #yukino_ienai
	case(1) close
			set_mwnd(0)
			@悠依の体拭き = 1
			goto #yukino_iikaesu
}


