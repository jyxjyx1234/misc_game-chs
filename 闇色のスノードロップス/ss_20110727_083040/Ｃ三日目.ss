if(@体験版 == 1){
	goto #akane_awaseru
}


/*
●選択肢
茜と調子を合わせる
歩美と留守番する。
*/
//●●選択分岐
close
set_mwnd(2)
open

c[0] = selbtn(
	"歩美と留守番する",
	"茜と調子を合わせる")
system.debug_write_log(c[0])
switch(c[0]){
	case(0) close
			set_mwnd(0)
			@歩美と留守番 = 1
			goto #ayumi_rusuban
	case(1) close
			set_mwnd(0)
			@茜に合わせる = 1
			goto #akane_awaseru

}


#ayumi_rusuban
//●歩美と留守番する。
