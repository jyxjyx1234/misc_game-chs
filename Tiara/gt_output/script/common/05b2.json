    "ori": "「ぼちぼちな」",
    "message": "「差不多吧」"
  },
  {
    "name": "マイナ",
    "ori": "「この無礼者が！」",
    "message": "「这个无礼的东西！」"
  },
  {
    "name": "クリード",
    "ori": "「ほら、授業始まるぞ」",
    "message": "「喂，上课了」"
  },
  {
    "name": "マイナ",
    "ori": "「くっ……」",
    "message": "「可恶……」"
  },
  {
    "ori": "授業中の教室で暴れたりするなよ。",
    "message": "别在教室里闹腾。"
  },
  {
    "name": "クリード",
    "ori": "「教科書、開かないのか？」",
    "message": "「不打开课本吗？」"
  },
  {
    "name": "マイナ",
    "ori": "「…………」",
    "message": "「…………」"
  },
  {
    "name": "クリード",
    "ori": "「ほら、９６ページだぞ」",
    "message": "「喂，第96页」"
  },
  {
    "name": "マイナ",
    "ori": "「…………」",
    "message": "「…………」"
  },
  {
    "name": "クリード",
    "ori": "「窓の外ばっかり見てるとセーレット先生に怒られるぞ」",
    "message": "「一直看窗外会被塞蕾特老师骂的」"
  },
  {
    "name": "マイナ",
    "ori": "「……うるさいな」",
    "message": "「……吵死了」"
  },
  {
    "name": "クリード",
    "ori": "「うるさくないだろ」",
    "message": "「哪有吵」"
  },
  {
    "name": "マイナ",
    "ori": "「また刺されたいのか？」",
    "message": "「还想再被捅一刀吗？」"
  },
  {
    "name": "クリード",
    "ori": "「いや、遠慮しておくよ」",
    "message": "「不，我还是算了吧」"
  },
  {
    "name": "マイナ",
    "ori": "「フン！　<下種|げす>な上に弱い男が」",
    "message": "「哼！卑鄙又软弱的男人」"
  },
  {
    "name": "クリード",
    "ori": "「そういうおまえはいったい何者だ？」",
    "message": "「你到底是什么人？」"
  },
  {
    "name": "マイナ",
    "ori": "「…………」",
    "message": "「…………」"
  },
  {
    "name": "マイナ",
    "ori": "「知ってどうする」",
    "message": "「知道了又能怎样」"
  },
  {
    "name": "クリード",
    "ori": "「みんなが怖がってる」",
    "message": "「大家都很害怕」"
  },
  {
    "name": "マイナ",
    "ori": "「…………」",
    "message": "「…………」"
  },
  {
    "name": "クリード",
    "ori": "「良くない噂も耳にする」",
    "message": "「我也听说了一些不好的传言」"
  },
  {
    "name": "マイナ",
    "ori": "「…………」",
    "message": "「…………」"
  },
  {
    "name": "マイナ",
    "ori": "「じつはおまえも怖がってるんじゃないのか？」",
    "message": "「其实你自己也很害怕吧？」"
  },
  {
    "name": "クリード",
    "ori": "「まさか」",
    "message": "「怎么可能」"
  },
  {
    "name": "マイナ",
    "ori": "「おまえ、一昨日は手を抜いてたそうだな」",
    "message": "「听说前天你偷懒了」"
  },
  {
    "name": "クリード",
    "ori": "「…………」",
    "message": "「…………」"
  },
  {
    "name": "マイナ",
    "ori": "「安心しろ、あれは私も本気を出していない」",
    "message": "「别担心，那次我也没用全力」"
  },
  {
    "name": "クリード",
    "ori": "「…………」",
    "message": "「…………」"
  },
  {
    "ori": "こいつ……。",
    "message": "这家伙……。"
  },
  {
    "ori": "挑発に乗るかよ！",
    "message": "还真要上钩啊！"
  },
  {
    "name": "クリード",
    "ori": "「一昨日のはオレの負けだ。別に言い訳をするつもりはない」",
    "message": "「前天那事是我输了。我没打算找借口」"
  },
  {
    "name": "マイナ",
    "ori": "「ほう。恥の上塗りをしないのはさすがだな。デルフィの英雄さん」",
    "message": "「哦。不愿意再往脸上抹黑，果然不一般啊。德尔菲的英雄」"
  },
  {
    "name": "クリード",
    "ori": "「…………」",
    "message": "「…………」"
  },
  {
    "name": "マイナ",
    "ori": "「で、何が目的だ？」",
    "message": "「那么，你的目的是什么？」"
  },
  {
    "name": "クリード",
    "ori": "「目的って、何の話だ？」",
    "message": "「目的？什么意思？」"
  },
  {
    "name": "マイナ",
    "ori": "「しらばっくれるな。私の隣に座った目的だ」",
    "message": "「别装傻了。坐在我旁边是为了什么？」"
  },
  {
    "name": "クリード",
    "ori": "「楽しくお話がしたかった。っていうのはダメか？」",
    "message": "「我只是想愉快地聊聊天。不行吗？」"
  },
  {
    "name": "マイナ",
    "ori": "「なら私を楽しませてみろ」",
    "message": "「那就让我开心一下啊」"
  },
  {
    "name": "クリード",
    "ori": "「…………」",
    "message": "「…………」"
  },
  {
    "name": "クリード",
    "ori": "「この前のパーティの夜」",
    "message": "「上次派对的那个晚上」"
  },
  {
    "name": "マイナ",
    "ori": "「なんだ、つまらなそうな話だな」",
    "message": "「什么呀，听起来真无聊」"
  },
  {
    "name": "クリード",
    "ori": "「あの時の騒ぎ、犯人はおまえだったんじゃないのか？」",
    "message": "「那天晚上的骚乱，犯人不就是你吗？」"
  },
  {
    "name": "マイナ",
    "ori": "「さあ？　知らないな」",
    "message": "「谁知道呢？我不清楚」"
  },
  {
    "name": "クリード",
    "ori": "「あの時の犯人が使った武器と、一昨日おまえが使った武器が同じ物だ」",
    "message": "「那天犯人用的武器，和前天你用的武器是同一把」"
  },
  {
    "name": "マイナ",
    "ori": "「ほう」",
    "message": "「哦」"
  },
  {
    "name": "マイナ",
    "ori": "「おまえが取り逃がした犯人か」",
    "message": "「你放走的犯人？」"
  },
  {
    "name": "クリード",
    "ori": "「…………」",
    "message": "「……」"
  },
  {
    "name": "マイナ",
    "ori": "「その犯人にもやられ、私にもやられたというわけだな」",
    "message": "「那个犯人也被对付了，我也被对付了，是这么回事吧」"
  },
  {
    "name": "クリード",
    "ori": "「…………」",
    "message": "「……」"
  },
  {
    "name": "マイナ",
    "ori": "「私だったらどうする？」",
    "message": "「我要是你会怎么做？」"
  },
  {
    "name": "クリード",
    "ori": "「捕らえる」",
    "message": "「抓捕」"
  },
  {
    "name": "マイナ",
    "ori": "「おまえがか？」",
    "message": "「你会吗？」"
  },
  {
    "name": "クリード",
    "ori": "「そうだ」",
    "message": "「没错」"
  },
  {
    "name": "マイナ",
    "ori": "「面白い。できるものならやってみろ」",
    "message": "「有意思。有本事就试试看」"
  },
  {
    "name": "クリード",
    "ori": "「じゃあやっぱりおまえが犯人なんだな？」",
    "message": "「那果然是你是犯人了？」"
  },
  {
    "name": "マイナ",
    "ori": "「それを調べるのがおまえの仕事なんじゃないのか？　英雄さん！」",
    "message": "「调查这个不是你的工作吗？英雄！」"
  },
  {
    "name": "クリード",
    "ori": "「ぐっ……！？」",
    "message": "「唔……！？」"
  },
  {
    "ori": "こ、こいつ！！",
    "message": "这、这家伙！！"
  },
  {
    "ori": "一昨日刺されて完治していない傷口を力一杯つかみやがった",
    "message": "前天被刺伤尚未痊愈的伤口被用力抓住了"
  },
  {
    "name": "マイナ",
    "ori": "「じゃあな、頑張れよ、英雄！」",
    "message": "「再见了，加油吧，英雄！」"
  },
  {
    "name": "クリード",
    "ori": "「ど、どこへ行く気だ？　授業中だぞ」",
    "message": "「你、你打算去哪？课堂上呢」"
  },
  {
    "name": "マイナ",
    "ori": "「退屈だから抜ける」",
    "message": "「太无聊了，我要走了」"
  },
  {
    "name": "クリード",
    "ori": "「おい！」",
    "message": "「喂！」"
  },
  {
    "name": "マイナ",
    "ori": "「いつでも来な」",
    "message": "「随时欢迎来追我」"
  },
  {
    "name": "クリード",
    "ori": "「うっ……」",
    "message": "「唔……」"
  },
  {
    "ori": "傷口が痛む。",
    "message": "伤口隐隐作痛。"
  },
  {
    "ori": "せっかく治してもらったのに、内出血してしまったようだ……。",
    "message": "明明好不容易治好，却又出现了内出血……。"
  },
  {
    "ori": "マイナめ。",
    "message": "米娜，这个混蛋。"
  },
  {
    "ori": "やっぱり犯人だったみたいだ。",
    "message": "果然她就是犯人。"
  },
  {
    "ori": "今度は証拠を掴んで捕まえてやる！",
    "message": "这次我一定要找到证据，抓住她！"
  }
