[
  {
    "ori": "マイナと歴史の授業",
    "message": "米娜和历史课"
  },
  {
    "name": "クリード",
    "ori": "「それじゃあ、オレは後ろで授業受けるから」",
    "message": "「那我就坐在后面上课」"
  },
  {
    "name": "ナユティア",
    "ori": "「はい。ごきげんよう、クリードさん」",
    "message": "「好的。再见，克里德先生」"
  },
  {
    "name": "クリード",
    "ori": "「おう」",
    "message": "「嗯」"
  },
  {
    "ori": "ナユは真ん中あたりの席で授業を受けるようだ。",
    "message": "纳尤似乎在教室中间位置的座位上听课。"
  },
  {
    "ori": "ナユが席に着くと、さっそく人だかりができる。",
    "message": "纳尤落座后，立即围上了一群人。"
  },
  {
    "ori": "相変わらず人気者だなぁ。",
    "message": "果然还是那么受欢迎啊。"
  },
  {
    "ori": "それに比べて……。",
    "message": "相比之下……。"
  },
  {
    "name": "マイナ",
    "ori": "「…………」",
    "message": "「…………」"
  },
  {
    "ori": "こいつは自称お姫様だっけ？",
    "message": "这家伙自称是公主来着？"
  },
  {
    "name": "マイナ",
    "ori": "「何か用か？」",
    "message": "「有什么事吗？」"
  },
  {
    "name": "クリード",
    "ori": "「隣いいか？」",
    "message": "「能坐旁边吗？」"
  },
  {
    "name": "マイナ",
    "ori": "「いいわけないだろ」",
    "message": "「不可能吧」"
  },
  {
    "name": "クリード",
    "ori": "「邪魔するぜ」",
    "message": "「打扰了」"
  },
  {
    "name": "マイナ",
    "ori": "「人の話を聞いてるのか？」",
    "message": "「你在听我说话吗？」"
  },
  {
