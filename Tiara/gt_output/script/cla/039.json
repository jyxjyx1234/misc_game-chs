  {
    "name": "クリード",
    "ori": "「そのうち慣れるって」",
    "message": "「迟早会习惯的」"
  },
  {
    "name": "クレア",
    "ori": "「慣れるもんですか」",
    "message": "「我会习惯？休想！」"
  },
  {
    "ori": "文句ばっかり言う割りに、嫌いだって言ってた貝まで食べちゃって。",
    "message": "明明还抱怨连贝类都说不喜欢，结果还是吃了。"
  },
  {
    "ori": "一日中歩き回って、お腹空いてたんだろうな。",
    "message": "一整天到处走，肯定饿坏了吧。"
