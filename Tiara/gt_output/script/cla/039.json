    "ori": "「じゃあ、食べようぜ」",
    "message": "「那就吃吧」"
  },
  {
    "name": "クレア",
    "ori": "「…………」",
    "message": "「…………」"
  },
  {
    "name": "クリード",
    "ori": "「クレアも苦労して採ってきた食べ物達だ。おいしいぞ」",
    "message": "「这可是克莱尔辛苦采来的食物。很美味哦」"
