    "name": "クリード",
    "ori": "「…………」",
    "message": "「…………」"
  },
  {
    "ori": "へぇ、クレアが『いただきます』ねぇ。",
    "message": "哦，克莱尔竟然说'开动'啊。"
  },
  {
    "ori": "少しは食べ物のありがたみがわかってくれたのかな。",
    "message": "难道她终于懂得食物的珍贵了吗？"
  },
  {
    "name": "クリード",
    "ori": "「うん、美味い」",
    "message": "「嗯，很美味」"
  },
  {
    "name": "クレア",
    "ori": "「…………」",
    "message": "「…………」"
  },
  {
    "name": "クリード",
    "ori": "「どうだ、自分で採った食事の味は？」",
    "message": "「怎么样，自己采的食物味道如何？」"
  },
  {
    "name": "クレア",
    "ori": "「……全然美味しくない」",
    "message": "「……一点都不好吃」"
  },
  {
    "name": "クリード",
    "ori": "「そうか？」",
    "message": "「是吗？」"
  },
  {
    "name": "クレア",
    "ori": "「味なんてしないじゃない」",
    "message": "「根本没有味道」"
  },
  {
    "name": "クリード",
    "ori": "「塩味が効いてると思うけどなぁ」",
    "message": "「我觉得已经很有盐味了」"
