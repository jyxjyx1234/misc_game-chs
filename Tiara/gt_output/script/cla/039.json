    "ori": "「クレアも手伝え」",
    "message": "「克莱尔也来帮忙」"
  },
  {
    "name": "クレア",
    "ori": "「なんで私がそんな事をしなければいけないのかしら？」",
    "message": "「为什么我要做这种事？」"
  },
  {
    "name": "クリード",
    "ori": "「ほら、教えてあげるから」",
    "message": "「来吧，我教你」"
  },
  {
    "name": "クレア",
    "ori": "「……わかったわよ。何をすればいいの？」",
    "message": "「……好吧。我该做什么？」"
  },
  {
    "name": "クリード",
    "ori": "「それじゃあ、まずは火を点けてくれ」",
    "message": "「那么，先帮我点火」"
  },
  {
    "name": "クレア",
    "ori": "「……この木を燃やせばいいのね？」",
    "message": "「……用这根木头点火对吗？」"
  },
  {
    "name": "クリード",
    "ori": "「ああ、頼む」",
    "message": "「对，拜托了」"
  },
  {
    "name": "クレア",
    "ori": "「……えいっ！！」",
    "message": "「……喝！！」"
  },
  {
