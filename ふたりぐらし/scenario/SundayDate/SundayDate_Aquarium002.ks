[stopbgm]
[tb_hide_message_window  ]
[wait  time="500"  ]
[maskStart]
[bgChange time="0"  method="crossfade"  storage="bk100.jpg"  ]
;☆スチル消去
[freeimage layer="1"]
[addTime minutes=30]
[wait  time="500"  ]
[mask_off  time="1000"  effect="fadeOut"  ]
[messageON]

[tb_start_text mode=3 ]
#
…………[p]
[_tb_end_text]

[tb_start_text mode=3 ]
#
……[p]
[_tb_end_text]

[endreplay]
;ステータス加算処理
[addTime minutes=30]
[fadeinbgm2 volume="40"  time="1500"  loop="true"  fadein="false"  storage=&f.beforeBGM  html5="false"  ]
[eval exp="f.dateSuccess.aquarium = true" ]
[return]
;以上		


;回想シーン用
*replay_aquarium
[button name="myButton" fix="true" target="endReplay"  storage="macro_call.ks" enterimg="osawari/modoru_2.png"  graphic="osawari/modoru.png"  width="38"  height="38"  x="1249"  y="15"  cond="f.flag_replay"  ]
[replaySituSelect column="1" text="&tf.text"]

[setGlinkY num="2"]

[glink  color="btn_05_black"  text="初回時の内容"  _clickable_img="" target="*replay_aquarium_check" size="24" x="auto"   y="&tf.glink1Y"  width="500"  height=""  preexp="0"  exp="f.isAwake = false,tf.situText1='初回時の内容',tf.storage='SundayDate/SundayDate_Aquarium002.ks',tf.label='aquarium_cg'"  clickse="se/s_kettei.mp3"   ]
[glink  color="btn_05_black" text="２回目以降の内容"  target="replay_aquarium_check" size="24" x="auto"  y="&tf.glink2Y"  width="500"  height=""  preexp="0" exp="tf.situText1='２回目以降の内容',tf.storage='SundayDate/SundayDate_Aquarium003.ks',tf.label='aquarium_cg2'"  clickse="se/s_kettei.mp3"   ]
[s]
[s]

*replay_aquarium_check
[columnUpdate column="1" text="&tf.situText1"]
[replaySituCheck]
[if exp="tf.isSituOK" ]
    [deleteSituColumn]
    [setButtonInTalk]
    [jump target="&tf.label" storage="&tf.storage"  ]
[else]
    [jump target="*replay_aquarium" ]
[endif]

[endreplay]