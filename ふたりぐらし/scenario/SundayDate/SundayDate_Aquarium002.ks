[_tb_end_text]

;FG003_1.png
[changeimg storage="EVcg/aquarium/FG003_1.png" name="FG003"]
[playse  volume="100"  time="1000"  buf="2"  storage="vo_scene/FT_m003_Date_0014.mp3"  ]
[tb_start_text mode=3 ]
#みお
