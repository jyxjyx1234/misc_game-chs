[macro name="setOsawariClickable"]


[iscript]

tf.ude = mp.ude || "ryoutoji"; //ryoutoji,hidaritoji,migitoji,ake
tf.asi = mp.asi || "ryoutoji"; //ryoutoji,hidaritoji,migitoji,kaikyaku
tf.pantsu = mp.pantsu || "ari"; //ari_toji:着衣、脚閉じ ari_kaikyaku:着衣、開脚 ari_kaikyaku_zurasi:着衣、開脚、パンツずらし nugi:無し
tf.fuku = mp.fuku || "ari"; //ari:通常着衣 ari_mekure:服めくれ nugi:裸
