[macro name = setHP]
;使い方 :体力の増減がある所で[HPcalc HP=5]や[HPcalc HP=-10]などと記載する
[eval exp="tf.HP=mp.HP"]
[iscript]
f.HP = f.HP+parseInt(tf.HP);



;HPがマイナスの時0とする
if(f.HP<0){
	f.HP = 0;
}
;HPの最大値を1000とする
if(f.HP>1000){
	f.HP = 1000;
}

if(parseInt(tf.HP) >= 0){
	tf.strPlusHP = "+" +tf.HP;
} else{
  	tf.strPlusHP = tf.HP;
	}

tf.strHP=f.HP;
[endscript]
;体力表示の更新
[ptext  text=&tf.strHP layer="2"  x="75"  y="85"  size="32"  time="500" name="HPText" overwrite="true" color="white" edge="0x000000" ]
[endmacro]

[macro name = calcHP]
;使い方 :体力の増減がある所で[HPcalc HP=5]や[HPcalc HP=-10]などと記載する
[eval exp="tf.HP=mp.HP"]
[iscript]
f.HP = f.HP+parseInt(tf.HP);

var minHP = mp.minHP || "0"
minHP = Number(minHP)


;HPがマイナスの時0とする
if(f.HP<0){
	f.HP = 0;
}

if(f.HP < minHP ){
  f.HP = minHP;
}

;HPの最大値を1000とする
if(f.HP>1000){
	f.HP = 1000;
}

if(parseInt(tf.HP) >= 0){
	tf.strPlusHP = "+" +tf.HP;
} else{
  	tf.strPlusHP = tf.HP;
	}

tf.strHP=f.HP;
[endscript]
;体力表示の更新
[ptext  text=&tf.strHP layer="2"  x="75"  y="85"  size="32"  time="500" name="HPText" overwrite="true" color="white" edge="0x000000" ]
[mtext layer="2" x="170"  y="85"  text=&tf.strPlusHP  size="20"  fadeout="true"  in_effect="fadeIn"  out_effect="fadeOut" edge="0x000000" wait="false" in_delay="20"  out_delay="20" time="300"  ]
[endmacro]

[macro name = calcSuyasuya]
;使い方 :すやすやポイントの増減がある所で[HPcalc HP=5]や[HPcalc HP=-10]などと記載する
[eval exp="tf.suyasuya=mp.suyasuya"]
[iscript]
f.suyasuya = f.suyasuya+parseInt(tf.suyasuya);


; 最低値、最大値はいったん無しとする
;すやすやポイントがマイナスの時0とする
;if(f.suyasuya<0){
;	f.suyasuya = 0;
;}
;すやすやポイントの最大値を1000とする
;if(f.suyasuya>1000){
;	f.suyasuya = 1000;
;}


if(parseInt(tf.suyasuya) >= 0){
	tf.strPlusSuyasuya = "+" +tf.suyasuya;
} else{
  	tf.strPlusSuyasuya = tf.suyasuya;
	}


tf.strSuyasuya="すやすやポイント(仮):" +f.suyasuya;
[endscript]

;体力表示の更新
;すやすやポイントの更新 ※デバッグ用のためリリース時は非表示とします
[ptext  text=&tf.strSuyasuya layer="2"  x="5"  y="152"  size="32"  time="500" name="SuyasuyaText" overwrite="true" color="white" edge="0x000000" ]
[mtext  x="380"  y="152"  text=&tf.strPlusSuyasuya  size="20"  fadeout="true"  in_effect="fadeIn"  out_effect="fadeOut" edge="0x000000" wait="false" in_delay="20"  out_delay="20" time="300"  ]
[endmacro]


; 使い方 [calcLove plusLove = "XXX"]
;plusLoveで指定した数値(整数)を好感度に増減させます
[macro name = calcLove]

[eval exp="tf.love=mp.plusLove"]
[iscript]
f.love = f.love+parseInt(tf.love);

if(f.love>= 0 && 50 > f.love){
  f.strLove = "低";
} else if (f.love >= 50 && 100 > f.love) {
  f.strLove = "中";
} else if (f.love >= 100) {
  f.strLove = "高";
} else {
  f.strLove = "嫌";
}


//最低値、最大値はいったん無しとする
//好感度の最低値を-100とする
if(f.love<-100){
	f.love = -100;
}
//好感度の最大値を1000とする
if(f.love>1000){
	f.love = 1000;
}


if(parseInt(tf.love) >= 0){
	tf.strPlusLove = "+" +tf.love;
} else{
  	tf.strPlusLove = tf.love;
	}


tf.strLove="好感度:" +f.love;
[endscript]
;好感度表示の更新
[ptext  text=&tf.strLove layer="2"  x="5"  y="202"  size="32"  time="500" name="loveText" overwrite="true" color="white" edge="0x000000" ]
[mtext  x="380"  y="202"  text=&tf.strPlusLove  size="20"  fadeout="true"  in_effect="fadeIn"  out_effect="fadeOut" edge="0x000000" wait="false" in_delay="20"  out_delay="20" time="300"  ]
[endmacro]


