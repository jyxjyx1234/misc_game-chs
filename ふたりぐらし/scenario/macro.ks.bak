[macro name="frameSetForOsawari"]
[iscript]

// 初期化
mp.font_color      = mp.font_color      || "0xDDDDDD"; // テキストの色
mp.edge_color      = mp.edge_color      || "0x2E0000"; // テキストの縁取りの色
mp.name_color      = mp.name_color      || "0xDDDDDD"; // 発言者名の色
mp.name_edge_color = mp.name_edge_color || "0x2E0000"; // 発言者名の縁取りの色
mp.frame_opacity   = mp.frame_opacity   || "255";			 // メッセージウィンドウの不透明度
mp.font_color2     = mp.font_color2     || "0xDDDDDD"; // 既読テキストの色（変更なし）
mp.glyph           = mp.glyph           || "off";      // クリック待ちグリフをプラグイン専用のデザインに差し替えるか（def=off）

[endscript]

[position layer="message0" frame="frame_message_toumei.png" margint="50" marginl="440" marginr="340" opacity="&mp.frame_opacity" page="fore" ]
;[ptext name="chara_name_area" layer="message0" edge="&mp.name_edge_color" color="&mp.name_color" size="24" x="450" y="515" width="340" overwrite="true"]
;[chara_config ptext="chara_name_area"]
[endmacro]

[macro name="frameReset"]
  [iscript]

	// 初期化
	mp.font_color      = mp.font_color      || "0xDDDDDD"; // テキストの色
	mp.edge_color      = mp.edge_color      || "0x2E0000"; // テキストの縁取りの色
	mp.name_color      = mp.name_color      || "0xDDDDDD"; // 発言者名の色
	mp.name_edge_color = mp.name_edge_color || "0x2E0000"; // 発言者名の縁取りの色
	mp.frame_opacity   = mp.frame_opacity   || "255";			 // メッセージウィンドウの不透明度
	mp.font_color2     = mp.font_color2     || "0xDDDDDD"; // 既読テキストの色（変更なし）
	mp.glyph           = mp.glyph           || "off";      // クリック待ちグリフをプラグイン専用のデザインに差し替えるか（def=off）

	[endscript]
;	メッセージウィンドウの設定
  	[position layer="message0" width="1280" height="232" top="488" left="0"]
