[macro name="checkFirstOsawari"]
[if exp="f.isFirstOsawari"]
[firstOsawariCheck]
[endif]
[endmacro]

[macro name="checkChangeHyoujou"]
[if exp="(f.suyasuyaGauge / 5) > 80" ]

[if exp="f.osawariCount >= 3"]
[setOsawariHyoujou]
[eval exp="f.osawariCount = 0"]
[else]
[eval exp="f.osawariCount += 1"]
[endif]
[else]
[setOsawariHyoujou]
[endif]
[endmacro]

[macro name="checkOsawariFlag"]
[iscript]
if(f.osawariCount >= 3 || (f.suyasuyaGauge / 5) <= 80){
  f.osawariFlag = true;
}
[endscript]
[endmacro]

