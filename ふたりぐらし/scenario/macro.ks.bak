[macro  name="setTime"  ]
[iscript]
//時刻計算関数
f.addTime = function addTime(hours,minutes){
  　var dt = new Date();
	dt.setHours(hours);
	dt.setMinutes(minutes);
	f.hours = dt.getHours();
	f.minutes = dt.getMinutes();
    if(f.minutes == 0){
        f.minutes = "00";
    }
	tf.strDate=f.hours +':' +f.minutes;
	return tf.strDate;
};
[endscript]
[ptext  text=&f.addTime(mp.hours,mp.minutes) layer="2" x="210"  y="30"  size="32"  time="500" name="dateText" overwrite="true" color="white" edge="0x000000" face="DSEG14ModernMini-Regular" ]
[endmacro]


[macro  name="addTime"  ]
[iscript]
//時刻計算関数
f.addTime = function addTime(passMinutes){
  　var dt = new Date();
	dt.setHours(f.hours);
	dt.setMinutes(f.minutes);
    dt.setMinutes(f.minutes + parseInt(passMinutes));
	f.hours = dt.getHours();
	f.minutes = dt.getMinutes();
    if(f.minutes == 0){
        f.minutes = "00";
    }
	tf.strDate=f.hours +':' +f.minutes;
	return tf.strDate;
};
[endscript]
[ptext  text=&f.addTime(mp.minutes) layer="2" x="210"  y="30"  size="32"  time="500" name="dateText" overwrite="true" color="white" edge="0x000000" face="DSEG14ModernMini-Regular" ]
[endmacro]

[macro  name="plusTimeInOsawari"  ]
[iscript]
//時刻計算関数
f.addTime = function addTime(passMinutes){
  　var dt = new Date();
	dt.setHours(f.hours);
	dt.setMinutes(f.minutes);
    dt.setMinutes(f.minutes + parseInt(passMinutes));
	f.hours = dt.getHours();
	f.minutes = dt.getMinutes();
    if(f.minutes == 0){
        f.minutes = "00";
    }
	tf.strDate=f.hours +':' +f.minutes;
	return tf.strDate;
};
[endscript]
[ptext  text=&f.addTime(mp.minutes) layer="2" x="15"  y="30"  size="32"  time="500" name="dateText" overwrite="true" color="white" edge="0x000000" face="DSEG14ModernMini-Regular" ]
[endmacro]


