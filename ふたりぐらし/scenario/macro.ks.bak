[macro name="setOsawariHyoujouLimit"]
[iscript]
if(!f.isAwake){
if((f.suyasuyaGauge / 5) == 70){
  if(!f.isSekimen){
    f.hyoujyou = "neboke1";
  } else {
    f.hyoujyou = "neboke1_red";
  }
}else if((f.suyasuyaGauge / 5) == 50) {
  if(!f.isSekimen){
    f.hyoujyou = "neboke2";
  } else {
    f.hyoujyou = "neboke3_red";
  }
}else if((f.suyasuyaGauge / 5) == 30){
  if(!f.isSekimen){
    f.hyoujyou = "neboke4";
  } else {
    f.hyoujyou = "neboke5_red";
  }
}
} else {
  if(!f.isSekimen){
    f.hyoujyou = "okita";
  } else {
    f.hyoujyou = "okita_red";
  }
}
[endscript]

[chara_part name="osawari" hyoujyou=&f.hyoujyou ]

[if exp="!f.isAwake"]
[wait time="600"]
[endif]
[iscript]
if(!f.isAwake){
if((f.suyasuyaGauge / 5) > 30){
  if(!f.isSekimen){
    f.hyoujyou = "neteru1";
  } else {
    f.hyoujyou = "neteru1_red";
  }
}else {
  if(!f.isSekimen){
    f.hyoujyou = "neboke1";
  } else {
    f.hyoujyou = "neboke1_red";
  }
}
}
[endscript]
[chara_part name="osawari" hyoujyou=&f.hyoujyou]

