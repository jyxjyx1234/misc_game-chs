[macro name="calcSuyasuyaGauge"]
[iscript]
f.suyasuyaGauge = f.suyasuyaGauge + parseInt(mp.gauge);
if(mp.gauge == -500){
  f.suyasuyaLimit = 0;
}
tf.isHyoujouFlag = false;
if(f.suyasuyaGauge <= f.suyasuyaLimit){
f.suyasuyaGauge = f.suyasuyaLimit;
tf.isHyoujouFlag = true;
if(f.suyasuyaLimit == f.SUYASUYA_LIMIT_FIRST){
  f.suyasuyaLimit = f.SUYASUYA_LIMIT_SECOND;
} else if(f.suyasuyaLimit == f.SUYASUYA_LIMIT_SECOND){
  f.suyasuyaLimit = f.SUYASUYA_LIMIT_THIRD;
} else if (f.suyasuyaLimit == f.SUYASUYA_LIMIT_THIRD){
  f.suyasuyaLimit = 0;
}

}



if(f.suyasuyaGauge < 0){
  f.suyasuyaGauge = 0;
}
[endscript]
;[anim name="suyasuyaGauge" width="&f.suyasuyaGauge" height="20" time=200]
[if exp="f.suyasuyaGauge == 0"]
[eval exp="f.isAwake = true"]
[if exp="f.isFirstAwake == true"]

[eval exp="f.isFirstAwake = false"]
[eval exp="f.isAwake = true"]
[call storage="osawari_text.ks" target="*first_okita"]

[endif]
[endif]

[setOsawariHyoujouLimit]
[endmacro]

[macro name="calcSyaseiGauge"]
[iscript]
tf.plusSyasei = parseInt(mp.gauge);

if(f.HP >= 200){
  tf.bairitsu = 1;
} else if (f.HP > 150) {
  tf.bairitsu = 0.9;
} else if(f.HP > 100){
  tf.bairitsu = 0.8;
} else if(f.HP > 50){
  tf.bairitsu = 0.7;
} else if (f.HP > 30) {
  tf.bairitsu = 0.6;
} else {
  tf.bairitsu = 0.4;
}

tf.plusSyasei = tf.plusSyasei * tf.bairitsu;
tf.plusSyasei = Math.floor(tf.plusSyasei);
if(tf.plusSyasei < 3){
  tf.plusSyasei = 3;
  f.beforePenisCommand = "manko";
}
f.syaseiGauge = f.syaseiGauge + tf.plusSyasei;
[endscript]

[if exp="f.syaseiGauge >= 250"]
[wait_cancel]

[if exp="f.beforePenisCommand == 'mune'"]
[image layer="1" name="siru"  storage="osawari/siru/mune1.png" folder="image"]
[eval exp="f.isSiru = true"]

[elsif exp="f.beforePenisCommand == 'manko'"]
[image layer="1" name="siru" storage="osawari/siru/manko1.png" folder="image"]
[eval exp="f.isSiru = true"]

[elsif exp="f.beforePenisCommand == 'kao'"]
[image layer="1" name="siru" storage="osawari/siru/kao1.png" folder="image"]
[eval exp="f.isSiru = true"]

[elsif exp="f.beforePenisCommand == 'kuti'"]
[image layer="1" name="siru" storage="osawari/siru/kuti1.png" folder="image"]
[eval exp="f.isSiru = true"]

[elsif exp="f.beforePenisCommand == 'sumata'"]
[image layer="1" name="siru" storage="osawari/siru/sumata1.png" folder="image"]
[eval exp="f.isSiru = true"]

[endif]

[eval exp="f.syaseiGauge = 250"]
[anim name="syaseiGauge" width="&f.syaseiGauge" height="20" time=1500 effect="easeOutQuad"]
[mtext x="600" y="80" edge="white" color="black" text="射精ゲージMAX" fadeout="true" wait="true" out_delay="100" in_sync="true" time="100"  out_sync="true"]
[calcHP HP=-40]
[eval exp="f.syaseiGauge = 1"]

[iscript]
max = Number(2);
min = Number(1);
tf.rand = min + Math.floor(Math.random() * (max - min + 1));
tf.syaseiSE ="se/" +"syasei" +tf.rand +".mp3";
[endscript]
[playse storage=&tf.syaseiSE buf="1"]
[endif]


[anim name="syaseiGauge"  layer="message2" width="&f.syaseiGauge" height="20" time=1500 effect="easeOutQuad"]



[endmacro]

[macro name="calcZettyouGauge"]
