[macro name="setPantuPosition"]
[iscript]
if(!f.positionPantu.includes("none")){
  if(f.positionAsi == "kaikyaku" && f.isPantuZurasi == true){
    f.positionPantu = f.positionAsi;
    f.positionPantu = f.pantu + "_" +f.positionPantu + "_zurasi";
    if(!f.positionPantu.includes("nure") && f.isNure){
        f.positionPantu += "_nure"
    }
  } else{

  f.positionPantu = f.positionAsi;
  f.positionPantu = f.pantu + "_" +f.positionPantu;
  if(!f.positionPantu.includes("nure") && f.isNure){
      f.positionPantu += "_nure"
  }
  if(!f.positionPantu.includes("curi") && f.isCuri){
      f.positionPantu += "_curi"
  }
}
}
[endscript]
[endmacro]

[macro name="setFukuPosition"]
[iscript]
if(!f.positionFuku.includes("none")){
  f.positionFuku = "pajama_" +"asi_" +f.positionAsi + "_ude_" +f.positionUde;
  if(f.isMekure == true){
    f.positionFuku = f.positionFuku+"_mekure";
  }
}
[endscript]
[endmacro]

[macro name="loopVoice"]
[iscript]
tf.voiceFolder = "vo_bgv/";
if(!f.isAwake){
  if(f.zettyouGauge >= 200){
  tf.loopVoice = "FT_m001_bgs0003.mp3";
  } else if(f.zettyouGauge >= 100) {
  tf.loopVoice = "FT_m001_bgs0002.mp3";
  } else{
  tf.loopVoice = "FT_m001_bgs0001.mp3";
  }
}

if(f.beforePenisCommand.includes("kao")){
  if(f.isAwake){
    tf.loopVoice = "FT_m001_bgs0035.mp3";
  } else {
    tf.loopVoice = "FT_m001_bgs0041.mp3";
  }

} else if(f.beforePenisCommand.includes("manko")){
  if(f.isAwake){
    tf.loopVoice = "FT_m001_bgs0008.mp3";
  } else{
    tf.loopVoice = "FT_m001_bgs0023.mp3";
  }

} else if(f.beforePenisCommand.includes("ude")){
  if(f.isAwake){
    tf.loopVoice = "FT_m001_bgs0028.mp3";
  } else{
    tf.loopVoice = "FT_m001_bgs0029.mp3";
  }
}

[endscript]
[if exp="f.loopVoice != tf.loopVoice"]
[eval exp="f.loopVoice = tf.loopVoice"]
[playse storage=&tf.voiceFolder+tf.loopVoice loop="true" buf="2"]

[endif]
[endmacro]

[macro name="setHyoujou"]
[if exp="f.isAwake"]
[eval exp="f.hyoujyou = 'okita'"]
[else]
[iscript]
switch (f.suyasuyaLimit) {
  case f.SUYASUYA_LIMIT_FIRST:
    f.hyoujyou = "neteru1";
    break;
    case f.SUYASUYA_LIMIT_SECOND:
      f.hyoujyou = "neteru1";
      break;
      case f.SUYASUYA_LIMIT_THIRD:
        if(f.suyasuyaGauge <= f.SUYASUYA_LIMIT_THIRD){
          f.hyoujyou = "neboke1";
        }
        break;
        case 0:
          f.hyoujyou = "neboke1";
          break;
  default:

}


[endscript]
[endif]

[if exp="f.isSekimen"]

[eval exp="f.hyoujyou += '_red'"]
[endif]
[chara_part name="osawari" hyoujyou=&f.hyoujyou]
[endmacro]

[macro name="debugSuyasuyaGauge"]
[iscript]
tf.suyasuyaGaugeDebug = "すやすや:" +(f.suyasuyaGauge / 5) +"%";
[endscript]
[ptext layer="message2" text=&tf.suyasuyaGaugeDebug x="10" y="150" name="suyasuyaDebug" overwrite="true"]
[endmacro]


[macro name="firstOsawariCheck"]

[if exp="f.isFirstOsawari"]
[iscript]
if(!f.isAwake){
if((f.suyasuyaGauge / 5 ) > 30 ){
  if(!f.isSekimen){
    f.hyoujyou = "neteru2";
  } else {
    f.hyoujyou = "neteru2_red";
  }
  if((f.suyasuyaGauge <= f.SUYASUYA_LIMIT_FIRST) && (f.suyasuyaGauge > f.SUYASUYA_LIMIT_SECOND) ){
  if(!f.isSekimen){
    f.hyoujyou = "neboke1";
  } else {
    f.hyoujyou = "neboke1_red";
  }
}else if((f.suyasuyaGauge <= f.SUYASUYA_LIMIT_SECOND )&& (f.suyasuyaGauge > f.SUYASUYA_LIMIT_THIRD)){
  if(!f.isSekimen){
    f.hyoujyou = "neboke2";
  }else {
    f.hyoujyou = "neboke3_red";
  }

}else if(f.suyasuyaGauge <= f.SUYASUYA_LIMIT_THIRD){
    if(!f.isSekimen){
      f.hyoujyou = "neboke4";
    } else {
      f.hyoujyou = "neboke5_red";
    }
  }
} else {
  if(!f.isSekimen){
    f.hyoujyou = "neboke6";
  }else {
    f.hyoujyou = "neboke6_red";
  }
}

} else {
  if(!f.isSekimen){
    f.hyoujyou = "okita";
  }else {
    f.hyoujyou = "okita_red";
  }
}
f.isFirstOsawari = false;
[endscript]
[chara_part name="osawari" hyoujyou=&f.hyoujyou]
[wait time="600"]
[iscript]
if(!f.isAwake){
if((f.suyasuyaGauge / 5) > 30){
  if(!f.isSekimen){
    f.hyoujyou = "neteru1";
  } else {
    f.hyoujyou = "neteru1_red";
  }
}else {
  if(!f.isSekimen){
    f.hyoujyou = "neboke1";
  } else {
    f.hyoujyou = "neboke1_red";
  }
}
} else {
  if(!f.isSekimen){
    f.hyoujyou = "okita";
  } else {
    f.hyoujyou = "okita_red";
  }
}
[endscript]
[chara_part name="osawari" hyoujyou=&f.hyoujyou]
[endif]

[endmacro]

