[macro name="sixnine02" ]


    ;-------------------------------------------------------------

    ;＜【映画から】シックスナイン　２回目＞

    ;シーン回想からの再生の場合、
    ;最初に「再生するシチュエーションを選んでください」のいつものやつを置いて
    ;選ばれたシチュ（段階）から開始
    [if exp="!f.flag_replay" ]

        [fadeoutbgm2 time="6000" ]
        [messageInvisible]
        [wait  time="500"  ]
        [maskStart]
            [bgChange time="0"  method="crossfade"  storage="bk100.jpg"  ]
            [wait  time="500"  ]
            ;スチル表示【02】
            [setSixnineCG cg="02" time="1"]
            [chara_hide_all  time="1"  wait="false"  ]
        [mask_off  time="1000"  effect="fadeOut"  ]
        [messageON]
    [else]
        [setSixnineCG cg="02" time="1"]
        [maskEnd]
        [messageON]
    [endif]
    ;シーン回想の場合はここからスタート。背景bk100、みお立ち絵なし

    [playse  volume="100"  time="1000"  buf="2"  storage="vo_scene/FT_m005_scene2_0017.mp3"  ]
    [tb_start_text mode=3 ]
    #みお
    うぅ～……[p]
    [_tb_end_text]


    [tb_start_text mode=3 ]
    #
    前回はお互い布ごしだったが、[r]
    とはいえ二度目のシックスナインだ。[p]
    [_tb_end_text]


    [tb_start_text mode=3 ]
    #
    みおも覚悟を決めたのか、[r]
    しばしうめいた後に――[p]
    [_tb_end_text]


    [fadeinbgm storage="BGM11_temptation.mp3" time="6000" ]
    ;スチル切替【01】
    [setSixnineCG cg="01" time="300"]

    [playse  volume="100"  time="1000"  buf="2"  storage="vo_scene/FT_m005_scene2_0018.mp3"  ]
    [tb_start_text mode=3 ]
    #みお
    先生、あの……どうぞ……[p]
    [_tb_end_text]

    [tb_start_text mode=3 ]
    #
    恥じらいゆえの言葉足らずだが、[r]
    脱がしてもいい、という思いは伝わった。[p]
    [_tb_end_text]

    [tb_start_text mode=3 ]
    #
    前回、“本当の”シックスナインではないと[r]
    気にしていたようだったから、踏み出したのだろう。[p]
    [_tb_end_text]

    [tb_start_text mode=3 ]
    #
    お言葉に甘えて、下着をずりさげ[r]
    みおの秘部と対面する。[p]
    [_tb_end_text]

    [playse  volume="100"  time="1000"  buf="1"  storage="se/kinuzure1.mp3"  ]
    ;スチル切替【13】
    [setSixnineCG cg="13" time="300"]

    [playse  volume="100"  time="1000"  buf="2"  storage="vo_scene/FT_m005_scene2_0019.mp3"  ]
    [tb_start_text mode=3 ]
    #みお
    うぅ……すっごく見られてる……[p]
    [_tb_end_text]

    [tb_start_text mode=3 ]
    #
    ぴっちり閉じたすじに[r]
    きゅっとすぼまったアナル……絶景だ。[p]
    [_tb_end_text]

    ;スチル切替【14】
    [setSixnineCG cg="14" time="300"]
    [playse  volume="100"  time="1000"  buf="2"  storage="vo_scene/FT_m005_scene2_0020.mp3"  ]
    [tb_start_text mode=3 ]
    #みお
    ……それじゃあわたしも、ズボン、下げますね[p]
    [_tb_end_text]

    ;スチル切替【15】
    [setSixnineCG cg="15" time="300"]
    [playse  volume="100"  time="1000"  buf="2"  storage="vo_scene/FT_m005_scene2_0021.mp3"  ]
    [tb_start_text mode=3 ]
    #みお
    あうっ[p]
    [_tb_end_text]

    [tb_start_text mode=3 ]
    #
    勢いよく飛び出たペニスがみおのほほを[r]
    叩いたようだった。[p]
    [_tb_end_text]

    [tb_start_text mode=3 ]
    #
    見せつける興奮もあり、[r]
    勃起は限界を超えて痛いほどだ……[p]
    [_tb_end_text]

    ;スチル切替【16】
    [setSixnineCG cg="16" time="300"]
    [playse  volume="100"  time="1000"  buf="2"  storage="vo_scene/FT_m005_scene2_0022.mp3"  ]
    [tb_start_text mode=3 ]
    #みお
    お互いのだいじなところ、[r]
    こんな近くで見せ合ってるなんて……[p]
    [_tb_end_text]

    ;スチル切替【17】
    [setSixnineCG cg="17" time="300"]
    [playse  volume="100"  time="1000"  buf="2"  storage="vo_scene/FT_m005_scene2_0023.mp3"  ]
    [tb_start_text mode=3 ]
    #みお
    えっと……[p]
    [_tb_end_text]

    ;スチル切替【16】
    [setSixnineCG cg="16" time="300"]
    [playse  volume="100"  time="1000"  buf="2"  storage="vo_scene/FT_m005_scene2_0024.mp3"  ]
    [tb_start_text mode=3 ]
    #みお
    せーので舐め合うんですか？[p]
    [_tb_end_text]

    [tb_start_text mode=3 ]
    #
    興奮しはじめたかと思うと、とぼけたことを言う。[r]
