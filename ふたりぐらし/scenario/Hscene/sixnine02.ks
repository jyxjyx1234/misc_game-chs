    [_tb_end_text]

    [eval exp="f.firstKiss = addExperience(f.firstKiss,'2014','映画を真似たシックスナインの男性器に')" ]

    ;スチル切替【19】
    [setSixnineCG cg="19" time="300"]
    [playse  volume="100"  time="1000"  buf="2"  storage="vo_scene/FT_m005_scene2_0025.mp3"  ]
    [tb_start_text mode=3 ]
    #みお
    ひゃっ……んぁ、んっ、[r]
    じゅっ、んむぅ、ぷぁぅっ……[p]
    [_tb_end_text]

    ;スチル切替【20】
    [setSixnineCG cg="20" time="300"]
    [playse  volume="100"  time="1000"  buf="2"  storage="vo_scene/FT_m005_scene2_0026.mp3"  ]
    [tb_start_text mode=3 ]
    #みお
    前もいっぱい気持ちよくしてもらったから[r]
    はむぁ、わたしもお返し、しないとっ……[p]
    [_tb_end_text]

    [tb_start_text mode=3 ]
    #
    少し塩気のある外側を舐め尽くし、[r]
    陰唇をかき分け膣口に舌を突き入れていく。[p]
    [_tb_end_text]

    ;スチル切替【21】
    [setSixnineCG cg="21" time="300"]
    [tb_start_text mode=3 ]
    #
    花開くように女陰もほぐれだした。[p]
    [_tb_end_text]


    ;スチル切替【22】
    [setSixnineCG cg="22" time="300"]
    [playse  volume="100"  time="1000"  buf="2"  storage="vo_scene/FT_m005_scene2_0027.mp3"  ]
    [tb_start_text mode=3 ]
    #みお
    ――～～……っ！[p]
    [_tb_end_text]



    [tb_start_text mode=3 ]
    #
    びくびくと震えるみおだが、[r]
    それでも頬張ったペニスをとらえたままだ。[p]
    [_tb_end_text]


    [tb_start_text mode=3 ]
    #
    ペニスに絡む懸命な舌遣いのは、[r]
    こちらの動きに呼応するように緩急をつけている。[p]
    [_tb_end_text]



    [tb_start_text mode=3 ]
    #
    みおに真似しようという意識はないだろう。[r]
    自然と呼吸が合ってきている――それがうれしい。[p]
    [_tb_end_text]


    ;スチル切替【21】
    [setSixnineCG cg="21" time="300"]
    [playse  volume="100"  time="1000"  buf="2"  storage="vo_scene/FT_m005_scene2_0028.mp3"  ]
    [tb_start_text mode=3 ]
    #みお
    はむっ、んんっ、じゅっ、んんぇ[r]
    れるるっ、ずっ、はぷぁ[p]
    [_tb_end_text]

    ;スチル切替【22】
    [setSixnineCG cg="22" time="300"]
    [playse  volume="100"  time="1000"  buf="2"  storage="vo_scene/FT_m005_scene2_0029.mp3"  ]
    [tb_start_text mode=3 ]
    #みお
    ぷあぁ、はふぅぅ、んっ、うぁぅぅっ～[r]
    ちゅ、んぶ……むぅぅぅ、えれぁ、じゅるるっ[p]
    [_tb_end_text]


    [tb_start_text mode=3 ]
    #
    舌に感じる膣壁の蠕動が激しくなった。[r]
    愛液の質も違っている。絶頂が近いのだ。[p]
    [_tb_end_text]



    [tb_start_text mode=3 ]
    #
    イっていいよと合図を送ろうと思ったところで――[p]
    [_tb_end_text]


    ;スチル切替【23】
    [setSixnineCG cg="23" time="300"]

    [playse  volume="100"  time="1000"  buf="2"  storage="vo_scene/FT_m005_scene2_0030.mp3"  ]
    [tb_start_text mode=4 ]
    #みお
    あっ……はぁ、っく……わたし、もう、[r]
    ……だから、先生出してっ、くださいぃっ[l]
    [_tb_end_text]


    [glink_center storage="Hscene/sixnine02.ks"  target="sixnine02_1" text="ッ……――！！" ]
    [s]
    *sixnine02_1
    ;射精演出,BGS停止,スチル切替【24】,
    [setSixnineCG cg="24" time="300" syasei="true"]

    [playse  volume="100"  time="1000"  buf="2"  storage="vo_scene/FT_m005_scene2_0031.mp3"  ]
    [tb_start_text mode=3 ]
    #みお
    むぅぅぅ～～～――……っ！[p]
    [_tb_end_text]

    [tb_start_text mode=3 ]
    #
    ……がくがく震える桃尻を握りしめながら[r]
    みおの喉奥で長い射精をした。[p]
    [_tb_end_text]


    ;射精演出,スチル切替【bk100】

    [syaseiFlashForStill layer="3" storage="../bgimage/bk100.jpg" name="still,bkcg"]

    [tb_start_text mode=3 ]
    #
    …………[p]
    [_tb_end_text]


    [tb_start_text mode=3 ]
    #
    ……[p]
    [_tb_end_text]

    [playse  volume="100"  time="1000"  buf="2"  storage="vo_scene/FT_m005_scene2_0032.mp3"  ]
    [tb_start_text mode=3 ]
    #みお
    けほっ、けほ……[p]
    [_tb_end_text]



    [playse  volume="100"  time="1000"  buf="2"  storage="vo_scene/FT_m005_scene2_0033.mp3"  ]
    [tb_start_text mode=3 ]
