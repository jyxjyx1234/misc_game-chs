[macro name="parkEv2" ]

;-------------------------------
;下記２台詞、シーン回想からでの再生でのみ表示。本編からの場合ははしょる（直前の流れで重複する内容のやりとりがあるので）

    [if exp="f.flag_replay"]
        [messageON]
        [tb_start_text mode=3 ]
        #
        前回とおなじく、「また虫が！」と[r]
        みおに声をかける。[p]
        [_tb_end_text]

        [playse  volume="100"  time="1000"  buf="2"  storage="vo_scene/FT_m006_scene4_0017.mp3"  ]
        [tb_start_text mode=3 ]
        #みお
        ……[p]
        [_tb_end_text]

    [endif]
;-------------------------------

    ;BGM11_temptation.mp3　をtime6000でBGMとして再生開始
    [fadeinbgm storage="BGM11_temptation.mp3" time="6000" ]
    [messageON]
    [playse  volume="100"  time="1000"  buf="2"  storage="vo_scene/FT_m006_scene4_0018.mp3"  ]
    [tb_start_text mode=3 ]
    #みお
    じゃあ、とってください[p]
    [_tb_end_text]

    [messageInvisible]

    [playse  volume="100"  time="1000"  buf="1"  storage="se/kinuzure3.mp3"  ]
    ;【01.png】表示
    [CGSet layer="2" storage="EVcg/koenHstill01/03.png" name="still,park1" time="1000" ]

    [messageON]

    [tb_start_text mode=3 ]
    #
    みおにおどろいた様子はなく、[r]
    ただ恥ずかしそうにスカートをめくる。[p]
    [_tb_end_text]

    [tb_start_text mode=4 ]
    #
    前と様子が違うが、虫を探すふりは[r]
    続けねばならない。[l]
    [_tb_end_text]

    [glink target="*parkEv2_1" addlog="true" text="どれどれ……どこかな……" color="btn_05_black glink_center"  storage=""  size="20"  x="375"  y="400"]
    [s]

    *parkEv2_1
    [CGSet layer="2" storage="EVcg/koenHstill01/01.png" name="still,park1" time="300" ]
    [playse  volume="100"  time="1000"  buf="2"  storage="vo_scene/FT_m006_scene4_0019.mp3"  ]
    [tb_start_text mode=3 ]
    #みお
    居ましたか、虫さん？[p]
    [_tb_end_text]
    [CGSet layer="2" storage="EVcg/koenHstill01/01.png" name="still,park1" time="300" ]
    [playse  volume="100"  time="1000"  buf="2"  storage="vo_scene/FT_m006_scene4_0020.mp3"  ]
    [tb_start_text mode=3 ]
    #みお
    本当はいないんじゃないんですか？[r]
    この前だって……[p]
    [_tb_end_text]

    [tb_start_text mode=3 ]
    #
    ちょっと動揺するが――わかった上で[r]
    小芝居に乗ったのならば話が違ってくる。[p]
    [_tb_end_text]
    [CGSet layer="2" storage="EVcg/koenHstill01/02.png" name="still,park1" time="300" ]
    [playse  volume="100"  time="1000"  buf="2"  storage="vo_scene/FT_m006_scene4_0021.mp3"  ]
    [tb_start_text mode=3 ]
    #みお
    夜とはいえ公園でなんて……って[r]
    すごく恥ずかしいんですが……[p]
    [_tb_end_text]
    [CGSet layer="2" storage="EVcg/koenHstill01/03.png" name="still,park1" time="300" ]
    [playse  volume="100"  time="1000"  buf="2"  storage="vo_scene/FT_m006_scene4_0022.mp3"  ]
    [tb_start_text mode=3 ]
    #みお
    先生が望むなら少しぐらいは[r]
    お付き合いしても、って思って……[p]
    [_tb_end_text]

    [tb_start_text mode=3 ]
    #
    みおの足元からすっと立ち上がる。[p]
    [_tb_end_text]
    [CGSet layer="2" storage="EVcg/koenHstill01/01.png" name="still,park1" time="300" ]
    [playse  volume="100"  time="1000"  buf="2"  storage="vo_scene/FT_m006_scene4_00231.mp3"  ]
    [tb_start_text mode=4 ]
    #みお
    ……？　もう、いいですか？[l]
    [_tb_end_text]

    [glink target="*parkEv2_2" addlog="true" text="虫はブラウスの方に入ったかも" color="btn_05_black glink_center"  storage=""  size="20"  x="375"  y="400"]
    [s]

    *parkEv2_2
    [tb_start_text mode=3 ]
    #
    言って、みおの乳房をはだけさせる。[p]
    [_tb_end_text]

    ;【01b.png】切替
    [CGSet layer="2" storage="EVcg/koenHstill01/05.png" name="still,park1b" time="1000" ]
    [free layer="2" name="park1" ]


    [playse  volume="100"  time="1000"  buf="2"  storage="vo_scene/FT_m006_scene4_0024.mp3"  ]
    [tb_start_text mode=3 ]
    #みお
    ふわわわわっ！？[r]
    なっ、ななんてことするんですかっ[p]
    [_tb_end_text]

    [tb_start_text mode=3 ]
    #
    身じろぎに合わせ、解放された巨乳が[r]
    ゆさゆさとゆれた。[p]
    [_tb_end_text]

    [tb_start_text mode=3 ]
    #
    しーっ、とジェスチャーをする。[r]
    幸い周囲にひと気はないが。[p]
    [_tb_end_text]
    [CGSet layer="2" storage="EVcg/koenHstill01/06.png" name="still,park1" time="300" ]
    [playse  volume="100"  time="1000"  buf="2"  storage="vo_scene/FT_m006_scene4_0025.mp3"  ]
    [tb_start_text mode=3 ]
    #みお
    ……！[p]
    [_tb_end_text]
    [CGSet layer="2" storage="EVcg/koenHstill01/07.png" name="still,park1" time="300" ]
    [playse  volume="100"  time="1000"  buf="2"  storage="vo_scene/FT_m006_scene4_0026.mp3"  ]
    [tb_start_text mode=3 ]
    #みお
    うぅ～……見つかりそうになったら[r]
    ちゃんとかばってくださいよぅ……[p]
    [_tb_end_text]
    [CGSet layer="2" storage="EVcg/koenHstill01/06.png" name="still,park1" time="300" ]
    [playse  volume="100"  time="1000"  buf="2"  storage="vo_scene/FT_m006_scene4_0027.mp3"  ]
    [tb_start_text mode=3 ]
    #みお
    やっぱり虫さんなんていなかったんだ……[p]
    [_tb_end_text]

    [tb_start_text mode=3 ]
    #
    いやいやここに居るじゃないか、と[r]
    布越しにクリトリスを弾く。[p]
    [_tb_end_text]
    [CGSet layer="2" storage="EVcg/koenHstill01/05.png" name="still,park1" time="300" ]
    [playse  volume="100"  time="1000"  buf="2"  storage="vo_scene/FT_m006_scene4_0028.mp3"  ]
    [tb_start_text mode=3 ]
    #みお
    ひゃあっ！[p]
    [_tb_end_text]
    [tb_start_text mode=3 ]
    #
    そのまま下着をずり下げる。[p]
    [_tb_end_text]
    ;【02b.png】切替
    [CGSet layer="2" storage="EVcg/koenHstill01/08.png" name="still,park2" time="300" ]
    [free layer="2" name="park1b" ]
    [playse  volume="100"  time="1000"  buf="2"  storage="vo_scene/FT_m006_scene4_0029.mp3"  ]
    [tb_start_text mode=3 ]
    #みお
    あっ、あぁ、やぁぁ……[p]
    [_tb_end_text]

    [playse  volume="100"  time="1000"  buf="1"  storage="se/manko1.mp3"  ]
    [CGSet layer="2" storage="EVcg/koenHstill01/09.png" name="still,park1" time="300" ]


    [tb_start_text mode=3 ]
    #
    さらに秘裂に指を滑り込ませる。[r]
    ――ぬるりと抵抗なく入っていた。[p]
    [_tb_end_text]

    [tb_start_text mode=3 ]
    #
    なんだ、ここまでの露出プレイで[r]
    みおも興奮していたんじゃないか。[p]
    [_tb_end_text]

    [CGSet layer="2" storage="EVcg/koenHstill01/10.png" name="still,park1" time="300" ]
    [playse  volume="100"  time="1000"  buf="2"  storage="vo_scene/FT_m006_scene4_0030.mp3"  ]
    [tb_start_text mode=3 ]
    #みお
    ろっ、露出プレ……わたし、[r]
    そんなんじゃあっ[p]
    [_tb_end_text]

    [tb_start_text mode=3 ]
    #
    指を動かすと激しい水音がひびく。[p]
    [_tb_end_text]
    [CGSet layer="2" storage="EVcg/koenHstill01/09.png" name="still,park1" time="300" ]
    [playse  volume="100"  time="1000"  buf="2"  storage="vo_scene/FT_m006_scene4_0031.mp3"  ]
    [tb_start_text mode=4 ]
    #みお
    んんぅぅぅっ、声っ、[r]
    おさえられ、せんせっ、んやぁああっ[l]
    [_tb_end_text]

    [glink target="*parkEv2_3" addlog="true" text="こんな濡らして、興奮してたでしょ" color="btn_05_black glink_center"  storage=""  size="20"  x="375"  y="400"]
    [s]

    *parkEv2_3
    [CGSet layer="2" storage="EVcg/koenHstill01/11.png" name="still,park1" time="300" ]
    [playse  volume="100"  time="1000"  buf="2"  storage="vo_scene/FT_m006_scene4_0032.mp3"  ]
    [tb_start_text mode=3 ]
    #みお
    はい、してました、してましたから、[r]
    そんな激しくしないで……っ[p]
    [_tb_end_text]

    [tb_start_text mode=3 ]
    #
    こんなのは撫でてる程度だ。[r]
    激しいというのは――[p]
    [_tb_end_text]
    [CGSet layer="2" storage="EVcg/koenHstill01/12.png" name="still,park1" time="300" ]
    [playse  volume="100"  time="1000"  buf="2"  storage="vo_scene/FT_m006_scene4_0033.mp3"  ]
    [tb_start_text mode=3 ]
    #みお
    ひ――ああぁぁあぁぁっ、[r]
    だめっ、だめですぅぅ[p]
    [_tb_end_text]
    [CGSet layer="2" storage="EVcg/koenHstill01/11.png" name="still,park1" time="300" ]
    [playse  volume="100"  time="1000"  buf="2"  storage="vo_scene/FT_m006_scene4_0034.mp3"  ]
    [tb_start_text mode=3 ]
    #みお
    漏れてるっ、なんか漏れて――[r]
    うきゅうぅぅぅっ[p]
    [_tb_end_text]

    [tb_start_text mode=3 ]
    #
    膣内のざらざらを擦り上げるような[r]
    激しい手マン。[p]
    [_tb_end_text]

    [tb_start_text mode=3 ]
    #
    一往復ごとに尿だか潮だかのしぶきが散って[r]
    草むらに湯気を立てている。[p]
    [_tb_end_text]
    [CGSet layer="2" storage="EVcg/koenHstill01/13.png" name="still,park1" time="300" ]
    [playse  volume="100"  time="1000"  buf="2"  storage="vo_scene/FT_m006_scene4_0035.mp3"  ]
    [tb_start_text mode=3 ]
    #みお
    んんっ、んんっ、やだぁっ、[r]
    みんなの公園、汚しちゃぅうぅっ、おんんっ[p]
    [_tb_end_text]

    [tb_start_text mode=3 ]
    #
    倒れまいと踏ん張るみおの動きは[r]
    かえって“いいところ”を責めやすくする。[p]
    [_tb_end_text]
    [CGSet layer="2" storage="EVcg/koenHstill01/14.png" name="still,park1" time="300" ]
    [playse  volume="100"  time="1000"  buf="2"  storage="vo_scene/FT_m006_scene4_0036.mp3"  ]
    [tb_start_text mode=3 ]
    #みお
    あっ、あぁぁ……あぁぁあ～……っ[p]
    [_tb_end_text]

    [tb_start_text mode=3 ]
    #
    ……そろそろのようだ。[p]
    [_tb_end_text]

    [tb_start_text mode=3 ]
    #
    イっていいよ、と耳打ちすると[r]
    みおの頭はそれ一色になってしまった。[p]
    [_tb_end_text]
    [CGSet layer="2" storage="EVcg/koenHstill01/15.png" name="still,park1" time="300" ]
    [playse  volume="100"  time="1000"  buf="2"  storage="vo_scene/FT_m006_scene4_0037.mp3"  ]
    [tb_start_text mode=3 ]
    #みお
    は、はひっ、イきたい、イキたいのぉ[p]
    [_tb_end_text]

    [CGSet layer="2" storage="EVcg/koenHstill01/14.png" name="still,park1" time="300" ]
    [playse  volume="100"  time="1000"  buf="2"  storage="vo_scene/FT_m006_scene4_0038.mp3"  ]
    [tb_start_text mode=4 ]
    #みお
    イク、イクイクぅぅ～～ッ[l]
    [_tb_end_text]

    [glink target="*parkEv2_4" addlog="true" text="とどめだ！" color="btn_05_black glink_center"  storage=""  size="20"  x="375"  y="400"]
    [s]

    *parkEv2_4
    ;みお絶頂表現のピンクフラッシュ
    [CGSet layer="2" storage="EVcg/koenHstill01/13.png" name="still,park1" time="300" ]
    [flash type="zettyou"]
    
    [playse  volume="100"  time="1000"  buf="2"  storage="vo_scene/FT_m006_scene4_0039.mp3"  ]
    [tb_start_text mode=3 ]
    #みお
    あっ、ああぁぁ――～～……！！[p]
    [_tb_end_text]

    ;みお絶頂表現のピンクフラッシュもういっかい
    [flash type="zettyou"]

    [tb_start_text mode=3 ]
    #
    ぶしゃぶしゃと潮を噴きながら[r]
    痙攣する身体がもたれかかってくる。[p]
    [_tb_end_text]

    ;スチルとしてbk100.jpgを最前面に表示して画面を真っ暗化
    [image layer="4" storage="../bgimage/bk100.jpg" time="100" name="bkcg" ]
    [free layer="2" name="still" ]
    [playse  volume="100"  time="1000"  buf="2"  storage="vo_scene/FT_m006_scene4_0040.mp3"  ]
    [tb_start_text mode=3 ]
    #みお
    あ、あぁぁ……わた、わたし、公園で……[r]
    イっちゃいましたぁ……[p]
    [_tb_end_text]


    ;BGM停止。time6000
    [fadeoutbgm2 time="6000" ]

    [tb_start_text mode=3 ]
    #
    急いでひとめにつかないところへ[r]
    みおを連れ込み、休ませることとした。[p]
    [_tb_end_text]

    [tb_start_text mode=3 ]
    #
    ……このぶんだと、次は“最後”まで[r]
    できるかもしれないな。[p]
    [_tb_end_text]

    [tb_hide_message_window  ]

    ;シーン回想からの場合はここで終了。

    [if exp="f.flag_replay!=true"]
        [calcMioHP HP="-20"]
        ;みお性経験加算
        ;　「露出・調教」に+1、開発度膣+1、開発度陰核+1、開発度乳房+1、絶頂数膣+1、
        [eval exp="f.masochism++" ]
        [eval exp="f.cunt++" ]
        [eval exp="f.clitoris++" ]
        [eval exp="f.bust++" ]
        [eval exp="f.cuntTotalOrgasm++" ]
        [eval exp="f.parkHNow = true" ]
        ;ゲーム本編からの場合は、このあとADVパートのやりとりを経て帰宅する。
        [eval exp="f.parkEv = 2" ]
    [endif]
[endmacro]