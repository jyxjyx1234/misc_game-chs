    ;【04.png】切替　→★後半スチル切替【10】へ変更
    [setKoen2CG cg="10" syasei="true"]
    [free layer="2" name="park3" ]

    [playse  volume="100"  time="1000"  buf="2"  storage="vo_scene/FT_m006_scene4_0067.mp3"  ]
    [tb_start_text mode=3 ]
