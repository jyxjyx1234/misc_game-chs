    [_tb_end_text]

    ;★後半スチル切替【06】
    [setKoen2CG cg="06" time="300"]
    [playse  volume="100"  time="1000"  buf="2"  storage="vo_scene/FT_m006_scene4_0059.mp3"  ]
    [tb_start_text mode=3 ]
    #みお
    ん……た、倒れちゃいそう[r]
    ちゃんと支えてくださいね……？[p]
    [_tb_end_text]

    [tb_start_text mode=3 ]
    #
    夜の公園の空気は冷たく澄んでいて、[r]
    みおの中は真逆の粘性の熱量を帯びている。[p]
    [_tb_end_text]


    [tb_start_text mode=3 ]
    #
    不安定な姿勢のためか、膣内のひだは[r]
