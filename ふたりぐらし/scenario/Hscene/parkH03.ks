    [_tb_end_text]

    ;★後半スチル切替【01】
    
    [setKoen2CG cg="01" time="300"]
    [free layer="2" name="park1"]
    [playse  volume="100"  time="1000"  buf="2"  storage="vo_scene/FT_m006_scene4_0050.mp3"  ]
    [tb_start_text mode=3 ]
    #みお
    う――ぁ――[p]
    [_tb_end_text]

    ;★後半スチル切替【02】
    [setKoen2CG cg="02" time="300"]
    [playse  volume="100"  time="1000"  buf="2"  storage="vo_scene/FT_m006_scene4_0051.mp3"  ]
    [tb_start_text mode=3 ]
    #みお
    先生の、もうそんなにおっきく……[r]
    すごく赤くて……熱そう、で……ッ……[p]
    [_tb_end_text]

    ;★後半スチル切替【03】
    [setKoen2CG cg="03" time="300"]
    [playse  volume="100"  time="1000"  buf="2"  storage="vo_scene/FT_m006_scene4_0052.mp3"  ]
    [tb_start_text mode=3 ]
    #みお
    お腹につきそうなくらい反り返って……[r]
    すご……ぃ……[p]
    [_tb_end_text]

    ;★後半スチル切替【02】
    [setKoen2CG cg="02" time="300"]
    [playse  volume="100"  time="1000"  buf="2"  storage="vo_scene/FT_m006_scene4_0053.mp3"  ]
    [tb_start_text mode=3 ]
    #みお
    あ、の……そんなになって……[r]
    先生も、苦しくないん、ですか？[p]
    [_tb_end_text]

    [tb_start_text mode=3 ]
    #
    うなずきたいのをこらえて、[r]
    無反応を貫く。ここは根競べだ。[p]
    [_tb_end_text]

    ;★後半スチル切替【01】
    [setKoen2CG cg="01" time="300"]
    [playse  volume="100"  time="1000"  buf="2"  storage="vo_scene/FT_m006_scene4_0054.mp3"  ]
    [tb_start_text mode=3 ]
    #みお
    ――……[p]
    [_tb_end_text]

    ;★後半スチル切替【04】
    [setKoen2CG cg="04" time="300"]
    [playse  volume="100"  time="1000"  buf="2"  storage="vo_scene/FT_m006_scene4_0055.mp3"  ]
