    [_tb_end_text]

    ;★後半スチル切替【08】
    [setKoen2CG cg="08" time="300"]
    [playse  volume="100"  time="1000"  buf="2"  storage="vo_scene/FT_m006_scene4_0064.mp3"  ]
    [tb_start_text mode=3 ]
