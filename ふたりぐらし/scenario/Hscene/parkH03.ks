        [playse  volume="100"  time="1000"  buf="2"  storage="vo_scene/FT_m006_scene4_0057.mp3"  ]
        [tb_start_text mode=3 ]
        #みお
        うやあああぁっん！？[r]
        お、おなか……ぎちぎち……っ[p]
        [_tb_end_text]

        [tb_start_text mode=3 ]
        #
        体勢のためか、みおの膣内は[r]
        生娘のようにキツく硬い。[p]
        [_tb_end_text]

        ;　→次の共通部へ
    [endif]
    ;-------------------------------------
    ;【共通部】

    ;★後半スチル切替【07】
    [setKoen2CG cg="07" time="300"]
    [playse  volume="100"  time="1000"  buf="2"  storage="vo_scene/FT_m006_scene4_0058.mp3"  ]
    [tb_start_text mode=3 ]
    #みお
    さっき、まで遊具で遊んでたのにっ、[r]
    こんなことはじめちゃって……あぁ……[p]
    [_tb_end_text]

    ;【BGS】piston1.mp3,time6000で再生
    [fadeinse storage="BGS/piston1.mp3" buf="0"  time="6000" loop="true" ]

    [tb_start_text mode=3 ]
    #
    野外セックス、いわゆるアオカンを[r]
