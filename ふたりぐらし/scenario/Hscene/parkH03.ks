    ;★後半スチル切替【13】
    [setKoen2CG cg="13" time="300"]
    [playse  volume="100"  time="1000"  buf="2"  storage="vo_scene/FT_m006_scene4_0069.mp3"  ]
    [tb_start_text mode=3 ]
