    [glink target="*parkEv3_3" addlog="true" text="よくできました――" color="btn_05_black glink_center"  storage=""  size="20"  x="375"  y="400"]
    [s]

    *parkEv3_3

    ;★後半スチル切替【05】、直下の指示と入れ替え
    [setKoen2CG cg="05" time="300"]


    ;-------------------------------------
    ;【分岐】みおが処女だった場合
    [if exp="f.virgin.image.id == 0" ]

        [playse  volume="100"  time="1000"  buf="2"  storage="vo_scene/FT_m006_scene4_0056.mp3"  ]
        [tb_start_text mode=3 ]
        #みお
        うやあああぁっん！？[p]
        [_tb_end_text]

        ;★後半スチル切替【06】、直下のテキストとボイスも調整しています
        [setKoen2CG cg="06" time="300"]
        [playse  volume="100"  time="1000"  buf="2"  storage="vo_part/FT_m006_part0020.mp3"  ]
        [tb_start_text mode=3 ]
        #みお
        これが、わたしのはじめて……[p]
        [_tb_end_text]

        [tb_start_text mode=3 ]
        #
        確かに、なかなか無い処女喪失かもな。[p]
        [_tb_end_text]

        [tb_start_text mode=3 ]
        #
        そういうことは清潔なベッドの上で、と[r]
        ロマンティックな想像をしていたかもしれない。[p]
        [_tb_end_text]

        [tb_start_text mode=3 ]
        #
        だがこれが自分とみおのふたりの思い出だ。[p]
        [_tb_end_text]

        ;みお破瓜設定。別途マクロ作成を相談中なので、そっちができ次第の対応
        [eval exp="f.virgin = addExperience(f.virgin,'2031','みんなの公園で、制服を着たまま青姦して')" ]
        ;　→次の共通部へ

    [else]
        ;-------------------------------------
