[macro name="parkEv3" ]

    ;ゲーム本編からの開始の場合は直前の画面でそのままADV展開


    ;BGM停止。time6000
    [fadeoutbgm2 time="6000" ]
    ;シーン回想からの場合はここから開始。みお立ち絵なし、背景はbk100

    [messageON]
    [tb_start_text mode=3 ]
    #
    呼びかけると、みおは顔を赤らめつつ[r]
    殊勝に従って歩いてきた。[p]
    [_tb_end_text]

    [tb_start_text mode=3 ]
    #
    さきほどまでの無邪気さが[r]
    うそのようだ。[p]
    [_tb_end_text]

    [playse  volume="100"  time="1000"  buf="2"  storage="vo_scene/FT_m006_scene4_0041.mp3"  ]
    [tb_start_text mode=4 ]
    #みお
    ……また虫さん、ですか？[l]
    [_tb_end_text]

    [glink target="*parkEv3_1" addlog="true" text="違うけど、なにをすべきかわかるね？" color="btn_05_black glink_center"  storage=""  size="20"  x="375"  y="400"]
    [s]

    *parkEv3_1
    [playse  volume="100"  time="1000"  buf="2"  storage="vo_scene/FT_m006_scene4_0042.mp3"  ]
    [tb_start_text mode=3 ]
    #みお
    あ……[p]
    [_tb_end_text]

    [playse  volume="100"  time="1000"  buf="2"  storage="vo_scene/FT_m006_scene4_0043.mp3"  ]
    [tb_start_text mode=3 ]
    #みお
    は、はい[p]
    [_tb_end_text]

    [messageInvisible]

    ;BGM11_temptation.mp3　をtime6000でBGMとして再生開始
    [fadeinbgm storage="BGM11_temptation.mp3" time="6000" ]

    [playse  volume="100"  time="1000"  buf="1"  storage="se/kinuzure3.mp3"  ]
    ;【01.png】表示
    [CGSet layer="2" storage="EVcg/koenHstill01/02.png" name="still,park1" time="1000" ]

    [messageON]

    [playse  volume="100"  time="1000"  buf="2"  storage="vo_scene/FT_m006_scene4_0044.mp3"  ]
    [tb_start_text mode=4 ]
    #みお
    や、やりまし、た……[l]
    [_tb_end_text]

    [glink target="*parkEv3_2" addlog="true" text="そこだけ？" color="btn_05_black glink_center"  storage=""  size="20"  x="375"  y="400"]
    [s]
    *parkEv3_2
    [CGSet layer="2" storage="EVcg/koenHstill01/03.png" name="still,park1" time="300" ]
    [playse  volume="100"  time="1000"  buf="2"  storage="vo_scene/FT_m006_scene4_0045.mp3"  ]
    [tb_start_text mode=3 ]
    #みお
    いえ……まだ、です[p]
    [_tb_end_text]

    ;【01b.png】切替
    [CGSet layer="2" storage="EVcg/koenHstill01/07.png" name="still,park1b" time="1000" ]
    [free layer="2" name="park1" ]

    [tb_start_text mode=3 ]
    #
    回を重ねるごとにエスカレートする[r]
    公園プレイだが、すっかり調教じみてきた。[p]
    [_tb_end_text]

    [tb_start_text mode=3 ]
    #
    夜気にさらされた乳首は興奮もあいまって[r]
    見る間にかたく尖っていき――[p]
    [_tb_end_text]

    [tb_start_text mode=3 ]
    #
    股ぐらが垂らすよだれは太ももを伝って[r]
    公園の下草を濡らしていく。[p]
    [_tb_end_text]

    ;【02b.png】切替
    [CGSet layer="2" storage="EVcg/koenHstill01/09.png" name="still,park2b" time="1000" ]
    [free layer="2" name="park1b" ]

    [tb_start_text mode=3 ]
    #
    無造作にみこの股間へ手を突っ込む。[r]
    当たり前のようにぐしょぐしょだ。[p]
    [_tb_end_text]
    [CGSet layer="2" storage="EVcg/koenHstill01/12.png" name="still,park1" time="300" ]
    [playse  volume="100"  time="1000"  buf="2"  storage="vo_scene/FT_m006_scene4_0046.mp3"  ]
    [tb_start_text mode=3 ]
    #みお
    やああぁ……[p]
    [_tb_end_text]

    [tb_start_text mode=3 ]
    #
    すっかり露出まがいのプレイで[r]
    濡らす変態になったものだ。[p]
    [_tb_end_text]

    [tb_start_text mode=3 ]
    #
    他のだれにもこんなみおを[r]
    見せてやるつもりはないけれど。[p]
    [_tb_end_text]
    [CGSet layer="2" storage="EVcg/koenHstill01/11.png" name="still,park1" time="300" ]
    [playse  volume="100"  time="1000"  buf="2"  storage="vo_scene/FT_m006_scene4_0047.mp3"  ]
    [tb_start_text mode=3 ]
    #みお
    あ、あふぁ……っく、ひぁぁ……[p]
    [_tb_end_text]

    [tb_start_text mode=3 ]
    #
    感慨にふけっていると、みおが勝手に[r]
    腰をくねらせてヨガり始めていた。[p]
    [_tb_end_text]

    [tb_start_text mode=3 ]
    #
    そのままにさせておく。[r]
    こっちからの動きはナシだ。[p]
    [_tb_end_text]
    [CGSet layer="2" storage="EVcg/koenHstill01/12.png" name="still,park1" time="300" ]
    [playse  volume="100"  time="1000"  buf="2"  storage="vo_scene/FT_m006_scene4_0048.mp3"  ]
    [tb_start_text mode=3 ]
    #みお
    先生の、指……太くて、奥……[r]
    とどいて……ふわぁぁ……っ、っ……[p]
    [_tb_end_text]
    [CGSet layer="2" storage="EVcg/koenHstill01/16.png" name="still,park1" time="300" ]
    [playse  volume="100"  time="1000"  buf="2"  storage="vo_scene/FT_m006_scene4_0049.mp3"  ]
    [tb_start_text mode=3 ]
    #みお
    うぅぅ……でも、足りなくて……[r]
    これだけじゃ、前みたいにはイけな……[p]
    [_tb_end_text]

    ;;;;;;;;;;;;;;;★このあたりからスチル的には後半の挿入パートへ

    ;絵をあてるなら、画面外からペニスだけ出てる差分だけど、テキスト表現だけで別によいだろう。
    [tb_start_text mode=3 ]
    #
    無言で屹立したペニスをズボンから[r]
