    [tb_start_text mode=3 ]
    #みお
    ――～～……っ[r]
    や、ぁぁ……[p]
    [_tb_end_text]


    ;スチル切替【08】
    [CGSetAndDelete layer="2" storage="EVcg/roterTikubi/08.png" name="still,rotor08" time="1000"]

