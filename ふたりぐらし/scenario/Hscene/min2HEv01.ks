
;★下記のようにスチルの命名規則を定めます

;00_01　：分岐前
;01_01　：膣挿入以降
;02_01　：アナル挿入以降

;--------------------------------

[macro name="min2HEv01" ]
    ;-----------------
    ;シーン回想の場合、ここからスタート（立ち絵なし、BGはbk100）
    ;-----------------
    [if exp="f.flag_replay"]
        [maskEnd]
        
        [jump target="*supplementEv01_11" ]
    [endif]

    *supplementEv01_11

    [fadeinbgm storage="BGM11_temptation.mp3" time="6000" ]
    ;★仮スチル表示【00_01.png】
    [setMin2CG cg="00_01"]
    [messageON]
    [playse  volume="100"  time="1000"  buf="2"  storage="vo_scene/FT_m012_scene1_0013.mp3"  ]
    [tb_start_text mode=3 ]
    #みお
    ひゃああっ！？[p]
    [_tb_end_text]

    ;★仮スチル切替【00_02.png】
    [setMin2CG cg="00_02"]
    [playse  volume="100"  time="1000"  buf="2"  storage="vo_scene/FT_m012_scene1_0014.mp3"  ]
    [tb_start_text mode=3 ]
    #みお
    はっ、恥ずかしいですぅっ、せんせぇっ[p]
    [_tb_end_text]

    [tb_start_text mode=3 ]
    #
    軽いだけではなく、みおの身体はやわらかく、[r]
    こういう無理な体勢も苦ではないようだ。[p]
    [_tb_end_text]

    ;★仮スチル切替【00_03.png】
