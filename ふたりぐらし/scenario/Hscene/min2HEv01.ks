    ちょっと、息の仕方、わかってきた、かも……[p]
    [_tb_end_text]

    ;★スチル切替【02_14.png】
    [setMin2CG cg="02_14"]
    [playse  volume="100"  time="1000"  buf="2"  storage="vo_scene/FT_m012_scene1_0085.mp3"  ]
    [tb_start_text mode=3 ]
    #みお
    おちんちん入ってくるときに、んっ……[r]
    息、吐き切ってぇ……[p]
    [_tb_end_text]

    ;★スチル切替【02_15.png】
    [setMin2CG cg="02_15"]
    [playse  volume="100"  time="1000"  buf="2"  storage="vo_scene/FT_m012_scene1_0086.mp3"  ]
    [tb_start_text mode=4 ]
    #みお
    そしたらずるんって入ってくる、っからぁ、[r]
    そこで吸いながらおしり、締めるのぉっ[l]
    [_tb_end_text]

    ;一択選択肢：みお……それ、ヤバい……っ！
    [glink_center storage="Hscene/min2HEv01.ks" target="*supplementEv01_13_6" text="みお……それ、ヤバい……っ！"]
    [s]


    *supplementEv01_13_6
    ;★スチル切替【02_09.png】
    [setMin2CG cg="02_09"]
    [playse  volume="100"  time="1000"  buf="2"  storage="vo_scene/FT_m012_scene1_0087.mp3"  ]
    [tb_start_text mode=3 ]
    #みお
    ヤバ……い……？　せんせえ、イきそぉ？[p]
    [_tb_end_text]

    ;★スチル切替【02_13.png】
    [setMin2CG cg="02_13"]
    [playse  volume="100"  time="1000"  buf="2"  storage="vo_scene/FT_m012_scene1_0088.mp3"  ]
    [tb_start_text mode=4 ]
    #みお
    イって、おしりのなかにせいえきほしい、からぁっ[r]
    せんせえっ[l]
    [_tb_end_text]


    ;一択選択肢：出る――ッ！
    [glink_center storage="Hscene/min2HEv01.ks" target="*supplementEv01_13_7" text="出る――ッ！"]
    [s]

    ;射精演出,BGS停止、    ;★スチル切替【02_16.png】
    *supplementEv01_13_7
    [stopse buf="0" ]
    [setMin2CG cg="02_16" syasei="true"]

    [playse  volume="100"  time="1000"  buf="2"  storage="vo_scene/FT_m012_scene1_0089.mp3"  ]
    [tb_start_text mode=3 ]
    #みお
    ンッ♡　ンン――～～……ッ♡♡[p]
    [_tb_end_text]


    ;★スチル切替【02_17.png】
    [setMin2CG cg="02_17"]
    ;　→　SE再生[playse  volume="100"  time="1000"  buf="1"  storage="se/nameru2.mp3"  ]
    [playse  volume="100"  time="1000"  buf="1"  storage="se/nameru2.mp3"  ]
    [wait time="&f.WAIT_TIME" ]
    ;　→　スチル切替【【02_18.png】
    [setMin2CG cg="02_18"]

    [playse  volume="100"  time="1000"  buf="2"  storage="vo_scene/FT_m012_scene1_0090.mp3"  ]
    [tb_start_text mode=3 ]
    #みお
    あはぁ……♡[r]
    おしり、閉まんなくなっちゃったぁ……♡[p]
    [_tb_end_text]



    ;シーン回想の場合、ここで終了

    [if exp="f.flag_replay" ]
        [jump target="*supplementEv01_end" ]
    [else]

        ;みお性経験加算
        ;開発度アナル+1、絶頂数アナル+2、アナルセックス+1、肛内射精+1
        [eval exp="f.anus++" ]
        [eval exp="f.anusTotalOrgasm+=2" ]
        [eval exp="f.analsexTotal++" ]
        [eval exp="f.analCum++" ]
        ;　★終了共通部へジャンプ
        [jump target="*supplementEv01_common" ]
    [endif]
    ;------------------------------------------------------------------------
    ;------------------------------------------------------------------------
    ;以上

    ;---------------------------------------------
        ;★終了共通部（別のロリ化えっちのシーンと同じ）
    *supplementEv01_common
        ;みお体力-20
        [calcMioHP HP="-20" ]

        [fadeoutbgm2 time="6000" ]

        [addTime minutes=30]

        [tb_start_text mode=3 ]
        #
        気をやってしまったみおを[r]
        そっとベッドに横たえる。[p]
        [_tb_end_text]

        [setBK time="300"]

        [tb_start_text mode=3 ]
        #
        相当な負担をかけてしまったし、[r]
        今日はこのまま休ませることにしよう。[p]
        [_tb_end_text]

        [tb_start_text mode=3 ]
        #
        きっと明日にはサプリの効果も切れて[r]
        みおも元の姿になっているはず。[p]
        [_tb_end_text]


        [addTime minutes=270]

        [tb_start_text mode=3 ]
        #
        …………[p]
        [_tb_end_text]


        [addTime minutes=270]

        [tb_start_text mode=3 ]
        #
        ……[p]
        [_tb_end_text]

        ;翌日へ
        [eval exp="f.todayEnd = true" ]
        [maskStart]
            [deleteBK time="1"]
            [free layer="2" name="still" ]
            [bgChange storage="bk100.jpg" time="0"]
            [chara_hide_all time="0" ]
            [setreplay name="supplementEv" storage="replay_select.ks" target="supplement_select"]

    *supplementEv01_end
[endmacro]