[tb_start_tyrano_code]
[macro name="全脱ぎ開放"]
[eval exp="f.服脱ぎ = 3"]
[eval exp="f.ブラ脱ぎ = 1"]
[eval exp="f.スカート脱ぎ = 2"]
[eval exp="f.靴下脱ぎ = 1"]
[endmacro]
[_tb_end_tyrano_code]

[tb_start_tyrano_code]
[macro name="脱ぎ初期化"]
