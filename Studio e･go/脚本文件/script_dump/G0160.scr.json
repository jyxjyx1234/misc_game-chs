    {
        "op": "str",
        "content": [
            {
                "type": "t",
                "content": "ちょっと前までは、オレはものすごくむかついてたんだけど……部屋に戻ったとたんに、後悔しちまった。"
            }
        ]
    },
    {
        "op": "03",
