                        "content": "*"
                    }
                ]
            }
        ]
    },
    {
        "op": "str",
        "content": [
            {
                "type": "t",
                "content": "さっきまで翔に腹を立てていた。"
            }
        ]
    },
    {
        "op": "03",
        "content": [
            {
                "type": "o",
                "content": [
                    {
                        "type": "b",
                        "content": ""
                    }
                ]
            }
        ]
    },
    {
        "op": "str",
        "content": [
            {
                "type": "t",
                "content": "だいたい、翔は猪突猛進過ぎる。"
            }
        ]
    },
    {
        "op": "03",
        "content": [
            {
                "type": "o",
                "content": [
                    {
                        "type": "b",
                        "content": ""
                    }
                ]
            }
        ]
    },
    {
        "op": "str",
        "content": [
            {
                "type": "t",
                "content": "薬だって、確かめないで飲むからあんな犬耳が生えちゃうし……前後の見境なく、洞穴に飛び込んだりするし……あげくに、僕が一番気にしてること――方向音痴のことを何回もあげつらうし……"
            }
        ]
    },
    {
        "op": "03",
        "content": [
            {
                "type": "o",
                "content": [
                    {
                        "type": "b",
                        "content": ""
                    }
                ]
            }
        ]
    },
    {
        "op": "str",
        "content": [
            {
                "type": "t",
                "content": "だから、売り言葉に買い言葉でケンカをしてしまったんだけど……"
            }
        ]
    },
    {
        "op": "03",
        "content": [
            {
                "type": "o",
                "content": [
                    {
                        "type": "b",
                        "content": ""
                    }
                ]
            }
        ]
    },
    {
        "op": "str",
        "content": [
            {
                "type": "t",
                "content": "でも、冷静になって考えてみたら……"
            }
        ]
    },
    {
        "op": "03",
        "content": [
            {
                "type": "o",
                "content": [
                    {
                        "type": "b",
                        "content": ""
                    }
                ]
            }
        ]
    },
    {
        "op": "str",
        "content": [
            {
                "type": "t",
                "content": "薬は、ちゃんと説明しなかった僕にも責任はあるし……（全面的に僕の責任だとは思わないけど……）"
            }
        ]
    },
    {
        "op": "03",
        "content": [
            {
                "type": "o",
                "content": [
                    {
                        "type": "b",
                        "content": ""
                    }
                ]
            }
        ]
    },
    {
        "op": "str",
        "content": [
            {
                "type": "t",
                "content": "翔が洞穴に飛び込んだのは、僕のことを心配してくれたからだし……（とはいえ、短慮なのは否めない）"
            }
        ]
    },
    {
        "op": "03",
        "content": [
            {
                "type": "o",
                "content": [
                    {
                        "type": "b",
                        "content": ""
                    }
                ]
            }
        ]
    },
    {
        "op": "str",
        "content": [
            {
                "type": "t",
                "content": "それに、僕の方向音痴は紛れもない事実だし……（だからといって、あんなに連呼する必要性は感じないけど……）"
            }
        ]
    },
    {
        "op": "03",
        "content": [
            {
                "type": "o",
                "content": [
                    {
                        "type": "b",
                        "content": ""
                    }
                ]
            }
        ]
    },
    {
        "op": "str",
        "content": [
            {
                "type": "t",
                "content": "それにしても……どうして僕は、翔相手だとこんなに短気になってしまうんだろう。"
            }
        ]
    },
    {
        "op": "03",
        "content": [
            {
                "type": "o",
                "content": [
                    {
                        "type": "b",
                        "content": ""
                    }
                ]
            }
        ]
    },
    {
        "op": "str",
        "content": [
            {
                "type": "t",
                "content": "相手が、仕事仲間や翔以外の相手なら、僕はいつだって冷静でいられるのに。"
            }
        ]
    },
    {
        "op": "03",
        "content": [
            {
                "type": "o",
                "content": [
                    {
                        "type": "b",
                        "content": ""
                    }
                ]
            }
        ]
    },
    {
        "op": "str",
        "content": [
            {
                "type": "t",
                "content": "翔相手だと、ついカッとなって、言わなくてもいいことまで言ってしまう。"
            }
        ]
    },
    {
        "op": "03",
        "content": [
            {
                "type": "o",
                "content": [
                    {
                        "type": "b",
                        "content": ""
                    }
                ]
            }
        ]
    },
    {
        "op": "str",
        "content": [
            {
                "type": "t",
                "content": "仕事の取引なんかだと、自分の口にする言葉の効果を計りながら、うまく会話をコントロール出来るのに、翔相手だとそれが出来ない。"
            }
        ]
    },
    {
        "op": "03",
        "content": [
            {
                "type": "o",
                "content": [
                    {
                        "type": "b",
                        "content": ""
                    }
                ]
            }
        ]
    },
    {
        "op": "str",
        "content": [
            {
                "type": "t",
                "content": "どうしてなんだろう……誰かに、教えてほしい……"
            }
        ]
    },
    {
