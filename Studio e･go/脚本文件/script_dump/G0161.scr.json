    {
        "op": "str",
        "content": [
            {
                "type": "t",
                "content": "「……ケンカなんて……したくなかったのに……」"
            }
        ]
    },
    {
        "op": "03",
        "content": [
            {
                "type": "o",
                "content": [
                    {
                        "type": "b",
                        "content": ""
                    }
                ]
            }
        ]
    },
    {
        "op": "02",
        "content": [
