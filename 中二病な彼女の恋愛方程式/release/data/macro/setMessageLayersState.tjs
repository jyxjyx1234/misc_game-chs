// setMessageLayerHiddenState()の拡張。ページごとにhidden状態を指定できるよう
// にする。プラグインのonMessageHiddenStateChanged()関数の引数にもpageが
// 付加できるよう拡張する
.KAGWindow.setMessageLayerHiddenStatePerPage = function(b, page='fore', call=true) {
	if (page == 'both') {
		setMessageLayerHiddenStatePerPage(b, 'back', false);
		setMessageLayerHiddenStatePerPage(b, 'fore', call);
		return;			// callなのは一度だけ呼ぶため↑
	}
	var layers = this[page].messages;
	for(var i = layers.count-1; i >= 0; i--)
		layers[i].setHiddenStateByUser(b, page);
	layers = this[page].layers;
	for(var i = layers.count-1; i >= 0; i--)
		layers[i].setHiddenStateByUser(b, page);

	// ExtSystemButtonがあればそれも設定
	if (typeof(.extsystembutton_obj) != 'undefined')
		.extsystembutton_obj.setHiddenStateByUserPerPage(b, page);

	// プラグインを呼ぶ
	// 実は少し引数を拡張してあって、onMessageHiddenStateChangedを
	// (hidden, page)で呼ぶ。普通は受け側でpageは捨てられちゃうけど
	if (call) {
		forEachEventHook('onMessageHiddenStateChanged',
			function(handler, f) {
				handler(f.hidden, f.page);
			} incontextof this,
			%[hidden:b, page:page]
		);
	}
};


// メッセージレイヤをまとめて状態変更するための関数。主にvisibleを。
// hideMessageLayerByUser()あたりを書き直してもよかったが、動作が変わるのを
// 嫌って別関数とした。
// 引数は以下の通り。
//	elm.page       = ['fore']|'back'|'both'
//	elm.hidden     = [!elm.visible]|true|false
//	elm.visible    = true|false
//	elm.hidingflag = true|false
//	elm.callplugin = true|[false] (hidden/visible=が指定された時のみ有効)
//	elm.callrclick = true|[false]
//	elm.setmenu    = true|[false]
.KAGWindow.setMessageLayersState = function(elm=%[]) {
	// デフォルト値設定
	if (elm.hidden === void && elm.visible !== void)
		elm.hidden = !+elm.visible;
	elm.page = 'fore' if (elm.page === void);
	// デフォルト値が無いものはここで設定しないこと

	if (elm.hidden !== void)
		setMessageLayerHiddenStatePerPage(+elm.hidden,
						elm.page, +elm.callplugin);
	if (elm.hidingflag !== void)
		messageLayerHiding = +elm.hidingflag;
	if (elm.callrclick) {
		// 必要があれば右クリックルーチンを呼ぶ
		if(typeof this.rightClickMenuItem !== "undefined")
			rightClickMenuItem.checked = true;
	}
	if (elm.setmenu) {
		// 必要があればウィンドウ上部のメニューを設定する
		setMenuAccessibleAll();
	}
	return 0; // goto-next
};
