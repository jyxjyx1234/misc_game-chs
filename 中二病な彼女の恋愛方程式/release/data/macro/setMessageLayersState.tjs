// kag.setMessageLayersState() 関数を追加する寄生虫。
// あわせて、kag.setMessageLayerHiddenState()をページごとに実行できるよう拡張
// したkag.setMessageLayerHiddenStatePerPage()を追加。
//
// 2014/11/09	0.1	初期リリース
//
// 本ファイルは Override.tjs 中で以下のようにして呼び出すこと。
// Scripts.execStorage("setMessageLayersState.tjs");
//
// ページごとにメッセージレイヤ群の表示・非表示を切り替えることができる。
// メッセージレイヤをトランジションで消したり表示したりする際に使用。
// [hidemessage]タグは表画面のメッセージレイヤのみを非表示にするが、
// 本寄生虫は(直後のトランジションのための)「裏画面のみ非表示」が可能。
// つまり、「トランジションでメッセージレイヤを消す」ことができるようになる。
//

// メッセージレイヤのsetHiddenStateByUser(b)で、
// invisibleByUserの時はinvisible をスキップするようにする
.MessageLayer.setHiddenStateByUser_pageext_org = .MessageLayer.setHiddenStateByUser;
.MessageLayer.setHiddenStateByUser = function(b) {
	if ((b && !invisibleByUser) || (!b && invisibleByUser))
		setHiddenStateByUser_pageext_org(b);
};
// メッセージレイヤのassign時にメンバを二つ追加でコピーする
.MessageLayer.internalAssign_pageext_org = .MessageLayer.internalAssign;
.MessageLayer.internalAssign = function(src, copyvisiblestate) {
	internalAssign_pageext_org(...);
	if (copyvisiblestate) {
		visibleBeforeUserInvisible = +src.visibleBeforeUserInvisible;
		invisibleByUser = +src.invisibleByUser;
	}
};
// メッセージレイヤのstore時にメンバを二つ追加でコピーする
.MessageLayer.store_pageext_org = .MessageLayer.store;
.MessageLayer.store = function() {
	var dic = store_pageext_org();
	dic.visibleBeforeUserInvisible = +visibleBeforeUserInvisible;
	dic.invisibleByUser = +invisibleByUser;
	return dic;
};
// メッセージレイヤのrestore時にメンバを二つ追加でコピーする
.MessageLayer.restore_pageext_org = .MessageLayer.restore;
.MessageLayer.restore = function(dic) {
	visibleBeforeUserInvisible = +dic.visibleBeforeUserInvisible;
	invisibleByUser = +dic.invisibleByUser;
	restore_pageext_org(dic);
};


// キャラクタレイヤのsetHiddenStateByUser(b)で、
// invisibleByUserの時はinvisible をスキップするようにする
.CharacterLayer.setHiddenStateByUser_pageext_org = .CharacterLayer.setHiddenStateByUser;
.CharacterLayer.setHiddenStateByUser = function(b) {
	if ((b && !invisibleByUser) || (!b && invisibleByUser))
		setHiddenStateByUser_pageext_org(b);
};
// キャラクタレイヤのassign時にvisibleBeforeUserInvisibleもコピーする
.CharacterLayer.assign_pageext_org = CharacterLayer.assign;
.CharacterLayer.assign = function(src, copyvisiblestate) {
	assign_pageext_org(...);
	visibleBeforeUserInvisible = +src.visibleBeforeUserInvisible;
	invisibleByUser = +src.invisibleByUser;
};
// キャラクタレイヤのstore時にメンバを二つ追加でコピーする
.CharacterLayer.store_pageext_org = .CharacterLayer.store;
.CharacterLayer.store = function() {
	var dic = store_pageext_org();
	dic.visibleBeforeUserInvisible = +visibleBeforeUserInvisible;
	dic.invisibleByUser = +invisibleByUser;
	return dic;
};
// キャラクタレイヤのrestore時にメンバを二つ追加でコピーする
.CharacterLayer.restore_pageext_org = .CharacterLayer.restore;
.CharacterLayer.restore = function(dic) {
	visibleBeforeUserInvisible = +dic.visibleBeforeUserInvisible;
	invisibleByUser = +dic.invisibleByUser;
	restore_pageext_org(dic);
};

