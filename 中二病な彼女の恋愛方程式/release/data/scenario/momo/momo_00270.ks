[np]
[FACEHIDE]

[character name="ryuichi"]
【龙一】[r]「啊……呃」
[np]

[chisato storage="B_seifuku_M AB_6_M" trans=false]
[aoi storage="C_seifuku_M CD_5_M" trans=false]
[akane storage="C_seifuku_M CD_1_M" trans=false]
