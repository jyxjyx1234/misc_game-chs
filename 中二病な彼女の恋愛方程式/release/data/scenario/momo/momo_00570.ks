[SCENESTART file=momo_00570.ks]
;//momo_00570
;//BG:bg05_03

;//TIME:夜
;//日付:7/21(火)
;//CH:竜一,pajyama
;//CH:もも,pajyama

;//■シーン回想が開始される箇所に上記タグをいれる
[if exp="tf.SceneMode_RunFlg"]
*SceneLoad
[backlay]
[freeimage layer=10 page=back]
[trans method=crossfade time=300]
[wt]
[endif]

;//通常ＣＧ挿入
[CG cgno=04 sabunno=04]
[fadeinbgm storage="sound/BGM12.ogg" time=1000]
[SYSTEMMENU]

[playcv storage="momo_momo_00570_001.ogg" name="momo"]
[character name="momo"]
【桃】[r]「嘿咻……」
[np]

[r]换上睡衣的桃酱可爱地发出声音，坐在床上。
[np]

[r]在那之后，我们又进行了两次激烈的交欢……
[np]

[r]以互相清洗身体为名目不停亲热，霸占浴室将近两小时。
[np]

[r]不过因为大家都已经洗完了，倒也没什么问题……
[np]

[playcv storage="momo_momo_00570_002.ogg" name="momo"]
[character name="momo"]
【桃】[r]「刚才的声音……应该没问题吧？」
[np]

[character name="ryuichi"]
【龙一】[r]「希望……没问题吧」
[np]

[r]桃酱在抵达瞬间发出的那声大叫……
[np]

[r]从浴室经过盥洗室，传到客厅和大家房间的可能性也不是完全没有。
[np]

[character name="ryuichi"]
【龙一】[r]「要是被听到的话，桃酱其实是好色女孩的事情就会暴露给所有人了……」
[np]

[CG cgno=04 sabunno=03]

[playcv storage="momo_momo_00570_003.ogg" name="momo"]
[character name="momo"]
【桃】[r]「为、为什么只有我一个人啊……！真到那时候前辈也要陪我一起暴露！」
[np]

[character name="ryuichi"]
【龙一】[r]「我就无所谓啊，反正大家早就觉得我很好色了」
[np]

[playcv storage="momo_momo_00570_004.ogg" name="momo"]
[character name="momo"]
【桃】[r]「唔……那样有点、狡猾啦……」
[np]

[r]鼓起脸颊的桃酱将双手夹在大腿之间……
[np]

[r]让原本就丰满的胸部更加凸显出浑圆的轮廓。
[np]

[r]嗯……果然，还是让人不禁赞叹的出色又迷人的……
[np]

[playcv storage="momo_momo_00570_005.ogg" name="momo"]
[character name="momo"]
【桃】[r]「……前辈的眼神好下流」
[np]

[character name="ryuichi"]
【龙一】[r]「啊……对、对不起！」
[np]

[playcv storage="momo_momo_00570_006.ogg" name="momo"]
[character name="momo"]
【桃】[r]「明明刚才已经做了那么多次……果然前辈要比我下流多了呢」
[np]

[character name="ryuichi"]
【龙一】[r]「这个……我不否认」
[np]

[CG cgno=04 sabunno=04]

[playcv storage="momo_momo_00570_007.ogg" name="momo"]
[character name="momo"]
【桃】[r]「呵呵呵……♪」
[np]

[r]或许是被我一本正经的回答逗乐了，桃酱捂着嘴轻笑起来。
[np]

[playcv storage="momo_momo_00570_008.ogg" name="momo"]
[character name="momo"]
【桃】[r]「不过……果然前辈和其他男生，还是不一样的……」
[np]

[character name="ryuichi"]
【龙一】[r]「诶……？」
[np]

[playcv storage="momo_momo_00570_009.ogg" name="momo"]
[character name="momo"]
【桃】[r]「今天约会刚开始的时候……我说过的话，前辈还记得吗？」
[np]

[character name="ryuichi"]
【龙一】[r]「刚开始的时候……是指车站附近那时候？」
[np]

[playcv storage="momo_momo_00570_010.ogg" name="momo"]
[character name="momo"]
【桃】[r]「嗯……就是我说的从小就不擅长应付男生……那件事」
[np]

[playcv storage="momo_momo_00570_011.ogg" name="momo"]
[character name="momo"]
【桃】[r]「虽然不是什么重要的事……但总觉得应该先和前辈说清楚」
[np]

[r]桃酱重新在床上坐直身子，弹簧发出细微的吱呀声。
[np]

[playcv storage="momo_momo_00570_012.ogg" name="momo"]
[character name="momo"]
【桃】[r]「我的这个胸部……从小学开始就不停地在发育」
[np]

[playcv storage="momo_momo_00570_013.ogg" name="momo"]
[character name="momo"]
【桃】[r]「和其他女生完全不是一个程度……跑步的时候会晃得特别厉害」
[np]

[character name="ryuichi"]
【龙一】[r]「原来那么早以前就……」
[np]

[CG cgno=04 sabunno=01]

[playcv storage="momo_momo_00570_014.ogg" name="momo"]
[character name="momo"]
【桃】[r]「嗯……可是完全没有好事……最让我难受的是……」
[np]

[playcv storage="momo_momo_00570_015.ogg" name="momo"]
[character name="momo"]
【桃】[r]「被男生们嘲笑像奶牛……还有无时无刻都被人用下流的眼神盯着看」
[np]

[r]我看见桃酱轻轻咬住了自己的嘴唇。
[np]

[playcv storage="momo_momo_00570_016.ogg" name="momo"]
[character name="momo"]
【桃】[r]「所以我才会这么害怕男生……从此之后遇到事情就只会躲进自己的世界……」
[np]

[r]此时桃酱的目光转向房间角落摆放的中二病道具。
[np]

[playcv storage="momo_momo_00570_017.ogg" name="momo"]
[character name="momo"]
【桃】[r]「不过想到现在的我都是托它的福……总感觉有点不可思议呢」
[np]

[character name="ryuichi"]
【龙一】[r]「原来如此……所以桃酱的中二病就是因此发作的啊」
[np]

[playcv storage="momo_momo_00570_018.ogg" name="momo"]
[character name="momo"]
【桃】[r]「是的……虽然我本来就很喜欢幻想……」
[np]

[playcv storage="momo_momo_00570_019.ogg" name="momo"]
[character name="momo"]
【桃】[r]「但自从遇到《黑之契约者》就彻底沉溺在黑暗世界里……不知不觉就给自己编造了各种角色设定……」
[np]

[r]说着说着似乎害羞起来，桃酱的脸颊渐渐染上红晕。
[np]

[r]比起那些色色的事，这方面反而更让人难为情……
[np]

[playcv storage="momo_momo_00570_020.ogg" name="momo"]
[character name="momo"]
【桃】[r]「所、所以呢……其实我一直都很不擅长和男生相处」
[np]

[playcv storage="momo_momo_00570_021.ogg" name="momo"]
[character name="momo"]
【桃】[r]「所以听说要改成男女合宿的时候，真的纠结过要不要取消预约」
[np]

[character name="ryuichi"]
【龙一】[r]「结果入住第一天就发生那种事……会被躲着也是理所当然吧」
[np]

[playcv storage="momo_momo_00570_022.ogg" name="momo"]
[character name="momo"]
【桃】[r]「哈哈……不过现在想来……说不定还要感谢那次事件呢」
[np]

[character name="ryuichi"]
【龙一】[r]「感谢……？」
[np]

[playcv storage="momo_momo_00570_023.ogg" name="momo"]
[character name="momo"]
【桃】[r]「之前在盥洗室和学长发生那种事后……我就一直刻意躲着您」
[np]

[playcv storage="momo_momo_00570_024.ogg" name="momo"]
[character name="momo"]
【桃】[r]「可是……在合宿生活中渐渐发现……您或许不是坏人……」
[np]

[playcv storage="momo_momo_00570_025.ogg" name="momo"]
[character name="momo"]
【桃】[r]「不知不觉就觉得自己这样躲避很不应该……」
[np]

[playcv storage="momo_momo_00570_026.ogg" name="momo"]
[character name="momo"]
【桃】[r]「所以……那个……就鼓起勇气试着和男生……和学长好好相处之后……发现您温柔的地方、帅气的地方……都看得越来越清楚了」
[np]

[r]……不妙。我现在羞得快要烧起来了。
[np]

[CG cgno=04 sabunno=04]

[playcv storage="momo_momo_00570_027.ogg" name="momo"]
[character name="momo"]
【桃】[r]「所以对我来说学长是特别的存在……和其他男生不一样，是我最喜欢的人」
[np]

[character name="ryuichi"]
【龙一】[r]「……谢谢你，桃酱」
[np]

[r]一边祈祷自己的脸没有变红，一边将视线投向桃酱。
[np]

[character name="ryuichi"]
【龙一】[r]「我也……最喜欢桃酱了。」
[np]

[playcv storage="momo_momo_00570_028.ogg" name="momo"]
[character name="momo"]
【桃】[r]「嘿嘿……谢谢学长♪　我也对学长……」
[np]

[playcv storage="momo_momo_00570_029.ogg" name="momo"]
[character name="momo"]
【桃】[r]「啊，要是这么说下去的话，会没完没了停不下来呢」
[np]

[r]两人相视而笑，不约而同露出腼腆的表情。
[np]

[playcv storage="momo_momo_00570_030.ogg" name="momo"]
[character name="momo"]
【桃】[r]「那我们就……差不多该休息了吧」
[np]

[character name="ryuichi"]
【龙一】[r]「是啊。晚安，桃酱」
[np]

[CG cgno=04 sabunno=05]

[playcv storage="momo_momo_00570_031.ogg" name="momo"]
[character name="momo"]
【桃】[r]「好的……晚安，学长……♪」
[np]

