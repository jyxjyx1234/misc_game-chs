[r]如此想着，和千圣一同造访了咖啡厅……
[np]

[fadeinbgm storage="bgm/BGM05.ogg" time="500"]

[chisato storage="B_sifuku_M AB_2_M"]
[playcv storage="chisato_chisato_00620_009.ogg" name="chisato"]
