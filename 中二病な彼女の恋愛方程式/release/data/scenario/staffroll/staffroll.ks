;//==============================================================================
;//ピースソフト　ラブイク
;//▲ スタッフロール
;//==============================================================================
;バックログを表示させない
[history output=false enabled="true"]
;右クリック利用不可
[rclick enabled="true"]
;ゲームショートカットを利用不可にする
[EnableSCutFlg enable=1]
;スキップを停止し無効にする
[cancelskip]
[nextskip enabled="false"]


;画面をホワイトアウト
[playbgm storage="OPInst.ogg"]

[backlay]
[image storage="staffroll.png" layer=7 page=back left=0 top=0 visible=true]
[sysbutton_erase page=back]
[trans method=crossfade time=1000]
[wt]

; まず初期化
	[staffroll_init layer=message4 width=900 left=190]

	; 文字列を描画
	[staffroll_set target=*staffrollSTR]
	; スタッフロール開始
	[staffroll_start time=80000]
	; 終了まで待つ。この前に背景のトランジションだとかの効果を入れればいい
	[staffroll_wait canskip=false]
	; スタッフロールを完全に終了する
	[staffroll_end]

	[fadeoutbgm time="1000"]
[backlay]
[freeimage layer=7 page=back]
[image storage=white layer=0 page=back  visible=true]
[sysbutton_erase page=back]
[trans method=crossfade time=1000]
[wt canskip=false]

;終了処理
[history output="true" enabled="true"]

;ゲームショートカットを利用可にする
[EnableSCutFlg enable=1]

;スキップ有効化
[nextskip enabled=true]

[return]

