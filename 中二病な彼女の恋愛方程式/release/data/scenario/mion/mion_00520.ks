[mion storage="B_sifuku_M AB1_3_M"]
[playcv storage="mion_mion_00520_025.ogg" name="mion"]
[character name="mion"]
[FACEVIEW storage="mion_AB1_3_FACE_sifuku"]
【澪音】[r]「……那这样的话，虽然只是打个比方……」
