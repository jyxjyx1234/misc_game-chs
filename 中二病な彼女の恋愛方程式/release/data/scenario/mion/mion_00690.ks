;//TIME:昼
;//日付:8/17(月)
;//CH:竜一,sifuku
;//CH:澪音,sifuku

[playse buf=5 storage="sound/50210.ogg" loop=true]

[mion storage="B_sifuku_M AB1_7_M"]
[playcv storage="mion_mion_00690_001.ogg" name="mion"]
[character name="mion"]
[FACEVIEW storage="mion_AB1_7_FACE_sifuku"]
【澪音】[r]「……海？」
[np]
[FACEHIDE]

[r]夏日阳光照耀下波光粼粼的海面、令人心旷神怡的浪涛声……
[np]

[r]于是我们来到了因海水浴客的欢声笑语而热闹非凡的海岸。
[np]

[mion storage="C_sifuku_M CD1_9_M"]
[playcv storage="mion_mion_00690_002.ogg" name="mion"]
[character name="mion"]
[FACEVIEW storage="mion_CD1_9_FACE_sifuku"]
【澪音】[r]「……为什么是海边啊」
[np]
[FACEHIDE]

[character name="ryuichi"]
【龙一】[r]「那当然是因为夏天嘛……不觉得很有青春的感觉吗？」
[np]

[mion storage="A_sifuku_M AB1_4_M"]
[playcv storage="mion_mion_00690_003.ogg" name="mion"]
[character name="mion"]
[FACEVIEW storage="mion_AB1_4_FACE_sifuku"]
【澪音】[r]「完全不觉得」
[np]
[FACEHIDE]

[r]依然是不留情面的回应……不过这种直率感反而很有澪音学姐的风格，让人安心。
[np]

[r]虽说是平日但正值暑假。吸收了太阳热量的沙滩上，携家带口的游客和年轻人正欢快地享受大海。
[np]

[r]虽然随便换乘了几趟电车来到这里……但真的只是觉得因为是夏天，完全没考虑其他因素啊。
[np]

[character name="ryuichi"]
【龙一】[r]「学姐要吃点什么吗？炒面啊刨冰之类的……」
[np]

[mion storage="C_sifuku_M CD1_4_M"]
[playcv storage="mion_mion_00690_004.ogg" name="mion"]
[character name="mion"]
[FACEVIEW storage="mion_CD1_4_FACE_sifuku"]
【澪音】[r]「不用。刚才吃过午饭，肚子根本不饿」
[np]
[FACEHIDE]

[character name="ryuichi"]
【龙一】[r]「那要喝点什么吗？这么热的天，嗓子该渴了吧？」
[np]

[mion storage="A_sifuku_M AB1_5_M"]
[playcv storage="mion_mion_00690_005.ogg" name="mion"]
[character name="mion"]
[FACEVIEW storage="mion_AB1_5_FACE_sifuku"]
【澪音】[r]「不用了。为什么你总是这么热衷于劝人吃喝呢？」
[np]
[FACEHIDE]

[character name="ryuichi"]
【龙一】[r]「那个……你看那边不是有海边小店嘛」
[np]

[mion storage="B_sifuku_M AB1_7_M"]
[playcv storage="mion_mion_00690_006.ogg" name="mion"]
[character name="mion"]
[FACEVIEW storage="mion_AB1_7_FACE_sifuku"]
【澪音】[r]「是有呢」
[np]
[FACEHIDE]

[character name="ryuichi"]
【龙一】[r]「刚才路过时听说，那家店好像是当地很有口碑的中餐馆经营的……」
[np]

[character name="ryuichi"]
【龙一】[r]「而且！听说有对能让搭讪者络绎不绝的美少女姐妹在接待客人，我超级感兴——」
[np]

[mion storage="A_sifuku_M AB1_3_M"]
[playcv storage="mion_mion_00690_007.ogg" name="mion"]
[character name="mion"]
[FACEVIEW storage="mion_AB1_3_FACE_sifuku"]
【澪音】[r]「……你这微微翘起的鼻子……要不要让我帮你划一刀再按回去呢……？」
[np]
[FACEHIDE]

[character name="ryuichi"]
【龙一】[r]「呃、请务必高抬贵手……」
[np]

[r]最近都没有像这样插科打诨的对话了……连这种小事都让我感到开心的自己真实存在。
[np]

[mion storage="D_sifuku_M CD1_5_M"]
[playcv storage="mion_mion_00690_008.ogg" name="mion"]
[character name="mion"]
[FACEVIEW storage="mion_CD1_5_FACE_sifuku"]
【澪音】[r]「……真是的」
[np]
[FACEHIDE]

[r]学姐带着无奈的神情叹了口气，将目光投向海的方向。
[np]

[r]她闭着双唇凝视前方，或许是在聆听浪涛的声音。
[np]

[r]那侧脸透着某种庄严的神色……所以我只是静静守候在她身旁。
[np]

[mion storage="B_sifuku_M AB1_1_M"]
[playcv storage="mion_mion_00690_009.ogg" name="mion"]
[character name="mion"]
[FACEVIEW storage="mion_AB1_1_FACE_sifuku"]
【澪音】[r]「电影啊、电视剧里……有烦恼的时候，角色们总会跑到海边来呢」
[np]
[FACEHIDE]

[character name="ryuichi"]
【龙一】[r]「确实呢」
[np]

[r]我点点头，回应前辈突然的喃喃自语。
[np]

[mion storage="D_sifuku_M CD1_8_M"]
[playcv storage="mion_mion_00690_010.ogg" name="mion"]
[character name="mion"]
[FACEVIEW storage="mion_CD1_8_FACE_sifuku"]
【澪音】[r]「所以你是特意带我来海边的吗？」
[np]
[FACEHIDE]

[character name="ryuichi"]
【龙一】[r]「这个嘛……倒没想那么多。只是觉得这里最能纾解前辈的心情」
[np]

[mion storage="A_sifuku_M AB1_7_M"]
[playcv storage="mion_mion_00690_011.ogg" name="mion"]
[character name="mion"]
[FACEVIEW storage="mion_AB1_7_FACE_sifuku"]
【澪音】[r]「我的心情……？」
[np]
[FACEHIDE]

[character name="ryuichi"]
【龙一】[r]「前辈最近一直对着电脑……虽然全情投入小说创作是好事……」
[np]

[character name="ryuichi"]
【龙一】[r]「但偶尔也需要转换心情……不然最重要的这里会发霉的哦」
[np]

[r]他边说边咚咚敲了敲自己胸口，露出俏皮的笑容。
[np]

[mion storage="C_sifuku_M CD1_3_M"]
[playcv storage="mion_mion_00690_012.ogg" name="mion"]
[character name="mion"]
[FACEVIEW storage="mion_CD1_3_FACE_sifuku"]
【澪音】[r]「……是啊。龙一说的对」
[np]
[FACEHIDE]

[r]看着前辈闻言绽放的笑容……感觉自己的心情也稍微轻松了些。
[np]

[mion storage="B_sifuku_M AB1_5_M"]
[playcv storage="mion_mion_00690_013.ogg" name="mion"]
[character name="mion"]
[FACEVIEW storage="mion_AB1_5_FACE_sifuku"]
【澪音】[r]「……我啊，最近一直在思考」
[np]
[FACEHIDE]

[mion storage="D_sifuku_M CD1_6_M"]
[playcv storage="mion_mion_00690_014.ogg" name="mion"]
[character name="mion"]
[FACEVIEW storage="mion_AB1_4_FACE_sifuku"]
【澪音】[r]「在写作时总想着要获奖、要迎合流行趋势……这样真的是正确的吗？」
[np]
[FACEHIDE]

[mion storage="B_sifuku_M AB1_4_M"]
[playcv storage="mion_mion_00690_015.ogg" name="mion"]
[character name="mion"]
[FACEVIEW storage="mion_AB1_4_FACE_sifuku"]
【澪音】[r]「最近几天写不下去并不是因为想不出剧情发展……而是因为一直在为这件事烦恼」
[np]
[FACEHIDE]

[r]原本一直眺望大海的前辈忽然转头望向我。
[np]

[mion storage="A_sifuku_M AB1_1_M"]
[playcv storage="mion_mion_00690_016.ogg" name="mion"]
[character name="mion"]
[FACEVIEW storage="mion_AB1_1_FACE_sifuku"]
【澪音】[r]「龙一你怎么看？」
[np]
[FACEHIDE]

[character name="ryuichi"]
【龙一】[r]「这个问题有点难回答啊」
[np]

[r]我抓了抓头发开始认真思考这个问题。
[np]

[character name="ryuichi"]
【龙一】[r]「可能我的回答会有点老生常谈……」
[np]

[mion storage="C_sifuku_M CD1_3_M"]
[playcv storage="mion_mion_00690_017.ogg" name="mion"]
[character name="mion"]
[FACEVIEW storage="mion_CD1_3_FACE_sifuku"]
【澪音】[r]「没关系，说来听听」
[np]
[FACEHIDE]

[character name="ryuichi"]
【龙一】[r]「关于这样做是否正确……我觉得本来就没有绝对答案吧？」
[np]

[character name="ryuichi"]
【龙一】[r]「重要的是……在意识到这些无法回避的因素后，前辈是否还能怀着「即便如此」的心情……」
[np]

[mion storage="B_sifuku_M AB1_7_M"]
[playcv storage="mion_mion_00690_018.ogg" name="mion"]
[character name="mion"]
[FACEVIEW storage="mion_AB1_7_FACE_sifuku"]
【澪音】[r]「即便如此……？」
[np]
[FACEHIDE]

[character name="ryuichi"]
【龙一】[r]「对。想要写出有趣的故事、想写自己喜欢的东西……我觉得这种心情才是最珍贵的」
[np]

[character name="ryuichi"]
【龙一】[r]「但是前辈即将踏入的那个世界……光是靠坚持战斗下去就会非常艰难……对吧？」
[np]

[r]看着微微点头的前辈，我边组织语言边继续说着。
[np]

[character name="ryuichi"]
【龙一】[r]「既然如此，那些前辈本来不愿考虑的事情……恐怕也是无法回避的道路」
[np]

[character name="ryuichi"]
【龙一】[r]「不过……即便如此，如果内心仍然怀有想要表达什么的渴望……那么这份心意肯定也——」
[np]

[r]忽然间，站在身旁的前辈迈开脚步……
[np]

[r]逐渐加快步伐向浪花翻涌的海岸线靠近。
[np]

[character name="ryuichi"]
【龙一】[r]「前、前辈……？」
[np]

[r]等等，你就这样穿着鞋……？会弄湿的——
[np]

[mion storage="D_sifuku_M CD1_7_M"]
[playcv storage="mion_mion_00690_019.ogg" name="mion"]
[character name="mion"]
[FACEVIEW storage="mion_CD1_7_FACE_sifuku"]
【澪音】[r]「呀……」
[np]
[FACEHIDE]

[r]……海浪漫过脚踝位置，她发出小小的惊呼。
[np]

[r]但前辈并没有因此感到不快……反而露出了我从未见过的笑容。
[np]

[character name="ryuichi"]
【龙一】[r]「前辈……？」
[np]

[mion storage="C_sifuku_M CD1_2_M"]
[playcv storage="mion_mion_00690_020.ogg" name="mion"]
[character name="mion"]
[FACEVIEW storage="mion_CD1_2_FACE_sifuku"]
【澪音】[r]「难得来到海边……不和浪花嬉戏一番的话，未免太浪费了吧？」
[np]
[FACEHIDE]

[character name="ryuichi"]
【龙一】[r]「可是，鞋子会湿的……」
[np]

[mion storage="A_sifuku_M AB1_1_M"]
[playcv storage="mion_mion_00690_021.ogg" name="mion"]
[character name="mion"]
[FACEVIEW storage="mion_AB1_1_FACE_sifuku"]
【澪音】[r]「是啊，现在确实有点后悔……不过……」
[np]
[FACEHIDE]

[mion storage="D_sifuku_M CD1_3_M"]
[playcv storage="mion_mion_00690_022.ogg" name="mion"]
[character name="mion"]
[FACEVIEW storage="mion_CD1_3_FACE_sifuku"]
【澪音】[r]「刚才的我，甚至觉得脱鞋都嫌麻烦……却还是抑制不住想要踏入海中的冲动」
[np]
[FACEHIDE]

[r]平日里给人以彻头彻尾理性主义者印象的前辈所采取的这一行动，实在令人费解……
[np]

[mion storage="B_sifuku_M AB1_2_M"]
[playcv storage="mion_mion_00690_023.ogg" name="mion"]
[character name="mion"]
[FACEVIEW storage="mion_AB1_2_FACE_sifuku"]
【澪音】[r]「……呵呵♪」
[np]
[FACEHIDE]

[r]然而，望着前辈那欢快的笑容……我确信选择来海边是正确的决定。
[np]

