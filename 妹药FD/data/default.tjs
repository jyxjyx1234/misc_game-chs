// 麻雀牌配置用コンフィグ
with (SystemConfig) {
	.MahjongPaiOrderConfig = %[
		//               ファイル名接頭      接尾             描画順   次の牌offset    次の行offset    牌の大きさ
		"さらし"   => %[ prefix:"mj_pai_",   suffix:"",       order:0, nx: 36, ny:  0, lx:  0, ly: 60, w:36, h:54 ],
		"対面"     => %[ prefix:"mj_pai_v_", suffix:"",       order:0, nx:-36, ny:  0, lx:  0, ly:-60, w:36, h:54 ],
		"下家"     => %[ prefix:"mj_pai_r_", suffix:"",       order:1, nx:  0, ny:-30, lx: 55, ly:  0, w:49, h:42 ],
		"上家"     => %[ prefix:"mj_pai_l_", suffix:"",       order:0, nx:  0, ny: 30, lx:-55, ly:  0, w:49, h:42 ],
		"自分"     => %[ prefix:"mj_pai_",   suffix:"_small", order:0, nx: 36, ny:  0, lx:  0, ly: 60, w:36, h:54 ],
		"自分大"   => %[ prefix:"mj_pai_",   suffix:"_large", order:0, nx: 46, ny:  0, lx:  0, ly: 76, w:46, h:69 ],
		"対面鳴き" => %[ prefix:"mj_pai_",   suffix:"",       order:0, nx: 49, ny:  0, lx:  0, ly: 60, w:36, h:54 ],
		// alias
		"大"   => "自分大",
		"自席" => "自分",		"自席大" => "自分大",
		"正面" => "対面",
		"右席" => "下家",
		"左席" => "上家",
		];
	.MahjongPaiOrderDefault = "自分"; // デフォルト時の設定

	// 字牌ファイル名
	.MahjongPaiJihai = %[
		"東" => "ji_ton",
		"南" => "ji_nan",
		"西" => "ji_syaa",
		"北" => "ji_pei",
		"白" => "ji_haku",
		"發" => "ji_hatsu",
		"中" => "ji_chun",
		"伏" => "fuse",
		"裏" => "fuse",
		"空" => "kara",
		"→" => "arrow_right",
		"←" => "arrow_left",
		"↑" => "arrow_up",
		"↓" => "arrow_down",
		];

	// スペースのデフォルト間隔
	.MahjongPaiHanSpcDefault = 18; // 半角
//	.MahjongPaiZenSpcDefault = 32; // 全角
	.MahjongPaiZenSpcDefault = 36; // 全角

	// レイヤの上下左右の余白（移動時にゴミが残る対策）
	.MahjongPaiPadding = 4;

	.voiceNames = [
		"ユキ",
		"アル",
		"真央",
		"心音",
		"一真",
		"真菜美",
		"優子",
		"鈴",

		"クシミ",
