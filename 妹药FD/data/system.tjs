// ---------------------------------------------------------
// 各種終了処理の登録・実行

class DelayedInvoker {
	var _list = [];
	function DelayedInvoker() {}
	function finalize() {}
	// 登録リストをクリアする
	function clear()      { _list.clear();            }
	// 登録リストに追加する
	function add(func)    { _list.add(func);          }
	// 登録リストから削除する
	function remove(func) { _list.remove(func, true); }
	// 登録リストを実行する
	function invoke()     {
		var temp = [];
		temp.assign(_list);
		for (var i = temp.count-1; i >= 0; i--) temp[i]();
		this.clear();
	}
}
// インスタンス
var terminator = new DelayedInvoker();

// ---------------------------------------------------------
// 遅延実行

class DelayedTimer extends Timer {
	function finalize() { super.finalize(...); }
	var _owner, _action;
	function DelayedTimer(owner, action, time) {
		_owner = owner, _action = _action;
		super.Timer(this, "onAction");
		with (this) .capacity = 1, .interval = time, .enabled  = false;
	}
	function cancel()   { this.enabled = false; }
	function trigger()  { this.enabled = true;  }
	function onAction() {
		cancel();
		if (_action == "") _owner();
		else _owner[_action]();
	}
}
class DelayedTrigger extends AsyncTrigger {
	function finalize() { super.finalize(...); }
	function DelayedTrigger(owner, action, mode) {
		super.AsyncTrigger(owner, action);
		with (this) .cached = true, .mode = mode;
	}
}
DelayedTrigger.instances = %[];
function setDelayedTrigger(tag, callback, time, priority = atmAtIdle) {
	if (time < 0 || tag == "" || callback == "") return;
	// 文字列の場合は関数に変更
	if (typeof callback == "String")
		callback = Scripts.eval(@"function() { Scripts.eval('${callback}'); }");
	var inst;
	if (time == 0) inst = new DelayedTrigger(callback, "", priority);
	else           inst = new DelayedTimer(  callback, "", time);

	DelayedTrigger.instances[tag] = inst;
}
function invokeDelayedTrigger(tag) {
	var inst = (tag != "") ? DelayedTrigger.instances[tag] : void;
	if (inst !== void) {
		inst.cancel();
		inst.trigger();
	}
}

class OnceDelayedTrigger extends DelayedTrigger {
	var _func;
	function finalize() {
		delete global.DelayedTrigger.instances[this];
		super.finalize(...);
	}
	function OnceDelayedTrigger(func, mode) {
		global.DelayedTrigger.instances[this] = this;
		super.DelayedTrigger(this, "onTrigger", mode);
		_func = func;
	}
	function onTrigger() {
		if (!(isvalid this)) return;
		_func();
		invalidate this;
	}
}
function runOnceDelayedTrigger(callback, imm = true, pri = atmAtIdle) {
	if (typeof callback == "String")
		callback = Scripts.eval(@"function() { Scripts.eval('${callback}'); }");
	var trig = new OnceDelayedTrigger(callback, pri);
	if (imm) trig.trigger();
	return trig;
}


// ---------------------------------------------------------
// セーブロード・おまけモード用のシングルトンダイアログ管理

class DialogModeManager {
	var _entries = %[];
	var _now = "";
	var _object = void;

	function get(elm) {
		var name = (typeof elm === "String") ? elm : (elm !== void) ? elm.name : void;
		if (name == "") throw new Exception("DialogModeManager: 名前がありません");

		_now = name.toLowerCase();
		var ent = _entries[_now];
		return ent;
	}
	// 適当に解釈して実行
	function run(target, *) {
		switch (typeof target) {
		case "void": return;
		case "String": return run(Scripts.eval(target), *);
		case "Object":
			if (     target instanceof "Function") return target(*);
			else if (target instanceof "Class")    return new target(*);
			break;
		default:
			throw new Exception("DialogModeManager: start値が不明な形式です: "+ _now);
		}
	}

	// 開始
	function start(elm) {
		done();
		var ent = get(elm);
		if (ent === void) {
			System.inform(@"${_now.toUpperCase()} 画面は実装されていません");
			return kag.goToStart();
		}
		try {
			_object = run(ent.start, elm);
		} catch (e) {
			throw new Exception("DialogModeManager: 初期化に失敗しました("+e.message+"): "+ _now);
		}
		terminator.add(this.done); // タイトルなどに強制的に移動した場合の終了処理を登録
	}

	// 終了
	function done() {
		if (_now != "") {
			var ent = get(_now);
			run(ent.done) if (ent !== void);
		}
		invalidate _object if valid;
		_object = void;
		_now = "";
		terminator.remove(this.done);
	}

	// 登録
	function add(name, start, done, layer, storage) {
		var ent = %[], tag;
		switch (typeof name) {
		case "String":
			tag = name;
			with (ent) {
				.start   = start;
				.done    = done;
				.layer   = layer;
				.storage = storage;
			}
			break;
		case "Object":
			tag = name.name;
			(global.Dictionary.assign incontextof ent)(name, true);
			delete ent.name if (ent.name !== void);
			break;
		default:
			throw new Exception("DialogModeManager: 追加パラメータが不正です");
		}
		if (typeof tag !== "String" || tag == "")
			throw new Exception("DialogModeManager: 追加名が不明です");

		_entries[tag.toLowerCase()] = ent;
	}
	// クラス登録(obsolete)
	function addClass() { add(...); }

	property dummyProp { getter() {} setter(v) {} }
	function dummyFunc {}

	function hasDefined(name) { return valid && typeof _object[name] != "undefined"; }
	// kagスクリプトからの呼び出し用(obsolete: ほとんどcmdで代用できる)
	function propget(name)   { return hasDefined(name) ? _object[name]    : void; }
	function prop(name)      { return hasDefined(name) ?&_object[name]    : &dummyProp; }
	function func(name)      { return hasDefined(name) ? _object[name]    :  dummyFunc; }
	function action(name, *) { return hasDefined(name) ? _object[name](*) : void; }
	function select(*)       { return action("select", *); }
	function enter(*)        { return action("enter", *); }
	function leave(*)        { return action("leave", *); }
	property page    {
		getter()  { return valid ? _object.page : 0; }
		setter(v) { _object.page = v if (valid); }
	}

	// funcのeval式から呼び出す用（引数の順番を変える必要があるため）
	// eval,*,call,Current.uiEval,method, ... -> method(target,dic, ...);
	function uiEval(t,r,m,*) { return action(m,t,r,*); }
	// eval,names,call,Current.uiSort,name1,name2,... -> names;
	function uiSort(names,dic,list*) {
		for (var i = list.count-1; i >= 0; i--) {
			var tag = list[i];
			if (tag == "" || dic[tag] === void) continue;
			names.remove(tag, true);
			names.insert(0, tag);
		}
	}

	// 文字列を解釈して function / property 設定等を呼び出す
	// .funcで","が使えない場合の回避方法として使う
	// "fnc/foo/bar" : fnc("foo", "bar");
	// "prop=value"  : prop = value // value が数値っぽい文字列の場合は数値に変換
	// "prop++", "prop+=value", "prop--", "prop-=value" // 数値増減
	function cmd(str) {
		if (!valid) return void;
		var i;
		if (     (i = str.indexOf("/")) >= 0) return cmd_func(str, i);
		else if ((i = str.indexOf("+")) >= 0) return cmd_up(  str, i);
		else if ((i = str.indexOf("-")) >= 0) return cmd_down(str, i);
		else if ((i = str.indexOf("=")) >= 0) return cmd_prop(str, i);
		else return _object[str]();
	}
	function cmd_func(str) {
		var args = str.split("/");
		var method = args[0];
		args.erase(0);
		return _object[method](args*);
	}
	function cmd_up(str, i) {
		switch (str.charAt(i+1)) {
			case "+": return _object[str.substr(0,i)]++;
			case "=": return _object[str.substr(0,i)] += +(str.substr(i+2));
		}
	}
	function cmd_down(str, i) {
		switch (str.charAt(i+1)) {
			case "-": return _object[str.substr(0,i)]--;
			case "=": return _object[str.substr(0,i)] += +(str.substr(i+2));
		}
	}
	function cmd_prop(str, i) {
		var prop = str.substr(0,i);
		var val  = str.substr(i+1);
//		dm("cmd_prop", prop, val);
		_object[prop] = (val == "0" || val.toLowerCase() == "false" || +val != 0) ? +val : val;
	}

	property valid   { getter() { return (_object !== void && isvalid _object);  } }
	property nowent  { getter() { return _now != "" ? _entries[_now] : void;  } }

	// パラメータを補完して uiload を呼び出す
	// _object の onUiload /onUiloaded コールバックも呼び出す
	function uiload(elmorig) {
		var elm = %[];
		(global.Dictionary.assign incontextof elm)(elmorig, true);
		if (elm.storage == "") {
			elm.storage = storage;
			if (elm.storage == "")
				return new Exception("uiload の storage が指定されていません");
		}
		_callDialogFunction("onUiload", "uiload", elm);
		var ui = global.uiload(kag.getMessageLayerObjectFromElm(elm), elm);
		kag.tagHandlers.current(%[page:elm.page, layer:elm.layer]);
		_callDialogFunction("onUiloaded", "uiloaded", elm, ui);
	}

	// _object → entry → default の優先順位でプロパティを取得する
	function _getDialogPropertyString(objName, entryName, defaultName) {
		if (hasDefined(objName) && _object[objName] != "") return _object[objName];
		var ent = nowent;
		if (ent !== void && ent[entryName] != "") return ent[entryName];
		return defaultName;
	}
	// _object → entry の優先順位で function を呼ぶ
	function _callDialogFunction(objName, entryName, *) {
		if (hasDefined(objName)) return (_object[objName])(*);
		var ent = nowent;
		if (ent !== void && ent[entryName] != "") return (ent[entryName])(*);
	}

	var defaultLayerName = "message1";
	property layerName { getter() { return _getDialogPropertyString("layerName", "layer",   defaultLayerName); } }
	property storage   { getter() { return _getDialogPropertyString("storage",   "storage", ""); } }
}

// インスタンス
var Dialog = new DialogModeManager();
var Current = Dialog;

// タグを登録
addKagHandler("dialog", function(elm) {
	if (elm.current !== void && elm.current != Current._now) return 0;
	if (     elm.done)             Current.done();
	else if (elm.command !== void) Current.cmd(elm.command);
	else if (elm.action  !== void) Current.action(elm.action, elm);
	else if (elm.name    !== void) Current.start(elm);
	return 0;
}, false);

// ---------------------------------------------------------
// 汎用レジストリ機構
// ---------------------------------------------------------

// レジストリ機構のベースクラス
//  スクリプトマップ: SystemScriptMap
//  フック管理: SystemManager
//  効果音管理: SystemSeManager
// へ派生
class SystemRegistory {
	var _map = %[], _cached = %[];

	function SystemRegistory() {}
//	function finalize() {}

	// エイリアス参照用
	class _AliasItem_ {
		function _AliasItem_(val) { alias = val; }
		var alias;
	}

	// [virtual] タグの正規化
	function tagNormalize(tag) {
		if (typeof tag === "String") {
			tag = tag.toLowerCase().trim();
			if (tag.length > 0) return tag;
		}
		return (string)null;
	}

	// エイリアスを反映した先のタグを取得
	function tagApply(tag) {
		tag = tagNormalize(tag);
		while (_map[tag] instanceof "_AliasItem_") tag = _map[tag].alias;
		return tag;
	}
	// 値を設定
	function set(tag, value) {
		_map[tagNormalize(tag)] = value;
	}
	// エイリアスを張る
	function alias(tag, to) {
		_map[tagNormalize(tag)] = new _AliasItem_(tagNormalize(to));
	}
	// 値取得
	function get(tag)       { return        _map[tagApply(tag)]; }

	// 定義済みかどうか調べる
	function isDefined(tag) { return typeof _map[tagApply(tag)] !== "undefined"; }

	// "."で区切った親階層を含めて "*" デフォルト値で検索する(キャッシュ機能つき)
	// 基本的に最初に全部定義して，その後は読み取りのみの動作を
	// 想定しているので動的に検索・値設定をするような時は set/alias したらclearCacheすること
	function search(tag, method = _searchParent) {
		if (typeof tag !== "String" || tag.length === 0) return;
		if (typeof _cached[tag] !== "undefined") return _cached[tag];
		var checks = method(tag);
		for (var i = 0; i < checks.count; i++) {
			var target = tagApply(checks[i]);
			// 発見できたらキャッシュに保存して返す
			if (typeof _map[target] !== "undefined")
				return setCache(tag, _map[target]);
		}
		return setCache(tag, void); // 結果無しでキャッシュに記録
	}
	// 親検索
	function _searchParent(tag) {
		var ret = [ tag ];
		var tmp = tag.split(".");
		while (tmp.count > 1) {
			tmp.erase(tmp.count-1);
			ret.add(tmp.join(".") + ".*");
		}
		ret.add("*");
		return ret;
	}

	// キャッシュ設定して返す
	function setCache(tag, value) {
		_cached[tag] = value;
		return value;
	}
	// サーチ用キャッシュをクリア
	function clearCache(tag) {
		if (tag == "") (global.Dictionary.clear incontextof _cached)();
		else delete _cached[tag];
	}
	// 全データをクリア
	function clear() {
		clearCache();
		(global.Dictionary.clear incontextof _map)();
	}

	// [virtual] load用のテキスト⇒値変換メソッド
	function getValue(val)  { return val; }
	// [virtual] エイリアスの場合はエイリアス先の文字列を返す
	function getAlias(val)  {}

	// テキストファイルから読み込み。「#」はコメント 「foo.bar = hoge」形式
	function load(file) {
		if (!Storages.isExistentStorage(file)) return;

		var list = [];
		list.load(file);

		for (var i = 0; i < list.count; i++) {
			var line = list[i].trim();
			if (line[0] === "#" || line.length === 0) continue;
			var sp = line.split("=");
			var c  = sp.count;
			if (c === 1 || c === 2) {
				var tag = sp[0];
				var val = getValue(sp[1]);
				var ren = getAlias(val);
				if (ren === void) set(tag, val);
				else            alias(tag, ren);
			} else {
				dm(file + ": エントリが不正です(" + line + ")");
			}
		}
	}
}

// ---------------------------------------------------------
// システムスクリプトストレージ
// ---------------------------------------------------------

// sysjump 時のとび先スクリプトを登録するレジストリ
// ・"storage * target" で，"*"区切りによるstorageとtargetを同時に記述できる
// ・storage は ".ks"を省略できる
// ・下位階層でstorageが省略された場合は上位階層のstorageを使用して補完する
//   ex:
//      foo = "foo.ks"
//      foo.from.bar = "*start_from_bar"
//      で登録されていた場合， get("foo.from.bar") すると
//      %[ storage:"foo.ks", target:"*start_from_bar" ] を返す
class SystemScriptMap extends SystemRegistory {
	function SystemScriptMap() { super.SystemRegistory(...); }
//	function finalize()        { super.finalize(...);        }

	function getValue(val)     {
		if (val === void) return %[];
		val = val.trim();
		if (val.length === 0) return %[];
		if (val.indexOf("*") >= 0) {
			var div = val.split("*");
			var storage = div[0].trim();
			if (storage.length == 0) storage = void;
			else if (storage.indexOf(".ks") < 0) storage += ".ks";
			return %[ storage:storage, target: "*"+div[1].trim() ];
		}
		return %[ storage: val.indexOf(".ks") < 0 ? (val + ".ks") : val ];
	}

	function get(tag) {
		var ret = %[];
		if (typeof tag !== "String") return ret;
		var s = search(tag);
		if (s !== void) (global.Dictionary.assign incontextof ret)(s, true);
		if (ret.storage === void && tag.indexOf(".") >= 0)
			ret.storage = get(tag.split(".")[0]).storage;
		return ret;
	}
	function add(tag, st) { set(tag, getValue(st)); }
	function script(name) { add(name, name);}

	function kagAddScript(elm) {
		with (elm) add(.name, .storage + .target);
		return 0;
	}
}
// インスタンス
var SystemScript = new SystemScriptMap();

// ---------------------------------------------------------
// システムスクリプトフック
// ---------------------------------------------------------

// フック(syshook)やジャンプ(sysjump)を提供する
// 色々と設計がごちゃごちゃしてるので書き直したい所存

class SystemManager extends SystemRegistory {
	function SystemManager() { super.SystemRegistory(...); }
//	function finalize()      { super.finalize(...);        }

	var sorted = %[];
	function add(tag, f, priority = 0) {
		set(tag, []) if (!isDefined(tag));
		var fncs = get(tag);
		fncs.add([ priority, f]);
	}
	function erase(tag) {
		if (!isDefined(tag)) return;
		var fncs = get(tag);
		fncs.clear();
	}
	function getArgs(args*) {
		var ret = [];
		ret.assign(args);
		return ret;
	}
	function store(tag, elm) {
		if (_pending === void) return kag.tagHandlers[tag](elm);
		elm.tagname = tag;
		_pending.add(elm);
	}
	var _pending = void;
	function pending(name, *) {
		_pending = [];
		this[name](*);
		for (var i = _pending.count-1; i >= 0; i--) {
			var elm = _pending[i];
			var tag = elm.tagname;
			delete elm.tagname;
			kag.insertTag(tag, elm);
		}
		_pending = void;
	}
	function execDelay(elm) {
		with (elm) .target(.args*);
		return 0;
	}
	function _exec(tag, *) {
		if (!isDefined(tag)) return void;
		var fncs = get(tag);
		var ntag = tagNormalize(tag);
		if (!sorted[ntag]) {
			fncs.sort(function(a,b) { return a[0] < b[0]; }, true);
			sorted[ntag] = true;
		}
		for (var i = fncs.count-1; i >= 0; i--) {
			var f = fncs[i][1];
			switch (typeof f) {
			case "String":
				_exec(f, *);
				break;
			case "Object":
				if (f instanceof "Function") store("sysexec", %[ name:tag, target:f, args:getArgs(*)]);
				break;
			}
		}
	}

	function exec() { _pending = void; _exec(...); }
	function jump() { _pending = void; _jump(...); }

	// [XXX]
	function _jump(from, to, back) {
		var storage, target, valid = false;
		if (to != "") {
			// 移動先スクリプトを取得
			var bind = SystemScript.get(to + (from != "" ? (".from." + from) : ""));
			if (bind !== void) with (bind) {
				storage = .storage;
				target  = .target;
				valid   = (storage != "" || target != "");
			}
		}
		dm("sysjump", from, to, back, storage, target) if (kag.debugLevel >= tkdlSimple);

		// 先にprocessを呼ばないとinsertTagが正常に機能しない
		kag.process(storage, target) if (valid);

		// 各種フック
		_exec(from + ".leave", to) if (from != "");

		_exec("back",    from, to) if (back);
		_exec("change",  from, to);
		_exec("change."+from+"."+to) if (from != "" && to != "");

		if (to != "") {
			store("syscurrent", %[ name:to ]);
			_exec(to   + ".enter", from);
		}

		if (!valid) {
			System.inform(@'sysjump: "${from}" から "${to}" への登録がありません');
			_jump(void, "title");
//			store("s");
		}

	}

	var cobjs = [];
	class _JumpOrCall {
		var storage, target, iscall;
		function _JumpOrCall(elm, defcall) {
			iscall = defcall;
			iscall =  +elm.call if (elm.call !== void);
			iscall = !+elm.jump if (elm.jump !== void);
			storage = elm.storage;
			if (typeof storage == "String" &&
				storage.length > 0 &&
				storage.indexOf(".ks") < 0)
				storage += ".ks";
			target  = elm.target;
		}
		function invoke() {
			with (kag.conductor) {
				.callLabel("") if (iscall);
				.loadScenario(storage) if (storage !== void);
				.goToLabel(target);
			}
		}
	}
	function getJumpOrCall(elm) {
		var co = new _JumpOrCall(elm);
		cobjs.add(co);
		return co.invoke;
	}

	function addJumpOrCall(tag, storage, target, iscall, priority) {
		add(tag, getJumpOrCall(%[storage:storage, target:target, call:iscall]), priority);
	}
	function addJump(tag, stor, tar, pri) { addJumpOrCall(tag, stor, tar, false, pri); }
	function addCall(tag, stor, tar, pri) { addJumpOrCall(tag, stor, tar, true,  pri); }

	function kagAdd(elm)  {
		add(elm.name, getJumpOrCall(elm, true), elm.priority);
		return 0;
	}
	function kagExec(elm) {
		pending("_exec", elm.name, elm);
		return 0;
	}

	var currentState, lastState;
	function kagCurrent(elm) {
		lastState    = currentState;
		currentState = tagNormalize(elm.name);
		return 0;
	}
	function kagJump(elm) {
		pending("_jump", elm.from, elm.to, elm.back);
		return 0;
	}
	// [XXX]
	function disableClickable() {
		global.unsetFocusedLayer(kag);
		with (kag.tagHandlers) {
			.locklink();
			.rclick(%[ enabled:false ]);
		}
	}
}
var SystemHook = new SystemManager();
with (SystemHook) {
	global.systemJump = .jump;

	addKagHandler("addsyshook", .kagAdd);
	addKagHandler("syshook",    .kagExec);
	addKagHandler("sysexec",    .execDelay);
	addKagHandler("syscurrent", .kagCurrent);
	addKagHandler("sysjump",    .kagJump);

	.add("change", .disableClickable);
}

// フォーカスを外す
function unsetFocusedLayer(win) {
	win.focusedLayer = null;
}

// 上書き
function inTitleMenu(kag) {
	return SystemHook.currentState == "title";
}

// ゲーム中かどうか
function inGameState(kag) {
	return SystemHook.currentState == "game";
}



/*
 * サブ画面の呼び出し
 */
function startSubSystem(isExtra, tag)
{
	with (kag) {
		var scr = SystemScript.get(tag);
		.hideHistory() if (.historyShowing);

//		dm("subsys", isExtra, tag, scr.storage, scr.target);
		if (!isExtra) .process(  scr.storage, scr.target,, true);
		else .callExtraConductor(scr.storage, scr.target);
	}
}


// ---------------------------------------------------------
// システム定義ファイル管理用
// ---------------------------------------------------------

class SystemDefFileManBase extends SystemRegistory {
//	function finalize() { super.finalize(...); }
	function SystemDefFileManBase(file) {
		super.SystemRegistory();
		load(file);
	}

	function getAlias(val)     { return (typeof val === "String") ? val : void; }
	function getValue(val)     {
		if (val === void) return %[];
		val = val.trim();
		if (val[0] === "@") return val.substr(1);
		if (val.length === 0) return %[];
		return makeValue(val.split(":"));
	}

	// stub
	function makeValue(list) {} /* virtual */

	// 自由度の高い検索(hoge.fuga.ugo は *.ugo や *.fuga.* にマッチ)
	function _searchList(tag) {
		var ret = [ tag ], pos = [ 0 ];
		var tmp = tag.split(".");
		for (var p = 0, i = 0; i < tmp.count; i++, pos[i] = p++) p += tmp[i].length;
		for (var i = 1; i < tmp.count; i++)
			for (var j = tmp.count - i; j >= 0; j--)
				ret.add(tag.substr(0, pos[j]) + ((j>0)?".*":"*") + tag.substr(pos[j+i]));
		ret.add("*");
		return ret;
	}

	function get(tag) {
		var ret;
		if (typeof tag === "String") ret = super.search(tag, _searchList);
		return ret !== void ? ret : %[];
	}
	
}

// ---------------------------------------------------------
// システムトランジション管理
// ---------------------------------------------------------

class SystemTransManager extends SystemDefFileManBase {
//	function finalize() { super.finalize(...); }
	var defaulttrans = "crossfade";
	function SystemTransManager(file) { super.SystemDefFileManBase(...); }

	// split array value to dic
	function makeValue(list) {
		var ret = %[ method:(list[1] != "") ? (list[1].trim()) : defaulttrans ];
		var time = list[0];
		time = time.trim() if (time != "");
		ret.time = +time   if (time != "");
		if (list[2] != "") {
			ret.layer = list[2].trim();
			ret.wait = true;
		}
		return ret;
	}
	function trans(elm, handlers) {
		var name = elm.name, isenv = elm.env;
		delete elm.name;
		delete elm.env;
		var val = get(name);
		if (typeof val == "Object") {
			// envinit の method を上書き
			if (val.method != "" && typeof global.world_object == "Object") try {
				var trans = global.world_object.env.getTransObject(val.method);
				if (trans !== void) {
					var time = val.time;
					delete val.method;
					(Dictionary.assign incontextof val)(trans, false);
					val.time = time;
				}
			} catch {}
			(Dictionary.assign incontextof elm)(val, false);
		}
		if (elm.layer != "") {
			// [XXX]
			var fore = kag.getLayerPageFromElm(elm, false);
			var back = kag.getLayerPageFromElm(elm, true);
			if (!fore.visible) with (fore) {
				with (back) fore.setPos(.left, .top);
				if (fore instanceof "MessageLayer") {
					.setPosition(%[ frame:"", color:0, opacity:0, width:back.width, height:back.height, visible:true ]);
				} else {
					dm("*** systrans unsupported non-message layer");
					.setSize(.width, .height);
					.fillRect(0, 0, .width, .height, .neutralColor);
					.visible = true;
				}
			} else if (!back.visible) with (back) {
				with (fore) back.setPos(.left, .top);
				if (back instanceof "MessageLayer") {
					.setPosition(%[ frame:"", color:0, opacity:0, width:fore.width, height:fore.height, visible:true ]);
					kag.insertTag("position", %[ layer:elm.layer, page:"fore", visible:false ]);
				} else {
					dm("*** systrans unsupported non-message layer");
					.setSize(.width, .height);
					.fillRect(0, 0, .width, .height, .neutralColor);
					.visible = true;
				}
			} else if (fore.left   != back.left   ||
					   fore.top    != back.top    ||
					   fore.width  != back.width  ||
					   fore.height != back.height) {
				dm("*** systrans unmached layersize");
				delete elm.layer;
			}
		}
		SystemHook.exec("systrans." + name); // 直実行なので .ks のフックは実行できないことに注意
		//dm("systrans", elm.method, elm.time);
		if (isenv && typeof world_object.env.endTrans == "Object") {
			elm[elm.method] = true;
			delete elm.method;
			return world_object.env.endTrans(elm);
		}
		return handlers.trans(elm);
	}
}

SystemTransManager.instance = new SystemTransManager("systrans.ini");

// systrans
addKagHandler("systrans", function(elm) {
	SystemHook.pending("_exec", elm.name, elm);
	return SystemTransManager.instance.trans(elm, kag.tagHandlers);
}, false);

// ---------------------------------------------------------
// システム効果音管理
// ---------------------------------------------------------

class SystemSeManager extends SystemDefFileManBase {
//	function finalize() { super.finalize(...); }
	var defaultbuf;
	function SystemSeManager(file, db = 9) {
		defaultbuf = db;
		super.SystemDefFileManBase(file);
	}

	// split array value to dic
	function makeValue(se) {
		return %[ storage: se[0].trim(), buf: (se[1] != "") ? +(se[1].trim()) : defaultbuf];
	}
/*
	function get(tag) {
		var ret = super.get(...);
		dm("getSysSE", tag, ret.storage, ret.buf) if (ret !== void && ret.storage != "");
		return ret;
	}
 */
	function play(elm) {
		elm = get(elm) if (typeof elm == "String");
		with (elm) {
			if (.storage == "") return;
			var se = kag.se[ +.buf ];
			if (se === void) return;
			se.setOptions(%[ gvolume: .volume ]) if (.volume !== void);
			se.play(     %[ storage: .storage ]);
		}
	}
	function state(elm) {
		elm = get(elm) if (typeof elm == "String");
		return (elm.storage !== void) ? kag.se[ +elm.buf ].status : "";
	}
	function add(tag, storage, channel) {
		var val = storage;
		val += ":" + channel if (channel !== void);
		set(tag, getValue(val));
	}
	function setTargetSE(target, base, action) {
		var tag = @"&base;.&action;";
		var se = get(tag);
		if (se === void || se.storage == "" || target[action + "se"] !== void) return;
		target[action + "se"   ] = se.storage;
		target[action + "sebuf"] = se.buf;
	}
	// uiload時にボタンに効果音を割り当てる
	function setUiloadSE(names, dict, place) {
		for (var i = 0; i < names.count; i++) {
			var name = names[i], target = dict[name];
			if (target === void) continue;
			with (target) {
				name = .name   if (.name   != "");
				name = dict[.copy].sename if (.copy != "" && dict[.copy] !== void && dict[.copy].sename != "");
				name = .sename if (.sename != "");
			}
			switch (target.class) {
			case "part": case "base": case "layer": continue;
			}
			var base = place + "." + name;
			setTargetSE(target, base, "click");
			setTargetSE(target, base, "enter");
			setTargetSE(target, base, "leave");
		}
	}
	// 選択肢に効果音を割り当てる
	function setElementSE(elm, defname, list) {
		if (elm === void || list === void) return;
		var base = (elm.sename != "") ? elm.sename : defname;
		for (var i = 0; i < list.count; i++)
			setTargetSE(elm, base, list[i]) if (list[i] != "");
	}
}
SystemSeManager.instance = new SystemSeManager("sysse.ini");
with (SystemSeManager.instance) {
	global.getSysSE    = .get;
	global.playSysSE   = .play;
	global.stateSysSE  = .state;
	global.uiloadSysSE = .setUiloadSE;
	global.elementSysSE= .setElementSE;
	global.addSysSeStorage = .add;
}

// システムSEを鳴らす (name = 効果音タグ)
addKagHandler("sysse", function(elm) {
	playSysSE(elm.name);
	return 0;
}, false);

addKagHandler("selopt", function(elm) {
	elementSysSE(elm, "select", [ "open", "click", "enter","leave" ]);
	setSelectOptions(elm);
	return 0;
}, true);

SystemHook.add("back", function(from, to) {
	var se;
	se = getSysSE(from + ".back");
	se = getSysSE(from + ".back." + to) if (se.storage == "");
	playSysSE(se);
} incontextof global);


