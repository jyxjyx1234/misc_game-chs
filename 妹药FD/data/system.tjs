addKagHandler("sysupdate", function() { return -4; }, false);

addKagHandler("sysinit", function(elm) {
	with (tagHandlers) {
		var e = %[];
		.linemode(e);
		.locklink(e);
		.disablestore(e);
		.cancelskip(e);
		.cancelautomode();
		.cancelnowaitmode();
		.rclick(%[  enabled:false]);
		.history(%[ enabled:false, output:true ]);
		.clearhistory(e);
		.stoprecollection(e);
	}
	return 0;
}, true);

var sysRClickOption = %[  enabled:true, jump:false ];
addKagHandler("sysrclick", function(elm) {
	return tagHandlers.rclick(sysRClickOption);
}, true);
addKagHandler("sysrclickopt", function(elm) {
	(Dictionary.assign incontextof sysRClickOption)(elm, true);
	return 0;
}, false);

addKagHandler("sysrestore", function(elm) {
	with (tagHandlers) {
		var mes = (typeof global.SystemConfig == "Object"
				   && SystemConfig.defaultMessageLayer != "") ?
			/**/      SystemConfig.defaultMessageLayer : "message0";
		.current(%[ layer:mes ]);
		.sysrclick();
		.history(%[ enabled:true ]);
		.unlocklink(%[]);
	}
	return 0;
}, true);


// UILoad用
addKagHandler("syspage", function(elmorig) {
	var elm = %[];
	(Dictionary.assign incontextof elm)(elmorig, true);
	elm.layer = Current.layerName if (elm.layer === void);
	var th = kag.tagHandlers;
	if (elm.uiload) {
		delete elm.uiload;
		th.current(elm);
		Current.uiload(elm);
		Current.action("update");
	} else if (elm.position) {
		delete elm.position;
		return th.position(elm);
	} else if (elm.current) {
		delete elm.current;
		elm.withback = false;
		return th.current(elm);
	} else if (elm.clear) {
		var mes = kag.getMessageLayerObjectFromElm(elm);
		mes.clear(+elm.all) if (mes !== void);
	} else if (elm.free) {
		delete elm.free;
		elm.width = elm.height = 1;
		elm.visible = false;
		return th.position(elm);
	}
	return 0;
}, false);

// クリックを奪ってプライマリ(window)に素通しさせるレイヤを作る
addKagHandler("syscover", function (elm) {
	var cov;
	if (typeof this._sysCoverLayer != "undefined") cov = this._sysCoverLayer;
	else {
		cov =  this._sysCoverLayer = new Layer(this, this.primaryLayer);
		with (cov) {
			.name = "SysCoverLayer";
			.hasImage = false;
			.hitType = htMask;
			.hitThreshold = 0;
			.setPos(0, 0);
			.setSize(exWidth, exHeight);
			.onKeyDown = onKeyDown;
			.rightClickEnabled = false;
			.onMouseUp = function (x, y, btn, sft) {
				switch (btn) {
				case mbLeft: window.onPrimaryClick(); break;
				case mbRight: if (rightClickEnabled) window.onPrimaryRightClick(); break;
				}
			} incontextof cov;
		}
	}
	stopAction(cov);
	with (cov) {
		var vis = !!elm.visible, time = +elm.time, col = +elm.color;
		if (   (!vis && !time) || elm.clear) .hasImage = false;
		else if (vis && elm.color !== void) {
			.hasImage = true;
			.fillRect(0, 0, exWidth, exHeight, (elm.opacity !== void ? (+elm.opacity<<24) : 0xFF000000) | (col & 0xFFFFFF));
			.absolute = currentDialogAbsolute-1 if (elm.absolute === void);
		}
		if (elm.absolute !== void) .absolute = elm.absolute;
		else if (!.hasImage)       .absolute = 9999999;
		.rightClickEnabled = (elm.rclick !== void) ? +elm.rclick : false;
		if (time > 0) {
			.visible = true;
			.focus() if (vis);
			beginAction(cov, %[ opacity:%[ handler:MoveAction, start:(.opacity=vis?0:255), value:vis?255:0, time:time ] ]);
			insertTag("syscover", %[ visible:false ]) if (!vis);
			return waitSingleAction(cov, elm.canskip);
		} else {
			.opacity = 255 if (.hasImage);
			.visible = vis;
			.focus() if (vis);
		}
	}
	return 0;
}, true);

// 右クリックが離されるまで待つ
addKagHandler("waitrclickup", function (elm) {
	if (!getKeyState(VK_RBUTTON) && !(elm.withleft && getKeyState(VK_LBUTTON))) return 0;
	var cb = function (e) { insertTag("next", e) if (e !== void && (e.storage != "" || e.target != "")); } incontextof this;
	conductor.wait(%[
		"mouseup" + mbLeft   => cb,
		"mouseup" + mbMiddle => cb,
		"mouseup" + mbRight  => cb,
		"mouseup" + mbLeft   + "_arg" => elm,
		"mouseup" + mbMiddle + "_arg" => elm,
		"mouseup" + mbRight  + "_arg" => elm,
		]);
	return -2;
}, true);



// 全画面ムービー再生
addKagHandler("sysmovie", function (elm) {
	if (elm.state == "") with (elm) {
//		if (skipNoDisp || skipMode >= SKIP_CANCEL) return  0;
		insertTag("sysmovie", %[ state:"term", color:.color, endcolor:.endcolor ]);
		insertTag("sysmovie", %[ state:"wait", canskip:.canskip, disablerclick:.disablerclick ]);
		insertTag("wait",     %[ canskip:false, time:elm.forcewait ]) if (elm.forcewait !== void);
		insertTag("sysmovie", %[ state:"play", storage:.storage, file:.file, mode:.mode, laystretch:.laystretch,
								 /**/aspectzoom:.aspectzoom, noaudio:.noaudio, bgmflag:.bgmflag, flag:.flag, nohidemscur:.nohidemscur ]);
		insertTag("sysmovie", %[ state:"init", color:.color, begincolor:.begincolor ]);
		return 0;
	}
	var e = %[], col = elm.color;
	var mvs;
	if (typeof    global.sysmovie_stop == "undefined") {
		/**/mvs = global.sysmovie_stop = function () {
			tagHandlers.stopvideo(%[]);
		} incontextof this;
	} else  mvs = global.sysmovie_stop;
	with (tagHandlers) {
		switch (elm.state) {
		case "init":
			.stoptrans(e);
			if (!elm.noclear) {
				.sysmovie(%[ state:"clear", color:(elm.begincolor != "" ? elm.begincolor : col) ]);
			}
			tflags.sysmovie_storage = elm.storage;
			with (Debug.console) {
				tflags.sysmovie_lastconsole = .visible;
				.visible = false;
			}
//			resetScreen();
			return -4; //.wait(%[ time:1 ]);
		case "clear":
			for (var list = [ fore.base, back.base ]; list.count > 0;) {
				var lay = list.pop();
				(global.Layer.setImageSize       incontextof lay)(exWidth, exHeight);
				(global.Layer.setSizeToImageSize incontextof lay)();
			}
			.clearlayers(%[ page:"fore" ]);
			if (col != "") with (fore.base) {
				.fillRect(0, 0, exWidth, exHeight, (+col)|0xFF000000);
				.visible = true;
			}
			.backlay(e);
			try { if (typeof world_object.onSync == "Object") world_object.onSync(); } catch {} // [XXX]
			return 0;
		case "play":
			var mode = (elm.mode != "") ? elm.mode : System.getArgument("-vomstyle");
			var laystretch = (elm.laystretch === void) ? false : +elm.laystretch;
			switch (mode) {
			case "overlay": case "mixer": case "layer": break;
			default:
				mode = checkWindowsVersion("2000") ? "mixer" : "overlay";
				break;
			}
			// セカンダリモニタではlayer固定
//			mode = "layer" if (!CheckPrimaryMonitor(kag));

			.video(%[ visible:false, left:0, top:0, width:scWidth, height:scHeight, mode:mode, aspectzoom:elm.aspectzoom, volume:elm.noaudio?void:"", laystretch:laystretch ]);
			var layered = (movies[0].mode == vomLayer);
			if (layered) {
				.videolayer(%[ page:"fore", layer:"base", channel:1 ]);
				.syscover(%[ visible: true, absolute:1000000, rclick:true, clear:true ]);
			}
			var storage = elm.storage;
			/**/storage = elm.file if (storage == "");
			/**/storage = tflags.sysmovie_storage if (storage == "");
			if (storage == "") throw new Exception("sysmovie: storageの指定がありません");
			if (!Storages.isExistentStorage(storage)) {
				var ext;
				if (     Storages.isExistentStorage(storage + (ext = ".mpg"))) storage += ext;
				else if (Storages.isExistentStorage(storage + (ext = ".wmv"))) storage += ext;
			}
			.openvideo(%[ storage:storage ]);
			var flagname = elm.flag;
			if (flagname == "") with (Storages) flagname = "movie_" + .chopStorageExt(.extractStorageName(storage)).toLowerCase();
			tflags.sysmovie_skip = sflags[flagname] || skipNoDisp || skipMode >= SKIP_CANCEL;
			sflags[flagname] = true;
			var ps = !elm.noplay;
			//dm("sysmovie:flag", flagname, tflags.sysmovie_skip);
			sflags["bgm_" + (elm.bgmflag.toUpperCase())] = true if (elm.bgmflag != "");
			if (layered) {
				.preparevideo(e);
				insertTag("sysmovie", %[ state:"play_start",  noaudio:elm.noaudio, nohidemscur:elm.nohidemscur ]) if (ps);
				return .wp(%[ "for" => "prepare" ]);
			}
			if (!ps) return 0;
			/* not break */
		case "play_start":
			hideMouseCursor() if (!elm.nohidemscur);
			.video(%[ visible:true, left:0, top:0, width:scWidth, height:scHeight, volume:elm.noaudio?void:"" ]);
			var r = .playvideo(e);
			if (tflags.sysmovie_lastconsole) with (Debug.console) {
				.visible = true;
				if (typeof this.bringTo == "Object") bringTo("top", true);
				else if (typeof .bringAfter == "Object") .bringAfter(this);
				else bringToFront();
			}
			delete tflags.sysmovie_lastconsole if (typeof tflags.sysmovie_lastconsole == "undefined");
			return r;
		case "wait":
			rightClickHook.remove(mvs, true);
			rightClickHook.add(mvs) if (!elm.disablerclick);
			elm.canskip = +tflags.sysmovie_skip if (elm.canskip === void);
			return .wv(elm);
		case "term":
			.clearvideolayer(%[ channel:1 ]) if (movies[0].mode == vomLayer);
			.sysmovie(%[ state:"clear", color:(elm.endcolor != "" ? elm.endcolor : col) ]);
			// not break
		case "end":
			rightClickHook.remove(mvs, true);
			.syscover(%[ visible: false ]);
			.clearvideolayer(%[ channel:1 ]);
			.video(%[ visible:false ]);
			return -4; //.wait(%[ time:1 ]);
		}
	}
	return 0;
}, true);

// mixer再生チェッカ
function checkVideoMixerFailed(window, storage) {
	var vov, ret = false;
	// 強制固定なら何もしない
	if (System.getArgument("-vomstyle") != "") return ret;
	if (!Storages.isExistentStorage(storage)) {
		var ext;
		if (     Storages.isExistentStorage(storage + (ext = ".mpg"))) storage += ext;
		else if (Storages.isExistentStorage(storage + (ext = ".wmv"))) storage += ext;
	}
	if (!Storages.isExistentStorage(storage))
		throw new Exception(@"${storage}が見つかりません");

	try {
		vov = new VideoOverlay(this);
		with (vov) {
			.mode = vomMixer;
			.visible = false;
			.open(storage);
			.play();
			.stop();
			.close();
		}
	} catch {
		vov.close() if (vov !== void);
		ret = true;
	}
	invalidate vov if (vov !== void);
	return ret;
}

with (SystemScript) {

	.script("title");
	.add("title.from.option",    "title*loop");
	.add("title.from.load",      "title*loop");

	.script("option");
	.add("option.sysfrom.title", "*sysfrom_title");
	.add("option.sysfrom.game",  "*sysfrom_game");
	.add("option.from.title",    "*start_title");
	.add("option.from.game",     "*start_game");
	.add("game.from.option",     "option*return");

	.script("load");
	.add("load.from.title",    "*start_title");
	.add("load.from.save",     "*start_save");
	.add("load.from.game",     "*start_save");
	.add("load.sysfrom.title", "*sysfrom_title");
	.add("load.sysfrom.game",  "*sysfrom_game");
	.add("game.from.load",     "load*return");

	.script("save");
	.add("save.from.title",    "*start_title");
	.add("save.from.load",     "*start_load");
	.add("save.from.game",     "*start_load");
	.add("save.sysfrom.game",  "*sysfrom_game");
	.add("game.from.save",     "save*return");

	.script("cgmode");
	.script("scenemode");
	.add("scenemode.from.game",         "*restore");
	.add("scenemode.from.recollection", "title*start");
	.script("soundmode");

	addKagHandler("addsysscript", .kagAddScript);
}

with (SystemHook) {

	// ダイアログ終了処理
	var dd = "dialog.done";
	.add(dd, Dialog.done);
	.add("title.leave",     dd);
	.add("option.leave",    dd);
	.add("load.leave",      dd);
	.add("save.leave",      dd);
	.add("cgmode.leave",    dd);
	.add("scenemode.leave", dd);
	.add("soundmode.leave", dd);

	// タイトル⇒ゲーム開始
	.add("change.title.game", function() {
		with (kag) {
			.clearVariables();
			.clearPlayTime();
		}
	} incontextof global);

	.add("first.init", function() {
		// 初回起動時は初期化する
		if (!sf.first_initialized) {
			initialEnvironment(true);
			sf.first_initialized = true;
		}
	} incontextof global);

	.add("save.enter", function() {
		// セーブ前の処理
		SystemAction._preSave();
	} incontextof global);
}

class SystemActionBase {
	// "_" で始まる関数は（動作可能かどうかのチェックをせずに）実際の動作を記述
	// それ以外の関数は，動作可能かどうかのチェックをして対応するメニューアイテムか "_" つき関数を呼び出す

	var _kag;
	property kag { getter { return _kag; } } // read only

	function SystemActionBase(win) {
		_kag = win;
		// 旧互換用
		with (global) {
			.automodeAction      = auto;
			.skipmodeAction      = skip;
			.hidewindowAction    = hide;
			.startSave           = save;
			.startLoad           = load;
			.startOption         = option;
			.startTitle          = title;
			.moveToNextSelection = next;
			.moveToPrevSelection = prev;
			.canQuickLoad        = function { return this.canQuickLoad; } incontextof this;
		}
		updateQuickSaveDataExists();
		SystemHook.add("change", updateQuickSaveDataExists);
	}
	function finalize() {}

	function checkByKey_(sender) { return (typeof sender == "Object") ? void : sender; }
	function do_(func, menu, sender,*) {
		var bykey = checkByKey_(sender);
		if (bykey) kag.releaseCapture();
		if (menu != "") clickMenuItem(menu, func, bykey);
		else func(bykey,*);
		return true;
	}
	function _tglSubMode(state, opt, func, menu, *) {
		if (!kag.inStable) return;
		if (_chkReturn(state, opt)) func = function{}, menu = "";
		return do_(func, menu, *);
	}
	function _chkReturn(state, opt) {
		var ret = (kag.inStable && SystemConfig[opt] && SystemHook.currentState == state);
		kag.onPrimaryRightClick() if (ret);
		return ret;
	}
	function _chkEnable(tag) {
		with (kag) {
			var modal = .historyShowing || .currentDialog || .panelModal; // || .messageLayerHiding;
			var selShow = .selectShowing ||  .mapSelectShowing ||  .transShowing ||  .panelShowing;
			switch (tag) {
			case "hide": return (inGameState(kag) && !inSystemMenu(kag) && !modal);
			case "auto": return !modal && !selShow && !.inSleep && !.skipMode;
			case "skip":
				var r = !modal && !selShow && !.inSleep;
				.showMessageLayerByUser() if (r && .messageLayerHiding); // メッセージレイヤが消されていたら表示
				return r;
			}
		}
		return true;
	}

	/// 画面モード切り替え
	function  screen(*) {
		if (SystemConfig.disableDisplayMenuInMoviePlaying && kag.isMoviePlaying()) return true;
		return do_(_screen, "toggleScreenMenuItem", *);
	}
	/// ウィンドウモード
	function _window() {
		kag.winResMenu.enabled = true if (typeof kag.winResMenu != "undefined");
		kag.onWindowedMenuItemClick();
	}
	/// フルスクリーンモード
	function _fullscreen() {
		kag.winResMenu.enabled = false if (typeof kag.winResMenu != "undefined");
		kag.onFullScreenMenuItemClick();
	}
	function _screen() { if (kag.fullScreened) _window(); else _fullscreen(); }

	/// バージョン情報
	function  about(*)  { return do_(_about, "helpAboutMenuItem", *); }
	function _about()   { kag.onHelpAboutMenuItemClick(); }

	/// 終了
	function  exit(*)   { return do_(_exit, "exitMenuItem", *); }
	function _exit()    { kag.onExitMenuItemClick(); }
	// quit = exit alias
	function  quit()    { return  exit(...); }
	function _quit()    { return _exit(...); }

	/// タイトルへ戻る
	function  title(*)  { return do_(_title, "goToStartMenuItem", *); }
	function _title()   { kag.onGoToStartMenuItemClick(); }

	/// クリック動作
	function  click(*)  { return do_(_click,, *); }
	function _click(bykey) {
		if (bykey) kag.onPrimaryClickByKey();
		else       kag.onPrimaryClick();
	}

	/// 右クリック動作
	function  rclick(*) { return do_(_rclick, "rightClickMenuItem", *); }
	function _rclick()  { kag.onRightClickMenuItemClick(); }

	/// メッセージ窓消去
	function  hide(*)   { return do_(_hide,, *); }
	function _hide(bykey) {
		if (!_chkEnable("hide")) return;
		if (kag.inStable) _hide_(...);
		else              _click(...);
	}
	function _hide_() {
		kag.switchMessageLayerHiddenByUser();
	}

	/// オプション画面呼び出し
	function  option(*) { return _tglSubMode("option", "toggleOption", _option,"configMenuItem", *); }
	function _option()  {
		var isTitle = inTitleMenu(kag);
		startSubSystem(!isTitle, "option.sysfrom." + (isTitle ?  "title" : "game"));
	}

	/// セーブ・ロード画面呼び出し
	function  save(*) { return _tglSubMode("save", "toggleSave", _save, "storeMenu",   *); }
	function  load(*) { return _tglSubMode("load", "toggleLoad", _load, "restoreMenu", *); }
	function _save()  { startSubSystem(true, "save.sysfrom.game"); }
	function _load()  {
		var isTitle = inTitleMenu(kag);
		startSubSystem(!isTitle, "load.sysfrom." + (isTitle ? "title" : "game"));
	}

	/// セーブ前処理
	function _preSave() {
		// 最後のテキストを保存
		var hist = kag.historyLayer;
		kag.addBookMarkInfo("lastText", hist.currentText) if (typeof hist.currentText != "undefined");
		_changeSaveThumbnail();
	}
	/// サムネ差し替え処理
	function _changeSaveThumbnail() {
		try {
			kag.lockSnapshot() if (kag.snapshotLayer === void);
			var storage, objs = [];
			with (global.world_object.env) {
				var ext = [];
				if (.event.isShow()) objs.add(.event);
				ext.assign(.layers);
				for (var i=1; i<ext.count; i+=2) {
					var lay = ext[i];
					if (lay !== void && lay.isShow() && lay.opacity > 0) objs.add(lay);
				}
				objs.sort(function (a, b) { return a.absolute > b.absolute; });
			}
			for (var i = 0; i < objs.count; i++) {
				var img = objs[i].imageFile;
				if (typeof img == "Object" && img) img = img.storage;
				storage = _checkSaveThumbnail(img);
				if (storage != "") break;
			}
			kag.snapshotLayer.loadImages(storage) if (storage != "");
		} catch(e) {
			dm(e.message);
		}
	}
	// サムネ差し替え用stub
	function _checkSaveThumbnail(img) { return void; }

	// クイックセーブのデータ番号
	property qsaveBookmarkNumber { getter { return kag.numBookMarks - 1; } }
	// クイックセーブデータがあるかどうか
	property canQuickLoad { getter { 
		var num = qsaveBookmarkNumber;
		return kag.getBookMarkDate(num) != "" && _qsvExists;
	} }
	var _qsvExists;
	function updateQuickSaveDataExists() {
		_qsvExists = Storages.isExistentStorage(kag.getBookMarkFileNameAtNum(qsaveBookmarkNumber));
	}

	/// クイックセーブ・ロード
	function  qsave(*) { return do_(_qsave_, "quickStoreMenu",   *); }
	function  qload(*) {        do_(_qload_, "quickRestoreMenu", *) if (canQuickLoad); return true; }
	function _qsave()  { _qsvld(_qsave_, "クイックセーブしますか？", "askQSave"); }
	function _qload()  { _qsvld(_qload_, "クイックロードしますか？", "askQLoad"); }
	function _qsvld(func, msg, tag) {
		if (kag.historyShowing) kag.hideHistory();
		if (SystemConfig[tag]) askYesNo(msg, "確認", func);
		else func();
	}
	function _qsave_() { _preSave();
		/**/             if (qsaveFunction(qsaveBookmarkNumber) && SystemConfig.notifyQSave) askYesNo("クイックセーブしました", "通知"); updateQuickSaveDataExists(); }
	function _qload_() { if (qloadFunction(qsaveBookmarkNumber) && SystemConfig.notifyQLoad) askYesNo("クイックロードしました", "通知"); }

	/// スキップモード切替
	function  skip(*)  { return do_(_skip,, *); } // bykey
	function _skip(bykey) {
		if (!_chkEnable("skip")) return;
		if (bykey) kag.skipToNextStopByKey();
		else       kag.onSkipToNextStopMenuItemClick();
	}

	/// オートモード切替
	function  auto(*)  { return do_(_auto,, *); } // bykey
	function _auto(bykey) {
		if (!_chkEnable("auto")) return;
		if (bykey) kag.switchAutoModeByKey(); 
		else       kag.onAutoModeMenuItemClick();
	}

	/// バックログ
	function  backlog(*) { return do_(_backlog,, *); } // bykey
	function _backlog(bykey) {
		with (kag) {
			if (.historyShowing) {
				if (.historyLayer.enabled) .hideHistory();
				else .stopAction(.historyLayer);
			} else if (bykey) {
				.historyLayer.startByKey = true;
				.showHistoryByKey();
			} else .onShowHistoryMenuItemClick();
		}
	}
	// log = backlog alias
	function  log() { return  backlog(...); }
	function _log() { return _backlog(...); }

	/// 前の・次の選択肢へ
	function  next(*) { return do_(_next, "goNextMenuItem", *); }
	function  prev(*) { return do_(_prev, "goBackMenuItem", *); }
	function _next() {
		if (SystemConfig.askNext) askYesNo("次の選択肢に進みますか", "確認", _next_);
		else _next_();
	}
	function _prev() {
		if (!kag.isHistoryOfStoreAlive()) return;
		if (SystemConfig.askPrev) askYesNo("前の選択肢に戻りますか", "確認", _prev_);
		else _prev_();
	}
	function _next_() { kag.skipToStop(true); }
	function _prev_() {
		if (typeof world_object == "Object" && world_object.playerWorking) {
			kag.goBackHistory(false);
		} else {
			loadFunction("prev");
		}
	}

	/// 音声リプレイ
	function  vreplay(*) {return do_(_vreplay, "voiceReplayMenuItem", *); }
	function _vreplay()  {
		if (!inGameState(kag)) return;
		var script = kag.currentVoiceScript;
		Scripts.eval(script) if (script != "");
	}
}

var SystemAction;
var SystemActionClass = SystemActionBase;

// システム動作に関するフラグ等
var SystemConfig = %[

askQLoad    : false, // クイックロード確認
askQSave    : false, // クイックセーブ確認
notifyQLoad : false, // クイックロード完了報告
notifyQSave : true,  // クイックセーブ完了報告
askNext     : true,  // 次の選択肢確認
askPrev     : true,  // 前の選択肢確認
//以下 MyYesNoDialog.forceYesMapで参照
askOverwrite: true,  // 上書き確認
askInit     : true,  // 初期化確認
askTitle    : true,  // タイトルへ戻る確認
askExit     : true,  // ゲーム終了確認

recollectionFadeInStart: true, // 回想開始時にロードと同じフェード処理を入れるかどうか

ignore_world : false, // world拡張を読み込まない
disableDisplayMenuInMoviePlaying : false, // ムービー再生中に画面モードの切り替えを不可にするか
disableTroubleShootMenuFlatten   : false, // 不具合回避の子メニューを上に展開しない

	];

addAfterInitCallback(function() {
	with (kag) {
		// setMenuAccessible の AsyncTrigger化
		.menuAccessibleTrigger = new AsyncTrigger(kag, "setMenuAccessibleAllTriggerAction");
		.menuAccessibleTrigger.cached = true;
		.menuAccessibleTrigger.mode   = atmExclusive; // トリガ優先順位。どうするか？

		.origSetMenuAccessibleAll = kag.setMenuAccessibleAll;
		.setMenuAccessibleAll = function() {
			menuAccessibleTrigger.trigger();
			//dm("accessible: trigger");
		} incontextof kag;

		.setMenuAccessibleAllTriggerAction = function() {
			//	dm("accessible: action\n------------------------");
			origSetMenuAccessibleAll();
		} incontextof kag;

		// デフォルトメッセージ番号が指定されている場合
		var dml = SystemConfig.defaultMessageLayer;
		if (dml != "" && dml.indexOf("message") == 0) {
			._clearMessageLayerNumOnSkipNoDispChanged = +dml.substr(7);
		}
	}

} incontextof global);

// ---------------------------------------------------------
// デバッグユーティリティ

property hasDebugUtil { getter {
	var ret = false, script = "debugutil.tjs";
	try {
		if (Storages.isExistentStorage(script)) {
			KAGLoadScript(script);
			ret = true;
		}
	} catch {}
//	dm("hasDebugUtil");
	return (&hasDebugUtil = ret);
} }

property     skipToScenarioLine { getter {
	return (&skipToScenarioLine = hasDebugUtil ? global.DebugSkipToScenarioLine : function {});
} }
property     editCurrentLineScenario { getter {
	return (&editCurrentLineScenario = hasDebugUtil ? global.DebugEditCurrentLineScenario : function {});
} }
property     startFlagEdit { getter {
	return (&startFlagEdit = hasDebugUtil ? global.FlagEditBase.menuItemClick : function {});
} }
property     selectAutoLabelStore { getter {
	return (&selectAutoLabelStore = hasDebugUtil ? global.DebugAutoStoreBackDialog.menuItemClick : function {});
} }
property     editCurrentVoiceLabel { getter {
	return (&editCurrentVoiceLabel = hasDebugUtil ? global.DebugEditCurrentVoiceLabel : function {});
} }
property                         copyCurrentVoiceToClipBoard { getter {
	return hasDebugUtil ? global.copyCurrentVoiceToClipBoard   : function { global.Clipboard.asText = "！読み込みに失敗しました！"; } incontextof global;
} }
property                         copyCurrentEnvInfoToClipBoard { getter {
	return hasDebugUtil ? global.copyCurrentEnvInfoToClipBoard : function { global.Clipboard.asText = "！読み込みに失敗しました！"; } incontextof global;
} }
property     captureCurrentScreen { getter {
	return (&captureCurrentScreen = hasDebugUtil ? global.DebugCaptureCurrentScreen : function {});
} }
property     editBugReport { getter {
	return (&editBugReport = hasDebugUtil ? global.editBugReport : function {});
} }
property     myExecStorage { getter {
	return (&myExecStorage = hasDebugUtil ? global.myExecStorage : function {});
} }


// execDialog上書き
property execDialog { getter {
//	dm("execDialog");
	var ret, noarc = Storages.isExistentStorage(System.exePath+"data/startup.tjs");
	if (hasDebugUtil && noarc) ret = global.myExecDialog;
	else { KAGLoadScript("ExecDialog.tjs"); ret =global.execDialog; }
	return (&execDialog = ret);
} }
property     execPopup { getter {
	return (&execPopup = hasDebugUtil ? global.myExecPopup : function {});
} }
property     debugMessageReceived { getter {
	return (&debugMessageReceived  = hasDebugUtil ? global.DebugMessageReceived : function {});
} }

// ディレクトリユーティリティ
//KAGLoadScript("dirutil.tjs");
property dirFilesSearch  { getter { Scripts.execStorage("dirutil.tjs"); return global.dirFilesSearch;  } }
property dirFilesForeach { getter { Scripts.execStorage("dirutil.tjs"); return global.dirFilesForeach; } }

// 拡大割合指定
function loadExMenuInterface() {
	if (typeof global.WIN32DialogEX == "undefined") {
		try { KAGLoadScript("win32dialog.tjs"); } catch(e) { return false; }
	}
	if (typeof global.MiddleZoomValueDialog == "undefined") {
		// 拡張メニュー遅延読み
		try { KAGLoadScript("exmenuintf.tjs"); } catch(e) { return false; }
	}
	return true;
}
function inputMiddleZoomPercent() {
	if (!loadExMenuInterface()) return;
	var update, tag = "mzpercent";
	if (typeof global.MiddleZoomValueDialog == "undefined" || System.getKeyState(VK_SHIFT)) {
		var now = System.getArgument("-"+tag);
		now = 50 if (now == "");
		update = System.inputString("拡大割合指定","0(内接)～100(外接)を入力", now);
		if (update === void) return;
		System.setArgument("-"+tag, (string)update);
		changeUserConf(        tag, (string)update);
		kag.onResize();
//		reFullScreen();
	} else {
		var dlg = new MiddleZoomValueDialog();
		dlg.open(kag);
		invalidate dlg;
	}
}
function bindGamePadButton() {
	if (!loadExMenuInterface()) return;
	var dlg = new GamePadBindDialog();
	dlg.open(kag);
	invalidate dlg;
}

// フォント選択差し替え
with(KAGWindow) {
	._selectFontDoUserSelect = .selectFontDoUserSelect;
	.selectFontDoUserSelect = function(*) {
		if (global.loadExMenuInterface()) try {
			var dlg = new MyFontSelectDialog(kag.fore.base, chDefaultFace, *);
			var r = dlg.open(kag);
			invalidate dlg;
			return r;
		} catch {}
		return _selectFontDoUserSelect(...);
	};
}


var ErrorLogWithTimeStamp;
function entryErrorLogWithTimeStamp(msg, file, line) {
	ErrorLogWithTimeStamp = [] if (ErrorLogWithTimeStamp === void);
	with (ErrorLogWithTimeStamp) {
		.unshift(%[ time:System.getTickCount(), msg:msg, file:file, line:line ]);
		.pop()if (.count > 1000); // 上限で切る
	}
}
