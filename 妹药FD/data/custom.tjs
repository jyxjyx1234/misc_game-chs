		kag.add(this);
		kag.addPlugin(this);
		objectHookInjection(%[ target:kag, method:"onConductorLabel", func:function(orig, label, page, *) {
			if(!usingExtraConductor && page !== void) {
				flowBlockHook.onConductorLabel(conductor.curStorage); // [XXX] instance固定
			}
