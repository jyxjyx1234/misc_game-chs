		var target = this.owner;
		if (typeof        target[name] != "undefined") {
			if (set)      target[name] = *value;
			else *value = target[name];
			return true;
		}
		return false;
	}
}
class        ScrollBaseLayer extends Layer {
	function ScrollBaseLayer(win, base, slider = "slider") {
		super.Layer(win, base.parent);
		with (base) {
			name = "ScrollBaseLayer";
			hasImage = false;
			setPos(.left, .top, .width, .height);
			absolute = .absolute;
			visible  = true;
		}
		sliderName = slider;
		targetLayer = new ParentHackLayer(win, this, parent);
		with (targetLayer) {
			.setPos(0, 0, width, height);
			.visible = true;
		}
	}
	function finalize {
		if (targetLayer) invalidate targetLayer;
		super.finalize(...);
	}
	var sliderName;
	var targetLayer;
	function addButton(btn) {
		if (targetLayer) btn.parent = targetLayer;
	}
	function setScrollSize(h) {
		if (targetLayer) targetLayer.height = h;
		_max = (h - this.height);
		var vis = _max > 0;
		if (_max < 0) _max = 0;
		propSetSlider("visible", vis);
		propSetSlider("max",    _max);
	}
	var _ypos = 0, _max;
	property ypos {
		getter    { return _ypos; }
		setter(v) {
			_ypos = +v;
			if (_ypos < 0) _ypos = 0;
			if (_ypos > _max) _ypos = _max;
			if (targetLayer)
				targetLayer.top = -_ypos;
			if(!_ignoreSliderChanged) {
				_ignoreSliderChanged = true;
				propSetSlider("position", _ypos);
				_ignoreSliderChanged = false;
			}
		}
	}
	function fixScroll(y, h, center = false) {
		if (!targetLayer) return;
		if (!center) {
			var max = ypos+height;
			if (y < ypos) ypos = y;
			else if (  y+h >= max)
				ypos = y+h  - height;
		} else {
			ypos = y - h; // [XXX]
		}
		return ypos;
	}
	var _ignoreSliderChanged;
	function onSliderChanged(pos, drag) {
		if (_ignoreSliderChanged) return;
		ypos = pos;
	}
	function getSlider() { return kag.current.names[sliderName]; }
	function invokeSlider(method, *) {
		var slider = getSlider();
		return slider ? slider[method](*) : void;
	}
	function propSetSlider(prop, v) {
		var slider = getSlider();
		if (slider) slider[prop] = v;
	}
	function propGetSlider(prop) {
		var slider = getSlider();
