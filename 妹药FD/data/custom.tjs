		if (!ret) {
			var tag = getCurrentTag();
			owner.flags.beforeFragment = %[ tag:tag, fromTitle:true ];
		}
		SystemAction._scnsel();
		return owner.tagHandlers.s();
	}

	function Tag_checkComplete(elm) {
		// キャラ選択オープンチェック
		if(!sf.chsel_tama && sf.eos_cs03_e2) {
			sf.chsel_tama = true;
			ShowPopup("キャラクター選択に『奇御魂』追加！");
		}
		if(!sf.chsel_haru && sf.eos_af_ed) {
			sf.chsel_haru = true;
			ShowPopup("キャラクター選択に『春奈』追加！");
		}

		// ブロック枠チェック
		var block = getFlowBlockTable(false);
		if (block && block.map) {
			var all = [], map = block.map;
			for (var i = 0; i < map.count; i++) {
				if (map[i].count > 0) all.push(map[i]*);
			}
			var last = all.pop(); // frg_33
			//dm("checkcomplete", last);
			if (!sf["tch_"+last]) {
				var comp = true;
				for (var i  = all.count-1; i >= 0; i--) {
					var tag = all[i];
					if (tag != "" && !sf["eos_"+tag]) {
						comp = false;
						break;
					}
				}
				if (comp) return Tag_flowBlockOpen(%[ tag:last ]);
			}
		}
		return 0;
	}
}
addAfterInitCallback(function() {
	kag.flowBlockHook = new FlowBlockHook(kag);
} incontextof global);

// cf. scnsel.ks*sysfrom_game
addKagHandler("restore_before_fragment", function(elm) {
	if (flags.beforeFragment !== void) with (flags.beforeFragment) {
		tf.scnsel_focus = .tag;
		if (.fromTitle) {
			loadFunction("tflo");
			return 0;
		} else if (.core !== void && .user !== void) {
			pcflags = .core;
			pflags  = .user;
			loadFunction("frag");
			return 0;
		}
	}
	return 0;
}, true);
with (loadTrigger.instance.loadHooks) {
	.tflo = %[ callback:function {
		tf.scnsel_focus = normalizeFlowBlockTag(kag.currentStorage);
		kag.process("scnsel.ks", "*start_title_from_frag",, true);
		return true;
	} incontextof global ];
	.frag = %[ callback:function {
		(function {
			restoreFlags();
			processGo(true);
			insertTag("flowfromfrag");
		} incontextof kag)();
		return true;
	} incontextof global, noclearhist:true ];
}
addKagHandler("flowfromfrag", function(elm) {
	stablePosibility = true;
	notifyStable();
	conductor.sleep();
	conductor.interrupt();

	SystemAction._scnsel();
	onExtraConductorReturn = function {
		//dm("onExtraConductorReturn");
		notifyRun();
		conductor.run();
	} incontextof this;
	return -1;
}, true);





