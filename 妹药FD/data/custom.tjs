}
ExCVCharObject.updateLockMarks = function(names = kag.current.names) {
	for (var list = getCharList(), i = list.count-1; i >= 0; i--) {
		var name = list[i];
		if (name != "") {
			var btn = names["char"+i];
			//dm("updateLockMarks", name, isLocked(name), curChar);
			if (btn) {
				var locked = isLocked(name), current = (name == curChar);
				btn.toggle = locked || current;
				btn.opacity = (locked && !current) ? 192 : 255;
			}
		}
	}
} incontextof null;

class        CustomExtraCharaView extends ExtraCharaViewBase {
	function CustomExtraCharaView { super.ExtraCharaViewBase(...);
		initChGrp();
		tf.title_no_reload <-> _titleCharDelete;
		kag.addHook("keyDown", onKeyDown);
	}
	function finalize {
		kag.removeHook("keyDown", onKeyDown);
		super.finalize(...);
	}

	function onKeyDown(key, shift) {
		with (kag) if (!.inStable || .currentDialog || .panelShowing) return false;
		if (key == VK_SPACE && !shift) {
			kag.process("exchview.ks", "*view");
		}
	}


	var _titleCharDelete = false;
	function onUiloaded(elm, ui) {
		super.onUiloaded(...);
		toggleText(false, kag.currentPage);
		setupFaceButtons();
	}

	function updateButton() {
		var names = kag.current.names;
		redrawFaceButtons(names);
		super.updateButton(...);
		// [XXX] キャラグループ切り替え表示
		var grp = 0;
		for (var i = 0; i < 40; i++) {
			if (i == _chgrpSwitch[grp]) grp++;
			var btn = names["char"+i];
			if (btn) btn.visible = (curChGrp == grp);
		}
		var grp = names["chgrp"+curChGrp];
		if (grp) grp.toggle = true;
		// [XXX] 巫女・裸の特殊対応
		showExclusiveButton(names, "dress1", "dress4");
		showExclusiveButton(names, "dress3", "dress5");
	}
	function showExclusiveButton(names, tag1, tag2) {
		var btn1 = names[tag1];
		var btn2 = names[tag2];
		if ((btn1 === void || btn2 === void) ||
			(btn1.enabled && btn2.enabled) ||
			(!btn1.visible || !btn2.visible)) return;
		var vis = !btn2.enabled;
		btn1.visible =  vis;
		btn2.visible = !vis;
		//dm("showExclusiveButton", btn1.visible, btn2.visible);
	}

	var curChGrp = 0;
	var _chgrpSwitch = [ 10, 26, 38 ];
	function initChGrp() {
		setChGrp(getGlobalFlag("ChGrp"), false);
	}
	function setChGrp(num, setflag = true) {
		curChGrp = (int)+num;
		if (curChGrp < 0 || curChGrp >= _chgrpSwitch.count) curChGrp = 0;
		if (setflag) setGlobalFlag("ChGrp", curChGrp);
	}

	// [XXX]
	var _facex = 8, _facey = 444;
	var _facexstep = 86, _faceystep = 21;
	var _facecmax = 7, _facebtnmax = _facecmax*4;

	function setupFaceButtons() {
		var current = kag.current;
		var x = _facex, y = _facey, ycnt = 0, xcnt = 0;
		var add = current.addButton, loc = current.locate;
		for (var i=0; i<_facebtnmax; i++) {
			loc(x, y);
			var elm = %[  name:"face"+i, graphic: "stand_facebutton", group:"face", halftone:true,
					  exp:@"playSysSE('exchview.face.click'),Current.cmd('setProp/ch.Face/${i}')", target:"*update" ];
			elementSysSE(elm,         "exchview.face", ["enter","leave"]);
			add(elm);
			if (++ycnt < _facecmax) y += _faceystep;
			else {
				y = _facey, ycnt=0;
				if (++xcnt == 2) x += 745+108, _facexstep=-_facexstep;//[XXX]
				else x += _facexstep;
			}
		}
		var nodrag = current.names.nodrag;
		if (nodrag) with (nodrag) {
			.absolute = 0;
			try { .copyAlphaToProvince(); } catch {}
		}
	}
	// 顔一覧の順序入れ替え
	var _faceListCache = %[], _lastFaceListTag;
	function reorderFaceList(obj, list) {
		if (!list || !list.count) return;
		var tag;
		with (obj) tag = @"${.curChar}:${.curDress}:${.curDiff}";
		if (_faceListCache[tag] === void) {
			_faceListCache[tag] = makeFaceList(list);
		}
		var cache = _faceListCache[tag];
		if (_lastFaceListTag != tag) {
			_lastFaceListTag  = tag;
			_redrawFaceList   = cache.names;
		}
		list.assign(cache.list);
	}
	function makeFaceList(list) {
		var map = %[], rename = %[], rev = %[], names = [];
		for (var i = list.count-1; i >= 0; i--) map[list[i]]++;
		for (var i = 0; i < list.count; i++) {
			var text = list[i], orig = text;
			if (text != "") {
				if (map[text+"２"]) text+="１"; // [XXX] 番号抜け対処
//				if (text.indexOf("照れ") > 0)
//					text = "照れ"+text.replace(/照れ/, ""); // [XXX] 照れ対処
				if (text == "表情1") text = "無表情"; // [XXX] 強制rename
			}
			if (orig != text) {
				rename[orig] = text;
				if (map[text]) dm("! face name conflict", orig, text);
			}
			rev[text] = orig;
			names.add(text);
		}
		if (names.count > 1) {
			var top = names.shift();
			names.sort();
			names.unshift(top);
		}
		var r = [];
		for (var i = names.count-1; i >= 0; i--) r[i] = rev[names[i]];
		return %[ list:r, names:names ];
	}

	var _redrawFaceList;
	function redrawFaceButtons(names) {
		if (names.faceright !== void) {
			var list = invoke("ch.getFaceList");
			names.faceright.visible = list ? (list.count > _facecmax*2) : false;
		}
		if (_redrawFaceList === void) return;
		var faces = _redrawFaceList;
		/**/        _redrawFaceList = void;
		for (var i=0; i<_facebtnmax; i++) {
			var btn = names["face"+i];
			if (btn !== void) {
				btn.loadImages("stand_facebutton");
				btn.makeToggle();
				var text = faces[i];
				if (text != "") drawFaceText(btn, text);
			}
		}
	}
	function drawFaceText(lay, text, size) {
		var drawTextKinsokuRect = function (lay, text, elm) {
			elm.param = [ 255, true,
						  /*shadow*/0, 0, 0, 0, 0,
						  /*edge*/  !!+elm.fontedge, (int)+elm.fontedgecolor, 2048, 2 ];
			EdgeShadowDrawTextKinsokuRect(void, lay, text, elm);
		} incontextof global;
		with (lay) {
			var sz = (size === void) ? (text.length > 8 ? 12 : 15) : size;
			var elm = %[ x:0, y:0, w:.width, h:.height, maxline:1, valign:0, halign:0,
					 fontface:global.SystemDefaultFontFace, fontheight:sz ];
			with (elm) {
				.color = 0x000000;
				/*.x=0;*/ drawTextKinsokuRect(lay, text, elm);
				.color = 0x008AEA; .fontedgecolor = 0xFFFFFF; .fontedge = true;
				.x =.w*2; drawTextKinsokuRect(lay, text, elm);
				.color = 0xFFFFFF; .fontedgecolor = 0x009EB5;
				.x =.w*1; drawTextKinsokuRect(lay, text, elm);
				.x =.w*3; drawTextKinsokuRect(lay, text, elm);
			}
		}
	}

	// [XXX] 場所・時間選択パネル
	
	var _panelbx, _panelby = 30, _panelsx= 138, _panelsy = 23;
	function getPanelButtons(name) {
		var ret = [];
		var makebtn = function(x, y, text, exp, grp = "radio") {
			var elm = %[ x:_panelbx+_panelsx*x, y:_panelby+y, group:grp, radio:1, exp:exp, name:text, target:"*panelupdate" ];
			elementSysSE(elm, "svmode.panel", ["enter","leave"]);
			return elm;
		} incontextof this;
		switch (name) {
		case "stageselect":
			_panelbx = 110;
//			_panelby = 30;
			_panelsy = 23;
			var cmax   = invoke("bg.getSelectHead");
			if (typeof cmax == "Object") cmax = cmax[0];
			cmax = (int)+cmax;
			var stages = invoke("bg.getSelectList"), now = getProp("bg.Stage");
			dm("stageselect", stages, now);
			if (stages) {
				var pos = 0, btny = 0;
				for (var i = 0, n = 0; i < stages.count; i++) {
					var tag = stages[i];
					if (tag == "") {
						if (pos > 0) btny += _panelsy;
						pos = 0;
						btny += _panelsy\2;
						continue;
					}
					var caption = (stageRename[tag] != "") ? stageRename[tag] : tag;
					var btn = makebtn(pos, btny, caption, @"playSysSE('exchview.stage.click'),Current.cmd('setProp/bg.Stage/${n++}')");
					btn.graphic = "stand_stagebutton";
					btn.toggle = (tag == now);
					ret.add(btn);
					if (++pos >= cmax) {
						pos = 0;
						btny += _panelsy;
					}
				}
			}
			break;
		case "timeselect":
			_panelbx = 712;
//			_panelby = 30;
			_panelsy = 27;
			var times = invoke("bg.getTimeList"), idx = invoke("bg.getTimeIndex");
			if (times) {
				var y = 0;
				for (var i = 0; i < times.count; i++) {
					var name = times[i], caption = name;
					if (timeRename[name] != "") caption = timeRename[name];
					var btn = makebtn(0, _panelsy*(y++), caption, @"playSysSE('exchview.time.click'),Current.cmd('setProp/bg.Time/${i}')");
					btn.graphic = "stand_timebutton";
					btn.toggle = (i == idx);
					ret.add(btn);
				}
			}
			break;
		}
		return ret;
	}
