class        CustomPopupNotifyer extends PopupNotifyLayer {
	function CustomPopupNotifyer(win, ofs) {
		_yofs  = ofs;
		super.PopupNotifyLayer(win);
	}
	function finalize { super.finalize(...); }
	var SelfClass = global.CustomPopupNotifyer;
	var _yofs;

	function setupConfig {
		var r = %[];
		(Dictionary.assign incontextof r)(super.setupConfig(...));
		r.showoffy += _yofs * r.showstep;
		return r;
	}
	function show() {
		if (super.show(...) && !window.skipNoDisp)
			playSysSE("popup.open");
	}
	function         reparent(fore, idx) {
		return super.reparent(fore, 1);
	}
}
var CustomPopupInstances = [];
function ShowPopup {
	var  idx, Instances = CustomPopupInstances;
	for (idx = 0; Instances[idx] !== void; idx++) {
		var inst= Instances[idx];
		if (inst && !inst._showing) break;
	}
	if (Instances[idx] === void) {
		Instances[idx] = new CustomPopupNotifyer(kag, idx);
	}
	Instances[idx].show(...);
}

class        FragmentPopupNotifyer extends CustomPopupNotifyer {
	function FragmentPopupNotifyer(win, ofs, img, newmark) {
		_image = img, _new = newmark;
		super .CustomPopupNotifyer(win, ofs);
	}
	function finalize { super.finalize(...); }
	var SelfClass = global.FragmentPopupNotifyer;
	var _image, _new;

	function setupConfig() {
		var r = %[];
		(Dictionary.assign incontextof r)(SystemConfig.PopupDefaultConfig);
		r.showposh = -r.showposh;
		r.hastext = false;
		r.showoffx = -r.showoffx;
		r.stoptime = 3000;
		r.showoffy = 64;
		r.showstep = 60;
		return super.setupConfig(r);
	}
	function  setupBaseImage {
		super.setupBaseImage(_image);
		width = imageWidth\3;
		imageLeft = _new ? -width : 0;
		if (_new) try {
			var tmp = window.temporaryLayer;
			tmp.loadImages("flowchart@mark%layer;new");
			tmp.setSizeToImageSize();
			with (tmp) operateRect(-imageLeft + width - .width, 0, tmp, 0, 0, .width, .height);
		} catch {}
	}
	function moved() {
		SelfClass.Hide(this);
		invalidate this;
	}
}
with       (FragmentPopupNotifyer) {
	var c = FragmentPopupNotifyer;
	.Instances = [];
	.Show = function (tag) {
//		if (!SystemConfig.systemPopupEnabled) return;
		tag = normalizeFlowBlockTag(tag);
		if (tag == "") return;
		var img;
		try {
			var block = getFlowBlockInfo(tag);
			if (block !== void) img = block.button;
		} catch {}
		if (img == "") return;
		var idx = 0;
		var newmark = !sf["eos_"+tag];
		while (Instances[idx] !== void) idx++;
		var inst = Instances[idx] = new this(kag, idx, img, newmark);
		inst.show();
	} incontextof c;
	.Hide = function (inst) {
		var idx = Instances.find(inst);
		if (idx >= 0) Instances[idx] = void;
	} incontextof c;
}


