//--------------------------------------------------------------
// 組み込みフォント
KAGLoadScript("PreRenderFontEx.tjs");

with (SystemConfig) {
//	.PreRenderFontTag = "";
//	.PreRenderFontSelectOnly = true;
//	.FontDialogHeight = 190;
}
try {
	var add = PreRenderFontEx.AddFont;
	var list = [
		"ハミング" => "font1",
		"マティス" => "font2",
		"スーラ"   => "font3",
		];
	var sizes = [ 36, 24, 10 ];
	var opt = %[ comment:"フォントワークス提供の組み込みフォントです" ];
	global.SystemDefaultFontFace = list[0];
	for (var i = 0; i < list.count; i+=2) {
		var name = list[i], base = list[i+1];
		if (name == "" ||   base == "") continue;
		for (var j = 0; j < sizes.count; j++) {
			var size = sizes[j];
			if (size <= 0) continue;
			var file = @"${base}_${size}.tft";
			add(name, size, file, opt);
		}
	}
	// デバッグ時には自動でlayerExDrawがリンクされてしまうので破棄
	if (typeof Layer.drawPathString == "Object") {
//		/**/   Layer.drawPathString_orig = Layer.drawPathString;
		delete Layer.drawPathString;
	}
} catch(e) {
	System.inform(e.message);
}

