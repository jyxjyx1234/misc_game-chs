//		else if (Storages.isExistentStorage(scn+".txt")) file += ".txt";
		if (smallPlayed == file) return;
		with (createSmallPlayer()) {
			var target = getSmallPlayLayer("text");
			/**/target.visible = false if (target !== void);
			if (title != "") {
				target = getSmallPlayLayer("title");
				if (target !== void) {
