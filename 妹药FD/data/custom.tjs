// ショートカット

addKagHookCallback("onModeChangeHookEx", function(prop, kag, am, sm, ca, cs, ss, modal, cr) {
	helpShortCutMenuItem.enabled = canConfig(kag, modal);
}, true);
addKagHookCallback("onKAGSetupMenu", function(kag) {
	var item = "helpShortCutMenuItem";
	createMenuFromList(kag, kag.helpMenu, [
		%[  name:item, caption:"ショートカット一覧(&S)",  exp:startShortCutHelp ]
		]);
	updateCaptionMenusMap.keyhelp = item;

	var kb = kagCustomizedKeys;
	kb[ "!keyhelp" ] = startShortCutHelp;
	kb[VK_F1 ] = "keyhelp";							// F1: ショートカット表示
	kb[VK_F2 ] = "screen";							// F2: 画面モード切替
	kb[VK_F3 ] = "option";							// F3: コンフィグ
	kb[VK_F4 ] = "save";							// F4: セーブ
	kb[VK_F5 ] = "load";							// F5: ロード
	kb[VK_F6 ] = "auto";							// F6: オート
	kb[VK_F7 ] = "skip";							// F7: スキップ
	kb[VK_F8 ] = "next";							// F8: 次の選択肢
	kb[VK_F9 ] = "prev";							// F9: 前の選択肢
	kb[VK_F11] = "scnsel";							// F11:シナリオ選択
	kb[VK_F12] = "backlog";							// F12:バックログ
	kb[VK_SPACE] = "hide";							// SPACE:窓を隠す

	kb["S_" + #'S'] = "qsave";						// Shift+S: クイックセーブ
	kb["S_" + #'L'] = "qload";						// Shift++: クイックロード
}, false);

class ShortCutHelpPanel extends PanelLayer {
	var  hs = false;
	function finalize() {
		window.historyEnabled = hs;
		super.finalize(...);
	}
	function ShortCutHelpPanel() {
		super.PanelLayer(...);
		uiload( %[ storage: "shortcuthelp", bgopacity:192, bgcolor:0xC0C0FF ]);
		hs = window.historyEnabled;
		/**/ window.historyEnabled = false;
		focusable = true;
	}
	function onOpen() {
		var r = super.onOpen(...);
		showHideFade(true);
		return r;
	}
	var _closefade;
	function close {
		if (_closefade) return;
		/**/_closefade = true;
		playSysSE("cancel");
		showHideFade(false);
	}
	function  onShowHideFadeDone(vis, en) {
		super.onShowHideFadeDone(...);
		if (!vis) super.close();
	}
	function onMouseUp() { super.onMouseUp(...); close(); }
	function onKeyDown() { super.onKeyDown(...); close(); }
	function checkFocus { return -1; }
}
function startShortCutHelp() {
	startSubSystem(true, "schelp") if (canConfig(kag, kag.currentDialog||kag.panelModal));
}

//------------------------------
with (SystemConfig) {
	.toggleSave   = true;
	.toggleLoad   = true;
	.toggleOption = true;

	.notifyQSave = .notifyQLoad = false;

	.askLoad  = createPropertyProxy("confirmLoad", "true",, "!!");
	.askSave  = createPropertyProxy("confirmSave", "true",, "!!");
	.askQLoad = &.askLoad;
	.askQSave = &.askSave;
}

addKagHandler("callextraconductor", function(elm) {
	callExtraConductor(elm.storage, elm.target, processGo);
	return -1;
}, true);

//--------------------------------------------------------------
// コンフィグ画面

OptionBase.voiceNames = SystemConfig.voiceNames;
class CustomOption extends OptionBase {
	var testvoice, vcnt;
	function finalize()     {
		invalidate testvoice if (testvoice !== void);
		super.finalize(...);
	}
	function CustomOption() {
		super.OptionBase(...);
		addOnOffItem("confirmSave",  "cfsave",  void, "SystemConfig.askSave");
		addOnOffItem("confirmLoad",  "cfload",  void, "SystemConfig.askLoad");

		addOnOffItem("flowPopup",  "flowpop",  void, "SystemConfig.scnUpdatePopupEnabled");
		addOnOffItem("fragPopup",  "frgpop",   void, "SystemConfig.scnFragmentPopupEnabled");

		addUpdate("updateWindowOpac", updateWindowOpac);
		addUpdate("updatePageToggle", updatePageToggle);
		addUpdate("updateMahjongMode", updateMahjongMode);

		_page = (int)+sf.systemPage;

		vcnt = _voiceNames.count;
		testvoice = new VoiceTrack(this);
		testvoice.voiceName = "";
	}

	var storages = [ "config_system", "config_voice" ];
	property storage { getter { return storages[+page] != "" ? storages[+page] : storages[0]; } }
	var _page;
	property page {
		getter { return _page; }
		setter(v) {
			var p = (int)v;
			if      (p < 0) p = 1;
			else if (p > 1) p = 0;
			sf.systemPage = _page = p;
		}
	}

	function getEffectSpeedItem(speed) { /*dm("efs", speed);*/ return (speed <= 0) ? "effect_on" : "effect_off"; }
	function getEffectSpeedValue(name) { /*dm("efv", name); */ return (name == "effect_on") ? 0 : 1; }

	function updateWindowOpac(sampleonly = false)     {
		setItemProp("winopac",   "position",  windowOpac) if (!sampleonly);
		setItemProp("winsample", "opacity",   windowOpac);
	}
	property windowOpac {
		getter { return (int)+sf.windowOpac; }
		setter(v) {           sf.windowOpac = (int)+v; updateWindowOpac(true); }
	}

	function initAndSave() {
		currentVoiceChar = sf.systemVoiceTarget = void;
		return super.initAndSave(...);
	}

	function update() {
//		resetVoiceTarget();
		return super.update(...);
	}

	var _ui;
	function onUiload(elm) { elm.partremove = "remove"; }
	function onUiloaded(elm, ui) {
		_ui = ui;
	}

	function updatePageToggle() {
		setItemProp("page"+page, "toggle", true);
	}

	var _inittag;
	function init(tag) {
		_inittag = tag;
		setDefault(true, true);
	}
	function initialEnvironment() {
		global.initialEnvironment(false, _inittag);
	}

	//==============
	// 麻雀関連
	function updateMahjongMode {
		var exist = MahjongExeExists;
		setItemProp("mjbattle_on",  "enabled", exist);
		setItemProp("mjbattle_ask", "enabled", exist);
		setItemProp("mjbattle_"+mjbattle, "toggle", true);
	}
	property mjbattle {
		getter {
			var mode = +sf.MahjongBattleMode;
			return (mode < 0 || !MahjongExeExists) ? "off" : (mode > 0) ? "on" : "ask";
		}
		setter (mode) {
			sf.MahjongBattleMode = (mode == "on") ? 1 : (mode == "off") ? -1 : "ask";
		}
	}


	//==============
	// キャラボイス関連
	var currentVoiceChar;
	function onCharVoiceChanged(value) {
		kag.setVoiceVolume(currentVoiceChar, value) if (currentVoiceChar != "");
		resetSampleVoiceVolume();
	}
	function setVoiceOnOff(value, tag) {
		tag = currentVoiceChar if (tag == "");
		value = !kag.getVoiceOn(tag) if (value == "toggle");
		value = !!value;
		kag.setVoiceOn(tag, value);
		setVoiceTarget(tag, true, false);
	}
	function resetVoiceTarget() {
		currentVoiceChar = sf.systemVoiceTarget;
		currentVoiceChar = void if (currentVoiceChar == "" || _voiceNames.find(currentVoiceChar) < 0);
	}
	function setVoiceTarget(tag, notoggle = false, useindex = true) {
		if (useindex) tag = _voiceNames[+tag];
		stopSampleVoice();
		setVoiceOnOff("toggle", tag) if (!notoggle && currentVoiceChar == tag && tag != "");
		sf.systemVoiceTarget = currentVoiceChar = tag;
		updateVoice();
	}
	function updateVoice() {
		var hint = "もう一度クリックすると\nボイスのON/OFFを切り替えます";
		var tag = currentVoiceChar, en = (tag != "");
		var idx = -1;
		for (var i = 0; i < _voiceNames.count; i++) {
			var name = _voiceNames[i];
			var on =  kag.getVoiceOn(name);
			setItemProp("offlabel"+i, "absolute", 5000);
			setItemProp("offlabel"+i, "visible", !on);
//			setItemProp("von" +name, "toggle",  on);
//			setItemProp("vof" +name, "toggle", !on);
			setItemProp("ch"  +i,    "toggle",  name == tag);
			setItemProp("ch"  +i,    "hint",    name == tag ? hint : "");
			if (name == tag) idx = i;
		}
		var label = getItem("chname");
		if (label !== void) with (label) {
			.fillRect(0, 0, .width, .height, 0);
			._copyButtonUIStates(0, _ui.chname, void, (string)idx);
		}
		var on = kag.getVoiceOn(tag);
		setItemProp("von",  "enabled", en);
		setItemProp("vof",  "enabled", en);
		setItemProp("von",  "visible", en);
		setItemProp("vof",  "visible", en);
		setItemProp("von",  "toggle",  on && en);
		setItemProp("vof",  "toggle", !on && en);
		on &= en;
		setItemProp("cvtest",    "enabled", on);
		setItemProp("cvtest",    "visible", on);
		setItemProp("cvvolume",  "enabled", on);
		setItemProp("cvvolume",  "visible", on);
		setItemProp("cvvolume", "position", kag.getVoiceVolume(tag, true)) if (tag != "");
	}
	function onStartVoice() {}
	function onStopVoice() {}
	function playSampleVoice() {
		var name = currentVoiceChar;
		playVoice("sample."+name, name) if (name != "");
	}
	function playVoice(tag = "sample.voice", name = "etc") {
		var se = getSysSE(tag);
		if (se === void || se.storage == "") return;
		if (testvoice !== void) with (testvoice) {
			var file = se.storage + ".ogg";
			if (Storages.isExistentStorage(file)) {
				.voiceName = name;
				.volume2 = kag.getVoiceVolume(name) * 1000;
				.open(file);
				.play();
			} else {
				kag.errorSound("サンプルボイスファイルがありません:"+file);
			}
		}
	}
	function stopSampleVoice() {
		testvoice.stop() if (testvoice !== void);
	}
	function resetSampleVoiceVolume() {
		var tag = currentVoiceChar;
		if (testvoice !== void && tag != "")
			testvoice.volume2 = kag.getVoiceVolume(tag) * 1000;
	}
}
Dialog.add(%[ name:"option", start:CustomOption ]);

SystemHook.add("option.close.init", function() {
	resetModeChanged();
	kag.setMenuAccessibleAll();
} incontextof global);


//--------------------------------------------------------------
// セーブロード

class CustomSaveLoad extends SaveLoadBase {
	property names   { getter { return global.kag.current.names; } }
	property buttons { getter { return global.kag.current.buttons; } }

	function finalize() {
		super.finalize(...);
	}
	function CustomSaveLoad(elm) {
		with (elm) {
			.itemname=		"item";   // ボタンレイヤ名
			.mask=			"thumb";   // 　マスク状態名
			.disabled=		"normal"; // 　無効状態名
			.rows=			4;
			.columns=		2;
			.pagecount=		13;
			.ringpage=		true;
			.askoverwrite=	SystemConfig.askSave;
			.askload=		SystemConfig.askLoad;
			.thumbopac=		[ 224,255,255 ];
		}
		super.SaveLoadBase(SaveDataButton, elm);

		_view.drawDisabledItem = drawDisabledItem;

		// ライトプロテクト
		global.kag.scflags.bookMarkProtect = %[] if (typeof global.kag.scflags.bookMarkProtect == "undefined");
	}
	property protectMap { getter { return global.kag.scflags.bookMarkProtect; } }
	function onUiload(elm) {
		elm.partremove = (_issave ? "rm_save" : "rm_load") + (fromTitle ? "_t" : "");
		super.onUiload(...);
	}

	var ncox, ncoy, dpos, tpos, npos;
	var cursel, curofsx, curofsy;
	function onUiloaded(elm, ui) {
		super.onUiloaded(...);

		with (uiloadGetRect( "new",      ui)) ncox  =.x, ncoy  =.y;
		with (uiloadGetRect( _itemname,  ui)) ncox -=.x, ncoy -=.y;
		npos = uiloadGetRect(_itemname+".num",  ui);
		dpos = uiloadGetRect(_itemname+".date", ui);
		tpos = uiloadGetRect(_itemname+".text", ui);

//		with (uiloadGetRect(_itemname, ui)) curofsx =.x, curofsy =.y;
//		with (uiloadGetRect("cursor", ui)) curofsx-=.x, curofsy-=.y;

	}
	function getSysButton(tag, ret) { return ((ret = buttons[tag]) !== void) ? ret : %[]; }
	function getProtectButton(num)  { return getSysButton("pt" + num); }
	function getCommentButton(num)  { return getSysButton("tx" + num); }
	function getDeleteButton(num)   { return getSysButton("rm" + num); }
	function getCopyButton(num)     { return getSysButton("cp" + num); }
	function getMoveButton(num)     { return getSysButton("mv" + num); }
	function setupSysButtons(elm, ui, tag, exec) {
		for (var n = 0; n < _rowcol; n++) {
			var uis = ui[tag + n];
			if (uis !== void) with (uis) {
				.exp     = @'Current.cmd("${exec}/${n}")';
//				.onenter = @'Current.cmd("enter/${n}")';
//				.onleave = @'Current.cmd("leave/${n}")';
			}
		}
	}
	function updateSysButtons(base, ui) {
		foreach(base.buttons, function(k,v,d, ui){
			if (v) with (v) {
				.halftone=true; //(k.indexOf("pt")<0);
				.absolute=1000;
				.hitType = htMask;
				.hitThreshold = 0;
				var tag = "UpArrow";
				var info = ui[k.replace(/[0-9]/g, "")+"0"];
				if (info !== void && info.cursor != "") tag = info.cursor;
				.cursor = getSystemMouseCursor(tag, .cursor);
			}
		}, ui);
	}

	function update() {
		cursel = void;
		showNewIcon(void);
		super.update(...);
		drawCopyModeState();
		updateEditButton();
	}
	function showNewIcon(target, names = kag.current.names) {
		var newicon = names.new;
		if (newicon !== void) with (newicon) {
			.setPos(target.left + ncox, target.top + ncoy) if (target);
			.visible = !!target;
		}
		if (target === null) sf.lastsaved = void;
	}

	function updateEditButton(num) {
		if (num === void) {
			for (var i = 0; i < _rowcol; i++) updateEditButton(i);
			return;
		}

		var pos = offset + num;
		var btn = names["item" + num];
		if (btn === void) return;
		var wp  = protectMap[getDataNumber(pos)];

		// ボタンが有効な場所のみ表示
		// セーブ時はデータがない場所は表示しない
		var vis = isExistData(pos);
		var en = (_issave && !vis) || (_iscopy != "") ? false : isEnabled(pos) ;
		setSystemButtonEnabled(getProtectButton (num), en, vis).toggle =  wp;
		en &&= !wp;
		setSystemButtonEnabled(getCommentButton (num), en, vis);
		setSystemButtonEnabled(getDeleteButton  (num), en, vis);
		var issrc = (_iscopy != "" && _copysrc == pos);
		en ||= issrc;
		setSystemButtonEnabled(getCopyButton(num), en, vis).toggle = issrc && (_iscopy == "copy");
		setSystemButtonEnabled(getMoveButton(num), en, vis).toggle = issrc && (_iscopy == "move");
	}
	function setSystemButtonEnabled(btn, en, vis) {
		with (btn) {
			.visible = vis;
			.hitThreshold = en ? 0 : 256;
			.enabled = en;
		}
		return btn;
	}
	function protect(num) {
		num = (int)num;
		var pos = offset + num;
		var idx = getDataNumber(pos);
		var map = protectMap;
		var wp  = map[idx] = !map[idx];

		var btn = names["item" + num];
		btn.enabled = isEnabled(pos) && !(_issave && wp);
		updateEditButton(num);
		kag.saveSystemVariables();
	}
	function comment(num) {
		num = (int)num;
		var pos = offset + num;
		var info = getItemInfo(pos);
		if (info !== void) {
			var comment = info.comment != "" ? info.comment : info.lastText;
			var text = EditSaveDataComment(getNumberText(pos)+"のコメントを編集", comment);
			if (text !== void) {
				dm("changeComment", text);
				kag.writeBookMarkInfo(getDataNumber(pos), %[ comment:text ]);
				forceRedrawItem(pos);
			}
		}
	}
	function forceRedrawItem(pos) {
		super.forceRedrawItem(...);
		updateEditButton(getItemPosition(pos));
	}
	function save(num) {
		var r = super.save(...);
		if (r) protectMap[getDataNumber(num)] = false;
		return r;
	}

	var shortcutKeys = %[
		VK_C => "cp",
		VK_M => "mv",
		VK_P => "pt",
		VK_W => "tx",
		VK_DELETE => "rm",
		];
	function onKeyDown(key, sft) {
		if (!(sft & ssRepeat)) {
			var tag = shortcutKeys[key];
			if (tag !== void) with(kag.current) {
				if (.keyLink >= 0 && .keyLink < .numLinks) {
					var obj = .links[.keyLink].object;
					if (obj !== void && obj.name != "" && obj.name.substr(0,4) == "item") {
						var num = +obj.name.substr(4,1);
						with (getSysButton(tag + num)) {
							.onExecute(.width\2, .height\2, mbLeft, 0) if (.enabled && .visible);
						}
					}
				}
			}
		}
		return super.onKeyDown(...);
	}

	function drawDisabledItem(target, num) {
		var _uiDisable = _view._uiDisable;
		if (target !== void && _uiDisable !== void) {
			target.loadUIInfo( _uiDisable);
			target._copyButtonUIStates(0, _view._uiNormal, void, "number");
			drawInfoText0(target, npos, "%03d".sprintf(num+1));
		}
	}
	function isEnabled(num) {
		return _iscopy != "" || super.isEnabled(num);
	}

	function drawItem(target, info, view, num) {
//		target._copyButtonUIStates(0, view._uiNormal, void, "cover");
		for (var i = 0; i < 3; i++)
			target._copyButtonUIStates(i, view._uiNormal, void, "number");
		drawInfoText0(target, npos, "%03d".sprintf(num+1));
		if (info === void) return;
		for (var i = 0; i < 3; i++)
			target._copyButtonUIStates(i, view._uiNormal, void, "line");
		
		if (info.lastsaved) showNewIcon(target);
		target.font.face = global.SystemDefaultFontFace; //kag.chDefaultFace;
		with (info) {
			drawInfoText1(target, dpos, .realdate);
			var  comment  = .comment;
			if ( comment != "") target.font.face = "マルベリ"; //"ＭＳ Ｐゴシック";
			else comment  = .lastText;
			drawInfoText2(target, tpos, comment, 3);
		}
		var wp = protectMap[getDataNumber(num)];
		if (_iscopy != "") return (num != _copysrc) && !wp;
		if (_issave && wp) return false;
	}
	var textprm = [255, true, 255, 0, 2, 1, 1];
	function drawInfoText0(target, pos, text) {
		with (target.font) {
			.face = global.SystemDefaultFontFace; //"ＭＳ ゴシック";
			.height = pos.h+1; //[XXX]
		}
		var ox = pos.ox, oy = pos.oy-2, step = pos.h-3; // [XXX]
		drawButtonCaptionWithAlign(target, ox,   oy, 7, (string)text, 0xFFFFFF, textprm*);
	}
	function drawInfoText1(target, pos, text) {
		var ox = pos.ox+(pos.w-target.width)\2, oy = pos.oy+1;
		with (target.font) {
			.face = "マルベリ";
			.height = pos.h-2; // [XXX]
		}
		drawButtonCaptionWithAlign(target, ox, oy, 8, text, 0xFFFFFF, textprm*);
	}
	function drawInfoText2(target, pos, text, line) {
		var w = target.width, h = pos.h\line, elm = %[
		x:pos.ox+1, y:pos.oy+1, w:pos.w-2, h:pos.h,
		maxline:line, linestep:h, fontheight:h-2,
		color:0xFFFFFF, param:textprm ];
		drawTextKinsokuRect(target, text, elm); elm.x += w;
		drawTextKinsokuRect(target, text, elm); elm.x += w;
		drawTextKinsokuRect(target, text, elm);
	}

	function remove(idx) {
		var pos = offset + (int)+idx;
		askYesNo("AskDelete", "確認", saveDataDelete, jumpToWait, pos);
	}
	function copymove(num, mode = "copy") {
		if (_iscopy == mode) clearCopyMode(false);
		else {
			_copysrc = tf.CopyFileTarget = offset + (int)+num;
			_iscopy  = tf.CopyFileMode   = mode;
		}
		update(true);
		jumpToWait();
	}
	function copy(num) { copymove(num, "copy"); }
	function move(num) { copymove(num, "move"); }
	function saveDataDelete { onDelete(...); jumpToWait(); }
	function onDelete(num) {
		var info = getItemInfo(num);
		if (info !== void && info.lastsaved) showNewIcon(null);
		var r = super.onDelete(...);
		forceUpdateEditButton(); //[XXX]
		return r;
	}
	function jumpToWait() {
		kag.process(_issave ? "save.ks" : "load.ks", "*wait");
	}
	function onSelect(num) {
		var msg, action, cf;
		switch (_iscopy) {
		case "": case void:
			//return super.onSelect(...);
			_lastSelect = num;
			var mes = _message;
			if (_issave && !isExistData(num)) mes = "AskSave";
			if (_ask) askYesNo(mes, "確認", _action, void, num);
			else _action(num);
			return;

		default:
		case "copy": msg = "AskCopy"; action = saveDataCopy; cf = "askSave"/*"askCopy"*/; break;
		case "move": msg = "AskMove"; action = saveDataMove; cf = "askSave"/*"askMove"*/; break;
		}
		if (SystemConfig[cf]) askYesNo(isExistData(num) ? "AskOverwrite" : msg, "確認", action, void, num);
		else action(num);
	}
	function drawCopyModeState() {
		var en = (_iscopy != "");
		if (en) {
			var mode = _iscopy == "move" ? "移動" : "コピー";
			drawHelpText(@"${getNumberText(_copysrc,true)}の${mode}先を選択します");

			var item = getItemTarget(_copysrc);
			if (item !== void) with (item) {
				.copyRect(0, 0, item, .width*2, 0, .width, .height);
			}
		} else {
			drawHelpText();
		}
		with (kag.current.names) {
			.to_load.enabled = !en if (.to_load !== void);
			.to_save.enabled = !en if (.to_save !== void);
		}
	}
	function saveDataCopy(num) { onCopyMove(num, Storages.copyFile); }
	function saveDataMove(num) { onCopyMove(num, Storages.moveFile); }
	function onCopyMove(dstnum, opr) {
		// [TODO] 動作が遅いので bookMarkIndex 関連の処理を最適化すること
		var get    = kag.getBookMarkFileNameAtNum;
		var srcnum = _copysrc;
		var src    = getDataNumber(srcnum);
		var dst    = getDataNumber(dstnum);
		var from   = get(src);
		var to     = get(dst);

		playSysSE("save.commit");

		// Newアイコンを消す
		var info = getItemInfo(srcnum);
		if (info.lastsaved) showNewIcon(null);
		/**/info = getItemInfo(dstnum);
		if (info !== void && info.lastsaved) showNewIcon(null);

		kag.eraseBookMark(dst);
		super.onDelete(dstnum);

		opr(from, to, false);
		clearFilePlaceCache();
		clearCopyMode();
		update(true);
	}
	function clearCopyMode(redraw = true) {
