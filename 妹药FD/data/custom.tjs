function EditSaveDataComment(caption, text) {
	var title = System.title;
	if (typeof global.EditSaveDataCommentDialog == "undefined") {
		try {
			KAGLoadScript("win32dialog.tjs");
			KAGLoadScript("editcomment.tjs");
		} catch {
			global.EditSaveDataCommentDialog = null;
		}
	}
	if (typeof global.EditSaveDataCommentDialog == "Object" &&
		/**/   global.EditSaveDataCommentDialog !== null) {
		try {
			var dialog = new EditSaveDataCommentDialog(title, caption, text);
			var ret = dialog.open(kag);
			invalidate dialog;
			return ret;
		} catch(e) {
			dm(e.message);
			global.EditSaveDataCommentDialog = null;
		}
	}
	return System.inputString(title, caption, text);
}

