		}
		if (!fromTitle) {
			//[XXX]
			var cur;
			cur = kag.mainConductor.curStorage;
			cur = kag.pcflags.currentStorage if (cur === void);
			with (Storages) cur = .chopStorageExt(.extractStorageName((string)cur.toLowerCase()));
			if (cur != "" && scnRevMap[cur] !== void) return scnRevMap[cur];
		}
		return -1;
	}
	function getPageEnabled(p) {
		return true;
	}
	function getCommentLayer() { return kag.current.names.text; }
	function clearCommentText() {
		var text, summary = pageSummary[page];
		switch (typeof summary) {
		case "Object": text = summary.join("\n"); break;
		default:       text = (string)summary;    break;
		}
		internalDrawCommentText(text);
	}
	function  drawCommentText(pos) {
		internalDrawCommentText(getItemInfo(pos, "comment"));
	}
	function internalDrawCommentText(text) {
		var target = getCommentLayer();
		if (target !== void) with (target) {
			.fillRect(0, 0, .width, .height, 0);
			if (text != "") {
				// [XXX]
				drawTextKinsokuRect(target, text, %[
				x:8, y:0, w:.width-16, h:.height, valign:0, halign:-1,
				fontface:global.SystemDefaultFontFace, fontheight:18, linestep:30,
				color:0xFFFFFF, param:[255, true] //, 255, 0, 2, 1, 1]
					]);
			}
		}
	}

	// アイテムの表示状態を設定
	function makeItemState(pos, tag, info) {
		var r = %[];
		(Dictionary.assign incontextof r)(info);
		with (r) {
			// 定義済みinfo
			// .file   = シナリオファイル
			// .page   = 表次ページ
			// .button = ボタン画像ファイル
			// .x, .y  = ボタン座標
			// .mahjong = 麻雀対戦有無
			.tag = tag;
			var all = tf.allseen;
			var get = this.getGlobalFlag;
			.name    = "item"+pos; // ボタンレイヤ名
			.visible = true;  // 表示有無
			.canjump = (all || get("fos_"+tag) || get("tch_"+tag));  // ジャンプ可能有無
			.known   = (all || get("eos_"+tag) || get("tch_"+tag));  // タイトル表示有無（ない場合は？？？ボタン）
			.preview = (all || get("eos_"+tag)); // あらすじ・プレビュー有無
			.newmark = .canjump && !.preview; // Newマーク有無

			.comment = getCommentText(r); //マウスオーバー時コメントテキスト
		}
