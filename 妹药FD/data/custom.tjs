@if (DEBUG)
function MakeFlowInfo()
{
	var ystep = 68, yspace = 24;
	var text = [];
	var root = System.exePath;
	text.load(root + "doc/＊フローチャート配置.ini");
	var state = -1, page = -1, ypos;
	var btns = Scripts.evalStorage(root + "setup/flowbuttons.tjs");
	var idxs = Scripts.evalStorage(root + "setup/flowindex.tjs");
	for (var i = 0; i < idxs.count; i++) idxs[i] = ((string)idxs[i]).toLowerCase();
	var output = %[ map:[], items:%[], files:%[], unknown:btns["000"], lines:[] ];
	for (var i = 0; i < text.count; i++) {
		var line = text[i].split("\t");
		var top = ((string)line[0]).charAt(0);
		if (top == "#") continue;
		switch (top) {
		case "#": continue;
		case "*": page = (int)+line[1]; ypos = state = 0; continue;
		case ":":                              state = 1; continue;
		}
		switch (state) {
		case 0:
			var lf   = line[0];
			var mf   = line[1];
			var rf   = line[2];
			var file = line[3];
			var tag, cnt = 0, xpos = -1;
			if (lf != "") tag = lf, cnt++, xpos=0;
			if (mf != "") tag = mf, cnt++, xpos=1;
			if (rf != "") tag = rf, cnt++, xpos=2;
			if (cnt > 0) {
				if (cnt > 1) throw new Exception(@"conflict block : ${text[i]}");
				if (file == "") file = tag;
				dm(tag, file);
				file = file.toLowerCase();
				var num = idxs.find(file);
				if (num <= 0) throw new Exception(@"index not found : ${file}");
				var btn = btns["%03d".sprintf(num)];
				if (btn == "") throw new Exception(@"button not found : ${file}");
				if (output.items[tag] !== void)
					throw new Exception(@"conflict block : ${tag}");
				var elm = output.items[tag] = %[ page:page, file:file, x:xpos, y:ypos, button:btn ];
				output.files[file] = tag;
				if (line[4] == "対戦") elm.mahjong = true;
				if (output.map[page] === void)
					output.map[page] = [];
				/**/output.map[page].add(tag);
				ypos+=ystep;
			} else {
				ypos+=yspace;
			}
			break;
		case 1:
			var ltype = line[0];
			var from  = line[1];
			if (from == "") break;
			if (output.items[from] === void)
				throw new Exception(@"unknown linet block : ${from}");
			for (var i = 2, to; (to = line[i]) != ""; i++, from=to) {
				if (output.items[to] === void)
					throw new Exception(@"unknown linet block : ${to}");
				var pair = [ from, to ];
				if (ltype != "") pair.add(ltype);
				if (output.lines[page] === void)
					output.lines[page] = [];
				/**/output.lines[page].add(pair);
			}
			break;
		default:
			dm(@"unknown state: ${state} : ${text[i]}");
			break;
		}
	}
	text.load(root + "doc/＊あらすじ一覧.txt");
	state = 0;
	var comment;
	var donecomment = function(list) {
		if (list === void) return;
		for (var i = list.count-1; i >= 0; i--) {
			if (list[i] == "") list.erase(i);
			else break;
		}
	} incontextof global;
	for (var i = 0; i < text.count; i++) {
		var line = text[i];
		switch (line.charAt(0)) {
		case "#": break; // コメント行
		case "▼":
			donecomment(comment);
			var page = (int)+line.charAt(1);
			if (output.summary === void)
				output.summary = [];
			/**/output.summary[page] = comment = [];
			state = 2;
			break;
		case "●":
			donecomment(comment);
			var div = line.split(":");
			var tag = div.shift();
			tag = tag.substr(1);
			if (tag == "") throw new Exception("empty tag");
			if (output.files[tag] != "")
				tag  = output.files[tag];
			var info = output.items[tag];
			if (info === void) throw new Exception("tag not found:"+tag);
			var title = "『"+div.pop()+"』";
			if (div.count > 1) div = [ div.join("／") ];
			div.push(title);
			info.caption = div.join("\n");
			info.summary = comment = [];
			state = 1;
			break;
		default:
			if (state > 0) {
				if (comment &&
					comment.count < 3)
					comment.add(line);
			}
			break;
		}
	}
	donecomment(comment);
	makeDictionaryOutputTexts(
		%[ target:output, indent:"\t", "const"=>true],
		[ "// 自動生成ファイルです。直接編集しないでください！" ]
		).save2(System.exePath+"data/main/flowblock.tjs");
}
function MakeScnTitles {
	var block = getFlowBlockTable(false);
	if (!block && !block.map) return;
	var all = [], map = block.map;
	for (var i = 0; i < map.count; i++) {
		if (map[i].count > 0) all.push(map[i]*);
	}
	/*
	var output = [];
	for (var i  = 0; i < all.count; i++) {
		var tag = all[i];
		if (tag == "") continue;
		var info = block.items[tag];
		var name = info.button;
		if (name.indexOf("マス_") == 0) name = name.substr(3);
		name = name.replace(/_/g, ":");
		output.add(@"●${info.file}:${name}");
		output.add("");
	}
	output.save2(System.exePath+"doc/＊あらすじ一覧.txt");
	 */

	var replaceLabel = function(file, title) {
		var pattern = /^(\*.*?\|)(.+)$/;
		var pat2    = /^\t*[\[@]next.*storage=.*$/;
		var cmcut   = /(^\t*;)(.*)$/;

		var tmp = [], save = false;
		if (!Storages.isExistentStorage(file)) {
			dm("not found", file, title);
			return;
		}
		tmp.load(file);
		for (var ln = 0; ln < 30; ln++) {
			var m = pattern.match((string)tmp[ln]);
			//dm(tmp[ln], m.count);
			if (m.count > 0) {
				tmp[ln] = m[1] + title;
				save = true;
				break;
			}
		}
		if (!save) {
			kag.errorCmd("ラベルが見つかりませんでした"+ file);
		}
		dm("search", save, file, title);
	@if (1)
		// コメントを駆除する
		for (var ln = tmp.count-1; ln >= 0; ln--) {
			var m = cmcut.match((string)tmp[ln]);
			if (m.count > 0) {
				tmp[ln] = m[1];
				save = true;
			}
		}
	@endif
		tmp.save2(Storages.getPlacedPath(file)) if (save);
	} incontextof global;

	for (var i = 0; i < all.count; i++) {
		var tag = all[i];
		if (tag == "") continue;
		var info = block.items[tag];
		if (info === void) continue;

		var title = info.caption;
		if (title == "") continue;

		var div = title.split("\n");
		div.unshift();
		title = div.pop();
		title += "／"+div.join("：") if (div.count > 0);

		replaceLabel(info.file + ".txt", title);
	}

	replaceLabel("総合プロローグ.txt", "総合プロローグ");
}

@endif

