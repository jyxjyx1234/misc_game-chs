	function createLayerWithImage(file) {
		var lay = new global.Layer(kag, kag.primaryLayer);
		lay.loadImages(file);
		lay.face = dfOpaque;
		lay.currentColor = void;
		return lay;
	}
	function stampMark(lay, x, y, col, opa, src, sx, sy, sw, sh) {
		col &= 0xFFFFFF;
		if (src.currentColor !== col) with (src) {
			.colorRect(0, 0, .imageWidth, .imageHeight, col, 255);
			.currentColor = col;
		}
		lay.fillRect(x, y, sw, sh, 0);
		lay.operateRect(x, y, src, sx, sy, sw, sh, omAuto, opa);
	}
	// [XXX]
	function stampArrow (lay, x,y, col, opa) { stampMark(lay, x-8, y-8, col, opa, line_arrow, 0,8,16,8); }
	function stampRoundL(lay, x,y, col, opa) { stampMark(lay, x,   y,   col, opa, line_round, 0,0, 8,8); }
	function stampRoundR(lay, x,y, col, opa) { stampMark(lay, x-8, y,   col, opa, line_round, 8,0, 8,8); }

	var _lineWidth = 4, _space = 350, _lrpad = 44, _blockHeight = 55; // [XXX]
	var _lineXPos  = [ _lrpad\2, _space\2, _space-_lrpad\2 ];
	function drawLine(lay, from, to, color = 0x9ab3dd, opa = 128, ltype) { // [XXX]
		if (from == "" || to == "") return;
		var fitem = items[+scnRevMap[from]];
		var titem = items[+scnRevMap[to  ]];
		if (fitem === void || titem == void) return;
		var fx = fitem.x, tx = titem.x;
		var fy = fitem.y, ty = titem.y;
		if (fy >= ty) throw new Exception(@"invalid line:${from}->${to}");
		var fcol = (opa<<24 | color), lw = _lineWidth;
		if (fx == tx) {
			// 直線
			var x = _lineXPos[fx], y = fy+_blockHeight;
			lay.fillRect(x-lw\2, y, lw, ty - y, fcol);
			stampArrow(lay, x, ty, color, opa);
		} else {
			// Ｌ字
			var x = _lineXPos[tx], y = fy+_blockHeight\2;
			lay.fillRect(x-lw\2, y, lw, ty - y, fcol);
			stampArrow(lay, x, ty, color, opa);
			var cx = _lineXPos[1];
			var isR = cx < x;
			x += isR ? lw\2 : -lw\2;
			lay.fillRect(isR ? cx : x, y, (int)Math.abs(x-cx), lw, fcol);
			if (isR) stampRoundR(lay, x,y, color, opa);
			else     stampRoundL(lay, x,y, color, opa);
		}
	}

	//==============================
	var scrollBase;
	function createScrollBaseLayer() {
		deleteScrollBase(...);
		var base = kag.current.names.scroll;
		if (base === void) return;
		scrollBase = new ScrollBaseLayer(base.window, base);
	}
	function deleteScrollBase(comp) {
		if (scrollBase) with (scrollBase) {
			var pile = kag.current;
			if (comp) pile = pile.comp;
			try {
				var tmp = kag.temporaryLayer;
				.hasImage = true;
				tmp.setSize(.width, .height);
				tmp.piledCopy(0, 0, scrollBase, 0, 0, .width, .height);
				pile.operateRect(.left, .top, tmp, 0, 0, .width, .height, omAuto, .opacity);
			} catch (e) {
				dm(e.message);
			}
			invalidate scrollBase;
		}
	}
	function onSetupFlowBlocks(names, dic, inspos) {
		var ins = names.find(inspos) + 1;
		var base = _rowcol * page;
		for (var i = _rowcol-1; i >= 0; i--) {
			var info = items[base + i];
			if (info !== void) with (info) {
				names.insert(ins, .name);
				dic[.name] = %[ name:.name, graphic:(.known ? .button : unknownBlock), "class" => "button", trigger:true,
								/**/exp:    @"Current.cmd('select/${i}')",
								/**/onenter:@"Current.cmd('onItemEnter/${i}')",
								/**/onleave:@"Current.cmd('onItemLeave/${i}')",
								/**/x:.x * 45,
								/**/y:.y,
								];
			}
		}
	}
	function removeFlowBlockExp(names, dic) {
		var base = _rowcol * page;
		for (var i = _rowcol-1; i >= 0; i--) {
			var info = items[base + i];
			if (info !== void) with (info) {
				if (!.canjump) with (dic[.name]) {
					delete .exp;
					delete .clickse;
					delete .enterse;
					delete .leavese;
				}
			}
		}
	}
	function replaceItemParent() {
		if (!scrollBase) return;
		var names = kag.current.names, maxh = -1;
		for (var i = 0; i < _rowcol; i++) {
			var btn = names["item"+i];
			if (btn === void) continue;
			var h = btn.top + btn.height;
			if (maxh < h) maxh = h;
			scrollBase.addButton(btn);
		}
		scrollBase.setScrollSize(maxh);

		var lines = scnLineList[page];
		if (lines !== void) {
			for (var i = 0; i < lines.count; i++) {
				var pair = lines[i];
				if (pair) {
					// [XXX] [TODO]
					var from = pair[0];
					var to   = pair[1];
					var vis  = tf.allseen || (getGlobalFlag("fos_"+from) && (getGlobalFlag("fos_"+to) || getGlobalFlag("tch_"+to)));
					var opac = (getGameFlag("line_"+from) && getGameFlag("line_"+to)) ? 255 : void;
					if (vis) drawLine(scrollBase.targetLayer, from, to,, opac);
				}
			}
		}
	}

	var pageSliderPos = [];
	function onPageChange {
		if (scrollBase) {
			pageSliderPos[+page] = scrollBase.ypos;
			
		}
	}

	function onSliderChanged(pos, drag) {
		if (scrollBase)
			scrollBase.onSliderChanged(...);
	}
	function onWheel(shift, delta, x, y) {
		if (scrollBase)
			scrollBase.ypos -= delta\4;
	}
	function getLinkHotSpot(mes, orig, linkn) {
		if (scrollBase) {
			var obj = linkn.object;
			if (obj) with (obj) {
				var name = (string)obj.name, tag = "item";
				if (name.indexOf(tag) == 0) {
					var pos = offset + (int)+name.substr(tag.length);
					var y = scrollBase.fixScroll(.top, .height);
					return %[ x:scrollBase.left + .left + .width\2, y:scrollBase.top + (.top - y) + .height\2 ];
				}
			}
		}
		return orig(linkn);
	}
}
