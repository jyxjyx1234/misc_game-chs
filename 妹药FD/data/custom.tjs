	function setSubDress(num) {
		invoke("ch.setSubIndex", num);
	}

	function onPropChanged(obj, name, prop, val) {
		//dm("onPropChanged", name, prop, val);
		if (name == "ch" && prop == "Char" && lastname == "") lastname = void;
	}

	function onUpdateCurrentCharState(obj, faces) {
		reorderFaceList(obj, faces);
	}

	function replaceCharRedraw(owner, name, elm) {
	}

	var curtext, lastname;
	function editText() {
		var name = lastname !== void ? lastname : getProp("ch.Char");
		var r = EditStandMessage((string)name, curtext);
		if (r !== void) with (kag.fore.messages[0]) try {
			.visible = true;
			try {
				var face = kag.chDefaultFace;
				var faces = global.PreRenderFontEx.PreRenderFontNames;
				if (faces.find(face) >= 0) {
					switch (face) {
					case "マルベリ": case "シーダ": break;
					default:
						.userFace = "マルベリ"; //"ＭＳ ゴシック";
						.resetNameLayerFont();
						break;
					}
				}
			} catch {}
			.clear();
			.setStyle(%[ linespacing: 10 ]); // [XXX]
			.processName(lastname = (string)r.name);
			var text = curtext = r.text;
			for (var i = 0; i < text.length; i++) {
				var ch = text.charAt(i), brk = false;
				if (i == 0 && ch != "" && kag.autoIndentBeginCharacters.indexOf(ch) >= 0 &&
					text.substr(1).indexOf(ch) < 0) .preIndent(ch);
				if (ch == '\n') brk = .processReturn();
				else brk = .processCh(ch);
				if (brk) break;
			}
		} catch {}
		toggleText(false);
	}
	function toggleText(tgl = true, isback = false) {
		try {
			var vis;
			with (kag[isback ? "back" : "fore"].messages[0]) {
				vis = .visible;
				if (tgl) vis = !vis;
				.visible = vis;
				if (!vis) lastname = void;
			}
			kag.current.names.msgtgl.toggle = vis;
		} catch {}
	}

	// ヘルプ
	function onHelp() {
		var text = [];
		text.load("svmode_help.txt");

		if (typeof    global.SvmodeHelpPad == "undefined") {
			var pad = global.SvmodeHelpPad = new Pad();
			with (pad) {
				.color     = clWindow;
				.fontColor = clWindowText;
				.fontFace = "ＭＳ Ｐゴシック";
				.fontHeight = 12;
				.readOnly = true;
				.wordWrap = true;
				.showScrollBars = ssVertical;
				.title = "Stand CG Mode ヘルプ";
				.statusText = "";
			}
		}
		if (typeof global.SvmodeHelpPad == "Object") {
			with  (global.SvmodeHelpPad) {
				SystemAction._window();
				.visible = true;
				.text = text.join("\n");
			}
		}
	}
}

Dialog.add(%[   name:"exchview", start:CustomExtraCharaView, storage:"extra_stand" ]);

// セーブデータコメントを編集
function EditStandMessage(caption, text) {
	var title = "テキスト窓の内容を編集"; //System.title;
	if (typeof global.EditStandMessageDialog == "undefined") {
		try {
			KAGLoadScript("win32dialog.tjs");
			KAGLoadScript("editcomment.tjs");
		} catch {
			global.EditStandMessageDialog = null;
		}
	}
	if (typeof global.EditStandMessageDialog == "Object" &&
		/**/   global.EditStandMessageDialog !== null) {
		try {
			var dialog = new EditStandMessageDialog(title, caption, text);
			var ret = dialog.open(kag);
			invalidate dialog;
			return ret;
		} catch(e) {
			dm(e.message);
			global.EditSaveDataCommentDialog = null;
		}
	}
	var r = System.inputString(title, caption, text);
	if (r !== void) {
		return %[ name:caption, text:text ];
	}
	return void;
}

class        CustomExChViewPanel                 extends PanelLayer {
	function CustomExChViewPanel(win, name, elm) { super.PanelLayer(...);
		uiload( %[ storage: "extra_stand", func:"stand_"+elm.name, opacity:128, bgcolor:0 ]);
//		setOption(%[ left:0, top:0, width:kag.scWidth, height:kag.scHeight, color:0x000000, opacity:128 ]);
		var buttons = Current.cmd("getPanelButtons/"+elm.name);
		if (buttons !== void) {
			for (var i = 0; i < buttons.count; i++) {
				var elm = buttons[i];
				addButton(elm);
				var obj = links[numLinks-1].object;
				if (obj !== void) with (obj) {
					CustomExtraCharaView.drawFaceText(obj, elm.name, 12);
					.makeToggle();
					.groupName = elm.group;
					.toggle = true if (elm.toggle);

					minx = .left         if (minx === void || minx > .left);
					miny = .top          if (miny === void || miny > .top);
					maxx = .left+.width  if (maxx === void || maxx < .left+.width );
					maxy = .top +.height if (maxy === void || maxy < .top +.height);
				}
			}
		}
		if (minx !== void) {
			var pad = 8;
			minx -= pad;
			miny -= pad;
			maxx += pad;
			maxy += pad;
		}
	}
	var minx, miny, maxx, maxy;
	function finalize() { super.finalize(...); }
	function processLink(n)	{
		// リンク番号 n を処理する
		var ln = links[n];
		if(ln !== void && ln.object !== void) with (ln.object) {
			if (.groupName != "") {
				.toggle = true;
				for(var i = links.count-1; i>=0; i--) {
					var l = links[i];
					if (l.type == ltButton && l.object !== ln.object && l.object.groupName == .groupName) {
						l.object.toggle = false;
					}
				}
			}
		}
		return super.processLink(...);
	}
	function onMouseUp(x,y) {
		super.onMouseUp(...);
		if (x < minx || y < miny || x >= maxx || y >= maxy) close();
	}
	function close() {
		if (_closed) return;
		_closed = true;
		enabled = false;
		kag.process("", "*panelclose");
	}
}

function CheckExChViewEnabled(elm) {
	elm.enabled = !!(tf.allseen || sf.seira_clear);
}

