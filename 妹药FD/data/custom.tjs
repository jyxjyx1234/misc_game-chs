function IsBirthDayChanged(last) {
	var birth = (CustomTitle.getBirthDay incontextof CustomTitle)();
	return birth !== last;
}
class CustomTitle {
	var allclear, isbirthday, birthsel, bgmloop, btngrp;
	function CustomTitle() {
		allclear = tf.allseen || sf.allclear;

		bgmloop = true; //!sf.movie_ruitomo_fd_op800_h;

		birthsel = -1;
		isbirthday = getBirthDay();
		if (isbirthday != "") {
			var max = BirthDayMap[isbirthday];
			if (max > 1) birthsel = makeRandom(max);
		}

		init();
	}
	function finalize() {
		cancelDelay();
		resetBGMLoopFlag();
	}
	function cancelDelay  { try { kag.cancelDelay();     } catch {} }
	function bgm_setLoop  { try { kag.bgm.setLoop(...);  } catch {} }
	function clearBgmStop { try { kag.clearBgmStop();    } catch {} }

	function setBGMLoopFlag(lp) { bgm_setLoop(lp); }
	function resetBGMLoopFlag   { setBGMLoopFlag(true); clearBgmStop(); }
	function updateBGMLoopFlag  { setBGMLoopFlag(btngrp ? true : bgmloop); }

	function changeButton(part) {
		if (typeof part == "Object") part = part.part;
		btngrp = parts.find(part);
		resetBGMLoopFlag();
	}
	function getUiPart { return parts[+btngrp]; }

	var parts   = [ "main", "exsel", "gsel" ];

	var bgfile;
	function init(elm) {
		if (isbirthday != "") {
			bgfile = "hb_"+isbirthday + (birthsel >= 0 ? $(#'a' + birthsel) : "");
		} else {
			var type = GetCharaGameType();
			bgfile = "title_bg_" + (type != "" ? type : "sin");
		}
	}

	function onFirst {}
	function onWait {
		updateBGMLoopFlag();
		tf.last_birth = isbirthday;
		tf.title_no_reload = (isbirthday == "");
	}

	function loadBG() {
		var add = kag.addTag;
		add("title_base", %[ file:bgfile ]) if (bgfile != "");
	}
	function loadChara(elm) {
		var hasvoice = !!+elm.voice;
		if (isbirthday != "") {
			if (hasvoice) {
				// [XXX] 定数埋め込み
				var rnd = makeRandom(2);
				if (birthsel >= 0) rnd += 2*birthsel;
				tf.titlecall = @"*hb${isbirthday}_${'%02d'.sprintf(rnd+1)}";
				conductorCall("custom.ks", "*title_char_common");
			}
		} else {
			var rnd  = getRandomVoice();
			if (rnd != "") {
				tf.titlecall = "*tc"+rnd;
				conductorCall("custom.ks", "*title_char_" + (hasvoice ? "withvoice" : "withoutvoice"));
			}
		}
	}
	function conductorCall(storage, label) {
		var conductor = kag.conductor;
		conductor.callLabel("");
		conductor.loadScenario(storage);
		conductor.goToLabel(label);
	}
	function onUiload(elm) {
		elm.partexcept+=",trial" if (IsTrial);
		elm.partremove = "logo" if (isbirthday != "");
		dm("onUiload", elm, elm.partexcept);
		elm.transparent = true;
	}

	//時間に合わせて台詞を決定
	//朝セリフ    6：00～10：59 : 0
	//昼セリフ   11：00～16：59 : 1
	//夕方セリフ 17：00～18：59 : 2
	//夜セリフ   19：00～22：59 : 3
	//深夜セリフ 23：00～ 5：59 : 4
	function getZone(date) {
		var h = operateDate(date, function(date) { return date.getHours(); });
		if (h <  6) return 4;
		if (h < 11) return 0;
		if (h < 17) return 1;
		if (h < 19) return 2;
		if (h < 23) return 3;
		/**/        return 4;
	}
	function operateDate(date, callback) {
		var c = (date === void);
		if (c) {
			date = new Date();
			@if (DEBUG)
			var opt = System.getArgument("-debugforcetitledate");
			if (opt != "") {
				switch (opt.charAt(0)) {
				case "t":
					date.setHours((int)+opt.substr(1));
					break;
				case "d":
					var m = opt.substr(1,2);
					var d = opt.substr(3,2);
					if (m.charAt(0) == "0") m = m.substr(1);
					if (d.charAt(0) == "0") d = d.substr(1);
					date.setMonth(((int)+m) - 1);
					date.setDate ( (int)+d);
					break;
				}
			}
			@endif
		}
		var r = callback(date);
		invalidate date if c;
		return r;
	}

	function makeRandom(max) {
		return (int)(defaultRandomGenerator.random() * max);
	}

	function getRandomVoice(chara, zone) {
		var format = GetCharaGameType(chara, "voice");
		if (format != "") {
			zone = getZone() if (zone === void);
			// [XXX] 定数埋め込み
			var rnd = makeRandom(3);
			return format.sprintf(1 + zone*3 + rnd);
		}
	}
	function playRandomVoice(zone) {
		var chr = sf.chselect;
		if (chr == "") return kag.errorCmd("キャラ指定が不正です");
		var file = getRandomVoice(chr, zone);
		if (file == "") return kag.errorSound("ボイスファイルが不明です");
		var unk = kag.forEachFunctionHook;
		unk("onUnknown", "env", %[ stopallvoice:true ]);
		unk("onUnknown",  chr,  %[ playvoice:file, sync:true ]);
	}

	function getBirthDay(date) {
		var date = operateDate(date, function(date) {
			return "%02d%02d".sprintf(date.getMonth() + 1,
									  date.getDate());
		});
		return BirthDayMap[date] ? date : void;
	}
}
