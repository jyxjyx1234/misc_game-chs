// アル先生のレッスン教材

class CustomMapSelectLayer        extends MyMapSelectLayer {
	function CustomMapSelectLayer { super.MyMapSelectLayer(...); }
	function finalize {
		stopVoice();
		invalidate voiceTrack if voiceTrack;
		/**/       voiceTrack = void;
		super.finalize(...);
	}
	var _storage = "lesson";
//	property msgoff { getter { return false; } }

	function isSystemButton(name) { return name == "play"; }

	function createIcon {}
	function clear() {
		stopVoice();
		return super.clear(...);
	}

	var voiceList, voiceTrack, voiceLoop;
	function setup(file = "al_lesson.csv", vname = "アル") {
		if (voiceList !== void) return;
		/**/voiceList = [];
		/**/voiceTrack = new VoiceTrack(this);
		/**/voiceTrack.voiceName = vname;
		var list = [];
		list.load(file);
		for (var i = 0, cnt = list.count; i < cnt; i++) {
			var item = ((string)list[i]).trim();
			if (item == "" || item.charAt(0) == "#") continue;
			var comma = item.indexOf(",");
			if (comma > 0) item = item.substr(0, comma);
			voiceList.add(item) if (item != "");
		}
	}
	function onSysButton(name, button) {
		playRandomVoice();
	}

	function playRandomVoice(loop = true) {
		setup();
		voiceLoop = loop;
		if (voiceTrack !== void) with (voiceTrack) {
			var rnd = voiceList[(int)(defaultRandomGenerator.random() * voiceList.count)];
			var storage = getExistFileNameAutoExtFill(rnd, "ogg", "wav");
			if (storage != "") {
				.volume2 = window.getVoiceVolume(.voiceName) * 1000;
				.open(storage);
				.play();
			} else {
				window.errorSound("ボイスファイルがありません:"+rnd);
			}
		}
	}
	function onStartVoice() {}
	function onStopVoice() {
		if (voiceLoop) playRandomVoice();
	}
	function stopVoice() {
		voiceLoop = false;
		voiceTrack.stop() if voiceTrack;
	}

}
global.MapSelectLayer = CustomMapSelectLayer;



