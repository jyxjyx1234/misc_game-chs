		setter(v) { try {          SystemConfig.scnPreviewEnabled = !!v; } catch {} updateSmallPlay(); }
	}

	//------------------------------

	function onJump(pos) {
		var tag = getItemInfo(pos, "tag");
		if (((string)tag).indexOf("frg") == 0) with (kag) {
			var backup = .flags.beforeFragment = %[ tag:tag, fromTitle:fromTitle ];
			if (!fromTitle) {
				(Dictionary.assignStruct incontextof (backup.core = %[]))(.pcflags, true);
				(Dictionary.assignStruct incontextof (backup.user = %[]))(.pflags,  true);
			}
		}
		return super.onJump(...);
	}

	function onItemEnterLeave(vis, pos) {
		if (vis && getItemInfo(pos, "preview")) {
			/**/startSmallPlayer(getJumpScenario(pos), getItemInfo(pos, "known") ? getItemInfo(pos, "caption") : "???");
		} else  stopSmallPlayer();
		if (vis && /*[XXX]*/pos != _prologueTag) {
			var item = getItemTarget(pos);
			if (item && scrollBase) with (item) scrollBase.fixScroll(.top, .height);
		}
		super.onItemEnterLeave(...);
	}

	var scnRevMap = %[], scnLineList, unknownBlock, blockRatio, pageSummary;
	function loadScenarioInfo() {
		var block = getFlowBlockTable();
		var files, items, map;
		with (block) files=.files, items=.items, map=.map, scnLineList=.lines, unknownBlock=.unknown, pageSummary=.summary;
		var maxpage = map.count, per = -1;
		for (var pg = 0; pg < maxpage; pg++) {
			var cnt = map[pg].count;
			if (per < cnt) per = cnt;
		}
		_itemList.clear();
		(Dictionary.clear incontextof scnRevMap)();
		var total = 0, seen = 0;
		for (var pg = 0; pg < maxpage; pg++) {
			var base = per * pg, list = map[pg];
			var cnt = list.count;
			for (var i = 0; i < cnt; i++) {
				var name = list[i], cur, index = base + i;
				var cur = _itemList[index] = makeItemState(i, name, items[name]);
				scnRevMap[name    ] = index;
				scnRevMap[cur.file] = index;
				if (cur.canjump) seen++;
				if (cur.preview) seen++;
				total += 2;
			}
		}
		blockRatio = total > 0 ? (int)(seen*100/total) : 0;
		return %[ items_per_page:per, maxpage:maxpage, /*initialpage:0*/ ];
	}
	function getCurrentScenarioNumber() {
		if (typeof    tf.scnsel_focus != "undefined") {
			var sel = tf.scnsel_focus;
			delete    tf.scnsel_focus;
