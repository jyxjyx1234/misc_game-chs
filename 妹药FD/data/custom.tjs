				var elm = %[
				x:8, y:8, w:w-16, h:h-16, //valign:1,
				fontface:"ＭＳ Ｐゴシック", fontheight:12, linestep:16, maxline:maxline,
				color:0xFFFFFF, param:prm ];
				drawTextKinsokuRect(lay, text, elm); prm[4] = 2; prm[2] = 4096;
				drawTextKinsokuRect(lay, text, elm);
