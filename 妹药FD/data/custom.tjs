	}
	function onUiload(elm) { elm.partremove="remove"; }

	//------------------------------
	var line_round, line_arrow;
	function createLineLayers() {
		line_round = createLayerWithImage("flowline_round");
		line_arrow = createLayerWithImage("flowline_diamond");
