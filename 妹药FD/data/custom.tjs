//--------------------------------------------------------------
// アイコンフェード

SystemConfig.iconFaderHoldInitialState = true;
SystemConfig.iconFaderList = [
	"auto", "skip", "vreplay", "hide", /*|*/ "save", "load", "option", "scnsel", "log", "lock", "prev"
	];

class        IconAutoFader {
	function IconAutoFader(kag) {
		this.kag = kag;
		with (kag) {
			.add(this);
			.addPlugin(this);
			.addHook("mouseMove", onMouseMove);
			.addHook("onResetModeChanged", reset);
			.addHook("onModeChangeHookEx", this.onModeChanged);
		}
	}
	property hold {
		getter {
			var r = kag.scflags.IconFaderHold;
			if (r === void) r = !!SystemConfig.iconFaderHoldInitialState;
			return r;
		}
		setter (v) {
			var old = !!(this.hold);
			var cur = kag.scflags.IconFaderHold = !!v;
			kag.setMenuAccessibleAll();
			if (old != cur) checkEnter(true);
		}
	}
	function onModeChanged(prop, kag, auto, skip, canauto, canskip, ss, modal, cr) {
		prop.checkToggleChanged("lock", "iconHold", hold);
	}

	var _iconList = SystemConfig.iconFaderList;
	var kag, _enter, _fade;
	function setOne(names, opac, ds*) {
		var dsopac = (int)+sf.windowOpac;
		for (var i  = _iconList.count-1; i >= 0; i--) {
			var tag = _iconList[i];
			if (names[tag] !== void) {
				names[tag].opacity = ds[i] ? dsopac : opac;
			}
		}
	}
	function set(*) {
		try { setOne(kag.fore.messages[0].buttons, *); } catch {}
		try { setOne(kag.back.messages[0].buttons, *); } catch {}
	}
	function update(opac = _fade) {
		set(opac); //, kag.autoMode, !!kag.skipMode);
	}
	property fade {
		getter { return _fade; }
		setter(v) {
			v = (int)+v;
			var upd = (_fade !== v);
			_fade = v;
			update() if (upd);
		}
	}
	function setEnter(ent, force) {
		if (_enter !== ent || force) {
			_enter  =  ent;
			var cur = _fade, val = ent ? 255 : hold ? (int)+sf.windowOpac : 0;
			kag.stopAction(this);
			_fade = void;
			if (cur === void || val === cur) {
				fade = val;
			} else {
				kag.beginAction(this, %[ fade:%[ handler:MoveAction, start:(fade = cur), value:val, time:200 ] ],, true);
			}
		}
	}
	function checkEnter(force) {
		var lay = kag.fore.messages[0].buttons.attention;
		if (lay !== void) with (lay) {
			var cx = .cursorX, cy = .cursorY, enter = false;
			if (cx >= 0 && cy >= 0 && cx < .width && cy < .height) {
				enter = true; //.getMaskPixel(cx, cy) > 0;
			}
			setEnter(enter, force);
		}
	}
	function onMouseMove(x, y) {
		checkEnter() if (inGameState(kag) && kag.current === kag.fore.messages[0]);
	}
	function reset() {
		_enter = _fade = void;
		checkEnter(true) if (inGameState(kag));
	}
}
addAfterInitCallback(function() {
	kag.iconFader = new IconAutoFader(kag);
} incontextof global);
function ToggleSysButtonHold { try { with (kag.iconFader) .hold = !.hold; } catch {} }

//--------------------------------------------------------------
// ダイアログ画面

class CustomYesNoDialog extends MyYesNoDialogLayer {
	function finalize()          { super.finalize(...); }
	function CustomYesNoDialog() { super.MyYesNoDialogLayer(...); }
	function uiload(elm) {
		var msg = (elm.partexcept.indexOf("Done") == 0) ? "notify" : "confirm";
		msg <-> elm.partexcept;
		
		var r = super.uiload(...);
		var rect  = uiloadGetRect("base.text", r);

		msg = replace[msg] if (replace[msg] != "");
		with (font) {
			.height = fontsize;
			.face   = fontface;
		}
		var x, y, lst = msg.split("\n"), lines = lst.count;
		with (rect) x = .x + .w\2, y = .y + .h\2;

		// 文末の空行を削除
		while (lines > 0) if (lst[lines-1] != "") break; else lines--;
		if (lines <= 0) return r;

		// トータルの縦幅を計算
		var lh = fontsize + linespace;
		var h = lh * (lines-1) + font.getTextHeight(lst[lines-1]);
		y -= h\2;

		// 文字描画
		for (var i = 0, opt = drawoptions; i < lines; i++, y+= lh)
			drawText(x - font.getTextWidth(lst[i])\2, y, lst[i], opt*);

		return r;
	}
	property fontface { getter { return kag.chDefaultFace; } }
//	var fontface  = "ハミング"; //ＭＳ Ｐゴシック";
	var fontsize  = 24;
	var linespace = 5;
	var drawoptions = [ 0xFFFFFF, 255, true, 255, 0, 0, 2, 1 ];
	var replace = %[
	AskTitle:     "タイトルへ戻ります",
	AskExit:      "終了します",
	AskInit:      "初期化します",
	AskLoad:      "ロードします",
	AskSave:      "セーブします",
	AskOverwrite: "上書きします",
	AskQSave:     "クイックセーブします",
	AskQLoad:     "クイックロードします",
	AskBackTo:    "前の選択肢へ戻ります",
	AskNext:      "次の選択肢へ進みます",
	AskJump:      "ジャンプします",
	AskQuitReplay:"回想を中断します",
	AskDelete:    "削除します",
	AskCopy:      "コピーします",
	AskMove:      "移動します",
//	AskTagInit:   "付箋を全て初期化します",
//	DoneQSave:    "クイックセーブしました。",
		];
}

with (MyYesNoDialog) {
	.dialogLayer = CustomYesNoDialog;
	var inst = .instance;
	with (inst) {
		.yesnoMap["セーブしてよろしいですか？"] = "AskSave";
		with (.defaultFocusItem) {
			.AskJump = .AskNext = .AskBackTo = "yes";
			.AskLoad = .AskSave = .AskQLoad = .AskQSave = "yes";
			.DoneQSave = "ok";
		}
		.getMessageMap = function(m) {
			return (yesnoMap[m] != "") ? yesnoMap[m] : m;
		} incontextof inst;
	}

	// 麻雀中はウィンドウのダイアログを使用する
	objectHookInjection(%[ target:inst, method:"useWindowDialog", func:function(orig) {
		dm("useWindowDialog");

		//if (mjshow) return true;

		return orig();
	} ]);
}

