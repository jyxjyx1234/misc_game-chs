	.scnUpdatePopupEnabled   = createPropertyProxy("scnUpdatePopupEnabled",   "true",, "!!");
	.scnFragmentPopupEnabled = createPropertyProxy("scnFragmentPopupEnabled", "true",, "!!");
}

