	}

	var cursel, curofsx, curofsy;
	function onUiloaded(elm, ui) {
		super.onUiloaded(...);
		with (uiloadGetRect("item0",  ui)) curofsx =.x, curofsy =.y;
		with (uiloadGetRect("cursor", ui)) curofsx-=.x, curofsy-=.y;
		cursel = void;

		chinfo = ui.stand.uistates;
		var cur = kag.current;
		chstand1 = createChStand(chstand1, "replay1", cur);
		chstand2 = createChStand(chstand2, "replay2", cur);
	}

	function createChStand(old, name, par) {
		if (old !== void) {
			old.parent = par;
			return old;
		}
		var r = new AffineLayer(par.window, par);
		if (r !== void) with (r) {
			.name = "ChStand:" + name;
			.hitType = htMask;
			.hitThreshold = 256;
			.visible = false;
		}
		return r;
	}
	function stampChStand(chstand) {
		try {
			kag.stopAction(chstand);
			with (chstand) if (.visible) .parent.operateRect(.left, .top, chstand, 0, 0, .width, .height, omAuto);
		} catch {}
	}
	var sel = false;
	function getChStand(toggle) {
		if (toggle) sel = !sel;
		return sel ? chstand1 : chstand2;
	}

	property standbase { getter { var r; try { r = kag.current.names.stand; } catch {} return r; } }

	var firstUpdate = true;
	function onPageChanged() {
		if (firstUpdate) firstUpdate = false;
		else try { standbase.visible = true; } catch {}
		var chstand = getChStand(false);
		if (chstand !== void) {
			kag.stopAction(chstand);
			chstand.visible = false;
		}
		dm("onPageChanged");
	}

	var _fadetime = 200, _slide = -5;
	function onEnterLeave(pos, vis) {
		var cur = kag.current.names.cursor;
		var item = getItemTarget(pos, true);
		if (cur !== void && item !== void && (vis || cursel === pos)) {
			cur.setPos(item.left - curofsx, item.top - curofsy);
			cur.visible = vis;
			if (vis && cursel !== pos) {
				var info, name;
				try {
					name = items[offset + (int)pos].comment.trim();
					info = chinfo[name];
				} catch {}
				var chstand = getChStand(true);
				if (info !== void && chstand !== void) with (chstand) {
					kag.stopAction(chstand);
					.absolute = 0;
					.visible = true;
					.loadImages(info.storage);
					.setPos(info.ox - _slide, info.oy);
					var stand = standbase;
					if (stand !== void) {
						stand.assignImages(._image._image); // [XXX]
						stand.setSizeToImageSize();
						stand.setPos(info.ox, info.oy);
					}
					kag.beginAction(chstand, %[ left:%[ handler:MoveAction, start:(info.ox-_slide), value:info.ox, accel:-1, time:_fadetime ],
											opacity: %[ handler:MoveAction, start:(.opacity=0), value:255, accel:-1, time:_fadetime ] ],, true);
				}
			} else if (!vis) {
				var chstand = getChStand(false);
				if (chstand !== void && chstand.visible) with (chstand) {
					var opac = .opacity, left = .left;
					kag.stopAction(chstand);
					.absolute = -1, .left = left;
					var stand = standbase;
					if (stand !== void) {
						stand.setImageSize(1,1);
						stand.fillRect(0, 0, 1, 1, 0);
						stand.setPos(0, 0);
					}
					kag.beginAction(chstand, %[ opacity:%[ handler:MoveAction, start:(.opacity=opac), value:0, time:_fadetime ] ],
									function { if (isvalid this) visible = false; } incontextof chstand, true);
				}
			}
		}
		cursel = vis ? pos : void;
	}
	function enter(num) { onEnterLeave(+num, true); }
	function leave(num) { onEnterLeave(+num, false); }
}
