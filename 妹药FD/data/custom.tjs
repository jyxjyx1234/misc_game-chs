		if (ratio) try {
			var text = "%d%%".sprintf(blockRatio);
			EdgeShadowDrawTextKinsokuRect(void, ratio, text, %[
				x:0, y:0, w:ratio.width, h:ratio.height, halign:0, valign:0,
				fontface: SystemDefaultFontFace,
				fontheight: 20, // [XXX]
				color:0xFFFFFF,
				param: [ 255, true,
						 // en  col       emp   ox,oy/ext
						 false, 0,        0,    0,0,
						 true,  0x102581, 1024,  2  ]
				]);
