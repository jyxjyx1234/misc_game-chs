// resetModeChangedをrestoreFlagsのフックに登録
addKagHookCallback("onAfterRestoreFlags", function {
	resetModeChanged();
}, false);

// BGMを更新するタグ（同じ曲ならそのまま）
addKagHandler("updatebgm", function(elm) {
	with (bgm)
		if (.inFading || .playingStorage.toUpperCase() != elm.storage.toUpperCase())
			tagHandlers.playbgm(...);
	return 0;
}, true);

// 高速スキップ用
addKagHandler("fastskip", function(elm) {
	if (skipNoDisp && elm !== void) with (elm) {
		var label = .target, storage = (.storage != "") ? .storage : conductor.curStorage;
		if (label == "") throw new Exception("fastskip: ラベルを指定してください");
		label = label.substring(1) if (label.charAt(0) == "*");
		with (Storages) storage = .chopStorageExt(.extractStorageName(storage));
		var flag = @"trail_${storage}_${label}";
		if (sflags[flag]) return tagHandlers.next(elm);
	}
	return 0;
}, true);

// 画像キャッシュ file=*, file1=*, file2=* ... １からの連続番号で有効
addKagHandler("touch", function(elm) {
	if (elm === void || skipNoDisp) return 0;
	var list = [];
	list.add(elm.file) if (elm.file != "");
	for (var file, i=1; (file = elm["file"+i]) != ""; i++) list.add(file);
	System.touchImages(list, +elm.limit, +elm.timeout) if (list.count > 0);
	return 0;
}, true);

var messageWindowOptions = %[];
// メッセージウィンドウをロードするタグ
addKagHandler("meswinload", function(elmov) {
	var elm = %[];
	with (global) {
		(.Dictionary.assign incontextof elm)(.messageWindowOptions, true);
		(.Dictionary.assign incontextof elm)(elmov, false) if (elmov !== void);
		var sysuiload = tagHandlers.sysuiload;
		if (elm.page != "both") sysuiload(elm);
		else {
			elm.page  = "fore"; sysuiload(elm);
			elm.page  = "back"; sysuiload(elm);
		}
		.resetModeChanged();
	}
	kag.setMenuAccessibleAll();
	return 0;
}, true);
// メッセージウィンドウのデフォルトオプションを設定
addKagHandler("meswinopt", function(elm) {
	with (global) (.Dictionary.assign incontextof .messageWindowOptions)(elm, true);
	return 0;
});

addAfterInitCallback(function() {
	with (kag) {
		// ウィンドウサイズのメニューにチェックを入れる
		if (typeof .winResMenu != "undefined") {
			var menu = .winResMenu;
			updateWindowResMenu(menu);
			menu.enabled = .windowedMenuItem.checked;

			// パススルーメニューを更新する
			setDelayedTrigger("updatePassThroughMenuItem", function() {
				updatePassThroughMenuItem(-1);
			} incontextof global, 800);
			updatePassThroughMenuItem(1);
		}
		if (typeof .disableWindowResizeMenuItem != "undefined") {
			/**/   .disableWindowResizeMenuItem.visible = (typeof .registerExEvent != "undefined");
		}
		if (typeof .cancelAutoByClickMenuItem != "undefined")
			/**/   .cancelAutoByClickMenuItem.checked = .cancelAutoWhenClick;

		if (!global.SystemConfig.disableTroubleShootMenuFlatten) {
			var cnt = .videoOverlayModeMenu.children.count;
			resetSysArgRadioMenuParent("troubleShootMenu", "vomstyle");
			resetSysArgRadioMenuParent("troubleShootMenu", "fullscreenmode", cnt+1);
		}

		// 画面効果メニューにチェックを入れる
		.updateEffectButton();

		// 未読スキップチェック
		setAllSkip();

		// セーブ・ロード機能制限
		.origCanStore   = .canStore;
		.origCanRestore = .canRestore;
		.canStore   = function() { return origCanStore()   && !inSystemMenu(this); } incontextof kag;
		.canRestore = function() { return origCanRestore() && !inSystemMenu(this); } incontextof kag;

		// SystemConfig.disableDisplayMenuInMoviePlaying = true の時
		// ムービー再生時は画面設定を変更できない
		.onMovieStatusChanged = function(state, id) {
			if (global.SystemConfig.disableDisplayMenuInMoviePlaying) {
				if(typeof this.displayMenu != "undefined")
					this.displayMenu.enabled = !this.isMoviePlaying();
			}
		} incontextof kag;

		// video タグの乗っ取り : volume のデフォルト値を bgmvolume にする
		/* Movie.tjs で対応するようにしたので不要になった
		.origVideoTagHandler = .tagHandlers.video;
		.tagHandlers.video = function(elm) {
			if (typeof elm.volume == "undefined" && !elm.noautovolume)
				elm.volume = (bgmenable && waveenable ? (bgmvolume * wavevolume / 100) : 0);
			return origVideoTagHandler(elm);
		} incontextof kag;
		  */

		// 終了後サウンド再生処理
		// サウンドがなりおわるまで終了遅延させる
		.onCloseYes = function() {
			callHook("onCloseYes");
			if (seenable && sevolume > 0) {
				askOnClose = false; // 再度聞いてこないようにする
				process("end.ks");
			} else {
				shutdown();
			}
		} incontextof kag;

		// キーボードフックを登録
		.keyDownHook.add(keyFunc);

		// スクリーン変更後処理を登録
		setDelayedTrigger("resetScreen", resetScreen);
		.addHook("afterChangeScreenMode", function {
			try {
				invokeDelayedTrigger("resetScreen");
//				systemUpdate("fullscreen");
				updatePassThroughMenuItem();
			} catch {}
		} incontextof global);

		// 画面モード変更フック
		.addHook("onDisplayChangedHook", global.onDisplayChangedHook);

		// リサイズフック処理を登録
		.addHook("onWindowResizeHook", global.onWindowResizeHook);

		// ロード時処理
		.addHook("onBeforeRestoreFlags", global.terminator.invoke);

		// システムセーブエラー時
		.addHook("onSaveSystemVariablesFailed", function {
			try { return loadExMenuInterface() ? global.onSaveSystemVariablesFailed(...) : void; } catch {}
		} incontextof global);

		// フォントフェイス変更
		.addHook("onSetMessageLayerUserFont", function { try { systemUpdate("fontSelect"); } catch {} } incontextof global);

		// 終了確認時にunminimize
		.addHook("onCloseQuery", function {
			try {
				if (isvalid this && currentDialog === void &&
					_minimized && typeof this.showRestore == "Object" &&
					!SystemConfig.noRestoreMinizeOnClose)
				{
					showRestore();
				}
			} catch {}
		} incontextof kag);

@if (!PACKED)
		// アイコン設定
		try {
			if (typeof global.ENV_IconFile == "String" && global.ENV_IconFile != "" &&
				Storages.isExistentStorage(System.exePath+global.ENV_IconFile) && typeof .setWindowIcon == "Object") {
				var file =                 System.exePath+global.ENV_IconFile;
				.setWindowIcon(file, true) if (!(typeof   Storages.getMD5HashString == "Object" &&
												 ((string)Storages.getMD5HashString(file)).toLowerCase()
												 /**/== "078918631a0f72bd1143de4978e7c370")); // default icon MD5
			}
		} catch {}
@endif

		// デバッグ時のみ有効
		if (debugWindowEnabled) {
			// 外部制御フック
			.addHook("onMessageReceivedHook", function(mes) {
				if (SystemConfig.stopSkipOnMessageReceived) {
					SystemConfig.stopSkipOnMessageReceived = false;
					kag.cancelSkip();
				}
				debugMessageReceived(mes.split("|"));
			} incontextof global);
			if (System.getArgument("-sendmessage") != "") {
				SystemConfig.stopSkipOnMessageReceived = true;
				SystemHook.add("first.init", function { skipToStop(); } incontextof kag);
			}
			// 自動ログオープン
			.addHook("onErrorLineHook", function(target, msg, filename, line) {
				entryErrorLogWithTimeStamp(msg, filename, line);
				if (!isvalid this || System.getArgument("-autoerrlogopen") == "no" || target === void ||
					logMode || typeof this.chDebugLogMenuItem != "Object") return;
				onChDebugLogMenuItemClick( chDebugLogMenuItem);
			} incontextof kag);
			// 自動ログ移動
			.addHook("onWindowResizeHook", function {
				if (!isvalid this || !logMode || logPad === void) return;
				initLogPad(true, true) if (System.getArgument("-autoerrlogmove") != "no");
			} incontextof kag);
			.addHook("onChDebugLogMenuItemChanged", function (en) {
				if (typeof this.debugAutoErrorLogMoveMenuItem == "Object") 
					/**/        debugAutoErrorLogMoveMenuItem.enabled = en;
			} incontextof kag);
			.callHook("onChDebugLogMenuItemChanged", .logMode);
			//autoLabelStore用
			.addHook("onAutoLabelStoreHook", function (dic) {
				try { dic.text = historyLayer.currentText; } catch {}
			} incontextof kag);
			.addHook("onModeChangeHook", function {
				try { selectAutoLabelStoreMenuItem.enabled = backToAutoLabelStoreMenuItem.enabled; } catch {}
			} incontextof kag);
			.addHook("onMoveSizeEndHook", function(win, old) {
				if (System.getArgument("-consolesyncpos") != "yes") return;
				var rect = getWindowRect();
				if (rect === void || old === void || old.window === void) return;
				var ox, oy;
				with (old.window) ox = rect.x-.x, oy = rect.y-.y;
				if (ox != 0 || oy != 0 ) with (Debug.console) {
					var rect = (typeof .getRect == "Object") ? .getRect() : void;
					if (rect !== void) .setPos(rect.x+ox, rect.y+oy);
				}
			} incontextof kag);
			// envStateChecker
			.addHook("onDebugWinVisibleChanged", function (vis) {
				global.SetDebugEnvStateCheckerVisible(vis) if (hasDebugUtil);
			} incontextof global);
			if (._debugwin !== void && ._debugwin.visible && hasDebugUtil) {
				global.SetDebugEnvStateCheckerVisible(true);
			}
			// 保存ラベル有無チェック
			.stableHandlers.add(function {
				if (!usingExtraConductor && inGameState(this)) {
					if (typeof global.world_object == "Object" &&
						/**/   global.world_object.env.transMode) errorCmd("begintrans/endtrans間でクリック待ちになりました");
					if (prevSkipMode !== void)                    errorCmd("beginskip/endskip間でクリック待ちになりました");
					var esn  = Storages.extractStorageName;
					var last = storeLabelPassedLastStorage;
					var cur  = conductor.curStorage;
					if ((last == "") || (esn(last).toLowerCase() != esn(cur).toLowerCase())) {
						if (typeof global.checkScenarioLabelOnStable != "Object" ||
							/**/  !global.checkScenarioLabelOnStable(cur, last)) {
							errorCmd("保存可能なラベル指定がないシナリオで停止状態になりました");
							storeLabelPassedLastStorage = cur; // 二度目は出さない [XXX]
						}
					}
				}
			} incontextof kag);
		}
	}
} incontextof global);

// aboutダイアログ用
var aboutDialogConfig = %[
title:		"バージョン情報",		// ウィンドウタイトル
