Plugins.link("csvParser.dll");

// ssShift ssCtrl ssAlt 合成済み値
global.ssShiftCtrlAlt       = ssShift | ssCtrl | ssAlt;
global.ssShiftCtrlAltRepeat = global.ssShiftCtrlAlt | ssRepeat; // 上記にリピートを追加


// ---------------------------------------------------------
// KAGの状態に対する対応
// ---------------------------------------------------------

// 状態が変わったかどうかをチェックする
var modeChangeCheckHash = %[];
function isModeChanged(name, value) {
	var old = modeChangeCheckHash[name];
	modeChangeCheckHash[name] = value;
	return old !== value;
}
function resetModeChanged() {
	modeChangeCheckHash = %[];
	kag.callHook("onResetModeChanged");
}

// システムメニューのスクリプトを登録できるようにする
var inSystemMenuStorages = %[];
function setSystemMenuStorage(storage, inMenu = true) {
	//	dm(":::setSystemMenuStorage", storage);
	var name = storage.toLowerCase();
	inSystemMenuStorages[name] = inMenu if (name != "");
}
// first.ks ではロード不可
setSystemMenuStorage("first.ks");

// システムメニュー中かどうか
function inSystemMenu(kag) {
	with (kag) {
		var ex  = (.conductor == .extraConductor);
		var cur = ex ? .extraConductor.curStorage : .currentStorage;
		cur = (typeof cur === "String") ? cur.toLowerCase() : "";
		cur = (cur != "") ? inSystemMenuStorages[cur] : void;
		return (cur !== void) ? cur : ex;
	}
}
// タイトル画面かどうか
function inTitleMenu(kag) {
	return kag.conductor.curStorage == "title.ks";
}

// コンフィグ画面を開けるか
function canConfig(kag, modal) {
	return !inSystemMenu(kag) && !modal && kag.inStable;
}

// メッセージウィンドウ上のボタン（表裏とも）のプロパティを変更
class ForeBackPropChanger {
	var _fore, _back;
	function ForeBackPropChanger() {}
	function finalize() {}
	function reset(kag, num) {
		_fore = _back = void;
		try {
			switch (typeof num) {
			case "Integer":
				_fore = kag.fore.messages[num].buttons;
				_back = kag.back.messages[num].buttons;
				break;
			case "Object":
				_fore = num;
				break;
			}
		} catch {}
	}
	function set(name, prop, value) {
		_fore[name][prop] = value if (_fore !== void && typeof _fore[name] !== "undefined");
		_back[name][prop] = value if (_back !== void && typeof _back[name] !== "undefined");
	}
	function setEnabled(name, value) { set(name, "enabled", value); }
	function setToggle( name, value) { set(name, "toggle",  value); }
	function checkEnableChanged(name, tag, value) {
		var ret = isModeChanged(tag, value);
		setEnabled(name, value) if ret;
		return ret;
	}
	function checkToggleChanged(name, tag, value) {
		var ret = isModeChanged(tag, value);
		setToggle(name, value) if ret;
		return ret;
	}
	function get(name, prop) {
		if (_fore !== void && typeof _fore[name] !== "undefined" && typeof _fore[name][prop] !== "undefined") return _fore[name][prop];
		if (_back !== void && typeof _back[name] !== "undefined" && typeof _back[name][prop] !== "undefined") return _back[name][prop];
		return void;
	}
}

/**
 * モード変更
 * ポイント1: 原則としてメニューの対応する項目の設定をひっぱってきている
 * ポイント2: AUTO ボタンについては ON/OFF 制御を画像に反映させている
 * ポイント3: Config メニューは KAG の基本にないのでメニューについてもここで制御
 *     
 */
var onModeChangeMessageLayerNum = 0;
var onModeChangePropChanger = void;
function onModeChange(kag, *) //autoMode, skipMode, canAuto, canSkip, selectShowing, modal, canRun)
{
	//dm("onModeChanged:", autoMode, skipMode, canAuto, canSkip, selectShowing, modal);
	var prop = onModeChangePropChanger;
	/**/prop = onModeChangePropChanger = new ForeBackPropChanger() if (prop === void);
	prop.reset(kag, /*MessageLayer Num:*/ onModeChangeMessageLayerNum);

	if (!kag.callHook("onModeChangeHookEx", prop, kag, *))
		DefaultModeChangeProc(prop, kag, *);
	return prop;
}
function DefaultModeChangeProc(prop, kag, autoMode, skipMode, canAuto, canSkip, selectShowing, modal, canRun)
{
	var enabled;
	var inTitle = inTitleMenu(kag);
	var inGame  = inGameState(kag);
	var stable  = kag.inStable;

	with (prop) {
		// セーブボタンの有効状態
		if (.checkEnableChanged("save", "canSave", (enabled = kag.storeMenu.enabled)))
			.setEnabled("qsave", (kag.quickStoreMenu.enabled = enabled));

		// ロードボタンの有効状態
		.checkEnableChanged("load",  "canLoad",  (enabled = kag.restoreMenu.enabled &= (inTitle || !inSystemMenu(kag))));
		.checkEnableChanged("qload", "canQLoad", (kag.quickRestoreMenu.enabled = enabled && SystemAction.canQuickLoad));

		// バックログボタンの有効状態
		.checkEnableChanged("log",  "canLog",  kag.showHistoryMenuItem.enabled);

		// オートボタンの有効状態
		enabled = canAuto;
		if (.get("auto", "noStable")) enabled = canRun && !kag.skipMode; // nostable設定の場合はinStableを無視する
		.checkEnableChanged("auto", "canAuto", enabled);

		// スキップ・次の選択肢・前の選択肢の有効状態
		.checkEnableChanged("prev", "canPrev", (kag.goBackMenuItem.enabled &= inGame));
		.checkEnableChanged("next", "canNext", (kag.goNextMenuItem.enabled = canSkip && !skipMode));
		if (.get("skip", "noStable")) with(kag) enabled = canRun && .nextSkipEnabled && (.allskip || .getCurrentRead()); // nostable設定の場合はinStableを無視する
		else enabled = canSkip;
		.checkEnableChanged("skip", "canSkip",  enabled); //kag.skipToNextStopMenuItem.enabled));

		// オートとスキップのトグル変更
		/**/.checkToggleChanged("auto", "autoMode", autoMode);
		if (.checkToggleChanged("skip", "skipMode", skipMode)) {
			kag.skipToNextStopMenuItem.checked = skipMode; // KAGの方ではチェックしてくれないようなので
		}

		// コンフィグボタンの有効状態
		if (typeof kag.configMenuItem != "undefined" &&
			.checkEnableChanged("option", "canConf", (enabled = canConfig(kag, modal))))
			kag.configMenuItem.enabled = enabled;

		// メッセージウィンドウを隠すボタンの有効状態
		.checkEnableChanged("hide", "canHide", (!inSystemMenu(kag) && !modal && stable));

		// ボイスリプレイ機能有効状態
		enabled = (kag.hasCurrentVoice) && stable && !autoMode && inGame;
		if (.checkEnableChanged("vreplay", "voiceReplay", enabled)) {
			kag.voiceReplayMenuItem.enabled = enabled if (typeof kag.voiceReplayMenuItem == "Object");
		}
	}
	with (kag) {
		// タイトル中はタイトルへ戻るメニューは無効
		.goToStartMenuItem.enabled &= !inTitle if (typeof .goToStartMenuItem == "Object");
		// フォント変更メニュー
		.chChangeFontMenuItem.enabled = .inStable if (typeof .goToStartMenuItem == "Object");
	}
}

// ---------------------------------------------------------
// メニュー関連処理
