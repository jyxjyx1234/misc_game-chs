				]),
			getSysArgCheckMenuItem("smoothZoomMenuItem", "拡大時スムージング(&T)", "smoothzoom", true, "yes"),
			"-",
			%[  name:"effectMenu", caption:"画面効果(&E)", noadd:true, children:[ // 未使用（チェックメニューに変更）
