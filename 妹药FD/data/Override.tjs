// ヘルプテキスト表示

var BrowsFiles = %[ index: [ "brows_conf.ks", "brows_help.ks", "helpover.ks"  ] ];
function openBrowsWindow(tag, name="index", w=620, h=440, parent=global.kag) {
	if (typeof global.BrowsWindow == "undefined") {
		KAGLoadScript("browswindow.tjs");
	}
	var win = new BrowsWindow(name, w, h, parent);
	win.open(tag, BrowsFiles[ name]);
	invalidate win;
}
KAGWindow.onHelpIndexMenuItemClick = function { openBrowsWindow(); } incontextof global;

// ---------------------------------------------------------
// 基本機能メソッド
// ---------------------------------------------------------

class loadTrigger extends AsyncTrigger {
	var loadNumber, layer;
	function loadTrigger() {
		super.AsyncTrigger(this.load, "");
		mode = atmAtIdle;
		cached = true;
		cancel();
	}
	function finalize() {
		deleteLayer();
		super.finalize(...);
	}
	function load() {
		var reset = false;
		switch (typeof loadNumber) {
		case "void":    break;
		case "Object":
			try { recollection(loadNumber); }
			catch (e) {
				System.inform(e.message);
				reset = true;
			}
			break;
		case "Integer":
			prepare();
			reset = !kag.loadBookMark(loadNumber);
			if (!reset) fadein();
			else deleteLayer();
			break;
		case "String":
			prepare();
			var sel = customLoadHook(loadNumber, fadein);
			if (sel) fadein();
			else if (sel === void) {
				reset = true;
				deleteLayer();
			}
			break;
		default:   reset = true; break;
		}
		if (typeof global.SystemHook != "undefined")
			/**/   global.SystemHook.exec("loadinit.done", loadNumber); // 直実行なので .ks のフックは実行できないことに注意
		loadNumber = void;
		kag.goToStart() if (reset);
	}
	function recollection(dic) {
		var fade = SystemConfig.recollectionFadeInStart;
		prepare() if fade;
		kag.startRecollection(dic);
		kag.insertTag("syshook", %[ name: "scenemode.view.start" ]) if (typeof global.SystemHook != "undefined"); // フック
		global.startRecollectionHook() if (typeof global.startRecollectionHook == "Object");
		if (dic.skipto != "") {
			kag.skipToLabel(true, dic.skipto);
			if (fade) {
				var hook = this.onSkipToLabelStop;
				kag.removeHook("onSkipToLabelStop", hook);
				kag.addHook   ("onSkipToLabelStop", hook);
			}
		} else {
			fadein() if fade;
		}
	}
	function onSkipToLabelStop {
		kag.removeHook("onSkipToLabelStop", this.onSkipToLabelStop);
		fadein();
	}
	function prepare() {
		deleteLayer();
		layer = new Layer(kag, kag.primaryLayer);
		with (layer) {
			.name = "load trigger";
			.visible = false;
			.setImageSize(kag.exWidth, kag.exHeight);
			.setSizeToImageSize();
//			.fillRect(0, 0, .width, .height, 0xFF000000);
			.piledCopy(0, 0, kag.fore.base, 0, 0, .width, .height);
			.absolute = 10000000;
			.hitType = htProvince;
		}
	}
	function fadein() {
		layer.opacity = 255;
		layer.visible = true;
		kag.beginAction(layer, %[ opacity: %[ handler: MoveAction, start:255, value:0, time:300 ] ], onActionCompleted, true);
		kag.insertFastTag("wact", %[target:layer]);
	}
	function onActionCompleted() {
//		kag.onActionCompleted(...);
		deleteLayer();
	}
	function deleteLayer() {
		invalidate layer if (layer !== void && isvalid layer);
		layer = void;
	}
	function goBackHistory() {
		kag.goBackHistory(false);
		return true;
	}
	var loadHooks = %[ prev:%[ callback:goBackHistory, noclearhist:true ] ];
	function getLoadHookInfo(tag) {
		return (typeof tag == "String" && tag != "" && loadHooks[tag] !== void) ? loadHooks[tag] : %[];
	}
	function isNoclearHistory(tag) {
		return getLoadHookInfo(tag).noclearhist;
	}
	function customLoadHook(tag) {
		var cb= getLoadHookInfo(tag).callback;
		return (cb !== void) ? cb() : void;
	}
}
loadTrigger.instance = new loadTrigger();
function doLoad() { global.loadTrigger.instance.trigger(); }

function loadFunction(work)
{
	var inst = loadTrigger.instance;
	// 進行を止めないために必要
	kag.closeDialog();
	kag.process('loadinit.ks', inst.isNoclearHistory(work) ? '*noclearhistory' : '', true, true);
	inst.loadNumber = work;
}

function saveFunction(work)
{
	return kag.saveBookMark(work);
}

function qloadFunction()
{
	loadFunction(...);
	global.qsaveNotify.show("q_loaded") if (typeof global.qsaveNotify !== 'undefined');
	return true;
}

function qsaveFunction()
{
	var ret = saveFunction(...);
	global.qsaveNotify.show("q_saved")  if (ret && typeof global.qsaveNotify !== 'undefined');
	kag.freeSnapshot();
	return ret;
}


// ---------------------------------------------------------
// キーバインド
// ---------------------------------------------------------

//        VK_? : 素の      VK_?
// "S_" + VK_? : Shift   + VK_?
// "C_" + VK_? : Control + VK_?
// "A_" + VK_? : Alt     + VK_?
// 複数同時指定の場合は SCA_ の順
// "*"  + VK_? : モディファイア無関係で VK_?
var kagCustomizedKeys = %[
	// ファンクションキー機能一覧
	VK_F1 => "about",							// F1: ヘルプ(About)
	VK_F2 => "save",							// F2: セーブ
	VK_F3 => "load",							// F3: ロード
	VK_F4 => "screen",							// F4: 画面切り替え(kag.toggleScreenMenuItem.shortcut に Alt+Enter が指定してあるので上書き時は注意）
	VK_F5 => "backlog", VK_PRIOR => "backlog",	// F5, PageUp: バックログ
	VK_F6 => "auto",							// F6: オート
	VK_F7 => "skip",							// F7: スキップ
	VK_F8 => "option",							// F8: オプション画面
	VK_F11=> "qsave",							// F11: クイックセーブ
	VK_F12=> "qload",							// F12: クイックロード

	// 吉里吉里機能キー抑制一覧
	"*" + #'F' => "none", // 次の選択肢/未読まで進む
	"*" + #'B' => "none", // 前に戻る
	"*" + #'A' => "none", // オート
	"*" + #'S' => "none", // セーブ
	"*" + #'L' => "none", // ロード
	"*" + #'R' => "none", // バックログ
	"S_" + VK_UP => "none", // バックログ

	"A_" + VK_LEFT  => "none", // 前のラベルへ戻る
	"A_" + VK_RIGHT => "none", // 次のラベルへ進む

	"S_" + VK_BACK => "none", // 直前に戻る
	];

// ファンクションキーに関するバインド（メニューショートカット表示用）
var updateCaptionFunctionKeys = %[];
function resetCaptionFunctionKeys(kag) {
	var ucfk = global.updateCaptionFunctionKeys;
	var kck  = global.kagCustomizedKeys;

	(Dictionary.clear incontextof ucfk)();
	for (var i = 0; i < 12; i++) {
		var key = kck[VK_F1+i];
		ucfk[key] = "F"+(i+1) if (key != "" && key != "none");
	}
	KAGWindow_updateMenus(kag, ucfk);
}

// キー入力の横取り
function keyFunc(key, shift)
{
	var tag, mod = "";
	mod += "S" if (shift & ssShift);
	mod += "C" if (shift & ssCtrl);
	mod += "A" if (shift & ssAlt);
	mod += "_" if (mod != "");

	try {
		tag = kagCustomizedKeys[mod + key];
		tag = kagCustomizedKeys["*" + key] if (tag == "");
	} catch {}
	if (tag != "") {
		if (tag == "none") return true;
		// タグの先頭が @ の場合はリピート有効
		if (tag.charAt(0) == "@") tag = tag.substr(1);
		else if (shift & ssRepeat) return true;

		if (typeof SystemAction[tag] != "undefined")
			return SystemAction[tag](true, tag, key, shift);

		var exp = kagCustomizedKeys["!" + tag];
		switch (typeof exp) {
		case "Object": return exp(key, shift);
		case "String": Scripts.eval(exp); return true;
		}
	}

	return false;
}

// ---------------------------------------------------------
// ボタンに文字を書く
// ---------------------------------------------------------
function drawButtonCaptionWithAlign(button, ox, oy, pos, caption, *)
{
	pos = 5 if (!pos); // default = center

	// 文字のサイズを得る
	var cw = button.font.getTextWidth( caption);
	var ch = button.font.getTextHeight(caption);
	var w = button.width, h = button.height;

	if (     pos === 2 || pos === 5 || pos === 8) ox += (w - cw) >> 1; // h-center
	else if (pos === 3 || pos === 6 || pos === 9) ox += (w - cw);      // right
	if (     pos === 4 || pos === 5 || pos === 6) oy += (h - ch) >> 1; // v-center
	else if (pos === 1 || pos === 2 || pos === 3) oy += (h - ch);      // bottom

	var dt = button.drawText, max = button.imageWidth;
	for (var n = 0; n < max; n+=w) dt(ox+n, oy, caption, *);
}
function drawButtonCaption(button, ox, oy, caption, *)
{
	return drawButtonCaptionWithAlign(button, ox, oy,, caption, *);
}

// ---------------------------------------------------------
// Array要素をランダムに選択
// ---------------------------------------------------------
function getRandomSE(elm) {
	var array = [], orig = elm.array;
	orig = Scripts.eval(orig) if (typeof orig == "String");
	array.assign(orig);
	// 存在しないファイルは除外する
	for (var i = 0; i < array.count; i++) {
		array[i] = void if (!(Storages.isExistentStorage(array[i]+".ogg") ||
							  Storages.isExistentStorage(array[i]+".wav")));
	}
	array.remove(void, true);
	if (array.count === 0) return;
	var buf = (elm.buf !== void) ? +elm.buf : kag.numSEBuffers;
	var rnd = array[(int)(defaultRandomGenerator.random() * array.count)];
	return %[ buf: buf, storage: rnd ];
}
function playRandomSE(elm) {
//	dm("playRandomSE", rnd, array.count);
	var e = getRandomSE(elm);
	kag.se[+e.buf].play(e) if (e !== void);
}

// Math.RandomGenerator インスタンス
var defaultRandomGeneratorInstance = void;
property defaultRandomGenerator { getter {
	if (defaultRandomGeneratorInstance === void)
		defaultRandomGeneratorInstance = new Math.RandomGenerator();
	return defaultRandomGeneratorInstance;
}}

// ---------------------------------------------------------
// 再帰的にDictionaryを表示
// ---------------------------------------------------------

function StructToString(dic, level = 0, add = 2) {
	var ret = "";
	if (typeof dic !== "Object" || !(dic instanceof "Dictionary")) return ret;
	var items = [];
	items.assign(dic);
	for (var i = 0; i < items.count; i+=2) {
		var key = items[i], val = items[i+1];
		ret += " ".repeat(level) + key + ": ";
		if (typeof val === "Object") {
			if (val instanceof "Array") {
				ret += "[ " + val.join(", ") + " ]\n";
				continue;
			} else if (val instanceof "Dictionary") {
				ret += "%[\n" + StructToString(val, level + add, add);
				ret += " ".repeat(level) + "]\n";
				continue;
			}
		}
		val = "void" if (val === void);
		ret += val + "\n";
	}
	return ret;
}


// ---------------------------------------------------------
// AfterInit で呼び出されるコールバックを登録
// ---------------------------------------------------------

var afterInitCallback = [], kagHookEntries = [];
// 単純なコールバックを登録
function addAfterInitCallback(func, kagcontext) {
	afterInitCallback.add(%[mode:"callback", callback:func, kagcontext:kagcontext]);
}
// KAGのハンドラを登録する
function addKagHandler(handle, func, kagcontext) {
	afterInitCallback.add(%[mode:"handler", handle:handle, func:func, kagcontext:kagcontext]);
}
// kag.addHookを登録する
function addKagHookCallback(handle, func, kagcontext) {
	kagHookEntries.add(%[ handle:handle, func:func, kagcontext:kagcontext]);
}
// コールバック関数のコンテキストを決定
function getInitCallbackFunction(cb, sel, ctx) {
	if (!cb || typeof cb != "Object") return function {};
	var func;
	switch (typeof sel) {
	case "void":   func = cb; break;
	case "Object": func = cb incontextof sel; break;
	default:       func = +sel ? (cb incontextof ctx) : (cb incontextof global); break;
	}
	return func;
}
// kagのフックを登録する
function KAGWindow_config_override() {
	for (var i = 0, cnt = kagHookEntries.count; i < cnt; i++)
		with (kagHookEntries[i]) addHook(.handle, getInitCallbackFunction(.func, .kagcontext, this));
	callHook("onKAGSetupConfig", this);
	delete global.kagHookEntries;
}

// コールバック呼び出し
function callAfterInit() {
	for (var i = 0, cnt = afterInitCallback.count; i < cnt; i++) {
		with (afterInitCallback[i]) {
			switch (.mode) {
			case "callback": (getInitCallbackFunction(.callback, .kagcontext, kag))(); break;
			case "handler":
				var func = getInitCallbackFunction(.func, .kagcontext, kag);
				kag.tagHandlers[.handle] = func;
				if (typeof global.SceneParserAddCommand == "Object") {
					SceneParserAddCommand[.handle] = true;
				}
				break;
			}
		}
	}
	delete global.afterInitCallback;
}

