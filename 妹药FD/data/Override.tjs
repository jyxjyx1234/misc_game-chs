			%[  name:"goBackMenuItem",    caption:"前の選択肢に戻る(&B)", exp:"SystemAction._prev()",    se:"menu.prev"  ],
			"-",
			%[  name:"configMenuItem",         caption:"オプション(&O)",  exp:"SystemAction._option()",  se:"menu.option" ],
			%[  name:"voiceReplayMenuItem", caption:"音声リプレイ(&R)",   exp:"SystemAction._vreplay()", se:"menu.vreplay",visible:false ],
			] ],

		// -------- 文字表示
		%[  name:"characterMenu", caption:"文字表示(&C)", children:[
			%[  name:"chSpeedMenu", caption:"表示速度(&C)", children:[
				%[  name:"chSlowMenuItem",   caption:"遅い(&S)", group:1, exp:setTextSpeed, prop:%[ speed:chSpeeds.slow   ] ],
				%[  name:"chNormalMenuItem", caption:"普通(&N)", group:1, exp:setTextSpeed, prop:%[ speed:chSpeeds.normal ] ],
				%[  name:"chFastMenuItem",   caption:"速い(&F)", group:1, exp:setTextSpeed, prop:%[ speed:chSpeeds.fast   ] ],
				//"-",
				/* 未使用 */%[  noadd:true, name:"chNonStopToPageBreakItem", caption:"ページ末まで一気に(&P)", exp:onChNonStopToPageBreakItemClick ],
				] ],
			%[  name:"autoModeWaitMenu", caption:"オート待ち時間(&D)", children:[
				%[  name:"autoModeFastMenuItem",   caption:"短い(&1)",     group:1, exp:setAutoSpeed, prop:%[ wait:autoModePageWaits.fast,   lwait:autoModeLineWaits.fast   ] ],
				%[  name:"autoModeFasterMenuItem", caption:"やや短い(&2)", group:1, exp:setAutoSpeed, prop:%[ wait:autoModePageWaits.faster, lwait:autoModeLineWaits.faster ] ],
				%[  name:"autoModeMediumMenuItem", caption:"普通(&3)",     group:1, exp:setAutoSpeed, prop:%[ wait:autoModePageWaits.medium, lwait:autoModeLineWaits.medium ] ],
				%[  name:"autoModeSlowerMenuItem", caption:"やや長い(&4)", group:1, exp:setAutoSpeed, prop:%[ wait:autoModePageWaits.slower, lwait:autoModeLineWaits.slower ] ],
				%[  name:"autoModeSlowMenuItem",   caption:"長い(&5)",     group:1, exp:setAutoSpeed, prop:%[ wait:autoModePageWaits.slow,   lwait:autoModeLineWaits.slow   ] ],
				] ],
			"-",
			%[  name:"cancelAutoByClickMenuItem", caption:"左クリックでオートを停止(&K)", exp:setCancelAutoByClick, prop:%[ checkitem:true ] ],
			// 未使用
			%[  noadd:true, name:"allskipMenu", caption:"未読台詞スキップ(&I)", children:[
				%[  name:"allskipMenuItem",   caption:"ON(&S)",  group:1, exp:setAllSkip, prop:%[ skip:true  ] ],
				%[  name:"noallskipMenuItem", caption:"OFF(&N)", group:1, exp:setAllSkip, prop:%[ skip:false ] ],
				] ],
			// 上記のチェックアイテム版
			%[  name:"allskipCheckMenuItem", caption:"未読台詞スキップ(&I)", exp:setAllSkip, prop:%[ checked:allskip, checkitem:true ] ],
			// 未使用
			%[  noadd:true, name:"ch2ndSpeedMenu", caption:"一度読んだところは(&I)", children:[
				%[  name:"ch2ndNoWaitMenuItem",   caption:"ノーウェイト(&W)", group:1, exp:onCh2ndSpeedMenuItemClick, prop:%[ speed:0               ] ],
				%[  name:"ch2ndFastMenuItem",     caption:"高速(&F)",         group:1, exp:onCh2ndSpeedMenuItemClick, prop:%[ speed:chSpeeds.fast   ] ],
				%[  name:"ch2ndNormalMenuItem",   caption:"普通(&N)",         group:1, exp:onCh2ndSpeedMenuItemClick, prop:%[ speed:chSpeeds.normal ] ],
				%[  name:"ch2ndNoChangeMenuItem", caption:"変えない(&M)",     group:1, exp:onCh2ndSpeedMenuItemClick, prop:%[ speed:-1 /*変えない*/ ] ],
				"-",
				%[  name:"ch2ndNonStopToPageBreakItem", caption:"ページ末まで一気に(&P)", exp:onCh2ndNonStopToPageBreakItemClick ],
				] ],
			"-",
			%[  name:"chAntialiasMenuItem",  caption:"アンチエイリアス(&A)", exp:onChAntialiasMenuItemClick ],
			%[  name:"chChangeFontMenuItem", caption:"フォント(&F) ...",     exp:onChChangeFontMenuItem ],
			] ],

		// -------- ヘルプ
		%[  name:"helpMenu", caption:"ヘルプ(&H)", children:[
			%[  name:"helpIndexMenuItem", caption:"目次(&I) ...", exp:onHelpIndexMenuItemClick, noadd:!Storages.isExistentStorage("brows_help.ks") ],
			%[  name:"helpReadmeMenuItem", exp:"System.shellExecute('\"'+Storages.getLocalName(System.exePath+global.ENV_ReadmeFile)+'\"')", noadd:true,
				/**/caption:         (typeof global.ENV_ReadmeName != "undefined") ? global.ENV_ReadmeName+"(&R)..." : "&README...",
				/**/prop:%[ enabled: (typeof global.ENV_ReadmeFile != "undefined" && Storages.isExistentStorage(System.exePath+global.ENV_ReadmeFile)) ] ],
			%[  name:"helpWebMenuItem",   caption:"&WEBサイトを開く", exp:"System.shellExecute(global.ENV_GameURL);",
