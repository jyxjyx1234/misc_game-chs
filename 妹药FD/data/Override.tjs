// -----------------------------
// Array/Dictionary の記述によるメニュー構築
function createMenuFromList(win, menu, list) {
	if (typeof list !== "Object" || !(list instanceof "Array")) return;
	for (var i = 0; i < list.count; i++) {
		var item = list[i];
		switch (typeof item) {
		case "void": break;
		case "String": menu.add(new MenuItem(win, item)); break; // 区切り等
		case "Object":
			if (item instanceof "Dictionary") with (item) {
				var exp = .exp;
				if (.se != "") {
					var se = getSysSE(.se);
					if (se.storage != "") exp = %[ exp:exp, clickse:se.storage, clicksebuf:se.buf];
				}
				var sub = new KAGMenuItem(win, .caption, +.group, exp, .autoenable);
				win[.name] = sub if (.name != ""); // nameがあればウィンドウのアイテムとして登録
				menu.add(sub) if (!.noadd); // noadd指定がない場合は子メニューとして追加
				createMenuFromList(win, sub, .children) if (.children !== void); // 子メニュー登録
				if (.prop !== void) // プロパティ登録
					foreach(.prop, function(tag, value, dic, sub) { if (tag !== void) sub[tag] = value; }, sub);
			}
			break;
		}
	}
}
// チェックメニューの更新
function updateCheckMenuItem(item, value, prop = "value", group) {
	if (item !== void) with (item) {
		if (group !== void && !(.group == group && .radio)) return;
		if (typeof ._default  != "undefined" && value == "") value = ._default;
		if (typeof item[prop] != "undefined") .checked = (item[prop] == value);
	}
}
// ラジオメニューの更新
function updateRadioMenuItem(menu, value, prop = "value", group) {
	if (typeof menu == "String")
		with (global) menu = (.kag !== void && isvalid .kag) ? .kag[menu] : void;

	if (menu === void) return;
	var list = [];
	list.assign(menu.children);
	if (list.count == 0) {
		// 子が無い場合はチェックメニューとして処理
		updateCheckMenuItem(menu, value, prop);
	} else {
//		with (menu) if (value == "" && typeof ._default != "undefined") value = ._default;
		for (var i = 0; i < list.count; i++)
			updateCheckMenuItem(list[i], value, prop, (group === void) ? 1 : +group);
	}
}
// ラジオメニューの有効化・無効化
function setEnableMenuGroup(menu, group, en) {
	if (typeof menu == "String")
		with (global) menu = (.kag !== void && isvalid .kag) ? .kag[menu] : void;

	if (menu === void) return;
	var list = [];
	list.assign(menu.children);
	for (var i = 0; i < list.count; i++)
		list[i].enabled = en if (list[i].group == group);
}

// メニューアイテムをクリックする
function clickMenuItem(name, another, *) {
	if (typeof kag[name] !== "undefined") {
		with (kag[name]) { .click() if (.enabled && .accessible); }
	} else if (another !== void) {
		another(*);
	}
}

// -----------------------------
// userConf の設定ファイルを変更
function changeUserConf(name, value)
{
	var cfu, path;

	// cfu のパスを求める
	with (global.kag) {
		if (.readOnlyMode) return;
		path = .saveDataLocation;
	}
	path += "/" if (path.charAt(path.length-1) != "/");
	with (Storages) path += .chopStorageExt(.extractStorageName(System.exeName));
	path += ".cfu";

	// saveStructプラグインをリンクする
	var ins = [], ss = "savestruct.dll";
	ins.assign(Plugins.getList());
	if (ins.find(ss) < 0) try { Plugins.link(ss); }
	catch { System.inform("設定を保存できませんでした: プラグイン読み込み失敗"); }

	// cfu を読み込む
	if (Storages.isExistentStorage(path)) {
		cfu = [];
		try { cfu.load(path); } catch { cfu = void; }
	}
	// ない場合はデフォルトテキストを設定
	if (cfu === void) cfu = [
		'; ============================================================================',
		'; *DO NOT EDIT* this file unless you are understanding what you are doing.',
		'; FYI:',
		';  Each line consists of NAME="VALUE" pair, VALUE is a series of',
		';  \\xNN, where NN is hexadecimal representation of UNICODE codepoint.',
		';  For example, opt="\\x61\\x62\\x63\\x3042\\x3044\\x3046" means that the',
		';  value of options "opt" is alphabets a, b, and c followed by Japanese',
		';  Hiraganas A, I, and U.',
		';  DO NOT PUT non-escaped value like opt="abc". This doesn\'t work and should',
		';  be like opt="\\x61\\x62\\x63".',
		'; ============================================================================' ];

	// 設定する値を生成
	var update = name + '="';
	for (var i = 0; i < value.length; i++)
		update += "\\x%X".sprintf(# value.charAt(i));
	update += '"';

	// 全行パースして置換
	var find = false;
	for (var i = 0; i < cfu.count; i++) {
		var line = cfu[i];
		if (line.indexOf(name+'="') == 0) {
			// 重複がある場合は最初のみ有効
			cfu[i] = find ? ";" : update;
			find = true;
		}
	}
	// 見つからなかった場合は最後に追加
	if (!find) cfu.add(update);

	// セーブする
	try { cfu.save2(path); }
	catch { System.inform(@"設定を保存できませんでした: 書き込み失敗\n${Storages.getLocalName(path)}"); }
}

// -----------------------------
// 直引数とメニューアイテムクリックの場合の両対応の値取得
function getSysArgValue(arg, type) {
	var ret;
	switch (typeof arg) {
	case "Integer":
		switch (type) {
		case "Integer": ret = arg; break;
		case "Boolean": ret = arg ? "yes" : "no"; break;
		case "String":  ret = (string)arg; break;
		}
		break;
	case "String":
		switch (type) {
		case "Integer": ret = (int)arg; break;
		default:        ret = (string)arg; break;
		}
		break;
	case "Object":
		if (typeof arg.value != "undefined") {
			ret = arg.value;
			switch (type) {
			case "Integer": ret = (int)ret; break;
			case "String":  ret = (string)ret; break;
			}
		}
		break;
	}
	return ret;
}

// -----------------------------
// -----------------------------

// 吉里吉里のバージョンをチェック
function checkSystemVersion(comp) {
	var a = System.versionString.split(".");
	var b = comp.split(".");
	var get = function (s) {
		if (s != "") for (var i = 0; i < s.length; i++)
			if (s.charAt(i) != "0") return +(s.substr(i));
		return 0;
	};
	for (var n = 0; n < 4; n++) {
		var now = get(a[n]), chk = get(b[n]);
		if (now != chk) return (now > chk);
	}
	return true;
}
// 現在のWindowsのバージョン
property currentWindowsVersion { getter {
	var m = (new RegExp("^Windows [^\\s]+ (\\d+\\.\\d+)", "i")).match(System.osName);
	var ver = (m.count > 0) ? +m[1] : 0;
	&global.currentWindowsVersion = ver;
	dm("currentWindowsVersion", ver);
	return ver;
} }

// Windowsのバージョンをチェック
function checkWindowsVersion(chk) {
	// バージョン番号のマップ
	if (typeof global.checkWindowsVersionMap == "undefined") {
		/**/   global.checkWindowsVersionMap = %[  
			"95"    => 4,	"98" => 4.1,	"me"   => 4.9,
			"2000"  => 5,	"xp" => 5.1,	"2003" => 5.2,
			"vista" => 6 ];
	}
	chk = global.checkWindowsVersionMap[chk.toLowerCase()] if (typeof chk == "String" && chk != "");
	return (chk != "") ? ((global.currentWindowsVersion) >= +chk) : false;
}


// 一旦画面モードを変更して戻す（設定反映用）
function resetScreenMode(isfull, forcetrig = false) {
	if (!isvalid global.kag) return;
	with (global.kag) {
		if (!forcetrig) {
			with (.drawDevice) {
				var dt = .dtNone;
				switch (System.getArgument("-dbstyle")) {
				case "d3d":   dt = .dtDBD3D; break;
				case "ddraw": dt = .dtDBDD;  break;
				case "gdi":   dt = System.getArgument("-usedb") == "yes" ? .dtDBGDI : .dtDrawDib; break;
				}
				.preferredDrawer = dt;
				.recreate();
			}
			systemUpdate("fullscreen");
			updatePassThroughMenuItem();
		} else {
			var trig, name = "resetScreenModeTrigger";
			if (( isfull  && !.fullScreened) ||
				(!isfull  &&  .fullScreened)) return;
			// トリガ取得
			if (typeof kag[name] != "undefined") trig = kag[name];
			else { // トリガがない場合は生成
				kag[name] = trig = new AsyncTrigger(kag, 'onResetScreenModeTrigger');
				trig.cached = true;
				trig.mode = atmAtIdle;
				kag.onResetScreenModeTrigger = function() {
					global.System.setArgument("-fsres", fsres) if (hasset);
					global.kag[isfull ? "onFullScreenMenuItemClick" : "onWindowedMenuItemClick"]();
				} incontextof trig;
			}
			// トリガ設定
			with (trig) {
				.isfull = isfull;
				.hasset = (typeof System.setArgument != "undefined");
				if (.hasset) {
					.fsres = System.getArgument("-fsres");
					System.setArgument("-fsres", "nochange");
				}
			}
			// 画面を一旦変更
			.fullScreen = .fullScreened = !isfull;
			// トリガでメニューをクリックさせる
			trig.trigger();
		}
	}
}

function reFullScreen() { updateFullScrZoomMenu(); resetScreenMode(true, true); }
function resetScreen()  { resetScreenMode(kag.fullScreened); }
function updateFullScrZoomMenu(menu = "fullScrResMenu") {
	if (typeof global.kag != "Object" || !kag || !isvalid global.kag) return;
	var res  = System.getArgument("-fsres"), pseudo = kag.isPseudoMode();
	var isauto = (res == "" || res == "auto");
	var ismiddle = (System.getArgument("-fszoom") == "middle");
	var info = SystemArgumentInfo;
	setEnableMenuGroup(menu, info.fszoom.group, !isauto || pseudo);
	setEnableMenuGroup(menu, info.fsres.group, !pseudo);
	if (pseudo) updateRadioMenuItem(info.fsres.menu, "nochange",, info.fsres.group);
	else        updateSysArgMenuItem(   "fsres");

	if (ismiddle || (isauto && !pseudo)) {
		var tag = "inner";
		/**/tag = "middle" if (ismiddle && pseudo);
		updateRadioMenuItem(info.fszoom.menu, tag,, info.fszoom.group);
	} else updateSysArgMenuItem("fszoom");
	if (typeof kag.middleZoomPercentMenuItem == "Object")
		/**/   kag.middleZoomPercentMenuItem.enabled = (ismiddle && pseudo);
	if (typeof kag.fullScrResMiddleMenuItem == "Object")
		/**/   kag.fullScrResMiddleMenuItem.enabled = pseudo;
}
function onDisplayChangedHook() {
	updateFullScrZoomMenu();
	systemUpdate("windowSize");
}

// 旧chkMonitorプラグイン互換関数
function CheckPrimaryMonitor(win) {
	try {
		var rect, mons;
		if (typeof System.getDisplayMonitors != "undefined" &&
			typeof win.getWindowRect != "undefined" &&
			(rect = win.getWindowRect()) !== void) {

			with (rect) mons = System.getDisplayMonitors(.x, .y, .w, .h);
			if (mons !== void) {
				for (var i = 0; i < mons.count; i++) {
					if (mons[i] === void || mons[i].primary) continue;
					return 0;
				}
				return 1;
			}
		}
	} catch {}
	return -1;
}

// -----------------------------
// System.setArgument 系

// 吉里吉里の引数の型と対応メニューの情報，変更時の処理など
var SystemArgumentInfo = %[
fsres:      %[ type:"String",  changed:reFullScreen ],
fszoom:     %[ type:"String",  changed:function {
	if (typeof global.kag == "Object" && kag && isvalid kag) with (kag) try {
		var resize = (.fullScreened ?
					  (.pseudoFullScreened) : 
					  (.maximized && System.getArgument("-maximizezoom") == "fszoom"));
		if (resize) {
			.onResize();
			return;
		}
	} catch {}
	reFullScreen();
} incontextof global ],
smoothzoom: %[ type:"Boolean", changed:resetScreen ],
usedb:      %[ type:"Boolean", changed:resetScreen ],
dbstyle:    %[ type:"String",  changed:function() { resetScreen(); updateSysArgMenuItem("usedb"); } incontextof global,
/**/           isauto:function() { var dbs = System.getArgument("-dbstyle"); return (dbs == "" || dbs == "auto"); } incontextof global ],
contfreq:   %[ type:"Integer", changed:"設定は即座に反映されない場合があります" ],
drawthread: %[ type:"String", changed:function() {
	var num = System.getArgument("-drawthread");
	switch (num) {
	case "auto": num = 0; break;
	default: try { num = +num; } catch { num = 1; } break;
	}
	System.drawThreadNum = num;
	dm("SetDrawThreadNum", num);
} incontextof global ],

// トラブルシュート用設定
vomstyle:      %[ type:"String", caption:"ムービー表示" ],
fullscreenmode:%[ type:"String", caption:"複数モニタ全画面", changed:function { updateFullScrZoomMenu(); reFullScreen(); } incontextof global ],
fsmethod:      %[ type:"String",  changed:reFullScreen ],
waitvsync:     %[ type:"Boolean", changed:function { try { kag.flipStart(); } catch {} } incontextof global ],
memusage:      %[ type:"Boolean", restart:true ],
curmove:       %[ type:"Boolean", changed:function { 
	MyYesNoDialog.setCursorMoveTime(System.getArgument("-curmove"));
	systemUpdate("curMove") if (typeof global.systemUpdate == "Object");
} incontextof global ],
wheel:         %[ type:"Boolean", restart:true ],
joypad:        %[ type:"Boolean", restart:true ],

// デバッグ用
autoerrlogopen:%[ type:"Boolean" ],
autoerrlogmove:%[ type:"Boolean" ],
consolerepos:  %[ type:"Boolean" ],
consolesyncpos:%[ type:"Boolean" ],
	];


// -----------------------------
// メニュー更新・cfu保存処理つき System.setArgument
function setSystemArgument(tag, arg) {
	var value, info = (tag != "") ? SystemArgumentInfo[tag] : void;

	// 変更する値を取得
	if (info === void || (value = getSysArgValue(arg, info.type)) === void) return;

	// SystemArgument 設定
	var old  = System.getArgument("-"+tag), changed = (old != value);
	if (typeof System.setArgument == "undefined") changed = void;
	else       System.setArgument("-"+tag, value);
	if (info.restart) changed = void;

	// メニューを更新
	updateRadioMenuItem(info.menu, value,, info.group);

	// cfu に保存
	changeUserConf(tag, (string)value);
	return changed;
}
// デフォルト設定用 System.setArgument
function setDefaultSystemArgument(tag, value, callchg = true) {
	// 何か設定済みなら何もしない
	if (tag == "" || System.getArgument("-"+tag) != "") return;
	// メニュー更新があるならそちらを呼ぶ
	var info = (tag != "") ? SystemArgumentInfo[tag] : void;
	if (info !== void) {
		var ret = setSystemArgument(tag, value);
		info.changed(info, ret) if (callchg && typeof info.changed == "Object");
		return ret;
	}
	// それ以外は普通に設定し，cfuを更新
	System.setArgument("-"+tag, value);
	changeUserConf(tag, (string)value);
	return true;
}

// System.setArgument 系メニューの更新処理
function setSysArgMenuItem(tag, arg) {
	if (typeof tag == "Object") {
		arg = tag, tag = void;
		tag = arg.parent.tag if (typeof arg.parent != "undefined" && typeof arg.parent.tag != "undefined");
		if (tag != "" && tag.indexOf(":") >= 0) {
			var div = (":"+tag).split(":");
			tag = div[+arg.group];
		}
	}
	var info = (tag != "") ? SystemArgumentInfo[tag] : void;
	if (info === void) return;
	var chg = setSystemArgument(tag, arg, info.type, info.menu);
	if (chg === void || typeof info.changed == "String") {
		var mes = "設定は再起動後に有効となります";
		mes = info.changed if (chg !== void && info.changed != "");
		System.inform(mes) if (!info.dialog);
		info.dialog = true;
	} else if (info.changed !== void) return info.changed(info, chg);
}
// メニュー項目名称を保存
var sysArgMenuNameList = [];
function addSysArgMenu(name, tag, grp) {
	if (tag == "") return;
	if (tag.indexOf(":") >= 0) {
		var div = tag.split(":");
		for (var i = 0; i < div.count; i++)
			addSysArgMenu(name, div[i], i+1);
	} else {
		sysArgMenuNameList.remove(tag, true);
		sysArgMenuNameList.add(tag);
		var info = SystemArgumentInfo[tag];
		if (     info === void)                        Debug.notice(@"SystemArgumentInfo.${tag}: メニュー情報なし");
		else if (info.menu != "" && info.menu != name) Debug.notice(@"SystemArgumentInfo.${tag}.menu: 重複（${name}/${info.menu}）");
		else /**/info.menu = name;
		info.group = grp if (grp !== void && info !== void);
	}
}
function resetSysArgRadioMenuParent(name, tag, index) {
	if (name == "" || tag == "") return;
	var info = SystemArgumentInfo[tag];
	if (info === void || typeof kag[name] != "Object" || typeof kag[info.menu] != "Object") return;
	var grp = 0, par = kag[name], ext = kag[info.menu];
	if (!ext.visible) return; // 非表示なら展開しない

	index = ext.index if (index === void && ext.parent === par);
	ext.parent.remove(ext) if (ext.parent);
	index = par.children.count if (index === void);
	if (index !== void) {
		var bar = new MenuItem(kag, "-");
		par.insert(bar, index);
	}
	for (var i = ext.children.count-1; i >= 0; i--) {
		var item = ext.children[i];
		if (item !== void && item.radio) with (item) {
			.groupTag = tag;
			.caption = @"[${ext.caption}] " +.caption;
			ext.remove(item);
			par.insert(item, index);
		}
	}
	var tags = par.resetChildItemGrouping();
	var grp = tags.find(tag);
	tags.remove(void, true);
	par.tag = tags.join(":");

	with (info) .menu = .group = void;
	sysArgMenuNameList.remove(tag, true);
	addSysArgMenu(name, par.tag);
}

// System.setArgument 系メニューの createMenuFromList 用辞書を返す（ラジオリスト用）
function getSysArgRadioMenu(name, caption, tag, visible, list, group = 1) {
	addSysArgMenu(name, tag);
	return %[
	name:name, caption:caption, prop:%[ tag:tag, visible:visible ],
	children: getSysArgRadioSubMenu(list, group)
		];
}
function getSysArgRadioSubMenu(list, group) {
	var ret = [];
	for (var item, i = 0; i < list.count; i++) {
		switch (typeof (item = list[i])) {
		case "String":
			if (item.indexOf(":") >= 0) {
				item = item.split(":");
				var value = item[0].trim(), caption = item[1].trim();
				var name = (item.count > 2) ? item[2].trim() : void;
				var grp = (item.count > 3 && +item[3] > 0) ? +item[3] : group;
				item = %[ name:name, caption:caption, group:grp, exp:setSysArgMenuItem, prop:%[] ];
				if (value.charAt(0) == "*") {
					value = value.substr(1).trim();
					item.prop._default = value;
				}
				item.prop.value = value;
			} else if (item != "-") break;
			// not break;
		case "Object":
			ret.add(item);
			break;
		}
	}
	return ret;
}

// System.setArgument 系メニューの createMenuFromList 用辞書を返す（on/offチェック用）
function getSysArgCheckMenuItem(name, caption, tag, visible, defval, chkval = "yes", noval = "no") {
	addSysArgMenu(name, tag);
	return %[
	name:name, caption:caption,
	prop:%[ tag:tag, visible:visible, value:chkval, novalue:noval, _default:defval ],
	exp:function(sender) {
		with (sender) setSysArgMenuItem(.tag, .checked ? .novalue : .value);
	} ];
}
// System.setArgument 系メニューの現在の値を更新
function updateSysArgMenuItem(menus*) {
	if (!menus.count && sysArgMenuNameList.count > 0) return updateSysArgMenuItem(sysArgMenuNameList*);
	for (var i = 0; i < menus.count; i++) {
		var tag, menu = menus[i];
		switch (typeof menu) {
		case "Object": tag = menu.tag if (typeof menu.tag != "undefined"); break;
		case "String": tag <-> menu; menu = SystemArgumentInfo[tag].menu; break;
		}
		if (tag == "") continue;
		var div = (tag.indexOf(":") >= 0) ? tag.split(":") : [ tag ];
		for (var j = 1; j <= div.count; j++) {
			var tag = div[j-1];
			var info = (tag != "") ? SystemArgumentInfo[tag] : void;
			var grp = (info !== void) ? info.group : void;
			updateRadioMenuItem(menu, System.getArgument("-" + tag),, grp !== void ? grp : j);
		}
	}
}


/**
 * パススルーメニューを更新する
 * @param delay 0:遅延モード自動選択, 1:強制遅延, -1:即処理
 */
function updatePassThroughMenuItem(delay = 0) {
	// 強制遅延フラグかオート設定ならトリガ経由にする
	if (delay > 0 || (!delay && SystemArgumentInfo.dbstyle.isauto()))
		return invokeDelayedTrigger("updatePassThroughMenuItem");

	var win = global.kag;
	if (win === void || !isvalid win ||
		typeof win.dispDoubleBufferMenu == "undefined") return;
	var menu = win.dispDoubleBufferMenu;
	var tag;

	// 子メニューに状態を表示
	with (global.Window.PassThroughDrawDevice) switch (win.drawDevice.drawer) {
	case .dtDrawDib: tag = "[DIB]";        break;
	case .dtDBGDI:   tag = "[GDI]";        break;
	case .dtDBDD:    tag = "[DirectDraw]"; break;
	case .dtDBD3D:   tag = "[Direct3D]";   break;
	}
	for (var c = menu.children, i = 0; i < c.count; i++) with (c[i]) {
		if (.caption == "-") break;
		.origCaption = .caption if (typeof .origCaption == "undefined");
		if (.checked) .caption = @"${.origCaption} ${tag}";
		else          .caption = .origCaption;
	}
	if (typeof win.useDoubleBufferMenuItem == "undefined") return;
	/**/menu = win.useDoubleBufferMenuItem;
	with (menu) {
		var dbs = System.getArgument("-dbstyle");
		dbs = (dbs == "d3d" || dbs == "ddraw");
		.enabled = !dbs;
		.value   =  dbs ? null : "no";
		updateSysArgMenuItem(menu);
	}
}

// -----------------------------
// ウィンドウモード時のサイズ変更関連メニュー処理
var windowResolutionWidthList = [
	320, 400, 512, 640, 720, 800, 960, 1024, 1280, 1440, 1600
	];
function setWindowRes(arg) {
	var w = getSysArgValue(arg, "Integer");
	if (+w == 0) return;
	w = kag.scWidth if (w < 0);
	kag.setZoom(w, kag.scWidth);
	updateWindowResMenu(arg.parent) if (typeof arg == "Object");
}
function getWindowResMenuItem(w, h, zw, scut) {
	var zh = zw * h \ w;
	return %[   name:@"windowResizeTo${zw}MenuItem", caption:(scut != "" ? "(&"+scut+") : ":"") + @"${zw} x ${zh}", group:1,
			exp:setWindowRes, prop:%[ value:zw, scut:scut, visible:(zw <= System.screenWidth && zh < System.screenHeight) ] ];
}
function updateWindowResMenu(menu) {
	with (kag) {
		var now = .scWidth * .zoomNumer \ .zoomDenom;
		updateRadioMenuItem(menu, (now != .scWidth) ? now : void);
	}
}
function onWindowResizeHook(win, w, h) {
	with (win) {
		var pw = .pxWidth;
		var ph = .pxHeight;
		var dw = pw * .zoomNumer \ .zoomDenom;
		var dh = ph * .zoomNumer \ .zoomDenom;
//		dm("onWindowResizeHook/diff", w, h, dw, dh) if (dw != w || dh != h);

		if (typeof .disableWindowResizeMenuItem != "undefined") {
			/**/   .disableWindowResizeMenuItem.caption = @"${dw} x ${dh} で固定" + "(&F)";
		}
		if (typeof .winResMenu != "undefined") {
			updateRadioMenuItem(.winResMenu, /*(w == pw && h == ph) ? void :*/ w);
			.winResMenu.enabled = !.tempZoomed && !.fullScreen;

			// pxWidth/pxHeightのサイズ変更があった場合はメニューのサイズを追従
			with (.winResMenu) if (typeof .lastWidth == "undefined" || .lastWidth != pw || .lastHeight != ph) {
				.lastWidth  = pw;
				.lastHeight = ph;
				for (var i = 0, list = .children; i < list.count; i++) {
					var item = list[i];
					if (typeof item.scut != "undefined") {
						var tag = getWindowResMenuItem(pw, ph, item.value, item.scut);
						item.caption = tag.caption if (tag !== void);
					}
				}
			}
		}
	}
	updateFullScrZoomMenu();
	updatePassThroughMenuItem();
	systemUpdate("windowSize");
}

// -----------------------------
// KAG標準メニューの更新処理

function getSenderMenuItemForKAG(sender, tag, value)
{
	sender = %[ tag =>  value ] if (sender === void);
	sender = %[ tag => !value ] if (typeof sender.checkitem != "undefined") ; // kagをだます
	return sender;
}

function setAllSkip(sender, ignoreUpdate)
{
	var get = (typeof kag._allskip != "undefined" ?
			   function { return _allskip; } :
			   function { return  allskip; } ) incontextof kag;
	sender = getSenderMenuItemForKAG(sender, "skip", get());
	kag.onAllSkipMenuItemClick(sender);
	var as = get();
	updateRadioMenuItem("allskipCheckMenuItem", as, "checkitem");
	updateRadioMenuItem("allskipMenu",          as, "skip");
	if (!ignoreUpdate) {
		systemUpdate("allSkip");
		kag.setMenuAccessibleAll();
	}
}

function setCancelAutoByClick(sender)
{
	sender = getSenderMenuItemForKAG(sender, "cancel", kag.cancelAutoWhenClick);
	kag.onCancelAutoWhenClickMenuItemClick(sender);
	var ca = kag.cancelAutoWhenClick;
	updateRadioMenuItem("cancelAutoByClickMenuItem", ca, "checkitem");
	systemUpdate("cancelAutoByClick");
}

function setTextSpeed(sender)
{
	kag.onChSpeedMenuItemClick(sender);
	systemUpdate("textSpeed");
}

function setAutoSpeed(sender)
{
	kag.onAutoModeWaitMenuClick(sender);
	systemUpdate("autoSpeed");
}

function setEffect(sender)
{
//	sender.checked = true;
	with (kag) {
		.noeffect = (typeof sender.noeffect != "undefined") ? sender.noeffect : !.noeffect;
		.saveSystemVariables();
	}
	systemUpdate("effectSpeed");
}

function updateMenuItemCaption(kag, cap, tag) {
	if (tag == "" || typeof kag[tag] == "undefined") return;
	with (kag[tag]) {
		.origCaption = .caption if (typeof .origCaption == "undefined");
		if (cap == "") .caption = .origCaption;
		else {
			var brc = .origCaption.indexOf("(");
			var base = (brc < 0) ? .origCaption : .origCaption.substr(0, brc);
			.caption =  base + @"(${cap})";
		}
	}
}
var updateCaptionMenusMap = %[
	about:	"helpAboutMenuItem",		// バージョン情報(F1)
	save:	"storeMenu",				// セーブ(F2)
	load:	"restoreMenu",				// ロード(F3)
	screen:	"toggleScreenMenuItem",		// 窓表示⇔全画面 切り替え(F4)
	backlog:"showHistoryMenuItem",		// バックログ(F5)
	auto:	"autoModeMenuItem",			// オート(F6)
	skip:	"skipToNextStopMenuItem",	// スキップ(F7)
	option:	"configMenuItem",			// オプション(F8)
	qsave:	"quickStoreMenu",			// クイックセーブ(F11)
	qload:	"quickRestoreMenu",			// クイックロード(F12)

	next:	"goNextMenuItem",			// 次の選択肢
	prev:	"goBackMenuItem",			// 前の選択肢

	vreplay:"voiceReplayMenuItem",		// 音声リプレイ
	title:	"goToStartMenuItem",		// タイトルへ戻る
	rclick:	"rightClickMenuItem",		// 画面表示
	exit:	"exitMenuItem",				// 終了
	];

function KAGWindow_updateMenus(kag, cap) {
	var ext = [];
	ext.assign(global.updateCaptionMenusMap);
	for (var i = 0; i < ext.count; i+=2)
		updateMenuItemCaption(kag, cap[ext[i]], ext[i+1]);
}


// -----------------------------
// メニュー項目生成

function KAGWindow_createMyMenus()
{
	var enDbg = global.debugWindowEnabled;

	// 解像度メニュー一覧はリストから動的生成
	var resMenus = [
		%[  name:"resetWindowSizeMenuItem",     caption:"標準：等倍サイズ(&D)", exp:onResetWindowSizeMenuItemClick,    prop:%[ shortcut:"Alt+1" ] ],
		%[  name:"disableWindowResizeMenuItem", caption:"固定(&F)",             exp:onDisableWinwodResizeMenuItemClick ], "-" ];
	if (typeof    global.windowResolutionWidthList == "Object") {
		var res = global.windowResolutionWidthList;
		var shortcuts = "1234567890-QWERTYUIOPZXCVBNM";
		for (var i = 0, cnt = res.count; i < cnt; i++)
			if (res[i] > 0) resMenus.add(getWindowResMenuItem(scWidth, scHeight, res[i], shortcuts.charAt(i)));
	}
	var getHotKey = enDbg ? function (arg, def) { var s = System.getArgument("-"+arg); return s != "" ? s : def; } incontextof global : function {};
	createMenuFromList(this, menu, [

		// -------- ファイル
		%[  name:"systemMenu", caption:"ファイル(&F)", children:[
			%[  name:"storeMenu",         caption:"セーブ(&S)",     exp:"SystemAction._save()",  se:"menu.save" ],
			%[  name:"restoreMenu",       caption:"ロード(&L)",     exp:"SystemAction._load()",  se:"menu.load" ],
			%[  name:"quickStoreMenu",    caption:"クイックセーブ", exp:"SystemAction._qsave()", se:"menu.qsave" ],
			%[  name:"quickRestoreMenu",  caption:"クイックロード", exp:"SystemAction._qload()", se:"menu.qload" ],
			"-",
			%[  name:"goToStartMenuItem", caption:"タイトルへ戻る(&T)",   exp:"SystemAction._title()",  se:"menu.title" ],
			/* 未使用 */%[  name:"rightClickMenuItem",caption:"画面表示", exp:"SystemAction._rclick()", se:"menu.rclick", noadd:true ],
			"-",
			%[  name:"exitMenuItem",      caption:"終了(&X)",            exp:"SystemAction._exit()",    se:"menu.exit", prop:%[ shortcut:"Alt+F4" ] ],
			] ],

		// -------- 画面
		%[  name:"displayMenu", caption:"画面(&S)", children:[
			%[  name:"windowedMenuItem",     caption:"ウィンドウ表示(&W)", group:1, exp:"SystemAction._window()",     se:"menu.window" ],
			%[  name:"fullScreenMenuItem",   caption:"フルスクリーン(&F)", group:1, exp:"SystemAction._fullscreen()", se:"menu.fullscreen" ],
			%[  name:"toggleScreenMenuItem", caption:"窓表示⇔全画面 切り替え",     exp:"SystemAction._screen()",     se:"menu.togglescreen", prop:%[ shortcut:"Alt+Enter", visible:false ] ],
			"-",
			%[  name:"winResMenu", caption:"ウィンドウ表示時サイズ(&S)", children:resMenus ],
			getSysArgRadioMenu("fullScrResMenu", "フルスクリーン時解像度(&R)", "fsres:fszoom", true, [
				"*auto       :自動設定(&A)",
				"nochange    :解像度を変えない(&O)",
				"nearest     :最も近い解像度(&N)",
				"proportional:縦横比が同じ解像度(&P)",
				"-",
				"*inner:内接で拡大：端に黒帯(&I)::2",
				"outer :外接で拡大：端をカット(&C)::2",
				"no    :拡大しない：中央に表示(&D)::2",
				"middle:中間で拡大：カットして黒帯(&M):fullScrResMiddleMenuItem:2",
				"-",
				%[  name:"middleZoomPercentMenuItem", caption:"拡大割合指定(&Z)", exp:"inputMiddleZoomPercent()" ],
				]),
			getSysArgRadioMenu( "dispDoubleBufferMenu", "表示方式(&D)", "dbstyle", true, [
				"*auto:自動設定(&A)",
				"d3d  :Direct3D(&3)",
				"ddraw:DirectDraw(&D)",
				"gdi  :GDI(&G)",
				"-",
				getSysArgCheckMenuItem("useDoubleBufferMenuItem", "等倍時にDI&B方式を使用", "usedb", true, "no", "no", "yes"),
				]),
			getSysArgRadioMenu( "multiThreadDrawMenu", "描画スレッド分割数(&N)", "drawthread", (typeof System.drawThreadNum != "undefined"), [
				"*1:無効：スレッド分割しない(&D)",
