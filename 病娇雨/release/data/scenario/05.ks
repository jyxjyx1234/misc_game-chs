;ムービー消し
[free_layermode  ]

;――――――――――――――――――――――――――――――――ー
;音声ストップ
[stopse  time="1000"  buf="0"  ]
;――――――――――――――――――――――――――――――――ー
;退場
[chara_hide_all  time="100"  wait="true"  ]
;――――――――――――――――――――――――――――――――ー
;背景黒
[bg  storage="kuro.png"  time="1000"  ]
;――――――――――――――――――――――――――――――――ー
;BAD END表示
;ムービー再生
[movie storage="true.webm" skip=false ]
;――――――――――――――――――――――――――――――――ー
;BGM消し
[stopbgm  time="2000"  fadeout="true"  ]
;――――――――――――――――――――――――――――――――ー
;ウエイト
[wait time="2000"]
;――――――――――――――――――――――――――――――――ー
;sf.edに１をプラス エンディング済み変数
[eval exp="sf.TRUE=1"]
;――――――――――――――――――――――――――――――――ー
;タイトルへ
[jump  storage="first.ks"  target="*start"  ]
