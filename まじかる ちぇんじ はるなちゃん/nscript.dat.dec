;名前プレートを表示する
*pretext
;isskip %0
;if %0=0 spstr "p821p822p823p824p825p826"
;if %0=1 spstr "p815p821p822p823p824c825p826"
;if %0=2 spstr "p814p821p822p823c824p825p826"

;dwavestop 2:dwavestop 3:dwavestop 4:dwavestop 5:dwavestop 6:dwavestop 7:dwavestop 8
;    dwavestop 0
csp NAMETAG
;getparam $FuncArgS9
if %25 == 1 mov $1,$2:goto *renametag
gettag $0
;if $0="" amsp 803,641,0:print 1:return
;if $0="" && %141 = 1 mov $0,$140:mov %141,0
;mov $140,$0
mov %nameplate,0
if $0="" print 1:return


mov $2,":s/20,22,0;#ffffff"

mid $3,$0,2,2
if $3="ケ" mov $2,":s/18,22,0;#ffffff"
if $3="下" mov $2,":s/18,22,0;#ffffff"
add $2,$0
lsp NAMETAG,$2,18,471
mov %nameplate,1

;spstr "m803,75,436"
print 1

return
