*saveload_setdata_sub3
	mov $w0,""
	mov %ws0,100
	mov %ws1,%2 - 4		;表示される日付は、内部より４日先になる
	*saveload_setdata_sub3_lp
	if %ws0=1 goto *saveload_setdata_sub3_lp2
	if %ws1/%ws0=0 div %ws0,10:goto *saveload_setdata_sub3_lp
	*saveload_setdata_sub3_lp2
	mov %ws2,%ws1/%ws0
	if %ws2=0 add $w0,""
	if %ws2=1 add $w0,""
	if %ws2=2 add $w0,""
	if %ws2=3 add $w0,""
	if %ws2=4 add $w0,""
	if %ws2=5 add $w0,""
	if %ws2=6 add $w0,""
	if %ws2=7 add $w0,""
	if %ws2=8 add $w0,""
	if %ws2=9 add $w0,""
	mov %ws1,%ws1 mod %ws0
	div %ws0,10
	if %ws0<1 add $w0,"":return
goto *saveload_setdata_sub3_lp2


*saveload_setdata_sub2
	date %w10,%w6,%w7
	time %w8,%w9,%w10
	mov $w0,"記録日："
	if %w6>=10 add $w0,"１"
	mov %w10,%w6 mod 10
	gosub *saveload_addnum
	add $w0,"月"
	if %w7>=10 mov %w10,%w7 / 10:gosub *saveload_addnum
	mov %w10,%w7 mod 10
	gosub *saveload_addnum
	add $w0,"日"
	if %w8>=10 mov %w10,%w8 / 10:gosub *saveload_addnum
	mov %w10,%w8 mod 10
	gosub *saveload_addnum
	add $w0,"時"
	if %w9>=10 mov %w10,%w9 / 10:gosub *saveload_addnum
	mov %w10,%w9 mod 10
	gosub *saveload_addnum
	add $w0,"分"
return

