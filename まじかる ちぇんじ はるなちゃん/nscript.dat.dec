;mode800,value700
;-----------------------------------------------------------
汎用アドベンチャースクリプトシステム（今回はMagical Girl第三段）
;　　　　　　　　　　　　　　　　　火社　京介　ふぇんりる狼
;スクリプトは４タブで記述されています
;-----------------------------------------------------------



;基本ファイル（定義ファイル）（サブルーチン含め）
;-----------------------------------------------------------
;定義フェイズ
*define

;ＮＳＡアーカイブモードにします。
nsa

;高橋追加－－－－－－－－－－－－－－－－－－－－－－－－－
;各種スプライトを108～110に変更させていただきました。
defsub texton		;同名命令のオーバーライド
defsub textoff		;同名命令のオーバーライド
humanz 200			;スプライトの中での立ち絵やウィンドウチップの配置

;ホイールマウスを使用する
usewheel

;mode_extは、automodeという名前の命令と同じ意味になります。
automode
automode_time 5000

;スキップでも音声を馴らす
;mode_wave_demo

;音楽のフェード間隔（デフォルト）
bgmfadeout 300

;普通の選択肢の色を指定します。
;順に、マウスが上にいるとき、いないとき、の色です。
;selectcolor #rrggbb,#rrggbb

;文字列スプライトのフォントを設定する
;spfont "ＭＳゴシック",20,20,,10,太字フラグ,影フラグ

;画像ファイルログを取るようにする
filelog

;ラベルログを取るようにする
labellog

;クリック待ちに音声を指定する
clickvoice "SE\SYS\OK.wav",""

;選択肢が発生する時に音声を指定する
selectvoice "SE\SYS\SEL_OUTPUT.wav","SE\SYS\SELECT.wav","SE\SYS\OK.wav"

;回想文字列
lookbackvoice "SE\SYS\TXT_LOG.wav"

;メニュー画面における音声
;menuselectvoice "SE\SEL_OUTPUT.wav","SE\SEL_OUTPUT.wav","SE\SEL_OUTPUT.wav","SE\SEL_OUTPUT.wav","SE\SEL_OUTPUT.wav","SE\SEL_OUTPUT.wav","SE\SEL_OUTPUT.wav"

;基本文字速度
;設定※現在はデバックのため、1に設定
defaultspeed 1,1,1

;ウィンドウ消去時、人を消さなくなります。
noteraseman

;スキップ時にエフェクトカット
effectcut

;指定したスプライトがテキストウィンドウと一緒についたり消えたりするようになる
windowchip 135
windowchip 136
windowchip 137
windowchip 138
windowchip 139
windowchip 140
windowchip 141
;windowchip 50


;名前表示
pretextgosub *pretext
;-------------------------------------------------
;文字列定数の設定
;-------------------------------------------------
;(SP)とは、スプライトで使われている番号
;(Val)とは、変数に使われている番号
;接尾語が無い場合は、普通の文字列定数です

;ヒロイン頭文字
numalias A,1
numalias B,2
numalias C,3       ;C 以降未使用
numalias D,4
numalias E,5
numalias F,6
numalias G,7

numalias CG_MODE,8          ;連想配列の頭文字(val)
numalias CG_pagenum,3+3     ;ＣＧ＋回想モードの総ページ数
numalias CG_vermax,6        ;連想配列の頭文字(val)

numalias Scene,20			;シナリオタイトルを格納する(Val)
numalias Caption,21			;キャプション

;デバックスイッチ
