;-----------------------------------------------------------
;システム関連設定

;バージョン情報記載
versionstr "まじかるちぇんじはるなちゃん","Ver 1.00"

;キャプション情報記載
caption "まじかるちぇんじはるなちゃん"

;テキストウィンドウが出る／消えるときのエフェクトを指定します。
;パラメータは、エフェクト番号指定がない以外は、effectと同じです。
windoweffect 10,200

;透過色のデフォルト設定を変えます。デフォルトではleftupです。 
transmode alpha

;エフェクト番号に、効果を割り当てます。
effect 2,10,100     ;立ち絵＆ＥＶ表示（短いクロスフェイド）
effect 3,10,500     ;通常のクロスフェイド
effect 4,10,3000	;1 秒の長いクロスフェイド
effect 5,6,500      ;背景表示用
effect 6,10,150
effect 7,9,1000
effect 8,6,500
effect 9,10,3000	;1 秒の長いクロスフェイド

;セーブ個数
savenumber 10

;メニュー用のウィンドウ設定です。
menusetwindow 15,18,2,2,0,1,#808080

arc "arc.sar|scrunarc.dll"
spi "ifpng.spi|png"
kidokuskip
textgosub *text_lb;テキストウィンドウ関連
;メニューから必要ない項目を削除する
killmenu 0
killmenu 0
killmenu 0
killmenu 0
killmenu 0
killmenu 0
killmenu 0
killmenu 0

;右クリックを押したら
selectcolor #EEFCFD,#99CCFB

;グローバル変数を使う設定をします。 
globalon

;-----------------------------------------------------------
;ゲームフェイズ
game

*RegSoundMode
getparam %12,$10,$11

	mov $?SOUND[%12][0],$10		;曲ファイル
	mov $?SOUND[%12][1],$11		;曲名

return 

;ウィンドウのセッティング
*SetWindowOrg

setwindow TextStartPosX,TextStartPosY,TextWordNum,TextLineNum,FontSizeX,FontSizeY,WordSpace,LineSpace,DefSpead,FontBold,FontShadow,":a;SYS\window\MAIN_WINDOW.bmp",TWindowPosX,TWindowPosY

gosub *settextspeed;文字速度設定


return


;関数　ＣＧモードのＣＧインデックスを登録する
*RegCGModeIndex
getparam $10

	mov $?CG_MODE[0][0],$10

return

;関数　ＣＧモードにＣＧを登録する
*RegCGMode
getparam %13,$10,$11

    mov $?CG_MODE[%13][0],$10           ;検索するファイル名
    mov $?CG_MODE[%13][1],$11           ;使用するサムネイル

return

;関数　回想モードにシーンを登録する
*RegMemoMode
getparam %13,$10,$11

    mov $?CG_MODE[%13][0],$10           ;検索するラベル名
    mov $?CG_MODE[%13][1],$11           ;使用するサムネイル

return

;関数　キャプションを変更する
*CaptionChange
getparam $10

	mov $Caption,"まじかるちぇんじはるなちゃん"
	mov $Scene,$10
	add $Caption,"["
	add $Caption,$Scene
	add $Caption,"]"
	;caption $Caption

return

;-----------------------------
;関数　音楽を再生する
*BGM_PLAY
getparam %74

    if %74 = %music_before goto *BGM_PLAY_skip
        mov %music_before,%74

        mov $10,"BGM\M0"                    ;ファイル名の作成
        itoa $11,%74
        add $10,$11
        add $10,".wav"

        bgm $10                             ;音楽を再生する

*BGM_PLAY_skip
    return

;-----------------------------
;ＢＧＭ再生
*BGM_STOP
;getparam %74

    mov %music_before,0

;   bgmfadeout %74                          ;音声ボリューム
    bgmstop                                 ;音楽を停止する
    bgmfadeout 300                          ;音声ボリューム
    dwavestop 0

return

;-----------------------------

;数字を全角に変える
*CHANGE_STRING
getparam s%171,%166

	mov %168,0
	
	itoa $167,%166
	len %167,$167
	for %168=0 to %167 step 1
	
		;文字分割
		mid $168,$167,%168,1
		
		if $168 = "0" add $169,"０"
		if $168 = "1" add $169,"１"
		if $168 = "2" add $169,"２"
		if $168 = "3" add $169,"３"
		if $168 = "4" add $169,"４"
		if $168 = "5" add $169,"５"
		if $168 = "6" add $169,"６"
		if $168 = "7" add $169,"７"
		if $168 = "8" add $169,"８"
		if $168 = "9" add $169,"９"

	next
	
	;外部変数に代入
	mov $%171,$169
	
	;初期化
	mov $169,""

return

;画面を揺らす
*EF_QUAKEY
getparam %127,%128

;コンフィグでエフェクトがオフの場合表示は簡素に	

    if %c_effect = 1 goto *EF_Q_END
    quakey %127,%128

*EF_Q_END                                       ;エフェクトオフでスキップ

return

;画面を揺らす
*EF_QUAKEX
getparam %127,%128

;コンフィグでエフェクトがオフの場合表示は簡素に	

    if %c_effect = 1 goto *EF_Q_END
    quakex %127,%128

;*EF_Q_END                                       ;エフェクトオフでスキップ

return

