if %EXFlag == 1 return

CL_LD
bgmstop
BG BLACK,3
goto *staffroll

;-------------------------------------------------
;エクストラモード
;-------------------------------------------------
*EXTRA

textoff

;bgm "BGM\01.wav"                       ;エクストラモード画面

mov $NONOP,":c;SYS\EXTRA\CG\not_open.bmp"   ;未開封ファイル名を指定
gosub *SETTING_CG_MODE                  ;キャラクター毎の初期設定を行う

mov %CGmode_PAGE,1                      ;ＣＧモード用ページ番号
mov %MEMmode_PAGE,1                     ;回想モード用ページ番号

mov %VEXMode,1                          ;ＣＧモード
bg ":c;SYS\EXTRA\CG\CGBG.bmp",2
goto *CG_MODE

;サウンドモードに移行する-------------------------
*SOUND_MODE

    stop                                ;楽曲を全て止める

    mov %ResetFlag,5                    ;リセットフラグ

    csp -1                              ;スプライトを全て消去

;   サウンドモードで使うファイル名に変数を割り当てる

    mov %83,SoundModeVal                ;領域初期化を行います

	;代入変数の初期設定
	for %81=1 to SoundNum step 1
		for %82=0 to 1 step 1
			inc %83		;変数番号をインクリしていく
			mov ?SOUND[%81][%82],%83
		next
	next

	RegSoundMode 1,"BGM\01.wav","悪夢に堕ちて"
	RegSoundMode 2,"BGM\02.wav","絶望の兆し"
	RegSoundMode 3,"BGM\03.wav","閉ざせぬ瞳"
	RegSoundMode 4,"BGM\04.wav","狂気の深淵"
	RegSoundMode 5,"BGM\05.wav","真夜中の灯火"
	RegSoundMode 6,"BGM\01.wav","陰謀の狭間で"
	RegSoundMode 7,"BGM\02.wav","蹂躙獣従"
	RegSoundMode 8,"BGM\03.wav","引き返せない場所に"
	RegSoundMode 9,"BGM\04.wav","人生の挫折"
	RegSoundMode 10,"BGM\05.wav","支配者の倦怠"

;ループの戻り地点
*botan_Sound

;背景を表示
bg "SYS\EXTRA\SOUND\SOUND.bmp",3

*sound_button_set

bg "SYS\EXTRA\SOUND\SOUND.bmp",1
btndef "SYS\EXTRA\SOUND\SOUND_r.bmp"
mov %150,SoundSumPosX   ;初期表示位置Ｘ
mov %151,SoundSumPosY   ;初期表示位置Ｙ
mov %152,SoundSumHstep  ;サムネイルの高さ
mov %153,0

btn 1,%150,%151,SoundSumWIDE,SoundSumHEIGHT,0,%153:add %151,%152:add %153,%152
btn 2,%150,%151,SoundSumWIDE,SoundSumHEIGHT,0,%153:add %151,%152:add %153,%152
btn 3,%150,%151,SoundSumWIDE,SoundSumHEIGHT,0,%153:add %151,%152:add %153,%152
btn 4,%150,%151,SoundSumWIDE,SoundSumHEIGHT,0,%153:add %151,%152:add %153,%152
btn 5,%150,%151,SoundSumWIDE,SoundSumHEIGHT,0,%153:add %151,%152:add %153,%152
;btn 6,%150,%151,SoundSumWIDE,SoundSumHEIGHT,0,%153:add %151,%152:add %153,%152
;btn 7,%150,%151,SoundSumWIDE,SoundSumHEIGHT,0,%153:add %151,%152:add %153,%152
;btn 8,%150,%151,SoundSumWIDE,SoundSumHEIGHT,0,%153:add %151,%152:add %153,%152
;btn 9,%150,%151,SoundSumWIDE,SoundSumHEIGHT,0,%153:add %151,%152:add %153,%152
;btn 10,%150,%151,SoundSumWIDE,SoundSumHEIGHT,0,%153:

;   [ＣＧモード]
lsp PCG,    ":c/2,0,3;SYS\EXTRA\CG\cgview.bmp",CGModePosX,CGModePosY
;   [回想モード]
lsp PMEMORY,":c/2,0,3;SYS\EXTRA\CG\memory.bmp",MemoryPosX,MemoryPosY
;   [タイトルに戻る]
lsp PRETURN,":c/2,0,3;SYS\EXTRA\CG\back.bmp",RetButtonPosX,RetButtonPosY

    spbtn PCG,19                        ;[ＣＧモード]
    spbtn PMEMORY,20                    ;[回想モード]
    spbtn PRETURN,99                    ;[戻る]

;   曲名選択待ち


btnwait2 %11
;   右クリック
if %11=-1 csp 125:mov %37,0:gosub *config_title:goto *sound_button_set
if %11=0 goto *botan_Sound
if %11=1 mov %360,1
if %11=2 mov %360,2
if %11=3 mov %360,3
if %11=4 mov %360,4
if %11=5 mov %360,5
if %11=6 mov %360,6
if %11=7 mov %360,7
if %11=8 mov %360,8
if %11=9 mov %360,9
if %11=10 mov %360,10
if %11=19 mov %VEXMode,1:csp 125:mov %37,0:bgmstop:goto *SoundModeOut   ;[ＣＧモード]
if %11=20 mov %VEXMode,2:csp 125:mov %37,0:bgmstop:goto *SoundModeOut   ;[回想モード]

if %11=99 gosub *config_title:goto *sound_button_set        ;[タイトルへ戻る]

	;同一曲をクリックした場合は停止。違う場合は再生

	;音楽を再生する
	if %7=%11 && %37=1 mov %37,0:stop:csp 125:goto *botan_Sound

	;再生番号を保持
	mov %7,%11
	
	;再生フラグを設定
	mov %37,1

	bgm $?SOUND[%360][0]				;BGM再生
	mov $397,":s/22,22,0;#ffffff"		;文字列スプライト設定
	add $397,$?SOUND[%360][1]			
	lsp 125,$397,60,520


goto *botan_Sound


;-----------------------------------------------------------
;ＣＧ＆回想モードに移行する-------------------------
;-----------------------------------------------------------
*CG_MODE

csp -1                                  ;スプライトを全て消去

mov %ResetFlag,6                        ;リセットフラグ

bgm "BGM\01.wav"

;   ＣＧ＆回想モードの背景設定
if %VEXMode=1 mov %PAGE_NUM,%CGmode_PAGE:lsp PBG,":c;SYS\EXTRA\CG\CGBG.bmp",0,0:mov $NONOP,":c;SYS\EXTRA\CG\not_open.bmp":lsp 150,":c;SYS\EXTRA\CG\cgviewon.bmp",636,94
if %VEXMode=2 mov %PAGE_NUM,%MEMmode_PAGE:lsp PBG,":c;SYS\EXTRA\CG\MEMBG.bmp",0,0:mov $NONOP,":c;SYS\EXTRA\CG\enot_open.bmp":lsp 150,":c;SYS\EXTRA\CG\memoryon.bmp",636,134

;   キャラクタープレートを読み込む（現在未使用）
;if %CHOICE_CHA =B:lsp PName,":c;SYS\EXTRA\CG\PB.bmp",ChaPlatePosX,ChaPlatePosY
;if %CHOICE_CHA =B:lsp PFACE,":c;SYS\EXTRA\CG\PNB.bmp",ChaNamePosX,ChaNamePosY

;   基本システムボタンのスプライト定義
;   [ＣＧモード]
if %VEXMode=1 goto *CGmode_CGskip
lsp PCG,    ":c/2,0,3;SYS\EXTRA\CG\cgview.bmp",CGModePosX,CGModePosY
*CGmode_CGskip

;   [回想]
if %VEXMode=2 goto *CGmode_MEMskip
lsp PMEMORY,":c/2,0,3;SYS\EXTRA\CG\memory.bmp",MemoryPosX,MemoryPosY
*CGmode_MEMskip

;   [音楽鑑賞]
;lsp PSOUND, ":c/2,0,3;SYS\EXTRA\CG\sound.bmp",SoundModePosX,SoundModePosY
;   [戻る]
lsp PRETURN,":c/2,0,3;SYS\EXTRA\CG\back.bmp",RetButtonPosX,RetButtonPosY

;   １～５ページのボタン
lsp P1P,    ":c/3,0,3;SYS\EXTRA\CG\1p.bmp",P1PosX,P1PosY    ;[１ｐ]
lsp P2P,    ":c/3,0,3;SYS\EXTRA\CG\2p.bmp",P2PosX,P2PosY    ;[２ｐ]
lsp P3P,    ":c/3,0,3;SYS\EXTRA\CG\3p.bmp",P3PosX,P3PosY    ;[３ｐ]
;lsp P4P,    ":c/3,0,3;SYS\EXTRA\CG\4p.bmp",P4PosX,P4PosY    ;[４ｐ]
;lsp P5P,    ":c/3,0,3;SYS\EXTRA\CG\5p.bmp",P5PosX,P5PosY    ;[５ｐ]

;ページ送り、戻しを実施した場合、ここにgotoさせます。
;--------------------カタログ表示画面設定
*CG_MODE_CHA_SET

    cell P1P +%PAGE_NUM -1,3            ;表示ページのボタンを反転

    gosub *CG_RecordSet                 ;ＣＧ／回想の履歴登録

    mov %CGBuf,CGNum +PageSumNum        ;サムネイルへのスプライトボタン割当
    for %3=CGNum to %CGBuf              ;同上、スプライトの消去
        csp %3
    next

    btndef ""                           ;ボタン登録前にボタン定義クリア

    spbtn PRETURN,PRETURN               ;[戻る]
    spbtn PMEMORY,PMEMORY               ;[回想モード]
    spbtn PCG,PCG                       ;[ＣＧモード]
;    spbtn PSOUND,PSOUND                 ;[音楽モード]

*CG_log

gosub *RegPAGE

;--------------------カタログ表示画面の本表示
*CG_CHOICE

print 2,200                             ;カタログ表示画面の背景表示

;--------------------カタログ表示画面のボタン待機
*CGmode_Bwait

btnwait2 %0

if %0 = 0   goto *CGmode_Bwait          ;空の左クリックは無処理

if %0 = P1P mov %PAGE_NUM,1:goto *CG_MODE_CHA_SET   ;１ページ目へ移動
if %0 = P2P mov %PAGE_NUM,2:goto *CG_MODE_CHA_SET   ;２ページ目へ移動
if %0 = P3P mov %PAGE_NUM,3:goto *CG_MODE_CHA_SET   ;３ページ目へ移動
;if %0 = P4P mov %PAGE_NUM,4:goto *CG_MODE_CHA_SET   ;４ページ目へ移動
;if %0 = P5P mov %PAGE_NUM,5:goto *CG_MODE_CHA_SET   ;５ページ目へ移動

;   [ＣＧモード]
if %0 = PCG mov %VEXMode,1:mov %MEMmode_PAGE,%PAGE_NUM:mov %PAGE_NUM,%CGmode_PAGE:goto *CG_MODE

;   [回想モード]
if %0 = PMEMORY mov %VEXMode,2:mov %CGmode_PAGE,%PAGE_NUM:mov %PAGE_NUM,%MEMmode_PAGE:goto *CG_MODE

;   [音楽モード]
;notif %0 = PSOUND goto *CGmode_ToSound
;    if %VEXMode = 1 mov %CGmode_PAGE,%PAGE_NUM
;    if %VEXMode = 2 mov %MEMmode_PAGE,%PAGE_NUM
;    mov %VEXMode,3
;    goto *SOUND_MODE
*CGmode_ToSound

;   ボタンCGNum～%CGBufで、イベント表示処理*VIEWへ飛ぶ
if %0 >= CGNum && %0 <= %CGBuf goto *VIEW

if %0 = PRETURN gosub *config_title:goto *CG_MODE_CHA_SET  ;[タイトルへ戻る]
if %0 = -1  gosub *config_title:goto *CG_MODE_CHA_SET      ;右クリックでも戻る

goto *CGmode_Bwait

;--------------------エクストラモードの表示部分
*VIEW

if %VEXMode=1 goto *CG_VIEW             ;ＣＧの表示
;if %VEXMode=2 goto *MEMORY_VIEW        ;シーンの再生

;--------------------回想モード表示部分
*MEMORY_VIEW

	;プレートの消去
	vsp PCGF,0
	vsp PMEF,0
	vsp PSOF,0

	;回想モードに突入します
	mov %EXFlag,1
	mov %DEMO,1	;テキストウィンドウ表示フラグ

	;音楽を停止する
	bgmstop

	;背景黒
	FADE_OUT 3

	;選択プレート
	;スプライトボタン登録
	;スプライトボタンの初期値設定
	mov %CGBuf,CGNum
	add %CGBuf,PageSumNum

	for %SumSpWork=CGNum to %CGBuf
		vsp %SumSpWork,0
	next

	;システムボタン
	vsp 2,0

	vsp PRETURN,0
	vsp P1P,0
	vsp P2P,0
	vsp P3P,0
	vsp P4P,0
	vsp P5P,0
	vsp PCG,0
	vsp PMEMORY,0
	vsp PSOUND,0
	vsp PBG,0
	print 1

	;数字が０の時は、テキストウィンドウが、エフェクトのときにも出っ放しになります。
	;１がデフォルトで、エフェクトのたびに、ウィンドウを消去します。 
	erasetextwindow 0

	;ウィンドウパーツの読み込み
	gosub *load_windowchip

	;ウィンドウセット
	SetWindowOrg

    ;場所表示
;    mov %PLACE,1

	texton

    notif %train_remi = 1 mov %train_remi,1:goto *remi_exchange
    mov %train_remi,2
*remi_exchange

    mov $CGFileName,$?CG_MODE[%0-CGNum+1][0];ラベル名を取得
    GO_LABEL $CGFileName                    ;Ｈシーンファイルへと飛ぶ

	textoff

	;場所表示
;	mov %PLACE,0

	;回想モード終了
	mov %EXFlag,0
	mov %DEMO,0

	;音楽を停止する
	BGM_STOP

	vsp 2,1
	vsp PRETURN,1
	vsp P1P,1
	vsp P2P,1
	vsp P3P,1
	vsp P4P,1
	vsp P5P,1
	vsp PCG,1
	vsp PMEMORY,1
	vsp PSOUND,1
	vsp PBG,1

	print 1

	;エクストラモード画面
	bgm "BGM\01.wav"


	;選択画面へと戻る
	goto *CG_MODE_CHA_SET

;--------------------イベントCG表示部分
*CG_VIEW

allsphide                               ;一旦全てのスプライトを隠します
mov %200,0
mov $CGFileName,$?CG_MODE[%0-CGNum+1][0];ファイル名を作成
bg $CGFileName,2                        ;ＥＶＣＧを表示する

;--------------------クリック待ち
*VIEW_BTN_WAIT

btnwait2 %150                           ;%150 にボタンの戻り値を入れると指定
if %150 = -1 goto *CG_VIEW_OUT          ;右クリックで脱出

;   差分表示が飛ぶ（ＡからＣなど）場合

*SABUN_CHECK

    inc %200
    mid $200,"abcdefghijkl",%200,1

    mid $325,$CGFileName,0,7
    add $325,$200                       ;差分記号の追加
    add $325,".bmp"

;   走査（差分が存在するなら表示する）
;   二番目の($325)のファイルを表示した事が履歴に残っていれば、$325=$325
;   （三番目の$325）を代入（つまり結果は変わらない）。残っていなければ 
;   $325=$NONOP サムネイル用のフタＣＧを代入する。
;   その後、元々の$325と比較して同じ値ならば、つまり表示した事があるな
;   らば、ジャンプして$325のＣＧを表示する。

    if $325=($325)$325$NONOP goto *SABUNOK
    if %200>11 goto *CG_VIEW_OUT        ;差分 L までチェック
    goto *SABUN_CHECK

*SABUNOK                                ;差分表示
    bg $325,2
    goto *VIEW_BTN_WAIT                 ;さらに差分を調査する

;--------------------カタログ表示画面へ戻る
*CG_VIEW_OUT

    allspresume                         ;allsphideで隠したスプライトを表示します
    bg black,1                          ;背景を黒に戻す
    print 10,300
    goto *CGmode_Bwait

;-----------------------------------------------------------
;--------------------キャラクタページ
*RegPAGE

;参照   %VEXMode……        1.CGモード 2.回想モード
;       %PAGE_NUM,……      ページ番号(1～5)
;       $?CG_MODE[1][0]…… ファイルの有無

    if %PAGE_NUM = 1 spbtn P2P,P2P:spbtn P3P,P3P
    if %PAGE_NUM = 2 spbtn P1P,P1P:spbtn P3P,P3P
    if %PAGE_NUM = 3 spbtn P1P,P1P:spbtn P2P,P2P
;    if %PAGE_NUM = 4 spbtn P1P,P1P:spbtn P2P,P2P:spbtn P3P,P3P:spbtn P5P,P5P
;    if %PAGE_NUM = 5 spbtn P1P,P1P:spbtn P2P,P2P:spbtn P3P,P3P:spbtn P4P,P4P

;   各種基本値挿入
    mov %SumSpWork,CGNum                ;サムネイル番号のスタート位置
    mov %152,SumPosX                    ;カタログ用画像1番(1番左上)のX座標
    mov %153,SumPosY                    ;カタログ用画像1番(1番左上)のY座標
    mov %190,SumWIDE                    ;サムネイルの横幅
    mov %191,SumHEIGHT                  ;サムネイルの縦幅

    for %81=1 to PageSumNum step 1

        if $?CG_MODE[%81][1]="" break   ;該当ファイルの有無のチェック

        mov $SumFileName,$SumPath       ;サムネイルファイル名の作成
        add $SumFileName,$?CG_MODE[%81][1]

;   該当のＣＧ／シナリオが履歴に残っているか確認

        if %VEXMode = 2 goto *RegPAGE_jp1
;                                       ＣＧの確認
        mov $SumFileWork,$?CG_MODE[%81][0]
        notif $SumFileWork=($SumFileWork)$SumFileWork"" mov $SumFileName,$NONOP
        lsp %SumSpWork,$SumFileName,%152,%153
        goto *RegPAGE_jp2

*RegPAGE_jp1                            ;シナリオ（回想）の確認

;   Dummy
;   goto *RegPAGE_jp3

        if lchk $?CG_MODE[%81][0] goto *RegPAGE_jp3
        lsp %SumSpWork,$NONOP,%152,%153 ;回想なし
        goto *RegPAGE_jp2
*RegPAGE_jp3                            ;回想あり
        lsp %SumSpWork,$SumFileName,%152,%153
;       goto *RegPAGE_jp2
*RegPAGE_jp2

        inc %SumSpWork                  ;登録用の%SumSpWorkに1加算

        add %152,%190                   ;Ｘ座標にサムネイルサイズを追加
        if %81=3 mov %152,SumPosX:add %153,%191     ;改行処理
        if %81=6 mov %152,SumPosX:add %153,%191
;        if %81=9 mov %152,SumPosX:add %153,%191

    next

;   スプライトボタン登録
;   スプライトボタンの初期値設定

    mov %CGBuf,CGNum
    add %CGBuf,PageSumNum

    for %SumSpWork=CGNum to %CGBuf
        cellcheckspbtn %SumSpWork,%SumSpWork
    next

return

;--------------------カタログ表示画面を抜ける処理
*SoundModeOut

    csp -1                              ;スプライト定義をクリアする
    btndef ""                           ;ボタン定義をクリア

goto *CG_MODE                           ;ＣＧor回想モードへ

;--------------------
;ページの変更処理
;参照   %0 …… ページ数
;--------------------
*PageChange

    mov %PAGE_NUM,%0

goto *CG_MODE_CHA_SET

;--------------------ＣＧページに移る処理
*PAGE_CG_PAGE
;mov %VEXMode,1
;mov %VCGFlag,1
;mov %PAGE_NUM,1
goto *CG_MODE_CHA_SET			;ページ移行時の設定変更*CG_MODE_CHA_SETへ飛ぶ
;--------------------

;--------------------回想ページに移る処理
*PAGE_MEMORY_PAGE
;mov %VEXMode,2
;mov %VCGFlag,2
;mov %PAGE_NUM,3
goto *CG_MODE_CHA_SET			;ページ移行時の設定変更*CG_MODE_CHA_SETへ飛ぶ
;--------------------

;初期化設定（各ページにおける変数領域を初期化する）
*SETTING_CG_MODE

;   領域初期化を行います
    mov %83,CGModeVal
    mov ?CG_MODE[0][0],CGModeVal

;   文字列変数番号を配列に代入
    for %81=1 to PageSumNum step 1
        for %82=0 to 1 step 1
            inc %83                     ;変数番号をインクリしていく
            mov ?CG_MODE[%81][%82],%83
        next
    next

return

;-----------------------------
;ＣＧモードのキャラデータセッティング

;参照   %VEXMode……        1.CGモード 2.回想モード
;       %PAGE_NUM,……      ページ番号(1～5)
;-----------------------------
*CG_RecordSet

;   共通設定    サムネイルファイルまでのパス
    mov $SumPath,":c/2,0,3;SYS\EXTRA\CG\sum\"

;   ＣＧモード用設定
    if %VEXMode = 1 && %PAGE_NUM = 1 goto *Record_CGmode1
    if %VEXMode = 1 && %PAGE_NUM = 2 goto *Record_CGmode2
    if %VEXMode = 1 && %PAGE_NUM = 3 goto *Record_CGmode3
;    if %VEXMode = 1 && %PAGE_NUM = 4 goto *Record_CGmode4
;    if %VEXMode = 1 && %PAGE_NUM = 5 goto *Record_CGmode5

;   回想モード用設定
    if %VEXMode = 2 && %PAGE_NUM = 1 goto *Record_MEMmode1
    if %VEXMode = 2 && %PAGE_NUM = 2 goto *Record_MEMmode2
    if %VEXMode = 2 && %PAGE_NUM = 3 goto *Record_MEMmode3
;    if %VEXMode = 2 && %PAGE_NUM = 4 goto *Record_MEMmode4
;    if %VEXMode = 2 && %PAGE_NUM = 5 goto *Record_MEMmode5

*CG_RecordRet

return


