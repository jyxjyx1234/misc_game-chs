;-----------------------------------------------------------
;-------------------------------------------------
;スタートファイル
;-------------------------------------------------
;-----------------------------------------------------------
;実行フェイズ
*start

;----------------------
;以下の２行は正式スクリプトにも必要です。
;コンフィグ初期設定
if %c_first=0 gosub *set_default_config_setting

;コンフィグ設定の反映
gosub *config_refrect
;また、ゲームテキストが表示される通常画面モードに移行する前に、
;gosub  *load_windowchipを実行してください。
;このスクリプトでは*GAME_MAINのすぐ下で呼んであります。
;また、texton textoffは同名サブルーチンで書き換えてあります。
;----------------------

setcursor 0,":l/4,160,0;SYS\cursor0.bmp",0,8
setcursor 1,":l/4,160,0;SYS\cursor1.bmp",0,0

;デバック 1ならデバック　0なら通常
mov %DEBUG_SWITCH,0
mov %SKIP_TEXT_DEBUG,0
mov %SKIP_MAP_DEBUG,0

;デバックモードのＯＮ／ＯＦＦ
if %DEBUG_SWITCH = 0 goto *LOGO
if %DEBUG_SWITCH = 1 goto *DEBUG

;デバックモード
*DEBUG
　　　　　　　　　　　
*reset

mov %START_FLAG,0

;オープニング終了
mov %246,1

;右クリック制限
mov %43,0


;goto *TITLE
;goto *config
;goto *SOUND_MODE
;goto *DEBUG_DATA
;goto *EXTRA
;goto *MAIN_GAME


;ブランドロゴ
*LOGO
bg WHITE,2
rnd %67,1
if %67=0 PLAY_SE "voice\sys\vasys0001.ogg"
if %67=1 PLAY_SE "voice\sys\vbsys0001.ogg"
bg "SYS\LOGO.bmp",3
delay 4500
bg WHITE,3


;タイトル画面
*TITLE


;タイトル画面ＢＧＭ
bgm "BGM\06.wav"

;タイトル画面移行後の戻り箇所
*TITLE_RE

;タイトル画面表示
bg "SYS\TITLE\title.bmp",3

;タイトルコール再生
;PLAY_SE "voice\sys\vbsys0002.ogg"
;RND_WAVE 1

btndef "SYS\TITLE\title_r.bmp"
btn 1,570,255,191,54,0,0
btn 2,570,316,191,55,0,61
btn 3,570,382,191,51,0,127
btn 4,570,441,191,54,0,186
btn 5,570,503,191,54,0,248

*MAIN_MENU
btnwait2 %11
if %11=-1 goto *MAIN_MENU
if %11=-2 goto *MAIN_MENU
if %11=-3 goto *MAIN_MENU
if %11=0 goto *MAIN_MENU
if %11=1 PLAY_SE "SE\SYS\X1_08147.wav":goto *MAIN_GAME
if %11=2 PLAY_SE "SE\SYS\X1_08147.wav":gosub *loadgame:goto *TITLE_RE ;コンフィグモードから戻り処理
if %11=3 PLAY_SE "SE\SYS\X1_08147.wav":gosub *config:goto *TITLE_RE ;コンフィグモードから戻り処理
if %11=4 PLAY_SE "SE\SYS\X1_08147.wav":gosub *EXTRA
if %11=5 delay 1800: end

;-----------------------------------------------------------
;ゲームスタート－
*MAIN_GAME

;ＢＧＭストップ
bgmstop

;黒背景
FADE_OUT 3

;-----------------------------
;変数の初期化

;数字が０の時は、テキストウィンドウが、エフェクトのときにも出っ放しになります。
;１がデフォルトで、エフェクトのたびに、ウィンドウを消去します。 
erasetextwindow 0

;ウィンドウ設定
SetWindowOrg

;ゲームスタートフラグ
mov %START_FLAG,1

;オープニング終了
mov %DEMO,1

mov %EXFlag,0

;初期値
mov %210,490

;ウィンドウパーツの読み込み
gosub *load_windowchip


;右クリック制限
mov %43,0

;場所表示を開始する
;mov %PLACE,1
PLACE_OFF
;-------------------------------------------------
;一日の調査
goto *GAME_START

;-------------------------------------------------
;ここで終端\
end


;=================================================
;N_01
;背景；春奈の部屋
;時間；夕方
;人物；春奈、武蔵、みづる
;ＣＧ；なし
;=================================================

*GAME_START

goto *dummystart

*dummystart

;20 キャンディを食べた回数　0～2
;21 中田氏した回数
;22 ジャンプコード

mov %20,0
mov %21,0
mov %22,1
mov %characsel,0

*n01

bgm "BGM\01.wav"

SET_BG "BG01a"
;背景；春奈の部屋

LD_SET "s_mu01a",2
[【武蔵】]
「ごめん！　オレ、実はロリコンなんだ」\
NAME_OFF

LD_SET "s_ha04a",2
CHA_V 1,"voice\haruna\va0070.ogg"
[【春奈】]
「ろ、ろり……こん……？」\
NAME_OFF

大好きな従兄のおにいちゃんにありったけの勇気を振り絞って告白した、その返事がこの言葉だった。\

恥ずかしさを隠すように、照れ笑いを浮かべながら自分に向けられたその言葉の意味を、春奈はすぐに理解する事が出来ずにすっと部屋の天井に目を向ける。\

そして、大慌てで頭の中の本棚から辞書を引っ張り出した。\

LD_SET "s_ha07a",2
CHA_V 1,"voice\haruna\va0071.ogg"
[【春奈】]
（ロリコン……って……あの？　たしか……ちっちゃな女の子が好きだって事……だよね……）\
NAME_OFF

考えただけのつもりが、つい言葉に出てしまう。それは春奈の癖だったが、今も自然と呟いてしまっていたようだった。\

CL_LD

それを聞きとめた武蔵が、春奈の言葉に答えるように口を開く。\

LD_SET "s_mu06a",2
[【武蔵】]
「そうなんだよ。こんな事他の誰にも言えないけどな。オレはちっちゃな女の子が大好きなんだ」\
NAME_OFF

LD_SET "s_mu02a",2
[【武蔵】]
「オレの理想は……ほら、春奈も知ってるだろ？『まじかる★ちぇんじひなたちゃん』のヒロインの日向ちゃんなんだよね」\
NAME_OFF

LD_SET "s_mu02a",2
[【武蔵】]
「ちっちゃくて、可愛くて元気があってさ」\
NAME_OFF

LD_SET "s_mu01a",2
[【武蔵】]
「そのうえ、どんな困難にも立ち向かう勇気も併せ持ってるなんて、思わず抱きしめたくなるだろ？　守ってあげたくなるじゃないか！」\
NAME_OFF

LD_SET "s_ha04a",2
CHA_V 1,"voice\haruna\va0072.ogg"
[【春奈】]
「そ、そんな事言われても……」\
NAME_OFF

CL_LD

bg BLACK,3
SET_BG "BG07a"

武蔵の言う『まじかる★ちぇんじひなたちゃん』は春奈も知っていた。魔法の力で変身し、色々な事件を解決していく子供向けのアニメだ。\

子供だけじゃなく一部の大人にも人気があって、シリーズ化して何年も放映されてるはずだ。\

bg BLACK,3

まさか、武蔵おにいちゃんがそんな大人の一人だったとは、一緒に暮らして何年も経つのに全く思いもよらなかった……。\

SET_BG "BG01a"
;背景；春奈の部屋

──なんて事はない。\

武蔵の部屋に遊びに行ったときに、そういう小さな女の子がエッチな事をしてるような漫画本が落ちてるのを見たことがあるし、\

武蔵が日向ちゃんのようなアニメをよく観ていた事は知っていた。\

だから、もしかしたらという思いは春奈にもあったのだが、こうして面と向かって言われるのはかなりショックだった。\

しかも、自分の告白に対する答え、という最悪の形で……。\

LD_SET "s_mu01a",2
[【武蔵】]
「だからさ、春奈はオレの守備範囲をはるかに超えちゃってるんだよね。悪いけど、付き合うとかそういう事は出来ないよ」\
NAME_OFF

CL_LD

LD_SET "s_ha04a",2

PLAY_SE "SE\SE62.wav"
EF_QUAKEY 3,400
bg BLACK,3
CL_LD

春奈の頭を金槌で殴られたような衝撃が走り抜けていく。\

なんだか目の前が真っ暗になって、目の前に居るはずの武蔵おにいちゃんの姿と、その口から発せられる言葉がひどく遠く感じる。\

告白しても武蔵おにいちゃんが応えてくれるとは限らない。\

好きな人が居るかもしれないし、自分の事を女として見てもらえていないかもしれない、そういう覚悟なら出来ていた。\

SET_BG "BG01a"
;背景；春奈の部屋

LD_SET "s_ha06a",2
CHA_V 1,"voice\haruna\va0073.ogg"
[【春奈】]
（で……でも……それにしてもこんなのあんまりだよ……ひどすぎるよ……おにいちゃんの好きな子がアニメのキャラクターだなんて……）\
NAME_OFF

アニメのキャラより魅力がない。そう言われたような気がして春奈は惨めな気分に落ち込んでいった。\

なんだか悔しくて、そんな風に思っているうちに頬を熱いものが伝わってきて、自分が泣いている事に気がついた。\

LD_SET "s_mu04a",2
[【武蔵】]
「いや、春奈……あ、ああ、その……ゴメン……お願いだから泣かないでくれよ……え、ええと……とにかくゴメン！！」\
NAME_OFF

CL_LD

泣き出した春奈を見て、武蔵が驚き、オロオロとし始める。そして唐突に春奈の頭に手をおき、ゆっくりと撫で始める。\

春奈はこの武蔵の優しい手が、本当に好きだった。昔から泣くたびにこうやって慰めてもらったのだが、今は心が軽くなる事はない。\

むしろ惨めな気持ちが大きく広がって行くだけだった。\

LD_SET "s_mu02a",2
[【武蔵】]
「その……なんだ……春奈の気持ちは嬉しいけど……オレには春奈は勿体無いって……な？　ほら、だってロリコンなんだぜ？」\
NAME_OFF

