;セーブデータ情報を表示する
*saveload_printdata
	savefileexist %w10,%w4
	if %w10=0 return
	;%w2 %w3は、それぞれのセーブ枠の左上座標です。
	mov $w0,":c;savesum\"
	itoa $w1,%w4
	add $w0,$w1
	add $w0,".bmp"
	lsp %w5+3,$w0,%w2+108,%w3+0	;サムネイル表示
	mov %w6,%w4*3+900				;ロードするグローバル変数番号

	;これはテキストです。
	lsp %w5,$%w6,%w2,%w3+25;残り日数表示
	inc %w6
	lsp %w5+1,$%w6,%w2,%w3+43;金額表示
	inc %w6
	lsp %w5+2,$%w6,%w2-9,%w3+95;日付表示
return

*saveload_setdata
	;ここで文字列スプライトとして大きさを指定しています。
	mov %w4,%w3*3+900;セーブするグローバル変数番号

	mov $%w4,":s/18,18,0;#FFFFFF"
	gosub *saveload_setdata_sub3;残り日数を全角変換
	add $%w4,$w0
	inc %w4
	;金額部分だけ文字サイズを縮小
	mov $%w4,":s/18,18,0;#FFFFFF"
	gosub *saveload_setdata_sub1;現在金額を全角変換
	add $%w4,$w0
	inc %w4
	mov $%w4,":s/15,15,0;#FFFFFF"
	gosub *saveload_setdata_sub2;現在日時を全角変換
	add $%w4,$w0
return
