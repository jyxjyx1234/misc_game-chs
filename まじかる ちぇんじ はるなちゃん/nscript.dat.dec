*saveload_setdata_sub1
mov $w0,$Scene		;セーブデータ
mov %ws0,100000000;一千万円の位まで
mov %ws1,%1
*saveload_setdata_sub1_lp
if %ws0=1 goto *saveload_setdata_sub1_lp2
if %ws1/%ws0=0 div %ws0,10:goto *saveload_setdata_sub1_lp
*saveload_setdata_sub1_lp2
mov %ws2,%ws1/%ws0
if %ws2=0 add $w0,""
if %ws2=1 add $w0,""
if %ws2=2 add $w0,""
if %ws2=3 add $w0,""
if %ws2=4 add $w0,""
if %ws2=5 add $w0,""
if %ws2=6 add $w0,""
if %ws2=7 add $w0,""
if %ws2=8 add $w0,""
if %ws2=9 add $w0,""
mov %ws1,%ws1 mod %ws0
div %ws0,10
if %ws0<1 add $w0,"":return
goto *saveload_setdata_sub1_lp2

