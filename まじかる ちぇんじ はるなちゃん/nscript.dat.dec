	*saveload_btnst
	gosub *saveload_btndef
	print 1

	*saveload_btnloop
	btnwait2 %w3
	if %w3=-1 goto *saveload_end
	if %w3<0  goto *saveload_btnloop
	if %w3=10 PLAY_SE "SE\SYS\SYS_OK.wav":goto *saveload_save
	if %w3=11 PLAY_SE "SE\SYS\SYS_OK.wav":goto *saveload_load
	if %w3=12 PLAY_SE "SE\SYS\SYS_OK.wav":goto *config
	if %w3=13 PLAY_SE "SE\SYS\SYS_OK.wav":goto *config_title
	if %w3>=1 && %w3<=9 PLAY_SE "SE\SYS\SYS_OK.wav":mov %w1,%w3:goto *saveload_pagest
	if %w3=0  goto *saveload_btnloop
	;コンフィグボタン追加
	;if %w3=300 gosub *config:goto *loadgame

	;上書き処理
	mov %w3,%w3-21+%w1*6-6
	if %w0=0 goto *saveload_saveexec
	if %w0=1 goto *saveload_loadexec
goto *saveload_btnloop

