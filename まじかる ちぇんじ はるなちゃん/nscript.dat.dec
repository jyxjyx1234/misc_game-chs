;セーブロード
*saveload

    textoff
;	btndef "SYS\saveload\btn.bmp"

	;初期化
	for %w1=0 to 100
        if %w1 == 49 : next
        csp %w1:next

	mov %w1,1;ページNo 1～9
	mov %w2,-1;どれも選んでいない
	if %ResetFlag= 1 lsp 100,":c;SYS\saveload\saveload_save.bmp",0,0:lsp 98,":c;SYS\config\saveon.bmp",636,94;セーブ
	if %ResetFlag= 2 lsp 100,":c;SYS\saveload\saveload_load.bmp",0,0:lsp 98,":c;SYS\config\loadon.bmp",636,134;ロード

