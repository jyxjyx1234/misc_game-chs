*saveload_save_nofile
savegame %w3
mov $w0,"savesum\"
itoa $w1,%w3
add $w0,$w1
add $w0,".bmp"
savescreenshot2 $w0
gosub *saveload_setdata
goto *saveload_pagest

*saveload_loadexec
