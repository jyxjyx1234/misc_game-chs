textoff

bgm "BGM\06.wav"            ;音楽開始

delay 5000                      ;２秒ウェイト

BG "SYS\ending\ed01.bmp",3              ;ＣＧ表示

delay 7000                      ;２秒ウェイト

BG "SYS\ending\ed02.bmp",3              ;ＣＧ表示

delay 7000                      ;２秒ウェイト

BG "SYS\ending\ed03.bmp",3              ;ＣＧ表示

delay 7000                      ;２秒ウェイト

BG "SYS\ending\ed04.bmp",3              ;ＣＧ表示

delay 7000                      ;２秒ウェイト

BG "SYS\ending\ed05.bmp",3              ;ＣＧ表示

delay 7000                      ;２秒ウェイト

BG "SYS\ending\ed06.bmp",3              ;ＣＧ表示

delay 7000                      ;２秒ウェイト

BG "SYS\ending\ed07.bmp",3              ;ＣＧ表示

delay 10000                      ;２秒ウェイト

BG BLACK,4
bgmstop
