;オーバーライドした関数
;テキストオン
*texton
	vsp WindowButton,1
	vsp TextWindow2,1
	vsp TextCursor,1
	vsp FACE,1
        vsp NAMETAG,1
	PLACE_ON
	;DAY_ON
	print 1
	_texton
return

;テキストオフ
*textoff
	vsp WindowButton,0
	vsp TextWindow2,0
	vsp TextCursor,0
	vsp FACE,0
        vsp NAMETAG,0
	PLACE_OFF
	;DAY_OFF
	print 1
	_textoff
return

