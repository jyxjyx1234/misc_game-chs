//---------------------------------------------------------------------------------
//	セットアップ設定ファイルです	// コメント
//
//	インストールモデルの説明
//	MINI		EXEとREADME.TXTをコピーします
//	NORMAL		MINI+A98SYS.PAK,STREAM.PAKをコピーします
//	MAX		NORMAL+VOICE.PAK,VOICE2.PAK,*.MID,*.HLPをコピーします
//
//	OPTメニューが無い場合は、OPTMENU_TAG,OPTMENU_HELPを削除してください
//---------------------------------------------------------------------------------
APPNAME		ねがぽじ|～お兄ちゃんと呼ばないでっ！！～	// インストールするプログラム名
TITLEBAR	ねがぽじ|セットアップ				// プログラムタイトルバー
HELPNAME	NEGAPOSI.HLP					// ヘルプファイル名

INIFILE		ACTIVEJP.INI					// .iniファイル名
INISECTION	NEGAPOSI					// セクション名

FORCEINST	0						// 強制的にインストールするか？

INSTTO		NEGAPOSI					// インストール先フォルダ
EXENAME		NEGAPOSI.EXE					// インストール後名称

README		README.TXT					// 起動後の注意

INSTMINI	1						// 最少有り？
INSTNORMAL	1						// 標準有り？
INSTMAX		1						// 最大有り？
INSTDEF		2						// デフォルトモデル0:Min<-->2:Max

FONT		0						// ゲーム起動時のデフォルトフォント


STREAMISFULL	0						// STREAM.PAKを標準モデルで
								// 0:インストールする 1:しない

INSTDX		0						// DirectXをインストールしますか？
DXSETUPFILE	directx8a\dxsetup.exe				// DirectXのインストーラファイル

NEEDMINI	10						// 最少時必要容量
NEEDNORMAL	100						// 通常時必要容量
NEEDMAX		350						// 最大時必要容量

// INSTMINI10	最低限必要なファイルのみをＨＤＤへ転送します。
// INSTMINI2	ＨＤＤ容量に余裕の無い場合に選択してください。
// INSTNORMAL1	標準的なファイルをＨＤＤへ転送します。
// INSTNORMAL2	通常はここを選択してください。
// INSTMAX1	全ファイルをＨＤＤへ転送します。ＢＧＭに付属の音楽ＣＤを使用でき、
// INSTMAX2	また、CD-ROMが無くても動作します。最も高速です。		// インストール説明

INSTMINI1	最低限必要なファイルのみをＨＤＤへ転送します。実行にはＤＶＤが必要
INSTMINI2	ＨＤＤ容量に余裕の無い場合にのみ選択してください。
INSTNORMAL1	音声ファイルをＤＶＤから読み出すため、
INSTNORMAL2	実行にはＤＶＤが必要です。
INSTMAX1	全ファイルをＨＤＤへ転送します。
INSTMAX2	また、ＤＶＤが無くても動作します。最も高速です。

// INFOHELP	ソフトカタログやヘルプ、他のゲームの体験版など	// INFOのヘルプ
INFOHELP	追加情報を見ることができます

// OPT1TAG		アクティブホームページ
// OPT1HELP	ＣＤ上のアクティブホームページを見ます。
// OPT1FILE	index.htm					// オプション

// OPT2TAG		アクティブLineUp
// OPT2HELP	アクティブのソフトカタログを開きます。
// OPT2FILE	INFO\LINEUP.HTM					// オプション

// OPTMENU_TAG	他のゲームの体験版実行

// OPTMENU_HELP	アクティブの他のゲームの体験版を実行します	// OPTメニュータイトル

// OM1TAG		麻雀幻想曲Ⅱ-2001Edition-|
// OM1HELP		「麻雀幻想曲Ⅱ-2001Edition-」の体験版を実行。
// OM1FOLDER	_omake\demos\mf2_2001
// OM1CMD		mf2_2001.exe					// OPTメニュー１

// OM2TAG		ＢｉｂｌｅＢｌａｃｋ
// OM2HELP		「ＢｉｂｌｅＢｌａｃｋ」の体験版/デモ版を実行。
// OM2FOLDER	_omake\demos\bblack
// OM2CMD		bblack.exe					// OPTメニュー１

// OM3TAG		ＨｅｌｌｏＡｇａｉｎ
// OM3HELP		「ＨｅｌｌｏＡｇａｉｎ」の体験版を実行。
// OM3FOLDER	_omake\demos\again
// OM3CMD		again.exe					// OPTメニュー１

// OM4TAG		ぎりぎりでぃと
// OM4HELP		「ぎりぎりでぃと」の体験版を実行。
// OM4FOLDER	_omake\demos\girigiri
// OM4CMD		girigiri.exe					// OPTメニュー１

// OM5TAG		スタ★グラ
// OM5HELP		「スタ★グラ」の体験版を実行。
// OM5FOLDER	_omake\demos\stagra
// OM5CMD		stagra.exe					// OPTメニュー１

// OM6TAG		ＨＥＡＲＴＷＯＲＫ
// OM6HELP		「ＨＥＡＲＴＷＯＲＫ」の体験版を実行。
// OM6FOLDER	_omake\demos\Hw_demo
// OM6CMD		HW_demo.exe					// OPTメニュー3

// OM7TAG		麻雀幻想曲Ⅲ
// OM7HELP		「麻雀幻想曲Ⅲ」の体験版を実行。
// OM7FOLDER	_omake\demos\WMAGEN3
// OM7CMD		Wmagen3.exe					// OPTメニュー7個目
