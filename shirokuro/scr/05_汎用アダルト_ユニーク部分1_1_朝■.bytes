return function()

-- レイヤー初期化
alldel()
fadeBgm(1)


-- sample_image
playBgm("11-Walk.ogg")

capture()
set(BG, "view_004.png")
sets(BG,1,1)
set_gblur(BG,0)
fade(0.8)

-- message_window_open
winopen(0.5)


--背景：主人公の部屋（昼）
::block_00001::
cls1()
setname("透")
text("「さて、どうしたもんかな」")


::block_00002::
cls1()
noname()
text("かなり早めの朝食を済ませて、ちょっと考える。")


::block_00003::
cls1()
noname()
text("黒とまっすぐに駅に向かうべきか。")


::block_00004::
cls1()
noname()
text("それとも、例の発作が出る可能性を減らすため、\n黒とセックスをしておくべきか。")


::block_00005::
cls1()
noname()
text("ちなみに。\n『そういうこと』があっても大丈夫なように、\n黒との待ち合わせ時間は早めに設定してある。")


::block_00006::
cls1()
noname()
text("もちろん、黒と話しあった上で決めたことだ。")


::block_00007::
cls1()
noname()
text("昨日こそセックスせずに学校に行けたけど、\n夏休み中の電車チャレンジの際は、\nほぼ毎回セックスしてから家を出ていた。")


::block_00008::
cls1()
noname()
text("黒の症状を抑えるにはそれが一番効果的で、\n他の手段は見つかっていないのが実情だ。")


::block_00009::
cls1()
noname()
text("だから、とりあえず時間に余裕を持たせて、\n緊急の事態に対処できるようにしたわけだ。")


::block_00010::
cls1()
noname()
text("俺の朝が早くなることに対して、\n黒は申し訳なさそうにしていたが、\nそこは「気にすんなよ」で、押し通した。")


::block_00011::
cls1()
setname("透")
text("「自分から頼って来たくせに、\n申し訳なさそうな顔するんだよなあ」")


::block_00012::
cls1()
setname("透")
text("「……ま、それも黒らしいか」")


::block_00013::
cls1()
noname()
text("そんなことを思いながら、俺は玄関を後にした。")

fadeBgm(1)

winclose(0.5)
capture()
set(EF,"black.png")
fade(1)
wait(1)


--移動箇所選択画面へ
::block_00014::
-- ▽末端:スクリプト追加


-- message_window_close
--winclose(0.5)


-- 次ファイルへ移動
goscript("05_汎用アダルト_ユニーク部分_1朝_マップ移動■.lua")


-- 終了
end


