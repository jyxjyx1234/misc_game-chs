capture()
set(BG, "view_004.png")
sets(BG,1,1)
set_gblur(BG,0)
fade(0.8)


-- message_window_open
winopen(0.5)

--◆マスクフェード+シェイク使用予定

--朝_共通シナリオ_4回目
--背景：主人公の部屋（昼）
::block_00001::
cls1()
setname("透")
text("「しまった！　寝過ごした！」")

winclose(0.1)
capture()
set(BG, "view_001.png")
sets(BG,1,1)
set_gblur(BG,0)
fade(0.5)

::block_00002::
cls1()
noname()
text("朝食も取らずに、いつもより５分遅れて家を出る。")


::block_00003::
cls1()
noname()
text("もちろん、黒のことがあるから、\n毎日時間に余裕は持っている。")


::block_00004::
cls1()
noname()
text("だから、普通に通学する分には、\n特に慌てることはない時間だ。")


::block_00005::
cls1()
noname()
text("でも、黒に症状が出てしまっている場合には、\nそれを抑えないといけない。")


::block_00006::
cls1()
noname()
text("そこまで考えると、\n５分というのも馬鹿に出来ない時間だ。")


::block_00007::
cls1()
setname("透")
text("「明日からは、ちゃんとしないとな……」")


::block_00008::
cls1()
noname()
text("そう思いながら、俺は黒のところに向かうのだった。")

fadeBgm(1)

winclose(0.5)
capture()
set(EF,"black.png")
fade(1)
wait(1)

