::block_00179::
-- 選択肢://選択肢３
item={}
item[1]="素股"
item[2]="膣内挿入"
item[3]="ソープごっこ"
item[4]="ハメ撮り"
sel("",item)
-- 選択結果
ret=get_sel_result()
-- インモ値追加
InmoSiro = InmoSiro + getInmo('I',3,item[ret])
-- 選択肢分岐
if ret==1 then goto block_00179A end
if ret==2 then goto block_00376A end
if ret==3 then goto block_00457A end
if ret==4 then goto block_00523A end


