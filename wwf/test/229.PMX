SetSfc 0,|エフェクト OFF;DrawEffect = 0,1,GRPName,0,0,1,255,1,0,0,0
SetSfc 0,エフェクト ON;DrawEffect = 2,1,GRPName,0,0,1,255,3,0,0,0
SetSfc 0,エフェクト ON;DrawEffect = 20,1,GRPName,0,0,1,255,21,0,0,0
SetSfc 0,エフェクト ON;DrawEffect = 25,1,GRPName,0,0,1,255,26,0,0,0
SetSfc 0,エフェクト ON;DrawEffect = 26,1,GRPName,0,0,1,255,27,0,0,0
SetSfc 0,エフェクト ON;DrawEffect = 29,1,GRPName,0,0,1,255,30,0,0,0
Calc 2,,DrawEffect = -2
