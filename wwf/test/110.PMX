NonStop=0
Calc 2,,NOWSCENARIO = @NowPage
Calc 2,,READTEXT = 0
Load 0,,RTM+NOWSCENARIO,READSKIP,0
Load 0,,RTM+NOWSCENARIO,READTEXTMAX,0
TextCol 0,READTEXTMAX > READTEXT;既読色 ON,12615776
TextCol 0,|READTEXTMAX <= READTEXT;既読色 OFF,16777215
Calc 2,,CHARNAME = CE01AA
Call 0,,66,,-1
Calc 2,,DLG = ON
PutText 0,,[静　麻]\n「首先是宿舍」
Calc 2,,CHARNAME = CE06A
Call 0,,66,,-1
Calc 2,,DLG = ON
PutText 0,,[輒　山]\n「訶鞜墾緯是初轅顱鑵的基本原阯」
Calc 2,,CHARNAME = CE04AA
Call 0,,66,,-1
Calc 2,,DLG = ON
WavPlay 0,@Vol2 > 0,1,VO\MK\MK145.WAV,0,0,0
PutText 0,,[米可米可]\n「我喜銛芹菜」
Calc 2,,CHARNAME = CE05BD
Call 0,,66,,-1
Calc 2,,DLG = ON
WavPlay 0,@Vol2 > 0,1,VO\RI\RI267.WAV,0,0,0
PutText 0,,[梨　花]\n「我不喜銛鍠」
Calc 2,,CHARNAME = CE01AA
Call 0,,66,,-1
Calc 2,,DLG = ON
PutText 0,,[静　麻]\n「……銕之，去所鑁的宿舍諦」
