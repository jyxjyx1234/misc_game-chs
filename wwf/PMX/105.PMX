NonStop=0
Calc 2,,@SfcX+num = @SfcX+num - 3
Calc 2,,@SfcY+num = @SfcY+num - 7
Wait 0,,1
Calc 2,,@SfcX+num = @SfcX+num - 7
Calc 2,,@SfcY+num = @SfcY+num - 3
Wait 0,,1
Calc 2,,@SfcX+num = @SfcX+num - 7
Calc 2,,@SfcY+num = @SfcY+num + 3
Wait 0,,1
Calc 2,,@SfcX+num = @SfcX+num - 3
Calc 2,,@SfcY+num = @SfcY+num + 7
Wait 0,,1
Return 0,
