NonStop=0
Calc 2,,CHECK2_B = ON
Calc 2,,NOWSCENARIO = @NowPage
Calc 2,,READTEXT = 0
Load 0,,RTM+NOWSCENARIO,READSKIP,0
Load 0,,RTM+NOWSCENARIO,READTEXTMAX,0
TextCol 0,READTEXTMAX > READTEXT;既読色 ON,12615776
TextCol 0,|READTEXTMAX <= READTEXT;既読色 OFF,16777215
Calc 2,,CHARNAME = CE01AA
Call 0,,66,,-1
Calc 2,,DLG = ON
PutText 0,,[静　麻]\n「ここはひとつ、学園のいちばん偉い人間に話を通してみては」
Calc 2,,CHARNAME = CE06A
Call 0,,66,,-1
Calc 2,,DLG = ON
PutText 0,,[遠　山]\n「わかりました、すると校長か理事長ですね」
Calc 2,,CHARNAME = CE02A
Call 0,,66,,-1
Calc 2,,DLG = ON
PutText 0,,[夏　来]\n「だろうね」
Calc 2,,CHARNAME = CE06A
Call 0,,66,,-1
Calc 2,,DLG = ON
PutText 0,,[遠　山]\n「少々お待ち下さい」
Calc 2,,CHARNAME = 
Call 0,,66,,-1
PutText 0,,遠山は、校舎へと駆けて行った。
Wait 0,エフェクト ON,1000
PutText 0,,暫くして駆け戻ってくる。
Calc 2,,CHARNAME = CE06C
Call 0,,66,,-1
Calc 2,,DLG = ON
PutText 0,,[遠　山]\n「駄目でした」
Calc 2,,CHARNAME = CE01AA
Call 0,,66,,-1
Calc 2,,DLG = ON
PutText 0,,[静　麻]\n「何が？」
Calc 2,,CHARNAME = CE06C
Call 0,,66,,-1
Calc 2,,DLG = ON
PutText 0,,[遠　山]\n「校長も理事長いずれも不在でした」
Calc 2,,CHARNAME = CE02A
Call 0,,66,,-1
Calc 2,,DLG = ON
PutText 0,,[夏　来]\n「すると別の手を考えないといけない」
Calc 2,,CHARNAME = 
Call 0,,66,,-1
Save 0,,RT+NOWSCENARIO,READTEXT
Save 0,,RTM+NOWSCENARIO,READTEXT
Jump 0,,113,,-1
