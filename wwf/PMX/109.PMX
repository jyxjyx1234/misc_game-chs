NonStop=0
Calc 2,,NOWSCENARIO = @NowPage
Calc 2,,READTEXT = 0
Load 0,,RTM+NOWSCENARIO,READSKIP,0
Load 0,,RTM+NOWSCENARIO,READTEXTMAX,0
TextCol 0,READTEXTMAX > READTEXT;既読色 ON,12615776
TextCol 0,|READTEXTMAX <= READTEXT;既読色 OFF,16777215
Calc 2,,CHARNAME = CE01AA
Call 0,,66,,-1
Calc 2,,DLG = ON
PutText 0,,[静　麻]\n「校舎に行ってみるか？」
Calc 2,,CHARNAME = CE05BE
Call 0,,66,,-1
Calc 2,,DLG = ON
WavPlay 0,@Vol2 > 0,1,VO\RI\RI265.WAV,0,0,0
PutText 0,,[梨　花]\n「あんた、楓は寄宿舎から浚われたんでしょう、そこを調べないでどうするのよ」
Calc 2,,CHARNAME = CE01AA
Call 0,,66,,-1
Calc 2,,DLG = ON
PutText 0,,[静　麻]\n「うーん、どうしようもないな」
Calc 2,,CHARNAME = CE05BA
Call 0,,66,,-1
Calc 2,,DLG = ON
WavPlay 0,@Vol2 > 0,1,VO\RI\RI266.WAV,0,0,0
PutText 0,,[梨　花]\n「寄宿舎に行き先を変更！」
Calc 2,,CHARNAME = 
Call 0,,66,,-1
Save 0,,RT+NOWSCENARIO,READTEXT
Save 0,,RTM+NOWSCENARIO,READTEXT
Jump 0,,112,,-1
