NonStop=0
Calc 2,,NOWSCENARIO = @NowPage
Calc 2,,READTEXT = 0
Load 0,,RTM+NOWSCENARIO,READSKIP,0
Load 0,,RTM+NOWSCENARIO,READTEXTMAX,0
TextCol 0,READTEXTMAX > READTEXT;既読色 ON,12615776
TextCol 0,|READTEXTMAX <= READTEXT;既読色 OFF,16777215
Calc 2,,CHARNAME = CE01AA
Call 0,,66,,-1
Calc 2,,DLG = ON
PutText 0,,[静　麻]\n「まずは寄宿舎だな」
Calc 2,,CHARNAME = CE06A
Call 0,,66,,-1
Calc 2,,DLG = ON
PutText 0,,[遠　山]\n「現場を確認するのが初動捜査のセオリーですからね」
Calc 2,,CHARNAME = CE04AA
Call 0,,66,,-1
Calc 2,,DLG = ON
WavPlay 0,@Vol2 > 0,1,VO\MK\MK145.WAV,0,0,0
PutText 0,,[ミコミコ]\n「セロリは好きだよ」
Calc 2,,CHARNAME = CE05BD
Call 0,,66,,-1
Calc 2,,DLG = ON
WavPlay 0,@Vol2 > 0,1,VO\RI\RI267.WAV,0,0,0
PutText 0,,[梨　花]\n「あたしは苦手～」
Calc 2,,CHARNAME = CE01AA
Call 0,,66,,-1
Calc 2,,DLG = ON
PutText 0,,[静　麻]\n「……とにかく、寄宿舎とやらに行くぞ」
Calc 2,,CHARNAME = 
Call 0,,66,,-1
Save 0,,RT+NOWSCENARIO,READTEXT
Save 0,,RTM+NOWSCENARIO,READTEXT
Jump 0,,112,,-1
