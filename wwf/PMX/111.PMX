NonStop=0
Calc 2,,NOWSCENARIO = @NowPage
Calc 2,,READTEXT = 0
Load 0,,RTM+NOWSCENARIO,READSKIP,0
Load 0,,RTM+NOWSCENARIO,READTEXTMAX,0
TextCol 0,READTEXTMAX > READTEXT;既読色 ON,12615776
TextCol 0,|READTEXTMAX <= READTEXT;既読色 OFF,16777215
Calc 2,,CHARNAME = CE01AA
Call 0,,66,,-1
Calc 2,,DLG = ON
PutText 0,,[静　麻]\n「校庭に行ってみるか」
Calc 2,,CHARNAME = CE05BE
Call 0,,66,,-1
Calc 2,,DLG = ON
WavPlay 0,@Vol2 > 0,1,VO\RI\RI268.WAV,0,0,0
PutText 0,,[梨　花]\n「校庭に行ってどうするの？」
Calc 2,,CHARNAME = CE01AB
Call 0,,66,,-1
Calc 2,,DLG = ON
PutText 0,,[静　麻]\n「どんなものか、一度見てみたいと思っただけだ」
Calc 2,,CHARNAME = CE05BE
Call 0,,66,,-1
Calc 2,,DLG = ON
WavPlay 0,@Vol2 > 0,1,VO\RI\RI269.WAV,0,0,0
PutText 0,,[梨　花]\n「あんたね、一体何しに来たの？」
Calc 2,,CHARNAME = CE01AA
Call 0,,66,,-1
Calc 2,,DLG = ON
PutText 0,,[静　麻]\n「カフェの女給に言われたくない」
Calc 2,,CHARNAME = CE05BE
Call 0,,66,,-1
Calc 2,,DLG = ON
WavPlay 0,@Vol2 > 0,1,VO\RI\RI270.WAV,0,0,0
PutText 0,,[梨　花]\n「なんですって！」
Calc 2,,CHARNAME = CE06A
Call 0,,66,,-1
Calc 2,,DLG = ON
PutText 0,,[遠　山]\n「まあまあ、まずは寄宿舎の現場を確認しましょう」
Calc 2,,DLG = ON
PutText 0,,[遠　山]\n「自由行動は、それからですね」
