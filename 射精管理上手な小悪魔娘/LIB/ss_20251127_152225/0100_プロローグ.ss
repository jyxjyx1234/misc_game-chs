#MACRO	@sokubaku_article(@obj(40),@order(<order_chr_sub>))

			back.object[@obj].create(sokubaku,1,959,539,13)
			back.object[@obj].order = @order
			back.object[@obj].child.resize(20)
			back.object[@obj].child[0].create(sokubaku,1,0,70,10)
			back.object[@obj].child[1].create(sokubaku,1,0,-70,11)
			back.object[@obj].child[2].create(sokubaku,1,0,0,12)
            back.object[@obj].child[2].tr = 0

			back.object[@obj].child[10].create(sokubaku,1,0,0,0)
			back.object[@obj].child[11].create(sokubaku,1,0,0,1)
			back.object[@obj].child[12].create(sokubaku,1,0,0,2)
			back.object[@obj].child[13].create(sokubaku,1,0,0,3)
			back.object[@obj].child[14].create(sokubaku,1,0,0,4)
            
            back.object[@obj].child[10].tr = 0
            back.object[@obj].child[11].tr = 0
            back.object[@obj].child[12].tr = 0
            back.object[@obj].child[13].tr = 0
            back.object[@obj].child[14].tr = 0

            back.object[@obj].child[10].bright = 255
            back.object[@obj].child[11].bright = 255
            back.object[@obj].child[12].bright = 255
            back.object[@obj].child[13].bright = 255
            back.object[@obj].child[14].bright = 255

            wipe(0,500,start_order = @order,end_order = @order)

            front.object[@obj].child[0].y_eve.set(0,500,0,2)
            front.object[@obj].child[1].y_eve.set(0,500,0,2)
            front.object[@obj].child[1].y_eve.wait

#MACRO  @sokubaku_article_0(@obj(40),@order(<order_chr_sub>))

            front.object[@obj].child[2].tr_eve.set(255,500,0,2)
            front.object[@obj].child[2].tr_eve.wait_key

#MACRO  @sokubaku_article_tag(@num,@obj(40),@order(<order_chr_sub>))

            front.object[@obj].child[10 + @num - 1].tr_eve.set(255,500,0,2)
            front.object[@obj].child[10 + @num - 1].bright_eve.set(0,500,500,2)

            front.object[@obj].child[10 + @num - 1].bright_eve.wait_key


#INC_END


