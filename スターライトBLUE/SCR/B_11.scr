#○◎(Ｈシーン終了)
#Ｈシーン回想ルーチン
global(%hs10, 1)
^if( %H_MODE_FLAG == 1 )
	^ret
^endi




#//暗転
mono(-1)	#セピア終了
#ホワイトアウト
wout
chon(19, "white", CENTER)
ud(0)


wndoff
ud(0)
bgmoff(0, 700)		# ＢＧＭ終了
bgmon("bgm02")		# ＢＧＭ再生


choff(19)
#回想、ここまでで終了。
#//背景：事務所（夜）
bgon("bg003ca1")
ud(1, 500)




#//立ち絵：凛私服・悲しみ
chon(13, "ta01bac1", 640, 0)	#立ちＣＧ表示（凛）
ud(1, 200)


