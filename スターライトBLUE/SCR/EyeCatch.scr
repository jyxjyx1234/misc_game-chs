# %ic_prm   アイキャッチ用パラメータ 0:三人称　1:主人公　2:凛　3:遠矢　4:凛（微笑み）
# ch は 5 番を使用。


::START


#choff(18)
#ud(0)





# クロスフェード
# ロード
^sw(%ic_prm)
	^case(0)	#アイキャッチ　共通１（三人称視点）
		chon(20, "ic_00a02", CENTER )
		ud(2, "mask111", 1500)	#視点切り替え

	^case(1)	#アイキャッチ　主人公
		chon(20, "ic_00a02", CENTER )
		ud(2, "mask111", 1500)	#視点切り替え

	^case(2)	#アイキャッチ　凛
		chon(20, "ic_00a03", CENTER )
		ud(2, "mask111", 1500)	#視点切り替え

	^case(3)	#アイキャッチ　遠矢
		chon(20, "ic_00a04", CENTER )
		ud(2, "mask111", 1500)	#視点切り替え

	^case(4)	#アイキャッチ　凛（微笑み）
		chon(20, "ic_00a01", CENTER )
		ud(2, "mask111", 1500)	#視点切り替え

	^df
		chon(20, "ic_00a02", CENTER )
		ud(2, "mask111", 1500)	#視点切り替え
^ends




^if(%temp == 1)		# 汎用パラメータ
	%temp = 0		# 汎用パラメータ
^else
	wndoff
	ud(0)
	envoff(0, 200)			# フェードアウト
	bgmoff(0, 400)		# ＢＧＭ終了
^endi


#wait(2100)	# ウェイト
wait(200)	# ウェイト




# 消去リクエスト
#choff(-1)
choff(20)

## フェードアウト
#^sw(%ic_prm)
#	^case(0)    # 
#		ud(2, "mask111", 2500)	#視点切り替え
#	^df
#		ud(2, "mask111", 2500)	#視点切り替え
#^ends




^ret

::END
