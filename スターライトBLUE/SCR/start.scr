################################################
#
#	使用システム宣言
#
#		ここでウィンドウの設定や変数宣言をする。
#
################################################
::START



#title("覇王戦姫　来夢")	# タイトル設定

spr(30)			# スプライト設定
btn(30)			# ボタン設定
wnd(1)			# ウィンドウ設定

#fnt(22, 0xffffff, 2, 0)
fnt(28, 0xffffff, 2, 0)			#メッセージウインドウ黒の場合は白文字
#fnt(28, 0x10213b, 2, 0xFFFFFF)	#メッセージウインドウ白の場合は黒文字

##０１２３４５６７８９０１２３４５６７８

#
# 背景(イベント絵)設定
# 背景は必ずspr[0]になります。
#

# スプライト設定
^gsb(init_spr)


# 背景、キャラクタ、ボタン共に
# 初期サイズは 1 x 1 、
# 表示原点は (0, 0) になります。
# 
# 背景は spr[0] に、キャラクタは
# ch(1) は spr[1]、ch(2) は spr[2] に
# アサインされます。
# 
# BTN オブジェクトは spr[0] (背景)と
# spr[1] の間に表示されます。
# 
# spr(3) は spr(3, NUM) の、
# btn(1) は btn(1, NUM) の、
# wnd(1) は wnd(1, NUM) の省略形です。

# メッセージウインドウ設定
^gsb(WND_ADV)




# バックログ用ウインドウ設定
wbl(SIZE, 1280, 720)
wbl(POS, 0, 0)
#wbl(TXT, 74, 13, 3, 0, 20, 25)
wbl(TXT, 256, 13, 3, 0, 20, 27)
wbl(CEL, 0, 0, 1280, 720, 0x000000, 44)

#wbl(FRM, "bwnd1")

wbl(BTN, "mlstop",  BL_TOP, 1116, 119)
wbl(BTN, "mlsforw", BL_BCK, 1116, 193)
wbl(BTN, "mlsnext", BL_FWD, 1116, 270)
wbl(BTN, "mlslast", BL_BTM, 1116, 344)
wbl(BTN, "mlsexit", BL_EXT, 1116, 453)



^gsb(VAR)		# 変数宣言

^gsb(MACRO)		# マクロ宣言

^go(TITLE)		# タイトル画面へ

::END
