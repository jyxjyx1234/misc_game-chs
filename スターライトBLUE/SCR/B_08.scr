bgmoff(0, 700)		# ＢＧＭ終了




#(web体験版２Ｈシーン終了)
^if( %TAIKEN_FLAG2 == 1 )
	wndoff
	ud(0)
	bgmoff(0, 700)		# ＢＧＭ終了

	choff(-1)	#立ちＣＧ消去
	bgon("tai001b")
	ud(1, 500)
	bgmon("tai_kokuchi", 1)		# ＢＧＭ再生
	ud(1, 6000)

	bgon("tai000a")
	ud(1, 500)
	ud(1, 6000)

	bgon("tai000b")
	ud(1, 500)
	ud(1, 6000)

	bgon("black")
	ud(1, 2500)

	wndoff
	ud(0)
	bgmoff(0, 700)		# ＢＧＭ終了
	^ret
^endi




#○◎(Ｈシーン終了)
