#//08.シーン08
bgmon("bgm01")		# ＢＧＭ再生


#//背景：教室（日中）
bgon("bg006aa1")
ud(2, "mask116L", 2000)	#時間経過


#//立ち絵：凛制服・悲しみ
chon(13, "ta01aac1", 640, 0)	#立ちＣＧ表示（凛）
ud(1, 200)


[譲]「あ、凛ちゃん。おはよう」


#//立ち絵：凛制服・通常
chon(13, "ta01aaa1", NON)	#立ちＣＧ表示（凛）
ud(1, 200)


cvon( "aa0109" )
[凛]「あ、ゆず……おはよう」

　翌日、教室でいつものように挨拶をしたけれど、その表情に少し違和感を覚えた。

　僕が声をかける直前の表情が、少し暗く沈んでいるように見えた気がする。

[譲]（何かあったのかな……？）

　朝から気分が落ちるようなことでもあったのか、それとも他に何か理由があるんだろうか。

[譲]（……もしかして、僕のことかな？）

　社長に取りなしてくれたようだけれど、そこで何か言われたりしたんだろうか。

[譲]「凛ちゃん……何かあった？」


chon(13, "ta01aai1", NON)	#立ちＣＧ表示（凛）
ud(1, 200)


cvon( "aa0110" )
[凛]「え？　どうして？　別になにもないけど」

[譲]「さっき、ちょっと暗い顔をしてたから……もしかして、僕のことでなにか──」


#//立ち絵：凛制服・笑み
chon(13, "ta01aad1", NON)	#立ちＣＧ表示（凛）
ud(1, 200)


cvon( "aa0111" )
[凛]「あはは、ないない、別になんにもないよ」

　僕の不安を凛ちゃんはそう言って笑い飛ばしてしまう。

　だとしたら、さっきの表情の理由は何なんだろうか。


#//立ち絵：凛制服・通常
chon(13, "ta01aaa1", NON)	#立ちＣＧ表示（凛）
ud(1, 200)


cvon( "aa0112" )
[凛]「あー……えっとね、やっぱりソロでのメジャーデビューは難しいんだなって……改めてそう感じちゃって」

[譲]「そうだったんだ……」


chon(13, "ta01aaj1", NON)	#立ちＣＧ表示（凛）
ud(1, 200)


cvon( "aa0113" )
[凛]「うん……分かっていることだけど、それでも……ね？」

　凛ちゃんは笑みを浮かべようとしているけれど、やっぱりその表情には暗さがあった。


chon(13, "ta01aac1", NON)	#立ちＣＧ表示（凛）
ud(1, 200)


cvon( "aa0114" )
[凛]「ごめんね、心配させちゃった？」

[譲]「うん……僕はいつだって凛ちゃんのことを心配してるよ」


#//立ち絵：凛制服・照れ
chon(13, "ta01aaf1", NON)	#立ちＣＧ表示（凛）
ud(1, 200)


cvon( "aa0115" )
[凛]「え……あ、うん……ありがとね、ゆず」

　思わずストレートにそう告げてしまい、凛ちゃんが照れたように頬を赤らめる。

　その反応を見て、僕も自分が何を言ったのか気付き、顔が熱くなってきた。

[譲]「はは……朝から何を言ってるんだろうね」


#//立ち絵：凛制服・笑み
chon(13, "ta01aad1", NON)	#立ちＣＧ表示（凛）
ud(1, 200)


cvon( "aa0116" )
[凛]「ふふ、私は嬉しいけど」

　凛ちゃんがそう言ってくれるなら、さっきの言葉にもちゃんと意味があったと思える。

　気恥ずかしさはあるけれど、もっと口に出していった方がいいのかもしれないな。


#//暗転
choff(-1)	#立ちＣＧ消去
bgon("black")
ud(2, "mask116L", 2000)	#時間経過


wndoff
ud(0)
bgmoff(0, 700)		# ＢＧＭ終了




#時間経過（時間かなり経過）
bgon("bg101a1")
ud(2, "mask116L", 2000)	#時間経過
ud(1, 1200)

bgon("black")
ud(2, "mask116L", 2000)	#時間経過




bgmon("bgm01")		# ＢＧＭ再生


#//背景：街中（日中）
bgon("bg007aa1")
ud(2, "mask116L", 2000)	#時間経過


#//立ち絵：凛制服・通常
chon(13, "ta01aai1", 640, 0)	#立ちＣＧ表示（凛）
ud(1, 200)


cvon( "aa0117" )
[凛]「……やっぱりグラビアしかないのかな」

　放課後、一緒に事務所へと向かう道すがら、凛ちゃんがポツリと零すように呟いた。

　あの話は終わった訳じゃなかったのか。

[譲]「……他に方法はないの？」

　凛ちゃんにその気はないはずだし、無理してまでやる必要があるんだろうか。


chon(13, "ta01aac1", NON)	#立ちＣＧ表示（凛）
ud(1, 200)


cvon( "aa0118" )
[凛]「もちろん地道に頑張っていくことも出来るけど、あんまり時間がないから」

[譲]「そっか……」

　凛ちゃんが夢を追いかけ続けるのにはタイムリミットがある。

　純粋な気持ちのまま、アイドルという夢を追いかけるのか、それともソロデビューという結果を優先するのか。

　凛ちゃんはその二択の間で悩んでいるんだろう。

[譲]「おじさんはいつ帰ってくるんだっけ？」


chon(13, "ta01aai1", NON)	#立ちＣＧ表示（凛）
ud(1, 200)


cvon( "aa0119" )
[凛]「んー……一年後ぐらいかな」

[譲]「一年か……」

　その一年の間に凛ちゃんは、ソロでメジャーレーベルからデビューしなくてはいけない。

　それがかなり困難な道であることは僕も分かっているつもりだ。

　実際にデビューするとなると、そろそろ話が動いていないと間に合わないだろう。

　だから実際のタイムリミットは、たぶん数ヶ月から半年ほどしかない状態だった。


#//場面転換
choff(-1)	#立ちＣＧ消去
bgon("black")
ud(2, "k_rht00", 2000)	#場所移動

#//背景：ビル外観（日中）
bgon("bg002aa1")
ud(2, "k_rht00", 2000)	#場所移動


#//立ち絵：凛制服・通常
chon(13, "ta01aaa1", 640, 0)	#立ちＣＧ表示（凛）
ud(1, 200)


[譲]「今日もレッスン頑張って……こんなことぐらいしか、僕には言えないけど」

　事務所のあるビルの前まで来て、僕は凛ちゃんにそう告げる。

　もっと気の利いた言葉が紡ぎ出せたら良いのに。


#//立ち絵：凛制服・笑み
chon(13, "ta01aad1", NON)	#立ちＣＧ表示（凛）
ud(1, 200)


cvon( "aa0120" )
[凛]「ふふ、ありがと。ゆずもお仕事頑張ってね」


#//立ち絵：凛　消し
choff(-1)	#立ちＣＧ消去
ud(1, 200)


　僕の励ましの言葉に笑みを浮かべると、凛ちゃんは手を振ってレッスンスタジオの方へと向かった。

[譲]「……」

　けれどその笑顔にも、どこか翳りのようなものを感じてしまう。

　事情を知っているからそう思ってしまうのか、それとも本当に心から微笑めない状態なのか。

　僕には凛ちゃんの心の中までは知ることが出来ない。

[譲]（もどかしいな……）

　僕にもっと力があったらと、そう思わずにはいられなかった。


