#//背景：事務所（夜）
bgon("bg003ca1")
ud(2, "mask116L", 2000)	#時間経過


#//立ち絵：遠矢スーツ・驚き、凛制服・微笑み
chon(13, "ta01aaa1", 370, 0)	#立ちＣＧ表示（凛）
chon(4, "ta02aae1", 910, 0)	#立ちＣＧ表示（遠矢）
ud(1, 200)


[譲]「見つかりました、社長！」

　僕と凛ちゃんは二人して、急いで事務所に戻った。

　そして見付けたＵＳＢメモリを手渡すと、社長も驚いた様子で僕らを見る。

cvon( "ga0338" )
[遠矢]「……まだ探してたのか？」

[譲]「はい」


#//立ち絵：遠矢スーツ・通常
chon(4, "ta02aaa1", NON)	#立ちＣＧ表示（遠矢）
ud(1, 200)


cvon( "ga0339" )
[遠矢]「はぁ……まったく」

　社長は呆れながらＵＳＢメモリを受け取り、それをＰＣに挿して中身を確かめる。

cvon( "ga0340" )
[遠矢]「……間違いないな」

[譲]「ふぅ……あ……ご迷惑をおかけしました」

　データを確かめてもらって安堵し、改めて深く頭を下げて謝罪する。

　社長は何も言わなかったけれど、呆れた様子で僕らを見た。


chon(4, "ta02aaf1", NON)	#立ちＣＧ表示（遠矢）
ud(1, 200)


cvon( "ga0341" )
[遠矢]「…………それにしても、お前達どういう関係なんだ？」

[譲]「え……？」


#//立ち絵：凛制服・通常
chon(13, "ta01aai1", NON)	#立ちＣＧ表示（凛）
ud(1, 200)


　僕と凛ちゃんが顔を見合わせて戸惑っていると、社長の視線が下に降りていく。

　その動きに釣られて僕らも下を見て、手を繋いでいることに気が付いた。

[譲]「あ……」


#//立ち絵：凛制服・驚き
chon(13, "ta01aae1", NON)	#立ちＣＧ表示（凛）
ud(1, 200)


cvon( "aa1052" )
[凛]「あっ……！」

　ＵＳＢメモリを見付けて、手を取り合って喜んでから、いつの間にかずっと手を繋いでいたようだ。

　慌てて離したけれど、もう遅い。

[譲]「いや、これは、その……えっと……じ、実は……」


#//立ち絵：凛制服・赤面
chon(13, "ta01aaf1", NON)	#立ちＣＧ表示（凛）
ud(1, 200)


cvon( "aa1053" )
[凛]「あ、あのっ……私達、幼馴染みで……学園でも、同じクラスだし……その……」

cvon( "ga0342" )
[遠矢]「付き合ってるのか？」

　僕と凛ちゃんは揃った動きで首を横に振る。


chon(4, "ta02aaa2", NON)	#立ちＣＧ表示（遠矢）
ud(1, 200)


cvon( "ga0343" )
[遠矢]「はぁ……デビュー前のアイドルなんだ、変な噂が立たないようにしてくれよ」

[譲]「は、はいっ……すみませんでした！」


chon(13, "ta01aac1", NON)	#立ちＣＧ表示（凛）
ud(1, 200)


cvon( "aa1054" )
[凛]「ごめんなさい……」

　確かに社長の言う通りだ。

　別に付き合ったりしている訳じゃないけれど、手を繋いだりしていたら誤解されても仕方が無い。

　僕が凛ちゃんのデビューの邪魔をするようなことは、絶対にあっちゃいけないんだ。

　そう心の中で強く反省したけれど、まだ手に残る感触が僕の頬を熱くさせていた。


#//暗転
choff(-1)	#立ちＣＧ消去
bgon("black")
ud(1, 2000)


wndoff
ud(0)
bgmoff(0, 700)		# ＢＧＭ終了


　その後もソロアイドルとしてメジャーデビューを目指し、凛ちゃんの奮闘する日々が続いた。


bgmon("bgm01")		# ＢＧＭ再生


#//背景：レッスンスタジオ（夜）
bgon("bg004ca1")
ud(1, 2000)


#//立ち絵：凛レッスン着・真剣
chon(13, "tb01fai1", 640, 0)	#立ちＣＧ表示（凛）
ud(1, 200)


cvon( "aa1055" )
[凛]「ハァッ……ハァッ……ハァッ……」

　今日も真剣な表情でダンスレッスンに励んでいる。

　あの日、僕らの関係に釘を刺した社長だったけれど、敢えて引き離すようなことはなかった。

　むしろアルバイトでありながら、凛ちゃんのサポートスタッフとしての雑用までやらせて貰えている。

　まあ、言わなくても勝手に頑張る存在として、良いように使われているのかもしれないけれど。


#//立ち絵：凛レッスン着・通常
choff(-1)	#立ちＣＧ消去
chon(13, "ta01faa1", 640, 0)	#立ちＣＧ表示（凛）
ud(1, 200)


cvon( "aa1056" )
[凛]「ふぅ～……」

[譲]「お疲れ様。はい、タオル」


#//立ち絵：凛レッスン着・微笑み
chon(13, "ta01faa2", NON)	#立ちＣＧ表示（凛）
ud(1, 200)


cvon( "aa1057" )
[凛]「ありがとう、ゆず」

　レッスン終わりの凛ちゃんにタオルとスポーツドリンクを手渡す。

　研修生でしかない凛ちゃんには、こういうことをしてくれるマネージャー的存在もいない。

　だからきっと社長も、僕の存在を都合良く思っているんだろう。

[譲]「……いよいよだね、凛ちゃん」


#//立ち絵：凛レッスン着・真剣
chon(13, "ta01faa1", NON)	#立ちＣＧ表示（凛）
ud(1, 200)


cvon( "aa1058" )
[凛]「うん……」

　まだデビューは決まっていないけれど、ひとつ大きな展開が生まれていた。

　事務所主催で行われるライブイベントに、凛ちゃんも出演することが決まったのだ。

　これがデビューに繋がるのかどうか分からないけれど、でも様々な関係者が見に来るのも確からしい。


chon(13, "ta01faa2", NON)	#立ちＣＧ表示（凛）
ud(1, 200)


cvon( "aa1059" )
[凛]「私、全力で頑張るから……見ててね、ゆず」

[譲]「うん、見てる……見守ってるよ」

　ステージの上で頑張れるのは凛ちゃんだけ。

　だから僕はそれ以外の場所で彼女を支え、応援し、見守っていく。

　絶対にデビュー出来ると、そう信じて。


