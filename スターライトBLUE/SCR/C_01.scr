wndoff
ud(0)
bgmoff(0, 700)		# ＢＧＭ終了
bgmon("bgm01")		# ＢＧＭ再生


#//背景：街中（夜）
bgon("bg007ca1")
ud(2, "k_rht00", 2000)	#場所移動


#//立ち絵：凛制服・通常
chon(13, "ta01aaa2", 640, 0)	#立ちＣＧ表示（凛）
ud(1, 200)


cvon( "aa1039" )
[凛]「私はこっち側を見て行くから、ゆずはそっちね」

[譲]「う、うん……」

　凛ちゃんと並んで歩きながら、じっくりと探していく。

　もう何度も見て歩いた道だけれど、隣に凛ちゃんがいるだけで、不思議と心強かった。


chon(13, "ta01aai1", NON)	#立ちＣＧ表示（凛）左
ud(1, 200)


cvon( "aa1040" )
[凛]「……あ、そういえば探してるＵＳＢメモリって、どんな形してるの？」

　歩き始めて少ししたところで、凛ちゃんが不意に立ち止まってそう聞いてきた。

[譲]「え……知らないで探してたの……？」

　凛ちゃんが来てくれたことで気が緩んでいたのか、僕は思わずそう聞き返してしまう。


#//立ち絵：凛制服・赤面
chon(13, "ta01aaf1", NON)	#立ちＣＧ表示（凛）
ud(1, 200)


cvon( "aa1041" )
[凛]「だ、だって……！　その……ゆずが知ってると思って、それで……だから……あぅぅ……」

　慌てるその様子を見ているうちに、僕は何だか可笑しくなってしまった。

[譲]「……ぷっ……くすくす……」


chon(13, "ta01aab1", NON)	#立ちＣＧ表示（凛）
ud(1, 200)


cvon( "aa1042" )
[凛]「も、もー！　笑わないでよー！　うぅ～……」

[譲]「ははっ……ごめん、ごめん……！」


chon(13, "ta01aaf1", NON)	#立ちＣＧ表示（凛）
ud(1, 200)


　落ち着いているように見えた凛ちゃんだけれど、本当はそういう訳じゃなかったんだ。

　それが知れたことで、さっきまで凄く落ち込んでいたのが嘘のように、気持ちが軽くなっている。


#//立ち絵：凛制服・微笑み
chon(13, "ta01aaa2", NON)	#立ちＣＧ表示（凛）
ud(1, 200)


cvon( "aa1043" )
[凛]「ふふっ……ゆっくり探そっか」

[譲]「……そうだね」

　僕らはＵＳＢメモリを探しながら、色々なことを話した。

　凛ちゃんと二人でゆっくりと話す機会なんて、ほんとうに久し振りな気がする。


#//時間経過
chon(19, "black", CENTER)
ud(2, "mask116L", 2000)	#時間経過

choff(19)
chon(13, "ta01aaa1", NON)	#立ちＣＧ表示（凛）
ud(2, "mask116L", 2000)	#時間経過


cvon( "aa1044" )
[凛]「覚えてるー？　プールの授業中に──」

[譲]「うっ……またその話をするの？　あれは……って、凛ちゃん……？」


chon(13, "ta01aai1", NON)	#立ちＣＧ表示（凛）
ud(1, 200)


　懐かしい話に花を咲かせていると、不意に凛ちゃんの動きが止まった。


#//立ち絵：凛制服・驚き
chon(13, "ta01aae1", NON)	#立ちＣＧ表示（凛）
ud(1, 200)


cvon( "aa1045" )
[凛]「ゆ、ゆ、ゆ、ゆずっ……！　これこれ……！」

　足を止めた凛ちゃんが慌てた様子で指を差す。

[譲]「どうしたの……？」

cvon( "aa1046" )
[凛]「み、み、見て！　こ、これ！　これ！」

　言われるままその指が差す方を見て、僕も同じように固まった。

[譲]「え…………えぇ！？」

　どこかで落としたと思っていたＵＳＢメモリ。

　だから僕はずっと地面を見て、探し歩いていた。

　でも凛ちゃんが驚いた様子で指差しているのは電柱。

　そこにテープで貼り付けられていたのは、落とし物と書かれたＵＳＢメモリだった。


wndoff
ud(0)
bgmoff(0, 700)		# ＢＧＭ終了
bgmon("bgm04")		# ＢＧＭ再生


cvon( "aa1047" )
[凛]「これ！　これだよね！？　ね！？」

[譲]「う、うん……！　これだよ……！」

　きっと誰かが拾って、目立つようにそこに貼ってくれていたんだ。

　精神的に追い詰められていた僕は、たぶん視野が狭くなっていたんだろう。


#//立ち絵：凛制服・喜び
chon(13, "ta01aad1", NON)	#立ちＣＧ表示（凛）
ud(1, 200)


cvon( "aa1048" )
[凛]「見つかったよ、ゆず！　やったね！」

[譲]「良かった……良かったよ……はは……」

　僕らは手を取り合って喜び合う。

　あれだけ探して見つからなかったものが、こんなに呆気なく見つかるなんて。

　正直、もうほとんど諦めていた。

　最後に凛ちゃんとゆっくり話せて、良い思い出になったぐらいの感覚だったのに。


#//立ち絵：凛制服・微笑み
chon(13, "ta01aaa2", NON)	#立ちＣＧ表示（凛）
ud(1, 200)


cvon( "aa1049" )
[凛]「……本当に良かったね、ゆず」

[譲]「うん、ありがとう……凛ちゃんのおかげだよ」


chon(13, "ta01aaa1", NON)	#立ちＣＧ表示（凛）
ud(1, 200)


cvon( "aa1050" )
[凛]「ふふっ……いっぱい感謝してね？」

[譲]「もちろん、一生感謝する」


chon(13, "ta01aaa3", NON)	#立ちＣＧ表示（凛）
ud(1, 200)


cvon( "aa1051" )
[凛]「じゃあ、ゆずはこれからもずっと、私のファンでいてね」

　凛ちゃんに言われるまでもなく、僕は死ぬまで凛ちゃんのファンだろう。

　その笑顔を見ていて、改めてそう強く感じたのだった。


#//暗転
#//場面転換
choff(-1)	#立ちＣＧ消去
