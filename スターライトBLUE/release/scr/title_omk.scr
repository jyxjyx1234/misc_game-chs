btnon(ALL)
ud(0)

# ボタンを選択させる
btnenable
btnreset(ALL)

# ボタン処理
^sw(%reg)
	^case(1)
		#ＣＧ鑑賞
		float(3)
	^case(2)
		#Ｈシーン回想
		^go(mode_h)
	^case(3)
		#ＢＧＭ鑑賞
		float(5)
	^case(4)
		#ハーレムルート
	 	#★★★初めからボイス
		 rand(5)
		 
		^sw(%reg)
		^case(0)
			seon("aa_sys01")			# 非同期単発（システム用トラック）
		^case(1)
			seon("ab_sys01")			# 非同期単発（システム用トラック）
		^case(2)
			seon("ac_sys01")			# 非同期単発（システム用トラック）
		^case(3)
			seon("ad_sys01")			# 非同期単発（システム用トラック）
		^case(4)
			seon("ba_sys01")			# 非同期単発（システム用トラック）
		^case(5)
			seon("bb_sys01")			# 非同期単発（システム用トラック）
		^df
			seon("aa_sys02")			# 非同期単発（システム用トラック）
		^ends

		bgon("black")
		ud(1, 500)
		mode(1)
		# セーブ可能、ロード可能
		mode(0)
		loadenable
		saveenable
		^gsb(WND_ADV)
		mode(1)

		bgoff
		ud(1, 1000)
		bgmoff(0, 700)		# ＢＧＭ終了

		^gsb(main_har)
	^case(5)
		#メインメニューに戻る
		^go(title_main)
^ends

^go(.START)

::END

