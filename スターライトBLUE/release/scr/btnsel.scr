		choff(27)	#ウインドウ消去
		choff(28)	#ウインドウ消去
		choff(29)	#ウインドウ消去
		ud(0)
		%sentaku = 12

	 ^case(14)			# クイックセーブ
		float(7)
		^jp(SEL_BTN_MODE)

	 ^case(15)			# クイックロード
		float(8)
		^jp(SEL_BTN_MODE)

	 ^case(16)			# セーブ
		float(1)
		^jp(SEL_BTN_MODE)

	 ^case(17)			# ロード
		float(2)
		^jp(SEL_BTN_MODE)

	 ^case(18)			# コンフィグ
		float(9)
		^jp(SEL_BTN_MODE)

	^df

鍮騁０１

^ends



^ret

::END
