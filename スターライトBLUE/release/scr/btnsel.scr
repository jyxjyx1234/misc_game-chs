############################################
# ボタン選択ルーチン
############################################
::START



chon(26, "msgwnd1", 0, 432)	#ウインドウ表示
ud(0)
wndoff
ud(0)

btnset(14, "mlsqsave", 243, 681)	# クイックセーブ
btnset(15, "mlsqload", 349, 681)	# クイックロード
btnset(16, "mlssave", 462, 681)	# セーブ
btnset(17, "mlsload", 568, 681)	# ロード
btnset(18, "mlscnfg", 664, 681)	# コンフィグ




chon(27, "mlsskip2", 785, 681)	#ウインドウ表示
chon(28, "mlsauto2", 887, 681)	#ウインドウ表示
chon(29, "mlslog2", 997, 681)	#ウインドウ表示


:SEL_BTN_MODE

btnon(ALL)
ud(0)

# ボタンを選択させる
btnenable




#返り値設定
^sw(%reg)
	 ^case(1)
		btnreset(ALL)
		choff(26)	#ウインドウ消去
		choff(27)	#ウインドウ消去
		choff(28)	#ウインドウ消去
		choff(29)	#ウインドウ消去
		ud(0)
		%sentaku = 0

	 ^case(2)
		btnreset(ALL)
		choff(26)	#ウインドウ消去
		choff(27)	#ウインドウ消去
		choff(28)	#ウインドウ消去
		choff(29)	#ウインドウ消去
		ud(0)
		%sentaku = 1

	 ^case(3)
		btnreset(ALL)
		choff(26)	#ウインドウ消去
