		choff(26)	#ウインドウ消去
		choff(27)	#ウインドウ消去
		choff(28)	#ウインドウ消去
		choff(29)	#ウインドウ消去
		ud(0)
		%sentaku = 3

	 ^case(5)
		btnreset(ALL)
		choff(26)	#ウインドウ消去
		choff(27)	#ウインドウ消去
		choff(28)	#ウインドウ消去
		choff(29)	#ウインドウ消去
		ud(0)
		%sentaku = 4

	 ^case(6)
		btnreset(ALL)
		choff(26)	#ウインドウ消去
		choff(27)	#ウインドウ消去
		choff(28)	#ウインドウ消去
		choff(29)	#ウインドウ消去
		ud(0)
		%sentaku = 5

	 ^case(7)
		btnreset(ALL)
		choff(26)	#ウインドウ消去
		choff(27)	#ウインドウ消去
		choff(28)	#ウインドウ消去
		choff(29)	#ウインドウ消去
		ud(0)
		%sentaku = 6

	 ^case(8)
		btnreset(ALL)
		choff(26)	#ウインドウ消去
		choff(27)	#ウインドウ消去
		choff(28)	#ウインドウ消去
		choff(29)	#ウインドウ消去
		ud(0)
		%sentaku = 7

	 ^case(9)
		btnreset(ALL)
		choff(26)	#ウインドウ消去
		choff(27)	#ウインドウ消去
		choff(28)	#ウインドウ消去
		choff(29)	#ウインドウ消去
		ud(0)
		%sentaku = 8

	 ^case(10)
		btnreset(ALL)
		choff(26)	#ウインドウ消去
		choff(27)	#ウインドウ消去
		choff(28)	#ウインドウ消去
		choff(29)	#ウインドウ消去
		ud(0)
		%sentaku = 9

	 ^case(11)
		btnreset(ALL)
		choff(26)	#ウインドウ消去
		choff(27)	#ウインドウ消去
		choff(28)	#ウインドウ消去
		choff(29)	#ウインドウ消去
		ud(0)
