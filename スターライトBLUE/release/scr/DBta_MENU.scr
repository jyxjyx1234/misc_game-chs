:LABEL_TOP


#//背景
bgon("bg014aa1")
ud(1, 200)




btnset(1,"slctwnd", 304, 0, "「普通站姿」", 30, 13)
btnset(2,"slctwnd", 304, 56, "「退后站姿」", 30, 13)
btnset(3,"slctwnd", 304, 112, "「特效皚顳」", 30, 13)
btnset(5,"slctwnd", 304, 168, "「返回蹌馭画面」", 30, 13)

^gsb(btnsel)	# ボタン選択ルーチン

%temp = %sentaku    # 選択肢パラメータ保存
^sw(%temp)
	^case(0)			# 「通常立ち」
		^jp(TATI_01_NRL_TOP)
	^case(1)			# 「引き立ち」
		^jp(TATI_01_UP_TOP)
	^case(2)			# 「エフェクトチェック」
		^jp(EFFECT_TOP)
	^case(4)			# 「タイトル画面へ戻る」
		^jp(END_TATI)
	^df
^ends



:TATI_01_NRL_TOP




