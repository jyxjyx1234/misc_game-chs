#//btnset(8,"slctwnd", 204, 424, "【結里奈ルート】を見る", 52, 17)
btnset(9,"slctwnd", 204, 480, "「返回蹌馭画面」", 52, 17)

^gsb(btnsel)	# ボタン選択ルーチン

%temp = %sentaku    # 選択肢パラメータ保存
^sw(%temp)
	^case(0)			# 【第一章】を見る
		^jp(DB_00_00)
	^case(1)			# 【第二章】を見る
		^jp(DB_00_01)
	^case(2)			# 【第三章】を見る
		^jp(DB_00_02)
	^case(3)			# 【第四章】を見る
