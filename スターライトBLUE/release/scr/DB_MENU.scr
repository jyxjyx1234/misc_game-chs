	^case(5)			# 【第六章】を見る
		^jp(DB_00_05)
	^case(6)			# ワーク
		^jp(DB_00_99)
#//	^case(7)			# 【結里奈ルート】を見る
#//		^jp(DB_00_07)
	^case(8)			# タイトル画面へ戻る
		^jp(END_GAME)
	^df
^ends

