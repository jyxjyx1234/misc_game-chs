	// 既定名レイヤ
	// 指定の名前のレイヤが無ければ自動で作成して既定の初期化を行う
	// ※名前は小文字で正規化されるのに注意してください
	// 効果用の画像などをファイル名やレベル名を指定して登録することができます
	"layers" => %[
		"border" => %[
		init: %[level:5, file:"border"], // 初期化パラメータ。任意のパラメータ配置可能
		trans: "normal", // デフォルトのトランジション指定,
