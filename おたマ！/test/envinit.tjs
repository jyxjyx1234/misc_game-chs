		"スライド右速" => %[ time: 200, showaction: %[ left : %[ handler:"MoveAction", start:"@-10", value:"@", accel:-1 ] ],
						                  hideaction: %[ left : %[ handler:"MoveAction", start:"@", value:"@+10", accel: -1 ] ] ],

		"スライド上下"   => %[ time: 500, showaction: %[ top : %[ handler:"MoveAction", start:"@-100", value:"@", accel:-1 ] ] ,
										  hideaction: %[ top : %[ handler:"MoveAction", start:"@", value:"@-100", accel: 1 ] ] ],
		"スライド上下速" => %[ time: 200, showaction: %[ top : %[ handler:"MoveAction", start:"@-100", value:"@", accel:-1 ] ],
						                  hideaction: %[ top : %[ handler:"MoveAction", start:"@", value:"@-100", accel: 1 ] ] ],
		"スライド上下遅" => %[ time: 800, showaction: %[ top : %[ handler:"MoveAction", start:"@-100", value:"@", accel:-1 ] ],
						                  hideaction: %[ top : %[ handler:"MoveAction", start:"@", value:"@-100", accel: 1 ] ] ],
		"スライド上下小" => %[ time: 300, showaction: %[ top : %[ handler:"MoveAction", start:"@-10", value:"@", accel:-1 ] ],
	                                      hideaction: %[ top : %[ handler:"MoveAction", start:"@", value:"@-10", accel: -1 ] ] ],
		"スライド上下遅小" => %[ time: 800, showaction: %[ top : %[ handler:"MoveAction", start:"@-10", value:"@", accel:-1 ] ],
						                    hideaction: %[ top : %[ handler:"MoveAction", start:"@", value:"@-10", accel: -1 ] ] ],
		"スライド上下速小" => %[ time: 200, showaction: %[ top : %[ handler:"MoveAction", start:"@-10", value:"@", accel:-1 ] ],
						                    hideaction: %[ top : %[ handler:"MoveAction", start:"@", value:"@-10", accel: -1 ] ] ],

		"立ち上がり" => %[
			"time" => 1,
			"showaction" => "立ち上がり用",
			"hideaction" => "立ち上がり消去用"
			// 特殊機能。文字列指定すると指定のアクションをそのまま使う。時間指定はスルーされる。
			],

		"立ち上がり速" => %[
			"time" => 1,
			"showaction" => "立ち上がり速用",
			"hideaction" => "立ち上がり速消去用"
			// 特殊機能。文字列指定すると指定のアクションをそのまま使う。時間指定はスルーされる。
			],
			
		"立ち上がり超速" => %[
			"time" => 1,
			"showaction" => "立ち上がり速用",
			"hideaction" => "立ち上がり速消去用"
			// 特殊機能。文字列指定すると指定のアクションをそのまま使う。時間指定はスルーされる。
			],

		"立ち上がり遅" => %[
			"time" => 1,
			"showaction" => "立ち上がり遅用"
			// 特殊機能。文字列指定すると指定のアクションをそのまま使う。時間指定はスルーされる。
			],

		"立ち上がり超遅" => %[
			"time" => 1,
			"showaction" => "立ち上がり超遅用"
			// 特殊機能。文字列指定すると指定のアクションをそのまま使う。時間指定はスルーされる。
			],

		"座り" => %[
			"time" => 1,
			"showaction" => "座り用"
			// 特殊機能。文字列指定すると指定のアクションをそのまま使う。時間指定はスルーされる。
			],

		"しゃがみ" => %[
			"time" => 1,
			"hideaction" => "しゃがみ用"
			// 特殊機能。文字列指定すると指定のアクションをそのまま使う。時間指定はスルーされる。
			],

		"しゃがみ速" => %[
			"time" => 1,
			"hideaction" => "しゃがみ速用"
			// 特殊機能。文字列指定すると指定のアクションをそのまま使う。時間指定はスルーされる。
			],

		"sysact_logojump" => %[
		time: 400,
		showaction: %[ left : %[ handler:"MoveAction", start:"@+100", value:"@" ],
					   top:   %[ handler:"SinAction",  vibration:40, cycle:800, time:400 ] ],
		hideaction: %[]
			]
		],

//デフォルトトランジション定義　ここから

	//立ち絵、背景、イベント絵の変更時にトランジション指定が省略されていた場合に使用するトランジションを定義します
	// "*Trans" => トランジション名文字列（"transitions"で定義されているもの） または トランジション定義辞書
	// ※キャラクタ関係はキャラ定義内の *Trans の定義が優先されます。

	"charDispTrans" => %[ "time" =>  300, "method"  => "crossfade" ],                   // キャラクタの表示・消去指定
	"positionTrans" => %[ "time" =>  300, "method"  => "crossfade" ],                   // キャラクタの位置変更

//	"poseTrans"     => %[ "time" =>  300, "method"  => "crossfade", "nosync" => true ], // キャラクタのポーズ変更
//	"dressTrans"    => %[ "time" =>  300, "method"  => "crossfade", "nosync" => true ], // キャラクタの服装変更
//	"diffTrans"     => %[ "time" =>  300, "method"  => "crossfade", "nosync" => true ], // キャラクタの差分変更(exstand使用時のみ)
//	"faceTrans"     => %[ "time" =>  300, "method"  => "crossfade", "nosync" => true ], // キャラクタの表情変更
	"charTrans"     => %[ "time" =>  300, "method"  => "crossfade", "nosync" => true ], // ポーズ・服装・差分・表情のデフォルト（上記が未定義の時に使用される）

//	"layerDispTrans"=> %[ "time" =>  500, "method"  => "crossfade" ],                   // レイヤー(newlayで作成されたもの)の表示・消去指定

//	"timeTrans"     => %[ "time" => 1500, "method"  => "crossfade" ],                   // 時間変更
//	"stageTrans"    => %[ "time" => 1500, "method"  => "crossfade" ],                   // 舞台（ステージ）変更
//	"eventTrans"    => %[ "time" => 1500, "method"  => "crossfade" ],                   // イベント変更
	"envTrans"      => "normal",                                                        // 環境デフォルト（上記が未定義の時に使用される）

//デフォルトトランジション定義　ここまで

	// fade コマンドの規定値:全体用 (未定義の場合埋め込み値 500)
	"fadeValue" => 1000,
	// fade コマンドの規定値:キャラクタ用（未定義だと fadeValue を参照)
	"charFadeValue" => 300,

	// 自動インクリメンタル方式の場合のボイス番号初期値
	//"voiceInit" => 0,

	// sync時はセーブポイントにする
	//"autolabelSync" => true,

	// キャラクタ定義情報
	"characters" => %[
		// ※exstand (psd素材からのコンバート立ち絵) を使う場合は，ここでの詳細定義は不要。
		//   voiceName等の定義のみでよい
		//"あい" => %[ "voiceName" => "voice0", ～ ];


		// 定義
		"きらら" => %[ voiceName :"a01" ],
