%[
	// 時間情報
	"times" => %[
		"昼" => %[
			"prefix" => "d",
			],
		"夕方" => %[
			"prefix" => "e",
			"lightColor" => 0xc0ff6010,    // 背景補正光色
			"lightType" => ltPsHardLight,  // 背景補正光合成種別
			"brightness" => 0,             // 背景明度補正
			"contrast" => 0,               // 背景コントラスト補正
			"charLightColor" => 0x77cc0000,   // キャラ補正光合成色
			"charLightType" => ltPsSoftLight, // キャラ補正光合成種別
			"charBrightness" => 0,            // キャラ明度補正
			"charContrast" => 0,              // キャラコントラスト補正
			],
		"夕方部屋" => %[
			"prefix" => "e",
			],
		"夜部屋" => %[
			"prefix" => "n",
			],
		"夜" => %[
			"prefix" => "n",
			"lightColor" => 0xc0000040,   // 補正光合成色
			"lightType" => ltPsHardLight, // 補正光合成種別
			"brightness" => -10,          // 明度補正
			"contrast" => -15,            // コントラスト補正
			"charLightColor" => 0xff400080,   // キャラ補正光合成色
			"charLightType" => ltPsSoftLight, // キャラ補正光合成種別
			"charBrightness" => -25,          // キャラ明度補正
			"charContrast" => -15,            // キャラコントラスト補正
			],
		"消灯" => %[
			"prefix" => "nf",
			"lightColor" => 0xc0000020,   // 補正光合成色
			"lightType" => ltPsHardLight, // 補正光合成種別
			"brightness" => -20,          // 明度補正
			"contrast" => -15,            // コントラスト補正
			"charLightColor" => 0xff400080,   // キャラ補正光合成色
			"charLightType" => ltPsSoftLight, // キャラ補正光合成種別
			"charBrightness" => -40,          // キャラ明度補正
			"charContrast" => -20,            // キャラコントラスト補正
			],
		"曇" => %[
			"prefix" => "d",
			"lightColor" => 0x00000000,   // 背景補正光合成色
			"lightType" => ltPsHardLight, // 背景補正光合成種別
			"brightness" => -15,          // 背景明度補正
			"contrast" => -20,            // 背景コントラスト補正
			"charLightColor" => 0xff400040,   // キャラ補正光合成色
			"charLightType" => ltPsSoftLight, // キャラ補正光合成種別
			"charBrightness" => -7,          // キャラ明度補正
			"charContrast" => -15,            // キャラコントラスト補正
			],

		// 立ち絵鑑賞画面用
		"モブ" => %[ prefix:"m1" ],
		"モブ昼" => %[ prefix:"m1d" ],
		"モブ夕" => %[ prefix:"m1e" ],
		"モブ夜" => %[ prefix:"m1n" ],
		"モブ２" => %[ prefix:"m2d" ],
		],

	// 場所情報
	"stages" => %[
			"メイド喫茶"						=> %[ image:"BK001m1" ],
			"メイド喫茶・モブなし"				=> %[ image:"BK001TIME" ],
			"オタク街１"						=> %[ image:"BK002TIME" ],
			"オタク街１・モブ"					=> %[ image:"BK002m1" ],
			"オタク街２"						=> %[ image:"BK003TIME" ],
			"オタク街２・モブ"					=> %[ image:"BK003m1TIME" ],
			"オタク街２・モブ２"				=> %[ image:"BK003m2d" ],
			"主人公の部屋"						=> %[ image:"BK004TIME" ],
			"もみじの部屋"						=> %[ image:"BK005TIME" ],
			"コミケ会場西"						=> %[ image:"BK006TIME" ],
			"コミケ会場西・モブ"				=> %[ image:"BK006m1" ],
			"コミケ会場東"						=> %[ image:"BK007TIME" ],
			"コミケ会場東・モブ"				=> %[ image:"BK007m1" ],
			"アキハバラ"						=> %[ image:"BK008TIME" ],
			"アキハバラ・モブ"					=> %[ image:"BK008m1TIME" ],
			"ビッグサイト"						=> %[ image:"BK009TIME" ],
			"ビッグサイト・モブ"				=> %[ image:"BK009m1TIME" ],
			"ホテル部屋"						=> %[ image:"BK010TIME" ],
			"同人ショップ"						=> %[ image:"BK011TIME" ],
			"同人ショップ・モブ"				=> %[ image:"BK011m1" ],
			"ソフトショップ"					=> %[ image:"BK012TIME" ],
			"ソフトショップ・モブ"				=> %[ image:"BK012m1" ],
			"ホビーショップ"					=> %[ image:"BK013TIME" ],
			"ホビーショップ・モブ"				=> %[ image:"BK013m1" ],
			"風呂"								=> %[ image:"BK014TIME" ],
			"近所"								=> %[ image:"BK015TIME" ],
			"公園"								=> %[ image:"BK016TIME" ],
			"ＳＭラブホテル"					=> %[ image:"BK017TIME" ],
			"ＣＤ・ＤＶＤコーナー"				=> %[ image:"BK018TIME" ],
			"ＣＤ・ＤＶＤコーナー・モブ"		=> %[ image:"BK018m1" ],
			"ゲームコーナー"					=> %[ image:"BK019TIME" ],
			"ゲームコーナー・モブ"				=> %[ image:"BK019m1" ],
			"空"								=> %[ image:"BK020TIME" ],
			"ベッドルーム"						=> %[ image:"BK021nf" ],
			"怪しい本屋"						=> %[ image:"BK022d" ],


		// 単色
		"黒"							=> %[ image:"bg_c_black" ], // 
		"白"							=> %[ image:"bg_c_white" ], // 
		"赤"							=> %[ image:"bg_c_red" ], //
		"ピンク"						=> %[ image:"bg_c_pink" ], //
		"ピンク２"						=> %[ image:"bg_c_pink2" ], //
		"ピンク星"						=> %[ image:"bg_c_pink_star2" ], //
		"炎"							=> %[ image:"bg_c_fire" ], //

		// 立ち絵鑑賞画面用
		"立ち絵鑑賞デフォルト背景" => %[ image:"exchview_bg" ],

		],


	"defaultTime" => "昼",

	// キャラクタ配置総合オフセット（画面中央原点)
	"yoffset" => 0,

	// 自動レイアウト指定
	"layouts" => [
		%[ "xpos", [0], "level", 2, "leveltrans", "showslide", "time", 200],
		%[ "xpos", [-220,220], "level", 1, "leveltrans", "showslide", "time", 200 ],
		%[ "xpos", [-400,0,400], "level", 1, "leveltrans", "showslide", "time", 200  ],
		%[ "xpos", [-450,-150,150,450], "level", 1, "leveltrans", "showslide", "time", 200  ],
		],

	"defaultBU" => true, // デフォルトで立ち絵のみ顔無し

	// キャラクタ配置情報定義
	"positions" => %[
		// ※type定義は不要になりました。disp/xpos/ypos/level いずれかの定義が記述されていればそれが使用されます。

		// 表示定義（顔表示は，フェイスウィンドウ機能がない場合には意味を持ちません）
		"出" => %[ "disp" => KAGEnvImage.SHOW      ], // デフォルト表示
		"両" => %[ "disp" => KAGEnvImage.BOTH      ], // 立ち絵と顔を表示
		"立" => %[ "disp" => KAGEnvImage.BU        ], // 立ち絵のみ表示
		"顔" => %[ "disp" => KAGEnvImage.FACE      ], // 顔のみ表示
		"消" => %[ "disp" => KAGEnvImage.CLEAR     ], // 一時非表示（状態変更による自動表示は有効）※基本はこちらを使います
		"無" => %[ "disp" => KAGEnvImage.INVISIBLE ], // 完全非表示（状態変更による自動表示も無効）

		"入場" => %[ "disp" => KAGEnvImage.BOTH, "layout" => "right", "trans" => "showslide"  ], // 自動レイアウトつき表示
		"退場" => %[ "disp" => KAGEnvImage.CLEAR, "layout" => "hide", "trans" => "showslide"  ], // 自動レイアウトつき消去
		"割込" => %[ "disp" => KAGEnvImage.BOTH, "layout" => "center", "trans" => "showslide"  ], // 自動レイアウトつき表示

		// トランジションつき定義
		"出左長"   => %[ "disp" => KAGEnvImage.SHOW, trans:"スライド左長" ],
		"出右長"   => %[ "disp" => KAGEnvImage.SHOW, trans:"スライド右長" ],
		"出左速長" => %[ "disp" => KAGEnvImage.SHOW, trans:"スライド左速長" ],
		"出右速長" => %[ "disp" => KAGEnvImage.SHOW, trans:"スライド右速長" ],
		"出左遅長" => %[ "disp" => KAGEnvImage.SHOW, trans:"スライド左遅長" ],
		"出右遅長" => %[ "disp" => KAGEnvImage.SHOW, trans:"スライド右遅長" ],
		"出左" => %[ "disp" => KAGEnvImage.SHOW, trans:"スライド左" ],
		"出右" => %[ "disp" => KAGEnvImage.SHOW, trans:"スライド右" ],
		"出左遅" => %[ "disp" => KAGEnvImage.SHOW, trans:"スライド左遅" ],
		"出右遅" => %[ "disp" => KAGEnvImage.SHOW, trans:"スライド右遅" ],
		"出左速" => %[ "disp" => KAGEnvImage.SHOW, trans:"スライド左速" ],
		"出右速" => %[ "disp" => KAGEnvImage.SHOW, trans:"スライド右速" ],

		"消左長"   => %[ "disp" => KAGEnvImage.CLEAR, trans:"スライド左長" ],
		"消右長"   => %[ "disp" => KAGEnvImage.CLEAR, trans:"スライド右長" ],
		"消左速長" => %[ "disp" => KAGEnvImage.CLEAR, trans:"スライド左速長" ],
		"消右速長" => %[ "disp" => KAGEnvImage.CLEAR, trans:"スライド右速長" ],
		"消左遅長" => %[ "disp" => KAGEnvImage.CLEAR, trans:"スライド左遅長" ],
		"消右遅長" => %[ "disp" => KAGEnvImage.CLEAR, trans:"スライド右遅長" ],
		"消左" => %[ "disp" => KAGEnvImage.CLEAR, trans:"スライド左" ],
		"消右" => %[ "disp" => KAGEnvImage.CLEAR, trans:"スライド右" ],
		"消左遅" => %[ "disp" => KAGEnvImage.CLEAR, trans:"スライド左遅" ],
		"消右遅" => %[ "disp" => KAGEnvImage.CLEAR, trans:"スライド右遅" ],
		"消左速" => %[ "disp" => KAGEnvImage.CLEAR, trans:"スライド左速" ],
		"消右速" => %[ "disp" => KAGEnvImage.CLEAR, trans:"スライド右速" ],

		"出上下"   => %[ "disp" => KAGEnvImage.SHOW, trans:"スライド上下" ],
		"出上下速" => %[ "disp" => KAGEnvImage.SHOW, trans:"スライド上下速" ],
		"出上下遅" => %[ "disp" => KAGEnvImage.SHOW, trans:"スライド上下遅" ],
		"出上下小" => %[ "disp" => KAGEnvImage.SHOW, trans:"スライド上下小" ],
		"出上下遅小" => %[ "disp" => KAGEnvImage.SHOW, trans:"スライド上下遅小" ],
		"出上下速小" => %[ "disp" => KAGEnvImage.SHOW, trans:"スライド上下速小" ],
		"消上下"   => %[ "disp" => KAGEnvImage.CLEAR, trans:"スライド上下" ],
		"消上下速" => %[ "disp" => KAGEnvImage.CLEAR, trans:"スライド上下速" ],
		"消上下遅" => %[ "disp" => KAGEnvImage.CLEAR, trans:"スライド上下遅" ],
		"消上下小" => %[ "disp" => KAGEnvImage.CLEAR, trans:"スライド上下小" ],
		"消上下遅小" => %[ "disp" => KAGEnvImage.CLEAR, trans:"スライド上下遅小" ],
		"消上下速小" => %[ "disp" => KAGEnvImage.CLEAR, trans:"スライド上下速小" ],

		// 位置定義
		"左750"   => %[ "xpos" => int -750 ],
		"左700"   => %[ "xpos" => int -700 ],
		"左650"   => %[ "xpos" => int -650 ],
		"左600"   => %[ "xpos" => int -600 ],
		"左550"   => %[ "xpos" => int -550 ],
		"左500"   => %[ "xpos" => int -500 ],
		"左450"   => %[ "xpos" => int -450 ],
		"左400"   => %[ "xpos" => int -400 ],
		"左350"   => %[ "xpos" => int -350 ],
		"左300"   => %[ "xpos" => int -300 ],
		"左250"   => %[ "xpos" => int -250 ],
		"左"   => %[ "xpos" => int -250 ],
		"左200"   => %[ "xpos" => int -200 ],
		"左150"   => %[ "xpos" => int -150 ],
		"左100"   => %[ "xpos" => int -100 ],
		"左50"   => %[ "xpos" => int -50 ],
		"中"   => %[ "xpos" => int    0 ],
		"右50"   => %[ "xpos" => int 50 ],
		"右100"   => %[ "xpos" => int 100 ],
		"右150"   => %[ "xpos" => int 150 ],
		"右200"   => %[ "xpos" => int 200 ],
		"右"   => %[ "xpos" => int  250 ],
		"右250"   => %[ "xpos" => int 250 ],
		"右300"   => %[ "xpos" => int 300 ],
		"右350"   => %[ "xpos" => int 350 ],
		"右400"   => %[ "xpos" => int 400 ],
		"右450"   => %[ "xpos" => int 450 ],
		"右500"   => %[ "xpos" => int 500 ],
		"右550"   => %[ "xpos" => int 550 ],
		"右600"   => %[ "xpos" => int 600 ],
		"右650"   => %[ "xpos" => int 650 ],
		"右700"   => %[ "xpos" => int 700 ],
		"右750"   => %[ "xpos" => int 750 ],



		// yposは直で個別に指定する場合が多いようです
//		"縦デフォルト" => %[ "ypos" => int    0 ],
//		"縦しゃがみ"   => %[ "ypos" => int   50 ],
//		"縦背伸び"     => %[ "ypos" => int  -20 ],

		"奥"   => %[ "level" => int 0 ],
		"前"   => %[ "level" => int 1 ],
		"手前" => %[ "level" => int 2 ],
		],

    // 表示レベル用情報
	"levels" => [
		%[
			// 拡大率指定
			"zoom" => 75, // 位置縮小率（カメラ
//			"imgzoom" => 100, // 画像縮小率
			"name" => "0", //レベル名称
			],
		%[
			"zoom" => 100,
			"name" => "1"
			],
		%[
			"zoom" => 150,
			"name" => "2"
			],
		],
    
    "defaultLevel" => 1,

	// BG奥行き指定（levelのzoom指定相当）　※各BG個別でのlevelz変更は未実装
	"bglevelz" => 30,


    // 表情窓用のレベル指定。表情窓を使わない場合は void
	"faceLevelName" => 0,
	"faceApplyColor" => true, // 顔に対しても色味変更を適用するかどうか
//	"faceArea" => %[ name:"顔領域", width:324, height:288 ],
//	"faceZoom" => 100,


    "actions" => %[
		"おじぎ" => %[
			"module" => "LayerJumpOnceActionModule",
			"vibration" => 20,
			"cycle" => 2000,
			],
        "おじぎ小" => %[
            "module" => "LayerJumpOnceActionModule",
            "vibration" => 10,
            "cycle" => 1200,
            ],
        "おじぎ速" => %[
            "module" => "LayerJumpOnceActionModule",
            "vibration" => 5,
            "cycle" => 500,
            ],
        "おじぎ速大" => %[
            "module" => "LayerJumpOnceActionModule",
            "vibration" => 50,
            "cycle" => 1000,
            ],
        "おじぎ大" => %[
            "module" => "LayerJumpOnceActionModule",
            "vibration" => 50,
            "cycle" => 4000,
            ],
		"どっきり" => %[
			"module" => "LayerHeartBeatZoomModule",
			"time" => 200,
			"zoom" => 110,
			],
        "どっきり小" => %[
            "module" => "LayerHeartBeatZoomModule",
            "time" => 100,
            "zoom" => 103,
            ],
        "どっきり大" => %[
            "module" => "LayerHeartBeatZoomModule",
            "time" => 150,
            "zoom" => 150,
            ],
        "どっきり速" => %[
            "module" => "LayerHeartBeatZoomModule",
            "time" => 100,
            "zoom" => 108,
            ],
		"びょん" => %[
			"module" => "LayerJumpActionModule",
			"vibration" => -30,
			"cycle" => 1000,
			],
        "びょん小" => %[
            "module" => "LayerJumpActionModule",
            "vibration" => 6,
            "cycle" => 500,
            ],
        "びょん速" => %[
            "module" => "LayerJumpActionModule",
            "vibration" => 3,
            "cycle" => 300,
            "nowait" => true,
            ],
        "びょん速－" => %[
            "module" => "LayerJumpActionModule",
            "vibration" => -3,
            "cycle" => 300,
            "nowait" => true,
            ],
		"びょん待ち無" => %[
			"module" => "LayerJumpActionModule",
			"vibration" => -30,
			"cycle" => 1000,
			"nowait" => true,
			],
        "浮遊" => %[
            "module" => "LayerJumpActionModule",
            "vibration" => 5,
            "cycle" => 3000,
            "nowait" => true,
            ],
        "浮遊小" => %[
            "module" => "LayerJumpActionModule",
            "vibration" => 3,
            "cycle" => 3000,
            "nowait" => true,
            ],
        "浮遊速" => %[
            "module" => "LayerJumpActionModule",
            "vibration" => 5,
            "cycle" => 578,
            "nowait" => true,
            ],
        "浮遊速小" => %[
            "module" => "LayerJumpActionModule",
            "vibration" => 3,
            "cycle" => 2000,
            "nowait" => true,
            ],
        "浮遊止め" => %[
            "module" => "LayerJumpActionModule",
            "vibration" => 0,
            "cycle" => 1,
            ],
        "ガクガク" => %[
            "module" => "LayerVibrateActionModule",
            "vibration" => 3,
            "waittime" => 40
            ],
        "ガクガク大" => %[
            "module" => "LayerVibrateActionModule",
            "vibration" => 5,
            "waittime" => 40
            ],
        "うろうろ大" => %[
            "module" => "LayerWaveActionModule",
            "vibration" => 100,
            "cycle" => 5000,
            "nowait" => true,
            ],
        "うろうろ" => %[
            "module" => "LayerWaveActionModule",
            "vibration" => 50,
            "cycle" => 5000,
            "nowait" => true,
            ],
        "うろうろ小" => %[
            "module" => "LayerWaveActionModule",
            "vibration" => 10,
            "cycle" => 1000,
            "nowait" => true,
            ],
        "うろうろ小速" => %[
            "module" => "LayerWaveActionModule",
            "vibration" => 10,
            "cycle" => 500,
            "nowait" => true,
            ],

		"背伸び" => [
			%[ "top" => %[ handler:"MoveAction", value:"@+5", time:1000, accel:"acdec"] ],
			%[ "top" => %[ handler:"MoveAction", value:"@+3", time:300, accel:1] ],
			%[ "top" => %[ handler:"MoveAction", value:"@", time:500, accel:-1] ],
			],
		
		"がっくり" => [
			%[ "top" => %[ handler:"MoveAction", value:"@-10", time:500, accel:1] ],
			%[ "top" => %[ handler:"MoveAction", value:"@-5", time:300, accel:-1] ],
			],

		"ふるふる" => [
			%[ "left" => %[ handler:"MoveAction", value:"@-5", time:200, accel:"acdec"] ],
			%[ "left" => %[ handler:"MoveAction", value:"@+5", time:200, accel:"acdec"] ],
			%[ "left" => %[ handler:"MoveAction", value:"@-5", time:200, accel:"acdec"] ],
			%[ "left" => %[ handler:"MoveAction", value:"@+5", time:200, accel:"acdec"] ],
			%[ "left" => %[ handler:"MoveAction", value:"@", time:200, accel:"acdec"] ],
			],

		"ふるふる速" => [
			%[ "left" => %[ handler:"MoveAction", value:"@-5", time:100, accel:"acdec"] ],
			%[ "left" => %[ handler:"MoveAction", value:"@+5", time:100, accel:"acdec"] ],
			%[ "left" => %[ handler:"MoveAction", value:"@-5", time:100, accel:"acdec"] ],
			%[ "left" => %[ handler:"MoveAction", value:"@+5", time:100, accel:"acdec"] ],
			%[ "left" => %[ handler:"MoveAction", value:"@", time:100, accel:"acdec"] ],
			],

		"ふるふる小" => [
			%[ "left" => %[ handler:"MoveAction", value:"@-2", time:200, accel:"acdec"] ],
			%[ "left" => %[ handler:"MoveAction", value:"@+2", time:200, accel:"acdec"] ],
			%[ "left" => %[ handler:"MoveAction", value:"@-2", time:200, accel:"acdec"] ],
			%[ "left" => %[ handler:"MoveAction", value:"@+2", time:200, accel:"acdec"] ],
			%[ "left" => %[ handler:"MoveAction", value:"@", time:200, accel:"acdec"] ],
			],

		"ふるふる小速" => [
			%[ "left" => %[ handler:"MoveAction", value:"@-2", time:100, accel:"acdec"] ],
			%[ "left" => %[ handler:"MoveAction", value:"@+2", time:100, accel:"acdec"] ],
			%[ "left" => %[ handler:"MoveAction", value:"@-2", time:100, accel:"acdec"] ],
			%[ "left" => %[ handler:"MoveAction", value:"@+2", time:100, accel:"acdec"] ],
			%[ "left" => %[ handler:"MoveAction", value:"@", time:100, accel:"acdec"] ],
			],

		"こくこく" => [
