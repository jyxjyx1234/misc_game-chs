//-------------------------------------------------------------

with (SystemConfig) {
	var set = function (key, val) {
		if (typeof this[key] == "undefined")
			/**/   this[key] = val;
	} incontextof SystemConfig;

	set("ExChViewCaptureFileBase", typeof global.ENV_GameName == "String" ? global.ENV_GameName : "capture");
	set("ExChViewCaptureCaption",  "画面キャプチャ");
//	set("ExChViewAskRClickBack", false);// obsolete
	set("ExChViewRClickJumpTarget", "*view"); // *view, *back_rclick, *askquit のうちどれか
	set("ExChViewPropObjects", [
		"bg"  => "ExCVStageObject",
		"ch"  => "ExCVCharObject",
		"pop" => "ExCVPopupObject",
		"hide"=> "ExCVHideMesOnView",
		"drag"=> "ExCVDragObject",
		]);
	set("ExChViewDefines",   "exchview.ini");

	set("ExChViewSelectPanel", ""); // *changestage, *changetime 用パネルクラス

	// for char object module options
	set("ExChViewDefaultDiffName", "基本");
	set("ExChViewDefaultCharState", %[ ypos:0, xpos:0, opacity:255, front:true, "出"=>true ]);
	set("ExChViewCharLockedOpac", 256\4);
	set("ExChViewCharEmptyOnFirst", true);
	set("ExChViewCharUseOldPoseState", false);

	// for popup object options
	set("ExChViewPopupPos", [ 4, 4, 640, 32 ]);
//	set("ExChViewPopupImage", "exchview_popup");
	set("ExChViewPopupText", "左ドラッグで移動できます（右クリックで終了）");
	set("ExChViewPopupOnce", true);
	set("ExChViewPopupParam",
		%[
		x:4, y:4, w:640-8, h:32-8,
		fontface:global.SystemDefaultFontFace,
		fontheight: 24,
		color:0xFFFFFF, param: [ 255, true, 2048, 0, 2, 0, 0 ] ]);

	// for drag object options
	set("ExChViewDragCurCharOnNoView", true);
}
class ExCVUtil {
	property env { getter {
		try { return world_object.env; } catch {}
	} }
	property hasKagEnvChar { getter {
		return (typeof global.KAGEnvCharacter) == "Object";
	} }

	// グローバルフラグアクセス用ラッパー
	@if (! EXCHVIEW_GLOBALFLAG_IS_TF)
	function getGlobalFlag(tag)   { return sf["exchview"+tag];     }
	function setGlobalFlag(tag,v) {        sf["exchview"+tag] = v; }
	@endif
	@if (  EXCHVIEW_GLOBALFLAG_IS_TF)
	function getGlobalFlag(tag)   { return tf["exchview"+tag];     }
	function setGlobalFlag(tag,v) {        tf["exchview"+tag] = v; }
	@endif

	// 辞書操作ユーティリティ
	function copyArray(src, array = [], sft = 0) {
		with (array) {
			.assign(src);
			for (var i = 0; i < sft; i++) .shift();
			.remove("",   true);
			.remove(void, true);
		}
		return array;
	}
	function copyDic(src, ov) {
		var ret = %[];
		(Dictionary.assignStruct incontextof ret)(src);
		(Dictionary.assign       incontextof ret)(ov, false) if (ov !== void);
		return ret;
	}

	// 配列順繰り
	function roundList(list, idx, dir) {
		var cnt = list.count;
		idx += dir;
		while (idx < 0) idx += cnt;
		return idx % cnt;
	}

	function getIndex(list, val) { return list ? list.find(val) : -1; }
}

