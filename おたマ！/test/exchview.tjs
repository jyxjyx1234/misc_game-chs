				if (date !== void) with (date) {
					name += "%04d%02d%02d_%02d%02d%02d".sprintf(
						.getYear(),  .getMonth()+1, .getDate(),
						.getHours(), .getMinutes(), .getSeconds());
				}
				elm.name = elm.initialDir + "/" +name;
				if (Storages.selectFile(elm)) {
					try {
						if (ext == "bmp") kag.snapshotLayer.saveLayerImage   (elm.name, "bmp24");
						else {
							try { (global.Layer.fillAlpha   incontextof kag.snapshotLayer)(); } catch {}
							(global.Layer.saveLayerImagePng incontextof kag.snapshotLayer)(elm.name);
						}
					} catch (e) {
						System.inform(e.message);
					}
				}
			}
			kag.freeSnapshot();
		} catch (e) {
			dm(e.message);
		}
	}

}

SystemScript.script( "exchview");
SystemHook.add(      "exchview.leave", "dialog.done");
setSystemMenuStorage("exchview.ks");
