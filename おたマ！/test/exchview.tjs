		if (now != "" && now == old) onCharDoubleClick();
		clearCurrentCharState();
		setGlobalFlag("Char",  curChar);
	}
	function onCharDoubleClick { lock(); }
	function onDressChanged { charRedraw.dress = curDress; }
	function onDiffChanged  { charRedraw.diff  = curDiff; }
	function onFaceChanged  { charRedraw.face  = curFace; }
	function onLevelChanged {
		setGlobalFlag("Level", curLevel);
		if (hasKagEnvChar) charRedraw.level = curLevel;
		else if (curLevel !== void && levelZpos) {
			charRedraw.zpos = levelZpos[+curLevel];
		}
	}

	function remove() {
		charDelete = curChar;
		curChar = void;
		clearCurrentCharState();
	}
	var _lockedMap = %[];
	function getCharState(name, forceShow, elm = %[]) {
		if (elm) addTagParam(elm, "opacity", forceShow ? 255 : lockedOpac);
		return elm;
	}
	function makeElement(tagname, elm) {
		if (typeof global.insertTagParam == "Object")
			/**/   global.insertTagParam(elm, "tagname", tagname);
		return elm;
	}
	function addTagParam(elm, name, value = true) {
		if (typeof global.addTagParam == "Object")
			/**/   global.addTagParam(elm, name, value);
		else elm[name] = value;
	}
	function lock() {
		if (curChar != "") {
			var state = (_lockedMap[curChar] = !_lockedMap[curChar]);
			if(!state) delete _lockedMap[curChar];
			updateLockMarks();
		}
	}
	function isLocked(name = curChar) { return name != "" && !!_lockedMap[name]; }
	function foreachLocked(cb, *) { foreach(_lockedMap, cb, *); }
	function onViewStart(elm) {
		var ins = kag.insertTag;
		foreachLocked(function (k, v, d, ins) {
			if (k != "" && v && k != curChar) ins(k, getCharState(k, -1));
		} incontextof this, ins);
		if (curChar != "") ins(curChar, getCharState(curChar, -1));
	}
	function onViewEnd(elm) {
		var ins = kag.insertTag;
		foreachLocked(function (k, v, d, ins) {
			if (k != "" && v && k != curChar) ins(k, getCharState(k,  0));
		} incontextof this, ins);
		if (curChar != "") ins(curChar, getCharState(curChar, 1));
	}

	function onRedraw(add) {
		//dm("onRedraw", curChar, charRedraw ? StructToString(charRedraw) : void);
		if (charDelete != "") {
