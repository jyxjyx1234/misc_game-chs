 */

addKagHandler("exchview_panel", function(elm) {
	var panel = SystemConfig.ExChViewSelectPanel;
	if (panel != "") {
		elm["class"] = panel;
		return tagHandlers.panel(elm);
	}
	return 0;
}, true);
addKagHandler("extramode_bg", function(elm) {
	var elm = %[], tag, get = ExtraCharaView.getGlobalFlag;
	if ((tag = get("Stage")) != "") elm.stage = tag;
	if ((tag = get("Time" )) != "") elm.stime = tag;
	insertTag("stage", elm);
	return 0;
}, true);



