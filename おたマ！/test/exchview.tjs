class        ExCVPropObjectBase extends ExCVUtil {
	function ExCVPropObjectBase(owner, name) {
		this.owner = owner;
		this.name  = name;
	}
	function finalize {}
	var owner, name;
	var propTable = [];

	function _debugCheckProp(prop) {
		if (propTable.find(prop) < 0) {
			dm("! 未定義のプロパティです", name, prop);
			return true;
		}
	}
	function _getPropItem(prop, tag, force) {
		@if (DEBUG)
			if (!force && _debugCheckProp(prop)) return;
		@endif
		if (tag == "") return this[@"cur${prop}"];
		var method = @"get${prop}${tag}";
		if (typeof this[method] == "Object")
			return this[method]();
	}
	function _setPropItem(prop, val, force) {
		@if (DEBUG)
			if (!force && _debugCheckProp(prop)) return;
		@endif
		this[@"cur${prop}"] = val;
	}
	function invoke(method, *) {
		if (typeof this[method] == "Object")
			return this[method](*);
	}
	function callHook(  method, *) {
		var r;
		if (typeof this[method] == "Object")
			r =    this[method](*);
		if (r === void) r = ownerCallback(...);
		return r;
	}
	function ownerCallback(method, *) {
		if (typeof owner[method] == "Object")
			return owner[method](this, *);
	}
	function setProp(prop, val, force) {
		var list = _getPropItem(prop, "List", force);
		if (list === void) {
			dm("! プロパティがありません", name, prop);
			return;
		}
		var idx, dir = 0;
		switch (val) {
		case "up":
		case "down":
			dir = (val == "down") ? -1 : 1;
			idx = list.find(_getPropItem(prop,, force));
			if (idx < 0) idx = 0;
			else idx = roundList(list, idx, dir);
			break;
		default:
			idx = (int)+val;
			if (idx < 0 || idx >= list.count) idx = 0;
			break;
		}
		var old = _getPropItem(prop,, force);
		var fix = callHook(@"on${prop}Change", old, list, idx, dir);
		if (fix !== void) idx = fix;
		var now = list[idx];
		_setProp(prop, now, old, force);
	}
	function _setProp(prop, now, old, force) {
		callHook("onBeforeSetProp", prop, now, old);
		_setPropItem(prop, now, force) if (typeof this[@"cur${prop}"] != "undefined");
		callHook(@"on${prop}Changed", now, old);
		callHook("onAfterSetProp",  prop, now, old);
		ownerCallback("onPropChanged", name, prop, now);
	}
	function getProp(prop) { return _getPropItem(...); }
}
class        ExCVCharObject extends ExCVPropObjectBase {
	function ExCVCharObject { super.ExCVPropObjectBase(...); }
	function finalize { super.finalize(...); }

	var propTable = [ "Char", "Dress", "Diff", "Face", "Level" ];
	var curChar, curDress, curDiff, curFace, curLevel;

	var charNames  =  [];
	var charDress  = %[];
	var charDiffs  = %[];
	var charSubDress = %[];
	var charSubDiffs = %[];

	var levelNums   = [];
	var levelZpos;
	var curDiffList = [];
	var curFaceList = [];
	var charRedraw, charDelete;

	var lastChar, lockedOpac;
	function onInit() {
		lockedOpac = SystemConfig.ExChViewCharLockedOpac;
	}
	function onLoadHead(line, num) {
		var zpos = !hasKagEnvChar;
		if (zpos) levelZpos = [];
		for (var i = 1, p = env.positions; i < line.count; i++) {
			var name = line[i], succeeded = false;
			if (name == "") continue;
			if (p[name] !== void) {
				if        ( zpos && p[name].zpos  !== void) {
					var level = levelNums.count;
					levelNums.add(level);
					levelZpos[level] = p[name].zpos;
					succeeded = true;
				} else if (!zpos && p[name].level !== void) {
					levelNums.add((int)p[name].level);
					succeeded = true;
				}
			}
			dm("! 不明なレベル名", num, name) if (!succeeded);
		}
		//dm("char", levelNums*) if (levelNums.count > 0);
		lastChar = void;
	}
	function onLoadInfo(line, num) {
		var name = line[1];
		if (name != "") {
			if (charDress[name] !== void) dm("! 多重定義char", num, name);
			else {
				var dresses = charDress[name] = copyArray(line, [], 2);
				charDiffs[name] = [ SystemConfig.ExChViewDefaultDiffName ];
				charNames.add(name);
				lastChar = name;
				//dm(name, dresses.join(", "));
			}
		} else if (line.count > 2) {
			if (lastChar == "") dm("! キャラ指定なし", num);
			else {
				var diffs = copyArray(line, charDiffs[lastChar], 2);
				//dm(lastChar, diffs.join(", "));
			}
		}
	}
	function onLoadEnd() {
		lastChar = void;
		setupSubList();

		charNames.unshift(void) if (SystemConfig.ExChViewCharEmptyOnFirst);
		curChar = getGlobalFlag("Char");
		curChar = void if (curChar == "" || charNames === void || charNames.find(curChar) < 0);
		clearCurrentCharState(curChar != "");
		if (curChar != "") {
			curDress = getGlobalFlag("CharDress");
			curDiff  = getGlobalFlag("CharDiff");
			curFace  = getGlobalFlag("CharFace");
		}

		// レベル指定初期値
		curLevel = getGlobalFlag("Level");
		curLevel = void if (getLevelIndex() < 0);
		if (curLevel === void && hasKagEnvChar) try {
			curLevel = env.envinfo.defaultLevel;
		} catch {}
	}
	function setupSubList() {
		for (var i = charNames.count-1; i >= 0; i--) {
			var name = charNames[i];
			makeSubList(charSubDress, name, charDress[name]);
			makeSubList(charSubDiffs, name, charDiffs[name]);
			//dm("subdress", StructToString(charSubDress));
			//dm("subdiffs", StructToString(charSubDiffs));
		}
	}
	// 服装や差分の定義に | の組み合わせで複数マップされる場合のテーブルを作成する
	function makeSubList(map, name, list) {
		for (var i = list.count-1; i >= 0; i--) {
			var tag = list[i], idx;
			if (tag == "" || (idx=tag.indexOf("|")) < 0) continue;
			var sub = %[], defval;
			if (idx == 0) {
				// 冒頭が | の場合は bit binding モード
				tag = tag.substr(1);
				sub.bitmode = true;
			}
			var div = tag.split("|",,true);
			for (var n = div.count-1; n >= 0; n--) {
				if (div[n] == "") div[n] = void;
				else {
					if (div[n].charAt(0) == "*") {
						div[n] = defval = div[n].substr(1);
					}
				}
			}
			div.remove(void, true);
			if (defval == "")
				defval = div[0];

			sub.list = div;
			sub.defval = list[i] = defval;

			if (sub.bitmode) {
				var bit = 0;
				for (var n = 1, cnt = div.count; n < cnt; n<<=1) bit++;
				sub.bitmode = bit;
				//dm("bitmode", tag, bit);
			}

			if (map[name] === void)
				map[name] = %[];

			var ent = map[name];
			if (ent[defval] !== void)
				dm("! submap conflict", name, tag, defval);

			/**/ent[defval] = sub;
			for (var n = div.count-1; n >= 0; n--) {
				var item = div[n];
				if (item == defval) continue;
				if (ent[item] !== void)
					dm("! submap conflict", name, tag, item);
				/**/ent[item] = defval;
			}
		}
	}

	// List Getters
	function getCharList  { return charNames; }
	function getDressList { return (curChar  != "") ? charDress[curChar] : void; }
	function getDiffList  { return (curChar  != "") ? charDiffs[curChar] : void; }
	function getFaceList  { return (curChar  != "") ? curFaceList : void; }
	function getLevelList { return levelNums;  }

	// Enabled Getters
	function makeEnabledList(list) {
		if (list === void) return;
		var r = [];
		for (var i = 0; i < list.count; i++) {
			r[i] = (list[i] != "" && list[i] != "-");
		}
		return r;
	}
	function getDressEnabled { return makeEnabledList(getDressList()); }
	function getDiffEnabled  {
		var list = getDiffList();
		var r = makeEnabledList(list);
		if (r !== void && list !== void && curDiffList !== void) {
			var map = %[];
			for (var i = 0; i < curDiffList.count; i++)
				map[curDiffList[i]] = true;
			for (var i = 0; i < list.count; i++)
				if (list[i] != "" && !map[list[i]]) r[i] = false;
		}
		return r;
	}

	// Index Getters
	function getCharIndex  { return getIndex(getCharList(),  curChar); }
	function getFaceIndex  { return getIndex(getFaceList(),  curFace); }
	function getLevelIndex { return getIndex(getLevelList(), curLevel); }
	function getDiffIndex  { return getIndexWithSubMap(getDiffList (), curDiff,  getSubDiffMap ); }
	function getDressIndex { return getIndexWithSubMap(getDressList(), curDress, getSubDressMap); }
	function getSubDiffIndex  { return _getSubIndex(curDiff,  getSubDiffMap);  }
	function getSubDressIndex { return _getSubIndex(curDress, getSubDressMap); }

	function getIndexWithSubMap(list, tag, submap) {
		var r = getIndex(list, tag);
		if (r >= 0) return r;
		var sub = submap(curChar, tag);
		if (sub !== void) return getIndex(list, sub.defval);
		return -1;
	}
	function getSubDiffMap (ch=curChar, diffs=curDiff ) { return _getSubMap(charSubDiffs, ch, diffs); }
	function getSubDressMap(ch=curChar, dress=curDress) { return _getSubMap(charSubDress, ch, dress); }
	function _getSubMap(map, ch, tag) {
		if (ch == "" || tag == "") return;
		var sub = map[ch];
		if (sub !== void) {
			var r = sub[tag];
			if (typeof r == "String" && r != "") r = sub[r];
			return r;
		}
	}

	function _getSubIndex(tag, sub) {
		if (typeof sub == "Object" &&
			sub instanceof "Function") sub = sub(curChar, tag);
		if (sub !== void) return getIndex(sub.list, tag);
		return -1;
	}
	function _setSubIndex(prop, tag, idx, sub) {
		if (sub === void) sub = this[@"setSub${prop}Map"](curChar, tag);
		if (sub !== void) {
			var set;
			if (!sub.bitmode) set = sub.list[idx];
			else {
				var n = getIndex(sub.list, tag);
				if (n >= 0) {
					n ^= (1<<idx);
					set = sub.list[n];
				}
			}
			_setProp(prop, set, tag) if (set != "");
		}
	}
	function getSubMap {
		var sub;
		if ((sub=getSubDressMap(curChar, curDress)) !== void) return sub;
		if ((sub=getSubDiffMap (curChar, curDiff )) !== void) return sub;
	}
	function getSubIndex {
		var sub;
		if ((sub=getSubDressMap(curChar, curDress)) !== void) return _getSubIndex(curDress, sub);
		if ((sub=getSubDiffMap (curChar, curDiff )) !== void) return _getSubIndex(curDiff,  sub);
		return -1;
	}
	function setSubIndex(idx) {
		var sub;
		if ((sub=getSubDressMap(curChar, curDress)) !== void) return _setSubIndex("Dress", curDress, idx, sub);
		if ((sub=getSubDiffMap (curChar, curDiff )) !== void) return _setSubIndex("Diff",  curDiff,  idx, sub);
	}

	function getCharacter(name = curChar) {
		if (name == "") return;
		try { // バージョンにより取得方法が異なる
			return hasKagEnvChar ? env.characters[name] :  env.objects[name];
		} catch {}
	}
	function getCharacterOptions(ch) {
		if (!hasKagEnvChar) return ch.getOptions();
		if (SystemConfig.ExChViewCharUseOldPoseState) {
			// KAGEnvCharacter時
			var dress = ch.dress;
			var pose  = ch.pose;
			var face  = ch.face;
			if (typeof ch.diff == "undefined") try {
				if (pose == "") pose = ch.init.defaultPose;
				if (ch.poses !== void && pose != "") {
					var poseInfo = ch.poses[pose];
					if (poseInfo !== void) {
						if (dress == "") dress = poseInfo.defaultDress;
						if (face  == "") face  = poseInfo.defaultFace;
					}
				}
			} catch {}
			return %[ dress:dress, diff:pose, face:face, level:ch.level ];
		}
	}
	function getCharacterDress(ch, opt) { return opt ? opt.dress : ch.dress; }
	function getCharacterDiff (ch, opt) { return opt ? opt.diff  : ch.diff; }
	function getCharacterFaceAliasList(ch, opt) {
		// [TODO] 新方式でのfgAliasListの取得方法
		return opt ? void : ch.getStandInfo(ch.pose).fgAliasList;
	}
	function getCharacterFace (ch, opt) {
		var face = opt ? opt.face : ch.face;
		// 組み合わせの場合はエイリアス検索
		if (face != "" && face.indexOf(":") >= 0) {
			var chk  = face.split(":");
			var list = getCharacterFaceAliasList(ch, opt);
			if (list) for (var i = 0; i < list.count; i++) {
				var tag = list[i].name;
				var grp = list[i].value, found = true;
				for (var j = 0; j < grp.count; j++) {
					found &&= (chk.find(grp[j]) >= 0);
					if (!found) break;
				}
				if (found) {
					face = tag;
					break;
				}
			}
		}
		return face;
	}
	function getCharacterLevel(ch, opt) {
		if (!opt || hasKagEnvChar) return ch.level;
		var zpos  = ch.getPropValue("zorder");
		var level = levelZpos.find(zpos);
		return level >= 0 ? level : 0;
	}
	function getCharacterDiffList(ch, opt) {
		if (!opt) try { return ch.getDiffNames(false); } catch {}
		else if (hasKagEnvChar) try { return ch.getPoseNames(false); } catch {}
		else if         (ch.imageSource instanceof "StandAffineSourceLayer") {
			try { return ch.imageSource._standImage.getPoseNames(false); } catch {}
		}
		return []; // fail safe
	}
	function getCharacterFaceList(ch, opt) {
		var list;
		if (!opt || hasKagEnvChar) try { list = ch.getFaceNames(true); } catch {}
		else if         (ch.imageSource instanceof "StandAffineSourceLayer") {
			try { list = ch.imageSource._standImage.getFaceNames(true); } catch {}
		}
		var r = [];
		if (list) for (var i = 0, cnt = list.count; i < cnt; i++) {
			r.add(list[i]) if (list[i].indexOf("_") < 0);
		}
		return r;
	}

	function updateCurrentCharState() {
		clearCurrentCharState(true);
		var ch = getCharacter();
		if (ch === void) return;
		var opt  = getCharacterOptions(ch);
		internalUpdateCurrentCharState(ch, opt);
	}
	function internalUpdateCurrentCharState(ch, opt) {
		curDress = getCharacterDress(ch, opt);
		curDiff  = getCharacterDiff (ch, opt);
		curFace  = getCharacterFace (ch, opt);
		curLevel = getCharacterLevel(ch, opt);
		setGlobalFlag("CharDress",  curDress);
		setGlobalFlag("CharDiff",   curDiff);
		setGlobalFlag("CharFace",   curFace);

		curDiffList.assign(getCharacterDiffList(ch, opt));
		curFaceList.assign(getCharacterFaceList(ch, opt));
		ownerCallback("onUpdateCurrentCharState", curFaceList);
	}
	function clearCurrentCharState(gfnoclear) {
		curDress = curDiff = curFace = void; //curLevel = void;
		curDiffList.clear();
		curFaceList.clear();
		if (!gfnoclear) {
			setGlobalFlag("CharDress", void);
			setGlobalFlag("CharDiff",  void);
			setGlobalFlag("CharFace",  void);
		}
	}
	function onBeforeSetProp(prop, val) {
