//	function onCharChange   {}
//	function onDressChange  {}
	function onDiffChange(old, list, idx, dir) {
		if (!curDiffList.count) return;
		for (var i = list.count-1; i >= 0; i--) {
			if (curDiffList.find(list[idx]) >= 0) break;
			idx = roundList(list, idx, dir);
		}
		return idx;
	}
//	function onFaceChange   {}
//	function onLevelChange  {}

	function onCharChanged(now, old) {
