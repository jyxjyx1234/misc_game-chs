class ExChViewDragMaskLayer extends Layer {
	var owner, dragging;
	var basex, basey, lastdir;
	function ExChViewDragMaskLayer(owner, win, par) {
		super.Layer(win, par);
		this.owner = owner;
		hasImage = false;
		name = "ドラッグマスク";
		dragging = void;
	}
	function finalize() { super.finalize(...); }

	function init(target) {
		parent   = target.parent;
		absolute = target.absolute-1;
		setPos(0, 0, parent.width, parent.height);
		hitType = htMask;
		hitThreshold = 0;
		visible = true;
	}
	function onMouseDown(x, y, btn, sft) {
		if (btn == mbRight) {
			var r = super.onMouseDown(...);
			releaseCapture();
			window.onPrimaryRightClick();
			return r;
		} else if (btn == mbLeft) {
			dragging = owner.onDragStart(sft);
			if (dragging !== void) with (dragging) {
				if      ( .xonly && !.yonly) cursor = crSizeWE;
				else if (!.xonly &&  .yonly) cursor = crSizeNS;
				else                         cursor = crSizeAll;
				basex = x;
				basey = y;
				lastdir = void;
			} else {
				window.onPrimaryClick();
				cursor = defaultCursor;
			}
		}
		return super.onMouseDown(...);
	}
	function onMouseMove(x, y) {
		if (dragging !== void) with (dragging) {
			var dx = (x - basex);
			var dy = (y - basey);
			if (.xonly || .yonly) {
				if (.xonly) dy = 0;
				if (.yonly) dx = 0;
			} else if (!.free) {
				if (dx || dy) {
					if (lastdir === void) {
						lastdir = Math.abs(dx) > Math.abs(dy);
						cursor = lastdir ? crSizeWE : crSizeNS;
					}
					else if (lastdir) {
						if (Math.abs(dy) > Math.abs(dx*2)) {
							lastdir = false;
							cursor  = crSizeNS;
						}
					} else {
						if (Math.abs(dx) > Math.abs(dy*2)) {
							lastdir = true;
							cursor  = crSizeWE;
						}
					}
				}
				if (lastdir) dy = 0;
				else dx = 0;
			}
			owner.onDragging(dragging, dx, dy);
		}
	}
	function onMouseUp(x, y, btn, sft) {
		dragging = void;
		cursor = defaultCursor;
		return super.onMouseDown(...);
	}

	var _defcur;
	property defaultCursor {
		getter { return _defcur !== void ? _defcur : window.cursorDefault; }
		setter(v) {
			if (v === void) v = window.cursorDefault;
			var reset = (cursor == _defcur);
			_defcur = v;
			if (reset) cursor = v;
		}
	}
}

