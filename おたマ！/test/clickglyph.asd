;! clipleft=0 cliptop=0 clipwidth=22 clipheight=22
*loop
	@jump target=*auto cond=kag.autoMode

	@clip left=&22*0 top=0
	@wait time=100

	@clip left=&22*1 top=0
	@wait time=100

	@clip left=&22*2 top=0
	@wait time=100

	@clip left=&22*3 top=0
	@wait time=100

	@clip left=&22*4 top=0
	@wait time=100

	@clip left=&22*5 top=0
	@wait time=100

	@clip left=&22*6 top=0
	@wait time=100

	@clip left=&22*7 top=0
	@wait time=100

	@clip left=&22*8 top=0
	@wait time=100

	@clip left=&22*9 top=0
	@wait time=100

	@clip left=&22*10 top=0
	@wait time=100

	@clip left=&22*11 top=0
	@wait time=100

	@jump target=*loop

*auto
	@clip left=&22*0 top=22
	@wait time=75

	@clip left=&22*1 top=22
	@wait time=75

	@clip left=&22*2 top=22
	@wait time=75

	@clip left=&22*3 top=22
	@wait time=75

	@clip left=&22*4 top=22
	@wait time=75

	@clip left=&22*5 top=22
	@wait time=75

	@clip left=&22*6 top=22
	@wait time=75

	@clip left=&22*7 top=22
	@wait time=75

	@clip left=&22*8 top=22
	@wait time=75

	@clip left=&22*9 top=22
	@wait time=75

	@clip left=&22*10 top=22
	@wait time=75

	@clip left=&22*11 top=22
	@wait time=75

	@jump target=*loop
