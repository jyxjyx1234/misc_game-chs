class        CustomExtraCharaView extends ExtraCharaViewBase {
	function CustomExtraCharaView { super.ExtraCharaViewBase(...); }
	function finalize { super.finalize(...); }

	function onUiload(elm) {
		elm.partremove = "remove";
		return super.onUiload(...);
	}
	var _uiNum, _uiName;
	function onUiloaded(elm, ui) {
		_uiNum  = ui.num;
		_uiName = ui.chname;
		var nodrag = kag.current.names.nodrag;
		if (nodrag) with (nodrag) {
			.absolute = .opacity = 0;
			try { .copyAlphaToProvince(); } catch {}
		}
		return super.onUiloaded(...);
	}

	function onDragStart {
		var r = super.onDragStart(...);
		if (r && !r.range) with (r) {
			.free = true;
			.range = true;
			.minx = -640;
			.maxx =  640;
			.miny = -400;
			.maxy =  800;
		}
		return r;
	}

	var _chnameReplace = %[
		"ケリー" => "sp",
		"立ち絵鑑賞あめり大" => "あめり(大)",
		];
	function toggleButtonIndex(obj, names, base, idx, vis, ens) {
		if (base == "char") {
			var lay = names.chname;
			if (lay !== void) with (lay) {
				var vis = (idx >= 0), tag = "なし";
				if (vis) {
					var list = callMethod(obj, "getCharList");
					if (list && list[idx] != "") {
						tag = list[idx];
						tag = _chnameReplace[tag] if (_chnameReplace[tag] != "");
					}
				}
				.fillRect(0, 0, .width, .height, 0);
				._copyButtonUIStates(0, _uiName, void, tag) if (tag != "");
			}
		} else {
			var vis = (idx >= 0);
			idx += 1;
			drawNumber(names[base+"100"], (idx \ 100) % 10, vis);
			drawNumber(names[base+"010"], (idx \  10) % 10, vis);
			drawNumber(names[base+"001"], (idx      ) % 10, vis);
			if (names[base+"_up"])
				names[base+"_up"].enabled = vis;
			if (names[base+"_dw"])
				names[base+"_dw"].enabled = vis;
		}
	}
	function drawNumber(lay, num, vis, ui = _uiNum) {
		if (lay) with (lay) {
			.visible = true; //vis;
			.fillRect(0, 0, .width, .height, 0);
			._copyButtonUIStates(0, ui, void, vis ? (string)num : "0");
		}
	}
}
