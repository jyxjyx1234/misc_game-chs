addKagHandler("endreplay", function(elm) {
	sflags["flag_"+elm.flag] = true if (elm.flag != "");
	return isRecollection ? tagHandlers.endrecollection(...) : 0;
}, true);

// サスペンドセーブ
var SuspendSaveTag = "continue";
function DoSuspendSave() {
	switch (SystemHook.currentState) {
	case "game":
	case "sysmenu":
		break;
	case "save": case "load": case "option":
		if (Current.propget("fromTitle")) return false;
		break;
	default:
		return false;
	}
	if (kag.isRecollection) return false;

	try { kag.addBookMarkInfo("lastText", kag.historyLayer.currentText); } catch {}
	SystemAction._preSave();
	kag.saveBookMarkToFile(kag.getBookMarkFileNameBySystem(SuspendSaveTag));
	kag.freeSnapshot();
	return true;
}
addKagHandler("suspendsave", function(elm) {
	DoSuspendSave();
	return 0;
}, false);
addKagHookCallback("onCloseYes", function {
	DoSuspendSave();
}, false);
addAfterInitCallback(function {
	kag.goToStartOrig = kag.goToStart;
	kag.goToStart = function {
		DoSuspendSave();
		return goToStartOrig(...);
	} incontextof kag;

	loadTrigger.instance.loadHooks.continue = %[
	callback:function {
		loadBookMarkFromFile(getBookMarkFileNameBySystem(SuspendSaveTag));
		return true;
	} incontextof kag ];
});

KAGWindow.getBookMarkFileNameBySystem = function (tag) { return getBookMarkFileName("_"+tag) + (tag==SuspendSaveTag?".bmp":".ksd"); } incontextof null;

