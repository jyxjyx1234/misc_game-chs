// 設定画面

with (SystemConfig) {
	var yn = function (exp) { return exp ? "true" : "false"; };
	//                   tag             default
	createPropertyProxy("askQSave",     yn(._askQSave),     /*scflags*/, "!!", SystemConfig);
	createPropertyProxy("askQLoad",     yn(._askQLoad),     /*scflags*/, "!!", SystemConfig);
	createPropertyProxy("askSave",      yn(._askSave),      /*scflags*/, "!!", SystemConfig);
	createPropertyProxy("askLoad",      yn(._askLoad),      /*scflags*/, "!!", SystemConfig);
	createPropertyProxy("askOverwrite", yn(._askOverwrite), /*scflags*/, "!!", SystemConfig);
	createPropertyProxy("askMove",      yn(._askMove),      /*scflags*/, "!!", SystemConfig);
	createPropertyProxy("askCopy",      yn(._askCopy),      /*scflags*/, "!!", SystemConfig);
	createPropertyProxy("askDelete",    yn(._askDelete),    /*scflags*/, "!!", SystemConfig);

	createPropertyProxy("rclickBind", "'hide'", /*scflags*/, "(string)", SystemConfig);
}

OptionBase.voiceNames = SystemConfig.defaultVoiceNames;
class CustomOption extends OptionBase {
	var testvoice;
	function CustomOption {
		super.OptionBase(...);
		_page = (int)+sf.systemPage;

		addCheckItem("bgmDown", "bgmdown", "_bgmDown");

		addUpdate("updateHideMouseCursor", updateHideMouseCursor);
		addUpdate("updateShortCutKey", updateShortCutKey);
//		addUpdate("updateFontType", updateFontType);
		addUpdate("updateRclickBind", updateRclickBind);
		addUpdate("updateFinishType", updateFinishType);
		addUpdate("updateBgmDownVolume", updateBgmDownVolume);

		testvoice = new VoiceTrack(this);
		testvoice.voiceName = "";

		initSpeedSample();
	}
	function finalize() {
		termSpeedSample();
		invalidate testvoice if (testvoice !== void);
		_setBgmDown(false);
		super.finalize(...);
	}
	function onUiload(elm) {
		elm.partremove = "remove";
	}

	var _initTag;
	function initialEnvironment() {
		Debug.message("*** init", _initTag);
		global.initialEnvironment(false, _initTag);
		stopSampleVoice();
	}
	function init(tag) {
		_initTag = tag;
		setDefault(true, true);
	}

	var pagetabs = [ "sys", "snd" ];
	property storage { getter { return "opt_"+pagetabs[page]; } }
	var _page;
	property page {
		getter { return (int)+_page; }
		setter(v) {
			var n = (int)v, cnt = pagetabs.count;
			while (n < 0) n += cnt;
			n = n % cnt;
			sf.systemPage = _page = n;
		}
	}
	function onUiloaded(elm, ui) {
		var names = kag.current.names;
		if (names["page"+page] !== void)
			names["page"+page].toggle = true;

		setupShortcutUI(ui);
	}

	//------------------------------
	// ミュートボタン対応

	function addOnOffItem(tag, name, offname, getprop, setprop) {
		switch (name) {
		case "wave": case "bgm": case "se": case "sysse": case "voice":
			return addCheckItem(tag, name+"mute", getprop, setprop, true);
		}
		return super.addOnOffItem(...);
	}

	//------------------------------
	// ボイスBGMダウン
	property _bgmDown  { setter(v) { kag.bgmdown = !!v; updateBgmDownVolume();  } getter { return !!kag.bgmdown;  } }
	var _ignoreBgmSlider;
	function updateBgmVolume { _ignoreBgmSlider = true; super.updateBgmVolume(...); updateBgmDownVolume(); }
	function updateBgmDownVolume() {
		_ignoreBgmSlider = true;
		updateVolume("downvolume",  (int)(kag.bgmdownlevel * kag.bgmvolume / 100), _bgmDown);
		_ignoreBgmSlider = false;
	}
	function onBgmDownChanged  (pos, drag) {
		if (_ignoreBgmSlider) return;
		var bgm = kag.bgmvolume, bgmupd = false;
		if (pos > bgm) {
			bgm = kag.bgmvolume = pos;
			bgmupd = true;
		}
		kag.bgmdownlevel = bgm > 0 ? (pos * 100 / bgm) : 0;
//		kag.bgmdown = kag.bgmdownlevel < 100;
		if (bgmupd) updateBgmVolume();
		else updateBgmDownVolume();
	}
	function onBgmVolumeChanged(pos, drag) {
		if (_ignoreBgmSlider) return;
		kag.bgmvolume = pos;
		updateBgmVolume();
	}

	//------------------------------
	// 中／外選択
	function updateFinishType {
		var type = (int)+sf.hseltype;
		var tag = type < 0 ? "in" : type > 0 ? "out" : "sel";
		setItemProp("finish_"+tag, "toggle", true);
	}
	function setFinish(sel) {
		sf.hseltype = (int)+sel;
	}

	//------------------------------
	// 個別ボイス設定

	function updateVoice() {
		for (var i = _voiceNames.count-1; i >= 0; i--)
			updateVoiceOne(i);
	}
	function updateVoiceOne(i) {
		i = (int)+i;
		var name = _voiceNames[i];
		var en = kag.getVoiceOn(name);
		var vol = kag.getVoiceVolume(name, true);
		var tag = "ch"+i;
		setItemProp(tag+"mute", "toggle", !en);
		updateVolume(tag+"volume", vol,  !!en);
	}
	var ignoreChVoiceChange;
	function changeChVoiceVol(pos, drag, num) {
		if (ignoreChVoiceChange) return;
		var name = _voiceNames[(int)+num];
		kag.setVoiceVolume(name, pos);
		if (drag) resetSampleVoiceVolume(name);
		else      playSampleVoice(name);
	}
	function testVoice(num) {
		playSampleVoice(_voiceNames[(int)+num]);
	}
	function setChVoice(num,on) {
		var name = _voiceNames[(int)+num];
		if (on == "toggle") {
			on = !kag.getVoiceOn(name);
		}
		kag.setVoiceOn(name, !!on);
		updateVoiceOne(num);
		resetSampleVoiceVolume(name);
	}

	function updateVolume(name, value, enable, rad) {
		ignoreChVoiceChange = true;
		setItemProp(name, "position", value);
		ignoreChVoiceChange = false;
		if (enable !== void) {
			setItemEnabled(name, enable);
