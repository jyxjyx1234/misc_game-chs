//--------------------------------------------------------------
// クイックロードポップアップ

class        QLoadPopupLayer extends DialogLayer {
	function QLoadPopupLayer(win) {
		coverParent = false;
		super.DialogLayer(win, win.primaryLayer, "QLPopup");
		_ui = uiload(%[ storage: "qlpopup", transparent:true, visible:false, color:0, opacity:0 ]);
		origLeft = left;
		origTop  = top;

		hitType = htMask;
		hitThreshold = 256;
		joinFocusChain = false;
		focusable = false;
//		parent  = window.primaryLayer;
		absolute = 2000000 + 1;
		win.add(this);
	}
	var origLeft, origTop, _ui;

	function finalize() {
		if (isvalid this) stopAction(this);
		super.finalize(...);
	}
	function beginAction() { window.beginAction(...); }
	function stopAction()  { window.stopAction( ...); }

	function drawItem(datanum = SystemAction.qsaveBookmarkNumber) {
		try {
			var info = getItemInfo(datanum), target;
			if (info === void) return false;

			CustomSaveLoad.drawItemOne(names, info, void);

			with (target = names.thumb) {
				var w = .width, h = .height;
				.fillRect(0, 0, w, h, 0xFF000000);
				try { .loadImages(info.thumbnail); } catch {}
				(global.Layer.setSize incontextof target)(w, h);
			}
		} catch {
			return false;
		}
		return true;
	}
	function drawItemText { return CustomSaveLoad.drawItemText(...); } // [XXX] Proxy

	var _fadeTime = 100, _move = 8;
	function show(x,y,dn) {
		if (!isvalid this) return;
		stopAction(this);
		if (!drawItem(dn)) return;
		left = (x !== void ? +x : origLeft);
		top  = (y !== void ? +y : origTop ) +  _move;
		beginAction(this, %[ top: %[ handler:MoveAction, start:top, value:top - _move, time:_fadeTime, accel:-1 ],
						 opacity: %[ handler:MoveAction, start:(opacity=0), value:255, time:_fadeTime ] ],, true);
		visible = true;
	}
	function hide() {
		if (!isvalid this) return;
		stopAction(this);
		if (visible)
			beginAction(this, %[ opacity:%[ handler:MoveAction, start:(opacity=255), value:0, time:_fadeTime ] ],
						function { if (isvalid this) visible = false;  } incontextof this, true);
	}
	function getItemInfo(datanum) {
		var file, info = %[];
		if (typeof datanum == "Integer") {
			file = kag.getBookMarkFileNameAtNum(datanum);
			if (!Storages.isExistentStorage(file)) return void;

			var bookmark  = kag.getBookMarkInfo(datanum);
			(Dictionary.assign incontextof info)(bookmark, true) if (bookmark !== void);

			info.title     = kag.getBookMarkPageName(datanum);
			info.realdate  = kag.getBookMarkDate(datanum);
		} else if (typeof datanum == "String" && datanum != "") {
			file = datanum;
			if (!Storages.isExistentStorage(file)) return void;

			var data = kag.readBookMarkFromFile(file);
			if (!data || !data.core) return false;
			with (data.core) {
				(Dictionary.assign incontextof info)(.bookMarkInfo) if (.bookMarkInfo !== void);

				info.title     = .currentPageName;

				// [XXX] Copy&Paste from MainWindow.tjs
				var date = new Date();
				var fmt  = "%04d/%02d/%02d %02d:%02d" + (kag.bookMarkDateSecond ? ":%02d" : "");
				date.setTime(.storeTime);
				with (date) info.realdate = fmt.sprintf(
					.getYear(),  .getMonth() + 1, .getDate(),
					.getHours(), .getMinutes(),   .getSeconds());
			}
		}
		info.thumbnail = file;
		return info;
	}
}
function ShowHideQLoadPopup(vis,*) {
	if (typeof global.kag != "Object" || !isvalid kag) return;
	if (typeof kag.QLPopupTipLayer != "Object")
		/**/   kag.QLPopupTipLayer = new QLoadPopupLayer(kag); //kag.selectLayerAbsolute-1);
	try {      kag.QLPopupTipLayer[vis?"show":"hide"](*); } catch {}
}
