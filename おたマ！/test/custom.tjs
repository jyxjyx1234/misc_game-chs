		if (en) {
			// TODO...
			if (_copysrc !== void) {
				var target = getItemTarget(_copysrc);
				if (target !== void)
					target.toggle = true;
			}
		}
		with (kag.current.names) {
			.copy.toggle   = (_iscopy == "copy");
			.move.toggle   = (_iscopy == "move");
			.remove.toggle = (_iscopy == "remove");
		}
	}
	function saveDataCopy(num) { onCopyMove(num, Storages.copyFile); }
	function saveDataMove(num) { onCopyMove(num, Storages.moveFile); }
	function onCopyMove(dstnum, opr) {
		// [TODO] 動作が遅いので bookMarkIndex 関連の処理を最適化すること
		var get    = kag.getBookMarkFileNameAtNum;
		var srcnum = _copysrc;
		var src    = getDataNumber(srcnum);
		var dst    = getDataNumber(dstnum);
		var from   = get(src);
		var to     = get(dst);

		playSysSE("save.commit");

		// Newアイコンを消す
		var info = getItemInfo(srcnum);
		if (info.lastsaved) showNewIcon(null);
		/**/info = getItemInfo(dstnum);
		if (info !== void && info.lastsaved) showNewIcon(null);

		kag.eraseBookMark(dst);
		super.onDelete(dstnum);

		opr(from, to, false);
		clearFilePlaceCache();
		clearCopyMode(false);
		update(true);
	}
	function clearCopyMode(redraw = true) {
		_iscopy = _copysrc = void;
		update() if (redraw);
	}
	function setCopyMode(tag) {
		if (_iscopy == tag) return clearCopyMode();
		_iscopy = tag != "" ? tag : void;
		_copysrc = void;
		update(true);
	}
	function isEnabled(num) {
		if (   _iscopy == "remove") return isExistData(num);
		return _iscopy != "" || super.isEnabled(num);
	}
	function getProtectItemEnabled(num) {
		var wp = protectMap[getDataNumber(num)];
		switch (_iscopy) {
		case "remove": return !wp;
		case "move":
			if (_copysrc === void && wp) return false;
			// not break
		case "copy":
			return (_copysrc === void) ? isExistData(num) : ((num != _copysrc) && !wp);
		}
		if (_issave && wp) return false;
	}

	var _iscopy, _copysrc;
	function onBack() {
		var en = (_iscopy != "");
		clearCopyMode(false);
		if (en) {
			playSysSE("cancel");
			clearCopyMode();
			kag.unlockMessageLayerSelProcess();
			kag.current.focus();
			update(true);
			kag.process("", "*wait");
		} else {
			disableEditButton();
		}
	}

	function forceUpdateEditButton() {
		foreach(kag.current.buttons, function(k,v) {
			v.update() if (v);
		});
	}
	function disableEditButton() {
		foreach(kag.current.buttons, function(k,v) {
			v.enabled = false if (v);
		});
	}

	//------------------------------
	function update() {
		showNewIcon(void);
		super.update(...);
		drawCopyModeState();
		updateEditButton();
	}
	function updateEditButton(num) {
		if (num === void) {
			for (var i = 0; i < _rowcol; i++) updateEditButton(i);
			return;
		}

		var names = kag.current.names;
		var pos = offset + num;
		var btn = names["item" + num];
		if (btn === void) return;
		var wp  = protectMap[getDataNumber(pos)];

		// ボタンが有効な場所のみ表示
		// セーブ時はデータがない場所は表示しない
		var en = (_issave && !isExistData(pos)) || (_iscopy != "") ? false : isEnabled(pos) ;
		setSystemButtonEnabled(getProtectButton (num), en).toggle =  wp;
//		en &&= !wp;
//		setSystemButtonEnabled(getCommentButton (num), en);
//		setSystemButtonEnabled(getDeleteButton  (num), en);
//		setSystemButtonEnabled(getCopyMoveButton(num), en || (_iscopy != "" && _copysrc == pos)).toggle = _lastmove;
	}
	function setSystemButtonEnabled(btn, en) {
		with (btn) {
			.hitThreshold = en ? 0 : 256;
			.enabled = en;
		}
		return btn;
	}
	property protectMap { getter {
		var        scflags = global.kag.scflags;
		if (typeof scflags.bookMarkProtect != "Object")
			/**/   scflags.bookMarkProtect  = %[];
		return     scflags.bookMarkProtect;
	} }
	function protect(num) {
		num = (int)+num;
		var pos = offset + num;
		var idx = getDataNumber(pos);
		var map = protectMap;
		var wp  = map[idx] = !map[idx];
		var names = kag.current.names;
		dm("protect", pos, idx, wp);

		var btn = names["item" + num];
		btn.enabled = isEnabled(pos) && !(_issave && wp);
		updateEditButton(num);
		kag.saveSystemVariables();
	}
	function forceRedrawItem(pos) {
		super.forceRedrawItem(...);
		updateEditButton(getItemPosition(pos));
	}
	function save(num) {
		var r = super.save(...);
		if (r) protectMap[getDataNumber(num)] = false;
		return r;
	}

	function getSysButton(tag, ret) { return ((ret = kag.current.buttons[tag]) !== void) ? ret : %[]; }
	function getProtectButton(num)  { return getSysButton("pt" + num); }
//	function getCommentButton(num)  { return getSysButton("tx" + num); }
//	function getDeleteButton(num)   { return getSysButton("rm" + num); }
//	function getCopyMoveButton(num) { return getSysButton("cp" + num); }
	function replaceSysButtons(elm, ui, orig) {
		var x, y, ox, oy;
		with (ui.item0) x=.x, y=.y;
		for (var i = 0; i < _rowcol; i++) {
			var tag = "item"+i;
			if   (ui[tag] === void) continue;
			with (ui[tag]) ox=.x-x, oy=.y-y;
			replaceSysButtonOne(ui, ox, oy, i, "pt", "protect", orig );
//			replaceSysButtonOne(ui, ox, oy, i, "tx", "comment" );
//			replaceSysButtonOne(ui, ox, oy, i, "rm", "remove"  );
//			replaceSysButtonOne(ui, ox, oy, i, "cp", "copymove");
		}
	}
	function replaceSysButtonOne(ui, x, y, n, tag, exec, orig=tag+"0") {
		var uis = ui[tag + n];
		if (uis !== void) with (uis) {
			if (n > 0) with (ui[orig]) {
				uis.x = .x+x;
				uis.y = .y+y;
			}
			.exp     = @'Current.cmd("${exec}/${n}")';
//			.onenter = @'Current.cmd("enter/${n}")';
//			.onleave = @'Current.cmd("leave/${n}")';
		}
	}
	function updateSysButtons(base, ui) {
		foreach(base.buttons, function(k,v,d, ui){
			if (v) with (v) {
//				.halftone=(k.indexOf("pt")<0);
				.absolute=1000;
				.hitType = htMask;
				.hitThreshold = 0;
//				var tag = "UpArrow";
//				var info = ui[k.replace(/[0-9]/g, "")+"0"];
//				if (info !== void && info.cursor != "") tag = info.cursor;
//				.cursor = getSystemMouseCursor(tag, .cursor);
			}
		}, ui);
	}

}
{
	var onback = function { Current.cmd("onBack"); } incontextof global;
	SystemHook.add("save.back", onback);
	SystemHook.add("load.back", onback);
}

Dialog.add(%[ name:"save", start:CustomSaveLoad, storage:"save" ]);
Dialog.add(%[ name:"load", start:CustomSaveLoad, storage:"load" ]);

SystemConfig.notifyQSave=false;
SystemConfig.dialogDefaultFocusTable = %[
	AskQLoad: "yes",
	AskQSave: "yes",
	AskSave:  "yes",
	AskLoad:  "yes",
		];
{
	var ynmap = function (tag) { yesnoMap[tag] = tag; } incontextof MyYesNoDialog.instance;
	ynmap("AskSave");
