// CGモード画面

KAGLoadScript("cgview.tjs");
class CustomCgViewLayer extends UiBasedCgViewLayer {
	var image;
	function CustomCgViewLayer() {
		super.UiBasedCgViewLayer(...);
		setup("cgview");
		if (names.base !== void) with (names.base) {
			.hitType = htMask;
			.hitThreshold = 0;
			.cursor = window.cursorDefault;
			.drawState = .onExecute = .onMouseEnter = .onMouseLeave = function {};
			.enabled = true;
			objectHookInjection(%[ target:names.base, method:"onMouseDown", func:function(orig, x, y, btn, *) {
				//dm("clicked+++", x, y, btn);
				if (btn == mbRight) window.onPrimaryRightClick();
				else return orig(x, y, btn, *);
			} ]);
		}
		_centerx = width\2;
		_centery = height\2;

		image = new AffineLayer(window, this);
		with (image) {
			.onPaint = function {};
			.defaultAfx = "center";
			.defaultAfy = "center";
			.reset();
		}
	}
	function finalize() {
		if (!isvalid this) return;
		Invalidate(image);
		super.finalize(...);
	}
	// UI hack
	var _ui;
	function uiload { return (_ui = global.uiload(...)); }
	function drawNumber(tag, idx) {
		var draw = CustomExtraCharaView.drawNumber; //[XXX]
		draw(names[tag+"100"], (idx \ 100) % 10, true, _ui.num);
		draw(names[tag+"010"], (idx \  10) % 10, true, _ui.num);
		draw(names[tag+"001"], (idx      ) % 10, true, _ui.num);
	}

	var _showHideBaseLeft;
	function getShowHideFromTo {
		if (_showHideBaseLeft === void) {
			_showHideBaseLeft = uilayer.left;
		}
		var r = super.getShowHideFromTo(...);
		r.left = uilayer.left;
		return r;
	}
	function getShowHideAction(p) {
		var r = super.getShowHideAction(...);
		r.left = %[ handler:MoveAction, start:_showHideBaseLeft+((255-p.from)/8), value:_showHideBaseLeft+((255-p.to)/8), time:r.opacity.time, accel:p.to?-1:1 ];
		return r;
	}
	function afterLoadImages {
		var r = super.afterLoadImages(...);
		if (_showHideBaseLeft !== void) {
			window.stopAction(uilayer, true);
			uilayer.left = _showHideBaseLeft;
		}
		if (_initialForceHide !== void) {
			resetUiLayer(_initialForceHide > 0);
			forceHideMode = _initialForceHide < 0;
		}
		return r;
	}

	// スクロール位置用プロパティ
	var _swidth, _sheight, _sleft, _stop, _szoom, _shorz, _svert;
	var _inix, _iniy;
	var _centerx, _centery;
	property scrollLeft { getter { return _sleft; } setter(v) { _sleft = v; onScrolled(); } }
	property scrollTop  { getter { return _stop;  } setter(v) { _stop  = v; onScrolled(); } }
	property scrollZoom { getter { return _szoom; } setter(v) { _szoom = v; onScrollResize(); onScrolled(); } }
	property scrollMinLeft { getter { return -_shorz; } }
	property scrollMinTop  { getter { return -_svert; } }
	property scrollMaxLeft { getter { return  _shorz; } }
	property scrollMaxTop  { getter { return  _svert; } }

	property scrollWidth  { getter { return _swidth;  } }
	property scrollHeight { getter { return _sheight; } }

	function onScrolled() {
		image.setPos(_centerx - _sleft, _centery - _stop);
		update();
	}
	function onScrollResize(afx = width\2, afy = height\2) {
		if      (_szoom < 100) _szoom = 100;
		else if (_szoom > 200) _szoom = 200;
		// [TODO] スクロール可能範囲をzoomにあわせて変更すること
		_shorz = (_swidth  * (_szoom/100) - width)  / 2;
		_svert = (_sheight * (_szoom/100) - height) / 2;
		if (_shorz < 0) _shorz = 0;
		if (_svert < 0) _svert = 0;
		offsetScroll(0, 0); // left/topをmin/max補正するコードが呼ばれる

		if (image) {
//			var rx = _swidth * afx/width, ry = _sheight * afy/height;
			image.setZoom(_szoom);
			update();
		}

		setSliderPosition("zoom", _szoom, true); // zoomのスライダー更新
	}
	function setupInitialImage {
		onScrolled();
		onScrollResize();
		scrollHorz = _inix;
		scrollVert = _iniy;
	}
	
	function checkScrollable {
		canScroll = 3;
	}

	function internalOnMouseWheel(shift, delta, x, y) {
		_szoom += delta/60;
		onScrollResize(x, y);
	}

	function onMouseEvent(tag) {
		switch (tag) {
		case "tout": return super.onMouseEvent(...);
		case "move":
			if (!forceHideMode && names.base) with (names.base) {
				setButtonsShowHide(.cursorX >= 0);
				return true;
			}
			break;
		case "click":
			if (forceHideMode) return super.onMouseEvent(...);
			break;
		}
	}

	function assignScroll(src) {}

	function onPaint() {
		var r = super.onPaint();
		redraw();
		return r;
	}
	function redraw(force) {
		if (!image) return;
		//dm("redraw", image._doAffine);
		if (force) {
			fillRect(0, 0, width, height, neutralColor);
			image._doAffine = 2; //[XXX] 常に全更新
			image._image._clearRegion.clear(); //[XXX] 常に全更新
		}
		image.drawAffine(this);
	}

	var _currentImageIndex, _currentImageList, _initialForceHide;
	function loadImages(list, idx, pos, forcehide) {
		drawNumber("cg", pos+1);
		_currentImageList  = list;
		loadImageOne(idx);
		_sleft = _stop = 0;
		_swidth  = image.width;
		_sheight = image.height;
		_szoom   = 100;
		_inix    = 0.5, _iniy = 0.5;
		if (!_swidth || !_sheight) throw new Exception("zero width/height");

		//initDiffTables(info);
		//  -> setupDiffSlider
		_initialForceHide = forcehide;
		afterLoadImages(name);
		redraw(true);
	}
	function setItemProp(name, prop, value) {
		var target = names[name];
		if (target && prop != "") target[prop] = value;
		return target;
	}

	function isMaxImageIndex() { return _currentImageIndex == _currentImageList.count-1; }
	function roundIndex(n, m) { return n < 0 ? m : n > m ? 0 : n; }
	function loadImageOne(idx) {
		var max = _currentImageList.count-1;
		switch (idx) {
		case "up":   idx = roundIndex(_currentImageIndex+1, max); break;
		case "down": idx = roundIndex(_currentImageIndex-1, max); break;
		}
		_currentImageIndex = idx;
		_owner.loadImage(image, _currentImageList[idx]);
		image.setSizeToImageSize();
		image.calcAffine();
		redraw(true);

		var en = (max >= 1);
		drawNumber("diff", en ? idx+1 : 0);
		with (names) {
			.diff_up.enabled = en if (.diff_up !== void);
			.diff_dw.enabled = en if (.diff_dw !== void);
		}
	}

	
	function updateDiff(info, force) {
	}

	function loadDiffImage(file) {
		var left = _sleft, top = _stop;
		var width = _swidth, height = _sheight, zoom = _szoom;
		try { loadEnvImage(file); } catch { return; }
		if (width  == _swidth &&
			height == _sheight) {
			scrollLeft = left;
			scrollTop  = top;
			scrollZoom = zoom;
		}
	}

	function onSliderChange(name, pos, drag) {
		if (ignoreSliderChange) return;
		scrollZoom = pos;
		resetTimer();
	}
	function onRightClicked() {
		if (!forceHideMode) hide();
		else {
			playSE(void, "show");
			setButtonsShowHide(true);
		}
	}
	function onButtonClick(name, btn, sft) {
		if (btn == mbLeft) {
			switch (name) {
			case "cg_dw":   return sendMessage("prev");
			case "cg_up":   return sendMessage("next");
			case "diff_dw": return prevDiff(); // loadImageOne("down");
			case "diff_up": return nextDiff(); // loadImageOne("up");
				return;
			case "view": return hide();
			case "exit": return window.close();
			}
		}
		return super.onButtonClick(...);
	}
	function onKeyDown(key, shift) {
		switch (key) {
		case VK_PRIOR:  return sendMessage("prev");
		case VK_NEXT:   return sendMessage("next");
		case VK_DELETE: return hide();
		case VK_BACK:   return prevDiff(); // loadImageOne("down");
		case VK_RETURN:
		case VK_SPACE:  return nextDiff(); // loadImageOne("up");
		}
		return super.onKeyDown(...);
	}

	function prevDiff() { return !_currentImageIndex ? sendMessage("prev2") : loadImageOne("down"); }
	function nextDiff() { return  isMaxImageIndex()  ? sendMessage("next2") : loadImageOne("up");   }
	function getUiLayerVisibleState() {
		return forceHideMode ? -1 : currentButtonsVisible ? 1 : 0;
	}
}
CgGalleryMode.CgViewLayerClass = global.CustomCgViewLayer;
class CustomCgMode extends CgGalleryMode, GalleryCommon {
	var BASE =      global.CgGalleryMode;
	function finalize() { BASE.finalize(...); }
	function CustomCgMode(elm) {
		GalleryCommon(BASE, elm);
		CgGalleryMode(...);
		initView();
	}

	function setCgViewScrollConfig(view, conf, canscr, name) {
		conf.mouse = "dragex";
//		with (conf) .wheel=.mousemove=.key=.spacedrag = false;
//		view.cursor = view.window.cursorDefault;
	}

	function onPageChange(last, now) {
		// [XXX] EVの最後のページを記録
		if (pageGroupBinds[+last] == "EV") {
			tf.lastCgModeEvPage = (int)+last;
		}
		return BASE.onPageChange(...);
	}
	function setTabPage(num) {
		var tag = pageGroupNames[num];
		// [XXX] EVの最後のページを記録
		if (tag == "EV" && tf.lastCgModeEvPage !== void) {
			page = tf.lastCgModeEvPage;
		} else {
			page = convertSubpg2Page(0, tag);
		}
	}

	function getItemSeenPer(num) {
		if (num < 0 || num >= count || items[num] === void) return;
		var list = items[num].list;
		if (list === void || !list.count) return;

		var total = list.count, seen = 0;
		for (var i = 0; i < total; i++)
			if (isSeenItem(list[i])) seen++;

		return %[ seen:seen, total:total ];
	}
	function customDrawItem(lay, pos, ui) {
		var numlay = kag.current.names.number;
		if (numlay === void) return;
		var per = getItemSeenPer(pos);
		if (per !== void) try {
			var pos  = ui.uistates.diff0;
			var ox = pos.ox, oy = pos.oy;
			var step = ui.uistates.diff1.ox - ox;
			var text = @"${per.seen}/${per.total}";
			dm(pos, text);
			for (var n = text.length-1; n >= 0; n--, ox+=step) {
				stampOne(lay, text.charAt(n), ox, oy, numlay);
			}
		} catch {}
	}
	function stampOne(lay, num, ox, oy, numlay) {
		if (num == "/") num = 10;
		else num = (int)+num;
		var nh = numlay.height \ 11;
		var nw = numlay.width;
		var y = num * nh;
		var w = lay.width;
		lay.operateRect(ox+w*0, oy, numlay, 0, y, nw, nh);
		lay.operateRect(ox+w*1, oy, numlay, 0, y, nw, nh);
		lay.operateRect(ox+w*2, oy, numlay, 0, y, nw, nh);
	}

	property isQuitViewLoop { getter() { return isCancelView; } }
	function onNext(message) {
		isCancelView = (message == "break");
		_hideUiLayer = _showLastDiff = void;
		switch (message) {
		case "next2": _hideUiLayer = cglayer.getUiLayerVisibleState();
		case "next": onSelect(findNextSeen(_lastSelectItem,  1)); break;
		case "prev2": _hideUiLayer = cglayer.getUiLayerVisibleState(), _showLastDiff = true;
		case "prev": onSelect(findNextSeen(_lastSelectItem, -1)); break;
		}
		jumpNextView();
	}
	function findNextSeen(idx, dir) {
		for (var i = 0, max = count, pos = idx; i < max; i++) {
			pos += dir;
			if      (pos <    0) pos = max-1;
			else if (pos >= max) pos = 0;
			if (isSeen(pos)) return pos;
		}
		return idx;
	}
	var _lastSelectItem, _hideUiLayer, _showLastDiff;
	function onSelect(num) {
		_lastSelectItem = num;
		return BASE.onSelect(...);
	}
	function view() {
		swapCgLayer(true);
		try {
			cglayer.loadImages(subItems, _showLastDiff ? subItems.count-1 : 0, _lastSelectItem, _hideUiLayer);
		} catch (e) {
			makeErrorImage(cglayer, e.message);
		}
		_hideUiLayer = void;
	}
	function onViewCancel() {
		cglayer.hide();
	}
	function doComposite(info, dst, src) {
		return BASE.doComposite(info, dst._image._image, src); // [XXX]
	}
}
SystemHook.add("cgmode.view.cancel", function {
	Current.cmd("onViewCancel");
	kag.process("", "*wait");
} incontextof global);

