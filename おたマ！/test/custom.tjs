	ynmap("AskOverwrite");
	ynmap("AskQuitReplay");
}
addKagHookCallback("onShowSelectHook", function(list) {
	var texts = [], tag = "【選択】";
	try {
		if (list === void) list = kag.flags.selectInfos;
		if (list === void || !list.count) return;
		for (var i = 0; i < list.count; i++) texts.add(list[i].text);
		if (list.count > 1) {
			tag = "【%s択】".sprintf(han2zen((string)list.count));
		}
	} catch {}
	historyLayer.currentText = texts.count > 0 ? tag+texts.join("／") : void;
}, true);
addKagHookCallback("onAfterSelectHook", function {
	if(historyWriteEnabled) historyLayer.repage(true);
}, true);


// -------------------------------------------------------------
// セーブサムネ差し替え

class CustomSystemAction extends SystemActionBase {
	function finalize() { super.finalize(...); }
	function CustomSystemAction() { super.SystemActionBase(...); }

	// サムネ差し替え
	var thumbReplMap, thumbReplList;
	function _checkSaveThumbnail(img) {
		var list = getLayerImageFileList(img);
		var cnt = list.count;
		dm("_checkSaveThumbnail", list*) if (cnt > 0);
		for (var i = 0; i < cnt; i++) {
			var r = getThumbReplace(list[i]);
			if (r !== void) {
				dm("matched", list[i], r);
				return r;
			}
		}
	}
	function getLayerImageFileList(img) {
		var r = [];
		r.add(img) if (img != "");
		foreach(world_object.env.layers, function (k,v,d, r) {
			try { if (v.isShowBU() && v.imageFile != "") r.add(v.imageFile); } catch {}
		}, r);
		return r;
	}
	function getThumbReplace(tag) {
		if (tag == "") return;
		with (Storages) tag = .chopStorageExt(.extractStorageName(((string)tag).toLowerCase()));
		if (thumbReplMap === void) loadThumbReplaceList();
		var replace = thumbReplMap[tag];
		if (replace === void)
			replace = searchReplace(tag);
		return replace != "" ? replace : void;
	}
	function loadThumbReplaceList() {
		thumbReplMap  = %[];
		thumbReplList = %[];
		var csv = new CSVParser(), line;
		try {
//			dm("loadThumbReplaceList");
			csv.initStorage("savelist.csv");
			while ((line = csv.getNextLine()) !== void) {
				var thumb = ((string)line[0]).trim();
				if (thumb == "" || thumb.charAt(0) == "#") continue;
				for (var i = line.count-1; i >= 1; i--) {
					var tag = ((string)line[i]).trim().toLowerCase();
					if (tag == "") continue;
					var wild = tag.indexOf("*");
					if (wild >= 0) {
						if (wild != tag.length-1) throw new Exception("ワイルドカードが末尾ではありません:"+tag);
						if (!wild)                throw new Exception("全画像マッチはできません:"+tag);
						
						thumbReplList[tag.substr(0, wild)] = thumb;
					} else {
						thumbReplMap[tag] = thumb;
					}
//					dm("setThumbReplaceList", thumb, tag, wild);
				}
			}
		} catch (e) {
			invalidate csv;
			throw e;
		}
		invalidate csv;
	}
	function searchReplace(tag) {
		@if (DEBUG)
			dm("already mapped", tag, thumbReplMap[tag]) if (typeof thumbReplMap[tag] != "undefined");
		@endif
		for(var n = tag.length; n > 0; n--) {
			var s = tag.substr(0, n);
			var r = thumbReplList[s];
			if (r != "") {
				// found (cached)
				return (thumbReplMap[tag] = r);
			}
		}
		// not found (cached)
		return (thumbReplMap[tag] = "");
	}

}
global.SystemActionClass = CustomSystemAction;


