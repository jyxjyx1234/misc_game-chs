// アイコンフェード

SystemConfig.iconFaderHoldInitialState = true;
SystemConfig.iconFaderList = [ "auto", "skip", "log", "prev", "next", "hide", "hold", "exit", "qsave", "qload", "save", "load", "option", "winopac" ];
class        IconAutoFader {
	function IconAutoFader(kag) {
		this.kag = kag;
		with (kag) {
			.add(this);
			.addPlugin(this);
			.addHook("mouseMove", onMouseMove);
			.addHook("onResetModeChanged", reset);
			.addHook("onModeChangeHookEx", this.onModeChanged);
		}
	}
	property hold {
		getter {
			var r = kag.scflags.IconFaderHold;
			if (r === void) r = !!SystemConfig.iconFaderHoldInitialState;
			return r;
		}
		setter (v) {
			var old = !!kag.scflags.IconFaderHold;
			var cur = kag.scflags.IconFaderHold = !!v;
			kag.setMenuAccessibleAll();
			if (old != cur) checkEnter();
		}
	}
	function onModeChanged(prop, kag, auto, skip, canauto, canskip, ss, modal, cr) {
		prop.checkToggleChanged("hold", "iconHold", hold);
	}

	var _iconList = SystemConfig.iconFaderList;
	var kag, _enter, _fade;
	function setOne(names, opac, ds*) {
		var dsopac = (int)+sf.windowOpac;
		for (var i  = _iconList.count-1; i >= 0; i--) {
			var tag = _iconList[i];
			if (names[tag] !== void) {
				names[tag].opacity = ds[i] ? dsopac : opac;
			}
		}
	}
	function set(*) {
		try { setOne(kag.fore.messages[0].buttons, *); } catch {}
		try { setOne(kag.back.messages[0].buttons, *); } catch {}
	}
	function update(opac = _fade) {
		set(opac); //, kag.autoMode, !!kag.skipMode);
	}
	property fade {
		getter { return _fade; }
		setter(v) {
			v = (int)+v;
			var upd = (_fade !== v);
			_fade = v;
			update() if (upd);
		}
	}
	function setEnter(ent) {
		if (_enter !== ent) {
			_enter  =  ent;
			var cur = _fade, val = ent ? 255 : hold ? (int)+sf.windowOpac : 0;
			kag.stopAction(this);
			_fade = void;
			if (cur === void || val === cur) {
				fade = val;
			} else {
				kag.beginAction(this, %[ fade:%[ handler:MoveAction, start:(fade = cur), value:val, time:200 ] ],, true);
			}
		}
	}
	function checkEnter() {
		var lay = kag.fore.messages[0].buttons.attention;
		if (lay !== void) with (lay) {
			var cx = .cursorX, cy = .cursorY, enter = false;
			if (cx >= 0 && cy >= 0 && cx < .width && cy < .height) {
				enter = .getMaskPixel(cx, cy) > 0;
			}
			setEnter(enter);
		}
	}
	function onMouseMove(x, y) {
		checkEnter() if (inGameState(kag) && kag.current === kag.fore.messages[0]);
	}
	function reset() {
		_enter = _fade = void;
		checkEnter() if (inGameState(kag));
	}
}
addAfterInitCallback(function() {
	kag.iconFader = new IconAutoFader(kag);
	if (sf.windowOpac === void)
		sf.windowOpac = 255;
} incontextof global);
property MessageFrameOpac {
	getter {
		return (int)+sf.windowOpac;
	}
	setter(v) {
		v = (int)+v;
		if (v < 0) v = 0;
		else if (v > 255) v = 255;
		sf.windowOpac = v;
		ResetMessageFrameVisible() if (inGameState(kag) && kag.current === kag.fore.messages[0]);
	}
}
function onMessageFrameOpacChanged(pos) {
	MessageFrameOpac = pos;
}
function ToggleSysButtonHold {
	try {
		with (kag.iconFader) .hold = !.hold;
	} catch {}
}

