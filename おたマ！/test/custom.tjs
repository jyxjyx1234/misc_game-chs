// 共通処理
class GalleryCommon {
	var SUPER;
	function GalleryCommon(base, elm) {
		SUPER = base;
		with (elm) {
			.itemname = "item0";
			.rows     = 5;
			.columns  = 3;
			.disabled = "normal";
			.mask     = "thumb";
			.ringpage = true;
		}
		updateElement(elm);
	}
	function updateElement(elm) {}
	function initView() {
		with (_view) {
			.drawNormalItem_ = .drawNormalItem;
			.drawNormalItem = function(lay, pos) {
				var r = drawNormalItem_(...);
				lay._copyButtonUIStates(1, _uiNormal, void, "cursor");
				lay._copyButtonUIStates(2, _uiNormal, void, "cursor");
				_owner.customDrawItem(lay, pos, _uiNormal);
				return r;
			} incontextof _view;
		}
	}
	function customDrawItem {}

	var cursel, curox, curoy;
	function  onUiloaded(elm, ui) {
		SUPER.onUiloaded(...);

		// [XXX]
		with (_view._mask) {
			.loadMask = function {};
			.holdAlpha = false;
			.face = dfAuto;
		}

		cursel = void;
//		with (uiloadGetRect(_itemname, ui)) curox =.x, curoy =.y;
//		with (uiloadGetRect("cursor", ui))  curox-=.x, curoy-=.y;

		var names = kag.current.names;
		var subpg = convertPage2Subpg();
		var pgnum = getPageGroupSubpgCount();
		if (pgnum <= 1) {
			pgnum = 0; // 1ページの場合は表示しない
			names.pageframe.visible = false if (names.pageframe !== void);
		}
		for (var i = 0; i < 10; i++) {
			var page = names["subpage"+i];
			if (page !== void) {
				page.visible = (i < pgnum);
				page.toggle  = (i == subpg);
			}
		}

		var grp = getCurrentPageGroup();
		if (grp != "") {
			var tab = names["tabpage"+pageGroupNames.find(grp)];
			if (tab !== void) tab.toggle = true;
		}
	}

	function setSubPage(num) { page = convertSubpg2Page(num); }
	function setTabPage(num) { page = convertSubpg2Page(0, pageGroupNames[num]); }
	function setChara(name)  { page = convertSubpg2Page(0, name); }
/*
	function onItemEnter(n) { onItemEnterLeave(true,  n); }
	function onItemLeave(n) { onItemEnterLeave(false, n); }
	function onItemEnterLeave(vis, pos) {
		pos = (int)pos;
		var cur = kag.current.names.cursor;
		var item = getItemTarget(pos, true);
		if (cur !== void && item !== void && (vis || cursel == pos)) {
			cur.setPos(item.left - curox, item.top - curoy);
			cur.visible = vis;
		}
		cursel = vis ? pos : void;
	}
 */
}

