class CustomSoundMode extends SoundGalleryMode {
	function CustomSoundMode(elm) {
		with (elm) {
			.itemname = "";
			.rows = 1;
			.columns = 12;
			.csv = "soundlist.csv";
			.drawtext = false;
			.disabled = "normal";
			.lastplay = "bgm01";
		}
		_mode = "one";
//		_exchange = _fadeout = 4000;
		super.SoundGalleryMode(...);
		_view.clearNormalItem = function {};
	}
	function finalize() {
		try { kag.bgm.fadeOut(%[ time:400 ]); } catch {}
		super.finalize(...);
	}
	function onUiloaded(elm, ui) {
		labelImage = ui.playing;
		updateState("stop");
		updateModeState();
		super.onUiloaded(...);
	}
	function updateState(name) {
		var btn = kag.current.names.play;
		var play = (name == "play");
		btn.toggle = play if (btn !== void);
		redrawLabel(play ? (string)(storages.find(playing)) : "none");
	}
	function stop() {
		if (playing === void && lastplay === void) updateState("stop");
		return super.stop();
	}
	function onModeChanged(m) {
		super.onModeChanged(...);
		updateModeState();
	}
	function updateModeState() {
		var one, all, rnd;
		with (kag.current.names) one=.one, all=.all, rnd=.rnd;
		if (one === void || all === void) return;
		switch (_mode) {
		case "rnd": one.toggle = false; all.toggle = false; rnd.toggle = true;  break;
		case "all": one.toggle = false; all.toggle = true;  rnd.toggle = false; break;
		case "one": one.toggle = true;  all.toggle = false; rnd.toggle = false; break;
		case "non": one.toggle = false; all.toggle = false; rnd.toggle = false; break;
		}
	}
	function repeat(tag) {
		var target = kag.current.names[tag];
		if (target !== void && target.toggle) mode = tag;
		else mode = "non";
	}
	function isSeen(num) {
		return true;
	}


	var labelImage;
	function redrawLabel(tag) {
		var img = kag.current.names.playing;
		if (img !== void) with (img) {
			._copyButtonUIStates(0, labelImage, void, tag);
		}
	}
}

Dialog.add(%[ name:"soundmode", start:CustomSoundMode, storage:"music" ]);


