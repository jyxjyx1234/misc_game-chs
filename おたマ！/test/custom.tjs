function IsStandModeOpened() {
	return tf.allseen || (
		// [XXX] フラグ直埋め
		sf.end_kirara &&
		sf.end_mami   &&
		sf.end_momiji &&
		sf.end_iina   &&
		sf.end_koyori &&
		sf.end_ameri  &&
		sf.end_harem  &&
		true);
}
class CustomTitle {
	var hasContinue, contFile, isExtra, clearFlag, isAllClear;
	function CustomTitle(elm) {
		isExtra = !!elm.extra;
		contFile = kag.getBookMarkFileNameBySystem(SuspendSaveTag);
		hasContinue = Storages.isExistentStorage(contFile);

		clearFlag  = tf.allseen || sf.game_clear;
		isAllClear = IsStandModeOpened();
	}
	function changeExtra  { isExtra = true; }
	function changeNormal { isExtra = false; }

	var cox, coy;
	function contPopup(vis) {
		// [XXX]
		if (hasContinue) ShowHideQLoadPopup(!!vis, cox, coy, contFile);
	}
	function onQLoad(elm) { ShowHideQLoadPopup(false); }
	function onUiload(elm) {
		elm.partremove = isExtra ? "rm_extra" : "rm_normal";
	}
	function onUiloaded(elm, ui) {
		with (uiloadGetRect("cont_popup", ui)) cox = .x, coy = .y;
		with (kag.current.names) {
			setButtonEnabled(.continue,  hasContinue);
			setButtonEnabled(.extra,     clearFlag);
			setButtonEnabled(.standmode, isAllClear);
			
		}
	}
	function setButtonEnabled(lay, en) {
		if (lay) lay.enabled = !!en;
	}
}
Dialog.add(%[ name:"title", start:CustomTitle, storage:"title" ]);

