}, false);
@set (ENABLE_MESWIN_OPAC=1)
function ResetMessageFrameVisible(lay = kag.current, opac = (int)+sf.windowOpac) {
	try {
		with (lay.buttons) {
			lay.window.messageFrameChanger.setFrameVisible(.frame1, .frame2, opac);
			@if (ENABLE_MESWIN_OPAC)
			if (.name !== void) .name.opacity = opac;
			@endif
		}
	} catch {}
}
CustomMessageLayer.getFrameOpacity = function() {
	ResetMessageFrameVisible(this);
	return 0;
} incontextof null;

addKagHookCallback("onNameLayerVisibleChanged", function(nl, v) {
	with (nl.owner.buttons) {
		var opac = (int)+sf.windowOpac;
		if (.name !== void) .name.visible = v;
		if (!v && .vreplay !== void) .vreplay.visible = false;
		ResetMessageFrameVisible(nl.owner, opac);
	}
}, false);


addKagHookCallback("onModeChangeHookEx", function (prop, kag, am, sm, ca, cs, ss, modal, cr) {
	// スキップモードアイコン
	sm = sm && inGameState(kag);
	if (isModeChanged("skipMode_icon", sm) &&
		typeof kag.skipModeIcon == "Object") {
		with  (kag.skipModeIcon) {
			.parent = kag.fore.base;
			.setPos(.baseLeft, .baseTop);
			.visible = sm;
		}
	}
}, false);

addAfterInitCallback(function() {
	var file = "skipmark";
	if (getExistImageName(file) != "") with (kag) {
		var x = .scWidth, y = .scHeight;
		try {
			var uil = uiload;
			var ui  = uiloadParse(%[ storage:"message" ]).result;
			with (uiloadGetRect("base.click", ui)) x=.x, y=.y;
		} catch {}
		.skipModeIcon = new ClickGlyphLayer(kag, .fore.base);
		.add(.skipModeIcon);
		with (.skipModeIcon) {
			.loadImages(file);
			.restartOnReload = true;
			.visible = false;
			.baseLeft = x;
			.baseTop  = y;
		}
	}
} incontextof global);


//--------------------------------------------------------------
// メッセージ窓変更処理

class        MessageFrameChanger extends KAGPlugin {
	function MessageFrameChanger(kag, defaultType) {
		this.kag = kag;
		this.defaultType = defaultType;
		kag.add      (this);
		kag.addPlugin(this);
		kag.addHook("onEraceMessage", onEraceMessage);
		kag.addHook("onSkipNoDispChanged", onSkipNoDispChanged);
	}

	function onEraceMessage { reset(); }
	function onSkipNoDispChanged { reset(); }
	function reset() {
		if (!world_object.playerConverting) type = defaultType;
	}

	var kag, defaultType, type, tag = "meswinloud";
	function onEnvCommand(tagname, elm) {
		if (tagname == tag) {
			setType("loud");
			ResetMessageFrameVisible() if (elm.force);
			return 0;
		}
	}
	function onEnvInit() { setType(defaultType); }
	function onEnvRestore(dic) { setType(dic[tag]);       }
	function onEnvStore  (dic) {         dic[tag] = void; } //type;

	function setType(name) {
		type = (name == "") ? defaultType : name;
	}
	property env { getter { with (world_object) {
		return .playerConverting ? .player.parseEnv : .env;
	} } }
	function setFrameVisible(f1, f2, opac) {
		var isNormal = (type != "loud");
		if (f1) with (f1) {
			.visible =  isNormal;
			@if (ENABLE_MESWIN_OPAC)
			.opacity =  opac;
			@endif
		}
		if (f2) with (f2) {
			var oldvis = .visible;
			.visible = !isNormal;
			if (!oldvis && .visible && kag.skipMode < SKIP_FAST) {
				var vib = 6, wt = 30, time = 150;
				kag.stopAction (f2);
				kag.beginAction(f2, %[ left:   %[ handler:RandomAction, vibration:vib, waittime:wt, time:time ],
									   /**/top:%[ handler:RandomAction, vibration:vib, waittime:wt, time:time ] ]);
			}
			@if (ENABLE_MESWIN_OPAC)
			.opacity =  opac;
			@endif
		}
	}
}
addAfterInitCallback(function() {
	kag.messageFrameChanger = new MessageFrameChanger(kag, "normal");
} incontextof global);

SelectButtonLayer.drawMessage = function (message) {
	var cnt = Butt_showFocusImage ? 4 : 3;
	var tw = font.getTextWidth(message);
	var th = font.getTextHeight(message);
	var y = (height-th)>>1;
	//dm("サイズ:" + width + " ," + height);
	var dx = (width-tw)>>1;
	for (var i=0;i<cnt;i++) {
		var x = i*width + dx;
		// vvv[XXX]
		var ox = (i == 1) ? 3 : 0;
		var oy = (i == 1) ? 5 : 0;
		// ^^^[XXX]

		//dm("メッセージ:" + x);
		owner.drawTextToLayer(this, x+ox, y+oy, message, i, drawopt);
	}
} incontextof null;

