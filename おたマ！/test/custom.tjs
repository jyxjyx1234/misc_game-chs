SystemActionBase._endReplay = function {
	if (!inGameState(kag)) return;
	var modal;
	with (kag) modal = .historyShowing || .messageLayerHiding || .currentDialog || .panelModal;
	if (!canConfig(kag, modal)) return;

	askYesNo("AskQuitReplay", "確認", kag.endRecollection);
} incontextof null;
