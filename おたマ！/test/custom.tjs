// バックログ

KAGLoadScript("backlog.tjs");
class        CustomBacklog extends BacklogBase {
	function CustomBacklog { super.BacklogBase(...);
		with (_render) {
			//...
		}
		renderAutoIndent = _snapshotEnabled ? kag.autoIndent : 0;
	}
	function finalize { super.finalize(...); }

	var textRect, nameRect;
	var renderAutoIndent;
	function setup(elm, ui) {
		textRect = uiloadGetRect("scroll.text", ui);
		with      (uiloadGetRect("scroll.block", ui)) blockHeight = blockStep = .h;
		with      (uiloadGetRect("scroll.name", ui)) nameRect = %[
			/**/x:.ox, y:.oy, w:.w, h:.h, halign:-1, valign:0, maxline:1, drawtext:internalDrawText3 ];
		super.setup(...);
	}
	function drawTextBlock(lay, info) {
		with (lay) {
			//.fillRect(0, 0, .width, .height, 0x80FFFFFF);
			//putStamp(lay, gFrame);
			var face = lay.font.face = kag.chDefaultFace, name;
			var col  = lay.window.getCurrentMessageColor(true, info.name == "" ? "" : info.name); //_render.defaultChColor;

			var fsz = _render.defaultFontSize, rsz = 0; //_render.defaultRubySize;
			if (info.name != "") name = ((string)(info.disp != "" ? info.disp : info.name)).trim();

			var text = (string)(info.text);
			var indent = (text.indexOf("%@") == 0);

			with (textRect) {
				lay.drawTextOwner = this;
				lay.drawTextOrig  = internalDrawText2 incontextof lay;
				lay.drawText <-> lay.drawTextOrig;
				try {
					_render.defaultChColor = col;
					_render.draw(lay, .ox-(indent?fsz:0), .oy+rsz, .w+(indent?fsz:0), .h, text, renderAutoIndent);
				} catch (e) {
					lay.drawText <-> lay.drawTextOrig;
					throw e;
				}
				lay.drawText <-> lay.drawTextOrig;
			}
			if (name != "") with (nameRect) {
				.fontface   = face;
				.fontheight = fsz;
				.color      = col;
				//putStamp(lay, gName);
				drawTextKinsokuRect(lay, name, nameRect);
			}
		}
	}
	function internalDrawText(layer, dt, x,y,text,col) {
		with (_render)
			EdgeShadowDrawText( dt, layer, x, y, text, col, 255, .antialiased,
								.defaultShadow, .shadowColor, .shadowWidth, .shadowOffsetX, .shadowOffsetY,
								.defaultEdge,   .edgeColor,   .edgeEmphasis, .edgeExtent);
	}
	function internalDrawText2(       x,y,text,col) { drawTextOwner.internalDrawText(this,  drawTextOrig,   x, y, text, col); }
	function internalDrawText3(layer, x,y,text,col) {               internalDrawText(layer, layer.drawText, x, y, text, col); }

	function putStamp(lay, info) {
		if (info === void || info.lay === void) return;
		with (info) lay.operateRect(.x, .y, .lay, 0, 0, .lay.width, .lay.height);
	}

	var _sliderFirstPos;
	function onSliderChanged(pos, drag) {
		if (!canScroll || _sliderUpdating) return;
		if (_sliderFirstPos === void) _sliderFirstPos = scroll;
		if (drag) return super.onSliderChanged(...);
		fixSliderScroll(pos, _sliderFirstPos !== void ? pos-_sliderFirstPos : void);
		_sliderFirstPos = void;
	}
	function doWheelScroll(delta) {
		var pos = getScrollActionTargetPos() - (delta*blockStep/120);
		fixSliderScroll(pos, -delta);
	}
	function fixSliderScroll(pos, dir) {
		var from = getScrollActionTargetPos(); //scroll;
		var to = ((int)Math.round(pos/blockStep)) * blockStep;
		if      (dir < 0 && pos < to) to -= blockStep;
		else if (dir > 0 && pos > to) to += blockStep;
		if (to < scrollMin) to = scrollMin;
		else if (to > scrollMax) to = scrollMax;
		//dm("fixSliderScroll", dir, pos, to);
		if (from != to) {
			updateSliderPos(from);
			startScrollAction(from, to, getScrollTime(to-from));
		}
	}
}
Dialog.add(%[ name:"backlog", start:CustomBacklog, storage:"backlog" ]);


